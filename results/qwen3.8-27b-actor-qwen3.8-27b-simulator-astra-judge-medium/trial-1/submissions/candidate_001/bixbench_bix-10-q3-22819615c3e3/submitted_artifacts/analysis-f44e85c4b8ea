#!/usr/bin/env python3
"""
BCG-CORONA: chi-square test of COVID-19 severity (AESEV of AEPT=='COVID-19')
by treatment group (BCG vs Placebo) within each patients_seen stratum.

Endpoint: worst (max) AESEV per subject among AE rows with AEPT=='COVID-19'.
Analysis restricted to infected subjects. Subjects with NaN AESEV excluded.
Primary: chi2_contingency on TRTGRP x AESEV(1-4) per stratum.
Sensitivity: binary severe (AESEV>=3) vs non-severe (1-2), per stratum.
"""
import pandas as pd
from scipy import stats

BASE = "/workspace/data"
dm = pd.read_csv(f"{BASE}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{BASE}/TASK008_BCG-CORONA_AE.csv", encoding="latin-1")

# --- Build per-subject severity (worst AESEV for AEPT=='COVID-19') ---
cov = ae[ae.AEPT == "COVID-19"]
worst = cov.groupby("USUBJID").agg(
    n_rows=("AESEV", "size"),
    max_sev=("AESEV", "max"),          # NaN-aware max
    first_sev=("AESEV", "first"),
    trt_ae=("TRTGRP", "first"),
).reset_index()

m = dm.merge(worst, on="USUBJID", how="inner")
# sanity check: AE TRTGRP agrees with DM TRTGRP
assert (m["TRTGRP"] == m["trt_ae"]).all(), "TRTGRP mismatch between DM and AE"

infected = m[m["max_sev"].notna()].copy()
infected["sev"] = infected["max_sev"].astype(int)
print(f"Subjects with AEPT=='COVID-19': {len(m)}; with non-missing AESEV: {len(infected)}")
print(f"Subjects with multiple COVID-19 rows: {(m['n_rows']>1).sum()}")
print(f"  worst==first for those: {(m[m['n_rows']>1]['max_sev']==m[m['n_rows']>1]['first_sev']).all()}")
print()

SEV_LEVELS = [1, 2, 3, 4]
results = []

for stratum in ["1-50", "51-100", ">100"]:
    sub = infected[infected["patients_seen"] == stratum]
    print("=" * 72)
    print(f"STRATUM patients_seen = {stratum}   (infected n={len(sub)}: "
          f"BCG={ (sub.TRTGRP=='BCG').sum() }, Placebo={(sub.TRTGRP=='Placebo').sum() })")

    # ---- Primary: 2x4 table TRTGRP x AESEV ----
    tab = pd.crosstab(sub["TRTGRP"], sub["sev"]).reindex(
        index=["BCG", "Placebo"], columns=SEV_LEVELS, fill_value=0)
    dropped = [c for c in SEV_LEVELS if tab[c].sum() == 0]
    tabc = tab.drop(columns=dropped)
    chi2, p, dof, expected = stats.chi2_contingency(tabc.values)
    print(f"\n[PRIMARY] TRTGRP x AESEV(1-4):")
    print("observed (full):\n", tab)
    if dropped:
        print(f"NOTE: severity level(s) {dropped} absent in this stratum -> chi-square computed on remaining levels")
    print("expected (as computed):\n", pd.DataFrame(expected, index=tabc.index, columns=tabc.columns).round(3))
    print(f"chi2={chi2:.4f}  dof={dof}  p={p:.4f}  -> {'SIGNIFICANT (p<0.05)' if p<0.05 else 'not significant'}")
    if (expected < 5).any():
        print(f"CAVEAT: {(expected<5).sum()} expected cell(s) < 5 -> chi-square unreliable for this stratum.")
    results.append(dict(stratum=stratum, test="AESEV 1-4", n=int(tab.values.sum()),
                        chi2=round(chi2,4), dof=int(dof), p=round(p,4),
                        sig=bool(p<0.05), cells_below_5=int((expected<5).sum())))

    # ---- Sensitivity: binary severe (>=3) vs non-severe ----
    sub2 = sub.copy()
    sub2["severe"] = (sub2["sev"] >= 3).map({True: "Severe (>=3)", False: "Non-severe (1-2)"})
    tab2 = pd.crosstab(sub2["TRTGRP"], sub2["severe"]).reindex(
        index=["BCG", "Placebo"], columns=["Non-severe (1-2)", "Severe (>=3)"], fill_value=0)
    chi2b, pb, dofb, expectedb = stats.chi2_contingency(tab2.values)
    print(f"\n[SENSITIVITY] binary severe(>=3) vs non-severe:")
    print("observed:\n", tab2)
    print("expected:\n", pd.DataFrame(expectedb, index=tab2.index, columns=tab2.columns).round(3))
    print(f"chi2={chi2b:.4f}  dof={dofb}  p={pb:.4f}  -> {'SIGNIFICANT (p<0.05)' if pb<0.05 else 'not significant'}")
    if (expectedb < 5).any():
        print(f"CAVEAT: {(expectedb<5).sum()} expected cell(s) < 5 -> chi-square unreliable.")
    results.append(dict(stratum=stratum, test="severe>=3", n=int(tab2.values.sum()),
                        chi2=round(chi2b,4), dof=int(dofb), p=round(pb,4),
                        sig=bool(pb<0.05), cells_below_5=int((expectedb<5).sum())))
    print()

print("=" * 72)
print("SUMMARY")
print(pd.DataFrame(results).to_string(index=False))
sig = [r["stratum"] for r in results if r["sig"] and r["test"]=="AESEV 1-4"]
print(f"\nANSWER: stratum(s) with p<0.05 in primary chi-square: {sig if sig else 'NONE'}")

# =====================================================================
# APPENDIX: alternative endpoint definitions (diagnostics, not primary)
# =====================================================================
print("\n" + "=" * 72)
print("APPENDIX - alternative definitions (diagnostics)")

def _c2(tab, label, stratum):
    try:
        c, p, d, e = stats.chi2_contingency(tab.values)
        print(f"  {stratum:7s} {label:18s} chi2={c:.3f} dof={d} p={p:.4f}")
    except Exception as ex:
        print(f"  {stratum:7s} {label:18s} ERROR: {ex}")

m_all = dm.merge(cov.groupby("USUBJID")["AESEV"].max().rename("max_sev")
                 .reset_index().rename(columns={"AESEV": "max_sev"}), on="USUBJID", how="left")

print("A) all 1000 subjects, level 0(not infected)-4 (worst AESEV):")
m_all["lvl"] = m_all["max_sev"].fillna(0)
for s in ["1-50", "51-100", ">100"]:
    sub = m_all[m_all.patients_seen == s]
    tab = pd.crosstab(sub.TRTGRP, sub.lvl).reindex(index=["BCG", "Placebo"],
                                                   columns=sorted(sub.lvl.unique()), fill_value=0)
    _c2(tab, "lvl0-4", s)

print("B) binary infection (any COVID-19 AE) vs not:")
m_all["inf"] = m_all["max_sev"].notna().astype(int)
for s in ["1-50", "51-100", ">100"]:
    sub = m_all[m_all.patients_seen == s]
    tab = pd.crosstab(sub.TRTGRP, sub.inf).reindex(index=["BCG", "Placebo"], columns=[0, 1], fill_value=0)
    _c2(tab, "infection", s)

print("C) row-level AESEV (each AE row, 207 rows):")
r = ae[ae.AEPT == "COVID-19"].merge(dm[["USUBJID", "patients_seen"]], on="USUBJID")
r = r[r.AESEV.notna()]
for s in ["1-50", "51-100", ">100"]:
    sub = r[r.patients_seen == s]
    tab = pd.crosstab(sub.TRTGRP, sub.AESEV.astype(int)).reindex(index=["BCG", "Placebo"],
                                                                columns=[1, 2, 3, 4], fill_value=0)
    _c2(tab, "row-level", s)

print("D) first record instead of worst, all subjects, level 0-4:")
first = ae[ae.AEPT == "COVID-19"].groupby("USUBJID")["AESEV"].first().rename("first_sev")
m_d = dm.merge(first, on="USUBJID", how="left")
m_d["lvlD"] = m_d["first_sev"].fillna(0)
for s in ["1-50", "51-100", ">100"]:
    sub = m_d[m_d.patients_seen == s]
    tab = pd.crosstab(sub.TRTGRP, sub.lvlD).reindex(index=["BCG", "Placebo"],
                                                    columns=sorted(sub.lvlD.unique()), fill_value=0)
    _c2(tab, "first lvl0-4", s)

print("\nCONCLUSION: no patient-volume stratum reaches p<0.05 under the primary")
print("test or any alternative definition; the closest is 1-50 (p~0.07).")
