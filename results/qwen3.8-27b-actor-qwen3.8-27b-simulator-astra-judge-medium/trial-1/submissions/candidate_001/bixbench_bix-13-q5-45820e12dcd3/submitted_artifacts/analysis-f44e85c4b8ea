"""
DESeq2-equivalent DE analysis (P. aeruginosa PA14, strain vs JBX1).
R/DESeq2 is NOT available in this sandbox (no R binary, no internet), so this
faithfully reproduces the DESeq2 workflow in Python:
  - median-of-ratios size factors
  - NB GLM, design ~ Media + Strain (Strain reference = JBX1 = code 1)
  - gene-wise dispersion = per-gene MLE (profile over dispersion)
  - dispersion shrunk toward a mean-trend (DESeq2 weighting)
  - Wald test per strain-vs-JBX1 contrast
  - Benjamini-Hochberg adj.p < 0.05 (naive BH, one correction per contrast)
  - set op:  |(A U B) \ C|
"""
import numpy as np, pandas as pd
from scipy import stats, optimize, special
from statsmodels.nonparametric.smoothers_lowess import lowess

meta = pd.read_csv('data/experiment_metadata.csv')
counts = pd.read_csv('data/raw_counts.csv', index_col=0)
order = meta['AzentaName'].tolist()
K = counts[order].astype(float).values
genes = counts.index.tolist()
n0, m = K.shape
print(f"matrix: {n0} genes x {m} samples")

# drop all-zero genes (DESeq2 default: only all-zero genes removed)
keep = K.sum(axis=1) > 0
K = K[keep]; genes = [g for g,k in zip(genes,keep) if k]; n = len(genes)
print(f"genes after dropping all-zero: {n}")

# design ~ Media + Strain (ref Media=first, ref Strain=1/JBX1)
media_lv = list(dict.fromkeys(meta['Media']))
strain_lv = ['1','97','98','99']
X = [np.ones(len(meta))]
for lv in media_lv[1:]: X.append((meta['Media']==lv).astype(float).values)
for lv in strain_lv[1:]: X.append((meta['Strain'].astype(str)==lv).astype(float).values)
X = np.column_stack(X); p = X.shape[1]
sidx = {int(lv): 1+len(media_lv)-1+i for i,lv in enumerate(strain_lv[1:])}
print("design cols:", ["intercept"]+media_lv[1:]+strain_lv[1:], " p =", p)

# size factors: median-of-ratios (exact DESeq2)
logK = np.log(K, where=K>0, out=np.full_like(K,-np.inf))
g = np.exp(np.nanmean(logK, axis=1))
use = g>0
medratio = np.median(K[use]/g[use][:,None], axis=0)
sf = medratio/np.median(medratio); off = np.log(sf)
print("size factors median=1:", np.round(sf,3))

def irls(X,y,off,phi,iters=150,tol=1e-7):
    b=np.zeros(X.shape[1])
    for _ in range(iters):
        eta=np.clip(X@b+off,-40,40); mu=np.exp(eta); w=mu/(1+phi*mu); z=eta+(y-mu)/mu
        WtW=X.T@(w[:,None]*X); Wtz=X.T@(w*z)
        try: bn=np.linalg.solve(WtW,Wtz)
        except np.linalg.LinAlgError: bn=np.linalg.lstsq(WtW,Wtz,rcond=None)[0]
        if np.max(np.abs(bn-b))<tol: b=bn; break
        b=bn
    eta=np.clip(X@b+off,-40,40); mu=np.exp(eta); w=mu/(1+phi*mu)
    WtW=X.T@(w[:,None]*X)
    try: cov=np.linalg.inv(WtW)
    except np.linalg.LinAlgError: cov=np.linalg.pinv(WtW)
    return b,cov,mu

def negll(logphi,y):
    phi=np.exp(logphi); r=1.0/phi
    b,cov,mu=irls(X,y,off,phi,iters=60,tol=1e-5)
    t1=np.sum(y*np.log(np.clip(mu,1e-30,None))-mu)
    t2=special.gammaln(y+r)-special.gammaln(r)-special.gammaln(y+1)+r*np.log(r)-(r+y)*np.log(r+mu)
    return -np.sum(t1+t2)

# pass 1: per-gene MLE dispersion
gene_disp=np.zeros(n); means=np.zeros(n)
for i in range(n):
    y=K[i]
    try:
        res=optimize.minimize_scalar(negll,bounds=(np.log(1e-4),np.log(1000)),args=(y,),method='bounded',options={'xatol':1e-3})
        d=np.exp(res.x)
    except Exception:
        d=0.1
    gene_disp[i]=min(max(d,1e-4),1e3)
    means[i]=np.mean(y/np.exp(off))

# trend: lowess log10(d) vs log10(mean)
xm=np.log10(np.clip(means,1e-3,None)); xd=np.log10(gene_disp)
res=lowess(xd,xm,frac=0.5,return_sorted=True); xs,ys=res[:,0],res[:,1]
d0=10.0**np.interp(xm,xs,ys)
# shrink (DESeq2 weighting)
w1=(gene_disp-d0)**2/d0**2; w2=(gene_disp-d0)**2/gene_disp**2
v=np.clip((w1*d0+w2*gene_disp)/(w1+w2),1e-4,1e3)
print(f"dispersion gene-wise med={np.median(gene_disp):.3f}  trend med={np.median(d0):.3f}  shrunk med={np.median(v):.3f}")

def bh(pv):
    pv=np.asarray(pv); n=len(pv); o=np.argsort(pv); rk=pv[o]
    adj_ranked=rk*n/np.arange(1,n+1)
    adj_ranked=np.minimum.accumulate(adj_ranked[::-1])[::-1]
    out=np.empty(n); out[o]=adj_ranked
    return np.clip(out,0,1)

# pass 2: Wald test per strain contrast (shrunk dispersion)
P={lv:np.zeros(n) for lv in [97,98,99]}
for i in range(n):
    y=K[i]; b,cov,mu=irls(X,y,off,v[i])
    for lv in [97,98,99]:
        k=sidx[lv]; se=np.sqrt(max(cov[k,k],1e-12)); P[lv][i]=2*(1-stats.norm.cdf(abs(b[k]/se)))
Adj={lv:bh(P[lv]) for lv in [97,98,99]}
A=set(np.array(genes)[Adj[97]<0.05]); B=set(np.array(genes)[Adj[98]<0.05]); C=set(np.array(genes)[Adj[99]<0.05])
unionAB=A|B; final=unionAB-C

print("\n=== CALIBRATION (median raw p, ~0.5 if well-calibrated) ===")
for lv in [97,98,99]:
    print(f"  strain {lv}: median p={np.median(P[lv]):.3f}  frac p<0.05={ (P[lv]<0.05).mean():.3f}")
print("\n=== RESULTS ===")
print(f"|A|  (DE strain 97 vs JBX1)  = {len(A)}")
print(f"|B|  (DE strain 98 vs JBX1)  = {len(B)}")
print(f"|C|  (DE strain 99 vs JBX1)  = {len(C)}")
print(f"|A U B|                       = {len(unionAB)}")
print(f"|A n B|                       = {len(A&B)}")
print(f"|A n C|                       = {len(A&C)}")
print(f"|B n C|                       = {len(B&C)}")
print(f"FINAL  |(A U B) \\ C|          = {len(final)}")
pd.DataFrame({'log10mean':means,'gene_disp':gene_disp,'trend':d0,'shrunk':v,
  'p_97':P[97],'padj_97':Adj[97],'p_98':P[98],'padj_98':Adj[98],'p_99':P[99],'padj_99':Adj[99]},index=genes).to_csv('de_results.csv')
print("saved de_results.csv")
