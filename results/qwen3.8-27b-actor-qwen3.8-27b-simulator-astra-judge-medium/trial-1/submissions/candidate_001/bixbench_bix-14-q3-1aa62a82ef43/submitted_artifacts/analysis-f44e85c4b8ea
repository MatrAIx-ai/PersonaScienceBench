#!/usr/bin/env python
"""
BixBench bix-14-q3: Non-reference exonic variants in CHIP genes, 86 samples.

Question: After filtering out reference variant calls and variants located in
intronic, intergenic, or UTR regions, how many non-reference exonic variants
remain in clonal hematopoiesis (CHIP) genes from the 86 samples analyzed?

Method (approved plan):
1. Parse each of the 86 per-sample xlsx files (2-row header -> header=1).
2. CHIP gene match: comma-split 'Gene Names'; keep if any token exactly equals
   one of the 56 symbols in 230214_Schenz_et_al_2022_CHIP_Genes.xlsx.
   (File's In_CHIP flag NOT used - it is a broader list.)
3. Non-reference: Zygosity in {Heterozygous, Homozygous Variant}
   (excludes 'Reference' and not-called NaN).
4. Exonic only: 'Sequence Ontology (Combined)' in
   {missense_variant, synonymous_variant, frameshift_variant,
    inframe_insertion, inframe_deletion}.
   Excluded: intron_variant, splice_region_variant (intronic per HGVS),
   5'/3' UTR terms, upstream_gene_variant, intergenic (absent in data).
5. Dedup: drop fully duplicated rows within each file.
6. Primary count = total non-reference exonic variant calls
   (sample-variant pairs) summed over the 86 samples.
   Secondary: unique genomic variants (Chr:Pos+Ref/Alt), per-sample table.
"""
import pandas as pd
import glob

DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
GENES_FILE = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"

EXONIC_SO = {
    "missense_variant",
    "synonymous_variant",
    "frameshift_variant",
    "inframe_insertion",
    "inframe_deletion",
}
NON_REF_ZYG = {"Heterozygous", "Homozygous Variant"}

# --- Load authoritative 56-gene CHIP list ---
genes = (
    pd.read_excel(GENES_FILE, header=None)[0]
    .dropna()
    .astype(str)
    .str.strip()
    .tolist()
)
assert len(genes) == len(set(genes)) == 56, f"expected 56 unique genes, got {len(genes)}"
CHIP_GENES = set(genes)

files = sorted(glob.glob(f"{DATA_DIR}/*.xlsx"))
assert len(files) == 86, f"expected 86 sample files, got {len(files)}"

rows = []
for f in files:
    fid = f.split("CHIP_")[-1].replace(".xlsx", "")
    d = pd.read_excel(f, header=1)
    d["Sample"] = fid
    rows.append(d)

allv = pd.concat(rows, ignore_index=True)
print(f"Total parsed rows (all 86 samples): {len(allv):,}")
print(f"Unique sample IDs: {allv['Sample'].nunique()}")

# --- Step 1: dedup fully duplicated rows within each sample file ---
before = len(allv)
allv = allv.drop_duplicates().reset_index(drop=True)
print(f"Dedup: {before - len(allv)} fully duplicated rows removed -> {len(allv):,}")

# --- Step 2: CHIP gene match (comma-split Gene Names, exact symbol) ---
tok = allv["Gene Names"].astype(str).str.split(",").apply(
    lambda t: any(x.strip() in CHIP_GENES for x in t)
)
chip = allv[tok]
print(f"Rows in CHIP (56-gene) genes: {len(chip):,}")

# --- Step 3: exonic SO filter ---
exon = chip[chip["Sequence Ontology (Combined)"].isin(EXONIC_SO)]
print(f"Exonic rows in CHIP genes (all zygosity): {len(exon):,}")

# --- Step 4: non-reference zygosity ---
final = exon[exon["Zygosity"].isin(NON_REF_ZYG)]
print(f"NON-REFERENCE EXONIC CHIP variant calls: {len(final):,}")

# --- Sanity: SO-term composition of final set ---
print("\nFinal set SO-term composition:")
print(final["Sequence Ontology (Combined)"].value_counts().to_string())

# --- Dedup invariance check: count WITHOUT dropping duplicates ---
raw = pd.concat(rows, ignore_index=True)
raw_final = (
    raw[raw["Gene Names"].astype(str).str.split(",")
        .apply(lambda t: any(x.strip() in CHIP_GENES for x in t))]
    [lambda d: d["Sequence Ontology (Combined)"].isin(EXONIC_SO)
     & d["Zygosity"].isin(NON_REF_ZYG)]
)
print(f"\nDedup check: count without dedup = {len(raw_final):,} "
      f"(identical: {len(raw_final) == len(final)})")

# --- Secondary: unique genomic variants ---
uniq = final["Chr:Pos"].str.cat(final["Ref/Alt"], sep="|")
n_uniq = uniq.nunique()
n_samples_hit = final["Sample"].nunique()
print(f"Unique genomic variants (Chr:Pos|Ref/Alt): {n_uniq:,} "
      f"found in {n_samples_hit} samples")

# --- Per-sample breakdown ---
per = final.groupby("Sample").size().sort_index().rename("nonref_exonic_CHIP_calls")
per = per.reindex(sorted(allv["Sample"].unique()), fill_value=0)
per.to_csv("per_sample_counts.csv")
print(f"\nPer-sample: samples with >=1 call = {(per > 0).sum()}; "
      f"max = {per.max()}; min = {per.min()}")
print("\nPer-sample table (all 86):")
print(per.to_string())
print(f"\nFINAL ANSWER: {len(final)} non-reference exonic variant calls")
