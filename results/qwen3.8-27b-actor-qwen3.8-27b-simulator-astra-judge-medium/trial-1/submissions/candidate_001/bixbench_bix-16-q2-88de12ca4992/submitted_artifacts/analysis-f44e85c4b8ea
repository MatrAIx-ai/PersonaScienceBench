"""
Skewness of gene expression (log2(TPM+1)) distribution across all cell lines.

Question: What is the skewness characteristic of the gene expression
(log2(TPM+1)) distribution across all cell lines in the dataset?

Method: Pool all expression values (1,673 cell lines x 19,138 protein-coding
genes) into a single distribution and compute Fisher's skewness via
scipy.stats.skew (bias=True, the default).
"""

import numpy as np
import pandas as pd
from scipy import stats

# --- Load expression matrix ---
print("Loading expression matrix...")
expr = pd.read_csv(
    "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv",
    index_col=0,
)
print(f"Shape: {expr.shape[0]} cell lines x {expr.shape[1]} genes")
print(f"Total values: {expr.size:,}")

# --- Pool all values into a 1-D array ---
pooled = expr.values.ravel()
print(f"Pooled array length: {len(pooled):,}")
print(f"Any NaN: {np.isnan(pooled).any()}")

# --- Compute summary statistics ---
skewness = stats.skew(pooled)          # Fisher, bias=True (default)
mean_val = np.mean(pooled)
median_val = np.median(pooled)
std_val = np.std(pooled)                # population std (ddof=0), matches skew normalisation
min_val = np.min(pooled)
max_val = np.max(pooled)

# --- Qualitative description ---
if skewness > 0.5:
    desc = "strongly right-skewed (positive skew)"
elif skewness > 0.1:
    desc = "moderately right-skewed (positive skew)"
elif skewness < -0.5:
    desc = "strongly left-skewed (negative skew)"
elif skewness < -0.1:
    desc = "moderately left-skewed (negative skew)"
else:
    desc = "approximately symmetric"

# --- Report ---
print("\n===== RESULTS =====")
print(f"Skewness (Fisher, scipy.stats.skew, bias=True): {skewness:.6f}")
print(f"Mean:   {mean_val:.6f}")
print(f"Median: {median_val:.6f}")
print(f"Std:    {std_val:.6f}")
print(f"Min:    {min_val:.6f}")
print(f"Max:    {max_val:.6f}")
print(f"\nQualitative: {desc}")
print(f"Mean > Median ({mean_val:.4f} > {median_val:.4f}) → consistent with right skew")
