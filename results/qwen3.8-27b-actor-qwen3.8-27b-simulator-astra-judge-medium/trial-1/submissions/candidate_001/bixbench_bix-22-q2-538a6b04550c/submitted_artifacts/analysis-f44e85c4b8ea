#!/usr/bin/env python3
"""
BixBench bix-22-q2
Question: Pearson correlation coefficient between gene length and mean expression
(across samples) for protein-coding genes in CD4 immune cells.

Approved plan:
  1. Load the three CSVs (counts indexed by gene symbol).
  2. Filter protein-coding genes: gene_biotype == 'protein_coding' (exact).
  3. Select CD4 samples: celltype == 'CD4'.
  4. Subset counts matrix to the CD4 columns.
  5. Per-gene mean expression = arithmetic mean of untransformed counts across CD4 samples.
  6. Join with Length on gene symbol.
  7. Compute standard two-tailed Pearson r.
"""
import pandas as pd
import numpy as np
from scipy import stats

DATA = "data"

# 1. Load
gm = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv")
bc = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
sa = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")

# 2. Protein-coding genes (exact match), keyed by gene symbol
pc = gm[gm["gene_biotype"] == "protein_coding"].copy()
pc_keys = pc["Unnamed: 0"].tolist()

# 3. CD4 samples
cd4 = sa.loc[sa["celltype"] == "CD4", "sample"].tolist()

# 4. Subset counts to CD4 columns, and to protein-coding genes
sub = bc.loc[pc_keys, cd4]

# 5. Per-gene mean expression (arithmetic mean across CD4 samples, untransformed)
mean_expr = sub.mean(axis=1)

# 6. Join with Length
merged = pd.DataFrame({
    "gene": pc_keys,
    "Length": pc["Length"].to_numpy(),
    "mean_expr": mean_expr.to_numpy(dtype=float),
})
# Drop any non-finite (none expected); retain mean==0 genes
merged = merged[np.isfinite(merged["Length"]) & np.isfinite(merged["mean_expr"])]

# 7. Standard two-tailed Pearson r
r, p = stats.pearsonr(merged["Length"], merged["mean_expr"])

print("=== DIAGNOSTICS ===")
print(f"protein_coding genes (exact): {len(pc)}")
print(f"CD4 samples: {len(cd4)}")
print(f"genes used in correlation: {len(merged)}")
print(f"  genes with mean_expr == 0: {(merged['mean_expr'] == 0).sum()}")
print(f"  genes with mean_expr >  0: {(merged['mean_expr'] >  0).sum()}")
print(f"Length: mean={merged['Length'].mean():.2f}, min={merged['Length'].min()}, max={merged['Length'].max()}")
print(f"mean_expr: mean={merged['mean_expr'].mean():.4f}, max={merged['mean_expr'].max():.4f}")
print(f"Pearson r = {r:.6f}")
print(f"p-value   = {p:.6e}")
print(f"r^2       = {r**2:.6f}")
