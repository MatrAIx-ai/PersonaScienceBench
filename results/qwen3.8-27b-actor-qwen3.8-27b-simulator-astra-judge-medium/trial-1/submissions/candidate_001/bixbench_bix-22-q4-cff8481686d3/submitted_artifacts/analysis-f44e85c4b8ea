#!/usr/bin/env python3
"""
BixBench bix-22-q4: Pearson correlation between gene length and mean expression
(across samples) for protein-coding genes in CD14 immune cells.

Pipeline (as approved):
1. Sample_annotated: filter celltype == 'CD14' -> 132 sample names.
2. GeneMetaInfo: exact match gene_biotype == 'protein_coding' -> 19,942 genes.
3. BatchCorrectedReadCounts: index on first (gene-symbol) column, select CD14 columns.
4. Inner-join protein-coding genes present in the matrix.
5. Per-gene arithmetic mean across the 132 CD14 samples (raw values, no transform).
6. scipy.stats.pearsonr(Length, mean_expr).
"""
import pandas as pd
from scipy import stats

DATA = "data"

# 1) CD14 samples
ann = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")
cd14 = ann.loc[ann["celltype"] == "CD14", "sample"].tolist()
print(f"CD14 samples: {len(cd14)}")

# 2) protein-coding genes (exact match)
meta = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv", index_col=0)
pc = meta.loc[meta["gene_biotype"] == "protein_coding", ["Geneid", "Length"]].copy()
print(f"protein_coding genes (exact match): {len(pc)}")

# 3) count matrix, CD14 columns only
counts = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
missing_cols = [s for s in cd14 if s not in counts.columns]
print(f"CD14 columns missing from matrix: {len(missing_cols)}")
cd14_counts = counts[cd14]

# 4) inner join
pc["Geneid"] = pc["Geneid"].astype(str)
joined = pc.loc[pc["Geneid"].isin(cd14_counts.index)]
print(f"protein-coding genes present in count matrix: {len(joined)}")

# 5) per-gene arithmetic mean across CD14 samples
matrix = cd14_counts.loc[cd14_counts.index.intersection(joined["Geneid"]), :]
mean_expr = matrix.mean(axis=1)
df = pd.DataFrame({"Length": joined.set_index("Geneid").loc[mean_expr.index, "Length"].values,
                   "mean_expr": mean_expr.values})
print(f"Genes in final correlation: {len(df)}")

# 6) Pearson correlation
r, p = stats.pearsonr(df["Length"], df["mean_expr"])
print(f"\nRESULT: Pearson r = {r:.6f}  (n = {len(df)} genes, p = {p:.3e})")
