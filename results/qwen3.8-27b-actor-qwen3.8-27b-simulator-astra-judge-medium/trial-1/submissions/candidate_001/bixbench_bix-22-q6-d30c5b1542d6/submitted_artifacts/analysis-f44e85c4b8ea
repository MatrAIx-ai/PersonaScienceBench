"""
BixBench bix-22-q6
Question: When examining protein-coding genes only, what is the Pearson correlation
coefficient between gene length and gene expression?

Method (approved plan):
  - Filter GeneMetaInfo to gene_biotype == 'protein_coding'.
  - Per-gene expression = arithmetic MEAN of the 723 batch-corrected read counts.
  - Keep the 645 zero-expression protein-coding genes (no missing values exist).
  - Pearson r between Length (as-is) and per-gene mean expression.
Sensitivities (as flagged):
  - median reduction across samples
  - drop zero-expression genes (mean reduction)
"""
import numpy as np
import pandas as pd
from scipy import stats

# ---- Load inputs ----
meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)   # gene names as index
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
# sample annotation loaded for completeness / verification (not needed for the r itself)
samp = pd.read_csv('data/Sample_annotated_Zenodo.csv')

# ---- Sanity: clean 1:1 joins (verified during inspection) ----
assert set(meta.index) == set(counts.index), "gene id mismatch between meta and counts"
assert set(samp['sample']) == set(counts.columns), "sample annotation <-> count cols mismatch"

# ---- Filter to protein-coding genes ----
pc = meta[meta['gene_biotype'] == 'protein_coding']
length = pc['Length'].astype(float)                 # Length as-is (integer bp)
cpc = counts.loc[pc.index]                          # 19,942 genes x 723 samples

n_samples = cpc.shape[1]
n_pc = len(pc)

# ---- Primary: mean expression per gene, keep zeros ----
mean_expr = cpc.mean(axis=1)
r_primary, p_primary = stats.pearsonr(length, mean_expr)

# ---- Sensitivity 1: median reduction (keep zeros) ----
med_expr = cpc.median(axis=1)
r_median, p_median = stats.pearsonr(length, med_expr)

# ---- Sensitivity 2: drop zero-expression genes (mean reduction) ----
nz = mean_expr > 0
r_droz, p_droz = stats.pearsonr(length[nz], mean_expr[nz])

# ---- Report ----
n_zero = int((mean_expr == 0).sum())
print("=" * 60)
print("Protein-coding genes:", n_pc)
print("Samples (columns):", n_samples)
print("Zero-expression protein-coding genes (kept):", n_zero)
print("Missing/NaN expression values:", int(mean_expr.isna().sum()))
print("-" * 60)
print("PRIMARY  Pearson r (Length vs MEAN expression, keep zeros)")
print(f"   r = {r_primary:.6f}   (n = {n_pc}, p = {p_primary:.3e})")
print("-" * 60)
print("Sensitivity 1: MEDIAN reduction across samples (keep zeros)")
print(f"   r = {r_median:.6f}   (n = {n_pc}, p = {p_median:.3e})")
print("Sensitivity 2: drop zero-expression genes (MEAN reduction)")
print(f"   r = {r_droz:.6f}   (n = {int(nz.sum())}, p = {p_droz:.3e})")
print("=" * 60)
