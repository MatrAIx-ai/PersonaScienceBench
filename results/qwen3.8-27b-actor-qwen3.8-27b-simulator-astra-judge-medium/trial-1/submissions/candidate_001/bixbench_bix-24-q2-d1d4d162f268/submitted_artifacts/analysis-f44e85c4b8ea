#!/usr/bin/env python3
"""
CBD metabolic-effects analysis (CRC RNA-seq).
DEA: limma-voom implemented in Python (TMM -> log2CPM -> voom weights -> eBayes -> BH).
Primary contrast: CBD_IC50 (g7) vs DMSO (g3) [CBD vs vehicle, full serum].
Sensitivity: g8 vs g4 (CBD under serum starvation); g9 vs g5 (CBD + cisplatin).
Thresholds: padj < 0.05 and |log2FC| > 0.5.
GO-BP: over-representation (hypergeometric) of up/down DE sets, if an Ensembl-keyed
       human GO-BP annotation is present in the environment; otherwise report the
       limitation (no fabrication of gene->GO mappings).
ASSUMPTION: the _1/_2/_3 within each condition are 3 independent BIOLOGICAL
replicates (distinct library barcodes), not technical replicates.
"""
import os, glob, json
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.nonparametric.smoothers_lowess import lowess

OUT = "results"; os.makedirs(OUT, exist_ok=True)
MIN_TOTAL = 10          # mild min-count filter
PADJ, FC = 0.05, 0.5
report = {}

# ---------------------------------------------------------------- load + join
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
counts.index.name = "gene"
layout = pd.read_csv("data/sample_layout.csv")
goc = {}
for col in counts.columns:
    sid = col.replace("_", "-")
    g = layout.loc[layout["SampleID"] == sid, "Group"]
    assert len(g) == 1
    goc[col] = g.iloc[0]
goc = pd.Series(goc)
report["n_samples"] = int(len(counts.columns))
report["n_genes_raw"] = int(counts.shape[0])
report["groups"] = {k: int(v) for k, v in goc.value_counts().items()}

# ---------------------------------------------------------------- min-count
total = counts.to_numpy().sum(axis=1)
keep = total >= MIN_TOTAL
report["min_count_filter"] = f"total reads >= {MIN_TOTAL} across all 30 samples"
report["n_genes_filtered"] = int(keep.sum())
counts = counts.loc[keep]
genes = counts.index.to_numpy()

# ---------------------------------------------------------------- TMM
C = counts.to_numpy(dtype=float); lib = C.sum(axis=0)
cpm = C / lib * 1e6
allpos = (cpm > 0).all(axis=1)
ref = np.zeros(cpm.shape[0]); ref[allpos] = np.exp(np.log(cpm[allpos]).mean(axis=1))
idx = ref > 0
y2 = np.log2(cpm[idx] / ref[idx][:, None])
fac = np.ones(cpm.shape[1])
for s in range(cpm.shape[1]):
    x = y2[:, s]; m = np.median(x); sr = 1.4826 * np.median(np.abs(x - m))
    if sr == 0 or not np.isfinite(sr): sr = 1e-6
    w = 1.0 / (1 + (x - m) ** 2 / (2 * sr ** 2))
    w[np.abs(x - m) > np.percentile(np.abs(x - m), 99)] = 0
    fac[s] = np.exp(np.sum(w * x) / np.sum(w))
normlib = lib * fac
report["tmm_factors"] = [round(float(f), 4) for f in fac]

# ---------------------------------------------------------------- log2CPM
L = np.log2((C + 2.0) / normlib * 1e6)   # prior.count = 2 (edgeR/voom default)

def bh(p):
    p = np.asarray(p, float); n = len(p); o = np.argsort(p); r = p[o]
    a = np.clip(r * n / np.arange(1, n + 1), 0, 1)
    a = np.minimum.accumulate(a[::-1])[::-1]
    out = np.empty(n); out[o] = a; return out

cols = list(counts.columns)
def cols_for(g): return [c for c in cols if goc[c] == g]

def voom_contrast(gA, gB, label):
    ia = [cols.index(c) for c in cols_for(gA)]; ib = [cols.index(c) for c in cols_for(gB)]
    A = L[:, ia]; B = L[:, ib]; nA, nB = A.shape[1], B.shape[1]
    mA = A.mean(1); mB = B.mean(1); b1 = mB - mA
    df = nA + nB - 2
    s2 = (((A - mA[:, None]) ** 2).sum(1) + ((B - mB[:, None]) ** 2).sum(1)) / df
    su = np.sqrt(1.0 / nA + 1.0 / nB)
    mu = L.mean(1)
    pv = np.exp(lowess(np.log(s2 + 1e-12), mu, frac=1.0 / 3.0, xvals=mu, return_sorted=False))
    wv = 1.0 / pv
    # eBayes prior (limma formula)
    prior = np.sum(wv * df * s2) / np.sum(wv * df)
    df0 = (np.sum(wv * df)) ** 2 / np.sum(wv * df * (s2 / prior) ** 2)
    sm = (df * s2 + df0 * prior) / (df + df0)
    tmod = b1 / (np.sqrt(sm) * su); pmod = 2 * stats.t.sf(np.abs(tmod), df + df0); padj_mod = bh(pmod)
    # unmoderated cross-check
    traw = b1 / (np.sqrt(s2 + 1e-12) * su); praw = 2 * stats.t.sf(np.abs(traw), df); padj_raw = bh(praw)
    res = pd.DataFrame({"gene": genes, "log2FC": b1, "t": tmod, "p": pmod, "padj": padj_mod,
                        "baseMean": np.concatenate([A, B], axis=1).mean(1),
                        "meanA": mA, "meanB": mB})
    res.sort_values("padj").to_csv(f"{OUT}/DE_{label}.csv", index=False)
    up = res[(res.padj < PADJ) & (res.log2FC > FC)]
    dn = res[(res.padj < PADJ) & (res.log2FC < -FC)]
    up[["gene", "log2FC", "padj"]].sort_values("log2FC", ascending=False).to_csv(f"{OUT}/UP_{label}.csv", index=False)
    dn[["gene", "log2FC", "padj"]].sort_values("log2FC").to_csv(f"{OUT}/DOWN_{label}.csv", index=False)
    # robust direction (independent of significance threshold)
    frac_down = float((b1 < 0).mean()); med_fc = float(np.median(b1))
    info = {
        "contrast": f"{gB} vs {gA}", "n_genes": int(len(res)), "prior_var": float(prior), "df0": float(df0),
        "n_up": int(len(up)), "n_down": int(len(dn)), "n_DE": int(len(up) + len(dn)),
        "n_padj_significant_anyFC": int((padj_mod < PADJ).sum()),
        "n_up_unmoderated": int(((padj_raw < PADJ) & (b1 > FC)).sum()),
        "n_down_unmoderated": int(((padj_raw < PADJ) & (b1 < -FC)).sum()),
        "median_log2FC": med_fc, "frac_genes_down": frac_down,
        "direction": "DOWN-dominated" if len(dn) > len(up) else ("UP-dominated" if len(up) > len(dn) else "balanced"),
    }
    print(f"\n===== {label}: {gB} vs {gA} =====")
    print(f"  n={info['n_genes']}  prior_var={prior:.4g}  df0={df0:.3g}")
    print(f"  DE(padj<{PADJ},|FC|>{FC}): UP={len(up)}  DOWN={len(dn)}  TOTAL={len(up)+len(dn)}  [{info['direction']}]")
    print(f"  robust direction: median log2FC={med_fc:+.3f}, frac genes down={frac_down:.2f}")
    print(f"  unmoderated cross-check: UP={info['n_up_unmoderated']} DOWN={info['n_down_unmoderated']}  (underpowered at n=3)")
    return res, up, dn, info

P, p_up, p_dn, p_info = voom_contrast("DMSO", "CBD_IC50", "g7_CBD_vs_g3_DMSO")
S1, s1_up, s1_dn, s1_info = voom_contrast("DMSO_Serum_starvation", "CBD_IC50_Serum_starvation_16h", "g8_CBDSS_vs_g4_DMSOSS")
S2, s2_up, s2_dn, s2_info = voom_contrast("Cisplatin_IC50", "Cisplatin_IC50_CBD_IC50", "g9_CisPlatCBD_vs_g5_CisPlat")
report["DE"] = {"primary_g7v3": p_info, "sensitivity_g8v4": s1_info, "sensitivity_g9v5": s2_info}
report["primary_up_genes"] = int(len(p_up)); report["primary_down_genes"] = int(len(p_dn))

# ---------------------------------------------------------------- GO-BP
print("\n===== GO-BP enrichment: environment probe =====")
def find_annotation():
    pats = ["*.gmt", "*org.Hs*", "*GOTERM*", "*gene2go*", "*GOA*txt", "*msigdb*", "*hallmark*",
            "*go.bp*", "*go_bp*", "*goa*", "*ensembl*symbol*", "*symbol*ensembl*"]
    roots = [".", "data", "results", "/workspace", "/data", "/opt", "/home"]
    hits = set()
    for root in roots:
        for pat in pats:
            for f in glob.glob(os.path.join(root, "**", pat), recursive=True):
                if os.path.isfile(f) and "terminfo" not in f and "goa-" not in f.lower():
                    hits.add(f)
    return sorted(hits)

ann_hits = find_annotation()
have_R = os.system("command -v Rscript >/dev/null 2>&1") == 0
report["go_bp"] = {"annotation_files_found": ann_hits, "R_available": have_R,
                   "network": "blocked (verified)", "status": "none"}
if ann_hits or have_R:
    # (would run hypergeometric OVR here / clusterProfiler if R+DB present)
    report["go_bp"]["status"] = "annotation available - OVR would run"
else:
    report["go_bp"]["status"] = ("BLOCKED: no Ensembl-keyed GO-BP annotation, no R/clusterProfiler, "
                                 "no network, no symbol<->Ensembl map present. Per protocol, no "
                                 "gene->GO mappings are fabricated.")
    print("  annotation files found:", ann_hits if ann_hits else "NONE")
    print("  R available:", have_R)
    print("  -> BLOCKED (no annotation obtainable in this environment; no fabrication)")

with open(f"{OUT}/report.json", "w") as f:
    json.dump(report, f, indent=2)
print(f"\nSaved {len(os.listdir(OUT))} files to {OUT}/")
print("DONE")
