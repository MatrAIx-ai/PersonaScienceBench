#!/usr/bin/env python3
"""
BCG vaccination and COVID-19 severity: ordinal regression (proportional odds).
Question: OR of BCG on severity controlling for prior medical-history count and
patients-interaction frequency, with interaction terms.

Data: TASK008_BCG-CORONA capsule (DM, AE, MH.csv, MH.xlsx -- xlsx verified identical to csv).
Approach (approved plan):
  - unit = subject; outcome = max AESEV per USUBJID, ordinal 1-4
  - exclude subjects with no non-missing AESEV (n=209)
  - BCG = (TRTGRP=='BCG'); mh_count = MH rows per subject; ps = patients_seen ('1-50' ref, '51-100', '>100')
  - headline: severity ~ BCG + mh + ps + BCG:mh + BCG:ps   (statsmodels OrderedModel, logit)
  - sensitivity: + 3-way BCG:mh:ps
  - proportional-odds score test (Rao) + LR cross-check vs cutpoint-varying-slopes model
"""
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = "data"
dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")
mh_xl = pd.read_excel(f"{DATA}/TASK008_BCG-CORONA_MH.xlsx")

# ---- MH.xlsx duplicate check ----
xl_same = (mh_xl.fillna("").astype(str).reset_index(drop=True)
           .equals(mh_csv := mh.fillna("").astype(str).reset_index(drop=True)))
print(f"MH.xlsx identical to MH.csv: {xl_same}  (rows: {len(mh_xl)} vs {len(mh)})")

# ---- subject-level dataset ----
maxsev = ae.groupby("USUBJID")["AESEV"].max()
mhc = mh.groupby("USUBJID").size().rename("mh_count")
d = dm.merge(maxsev.rename("severity"), on="USUBJID").merge(mhc, on="USUBJID")
n_total = len(d)
n_dropped = int(d["severity"].isna().sum())
d = d[d["severity"].notna()].copy()
d["severity"] = d["severity"].astype(int)
d["bcg"] = (d["TRTGRP"] == "BCG").astype(int)
d["ps"] = pd.Categorical(d["patients_seen"], categories=["1-50", "51-100", ">100"]).codes
d["ps2"] = (d["ps"] == 1).astype(int)   # '51-100'
d["ps3"] = (d["ps"] == 2).astype(int)   # '>100'
n_used = len(d)
print(f"\nn total subjects: {n_total} | dropped (no AESEV): {n_dropped} | used: {n_used}")

# ---- severity distribution per arm ----
ct = pd.crosstab(d["TRTGRP"], d["severity"])
ct_pct = (ct.div(ct.sum(axis=1), axis=0) * 100).round(1)
print("\nSeverity (max AESEV 1-4) per arm, counts (row %):")
print(ct)
print(ct_pct)
print("\npatients_seen per arm:\n", pd.crosstab(d["TRTGRP"], d["patients_seen"]))
print("mh_count per arm:\n", d.groupby("TRTGRP")["mh_count"].describe()[["mean", "std", "min", "max"]])

# ---- design matrices ----
X_cols = ["bcg", "mh_count", "ps2", "ps3", "bcg_mh", "bcg_ps2", "bcg_ps3"]
X = pd.DataFrame({
    "bcg": d["bcg"], "mh_count": d["mh_count"], "ps2": d["ps2"], "ps3": d["ps3"],
    "bcg_mh": d["bcg"] * d["mh_count"], "bcg_ps2": d["bcg"] * d["ps2"], "bcg_ps3": d["bcg"] * d["ps3"],
}, index=d.index)
X3 = X.copy()
X3["bcg_mh_ps2"] = X["bcg_mh"] * d["ps2"]
X3["bcg_mh_ps3"] = X["bcg_mh"] * d["ps3"]
y = d["severity"].values
F = stats.logistic.cdf

def fit_ord(Xdf, label):
    m = OrderedModel(y, Xdf, distr="logit")
    r = m.fit(method="bfgs", maxiter=500, disp=False)
    print(f"\n=== {label} ===")
    print(f"converged: {r.mle_retvals['converged']} | loglik: {r.llf:.3f} | n: {r.nobs}")
    print(pd.Series(r.params, index=r.model.exog_names).round(4).to_string())
    return r

r2 = fit_ord(X, "HEADLINE: severity ~ BCG + mh + ps + BCG:mh + BCG:ps")
r3 = fit_ord(X3, "SENSITIVITY: + 3-way BCG:mh:ps")

def or_report(r, name):
    p = r.params
    V = r.cov_params()
    b, se = p["bcg"], np.sqrt(V.loc["bcg", "bcg"])
    z = b / se
    pv = 2 * stats.norm.sf(abs(z))
    print(f"\n{name}:")
    print(f"  beta_BCG = {b:.4f} (SE {se:.4f})  z={z:.3f}  p={pv:.4f}")
    print(f"  OR (main effect, at mh=0, ps='1-50') = {np.exp(b):.4f}  "
          f"95% CI [{np.exp(b - 1.96*se):.4f}, {np.exp(b + 1.96*se):.4f}]")
    # marginal OR at mean mh_count and modal ps level (reference '1-50')
    mh_mean = d["mh_count"].mean()
    gs = pd.Series(0.0, index=p.index)
    gs.loc["bcg"] = 1.0
    if "bcg_mh" in p.index:
        gs.loc["bcg_mh"] = mh_mean
    logor = float(gs @ p)
    var = float(gs @ V @ gs)
    se_m = np.sqrt(var)
    print(f"  marginal log-OR at mh={mh_mean:.2f}, ps='1-50' (modal): {logor:.4f} (SE {se_m:.4f})")
    print(f"  MARGINAL OR = {np.exp(logor):.4f}  95% CI [{np.exp(logor-1.96*se_m):.4f}, {np.exp(logor+1.96*se_m):.4f}]")
    return np.exp(b), (np.exp(b-1.96*se), np.exp(b+1.96*se)), pv, np.exp(logor), (np.exp(logor-1.96*se_m), np.exp(logor+1.96*se_m))

h2 = or_report(r2, "HEADLINE model")
h3 = or_report(r3, "3-way sensitivity model")

# ---- proportional-odds score test (Rao) ----
# Full model: P(y<=k) = F(a_k - x b_k), slopes b_k vary by cutpoint.
# Null (PO): b_k = b for all k, at the PO MLE.
# T = S' I^{-1} S where S, I are score/observed info for extra params (b2-b1, b3-b1).
def po_score_test(r, Xmat, yvec, extra_df):
    p = r.params; xb_beta = p[:Xmat.shape[1]]
    a = r.model.transform_threshold_params(p)  # [-inf, a1, a2, a3, inf]
    def ll_full(delta):  # delta: (2*(K-1)*p) vector of (b2-b1, b3-b1)
        d1, d2 = delta[:len(xb_beta)], delta[len(xb_beta):]
        b1, b2, b3 = xb_beta, xb_beta + d1, xb_beta + d2
        Bs = [b1, b2, b3]
        ll = 0.0
        for j in range(1, 5):
            up = 1.0 if j == 4 else F(a[j] - Xmat @ Bs[j-1])
            lo = F(a[j-1] - Xmat @ Bs[j-2]) if j > 1 else 0.0
            ll += np.log(np.where(yvec == j, up - lo, 1.0)).sum()
        return ll
    k = len(xb_beta)
    zero = np.zeros(2 * k)
    h1 = 1e-5
    S = np.zeros(2 * k)
    for q in range(2 * k):
        e = np.zeros(2 * k); e[q] = h1
        S[q] = (ll_full(zero + e) - ll_full(zero - e)) / (2 * h1)
    h2s = 1e-2
    I = np.zeros((2 * k, 2 * k))
    for q in range(2 * k):
        for w in range(q, 2 * k):
            eq, ew = np.zeros(2 * k), np.zeros(2 * k); eq[q] = h2s; ew[w] = h2s
            if q == w:
                I[q, q] = (ll_full(zero + eq) - 2 * ll_full(zero) + ll_full(zero - eq)) / h2s**2
            else:
                I[q, w] = I[w, q] = (ll_full(zero + eq + ew) - ll_full(zero + eq - ew)
                                     - ll_full(zero - eq + ew) + ll_full(zero - eq - ew)) / (4 * h2s**2)
    I = -I
    # observed info can be near-singular in directions where the extra slope is
    # (near) unidentifiable (e.g. BCG x ps'>100 at cut 3: only 1 subject);
    # use the identifiable subspace: T = sum S_v^2/lambda over lambda > tol
    ev, vv = np.linalg.eigh(I)
    tol = ev.max() * 1e-10
    keep = ev > tol
    Sv = vv.T @ S
    T = float(np.sum(Sv[keep]**2 / ev[keep]))
    df = int(keep.sum())
    pval = stats.chi2.sf(T, df)
    return T, df, pval, S, I

T2, df2, p2, S2, I2 = po_score_test(r2, X.values, y, 7)
T3, df3, p3, S3, I3 = po_score_test(r3, X3.values, y, 9)
print("\n=== Proportional-odds (Rao score) test vs cutpoint-varying slopes ===")
print(f"HEADLINE model:  T = {T2:.3f}, df = {df2}, p = {p2:.4f}")
print(f"3-way model:     T = {T3:.3f}, df = {df3}, p = {p3:.4f}")

# LR cross-check: fit full non-PO model with L-BFGS-B
from scipy.optimize import minimize
def fit_full(Xmat, yvec, b10, a0):
    k = len(b10)
    def negll(th):
        d1, d2, aa = th[:k], th[k:2*k], th[2*k:]
        b1, b2, b3 = b10, b10 + d1, b10 + d2
        Bs = [b1, b2, b3]
        ll = 0.0
        for j in range(1, 5):
            up = 1.0 if j == 4 else F(aa[j-1] - Xmat @ Bs[j-1])
            lo = F(aa[j-2] - Xmat @ Bs[j-2]) if j > 1 else 0.0
            ll += np.log(np.where(yvec == j, np.maximum(up - lo, 1e-12), 1.0)).sum()
        return -ll
    th0 = np.concatenate([np.zeros(2 * k), a0[1:4]])
    res = minimize(negll, th0, method="L-BFGS-B", options={"maxiter": 2000})
    return res

for label, r, Xm in [("HEADLINE", r2, X.values), ("3-way", r3, X3.values)]:
    a = r.model.transform_threshold_params(r.params)
    res = fit_full(Xm, y, r.params[:Xm.shape[1]], a)
    Tlr = 2 * (res.fun * -1 - r.llf)
    print(f"LR cross-check {label}: ll_full = {-res.fun:.3f} vs ll_po = {r.llf:.3f} -> "
          f"chi2 = {Tlr:.3f}, df = {2*Xm.shape[1]}, p = {stats.chi2.sf(Tlr, 2*Xm.shape[1]):.4f}")

print("\n=== SUMMARY ===")
print(f"HEADLINE OR (exp beta_BCG): {h2[0]:.4f}  95% CI {h2[1][0]:.4f}-{h2[1][1]:.4f}, p={h2[2]:.4f}")
print(f"HEADLINE marginal OR @ mean mh, modal ps: {h2[3]:.4f}  95% CI {h2[4][0]:.4f}-{h2[4][1]:.4f}")
print(f"3-way OR (exp beta_BCG):    {h3[0]:.4f}  95% CI {h3[1][0]:.4f}-{h3[1][1]:.4f}, p={h3[2]:.4f}")
print(f"3-way marginal OR:          {h3[3]:.4f}  95% CI {h3[4][0]:.4f}-{h3[4][1]:.4f}")
