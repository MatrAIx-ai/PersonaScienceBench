"""
TASK008 (bix-29-q2): Independent effect of each additional ongoing medical
condition (MHONGO) on the odds of higher COVID-19 severity, controlling for
BCG vaccination status (TRTGRP) and patient interaction variables
(patients_seen, expect_interact), via an ordinal (proportional-odds) regression.
Answer expressed as percentage (0-100%) increase in odds per additional condition.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = "data"
dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")

# ---------------- Outcome: max AESEV per subject over AEPT=='COVID-19' rows ----
cov = ae[ae["AEPT"] == "COVID-19"]
outcome = cov.groupby("USUBJID")["AESEV"].max()
outcome = outcome.dropna().astype(int)          # 1=mild 2=mod 3=severe 4=very severe
df = outcome.rename("sev").to_frame()

# ---------------- Predictor of interest: count of ongoing conditions (MHONGO) --
mhongo = mh[mh["MHONGO"] == "Yes"].groupby("USUBJID").size().rename("mhongo_count")
df["mhongo_count"] = mhongo.reindex(df.index, fill_value=0)

# ---------------- Covariates from DM -------------------------------------------
d = dm.set_index("USUBJID").loc[df.index]
df["trtgrp_bcg"] = (d["TRTGRP"] == "BCG").astype(int)
df["ps_51_100"]  = (d["patients_seen"] == "51-100").astype(int)
df["ps_gt100"]   = (d["patients_seen"] == ">100").astype(int)
df["expect_yes"] = (d["expect_interact"] == "Yes").astype(int)

print(f"Analysis sample: n = {len(df)} subjects")
print("Outcome (max AESEV) distribution:", df["sev"].value_counts().sort_index().to_dict())
print("MHONGO count distribution:", df["mhongo_count"].value_counts().sort_index().to_dict())
print("TRTGRP:", df["trtgrp_bcg"].value_counts().to_dict())

X = df[["mhongo_count", "trtgrp_bcg", "ps_51_100", "ps_gt100", "expect_yes"]]

def fit_and_report(y, label):
    Xd = X.copy()
    Xd["sev"] = y
    m = OrderedModel(Xd["sev"], Xd.drop(columns="sev"), distr="logit")
    res = m.fit(method="newton", disp=1)
    print(f"\n===== {label} =====")
    print(f"converged: {res.mle_retvals['converged'] if hasattr(res.mle_retvals,'converged') else res.mle_retvals}, "
          f"LLF={res.llf:.2f}, LLF={res.llf:.2f}, AIC={res.aic:.1f}")
    print(res.summary())
    b = res.params["mhongo_count"]
    se = res.bse["mhongo_count"]
    z = res.tvalues["mhongo_count"]
    orr = np.exp(b)
    lo, hi = np.exp(res.conf_int().loc["mhongo_count"])
    print(f"\nMHONGO per-unit: beta={b:.4f} (SE={se:.4f}, z={z:.3f})")
    print(f"Odds ratio per additional condition = {orr:.4f}  95% CI [{lo:.4f}, {hi:.4f}]")
    print(f"Percentage increase in odds of higher severity = {(orr-1)*100:.2f}%  "
          f"95% CI [ {(lo-1)*100:.2f}%, {(hi-1)*100:.2f}% ]")
    return res, orr, lo, hi

# ---- Primary: 4-level ordinal outcome -----------------------------------------
res4, orr4, lo4, hi4 = fit_and_report(df["sev"], "MODEL 1: 4-level ordinal (1,2,3,4)")

# ---- Fallback check: 3-level collapse (1, 2, 3+4) if primary misfits ----------
if res4.mle_retvals["converged"] and abs(res4.llf) < 1e6:
    print("\nPrimary model converged; 3-level fallback also fitted for sensitivity:")
else:
    print("\nPrimary model convergence shaky -> 3-level collapse as primary:")

sev3 = df["sev"].clip(upper=3)
res3, orr3, lo3, hi3 = fit_and_report(sev3, "MODEL 2 (sensitivity): 3-level ordinal (1, 2, 3+4)")

print("\n================ FINAL ANSWER ================")
use = res4 if (res4.mle_retvals["converged"]) else res3
label = "4-level" if use is res4 else "3-level"
o, lo, hi = (orr4, lo4, hi4) if use is res4 else (orr3, lo3, hi3)
print(f"Model used: {label} proportional-odds ordinal regression, n={len(df)}")
print(f"Each additional ongoing medical condition (MHONGO) multiplies the odds of higher "
      f"COVID-19 severity by {o:.4f} (95% CI {lo:.4f}-{hi:.4f}), i.e. a "
      f"{(o-1)*100:.2f}% increase in odds, controlling for BCG vaccination status "
      f"(TRTGRP) and patient interaction variables (patients_seen, expect_interact).")
