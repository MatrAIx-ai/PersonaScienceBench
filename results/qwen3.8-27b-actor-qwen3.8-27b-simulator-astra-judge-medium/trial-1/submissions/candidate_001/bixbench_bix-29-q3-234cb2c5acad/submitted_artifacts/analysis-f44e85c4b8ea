#!/usr/bin/env python3
"""
BCG x prior-medical-history interaction on COVID-19 severity
============================================================
Ordinal (proportional-odds, cumulative-logit) logistic regression.
Question: interaction effect of BCG vaccination status and prior medical
history on COVID-19 severity, as the odds ratio in an ordinal regression
model controlling for patient interaction frequency.

Locked decisions (researcher-approved):
  * Population      : infected-only (>=1 'COVID-19' AE) with a non-missing AESEV.
  * Severity (dep.) : MAX(AESEV) across a subject's 'COVID-19' AE records (1-4).
  * BCG             : DM.TRTGRP  (BCG=1, Placebo=0).
  * MH (prior med.  : subject flag = 1 if ANY of the 18 standard comorbidity
    history)         questions has MHORRES==2  (free-text 'Other' = sensitivity only).
  * Control         : DM.patients_seen coded ordinal 1/2/3 (patient interaction frequency).
  * Model           : statsmodels OrderedModel, distr='logit' (proportional odds).
  * Answer          : OR = exp(coef of BCG:MH), 95% CI, Wald p.
  * PO assumption   : Brant score test (primary) + LRT vs non-PO model (cross-check).

statsmodels parameterization:  logit[P(Y<=k)] = a_k - X'beta.
Standard (Agresti) ordinal OR for a one-unit increase in X_j = exp(beta_j),
interpreted as the odds of being in a HIGHER (more severe) category.
"""
import numpy as np, pandas as pd
from scipy.special import expit
from scipy.optimize import minimize
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel

BASE = "data/TASK008_BCG-CORONA_"
dm = pd.read_csv(BASE+"DM.csv"); ae = pd.read_csv(BASE+"AE.csv"); mh = pd.read_csv(BASE+"MH.csv")

# ---------------- 1. Subject-level variables ----------------
bcg = dm.set_index("USUBJID").copy()
bcg["BCG"] = (bcg["TRTGRP"] == "BCG").astype(int)
bcg["patients_seen"] = bcg["patients_seen"].map({"1-50":1, "51-100":2, ">100":3})

mhh = mh[mh["MHSCAT"] == "MEDICAL HISTORY"].copy()
std_terms = [t for t in mhh["MHTERM"].dropna().unique() if not str(t).startswith("Other:")]
mhh["is_std"] = mhh["MHTERM"].isin(std_terms)
mhh["yes"] = (mhh["MHORRES"] == 2).astype(int)
bcg["MH"]     = mhh[mhh["is_std"]].groupby("USUBJID")["yes"].max().reindex(bcg.index).fillna(0).astype(int)
bcg["MH_any"] = mhh.groupby("USUBJID")["yes"].max().reindex(bcg.index).fillna(0).astype(int)  # sensitivity

c19 = ae[ae["AEPT"] == "COVID-19"]
inf = c19.groupby("USUBJID").agg(sev_max=("AESEV","max"), n_c19=("AEPT","size"))
bcg = bcg.join(inf)

pop = bcg[(bcg["n_c19"].fillna(0) > 0) & bcg["sev_max"].notna()].copy()
pop["severity"] = pop["sev_max"].astype(int)
N = len(pop)
y_all = pop["severity"].values.astype(float)

def make_X(df):
    return np.column_stack([df["BCG"], df["MH"], df["BCG"]*df["MH"], df["patients_seen"]]).astype(float)
NAMES = ["BCG", "MH", "BCG:MH", "patients_seen"]

# ---------------- 2. Report population & cells ----------------
print("="*70)
print("ANALYSIS: BCG x prior-medical-history interaction on COVID-19 severity")
print("="*70)
print(f"Final N (infected, valid AESEV) = {N}")
print("Severity distribution:\n", pop["severity"].value_counts().sort_index().to_string())
print("BCG:", dict(pop["BCG"].value_counts()), " MH(18-std):", dict(pop["MH"].value_counts()),
      " patients_seen:", dict(pop["patients_seen"].value_counts()))
print("4-way cells (BCG x MH x patients_seen):")
print(pd.crosstab([pop["BCG"], pop["MH"]], pop["patients_seen"]).to_string())

# ---------------- 3. Primary proportional-odds model ----------------
X = make_X(pop); y = y_all
res = OrderedModel(y, X, distr="logit").fit(method="bfgs", maxiter=10000, disp=False)
beta = res.params[:4]; ci = res.conf_int()

print("\n" + "="*70)
print("PRIMARY MODEL: ordinal logistic (proportional odds), logit link")
print("  logit[P(Y<=k)] = a_k - [b1*BCG + b2*MH + b3*BCG:MH + b4*patients_seen]")
print("  OR reported = exp(coef) = odds of a HIGHER severity category per unit X")
print("="*70)
hdr = f"{'term':>14} {'coef':>9} {'SE':>8} {'z':>8} {'p':>8} {'OR':>7} {'95% CI (OR)':>16}"
print(hdr); print("-"*len(hdr))
for k in range(4):
    b = beta[k]; se = res.bse[k]; z = b/se; p = 2*stats.norm.sf(abs(z))
    lo, hi = ci[k]
    print(f"{NAMES[k]:>14} {b:+9.4f} {se:8.4f} {z:+8.3f} {p:8.4f} {np.exp(b):7.3f} "
          f"[{np.exp(lo):7.3f},{np.exp(hi):7.3f}]")
i3 = 2
OR_int = np.exp(beta[i3]); lo_i, hi_i = ci[i3]
print(f"\n>>> INTERACTION (BCG:MH) odds ratio = {OR_int:.3f}  "
      f"95% CI [{np.exp(lo_i):.3f}, {np.exp(hi_i):.3f}]  Wald p = {2*stats.norm.sf(abs(beta[i3]/res.bse[i3])):.3f}")
print("    (reciprocal 1/OR = %.3f is the OR on the 'lower-or-equal severity' scale)" % (1/OR_int))
# empirical BCG ORs at each MH level (odds of top category Y=4)
def odds_top(BCG, MH, ps):
    P = res.predict(np.array([[BCG, MH, BCG*MH, ps]], dtype=float)); return P[0,3]/(1-P[0,3])
o = {(b,m): odds_top(b,m,1) for b in (0,1) for m in (0,1)}
print(f"    Check (odds of Y=4): BCG OR no-MH = {o[(1,0)]/o[(0,0)]:.3f}, "
      f"BCG OR with-MH = {o[(1,1)]/o[(0,1)]:.3f} -> interaction = {(o[(1,1)]/o[(0,1)])/(o[(1,0)]/o[(0,0)]):.3f}")

# ---------------- 4. Proportional-odds assumption ----------------
t1 = res.params[4]; a1 = t1; a2 = a1+np.exp(res.params[5]); a3 = a2+np.exp(res.params[6])
A = np.concatenate([[-np.inf], [a1,a2,a3], [np.inf]])
def ll_PO(b):
    ll = 0.0
    for i in range(len(y)):
        k = int(y[i]); ll += np.log((expit(A[k]-X[i]@b) - expit(A[k-1]-X[i]@b)) + 1e-300)
    return ll
def ll_PO_sub(b, Xg, yg):
    ll = 0.0
    for i in range(len(yg)):
        k = int(yg[i]); ll += np.log((expit(A[k]-Xg[i]@b) - expit(A[k-1]-Xg[i]@b)) + 1e-300)
    return ll
h = 1e-5
def hess(b, Xg, yg):
    J = np.zeros((4,4))
    for i in range(4):
        for j in range(4):
            bp=b.copy();bm=b.copy();bq=b.copy();br=b.copy()
            bp[i]+=h;bp[j]+=h; bm[i]+=h;bm[j]-=h; bq[i]-=h;bq[j]+=h; br[i]-=h;br[j]-=h
            d2 = (ll_PO_sub(bp,Xg,yg)-ll_PO_sub(bm,Xg,yg)-ll_PO_sub(bq,Xg,yg)+ll_PO_sub(br,Xg,yg))/(4*h*h)
            J[i,j] = -d2
    return J
J = hess(beta, X, y); n = len(y); T = 0.0
for g in (1,2,3,4):
    idx = y==g; Jg = hess(beta, X[idx], y[idx]); D = Jg - (idx.sum()/n)*J
    T += float(np.sum(D @ np.linalg.inv(J) @ D))
p_brant = float(stats.chi2.sf(T, 12))

# LRT cross-check: fit fully general (non-PO) model  P(Y<=k)=expit(a_k - X'beta_k)
def ll_general(th):
    Bs = [th[0:4], th[4:8], th[8:12]]; As = [th[12], th[13], th[14]]
    def cum(c, i):
        if c == 0: return 0.0
        if c == 4: return 1.0
        return expit(As[c-1] - X[i]@Bs[c-1])
    ll = 0.0
    for i in range(len(y)):
        k = int(y[i]); ll += np.log(max(cum(k,i)-cum(k-1,i), 1e-300))
    return ll
th0 = np.concatenate([beta, beta, beta, [a1,a2,a3]])
rg = minimize(lambda th: -ll_general(th), th0, method="L-BFGS-B", options={"maxiter":8000})
ll_gen = -rg.fun; lrt = -2*(float(res.llf) - ll_gen); p_lrt = float(stats.chi2.sf(lrt, 8))
h = 1e-4; Hg = np.zeros((15,15))
for i in range(15):
    for j in range(15):
        tp=rg.x.copy();tm=rg.x.copy();tq=rg.x.copy();tr=rg.x.copy()
        tp[i]+=h;tp[j]+=h; tm[i]+=h;tm[j]-=h; tq[i]-=h;tq[j]+=h; tr[i]-=h;tr[j]-=h
        Hg[i,j] = -(ll_general(tp)-ll_general(tm)-ll_general(tq)+ll_general(tr))/(4*h*h)
ev = np.linalg.eigvalsh(Hg); cond = ev.max()/max(ev.min(),1e-12)

print("\n" + "="*70)
print("PROPORTIONAL-ODDS (PARALLEL-LINES) ASSUMPTION")
print("="*70)
print(f"  Brant score test : T = {T:.3f}, df = 12, p = {p_brant:.3f}   ->  "
      f"{'holds' if p_brant>0.05 else 'VIOLATED'}")
print(f"  LRT (PO vs non-PO): stat = {lrt:.3f}, df = 8, p = {p_lrt:.3f}   [cross-check]")
print(f"  Non-PO model Hessian: min eig = {ev.min():.3e}, condition # = {cond:.1e}"
      f"   -> {'NEAR-SINGULAR (LRT unreliable)' if ev.min()<0.5 else 'well-conditioned'}")

# ---------------- 5. Sensitivity: MH incl. free-text 'Other' ----------------
pop2 = pop.copy(); pop2["MH"] = pop2["MH_any"]
X2 = make_X(pop2)
res2 = OrderedModel(y, X2, distr="logit").fit(method="bfgs", maxiter=10000, disp=False)
b2 = res2.params[2]; se2 = res2.bse[2]; ci2 = res2.conf_int()[2]
print("\n" + "="*70)
print("SENSITIVITY: MH flag includes free-text 'Other' conditions")
print("="*70)
print(f"  N = {len(pop2)}  (MH_any=1: {int(pop2['MH'].sum())})")
print(f"  Interaction OR = {np.exp(b2):.3f}  95% CI [{np.exp(ci2[0]):.3f},{np.exp(ci2[1]):.3f}]  "
      f"Wald p = {2*stats.norm.sf(abs(b2/se2)):.3f}")

print("\n" + "="*70)
print("BOTTOM LINE")
print("="*70)
print(f"  Interaction OR (BCG x prior-mh) = {OR_int:.2f} (95% CI {np.exp(lo_i):.2f}-{np.exp(hi_i):.2f}, p={2*stats.norm.sf(abs(beta[i3]/res.bse[i3])):.2f}).")
print(f"  BCG OR higher-severity: no-MH={np.exp(beta[0]):.2f}, with-MH={np.exp(beta[0]+beta[2]):.2f}.")
print(f"  N={N}; PO assumption: Brant p={p_brant:.2f} (holds); LRT p={p_lrt:.3f} (non-PO model near-singular).")
