#!/usr/bin/env python3
"""
DESeq2-style differential expression analysis for Paroxetine 2017 RNA-seq data.
Question: How many genes are DE across 3 tissue comparisons?
  1. final_blood vs baseline_blood
  2. dentate_gyrus vs baseline_blood
  3. dentate_gyrus vs final_blood

WHY WE ROUND TO INTEGERS:
  The NormCount values are DESeq2-normalized counts (floats). DESeq2
  requires raw integer counts. We round to nearest integer to create
  pseudo-counts. DESeq2 re-estimates size factors, effectively undoing
  and re-doing the normalization. Standard workaround when only
  normalized counts are available. With 30 replicates/group, rounding
  introduces negligible distortion.
"""
import numpy as np
import pandas as pd
from scipy import stats, special
from scipy.interpolate import UnivariateSpline
import openpyxl, warnings, time
warnings.filterwarnings('ignore')

print("="*60); print("1. LOADING DATA"); print("="*60)
t0=time.time()
wb=openpyxl.load_workbook('data/Data_deposition_RNAseq_Paroxetine_2017.xlsx',read_only=True)
ws=wb['NormCount']
headers=[c.value for c in next(ws.iter_rows(min_row=4,max_row=4))]
sample_names=headers[2:92]
gene_names=[];data=[];precomputed={}
for row in ws.iter_rows(min_row=5):
    g=row[1].value
    if g is None: continue
    gene_names.append(g)
    data.append([c.value for c in row[2:92]])
    precomputed[g]={f'c{k}_l2fc':row[102+(k-1)*9].value for k in range(1,10)}
wb.close()
counts_float=np.array(data,dtype=float)
gene_names=np.array(gene_names)
n_genes,n_samples=counts_float.shape
print(f"  Genes:{n_genes} Samples:{n_samples} Range:[{counts_float.min():.2f},{counts_float.max():.2f}]")
print(f"  Non-int fraction:{np.mean(counts_float!=np.round(counts_float)):.4f} Load:{time.time()-t0:.1f}s")

# Round to integers (see docstring)
int_counts=np.round(counts_float)
print(f"\n2. Rounded to integers. Range:[{int_counts.min():.0f},{int_counts.max():.0f}]")

# Design matrix
tissue=np.repeat(['baseline_blood','dentate_gyrus','final_blood'],30)
X=np.column_stack([np.ones(n_samples),(tissue=='dentate_gyrus').astype(float),(tissue=='final_blood').astype(float)])
print(f"\n3. Design:{X.shape} Tissue:{dict(zip(*np.unique(tissue,return_counts=True)))}")

# Size factors (median of ratios)
def est_sf(counts):
    cs=counts+1e-10
    gm=np.exp(np.mean(np.log(cs),axis=1))
    sf=np.median(cs/gm[:,None],axis=0)
    sf[sf==0]=1.0
    return sf
sf=est_sf(int_counts)
offset=np.log(sf)
norm_counts=int_counts/sf[None,:]
print(f"\n4. Size factors: min={sf.min():.4f} max={sf.max():.4f} med={np.median(sf):.4f}")

# Dispersion estimation
base_means=np.mean(norm_counts,axis=1)
variances=np.var(norm_counts,axis=1)
phi_mm=np.maximum((variances-base_means)/(base_means**2+1e-10),1e-6)
valid=base_means>0.5
if np.sum(valid)>20:
    log_bm=np.log(base_means[valid]);log_phi=np.log(phi_mm[valid])
    try:
        sp=UnivariateSpline(log_bm,log_phi,s=0.05*len(log_bm),k=3)
        lpt=np.clip(sp(np.log(base_means+1e-10)),np.min(log_phi)-1,np.max(log_phi)+1)
    except: lpt=np.full(n_genes,np.median(log_phi))
else: lpt=np.full(n_genes,np.median(np.log(phi_mm)))
phi_trend=np.exp(lpt)
log_bm_all=np.log(base_means+1e-10)
med_lbm=np.median(log_bm_all[valid])
w=1.0/(1.0+np.exp(-4.0*(log_bm_all-med_lbm)))
phi_shrunk=np.exp(w*np.log(phi_mm)+(1.0-w)*np.log(phi_trend))
print(f"\n5. Dispersion: gene-wise med={np.median(phi_mm):.6f} trended med={np.median(phi_trend):.6f} shrunk med={np.median(phi_shrunk):.6f}")

# NB GLM fitting via IRLS
def fit_nb_glm(y,X,offset,phi):
    p=X.shape[1]
    beta=np.zeros(p); beta[0]=np.log(np.mean(y)+1e-10)
    conv=False
    for it in range(200):
        eta=X@beta+offset
        mu=np.exp(np.clip(eta,-30,30))
        W=1.0/(mu+phi*mu**2)
        z=eta+(y-mu)/mu
        XTWX=X.T@(W[:,None]*X)+1e-6*np.eye(p)
        XTWz=X.T@(W*z)
        try: bn=np.linalg.solve(XTWX,XTWz)
        except: bn=np.linalg.lstsq(XTWX,XTWz,rcond=None)[0]
        # Clip beta to prevent extreme values from zero-inflated genes
        bn=np.clip(bn,-15,15)
        if np.max(np.abs(bn-beta))<1e-6:
            beta=bn;conv=True;break
        beta=bn
    eta=X@beta+offset;mu=np.exp(np.clip(eta,-30,30))
    W=1.0/(mu+phi*mu**2)
    XTWX=X.T@(W[:,None]*X)
    try:
        cov=np.linalg.inv(XTWX)
        d=np.diag(cov)
        if np.any(d<0): cov=np.diag(np.maximum(d,1e-10))
    except: cov=np.full((p,p),np.nan)
    return beta,cov,conv

print("\n6. FITTING NB GLM (IRLS)")
betas=np.zeros((n_genes,3));covs=np.zeros((n_genes,3,3))
n_conv=0;n_zero=0;n_fb=0
t0=time.time()
for i in range(n_genes):
    y=int_counts[i]
    if np.sum(y)==0:
        n_zero+=1;covs[i]=np.nan;continue
    beta,cov,conv=fit_nb_glm(y,X,offset,phi_shrunk[i])
    if not np.all(np.isfinite(beta)):
        b2,c2,cv2=fit_nb_glm(y,X,offset,phi_trend[i])
        if np.all(np.isfinite(b2)):
            beta,cov,conv=b2,c2,cv2;n_fb+=1
        else: covs[i]=np.nan;continue
    betas[i]=beta;covs[i]=cov
    if not conv: n_conv+=1
print(f"   Fitted {n_genes} genes in {time.time()-t0:.1f}s")
print(f"   Zero-expr:{n_zero} Conv-issues:{n_conv} Fallback:{n_fb}")

# Wald test
print("\n7. WALD TEST")
contrasts={
    'final_blood_vs_baseline_blood':np.array([0.,0.,1.]),
    'dentate_gyrus_vs_baseline_blood':np.array([0.,1.,0.]),
    'dentate_gyrus_vs_final_blood':np.array([0.,1.,-1.])
}
def bh(pv):
    n=len(pv);r=np.argsort(pv);rp=pv[r]
    a=np.minimum.accumulate((rp*n/(np.arange(1,n+1)))[::-1])[::-1]
    a=np.minimum(a,1.0);res=np.empty(n);res[r]=a;return res

de_results={}
for name,c in contrasts.items():
    l2fc=np.array([betas[i]@c for i in range(n_genes)])
    vc=np.array([c@covs[i]@c for i in range(n_genes)])
    sc=np.sqrt(np.maximum(vc,0))
    with np.errstate(divide='ignore',invalid='ignore'):
        W=l2fc/sc
    pv=2.0*(1.0-stats.norm.cdf(np.abs(W)))
    pv=np.nan_to_num(pv,nan=1.0,posinf=0.0)
    padj=bh(pv)
    de_results[name]={'log2fc':l2fc,'se':sc,'W':W,'pval':pv,'padj':padj}
    print(f"   {name}: {np.sum(padj<0.05)} DE (padj<0.05), {np.sum(padj<0.10)} (padj<0.10)")

# Summary
print("\n"+"="*60);print("8. SUMMARY");print("="*60)
de_sets={}
for name,res in de_results.items():
    de_sets[name]=set(np.where(res['padj']<0.05)[0])
union=set().union(*de_sets.values())
intersection=set.intersection(*de_sets.values())
for name,s in de_sets.items():
    print(f"  {name}: {len(s)} DE genes")
print(f"\n  UNION (DE in >=1 comparison):      {len(union)} genes")
print(f"  INTERSECTION (DE in all 3):        {len(intersection)} genes")
names=list(de_sets.keys())
for i in range(len(names)):
    for j in range(i+1,len(names)):
        ov=de_sets[names[i]]&de_sets[names[j]]
        print(f"  {names[i]} ∩ {names[j]}: {len(ov)}")

# Save results
print("\n9. SAVING RESULTS")
rdf=pd.DataFrame({'GeneID':gene_names})
for name,res in de_results.items():
    rdf[f'{name}_log2FC']=res['log2fc']
    rdf[f'{name}_pval']=res['pval']
    rdf[f'{name}_padj']=res['padj']
rdf.to_csv('deseq2_results.csv',index=False)
print("  Saved dese2_results.csv")

# Cross-check
# Cross-check: verify pipeline sanity
print("\n10. CROSS-CHECK / SANITY CHECKS")
print("    NOTE: The 9 pre-computed DESeq blocks in the sheet are")
print("    responder-type comparisons WITHIN each tissue (e.g.,")
print("    good_responder vs Control in baseline_blood), NOT tissue")
print("    comparisons. They cannot be directly compared to our")
print("    tissue-level pooled contrasts.")
print("    Sanity checks:")
print(f"    - Size factors: [{sf.min():.4f}, {sf.max():.4f}] (tight, expected for pre-normalized data)")
print(f"    - Dispersion median: {np.median(phi_shrunk):.4f} (reasonable for RNA-seq)")
for name in contrasts:
    l2fc=de_results[name]['log2fc']
    n_de=np.sum(de_results[name]['padj']<0.05)
    print(f"    - {name}: median l2FC={np.median(l2fc):.3f}, std={np.std(l2fc):.2f}, {n_de} DE (padj<0.05)")
print(f"    - Convergence issues: {n_conv}/{n_genes} genes ({n_conv/n_genes*100:.1f}%),")
print("      handled via beta clipping [-15,15] and ridge regularization (1e-6)")
print(f"    - Zero-expression genes (skipped): {n_zero}")
print()
print("FINAL ANSWER")
print("="*60)
print(f"""
  Genes DE across all comparisons (UNION, padj<0.05): {len(union)}
  
  Per-contrast:
    final_blood vs baseline_blood:    {len(de_sets['final_blood_vs_baseline_blood'])}
    dentate_gyrus vs baseline_blood:  {len(de_sets['dentate_gyrus_vs_baseline_blood'])}
    dentate_gyrus vs final_blood:     {len(de_sets['dentate_gyrus_vs_final_blood'])}
  
  Intersection (DE in all 3): {len(intersection)}
""")
print("="*60)
