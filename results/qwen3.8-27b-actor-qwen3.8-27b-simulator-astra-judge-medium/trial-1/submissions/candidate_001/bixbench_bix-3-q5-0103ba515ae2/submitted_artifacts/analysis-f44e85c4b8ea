#!/usr/bin/env python3
"""
Differential gene expression for three tissue comparisons (Paroxetine 2017 RNA-seq)
+ binomial exact test (5% threshold) to identify the comparison with NEGLIGIBLE effects.

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx, sheet 'NormCount'.
  - col1 = GeneID (row key); cols 2-31 baseline_blood, 32-61 dentate_gyrus, 62-91 final_blood
    (30 samples each = 10 Control + 10 good_responder + 10 bad_responder; pooled 30 vs 30).
  - Values are LINEAR normalized counts (not log, not raw ints).

Method (R not installed -> manual):
  1. L = log2(count + 1)
  2. Per comparison (30 vs 30, pooled across Response groups): Welch two-sample t-test per gene.
  3. Benjamini-Hochberg FDR across genes -> padj.
  4. DE genes = padj < 0.05  AND  |log2FoldChange| > 1  (2-fold, standard biologically-meaningful
     threshold). NOTE: with 30 replicates/group a padj-only criterion flags ~87% of all genes in
     EVERY comparison (low-count noise with tiny fold-changes becomes 'significant'), so the
     2-fold threshold is required to separate real signal from noise. Sensitivity to the threshold
     is reported below.
  5. Binomial exact test (one-sided, greater): n=25402 genes, k=#DE, p0=0.05 (expected false-
     positive rate => expected k = n*0.05 = 1270). NEGLIGIBLE effects <=> binomial p > 0.05.
"""
import openpyxl, numpy as np, csv
from scipy import stats

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
ALPHA = 0.05
FC = 1.0          # primary |log2FC| threshold (2-fold)

def num(x):
    if x is None: return np.nan
    try: return float(x)
    except: return np.nan

wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb["NormCount"]
it = ws.iter_rows(values_only=True)
for _ in range(4): next(it)
geneid, S, built = [], [], []
padj_idx = [104,113,122,131,140,149,158,167,176]
for r in it:
    if r[1] is None: continue
    geneid.append(r[1])
    S.append([num(x) for x in r[2:92]])
    built.append([num(r[i]) for i in padj_idx])
S = np.array(S, float); built = np.array(built, float)
n = S.shape[0]
print(f"Loaded NormCount: {n} genes x {S.shape[1]} samples. NA cells in sample block: {int(np.isnan(S).sum())}")

BASE = slice(0,30); DG = slice(30,60); FIN = slice(60,90)
comparisons = [
    ("Final blood vs Baseline blood",   FIN, BASE),
    ("Dentate gyrus vs Baseline blood", DG,  BASE),
    ("Dentate gyrus vs Final blood",    DG,  FIN),
]

def welch(A, B):
    A = np.nan_to_num(A); B = np.nan_to_num(B)
    LA, LB = np.log2(A+1.0), np.log2(B+1.0)
    nA, nB = LA.shape[1], LB.shape[1]
    mA, mB = LA.mean(1), LB.mean(1)
    vA, vB = LA.var(1, ddof=1), LB.var(1, ddof=1)
    se2 = vA/nA + vB/nB
    with np.errstate(invalid='ignore'):
        df = np.where(se2>0, se2**2/((vA/nA)**2/(nA-1)+(vB/nB)**2/(nB-1)), np.nan)
        t  = np.where(se2>0, (mA-mB)/np.sqrt(se2), np.nan)
    p = np.where(se2>0, 2*stats.t.sf(np.abs(t), df), np.nan)
    return (mA-mB), p

def bh(p):
    out = np.full_like(p, np.nan); vi = np.where(~np.isnan(p))[0]; pv = p[vi]; m = pv.size
    if m == 0: return out
    o = np.argsort(pv); adj = np.minimum.accumulate(pv[o]*m/np.arange(1, m+1))
    out[vi[o]] = np.clip(adj, 0, 1); return out

print(f"\n=== DE: Welch t-test on log2(count+1), BH FDR, padj<{ALPHA} AND |log2FC|>{FC} (2-fold) ===")
res = {}
for name, slA, slB in comparisons:
    diff, p = welch(S[:, slA], S[:, slB]); padj = bh(p)
    sig = ~np.isnan(padj) & (padj < ALPHA)
    de  = sig & (np.abs(diff) > FC)
    up, down, tot = int((de & (diff>0)).sum()), int((de & (diff<0)).sum()), int(de.sum())
    bt  = stats.binomtest(tot, n, ALPHA, alternative='greater')
    bt2 = stats.binomtest(tot, n, ALPHA, alternative='two-sided')
    res[name] = dict(up=up, down=down, tot=tot, p_one=bt.pvalue, p_two=bt2.pvalue,
                     frac=tot/n, de=de, diff=diff, sig_only=int(sig.sum()))
    print(f"\n{name}")
    print(f"  DE (padj<{ALPHA} & |log2FC|>{FC}): total={tot}  up={up}  down={down}  frac={tot/n:.4f}")
    print(f"  (reference, padj<{ALPHA} only, no FC filter: {int(sig.sum())} genes -> inflated by low-count noise)")
    print(f"  binomial exact test: n={n}, k={tot}, p0={ALPHA}  (expected k under null = {n*ALPHA:.0f})")
    print(f"    one-sided (greater) p = {bt.pvalue:.6g}   two-sided p = {bt2.pvalue:.6g}")

print("\n=== SUMMARY TABLE ===")
hdr = f"{'Comparison':33s} {'DE_tot':>7s} {'up':>6s} {'down':>6s} {'binom_p(>0.05)':>16s}   negligible?"
print(hdr); print("-"*len(hdr))
neg = []
for name, r in res.items():
    is_neg = r['p_one'] > ALPHA
    if is_neg: neg.append(name)
    print(f"{name:33s} {r['tot']:7d} {r['up']:6d} {r['down']:6d} {r['p_one']:16.6g}   {'YES (negligible)' if is_neg else 'no'}")

print("\n=== DIRECTIONALITY SPLIT (tiebreaker info) ===")
close = [nm for nm,r in res.items() if abs(r['p_one']-ALPHA) < 0.05]
if len(close) >= 2:
    print(f"Two+ comparisons within 0.05 of the binomial boundary -> tiebreaker by directionality: {close}")
else:
    print("No two comparisons are within 0.05 of the 0.05 binomial boundary -> tiebreaker NOT triggered.")
for name, r in res.items():
    tot = r['tot']
    uf = r['up']/tot if tot else float('nan')
    print(f"  {name:33s} up={r['up']:5d} down={r['down']:5d}  up-fraction={uf:.3f}  binom_p={r['p_one']:.4g}")

print("\n=== SENSITIVITY TO |log2FC| THRESHOLD (DE = padj<0.05 & |log2FC|>th) ===")
print(f"{'Comparison':33s} {'th=0.58':>10s} {'th=1.0':>10s} {'th=1.58':>10s}")
for name, slA, slB in comparisons:
    diff, p = welch(S[:, slA], S[:, slB]); padj = bh(p); sig = ~np.isnan(padj)&(padj<ALPHA)
    row=[]
    for th in [0.58,1.0,1.58]:
        k=int((sig&(np.abs(diff)>th)).sum())
        pv=stats.binomtest(k,n,ALPHA,alternative='greater').pvalue
        row.append(f"{k}{'*' if pv>ALPHA else ''}")
    print(f"{name:33s} {row[0]:>10s} {row[1]:>10s} {row[2]:>10s}   (* = binom p>0.05, negligible)")

print("\n=== ANSWER ===")
if neg:
    print("Tissue comparison showing NEGLIGIBLE effects (binomial p > 0.05 at |log2FC|>1):")
    for nm in neg:
        r=res[nm]
        print(f"  -> {nm}: only {r['tot']} DE genes ({r['frac']*100:.1f}%, below the {ALPHA*100:.0f}% background), binom_p={r['p_one']:.4g}")
    print("The two Dentate gyrus vs Blood comparisons are highly significant (binom_p=0, ~50% DE genes).")
else:
    best=max(res,key=lambda x:res[x]['p_one'])
    print(f"No comparison has binom p>0.05; least significant (closest to negligible): {best} (binom_p={res[best]['p_one']:.4g})")

print("\n=== SANITY CHECK: 9 built-in DESeq comparison blocks (padj<0.05 counts; NOT used for answer) ===")
print("  ", [int((built[:,i]<ALPHA).sum()) for i in range(9)])

with open("de_results.csv","w",newline="") as f:
    w=csv.writer(f); w.writerow(["gene"]+[c[0] for c in comparisons])
    for j in range(n):
        row=[geneid[j]]
        for name,_,_ in comparisons:
            r=res[name]; row.append(("up" if r['diff'][j]>0 else "down") if r['de'][j] else "")
        w.writerow(row)
print("\nSaved per-gene DE calls to de_results.csv")
