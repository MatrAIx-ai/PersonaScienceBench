#!/usr/bin/env python3
"""
BixBench bix-30-q1
Q: What percentage of miRNAs show significant differential expression between
   patient and control groups before multiple testing correction?

Locked-in method (approved):
  - Per-miRNA Welch two-sample t-test on RAW Ct values, two-sided.
  - Significant if unadjusted p < 0.05 (NO FDR/Bonferroni).
  - Pairwise deletion of the 22 'NAN' (missing) cells.
  - Denominator = 175 miRNAs.
  - Mann-Whitney U reported as a sensitivity check only.

Self-contained: parses the legacy .xls (OLE2/BIFF) with no external xls libs.
Only third-party deps: numpy, scipy (both provisioned).
"""
import struct
import numpy as np
from scipy import stats

XLS = "data/pone.0150501.s002.xls"
ALPHA = 0.05

# ---------------------------------------------------------------------------
# 1) Minimal OLE2 (compound document) reader -> extract the 'Workbook' stream
# ---------------------------------------------------------------------------
def read_ole2_workbook(path):
    d = open(path, "rb").read()
    assert d[:8] == bytes.fromhex("d0cf11e0a1b11ae1"), "not an OLE2 .xls"
    SS = 1 << struct.unpack_from("<H", d, 30)[0]
    MS = 1 << struct.unpack_from("<H", d, 32)[0]
    first_dir     = struct.unpack_from("<i", d, 48)[0]
    mincut        = struct.unpack_from("<I", d, 56)[0]
    first_minifat = struct.unpack_from("<i", d, 60)[0]
    difat = [x for x in struct.unpack_from("<109i", d, 76) if x >= 0]
    sec = struct.unpack_from("<i", d, 68)[0]
    while sec >= 0:
        off = 512 + sec * SS
        ent = struct.unpack_from("<%di" % (SS // 4), d, off)
        difat.extend(x for x in ent[:-1] if x >= 0)
        sec = ent[-1]
    def so(s): return 512 + s * SS
    fat = []
    for s in difat:
        fat.extend(struct.unpack_from("<%di" % (SS // 4), d, so(s)))
    def chain(start):
        out, s, g = [], start, 0
        while s >= 0 and s < len(fat) and g < 200000:
            out.append(s); s = fat[s]; g += 1
        return out
    def read_stream(start, size):
        out = b""
        for s in chain(start):
            out += d[so(s):so(s) + SS]
        return out[:size]
    dirb = b"".join(d[so(s):so(s)+SS] for s in chain(first_dir))
    entries = []
    for i in range(len(dirb) // 128):
        e = dirb[i*128:(i+1)*128]
        nlen = struct.unpack_from("<H", e, 64)[0]
        name = e[:max(0, nlen-2)].decode("utf-16le", "replace")
        otype = e[66]
        entries.append((name, otype, e))
    root = next(e for e in entries if e[1] == 5)
    # This file (Mac-Excel CFB) places start-sector@116 / size@120; try both
    # offset layouts and keep the one whose 'Workbook' begins with a BIFF BOF.
    def pick(e):
        for off in (116, 108):
            start = struct.unpack_from("<i", e, off)[0]
            size  = struct.unpack_from("<I", e, off+4)[0]
            if 0 < size < len(d):
                st = read_stream(start, size)
                if st[:2] == b"\x09\x08":   # BIFF8 BOF record type 0x0809
                    return st
        return None
    wb = None
    for name, otype, e in entries:
        if name == "Workbook" and otype == 2:
            wb = pick(e)
    assert wb is not None, "could not locate a valid BIFF Workbook stream"
    return wb

# ---------------------------------------------------------------------------
# 2) Minimal BIFF8 parser -> per-sheet cell grid {(row,col): value}
# ---------------------------------------------------------------------------
def _decode_rk(rk):
    fX100, fInt = rk & 0x02, rk & 0x04
    if fInt:
        v = (rk & 0xFFFC) >> 2
        if v & 0x8000: v -= 0x10000
    else:
        v = struct.unpack("<d", struct.pack("<II", rk & 0xFFFFFFFF, 0))[0]
    return v / 100.0 if fX100 else v

def parse_biff_grid(wb):
    pos, n = 0, len(wb)
    sst, grid = [], {}
    while pos + 4 <= n:
        rt, ln = struct.unpack_from("<HH", wb, pos)
        body = wb[pos+4:pos+4+ln]
        pos += 4 + ln
        if rt == 0x00FC:                                  # SST
            _, uniq = struct.unpack_from("<II", body, 0)
            p = 8
            for _ in range(uniq):
                cn = struct.unpack_from("<H", body, p)[0]; p += 2
                opts = body[p]; p += 1
                if opts & 0x08: p += 2
                if opts & 0x04: p += 2
                if opts & 0x01:
                    sst.append(body[p:p+cn*2].decode("utf-16le","replace")); p += cn*2
                else:
                    sst.append(body[p:p+cn].decode("latin1","replace")); p += cn
        elif rt == 0x0203:                                # NUMBER
            r,c,_ = struct.unpack_from("<HHH", body, 0)
            grid[(r,c)] = struct.unpack_from("<d", body, 6)[0]
        elif rt == 0x00FD:                                # LABELSST
            r,c,_ = struct.unpack_from("<HHH", body, 0)
            idx = struct.unpack_from("<I", body, 6)[0]
            grid[(r,c)] = sst[idx] if idx < len(sst) else None
        elif rt == 0x027E:                                # RK
            r,c,_ = struct.unpack_from("<HHH", body, 0)
            grid[(r,c)] = _decode_rk(struct.unpack_from("<I", body, 6)[0])
        elif rt == 0x00BD:                                # MULRK
            r, cfirst = struct.unpack_from("<HH", body, 0)
            p, ncols = 4, (ln - 6) // 6
            for k in range(ncols):
                p += 2
                grid[(r, cfirst+k)] = _decode_rk(struct.unpack_from("<I", body, p)[0]); p += 4
        elif rt == 0x0204:                                # LABEL (BIFF5/7 text)
            r,c,_ = struct.unpack_from("<HHH", body, 0)
            cn = struct.unpack_from("<H", body, 6)[0]; opts = body[8]
            if opts & 1: grid[(r,c)] = body[9:9+cn*2].decode("utf-16le","replace")
            else:        grid[(r,c)] = body[9:9+cn].decode("latin1","replace")
    return grid

# ---------------------------------------------------------------------------
# 3) Build the miRNA x sample matrix with group labels
# ---------------------------------------------------------------------------
def build_matrix(grid):
    rows = sorted({r for r, c in grid}); cols = sorted({c for r, c in grid})
    g = lambda r, c: grid.get((r, c))
    maxr, maxc = max(rows), max(cols)
    # header row = the row where most of cols 1..maxc look like P_#/C_#
    def is_sample(x):
        return isinstance(x, str) and len(x) >= 3 and x[0] in "PC" and x[1] == "_" and x[2:].isdigit()
    hdr = max(range(maxr+1), key=lambda r: sum(1 for c in range(1, maxc+1) if is_sample(g(r, c))))
    samples = [g(hdr, c) for c in range(1, maxc+1)]
    group = {s: ("patient" if s.startswith("P_") else "control") for s in samples}
    mirna_rows = [r for r in range(maxr+1)
                  if isinstance(g(r, 0), str) and g(r, 0).startswith("hsa-")]
    return g, hdr, samples, group, mirna_rows

# ---------------------------------------------------------------------------
# 4) Per-miRNA Welch t-test (raw Ct, pairwise deletion) + Mann-Whitney
# ---------------------------------------------------------------------------
def analyze():
    grid = parse_biff_grid(read_ole2_workbook(XLS))
    g, hdr, samples, group, mirna_rows = build_matrix(grid)
    P_cols = [c for c in range(1, len(samples)+1) if group[samples[c-1]] == "patient"]
    C_cols = [c for c in range(1, len(samples)+1) if group[samples[c-1]] == "control"]

    n_mirna = len(mirna_rows)
    res = []
    degenerate = []
    for r in mirna_rows:
        name = g(r, 0)
        pv = [g(r, c) for c in P_cols if isinstance(g(r, c), (int, float))]
        cv = [g(r, c) for c in C_cols if isinstance(g(r, c), (int, float))]
        npat, nctl = len(pv), len(cv)
        note = ""
        # --- Welch two-sample t-test (two-sided) ---
        if npat < 2 or nctl < 2:
            t_stat, pval = float("nan"), float("nan")
            note = f"degenerate: n_pat={npat}, n_ctl={nctl} (t-test undefined -> treated as NOT significant)"
            degenerate.append((name, note))
        else:
            try:
                t_stat, pval = stats.ttest_ind(pv, cv, equal_var=False)
                if np.isnan(pval):
                    note = "degenerate: t-test returned NaN (e.g. zero variance) -> NOT significant"
                    degenerate.append((name, note))
            except Exception as ex:
                t_stat, pval = float("nan"), float("nan")
                note = f"degenerate: t-test error {ex} -> NOT significant"
                degenerate.append((name, note))
        # --- Mann-Whitney U (sensitivity) ---
        try:
            if npat < 2 or nctl < 2:
                mw_p = float("nan")
            else:
                mw_p = stats.mannwhitneyu(pv, cv, alternative="two-sided").pvalue
        except Exception:
            mw_p = float("nan")
        res.append(dict(mirna=name, npat=npat, nctl=nctl,
                        t=t_stat, p=pval, mw_p=mw_p, note=note))

    sig = [x for x in res if (not np.isnan(x["p"])) and x["p"] < ALPHA]
    sig_mw = [x for x in res if (not np.isnan(x["mw_p"])) and x["mw_p"] < ALPHA]
    pct = 100.0 * len(sig) / n_mirna
    pct_mw = 100.0 * len(sig_mw) / n_mirna
    return dict(n_mirna=n_mirna, n_pat=len(P_cols), n_ctl=len(C_cols),
                samples=samples, res=res, n_sig=len(sig), pct=pct,
                n_sig_mw=len(sig_mw), pct_mw=pct_mw, degenerate=degenerate,
                sig_list=[x["mirna"] for x in sig])

if __name__ == "__main__":
    a = analyze()
    print("=" * 70)
    print("INPUT:", XLS)
    print("Samples (n={}): {}  -> patient={} control={}".format(
        len(a["samples"]), a["samples"], a["n_pat"], a["n_ctl"]))
    print("miRNA rows:", a["n_mirna"])
    print("-" * 70)
    print("HEADLINE (Welch two-sample t-test, raw Ct, two-sided, p<0.05, uncorrected):")
    print("  significant / total = {} / {}".format(a["n_sig"], a["n_mirna"]))
    print("  PERCENTAGE = {:.2f}%".format(a["pct"]))
    print("-" * 70)
    print("SENSITIVITY (Mann-Whitney U, two-sided, p<0.05):")
    print("  significant / total = {} / {}  ->  {:.2f}%".format(
        a["n_sig_mw"], a["n_mirna"], a["pct_mw"]))
    print("-" * 70)
    print("Degenerate cases after pairwise deletion:", len(a["degenerate"]))
    for name, note in a["degenerate"]:
        print("   -", name, ":", note)
    print("-" * 70)
    # show a few smallest p-values as evidence
    valid = sorted([x for x in a["res"] if not np.isnan(x["p"])], key=lambda x: x["p"])
    print("Smallest 8 unadjusted t-test p-values:")
    for x in valid[:8]:
        print("   {:<16} t={:8.3f}  p={:.3e}  (nP={}, nC={})".format(
            x["mirna"], x["t"], x["p"], x["npat"], x["nctl"]))
    print("Largest 3 unadjusted t-test p-values:")
    for x in valid[-3:]:
        print("   {:<16} t={:8.3f}  p={:.3e}".format(x["mirna"], x["t"], x["p"]))
    print("-" * 70)
    print("Significant miRNAs (p<0.05):")
    print("  " + ", ".join(a["sig_list"]))
    # persist the full table
    import csv
    with open("results_table.csv", "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["miRNA", "n_patient", "n_control", "welch_t", "welch_p", "mw_p", "note"])
        for x in a["res"]:
            w.writerow([x["mirna"], x["npat"], x["nctl"],
                        "" if np.isnan(x["t"]) else round(x["t"], 4),
                        "" if np.isnan(x["p"]) else x["p"],
                        "" if np.isnan(x["mw_p"]) else x["mw_p"], x["note"]])
    print("-" * 70)
    print("Saved full per-miRNA table to results_table.csv")
