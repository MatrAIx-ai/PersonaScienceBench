"""
BixBench bix-33-q1
Q: Which immune cell type has the highest number of significantly differentially
   expressed genes after AAV9 mini-dystrophin treatment?

Method (researcher-approved):
  - Source: xlsx "Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
    (precomputed Post-vs-Pre / after-treatment-vs-before-treatment DEG tables).
  - Definition of "significantly DE": p_val_adj < 0.05 (BH/FDR), NO |avg_log2FC| cutoff.
  - Immune cell types = all sheets EXCEPT Eryth, HSPC, Platelet (non-immune).
  - Count significant genes per cell type; report the max.
"""
import openpyxl

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
NON_IMMUNE = {"Eryth", "HSPC", "Platelet"}
PADJ_CUT = 0.05

wb = openpyxl.load_workbook(XLSX, read_only=True)

rows = []
for ws in wb.worksheets:
    n_sig = 0
    n_tot = 0
    for r in ws.iter_rows(min_row=2, values_only=True):
        gene, pval, lfc, pct1, pct2, padj = r
        if gene is None:
            continue
        n_tot += 1
        if padj is not None and padj < PADJ_CUT:
            n_sig += 1
    immune = ws.title not in NON_IMMUNE
    rows.append((ws.title, immune, n_tot, n_sig))

# Sort immune cell types by significant-gene count (desc)
immune_sorted = sorted([r for r in rows if r[1]], key=lambda x: (-x[3], x[0]))

print(f"{'cell_type':<18}{'immune':<8}{'n_genes':>9}{'sig(padj<0.05)':>16}")
for name, immune, n_tot, n_sig in sorted(rows, key=lambda x: (-x[3], x[0])):
    tag = "" if immune else "  (excluded)"
    print(f"{name:<18}{str(immune):<8}{n_tot:>9}{n_sig:>16}{tag}")

print("\n=== IMMUNE cell types ranked by # significantly DE genes ===")
for name, immune, n_tot, n_sig in immune_sorted:
    print(f"{name:<18} n_sig={n_sig:>4}   (tested {n_tot})")

winner = immune_sorted[0]
print(f"\nWINNER (immune, p_val_adj<0.05, no FC cutoff): {winner[0]} with {winner[3]} significantly DE genes")

# Sensitivity caveat: with |avg_log2FC| > 0.5
print("\n=== CAVEAT: sensitivity to an |avg_log2FC| > 0.5 cutoff ===")
sens = []
for ws in wb.worksheets:
    if ws.title in NON_IMMUNE:
        continue
    c = 0
    for r in ws.iter_rows(min_row=2, values_only=True):
        gene, pval, lfc, pct1, pct2, padj = r
        if gene is None or padj is None:
            continue
        if padj < PADJ_CUT and abs(lfc) > 0.5:
            c += 1
    sens.append((ws.title, c))
sens.sort(key=lambda x: -x[1])
for name, c in sens[:5]:
    print(f"{name:<18} sig(padj<0.05 & |fc|>0.5)={c}")
