"""
Extract ENO1 base protein level in Normal samples from Proteomic_data.xlsx.
- File: data/Proteomic_data .xlsx, sheet "Tumor vs Normal"
- Filter: gene == 'ENO1' (protein P06733, gene_id 2023)
- Column: 'Normal' (aggregated protein abundance, unit unspecified — likely LFQ/iBAQ-type intensity)
- Output: value rounded to 3 significant figures
"""
import openpyxl
from decimal import Decimal

# Load workbook
wb = openpyxl.load_workbook('data/Proteomic_data .xlsx', read_only=True)
ws = wb['Tumor vs Normal']
rows = list(ws.iter_rows(values_only=True))
header = rows[0]

# Identify column indices
gene_idx = header.index('gene')
normal_idx = header.index('Normal')
protein_idx = header.index('protein')
gene_id_idx = header.index('gene_id')

# Find ENO1 row (exact match on gene)
eno1_rows = []
for i, r in enumerate(rows[1:], 1):
    if r[gene_idx] == 'ENO1':
        eno1_rows.append((i, r))

assert len(eno1_rows) == 1, f"Expected exactly 1 ENO1 row, found {len(eno1_rows)}"

row_num, row = eno1_rows[0]
protein = row[protein_idx]
gene_id = row[gene_id_idx]
normal_val = row[normal_idx]

print(f"Row: {row_num}")
print(f"Protein accession: {protein}")
print(f"Gene: {row[gene_idx]}")
print(f"Gene ID: {gene_id}")
print(f"Normal (raw): {normal_val}")

# Round to 3 significant figures
def round_to_sig_figs(value, sig_figs=3):
    if value == 0:
        return 0.0
    from math import log10, floor
    d = floor(log10(abs(value)))
    magnitude = sig_figs - 1 - d
    factor = 10 ** magnitude
    return round(value * factor) / factor

rounded_val = round_to_sig_figs(normal_val, 3)
print(f"Normal (3 sig figs): {rounded_val}")
print(f"Normal (3 sig figs, scientific): {rounded_val:.2e}")

# Assumption note
print("\n--- ASSUMPTION ---")
print("'Base protein level' is read from the 'Normal' column of the 'Tumor vs Normal' sheet.")
print("The unit is unspecified in the header (likely LFQ/iBAQ-type intensity).")
print("No unit conversion or log transformation applied; value reported as-is.")
print("Only the single ENO1 row (P06733, gene_id 2023) is used; ENO2/ENO3 excluded.")

wb.close()
