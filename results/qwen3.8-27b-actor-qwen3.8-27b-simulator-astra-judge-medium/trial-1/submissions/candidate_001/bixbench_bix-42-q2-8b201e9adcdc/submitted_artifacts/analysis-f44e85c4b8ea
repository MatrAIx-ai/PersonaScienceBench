import pandas as pd, numpy as np
from scipy import stats

df = pd.read_csv("data/COAD__geneExp.xls", sep="\t", index_col=0, low_memory=False)
mat = df.apply(pd.to_numeric, errors="coerce")
print("matrix shape:", mat.shape)

val = mat.values.astype(float).ravel()
val = val[~np.isnan(val)]

def g1(x): return float(stats.skew(x, bias=True))
def desc(x):
    return dict(n=len(x), mean=float(np.mean(x)), median=float(np.median(x)),
                min=float(np.min(x)), max=float(np.max(x)),
                p99=float(np.percentile(x,99)), p999=float(np.percentile(x,99.9)),
                zeros=int((x==0).sum()))

raw = val
logv = np.log1p(val)
gm = mat.mean(axis=1).values; gm = gm[~np.isnan(gm)]
thr = np.percentile(val, 99.9)
raw_trim = val[val <= thr]

print("\n=== RAW POOLED (primary) ==="); print(desc(raw)); print("g1 =", g1(raw))
print("\n=== LOG1P POOLED (scale fork) ==="); print(desc(logv)); print("g1 =", g1(logv))
print("\n=== PER-GENE MEAN (distribution fork) ==="); print(desc(gm)); print("g1 =", g1(gm))
print("\n=== RAW TRIMMED >P99.9 (robustness) ==="); print("thr=",thr, desc(raw_trim)); print("g1 =", g1(raw_trim))

# ---------- pure-python SVG plots ----------
def svg_hist(fname, data, title, xlabel, bins=100, logx=False):
    d = data[data > 0] if logx else data
    if logx:
        d = np.log10(d)
    lo, hi = np.min(d), np.max(d)
    edges = np.linspace(lo, hi, bins+1)
    counts, _ = np.histogram(d, bins=edges)
    counts = counts.astype(float); mx = counts.max() or 1
    W, H, m = 640, 360, 50
    bw = (W-2*m)/bins
    bars = []
    for c, e in zip(counts, edges):
        h = (H-2*m)*(c/mx)
        x = m + (e-lo)/(hi-lo)*(W-2*m)
        bars.append(f'<rect x="{x:.1f}" y="{H-m-h:.1f}" width="{bw:.1f}" height="{h:.1f}" fill="steelblue"/>')
    svg = (f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">'
           f'<rect width="{W}" height="{H}" fill="white"/>'
           f'<text x="{W/2}" y="20" text-anchor="middle" font-size="14" font-family="sans-serif">{title}</text>'
           + "".join(bars)
           + f'<text x="{W/2}" y="{H-8}" text-anchor="middle" font-size="12" font-family="sans-serif">{xlabel}</text>'
           f'<line x1="{m}" y1="{H-m}" x2="{W-m}" y2="{H-m}" stroke="black"/>'
           f'<line x1="{m}" y1="{m}" x2="{m}" y2="{H-m}" stroke="black"/></svg>')
    open(fname, "w").write(svg); print("saved", fname)

def svg_qq(fname, data, title, npts=500):
    d = np.sort(data[:min(len(data), 2_000_000)])
    q = np.quantile(d, np.linspace(0,1,npts))
    theor = stats.norm.ppf(np.linspace(0.001,0.999,npts))
    lo,hi = np.min(theor), np.max(theor)
    qlo,qhi = np.min(q), np.max(q)
    # log-scale y for readability since data is right-skewed
    qpos = np.log10(np.clip(q,1e-6,None))
    qlo,qhi = np.min(qpos), np.max(qpos)
    W,H,m = 640,360,55
    def X(v): return m + (v-lo)/(hi-lo)*(W-2*m)
    def Y(v): return H-m - (v-qlo)/(qhi-qlo)*(H-2*m)
    pts = " ".join(f"{X(t):.1f},{Y(p):.1f}" for t,p in zip(theor,qpos))
    ref = f'<line x1="{X(lo)}" y1="{Y(qlo)}" x2="{X(hi)}" y2="{Y(qhi)}" stroke="red" stroke-dasharray="5,4"/>'
    svg = (f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">'
           f'<rect width="{W}" height="{H}" fill="white"/>'
           f'<text x="{W/2}" y="20" text-anchor="middle" font-size="14" font-family="sans-serif">{title}</text>'
           f'<polyline points="{pts}" fill="none" stroke="steelblue" stroke-width="1.5"/>{ref}'
           f'<text x="{W/2}" y="{H-8}" text-anchor="middle" font-size="12" font-family="sans-serif">theoretical quantiles (normal)</text>'
           f'<text x="15" y="{H/2}" font-size="12" font-family="sans-serif" transform="rotate(-90 15 {H/2})">sample quantiles (log10)</text></svg>')
    open(fname,"w").write(svg); print("saved", fname)

svg_hist("hist_raw.svg", val, "RNA expression (raw, log10 x-axis) - 20502 genes x 328 samples", "log10(value)", logx=True)
svg_qq("qq_raw.svg", val, "Q-Q vs normal (raw pooled, log10 sample quantiles)")
svg_hist("hist_log1p.svg", logv, "log1p(expression) pooled", "log1p(value)")
svg_hist("hist_gene_mean.svg", gm, "Per-gene mean expression (log10 x)", "log10(gene mean)", logx=True)
print("\nDONE")
