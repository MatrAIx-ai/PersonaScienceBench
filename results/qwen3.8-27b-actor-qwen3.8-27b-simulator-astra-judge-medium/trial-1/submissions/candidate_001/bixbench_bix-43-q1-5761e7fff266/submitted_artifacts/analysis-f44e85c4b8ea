#!/usr/bin/env python3
"""
BixBench bix-43-q1 full pipeline (executed)
Q: CBD/cisplatin combination vs DMSO control -> GO:BP term with lowest adjusted p-value,
   using gseapy + gene set library GO_Biological_Process_2021.

Pipeline (approved plan):
  1. Load raw integer counts + layout + ENSG->symbol map.
  2. DESeq2-style DE: combination (9_1,9_2,9_3) vs DMSO (3_1,3_2,3_3)
     - median-of-ratios size-factor normalization (DESeq2)
     - log2FC = log2 ratio of group mean normalized counts (= exact NB/Poisson GLM MLE),
       with a 0.5 pseudocount to regularize zero group means
     - common negative-binomial dispersion (theta) by MLE (scipy.stats.nbinom)
     - Wald test (delta-method SE under NB) -> p; Benjamini-Hochberg FDR -> padj
  3. ENSG->symbol (drop self-mapped / missing), rank by log2FC.
  4. gseapy.enrichr(gene_list=ranked log2FC Series, gene_sets='GO_Biological_Process_2021',
                    organism='Human', mode='both') -> top GO:BP by adjusted p-value.
"""
import time
import numpy as np
import pandas as pd
from scipy import stats
from scipy.optimize import minimize_scalar
from scipy.stats import nbinom

DATA = "data"
PS = 0.5          # pseudocount for zero group means (mild LFC regularization)
t0 = time.time()

print("="*70); print("STEP 0: environment probes"); print("="*70)
gseapy = None
try:
    import gseapy as _g; gseapy = _g; print(f"[gseapy] importable, version {_g.__version__}")
except Exception as e:
    print(f"[gseapy] NOT importable: {type(e).__name__}: {e}")
enrichr_ok = False
try:
    import socket, urllib.request
    socket.setdefaulttimeout(8)
    urllib.request.urlopen("https://maayanlab.cloud/Enrichr/geneSetLibrary.json", timeout=8)
    enrichr_ok = True; print("[Enrichr] reachable")
except Exception as e:
    print(f"[Enrichr] UNREACHABLE: {type(e).__name__}: {e}")

print("\n"+"="*70); print("STEP 1: load data"); print("="*70)
layout = pd.read_csv(f"{DATA}/sample_layout.csv")
counts = pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0)
ensg = pd.read_csv(f"{DATA}/ensg_to_gene_name.tsv", sep="\t")
print(f"layout: {len(layout)} samples; counts: {counts.shape[0]} genes x {counts.shape[1]} samples; ensg map: {len(ensg)} rows")
recs = layout.to_dict("records")
col_for = lambda s: s.replace("-", "_")
comb_sids = [r["SampleID"] for r in recs if r["Group"] == "Cisplatin_IC50_CBD_IC50"]
dmso_sids = [r["SampleID"] for r in recs if r["Group"] == "DMSO"]
comb_cols = [col_for(s) for s in comb_sids]; dmso_cols = [col_for(s) for s in dmso_sids]
print(f"combination arm (Cisplatin_IC50_CBD_IC50): {comb_sids} -> cols {comb_cols}")
print(f"DMSO control (DMSO): {dmso_sids} -> cols {dmso_cols}")
all6 = dmso_cols + comb_cols
C = counts[all6].to_numpy(dtype=float)
G, n = C.shape
print(f"DE matrix: {C.shape[0]} genes x {C.shape[1]} samples (3 DMSO + 3 combination)")

print("\n"+"="*70); print("STEP 2: DESeq2-style differential expression"); print("="*70)
# (a) median-of-ratios size factors
ref = np.all(C > 0, axis=1)
if ref.sum() < 10: ref = (C.sum(axis=1) > 0)
gm = np.exp(np.mean(np.log(C[ref] + 1e-12), axis=1))
sf = np.median(C[ref] / gm[:, None], axis=0); sf = sf / np.median(sf)
CN = C / sf
print(f"size factors (3_1,3_2,3_3,9_1,9_2,9_3): {np.round(sf,4)}")

# (b) group mean normalized counts and log2FC (exact GLM MLE + pseudocount)
mean_d = CN[:, :3].mean(axis=1)
mean_c = CN[:, 3:].mean(axis=1)
log2FC = np.log2((mean_c + PS) / (mean_d + PS))
logFC = np.log((mean_c + PS) / (mean_d + PS))
print(f"log2FC range: [{log2FC.min():.3f}, {log2FC.max():.3f}]")

# (c) per-gene NB dispersion (method of moments) shrunk to a mean trend (DESeq2-style)
mu_raw = np.empty_like(CN)
mu_raw[:, :3] = sf[:3][None, :] * mean_d[:, None]      # expected raw counts (DMSO)
mu_raw[:, 3:] = sf[3:][None, :] * mean_c[:, None]       # expected raw counts (comb)
MSres = np.sum((C - mu_raw)**2, axis=1) / (n - 2)       # 4 df
mu_bar = mu_raw.mean(axis=1)
theta_mom = np.clip((MSres/np.maximum(mu_bar,1e-6) - 1.0)/np.maximum(mu_bar,1e-6), 1e-3, 1.0)
valid = (mu_bar > 1) & np.isfinite(theta_mom)
A = np.column_stack([np.ones(valid.sum()), np.log(mu_bar[valid])])
coef, *_ = np.linalg.lstsq(A, np.log(theta_mom[valid]), rcond=None)
trend = coef[0] + coef[1]*np.log(np.maximum(mu_bar, 1e-6))
w = np.minimum(1.0, np.maximum(mu_bar, 0.0)/100.0)      # high-count -> MLE, low-count -> trend
theta = np.clip(np.exp(w*np.log(theta_mom) + (1.0-w)*trend), 1e-3, 1.0)
print(f"per-gene NB dispersion: median={np.median(theta):.4f} mean={theta.mean():.4f} range=[{theta.min():.4f},{theta.max():.4f}]")

# (d) Wald test (delta-method SE under NB) with per-gene dispersion
var_c = (1.0 + mean_c*theta) / (3.0 * np.maximum(mean_c, 1e-6))
var_d = (1.0 + mean_d*theta) / (3.0 * np.maximum(mean_d, 1e-6))
se = np.sqrt(var_c + var_d)
zstat = logFC / np.where(se < 1e-12, 1e-12, se)
pval = np.clip(2.0*stats.norm.sf(np.abs(zstat)), 0, 1)
zero_total = C.sum(axis=1) == 0
pval[zero_total] = 1.0; log2FC[zero_total] = 0.0
# (e) Benjamini-Hochberg FDR
def bh_fdr(p):
    m = len(p); ps = np.sort(p); adj_ps = ps*m/np.arange(1, m+1)
    for i in range(m-2, -1, -1): adj_ps[i] = min(adj_ps[i], adj_ps[i+1])
    adj = adj_ps[np.argsort(np.argsort(p))]
    return np.clip(adj, 0, 1)
padj = bh_fdr(pval); padj[zero_total] = 1.0

de = pd.DataFrame({"ENSG": counts.index, "log2FC": log2FC, "pvalue": pval, "padj": padj})
de.to_csv("de_results.csv", index=False)
print(f"DE results written: {len(de)} genes")
print("Top 12 by padj:")
print(de.sort_values(['padj','pvalue']).head(12).to_string(index=False))
print(f"DE summary: padj<0.05 = {(de['padj']<0.05).sum()}, padj<0.1 = {(de['padj']<0.1).sum()}")

print("\n"+"="*70); print("STEP 3: ENSG->symbol map + rank by log2FC"); print("="*70)
ensg["gene_name"] = ensg["gene_name"].astype(str)
de = de.merge(ensg, on="ENSG", how="left")
de["has_symbol"] = de["gene_name"].notna() & (de["gene_name"] != de["ENSG"]) & (de["gene_name"].str.strip() != "")
n_dropped = int((~de["has_symbol"]).sum())
ranked = de[de["has_symbol"]].sort_values("log2FC", ascending=False)
print(f"real-symbol genes (self-maps/missing dropped: {n_dropped}): {len(ranked)}; unique symbols: {ranked['gene_name'].nunique()}")
print("Top 10 up (highest log2FC):")
print(ranked.head(10)[["ENSG","gene_name","log2FC","padj"]].to_string(index=False))
print("Top 10 down (lowest log2FC):")
print(ranked.tail(10)[["ENSG","gene_name","log2FC","padj"]].to_string(index=False))
rank_series = ranked.set_index("gene_name")["log2FC"]
ranked.to_csv("ranked_by_log2FC.csv", index=False)

print("\n"+"="*70); print("STEP 4: gseapy.enrichr (GO_Biological_Process_2021)"); print("="*70)
blocker = None
if gseapy is None:
    blocker = "gseapy is NOT installed and cannot be installed (offline; no PyPI access)."
elif not enrichr_ok:
    blocker = "gseapy is installed but Enrichr (maayanlab.cloud) is UNREACHABLE; GO_Biological_Process_2021 is an Enrichr library and no local GMT is present."
if blocker is None:
    try:
        result = gseapy.enrichr(gene_list=rank_series, gene_sets="GO_Biological_Process_2021",
                                organism="Human", mode="both", outdir="gsea_out", no_plot=True)
        res_tbl = result["GO_Biological_Process_2021"].sort_values("Adj.p-value")
        print(res_tbl.head(10).to_string(index=False))
        top = res_tbl.iloc[0]
        print(f"\nTOP GO:BP term: {top['Term']}  Adj.p-value={top['Adj.p-value']}")
        res_tbl.to_csv("gsea_GO_BP_2021.csv", index=False)
    except Exception as e:
        blocker = f"gseapy.enrichr raised {type(e).__name__}: {e}"
if blocker:
    print("\n!!! BLOCKER (enrichment step cannot be completed in this environment) !!!")
    print(blocker)
    print("Per instructions: reported as a blocker; NO alternative gene-set library was substituted.")
print(f"\nTotal runtime: {time.time()-t0:.1f}s"); print("DONE")
