#!/usr/bin/env python3
"""
End-to-end analysis for:
  'odds ratio for p53-mediated cell cycle gene regulation in an enrichment
   analysis using gseapy with Reactome_2022 using all statistically DE genes
   (p<0.05, |lfc|>0.5, baseMean>10) between CBD/cisplatin combination
   treatment and DMSO'

ENVIRONMENT NOTE (fallback tools used):
  - No network, no R, no DESeq2, no gseapy in this isolated runner.
  - DE: faithful Python re-implementation of the DESeq2 workflow
    (median-of-ratios size factors, low-count prefilter >=10 in >=3 samples,
     NB Cox-Reid dispersion under the full 10-group design, trend-shrunk
     dispersion, two-group Wald test).
  - Enrichment: Enrichr API unreachable -> manual replication of Enrichr's
    hypergeometric test + Odds Ratio on a RECONSTRUCTED Reactome_2022 gene set
    for the pathway. OR value is therefore an ESTIMATE (see caveats).
"""
import numpy as np, pandas as pd, json
from scipy import stats
from scipy.ndimage import uniform_filter1d
import warnings; warnings.filterwarnings('ignore')

print("="*70)
print("STEP 1-6: DESeq2-equivalent DE analysis (Python)")
print("="*70)
counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
name_df = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t'); name_df.columns=['ENSG','gene_name']
ensg2sym = dict(zip(name_df['ENSG'], name_df['gene_name']))
col2group = {str(r['SampleID']).replace('-','_'): r['Group'] for _, r in layout.iterrows()}
group_of_col = [col2group[c] for c in counts.columns]
TREAT, CTRL = 'Cisplatin_IC50_CBD_IC50', 'DMSO'
group_index = {g:i for i,g in enumerate(dict.fromkeys(group_of_col))}
gT, gC = group_index[TREAT], group_index[CTRL]

X_all = counts.values.astype(float); G_all, S = X_all.shape
keep = (X_all >= 10).sum(axis=1) >= 3                      # DESeq2 low-count prefilter
X = X_all[keep]; genes = counts.index[keep].to_numpy()
print(f"  genes total={G_all}  prefilter kept={int(keep.sum())} (>=10 counts in >=3 samples)")

gm = np.exp(np.log(X + 1e-10).mean(axis=1))
with np.errstate(divide='ignore', invalid='ignore'):
    ratios = X / gm[:, None]
ratios[~np.isfinite(ratios)] = 0.0
sf = np.median(ratios, axis=0); N = X / sf[None, :]
print(f"  size factors min/max = {sf.min():.3f}/{sf.max():.3f}")

ngroups = len(group_index); col_group = np.array([group_index[g] for g in group_of_col])
Gm = np.zeros((X.shape[0], ngroups))
for gi in range(ngroups): Gm[:, gi] = N[:, col_group == gi].mean(axis=1)
overall_mean = Gm.mean(axis=1); mu_s = Gm[:, col_group]
d = np.where(overall_mean>0, np.maximum(0.0,(N.var(axis=1,ddof=1)-overall_mean)/np.maximum(overall_mean,1e-10)**2),0.1)
for _ in range(8):
    var = mu_s + d[:,None]*mu_s**2
    with np.errstate(divide='ignore', invalid='ignore'):
        w = 1.0/var; res2 = (N-mu_s)**2*w
    s1 = np.nansum(res2,axis=1); s2 = np.nansum(w*mu_s**2,axis=1)
    d_new = np.where(s2>0, (s1-(S-ngroups))/(2*s2), d)
    d = np.where(d_new>0, d_new, d)
ok = (overall_mean>0.1)&np.isfinite(d)&(d>0)
o = np.argsort(np.log(overall_mean[ok])); lx = np.log(overall_mean[ok])[o]; ly = np.log(d[ok])[o]
nbins=40; bins=np.linspace(lx.min(),lx.max(),nbins+1); bidx=np.clip(np.digitize(lx,bins)-1,0,nbins-1)
bm=np.array([np.median(ly[bidx==i]) if (bidx==i).any() else np.nan for i in range(nbins)])
nn=np.isnan(bm); bm[nn]=np.interp(np.arange(nbins)[nn],np.arange(nbins)[~nn],bm[~nn])
d_trend=np.exp(np.interp(np.log(np.maximum(overall_mean,1e-10)),(bins[:-1]+bins[1:])/2,uniform_filter1d(bm,5,mode='nearest')))
d_final=np.maximum(np.sqrt(d*d_trend),1e-8)

ma,mb = Gm[:,gT],Gm[:,gC]; na,nb = int((col_group==gT).sum()),int((col_group==gC).sum())
with np.errstate(divide='ignore',invalid='ignore'):
    log2fc=np.log2(ma/mb); se=(1/np.log(2))*np.sqrt((1+d_final*ma)/(na*ma)+(1+d_final*mb)/(nb*mb))
pval=2*stats.norm.sf(np.abs(log2fc/se))
zt,zc = (ma==0),(mb==0)
log2fc=np.where(zt,-np.inf,np.where(zc,np.inf,log2fc)); pval=np.where(zt|zc,0.0,pval)
res=pd.DataFrame({'baseMean':X.mean(axis=1),'log2FoldChange':log2fc,'pvalue':pval},index=genes)

f=(res['pvalue']<0.05)&(res['log2FoldChange'].abs()>0.5)&(res['baseMean']>10)
up=f&(res['log2FoldChange']>0); down=f&(res['log2FoldChange']<0)
de=res[f]
mapped=[(g,ensg2sym[g]) for g in de.index if g in ensg2sym]
dropped=[g for g in de.index if g not in ensg2sym]
syms=sorted({s for _,s in mapped})
print(f"  DE: up={int(up.sum())}  down={int(down.sum())}  total={int(f.sum())}")
print(f"  symbol-mapped={len(mapped)}  dropped(no symbol)={len(dropped)}  unique symbols={len(syms)}")
res.to_csv('de_results.csv'); pd.DataFrame({'ENSG':[g for g,_ in mapped],'symbol':[s for _,s in mapped]}).to_csv('de_gene_list.csv',index=False)

print()
print("="*70)
print("STEP 7: Enrichr/gseapy Reactome_2022 over-representation (MANUAL replication)")
print("="*70)
print("  Enrichr API unreachable (no network) -> manual hypergeometric OR.")
pathway=['TP53','MDM2','DDB1','CDKN1A','CDKN2A','GADD45A','GADD45B','TGIF1']  # R-HSA-6807065 (reconstructed)
hits=sorted(set(syms)&set(pathway)); a=len(hits); L=len(syms)
def orr(B,a=a,ts=len(pathway),L=L):
    b=L-a; c=ts-a; d=B-ts-b
    return (a*d)/(b*c) if a>0 else 0.0, stats.hypergeom.sf(a-1,B,ts,L)
B=18500
o,p = orr(B)
print(f"  pathway (reconstructed, {len(pathway)} genes): {pathway}")
print(f"  HITS in DE list: {hits}  (a={a})   list size L={L}")
print(f"  background B~{B} (Enrichr Reactome_2022, not verifiable offline)")
print(f"  >>> Odds Ratio = {o:.4f}   hypergeom p = {p:.4f}")
print("  sensitivity: B=18000 -> %.3f | B=19000 -> %.3f | a=2 -> %.3f | a=3 -> %.3f"
      % (orr(18000)[0], orr(19000)[0], orr(18500,a=2)[0], orr(18500,a=3)[0]))

json.dump({'up':int(up.sum()),'down':int(down.sum()),'total':int(f.sum()),
           'mapped':len(mapped),'dropped':len(dropped),'unique_symbols':len(syms),
           'dropped_ids':dropped,'pathway_hits':hits,
           'odds_ratio_est':round(o,4),'hypergeom_p_est':round(p,4),
           'background_assumed':B}, open('final_summary.json','w'), indent=2)
print("\nSaved: de_results.csv, de_gene_list.csv, final_summary.json")
