#!/usr/bin/env python3
"""
Extract the log2 fold change (MLE) for mexG in dErhlI (strain #97) vs wt (strain #1)
from data/res_1vs97.rds, using data/Pseudomonas_aeruginosa_UCBPP-PA14.csv to map
the gene symbol 'mexG' to its locus tag.

The .rds files are gzip-compressed R-serialization streams (DESeq2 results objects).
No R / pyreadr is available in this environment and there is no network access, so a
minimal, validation-heavy parser is used. Every structural assumption is checked and
the numeric result is cross-validated (stat == log2FC / lfcSE, pvalue/padj in [0,1],
baseMean > 0, lfcSE > 0). Offsets are derived from the data, not hardcoded.
"""
import gzip, struct, csv, decimal, sys

DATA = "/workspace/data"

def load_stream(path):
    raw = open(path, "rb").read()
    return gzip.decompress(raw)  # whole file is a single gzip member -> R serialization

# ---------------------------------------------------------------------------
# 1) Map mexG -> locus tag from the gene-annotation CSV
# ---------------------------------------------------------------------------
def locus_tag_for_gene(csv_path, gene):
    with open(csv_path, newline="") as f:
        rd = csv.reader(f)
        hdr = next(rd)
        gi, li = hdr.index("Gene Name"), hdr.index("Locus Tag")
        hits = [(r[li], r[gi]) for r in rd if r[gi].strip() == gene]
    assert len(hits) == 1, f"expected exactly one {gene}, got {hits}"
    return hits[0][0]

# ---------------------------------------------------------------------------
# 2) Parse rownames: after the 'rownames' slot name there is an 8-byte header then
#    a run of Unit-A entries: 04 00 09 00 00 00 <len> <char> 00
# ---------------------------------------------------------------------------
def parse_rownames(X):
    p = X.find(b"rownames")
    assert p != -1
    start = p + len(b"rownames") + 1 + 8   # skip name NUL + 8-byte header
    rn, off = [], start
    while off + 7 < len(X):
        if X[off:off+6] != b"\x04\x00\x09\x00\x00\x00":
            break
        ln = X[off+6]
        if X[off+7+ln] != 0:
            break
        rn.append(X[off+7:off+7+ln].decode())
        off += 2 + 4 + 1 + ln + 1
    return rn, off

# ---------------------------------------------------------------------------
# 3) Locate the 6 numeric column blocks. Each block = 8-byte header (ending in the
#    big-endian row-count '16 c4') followed by N big-endian float64 values.
#    The 6 headers are exactly block_size bytes apart.
# ---------------------------------------------------------------------------
def find_column_blocks(X, N):
    block_size = 8 + 8 * N
    count_be = struct.pack(">h", N)          # 5828 -> b'\x16\xc4'
    hits = []
    i = X.find(count_be)
    while i != -1:
        hits.append(i)
        i = X.find(count_be, i + 1)
    # find a hit h such that h, h+bs, ..., h+5*bs are ALL present (the 6 headers)
    hs = set(hits)
    cands = [h for h in hits if all(h + k*block_size in hs for k in range(6))]
    assert len(cands) == 1, f"expected one 6-block run, got {cands}"
    best = [cands[0] + k*block_size for k in range(6)]
    return [h + 2 for h in best]             # float64 data starts right after header

COLS = ["baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]

def read_columns(X, starts, N):
    out = {}
    for name, s in zip(COLS, starts):
        out[name] = [struct.unpack(">d", X[s+8*i:s+8*i+8])[0] for i in range(N)]
    return out

def validate(cols, N, label):
    import math
    bm, lfc, se, st, pv, pa = (cols[c] for c in COLS)
    assert all(v > 0 for v in bm), f"{label}: baseMean not all > 0"
    assert all(v > 0 for v in se), f"{label}: lfcSE not all > 0"
    assert all(0 <= v <= 1 for v in pv), f"{label}: pvalue out of [0,1]"
    assert all(0 <= v <= 1 for v in pa), f"{label}: padj out of [0,1]"
    # stat must equal lfc/SE (Wald statistic) row-wise
    mism = sum(1 for i in range(N)
               if not math.isclose(st[i], lfc[i]/se[i], rel_tol=1e-9, abs_tol=1e-9))
    assert mism == 0, f"{label}: stat != lfc/SE in {mism} rows"
    print(f"[validate] {label}: OK  (N={N}, baseMean>0, lfcSE>0, pvalue/padj in [0,1], stat==lfc/SE)")

# ---------------------------------------------------------------------------
def main():
    tag = locus_tag_for_gene(f"{DATA}/Pseudomonas_aeruginosa_UCBPP-PA14.csv", "mexG")
    print(f"mexG locus tag (from CSV): {tag}")

    X = load_stream(f"{DATA}/res_1vs97.rds")
    print(f"res_1vs97.rds stream length: {len(X)} bytes")

    rn, end = parse_rownames(X)
    N = len(rn)
    print(f"parsed {N} rownames (all unique: {len(set(rn))==N}); first={rn[0]}, last={rn[-1]}")
    assert tag in rn, f"{tag} not among rownames"
    idx = rn.index(tag)
    print(f"{tag} is row index {idx}")

    starts = find_column_blocks(X, N)
    cols = read_columns(X, starts, N)
    validate(cols, N, "res_1vs97")

    lfc = cols["log2FoldChange"][idx]
    print("\n=== mexG (PA14_09540), Strain 97 vs 1 ===")
    for c in COLS:
        print(f"  {c:16s} = {cols[c][idx]!r}")
    print(f"\nRAW log2FoldChange = {lfc!r}")
    r_bank = round(lfc, 2)
    r_hu = float(decimal.Decimal(repr(lfc)).quantize(decimal.Decimal("0.01"),
                                                      rounding=decimal.ROUND_HALF_UP))
    print(f"rounded to 2 dp (banker's) = {r_bank}")
    print(f"rounded to 2 dp (half-up)  = {r_hu}")
    assert r_bank == r_hu, "rounding mode ambiguity!"
    print(f"\nANSWER: {r_bank:.2f}")

    # ---- sanity check only: parse res_1vs98.rds the same way (NOT used for answer)
    Y = load_stream(f"{DATA}/res_1vs98.rds")
    rn2, _ = parse_rownames(Y)
    assert len(rn2) == N, "1vs98 row count mismatch"
    starts2 = find_column_blocks(Y, N)
    cols2 = read_columns(Y, starts2, N)
    validate(cols2, N, "res_1vs98")
    assert b"Strain 98 vs 1" in Y and b"Strain 97 vs 1" not in Y
    print("\n[sanity] res_1vs98.rds parsed consistently (different comparison, 'Strain 98 vs 1'); not used for the answer.")

if __name__ == "__main__":
    main()
