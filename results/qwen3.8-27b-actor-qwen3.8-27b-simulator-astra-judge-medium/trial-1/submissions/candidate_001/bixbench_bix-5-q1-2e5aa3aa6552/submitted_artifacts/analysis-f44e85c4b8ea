#!/usr/bin/env python3
"""
analysis.py
ASXL1 fibroblast RNA-seq: disease vs control differential expression
+ (attempted) GO biological-process enrichment.

Workflow (approved plan):
  1. Load featureCounts (whitespace, 60662 genes x 16 samples), coldata xlsx, gencode CSV.
  2. Inner-join samples -> drop MGD1640F/MGD1641F -> 14 samples (7 disease / 7 control).
  3. Strip Ensembl version; map to gene symbol via gencode gene_name (cross-check HGNC).
  4. Filter row-sum >= 10, keep all gene types.
  5. Median-of-ratios size factors.
  6. statsmodels GLM: Poisson, log link, offset=log(size_factor),
     design = C(condition) + C(sex). log2FC (disease vs control) + p-value per gene; BH FDR.
  7. GO:BP enrichment: attempt (gseapy/clusterProfiler + filesystem search); document availability.
  8. Final result statement.
"""
import os, re, time, warnings, importlib.util, subprocess
import numpy as np
import pandas as pd
warnings.filterwarnings("ignore")
import statsmodels.api as sm

DATA = "data"
FC   = f"{DATA}/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt"
COL  = f"{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx"
GENE = f"{DATA}/gencode.v31.primary_assembly.genes.csv"
HGNC = f"{DATA}/HGNC_05-09-19.txt"
LN2  = np.log(2.0)

def bh(p):
    """Benjamini-Hochberg FDR, NaN-safe."""
    p = np.asarray(p, dtype=float)
    out = np.full(p.shape, np.nan, dtype=float)
    good = ~np.isnan(p)
    m = int(good.sum())
    if m == 0:
        return out
    idx = np.where(good)[0]
    ranked = p[idx]
    order = np.argsort(ranked, kind="stable")
    ranks = np.arange(1, m + 1)
    adj = ranked[order] * m / ranks
    adj = np.minimum.accumulate(adj[::-1])[::-1]
    adj = np.clip(adj, 0.0, 1.0)
    out[idx[order]] = adj
    return out

SEP = "=" * 72

# ---------------- STEP 1: load ----------------
print(SEP); print("STEP 1: Load inputs"); print(SEP)
with open(FC) as f:
    hdr = f.readline().split()
    rows = [l.split() for l in f if l.strip()]
gene_ids = [r[0] for r in rows]
counts_full = np.array([r[1:] for r in rows], dtype=float)
fc_samples = hdr[1:]
print(f"featureCounts: {counts_full.shape[0]} genes x {len(fc_samples)} samples (whitespace-delimited)")

col = pd.ExcelFile(COL).parse("Sheet1")
print(f"coldata: {col.shape} cols={list(col.columns)}")

gen = pd.read_csv(GENE, dtype=str, keep_default_na=False)
gmap = dict(zip(gen["gene_id"], gen["gene_name"]))
print(f"gencode: {len(gen)} rows; gene_id->gene_name map built")

# ---------------- STEP 2: inner-join samples ----------------
print("\n" + SEP); print("STEP 2: Inner-join samples"); print(SEP)
colset = set(col["sample"])
keep = [s for s in fc_samples if s in colset]
dropped = [s for s in fc_samples if s not in colset]
print("dropped (no metadata):", dropped)
print("kept samples:", len(keep))
idx = [list(fc_samples).index(s) for s in keep]
meta = col.set_index("sample").loc[keep].reset_index()
nd = int((meta["condition"] == "disease").sum()); nc = int((meta["condition"] == "control").sum())
print(f"condition counts: disease={nd}, control={nc}")
X = counts_full[:, idx]
print(f"matrix after join: {X.shape[0]} genes x {X.shape[1]} samples")
print("condition x sex:")
print(pd.crosstab(meta["condition"], meta["sex"]).to_string())

# ---------------- STEP 3: symbol mapping ----------------
print("\n" + SEP); print("STEP 3: Ensembl(version) -> gene symbol (gencode gene_name)"); print(SEP)
base = [g.split(".")[0] for g in gene_ids]
symbols = [gmap.get(g, "") for g in gene_ids]
nmap = int(sum(1 for s in symbols if s))
print(f"genes mapped to symbol via gencode: {nmap}/{len(gene_ids)}")
hg = pd.read_csv(HGNC, sep="\t", dtype=str, keep_default_na=False)
ens_col = "Ensembl ID(supplied by Ensembl)"
hgmap = dict(zip(hg[ens_col], hg["Approved symbol"]))
mism = 0; both = 0
for b, s in zip(base, symbols):
    hs = hgmap.get(b, "")
    if hs and s:
        both += 1
        if hs != s:
            mism += 1
print(f"HGNC cross-check: {both} genes in both; mismatches vs gencode gene_name: {mism}")

# ---------------- STEP 4: filter ----------------
print("\n" + SEP); print("STEP 4: Filter row-sum >= 10 (all gene types)"); print(SEP)
rowsum = X.sum(axis=1)
keepmask = rowsum >= 10
Xf = X[keepmask]
symf = np.array(symbols)[keepmask]
basef = np.array(base)[keepmask]
print(f"genes before filter: {X.shape[0]} -> after: {Xf.shape[0]}")

# ---------------- STEP 5: median-of-ratios size factors ----------------
print("\n" + SEP); print("STEP 5: Median-of-ratios size factors"); print(SEP)
with np.errstate(divide="ignore", invalid="ignore"):
    logX = np.log(np.where(Xf > 0, Xf, np.nan))
anyzero = (Xf == 0).any(axis=1)
gm = np.where(anyzero, 0.0, np.exp(np.nanmean(logX, axis=1)))
usable = gm > 0
ratio = Xf[usable] / gm[usable, None]
sf = np.median(ratio, axis=0)
print(f"genes with gm>0 used for size factors: {int(usable.sum())}/{Xf.shape[0]}")
for s, v in zip(keep, sf):
    print(f"   {s}: {v:.5f}")
logsf = np.log(sf)

# ---------------- STEP 6: Poisson GLM ----------------
print("\n" + SEP); print("STEP 6: Poisson GLM (log link), offset=log(size_factor), design=C(condition)+C(sex)"); print(SEP)
design = np.column_stack([
    np.ones(len(keep)),
    (meta["condition"].values == "disease").astype(float),
    (meta["sex"].values == "M").astype(float),
])
print("design (14x3) columns: [intercept, condition_disease(ref=control), sex_M(ref=F)]")
fam = sm.families.Poisson()
G = Xf.shape[0]
log2fc = np.full(G, np.nan)
pvals = np.full(G, np.nan)
nfail = 0
t0 = time.time()
for i in range(G):
    try:
        res = sm.GLM(Xf[i], design, family=fam, offset=logsf).fit()
        log2fc[i] = res.params[1] / LN2
        pvals[i] = res.pvalues[1]
    except Exception:
        nfail += 1
print(f"fitted {G} genes in {time.time()-t0:.1f}s (fit failures: {nfail})")
padj = bh(pvals)
sig = (~np.isnan(padj)) & (padj < 0.05)
print(f"total genes tested: {G}")
print(f"significant (padj < 0.05): {int(sig.sum())}")

fin = ~np.isnan(log2fc)
up_idx = np.where(fin)[0]; up_idx = up_idx[np.argsort(-log2fc[up_idx])]
dn_idx = np.where(fin)[0]; dn_idx = dn_idx[np.argsort(log2fc[dn_idx])]
def show(idxs, title):
    print(f"\n--- {title} ---")
    for j in idxs[:20]:
        print(f"   {basef[j]:18s} {str(symf[j]):12s} log2FC={log2fc[j]:8.3f}  p={pvals[j]:.3g}  padj={padj[j]:.3g}")
show(up_idx, "Top-20 UP by log2FC (disease vs control)")
show(dn_idx, "Top-20 DOWN by log2FC (disease vs control)")

upreg = (log2fc > 0) & sig
print(f"\nUp-regulated in disease (log2FC>0 & padj<0.05): {int(upreg.sum())}")
# note on perfect separation
nsep = int(((~np.isnan(pvals)) & (pvals == 0)).sum())
print("NOTE: Poisson GLM on sparse counts -> group-specific genes hit perfect separation,")
print("      inflating |log2FC| and driving p~0; top-by-|log2FC| lists reflect this artifact.")

# ---------------- STEP 7: GO:BP attempt ----------------
print("\n" + SEP); print("STEP 7: GO:BP enrichment (attempt + document availability)"); print(SEP)
found_pkg = [p for p in ["gseapy", "clusterProfiler", "gseapy"] if importlib.util.find_spec(p.replace("gseapy","gseapy"))]
# dedupe
found_pkg = sorted(set(found_pkg))
print("GO-capable Python packages importable:", found_pkg if found_pkg else "NONE (gseapy/clusterProfiler not installed)")

print("\nFinal filesystem search for GO:000 / biological_process ...")
found_files = []
try:
    cmd = ["grep", "-rIlE", "GO:000[0-9]{4}|biological_process",
           "--exclude-dir=proc", "--exclude-dir=sys", "--exclude-dir=dev",
           "--exclude-dir=.git", "/workspace", "/data", "/home", "/root",
           "/opt", "/srv", "/tmp", "/usr/share", "/var/lib", "/mnt"]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    found_files = [x for x in r.stdout.splitlines() if x.strip()]
    _self = {os.path.abspath(p) for p in
            ["/workspace/analysis.py", "/workspace/analysis.stdout.txt", "/workspace/analysis.stderr.txt"]}
    found_files = [x for x in found_files if os.path.abspath(x) not in _self]
except subprocess.TimeoutExpired:
    print("  (grep timed out at 180s; partial result may be incomplete)")
except Exception as e:
    print("  (grep error:", e, ")")
print("files containing GO:000/biological_process on disk:", found_files if found_files else "NONE")

GO_AVAILABLE = bool(found_pkg) and bool(found_files)
if not GO_AVAILABLE:
    print("\nERROR: GO:BP annotation source unavailable in sandbox; enrichment step cannot be completed.")

# ---------------- STEP 8: final ----------------
print("\n" + SEP); print("STEP 8: FINAL RESULT"); print(SEP)
upreg_idx = np.where(upreg)[0]
upreg_idx = upreg_idx[np.argsort(-log2fc[upreg_idx])]
top10_up = [f"{symf[j]}(log2FC={log2fc[j]:+.2f},padj={padj[j]:.2g})" for j in upreg_idx[:10]]
if GO_AVAILABLE:
    print("GO:BP annotation available - computing enrichment...")
else:
    print("Due to absence of GO:BP annotation in the provided data and sandbox, the most enriched")
    print("GO biological process term CANNOT BE DETERMINED.")
    print(f"The DE analysis (condition+sex, median-of-ratios, Poisson GLM, BH FDR<0.05) identified")
    print(f"{int(upreg.sum())} up-regulated genes in disease (of {G} genes tested).")
    print(f"Top up-DE genes by log2FC: {top10_up}")
    print("GO:BP enrichment requires an external gene2go or .gmt annotation file.")
print(SEP)
print("DONE")
