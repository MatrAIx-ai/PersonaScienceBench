# BixBench bix-51-q1: P(efficacy PR with treatment | Age=65) via logistic regression (Age only)
import pandas as pd
import numpy as np
import statsmodels.api as sm
from scipy.optimize import minimize

# --- Load & clean: keep real patient rows (Sequence number present) ---
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
pat = df[df['Sequence number'].notna()].copy()
pat['Age'] = pd.to_numeric(pat['Age'], errors='coerce')
assert len(pat) == 80 and pat['Age'].notna().all()

# --- Binary outcome: PR = 1, SD/PD = 0 (PR occurs only in Group 1 = treatment arm) ---
pat['y'] = (pat['Efficacy'] == 'PR').astype(int)
print(f"n={len(pat)}, PR={pat['y'].sum()}, non-PR={(1-pat['y']).sum()}")
print("Groups x PR crosstab:\n", pd.crosstab(pat['Groups'], pat['y']))

# --- Primary model: statsmodels Logit(y ~ Age) ---
X = sm.add_constant(pat['Age'])
logit = sm.Logit(pat['y'], X).fit(disp=0)
print("\n=== statsmodels Logit ===")
print(logit.summary().tables[1])
p65_sm = logit.predict(pd.DataFrame({'const': [1], 'Age': [65]}))
print(f"\nP(y=1 | Age=65) [statsmodels] = {p65_sm[0]:.6f}")

# --- Cross-check: independent plain-MLE fit via scipy (unregularized logistic MLE) ---
y = pat['y'].values.astype(float); a = pat['Age'].values.astype(float)
def nll(theta):
    p = 1/(1+np.exp(-(theta[0]+theta[1]*a)))
    return -np.sum(y*np.log(p) + (1-y)*np.log(1-p))
res = minimize(nll, [0.0, 0.0], method='BFGS',
               options={'gtol':1e-12})
b0, b1 = res.x
p65_sc = 1/(1+np.exp(-(b0+b1*65)))
print(f"\nscipy MLE cross-check: intercept={b0:.6f}, slope={b1:.6f}, converged={res.success}")
print(f"P(y=1 | Age=65) [scipy MLE] = {p65_sc:.6f}")
print(f"max |diff| of p65 between routines: {abs(p65_sm[0]-p65_sc):.2e}")
