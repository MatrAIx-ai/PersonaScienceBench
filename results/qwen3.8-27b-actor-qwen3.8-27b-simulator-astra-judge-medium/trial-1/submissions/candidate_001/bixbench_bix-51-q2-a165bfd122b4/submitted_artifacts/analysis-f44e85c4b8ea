"""
BixBench bix-51-q2: AIC of logistic regression using BMI as the sole
predictor of treatment response (efficacy PR).

Response: PR = 1 (responder); non-PR (SD or PD) = 0. Predictor: BMI (+intercept).
Data: data/data.xlsx, Sheet1. The 41 trailing blank rows (no Sequence number)
are dropped; the remaining 80 rows are complete for Efficacy and BMI.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

# 1. Load the single sheet, header on Excel row 1
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1", header=0)

# 2. Keep only real rows (have a Sequence number); drop blank trailing rows
real = df[df["Sequence number"].notna()].copy()
assert len(real) == 80, f"expected 80 real rows, got {len(real)}"
assert real["Efficacy"].notna().all() and real["BMI"].notna().all(), \
    "Efficacy/BMI missing among real rows"

# 3. Binary response: PR = 1; SD/PD = 0
real["y"] = (real["Efficacy"] == "PR").astype(int)
print("n =", len(real))
print("Response counts: PR(1) =", int(real["y"].sum()),
      " non-PR(0) =", int((1 - real["y"]).sum()))
print("Efficacy breakdown:\n", real["Efficacy"].value_counts().to_string())

# 4. Predictor BMI (sole) + intercept
X = sm.add_constant(real["BMI"].astype(float))

# 5. Fit statsmodels Logit (MLE)
model = sm.Logit(real["y"], X).fit()

# 6. Report
print("\n=== MODEL SUMMARY ===")
print(model.summary())
k = int(model.df_model + 1)            # intercept + BMI = 2
print("\n=== KEY RESULTS ===")
print("Converged:", model.mle_retvals["converged"])
print("Log-Likelihood:", model.llf)
print("Number of parameters k =", k, " (intercept + BMI)")
print("AIC (statsmodels, k=2):", model.aic)
print("AIC manual check (-2*llf + 2*2):", -2 * model.llf + 2 * 2)
print("AIC if k=1 (predictor only):", -2 * model.llf + 2 * 1)
print("\nCoefficients:\n", model.params.to_string())
print("\nOdds ratio for BMI:", float(np.exp(model.params["BMI"])))
