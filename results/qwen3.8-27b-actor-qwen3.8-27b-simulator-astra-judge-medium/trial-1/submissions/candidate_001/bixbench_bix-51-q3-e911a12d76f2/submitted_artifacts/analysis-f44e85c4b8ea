import pandas as pd
import numpy as np
import statsmodels.api as sm
import warnings

print("=" * 70)
print("Combined Logistic Regression: PR vs non-PR")
print("Predictors: Age, BMI, Gender")
print("=" * 70)
print()

# --- 1. Load data ---
df = pd.read_excel('data/data.xlsx')
print(f"Raw shape: {df.shape}")

# Keep only rows where Efficacy is present (80 valid rows)
# (41 trailing rows are blank; row 120 has a stray space in Age but is otherwise empty)
df = df[df['Efficacy'].notna()].reset_index(drop=True)
print(f"Valid shape after filtering: {df.shape}")
print()

# --- 2. Prepare variables ---
# Age: convert from string to numeric
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
print(f"Age nulls after conversion: {df['Age'].isna().sum()}")
print(f"Age range: {df['Age'].min():.0f} - {df['Age'].max():.0f}, mean: {df['Age'].mean():.1f}")

# Binary outcome: PR = 1, non-PR (PD or SD) = 0
df['Is_PR'] = (df['Efficacy'] == 'PR').astype(int)
print(f"Outcome counts: PR={df['Is_PR'].sum()}, non-PR={(1-df['Is_PR']).sum()}")

# Gender encoding: Male=1, Female=0 (reference)
df['Gender_male'] = (df['Gender'] == 'Male').astype(int)
print(f"Gender encoding: Male={df['Gender_male'].sum()}, Female={(1-df['Gender_male']).sum()}")

# BMI: already float64
print(f"BMI range: {df['BMI'].min():.1f} - {df['BMI'].max():.1f}, mean: {df['BMI'].mean():.1f}")
print()

# --- 3. Build design matrix ---
X = df[['Age', 'BMI', 'Gender_male']]
X = sm.add_constant(X)
y = df['Is_PR']

print("Design matrix head:")
print(X.head(10).to_string())
print()

# --- 4. Fit logistic regression ---
print("Fitting model...")
model = sm.Logit(y, X)

with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    results = model.fit(disp=1)

# Check for warnings
if wlist:
    print("\n*** WARNINGS during fit: ***")
    for w in wlist:
        print(f"  {w.category.__name__}: {w.message}")
else:
    print("\nNo warnings during fit.")

print(f"\nConverged: {results.mle_retvals['converged']}")
print(f"Number of iterations: {results.mle_retvals['iterations']}")
print()

# --- 5. Full summary table ---
print("=" * 70)
print("FULL MODEL SUMMARY (with robust CI)")
print("=" * 70)
print()
print(results.summary2())
print()

# --- 6. Extract age p-value specifically ---
print("=" * 70)
print("KEY RESULT")
print("=" * 70)
ci = results.conf_int()
print(f"\nAge coefficient:   {results.params['Age']:.6f}")
print(f"Age p-value:       {results.pvalues['Age']:.6f}")
print(f"Age 95% CI:        [{ci.loc['Age', 0]:.6f}, {ci.loc['Age', 1]:.6f}]")
print(f"Age OR:            {np.exp(results.params['Age']):.6f}")
print(f"Age OR 95% CI:     [{np.exp(ci.loc['Age', 0]):.6f}, {np.exp(ci.loc['Age', 1]):.6f}]")
print()

# --- 7. All coefficients in a clean table ---
print("All coefficients (clean summary):")
print("-" * 70)
print(f"{'Variable':<15} {'Coef':>10} {'Std Err':>10} {'z':>10} {'p-value':>10} {'CI lower':>10} {'CI upper':>10}")
print("-" * 70)
bse = results.bse
for name in ['const', 'Age', 'BMI', 'Gender_male']:
    print(f"{name:<15} {results.params[name]:>10.6f} {bse[name]:>10.6f} "
          f"{results.tvalues[name]:>10.4f} {results.pvalues[name]:>10.6f} "
          f"{ci.loc[name, 0]:>10.4f} {ci.loc[name, 1]:>10.4f}")
print("-" * 70)
print()

print(f"*** P-value for Age as predictor of PR: {results.pvalues['Age']:.6f} ***")
