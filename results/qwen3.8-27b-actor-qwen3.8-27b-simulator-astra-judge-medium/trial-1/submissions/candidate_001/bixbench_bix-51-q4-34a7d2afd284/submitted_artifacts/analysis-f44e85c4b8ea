import pandas as pd
import numpy as np
import statsmodels.api as sm

# Load
df = pd.read_excel('data/data.xlsx')

# Keep only valid rows (have a Sequence number)
df = df[df['Sequence number'].notna()].reset_index(drop=True)
print("Clean rows:", len(df))

# Coerce Age to numeric (stored as object strings)
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')

# Outcome: remission = PR
df['remission'] = (df['Efficacy'] == 'PR').astype(int)

# Gender dummy, reference = Male (Female = 1)
df['Female'] = (df['Gender'] == 'Female').astype(int)

print("Remission (PR) count:", int(df['remission'].sum()), "of", len(df))
print("Missing in predictors:", df[['Age','BMI','Female','remission']].isna().sum().to_dict())

# Model: y ~ Age + BMI + Female (no Groups)
X = df[['Age','BMI','Female']].astype(float)
X = sm.add_constant(X)
y = df['remission'].astype(float)

model = sm.Logit(y, X).fit(disp=0)

print("\n=== SUMMARY ===")
print(model.summary())

print("\n=== 3-ROW COEFFICIENT TABLE ===")
tab = pd.DataFrame({
    'coef': model.params,
    'std_err': model.bse,
    'z': model.tvalues,
    'p_value': model.pvalues,
    'conf_low': model.conf_int()[0],
    'conf_high': model.conf_int()[1],
}).loc[['Age','BMI','Female']]
print(tab.to_string())

print("\nn =", int(model.nobs))
print("converged:", model.mle_retvals['converged'])
print("Age coef (per-year log-odds of remission):", round(model.params['Age'], 6))
print("Age SE:", round(model.bse['Age'], 6))
print("Age p-value:", round(model.pvalues['Age'], 6))
