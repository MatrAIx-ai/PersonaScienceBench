import pandas as pd
import numpy as np
import statsmodels.api as sm
from scipy.stats import chi2

# Load data
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# Drop empty padding rows (rows 80-120 are all NaN)
df = df.dropna(subset=['Efficacy', 'BMI']).reset_index(drop=True)
print(f"Usable observations: {len(df)}")

# Create binary outcome: PR = 1 (responder), SD + PD = 0 (non-responder)
df['response'] = (df['Efficacy'] == 'PR').astype(int)
print(f"Responders (PR): {df['response'].sum()}, Non-responders (SD+PD): {(1-df['response']).sum()}")
print(f"BMI: mean={df['BMI'].mean():.2f}, sd={df['BMI'].std():.2f}, range=[{df['BMI'].min()}, {df['BMI'].max()}]")

# Univariate logistic regression: response ~ BMI
X = sm.add_constant(df['BMI'])
model = sm.Logit(df['response'], X).fit(disp=0)

print("\n=== Model Summary ===")
print(model.summary())

# Wald p-value (primary)
wald_p = model.pvalues['BMI']
print(f"\nWald p-value for BMI: {wald_p:.6f}")

# Likelihood-ratio test p-value (for comparison)
null_model = sm.Logit(df['response'], sm.add_constant(np.ones(len(df)))).fit(disp=0)
lrt_stat = 2 * (model.llf - null_model.llf)
lrt_p = chi2.sf(lrt_stat, df=1)
print(f"LRT statistic: {lrt_stat:.4f}, LRT p-value: {lrt_p:.6f}")

# Odds ratio
or_val = np.exp(model.params['BMI'])
ci = model.conf_int().loc['BMI']
ci_lo = np.exp(ci[0])
ci_hi = np.exp(ci[1])
print(f"\nOdds ratio for BMI: {or_val:.4f} (95% CI: [{ci_lo:.4f}, {ci_hi:.4f}])")
