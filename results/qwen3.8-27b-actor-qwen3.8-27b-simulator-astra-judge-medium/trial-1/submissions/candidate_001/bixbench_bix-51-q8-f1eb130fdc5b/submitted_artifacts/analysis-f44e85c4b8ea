"""
Simple (univariate) logistic regression: camrelizumab treatment response ~ Age.
Data: data/data.xlsx (Sheet1). Drop empty padding rows (keep real patients).
Outcome: response = 1 if Efficacy == 'PR' else 0 (RECIST objective response; SD/PD = 0).
Predictor: Age (raw, continuous, per 1 year).
Model: statsmodels Logit (binomial, logit link), with intercept.
"""
import pandas as pd
import statsmodels.api as sm

# 1) Load and clean
df = pd.ExcelFile("data/data.xlsx").parse("Sheet1")
real = df[df["Sequence number"].notna()].copy()          # drop 41 empty padding rows
real["Age"] = pd.to_numeric(real["Age"], errors="coerce")  # Age stored as text -> numeric
real["response"] = (real["Efficacy"] == "PR").astype(int)  # PR=1, SD/PD=0

print("Real patients:", len(real))
print("Missing Age:", real["Age"].isna().sum(),
      "| Missing Efficacy:", real["Efficacy"].isna().sum())
print("Response (PR=1) counts:", real["response"].value_counts().to_dict())
print("Age range:", real["Age"].min(), "-", real["Age"].max())

# 2) Fit univariate logistic regression
X = sm.add_constant(real["Age"])
model = sm.Logit(real["response"], X).fit(disp=0)

print("\n=== Model: Logit(response ~ Age) ===")
print(model.summary2().tables[1])

# 3) Extract Age coefficient
age_coef = model.params["Age"]
age_se = model.bse["Age"]
age_p = model.pvalues["Age"]
age_ci = model.conf_int().loc["Age"]
print("\n=== RESULT ===")
print(f"Age coefficient (change in log-odds per +1 year): {age_coef:.6f}")
print(f"  SE = {age_se:.6f}")
print(f"  p-value = {age_p:.6f}")
print(f"  95% CI = [{age_ci[0]:.6f}, {age_ci[1]:.6f}]")
print(f"  Odds ratio per year = {2.718281828**age_coef:.6f}")
print(f"\nConverged: {model.mle_retvals['converged']}")
print(f"Method: {model.method} | nobs={int(model.nobs)} | df_model={model.df_model} | df_resid={model.df_resid}")
print(f"LLF={model.llf:.4f} | AIC={model.aic:.4f} | BIC={model.bic:.4f} | Pseudo R2={model.prsquared:.4f}")
print(f"Intercept = {model.params['const']:.6f} (SE={model.bse['const']:.6f})")
