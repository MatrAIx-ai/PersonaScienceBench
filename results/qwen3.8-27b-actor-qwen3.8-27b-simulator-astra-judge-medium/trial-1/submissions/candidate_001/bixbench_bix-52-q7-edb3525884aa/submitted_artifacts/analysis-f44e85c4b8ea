import pandas as pd

CSV = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
df = pd.read_csv(CSV)

# A "site" is a unique (Chromosome, StartPosition, EndPosition) tuple.
key = ["Chromosome", "StartPosition", "EndPosition"]
total_sites = df[key].drop_duplicates().shape[0]

mp = df["MethylationPercentage"]
# Strict boundaries: >90 or <10
df["extreme"] = (mp > 90) | (mp < 10)
# Inclusive variant (sensitivity check): >=90 or <=10
df["extreme_incl"] = (mp >= 90) | (mp <= 10)

print("Total data rows:", len(df))
print("Total unique sites:", total_sites)
print("Rows >90:", int((mp > 90).sum()))
print("Rows <10:", int((mp < 10).sum()))
print("Rows >90 or <10 (strict):", int(df['extreme'].sum()))

# Aggregate ANY per site
g = df.groupby(key)
site_has_extreme = g["extreme"].any()
kept = int(site_has_extreme.sum())
removed = int((~site_has_extreme).sum())
print("\n--- PRIMARY (strict >90 or <10, ANY per site) ---")
print("Sites that SHOW >90% or <10% (KEPT):", kept)
print("Sites that DO NOT show >90% or <10% (REMOVED):", removed)

# Sensitivity: inclusive boundaries
site_has_extreme_incl = g["extreme_incl"].any()
removed_incl = int((~site_has_extreme_incl).sum())
kept_incl = int(site_has_extreme_incl.sum())
print("\n--- SENSITIVITY (inclusive >=90 or <=10) ---")
print("Sites KEPT:", kept_incl)
print("Sites REMOVED:", removed_incl)

print("\nFINAL ANSWER (sites removed):", removed)
