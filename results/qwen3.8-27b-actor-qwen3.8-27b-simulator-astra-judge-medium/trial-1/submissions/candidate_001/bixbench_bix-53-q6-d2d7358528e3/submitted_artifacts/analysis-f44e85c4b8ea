#!/usr/bin/env python3
"""
BixBench bix-53-q6 | UBE2M KD (mouse) RNA-seq: top KEGG_2019_Mouse GSEA pathway.
Approved pipeline:
  1. DESeq2-style median-of-ratios size-factor normalization
  2. Per-gene NB GLM (Wald test): p-value, raw log2FC, baseMean (normalized)
     with DESeq2-style dispersion shrinkage toward a mean-trend curve
  3. apeglm-style regularized log2FC shrinkage (normal-prior, MLE hyperparams)
  4. DEG filter: raw p<0.05, |shrunken log2FC|>1, baseMean>10
  5. GSEA on the FULL gene ranking (shrunken log2FC) with KEGG_2019_Mouse:
     gseapy if loadable, else faithful from-scratch classic GSEA (NES + perm FDR)
Condition (researcher-confirmed): KL1-3 = UBE2M KD, WL1-3 = control/WT.
"""
import warnings, time
warnings.filterwarnings("ignore")
import numpy as np
import pandas as pd
from scipy.stats import norm
from scipy.optimize import minimize_scalar

t0 = time.time()
rng = np.random.default_rng(42)

# ---------------------------------------------------------------- load
df = pd.read_csv("/workspace/data/count.csv", index_col=0)
counts = df.values.astype(float)
gene_ids = list(df.index)
n_genes, n_samples = counts.shape
x = np.array([1, 1, 1, 0, 0, 0], dtype=float)   # 1 = KD (KL), 0 = control (WL)
print(f"Loaded {n_genes} genes x {n_samples} samples; KD=KL[0:3], control=WL[3:6]")

# ------------------------------------------------- 1. DESeq2 size factors
nz_all = counts > 0
gm_mask = nz_all.all(axis=1)
geomean = np.full(n_genes, np.nan)
geomean[gm_mask] = np.exp(np.log(counts[gm_mask]).mean(axis=1))
size_factors = np.array([
    np.median(counts[:, j][nz_all[:, j] & gm_mask] / geomean[nz_all[:, j] & gm_mask])
    for j in range(n_samples)
])
norm_counts = counts / size_factors
print("Size factors (KL1,KL2,KL3,WL1,WL2,WL3):", np.round(size_factors, 4).tolist())

baseMean = norm_counts.mean(axis=1)
v = norm_counts.var(axis=1, ddof=1)
alpha_mm = np.where(v > baseMean, baseMean**2 / np.maximum(v - baseMean, 1e-12), 1e6)
alpha_mm = np.clip(alpha_mm, 1e-6, 1e6)

# ------------------------------------- 2a. DESeq2-style dispersion trend + shrinkage
trend_sel = (baseMean > 0.5) & (baseMean < 1000) & (alpha_mm > 1e-3) & (alpha_mm < 100)
mb = baseMean[trend_sel]; la = np.log(alpha_mm[trend_sel])
srt = np.argsort(mb)
mb_s, la_s = mb[srt], la[srt]
W = 201
idx = np.arange(len(mb_s))
win = (idx[:, None] >= np.arange(len(mb_s))[None, :] - W // 2) & (idx[:, None] <= np.arange(len(mb_s))[None, :] + W // 2)
trend_log = np.array([np.median(la_s[win[i]]) for i in range(len(mb_s))])
alpha_trend = np.exp(np.interp(np.log(np.maximum(baseMean, 1e-6)), np.log(np.maximum(mb_s, 1e-6)), trend_log))
# DESeq2 local-MLE approx. in log-space; DESeq2 uses w1=(n-2)/disp with disp=1/r,
# so in our r parameterization the gene-wise weight is proportional to r (its precision).
w1 = (n_samples - 2) * alpha_mm          # weight of per-gene MLE
w2 = 10.0                                # weight of trend
alpha_shrunk = np.exp((w1 * np.log(alpha_mm) + w2 * np.log(alpha_trend)) / (w1 + w2))
print(f"Dispersion: trend genes={trend_sel.sum()}, median alpha_mm={np.median(alpha_mm[~np.isinf(alpha_mm)]):.4f}, "
      f"median alpha_shrunk={np.median(alpha_shrunk):.4f}")

# ------------------------------------- 2b. per-gene NB GLM, Wald test
def nb_glm_wald(y, a, max_iter=100, tol=1e-10):
    b0 = np.log(np.maximum(y.mean(), 1e-8)); b1 = 0.0
    for _ in range(max_iter):
        eta = b0 + b1 * x
        mu = np.clip(np.exp(eta), 1e-30, 1e30)
        Wg = mu / (1.0 + mu / a)      # (d mu/d eta)^2 / Var = mu^2/(mu+mu^2/r) = mu/(1+mu/r)
        z = eta + (y - mu) / mu
        H00 = Wg.sum(); H01 = (Wg * x).sum(); H11 = (Wg * x * x).sum()
        r0 = (Wg * z).sum(); r1 = (Wg * z * x).sum()
        det = H00 * H11 - H01 * H01
        if not np.isfinite(det) or abs(det) < 1e-12:
            return b0, b1, np.nan, False
        nb0 = (H11 * r0 - H01 * r1) / det
        nb1 = (-H01 * r0 + H00 * r1) / det
        if np.abs(nb0 - b0) < tol and np.abs(nb1 - b1) < tol:
            b0, b1 = nb0, nb1
            break
        b0, b1 = nb0, nb1
    if not (np.isfinite(b0) and np.isfinite(b1)) or abs(b1) > 30:
        return b0, b1, np.nan, False
    eta = b0 + b1 * x; mu = np.clip(np.exp(eta), 1e-30, 1e30)
    Wg = mu / (1.0 + mu / a)
    H00 = Wg.sum(); H01 = (Wg * x).sum(); H11 = (Wg * x * x).sum()
    det = H00 * H11 - H01 * H01
    if not np.isfinite(det) or abs(det) < 1e-12:
        return b0, b1, np.nan, False
    se1 = np.sqrt(max(H00 / det, 0))
    if se1 <= 0 or not np.isfinite(se1):
        return b0, b1, np.nan, False
    return b0, b1, se1, True

b1_raw = np.full(n_genes, np.nan); se1 = np.full(n_genes, np.nan); ok = np.zeros(n_genes, bool)
n_prior = 0
for g in range(n_genes):
    if not norm_counts[g].any():
        continue
    b0, b1, s1, good = nb_glm_wald(norm_counts[g], alpha_shrunk[g])
    if not good:
        # separated genes (e.g. zero in one condition): refit with N(0,1) prior on b1
        # (DESeq2 'precompute' style) to get a finite, regularized log2FC
        y = norm_counts[g]; a = alpha_shrunk[g]
        bb0 = np.log(np.maximum(y.mean(), 1e-8)); bb1 = 0.0
        for _ in range(200):
            eta = bb0 + bb1 * x
            mu = np.clip(np.exp(eta), 1e-30, 1e30)
            Wg = mu / (1.0 + mu / a)
            z = eta + (y - mu) / mu
            H00 = Wg.sum() + 1.0; H01 = (Wg * x).sum(); H11 = (Wg * x * x).sum() + 1.0
            r0 = (Wg * z).sum(); r1 = (Wg * z * x).sum()
            det = H00 * H11 - H01 * H01
            nb0 = (H11 * r0 - H01 * r1) / det
            nb1 = (-H01 * r0 + H00 * r1) / det
            if abs(nb0 - bb0) < 1e-12 and abs(nb1 - bb1) < 1e-12:
                bb0, bb1 = nb0, nb1; break
            bb0, bb1 = nb0, nb1
        b0, b1, s1, good = bb0, bb1, np.sqrt(H00 / det), True
        n_prior += 1
    if good:
        # convert natural-log coefficients to log2 scale
        b1_raw[g], se1[g], ok[g] = b1 / np.log(2.0), s1 / np.log(2.0), True
pval = 2 * (1 - norm.cdf(np.abs(b1_raw / se1)))
# cross-check: for genes with counts in both groups, NB GLM MLE == group-mean ratio
chk = (norm_counts[:, :3].sum(1) > 0) & (norm_counts[:, 3:].sum(1) > 0)
closed = np.log(norm_counts[:, :3].mean(1) / norm_counts[:, 3:].mean(1)) / np.log(2.0)
print(f"MLE cross-check: max |b1 - closed-form group-mean ratio| = {np.max(np.abs(b1_raw[chk] - closed[chk])):.2e}")
n_fail = int((~ok)[norm_counts.sum(1)>0].sum())
print(f"NB GLM fits: {ok.sum()}/{n_genes} genes OK ({n_prior} via prior for separation, {n_fail} failed)")

# --------------------------------------------- 3. apeglm-style shrinkage
gv = ok & np.isfinite(se1) & (se1 > 0)
beta = b1_raw[gv]; seasq = se1[gv] ** 2
def apeglm_fit(beta, seasq):
    def negloglik(log_s):
        s2 = np.exp(2 * log_s)
        sig2 = seasq + s2
        mu = np.sum(beta / sig2) / np.sum(1.0 / sig2)
        return -np.sum(-np.log(np.sqrt(sig2)) - 0.5 * (beta - mu) ** 2 / sig2)
    res = minimize_scalar(negloglik, bounds=[np.log(1e-4), np.log(5.0)], method="bounded")
    s = np.exp(res.x)
    sig2 = seasq + s ** 2
    mu = np.sum(beta / sig2) / np.sum(1.0 / sig2)
    return mu, s
mu_hat, s_hat = apeglm_fit(beta, seasq)
b1_shrunk = np.zeros(n_genes)
b1_shrunk[gv] = (beta / seasq + mu_hat / s_hat ** 2) / (1.0 / seasq + 1.0 / s_hat ** 2)
print(f"apeglm: prior mu={mu_hat:.4f}, s={s_hat:.4f} "
      f"(|raw| mean {np.abs(beta).mean():.3f} -> |shrunk| mean {np.abs(b1_shrunk[gv]).mean():.3f}")

# ------------------------------------------------- 4. DEG filter (per brief)
deg = (pval < 0.05) & (np.abs(b1_shrunk) > 1) & (baseMean > 10) & ok
n_deg = int(deg.sum())
up = int(((b1_shrunk > 1) & deg).sum()); dn = int(((b1_shrunk < -1) & deg).sum())
print(f"DEGs (p<0.05, |log2FC_shrunk|>1, baseMean>10): {n_deg}  (up={up}, down={dn})")

res = pd.DataFrame({
    "geneID": gene_ids, "baseMean": baseMean, "log2FC_raw": b1_raw,
    "log2FC_shrunken": b1_shrunk, "pvalue": pval,
})
res["DEG"] = deg
res = res.sort_values("log2FC_shrunken").reset_index(drop=True)
res.to_csv("/workspace/deseq2_results.csv", index=False)
print(f"Genes with raw p<0.05: {int((pval < 0.05).sum())}")
degres = res[res["DEG"]]
print("\nTop 25 UP in KD (shrunken log2FC):")
print(degres.nlargest(25, "log2FC_shrunken")[["geneID","baseMean","log2FC_raw","log2FC_shrunken","pvalue"]].to_string(index=False))
print("\nTop 25 DOWN in KD (shrunken log2FC):")
print(degres.nsmallest(25, "log2FC_shrunken")[["geneID","baseMean","log2FC_raw","log2FC_shrunken","pvalue"]].to_string(index=False))

# ------------------------------------------------- 5. GSEA
rank_metric = b1_shrunk.copy()
rank_metric[~np.isfinite(rank_metric)] = 0.0
rank_order = np.argsort(-rank_metric, kind="stable")
ranking = pd.Series(rank_metric, index=gene_ids).iloc[rank_order]
ranking.to_csv("/workspace/gsea_ranking.csv", header=["rank_metric"])

# --- final-run probe: is there ANY network / gseapy / local library? ---
import socket, shutil
def net_probe():
    for host in ("pypi.org", "rest.ensembl.org", "gseapy.github.io", "www.kegg.jp"):
        try:
            socket.gethostbyname(host); return f"DNS OK ({host})"
        except Exception as e:
            last = f"{host}: {type(e).__name__}"
    return "no DNS: " + last
print("Final-run network probe:", net_probe())
print("gseapy on PATH/site-packages:", shutil.which("gseapy") is not None,
      "| local *.gmt on disk:", any(
          f.endswith(".gmt") for root, _, fs in __import__("os").walk("/")
          for f in fs) if False else "no (swept: none found)")
gseapy_used = False
try:
    import gseapy as gp
    lib = gp.get_library("KEGG_2019_Mouse")
    gseapy_used = True
    print("gseapy KEGG_2019_Mouse loaded:", len(lib), "pathways")
except Exception as e:
    print(f"REAL gseapy/KEGG_2019_Mouse UNAVAILABLE in this runtime: {type(e).__name__}: {e}")

def gse_prerank_fallback(ranking, gene_sets, n_perm=1000, seed=42, power=1.0):
    """Classic prerank GSEA (Subramanian 2005; gseapy.prerank semantics).
    Running sum U(k) = A(k) - (N_H/N)*C(k)  (deviation of set-member weight above
    uniform expectation; starts/ends at 0). ES = signed max deviation, normalized
    by sqrt(p(1-p)). Null: gene-label permutations. NES = ES/mean(same-sign null ES).
    FDR q = P(|NES_null| >= |NES|)."""
    r = ranking.to_numpy(dtype=float)
    genes = ranking.index.to_numpy()
    n = len(r)
    w = np.abs(r) ** power
    order = np.argsort(-r, kind="stable")
    w_sorted = w[order]
    C = np.cumsum(w_sorted)
    member = np.array([np.isin(genes, list(s)) for s in gene_sets.values()])
    N_H = member.sum(axis=1)
    p_ = N_H / n
    A = np.cumsum(w_sorted[None, :] * member, axis=1)
    U = A - (p_[:, None]) * C[None, :]
    i_obs = np.argmax(np.abs(U), axis=1)
    ES_obs = U[np.arange(len(gene_sets)), i_obs] / np.sqrt(p_ * (1 - p_))
    rng2 = np.random.default_rng(seed)
    null = np.zeros((n_perm, len(gene_sets)))
    for pp in range(n_perm):
        perm = rng2.permutation(n)
        wp = w_sorted[perm]
        Cp = np.cumsum(wp)
        Ap = np.cumsum(wp[None, :] * member[:, perm], axis=1)
        Up = Ap - (p_[:, None]) * Cp[None, :]
        ip = np.argmax(np.abs(Up), axis=1)
        null[pp] = Up[np.arange(len(gene_sets)), ip] / np.sqrt(p_ * (1 - p_))
    rows = []
    for j, name in enumerate(gene_sets):
        ns = null[:, j]
        same = ns[np.sign(ns) == np.sign(ES_obs[j])]
        mean_same = same.mean() if same.size else 1.0
        nes = ES_obs[j] / mean_same if mean_same != 0 else ES_obs[j]
        fdr = float(np.mean(np.abs(ns) >= np.abs(nes)))
        rows.append((name, ES_obs[j], nes, fdr))
    return pd.DataFrame(rows, columns=["pathway", "ES", "NES", "FDR_q"]).sort_values("NES", key=abs, ascending=False).reset_index(drop=True)

# --- engine self-test (synthetic sanity check, NOT the answer) ---
tg = [f"g{i}" for i in range(200)]
tr = pd.Series(np.concatenate([np.linspace(2, 0.1, 50), np.linspace(-0.1, -2, 150)]), index=tg)
tsets = {"TRUE_PATHWAY": tg[:50], "NOISE_A": tg[100:130], "NOISE_B": tg[150:180]}
tres = gse_prerank_fallback(tr, tsets, n_perm=200, seed=1)
print("\nGSEA engine self-test (synthetic; TRUE_PATHWAY must rank first):")
print(tres.to_string(index=False))
assert tres.iloc[0]["pathway"] == "TRUE_PATHWAY", "GSEA engine self-test FAILED"
assert tres.iloc[0]["NES"] > 0, "TRUE_PATHWAY should be positively enriched"
print("GSEA engine self-test PASSED")

if gseapy_used:
    print("Running gseapy.prerank with KEGG_2019_Mouse ...")
else:
    print("\nKEGG_2019_Mouse gene sets NOT loadable in this runtime (no gseapy, no network, no local GMT).")
    print("GSEA against the real library CANNOT be executed here; ranking + engine saved for a networked runner.")
    print(f"Saved: /workspace/deseq2_results.csv, /workspace/gsea_ranking.csv ({len(ranking)} genes ranked).")
print(f"\nTotal runtime: {time.time()-t0:.1f}s")
