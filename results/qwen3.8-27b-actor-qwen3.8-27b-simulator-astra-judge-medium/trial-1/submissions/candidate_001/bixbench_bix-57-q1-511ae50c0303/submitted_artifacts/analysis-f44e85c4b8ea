#!/usr/bin/env python3
"""
BixBench bix-57-q1: percentage of gap characters relative to total alignment
positions across all alignments after aligning with MAFFT 'auto' (mafft --auto).

Design (approved):
  - 10 independent per-file MSAs via:  mafft --auto <file>.faa
  - gap character = '-' dash only
  - denominator = sum over files of (columns x nseqs)  [post-alignment positions]
  - percentage = (total '-' across all seqs in all alns) / (total positions) * 100
  - If mafft is absent at runtime, raise a clear error (NO silent fallback).
"""
import os, sys, glob, shutil, subprocess

DATA = "data"
OUT  = "out"

def check_mafft():
    p = shutil.which("mafft")
    if p is None:
        msg = ("MAFFT is not available: the 'mafft' executable was not found on PATH. "
               "This analysis REQUIRES 'mafft --auto' (no substitute aligner is permitted). "
               "Please provision MAFFT in the runtime before executing.")
        print("ERROR:", msg, file=sys.stderr)
        raise RuntimeError(msg)
    return p

def run_mafft(inpath, outpath):
    subprocess.run(["mafft", "--auto", inpath],
                   stdout=open(outpath, "w"),
                   check=True)

def parse_aln(path):
    seqs = []
    cur = None
    with open(path) as f:
        for line in f:
            line = line.rstrip("\n")
            if line.startswith(">"):
                if cur is not None:
                    seqs.append(cur)
                cur = ""
            elif line.strip() != "":
                cur += line.strip()
    if cur is not None:
        seqs.append(cur)
    return seqs

def main():
    check_mafft()
    os.makedirs(OUT, exist_ok=True)
    files = sorted(glob.glob(os.path.join(DATA, "*.faa")))
    if not files:
        raise SystemExit(f"No .faa files found in {DATA}/")

    total_gaps = 0
    total_positions = 0
    print(f"{'file':22s} {'nseq':>4s} {'cols':>5s} {'gaps':>6s} {'positions':>9s}")
    for faa in files:
        name = os.path.splitext(os.path.basename(faa))[0]
        aln = os.path.join(OUT, name + ".aln")
        run_mafft(faa, aln)
        seqs = parse_aln(aln)
        cols = {len(s) for s in seqs}
        if len(cols) != 1:
            raise RuntimeError(f"Alignment {aln} has inconsistent column lengths: {cols}")
        C = cols.pop()
        gaps = sum(s.count("-") for s in seqs)     # '-' only
        positions = C * len(seqs)
        total_gaps += gaps
        total_positions += positions
        print(f"{name:22s} {len(seqs):4d} {C:5d} {gaps:6d} {positions:9d}")

    pct = total_gaps / total_positions * 100.0
    print("-" * 58)
    print(f"TOTAL gaps={total_gaps}  positions={total_positions}")
    print(f"PERCENTAGE OF GAP CHARACTERS = {pct:.4f}%")
    print(f"  ({total_gaps} / {total_positions} * 100)")

if __name__ == "__main__":
    main()
