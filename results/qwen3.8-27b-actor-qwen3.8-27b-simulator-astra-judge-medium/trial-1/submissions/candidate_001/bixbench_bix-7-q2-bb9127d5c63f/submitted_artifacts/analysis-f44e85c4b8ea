"""
BixBench bix-7-q2: Average number of CHIP variants per sample
after filtering out intronic, intergenic, and UTR variants.

Filter set (SO terms to exclude):
  - intron_variant
  - intergenic_variant
  - 3_prime_UTR_variant
  - 5_prime_UTR_variant
  - 5_prime_UTR_premature_start_codon_gain_variant

Also exclude: Zygosity == 'Reference' or Zygosity is NaN.
All 86 per-sample files in CHIP_DP10_GQ20_PASS are in scope.
"""

import pandas as pd
import glob
import os

# Configuration
DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
SO_COL = 13  # 'Sequence Ontology (Combined)' under 'RefSeq Genes 110, NCBI'
ZYG_COL = 4  # 'Zygosity' under sample-specific group

# SO terms to filter out (intronic, intergenic, UTR variants)
FILTER_SO_TERMS = {
    "intron_variant",
    "intergenic_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}

# Zygosity values that represent actual variant calls
VARIANT_ZYGOSITY = {"Heterozygous", "Homozygous Variant"}

# Load all per-sample files
files = sorted(glob.glob(os.path.join(DATA_DIR, "*.xlsx")))
print(f"Total files found: {len(files)}")
assert len(files) == 86, f"Expected 86 files, found {len(files)}"

results = []

for f in files:
    sample_id = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    
    df = pd.read_excel(f, header=[0, 1])
    
    zyg = df.iloc[:, ZYG_COL]
    so = df.iloc[:, SO_COL]
    
    # Step 1: Keep only actual variant calls (exclude Reference and NaN)
    variant_mask = zyg.isin(VARIANT_ZYGOSITY)
    
    # Step 2: Exclude filtered SO terms
    so_mask = ~so.isin(FILTER_SO_TERMS)
    
    # Combined filter
    final_mask = variant_mask & so_mask
    
    count = int(final_mask.sum())
    results.append({"sample": sample_id, "variants_after_filter": count})

# Build results DataFrame
results_df = pd.DataFrame(results)
results_df = results_df.sort_values("sample").reset_index(drop=True)

# Compute summary statistics
mean_variants = results_df["variants_after_filter"].mean()
total_variants = results_df["variants_after_filter"].sum()

print(f"\n{'='*60}")
print(f"RESULTS: Average CHIP variants per sample (post-filter)")
print(f"{'='*60}")
print(f"Samples analyzed: {len(results_df)}")
print(f"Total variants (post-filter): {total_variants}")
print(f"Mean variants per sample: {mean_variants:.4f}")
print(f"Min: {results_df['variants_after_filter'].min()}")
print(f"Max: {results_df['variants_after_filter'].max()}")
print(f"Median: {results_df['variants_after_filter'].median()}")
print(f"Std: {results_df['variants_after_filter'].std():.2f}")
print(f"\n{'='*60}")
print("PER-SAMPLE BREAKDOWN:")
print(f"{'='*60}")
for _, row in results_df.iterrows():
    print(f"  {row['sample']:20s} : {row['variants_after_filter']}")

print(f"\n{'='*60}")
print(f"FINAL ANSWER: {mean_variants:.4f}")
print(f"{'='*60}")

# Save per-sample breakdown
results_df.to_csv("per_sample_variant_counts.csv", index=False)
print(f"\nPer-sample breakdown saved to: per_sample_variant_counts.csv")
