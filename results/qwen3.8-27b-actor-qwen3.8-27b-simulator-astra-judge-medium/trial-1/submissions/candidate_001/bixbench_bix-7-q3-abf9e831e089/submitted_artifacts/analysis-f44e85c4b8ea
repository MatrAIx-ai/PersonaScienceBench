"""
BixBench bix-7-q3: How many CHIP variants remain after removing reference calls?

Definition (approved):
  * Per-sample genotype = the "Zygosity" column (col index 4, data starts row 3).
  * A "reference call" == Zygosity == 'Reference' (homozygous reference).
  * Variant identity key = (Chr:Pos, Ref/Alt) = (col 0, col 1).
  * A variant is REMOVED only if EVERY one of its per-sample Zygosity values is
    'Reference'. Blank/untyped does NOT count as a reference call, so a variant
    with any non-'Reference' value (Heterozygous / Homozygous Variant / blank)
    in any sample REMAINS.
  * In_CHIP == 'True' for every data row, so every row is a CHIP variant
    (no gene-list join needed).

Report: distinct CHIP variants that remain.
"""
import pandas as pd
import glob, os
from collections import defaultdict

files = sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx'))
assert len(files) == 86, f"expected 86 sample files, found {len(files)}"

total_rows = 0
total_reference = 0
total_het = 0
total_homvar = 0
total_blank = 0
total_inchip_true = 0

# variant key -> list of zygosity values (across all sample files it appears in)
zygo_by_variant = defaultdict(list)

for path in files:
    df = pd.read_excel(path, header=None, engine='openpyxl')
    d = df.iloc[2:]                       # drop the 2 header rows
    for _, r in d.iterrows():
        total_rows += 1
        if str(r[29]) == 'True':
            total_inchip_true += 1
        z = r[4]
        key = (str(r[0]), str(r[1]))
        if pd.isna(z):
            total_blank += 1
            zygo_by_variant[key].append(None)   # untyped
        else:
            zv = str(z)
            zygo_by_variant[key].append(zv)
            if zv == 'Reference':
                total_reference += 1
            elif zv == 'Heterozygous':
                total_het += 1
            elif zv == 'Homozygous Variant':
                total_homvar += 1
            else:
                raise ValueError(f"unexpected zygosity value: {zv!r}")

union_size = len(zygo_by_variant)

removed = 0
remaining = 0
removed_keys = []
for key, vals in zygo_by_variant.items():
    # removed ONLY if every per-sample call is exactly 'Reference'
    if all(v == 'Reference' for v in vals):
        removed += 1
        removed_keys.append(key)
    else:
        remaining += 1

print("=== CHIP variant count (distinct variants, reference calls removed) ===")
print(f"Sample files processed          : {len(files)}")
print(f"Total data rows (all samples)   : {total_rows}")
print(f"  In_CHIP == True rows          : {total_inchip_true}  (all rows are CHIP variants)")
print(f"Total Zygosity calls            :")
print(f"  Reference                     : {total_reference}")
print(f"  Heterozygous                  : {total_het}")
print(f"  Homozygous Variant            : {total_homvar}")
print(f"  blank / untyped               : {total_blank}")
print(f"Distinct CHIP variants (union)  : {union_size}")
print(f"Variants REMOVED (all-Reference): {removed}")
print(f"")
print(f"ANSWER: {remaining} CHIP variants remain after removing reference calls.")

# sanity: removed + remaining == union
assert removed + remaining == union_size
