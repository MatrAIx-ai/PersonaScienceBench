"""Independence test: m6A methylation status vs differential expression status
(bladder cancer dataset, MeRIP_RNA_result.xlsx, row-level, n=12,754)."""
import pandas as pd
from scipy.stats import chi2_contingency

# Load data (single sheet 'Date Formatting'; 1 header row; no missing values)
df = pd.read_excel("data/MeRIP_RNA_result.xlsx", sheet_name="Date Formatting")
df.columns = ["GeneID", "m_log2FC", "m_pvalue", "g_log2FC", "g_pvalue",
              "m6A", "DEG", "m6A_DEG", "GeneID_right", "gene_id",
              "gene_name", "Annotation", "Class"]

# 3x3 contingency table: m6A status (rows) x DEG status (columns)
ct = pd.crosstab(df["m6A"], df["DEG"])
ct = ct.reindex(index=["m6A Hyper", "m6A Hypo", "m6A no sig"],
                columns=["Up", "Down", "no-DEGs"])
print("Contingency table (m6A x DEG), n =", ct.values.sum())
print(ct)

# Chi-square test of independence (min expected count = 16.63 > 5, so valid)
chi2, p, dof, expected = chi2_contingency(ct)
print(f"\nchi2 = {chi2:.4f}, dof = {dof}")
print(f"min expected cell count = {expected.min():.2f}")
print(f"p-value = {p:.6e}  (scientific notation: {p:.3e})")
