#!/usr/bin/env python
"""
BixBench bix-9-q5: In which tissue type do bad responders show the highest number
of significantly differentially expressed (lfc>0.5 and basemean>10) genes
compared to controls?

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx, sheet 'NormCount'.
Bad-vs-Control DESeq blocks (empirically identified by sign-agreement of
log2FoldChange vs group means from the per-sample count columns):
  Comparison 2 (0-based cols 107-115): baseline_blood  bad_responder vs Control
  Comparison 5 (0-based cols 134-142): dentate_gyrus   bad_responder vs Control
  Comparison 8 (0-based cols 161-169): final_blood     bad_responder vs Control
Group A = bad_responder, B = Control, so log2FoldChange = log2(bad/control);
lfc > 0.5 => up-regulated in bad responders.
"""
import openpyxl
import numpy as np
import pandas as pd

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# ---- Parse NormCount (header at 1-based row 4; gene rows from row 5) ----
wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb["NormCount"]
it = ws.iter_rows(values_only=True)
for _ in range(4):  # skip 3 label rows + header row
    next(it)
data = [r for r in it]
print(f"Parsed {len(data)} gene rows x {len(data[0])} columns")

def num(arr):
    out = np.empty(len(arr))
    for i, v in enumerate(arr):
        try:
            out[i] = float(v)
        except (TypeError, ValueError):
            out[i] = np.nan
    return out

A = np.array(data, dtype=object)
gene_id = A[:, 1]
index_col = A[:, 0]
print(f"Unique GeneIDs: {len(set(gene_id))}; Index range: {min(index_col)}..{max(index_col)}")

# ---- Bad-vs-Control DESeq blocks: base col (0-based), 9 cols each ----
blocks = {
    "baseline_blood": 107,  # DESeq Comparison 2
    "dentate_gyrus": 134,   # DESeq Comparison 5
    "final_blood": 161,     # DESeq Comparison 8
}

rows = []
for tissue, base in blocks.items():
    baseMean = num(A[:, base + 0])
    baseMeanA = num(A[:, base + 1])
    baseMeanB = num(A[:, base + 2])
    lfc = num(A[:, base + 4])
    pval = num(A[:, base + 5])
    padj = num(A[:, base + 6])
    n_na = int(np.isnan(lfc).sum())

    # Direction sanity check: A should be the bad_responder group
    direction_ok = np.nanmean(baseMeanA - baseMeanB)  # sign only indicative
    primary = (lfc > 0.5) & (baseMean > 10)                 # up-regulated in bad responders
    primary_padj = primary & (padj < 0.05)                  # + DESeq significance
    both_dirs = (np.abs(lfc) > 0.5) & (baseMean > 10)       # |lfc|>0.5, both directions
    both_padj = both_dirs & (padj < 0.05)
    down_only = (lfc < -0.5) & (baseMean > 10)

    rows.append({
        "tissue": tissue,
        "n_genes": len(lfc),
        "n_lfc_NA": n_na,
        "mean_baseMeanA(bad)": float(np.nanmean(baseMeanA)),
        "mean_baseMeanB(control)": float(np.nanmean(baseMeanB)),
        "PRIMARY lfc>0.5 & basemean>10": int(primary.sum()),
        "PRIMARY + padj<0.05": int(primary_padj.sum()),
        "|lfc|>0.5 & basemean>10": int(both_dirs.sum()),
        "|lfc|>0.5 & basemean>10 + padj<0.05": int(both_padj.sum()),
        "lfc<-0.5 & basemean>10 (down, ref)": int(down_only.sum()),
    })
    # example genes for the primary set
    ex = gene_id[primary][:5]
    print(f"[{tissue}] example primary genes: {list(ex)}")

res = pd.DataFrame(rows).set_index("tissue")
pd.set_option("display.width", 200)
print("\n=== Per-tissue counts (bad responder vs Control) ===")
print(res.to_string())

primary = res["PRIMARY lfc>0.5 & basemean>10"]
winner = primary.idxmax()
print(f"\nPRIMARY CRITERION (lfc>0.5 & basemean>10): "
      + ", ".join(f"{t}={v}" for t, v in primary.items()))
print(f"HIGHEST tissue: {winner} ({primary[winner]} genes)")

sens = res["PRIMARY + padj<0.05"]
print(f"Sensitivity (primary + padj<0.05): "
      + ", ".join(f"{t}={v}" for t, v in sens.items())
      + f" -> highest: {sens.idxmax()}")
bd = res["|lfc|>0.5 & basemean>10"]
print(f"Both directions (|lfc|>0.5 & basemean>10): "
      + ", ".join(f"{t}={v}" for t, v in bd.items())
      + f" -> highest: {bd.idxmax()}")

res.to_csv("output/per_tissue_deg_counts.csv")
print("\nSaved output/per_tissue_deg_counts.csv")
