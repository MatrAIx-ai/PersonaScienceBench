"""
DiscoveryBench: In which century did 'Diversity in Pottery Form' collapse and
'Diversity in Pottery Decoration' increase simultaneously?

Method (approved):
  1) Use RAW 100-year bins from time_series_data.csv (PotteryForm / PotteryDecoration);
     cross-check against capital.csv (ZKeform / Zkeverz).
  2) Per-bin delta: dForm = Form[t]-Form[t-1], dDec = Dec[t]-Dec[t-1].
  3) Simultaneous sign check: a bin qualifies if dForm<0 AND dDec>0 (same bin);
     score = (-dForm)+dDec; pick the max.
  4) Cross-check with _inter (annual linear interpolation) to localize the transition.
  5) Map the winning bin to a century using the STRICT/HISTORICAL convention:
     century_BCE = ceil(Y_BCE / 100)  (17th c. BCE = 1700..1601 BCE).
"""
import math
import pandas as pd, numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 50)

# ---- Load ----
ts   = pd.read_csv('data/time_series_data.csv', index_col=0)
cap  = pd.read_csv('data/capital.csv')
# capital.csv uses decimal commas -> parse to float
for c in ['ZKeform','Zkeverz']:
    cap[c] = cap[c].astype(str).str.replace(',', '.', regex=False).astype(float)

# ---- Raw 100-yr bins (time_series) ----
raw = ts[ts['PotteryForm'].notna()][['CE','PotteryForm','PotteryDecoration']].copy()
raw = raw.sort_values('CE').reset_index(drop=True)      # -4100 .. -500 (chronological)
raw['BCE'] = -raw['CE']
raw['dForm'] = raw['PotteryForm'].diff()
raw['dDec']  = raw['PotteryDecoration'].diff()

# ---- Cross-check against capital.csv ----
chk = raw.merge(cap[['BCE','ZKeform','Zkeverz']], on='BCE', how='inner')
chk['form_ok']  = np.isclose(chk['PotteryForm'], chk['ZKeform'], atol=1e-6)
chk['dec_ok']   = np.isclose(chk['PotteryDecoration'], chk['Zkeverz'], atol=1e-6)
print(f"[cross-check] raw(time_series) vs capital.csv: "
      f"{chk['form_ok'].sum()}/{len(chk)} Form match, {chk['dec_ok'].sum()}/{len(chk)} Decoration match")

# ---- Per-bin delta table ----
cols = ['BCE','PotteryForm','dForm','PotteryDecoration','dDec']
print("\n=== 100-yr bin raw values and per-bin deltas (BCE) ===")
print(raw[cols].to_string(index=False))

# ---- Simultaneous sign check: Form collapse + Decoration increase in same bin ----
sim = raw[(raw['dForm']<0)&(raw['dDec']>0)].copy()
sim['score'] = (-sim['dForm']) + (sim['dDec'])
best = sim.loc[sim['score'].idxmax()]
print("\n=== Bins where Form DECREASES and Decoration INCREASES (same bin) ===")
print(sim[cols+['score']].to_string(index=False))

# ---- _inter localization cross-check ----
it = ts[['CE','PotteryForm_inter','PotteryDecoration_inter']].copy()
it['BCE'] = -it['CE']
win = it[(it['BCE']<=1800)&(it['BCE']>=1700)].sort_values('BCE')
print("\n=== _inter localization, 1800..1700 BCE (every 20y) ===")
for b in range(1800,1699,-20):
    r = win[win['BCE']==b].iloc[0]
    print(f"  BCE={b}  Form_inter={r['PotteryForm_inter']:.3f}  Dec_inter={r['PotteryDecoration_inter']:.3f}")

# ---- Century mapping (strict/historical) ----
def century_bce(y): return math.ceil(y/100.0)
winBCE = int(best['BCE'])
cent   = century_bce(winBCE)
print(f"\n=== RESULT ===")
print(f"Winning bin: BCE={winBCE}  (Form {best['PotteryForm']-best['dForm']:.2f} -> {best['PotteryForm']:.2f}, "
      f"dForm={best['dForm']:.2f};  Dec {best['PotteryDecoration']-best['dDec']:.2f} -> {best['PotteryDecoration']:.2f}, "
      f"dDec={best['dDec']:.2f})")
print(f"Strict/historical century: ceil({winBCE}/100) = {cent}  ->  {cent}th century BCE")
