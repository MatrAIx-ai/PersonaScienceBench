"""
Highest-growth phase analysis, 2000-1100 BCE.
Primary growth indicator: pollen_grate_100 (study-defined growth rate of the
100-year-smoothed Belau/Woserin pollen openness score, Belau_PC1).
Corroboration: capital.csv per-century Z-levels (summed across indicators).
"""
import pandas as pd, numpy as np

pd.set_option("display.width", 140)

# ---------- Load ----------
ts  = pd.read_csv("data/time_series_data.csv", index_col=0).sort_values("CE")
pol = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv",
                  index_col=0, decimal=",", thousands=".")
cap = pd.read_csv("data/capital.csv", decimal=",", thousands=".")

print("="*70)
print("1) DATASET OVERVIEW")
print("="*70)
print(f"time_series rows : {len(ts):5d}  | CE {ts.CE.min():.0f}..{ts.CE.max():.0f} | calBP {ts.calBP.min():.0f}..{ts.calBP.max():.0f}")
print(f"pollen rows      : {len(pol):5d}  | CE {pol.CE.min():.0f}..{pol.CE.max():.0f} | calBP {pol.calBP.min():.0f}..{pol.calBP.max():.0f}")
print(f"capital rows     : {len(cap):5d}  | BCE {cap.BCE.min():.0f}..{cap.BCE.max():.0f}")

# ---------- Window 2000-1100 BCE ----------
w = ts[(ts.CE <= -1100) & (ts.CE >= -2000)].copy()
w["BCE"] = -w.CE
print("\n"+"="*70)
print("2) WINDOW 2000-1100 BCE  (CE -2000..-1100 inclusive)")
print("="*70)
print(f"time_series rows in window : {len(w)}")
print(f"pollen rows in window      : {len(pol[(pol.CE<=-1100)&(pol.CE>=-2000)])}")
zcols = [c for c in cap.columns if c.startswith("Z")]
cw = cap[(cap.BCE <= 2000) & (cap.BCE >= 1100)].copy()
print(f"capital rows in window     : {len(cw)}")
print(f"NaN in window -> pollen_grate_100:{w.pollen_grate_100.isna().sum()}, "
      f"pollen_inter_100:{w.pollen_inter_100.isna().sum()}, "
      f"capital Z (all 12):{int(cw[zcols].isna().sum().sum())}")

# ---------- Growth signal ----------
g = w["pollen_grate_100"]
peak = w.loc[g.idxmax()]
print("\n"+"="*70)
print("3) GROWTH SIGNAL (pollen_grate_100) IN WINDOW")
print("="*70)
print(f"mean={g.mean():.6f}  std={g.std():.6f}  min={g.min():.6f}  max={g.max():.6f}")
print(f"\nPEAK single-year growth : CE {peak.CE:.0f}  (BCE {-peak.CE:.0f}),  "
      f"pollen_grate_100 = {peak.pollen_grate_100:.6f}")

# Century aggregation (BCE century bin, 9 clean centuries 1900s..1100s)
w["century"] = (w.BCE // 100) * 100
agg = w.groupby("century")["pollen_grate_100"].agg(["mean", "max", "count"])
agg = agg[agg["count"] > 1]  # drop degenerate 1-row '2000s' edge bin
agg = agg.sort_index(ascending=False)
print("\nCentury (BCE) aggregation of pollen_grate_100:")
print(agg.round(6).to_string())
top_c = agg["mean"].idxmax()
print(f"\nHighest century-mean growth : {top_c}s BCE  (mean {agg.loc[top_c,'mean']:.6f})")

# Longest contiguous positive-growth run
runs = []; cur = []
for ce, v in zip(w.CE, g):
    if v > 0:
        cur.append(ce)
    else:
        if cur: runs.append((cur[0], cur[-1], len(cur))); cur = []
if cur: runs.append((cur[0], cur[-1], len(cur)))
runs.sort(key=lambda r: -r[2])
print("\nLongest contiguous positive-growth runs (CE start, CE end, len):")
for r in runs[:3]:
    print(f"   CE {r[0]:.0f}..{r[1]:.0f}  =  BCE {-r[0]:.0f}..{-r[1]:.0f}  ({r[2]} yrs)")

# Overall openness trend (context: growth is a local upswing in a declining index)
print("\nOverall smoothed openness (pollen_inter_100) trend in window:")
print(f"   at 2000 BCE: {w.iloc[0].pollen_inter_100:.4f}   ->   at 1100 BCE: {w.iloc[-1].pollen_inter_100:.4f}")
print(f"   (net change {w.iloc[-1].pollen_inter_100 - w.iloc[0].pollen_inter_100:+.4f} -> long-term DECLINE; growth phase = local upswing)")

# ---------- Capital corroboration ----------
cw["Zsum"] = cw[zcols].sum(axis=1)
print("\n"+"="*70)
print("4) CAPITAL Z-SUM CORROBORATION (sum of 12 Z indicators, per century)")
print("="*70)
print(cw[["BCE", "Zsum"]].sort_values("BCE", ascending=False).round(2).to_string(index=False))
zc = cw.loc[cw.Zsum.idxmax(), "BCE"]
print(f"\nCapital Z-sum peaks at BCE {zc:.0f}  ({cw.Zsum.max():.2f})  -> corroborates the 1400s BCE growth peak")
