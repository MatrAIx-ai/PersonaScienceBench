"""
PCA on forms of capital (12 Z-scored variables) in 100-year time slices.
Data: data/capital.csv (39 rows, BCE 4300..500, step 100; values pre-standardized).
Windows: MN = bins 3400-3300..3100-3000 (rows 3400,3300,3200,3100)
         YN = bins 2900-2800..2400-2300 (rows 2900,2800,2700,2600,2500,2400)
"""
import pandas as pd, numpy as np

# ---------- load ----------
cap = pd.read_csv('data/capital.csv')
Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
     'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
df = pd.DataFrame({'BCE': cap['BCE'].values})
for c in Z:
    df[c] = pd.to_numeric(cap[c].astype(str).str.replace(',','.'), errors='coerce')
df = df.sort_values('BCE', ascending=False).reset_index(drop=True)  # 4300 -> 500
assert df[Z].isna().sum().sum() == 0

def pca(X):
    """Full SVD PCA on centered X. Returns scores, explained-var ratio, loadings (eigenvectors)."""
    Xc = X - X.mean(axis=0)
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    evr = S**2 / (S**2).sum()
    # fix sign first: largest |loading| of each component positive
    for k in range(Vt.shape[0]):
        j = np.argmax(np.abs(Vt[k]))
        if Vt[k, j] < 0:
            Vt[k] *= -1; U[:, k] *= -1
    scores = U * S  # = Xc @ Vt.T (computed AFTER sign fix)
    assert np.allclose(scores, Xc @ Vt.T), "score/loading sign inconsistency"
    return scores, evr, Vt

X = df[Z].values
scores, evr, Vt = pca(X)
df['PC1'] = scores[:, 0]
df['PC2'] = scores[:, 1]

print("=" * 78)
print("MAIN PCA: 39 time-slices x 12 pre-standardized capital variables")
print("=" * 78)
print(f"PC1 explained variance: {evr[0]*100:.2f}%   (PC2: {evr[1]*100:.2f}%)")
print("\nPC1 loadings (sign fixed: largest |loading| > 0):")
load = pd.DataFrame({'var': Z, 'PC1': Vt[0], 'PC2': Vt[1]}).sort_values('PC1', ascending=False)
print(load.to_string(index=False, float_format=lambda v: f"{v:+.3f}"))

MN = [3400, 3300, 3200, 3100]
YN = [2900, 2800, 2700, 2600, 2500, 2400]
sub = df[df['BCE'].isin(MN + YN)][['BCE'] + Z + ['PC1']].copy()
sub['window'] = np.where(sub['BCE'].isin(MN), 'MN', 'YN')
print("\nPC1 score trajectory (MN then YN) + raw Z values:")
print(sub.to_string(index=False, float_format=lambda v: f"{v: .2f}"))

mn_s = df.loc[df['BCE'].isin(MN), 'PC1'].values
yn_s = df.loc[df['BCE'].isin(YN), 'PC1'].values
print(f"\nMN PC1: start(3400-3300)={mn_s[0]:+.3f} end(3100-3000)={mn_s[-1]:+.3f} delta={mn_s[-1]-mn_s[0]:+.3f}")
for a, b in zip(mn_s[:-1], mn_s[1:]):
    print(f"   step {b:+.3f}-{a:+.3f} = {b-a:+.3f}")
print(f"YN PC1: start(2900-2800)={yn_s[0]:+.3f} end(2400-2300)={yn_s[-1]:+.3f} delta={yn_s[-1]-yn_s[0]:+.3f}")
for a, b in zip(yn_s[:-1], yn_s[1:]):
    print(f"   step {b:+.3f}-{a:+.3f} = {b-a:+.3f}")
print(f"\nFull-series PC1 range: min={df['PC1'].min():+.3f} max={df['PC1'].max():+.3f}")
print("Full-series PC1 by period (mean):")
dfp = df.merge(cap[['BCE', 'group']], on='BCE')
print(dfp.groupby('group')['PC1'].agg(['count', 'mean', 'min', 'max']).round(3).to_string())

# ---------- robustness 1: within-window re-standardization ----------
print("\n" + "=" * 78)
print("ROBUSTNESS A: PCA re-standardized WITHIN each window")
print("=" * 78)
for name, rows in [('MN', MN), ('YN', YN)]:
    W = df.loc[df['BCE'].isin(rows), Z].values
    mu, sd = W.mean(0), W.std(0, ddof=0)
    const = sd < 1e-12
    Ws = np.zeros_like(W)
    Ws[:, ~const] = (W[:, ~const] - mu[~const]) / sd[~const]
    s, e, V = pca(Ws)
    print(f"\n{name} (n={len(rows)} slices): PC1 EVR={e[0]*100:.1f}%"
          + (f"  [constant-in-window, dropped: {', '.join(Z[c] for c in np.where(const)[0])}]" if const.any() else ""))
    ld = pd.Series(V[0], index=Z).sort_values(ascending=False)
    print("  PC1 loadings:", ", ".join(f"{k} {v:+.2f}" for k, v in ld.items()))
    print("  PC1 scores by bin:", ", ".join(f"{r}:{v:+.2f}" for r, v in zip(rows, s[:, 0])))

# ---------- robustness 2: per capital-type PCAs (39 slices, global Z) ----------
print("\n" + "=" * 78)
print("ROBUSTNESS B: per-type PCAs (39 slices, approved mapping)")
print("=" * 78)
types = {'Symbolic': ['ZAxtSchwert', 'ZDolch', 'Zhausgr'],
         'Social': ['ZCU_AU', 'Zamber', 'ZMonument'],
         'Cultural': ['ZKeform', 'Zkeverz'],
         'Economic': ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']}
for tname, vars_ in types.items():
    s, e, V = pca(df[vars_].values)
    df[f'PC1_{tname}'] = s[:, 0]
    mn = df.loc[df['BCE'].isin(MN), f'PC1_{tname}'].values
    yn = df.loc[df['BCE'].isin(YN), f'PC1_{tname}'].values
    ld = pd.Series(V[0], index=vars_).sort_values(ascending=False)
    print(f"\n{tname} ({len(vars_)} vars): PC1 EVR={e[0]*100:.1f}%")
    print("  loadings:", ", ".join(f"{k} {v:+.2f}" for k, v in ld.items()))
    print(f"  MN scores: " + ", ".join(f"{r}:{v:+.2f}" for r, v in zip(MN, mn)))
    print(f"  YN scores: " + ", ".join(f"{r}:{v:+.2f}" for r, v in zip(YN, yn)))
    print(f"  MN delta {mn[-1]-mn[0]:+.2f}, YN delta {yn[-1]-yn[0]:+.2f}")

# ---------- save artifacts ----------
out = df[['BCE'] + Z + ['PC1', 'PC2'] + [f'PC1_{t}' for t in types]]
out.to_csv('pca_scores_table.csv', index=False, float_format='%.4f')
load.to_csv('pca1_loadings.csv', index=False, float_format='%.4f')
print("\nSaved: pca_scores_table.csv, pca1_loadings.csv")
