import pandas as pd, numpy as np

df = pd.read_csv('data/capital.csv', decimal=',')
zcols = [c for c in df.columns if c.startswith('Z')]  # 12 cols
df = df.drop(columns=['group', 'color'])
yba = df[(df.BCE >= 500) & (df.BCE <= 1100)].sort_values('BCE', ascending=False).reset_index(drop=True)
print('YBA slices:', yba.BCE.tolist())

def pca_scores(X, k=1):
    Xc = X.values - X.values.mean(axis=0)
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    evr = (S**2) / (S**2).sum()
    comps = Vt[:k]
    scores = Xc @ comps.T
    return comps, evr, scores

def run(X, bce, name):
    comps, evr, sc = pca_scores(X)
    scores = pd.DataFrame(sc, columns=['PC1'], index=bce)
    scores['PC1'] = scores['PC1'] / np.sqrt(len(X) - 1)  # standardised scores (like sklearn)
    print(f'\n=== {name} ===')
    print('explained variance ratio (top 4):', np.round(evr[:4], 4))
    l = pd.Series(comps[0], index=X.columns).sort_values(key=abs, ascending=False)
    print('PC1 loadings (abs>0.3):', {k: round(v,3) for k,v in l[abs(l)>0.3].items()})
    print('PC1 scores by slice:', {int(i): round(v,4) for i,v in scores['PC1'].items()})
    s1100 = scores.loc[1100,'PC1']; rest = scores.loc[1000:500,'PC1']
    print(f'PC1(1100)={s1100:.4f} | 1000-500: min={rest.min():.4f}, max={rest.max():.4f}, mean={rest.mean():.4f}, std={rest.std():.4f}')
    print(f'diff 1100 - mean(1000-500) = {s1100 - rest.mean():.4f}')
    return scores

s_main  = run(yba[zcols], yba.BCE.values, 'Main: pooled YBA window, 12 Z vars, pre-Z-scored as-is')
full = df.sort_values('BCE', ascending=False).reset_index(drop=True)
s_full  = run(full[zcols], full.BCE.values, 'Robustness: full 39-row fit, 12 Z vars')
s_drop  = run(yba[[c for c in zcols if c not in ('ZSichel','ZKeform')]], yba.BCE.values, 'Robustness: pooled YBA, 10 Z vars (ZSichel/ZKeform dropped)')

# Reporting convention: flip sign so 1100 is the positive extreme
for name, s in [('main', s_main), ('full', s_full), ('dropped', s_drop)]:
    if s.loc[1100,'PC1'] < s.loc[1000:500,'PC1'].max():
        s['PC1'] = -s['PC1']
        print(f'note: {name} PC1 sign flipped for reporting (1100 made positive)')
        if name == 'main':
            print('FINAL main scores (reporting sign):', {int(b): round(v,4) for b,v in s['PC1'].items()})
