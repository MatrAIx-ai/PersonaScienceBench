import pandas as pd, numpy as np

cap = pd.read_csv('data/capital.csv', thousands='.', decimal=',')
zc = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
names = {'ZAxtSchwert':'Hatchet/Sword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'Copper/Gold','Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle','ZBeil':'Axes/Celts','ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecor'}
t = -cap.BCE.values  # CE, ascending
X = cap[zc].values
print("raw stds:", np.round(X.std(axis=0, ddof=1),3))
Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)  # center+scale -> correlation-matrix PCA
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
# svd_flip convention: for each component, flip sign so the loading with the largest abs value is positive
for k in range(Vt.shape[0]):
    jmax = np.argmax(np.abs(Vt[k]))
    if Vt[k, jmax] < 0:
        U[:, k] *= -1; Vt[k] *= -1

ev = S**2/(Xs.shape[0]-1)
evr = ev/ev.sum()
print("\neigenvalues:", np.round(ev,3))
print("explained var ratio:", np.round(evr,3), "cum:", np.round(np.cumsum(evr),3))
print("Kaiser>1 count:", int((ev>1).sum()))

sym = ['ZAxtSchwert','ZDolch','Zhausgr']
idx = [zc.index(s) for s in sym]
print("\n--- loading table (all vars, PC1-PC4) ---")
tab = pd.DataFrame(Vt[:4].T, index=[names[c] for c in zc], columns=['PC1','PC2','PC3','PC4'])
print(tab.round(3).to_string())

print("\n--- symbolic vars focus ---")
for i,(s) in enumerate(sym):
    j = idx[i]
    print(f"{names[s]:>14s}: PC1={Vt[0,j]:+.3f}  PC2={Vt[1,j]:+.3f}  PC3={Vt[2,j]:+.3f}  PC4={Vt[3,j]:+.3f}")
p1 = Vt[0,idx]; p2 = Vt[1,idx]
print(f"\nPC1 loadings: mean={p1.mean():+.3f} min={p1.min():+.3f} max={p1.max():+.3f} range={p1.max()-p1.min():.3f} var={p1.var(ddof=1):.4f}")
print(f"PC2 loadings: mean={p2.mean():+.3f} min={p2.min():+.3f} max={p2.max():+.3f} range={p2.max()-p2.min():.3f} var={p2.var(ddof=1):.4f}")
# pairwise distances in loading space
print("pairwise |dPC1|:", {f"{names[sym[a]]}-{names[sym[b]]}": round(abs(p1[a]-p1[b]),3) for a in range(3) for b in range(a+1,3)})
print("pairwise |dPC2|:", {f"{names[sym[a]]}-{names[sym[b]]}": round(abs(p2[a]-p2[b]),3) for a in range(3) for b in range(a+1,3)})

# scores time profile
scores = Xs @ Vt[:2].T
print("\nPC1 score range: %.3f to %.3f" % (scores[:,0].min(), scores[:,0].max()))
print("PC2 score range: %.3f to %.3f" % (scores[:,1].min(), scores[:,1].max()))
# correlation of each symbolic var with PC1/PC2 scores (== loading since standardized)
df = pd.DataFrame(scores, columns=['PC1s','PC2s'])
df['CE']=t
for s in sym:
    print(f"corr({s}, PC1s)={np.corrcoef(X[:,zc.index(s)],df.PC1s)[0,1]:+.3f}  corr({s}, PC2s)={np.corrcoef(X[:,zc.index(s)],df.PC2s)[0,1]:+.3f}")
# when are symbolic vars high?
print("\nSlices with top-5 PC1 scores:")
top = df.assign(r=df.PC1s.rank(ascending=False)).nlargest(5,'r')[['CE','PC1s','PC2s']]
print(top.to_string(index=False))
print("\nSlices with bottom-5 PC1 scores:")
bot = df.assign(r=df.PC1s.rank()).nlargest(5,'r')[['CE','PC1s','PC2s']]
print(bot.to_string(index=False))
# symbolic vars' own temporal peaks
for s in sym:
    svals = X[:,zc.index(s)]
    hi = t[np.argsort(svals)[-3:]]
    print(f"{names[s]}: top-3 slices at CE {sorted(hi.tolist())} (vals {np.sort(svals)[-3:]})")
