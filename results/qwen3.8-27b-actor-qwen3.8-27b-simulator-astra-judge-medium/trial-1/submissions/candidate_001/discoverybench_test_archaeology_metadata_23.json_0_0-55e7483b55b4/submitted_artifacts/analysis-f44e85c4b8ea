"""
Co-variation of monument count (social capital) and axes/celts (economic capital)
with symbolic-capital indicators (hatchet-sword, dagger, house size),
3400-3000 BCE, 100-year binned Z-score series.
"""
import pandas as pd
import numpy as np

# --- Load ---
ts = pd.read_csv('/workspace/data/time_series_data.csv', index_col=0)
cap = pd.read_csv('/workspace/data/capital.csv')
# capital.csv uses quoted German comma decimals
for c in cap.columns:
    if not pd.api.types.is_numeric_dtype(cap[c]) and c not in ('group', 'color'):
        cap[c] = cap[c].astype(str).str.replace(',', '.', regex=False).astype(float)

# --- Window: 3400-3000 BCE inclusive (5 100-yr bins) ---
w_ts = ts[(ts['CE'] >= -3400) & (ts['CE'] <= -3000) & ts['MonumentCount'].notna()].copy().reset_index(drop=True)
w_ts['year_BCE'] = -w_ts['CE'].astype(int)
cols = ['MonumentCount', 'AxesCelts', 'HatchetSword', 'Dagger', 'HouseSize']
w = w_ts[['year_BCE'] + cols]

w_cap = cap[(cap['BCE'] <= 3400) & (cap['BCE'] >= 3000)].sort_values('BCE')
w_cap = w_cap.rename(columns={'ZMonument': 'MonumentCount', 'ZBeil': 'AxesCelts',
                              'ZAxtSchwert': 'HatchetSword', 'ZDolch': 'Dagger',
                              'Zhausgr': 'HouseSize'})[['BCE'] + cols]
# cross-file agreement check
w_cap2 = w_cap.rename(columns={'BCE': 'year_BCE'})
merged = w.merge(w_cap2, on='year_BCE', suffixes=('_ts', '_cap'))
max_diff = max(abs(merged[f'{c}_ts'] - merged[f'{c}_cap']).max() for c in cols)
print(f"Cross-file agreement (max abs diff over 5 points x 5 vars): {max_diff:.2e}")
print("\nWindow data (Z-scores, 100-yr bins):")
print(w.to_string(index=False))

# --- Primary: pairwise correlations, n=5 ---
X = w[cols]
print("\nPearson correlation matrix (n=5):")
print(X.corr().round(3).to_string())
print("\nSpearman correlation matrix (n=5):")
print(X.corr(method='spearman').round(3).to_string())

# --- Lag-1 (100-yr) difference correlations, n=4 ---
d = X.diff().dropna()
print("\nLag-1 (100-yr change) Pearson correlation matrix (n=4):")
print(d.corr().round(3).to_string())

# --- Within-window variability ---
print("\nWithin-window std (signal check):")
print(X.std().round(4).to_string())

# --- Trajectory description ---
print("\nTrajectory notes:")
for c in cols:
    s = X[c]
    pk = s.idxmax()
    print(f"  {c:13s}: {list(s.round(2))} | peak {s.max():.2f} at {w.loc[pk,'year_BCE']} BCE")

# --- One-line robustness: wider 3600-2800 BCE context ---
tw = ts[(ts['CE'] >= -3600) & (ts['CE'] >= -3600) & (ts['CE'] <= -2800) & ts['MonumentCount'].notna()][cols]
tw = ts[(ts['CE'] <= -2800) & (ts['CE'] >= -3600) & ts['MonumentCount'].notna()][cols]
print("\nRobustness (3600-2800 BCE, n=%d): Mon-Axes r=%.2f, Mon-House r=%.2f, Axes-House r=%.2f"
      % (len(tw), tw['MonumentCount'].corr(tw['AxesCelts']),
         tw['MonumentCount'].corr(tw['HouseSize']), tw['AxesCelts'].corr(tw['HouseSize'])))
