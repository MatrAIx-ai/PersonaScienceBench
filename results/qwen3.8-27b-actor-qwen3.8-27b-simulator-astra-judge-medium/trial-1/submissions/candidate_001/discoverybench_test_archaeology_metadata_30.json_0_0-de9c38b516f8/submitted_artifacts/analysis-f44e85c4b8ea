#!/usr/bin/env python3
"""
DiscoveryBench archaeology task - FINAL analysis.
Question: In which century do Diversity in Pottery Decoration and Diversity in
Pottery Form show opposite growth trends for the first time, with Pottery
Decoration increasing significantly and Pottery Form declining simultaneously?

Approach (approved plan):
  (1) Century axis derived from CE (BCE/CE), chronological order CE ascending.
  (2) Use RAW centennial values (== _inter at anchors == capital.csv).
  (3) Trend metric = century-to-century simple difference d = val[t]-val[t-1]
      (== 100-yr bin slope, same sign). 'Significant' = sign + magnitude
      threshold; sweep theta = 0, 0.5, 1.0, 90th-percentile of |d|.
      NOT % change (z-scores are signed / cross zero).
  (4) 'first time' = earliest chronological century (oldest -> newest).
Labeling (researcher-locked): change from (Y+100) BCE to Y BCE = the
(Y/100+1)-th century BCE, i.e. 1800->1700 BCE = 18th century BCE (1800-1701 BCE).
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 100)

# ---------- load (correct decimal handling) ----------
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)                    # period
cap = pd.read_csv('data/capital.csv', decimal=',')                             # comma
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')                                    # comma

# ---------- build the 37 centennial series from RAW values ----------
d = ts.loc[ts['PotteryForm'].notna(), ['CE','PotteryForm','PotteryDecoration']].copy()
d = d.sort_values('CE').reset_index(drop=True)          # oldest (-4100) -> newest (-500)
d['BCE'] = -d['CE']

# ---------- cross-checks: raw == _inter at anchors, and == capital.csv ----------
diff_int_form = float((ts['PotteryForm_inter']-ts['PotteryForm']).abs().max())
diff_int_dec  = float((ts['PotteryDecoration_inter']-ts['PotteryDecoration']).abs().max())
tsr = d[['BCE','PotteryForm','PotteryDecoration']]
m   = tsr.merge(cap[['BCE','ZKeform','Zkeverz']], on='BCE', how='inner')
diff_cap_form = float((m['ZKeform']-m['PotteryForm']).abs().max())
diff_cap_dec  = float((m['Zkeverz']-m['PotteryDecoration']).abs().max())
print("CROSS-CHECKS")
print(f"  raw vs _inter  max abs diff: Form={diff_int_form:.4f}  Deco={diff_int_dec:.4f}")
print(f"  raw vs capital max abs diff: Form={diff_cap_form:.4f}  Deco={diff_cap_dec:.4f}  (matched rows={len(m)})")

# ---------- century-to-century difference + 100-yr slope ----------
d['dForm'] = d['PotteryForm'].diff()
d['dDeco'] = d['PotteryDecoration'].diff()
# century label for the change ending at BCE year Y (multiple of 100):
#   change (Y+100)->Y spans the (Y/100+1)-th century BCE
d['century_no'] = d['BCE']//100 + 1   # e.g. 1700 -> 18
d['century_span'] = d.apply(lambda r: f"{int(r['BCE']+100)}-{int(r['BCE']+1)} BCE", axis=1)
d['slopeForm_100y'] = d['dForm']/100.0
d['slopeDeco_100y'] = d['dDeco']/100.0

print("\nCENTURY-TO-CENTURY DIFFERENCES (oldest -> newest)")
cols = ['BCE','PotteryForm','dForm','PotteryDecoration','dDeco','century_no','century_span']
print(d[cols].to_string(index=False))

# ---------- threshold sweep ----------
allabs = np.concatenate([d['dForm'].dropna().abs().values, d['dDeco'].dropna().abs().values])
p90 = float(np.percentile(allabs, 90))
print(f"\n|d| distribution: n={len(allabs)}, mean={allabs.mean():.3f}, "
      f"median={np.median(allabs):.3f}, 90th-pct={p90:.3f}, max={allabs.max():.3f}")

def first_qualifying(theta):
    """Earliest (oldest) century where Deco increases sig. AND Form declines sig."""
    for _, r in d.iterrows():
        if pd.isna(r['dForm']) or pd.isna(r['dDeco']):
            continue
        dec_inc  = (r['dDeco'] > 0) and (abs(r['dDeco']) >= theta)
        form_dec = (r['dForm'] < 0) and (abs(r['dForm']) >= theta)
        if dec_inc and form_dec:
            return r
    return None

print("\nTHRESHOLD SWEEP (earliest qualifying century)")
print(f"  {'theta':>22} | {'BCE(end)':>9} | {'century':>16} | dForm | dDeco")
for label, th in [("theta=0 (pure sign flip)", 0.0),
                  ("theta=0.5", 0.5),
                  ("theta=1.0", 1.0),
                  (f"theta=90th-pct ({p90:.3f})", p90)]:
    r = first_qualifying(th)
    if r is None:
        print(f"  {label:>22} | {'none':>9} | {'-':>16} | - | -")
    else:
        print(f"  {label:>22} | {int(r['BCE']):>9} | "
              f"{int(r['century_no'])}th c. BCE ({r['century_span']}) | "
              f"{r['dForm']:+.2f} | {r['dDeco']:+.2f}")

# ---------- primary answer ----------
r = first_qualifying(0.0)  # robust across all thresholds
print("\nPRIMARY RESULT")
print(f"  earliest opposite-trend century (1800->1700 BCE change):")
print(f"    PotteryDecoration: {r['PotteryDecoration']-r['dDeco']:+.2f} -> {r['PotteryDecoration']:+.2f}  (d={r['dDeco']:+.2f}, slope={r['slopeDeco_100y']:+.5f} z/yr)  INCREASING")
print(f"    PotteryForm:       {r['PotteryForm']-r['dForm']:+.2f} -> {r['PotteryForm']:+.2f}  (d={r['dForm']:+.2f}, slope={r['slopeForm_100y']:+.5f} z/yr)  DECLINING")
print(f"    PRIMARY label: {int(r['century_no'])}th century BCE ({r['century_span']})")
print(f"    ALTERNATIVE label (end-point reading, 1700 BCE begins the next c.): "
      f"{int(r['century_no'])-1}th century BCE")

# ---------- context: culture phase & pollen (context only, not a driver) ----------
phase = cap.loc[cap['BCE']==int(r['BCE']), 'group'].iloc[0]
print(f"\nCONTEXT (context only):")
print(f"  culture phase at {int(r['BCE'])} BCE bin: {phase}  (divergence sits on the LN->OBA boundary)")
# pollen openness around 1700-1800 BCE
p1700 = pol.loc[pol['CE']==-1700, 'MEAN'].iloc[0]
p1800 = pol.loc[pol['CE']==-1800, 'MEAN'].iloc[0]
print(f"  pollen openness (MEAN PC1) 1800 BCE={p1800:.2f} -> 1700 BCE={p1700:.2f} (context only)")
