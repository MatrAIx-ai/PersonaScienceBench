#!/usr/bin/env python3
"""Inspection / data-profiling script for the archaeology discovery task.
Profiling only - does NOT determine the final answer.
Run: python3 inspect_data.py
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 100)

ts  = pd.read_csv('data/time_series_data.csv', index_col=0)                      # period decimal
cap = pd.read_csv('data/capital.csv', decimal=',')                                 # comma decimal
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')                                        # comma decimal

print("########## 1) time_series_data.csv ##########")
print("shape:", ts.shape)
print("CE range:", ts['CE'].min(), "..", ts['CE'].max(),
      "| calBP range:", ts['calBP'].min(), "..", ts['calBP'].max())
print("CE strictly +1:", bool(np.all(np.diff(ts['CE'])==1)),
      "| calBP strictly -1:", bool(np.all(np.diff(ts['calBP'])==-1)))
print("CE == 1950 - calBP (max abs diff):", float(((1950-ts['calBP'])-ts['CE']).abs().max()))
print("exact dup rows:", int(ts.duplicated().sum()),
      "| dup CE:", int(ts['CE'].duplicated().sum()))
for c in ['PotteryForm','PotteryDecoration']:
    print(f"{c}: raw non-NaN={int(ts[c].notna().sum())}, inter non-NaN={int(ts[c+'_inter'].notna().sum())}")
print("raw centennial anchors (CE):", ts.loc[ts['PotteryForm'].notna(),'CE'].tolist())
print("raw==inter at anchors (max abs diff):",
      float((ts['PotteryForm_inter']-ts['PotteryForm']).abs().max()),
      float((ts['PotteryDecoration_inter']-ts['PotteryDecoration']).abs().max()))
a=ts.loc[ts['CE']==-4000,'PotteryForm'].iloc[0]; b=ts.loc[ts['CE']==-3900,'PotteryForm'].iloc[0]
mid=ts.loc[ts['CE']==-3950,'PotteryForm_inter'].iloc[0]
print("linear-interp check: midpoint(-3950)=%.4f vs (a+b)/2=%.4f"%(mid,(a+b)/2))

print("\n########## 2) capital.csv ##########")
print("shape:", cap.shape, "| BCE range:", cap['BCE'].min(),"..",cap['BCE'].max(),
      "(100-yr bins, strictly -100:", bool(np.all(np.diff(cap['BCE'])==-100)),")")
print("dup BCE:", int(cap['BCE'].duplicated().sum()), "| NaN total:", int(cap.isna().sum().sum()))
print("culture phases:", {g:(int(s['BCE'].max()),int(s['BCE'].min())) for g,s in cap.groupby('group',sort=False)})
tsr = ts.loc[ts['CE']<=-500, ['CE','PotteryForm','PotteryDecoration']].copy(); tsr['BCE']=-tsr['CE']
m = tsr.merge(cap[['BCE','ZKeform','Zkeverz']], on='BCE', how='inner')
print("capital vs time_series raw (matched rows=%d): max abs diff Form=%.4f Deco=%.4f"%(
      len(m),(m['ZKeform']-m['PotteryForm']).abs().max(),(m['Zkeverz']-m['PotteryDecoration']).abs().max()))
print("capital-only BCE bins:", sorted(set(cap['BCE'])-set(tsr['BCE'])))

print("\n########## 3) pollen CSV ##########")
print("shape:", pol.shape, "| CE range:", pol['CE'].min(),"..",pol['CE'].max(),
      "(descending:", bool(np.all(np.diff(pol['CE'])==-1)),")")
print("calBP range:", pol['calBP'].min(),"..",pol['calBP'].max(),
      "| CE==1950-calBP (max abs diff):", float(((1950-pol['calBP'])-pol['CE']).abs().max()))
print("dup CE:", int(pol['CE'].duplicated().sum()))
print("Belau_PC1 non-NaN=%d, Woserin_PC1 non-NaN=%d; _inter/MEAN/SMOOTH NaN=0"%(
      int(pol['Belau_PC1'].notna().sum()), int(pol['Woserin_PC1'].notna().sum())))

print("\n########## 4) century-to-century differences (raw centennial, oldest->newest) ##########")
d = ts.loc[ts['PotteryForm'].notna(), ['CE','PotteryForm','PotteryDecoration']].sort_values('CE')
d['dForm'] = d['PotteryForm'].diff()
d['dDeco'] = d['PotteryDecoration'].diff()
d['BCE'] = -d['CE']
print(d[['BCE','PotteryForm','dForm','PotteryDecoration','dDeco']].to_string(index=False))
