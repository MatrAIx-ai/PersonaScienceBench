"""Amber peak analysis: millennium and peak interval.
Primary signal: raw Amber (time_series_data.csv), cross-validated against
Zamber (capital.csv). Amber_inter excluded as non-independent (forward-fill).
"""
import pandas as pd
import numpy as np

# --- time_series_data.csv: raw Amber ---
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
raw = ts['Amber'].dropna()
raw_ce = ts.loc[raw.index, 'CE']          # BCE as negative CE
raw_bce = -raw_ce

# argmax and plateau (contiguous max-value bins), tolerance sensitivity check
mx = raw.max()
plateau = raw[raw == mx]
bce_plateau = raw_bce[raw == mx]
tol = raw[raw >= mx - 0.05]
print(f"CE range: {ts.CE.min()}..{ts.CE.max()} (1-yr bins, all BCE negative)")
print(f"raw Amber: {len(raw)} obs at 100-yr spacing, min={raw.min()}, max={mx}")
print(f"Peak plateau (== max): BCE {sorted(bce_plateau.tolist())}")
print(f"Tolerance check (>= max-0.05): BCE {sorted((-ts.loc[tol.index,'CE']).tolist())}")

# --- capital.csv: Zamber cross-validation ---
cap = pd.read_csv('data/capital.csv')
cap['Zamber'] = cap['Zamber'].astype(str).str.replace(',', '.').astype(float)
zmx = cap['Zamber'].max()
zpeak = cap[cap['Zamber'] == zmx]
print(f"\ncapital.csv: {len(cap)} rows, BCE {cap.BCE.max()}..{cap.BCE.min()} (100-yr bins)")
print(f"Zamber max={zmx} at BCE {sorted(zpeak.BCE.tolist())}, groups: {sorted(zpeak.group.unique())}")

# --- two-file agreement check ---
merged = pd.DataFrame({'bce': raw_bce, 'ts_amber': raw.values})
cap_m = cap[['BCE', 'Zamber']].rename(columns={'BCE': 'bce', 'Zamber': 'cap_amber'})
merged = merged.merge(cap_m, on='bce')
agree = np.allclose(merged.ts_amber, merged.cap_amber)
print(f"\nTwo-file agreement on {len(merged)} shared bins: {agree}")

# --- Amber_inter: confirm plateau is observed, not filled ---
ai = ts['Amber_inter']
ai_plateau = ts[ai == ai.max()].CE
print(f"Amber_inter max plateau CE {ai_plateau.min()}..{ai_plateau.max()} (== raw plateau, no fill extension)")

# --- millennium assignment ---
# 4th millennium BCE = 4000-3001 BCE
in_4th = [b for b in sorted(bce_plateau.tolist()) if 3001 <= b <= 4000]
in_3rd = [b for b in sorted(bce_plateau.tolist()) if 2001 <= b <= 3000]
print(f"\nPeak bins in 4th millennium BCE: {in_4th}; on 3rd-millennium boundary: {in_3rd}")
print("=> Millennium: 4th millennium BCE; peak interval: 3300-3000 BCE (late 4th millennium BCE)")
