import pandas as pd
import numpy as np

print("=" * 80)
print("SOCIAL CAPITAL PEAK ANALYSIS")
print("=" * 80)

# ── 1. Load data ──────────────────────────────────────────────────────────────
cap = pd.read_csv("data/capital.csv", decimal=",")
ts  = pd.read_csv("data/time_series_data.csv", index_col=0)

print(f"\ncapital.csv:       {len(cap)} rows, BCE {cap['BCE'].min()}–{cap['BCE'].max()}")
print(f"time_series_data:  {len(ts)} rows, CE {ts['CE'].min()}–{ts['CE'].max()}")

# ── 2. Convention A: endpoint values (capital.csv) ───────────────────────────
cap["sum_endpoint"] = cap["ZCU_AU"] + cap["Zamber"] + cap["ZMonument"]
cap["century"]      = cap["BCE"] // 100   # e.g. 1400 → 14

print("\n" + "─" * 80)
print("CONVENTION A – Endpoint values from capital.csv (100-yr bins)")
print("─" * 80)
hdr = f"{'BCE':>5} {'Cty':>4} {'Grp':>4} {'CuAu':>7} {'Amber':>7} {'Mon':>8} {'SUM':>8}  {'Flag'}"
print(hdr)
max_sum_a = cap["sum_endpoint"].max()
for _, r in cap.sort_values("BCE", ascending=False).iterrows():
    flag = "  ◄ PEAK" if r["sum_endpoint"] == max_sum_a else ""
    print(f"{int(r['BCE']):>5} {int(r['century']):>4} {r['group']:>4} "
          f"{r['ZCU_AU']:>7.2f} {r['Zamber']:>7.2f} {r['ZMonument']:>8.4f} "
          f"{r['sum_endpoint']:>8.4f}{flag}")

peak_a = cap[cap["sum_endpoint"] == max_sum_a].sort_values("BCE")
print(f"\nPeak (endpoint): max sum = {max_sum_a:.4f}")
print(f"  BCE bins at peak: {peak_a['BCE'].tolist()}")
print(f"  Century(ies):     {peak_a['century'].tolist()} → "
      f"{[f'{c}th c. BCE' for c in peak_a['century']]}")

# ── 3. Convention B: mean of interpolated values within each 100-yr bin ─────
ts["bce"]     = -ts["CE"]
# bin label = first year of the century: BCE 1400-1301 → label 1400
ts["bin_label"] = ((ts["bce"] - 1) // 100 + 1) * 100
ts["sum_inter"] = ts["CopperGold_inter"] + ts["Amber_inter"] + ts["MonumentCount_inter"]

bin_b = ts.groupby("bin_label").agg(
    avg_CuAu  = ("CopperGold_inter",  "mean"),
    avg_Amber = ("Amber_inter",       "mean"),
    avg_Mon   = ("MonumentCount_inter","mean"),
    avg_sum   = ("sum_inter",         "mean"),
    n_years   = ("bce",               "count"),
).reset_index()
bin_b["century"] = bin_b["bin_label"] // 100

print("\n" + "─" * 80)
print("CONVENTION B – Mean of interpolated (annual) values per 100-yr bin")
print("── from time_series_data.csv")
print("─" * 80)
hdr_b = f"{'BCE bin':>7} {'Cty':>4} {'CuAu':>7} {'Amber':>7} {'Mon':>8} {'SUM':>8} {'n':>4}  {'Flag'}"
print(hdr_b)
max_sum_b = bin_b["avg_sum"].max()
for _, r in bin_b.sort_values("bin_label", ascending=False).iterrows():
    flag = "  ◄ PEAK" if r["avg_sum"] == max_sum_b else ""
    print(f"{int(r['bin_label']):>7} {int(r['century']):>4} "
          f"{r['avg_CuAu']:>7.4f} {r['avg_Amber']:>7.4f} {r['avg_Mon']:>8.4f} "
          f"{r['avg_sum']:>8.4f} {int(r['n_years']):>4}{flag}")

peak_b = bin_b[bin_b["avg_sum"] == max_sum_b]
print(f"\nPeak (interpolated-avg): max sum = {max_sum_b:.4f}")
print(f"  BCE bin at peak: {peak_b['bin_label'].tolist()}")
print(f"  Century:         {peak_b['century'].tolist()} → "
      f"{[f'{c}th c. BCE' for c in peak_b['century']]}")

# ── 4. Component decomposition at the peak ───────────────────────────────────
print("\n" + "─" * 80)
print("COMPONENT DECOMPOSITION AT THE PEAK (14th c. BCE, BCE 1400 bin)")
print("─" * 80)
peak_row_a = cap[cap["BCE"] == 1400].iloc[0]
peak_row_b = bin_b[bin_b["bin_label"] == 1400].iloc[0]

print(f"\n  {'Component':<25} {'Endpoint (A)':>14} {'Interp-avg (B)':>16} {'Contribution':>14}")
print(f"  {'CopperGold / ZCU_AU':<25} {peak_row_a['ZCU_AU']:>14.4f} {peak_row_b['avg_CuAu']:>16.4f} {'dominant':>14}")
print(f"  {'Amber / Zamber':<25} {peak_row_a['Zamber']:>14.4f} {peak_row_b['avg_Amber']:>16.4f} {'~neutral':>14}")
print(f"  {'MonumentCount / ZMon':<25} {peak_row_a['ZMonument']:>14.4f} {peak_row_b['avg_Mon']:>16.4f} {'strong +':>14}")
print(f"  {'SUM':<25} {peak_row_a['sum_endpoint']:>14.4f} {peak_row_b['avg_sum']:>16.4f}")
print(f"\n  Archaeological period: {peak_row_a['group']} (Older Bronze Age)")

# Compare with neighbouring bins to show the rise
print(f"\n  Context – 3 bins before / at / after peak:")
for bce in [1600, 1500, 1400, 1300, 1200]:
    ra = cap[cap["BCE"] == bce].iloc[0]
    rb = bin_b[bin_b["bin_label"] == bce].iloc[0]
    print(f"    BCE {bce:>4}:  CuAu={ra['ZCU_AU']:>6.2f}  Amber={ra['Zamber']:>6.2f}  "
          f"Mon={ra['ZMonument']:>7.4f}  |  Sum(A)={ra['sum_endpoint']:>7.4f}  "
          f"Sum(B)={rb['avg_sum']:>7.4f}  [{ra['group']}]")

# ── 5. Cross-check: do both conventions agree on the peak century? ───────────
print("\n" + "─" * 80)
print("CROSS-CHECK")
print("─" * 80)
print(f"  Convention A (endpoint):       peak century = {sorted(peak_a['century'].tolist())}")
print(f"  Convention B (interp-avg):     peak century = {sorted(peak_b['century'].tolist())}")
agree = set(peak_a["century"]) & set(peak_b["century"])
print(f"  Agreement: {'YES – both point to ' + str([f'{c}th c. BCE' for c in sorted(agree)]) if agree else 'PARTIAL – see notes'}")
if len(peak_a) > 1:
    print(f"  Note: Convention A has a tie ({peak_a['BCE'].tolist()} BCE); "
          f"Convention B breaks the tie in favour of the 14th c. BCE.")

# ── 6. Verify capital.csv ⊂ time_series_data.csv consistency ─────────────────
raw_ts = ts[ts["CopperGold"].notna()][["CE", "CopperGold", "Amber", "MonumentCount"]].copy()
raw_ts["BCE"] = -raw_ts["CE"]
merged = raw_ts.merge(cap, on="BCE", suffixes=("_ts", "_cap"))
max_diff = max(
    (merged["CopperGold"] - merged["ZCU_AU"]).abs().max(),
    (merged["Amber"]      - merged["Zamber"]).abs().max(),
    (merged["MonumentCount"] - merged["ZMonument"]).abs().max(),
)
print(f"\n  Max |ΔZ| between files at {len(merged)} overlapping points: {max_diff:.2e}")
print(f"  Cross-check: {'PASS – values identical' if max_diff < 1e-10 else 'MISMATCH'}")

print("\n" + "=" * 80)
print("DONE")
print("=" * 80)
