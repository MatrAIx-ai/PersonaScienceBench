"""
Habitat variation in gardening-introduced non-native plant prevalence.

Question: How does the prevalence of non-native plants introduced via
gardening vary based on habitat type?

Data
----
data/invaded_niche_pathways.csv
    632 sampled plots, Barcelona province. Per-plot SPECIES counts of
    non-native plants by introduction pathway: n.gard (Gardening),
    n.unint (Unintentional), n.agfo (AgriForest); n.total =
    n.gard + n.unint + n.agfo (verified in all 632 rows). Each plot has
    exactly one of the ten most widespread habitat types.
data/temporal_trends_contingency_table.csv
    Pathway counts over four historical periods (context only).
data/invasion_success_pathways.csv
    Species-level records for 81 invaded species (42 Gardening, 30
    Unintentional, 9 AgriForest); used for a cross-check only.

Design notes
------------
Raw per-habitat gardening counts are confounded with total non-native
richness (habitat mean n.total correlates 0.977 with habitat sum n.gard),
so the primary comparison uses the gardening SHARE of non-natives:
  (1) aggregated per-habitat shares with Wilson confidence intervals and
      a chi-square test of independence on the habitat x {Gardening,
          other} species-count table;
  (2) a plot-level binomial GLM (n.gard ~ habitat, n.total as trials)
      for robustness. The unpenalized MLE diverges because of
      quasi-complete separation (e.g., Broad-leaved forests: 3/3 positive
      plots are 100% gardening), so the plot-level model is fitted with
      L2 (Firth-type) penalisation; it is reported for direction of
      effects only.
"""
import numpy as np
import pandas as pd
from scipy import stats

DATA = "/workspace/data"

# ---------------------------------------------------------------- load
df = pd.read_csv(f"{DATA}/invaded_niche_pathways.csv", sep="\t", quotechar='"')
temp = pd.read_csv(f"{DATA}/temporal_trends_contingency_table.csv", sep="\t", quotechar='"')
sp = pd.read_csv(f"{DATA}/invasion_success_pathways.csv")

# sanity checks
assert len(df) == 632
assert int(df.isna().sum().sum()) == 0
assert (df["n.gard"] + df["n.unint"] + df["n.agfo"] == df["n.total"]).all()
assert df["habitat"].nunique() == 10
print("Sanity checks passed: 632 rows, 0 NAs, pathway counts additive, 10 habitats.")

# ------------------------------------------------------- per-habitat table
h = (df.groupby("habitat")
       .agg(plots=("n.gard", "size"),
            sum_n_gard=("n.gard", "sum"),
            sum_n_total=("n.total", "sum"))
       .reset_index())
h["plots_with_gard"] = df.assign(has_gard=df["n.gard"] > 0) \
                         .groupby("habitat")["has_gard"].sum().values

def wilson(y, n, alpha=0.05):
    if n == 0:
        return np.nan, np.nan
    p = y / n
    z = stats.norm.ppf(1 - alpha / 2)
    den = 1 + z * z / n
    ctr = (p + z * z / (2 * n)) / den
    half = z * np.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
    return ctr - half, ctr + half

h["gard_share"] = h["sum_n_gard"] / h["sum_n_total"].replace(0, np.nan)
ci = [wilson(y, n) for y, n in zip(h["sum_n_gard"], h["sum_n_total"])]
h["ci_lo"], h["ci_hi"] = np.array(ci)[:, 0], np.array(ci)[:, 1]
h["pct_plots_gard"] = 100 * h["plots_with_gard"] / h["plots"]
h = h.sort_values("gard_share", ascending=False).reset_index(drop=True)
for c in ["gard_share", "ci_lo", "ci_hi"]:
    h[c] = h[c].round(3)
h["pct_plots_gard"] = h["pct_plots_gard"].round(1)

print("\nPER-HABITAT TABLE (sorted by gardening share)")
print(h.to_string(index=False))
print(f"Overall: {df['n.gard'].sum()}/{df['n.total'].sum()} non-natives are "
      f"gardening-introduced ({df['n.gard'].sum()/df['n.total'].sum():.3f}); "
      f"{(df['n.gard']>0).sum()}/632 plots (18.5%) contain >=1 gardening species; "
      f"{(df['n.total']>0).sum()}/632 plots contain any non-native.")

# ------------------------------------------------- chi-square on counts table
tab = pd.DataFrame({
    "Gardening": h["sum_n_gard"].values,
    "Other": (h["sum_n_total"] - h["sum_n_gard"]).values,
}, index=h["habitat"].values)
chi2, p_chisq, dof, _ = stats.chi2_contingency(tab, correction=False)
print(f"\nChi-square test, habitat x pathway (Gardening vs other): "
      f"chi2 = {chi2:.1f}, df = {dof}, p = {p_chisq:.2e}")
# contribution to chi2 per habitat (which habitats drive the difference)
expected = np.outer(tab.sum(axis=1), tab.sum(axis=0) / tab.values.sum())
contrib = ((tab.values - expected) ** 2 / expected).sum(axis=1)
print("Habitats contributing most to the chi2 (Gardening cell):")
for hab, c in sorted(zip(tab.index, contrib), key=lambda x: -x[1])[:5]:
    print(f"  {hab:22s} {c:7.1f}")

# ------------------------------------------- plot-level robustness check
# The unpenalized binomial GLM (n.gard ~ habitat, n.total as trials)
# diverges on these data because of quasi-complete separation (e.g.
# Broad-leaved forests: 3/3 positive plots are 100% gardening;
# Coniferous: 4/5; Wetlands: 10/21) - a small-cell artefact, noted here
# and not pursued further. Robust plot-level alternative: label
# permutation test of the habitat x pathway chi-square statistic.
d = df[df["n.total"] > 0].copy()
print(f"\nPlot-level robustness: {len(d)} plots with n.total > 0 "
      f"(441 zero-total plots excluded; pathway share undefined there).")

def chi2_of(tab_vals):
    c, _, _, _ = stats.chi2_contingency(pd.DataFrame(tab_vals), correction=False)
    return c

rng = np.random.default_rng(42)
obs = d.groupby("habitat")[["n.gard", "n.total"]].sum()
obs_tab = np.column_stack([obs["n.gard"].values,
                           (obs["n.total"] - obs["n.gard"]).values])
chi_obs = chi2_of(obs_tab)
hab_labels = d["habitat"].values
n_perm = 1999
count = 0
for _ in range(n_perm):
    perm = rng.permutation(hab_labels)
    t = pd.DataFrame({"hab": perm, "g": d["n.gard"].values,
                      "o": d["n.total"].values - d["n.gard"].values}) \
        .groupby("hab")[["g", "o"]].sum()
    t = t.reindex(obs.index, fill_value=0)
    if chi2_of(t.values) >= chi_obs:
        count += 1
p_perm = (count + 1) / (n_perm + 1)
print(f"Observed chi2 = {chi_obs:.1f}; permutation test (habitat labels shuffled "
      f"among positive plots, {n_perm} permutations): p = {p_perm:.4f}")

# mean per-plot share by habitat (robust descriptive view)
means = (d.assign(gs=d["n.gard"] / d["n.total"])
             .groupby("habitat")["gs"].agg(["count", "mean"])
             .sort_values("mean", ascending=False))
print("\nMean per-plot gardening share (n.gard/n.total) among positive plots:")
print(means.round(3).to_string())

# ------------------------------------------------------------- context
piv = temp.pivot(index="introduction.period", columns="pathway", values="n")
piv["Gardening_share_%"] = (100 * piv["Gardening"] / piv.sum(axis=1)).round(1)
print("\nTemporal context - pathway counts by period:")
print(piv.to_string())

print(f"\nSpecies-level cross-check: {int((sp['intro.pathway']=='Gardening').sum())} of "
      f"{len(sp)} invaded species are gardening-introduced.")

e = df.groupby("habitat")["elevation"].mean().sort_values()
print("\nMean elevation by habitat (m) - contextual, not adjusted for:")
print(e.round(0).to_string())
