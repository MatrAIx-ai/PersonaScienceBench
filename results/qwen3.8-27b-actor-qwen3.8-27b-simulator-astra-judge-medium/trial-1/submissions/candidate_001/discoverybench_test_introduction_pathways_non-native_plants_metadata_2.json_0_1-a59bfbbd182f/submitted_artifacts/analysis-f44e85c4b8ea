import pandas as pd, numpy as np
from scipy import stats
import json

pd.set_option('display.width',220); pd.set_option('display.max_columns',50)

# ---------- load ----------
niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t', dtype={'habitat':str})
inv   = pd.read_csv('data/invasion_success_pathways.csv')

# ---------- per-habitat per-pathway prevalence signature ----------
def sig(df, col):
    g = df.groupby('habitat')
    occ = (df[col]>0).groupby(df['habitat']).sum()
    tot = g[col].sum()
    mean_occ = (tot/occ).round(3)
    return pd.DataFrame({'plots':g.size(),'plots_occ':occ,'total':tot,
                         'occ_prop':(occ/g.size()).round(3),
                         'mean_occ':mean_occ,'max':g[col].max()})

gard = sig(niche,'n.gard'); unint = sig(niche,'n.unint'); agfo = sig(niche,'n.agfo')
share = niche.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum()
share = share.sort_values('n.gard',ascending=False)
share['gard_share'] = (share['n.gard']/share['n.total']).round(3)
share['unint_share'] = (share['n.unint']/share['n.total']).round(3)

sigtab = pd.DataFrame(index=share.index)
sigtab['plots'] = share.index.map(gard['plots'])
sigtab['gard_total']=share['n.gard']; sigtab['gard_occ_prop']=gard['occ_prop']; sigtab['gard_mean_occ']=gard['mean_occ']; sigtab['gard_share']=share['gard_share']
sigtab['unint_total']=share['n.unint']; sigtab['unint_occ_prop']=unint['occ_prop']; sigtab['unint_mean_occ']=unint['mean_occ']; sigtab['unint_share']=share['unint_share']
sigtab['agfo_total']=share['n.agfo']
print("=== PREVALENCE SIGNATURE (gard vs unint) per habitat ===")
print(sigtab.sort_values('gard_total',ascending=False).to_string())
sigtab.to_csv('out/prevalence_signature_by_habitat.csv')

# ---------- habitat grouping ----------
anthro = ['Urban','Croplands','Wetlands','Coastal']
natural = ['Broad-leaved forests','Coniferous forests','Scrublands','Meadows','Rock outcrops','Riparian']
niche['hgroup'] = niche['habitat'].map(lambda h:'anthropogenic' if h in anthro else 'natural')
print("\nHabitat groups:\n", niche.groupby(['hgroup','habitat']).size().to_string())

# ---------- STAT 1: Kruskal-Wallis per-plot n.gard across 10 habitats ----------
groups = [d['n.gard'].values for _,d in niche.groupby('habitat')]
H, p = stats.kruskal(*groups)
print(f"\n[KW] per-plot n.gard across 10 habitats: H={H:.2f}, p={p:.3e}")

# ---------- STAT 2: Fisher — gardening presence, anthropogenic vs natural ----------
def occ2x2(mask):
    sub = niche[mask]
    a = int((sub['n.gard']>0).sum()); b = int((sub['n.gard']==0).sum())
    return a,b
a1,b1 = occ2x2(niche['hgroup']=='anthropogenic'); a2,b2 = occ2x2(niche['hgroup']=='natural')
tbl = np.array([[a1,b1],[a2,b2]])
odds, pf = stats.fisher_exact(tbl)
print(f"\n[Fisher] gardening presence anthro vs natural: table={tbl.tolist()}")
print(f"   anthro occ_prop={a1/(a1+b1):.3f}  natural occ_prop={a2/(a2+b2):.3f}  OR={odds:.2f}  p={pf:.3e}")

# ---------- STAT 3: chi-square pathway composition (gard vs unint) anthropogenic vs natural ----------
def comp(mask):
    s = niche[mask].groupby('hgroup')[['n.gard','n.unint']].sum().iloc[0]
    return int(s['n.gard']), int(s['n.unint'])
# build 2x2: rows=group, cols=gard/unint
gc, uc = comp(niche['hgroup']=='anthropogenic')
gn, un = comp(niche['hgroup']=='natural')
comp_tbl = np.array([[gc,uc],[gn,un]])
chi2, p3, dof, exp = stats.chi2_contingency(comp_tbl)
print(f"\n[Chi2] pathway composition (gard|unint) by group: anthro={comp_tbl[0].tolist()} natural={comp_tbl[1].tolist()}")
print(f"   chi2={chi2:.2f} dof={dof} p={p3:.3e}  (anthro gard:{uc} vs natural gard:{un})")

# ---------- STAT 4: chi-square gardening presence across all 10 habitats ----------
pres = np.array([[int((d['n.gard']>0).sum()), int((d['n.gard']==0).sum())] for _,d in niche.groupby('habitat')])
chi2b, p4, _, _ = stats.chi2_contingency(pres)
print(f"\n[Chi2] gardening presence across 10 habitats: chi2={chi2b:.2f} p={p4:.3e}")

# ---------- STAT 5: land-cover corroboration (secondary) ----------
land = niche.groupby('habitat').apply(lambda d: pd.Series({
    'gard_share': (d['n.gard'].sum()/d['n.total'].sum()) if d['n.total'].sum()>0 else np.nan,
    'urban.2009.500m': d['urban.2009.500m'].mean(),
    'elevation': d['elevation'].mean()}), include_groups=False)
r, pl = stats.pearsonr(land['gard_share'].dropna(), land.loc[land['gard_share'].dropna().index,'urban.2009.500m'])
print(f"\n[Corroborate] gard_share vs mean urban.2009.500m (habitat means): r={r:.3f} p={pl:.3f}")
print(land.round(3).to_string())
land.to_csv('out/landcover_corroboration.csv')

# ---------- cross-check: species-level traits ----------
tr = inv.groupby('intro.pathway').agg(n_species=('Scientific_name','count'),
    mean_hab_range=('habitat.range','mean'),
    mean_plots=('number.of.invaded.plots','mean'),
    mean_niche_breadth=('invaded.niche.breadth','mean')).round(3)
print("\n[Cross-check species-level] (gard = fewer, narrower; unint = broader)")
print(tr.to_string())
tr.to_csv('out/species_level_crosscheck.csv')

# ---------- save summary ----------
summary = dict(
  kw_gard_H=round(float(H),2), kw_gard_p=float(p),
  fisher_gard_presence=dict(anthro_occ=round(a1/(a1+b1),3), natural_occ=round(a2/(a2+b2),3), OR=round(float(odds),2), p=float(pf)),
  chipath_gard_vs_unint=dict(anthro=[int(gc),int(uc)], natural=[int(gn),int(un)], chi2=round(float(chi2),2), p=float(p3)),
  chi2_gard_presence_10hab=dict(chi2=round(float(chi2b),2), p=float(p4)),
  landcover_corr=dict(r=round(float(r),3), p=float(pl))
)
json.dump(summary, open('out/summary_stats.json','w'), indent=2)
print("\nSaved: out/prevalence_signature_by_habitat.csv, out/landcover_corroboration.csv, out/species_level_crosscheck.csv, out/summary_stats.json")
