"""
Consolidated analysis for:
  "In what scenario did urban land use promote a specific type of plant invasion?"
Data: data/invaded_niche_pathways.csv (632 plots, Barcelona province),
      data/invasion_success_pathways.csv (81 species), data/temporal_trends_contingency_table.csv
Method: (1) within-habitat Spearman sweep; (2) within-habitat GLM (logit presence + NB count,
        urban + cropland controls) with robustness; (3) pooled main-effect logit (urban vs
        cropland, controlling habitat + distance.road); (4) urban-change window; (5) species context.
'specific type' = introduction pathway (Gardening/Unintentional/AgriForest), the plot-level response.
"""
import warnings; warnings.simplefilter("ignore")
import pandas as pd, numpy as np
from scipy import stats
import statsmodels.api as sm
from statsmodels.discrete.discrete_model import Logit

df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
sp = pd.read_csv("data/invasion_success_pathways.csv")
pathways = {"gard":"Gardening","unint":"Unintentional","agfo":"AgriForest"}
buffers=["50m","500m","1000m"]; years=["1956","1993","2009"]
def z(x):
    x=np.asarray(x,float); s=x.std(); return (x-x.mean())/s if s>0 else x*0.0

print("### 1) WITHIN-HABITAT SPEARMAN  urban.(year).(buffer) ~ pathway count (n>=20) ###")
rows=[]
for h,g in df.groupby("habitat"):
    for B in buffers:
        for Y in years:
            u=f"urban.{Y}.{B}"
            for p in ["gard","unint","agfo"]:
                a=g[u].values.astype(float); b=g[f"n.{p}"].values.astype(float)
                r,pp = (stats.spearmanr(a,b) if (np.std(a)>0 and np.std(b)>0) else (np.nan,np.nan))
                rows.append(dict(habitat=h,buffer=B,year=Y,pathway=p,rho=r,p=pp,n=len(g),nz=int((b>0).sum())))
A=pd.DataFrame(rows).dropna(subset=["rho"]); A.to_csv("results/A_spearman_sweep.csv",index=False)
for p in ["unint","gard","agfo"]:
    s=A[(A.pathway==p)&(A.n>=20)&(A.nz>=6)].sort_values("rho",ascending=False).head(4)
    print(f"  {pathways[p]:12s}: " + " | ".join(f"{r.habitat}/{r.buffer}/{r.year} rho={r.rho:.2f}(p={r.p:.3f})" for r in s.itertuples()))

print("\n### 2) WITHIN-HABITAT GLM robustness (std urban + cropland; #buffer x year combos of 9 with + & p<0.05) ###")
def fit_logit(g,u,ctrls,p):
    X=g[[u]+ctrls].astype(float).copy(); X[u]=z(X[u]); X[ctrls]=X[ctrls].apply(z)
    y=(g[f"n.{p}"]>0).astype(int)
    if len(np.unique(y))<2: return np.nan,np.nan
    try:
        m=Logit(y,sm.add_constant(X)).fit(disp=0,maxiter=200); return float(m.params[u]),float(m.pvalues[u])
    except: return np.nan,np.nan
rowsL=[]
for h,g in df.groupby("habitat"):
    for B in buffers:
        for Y in years:
            u=f"urban.{Y}.{B}"; c=f"cropland.{Y}.{B}"
            for p in ["gard","unint","agfo"]:
                b,pp=fit_logit(g,u,[c],p); rowsL.append(dict(habitat=h,buffer=B,year=Y,pathway=p,beta=b,p=pp))
L=pd.DataFrame(rowsL); L.to_csv("results/B_logit_sweep.csv",index=False)
t=L.dropna(subset=["p"]).copy(); t["sp"]=(t.beta>0)&(t.p<0.05)
rob=t.groupby(["habitat","pathway"]).agg(k=("sp","size"),sp=("sp","sum"),med_p=("p","median")).reset_index()
rob=rob.sort_values(["sp","med_p"],ascending=[False,True])
print("  top (habitat x pathway) by robustness:")
print(rob.head(6).to_string(index=False))

print("\n### 3) POOLED main effect: presence ~ [urban|cropland].2009.500m + habitat + distance.road ###")
for var,lab in [("urban.2009.500m","URBAN"),("cropland.2009.500m","CROPLAND")]:
    out=[]
    for p in ["unint","gard","agfo"]:
        d2=df.copy(); d2["y"]=(d2[f"n.{p}"]>0).astype(int)
        X=pd.get_dummies(d2[["habitat","distance.road"]],drop_first=True,dtype=float)
        X[lab]=z(d2[var]); X=sm.add_constant(X)
        try:
            m=Logit(d2["y"],X).fit(disp=0,maxiter=300); out.append(f"{pathways[p]}: {m.params[lab]:+.3f} (p={m.pvalues[lab]:.4f})")
        except Exception: out.append(f"{pathways[p]}: NA(separation)")
    print(f"  {lab:9s} -> " + " | ".join(out))

print("\n### 4) URBAN CHANGE (progressive.1993.2009.50m = recent urban increase) ~ pathway, within habitat ###")
for h,gg in df.groupby("habitat"):
    for p in ["unint","gard"]:
        a=gg["progressive.1993.2009.50m"].values.astype(float); b=gg[f"n.{p}"].values.astype(float)
        if np.std(a)>0 and np.std(b)>0:
            r,pp=stats.spearmanr(a,b)
            if pp<0.05: print(f"  {h:14s} {pathways[p]:12s} rho={r:+.3f} p={pp:.4f} (n={len(gg)})")

print("\n### 5) SPECIES CONTEXT (invasion_success_pathways.csv): composition of the promoted type ###")
for p in ["Unintentional","Gardening","AgriForest"]:
    sub=sp[sp["intro.pathway"]==p]
    print(f"  {p:12s} (n={len(sub)}): top families={dict(sub.family.value_counts().head(3))}; "
          f"growth.form={dict(sub['growth.form'].value_counts())}; mean invaded.plots={sub['number.of.invaded.plots'].mean():.1f}")
tt=pd.read_csv("data/temporal_trends_contingency_table.csv",sep="\t")
print("  temporal (1985-2019):", dict(tt[tt['introduction.period']=='1985-2019'].set_index('pathway')['n']))
print("\nDONE.")
