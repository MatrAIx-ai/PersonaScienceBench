"""
DiscoveryBench: "What types of plant introductions were influenced by urban land use?"
Data: 632 plots, Barcelona province (invaded_niche_pathways.csv) with per-plot counts of
invasive non-native species by introduction pathway (n_gard, n_unint, n_agfo) and urban/
cropland buffer proportions for 1956/1993/2009 at 50/500/1000 m; regional period x pathway
contingency table; species-level invasion_success table.

Models:
  A) COMPOSITION (share of invasives per plot by pathway): binomial GLM, n_p of n_total,
     on invaded plots, ~ urban_2009_500m + habitat + elevation + climate + road + stream
     + cropland (continuous covariates z-standardized). Also no-habitat and urban-only.
  B) ABSOLUTE abundance: Poisson GLM (HC3 robust SE), no offset, no habitat (full-habitat
     Poisson hits separation: zero cells for n_unint in some habitats).
  C) Sensitivity: A) with each alternative urban variable (3 buffers x 3 years + change).
  D) Chi-square contrasts: pathway composition in high- vs low-urban plots and in
     Urban vs other habitats; invasion probability; period x pathway contingency.
"""
import pandas as pd, numpy as np
from scipy import stats
import patsy
import statsmodels.api as sm

inv = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
inv.columns = [c.replace('.', '_') for c in inv.columns]
tt  = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
tt.columns = [c.replace('.', '_') for c in tt.columns]
iss = pd.read_csv('data/invasion_success_pathways.csv')
iss.columns = [c.replace('.', '_') for c in iss.columns]

PATHS = ['n_gard', 'n_unint', 'n_agfo']
URB = 'urban_2009_500m'
std_cols = ['elevation', 'annual_temperature', 'annual_rainfall',
            'distance_road', 'distance_stream', 'cropland_2009_500m']
for c in std_cols:
    inv[c + '_z'] = (inv[c] - inv[c].mean()) / inv[c].std()
COV_Z = ['habitat'] + [c + '_z' for c in std_cols]
NOHAB = [c + '_z' for c in std_cols]
RHS_FULL  = "1 + " + URB + " + " + " + ".join(COV_Z)
RHS_NOHAB = "1 + " + URB + " + " + " + ".join(NOHAB)

invaded = inv[inv['n_total'] > 0].copy()
print(f"plots={len(inv)}, invaded plots={len(invaded)}")

def exog(d, rhs):
    y, X = patsy.dmatrices(f"n_total ~ {rhs}", d, return_type='dataframe')
    return X

def rep(m, name=URB):
    b, pv = m.params[name], m.pvalues[name]
    return f"beta={b:+.3f}  OR/IRR per +0.10={np.exp(b*0.1):.3f}  p={pv:.4f}"

print("\n=== A) BINOMIAL composition n_p of n_total (invaded plots) ===")
for p in PATHS:
    X = exog(invaded, RHS_FULL)
    endog = np.column_stack([invaded[p].values, (invaded['n_total']-invaded[p]).values])
    m = sm.GLM(endog, X, family=sm.families.Binomial()).fit()
    print(f"{p:8s} full covars : {rep(m)}")
    X = exog(invaded, RHS_NOHAB)
    m = sm.GLM(endog, X, family=sm.families.Binomial()).fit()
    print(f"{p:8s} no habitat  : {rep(m)}")
    X = exog(invaded, "1 + " + URB)
    m = sm.GLM(endog, X, family=sm.families.Binomial()).fit()
    print(f"{p:8s} urban only  : {rep(m)}")

print("\n=== B) POISSON absolute counts, no habitat (invaded plots), HC3 ===")
for p in PATHS:
    X = exog(invaded, RHS_NOHAB)
    m = sm.GLM(invaded[p].values, X, family=sm.families.Poisson()).fit(cov_type='HC3')
    print(f"{p:8s} {rep(m)}  (dev/df={m.deviance/m.df_resid:.2f})")

print("\n=== C) SENSITIVITY: binomial composition, each urban variable (full covars) ===")
urb_vars = [c for c in inv.columns if c.startswith('urban_')] + \
           ['progressive_1956_2009_50m', 'regressive_1956_2009_50m']
rows = []
for u in urb_vars:
    rhs_u = "1 + " + u + " + " + " + ".join(COV_Z)
    X = exog(invaded, rhs_u)
    line = {'urban_var': u}
    for p in PATHS:
        endog = np.column_stack([invaded[p].values, (invaded['n_total']-invaded[p]).values])
        m = sm.GLM(endog, X, family=sm.families.Binomial()).fit()
        b, pv = m.params[u], m.pvalues[u]
        line[p] = f"OR/0.1={np.exp(b*0.1):.3f} (p={pv:.3f})"
    rows.append(line)
print(pd.DataFrame(rows).to_string(index=False))

print("\n=== D1) CHISQ: pathway composition, urban>=0.25 vs <0.25 ===")
hi = inv[inv[URB] >= 0.25][PATHS].sum(); lo = inv[inv[URB] < 0.25][PATHS].sum()
chi2, pchi, dof, _ = stats.chi2_contingency(np.array([hi.values, lo.values]).astype(float))
print(f"high-urban {hi.to_dict()} (n={int(hi.sum())}); low-urban {lo.to_dict()} (n={int(lo.sum())})")
print(f"chi2={chi2:.2f}, dof={dof}, p={pchi:.2e}")
hu = inv[inv['habitat'] == 'Urban'][PATHS].sum(); hr = inv[inv['habitat'] != 'Urban'][PATHS].sum()
chi2b, pchib, dofb, _ = stats.chi2_contingency(np.array([hu.values, hr.values]).astype(float))
print(f"habitat Urban {hu.to_dict()} vs rest {hr.to_dict()}: chi2={chi2b:.2f}, p={pchib:.2e}")

print("\n=== D2) invasion probability by urban group (all plots) ===")
hi = inv[inv[URB] >= 0.25]; lo = inv[inv[URB] < 0.25]
tab = np.array([[(hi['n_total']>0).sum(), (hi['n_total']==0).sum()],
                [(lo['n_total']>0).sum(), (lo['n_total']==0).sum()]])
chi2i, pchi_i, _, _ = stats.chi2_contingency(tab)
print(f"invaded: high-urban {hi['n_total'].gt(0).mean():.2f} vs low-urban {lo['n_total'].gt(0).mean():.2f}; chi2={chi2i:.1f}, p={pchi_i:.1e}")

print("\n=== D3) CHISQ: introduction period x pathway ===")
ct = tt.pivot(index='introduction_period', columns='pathway', values='n').fillna(0)
chi2c, pchic, dofc, _ = stats.chi2_contingency(ct.values.astype(float))
print(ct.to_string())
print(f"chi2={chi2c:.2f}, dof={dofc}, p={pchic:.2e}")
pre = tt[tt['introduction_period'] != '1985-2019'].groupby('pathway')['n'].sum()
print(f"Gardening share: 1985-2019 = {ct.loc['1985-2019','Gardening']/ct.loc['1985-2019'].sum():.2f}; pre-1985 = {pre['Gardening']/pre.sum():.2f}")

print("\n=== E) SPECIES-LEVEL by pathway (invasion_success) ===")
print(iss.groupby('intro_pathway')[['mrt','invaded_niche_breadth','height','number_of_invaded_plots','habitat_range']].mean().round(2).to_string())
