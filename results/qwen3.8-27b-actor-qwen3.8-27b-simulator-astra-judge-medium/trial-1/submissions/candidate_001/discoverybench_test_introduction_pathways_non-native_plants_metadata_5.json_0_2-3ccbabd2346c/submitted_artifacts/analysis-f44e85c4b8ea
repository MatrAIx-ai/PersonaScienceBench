import pandas as pd, numpy as np
from scipy import stats
import warnings
warnings.filterwarnings('ignore')
np.random.seed(42)
niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv('data/invasion_success_pathways.csv')

def mw(a,b,nperm=10000):
    U,pval = stats.mannwhitneyu(a,b,alternative='two-sided')
    a=np.asarray(a,float); b=np.asarray(b,float)
    allv=np.concatenate([a,b]); na=len(a)
    obsd=np.mean(a)-np.mean(b)
    cnt=0
    for _ in range(nperm):
        idx=np.random.permutation(len(allv))
        pd_=np.mean(allv[idx[:na]])-np.mean(allv[idx[na:]])
        if abs(pd_)>=abs(obsd): cnt+=1
    return pval, obsd, cnt/nperm

PATHS=['n.gard','n.unint','n.agfo']

print('='*70); print('STEP 1 - DESCRIPTIVE CONTRAST (feasibility)'); print('='*70)
for path in PATHS:
    sub = niche[niche[path]>0]
    print(f'{path:>8}>0: n={len(sub):3d}  urban.2009.500m={sub["urban.2009.500m"].mean():.3f}  '
          f'urban.2009.50m={sub["urban.2009.50m"].mean():.3f}  urban.2009.1000m={sub["urban.2009.1000m"].mean():.3f}  '
          f'cropland.2009.500m={sub["cropland.2009.500m"].mean():.3f}')
urb = niche[niche.habitat=='Urban']
print(f'Urban habitat plots: n={len(urb)}  n.total={urb["n.total"].mean():.2f}  urban.2009.500m={urb["urban.2009.500m"].mean():.3f}')

print(); print('='*70); print('STEP 2 - PLOT-LEVEL URBAN: invaded vs non-invaded (MW + permutation)'); print('='*70)
for path in PATHS:
    for buf in ['50m','500m','1000m']:
        col=f'urban.2009.{buf}'
        a=niche[niche[path]>0][col].values; b=niche[niche[path]==0][col].values
        pval,obsd,pp=mw(a,b)
        print(f'{path:>8} {buf}: inv={a.mean():.3f} non={b.mean():.3f} d={obsd:+.3f}  MW-p={pval:.3g}  perm-p={pp:.3g}  ninv={(niche[path]>0).sum()}')

print(); print('='*70); print('STEP 3 - COUNT GLMs (negative binomial) + combined interaction'); print('='*70)
try:
    import statsmodels.api as sm, statsmodels.formula.api as smf
    HAVE=True
except Exception as e:
    HAVE=False; print('statsmodels unavailable:', e)
import patsy
# sanitized data: replace dots in column names for patsy
d = niche.copy()
d.columns=[c.replace('.', '_') for c in d.columns]
U50='urban_2009_500m'; C50='cropland_2009_500m'
covars = 'C(habitat) + elevation + distance_road + distance_stream + '+C50
NB_OK={}
for path in ['n_gard','n_unint','n_agfo']:
    try:
        m = smf.glm(f'{path} ~ {U50} + {covars}', data=d, family=sm.families.NegativeBinomial()).fit()
        b=m.params[U50]; ci=m.conf_int().loc[U50]
        irr=np.exp(b); se_rel=abs(m.bse[U50])/abs(b) if b!=0 else np.nan
        NB_OK[path]=bool((not np.isnan(b)) and se_rel<5)
        print(f'{path:>8}: urban IRR={irr:.3f} [{np.exp(ci[0]):.3f},{np.exp(ci[1]):.3f}]  p={m.pvalues[U50]:.3g}  relSE={se_rel:.2f}')
    except Exception as e:
        NB_OK[path]=False
        print(f'{path:>8}: NB model FAILED ({type(e).__name__}) -> fall back to Step 2 MW')
# combined interaction model
d['has_gard']=(d.n_gard>0).astype(int); d['has_unint']=(d.n_unint>0).astype(int); d['has_agfo']=(d.n_agfo>0).astype(int)
f=f'n_total ~ {U50}*C(has_gard+has_unint+has_agfo) + '+covars
m2=smf.glm(f, data=d, family=sm.families.NegativeBinomial()).fit()
print('\nCombined NB interaction (n_total ~ urban x pathway + covars):')
for k in m2.params.index:
    if 'urban' in k:
        print(f'  {k}: coef={m2.params[k]:.3f} IRR={np.exp(m2.params[k]):.3f} p={m2.pvalues[k]:.3g}')
print(); print('='*70); print('STEP 4 - URBANIZATION TRAJECTORY (delta & progressive)'); print('='*70)
niche['urban_delta_500']=niche['urban.2009.500m']-niche['urban.1956.500m']
for path in PATHS:
    a=niche[niche[path]>0]; b=niche[niche[path]==0]
    r_delta,pc=stats.pearsonr(niche['urban_delta_500'], niche[path])
    r_prog,pcg=stats.pearsonr(niche['progressive.1956.2009.50m'], niche[path])
    pval,od,pp=mw(a['urban_delta_500'].values,b['urban_delta_500'].values)
    print(f'{path:>8}: corr(delta,{path})={r_delta:+.3f} p={pc:.3g} | corr(progressive,{path})={r_prog:+.3f} p={pcg:.3g} | '
          f'delta inv={a["urban_delta_500"].mean():+.3f} non={b["urban_delta_500"].mean():+.3f} MW-p={pval:.3g} perm-p={pp:.3g}')

print(); print('='*70); print('STEP 5 - SPECIES-LEVEL (invasion_success) by pathway & growth form'); print('='*70)
print('By intro.pathway:')
print(sp.groupby('intro.pathway')[['number.of.invaded.plots','invaded.niche.breadth','mrt','habitat.range']].agg(['mean','count']).round(2))
print('\nBy growth.form:')
print(sp.groupby('growth.form')[['number.of.invaded.plots','invaded.niche.breadth','mrt','height']].agg(['mean','count']).round(2))
print('\nPathway x growth.form crosstab:'); print(pd.crosstab(sp['intro.pathway'], sp['growth.form']))
g=sp[sp['intro.pathway']=='Gardening']['number.of.invaded.plots'].values
o=sp[sp['intro.pathway']!='Gardening']['number.of.invaded.plots'].values
pval,od,pp=mw(g,o)
print(f'\nGardening vs other: number.of.invaded.plots mean {g.mean():.2f} vs {o.mean():.2f}  MW-p={pval:.3g} perm-p={pp:.3g}')

print(); print('='*70); print('STEP 6 - SYNTHESIS SUMMARY'); print('='*70)
print('Urban.2009.500m (invaded vs non-invaded) by pathway:')
for path in PATHS:
    a=niche[niche[path]>0]['urban.2009.500m'].mean(); b=niche[niche[path]==0]['urban.2009.500m'].mean()
    print(f'  {path}: {a:.3f} vs {b:.3f} (d={a-b:+.3f})')
print('n.gard vs urban level vs urbanization-rate (Pearson r):')
print('  level 500m 2009:', round(stats.pearsonr(niche["urban.2009.500m"],niche["n.gard"])[0],3))
print('  delta 1956-2009:', round(stats.pearsonr(niche["urban_delta_500"],niche["n.gard"])[0],3))
print('NB model usable flags:', NB_OK)
