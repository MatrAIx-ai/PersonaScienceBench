"""
Analysis: In which domains are original-study effect sizes larger than replication
effect sizes?

Data: data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv
Grouping variable: discipline (Social / Cognitive / Economics)
Primary metric: relative_es = replication ES / original ES (documented continuous
outcome variable). relative_es < 1  => original effect larger than replication.
"""
import pandas as pd
import numpy as np

CSV = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

print(f"Loaded {len(df)} rows x {df.shape[1]} cols")
es_cols = ["ro", "rr", "fiso", "fisr", "relative_es"]
print("Non-null counts:", {c: int(df[c].notna().sum()) for c in es_cols})
print("discipline counts:", df["discipline"].value_counts().to_dict())
print("project.x counts:", df["project.x"].value_counts().to_dict())
print("Fully duplicated rows:", int(df.duplicated().sum()))
print("Duplicate study ids:", int(df["study"].duplicated(keep=False).sum()))

def domain_table(d):
    t = d.groupby("discipline")["relative_es"].agg(
        n="count", mean="mean", median="median",
        pct_lt_1=lambda x: (x < 1).mean(),
        pct_lt_05=lambda x: (x < 0.5).mean(),
        pct_lt_0=lambda x: (x < 0).mean(),
    )
    t["mean_fiso_minus_fisr"] = d.groupby("discipline").apply(
        lambda x: (x["fiso"] - x["fisr"]).mean(), include_groups=False)
    t["mean_ro_minus_rr"] = d.groupby("discipline").apply(
        lambda x: (x["ro"] - x["rr"]).mean(), include_groups=False)
    return t.round(4)

print("\n=== (1) Per-domain summary (primary metric: relative_es = rr/ro) ===")
print(domain_table(df).to_string())

print("\nCross-check: project.x is perfectly confounded with discipline")
print("  Psychology = Cognitive + Social:",
      sorted(df.loc[df["project.x"]=="Psychology","discipline"].unique()))
print("  Experimental Economics = Economics:",
      sorted(df.loc[df["project.x"]=="Experimental Economics","discipline"].unique()))

def perm_test(a, b, n=20000, seed=42):
    a = np.asarray(a, dtype=float); b = np.asarray(b, dtype=float)
    obs = np.abs(a.mean() - b.mean())
    x = np.concatenate([a, b])
    rng = np.random.default_rng(seed)
    diffs = np.empty(n)
    for i in range(n):
        rng.shuffle(x)
        diffs[i] = np.abs(x[:len(a)].mean() - x[len(a):].mean())
    return (int((diffs >= obs).sum()) + 1) / (n + 1)

print("\n=== (2) Permutation tests on mean relative_es (20,000 resamples, seed=42) ===")
for g1, g2 in [("Social","Cognitive"), ("Social","Economics"), ("Cognitive","Economics")]:
    a = df.loc[df.discipline==g1, "relative_es"]; b = df.loc[df.discipline==g2, "relative_es"]
    p = perm_test(a, b)
    print(f"  {g1} (n={len(a)}, mean={a.mean():.4f}) vs {g2} (n={len(b)}, mean={b.mean():.4f}): "
          f"mean diff = {a.mean()-b.mean():+.4f}, permutation p = {p:.4f}")

print("\n=== (3) Sensitivity: drop row 41 (Eitam/Hassin/Schul; rr>0 but relative_es<0) ===")
r41 = df.iloc[41]
print(f"  Dropped row: study='{r41['study']}', discipline={r41['discipline']}, "
      f"ro={r41['ro']:.4f}, rr={r41['rr']:.4f}, relative_es={r41['relative_es']:.4f}")
d2 = df.drop(index=41)
print("  Per-domain table after drop:")
print("  " + domain_table(d2).to_string().replace("\n", "\n  "))
print("  Permutation p after drop:")
for g1, g2 in [("Social","Cognitive"), ("Social","Economics"), ("Cognitive","Economics")]:
    a = d2.loc[d2.discipline==g1, "relative_es"]; b = d2.loc[d2.discipline==g2, "relative_es"]
    p = perm_test(a, b)
    print(f"    {g1} (n={len(a)}) vs {g2} (n={len(b)}): p = {p:.4f}")

print("\n=== (4) Hypothesis ===")
print("In the Social (psychology) domain, original-study effect size estimates tend to "
      "be substantially larger than replication estimates: relative_es (replication/original) "
      "is lowest in Social (mean 0.278, median 0.131), effects shrink by at least half in "
      "about three-quarters of Social studies, and direction reversals are most frequent "
      "there. Experimental Economics shows the least original-vs-replication shrinkage "
      "(mean relative_es 0.657).")
