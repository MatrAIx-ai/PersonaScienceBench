"""
Analysis: Proportion of junior professors in replicated studies in Psychology
==============================================================================
Dataset: meta-regression_study_data_heterogeneity_in_replication_projects.csv
Question: What is the proportion of junior professors in replicated studies in Psychology?

Method:
  1. Filter for Psychology project (project == 'rpp')
  2. Filter for replicated studies (replicated == 1)
  3. Count junior professors (seniority.r == 'Assistant Professor')
  4. Compute proportion

Assumptions:
  - 'Junior professor' = 'Assistant Professor' (junior-most professorial rank)
  - 'Assistant' and 'Researcher' are non-professorial categories
  - seniority.r refers to the replication team's seniority
  - No drop filter applied (column has no meaningful description)
  - File 2 (replication_success_data) not needed (no seniority data)
"""

import pandas as pd

# Load data
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")

# Step 1: Filter for Psychology (project == 'rpp')
rpp = df[df['project'] == 'rpp'].copy()
print(f"Step 1 - RPP (Psychology) rows: {len(rpp)}")

# Step 2: Filter for replicated studies
rpp_rep = rpp[rpp['replicated'] == 1].copy()
print(f"Step 2 - RPP + replicated==1 rows: {len(rpp_rep)}")

# Step 3: Verify seniority.r values
print("\nStep 3 - seniority.r value counts (RPP replicated):")
print(rpp_rep['seniority.r'].value_counts().to_string())

# Check for whitespace/case issues
assert all(v == v.strip() for v in rpp_rep['seniority.r'].unique()), "Whitespace issue detected!"

# Step 4: Count junior professors (Assistant Professor)
junior_count = (rpp_rep['seniority.r'] == 'Assistant Professor').sum()
total = len(rpp_rep)
proportion = junior_count / total

print(f"\n{'='*50}")
print(f"RESULT:")
print(f"  Junior professors (Assistant Professor): {junior_count}")
print(f"  Total replicated RPP studies:            {total}")
print(f"  Proportion:                              {junior_count}/{total} = {proportion:.4f}")
print(f"  Proportion (rounded):                    {proportion:.1%}")
print(f"{'='*50}")
