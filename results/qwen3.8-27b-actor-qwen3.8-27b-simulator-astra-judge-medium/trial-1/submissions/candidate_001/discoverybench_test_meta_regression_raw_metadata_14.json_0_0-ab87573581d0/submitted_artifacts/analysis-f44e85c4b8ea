"""
Question: In which domain did both original and replication studies primarily use
student subjects (original: 82.4%, replication: 80.9%)?

Method:
- Load the study-level heterogeneity CSV (single table; no join with the
  replication_success CSV, which has no subjects/discipline fields).
- For each discipline (domain), compute the share of rows with
  subjects.o == 'students' (originals) and subjects.r == 'students' (replications).
- Missing subjects values (1 row, NaN in both) are treated as not-student;
  a variant excluding that row is reported as a sensitivity check.
- Rows are study x effect (id duplicated 786 times); a dedup-by-id
  (first row per id) sensitivity check confirms the answer is stable.
- 'drop' and 'aggregated' are meta-regression flags and are NOT used as filters
  for this descriptive question.
"""
import pandas as pd

PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(PATH)
print(f"rows: {len(df)}, columns: {df.shape[1]}")

def shares(d: pd.DataFrame) -> pd.DataFrame:
    t = d.groupby("discipline").agg(
        n=("id", "size"),
        orig_students_pct=("subjects.o", lambda s: (s == "students").mean() * 100),
        repl_students_pct=("subjects.r", lambda s: (s == "students").mean() * 100),
    ).round(2)
    return t

print("\n=== Main result: student-subject share by discipline (all rows, "
      "missing subjects treated as not-student) ===")
main = shares(df)
print(main)

dist = (main.orig_students_pct - 82.4).abs() + (main.repl_students_pct - 80.9).abs()
best = dist.idxmin()
print(f"\nDiscipline closest to stated targets (82.4% / 80.9%): {best}")

print("\n=== Sensitivity 1: exclude the single row with missing subjects ===")
nm = df["subjects.o"].notna() & df["subjects.r"].notna()
print(f"rows excluded: {(~nm).sum()}")
print(shares(df[nm]))

print("\n=== Sensitivity 2: deduplicate to first row per id (study level) ===")
dd = df.drop_duplicates(subset="id", keep="first")
print(f"rows after dedup: {len(dd)}")
print(shares(dd))

print("\n=== Cross-check with 'project' (not the chosen domain field) ===")
t = df.groupby("project").agg(
    n=("id", "size"),
    orig_students_pct=("subjects.o", lambda s: (s == "students").mean() * 100),
    repl_students_pct=("subjects.r", lambda s: (s == "students").mean() * 100),
).round(2)
print(t)
