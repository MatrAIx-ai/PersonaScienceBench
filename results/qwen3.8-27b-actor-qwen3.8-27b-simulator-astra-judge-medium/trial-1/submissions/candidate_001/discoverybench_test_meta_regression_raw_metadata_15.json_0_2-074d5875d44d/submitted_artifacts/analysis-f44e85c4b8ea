import pandas as pd

# Load the meta-regression study data
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")

# Filter to Experimental Economics project
ee = df[df['project'] == 'ee'].copy()

# Apply drop filter as a guard (all False for ee, but robust)
ee = ee[ee['drop'] == False]

# Denominator: total original EE studies
denominator = len(ee)

# Numerator: original EE studies conducted in the United Kingdom
numerator = (ee['experiment_country.o'] == 'United Kingdom').sum()

proportion = numerator / denominator

print(f"Total EE original studies (denominator): {denominator}")
print(f"EE original studies conducted in the United Kingdom (numerator): {numerator}")
print(f"Proportion: {numerator}/{denominator} = {proportion:.4f} ({proportion*100:.1f}%)")
print(f"\nAnswer: Approximately {proportion*100:.1f}% ({numerator} out of {denominator}) of original Experimental Economics studies in the dataset were conducted in the United Kingdom.")
