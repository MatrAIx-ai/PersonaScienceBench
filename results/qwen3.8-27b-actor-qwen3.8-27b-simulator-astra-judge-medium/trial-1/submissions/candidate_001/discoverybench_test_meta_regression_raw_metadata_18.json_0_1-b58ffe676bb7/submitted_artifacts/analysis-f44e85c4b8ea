import csv
from collections import Counter

fn = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
with open(fn) as f:
    rows = list(csv.DictReader(f))

ee = [x for x in rows if x['project'] == 'ee']
ids = set(x['id'] for x in ee)
print("ee rows:", len(ee), "| unique original study ids:", len(ids))

IN_PERSON = {"students", "community"}
lab = [x for x in ee if x['online'].strip() == '0' and x['subjects'].strip() in IN_PERSON] if False else \
      [x for x in ee if x['online.o'].strip() == '0' and x['subjects.o'].strip() in IN_PERSON]

print("online.o:", Counter(x['online.o'] for x in ee))
print("subjects.o:", Counter(x['subjects.o'] for x in ee))
print("lab (online.o==0 AND subjects.o in {students,community}):", len(lab), "/", len(ee))
print("proportion: {:.1%}".format(len(lab)/len(ee)))
print("corroboration online.r:", Counter(x['online.r'] for x in ee),
      "subjects.r:", Counter(x['subjects.r'] for x in ee))
