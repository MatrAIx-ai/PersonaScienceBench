import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# Filter to the two target projects, drop null lengths (safety step; none present)
sub = df[df['project'].isin(['ee', 'rpp'])].dropna(subset=['length'])

for p, name in [('ee', 'Experimental Economics'), ('rpp', 'Psychology')]:
    s = sub[sub['project'] == p]['length']
    print(f"{name} ({p}): n={len(s)} mean={s.mean():.2f} "
          f"median={s.median():.1f} min={s.min()} max={s.max()}")

ee_m  = sub[sub['project'] == 'ee']['length'].mean()
rpp_m = sub[sub['project'] == 'rpp']['length'].mean()
print(f"Difference: {ee_m - rpp_m:.2f} pages")
