# Analysis: In which domain do the majority of authors tend to be male
# for BOTH original and replication studies?
# Main spec:
#   - domain = discipline (Social / Cognitive / Economics)
#   - a study is male-majority iff authors_male.x > 0.5 (strict)
#   - original studies counted at id level (authors_male.o is id-constant)
#   - replication studies counted at row level (each lab's replication),
#     excluding drop=TRUE and aggregated=TRUE pooled rows
# Sensitivity specs: keep drop=TRUE; include aggregated=TRUE; ties >=0.5;
# replication unit = id-level.
import csv
from collections import defaultdict

F1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
rows = list(csv.DictReader(open(F1)))

# Assert no missingness in the relevant columns
for c in ['id', 'discipline', 'project', 'authors_male.o', 'authors_male.r']:
    assert all(r[c].strip() for r in rows), f"missing in {c}"

ids = defaultdict(list)
for r in rows:
    ids[r['id']].append(r)

def proportions(orig_unit, rep_unit, ge=False):
    """orig_unit/rep_unit: lists of (discipline, male_ratio)."""
    tab = {}
    for unit, key in ((orig_unit, 'o'), (rep_unit, 'r')):
        for d, m in unit:
            t = tab.setdefault(d, {'o': [0, 0], 'r': [0, 0]})
            t[key][1] += 1
            if (m >= 0.5) if ge else (m > 0.5):
                t[key][0] += 1
    return tab

def show(name, tab):
    print(f"\n=== {name}")
    print(f"{'domain':<12} {'orig >0.5':>12} {'orig prop':>10} {'rep >0.5':>10} {'rep prop':>10}")
    for d in sorted(tab):
        o, r = tab[d]['o'], tab[d]['r']
        print(f"{d:<12} {o[0]:>4}/{o[1]:<4}   {o[0]/o[1]:>8.3f} {r[0]:>4}/{r[1]:<4}   {r[0]/r[1]:>8.3f}")

# ---- Main spec ----
orig_main = [(v[0]['discipline'], float(v[0]['authors_male.o'])) for v in ids.values()
             if any(x['drop'] == 'FALSE' for x in v)]
rep_main = [(r['discipline'], float(r['authors_male.r'])) for r in rows
            if r['drop'] == 'FALSE' and r['aggregated'] != 'TRUE']
show("MAIN: orig id-level; rep row-level, drop=TRUE & aggregated=TRUE excluded, strict >0.5",
     proportions(orig_main, rep_main))

# ---- Sensitivity 1: keep drop=TRUE rows ----
orig_s1 = [(v[0]['discipline'], float(v[0]['authors_male.o'])) for v in ids.values()
           if any(x['drop'] == 'FALSE' for x in v) or True]
orig_s1 = [(v[0]['discipline'], float(v[0]['authors_male.o'])) for v in ids.values()]
rep_s1 = [(r['discipline'], float(r['authors_male.r'])) for r in rows if r['aggregated'] != 'TRUE']
show("SENS 1: keep drop=TRUE rows (aggregated still excluded)",
     proportions(orig_s1, rep_s1))

# ---- Sensitivity 2: include aggregated=TRUE rows (drop still excluded) ----
rep_s2 = [(r['discipline'], float(r['authors_male.r'])) for r in rows if r['drop'] == 'FALSE']
show("SENS 2: include aggregated=TRUE rows (drop=TRUE still excluded)",
     proportions(orig_main, rep_s2))

# ---- Sensitivity 3: ties at 0.5 counted as male-majority (>= 0.5) ----
show("SENS 3: ties at 0.5 counted as male-majority (>= 0.5), otherwise main spec",
     proportions(orig_main, rep_main, ge=True))

# ---- Sensitivity 4: replication unit = id-level (first row per id) ----
rep_s4 = [(v[0]['discipline'], float(v[0]['authors_male.r'])) for v in ids.values()
          if any(x['drop'] == 'FALSE' and x['aggregated'] != 'TRUE' for x in v)]
show("SENS 4: replication unit = id-level (first non-drop row per id)",
     proportions(orig_main, rep_s4))

# ---- Summary check: does any spec change the winner? ----
print("\n=== Winner check (domain with both proportions > 0.5 and highest min(orig,rep))")
for name, tab in [("MAIN", proportions(orig_main, rep_main)),
                  ("S1", proportions(orig_s1, rep_s1)),
                  ("S2", proportions(orig_main, rep_s2)),
                  ("S3", proportions(orig_main, rep_main, ge=True)),
                  ("S4", proportions(orig_main, rep_s4))]:
    best = None
    for d, t in tab.items():
        po, pr = t['o'][0]/t['o'][1], t['r'][0]/t['r'][1]
        if po > 0.5 and pr > 0.5:
            score = min(po, pr)
            if best is None or score > best[1]:
                best = (d, score, po, pr)
    print(f"{name}: {best}")
