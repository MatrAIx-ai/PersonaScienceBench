import pandas as pd, numpy as np
pd.set_option("display.width", 240)
pd.set_option("display.max_rows", 200)

df = pd.read_csv("data/nls_incarceration_processed.csv")
W = "composite_wealth_1985"

# normalize the 'hipanic' typo for reporting (keep as one category)
df["race"] = df["race"].map(lambda r: "hispanic" if r.lower() in ("hipanic","hispanic") else r)

JAILED = 1
def med(s): return float(s.median())
def med_pos(s): return float(s[s>0].median()) if (s>0).any() else np.nan

print("="*70)
print("FULL ANALYSIS: median 1985 wealth, demographic disparities among incarcerated")
print("="*70)

# ---------- 1) Overall jailed vs not-jailed ----------
print("\n### 1) OVERALL: ever_jailed==1 vs 0 (median composite_wealth_1985) ###")
ov = df.groupby("ever_jailed")[W].agg(n="count", median=med, median_pos_only=med_pos,
                                      pct_nonpos=lambda s: round((s<=0).mean()*100,1),
                                      pct_zero=lambda s: round((s==0).mean()*100,1))
print(ov)
m_j = med(df.loc[df.ever_jailed==1, W]); m_n = med(df.loc[df.ever_jailed==0, W])
print(f"\nGap (jailed - not): {m_j - m_n:,.0f}  |  Ratio jailed/not: {m_j/m_n:.2f}")

# ---------- 2) WITHIN incarcerated: within-group disparities (LEAD) ----------
print("\n### 2) WITHIN ever_jailed==1: median 1985 wealth by race, sex, race x sex ###")
j = df[df.ever_jailed==1]
print("-- by race --")
print(j.groupby("race")[W].agg(n="count", median=med, median_pos_only=med_pos))
print("-- by sex --")
print(j.groupby("sex")[W].agg(n="count", median=med, median_pos_only=med_pos))
print("-- by race x sex (LEAD table) --")
print(j.groupby(["race","sex"])[W].agg(n="count", median=med, median_pos_only=med_pos,
                                       pct_nonpos=lambda s: round((s<=0).mean()*100,1)))

# ---------- 3) Interaction: race x sex x ever_jailed ----------
print("\n### 3) INTERACTION: median 1985 wealth by race x sex x ever_jailed ###")
full = df.groupby(["race","sex","ever_jailed"])[W].agg(n="count", median=med,
                                                       median_pos_only=med_pos,
                                                       pct_nonpos=lambda s: round((s<=0).mean()*100,1))
print(full)

# gap table (jailed - not) within each race x sex
print("\n-- gap (jailed - not) by race x sex --")
gaps = []
for (r,s), sub in df.groupby(["race","sex"]):
    mj = sub.loc[sub.ever_jailed==1, W]; mn = sub.loc[sub.ever_jailed==0, W]
    gaps.append(dict(race=r, sex=s, n_jailed=len(mj), n_not=len(mn),
                     med_jailed=med(mj), med_not=med(mn), gap=med(mj)-med(mn),
                     ratio=(med(mj)/med(mn) if med(mn)!=0 else np.nan)))
print(pd.DataFrame(gaps))

# ---------- 4) Incarceration incidence ----------
print("\n### 4) Incarceration incidence (ever_jailed rate) by race x sex ###")
inc = df.groupby(["race","sex"])["ever_jailed"].agg(n="count", rate=lambda s: round(s.mean()*100,2))
print(inc)
print(f"Overall incarceration rate: {df.ever_jailed.mean()*100:.2f}%  "
      f"(jailed={int(df.ever_jailed.sum())}/{len(df)})")

# ---------- 5) Sensitivity: positive-only, overall ----------
print("\n### 5) SENSITIVITY: positive-wealth-only medians (footnote) ###")
print(f"Overall  jailed pos-only median: {med_pos(df.loc[df.ever_jailed==1,W]):,.0f}  "
      f"(vs all {m_j:,.0f})")
print(f"Overall  not   pos-only median: {med_pos(df.loc[df.ever_jailed==0,W]):,.0f}  "
      f"(vs all {m_n:,.0f})")
