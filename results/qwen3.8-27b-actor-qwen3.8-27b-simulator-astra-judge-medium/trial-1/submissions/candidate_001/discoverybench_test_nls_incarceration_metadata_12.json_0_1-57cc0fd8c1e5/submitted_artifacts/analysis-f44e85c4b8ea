import pandas as pd, numpy as np
from scipy import stats

df = pd.read_csv('data/nls_incarceration_processed.csv')
b = df[df.race == 'black'].copy()
print(f"Black respondents: n={len(b)}; jailed={int(b.ever_jailed.sum())}; non-jailed={int((b.ever_jailed==0).sum())}")

# Baseline-wealth proxy strata: tertiles of composite_wealth_1985
q1, q2 = b.composite_wealth_1985.quantile([1/3, 2/3])
print(f"1985 wealth tertile cutpoints: {q1}, {q2}")
b['wealth_tertile'] = pd.cut(b.composite_wealth_1985,
                             bins=[-np.inf, q1, q2, np.inf],
                             labels=['low', 'mid', 'high'])

def winsor(s, lo=0.01, hi=0.99):
    a, z = s.quantile(lo), s.quantile(hi)
    return s.clip(a, z)

def compare(sub, col):
    j = sub[sub.ever_jailed == 1][col]; n = sub[sub.ever_jailed == 0][col]
    u, p = stats.mannwhitneyu(j, n, alternative='two-sided')
    wd = winsor(j).mean() - winsor(n).mean()
    return dict(n_jailed=len(j), n_non=len(n),
                med_jailed=j.median(), med_non=n.median(),
                med_diff=j.median()-n.median(),
                mw_p=p, winsor_diff=wd)

b['change_1990'] = b.composite_wealth_1990 - b.composite_wealth_1985
b['change_1996'] = b.composite_wealth_1996 - b.composite_wealth_1985

out = []
for t in ['low', 'mid', 'high']:
    sub = b[b.wealth_tertile == t]
    for col, lab in [('composite_wealth_1990','wealth_1990'),
                     ('composite_wealth_1996','wealth_1996'),
                     ('change_1990','change_1990'), ('change_1996','change_1996')]:
        out.append(dict(stratum=t, variable=lab, **compare(sub, col)))
res = pd.DataFrame(out)

print("\n=== By baseline-wealth tertile (Black respondents) ===")
pd.set_option('display.width', 200)
print(res.round(1).to_string(index=False))

print("\n=== Overall (unstratified, Black) ===")
for col, lab in [('composite_wealth_1990','wealth_1990'), ('composite_wealth_1996','wealth_1996'),
                 ('change_1990','change_1990'), ('change_1996','change_1996')]:
    r = compare(b, col); r['variable']=lab
    print(r)

print("\n=== Sensitivity: Black males only ===")
bm = b[b.sex=='male']
print(f"n={len(bm)}, jailed={int(bm.ever_jailed.sum())}")
for col, lab in [('composite_wealth_1996','wealth_1996'), ('change_1996','change_1996')]:
    r = compare(bm, col); r['variable']=lab
    print(r)

# Baseline-wealth descriptives by stratum
print("\n=== Stratum baseline (1985) wealth medians ===")
print(b.groupby('wealth_tertile', observed=True).agg(
    n_jailed=('ever_jailed','sum'),
    n_total=('ever_jailed','size'),
    w1985_med=('composite_wealth_1985','median'),
    w1990_med=('composite_wealth_1990','median'),
    w1996_med=('composite_wealth_1996','median')))
