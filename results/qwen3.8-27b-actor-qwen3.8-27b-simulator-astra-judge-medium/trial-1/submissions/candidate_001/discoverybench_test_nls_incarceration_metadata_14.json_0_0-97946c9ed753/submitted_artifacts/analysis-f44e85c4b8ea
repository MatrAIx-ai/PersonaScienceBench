import pandas as pd

CSV = "data/nls_incarceration_processed.csv"
YEARS = [1985, 1990, 1996]

df = pd.read_csv(CSV)

# Guard: confirm no missing values in the columns we rely on
key_cols = ["race", "sex"] + [f"composite_wealth_{y}" for y in YEARS]
assert df[key_cols].isnull().sum().sum() == 0, "Unexpected missing values"

# (a) Filter to black females
bf = df[(df["race"] == "black") & (df["sex"] == "female")]
n = len(bf)

# (b) Median composite wealth per year
medians = {y: bf[f"composite_wealth_{y}"].median() for y in YEARS}

# (c) Absolute change in median wealth across consecutive intervals
deltas = {}
for a, b in zip(YEARS, YEARS[1:]):
    deltas[(a, b)] = medians[b] - medians[a]

# Full span (context only, not a candidate interval)
full_span = medians[YEARS[-1]] - medians[YEARS[0]]

print(f"Black females n = {n}")
print("Medians:")
for y in YEARS:
    print(f"  {y}: {medians[y]:.0f}")
print("Consecutive interval deltas (absolute change in median):")
for (a, b), d in deltas.items():
    print(f"  {a}->{b}: +{d:.0f}")
print(f"Full span 1985->1996 (context only): +{full_span:.0f}")

winner = max(deltas, key=deltas.get)
print(f"Largest single-interval increase: {winner[0]} -> {winner[1]} (+{deltas[winner]:.0f})")
