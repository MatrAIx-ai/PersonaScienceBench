"""
Full analysis: changes in wealth inequality for white males vs. white females, 1990 -> 1996.
Data: data/nls_incarceration_processed.csv (NLSY79-derived: race, sex, ever_jailed, composite wealth 1985/1990/1996)
"""
import pandas as pd
import numpy as np

def gini(x):
    x = np.sort(np.asarray(x, dtype=float))
    n = len(x)
    s = x.sum()
    if n == 0 or s == 0:
        return np.nan
    return (2.0 * np.sum(np.arange(1, n + 1) * x) - (n + 1) * s) / (n * s)

def stats_block(v):
    v = np.asarray(v, dtype=float)
    pos = v[v > 0]
    return {
        "n": int(len(v)),
        "zero_share": float((v == 0).mean()),
        "neg_share": float((v < 0).mean()),
        "mean": float(v.mean()),
        "median": float(np.median(v)),
        "std": float(v.std(ddof=1)),
        "cv": float(v.std(ddof=1) / v.mean()),
        "gini_all": gini(v),
        "n_pos": int(len(pos)),
        "gini_pos": gini(pos),
        "p90": float(np.percentile(v, 90)),
        "p95": float(np.percentile(v, 95)),
        "p99": float(np.percentile(v, 99)),
        "max": float(v.max()),
    }

df = pd.read_csv("data/nls_incarceration_processed.csv")
w = df[df["race"] == "white"].copy()

rows = []
for sex in ["male", "female"]:
    for year in [1990, 1996]:
        col = f"composite_wealth_{year}"
        st = stats_block(w.loc[w["sex"] == sex, col])
        st["sex"], st["year"] = sex, year
        rows.append(st)

tbl = pd.DataFrame(rows).set_index(["sex", "year"])
cols = ["n", "zero_share", "neg_share", "mean", "median", "std", "cv",
        "gini_all", "n_pos", "gini_pos", "p90", "p95", "p99", "max"]
print("=== SUMMARY TABLE: white respondents, composite wealth 1990 vs 1996 ===")
print(tbl[cols].round(3).to_string())

print("\n=== CHANGES 1990 -> 1996 (within sex) ===")
for sex in ["male", "female"]:
    a, b = tbl.loc[(sex, 1990)], tbl.loc[(sex, 1996)]
    print(f"{sex}: zero_share {a['zero_share']:.3f}->{b['zero_share']:.3f} "
          f"(+{b['zero_share']-a['zero_share']:.3f}); "
          f"gini_all {a['gini_all']:.3f}->{b['gini_all']:.3f} (d={b['gini_all']-a['gini_all']:+.3f}); "
          f"gini_pos {a['gini_pos']:.3f}->{b['gini_pos']:.3f} (d={b['gini_pos']-a['gini_pos']:+.3f}); "
          f"cv {a['cv']:.3f}->{b['cv']:.3f}; median {a['median']:.0f}->{b['median']:.0f}; "
          f"mean {a['mean']:.0f}->{b['mean']:.0f}")

print("\n=== MALE-vs-FEMALE GAP (same year) ===")
for year in [1990, 1996]:
    m, f = tbl.loc[("male", year)], tbl.loc[("female", year)]
    print(f"{year}: mean gap (m-f) {m['mean']-f['mean']:+.0f}; median gap {m['median']-f['median']:+.0f}; "
          f"gini_all gap {m['gini_all']-f['gini_all']:+.3f}; gini_pos gap {m['gini_pos']-f['gini_pos']:+.3f}; "
          f"zero_share gap {m['zero_share']-f['zero_share']:+.3f}")

print("\n=== SENSITIVITY: exclude ever_jailed==1 ===")
wj = w[w["ever_jailed"] == 0]
for sex in ["male", "female"]:
    for year in [1990, 1996]:
        col = f"composite_wealth_{year}"
        v = wj.loc[wj["sex"] == sex, col].to_numpy()
        print(f"{sex} {year}: n={len(v)} gini_all={gini(v):.3f} gini_pos={gini(v[v>0]):.3f} zero_share={(v==0).mean():.3f}")

print("\n=== CONTEXT: ever_jailed among white subgroups ===")
print(pd.crosstab(w["sex"], w["ever_jailed"]).to_string())
