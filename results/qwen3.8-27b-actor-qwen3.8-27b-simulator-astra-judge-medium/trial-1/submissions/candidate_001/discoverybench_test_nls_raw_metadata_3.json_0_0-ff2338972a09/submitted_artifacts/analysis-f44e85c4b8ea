import pandas as pd, numpy as np
import statsmodels.formula.api as smf
import statsmodels.api as sm
import warnings
warnings.filterwarnings("ignore")

df = pd.read_csv('data/nls_raw.csv')
cols = list(df.columns)

# ---- Outcome: 1979 highest grade completed (proxy for education attainment) ----
g = df["Highest grade completed, 1979"].copy()
g[g == 95] = np.nan                       # special code -> missing
df["grade1979"] = g
df["ba16"] = (df["grade1979"] >= 16).astype(float)
df.loc[df["grade1979"].isna(), "ba16"] = np.nan

# ---- Race dummies (ref = 3 non-Black/non-Hispanic) ----
df["black"]   = (df["Racial/ethnic cohort, 1979"] == 1).astype(int)
df["hispanic"]= (df["Racial/ethnic cohort, 1979"] == 2).astype(int)

# ---- SES: pre-1979/1979 only ----
inc79 = df["Total net family income, previous calendar year, 1979"]
df["loginc79"] = np.log1p(inc79)          # log(1+x), keeps zeros
df["mothgrade"] = df["Highest grade completed by respondent's mother, 1979"]
df["fathgrade"] = df["Highest grade completed by respondent's father, 1979"]

# ---- Academic characteristics (1981) ----
asv = [df[c] for c in cols if c.startswith("ASVAB")]
df["asvab_comp"] = pd.concat(asv, axis=1).mean(axis=1)   # mean of 4 sections
rk = df["Rank in class last year attended at this school, 1981"]
sz = df["Number of students in class last year attended at this school, 1981"]
df["rank_pct"] = 1 - rk/sz                 # percentile, 1=top; clip rank>size
df.loc[df["rank_pct"] < 0, "rank_pct"] = 0.0

# ---- Modeling set (complete case) ----
base_vars  = ["black","hispanic","loginc79","mothgrade","fathgrade"]
acad_vars  = ["asvab_comp","rank_pct"]
need = base_vars + acad_vars + ["grade1979","ba16"]
m = df[need].dropna().copy()
print("Full sample:", len(df))
print("Complete-case modeling set (all vars):", len(m))
m_base = df[base_vars+["grade1979","ba16"]].dropna()
print("Complete-case for baseline set only:", len(m_base))
print("ba16==1 in full sample:", int((df.ba16==1).sum()),
      "| in modeling set:", int((m.ba16==1).sum()),
      "| in baseline set:", int((m_base.ba16==1).sum()))
print("\nModeling-set descriptives:")
print(m[["grade1979","black","hispanic","loginc79","mothgrade","fathgrade","asvab_comp","rank_pct"]].describe().round(2).to_string())

def report(res, label):
    print(f"\n--- {label} ---")
    print(f"n={int(res.nobs)}  R2={res.rsquared:.4f}" if hasattr(res,'rsquared') else f"n={int(res.nobs)}  PseudoR2={res.prsquared:.4f}")
    for v in ["black","hispanic","loginc79","mothgrade","fathgrade","asvab_comp","rank_pct"]:
        if v in res.params.index:
            print(f"  {v:12s} coef={res.params[v]: .4f}  se={res.bse[v]: .4f}  p={res.pvalues[v]: .4f}")
    return res

# ================= OLS : continuous grade1979 =================
print("\n\n################  CONTINUOUS grade1979 (OLS)  ################")
ols_base = smf.ols("grade1979 ~ black + hispanic + loginc79 + mothgrade + fathgrade", data=m).fit()
report(ols_base, "OLS BASELINE (race + SES)")
ols_aug  = smf.ols("grade1979 ~ black + hispanic + loginc79 + mothgrade + fathgrade + asvab_comp + rank_pct", data=m).fit()
report(ols_aug,  "OLS AUGMENTED (+ academic)")

# ================= Logit : ba16 binary =================
print("\n\n################  BINARY ba16 (logit)  ################")
try:
    lo_base = smf.logit("ba16 ~ black + hispanic + loginc79 + mothgrade + fathgrade", data=m).fit(disp=0)
    report(lo_base, "LOGIT BASELINE (race + SES)")
    lo_aug  = smf.logit("ba16 ~ black + hispanic + loginc79 + mothgrade + fathgrade + asvab_comp + rank_pct", data=m).fit(disp=0)
    report(lo_aug,  "LOGIT AUGMENTED (+ academic)")
except Exception as e:
    print("logit failed (degenerate cell):", e)

# ================= LPM : ba16 binary (OLS) =================
print("\n\n################  BINARY ba16 (Linear Probability)  ################")
lpm_base = smf.ols("ba16 ~ black + hispanic + loginc79 + mothgrade + fathgrade", data=m).fit()
report(lpm_base, "LPM BASELINE (race + SES)")
lpm_aug  = smf.ols("ba16 ~ black + hispanic + loginc79 + mothgrade + fathgrade + asvab_comp + rank_pct", data=m).fit()
report(lpm_aug,  "LPM AUGMENTED (+ academic)")

# ================= Attenuation summary (continuous OLS) =================
print("\n\n################  ATTENUATION SUMMARY (OLS continuous)  ################")
print(f"{'var':12s} {'baseline':>10s} {'augmented':>10s} {'delta':>10s} {'%change':>8s}")
for v in ["black","hispanic","loginc79","mothgrade","fathgrade"]:
    b, a = ols_base.params[v], ols_aug.params[v]
    print(f"{v:12s} {b:10.4f} {a:10.4f} {a-b:10.4f} {100*(a-b)/abs(b):7.1f}%")
print("\nAdded academic controls:")
for v in ["asvab_comp","rank_pct"]:
    print(f"  {v:12s} coef={ols_aug.params[v]: .4f}  p={ols_aug.pvalues[v]: .4f}")
print(f"R2 baseline={ols_base.rsquared:.4f}  augmented={ols_aug.rsquared:.4f}  (ΔR2={ols_aug.rsquared-ols_base.rsquared:.4f})")
