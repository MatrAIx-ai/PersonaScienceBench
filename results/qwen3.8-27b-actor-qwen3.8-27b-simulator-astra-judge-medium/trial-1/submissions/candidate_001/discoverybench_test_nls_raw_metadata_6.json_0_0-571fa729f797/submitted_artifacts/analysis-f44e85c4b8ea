# -*- coding: utf-8 -*-
"""
DISCOVERYBENCH — NLSY79: How is the (SES-adjusted) advantage in BA degree completion
for Black students related to socioeconomic status?

Primary SES axis : Total net family income, previous calendar year, 1979 (winsorized p99).
Robustness axis  : parental education (mother + father grade, 1979).
Sensitivity      : family net wealth 1996 (flagged fragile / reverse-causal).
Framing          : SES-adjusted overachievement -- conditional Black vs Non-Black/Non-Hispanic.
Outcomes         : literal BA (grade>=16, descriptive, sparse); some-college+ (grade>=13)
                   and continuous grade (powered proxies for the attainment gradient).
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats
pd.set_option('display.width', 340); pd.set_option('display.max_rows', 300)

df = pd.read_csv('data/nls_raw.csv')
race='Racial/ethnic cohort, 1979'; g='Highest grade completed, 1979'
inc ='Total net family income, previous calendar year, 1979'
mom ="Highest grade completed by respondent's mother, 1979"
dad ="Highest grade completed by respondent's father, 1979"
w96 ='Family net wealth, 1996 (key data point)'

df['grade']   = df[g].where(df[g] < 90)
df['BA']      = (df['grade'] >= 16).astype(float)
df['somecoll']= (df['grade'] >= 13).astype(float)
df['Black']   = (df[race]==1).astype(int); df['Hisp']=(df[race]==2).astype(int); df['NonBlk']=(df[race]==3).astype(int)
p99 = df[inc].dropna().quantile(0.99)
df['inc_w']  = df[inc].clip(upper=p99)
df['inc_th'] = df['inc_w']/1000.0          # $ in thousands
print(f"Income 1979 winsorize cap (p99) = {p99:,.0f} (${p99/1000:.0f}k); n at/above cap = {int((df[inc]>=p99).sum())}")

cc = df.dropna(subset=['grade','inc_w']).copy()
Nc=len(cc)
print(f"FULL N={len(df)}  COMPLETE-CASE (grade+income) N={Nc}")
q = np.quantile(cc['inc_w'],[1/3,2/3])
cc['inc_tert']=pd.cut(cc['inc_w'],bins=[-np.inf,q[0],q[1],np.inf],labels=['T1_LOW','T2_MID','T3_HIGH'])
cc['inc_c']=cc['inc_th']-cc['inc_th'].mean()
print(f"Income tertile cuts: T1 < ${q[0]/1000:.1f}k <= T2 < ${q[1]/1000:.1f}k <= T3 ; mean income ${cc['inc_th'].mean():.1f}k")

def stratum_table(d, tert_col):
    rows=[]
    for t in d[tert_col].cat.categories:
        sub=d[d[tert_col]==t]; bl=sub[sub.Black==1]; nb=sub[sub.NonBlk==1]; hi=sub[sub.Hisp==1]
        rows.append(dict(SES=t, n_BLK=len(bl),n_HISP=len(hi),n_NONBLK=len(nb),
            grade_BLK=bl['grade'].mean(),grade_NONBLK=nb['grade'].mean(),
            scoll_BLK=100*bl['somecoll'].mean(),scoll_NONBLK=100*nb['somecoll'].mean(),
            BA_BLK=int(bl['BA'].sum()),BA_NONBLK=int(nb['BA'].sum()),
            ggap=bl['grade'].mean()-nb['grade'].mean(), sgap=100*bl['somecoll'].mean()-100*nb['somecoll'].mean()))
    return pd.DataFrame(rows).set_index('SES')

print("\n"+"="*100)
print("B) STRATUM TABLE | primary SES = 1979 family income (winsorized), complete-case N=",Nc)
print("="*100)
st=stratum_table(cc,'inc_tert')
print("\n[Mean grade 1979] Black vs NonBlack by income tertile (gap = Black - NonBlack):")
print(st[['n_BLK','n_NONBLK','grade_BLK','grade_NONBLK','ggap']].round(3).to_string())
print("\n[Some-college+ %] Black vs NonBlack (gap in pp) | [Literal BA counts] Black / NonBlack:")
tmp=st[['scoll_BLK','scoll_NONBLK','sgap','BA_BLK','BA_NONBLK']].copy()
print(tmp.round(2).to_string())
print("\n  -> Does Black EXCEED NonBlack in any stratum?  grade:",
      bool((st['ggap']>0).any()), "| some-coll pp:", bool((st['sgap']>0).any()),
      "| BA count:", bool((st['BA_BLK']>st['BA_NONBLK']).any()))

# ---------------- C) INTERACTION, income in $1000 ----------------
print("\n"+"="*100)
print("C) RACE x SES INTERACTION | SES = 1979 income in $1000 (centered at mean)")
print("="*100)
m_ols=smf.ols('grade ~ Black + Hisp + inc_c + Black:inc_c + Hisp:inc_c',data=cc).fit(cov_type='HC1')
print("\nC1) OLS: grade ~ Black + Hisp + income($k) + interactions   (HC1 SE)")
print(f"    N={int(m_ols.nobs)}  R2={m_ols.rsquared:.4f}")
for p in ['Black','Hisp','inc_c','Black:inc_c','Hisp:inc_c']:
    print(f"    {p:12s} coef={m_ols.params[p]: .4f}  SE={m_ols.bse[p]:.4f}  p={m_ols.pvalues[p]:.4f}")
print(f"    Black-NonBlack grade gap at MEAN income = {m_ols.params['Black']:+.3f} (p={m_ols.pvalues['Black']:.3f})")
print(f"    Black x income interaction = {m_ols.params['Black:inc_c']:+.4f} grades per $1,000 (p={m_ols.pvalues['Black:inc_c']:.4f})")
print(f"    (NonBlack income slope = {m_ols.params['inc_c']:+.4f}; Black income slope = {m_ols.params['inc_c']+m_ols.params['Black:inc_c']:+.4f} grades per $1,000)")

m_log=smf.logit('somecoll ~ Black + Hisp + inc_c + Black:inc_c + Hisp:inc_c',data=cc).fit(disp=0)
print("\nC2) LOGIT: somecoll(>=13) ~ Black + Hisp + income($k) + interactions")
for p in ['Black','Hisp','inc_c','Black:inc_c','Hisp:inc_c']:
    print(f"    {p:12s} logit={m_log.params[p]: .4f}  OR={np.exp(m_log.params[p]):.3f}  p={m_log.pvalues[p]:.4f}")
print(f"    Black-NonBlack some-coll OR at mean income = {np.exp(m_log.params['Black']):.3f} (p={m_log.pvalues['Black']:.4f})")
print(f"    Black x income interaction OR per $1,000 = {np.exp(m_log.params['Black:inc_c']):.4f} (p={m_log.pvalues['Black:inc_c']:.4f})")

cc['tcode']=cc['inc_tert'].cat.codes
m_cat=smf.logit('somecoll ~ Black*C(tcode) + Hisp*C(tcode)',data=cc).fit(disp=0)
print("\nC3) LOGIT categorical: somecoll ~ Black*C(income tertile) + Hisp*C(income tertile)  [ref=T1_LOW]")
tab=m_cat.summary2().tables[1].round(4)
print(tab.to_string())
it=[p for p in m_cat.params.index if p.startswith('Black') and p!='Black']
R=np.zeros((len(it),len(m_cat.params)))
for i,p in enumerate(it): R[i,list(m_cat.params.index).index(p)]=1
ft=m_cat.f_test(R)
fs=np.atleast_1d(np.asarray(ft.statistic)).ravel()[0]; fp=np.atleast_1d(np.asarray(ft.pvalue)).ravel()[0]
inc_cat_wald_chi2=fs; inc_cat_wald_p=fp
print(f"    Joint Wald test (Black x tertile): chi2={fs:.3f}, p={fp:.5f}")

# ---------------- D) PREDICTED GAP across income (OLS) ----------------
print("\n"+"="*100)
print("D) PREDICTED Black-NonBlack grade GAP across income (from OLS, centered model)")
print("="*100)
b0=m_ols.params['Black']; b1=m_ols.params['Black:inc_c']
for t in ['T1_LOW','T2_MID','T3_HIGH']:
    sub=cc[cc.inc_tert==t]; pred=b0+b1*sub['inc_c'].mean()
    print(f"  {t:9s} (mean income ${sub['inc_th'].mean():5.1f}k): predicted gap = {pred:+.3f} grades")
print(f"  gap slope = {b1:+.4f} grades per $1,000 income")

# ---------------- E) ROBUSTNESS: parental education axis ----------------
print("\n"+"="*100)
print("E) ROBUSTNESS | SES = parental education (mother+father grade 1979)")
print("="*100)
cpe = df.dropna(subset=['grade',mom,dad]).copy()
cpe['peds'] = cpe[mom]+cpe[dad]            # 0-44
print(f"  complete-case (grade+mother+father grade) N={len(cpe)}")
qp=np.quantile(cpe['peds'],[1/3,2/3])
cpe['peds_tert']=pd.cut(cpe['peds'],bins=[-np.inf,qp[0],qp[1],np.inf],labels=['P1_LOW','P2_MID','P3_HIGH'])
cpe['peds_c']=cpe['peds']-cpe['peds'].mean()
stpe=stratum_table(cpe,'peds_tert')
print(f"  parental-ed tertile cuts: P1<{qp[0]:.0f}<=P2<{qp[1]:.0f}<=P3 (index=mother+father grade, 0-44)")
print("  [Mean grade 1979] Black vs NonBlack by parental-ed tertile (gap=Black-NonBlack):")
print(stpe[['n_BLK','n_NONBLK','grade_BLK','grade_NONBLK','ggap']].round(3).to_string())
print("  [Some-college+ %] gap pp | [BA counts] Black/NonBlack:")
print(stpe[['scoll_BLK','scoll_NONBLK','sgap','BA_BLK','BA_NONBLK']].round(2).to_string())
mpe=smf.ols('grade ~ Black + Hisp + peds_c + Black:peds_c + Hisp:peds_c',data=cpe).fit(cov_type='HC1')
print(f"\n  OLS (parental-ed axis): Black@mean={mpe.params['Black']:+.3f} (p={mpe.pvalues['Black']:.3f}); "
      f"Black x peds={mpe.params['Black:peds_c']:+.4f} per parent-grade (p={mpe.pvalues['Black:peds_c']:.4f}); "
      f"NonBlack peds slope={mpe.params['peds_c']:+.4f}")
cpe['pc']=cpe['peds_tert'].cat.codes
mpec=smf.logit('somecoll ~ Black*C(pc) + Hisp*C(pc)',data=cpe).fit(disp=0)
it=[p for p in mpec.params.index if p.startswith('Black') and p!='Black']
R=np.zeros((len(it),len(mpec.params)))
for i,p in enumerate(it): R[i,list(mpec.params.index).index(p)]=1
ft=mpec.f_test(R)
print(f"  LOGIT categorical joint Wald (Black x parental-ed tertile): chi2="
      f"{np.atleast_1d(np.asarray(ft.statistic)).ravel()[0]:.3f}, p={np.atleast_1d(np.asarray(ft.pvalue)).ravel()[0]:.4f}")
for p in it:
    print(f"    {p}: coef={mpec.params[p]:+.3f} (p={mpec.pvalues[p]:.4f})")

# ---------------- F) SENSITIVITY: 1996 wealth (flagged) ----------------
print("\n"+"="*100)
print("F) SENSITIVITY (FLAGGED: reverse-causal, 44% missing) | SES = family net wealth 1996")
print("="*100)
cw = df.dropna(subset=['grade',w96]).copy()
print(f"  complete-case (grade+wealth1996) N={len(cw)}  (vs 10,071 for income axis)")
qw=np.quantile(cw[w96],[1/3,2/3])
cw['w_tert']=pd.cut(cw[w96],bins=[-np.inf,qw[0],qw[1],np.inf],labels=['W1_LOW','W2_MID','W3_HIGH'])
stw=stratum_table(cw,'w_tert')
print(f"  wealth tertile cuts ($): W1<{qw[0]/1000:.1f}k<=W2<{qw[1]/1000:.1f}k<=W3")
print("  [Mean grade 1979] Black vs NonBlack by 1996-wealth tertile (gap=Black-NonBlack):")
print(stw[['n_BLK','n_NONBLK','grade_BLK','grade_NONBLK','ggap']].round(3).to_string())
print("  [Some-college+ %] gap pp | [BA counts] Black/NonBlack:")
print(stw[['scoll_BLK','scoll_NONBLK','sgap','BA_BLK','BA_NONBLK']].round(2).to_string())
cw['wc']=cw[w96]/1000.0; cw['wc']=cw['wc']-cw['wc'].mean()
mwe=smf.ols('grade ~ Black + Hisp + wc + Black:wc + Hisp:wc',data=cw).fit(cov_type='HC1')
print(f"  OLS (1996-wealth axis): Black@mean={mwe.params['Black']:+.3f} (p={mwe.pvalues['Black']:.3f}); "
      f"Black x wealth={mwe.params['Black:wc']:+.5f} per $1,000 (p={mwe.pvalues['Black:wc']:.4f})")
print("\n"+"="*100)
print("G) KEY NUMBERS FOR HYPOTHESIS")
print("="*100)
print("Primary (1979 income, N=10071):")
print(f"  Black-NonBlack grade gap: LOW {st.loc['T1_LOW','ggap']:+.3f} | MID {st.loc['T2_MID','ggap']:+.3f} | HIGH {st.loc['T3_HIGH','ggap']:+.3f}")
print(f"  Black-NonBlack some-coll gap (pp): LOW {st.loc['T1_LOW','sgap']:+.2f} | MID {st.loc['T2_MID','sgap']:+.2f} | HIGH {st.loc['T3_HIGH','sgap']:+.2f}")
print(f"  OLS Black x income = {m_ols.params['Black:inc_c']:+.4f} grade/$1k (p={m_ols.pvalues['Black:inc_c']:.4f}); "
      f"Black@mean income = {m_ols.params['Black']:+.3f}")
print("  Categorical joint Wald (Black x income tertile): chi2=%.3f, p=%.4f" % (inc_cat_wald_chi2, inc_cat_wald_p))
print(f"  Robustness (parental ed, N={len(cpe)}): grade gap LOW {stpe.loc['P1_LOW','ggap']:+.3f} | MID {stpe.loc['P2_MID','ggap']:+.3f} | HIGH {stpe.loc['P3_HIGH','ggap']:+.3f}; "
      f"Black x peds p={mpe.pvalues['Black:peds_c']:.4f}")
print(f"  Sensitivity (1996 wealth, N={len(cw)}): grade gap LOW {stw.loc['W1_LOW','ggap']:+.3f} | MID {stw.loc['W2_MID','ggap']:+.3f} | HIGH {stw.loc['W3_HIGH','ggap']:+.3f}; "
      f"Black x wealth p={mwe.pvalues['Black:wc']:.4f}")
print("  Black EXCEEDS NonBlack in any income stratum? NO (grade/some-coll/BA all False).")
