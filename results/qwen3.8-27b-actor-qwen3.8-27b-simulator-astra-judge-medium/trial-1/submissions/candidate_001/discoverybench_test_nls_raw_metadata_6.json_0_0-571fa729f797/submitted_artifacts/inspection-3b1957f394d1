# -*- coding: utf-8 -*-
"""Inspection readout for data/nls_raw.csv (NLSY79 extract).
Reproduces all numbers in the plan handoff. Descriptive only -- no full analysis.
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 300); pd.set_option('display.max_rows', 200)

df = pd.read_csv('data/nls_raw.csv')
race = 'Racial/ethnic cohort, 1979'
g    = 'Highest grade completed, 1979'
age  = 'Age of respondent, 1979'
RACE = {1:'BLACK', 2:'HISPANIC', 3:'NONBLK/NONHISP'}
N = len(df)
print(f"N = {N} rows, {df.shape[1]} cols")

print("\n== RACE (no missingness) ==")
print(df[race].value_counts().to_string())

print("\n== GRADE 1979 ==")
print("missing:", int(df[g].isna().sum()), f"({100*df[g].isna().mean():.2f}%)  range {df[g].min():.0f}-{df[g].max():.0f}")
print("code 95 (don't-know) rows: n =", int((df[g]==95).sum()),
      "-> ages", df.loc[df[g]==95, age].tolist())
df['ba'] = (df[g]>=16) & (df[g]<90)          # literal BA, excl DK code
for val,name in RACE.items():
    m = df[race]==val
    print(f"  {name:14s} n={int(m.sum()):5d} mean_grade={df.loc[m,g].mean():.2f} "
          f"  BA(>=16)={int(df.loc[m,'ba'].sum()):3d} = {100*df.loc[m,'ba'].mean():.3f}%")

print("\n== Education thresholds by race (excl DK code 95) ==")
for thr,lbl in [(12,'HS grad >=12'),(13,'some coll >=13'),(14,'>=14'),(15,'>=15'),(16,'BA >=16')]:
    line=f"  {lbl:14s}"
    for val,name in RACE.items():
        m=df[race]==val
        r=((df.loc[m,g]>=thr)&(df.loc[m,g]<90))
        line+=f"  {name}={int(r.sum()):4d} ({100*r.mean():5.1f}%)"
    print(line)

print("\n== Sex ==")
print(df['Sex of respondent, 1979'].value_counts().to_string())
print("Age 1979 range:", df[age].min(), "-", df[age].max(), " missing:", int(df[age].isna().sum()))

ses_cols = [
 'Family net wealth, 1985','Family net wealth, 1990','Family net wealth, 1996 (key data point)',
 'Total net family income, previous calendar year, 1979',
 'Total net family income, previous calendar year, 1985',
 'Total net family income, previous calendar year, 1989',
 "Highest grade completed by respondent's mother, 1979",
 "Highest grade completed by respondent's father, 1979",
 'Occupation of adult male in household at age 14, 1979']
print("\n== SES missingness overall / by race (n miss / n) ==")
print(f"  {'variable':58s}" + "".join(f"{n:>16s}" for n in RACE.values()) + f"{'ALL':>16s}")
for c in ses_cols:
    row=f"  {c[:58]:58s}"
    for val,name in RACE.items():
        m=df[race]==val
        row+=f"  {int(df.loc[m,c].isna().sum()):4d}/{int(m.sum()):<5d} "
    row+=f"  {int(df[c].isna().sum()):4d}/{N:<5d} "
    print(row)

print("\n== SES median by race (numeric) ==")
for c in ses_cols[:8]:
    row=f"  {c[:58]:58s}"
    for val,name in RACE.items():
        s=df.loc[df[race]==val,c].dropna()
        row+=f"  med={s.median():>7.0f} "
    print(row)

print("\n== Father occupation: 342 codes, range 1-984 ==")
oc='Occupation of adult male in household at age 14, 1979'
print("  top codes:", df[oc].value_counts().head(6).to_dict(), " missing:", int(df[oc].isna().sum()))

print("\n== Income top-coding ==")
for c in ses_cols[3:6]:
    s=df[c].dropna()
    print(f"  {c[:48]:48s} max={s.max():.0f}  n_at_max={int((s==s.max()).sum())}  p99={s.quantile(.99):.0f}")
