"""
NLSY79 (data/nls_raw.csv): median family net wealth by racial/ethnic cohort,
1985 / 1990 / 1996. Available-case medians + listwise-complete robustness.
Nominal dollars, unweighted.
"""
import csv
import statistics

PATH = "data/nls_raw.csv"
RACE_COL = "Racial/ethnic cohort, 1979"
WEALTH = {
    "1985": "Family net wealth, 1985",
    "1990": "Family net wealth, 1990",
    "1996": "Family net wealth, 1996 (key data point)",
}
GROUPS = {"1": "Black", "2": "Hispanic", "3": "White (code 3: non-Black, non-Hispanic)"}
YEARS = ["1985", "1990", "1996"]

with open(PATH, newline="", encoding="utf-8") as f:
    rows = list(csv.DictReader(f))

def val(row, col):
    s = row[col].strip()
    return float(s) if s != "" else None

# ---------- Available-case medians ----------
print("=" * 78)
print("AVAILABLE-CASE: median family net wealth (nominal $) by group x year")
print("=" * 78)
acc = {}
for y in YEARS:
    col = WEALTH[y]
    for g in GROUPS:
        vals = [val(r, col) for r in rows if r[RACE_COL] == g]
        vals = [v for v in vals if v is not None]
        acc[(g, y)] = (len(vals), statistics.median(vals))

hdr = f"{'Group':45s}" + "".join(f"{y:>14s}" for y in YEARS)
print(hdr)
for g in GROUPS:
    line = f"{GROUPS[g]:45s}"
    for y in YEARS:
        n, med = acc[(g, y)]
        line += f"{med:>9.0f} (n={n})"
    print(line)

print()
print("Median ratios (vs White = code 3):")
print(f"{'Group':10s}" + "".join(f"{y:>12s}" for y in YEARS))
for g in ["1", "2"]:
    line = f"{GROUPS[g].split()[0]:10s}"
    for y in YEARS:
        r = acc[(g, y)][1] / acc[("3", y)][1]
        line += f"{r:>12.3f}"
    print(line)

# ---------- Listwise-complete robustness ----------
print()
print("=" * 78)
print(f"LISTWISE-COMPLETE robustness (all three waves present, nominal $)")
print("=" * 78)
complete = [r for r in rows if all(val(r, WEALTH[y]) is not None for y in YEARS)]
print("n complete:", len(complete))
acc_l = {}
for y in YEARS:
    col = WEALTH[y]
    for g in GROUPS:
        vals = [val(r, col) for r in complete if r[RACE_COL] == g]
        acc_l[(g, y)] = (len(vals), statistics.median(vals))
print(f"{'Group':45s}" + "".join(f"{y:>14s}" for y in YEARS))
for g in GROUPS:
    line = f"{GROUPS[g]:45s}"
    for y in YEARS:
        n, med = acc_l[(g, y)]
        line += f"{med:>9.0f} (n={n})"
    print(line)
print()
print("Listwise median ratios (vs White = code 3):")
print(f"{'Group':10s}" + "".join(f"{y:>12s}" for y in YEARS))
for g in ["1", "2"]:
    line = f"{GROUPS[g].split()[0]:10s}"
    for y in YEARS:
        r = acc_l[(g, y)][1] / acc_l[("3", y)][1]
        line += f"{r:>12.3f}"
    print(line)

# direction check: sign of (group median - white median) available-case vs listwise
print()
print("Direction check (group median minus white median, $):")
for g in ["1", "2"]:
    for y in YEARS:
        d_ac = acc[(g, y)][1] - acc[("3", y)][1]
        d_lw = acc_l[(g, y)][1] - acc_l[("3", y)][1]
        same = "same" if (d_ac < 0) == (d_lw < 0) else "DIFFERS"
        print(f"{GROUPS[g].split()[0]:10s} {y}: avail-case {d_ac:>10.0f}  listwise {d_lw:>10.0f}  -> {same}")
