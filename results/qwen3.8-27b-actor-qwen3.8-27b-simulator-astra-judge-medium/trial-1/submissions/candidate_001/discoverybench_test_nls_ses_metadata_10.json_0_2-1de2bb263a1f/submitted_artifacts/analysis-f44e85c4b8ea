"""Fingerprint: which predictor's coefficient on BA DEGREE COMPLETED
drops ~0.3636 -> ~-0.2293 (and loses significance) when race + academic
characteristics (ability composite + percentile in class) are added."""
import pandas as pd, numpy as np
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_ses_processed.csv').drop(columns=['Unnamed: 0'])
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df = df.rename(columns={'ABILITY: COMPOSITE OF ASVAB SCORE':'ability',
    'PERCENTILE IN CLASS':'percentile','SAMPLE_RACE':'race','SAMPLE_SEX':'sex',
    'FAMILY SIZE OF SAMPLE':'famsize','SES':'ses'})
cont = ['ability','percentile','famsize','ses']
for c in cont:
    df[c+'_z'] = (df[c]-df[c].mean())/df[c].std()
df['race_Black']=(df['race']=='Black').astype(int)
df['race_Hisp']=(df['race']=='Hispanic').astype(int)
df['sex_Male']=(df['sex']=='Male').astype(int)

def col(X,use_z): return X+'_z' if (use_z and X in cont) else X
def fit(method,X,use_z):
    Xc=col(X,use_z); ab=col('ability',use_z); pc=col('percentile',use_z)
    m0f=f'BA ~ {Xc}'; m1f=f'BA ~ {Xc} + race_Black + race_Hisp + {ab} + {pc}'
    fn=smf.logit if method=='logit' else smf.ols
    m0=fn(m0f,data=df).fit(disp=0); m1=fn(m1f,data=df).fit(disp=0)
    g=lambda m,n:(m.params[n],m.bse[n],m.tvalues[n],m.pvalues[n])
    return g(m0,Xc),g(m1,Xc)

cands={'ses':'ses','sex':'sex_Male','famsize':'famsize'}
print("M0 = X alone | M1 = X + race(Black,Hisp) + ability + percentile\n")
print(f"{'cand':9s}{'method':7s}{'std':5s} | {'M0 coef':>8s} {'SE':>7s} {'z/t':>7s} {'p':>9s} | {'M1 coef':>8s} {'SE':>7s} {'z/t':>7s} {'p':>9s}  flip")
print('-'*95)
for name,X in cands.items():
    for method in ['logit','ols']:
        for use_z in [False,True]:
            (b0,se0,t0,p0),(b1,se1,t1,p1)=fit(method,X,use_z)
            flip='YES' if (b0*b1<0) else ''
            print(f"{name:9s}{method:7s}{str(use_z):5s} | {b0:8.4f} {se0:7.4f} {t0:7.3f} {p0:9.5f} | {b1:8.4f} {se1:7.4f} {t1:7.3f} {p1:9.5f}  {flip}")

print("\n--- Race-reference invariance: SES M1 (logit, unstd) ---")
for ref,rd in [('White','race_Black + race_Hisp'),('Black','C(race, Treatment(reference="Black"))'),
               ('Hispanic','C(race, Treatment(reference="Hispanic"))')]:
    m=smf.logit(f'BA ~ ses + {rd} + ability + percentile',data=df).fit(disp=0)
    print(f"  ref={ref:9s}  coef={m.params['ses']:.5f}  z={m.tvalues['ses']:.4f}  p={m.pvalues['ses']:.5f}")

print("\n--- SES logit fingerprint vs 0.3636 -> -0.2293 ---")
print("  standardized  : M0=+0.3511 (z=5.73, p<.001) -> M1=-0.1720 (z=-2.31, p=0.021)")
print("  unstandardized: M0=+0.4729 (z=5.73, p<.001) -> M1=-0.2316 (z=-2.31, p=0.021)  <- M1 ~= -0.2293")
