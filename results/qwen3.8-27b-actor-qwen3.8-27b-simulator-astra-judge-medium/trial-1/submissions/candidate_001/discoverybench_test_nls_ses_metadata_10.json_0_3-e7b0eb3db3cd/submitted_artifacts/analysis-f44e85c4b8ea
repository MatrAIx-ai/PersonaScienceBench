import pandas as pd, numpy as np
import statsmodels.api as sm
import statsmodels.stats.outliers_influence as oi

pd.set_option('display.width', 220); pd.set_option('display.max_columns', 30)

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df = df.rename(columns={"FAMILY SIZE OF SAMPLE":"famsize",
                        "ABILITY: COMPOSITE OF ASVAB SCORE":"ability",
                        "PERCENTILE IN CLASS":"percentile","SES":"ses"})
df["black"]=(df["SAMPLE_RACE"]=="Black").astype(int)
df["hisp"]  =(df["SAMPLE_RACE"]=="Hispanic").astype(int)
df["male"]  =(df["SAMPLE_SEX"]=="Male").astype(int)
y = df["BA DEGREE COMPLETED"].astype(int)

CTRL = ["ses","ability","percentile"]          # SES + academic characteristics
CANDS = ["black","hisp","male","famsize","ses","ability","percentile"]

def std_beta_ols(cand, cs):
    cols=[cand]+[c for c in cs if c!=cand]
    X=df[cols].astype(float).copy(); Xz=(X-X.mean())/X.std(); yz=(y-y.mean())/y.std()
    m=sm.OLS(yz, sm.add_constant(Xz)).fit()
    return m.params[cand], m.pvalues[cand]

def std_beta_logit(cand, cs):
    cols=[cand]+[c for c in cs if c!=cand]
    X=df[cols].astype(float).copy(); Xz=(X-X.mean())/X.std(); yz=y
    m=sm.Logit(yz, sm.add_constant(Xz)).fit(disp=0)
    return m.params[cand], m.pvalues[cand]

rows=[]
for cand in CANDS:
    # --- LOGIT raw ---
    Xa=sm.add_constant(df[[cand]].astype(float)); ma=sm.Logit(y,Xa).fit(disp=0)
    cols=[cand]+[c for c in CTRL if c!=cand]
    Xb=sm.add_constant(df[cols].astype(float)); mb=sm.Logit(y,Xb).fit(disp=0)
    la=ma.params[cand]; lb=mb.params[cand]
    lal=ma.conf_int().loc[cand]; lbl=mb.conf_int().loc[cand]
    # --- OLS LPM raw ---
    oa=sm.OLS(y,sm.add_constant(df[[cand]].astype(float))).fit()
    ob=sm.OLS(y,sm.add_constant(df[cols].astype(float))).fit()
    # --- standardized ---
    soa,soa_p=std_beta_ols(cand,[]);  sob,sob_p=std_beta_ols(cand,CTRL)
    sla,sla_p=std_beta_logit(cand,[]); slb,slb_p=std_beta_logit(cand,CTRL)
    rows.append(dict(
        variable=cand,
        logitA_beta=round(la,4), logitA_OR=round(np.exp(la),3), logitA_p=round(ma.pvalues[cand],4),
        logitA_CI=f"[{lal[0]:.3f},{lal[1]:.3f}]",
        logitB_beta=round(lb,4), logitB_OR=round(np.exp(lb),3), logitB_p=round(mb.pvalues[cand],4),
        logitB_CI=f"[{lbl[0]:.3f},{lbl[1]:.3f}]",
        shrinkRatio=round(abs(la)/abs(lb),2) if lb!=0 else np.nan,
        stdOLS_A=round(soa,4), stdOLS_B=round(sob,4), stdOLS_B_p=round(sob_p,4),
        stdLogit_A=round(sla,4), stdLogit_B=round(slb,4), stdLogit_B_p=round(slb_p,4),
        OLS_A=round(oa.params[cand],4), OLS_B=round(ob.params[cand],4), OLS_B_p=round(ob.pvalues[cand],4),
    ))
T=pd.DataFrame(rows).set_index("variable")
print("=== A (univariate) vs B (adjusted: +SES+ability+percentile) ===")
print(T.to_string())

# VIFs for the full adjusted model (all predictors together)
full=["black","hisp","male","famsize","ses","ability","percentile"]
Xf=sm.add_constant(df[full].astype(float))
vif=pd.DataFrame({"var":full,"VIF":[round(oi.variance_inflation_factor(Xf.values,i),2) for i in range(1,len(full)+1)]})
print("\n=== VIFs (full adjusted model) ===")
print(vif.round(2).to_string(index=False))

# raw group means for context
print("\n=== BA completion rate by group ===")
print(df.groupby("SAMPLE_RACE")["BA DEGREE COMPLETED"].agg(["count","mean"]).round(4))
print(df.groupby("SAMPLE_SEX")["BA DEGREE COMPLETED"].agg(["count","mean"]).round(4))
