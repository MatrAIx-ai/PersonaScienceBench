import pandas as pd, numpy as np
import statsmodels.api as sm
from scipy.stats import norm
from statsmodels.stats.outliers_influence import variance_inflation_factor

pd.set_option("display.width", 200)
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
y = df["BA DEGREE COMPLETED"].astype(int)

z = lambda s: (s - s.mean()) / s.std()
df["SES_z"] = z(df["SES"]); df["AB_z"] = z(df["ABILITY: COMPOSITE OF ASVAB SCORE"])
df["PCT_z"] = z(df["PERCENTILE IN CLASS"])
df["FS_c"] = df["FAMILY SIZE OF SAMPLE"] - df["FAMILY SIZE OF SAMPLE"].mean()
df["Black"] = (df["SAMPLE_RACE"]=="Black").astype(int)
df["Hisp"]  = (df["SAMPLE_RACE"]=="Hispanic").astype(int)
df["White"] = (df["SAMPLE_RACE"]=="White").astype(int)
df["Male"]  = (df["SAMPLE_SEX"]=="Male").astype(int)
df["SES_Black"] = df["SES_z"]*df["Black"]; df["SES_Hisp"] = df["SES_z"]*df["Hisp"]
df["SES_White"] = df["SES_z"]*df["White"]
cov = ["AB_z","PCT_z","Male","FS_c"]

# ---------------- Firth (own implementation, gradient verified vs finite differences) ----------------
def firth_fit(X, yv, maxit=200, tol=1e-10):
    n, p = X.shape
    b = np.zeros(p)
    def grad(bb):
        eta = X@bb; mu = 1/(1+np.exp(-eta)); W = mu*(1-mu)
        I = X.T@(W[:,None]*X); V = np.linalg.inv(I)
        h = np.einsum('ij,jk,ik->i', X, V, X)
        return X.T@(yv-mu) + 0.5*(X.T@(W*(1-2*mu)*h))
    def hess(bb):
        st = 1e-6; H = np.zeros((p,p))
        for j in range(p):
            e = np.zeros(p); e[j]=1
            H[:,j] = (grad(bb+st*e)-grad(bb-st*e))/(2*st)
        return H
    for it in range(maxit):
        gv = grad(b); H = hess(b)
        try: step = np.linalg.solve(-H, gv)
        except np.linalg.LinAlgError: step = -np.linalg.pinv(H)@gv
        # line search
        a = 1.0; l0 = None
        def penloglik(bb):
            eta = X@bb; mu = 1/(1+np.exp(-np.clip(eta,-50,50)))
            ll = np.sum(yv*np.log(np.clip(mu,1e-300,1)) + (1-yv)*np.log(np.clip(1-mu,1e-300,1)))
            I = X.T@((mu*(1-mu))[:,None]*X)
            return ll + 0.5*np.linalg.slogdet(I)[1]
        l0 = penloglik(b)
        while a > 1e-6 and (not np.isfinite(penloglik(b+a*step)) or penloglik(b+a*step) < l0 - 1e-9):
            a *= 0.5
        b = b + a*step
        if np.max(np.abs(a*step)) < tol: break
    H = -hess(b)
    try: Cv = np.linalg.inv(H)
    except np.linalg.LinAlgError: Cv = np.linalg.pinv(H)
    return b, Cv, it+1, np.isfinite(b).all()

def show(b, Cv, names, title, terms=None):
    se = np.sqrt(np.diag(Cv))
    rows = []
    for i, t in enumerate(names):
        if t == "const": continue
        rows.append((t, b[i], np.exp(b[i]), np.exp(b[i]-1.96*se[i]), np.exp(b[i]+1.96*se[i]), 2*(1-norm.cdf(abs(b[i]/se[i])))))
    print(f"\n=== {title} ===")
    print(pd.DataFrame(rows, columns=["term","b","OR","LB","UB","p"]).to_string(index=False, float_format=lambda v: f"{v:9.4f}"))

def fit_logit(d, yv, terms):
    X = sm.add_constant(d[terms])
    try:
        m = sm.Logit(yv, X).fit(disp=0)
        return m, True, ""
    except Exception as e:
        return None, False, str(e)[:90]

def joint_wald(m, names, title):
    idx = list(m.params.index)
    R = np.zeros((len(names), len(idx)))
    for r, t in enumerate(names): R[r, idx.index(t)] = 1
    wt = m.wald_test(R, scalar=True)
    print(f"{title}: chi2={wt.statistic:.3f}, df={R.shape[0]}, p={wt.pvalue:.4f}")
    return wt

def slope_diff(m, base, inter, title):
    idx = list(m.params.index); V = m.cov_params()
    d = m.params[base] + m.params[inter]
    se = np.sqrt(V.loc[base,base] + 2*V.loc[base,inter] + V.loc[inter,inter])
    p = 2*(1-norm.cdf(abs(d/se)))
    print(f"{title}: d={d:.4f} log-odds/SD (OR-of-OR={np.exp(d):.3f}), SE={se:.4f}, p={p:.4f}")

# ============ 1. MAIN MODEL (ref=White) ============
terms = ["SES_z","Black","Hisp","SES_Black","SES_Hisp"] + cov
m, ok, err = fit_logit(df, y, terms)
print("MAIN converged:", ok, err)
show(m.params.values, m.cov_params().values, list(m.params.index), "MAIN MODEL (ref=White), OR per 1-SD SES")
slope_diff(m, "SES_z", "SES_Black", "slope diff Black vs White")
slope_diff(m, "SES_z", "SES_Hisp", "slope diff Hispanic vs White")
joint_wald(m, ["SES_Black","SES_Hisp"], "JOINT WARD TEST SES x race")
for t in ["SES_z","SES_Black","SES_Hisp"]:
    print(f"  {t}: OR={np.exp(m.params[t]):.3f} (95% CI {np.exp(m.conf_int().loc[t][0]):.3f}-{np.exp(m.conf_int().loc[t][1]):.3f}), p={m.pvalues[t]:.4f}")

# ============ 2. VIF ============
Xv = df[terms]
print("\nVIF:", {c: round(variance_inflation_factor(Xv.values, i),2) for i, c in enumerate(Xv.columns)})

# ============ 3. ALTERNATIVE REFERENCE (ref=Black) ============
terms2 = ["SES_z","White","Hisp","SES_White","SES_Hisp"] + cov
m2, ok2, err2 = fit_logit(df, y, terms2)
print("\nALT-REF converged:", ok2, err2)
show(m2.params.values, m2.cov_params().values, list(m2.params.index), "ALT REFERENCE (ref=Black)")
joint_wald(m2, ["SES_White","SES_Hisp"], "JOINT WARD (ref=Black)")

# ============ 4. STRATIFIED ============
for race in ["White","Black","Hispanic"]:
    d = df[df["SAMPLE_RACE"]==race].copy(); yv = y[d.index]
    ms, okm, erm = fit_logit(d, yv, ["SES_z"]+cov)
    if okm:
        show(ms.params.values, ms.cov_params().values, list(ms.params.index), f"STRATIFIED {race} full (n={len(d)}, events={yv.sum()})")
    else:
        print(f"\n[STRATIFIED {race}: full model failed -> '{erm}'; fallback BA ~ SES]")
        ms2, _, _ = fit_logit(d, yv, ["SES_z"])
        show(ms2.params.values, ms2.cov_params().values, list(ms2.params.index), f"STRATIFIED {race} fallback (n={len(d)}, events={yv.sum()})")

# ============ 5. FIRTH SENSITIVITY ============
Xf = sm.add_constant(df[terms])
bf, Cvf, it, conv = firth_fit(Xf.values, y.values)
print(f"\nFIRTH main converged={conv} in {it} iters")
show(bf, Cvf, list(m.params.index), "FIRTH main (ref=White)")
R = np.zeros((2, len(terms)+1)); idx = list(m.params.index)
for r, t in enumerate(["SES_Black","SES_Hisp"]): R[r, idx.index(t)] = 1
F = R@Cvf@R.T
chi2 = float(R@bf@np.linalg.inv(Cvf)@R.T @ np.linalg.inv(F)) if False else float((R@bf) @ np.linalg.inv(F) @ (R@bf))
from scipy.stats import chi2 as chi2rv
print(f"FIRTH joint Wald: chi2={chi2:.3f}, p={1-chi2rv.cdf(chi2,2):.4f}")

for race in ["Black","Hispanic"]:
    d = df[df["SAMPLE_RACE"]==race].copy(); yv = y[d.index]
    Xs = sm.add_constant(d[["SES_z"]+cov])
    bs, Cvs, its, convs = firth_fit(Xs.values, yv.values)
    show(bs, Cvs, ["const","SES_z"]+cov, f"FIRTH STRATIFIED {race} (n={len(d)}, events={yv.sum()})")
    se = np.sqrt(np.diag(Cvs))
    print(f"  SES slope: OR={np.exp(bs[1]):.3f} (95% CI {np.exp(bs[1]-1.96*se[1]):.3f}-{np.exp(bs[1]+1.96*se[1]):.3f}), p={2*(1-norm.cdf(abs(bs[1]/se[1]))):.4f}")
