import pandas as pd
import numpy as np

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)

def cell(sub, race):
    g = sub[sub.SAMPLE_RACE==race]
    return len(g), int(g.BA.sum()), (g.BA.mean() if len(g) else np.nan)

def report(title, bins, labels):
    print(f"\n===== {title}  (cutpoints: {[round(x,3) for x in bins[1:-1]]}) =====")
    print(f"{'SES':<16}{'Blk%':>7}{'n':>6}{'c':>4}  {'Wht%':>7}{'n':>6}{'c':>4}  {'Hsp%':>7}{'n':>6}{'c':>4}   {'B-Wpp':>7}{'B-Hpp':>7}")
    for lo,hi,lab in zip(bins[:-1], bins[1:], labels):
        sub = df[(df.SES>lo)&(df.SES<=hi)] if lo!=-np.inf else df[(df.SES>=lo)&(df.SES<=hi)]
        if lo==-np.inf: sub=df[df.SES<=hi]
        bn,bc,br = cell(sub,"Black"); wn,wc,wr = cell(sub,"White"); hn,hc,hr = cell(sub,"Hispanic")
        print(f"{lab:<16}{br*100:>7.2f}{bn:>6}{bc:>4}  {wr*100:>7.2f}{wn:>6}{wc:>4}  {hr*100:>7.2f}{hn:>6}{hc:>4}   {(br-wr)*100:>7.2f}{(br-hr)*100:>7.2f}")
        # pooled non-black
        nb = sub[sub.SAMPLE_RACE!="Black"]; nb_r = nb.BA.mean()
        print(f"{'':<16}   [Black vs non-Black: {br*100:.2f}% (n={bn}) vs {nb_r*100:.2f}% (n={len(nb)}) = {(br-nb_r)*100:+.2f}pp]")

# Tertiles
q = df.SES.quantile([1/3,2/3]).values
report("TERTILES", [-np.inf,q[0],q[1],np.inf], ["Low","Mid","High"])
# SD-based
report("SD-based (-0.5/+0.5)", [-np.inf,-0.5,0.5,np.inf], ["Low(<-0.5)","Mid","High(>0.5)"])

print("\n===== OVERALL =====")
for r in ["Black","White","Hispanic"]:
    n,c,rate = cell(df,r); print(f"{r}: {rate*100:.2f}% (n={n}, completers={c})")
