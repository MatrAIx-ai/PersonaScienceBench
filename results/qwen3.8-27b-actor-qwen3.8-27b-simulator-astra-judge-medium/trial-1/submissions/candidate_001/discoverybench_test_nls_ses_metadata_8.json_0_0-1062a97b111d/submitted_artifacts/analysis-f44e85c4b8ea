"""
DiscoveryBench: NLS SES — BA degree completion by race.
Question: Between which two races is the factor of BA degree completion -0.9568
          when compared to the other?

Method:
  1. Inspect data (race categories, BA distribution, N, missingness).
  2. Determine model family by scale: raw mean diffs ~0.02 => coefficient must be
     on log-odds scale => logistic regression (logit), not linear/probit.
  3. Fit logit: BA_DEGREE ~ C(SAMPLE_RACE) with each of the 3 races as reference.
  4. Match the coefficient closest to -0.9568 -> identifies the (dummy, reference) pair.
"""
import numpy as np, pandas as pd, itertools
from statsmodels.formula.api import logit

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df = df.rename(columns={"SAMPLE_RACE": "race", "BA DEGREE COMPLETED": "BA"})
df["BA"] = df["BA"].astype(int)
races = ["White", "Black", "Hispanic"]
TARGET = -0.9568

# ---- 1. Inspection -----------------------------------------------------------
print("=" * 64)
print("DATA INSPECTION")
print(f"  observations      : {len(df)}")
print(f"  race categories   : {dict(df['race'].value_counts())}")
print(f"  BA completed      : {int(df['BA'].sum())} / {len(df)} "
      f"({df['BA'].mean()*100:.2f}%)")
print(f"  missing values    : {int(df.isna().sum().sum())}")
print("  completion rate by race:")
print("   " + df.groupby("race")["BA"].mean().map(lambda v: f"{v:.4f}").to_dict().__repr__())

# ---- 2. Model family by scale ------------------------------------------------
means = df.groupby("race")["BA"].mean()
print("=" * 64)
print("SCALE ARGUMENT (logit vs linear)")
print(f"  max raw mean diff = {means.max()-means.min():.4f}  "
      f"=> a raw/linear coefficient cannot be {TARGET}; must be log-odds (logit).")

# ---- 3. Fit logit with each reference ---------------------------------------
def race_terms(m):
    return [(n, c) for n, c in m.params.items() if "T." in n and "race" in n]

print("=" * 64)
print("LOGIT: BA ~ C(SAMPLE_RACE)  (all 3 reference choices)")
cands = []
for ref in races:
    m = logit(f'BA ~ C(race, Treatment(reference="{ref}"))', df).fit(disp=0)
    print(f"  reference = {ref}:")
    for n, c in race_terms(m):
        lv = n.split("T.")[-1].rstrip("]")
        print(f"      {lv:9s} vs {ref:9s} : coef={c:+.6f}  OR={np.exp(c):.4f}")
        cands.append((abs(c - TARGET), lv, ref, c))

# ---- 4. Match -0.9568 --------------------------------------------------------
cands.sort()
_, other, ref, coef = cands[0]
print("=" * 64)
print(f"MATCH to target {TARGET}")
for d, lv, r, c in cands:
    print(f"  |diff|={d:.6f}  {lv:9s} vs {r:9s}  coef={c:+.6f}")
print("-" * 64)
print(f"  CLOSEST  : {other} vs {ref} = {coef:+.6f} (|diff|={abs(coef-TARGET):.6f})")
print(f"  odds ratio = {np.exp(coef):.4f}  (target OR={np.exp(TARGET):.4f})")
print(f"  => The two races are: {other} and {ref}.")
print(f"  Interpretation: {other} has ~{np.exp(TARGET):.2f}x the ODDS of BA")
print(f"     completion relative to {ref} (logit coefficient {TARGET}).")
