import pandas as pd, numpy as np, itertools
from statsmodels.formula.api import logit
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df = df.rename(columns={'SAMPLE_RACE':'race','BA DEGREE COMPLETED':'BA',
    'SES':'SES','ABILITY: COMPOSITE OF ASVAB SCORE':'ability',
    'PERCENTILE IN CLASS':'pctl','SAMPLE_SEX':'sex','FAMILY SIZE OF SAMPLE':'famsize'})
df['BA']=df['BA'].astype(int)
cont=['SES','ability','pctl','famsize']
for c in cont: df[c+'_z']=(df[c]-df[c].mean())/df[c].std()
zset={c:c+'_z' for c in cont}; zset['sex']='C(sex)'
controls=['SES','ability','pctl','sex','famsize']
target=-0.9568
def rt(m): return [(n,c) for n,c in m.params.items() if 'T.' in n and 'race' in n]
best=[]
for r in range(0,6):
    for combo in itertools.combinations(controls,r):
        # both raw and z variants tried via zset mapping for continuous
        fc=' + '+' + '.join((zset[c] if c in zset and c!='sex' else ('C(sex)' if c=='sex' else c)) for c in combo) if combo else ''
        for ref in ['White','Black','Hispanic']:
            try: m=logit(f'BA ~ C(race, Treatment(reference="{ref}")){fc}',df).fit(disp=0)
            except: continue
            for n,c in rt(m): best.append((abs(c-target),sorted(combo),ref,n,c))
best.sort()
print("EXHAUSTIVE top matches (raw+z standardized controls), target",target)
for d,combo,ref,n,c in best[:8]:
    print(f"  |d|={d:.6f} controls={str(combo):26s} ref={ref:9s} coef={c:+.6f}")
print("\nConclusion: closest reproducible negative ~-1 coefficients (ref=White):")
m=logit('BA ~ C(race, Treatment(reference="White"))',df).fit(disp=0)
for n,c in rt(m): print(f"  {n.split(chr(39))[-2] if False else n:40s}={c:+.6f}  OR={np.exp(c):.4f}")
print(f"  target OR = {np.exp(target):.4f}")
