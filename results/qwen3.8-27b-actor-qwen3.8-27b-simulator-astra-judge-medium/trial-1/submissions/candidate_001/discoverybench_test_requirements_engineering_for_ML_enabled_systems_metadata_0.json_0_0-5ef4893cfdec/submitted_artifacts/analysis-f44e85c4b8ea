"""
DiscoveryBench: requirements_engineering_for_ML-enabled_systems
Question: Which two roles have the highest proportion of association with
requirements in ML-enabled systems (source study: 49.6% [95% CI 49.219-49.981]
and 61.389% [95% CI 60.955-61.822] of respondents, after bootstrapping)?

Method:
- Q8_ML_Addressing_* columns are multi-select ('quoted'/'not quoted'); -77 = NA
  (respondents who suspended before reaching Q8). Valid n = rows with Q8 answered.
- Association with requirements for a role = respondent 'quoted' that role (binary).
- Respondent-level bootstrap (row resampling, n=194), 10,000 iterations, seed 42,
  percentile 95% CI for each role's proportion.
"""
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
ROLES = {
    "Project Lead": "Q8_ML_Addressing_Project_Lead",
    "Business Analyst": "Q8_ML_Addressing_Business_Analyst",
    "Requirements Engineer": "Q8_ML_Addressing_Requirement_Engineer",
    "Solution Architect": "Q8_ML_Addressing_Solution_Architect",
    "Data Scientist": "Q8_ML_Addressing_Data_Scientist",
    "Developer": "Q8_ML_Addressing_Developer",
    "Tester": "Q8_ML_Addressing_Tester",
}

df = pd.read_csv(CSV)
print(f"Total rows: {len(df)} | unique IDs: {df['ID'].nunique()}")
print("Status:\n", df["Status"].value_counts().to_string(), "\n")

# NA handling: '-77' = skip/NA in Q8; 'quoted' -> 1, 'not quoted' -> 0
def enc(v):
    return {"quoted": 1, "not quoted": 0, "-77": np.nan}[v]

q8 = pd.DataFrame({
    name: df[col].map(enc) for name, col in ROLES.items()
})
valid = q8.dropna()          # respondents who actually answered Q8
n = len(valid)
n_excl = len(df) - n
print(f"NA (-77) rows excluded: {n_excl} (all Status='Suspended (22)') -> valid n = {n}\n")

X = valid.to_numpy()
rng = np.random.default_rng(42)
B = 10000
boot = np.empty((B, X.shape[1]))
for b in range(B):
    idx = rng.integers(0, n, n)
    boot[b] = X[idx].mean(axis=0)

rows = []
for j, name in enumerate(ROLES):
    p = X[:, j].mean()
    lo, hi = np.percentile(boot[:, j], [2.5, 97.5])
    rows.append((name, int(X[:, j].sum()), p, lo, hi))
rows.sort(key=lambda r: -r[2])

print(f"{'Role':<24}{'n_quoted':>10}{'prop %':>10}{'95% boot CI %':>20}")
for name, k, p, lo, hi in rows:
    print(f"{name:<24}{k:>10}{100*p:>10.3f}{f'[{100*lo:.3f}, {100*hi:.3f}]':>20}")

top2 = rows[:2]
print("\nTop-2 roles by association with requirements:",
      ", ".join(r[0] for r in top2))

# Source-study figures (given in the question, not reproducible from this file)
print("\nSource-study figures (question premise): 49.6% [49.219, 49.981] and "
      "61.389% [60.955, 61.822].")
print("Direction check: data shows Project Lead > Data Scientist, consistent "
      "with 61.389% (Project Lead) > 49.6% (Data Scientist).")
