"""
Final synthesis: most commonly used requirements-elicitation technique
for ML-enabled system projects (Q9 block of the survey).

Method (approved by researcher):
  * 'used' := column value == 'quoted'  (binary presence flag; no Likert scale in file)
  * primary denominator = 194 valid Q9 respondents (exclude the 82 '-77' no-responses)
  * sensitivity denominator = all 276 respondents
  * 95% CI = nonparametric percentile bootstrap, B=10000, fixed seed
"""
import pandas as pd
import numpy as np

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
SEED = 2024
B = 10000

df = pd.read_csv(CSV, dtype=str)

TECH = [
    ("Interviews",         "Q9_ML_Elicitation_Interviews"),
    ("Scenarios",          "Q9_ML_Elicitation_Scenarios"),
    ("Prototyping",        "Q9_ML_Elicitation_Prototyping"),
    ("Workshops/Meetings", "Q9_ML_Elicitation_Workshops_Meetings"),
    ("Observation",        "Q9_ML_Elicitation_Observation"),
    ("Others",             "Q9_ML_Elicitation_Others"),
]

# --- NA handling ---
# Flag columns use '-77' as no-response sentinel (same 82 respondents).
valid = df[TECH[0][1]] != "-77"
N_all   = len(df)          # 276
N_valid = int(valid.sum()) # 194
n_na    = N_all - N_valid  # 82
print(f"Total respondents (rows/unique IDs): {N_all}")
print(f"No-response (-77) excluded:          {n_na}")
print(f"Valid Q9 respondents (primary base): {N_valid}")
print()

# --- per-technique counts & proportions ---
def pct(num, den): return 100.0 * num / den

print("=== Per-technique breakdown (used = 'quoted') ===")
print(f"{'Technique':18s} {'quoted':>7s} {'% of 194 valid':>15s} {'% of 276 all':>14s}")
rows = {}
for name, col in TECH:
    q_valid = int(((df[col] == "quoted") & valid).sum())
    q_all   = int((df[col] == "quoted").sum())
    rows[name] = q_valid
    print(f"{name:18s} {q_valid:7d} {pct(q_valid, N_valid):14.3f}% {pct(q_all, N_all):13.3f}%")

top = max(rows, key=rows.get)
print(f"\nMost-used technique: {top}  ({rows[top]}/{N_valid} = {pct(rows[top], N_valid):.3f}% of valid)")

# --- nonparametric percentile bootstrap, 95% CI, per technique ---
print(f"\n=== Percentile bootstrap 95% CI (B={B}, seed={SEED}), base = {N_valid} valid respondents ===")
rng = np.random.default_rng(SEED)
print(f"{'Technique':18s} {'point%':>8s} {'CI_low%':>9s} {'CI_high%':>9s}")
sub = df[valid].reset_index(drop=True)   # restrict to the 194 valid respondents
ci = {}
for name, col in TECH:
    x = (sub[col] == "quoted").astype(int).to_numpy()
    n = x.size
    p = x.mean()
    boot = np.empty(B)
    for b in range(B):
        boot[b] = rng.choice(x, size=n, replace=True).mean()
    lo, hi = np.percentile(boot, [2.5, 97.5])
    ci[name] = (p, lo, hi)
    print(f"{name:18s} {100*p:8.3f} {100*lo:9.3f} {100*hi:9.3f}")

p, lo, hi = ci[top]
print(f"\nHEADLINE: {top} = {100*p:.3f}% of valid respondents, bootstrap 95% CI [{100*lo:.3f}%, {100*hi:.3f}%]")

# --- closest statistic to the question's 69.399% (composite, not a single technique) ---
Q = pd.DataFrame({n: ((df[c]=="quoted") & valid).astype(int) for n, c in TECH})
nk = Q.sum(axis=1)
ge2 = int((nk >= 2).sum())
print(f"\nNearest data statistic to 69.399%: 'used >=2 techniques' = {ge2}/{N_valid} = {100*ge2/N_valid:.3f}% (composite, not a single technique)")

# --- explicit non-reproducibility check for the question's figure ---
target = 69.399
print("\n=== Reproducibility check for the question's 69.399% / [69.062, 69.735] ===")
for den, lbl in [(N_valid, "194 valid"), (N_all, "276 all"), (188, "188 completed")]:
    best = max((pct(v, den), n) for n, v in rows.items())
    print(f"  base={lbl:12s}: max single-technique % = {best[0]:.3f}% ({best[1]})  -> target 69.399% reachable? {abs(best[0]-target) < 0.05}")
# CI width feasibility
half = (69.735 - 69.062) / 2.0 / 100.0  # in proportion units
p_t = target / 100.0
n_req = p_t * (1 - p_t) / ((half / 1.96) ** 2)
print(f"  Target CI half-width = {half*100:.4f} pp  -> required effective n ~ {n_req:,.0f} (vs N_valid={N_valid})")
print("  => 69.399% and its CI width cannot be produced from this file as a single-technique respondent proportion.")
