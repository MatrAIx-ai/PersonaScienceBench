"""
Q10 ML Documentation formats: least-used identification + respondent-level bootstrap CIs.

Data: data/requirements_engineering_for_ML-enabled_systems.csv
- 276 respondents; Q10 columns coded "quoted" / "not quoted" / "-77" (string sentinel).
- 82 sentinel rows (all Status='Suspended (22)', never reached Q10) -> excluded row-wise.
- Valid respondents: 194 (denominator for all percentages and bootstrap).
- Ranking pool: 10 concrete formats (excludes 'Not_Documented' - not a format,
  and 'Others' - free-text catch-all). Excluded values still reported for transparency.
Bootstrap: respondent-level, with replacement, B=10,000, seed=42, percentile 2.5/97.5.
"""
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
B = 10000
SEED = 42

df = pd.read_csv(CSV)
q10 = [c for c in df.columns if c.startswith("Q10_ML_Documentation_") and not c.endswith("_Free")]
key = {c: c.replace("Q10_ML_Documentation_", "") for c in q10}

valid = df[~(df[q10[0]] == "-77")].reset_index(drop=True)
n = len(valid)
print(f"Total rows: {len(df)} | valid Q10 respondents: {n} | sentinel('-77') rows: {len(df)-n}")

# Point estimates
rows = []
for c in q10:
    q = int((valid[c] == "quoted").sum())
    rows.append({"format": key[c], "quoted": q, "pct": 100.0 * q / n})
tab = pd.DataFrame(rows).set_index("format")

RANKED = ["Vision_Document","Requirements_Lists","Goal_Models","Use_Case_Models",
          "Prototypes","User_Stories","BDD_Scenarios","MLCanvas","Notebooks","Data_Models"]
EXCLUDED = ["Not_Documented","Others"]

# Bootstrap (vectorized: resample row indices, count 'quoted' per format per replicate)
rng = np.random.default_rng(SEED)
codes = np.column_stack([(valid[c] == "quoted").to_numpy() for c in q10])  # (n, 12) bool
idx = rng.integers(0, n, size=(B, n))
boot = codes[idx].sum(axis=1) / n * 100.0  # (B, 12)
cols = [key[c] for c in q10]
bootdf = pd.DataFrame(boot, columns=cols)
lo = bootdf.quantile(0.025)
hi = bootdf.quantile(0.975)

tab["ci_low"] = lo
tab["ci_high"] = hi
tab = tab.sort_values("pct")

out = tab[["quoted","pct","ci_low","ci_high"]].copy()
out.columns = ["quoted_n","pct_of_194","ci95_low","ci95_high"]
print("\n=== All formats, ranked by % of valid (n=194) ===")
print(out.round(3).to_string())

ranked = out.loc[[r for r in RANKED]].sort_values("pct_of_194")
print("\n=== 10 ranked formats (Not_Documented & Others excluded) ===")
print(ranked.round(3).to_string())

least2 = ranked.iloc[:2]
print("\nTwo least-used formats:")
for fmt, r in least2.iterrows():
    print(f"  {fmt}: {r['pct_of_194']:.3f}%  95% CI [{r['ci95_low']:.3f}, {r['ci95_high']:.3f}]")

# Sensitivity: denominator = all 276 rows
print("\nSensitivity (denominator = all 276 rows):")
for c in q10:
    q = int((df[c] == "quoted").sum())
    print(f"  {key[c]:22s} {100*q/len(df):8.3f}%")

out.round(3).to_csv("output/q10_documentation_bootstrap_ci.csv")
print("\nSaved output/q10_documentation_bootstrap_ci.csv")
