"""
World Bank group-level panel: education expenditure (adjusted savings, % of GNI)
vs GNI per capita (constant 2015 US$), 1975-2015.
Groups: LMC (Lower middle income, developing comparator), SSF (Sub-Saharan Africa).

Analysis:
  1. LMC level model:  ln(GNIpc_t) ~ edu_{t-k} + linear trend,  k in {0,1,5}
  2. LMC growth model: dln(GNIpc_t) ~ d(du_{t-k}) + linear trend, k in {0,1,5}
     (d(du_{t-k}) = edu_{t-k} - edu_{t-k-1}, i.e. the change in the share
      k periods before t; for k=0 it is the contemporaneous change)
  3. SSA 5-point (2011-2015) descriptive statistics, non-inferential.
"""
import numpy as np
import pandas as pd
from math import erf, sqrt

def _norm_cdf(z):
    return 0.5 * (1 + erf(z / sqrt(2)))

def ols(X, y):
    beta, *_ = np.linalg.lstsq(X, y, rcond=None)
    resid = y - X @ beta
    n, k = X.shape
    sigma2 = resid @ resid / (n - k)
    cov = sigma2 * np.linalg.inv(X.T @ X)
    se = np.sqrt(np.diag(cov))
    tstat = beta / se
    p = np.array([2 * (1 - _norm_cdf(abs(v))) for v in tstat])
    r2 = 1 - resid @ resid / np.sum((y - y.mean())**2)
    return beta, se, tstat, p, r2, n

df = pd.read_csv('data/worldbank_education_gdp.csv')
yc = [c for c in df.columns if c[:4].isdigit()]
years = np.array([int(c[:4]) for c in yc])          # 1975..2015, length 41

def row(g, s):
    return df[(df['Country Code'] == g) & (df['Series Code'] == s)][yc].values[0].astype(float)

gdp_lmc = row('LMC', 'NY.GNP.PCAP.KD')
edu_lmc = row('LMC', 'NY.ADJ.AEDU.GN.ZS')
gdp_ssf = row('SSF', 'NY.GNP.PCAP.KD')
edu_ssf = row('SSF', 'NY.ADJ.AEDU.GN.ZS')

print('=' * 78)
print('1) LMC LEVEL MODEL:  ln(GNIpc_t) ~ edu_{t-k} + linear trend')
print('   beta_edu = change in ln(GNIpc) per 1pp higher edu share (% of GNI)')
print('=' * 78)
hdr = f"{'k':>3} {'n':>4} {'beta_edu':>10} {'SE':>8} {'t':>8} {'p':>8} {'beta_trend':>11} {'R2':>7}"
print(hdr); print('-' * len(hdr))
for k in (0, 1, 5):
    idx = np.arange(k, 41)                       # t indices where edu_{t-k} exists
    e = edu_lmc[idx - k]
    y = np.log(gdp_lmc[idx])
    X = np.column_stack([np.ones(len(idx)), e, years[idx]])
    beta, se, tstat, p, r2, n = ols(X, y)
    print(f"{k:>3} {n:>4} {beta[1]:>10.3f} {se[1]:>8.3f} {tstat[1]:>8.2f} {p[1]:>8.4f} {beta[2]:>11.5f} {r2:>7.3f}")

print()
print('=' * 78)
print('2) LMC GROWTH MODEL:  dln(GNIpc_t) ~ d(du_{t-k}) + linear trend')
print('   beta = change in GDP growth (in ln units) per 1pp change in edu share')
print('=' * 78)
print(hdr); print('-' * len(hdr))
dln = np.diff(np.log(gdp_lmc))     # 40 values, position i <-> t = years[i+1]
ddu = np.diff(edu_lmc)             # 40 values, position i <-> d(du_t) at t = years[i+1]
for k in (0, 1, 5):
    # d(du_{t-k}) lives at position (t-k)-1 in ddu; need t-k-1 >= 0 and t in 1976..2015
    pos = np.arange(40) - k        # position in ddu for each t in years[1:]
    keep = pos >= 0
    pos_k = pos[keep]
    t_years = years[1:][keep]
    x = ddu[pos_k]
    y = dln[keep]
    X = np.column_stack([np.ones(len(pos_k)), x, t_years])
    beta, se, tstat, p, r2, n = ols(X, y)
    print(f"{k:>3} {n:>4} {beta[1]:>10.3f} {se[1]:>8.3f} {tstat[1]:>8.2f} {p[1]:>8.4f} {beta[2]:>11.5f} {r2:>7.3f}")

print()
print('=' * 78)
print('3) SSA (SSF) 5-POINT DESCRIPTIVE, 2011-2015  [NON-INFERENTIAL]')
print('=' * 78)
m = ~(np.isnan(edu_ssf) | np.isnan(gdp_ssf))
e5, g5, y5 = edu_ssf[m], gdp_ssf[m], years[m]
print(f"Years: {y5[0]}-{y5[-1]} (n={len(y5)})")
print(f"Edu share (% of GNI): mean={e5.mean():.3f}, min={e5.min():.3f}, max={e5.max():.3f}, "
      f"range={e5.max()-e5.min():.3f}; direction {e5[0]:.3f} -> {e5[-1]:.3f} (declining)")
print(f"GNIpc (2015 US$):     mean={g5.mean():.1f}, min={g5.min():.1f}, max={g5.max():.1f}, "
      f"range={g5.max()-g5.min():.1f}; direction {g5[0]:.1f} -> {g5[-1]:.1f} (rising)")
r_lvl = np.corrcoef(e5, g5)[0, 1]
r_yoy = np.corrcoef(np.diff(e5), np.diff(g5))[0, 1]
print(f"Pearson r (levels, n=5)     = {r_lvl:.3f}   [descriptive only, no inference]")
print(f"Pearson r (YoY changes,n=4) = {r_yoy:.3f}   [descriptive only, no inference]")
print("Note: 2011 is the first available SSA GNIpc year in this file (1975-2010 missing).")

print()
print('=' * 78)
print('4) CONTEXT: LMC reference correlations')
print('=' * 78)
m = ~(np.isnan(edu_lmc) | np.isnan(gdp_lmc))
print(f"LMC levels r       = {np.corrcoef(edu_lmc[m], gdp_lmc[m])[0,1]:.3f} (n={m.sum()})")
de, dx = np.diff(edu_lmc), np.diff(gdp_lmc)
dg = np.diff(np.log(gdp_lmc))
print(f"LMC YoY r          = {np.corrcoef(de, dx)[0,1]:.3f} (n={m.sum()-1})")
print(f"LMC d(edu)~g(GDP)  = {np.corrcoef(de, dg)[0,1]:.3f} (n={m.sum()-1})")
