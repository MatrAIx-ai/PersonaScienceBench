import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor
from scipy import stats
import warnings
warnings.filterwarnings('ignore')

def auc_score(y, probs):
    """AUC via Mann-Whitney U (rank-based)."""
    y = np.asarray(y); probs = np.asarray(probs)
    pos = probs[y == 1]; neg = probs[y == 0]
    if len(pos) == 0 or len(neg) == 0:
        return 0.5
    # Rank all scores
    all_scores = np.concatenate([pos, neg])
    ranks = stats.rankdata(all_scores)
    r_pos = ranks[:len(pos)]
    U = r_pos.sum() - len(pos)*(len(pos)+1)/2
    return U / (len(pos) * len(neg))

df = pd.read_csv("data/nls_bmi_processed.csv")
print("=" * 70)
print("STEP 1: DATA LOADING & CLEANING")
print("=" * 70)
print(f"Raw data: {df.shape[0]} rows x {df.shape[1]} cols")

df_dedup = df.drop_duplicates(keep='first').reset_index(drop=True)
