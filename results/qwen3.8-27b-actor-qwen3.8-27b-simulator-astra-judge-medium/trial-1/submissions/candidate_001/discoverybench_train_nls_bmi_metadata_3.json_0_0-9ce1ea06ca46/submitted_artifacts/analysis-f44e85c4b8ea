df_dedup['AGE_c2'] = df_dedup['AGE_c'] ** 2
print(f"AGE mean = {age_mean:.4f}, BMI p99 = {bmi_p99:.2f}")
print(f"Deduped DISSAVED rate: {df_dedup['DISSAVED'].mean():.4f} ({int(df_dedup['DISSAVED'].sum())}/{len(df_dedup)})")

print("\n" + "=" * 70)
print("STEP 2: AGE-SPECIFIC DISSAVED RATES")
print("=" * 70)
print(f"\n{'Age':>4} | {'n(dedup)':>9} | {'DISSAVED':>9} | {'Rate':>7} | {'95% CI':>20} | {'n(full)':>8} | {'Rate(full)':>10}")
print("-" * 90)
for age in sorted(df_dedup['AGE'].unique()):
    sub_d = df_dedup[df_dedup['AGE'] == age]
    sub_f = df[df['AGE'] == age]
    n_d, k_d = len(sub_d), int(sub_d['DISSAVED'].sum())
    p_d = k_d / n_d
    ci_d = 1.96 * np.sqrt(p_d * (1 - p_d) / n_d)
    n_f, k_f = len(sub_f), int(sub_f['DISSAVED'].sum())
    p_f = k_f / n_f
    print(f"{age:>4} | {n_d:>9} | {k_d:>9} | {p_d:>6.1%} | [{p_d-ci_d:.3f}, {p_d+ci_d:.3f}] | {n_f:>8} | {p_f:>9.1%}")

print("\n" + "=" * 70)
print("STEP 3: NESTED MODEL COMPARISON (deduped)")
print("=" * 70)
y = df_dedup['DISSAVED'].values
X1 = sm.add_constant(df_dedup[['AGE_c']])
m1 = sm.Logit(y, X1).fit(disp=0)
X2 = sm.add_constant(df_dedup[['AGE_c', 'AGE_c2']])
m2 = sm.Logit(y, X2).fit(disp=0)
X3 = sm.add_constant(df_dedup[['AGE_c', 'AGE_c2', 'MALE', 'BLACK', 'HISPANIC']])
m3 = sm.Logit(y, X3).fit(disp=0)

print(f"\n{'Model':>30} | {'LogL':>10} | {'AIC':>10} | {'BIC':>10} | {'PseudoR2':>9} | {'N':>6}")
print("-" * 85)
for name, m in [("M1: Linear", m1), ("M2: Quadratic", m2), ("M3: Quad+Controls", m3)]:
    print(f"{name:>30} | {m.llf:>10.2f} | {m.aic:>10.2f} | {m.bic:>10.2f} | {m.prsquared:>9.4f} | {int(m.nobs):>6}")

lr12 = 2*(m2.llf - m1.llf); lr12_p = stats.chi2.sf(lr12, df=1)
lr23 = 2*(m3.llf - m2.llf); lr23_p = stats.chi2.sf(lr23, df=3)
print(f"\nLR M1->M2 (quadratic): chi2={lr12:.3f}, df=1, p={lr12_p:.4f}")
print(f"LR M2->M3 (controls):  chi2={lr23:.3f}, df=3, p={lr23_p:.4f}")

print("\n" + "=" * 70)
print("STEP 4: MODEL COEFFICIENT TABLES")
print("=" * 70)
for name, m in [("M1: Linear", m1), ("M2: Quadratic (PRIMARY)", m2), ("M3: Quad+Controls", m3)]:
    print(f"\n--- {name} ---")
    print(m.summary2().tables[1].round(4).to_string())

print("\n" + "=" * 70)
print("STEP 5: DIAGNOSTICS (M2 primary)")
print("=" * 70)
Xv = df_dedup[['AGE_c','AGE_c2']].values
cv = np.corrcoef((Xv - Xv.mean(0)).T)
vif = 1/(1-cv[0,1]**2)
print(f"\nVIF AGE_c={vif:.4f}, AGE_c2={vif:.4f}, corr={cv[0,1]:.4f}")

X3c = sm.add_constant(df_dedup[['AGE_c','AGE_c2','MALE','BLACK','HISPANIC']])
vifs3 = [variance_inflation_factor(X3c.values, i) for i in range(1, X3c.shape[1])]
print(f"VIF M3: " + ", ".join(f"{c}={v:.3f}" for c,v in zip(['AGE_c','AGE_c2','MALE','BLACK','HISPANIC'], vifs3)))

def hosmer_lemeshow(y, probs, g=10):
    d = pd.DataFrame({'y':y, 'p':probs})
    d['grp'] = pd.qcut(d['p'], g, duplicates='drop')
    t = d.groupby('grp').agg(n=('y','size'), o1=('y','sum'), e1=('p','sum'))
    t['o0'] = t['n']-t['o1']; t['e0'] = t['n']-t['e1']
    chi2 = ((t['o1']-t['e1'])**2/t['e1'] + (t['o0']-t['e0'])**2/t['e0']).sum()
    return chi2, len(t)-2, stats.chi2.sf(chi2, len(t)-2)

p2 = m2.predict(X2); p3 = m3.predict(X3)
c2,d2_,p2_ = hosmer_lemeshow(y, p2)
c3,d3_,p3_ = hosmer_lemeshow(y, p3)
print(f"\nH-L M2: chi2={c2:.3f}, df={d2_}, p={p2_:.4f}")
print(f"H-L M3: chi2={c3:.3f}, df={d3_}, p={p3_:.4f}")

dr = m2.resid_dev; pr = m2.resid_pearson
print(f"\nDev resid: mean={dr.mean():.4f}, std={dr.std():.4f}, max|.|={np.abs(dr).max():.4f}, >3: {int((np.abs(dr)>3).sum())}")
print(f"Pear resid: mean={pr.mean():.4f}, std={pr.std():.4f}, max|.|={np.abs(pr).max():.4f}, >3: {int((np.abs(pr)>3).sum())}")

a1 = auc_score(y, m1.predict(X1))
a2 = auc_score(y, p2)
a3 = auc_score(y, p3)
print(f"\nAUC: M1={a1:.4f}, M2={a2:.4f}, M3={a3:.4f}")
print(f"Convergence: M2={'OK' if m2.mle_retvals['converged'] else 'WARN'} (iters={m2.mle_retvals['iterations']}), M3={'OK' if m3.mle_retvals['converged'] else 'WARN'} (iters={m3.mle_retvals['iterations']})")

print("\n" + "=" * 70)
print("STEP 6: EFFECT SUMMARY (M2 primary)")
print("=" * 70)
b0,b1,b2_ = m2.params['const'], m2.params['AGE_c'], m2.params['AGE_c2']
print(f"\nCoefs: int={b0:.4f}, AGE_c={b1:.4f}, AGE_c2={b2_:.4f}")
if b2_ != 0:
    vc = -b1/(2*b2_); va = vc + age_mean
    shape = "Inverted-U (peak)" if b2_ < 0 else "U-shaped (min)"
    print(f"Vertex: AGE_c={vc:.2f} -> AGE={va:.2f} [{shape}]")

print(f"\n{'Age':>5} | {'AGE_c':>7} | {'dP/dAGE':>9} | {'P(DISSAVED)':>12}")
print("-" * 45)
for age in range(24, 33):
    ac = age - age_mean
    dp = b1 + 2*b2_*ac
    lg = b0 + b1*ac + b2_*ac**2
    pb = 1/(1+np.exp(-lg))
    print(f"{age:>5} | {ac:>7.2f} | {dp:>9.5f} | {pb:>12.4f}")

print(f"\nAge-specific P (M3, MALE=0,BLACK=0,HISPANIC=0):")
print(f"{'Age':>5} | {'P':>7} | {'95% CI':>22}")
for age in [24,26,28,30,32]:
    ac = age - age_mean
    xn = np.array([1, ac, ac**2, 0, 0, 0])
    lg = xn @ m3.params
    pb = 1/(1+np.exp(-lg))
    se = np.sqrt(xn @ m3.cov_params().values @ xn)
    lo = 1/(1+np.exp(-(lg-1.96*se))); hi = 1/(1+np.exp(-(lg+1.96*se)))
    print(f"{age:>5} | {pb:>7.4f} | [{lo:.4f}, {hi:.4f}]")

print("\n" + "=" * 70)
print("STEP 7: SENSITIVITY - FULL DATA")
print("=" * 70)
df_full = df.copy()
amf = df_full['AGE'].mean()
df_full['AGE_c'] = df_full['AGE'] - amf
df_full['AGE_c2'] = df_full['AGE_c']**2
df_full['MALE'] = (df_full['GENDER']=='MALE').astype(int)
yf = df_full['DISSAVED'].values

X1f = sm.add_constant(df_full[['AGE_c']]); m1f = sm.Logit(yf, X1f).fit(disp=0)
X2f = sm.add_constant(df_full[['AGE_c','AGE_c2']]); m2f = sm.Logit(yf, X2f).fit(disp=0)
X3f = sm.add_constant(df_full[['AGE_c','AGE_c2','MALE','BLACK','HISPANIC']]); m3f = sm.Logit(yf, X3f).fit(disp=0)

print(f"\n{'Model':>25} | {'LogL':>10} | {'AIC':>10} | {'BIC':>10} | {'PseudoR2':>9} | {'N':>6}")
print("-" * 80)
for name, m in [("M1f: Linear(full)", m1f), ("M2f: Quadratic(full)", m2f), ("M3f: Quad+Ctrl(full)", m3f)]:
    print(f"{name:>25} | {m.llf:>10.2f} | {m.aic:>10.2f} | {m.bic:>10.2f} | {m.prsquared:>9.4f} | {int(m.nobs):>6}")

print(f"\n--- M2f (full) ---")
print(m2f.summary2().tables[1].round(4).to_string())
print(f"\n--- M3f (full) ---")
print(m3f.summary2().tables[1].round(4).to_string())

print("\n" + "=" * 70)
print("STEP 8: COMPARISON DEDUPED vs FULL")
print("=" * 70)
p2p = m2.params; p3p = m3.params; p2fp = m2f.params; p3fp = m3f.params
print(f"\n{'Model':>18} | {'AGE_c':>8} | {'AGE_c2':>8} | {'MALE':>8} | {'BLACK':>8} | {'HISP':>8} | {'AUC':>7}")
print("-" * 85)
print(f"{'M2(dedup)':>18} | {p2p['AGE_c']:>8.4f} | {p2p['AGE_c2']:>8.4f} | {'-':>8} | {'-':>8} | {'-':>8} | {a2:>7.4f}")
print(f"{'M2f(full)':>18} | {p2fp['AGE_c']:>8.4f} | {p2fp['AGE_c2']:>8.4f} | {'-':>8} | {'-':>8} | {'-':>8} | {auc_score(yf,m2f.predict(X2f)):>7.4f}")
print(f"{'M3(dedup)':>18} | {p3p['AGE_c']:>8.4f} | {p3p['AGE_c2']:>8.4f} | {p3p['MALE']:>8.4f} | {p3p['BLACK']:>8.4f} | {p3p['HISPANIC']:>8.4f} | {a3:>7.4f}")
print(f"{'M3f(full)':>18} | {p3fp['AGE_c']:>8.4f} | {p3fp['AGE_c2']:>8.4f} | {p3fp['MALE']:>8.4f} | {p3fp['BLACK']:>8.4f} | {p3fp['HISPANIC']:>8.4f} | {auc_score(yf,m3f.predict(X3f)):>7.4f}")
