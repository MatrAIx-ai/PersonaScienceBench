"""
NLSY79: Time preference (1989 savings behavior) and BMI — association analysis.

UNIT CONVERSIONS (documented — top silent-error risk):
  Metadata labels Height as inches and Weight as kg, but data ranges contradict this:
    Weight (1981/1989/1992): means 145.5/161.5/167.6, max 996 -> POUNDS.
        Confirmed: BMI1992 with lb->kg = 26.3 (plausible); as-kg = 57.7 (impossible).
        => weight_kg = weight_raw / 2.20462
    Height 1985: 48-81 in, mean 67.1 -> INCHES (as metadata says).
    Height 1981: 400-611, mean 519.4 -> NOT inches, NOT cm. Empirically calibrated:
        dividing by 3.048 gives mean 170.2 cm, matching the 1985 inch-height
        (67.1 in = 170.4 cm); 1981-vs-1985 difference then has mean +0.17 cm
        (adults stable, as expected); range 131-200 cm plausible.
        => height1981_m = height1981_raw / 3.048 / 100
        Robustness: OLS-calibrated scale from 1985 height (n=10,581):
        h85_in = 26.4414 + 0.07834*h81_raw  ->  identical BMI (mean 26.16 vs 26.33).

Design (per approved plan):
  Primary outcome:  BMI1992 = weight1992_kg / height1981_m^2
                    (assumes 1981 adult height persists to 1992)
  Robustness outcome: BMI1981 (same height); note 1981 BMI predates the 1989 TP item.
  Primary TP index: 1989 savings-direction item, codes 1-4, HIGHER = MORE time
                    preference (1 put in = most patient ... 4 took out/no savings).
  Robustness TP: 1989 net saving flow = (net put in) - (net took out), winsorized 1/99.
  Covariates: age1989, sex, race dummies, highest grade 1979, ever-incarceration
              (JAIL=5 any residence year OR pre-1980 correctional sentence),
              ASVAB composite (mean of 4 z-scores, standardized), log family income 1989.
  Missingness: listwise deletion, no imputation; complete-vs-incomplete comparison.
  Inference: OLS, HC1 robust SEs; standardized beta via z-scored re-fit.
"""
import pandas as pd, numpy as np
from scipy import stats

pd.set_option('display.width', 220)
df = pd.read_csv('data/nls_raw.csv')

def winsor(s, lo=0.01, hi=0.99):
    qlo, qhi = s.quantile(lo), s.quantile(hi)
    return s.clip(qlo, qhi)

# ---------- sanitization & units ----------
df['grade79'] = df['Highest grade completed, 1979']
df.loc[df['grade79'] > 21, 'grade79'] = np.nan          # 95 etc. = sentinel -> missing
df['h81_m']  = df['Height of respondent, 1981'] / 3.048 / 100.0      # calibrated scale -> m
j = df.dropna(subset=['Height of respondent, 1981','Height of respondent, 1985'])
b1, b0 = np.polyfit(df.loc[j.index,'Height of respondent, 1981'], df.loc[j.index,'Height of respondent, 1985'], 1)
df['h81_m_ols'] = (b0 + b1*df['Height of respondent, 1981'])*0.0254  # OLS-calibrated alt
df['w81_kg'] = winsor(df['Weight of respondent, 1981'])/2.20462
df['w92_kg'] = winsor(df['Weight of respondent, 1992'])/2.20462
df['bmi81'] = df['w81_kg']/df['h81_m']**2
df['bmi92'] = df['w92_kg']/df['h81_m']**2
df['bmi92_ols'] = df['w92_kg']/df['h81_m_ols']**2

# ---------- time preference ----------
df['tp'] = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
net_in  = df['Net amount respondent/spouse put into savings since last interview, 1989']
net_out = df['Net amount respondent/spouse took out of savings since last interview, 1989']
df['netflow'] = winsor(net_in.fillna(0) - net_out.fillna(0), 0.01, 0.99)

# ---------- covariates ----------
res_cols = [c for c in df.columns if c.startswith('Type of residence')]
df['jail_ever'] = pd.concat([df[c].eq(5) for c in res_cols], axis=1).any(axis=1).astype(int)
df['incarcerated'] = ((df['jail_ever']==1) |
    (df['Ever been sentenced in any correctional institution before 1980']==1)).astype(int)
asv = [f'ASVAB - {n} Z Score (rounded), 1981' for n in
       ['Arithmetic Reasoning','Word Knowledge','Paragraph Comprehension','Mathematics Knowledge']]
df['asvab'] = (df[asv].mean(axis=1) - df[asv].mean(axis=1).mean()) / df[asv].mean(axis=1).std()
df['inc89']  = np.log1p(winsor(df['Total net family income, previous calendar year, 1989']))
df['sex_male']   = (df['Sex of respondent, 1979']==1).astype(int)
df['race_black'] = (df['Racial/ethnic cohort, 1979']==1).astype(int)
df['race_hisp']  = (df['Racial/ethnic cohort, 1979']==2).astype(int)
df['age89'] = df['Age of respondent at interview date, 1989']
df['age81'] = df['Age of respondent at interview date, 1981']
df['rank_pct'] = (1 - (df['Rank in class last year attended at this school, 1981']-1)/
                  df['Number of students in class last year attended at this school, 1981'])

CONTROLS = ['age89','sex_male','race_black','race_hisp','grade79','incarcerated','asvab','inc89']

def ols(y, X, data):
    d = data[[y]+X].dropna()
    Xd = d[X].copy(); Xd.insert(0,'const',1.0)
    beta,*_ = np.linalg.lstsq(Xd.values, d[y].values, rcond=None)
    resid = d[y].values - Xd.values@beta
    n,k = Xd.shape
    XTXi = np.linalg.inv(Xd.values.T@Xd.values)
    cov = XTXi @ ((Xd.values.T*resid**2)@Xd.values) @ XTXi * (n/(n-k))  # HC1 sandwich
    se = np.sqrt(np.diag(cov)); t = beta/se; p = 2*stats.t.sf(np.abs(t), n-k)
    ci = (beta-1.96*se, beta+1.96*se)
    r2 = 1 - resid@resid/((d[y]-d[y].mean())**2).sum()
    zs = (Xd-Xd.mean())/Xd.std(ddof=1); zs['const']=1
    zby = (d[y]-d[y].mean())/d[y].std(ddof=1)
    sbeta,*_ = np.linalg.lstsq(zs.values, zby.values, rcond=None)
    i = list(Xd.columns).index(X[0])
    return dict(n=n, b=beta[i], se=se[i], t=t[i], p=p[i], ci=(ci[0][i],ci[1][i]),
                sbeta=sbeta[i], r2=r2)

def rep(r, label):
    print(f"{label}\n   n={r['n']} coef={r['b']:.4f} SE={r['se']:.4f} 95%CI=[{r['ci'][0]:.4f},{r['ci'][1]:.4f}] "
          f"p={r['p']:.4g} std_beta={r['sbeta']:.4f} R2={r['r2']:.4f}")
    return r

print("="*110)
main = df.dropna(subset=['bmi92','tp']+CONTROLS)
print(f"Primary sample (listwise): n={len(main)} of {len(df)}")
print(f"BMI1992: mean={main['bmi92'].mean():.2f} sd={main['bmi92'].std():.2f}  (OLS-scale check: {main['bmi92_ols'].mean():.2f})")
print("TP index distribution:\n" + main['tp'].value_counts().sort_index().to_string())
r_main = rep(ols('bmi92',['tp']+CONTROLS, main), "PRIMARY  BMI1992 ~ TP1989 + controls")

print("\nMean BMI1992 by savings-direction category (primary sample):")
print(main.groupby('tp')['bmi92'].agg(count='count', mean='mean', sd='std').round(2).to_string())

r_sens = rep(ols('bmi92',['tp']+CONTROLS, main[main['tp']!=4]), "SENSITIVITY  drop cat 4 'NO SAVINGS'")
r_flow = rep(ols('bmi92',['netflow']+CONTROLS, main), "ROBUST  TP = netflow1989 (winsorized)")
r_81   = rep(ols('bmi81',['tp','age81','sex_male','race_black','race_hisp','grade79','incarcerated','asvab','inc89'], df),
             "ROBUST  BMI1981 ~ TP1989 + controls (reverse-temporal check)")
r_ols  = rep(ols('bmi92_ols',['tp']+CONTROLS, main), "ROBUST  BMI1992 on OLS-calibrated height scale")
r_rank = rep(ols('bmi92',['tp']+CONTROLS+['rank_pct'], main), "ROBUST  + class-rank percentile")

print("\nComplete-vs-incomplete case comparison (primary model variables):")
mask = df[['bmi92','tp']+CONTROLS].notna().all(axis=1)
print(f"  complete n={int(mask.sum())}  incomplete n={int((~mask).sum())}")
print(f"  {'var':12s} {'complete':>10s} {'incomplete':>10s} {'diff':>9s} {'t':>8s} {'p':>8s}")
for v in ['age89','sex_male','race_black','race_hisp','grade79','incarcerated','asvab','inc89']:
    a, b = df.loc[mask,v].dropna(), df.loc[~mask,v].dropna()
    t, p = stats.ttest_ind(a, b, equal_var=False)
    print(f"  {v:12s} {a.mean():10.3f} {b.mean():10.3f} {a.mean()-b.mean():9.3f} {t:8.2f} {p:8.2g}")
