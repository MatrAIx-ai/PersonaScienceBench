class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.buf = bytearray(bg * (w * h))

    def _stamp(self, x, y, c):
        if 0 <= x < self.w and 0 <= y < self.h:
            o = (y * self.w + x) * 3
            self.buf[o:o + 3] = bytes(c)

    def rect(self, x0, y0, x1, y1, c):
        for y in range(int(y0), int(y1) + 1):
            for x in range(int(x0), int(x1) + 1):
                self._stamp(x, y, c)

    def line(self, x0, y0, x1, y1, c, w=2):
        d = max(abs(x1 - x0), abs(y1 - y0))
        steps = max(int(d * 3), 1)
        r = w // 2
        for t in range(steps + 1):
            x = x0 + (x1 - x0) * t / steps
            y = y0 + (y1 - y0) * t / steps
            for dy in range(-r, r + 1):
                for dx in range(-r, r + 1):
                    self._stamp(int(x) + dx, int(y) + dy, c)

    def dashed(self, x0, y0, x1, y1, c, w=2, dash=10, gap=7):
        d = max(abs(x1 - x0), abs(y1 - y0))
        steps = max(int(d * 3), 1)
        r = w // 2
        on = True
        left = dash
        for t in range(steps + 1):
            if left == 0:
                on = not on
                left = dash if on else gap
            left -= d / steps
            if on:
                x = x0 + (x1 - x0) * t / steps
                y = y0 + (y1 - y0) * t / steps
                for dy in range(-r, r + 1):
                    for dx in range(-r, r + 1):
                        self._stamp(int(x) + dx, int(y) + dy, c)

    def circle(self, cx, cy, r, c, fill=False, w=2):
        if fill:
            for y in range(int(cy - r), int(cy + r) + 1):
                for x in range(int(cx - r), int(cx + r) + 1):
                    if (x - cx) ** 2 + (y - cy) ** 2 <= r * r:
                        self._stamp(x, y, c)
        else:
            for a in range(0, 360, 2):
                import math
                x = cx + r * math.cos(math.radians(a))
                y = cy + r * math.sin(math.radians(a))
                for dy in range(-w // 2, w // 2 + 1):
                    for dx in range(-w // 2, w // 2 + 1):
                        self._stamp(int(x) + dx, int(y) + dy, c)

    def text(self, x, y, s, c=(0, 0, 0), sc=2):
        x = int(x)
        for ch in s.upper():
            g = _FONT.get(ch, _FONT[' '])
            for row in range(7):
                bits = g[row]
                for col in range(5):
                    if bits & (0x10 >> col):
                        self.rect(x + col * sc, y + row * sc,
                                  x + col * sc + sc - 1, y + row * sc + sc - 1, c)
            x += 6 * sc

    def text_w(self, s, sc=2):
        return 6 * sc * len(s)

    def save(self, path):
        w, h = self.w, self.h
        raw = b''.join(b'\x00' + bytes(self.buf[y * w * 3:(y + 1) * w * 3]) for y in range(h))
        def chunk(tag, data):
            c = struct.pack('>I', len(data)) + tag + data
            return c + struct.pack('>I', zlib.crc32(tag + data) & 0xFFFFFFFF)
        png = b'\x89PNG\r\n\x1a\n'
        png += chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
        png += chunk(b'IDAT', zlib.compress(raw, 9))
        png += chunk(b'IEND', b'')
        open(path, 'wb').write(png)

