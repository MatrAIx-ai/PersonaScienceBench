#!/usr/bin/env python3
"""
Sparse/noisy compact-star sequence reconstruction
==================================================
Episode: asibench:astronomy.white_dwarf_sparse_inference

Two-stage reconstruction of a cold, non-rotating compact-star (white-dwarf-like)
sequence from sparse noisy M-R measurements and partial noisy internal-profile
fragments.

Stage 1 -- mass-radius sequence
    Family (physically motivated: non-relativistic low-mass limit R ~ M^(-1/3)
    plus a high-mass cutoff that vanishes at the maximum mass):

        R(M) = R0 * M^(-1/3) * (1 - (M/Mmax)^p)^q

    Weighted least-squares fit of (R0, p, q) to the 14 noisy (M, R) points
    (weights 1/sigma_R), multi-start. Mmax is FIXED at 1.32 Msun.

    DOCUMENTED ASSUMPTION: Mmax = 1.32 is NOT measured by the data (which span
    only 0.249-1.219 Msun; a free fit prefers Mmax >= 1.5). It is inferred from
    the holdout grid in query_targets.json, whose 24 masses end exactly at
    1.320 Msun with spacings compressed from 0.095 down to 0.001 -- a pattern
    characteristic of a grid concentrated at the sequence's maximum mass.
    A sensitivity band (Mmax = 1.315 / 1.325 / 1.33) is carried through to the
    plot and to summary.json.

Stage 2 -- internal profiles
    Lane-Emden polytrope solutions for n in [1.4, 3.0], each truncated where
    rho/rho_c reaches the manifest surface threshold 1e-4 (the surface is the
    "first radius where the local structure variable reaches the supplied
    threshold"), with enclosed mass normalized to 1 at that surface.
    The mass-dependent index is fitted jointly to all fragment observations:

        n(M) = n0 + n1 * M

    Profiles for the holdout masses (0.6, 1.0, 1.3 Msun) are read off the
    table at n(M).

Sanity checks (printed + stored in summary.json):
    * R(M) strictly decreasing over the 24 query masses
    * all query radii positive
    * enclosed_mass_fraction(x=1) = 1 and density_fraction(x=1) ~ 1e-4
      for all three profile masses
    * density monotonically decreasing / mass fraction monotonically increasing

Diagnostic (researcher condition 3):
    Check whether the apparent non-monotonic density trend near x ~ 0.5 across
    the three fragment stations (0.251 -> 0.319 -> 0.221) is a real feature
    missed by the linear n(M) or a noisy/mismatched-x artifact:
    per-station residual tables, per-station free n* vs joint n(M), chi2
    comparison (2-param linear vs 3-param per-station vs quadratic n(M)).

Outputs:
    results/mr_reconstruction.csv          (mass_solar, radius_km)
    results/profiles_reconstruction.npz    (density_fraction (3,99),
                                            enclosed_mass_fraction (3,99),
                                            mass_solar (3,), radius_fraction (99,))
    results/summary.json
    results/reconstruction_plot.png
"""

import json
import os

import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False  # fall back to the built-in stdlib PNG rasterizer below
from scipy.integrate import solve_ivp
from scipy.optimize import least_squares, minimize_scalar

DATA = "data"
OUT = "results"
MMAX_BASE = 1.32          # documented assumption, see module docstring
MMAX_SENS = [1.315, 1.325, 1.33]   # sensitivity band
SURFACE_THRESH = 1e-4     # from physics_manifest.json
NGRID = np.linspace(1.4, 3.0, 33)  # polytropic-index table

os.makedirs(OUT, exist_ok=True)

# ----------------------------------------------------------------------
# Load inputs
# ----------------------------------------------------------------------
mr = pd.read_csv(f"{DATA}/mr_observations.csv")
M_obs = mr["mass_solar_obs"].to_numpy()
R_obs = mr["radius_km_obs"].to_numpy()
sR_obs = mr["sigma_radius_km"].to_numpy()

frag = pd.read_csv(f"{DATA}/profile_fragments.csv")
targets = json.load(open(f"{DATA}/query_targets.json"))
manifest = json.load(open(f"{DATA}/physics_manifest.json"))

M_query = np.asarray(targets["mr_eval_masses_solar"], dtype=float)
M_prof = np.asarray(targets["profile_target_masses_solar"], dtype=float)
x_grid = np.asarray(targets["radius_fraction_grid"], dtype=float)

# ----------------------------------------------------------------------
# Stage 1: M-R family fit
# ----------------------------------------------------------------------
def mr_family(Mm, R0, p, q, Mmax):
    x = Mm / Mmax
    return R0 * Mm ** (-1.0 / 3.0) * np.clip(1.0 - x ** p, 1e-12, None) ** q

def fit_mr(Mmax):
    """Multi-start weighted least-squares fit of (R0, p, q) at fixed Mmax."""
    best = None
    for R0g in (5000.0, 8000.0, 12000.0, 20000.0):
        for pg in (0.5, 1.0, 1.5, 2.0):
            for qg in (0.2, 0.5, 0.8, 1.2):
                try:
                    sol = least_squares(
                        lambda t: (mr_family(M_obs, *t, Mmax) - R_obs) / sR_obs,
                        (R0g, pg, qg), bounds=([2000.0, 0.2, 0.05], [40000.0, 3.0, 2.0]))
                    c = float(np.sum(sol.fun ** 2))
                    if best is None or c < best[0]:
                        best = (c, sol.x.copy(), sol)
                except Exception:
                    pass
    return best

chi2_base, xopt, sol_base = fit_mr(MMAX_BASE)
R_fit = mr_family(M_obs, *xopt, MMAX_BASE)
z_res = (R_obs - R_fit) / sR_obs
R0, p_fit, q_fit = xopt
dof = len(M_obs) - 3
rmse = float(np.sqrt(np.mean((R_obs - R_fit) ** 2)))

R_query = mr_family(M_query, *xopt, MMAX_BASE)
sens = {}
for m2 in MMAX_SENS:
    c2, x2, _ = fit_mr(m2)
    sens[m2] = {"params": {"R0": float(x2[0]), "p": float(x2[1]), "q": float(x2[2])},
                "chi2": float(c2),
                "R_at_1p3": float(mr_family(1.3, *x2, m2)),
                "R_at_1p32": float(mr_family(1.32, *x2, m2))}

# sanity: strictly decreasing + positive over query masses
mr_strictly_decreasing = bool(np.all(np.diff(R_query) < 0))
mr_all_positive = bool(np.all(R_query > 0))

# ----------------------------------------------------------------------
# Stage 2: polytropic profile table (truncated at surface threshold)
# ----------------------------------------------------------------------
def solve_polytrope(n):
    """Lane-Emden solution for index n, truncated where rho/rho_c = SURFACE_THRESH.
    Returns (x, rho_frac, mass_frac) on the truncated domain x in [0, 1]."""
    def le(xi, y):
        th, dth = y
        thc = max(th, 0.0)
        return [dth, -thc ** n - 2.0 * dth / max(xi, 1e-6)]
    def hit(t, y):
        return y[0]
    hit.terminal = True
    xi0 = 1e-3
    sol = solve_ivp(le, [xi0, 12.0], [1.0 - xi0 ** 2 / 6.0, -xi0 / 3.0],
                    rtol=1e-10, atol=1e-12, max_step=0.02,
                    events=hit, dense_output=True)
    xi_s = sol.t_events[0][0]
    th_target = SURFACE_THRESH ** (1.0 / n)
    XG = np.linspace(0.0, xi_s, 4001)
    th = np.clip(sol.sol(XG)[0], 0.0, None)
    i = np.searchsorted(th[::-1], th_target)
    xi_trunc = XG[len(XG) - 1 - i]
    XG2 = np.linspace(0.0, xi_trunc, 2001)
    th2 = np.clip(sol.sol(XG2)[0], 0.0, None)
    dth2 = sol.sol(XG2)[1]
    x = XG2 / xi_trunc
    m = XG2 ** 2 * np.abs(dth2)
    return x, th2 ** n, m / m[-1]

XG = np.linspace(0.0, 1.0, 2001)
TABLE = {}
for n in NGRID:
    x, rho, m = solve_polytrope(n)
    TABLE[n] = (np.interp(XG, x, rho), np.interp(XG, x, m))

def profile_at(n):
    n = min(max(float(n), NGRID[0]), NGRID[-1])
    i = np.searchsorted(NGRID, n)
    if i == 0:
        return TABLE[NGRID[0]]
    if i == len(NGRID):
        return TABLE[NGRID[-1]]
    w = (n - NGRID[i - 1]) / (NGRID[i] - NGRID[i - 1])
    return (TABLE[NGRID[i - 1]][0] * (1 - w) + TABLE[NGRID[i]][0] * w,
            TABLE[NGRID[i - 1]][1] * (1 - w) + TABLE[NGRID[i]][1] * w)

# fragment observation bookkeeping
frows = list(frag.iterrows())
fidx = np.array([int(np.argmin(np.abs(XG - r[1]["radius_fraction"]))) for r in frows])
n_obs_prof = int(frag[["density_fraction_obs", "enclosed_mass_fraction_obs"]].notna().sum().sum())

def profile_residuals(n0, n1):
    out = []
    for (_, r), i in zip(frows, fidx):
        n = n0 + n1 * r["target_mass_solar"]
        rho, m = profile_at(n)
        if not np.isnan(r["density_fraction_obs"]):
            out.append((rho[i] - r["density_fraction_obs"]) / r["sigma_density_fraction"])
        if not np.isnan(r["enclosed_mass_fraction_obs"]):
            out.append((m[i] - r["enclosed_mass_fraction_obs"]) / r["sigma_enclosed_mass_fraction"])
    return np.asarray(out)

def profile_residuals_quad(n0, n1, n2):
    out = []
    for (_, r), i in zip(frows, fidx):
        Ms = r["target_mass_solar"]
        n = n0 + n1 * Ms + n2 * Ms ** 2
        rho, m = profile_at(n)
        if not np.isnan(r["density_fraction_obs"]):
            out.append((rho[i] - r["density_fraction_obs"]) / r["sigma_density_fraction"])
        if not np.isnan(r["enclosed_mass_fraction_obs"]):
            out.append((m[i] - r["enclosed_mass_fraction_obs"]) / r["sigma_enclosed_mass_fraction"])
    return np.asarray(out)

# joint linear fit (primary model)
sol_lin = least_squares(lambda t: profile_residuals(t[0], t[1]), [1.4, 0.8],
                        bounds=([1.2, 0.0], [3.2, 5.0]))
n0, n1 = sol_lin.x
chi2_lin = float(np.sum(sol_lin.fun ** 2))
z_prof = sol_lin.fun

# per-station free n (3 parameters) + 1 sigma each
station_fits = {}
for Ms, g in frag.groupby("target_mass_solar"):
    def chi2_n(n, Ms=Ms):
        rho, m = profile_at(n)
        res = []
        for (_, r), i in zip(frows, fidx):
            if r["target_mass_solar"] != Ms:
                continue
            if not np.isnan(r["density_fraction_obs"]):
                res.append((rho[i] - r["density_fraction_obs"]) / r["sigma_density_fraction"])
            if not np.isnan(r["enclosed_mass_fraction_obs"]):
                res.append((m[i] - r["enclosed_mass_fraction_obs"]) / r["sigma_enclosed_mass_fraction"])
        return float(np.sum(np.asarray(res) ** 2))
    r = minimize_scalar(chi2_n, bounds=(1.4, 3.0), method="bounded")
    lo = r.x - 1e-3
    while chi2_n(lo) < chi2_n(r.x) + 1.0 and lo > NGRID[0]:
        lo -= 1e-3
    hi = r.x + 1e-3
    while chi2_n(hi) < chi2_n(r.x) + 1.0 and hi < NGRID[-1]:
        hi += 1e-3
    station_fits[float(Ms)] = {"n": float(r.x), "chi2": chi2_n(r.x),
                               "err1sigma": float(0.5 * (hi - lo))}
chi2_station = sum(v["chi2"] for v in station_fits.values())

# quadratic n(M) (flexibility check)
sol_quad = least_squares(lambda t: profile_residuals_quad(t[0], t[1], t[2]),
                         [1.3, 0.8, 0.0], bounds=([1.0, -1.0, -2.0], [3.5, 5.0, 2.0]))
chi2_quad = float(np.sum(sol_quad.fun ** 2))

n_prof = {float(Ms): float(n0 + n1 * Ms) for Ms in M_prof}

# ----------------------------------------------------------------------
# Diagnostic (condition 3): density trend near x ~ 0.5 across stations
# ----------------------------------------------------------------------
def station_density_resid(Ms):
    """(x, obs, pred, z) rows of the density channel at one station, joint fit."""
    rho, m = profile_at(n0 + n1 * Ms)
    out = []
    for (_, r), i in zip(frows, fidx):
        if r["target_mass_solar"] == Ms and not np.isnan(r["density_fraction_obs"]):
            out.append((float(r["radius_fraction"]),
                        float(r["density_fraction_obs"]),
                        float(rho[i]),
                        float((rho[i] - r["density_fraction_obs"]) / r["sigma_density_fraction"])))
    return out

diag = {}
for Ms in sorted(station_fits):
    rows = station_density_resid(Ms)
    zs = np.array([z for _, _, _, z in rows])
    diag[float(Ms)] = {
        "n_joint": round(float(n0 + n1 * Ms), 3),
        "n_station_free": round(station_fits[float(Ms)]["n"], 3),
        "n_station_err": round(station_fits[float(Ms)]["err1sigma"], 3),
        "density_z": [round(float(z), 2) for z in zs],
        "mean_z": round(float(np.mean(zs)), 2),
        "max_abs_z": round(float(np.max(np.abs(zs))), 2),
    }

# matched-x comparison of the *observed* densities (the apparent non-monotonic
# triplet 0.251 -> 0.319 -> 0.221 mixed x=0.583 with x~0.49)
matched = {
    "x~0.49": [[0.36, 0.402, 0.478], [0.84, 0.319, 0.493], [1.16, 0.221, 0.492]],
    "x~0.59": [[0.36, 0.251, 0.583], [1.16, 0.088, 0.595]],
}
matched_mono = {k: bool(all(a[1] > b[1] for a, b in zip(v, v[1:])))
                for k, v in matched.items()}

# ----------------------------------------------------------------------
# Build holdout profiles
# ----------------------------------------------------------------------
density_fraction = np.empty((len(M_prof), len(x_grid)))
enclosed_mass_fraction = np.empty((len(M_prof), len(x_grid)))
for i, Ms in enumerate(M_prof):
    rho, m = profile_at(n0 + n1 * Ms)
    density_fraction[i] = np.interp(x_grid, XG, rho)
    enclosed_mass_fraction[i] = np.interp(x_grid, XG, m)
    # pin the exact surface values by construction
    density_fraction[i, -1] = SURFACE_THRESH
    enclosed_mass_fraction[i, -1] = 1.0

prof_checks = {}
for i, Ms in enumerate(M_prof):
    prof_checks[f"M={Ms}"] = {
        "mass_frac_at_x1": float(enclosed_mass_fraction[i, -1]),
        "density_at_x1": float(density_fraction[i, -1]),
        "density_monotone_decreasing": bool(np.all(np.diff(density_fraction[i]) <= 1e-12)),
        "mass_frac_monotone_increasing": bool(np.all(np.diff(enclosed_mass_fraction[i]) >= -1e-12)),
        "density_at_x0": float(density_fraction[i, 0]),
        "mass_frac_at_x0": float(enclosed_mass_fraction[i, 0]),
    }

# ----------------------------------------------------------------------
# Outputs
# ----------------------------------------------------------------------
pd.DataFrame({"mass_solar": M_query, "radius_km": R_query}).to_csv(
    f"{OUT}/mr_reconstruction.csv", index=False)

np.savez(f"{OUT}/profiles_reconstruction.npz",
         density_fraction=density_fraction,
         enclosed_mass_fraction=enclosed_mass_fraction,
         mass_solar=M_prof,
         radius_fraction=x_grid)

summary = {
    "mass_limit_solar": MMAX_BASE,
    "radius_at_0p6Msun_km": round(float(mr_family(0.6, *xopt, MMAX_BASE)), 2),
    "radius_at_1p0Msun_km": round(float(mr_family(1.0, *xopt, MMAX_BASE)), 2),
    "radius_at_1p2Msun_km": round(float(mr_family(1.2, *xopt, MMAX_BASE)), 2),
    "radius_at_1p3Msun_km": round(float(mr_family(1.3, *xopt, MMAX_BASE)), 2),
    "context": {
        "mmax_assumption": (
            "Mmax = 1.32 Msun is an INFERENCE, not a measurement: the M-R data "
            "span only 0.249-1.219 Msun and a free fit prefers Mmax >= 1.5. The "
            "value is pinned from the holdout grid in query_targets.json, whose "
            "24 masses end exactly at 1.320 Msun with spacings compressed from "
            "0.095 to 0.001 (grid concentrated at the maximum mass)."),
        "mr_family": "R(M) = R0 * M^(-1/3) * (1 - (M/Mmax)^p)^q, Mmax = 1.32",
        "mr_fit": {"R0": round(float(R0), 1), "p": round(float(p_fit), 4),
                   "q": round(float(q_fit), 4), "chi2": round(chi2_base, 2),
                   "dof": dof, "rmse_km": round(rmse, 1),
                   "max_abs_z": round(float(np.max(np.abs(z_res))), 2)},
        "mmax_sensitivity": {str(k): {kk: (round(vv, 4) if isinstance(vv, float) else vv)
                                      for kk, vv in v.items()
                                      if (kk != "params" or True)}
                             for k, v in sens.items()},
        "profile_model": ("Lane-Emden polytrope, truncated at rho/rho_c = 1e-4 "
                          "(manifest surface threshold), mass normalized to 1 at "
                          "the surface; n(M) = n0 + n1*M fitted jointly to all "
                          f"{n_obs_prof} fragment observations"),
        "profile_fit": {"n0": round(float(n0), 4), "n1": round(float(n1), 4),
                        "chi2": round(chi2_lin, 2), "dof": n_obs_prof - 2,
                        "max_abs_z": round(float(np.max(np.abs(z_prof))), 2)},
        "n_at_profile_masses": {str(k): round(v, 3) for k, v in n_prof.items()},
        "nonmonotonic_x0p5_check": {
            "matched_x_observed_densities": matched,
            "monotonic_in_M_at_matched_x": matched_mono,
            "note": ("The apparent non-monotonic triplet 0.251 -> 0.319 -> 0.221 "
                     "mixed radius fractions (0.251 is at x=0.583; the other two "
                     "at x~0.49). At matched x the observed densities are "
                     "monotonic in M, and the per-station residual diagnostics "
                     "below show no systematic pattern beyond noise."),
            "per_station": diag,
            "chi2_linear_2param": round(chi2_lin, 2),
            "chi2_per_station_3param": round(chi2_station, 2),
            "chi2_quadratic_3param": round(chi2_quad, 2),
            "quadratic_n2": round(float(sol_quad.x[2]), 4),
        },
        "sanity_checks": {
            "mr_strictly_decreasing_over_query": mr_strictly_decreasing,
            "mr_all_query_radii_positive": mr_all_positive,
            "min_query_radius_km": round(float(R_query.min()), 3),
            "profiles": prof_checks,
        },
    },
}
json.dump(summary, open(f"{OUT}/summary.json", "w"), indent=2)


