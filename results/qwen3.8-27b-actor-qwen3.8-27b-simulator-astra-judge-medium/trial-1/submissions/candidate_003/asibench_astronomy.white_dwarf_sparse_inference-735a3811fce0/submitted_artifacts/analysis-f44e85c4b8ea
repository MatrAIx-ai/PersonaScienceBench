def render_fallback_png(path):
    """Dependency-free rendering of the 2x2 reconstruction figure."""
    BLACK = (0, 0, 0); BLUE = (31, 119, 180); GREEN = (44, 160, 44)
    RED = (214, 39, 40); ORANGE = (255, 127, 14); GRAY = (205, 205, 205)
    QC = [(127, 20, 187), (37, 99, 235), (22, 163, 74)]
    FC = [(217, 119, 6), (190, 60, 60), (150, 90, 30)]
    cv = Canvas(1300, 1050)

    def center_text(y, s, c=BLACK, sc=2):
        cv.text((1300 - cv.text_w(s, sc)) / 2, y, s, c, sc)

    center_text(12, "COMPACT-STAR SEQUENCE RECONSTRUCTION (COLD, STABLE BRANCH)", sc=3)
    center_text(44, "ASSUMPTION: MMAX=1.32 MSUN INFERRED FROM HOLDOOUT-GRID ENDPOINT (LAST MASS 1.320, SPACING 0.095->0.001)", sc=2)
    center_text(62, "M-R DATA ALONE SPAN 0.25-1.22 MSUN; SENSITIVITY BAND = MMAX 1.315/1.325/1.33", sc=2)

    def axis(box, xlim, ylim, xticks, yticks, xlabel, ylabel, title):
        x0, y0, x1, y1 = box
        cv.rect(x0, y0, x1, y1, (255, 255, 255))
        for t in xticks:
            px = x0 + (t - xlim[0]) / (xlim[1] - xlim[0]) * (x1 - x0)
            cv.line(px, y0, px, y1, GRAY, 1)
            cv.line(px, y1, px, y1 + 6, BLACK, 2)
            lab = f"{t:g}"
            cv.text(px - cv.text_w(lab) / 2, y1 + 8, lab, sc=1)
        for t in yticks:
            py = y1 - (t - ylim[0]) / (ylim[1] - ylim[0]) * (y1 - y0)
            cv.line(x0, py, x1, py, GRAY, 1)
            cv.line(x0 - 6, py, x0, py, BLACK, 2)
            lab = f"{t:g}"
            cv.text(x0 - 8 - cv.text_w(lab), py - 4, lab, sc=1)
        cv.rect(x0, y0, x1, y1, BLACK)  # border via rect outline
        for y in (y0, y1):
            cv.line(x0, y, x1, y, BLACK, 2)
        for x in (x0, x1):
            cv.line(x, y0, x, y1, BLACK, 2)
        cv.text((x0 + x1 - cv.text_w(title)) / 2, y0 - 26, title, sc=2)
        cv.text((x0 + x1 - cv.text_w(xlabel)) / 2, y1 + 26, xlabel, sc=2)
        cv.text(x0 + 6, y0 + 6, ylabel, sc=2)

    def X(box, xlim, v):
        x0, _, x1, _ = box
        return x0 + (v - xlim[0]) / (xlim[1] - xlim[0]) * (x1 - x0)

    def Y(box, ylim, v):
        _, y0, _, y1 = box
        return y1 - (v - ylim[0]) / (ylim[1] - ylim[0]) * (y1 - y0)

    def curve(box, xlim, ylim, xv, yv, c, w=3):
        pts = [(X(box, xlim, a), Y(box, ylim, b)) for a, b in zip(xv, yv)]
        for (ax_, ay_), (bx_, by_) in zip(pts[:-1], pts[1:]):
            cv.line(ax_, ay_, bx_, by_, c, w)

    def legend(box, entries, xoff=10, yoff=30):
        x0, y0 = box[0], box[1]
        for i, (kind, c, lab) in enumerate(entries):
            y = y0 + yoff + i * 18
            x = x0 + xoff
            if kind == "line":
                cv.line(x, y + 4, x + 22, y + 4, c, 3)
            elif kind == "dash":
                cv.dashed(x, y + 4, x + 22, y + 4, c, 2, 5, 3)
            elif kind == "dot":
                cv.circle(x + 11, y + 4, 4, c, fill=True)
            elif kind == "ring":
                cv.circle(x + 11, y + 4, 4, c, w=2)
            elif kind == "sq":
                cv.rect(x + 6, y - 1, x + 16, y + 9, c)
            cv.text(x + 28, y - 2, lab, sc=1)

