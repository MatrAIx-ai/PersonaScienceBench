import json, math, random, time
import numpy as np
from scipy.signal import find_peaks

SI = json.load(open("data/system_info.json"))
SPEC = json.load(open("data/scan_spec.json"))

BI = {b["idx"]: (b["forward_rate"], b["equilibrium_kd"]) for b in SI["receptor_kinetics"]["binding_interactions"]}
a1,d1 = BI[1]; a2,d2 = BI[2]; a3,d3 = BI[3]; a4,d4 = BI[4]; a5,d5 = BI[5]

CFP = SI["channel_flux_and_pump"]
FMAX  = CFP["max_channel_flux_rate_per_second"]
LEAK  = CFP["lumen_leak_rate_per_second"]
VMAX  = CFP["reuptake_vmax_micromolar_per_second"]
KM    = CFP["reuptake_km_micromolar"]
KM2   = KM*KM

CMP = SI["compartment"]
c1  = CMP["volume_ratio_lumen_to_cyt"]
C0  = CMP["total_free_ca_micromolar"]
CA0 = SI["initial_conditions_hint"]["ca_cyt_initial_micromolar"]

IP3  = SPEC["ip3_levels_micromolar"]
NCH  = SPEC["channel_counts"]
NREP = SPEC["n_replicates"]
T    = SPEC["T_obs_seconds"]
DTOUT= SPEC["dt_out_seconds"]
NSAMP= int(round(T/DTOUT))

DTCA = 0.01
NSUB = int(round(T/DTCA))
NSUBOUT = int(round(DTOUT/DTCA))

ST=[]
for s in range(8):
    i = s & 1; j = (s>>1)&1; k = (s>>2)&1
    L=[]
    if i==0:
        aa=a1 if k==0 else a3; L.append(((1)|(j<<1)|(k<<2), 0, aa))
    else:
        aa=a1 if k==0 else a3; dd=d1 if k==0 else d3; L.append(((j<<1)|(k<<2), 3, aa*dd))
    if j==0: L.append(((i)|(1<<1)|(k<<2), 1, a5))
    else:    L.append(((i)|(k<<2), 3, a5*d5))
    if k==0:
        aa=a4 if i==0 else a2; L.append(((i)|(j<<1)|(1<<2), 2, aa))
    else:
        aa=a4 if i==0 else a2; dd=d4 if i==0 else d2; L.append(((i)|(j<<1), 3, aa*dd))
    ST.append(L)

OPEN = 3

def _rate(tc, ip3, ca):
    kd = tc[1]
    if kd==0: return tc[2]*ip3
    if kd==1: return tc[2]*ca
    if kd==2: return tc[2]*ca
    return tc[2]

def _deriv(ca, cal, fopen):
    d = cal - ca
    jch = fopen*FMAX*d
    jle = LEAK*d
    jpu = VMAX*ca*ca/(KM2+ca*ca)
    return (jch + jle - jpu), (-(jch + jle)/c1 + jpu/c1)

def _rk4(ca, cal, dt, fopen):
    k1a,k1b = _deriv(ca,cal,fopen)
    k2a,k2b = _deriv(ca+0.5*dt*k1a, cal+0.5*dt*k1b, fopen)
    k3a,k3b = _deriv(ca+0.5*dt*k2a, cal+0.5*dt*k2b, fopen)
    k4a,k4b = _deriv(ca+dt*k3a, cal+dt*k3b, fopen)
    return ca+dt/6*(k1a+2*k2a+2*k3a+k4a), cal+dt/6*(k1b+2*k2b+2*k3b+k4b)

def simulate(ip3, N, seed):
    rng = random.Random(seed)
    M = 3*N
    sub = [0]*M
    lists = [list(range(M))] + [[] for _ in range(7)]
    cnt = [M]+[0]*7
    chopen = [False]*N
    nopen = 0
    ca = CA0; cal = (C0-CA0)/c1
    ca_out = np.zeros(NSAMP)
    total_open_int = 0.0
    cons_max = 0.0
    out_idx = 0
    rrandom = rng.random
    rlog = math.log
    rrandrange = rng.randrange
    for ss in range(NSUB):
        if ss % NSUBOUT == 0:
            ca_out[out_idx] = ca; out_idx += 1
        R3=[None]*8; sr=[0.0]*8
        for s in range(8):
            L=ST[s]
            r0=_rate(L[0],ip3,ca); r1=_rate(L[1],ip3,ca); r2=_rate(L[2],ip3,ca)
            R3[s]=(r0,r1,r2); sr[s]=r0+r1+r2
        remaining = DTCA; open_int = 0.0
        while remaining > 1e-15:
            R = 0.0
            for s in range(8): R += cnt[s]*sr[s]
            if R <= 0.0:
                open_int += nopen*remaining; break
            dt_ev = -rlog(rrandom())/R
            if dt_ev >= remaining:
                open_int += nopen*remaining; break
            open_int += nopen*dt_ev
            remaining -= dt_ev
            x = rrandom()*R; acc = 0.0
            for s in range(8):
                acc += cnt[s]*sr[s]
                if x <= acc: break
            r0,r1,r2 = R3[s]
            y = rrandom()*(r0+r1+r2)
            if y <= r0: ts = ST[s][0][0]
            elif y <= r0+r1: ts = ST[s][1][0]
            else: ts = ST[s][2][0]
            lst = lists[s]
            ii = rrandrange(len(lst)); idx = lst[ii]; lst[ii] = lst[-1]; lst.pop()
            cnt[s]-=1; cnt[ts]+=1; lists[ts].append(idx)
            sub[idx]=ts
            ch = idx//3; base = ch*3
            now = (sub[base]==OPEN and sub[base+1]==OPEN and sub[base+2]==OPEN)
            if now != chopen[ch]:
                chopen[ch]=now; nopen += 1 if now else -1
        fopen = open_int/(DTCA*N)   # open fraction = <nopen>/N
        total_open_int += open_int
        ca, cal = _rk4(ca, cal, DTCA, fopen)
        if ca < 0.0: ca = 0.0
        err = abs(ca + c1*cal - C0)/C0
        if err > cons_max: cons_max = err
    p_open = (total_open_int/T)/N
    return ca_out, p_open, cons_max

def _isi(trace, dt):
    pk,_ = find_peaks(trace, prominence=0.03, distance=3)
    if len(pk) < 2:
        return None
    return np.diff(pk)*dt

def _cv(isi):
    m = isi.mean()
    if m <= 0: return None
    return float(isi.std()/m)

def analyze(traces, popens, conss):
    cons_max = max(max(conss[(i,j)]) for i in range(len(IP3)) for j in range(len(NCH)))
    jmax = len(NCH)-1
    period = []
    for i in range(len(IP3)):
        vals=[]
        for r in range(NREP):
            isi=_isi(traces[(i,jmax)][r], DTOUT)
            if isi is not None: vals.append(float(np.median(isi)))
        period.append(float(np.mean(vals)) if vals else None)
    cr_idx = None
    for i in range(len(IP3)):
        if any(_isi(traces[(i,jmax)][r], DTOUT) is not None for r in range(NREP)):
            cr_idx=i; break
    cv = []
    if cr_idx is None:
        cv=[None]*len(NCH)
    else:
        for j in range(len(NCH)):
            vals=[]
            for r in range(NREP):
                isi=_isi(traces[(cr_idx,j)][r], DTOUT)
                c=_cv(isi) if isi is not None else None
                if c is not None: vals.append(c)
            cv.append(float(np.mean(vals)) if vals else None)
    popen = []
    for i in range(len(IP3)):
        vals=[op for op in popens[(i,jmax)] if op is not None]
        popen.append(float(np.mean(vals)) if vals else None)
    return {
        "ip3_levels": IP3,
        "channel_counts": NCH,
        "period_vs_ip3": period,
        "cv_isi_vs_N": cv,
        "p_open_vs_ip3": popen,
        "conservation_error_max": float(cons_max),
        "cr_ip3_idx_used": cr_idx,
    }

def write_outputs(traces, summary):
    z = {f"ip3{i}_N{j}": traces[(i,j)].astype(np.float64)
         for i in range(len(IP3)) for j in range(len(NCH))}
    np.savez("ca_traces.npz", **z)
    json.dump(summary, open("summary_stats.json","w"), indent=2)
    make_figure(traces, summary)

def main():
    t0=time.time()
    traces = {}; popens = {}; conss = {}
    for i,ip3 in enumerate(IP3):
        for j,N in enumerate(NCH):
            for r in range(NREP):
                seed = 100000 + (i*100 + j)*10 + r
                tr, po, ce = simulate(ip3, N, seed)
                key = (i,j)
                traces.setdefault(key, np.zeros((NREP,NSAMP)))
                traces[key][r] = tr
                popens.setdefault(key, [None,None]); popens[key][r]=po
                conss.setdefault(key, [None,None]); conss[key][r]=ce
            print(f"ip3[{i}]={ip3} N[{j}]={N} done  (elapsed {time.time()-t0:.0f}s)", flush=True)
    summary = analyze(traces, popens, conss)
    write_outputs(traces, summary)
    print(f"ALL DONE in {time.time()-t0:.0f}s", flush=True)
    print(json.dumps(summary, indent=2))

def _panel_data(traces, summary):
    IP3=summary["ip3_levels"]; NCH=summary["channel_counts"]
    jmax=len(NCH)-1; irep=3
    xt=np.arange(NSAMP)*DTOUT
    rep=[traces[(irep,jmax)][r] for r in range(NREP)]
    return xt, rep, IP3, NCH, summary["period_vs_ip3"], summary["cv_isi_vs_N"], summary["p_open_vs_ip3"]

def make_figure(traces, summary):
    xt, rep, IP3, NCH, period, cv, po = _panel_data(traces, summary)
    try:
        import matplotlib.pyplot as plt
        fig,ax=plt.subplots(2,2,figsize=(11,8))
        ax[0,0].plot(xt,rep[0],label="rep0",lw=0.8); ax[0,0].plot(xt,rep[1],label="rep1",lw=0.8)
        ax[0,0].set_title(f"Representative Ca trace (ip3={IP3[3]}, N={NCH[-1]})")
        ax[0,0].set_xlabel("t (s)"); ax[0,0].set_ylabel("Ca_cyt (uM)"); ax[0,0].legend()
        x=np.array(IP3); y=np.array([v if v is not None else np.nan for v in period])
        ax[0,1].plot(x,y,'o-'); ax[0,1].set_title("Period vs IP3 (N=800)")
        ax[0,1].set_xlabel("IP3 (uM)"); ax[0,1].set_ylabel("period (s)")
        xx=np.array(NCH); yy=np.array([v if v is not None else np.nan for v in cv])
        ax[1,0].plot(xx,yy,'o-'); ax[1,0].set_title(f"CV(ISI) vs N (ip3 idx={summary['cr_ip3_idx_used']})")
        ax[1,0].set_xlabel("N (channels)"); ax[1,0].set_ylabel("CV")
        zz=np.array([v if v is not None else np.nan for v in po])
        ax[1,1].plot(x,zz,'s-'); ax[1,1].set_title("p_open vs IP3 (N=800)")
        ax[1,1].set_xlabel("IP3 (uM)"); ax[1,1].set_ylabel("p_open")
        fig.tight_layout(); fig.savefig("calcium_summary.png", dpi=110); plt.close(fig)
    except Exception as e:
        print("matplotlib unavailable, using fallback raster:", e)
        _fallback_png(xt, rep, IP3, NCH, period, cv, po, summary)

def _fallback_png(xt, rep, IP3, NCH, period, cv, po, summary):
    import zlib, struct
    W,H=1200,800
    img=np.full((H,W,3),255,np.uint8)
    def text(x,y,s,scale=2,col=(0,0,0)):
        for ch in s:
            g=FONT.get(ch.upper(),FONT[' '])
            for r in range(7):
                bits=g[r]
                for c in range(5):
                    if (bits>>(4-c))&1:
                        img[y+r*scale:y+(r+1)*scale, x+c*scale:x+(c+1)*scale]=col
            x+=6*scale
    def line(x0,y0,x1,y1,col,th=1):
        x0,y0,x1,y1=int(x0),int(y0),int(x1),int(y1)
        n=max(abs(x1-x0),abs(y1-y0),1)
        for t in range(n+1):
            px=x0+(x1-x0)*t//n; py=y0+(y1-y0)*t//n
            img[max(0,py-th):py+th+1, max(0,px-th):px+th+1]=col
    def clean(xs,ys):
        xs=list(xs); ys=list(ys); out=[]
        for a,b in zip(xs,ys):
            if b is None or (isinstance(b,float) and math.isnan(b)): continue
            out.append((a,b))
        return out
    def panel(ox,oy,pw,ph,title,series,xlab,ylab):
        ml,mt,mr,mb=60,44,20,40
        x0p,y0p,x1p,y1p=ox+ml,oy+mt,ox+pw-mr,oy+ph-mb
        line(x0p,y0p,x1p,y0p,(0,0,0),1); line(x0p,y0p,x0p,y1p,(0,0,0),1)
        line(x0p,y1p,x1p,y1p,(120,120,120),1); line(x1p,y0p,x1p,y1p,(120,120,120),1)
        text(ox+10,oy+8,title,2)
        text(ox+pw//2-30,oy+ph-14,xlab,1); text(ox-58,oy+ph//2-10,ylab,1)
        for (xs,ys,col) in series:
            pts=clean(xs,ys)
            if len(pts)<2: 
                text(x0p+10,y0p+10,"NO DATA",1,col); continue
            xmin=min(p[0] for p in pts); xmax=max(p[0] for p in pts)
            ymin=min(p[1] for p in pts); ymax=max(p[1] for p in pts)
            if xmax==xmin: xmax=xmin+1
            if ymax==ymin: ymax=ymin+1
            P=[(x0p+(a-xmin)/(xmax-xmin)*(x1p-x0p), y1p-(b-ymin)/(ymax-ymin)*(y1p-y0p)) for a,b in pts]
            for k in range(len(P)-1): line(P[k][0],P[k][1],P[k+1][0],P[k+1][1],col,2)
    panel(0,0,600,400,"CA TRACE (IP3=%.4f N=%d)"%(IP3[3],NCH[-1]),
          [(xt,rep[0],(0,0,200)),(xt,rep[1],(200,0,0))],"t (s)","Ca (uM)")
    panel(600,0,600,400,"PERIOD VS IP3 (N=800)",
          [(IP3,period,(0,120,0))],"IP3 (uM)","period (s)")
    panel(0,400,600,400,"CV(ISI) VS N (IP3 IDX=%s)"%summary['cr_ip3_idx_used'],
          [(NCH,cv,(0,0,200))],"N (ch)","CV")
    panel(600,400,600,400,"P_OPEN VS IP3 (N=800)",
          [(IP3,po,(180,0,120))],"IP3 (uM)","p_open")
    raw=b''.join(b'\x00'+img[y].tobytes() for y in range(H))
    def chunk(t,d):
        c=t+d; return struct.pack(">I",len(d))+c+struct.pack(">I",zlib.crc32(c)&0xffffffff)
    png=(b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack(">IIBBBBB",W,H,8,2,0,0,0))
         +chunk(b'IDAT',zlib.compress(raw,9))+chunk(b'IEND',b''))
    open("calcium_summary.png","wb").write(png)

