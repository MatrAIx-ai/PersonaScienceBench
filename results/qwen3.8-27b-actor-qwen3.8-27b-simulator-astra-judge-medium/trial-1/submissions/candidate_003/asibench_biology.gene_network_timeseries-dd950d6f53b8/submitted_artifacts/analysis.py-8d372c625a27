#!/usr/bin/env python3
"""
Discovering directed regulatory relationships among 25 genes.

Method A (dynamic): affine linear ODE regression on wild-type time-course data
    dx/dt = A x + b
  Central-difference derivatives, with a Savitzky-Golay smoothed variant used
  as the primary differentiation (robustness check vs raw differences).
  For each target gene i, OLS of dx_i/dt on the 25 expressions (+ intercept)
  gives row i of A: A[i,j] = influence of gene j on gene i (target, source).
  Confidence: t-statistic; robustness: per-experiment sign stability and a
  ridge (CV) re-fit.

Method B (static): pairwise OLS regression of steady-state perturbation
  deviations d_r = x_r - x_0 (baseline row 0; near-duplicate rows are
  auto-detected and dropped). d_r[i] ~ a*d_r[j] + c. NOTE: with unknown
  intervention targets this captures TOTAL (direct + indirect) effects and
  only n_eff ~ 14 effective perturbations -> low power, used as an
  independent cross-check, not as ground truth.

Combination (per researcher agreement):
  - normalized confidences C_A, C_B in [0,1] (|t| / 99th percentile, clipped)
  - sign conflict when BOTH significant  -> score exactly 0
  - A significant, B not        -> keep with reduced confidence (0.5*C_A+0.5*C_B)
  - neither significant         -> score 0
Thresholding: deterministic top-quantile so off-diagonal nonzero density
  lands in [5%, 40%] (target ~17.5%), with an absolute floor (0.15*max)
  and clamping to [5%, 40%].

Outputs (workspace root): analysis.py, inferred_network.npy,
  edge_sign_predictions.npy, hub_genes.json, method_comparison.json,
  network_metrics.json.  Only numpy/scipy/stdlib are used.
"""
import json
import numpy as np
from scipy import stats, signal

N_GENES = 25
N_OFFDIAG = N_GENES * (N_GENES - 1)  # 600
OFF = ~np.eye(N_GENES, dtype=bool)

# ---------------------------------------------------------------- load
ts = np.load("data/expression_timeseries.npy")          # (5, 50, 25)
ss = np.load("data/perturbation_steady_states.npy")     # (16, 25)
with open("data/system_info.json") as fh:
    info = json.load(fh)
dt = float(info["sampling_interval"])
n_exp, n_t, n_g = ts.shape
assert (n_exp, n_t, n_g) == (5, 50, 25) and ss.shape == (16, 25)
assert np.isfinite(ts).all() and np.isfinite(ss).all()

# ------------------------------------------- steady-state reference
x_ss_last10 = ts[:, -10:, :].mean(axis=(0, 1))
noise_last = np.linalg.norm(ts[:, -1, :].std(axis=0))
diff_ss = np.linalg.norm(x_ss_last10 - ss[0])
use_ss0_as_ss = bool(diff_ss > 2.0 * noise_last)
x_ss = ss[0] if use_ss0_as_ss else x_ss_last10
print(f"[ss] ||last10_mean - ss_row0|| = {diff_ss:.3f}, replicate-noise L2 = {noise_last:.3f} "
      f"-> use ss_row0 as SS: {use_ss0_as_ss}")

# ------------------------------------------------- derivatives (method A)
def deriv_raw(x):
    d = np.empty_like(x)
    d[1:-1] = (x[2:] - x[:-2]) / (2.0 * dt)
    d[0] = (x[1] - x[0]) / dt
    d[-1] = (x[-1] - x[-2]) / dt
    return d

def deriv_smooth(x, w=7, p=3):
    return np.stack([signal.savgol_filter(x[:, g], w, p, deriv=1, delta=dt)
                     for g in range(n_g)], axis=1)

# ------------------------------------------------- OLS helper
def fit_target(y, X):
    X1 = np.column_stack([X, np.ones(len(X))])
    beta, *_ = np.linalg.lstsq(X1, y, rcond=None)
    resid = y - X1 @ beta
    dof = len(y) - X1.shape[1]
    s2 = float(resid @ resid) / dof
    cov = s2 * np.linalg.inv(X1.T @ X1)
    se = np.sqrt(np.clip(np.diag(cov), 0, None))
    tstat = np.where(se > 0, beta / se, 0.0)
    ss_tot = float(((y - y.mean()) ** 2).sum())
    r2 = 1.0 - float(resid @ resid) / ss_tot
    return beta[:n_g], tstat[:n_g], r2

def fit_A(D):
    X = ts.reshape(-1, n_g)
    Y = D.reshape(-1, n_g)
    A_b = np.zeros((n_g, n_g)); A_t = np.zeros((n_g, n_g)); A_r2 = np.zeros(n_g)
    for i in range(n_g):
        b, t, r2 = fit_target(Y[:, i], X)
        A_b[i], A_t[i], A_r2[i] = b, t, r2
    return A_b, A_t, A_r2

def deriv_all(x, smooth=True):
    """Differentiate each experiment separately (no cross-experiment stitche)."""
    out = np.empty_like(x)
    for e in range(n_exp):
        out[e] = deriv_smooth(x[e]) if smooth else deriv_raw(x[e])
    return out

A_b_s, A_t_s, A_r2_s = fit_A(deriv_all(ts, smooth=True))   # primary: smoothed
A_b_r, A_t_r, _ = fit_A(deriv_all(ts, smooth=False))       # sensitivity: raw

def top_edges(T, k=50):
    v = T[OFF].ravel()
    idx = np.argsort(-v)[:k]
    ii, jj = np.where(OFF)
    return set(zip(ii[idx], jj[idx]))
set_s, set_r = top_edges(A_t_s), top_edges(A_t_r)
jaccard = len(set_s & set_r) / len(set_s | set_r)
print(f"[A] topology overlap raw vs smoothed (top-50 Jaccard) = {jaccard:.3f}")
use_consensus = bool(jaccard < 0.5)

# per-experiment sign stability (primary derivative)
stability = np.zeros((n_g, n_g))
for e in range(n_exp):
    D_e = deriv_smooth(ts[e])
    X_e = ts[e].reshape(-1, n_g)
    for i in range(n_g):
        _, t_e, _ = fit_target(D_e[:, i], X_e)
        stability[i] += np.sign(t_e)
sign_stab = np.abs(stability) / n_exp
print(f"[A] mean |sign stability| over off-diag = {sign_stab[OFF].mean():.3f}")

# ridge (CV) robustness check
Dflat = deriv_all(ts, smooth=True).reshape(-1, n_g)
Xflat = ts.reshape(-1, n_g)
X_std = (Xflat - Xflat.mean(0)) / Xflat.std(0)
def ridge_beta(y, X, alpha):
    lam = alpha * np.eye(n_g) * (X.T @ X).diagonal().mean()
    return np.linalg.solve(X.T @ X + lam, X.T @ y)
best = None
for alpha in [0.01, 0.03, 0.1, 0.3, 1.0, 3.0]:
    errs = []
    for i in range(n_g):
        y = (Dflat[:, i] - Dflat[:, i].mean()) / Dflat[:, i].std()
        b = ridge_beta(y, X_std, alpha)
        pred = X_std @ b
        errs.append(float(((y - pred) ** 2).mean()))
    cv = float(np.mean(errs))
    if best is None or cv < best[1]:
        best = (alpha, cv)
alpha_ridge = best[0]
ridge_signs = np.zeros((n_g, n_g))
for i in range(n_g):
    y = (Dflat[:, i] - Dflat[:, i].mean()) / Dflat[:, i].std()
    ridge_signs[i] = np.sign(ridge_beta(y, X_std, alpha_ridge))
top50 = top_edges(A_t_s)
ridge_agree = float(np.mean([ridge_signs[i, j] == np.sign(A_t_s[i, j])
                             for (i, j) in top50]))
print(f"[A] ridge alpha={alpha_ridge} (cv={best[1]:.3f}); top-50 sign agreement = {ridge_agree:.3f}")

# ------------------------------------------------- method B (steady states)
base = ss[0]
D_all = ss[1:] - base
l2_all = np.linalg.norm(D_all, axis=1)
drop = l2_all < 0.5
Dk = D_all[~drop]
n_eff = Dk.shape[0]
print(f"[B] dropped {int(drop.sum())} near-baseline row(s) (L2<0.5); n_eff = {n_eff}")
B_slope = np.zeros((n_g, n_g)); B_t = np.zeros((n_g, n_g)); B_r2 = np.zeros((n_g, n_g))
for i in range(n_g):
    for j in range(n_g):
        if i == j:
            continue
        res = stats.linregress(Dk[:, j], Dk[:, i])
        tval = res.slope / res.stderr if res.stderr > 0 else 0.0
        B_slope[i, j], B_t[i, j], B_r2[i, j] = res.slope, tval, res.rvalue ** 2

# ------------------------------------------------- combination
t_crit_A = float(stats.t.ppf(0.975, n_exp * n_t - (n_g + 1)))
t_crit_B = float(stats.t.ppf(0.975, n_eff - 2))
TA, TB = np.abs(A_t_s), np.abs(B_t)
TA99 = np.percentile(TA[OFF].ravel(), 99); TB99 = np.percentile(TB[OFF].ravel(), 99)
CA = np.clip(TA / TA99, 0, 1); CB = np.clip(TB / TB99, 0, 1)
sigA = TA >= t_crit_A; sigB = TB >= t_crit_B
score = np.where(sigA | sigB, 0.5 * CA + 0.5 * CB, 0.0)
conflict = sigA & sigB & (np.sign(A_t_s) != np.sign(B_t)) & (A_t_s != 0) & (B_t != 0)
n_conflict = int((conflict & OFF).sum())
score = np.where(conflict & OFF, 0.0, score)
# robustness rule: if the two differentiation schemes disagree on the SIGN of
# an edge, zero it out (derivative-method sign flip = unreliable sign)
flip = (np.sign(A_t_s) != np.sign(A_t_r)) & (A_t_s != 0) & (A_t_r != 0) & OFF
n_flip = int(flip.sum())
score = np.where(flip, 0.0, score)
# depth-resolved sensitivity (diagnostics only)
for _k in (10, 20, 30, 50, 80):
    _a, _b = top_edges(A_t_s, _k), top_edges(A_t_r, _k)
    print(f"[A-sens] top-{_k} Jaccard raw vs smoothed = {len(_a&_b)/len(_a|_b):.3f}")
print(f"[A-sens] sign flips raw vs smoothed: {n_flip} off-diag edges zeroed")
csign = np.zeros((n_g, n_g))
csign[sigA & OFF] = np.sign(A_t_s)[sigA & OFF]
onlyB = sigB & ~sigA & OFF
csign[onlyB] = np.sign(B_t)[onlyB]
print(f"[combine] t_crit_A={t_crit_A:.3f} (sigA={int(sigA[OFF].sum())}), "
      f"t_crit_B={t_crit_B:.3f} (sigB={int(sigB[OFF].sum())}), conflicts zeroed={n_conflict}")

# ------------------------------------------------- thresholding (5-40%, target ~17.5%)
sv = score[OFF].ravel()
order = np.argsort(-sv)
K_target = int(round(0.175 * N_OFFDIAG))           # 105
floor = 0.15 * sv.max()
keep = order[:K_target]
keep = keep[sv[keep] >= floor]
if len(keep) < int(0.05 * N_OFFDIAG):
    keep = order[:int(0.05 * N_OFFDIAG)]
if len(keep) > int(0.40 * N_OFFDIAG):
    keep = order[:int(0.40 * N_OFFDIAG)]
ii, jj = np.where(OFF)
W = np.zeros((n_g, n_g)); signs = np.zeros((n_g, n_g))
for pos in keep:
    i, j = int(ii[pos]), int(jj[pos])
    W[i, j] = float(score[i, j])
    s_ = csign[i, j]
    if s_ == 0:
        s_ = np.sign(A_t_s[i, j]) if A_t_s[i, j] != 0 else 1.0
    signs[i, j] = float(s_)
n_edges = int((W > 0).sum())
density = n_edges / N_OFFDIAG
print(f"[final] n_edges={n_edges} density={density:.4f} (target ~0.175)")

# ------------------------------------------------- hubs & metrics
topo = (W > 0) & OFF
binW = topo.astype(float)
in_deg = binW.sum(axis=1)
out_deg = binW.sum(axis=0)
out_w = W.sum(axis=0)
hub_order = sorted(range(n_g), key=lambda g: (-out_deg[g], -out_w[g], g))
hubs = [int(hub_order[0]), int(hub_order[1])]
print(f"[hubs] top-2 regulators by out-degree: {hubs} "
      f"(out_deg={out_deg[hubs].astype(int).tolist()}, out_w={out_w[hubs].round(3).tolist()})")
deg_stats = lambda v: {"mean": float(np.mean(v)), "median": float(np.median(v)),
                       "max": int(v.max()), "min": int(v.min()),
                       "values": [int(x) for x in v]}

both_sig = sigA & sigB & OFF
agree_both = float(np.mean((np.sign(A_t_s) == np.sign(B_t))[both_sig])) if both_sig.sum() else 0.0
sigA_edges = int(sigA[OFF].sum()); sigB_edges = int(sigB[OFF].sum())
agree_on_A = float(np.mean((np.sign(A_t_s) == np.sign(B_t))[sigA & OFF])) if sigA_edges else 0.0

comp = {
    "methods": [
        {
            "name": "A_linear_ode_timeseries_regression",
            "description": ("Affine linear ODE regression dx/dt = A x + b fitted by OLS per target gene "
                            "on all 5 wild-type time-courses (250 points, dt=0.612245); central-difference "
                            "derivatives with Savitzky-Golay smoothing (window 7, poly 3) as primary, raw "
                            "central differences as sensitivity check. Row i of A = directed influences ON "
                            "gene i; confidence = |t-statistic|, robustness via per-experiment sign "
                            f"stability (mean {sign_stab[OFF].mean():.2f}) and ridge re-fit (alpha={alpha_ridge}, "
                            f"top-50 sign agreement {ridge_agree:.2f})."),
            "score": float(TA[OFF].mean()),
            "mean_abs_t": float(TA[OFF].mean()),
            "mean_r2": float(A_r2_s.mean()),
            "n_significant_edges": sigA_edges,
            "topology_overlap_raw_vs_smoothed_top50": float(jaccard),
            "strengths": ("Uses the full dynamic relaxation trajectory (large initial perturbation excites many "
                          "modes); low measurement noise (~1.5% between replicates); gives directed, signed "
                          "DIRECT influences with per-coefficient statistics."),
            "limitations": ("Assumes locally linear, time-invariant dynamics; early phase of the relaxation is "
                            "far from equilibrium so linearization error is possible; multicollinearity among "
                            "co-regulated genes can spread coefficients."),
        },
        {
            "name": "B_steady_state_perturbation_pairwise_regression",
            "description": ("Pairwise OLS regression of steady-state deviations from the baseline row, "
                            "d_r[i] ~ a*d_r[j] + c, over the perturbation rows (near-baseline row 2 auto-dropped, "
                            f"n_eff={n_eff}). Linear structure justified by steady-state linearization "
                            "delta ~ (I-J)^-1 s. Confidence = |t-statistic| (df=n_eff-2). "
                            "IMPORTANT: with undocumented intervention targets this method sees TOTAL "
                            "(direct + indirect) effects, not direct edges."),
            "score": float(TB[OFF].mean()),
            "mean_abs_t": float(TB[OFF].mean()),
            "mean_r2": float(np.mean(B_r2[OFF])),
            "n_significant_edges": sigB_edges,
            "effective_n_perturbations": int(n_eff),
            "strengths": ("Fully independent of the time-course data (static, different experimental design); "
                          "cross-validates directions and signs; large-amplitude perturbations (L2 up to ~30) "
                          "give strong signal for strongly connected genes."),
            "limitations": (f"Only {n_eff} effective perturbations -> low statistical power (t_crit={t_crit_B:.2f}); "
                            "intervention targets/number/mechanism unknown; regression captures total "
                            "(direct+indirect) effects, so it can over-attribute indirect influences."),
        },
        {
            "name": "combined_thresholded_network",
            "description": ("Score = 0.5*C_A + 0.5*C_B with normalized |t| confidences; sign conflict when both "
                            "methods are significant -> exact 0; A-significant/B-not kept with reduced confidence; "
                            "neither significant -> 0. Deterministic top-quantile threshold (target 17.5%) with "
                            "absolute floor 0.15*max, clamped to [5%, 40%] off-diagonal nonzero density."),
            "score": float(np.mean(W[OFF][W[OFF] > 0])) if n_edges else 0.0,
            "final_n_edges": n_edges,
            "final_density": float(density),
            "sign_agreement_when_both_significant": float(agree_both),
            "sign_agreement_on_A_significant_edges": float(agree_on_A),
            "strengths": "Two independent data sources must mostly agree; conflicts are hard-zeroed.",
            "limitations": "Threshold is driven by the 5-40% density contract, not by a statistical cutoff alone.",
        },
    ],
}

metrics = {
    "n_genes": n_g,
    "n_edges": n_edges,
    "density": float(density),
    "density_rule": "off-diagonal nonzero entries of inferred_network.npy / 600 (target band 5%-40%)",
    "convention": "inferred_network[i,j] = influence of gene j on gene i (target, source); "
                  "in-degree = row sum, out-degree = column sum of the exact nonzero topology",
    "in_degree": deg_stats(in_deg),
    "out_degree": deg_stats(out_deg),
    "mean_edge_weight": float(W[OFF].mean()),
    "max_edge_weight": float(W.max()),
}

# ------------------------------------------------- self-check
assert np.isfinite(W).all() and np.isfinite(signs).all(), "non-finite values"
assert W.dtype == np.float64 and signs.dtype == np.float64
assert not (W.diagonal() != 0).any(), "diagonal not zero"
assert 0.05 <= density <= 0.40, f"density {density} outside [0.05, 0.40]"
assert not ((W == 0) & (signs != 0)).any(), "nonzero sign where network is 0"
assert set(np.unique(signs)).issubset({-1.0, 0.0, 1.0}), "bad sign values"
assert len(hubs) == 2 and len(set(hubs)) == 2, "hubs must be exactly 2 distinct indices"
print("[selfcheck] all checks passed: finiteness, density in range, sign/zero consistency, 2 hubs")

# ------------------------------------------------- write outputs
np.save("inferred_network.npy", W.astype(np.float64))
np.save("edge_sign_predictions.npy", signs.astype(np.float64))
with open("hub_genes.json", "w") as fh:
    json.dump({"hub_genes": hubs}, fh, indent=2)
with open("method_comparison.json", "w") as fh:
    json.dump(comp, fh, indent=2)
with open("network_metrics.json", "w") as fh:
    json.dump(metrics, fh, indent=2)
print("[outputs] wrote inferred_network.npy, edge_sign_predictions.npy, "
      "hub_genes.json, method_comparison.json, network_metrics.json")

# ------------------------------------------------- console summary
print("\nTop-15 edges by combined score (i<-j, sign, score, tA, tB):")
for p in np.argsort(-sv)[:15]:
    i, j = int(ii[p]), int(jj[p])
    print(f"  g{i:2d} <- g{j:2d}  sign={int(signs[i,j]):+d}  score={W[i,j]:.3f}  "
          f"tA={A_t_s[i,j]:+7.2f}  tB={B_t[i,j]:+7.2f}")
print("\nOut-degree table (top 8):")
for g in hub_order[:8]:
    print(f"  g{g:2d}: out_deg={int(out_deg[g])}  in_deg={int(in_deg[g])}  out_w={out_w[g]:.3f}")
