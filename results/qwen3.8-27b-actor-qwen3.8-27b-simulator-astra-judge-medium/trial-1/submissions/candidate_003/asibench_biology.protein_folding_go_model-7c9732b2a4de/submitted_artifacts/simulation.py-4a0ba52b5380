def _put_disc(img, cx, cy, r, col):
    H, W = img.shape[:2]
    x0, x1 = max(int(cx - r), 0), min(int(cx + r) + 1, W)
    y0, y1 = max(int(cy - r), 0), min(int(cy + r) + 1, H)
    if x0 >= x1 or y0 >= y1:
        return
    yy, xx = np.ogrid[y0:y1, x0:x1]
    m = (xx - cx) ** 2 + (yy - cy) ** 2 <= r * r
    img[y0:y1, x0:x1][m] = col


def _line(img, xa, ya, xb, yb, col, w=1):
    n = int(max(abs(xb - xa), abs(yb - ya))) + 1
    r = (w - 1) // 2 + 1
    for t in np.linspace(0.0, 1.0, n):
        _put_disc(img, xa + (xb - xa) * t, ya + (yb - ya) * t, r, col)


def _dline(img, xa, ya, xb, yb, col, w=1, dash=8):
    n = int(max(abs(xb - xa), abs(yb - ya))) + 1
    r = (w - 1) // 2 + 1
    for i, t in enumerate(np.linspace(0.0, 1.0, n)):
        if (i % (2 * dash)) < dash:
            _put_disc(img, xa + (xb - xa) * t, ya + (yb - ya) * t, r, col)


def _text_w(s, sc):
    return 6 * sc * len(s) - sc


def _text(img, x, y, s, col, sc=2):
    H, W = img.shape[:2]
    x0 = int(x)
    for ch in s:
        g = _FONT.get(ch, _FONT["?"])
        for r in range(7):
            row = g[r]
            for c in range(5):
                if (row >> (4 - c)) & 1:
                    yy, xx = int(y) + r * sc, int(x0) + c * sc
                    if 0 <= yy < H - sc and 0 <= xx < W - sc:
                        img[yy:yy + sc, xx:xx + sc] = col
        x0 += 6 * sc


def _fill_blend(img, x0, y0, x1, y1, col, a=0.5):
    H, W = img.shape[:2]
    x0, y0 = max(int(x0), 0), max(int(y0), 0)
    x1, y1 = min(int(x1), W), min(int(y1), H)
    if x1 <= x0 or y1 <= y0:
        return
    reg = img[y0:y1, x0:x1].astype(np.float64)
    img[y0:y1, x0:x1] = (reg * (1 - a) + np.array(col) * a).astype(np.uint8)


def _axes(img, px, py, pw, ph, xmin, xmax, ymin, ymax, xticks, yticks,
          xlabel, ylabel, title, sc=2):
    _line(img, px, py, px + pw, py, (0, 0, 0), 2)
    _line(img, px, py + ph, px + pw, py + ph, (0, 0, 0), 2)
    _line(img, px, py, px, py + ph, (0, 0, 0), 2)
    _line(img, px + pw, py, px + pw, py + ph, (0, 0, 0), 2)

    def X(v):
        return px + (v - xmin) / (xmax - xmin) * pw

    def Y(v):
        return py + ph - (v - ymin) / (ymax - ymin) * ph

    for vt in xticks:
        t = f"{vt:g}"
        _line(img, X(vt), py + ph, X(vt), py + ph + 6, (0, 0, 0), 1)
        _text(img, X(vt) - _text_w(t, sc) // 2, py + ph + 9, t, (0, 0, 0), sc)
    for vt in yticks:
        t = f"{vt:g}"
        _line(img, px - 6, Y(vt), px, Y(vt), (0, 0, 0), 1)
        _text(img, px - 9 - _text_w(t, sc), Y(vt) - 4 * sc, t, (0, 0, 0), sc)
    _text(img, px + pw // 2 - _text_w(xlabel, sc) // 2, py + ph + 34,
          xlabel, (0, 0, 0), sc)
    _text(img, px - 9 - _text_w(ylabel, sc), py - 22, ylabel, (0, 0, 0), sc)
    _text(img, px + pw // 2 - _text_w(title, sc) // 2, py - 44, title,
          (0, 0, 0), sc)
    return X, Y


def _png_write(path, img):
    import zlib
    import struct
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 6))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as fh:
        fh.write(png)


def _viz_png(path, x_cold, ni, nj, N, T_list, q_hist, centers, T_fine,
             C_fine, T_star, Fq, Pq, modes):
    W, H = 1240, 1040
    img = np.full((H, W, 3), 255, np.uint8)
    cols = [(31, 119, 180), (255, 127, 14), (44, 160, 44),
            (214, 39, 40), (148, 103, 189), (140, 86, 75)]
    # (a) final configuration
    X, Y = _axes(img, 60, 100, 520, 380, 0, 1, 0, 1, [], [],
                 "X+0.35*Z", "Y", "FINAL CONFIG AT LOWEST T (RED: NATIVE)")
    p = np.column_stack([x_cold[:, 0] + 0.35 * x_cold[:, 2], x_cold[:, 1]])
    lo, hi = p.min(axis=0) - 1.5, p.max(axis=0) + 1.5
    SX = lambda v: 60 + (v - lo[0]) / (hi[0] - lo[0]) * 520
    SY = lambda v: 100 + 380 - (v - lo[1]) / (hi[1] - lo[1]) * 380
    for i, j in zip(ni, nj):
        _line(img, SX(p[i, 0]), SY(p[i, 1]), SX(p[j, 0]), SY(p[j, 1]),
              (220, 60, 60), 1)
    for i in range(N - 1):
        _line(img, SX(p[i, 0]), SY(p[i, 1]), SX(p[i + 1, 0]),
              SY(p[i + 1, 1]), (0, 0, 0), 2)
    for i in range(N):
        _put_disc(img, SX(p[i, 0]), SY(p[i, 1]), 6, (31, 119, 180))
        _text(img, SX(p[i, 0]) + 8, SY(p[i, 1]) - 6, str(i), (0, 0, 0), 1)
    # (b) Q histograms
    dens = q_hist / 0.02
    ym = max(dens.max(), 1e-9) * 1.08
    X, Y = _axes(img, 660, 100, 520, 380, 0, 1, 0, ym,
                 [0, 0.25, 0.5, 0.75, 1.0],
                 [0, ym / 4, ym / 2, 3 * ym / 4, ym],
                 "Q", "Q DENSITY", "Q HISTOGRAMS (PER TEMPERATURE)")
    for k, T in enumerate(T_list):
        xs = [X(c) for c in centers]
        ys = [Y(d) for d in dens[k]]
        for a, b, ya, yb in zip(xs[:-1], xs[1:], ys[:-1], ys[1:]):
            _line(img, a, ya, b, yb, cols[k % 6], 2)
        lx = 675 + (k % 2) * 190
        ly = 112 + (k // 2) * 24
        _line(img, lx, ly + 6, lx + 30, ly + 6, cols[k % 6], 2)
        _text(img, lx + 36, ly, f"T={T:.2f}", (0, 0, 0), 2)
    # (c) heat capacity
    cm = max(C_fine.max(), 1e-9) * 1.08
    X, Y = _axes(img, 60, 600, 520, 380, T_fine[0], T_fine[-1], 0, cm,
                 [0.5, 0.6, 0.7, 0.8, 0.9, 1.0, 1.1, 1.2],
                 [0, cm / 4, cm / 2, 3 * cm / 4, cm],
                 "T", "C (FLUCTUATION)", "HEAT CAPACITY CURVE")
    xs = [X(t) for t in T_fine]
    ys = [Y(c) for c in C_fine]
    for a, b, ya, yb in zip(xs[:-1], xs[1:], ys[:-1], ys[1:]):
        _line(img, a, ya, b, yb, (0, 0, 0), 2)
    for a, b in zip(xs, ys):
        _put_disc(img, a, b, 2, (0, 0, 0))
    if T_fine[0] <= T_star <= T_fine[-1]:
        _dline(img, X(T_star), 100 + 380, X(T_star), 100, (214, 39, 40), 2)
        _text(img, X(T_star) + 6, 106, f"T*={T_star:.3f}", (214, 39, 40), 2)
    # (d) F(Q) and P(Q) at T*
    fm = max(Fq.max(), 1e-9) * 1.08
    pm = max(Pq.max(), 1e-9) * 1.08
    X, Y = _axes(img, 660, 600, 520, 380, 0, 1, 0, fm,
                 [0, 0.25, 0.5, 0.75, 1.0],
                 [0, fm / 4, fm / 2, 3 * fm / 4, fm],
                 "Q", "F(KT*)", f"DISTRIBUTION & LANDSCAPE AT T*={T_star:.3f}")
    for i, c in enumerate(centers):
        if Pq[i] > 0:
            _fill_blend(img, X(c) - 4, 600 + 380 - Pq[i] / pm * 380,
                        X(c) + 4, Y(0), (255, 165, 0), 0.5)
    xs = [X(c) for c in centers]
    ys = [Y(f) for f in Fq]
    for a, b, ya, yb in zip(xs[:-1], xs[1:], ys[:-1], ys[1:]):
        _line(img, a, ya, b, yb, (44, 160, 44), 2)
    for m in modes:
        _dline(img, X(m), 980, X(m), 600, (0, 0, 0), 1)
        _text(img, X(m) - 20, 606, f"Q={m:.2f}", (0, 0, 0), 1)
    _text(img, 1130, 610, "P(Q) (BARS)", (200, 120, 0), 2)
    _png_write(path, img)



def main():
    t0 = time.time()
    with open("data/parameters.json") as fh:
        P = json.load(fh)
    ref = np.load("data/target_coords.npy")
    N = int(P["n_beads"])
    gamma = float(P["friction"])
    dt = float(P["dt_reduced"])
    T_list = [float(t) for t in P["temperature_list"]]
    n_steps = int(P["n_steps_per_T"])
    cutoff = float(P["contact_cutoff"])
    mss = int(P["min_seq_separation"])
    save_int = int(P["save_interval"])
    K = len(T_list)

    # ---------------- pair lists (from reference geometry) ----------------
    iu, ju = np.triu_indices(N, 1)
    dref = np.linalg.norm(ref[iu] - ref[ju], axis=1)
    sep = ju - iu
    bond_m = sep == 1
    nat_m = (dref <= cutoff) & (sep >= mss)
    nn_m = (sep >= 2) & ~nat_m

    bi, bj = iu[bond_m], ju[bond_m]
    r0b = dref[bond_m]
    ni, nj = iu[nat_m], ju[nat_m]
    r0n = dref[nat_m]
    xi_, xj_ = iu[nn_m], ju[nn_m]
    M = len(r0n)
    q_thr = 1.5 * r0n          # THE single contact criterion for Q, everywhere

    # ---------------- model constants (assumptions, see plan) -------------
    kb = 5.0                   # bond stiffness
    eps = 1.0 / 0.13395        # native well depth = 1.0
    enn = 0.5
    snn = 3.0
    c_ou = np.exp(-gamma * dt)

    def fe(x):
        """Total force and potential energy."""
        F = np.zeros((N, 3))
        E = 0.0
        rv = x[bi] - x[bj]
        r = np.linalg.norm(rv, axis=1)
        f = -2.0 * kb * (r - r0b)
        E += kb * np.sum((r - r0b) ** 2)
        np.add.at(F, bi, f[:, None] * rv / r[:, None])
        np.add.at(F, bj, -f[:, None] * rv / r[:, None])
        rv = x[ni] - x[nj]
        r = np.linalg.norm(rv, axis=1)
        t = r0n / r
        f = 2.0 * eps * t ** 10 * (12.0 * t * t - 10.0) / r
        E += 2.0 * eps * np.sum(t ** 12 - t ** 10)
        np.add.at(F, ni, f[:, None] * rv / r[:, None])
        np.add.at(F, nj, -f[:, None] * rv / r[:, None])
        rv = x[xi_] - x[xj_]
        r = np.linalg.norm(rv, axis=1)
        f = 24.0 * enn * snn ** 12 / r ** 13
        E += 2.0 * enn * np.sum((snn / r) ** 12)
        np.add.at(F, xi_, f[:, None] * rv / r[:, None])
        np.add.at(F, xj_, -f[:, None] * rv / r[:, None])
        return F, E

    def q_of(x):
        r = np.linalg.norm(x[ni] - x[nj], axis=1)
        formed = r <= q_thr
        return formed.mean(), formed

    def run(T, n, seed, save_every=None):
        """BAOAB Langevin run starting from the reference configuration."""
        rng = np.random.default_rng(seed)
        x = ref.copy()
        v = np.zeros((N, 3))
        F, E = fe(x)
        s_ou = np.sqrt(T * (1.0 - np.exp(-2.0 * gamma * dt)))
        E_all = np.empty(n)
        Q_all = np.empty(n)
        C_all = np.zeros((n, M), dtype=bool)
        ck = []
        for t in range(n):
            q, formed = q_of(x)
            E_all[t] = E
            Q_all[t] = q
            C_all[t] = formed
            if save_every is not None and t % save_every == 0:
                ck.append((q, E))
            x += 0.5 * dt * v
            v = c_ou * v + s_ou * rng.standard_normal((N, 3))
            v += dt * F
            v = c_ou * v + s_ou * rng.standard_normal((N, 3))
            x += 0.5 * dt * v
            F, E = fe(x)
            if t % 1000 == 999:
                assert np.isfinite(E) and np.isfinite(x).all(), \
                    f"blow-up at T={T} step={t}"
        assert np.isfinite(E_all).all() and np.isfinite(x).all()
        return x, E_all, Q_all, C_all, np.array(ck)

    warnings = []

    # ---------------- production runs at each listed T ----------------
    obs_Q, obs_varQ, obs_E, obs_varE, obs_C, obs_corr = [], [], [], [], [], []
    q_hist = np.zeros((K, 50))
    n_ckpt = n_steps // save_int + (1 if n_steps % save_int else 0)
    q_traj = np.zeros((K, n_ckpt))
    joint = np.zeros((K, 20, 20))
    ncp = np.zeros((K, M))
    final_x = {}
    for k, T in enumerate(T_list):
        x, E_all, Q_all, C_all, ck = run(T, n_steps, seed=20261021 + 100 * k,
                                         save_every=save_int)
        final_x[k] = x
        q_traj[k] = np.vstack(ck)[:, 0]
        e_ck = np.vstack(ck)[:, 1]
        h, _ = np.histogram(q_traj[k], bins=np.linspace(0, 1, 51))
        q_hist[k] = h / h.sum()
        z = (e_ck - e_ck.mean()) / (e_ck.std() if e_ck.std() > 1e-12 else 1.0)
        z = np.clip(z, -3.0, 3.0)
        h2, _, _ = np.histogram2d(q_traj[k], z,
                                  bins=[np.linspace(0, 1, 21), np.linspace(-3, 3, 21)])
        joint[k] = h2 / h2.sum()
        ncp[k] = C_all.mean(axis=0)
        mQ, vQ = Q_all.mean(), Q_all.var()
        mE, vE = E_all.mean(), E_all.var()
        if Q_all.std() > 1e-12 and E_all.std() > 1e-12:
            corr = float(np.corrcoef(Q_all, E_all)[0, 1])
        else:
            corr = 0.0
        obs_Q.append(mQ); obs_varQ.append(vQ)
        obs_E.append(mE); obs_varE.append(vE)
        obs_C.append(vE / T ** 2)
        obs_corr.append(corr)
        # half-trajectory convergence check (numbers reported)
        h1 = n_steps // 2
        q1, q2 = Q_all[:h1].mean(), Q_all[h1:].mean()
        e1, e2 = E_all[:h1].mean(), E_all[h1:].mean()
        semq = np.sqrt(Q_all[:h1].var() / h1 + Q_all[h1:].var() / (n_steps - h1))
        seme = np.sqrt(E_all[:h1].var() / h1 + E_all[h1:].var() / (n_steps - h1))
        dq, de = q2 - q1, e2 - e1
        ok = (abs(dq) <= max(3 * semq, 0.05)) and (abs(de) <= max(3 * seme, 0.5 * T))
        warnings.append(
            f"convergence T={T:.4f}: <Q> 1st-half={q1:.4f} 2nd-half={q2:.4f} "
            f"delta={dq:+.4f} SEM={semq:.4f} [{'PASS' if ok else 'FAIL'}]; "
            f"<E> 1st-half={e1:.4f} 2nd-half={e2:.4f} delta={de:+.4f} SEM={seme:.4f}"
            f" [{'PASS' if ok else 'FAIL'}]")
        print(f"T={T:.4f}: <Q>={mQ:.4f} <E>={mE:.4f} C={vE / T ** 2:.4f} "
              f"corr={corr:+.3f} conv={'PASS' if ok else 'FAIL'}  "
              f"({time.time() - t0:.0f}s)", flush=True)

    # ---------------- heat-capacity fine grid (fluctuation-based) --------
    n_fine = 41
    T_fine = np.linspace(0.45, 1.28, n_fine)
    C_fine = np.empty(n_fine)
    for i, T in enumerate(T_fine):
        _, E_all, _, _, _ = run(T, 2000 + 20000, seed=777000 + i)
        E_all = E_all[2000:]  # discard equilibration
        C_fine[i] = E_all.var() / T ** 2
        if i % 10 == 9:
            print(f"  fine grid {i + 1}/{n_fine} done ({time.time() - t0:.0f}s)",
                  flush=True)
    heat_cap = np.vstack([T_fine, C_fine])

    # ---------------- T* from <Q>(T)=0.5 midpoint ------------------------
    qm = np.array(obs_Q)
    Ts = np.array(T_list)
    if (qm.min() <= 0.5 <= qm.max()):
        idx = np.where((qm[:-1] >= 0.5) & (qm[1:] <= 0.5))[0]
        if len(idx):
            i = idx[0]
            T_star = float(Ts[i] + (0.5 - qm[i]) * (Ts[i + 1] - Ts[i]) /
                           (qm[i + 1] - qm[i]))
        else:
            i = int(np.argmin(np.abs(qm - 0.5)))
            T_star = float(Ts[i])
            warnings.append(f"T*: non-monotone <Q>(T); used nearest point T={Ts[i]:.4f}")
    else:
        i = int(np.argmin(np.abs(qm - 0.5)))
        T_star = float(Ts[i])
        warnings.append(
            f"T*: <Q> does not cross 0.5 on ladder (range {qm.min():.3f}.."
            f"{qm.max():.3f}); clamped to nearest endpoint T={T_star:.4f}")
    print(f"T* = {T_star:.4f}", flush=True)

    # ---------------- dedicated run at T* -> free-energy profile ---------
    n_star = 5 * n_steps
    x_star, E_star, Q_star, C_star, ck_star = run(T_star, n_star, seed=555000,
                                                  save_every=save_int)
    h1 = n_star // 2
    q1, q2 = Q_star[:h1].mean(), Q_star[h1:].mean()
    e1, e2 = E_star[:h1].mean(), E_star[h1:].mean()
    warnings.append(
        f"convergence T*={T_star:.4f} (5x run): <Q> 1st-half={q1:.4f} "
        f"2nd-half={q2:.4f} delta={q2 - q1:+.4f}; <E> 1st-half={e1:.4f} "
        f"2nd-half={e2:.4f} delta={e2 - e1:+.4f}")
    edges = np.linspace(0, 1, 51)
    centers = 0.5 * (edges[:-1] + edges[1:])
    h, _ = np.histogram(Q_star, bins=edges)
    Pq = h / h.sum()
    Fq = np.empty(50)
    nz = Pq > 0
    Fq[nz] = -T_star * np.log(Pq[nz])
    cap_val = Fq[nz].max() + 2.0
    Fq[~nz] = cap_val
    if not nz.all():
        warnings.append("free-energy profile: empty Q bins capped at max(F)+2 kT")
    Fq -= Fq.min()
    fe_profile = np.vstack([centers, Fq])

    # modes from the 50-bin P(Q) (same bins as the Q histogram)
    def find_peaks(p):
        n = len(p)
        out = []
        for k in range(n):
            if p[k] > (p[k - 1] if k > 0 else -1) and \
               p[k] > (p[k + 1] if k < n - 1 else -1):
                lb = p[k]
                for l in range(k - 1, -1, -1):
                    lb = min(lb, p[l])
                    if p[l] > p[k]:
                        break
                rb = p[k]
                for r in range(k + 1, n):
                    rb = min(rb, p[r])
                    if p[r] > p[k]:
                        break
                out.append((k, p[k] - max(lb, rb)))
        return out

    peaks = [(k, pr) for k, pr in find_peaks(Pq) if pr >= 0.05 * Pq.max()]
    peaks.sort(key=lambda tt: -tt[1])
    if len(peaks) >= 2:
        k1, k2 = sorted([peaks[0][0], peaks[1][0]])
        modes = [float(centers[k1]), float(centers[k2])]
        mode_sep = abs(modes[1] - modes[0])
        barrier = float(Fq[k1:k2 + 1].max())
    elif len(peaks) == 1:
        modes = [float(centers[peaks[0][0]])]
        mode_sep = 0.0
        barrier = 0.0
        warnings.append("T* Q distribution: single mode; "
                        "mode_separation and barrier set to 0")
    else:
        modes = [float(centers[int(np.argmax(Pq))])]
        mode_sep = 0.0
        barrier = 0.0
        warnings.append("T* Q distribution: no distinct peak; mode = argmax bin")

    # ---------------- Jaccard: final cold config vs reference -------------
    k_cold = int(np.argmin(T_list))
    x_cold = final_x[k_cold]

    def adj_set(x):
        d = np.linalg.norm(x[iu] - x[ju], axis=1)
        m = (d <= cutoff) & (sep >= mss)
        return set(zip(iu[m].tolist(), ju[m].tolist()))

    A_ref, A_fin = adj_set(ref), adj_set(x_cold)
    jac = len(A_ref & A_fin) / len(A_ref | A_fin) if (A_ref | A_fin) else 1.0
    print(f"Jaccard = {jac:.4f}  (ref {len(A_ref)}, final {len(A_fin)}, "
          f"inter {len(A_ref & A_fin)})", flush=True)

    # ---------------- write outputs ---------------------------------------
    np.save("final_coords.npy", x_cold.astype(np.float64))
    np.save("order_parameter_trajectory.npy", q_traj.astype(np.float64))
    np.save("order_parameter_histograms.npy", q_hist.astype(np.float64))
    np.save("heat_capacity_curve.npy", heat_cap.astype(np.float64))
    temperature_observables = {
        "temperatures": T_list,
        "mean_order_parameter_by_T": [float(v) for v in obs_Q],
        "var_order_parameter_by_T": [float(v) for v in obs_varQ],
        "mean_energy_by_T": [float(v) for v in obs_E],
        "var_energy_by_T": [float(v) for v in obs_varE],
        "heat_capacity_direct_by_T": [float(v) for v in obs_C],
        "q_energy_correlation_by_T": [float(v) for v in obs_corr],
    }
    with open("temperature_observables.json", "w") as fh:
        json.dump(temperature_observables, fh, indent=2)
    np.save("transition_free_energy_profile.npy", fe_profile.astype(np.float64))
    np.save("q_energy_joint_histograms.npy", joint.astype(np.float64))
    np.save("native_contact_probability.npy", ncp.astype(np.float64))
    transition_analysis = {
        "transition_temperature": float(T_star),
        "peak_heat_capacity": float(heat_cap[1].max()),
        "order_parameter_at_transition_mean": float(Q_star.mean()),
        "order_parameter_at_transition_modes": modes,
        "mode_separation": float(mode_sep),
        "free_energy_barrier_kT": float(barrier),
        "reference_contact_jaccard": float(jac),
        "warnings": warnings,
    }
    with open("transition_analysis.json", "w") as fh:
        json.dump(transition_analysis, fh, indent=2)

    # ---------------- visualization ---------------------------------------
    _vk = dict(x_cold=x_cold, ni=ni, nj=nj, N=N, T_list=T_list,
               q_hist=q_hist, centers=centers, T_fine=T_fine, C_fine=C_fine,
               T_star=T_star, Fq=Fq, Pq=Pq, modes=modes)
    if _HAVE_MPL:
        fig, axes = plt.subplots(2, 2, figsize=(12, 10))
        ax = axes[0, 0]
        ax.scatter(x_cold[:, 0], x_cold[:, 1], x_cold[:, 2], s=60,
                   c="tab:blue", zorder=3)
        for i in range(N - 1):
            ax.plot(x_cold[[i, i + 1], 0], x_cold[[i, i + 1], 1],
                    x_cold[[i, i + 1], 2], "k-", lw=1.5)
        for i, j in zip(ni, nj):
            ax.plot(x_cold[[i, j], 0], x_cold[[i, j], 1], x_cold[[i, j], 2],
                    "r-", lw=0.4, alpha=0.4)
        for i in range(N):
            ax.text(x_cold[i, 0], x_cold[i, 1], x_cold[i, 2], str(i),
                    fontsize=7)
        ax.set_title("Final configuration at lowest T (red: native contacts)")
        ax = axes[0, 1]
        for k, T in enumerate(T_list):
            ax.plot(centers, q_hist[k] / 0.02, label=f"T={T:.2f}")
        ax.set_xlabel("Q"); ax.set_ylabel("density")
        ax.set_title("Q histograms (per temperature)")
        ax.legend(fontsize=8)
        ax = axes[1, 0]
        ax.plot(T_fine, C_fine, "o-", ms=3, lw=1)
        ax.axvline(T_star, color="r", ls="--", label=f"T*={T_star:.3f}")
        ax.set_xlabel("T"); ax.set_ylabel("C (fluctuation)")
        ax.set_title("Heat capacity curve"); ax.legend()
        ax = axes[1, 1]
        ax.plot(centers, Fq, "g-", lw=1.5, label="F(Q)/kT*")
        ax.set_xlabel("Q"); ax.set_ylabel("F(Q) (kT*)", color="g")
        ax2 = ax.twinx()
        ax2.bar(centers, Pq, width=0.02, color="tab:orange", alpha=0.5,
                label="P(Q)")
        ax2.set_ylabel("P(Q)")
        for m in modes:
            ax.axvline(m, color="k", ls=":", lw=1)
        ax.set_title(f"Distribution & landscape at T*={T_star:.3f}")
        l1, lb1 = ax.get_legend_handles_labels()
        l2, lb2 = ax2.get_legend_handles_labels()
        ax.legend(l1 + l2, lb1 + lb2, loc="upper right", fontsize=8)
        fig.tight_layout()
        fig.savefig("visualization.png", dpi=150)
    else:
        _viz_png("visualization.png", **_vk)

    # ---------------- sanity: no NaN/Inf, shapes --------------------------
    for name in ["final_coords", "order_parameter_trajectory",
                 "order_parameter_histograms", "heat_capacity_curve",
                 "transition_free_energy_profile", "q_energy_joint_histograms",
                 "native_contact_probability"]:
        a = np.load(name + ".npy")
        assert np.isfinite(a).all(), f"NaN/Inf in {name}"
    assert q_traj.shape == (K, n_ckpt)
    assert q_hist.shape == (K, 50) and np.allclose(q_hist.sum(axis=1), 1)
    assert joint.shape == (K, 20, 20) and np.allclose(joint.sum(axis=(1, 2)), 1)
    assert ncp.shape == (K, M)
    assert heat_cap.shape == (2, n_fine)
    assert fe_profile.shape == (2, 50)
    print(f"DONE in {time.time() - t0:.0f}s. M={M}, "
          f"n_ckpt={n_ckpt}, n_fine={n_fine}, n_star={n_star}")
    print(json.dumps({k: v for k, v in transition_analysis.items()
                      if k != "warnings"}, indent=2))


if __name__ == "__main__":
    main()
