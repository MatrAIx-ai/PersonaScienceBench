#!/usr/bin/env python3
"""Marcus ET reorganization energy. FeO6.
Ha_s/Hb_s are Cartesian (eV/A^2). Mass-weight for vibrational basis.
fwd=B-in-A, bwd=A-in-B; signed=source-ref; overlap/transported=abs.
mode_projection=[Q_k, omega_k^2 (eV/A^2), 0.5*omega_k^2*Q_k^2 (eV)]."""
import json, csv, os, struct, zlib
import numpy as np

E2_EV_ANG = 14.3996
HBAR_EV_S = 6.582119569e-16
KB_EV_K   = 8.617333262e-5

def load_inputs(data_dir="data"):
    ca=np.load(os.path.join(data_dir,"frame_a_coords.npy"))
    cb=np.load(os.path.join(data_dir,"frame_b_coords.npy"))
    Ha=np.load(os.path.join(data_dir,"frame_a_hessian.npy"))
    Hb=np.load(os.path.join(data_dir,"frame_b_hessian.npy"))
    st=list(csv.DictReader(open(os.path.join(data_dir,"site_table.csv"))))
    fo=list(csv.DictReader(open(os.path.join(data_dir,"frame_site_order.csv"))))
    mf=json.load(open(os.path.join(data_dir,"system_manifest.json")))
    md=json.load(open(os.path.join(data_dir,"medium_response.json")))
    gr=list(csv.DictReader(open(os.path.join(data_dir,"driving_force_grid.csv"))))
    return ca,cb,Ha,Hb,st,fo,mf,md,gr

def build_perms(fo):
    pa,pb={},{}
    for r in fo:
        s,i=int(r["site_id"]),int(r["row_index"])
        (pa if r["frame_id"]=="frame_a" else pb)[s]=i
    n=max(max(pa),max(pb))+1
    return [pa[i] for i in range(n)],[pb[i] for i in range(n)]

def perm_hess(H,order):
    idx=[]
    for ri in order: idx.extend([ri*3,ri*3+1,ri*3+2])
    idx=np.array(idx)
    return H[np.ix_(idx,idx)]

def kabsch(P,Q):
    cp,cq=P.mean(0),Q.mean(0)
    S=(P-cp).T@(Q-cq)
    U,_,Vt=np.linalg.svd(S)
    C=np.diag([1.,1.,np.sign(np.linalg.det(Vt.T@U.T))])
    R=Vt.T@C@U.T
    t=cq-R@cp
    pa=P@R.T+t
    return R,t,np.sqrt(np.mean(np.sum((pa-Q)**2,1)))

def mw_disp(dc,m21): return dc*np.sqrt(m21)
def mw_hess(H,sm): return H/np.outer(sm,sm)
def vib_basis(H_mw,nr=6):
    ev,ec=np.linalg.eigh(H_mw)
    return ev[nr:],ec[:,nr:]
def lam4(dc,Ha,Hb): return 0.125*dc@(Ha+Hb)@dc
def lamnm(ev,Q): return 0.5*np.sum(ev*Q**2)
def lamout(rD,rA,ei,es): return (E2_EV_ANG/2)*(1/rD+1/rA)*(1/ei-1/es)
def marcus(dG,lt,V,T):
    kBT=KB_EV_K*T
    p=V**2/(HBAR_EV_S*np.sqrt(4*np.pi*lt*kBT))
    return p*np.exp(-(lt+dG)**2/(4*lt*kBT))

def write_png(fn,W,H,rgb):
    def ch(ct,d):
        c=ct+d
        return struct.pack('>I',len(d))+c+struct.pack('>I',zlib.crc32(c)&0xffffffff)
    hd=struct.pack('>IIBBBBB',W,H,8,2,0,0,0)
    raw=b''
    for y in range(H): raw+=b'\x00'+rgb[y].tobytes()
    with open(fn,'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n')
        f.write(ch(b'IHDR',hd)); f.write(ch(b'IDAT',zlib.compress(raw))); f.write(ch(b'IEND',b''))

def make_png(path,axis,rates,Qfa,Qbb,oab,l4f,l4b,lnf,lnb,li,lo,lt,ipa,ipr):
    W,H=1200,900
    img=np.full((H,W,3),255,dtype=np.uint8)
    pw,ph=500,350
    panels=[(80,60),(620,60),(80,490),(620,490)]
    img[10:30,W//2-200:W//2+200]=[40,40,40]
    x0,y0=panels[0]
    img[y0:y0+4,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0:x0+2]=[0,0,0]
    img[y0+ph:y0+ph+2,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0+pw-2:x0+pw]=[0,0,0]
    si=np.argsort(axis); ax_s,r_s=axis[si],rates[si]
    amin,amax=ax_s.min(),ax_s.max()
    log_r=np.log10(np.maximum(r_s,1e-300))
    lmin,lmax=log_r.min(),log_r.max()
    for i in range(len(ax_s)-1):
        x1=int((ax_s[i]-amin)/(amax-amin+1e-15)*(pw-10))+x0+5
        x2=int((ax_s[i+1]-amin)/(amax-amin+1e-15)*(pw-10))+x0+5
        y1=int((1-(log_r[i]-lmin)/(lmax-lmin+1e-15))*(ph-10))+y0+5
        y2=int((1-(log_r[i+1]-lmin)/(lmax-lmin+1e-15))*(ph-10))+y0+5
        for x in range(max(0,min(x1,x2)),min(W,max(x1,x2)+1)):
            for y in range(max(0,min(y1,y2)),min(H,max(y1,y2)+1)):
                img[y,x]=[0,0,200]
    px=int((ipa-amin)/(amax-amin+1e-15)*(pw-10))+x0+5
    py=int((1-(np.log10(ipr)-lmin)/(lmax-lmin+1e-15))*(ph-10))+y0+5
    img[max(0,py-5):py+5,max(0,px-5):px+5]=[255,0,0]
    x0,y0=panels[1]
    img[y0:y0+4,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0:x0+2]=[0,0,0]
    img[y0+ph:y0+ph+2,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0+pw-2:x0+pw]=[0,0,0]
    qmax=max(np.max(np.abs(Qfa)),np.max(np.abs(Qbb)),1e-10)
    for i in range(15):
        bw=(pw-20)//15; x1=x0+10+i*bw
        h1=int(abs(Qfa[i])/qmax*(ph-40))
        if Qfa[i]>=0: img[y0+ph-20-h1:y0+ph-20,x1+2:x1+bw-4]=[70,130,180]
        else: img[y0+ph-20:y0+ph-20+h1,x1+2:x1+bw-4]=[70,130,180]
        h2=int(abs(Qbb[i])/qmax*(ph-40))
        if Qbb[i]>=0: img[y0+ph-20-h2:y0+ph-20,x1+bw//2+2:x1+bw-2]=[255,127,80]
        else: img[y0+ph-20:y0+ph-20+h2,x1+bw//2+2:x1+bw-2]=[255,127,80]
    x0,y0=panels[2]
    img[y0:y0+4,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0:x0+2]=[0,0,0]
    img[y0+ph:y0+ph+2,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0+pw-2:x0+pw]=[0,0,0]
    cw,ch2=(pw-20)//15,(ph-20)//15
    omax=oab.max()
    for i in range(15):
        for j in range(15):
            v=oab[i,j]/omax
            img[y0+10+i*ch2:y0+10+(i+1)*ch2,x0+10+j*cw:x0+10+(j+1)*cw]=[int(255*v),int(165*v),0]
    x0,y0=panels[3]
    img[y0:y0+4,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0:x0+2]=[0,0,0]
    img[y0+ph:y0+ph+2,x0:x0+pw]=[0,0,0]; img[y0:y0+ph,x0+pw-2:x0+pw]=[0,0,0]
    vals=[l4f,l4b,lnf,lnb,li,lo,lt]
    cols=[[70,130,180],[70,130,180],[255,127,80],[255,127,80],[0,128,0],[128,0,128],[139,0,0]]
    vmax=max(vals); bh=(ph-40)//7
    for i in range(7):
        w=int(vals[i]/vmax*(pw-40))
        img[y0+20+i*bh:y0+20+i*bh+bh-4,x0+30:x0+30+w]=cols[i]
    img[H-25:H-10,10:W-10]=[100,100,100]
    write_png(path,W,H,img)

def main():
    os.makedirs("results",exist_ok=True)
    ca,cb,Ha,Hb,st,fo,mf,md,gr=load_inputs()
    oa,ob=build_perms(fo)
    ca_s,cb_s=ca[oa],cb[ob]
    Ha_s,Hb_s=perm_hess(Ha,oa),perm_hess(Hb,ob)
    assert np.allclose(np.sort(np.linalg.eigvalsh(Ha)),np.sort(np.linalg.eigvalsh(Ha_s)),atol=1e-10)
    masses=np.array([float(s["mass_amu"]) for s in st])
    m21=np.repeat(masses,3)
    sm=np.sqrt(m21)
    fs=mf["freq_scale_factor"]
    Rf,tf,rmsd_f=kabsch(cb_s,ca_s)
    d_f=(cb_s@Rf.T+tf-ca_s).flatten()
    Rb,tb,rmsd_b=kabsch(ca_s,cb_s)
    d_b=(ca_s@Rb.T+tb-cb_s).flatten()
    df_mw,db_mw=mw_disp(d_f,m21),mw_disp(d_b,m21)
    np.save("results/aligned_displacement_mw.npy",np.stack([df_mw,db_mw]))
    Ha_mw=mw_hess(Ha_s,sm)
    Hb_mw=mw_hess(Hb_s,sm)
    ea,va=vib_basis(Ha_mw)
    eb,vb=vib_basis(Hb_mw)
    np.save("results/vibrational_basis_mw.npy",np.stack([va,vb]))
    Qfa, Qbb=va.T@df_mw, vb.T@db_mw
    Qfb, Qba=vb.T@df_mw, va.T@db_mw
    proj_f,proj_b=va@Qfa, vb@Qbb
    np.save("results/projected_displacement_mw.npy",np.stack([proj_f,proj_b]))
    oab,oab2=np.abs(va.T@vb),np.abs(vb.T@va)
    np.save("results/mode_overlap.npy",np.stack([oab,oab2]))
    ta=np.column_stack([np.abs(va.T@df_mw),np.abs(va.T@db_mw)])
    tb_=np.column_stack([np.abs(vb.T@df_mw),np.abs(vb.T@db_mw)])
    np.save("results/transported_mode_projection.npy",np.stack([ta,tb_]))
    l4f,l4b=lam4(d_f,Ha_s,Hb_s),lam4(d_b,Ha_s,Hb_s)
    lnf,lnb=lamnm(ea,Qfa),lamnm(eb,Qbb)
    lnfB,lnbA=lamnm(eb,Qfb),lamnm(ea,Qba)
    li=0.5*(l4f+l4b)
    lo=lamout(md["shell_0_A"],md["shell_1_A"],md["eps_fast"],md["eps_slow"])
    lt=li+lo
    mpa=np.column_stack([Qfa,ea,0.5*ea*Qfa**2])
    mpb=np.column_stack([Qbb,eb,0.5*eb*Qbb**2])
    np.save("results/mode_projection.npy",np.stack([mpa,mpb]))
    V,T=md["coupling_eV"],md["temp_K"]
    ks=marcus(0,lt,V,T)
    axis=np.array([float(r["axis_eV"]) for r in gr])
    gids=[int(r["grid_id"]) for r in gr]
    rates=np.array([marcus(dG,lt,V,T) for dG in axis])
    lr=np.where(rates>0,np.log10(rates),-300.)
    pi=int(np.argmax(rates))
    ipg,ipa,ipr=gids[pi],float(axis[pi]),float(rates[pi])
    im=axis<-lt; idet=bool(np.any(im))
    if idet:
        fi=int(np.where(im)[0][0]); fig,fa=gids[fi],float(axis[fi])
    else:
        fig,fa=None,None
    eaf,vaf=np.linalg.eigh(Ha_mw); ebf,vbf=np.linalg.eigh(Hb_mw)
    rnf=float(np.linalg.norm(vaf[:,:6].T@df_mw))
    rnb=float(np.linalg.norm(vbf[:,:6].T@db_mw))
    pnf=float(np.linalg.norm(proj_f)); pnb=float(np.linalg.norm(proj_b))
    cf,cb_=l4f-lnf,l4b-lnb
    eic=li-0.5*(lnf+lnb)
    df_i,db_i=int(np.argmax(np.abs(Qfa))),int(np.argmax(np.abs(Qbb)))
    diag={"alignment_rmsd_forward_A":float(rmsd_f),"alignment_rmsd_backward_A":float(rmsd_b),
        "closure_error_forward_eV":float(cf),"closure_error_backward_eV":float(cb_),
        "effective_inner_consistency_eV":float(eic),"rigid_norm_forward":rnf,
        "rigid_norm_backward":rnb,"projected_norm_forward":pnf,"projected_norm_backward":pnb,
        "dominant_mode_forward":df_i,"dominant_mode_backward":db_i,
        "rate_peak_grid_id":ipg,"rate_peak_axis_eV":ipa,"rate_peak_s_inv":ipr,
        "inverted_region_detected":idet,"first_inverted_grid_id":fig,"first_inverted_axis_eV":fa}
    json.dump(diag,open("results/diagnostics.json","w"),indent=2)
    with open("results/lambda_summary.csv","w",newline="") as f:
        w=csv.writer(f)
        w.writerow(["lambda_4pt_forward_eV","lambda_4pt_backward_eV","lambda_nm_forward_eV",
            "lambda_nm_backward_eV","lambda_inner_effective_eV","lambda_outer_eV",
            "lambda_total_eV","k_self_exchange_s_inv"])
        w.writerow([f"{l4f:.10f}",f"{l4b:.10f}",f"{lnf:.10f}",f"{lnb:.10f}",
            f"{li:.10f}",f"{lo:.10f}",f"{lt:.10f}",f"{ks:.10e}"])
    with open("results/rate_curve.csv","w",newline="") as f:
        w=csv.writer(f)
        w.writerow(["grid_id","axis_eV","k_et_s_inv","log10_k_et_s_inv"])
        for i in range(len(gr)):
            w.writerow([gids[i],f"{axis[i]:.10f}",f"{rates[i]:.10e}",f"{lr[i]:.10f}"])
    make_png("results/overview.png",axis,rates,Qfa,Qbb,oab,l4f,l4b,lnf,lnb,li,lo,lt,ipa,ipr)

    print("="*70);print("ANALYSIS COMPLETE");print("="*70)
    print(f"RMSD fwd={rmsd_f:.8f} bwd={rmsd_b:.8f} A")
    print(f"lam4 fwd={l4f:.6f} bwd={l4b:.6f} eV")
    print(f"lamnm fwd={lnf:.6f} bwd={lnb:.6f} eV")
    print(f"Cross-basis: fwd@A={lnf:.6f} fwd@B={lnfB:.6f} bwd@A={lnbA:.6f} bwd@B={lnb:.6f}")
    print(f"inner={li:.6f} outer={lo:.6f} total={lt:.6f} eV")
    print(f"k_self={ks:.6e} s^-1")
    print(f"Peak: gid={ipg} axis={ipa:.6f} rate={ipr:.6e}")
    print(f"Inverted: {idet}")
    print(f"Closure: fwd={cf:.6f} bwd={cb_:.6f} eV")
    print(f"Eff inner cons: {eic:.6f} eV")
    print(f"Dom mode: fwd={df_i} bwd={db_i}")
    print(f"Rigid: fwd={rnf:.6f} bwd={rnb:.6f}")
    print(f"Proj: fwd={pnf:.6f} bwd={pnb:.6f}")
    na=fs*np.sqrt(np.maximum(ea,0))/(2*np.pi);nb=fs*np.sqrt(np.maximum(eb,0))/(2*np.pi)
    print(f"A freqs: {np.round(na,1)}")
    print(f"B freqs: {np.round(nb,1)}")
    print("="*70)
    print("\nShape verification:")
    for fn in ["aligned_displacement_mw","vibrational_basis_mw","mode_overlap",
               "projected_displacement_mw","transported_mode_projection","mode_projection"]:
        a=np.load(f"results/{fn}.npy")
        print(f"  {fn}.npy: {a.shape} {a.dtype}")
    print(f"  lambda_summary.csv: {len(open('results/lambda_summary.csv').readlines())} lines")
    print(f"  rate_curve.csv: {len(open('results/rate_curve.csv').readlines())} lines")
    d=json.load(open("results/diagnostics.json"))
    print(f"  diagnostics.json: {len(d)} keys")
    assert len(d)==17
    print("\nAll outputs written to results/")

if __name__=="__main__":
    main()
