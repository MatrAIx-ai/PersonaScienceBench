def _png_write(path, canvas):
    h, w, _ = canvas.shape
    raw = b"".join(b"\x00" + canvas[i].tobytes() for i in range(h))
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr)
                + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))

def _canvas(w, h, color=(255, 255, 255)):
    return np.zeros((h, w, 3), dtype=np.uint8) | np.array(color, dtype=np.uint8)

def _put(c, x, y, color):
    x, y = int(x), int(y)
    if 0 <= y < c.shape[0] and 0 <= x < c.shape[1]:
        c[y, x] = color

def _dot(c, x, y, r, color):
    for dy in range(-r, r + 1):
        for dx in range(-r, r + 1):
            if dx * dx + dy * dy <= r * r:
                _put(c, x + dx, y + dy, color)

def _line(c, x0, y0, x1, y1, color, thick=2, dash=None):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    seg = 0
    r = thick // 2
    while True:
        if dash is None or (seg // dash[0]) % 2 == 0:
            for oy in range(-r, r + 1):
                for ox in range(-r, r + 1):
                    _put(c, x0 + ox, y0 + oy, color)
        if x0 == x1 and y0 == y1:
            break
        seg += 1
        e2 = 2 * err
        if e2 > -dy:
            err -= dy
            x0 += sx
        if e2 < dx:
            err += dx
            y0 += sy

def _text(c, x, y, s, scale=2, color=(0, 0, 0)):
    x0 = int(x)
    for ch in s.upper():
        g = _FONT.get(ch, _FONT[" "]).split()
        for ry in range(7):
            row = g[ry]
            for rx in range(5):
                if row[rx] == "1":
                    for oy in range(scale):
                        for ox in range(scale):
                            _put(c, x0 + rx * scale + ox, y + ry * scale + oy, color)
        x0 += 6 * scale

def _vtext(c, x, y, s, color):
    yy = int(y)
    for ch in s.upper():
        g = _FONT.get(ch, _FONT[" "]).split()
        for ry in range(7):
            for rx in range(5):
                if g[ry][rx] == "1":
                    for oy in range(2):
                        for ox in range(2):
                            _put(c, x + rx * 2 + ox, yy + ry * 2 + oy, color)
        yy += 12

def _sq(c, x, y, color):
    for oy in range(-3, 4):
        for ox in range(-3, 4):
            _put(c, x + ox, y + oy, color)

def _tri(c, x, y, color):
    for r2 in range(5):
        for ox in range(-r2, r2 + 1):
            _put(c, x + ox, y - r2, color)

def _plot_minimal():
    W, H = 1000, 625
    c = _canvas(W, H)
    black = (0, 0, 0); gray = (140, 140, 140); lgray = (222, 222, 222)
    red = (200, 30, 30); blue = (30, 80, 180); green = (30, 140, 60); orange = (220, 120, 20)
    ml, mr, mt, mb = 95, 95, 70, 80
    x0p, x1p = ml, W - mr
    y0p, y1p = mt, H - mb
    T = Tgrid.T_K.to_numpy()
    logs = {"loc": [r["log10_k_local_s_inv"] for r in light["rows"]],
            "opt": [r["log10_k_optimized_s_inv"] for r in light["rows"]],
            "enh": [r["log10_k_enhanced_s_inv"] for r in light["rows"]]}
    kappas = [r["enhancement_factor"] for r in light["rows"]]
    Tlo, Thi = 150.0, 975.0
    vlo = min(min(v) for v in logs.values()) - 0.7
    vhi = max(max(v) for v in logs.values()) + 0.7
    klo, khi = 1.0, max(kappas) * 1.3
    def X(t): return x0p + (t - Tlo) / (Thi - Tlo) * (x1p - x0p)
    def Y(v): return y1p - (v - vlo) / (vhi - vlo) * (y1p - y0p)
    def Y2(v): return y1p - (np.log10(v) - np.log10(klo)) / (np.log10(khi) - np.log10(klo)) * (y1p - y0p)
    t = 150.0
    while t <= Thi + 1e-9:
        xx = X(t)
        _line(c, xx, y0p, xx, y1p, lgray, 1)
        _line(c, xx, y1p, xx, y1p + 6, black, 1)
        lab = str(int(t))
        _text(c, xx - len(lab) * 3, y1p + 12, lab, 2, gray)
        t += 100.0
    v = float(int(np.ceil(vlo / 2) * 2))
    while v <= vhi:
        yy = Y(v)
        _line(c, x0p, yy, x1p, yy, lgray, 1)
        _line(c, x0p - 6, yy, x0p, yy, black, 1)
        lab = str(int(v))
        _text(c, x0p - 10 - len(lab) * 3, yy - 7, lab, 2, gray)
        v += 2.0
    e = 0
    while 10.0 ** e <= khi:
        yy = Y2(10.0 ** e)
        _line(c, x1p, yy, x1p + 6, yy, red, 1)
        lab = str(10 ** e) if e <= 2 else f"1E{e}"
        _text(c, x1p + 10, yy - 7, lab, 2, red)
        e += 1
    _line(c, x0p, y0p, x1p, y0p, black, 2)
    _line(c, x0p, y1p, x1p, y1p, black, 2)
    _line(c, x0p, y0p, x0p, y1p, black, 2)
    _line(c, x1p, y0p, x1p, y1p, black, 2)
    xs = [X(t) for t in T]
    def poly(key, color, mk):
        ys = [Y(logs[key][i]) for i in range(len(T))]
        for i in range(len(T) - 1):
            _line(c, xs[i], ys[i], xs[i + 1], ys[i + 1], color, 2)
        for i in range(len(T)):
            if mk == "o":
                _dot(c, xs[i], ys[i], 4, color)
            elif mk == "s":
                _sq(c, xs[i], ys[i], color)
            else:
                _tri(c, xs[i], ys[i], color)
    poly("loc", blue, "o"); poly("opt", green, "s"); poly("enh", orange, "^")
    ys2 = [Y2(k) for k in kappas]
    for i in range(len(T) - 1):
        _line(c, xs[i], ys2[i], xs[i + 1], ys2[i + 1], red, 2, dash=(8, 6))
    txc = X(light["T_c"])
    _line(c, txc, y0p, txc, y1p, gray, 1, dash=(4, 4))
    lab = f"TC={light['T_c']:.1f}K (WIGNER)"
    _text(c, txc - len(lab) * 3 - 20, y0p + 8, lab, 2, gray)
    title = "BASIN-TO-BASIN CROSSING RATES (LIGHT CASE)"
    _text(c, W // 2 - len(title) * 3, 18, title, 2, black)
    _text(c, (x0p + x1p) // 2 - 15, H - 28, "T (K)", 2, black)
    _vtext(c, 25, 210, "LOG10 K (1/S)", black)
    _vtext(c, W - 30, 210, "ENHANCEMENT KAPPA", red)
    lx, ly = x0p + 15, y0p + 12
    lw, lh = 470, 122
    _line(c, lx, ly, lx + lw, ly, black, 1)
    _line(c, lx, ly + lh, lx + lw, ly + lh, black, 1)
    _line(c, lx, ly, lx, ly + lh, black, 1)
    _line(c, lx + lw, ly, lx + lw, ly + lh, black, 1)
    entries = [(blue, "o", "K LOCAL (CONVENTIONAL SADDLE)"),
               (green, "s", "K OPTIMIZED (FREE-ENERGY MAX)"),
               (orange, "^", "K ENHANCED (OPTIMIZED + TUNNELING)"),
               (red, "-", "ENHANCEMENT FACTOR KAPPA")]
    for i, (col, mk, lab) in enumerate(entries):
        yy = ly + 10 + i * 28
        _line(c, lx + 10, yy + 6, lx + 40, yy + 6, col, 2,
              dash=(8, 6) if mk == "-" else None)
        if mk == "o":
            _dot(c, lx + 25, yy + 6, 4, col)
        elif mk == "s":
            _sq(c, lx + 25, yy + 6, col)
        elif mk == "^":
            _tri(c, lx + 25, yy + 6, col)
        _text(c, lx + 50, yy, lab, 2, black)
    _png_write(os.path.join(OUT, "rate_plot.png"), c)

def _plot_with_matplotlib():
    T = Tgrid.T_K.to_numpy()
    fig, ax1 = plt.subplots(figsize=(8, 5))
    ax1.plot(T, [r["log10_k_local_s_inv"] for r in light["rows"]], "o-",
             label="k local (conventional saddle)")
    ax1.plot(T, [r["log10_k_optimized_s_inv"] for r in light["rows"]], "s-",
             label="k optimized (free-energy max)")
    ax1.plot(T, [r["log10_k_enhanced_s_inv"] for r in light["rows"]], "^-",
             label="k enhanced (optimized + tunneling)")
    ax1.set_xlabel("T (K)")
    ax1.set_ylabel("log10 k (s$^{-1}$)")
    ax1.grid(alpha=0.3)
    ax2 = ax1.twinx()
    ax2.plot(T, [r["enhancement_factor"] for r in light["rows"]], "r--",
             label="enhancement factor $\\kappa$")
    ax2.axhline(1.0, color="r", lw=0.5, alpha=0.4)
    ax2.axvline(light["T_c"], color="gray", lw=0.8, ls=":")
    ax2.annotate(f"Wigner crossover T$_c$ = {light['T_c']:.1f} K",
                 xy=(light["T_c"], 1.02), xytext=(light["T_c"] - 260, 1.35),
                 fontsize=8, color="gray",
                 arrowprops=dict(arrowstyle="->", color="gray", lw=0.8))
    ax2.set_yscale("log")
    ax2.set_ylabel("enhancement factor $\\kappa$ (dimensionless, log scale)", color="r")
    ax2.tick_params(axis="y", labelcolor="r")
    h1, l1 = ax1.get_legend_handles_labels()
    h2, l2 = ax2.get_legend_handles_labels()
    ax1.legend(h1 + h2, l1 + l2, loc="upper right", fontsize=9)
    ax1.set_title("Basin-to-basin crossing rates (light case)")
    fig.tight_layout()
    fig.savefig(os.path.join(OUT, "rate_plot.png"), dpi=150)

if HAVE_MPL:
    _plot_with_matplotlib()
else:
    _plot_minimal()

