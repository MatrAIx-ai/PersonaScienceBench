#!/usr/bin/env python3
"""
VTST + tunneling-correction analysis for the 2D reaction-energy dataset.

Pipeline (as approved with the researcher):
  1. Corridor energy V(s) from the q_offset=0 tube-scan values.
  2. Transverse quadratic fits -> curvature k_perp(s); omega_perp = 95*sqrt(k_perp/m_T) cm^-1.
  3. 1D free-energy profile A(s;T) = V(s) + 0.5*hc*omega_perp - kT*ln(q_perp),
     q_perp = trapezoidal integral of exp(-dV_perp/kT) over the 13 scan points.
     Relative free energy A(s)-A(0) reported.
  4. Local crossing surface = conventional saddle (potential max along corridor).
     Optimized crossing surface = argmax of A(s;T) (variational dividing surface).
  5. Eyring rates k = (kB/h)*exp(-dA_ddag/(R T)).
  6. WKB corridor action S_c(E) = 1.24 * int_{V(s)>E} sqrt(2 m_L (V(s)-E)) ds
     (exact integral over linear segments, interpolated turning points).
     2D action S_2d(E) = minimum-action path (Dijkstra) on the 89x69 grid with
     edge weight 1.24*sqrt(2 m_L max(V-E,0))*dlen; classically allowed regions cost 0.
     transmission = 1/(1+exp(S)).
  7. Thermally averaged corridor transmission
     kappa(T) = 1 + (1/kT) int_0^{V0} t_c(E) exp((V0-E)/kT) dE.
     k_enhanced = kappa * k_optimized; enhancement_factor = kappa.
  8. Crossover temperature (Wigner): T_c = (hc/kB)*|omega_imag|/2,
     |omega_imag| = 95*sqrt(|d2V/ds2| at saddle / m_L); per isotope case rescaled
     by 1/sqrt(longitudinal_mass_scale).
  9. Isotope cases: m_L -> m_L*scale_L (actions), m_T -> m_T*scale_T (transverse ZPE).
     KIE = light enhanced log-rate - case enhanced log-rate at equal T.
"""
import json
import heapq
import os

import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except ImportError:
    HAVE_MPL = False

DATA = "data"
OUT = "results"
os.makedirs(OUT, exist_ok=True)

with open(os.path.join(DATA, "system_manifest.json")) as f:
    MAN = json.load(f)

R = MAN["public_constants"]["R_kJ_mol_K"]
HC = MAN["public_constants"]["hc_kJ_mol_per_cm"]
HC_KB = MAN["public_constants"]["hc_over_kB_K_cm"]
KB_H = MAN["public_constants"]["kB_over_h_s_per_K"]
FREQ_SCALE = MAN["public_constants"]["frequency_scale_cm1_per_sqrt_kj_mol_coord2"]
ACTION_SCALE = MAN["public_constants"]["semiclassical_action_scale"]

surf = pd.read_csv(os.path.join(DATA, "surface_samples.csv"))
curve = pd.read_csv(os.path.join(DATA, "curve_samples.csv"))
tube = pd.read_csv(os.path.join(DATA, "tube_scan.csv"))
kin = pd.read_csv(os.path.join(DATA, "kinetic_metric.csv"))
Tgrid = pd.read_csv(os.path.join(DATA, "temperature_grid.csv"))
iso = pd.read_csv(os.path.join(DATA, "isotope_cases.csv"))

X = np.sort(surf.x.unique())
Y = np.sort(surf.y.unique())
P = (surf.pivot(index="y", columns="x", values="potential_kj_mol")
         .reindex(Y).reindex(columns=X).to_numpy())
ny, nx = P.shape
DX = X[1] - X[0]
DY = Y[1] - Y[0]

v0 = (tube[tube.q_offset == 0.0].sort_values("point_id")
          .set_index("point_id")["potential_kj_mol"].to_numpy())
s = curve.s_coord.to_numpy()
npt = len(curve)
assert len(v0) == npt

scan_q = np.full((npt, 13), np.nan)
scan_v = np.full((npt, 13), np.nan)
for pid in range(npt):
    sub = tube[tube.point_id == pid].sort_values("q_id")
    scan_q[pid] = sub.q_offset.to_numpy()
    scan_v[pid] = sub.potential_kj_mol.to_numpy()
k_perp = np.array([2.0 * np.polyfit(scan_q[i], scan_v[i], 2)[0] for i in range(npt)])

iS = int(np.argmax(v0))
V0 = v0[iS]
d2 = np.gradient(np.gradient(v0, s), s)
k_long_saddle = d2[iS]
wfit = slice(iS - 6, iS + 7)
a_f = np.polyfit(s[wfit], v0[wfit], 2)
k_long_fit = 2.0 * a_f[0]

il = np.unravel_index(np.argmin(P[:, X < 0]), P[:, X < 0].shape)
ir = np.unravel_index(np.argmin(P[:, X > 0]), P[:, X > 0].shape)
Xl = X[X < 0]; Xr = X[X > 0]
basin_L = dict(x=float(Xl[il[1]]), y=float(Y[il[0]]), energy=float(P[:, X < 0][il]))
basin_R = dict(x=float(Xr[ir[1]]), y=float(Y[ir[0]]), energy=float(P[:, X > 0][ir]))

start = (int(np.argmin(np.abs(Y - basin_L["y"]))), int(np.argmin(np.abs(X - basin_L["x"]))))
end = (int(np.argmin(np.abs(Y - basin_R["y"]))), int(np.argmin(np.abs(X - basin_R["x"]))))

N_EN = 60
E_grid = np.linspace(0.0, V0, N_EN)
E_fine = np.linspace(0.0, V0, 2001)

# ----------------------------------------------------------------------------
# Core functions
# ----------------------------------------------------------------------------
def wkb_action_1d(E, m, Vc, ss):
    """WKB action (units of hbar) with the manifest scale; exact over linear
    corridor-energy segments, interpolated turning points."""
    seg = 0.0
    for i in range(len(Vc) - 1):
        e1, e2 = Vc[i], Vc[i + 1]
        if e2 <= E:
            continue
        a = (e2 - e1) / (ss[i + 1] - ss[i])          # corridor-energy slope
        c = (2.0 / 3.0) * np.sqrt(2.0 * m) / a
        if e1 > E:
            if e2 > E:                                # fully forbidden segment
                seg += c * ((e2 - E) ** 1.5 - (e1 - E) ** 1.5)
            else:                                     # forbidden from s[i] to turning point
                seg += -c * (e1 - E) ** 1.5
        else:                                         # forbidden from turning point to s[i+1]
            seg += c * (e2 - E) ** 1.5
    return ACTION_SCALE * seg


def transmission(S):
    S = np.asarray(S, dtype=float)
    out = np.empty_like(S)
    big = S > 50.0
    out[big] = 0.0
    out[~big] = 1.0 / (1.0 + np.exp(S[~big]))
    return out


def map_action(E, m, need_path=False):
    """Minimum-action path (Dijkstra) on the 2D grid. Allowed regions cost 0."""
    W = np.maximum(P - E, 0.0)
    dist = np.full((ny, nx), np.inf)
    parent = np.full((ny, nx), -1, dtype=np.int64) if need_path else None
    si, sj = start
    dist[si, sj] = 0.0
    pq = [(0.0, si, sj)]
    while pq:
        d, i, j = heapq.heappop(pq)
        if d > dist[i, j] + 1e-15:
            continue
        if (i, j) == end:
            break
        for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            ni, nj = i + di, j + dj
            if 0 <= ni < ny and 0 <= nj < nx:
                L = DX if dj else DY
                wgt = ACTION_SCALE * np.sqrt(2.0 * m * 0.5 * (W[i, j] + W[ni, nj])) * L
                nd = d + wgt
                if nd < dist[ni, nj]:
                    dist[ni, nj] = nd
                    if need_path:
                        parent[ni, nj] = i * nx + j
                    heapq.heappush(pq, (nd, ni, nj))
    if not need_path:
        return dist[end]
    path = []
    cur = end[0] * nx + end[1]
    while cur != -1:
        i, j = divmod(cur, nx)
        path.append((i, j))
        cur = parent[i, j]
    path.reverse()
    return dist[end], path


def trans_partition(q, V, kT):
    """Classical transverse partition factor integrated over the 13 scan points."""
    Vrel = V - V[np.argmin(np.abs(q))]
    return np.trapezoid(np.exp(-Vrel / kT), q)

# ----------------------------------------------------------------------------
# Per-case computation (light + isotope cases)
# ----------------------------------------------------------------------------
PATH_ENERGY_IDS = list(range(0, N_EN, 5))
cases = {}
for _, row in iso.iterrows():
    cid = row["case_id"]
    m_L = float(row["longitudinal_mass_scale"])
    m_T = float(row["transverse_mass_scale"])

    omega_T = FREQ_SCALE * np.sqrt(k_perp / m_T)
    zpe_T = 0.5 * HC * omega_T

    prof = []
    for T in Tgrid.T_K:
        kT = R * T
        A = np.empty(npt)
        for i in range(npt):
            A[i] = v0[i] + zpe_T[i] - kT * np.log(trans_partition(scan_q[i], scan_v[i], kT))
        A = A - A[0]
        i_opt = int(np.argmax(A))
        prof.append(dict(T=T, A=A, i_opt=i_opt,
                         barrier_local=A[iS], barrier_opt=A[i_opt], s_opt=s[i_opt]))

    S_c = np.array([wkb_action_1d(E, m_L, v0, s) for E in E_grid])
    S_2d = np.zeros(N_EN)
    paths = {}
    for k, E in enumerate(E_grid):
        if E >= V0 - 1e-12:
            S_2d[k] = 0.0
        elif k in PATH_ENERGY_IDS:
            S_2d[k], paths[k] = map_action(E, m_L, need_path=True)
        else:
            S_2d[k] = map_action(E, m_L)
    t_c = transmission(S_c)
    t_2d = transmission(S_2d)
    ratio = np.where(S_c > 1e-12, S_2d / np.maximum(S_c, 1e-12), 1.0)

    S_cf = np.array([wkb_action_1d(E, m_L, v0, s) for E in E_fine])
    t_cf = transmission(S_cf)
    kappas = []
    for T in Tgrid.T_K:
        kT = R * T
        sub = np.trapezoid(t_cf * np.exp((V0 - E_fine) / kT), E_fine)
        kappas.append(1.0 + sub / kT)

    omega_imag = FREQ_SCALE * np.sqrt(abs(k_long_saddle) / m_L)
    T_c = HC_KB * omega_imag / 2.0

    rows = []
    for p, kap in zip(prof, kappas):
        T = p["T"]
        k_loc = KB_H * np.exp(-p["barrier_local"] / (R * T))
        k_opt = KB_H * np.exp(-p["barrier_opt"] / (R * T))
        k_enh = kap * k_opt
        rows.append(dict(T_K=T, log10_k_local_s_inv=float(np.log10(k_loc)),
                         log10_k_optimized_s_inv=float(np.log10(k_opt)),
                         log10_k_enhanced_s_inv=float(np.log10(k_enh)),
                         kappa_corridor=float(kap), enhancement_factor=float(kap),
                         s_optimized=float(p["s_opt"]),
                         barrier_local_kj_mol=float(p["barrier_local"]),
                         barrier_optimized_kj_mol=float(p["barrier_opt"])))
    cases[cid] = dict(case_id=cid, isotopologue=row["isotopologue"],
                      m_L=m_L, m_T=m_T, omega_T=omega_T, zpe_T=zpe_T,
                      prof=prof, S_c=S_c, S_2d=S_2d, t_c=t_c, t_2d=t_2d,
                      ratio=ratio, kappas=kappas, t_cf=t_cf,
                      omega_imag=omega_imag, T_c=T_c,
                      rows=rows, paths=paths)

light = cases["light"]

# ----------------------------------------------------------------------------
# Outputs
# ----------------------------------------------------------------------------
fe_rows = []
for p in light["prof"]:
    for i in range(npt):
        fe_rows.append(dict(T_K=p["T"], point_id=i, s_coord=s[i], x=curve.x.iloc[i],
                            y=curve.y.iloc[i],
                            transverse_frequency_cm1=float(light["omega_T"][i]),
                            free_energy_kj_mol=float(p["A"][i]),
                            is_optimized_crossing=(i == p["i_opt"])))
pd.DataFrame(fe_rows).to_csv(os.path.join(OUT, "free_energy_profile.csv"), index=False)

rc = pd.DataFrame(light["rows"])
rc["crossover_T_K"] = light["T_c"]
rc.to_csv(os.path.join(OUT, "rate_constants.csv"), index=False)

tp = pd.DataFrame(dict(
    energy_id=np.arange(N_EN), energy_kj_mol=E_grid,
    action_corridor=light["S_c"], action_2d=light["S_2d"],
    transmission_corridor=light["t_c"], transmission_2d=light["t_2d"],
    action_ratio_2d_over_corridor=light["ratio"]))
tp.to_csv(os.path.join(OUT, "transmission_profile.csv"), index=False)

ps_rows = []
for k in PATH_ENERGY_IDS:
    for step, (i, j) in enumerate(light["paths"][k]):
        ps_rows.append(dict(energy_id=k, path_step=step, energy_kj_mol=E_grid[k],
                            x=X[j], y=Y[i], potential_kj_mol=P[i, j]))
pd.DataFrame(ps_rows).to_csv(os.path.join(OUT, "path_samples.csv"), index=False)

ie_rows = []
for i, (_, row) in enumerate(iso.iterrows()):
    c = cases[row["case_id"]]
    for r in c["rows"]:
        kie = light["rows"][i * 0 + list(c["rows"]).index(r)]["log10_k_enhanced_s_inv"] \
            - r["log10_k_enhanced_s_inv"]
        ie_rows.append(dict(
            case_id=c["case_id"], isotopologue=c["isotopologue"],
            longitudinal_mass_scale=c["m_L"], transverse_mass_scale=c["m_T"],
            T_K=r["T_K"], log10_k_local_s_inv=r["log10_k_local_s_inv"],
            log10_k_optimized_s_inv=r["log10_k_optimized_s_inv"],
            log10_k_enhanced_s_inv=r["log10_k_enhanced_s_inv"],
            enhancement_factor=r["enhancement_factor"], s_optimized=r["s_optimized"],
            crossover_T_K=c["T_c"], log10_KIE_sct_vs_light=float(kie)))
pd.DataFrame(ie_rows).to_csv(os.path.join(OUT, "isotope_effects.csv"), index=False)

itp_rows = []
for _, row in iso.iterrows():
    c = cases[row["case_id"]]
    for k in range(N_EN):
        itp_rows.append(dict(
            case_id=c["case_id"], isotopologue=c["isotopologue"],
            longitudinal_mass_scale=c["m_L"], transverse_mass_scale=c["m_T"],
            energy_id=k, energy_kj_mol=E_grid[k],
            action_corridor=c["S_c"][k], action_2d=c["S_2d"][k],
            transmission_corridor=c["t_c"][k], transmission_2d=c["t_2d"][k],
            action_ratio_2d_over_corridor=c["ratio"][k]))
pd.DataFrame(itp_rows).to_csv(os.path.join(OUT, "isotope_transmission_profile.csv"), index=False)

def _sub_over_cross_T(c, Tlo=50.0, Thi=3000.0, n=2501):
    """T at which the thermally averaged kappa crosses 2 (sub-barrier = over-barrier)."""
    Tg = np.linspace(Tlo, Thi, n)
    kTg = R * Tg
    W = c["t_cf"][None, :] * np.exp((V0 - E_fine[None, :]) / kTg[:, None])  # (nT, nE)
    sub = np.trapezoid(W, E_fine, axis=1)
    kap = 1.0 + sub / kTg
    f = kap - 2.0
    sign = np.where(f > 0)[0]
    if len(sign) == 0:
        return None
    i = sign[-1]
    if i + 1 >= len(Tg):
        return None
    t1, t2 = Tg[i], Tg[i + 1]
    f1, f2 = f[i], f[i + 1]
    return float(t1 + (t2 - t1) * f1 / (f1 - f2))

# diagnostics.json
mask = E_grid < V0 - 1e-12
mean_ratio = float(np.mean(light["ratio"][mask]))
diag = {
    "basins": {
        "reactant_lower_x": basin_L,
        "product_higher_x": basin_R,
        "reaction_energy_kj_mol": float(basin_R["energy"] - basin_L["energy"]),
    },
    "conventional_saddle": {
        "x": float(curve.x.iloc[iS]), "y": float(curve.y.iloc[iS]),
        "s": float(s[iS]), "point_id": iS, "energy_kj_mol": float(V0),
        "longitudinal_curvature_kj_mol_coord2": float(k_long_saddle),
        "transverse_curvature_kj_mol_coord2": float(k_perp[iS]),
        "imag_frequency_cm1_light": float(light["omega_imag"]),
        "transverse_frequency_cm1_light": float(light["omega_T"][iS]),
        "curvature_crosscheck_quadratic_fit_pm6": {
            "longitudinal_curvature_kj_mol_coord2": float(k_long_fit),
            "imag_frequency_cm1": float(FREQ_SCALE * np.sqrt(abs(k_long_fit))),
            "T_c_K": float(HC_KB * FREQ_SCALE * np.sqrt(abs(k_long_fit)) / 2.0),
        },
    },
    "crossover_temperature_K": {
        "definition": "Wigner crossover T_c = (hc/kB)|omega_imag|/2; |omega_imag| from the "
                      "central-difference longitudinal saddle curvature, rescaled by "
                      "1/sqrt(longitudinal_mass_scale) per isotope case",
        "light": float(light["T_c"]),
        "transfer_D": float(cases["transfer_D"]["T_c"]),
        "framework_D": float(cases["framework_D"]["T_c"]),
        "note": "Wigner crossover (kappa_tilde = 1) used as the crossover temperature per the "
                "approved definition. The sub-barrier/over-barrier contribution ratio "
                "kappa(T)-1 decreases monotonically with T; the temperature at which the "
                "sub-barrier tunneling contribution equals the over-barrier contribution "
                "(kappa = 2) is reported below as a consistency cross-check.",
        "sub_barrier_over_barrier_ratio_at_177K": {
            cid: float(c["kappas"][0] - 1.0) for cid, c in cases.items()},
        "sub_barrier_equals_over_barrier_T_K": {
            cid: _sub_over_cross_T(c) for cid, c in cases.items()},
    },
    "wigner_cross_check": {
        "kappa_tilde": "kappa_tilde(T) = T_c / T (per case)",
        "validity": "Wigner kappa = kappa_tilde/sin(kappa_tilde) valid for kappa_tilde < pi/2, "
                    "i.e. T > 2*T_c/pi",
        "valid_window_K": {cid: float(2.0 * c["T_c"] / np.pi) for cid, c in cases.items()},
        "kappa_wigner_light_at_grid_T": {
            f"{T:g}": (float(HC_KB * light["omega_imag"] / (2.0 * T)) /
                       np.sin(HC_KB * light["omega_imag"] / (2.0 * T)))
            for T in Tgrid.T_K
            if HC_KB * light["omega_imag"] / (2.0 * T) < np.pi / 2},
    },
    "action_reduction": {
        "mean_2d_over_corridor_action_ratio": mean_ratio,
        "mean_action_reduction_fraction": float(1.0 - mean_ratio),
        "ratio_at_low_energy_0_kj_mol": float(light["ratio"][0]),
        "ratio_near_barrier_V0_minus_2_kj_mol": float(
            light["ratio"][np.argmin(np.abs(E_grid - (V0 - 2.0)))]),
        "note": "2D minimum-action path cuts the corner of the 1D corridor barrier",
    },
    "rate_ordering": {
        "expected": "k_optimized <= k_local < k_enhanced at every T (tunneling kappa > 1)",
        "holds": bool(all(
            r["log10_k_optimized_s_inv"] <= r["log10_k_local_s_inv"] < r["log10_k_enhanced_s_inv"]
            for r in light["rows"])),
        "s_optimized_by_T": {f"{p['T']:g}": float(p["s_opt"]) for p in light["prof"]},
        "s_conventional_saddle": float(s[iS]),
    },
    "isotope_effects_log10_KIE_vs_light_at_297p5K": {
        cid: float(light["rows"][int(np.argmin(np.abs(Tgrid.T_K.to_numpy() - 297.5)))]["log10_k_enhanced_s_inv"]
                  - c["rows"][int(np.argmin(np.abs(Tgrid.T_K.to_numpy() - 297.5)))]["log10_k_enhanced_s_inv"])
        for cid, c in cases.items()},
    "conventions": {
        "energy_unit": "kJ/mol (manifest)",
        "frequency": "omega_cm1 = 95*sqrt(curvature_kJ_mol_coord2 / mass_amu) (manifest scale)",
        "action": "S = 1.24 * int sqrt(2 m (V-E)) ds in units of hbar; t = 1/(1+exp(S))",
        "eyring_prefactor": "(kB/h) = 2.0837e10 s^-1 K^-1 (manifest constant, no extra T factor)",
        "enhanced_rate": "k_enhanced = kappa_corridor(T) * k_optimized(T)",
        "free_energy_reference": "A(s) - A(0) relative to reactant corridor point s=0",
    },
}
with open(os.path.join(OUT, "diagnostics.json"), "w") as f:
    json.dump(diag, f, indent=2)


