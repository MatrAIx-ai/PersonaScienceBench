_VIRIDIS = [(68,1,84),(59,82,139),(33,145,140),(93,201,99),(253,231,37)]

def _viridis(t):
    t = min(1.0, max(0.0, float(t)))
    x = t * (len(_VIRIDIS) - 1)
    i = min(int(x), len(_VIRIDIS) - 2)
    f = x - i
    return tuple(int(a + (b - a) * f) for a, b in zip(_VIRIDIS[i], _VIRIDIS[i + 1]))

class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.px = np.tile(np.array(bg, dtype=np.uint8), (h, w, 1))

    def rect(self, x0, y0, x1, y1, color):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        self.px[max(0, y0):min(self.h, y1 + 1), max(0, x0):min(self.w, x1 + 1)] = color

    def line(self, x0, y0, x1, y1, color, thickness=1, dash=None):
        x0, y0, x1, y1 = float(x0), float(y0), float(x1), float(y1)
        n = int(max(abs(x1 - x0), abs(y1 - y0)) * 2) + 1
        for i in range(n + 1):
            t = i / n
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            if dash and (i // 8) % 2 == 0:
                continue
            for dx in range(thickness):
                for dy in range(thickness):
                    xi, yi = int(x) + dx, int(y) + dy
                    if 0 <= xi < self.w and 0 <= yi < self.h:
                        self.px[yi, xi] = color

    def text(self, x, y, s, color=(0, 0, 0), scale=1):
        x = int(x)
        for ch in str(s).upper():
            g = _FONT.get(ch, _FONT[' '])
            for ry in range(7):
                for rx in range(5):
                    if g[ry] & (1 << (4 - rx)):
                        self.rect(x + rx * scale, y + ry * scale,
                                  x + rx * scale + scale - 1, y + ry * scale + scale - 1, color)
            x += 6 * scale

    def save(self, path):
        raw = b"".join(b"\x00" + self.px[y].tobytes() for y in range(self.h))

        def chunk(tag, data):
            c = struct.pack(">I", len(data)) + tag + data
            return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

        png = (b"\x89PNG\r\n\x1a\n"
               + chunk(b"IHDR", struct.pack(">IIBBBBB", self.w, self.h, 8, 2, 0, 0, 0))
               + chunk(b"IDAT", zlib.compress(raw, 6))
               + chunk(b"IEND", b""))
        with open(path, "wb") as f:
            f.write(png)

