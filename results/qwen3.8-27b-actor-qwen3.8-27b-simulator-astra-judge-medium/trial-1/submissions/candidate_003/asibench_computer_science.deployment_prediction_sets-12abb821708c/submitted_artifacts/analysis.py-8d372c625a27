"""
Deployment prediction-set construction under a label-weighted-miss risk target.

Method:
  * Scores are per-label probabilities (sum to 1) and are OVERCONFIDENT, so the
    threshold is calibrated against TRUE calibration labels (never score mass).
  * Cost-adjusted conformal score  a_i(l) = s_i(l) * cost(l).
    Set C_i = { l : a_i(l) >= tau } U {argmax_l s_i(l)}  (argmax union => nonempty).
  * proxy_stratum = k-means (k=4) on standardized features, fit on combined
    cal+dep, fixed seed; strata renamed by empirical difficulty (g0=easiest).
  * Per-stratum calibration target = target_risk * (1 - delta).
    delta=0.1366 read as confidence/safety level (1-delta ~ 0.86) -> safety margin
    for the observed covariate shift (deployment harder & over-weights high-cost strata).
"""
import json, os
import numpy as np
import pandas as pd
from scipy.stats import norm
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    _HAS_MPL = True
except Exception:
    _HAS_MPL = False

DATA, OUT = "data", "results"
os.makedirs(OUT, exist_ok=True)

spec = json.load(open(f"{DATA}/risk_spec.json"))
meta = json.load(open(f"{DATA}/metadata.json"))
target_risk = float(spec["target_risk"])
delta = float(spec["delta"])
costs = {k: float(v) for k, v in spec["label_costs"].items()}
labels = list(meta["label_columns"])
feats = list(meta["feature_columns"])
L = len(labels)
C = np.array([costs[l] for l in labels])
IDX = {l: i for i, l in enumerate(labels)}
cal_target = round(target_risk * (1.0 - delta), 4)
z_conf = float(norm.ppf(1.0 - delta))
K, SEED = 4, 0

cal_scores = pd.read_csv(f"{DATA}/calibration_scores.csv")
cal_labels = pd.read_csv(f"{DATA}/calibration_labels.csv")
cal_feats  = pd.read_csv(f"{DATA}/calibration_features.csv")
dep_scores = pd.read_csv(f"{DATA}/deployment_scores.csv")
dep_feats  = pd.read_csv(f"{DATA}/deployment_features.csv")

cal = cal_scores.merge(cal_labels, on="record_id").merge(cal_feats, on="record_id")
dep = dep_scores.merge(dep_feats, on="record_id")
n_cal, n_dep = len(cal), len(dep)

cal_true = cal["true_label"].values
cal_cost = np.array([costs[t] for t in cal_true])
cal_tidx = np.array([IDX[t] for t in cal_true])
cal_S = cal[labels].values
dep_S = dep[labels].values

def kmeans(X, k, seed, it=100):
    rng = np.random.RandomState(seed)
    Cc = X[rng.choice(len(X), k, replace=False)].copy()
    for _ in range(it):
        d = ((X[:, None] - Cc[None, :]) ** 2).sum(-1)
        ll = d.argmin(1)
        new = Cc.copy()
        for j in range(k):
            if (ll == j).any():
                new[j] = X[ll == j].mean(0)
        if np.allclose(new, Cc):
            Cc = new; break
        Cc = new
    d = ((X[:, None] - Cc[None, :]) ** 2).sum(-1)
    return d.argmin(1), Cc

Xc = cal_feats[feats].values
Xd = dep_feats[feats].values
allX = np.vstack([Xc, Xd])
mu, sd = allX.mean(0), allX.std(0) + 1e-12
_, centers = kmeans((allX - mu) / sd, K, SEED)

def assign(X):
    Xs = (X - mu) / sd
    d = ((Xs[:, None] - centers[None, :]) ** 2).sum(-1)
    return d.argmin(1)

gcal_old = assign(Xc)
gdep_old = assign(Xd)

def topk_risk(S, tidx, cost, k=3):
    n = len(S); topk = np.argsort(-S, 1)[:, :k]
    cov = np.array([tidx[a] in topk[a] for a in range(n)])
    return cost[~cov].sum() / n if (~cov).any() else 0.0

diff = np.empty(K)
for j in range(K):
    m = gcal_old == j
    diff[j] = topk_risk(cal_S[m], cal_tidx[m], cal_cost[m], k=3)
order = np.argsort(diff)
remap = {int(order[r]): r for r in range(K)}
gcal = np.array([remap[int(x)] for x in gcal_old])
gdep = np.array([remap[int(x)] for x in gdep_old])
strat_ids = [f"g{j}" for j in range(K)]

def search_tau(S, tidx, cost, tgt):
    n = len(S); A = S * C[None, :]; amax = np.argsort(-S, 1)[:, 0:1]
    best = (0.0, 9.0, 0.0)
    for t in np.linspace(0.0, 2.0, 2001):
        mask = (A >= t) | (np.arange(L)[None, :] == amax)
        tin = mask[np.arange(n), tidx]
        r = cost[~tin].sum() / n
        if r <= tgt and mask.sum(1).mean() < best[1]:
            best = (t, mask.sum(1).mean(), r)
    return best

def make_set(Srow, tau):
    A = Srow * C
    keep = A >= tau
    keep[int(np.argmax(Srow))] = True
    return [labels[i] for i in range(L) if keep[i]]

tau = np.empty(K); cal_risk = np.empty(K); cal_size = np.empty(K)
for j in range(K):
    m = gcal == j
    tau[j], cal_size[j], cal_risk[j] = search_tau(cal_S[m], cal_tidx[m], cal_cost[m], cal_target)

dep_sets = [make_set(dep_S[i], tau[gdep[i]]) for i in range(n_dep)]
dep_set_size = np.array([len(s) for s in dep_sets])
dep_size_by_strat = [dep_set_size[gdep == j] for j in range(K)]
dep_n_by_strat = np.array([int((gdep == j).sum()) for j in range(K)])
dep_mean_size = [s.mean() if len(s) else np.nan for s in dep_size_by_strat]
est_risk_by_strat = cal_risk.copy()
est_overall_risk = float(sum(dep_n_by_strat[j] * est_risk_by_strat[j] for j in range(K)) / n_dep)
overall_mean_size = float(dep_set_size.mean())
overall_p90 = float(np.percentile(dep_set_size, 90))

def strat_upper_bound(j):
    m = gcal == j; n = int(m.sum())
    idx = np.where(m)[0]
    mask = (cal_S[idx] * C[None, :] >= tau[j]) | (np.arange(L)[None, :] == np.argsort(-cal_S[idx], 1)[:, 0:1])
    x = cal_cost[idx][~mask[np.arange(n), cal_tidx[idx]]]
    x = np.concatenate([x, np.zeros(n - len(x))])
    return x.mean() + z_conf * (x.std(ddof=1) if n > 1 else 0.0) / np.sqrt(n)
ub = np.array([strat_upper_bound(j) for j in range(K)])

assert np.all(cal_risk <= cal_target + 1e-9), "per-stratum calibration risk exceeds target!"
assert int((dep_set_size == 0).sum()) == 0, "empty set found!"

print("=== PER-STRATUM CALIBRATION (guarantee: risk <= cal_target for ALL strata) ===")
for j in range(K):
    print(f"  {strat_ids[j]}: n_cal={int((gcal==j).sum()):4d}  tau={tau[j]:.4f}  "
          f"cal_risk={cal_risk[j]:.4f} (<= {cal_target})  cal_size={cal_size[j]:.2f}  "
          f"dep_n={dep_n_by_strat[j]:4d}  dep_mean_size={dep_mean_size[j]:.2f}  ub={ub[j]:.4f}")
print(f"  cal_target={cal_target}  target_risk={target_risk}  delta={delta}  z(1-delta)={z_conf:.3f}")
print("=== DEPLOYMENT SET-SIZE SUMMARY ===")
print(f"  n_dep={n_dep}  mean_set_size={overall_mean_size:.3f}  p90={overall_p90:.0f}  "
      f"max={dep_set_size.max()}  min={dep_set_size.min()}  n_empty={int((dep_set_size==0).sum())}")
print(f"  ESTIMATED OVERALL DEPLOYMENT RISK = {est_overall_risk:.4f}  (target {target_risk})")

# NOTE (delta interpretation, working assumption): delta=0.1366 is read as the
# confidence/safety level for risk control (1-delta ~ 0.86). It drives (a) the
# per-stratum calibration_target_risk = target_risk*(1-delta) = 0.0936 and (b) the
# one-sided upper-confidence bound on each stratum risk (z = norm.ppf(1-delta)).
# See analysis.py docstring. policy_parameters exposes this via calibration_target_risk
# and group_upper_confidence_risk (schema fixed, so no extra column is added).
# ---------------- write outputs ----------------
pd.DataFrame({"record_id": dep["record_id"],
              "prediction_set": [" ".join(s) for s in dep_sets]}).to_csv(
    f"{OUT}/prediction_sets.csv", index=False)

rows = []
for j in range(K):
    m = gcal == j
    n_cal_g = int(m.sum())
    for l in labels:
        thr = min(1.0, max(0.0, tau[j] / costs[l]))
        rows.append({"proxy_stratum": strat_ids[j], "label": l,
                     "n_calibration": n_cal_g, "n_calibration_label": int((cal_true[m] == l).sum()),
                     "threshold": round(thr, 6),
                     "group_empirical_weighted_miss_risk": round(float(cal_risk[j]), 6),
                     "group_upper_confidence_risk": round(float(ub[j]), 6),
                     "group_expected_set_size": round(float(dep_mean_size[j]), 4),
                     "calibration_target_risk": cal_target, "target_risk": target_risk})
pd.DataFrame(rows).to_csv(f"{OUT}/policy_parameters.csv", index=False)

def risk_viol(r):
    return bool(r > target_risk)

aud = [{"scope": "overall", "stratum_id": "all", "n_records": n_dep,
        "empirical_risk": round(est_overall_risk, 6), "mean_set_size": round(overall_mean_size, 4),
        "p90_set_size": round(overall_p90, 2), "target_risk": target_risk,
        "risk_violation": risk_viol(est_overall_risk)}]
for j in range(K):
    aud.append({"scope": "proxy_stratum", "stratum_id": strat_ids[j], "n_records": int(dep_n_by_strat[j]),
                "empirical_risk": round(float(est_risk_by_strat[j]), 6),
                "mean_set_size": round(float(dep_mean_size[j]), 4),
                "p90_set_size": round(float(np.percentile(dep_size_by_strat[j], 90)), 2) if len(dep_size_by_strat[j]) else 0,
                "target_risk": target_risk, "risk_violation": risk_viol(float(est_risk_by_strat[j]))})
pd.DataFrame(aud).to_csv(f"{OUT}/audit_summary.csv", index=False)

pd.DataFrame({"record_id": dep["record_id"], "set_size": dep_set_size,
              "proxy_stratum": [strat_ids[int(g)] for g in gdep]}).to_csv(
    f"{OUT}/set_size_summary.csv", index=False)

part = []
for j in range(K):
    part.append({"scope": "proxy_stratum", "stratum_id": strat_ids[j], "n_records": int(dep_n_by_strat[j]),
                 "empirical_risk": round(float(est_risk_by_strat[j]), 6),
                 "mean_set_size": round(float(dep_mean_size[j]), 4),
                 "p90_set_size": round(float(np.percentile(dep_size_by_strat[j], 90)), 2) if len(dep_size_by_strat[j]) else 0,
                 "target_risk": target_risk,
                 "risk_margin": round(target_risk - float(est_risk_by_strat[j]), 6)})
pd.DataFrame(part).to_csv(f"{OUT}/partition_diagnostics.csv", index=False)

dist = []
for j in range(K):
    cf_ = (gcal == j).sum() / n_cal
    df_ = (gdep == j).sum() / n_dep
    dist.append({"proxy_stratum": strat_ids[j], "calibration_fraction": round(cf_, 6),
                 "deployment_fraction": round(df_, 6),
                 "density_ratio_estimate": round(df_ / max(cf_, 1e-6), 6),
                 "absolute_fraction_shift": round(abs(df_ - cf_), 6)})
pd.DataFrame(dist).to_csv(f"{OUT}/distribution_diagnostics.csv", index=False)

NB = 5
cd = []
edges = np.linspace(0, 1, NB + 1)
for j in range(K):
    m = gcal == j
    idx = np.where(m)[0]
    tls = cal_S[idx, cal_tidx[idx]]
    for b in range(NB):
        lo, hi = edges[b], edges[b + 1]
        inb = (tls >= lo) & (tls < hi) if b < NB - 1 else (tls >= lo) & (tls <= hi)
        if inb.sum() == 0:
            continue
        cd.append({"proxy_stratum": strat_ids[j], "bin_id": b, "score_left": round(lo, 3),
                   "score_right": round(hi, 3), "n_records": int(inb.sum()),
                   "mean_true_label_score": round(float(tls[inb].mean()), 6)})
pd.DataFrame(cd).to_csv(f"{OUT}/calibration_diagnostics.csv", index=False)

ca = [{"scope": "overall", "stratum_id": "all", "empirical_risk": round(est_overall_risk, 6),
       "target_risk": target_risk, "risk_violation": risk_viol(est_overall_risk),
       "violates": risk_viol(est_overall_risk)}]
for j in range(K):
    r = float(est_risk_by_strat[j])
    ca.append({"scope": "proxy_stratum", "stratum_id": strat_ids[j], "empirical_risk": round(r, 6),
               "target_risk": target_risk, "risk_violation": risk_viol(r), "violates": risk_viol(r)})
pd.DataFrame(ca).to_csv(f"{OUT}/constraint_audit.csv", index=False)


