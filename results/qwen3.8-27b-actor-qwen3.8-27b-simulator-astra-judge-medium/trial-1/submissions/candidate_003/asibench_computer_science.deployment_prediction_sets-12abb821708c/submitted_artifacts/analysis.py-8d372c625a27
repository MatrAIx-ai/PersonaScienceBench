    _hline(img2, px, py, 9, (150, 150, 150), -0.5, 3.5)
    _text(img2, 320, 55, "TRIVIAL=9", (150, 150, 150), 2)
    _save_png(_hstack([img1, img2]), f"{OUT}/partition_audit.png")

def _fb_score():
    a = np.zeros((420, 460, 3), np.uint8)
    bcal, _ = np.histogram(cal_S.max(1), bins=30, range=(0, 1))
    bdep, _ = np.histogram(dep_S.max(1), bins=30, range=(0, 1))
    ymax = max(bcal.max(), bdep.max())
    px, py = _axis(a, 460, 420, 55, 20, 40, 55, 0, 1, 0, ymax, [0, 0.5, 1.0],
                   [0, ymax // 2, ymax], "TOP1 SCORE", "COUNT", "TOP1 SCORE (SHIFT)")
    bw = (460 - 75) / 30
    for i in range(30):
        x0 = 55 + i * bw
        yc, yd, y0 = py(bcal[i]), py(bdep[i]), py(0)
        _rect(a, int(x0 + 1), min(yc, y0), int(x0 + bw / 2 - 1), max(yc, y0), (60, 110, 200))
        _rect(a, int(x0 + bw / 2), min(yd, y0), int(x0 + bw - 1), max(yd, y0), (60, 160, 110))
    _text(a, 60, 50, "CAL", (60, 110, 200), 2); _text(a, 110, 50, "DEP", (60, 160, 110), 2)
    b = np.zeros((420, 460, 3), np.uint8)
    px, py = _axis(b, 460, 420, 55, 20, 40, 55, -0.5, 3.5, 0, 1, [], [0, 0.5, 1.0],
                   "STRATUM", "TRUE-LABEL SCORE", "TRUE-LABEL SCORE BY STRATUM")
    for j in range(K):
        vals = cal_S[(gcal == j)][cal_tidx[(gcal == j)]]
        q1, med, q3 = np.percentile(vals, [25, 50, 75]); lo, hi = vals.min(), vals.max()
        X = px(j)
        _line(b, X, py(lo), X, py(hi), (0, 0, 0), 1)
        _rect(b, X - 12, py(q3), X + 12, py(q1), (200, 220, 255))
        _line(b, X - 12, py(med), X + 12, py(med), (220, 40, 40), 2)
        _text(b, X - 12, py(0) + 8, strat_ids[j], (0, 0, 0), 2)
    c = np.zeros((420, 460, 3), np.uint8)
    px, py = _axis(c, 460, 420, 55, 20, 40, 55, 0, 1, 0, 1, [0, 0.5, 1.0],
                   [0, 0.5, 1.0], "PRED TOP1 SCORE", "TOP1 ACCURACY", "RELIABILITY (OVERCONF)")
    _line(c, px(0), py(0), px(1), py(1), (150, 150, 150), 1)
    top1 = cal_S.max(1); acc1 = (cal_S.argmax(1) == cal_tidx).astype(float)
    bins = np.linspace(0, 1, 11); pts = []
    for bb in range(10):
        lo, hi = bins[bb], bins[bb + 1]; inb = (top1 >= lo) & (top1 < hi)
        if inb.sum() > 20:
            pts.append((top1[inb].mean(), acc1[inb].mean()))
    for i in range(len(pts) - 1):
        _line(c, px(pts[i][0]), py(pts[i][1]), px(pts[i + 1][0]), py(pts[i + 1][1]), (220, 40, 40), 1)
    for (aa, cc) in pts:
        _rect(c, int(px(aa)) - 3, int(py(cc)) - 3, int(px(aa)) + 3, int(py(cc)) + 3, (220, 40, 40))
    _save_png(_hstack([a, b, c]), f"{OUT}/score_diagnostics.png")

def _mpl_plots():
    A = cal_S * C[None, :]; amax = np.argsort(-cal_S, 1)[:, 0:1]
    xs, ys = [], []
    for t in np.linspace(0.0, 0.6, 301):
        mask = (A >= t) | (np.arange(L)[None, :] == amax)
        tin = mask[np.arange(n_cal), cal_tidx]
        xs.append(mask.sum(1).mean()); ys.append(cal_cost[~tin].sum() / n_cal)
    fig, ax = plt.subplots(figsize=(7, 5))
    ax.plot(xs, ys, lw=2, label="calibration (cost-adjusted tau sweep)")
    ax.axhline(target_risk, color="red", ls="--", lw=1.2, label=f"spec target {target_risk}")
    ax.axhline(cal_target, color="orange", ls=":", lw=1.2, label=f"cal_target (1-delta) {cal_target}")
    for j in range(K):
        ax.scatter([dep_mean_size[j]], [cal_risk[j]], marker="*", s=120, zorder=5)
        ax.annotate(strat_ids[j], (dep_mean_size[j], cal_risk[j]), textcoords="offset points", xytext=(6, 4))
    ax.set_xlabel("mean set size"); ax.set_ylabel("weighted miss risk")
    ax.set_title("Set-size vs risk tradeoff (calibration)"); ax.legend()
    fig.tight_layout(); fig.savefig(f"{OUT}/set_size_tradeoff.png", dpi=110); plt.close(fig)
    fig, axes = plt.subplots(1, 2, figsize=(11, 4.5))
    ax = axes[0]
    ax.bar(strat_ids, est_risk_by_strat, color="steelblue")
    ax.axhline(target_risk, color="red", ls="--", lw=1.2, label=f"target {target_risk}")
    ax.axhline(cal_target, color="orange", ls=":", lw=1.2, label=f"cal_target {cal_target}")
    ax.set_ylabel("est. weighted miss risk"); ax.set_title("Per-stratum risk vs target"); ax.legend()
    ax = axes[1]
    ax.bar(strat_ids, dep_mean_size, color="seagreen")
    ax.axhline(9, color="grey", ls=":", lw=1, label="trivial (all 9)")
    ax.set_ylabel("mean deployment set size"); ax.set_title("Per-stratum set size"); ax.legend()
    fig.tight_layout(); fig.savefig(f"{OUT}/partition_audit.png", dpi=110); plt.close(fig)
    fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))
    ax = axes[0]
    ax.hist(cal_S.max(1), bins=40, alpha=0.6, label="calibration", density=True)
    ax.hist(dep_S.max(1), bins=40, alpha=0.6, label="deployment", density=True)
    ax.set_xlabel("top-1 score"); ax.set_ylabel("density"); ax.set_title("Top-1 score (shift)"); ax.legend()
    ax = axes[1]
    data = [cal_S[(gcal == j)][cal_tidx[(gcal == j)]] for j in range(K)]
    ax.boxplot(data, tick_labels=strat_ids); ax.set_ylabel("score of true label")
    ax.set_title("True-label score by stratum (cal)")
    ax = axes[2]
    top1 = cal_S.max(1); acc1 = (cal_S.argmax(1) == cal_tidx).astype(float)
    bins = np.linspace(0, 1, 11); bx, by = [], []
    for bb in range(10):
        lo, hi = bins[bb], bins[bb + 1]; inb = (top1 >= lo) & (top1 < hi)
        if inb.sum() > 20:
            bx.append(top1[inb].mean()); by.append(acc1[inb].mean())
    ax.plot([0, 1], [0, 1], "k--", lw=1, label="perfect")
    ax.plot(bx, by, "o-", label="calibration")
    ax.set_xlabel("predicted top-1 score"); ax.set_ylabel("top-1 accuracy")
    ax.set_title("Reliability (overconfidence)"); ax.legend()
    fig.tight_layout(); fig.savefig(f"{OUT}/score_diagnostics.png", dpi=110); plt.close(fig)

