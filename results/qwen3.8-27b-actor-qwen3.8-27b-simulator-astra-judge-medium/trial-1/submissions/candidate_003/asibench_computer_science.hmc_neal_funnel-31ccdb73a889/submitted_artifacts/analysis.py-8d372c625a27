def _px(img, x, y, color):
    if 0 <= x < img.shape[1] and 0 <= y < img.shape[0]:
        img[y, x] = color

def _rect(img, x0, y0, x1, y1, color):
    x0, x1 = max(0, int(x0)), min(img.shape[1] - 1, int(x1))
    y0, y1 = max(0, int(y0)), min(img.shape[0] - 1, int(y1))
    if x1 >= x0 and y1 >= y0:
        img[y0:y1 + 1, x0:x1 + 1] = color

def _line(img, x0, y0, x1, y1, color, thick=1):
    n = max(abs(int(x1) - int(x0)), abs(int(y1) - int(y0)), 1)
    for i in range(n + 1):
        x = int(round(x0 + (x1 - x0) * i / n))
        y = int(round(y0 + (y1 - y0) * i / n))
        for dx in range(thick):
            for dy in range(thick):
                _px(img, x + dx, y + dy, color)

def _text(img, x, y, s, color, scale=2):
    cx = int(x)
    for ch in s:
        g = FONT.get(ch, (0b01110, 0b10001, 0b10001, 0b01110, 0b10001, 0b10001, 0b01110))
        for r in range(7):
            bits = g[r]
            for cb in range(5):
                if bits & (1 << (4 - cb)):
                    _rect(img, cx + cb * scale, y + r * scale,
                          cx + cb * scale + scale - 1, y + r * scale + scale - 1, color)
        cx += 6 * scale
    return cx

def _text_w(s, scale=2):
    return len(s) * 6 * scale

def _fmt_tick(v):
    if abs(v) >= 1000 or (abs(v) < 0.01 and v != 0):
        return f"{v:.0e}".upper().replace("E+", "E").replace("E-", "E-")
    if abs(v - round(v)) < 1e-12:
        return f"{int(round(v))}"
    return f"{v:g}"

def _nice_ticks(lo, hi, n=6):
    span = hi - lo
    if span <= 0:
        return [lo]
    step0 = span / max(n - 1, 1)
    mag = 10 ** np.floor(np.log10(step0))
    step = step0
    for m in (1, 2, 5, 10):
        step = m * mag
        if span / step <= n:
            break
    t0 = int(np.ceil(lo / step - 1e-9))
    ticks = [t0 * step + k * step for k in range(int(np.floor((hi - t0 * step) / step + 1e-9)) + 1)]
    return ticks

GRAY = (160, 160, 160)
DARK = (40, 40, 40)
BLUE = (72, 120, 168)
RED = (214, 95, 95)
GREEN = (88, 166, 88)
PURPLE = (188, 129, 220)

class _Axes:
    def __init__(self, img, x0, y0, x1, y1, title, xlabel, ylabel,
                 xlim, ylim, logy=False, logx=False):
        self.img, self.x0, self.y0, self.x1, self.y1 = img, x0, y0, x1, y1
        self.xlim, self.ylim, self.logy, self.logx = xlim, ylim, logy, logx
        self.ly0, self.ly1 = (np.log10(ylim[0]), np.log10(ylim[1])) if logy else (0, 0)
        self.lx0, self.lx1 = (np.log10(xlim[0]), np.log10(xlim[1])) if logx else (0, 0)
        _rect(img, x0, y0, x1, y1, (255, 255, 255))
        _line(img, x0, y0, x1, y0, DARK)
        _line(img, x0, y1, x1, y1, DARK)
        _line(img, x0, y0, x0, y1, DARK)
        _line(img, x1, y0, x1, y1, DARK)
        if title:
            _text(img, (x0 + x1 - _text_w(title, 2)) // 2, y0 - 26, title, DARK, 2)
        if xlabel:
            _text(img, (x0 + x1 - _text_w(xlabel, 2)) // 2, y1 + 10, xlabel, DARK, 2)
        if ylabel:
            _text(img, x0 - 8 - _text_w(ylabel, 2), y0 - 24, ylabel, DARK, 2)
        for tx in _nice_ticks(xlim[0], xlim[1], 7):
            px = self.tx(tx)
            _line(img, px, y1, px, y1 + 4, DARK)
            lab = _fmt_tick(tx)
            _text(img, px - _text_w(lab, 1) // 2, y1 + 6, lab, DARK, 1)
        if logy:
            for e in range(int(np.ceil(self.ly0)), int(np.floor(self.ly1)) + 1):
                py = self.ty(10 ** e)
                _line(img, x0 - 4, py, x0, py, DARK)
                _text(img, x0 - 8 - _text_w(f"1E{e}", 1), py - 4, f"1E{e}", DARK, 1)
                if 0 < e < self.ly1:
                    _line(img, x0, py, x1, py, (235, 235, 235))
        else:
            for ty in _nice_ticks(ylim[0], ylim[1], 6):
                py = self.ty(ty)
                _line(img, x0 - 4, py, x0, py, DARK)
                lab = _fmt_tick(ty)
                _text(img, x0 - 8 - _text_w(lab, 1), py - 4, lab, DARK, 1)
                _line(img, x0, py, x1, py, (235, 235, 235))
        if logx:
            for e in range(int(np.ceil(self.lx0)), int(np.floor(self.lx1)) + 1):
                px = self.tx(10 ** e)
                _line(img, px, y1, px, y1 + 4, DARK)
                _text(img, px - 8, y1 + 6, f"1E{e}", DARK, 1)

    def _t(self, v, lo, hi, a, b):
        return a + (b - a) * (v - lo) / (hi - lo)

    def tx(self, x):
        if self.logx:
            return self._t(np.log10(x), self.lx0, self.lx1, self.x0, self.x1)
        return self._t(x, self.xlim[0], self.xlim[1], self.x0, self.x1)

    def ty(self, y):
        if self.logy:
            return self._t(np.log10(y), self.ly1, self.ly0, self.y0, self.y1)
        return self._t(y, self.ylim[0], self.ylim[1], self.y0, self.y1)

    def polyline(self, xs, ys, color, thick=1):
        xs = np.asarray(xs, float)
        ys = np.asarray(ys, float)
        ok = np.isfinite(xs) & np.isfinite(ys) & (ys > 0 if self.logy else np.ones_like(xs, bool))
        xs, ys = xs[ok], ys[ok]
        if len(xs) < 2:
            return
        px = np.clip(np.array([self.tx(v) for v in xs]), self.x0, self.x1)
        py = np.clip(np.array([self.ty(v) for v in ys]), self.y0, self.y1)
        for i in range(len(px) - 1):
            _line(self.img, px[i], py[i], px[i + 1], py[i + 1], color, thick)

    def scatter(self, xs, ys, color, size=2):
        xs = np.asarray(xs, float)
        ys = np.asarray(ys, float)
        ok = np.isfinite(xs) & np.isfinite(ys) & (ys > 0 if self.logy else np.ones_like(xs, bool))
        for x, y in zip(xs[ok], ys[ok]):
            px, py = self.tx(x), self.ty(y)
            if self.x0 <= px <= self.x1 and self.y0 <= py <= self.y1:
                _rect(self.img, px - size // 2, py - size // 2,
                      px + size // 2, py + size // 2, color)

