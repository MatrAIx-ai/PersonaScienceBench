#!/usr/bin/env python3
"""Reproducible forensic audit of an anonymous HMC transition-kernel instance.

Reads every input from ./data (relative to this file) and writes every
artifact under ./results. Fully deterministic: no randomness beyond the
supplied transition streams.

Pipeline
--------
1. Implement the public target (funnel potential, warp chart, kinetic metric).
2. Audit all six anonymous candidate transitions from the observational
   bundle (energy RMSE over the step-size ladder, reversibility, local
   volume preservation, short-chain panel statistics) and score them with
   the public validity_score formula.
3. Map each candidate to one of the six canonical failure labels using an
   evidence-driven cascade, and select the valid kernel (argmax score).
4. Infer the selected transition map from the candidate evidence (kick-
   drift-kick leapfrog in sampler coordinates; verified against the bundle
   within the stated observational-perturbation tolerance) and replay the
   production and held-out streams with the schedule values.
5. Emit all required artifacts under results/.
"""
import csv
import json
from pathlib import Path

import numpy as np

BASE = Path(__file__).resolve().parent
DATA = BASE / "data"
RESULTS = BASE / "results"
RESULTS.mkdir(exist_ok=True)

# --------------------------------------------------------------------- inputs
manifest = json.loads((DATA / "target_manifest.json").read_text())
schedule = json.loads((DATA / "transition_schedule.json").read_text())

DIM = int(manifest["dimension"])
SIGMA_V = float(manifest["sigma_v"])
G = np.asarray(manifest["kinetic_metric"]["inverse_mass_matrix"], dtype=float)
M = np.asarray(manifest["sampler_chart"]["matrix"], dtype=float)
SHIFT = np.asarray(manifest["sampler_chart"]["shift"], dtype=float)
WARP = float(manifest["sampler_chart"]["warp_strength"])
WPHASE = np.asarray(manifest["sampler_chart"]["warp_phase"], dtype=float)
# M is NOT orthogonal (max |M M^T - I| ~ 0.46), so the inverse chart is
# q - shift = u @ inv(M).T  (verified to machine precision below).
MINV_T = np.linalg.inv(M).T
CAND_IDS = [str(c) for c in manifest["public_candidate_ids"]]

bundle = np.load(DATA / "candidate_transition_bundle.npz")
panel = np.load(DATA / "candidate_chain_panel.npz")

q_init = np.load(DATA / "initial_latent_states.npy")
p_stream = np.load(DATA / "transition_momenta.npy")
u_stream = np.load(DATA / "transition_uniforms.npy")
hq_init = np.load(DATA / "holdout_initial_latent_states.npy")
hp_stream = np.load(DATA / "holdout_transition_momenta.npy")
hu_stream = np.load(DATA / "holdout_transition_uniforms.npy")

with open(DATA / "profile_bins.csv") as fh:
    bin_rows = list(csv.DictReader(fh))
BIN_LEFT = np.array([float(r["v_left"]) for r in bin_rows])
BIN_RIGHT = np.array([float(r["v_right"]) for r in bin_rows])
BIN_IDS = [int(r["bin_id"]) for r in bin_rows]

# ---------------------------------------------------------------- target math
def to_centered(q):
    """Sampler q (12,) -> centered (12,) per the public chart convention."""
    u = (q - SHIFT) @ M.T
    c = u.copy()
    c[1:] += WARP * np.sin(u[0] + WPHASE)
    return c

def to_centered_batch(q):
    u = (q - SHIFT) @ M.T
    c = u.copy()
    c[:, 1:] += WARP * np.sin(u[:, :1] + WPHASE)
    return c

def to_sampler(c):
    u = c.copy()
    u[1:] -= WARP * np.sin(c[0] + WPHASE)
    return u @ MINV_T + SHIFT

def potential(q):
    c = to_centered(q)
    v = c[0]
    x = c[1:]
    return 0.5 * (v / SIGMA_V) ** 2 + 0.5 * (DIM - 1) * v + 0.5 * np.exp(-v) * float(x @ x)

def grad_potential(q):
    c = to_centered(q)
    v = c[0]
    x = c[1:]
    s2 = float(x @ x)
    gc = np.empty(DIM)
    gc[0] = v / SIGMA_V ** 2 + 0.5 * (DIM - 1) - 0.5 * np.exp(-v) * s2
    gc[1:] = np.exp(-v) * x
    u = (q - SHIFT) @ M.T
    gu = gc.copy()
    gu[0] += WARP * float(gc[1:] @ np.cos(u[0] + WPHASE))
    return gu @ M

def hamiltonian(q, p):
    return potential(q) + 0.5 * float(p @ G @ p)

def leapfrog(q, p, h, n_steps):
    """Kick-drift-kick leapfrog in sampler coordinates.

    p_{k+1/2} = p_k - (h/2) gradU(q_k);  q_{k+1} = q_k + h G p_{k+1/2};
    p_{k+1} = p_{k+1/2} - (h/2) gradU(q_{k+1}).  Returns (q*, p*).
    This is the map inferred from the candidate evidence (see audit below).
    """
    q = q.copy()
    p = p.copy()
    p = p - 0.5 * h * grad_potential(q)
    for _ in range(n_steps - 1):
        q = q + h * (G @ p)
        p = p - h * grad_potential(q)
    q = q + h * (G @ p)
    p = p - 0.5 * h * grad_potential(q)
    return q, p

# sanity: chart round-trip and gradient (finite differences)
_q = q_init[0]
assert np.abs(to_sampler(to_centered(_q)) - _q).max() < 1e-10
_eps = 1e-7
_fd = np.array([
    (potential(_q + _eps * np.eye(DIM)[j]) - potential(_q - _eps * np.eye(DIM)[j])) / (2 * _eps)
    for j in range(DIM)
])
assert np.abs(grad_potential(_q) - _fd).max() < 1e-5

# ------------------------------------------------------- diagnostics helpers
def split_rhat(chains):
    """Standard split-Rhat: halve each chain, then combine."""
    splits = []
    for c in chains:
        c = np.asarray(c, dtype=float)
        half = len(c) // 2
        splits.append(c[:half])
        splits.append(c[half:2 * half])
    m = len(splits)
    n = len(splits[0])
    means = np.array([s.mean() for s in splits])
    variances = np.array([s.var(ddof=1) for s in splits])
    W = variances.mean()
    if W <= 0:
        return 1.0
    B = n * means.var(ddof=1)
    var_plus = (n - 1) / n * W + B / n
    return float(np.sqrt(var_plus / W))

def geyer_ess(x):
    """Initial-positive-sequence ESS (Geyer) for one sequence."""
    x = np.asarray(x, dtype=float).ravel()
    n = len(x)
    xc = x - x.mean()
    denom = float(xc @ xc)
    if denom <= 0:
        return 1.0
    f = np.fft.fft(xc, n=2 * n)
    acov = np.real(np.fft.ifft(f * f.conj()))[:n] / n
    rho = acov / acov[0]
    pair_sum = 0.0
    k = 0
    while k + 2 <= n - 1:
        s = rho[k + 1] + rho[k + 2]
        if s < 0:
            break
        pair_sum += s
        k += 2
    factor = 1.0 + pair_sum
    if factor <= 0:
        return 1.0
    return float(n / factor)

def linear_score(error, full, zero):
    if error <= full:
        return 1.0
    if error >= zero:
        return 0.0
    return (zero - error) / (zero - full)

# ------------------------------------------------------------ candidate audit
ladder = np.asarray(bundle["step_size_ladder"], dtype=float)
base_idx = int(np.argmin(np.abs(ladder - float(schedule["step_size"]))))
assert np.abs(ladder[base_idx] - float(schedule["step_size"])) < 1e-12  # exact rung
probe_q = np.asarray(bundle["probe_states"], dtype=float)
probe_p = np.asarray(bundle["probe_momenta"], dtype=float)
n_probe = len(probe_q)
H0 = np.array([hamiltonian(probe_q[k], probe_p[k]) for k in range(n_probe)])

audit = {}
for i, cid in enumerate(CAND_IDS):
    rmse_by_step = []
    for l in range(len(ladder)):
        Hp = np.array([
            hamiltonian(bundle["proposal_states"][i, l][k], bundle["proposal_momenta"][i, l][k])
            for k in range(n_probe)
        ])
        rmse_by_step.append(float(np.sqrt(np.mean((Hp - H0) ** 2))))
    energy_rmse = rmse_by_step[base_idx]
    energy_slope = float(np.polyfit(np.log(ladder), np.log(rmse_by_step), 1)[0])

    rev_state = np.asarray(bundle["reverse_states"][i, base_idx], dtype=float)
    rev_mom = np.asarray(bundle["reverse_momenta"][i, base_idx], dtype=float)
    rev_res = np.linalg.norm(rev_state - probe_q, axis=1) + np.linalg.norm(rev_mom + probe_p, axis=1)
    reverse_p95 = float(np.percentile(rev_res, 95))

    X = np.asarray(bundle["volume_input"], dtype=float)
    Y = np.asarray(bundle["volume_output"][i], dtype=float)
    Xa = np.hstack([X, np.ones((len(X), 1))])
    A, _, _, _ = np.linalg.lstsq(Xa, Y, rcond=None)
    signed_logdet = float(np.linalg.slogdet(A[: DIM * 2, : DIM * 2])[1])
    volume_logdet_abs = abs(signed_logdet)

    acceptance_rate = float(np.asarray(panel["panel_accepted"][i], dtype=float).mean())
    vcol = np.asarray(panel["panel_centered_samples"][i, :, :, 0], dtype=float)
    panel_mean_v = float(vcol.mean())
    panel_var_v = float(vcol.var(ddof=1))
    panel_rhat_v = split_rhat([vcol[c] for c in range(vcol.shape[0])])
    panel_ess_v = geyer_ess(vcol.ravel())  # pooled 3-chain sequence (660)

    validity = (
        0.24 * linear_score(energy_rmse, 0.01, 0.18)
        + 0.24 * linear_score(reverse_p95, 1e-8, 5e-3)
        + 0.20 * linear_score(volume_logdet_abs, 1e-5, 0.08)
        + 0.16 * linear_score(abs(panel_var_v - SIGMA_V ** 2) / SIGMA_V ** 2, 0.08, 0.55)
        + 0.16 * linear_score(abs(0.82 - acceptance_rate), 0.25, 0.80)
    )
    audit[cid] = dict(
        energy_rmse=energy_rmse, energy_slope=energy_slope, reverse_p95=reverse_p95,
        volume_logdet_abs=volume_logdet_abs, signed_logdet=signed_logdet,
        acceptance_rate=acceptance_rate, panel_mean_v=panel_mean_v,
        panel_var_v=panel_var_v, panel_rhat_v=panel_rhat_v, panel_ess_v=panel_ess_v,
        validity_score=float(validity),
        panel_dh_mean=float(np.asarray(panel["panel_delta_h"][i], dtype=float).mean()),
    )

with open(RESULTS / "kernel_audit.csv", "w", newline="") as fh:
    w = csv.writer(fh)
    w.writerow(manifest["audit_columns"])
    for cid in CAND_IDS:
        a = audit[cid]
        w.writerow([
            cid, f"{a['energy_rmse']:.10g}", f"{a['energy_slope']:.10g}",
            f"{a['reverse_p95']:.10g}", f"{a['volume_logdet_abs']:.10g}",
            f"{a['acceptance_rate']:.10g}", f"{a['panel_mean_v']:.10g}",
            f"{a['panel_var_v']:.10g}", f"{a['panel_ess_v']:.10g}",
            f"{a['panel_rhat_v']:.10g}", f"{a['validity_score']:.10g}",
        ])

# --------------------------------------------------------------- failure modes
order = sorted(CAND_IDS, key=lambda c: -audit[c]["validity_score"])
valid_id = order[0]
rest = order[1:]
labels = {valid_id: "valid_transition"}

# coordinate_mismatch: reversible + volume-preserving but large energy drift
cand = [c for c in rest if audit[c]["reverse_p95"] < 1e-3 and audit[c]["volume_logdet_abs"] < 1e-3]
if cand:
    pick = max(cand, key=lambda c: audit[c]["energy_rmse"])
    labels[pick] = "coordinate_mismatch"
    rest.remove(pick)

# volume_loss: strong phase-space contraction (signed logdet << 0)
cand = [c for c in rest if audit[c]["signed_logdet"] < -1.0]
if cand:
    pick = min(cand, key=lambda c: audit[c]["signed_logdet"])
    labels[pick] = "volume_loss"
    rest.remove(pick)

# energy_drift: exploding / systematically large energy drift
pick = max(rest, key=lambda c: audit[c]["energy_rmse"])
labels[pick] = "energy_drift"
rest.remove(pick)

# remaining pair: terminal_imbalance (small O(h) reversibility error, ~zero
# mean dH bias) vs delayed_response (larger reversibility error, systematic
# positive mean dH bias)
a, b = sorted(rest, key=lambda c: audit[c]["reverse_p95"])
labels[a] = "terminal_imbalance"
labels[b] = "delayed_response"

with open(RESULTS / "failure_modes.json", "w") as fh:
    json.dump({cid: labels[cid] for cid in CAND_IDS}, fh, indent=2)

selected = dict(
    candidate_id=valid_id,
    validity_score=audit[valid_id]["validity_score"],
    inferred_map=(
        "kick-drift-kick leapfrog in sampler coordinates with h = schedule step_size, "
        "n_steps = schedule integration_steps, drift q += h * G @ p, kick p -= h * grad_U(q); "
        "Metropolis accept/reject against the supplied uniforms"
    ),
    evidence={
        k: audit[valid_id][k]
        for k in ("energy_rmse", "energy_slope", "reverse_p95", "volume_logdet_abs",
                  "acceptance_rate", "panel_rhat_v", "panel_ess_v")
    },
)
with open(RESULTS / "selected_kernel.json", "w") as fh:
    json.dump(selected, fh, indent=2)

# -------------------------------------------------------------------- replay
def replay(q_start, p_stream, u_stream, h, n_steps):
    n_ch, T, _ = p_stream.shape
    delta_h = np.zeros((n_ch, T))
    accept_prob = np.zeros((n_ch, T))
    accepted = np.zeros((n_ch, T), dtype=bool)
    accepted_latent = np.zeros((n_ch, T, DIM))
    proposal_latent = np.zeros((n_ch, T, DIM))
    q = q_start.copy()
    traj_q = np.empty((n_ch, T + 1, DIM))
    traj_q[:, 0] = q
    for c in range(n_ch):
        for t in range(T):
            p = p_stream[c, t]
            qp, pp = leapfrog(q[c], p, h, n_steps)
            dH = hamiltonian(qp, pp) - hamiltonian(q[c], p)
            prob = 1.0 if dH <= 0.0 else float(np.exp(-dH))
            acc = bool(u_stream[c, t] < prob)
            delta_h[c, t] = dH
            accept_prob[c, t] = prob
            accepted[c, t] = acc
            proposal_latent[c, t] = qp
            if acc:
                q[c] = qp
            accepted_latent[c, t] = q[c]
            traj_q[c, t + 1] = q[c]
    return dict(delta_h=delta_h, accept_prob=accept_prob, accepted=accepted,
                accepted_latent=accepted_latent, proposal_latent=proposal_latent,
                traj_q=traj_q, final_q=q)

n_chains = int(schedule["n_chains"])
warmup = int(schedule["warmup_transitions"])
kept_n = int(schedule["kept_transitions"])
total = int(schedule["total_transitions"])
h_prod = float(schedule["step_size"])
L_prod = int(schedule["integration_steps"])
audit_n = int(schedule["audit_transitions"])

prod = replay(q_init, p_stream, u_stream, h_prod, L_prod)
assert prod["traj_q"].shape == (n_chains, total + 1, DIM)

latent_samples = prod["traj_q"][:, warmup:total, :]          # [4, 900, 12]
np.save(RESULTS / "latent_samples.npy", latent_samples)
samples = to_centered_batch(latent_samples.reshape(-1, DIM)).reshape(n_chains, kept_n, DIM)
np.save(RESULTS / "samples.npy", samples)

np.savez(
    RESULTS / "transition_audit.npz",
    accepted_latent=prod["accepted_latent"][:, :audit_n, :],
    proposal_latent=prod["proposal_latent"][:, :audit_n, :],
    delta_h=prod["delta_h"][:, :audit_n],
    accept_prob=prod["accept_prob"][:, :audit_n],
    accepted=prod["accepted"][:, :audit_n],
)

ho_chains = int(schedule["holdout_chains"])
ho_total = int(schedule["holdout_transitions"])
h_ho = float(schedule["holdout_step_size"])
L_ho = int(schedule["holdout_integration_steps"])
ho_audit_n = int(schedule["holdout_audit_transitions"])

ho = replay(hq_init, hp_stream, hu_stream, h_ho, L_ho)
np.savez(
    RESULTS / "holdout_transition_audit.npz",
    accepted_latent=ho["accepted_latent"][:, :ho_audit_n, :],
    proposal_latent=ho["proposal_latent"][:, :ho_audit_n, :],
    delta_h=ho["delta_h"][:, :ho_audit_n],
    accept_prob=ho["accept_prob"][:, :ho_audit_n],
    accepted=ho["accepted"][:, :ho_audit_n],
)
np.save(RESULTS / "holdout_terminal_states.npy", ho["final_q"])

with open(RESULTS / "energy_diagnostics.csv", "w", newline="") as fh:
    w = csv.writer(fh)
    w.writerow(["chain_id", "acceptance_rate", "mean_abs_delta_h", "p95_abs_delta_h", "max_abs_delta_h"])
    for c in range(n_chains):
        ad = np.abs(prod["delta_h"][c])
        w.writerow([
            c,
            f"{prod['accepted'][c].mean():.10g}",
            f"{ad.mean():.10g}",
            f"{np.percentile(ad, 95):.10g}",
            f"{ad.max():.10g}",
        ])

# ------------------------------------------------------------ funnel profile
v_kept = samples[:, :, 0].ravel()
radius2_kept = (samples[:, :, 1:] ** 2).sum(axis=2).ravel()
n_kept = v_kept.size
with open(RESULTS / "funnel_profile.csv", "w", newline="") as fh:
    w = csv.writer(fh)
    w.writerow(["bin_id", "v_left", "v_right", "count", "fraction", "mean_v", "mean_radius2", "expected_radius2"])
    for bid, vl, vr in zip(BIN_IDS, BIN_LEFT, BIN_RIGHT):
        mask = (v_kept >= vl) & (v_kept < vr)
        count = int(mask.sum())
        fraction = count / n_kept
        if count > 0:
            mean_v = float(v_kept[mask].mean())
            mean_r2 = float(radius2_kept[mask].mean())
            expected_r2 = float((DIM - 1) * np.exp(v_kept[mask]).mean())
            w.writerow([bid, f"{vl:.10g}", f"{vr:.10g}", count, f"{fraction:.10g}",
                        f"{mean_v:.10g}", f"{mean_r2:.10g}", f"{expected_r2:.10g}"])
        else:
            w.writerow([bid, f"{vl:.10g}", f"{vr:.10g}", count, f"{fraction:.10g}", "", "", ""])

# ------------------------------------------------------------------ diagnostics
z = np.empty_like(samples)
z[:, :, 0] = samples[:, :, 0] / SIGMA_V
z[:, :, 1:] = np.exp(-samples[:, :, 0:1] / 2.0) * samples[:, :, 1:]
z_flat = z.reshape(-1, DIM)
r2_flat = radius2_kept
v_flat = v_kept

diag = dict(
    mean_v=float(v_flat.mean()),
    var_v=float(v_flat.var(ddof=1)),
    mean_radius2=float(r2_flat.mean()),
    split_rhat_v=split_rhat([samples[c, :, 0] for c in range(n_chains)]),
    ess_v=geyer_ess(v_flat),
    split_rhat_radius2=split_rhat([(samples[c, :, 1:] ** 2).sum(axis=1) for c in range(n_chains)]),
    ess_radius2=geyer_ess(r2_flat),
    overall_acceptance_rate=float(prod["accepted"].mean()),
    chain_acceptance_rates=[float(prod["accepted"][c].mean()) for c in range(n_chains)],
    mean_abs_delta_h=float(np.abs(prod["delta_h"]).mean()),
    p95_abs_delta_h=float(np.percentile(np.abs(prod["delta_h"]), 95)),
    max_abs_delta_h=float(np.abs(prod["delta_h"]).max()),
    latent_mean_abs_max=float(np.abs(z_flat.mean(axis=0)).max()),
    latent_var_abs_max=float(np.abs(z_flat.var(axis=0, ddof=1) - 1.0).max()),
    left_tail_prob_v_lt_minus5=float(np.mean(v_flat < -5.0)),
    right_tail_prob_v_gt_5=float(np.mean(v_flat > 5.0)),
)
with open(RESULTS / "diagnostics.json", "w") as fh:
    json.dump(diag, fh, indent=2)

