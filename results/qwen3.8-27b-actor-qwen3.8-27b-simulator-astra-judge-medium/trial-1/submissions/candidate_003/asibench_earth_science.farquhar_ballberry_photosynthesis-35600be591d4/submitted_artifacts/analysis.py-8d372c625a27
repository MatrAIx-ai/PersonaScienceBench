#!/usr/bin/env python3
"""
Leaf Physiological Response Reconstruction
------------------------------------------
Coupled land-surface (CLM/Noah-MP) Farquhar (C3) / Collatz (C4) photosynthesis
with Ball-Berry stomatal conductance, closed through a gas-diffusion chain to a
common, self-consistent internal CO2 (Ci) fixed point.

Outputs (under results/):
  leaf_fluxes.csv      one row per forcing.csv row (sun + shade)
  case_convergence.csv one row per test_cases.json record
  diurnal.png          diurnal A and rs for sunlit & shaded leaves

The scientific convention follows the task brief exactly. The figure is drawn
with a self-contained PNG writer (no external plotting dependency) so the
artifact is produced identically in any environment.
"""
import json
import os
import struct
import zlib
import numpy as np
import pandas as pd

# ----------------------------------------------------------------------------
# Physical constants and brief-specified conventions
# ----------------------------------------------------------------------------
R = 8.314                 # universal gas constant, J mol^-1 K^-1
Kc25 = 30.0               # Pa   (brief)
Ko25 = 30000.0            # Pa   (brief)
Q10_Kc = 2.1              # -    (brief Q10 tuple (2.1, 1.2, 2.4))
Q10_Ko = 1.2              # -
APAR_FACT = 4.6           # APAR = 4.6 * PAR (brief, no extra absorptance)
RD_FRAC = 0.015           # Rd = 0.015 * Vcmax (brief)
TOL_CI = 1e-6             # Pa   fixed-point tolerance on |Ci_new - Ci|
MAXIT = 200               # safety cap on iterations
PAR_NIGHT = 1e-6          # W m^-2 ; below this -> night branch

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "data")
OUT = os.path.join(HERE, "results")
os.makedirs(OUT, exist_ok=True)

with open(os.path.join(DATA, "leaf_params.json")) as f:
    lp = json.load(f)
with open(os.path.join(DATA, "test_cases.json")) as f:
    tc = json.load(f)
df = pd.read_csv(os.path.join(DATA, "forcing.csv"))

pathway = lp["pathway"]            # "C4" (explicit in the data)
v25     = lp["vcmax25"]
m_bb    = lp["bb_slope"]           # Ball-Berry slope  (m)
b0      = lp["bb_intercept"]       # Ball-Berry intercept (b0) -- NOT scaled by btran
aq      = lp["alpha_q"]
nf      = lp["n_factor"]

# ----------------------------------------------------------------------------
# Temperature / gas responses
# ----------------------------------------------------------------------------
def esat(T_K):
    """Saturation vapour pressure (Pa), CLM/Buck form."""
    Tc = T_K - 273.15
    return 611.0 * np.exp(17.502 * Tc / (240.97 + Tc))

def vcmax_T(T_K, v25):
    """CLM/Noah-MP Vcmax(T) with high-temperature inhibition (transcribed exactly)."""
    Tc = T_K - 273.16
    Tk = Tc + 273.16                       # = T_K
    return (v25 * 2.4 ** ((Tc - 25.0) / 10.0)
            / (1.0 + np.exp((-2.2e5 + 710.0 * Tk) / (R * Tk))))

def kc_T(T_K):
    return Kc25 * Q10_Kc ** ((T_K - 273.16 - 25.0) / 10.0)

def ko_T(T_K):
    return Ko25 * Q10_Ko ** ((T_K - 273.16 - 25.0) / 10.0)

def gamma_star(T_K, o2_pa):
    """C3 CO2 compensation point (Pa). CLM-consistent: 0.5*(Kc/Ko)*O2 with O2=o2_pa
    (o2_pa ~= 0.21*p_atm; the brief's trailing *0.21 is the O2 mole fraction already
    embedded in o2_pa). Unused for the C4 pathway on this dataset."""
    return 0.5 * (kc_T(T_K) / ko_T(T_K)) * o2_pa

# ----------------------------------------------------------------------------
# Photosynthesis (both branches; selected by pathway)
# ----------------------------------------------------------------------------
def photosynthesis(Ci, PAR, T_K, p, o2_pa, pathway, Vc, Rd, aq):
    """Net assimilation A (umol CO2 m^-2 s^-1) at internal CO2 Ci (Pa)."""
    APAR = APAR_FACT * PAR
    if pathway == "C4":
        Wc = Vc
        Wj = aq * APAR
        We = 4000.0 * Vc * Ci / p
    else:  # C3 (Farquhar)
        Kc, Ko, Gs = kc_T(T_K), ko_T(T_K), gamma_star(T_K, o2_pa)
        Wc = Vc * (Ci - Gs) / (Ci + Kc * (1.0 + o2_pa / Ko))
        J = aq * APAR
        Wj = J * (Ci - Gs) / (4.0 * Ci + 8.0 * Gs)
        We = 0.5 * Vc
    return min(Wc, Wj, We) - Rd

# ----------------------------------------------------------------------------
# Coupled fixed-point solve for one leaf (one canopy, one forcing row)
# ----------------------------------------------------------------------------
def solve_leaf(PAR, T_K, p, ca, o2_pa, vpd, rb, btran, ci_init,
               pathway, v25, nf, m_bb, b0, aq, tol=TOL_CI, maxit=MAXIT):
    """Return (A, gs, rs, cs, Ci, n_iter, night_flag) at a self-consistent state.

    Light : iterate Ci -> A -> cs -> gs -> rs -> Ci_new to a fixed point.
    Night : respiratory assimilation (A=-Rd) + intercept conductance (gs=b0),
            with cs/Ci closed through the same diffusion chain (finite at PAR=0).
    """
    cf = p / (R * T_K)                                  # mol m^-3
    hs = min(max(1.0 - vpd / esat(T_K), 0.25), 1.0)     # surface RH
    Vc = vcmax_T(T_K, v25) * nf * btran                 # effective capacity
    Rd = RD_FRAC * Vc

    if PAR < PAR_NIGHT:                                 # ---- night branch ----
        A = -Rd
        A_mol = A * 1e-6
        gs = b0
        rs = cf / gs
        cs = ca - 1.37 * rb * A_mol / cf * p
        Ci = cs - 1.65 * rs * A_mol / cf * p
        return A, gs, rs, cs, Ci, 0, True

    # ---- light branch: coupled fixed point on Ci ----
    Ci = ci_init
    for it in range(1, maxit + 1):
        A = photosynthesis(Ci, PAR, T_K, p, o2_pa, pathway, Vc, Rd, aq)
        A_mol = A * 1e-6
        cs = ca - 1.37 * rb * A_mol / cf * p
        gs = m_bb * A_mol * hs / max(cs, 1e-6) * p + b0
        rs = cf / gs
        Ci_new = cs - 1.65 * rs * A_mol / cf * p
        if abs(Ci_new - Ci) < tol:
            Ci = Ci_new
            A = photosynthesis(Ci, PAR, T_K, p, o2_pa, pathway, Vc, Rd, aq)
            A_mol = A * 1e-6
            cs = ca - 1.37 * rb * A_mol / cf * p
            gs = m_bb * A_mol * hs / max(cs, 1e-6) * p + b0
            rs = cf / gs
            return A, gs, rs, cs, Ci, it, False
        Ci = Ci_new
    A = photosynthesis(Ci, PAR, T_K, p, o2_pa, pathway, Vc, Rd, aq)
    A_mol = A * 1e-6
    cs = ca - 1.37 * rb * A_mol / cf * p
    gs = m_bb * A_mol * hs / max(cs, 1e-6) * p + b0
    rs = cf / gs
    return A, gs, rs, cs, Ci, maxit, False

# ----------------------------------------------------------------------------
# 1) Diurnal forcing -> leaf_fluxes.csv
# ----------------------------------------------------------------------------
recs = []
ci_sun_prev = 0.5 * df["co2_pa"].iloc[0]
ci_shade_prev = 0.5 * df["co2_pa"].iloc[0]
for i in range(len(df)):
    r = df.iloc[i]
    T, p, ca, o2 = r.t_air_K, r.p_atm_Pa, r.co2_pa, r.o2_pa
    vpd, rb, bt = r.vpd_Pa, r.rb_sm, r.btran
    A_s, gs_s, rs_s, cs_s, Ci_s, it_s, _ = solve_leaf(
        r.par_sun_wm2, T, p, ca, o2, vpd, rb, bt, ci_sun_prev, pathway, v25, nf, m_bb, b0, aq)
    A_sh, gs_sh, rs_sh, cs_sh, Ci_sh, it_sh, _ = solve_leaf(
        r.par_shade_wm2, T, p, ca, o2, vpd, rb, bt, ci_shade_prev, pathway, v25, nf, m_bb, b0, aq)
    recs.append(dict(time_hr=r.time_hr, A_sun=A_s, A_shade=A_sh,
                     rs_sun=rs_s, rs_shade=rs_sh, ci_sun=Ci_s, ci_shade=Ci_sh,
                     gs_sun=gs_s, gs_shade=gs_sh))
    ci_sun_prev, ci_shade_prev = Ci_s, Ci_sh

leaf_df = pd.DataFrame(recs, columns=["time_hr", "A_sun", "A_shade",
                                      "rs_sun", "rs_shade", "ci_sun", "ci_shade",
                                      "gs_sun", "gs_shade"])
leaf_df.to_csv(os.path.join(OUT, "leaf_fluxes.csv"), index=False)

# ----------------------------------------------------------------------------
# 2) Test cases -> case_convergence.csv   (advanced from ci_init_pa with par_sun)
# ----------------------------------------------------------------------------
crecs = []
for c in tc:
    r = df.iloc[c["forcing_index"]]
    A, gs, rs, cs, Ci, it, night = solve_leaf(
        r.par_sun_wm2, r.t_air_K, r.p_atm_Pa, r.co2_pa, r.o2_pa,
        r.vpd_Pa, r.rb_sm, r.btran, c["ci_init_pa"], pathway, v25, nf, m_bb, b0, aq)
    crecs.append(dict(case_id=c["case_id"], ci_init_pa=c["ci_init_pa"],
                      ci_final_pa=Ci, A_final=A, rs_final=rs, n_iterations=it))
case_df = pd.DataFrame(crecs, columns=["case_id", "ci_init_pa", "ci_final_pa",
