def text_w(s, scale=1):
    return len(s) * 6 * scale - scale

def draw_text(img, x, y, s, color, scale=1):
    H, W, _ = img.shape
    cx = x
    for ch in s.upper():
        g = FONT.get(ch, FONT[' '])
        for row in range(7):
            bits = g[row]
            for col in range(5):
                if (bits >> (4 - col)) & 1:
                    x0, y0 = cx + col * scale, y + row * scale
                    xa, xb = max(0, x0), min(W, x0 + scale)
                    ya, yb = max(0, y0), min(H, y0 + scale)
                    if xa < xb and ya < yb:
                        img[ya:yb, xa:xb] = color
        cx += 6 * scale

def draw_curve(img, pts, color, thick=2, dashed=False, dash=10, gap=7):
    H, W, _ = img.shape
    r = max(1, thick // 2)
    run = 0.0
    for (x0, y0), (x1, y1) in zip(pts[:-1], pts[1:]):
        dx, dy = x1 - x0, y1 - y0
        segL = float(np.hypot(dx, dy))
        n = int(segL) or 1
        for i in range(n + 1):
            d = segL * i / n
            if not (dashed and ((run + d) % (dash + gap)) >= dash):
                t = i / n
                x, y = int(round(x0 + dx * t)), int(round(y0 + dy * t))
                img[max(0, y-r):min(H, y+r+1), max(0, x-r):min(W, x+r+1)] = color
        run += segL

def draw_hline(img, y, x0, x1, color, thick=1):
    img[max(0, y-thick//2):min(img.shape[0], y+thick//2+1), max(0, x0):min(img.shape[1], x1+1)] = color
def draw_vline(img, x, y0, y1, color, thick=1):
    img[max(0, y0):min(img.shape[0], y1+1), max(0, x-thick//2):min(img.shape[1], x+thick//2+1)] = color

def nice_ticks(lo, hi, n=6):
    span = hi - lo
    if span <= 0:
        return np.array([lo])
    step0 = span / n
    mag = 10 ** int(np.floor(np.log10(step0)))
    step = 10 * mag
    for m in (1, 2, 5, 10):
        if span / (m * mag) <= n:
            step = m * mag
            break
    start = int(np.ceil(lo / step)) * step
    return np.arange(start, hi + 1e-9, step)

def save_png(path, img):
    H, W, _ = img.shape
    raw = b''.join(b'\x00' + img[y].astype(np.uint8).tobytes() for y in range(H))
    def chunk(typ, data):
        return (struct.pack('>I', len(data)) + typ + data
                + struct.pack('>I', zlib.crc32(typ + data) & 0xffffffff))
    ihdr = struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0)
    with open(path, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n')
        f.write(chunk(b'IHDR', ihdr))
        f.write(chunk(b'IDAT', zlib.compress(raw, 9)))
        f.write(chunk(b'IEND', b''))

def render_diurnal_png(path, leaf_df):
    W, H = 1000, 690
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    BLACK = (35, 35, 35); GRID = (214, 214, 214)
    RED = (200, 30, 30); ORG = (230, 140, 30)

    t = leaf_df["time_hr"].values
    panels = [
        dict(y0=72,  y1=300, data=[leaf_df["A_sun"].values, leaf_df["A_shade"].values],
             label="A  (UMOL CO2 M-2 S-1)", lo=None),
        dict(y0=402, y1=624, data=[leaf_df["rs_sun"].values, leaf_df["rs_shade"].values],
             label="RS  (S M-1)", lo=0.0),
    ]
    for pn in panels:
        allv = np.concatenate(pn["data"])
        pn["lo"] = float(pn["lo"]) if pn["lo"] is not None else float(np.floor(allv.min()) - 1)
        pn["hi"] = float(np.ceil(allv.max()) + 1)
    x0, x1 = 100, 960
    tx = (float(t.min()), float(t.max()))

    def X(v):
        return x0 + (v - tx[0]) / (tx[1] - tx[0]) * (x1 - x0)
    def Y(v, pn):
        return pn["y1"] - (v - pn["lo"]) / (pn["hi"] - pn["lo"]) * (pn["y1"] - pn["y0"])

    tt = "DIURNAL LEAF RESPONSE  (PATHWAY=%s, %d HOURS)" % (pathway, len(leaf_df))
    draw_text(img, max(4,(W - text_w(tt, 2)) // 2), 22, tt, BLACK, 2)

    for pn in panels:
        lo, hi = pn["lo"], pn["hi"]
        draw_hline(img, pn["y0"], x0, x1, BLACK, 2)
        draw_hline(img, pn["y1"], x0, x1, BLACK, 2)
        draw_vline(img, x0, pn["y0"], pn["y1"], BLACK, 2)
        draw_vline(img, x1, pn["y0"], pn["y1"], BLACK, 2)
        for tv in nice_ticks(lo, hi, 5):
            yy = int(round(Y(tv, pn)))
            draw_hline(img, yy, x0, x1, GRID, 1)
            draw_vline(img, x0, yy-4, yy+4, BLACK, 1)
            lbl = ("%.0f" % tv) if abs(tv) >= 1 else ("%.1f" % tv)
            draw_text(img, x0 - text_w(lbl, 1) - 8, yy - 3, lbl, BLACK, 1)
        for tv in nice_ticks(tx[0], tx[1], 7):
            draw_vline(img, int(round(X(tv))), pn["y0"], pn["y1"], GRID, 1)
        draw_curve(img, [(X(a), Y(b, pn)) for a, b in zip(t, pn["data"][0])], RED, 2)
        draw_curve(img, [(X(a), Y(b, pn)) for a, b in zip(t, pn["data"][1])], ORG, 2, dashed=True)
        draw_text(img, x0, pn["y0"] - 24, pn["label"], BLACK, 1)
        ly = pn["y0"] + 14
        draw_curve(img, [(x1-150, ly), (x1-112, ly)], RED, 3)
        draw_text(img, x1-104, ly-4, "SUNLIT", BLACK, 1)
        draw_curve(img, [(x1-150, ly+18), (x1-112, ly+18)], ORG, 3, dashed=True)
        draw_text(img, x1-104, ly+14, "SHADED", BLACK, 1)

    bp = panels[1]
    for tv in nice_ticks(tx[0], tx[1], 7):
        xx = int(round(X(tv)))
        draw_vline(img, xx, bp["y1"], bp["y1"] + 6, BLACK, 1)
        lbl = "%.0f" % tv
        draw_text(img, xx - text_w(lbl, 1)//2, bp["y1"] + 10, lbl, BLACK, 1)
    draw_text(img, max(4,(W - text_w("TIME (HR)", 2)) // 2), bp["y1"] + 40, "TIME (HR)", BLACK, 2)

    save_png(path, img)

