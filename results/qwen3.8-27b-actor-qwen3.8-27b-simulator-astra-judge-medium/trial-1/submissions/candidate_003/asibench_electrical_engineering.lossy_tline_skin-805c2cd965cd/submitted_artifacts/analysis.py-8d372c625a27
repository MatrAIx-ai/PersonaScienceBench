#!/usr/bin/env python3
"""
Transmission-Line Target Prediction
Model: H(f) = exp(-(alpha(f) + j*omega*tau) * l)
  tau = beta/omega (freq-independent delay per unit length)
  alpha(f) = attenuation per unit length
  Interpolated in 2D from 8 calibration lines
"""
import numpy as np
import pandas as pd
from pathlib import Path

def precompute_tps(x, y):
    n = len(x)
    x_min, x_max = x.min(), x.max()
    y_min, y_max = y.min(), y.max()
    x_range = max(x_max - x_min, 1e-10)
    y_range = max(y_max - y_min, 1e-10)
    xn = (x - x_min) / x_range
    yn = (y - y_min) / y_range
    M = np.zeros((n, n))
    for i in range(n):
        for j in range(n):
            r2 = (xn[i]-xn[j])**2 + (yn[i]-yn[j])**2
            if r2 > 1e-30:
                M[i,j] = r2 * np.log(r2)
    P = np.column_stack([np.ones(n), xn, yn])
    size = n + 3
    A = np.zeros((size, size))
    A[:n,:n] = M
    A[:n,n:] = P
    A[n:,:n] = P.T
    A_inv = np.linalg.inv(A)
    return {"A_inv": A_inv, "x_min": x_min, "x_range": x_range,
            "y_min": y_min, "y_range": y_range, "xn": xn, "yn": yn, "n": n}

def eval_tps(x_test, y_test, tps, z_train):
    n = tps["n"]
    b = np.zeros(n+3)
    b[:n] = z_train
    coeffs = tps["A_inv"] @ b
    c = coeffs[:n]
    p = coeffs[n:]
    x_test = np.atleast_1d(np.asarray(x_test, dtype=float))
    y_test = np.atleast_1d(np.asarray(y_test, dtype=float))
    xn_t = (x_test - tps["x_min"]) / tps["x_range"]
    yn_t = (y_test - tps["y_min"]) / tps["y_range"]
    result = np.zeros(len(x_test))
    for k in range(len(x_test)):
        for j in range(n):
            r2 = (xn_t[k]-tps["xn"][j])**2 + (yn_t[k]-tps["yn"][j])**2
            if r2 > 1e-30:
                result[k] += c[j] * r2 * np.log(r2)
        result[k] += p[0] + p[1]*xn_t[k] + p[2]*yn_t[k]
    return result

def precompute_bilinear(x, y):
    A = np.column_stack([np.ones(len(x)), x, y, x*y])
    ATA_inv = np.linalg.inv(A.T @ A)
    return {"ATA_inv": ATA_inv, "A": A}

def eval_bilinear(x_test, y_test, bil, z_train):
    coeffs = bil["ATA_inv"] @ (bil["A"].T @ z_train)
    x_test = np.atleast_1d(np.asarray(x_test, dtype=float))
    y_test = np.atleast_1d(np.asarray(y_test, dtype=float))
    A_t = np.column_stack([np.ones(len(x_test)), x_test, y_test, x_test*y_test])
    return A_t @ coeffs

def compute_pulse_metrics(t, v_in, v_out):
    def _fwhm_cross(t, v):
        pk = np.argmax(np.abs(v))
        half = abs(v[pk]) / 2.0
        li = pk
        while li > 0 and abs(v[li]) >= half:
            li -= 1
        if li < pk:
            v1,v2 = abs(v[li]),abs(v[li+1])
            t1,t2 = t[li],t[li+1]
            tl = t1+(half-v1)/(v2-v1)*(t2-t1) if v2!=v1 else t1
        else:
            tl = t[0]
        ri = pk
        while ri < len(v)-1 and abs(v[ri]) >= half:
            ri += 1
        if ri > pk:
            v1,v2 = abs(v[ri-1]),abs(v[ri])
            t1,t2 = t[ri-1],t[ri]
            tr = t1+(half-v1)/(v2-v1)*(t2-t1) if v2!=v1 else t1
        else:
            tr = t[-1]
        return tr-tl, t[pk], tl, tr
    fwhm_in, tpk_in, tl_in, tr_in = _fwhm_cross(t, v_in)
    fwhm_out, tpk_out, tl_out, tr_out = _fwhm_cross(t, v_out)
    dt = t[1]-t[0]
    e_in = np.sum(v_in**2)*dt
    e_out = np.sum(v_out**2)*dt
    lhw = tpk_out - tl_out
    rhw = tr_out - tpk_out
    return {"input_fwhm_s": fwhm_in, "output_fwhm_s": fwhm_out,
            "fwhm_broadening_ratio": fwhm_out/fwhm_in if fwhm_in>0 else np.nan,
            "peak_delay_s": tpk_out-tpk_in, "output_peak_time_s": tpk_out,
            "energy_ratio": e_out/e_in if e_in>0 else np.nan,
            "tail_asymmetry": rhw/lhw if lhw>0 else np.nan}

def main():
    cal = pd.read_csv("data/calibration_lines.csv")
    targets = pd.read_csv("data/target_lines.csv")
    ct = pd.read_csv("data/calibration_transfer.csv")
    fg = pd.read_csv("data/frequency_grid.csv")
    ip = pd.read_csv("data/input_pulse.csv")
    f = fg["frequency_hz"].values
    w_ = 2.0*np.pi*f
    t = ip["time_s"].values
    v_in = ip["input_v"].values
    n_f, n_t, n_cal, n_tgt = len(f), len(t), len(cal), len(targets)

    alpha_all = np.zeros((n_cal, n_f))
    beta_all = np.zeros((n_cal, n_f))
    for i in range(n_cal):
        row = cal.iloc[i]
        l = row["length_m"]
        sub = ct[ct["line_id"]==row["line_id"]].sort_values("frequency_hz").reset_index(drop=True)
        alpha_all[i] = -(sub["magnitude_db"].values*np.log(10)/20.0)/l
        beta_all[i] = -sub["phase_rad"].values/l
    mf = f > 0
    tau_all = np.array([np.mean(beta_all[i,mf]/w_[mf]) for i in range(n_cal)])

    w_cal = cal["trace_width_um"].values.astype(float)
    r_cal = cal["roughness_index"].values.astype(float)
    inv_w_cal = 1.0/w_cal
    w_tgt = targets["trace_width_um"].values.astype(float)
    r_tgt = targets["roughness_index"].values.astype(float)
    inv_w_tgt = 1.0/w_tgt
    l_tgt = targets["length_m"].values.astype(float)
    tgt_ids = targets["line_id"].values

    tps_tau_full = precompute_tps(w_cal, r_cal)
    tps_alpha_full = precompute_tps(inv_w_cal, r_cal)
    bil_tau_full = precompute_bilinear(w_cal, r_cal)
    bil_alpha_full = precompute_bilinear(inv_w_cal, r_cal)
    tps_tau_loo = [precompute_tps(np.delete(w_cal,i),np.delete(r_cal,i)) for i in range(n_cal)]
    tps_alpha_loo = [precompute_tps(np.delete(inv_w_cal,i),np.delete(r_cal,i)) for i in range(n_cal)]
    bil_tau_loo = [precompute_bilinear(np.delete(w_cal,i),np.delete(r_cal,i)) for i in range(n_cal)]
    bil_alpha_loo = [precompute_bilinear(np.delete(inv_w_cal,i),np.delete(r_cal,i)) for i in range(n_cal)]

    # LOO-CV
    print("="*70)
    print("LEAVE-ONE-OUT CROSS-VALIDATION")
    print("="*70)
    tau_loo_tps = np.zeros(n_cal)
    tau_loo_bil = np.zeros(n_cal)
    for i in range(n_cal):
        tau_loo_tps[i] = eval_tps(w_cal[i],r_cal[i],tps_tau_loo[i],np.delete(tau_all,i))[0]
        tau_loo_bil[i] = eval_bilinear(w_cal[i],r_cal[i],bil_tau_loo[i],np.delete(tau_all,i))[0]
    e_tps_tau = np.abs(tau_loo_tps-tau_all)/tau_all*100
    e_bil_tau = np.abs(tau_loo_bil-tau_all)/tau_all*100
    hdr = "  {:<8} {:>12} {:>9} {:>9}".format("line","true","TPS_err%","Bil_err%")
    print("\n  tau LOO-CV:")
    print(hdr)
    for i in range(n_cal):
        print("  {:<8} {:>12.4e} {:>9.2f} {:>9.2f}".format(
            cal["line_id"].values[i], tau_all[i], e_tps_tau[i], e_bil_tau[i]))
    print("  Max:  TPS={:.2f}%  Bil={:.2f}%".format(np.max(e_tps_tau), np.max(e_bil_tau)))
    print("  Mean: TPS={:.2f}%  Bil={:.2f}%".format(np.mean(e_tps_tau), np.mean(e_bil_tau)))

    alpha_loo_tps = np.zeros((n_cal, n_f))
    alpha_loo_bil = np.zeros((n_cal, n_f))
    for i in range(n_cal):
        mi = np.delete(np.arange(n_cal), i)
        for j in range(n_f):
            alpha_loo_tps[i,j] = eval_tps(inv_w_cal[i],r_cal[i],tps_alpha_loo[i],alpha_all[mi,j])[0]
            alpha_loo_bil[i,j] = eval_bilinear(inv_w_cal[i],r_cal[i],bil_alpha_loo[i],alpha_all[mi,j])[0]
    valid = (f>0) & (alpha_all>0)
    e_tps_a = np.where(valid, np.abs(alpha_loo_tps-alpha_all)/np.abs(alpha_all)*100, 0)
    e_bil_a = np.where(valid, np.abs(alpha_loo_bil-alpha_all)/np.abs(alpha_all)*100, 0)
    print("\n  alpha LOO-CV (all freq, f>0):")
    print("    TPS: max={:.2f}%, mean={:.2f}%".format(np.max(e_tps_a), np.mean(e_tps_a[valid])))
    print("    Bil: max={:.2f}%, mean={:.2f}%".format(np.max(e_bil_a), np.mean(e_bil_a[valid])))
    for f_rep in [1e9, 5e9, 10e9, 62.5e9]:
        idx = np.argmin(np.abs(f-f_rep))
        et = np.abs(alpha_loo_tps[:,idx]-alpha_all[:,idx])/np.abs(alpha_all[:,idx])*100
        eb = np.abs(alpha_loo_bil[:,idx]-alpha_all[:,idx])/np.abs(alpha_all[:,idx])*100
        print("    f={:6.1f} GHz: TPS max={:6.2f}%  Bil max={:6.2f}%".format(f[idx]/1e9, np.max(et), np.max(eb)))

    use_tps_tau = np.max(e_tps_tau) < np.max(e_bil_tau)
    use_tps_alpha = np.max(e_tps_a) < np.max(e_bil_a)
    print("\n  Model selection:")
    print("    tau:   {} (max err {:.2f}%)".format("TPS" if use_tps_tau else "Bilinear",
          np.max(e_tps_tau) if use_tps_tau else np.max(e_bil_tau)))
    print("    alpha: {} (max err {:.2f}%)".format("TPS" if use_tps_alpha else "Bilinear",
          np.max(e_tps_a) if use_tps_alpha else np.max(e_bil_a)))

    # End-to-end validation
    print("\n" + "="*70)
    print("END-TO-END VALIDATION ON CALIBRATION LINES")
    print("="*70)
    def predict_H(w, r, l, ut, ua):
        if ut:
            tau = eval_tps(w, r, tps_tau_full, tau_all)[0]
        else:
            tau = eval_bilinear(w, r, bil_tau_full, tau_all)[0]
        if ua:
            alpha = np.array([eval_tps(1.0/w, r, tps_alpha_full, alpha_all[:,j])[0] for j in range(n_f)])
        else:
            alpha = np.array([eval_bilinear(1.0/w, r, bil_alpha_full, alpha_all[:,j])[0] for j in range(n_f)])
        H = np.exp(-(alpha + 1j*w_*tau)*l)
        return H, alpha, tau

    for label, (ut, ua) in [("Selected", (use_tps_tau, use_tps_alpha)),
                             ("TPS", (True,True)), ("Bilinear", (False,False))]:
        print("\n  --- {} ---".format(label))
        print("  {:<8} {:>12} {:>13} {:>15} {:>16}".format(
            "line","max_mag(dB)","mean_mag(dB)","max_phase(r)","mean_phase(r)"))
        for i in range(n_cal):
            row = cal.iloc[i]
            Hm,_,_ = predict_H(w_cal[i], r_cal[i], row["length_m"], ut, ua)
            mm = 20*np.log10(np.abs(Hm))
            pm = np.unwrap(np.angle(Hm))
            sub = ct[ct["line_id"]==row["line_id"]].sort_values("frequency_hz").reset_index(drop=True)
            mm0 = sub["magnitude_db"].values
            pm0 = sub["phase_rad"].values
            pm = pm - (pm[0]-pm0[0])
            me = np.abs(mm-mm0)
            pe = np.abs(pm-pm0)
            print("  {:<8} {:>12.6f} {:>13.6f} {:>15.4f} {:>16.4f}".format(
                row["line_id"], np.max(me), np.mean(me), np.max(pe), np.mean(pe)))

    # Target prediction
    print("\n" + "="*70)
    print("TARGET PREDICTION")
    print("="*70)
    target_results = {}
    for i in range(n_tgt):
        H_t, alpha_t, tau_t = predict_H(w_tgt[i], r_tgt[i], l_tgt[i], use_tps_tau, use_tps_alpha)
        _, alpha_t_b, tau_t_b = predict_H(w_tgt[i], r_tgt[i], l_tgt[i], False, False)
        mag_db_t = 20*np.log10(np.abs(H_t))
        phase_t = -w_*tau_t*l_tgt[i]
        gd = -np.gradient(phase_t, w_)
        target_results[tgt_ids[i]] = {
            "frequency_hz": f, "magnitude_db": mag_db_t, "phase_rad": phase_t,
            "group_delay_s": gd, "attenuation_np_per_m": alpha_t, "H": H_t,
            "alpha": alpha_t, "tau": tau_t, "tau_bil": tau_t_b}
        i10 = np.argmin(np.abs(f-10e9))
        print("\n  {}: l={:.2f} m, w={:.0f} um, rough={:.2f}".format(
            tgt_ids[i], l_tgt[i], w_tgt[i], r_tgt[i]))
        print("    tau = {:.6e} s/m (bil: {:.6e}, diff={:.2f}%)".format(
            tau_t, tau_t_b, abs(tau_t-tau_t_b)/tau_t*100))
        print("    group_delay = tau*l = {:.6e} s".format(tau_t*l_tgt[i]))
        print("    alpha(10 GHz) = {:.4e} Np/m".format(alpha_t[i10]))
        print("    mag_db: DC={:.4f} dB, 62.5 GHz={:.4f} dB".format(mag_db_t[0], mag_db_t[-1]))
        print("    phase(62.5 GHz) = {:.2f} rad".format(phase_t[-1]))

    # Waveform synthesis
    print("\n" + "="*70)
    print("WAVEFORM SYNTHESIS")
    print("="*70)
    V_in_fft = np.fft.fft(v_in)
    N = n_t
    waveform_results = {}
    for i in range(n_tgt):
        tid = tgt_ids[i]
        H_t = target_results[tid]["H"]
        H_full = np.zeros(N, dtype=complex)
        H_full[0:N//2+1] = H_t
        H_full[N//2+1:] = np.conj(H_t[N//2-1:0:-1])
        v_out = np.fft.ifft(H_full * V_in_fft).real
        waveform_results[tid] = v_out
        pk = np.argmax(np.abs(v_out))
        print("  {}: peak={:.4f} V at t={:.4e} s".format(tid, np.abs(v_out[pk]), t[pk]))

    # Pulse metrics
    print("\n" + "="*70)
    print("PULSE METRICS")
    print("="*70)
    metrics_rows = []
    for i in range(n_tgt):
        tid = tgt_ids[i]
        m = compute_pulse_metrics(t, v_in, waveform_results[tid])
        metrics_rows.append({"target_id": tid, **m})
        print("  {}: FWHM_in={:.4e} FWHM_out={:.4e} ratio={:.4f} delay={:.4e} s E={:.6f} tail={:.4f}".format(
            tid, m["input_fwhm_s"], m["output_fwhm_s"], m["fwhm_broadening_ratio"],
            m["peak_delay_s"], m["energy_ratio"], m["tail_asymmetry"]))

    # Write output files
    results_dir = Path("results")
    results_dir.mkdir(exist_ok=True)
    tr = []
    for i in range(n_tgt):
        tid = tgt_ids[i]
        r = target_results[tid]
        for j in range(n_f):
            tr.append({"target_id": tid, "frequency_hz": r["frequency_hz"][j],
                       "magnitude_db": r["magnitude_db"][j], "phase_rad": r["phase_rad"][j],
                       "group_delay_s": r["group_delay_s"][j],
                       "attenuation_np_per_m": r["attenuation_np_per_m"][j]})
    pd.DataFrame(tr).to_csv(results_dir/"target_transfer.csv", index=False)
    print("\n  Wrote results/target_transfer.csv ({} rows)".format(len(tr)))

    wr = []
    for i in range(n_tgt):
        tid = tgt_ids[i]
        for j in range(n_t):
            wr.append({"target_id": tid, "time_s": t[j], "input_v": v_in[j],
                       "output_v": waveform_results[tid][j]})
    pd.DataFrame(wr).to_csv(results_dir/"target_waveforms.csv", index=False)
    print("  Wrote results/target_waveforms.csv ({} rows)".format(len(wr)))

    pd.DataFrame(metrics_rows).to_csv(results_dir/"pulse_metrics.csv", index=False)
    print("  Wrote results/pulse_metrics.csv ({} rows)".format(len(metrics_rows)))

    # Final diagnostics
    print("\n" + "="*70)
    print("FINAL DIAGNOSTICS")
    print("="*70)
    for i in range(n_tgt):
        tid = tgt_ids[i]
        ph = target_results[tid]["phase_rad"]
        gd = target_results[tid]["group_delay_s"]
        tau_l = target_results[tid]["tau"] * l_tgt[i]
        mono = np.all(np.diff(ph) < 0)
        gd_m = np.mean(gd[1:-1])
        gd_s = np.std(gd[1:-1])
        print("  {}: phase monotonic: {}, ph[0]={:.6f}, ph[-1]={:.2f}".format(
            tid, mono, ph[0], ph[-1]))
        print("         gd mean={:.6e} std={:.2e} tau*l={:.6e} rel_std={:.4f}%".format(
            gd_m, gd_s, tau_l, gd_s/gd_m*100))
    print("\nDone.")

if __name__ == "__main__":
    main()
