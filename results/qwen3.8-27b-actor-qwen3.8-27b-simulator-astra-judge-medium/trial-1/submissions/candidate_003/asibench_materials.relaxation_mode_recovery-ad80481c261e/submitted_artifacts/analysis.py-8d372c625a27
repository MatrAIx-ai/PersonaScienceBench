#!/usr/bin/env python3
"""Shared-mode recovery from complex response curves (end-to-end, one run).

Model (per curve m=0..4): R_m(x)=a0_m + sum_k a_{k,m}/(1+(i*x*tau_k)**phi_k)
Shared: K, tau_k>0, phi_k in (0,1]. Curve-specific: a0_m (complex), a_{k,m}>=0.
Method: joint multistart MAP/BIC model selection with variable projection
(a0 = complex mean, a_{k,m}>=0 via NNLS); nonlinear (log tau, phi) optimized
by differential evolution + polish from many restarts. K chosen by BIC
(asymptotic MAP proxy), cross-checked by leave-block-out CV in x and restart
stability; soft log-tau/phi prior as tie-breaker if BIC is flat. Parametric
bootstrap for CI. Outputs results/modes.csv and diagnostic stdout.
"""
import os
import numpy as np
from scipy.optimize import nnls, differential_evolution

RNG_SEED = 0
TAU_LO, TAU_HI = 1e-4, 1e4
PHI_LO, PHI_HI = 0.05, 1.0
N_CURVES = 5
N_DE_RUNS = 6
KMAX = 6
DE_POP = 15
DE_MAXITER = 40
CV_FOLDS = 5
BOOT_N = 120
PRIOR_W = 1e-3
np.random.seed(RNG_SEED)


def load_data():
    d = np.genfromtxt('data/curves.csv', delimiter=',', names=True)
    x = d['x'][d['curve'] == 0]
    Y = np.zeros((N_CURVES, x.size), dtype=complex)
    for c in range(N_CURVES):
        m = d['curve'] == c
        Y[c] = d['re'][m] + 1j * d['im'][m]
    assert (np.isnan(x).sum() + np.isnan(Y.real).sum() + np.isnan(Y.imag).sum()) == 0
    return x, Y


def basis(x, tau, phi):
    return 1.0 / (1.0 + (1j * x * tau) ** phi)


def solve_linear(x, Y, taus, phis):
    """Variable projection: a0 = complex mean, a_{k,m}>=0 via NNLS.
    Returns (RSS, a0[M](complex), A[M,K])."""
    B = np.stack([basis(x, t, p) for t, p in zip(taus, phis)], axis=1)
    Bbar = B.mean(axis=0)
    rss = 0.0
    a0 = np.zeros(N_CURVES, dtype=complex)
    A = np.zeros((N_CURVES, B.shape[1]), dtype=float)
    for m in range(N_CURVES):
        y = Y[m]
        yc = y - y.mean()
        Bc = B - Bbar
        Ar = np.vstack([Bc.real, Bc.imag])
        br = np.concatenate([yc.real, yc.imag])
        am, _ = nnls(Ar, br)
        A[m] = am
        a0[m] = y.mean() - Bbar @ am
        rss += np.sum(np.abs(Bc @ am - yc) ** 2)
    return rss, a0, A


def objective(x, Y, v, prior=False):
    K = v.size // 2
    rss, _, _ = solve_linear(x, Y, np.exp(v[:K]), v[K:])
    if prior:
        lt = v[:K]
        pen = PRIOR_W * (np.sum((lt - np.log(np.sqrt(TAU_LO * TAU_HI))) ** 2)
                         + np.sum((v[K:] - 0.5) ** 2))
        rss += pen
    return rss


def run_de(x, Y, K, seed, pop, maxiter, bounds=None, prior=False):
    lb = np.array([np.log(TAU_LO)] * K + [PHI_LO] * K)
    ub = np.array([np.log(TAU_HI)] * K + [PHI_HI] * K)
    if bounds is not None:
        lb, ub = bounds
    f = lambda v: objective(x, Y, v, prior=prior)
    return differential_evolution(f, list(zip(lb, ub)), seed=seed, popsize=pop,
                                  maxiter=maxiter, tol=1e-9, polish=True, init='sobol')


def fit_K(x, Y, K, n_runs=N_DE_RUNS, pop=DE_POP, maxiter=DE_MAXITER, prior=False):
    sols = []
    for i in range(n_runs):
        r = run_de(x, Y, K, seed=RNG_SEED + i, pop=pop, maxiter=maxiter, prior=prior)
        sols.append((r.fun, np.exp(r.x[:K]), r.x[K:]))
    sols.sort(key=lambda s: s[0])
    return sols


def bic(rss, K, n_real):
    p = 2 * K + N_CURVES * (2 + K)
    return n_real * np.log(rss / n_real) + p * np.log(n_real), p


def cluster_solutions(sols, rtol_tau=0.3, rtol_phi=0.05):
    used = [False] * len(sols)
    clusters = []
    for i in range(len(sols)):
        if used[i]:
            continue
        grp = [i]; used[i] = True
        t_ref = np.sort(sols[i][1]); p_ref = np.sort(sols[i][2])
        for j in range(i + 1, len(sols)):
            if used[j]:
                continue
            tj = np.sort(sols[j][1]); pj = np.sort(sols[j][2])
            if np.all(np.abs(np.log(tj) - np.log(t_ref)) <= rtol_tau) and \
               np.all(np.abs(pj - p_ref) <= rtol_phi):
                grp.append(j); used[j] = True
        clusters.append(grp)
    clusters.sort(key=len, reverse=True)
    return clusters


def cv_by_x(x, Y, K, n_folds=CV_FOLDS, pop=10, maxiter=20, prior=False):
    N = x.size
    folds = np.array_split(np.arange(N), n_folds)
    test_rss = []
    for f in folds:
        train = np.concatenate([g for g in folds if g is not f])
        r = run_de(x[train], Y[:, train], K, seed=RNG_SEED + f.size,
                   pop=pop, maxiter=maxiter, prior=prior)
        rss, _, _ = solve_linear(x[f], Y[:, f], np.exp(r.x[:K]), r.x[K:])
        test_rss.append(rss)
    return np.mean(test_rss), test_rss


def bootstrap(x, Y, K, taus0, phis0, n=BOOT_N, pop=10, maxiter=20):
    rss0, _, _ = solve_linear(x, Y, taus0, phis0)
    sigma = np.sqrt(rss0 / (N_CURVES * x.size * 2))
    taus_all = np.zeros((n, K)); phis_all = np.zeros((n, K)); amps_all = np.zeros((n, N_CURVES, K))
    for b in range(n):
        Yb = Y + (np.random.randn(*Y.shape) + 1j * np.random.randn(*Y.shape)) * sigma / np.sqrt(2)
        lb = np.concatenate([np.clip(np.log(taus0) - 1.0, np.log(TAU_LO), np.log(TAU_HI)),
                             np.clip(phis0 - 0.15, PHI_LO, PHI_HI)])
        ub = np.concatenate([np.clip(np.log(taus0) + 1.0, np.log(TAU_LO), np.log(TAU_HI)),
                             np.clip(phis0 + 0.15, PHI_LO, PHI_HI)])
        r = run_de(x, Yb, K, seed=RNG_SEED + 1000 + b, pop=pop, maxiter=maxiter, bounds=(lb, ub))
        taus_all[b] = np.exp(r.x[:K]); phis_all[b] = r.x[K:]
        _, _, A = solve_linear(x, Yb, taus_all[b], phis_all[b])
        amps_all[b] = A
    return sigma, taus_all, phis_all, amps_all


def main():
    os.makedirs('results', exist_ok=True)
    x, Y = load_data()
    n_real = N_CURVES * x.size * 2
    print("=" * 70)
    print("DATA: 5 curves x 96 pts, shared log grid x in [%.3g, %.3g]" % (x.min(), x.max()))
    print("=" * 70)

    print("\n[1] BIC table by K (best of %d independent DE restarts each)" % N_DE_RUNS)
    print("  K   best_RSS     npar     BIC        d_BIC(min)")
    bic_rows, best_sols = {}, {}
    for K in range(1, KMAX + 1):
        sols = fit_K(x, Y, K)
        best_sols[K] = sols
        b, _ = bic(sols[0][0], K, n_real)
        bic_rows[K] = b
    bmin = min(bic_rows.values())
    for K in range(1, KMAX + 1):
        b, p = bic_rows[K], 2 * K + N_CURVES * (2 + K)
        print("  %d   %.4f    %d   %10.2f   %+8.2f" % (K, best_sols[K][0][0], p, b, b - bmin))

    Ks = list(range(1, KMAX + 1))
    bminK = min(Ks, key=lambda k: bic_rows[k])
    ordered = sorted(bic_rows.values())
    gap = ordered[1] - ordered[0]
    print("\n  BIC minimum at K=%d (gap to next best = %.2f)" % (bminK, gap))

    use_prior = False
    if gap < 5.0:
        print("  -> BIC curve flat/ambiguous; rerunning K selection with soft prior (MAP).")
        use_prior = True
        bic_rows_p, best_sols_p = {}, {}
        for K in Ks:
            sols = fit_K(x, Y, K, prior=True)
            best_sols_p[K] = sols
            b, _ = bic(sols[0][0], K, n_real)
            bic_rows_p[K] = b
        bminK = min(Ks, key=lambda k: bic_rows_p[k])
        print("  -> MAP(prior) selects K=%d" % bminK)

    K = bminK
    sols = best_sols_p[K] if use_prior else best_sols[K]

    clusters = cluster_solutions(sols)
    top_frac = len(clusters[0]) / len(sols)
    print("\n[2] Restart stability at K=%d: %d restarts, largest cluster = %d (%.0f%%)"
          % (K, len(sols), len(clusters[0]), 100 * top_frac))
    for i, g in enumerate(clusters[:3]):
        print("    cluster %d (size %d): RSS=%.4f tau=%s phi=%s"
              % (i, len(g), sols[g[0]][0],
                 np.round(np.sort(sols[g[0]][1]), 3), np.round(np.sort(sols[g[0]][2]), 3)))
    g0 = clusters[0]
    ci = min(g0, key=lambda i: sols[i][0])
    rss, taus_c, phis_c = sols[ci]
    order = np.argsort(taus_c)
    taus_c, phis_c = taus_c[order], phis_c[order]

    print("\n[3] Leave-block-out CV in x (test RSS, lower=better):")
    for kk in Ks:
        m, per = cv_by_x(x, Y, kk)
        print("    K=%d  mean_test_RSS=%.4f  per-fold=%s" % (kk, m, np.round(per, 3)))

    rss_f, a0, A = solve_linear(x, Y, taus_c, phis_c)
    print("\n[4] Final fit K=%d: RSS=%.4f  sigma(resid)=%.4f" % (K, rss_f, np.sqrt(rss_f / n_real)))
    for m in range(N_CURVES):
        print("    curve %d: a0=%.4f%+.4fi  a_k=%s" % (m, a0[m].real, a0[m].imag, np.round(A[m], 4)))

    print("\n[5] Boundary / identifiability diagnostics:")
    for k in range(K):
        t = taus_c[k]
        flag = "NEAR-LO" if t < 1.5 * TAU_LO else ("NEAR-HI" if t > TAU_HI / 1.5 else "interior")
        print("    mode k=%d: tau=%.4g  phi=%.3f  [%s]" % (k + 1, t, phis_c[k], flag))

    print("\n[6] Parametric bootstrap (n=%d) CI on shared tau/phi and amplitudes:" % BOOT_N)
    sigma, taus_b, phis_b, amps_b = bootstrap(x, Y, K, taus_c, phis_c)
    print("    sigma(noise)=%.4f" % sigma)
    for k in range(K):
        t95 = np.percentile(taus_b[:, k], [2.5, 97.5]); p95 = np.percentile(phis_b[:, k], [2.5, 97.5])
        print("    mode %d: tau=%.4g [%.3g, %.3g]  phi=%.3f [%.3f, %.3f]"
              % (k + 1, taus_c[k], t95[0], t95[1], phis_c[k], p95[0], p95[1]))
    print("    amplitude CI (95%%) per curve:")
    for m in range(N_CURVES):
        line = "      curve %d:" % m
        for k in range(K):
            q = np.percentile(amps_b[:, m, k], [2.5, 97.5])
            line += "  a%d=%.3f[%.3f,%.3f]" % (k + 1, A[m, k], q[0], q[1])
        print(line)

    amax_overall = A.max()
    deg_thresh = 0.02 * amax_overall
    deg_mask = (A.max(axis=0) < deg_thresh)
    n_deg = int(deg_mask.sum())
    print("\n[7] Degenerate amplitudes: threshold=%.4f (2%% of max amp %.4f); "
          "modes degenerate in ALL curves = %d/%d" % (deg_thresh, amax_overall, n_deg, K))

    keep = ~deg_mask
    taus_out = taus_c[keep]; A_out = A[:, keep]
    cols = ["tau"] + ["a_%d" % m for m in range(N_CURVES)]
    with open('results/modes.csv', 'w') as fh:
        fh.write(",".join(cols) + "\n")
        for i in range(taus_out.size):
            row = [("%.6g" % taus_out[i])] + [("%.6g" % A_out[m, i]) for m in range(N_CURVES)]
            fh.write(",".join(row) + "\n")
    print("\n[8] Wrote results/modes.csv with %d mode rows (dropped %d degenerate)."
          % (taus_out.size, n_deg))
    print("    header: " + ",".join(cols))
    for i in range(taus_out.size):
        print("    " + ",".join([("%.6g" % taus_out[i])] + [("%.6g" % A_out[m, i]) for m in range(N_CURVES)]))


if __name__ == '__main__':
    main()
