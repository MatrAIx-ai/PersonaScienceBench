"""Self-contained solver for the bounded Diophantine problem

    a * sigma(n) = b * n + c,   1 <= n <= U

where sigma(n) is the (standard) sum-of-divisors function.

Approach: structure-aware depth-first search over the prime-power
factorization of n.  We build n by appending prime factors in strictly
increasing order while tracking (n, sigma(n)) (sigma is multiplicative,
sigma(p^k) = (p^(k+1) - 1) / (p - 1)).  Every node is a complete integer, so
the exact equation is checked at each node.  Two *necessary-condition*
prunes keep the search small:

  A) ratio monotonicity.  sigma(n)/n is multiplicative and >= 1, and only
     increases when n is extended by a new factor.  The target ratio is
     sigma(n)/n = R + c/(a*n) with R = b/a.
       c < 0  -> target < R and approaches R from below  => need sigma(n)/n < R
       c > 0  -> target <= R + c/(a*n) (decreasing in n)  => need sigma(n)/n <= R + c/(a*n)
       c == 0 -> target == R                                => need sigma(n)/n <= R
     A node violating this can never be completed to a solution.

  B) linear cap.  For an extension multiplier m >= 1 (coprime to the current
     n) we need a*sigma(n)*sigma(m) = b*(n*m) + c.  Since sigma(m) >= m this
     implies (a*sigma(n) - b*n) * m <= c.  When D = a*sigma(n) - b*n > 0 this
     caps how large m may be (for c < 0, prune A already forces D < 0).

Degenerate cases (a == 0) are solved in closed form.  Only the Python
standard library is used.
"""

import math
import sys

# Cache of computed solution sets keyed by (a, b, c).
#   _cache[key] = (computed_up_to_U, sorted_list_of_solutions_<=computed_up_to_U)
_cache = {}


def _primes_upto(N: int) -> list:
    """All primes <= N via a lightweight bytearray sieve."""
    if N < 2:
        return []
    s = bytearray(b"\x01") * (N + 1)
    s[0] = s[1] = 0
    r = math.isqrt(N)
    for i in range(2, r + 1):
        if s[i]:
            start = i * i
            s[start:N + 1:i] = b"\x00" * (((N - start) // i) + 1)
    return [i for i in range(2, N + 1) if s[i]]


def _solve_core(a: int, b: int, c: int, U: int) -> list:
    """Return sorted n in [1, U] with a*sigma(n) == b*n + c (no caching)."""
    if U < 1:
        return []

    # ---- Degenerate: a == 0 ------------------------------------------------
    if a == 0:
        if b != 0:
            # 0 = b*n + c  ->  n = -c/b  (at most one integer value)
            if c % b == 0:
                n = -c // b
                if 1 <= n <= U:
                    return [n]
            return []
        # a == 0 and b == 0  ->  0 == c
        return list(range(1, U + 1)) if c == 0 else []

    # ---- a != 0 (here a >= 1): structure-aware DFS ------------------------
    primes = _primes_upto(U)
    out = []
    sys.setrecursionlimit(max(sys.getrecursionlimit(), 10000))

    def dfs(n: int, sig_n: int, pidx: int) -> None:
        # n is a complete candidate; check the exact equation.
        if a * sig_n == b * n + c:
            out.append(n)

        # Prune A: necessary condition on sigma(n)/n.
        if c < 0:
            if not (a * sig_n < b * n):
                return
        elif c > 0:
            if not (a * sig_n <= b * n + c):
                return
        else:
            if not (a * sig_n <= b * n):
                return

        # Prune B: cap on the extension multiplier (bites only when D > 0).
        D = a * sig_n - b * n
        for j in range(pidx, len(primes)):
            p = primes[j]
            if n * p > U:
                break
            pe = p
            sig_p = 1 + p
            while n * pe <= U:
                if D > 0 and D * pe > c:
                    break
                dfs(n * pe, sig_n * sig_p, j + 1)
                if pe > U // p:
                    break
                pe *= p
                sig_p += pe

    dfs(1, 1, 0)
    return sorted(out)


def solve(a: int, b: int, c: int, U: int) -> list[int]:
    """All positive integers n with 1 <= n <= U satisfying a*sigma(n) = b*n + c.

    Returns a list sorted in ascending order (empty if there are none).
    """
    key = (a, b, c)
    cached = _cache.get(key)
    if cached is not None:
        computed_U, lst = cached
        if computed_U >= U:
            return [n for n in lst if n <= U]
    # (Re)compute up to U.  Any previously cached solutions (<= old U <= U)
    # are a subset of the new result, so we can simply store the new list.
    lst = _solve_core(a, b, c, U)
    _cache[key] = (U, lst)
    return list(lst)


def _write_outputs(instances: list) -> None:
    import csv
    from pathlib import Path

    results = {}
    # Compute same-(a,b,c) groups with the largest U first so the cache is
    # reused; output order is restored afterwards.
    order = sorted(instances, key=lambda x: (x["a"], x["b"], x["c"], -x["U"]))
    for x in order:
        results[x["instance_id"]] = solve(x["a"], x["b"], x["c"], x["U"])

    outdir = Path("results")
    outdir.mkdir(parents=True, exist_ok=True)

    with open(outdir / "solutions.csv", "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["instance_id", "n"])
        for iid in sorted(results):
            for n in results[iid]:  # already ascending
                w.writerow([iid, n])

    with open(outdir / "instance_summary.csv", "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["instance_id", "solution_count", "largest_solution"])
        for iid in sorted(results):
            sols = results[iid]
            w.writerow([iid, len(sols), (sols[-1] if sols else 0)])


if __name__ == "__main__":
    import json
    from pathlib import Path

    data = json.loads(Path("data/problem_instances.json").read_text())
    _write_outputs(data["instances"])
