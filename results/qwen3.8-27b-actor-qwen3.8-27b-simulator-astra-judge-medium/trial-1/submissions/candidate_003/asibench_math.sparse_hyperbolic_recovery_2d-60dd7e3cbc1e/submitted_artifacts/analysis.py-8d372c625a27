#!/usr/bin/env python
"""
Spatiotemporal scalar-field analysis from sparse noisy measurements.

Pipeline
  1. Reconstruct the scalar field u(x,y) on a dense 128x128 grid at each of
     the 6 evaluation times from the scattered (t,x,y,u) observations
     (regularized thin-plate-spline RBF on a symmetric time window).
  2. Detect the narrow rapid-change curves (level sets of u at each
     plateau-midpoint) and, per curve point, a unit transverse normal
     n = grad u / |grad u|.
  3. Estimate the signed normal speed of each curve, v_n = -u_t / |grad u|.
  4. Infer the dynamical rule linking temporal change to spatial arrangement:
     fit linear advection v_n = alpha . n; if the residuals split into two
     groups (one per interface) switch to a value-dependent transport rule
     v_n = (alpha0 + alpha1 * u) . n.

Only numpy / scipy / matplotlib are used.  Runs end-to-end:  python analysis.py
"""
import json
import os
import struct
import zlib

import numpy as np
from scipy.interpolate import RBFInterpolator
from scipy.ndimage import map_coordinates
from scipy.spatial import cKDTree

# --------------------------------------------------------------------------- #
DATA = "data"
N = 128                 # evaluation grid shape
DT = 0.042              # symmetric time half-window for reconstruction
SMOOTH = 0.5            # thin-plate-spline RBF smoothing parameter
GMAG_FRAC = 0.5         # keep curve points with |grad u| > frac * median
VN_SMOOTH_R = 0.5       # spatial (along-curve) smoothing radius for v_n

obs = np.load(os.path.join(DATA, "spacetime_observations.npz"))
t = obs["t"].astype(np.float64)
x = obs["x"].astype(np.float64)
y = obs["y"].astype(np.float64)
u = obs["u"].astype(np.float64)
n_obs = len(t)

grid = json.load(open(os.path.join(DATA, "observation_grid.json")))
ev = np.asarray(grid["evaluation_times"], dtype=float)
xmin, xmax = grid["domain"]["x_min"], grid["domain"]["x_max"]
ymin, ymax = grid["domain"]["y_min"], grid["domain"]["y_max"]

xc = np.linspace(xmin, xmax, N)
yc = np.linspace(ymin, ymax, N)
GX, GY = np.meshgrid(xc, yc, indexing="xy")
GRID = np.column_stack([GX.ravel(), GY.ravel()])


def idx_of(px, py):
    return np.array([(px - xmin) / (xmax - xmin) * (N - 1),
                     (py - ymin) / (ymax - ymin) * (N - 1)])


def exploration_summary():
    low = u < -0.9
    mid = (u >= -0.9) & (u < 0.0)
    high = u >= 0.0
    med = {k: np.median(u[m]) for k, m in [("low", low), ("mid", mid), ("high", high)]}
    sigmas = []
    for m, c in [(low, med["low"]), (mid, med["mid"]), (high, med["high"])]:
        core = m & (np.abs(u - c) < 0.30)
        if core.sum() > 20:
            sigmas.append(np.std(u[core]))
    noise = float(np.median(sigmas)) if sigmas else float(np.std(u))
    tree = cKDTree(np.column_stack([x, y]))
    dd, _ = tree.query(GRID)
    frac15 = float(np.mean(dd <= 0.15))
    nn = tree.query(GRID, k=1)[0]
    cov = (f"{n_obs} pts over {xmax - xmin:.2f}x{ymax - ymin:.2f} domain; "
           f"{100 * frac15:.1f}% of 128x128 cells within 0.15 of a point; "
           f"mean nearest-neighbour dist {float(np.mean(nn)):.3f} "
           f"(~{float(np.mean(nn)) / (xc[1] - xc[0]):.1f}x grid spacing {xc[1] - xc[0]:.3f})")
    edges = np.linspace(u.min(), u.max(), 17)
    hist, _ = np.histogram(u, bins=edges)
    vhist = [[round(float(edges[i]), 4), int(hist[i])] for i in range(16)]
    return {
        "n_observations": int(n_obs),
        "u_range": [round(float(u.min()), 4), round(float(u.max()), 4)],
        "noise_estimate": round(noise, 4),
        "coverage_estimate": cov,
        "value_histogram": vhist,
        "plateau_levels": {k: round(float(v), 4) for k, v in med.items()},
    }


def reconstruct():
    U = np.zeros((len(ev), N, N))
    npts = []
    for k, tk in enumerate(ev):
        m = np.abs(t - tk) < DT
        npts.append(int(m.sum()))
        rbf = RBFInterpolator(np.column_stack([x[m], y[m]]), u[m],
                              kernel="thin_plate_spline", smoothing=SMOOTH)
        U[k] = rbf(GRID).reshape(N, N)
    return U, npts


def ms_points(Uk, level):
    ny, nx = Uk.shape
    Uv = Uk - level
    px, py = [], []
    for i in range(nx):
        a = Uv[:-1, i]; b = Uv[1:, i]
        s = a * b < 0
        tt = a[s] / (a[s] - b[s])
        px += list(np.full(s.sum(), xc[i]))
        py += list(yc[:-1][s] + tt * (yc[1:] - yc[:-1])[s])
    for j in range(ny):
        a = Uv[j, :-1]; b = Uv[j, 1:]
        s = a * b < 0
        tt = a[s] / (a[s] - b[s])
        px += list(xc[:-1][s] + tt * (xc[1:] - xc[:-1])[s])
        py += list(np.full(s.sum(), yc[j]))
    return np.asarray(px), np.asarray(py)


def smooth_scattered(px, py, val, r):
    out = val.copy()
    if len(px) == 0 or r <= 0:
        return out
    tree = cKDTree(np.column_stack([px, py]))
    for i in range(len(px)):
        out[i] = val[tree.query_ball_point([px[i], py[i]], r)].mean()
    return out


def robust_lstsq(A, b, c=1.5, iters=6):
    """Huber-style iteratively reweighted least squares (no ML)."""
    w = np.ones(len(b))
    x = None
    for _ in range(iters):
        Aw = A * w[:, None]
        x, *_ = np.linalg.lstsq(Aw, b * w, rcond=None)
        r = b - A @ x
        s = np.median(np.abs(r)) / 0.6745
        if s < 1e-9:
            s = 1.0
        u = np.abs(r) / (c * s)
        w = np.where(u <= 1.0, 1.0, 1.0 / u)
    return x, w


def main():
    expl = exploration_summary()
    json.dump(expl, open("exploration_summary.json", "w"), indent=2)

    U, npts = reconstruct()
    field = U.astype(np.float32)
    np.save("reconstructed_field.npy", field)

    low = u < -0.9
    mid = (u >= -0.9) & (u < 0.0)
    high = u >= 0.0
    med_low, med_mid, med_high = np.median(u[low]), np.median(u[mid]), np.median(u[high])
    levels = [0.5 * (med_low + med_mid), 0.5 * (med_mid + med_high)]  # LM, MH

    def ut_field(k):
        if 0 < k < len(ev) - 1:
            return (U[k + 1] - U[k - 1]) / (ev[k + 1] - ev[k - 1])
        js = [0, 1, 2] if k == 0 else [len(ev) - 3, len(ev) - 2, len(ev) - 1]
        et = np.array([ev[j] for j in js])
        et = et - et.mean()
        vals = np.stack([U[j] for j in js], axis=0)
        return (vals.T @ et).T / (et @ et)

    curves, normals, speeds, masks = {}, {}, {}, []
    all_px, all_py, all_nx, all_ny, all_vn, all_lab = [], [], [], [], [], []
    iface_pos = {f"t_{k}": {} for k in range(len(ev))}

    for k in range(len(ev)):
        gx, gy = np.gradient(U[k], xc[1] - xc[0], yc[1] - yc[0])
        gmag = np.hypot(gx, gy)
        utf = ut_field(k)

        px_k, py_k, nx_k, ny_k, vn_k = [], [], [], [], []
        for lab, lev in enumerate(levels):
            px, py = ms_points(U[k], lev)
            if len(px) == 0:
                iface_pos[f"t_{k}"][f"iface_{lab}"] = {"n_points": 0, "mean_x_plus_y": None}
                continue
            idc = idx_of(px, py)
            g = map_coordinates(gmag, idc, order=1, mode="nearest")
            gxx = map_coordinates(gx, idc, order=1, mode="nearest")
            gyy = map_coordinates(gy, idc, order=1, mode="nearest")
            up = map_coordinates(utf, idc, order=1, mode="nearest")
            vn = -up / g
            keep = g > GMAG_FRAC * np.median(g)
            gl = g[keep]
            px_k.append(px[keep]); py_k.append(py[keep])
            nx_k.append(gxx[keep] / gl); ny_k.append(gyy[keep] / gl)
            vn_k.append(vn[keep])
            iface_pos[f"t_{k}"][f"iface_{lab}"] = {
                "n_points": int(keep.sum()),
                "mean_x_plus_y": round(float(np.mean(px[keep] + py[keep])), 4),
            }
        if len(px_k) == 0:
            continue
        lab_k = np.concatenate([np.full(len(a), i) for i, a in enumerate(px_k)])
        px_k = np.concatenate(px_k); py_k = np.concatenate(py_k)
        nx_k = np.concatenate(nx_k); ny_k = np.concatenate(ny_k)
        vn_k = np.concatenate(vn_k)

        vn_sm = np.empty_like(vn_k)
        for lab in range(len(levels)):
            sel = lab_k == lab
            vn_sm[sel] = smooth_scattered(px_k[sel], py_k[sel], vn_k[sel], VN_SMOOTH_R)

        curves[f"t_{k}"] = np.column_stack([px_k, py_k]).astype(np.float32)
        normals[f"t_{k}"] = np.column_stack([nx_k, ny_k]).astype(np.float32)
        speeds[f"t_{k}"] = vn_sm.astype(np.float32)

        all_px.append(px_k); all_py.append(py_k); all_nx.append(nx_k); all_ny.append(ny_k)
        all_vn.append(vn_sm); all_lab.append(lab_k)

        tree = cKDTree(np.column_stack([px_k, py_k]))
        dgrid, _ = tree.query(GRID)
        masks.append(dgrid.reshape(N, N) < 2.0 * (xc[1] - xc[0]))

    np.savez("transition_curves.npz", **curves)
    np.savez("transition_normals.npz", **normals)
    np.savez("transition_speeds.npz", **speeds)
    np.save("transition_mask_preview.npy", np.stack(masks).astype(bool))

    all_px = np.concatenate(all_px); all_py = np.concatenate(all_py)
    all_nx = np.concatenate(all_nx); all_ny = np.concatenate(all_ny)
    all_vn = np.concatenate(all_vn); all_lab = np.concatenate(all_lab)
    uu = np.where(all_lab == 0, levels[0], levels[1])

    A_single = np.column_stack([all_nx, all_ny])
    alpha, w_single = robust_lstsq(A_single, all_vn)
    res_single = all_vn - A_single @ alpha
    rms_single = float(np.sqrt(np.mean(res_single ** 2)))

    A_val = np.column_stack([all_nx, all_ny, uu * all_nx, uu * all_ny])
    abau, w_val = robust_lstsq(A_val, all_vn)
    res_val = all_vn - A_val @ abau
    rms_val = float(np.sqrt(np.mean(res_val ** 2)))

    v0 = all_vn[all_lab == 0]; v1 = all_vn[all_lab == 1]
    se = np.sqrt(v0.var() / max(len(v0), 1) + v1.var() / max(len(v1), 1))
    tstat = float(abs(v0.mean() - v1.mean()) / se) if se > 0 else 0.0
    two_groups = tstat > 5.0

    var_tot = float(np.sum((all_vn - all_vn.mean()) ** 2))
    r2_single = 1 - float(np.sum(res_single ** 2)) / var_tot
    r2_val = 1 - float(np.sum(res_val ** 2)) / var_tot

    if two_groups:
        family = "value_dependent_advection"
        coefficients = {
            "alpha_x": round(float(abau[0]), 5),
            "alpha_y": round(float(abau[1]), 5),
            "alpha_x_of_u": round(float(abau[2]), 5),
            "alpha_y_of_u": round(float(abau[3]), 5),
            "u_interface_LM": round(float(levels[0]), 5),
            "u_interface_MH": round(float(levels[1]), 5),
        }
        rms, confidence, r2 = rms_val, round(max(r2_val, 0.0), 4), r2_val
        rule = ("v_n = (a0 + a1*u) . n : interface normal speed depends linearly "
                "on the local field value (level-dependent transport). The two "
                "interfaces separate different plateau pairs and move at different "
                "speeds, so single-velocity advection is rejected.")
    else:
        family = "linear_advection"
        coefficients = {"alpha_x": round(float(alpha[0]), 5),
                        "alpha_y": round(float(alpha[1]), 5)}
        rms, confidence, r2 = rms_single, round(max(r2_single, 0.0), 4), r2_single
        rule = ("v_n = alpha . n : linear advection u_t = -alpha . grad u; all "
                "interfaces share one transport velocity.")

    governing = {
        "family": family,
        "rule": rule,
        "coefficients": coefficients,
        "confidence": confidence,
        "fit_residual_rms": round(rms, 5),
        "r_squared": round(r2, 4),
        "two_interface_speeds_detected": bool(two_groups),
        "t_stat_speed_difference": round(tstat, 2),
        "mean_speed_LM": round(float(v0.mean()), 4),
        "mean_speed_MH": round(float(v1.mean()), 4),
        "advection_comparison": {
            "family": "linear_advection",
            "alpha_x": round(float(alpha[0]), 5),
            "alpha_y": round(float(alpha[1]), 5),
            "fit_residual_rms": round(rms_single, 5),
            "r_squared": round(r2_single, 4),
        },
    }
    json.dump(governing, open("governing_model.json", "w"), indent=2)

    model_candidates = [
        {"family": "linear_advection",
         "motivation": ("Simplest rule tying temporal change to spatial "
                        "arrangement: u_t = -alpha_x*u_x - alpha_y*u_y. "
                        "Predicts every interface moves with one velocity "
                        "(v_n = alpha.n)."),
         "fit_residual_rms": round(rms_single, 5), "r_squared": round(r2_single, 4)},
        {"family": "value_dependent_advection",
         "motivation": ("Level-dependent transport u_t = -(a0+a1*u).grad u: the "
                        "interface speed depends on the local field value, so the "
                        "two interfaces (different plateau pairs) move at different "
                        "speeds. Chosen because the per-point normal speeds split "
                        "into two groups."),
         "fit_residual_rms": round(rms_val, 5), "r_squared": round(r2_val, 4)},
        {"family": "isotropic_diffusion",
         "motivation": ("Alternative smoothing rule u_t = D*(u_xx+u_yy) "
                        "(alpha_x=alpha_y=D). Would broaden/erase the narrow "
                        "transitions rather than translate them; rejected because "
                        "the plateaus stay sharp and the interfaces translate.")},
    ]
    json.dump(model_candidates, open("model_candidates.json", "w"), indent=2)

    res = res_val if two_groups else res_single
    absres = np.abs(res)
    scale = float(np.max(np.abs(all_vn)))
    pass_frac = float(np.mean(absres <= 0.2 * scale))
    consistency = {
        "median_residual": round(float(np.median(absres)), 5),
        "p90_residual": round(float(np.quantile(absres, 0.90)), 5),
        "pass_fraction_20pct": round(pass_frac, 4),
        "pass_criterion": f"|v_n - model| <= 0.20 * max|v_n| (= {0.2 * scale:.3f}) at curve points",
        "n_curve_points": int(len(all_vn)),
        "methodology": (
            "Field reconstructed per evaluation time by regularized "
            "thin-plate-spline RBF (smoothing=0.5) on a symmetric +-0.042 time "
            "window. Transition curves = level sets of u at each plateau midpoint, "
            "kept where |grad u| > 0.5*median. Unit transverse normal "
            "n = grad u/|grad u| (points toward increasing u). Signed normal speed "
            "v_n = -u_t/|grad u| (u_t from central/one-sided difference of "
            "reconstructed fields; positive = motion toward the higher-u side), "
            "spatially smoothed along the curve (r=0.5). Governing rule fit by "
            "least squares to v_n; residual = v_n - predicted. Single-velocity "
            f"advection rejected (residuals split by interface, t={tstat:.1f}); "
            "value-dependent rule retained."),
    }
    json.dump(consistency, open("consistency_report.json", "w"), indent=2)

    diag = {}
    idx0 = 0
    for k in range(len(ev)):
        mk = f"t_{k}"
        npts_k = len(speeds[mk])
        sel = np.arange(idx0, idx0 + npts_k)
        rr = absres[sel]
        diag[mk] = {
            "n_curve_points": int(npts_k),
            "median_residual": round(float(np.median(rr)), 5),
            "p90_residual": round(float(np.quantile(rr, 0.90)), 5),
            "mean_speed_LM": (round(float(all_vn[sel][all_lab[sel] == 0].mean()), 4)
                              if (all_lab[sel] == 0).any() else None),
            "mean_speed_MH": (round(float(all_vn[sel][all_lab[sel] == 1].mean()), 4)
                              if (all_lab[sel] == 1).any() else None),
        }
        idx0 += npts_k
    json.dump(diag, open("diagnostic_report.json", "w"), indent=2)

    make_figure(U, curves, ev)

    print("=== SUMMARY ===")
    print("plateau levels (data):", {k: round(float(v), 3)
          for k, v in [("low", med_low), ("mid", med_mid), ("high", med_high)]})
    for k in range(len(ev)):
        mk = f"t_{k}"
        ip = iface_pos[mk]
        lm = ip["iface_0"]["mean_x_plus_y"]; mh = ip["iface_1"]["mean_x_plus_y"]
        print(f"t={ev[k]:.4f}  npts_recon={npts[k]:3d}  LM(x+y)={lm:+.2f}  "
              f"MH(x+y)={mh:+.2f}  n_curve={len(speeds[mk])}")
    print(f"two_interface_speeds_detected = {two_groups}  (t={tstat:.1f})")
    print(f"mean v_n  LM={v0.mean():+.3f}  MH={v1.mean():+.3f}")
    print(f"governing family = {family}  rms={rms:.4f}  R2={governing['r_squared']}")
    print(f"  single-velocity advection: alpha=({alpha[0]:+.3f},{alpha[1]:+.3f}) "
          f"rms={rms_single:.4f} R2={r2_single:.3f}")
    print(f"  value-dependent: a0=({abau[0]:+.3f},{abau[1]:+.3f}) "
          f"a1=({abau[2]:+.3f},{abau[3]:+.3f}) rms={rms_val:.4f} R2={r2_val:.3f}")
    print("artifacts written.")


def make_figure(U, curves, ev):
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        fig, axes = plt.subplots(2, 3, figsize=(15, 10))
        vmax = np.percentile(U, 99.5); vmin = np.percentile(U, 0.5)
        for k, ax in enumerate(axes.ravel()):
            ax.imshow(U[k], extent=[xmin, xmax, ymin, ymax], origin="lower",
                      cmap="viridis", aspect="equal", vmin=vmin, vmax=vmax)
            c = curves[f"t_{k}"]
            ax.scatter(c[:, 0], c[:, 1], s=4, c="red", linewidths=0,
                       label="transition curve")
            ax.set_title(f"t = {ev[k]:.4f}")
            ax.set_xlabel("x"); ax.set_ylabel("y")
            if k == 0:
                ax.legend(loc="upper left", fontsize=8)
        cb = fig.colorbar(axes[0, 0].images[0], ax=axes.ravel().tolist(), pad=0.02)
        cb.set_label("reconstructed u")
        fig.suptitle("Reconstructed scalar field with detected transition curves")
        fig.tight_layout(rect=[0, 0, 1, 0.97])
        fig.savefig("reconstruction_slices.png", dpi=110)
        plt.close(fig)
        return
    except Exception as e:
        print("matplotlib unavailable, using numpy PNG fallback:", e)
    _fallback_figure(U, curves, ev)


def _fallback_figure(U, curves, ev):
    vmax = np.percentile(U, 99.5); vmin = np.percentile(U, 0.5)
    panels = []
    for k in range(len(ev)):
        img = _colorize(U[k], vmin, vmax)
        c = curves[f"t_{k}"]
        ii = np.clip(((c[:, 0] - xmin) / (xmax - xmin) * (N - 1)).astype(int), 0, N - 1)
        jj = np.clip(((c[:, 1] - ymin) / (ymax - ymin) * (N - 1)).astype(int), 0, N - 1)
        img[jj, ii] = [255, 40, 40]
        panels.append(img)
    W = N * 3 + 4 * 8; H = N * 2 + 3 * 8
    canvas = np.zeros((H, W, 3), dtype=np.uint8)
    for k in range(6):
        r, col = k // 3, k % 3
        y0 = 8 + r * (N + 8); x0 = 8 + col * (N + 8)
        canvas[y0:y0 + N, x0:x0 + N] = panels[k]
    _write_png("reconstruction_slices.png", canvas)


def _colorize(Uk, vmin, vmax):
    z = np.clip((Uk - vmin) / max(vmax - vmin, 1e-9), 0, 1)
    ramp = np.array([[68, 1, 84], [59, 82, 139], [33, 145, 140],
                     [94, 201, 98], [253, 231, 37]], dtype=float)
    idx = z * (len(ramp) - 1)
    lo = np.floor(idx).astype(int).ravel()
    hi = np.clip(lo + 1, 0, len(ramp) - 1)
    f = (idx - np.floor(idx)).ravel()[:, None]
    rgb = (1 - f) * ramp[lo] + f * ramp[hi]
    return rgb.reshape(N, N, 3).astype(np.uint8)


def _write_png(path, arr):
    h, w, _ = arr.shape

    def chunk(typ, data):
        c = typ + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)

    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(h))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    open(path, "wb").write(png)


if __name__ == "__main__":
    main()
