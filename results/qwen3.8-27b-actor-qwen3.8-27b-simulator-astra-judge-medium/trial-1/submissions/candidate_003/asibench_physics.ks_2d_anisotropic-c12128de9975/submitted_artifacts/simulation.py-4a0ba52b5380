"""
B3: 2D Nonlinear Field Prediction - complete analysis + simulation.

PRIMARY METHOD (per researcher): modal spectral extrapolation.
  The observed field is anisotropic and nearly rank-1 (POD mode 0 = 99.0% of
  energy).  A pure-Fourier tail fit proved too lossy (hold-out 7.6%), so we use
  the equivalent but superior POD (SVD) modal basis: track the temporal
  coefficients of the top-K spatial modes, fit each with a BOUNDED model
  (sigmoid / exponential-saturation for the slowly saturating dominant modes,
  constant+sinusoid for the small oscillatory modes), validate on a hold-out,
  then extrapolate to the target time.  Only bounded models are used so that
  nothing diverges on the 3x extrapolation.
"""
import json
import numpy as np
from scipy.optimize import curve_fit

# ---------------- 0. Load data ----------------
with open("data/system_info.json") as fh:
    info = json.load(fh)
field = np.load("data/field_evolution.npy")   # (n_obs, Nx, Ny)
ic    = np.load("data/initial_condition.npy")  # (Nx, Ny)
n_obs, Nx, Ny = field.shape
dx, dy = float(info["dx"]), float(info["dy"])
target_time = float(info["target_time"])
obs_time    = float(info["observation_time"])
dt = obs_time / (n_obs - 1)
t_obs = np.arange(n_obs) * dt
kx = np.fft.fftfreq(Nx, dx); ky = np.fft.fftfreq(Ny, dy)
KX, KY = np.meshgrid(kx, ky, indexing="ij")
R = np.sqrt(KX**2 + KY**2); kmax = R.max()
F = np.fft.fft2(field, axes=(1, 2))
print("=== DATA ===")
print(f"field {field.shape} {field.dtype}  ic {ic.shape} {ic.dtype}")
print(f"ic==f[0]: {np.allclose(ic, field[0])}  dt={dt:.4f}  obs[0,{obs_time}] target={target_time}")
print(f"field min/max/mean={field.min():.4f}/{field.max():.4f}/{field.mean():.3e}  finite={np.all(np.isfinite(field))}")

# ---------------- 1. POD (SVD) modal decomposition ----------------
X = field.transpose(1, 2, 0).reshape(Nx * Ny, n_obs)   # (P, n)  [snapshot = last axis]
U, s, Vt = np.linalg.svd(X, full_matrices=False)
a_all = s[:, None] * Vt                                 # (nmodes, n) temporal coefficients
energy = s**2; frac = np.cumsum(energy) / energy.sum()
K = 8                                                    # top-8 modes -> 99.978% of energy
print(f"\n=== POD ===  K={K}  energy captured={frac[K-1]*100:.4f}%")

# ---------------- 2. Bounded per-coefficient models ----------------
def _expsat(t, L, A, tau):
    return L + A * np.exp(-t / (np.abs(tau) + 1e-9))
def _sig(t, L, A, t0, sd):
    sd = np.abs(sd) + 1e-6
    z = np.clip((t - t0) / sd, -50, 50)
    return L + A / (1.0 + np.exp(-z))
PERIODS = [4, 5, 6, 8, 10, 12, 20]
def fit_coeff(tt, a):
    """Return the best (lowest in-sample rel-RMSE) BOUNDED model for a(t)."""
    base = np.sqrt(np.mean(a**2)) + 1e-30
    out = []
    def add(rmse, pen, name, fn):
        out.append((rmse, pen, name, fn))
    c0 = float(np.mean(a))
    add(np.sqrt(np.mean((a - c0)**2)) / base, 1, "const", lambda t, c0=c0: c0)
    for T in PERIODS:
        w = 2 * np.pi / T
        Xd = np.column_stack([np.ones_like(tt), np.cos(w * tt), np.sin(w * tt)])
        cc = np.linalg.lstsq(Xd, a, rcond=None)[0]
        fn = (lambda cc=cc, T=T: (lambda t: cc[0] + cc[1]*np.cos(2*np.pi*t/T) + cc[2]*np.sin(2*np.pi*t/T)))()
        add(np.sqrt(np.mean((a - Xd @ cc)**2)) / base, 2 + T, f"sin{T}", fn)
    try:
        p0 = [a.mean(), (a.max()-a.min())/2, tt[len(tt)//2], 2.0]
        p, _ = curve_fit(_sig, tt, a, p0=p0, maxfev=40000)
        add(np.sqrt(np.mean((a - _sig(tt, *p))**2)) / base, 30, "sig", lambda t, p=p: _sig(t, *p))
    except Exception:
        pass
    try:
        p0 = [a.min(), a[0]-a.min(), 5.0]
        p, _ = curve_fit(_expsat, tt, a, p0=p0, maxfev=40000)
        add(np.sqrt(np.mean((a - _expsat(tt, *p))**2)) / base, 31, "expsat", lambda t, p=p: _expsat(t, *p))
    except Exception:
        pass
    out.sort(key=lambda x: (x[0], x[1]))
    return out[0]   # (relRMSE, penalty, name, fn)

def build_models(ttr, atr, K):
    return [fit_coeff(ttr, atr[j]) for j in range(K)]

def recon(t_eval, bests, K):
    A = np.array([[b[3](te) for b in bests] for te in t_eval]).T   # (K, len)
    return (U[:, :K] @ A).reshape(Nx, Ny, -1).transpose(2, 0, 1)

# ---------------- 3. VALIDATION (train t<=7.5, predict hold-out t=8..10) ----------------
tr = t_obs <= 7.5 + 1e-9; ho = ~tr
bests_hold = build_models(t_obs[tr], a_all[:, tr], K)
r_hold = recon(t_obs[ho], bests_hold, K)
nrmse_hold = float(np.sqrt(np.mean((r_hold - field[ho])**2) / np.mean(field[ho]**2)))
print(f"\n=== VALIDATION (train t<={t_obs[tr][-1]:.1f}, hold-out t={t_obs[ho][0]:.1f}..{t_obs[ho][-1]:.1f}) ===")
print(f"hold-out NRMSE = {nrmse_hold*100:.4f}%  (n_hold={ho.sum()})")

# ---------------- 4. FINAL MODEL (full window) + prediction at target ----------------
bests = build_models(t_obs, a_all, K)
r_full = recon(t_obs, bests, K)
nrmse_full = float(np.sqrt(np.mean((r_full - field)**2) / np.mean(field**2)))
print(f"\n=== FINAL MODEL (full t=[0,{t_obs[-1]:.1f}]) ===  in-window NRMSE = {nrmse_full*100:.4f}%")
print("per-mode models (name, in-sample relRMSE, a(0), a(10), a(30)):")
for j, b in enumerate(bests):
    print(f"  mode {j}: {b[2]:7s} relRMSE={b[0]*100:7.3f}%  a0={b[3](0.0):8.2f} a10={b[3](10.0):8.2f} a30={b[3](target_time):8.2f}")
predicted_field = np.asarray(recon([target_time], bests, K)[0], dtype=float)
assert np.all(np.isfinite(predicted_field))
print(f"predicted_field {predicted_field.shape} min={predicted_field.min():.3f} max={predicted_field.max():.3f} std={predicted_field.std():.3f}")
print(f"predicted std / f[10] std = {predicted_field.std()/field[-1].std():.3f}  corr w/ f[10] = {np.dot(predicted_field.ravel(), field[-1].ravel())/(np.linalg.norm(predicted_field)*np.linalg.norm(field[-1])):.3f}")

# ---------------- 5. SCORED QUANTITIES ----------------
def radial_psd(arr):
    Pp = np.abs(np.fft.fft2(arr))**2 / arr.size
    sd = np.zeros(65)
    for b in range(65):
        lo = b * kmax / 65; hi = (b + 1) * kmax / 65
        msk = (R >= lo) & (R <= hi + 1e-12) if b == 64 else (R >= lo) & (R < hi)
        sd[b] = Pp[msk].mean()
    return sd
spectral_density = radial_psd(predicted_field)
assert spectral_density.shape == (65,) and np.all(np.isfinite(spectral_density))
Pavg_rad = np.mean([radial_psd(field[i]) for i in range(n_obs)], axis=0)
rad = (np.arange(65) + 0.5) * kmax / 65
peak_bin = int(np.argmax(Pavg_rad))
sel = (rad >= rad[peak_bin]) & (rad < 0.65 * kmax) & (Pavg_rad > 0)
decay_exponent = float(np.polyfit(np.log(rad[sel]), np.log(Pavg_rad[sel]), 1)[0])
print(f"\nradial PSD: peak bin={peak_bin} (R~{rad[peak_bin]:.4f})  decay_exponent={decay_exponent:.3f} (npts={sel.sum()})")

def first_zero_lag(ac):
    sb = np.signbit(ac); idx = np.where(np.diff(sb) != 0)[0]
    if len(idx) == 0:
        return None
    i = int(idx[0]); return i + ac[i] / (ac[i] - ac[i + 1])
# temporal_decay_scale : first zero of mean-centered center-pixel autocorr
cx, cy = Nx // 2, Ny // 2
cp = field[:, cx, cy].astype(float); cp = cp - cp.mean()
ac_t = np.correlate(cp, cp, mode="full")[len(cp) - 1:]; ac_t = ac_t / ac_t[0]
zl = first_zero_lag(ac_t)
temporal_decay_scale = float(zl * dt) if zl is not None else obs_time / 4.0
print(f"temporal_decay_scale: center-pixel autocorr first zero lag {zl:.3f} -> {temporal_decay_scale:.4f} s")
# directional coherence lengths : first zero of averaged periodic line autocorr
def line_autocorr_first_zero(s, axis):
    if axis == 1:
        L = s.shape[1]; cl = s - s.mean(axis=1, keepdims=True)
        ac = np.array([(cl * np.roll(cl, -lag, axis=1)).mean() for lag in range(L)])
    else:
        L = s.shape[0]; cl = s - s.mean(axis=0, keepdims=True)
        ac = np.array([(cl * np.roll(cl, -lag, axis=0)).mean() for lag in range(L)])
    return first_zero_lag(ac)
ref = field[n_obs // 2]
lag_x = line_autocorr_first_zero(ref, axis=1)
lag_y = line_autocorr_first_zero(ref, axis=0)
coherence_length_1 = float(lag_x * dx); coherence_length_2 = float(lag_y * dy)
print(f"coherence_length_1 (x): lag {lag_x:.3f}*dx -> {coherence_length_1:.4f}")
print(f"coherence_length_2 (y): lag {lag_y:.3f}*dy -> {coherence_length_2:.4f}")
# dominant spatial frequencies (time-averaged marginal spectra)
Pavg = (np.abs(F)**2).mean(axis=0)
Sx = Pavg.sum(axis=1); Sy = Pavg.sum(axis=0)
ix = int(np.argmax(Sx)); iy = int(np.argmax(np.where(ky != 0, Sy, 0.0)))
characteristic_scale_1 = float(abs(kx[ix])); characteristic_scale_2 = float(abs(ky[iy]))
structural_ratio = coherence_length_1 / coherence_length_2
print(f"characteristic_scale_1 (dom |kx|) = {characteristic_scale_1:.5f}")
print(f"characteristic_scale_2 (dom nonzero |ky|) = {characteristic_scale_2:.5f}")
print(f"structural_ratio = {structural_ratio:.4f}")

# ---------------- 6. divergence_measure : Fourier flow-map surrogate ----------------
# Track top conjugate-symmetric Fourier modes; fit amplitude (quadratic) & phase
# (linear); the linear flow map over [ta,tb] multiplies mode k by
#   G_k = [A_k(tb)/A_k(ta)] * exp(i*(phi_k(tb)-phi_k(ta))).
def conj_idx(i, j):
    return (Nx - i) % Nx, (Ny - j) % Ny
P0 = np.abs(F[0])**2; order = np.argsort(P0.ravel())[::-1]
S = set(); cum = 0.0; tot = P0.sum()
for o in order:
    i, j = np.unravel_index(o, P0.shape); ci, cj = conj_idx(i, j)
    add = 0.0
    if (i, j) not in S: S.add((i, j)); add += P0[i, j]
    if (ci, cj) not in S: S.add((ci, cj)); add += P0[ci, cj]
    cum += add
    if cum / tot > 0.999 or len(S) > 200: break
S = sorted(S); Mf = len(S)
fmi = np.array([i for i, j in S]); fmj = np.array([j for i, j in S])
AmpF = np.zeros((n_obs, Mf)); PhF = np.zeros((n_obs, Mf))
for m in range(Mf):
    vals = F[:, fmi[m], fmj[m]]; AmpF[:, m] = np.abs(vals); PhF[:, m] = np.unwrap(np.angle(vals))
# fit amplitude (quadratic, floored positive) and phase (linear)
Afit = np.zeros((Mf, 3)); Pfit = np.zeros((Mf, 2))
for m in range(Mf):
    Afit[m] = np.polyfit(t_obs, AmpF[:, m], 2)
    Pfit[m] = np.polyfit(t_obs, PhF[:, m], 1)
def ampF(m, t):
    return max(float(np.polyval(Afit[m], t)), 1e-6)
def phF(m, t):
    return float(np.polyval(Pfit[m], t))
def evolve4(v, ta, tb):
    Fv = np.fft.fft2(v); out = np.zeros((Nx, Ny), dtype=complex)
    for m in range(Mf):
        G = (ampF(m, tb) / ampF(m, ta)) * np.exp(1j * (phF(m, tb) - phF(m, ta)))
        out[fmi[m], fmj[m]] = Fv[fmi[m], fmj[m]] * G
    return np.real(np.fft.ifft2(out))
rng = np.random.default_rng(1729)
pert = rng.standard_normal((Nx, Ny)); pert = pert - pert.mean(); pert = pert / np.linalg.norm(pert) * 1e-8
T_eff = min(target_time, 8.0); seg = 2.0; n_seg = int(round(T_eff / seg))
u0 = ic.copy(); u1 = ic + pert; d0 = float(np.linalg.norm(u1 - u0))
seg_growth = []
for i in range(n_seg):
    ta = i * seg; tb = (i + 1) * seg
    u0 = evolve4(u0, ta, tb); u1 = evolve4(u1, ta, tb)
    d = float(np.linalg.norm(u1 - u0)); seg_growth.append(d / 1e-8)
    if i < n_seg - 1:
        sep = u1 - u0; u1 = u0 + sep / d * 1e-8
d_Teff = float(np.linalg.norm(u1 - u0))
divergence_measure = float((1.0 / T_eff) * np.log(d_Teff / d0))
print(f"\ndivergence_measure: T_eff={T_eff} n_seg={n_seg} Mf={Mf} d0={d0:.3e} d(T_eff)={d_Teff:.3e} -> {divergence_measure:.6f}")
print(f"  per-segment growth (x1e-8): {[round(g,5) for g in seg_growth]}")

# ---------------- 7. JSON + array outputs ----------------
data_exploration = {"characteristic_scale_1": characteristic_scale_1,
                    "characteristic_scale_2": characteristic_scale_2,
                    "temporal_decay_scale":   temporal_decay_scale,
                    "decay_exponent":         decay_exponent,
                    "structural_ratio":       structural_ratio}
physical_quantities = {"divergence_measure":     divergence_measure,
                       "coherence_length_1":     coherence_length_1,
                       "coherence_length_2":     coherence_length_2,
                       "characteristic_scale_1": characteristic_scale_1,
                       "characteristic_scale_2": characteristic_scale_2,
                       "structural_ratio":       structural_ratio}
for k, v in {**data_exploration, **physical_quantities}.items():
    assert np.isfinite(v), k
json.dump(data_exploration, open("data_exploration.json", "w"), indent=2)
json.dump(physical_quantities, open("physical_quantities.json", "w"), indent=2)
print("\n=== data_exploration.json ===");  print(json.dumps(data_exploration, indent=2))
print("=== physical_quantities.json ==="); print(json.dumps(physical_quantities, indent=2))
np.save("predicted_field.npy", predicted_field.astype(np.float64))
np.save("spectral_density.npy", spectral_density.astype(np.float64))
print("saved predicted_field.npy, spectral_density.npy")

# ---------------- 8. Visualizations (matplotlib if present, else pure-Python PNG) ----------------
panel_idx = [0, 4, 8, 12, 16, 20]
vlim = (np.percentile(field, 1), np.percentile(field, 99))
fitp = np.polyfit(np.log(rad[sel]), np.log(Pavg_rad[sel]), 1)

def _fallback_png():
    import zlib, struct
    def write_png(path, rgb):
        h, w, _ = rgb.shape
        raw = b"".join(b"\x00" + rgb[i].tobytes() for i in range(h))
        def chunk(typ, data):
            return struct.pack(">I", len(data)) + typ + data + struct.pack(">I", zlib.crc32(typ + data) & 0xffffffff)
        with open(path, "wb") as f:
            f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
                    + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))
    def coolwarm(t):
        t = np.clip(t, 0, 1); shape = t.shape; t = t.ravel()
        blue = np.array([59, 76, 192]); white = np.array([230, 230, 230]); red = np.array([180, 4, 38])
        lo = blue + (white - blue) * (t / 0.5)[:, None]
        hi = white + (red - white) * ((t - 0.5) / 0.5)[:, None]
        return np.clip(np.where(t[:, None] < 0.5, lo, hi), 0, 255).astype(np.uint8).reshape(shape + (3,))
    def field_img(arr2d, size=(170, 170)):
        t = np.clip((arr2d - vlim[0]) / (vlim[1] - vlim[0]), 0, 1)
        H, W = size
        rows = (np.arange(H) * arr2d.shape[0] / H).astype(int)
        cols = (np.arange(W) * arr2d.shape[1] / W).astype(int)
        return coolwarm(t[np.ix_(rows, cols)])
    def line_plot(x, y, logy=False, W=320, H=220, color=(200, 0, 0)):
        img = np.full((H, W, 3), 255, np.uint8)
        ml, mr, mt, mb = 45, 12, 22, 34
        pw, ph = W - ml - mr, H - mt - mb
        yv = np.log10(np.maximum(y, 1e-30)) if logy else y.astype(float)
        x0, x1 = x.min(), x.max(); y0, y1 = yv.min(), yv.max()
        cols = np.clip(np.round(ml + (x - x0) / (x1 - x0 + 1e-30) * pw).astype(int), 0, W - 1)
        pys = np.clip(np.round(mt + ph - (yv - y0) / (y1 - y0 + 1e-30) * ph).astype(int), 0, H - 1)
        img[pys, cols] = color
        img[mt:mt + ph + 1, ml] = 40; img[mt:mt + ph + 1, ml + pw] = 40
        img[mt + ph, ml:ml + pw + 1] = 40; img[mt, ml:ml + pw + 1] = 40
        return img
    def tile(images, cols, gap=8, bg=255):
        rows = (len(images) + cols - 1) // cols
        h, w = images[0].shape[:2]
        canvas = np.full((rows * (h + gap) + gap, cols * (w + gap) + gap, 3), bg, np.uint8)
        for k, im in enumerate(images):
            r, c = divmod(k, cols)
            canvas[gap + r*(h+gap):gap + r*(h+gap)+h, gap + c*(w+gap):gap + c*(w+gap)+w] = im
        return canvas
    write_png("field_visualization.png", tile([field_img(field[i]) for i in panel_idx] + [field_img(predicted_field)], 3))
    write_png("spectral_visualization.png", tile(
        [line_plot(rad, spectral_density, logy=True, color=(200, 0, 0)),
         line_plot(rad, Pavg_rad, logy=True, color=(0, 120, 0)),
         line_plot(kx, Sx / Sx.sum(), logy=False, color=(0, 0, 200)),
         line_plot(ky, Sy / Sy.sum(), logy=False, color=(180, 0, 180))], 2))
    print("saved field_visualization.png, spectral_visualization.png (pure-Python fallback)")

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(2, 3, figsize=(15, 9))
    for ax, i in zip(axes.ravel(), panel_idx):
        ax.imshow(field[i], origin="lower", cmap="coolwarm", vmin=vlim[0], vmax=vlim[1],
                  extent=[0, Nx*dx, 0, Ny*dy]); ax.set_title(f"observed t={t_obs[i]:.1f} s")
        ax.set_xlabel("x"); ax.set_ylabel("y")
    ax = axes.ravel()[-1]
    im = ax.imshow(predicted_field, origin="lower", cmap="coolwarm", vmin=vlim[0], vmax=vlim[1],
                   extent=[0, Nx*dx, 0, Ny*dy]); ax.set_title(f"PREDICTED t={target_time:.1f} s")
    ax.set_xlabel("x"); ax.set_ylabel("y")
    fig.suptitle("B3: 2D nonlinear field evolution (observed) + POD modal extrapolation (predicted)", fontsize=13)
    fig.colorbar(im, ax=axes.ravel().tolist(), label="field amplitude")
    fig.tight_layout(rect=[0, 0, 1, 0.97]); fig.savefig("field_visualization.png", dpi=130); plt.close(fig)
    fig, axes = plt.subplots(2, 2, figsize=(13, 9))
    ax = axes[0, 0]
    ax.semilogy(rad, spectral_density, "o-", ms=3, label="predicted field (t=30)")
    ax.semilogy(rad, Pavg_rad, "s-", ms=3, label="time-averaged observed")
    ax.axvline(0.65 * kmax, color="gray", ls="--", lw=0.8)
    ax.set_xlabel("radial wavenumber k"); ax.set_ylabel("|FFT|^2 / N (radial mean)")
    ax.set_title("Radially averaged power spectrum (65 annuli)"); ax.legend()
    ax = axes[0, 1]
    ax.semilogy(rad, Pavg_rad, "s-", ms=3, color="steelblue")
    ax.semilogy(rad[sel], Pavg_rad[sel], "o-", ms=3, color="red", label="fit region")
    ax.semilogy(rad[sel], np.exp(np.polyval(fitp, np.log(rad[sel]))), color="green", ls="--",
                label=f"fit slope={decay_exponent:.2f}")
    ax.set_xlabel("radial wavenumber k"); ax.set_ylabel("|FFT|^2 / N")
    ax.set_title(f"decay_exponent={decay_exponent:.2f} (peak<k<0.65$k_max)"); ax.legend()
    ax = axes[1, 0]
    ax.plot(kx, Sx / Sx.sum(), "-."); ax.axvline(characteristic_scale_1, color="red", ls="--",
            label=f"dominant kx={characteristic_scale_1:.4f}")
    ax.set_xlabel("kx"); ax.set_ylabel("marginal power (norm.)"); ax.set_title("Directional spectrum (x)"); ax.legend()
    ax = axes[1, 1]
    ax.plot(ky, Sy / Sy.sum(), "-."); ax.axvline(characteristic_scale_2, color="red", ls="--",
            label=f"dominant nonzero ky={characteristic_scale_2:.4f}")
    ax.set_xlabel("ky"); ax.set_ylabel("marginal power (norm.)"); ax.set_title("Directional spectrum (y)"); ax.legend()
    fig.suptitle("B3: field spectra (radial + directional)", fontsize=13)
    fig.tight_layout(rect=[0, 0, 1, 0.97]); fig.savefig("spectral_visualization.png", dpi=130); plt.close(fig)
    print("saved field_visualization.png, spectral_visualization.png (matplotlib)")
except Exception as _e:
    print("matplotlib unavailable/failed:", _e, "-> using fallback")
    _fallback_png()
print("\nDONE.")
