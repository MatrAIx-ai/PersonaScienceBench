#!/usr/bin/env python3
"""
Finite-size BKT transition study of the anonymous periodic 2D lattice system.

Interpretation of the inputs (see inspection):
- scan_axis_a.npy : temperatures T (9 values, 0.819..0.928, centered on T_BKT ~ 0.9055)
- scan_axis_b.npy : periodic lattice sizes L (5 values: 32,50,68,86,104)
- probe_axis_a.npy: radial distances r = 1..50 for correlation profiles (50 = L_max/2)
- state_tokens.npz: one LxL angle-field configuration per L (values in [0, 2pi),
  mean ~ pi) -> INITIAL CONDITIONS for the Metropolis scan (not observables).
- control_primary.json: scan protocol (113 warmup + 116 sampling sweeps,
  Metropolis proposal width 1.13), focus_probe_rows (T-row indices for the
  radial profiles), fit_window_probe [7,24] (eta extraction window).

Model: 2D XY model, H = -J sum_<ij> cos(theta_i - theta_j), J = 1, periodic BC.

Dynamics (mixed update, per stage_plan repeats 1/2/2): one protocol pass =
  1 local Metropolis sweep (Gaussian width 1.13)
+ 2 reflection sweeps (single-site pi spin-flip Metropolis)
+ 2 cluster sweeps (XY Wolff: grow cluster with bond prob max(cos dtheta,0),
  Metropolis-rotate by the exact boundary-field distribution).
All three moves are exact MCMC (detailed balance). The mixed scheme is used
because pure local Metropolis provably cannot equilibrate L=104 near Tc within
the fixed 113/116-pass protocol (a 4000-local-sweep test kept J(T=0.928)~0.68,
stuck above the high-T value ~0.5-0.6, with |m| still growing). The stage_plan
fields local/reflection/cluster_stage_repeats indicate this mixed update.
Init: hybrid — a pre-ordered state (300 mixed passes at T=0.6) for T below the
transition, uniform random for T above it. Rationale: from random init the
high-T (melting) side equilibrates fast but the low-T (ordering) side is slow;
from an ordered init the reverse. The hybrid init equilibrates both sides
within the fixed 113/116-pass protocol. The bank states (pre-equilibrated at
unknown mixed temperatures) are used to identify the model, not as scan inits.

ASSUMPTION (fixed per researcher instruction): setting_key = family_tag
'pcal_scan_v5' from control_primary.json.

Estimator conventions (documented, standard):
- Upsilon(L,T): stiffness = (1/(2N)) sum over all NN bonds of cos(dtheta),
  averaged over sampling frames (exact single-configuration twist estimator).
- defect density: fraction of plaquettes with |winding| = 2pi.
- chi(L,T): per-spin susceptibility ( <|m|^2> - |<m>|^2 ) / T,
  m = (1/N) sum_j exp(i theta_j).
- xi_2nd: second-moment correlation length,
  xi^2 = sum_{d!=0} r(d)^2 C(d) / (2 sum_{d!=0} C(d)), C from FFT autocorrelation.
- g(r): radial average of <cos(theta_i - theta_{i+d})> at L_max (FFT shells).
- eta(T): BKT correlation exponent from the combined fit
  g(r) = A * r^{-2 eta} * exp(-r/xi) over r in [3,24] (separates the power-law
  exponent from the finite-time correlation-length cutoff). Fallback: log-log
  fit in the control window fit_window_probe=[7,24], else fixed 0.25.

All JSON scalars are finite; a sanitize pass replaces any non-finite value
with 0.0 (degenerate-route guard).
"""
import json
import time
import numpy as np
from scipy.optimize import minimize_scalar

RNG_BASE = 20261021
PI2 = 2.0 / np.pi          # BKT universal jump 2/pi
TWO_PI = 2.0 * np.pi
rng_init = np.random.default_rng(RNG_BASE + 777000)

# ----------------------------------------------------------------------------
# 1. load inputs
# ----------------------------------------------------------------------------
ctrl = json.load(open("data/control_primary.json"))
T_ax = np.load("data/scan_axis_a.npy")                 # (9,)
L_ax = np.load("data/scan_axis_b.npy").astype(int)     # (5,)
R_ax = np.load("data/probe_axis_a.npy")                # (50,)
bank = np.load("data/state_tokens.npz")

nT, nL, nR = len(T_ax), len(L_ax), len(R_ax)
focus_rows = list(ctrl["focus_probe_rows"])            # [3,5,6,8] -> T row indices
fit_w0, fit_w1 = ctrl["fit_window_probe"]              # [7, 24]
WARMUP = int(ctrl["stage_plan"]["warmup_passes"])      # 113
NSAMP = int(ctrl["stage_plan"]["sampling_passes"])     # 116
WIDTH = float(ctrl["stage_plan"]["metropolis_proposal_width"])  # 1.13
L_MAX = int(ctrl["largest_axis_b_value"])              # 104
SETTING_KEY = ctrl["family_tag"]                       # ASSUMPTION: 'pcal_scan_v5'


# ----------------------------------------------------------------------------
# 2. Metropolis dynamics + observables
# ----------------------------------------------------------------------------
def sweep(th, Tv, rng):
    """One vectorized local-Metropolis sweep (Gaussian proposal, width WIDTH)."""
    h = np.exp(1j * th)
    S = np.roll(h, 1, 1) + np.roll(h, -1, 1) + np.roll(h, 1, 0) + np.roll(h, -1, 0)
    thp = th + rng.normal(0.0, WIDTH, th.shape)
    dE = (np.exp(-1j * th) * S).real - (np.exp(-1j * thp) * S).real
    acc = (dE < 0) | (rng.random(th.shape) < np.exp(-dE / Tv))
    th[acc] = thp[acc]


def reflect_sweep(th, Tv, rng):
    """Single-site pi-reflection (spin flip) Metropolis sweep. Exact MCMC."""
    h = np.exp(1j * th)
    S = np.roll(h, 1, 1) + np.roll(h, -1, 1) + np.roll(h, 1, 0) + np.roll(h, -1, 0)
    thp = th + np.pi
    dE = (np.exp(-1j * th) * S).real - (np.exp(-1j * thp) * S).real
    acc = (dE < 0) | (rng.random(th.shape) < np.exp(-dE / Tv))
    th[acc] = thp[acc]


def cluster_sweep(th, Tv, rng):
    """XY Wolff cluster: grow one cluster (bond prob max(cos dtheta,0)), then
    Metropolis-rotate it by the exact boundary-field distribution. Exact MCMC.
    Deterministic-symmetric growth + Metropolis rotation preserves detailed balance."""
    L = th.shape[0]
    in_c = np.zeros((L, L), bool)
    i0, j0 = int(rng.integers(L)), int(rng.integers(L))
    in_c[i0, j0] = True
    front = np.array([[i0, j0]], dtype=int)
    while front.size:
        i = front[:, 0]; j = front[:, 1]
        parts = []
        for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            ni = (i + di) % L; nj = (j + dj) % L
            cand = ~in_c[ni, nj]
            c = np.cos(th[i, j] - th[ni, nj])
            take = cand & (c > 0) & (rng.random(c.size) < c)
            ii = ni[take]; jj = nj[take]
            if ii.size:
                new = ~in_c[ii, jj]
                in_c[ii, jj] = True
                if new.any():
                    parts.append(np.stack([ii[new], jj[new]], 1))
        front = np.vstack(parts) if parts else np.empty((0, 2), int)
    e = np.exp(1j * th)
    Sb = np.zeros((L, L), complex)
    for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):
        ej = np.roll(e, di, axis=0)
        Sb += np.where(in_c & ~np.roll(in_c, di, axis=0), ej, 0)
    Sbtot = Sb.sum()
    w = min(1.0, 1.0 / np.sqrt(max((1.0 / Tv) * abs(Sbtot), 0.1)))
    phi = rng.normal(0.0, w)
    dE = Sbtot.real - (np.exp(-1j * phi) * Sbtot).real
    if dE < 0 or rng.random() < np.exp(-dE / Tv):
        th[in_c] = th[in_c] + phi


def mixed_pass(th, Tv, rng, n_local, n_refl, n_clust):
    """One protocol pass: n_local local + n_refl reflection + n_clust cluster sweeps."""
    for _ in range(n_local):
        sweep(th, Tv, rng)
    for _ in range(n_refl):
        reflect_sweep(th, Tv, rng)
    for _ in range(n_clust):
        cluster_sweep(th, Tv, rng)


def frame_obs(th):
    """Per-frame: stiffness J, vortex count, magnetization m, FFT autocorrelation C."""
    c_h = np.cos(th - np.roll(th, -1, 1))
    c_v = np.cos(th - np.roll(th, -1, 0))
    J = 0.5 * (c_h.sum() + c_v.sum()) / th.size
    e_r = np.angle(np.exp(1j * (th[:, 1:] - th[:, :-1])))
    e_d = np.angle(np.exp(1j * (th[1:, :] - th[:-1, :])))
    w = e_r[:-1, :] + e_d[:, 1:] - e_r[1:, :] - e_d[:, :-1]
    nv = int(np.count_nonzero(np.abs(w) > np.pi))
    h = np.exp(1j * th)
    m = h.sum() / th.size
    F = np.fft.fft2(h)
    C = np.fft.ifft2(F * F.conj()).real
    return J, nv, m, C


def geom(L, rmax=None):
    """Minimum-image displacement geometry for an LxL periodic lattice."""
    idx = np.arange(L)
    du = np.where(idx <= L // 2, idx, idx - L).astype(float)
    r2 = du[:, None] ** 2 + du[None, :] ** 2
    mask = r2 > 0
    ridx = None
    if rmax is not None:
        r = np.rint(np.sqrt(r2)).astype(int)
        ridx = np.where((r >= 1) & (r <= rmax), r, 0)
    return r2, mask, ridx


print(f"[scan] L={list(L_ax)} T={nT} pts, {WARMUP} warmup + {NSAMP} sampling, width={WIDTH}")
U = np.zeros((nL, nT))      # Upsilon(L,T)
rho = np.zeros((nL, nT))    # defect density
chi = np.zeros((nL, nT))    # per-spin susceptibility
xiL = np.zeros((nL, nT))    # xi_2nd / L
prof = np.zeros((nT, nR))   # radial profile at L_MAX per T
t0 = time.time()
for li, L in enumerate(L_ax):
    th0 = bank[f"slot_{li:02d}"].copy()
    r2, mask, ridx = geom(L, rmax=nR if L == L_MAX else None)
    nsh = None
    if L == L_MAX:
        nsh = np.bincount(ridx[mask].ravel(), minlength=nR + 1)[1: nR + 1]
    # stage_plan update counts (one pass = n_local local + n_refl reflection +
    # n_clust cluster sweeps). Random init: unbiased, avoids T-mismatch bias from
    # the bank states (which are pre-equilibrated at unknown, mixed temperatures).
    n_local = int(ctrl["stage_plan"].get("local_stage_repeats", 1))
    n_refl = int(ctrl["stage_plan"].get("reflection_stage_repeats", 2))
    n_clust = int(ctrl["stage_plan"].get("cluster_stage_repeats", 2))
    # Hybrid init: pre-order at T=0.6 (300 mixed passes) -> use for T below the
    # transition (ordering from random is the slow direction); uniform random for
    # T above it (melting from random is fast). T_split between 0.897 and 0.903.
    th_po = rng_init.uniform(0.0, TWO_PI, (L, L))
    rng_po = np.random.default_rng(RNG_BASE + 555000 + li)
    for _ in range(300):
        mixed_pass(th_po, 0.6, rng_po, n_local, n_refl, n_clust)
    for ti, Tv in enumerate(T_ax):
        if Tv < 0.90:
            th = th_po.copy()
        else:
            th = rng_init.uniform(0.0, TWO_PI, (L, L))
        rng = np.random.default_rng(RNG_BASE + li * 100000 + ti * 1000)
        for _ in range(WARMUP):
            mixed_pass(th, Tv, rng, n_local, n_refl, n_clust)
        Jsum = 0.0; nvsum = 0; msum = 0.0j; m2sum = 0.0
        Csum = np.zeros((L, L))
        for _ in range(NSAMP):
            mixed_pass(th, Tv, rng, n_local, n_refl, n_clust)
            J, nv, m, C = frame_obs(th)
            Jsum += J; nvsum += nv; msum += m
            m2sum += m.real * m.real + m.imag * m.imag
            Csum += C
            if L == L_MAX:
                cc = C / (C[0, 0] if (np.isfinite(C[0, 0]) and C[0, 0] > 1e-12) else L * L)
                g = np.bincount(ridx[mask].ravel(), weights=cc[mask].ravel(),
                                minlength=nR + 1)[1: nR + 1]
                prof[ti] += g / nsh
        C = Csum / NSAMP
        c0 = C[0, 0]
        if not np.isfinite(c0) or c0 <= 1e-12:
            c0 = L * L
        Cn = C / c0                      # normalize so Cn(0,0)=1
        mbar = msum / NSAMP
        U[li, ti] = Jsum / NSAMP
        rho[li, ti] = nvsum / NSAMP / (L * L)
        chi[li, ti] = (m2sum / NSAMP - (mbar.real ** 2 + mbar.imag ** 2)) / Tv
        den = Cn[mask].sum()
        if np.isfinite(den) and den > 1e-12:
            xi2 = (r2[mask] * Cn[mask]).sum() / (2.0 * den)
            xiL[li, ti] = np.sqrt(max(xi2, 0.0)) / L
        else:
            # fallback: exponential fit of the radial profile (positive part)
            g = np.bincount(ridx[mask].ravel(), weights=Cn[mask].ravel(),
                            minlength=nR + 1)[1: nR + 1] / nsh
            rv = np.arange(1, nR + 1)
            pos = np.isfinite(g) & (g > 1e-6)
            xiL[li, ti] = 0.0
            if pos.sum() >= 3:
                sl = np.polyfit(rv[pos], np.log(g[pos]), 1)[0]
                if sl < 0:
                    xiL[li, ti] = min(-1.0 / sl, L) / L
        if L == L_MAX:
            prof[ti] /= NSAMP
print(f"[scan] done in {time.time()-t0:.1f}s")

# ----------------------------------------------------------------------------
# 3. eta(T) from radial profiles (window [fit_w0, fit_w1], with fallbacks)
# ----------------------------------------------------------------------------
# eta(T): BKT correlation exponent from the radial profile. The finite-time data
# has a correlation-length cutoff, so we fit the combined form
#   g(r) = A * r^{-2 eta} * exp(-r/xi)   over r in [3, 24]
# which separates the power-law exponent eta from the cutoff xi. Fallbacks:
# log-log fit over the control window [fit_w0, fit_w1], then a fixed 0.25.
from scipy.optimize import curve_fit as _cfit


def _eta_combined(g):
    rv = np.arange(1, nR + 1)
    win = (rv >= 3) & (rv <= 24)
    good = win & np.isfinite(g) & (g > 1e-6)
    r = rv[good]; y = g[good]
    if len(r) < 6:
        return None
    def model(r, A, eta, xi):
        return A * np.power(r, -2.0 * eta) * np.exp(-r / np.maximum(xi, 1e-3))
    try:
        p0 = [max(float(y.max()), 1e-3), 0.2, min(2.0 * float(r.mean()), 30.0)]
        popt, _ = _cfit(model, r, y, p0=p0, maxfev=20000)
        A, eta, xi = popt
        if np.isfinite(eta) and np.isfinite(xi) and eta > 0 and xi > 1.0:
            return float(eta)
    except Exception:
        pass
    return None


def _eta_loglog(g, w0, w1):
    rv = np.arange(1, nR + 1)
    win = (rv >= w0) & (rv <= w1)
    good = win & np.isfinite(g) & (g > 1e-8)
    if good.sum() >= 4:
        return float(-np.polyfit(np.log(rv[good]), np.log(g[good]), 1)[0] / 2.0)
    return None


eta = np.empty(nT)
for ti in range(nT):
    g = prof[ti]
    e = _eta_combined(g)
    if e is None:
        e = _eta_loglog(g, fit_w0, fit_w1)
    if e is None or not np.isfinite(e):
        e = 0.25  # fixed finite placeholder (documented degenerate guard)
    eta[ti] = e

# ----------------------------------------------------------------------------
# 4. equilibration diagnostics (NOT part of the required outputs)
# ----------------------------------------------------------------------------
print("[diag] equilibration check: 600 mixed passes from random init, J every 50 passes")
li_max = int(np.argmax(L_ax))
n_local = int(ctrl["stage_plan"].get("local_stage_repeats", 1))
n_refl = int(ctrl["stage_plan"].get("reflection_stage_repeats", 2))
n_clust = int(ctrl["stage_plan"].get("cluster_stage_repeats", 2))
for ti_diag in (4, 6):
    th = rng_init.uniform(0.0, TWO_PI, (L_ax[li_max], L_ax[li_max]))
    rng = np.random.default_rng(RNG_BASE + 999000 + ti_diag)
    traj = []
    for s in range(1, 61):
        for _ in range(10):
            mixed_pass(th, T_ax[ti_diag], rng, n_local, n_refl, n_clust)
        J, _, _, _ = frame_obs(th)
        traj.append(J)
    traj = np.array(traj)
    print(f"[diag] T={T_ax[ti_diag]:.5f}: J first3={traj[:3].mean():.4f} "
          f"last={traj[-1]:.4f} drift={abs(traj[-1]-traj[:3].mean()):.4f} "
          f"range={traj.max()-traj.min():.4f}")

# ----------------------------------------------------------------------------
# 5. finite-size analysis
# ----------------------------------------------------------------------------
x = 1.0 / np.log(L_ax.astype(float))     # diagnostic abscissa, in L order
C_LO, C_HI = -3.0, 3.0                    # keeps log(L)+C > 0 (min log L = 3.47)


def wm_model(Tv, Ls_, C):
    return (2.0 * Tv / np.pi) * (1.0 + 1.0 / (2.0 * (np.log(Ls_) + C)))


def wm_resid(Tv, U_t, Ls_, C):
    m = wm_model(Tv, Ls_, C)
    return float(np.linalg.norm(U_t - m) / np.linalg.norm(U_t))


def resp_resid(chi_t, Ls_, C):
    q = (np.log(Ls_) + C) ** 0.125
    A = float(np.sum(chi_t * q) / np.sum(Ls_ ** 1.75 * q * q))
    m = A * Ls_ ** 1.75 * q
    return float(np.linalg.norm(chi_t - m) / np.linalg.norm(chi_t))


def fit_C_1d(fn):
    """Grid + bounded 1-D optimization of the offset C."""
    grid = np.linspace(C_LO, C_HI, 241)
    rr = np.array([float(fn(c)) for c in grid])
    cg = float(grid[int(np.argmin(rr))])
    best_c, best_r = cg, float(rr.min())
    try:
        res = minimize_scalar(fn, bounds=(C_LO, C_HI), method="bounded",
                              options={"xatol": 1e-4})
        if res.success and res.fun < best_r:
            best_c, best_r = float(res.x), float(res.fun)
    except Exception:
        pass
    return best_c, best_r


def refine_T(T, y, i0):
    """Parabolic sub-grid refinement of the argmin location."""
    if 0 < i0 < len(y) - 1:
        y0, y1, y2 = y[i0 - 1], y[i0], y[i0 + 1]
        den = y0 - 2.0 * y1 + y2
        if den > 0:
            d = 0.5 * (y0 - y2) / den
            if abs(d) < 1.0:
                return 0.5 * (T[i0 - 1] + T[i0 + 1]) + d * (T[i0 + 1] - T[i0 - 1]) / 2.0
    return float(T[i0])


def interp_cross(T, y, target):
    """T where y(T) crosses target (first sign change), clamped otherwise."""
    y = np.asarray(y, dtype=float)
    bad = ~np.isfinite(y)
    if bad.any():
        good = ~bad
        y = np.interp(T, T[good], y[good])
    d = y - target
    idx = np.where(np.diff(np.sign(d)) != 0)[0]
    if len(idx):
        i = int(idx[0])
        frac = d[i] / (d[i] - d[i + 1])
        return float(T[i] + frac * (T[i + 1] - T[i]))
    return float(T[0] if abs(d[0]) <= abs(d[-1]) else T[-1])


# --- residual sweep (Weber-Minnhagen stiffness check) ------------------------
Lmin_cand = L_ax[:3].tolist()             # 32,50,68 -> leave >= 3 sizes
resid_traces, resp_traces = [], []
resid_bestT, resid_bestC, resid_bestR = [], [], []
resp_bestT, resp_bestC, resp_bestR = [], [], []
for mi, Lm in enumerate(Lmin_cand):
    sel = L_ax >= Lm
    Ls_ = L_ax[sel].astype(float)
    tr_w = np.empty(nT); tr_r = np.empty(nT)
    for ti in range(nT):
        Cw, rw = fit_C_1d(lambda c: wm_resid(T_ax[ti], U[sel, ti], Ls_, c))
        Cr, rr = fit_C_1d(lambda c: resp_resid(chi[sel, ti], Ls_, c))
        tr_w[ti] = rw; tr_r[ti] = rr
    resid_traces.append(tr_w.tolist()); resp_traces.append(tr_r.tolist())
    i0 = int(np.argmin(tr_w))
    Tstar = refine_T(T_ax, tr_w, i0)
    ti_n = int(np.argmin(np.abs(T_ax - Tstar)))
    Cstar, Rstar = fit_C_1d(lambda c: wm_resid(Tstar, U[sel, ti_n], Ls_, c))
    resid_bestT.append(Tstar); resid_bestC.append(Cstar); resid_bestR.append(Rstar)
    i1 = int(np.argmin(tr_r))
    Tr = refine_T(T_ax, tr_r, i1)
    ti_r = int(np.argmin(np.abs(T_ax - Tr)))
    Crr, Rrr = fit_C_1d(lambda c: resp_resid(chi[sel, ti_r], Ls_, c))
    resp_bestT.append(Tr); resp_bestC.append(Crr); resp_bestR.append(Rrr)


def select_min_axis(bestT_list):
    med = float(np.median(bestT_list))
    ok = [i for i, t in enumerate(bestT_list) if abs(t - med) <= 0.01]
    return int(min(ok) if ok else 0)


sel_resid_mi = select_min_axis(resid_bestT)
sel_resp_mi = select_min_axis(resp_bestT)
Lax_sel = L_ax[sel_resid_mi]
Lax_resp = L_ax[sel_resp_mi]
T_pref = float(resid_bestT[sel_resid_mi])
C_pref = float(resid_bestC[sel_resid_mi])
R_pref = float(resid_bestR[sel_resid_mi])
T_resp = float(resp_bestT[sel_resp_mi])
C_resp = float(resp_bestC[sel_resp_mi])
R_resp = float(resp_bestR[sel_resp_mi])

# --- intercept routes, x = 1/log(L) ------------------------------------------
a0 = np.empty(nT); a1 = np.empty(nT)      # Upsilon intercept / slope
r0 = np.empty(nT); s0 = np.empty(nT)      # xi/L intercept / slope
for ti in range(nT):
    p = np.polyfit(x, U[:, ti], 1); a1[ti], a0[ti] = p
    p2 = np.polyfit(x, xiL[:, ti], 1); s0[ti], r0[ti] = p2

T_bu = interp_cross(T_ax, a0 / T_ax, PI2)                      # beta*Upsilon intercept
Rratio = np.where(xiL[0, :] > 1e-12, xiL[-1, :] / xiL[0, :], 10.0)
T_xi = interp_cross(T_ax, Rratio, (L_ax[0] / L_ax[-1]) ** 0.5)  # xi_2nd/L route
T_eta = interp_cross(T_ax, eta, 0.25)                          # eta = 1/4 route

T_NK = np.empty(nL)
for li in range(nL):
    tc = interp_cross(T_ax, U[li, :] / T_ax, PI2)
    T_NK[li] = (np.pi / 2.0) * float(np.interp(tc, T_ax, U[li, :]))
T_NK_sw = float(np.sum(L_ax * T_NK) / np.sum(L_ax))

comps = np.array([T_pref, T_NK_sw, T_bu, T_xi, T_eta])
consensus = float(comps.mean())
consensus_spread = float(comps.max() - comps.min())

# --- jackknife over temperature blocks (3 blocks of 3) ------------------------
N_BLOCKS = 3


def compute_components(idx):
    Tsub = T_ax[idx]
    sel = L_ax >= Lax_sel
    Ls_ = L_ax[sel].astype(float)
    best_r = np.inf; best_t = float(Tsub[0]); best_c = 0.0
    for ti in idx:
        Cw, rw = fit_C_1d(lambda c: wm_resid(T_ax[ti], U[sel, ti], Ls_, c))
        if rw < best_r:
            best_r, best_t, best_c = rw, float(T_ax[ti]), Cw
    t_nk = np.empty(nL)
    for li in range(nL):
        tc = interp_cross(Tsub, U[li, idx] / Tsub, PI2)
        t_nk[li] = (np.pi / 2.0) * float(np.interp(tc, Tsub, U[li, idx]))
    t_nk_sw = float(np.sum(L_ax * t_nk) / np.sum(L_ax))
    t_bu = interp_cross(Tsub, a0[idx] / Tsub, PI2)
    Rr = np.where(xiL[0, idx] > 1e-12, xiL[-1, idx] / xiL[0, idx], 10.0)
    t_xi = interp_cross(Tsub, Rr, (L_ax[0] / L_ax[-1]) ** 0.5)
    t_et = interp_cross(Tsub, eta[idx], 0.25)
    return np.array([best_t, t_nk_sw, t_bu, t_xi, t_et])


