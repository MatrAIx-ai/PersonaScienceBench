class Canvas:
    def __init__(self, W, H, bg=(255, 255, 255)):
        self.W, self.H = W, H
        self.buf = np.empty((H, W, 3), dtype=np.uint8)
        self.buf[:] = bg

    def px(self, x, y, c):
        xi, yi = int(round(x)), int(round(y))
        if 0 <= xi < self.W and 0 <= yi < self.H:
            self.buf[yi, xi] = c

    def line(self, x0, y0, x1, y1, c, w=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx + dy
        while True:
            for ox in range(w):
                for oy in range(w):
                    self.px(x0 + ox, y0 + oy, c)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy; x0 += sx
            if e2 <= dx:
                err += dx; y0 += sy

    def rect(self, x0, y0, x1, y1, c, w=1):
        self.line(x0, y0, x1, y0, c, w); self.line(x1, y0, x1, y1, c, w)
        self.line(x1, y1, x0, y1, c, w); self.line(x0, y1, x0, y0, c, w)

    def fill(self, x0, y0, x1, y1, c):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        x0, x1 = max(0, min(x0, x1)), min(self.W - 1, max(x0, x1))
        y0, y1 = max(0, min(y0, y1)), min(self.H - 1, max(y0, y1))
        self.buf[y0: y1 + 1, x0: x1 + 1] = c

    def text(self, x, y, s, c=(0, 0, 0), scale=1):
        s = s.upper()
        cx = x
        for ch in s:
            g = FONT.get(ch, FONT[" "])
            for ry in range(7):
                row = g[ry]
                for rx in range(5):
                    if row & (0x10 >> rx):
                        self.fill(cx + rx * scale, y + ry * scale,
                                  cx + rx * scale + scale - 1, y + ry * scale + scale - 1, c)
            cx += 6 * scale
        return cx

    def save(self, path):
        raw = b"".join(b"\x00" + self.buf[y].tobytes() for y in range(self.H))

        def chunk(tag, data):
            b = tag + data
            return struct.pack(">I", len(data)) + b + struct.pack(">I", zlib.crc32(b) & 0xFFFFFFFF)

        hdr = struct.pack(">IIBBBBB", self.W, self.H, 8, 2, 0, 0, 0)
        with open(path, "wb") as f:
            f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", hdr)
                    + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def nice_ticks(lo, hi, n=5):
    span = hi - lo
    if span <= 0:
        return [lo]
    step0 = span / n
    mag = 10.0 ** np.floor(np.log10(step0))
    step = 10 * mag
    for m in (1, 2, 5, 10):
        step = m * mag
        if span / step <= n + 1:
            break
    t0 = np.ceil(lo / step) * step
    return list(np.round(np.arange(t0, hi + 1e-12, step), 10))


def log_ticks(lo, hi):
    out = []
    e0, e1 = int(np.floor(np.log10(lo))), int(np.ceil(np.log10(hi)))
    for e in range(e0, e1 + 1):
        for m in (1, 2, 5):
            v = m * 10.0 ** e
            if lo * 0.999 <= v <= hi * 1.001:
                out.append(v)
    return out


def fmt(v):
    if v == 0:
        return "0"
    a = abs(v)
    if a >= 0.01 and a < 1000:
        return f"{v:.3g}"
    return f"{v:.2e}".replace("e-0", "e-").replace("e+0", "e")


class Plot:
    """Simple axes mapper inside a pixel box (x0,y0,x1,y1)."""

    def __init__(self, cv, box, xlim, ylim, logx=False, logy=False):
        self.cv, self.box = cv, box
        self.xlim, self.ylim = xlim, ylim
        self.logx, self.logy = logx, logy

    def _t(self, v, lo, hi, px0, px1, log):
        if log:
            v, lo, hi = np.log10(v), np.log10(lo), np.log10(hi)
        return px0 + (v - lo) / (hi - lo) * (px1 - px0)

    def X(self, v):
        return self._t(v, self.xlim[0], self.xlim[1], self.box[0], self.box[2], self.logx)

    def Y(self, v):
        return self._t(v, self.ylim[0], self.ylim[1], self.box[3], self.box[1], self.logy)

    def grid_and_ticks(self, xlab, ylab, title, xt=None, yt=None):
        cv, (bx0, by0, bx1, by1) = self.cv, self.box
        cv.rect(bx0, by0, bx1, by1, (60, 60, 60))
        xt = xt or (log_ticks(*self.xlim) if self.logx else nice_ticks(*self.xlim))
        yt = yt or (log_ticks(*self.ylim) if self.logy else nice_ticks(*self.ylim))
        for t in xt:
            px = self.X(t)
            cv.line(px, by1, px, by1 + 4, (60, 60, 60))
            cv.line(px, by0, px, by1, (235, 235, 235))
            cv.text(px - len(fmt(t)) * 3, by1 + 6, fmt(t), (40, 40, 40))
        for t in yt:
            py = self.Y(t)
            cv.line(bx0 - 4, py, bx0, py, (60, 60, 60))
            cv.line(bx0, py, bx1, py, (235, 235, 235))
            cv.text(bx0 - len(fmt(t)) * 6 - 8, py - 3, fmt(t), (40, 40, 40))
        cv.text((bx0 + bx1) / 2 - len(xlab) * 3, by1 + 18, xlab, (0, 0, 0))
        cv.text(2, (by0 + by1) / 2 - len(ylab) * 3, ylab, (0, 0, 0))
        cv.text((bx0 + bx1) / 2 - len(title) * 4, by0 - 16, title, (0, 0, 0), scale=2)

    def curve(self, xs, ys, c, w=1):
        cv = self.cv
        xs = np.asarray(xs, float); ys = np.asarray(ys, float)
        ok = np.isfinite(xs) & np.isfinite(ys)
        xs, ys = xs[ok], ys[ok]
        if self.logx:
            ok = xs > 0; xs, ys = xs[ok], ys[ok]
        if self.logy:
            ok = ys > 0; xs, ys = xs[ok], ys[ok]
        for i in range(len(xs) - 1):
            cv.line(self.X(xs[i]), self.Y(ys[i]), self.X(xs[i + 1]), self.Y(ys[i + 1]), c, w)

    def vline(self, xv, c):
        self.cv.line(self.X(xv), self.box[1], self.X(xv), self.box[3], c)

    def hline(self, yv, c):
        self.cv.line(self.box[0], self.Y(yv), self.box[2], self.Y(yv), c)

