um, umax = float(U.min()), float(U.max())
ny, nx = 60, 90
for iy in range(ny):
    t = T_ax[0] + (iy + 0.5) / ny * (T_ax[-1] - T_ax[0])
    for ix in range(nx):
        lpos = (ix + 0.5) / nx * (nL - 1)
        li0 = min(int(lpos), nL - 2)
        fr = lpos - li0
        v = np.interp(t, T_ax, U[li0, :]) * (1 - fr) + np.interp(t, T_ax, U[li0 + 1, :]) * fr
        q = (v - um) / max(umax - um, 1e-9)
        col = (int(255 * q), int(60 + 120 * (1 - abs(2 * q - 1))), int(255 * (1 - q)))
        cv.fill(bx[0] + ix * (bx[2] - bx[0]) // nx, bx[1] + iy * (bx[3] - bx[1]) // ny,
                bx[0] + (ix + 1) * (bx[2] - bx[0]) // nx - 1,
                bx[1] + (iy + 1) * (bx[3] - bx[1]) // ny - 1, col)
cv.rect(bx[0], bx[1], bx[2], bx[3], (60, 60, 60))
