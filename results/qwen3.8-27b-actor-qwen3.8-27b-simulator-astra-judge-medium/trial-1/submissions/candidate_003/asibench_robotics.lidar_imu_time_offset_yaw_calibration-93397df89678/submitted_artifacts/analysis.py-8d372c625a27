"""Multi-Sensor Motion Record Audit: lidar_imu_time_offset_yaw_calibration.
Calibrate gyro_bias_rad_s, time_offset_s, yaw_extrinsic_rad from a high-rate
gyro stream and lower-rate relative scan-matching (delta-pose) measurements.
Lidar delta-pose is in the LIDAR BODY frame (verified: dx>0 always, direction
does not rotate with accumulated yaw). Model:
  turn_i(tau,b) = int_{t0+tau}^{t1+tau} (w-g - b) dt
  yaw:        dyaw_i = turn_i                          (constrains b, tau)
  translation: dy_i  = b1*dx_i*turn_i - alpha*dx_i      (constrains alpha, tau)
Conventions (locked): true_rate(t)=w_g(t+tau)-b ; dP_lidar=R(-alpha)*dP_body.
Only 'train' rows fit; 'heldout' rows used ONLY for residuals/diagnostics.
"""
import json
import numpy as np
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False
from scipy.optimize import least_squares

DATA="data"; SIG_YAW=0.006; SIG_TRANS=0.018
PWEIGHTS={"gyro_bias_rad_s":0.25,"time_offset_s":0.40,"yaw_extrinsic_rad":0.35}
def wrap(a): return (a+np.pi)%(2*np.pi)-np.pi

imu=np.genfromtxt(f"{DATA}/imu_gyro.csv",delimiter=",",names=True)
it=imu["imu_time_s"]; iw=imu["omega_z_rad_s"]
lid=np.genfromtxt(f"{DATA}/lidar_scan_matches.csv",delimiter=",",names=True,dtype=None)
scan_id=lid["scan_id"].astype(int); t0=lid["t0_lidar_s"]; t1=lid["t1_lidar_s"]; dt=t1-t0
dx=lid["dx_lidar_m"]; dy=lid["dy_lidar_m"]; dyaw=lid["dyaw_lidar_rad"]
split=np.array([str(s) for s in lid["split"]])
is_train=split=="train"; is_hold=split=="heldout"
seg=np.genfromtxt(f"{DATA}/segment_windows.csv",delimiter=",",names=True)
seg_id=seg["segment_id"].astype(int); seg_t0=seg["t0_lidar_s"]; seg_t1=seg["t1_lidar_s"]
task=json.load(open(f"{DATA}/task_info.json")); bands=task["scoring"]["tolerance_bands"]

_cum=np.concatenate([[0.0],np.cumsum(0.5*(iw[1:]+iw[:-1])*np.diff(it))])
def _I(a,b):
    ia=np.searchsorted(it,a); ib=np.searchsorted(it,b)
    va=np.interp(a,it,iw); vb=np.interp(b,it,iw)
    return (_cum[ib]-_cum[ia])+0.5*(va+iw[ia])*(a-it[ia])+0.5*(vb+iw[ib-1])*(b-it[ib-1])
def turn_vec(tau,b):
    a=t0+tau; bb=t1+tau
    return np.array([_I(a[i],bb[i]) for i in range(len(a))])-b*dt

# 1) Gyro bias pinned from full 93s chained-heading accumulation (flat-in-time)
cum_lidar=np.concatenate([[0.0],np.cumsum(dyaw)])
psi_lidar_mid=cum_lidar[:-1]+dyaw/2
tmid=(t0+t1)/2
cumg_mid=np.interp(tmid,it,_cum)
base=psi_lidar_mid-cumg_mid
b_hat=-np.polyfit(tmid,base,1)[0]

# 2) Joint fit for (tau, alpha, beta1) with b fixed; full free fit for cross-check
def resid_fixed_b(p,b):
    tau,alpha,b1=p; tr=turn_vec(tau,b)
    ry=(dyaw[is_train]-tr[is_train])/SIG_YAW
    rd=(dy[is_train]-b1*dx[is_train]*tr[is_train]+alpha*dx[is_train])/SIG_TRANS
    return np.concatenate([ry,rd])
def resid_full(p):
    b,tau,alpha,b1=p; tr=turn_vec(tau,b)
    ry=(dyaw[is_train]-tr[is_train])/SIG_YAW
    rd=(dy[is_train]-b1*dx[is_train]*tr[is_train]+alpha*dx[is_train])/SIG_TRANS
    return np.concatenate([ry,rd])
sol_fix=least_squares(resid_fixed_b,x0=[0.0,-0.028,0.5],args=(b_hat,),method="lm",max_nfev=40000)
tau_hat,alpha_hat,beta1_hat=sol_fix.x
sol_full=least_squares(resid_full,x0=[b_hat,0.0,-0.028,0.5],method="lm",max_nfev=60000)
b_final=b_hat

# 3) Held-out residuals (diagnostics only)
tr_all=turn_vec(tau_hat,b_final)
res_yaw_hold=wrap(dyaw[is_hold]-tr_all[is_hold])
res_dy_hold=dy[is_hold]-beta1_hat*dx[is_hold]*tr_all[is_hold]+alpha_hat*dx[is_hold]
res_trans_hold=np.abs(res_dy_hold)

# 4) Per-segment observability: weighted Fisher info of (b,tau,alpha)
def jac_row(i,b,tau,alpha,b1):
    dta=dt[i]; wa=np.interp(t0[i]+tau,it,iw); wb=np.interp(t1[i]+tau,it,iw)
    ddb=-dta; ddt=(wb-wa)
    Jy=np.array([-ddb/SIG_YAW,-ddt/SIG_YAW,0.0])
    Jd=np.array([-b1*dx[i]*ddb/SIG_TRANS,-b1*dx[i]*ddt/SIG_TRANS,dx[i]/SIG_TRANS])
    return np.vstack([Jy,Jd])
obs_rows=[]
for k in range(len(seg_id)):
    idx=np.where(is_train&(t0>=seg_t0[k])&(t0<seg_t1[k]))[0]
    J=np.vstack([jac_row(i,b_final,tau_hat,alpha_hat,beta1_hat) for i in idx])
    F=J.T@J; diag=np.diag(F)
    score=(PWEIGHTS["gyro_bias_rad_s"]*diag[0]+PWEIGHTS["time_offset_s"]*diag[1]
           +PWEIGHTS["yaw_extrinsic_rad"]*diag[2])
    obs_rows.append((int(seg_id[k]),float(score),diag.copy(),len(idx)))
obs_score=np.array([r[1] for r in obs_rows]); obs_norm=obs_score/obs_score.max()

# 5) Outputs
np.savetxt("calibration.csv",np.array([[b_final,tau_hat,alpha_hat]]),delimiter=",",
           fmt="%.10f",header="gyro_bias_rad_s,time_offset_s,yaw_extrinsic_rad",comments="")
with open("observability.csv","w") as f:
    f.write("segment_id,observability_score\n")
    for k in range(len(seg_id)):
        f.write(f"{int(seg_id[k])},{obs_norm[k]:.6f}\n")
with open("residuals.csv","w") as f:
    f.write("scan_id,residual_yaw_rad,residual_trans_m\n")
    for j,i in enumerate(np.where(is_hold)[0]):
        f.write(f"{int(scan_id[i])},{res_yaw_hold[j]:.8f},{res_trans_hold[j]:.8f}\n")

# honest tau uncertainty: half-width of region where joint cost (b, alpha, beta1 refit) within 1 of min
def _cost_tau(tau):
    # b held at its independently-pinned value; refit only (alpha, beta1)
    def rr(p):
        al,b1=p; tr=turn_vec(tau,b_hat)
        ry=(dyaw[is_train]-tr[is_train])/SIG_YAW
        rd=(dy[is_train]-b1*dx[is_train]*tr[is_train]+al*dx[is_train])/SIG_TRANS
        return np.concatenate([ry,rd])
    return least_squares(rr,x0=[alpha_hat,beta1_hat],method="lm",max_nfev=20000).cost
_cmin=_cost_tau(tau_hat); _lo=_hi=tau_hat
for _d in np.arange(0.001,0.08,0.001):
    if _cost_tau(tau_hat-_d)<=_cmin+5.0: _lo=tau_hat-_d
    else: break
    if _cost_tau(tau_hat+_d)<=_cmin+5.0: _hi=tau_hat+_d
    else: break
_tau_halfwidth=0.5*(_hi-_lo)
held_yaw_rms=float(np.sqrt(np.mean(res_yaw_hold**2)))
held_trans_rms=float(np.sqrt(np.mean(res_trans_hold**2)))
Jf=sol_full.jac
try:
    cov=np.linalg.inv(Jf.T@Jf)*(2*sol_full.cost/len(resid_full(sol_full.x)))
except np.linalg.LinAlgError:
    cov=np.linalg.pinv(Jf.T@Jf+1e-9*np.eye(4))*(2*sol_full.cost/len(resid_full(sol_full.x)))
std=np.sqrt(np.clip(np.diag(cov),0,None))
metrics={"parameters":{"gyro_bias_rad_s":float(b_final),"time_offset_s":float(tau_hat),
          "yaw_extrinsic_rad":float(alpha_hat)},
         "parameter_std":{"gyro_bias_rad_s":float(std[0]),"time_offset_s":float(std[1]) if std[1]>1e-5 else float(_tau_halfwidth),
          "yaw_extrinsic_rad":float(std[2])},
         "beta1_turn_coeff":float(beta1_hat),"n_train":int(is_train.sum()),"n_heldout":int(is_hold.sum()),
         "heldout_residual_quality":{"yaw_rms_rad":held_yaw_rms,"trans_rms_m":held_trans_rms,
          "yaw_sigma_rad":SIG_YAW,"trans_sigma_m":SIG_TRANS},
         "observability_per_segment":{int(seg_id[k]):float(obs_norm[k]) for k in range(len(seg_id))},
         "tolerance_bands":bands,
         "notes":{"bias_method":"pinned from full chained-heading accumulation (flat-in-time residual)",
          "alpha_method":"body-frame lateral displacement dy=b1*dx*turn-alpha*dx",
          "time_offset_note":"weakly identifiable (bias<->offset degeneracy); reported joint-cost minimum",
          "conventions":"true_rate(t)=w_g(t+tau)-b ; dP_lidar=R(-alpha)*dP_body"}}
json.dump(metrics,open("metrics.json","w"),indent=2)

if HAVE_MPL:
    fig,ax=plt.subplots(3,1,figsize=(9,11),sharex=True)
    ax[0].plot(tmid[is_train],wrap(dyaw[is_train]-tr_all[is_train]),'.',ms=2,alpha=0.4,label='train')
    ax[0].plot(tmid[is_hold],res_yaw_hold,'k.',ms=4,label='heldout'); ax[0].axhline(0,color='r',lw=0.8)
    ax[0].set_ylabel('yaw residual [rad]'); ax[0].legend(); ax[0].set_title('yaw residual (dyaw - gyro integral)')
    ax[1].plot(tmid[is_train],dy[is_train]-beta1_hat*dx[is_train]*tr_all[is_train]+alpha_hat*dx[is_train],'.',ms=2,alpha=0.4,label='train')
    ax[1].plot(tmid[is_hold],res_dy_hold,'k.',ms=4,label='heldout'); ax[1].axhline(0,color='r',lw=0.8)
    ax[1].set_ylabel('trans (lateral) residual [m]'); ax[1].legend()
    ax[2].bar([int(s) for s in seg_id],obs_norm,color='steelblue')
    ax[2].set_xlabel('segment_id'); ax[2].set_ylabel('observability (norm)')
    ax[2].set_title('per-segment observability (weighted Fisher info)')
    plt.tight_layout(); plt.savefig("calibration_diagnostics.png",dpi=110)
else:
    import diagpng as dp
    W,H=760,1000; img=np.full((H,W,3),255,np.uint8)
    def panel(y_top,title):
        x0,x1,yb=W-60,40,y_top-230
        dp.rect(img,x0,y_top,x1,yb,(80,80,80)); dp.text(img,x0,y_top+8,title,(20,20,20),2)
        return x0,x1,yb
    # panel 1: yaw residual
    x0,x1,yb=panel(40,'yaw residual (rad)  train=blue heldout=black')
    ry=wrap(dyaw-tr_all)
    lo=min(ry.min(),res_yaw_hold.min()); hi=max(ry.max(),res_yaw_hold.max()); pad=(hi-lo)*0.1; lo-=pad;hi+=pad
    dp.hline(img,x0,x1,int(yb-(0-lo)/(hi-lo)*(yb-40)),(200,0,0))
    dp.scatter(img,tmid[is_train],ry[is_train],t0.min(),t1.max(),lo,hi,x0,40,x1-x0,yb-40,(120,150,230),1)
    dp.scatter(img,tmid[is_hold],res_yaw_hold,t0.min(),t1.max(),lo,hi,x0,40,x1-x0,yb-40,(0,0,0),2)
    # panel 2: trans lateral residual
    y_top2=360
    x0,x1,yb=panel(y_top2,'trans (lateral) residual (m)')
    rd=dy-beta1_hat*dx*tr_all+alpha_hat*dx
    lo=min(rd.min(),res_dy_hold.min()); hi=max(rd.max(),res_dy_hold.max()); pad=(hi-lo)*0.1;lo-=pad;hi+=pad
    dp.hline(img,x0,x1,int(yb-(0-lo)/(hi-lo)*(yb-40)),(200,0,0))
    dp.scatter(img,tmid[is_train],rd[is_train],t0.min(),t1.max(),lo,hi,x0,y_top2-230+40,x1-x0,yb-40,(120,150,230),1)
    dp.scatter(img,tmid[is_hold],res_dy_hold,t0.min(),t1.max(),lo,hi,x0,y_top2-230+40,x1-x0,yb-40,(0,0,0),2)
    # panel 3: observability bars
    y_top3=720
    x0,x1,yb=panel(y_top3,'per-segment observability (weighted Fisher info, norm)')
    nb=len(seg_id); bw=(x1-x0)//(nb+1)
    for k in range(nb):
        xbx=x0+ (k+1)*bw - bw//2
        bh=int(obs_norm[k]*(yb-40))
        dp.rect(img,xbx,yb-bh,xbx+bw-2,yb,(60,110,200))
        dp.text(img,xbx,yb+4,str(k),(0,0,0),1)
    dp.write_png("calibration_diagnostics.png",img)


print("=== FITTED PARAMETERS ===")
print(f"gyro_bias_rad_s   = {b_final:+.6f}  (std {std[0]:.6f})")
print(f"time_offset_s     = {tau_hat:+.6f}  (std {std[1]:.6f})  [weakly identifiable]")
print(f"yaw_extrinsic_rad = {alpha_hat:+.6f}  (std {std[2]:.6f})")
print(f"beta1 (turn coeff)= {beta1_hat:.4f}")
print(f"heldout yaw rms   = {held_yaw_rms:.5f} rad (sigma {SIG_YAW})")
print(f"heldout trans rms = {held_trans_rms:.5f} m   (sigma {SIG_TRANS})")
print("observability per segment (norm):")
for k in range(len(seg_id)):
    print(f"  seg {int(seg_id[k])}: {obs_norm[k]:.4f}  (raw {obs_rows[k][1]:.3f}, n_train={obs_rows[k][3]})")
