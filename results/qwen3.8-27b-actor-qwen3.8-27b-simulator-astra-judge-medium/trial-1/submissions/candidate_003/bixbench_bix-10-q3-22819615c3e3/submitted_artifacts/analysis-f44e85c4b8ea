"""
TASK008 / bix-10-q3
Q: In which patient volume group (patients_seen) do healthcare workers show
   statistically significant differences (p<0.05) in COVID-19 severity between
   BCG and placebo, based on chi-square analysis?

LOCKED DESIGN (approved by researcher):
  * Severity  = AE domain, AEPT == 'COVID-19', field AESEV (ordinal 1-4).
                'COVID-19 pneumonia' NOT folded in. EX domain not used.
  * Inclusion = infected subjects only (>=1 'COVID-19' AE row).
  * Collapse  = per subject, WORST (max) AESEV across that subject's COVID-19 rows.
  * Subjects whose COVID-19 rows are ALL NaN severity -> EXCLUDED.
  * Patient-volume group = DM.patients_seen as-is: '1-50','51-100','>100'.
  * PRIMARY test = chi-square of independence on FULL ORDINAL AESEV (1-4) x TRTGRP
                  contingency table, within each patients_seen group.
  * SENSITIVITY  = severe(>=3) vs not-severe(1-2) dichotomized 2x2 chi-square.
  * SMALL GROUPS (51-100, >100): also report Fisher's exact + permutation p,
                  and flag cells with expected count < 5.
  * Threshold   = p < 0.05 (no multiple-testing correction).
"""
import pandas as pd, numpy as np, warnings
warnings.filterwarnings("ignore")
from scipy.stats import chi2_contingency, fisher_exact
rng = np.random.default_rng(20261019)

BASE = "/workspace/data/"
def rcsv(p):
    for enc in ("utf-8","latin-1","cp1252"):
        try:
            return pd.read_csv(p, encoding=enc)
        except UnicodeDecodeError:
            continue
    return pd.read_csv(p, encoding="latin-1")

dm = rcsv(BASE+"TASK008_BCG-CORONA_DM.csv")
ae = rcsv(BASE+"TASK008_BCG-CORONA_AE.csv")
GROUPS = ["1-50","51-100",">100"]
ORD_LEVELS = [1.0,2.0,3.0,4.0]

# ---- per-subject worst COVID-19 severity (infected only, known severity) ----
c19 = ae[ae["AEPT"] == "COVID-19"]
worst = (c19.dropna(subset=["AESEV"]).groupby("USUBJID")["AESEV"].max())
sev = (worst.reset_index()
       .merge(dm[["USUBJID","TRTGRP","patients_seen"]], on="USUBJID", how="left"))
sev["AESEV"] = sev["AESEV"].astype(float)
print(f"Infected subjects (>=1 COVID-19 AE row): {c19['USUBJID'].nunique()}")
print(f"Infected subjects with KNOWN severity (analyzed): {len(sev)}")
print("Overall worst-severity distribution:", sev["AESEV"].value_counts().sort_index().to_dict())

def ordinal_table(sub):
    rows = [lv for lv in ORD_LEVELS if (sub["AESEV"]==lv).any()]
    tbl = pd.crosstab(sub["AESEV"], sub["TRTGRP"]).reindex(index=rows, columns=["BCG","Placebo"], fill_value=0)
    return tbl.values.astype(int), rows

def binary_table(sub):
    sub = sub.copy(); sub["sevbin"] = np.where(sub["AESEV"]>=3,"severe(>=3)","not_severe(<3)")
    tbl = pd.crosstab(sub["sevbin"], sub["TRTGRP"]).reindex(index=["not_severe(<3)","severe(>=3)"], columns=["BCG","Placebo"], fill_value=0)
    return tbl.values.astype(int)

def _chi2_2col(k, rowsum, totalB, total):
    """Pearson chi2 for an R x 2 table given per-row BCG counts k (numpy)."""
    E_B = rowsum*totalB/total; E_P = rowsum*(total-totalB)/total
    d = k - E_B
    return np.sum(d*d*(1.0/E_B + 1.0/E_P))

def perm_chi2_p(sub, nperm=50000):
    """Permutation (Fisher-Freeman-Halton style) p for the ordinal R x 2 table:
       severity labels fixed, treatment assignment shuffled (margins fixed)."""
    rows = [lv for lv in ORD_LEVELS if (sub["AESEV"]==lv).any()]
    lvl_idx = {lv:i for i,lv in enumerate(rows)}
    sev_i = sub["AESEV"].map(lvl_idx).to_numpy()
    isB = (sub["TRTGRP"]=="BCG").to_numpy(dtype=float)
    rowsum = np.array([(sub["AESEV"]==lv).sum() for lv in rows], dtype=float)
    totalB = isB.sum(); total = len(isB)
    k0 = np.bincount(sev_i, weights=isB, minlength=len(rows))
    obs = _chi2_2col(k0, rowsum, totalB, total)
    idx = np.arange(len(isB))
    ge = 0
    for _ in range(nperm):
        k = np.bincount(sev_i, weights=rng.permutation(isB), minlength=len(rows))
        if _chi2_2col(k, rowsum, totalB, total) >= obs - 1e-12:
            ge += 1
    return (ge+1)/(nperm+1), obs, len(rows)

print("\n"+"="*100)
print("RESULTS  (primary = ordinal AESEV x TRTGRP chi-square; sensitivity = severe>=3 vs not)")
print("="*100)
res = []
for g in GROUPS:
    sub = sev[sev["patients_seen"]==g]
    N = len(sub); nB=int((sub["TRTGRP"]=="BCG").sum()); nP=int((sub["TRTGRP"]=="Placebo").sum())
    tbl, rows = ordinal_table(sub)
    chi2, p, dof, exp = chi2_contingency(tbl, correction=False)
    small_cells = [f"sev{int(r)}:{c}={exp[i,j]:.2f}" for i,r in enumerate(rows) for j,c in enumerate(["BCG","Placebo"]) if exp[i,j]<5]
    line = dict(group=g, N=N, BCG=nB, Placebo=nP,
                ord_chi2=round(float(chi2),3), ord_df=int(dof), ord_p=float(p),
                small_cells=small_cells)
    bt = binary_table(sub)
    b_chi2, b_p, b_dof, b_exp = chi2_contingency(bt, correction=False)
    line["bin_chi2"]=round(float(b_chi2),3); line["bin_p"]=float(b_p)
    if g in ("51-100",">100"):
        f_odds, f_p = fisher_exact(bt)
        perm_p, perm_obs, R = perm_chi2_p(sub, nperm=50000)
        line["fisher2x2_p"]=float(f_p); line["fisher2x2_OR"]=round(float(f_odds),3)
        line["perm_p_ordinal"]=float(perm_p); line["perm_obs_chi2"]=round(float(perm_obs),3)
    res.append(line)

for r in res:
    print(f"\n### patients_seen = {r['group']}   (N={r['N']}, BCG={r['BCG']}, Placebo={r['Placebo']})")
    print(f"  PRIMARY ordinal chi2 = {r['ord_chi2']}  df={r['ord_df']}  p = {r['ord_p']:.4g}   -> {'SIGNIFICANT (<0.05)' if r['ord_p']<0.05 else 'not significant'}")
    print(f"    cells with expected<5: {r['small_cells'] if r['small_cells'] else 'none'}")
    print(f"  SENSITIVITY binary (severe>=3 vs not) chi2 = {r['bin_chi2']}  p = {r['bin_p']:.4g}   -> {'SIGNIFICANT (<0.05)' if r['bin_p']<0.05 else 'not significant'}")
    if "fisher2x2_p" in r:
        print(f"  SMALL-GROUP exact checks: Fisher 2x2 p = {r['fisher2x2_p']:.4g} (OR={r['fisher2x2_OR']}); permutation p (ordinal table) = {r['perm_p_ordinal']:.4g} (obs chi2={r['perm_obs_chi2']})")

print("\n"+"="*100); print("FINAL PER-GROUP TABLE"); print("="*100)
out = pd.DataFrame(res)
print(out[["group","N","BCG","Placebo","ord_chi2","ord_df","ord_p","bin_chi2","bin_p"]].to_string(index=False))
print("\nSignificant groups (PRIMARY ordinal, p<0.05):", [r['group'] for r in res if r['ord_p']<0.05])
print("Significant groups (SENSITIVITY binary, p<0.05):", [r['group'] for r in res if r['bin_p']<0.05])
