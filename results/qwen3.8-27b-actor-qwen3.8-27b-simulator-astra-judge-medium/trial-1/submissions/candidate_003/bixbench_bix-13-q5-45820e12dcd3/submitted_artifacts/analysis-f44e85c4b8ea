"""
DESeq2-equivalent differential-expression pipeline (Python reimplementation).
Question: genes uniquely & statistically DE in at least one of the DlasI / DrhlI
single mutants but NOT DE in the DlasI_DrhlI double mutant, vs reference JBX1,
BH FDR threshold 0.05.
Pipeline: median-of-ratios size factors -> per-gene NB-GLM (design ~ strain)
MLE beta + dispersion -> LOESS dispersion trend -> EB shrinkage -> Wald test
per contrast -> independent filtering (default) -> BH -> DE sets.
"""
import numpy as np, csv, json, time
from scipy.special import gammaln, log_ndtr
from scipy.optimize import minimize_scalar
t0=time.time()

# ---------------- load ----------------
meta={}
with open('data/experiment_metadata.csv') as f:
    for r in csv.DictReader(f): meta[r['AzentaName']]=r['Strain']
gene_ids=[]; cols=[]; C=[]
with open('data/raw_counts.csv') as f:
    rd=csv.reader(f); header=next(rd); cols=header[1:]
    for row in rd: gene_ids.append(row[0]); C.append([int(x) for x in row[1:]])
C=np.array(C,dtype=float)
strain=np.array([meta[c] for c in cols])
levels=['1','97','98','99']
strain_idx=np.array([levels.index(s) for s in strain])
print("counts", C.shape, "| samples", len(cols), "| strains", levels)

# ---------------- size factors (median of ratios) ----------------
logC=np.where(C>0,np.log(C),np.nan); gmean=np.exp(np.nanmean(logC,axis=1))
ratio=np.where(C>0,C/gmean[:,None],np.nan); size=np.nanmedian(ratio,axis=0); size[size<=0]=1
norm=C/size[None,:]
print("size factors min/max", round(float(size.min()),3), round(float(size.max()),3))

# ---------------- design matrix (design ~ strain, JBX1=strain'1' reference) ----------------
n=C.shape[1]; X=np.zeros((n,4)); X[:,0]=1.0
for j in range(n):
    if strain_idx[j]>0: X[j,strain_idx[j]]=1.0

ALPHA_MIN,ALPHA_MAX=1e-4,10.0
def nb_loglik(alpha,y,mu):
    inv=1/alpha
    return np.sum(gammaln(y+inv)-gammaln(inv)-gammaln(y+1)
                  + y*np.log(alpha)+y*np.log(mu)-(inv+y)*np.log1p(alpha*mu))
def fit_gene(y):
    m=y.mean()
    if m<=0: return None
    yl=np.log(np.where(y>0,y,1.0))
    beta=np.linalg.lstsq(X,yl,rcond=None)[0]; beta=np.clip(beta,-15,15)
    a0=max(2e-3,min(1.0,(y.var()-m)/max(m*m,1e-6))); alpha=a0
    for _ in range(8):
        for _ in range(50):
            eta=X@beta; mu=np.exp(eta); a=1+alpha*mu
            z=eta+(y-mu)/mu; w=mu/a                 # correct log-link IRLS
            XtWX=X.T@(X*w[:,None]); XtWz=X.T@(w*z)
            try: bn=np.linalg.solve(XtWX,XtWz)
            except np.linalg.LinAlgError: bn=beta
            if not np.all(np.isfinite(bn)): bn=beta
            if np.max(np.abs(bn-beta))<1e-8: beta=bn; break
            beta=bn
        eta=X@beta; mu=np.exp(eta)
        r=minimize_scalar(lambda a:-nb_loglik(a,y,mu),bounds=(ALPHA_MIN,ALPHA_MAX),
                          method='bounded',options={'xatol':1e-5})
        an=float(r.x)
        if abs(an-alpha)/max(alpha,1e-6)<1e-4: alpha=an; break
        alpha=an
    return dict(beta=beta,alpha=alpha,mean=mu.mean(),y=y)
print("fitting genes...")
res=[fit_gene(C[i]) for i in range(C.shape[0])]
print("  done", round(time.time()-t0,1),"s")

# ---------------- dispersion trend (LOESS) + prior var ----------------
mm=np.array([r['mean'] for r in res if r and r['alpha']>0])
la=np.log(np.array([r['alpha'] for r in res if r and r['alpha']>0]))
def loess_fit(x,y,span=0.3,deg=1,nq=120):
    n=len(x); k=max(2,int(np.ceil(span*n))); xv=np.linspace(x.min(),x.max(),nq); out=np.zeros(nq)
    for qi,q in enumerate(xv):
        idx=np.argsort(np.abs(x-q))[:k]; dd=np.abs(x[idx]-q); wmax=dd.max()
        w=np.ones(k) if wmax==0 else np.where((dd/wmax)>=1,0,(1-(dd/wmax)**3)**3)
        Xl=np.vander(x[idx],deg+1)
        try: b=np.linalg.lstsq((w[:,None]*Xl),w*y[idx],rcond=None)[0]
        except: b=np.array([y[idx].mean()]+[0]*deg)
        out[qi]=np.polyval(b,q)                       # vander is highest-first
    return xv,out
xq,tq=loess_fit(np.log(mm),la)
def trend_at(m): return np.interp(np.log(m),xq,tq)
resid=la-np.interp(np.log(mm),xq,tq)
prior_var=max(float(np.var(resid)),0.1)
print("prior_var (log-disp residual var)=",round(prior_var,4))

# ---------------- shrink dispersions + Wald test ----------------
def se_logdisp(r,mu):
    y=r['y']
    def ll_la(la2):
        al=np.clip(np.exp(la2),ALPHA_MIN,ALPHA_MAX); return nb_loglik(al,y,mu)
    la0=np.log(r['alpha']); h=1e-3
    d2=(ll_la(la0+h)-2*ll_la(la0)+ll_la(la0-h))/h**2
    return 1.0/np.sqrt(max(-d2,1e-4))
def build_P(pv):
    P=np.full((len(gene_ids),3),np.nan)
    for i,r in enumerate(res):
        if r is None: continue
        tr=trend_at(r['mean']); mu=np.exp(X@r['beta']); gvar=se_logdisp(r,mu)**2
        w=pv/(pv+gvar); alp=np.exp(w*np.log(r['alpha'])+(1-w)*tr)
        a=1+alp*mu; wgt=mu/a; XtWX=X.T@(X*wgt[:,None])
        try: cov=np.linalg.inv(XtWX); se=np.sqrt(np.clip(np.diag(cov),0,None))
        except np.linalg.LinAlgError: se=np.full(4,np.nan)
        for k in range(3):
            b=r['beta'][k+1]; s=se[k+1]
            if s>0 and np.isfinite(b): P[i,k]=2*np.exp(log_ndtr(-abs(b/s)))
    return P
P=build_P(prior_var)
meannorm=norm.mean(axis=1)

# ---------------- BH + independent filtering ----------------
def bh(p):
    p=np.asarray(p,float); out=np.full(len(p),np.nan); valid=~np.isnan(p)
    pv=p[valid]; nv=len(pv); order=np.argsort(pv)
    adj_sorted=pv[order]*nv/np.arange(1,nv+1)
    for j in range(nv-2,-1,-1): adj_sorted[j]=min(adj_sorted[j],adj_sorted[j+1])
    adj=np.empty(nv); adj[order]=adj_sorted; out[valid]=adj; return out
def independent_filter(p,mc,alpha=0.05):
    thr=np.quantile(mc,np.linspace(0.025,0.975,39)); best=(-1,None)
    for t in thr:
        keep=mc>=t; padj=bh(p); padj[~keep]=np.nan; c=int(np.nansum(padj<alpha))
        if c>best[0]: best=(c,t)
    t=best[1]; keep=mc>=t; padj=bh(p); padj[~keep]=np.nan
    return padj,keep,t,best[0]
names=['97','98','99']; padjs={}; de_sets={}; keeps={}; thrs={}
for k,nm in enumerate(names):
    padj,keep,t,c=independent_filter(P[:,k],meannorm)
    padjs[nm]=padj; keeps[nm]=keep; thrs[nm]=t
    de_sets[nm]=set(gene_ids[i] for i in range(len(gene_ids)) if (not np.isnan(padj[i])) and padj[i]<0.05)
    print(f"strain {nm} vs JBX1: DE(padj<0.05)={c}, filter thr(mean norm)={t:.2f}, kept={keep.sum()}")

# ---------------- identify double mutant + answer ----------------
double=max(de_sets,key=lambda k:len(de_sets[k]))
singles=[k for k in names if k!=double]
A,B,Cset=de_sets[singles[0]],de_sets[singles[1]],de_sets[double]
union=A|B; answer=union-Cset
print("\n=== RESULT ===")
print("Mapping: 1=JBX1(reference), 99=DlasI_DrhlI(double), {97,98}={DlasI,DrhlI}(singles)")
print(f"DE sizes: 97={len(A)}, 98={len(B)}, 99(double)={len(Cset)}")
print(f"|A union B|={len(union)}  |C|={len(Cset)}")
print(f"COVERAGE of union by double C: {len(union&Cset)/len(union):.3f} "
      f"(A by C={len(A&Cset)/len(A):.3f}, B by C={len(B&Cset)/len(B):.3f})")
print(f"ANSWER |(DlasI or DrhlI DE) \\ Ddouble DE| = {len(answer)}")

# ---------------- sensitivity / diagnostics ----------------
print("\n=== SENSITIVITY ===")
for k,nm in enumerate(names):
    p=padjs[nm]; print(f"  {nm}: genes with padj exactly 0.05 = {int(np.nansum(np.isclose(p,0.05,rtol=0,atol=1e-12)))}")
def answer_for(P,use_indep):
    sets={}
    for k,nm in enumerate(names):
        padj=independent_filter(P[:,k],meannorm)[0] if use_indep else bh(P[:,k])
        sets[nm]=set(gene_ids[i] for i in range(len(gene_ids)) if (not np.isnan(padj[i])) and padj[i]<0.05)
    d=max(sets,key=lambda k:len(sets[k])); s=[x for x in names if x!=d]
    return len((sets[s[0]]|sets[s[1]])-sets[d]),d
print("  without independent filtering: ans=",answer_for(P,False)[0])
print("  alt 'uniquely' = DE in exactly one single (A^B)\\C =", len((A^B)-Cset))
print("  answer for each choice of double mutant:")
for d in names:
    s=[x for x in names if x!=d]; print(f"     double={d}: {len((de_sets[s[0]]|de_sets[s[1]])-de_sets[d])}")
print("  shrinkage sensitivity (indep filter on):")
for pv in [prior_var, prior_var*0.5, prior_var*2, 0.1, 1.0]:
    ai,di=answer_for(build_P(pv),True); print(f"     prior_var={pv:.3f}: ans={ai} double={di}")

# save
np.save('P.npy',P); np.save('meannorm.npy',meannorm)
with open('de_results.json','w') as f:
    json.dump({nm:sorted(de_sets[nm]) for nm in names},f)
print("\nDONE",round(time.time()-t0,1),"s")
