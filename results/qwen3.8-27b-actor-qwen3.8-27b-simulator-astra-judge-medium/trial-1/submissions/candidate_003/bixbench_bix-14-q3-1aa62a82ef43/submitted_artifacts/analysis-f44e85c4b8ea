"""
Analysis: Count non-reference exonic variants in CHIP genes from 86 samples.

Method:
- Load all 86 xlsx files from CHIP_DP10_GQ20_PASS/
- Filter: keep only Zygosity in {'Heterozygous', 'Homozygous Variant'}
- Filter: keep only SO in {synonymous_variant, missense_variant, frameshift_variant, inframe_deletion, inframe_insertion}
- Validate: Match column (case-normalized) ∈ 56 CHIP genes
- Count: sum across all samples (per-sample, each row = 1)
"""

import openpyxl
import os
from collections import Counter

# --- Configuration ---
DATA_DIR = 'data/CHIP_DP10_GQ20_PASS'
CHIP_GENES_FILE = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'

EXONIC_SO = {
    'synonymous_variant',
    'missense_variant',
    'frameshift_variant',
    'inframe_deletion',
    'inframe_insertion'
}

NON_REFERENCE_ZYGOSITY = {'Heterozygous', 'Homozygous Variant'}

# --- Load CHIP gene list ---
wb_genes = openpyxl.load_workbook(CHIP_GENES_FILE)
ws_genes = wb_genes.active
chip_genes_upper = set()
for row in ws_genes.iter_rows(min_row=1, max_row=ws_genes.max_row, values_only=True):
    if row[0]:
        chip_genes_upper.add(str(row[0]).strip().upper())
wb_genes.close()

print(f"CHIP genes loaded: {len(chip_genes_upper)}")
print(f"Genes: {sorted(chip_genes_upper)}")
print()

# --- Process all 86 files ---
files = sorted([f for f in os.listdir(DATA_DIR) if f.endswith('.xlsx')])
print(f"Processing {len(files)} files...")
print()

total_count = 0
gene_counter = Counter()
so_counter = Counter()
per_file_counts = {}

# Validation
match_not_in_chip = []
total_rows_processed = 0
reference_filtered = 0
non_exonic_filtered = 0

for fname in files:
    fpath = os.path.join(DATA_DIR, fname)
    wb = openpyxl.load_workbook(fpath)
    ws = wb.active
    
    file_count = 0
    for r in range(3, ws.max_row + 1):
        chr_pos = ws.cell(row=r, column=1).value
        if chr_pos is None:
            continue
        
        total_rows_processed += 1
        
        # Step 1: Filter reference calls
        zygosity = ws.cell(row=r, column=5).value
        if zygosity not in NON_REFERENCE_ZYGOSITY:
            reference_filtered += 1
            continue
        
        # Step 2: Filter non-exonic
        so_term = ws.cell(row=r, column=14).value
        if so_term is None or str(so_term).strip() not in EXONIC_SO:
            non_exonic_filtered += 1
            continue
        
        # This row passes both filters
        file_count += 1
        
        # Get gene from Match column (col 31)
        match_gene = ws.cell(row=r, column=31).value
        if match_gene:
            gene_upper = str(match_gene).strip().upper()
            gene_counter[gene_upper] += 1
            # Validate: must be in CHIP gene list
            if gene_upper not in chip_genes_upper:
                match_not_in_chip.append((fname, r, match_gene))
        
        # Track SO term
        so_counter[str(so_term).strip()] += 1
    
    per_file_counts[fname] = file_count
    total_count += file_count
    wb.close()

# --- Results ---
print("=" * 70)
print("RESULTS")
print("=" * 70)
print()
print(f"Total data rows processed:      {total_rows_processed}")
print(f"Filtered (reference/None zyg):  {reference_filtered}")
print(f"Filtered (non-exonic SO):       {non_exonic_filtered}")
print()
print(f"*** FINAL COUNT: {total_count} non-reference exonic variants in CHIP genes ***")
print(f"    (across {len(files)} samples, per-sample count)")
print()

# Validation
print("=" * 70)
print("VALIDATION")
print("=" * 70)
if match_not_in_chip:
    print(f"WARNING: {len(match_not_in_chip)} rows with Match NOT in CHIP gene list:")
    for fname, r, gene in match_not_in_chip[:10]:
        print(f"  {fname} row {r}: Match='{gene}'")
else:
    print(f"✓ All Match values (case-normalized) are within the 56 CHIP genes.")
print()

# Breakdown by SO term
print("=" * 70)
print("BREAKDOWN BY SO TERM (exonic only)")
print("=" * 70)
for so, cnt in so_counter.most_common():
    print(f"  {so:30s}: {cnt}")
print(f"  {'TOTAL':30s}: {total_count}")
print()

# Breakdown by gene (top 10)
print("=" * 70)
print("BREAKDOWN BY GENE (top 10)")
print("=" * 70)
for gene, cnt in gene_counter.most_common(10):
    print(f"  {gene:10s}: {cnt}")
print(f"  {'...':10s}")
print(f"  {'TOTAL':10s}: {total_count} (across {len(gene_counter)} genes)")
print()

# Per-file breakdown (summary)
print("=" * 70)
print("PER-FILE COUNTS (min/max/mean)")
print("=" * 70)
counts_list = list(per_file_counts.values())
print(f"  Min:  {min(counts_list)}")
print(f"  Max:  {max(counts_list)}")
print(f"  Mean: {sum(counts_list)/len(counts_list):.1f}")
print(f"  Files with 0: {sum(1 for c in counts_list if c == 0)}")
print()

# Anomalous files check
print("=" * 70)
print("ANOMALOUS FILES CHECK")
print("=" * 70)
for fname in files:
    if '380-P' in fname or '381-PM' in fname:
        print(f"  {fname}: {per_file_counts[fname]} exonic non-ref variants")
print()

print("Done.")
