"""
BixBench bix-16-q2: Skewness of the gene expression (log2(TPM+1)) distribution
across all cell lines in the dataset.

Approach:
- Matrix: rows = cell lines (ACH-* ModelIDs), columns = protein-coding genes.
- Values already log2(TPM+1), batch-corrected (no re-log).
- Pool ALL values across all cell lines and genes.
- Skewness: Fisher-Pearson. Report G1 (pandas .skew(), adjusted) as primary,
  g1 (scipy bias=True) as secondary.
"""
import numpy as np
import pandas as pd
from scipy import stats

EXP = 'data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv'
MODEL = 'data/Model.csv'

# --- Load expression matrix (genes in columns, cell lines in rows) ---
df = pd.read_csv(EXP, index_col=0)
print(f'Expression matrix: {df.shape[0]} cell lines x {df.shape[1]} genes')

# --- Cross-check row IDs against Model.csv ModelID ---
model = pd.read_csv(MODEL, usecols=['ModelID', 'StrippedCellLineName', 'CCLEName'])
row_ids = set(df.index)
match = row_ids & set(model['ModelID'])
print(f'Row IDs matching ModelID in Model.csv: {len(match)}/{len(row_ids)} '
      f'(Model.csv has {len(model)} models total)')
print(f'Unmatched row IDs: {len(row_ids - match)}')

# --- Missing data ---
n_cells = df.size
n_nan = int(df.isna().sum().sum())
print(f'NaN cells: {n_nan}/{n_cells} -> no imputation needed')

# --- Pool all values across all cell lines and genes ---
v = df.values.ravel()
v = v[~np.isnan(v)]
N = v.size
print(f'Pooled N = {N:,}')

# --- Confirm log2(TPM+1) scale (no re-log applied) ---
print(f'Range: min={v.min():.4f}, max={v.max():.4f} '
      f'(negative fraction {(v<0).mean()*100:.2f}% -> batch-correction artifact)')

# --- Skewness: Fisher-Pearson ---
g1 = stats.skew(v, bias=True)          # m3/m2^1.5 (scipy default)
G1 = pd.Series(v).skew()               # adjusted: sqrt(n(n-1))/(n-2) * g1
G1_check = stats.skew(v, bias=False)   # same formula via scipy
print(f'Skewness g1  (scipy bias=True)  = {g1:.6f}')
print(f'Skewness G1  (pandas .skew())   = {G1:.6f}')
print(f'Skewness G1  (scipy bias=False) = {G1_check:.6f}')

# --- Descriptive stats ---
q25, q75 = np.percentile(v, [25, 75])
print(f'Mean={v.mean():.4f}  Median={np.median(v):.4f}  '
      f'Min={v.min():.4f}  Q25={q25:.4f}  Q75={q75:.4f}  Max={v.max():.4f}')

# --- Quick sensitivity note: excluding negative (batch-correction artifact) values ---
v_pos = v[v >= 0]
G1_pos = pd.Series(v_pos).skew()
print(f'Note: skewness G1 on non-negative values only (N={v_pos.size:,}) = {G1_pos:.6f}')

# --- One-line summary ---
strength = 'strongly' if abs(G1) > 1.5 else ('moderately' if abs(G1) > 0.5 else 'weakly')
direction = 'right-skewed' if G1 > 0 else 'left-skewed'
print(f'\nSkewness (G1) = {G1:.3f} -> {strength} positive {direction} distribution')
