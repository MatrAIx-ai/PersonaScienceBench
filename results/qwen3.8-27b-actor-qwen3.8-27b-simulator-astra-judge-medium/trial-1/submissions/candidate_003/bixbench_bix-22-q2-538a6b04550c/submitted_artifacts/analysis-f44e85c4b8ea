import pandas as pd, numpy as np

# 1) Gene metadata: protein-coding genes (exact biotype) + Length
meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv", index_col=0)
pc = meta[meta["gene_biotype"] == "protein_coding"]
length = pc["Length"].astype(float)

# 2) Sample annotation -> CD4 sample names
ann = pd.read_csv("data/Sample_annotated_Zenodo.csv")
cd4_cols = list(ann.loc[ann["celltype"] == "CD4", "sample"])

# 3) Read-count matrix, select CD4 columns, per-gene mean expression
cnt = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
cd4_mat = cnt[cd4_cols].apply(pd.to_numeric, errors="coerce")
mean_expr = cd4_mat.mean(axis=1)   # arithmetic mean across 151 CD4 samples

# 4) Join on gene symbol (indices align), restrict to protein-coding genes
df = pd.DataFrame({"Length": length, "mean_expr": mean_expr}).dropna()
df = df.reindex(pc.index)          # keep exactly the 19,942 protein-coding genes
assert len(df) == 19942, len(df)
assert df["Length"].isna().sum() == 0
assert df["mean_expr"].isna().sum() == 0

# 5) Pearson correlation
r = df["Length"].corr(df["mean_expr"])  # Pearson by default

n_zero = int((df["mean_expr"] == 0).sum())
print(f"n (protein-coding genes) = {len(df)}")
print(f"CD4 samples used         = {len(cd4_cols)}")
print(f"genes with mean_expr==0  = {n_zero}")
print(f"Pearson r (Length vs mean CD4 expression) = {r:.6f}")
print(f"Pearson r (4 dp)         = {r:.4f}")
