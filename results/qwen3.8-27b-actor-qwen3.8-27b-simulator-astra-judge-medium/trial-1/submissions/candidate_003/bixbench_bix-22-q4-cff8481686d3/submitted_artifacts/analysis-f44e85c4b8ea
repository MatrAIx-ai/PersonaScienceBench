"""
BixBench bix-22-q4: Pearson correlation between gene Length and mean expression
for protein-coding genes in CD14 immune cells.

Approach:
1. Load GeneMetaInfo_Zenodo.csv -> filter to gene_biotype == 'protein_coding' (exact match)
2. Load Sample_annotated_Zenodo.csv -> extract samples where celltype == 'CD14'
3. Load BatchCorrectedReadCounts_Zenodo.csv -> subset to PC genes x CD14 samples
4. Compute per-gene mean expression across the 132 CD14 samples
5. Compute Pearson correlation between Length and mean expression
"""

import pandas as pd
import numpy as np
from scipy.stats import pearsonr
import os

# --- Step 1: Load gene metadata and filter to protein-coding genes ---
print("Loading GeneMetaInfo_Zenodo.csv...")
gm = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)
print(f"  Total genes: {len(gm)}")

pc_mask = gm['gene_biotype'] == 'protein_coding'
pc_genes = gm[pc_mask]
print(f"  Protein-coding genes (exact match): {len(pc_genes)}")
print(f"  Length range: {pc_genes['Length'].min()} - {pc_genes['Length'].max()}")

# --- Step 2: Load sample annotations and identify CD14 samples ---
print("\nLoading Sample_annotated_Zenodo.csv...")
sa = pd.read_csv('data/Sample_annotated_Zenodo.csv')
print(f"  Total samples: {len(sa)}")

cd14_mask = sa['celltype'] == 'CD14'
cd14_samples = sa.loc[cd14_mask, 'sample'].tolist()
print(f"  CD14 samples: {len(cd14_samples)}")

# --- Step 3: Load count matrix and subset ---
print("\nLoading BatchCorrectedReadCounts_Zenodo.csv...")
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
print(f"  Full matrix shape: {counts.shape}")

# Verify all CD14 samples are present
missing_cd14 = set(cd14_samples) - set(counts.columns)
assert len(missing_cd14) == 0, f"Missing CD14 samples: {missing_cd14}"

# Verify all PC genes are present
missing_genes = set(pc_genes.index) - set(counts.index)
assert len(missing_genes) == 0, f"Missing genes: {missing_genes}"

# Subset: protein-coding genes x CD14 samples
cd14_pc = counts.loc[pc_genes.index, cd14_samples]
print(f"  Submatrix shape (PC genes x CD14 samples): {cd14_pc.shape}")
print(f"  Zero fraction: {(cd14_pc == 0).sum().sum() / cd14_pc.size:.4f}")

# --- Step 4: Compute per-gene mean expression across CD14 samples ---
mean_expr = cd14_pc.mean(axis=1)
print(f"\nMean expression stats:")
print(f"  Min: {mean_expr.min():.4f}")
print(f"  Max: {mean_expr.max():.4f}")
print(f"  Median: {mean_expr.median():.4f}")
print(f"  Genes with zero mean: {(mean_expr == 0).sum()}")

# --- Step 5: Compute Pearson correlation ---
length_values = pc_genes['Length'].values
r, p_value = pearsonr(length_values, mean_expr.values)

print(f"\n{'='*60}")
print(f"RESULTS")
print(f"{'='*60}")
print(f"Pearson correlation coefficient (r): {r:.6f}")
print(f"P-value: {p_value:.3e}")
print(f"Number of genes: {len(length_values)}")
print(f"Number of CD14 samples: {len(cd14_samples)}")
print(f"{'='*60}")

# --- Save results ---
results = pd.DataFrame({
    'gene': pc_genes.index,
    'length': length_values,
    'mean_expression_cd14': mean_expr.values
})
results.to_csv('/workspace/correlation_data.csv', index=False)
print(f"\nSaved per-gene data to /workspace/correlation_data.csv")
