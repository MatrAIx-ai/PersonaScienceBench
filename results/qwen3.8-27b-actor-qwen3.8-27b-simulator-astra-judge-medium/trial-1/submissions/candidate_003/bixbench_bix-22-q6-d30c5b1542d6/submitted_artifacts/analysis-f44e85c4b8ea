import pandas as pd
import numpy as np
from scipy import stats

# 1. Load gene metadata
g = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)

# 2. Filter to PROTEIN-CODING ONLY (exact match; excludes 12 multi-value semicolon rows)
pc_mask = g['gene_biotype'] == 'protein_coding'
pc = g[pc_mask]
n_pc = len(pc)
print("=== FILTER CHECK ===")
print("Total genes in GeneMetaInfo:", len(g))
print("Exact 'protein_coding' genes (n):", n_pc)
print("Multi-value biotype rows (semicolon):", g['gene_biotype'].astype(str).str.contains(';').sum())
print("Rows containing 'protein_coding' substring:", g['gene_biotype'].astype(str).str.contains('protein_coding').sum())
print("Difference (ambiguous multi-value, EXCLUDED):",
      g['gene_biotype'].astype(str).str.contains('protein_coding').sum() - n_pc)
print("Any semicolon in the pc subset (should be 0):", pc['gene_biotype'].astype(str).str.contains(';').sum())

# 3. Load count matrix
df = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
n_samples = df.shape[1]
print("\n=== EXPRESSION MATRIX ===")
print("Samples (columns):", n_samples)
print("Protein-coding genes present in matrix:", pc.index.isin(df.index).sum(), "of", n_pc)

# 4. Per-gene mean across ALL samples (raw counts) - PRIMARY metric
X = df.loc[pc.index].values.astype(float)
mean_expr = X.mean(axis=1)
zero_mean = int((mean_expr == 0).sum())
print("Protein-coding genes with ZERO mean expression:", zero_mean, "(included in correlation)")

L = pc['Length'].values.astype(float)

# 5. Pearson r - PRIMARY: raw mean expression
r_raw, p_raw = stats.pearsonr(L, mean_expr)

# Sensitivity checks
r_logmean, p_logmean = stats.pearsonr(L, np.log1p(mean_expr))
median_expr = np.median(X, axis=1)
r_median, p_median = stats.pearsonr(L, median_expr)
r_logmedian, p_logmedian = stats.pearsonr(L, np.log1p(median_expr))

print("\n=== PEARSON CORRELATION: gene Length vs gene expression (n=%d) ===" % n_pc)
print("PRIMARY  raw mean expr      : r = %.6f  (p = %.3e)" % (r_raw, p_raw))
print("Sensit.  log1p(mean) expr   : r = %.6f  (p = %.3e)" % (r_logmean, p_logmean))
print("Sensit.  median expr        : r = %.6f  (p = %.3e)" % (r_median, p_median))
print("Sensit.  log1p(median) expr : r = %.6f  (p = %.3e)" % (r_logmedian, p_logmedian))

print("\n=== DIAGNOSTICS ===")
print("n protein-coding genes:", n_pc)
print("n samples:", n_samples)
print("zero-mean-expression genes (included):", zero_mean)
print("Length min/max:", L.min(), L.max())
print("Mean expr min/max:", mean_expr.min(), mean_expr.max())
print()
print("HEADLINE: Pearson r = %.4f  (raw mean expression, n=%d protein-coding genes)" % (r_raw, n_pc))
