"""
TASK008 BCG-CORONA: ordinal regression for the effect of BCG vaccination on
COVID-19 severity, controlling for prior medical-history count, patients
interaction frequency, and their two-way interaction.

Outcome   : subject-level MAX AESEV among AEPT=='COVID-19' AEs (ordinal 1-4).
Model     : proportional-odds / cumulative-logit (statsmodels OrderedModel).
Fixed fx  : BCG (TRTGRP) + mh-count + C(patients_seen) + mh-count:C(patients_seen).
Headline  : odds ratio of BCG = exp(BCG coefficient), 95% CI, and model used.
"""
import warnings; warnings.filterwarnings("ignore")
import numpy as np, pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel
from statsmodels.api import Logit
from scipy import stats as sstats
pd.set_option("display.width",200); pd.set_option("display.max_columns",None)

# ---------- 1. Build subject-level frame ----------
dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv").drop_duplicates("USUBJID").set_index("USUBJID")
ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv")
mh_total  = mh.groupby("USUBJID").size()                                                # primary (researcher def)
mh_mhterm = mh.groupby("USUBJID")["MHTERM"].apply(lambda s:s.dropna().nunique())        # sensitivity
cov = ae[ae["AEPT"]=="COVID-19"]
sev = cov.groupby("USUBJID")["AESEV"].max().dropna().astype(int)                         # drop all-NaN
pop = sev.index
df = pd.DataFrame({
    "BCG":(dm.loc[pop,"TRTGRP"]=="BCG").astype(int),
    "sev":sev.values,
    "mh_total":mh_total.loc[pop].values,
    "mh_mhterm":mh_mhterm.loc[pop].values,
    "patients_seen":dm.loc[pop,"patients_seen"].values,
})
df["sev3"]=np.minimum(df["sev"],3)

print("="*72)
print("ANALYSIS POPULATION (AEPT=='COVID-19', non-missing AESEV):",len(df))
print("TRTGRP:",dict(df["BCG"].map({1:"BCG",0:"Placebo"}).value_counts()))
print("Outcome 4-level (max AESEV):",dict(df["sev"].value_counts().sort_index()))
print("Outcome 3-level (3+4 merged):",dict(df["sev3"].value_counts().sort_index()))
print("patients_seen:",dict(df["patients_seen"].value_counts()))
print("mh_total range:",df["mh_total"].min(),"-",df["mh_total"].max(),
      "| mh_mhterm range:",df["mh_mhterm"].min(),"-",df["mh_mhterm"].max())
print("Cross-tab BCG x sev4:"); print(pd.crosstab(df["BCG"].map({1:"BCG",0:"Placebo"}),df["sev"]))
print("="*72)

# ---------- 2. Brant test (manual, robust) ----------
def brant_test(y, exog, cats):
    """Wald test that slope coefficients are equal across all cumulative cutpoints.
    OrderedModel exog has NO intercept (thresholds are separate cutpoint params);
    add an intercept for the per-cutpoint Logits, then compare slopes only."""
    from statsmodels.tools import add_constant
    J=len(cats)-1; p=exog.shape[1]                 # all exog cols are slopes
    if J<2: return dict(W=np.nan,df=0,p=np.nan,note="<2 cutpoints")
    exog_c=add_constant(exog)                      # 1 + p columns
    events=[int((y>cats[j]).sum()) for j in range(J)]
    if min(events) < p+1:
        return dict(W=np.nan,df=0,p=np.nan,
                    note=f"unreliable: top cutpoint has {min(events)} events < {p+1} params")
    try:
        betas=[]; Vs=[]
        for j in range(J):
            yj=(y>cats[j]).astype(float)
            m=Logit(yj,exog_c).fit(disp=0,maxiter=5000)
            b=m.params; c=m.cov_params()
            if b.shape[0]!=exog_c.shape[1] or c.shape!=(exog_c.shape[1],exog_c.shape[1]):
                return dict(W=np.nan,df=0,p=np.nan,note="shape mismatch")
            betas.append(b[1:]); Vs.append(c[1:,1:])
        betas=np.array(betas); Vs=np.array(Vs)
        Vinv=np.array([np.linalg.pinv(v) for v in Vs]); S=Vinv.sum(0)
        Vinv_betas=np.einsum("kij,kj->ki",Vinv,betas)     # per-cutpoint Vinv_j @ beta_j
        beta_bar=np.linalg.solve(S, Vinv_betas.sum(0))
        W=float(sum((betas[j]-beta_bar)@Vinv[j]@(betas[j]-beta_bar) for j in range(J)))
        dof=(J-1)*p
        return dict(W=W,df=dof,p=float(1-sstats.chi2.cdf(W,dof)),
                    note=f"ok (cutpoint events={events})")
    except Exception as e:
        return dict(W=np.nan,df=0,p=np.nan,note=f"err:{e}")

# ---------- 3. Fit helper (center mh for stability; does NOT change BCG OR) ----------
def fit_ord(ycol, mhcol, data, maxiter=20000):
    d=data.copy(); d[mhcol+"_c"]=d[mhcol]-d[mhcol].mean()
    f=f"{ycol} ~ BCG + {mhcol}_c + C(patients_seen) + {mhcol}_c:C(patients_seen)"
    m=OrderedModel.from_formula(f,data=d,distr="logit")
    r=m.fit(disp=0,maxiter=maxiter)
    if not r.mle_retvals.get("converged"):                 # retry with BFGS
        try:
            r2=m.fit(disp=0,method="bfgs",maxiter=maxiter)
            if r2.mle_retvals.get("converged"): r=r2
        except Exception: pass
    return m,r

def or_row(r,label):
    ci=np.exp(r.conf_int().loc["BCG"])
    return dict(model=label,BCG_coef=round(r.params["BCG"],4),
                BCG_OR=round(np.exp(r.params["BCG"]),3),
                OR_95CI=f"[{ci[0]:.3f},{ci[1]:.3f}]",OR_p=round(r.pvalues["BCG"],4),
                converged=bool(r.mle_retvals.get("converged")))

# ---------- 4. Primary (4-level) ----------
print("\n### PRIMARY MODEL: 4-level (max AESEV 1-4), mh_total ###")
m4,r4=fit_ord("sev","mh_total",df)
print(r4.summary())
row4=or_row(r4,"4-level, mh_total")
b4=brant_test(df["sev"].values,m4.exog,[1,2,3,4])
print(f"Brant test (4-level): W={b4['W']:.3f}, df={b4['df']}, p={b4['p']:.3f} | {b4['note']}")
print("cov condition number (4-level):",round(np.linalg.cond(r4.cov_params()),1))

# ---------- 5. Fallback / robustness (3-level) ----------
print("\n### ROBUSTNESS: 3-level (3+4 merged), mh_total ###")
m3,r3=fit_ord("sev3","mh_total",df)
row3=or_row(r3,"3-level, mh_total")
b3=brant_test(df["sev3"].values,m3.exog,[1,2,3])
print(f"Brant test (3-level): W={b3['W']:.3f}, df={b3['df']}, p={b3['p']:.3f} | {b3['note']}")

# ---------- 6. Sensitivity: mhcount definition ----------
print("\n### SENSITIVITY: prior-medical-history count definition ###")
sens=[or_row(fit_ord("sev","mh_total",df)[1],   "4-level, mh_total(total rows)"),
      or_row(fit_ord("sev","mh_mhterm",df)[1],  "4-level, mh_mhterm(distinct)"),
      or_row(fit_ord("sev3","mh_total",df)[1],  "3-level, mh_total(total rows)"),
      or_row(fit_ord("sev3","mh_mhterm",df)[1], "3-level, mh_mhterm(distinct)")]
print(pd.DataFrame(sens).to_string(index=False))

# ---------- 7. Headline ----------
print("\n"+"="*72)
head=row4 if row4["converged"] else row3
print("PRIMARY MODEL USED:",head["model"])
print(f"BCG odds ratio on COVID-19 severity = {head['BCG_OR']}  (95% CI {head['OR_95CI']}, p={head['OR_p']})")
print(f"  4-level: OR={row4['BCG_OR']} CI {row4['OR_95CI']} (converged={row4['converged']})")
print(f"  3-level: OR={row3['BCG_OR']} CI {row3['OR_95CI']} (converged={row3['converged']})")
print("="*72)
print("Saved analysis script: analysis.py")
