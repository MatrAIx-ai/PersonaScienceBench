#!/usr/bin/env python3
"""
TASK008 BCG-CORONA (bix-29-q2)
Question: Independent effect of each additional ongoing medical condition (MHONGO)
on the odds of higher COVID-19 severity, controlling for BCG vaccination status
and patient interaction variables, via ordinal regression.
Expressed as percentage (0-100%) increase in odds = (exp(beta) - 1) * 100.

Design (researcher-approved):
  - Primary outcome: subjects with AEPT=='COVID-19' and non-missing AESEV (n=148);
    ordinal levels 1<2<3<4 (Mild/Moderate/Severe/Life-threatening),
    peak (max) AESEV per subject when multiple records.
  - Sensitivity outcome: all COVID-containing AEPT terms (n=151), peak severity.
  - First-record severity sensitivity (ordered by AESTDTC).
  - Predictor of interest: per-patient COUNT of MH rows with MHONGO=='Yes' (0-7).
  - Controls: BCG (TRTGRP) + all 7 DM 'patient interaction variables'
    (SEX, Age, RACE, education, work_hours, patients_seen, expect_interact),
    all categorical, main effects, reference = first level.
  - Sparse tail levels are KEPT (RACE 4/5, work_hours >80); merged only if the
    model fails to converge after BFGS(maxiter) -> Nelder-Mead.
  - Model: proportional-odds cumulative logit (statsmodels OrderedModel).
    Likelihood convention (statsmodels): P(Y<=k) = F(a_k - x'b), a_0=-inf, a_4=inf.
  - Proportional-odds check: LRT vs separate logits + PPOM (n_ongoing
    split-specific). Primary answer remains proportional-odds.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from statsmodels.genmod.generalized_linear_model import GLM
from statsmodels.genmod.families import Binomial
from scipy import stats
from scipy.optimize import minimize

DATA = "data"
dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")
ae = ae[ae["AEPT"].notna()]  # drop 143 empty placeholder rows

# ---------------- covariates (DM) ----------------
sub = dm.set_index("USUBJID").copy()
sub["bcg"] = (sub["TRTGRP"] == "BCG").astype(int)
CATS = ["SEX", "Age", "RACE", "education", "work_hours", "patients_seen", "expect_interact"]
for c in CATS:
    sub[c] = sub[c].astype(str)

# ---------------- ongoing-condition count (MH) ----------------
ongoing = mh[(mh["MHSCAT"] == "MEDICAL HISTORY") & (mh["MHONGO"] == "Yes")].groupby("USUBJID").size()
sub["n_ongoing"] = sub.index.map(ongoing).fillna(0).astype(int)

# ---------------- outcome builders ----------------
def build_outcome(ae, terms, mode="peak"):
    t = ae[ae["AEPT"].isin(terms) & ae["AESEV"].notna()]
    if mode == "peak":
        return t.groupby("USUBJID")["AESEV"].max().astype(int)
    t = t.sort_values("AESTDTC")
    return t.groupby("USUBJID")["AESEV"].first().astype(int)

COVID_EXACT = ["COVID-19"]
COVID_ALL = sorted(set(ae["AEPT"][ae["AEPT"].str.contains("COVID", case=False)].unique()))
print("Primary terms:", COVID_EXACT, "| All-COVID terms:", COVID_ALL)

def design(d):
    """Categorical dummies (drop-first) over levels PRESENT in the analysis subset."""
    d = d.copy()
    X = pd.DataFrame(index=d.index)
    X["bcg"] = d["bcg"].astype(float)
    X["n_ongoing"] = d["n_ongoing"].astype(float)
    for c in CATS:
        d[c] = d[c].astype("category")  # levels = those present in subset
        dd = pd.get_dummies(d[c], prefix=c, drop_first=True, dtype=float)
        X = pd.concat([X, dd], axis=1)
    assert (X.abs().sum() > 0).all(), "zero column detected"
    return X

# ---------------- primary analysis set ----------------
sev_primary = build_outcome(ae, COVID_EXACT, "peak")
d = sub.loc[sev_primary.index].copy()
d["SEV"] = sev_primary.values
Xp = design(d)
yp = (d["SEV"].astype(int) - 1).values
print(f"\nPrimary set: n={len(d)} | SEV dist: {d['SEV'].value_counts().sort_index().to_dict()}")
print(f"n_ongoing dist: {d['n_ongoing'].value_counts().sort_index().to_dict()}")
print("Levels present: " + ", ".join(f"{c}={list(d[c].astype('category').cat.categories)}" for c in CATS))
print(f"Design: {Xp.shape[1]} covariate terms -> full model {Xp.shape[1]+3} params (incl. 3 thresholds)")

def fit_po(y, X):
    """proportional-odds fit; BFGS -> Nelder-Mead -> merge tail levels (last resort)"""
    notes = []
    res = OrderedModel(y, X, distr="logit").fit(method="bfgs", maxiter=2000)
    if not res.mle_retvals["converged"]:
        notes.append("BFGS(maxiter=2000) failed; Nelder-Mead")
        res = OrderedModel(y, X, distr="logit").fit(method="nm", maxiter=50000)
        if res.mle_retvals["converged"]:
            notes.append("converged via Nelder-Mead")
            return res, notes
        notes.append("NM failed; MERGED tail levels RACE 4+5, work_hours 41-80+>80")
        X2 = X.drop(columns=[c for c in X.columns
                             if c.startswith("RACE_5") or c.startswith("work_hours_41-80")])
        res = OrderedModel(y, X2, distr="logit").fit(method="bfgs", maxiter=2000)
        return res, notes
    return res, notes

res_p, notes_p = fit_po(yp, Xp)
print(f"\nPrimary PO model converged: {res_p.mle_retvals['converged']} | notes: {notes_p}")
b, se = res_p.params, res_p.bse
ci_l, ci_h = b["n_ongoing"] - 1.96 * se["n_ongoing"], b["n_ongoing"] + 1.96 * se["n_ongoing"]
or_p = float(np.exp(b["n_ongoing"]))
pct_p = (or_p - 1) * 100
print("\n=== PRIMARY (proportional odds, n=148, peak severity) ===")
print(f"beta_n_ongoing = {b['n_ongoing']:.4f} (SE {se['n_ongoing']:.4f})")
print(f"95% CI beta: [{ci_l:.4f}, {ci_h:.4f}]")
print(f"OR = {or_p:.4f}  ->  {pct_p:.2f}% increase in odds of higher severity per additional ongoing condition")
print(f"95% CI % increase: [{(np.exp(ci_l)-1)*100:.2f}%, {(np.exp(ci_h)-1)*100:.2f}%]")
print(f"LLF={res_p.llf:.2f} LRF={res_p.llr:.2f} p={res_p.llr_pvalue:.3f} n={res_p.nobs} k={res_p.df_model}")
print("\nAll coefficients:\n", pd.DataFrame({"coef": b, "se": se}).round(4).to_string())

# ---------------- proportional-odds check ----------------
# (a) LRT: PO vs fully separate logits per cumulative split (k=1,2,3)
warnings.filterwarnings("ignore", category=UserWarning)
Xc = sm.add_constant(Xp.astype(float))
sep_ll, sep_k = 0.0, 0
for k in (1, 2, 3):
    m = GLM((yp <= k).astype(float), Xc, family=Binomial()).fit()
    sep_ll += m.llf
    sep_k += m.df_model + 1
lrt_stat = 2 * (sep_ll - res_p.llf)
lrt_df = sep_k - (res_p.df_model + 3)
lrt_p = float(1 - stats.chi2.cdf(lrt_stat, lrt_df))
print(f"\nLRT proportional-odds: chi2({lrt_df})={lrt_stat:.2f}, p={lrt_p:.4f}")
print("(separate-logit GLMs hit perfect separation on sparse cells -> LRT over-powered)")

# (b) PPOM: n_ongoing split-specific, other covariates proportional.
# Convention matches statsmodels: P(Y<=k) = F(a_k - x'b - g_k*x_nongoing), g_0=0.
def ppom_nll(theta, y, Xv, idx, n_splits=3):
    p = Xv.shape[1]
    common = theta[:p]
    t = theta[p:p+n_splits]  # statsmodels convention: t1 raw, t2/t3 log-increments
    a = np.concatenate([t[:1], np.exp(t[1:])]).cumsum()
    delta = theta[p+n_splits:]
    base = Xv @ common
    L = np.empty((len(base), n_splits))
    for k in range(n_splits):
        g = 0.0 if k == 0 else delta[k-1] * Xv[:, idx]
        L[:, k] = a[k] - base - g
    L = np.clip(L, -30, 30)
    F = 1 / (1 + np.exp(-L))
    P = np.empty((len(y), 4))
    P[:, 0] = F[:, 0]
    P[:, 1] = F[:, 1] - F[:, 0]
    P[:, 2] = F[:, 2] - F[:, 1]
    P[:, 3] = 1 - F[:, 2]
    return -np.log(np.clip(P, 1e-12, None))[np.arange(len(y)), y].sum()

p = Xp.shape[1]
d0 = list(Xp.columns).index("n_ongoing")
order = list(b.index)
cov_names = [c for c in order if c not in ("0/1", "1/2", "2/3")]
theta0 = np.concatenate([b[cov_names].values, b[["0/1", "1/2", "2/3"]].values, [0.0, 0.0]])  # transformed thresholds, same as statsmodels
nll0 = ppom_nll(theta0, yp, Xp.values, d0)
assert abs(nll0 - (-res_p.llf)) < 1e-6, f"PPOM likelihood mismatch: {nll0} vs {-res_p.llf}"
opt = minimize(ppom_nll, theta0, args=(yp, Xp.values, d0), method="L-BFGS-B")
th = opt.x
beta_ppom = float(th[d0])
g = np.array([0.0, th[p+3], th[p+4]])
slopes = beta_ppom + g  # total n_ongoing slope in cumulative logit per split
Hi = opt.hess_inv
Hi = np.asarray(Hi.todense()) if hasattr(Hi, "todense") else np.asarray(Hi)
se_beta_ppom = float(np.sqrt(max(Hi[d0, d0], 0)))
avg_slope = float(np.mean(slopes))
print(f"\nPPOM: common beta_n_ongoing = {beta_ppom:.4f} (SE {se_beta_ppom:.4f})")
print(f"PPOM split-specific total slopes: {['%.3f' % s for s in slopes]}")
print(f"PPOM avg slope = {avg_slope:.4f} -> {(np.exp(avg_slope)-1)*100:.2f}% | "
      f"common beta -> {(np.exp(beta_ppom)-1)*100:.2f}%")

# ---------------- sensitivities ----------------
sens = []
def run_sens(label, yv, Xv):
    r, nts = fit_po(yv, Xv)
    bb, ss = r.params["n_ongoing"], r.bse["n_ongoing"]
    sens.append((label, bb, ss, (np.exp(bb)-1)*100,
                 (np.exp(bb-1.96*ss)-1)*100, (np.exp(bb+1.96*ss)-1)*100, "; ".join(nts) or "converged BFGS"))

sev_all = build_outcome(ae, COVID_ALL, "peak")
d1 = sub.loc[sev_all.index].copy(); d1["SEV"] = sev_all.values
run_sens(f"all-COVID terms, peak severity (n={len(d1)})", (d1["SEV"]-1).values, design(d1))

sev_first = build_outcome(ae, COVID_EXACT, "first")
d2 = sub.loc[sev_first.index].copy(); d2["SEV"] = sev_first.values
run_sens(f"first-record severity, exact terms (n={len(d2)})", (d2["SEV"]-1).values, design(d2))

sens.append(("PPOM (n_ongoing split-specific), primary set", beta_ppom, se_beta_ppom,
             (np.exp(beta_ppom)-1)*100,
             (np.exp(beta_ppom-1.96*se_beta_ppom)-1)*100,
             (np.exp(beta_ppom+1.96*se_beta_ppom)-1)*100, "scipy L-BFGS-B"))

print("\n=== SENSITIVITY TABLE (effect of +1 ongoing condition) ===")
tab = pd.DataFrame(sens, columns=["spec", "beta", "se", "pct_inc", "ci_lo", "ci_hi", "fit"])
print(tab.round(4).to_string(index=False))

print("\n=== FINAL ANSWER (primary) ===")
print(f"Each additional ongoing medical condition (MHONGO) is associated with a "
      f"~{pct_p:.1f}% increase in the odds of higher COVID-19 severity "
      f"(OR={or_p:.3f}, 95% CI {(np.exp(ci_l)-1)*100:.1f}%-{(np.exp(ci_h)-1)*100:.1f}%), "
      f"controlling for BCG vaccination status and patient interaction variables "
      f"(proportional-odds ordinal regression, n={res_p.nobs}).")
