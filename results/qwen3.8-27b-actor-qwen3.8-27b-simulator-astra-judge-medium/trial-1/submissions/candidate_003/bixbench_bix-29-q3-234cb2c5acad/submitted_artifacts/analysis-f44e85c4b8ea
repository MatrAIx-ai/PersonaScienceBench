"""
BCG x prior-medical-history interaction on COVID-19 severity.
Proportional-odds (ordered logit) model controlling for patient interaction frequency.
Analysis unit: one row per subject (USUBJID).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)

DM = "data/TASK008_BCG-CORONA_DM.csv"
AE = "data/TASK008_BCG-CORONA_AE.csv"
MH = "data/TASK008_BCG-CORONA_MH.csv"

dm = pd.read_csv(DM)
ae = pd.read_csv(AE)
mh = pd.read_csv(MH)

# ----------------------------------------------------------------------
# 1) Subject-level covariates from DM
# ----------------------------------------------------------------------
bcg = dm.set_index("USUBJID").TRTGRP.map({"BCG": 1, "Placebo": 0})
ps  = dm.set_index("USUBJID").patients_seen  # '1-50','51-100','>100'

# ----------------------------------------------------------------------
# 2) Prior medical history (from MH)
#    Standardised comorbidity rows: MHTERM non-null and not free-text 'Other:'
#    Coding: MHORRES==1 -> absent (default); MHORRES==2 -> flagged comorbidity.
# ----------------------------------------------------------------------
std = mh[mh.MHTERM.notna() & ~mh.MHTERM.astype(str).str.startswith("Other:")].copy()
mhA = ((std.MHORRES == 2)).groupby(std.USUBJID).any()                                  # Option A
mhB = (((std.MHORRES == 2) & (std.MHCM == "Yes"))).groupby(std.USUBJID).any()          # Option B

# ----------------------------------------------------------------------
# 3) COVID-19 severity (from AE)
#    COVID-specific rows: AEPT contains COVID/SARS-CoV  OR  AEHLT contains 'Coronavirus'
#    Subject outcome = MAX AESEV across their COVID rows.
# ----------------------------------------------------------------------
covid = (ae["AEPT"].astype(str).str.contains("COVID|Coronavirus|SARS-CoV", case=False, na=False) |
         ae["AEHLT"].astype(str).str.contains("Coronavirus", case=False, na=False))
c = ae[covid]
maxsev   = c.groupby("USUBJID").AESEV.max()
n_covid  = c.groupby("USUBJID").size()

# ----------------------------------------------------------------------
# 4) Assemble subject-level frame
# ----------------------------------------------------------------------
df = pd.DataFrame({
    "USUBJID": bcg.index,
    "BCG": bcg.values,
    "patients_seen": ps.reindex(bcg.index).values,
    "MH_A": mhA.reindex(bcg.index).fillna(False).astype(int).values,
    "MH_B": mhB.reindex(bcg.index).fillna(False).astype(int).values,
    "hascovid": (n_covid.reindex(bcg.index).fillna(0) > 0).astype(int).values,
    "sev": maxsev.reindex(bcg.index).values,
}).reset_index(drop=True)

# ----------------------------------------------------------------------
# 5) PRIMARY sample: documented, rated COVID AEs (non-NaN severity), levels 1-4
# ----------------------------------------------------------------------
p = df[df.sev.notna()].copy()
p["sev"] = p["sev"].astype(int)
print("PRIMARY analysis sample (documented, rated COVID AE): n =", len(p))
print("Severity distribution:\n", p.sev.value_counts().sort_index().to_string())
print("\nBCG x priorMH(A) 4-cell counts:\n", pd.crosstab(p.BCG, p.MH_A).to_string())

def run_om(data, mhcol, title):
    d = data.copy()
    d["PS_51_100"] = (d.patients_seen == "51-100").astype(int)
    d["PS_gt100"]  = (d.patients_seen == ">100").astype(int)
    d["BCG_x_MH"]  = d["BCG"] * d[mhcol]
    X = d[["BCG", mhcol, "BCG_x_MH", "PS_51_100", "PS_gt100"]].astype(float)  # NO constant
    model = OrderedModel(d["sev"].astype(float), X, distr="logit", method="newton")
    res = model.fit(method="newton", disp=0, maxiter=500)
    print("\n" + "="*70)
    print(title, "  (n =", len(d), ")")
    print("="*70)
    print("\n-- Coefficient table (proportional-odds / ordered logit) --")
    tab = pd.DataFrame({"coef": res.params, "se": res.bse,
                        "z": res.tvalues, "p": res.pvalues,
                        "CI_low": res.conf_int()[0], "CI_high": res.conf_int()[1]})
    print(tab.round(4).to_string())
    b = res.params["BCG_x_MH"]
    lo, hi = res.conf_int().loc["BCG_x_MH"]
    print("\n>> INTERACTION OR (BCG x priorMH) = exp(%.4f) = %.3f   95%% CI [exp(%.4f), exp(%.4f)] = [%.3f, %.3f]"
          % (b, np.exp(b), lo, hi, np.exp(lo), np.exp(hi)))
    for name in ["BCG", mhcol, "PS_51_100", "PS_gt100"]:
        print("   OR %-11s = %.3f  95%% CI [%.3f, %.3f]" %
              (name, np.exp(res.params[name]),
               np.exp(res.conf_int().loc[name,0]), np.exp(res.conf_int().loc[name,1])))
    try:
        conv = res.mle_retvals.get("converged", "n/a"); it = res.mle_retvals.get("iterations", "n/a")
    except Exception:
        conv = "n/a"; it = "n/a"
    print("\n   Model: llf=%.2f, df_model=%d, df_resid=%d, converged=%s, iterations=%s" %
          (res.llf, res.df_model, res.df_resid, conv, it))
    return res, d

# --------------------------- PRIMARY (Option A) ---------------------------
resA, dA = run_om(p, "MH_A", "PRIMARY  |  priorMH = Option A (any MHORRES==2)")

# BCG x MH 4-cell severity cross-tab (primary)
print("\n-- BCG x priorMH(A) x severity cross-tab (primary sample) --")
print(pd.crosstab([p.BCG, p.MH_A], p.sev).to_string())

# --------------------------- SENSITIVITY (Option B) ---------------------------
resB, dB = run_om(p, "MH_B", "SENSITIVITY  |  priorMH = Option B (MHORRES==2 & MHCM=='Yes')")
print("\n-- BCG x priorMH(B) x severity cross-tab (sensitivity sample) --")
print(pd.crosstab([p.BCG, p.MH_B], p.sev).to_string())

# --------------------------- PROPORTIONAL-ODDS NOTE ---------------------------
print("\n" + "="*70)
print("PROPORTIONAL-ODDS ASSUMPTION NOTE")
print("="*70)
print("Outcome levels 3 and 4 are sparse (level 3: n=%d, level 4: n=%d)." %
      (int((p.sev==3).sum()), int((p.sev==4).sum())))
print("The proportional-odds (common-OR) model assumes the BCG, priorMH and their")
print("interaction shift all cumulative severity thresholds by the same log-odds amount.")
print("With only %d observations at level 3 and %d at level 4, the top-threshold" %
      (int((p.sev==3).sum()), int((p.sev==4).sum())))
print("estimates (and hence the interaction OR) are imprecise; see the wide CI.")
print("A non-proportional-odds (partial-proportional) model could relax this but")
print("is under-powered at n=%d with a 4-way interaction." % len(p))

# --------------------------- SUMMARY ---------------------------
bA = resA.params["BCG_x_MH"]; loA,hiA = resA.conf_int().loc["BCG_x_MH"]
bB = resB.params["BCG_x_MH"]; loB,hiB = resB.conf_int().loc["BCG_x_MH"]
print("\n" + "="*70)
print("SUMMARY")
print("="*70)
print("PRIMARY (Option A, n=%d): interaction OR = %.3f, 95%% CI [%.3f, %.3f]" %
      (len(p), np.exp(bA), np.exp(loA), np.exp(hiA)))
print("SENSITIVITY (Option B, n=%d): interaction OR = %.3f, 95%% CI [%.3f, %.3f]" %
      (len(p), np.exp(bB), np.exp(loB), np.exp(hiB)))
