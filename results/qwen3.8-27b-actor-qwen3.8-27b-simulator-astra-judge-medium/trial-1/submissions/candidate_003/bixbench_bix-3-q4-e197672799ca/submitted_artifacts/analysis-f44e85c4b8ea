#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
DESeq2 differential expression analysis - Mueller 2017 Paroxetine RNA-seq
=========================================================================
QUESTION (bix-3-q4):
  "Using DESeq2 to conduct differential expression analysis between final blood and
   baseline blood, dentate gyrus and baseline blood, and dentate gyrus and final
   blood, how many genes are differentially expressed across all comparisons?"

TOOLING NOTE (reproducibility / deviation log):
  R and the DESeq2 Bioconductor package were NOT available in this environment
  (no R / Rscript / conda, and no network access to install them - DNS resolution
  fails). Per the task's requirement for an EXECUTED DESeq2 analysis, this script
  faithfully RE-IMPLEMENTs the DESeq2 statistical workflow in Python
  (numpy / scipy / statsmodels):
    1. Size-factor normalization        (median-of-ratios, as in estimateSizeFactors)
    2. Per-gene dispersion              (design-aware negative-binomial moment estimate)
    3. Dispersion trend + shrinkage      (LOESS of log(alpha) ~ log(baseMean), weighted pull)
    4. Negative-binomial GLM, design ~ tissue (3 levels). For a group-only design the
       NB MLE of each group mean equals the group sample mean, so log2FC = log(mean ratio)
       and the Wald SE comes from the NB Fisher information  X' diag(mu/(1+alpha*mu)) X.
    5. Wald test for each contrast
    6. Benjamini-Hochberg FDR -> padj
  This is the DESeq2 methodology. Exact numbers may differ slightly from the R package
  (which uses a profile-likelihood dispersion MLE and a Cook's-distance outlier step).

DATA / INPUT SCHEMA:
  File : data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
  Sheet: 'NormCount'
    - Row 1 = tissue-group header (baseline blood / dentate gyrus / final blood).
    - Row 4 = column names. Column 1 (idx 0) = 'Index' (numeric);
      Column 2 (idx 1) = 'GeneID'  <-- the GENE NAME (NOT column 1).
    - Columns 3..92 (idx 2..91) = 90 samples (30 per tissue), named by 'Code'.
    - Values are NORMALIZED counts (floats). No raw-count matrix exists in the file,
      so we ROUND them to integers as a proxy for raw counts (acknowledged limitation:
      DESeq2 re-estimates size factors on these rounded values).
  Sheet: 'Mapping_statistics' -> confirms 3 tissues x 30 and 3 responses x 30;
    all 90 samples valid (no exclusions).

DESIGN:
  ~ tissue  (3 levels: baseline_blood, dentate_gyrus, final_blood; 90 samples, 30 each).
  Response group is NOT in the design (the question asks tissue-level comparisons).

CONTRASTS (3):
  C1) final_blood    vs baseline_blood
  C2) dentate_gyrus  vs baseline_blood
  C3) dentate_gyrus  vs final_blood

DE DEFINITION:
  padj < 0.1  (DESeq2 default)  with NO |log2FC| filter.

HEADLINE ANSWER:
  UNION of distinct DE genes across the 3 comparisons (also report SUM and INTERSECTION).
"""
import warnings, json, time
warnings.filterwarnings("ignore")
import numpy as np
import openpyxl
from scipy.stats import norm
from statsmodels.nonparametric.smoothers_lowess import lowess

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
PADJ_CUT = 0.1

# ----------------------------------------------------------------------
# 1) LOAD COUNT MATRIX  (genes x 90 samples)
# ----------------------------------------------------------------------
def load_counts():
    wb = openpyxl.load_workbook(XLSX, read_only=True, data_only=True)
    ws = wb["NormCount"]
    genes, samples, K = [], [], []
    for i, r in enumerate(ws.iter_rows(values_only=True)):
        if i < 4:
            if i == 3:                                   # row 4 = column names
                samples = [str(r[j]) for j in range(2, 92)]
            continue
        g = r[1]                                          # GeneID (column 2)
        if g is None:
            continue
        genes.append(str(g))
        vals = []
        for j in range(2, 92):
            v = r[j]
            vals.append(float(v) if isinstance(v, (int, float)) else 0.0)
        K.append(vals)
    K = np.rint(np.array(K, dtype=float)).astype(np.int64)   # round normalized -> int proxy
    return np.array(genes), samples, K

# ----------------------------------------------------------------------
# 2) DESeq2 CORE
# ----------------------------------------------------------------------
def size_factors(K):
    gm = np.exp(np.nanmean(np.log(K + 1e-12), axis=1))
    ratio = (K + 1e-12) / gm[:, None]
    sf = np.nanmedian(ratio, axis=0)
    sf[sf == 0] = 1.0
    return sf

def deseq2(K, X, mask):
    n = K.shape[0]
    sf = size_factors(K)
    Kn = K / sf[None, :]
    baseMean = Kn.mean(axis=1)

    # group sample means (NB MLE for group-only design) and moment dispersion
    ybar = np.column_stack([Kn[:, mask[g]].mean(axis=1) for g in range(3)])
    yvar = np.column_stack([Kn[:, mask[g]].var(axis=1, ddof=1) for g in range(3)])
    nper = np.array([mask[g].sum() for g in range(3)], float)
    num = ((nper - 1) * (yvar - ybar)).sum(axis=1)
    den = ((nper - 1) * ybar ** 2).sum(axis=1)
    with np.errstate(divide='ignore', invalid='ignore'):
        alpha = np.where(den > 0, np.maximum(num / den, 0.0), 0.0)

    # ---- LOESS trend + shrinkage (stable: no divergent values) ----
    ok = (baseMean > 0.5) & (alpha > 0)
    alpha_shrunk = alpha.copy()
    if ok.sum() > 20:
        xt = np.log(baseMean[ok]); yt = np.log(alpha[ok])
        lo = lowess(yt, xt, frac=0.5, it=3)
        sigma = max(np.std(yt - lo[:, 1]), 1e-3)
        n_eff = (Kn > 0).sum(axis=1)
        for gi in np.where(ok)[0]:
            lv = np.log(baseMean[gi])
            trend = np.interp(lv, lo[:, 0], lo[:, 1])
            se = 1.0 / np.sqrt(2.0 * max(n_eff[gi], 1))
            w = 1.0 / (1.0 + (se / sigma) ** 2)
            alpha_shrunk[gi] = np.exp(w * np.log(alpha[gi]) + (1 - w) * trend)
    alpha_shrunk = np.clip(alpha_shrunk, 1e-4, 1.0)

    # ---- Wald test per contrast ----
    gidx = np.zeros(X.shape[0], dtype=int); gidx[mask[1]] = 1; gidx[mask[2]] = 2
    lfc = np.zeros((3, n)); pval = np.ones((3, n))
    for gi in range(n):
        mu = np.maximum(ybar[gi], 1e-6)          # per-group means, shape (3,)
        if mu.sum() <= 0:
            continue
        a = alpha_shrunk[gi]
        w_g = mu / (1.0 + a * mu)                # (dmu/deta)^2 / Var = mu/(1+alpha*mu)
        w = w_g[gidx]                            # per-sample weights, shape (90,)
        I = X.T @ (w[:, None] * X)
        cov = np.linalg.pinv(I)
        beta = np.array([np.log(mu[0]), np.log(mu[1]) - np.log(mu[0]), np.log(mu[2]) - np.log(mu[0])])
        contrasts = [(beta[2], cov[2, 2]),          # final vs baseline
                     (beta[1], cov[1, 1]),          # dentate vs baseline
                     (beta[1] - beta[2], cov[1, 1] + cov[2, 2] - 2 * cov[1, 2])]
        for cidx, (coef, var) in enumerate(contrasts):
            if var > 0 and np.isfinite(var):
                z = coef / np.sqrt(var)
                lfc[cidx, gi] = coef
                pval[cidx, gi] = 2 * norm.sf(abs(z))
    return sf, baseMean, alpha, alpha_shrunk, lfc, pval

def bh(p):
    p = np.asarray(p, float); n = len(p)
    order = np.argsort(p); ranked = p[order]
    adj = np.minimum.accumulate((ranked * n / np.arange(1, n + 1))[::-1])[::-1]
    out = np.empty(n); out[order] = np.clip(adj, 0, 1)
    return out

# ----------------------------------------------------------------------
def main():
    t0 = time.time()
    genes, samples, K = load_counts()
    print(f"Loaded matrix: {K.shape[0]} genes x {K.shape[1]} samples (rounded int proxy counts)")
    def tissue_of(name):
        if "baseline_blood" in name: return "baseline_blood"
        if "dentate_gyrus" in name:  return "dentate_gyrus"
        return "final_blood"
    tissues = [tissue_of(s) for s in samples]
    from collections import Counter
    print("Tissue counts:", dict(Counter(tissues)))
    mask = {0: np.array([t == "baseline_blood" for t in tissues]),
            1: np.array([t == "dentate_gyrus" for t in tissues]),
            2: np.array([t == "final_blood" for t in tissues])}
    X = np.ones((len(samples), 3))
    X[:, 1] = mask[1]; X[:, 2] = mask[2]

    sf, baseMean, alpha, alpha_shrunk, lfc, pval = deseq2(K, X, mask)
    print(f"  size factors: min={sf.min():.4f} max={sf.max():.4f}")
    print(f"  dispersion (raw / shrunk): median={np.median(alpha):.5f} / {np.median(alpha_shrunk):.5f}")

    names = ["final_vs_baseline", "dentate_vs_baseline", "dentate_vs_final"]
    res, de_sets = {}, {}
    for c, key in enumerate(names):
        padj = bh(pval[c])
        de = padj < PADJ_CUT
        de_sets[key] = set(genes[i] for i in range(len(genes)) if de[i])
        res[key] = int(de.sum())
        print(f"  {key:20s}: DE(padj<{PADJ_CUT}) = {int(de.sum()):5d}   (padj<0.05 = {int((padj<0.05).sum())})")

    def summarize(cut, lfcmin):
        sets = {}
        for c, key in enumerate(names):
            padj = bh(pval[c]); de = padj < cut
            if lfcmin is not None:
                de = de & (np.abs(lfc[c]) > lfcmin)
            sets[key] = set(genes[i] for i in range(len(genes)) if de[i])
        u = set().union(*sets.values()); inter = set.intersection(*sets.values())
        return {k: len(v) for k, v in sets.items()}, len(u), len(inter), sum(len(v) for v in sets.values()), u

    res, union, inter, sumc, u = summarize(PADJ_CUT, None)
    print("\n================ SUMMARY (APPROVED: padj<0.1, no logFC filter) ================")
    for k, v in res.items():
        print(f"  {k:20s}: {v}")
    print(f"  {'SUM (per-comp total)':20s}: {sumc}")
    print(f"  {'UNION (>=1 comp)':20s}: {union}   <-- HEADLINE ANSWER")
    print(f"  {'INTERSECTION (all 3)':20s}: {inter}")

    # sensitivity: the workbook's EMBEDDED DESeq2 used padj<0.05 & |log2FC|>0.58
    res2, union2, inter2, sumc2, u2 = summarize(0.05, 0.58)
    print("\n--- SENSITIVITY (embedded/author criteria: padj<0.05, |log2FC|>0.58, same tissue design) ---")
    for k, v in res2.items():
        print(f"  {k:20s}: {v}")
    print(f"  {'SUM':20s}: {sumc2}   {'UNION':20s}: {union2}   {'INTERSECTION':>6s}: {inter2}")
    print(f"  runtime: {time.time()-t0:.1f}s")

    out = {"n_genes": int(K.shape[0]), "n_samples": int(K.shape[1]),
           "tissue_counts": dict(Counter(tissues)),
           "method": "DESeq2 re-implementation (median-ratio size factors, NB moment dispersion + LOESS shrinkage, NB-GLM Wald test, BH FDR) on rounded NormCount integer proxy counts, design ~ tissue",
           "APPROVED_criteria": {"padj_cutoff": PADJ_CUT, "lfc_filter": None,
                                  "per_comparison_DE": res, "sum": sumc,
                                  "union": union, "intersection": inter,
                                  "headline_union": union, "union_genes": sorted(u)},
           "EMBEDDED_criteria_sensitivity": {"padj_cutoff": 0.05, "lfc_filter": 0.58,
                                  "per_comparison_DE": res2, "sum": sumc2,
                                  "union": union2, "intersection": inter2}}
    with open("deseq2_results.json", "w") as f:
        json.dump(out, f)
    print("Wrote deseq2_results.json")

if __name__ == "__main__":
    main()
