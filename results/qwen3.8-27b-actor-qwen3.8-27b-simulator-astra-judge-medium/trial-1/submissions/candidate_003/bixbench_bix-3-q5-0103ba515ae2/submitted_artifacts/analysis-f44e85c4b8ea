#!/usr/bin/env python3
"""
BixBench bix-3-q5: which tissue comparison shows negligible effects?
3 comparisons: Final vs Baseline Blood, Dentate gyrus vs Baseline, Dentate gyrus vs Final.
Method: (1) map the 9 pre-computed DESeq comparisons in the file; (2) compute the 3
tissue comparisons from the normalized (CPM) counts; (3) binomial exact test on up/down DEGs.
"""
import openpyxl, numpy as np
from scipy import stats
from scipy.stats import binomtest
from collections import defaultdict
from itertools import permutations

XLSX="data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
wb = openpyxl.load_workbook(XLSX, read_only=True)
ms = list(wb["Mapping_statistics"].iter_rows(values_only=True))
mhdr, mrows = ms[0], ms[1:]
ws = wb["NormCount"]
rows = list(ws.iter_rows(min_row=4, values_only=True))
hdr=rows[0]; data=rows[1:]
N=len(data); names=[hdr[2+j] for j in range(90)]
cpm=np.zeros((N,90))
for i,r in enumerate(data):
    for j in range(90): cpm[i,j]=float(r[2+j])
wb.close()
def parse(nm):
    b=nm.rstrip('0123456789'); t=[x for x in ['baseline_blood','dentate_gyrus','final_blood'] if b.endswith('_'+x)][0]
    return b[:-(len(t)+1)], t
def resp(nm): return parse(nm)[0]
def tis(nm): return parse(nm)[1]
def subj(nm): return nm  # subject via code->sid below
code2subj={r[8]:r[1].split('_') for r in mrows}
def subjid(nm): return code2subj[nm][5]

print("="*70)
print("STEP 1: map the 9 pre-computed DESeq comparisons (log2FC correlation)")
print("="*70)
tissues=['baseline_blood','dentate_gyrus','final_blood']
subs=defaultdict(list)
for j,nm in enumerate(names): subs[(resp(nm),tis(nm))].append(j)
keys=sorted(subs)
lg=np.zeros((N,9))
for si,k in enumerate(keys): lg[:,si]=np.mean(np.log2(cpm[:,subs[k]]+1.0),1)
def lfcarr(k):
    s=98+(k-1)*9; o=np.empty(N)
    for i,r in enumerate(data):
        v=r[s+4]; o[i]=np.nan if (v is None or v in('NA','-')) else (np.inf if v in('=Inf','Inf') else (-np.inf if v in('=-Inf','-Inf') else float(v)))
    return o
def deg(k): return np.array([r[98+(k-1)*9+8] for r in data])
def sh(k): return f"{k[0][:2]}/{k[1][:3]}"
print(f"{'Comp':5}{'A (resp/tissue)':22}{'B (resp/tissue)':22}{'corr':>7}  verify(U^/D v)")
mapping={}
for k in range(1,10):
    T=lfcarr(k); fin=np.isfinite(T); best=None
    for a,b in permutations(range(9),2):
        c=np.corrcoef(T[fin],(lg[:,a]-lg[:,b])[fin])[0,1]
        if best is None or c>best[0]: best=(c,a,b)
    c,a,b=best; mapping[k]=(keys[a],keys[b])
    # verify direction using CPM means
    A=np.mean(cpm[:,subs[keys[a]]],1); B=np.mean(cpm[:,subs[keys[b]]],1); d=A-B
    U=deg(k)=='U'; D=deg(k)=='D'
    uf=np.nanmean(d[U]>0) if U.sum() else np.nan; df=np.nanmean(d[D]<0) if D.sum() else np.nan
    print(f"{k:<5}{sh(keys[a]):22}{sh(keys[b]):22}{c:7.3f}  U^={uf:.2f} Dv={df:.2f}")
print("=> The 9 file comparisons are RESPONSE-GROUP comparisons WITHIN each tissue")
print("   (3 tissues x {good-vs-Control, bad-vs-Control, good-vs-bad}).")
print("   => The 3 TISSUE comparisons asked in the question are NOT present in the file.")

print("\n"+"="*70)
print("STEP 2: compute the 3 tissue comparisons from CPM counts (30 vs 30, all responses pooled)")
print("="*70)
cols=defaultdict(list)
for j,nm in enumerate(names): cols[tis(nm)].append(j)
base=cols['baseline_blood']; dent=cols['dentate_gyrus']; fin=cols['final_blood']
print("samples/tissue:", {k:len(v) for k,v in cols.items()},
      "| paired subjects common:", len({subjid(names[c]) for c in base}&{subjid(names[c]) for c in dent}&{subjid(names[c]) for c in fin}))
def bh(p):
    p=np.where(np.isnan(p),1.0,p); n=len(p); o=np.argsort(p); rp=p[o]
    q=rp*(n/np.arange(1,n+1)); q=np.minimum.accumulate(q[::-1])[::-1]
    out=np.empty(n); out[o]=np.clip(q,0,1); return out
def indeps():
    d={}
    for lab,(A,B) in {"Final vs Baseline Blood":(fin,base),"Dentate gyrus vs Baseline":(dent,base),"Dentate gyrus vs Final":(dent,fin)}.items():
        lA=np.log2(cpm[:,A]+1.0); lB=np.log2(cpm[:,B]+1.0)
        d[lab]=(np.mean(lA,1)-np.mean(lB,1), bh(stats.ttest_ind(lA,lB,1,equal_var=False)[1]))
    return d
def paireds():
    def sm(o): m={subjid(names[c]):c for c in o}; s=sorted(m); return np.log2(cpm[:,[m[x] for x in s]]+1.0)
    LB,LD,LF=sm(base),sm(dent),sm(fin); d={}
    for lab,(A,B) in {"Final vs Baseline Blood":(LF,LB),"Dentate gyrus vs Baseline":(LD,LB),"Dentate gyrus vs Final":(LD,LF)}.items():
        d[lab]=(np.mean(A,1)-np.mean(B,1), bh(stats.ttest_rel(A,B,axis=1)[1]))
    return d
def binom(p_up,dn): return float('nan') if p_up+dn==0 else binomtest(p_up,p_up+dn,0.5,'two-sided').pvalue
TH=[("padj<0.05",lambda p,l:p<0.05),
    ("padj<0.05 & |log2FC|>=1 (2x)",lambda p,l:(p<0.05)&(np.abs(l)>=1)),
    ("padj<0.05 & |log2FC|>=2 (4x)",lambda p,l:(p<0.05)&(np.abs(l)>=2))]
for title,D in [("INDEPENDENT (Welch t-test, log2(CPM+1), BH-FDR)",indeps()),
                ("PAIRED (within-subject t-test, BH-FDR)",paireds())]:
    print(f"\n--- {title} ---")
    print(f"{'comparison':26}{'rule':30}{'n_up':>6}{'n_dn':>6}{'n':>6}{'binom_p':>11}  call@0.05")
    for lab,(lfc,padj) in D.items():
        for tag,cond in TH:
            g=cond(padj,lfc); up=int((g&(lfc>0)).sum()); dn=int((g&(lfc<0)).sum()); p=binom(up,dn)
            print(f"{lab:26}{tag:30}{up:6d}{dn:6d}{up+dn:6d}{p:11.3g}  {'NEGLIGIBLE (balanced, NS)' if p>=0.05 else 'significant (skewed)'}")

print("\n"+"="*70)
print("STEP 3: operational definition + conclusion")
print("="*70)
print("NEGLIGIBLE := the comparison whose up/down DEG balance does NOT reject")
print("H0(p_up=0.5) in a two-sided exact binomial test at alpha=0.05 (no directional bias).")
print("Across every DE threshold and both (independent/paired) models, 'Final vs Baseline")
print("Blood' has the FEWEST DEGs and the MOST balanced up/down (closest to 50/50, highest")
print("binomial p); it is the ONLY comparison that reaches a non-significant (balanced)")
print("binomial test (|log2FC|>=2: 16 up vs 24 down, p=0.268). Both dentate-gyrus-vs-blood")
print("comparisons are dominated by tissue-identity differences (thousands of DEGs, ~56-58%")
print("up, p<=2e-49).")
print("\nANSWER: Final vs Baseline Blood shows negligible effects.")
