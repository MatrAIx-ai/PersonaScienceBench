#!/usr/bin/env python3
"""
BixBench bix-30-q1
Question: "What percentage of miRNAs show significant differential expression
between patient and control groups before multiple testing correction?"

Self-contained: reads the legacy .xls (OLE2/BIFF8) with an embedded parser
(no xlrd / libreoffice / network needed), then for every miRNA compares the
patient group vs the control group on the RAW Ct values using a two-sided
Welch t-test (primary). Significance = uncorrected p < 0.05. Missing values
(the string "NAN") are handled by pairwise deletion; denominator = all miRNAs.

Outputs: primary percentage + a short sensitivity line (Student t-test,
Wilcoxon/Mann-Whitney). If scipy is unavailable, p-values are computed with a
manual regularized-incomplete-beta t-distribution CDF (marked as FALLBACK).
"""
import os, sys, struct, math, collections

# ----------------------------------------------------------------------------
# 1) Minimal OLE2 (Compound File) + BIFF8 reader (stdlib only)
# ----------------------------------------------------------------------------
def _read_ole2(path):
    d = open(path, 'rb').read()
    assert d[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1', "not an OLE2 file"
    ssz = 1 << struct.unpack_from('<H', d, 0x1E)[0]
    first_dir = struct.unpack_from('<i', d, 0x30)[0]
    first_difat = struct.unpack_from('<i', d, 0x44)[0]
    num_difat  = struct.unpack_from('<I', d, 0x48)[0]
    difat = list(struct.unpack_from('<109i', d, 0x4C))
    sec = first_difat
    for _ in range(num_difat):
        if sec < 0: break
        off = ssz + sec*ssz
        chunk = struct.unpack_from('<128i', d, off)
        difat.extend(chunk[:127]); sec = chunk[127]
    fat = []
    for f in difat:
        if f < 0: continue
        off = ssz + f*ssz
        fat.extend(struct.unpack_from('<%dI' % (ssz//4), d, off))
    def chain(start):
        out=[]; s=start; seen=set()
        while 0 <= s < len(fat) and s not in seen:
            out.append(s); seen.add(s); s = fat[s]
        return out
    def read_stream(start, size):
        out=bytearray()
        for s in chain(start):
            out += d[ssz+s*ssz: ssz+(s+1)*ssz]
        return bytes(out[:size]) if size else bytes(out)
    dir_data = read_stream(first_dir, 0)
    entries=[]
    for i in range(len(dir_data)//128):
        e = dir_data[i*128:(i+1)*128]
        if len(e) < 128: break
        nlen = struct.unpack_from('<H', e, 0x40)[0]
        name = e[:max(0,nlen-2)].decode('utf-16-le','replace') if nlen>0 else ''
        otype = e[0x42]
        left  = struct.unpack_from('<i', e, 0x44)[0]
        right = struct.unpack_from('<i', e, 0x48)[0]
        child = struct.unpack_from('<i', e, 0x4C)[0]
        start = struct.unpack_from('<i', e, 0x74)[0]
        size  = struct.unpack_from('<Q', e, 0x78)[0]
        entries.append(dict(name=name,type=otype,left=left,right=right,
                            child=child,start=start,size=size))
    streams={}
    def walk(idx):
        if idx < 0 or idx >= len(entries): return
        e = entries[idx]
        if e['type']==2: streams[e['name']] = (e['start'], e['size'])
        walk(e['left']); walk(e['right'])
        if e['child'] >= 0: walk(e['child'])
    walk(entries[0]['child'])
    return streams, read_stream

def _get_stream(path, name):
    streams, read_stream = _read_ole2(path)
    if name not in streams:
        for k in streams:
            if k.lower()==name.lower(): name=k; break
    start,size = streams[name]
    return read_stream(start,size)

def _rk(rk):
    rk &= 0xFFFFFFFF
    if rk & 1:
        v = rk >> 2
        if v >= (1<<29): v -= (1<<30)
        return v/100.0 if (rk & 2) else float(v)
    u = rk & 0xFFFFFFFC
    val = struct.unpack('<d', struct.pack('<I', u)+b'\x00\x00\x00\x00')[0]
    return val/100.0 if (rk & 2) else val

def _read_sst(data):
    total = struct.unpack_from('<I', data, 0)[0]
    unique = struct.unpack_from('<I', data, 4)[0]
    off = 8; strings=[]
    for _ in range(unique):
        if off+3 > len(data): break
        cch = struct.unpack_from('<H', data, off)[0]; off+=2
        flags = data[off]; off+=1
        rt=(flags & 0x08)!=0; ext=(flags & 0x04)!=0; comp=(flags & 0x01)==0
        crun=0
        if rt: crun=struct.unpack_from('<H', data, off)[0]; off+=2
        sz=0
        if ext: sz=struct.unpack_from('<I', data, off)[0]; off+=4
        nbytes = cch if comp else cch*2
        raw = data[off:off+nbytes]; off += nbytes
        s = raw.decode('latin1' if comp else 'utf-16-le','replace')
        if rt: off += 4*crun
        if ext: off += sz
        strings.append(s)
    return strings

def _parse_biff(wb):
    pos=0; n=len(wb); recs=[]
    while pos+4 <= n:
        t,ln = struct.unpack_from('<HH', wb, pos)
        recs.append((pos,t,wb[pos+4:pos+4+ln])); pos += 4+ln
    sst=[]
    for p,t,b in recs:
        if t==0x00FC: sst=_read_sst(b); break
    bounds=[]
    for p,t,b in recs:
        if t==0x0085:
            bofpos = struct.unpack_from('<I', b, 0)[0]
            stype  = b[5]
            nlen   = b[6]
            nm = b[7:7+nlen*2].decode('utf-16-le','replace') if (nlen & 0x80) else b[7:7+nlen].decode('latin1','replace')
            bounds.append((nm, bofpos, stype))
    bof2idx = {bp:i for i,(_,bp,_) in enumerate(bounds)}
    sheets = {i:{} for i in range(len(bounds))}
    cur=None
    for p,t,b in recs:
        if t==0x0809:
            cur = bof2idx.get(p, None); continue
        if cur is None or len(b) < 4: continue
        row = struct.unpack_from('<H', b, 0)[0]
        col = struct.unpack_from('<H', b, 2)[0]
        if t==0x00FD:
            idx = struct.unpack_from('<I', b, 6)[0]
            sheets[cur][(row,col)] = sst[idx] if idx < len(sst) else ''
        elif t==0x0203:
            sheets[cur][(row,col)] = struct.unpack_from('<d', b, 6)[0]
        elif t==0x027E:
            sheets[cur][(row,col)] = _rk(struct.unpack_from('<I', b, 6)[0])
        elif t==0x00BD:
            cfirst=struct.unpack_from('<H', b, 4)[0]; clast=struct.unpack_from('<H', b, 6)[0]
            off=8
            for c in range(cfirst, clast+1):
                sheets[cur][(row,c)] = _rk(struct.unpack_from('<I', b, off+2)[0]); off+=6
        elif t==0x0006:
            sheets[cur][(row,col)] = struct.unpack_from('<d', b, 6)[0]
    return bounds, sheets

def load_grid(path):
    wb = _get_stream(path, 'Workbook')
    bounds, sheets = _parse_biff(wb)
    grid = collections.defaultdict(dict)
    for (r,c),v in sheets[0].items(): grid[r][c]=v
    return bounds, grid

# ----------------------------------------------------------------------------
# 2) Statistics (scipy if available, else manual t-CDF fallback)
# ----------------------------------------------------------------------------
try:
    from scipy import stats as _sp
    HAVE_SCIPY = True
    PVAL_SRC = "scipy.stats"
except Exception:
    HAVE_SCIPY = False
    PVAL_SRC = "FALLBACK: manual regularized-incomplete-beta t-distribution CDF"

def _betacf(a,b,x):
    MAXIT=1000; EPS=3e-12; FPMIN=1e-300
    qab=a+b; qap=a+1; qam=a-1
    c=1.0; d=1.0-qab*x/qap
    if abs(d)<FPMIN: d=FPMIN
    d=1.0/d; h=d
    for m in range(1,MAXIT+1):
        m2=2*m
        aa=m*(b-m)*x/((qam+m2)*(a+m2))
        d=1.0+aa*d
        if abs(d)<FPMIN: d=FPMIN
        c=1.0+aa/c
        if abs(c)<FPMIN: c=FPMIN
        d=1.0/d; h*=d*c
        aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2))
        d=1.0+aa*d
        if abs(d)<FPMIN: d=FPMIN
        c=1.0+aa/c
        if abs(c)<FPMIN: c=FPMIN
        d=1.0/d; delt=d*c; h*=delt
        if abs(delt-1.0)<EPS: break
    return h

def _betai(a,b,x):
    if x <= 0: return 0.0
    if x >= 1: return 1.0
    lnbt = (math.lgamma(a+b)-math.lgamma(a)-math.lgamma(b)
            + a*math.log(x) + b*math.log(1-x))
    bt = math.exp(lnbt)
    if x < (a+1)/(a+b+2):
        return bt*_betacf(a,b,x)/a
    return 1.0 - bt*_betacf(b,a,1-x)/b

def _t_two_sided_p(abs_t, df):
    if df <= 0: return float('nan')
    x = df/(df + abs_t*abs_t)
    return _betai(df/2.0, 0.5, x)

def welch_p(a, b):
    a=list(a); b=list(b); na=len(a); nb=len(b)
    if na < 2 or nb < 2: return float('nan')
    if HAVE_SCIPY:
        return float(_sp.ttest_ind(a, b, equal_var=False).pvalue)
    ma=sum(a)/na; mb=sum(b)/nb
    va=sum((x-ma)**2 for x in a)/(na-1); vb=sum((x-mb)**2 for x in b)/(nb-1)
    se2 = va/na + vb/nb
    if se2 <= 0: return 1.0
    t = (ma-mb)/math.sqrt(se2)
    df = se2*se2 / ((va/na)**2/(na-1) + (vb/nb)**2/(nb-1))
    return _t_two_sided_p(abs(t), df)

def student_p(a, b):
    a=list(a); b=list(b); na=len(a); nb=len(b)
    if na < 2 or nb < 2: return float('nan')
    if HAVE_SCIPY:
        return float(_sp.ttest_ind(a, b, equal_var=True).pvalue)
    ma=sum(a)/na; mb=sum(b)/nb
    sp2 = (sum((x-ma)**2 for x in a) + sum((x-mb)**2 for x in b))/(na+nb-2)
    if sp2 <= 0: return 1.0
    t = (ma-mb)/math.sqrt(sp2*(1/na+1/nb))
    return _t_two_sided_p(abs(t), na+nb-2)

def _rankdata(x):
    idx=sorted(range(len(x)), key=lambda i: x[i]); ranks=[0.0]*len(x); i=0
    while i < len(x):
        j=i
        while j+1 < len(x) and x[idx[j+1]]==x[idx[i]]: j+=1
        avg=(i+j)/2.0 + 1.0
        for k in range(i,j+1): ranks[idx[k]]=avg
        i=j+1
    return ranks

def wilcoxon_p(a, b):
    a=list(a); b=list(b); na=len(a); nb=len(b)
    if na < 1 or nb < 1: return float('nan')
    if HAVE_SCIPY:
        try:
            return float(_sp.mannwhitneyu(a, b, alternative='two-sided').pvalue)
        except Exception:
            pass
    comb=a+b; n=na+nb
    r=_rankdata(comb); R1=sum(r[:na])
    U1 = R1 - na*(na+1)/2.0
    U2 = na*nb - U1
    U = min(U1, U2)
    vals=comb; cnts=collections.Counter(vals); T=sum(c**3-c for c in cnts.values())
    mu = na*nb/2.0
    sigma = math.sqrt(na*nb*(n+1)/12.0 - na*nb*T/(12.0*n*(n-1)))
    if sigma <= 0: return 1.0
    z = (U - mu + 0.5)/sigma
    p = 2.0*(0.5*math.erfc(abs(z)/math.sqrt(2.0)))
    return min(1.0, p)

# ----------------------------------------------------------------------------
# 3) Main analysis
# ----------------------------------------------------------------------------
def main():
    path = sys.argv[1] if len(sys.argv) > 1 else None
    if path is None:
        here = os.path.dirname(os.path.abspath(__file__))
        cands = ["data/pone.0150501.s002.xls",
                 os.path.join(here, "..", "data", "pone.0150501.s002.xls")]
        for c in cands:
            if os.path.exists(c): path=c; break
    if path is None or not os.path.exists(path):
        print("ERROR: input file not found", file=sys.stderr); sys.exit(1)

    bounds, grid = load_grid(path)
    rows = sorted(grid.keys())
    sheet_name = bounds[0][0].lstrip('\x00') if bounds else "RAW DATA"

    # Header row = the row whose cells contain the sample names P_*/C_*
    hdr_row = None
    for r in rows:
        vals = [grid[r].get(c) for c in range(0, 40)]
        if any(isinstance(v, str) and v.strip().startswith(('P_','C_')) for v in vals):
            hdr_row = r; break

    pat_cols=[]; ctl_cols=[]
    for c in range(0, 40):
        v = grid[hdr_row].get(c)
        if isinstance(v, str):
            vs=v.strip()
            if vs.startswith('P_'): pat_cols.append(c)
            elif vs.startswith('C_'): ctl_cols.append(c)
    pat_cols.sort(); ctl_cols.sort()

    def num(v):
        return float(v) if isinstance(v,(int,float)) and not isinstance(v,bool) else None

    data_rows = [r for r in rows if r > hdr_row and isinstance(grid[r].get(0), str)
                 and grid[r].get(0,'').startswith('hsa-')]

    total = len(data_rows)
    n_missing_cells = 0
    welch_sig = student_sig = wilc_sig = 0
    n_untestable = 0
    for r in data_rows:
        p = [num(grid[r].get(c)) for c in pat_cols]
        c = [num(grid[r].get(c)) for c in ctl_cols]
        n_missing_cells += (len(pat_cols)-sum(x is not None for x in p)) \
                         + (len(ctl_cols)-sum(x is not None for x in c))
        p = [x for x in p if x is not None]
        c = [x for x in c if x is not None]
        pw = welch_p(p, c)
        if math.isnan(pw):
            n_untestable += 1
            continue
        ps = student_p(p, c)
        wu = wilcoxon_p(p, c)
        if pw < 0.05: welch_sig += 1
        if (not math.isnan(ps)) and ps < 0.05: student_sig += 1
        if (not math.isnan(wu)) and wu < 0.05: wilc_sig += 1

    pct_welch   = welch_sig/total*100
    pct_student = student_sig/total*100
    pct_wilc    = wilc_sig/total*100

    print("="*70)
    print("miRNA differential expression: patient vs control (RAW Ct)")
    print("="*70)
    print(f"Input file                : {path}")
    print(f"Sheet                     : {sheet_name!r}")
    print(f"p-value source            : {PVAL_SRC}")
    print(f"Patient samples (n={len(pat_cols)}): {[grid[hdr_row][c] for c in pat_cols]}")
    print(f"Control samples (n={len(ctl_cols)}): {[grid[hdr_row][c] for c in ctl_cols]}")
    print(f"Total miRNAs (denominator): {total}")
    print(f"Missing 'NAN' cells       : {n_missing_cells}  (handled by pairwise deletion)")
    print(f"miRNAs untestable (n<2)   : {n_untestable}")
    print("-"*70)
    print("PRIMARY  Welch two-sided t-test, uncorrected p<0.05:")
    print(f"   significant = {welch_sig} / {total}  ->  {pct_welch:.2f}%")
    print("-"*70)
    print("Sensitivity (same threshold p<0.05, uncorrected):")
    print(f"   Student two-sided t-test : {student_sig}/{total}  -> {pct_student:.2f}%")
    print(f"   Wilcoxon / Mann-Whitney  : {wilc_sig}/{total}  -> {pct_wilc:.2f}%")
    print("-"*70)
    print(f"ANSWER: {pct_welch:.2f}%  ({welch_sig}/{total} miRNAs, Welch two-sided "
          f"t-test on raw Ct, uncorrected p<0.05; "
          f"sensitivity Student {pct_student:.1f}%, Wilcoxon {pct_wilc:.1f}%)")

if __name__ == "__main__":
    main()
