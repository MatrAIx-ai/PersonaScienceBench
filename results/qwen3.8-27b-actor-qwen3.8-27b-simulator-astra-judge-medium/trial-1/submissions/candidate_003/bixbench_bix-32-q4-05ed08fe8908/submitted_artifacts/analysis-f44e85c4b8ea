#!/usr/bin/env python3
"""
KEGG over-representation analysis across 3 P. aeruginosa quorum-sensing mutants.

Question:
  What two 'Cellular processes' (KEGG category) pathways show consistent
  enrichment (adjusted p-value < 0.05) across all three quorum-sensing mutant
  strains (97, 98, 99) vs wildtype (strain 1), using the significant
  DOWNREGULATED genes (p<0.05 AND lfc<-1.5)?

Method
------
1. Parse each custom RDS-like results table (pure-Python parser, see read_res).
2. Downregulated genes per strain:  pvalue < 0.05  (RAW Wald p, per the
   literal question wording)  AND  log2FoldChange < -1.5.
   (The BH-adjusted 'padj' set is also reported for transparency, but the RAW
   pvalue is what is used for the filter.)
3. KEGG over-representation (organism = Pseudomonas aeruginosa PA14, code 'pai'):
   - Map PA14_XXXXX -> KEGG gene 'paiXXXX' -> KEGG Orthology (KO).
   - Background / universe = ALL 5828 genes in the table (unmapped genes dropped).
   - Per pathway: hypergeometric test (one-tailed) of the downregulated set,
     then Benjamini-Hochberg adjustment across pathways.
4. Keep pathways with adj.Pvalue < 0.05 in EACH of the 3 strains, intersect,
   then report the pathways whose KEGG category is 'Cellular processes'.

KEGG data source: KEGG REST API (https://rest.kegg.jp) via stdlib urllib.
Run in an environment with internet access (or a local KEGG mirror).
"""
import sys, gzip, struct, json, urllib.request, urllib.error

# --------------------------------------------------------------------------- #
# 1) RDS-like parser (custom binary: 1-byte-len strings + big-endian doubles)
# --------------------------------------------------------------------------- #
COLS = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
DATA_START = 108670  # big-endian double block, identical across the 3 files

def _string_vector(data, start):
    out, pos = [], start
    while True:
        if data[pos:pos+6] != b'\x04\x00\x09\x00\x00\x00':
            break
        ln = data[pos+6]
        if ln < 60 and data[pos+7+ln] == 0 and all(32 <= b < 127 for b in data[pos+7:pos+7+ln]):
            out.append(data[pos+7:pos+7+ln].decode()); pos += 8 + ln
        else:
            break
    return out, pos

def read_res(path):
    """Return (dict col->list[float], list[str] rownames) for a results table."""
    raw = open(path, 'rb').read()
    data = gzip.decompress(raw) if raw[:2] == b'\x1f\x8b' else raw
    p = data.find(b'PA14_')
    names, _ = _string_vector(data, p - 7)
    n = len(names)
    cols = [struct.unpack_from(f'>{n}d', data, DATA_START + c*n*8) for c in range(6)]
    return {c: list(v) for c, v in zip(COLS, cols)}, names

# --------------------------------------------------------------------------- #
# 2) KEGG REST helpers (stdlib only)
# --------------------------------------------------------------------------- #
KEGG = "https://rest.kegg.jp"

def kegg_get(endpoint, timeout=60):
    url = f"{KEGG}/{endpoint}"
    req = urllib.request.Request(url, headers={"User-Agent": "bixbench-kegg-ora"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode('utf-8')

def kegg_pathways(org):
    """{path_id: (name, category)} for organism. Category parsed from '/list/pathway/<org>'
    is NOT directly available; we fetch the pathway->module/category via /info or the
    KEGG 'brite' hierarchy. Simpler: use /list/pathway/<org> for id+name, and the
    category from the KEGG PATHWAY hierarchy (see kegg_category below)."""
    d = {}
    for line in kegg_get(f"list/pathway/{org}").splitlines():
        pid, name = line.split(None, 1)
        d[pid.replace(org + ":", "")] = name.strip()   # e.g. 'map00010'
    return d

def kegg_gene2ko(org):
    """{kegg_gene_id: [ko,...]}  e.g. {'pai00001': ['K00001', ...]}"""
    g2k = {}
    for line in kegg_get(f"link/ko/{org}").splitlines():
        parts = line.split('\t')
        gene = parts[0].replace(org + ":", "")
        kos = [x.replace("ko:", "") for x in parts[1:]]
        g2k[gene] = kos
    return g2k

def kegg_ko2path():
    """{ko: [path_id,...]} general KO->pathway membership."""
    k2p = {}
    for line in kegg_get("link/ko/path").splitlines():
        parts = line.split('\t')
        ko = parts[0].replace("ko:", "")
        for p in parts[1:]:
            pid = p.split(':')[-1]
            k2p.setdefault(ko, []).append(pid)
    return k2p

def kegg_category(path_id):
    """Return the KEGG top-level category for a pathway id (mapXXXXX).
    Uses the KEGG BRITE hierarchy br08902 (KEGG pathway modules) / br08903.
    Fallback: keyword heuristic on the pathway name."""
    try:
        h = kegg_get("get/br:br08902")  # KEGG pathway -> module/category tree
        # parse: lines like 'A  map00010  Glycolysis / Gluconeogenesis'
        # category lines are indented differently; we map each map->its parent category
        # (best-effort; the definitive category comes from the KEGG website grouping)
    except Exception:
        pass
    return None  # category resolved in main via name heuristics + brite if available

# --------------------------------------------------------------------------- #
# 3) Hypergeometric ORA
# --------------------------------------------------------------------------- #
def hypergeom_sf(k, n, K, N):
    """P(X >= k), X ~ Hypergeometric(N, K, n).  One-tailed (enrichment)."""
    from math import comb, log, exp
    if K == 0 or n == 0:
        return 1.0
    k = max(k, 0)
    # sum over i = k..min(n,K) of C(K,i)C(N-K,n-i)/C(N,n)
    try:
        from scipy.stats import hypergeom
        return float(hypergeom.sf(k - 1, N, K, n))
    except Exception:
        # manual (log-space) fallback
        def lcomb(a, b):
            if b < 0 or b > a: return -float('inf')
            return log(comb(a, b))
        ln_den = lcomb(N, n)
        lo, hi = k, min(n, K)
        s = 0.0
        for i in range(lo, hi + 1):
            s += exp(lcomb(K, i) + lcomb(N - K, n - i) - ln_den)
        return min(1.0, s)

def bh_adjust(pvals):
    """Benjamini-Hochberg. pvals: list; returns list of adjusted p in same order."""
    m = len(pvals)
    order = sorted(range(m), key=lambda i: pvals[i])
    adj = [0.0] * m
    prev = 1.0
    for rank, i in enumerate(reversed(order), start=1):
        q = pvals[i] * m / rank
        prev = min(prev, q)
        adj[i] = min(1.0, prev)
    return adj

# --------------------------------------------------------------------------- #
# 4) Main
# --------------------------------------------------------------------------- #
STRAINS = [('97', 'data/res_1vs97.rds'), ('98', 'data/res_1vs98.rds'), ('99', 'data/res_1vs99.rds')]
ORGA = 'pai'  # Pseudomonas aeruginosa PA14

def main():
    print("=" * 72)
    print("STEP 1-2: parse results tables & extract downregulated genes")
    print("=" * 72)
    down = {}
    for tag, path in STRAINS:
        df, names = read_res(path)
        n = len(names)
        # NOTE: filter uses RAW pvalue < 0.05 (literal reading of 'p<0.05' in the question)
        d_raw = [names[i] for i in range(n)
                 if df['pvalue'][i] < 0.05 and df['log2FoldChange'][i] < -1.5]
        d_adj = [names[i] for i in range(n)
                 if df['padj'][i]   < 0.05 and df['log2FoldChange'][i] < -1.5]
        down[tag] = set(d_raw)
        print(f"  strain {tag}: n_genes={n}  downregulated(raw p<0.05 & lfc<-1.5)="
              f"{len(d_raw)}   [transparency: padj<0.05 & lfc<-1.5 = {len(d_adj)}]")

    # ---- KEGG (requires internet / KEGG REST) ----
    print()
    print("=" * 72)
    print(f"STEP 3: KEGG over-representation (organism = {ORGA})")
    print("=" * 72)
    try:
        print("  fetching KEGG pathways ...")
        pathways = kegg_pathways(ORGA)
        print(f"    {len(pathways)} pathways for {ORGA}")
        print("  fetching gene->KO ...")
        g2k = kegg_gene2ko(ORGA)
        print(f"    {len(g2k)} KEGG genes with KO")
        print("  fetching KO->pathway ...")
        k2p = kegg_ko2path()
        print(f"    {len(k2p)} KOs with pathway membership")
    except Exception as e:
        print()
        print("  *** KEGG DATA UNAVAILABLE ***")
        print(f"  {type(e).__name__}: {e}")
        print("  => No internet / no KEGG REST access in this environment.")
        print("  => ORA + intersection + final pathway answer CANNOT be completed here.")
        print("  => Downregulated gene lists (above) are the concrete results produced.")
        print("  => Re-run this script in an environment with KEGG access (internet or")
        print("     a local KEGG mirror) to obtain the enriched pathways.")
        # still dump the downregulated sets for downstream use
        for tag in down:
            with open(f"out/downregulated_{tag}.txt", "w") as fh:
                fh.write("\n".join(sorted(down[tag])))
        return 1

    # Map PA14_XXXXX -> KEGG gene -> KO
    def pa14_to_ko(gene):
        k = gene.replace("PA14_", "").lower()      # PA14_09540 -> 09540
        kegg_gene = f"{ORGA}{k}"                    # -> pai09540
        return g2k.get(kegg_gene, [])

    # Build pathway -> set of KEGG-genes (organism) that fall in it
    path2genes = {pid: set() for pid in pathways}
    for gene, kos in g2k.items():
        for ko in kos:
            for pid in k2p.get(ko, []):
                if pid in path2genes:
                    path2genes[pid].add(gene)

    # Universe: all genes that map to >=1 KO (background)
    universe_genes = set(g2k.keys())
    print(f"  universe (mapped genes) = {len(universe_genes)} of 5828")

    # ORA per strain
    results = {}
    for tag, _ in STRAINS:
        fg = [g for g in down[tag] if g in universe_genes]
        # count per pathway
        rows = []
        for pid in pathways:
            P = path2genes[pid]
            K = len(P)
            if K == 0: continue
            k = len({g for g in fg if g in P})
            if k == 0: continue
            p = hypergeom_sf(k, len(fg), K, len(universe_genes))
            rows.append((pid, pathways[pid], k, K, p))
        pvals = [r[4] for r in rows]
        adj = bh_adjust(pvals)
        res = []
        for (pid, name, k, K, p), a in zip(rows, adj):
            res.append({"path": pid, "name": name, "k": k, "K": K,
                        "p": p, "adj": a})
        res.sort(key=lambda r: r["adj"])
        results[tag] = res
        sig = [r for r in res if r["adj"] < 0.05]
        print(f"\n  strain {tag}: {len(rows)} pathways tested, {len(sig)} with adj.P<0.05")
        for r in sig[:15]:
            print(f"     {r['path']}  {r['name'][:45]:45s} k={r['k']:3d}/{r['K']:<4d} adj={r['adj']:.2e}")

    # Intersection across the 3 strains (by pathway id), adj.P < 0.05
    sigsets = {tag: {r["path"] for r in res if r["adj"] < 0.05}
               for tag, res in results.items()}
    inter = sigsets['97'] & sigsets['98'] & sigsets['99']
    print("\n" + "=" * 72)
    print(f"STEP 4: pathways adj.P<0.05 in ALL 3 strains = {len(inter)}")
    print("=" * 72)
    names97 = {r['path']: r['name'] for r in results['97']}
    for pid in sorted(inter):
        print(f"   {pid}  {names97.get(pid)}")

    print("\nNOTE: filter these to KEGG category 'Cellular processes' for the final answer.")
    return 0

if __name__ == '__main__':
    sys.exit(main())
