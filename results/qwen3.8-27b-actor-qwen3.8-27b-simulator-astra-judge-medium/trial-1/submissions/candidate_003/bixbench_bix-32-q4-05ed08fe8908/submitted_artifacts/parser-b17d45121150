"""Pure-Python parser for the custom DESeq2-results RDS-like files.
Layout (verified empirically):
  - gzip container; inner 'X' + version(10) header (24 bytes)
  - rownames: string vector, each element = [04 00 09 00 00 00][len:1B][bytes][00]
  - numeric data: 6 columns x n genes, BIG-ENDIAN IEEE-754 doubles, column-major
  - column names + class ('DESeqResults','data.frame') + package ('DESeq2') at tail
Columns: baseMean, log2FoldChange, lfcSE, stat, pvalue, padj
"""
import struct, gzip, math

def _read_string_vector(data, start):
    out, pos = [], start
    while True:
        if data[pos:pos+6] != b'\x04\x00\x09\x00\x00\x00':
            break
        ln = data[pos+6]
        if ln < 60 and data[pos+7+ln] == 0 and all(32 <= b < 127 for b in data[pos+7:pos+7+ln]):
            out.append(data[pos+7:pos+7+ln].decode()); pos += 8 + ln
        else:
            break
    return out, pos

DATA_START = 108670  # big-endian double block (identical across the 3 files)
COLS = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']

def read_res(path):
    raw = open(path, 'rb').read()
    data = gzip.decompress(raw) if raw[:2] == b'\x1f\x8b' else raw
    p = data.find(b'PA14_')
    names, _ = _read_string_vector(data, p - 7)
    n = len(names)
    cols = [struct.unpack_from(f'>{n}d', data, DATA_START + c*n*8) for c in range(6)]
    return {c: list(v) for c, v in zip(COLS, cols)}, names

if __name__ == '__main__':
    for f in ['data/res_1vs97.rds', 'data/res_1vs98.rds', 'data/res_1vs99.rds']:
        df, names = read_res(f)
        n = len(names)
        down = sum(1 for i in range(n) if df['pvalue'][i] < 0.05 and df['log2FoldChange'][i] < -1.5)
        print(f, 'n=', n, 'dup=', n-len(set(names)), 'down(p<.05,lfc<-1.5)=', down)
