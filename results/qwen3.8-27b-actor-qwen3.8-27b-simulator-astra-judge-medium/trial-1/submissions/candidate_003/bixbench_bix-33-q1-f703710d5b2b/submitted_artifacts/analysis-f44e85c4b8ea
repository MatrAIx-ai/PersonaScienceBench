"""
Answer: Which immune cell type has the highest number of significantly
differentially expressed genes after AAV9 mini-dystrophin treatment?

Primary source: Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx
Each sheet = one cell type; index = gene symbol; columns:
    p_val, avg_log2FC, pct.1, pct.2, p_val_adj

Significance criterion (per researcher): p_val_adj < 0.05 (FDR-adjusted).
Non-immune sheets (excluded from the "immune cell type" answer):
    Eryth (erythrocytes), HSPC (hematopoietic stem/progenitor), Platelet.
"""
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
ALPHA = 0.05
NON_IMMUNE = {"Eryth", "HSPC", "Platelet"}

xl = pd.ExcelFile(XLSX)
rows = []
for sheet in xl.sheet_names:
    df = xl.parse(sheet, index_col=0)          # index = gene symbol
    df = df.dropna(subset=[df.columns[0]])      # drop any accidental blank gene rows
    n_genes = len(df)
    n_sig = int((df["p_val_adj"] < ALPHA).sum())
    rows.append({
        "cell_type": sheet,
        "n_genes_listed": n_genes,
        "n_sig_DEG_padj<0.05": n_sig,
        "immune": sheet not in NON_IMMUNE,
    })

res = pd.DataFrame(rows)

print("=" * 70)
print("ALL CELL TYPES ranked by # significantly DE genes (p_val_adj < 0.05)")
print("=" * 70)
ranked_all = res.sort_values("n_sig_DEG_padj<0.05", ascending=False).reset_index(drop=True)
ranked_all.insert(0, "rank", ranked_all.index + 1)
print(ranked_all.to_string(index=False))

print("=" * 70)
print("IMMUNE CELL TYPES ONLY (excluded: %s)" % ", ".join(sorted(NON_IMMUNE)))
print("=" * 70)
immune = res[res["immune"]].copy()
ranked_immune = immune.sort_values("n_sig_DEG_padj<0.05", ascending=False).reset_index(drop=True)
ranked_immune.insert(0, "rank", ranked_immune.index + 1)
print(ranked_immune.to_string(index=False))

winner = ranked_immune.iloc[0]
print("=" * 70)
print("ANSWER: %s  ->  %d significantly DE genes (p_val_adj < 0.05)"
      % (winner["cell_type"], winner["n_sig_DEG_padj<0.05"]))
print("=" * 70)
