"""
ENO1 base protein level in normal samples — BixBench bix-37-q2
Reads proteomic data, extracts ENO1 'Normal' value, rounds to 3 significant figures.
"""
import pandas as pd
import sys

# 1) Load the proteomic data
xlsx = "data/Proteomic_data .xlsx"
sheet = "Tumor vs Normal"
df = pd.read_excel(xlsx, sheet_name=sheet)
print(f"Loaded {xlsx!r}, sheet {sheet!r}: {df.shape[0]} rows × {df.shape[1]} cols")

# 2) Filter by gene == 'ENO1'
mask_gene = df["gene"].astype(str).str.strip() == "ENO1"
mask_desc = df["Description"].astype(str).str.contains(r"GN=ENO1\b", na=False)

n_gene = mask_gene.sum()
n_desc = mask_desc.sum()
n_both = (mask_gene & mask_desc).sum()
print(f"gene=='ENO1': {n_gene} row(s);  Description contains GN=ENO1: {n_desc} row(s);  both: {n_both} row(s)")

if n_both != 1:
    print("ERROR: expected exactly 1 matching row, aborting.", file=sys.stderr)
    sys.exit(1)

row = df.loc[mask_gene & mask_desc].iloc[0]

# 3) Extract 'Normal' value
val = float(row["Normal"])
print(f"\nENO1  protein={row['protein']}  gene_id={row['gene_id']}")
print(f"Normal (raw) = {val}")

# Sanity checks
if pd.isna(val):
    print("ERROR: Normal value is NaN", file=sys.stderr)
    sys.exit(1)

# 4) Round to 3 significant figures
rounded = float(f"{val:.3g}")
print(f"Rounded to 3 sig figs = {rounded}")
print(f"  scientific notation: {rounded:.2e}")
print(f"  plain integer:       {int(rounded)}")

# 5) Final answer
print(f"\nANSWER: base protein level of ENO1 in normal samples = {rounded:.2e}  (i.e. {int(rounded)})")
print("Units: not specified in the file (proteomic quantification value, not pM/copies).")
