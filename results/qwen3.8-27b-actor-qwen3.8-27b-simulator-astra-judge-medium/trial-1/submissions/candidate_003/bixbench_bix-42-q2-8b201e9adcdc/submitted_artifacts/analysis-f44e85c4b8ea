"""
Skewness of the RNA expression distribution (COAD, TCGA).

Question: What is the skewness of the distribution of RNA expression data
(highly/minimally right or left skewed, or approximately normal)?

Method:
- Load data/COAD__geneExp.xls (tab-separated; 20502 genes x 328 samples).
- Primary: pooled skewness over ALL gene x sample values (raw, as supplied).
  Estimator: Fisher/Pearson moment coefficient g1 = m3 / m2^(3/2),
  scipy.stats.skew(bias=False) (bias-corrected sample estimator).
- Sensitivity: log2(x+1) transform.
- Robustness: per-sample skewness range.
"""
import numpy as np
import pandas as pd
from scipy import stats

FILE = "data/COAD__geneExp.xls"

# Load: tab-separated, first column is GeneSymbol, rest are TCGA sample barcodes.
df = pd.read_csv(FILE, sep="\t", index_col=0)
v = df.values.astype(float)

print("=== DATA ===")
print(f"matrix shape (genes x samples): {df.shape}")
print(f"total values: {v.size:,}")
print(f"min={v.min():.4f}  max={v.max():.2f}  mean={v.mean():.2f}  median={np.median(v):.2f}")
print(f"fraction exact zeros: {(v == 0).mean():.4f}")
print(f"fraction negative:    {(v < 0).mean():.4f}")
print()

# --- Primary: pooled raw skewness (Fisher g1, bias-corrected) ---
raw_skew = stats.skew(v.ravel(), bias=False)
print("=== PRIMARY (raw, as supplied) ===")
print(f"pooled Fisher skewness g1 (bias-corrected): {raw_skew:.3f}")
print(f"pooled Fisher skewness g1 (bias=True)      : {stats.skew(v.ravel(), bias=True):.3f}")
print()

# --- Sensitivity: log2(x+1) ---
log_skew = stats.skew(np.log2(v + 1).ravel(), bias=False)
print("=== SENSITIVITY (log2(x+1)) ===")
print(f"pooled skewness of log2(x+1): {log_skew:.3f}")
print()

# --- Robustness: per-sample skewness (each sample = distribution over genes) ---
per_sample = stats.skew(v, axis=0, bias=False)
print("=== ROBUSTNESS (per-sample) ===")
print(f"per-sample skew: min={per_sample.min():.2f}  median={np.median(per_sample):.2f}  max={per_sample.max():.2f}")
print(f"all per-sample skews positive (right-skewed): {bool((per_sample > 0).all())}")
print()

# --- Bucket mapping (rule of thumb) ---
def bucket(s):
    a = abs(s)
    if a < 0.5:
        mag = "approximately normal / symmetric"
    elif a < 1.0:
        mag = "minimally (slightly) skewed"
    else:
        mag = "highly skewed"
    side = "right" if s > 0 else "left"
    return f"{mag} ({side})" if a >= 0.5 else mag

print("=== CLASSIFICATION ===")
print(f"raw pooled skew {raw_skew:.3f} -> {bucket(raw_skew)}")
print(f"log2(x+1) skew  {log_skew:.3f} -> {bucket(log_skew)}")

print()
print("ANSWER: The RNA expression distribution is highly right-skewed "
      f"(Fisher skewness ~ {raw_skew:.1f} on raw values).")
