import numpy as np, pandas as pd
from scipy.optimize import minimize
from scipy.stats import norm
src = open('/workspace/analysis.py').read().replace('if __name__ == "__main__":', 'if False:')
g = {'__file__': '/workspace/analysis.py', '__name__': 'analysis_mod'}
exec(src, g)
nb_glm, bh, fgsea_es, fgsea_prerank, welch = g['nb_glm'], g['bh'], g['fgsea_es'], g['fgsea_prerank'], g['welch']

m = pd.DataFrame({
 'A':[100,110,95, 400,380,420],
 'B':[50,52,48, 51,49,53],
 'C':[8,9,7, 120,130,115],
 'D':[0,0,0,0,0,0],
}, index=['c1','c2','c3','t1','t2','t3']).T
b1,p,phi2,phi2_mom = nb_glm(m, ['t1','t2','t3'], ['c1','c2','c3'])
print('NB log2FC (expect A~2, B~0, C~4, D~log2(2/0.5)=2):', dict(zip(m.index, np.round(b1,3))))
print('NB p:', dict(zip(m.index, np.round(p,4)))); print('phi2 trend:', dict(zip(m.index, np.round(phi2,5)))); print('phi2 mom:', dict(zip(m.index, np.round(phi2_mom,5))))

# scipy cross-check for gene A (NB2: Var = mu + phi*mu^2), phi fixed at trend value
y = np.array([400.5,380.5,420.5,100.5,110.5,95.5]); T = np.array([1,1,1,0,0,0])
phiA = float(phi2[0])
def nll(b):
    mu = np.exp(b[0] + b[1]*T)
    return -np.sum(y*np.log(mu) - (y + 1/phiA)*np.log1p(phiA*mu))
res = minimize(nll, x0=[np.log(100), 1.5], method='Nelder-Mead', options={'xatol':1e-13,'fatol':1e-15,'maxiter':50000})
b0s,b1s = res.x
mu = np.exp(b0s + b1s*T)
wc = mu/(1+phiA*mu)
Sw=wc.sum(); SwT=(wc*T).sum(); det=Sw*SwT-SwT**2
se=np.sqrt(Sw/det)
print('scipy MLE A: log2FC=%.4f SE=%.4f z=%.2f' % (b1s/np.log(2), se, b1s/se))
print('irls   A  : log2FC=%.4f' % (b1[0]/np.log(2)))

fcp, pp = welch(m, ['t1','t2','t3'], ['c1','c2','c3'])
print('welch FC:', dict(zip(m.index, np.round(fcp,3)))); print('welch p:', dict(zip(m.index, np.round(pp,4))))

order = np.array(['g1','g2','g3','g4'])
