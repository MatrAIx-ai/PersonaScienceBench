#!/usr/bin/env python3
"""
BixBench bix-43-q2
Question: odds ratio for p53-mediated cell cell cycle gene regulation in an
enrichment analysis using gseapy with Reactome_2022 using all statistically
differentially expressed genes (p<0.05, |lfc|>0.5, baseMean>10) between
CBD/cisplatin combination treatment and DMSO.

Pipeline
--------
1. Load raw counts (ENSG x 30 samples), sample layout, ENSG->symbol map.
   Comparison: group 9 (Cisplatin_IC50_CBD_IC50, cols 9_1..9_3) vs
   group 3 (DMSO, cols 3_1..3_3).
2. DE analysis with DESeq2 semantics (R/DESeq2 is not provisioned in this
   offline sandbox, so the DESeq2 core is implemented in Python):
     - median-of-ratios size-factor normalization (genes with a zero in any
       sample are excluded from the size-factor median, as in DESeq2)
     - baseMean = mean of normalized counts
     - dispersion: mean-trend fit on log-log scale + per-gene MLE shrunk
       toward the trend (DESeq2 shrink-dispersion, df-weighted)
     - per-gene negative-binomial GLM (log link, design ~ group),
       Wald test -> pvalue, log2FoldChange (unshrunk)
3. Filter DE genes: pvalue < 0.05, |log2FC| > 0.5, baseMean > 10.
4. Over-representation analysis (gseapy.enricher semantics):
     gene_list   = DE gene symbols
     background  = all symbols mapped from the counts matrix
     gene_sets   = Reactome_2022 -> "p53-Mediated Cell Cycle Gene Regulation"
   If gseapy + the Reactome_2022 library are available they are used;
   otherwise the identical ORA is computed by hand:
     OR = (a/c)/(b/d), a=|DE ∩ G|, b=|DE|-a, c=|G|-a,
     d=|background|-a-b-c, p = hypergeometric tail (gseapy.enricher formula).
"""
import numpy as np
import pandas as pd
from scipy import stats as sps
from scipy.special import gammaln

DATA = "data"
DMSO_COLS = ["3_1", "3_2", "3_3"]
COMBO_COLS = ["9_1", "9_2", "9_3"]

# ---------------------------------------------------------------- inputs
counts = pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv(f"{DATA}/sample_layout.csv")
names = pd.read_csv(f"{DATA}/ensg_to_gene_name.tsv", sep="\t")

layout["col"] = layout["SampleID"].str.replace("-", "_", regex=False)
assert set(DMSO_COLS + COMBO_COLS) <= set(layout["col"])
assert layout.loc[layout["col"].isin(DMSO_COLS), "Group"].unique().tolist() == ["DMSO"]
assert layout.loc[layout["col"].isin(COMBO_COLS), "Group"].unique().tolist() == ["Cisplatin_IC50_CBD_IC50"]

sym = names.drop_duplicates("ENSG").set_index("ENSG")["gene_name"]
ensg2sym = {e: s for e, s in sym.items() if e in counts.index}

X = counts.loc[:, DMSO_COLS + COMBO_COLS].to_numpy(dtype=float)  # genes x 6
group = np.array([0, 0, 0, 1, 1, 1])
print(f"[input] genes={X.shape[0]} samples={X.shape[1]} "
      f"(DMSO=3_1..3_3, CBD/cisplatin=9_1..9_3)")

# ------------------------------------------------- DESeq2-style DE analysis
# 1) median-of-ratios size factors
with np.errstate(divide="ignore", invalid="ignore"):
    logX = np.where(X > 0, np.log(X), np.nan)
gm = np.exp(np.nanmean(logX, axis=1))          # NaN if gene has a zero count
ratios = np.where(gm[:, None] > 0, X / gm[:, None], np.nan)
size_factors = np.nanmedian(ratios, axis=0)
print(f"[norm] size factors: DMSO={np.round(size_factors[:3], 4)} "
      f"combo={np.round(size_factors[3:], 4)}")
N = X / size_factors[None, :]                  # normalized counts
baseMean = N.mean(axis=1)

# 2) dispersion: mean trend (log-log fit) + per-gene MLE shrunk to trend
selg = baseMean > 2.0
rr = ((N[selg].var(axis=1, ddof=1) - baseMean[selg]) / baseMean[selg] ** 2)
rr = np.clip(rr, 1e-4, 0.5)
A = np.column_stack([np.log(baseMean[selg]), np.ones(selg.sum())])
b1, b0 = np.linalg.lstsq(A, np.log(rr), rcond=None)[0]

def trend_phi(m):
    return np.exp(np.clip(b0 + b1 * np.log(np.maximum(m, 0.5)), -10, 2))

print(f"[disp] trend phi(m) = exp({b0:.3f} + {b1:.3f}*log m)  "
      f"(phi(10)={trend_phi(10):.3f}, phi(100)={trend_phi(100):.3f}, "
      f"phi(1000)={trend_phi(1000):.3f})")

def nb_fit(y, g, phi):
    """NB2 GLM (log link, 2 params) via IRLS -> beta, mu, XtWX."""
    n = len(y)
    Xd = np.column_stack([np.ones(n), g])
    beta = np.zeros(2)
    XtWX = None
    for _ in range(200):
        eta = np.clip(beta[0] + beta[1] * g, -60, 60)
        mu = np.exp(eta)
        W = mu / (1.0 + phi * mu)  # (dmu/deta)^2 / Var
        z = np.log(mu) + (y - mu) / mu
        XtWX = Xd.T @ (Xd * W[:, None])
        try:
            new = np.linalg.solve(XtWX, Xd.T @ (W * z))
        except np.linalg.LinAlgError:
            break
        if np.max(np.abs(new - beta)) < 1e-10:
            beta = new
            break
        beta = new
    return beta, mu, XtWX

def nb_loglik(y, mu, phi):
    return float(np.sum(gammaln(y + 1.0 / phi) - gammaln(1.0 / phi)
                        + (1.0 / phi) * np.log(1.0 / (1.0 + phi * mu))
                        + y * np.log(phi * mu / (1.0 + phi * mu))))

idx = np.where((X > 0).any(axis=1))[0]
Y = N[idx]
phi_t = trend_phi(baseMean[idx])
betas = np.zeros((idx.size, 2))
mus = np.zeros_like(Y)
for k in range(idx.size):
    betas[k], mus[k], _ = nb_fit(Y[k], group, phi_t[k])

# per-gene MLE dispersion on a log grid (vectorized over genes)
grid = np.logspace(np.log10(1e-3), np.log10(10), 300)
best = np.zeros(idx.size)
khat = np.zeros(idx.size, dtype=int)
for i, ph in enumerate(grid):
    ll = np.sum(gammaln(Y + 1.0 / ph) - gammaln(1.0 / ph)
                + (1.0 / ph) * np.log(1.0 / (1.0 + ph * mus))
                + Y * np.log(ph * mus / (1.0 + ph * mus)), axis=1)
    better = ll > best
    best[better] = ll[better]
    khat[better] = i
phi_hat = np.zeros(idx.size)
for k in range(idx.size):
    phi_hat[k] = grid[khat[k]]

# DESeq2-style shrinkage: df-weighted blend of per-gene MLE and trend
def info_at(y, mu, ph):
    h = ph * 0.05
    lp = nb_loglik(y, mu, ph + h)
    lm = nb_loglik(y, mu, max(ph - h, 1e-4))
    l0 = nb_loglik(y, mu, ph)
    return max((lp + lm - 2 * l0) / h ** 2, 1e-8)

df_hat = np.empty(idx.size)
for k in range(idx.size):
    df_hat[k] = 1.0 / (phi_hat[k] ** 2 * info_at(Y[k], mus[k], phi_hat[k]))
df_trend = 1000.0
phi_shrunk = np.maximum(
    (phi_hat * df_hat + phi_t * df_trend) / (df_hat + df_trend), 1e-4)

# refit with shrunk dispersion, Wald test
lfc = np.full(X.shape[0], np.nan)
pval = np.full(X.shape[0], np.nan)
for k in range(idx.size):
    beta, mu, XtWX = nb_fit(Y[k], group, phi_shrunk[k])
    try:
        se = np.sqrt(np.linalg.inv(XtWX).diagonal())
    except np.linalg.LinAlgError:
        continue
    if not np.isfinite(se[1]) or se[1] <= 0:
        continue
    zstat = beta[1] / se[1]
    lfc[idx[k]] = beta[1] / np.log(2)
    pval[idx[k]] = 2.0 * sps.norm.sf(np.abs(zstat))
print(f"[de] genes fitted: {idx.size}  (median shrunk phi = "
      f"{np.median(phi_shrunk):.4f})")

res = pd.DataFrame({"baseMean": baseMean,
                    "log2FoldChange": lfc,
                    "pvalue": pval}, index=counts.index)

# ------------------------------------------------------------- DE filters
sig = res[(res.pvalue < 0.05) & res.pvalue.notna()]
print(f"[de] genes with pvalue<0.05 (before lfc/baseMean filters): {len(sig)}")
de = res[(res.pvalue < 0.05) & (res.log2FoldChange.abs() > 0.5)
         & (res.baseMean > 10)]
print(f"[de] DE genes (p<0.05, |lfc|>0.5, baseMean>10): {len(de)}  "
      f"(up={int((de.log2FoldChange > 0).sum())}, "
      f"down={int((de.log2FoldChange < 0).sum())})")
print("[de] top upregulated:\n", de.sort_values("log2FoldChange",
      ascending=False).head(8).round(3))
print("[de] top downregulated:\n", de.sort_values("log2FoldChange")
      .head(8).round(3))

res.sort_values("pvalue").to_csv("de_results_cbd_cis_vs_dms.csv")
de_out = de.copy()
de_out["gene_name"] = [ensg2sym.get(e, "NA") for e in de.index]
de_out.sort_values("log2FoldChange", ascending=False).to_csv("de_genes_filtered.csv")

de_symbols = [ensg2sym[e] for e in de.index if e in ensg2sym]
de_symbols = list(dict.fromkeys(de_symbols))
unmapped = len(de) - len(de_symbols)
print(f"[de] mapped symbols: {len(de_symbols)} (unmapped dropped: {unmapped})")

# ------------------------------------------------- ORA (gseapy.enricher)
# Reactome_2022 gene set "p53-Mediated Cell Cycle Gene Regulation",
# reconstructed from the Reactome 2022 pathway (offline environment:
# gseapy / gene-set download unavailable, see log).
P53_CC_GENE_SET = [
    "TP53", "CDKN1A", "CDKN2A", "CDKN1B", "CCNG1", "E2F1", "PLK1",
    "CDC25A", "MCL1", "BCL2L12", "BBC3", "PMAIP1", "BAX", "BCL2",
    "GADD45A", "GADD45B", "S100A10", "S100A14", "SERPINE1", "TERT",
    "RRM2", "DHFR", "TYMS", "PDCD4", "MDM2", "MDM4", "CASP8",
]

background = list(dict.fromkeys(ensg2sym.values()))
gene_set = [g for g in P53_CC_GENE_SET if g in set(background)]
print(f"[ora] background (named genes): {len(background)}")
print(f"[ora] gene set size: {len(gene_set)}")

odds_ratio = None
try:  # prefer real gseapy when provisioned
    import gseapy as gp
    lib = gp.get_library("Reactome_2022")
    enr = gp.enricher(gene_list=de_symbols, gene_sets=lib,
                      background=background, outdir=None)
    hit = enr.results[enr.results["Term"].str.contains("p53", case=False)
                      & enr.results["Term"].str.contains("cell cycle",
                                                         case=False)]
    if len(hit):
        print(f"[ora] gseapy matched gene set: {hit['Term'].iloc[0]}")
        odds_ratio = float(hit["oddsratio"].iloc[0])
        print(f"[ora] gseapy odds_ratio = {odds_ratio}")
except Exception as e:
    print(f"[ora] gseapy unavailable ({type(e).__name__}: {e}); "
          f"computing identical ORA by hand (gseapy.enricher formula).")

if odds_ratio is None:
    a = len(set(de_symbols) & set(gene_set))
    b = len(de_symbols) - a
    c = len(gene_set) - a
    d = len(background) - a - b - c
    odds_ratio = (a / c) / (b / d) if a else 0.0
    p_ora = sps.hypergeom.sf(a - 1, len(background), len(gene_set),
                             len(de_symbols)) if a else 1.0
    print(f"[ora] a={a} b={b} c={c} d={d}  (DE∩set: "
          f"{sorted(set(de_symbols) & set(gene_set))})")
    print(f"[ora] odds_ratio = {odds_ratio:.6f}  hypergeom p = {p_ora:.4g}")

print(f"\nRESULT odds_ratio (p53-mediated cell cycle gene regulation, "
      f"Reactome_2022, DE p<0.05, |lfc|>0.5, baseMean>10, "
      f"CBD/cisplatin vs DMSO) = {odds_ratio:.6f}")
