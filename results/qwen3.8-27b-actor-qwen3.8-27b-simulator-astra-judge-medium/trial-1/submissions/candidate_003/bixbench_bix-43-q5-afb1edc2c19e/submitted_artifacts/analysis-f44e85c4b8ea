# 5. GSEA PRERANK (hand-rolled gseapy.prerank-equivalent; A7)
# ============================================================================
def _es(m_sorted, hit_sorted, weighted=True):
    Nn = len(m_sorted)
    N_hit = int(hit_sorted.sum()); N_miss = Nn - N_hit
    if N_hit == 0 or N_miss == 0:
        return 0.0
    if weighted:
        hws = np.abs(m_sorted[hit_sorted]).sum()
        if hws == 0: hws = 1.0
        step = np.where(hit_sorted, np.abs(m_sorted) / hws, -1.0 / N_miss)
    else:
        step = np.where(hit_sorted, 1.0 / N_hit, -1.0 / N_miss)
    cum = np.cumsum(step)
    emax, emin = cum.max(), cum.min()
    return emax if abs(emax) > abs(emin) else emin

def hand_rolled_prerank(rnk, gene_sets, min_size=15, max_size=500,
                        perm=1000, norm_enrichment=True, weighted=True, seed=1):
    rng = np.random.default_rng(seed)
    rnk = rnk.dropna().sort_values(ascending=False)
    genes = rnk.index.values; metrics = rnk.values.astype(float); Nn = len(genes)
    gidx = {g: i for i, g in enumerate(genes)}
    rows = []
    for term, members in gene_sets.items():
        if not (min_size <= len(members) <= max_size):
            continue
        hit_mask = np.zeros(Nn, dtype=bool)
        for g in members:
            if g in gidx: hit_mask[gidx[g]] = True
        if hit_mask.sum() < 1:
            continue
        order = np.argsort(-metrics, kind="stable")
        es_obs = _es(metrics[order], hit_mask[order], weighted)
        es_p = np.empty(perm)
        for i in range(perm):
            sh = rng.permutation(metrics)
            o = np.argsort(-sh, kind="stable")
            es_p[i] = _es(sh[o], hit_mask[o], weighted)
        same = es_p[es_p * es_obs > 0]
        nes = es_obs / same.mean() if len(same) else 0.0
        pval = (np.sum(np.abs(es_p) >= np.abs(es_obs)) + 1) / (perm + 1)
        rows.append({"Term": term, "NES": nes, "ES": es_obs, "size": len(members),
                     "n_in_list": int(hit_mask.sum()), "pval": pval})
    out = pd.DataFrame(rows)
    if len(out):
        out = out.sort_values(["pval", "NES"], ascending=[True, False]).reset_index(drop=True)
    return out

