#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
FINAL ANALYSIS (bix-43-q5)
Question: primary cellular mechanism enriched in the CBD/cisplatin combination
treatment, via gseapy + Reactome_2022, using all DE genes
(p<0.05, |log2FC|>0.5, baseMean>10).

CONSCIOUS ASSUMPTIONS (documented for review):
  A1: control group = DMSO (vehicle control), NOT Untreated.
  A2: combination group = "Cisplatin_IC50_CBD_IC50" (samples 9-1..9-3),
      NOT the "..._Serum_starvation_16h" variant.
  A3: p<0.05 = RAW p-value (not padj), as written in the question.
  A4: baseMean = mean of size-factor-normalized counts over ALL 30 samples
      (DESeq2 convention with the full design).
  A5: GSEA input = ALL DE genes (up + down together), ranked by signed log2FC,
      run with gseapy.prerank (ranked GSEA), not ORA / not up-vs-down split.
  A6: GSEA at gene-symbol level (Reactome_2022 uses symbols); multi-ENSG symbols
      deduplicated keeping max |log2FC|.
  A7: gseapy default parameters: perm=1000, min_size=15, max_size=500,
      norm_enrichment=True, weighted=True.

METHOD
  1. DESeq2-equivalent differential expression (pure numpy/scipy):
     median-of-ratios size factors -> normalized counts -> per-gene dispersion
     (profile-likelihood MLE shrunk toward a log-linear trend, DESeq2-style)
     -> Wald test for log2FC (treatment vs control).
  2. Filter: raw p<0.05, |log2FC|>0.5, baseMean>10.
  3. Map ENSG -> gene symbol; drop unmapped; dedupe symbols (max |log2FC|).
  4. GSEA prerank: FIRST try the real gseapy + Reactome_2022 (per the task spec).
     On ImportError / network error (offline sandbox), fall back to a
     hand-rolled gseapy.prerank-equivalent (GSEA ESM, same default parameters)
     using a curated Reactome_2022 approximation. The used path is printed.

Primary mechanism = top-1 pathway by NES (tie-break by nominal p).
"""
import numpy as np
import pandas as pd
from scipy.special import gammaln, xlogy
from scipy.stats import norm

DATA = "/workspace/data"
OUT  = "/workspace/analysis"

# ============================================================================
# 1. LOAD
# ============================================================================
counts = pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0, header=0)
counts.columns = [c.strip() for c in counts.columns]
layout = pd.read_csv(f"{DATA}/sample_layout.csv")
layout["u"] = layout["SampleID"].str.replace("-", "_", regex=False)
counts = counts[layout["u"]]
m = pd.read_csv(f"{DATA}/ensg_to_gene_name.tsv", sep="\t")

TREAT = "Cisplatin_IC50_CBD_IC50"   # A2
CTRL  = "DMSO"                       # A1
idx = {c: i for i, c in enumerate(counts.columns)}
ct_i = [idx[c] for c in layout.loc[layout.Group == CTRL, "u"]]
tr_i = [idx[c] for c in layout.loc[layout.Group == TREAT, "u"]]
print("[groups] treatment:", [counts.columns[i] for i in tr_i],
      " control:", [counts.columns[i] for i in ct_i])

C = counts.values.astype(np.float64)
logC = np.where(C > 0, np.log(C), -np.inf)
gm = np.exp(np.nanmean(logC, axis=1))
ratio = np.where(gm[:, None] > 0, C / gm[:, None], np.nan)
sf = np.nanmedian(ratio, axis=0)
sf = sf / np.median(sf)
N = C / sf[None, :]
baseMean = N.mean(axis=1)                 # A4: over all 30 samples

# ============================================================================
# 2. DESEQ2-EQUIVALENT DE (fit only genes that can pass baseMean>10)
# ============================================================================
keep = baseMean > 10
Nk = N[keep]; bm = baseMean[keep]; ensg = counts.index[keep]
Gk = len(Nk)
y0 = Nk[:, ct_i]; y1 = Nk[:, tr_i]
n0, n1 = len(ct_i), len(tr_i)
m0 = y0.mean(axis=1); m1 = y1.mean(axis=1)
tot = m0 * n0 + m1 * n1

def profile_ll(y, mu, r):
    mu = mu[:, None]
    return (gammaln(y + r) - gammaln(y + 1) - gammaln(r)
            + r * np.log(r) + xlogy(y, mu) - (y + r) * np.log(r + mu)).sum(axis=1)

r_grid = np.exp(np.linspace(np.log(0.05), np.log(200), 200))
best_r = np.full(Gk, np.nan); best_ll = np.full(Gk, -np.inf)
ok0 = m0 > 0; ok1 = m1 > 0; ok = ok0 & ok1
for r in r_grid:
    ll = np.full(Gk, -np.inf)
    ll[ok] = profile_ll(y0[ok], m0[ok], r) + profile_ll(y1[ok], m1[ok], r)
    better = ll > best_ll
    best_ll[better] = ll[better]; best_r[better] = r
alpha_mle = 1.0 / best_r
alpha_mle[~np.isfinite(alpha_mle)] = np.nan
not_boundary = (best_r > r_grid[0] * 1.01) & (best_r < r_grid[-1] * 0.99)
interior = ok & np.isfinite(alpha_mle) & not_boundary
btr, atr = np.polyfit(np.log(bm[interior]), np.log(alpha_mle[interior]), 1)
alpha_trend = np.exp(atr + btr * np.log(bm))
w = np.where(interior, np.minimum(1.0, tot / 100.0), 0.0)
alpha = np.exp(w * np.log(np.where(interior, alpha_mle, 1.0)) + (1 - w) * np.log(alpha_trend))

pse = 0.1
mu0p = np.maximum(m0, pse); mu1p = np.maximum(m1, pse)
log2fc = np.log2(mu1p / mu0p)
se = np.sqrt(alpha * (1.0 / (n0 * mu0p) + 1.0 / (n1 * mu1p)))
z = log2fc / se
p = 2.0 * (1.0 - norm.cdf(np.abs(z)))
res = pd.DataFrame({"baseMean": bm, "log2FC": log2fc, "pvalue": p,
                    "mean_ctrl": m0, "mean_tr": m1, "alpha": alpha}, index=ensg)
res.to_csv(f"{OUT}/de_results.csv")

# ============================================================================
# 3. FILTER + SYMBOL MAPPING (A3, A5, A6)
# ============================================================================
sig = res[(res.pvalue < 0.05) & (res.log2FC.abs() > 0.5) & (res.baseMean > 10)]
sym = m.set_index("ENSG")["gene_name"]
sig["sym"] = sig.index.map(sym)
sig = sig[sig.sym.notna()].copy()
sig = sig.loc[sig.groupby("sym")["log2FC"].apply(lambda s: s.abs().idxmax())]  # A6
print("[DE] DE genes (raw p<0.05, |log2FC|>0.5, baseMean>10):",
      len(res[(res.pvalue<0.05)&(res.log2FC.abs()>0.5)&(res.baseMean>10)]),
      "| mapped+dedup:", len(sig),
      "| up:", int((sig.log2FC>0).sum()), "down:", int((sig.log2FC<0).sum()))
sig.to_csv(f"{OUT}/de_final.csv")
rnk = sig.set_index("sym")["log2FC"]

