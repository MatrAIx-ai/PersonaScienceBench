#!/usr/bin/env python3
"""
BixBench bix-46-q1: log2 fold change of mexG in DeltarhlI (strain #97) vs wt (strain #1).

Inputs (supplied capsule):
  data/res_1vs97.rds                    DESeq2 Wald results (gzip-compressed, big-endian RDS3)
  data/Pseudomonas_aeruginosa_UCBPP-PA14.csv   locus annotation (Locus Tag / Gene Name)

Environment note: no R / pyreadr available -> parse the RDS binary directly (Python).
The RDS is a nested Bioconductor object; we extract rownames (locus tags) and the six
numeric columns, then validate the column->row alignment with the hard DESeq2 identity
    stat == log2FoldChange / lfcSE
before emitting any result (fails loudly if the identity breaks).
"""
import gzip, struct, re, sys, csv

RDS   = "data/res_1vs97.rds"
ANN   = "data/Pseudomonas_aeruginosa_UCBPP-PA14.csv"
GENE  = "mexG"

raw = gzip.open(RDS, "rb").read()
assert raw[:4] == b"X\n\x00\x00", "not an RDS file after gunzip"

# ---------------------------------------------------------------------------
# 1) Row names = locus tags, in file order (CHARSXP records: tag 0x04 + ref(2)
#    + len(4, big-endian) + bytes + enc(1); all tags are 10 chars -> step 18).
# ---------------------------------------------------------------------------
first = raw.find(b"PA14_")
rownames, o = [], first
while raw[o:o+5] == b"PA14_" and raw[o+5:o+10].isdigit():
    rownames.append(raw[o:o+10].decode())
    o += 18
N = len(rownames)
print(f"[rownames] N = {N}  first={rownames[0]}  last={rownames[-1]}")
assert N > 1000, "rownames extraction looks wrong"

# ---------------------------------------------------------------------------
# 2) Locate the six numeric columns. Each is a REAL vector: tag + ref(2) +
#    count(4, big-endian) + count*doubles. Find every 4-byte big-endian == N,
#    then take the maximal run of positions spaced ~N*8 apart (the column block).
# ---------------------------------------------------------------------------
beN = struct.pack(">I", N)
cand, o = [], 0
while True:
    o = raw.find(beN, o)
    if o < 0:
        break
    cand.append(o); o += 1
cand.sort()

def is_column_header(p):
    # first three doubles must be finite
    try:
        for k in range(3):
            v = struct.unpack_from(">d", raw, p + 4 + 8*k)[0]
            if v != v or v in (float("inf"), float("-inf")):
                return False
    except struct.error:
        return False
    return True

run, best = [], []
for p in cand:
    if run and (p - run[-1]) >= N*8 - 4 and (p - run[-1]) <= N*8 + 16:
        run.append(p)
    else:
        run = [p]
    if len(run) > len(best):
        best = list(run)
# keep only headers that actually start finite doubles
best = [p for p in best if is_column_header(p)]
assert len(best) == 6, f"expected 6 column headers, found {len(best)}: {best}"

COLS = ["baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]
data = {c: struct.unpack_from(f">{N}d", raw, p + 4) for c, p in zip(COLS, best)}
print(f"[columns] headers at {best}")
print(f"[columns] order -> {COLS}")

# ---------------------------------------------------------------------------
# 3) Column-identity sanity (order + value character).
# ---------------------------------------------------------------------------
bm, lfc, se, st, pv, pa = (data[c] for c in COLS)
assert all(x >= 0 for x in bm), "baseMean has negative values"
assert all(x >= 0 for x in se), "lfcSE has negative values"
assert all(0.0 <= x <= 1.0 for x in pv), "pvalue out of [0,1]"
assert all(0.0 <= x <= 1.0 for x in pa), "padj out of [0,1]"
print("[sanity] baseMean>=0, lfcSE>=0, pvalue/padj in [0,1]  OK")

# ---------------------------------------------------------------------------
# 4) HARD GUARD: stat == log2FoldChange / lfcSE  (DESeq2 internal identity).
#    Fails loudly if the column->row alignment is wrong.
# ---------------------------------------------------------------------------
ok = bad = 0
for i in range(N):
    if se[i] != 0 and all(v == v for v in (lfc[i], se[i], st[i])):
        if abs(st[i] - lfc[i]/se[i]) <= 1e-6 * max(1.0, abs(st[i])):
            ok += 1
        else:
            bad += 1
print(f"[guard] stat==log2FC/lfcSE  rows_ok={ok}  rows_bad={bad}")
if bad:
    sys.exit(f"FATAL: guard failed on {bad} rows -- column/row alignment is wrong")
print("[guard] HARD GUARD PASSED (alignment verified)\n")

# ---------------------------------------------------------------------------
# 5) Map mexG -> locus tag via the annotation CSV, then read log2FoldChange.
# ---------------------------------------------------------------------------
locus = None
with open(ANN, newline="") as f:
    rdr = csv.reader(f)
    hdr = next(rdr)
    gi, li = hdr.index("Gene Name"), hdr.index("Locus Tag")
    matches = [(r[li], r[gi]) for r in rdr if r[gi].strip().lower() == GENE.lower()]
print(f"[map] {GENE} annotation matches: {matches}")
assert len(matches) == 1, f"expected exactly 1 {GENE} match, got {len(matches)}"
locus = matches[0][0]
assert locus in rownames, f"{locus} not among RDS rownames"
i = rownames.index(locus)

val = lfc[i]
direction = "log2FoldChange = log2(Strain97 / Strain1) = log2(DeltarhlI / wt)  [coefficient: 'Wald statistic: Strain 97 vs 1'; NO sign flip]"
print("="*70)
print(f"gene            : {GENE}")
print(f"locus tag       : {locus}")
print(f"row index       : {i}  (of {N})")
print(f"column used     : log2FoldChange")
print(f"direction       : {direction}")
print(f"raw log2FC      : {val!r}")
print(f"rounded to 2 dp : {round(val, 2)}")
print("="*70)
print(f"ANSWER: {round(val, 2)}")
