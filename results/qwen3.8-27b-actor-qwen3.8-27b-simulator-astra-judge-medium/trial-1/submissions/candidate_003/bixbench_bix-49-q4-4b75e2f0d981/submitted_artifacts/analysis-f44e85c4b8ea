#!/usr/bin/env python3
# ============================================================================
# FALLBACK (Python) DESeq2-equivalent differential expression analysis
# Question: total # genes with padj < 0.05 (up+down) for ASXL1 vs Control,
#           design ~ condition, LFC shrinkage type=apeglm.
# WHY FALLBACK: R / Bioconductor (DESeq2, apeglm) is NOT installed in this
#   workspace and there is no network to install it (verified at run time).
#   The PRIMARY analysis is analysis.R (DESeq2 + apeglm). This script
#   reproduces the DESeq2 core in Python as a documented approximation:
#     - median-of-ratios size factors
#     - negative-binomial Wald test for the condition coefficient
#       (delta-method SE using a DESeq2-style dispersion trend)
#     - Benjamini-Hochberg FDR  (== DESeq2 padj); apeglm LFC shrinkage does
#       NOT change padj, so the padj<0.05 count is unaffected by shrinkage.
# Zero-handling mirrors DESeq2: all-zero genes -> not tested (p=1); genes
# expressed in only one group get a tiny pseudo-count for a stable log2FC.
# ============================================================================
import numpy as np, pandas as pd, time, warnings, csv
from scipy.stats import norm
warnings.filterwarnings("ignore"); t0=time.time()

# ---- load counts (space-delimited; rows = Ensembl gene_id w/ version) ----
with open('data/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt') as f:
    hdr=f.readline().split(); rows=[l.split() for l in f]
genes=np.array([r[0] for r in rows]); K=np.array([[int(x) for x in r[1:]] for r in rows],float)
samples=hdr[1:]; G,S=K.shape
# ---- coldata; keep samples present in coldata (drop MGD1640B, MGD1641B) ----
cd=pd.read_excel('data/Issy_ASXL1_blood_coldata_gender.xlsx')
keep=[s for s in samples if s in set(cd['sample'])]; dropped=[s for s in samples if s not in set(cd['sample'])]
J={s:i for i,s in enumerate(keep)}; Kf=K[:,[J[s] for s in keep]]
cdk=cd.set_index('sample').loc[keep].reset_index()
cond=(cdk['condition'].values=='ASXL1').astype(float)   # 1=ASXL1, 0=Control(ref)
nA=int(cond.sum()); nC=len(cond)-nA
print("samples kept",len(keep),"dropped",dropped,"| ASXL1",nA,"Control",nC)
# ---- gene_id -> gene_name via gencode (1:1) ----
gname={}
with open('data/gencode.v31.primary_assembly.genes.csv') as f:
    for row in csv.DictReader(f): gname[row['gene_id']]=row['gene_name']
gnames=np.array([gname.get(g,'') for g in genes])
# ---- size factors: median of ratios ----
logK=np.log(Kf+1e-12); ref=np.exp(logK.mean(axis=1))
sf=np.nanmedian(Kf/ref[:,None],axis=0); off=np.log(sf); normK=Kf/sf[None,:]
print("size factors:",np.round(sf,3))
# ---- dispersion trend (DESeq2-like): log(disp) ~ log(mean), fit on reliable genes ----
mean_n=normK.mean(axis=1); var_n=normK.var(axis=1,ddof=1)
alpha_mom=np.maximum(0.0,(var_n-mean_n)/np.maximum(mean_n,1e-6)**2)
ok=(mean_n>1)&(alpha_mom>0)
bt,at=np.linalg.lstsq(np.column_stack([np.log(mean_n[ok]),np.ones(ok.sum())]),np.log(alpha_mom[ok]),rcond=None)[0]
alpha_trend=np.exp(at+bt*np.log(np.maximum(mean_n,1e-6)))
print("dispersion trend: log(disp)=%.3f %+0.3f*log(mean)"%(at,bt))
mua=normK[:,cond==1].mean(1); muc=normK[:,cond==0].mean(1)
# ---- Wald test (delta method, NB variance) ----
def pval_gene(ma,mc,pc,alph):
    la=ma+pc; lc=mc+pc
    if la<=0 or lc<=0: return 1.0,0.0
    lfc=np.log2(la/lc)
    se=(1/np.log(2))*np.sqrt((1+alph*la)/(la*nA)+(1+alph*lc)/(lc*nC))
    z=lfc/se
    return 2*norm.sf(abs(z)),lfc
interior=(mua>0)&(muc>0); boundary=(mua>0)^(muc>0); alloff=(mua==0)&(muc==0)
pv=np.ones(G); lfc=np.zeros(G)
ii=np.where(interior)[0]; bb=np.where(boundary)[0]
pv[ii]=np.array([pval_gene(mua[i],muc[i],0.0,alpha_trend[i])[0] for i in ii])   # pc=0 ~ MLE
lfc[ii]=np.array([pval_gene(mua[i],muc[i],0.0,alpha_trend[i])[1] for i in ii])
pv[bb]=np.array([pval_gene(mua[i],muc[i],0.1,alpha_trend[i])[0] for i in bb])   # tiny pc
lfc[bb]=np.array([pval_gene(mua[i],muc[i],0.1,alpha_trend[i])[1] for i in bb])
# ---- Benjamini-Hochberg FDR over all genes ----
def bh(pv):
    m=len(pv); o=np.argsort(pv); s=pv[o]
    adj=np.minimum.accumulate((s*m/np.arange(1,m+1))[::-1])[::-1]
    out=np.empty(m); out[o]=adj; return np.clip(out,0,1)
padj=bh(pv); sig=padj<0.05
total=int(sig.sum()); up=int((sig&(lfc>0)).sum()); down=int((sig&(lfc<0)).sum())
print("\n================ RESULT (Python DESeq2-equivalent) ================")
print("Total significantly DE genes (padj < 0.05):", total)
print("  Up-regulated (ASXL1 > Control):", up)
print("  Down-regulated (ASXL1 < Control):", down)
print("  (interior tested:",int(interior.sum())," one-group:",int(boundary.sum())," all-zero:",int(alloff.sum()),")")
# ---- sensitivity ----
pv2=np.array([pval_gene(mua[i],muc[i],0.1,alpha_trend[i])[0] for i in range(G)])
lfc2=np.array([pval_gene(mua[i],muc[i],0.1,alpha_trend[i])[1] for i in range(G)])
s2=bh(pv2)<0.05
alpha_h=np.where((mean_n>10)&(alpha_mom>0),np.minimum(alpha_mom,alpha_trend*3),alpha_trend)
pv3=np.array([pval_gene(mua[i],muc[i],0.1,alpha_h[i])[0] for i in range(G)])
s3=bh(pv3)<0.05
print("Sensitivity: primary=%d | uniform pc=0.1=%d | gene-specific MoM disp=%d"%(total,int(s2.sum()),int(s3.sum())))
print("==========================================")
# ---- save ----
res=pd.DataFrame({"gene_id":genes,"gene_name":gnames,"log2FC":lfc,"pvalue":pv,"padj":padj})
res.to_csv("de_results_python_fallback.csv",index=False)
print("saved de_results_python_fallback.csv; total time",round(time.time()-t0,1),"s")
