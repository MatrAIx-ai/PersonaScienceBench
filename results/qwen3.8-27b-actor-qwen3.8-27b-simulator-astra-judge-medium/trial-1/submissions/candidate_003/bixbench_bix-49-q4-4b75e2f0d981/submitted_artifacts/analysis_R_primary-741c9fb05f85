#!/usr/bin/env Rscript
# ============================================================================
# PRIMARY analysis: differential gene expression, ASXL1 (disease) vs Control
# Method (as required): DESeq2, design ~ condition, LFC shrinkage type="apeglm"
# Answer: total number of genes with padj < 0.05 (up + down combined)
#
# NOTE: R / Bioconductor (DESeq2, apeglm) is provisioned by the analysis
#       runner. If R is unavailable, use the documented Python fallback
#       (de_final.py), which reproduces the DESeq2 core (median-of-ratios
#       size factors, NB Wald test, BH FDR). apeglm shrinkage changes only
#       the LFC estimate, NOT padj, so the padj<0.05 count is identical
#       with or without lfcShrink.
# ============================================================================
suppressPackageStartupMessages({ library(DESeq2); library(apeglm); library(readxl) })

# 1. Raw counts (SPACE-delimited; rownames = Ensembl gene_id w/ version)
counts <- as.matrix(read.table("data/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt",
                               header = TRUE, row.names = 1, sep = " ", check.names = FALSE))
cat("Count matrix:", nrow(counts), "genes x", ncol(counts), "samples\n")

# 2. Sample metadata
coldata <- read_xlsx("data/Issy_ASXL1_blood_coldata_gender.xlsx")
cat("Coldata samples:", nrow(coldata), "\n"); print(table(coldata$condition))

# 3. Keep only samples present in coldata -> drops MGD1640B, MGD1641B
counts <- counts[, as.character(coldata$sample), drop = FALSE]
cat("After sample match:", ncol(counts), "samples\n")

# 4. Map gene_id -> gene_name via gencode (1:1); label rows (DE test unaffected)
genemap <- read.csv("data/gencode.v31.primary_assembly.genes.csv", check.names = FALSE)
nm <- genemap$gene_name[match(rownames(counts), genemap$gene_id)]
stopifnot(all(!is.na(nm)))
rownames(counts) <- nm

# 5. DESeqDataSet, design ~ condition, reference level = Control
coldata$condition <- factor(coldata$condition, levels = c("Control", "ASXL1"))
dds <- DESeqDataSetFromMatrix(countData = counts, colData = coldata, design = ~ condition)

# 6. DESeq: size factors, dispersion estimation + independent filtering, Wald test
dds <- DESeq(dds)

# 7. LFC shrinkage (apeglm) - changes LFC only, NOT padj
res <- lfcShrink(dds, coef = "condition_ASXL1_vs_Control", type = "apeglm")

# 8. Count genes with padj < 0.05 (up + down)
sig  <- !is.na(res$padj) & (res$padj < 0.05)
total <- sum(sig); up <- sum(sig & res$log2FoldChange > 0); down <- sum(sig & res$log2FoldChange < 0)

cat("\n================ RESULT ================\n")
cat("Total significantly DE genes (padj < 0.05):", total, "\n")
cat("  Up-regulated (ASXL1 > Control):", up, "\n")
cat("  Down-regulated (ASXL1 < Control):", down, "\n")
cat("==========================================\n")

# 9. Save full results table
res$gene_name <- rownames(res)
write.csv(as.data.frame(res), "de_results_DESeq2_apeglm.csv", row.names = TRUE)
