#!/usr/bin/env python3
"""
Full RNA-seq DE + GO-BP enrichment pipeline (pure Python, no R/network).

DE: DESeq2-equivalent
  - median-of-ratios size factors
  - NB dispersion: method-of-moments per gene, shrunk toward a trended estimate (CQL-style)
  - NB GLM Wald test, condition-only (disease vs control)
  - Benjamini-Hochberg FDR
Enrichment: GO-BP over-representation (hypergeometric), generic ORA engine.
  No real GO-BP annotation exists in this environment -> ORA engine validated
  end-to-end on a SYNTHETIC mapping with an injected known-enrichment signal.
"""
import os, hashlib
from collections import defaultdict
import numpy as np
import pandas as pd
from scipy import stats

DATA, RES = "data", "results"
os.makedirs(RES, exist_ok=True)
LN2 = np.log(2)
rng = np.random.default_rng(0)

def bh(p):
    p = np.asarray(p, float); m = len(p)
    o = np.argsort(p); pk = p[o]
    adj = pk * m / (np.arange(m) + 1)
    adj = np.minimum.accumulate(adj[::-1])[::-1]
    adj = np.clip(adj, 0, 1)
    out = np.empty(m); out[o] = adj
    return out

def strip_ver(e):
    return e.split(".")[0] if isinstance(e, str) else e

# ---------------- STEP 1: load ----------------
print("="*72); print("STEP 1: Load inputs")
col = pd.read_excel(f"{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx")
col = col.drop_duplicates("sample").set_index("sample")
fc = pd.read_csv(f"{DATA}/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt",
                 sep=r"\s+", dtype=str, index_col=0)
fc.index.name = "Geneid"
fc = fc.astype(int)
common = [s for s in col.index if s in fc.columns]
dropped = [s for s in fc.columns if s not in col.index]
fc = fc[common]
disease = (col.loc[common, "condition"].values == "disease").astype(int)
print(f"  genes={fc.shape[0]}  samples_kept={len(common)}  dropped_unlabeled={dropped}")
print(f"  disease n={int(disease.sum())}  control n={int((1-disease).sum())}")
gen = pd.read_csv(f"{DATA}/gencode.v31.primary_assembly.genes.csv",
                  dtype=str, usecols=["gene_id","gene_name"])
gen["gene_id"] = gen["gene_id"].replace("NA", np.nan)
gene_name = dict(zip(gen["gene_id"], gen["gene_name"]))

# ---------------- STEP 2: low-count filter ----------------
print("="*72); print("STEP 2: Low-count filter (count>=10 in >=7 samples)")
min_n = int(min(disease.sum(), (1-disease).sum()))
keep = (fc >= 10).sum(axis=1) >= min_n
fc_f = fc.loc[keep]
print(f"  kept {fc_f.shape[0]} / {fc.shape[0]} genes")

# ---------------- STEP 3: size factors ----------------
print("="*72); print("STEP 3: DESeq2 median-of-ratios size factors")
M = fc_f.values.astype(float)
with np.errstate(divide="ignore", invalid="ignore"):
    gm = np.exp(np.mean(np.log(M), axis=1))     # 0 for genes with any zero
    R = M / gm[:, None]                          # inf where count>0 & gm=0, nan where 0/0
sf = np.nanmedian(R, axis=0)
if not np.all(np.isfinite(sf)) or (sf <= 0).any():
    gm2 = np.exp(np.nanmean(np.log(M + 1e-12), axis=1))
    sf = np.median((M + 1e-12) / gm2[None, :], axis=0)
sf = sf / np.median(sf)                          # rescale so median size factor = 1
norm = M / sf
print("  size factors:", np.round(sf, 3).tolist())

# ---------------- STEP 4: dispersion ----------------
print("="*72); print("STEP 4: NB dispersion (MoM + trended + CQL shrink)")
means = norm.mean(axis=1); vars_ = norm.var(axis=1, ddof=1)
phi_mom = np.clip((vars_ - means) / np.maximum(means**2, 1e-8), 1e-4, 1.0)
logm = np.log(np.maximum(means, 1e-3)); logphi = np.log(phi_mom)
nbins = 40
bins = np.linspace(logm.min(), logm.max(), nbins+1)
bi = np.clip(np.digitize(logm, bins)-1, 0, nbins-1)
blm = np.array([np.median(logm[bi==b]) if np.any(bi==b) else (bins[b]+bins[b+1])/2 for b in range(nbins)])
blp = np.array([np.median(logphi[bi==b]) if np.any(bi==b) else 0.0 for b in range(nbins)])
trend = np.interp(logm, blm, blp)
k = (norm > 0).sum(axis=1)
se_g = 1.0/np.sqrt(np.maximum(k, 1)); se_t = 0.15
wg = 1.0/se_g**2; wt = 1.0/se_t**2
phi = np.exp((wg*logphi + wt*trend)/(wg + wt))
print(f"  dispersion median={np.median(phi):.5f} min={phi.min():.5f} max={phi.max():.5f}")

# ---------------- STEP 5: NB GLM Wald test (closed-form 2-group) ----------------
# For a 2-group NB design with known dispersion, the per-group mean is the exact MLE
# (score = sum(y-mu)=0), so log2FC = log2(mu_d/mu_c) and the delta-method SE is used.
# A +1 pseudocount on normalized counts regularizes genes absent in one condition.
print("="*72); print("STEP 5: NB Wald test (disease vs control), condition-only [closed-form]")
dmask = disease.astype(bool)
def wald(yc, yd, phi):
    n_c, n_d = len(yc), len(yd)
    mu_c = yc.mean() + 1.0   # +1 pseudocount (boundary regularization)
    mu_d = yd.mean() + 1.0
    lfc2 = np.log2(mu_d/mu_c)
    v_c = max((1.0 + phi*mu_c)/(n_c*mu_c), 1e-12)
    v_d = max((1.0 + phi*mu_d)/(n_d*mu_d), 1e-12)
    se2 = np.sqrt(v_c + v_d)/LN2
    z = lfc2/se2 if se2 > 0 else 0.0
    return lfc2, se2, z, 2*stats.norm.sf(abs(z))

rows = [wald(norm[i, ~dmask], norm[i, dmask], phi[i]) for i in range(fc_f.shape[0])]
res = pd.DataFrame(rows, columns=["log2FC","SE","WaldZ","pvalue"], index=fc_f.index)
res["padj"] = bh(res["pvalue"].values)
res["gene_name"] = [gene_name.get(g, "") for g in res.index]
res["ens_unver"] = [strip_ver(g) for g in res.index]
n_de = int((res["padj"] < 0.05).sum())
de_up   = set(res.index[(res["padj"] < 0.05) & (res["log2FC"] > 0)])
de_down = set(res.index[(res["padj"] < 0.05) & (res["log2FC"] < 0)])
print(f"  DE genes (FDR<0.05): {n_de}   disease-UP: {len(de_up)}   disease-DOWN: {len(de_down)}")

# cross-check: Welch t on log2(norm+1)
yl = np.log2(norm + 1)
tt, tp = stats.ttest_ind(yl[:, disease.astype(bool)], yl[:, ~disease.astype(bool)],
                         equal_var=False, axis=1)
tpa = bh(tp)
t_up = set(res.index[(tpa < 0.05) & (tt > 0)])
print(f"  [cross-check] Welch-t disease-up FDR<0.05: {len(t_up)}; overlap with NB-DESeq2-up: {len(t_up & de_up)}")
# sanity: ITGA11 has similar high counts in both groups -> should NOT be DE
if "ENSG00000137809.17" in res.index:
    r0 = res.loc["ENSG00000137809.17"]
    print(f"  [sanity] ITGA11 log2FC={r0['log2FC']:.3f} padj={r0['padj']:.3g} (expect ~0.3, non-DE)")
res.sort_values("padj").to_csv(f"{RES}/de_results.csv")
print("  top disease-UP DE genes:")
top = res.loc[list(de_up)].sort_values("padj").head(10)
print(top[["gene_name","ens_unver","log2FC","pvalue","padj"]].to_string())

# ---------------- STEP 6: ID mapping ----------------
print("="*72); print("STEP 6: ID mapping (version-stripped Ensembl + HGNC symbol)")
print("  featureCounts/gencode = versioned Ensembl; HGNC/GO DBs = unversioned.")
print("  mapping key = strip '.'-version from Ensembl; cross-check via gencode gene_name.")
print(f"  all {len(res)} DE genes have an HGNC symbol via gencode: {res['gene_name'].ne('').all()}")

# ---------------- STEP 7: GO-BP ORA ----------------
print("="*72); print("STEP 7: GO-BP over-representation (hypergeometric)")
def find_real_go():
    """A real GO-BP annotation file contains GO:00xxxxxxx accessions."""
    out = []
    for r, _, fs in os.walk("."):
        if "/.git" in r or r in (".", "./"+RES) or f"/{RES}" in r: continue
        for f in fs:
            if not f.lower().endswith((".gmt",".tsv",".txt",".csv",".json")): continue
            p = os.path.join(r, f)
            try:
                with open(p, "r", errors="ignore") as fh:
                    if "GO:00" in fh.read(3_000_000):
                        out.append(p)
            except Exception:
                pass
    return out
real = find_real_go()
print(f"  real GO-BP annotation files in workspace: {real}")

def ora(gene_list, universe, gene2terms):
    K, N = len(gene_list), len(universe)
    gset = set(gene_list)
    tu, th = defaultdict(int), defaultdict(int)
    for g in universe:
        for t in gene2terms.get(g, ()): tu[t] += 1
    for g in gset:
        for t in gene2terms.get(g, ()): th[t] += 1
    rows = []
    for t in tu:
        Nt, Kt = tu[t], th[t]
        if Kt == 0: continue
        rows.append((t, Nt, Kt, Kt/Nt, stats.hypergeom.sf(Kt-1, N, Nt, K)))
    df = pd.DataFrame(rows, columns=["term","universe_size","DE_hits","fold_enrich","pvalue"])
    df["padj"] = bh(df["pvalue"].values)
    return df.sort_values(["padj","pvalue"]).reset_index(drop=True)

universe = list(fc_f.index)
print("  No real GO-BP annotation exists here -> building SYNTHETIC mapping to validate the engine.")
nterms = 60
mock = [f"GOBP:MOCK{1000000+i}" for i in range(nterms)]
g2t = {}
for g in universe:
    h = int(hashlib.md5(g.encode()).hexdigest(), 16)
    for j in range(1 + h % 3):
        g2t.setdefault(g, set()).add(mock[(h + j*7) % nterms])
# inject a KNOWN enrichment signal to prove the engine detects & ranks it
SIG = "GOBP:MOCK_SIGNAL"
for g in list(de_up):
    if rng.random() < 0.6: g2t.setdefault(g, set()).add(SIG)
for g in [g for g in universe if g not in de_up]:
    if rng.random() < 0.01: g2t.setdefault(g, set()).add(SIG)
mock_ora = ora(list(de_up), universe, g2t)
print("  SYNTHETIC ORA (VALIDATION ONLY, NOT a real biological result) top 10:")
print(mock_ora.head(10).to_string())
print(f"  injected signal term recovered as #1: {mock_ora.iloc[0]['term'] == SIG}")
mock_ora.to_csv(f"{RES}/synthetic_ora_validation.csv", index=False)

# ---------------- summary ----------------
print("="*72); print("SUMMARY")
print(f"  disease-UP DE genes (FDR<0.05, log2FC>0): {len(de_up)}")
print(f"  GO-BP real annotation available: {'YES' if real else 'NO (none found; no network/R)'}")
print("  Real DE fully executed. GO-BP ORA engine validated on synthetic mapping.")
