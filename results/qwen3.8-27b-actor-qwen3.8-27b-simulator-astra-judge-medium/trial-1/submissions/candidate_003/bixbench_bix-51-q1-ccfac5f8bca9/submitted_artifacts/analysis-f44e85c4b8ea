"""
Logistic regression: P(Efficacy == 'PR') ~ Age (sole predictor), predict at Age = 65.

Data: /workspace/data/data.xlsx, Sheet1
Method: statsmodels sm.Logit (unregularized MLE).
Cleaning: drop all-empty rows; coerce Age to numeric (errors='coerce');
          drop rows with missing Age / Efficacy / Groups (1 junk row, Age=' ').
Caveat (known, per mandated single-predictor spec): Efficacy is perfectly
confounded with Groups (Group 1 = 100% PR, Group 2 = 0% PR), so the Age-only
model implicitly mixes both trial arms.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---- 1. Load & clean -------------------------------------------------------
df = pd.read_excel("/workspace/data/data.xlsx", sheet_name="Sheet1")
n_raw = len(df)
df = df.dropna(how="all")                       # drop 40 all-empty trailing rows
df["Age_num"] = pd.to_numeric(df["Age"], errors="coerce")  # mixed int/str + one ' '
df = df.dropna(subset=["Age_num", "Efficacy", "Groups"]).reset_index(drop=True)
print(f"Raw rows: {n_raw} | after cleaning: {len(df)}")

# ---- 2. Binary target: PR = 1, everything else (PD, SD) = 0 ---------------
y = (df["Efficacy"] == "PR").astype(int)
print(f"Target: PR={int(y.sum())}, non-PR={int((1 - y).sum())}, n={len(y)}")

# ---- 3. Fit logistic regression, Age as the ONLY predictor ----------------
X = sm.add_constant(df["Age_num"].astype(float))
model = sm.Logit(y, X).fit(disp=0)
print("\n--- Model summary ---")
print(model.summary())
print(f"Converged: {model.mle_retvals['converged']}")

# ---- 4. Predict at Age = 65 ------------------------------------------------
p65 = model.predict([1.0, 65.0])[0]
print(f"\nPredicted P(PR | Age=65) = {p65:.4f}")
