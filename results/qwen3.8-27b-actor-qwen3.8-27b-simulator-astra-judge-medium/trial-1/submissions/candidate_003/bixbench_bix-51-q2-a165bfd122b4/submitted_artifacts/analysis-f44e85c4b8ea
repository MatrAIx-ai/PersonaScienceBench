import pandas as pd
import numpy as np
import statsmodels.api as sm

# Load
df = pd.ExcelFile('data/data.xlsx').parse('Sheet1')

# Keep only real rows (non-blank): require Efficacy, BMI, Groups present
real = df.dropna(subset=['Efficacy', 'BMI', 'Groups']).copy()

# Outcome: Y = 1 if Efficacy == 'PR', else 0
real['Y'] = (real['Efficacy'] == 'PR').astype(int)

n = len(real)
print("=== DATA ===")
print("rows used n =", n)
print("Y distribution:", real['Y'].value_counts().to_dict())
print("BMI range:", real['BMI'].min(), "-", real['BMI'].max())

# Fit logistic regression Y ~ BMI (intercept + slope)
X = sm.add_constant(real['BMI'])
model = sm.Logit(real['Y'], X)
res = model.fit(disp=0)

print("\n=== CONVERGENCE / WARNINGS ===")
print("converged:", res.mle_retvals['converged'])
print("iterations:", res.mle_retvals['iterations'])

print("\n=== SUMMARY ===")
print(res.summary())

# Coefficients
intercept = res.params['const']
slope = res.params['BMI']
loglik = res.llf
k = 2  # intercept + slope
aic_manual = -2 * loglik + 2 * k
aic_sm = res.aic

print("\n=== RESULTS ===")
print("intercept =", intercept)
print("BMI slope  =", slope)
print("log-likelihood =", loglik)
print("n obs =", n)
print("k (params) =", k)
print("AIC (manual -2*loglik + 2*k) =", aic_manual)
print("AIC (statsmodels res.aic)     =", aic_sm)
print("AIC to 2 dp =", round(aic_manual, 2))
