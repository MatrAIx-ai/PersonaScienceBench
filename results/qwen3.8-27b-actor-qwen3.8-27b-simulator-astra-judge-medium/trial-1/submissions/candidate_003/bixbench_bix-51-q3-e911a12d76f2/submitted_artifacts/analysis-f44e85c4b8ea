"""
Logistic regression: PR (partial response) ~ BMI + Age + Gender
Data: data/data.xlsx (drop empty filler rows)
Outcome: 1 if Efficacy == 'PR', 0 otherwise (SD or PD)
Predictors: BMI (continuous), Age (continuous), Gender (binary factor)
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.stats.anova import anova_lm
import warnings
warnings.filterwarnings('ignore')

# --- Load and clean ---
df = pd.read_excel('data/data.xlsx')
print(f"Raw shape: {df.shape}")

# Drop rows where Efficacy is NaN (the 41 empty filler rows)
df = df.dropna(subset=['Efficacy']).reset_index(drop=True)
print(f"Valid shape after dropping empty rows: {df.shape}")

# --- Encode outcome ---
df['PR'] = (df['Efficacy'] == 'PR').astype(int)
print(f"\nOutcome counts: PR=1: {df['PR'].sum()}, PR=0: {(1-df['PR']).sum()}")

# --- Encode predictors ---
# Age: already numeric (object dtype but all integers)
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
# BMI: already float
# Gender: binary factor (Female=0 reference, Male=1)
df['Gender_Male'] = (df['Gender'] == 'Male').astype(int)

print(f"\nPredictor summary:")
print(f"  BMI:  mean={df['BMI'].mean():.2f}, sd={df['BMI'].std():.2f}, range=[{df['BMI'].min()}, {df['BMI'].max()}]")
print(f"  Age:  mean={df['Age'].mean():.2f}, sd={df['Age'].std():.2f}, range=[{df['Age'].min()}, {df['Age'].max()}]")
print(f"  Gender: Male={df['Gender_Male'].sum()}, Female={1-df['Gender_Male'].sum()}")
print(f"  Missing in predictors: BMI={df['BMI'].isna().sum()}, Age={df['Age'].isna().sum()}, Gender={df['Gender_Male'].isna().sum()}")

# --- Fit logistic regression ---
X = df[['BMI', 'Age', 'Gender_Male']].astype(float)
X = sm.add_constant(X)
y = df['PR'].astype(float)

model = sm.Logit(y, X)
result = model.fit(disp=0)

print("\n" + "="*60)
print("LOGISTIC REGRESSION: PR ~ BMI + Age + Gender_Male")
print("="*60)
print(result.summary())

# --- Wald p-value for Age (primary) ---
wald_p_age = result.pvalues['Age']
print("\n" + "-"*60)
print(f"WALD p-value for Age: {wald_p_age:.6f}")
print("-"*60)

# --- Likelihood-ratio (drop1) p-value for Age ---
# drop1 performs an LR test dropping each term one at a time
from statsmodels.stats.outliers_influence import variance_inflation_factor
# Use anova_lm with typ=2 for LR-based drop tests
# Actually, for logistic regression, we use the nested model approach
# Fit reduced model without Age
X_reduced = df[['BMI', 'Gender_Male']].astype(float)
X_reduced = sm.add_constant(X_reduced)
model_reduced = sm.Logit(y, X_reduced)
result_reduced = model_reduced.fit(disp=0)

# LR test: 2*(logL_full - logL_reduced) ~ chi2(1)
from scipy.stats import chi2
lr_stat = 2 * (result.llf - result_reduced.llf)
lr_p_age = chi2.sf(lr_stat, df=1)
print(f"LR (drop1) statistic for Age: {lr_stat:.4f}")
print(f"LR (drop1) p-value for Age:  {lr_p_age:.6f}")
print("-"*60)

# Also do drop1 for all terms for completeness
print("\nDrop1 (LR) tests for all terms:")
for term in ['BMI', 'Age', 'Gender_Male']:
    cols = ['BMI', 'Age', 'Gender_Male']
    cols.remove(term)
    X_r = df[cols].astype(float)
    X_r = sm.add_constant(X_r)
    m_r = sm.Logit(y, X_r)
    r_r = m_r.fit(disp=0)
    lr_s = 2 * (result.llf - r_r.llf)
    lr_p = chi2.sf(lr_s, df=1)
    print(f"  {term:15s}: LR stat={lr_s:.4f}, p={lr_p:.6f}")

print("\n" + "="*60)
print(f"FINAL ANSWER: p-value for Age (Wald) = {wald_p_age:.6f}")
print(f"            p-value for Age (LR)   = {lr_p_age:.6f}")
print("="*60)
