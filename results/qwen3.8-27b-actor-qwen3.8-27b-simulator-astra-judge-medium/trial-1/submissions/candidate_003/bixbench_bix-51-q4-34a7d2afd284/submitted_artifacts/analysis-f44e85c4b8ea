"""Logistic regression: change in log-odds of remission per +1 year age.
Outcome: Remission = PR (1), non-remission = SD+PD (0).
Predictors: Age (raw years), BMI (continuous), Gender (Male=1, Female=0).
Data: data/data.xlsx, 80 true records (junk rows dropped, Age cast to int).
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
from scipy import stats

def hl_test(y, p, g=10):
    d = pd.DataFrame({'y':y,'p':p})
    d['grp'] = pd.qcut(d['p'], g, duplicates='drop')
    t = d.groupby('grp').agg(obs1=('y','sum'), n=('y','size'), pmean=('p','mean'))
    t['exp1'] = t['pmean']*t['n']; t['exp0'] = t['n']-t['exp1']
    t['chi2'] = (t['obs1']-t['exp1'])**2/t['exp1'] + ((t['n']-t['obs1'])-t['exp0'])**2/t['exp0']
    chi2 = t['chi2'].sum(); df = len(t)-2
    return chi2, df, 1-stats.chi2.cdf(chi2, df)

# ---- Load & clean ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
d = df[df['Sequence number'].notna()].reset_index(drop=True)   # drop 40 empty + 1 whitespace-Age junk row
d['Age'] = d['Age'].astype(str).str.strip().astype(int)         # cast Age to int
d['Remission'] = (d['Efficacy'] == 'PR').astype(int)            # remission = PR
d['Gender'] = (d['Gender'] == 'Male').astype(int)               # Male=1, Female=0
d['BMI'] = pd.to_numeric(d['BMI'])                              # continuous as-is

n = len(d)
print("Records:", n)
print("Remission(PR)=1:", int(d['Remission'].sum()), "| Non-remission(SD+PD)=0:", int((1-d['Remission']).sum()))
print("Gender Male=1:", int(d['Gender'].sum()), "| Female=0:", int((1-d['Gender']).sum()))
print("Missing in model vars:", int(d[['Remission','Age','BMI','Gender']].isna().sum().sum()))

# ---- Fit logistic regression (logit) ----
X = sm.add_constant(d[['Age','BMI','Gender']].astype(float))
y = d['Remission'].astype(float)
model = sm.Logit(y, X).fit(disp=0)
print("\n=== FULL MODEL SUMMARY (logit) ===")
print(model.summary())

# ---- Age coefficient detail ----
b, se, p = model.params['Age'], model.bse['Age'], model.pvalues['Age']
ci = model.conf_int().loc['Age']
print("\n=== AGE COEFFICIENT (change in log-odds of remission per +1 year) ===")
print(f"  coefficient (log-odds): {b:.6f}")
print(f"  standard error:         {se:.6f}")
print(f"  z = b/se:               {b/se:.4f}")
print(f"  p-value:                {p:.6f}")
print(f"  95% CI (log-odds):      [{ci[0]:.6f}, {ci[1]:.6f}]")
print(f"  odds ratio:             {np.exp(b):.6f}  95% CI [{np.exp(ci[0]):.6f}, {np.exp(ci[1]):.6f}]")

# ---- All predictors ----
print("\n=== ALL PREDICTORS ===")
tab = pd.DataFrame({'coef': model.params, 'SE': model.bse, 'z': model.tvalues,
                    'p': model.pvalues, 'CI_low': model.conf_int()[0], 'CI_high': model.conf_int()[1]})
tab['OR'] = np.exp(model.params)
print(tab.round(6).to_string())

# ---- Diagnostics ----
pred = model.predict(X)
c, df_, p = hl_test(y.values, pred.values)
print("\n=== DIAGNOSTICS ===")
print("Pseudo R2:", round(model.prsquared,4), "| N obs:", int(model.nobs),
      "| converged:", model.mle_retvals['converged'], "| LLR p:", round(model.llr_pvalue,4))
print(f"Hosmer-Lemeshow: chi2={c:.4f}, df={df_}, p={p:.4f} (good fit, p>0.05)")
print("Predicted prob range: [%.4f, %.4f]" % (pred.min(), pred.max()))

# ---- Groups confounding (limitation) ----
print("\n=== GROUPS CONFOUNDING (limitation; not a model input) ===")
print(pd.crosstab(d['Groups'], d['Remission']).to_string())
