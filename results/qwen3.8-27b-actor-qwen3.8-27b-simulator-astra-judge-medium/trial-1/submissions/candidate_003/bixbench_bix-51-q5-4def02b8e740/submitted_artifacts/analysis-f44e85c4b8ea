"""
Logistic regression: BMI ~ treatment response (Efficacy).
Question: p-value for the null hypothesis that BMI is not associated
with treatment response.

Outcome: Efficacy dichotomized per RECIST convention:
    PR -> 1 (response), PD/SD -> 0 (non-response)
Predictor: BMI (continuous), plus intercept only (univariate model).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.stats.contrast import WaldTestResults

# ---------- Load and clean ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
# Keep only rows with a valid Sequence number (drops 40 empty rows + 1 junk row)
d = df[df['Sequence number'].notna()].copy()
d['Sequence number'] = d['Sequence number'].astype(int)
print(f"Raw rows read (excl. header): {len(df)}")
print(f"Rows used (valid Sequence number): {len(d)}")

# ---------- Encode outcome ----------
d['response'] = (d['Efficacy'] == 'PR').astype(int)
print("\nOutcome distribution:")
print(d['response'].value_counts().rename({1: 'response (PR)', 0: 'non-response (PD/SD)'}).to_string())
print(f"  PR={int((d['Efficacy']=='PR').sum())}, PD={int((d['Efficacy']=='PD').sum())}, "
      f"SD={int((d['Efficacy']=='SD').sum())}")

# ---------- Sanity checks ----------
print(f"\nBMI: n={d['BMI'].notna().sum()}, missing={d['BMI'].isna().sum()}, "
      f"min={d['BMI'].min()}, max={d['BMI'].max()}, mean={d['BMI'].mean():.3f}")
assert d['BMI'].notna().all() and d['response'].notna().all()

# ---------- Fit univariate logistic regression (BMI only) ----------
X = sm.add_constant(d['BMI'].astype(float))
y = d['response'].astype(float)
model = sm.Logit(y, X)
res = model.fit(method='newton', maxiter=100)

print("\nConvergence status:")
print(f"  converged = {res.converged}, method = {res.method}, iterations = {res.mle_retvals.get("iterations", "n-a")}")

print("\nFull summary():")
print(res.summary())

# ---------- Wald p-value on BMI coefficient ----------
wald = res.wald_test('BMI = 0', scalar=True)
print("\nWald test on BMI coefficient:")
print(f"  statistic = {wald.statistic:.6f}, p-value = {wald.pvalue:.6f}")
wald_p = float(wald.pvalue)

# ---------- Likelihood-ratio cross-check (full vs intercept-only) ----------
from scipy.stats import chi2
null_res = sm.Logit(y, np.ones(len(y))).fit(method='newton', maxiter=100)
lrt_stat = 2.0 * (res.llf - null_res.llf)
lrt_p = float(chi2.sf(lrt_stat, df=1))
print("\nLikelihood-ratio test (full vs intercept-only, chi2 df=1):")
print(f"  log-lik full = {res.llf:.4f}, log-lik null = {null_res.llf:.4f}")
print(f"  statistic = {lrt_stat:.6f}, p-value = {lrt_p:.6f}")

# ---------- Coefficient details ----------
b = res.params['BMI']
se = res.bse['BMI']
z = res.tvalues['BMI']
print("\nBMI coefficient details:")
print(f"  coef = {b:.6f}")
print(f"  std err = {se:.6f}")
print(f"  z = {z:.6f}")
print(f"  P>|z| (Wald) = {res.pvalues['BMI']:.6f}")
print(f"  odds ratio = {np.exp(b):.6f} (95% CI: {np.exp(res.conf_int().loc['BMI',0]):.4f} - {np.exp(res.conf_int().loc['BMI',1]):.4f})")

print("\n" + "="*60)
print(f"ANSWER: n = {len(d)} (41 response / 39 non-response)")
print(f"  Wald p-value (BMI coef)      = {wald_p:.6f}")
print(f"  Likelihood-ratio p-value     = {lrt_p:.6f}")
print("="*60)
