"""
BixBench bix-51-q8: coefficient for age in a simple logistic regression
assessing age and camrelizumab treatment response.

Spec (researcher-approved):
- Use the 80 non-empty rows of data/data.xlsx (Sheet1); drop empty trailing rows.
- Age: convert to numeric, keep continuous (per year).
- Outcome Y: 1 if Efficacy == 'PR' (responder), 0 if SD/PD (non-responder).
  (Groups is a deterministic transform of this coding: Group 1 <-> responder,
   Group 2 <-> non-responder; used only as a sanity check, not as a covariate.)
- Model: Logit Y ~ Age (univariate; Groups NOT included as covariate).
- Report: b1 for Age = change in log-odds of response per year of age.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")

# Keep only populated rows (drop fully-empty trailing rows)
df = df[df["Sequence number"].notna()].copy()
assert len(df) == 80, f"expected 80 real rows, got {len(df)}"

# Age: strings -> numeric, continuous per year
df["Age"] = pd.to_numeric(df["Age"].astype(str).str.strip(), errors="coerce")
assert df["Age"].notna().all(), "unexpected missing Age after cleaning"

# Outcome: PR = 1 (responder), SD/PD = 0 (non-responder)
df["Response"] = (df["Efficacy"] == "PR").astype(int)
print("Outcome counts:", df["Response"].value_counts().to_dict())
print("Age: min=%d max=%d mean=%.2f" % (df["Age"].min(), df["Age"].max(), df["Age"].mean()))

# Sanity check: Groups is a deterministic transform of the response coding
# (Group 1 <-> responder, Group 2 <-> non-responder). Equivalent outcome:
df["Response_from_Gr"] = (df["Groups"] == 1).astype(int)
print("Groups consistent with PR/SD-PD coding:",
      (df["Response_from_Gr"] == df["Response"]).all())

# Simple (univariate) logistic regression: Y ~ Age; NO Groups covariate
X = sm.add_constant(df["Age"])
with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    model = sm.Logit(df["Response"], X).fit(disp=0)
    conv_warnings = [str(w.message) for w in wlist]

print("\n--- Model summary ---")
print(model.summary())

# Cross-check: same model with the Groups-derived outcome (must be identical)
m2 = sm.Logit(df["Response_from_Gr"], X).fit(disp=0)

b1 = model.params["Age"]
se = model.bse["Age"]
ci = model.conf_int().loc["Age"]
print("\n=== RESULT ===")
print(f"Coefficient for Age (change in log-odds per year): {b1:.6f}")
print(f"  SE = {se:.6f}, 95% CI = [{ci[0]:.6f}, {ci[1]:.6f}], p = {model.pvalues['Age']:.4g}")
print(f"  (equivalently, odds ratio per year = {np.exp(b1):.4f})")
print(f"  Cross-check with Groups-derived outcome: b1 = {m2.params['Age']:.6f} "
      f"(identical: {np.isclose(b1, m2.params['Age'])})")
print(f"  Convergence: converged={model.mle_retvals['converged']}, "
      f"iterations={model.mle_retvals.get('iterations')}, "
      f"warnings={conv_warnings if conv_warnings else 'none'}")
