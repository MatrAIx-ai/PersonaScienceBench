"""
Filter Zebra Finch CpG sites by methylation extremity.

Criterion: a site (unique Pos) is KEPT if ANY of its sample rows has
MethylationPercentage > 90 or MethylationPercentage < 10.
Sites that do NOT meet this criterion are REMOVED.

Answer: How many sites are removed?
"""

import pandas as pd

# Load data
df = pd.read_csv("data/ZF_AgeRelated_CpG_noMT_Final.csv")

# --- Step 1: Row-level extreme flag (strict inequalities) ---
extreme = (df["MethylationPercentage"] > 90) | (df["MethylationPercentage"] < 10)
df["is_extreme"] = extreme

# --- Step 2: Group by Pos (site) — boolean OR across samples ---
site_extreme = df.groupby("Pos")["is_extreme"].any()

# --- Step 3: Counts ---
total_sites = len(site_extreme)
kept_sites = int(site_extreme.sum())       # sites with >=1 extreme row
removed_sites = total_sites - kept_sites   # sites with NO extreme row

# --- Step 4: Print results ---
print("=" * 60)
print("ZF_AgeRelated_CpG_noMT_Final.csv — Methylation Filter")
print("=" * 60)
print(f"Total rows in file:              {len(df)}")
print(f"Total unique sites (Pos):        {total_sites}")
print(f"")
print(f"Criterion: MethylationPercentage > 90 OR < 10 (strict)")
print(f"Aggregation: ANY sample row per site (boolean OR)")
print(f"")
print(f"  Sites KEPT   (>=1 extreme row): {kept_sites}")
print(f"  Sites REMOVED (no extreme row): {removed_sites}")
print(f"")
print(f"Sanity check: {kept_sites} + {removed_sites} = {kept_sites + removed_sites}  (expected {total_sites})")
assert kept_sites + removed_sites == total_sites, "Arithmetic mismatch!"
print("Arithmetic verified.")
print("=" * 60)
print(f"ANSWER: {removed_sites} sites are removed.")
print("=" * 60)
