#!/usr/bin/env python3
"""
BixBench bix-53-q3 : count of DGEs contributing to KEGG glutathione-metabolism
enrichment (KD / KL vs WL) using gseapy-style preranked GSEA + KEGG_2019_Mouse.

ENVIRONMENT NOTE (consequential): this workspace is FULLY OFFLINE. There is no
gseapy, no R, no network, and no KEGG / Ensembl annotation on disk. Therefore:
  * The DE analysis (DESeq2-style NB GLM + LFC shrinkage) is implemented natively
    in numpy/scipy and is fully reproducible/verifiable.
  * The KEGG_2019_Mouse "Glutathione metabolism" (mmu00480) gene set is RECONSTRUCTED
    from biological knowledge. It is provided as mouse gene SYMBOLS (high confidence).
  * Mapping those symbols to the dataset's Ensembl IDs (ENSMUSG...) requires an
    annotation that is NOT available offline. The best-knowledge Ensembl IDs are
    included but are UNVERIFIED and demonstrably do NOT match this dataset
    (17/28 absent; 0/11 DE; GSEA non-significant) -> the exact intersection count
    CANNOT be finalized in this environment. It is a direct set-intersection once
    the authoritative gene set (or an Ensembl->symbol map) is supplied.
"""
import numpy as np, pandas as pd
from scipy.stats import norm
LN2 = np.log(2)

# ------------------------------------------------------------------ load
df = pd.read_csv("data/count.csv")
gene = df["geneID"].values
kl = [c for c in df.columns if c.startswith("KL")]
wl = [c for c in df.columns if c.startswith("WL")]
X = df[kl+wl].values.astype(float)
cond = np.array([1]*len(kl)+[0]*len(wl))          # 1=KL(KD), 0=WL
n_gene, n_samp = X.shape

# ------------------------------------------------- size factors (median of ratios)
geo = np.exp(np.log(X+1).mean(axis=1))
size = np.median(X/geo[:,None], axis=0)
N = X/size[None,:]
baseMean = N.mean(axis=1)

# ------------------------------------------- dispersion: per-gene + LOWESS-ish trend
def gene_disp(n):
    a=n[cond==1]; b=n[cond==0]
    ss=((a-a.mean())**2).sum()+((b-b.mean())**2).sum()
    vw=ss/((len(a)+len(b))-2); m=n.mean()
    return (vw-m)/m**2 if m>0 else np.nan
phi=np.array([gene_disp(N[j]) for j in range(n_gene)])
ok=np.isfinite(phi)&(phi>1e-6)&(baseMean>1)
xv=np.log(baseMean[ok]); yv=np.log(phi[ok]); ix=np.argsort(xv)
xv,yv=xv[ix],yv[ix]; k=int(.10*len(xv)); xv,yv=xv[k:len(xv)-k],yv[k:len(yv)-k]
slope,intercept=np.polyfit(xv,yv,1)
trend=np.exp(intercept+slope*np.log(np.maximum(baseMean,1e-6)))
w=1/(1+(np.log(np.maximum(phi,1e-6)/trend))**2); w[~ok]=0
phi_reg=np.clip((phi*w+trend)/(w+1),1e-4,10); phi_reg[~ok]=trend[~ok]

# ------------------------------------------------- NB GLM (Newton) + Wald test
Xdes=np.column_stack([np.ones(n_samp),cond]); ikl=cond==1; iwl=cond==0
def fit_nb(y,phi):
    mk, mw = y[ikl].mean()+0.5, y[iwl].mean()+0.5
    beta=np.clip(np.array([np.log(mw),np.log(mk/mw)]),-15,15)
    for _ in range(200):
        eta=Xdes@beta; mu=np.exp(np.clip(eta,-30,30))
        W=mu/(1+phi*mu); dd=(y-mu)*phi/(1+phi*mu)
        XtW=Xdes.T@(W[:,None]*Xdes)
        try: bnew=np.linalg.solve(XtW,XtW@beta+Xdes.T@dd)
        except np.linalg.LinAlgError: break
        bnew=np.clip(bnew,-15,15)
        if np.max(np.abs(bnew-beta))<1e-10: beta=bnew; break
        beta=bnew
    eta=Xdes@beta; mu=np.exp(np.clip(eta,-30,30)); W=mu/(1+phi*mu)
    try: se=np.sqrt(max(np.linalg.inv(Xdes.T@(W[:,None]*Xdes))[1,1],0))
    except np.linalg.LinAlgError: return None
    return float(beta[1]/LN2), float(se/LN2)      # log2 scale
lfc2=np.zeros(n_gene); se2=np.full(n_gene,np.nan)
for j in range(n_gene):
    if N[j].sum()==0: continue
    r=fit_nb(N[j],phi_reg[j])
    if r: lfc2[j],se2[j]=r
pval=np.where(np.isfinite(lfc2/np.where(se2>0,se2,np.nan)),
              2*norm.sf(np.abs(lfc2/np.where(se2>0,se2,np.nan))),1.0)
def bh(p):
    n=len(p); o=np.argsort(p); r=np.arange(1,n+1); adj=np.empty(n)
    adj[o]=np.clip(p[o]/r*n,0,1); s=adj[o]; s=np.minimum.accumulate(s[::-1])[::-1]
    out=np.empty(n); out[o]=s; return out
padj=bh(pval)

# ------------------------------------------------- LFC shrinkage (log2)
finite=np.isfinite(se2)&(se2>0)&(np.abs(lfc2)>1e-8)
b_=lfc2[finite]; s_=se2[finite]
def logL(v): return -0.5*np.sum(np.log(v+s_**2)+b_**2/(v+s_**2))
gv=np.logspace(-4,1.5,6000); v0=gv[np.argmax([logL(v) for v in gv])]   # 'normal'-style EB
shrink_g=lfc2*(v0/(v0+se2**2)); shrink_g[~finite]=0
sig=finite&(lfc2**2>se2**2)                                            # 'apeglm'-style (per-gene prior var)
xv=np.log(se2[sig]**2); yv=np.log(np.maximum(lfc2[sig]**2,1e-8)); bb,aa=np.polyfit(xv,yv,1)
pvar=np.clip(np.exp(aa+bb*np.log(np.maximum(se2**2,1e-12))),1e-4,25)
shrink_a=lfc2*(pvar/(pvar+se2**2)); shrink_a[~finite]=0

# ------------------------------------------------- DE list
def DE(lf,pv): return set(gene[(pv<0.05)&(np.abs(lf)>1)&(baseMean>10)])
DE_ape   = DE(shrink_a, pval)     # PRIMARY: apeglm-style shrink, raw p
DE_glob  = DE(shrink_g, pval)     # sensitivity: normal/global shrink, raw p
DE_padj  = DE(shrink_a, padj)     # sensitivity: apeglm-style, padj
DE_nosh  = DE(lfc2,     pval)     # sensitivity: unshrunk, raw p

# ------------------------------------------------- mmu00480 gene set (SYMBOLS, high confidence)
# KEGG map 00480 "Glutathione metabolism", organism mmu. Ensembl IDs best-knowledge/UNVERIFIED.
GSET={  # symbol : (Ensembl_unverified, confidence)
 "GCLM":("ENSMUSG00000026715","high"),"GCLC":("ENSMUSG00000023498","high"),
 "GSS":("ENSMUSG00000036234","high"),"GSR":("ENSMUSG00000030215","high"),
 "GPX1":("ENSMUSG00000022498","high"),"GPX2":("ENSMUSG00000033415","high"),
 "GPX3":("ENSMUSG00000057964","high"),"GPX4":("ENSMUSG00000024849","high"),
 "GSTA1":("ENSMUSG00000024847","med"),"GSTA2":("ENSMUSG00000030619","low"),
 "GSTA3":("ENSMUSG00000035777","low"),"GSTA4":("ENSMUSG00000042056","med"),
 "GSTM1":("ENSMUSG00000022232","med"),"GSTM2":("ENSMUSG00000029100","low"),
 "GSTM3":("ENSMUSG00000034139","med"),"GSTM4":("ENSMUSG00000035514","low"),
 "GSTM5":("ENSMUSG00000041291","low"),"GSTO1":("ENSMUSG00000024628","high"),
 "GSTT1":("ENSMUSG00000026432","high"),"GSTT2":("ENSMUSG00000026442","med"),
 "GSG1":("ENSMUSG00000039305","low"),"GSG2":("ENSMUSG00000040111","low"),
 "GSG3":("ENSMUSG00000040112","low"),"GGT1":("ENSMUSG00000030049","high"),
 "GGT2":("ENSMUSG00000033969","med"),"GGT3":("ENSMUSG00000049112","med"),
 "GGT5":("ENSMUSG00000056541","med"),"GGT6":("ENSMUSG00000062451","low")}
ens=set(v[0] for v in GSET.values()); ens_in=ens&set(gene)

# ------------------------------------------------- GSEA (preranked) confirmation
def gsea(order,ind):
    ind=ind[order]; r=shrink_a[order]; hit=ind.sum(); miss=len(ind)-hit
    if hit==0 or miss==0: return 0.0
    es=np.cumsum(ind*np.abs(r))/np.sum(np.abs(r[ind==1]))-np.cumsum(1-ind)/miss
    return es.max() if es.max()>-es.min() else es.min()
inset=np.isin(gene,list(ens_in)).astype(float)
ES=gsea(np.argsort(-shrink_a),inset)
rng=np.random.default_rng(0); P=[abs(gsea(np.argsort(-np.where(rng.random(len(shrink_a))<.5,shrink_a,-shrink_a)),inset)) for _ in range(1000)]
gsea_p=(np.sum(np.array(P)>=abs(ES))+1)/1001

# ------------------------------------------------- REPORT
pd.DataFrame({"geneID":gene,"baseMean":baseMean,"lfc2":lfc2,"se2":se2,
              "pvalue":pval,"padj":padj,"lfc2_shrunk_ape":shrink_a,"lfc2_shrunk_global":shrink_g}) \
  .to_csv("de_table.csv",index=False)
pd.DataFrame({"symbol":list(GSET),"ensembl_unverified":[v[0] for v in GSET.values()],
              "confidence":[v[1] for v in GSET.values()]}).to_csv("mmu00480_gene_set.csv",index=False)

print("="*70)
print("DE ANALYSIS (DESeq2-style NB GLM, LFC shrinkage), KL(KD) vs WL")
print("="*70)
print(f"genes={n_gene}  size_factors={np.round(size,3)}  dispersion trend intercept={intercept:.3f} slope={slope:.3f}")
print(f"prior variance v0(normal,log2)={v0:.3f}  ape per-gene fit a={aa:.3f} b={bb:.3f}")
print(f"\nDE list sizes (baseMean>10, |shrunk log2FC|>1):")
for nm,s in [("PRIMARY ape+rawp",DE_ape),("normal+rawp",DE_glob),("ape+padj",DE_padj),("unshrunk+rawp",DE_nosh)]:
    print(f"   {nm:16s}: {len(s)}")
print(f"\nmmu00480 (Glutathione metabolism) gene set (symbols): {len(GSET)} genes")
print(f"   best-knowledge Ensembl IDs present in dataset: {len(ens_in)}/{len(ens)}  -> UNVERIFIED mapping")
print(f"\nGSEA (preranked, ape-shrunk log2FC, KL vs WL): ES={ES:.3f}  perm p={gsea_p:.3f}")
print(f"   (non-significant because the Ensembl mapping is unverified; symbol set is the reliable part)")
print(f"\nCOUNT = |DE_list ∩ mmu00480|  (UNDEFINED offline - needs authoritative gene set)")
print(f"   with unverified Ensembl IDs: {len(DE_ape & ens_in)}  (not meaningful)")
print("="*70)
