#!/usr/bin/env python3
"""
bix-53-q6 : UBE2M knockdown (KD) DEG + GSEA (KEGG_2019_Mouse)
============================================================
Pipeline (per approved plan):
  1) DEG from RAW counts, DESeq2-equivalent (R/DESeq2/apeglm unavailable in this sandbox):
       - size factors (median-of-ratios), baseMean = mean of size-factor-normalized counts
       - per-gene negative-binomial GLM (statsmodels), per-gene dispersion shrunk toward common
       - raw (unadjusted) Wald p-value  [primary, per task wording]  + BH-adjusted [supplement]
       - log2FC shrinkage: empirical-Bayes normal prior (apeglm-like approximation)
  2) DEG filter: raw p<0.05 AND |shrunk log2FC|>1 AND baseMean>10  (reported for context)
  3) GSEA on the FULL ranked list (all genes ranked by shrunk log2FC, KD direction):
       PRIMARY  : gseapy.prerank(rnk, gene_sets="KEGG_2019_Mouse")
       FALLBACK : manual classic GSEA (KS running-sum ES + label permutation) if gseapy is
                  unavailable AND a KEGG_2019_Mouse .gmt is provided (env KEGG_GMT).
  4) Report the single most-significantly enriched pathway: name, NES, raw p-value.

KD DIRECTION: default KL = KD, WL = control (naming convention). The UBE2M Ensembl ID is not
confirmable in-data (no symbol column / offline reference), so this default is used; the
UBE2M candidate's expression is reported as a sensitivity note.
"""
import warnings, os, sys, logging, time
warnings.filterwarnings("ignore")
import pandas as pd, numpy as np
from statsmodels.genmod.families import NegativeBinomial
from statsmodels.genmod.generalized_linear_model import GLM
from scipy.stats import norm
logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
log = logging.getLogger("ube2m")

COUNTS   = "data/count.csv"
KL, WL   = ["KL1","KL2","KL3"], ["WL1","WL2","WL3"]
KD_COLS, CTRL_COLS = KL, WL                 # DEFAULT direction (see docstring)
UBE2M_CAND = ["ENSMUSG00000032462"]          # from memory, UNVERIFIED (sensitivity only)
GSEA_PERM  = 1000
KEGG_GMT   = os.environ.get("KEGG_GMT", "")  # optional local .gmt for the fallback

# ---------------------------------------------------------------- load
df = pd.read_csv(COUNTS)
log.info("Loaded %d genes x %d cols", df.shape[0], df.shape[1])

# KD direction sensitivity note via UBE2M candidate (not used to override default)
for uid in UBE2M_CAND:
    r = df[df.geneID==uid]
    if len(r):
        row=r.iloc[0]
        m_kl=row[KL].mean(); m_wl=row[WL].mean()
        log.info("UBE2M candidate %s: mean KL=%.1f vs WL=%.1f (lower-UBE2M group=%s)",
                 uid, m_kl, m_wl, "KL" if m_kl<m_wl else "WL")

# ---------------------------------------------------------------- DEG
counts = df[KD_COLS+CTRL_COLS].to_numpy(dtype=float)
g = np.array([1]*len(KD_COLS)+[0]*len(CTRL_COLS)); n=len(df)

gm = np.median(counts,axis=1); use = gm>0
sf = np.median(counts[use]/gm[use][:,None], axis=0)
normc = counts/sf[None,:]; baseMean = normc.mean(axis=1)
d0 = float(np.median([max(0.0,(normc[i].var(ddof=1)-normc[i].mean())/normc[i].mean()**2)
                      for i in range(n) if normc[i].mean()>0]))
X = np.column_stack([np.ones(6), g]); off = np.log(sf); ln2 = np.log(2.0); n0 = 10.0
def fit(y, alpha): return GLM(y, X, family=NegativeBinomial(alpha=alpha), offset=off).fit()

lfc2 = np.full(n,np.nan); se2 = np.full(n,np.nan); pval = np.full(n,np.nan)
t0=time.time()
for i in range(n):
    y = counts[i]
    if y.sum()==0: continue
    try:
        r0 = fit(y, d0); mu = r0.mu
        d_i = max(0.0, d0 + (((y-mu)**2)/(mu*(1+d0*mu))).mean() - 1.0)
        d_i = (d_i + n0*d0)/(n0+1.0)                       # shrink toward common (3 reps)
        r = fit(y, d_i)
        if not np.isfinite(r.bse[1]) or r.bse[1]<=0: continue
        lfc2[i]=r.params[1]/ln2; se2[i]=r.bse[1]/ln2
        pval[i]=2*(1-norm.cdf(abs(r.params[1]/r.bse[1])))
    except Exception as e:
        pass
log.info("NB-GLM DEG done in %.1fs; finite genes=%d (d0=%.4f)", time.time()-t0, int(np.isfinite(lfc2).sum()), d0)

# BH (supplement)
fin = np.where(np.isfinite(pval))[0]; order = fin[np.argsort(pval[fin])]
p_s = pval[order]; rk = np.arange(1,len(p_s)+1)
q = np.minimum.accumulate((p_s*(len(p_s)/rk))[::-1])[::-1]
padj = np.full(n,np.nan); padj[order]=np.clip(q,0,1)

# EB normal-prior shrinkage (apeglm-like approximation)
valid = np.isfinite(lfc2)&(se2>0); well = valid&(se2<=np.median(se2[valid]))
s0 = float(np.clip(np.quantile(np.abs(lfc2[well]),0.9),0.5,3.0))
shrink = np.full(n,np.nan); shrink[valid]=lfc2[valid]*s0**2/(s0**2+se2[valid]**2)
log.info("shrinkage prior SD s0=%.3f", s0)

res = pd.DataFrame({"geneID":df.geneID,"baseMean":baseMean,"log2FC_raw":lfc2,
                    "log2FC_shrunk":shrink,"pvalue":pval,"padj":padj})
res.to_csv("deg_results.csv", index=False)
deg = res[(res.pvalue<0.05)&(res.log2FC_shrunk.abs()>1)&(res.baseMean>10)]
log.info("DEG (raw p<.05 & |shrunk lfc|>1 & baseMean>10): %d (up %d / down %d); padj<.05: %d",
         len(deg), int((deg.log2FC_shrunk>0).sum()), int((deg.log2FC_shrunk<0).sum()), int((deg.padj<0.05).sum()))

# full ranked list by shrunk log2FC (KD direction); NaNs last (rank 0)
ranked = res.set_index("geneID")["log2FC_shrunk"].fillna(0.0)
ranked_series = ranked.sort_values(ascending=False)

# ---------------------------------------------------------------- GSEA (PRIMARY: gseapy)
def pick_top(result_df):
    dfx = result_df.copy()
    pcol = next((c for c in ["pvalue","enrichment_pvalue","pval","NES_norm"] if c in dfx.columns), None)
    tcol = "term" if "term" in dfx.columns else dfx.columns[0]
    ncol = next((c for c in ["NES","NES_norm"] if c in dfx.columns), None)
    dfx = dfx.dropna(subset=[pcol]) if pcol else dfx
    top = dfx.sort_values(pcol).head(1) if pcol else dfx.head(1)
    return top

gsea_done = False
try:
    import gseapy as gp
    log.info("gseapy %s present -> primary path", getattr(gp,"__version__","?"))
    r = gp.prerank(rnk=ranked_series, gene_sets="KEGG_2019_Mouse",
                   outdir="gsea_out", processes=1, min_size=10, max_size=500,
                   permutation_num=GSEA_PERM)
    out = getattr(r, "out_df", None)
    if out is None:
        try: out = pd.DataFrame(r)
        except Exception: out = r
    top = pick_top(out)
    t = top.iloc[0]
    name = t.get("term", t.iloc[0])
    nes  = t.get("NES", np.nan)
    pvalg= t.get("pvalue", t.get("enrichment_pvalue", np.nan))
    log.info("GSEA TOP PATHWAY = %s | NES=%s | raw p=%s", name, nes, pvalg)
    out.to_csv("gsea_results.csv", index=False)
    print("\n===== GSEA (gseapy, KEGG_2019_Mouse) =====")
    print("MOST SIGNIFICANT PATHWAY:", name)
    print("NES:", nes, " raw p-value:", pvalg)
    gsea_done = True
except ImportError as e:
    log.warning("gseapy NOT importable: %s -> attempting one-time pip install (network permitting)", e)
    try:
        import subprocess
        subprocess.run([sys.executable,"-m","pip","install","--quiet","gseapy"],
                       timeout=180, check=False)
        import importlib; importlib.invalidate_caches()
        import gseapy as gp
        log.info("gseapy installed at runtime %s -> primary path", getattr(gp,"__version__","?"))
        r = gp.prerank(rnk=ranked_series, gene_sets="KEGG_2019_Mouse",
                       outdir="gsea_out", processes=1, min_size=10, max_size=500,
                       permutation_num=GSEA_PERM)
        out = getattr(r,"out_df",None)
        if out is None:
            try: out = pd.DataFrame(r)
            except Exception: out = r
        top = pick_top(out); t=top.iloc[0]
        print("\n===== GSEA (gseapy, KEGG_2019_Mouse) =====")
        print("MOST SIGNIFICANT PATHWAY:", t.get("term",t.iloc[0]))
        print("NES:", t.get("NES",np.nan), " raw p-value:", t.get("pvalue",t.get("enrichment_pvalue",np.nan)))
        out.to_csv("gsea_results.csv", index=False); gsea_done=True
    except Exception as e2:
        log.warning("runtime gseapy install/primary failed: %s -> attempting manual fallback", e2)
except Exception as e:
    log.warning("gseapy primary path failed: %s -> attempting manual fallback", e)

# ---------------------------------------------------------------- GSEA (FALLBACK: manual classic GSEA)
def parse_gmt(path):
    gs={}
    with open(path) as fh:
        for line in fh:
            parts=line.rstrip("\n").split("\t")
            if len(parts)<3: continue
            gs[parts[0]]=set(parts[2:])
    return gs

def classic_gsea(rank_series, gene_sets, n_perm=1000, seed=42):
    """fgsea-style classic GSEA (KS running sum, normalized hit/miss mass, label permutation)."""
    genes=list(rank_series.index); m=rank_series.to_numpy(dtype=float)
    order=np.argsort(-m); m_ord=m[order]
    abs_m=np.abs(m_ord); abs_sum=abs_m.sum()
    hit_w=abs_m/abs_sum; miss_w=1-abs_m/abs_sum
    rng=np.random.default_rng(seed); out=[]
    def rs_of(in_set):
        s=in_set[order]
        hs=hit_w[s].sum(); ms=miss_w[~s].sum()
        hit_p=np.where(s, hit_w/(hs if hs>0 else 1), 0.0)
        miss_p=np.where(~s, miss_w/(ms if ms>0 else 1), 0.0)
        return np.cumsum(hit_p-miss_p)
    for name,members in gene_sets.items():
        in_set=np.isin(genes,list(members))
        if in_set.sum()<5: continue
        rs=rs_of(in_set); ep,eneg=rs.max(),rs.min()
        es=ep if abs(ep)>=abs(eneg) else eneg
        null=[]
        for _ in range(n_perm):
            rp=rs_of(rng.permutation(in_set)); null.append(rp.max() if es>0 else rp.min())
        null=np.array(null)
        p=(np.sum(null>=es)+1)/(len(null)+1) if es>0 else (np.sum(null<=es)+1)/(len(null)+1)
        ss=null[null>0] if es>0 else null[null<0]
        nes=es/np.mean(np.abs(ss)) if len(ss) else np.nan
        out.append({"term":name,"NES":nes,"size":int(in_set.sum()),"pvalue":p})
    return pd.DataFrame(out)

if not gsea_done:
    if KEGG_GMT and os.path.exists(KEGG_GMT):
        log.info("Manual classic GSEA fallback using %s", KEGG_GMT)
        gs=parse_gmt(KEGG_GMT)
        mf=classic_gsea(ranked_series, gs, n_perm=GSEA_PERM)
        mf=mf.sort_values("pvalue"); mf.to_csv("gsea_results_manual.csv",index=False)
        t=mf.iloc[0]
        print("\n===== GSEA (manual fallback, KEGG_2019_Mouse) =====")
        print("MOST SIGNIFICANT PATHWAY:", t["term"], "| NES:", round(t["NES"],3), "| raw p:", t["pvalue"])
        gsea_done=True
    else:
        log.error("Manual fallback blocked: no KEGG_2019_Mouse .gmt found (set KEGG_GMT) and gseapy unavailable.")
        print("\n===== GSEA STATUS =====")
        print("BLOCKED in this environment: gseapy not importable AND no KEGG_2019_Mouse gene-set "
              "source available (no network / no local cache). The primary gseapy path will run in "
              "the provisioned runner. Provide a KEGG_2019_Mouse .gmt via KEGG_GMT to enable the fallback.")

print("\nDEG summary: %d genes; %d significant DEG (raw p<.05 & |shrunk lfc|>1 & baseMean>10)." % (n, len(deg)))
print("KD direction used: %s=KD, %s=control" % (KD_COLS, CTRL_COLS))
