#!/usr/bin/env python3
"""Align each .faa file with MAFFT --auto and compute the percentage of gap
characters relative to total alignment positions across all alignments.

Assumptions (approved by researcher):
  1. Each .faa file = one separate alignment (align the sequences within the file).
  2. Gap characters = only the MAFFT '-' symbol.
  3. Total alignment positions = sum over alignments of (n_seqs x alignment_length).
"""
import glob, os, shutil, subprocess, sys, json

DATA_DIR = "data"
OUT_DIR = "aligned"
STD_AA = set("ACDEFGHIKLMNPQRSTVWY")

def parse_fasta(path):
    seqs = []
    name = None
    buf = []
    with open(path) as fh:
        for line in fh:
            line = line.rstrip("\n")
            if line.startswith(">"):
                if name is not None:
                    seqs.append((name, "".join(buf)))
                name = line[1:].strip()
                buf = []
            elif line.strip():
                buf.append(line.strip())
    if name is not None:
        seqs.append((name, "".join(buf)))
    return seqs

def run_mafft(in_path, out_path):
    """Invoke mafft --auto. Returns (ok, message)."""
    if shutil.which("mafft") is None:
        return False, "mafft executable not found on PATH (MAFFT unavailable at execution time)"
    try:
        proc = subprocess.run(
            ["mafft", "--auto", in_path],
            stdout=open(out_path, "w"),
            stderr=subprocess.PIPE,
            text=True,
            timeout=600,
        )
    except Exception as e:
        return False, f"mafft invocation raised: {e}"
    if proc.returncode != 0:
        return False, f"mafft returned {proc.returncode}: {proc.stderr.strip()[:500]}"
    return True, "ok"

def parse_alignment(path):
    seqs = []
    name = None
    buf = []
    with open(path) as fh:
        for line in fh:
            line = line.rstrip("\n")
            if line.startswith(">"):
                if name is not None:
                    seqs.append((name, "".join(buf)))
                name = line[1:].strip()
                buf = []
            elif line.strip():
                buf.append(line.strip())
    if name is not None:
        seqs.append((name, "".join(buf)))
    return seqs

def main():
    files = sorted(glob.glob(os.path.join(DATA_DIR, "*.faa")))
    print(f"Found {len(files)} .faa files")
    os.makedirs(OUT_DIR, exist_ok=True)

    total_gaps = 0
    total_positions = 0
    per_file = []
    mafft_ok = True

    for f in files:
        seqs = parse_fasta(f)
        base = os.path.splitext(os.path.basename(f))[0]
        out_path = os.path.join(OUT_DIR, base + ".aln")

        ok, msg = run_mafft(f, out_path)
        if not ok:
            print(f"[{base}] MAFFT UNAVAILABLE/FAILED: {msg}")
            mafft_ok = False
            per_file.append({"file": base, "nseq": len(seqs), "status": "mafft_failed",
                             "message": msg})
            continue

        aln = parse_alignment(out_path)
        nseq = len(aln)
        lengths = [len(s) for _, s in aln]
        if len(set(lengths)) != 1:
            print(f"[{base}] WARNING: inconsistent alignment lengths {set(lengths)}")
        alen = lengths[0]
        npos = nseq * alen
        ngap = sum(1 for _, s in aln for c in s if c == "-")
        total_gaps += ngap
        total_positions += npos
        per_file.append({"file": base, "nseq": nseq, "align_length": alen,
                         "positions": npos, "gaps": ngap})
        print(f"[{base}] nseq={nseq} align_length={alen} positions={npos} gaps={ngap}")

    result = {
        "mafft_available": mafft_ok,
        "total_gaps": total_gaps,
        "total_positions": total_positions,
        "per_file": per_file,
    }
    with open("result.json", "w") as fh:
        json.dump(result, fh, indent=2)

    if not mafft_ok:
        print("\nRESULT: MAFFT was NOT available (or failed) at execution time.")
        print("No percentage could be computed because the required aligner "
              "(MAFFT --auto) could not be run. Not substituting another aligner.")
        print(f"total_gaps={total_gaps} total_positions={total_positions} (partial, likely 0)")
        return

    pct = 100.0 * total_gaps / total_positions if total_positions else float("nan")
    print(f"\nTOTAL gaps={total_gaps} positions={total_positions}")
    print(f"PERCENTAGE of gap characters relative to total alignment positions = {pct:.2f}%")

if __name__ == "__main__":
    main()
