"""
BixBench bix-7-q2: Average number of CHIP variants per sample after filtering
out intronic, intergenic, and UTR variants.

Method (researcher-approved):
- Each xlsx in data/CHIP_DP10_GQ20_PASS/ is a CHIP-targeted variant set for one sample.
- Variant rows = Zygosity in {Heterozygous, Homozygous Variant} (excludes Reference and blank/NaN).
- Exclude rows whose 'Sequence Ontology (Combined)' (level-2 header) contains any of:
  intron_variant, intergenic_variant, 3_prime_UTR, 5_prime_UTR
  (substring match; field is verified single-valued; '5_prime_UTR' also catches
   5_prime_UTR_premature_start_codon_gain_variant).
- Per-sample count -> average over all 86 samples.
Columns are selected by level-2 header name because level-1 labels vary per file
(e.g. 'Proband (179-P1)' vs 'Father (SRR5456232)').
"""
import glob
import os
import pandas as pd

DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "data", "CHIP_DP10_GQ20_PASS")
EXCLUDE_SUBSTRINGS = ("intron_variant", "intergenic_variant",
                      "3_prime_UTR", "5_prime_UTR")
VARIANT_ZYGOSITIES = {"Heterozygous", "Homozygous Variant"}

files = sorted(glob.glob(os.path.join(DATA_DIR, "*.xlsx")))
per_sample = {}
for f in files:
    sample_id = os.path.basename(f)[:-5].split("_")[-1]
    df = pd.read_excel(f, header=[0, 1])
    df.columns = [c[1] for c in df.columns]  # collapse to level-2 names
    is_variant = df["Zygosity"].isin(VARIANT_ZYGOSITIES)
    so = df["Sequence Ontology (Combined)"].fillna("")
    excluded = so.str.contains("|".join(EXCLUDE_SUBSTRINGS), regex=True)
    per_sample[sample_id] = int((is_variant & ~excluded).sum())

result = pd.Series(per_sample).sort_index()
print("Per-sample CHIP variant counts (after removing intronic/intergenic/UTR):")
print(result.to_string())
print()
print(f"Number of samples: {len(result)}")
print(f"Min: {result.min()}  Max: {result.max()}  Median: {result.median()}")
print(f"Sum: {result.sum()}")
mean = result.mean()
print()
print(f"MEAN CHIP variants per sample: {mean:.4f}")
print(f"FINAL ANSWER: {mean:.2f}")
