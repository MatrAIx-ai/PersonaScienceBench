"""
CHIP dataset: count unique CHIP variants remaining after removing reference calls.

Method (approved plan):
- All 86 xlsx in data/CHIP_DP10_GQ20_PASS, single sheet each, openpyxl NORMAL mode
  (read_only mode has broken stored dimensions for 84/86 files).
- 2-row merged header: column names from row 2, data from row 3.
- Unique variant key = 'Chr:Pos|Ref/Alt' (col A + col B).
- Call = 'Zygosity' (col E): 'Reference' | 'Heterozygous' | 'Homozygous Variant' | None(uncalled).
- Remove rows with Zygosity == 'Reference'; a variant REMAINS if it has >=1
  Heterozygous or Homozygous Variant call in any of the 86 files (all roles).
- In-file duplicate rows deduplicated by key (they never mix zygosity values within a key).
Auxiliary: total remaining non-reference rows; sensitivity for the 75 rows with
None zygosity but present DP (all at biallelic positions).
"""
import openpyxl, glob, os
from collections import defaultdict

DATA = '/workspace/data/CHIP_DP10_GQ20_PASS'
files = sorted(glob.glob(os.path.join(DATA, '*.xlsx')))
assert len(files) == 86, f"expected 86 files, got {len(files)}"

key_calls = defaultdict(set)          # key -> set of zygosity values seen
key_none_with_dp = defaultdict(int)   # key -> # None-zygosity rows that DO have DP
total_rows = 0
ref_rows = 0
nonref_rows = 0

for f in files:
    wb = openpyxl.load_workbook(f, data_only=True)   # normal mode (NOT read_only)
    ws = wb.active
    sample = ws.cell(row=1, column=5).value          # merged group title, e.g. 'Proband (380-P)'
    # sanity: row-2 header
    hdr = [ws.cell(row=2, column=c).value for c in range(1, 34)]
    assert hdr[0] == 'Chr:Pos' and hdr[1] == 'Ref/Alt' and hdr[4] == 'Zygosity', (f, hdr[:5])
    n = 0
    for row in ws.iter_rows(min_row=3, values_only=True):
        if row[0] is None and row[1] is None:
            continue
        total_rows += 1; n += 1
        zyg = row[4]
        key = f"{row[0]}|{row[1]}"
        key_calls[key].add(zyg)
        if zyg is None and row[7] is not None:       # Read Depths (DP) present
            key_none_with_dp[key] += 1
        if zyg == 'Reference':
            ref_rows += 1
        elif zyg in ('Heterozygous', 'Homozygous Variant'):
            nonref_rows += 1
        elif zyg is None:
            pass  # uncalled: neither reference nor a variant call
        else:
            raise ValueError(f"unexpected zygosity {zyg!r} in {f}")
    wb.close()

all_keys = set(key_calls)
print(f"files processed: {len(files)}")
print(f"total data rows: {total_rows}")
print(f"distinct variant keys (Chr:Pos|Ref/Alt): {len(all_keys)}")
print(f"reference rows removed: {ref_rows}")
print(f"remaining non-reference rows (Het+HomVar): {nonref_rows}")

# PRIMARY: unique keys with >=1 non-reference call after removing Reference rows
remaining = {k for k, z in key_calls.items()
             if z & {'Heterozygous', 'Homozygous Variant'}}
print(f"\nANSWER: unique CHIP variants remaining after removing reference calls: {len(remaining)}")

# sensitivity: keys that would ONLY be 'saved' by treating None-with-DP as a call
sens = [k for k, z in key_calls.items()
        if not (z & {'Heterozygous', 'Homozygous Variant'}) and key_none_with_dp.get(k, 0) > 0]
print(f"\nsensitivity: keys with NO Het/HomVar call but >=1 None-zygosity row with DP: {len(sens)}")
for k in sorted(sens):
    print("  ", k, "zygosities seen:", key_calls[k], "none_with_dp:", key_none_with_dp[k])

# biallelic position check vs 707-key base
pos = defaultdict(set)
for k in all_keys:
    p, ra = k.split('|', 1)
    pos[p].add(ra)
bial = {p: ras for p, ras in pos.items() if len(ras) > 1}
print(f"\npositions with >1 Ref/Alt: {len(bial)}")
for p, ras in sorted(bial.items()):
    for ra in sorted(ras):
        k = f"{p}|{ra}"
        print(f"  {k}: zyg={sorted(x for x in key_calls[k] if x is not None)} remaining={k in remaining}")
