"""
Independence test: m6A methylation status vs differential expression status
(bladder cancer MeRIP-seq / RNA-seq dataset, data/MeRIP_RNA_result.xlsx).

Primary:   3x3 chi-squared test of independence
           (rows = m6A: Hyper/Hypo/no sig; cols = DEG: Up/Down/no-DEGs)
Sensitivity: 2x2 Fisher's exact test
           (m6A-sig = Hyper+Hypo vs no sig; DEG-sig = Up+Down vs no-DEGs)

Uses the pre-computed 'm6A' and 'DEG' columns directly. These were verified
to be consistent with a p < 0.05 threshold on 'm_pvalue' and 'g_pvalue'
respectively (sig labels max p = 0.0499; non-sig min p = 0.05001).

Limitation: rows are transcript/region-level, not gene-level (up to 16 rows
per transcript; 9,473 unique transcripts across 3,117 genes). The chi-squared
test treats each row as an independent observation; this is the intended
row-level analysis and no gene-level aggregation is performed.
"""
import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

XLSX = "data/MeRIP_RNA_result.xlsx"
SHEET = "Date Formatting"

df = pd.read_excel(XLSX, sheet_name=SHEET)
assert df["m6A"].notna().all() and df["DEG"].notna().all(), "unexpected missing labels"

# ---------- Primary: 3x3 chi-squared ----------
table3 = pd.crosstab(df["m6A"], df["DEG"])
# Fixed category order for readability
table3 = table3.reindex(index=["m6A Hyper", "m6A Hypo", "m6A no sig"],
                        columns=["Up", "Down", "no-DEGs"])
print("3x3 contingency table (rows=m6A, cols=DEG):")
print(table3.to_string())
print()

chi2, p3, dof, expected = chi2_contingency(table3)
print(f"Chi2 statistic = {chi2:.4f}, dof = {dof}")
print(f"3x3 chi-squared p-value = {p3:.6e}")
print(f"Min expected cell count = {expected.min():.2f} (all > 5, chi2 valid)")
print()

# ---------- Sensitivity: 2x2 Fisher's exact ----------
m_sig = df["m6A"].isin(["m6A Hyper", "m6A Hypo"])
d_sig = df["DEG"].isin(["Up", "Down"])
table2 = pd.crosstab(m_sig, d_sig)
table2.index = ["m6A no sig", "m6A sig"]
table2.columns = ["no-DEGs", "DEG sig (Up/Down)"]
print("2x2 contingency table (rows=m6A sig?, cols=DEG sig?):")
print(table2.to_string())
print()

oddsr, p2 = fisher_exact(table2)
print(f"Odds ratio = {oddsr:.4f}")
print(f"2x2 Fisher's exact p-value = {p2:.6e}")
print()
print(f"FINAL (primary): {p3:.6e}")
print(f"FINAL (sensitivity): {p2:.6e}")
