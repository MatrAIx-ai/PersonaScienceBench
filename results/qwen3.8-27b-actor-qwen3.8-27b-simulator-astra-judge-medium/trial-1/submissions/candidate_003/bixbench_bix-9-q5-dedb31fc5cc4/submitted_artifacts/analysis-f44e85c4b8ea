#!/usr/bin/env python3
"""
Final analysis: BixBench bix-9-q5
Question: In which tissue type do bad responders show the highest number of
significantly differentially expressed (lfc>0.5 and basemean>10) genes
compared to controls?

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx, sheet 'NormCount'
- 4 header rows (0-3); real header on row 3; 25402 gene rows.
- Precomputed DESeq2 comparisons (outliers excluded); each block of 9 cols:
  baseMean, baseMeanA, baseMeanB, foldChange, log2FoldChange, pval, padj,
  Max DEG, Median DEG.
- Verified mapping (log-geomean matching of baseMeanA/B vs sample columns):
    baseline_blood bad_responder vs Control -> DESeq Comparison 1
    dentate_gyrus  bad_responder vs Control -> DESeq Comparison 4
    final_blood    bad_responder vs Control -> DESeq Comparison 7
  lfc = log2(bad_responder / Control) (DESeq2 convention, A = numerator).

Column indices are derived from the header row (row 3) and asserted, to
avoid off-by-one errors (foldChange and log2FoldChange are adjacent).

Rule: count genes with log2FoldChange > 0.5 (strict) AND baseMean > 10 (strict).
Non-numeric ('-') lfc values fail the threshold (excluded).
"""
import openpyxl

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# tissue -> DESeq comparison number that is bad_responder vs Control
COMPARISON = {"baseline_blood": 1, "dentate_gyrus": 4, "final_blood": 7}

def find_columns(header0, header3):
    """Map each DESeq comparison to its baseMean / log2FoldChange columns.
    Block starts are labeled 'DESeq, Comparison k, ...' in header row 0;
    subheaders ('baseMean', 'log2FoldChange', ...) are in header row 3."""
    starts = {}
    for i, h in enumerate(header0):
        if isinstance(h, str) and h.startswith("DESeq, Comparison"):
            k = int(h.split("Comparison")[1].split(",")[0].strip())
            starts[k] = i
    cols = {}
    for k, s in starts.items():
        e = min([x for x in starts.values() if x > s], default=len(header3))
        block = {header3[i]: i for i in range(s, e)}
        cols[k] = {"baseMean": block["baseMean"], "log2FoldChange": block["log2FoldChange"]}
    return cols

def main():
    wb = openpyxl.load_workbook(XLSX, read_only=True)
    ws = wb["NormCount"]

    rows = ws.iter_rows(values_only=True)
    header0 = next(rows); next(rows); next(rows); header3 = next(rows)
    colmap = find_columns(header0, header3)
    for k in (1, 4, 7):
        assert "baseMean" in colmap[k] and "log2FoldChange" in colmap[k], colmap
        assert header3[colmap[k]["baseMean"]] == "baseMean"
        assert header3[colmap[k]["log2FoldChange"]] == "log2FoldChange"
    print("Column mapping (0-based):")
    for t, k in COMPARISON.items():
        print(f"  {t}: Comparison {k} -> baseMean col {colmap[k]['baseMean']}, "
              f"log2FoldChange col {colmap[k]['log2FoldChange']}")
    print()

    counts = {t: {"lfc>0.5 & bm>10": 0, "lfc<-0.5 & bm>10": 0} for t in COMPARISON}
    n_genes = 0
    n_na_lfc = {t: 0 for t in COMPARISON}

    for r in rows:
        n_genes += 1
        for t, k in COMPARISON.items():
            lfc = r[colmap[k]["log2FoldChange"]]
            bm = r[colmap[k]["baseMean"]]
            if not isinstance(lfc, (int, float)) or isinstance(lfc, bool):
                n_na_lfc[t] += 1
                continue
            if isinstance(bm, (int, float)) and not isinstance(bm, bool) and bm > 10:
                if lfc > 0.5:
                    counts[t]["lfc>0.5 & bm>10"] += 1
                if lfc < -0.5:  # sensitivity: opposite direction
                    counts[t]["lfc<-0.5 & bm>10"] += 1

    print(f"Gene rows analyzed: {n_genes}")
    print(f"NA/non-numeric lfc per tissue: {n_na_lfc}")
    print()
    print(f"{'Tissue':<16} {'lfc>0.5 & bm>10':>16} {'lfc<-0.5 & bm>10':>18}")
    for t in COMPARISON:
        print(f"{t:<16} {counts[t]['lfc>0.5 & bm>10']:>16} {counts[t]['lfc<-0.5 & bm>10']:>18}")
    print()
    winner = max(COMPARISON, key=lambda t: counts[t]["lfc>0.5 & bm>10"])
    print(f"MAX tissue (lfc>0.5 & basemean>10): {winner} with "
          f"{counts[winner]['lfc>0.5 & bm>10']} genes")

if __name__ == "__main__":
    main()
