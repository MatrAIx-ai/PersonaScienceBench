import pandas as pd, numpy as np

# ---------------------------------------------------------------------------
# FINAL DETECTION: century where Diversity in Pottery Form COLLAPSES and
# Diversity in Pottery Decoration INCREASES simultaneously.
# ---------------------------------------------------------------------------
df = pd.read_csv("data/time_series_data.csv")

# (1) Use the 37 RAW 100-yr bin values (PotteryForm / PotteryDecoration columns).
raw = (df[df["PotteryForm"].notna()]
         [["CE", "PotteryForm", "PotteryDecoration"]]
         .reset_index(drop=True))
assert len(raw) == 37, f"expected 37 raw bins, got {len(raw)}"
assert np.all(np.diff(raw["CE"].values) == 100), "raw grid not 100-yr spaced"

# (2) First-differences on the 100-yr grid.
raw["dForm"] = raw["PotteryForm"].diff()
raw["dDeco"] = raw["PotteryDecoration"].diff()

# (3) Flag bins: Form collapse (dForm < -0.5) AND Decoration increase (dDeco > +0.5).
TH = 0.5
flag = raw[(raw["dForm"] < -TH) & (raw["dDeco"] > TH)]
print("=== Flagged bins (same-bin: Form drop AND Deco rise) ===")
print(flag[["CE", "PotteryForm", "dForm", "PotteryDecoration", "dDeco"]].to_string(index=False))
print("n flagged:", len(flag))

# Sanity: extreme deltas
print("\nLargest negative dForm at CE =", raw.loc[raw["dForm"].idxmin(), "CE"],
      "=", round(raw["dForm"].min(), 2))
print("Largest positive dDeco at CE =", raw.loc[raw["dDeco"].idxmax(), "CE"],
      "=", round(raw["dDeco"].max(), 2))

# (4) Adjacent-bin (±100 yr) robustness check.
# For each flagged bin, examine the ±1 bin neighbourhood for any OTHER bin that
# independently satisfies the collapse+increase condition.
def robustness(flags):
    issues = []
    for _, f in flags.iterrows():
        idx = f.name
        for j in (idx - 1, idx + 1):
            if 0 <= j < len(raw):
                r = raw.loc[j]
                if pd.notna(r["dForm"]) and pd.notna(r["dDeco"]) and \
                   (r["dForm"] < -TH) and (r["dDeco"] > TH) and r["CE"] != f["CE"]:
                    issues.append((f["CE"], r["CE"], r["dForm"], r["dDeco"]))
    return issues
print("\n=== Adjacent-bin (±100 yr) robustness check ===")
rob = robustness(flag)
print("Other qualifying bins in ±100 yr window:", rob if rob else "NONE")

# (5) Map flagged CE -> century.
def century(ce):
    year = -ce  # CE negative -> BCE year
    return int(np.ceil(year / 100))
print("\n=== Result ===")
for _, f in flag.iterrows():
    c = century(f["CE"])
    print(f"CE {int(f['CE'])} (= {int(-f['CE'])} BCE)  ->  {c}th century BCE")
    print(f"   Form: {f['PotteryForm']-f['dForm']:.2f} -> {f['PotteryForm']:.2f}  (dForm {f['dForm']:+.2f})")
    print(f"   Deco: {f['PotteryDecoration']-f['dDeco']:.2f} -> {f['PotteryDecoration']:.2f}  (dDeco {f['dDeco']:+.2f})")

