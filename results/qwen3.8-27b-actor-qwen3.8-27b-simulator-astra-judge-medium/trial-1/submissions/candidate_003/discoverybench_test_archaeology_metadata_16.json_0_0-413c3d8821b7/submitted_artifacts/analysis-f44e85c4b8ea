import pandas as pd, numpy as np

# ---- Load capital ----
df = pd.read_csv('data/capital.csv')
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
# drop group/color
df = df.drop(columns=['group','color'])
# convert comma decimals
for c in zcols:
    df[c] = df[c].astype(str).str.replace(',','.').astype(float)

df = df.sort_values('BCE', ascending=False).reset_index(drop=True)  # oldest->? keep consistent
# We'll present in chronological order (ascending BCE = decreasing time). Use ascending BCE for series.
df_s = df.sort_values('BCE').reset_index(drop=True)  # 500 -> 4300 (young -> old)
X = df_s[zcols].values
# re-standardize
Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)

# PCA via SVD
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
pc1 = Xs @ Vt[0]  # scores
evr = S**2 / (S**2).sum()
print('PC1 explained variance ratio: %.4f' % evr[0])
print('PC1 loading signs (Vt[0]):')
for c,v in zip(zcols, Vt[0]):
    print(f'  {c:12s} {v:+.3f}')

df_s['PC1'] = pc1
df_s['PC1_rank'] = df_s['PC1'].rank(method='min')
overall_mean = pc1.mean()
print('\nFull-series PC1 mean: %.4f' % overall_mean)
df_s['PC1_above_mean'] = df_s['PC1'] > overall_mean

def window(bce_lo, bce_hi, label):
    w = df_s[(df_s['BCE']>=bce_lo)&(df_s['BCE']<=bce_hi)]
    x = w['BCE'].values.astype(float)
    y = w['PC1'].values
    slope = np.polyfit(x, y, 1)[0]
    # slope per 100 yr
    print(f'\n=== {label} (BCE {bce_lo}-{bce_hi}) ===')
    print(w[['BCE','PC1','PC1_rank','PC1_above_mean']].to_string(index=False))
    print(f'  mean PC1 = {y.mean():+.4f}  (overall mean {overall_mean:+.4f}; diff {y.mean()-overall_mean:+.4f})')
    print(f'  min={y.min():+.3f} max={y.max():+.3f}')
    print(f'  trend slope (PC1 per 100yr, +BCE direction) = {slope:+.4f}')
    # chronological direction: as time progresses (BCE decreases), dPC1
    chron_slope = np.polyfit(-x, y, 1)[0]
    print(f'  trend as time advances (BCE decreasing): {chron_slope:+.4f} /100yr')
    above = (y>overall_mean).sum()
    print(f'  bins above overall mean: {above}/{len(y)}')
    return w

window(3000,3400,'Middle Neolithic (MN)')
window(2300,2900,'Younger Neolithic (SG)')

# ---- Pollen cross-check ----
p = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
for c in p.columns:
    if c not in ['calBP','CE']:
        p[c] = pd.to_numeric(p[c].astype(str).str.replace(',','.'), errors='coerce')
# calBP = BCE + 1950
def pollen_window(bce_lo,bce_hi,label):
    c_lo, c_hi = bce_lo+1950, bce_hi+1950
    w = p[(p['calBP']>=min(c_lo,c_hi))&(p['calBP']<=max(c_lo,c_hi))]
    col='SMOOTH_MEAN_100y'
    sub = w.sort_values('calBP')
    start=sub[col].iloc[0]; end=sub[col].iloc[-1]
    print(f'\nPollen {label}: calBP {min(c_lo,c_hi)}-{max(c_lo,c_hi)}, {len(w)} rows, SMOOTH_MEAN_100y start={start:.3f} end={end:.3f} delta={end-start:+.3f}')
pollen_window(3000,3400,'MN')
pollen_window(2300,2900,'SG')
