"""PCA on forms of capital in 100-year time slices (Younger Bronze Age, 1100-500 BCE).

Variants:
 A) PCA on all 39 slices (12 Z-variables, author-standardized, no re-standardization)
 B) PCA on YBA-only 7 slices (1100..500)
 C) PCA on all 39 slices with unit-variance re-standardization
 D) PCA on all 39 slices without ZSichel (constant 0 in YBA)
Outputs PC1 for 1100 BCE vs each 1000-500 BCE horizon, plus pollen context.
"""
import csv, json
import numpy as np
from numpy.linalg import svd

CAP = 'data/capital.csv'
POL = 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'
VARS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
        'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']

def load_capital():
    rows = list(csv.DictReader(open(CAP)))
    bce = np.array([int(r['BCE']) for r in rows])
    M = np.array([[float(r[v].replace(',', '.')) for v in VARS] for r in rows])
    return bce, M

def pca(X):
    Xc = X - X.mean(0)
    U, S, Vt = svd(Xc, full_matrices=False)
    return U[:, 0] * S[0], S**2 / np.sum(S**2), Vt

bce, M = load_capital()
i1100 = int(list(bce).index(1100))
horizons = [int(b) for b in bce if 500 <= b <= 1000]  # 1000..500
idx_h = [int(i) for i in np.where((bce >= 500) & (bce <= 1000))[0]]
yba = (bce <= 1100) & (bce >= 500)

variants = {
    'A_all39':        (M, None,  True),
    'B_YBA_only':     (M[yba], None, False),
    'C_all39_std':    (M, (M - M.mean(0)) / M.std(0, ddof=0), True),
    'D_all39_noSickle': (np.delete(M, list(VARS).index('ZSichel'), axis=1), None, True),
}

results = {}
for name, (X, Xs, all_range) in variants.items():
    p1, ev, Vt = pca(Xs if Xs is not None else X)
    if all_range:
        v1100, rest = p1[i1100], p1[idx_h]
    else:  # YBA-only: row order 1100,1000,...,500
        v1100, rest = p1[0], p1[1:]
    results[name] = {
        'ev_PC1': round(float(ev[0]), 4),
        'PC1_1100': round(float(v1100), 3),
        'PC1_1000_500': {h: round(float(x), 3) for h, x in zip(horizons, rest)},
        'mean_1000_500': round(float(rest.mean()), 3),
        'diff_1100_vs_mean': round(float(v1100 - rest.mean()), 3),
        'higher': bool(v1100 > rest.mean()),
        'loadings_PC1': {v: round(float(x), 3) for v, x in
                         zip([v for v in VARS if v != 'ZSickle' or 'Sickle' in name or name != 'D_all39_noSickle'],
                             Vt[0]) if True and v in (VARS if name != 'D_all39_noSickle' else [v for v in VARS if v != 'ZSickle'])},
    }

# pollen context (decimal comma)
pol = {int(r['CE']): r for r in csv.DictReader(open(POL)) if r['CE'].lstrip('-').isdigit()}
def fnum(s):
    return float(s.replace(',', '.')) if s else None
pollen = {}
for h in [1100] + horizons:
    r = pol.get(-h)
    pollen[h] = {'MEAN': fnum(r['MEAN']) if r else None,
                 'SMOOTH_MEAN_100y': fnum(r['SMOOTH_MEAN_100y']) if r else None}

# carry-over check: how many of 12 vars at 1100 equal the 1200 value
r1200 = {v: float(M[list(bce).index(1200), i].copy()) for i, v in enumerate(VARS)}
r1100 = {v: M[i1100, i] for i, v in enumerate(VARS)}
carryover = [v for v in VARS if abs(r1100[v] - r1200[v]) < 1e-12]

out = {'variants': results, 'pollen': {str(k): v for k, v in pollen.items()},
       'carryover_vars_1100_equals_1200': carryover,
       'n_carryover': len(carryover)}
with open('out/results.json', 'w') as f:
    json.dump(out, f, indent=2)

print(json.dumps(out, indent=2))
