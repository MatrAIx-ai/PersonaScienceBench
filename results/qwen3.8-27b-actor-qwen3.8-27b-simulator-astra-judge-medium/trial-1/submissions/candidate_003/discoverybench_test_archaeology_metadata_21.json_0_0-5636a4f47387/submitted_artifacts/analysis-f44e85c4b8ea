import pandas as pd, numpy as np

# ---- Load capital.csv (European comma decimals) ----
cap = pd.read_csv('data/capital.csv', dtype=str)
cap['BCE'] = cap['BCE'].astype(int)
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
X = cap[zcols].apply(lambda s: s.str.replace(',','.').astype(float))
n, p = X.shape
print(f"capital matrix: {n} slices x {p} capital forms")
print("existing Z per-col mean/std (ddof=1):")
print(X.agg(['mean','std']).round(3).to_string())

# ---- Correlation-matrix PCA on the existing Z (already standardized) ----
# Use existing Z as-is (A1: no re-standardization); compute covariance of these.
C = np.cov(X.values, rowvar=False)          # 12x12 ~ correlation matrix
evals, evecs = np.linalg.eigh(C)            # ascending
order = np.argsort(evals)[::-1]
evals = evals[order]; evecs = evecs[:, order]
evr = evals / evals.sum()

# PC scores per slice
scores = X.values @ evecs                   # 39 x 12, col0=PC1

# Sign convention: for PC1 (and PC2) make the largest-|loading| variable positive
def fix_sign(evec, load):
    j = int(np.argmax(np.abs(load)))
    if load[j] < 0:
        return -evec, -load
    return evec, load

# structure coefficients (loadings) = corr(variable, PC)
def loadings(col):
    t = X.values @ evecs[:, col]
    out = np.array([np.corrcoef(X.values[:, j], t)[0,1] for j in range(p)])
    return out

pc1_load = loadings(0); pc2_load = loadings(1)
evecs[:,0], pc1_load = fix_sign(evecs[:,0], pc1_load)
evecs[:,1], pc2_load = fix_sign(evecs[:,1], pc2_load)
scores = X.values @ evecs   # recompute with fixed signs

# ---- Table ----
tab = pd.DataFrame({'variable': zcols,
                    'PC1_loading': pc1_load,
                    'PC2_loading': pc2_load})
tab['PC1_rank'] = tab['PC1_loading'].abs().rank(ascending=False, method='min').astype(int)
tab['PC2_rank'] = tab['PC2_loading'].abs().rank(ascending=False, method='min').astype(int)
tab = tab.sort_values('PC1_rank').reset_index(drop=True)
print("\nEVR: PC1=%.4f  PC2=%.4f  (PC1+PC2=%.4f)" % (evr[0], evr[1], evr[0]+evr[1]))
print("\nLoadings table (structure coefficients = corr(var, PC)), ranked by |PC1|:")
print(tab.round(3).to_string(index=False))

sym = {'Zhausgr':'house size','ZDolch':'daggers','ZAxtSchwert':'hatchets/swords'}
print("\n--- Symbolic capital (house size, daggers, hatchets/swords) ---")
for v,name in sym.items():
    r = tab[tab['variable']==v].iloc[0]
    print(f"{name:16s} ({v:11s})  PC1={r['PC1_loading']:+.3f} (rank {r['PC1_rank']}/12)   "
          f"PC2={r['PC2_loading']:+.3f} (rank {r['PC2_rank']}/12)")

# ---- Per-slice PC2 scores + symbolic variable values (temporal view) ----
out = pd.DataFrame({'BCE': cap['BCE'].values, 'group': cap['group'].values,
                    'PC1_score': scores[:,0], 'PC2_score': scores[:,1]})
for v in sym:
    out[v] = X[v].values
    out[v+'_xPC2load'] = X[v].values * pc2_load[zcols.index(v)]
out = out.sort_values('BCE')
print("\n--- Per-slice PC scores & symbolic Z values (BCE 4300->500) ---")
print(out.round(3).to_string(index=False))

# temporal characterization of PC2
pc2 = out['PC2_score'].values
bce = out['BCE'].values
print("\nPC2 score by period (mean):")
print(out.groupby('group')['PC2_score'].mean().round(3).to_string())
print("\ncorr(PC2_score, BCE) = %.3f  (negative => higher PC2 in later/younger BCE)" % np.corrcoef(pc2, bce)[0,1])
print("PC2 highest slice: BCE %d (%.3f); lowest slice: BCE %d (%.3f)" %
      (bce[np.argmax(pc2)], pc2.max(), bce[np.argmin(pc2)], pc2.min()))
print("PC1 score by period (mean):")
print(out.groupby('group')['PC1_score'].mean().round(3).to_string())
print("corr(PC1_score, BCE) = %.3f" % np.corrcoef(scores[:,0], bce)[0,1])

# ---- save artifacts ----
tab.to_csv('artifacts_loading_table.csv', index=False)
out.to_csv('artifacts_pc_scores_by_slice.csv', index=False)
np.save('artifacts_eigenvalues.npy', evals)
print("\nSaved artifacts_loading_table.csv, artifacts_pc_scores_by_slice.csv, artifacts_eigenvalues.npy")
