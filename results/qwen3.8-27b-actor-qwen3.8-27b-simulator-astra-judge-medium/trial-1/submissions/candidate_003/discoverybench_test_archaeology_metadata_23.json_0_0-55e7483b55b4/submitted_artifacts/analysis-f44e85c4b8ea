W, H = 1400, 1080
buf = bytearray(b"\xff" * (W * H * 3))

def set_px(x, y, rgb):
    if 0 <= x < W and 0 <= y < H:
        i = (y * W + x) * 3
        buf[i:i+3] = bytes(rgb)

def fill_rect(x0, y0, x1, y1, rgb):
    for y in range(max(0, y0), min(H, y1 + 1)):
        i0 = (y * W + max(0, x0)) * 3
        i1 = (y * W + min(W - 1, x1)) * 3
        buf[i0:i1 + 3] = bytes(rgb) * ((i1 - i0 + 3) // 3)

def hline(x0, x1, y, rgb, th=1):
    for t in range(th):
        for x in range(min(x0, x1), max(x0, x1) + 1):
            set_px(x, y + t, rgb)

def vline(x, y0, y1, rgb, th=1):
    for t in range(th):
        for y in range(min(y0, y1), max(y0, y1) + 1):
            set_px(x + t, y, rgb)

def line(x0, y0, x1, y1, rgb, th=1):
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        for t in range(th):
            set_px(x0 + t, y0 + t, rgb)
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy: err += dy; x0 += sx
        if e2 <= dx: err += dx; y0 += sy

def circle(cx, cy, r, rgb, outline=None):
    for y in range(cy - r, cy + r + 1):
        for x in range(cx - r, cx + r + 1):
            if (x - cx) ** 2 + (y - cy) ** 2 <= r * r:
                set_px(x, y, rgb)
    if outline:
        for y in range(cy - r, cy + r + 1):
            for x in range(cx - r, cx + r + 1):
                d = (x - cx) ** 2 + (y - cy) ** 2
                if r * r < d <= (r + 1) ** 2:
                    set_px(x, y, outline)

def text(x, y, s, rgb, scale=2):
    cx = x
    for ch in s:
        g = FONT.get(ch, FONT[' '])
        for row in range(7):
            bits = g[row]
            for col in range(5):
                if bits & (0x10 >> col):
                    fill_rect(cx + col * scale, y + row * scale,
                              cx + col * scale + scale - 1, y + row * scale + scale - 1, rgb)
        cx += 6 * scale
    return cx

