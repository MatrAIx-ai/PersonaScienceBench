"""
DiscoveryBench: Between 3400 BCE and 3000 BCE, how does the number of monuments
and axes change with elements of symbolic capital?

Data: time_series_data.csv (annual, Z-values + linear interpolations _inter),
      capital.csv (centennial Z-values, decimal comma),
      pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv (openness background).

Approach (approved plan):
  - Analytic core: the 5 centennial raw observations in the window
    (identical in time_series_data.csv and capital.csv).
  - _inter series used ONLY for visualization and a qualitative lead/lag check.
  - First-difference table: the descriptive core.
  - Pearson/Spearman on n=5: reported as descriptive only.
  - Pollen SMOOTH_MEAN_100y: background panel only.
  - Plot rendered with PIL (matplotlib unavailable in this runtime).
"""
import pandas as pd
import numpy as np
from scipy import stats

TS = "data/time_series_data.csv"
CAP = "data/capital.csv"
POL = "data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv"
OUT = "output"

def comma2dot(s):
    return s.str.replace(",", ".", regex=False)

# ---------------- load & clean ----------------
ts = pd.read_csv(TS, index_col=0)
cap = pd.read_csv(CAP)
for c in [c for c in cap.columns if c.startswith("Z")]:
    cap[c] = comma2dot(cap[c]).astype(float)
pol = pd.read_csv(POL, index_col=0)
for c in ["Belau_PC1", "Woserin_PC1", "Belau_PC1_inter", "Woserin_PC1_inter",
          "MEAN", "SMOOTH_MEAN_50y", "SMOOTH_MEAN_100y", "SMOOTH_MEAN_150y",
          "SMOOTH_MEAN_200y", "SMOOTH_MEAN_250y"]:
    pol[c] = comma2dot(pol[c]).astype(float)

# ---------------- window 3400-3000 BCE ----------------
w_ts = ts[(ts.CE >= -3400) & (ts.CE <= -3000)].copy()
w_cap = cap[(cap.BCE >= 3000) & (cap.BCE <= 3400)].sort_values("BCE").reset_index(drop=True)
w_pol = pol[(pol.CE >= -3400) & (pol.CE <= -3000)].copy()

# consistency check: raw values in time series == capital.csv
raw_map = {"MonumentCount": "ZMonument", "AxesCelts": "ZBeil",
           "HatchetSword": "ZAxtSchwert", "Dagger": "ZDolch", "HouseSize": "Zhausgr"}
pts = w_ts[w_ts.MonumentCount.notna()].set_index("CE")
ok = True
for ts_c, cap_c in raw_map.items():
    a = pts[ts_c].values
    b = w_cap.set_index(-w_cap.BCE)[[cap_c]].reindex(pts.index)[cap_c].values
    same = bool(np.allclose(a, b))
    ok &= same
    print(f"consistency {ts_c} == {cap_c}: {same}")
print("all sources consistent:", ok)

# ---------------- centennial core table ----------------
core = w_cap.sort_values("BCE", ascending=False)[["BCE", "ZMonument", "ZBeil", "ZAxtSchwert", "ZDolch", "Zhausgr"]].copy()
core.columns = ["BCE", "MonumentCount", "AxesCelts", "HatchetSword", "Dagger", "HouseSize"]
print("\n--- Centennial observations, 3400-3000 BCE (Z-values) ---")
print(core.to_string(index=False))

# ---------------- first differences ----------------
core["dMonumentCount"] = core.MonumentCount.diff()
core["dAxesCelts"]     = core.AxesCelts.diff()
core["dHatchetSword"]  = core.HatchetSword.diff()
core["dDagger"]        = core.Dagger.diff()
core["dHouseSize"]     = core.HouseSize.diff()
diffs = core[["BCE", "dMonumentCount", "dAxesCelts", "dHatchetSword", "dDagger", "dHouseSize"]].iloc[1:].reset_index(drop=True).copy()
diffs.insert(0, "transition", ["3400->3300", "3300->3200", "3200->3100", "3100->3000"])
diffs["BCE"] = diffs["BCE"].astype(int)
print("\n--- First differences (per century) ---")
pd.set_option("display.float_format", lambda v: f"{v:+.3f}")
print(diffs.to_string(index=False))
diffs.to_csv(f"{OUT}/first_differences.csv", index=False)

# ---------------- descriptive correlations (n=5, NOT robust) ----------------
pairs = [("MonumentCount", "HatchetSword"), ("MonumentCount", "Dagger"),
         ("MonumentCount", "HouseSize"), ("AxesCelts", "HatchetSword"),
         ("AxesCelts", "Dagger"), ("AxesCelts", "HouseSize")]
print("\n--- Descriptive pairwise correlations on n=5 centennial points ---")
for x, y in pairs:
    vx, vy = core[x].values, core[y].values
    if np.std(vx) < 1e-9 or np.std(vy) < 1e-9:
        print(f"{x:15s} vs {y:12s}: degenerate (zero variance in one series)")
        continue
    r, _ = stats.pearsonr(vx, vy)
    rho, _ = stats.spearmanr(vx, vy)
    print(f"{x:15s} vs {y:12s}: Pearson r={r:+.3f}, Spearman rho={rho:+.3f}")

# ---------------- lead/lag check on interpolated curves (descriptive only) ----
def xcorr_lag(a, b, lag):
    if lag > 0:  return np.corrcoef(a[lag:], b[:-lag])[0, 1]
    if lag < 0:  return np.corrcoef(a[:lag], b[-lag:])[0, 1]
    return np.corrcoef(a, b)[0, 1]

print("\n--- Lead/lag (centennial lags) of interpolated curves, descriptive only ---")
for x in ["MonumentCount", "AxesCelts"]:
    for y in ["HatchetSword", "Dagger", "HouseSize"]:
        ax_, ay_ = w_ts[f"{x}_inter"].values, w_ts[f"{y}_inter"].values
        if np.std(ay_) < 1e-9:
            print(f"{x:15s} vs {y:12s}: degenerate (constant curve)")
            continue
        line = "  ".join(f"{lag:+d}y:{xcorr_lag(ax_, ay_, lag):+.2f}" for lag in (-2, -1, 0, 1, 2))
        print(f"{x:15s} vs {y:12s}: {line}")

# ---------------- pollen background in window ----------------
po = w_pol.set_index("CE")
print("\n--- Pollen openness (SMOOTH_MEAN_100y) in window ---")
print(f"start(3400 BCE)={po.SMOOTH_MEAN_100y.iloc[0]:.3f}  "
      f"end(3000 BCE)={po.SMOOTH_MEAN_100y.iloc[-1]:.3f}  "
      f"min={po.SMOOTH_MEAN_100y.min():.3f} at CE {int(po.SMOOTH_MEAN_100y.idxmin())}  "
      f"max={po.SMOOTH_MEAN_100y.max():.3f} at CE {int(po.SMOOTH_MEAN_100y.idxmax())}")

