import pandas as pd, numpy as np

df = pd.read_csv('data/time_series_data.csv', index_col=0)

# --- Primary: raw 100-year grid ---
raw = df[['CE','PotteryDecoration','PotteryForm']].dropna().reset_index(drop=True)
raw['dDeco'] = raw.PotteryDecoration.diff()   # value at CE=c minus value at CE=c-100
raw['dForm'] = raw.PotteryForm.diff()
# diff at CE=c (year |c| BCE) covers the change from |c|+100 BCE to |c| BCE,
# i.e. the century that STARTS at |c|+100 BCE (e.g. 1800->1700 BCE = 18th c. BCE)
raw['cent_no'] = (-raw.CE + 100) // 100
tab = raw[raw.dDeco.notna()][['cent_no','dDeco','dForm']].copy()
tab['opposite_dir'] = (tab.dDeco > 0) & (tab.dForm < 0)

print("=== Per-century deltas, raw 100-yr grid (century = 100-yr bin, earliest first) ===")
for t in tab.sort_values('cent_no', ascending=False).itertuples():
    flag = '  <== OPPOSITE' if t.opposite_dir else ''
    if abs(t.dDeco) > 0.005 or abs(t.dForm) > 0.005 or t.opposite_dir:
        print(f"{t.cent_no}th c. BCE ({t.cent_no*100}-{t.cent_no*100-100+1} BCE): dDeco={t.dDeco:+.2f}  dForm={t.dForm:+.2f}{flag}")

for thr in (0.25, 0.1, 0.5):
    qual = tab[(tab.dDeco > thr) & (tab.dForm < -thr)].sort_values('cent_no', ascending=False)
    print(f"\n[raw] Threshold |d|>={thr} (Deco up AND Form down): " +
          (", ".join(f"{t.cent_no}th c. BCE (dDeco={t.dDeco:+.2f}, dForm={t.dForm:+.2f})" for t in qual.itertuples()) or "none"))
qd = tab[tab.opposite_dir].sort_values('cent_no', ascending=False)
print("[raw] Direction-only: " +
      (", ".join(f"{t.cent_no}th c. BCE ({t.dDeco:+.2f}/{t.dForm:+.2f})" for t in qd.itertuples()) or "none"))
print("  -> EARLIEST qualifying century (raw grid):", int(tab[(tab.dDeco>0.25)&(tab.dForm<-0.25)].cent_no.max()), "c. BCE")

# --- Cross-check 1: 100-yr bin means of _inter columns ---
print("\n=== Cross-check: 100-yr bin MEAN of _inter columns ===")
rows = []
for i in range(0, len(df), 100):
    seg = df.iloc[i:i+100]
    if len(seg) < 100: break
    start_ce = seg.CE.iloc[0]
    rows.append((int(-start_ce // 100 * 100), seg.PotteryDecoration_inter.mean(), seg.PotteryForm_inter.mean()))
b = pd.DataFrame(rows, columns=['startBCE','Deco','Form']).set_index('startBCE').sort_index(ascending=False)
b['dDeco'] = b.Deco.diff(); b['dForm'] = b.Form.diff()
b['cent_no'] = b.index // 100   # bin starting at 1800 BCE = 18th c. BCE
for thr in (0.25, 0.1, 0.5):
    qual = b[(b.dDeco > thr) & (b.dForm < -thr)]
    print(f"[inter] Threshold {thr}: " +
          (", ".join(f"{int(c//100)}th c. BCE (dDeco={r.dDeco:+.2f}, dForm={r.dForm:+.2f})" for c, r in qual.iterrows()) or "none"))
qd = b[(b.dDeco>0)&(b.dForm<0)]
print("[inter] Direction-only: " +
      (", ".join(f"{int(c//100)}th c. BCE ({r.dDeco:+.2f}/{r.dForm:+.2f})" for c, r in qd.iterrows()) or "none"))
print("  -> EARLIEST qualifying century (inter bin means):", int(b[(b.dDeco>0.25)&(b.dForm<-0.25)].cent_no.max()), "c. BCE")
print("  (note: linear interpolation spreads the step across the jump bin and the next, halving each delta)")

# --- Cross-check 2: capital.csv (adds 4300/4200 BCE) ---
print("\n=== Cross-check: capital.csv (adds 4300/4200 BCE rows) ===")
cap = pd.read_csv('data/capital.csv', decimal=',')
cap = cap[['BCE','ZKeform','Zkeverz']].rename(columns={'BCE':'startBCE','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'})
merged = pd.concat([cap, raw[['CE']].assign(startBCE=-raw.CE, PotteryDecoration=raw.PotteryDecoration, PotteryForm=raw.PotteryForm)[['startBCE','PotteryDecoration','PotteryForm']]]).drop_duplicates().sort_values('startBCE', ascending=False).reset_index(drop=True)
merged['dDeco'] = merged.PotteryDecoration.diff(); merged['dForm'] = merged.PotteryForm.diff()
merged['cent_no'] = (merged.startBCE + 100) // 100
for thr in (0.25, 0.1, 0.5):
    qual = merged[(merged.dDeco > thr) & (merged.dForm < -thr)].sort_values('cent_no', ascending=False)
    print(f"[capital] Threshold {thr}: " +
          (", ".join(f"{t.cent_no}th c. BCE (dDeco={t.dDeco:+.2f}, dForm={t.dForm:+.2f})" for t in qual.itertuples()) or "none"))
print("  -> EARLIEST qualifying century (capital.csv included):", int(merged[(merged.dDeco>0.25)&(merged.dForm<-0.25)].cent_no.max()), "c. BCE")

# --- Key values around the answer ---
print("\n=== Key grid values around the answer ===")
sub = raw[raw.CE.between(-1900, -1500)]
print(sub.to_string(index=False))
