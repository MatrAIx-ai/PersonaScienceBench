"""
Amber peak analysis: which millennium and which time interval did amber's
Z-value peak?

Files:
  - data/time_series_data.csv  (annual rows, CE negative = BCE; Amber raw is
    sparse at 100-yr bins; Amber_inter is fully interpolated)
  - data/capital.csv           (100-yr bins, explicit BCE, Zamber, comma decimals)

Computed:
  - global max Z and the plateau extent (bin-level) where Z == global max
  - secondary local maxima (to confirm no confusion)
  - millennium assignment (standard BCE convention: 4th mil = 4000-3001 BCE)
"""
import pandas as pd
import numpy as np

pd.set_option("display.width", 200)

# ---------- time_series_data.csv ----------
ts = pd.read_csv("data/time_series_data.csv", index_col=0)
ts["BCE"] = -ts["CE"]                       # negative CE == BCE (verified vs calBP)
assert (ts.loc[0, "calBP"] == 1950 - ts.loc[0, "CE"]), "CE/calBP consistency"

raw = ts["Amber"].dropna()
inter = ts["Amber_inter"]

gmax_ts = inter.max()
plat = ts[inter == gmax_ts]
plat_lo, plat_hi = int(plat["BCE"].min()), int(plat["BCE"].max())

raw_max = raw.max()
raw_max_bins = sorted(-ts.loc[raw[raw == raw_max].index, "CE"].astype(int))
raw_146_bins = sorted(-ts.loc[raw[raw == 1.46].index, "CE"].astype(int))

# ---------- capital.csv ----------
cap = pd.read_csv("data/capital.csv", decimal=",", thousands=".")
cmax = cap["Zamber"].max()
cmax_rows = cap[cap["Zamber"] == cmax]
cmax_bce = sorted(cmax_rows["BCE"].astype(int))
cmax_group = cmax_rows["group"].iloc[0]

def mill_bce(bce):
    """Standard BCE millennium: 1st = 1000-1 BCE, 4th = 4000-3001 BCE."""
    return (bce - 1) // 1000 + 1

mill_early = mill_bce(plat_hi)   # earliest bin (largest BCE, e.g. 3300) -> 4th mil
mill_late  = mill_bce(plat_lo)   # latest bin  (smallest BCE, e.g. 3000) -> boundary

print("=" * 60)
print("time_series_data.csv")
print(f"  rows={len(ts)}  CE={ts['CE'].min()}..{ts['CE'].max()} (all BCE)")
print(f"  Amber raw non-null={raw.shape[0]} (100-yr bins); Amber_inter non-null={int(inter.notna().sum())}")
print(f"  GLOBAL max Z (inter) = {gmax_ts}")
print(f"  plateau (inter, Z==max): BCE {plat_lo}..{plat_hi}  ({len(plat)} annual rows)")
print(f"  raw max = {raw_max}; raw bins at max = {raw_max_bins}")
print(f"  secondary max 1.46 bins = {raw_146_bins}")
print("-" * 60)
print("capital.csv")
print(f"  rows={len(cap)}  BCE={cap['BCE'].min()}..{cap['BCE'].max()} (100-yr bins)")
print(f"  Zamber max = {cmax}; bins at max = {cmax_bce}; group = {cmax_group}")
print("-" * 60)
def ord(n):
    s = {1:"st",2:"nd",3:"rd"}.get(n % 10 if not (10 < n%100 < 14) else 0, "th")
    return f"{n}{s}"
print(f"Peak interval {plat_hi}-{plat_lo} BCE: bins {plat_hi},{plat_hi-100},{plat_hi-200} BCE -> {ord(mill_early)} millennium BCE; "
      f"bin {plat_lo} BCE -> {ord(mill_late)} millennium (boundary)")
print(f"=> Amber peaked in the {ord(mill_early)} millennium BCE.")
print("=" * 60)
