"""
DiscoveryBench: In which century did summed social capital peak, and which
individual social capital components (gold, monument, ...) increase?

Social capital = Copper&Gold (ZCU_AU) + Amber (Zamber) + Monument Count (ZMonument)
Basis: data/capital.csv (raw 100-year binned Z-scores, BCE 4300-500).
Cross-check: data/time_series_data.csv (raw rows at CE=-X <-> BCE=X).
"""
import csv, re

CAP = "data/capital.csv"
TS  = "data/time_series_data.csv"

def parse_num(s):
    """Parse a possibly comma-decimal, quoted numeric string."""
    s = s.strip()
    if not s:
        return None
    return float(s.replace(",", "."))

# ---------- Step 1: parse capital.csv, verify parsing against raw strings ----------
raw_lines = open(CAP, newline="").read().splitlines()
raw_header = raw_lines[0]
rows = list(csv.reader(raw_lines[1:]))
h = raw_header.split(",")
# header has no quoted commas, safe
idx = {c: i for i, c in enumerate(h)}

# verify a few parsed values against raw CSV strings
checks = [
    (0, "ZCU_AU", "-0,6"),                 # 4300 BCE row
    (0, "ZMonument", "-0,923560777939055"),# 4300 BCE row
    (3, "Zamber", "1,46"),                 # 4000 BCE row
    (29, "ZCU_AU", "2,54"),                # 1400 BCE row (0-based after header)
]
for r_i, col, expected_raw in checks:
    raw_cell = rows[r_i][idx[col]]
    assert raw_cell == expected_raw, (r_i, col, raw_cell, expected_raw)
    assert abs(parse_num(raw_cell) - float(expected_raw.replace(",", "."))) < 1e-12
    print(f"parse check OK: row {r_i} {col} raw='{raw_cell}' -> {parse_num(raw_cell)}")

data = []
for r in rows:
    bce = int(float(r[idx["BCE"]]))
    data.append({
        "BCE": bce,
        "CopperGold": parse_num(r[idx["ZCU_AU"]]),
        "Amber":      parse_num(r[idx["Zamber"]]),
        "MonumentCount": parse_num(r[idx["ZMonument"]]),
        "MonumentSize": parse_num(r[idx["ZMW"]]),
    })
data.sort(key=lambda d: d["BCE"], reverse=True)  # 4300 -> 500 (chronological)

# sanity: 100-year bins, no NaN
bce = [d["BCE"] for d in data]
assert set(bce[i] - bce[i+1] for i in range(len(bce)-1)) == {100}
for d in data:
    for k in ("CopperGold", "Amber", "MonumentCount"):
        assert d[k] is not None, (d["BCE"], k)
print(f"capital.csv: {len(data)} bins, BCE {bce[-1]}..{bce[0]}, all 100y steps, 0 NaN in social columns")

# ---------- Step 2: summed social capital per bin, locate peak ----------
for d in data:
    d["sum"] = d["CopperGold"] + d["Amber"] + d["MonumentCount"]

peak_val = max(d["sum"] for d in data)
peak_bins = [d["BCE"] for d in data if abs(d["sum"] - peak_val) < 1e-12]
print(f"\nSummed social capital peak value: {peak_val:.4f}")
print(f"Peak bins (BCE labels): {sorted(peak_bins)}  -> 14th-13th century BCE (1400-1300 BCE), 2-bin tie")

top5 = sorted(data, key=lambda d: -d["sum"])[:5]
print("Top-5 bins:", [(d["BCE"], round(d["sum"], 3)) for d in top5])

# ---------- Step 3: per-component delta (1500 -> 1400 BCE) and full-range trend ----------
by = {d["BCE"]: d for d in data}
for comp in ("CopperGold", "Amber", "MonumentCount"):
    prev, peakc = by[1500][comp], by[1400][comp]
    v1300 = by[1300][comp]
    v1200 = by[1200][comp]
    print(f"{comp}: 1500={prev:.4f} -> 1400={peakc:.4f} (delta {peakc-prev:+.4f}); "
          f"1300={v1300:.4f}, 1200={v1200:.4f}; full range min={min(d[comp] for d in data):.4f} "
          f"max={max(d[comp] for d in data):.4f}")

# trend check: is CopperGold monotonic into the peak?
cg = [(d["BCE"], d["CopperGold"]) for d in data]
print("CopperGold last 8 bins (BCE: value):", cg[:8])
# where is CopperGold's max?
cg_max = max(d["CopperGold"] for d in data)
print(f"CopperGold all-time max {cg_max} at BCE {[d['BCE'] for d in data if d['CopperGold']==cg_max]}")
mc_max = max(d["MonumentCount"] for d in data)
print(f"MonumentCount all-time max {mc_max:.4f} at BCE {[d['BCE'] for d in data if abs(d['MonumentCount']-mc_max)<1e-12]}")
am_max = max(d["Amber"] for d in data)
print(f"Amber all-time max {am_max} at BCE {[d['BCE'] for d in data if d['Amber']==am_max]}")

# ---------- Step 4: cross-check with time_series_data.csv ----------
ts_rows = list(csv.reader(open(TS, newline="")))
th = ts_rows[0]
tidx = {c: i for i, c in enumerate(th)}
ts_raw = {}
for r in ts_rows[1:]:
    if r[tidx["CopperGold"]].strip():
        ce = int(float(r[tidx["CE"]]))
        ts_raw[-ce] = (parse_num(r[tidx["CopperGold"]]),
                       parse_num(r[tidx["Amber"]]),
                       parse_num(r[tidx["MonumentCount"]]))
mism = 0
for b, (a, m, mnt) in ts_raw.items():
    d = by.get(b)
    if d is None:
        print(f"ts bin {b} not in capital"); continue
    for name, v in (("CopperGold", a), ("Amber", m), ("MonumentCount", mnt)):
        if abs(d[name] - v) > 1e-9:
            mism += 1
            print("MISMATCH", b, name, d[name], v)
ts_sums = {b: a + m + mnt for b, (a, m, mnt) in ts_raw.items()}
ts_peak = max(ts_sums.values())
ts_peak_bins = sorted(b for b, v in ts_sums.items() if abs(v - ts_peak) < 1e-9)
print(f"\ncross-check: {len(ts_raw)} overlapping bins, {mism} mismatches")
print(f"time_series peak: {ts_peak:.4f} at BCE {ts_peak_bins} -> matches capital.csv peak: {ts_peak_bins == sorted(peak_bins)}")

# ---------- Step 5: robustness: include MonumentSize? ----------
for d in data:
    d["sum4"] = d["sum"] + d["MonumentSize"]
p4 = max(d["sum4"] for d in data)
print(f"\nrobustness (incl. MonumentSize): peak {p4:.4f} at BCE {[d['BCE'] for d in data if abs(d['sum4']-p4)<1e-12]}")

print("\nDONE")
