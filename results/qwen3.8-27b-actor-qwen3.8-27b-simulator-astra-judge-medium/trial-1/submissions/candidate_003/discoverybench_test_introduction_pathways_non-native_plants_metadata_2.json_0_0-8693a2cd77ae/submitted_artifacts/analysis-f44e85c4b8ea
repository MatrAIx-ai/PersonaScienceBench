import pandas as pd, numpy as np, warnings
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.proportion import proportion_confint
from scipy import stats
pd.set_option("display.width",220); pd.set_option("display.max_columns",50); pd.set_option("display.max_colwidth",60)
warnings.filterwarnings("ignore")

d="data/"
df=pd.read_csv(d+"invaded_niche_pathways.csv", sep="\t")
df["present"]=(df["n.gard"]>0).astype(int)
df["invaded"]=(df["n.total"]>0).astype(int)
df["gard_share"]=np.where(df["n.total"]>0, df["n.gard"]/df["n.total"], np.nan)
# safe names for patsy
df["urban50"]=df["urban.2009.50m"]; df["crop50"]=df["cropland.2009.50m"]
df["elev"]=df["elevation"]; df["droad"]=df["distance.road"]
REF="Scrublands"
log=[]
def P(*a):
    s=" ".join(str(x) for x in a); print(s); log.append(s)

P("="*95); P("ANALYSIS: prevalence of gardening-introduced NNP by habitat type"); P("="*95)
P(f"Data: invaded_niche_pathways.csv | plots n={len(df)} | habitats={df['habitat'].nunique()}")
P(f"Plots with >=1 gardening NNP: {int(df['present'].sum())}/{len(df)} ({df['present'].mean():.3f})")
P(f"Plots invaded at all (n.total>0): {int(df['invaded'].sum())}/{len(df)}")

# ---------- 1) GROUPED SUMMARY TABLE ----------
P("\n"+"#"*95); P("# 1) GROUPED SUMMARY BY HABITAT (95% Wilson CI on prevalence)"); P("#"*95)
rows=[]
for h,sub in df.groupby("habitat"):
    n=len(sub); k=int(sub["present"].sum()); ni=int(sub["invaded"].sum())
    lo,hi=proportion_confint(k,n,method="wilson")
    gs=sub["gard_share"].mean() if ni>0 else np.nan
    gss=sub["n.gard"].sum()/sub["n.total"].sum() if sub["n.total"].sum()>0 else np.nan
    rows.append({"habitat":h,"plots":n,"invaded_plots":ni,"plots_gard":k,
        "prevalence":k/n,"ci_lo":lo,"ci_hi":hi,"mean_n_gard":sub["n.gard"].mean(),
        "gard_share_invaded":gs,"sum_gard_over_sum_total":gss,
        "urban.2009.50m":sub["urban.2009.50m"].mean(),"cropland.2009.50m":sub["cropland.2009.50m"].mean(),
        "elevation":sub["elevation"].mean(),"dist_road":sub["distance.road"].mean()})
table=pd.DataFrame(rows).sort_values("prevalence",ascending=False).reset_index(drop=True)
for c in table.columns:
    if c!="habitat": table[c]=table[c].round(3)
P(table.to_string(index=False))
table.to_csv("artifacts/grouped_summary_habitat.csv",index=False)

top=table.head(4)["habitat"].tolist(); bot=table.tail(4)["habitat"].tolist()
P(f"\nTop-4 by prevalence: {top}")
P(f"Bottom-4 by prevalence: {bot}")
for h in top:
    r=table[table.habitat==h].iloc[0]; P(f"  {h:20s} {r.prevalence:.3f} [{r.ci_lo:.3f},{r.ci_hi:.3f}]")
for h in bot:
    r=table[table.habitat==h].iloc[0]; P(f"  {h:20s} {r.prevalence:.3f} [{r.ci_lo:.3f},{r.ci_hi:.3f}]")
tmin=table[table.habitat.isin(top)]["ci_lo"].min(); bmax=table[table.habitat.isin(bot)]["ci_hi"].max()
P(f"Lowest top-4 CI lower bound={tmin:.3f}; highest bottom-4 CI upper bound={bmax:.3f} -> "
  + ("NO overlap (separated)" if tmin>bmax else "OVERLAP present"))

# ---------- 2) CHI-SQUARE / G-TEST ----------
P("\n"+"#"*95); P("# 2) ASSOCIATION TEST: habitat x (gardening present/absent)"); P("#"*95)
ct=pd.crosstab(df["habitat"],df["present"])
chi2,p,dof,exp=stats.chi2_contingency(ct,correction=False)
P(f"Pearson chi2={chi2:.2f}  df={dof}  p={p:.3e}  min expected cell={exp.min():.2f}")
obs=ct.values.astype(float); rt=obs.sum(1,keepdims=True); ctot=obs.sum(0,keepdims=True); N=obs.sum()
with np.errstate(divide="ignore",invalid="ignore"):
    G=2*np.nansum(np.where(obs>0, obs*np.log(obs/(rt@ctot/N)), 0.0))
P(f"G-test (likelihood ratio)  G={G:.2f}  df={dof}  p={stats.chi2.sf(G,dof):.3e}")
P("(sparse cells present -> prefer binomial GLM below; chi2/G are supplementary)")

# ---------- 3) BINOMIAL GLM: present ~ habitat ----------
P("\n"+"#"*95); P(f"# 3) BINOMIAL GLM  present ~ habitat  (reference = {REF})"); P("#"*95)
fam=sm.families.Binomial()
form=f"present ~ C(habitat, Treatment(reference='{REF}'))"
m=smf.glm(form,data=df,family=fam).fit()
pc2=float(np.sum(m.resid_pearson**2)); disp=pc2/m.df_resid
m0=smf.glm("present~1",data=df,family=fam).fit()
lr=2*(m.llf-m0.llf); lr_p=stats.chi2.sf(lr,m.df_model)
P(f"dispersion (Pearson chi2/df_resid) = {pc2:.1f}/{m.df_resid:.0f} = {disp:.3f}")
P(f"deviance={round(-2*m.llf,1)}  AIC={m.aic:.1f}")
P(f"Overall LR test habitat vs null: LR={lr:.1f} df={m.df_model} p={lr_p:.3e}")
use_quasi = disp>1.0
P(f"overdispersion flag (disp>1): {use_quasi} -> " + ("using QUASIBINOMIAL (dispersion='other')" if use_quasi else "binomial dispersion=1 RETAINED (no overdispersion)"))
rep=None
if use_quasi:
    try:
        rep=smf.glm(form,data=df,family=fam).fit(dispersion="other"); P(f"quasi scale (estimated) = {rep.scale:.3f}")
    except Exception as e:
        P("  dispersion='other' failed:",e,"-> manual SE scaling by sqrt(disp)")
src = rep if rep is not None else m
ci=src.conf_int()
labels=[("(Intercept)="+REF) if x=="Intercept" else x for x in src.params.index]
coef=pd.DataFrame({"term":labels,"coef":src.params.values,"se":src.bse.values,
    "z":(src.params/src.bse).values,"p":src.pvalues.values,
    "ci_lo":ci[0].values,"ci_hi":ci[1].values})
P("\nFull coefficient table (log-odds):")
P(coef.round(4).to_string(index=False))
P("\nNOTE: 'Rock outcrops' has 0 gardening plots (0/57) -> complete separation, SE/CI unbounded (treated as est. ~0).")
# marginal prevalence from coef table
pv=src.params.values
lp=np.concatenate([[pv[0]], pv[0]+pv[1:]])
em=pd.DataFrame({"habitat":[REF if "Intercept" in t else t.split("[T.")[-1].rstrip("]") for t in coef["term"]],
    "marginal_prevalence":1/(1+np.exp(-lp))})
em=em.sort_values("marginal_prevalence",ascending=False)
P("\nModel-based marginal prevalence by habitat (expit of linear predictor):")
P(em.round(3).to_string(index=False))
coef.to_csv("artifacts/glm_habitat_full.csv",index=False)

# ---------- 4) ROBUSTNESS ----------
P("\n"+"#"*95); P("# 4) ROBUSTNESS GLM  present ~ habitat + urban.2009.50m + cropland.2009.50m"); P("#"*95)
form2=f"present ~ C(habitat, Treatment(reference='{REF}')) + urban50 + crop50"
m2=smf.glm(form2,data=df,family=fam).fit()
pc2b=float(np.sum(m2.resid_pearson**2)); disp2=pc2b/m2.df_resid
P(f"dispersion = {pc2b:.1f}/{m2.df_resid:.0f} = {disp2:.3f}  AIC={m2.aic:.1f} (base AIC={m.aic:.1f})")
P(f"urban50 coef={m2.params['urban50']:.3f} (p={m2.pvalues['urban50']:.3e}); "
  f"crop50 coef={m2.params['crop50']:.3f} (p={m2.pvalues['crop50']:.3e})")
c2=pd.DataFrame({"term":list(m2.params.index),"coef":m2.params.values,"se":m2.bse.values,
    "z":(m2.params/m2.bse).values,"p":m2.pvalues.values})
ci2=m2.conf_int(); c2["ci_lo"]=ci2[0].values; c2["ci_hi"]=ci2[1].values
P("\nFull coefficient table (log-odds):")
P(c2.round(4).to_string(index=False))
hab_terms=[t for t in m.params.index if t.startswith("C(habitat")]
cmp=pd.DataFrame({"base":[m.params[t] for t in hab_terms],"robust":[m2.params[t] for t in hab_terms],
    "base_p":[m.pvalues[t] for t in hab_terms],"robust_p":[m2.pvalues[t] for t in hab_terms]},index=hab_terms)
cmp["change"]=cmp["robust"]-cmp["base"]
P("\nHabitat log-odds: base vs +urban+cropland (change):")
P(cmp.round(3).to_string())
c2.to_csv("artifacts/robustness_glm.csv",index=False)

form3=f"present ~ C(habitat, Treatment(reference='{REF}')) + urban50 + crop50 + elev + droad"
m3=smf.glm(form3,data=df,family=fam).fit()
P(f"\n[check] adding elevation+distance.road: AIC={m3.aic:.1f} (vs {m2.aic:.1f}); "
  f"elev p={m3.pvalues.get('elev',np.nan):.3f}, droad p={m3.pvalues.get('droad',np.nan):.3f}")

open("artifacts/analysis_report.txt","w").write("\n".join(log))
P("\nSaved: artifacts/grouped_summary_habitat.csv, glm_habitat_full.csv, robustness_glm.csv, analysis_report.txt")
