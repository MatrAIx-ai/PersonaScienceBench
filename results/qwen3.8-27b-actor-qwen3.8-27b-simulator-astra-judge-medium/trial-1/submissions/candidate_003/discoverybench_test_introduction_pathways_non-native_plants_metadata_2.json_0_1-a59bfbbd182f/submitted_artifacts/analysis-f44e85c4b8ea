#!/usr/bin/env python3
"""DiscoveryBench -- introduction pathways of non-native plants (Catalonia/Barcelona).
Question: In what context does the gardening pathway show different prevalence
styles across habitat types?

Data (note delimiters!):
  data/invaded_niche_pathways.csv            -> TAB-delimited (MAIN)
  data/temporal_trends_contingency_table.csv -> TAB-delimited
  data/invasion_success_pathways.csv         -> comma-delimited
  data/phylogenetic_tree.txt                 -> Newick

Method:
  1) Aggregate n.gard/n.unint/n.agfo/n.total per habitat; gardening share =
     sum(n.gard)/sum(n.total); Wilson 95% CI.
  2) Chi-square independence on habitat x pathway (all habitats + robust subset).
  3) Flag low-confidence habitats (n.total<20).
  4) Descriptive landscape context (means) + Pearson correlation + optional
     plot-level binomial GLM (gardening vs non-gardening).
  5) Temporal cross-check.  6) invasion_success context.
"""
import csv, math, collections
import numpy as np
from scipy import stats
import pandas as pd
import statsmodels.api as sm
from statsmodels.genmod.families import Binomial

def wilson(k, n, z=1.959964):
    if n == 0: return (float('nan'), float('nan'))
    p=k/n; den=1+z*z/n; cen=(p+z*z/(2*n))/den
    half=z*math.sqrt(p*(1-p)/n+z*z/(4*n*n))/den
    return (cen-half, cen+half)

# ---------- load main file ----------
with open("data/invaded_niche_pathways.csv") as f:
    rows=list(csv.reader(f, delimiter="\t"))
hdr=rows[0]; data=rows[1:]
gi,ui,ai,ti=hdr.index("n.gard"),hdr.index("n.unint"),hdr.index("n.agfo"),hdr.index("n.total")
hi=hdr.index("habitat")
agg=collections.defaultdict(lambda:[0,0,0,0])
for x in data:
    a=agg[x[hi]]; a[0]+=int(x[gi]);a[1]+=int(x[ui]);a[2]+=int(x[ai]);a[3]+=int(x[ti])

print("="*82)
print("STEP 1: Per-habitat pathway counts, gardening share, Wilson 95% CI")
print("="*82)
order=sorted(agg,key=lambda k:-agg[k][3])
print(f"{'habitat':<22}{'gard':>5}{'unint':>6}{'agfo':>5}{'total':>6}{'gard%':>8}{'CI_lo%':>8}{'CI_hi%':>8}  conf")
tot=[0,0,0,0]
for k in order:
    g,u,a,t=agg[k]; tot[0]+=g;tot[1]+=u;tot[2]+=a;tot[3]+=t
    lo,hi95=wilson(g,t); conf="LOW(n<20)" if t<20 else ("med" if t<50 else "ok")
    print(f"{k:<22}{g:>5}{u:>6}{a:>5}{t:>6}{100*g/t:>7.1f}%{100*lo:>8.1f}{100*hi95:>8.1f}  {conf}")
g,u,a,t=tot; lo,hi95=wilson(g,t)
print(f"{'TOTAL':<22}{g:>5}{u:>6}{a:>5}{t:>6}{100*g/t:>7.1f}%{100*lo:>8.1f}{100*hi95:>8.1f}")

print("\n"+"="*82)
print("STEP 2: Chi-square independence (habitat x pathway)")
print("="*82)
tabs=np.array([[agg[k][0],agg[k][1],agg[k][2]] for k in order])
chi2,p,dof,exp=stats.chi2_contingency(tabs)
print(f"All habitats:      chi2={chi2:.2f}  dof={dof}  p={p:.2e}   (cells<5: {int((exp<5).sum())}/{exp.size})")
keep=[k for k in order if agg[k][3]>=20]
tabs2=np.array([[agg[k][0],agg[k][1],agg[k][2]] for k in keep])
chi2b,pb,dofb,_=stats.chi2_contingency(tabs2)
print(f"Robust (n.total>=20): chi2={chi2b:.2f}  dof={dofb}  p={pb:.2e}")

print("\n"+"="*82)
print("STEP 4a: Landscape context per habitat (means over plots)")
print("="*82)
covs=["urban.2009.500m","cropland.2009.500m","distance.road","distance.stream","elevation"]
ci={c:hdr.index(c) for c in covs}
acc={c:collections.defaultdict(list) for c in covs}
for x in data:
    for c in covs: acc[c][x[hi]].append(float(x[ci[c]]))
print(f"{'habitat':<22}" + "".join(f"{c:>20}" for c in covs))
for k in order:
    print(f"{k:<22}" + "".join(f"{np.mean(acc[c][k]):>20.3f}" for c in covs))
print("\nPearson r of gardening share vs mean covariate (habitat level, n.total>=20):")
shares=np.array([agg[k][0]/agg[k][3] for k in keep])
for c in covs:
    r,pr=stats.pearsonr(np.array([np.mean(acc[c][k]) for k in keep]),shares)
    print(f"  {c:<20} r={r:+.3f}  p={pr:.3f}   (n={len(keep)} habitats -> low power)")

# optional plot-level binomial GLM
print("\nOptional plot-level binomial GLM (gardening vs non-gardening, n.total>0):")
recs=[]
for x in data:
    t=int(x[ti])
    if t>0:
        recs.append(dict(gard=int(x[gi]), non=t-int(x[gi]), habitat=x[hi],
                         urban=float(x[ci['urban.2009.500m']]),
                         crop=float(x[ci['cropland.2009.500m']]),
                         road=float(x[ci['distance.road']])))
df=pd.DataFrame(recs); df["hab"]=pd.Categorical(df["habitat"])
X=pd.get_dummies(df["hab"],prefix="hab",drop_first=True,dtype=float)
X["urban"]=df["urban"];X["crop"]=df["crop"];X["road"]=df["road"];X=sm.add_constant(X)
y=pd.DataFrame({"gard":df["gard"],"non":df["non"]})
m=sm.GLM(y,X,family=Binomial()).fit()
Xn=pd.DataFrame({"const":np.ones(len(df))}); mn=sm.GLM(y,Xn,family=Binomial()).fit()
lr=2*(m.llf-mn.llf); plr=1-stats.chi2.cdf(lr,X.shape[1]-1)
print(f"  n={len(df)} plots; overall LR vs null: LR={lr:.1f}, df={X.shape[1]-1}, p={plr:.2e}")
for c in ["urban","crop","road"]:
    print(f"  {c:<6} beta={m.params[c]:+.3f}  z={m.tvalues[c]:+.2f}  p={m.pvalues[c]:.3f}")
print("  NOTE: habitat dummies show complete separation (some habitats have 0 non-gardening")
print("  species, e.g. Broad-leaved/Coniferous) -> habitat coefs uninterpretable; model exploratory.")

print("\n"+"="*82)
print("STEP 5: Temporal cross-check (Gardening share of introductions per period)")
print("="*82)
with open("data/temporal_trends_contingency_table.csv") as f:
    tr=list(csv.reader(f,delimiter="\t"))
td=tr[1:]; tab={(r[0],r[1]):int(r[2]) for r in td}
periods=["Before 1500","1501-1900","1901-1984","1985-2019"]; paths=["AgriForest","Gardening","Unintentional"]
print(f"{'period':<14}" + "".join(f"{q:>14}" for q in paths) + f"{'tot':>7}{'Gard%':>8}")
for p in periods:
    tt=sum(tab[(p,q)] for q in paths)
    print(f"{p:<14}" + "".join(f"{tab[(p,q)]:>14}" for q in paths) + f"{tt:>7}{100*tab[(p,'Gardening')]/tt:>7.1f}%")

print("\n"+"="*82)
print("STEP 6: invasion_success context (gardening vs other pathways)")
print("="*82)
with open("data/invasion_success_pathways.csv") as f:
    ir=list(csv.reader(f)); ih=ir[0]; idata=ir[1:]
ip=ih.index("intro.pathway");hn=ih.index("habitat.range");nb=ih.index("invaded.niche.breadth");mrt=ih.index("mrt")
def M(v): return np.mean([float(x) for x in v])
gard=[r for r in idata if r[ip]=="Gardening"]; oth=[r for r in idata if r[ip]!="Gardening"]
print(f"n species gardening={len(gard)}, other={len(oth)}")
print(f"  mean habitat.range        gardening={M([r[hn] for r in gard]):.2f}  other={M([r[hn] for r in oth]):.2f}")
print(f"  mean invaded.niche.breadth gardening={M([r[nb] for r in gard]):.3f}  other={M([r[nb] for r in oth]):.3f}")
t1,p1=stats.ttest_ind([float(r[mrt]) for r in gard],[float(r[mrt]) for r in oth])
print(f"  mean mrt(yr) gardening={M([r[mrt] for r in gard]):.1f}  other={M([r[mrt] for r in oth]):.1f}  (t={t1:.2f}, p={p1:.3f})")
