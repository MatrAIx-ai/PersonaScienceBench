import pandas as pd, numpy as np, warnings
warnings.filterwarnings("ignore")
import patsy
import statsmodels.api as sm
from statsmodels.discrete.discrete_model import Logit

raw=pd.read_csv("data/invaded_niche_pathways.csv",sep="\t")
niche=raw.rename(columns=lambda c:c.replace(".","_"))
sp=pd.read_csv("data/invasion_success_pathways.csv")

years=[1956,1993,2009]; buffers=["50m","500m","1000m"]
cells=[(y,buf) for y in years for buf in buffers]
pathways={"Gardening":"n_gard","Unintentional":"n_unint","AgriForest":"n_agfo"}
CTRL="C(habitat) + elevation + distance_road + distance_stream + annual_temperature + annual_rainfall + annual_radiation"

def fit_count(ucol,response):
    yv=niche[response].values
    y,X=patsy.dmatrices(f"{response} ~ {ucol} + {CTRL}", data=niche, return_type='dataframe')
    return sm.GLM(yv,X,family=sm.families.Poisson()).fit(disp=0,cov_type='HC3')
def fit_logit(ucol,response):
    yv=(niche[response]>0).astype(int).values
    y,X=patsy.dmatrices(f"1 ~ {ucol} + {CTRL}", data=niche, return_type='dataframe')
    return Logit(yv,X).fit(disp=0)
def std_beta(ucol,response,is_logit):
    niche['_uz']=(niche[ucol]-niche[ucol].mean())/niche[ucol].std(ddof=0)
    if is_logit:
        yv=(niche[response]>0).astype(int).values
        y,X=patsy.dmatrices(f"1 ~ _uz + {CTRL}", data=niche, return_type='dataframe')
        return Logit(yv,X).fit(disp=0).params['_uz']
    yv=niche[response].values
    y,X=patsy.dmatrices(f"{response} ~ _uz + {CTRL}", data=niche, return_type='dataframe')
    return sm.GLM(yv,X,family=sm.families.Poisson()).fit(disp=0,cov_type='HC3').params['_uz']

rows=[]
for pname,pcol in pathways.items():
    is_logit=(pname=="AgriForest")
    for (y,buf) in cells:
        ucol=f"urban_{y}_{buf}"
        try:
            m=fit_logit(ucol,pcol) if is_logit else fit_count(ucol,pcol)
            coef=m.params[ucol]; se=m.bse[ucol]; p=m.pvalues[ucol]; ci=m.conf_int().loc[ucol]
            irr=np.exp(coef); bs=std_beta(ucol,pcol,is_logit)
            mt="Logit" if is_logit else "Poisson+HC3"
        except Exception as e:
            coef=se=p=irr=bs=np.nan; ci=[np.nan,np.nan]; mt=f"ERR:{type(e).__name__}"
        rows.append(dict(pathway=pname,year=y,buffer=buf,model=mt,coef=coef,IRR=irr,
                         CI_lo=ci[0],CI_hi=ci[1],p=p,beta_std=bs,
                         mean_urban=niche[ucol].mean(),frac_pos=(niche[pcol]>0).mean(),
                         z=coef/se if se>0 else np.nan))
res=pd.DataFrame(rows)
pd.set_option('display.width',220); pd.set_option('display.max_columns',60)
print("=== ALL 27 MODELS (Poisson+HC3 for counts, Logit for AgriForest) ===")
print(res.round(3).to_string(index=False))
print("\n=== POS vs NEG sign count per pathway ===")
for p in pathways:
    s=res[res.pathway==p].dropna(subset=['coef'])
    print(f"{p}: pos={int((s.coef>0).sum())} neg={int((s.coef<0).sum())} total={len(s)}")
print("\n=== Nominal positive cells (coef>0) among converged models, ranked by z ===")
pos=res[(res.coef>0)&(res.model!='Logit')].dropna(subset=['z']).sort_values('z',ascending=False)
print(pos[['pathway','year','buffer','coef','IRR','CI_lo','CI_hi','p','beta_std','z']].round(3).to_string(index=False))
res.to_csv("all_models.csv",index=False)

