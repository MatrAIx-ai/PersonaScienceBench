# build design matrix with patsy-free approach
import patsy
dmat = patsy.dmatrix('C(habitat) + elevation + Q("cropland.2009.500m") + Q("distance.road") + Q("distance.stream") + Q("annual.temperature") + Q("annual.rainfall")', D)
cov_names = list(dmat.design_info.column_names)
print("Covariate terms:", len(cov_names))

# ---------------- NB profile-likelihood fit ----------------
def nb_fit(y, X, lo=0.05, hi=20.0):
    def negll(alpha):
        try:
            fam = sm.families.NegativeBinomial(alpha=alpha)
            m = sm.GLM(y, X, family=fam).fit(maxiter=150)
            ll = m.llf
            return -ll if np.isfinite(ll) else np.inf
        except Exception:
            return np.inf
    res = minimize_scalar(negll, bounds=(lo,hi), method='bounded', options={'xatol':0.02})
    alpha = float(res.x)
    fam = sm.families.NegativeBinomial(alpha=alpha)
    m = sm.GLM(y, X, family=fam).fit(maxiter=200)
    return m, alpha

def coef_row(m, name):
    b = m.params[name]; se = m.bse[name]; p = m.pvalues[name]
    ci = (b-1.96*se, b+1.96*se)
    return dict(coef=b, ci_lo=ci[0], ci_hi=ci[1], p=p)

def build_X(predictor):
    Xdf = pd.DataFrame(np.asarray(dmat), columns=cov_names).copy()
    Xdf[predictor] = D[predictor].values.astype(float)
    return Xdf


