        print(f"  {pname:12s} urban coef={r['coef']:+.4f} CI[{r['ci_lo']:+.4f},{r['ci_hi']:+.4f}] p={r['p']:.4g} (alpha={alpha:.3f})")
        # recompute Moran's I on corrected residuals
        I,p = moran_pvalue(m.resid_pearson, W, nperm=499)
        print(f"             residual Moran's I={I:+.4f}  perm p={p:.4f}  {'still sig' if p<0.05 else 'corrected'}")
