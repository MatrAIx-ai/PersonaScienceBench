# ---------------- (3) Moran's I on residuals (anchored models) ----------------
print("\n"+"="*90)
print("(3) SPATIAL AUTOCORRELATION: Moran's I on NB-model residuals (anchored urban.2009.500m)")
print("="*90)
lon=D['longitude'].values; lat=D['latitude'].values
coords = np.column_stack([lon,lat])
def knn_weights(c, k=10):
    from scipy.spatial.distance import cdist
    d = cdist(c,c)
    np.fill_diagonal(d, np.inf)
    W = np.zeros_like(d)
    idx = np.argsort(d, axis=1)[:, :k]
    for i in range(len(c)):
        W[i, idx[i]] = 1.0
    W = 0.5*(W+W.T)          # symmetrize
    return W
W = knn_weights(coords, k=10)
S0 = 0.5*np.sum(W*W.T)

def moran(z, W):
    z = np.asarray(z, float); z = z - z.mean()
    n = len(z)
    I = (n/S0) * (z @ (W @ z)) / (z @ z)
    return I

def moran_pvalue(z, W, nperm=999):
    Iobs = moran(z, W)
    rng = np.random.default_rng(0)
    cnt = 0
    for _ in range(nperm):
        zp = rng.permutation(z)
        if abs(moran(zp, W)) >= abs(Iobs):
            cnt += 1
    return Iobs, (cnt+1)/(nperm+1)

moran_res={}
for pname,pcol in paths.items():
    m,_ = anchor_results[pname]
    resid = m.resid_pearson
    I, p = moran_pvalue(resid, W, nperm=999)
    moran_res[pname]=(I,p)
    print(f"  {pname:12s} Moran's I={I:+.4f}  perm p={p:.4f}  {'SIGNIFICANT' if p<0.05 else 'n.s.'}")

# ---------------- PCNM spatial correction if significant ----------------
sp_sig = [p for p in moran_res if moran_res[p][1] < 0.05]
print("\nPathways w/ significant spatial autocorr:", sp_sig if sp_sig else "none")

# build PCNM eigenvectors (positive Moran's eig) once
def pcnm_terms(W, max_terms=20):
    Ws = 0.5*(W+W.T)
    evals, evecs = np.linalg.eigh(Ws)
    # Moran's eigenvalue for each eigenvector
    S0v = 0.5*np.sum(Ws*Ws.T)
    m_eig=[]
    for j in range(len(evals)):
        v = evecs[:,j]
        mv = (len(v)/S0v)*(v @ (Ws @ v))/(v @ v)
        m_eig.append(mv)
    m_eig=np.array(m_eig)
    pos = np.where(m_eig>0)[0]
    # take largest positive Moran's eigenvectors, capped
    pos = pos[np.argsort(-m_eig[pos])][:max_terms]
    mat = evecs[:,pos]
    return mat, m_eig[pos]

spatial_mat=None
if sp_sig:
    spatial_mat, sp_eig = pcnm_terms(W, max_terms=20)
    print(f"PCNM: {spatial_mat.shape[1]} positive-eigenvalue eigenvectors added (max Moran's eig={sp_eig.max():.3f})")
    print("\n  SPATIAL-CORRECTED NB-GLM (anchor urban.2009.500m + covariates + PCNM terms):")
    for pname,pcol in paths.items():
        y=D[pcol].values.astype(float)
        Xf = pd.DataFrame(np.asarray(dmat), columns=cov_names).copy()
        Xf[anchor] = D[anchor].values.astype(float)
