"""
Two-layer analysis: how urban land use affected the invasion of different types
of introduced (non-native) plants in Barcelona province.

Layer A (plot-level, invaded_niche_pathways.csv, 632 plots):
    NB-GLM (log link, NB dispersion alpha estimated by method of moments):
    n.gard / n.unint / n.agfo ~ urban.2009.500m + cropland.2009.500m [if corr<0.7]
    + C(habitat) + elevation + distance.road + distance.stream
    Robustness: 50m / 1000m radii, progressive.1956-2009 change.
Layer B (species-level, invasion_success_pathways.csv, 77 species):
    NB-GLM (log(count+1)) / OLS main effects:
    outcome ~ C(intro.pathway) + C(growth.form) + mrt + native.niche.breadth + height
    (pathway x growth.form interaction = sensitivity only)
Synthesis: integrated natural-language hypothesis.
"""
import warnings
warnings.filterwarnings('ignore')
import pandas as pd, numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
pd.set_option('display.width', 300)

# patsy 1.0.2: rename dotted columns (dots break formula parsing); map back for reporting
def sanitize(df):
    out = df.copy()
    out.columns = [c.replace('.', '_') for c in out.columns]
    return out
S = lambda v: v.replace('.', '_')

# ---------- load ----------
inv_raw = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')   # TAB-separated
inv = sanitize(inv_raw)
suc_raw = pd.read_csv('data/invasion_success_pathways.csv')
print(f"[load] plots: {inv.shape}, species rows: {suc_raw.shape}, missing(inv)={inv.isna().sum().sum()}")

# ---------- clean ----------
suc = sanitize(suc_raw)
before = len(suc)
suc = suc.drop_duplicates(subset='Scientific_name', keep='first').copy()
print(f"[clean] species {before} -> {len(suc)} (dropped {before-len(suc)} duplicated names)")
assert ((inv_raw['n.gard'] + inv_raw['n.unint'] + inv_raw['n.agfo']) == inv_raw['n.total']).all()
print("[clean] plot file: no NAs, pathway counts consistent")

# ---------- Layer A ----------
r_uc = inv['urban_2009_500m'].corr(inv['cropland_2009_500m'])
include_cropland = r_uc < 0.7
print(f"[layerA] corr(urban.2009.500m, cropland.2009.500m) = {r_uc:.3f} -> include cropland: {include_cropland}")

def nb_glm(df, y, x):
    yv = df[S(y)].values
    alpha = max((yv.var() - yv.mean()) / yv.mean()**2, 1e-3)  # method of moments
    m = smf.glm(f"{S(y)} ~ {x}", data=df, family=sm.families.NegativeBinomial(alpha=alpha)).fit()
    return m, alpha

def ci_row(m, v):
    nm = S(v)
    b = m.params[nm]; se = m.bse[nm]
    return b, b - 1.96*se, b + 1.96*se, m.pvalues[nm]

base_x = (S("urban.2009.500m") + (" + " + S("cropland.2009.500m") if include_cropland else "")
          + " + C(habitat) + elevation + " + S("distance.road") + " + " + S("distance.stream"))
rows = []
for y in ['n.gard', 'n.unint', 'n.agfo']:
    m, alpha = nb_glm(inv, y, base_x)
    mp = smf.glm(f"{S(y)} ~ {base_x}", data=inv, family=sm.families.Poisson()).fit()
    print(f"[layerA] {y}: NB LLF={m.llf:.1f} (alpha={alpha:.2f}) vs Poisson LLF={mp.llf:.1f} -> NB {'better' if m.llf>mp.llf else 'not needed'}")
    for v in ['urban.2009.500m'] + (['cropland.2009.500m'] if include_cropland else []):
        b, lo, hi, p = ci_row(m, v)
        rows.append(dict(outcome=y, var=v, N=int(m.nobs), beta=b, lo=lo, hi=hi, p=p))
tabA = pd.DataFrame(rows)
print("\n=== LAYER A: key coefficients (NB-GLM, log link; N=632 plots) ===")
print(tabA.to_string(index=False, float_format=lambda x: f"{x:.3f}"))

# robustness: other radii + 'change' predictor
rob = []
for radius in ['50m', '1000m']:
    x = f"{S('urban.2009.500m').replace('500m', radius)} + C(habitat) + elevation + {S('distance.road')} + {S('distance.stream')}"
    for y in ['n.gard','n.unint','n.agfo']:
        m, _ = nb_glm(inv, y, x)
        b, lo, hi, p = ci_row(m, f'urban.2009.{radius}')
        rob.append(dict(outcome=y, var=f'urban.2009.{radius}', beta=b, lo=lo, hi=hi, p=p))
x_chg = f"{S('progressive.1956.2009.50m')} + C(habitat) + elevation + {S('distance.road')} + {S('distance.stream')}"
for y in ['n.gard','n.unint','n.agfo']:
    m, _ = nb_glm(inv, y, x_chg)
    b, lo, hi, p = ci_row(m, 'progressive.1956.2009.50m')
    rob.append(dict(outcome=y, var='progressive.1956.2009.50m', beta=b, lo=lo, hi=hi, p=p))
tabRob = pd.DataFrame(rob)
print("\n=== LAYER A robustness (radii / change) ===")
print(tabRob.to_string(index=False, float_format=lambda x: f"{x:.3f}"))

# sensitivity: without habitat fixed effect (habitat may mediate urban land use)
x_nohab = (S("urban.2009.500m") + (" + " + S("cropland.2009.500m") if include_cropland else "")
           + " + elevation + " + S("distance.road") + " + " + S("distance.stream"))
rowsNH = []
for y in ['n.gard', 'n.unint', 'n.agfo']:
    m, _ = nb_glm(inv, y, x_nohab)
    b, lo, hi, p = ci_row(m, 'urban.2009.500m')
    rowsNH.append(dict(outcome=y, var='urban.2009.500m (no habitat FE)', N=int(m.nobs), beta=b, lo=lo, hi=hi, p=p))
print("\n=== LAYER A sensitivity: no habitat fixed effect ===")
print(pd.DataFrame(rowsNH).to_string(index=False, float_format=lambda x: f"{x:.3f}"))

# ---------- Layer B ----------
# precompute log1p outcomes (patsy 1.0.2 does not expose numpy log in formula env)
for y, is_log in [('number.of.invaded.plots', True), ('area.of.occupancy.10km', True), ('habitat.range', True)]:
    suc[f"{S(y)}_log1p"] = np.log(suc[S(y)] + 1)

def b_model(y, x, is_log=False):
    if is_log:
        return smf.glm(f"{S(y)}_log1p ~ {x}", data=suc,
                       family=sm.families.NegativeBinomial(alpha=0.3)).fit()
    return smf.glm(f"{S(y)} ~ {x}", data=suc, family=sm.families.Gaussian()).fit()

main_x = "C(intro_pathway) + C(growth_form) + mrt + native_niche_breadth + height"
outcomes = [('number.of.invaded.plots', True), ('area.of.occupancy.10km', True),
            ('invaded.niche.breadth', False), ('habitat.range', True)]
rowsB = []
for y, is_log in outcomes:
    m = b_model(y, main_x, is_log)
    for v in m.params.index:
        if v in ('Intercept','mrt','native_niche_breadth','height'):
            continue
        b, lo, hi, p = m.params[v], *m.conf_int().loc[v], m.pvalues[v]
        rowsB.append(dict(outcome=y, var=v, N=int(m.nobs), beta=b, lo=lo, hi=hi, p=p))
tabB = pd.DataFrame(rowsB)
print("\n=== LAYER B: main effects (ref: pathway=Gardening, growth.form=Annual fg; N=77) ===")
print(tabB.to_string(index=False, float_format=lambda x: f"{x:.3f}"))
print("    (covariates in model: mrt, native.niche.breadth, height)")

m = b_model('number.of.invaded.plots',
            "C(intro_pathway)*C(growth_form) + mrt + native_niche_breadth + height", True)
print("\n[layerB sensitivity] interaction terms (number.of.invaded.plots):")
print(m.params[[v for v in m.params.index if ':' in v]].round(3).to_string())

print("\n=== composition context (species file) ===")
print(pd.crosstab(suc['intro_pathway'], suc['growth_form']).to_string())
print(pd.crosstab(suc['family'], suc['intro_pathway']).sort_values('Unintentional', ascending=False).head(6).to_string())
print("\n[done]")
