import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
rpp = df[df['project'] == 'rpp']
rep = rpp[rpp['replicated'] == 1]

n = len(rep)
vc = rep['seniority.r'].value_counts()

junior_main = {'Assistant Professor', 'Assistant'}
junior_strict = {'Assistant Professor'}
junior_broad = junior_main | {'Researcher'}

def prop(levels):
    return rep['seniority.r'].isin(levels).sum() / n

print(f"rpp rows: {len(rpp)} | rpp replicated==1: {n}")
print(vc.to_string())
print(f"Main (Assistant Professor + Assistant): {rep['seniority.r'].isin(junior_main).sum()}/{n} = {prop(junior_main):.4f}")
print(f"Strict (Assistant Professor only):      {rep['seniority.r'].isin(junior_strict).sum()}/{n} = {prop(junior_strict):.4f}")
print(f"Broad (+ Researcher):                   {rep['seniority.r'].isin(junior_broad).sum()}/{n} = {prop(junior_broad):.4f}")
print(f"NaN in seniority.r (rpp): {rpp['seniority.r'].isna().sum()}")
