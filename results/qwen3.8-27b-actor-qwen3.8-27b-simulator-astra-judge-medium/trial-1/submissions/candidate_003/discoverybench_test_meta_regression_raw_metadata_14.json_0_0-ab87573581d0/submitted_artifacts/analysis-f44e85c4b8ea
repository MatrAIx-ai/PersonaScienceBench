"""FINAL: share of student subjects per discipline (row-level & study-level)."""
import pandas as pd
pd.set_option("display.max_columns", None); pd.set_option("display.width", 260)
F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(F1).rename(columns={"drop": "drop_flag"})

def rep_subject(d):
    """Representative replication subject for a study (id)."""
    a = d[d["aggregated"] == True]
    if len(a):
        return a["subjects.r"].iloc[0]
    vv = d["subjects.r"].dropna()
    return pd.Series(vv).mode().iloc[0] if len(vv) else None

def table(sub):
    rows = []
    for dom in ["Social", "Cognitive", "Economics"]:
        d = sub[sub.discipline == dom]
        o_row = 100 * (d["subjects.o"] == "students").mean()
        r_row = 100 * (d["subjects.r"] == "students").mean()
        o_stu = r_stu = 0; n = 0
        for i in d["id"].unique():
            dd = d[d["id"] == i]; n += 1
            o_stu += int(dd["subjects.o"].iloc[0] == "students")
            r_stu += int(rep_subject(dd) == "students")
        rows.append([dom, len(d), round(o_row,2), round(r_row,2), n,
                     round(100*o_stu/n,2), round(100*r_stu/n,2)])
    return pd.DataFrame(rows, columns=["discipline","n_rows","row_o%","row_r%","n_studies","study_o%","study_r%"])

print("=== PRIMARY (no drop filter) ===")
print(table(df).to_string(index=False))
print("\n=== SENSITIVITY (drop=True removed) ===")
print(table(df[df.drop_flag == False]).to_string(index=False))
