import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
ee = df[df['project'] == 'ee']
uk = (ee['experiment_country.o'] == 'United Kingdom').sum()
total = len(ee)
print(f"ee rows (unique original studies): {total}")
print(f"UK original studies: {uk}")
print(f"proportion: {uk}/{total} = {uk/total:.4f} ({100*uk/total:.2f}%)")
