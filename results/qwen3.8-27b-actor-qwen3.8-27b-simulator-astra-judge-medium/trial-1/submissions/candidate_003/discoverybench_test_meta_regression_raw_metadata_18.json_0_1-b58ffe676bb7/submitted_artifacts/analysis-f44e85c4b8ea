import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
ee = df[df['project'] == 'ee'].copy()

n_pairs = len(ee)
n_orig = ee['title'].nunique()
n_lab_o = int((ee['online.o'] == 0).sum())
n_online_o = int((ee['online.o'] == 1).sum())
n_missing_o = int(ee['online.o'].isna().sum())

# Sensitivity: replications and O/R pairs
n_lab_r = int((ee['online.r'] == 0).sum())
n_missing_r = int(ee['online.r'].isna().sum())

proportion_lab_o = n_lab_o / (n_pairs - n_missing_o)
proportion_lab_r = n_lab_r / (n_pairs - n_missing_r)

print(f"ee rows (O/R pairs): {n_pairs}; unique original studies: {n_orig}")
print(f"online.o: lab(0)={n_lab_o}, online(1)={n_online_o}, missing={n_missing_o}")
print(f"online.r: lab(0)={n_lab_r}, missing={n_missing_r}")
print(f"Proportion lab (original studies, online.o==0): {n_lab_o}/{n_pairs} = {proportion_lab_o:.4f}")
print(f"Proportion lab (replications, online.r==0):    {n_lab_r}/{n_pairs} = {proportion_lab_r:.4f}")
print(f"subjects.o: {ee['subjects.o'].value_counts().to_dict()}")
print(f"subjects.r: {ee['subjects.r'].value_counts().to_dict()}")
