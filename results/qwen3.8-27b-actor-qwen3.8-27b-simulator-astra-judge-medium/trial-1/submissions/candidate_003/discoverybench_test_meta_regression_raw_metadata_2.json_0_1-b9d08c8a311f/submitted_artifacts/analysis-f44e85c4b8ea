"""
Final analysis: average length of original papers in Experimental Economics (ee)
vs Psychology (rpp), from the meta-regression study data CSV.

length = number of pages of original paper (per schema).
Headline = per-row arithmetic mean over ALL rows with project in {ee, rpp}.
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

# Defensive sanitization: keep only rows where length is numeric & non-missing.
df["length_num"] = pd.to_numeric(df["length"], errors="coerce")

results = {}
for p in ["ee", "rpp"]:
    sub = df[(df["project"] == p) & df["length_num"].notna()]
    n_total = int((df["project"] == p).sum())
    n_used = len(sub)
    mean_all = float(sub["length_num"].mean())
    # sensitivity: rows flagged drop=True
    keep = sub[sub["drop"] != True]
    mean_nodrop = float(keep["length_num"].mean()) if len(keep) else float("nan")
    # robustness: per-unique-paper mean (dedupe by title)
    per_paper = sub.drop_duplicates(subset="title")["length_num"].mean()
    results[p] = dict(n_total=n_total, n_used=n_used,
                      n_dropped_invalid=n_total - n_used,
                      mean_all=mean_all, mean_nodrop=mean_nodrop, n_nodrop=len(keep),
                      min=int(sub["length_num"].min()), max=int(sub["length_num"].max()),
                      per_paper_mean=float(per_paper), n_unique_titles=sub["title"].nunique())

for p, r in results.items():
    print(f"project={p}: rows={r['n_total']}, used={r['n_used']} (invalid excluded={r['n_dropped_invalid']}), "
          f"min={r['min']}, max={r['max']}")
    print(f"  HEADLINE mean length (all rows)      = {r['mean_all']:.4f} pages (n={r['n_used']})")
    print(f"  sensitivity, drop=True excluded      = {r['mean_nodrop']:.4f} pages (n={r['n_nodrop']})")
    print(f"  robustness, per unique paper (title) = {r['per_paper_mean']:.4f} pages (n={r['n_unique_titles']})")

ratio = results["ee"]["mean_all"] / results["rpp"]["mean_all"]
print(f"\nee / rpp ratio = {ratio:.2f}")
print(f"\nHYPOTHESIS: Original papers in Experimental Economics (ee) average "
      f"{results['ee']['mean_all']:.1f} pages (n={results['ee']['n_used']}), versus "
      f"{results['rpp']['mean_all']:.1f} pages for Psychology (rpp) originals (n={results['rpp']['n_used']}) "
      f"- i.e., EE originals are roughly {ratio:.1f}x longer.")
