import pandas as pd

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
print("total rows:", len(df))
print("discipline counts:\n", df["discipline"].value_counts(dropna=False))
print("missing authors_male.o:", df["authors_male.o"].isna().sum())
print("missing authors_male.r:", df["authors_male.r"].isna().sum())

d = df[["discipline", "authors_male.o", "authors_male.r"]].copy()
d["maj_o"] = d["authors_male.o"] > 0.5
d["maj_r"] = d["authors_male.r"] > 0.5
d["maj_o_incl_tie"] = d["authors_male.o"] >= 0.5
d["maj_r_incl_tie"] = d["authors_male.r"] >= 0.5
d["tie_o"] = d["authors_male.o"] == 0.5
d["tie_r"] = d["authors_male.r"] == 0.5

g = d.groupby("discipline").agg(
    n=("discipline", "size"),
    mean_o=("authors_male.o", "mean"),
    mean_r=("authors_male.r", "mean"),
    share_maj_o=("maj_o", "mean"),
    share_maj_r=("maj_r", "mean"),
    share_maj_o_tie=("maj_o_incl_tie", "mean"),
    share_maj_r_tie=("maj_r_incl_tie", "mean"),
    ties_o=("tie_o", "sum"),
    ties_r=("tie_r", "sum"),
    n_o_na=("authors_male.o", lambda s: s.isna().sum()),
    n_r_na=("authors_male.r", lambda s: s.isna().sum()),
)
pd.set_option("display.width", 200)
print("\nPer-discipline table (strict >0.5, plus >=0.5 cross-check, mean ratios):")
print(g.round(4).to_string())

# Dominant discipline: >50% majority-male in both o and r
both_strict = g[(g.share_maj_o > 0.5) & (g.share_maj_r > 0.5)]
both_tie = g[(g.share_maj_o_tie > 0.5) & (g.share_maj_r_tie > 0.5)]
print("\nDisciplines >50% majority-male in BOTH (strict):", list(both_strict.index))
print("Disciplines >50% majority-male in BOTH (incl ties):", list(both_tie.index))
