"""
DiscoveryBench — NLS Incarceration: 1985 Median Wealth by Demographics
=======================================================================
Question: What demographic disparities exist in 1985 median wealth among
          individuals who were ever incarcerated?

Data: data/nls_incarceration_processed.csv (NLSY79 cohort, n=12,013)
Columns: race, sex, ever_jailed, composite_wealth_1985/1990/1996
"""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')

# Relabel for readability; code still filters on literal string 'hipanic'
df['race_label'] = df['race'].replace({'hipanic': 'Hispanic'})

jailed    = df[df['ever_jailed'] == 1].copy()
notjailed = df[df['ever_jailed'] == 0].copy()

W = 'composite_wealth_1985'

def med_table(grp, by, order):
    """Return a DataFrame of median, IQR, n for a group by a categorical var."""
    rows = []
    for v in order:
        s = grp[grp[by] == v][W]
        rows.append({
            'group': v,
            'median': s.median(),
            'q1': s.quantile(.25),
            'q3': s.quantile(.75),
            'n': len(s),
        })
    return pd.DataFrame(rows)

# ──────────────────────────────────────────────────────────────────
# TABLE 1 — Race-only medians (lead, larger n, more stable)
# ──────────────────────────────────────────────────────────────────
race_order = ['white', 'black', 'Hispanic']
t_race_j   = med_table(jailed,    'race_label', race_order)
t_race_nj  = med_table(notjailed, 'race_label', race_order)

print("=" * 72)
print("TABLE 1 — Median composite_wealth_1985 BY RACE")
print("=" * 72)
hdr = f"{'Race':<12s} | {'Jailed med':>10s} {'IQR':>18s} {'n':>5s} | {'Not-jailed med':>14s} {'IQR':>18s} {'n':>6s}"
print(hdr)
print("-" * 72)
for i, r in enumerate(race_order):
    j, n = t_race_j.iloc[i], t_race_nj.iloc[i]
    flag = " *" if j['n'] < 20 else ""
    print(f"{r:<12s} | {j['median']:>10,.0f}  [{j['q1']:>6,.0f},{j['q3']:>6,.0f}] {int(j['n']):>5d}{flag} | {n['median']:>14,.0f}  [{n['q1']:>6,.0f},{n['q3']:>6,.0f}] {int(n['n']):>6d}")
print("  (* n < 20 — interpret with caution)")

# ──────────────────────────────────────────────────────────────────
# TABLE 2 — Sex-only medians
# ──────────────────────────────────────────────────────────────────
sex_order = ['male', 'female']
t_sex_j   = med_table(jailed,    'sex', sex_order)
t_sex_nj  = med_table(notjailed, 'sex', sex_order)

print()
print("=" * 72)
print("TABLE 2 — Median composite_wealth_1985 BY SEX")
print("=" * 72)
print(hdr)
print("-" * 72)
for i, s in enumerate(sex_order):
    j, n = t_sex_j.iloc[i], t_sex_nj.iloc[i]
    flag = " *" if j['n'] < 20 else ""
    print(f"{s:<12s} | {j['median']:>10,.0f}  [{j['q1']:>6,.0f},{j['q3']:>6,.0f}] {int(j['n']):>5d}{flag} | {n['median']:>14,.0f}  [{n['q1']:>6,.0f},{n['q3']:>6,.0f}] {int(n['n']):>6d}")
print("  (* n < 20 — interpret with caution)")

# ──────────────────────────────────────────────────────────────────
# TABLE 3 — Race × Sex cross-tab (jailed only, supplementary)
# ──────────────────────────────────────────────────────────────────
print()
print("=" * 72)
print("TABLE 3 — RACE × SEX CROSS-TAB, JAILED ONLY (supplementary)")
print("=" * 72)
ct = jailed.groupby(['race_label','sex'])[W].agg(median='median', n='count',
                                                   q1=lambda x: x.quantile(.25),
                                                   q3=lambda x: x.quantile(.75))
print(f"{'Race':<12s} {'Sex':<8s} {'Median':>8s} {'Q1':>8s} {'Q3':>10s} {'n':>5s}  Flag")
print("-" * 60)
for (r, s), row in ct.iterrows():
    n = int(row['n'])
    flag = "n<20 CAVEAT" if n < 20 else ""
    print(f"{r:<12s} {s:<8s} {row['median']:>8,.0f} {row['q1']:>8,.0f} {row['q3']:>10,.0f} {n:>5d}  {flag}")

# ──────────────────────────────────────────────────────────────────
# TABLE 4 — Compact contrast: jailed vs not-jailed (race & sex)
# ──────────────────────────────────────────────────────────────────
print()
print("=" * 72)
print("TABLE 4 — CONTRAST: Jailed vs Not-jailed median (race & sex)")
print("=" * 72)
print(f"{'Group':<12s} {'Jailed med':>11s} {'n':>5s}  {'Not-jailed med':>14s} {'n':>6s}  {'J/NJ ratio':>11s}")
print("-" * 72)
for col, vals in [('race_label', race_order), ('sex', sex_order)]:
    for v in vals:
        jm = jailed[jailed[col]==v][W].median()
        jn = len(jailed[jailed[col]==v])
        nm = notjailed[notjailed[col]==v][W].median()
        nn = len(notjailed[notjailed[col]==v])
        ratio = f"{jm/nm:.2f}" if nm != 0 else "N/A"
        print(f"{v:<12s} {jm:>11,.0f} {jn:>5d}  {nm:>14,.0f} {nn:>6d}  {ratio:>11s}")

# ──────────────────────────────────────────────────────────────────
# SUPPLEMENTARY checks
# ──────────────────────────────────────────────────────────────────
print()
print("=" * 72)
print("SUPPLEMENTARY")
print("=" * 72)
print(f"Overall jailed median:   {jailed[W].median():>8,.0f}  (n={len(jailed)})")
print(f"Overall not-jailed med:  {notjailed[W].median():>8,.0f}  (n={len(notjailed)})")
neg_j = (jailed[W] < 0).sum(); neg_nj = (notjailed[W] < 0).sum()
print(f"Negative 1985 wealth — jailed: {neg_j}/{len(jailed)} ({100*neg_j/len(jailed):.1f}%),  not-jailed: {neg_nj}/{len(notjailed)} ({100*neg_nj/len(notjailed):.1f}%)")
zero_j = (jailed[W] == 0).sum(); zero_nj = (notjailed[W] == 0).sum()
print(f"Zero 1985 wealth — jailed: {zero_j}/{len(jailed)} ({100*zero_j/len(jailed):.1f}%),  not-jailed: {zero_nj}/{len(notjailed)} ({100*zero_nj/len(notjailed):.1f}%)")

