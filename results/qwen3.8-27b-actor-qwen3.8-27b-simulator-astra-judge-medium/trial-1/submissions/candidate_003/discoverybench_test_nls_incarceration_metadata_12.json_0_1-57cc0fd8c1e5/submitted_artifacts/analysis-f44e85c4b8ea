"""
Analysis: How does incarceration affect the wealth of black individuals,
by baseline economic status (1985 composite wealth bins as income proxy)?

Data: data/nls_incarceration_processed.csv (NLSY79 cohort extract)
- black respondents only (n=3,013): 159 ever_jailed (1985-1994, residence-derived binary),
  2,854 not.
- Outcomes: composite_wealth_1990, composite_wealth_1996 (5-component sum).
- Income is NOT in the data; 1985 composite wealth is used as the baseline
  economic status proxy (4 bins), flagged as an assumption.
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
import scipy.stats as st

pd.set_option("display.width", 200)

df = pd.read_csv("data/nls_incarceration_processed.csv")
blk = df[df["race"] == "black"].copy()

BINS = [-np.inf, 0, 5000, 20000, np.inf]
LABELS = ["<=0", "1-5k", "5-20k", ">20k"]
blk["wbin"] = pd.cut(blk["composite_wealth_1985"], bins=BINS, labels=LABELS)
WAVES = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]

print("=" * 78)
print("1) SAMPLE: black respondents, jailed vs not, by 1985 wealth bin")
print("=" * 78)
print(blk.groupby(["wbin", "ever_jailed"], observed=True).size().unstack(fill_value=0))
print("total black:", len(blk), "| jailed:", int(blk.ever_jailed.sum()))

print()
print("=" * 78)
print("2) DESCRIPTIVE TABLE by bin: mean / median / pct-positive per wave")
print("=" * 78)
for b in LABELS:
    sub = blk[blk.wbin == b]
    print(f"\n--- 1985 wealth bin: {b}  (n={len(sub)}) ---")
    rows = []
    for g, name in [(0, "not jailed"), (1, "jailed")]:
        s = sub[sub.ever_jailed == g]
        row = {"group": name, "n": len(s)}
        for w in WAVES:
            row[w + "_mean"] = round(s[w].mean(), 0)
            row[w + "_med"] = s[w].median()
            row[w + "_pctpos"] = round((s[w] > 0).mean() * 100, 1)
        rows.append(row)
    print(pd.DataFrame(rows).to_string(index=False))

print()
print("=" * 78)
print("3) GAPS (jailed - not jailed) by bin and wave: mean gap, median gap")
print("=" * 78)
gap_rows = []
for b in LABELS:
    sub = blk[blk.wbin == b]
    for w in WAVES:
        j = sub[sub.ever_jailed == 1][w]
        n = sub[sub.ever_jailed == 0][w]
        gap_rows.append({"bin": b, "wave": w,
                         "mean_gap": round(j.mean() - n.mean(), 0),
                         "med_gap": round(j.median() - n.median(), 0),
                         "n_jail": len(j), "n_not": len(n)})
gap_all = []
for w in WAVES:
    j = blk[blk.ever_jailed == 1][w]
    n = blk[blk.ever_jailed == 0][w]
    gap_all.append({"bin": "ALL", "wave": w,
                    "mean_gap": round(j.mean() - n.mean(), 0),
                    "med_gap": round(j.median() - n.median(), 0),
                    "n_jail": len(j), "n_not": len(n)})
gapdf = pd.DataFrame(gap_rows + gap_all)
print(gapdf.to_string(index=False))

print()
print("=" * 78)
print("4) OVERALL (black): jailed vs not, all waves")
print("=" * 78)
ov = blk.groupby("ever_jailed").apply(
    lambda s: pd.Series({
        "n": len(s),
        "w85_mean": s.composite_wealth_1985.mean(), "w90_mean": s.composite_wealth_1990.mean(),
        "w96_mean": s.composite_wealth_1996.mean(),
        "w85_med": s.composite_wealth_1985.median(), "w90_med": s.composite_wealth_1990.median(),
        "w96_med": s.composite_wealth_1996.median(),
        "w96_pctpos": (s.composite_wealth_1996 > 0).mean() * 100,
        "w90_pctpos": (s.composite_wealth_1990 > 0).mean() * 100}), include_groups=False)
print(ov.round(1).to_string())

print()
print("=" * 78)
print("5) REGRESSIONS (black sample), robust (HC1) SEs")
print("=" * 78)
m = blk.copy()
m["j"] = m.ever_jailed
m["bin1"] = (m.wbin == "1-5k").astype(int)
m["bin2"] = (m.wbin == "5-20k").astype(int)
m["bin3"] = (m.wbin == ">20k").astype(int)   # ref = <=0
m["female"] = (m.sex == "female").astype(int)

def show(fit, title):
    print(f"\n--- {title} ---")
    print(f"  n={int(fit.nobs)}, R2={fit.rsquared:.3f}")
    for term in fit.params.index:
        if term in ("Intercept",):
            continue
        print(f"  {term:28s} coef={fit.params[term]:12.2f}  se={fit.bse[term]:12.2f}  "
              f"p={fit.pvalues[term]:.4f}")

# M1: main effect + bin dummies + sex, outcome 1996
show(smf.ols("composite_wealth_1996 ~ j + bin1 + bin2 + bin3 + female", data=m).fit(cov_type="HC1"),
     "M1: 1996 ~ jailed + 1985 bins + sex")
# M2: interaction jailed x bins, outcome 1996
show(smf.ols("composite_wealth_1996 ~ j * (bin1 + bin2 + bin3) + female", data=m).fit(cov_type="HC1"),
     "M2: 1996 ~ jailed x 1985-bin interaction + sex")
# M3: 1990 outcome, main effect
show(smf.ols("composite_wealth_1990 ~ j + bin1 + bin2 + bin3 + female", data=m).fit(cov_type="HC1"),
     "M3: 1990 ~ jailed + 1985 bins + sex")
# M4: log1p(1996)
m["logw96"] = np.log1p(m.composite_wealth_1996)
show(smf.ols("logw96 ~ j + bin1 + bin2 + bin3 + female", data=m).fit(cov_type="HC1"),
     "M4: log1p(1996) ~ jailed + 1985 bins + sex")
# M5: p99-winsorized 1996
w96 = m.composite_wealth_1996
cap = w96.quantile(0.99)
m["w96w"] = w96.clip(upper=cap)
show(smf.ols("w96w ~ j + bin1 + bin2 + bin3 + female", data=m).fit(cov_type="HC1"),
     f"M5: p99-winsorized 1996 (cap={cap:.0f}) ~ jailed + bins + sex")

print()
print("=" * 78)
print("6) SENSITIVITY: black males only (n_jail=143)")
print("=" * 78)
mm = m[m.sex == "male"].copy()
show(smf.ols("composite_wealth_1996 ~ j + bin1 + bin2 + bin3", data=mm).fit(cov_type="HC1"),
     "M6: males, 1996 ~ jailed + 1985 bins")
show(smf.ols("composite_wealth_1996 ~ j * (bin1 + bin2 + bin3)", data=mm).fit(cov_type="HC1"),
     "M7: males, 1996 ~ jailed x 1985-bin interaction")
# descriptive gaps males
gapm = []
for b in LABELS + ["ALL"]:
    sub = mm if b == "ALL" else mm[mm.wbin == b]
    for w in ["composite_wealth_1990", "composite_wealth_1996"]:
        j = sub[sub.j == 1][w]; n = sub[sub.j == 0][w]
        gapm.append({"bin": b, "wave": w[-4:], "mean_gap": round(j.mean() - n.mean(), 0),
                     "med_gap": round(j.median() - n.median(), 0)})
print("\nmales-only mean/median gaps:")
print(pd.DataFrame(gapm).to_string(index=False))

print()
print("=" * 78)
print("7) SIGN TEST on mean gaps (jailed-not) across 4 bins x 2 post-baseline waves")
print("=" * 78)
gaps = gapdf[gapdf.bin != "ALL"]["mean_gap"].values
print("per-bin mean gaps (1990, 1996):", gaps)
print("all negative?", bool((gaps < 0).all()))
