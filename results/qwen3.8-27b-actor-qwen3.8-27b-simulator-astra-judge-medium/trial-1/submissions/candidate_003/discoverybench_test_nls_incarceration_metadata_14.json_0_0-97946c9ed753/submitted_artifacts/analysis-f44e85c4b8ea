import csv, statistics as st
path="data/nls_incarceration_processed.csv"
rows=list(csv.DictReader(open(path)))
bf=[r for r in rows if r["race"]=="black" and r["sex"]=="female"]
print("black_female_n",len(bf))
def num(x):
    x=(x or "").strip()
    return None if x=="" else float(x)
cols={"1985":"composite_wealth_1985","1990":"composite_wealth_1990","1996":"composite_wealth_1996"}
med={}
for yr,c in cols.items():
    v=[num(r[c]) for r in bf]; v=[x for x in v if x is not None]
    med[yr]=st.median(v)
    print(yr,"median",med[yr],"n",len(v))
d1=med["1990"]-med["1985"]; d2=med["1996"]-med["1990"]
print("diff_1985_1990",d1)
print("diff_1990_1996",d2)
print("largest_gap","1985->1990" if d1>d2 else "1990->1996")
