"""
Full analysis: wealth inequality for white males vs females, NLSY79, 1990 -> 1996.
Question: What changes occurred in the wealth inequality for white males and females between 1990 and 1996?

Design (approved plan):
  - Subset: race == 'white', split by sex; waves 1990 and 1996 (1985 = trend context only).
  - Variants:
      V1 full sample        : zeros & negatives kept (Gini shifted by |min|+1)
      V2 positive-only      : wealth > 0 (guards against 1996 zero-as-missing)
      V3 winsorized 1-99pct : bounds extreme tails
      V4 deduplicated rows  : drop exact-duplicate rows (robustness)
  - Metrics: Gini, CV (SD/mean), P90/P10, P90/P50, top20/bottom20 mean ratio (positive subsample), mean/median.
  - Change 1990->1996 per group; male-female gap per metric and its change.
  - Robustness: exclude ever_jailed==1; V4 dedup.
  - NO person ID in file -> distributional (between-wave) comparison only; unweighted.
"""
import pandas as pd
import numpy as np

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 30)

df = pd.read_csv('data/nls_incarceration_processed.csv')
w = df[df['race'] == 'white'].copy()
YEARS = [1990, 1996]
SEXES = ['male', 'female']

def gini(x):
    x = np.sort(np.asarray(x, float))
    n = len(x)
    if n == 0:
        return np.nan
    if x.min() < 0:
        x = x + abs(x.min()) + 1.0
    s = x.sum()
    if s == 0:
        return np.nan
    return (2.0 * np.sum(np.arange(1, n + 1) * x) - (n + 1) * s) / (n * s)

def top_bot_ratio_pos(v):
    """Top-20% vs bottom-20% mean ratio on the POSITIVE subsample."""
    p = v[v > 0]
    if len(p) == 0:
        return np.nan
    lo, hi = p.quantile(0.2), p.quantile(0.8)
    bot = p[p <= lo]
    top = p[p >= hi]
    if bot.mean() == 0 or len(bot) == 0 or len(top) == 0:
        return np.nan
    return top.mean() / bot.mean()

def metrics(v, variant):
    """v: raw (float) series for one group x year; variant in {V1,V2,V3}."""
    if variant == 'V2':
        x = v[v > 0]
    elif variant == 'V3':
        lo, hi = v.quantile(0.01), v.quantile(0.99)
        x = v.clip(lo, hi)
    else:  # V1
        x = v
    n = len(x)
    mean, med, sd = x.mean(), x.median(), x.std()
    q10, q50, q90 = x.quantile(0.10), x.quantile(0.50), x.quantile(0.90)
    p90_p10 = (q90 / q10) if q10 > 0 else np.inf
    p90_p50 = (q90 / q50) if q50 > 0 else np.inf
    return {
        'n': n,
        'mean': mean, 'median': med, 'sd': sd,
        'p10': q10, 'p50': q50, 'p90': q90,
        'gini': gini(x),
        'cv': sd / mean if mean != 0 else np.nan,
        'p90_p10': p90_p10, 'p90_p50': p90_p50,
        'top20_bot20_pos': top_bot_ratio_pos(v if variant == 'V1' else x),
        'mean_over_median': mean / med if med != 0 else np.nan,
        'zero_share': (v == 0).mean(),
        'neg_share': (v < 0).mean(),
    }

# ---------------- collect ----------------
rows = []
for dedup in [False, True]:
    base = w.drop_duplicates() if dedup else w
    for sex in SEXES:
        for yr in YEARS:
            v = base[base['sex'] == sex][f'composite_wealth_{yr}'].astype(float)
            for var in ['V1', 'V2', 'V3']:
                m = metrics(v, var)
                rows.append({'dedup': dedup, 'sex': sex, 'year': yr, 'variant': var, **m})
res = pd.DataFrame(rows)

def show(dedup=False, var='V1'):
    d = res[(res.dedup == dedup) & (res.variant == var)]
    cols = ['sex', 'year', 'n', 'mean', 'median', 'sd', 'p10', 'p50', 'p90',
            'gini', 'cv', 'p90_p10', 'p90_p50', 'top20_bot20_pos', 'mean_over_median',
            'zero_share', 'neg_share']
    t = d[cols].set_index(['sex', 'year'])
    print(t.round(3).to_string())

print('=' * 100)
print('STEP 2/3 — DISTRIBUTIONS + INEQUALITY METRICS  (raw rows)')
print('=' * 100)
for var in ['V1', 'V2', 'V3']:
    print(f'\n--- {var} ---')
    show(dedup=False, var=var)

# ---------------- STEP 4: change 1990 -> 1996 ----------------
print('\n' + '=' * 100)
print('STEP 4 — CHANGE 1990 -> 1996  (delta = 1996 - 1990; pct = delta/1990*100)')
print('=' * 100)
METRICS = ['gini', 'cv', 'p90_p50', 'p90_p10', 'top20_bot20_pos', 'mean_over_median', 'mean', 'median']
chg_rows = []
for var in ['V1', 'V2', 'V3']:
    for sex in SEXES:
        d = res[(res.dedup == False) & (res.variant == var) & (res.sex == sex)]
        m90 = d[d.year == 1990].iloc[0]
        m96 = d[d.year == 1996].iloc[0]
        for met in METRICS:
            a, b = m90[met], m96[met]
            if np.isinf(a) or np.isinf(b):
                chg_rows.append({'variant': var, 'sex': sex, 'metric': met,
                                 'v1990': a, 'v1996': b, 'delta': np.nan, 'pct': np.nan})
            else:
                chg_rows.append({'variant': var, 'sex': sex, 'metric': met,
                                 'v1990': a, 'v1996': b, 'delta': b - a,
                                 'pct': (b - a) / a * 100 if a != 0 else np.nan})
chg = pd.DataFrame(chg_rows)
print(chg.round(3).to_string(index=False))

# ---------------- STEP 5: male-female gap ----------------
print('\n' + '=' * 100)
print('STEP 5 — MALE vs FEMALE GAP  (gap = male - female; gap_change = gap1996 - gap1990)')
print('=' * 100)
gap_rows = []
for var in ['V1', 'V2', 'V3']:
    for met in ['gini', 'cv', 'p90_p50', 'top20_bot20_pos', 'mean_over_median', 'mean', 'median']:
        for yr in YEARS:
            d = res[(res.dedup == False) & (res.variant == var) & (res.year == yr)]
            m = d[d.sex == 'male'].iloc[0][met]
            f = d[d.sex == 'female'].iloc[0][met]
            gap_rows.append({'variant': var, 'metric': met, 'year': yr,
                             'male': m, 'female': f, 'gap_M_minus_F': m - f})
gap = pd.DataFrame(gap_rows)
piv = gap.pivot_table(index=['variant', 'metric'], columns='year', values='gap_M_minus_F')
piv['gap_change_90_to_96'] = piv[1996] - piv[1990]
print(piv.round(3).to_string())

# level gap (wealth levels, V1)
print('\nLevel gap context (V1, mean/median wealth):')
for yr in YEARS:
    d = res[(res.dedup == False) & (res.variant == 'V1') & (res.year == yr)]
    m = d[d.sex == 'male'].iloc[0]; f = d[d.sex == 'female'].iloc[0]
    print(f"  {yr}: male mean={m['mean']:,.0f} med={m['median']:,.0f} | female mean={f['mean']:,.0f} med={f['median']:,.0f} | "
          f"mean ratio M/F={m['mean']/f['mean']:.3f}, median ratio M/F={m['median']/f['median']:.3f}")

# ---------------- STEP 6: robustness ----------------
print('\n' + '=' * 100)
print('STEP 6 — ROBUSTNESS')
print('=' * 100)
# R1: exclude ever_jailed == 1
r1 = w[w.ever_jailed == 0]
print('\nR1: exclude ever_jailed==1 (white n =', len(r1), ')')
r1rows = []
for sex in SEXES:
    for yr in YEARS:
        v = r1[r1.sex == sex][f'composite_wealth_{yr}'].astype(float)
        for var in ['V1', 'V2']:
            mm = metrics(v, var)
            r1rows.append({'sex': sex, 'year': yr, 'variant': var, 'gini': mm['gini'],
                           'p90_p50': mm['p90_p50'], 'top20_bot20_pos': mm['top20_bot20_pos'],
                           'mean': mm['mean'], 'median': mm['median']})
r1r = pd.DataFrame(r1rows)
print(r1r.round(3).to_string(index=False))

# R2: deduplicated (V4)
print('\nR2: V4 deduplicated rows (white n =', len(w.drop_duplicates()), ')')
for var in ['V1', 'V2']:
    print(f'--- {var} ---')
    show(dedup=True, var=var)

# ---------------- save tables ----------------
res.to_csv('results_all_metrics.csv', index=False)
chg.to_csv('results_change_1990_1996.csv', index=False)
gap.to_csv('results_male_female_gap.csv', index=False)
piv.to_csv('results_gap_change.csv')
r1r.to_csv('results_robustness_excl_jailed.csv', index=False)
print('\nSaved: results_all_metrics.csv, results_change_1990_1996.csv, results_male_female_gap.csv, results_gap_change.csv, results_robustness_excl_jailed.csv')
