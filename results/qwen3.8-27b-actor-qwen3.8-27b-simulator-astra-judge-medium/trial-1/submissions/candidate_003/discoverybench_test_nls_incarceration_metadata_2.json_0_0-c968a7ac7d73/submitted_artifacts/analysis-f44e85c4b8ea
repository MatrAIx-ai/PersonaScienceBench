"""
NLS Incarceration: in which years do individuals with a criminal record
(ever_jailed=1) have significantly LOWER wealth than those without?
Wealth measures: composite_wealth_1985/1990/1996.
Primary: raw Mann-Whitney U (one-sided, jailed < non-jailed) per year.
Secondary: OLS of wealth-rank ~ ever_jailed + race + sex (demographic control).
Multiple-testing: Benjamini-Hochberg FDR over the 3 years (raw + two-sided).
"""
import pandas as pd, numpy as np
from scipy import stats
from statsmodels.stats.multitest import multipletests
import statsmodels.api as sm

df = pd.read_csv("data/nls_incarceration_processed.csv")
n0 = len(df)
df = df.drop_duplicates(keep="first").reset_index(drop=True)
print(f"rows: {n0} raw -> {len(df)} after dropping {n0-len(df)} exact duplicates")

years = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]

def rank_biserial(a, b):
    U = stats.mannwhitneyu(a, b, alternative="two-sided").statistic
    return U / (len(a) * len(b))

print("\n========== PRIMARY: raw Mann-Whitney U (one-sided: jailed < non-jailed) ==========")
rows = []
for c in years:
    y = c.split("_")[-1]
    a = df.loc[df.ever_jailed == 1, c]   # jailed
    b = df.loc[df.ever_jailed == 0, c]   # non-jailed
    U, p1 = stats.mannwhitneyu(a, b, alternative="less")
    _, p2 = stats.mannwhitneyu(a, b, alternative="two-sided")
    r = rank_biserial(a, b)
    rows.append((y, len(a), a.median(), len(b), b.median(), U, p1, p2, r))
    print(f"[{y}] jailed n={len(a)} median={a.median():.0f} | non-jailed n={len(b)} median={b.median():.0f}")
    print(f"       U={U:.1f}  p_one={p1:.3e}  p_two={p2:.3e}  rank-biserial r={r:.3f}")

p1 = [r[6] for r in rows]; p2 = [r[7] for r in rows]
rej1, q1, _, _ = *multipletests(p1, method="fdr_bh")[:2], None, None
rej2, q2, _, _ = *multipletests(p2, method="fdr_bh")[:2], None, None
print("\n========== FDR (Benjamini-Hochberg) over 3 years ==========")
for i, y in enumerate(r[0] for r in rows):
    print(f"[{y}] p_one={p1[i]:.3e} q_one={q1[i]:.3e} sig={rej1[i]} | "
          f"p_two={p2[i]:.3e} q_two={q2[i]:.3e} sig={rej2[i]}")

print("\n========== SECONDARY: OLS rank(wealth) ~ ever_jailed + race + sex ==========")
for c in years:
    y = c.split("_")[-1]
    d = df.copy()
    d["rank"] = d[c].rank()
    X = pd.DataFrame({
        "jailed": d.ever_jailed,
        "race_black": (d.race == "black").astype(int),
        "race_hip": (d.race == "hipanic").astype(int),
        "sex_male": (d.sex == "male").astype(int),
    })
    X = sm.add_constant(X)
    m = sm.OLS(d["rank"], X).fit()
    ci = m.conf_int().loc["jailed"]
    print(f"[{y}] jailed coef={m.params['jailed']:.1f} rank-units "
          f"p={m.pvalues['jailed']:.3e} 95CI[{ci[0]:.1f},{ci[1]:.1f}]  "
          f"(race_black p={m.pvalues['race_black']:.1e}, race_hip p={m.pvalues['race_hip']:.1e}, "
          f"sex_male p={m.pvalues['sex_male']:.3f})  n={int(m.nobs)}")
