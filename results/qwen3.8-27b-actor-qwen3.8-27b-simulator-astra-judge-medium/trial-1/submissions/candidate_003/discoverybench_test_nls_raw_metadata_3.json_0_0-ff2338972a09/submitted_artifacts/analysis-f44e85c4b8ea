import pandas as pd, numpy as np
import statsmodels.formula.api as smf
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

pd.set_option('display.width', 200)
df = pd.read_csv('data/nls_raw.csv')
n0 = len(df)

# ---------- 1. Clean ----------
gcol = 'Highest grade completed, 1979'
df[gcol] = pd.to_numeric(df[gcol], errors='coerce')
df = df[(df[gcol] < 20) & (df[gcol] >= 0)]          # drop 95.0 artifacts
n1 = len(df)

inc = 'Total net family income, previous calendar year, 1979'
asv = ['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
       'ASVAB - Word Knowledge Z Score (rounded), 1981',
       'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
       'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
rk  = 'Rank in class last year attended at this school, 1981'
cs  = 'Number of students in class last year attended at this school, 1981'
race= 'Racial/ethnic cohort, 1979'
sex = 'Sex of respondent, 1979'

df['grade'] = df[gcol]
df['log_income'] = np.log1p(df[inc].clip(lower=0))
df['asvab_comp'] = df[asv].mean(axis=1)
df['z_asvab'] = (df['asvab_comp'] - df['asvab_comp'].mean()) / df['asvab_comp'].std()
df['rank_pct'] = df[rk] / df[cs]                       # 1 = bottom of class
df['z_rank']   = (df['rank_pct'] - df['rank_pct'].mean()) / df['rank_pct'].std()
df['black']    = (df[race] == 1).astype(float)
df['hisp']     = (df[race] == 2).astype(float)
df['female']   = (df[sex] == 2).astype(float)
df['ge13'] = (df['grade'] >= 13).astype(float)

print(f"n after artifact drop: {n0} -> {n1}")

# ---------- 2. Descriptives by race ----------
lab = {1:'BLACK',2:'HISPANIC',3:'WB/other'}
desc = df.groupby(race)[[gcol,'log_income','asvab_comp','rank_pct']].agg(['count','mean','std'])
print("\n=== DESCRIPTIVES BY RACE ===")
print(desc.round(3).T)
print("outcome mean binary >=13 by race:")
print(df.assign(ge13=(df[gcol]>=13).astype(float)).groupby(race)['ge13'].agg(['count','mean']).round(3))

# ---------- 3. Race-differential missingness ----------
df['asvab_missing'] = df['asvab_comp'].isna().astype(int)
df['inc_missing']   = df['log_income'].isna().astype(int)
df['rank_missing']  = df['z_rank'].isna().astype(int)
print("\n=== MISSINGNESS x RACE (pct of group) ===")
for v in ['asvab_missing','inc_missing','rank_missing']:
    t = df.groupby(race)[v].agg(['count','mean'])
    t.index = [lab[i] for i in t.index]
    print(f"\n{v}:")
    print((t*100).round(2))
    means = t['mean']*100
    print("max-min gap across race groups (pp):", round(means.max()-means.min(),2))

# ---------- 4. M1 / M2 OLS ----------
def fit(f, data):
    m = smf.ols(f, data=data).fit(cov_type='HC1')
    return m

d1 = df.dropna(subset=[gcol,'log_income','black','hisp','female'])
m1 = fit(f'grade ~ log_income + black + hisp + female', d1)
d2 = d1.dropna(subset=['z_asvab'])
m1c = fit(f'grade ~ log_income + black + hisp + female', d2)
m2 = fit(f'grade ~ log_income + black + hisp + female + z_asvab', d2)

def show(m, tag):
    print(f"\n=== {tag} (n={int(m.nobs)}) ===")
    p = m.params; b = m.bse; pv = m.pvalues
    for k in ['log_income','black','hisp','female','z_asvab','z_rank']:
        if k in p:
            print(f"  {k:12s} beta={p[k]: .4f} SE={b[k]: .4f} p={pv[k]: .4f}")
    print(f"  R2={m.rsquared:.4f}")

show(m1, 'M1: grade ~ SES + race + sex')
show(m1c, 'M1c: M1 on M2 sample (nested)')
show(m2, 'M2: M1 + ASVAB composite')

# VIF M2
X = sm.add_constant(d2[['log_income','black','hisp','female','z_asvab']].astype(float))
vif = pd.DataFrame({'var': X.columns[1:], 'VIF': [variance_inflation_factor(X.values, i) for i in range(1, X.shape[1])]})
print("\n=== VIF (M2) ===")
print(vif.round(2).to_string(index=False))

# Delta table
print("\n=== DELTA TABLE (OLS, continuous grade) ===")
rows=[]
for k in ['log_income','black','hisp']:
    b1, b2 = m1c.params[k], m2.params[k]
    rows.append([k, b1, b2, b2-b1, 100*(b2-b1)/abs(b1) if b1 else np.nan])
print(pd.DataFrame(rows, columns=['var','M1_beta','M2_beta','delta','pct_attenuation']).round(4).to_string(index=False))

# ---------- 5. Binary sensitivity: logistic grade>=13 ----------
lb1 = smf.logit('ge13 ~ log_income + black + hisp + female', d1).fit(disp=0)
lb2 = smf.logit('ge13 ~ log_income + black + hisp + female + z_asvab', d2).fit(disp=0)
print("\n=== BINARY SENSITIVITY (logistic, grade>=13) ===")
for tag, m in [('M1', lb1), ('M2', lb2)]:
    print(f"\n{tag} (n={int(m.nobs)}, base rate={m.model.endog.mean():.3f})")
    for k in ['log_income','black','hisp','female','z_asvab']:
        if k in m.params:
            print(f"  {k:12s} OR={np.exp(m.params[k]): .3f}  95%CI[{np.exp(m.params[k]-1.96*m.bse[k]): .3f},{np.exp(m.params[k]+1.96*m.bse[k]): .3f}]  p={m.pvalues[k]: .4f}")
print("\n=== DELTA OR (binary) ===")
for k in ['log_income','black','hisp']:
    o1, o2 = np.exp(lb1.params[k]), np.exp(lb2.params[k])
    print(f"  {k:12s} OR M1={o1:.3f}  OR M2={o2:.3f}  change={100*(o2-o1)/o1:+.1f}%")

# ---------- 6. Rank subsample (Model 2b / 2b without rank) ----------
dr = d2.dropna(subset=['z_rank'])
m2b  = fit(f'grade ~ log_income + black + hisp + female + z_asvab', dr)
m2br = fit(f'grade ~ log_income + black + hisp + female + z_asvab + z_rank', dr)
show(m2b,  'M2b check (M2 spec, rank subsample)')
show(m2br, 'M2b: M2 + rank percentile (rank subsample)')
print("\n=== DELTA TABLE (rank subsample: M1r vs M2br) ===")
m1r = fit(f'grade ~ log_income + black + hisp + female', dr)
rows=[]
for k in ['log_income','black','hisp']:
    b1, b2 = m1r.params[k], m2br.params[k]
    rows.append([k, b1, b2, b2-b1, 100*(b2-b1)/abs(b1) if b1 else np.nan])
print(pd.DataFrame(rows, columns=['var','M1_beta','M2b_beta','delta','pct_attenuation']).round(4).to_string(index=False))
