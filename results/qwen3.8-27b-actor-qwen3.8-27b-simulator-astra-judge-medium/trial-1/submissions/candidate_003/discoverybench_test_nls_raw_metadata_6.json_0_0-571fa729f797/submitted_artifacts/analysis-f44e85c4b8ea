import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import warnings
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_raw.csv')
race_map = {1: 'BLACK', 2: 'HISPANIC', 3: 'NON-BLACK NON-HISPANIC'}
df['race_label'] = df['Racial/ethnic cohort, 1979'].map(race_map)

grade_var = 'Highest grade completed, 1979'
inc79_var = 'Total net family income, previous calendar year, 1979'
wealth85_var = 'Family net wealth, 1985'
mom_edu_var = "Highest grade completed by respondent's mother, 1979"
age_var = 'Age of respondent, 1979'
sex_var = 'Sex of respondent, 1979'

df['grade_valid'] = df[grade_var].notna() & (df[grade_var] != 95)
df['hs_plus'] = (df[grade_var] >= 12).astype(int)

main = df[
    df['race_label'].isin(['BLACK', 'NON-BLACK NON-HISPANIC']) &
    (df[age_var] >= 18) & df['grade_valid']
].copy()

print("=" * 70)
print("  ANALYSIS SAMPLE (age >= 18, valid grade, Black + Non-Black)")
print("=" * 70)
print("  Total: {}".format(len(main)))
print("  BLACK: {}".format((main['race_label']=='BLACK').sum()))
print("  NON-BLACK: {}".format((main['race_label']=='NON-BLACK NON-HISPANIC').sum()))

inc_available = main[main[inc79_var].notna()].copy()
qcuts = np.percentile(inc_available[inc79_var], [20, 40, 60, 80])
print("  Income quintile cuts: {:.0f}, {:.0f}, {:.0f}, {:.0f}".format(*qcuts))

main['inc_q'] = pd.cut(main[inc79_var], bins=[-1, qcuts[0], qcuts[1], qcuts[2], qcuts[3], float('inf')],
                       labels=['Q1','Q2','Q3','Q4','Q5'])
main_cc = main[main['inc_q'].notna()].copy()
print("  Complete-case (with income): {}".format(len(main_cc)))

def wilson_ci(k, n, z=1.96):
    if n == 0: return (0, 0)
    p = k / n
    denom = 1 + z*z/n
    center = (p + z*z/(2*n)) / denom
    half = z * np.sqrt(p*(1-p)/n + z*z/(4*n*n)) / denom
    return (center - half, center + half)

# (a) STRATIFIED RATES
print("\n" + "=" * 70)
print("  (a) HS+ RATES BY RACE WITHIN INCOME QUINTILE (95% CI)")
print("=" * 70)
bounds = [-1, qcuts[0], qcuts[1], qcuts[2], qcuts[3], 9999999]
for i, q in enumerate(['Q1','Q2','Q3','Q4','Q5']):
    hi_label = "${:.0f}+".format(bounds[i+1]) if i==4 else "${:.0f}".format(bounds[i+1])
    print("\n  {} (${:.0f} - {}):".format(q, bounds[i], hi_label))
    for race in ['BLACK', 'NON-BLACK NON-HISPANIC']:
        sub = main_cc[(main_cc['inc_q']==q) & (main_cc['race_label']==race)]
        n, k = len(sub), sub['hs_plus'].sum()
        rate = k/n if n > 0 else 0
        lo, hi = wilson_ci(k, n)
        print("    {:<22s}: n={:>4d}, HS+={:>4d}, {:.1%} [{:.1%}-{:.1%}]".format(race, n, k, rate, lo, hi))
    b = main_cc[(main_cc['inc_q']==q) & (main_cc['race_label']=='BLACK')]
    nb = main_cc[(main_cc['inc_q']==q) & (main_cc['race_label']=='NON-BLACK NON-HISPANIC')]
    gap = nb['hs_plus'].mean() - b['hs_plus'].mean()
    print("    GAP (NB-B): {:.1%} ({:+.1f} pp)".format(gap, gap*100))

# (b) LOGISTIC REGRESSION
print("\n" + "=" * 70)
print("  (b) LOGISTIC REGRESSION")
print("=" * 70)

model_df = main_cc.copy()
model_df['race_black'] = (model_df['race_label'] == 'BLACK').astype(int)
model_df['log_income'] = np.log(model_df[inc79_var] + 1)
model_df['sex_male'] = (model_df[sex_var] == 1).astype(int)
model_df['race_x_loginc'] = model_df['race_black'] * model_df['log_income']

X1 = model_df[['race_black', 'log_income', 'race_x_loginc', 'sex_male', age_var]].copy()
X1 = sm.add_constant(X1)
X1.columns = ['const', 'race_black', 'log_income', 'race_x_loginc', 'sex_male', 'age']
y1 = model_df['hs_plus'].values

m1 = sm.Logit(y1, X1).fit(disp=0)
print("\n  Model 1: HS+ ~ race_black * log(income) + sex + age  (n={})".format(len(y1)))
for name in m1.params.index:
    print("    {:18s}: coef={:>8.4f}, SE={:.4f}, p={:.4f}, OR={:.4f}".format(
        name, m1.params[name], m1.bse[name], m1.pvalues[name], np.exp(m1.params[name])))
print("\n  KEY: interaction race_x_loginc: coef={:.4f}, p={:.4f}".format(
    m1.params['race_x_loginc'], m1.pvalues['race_x_loginc']))

# Quintile interaction
q_dummies = pd.get_dummies(model_df['inc_q'], prefix='iq', drop_first=True, dtype=int)
model_df = pd.concat([model_df, q_dummies], axis=1)
q_cols = list(q_dummies.columns)
interact_cols = ['rb_x_' + c for c in q_cols]
for i, c in enumerate(q_cols):
    model_df[interact_cols[i]] = model_df['race_black'] * model_df[c]

X2 = model_df[['race_black'] + q_cols + interact_cols + ['sex_male', age_var]].copy()
X2 = sm.add_constant(X2)
X2.columns = ['const', 'race_black'] + q_cols + interact_cols + ['sex_male', 'age']
m2 = sm.Logit(y1, X2).fit(disp=0)

print("\n  Model 2: HS+ ~ race_black x income_quintile + sex + age")
for c in interact_cols:
    print("    {:20s}: coef={:>8.4f}, p={:.4f}".format(c, m2.params[c], m2.pvalues[c]))

r_matrix = np.zeros((len(interact_cols), len(X2.columns)))
for i, c in enumerate(interact_cols):
    r_matrix[i, list(X2.columns).index(c)] = 1
ft = m2.f_test(r_matrix)
print("\n  JOINT F-test of race x quintile interactions: F={:.4f}, p={:.6f}".format(ft.fvalue, ft.pvalue))

# (c) GAP PER QUINTILE
print("\n" + "=" * 70)
print("  (c) RACIAL GAP PER QUINTILE + TREND TEST")
print("=" * 70)
gaps = []
for q in ['Q1','Q2','Q3','Q4','Q5']:
    b = main_cc[(main_cc['inc_q']==q) & (main_cc['race_label']=='BLACK')]
    nb = main_cc[(main_cc['inc_q']==q) & (main_cc['race_label']=='NON-BLACK NON-HISPANIC')]
    n_b, k_b = len(b), b['hs_plus'].sum()
    n_nb, k_nb = len(nb), nb['hs_plus'].sum()
    rate_b, rate_nb = k_b/n_b, k_nb/n_nb
    gap = rate_nb - rate_b
    se_gap = np.sqrt(rate_b*(1-rate_b)/n_b + rate_nb*(1-rate_nb)/n_nb)
    z = gap / se_gap
    p = 2 * (1 - stats.norm.cdf(abs(z)))
    gaps.append({'q': q, 'gap': gap, 'se': se_gap})
    print("  {}: gap={:.1%} ({:+.1f}pp), SE={:.4f}, z={:.2f}, p={:.4f}".format(q, gap, gap*100, se_gap, z, p))

gap_arr = np.array([g['gap'] for g in gaps])
q_arr = np.array([1,2,3,4,5])
slope, intercept, r, p_trend, se_slope = stats.linregress(q_arr, gap_arr)
print("\n  Linear trend in gap: {:.2f} pp/quintile, r={:.3f}, p={:.4f}".format(slope*100, r, p_trend))
print("  Q1 gap {:.1f}pp -> Q5 gap {:.1f}pp: change = {:+.1f} pp".format(gaps[0]['gap']*100, gaps[4]['gap']*100, (gaps[4]['gap']-gaps[0]['gap'])*100))

# (d) MISSINGNESS
print("\n" + "=" * 70)
print("  (d) MISSINGNESS / SELECTION NOTE")
print("=" * 70)
age18 = df[df['race_label'].isin(['BLACK','NON-BLACK NON-HISPANIC']) & (df[age_var]>=18) & df['grade_valid']]
for race in ['BLACK','NON-BLACK NON-HISPANIC']:
    sub = age18[age18['race_label']==race]
    n, n_miss = len(sub), sub[inc79_var].isna().sum()
    print("  {} age>=18: n={}, income 1979 missing: {} ({:.1f}%)".format(race, n, n_miss, n_miss/n*100))
miss_inc = age18[age18[inc79_var].isna()]
valid_inc = age18[age18[inc79_var].notna()]
print("\n  Missing income: mean age={:.1f}, %male={:.1f}%".format(miss_inc[age_var].mean(), (miss_inc[sex_var]==1).mean()*100))
print("  Valid income:   mean age={:.1f}, %male={:.1f}%".format(valid_inc[age_var].mean(), (valid_inc[sex_var]==1).mean()*100))

# SENSITIVITY 1: WEALTH 1985
print("\n" + "=" * 70)
print("  SENSITIVITY 1: 1985 FAMILY NET WEALTH (terciles)")
print("=" * 70)
main_w = main[main[wealth85_var].notna()].copy()
tcuts = np.percentile(main_w[wealth85_var], [33.3, 66.7])
main_w['wt'] = pd.cut(main_w[wealth85_var], bins=[float('-inf'),tcuts[0],tcuts[1],float('inf')], labels=['T1','T2','T3'])
print("  n={}".format(len(main_w)))
for t in ['T1','T2','T3']:
    for race in ['BLACK','NON-BLACK NON-HISPANIC']:
        sub = main_w[(main_w['wt']==t) & (main_w['race_label']==race)]
        n, k = len(sub), sub['hs_plus'].sum()
        rate = k/n if n>0 else 0
        lo,hi = wilson_ci(k,n)
        print("  {} {:<22s}: n={:>4d}, {:.1%} [{:.1%}-{:.1%}]".format(t, race, n, rate, lo, hi))
    b = main_w[(main_w['wt']==t) & (main_w['race_label']=='BLACK')]
    nb = main_w[(main_w['wt']==t) & (main_w['race_label']=='NON-BLACK NON-HISPANIC')]
    if len(b)>0 and len(nb)>0:
        print("  {} GAP: {:.1%}".format(t, nb['hs_plus'].mean()-b['hs_plus'].mean()))

# SENSITIVITY 2: MOTHER'S EDUCATION
print("\n" + "=" * 70)
print("  SENSITIVITY 2: MOTHER'S EDUCATION (groups)")
print("=" * 70)
main_m = main[main[mom_edu_var].notna()].copy()
main_m['mg'] = pd.cut(main_m[mom_edu_var], bins=[-1,8,12,15,20], labels=['<=8','9-12','13-15','16+'])
print("  n={}".format(len(main_m)))
for g in ['<=8','9-12','13-15','16+']:
    for race in ['BLACK','NON-BLACK NON-HISPANIC']:
        sub = main_m[(main_m['mg']==g) & (main_m['race_label']==race)]
        n, k = len(sub), sub['hs_plus'].sum()
        rate = k/n if n>0 else 0
        lo,hi = wilson_ci(k,n)
        print("  {} {:<22s}: n={:>4d}, {:.1%} [{:.1%}-{:.1%}]".format(g, race, n, rate, lo, hi))
    b = main_m[(main_m['mg']==g) & (main_m['race_label']=='BLACK')]
    nb = main_m[(main_m['mg']==g) & (main_m['race_label']=='NON-BLACK NON-HISPANIC')]
    if len(b)>0 and len(nb)>0:
        print("  {} GAP: {:.1%}".format(g, nb['hs_plus'].mean()-b['hs_plus'].mean()))

# GRADE >= 16 DESCRIPTIVE
print("\n" + "=" * 70)
print("  GRADE >= 16 (BA+) - DESCRIPTIVE ONLY")
print("=" * 70)
for race in ['BLACK','NON-BLACK NON-HISPANIC']:
    sub = main[main['race_label']==race]
    n, k = len(sub), (sub[grade_var]>=16).sum()
    print("  {}: n={}, grade>=16: {} ({:.2f}%)".format(race, n, k, k/n*100))

# SUMMARY
print("\n" + "=" * 70)
print("  SUMMARY")
print("=" * 70)
rb = main_cc['race_label']=='BLACK'
nb = main_cc['race_label']=='NON-BLACK NON-HISPANIC'
print("  Overall: BLACK {:.1%} (n={}), NON-BLACK {:.1%} (n={}), gap={:.1%}".format(
    main_cc[rb]['hs_plus'].mean(), rb.sum(),
    main_cc[nb]['hs_plus'].mean(), nb.sum(),
    main_cc[nb]['hs_plus'].mean()-main_cc[rb]['hs_plus'].mean()))
print("  Gaps Q1-Q5: {:.1%}, {:.1%}, {:.1%}, {:.1%}, {:.1%}".format(*[g['gap'] for g in gaps]))
print("  Trend: {:.2f}pp/quintile (p={:.4f})".format(slope*100, p_trend))
print("  Logit interaction (log inc): p={:.4f}".format(m1.pvalues['race_x_loginc']))
print("  Joint F-test (quintiles): F={:.4f}, p={:.6f}".format(ft.fvalue, ft.pvalue))
