import csv
import statistics

# ── 1. Load data ──────────────────────────────────────────────────────────────
with open('/workspace/data/nls_raw.csv', 'r') as f:
    reader = csv.reader(f)
    header = next(reader)
    rows = list(reader)

race_idx  = header.index('Racial/ethnic cohort, 1979')
w85_idx   = header.index('Family net wealth, 1985')
w90_idx   = header.index('Family net wealth, 1990')
w96_idx   = header.index('Family net wealth, 1996 (key data point)')

race_labels = {'1': 'BLACK', '2': 'HISPANIC', '3': 'NON-BLACK NON-HISPANIC'}
waves = [('1985', w85_idx, 'w85'), ('1990', w90_idx, 'w90'), ('1996', w96_idx, 'w96')]

def to_float(val):
    val = val.strip()
    if val == '':
        return None
    try:
        return float(val)
    except ValueError:
        return None

# Build structured records
records = []
for row in rows:
    rec = {
        'race':   row[race_idx].strip(),
        'w85':    to_float(row[w85_idx]),
        'w90':    to_float(row[w90_idx]),
        'w96':    to_float(row[w96_idx]),
    }
    records.append(rec)

# ── 2. Main 3×3 median table (full per-cell samples) ─────────────────────────
def median_by_group(subset, wave_key):
    """Return {race_code: (median, n)} for the given wave key."""
    result = {}
    for code in ['1', '2', '3']:
        vals = [r[wave_key] for r in subset if r['race'] == code and r[wave_key] is not None]
        if vals:
            result[code] = (statistics.median(vals), len(vals))
        else:
            result[code] = (None, 0)
    return result

main_table = {}
matched_table = {}

# Full per-cell sample
for wname, _, wkey in waves:
    main_table[wname] = median_by_group(records, wkey)

# Matched cohort: only respondents with non-missing wealth in ALL three waves
matched = [r for r in records if r['w85'] is not None and r['w90'] is not None and r['w96'] is not None]
print(f"Matched cohort size: {len(matched)}")
for wname, _, wkey in waves:
    matched_table[wname] = median_by_group(matched, wkey)

# ── 3. Print both tables side by side ────────────────────────────────────────
def print_table(table, title):
    print(f"\n{'='*70}")
    print(f"  {title}")
    print(f"{'='*70}")
    print(f"{'Race Group':<28} {'1985 Median':>12} {'N':>6} {'1990 Median':>12} {'N':>6} {'1996 Median':>12} {'N':>6}")
    print(f"{'-'*70}")
    for code in ['1', '2', '3']:
        label = race_labels[code]
        vals = [table[w][code] for w in ['1985', '1990', '1996']]
        cells = []
        for med, n in vals:
            if med is not None:
                cells.append(f"{med:>12,.0f} {n:>6}")
            else:
                cells.append(f"{'N/A':>12} {0:>6}")
        print(f"{label:<28} {' '.join(cells)}")

print_table(main_table, "MAIN TABLE: Full per-cell samples (listwise deletion)")
print_table(matched_table, "SENSITIVITY: Matched cohort (non-missing in all 3 waves)")

# ── 4. Gap tables ────────────────────────────────────────────────────────────
def compute_gaps(table):
    """Return list of (wave, comparison, abs_gap, ratio) tuples."""
    gaps = []
    for wname in ['1985', '1990', '1996']:
        med3 = table[wname]['3'][0]  # NON-BLACK NON-HISPANIC
        med1 = table[wname]['1'][0]  # BLACK
        med2 = table[wname]['2'][0]  # HISPANIC
        if med3 is not None and med1 is not None:
            gaps.append((wname, 'vs BLACK', med3 - med1, med3 / med1 if med1 != 0 else None))
        if med3 is not None and med2 is not None:
            gaps.append((wname, 'vs HISPANIC', med3 - med2, med3 / med2 if med2 != 0 else None))
    return gaps

main_gaps = compute_gaps(main_table)
matched_gaps = compute_gaps(matched_table)

print(f"\n{'='*70}")
print(f"  GAP TABLE: MAIN (full per-cell samples)")
print(f"{'='*70}")
print(f"{'Wave':<8} {'Comparison':<14} {'Abs Gap ($)':>14} {'Ratio (3x/1x)':>14}")
print(f"{'-'*70}")
for wname, comp, abs_gap, ratio in main_gaps:
    ratio_s = f"{ratio:.2f}x" if ratio is not None else "N/A"
    print(f"{wname:<8} {comp:<14} {abs_gap:>14,.0f} {ratio_s:>14}")

print(f"\n{'='*70}")
print(f"  GAP TABLE: MATCHED COHORT (sensitivity)")
print(f"{'='*70}")
print(f"{'Wave':<8} {'Comparison':<14} {'Abs Gap ($)':>14} {'Ratio (3x/1x)':>14}")
print(f"{'-'*70}")
for wname, comp, abs_gap, ratio in matched_gaps:
    ratio_s = f"{ratio:.2f}x" if ratio is not None else "N/A"
    print(f"{wname:<8} {comp:<14} {abs_gap:>14,.0f} {ratio_s:>14}")

# ── 5. Compare main vs matched gaps ──────────────────────────────────────────
print(f"\n{'='*70}")
print(f"  SENSITIVITY COMPARISON: Main vs Matched-Cohort Gaps")
print(f"{'='*70}")
print(f"{'Wave':<8} {'Comparison':<14} {'Main':>12} {'Matched':>12} {'Diff %':>10}")
print(f"{'-'*70}")
for (w1, c1, a1, r1), (w2, c2, a2, r2) in zip(main_gaps, matched_gaps):
    if a1 != 0:
        diff_pct = (a2 - a1) / abs(a1) * 100
    else:
        diff_pct = None
    diff_s = f"{diff_pct:+.1f}%" if diff_pct is not None else "N/A"
    print(f"{w1:<8} {c1:<14} {a1:>12,.0f} {a2:>12,.0f} {diff_s:>10}")

# ── 6. Matched cohort race composition ───────────────────────────────────────
print(f"\n{'='*70}")
print(f"  MATCHED COHORT RACE COMPOSITION")
print(f"{'='*70}")
for code in ['1', '2', '3']:
    n = sum(1 for r in matched if r['race'] == code)
    print(f"  {race_labels[code]}: {n} ({n/len(matched)*100:.1f}%)")

# ── 7. Build hypothesis text ─────────────────────────────────────────────────
# Extract key numbers for the narrative
m85 = {c: main_table['1985'][c][0] for c in ['1','2','3']}
m90 = {c: main_table['1990'][c][0] for c in ['1','2','3']}
m96 = {c: main_table['1996'][c][0] for c in ['1','2','3']}

n85 = {c: main_table['1985'][c][1] for c in ['1','2','3']}
n90 = {c: main_table['1990'][c][1] for c in ['1','2','3']}
n96 = {c: main_table['1996'][c][1] for c in ['1','2','3']}

# Matched
mm85 = {c: matched_table['1985'][c][0] for c in ['1','2','3']}
mm96 = {c: matched_table['1996'][c][0] for c in ['1','2','3']}

hyp = []
hyp.append("HYPOTHESIS: Median family net wealth in the NLSY79 cohort shows persistent and substantial racial/ethnic gaps from 1985 through 1996.")
hyp.append("")
hyp.append("Using the National Longitudinal Survey of Youth 1979 (NLSY79) cohort (n=12,686), we computed the median family net wealth for three racial/ethnic groups — Black (code 1), Hispanic (code 2), and non-Black, non-Hispanic (code 3; the available proxy for the 'white' group, as this category also includes Asian, Native American, and other races) — at three time points: 1985, 1990, and 1996. Wealth is measured at the family (household) level, not per individual.")
hyp.append("")
hyp.append(f"In 1985, the median family net wealth was ${m85['3']:,.0f} for non-Black, non-Hispanic respondents (n={n85['3']}), ${m85['1']:,.0f} for Black respondents (n={n85['1']}), and ${m85['2']:,.0f} for Hispanic respondents (n={n85['2']}). The non-Black, non-Hispanic median exceeded the Black median by ${m85['3']-m85['1']:,.0f} ({m85['3']/m85['1']:.1f}×) and the Hispanic median by ${m85['3']-m85['2']:,.0f} ({m85['3']/m85['2']:.1f}×).")
hyp.append("")
hyp.append(f"By 1990, medians had risen across all groups: ${m90['3']:,.0f} (non-Black, non-Hispanic, n={n90['3']}), ${m90['1']:,.0f} (Black, n={n90['1']}), and ${m90['2']:,.0f} (Hispanic, n={n90['2']}). The gaps persisted: the non-Black, non-Hispanic median was ${m90['3']-m90['1']:,.0f} ({m90['3']/m90['1']:.1f}×) above the Black median and ${m90['3']-m90['2']:,.0f} ({m90['3']/m90['2']:.1f}×) above the Hispanic median.")
hyp.append("")
hyp.append(f"By 1996, medians had increased further: ${m96['3']:,.0f} (non-Black, non-Hispanic, n={n96['3']}), ${m96['1']:,.0f} (Black, n={n96['1']}), and ${m96['2']:,.0f} (Hispanic, n={n96['2']}). The non-Black, non-Hispanic median remained ${m96['3']-m96['1']:,.0f} ({m96['3']/m96['1']:.1f}×) above the Black median and ${m96['3']-m96['2']:,.0f} ({m96['3']/m96['2']:.1f}×) above the Hispanic median.")
hyp.append("")

# Sensitivity check narrative
mg85_black = mm85['3'] - mm85['1']
mg96_black = mm96['3'] - mm96['1']
mg85_hisp = mm85['3'] - mm85['2']
mg96_hisp = mm96['3'] - mm96['2']
magn85_black = m85['3'] - m85['1']
magn96_black = m96['3'] - m96['1']
magn85_hisp = m85['3'] - m85['2']
magn96_hisp = m96['3'] - m96['2']

diff85_black = (mg85_black - magn85_black) / abs(magn85_black) * 100 if magn85_black != 0 else 0
diff96_black = (mg96_black - magn96_black) / abs(magn96_black) * 100 if magn96_black != 0 else 0
diff85_hisp = (mg85_hisp - magn85_hisp) / abs(magn85_hisp) * 100 if magn85_hisp != 0 else 0
diff96_hisp = (mg96_hisp - magn96_hisp) / abs(magn96_hisp) * 100 if magn96_hisp != 0 else 0

hyp.append(f"Sensitivity check (matched cohort): Restricting to the {len(matched)} respondents with non-missing wealth in all three waves, the gap direction and rough magnitude hold. The 1985 non-Black, non-Hispanic vs. Black gap is ${mg85_black:,.0f} (vs. ${magn85_black:,.0f} in the full sample, {diff85_black:+.1f}%); the 1996 gap is ${mg96_black:,.0f} (vs. ${magn96_black:,.0f}, {diff96_black:+.1f}%). The Hispanic gaps show a similar pattern ({diff85_hisp:+.1f}% in 1985, {diff96_hisp:+.1f}% in 1996). The matched-cohort gaps are in the same direction and of comparable magnitude, supporting the robustness of the main findings despite differential attrition.")
hyp.append("")
hyp.append("Direction of change: Median family net wealth increased across all three groups from 1985 to 1996, consistent with cohort aging and general wealth accumulation. The absolute gaps between the non-Black, non-Hispanic group and both the Black and Hispanic groups widened over this period, while the ratio gaps remained substantial throughout. The non-Black, non-Hispanic group maintained the highest median family net wealth at every time point.")
hyp.append("")
hyp.append("Limitations: (1) The 'non-Black, non-Hispanic' category (code 3) is used as a proxy for 'white' individuals; it includes Asian, Native American, and other races, so the reported gaps are 'non-Black, non-Hispanic vs. Black/Hispanic,' not strictly 'white vs. Black/Hispanic.' (2) Wealth is measured at the family (household) level, not per individual; family net wealth is not equivalent to per-person wealth. (3) The three time points (1985, 1990, 1996) are discrete cross-sections, not a continuous trend; we characterize direction of change between them but cannot model a trajectory. (4) Missingness increases substantially across waves (20.4% in 1985, 26.7% in 1990, 44.5% in 1996) and is differential by race — the non-Black, non-Hispanic group has the highest missingness in every wave (52.6% by 1996 vs. 31.7% for Black). The non-missing sample composition shifts across waves, which could bias the 1996 comparison. The matched-cohort sensitivity check (n=5,739) shows the gaps are directionally stable under this restriction. (5) No sampling weights were available; results are unweighted sample medians, not population estimates. (6) The median is used rather than the mean due to extreme right-skew in the wealth distribution (skewness 5–15×, with 10–13% of observed values negative).")

hypothesis_text = '\n'.join(hyp)
print(f"\n{'='*70}")
print(f"  HYPOTHESIS TEXT")
print(f"{'='*70}")
print(hypothesis_text)

# Save hypothesis to file
with open('/workspace/hypothesis.txt', 'w') as f:
    f.write(hypothesis_text)

print(f"\n[Done. Hypothesis saved to /workspace/hypothesis.txt]")
