import pandas as pd, numpy as np
import statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['race_black'] = (df['SAMPLE_RACE']=='Black').astype(int)
df['race_hisp']  = (df['SAMPLE_RACE']=='Hispanic').astype(int)
df['male']       = (df['SAMPLE_SEX']=='Male').astype(int)

ABILITY='ABILITY: COMPOSITE OF ASVAB SCORE'; PERC='PERCENTILE IN CLASS'
acad=[ABILITY,PERC]; race=['race_black','race_hisp']

def fit(model, y, X):
    m = model(y, X).fit(disp=0)
    return m

def report(m, cv, label):
    ci = m.conf_int().loc[cv]
    z = m.tvalues[cv]
    print(f"  {label}: coef={m.params[cv]:+.4f}  SE={m.bse[cv]:.4f}  z={z:+.3f}  "
          f"p={m.pvalues[cv]:.4f}  95%CI=[{ci[0]:+.4f},{ci[1]:+.4f}]")

print("="*70); print("PRIMARY: LOGIT  (BA DEGREE COMPLETED ~ candidate [+ race+ability])")
print("="*70)
cands={'SES':'SES','FAMILY SIZE OF SAMPLE':'FAMILY SIZE OF SAMPLE','SEX(male)':'male'}
for name,cv in cands.items():
    print(f"\n### Candidate: {name}")
    A=fit(sm.Logit, df['BA'], sm.add_constant(df[[cv]]))
    B=fit(sm.Logit, df['BA'], sm.add_constant(df[[cv]+race+acad]))
    report(A,cv,"Model A")
    report(B,cv,"Model B")

# A-coefficient gap investigation
print("\n" + "="*70); print("A-COEFF GAP INVESTIGATION (Model A, logit, candidate=SES)")
print("="*70)
ses_sd = df['SES'].std()
df['SES_z']  = df['SES']/ses_sd          # exact unit variance
df['SES_c']  = df['SES']-df['SES'].mean()# center only
m_raw = fit(sm.Logit, df['BA'], sm.add_constant(df[['SES']]))
m_z   = fit(sm.Logit, df['BA'], sm.add_constant(df[['SES_z']]))
m_c   = fit(sm.Logit, df['BA'], sm.add_constant(df[['SES_c']]))
print(f"  raw SES (SD={ses_sd:.4f}): coef={m_raw.params['SES']:+.4f}")
print(f"  SES / sample SD (unit var): coef={m_z.params['SES_z']:+.4f}")
print(f"  SES centered only:          coef={m_c.params['SES_c']:+.4f}")

# Suppression evidence
print("\n" + "="*70); print("SUPPRESSION EVIDENCE")
print("="*70)
print("Pairwise Pearson correlations:")
cols=['SES',ABILITY,PERC,'race_black','race_hisp']
print(df[cols].corr().round(3).to_string())
Bv = fit(sm.Logit, df['BA'], sm.add_constant(df[['SES']+race+acad]))
# VIF (OLS-based, on the model-B regressors)
from statsmodels.stats.outliers_influence import variance_inflation_factor
Xv = sm.add_constant(df[['SES']+race+acad]).astype(float)
vifs = {Xv.columns[i]: variance_inflation_factor(Xv.values, i) for i in range(Xv.shape[1])}
print("\nVIFs in Model B (SES + race + academic):")
for k,v in vifs.items(): print(f"  {k}: {v:.3f}")

# LPM robustness appendix
print("\n" + "="*70); print("APPENDIX: LPM / OLS robustness")
print("="*70)
for name,cv in cands.items():
    A=fit(sm.OLS, df['BA'], sm.add_constant(df[[cv]]))
    B=fit(sm.OLS, df['BA'], sm.add_constant(df[[cv]+race+acad]))
    print(f"  {name}: A coef={A.params[cv]:+.4f}(p={A.pvalues[cv]:.4f})  "
          f"B coef={B.params[cv]:+.4f}(p={B.pvalues[cv]:.4f})")
