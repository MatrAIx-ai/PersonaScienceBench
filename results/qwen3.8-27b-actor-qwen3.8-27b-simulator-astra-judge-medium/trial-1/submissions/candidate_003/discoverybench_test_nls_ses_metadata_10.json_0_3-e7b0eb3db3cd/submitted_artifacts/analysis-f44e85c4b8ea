import pandas as pd, numpy as np, warnings
import statsmodels.formula.api as smf
warnings.simplefilter("always")
pd.set_option("display.width",240); pd.set_option("display.max_columns",30)

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["BA"]=df["BA DEGREE COMPLETED"].astype(int)
df["RACE"]=df["SAMPLE_RACE"].astype(str); df["SEX"]=df["SAMPLE_SEX"].astype(str)
df["FS"]=df["FAMILY SIZE OF SAMPLE"]; df["SES"]=df["SES"]
df["ABILITY"]=df["ABILITY: COMPOSITE OF ASVAB SCORE"]; df["PERC"]=df["PERCENTILE IN CLASS"]
N=len(df); S=df["BA"].sum()
print(f"N={N}  successes(BA=1)={S}  base_rate={S/N*100:.2f}%\n")

def fit(f):
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        m=smf.logit(f,data=df).fit(disp=0,maxiter=500)
        warns=[str(x.message) for x in w]
    conv = m.mle_retvals.get("converged", None)
    return m, warns, conv

# ---- CONVERGENCE / SEPARATION for the key models ----
print("=== CONVERGENCE & SEPARATION (key models) ===")
for name,f in [
    ("RACE only","BA ~ C(RACE, Treatment(reference='White'))"),
    ("FULL: RACE+SES+AB+PERC","BA ~ C(RACE, Treatment(reference='White')) + SES + ABILITY + PERC"),
    ("FULL: RACE+SEX+FS+SES+AB+PERC","BA ~ C(RACE, Treatment(reference='White')) + SEX + FS + SES + ABILITY + PERC"),
]:
    m,warns,conv=fit(f)
    print(f"{name:34s} converged={conv}  max|grad|={m.mle_retvals.get('gmax',np.nan):.2e}  warnings={len(warns)}")
    for x in warns: print("    WARN:",x[:120])

print("\n=== SEPARATION CHECK (race/sex subgroups) ===")
for col in ["RACE","SEX"]:
    for lvl,g in df.groupby(col):
        b=g["BA"].sum(); flag=" <-- SEPARATION" if b in (0,len(g)) else ""
        print(f"  {col}={lvl:8s} n={len(g):5d}  BA=1:{b:4d} ({g['BA'].mean()*100:5.2f}%){flag}")
print("  (no all-zero/all-one race or sex subgroup -> no perfect separation for race/sex)")

# ---- UNIVARIATE TABLE (all candidates) ----
print("\n=== (a) UNIVARIATE:  BA ~ X ===")
uni=[]
def addu(coef,m):
    b=m.params[coef]; uni.append(dict(variable=coef,beta=round(b,4),se=round(m.bse[coef],4),
        p=round(m.pvalues[coef],4),sig="yes" if m.pvalues[coef]<.05 else "no"))
for ref in ["White","Black","Hispanic"]:
    m,_,_=fit(f"BA ~ C(RACE, Treatment(reference='{ref}'))")
    for c in m.params.index:
        if c.startswith("C(RACE"): addu(c,m)
m,_,_=fit("BA ~ C(SEX, Treatment(reference='Male'))")
addu("C(SEX, Treatment(reference='Male'))[T.Female]",m)
m,_,_=fit("BA ~ FS"); addu("FS",m)
uni=pd.DataFrame(uni).set_index("variable"); print(uni.to_string())

# ---- FULL TABLE ----
print("\n=== (b) FULL MODEL:  BA ~ X + SES + ABILITY + PERC ===")
full=[]
def addf(coef,m):
    b=m.params[coef]; full.append(dict(variable=coef,beta=round(b,4),se=round(m.bse[coef],4),
        p=round(m.pvalues[coef],4),sig="yes" if m.pvalues[coef]<.05 else "no"))
for ref in ["White","Black","Hispanic"]:
    m,_,_=fit(f"BA ~ C(RACE, Treatment(reference='{ref}')) + SES + ABILITY + PERC")
    for c in m.params.index:
        if c.startswith("C(RACE"): addf(c,m)
m,_,_=fit("BA ~ C(SEX, Treatment(reference='Male')) + SES + ABILITY + PERC")
addf("C(SEX, Treatment(reference='Male'))[T.Female]",m)
m,_,_=fit("BA ~ FS + SES + ABILITY + PERC"); addf("FS",m)
full=pd.DataFrame(full).set_index("variable"); print(full.to_string())

# ---- HEADLINE: Black(White-ref) trajectory ----
print("\n=== (c) HEADLINE: RACE, Black vs White reference ===")
m1,_,_=fit("BA ~ C(RACE, Treatment(reference='White'))")
m2,_,_=fit("BA ~ C(RACE, Treatment(reference='White')) + SES + ABILITY + PERC")
LBL="C(RACE, Treatment(reference='White'))[T.Black]"
b1=m1.params[LBL]; p1=m1.pvalues[LBL]
b2=m2.params[LBL]; p2=m2.pvalues[LBL]
print(f"  Baseline (RACE only):        Black coef = {b1:+.4f}   p={p1:.4f}  (significant)")
print(f"  Full (RACE+SES+AB+PERC):     Black coef = {b2:+.4f}   p={p2:.4f}  (insignificant)")
print(f"  Target values in question:   0.5024 -> 0.0923")
print(f"  Full-model Black coef {b2:.4f} matches target 0.0923 (diff {abs(b2-0.0923):.4f})")

# ---- Save artifact tables ----
uni.to_csv("univariate_table.csv")
full.to_csv("fullmodel_table.csv")
print("\nSaved: univariate_table.csv, fullmodel_table.csv")
