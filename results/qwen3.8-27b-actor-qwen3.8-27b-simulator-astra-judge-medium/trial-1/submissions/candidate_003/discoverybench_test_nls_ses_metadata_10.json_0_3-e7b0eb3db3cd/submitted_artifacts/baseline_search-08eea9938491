import pandas as pd
import numpy as np
import itertools
import statsmodels.formula.api as smf
import warnings
warnings.filterwarnings("ignore")

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["RACE"] = df["SAMPLE_RACE"].astype(str)
df["SEX"] = df["SAMPLE_SEX"].astype(str)
df["FS"] = df["FAMILY SIZE OF SAMPLE"]
df["SES"] = df["SES"]
df["ABILITY"] = df["ABILITY: COMPOSITE OF ASVAB SCORE"]
df["PERC"] = df["PERCENTILE IN CLASS"]

RACEW = "C(RACE, Treatment(reference='White'))"
RACEW_BLACK = f"{RACEW}[T.Black]"

pool = ["SEX","FS","SES","ABILITY","PERC"]
print("Black(White-ref) coefficient for  BA ~ RACE + <subset of {SEX,FS,SES,ABILITY,PERC}>")
print("Target baseline ~0.5024 ; target full (with SES+ABILITY+PERC) ~0.0923")
print("="*95)
results=[]
for r in range(len(pool)+1):
    for combo in itertools.combinations(pool, r):
        extra = " + ".join(combo)
        f = f"BA ~ {RACEW}" + (f" + {extra}" if extra else "")
        m = smf.logit(f, data=df).fit(disp=0, maxiter=500)
        b=m.params[RACEW_BLACK]; p=m.pvalues[RACEW_BLACK]
        has_full = {"SES","ABILITY","PERC"}.issubset(set(combo))
        tag=""
        if abs(b-0.5024)<0.02: tag+=" [~0.5024]"
        if has_full and abs(b-0.0923)<0.02: tag+=" [~0.0923 FULL]"
        results.append((combo, b, p, tag))

results.sort(key=lambda x: abs(x[1]-0.5024))
for combo,b,p,tag in results:
    name = "+".join(combo) if combo else "(RACE only)"
    print(f"{name:26s}  Black={b:+.4f}  p={p:.4f}{tag}")
