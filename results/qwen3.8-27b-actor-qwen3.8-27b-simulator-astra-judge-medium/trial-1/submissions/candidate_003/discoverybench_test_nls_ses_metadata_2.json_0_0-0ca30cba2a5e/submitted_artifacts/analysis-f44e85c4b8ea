#!/usr/bin/env python3
"""
Analysis: Does race moderate the effect of SES on BA degree completion?
Dataset: NLS (nls_ses_processed.csv) — 8,773 respondents, 3 race groups.
Method: Logistic regression with SES x RACE interaction, stratified models,
        Firth's penalised likelihood (robustness), average marginal effects.
"""
import pandas as pd, numpy as np, warnings
import statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['Black'] = (df['SAMPLE_RACE']=='Black').astype(int)
df['Hispanic'] = (df['SAMPLE_RACE']=='Hispanic').astype(int)
df['Male'] = (df['SAMPLE_SEX']=='Male').astype(int)
df['ABILITY'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PERCENTILE'] = df['PERCENTILE IN CLASS']
df['FAMILY_SIZE'] = df['FAMILY SIZE OF SAMPLE']
df['SES_z'] = (df['SES']-df['SES'].mean())/df['SES'].std()

print("="*72)
print("DATA OVERVIEW")
print("="*72)
print(f"  N={len(df):,}  Events(BA=1)={df['BA'].sum()} ({df['BA'].mean()*100:.2f}%)")
print(f"  Race: " + ", ".join(f"{r}={n}" for r,n in df['SAMPLE_RACE'].value_counts().items()))
print(f"  Events by race: " + ", ".join(f"{r}={df[df['SAMPLE_RACE']==r]['BA'].sum()}" for r in ['White','Black','Hispanic']))

# MAIN MODEL
print("\n"+"="*72)
print("MAIN MODEL: BA ~ SES_z*(Black+Hispanic) + ABILITY + PERCENTILE + Male + FAMILY_SIZE")
print("="*72)
f_full='BA ~ SES_z*(Black+Hispanic) + ABILITY + PERCENTILE + Male + FAMILY_SIZE'
m_full=smf.logit(f_full,data=df).fit(disp=0)
print(m_full.summary())
print("\n  OR per 1-SD SES:")
for nm in m_full.params.index:
    v=m_full.params[nm]; ci=m_full.conf_int().loc[nm]; p=m_full.pvalues[nm]
    print(f"    {nm:25s} coef={v:+.4f} OR={np.exp(v):.4f} 95%CI[{np.exp(ci[0]):.4f},{np.exp(ci[1]):.4f}] p={p:.4f}")

# INTERACTION TESTS
print("\n"+"="*72)
print("TESTS OF RACE MODERATION")
print("="*72)
wj=m_full.wald_test('SES_z:Black = 0, SES_z:Hispanic = 0')
print(f"\n  Joint Wald (2-df): chi2={float(np.ravel(wj.statistic)[0]):.4f}, p={float(np.ravel(wj.pvalue)[0]):.4f}")
for t in ['SES_z:Black','SES_z:Hispanic']:
    w1=m_full.wald_test(f'{t} = 0')
    print(f"    {t:20s}: chi2={float(np.ravel(w1.statistic)[0]):.4f}, p={float(np.ravel(w1.pvalue)[0]):.4f}")
f_red='BA ~ SES_z + Black + Hispanic + ABILITY + PERCENTILE + Male + FAMILY_SIZE'
m_red=smf.logit(f_red,data=df).fit(disp=0)
lrt=2*(m_full.llf-m_red.llf); lrtp=float(1-stats.chi2.cdf(lrt,df=2))
print(f"\n  LRT (2-df): 2*(LLF_full-LLF_red)={lrt:.4f}, p={lrtp:.4f}")

# SES SLOPE BY RACE
print("\n"+"="*72)
print("SES SLOPE BY RACE (OR per 1-SD SES, from interaction model)")
print("="*72)
bs=m_full.params['SES_z']; bib=m_full.params['SES_z:Black']; bih=m_full.params['SES_z:Hispanic']
cv=m_full.cov_params()
for race,sl,(i1,i2) in [('White(ref)',bs,('SES_z','SES_z')),('Black',bs+bib,('SES_z','SES_z:Black')),('Hispanic',bs+bih,('SES_z','SES_z:Hispanic'))]:
    se=np.sqrt(cv.loc[i1,i1]+cv.loc[i2,i2]+2*cv.loc[i1,i2]) if i1!=i2 else np.sqrt(cv.loc[i1,i1])
    lo,hi=sl-1.96*se,sl+1.96*se; p=2*(1-stats.norm.cdf(abs(sl/se)))
    print(f"  {race:15s}: slope={sl:+.4f} OR={np.exp(sl):.4f} 95%CI[{np.exp(lo):.4f},{np.exp(hi):.4f}] p={p:.4f}")

# STRATIFIED
print("\n"+"="*72)
print("STRATIFIED MODELS: BA ~ SES_z + ABILITY + PERCENTILE + Male + FAMILY_SIZE")
print("="*72)
sf='BA ~ SES_z + ABILITY + PERCENTILE + Male + FAMILY_SIZE'
strat={}
for race in ['White','Black','Hispanic']:
    sub=df[df['SAMPLE_RACE']==race]; m=smf.logit(sf,data=sub).fit(disp=0)
    b=m.params['SES_z']; se=m.bse['SES_z']
    lo,hi=b-1.96*se,b+1.96*se; p=2*(1-stats.norm.cdf(abs(b/se)))
    strat[race]=(b,se)
    print(f"\n  {race} (n={len(sub)}, events={sub['BA'].sum()}):")
    print(f"    SES slope={b:+.4f} OR={np.exp(b):.4f}")
    print(f"    95%CI[coef]={[lo,hi]}  95%CI[OR]={[np.exp(lo),np.exp(hi)]}")
    print(f"    p={p:.4f}")
print("\n  Pairwise slope diffs:")
for r1,r2 in [('White','Black'),('White','Hispanic'),('Black','Hispanic')]:
    b1,se1=strat[r1]; b2,se2=strat[r2]
    d=b1-b2; sd=np.sqrt(se1**2+se2**2); z=d/sd; p=2*(1-stats.norm.cdf(abs(z)))
    print(f"    {r1} vs {r2}: d={d:+.4f} z={z:.3f} p={p:.4f}")

# VIF
print("\n"+"="*72)
print("VIF CHECK")
print("="*72)
Xv=df[['SES_z','Black','Hispanic','ABILITY','PERCENTILE','Male','FAMILY_SIZE']].copy()
Xv['S_B']=Xv['SES_z']*Xv['Black']; Xv['S_H']=Xv['SES_z']*Xv['Hispanic']
Xv=sm.add_constant(Xv); maxv=0
for c in Xv.columns:
    if c=='const':continue
    r2=sm.OLS(Xv[c],Xv.drop(c,axis=1)).fit().rsquared; v=1/(1-r2); maxv=max(maxv,v)
    print(f"  {c:20s} VIF={v:.3f}")
print(f"  Max VIF={maxv:.3f} ({'OK' if maxv<5 else 'CONCERN'})")

# FIRTH
print("\n"+"="*72)
print("FIRTH'S PENALISED LOGIT (robustness)")
print("="*72)
def firth(X,y,mi=500,tol=1e-10):
    n,p=X.shape; beta=np.zeros(p)
    for it in range(mi):
        eta=np.clip(X@beta,-50,50); mu=np.clip(1/(1+np.exp(-eta)),1e-12,1-1e-12)
        w=mu*(1-mu); I=X.T@(w[:,None]*X); Ii=np.linalg.inv(I)
        h=np.einsum('ij,ij->i',X@Ii,X)
        U=X.T@(y-mu); Up=U-0.5*X.T@(h*(1-2*mu)*w)
        step=np.linalg.solve(I,Up); bn=beta+step
        llo=np.sum(y*np.log(mu)+(1-y)*np.log(1-mu))
        for _ in range(30):
            mn=np.clip(1/(1+np.exp(-np.clip(X@bn,-50,50))),1e-12,1-1e-12)
            wn=mn*(1-mn); ll=np.sum(y*np.log(mn)+(1-y)*np.log(1-mn))+0.5*np.linalg.slogdet(X.T@(wn[:,None]*X))[1]
            if ll>=llo-1e-10:break
            bn=beta+0.5*step
        else:bn=beta
        if np.max(np.abs(bn-beta))<tol:beta=bn;break
        beta=bn
    mu=np.clip(1/(1+np.exp(-np.clip(X@beta,-50,50))),1e-12,1-1e-12)
    w=mu*(1-mu); cov=np.linalg.inv(X.T@(w[:,None]*X))
    return beta,cov,mu

Xf=np.column_stack([np.ones(len(df)),df['SES_z'].values,df['Black'].values,df['Hispanic'].values,
    df['ABILITY'].values,df['PERCENTILE'].values,df['Male'].values,df['FAMILY_SIZE'].values,
    df['SES_z'].values*df['Black'].values,df['SES_z'].values*df['Hispanic'].values])
bf,cf,_=firth(Xf,df['BA'].values)
th=bf[[8,9]]; RbR=cf[np.ix_([8,9],[8,9])]
ch2=float(th@np.linalg.inv(RbR)@th); pf=float(1-stats.chi2.cdf(ch2,df=2))
print(f"  Firth Joint Wald (2-df): chi2={ch2:.4f}, p={pf:.4f}")
for i,nm in [(8,'SES_z:Black'),(9,'SES_z:Hispanic')]:
    z=bf[i]/np.sqrt(cf[i,i]); print(f"    {nm:20s}: z={z:.3f} p={2*(1-stats.norm.cdf(abs(z))):.4f}")
for race,sl,(i1,i2) in [('White(ref)',bf[1],(1,1)),('Black',bf[1]+bf[8],(1,8)),('Hispanic',bf[1]+bf[9],(1,9))]:
    se=np.sqrt(cf[i1,i1]+cf[i2,i2]+2*cf[i1,i2]) if i1!=i2 else np.sqrt(cf[i1,i1])
    lo,hi=sl-1.96*se,sl+1.96*se; p=2*(1-stats.norm.cdf(abs(sl/se)))
    print(f"  Firth {race:15s}: OR={np.exp(sl):.4f} 95%CI[{np.exp(lo):.4f},{np.exp(hi):.4f}] p={p:.4f}")

# AME
print("\n"+"="*72)
print("AVERAGE MARGINAL EFFECTS of SES (±1SD) on P(BA=1)")
print("="*72)
print("\n  True AME (averaged over all obs in each race):")
for race in ['White','Black','Hispanic']:
    sub=df[df['SAMPLE_RACE']==race].copy()
    sl=sub.copy(); sl['SES_z']-=1; sh=sub.copy(); sh['SES_z']+=1
    pl=m_full.predict(sl).values; ph=m_full.predict(sh).values
    print(f"    {race:10s}: dP={np.mean(ph-pl)*100:.3f}pp (P_lo={np.mean(pl)*100:.2f}% P_hi={np.mean(ph)*100:.2f}%)")
print("\n  At mean covariates:")
mc={'ABILITY':df['ABILITY'].mean(),'PERCENTILE':df['PERCENTILE'].mean(),'Male':0,'FAMILY_SIZE':df['FAMILY_SIZE'].mean()}
for race,(b,h) in [('White',(0,0)),('Black',(1,0)),('Hispanic',(0,1))]:
    ps={}
    for sv in [-1,0,1]:
        per=pd.DataFrame([{'SES_z':sv,'Black':b,'Hispanic':h,'ABILITY':mc['ABILITY'],'PERCENTILE':mc['PERCENTILE'],'Male':mc['Male'],'FAMILY_SIZE':mc['FAMILY_SIZE']}])
        ps[sv]=m_full.predict(per).values[0]
    print(f"    {race:10s}: P(-1)={ps[-1]*100:.3f}% P(0)={ps[0]*100:.3f}% P(+1)={ps[1]*100:.3f}% dP={(ps[1]-ps[-1])*100:.3f}pp")

print("\n"+"="*72)
print("DONE.")
