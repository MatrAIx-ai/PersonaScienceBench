"""
DiscoveryBench: 'At what Socioeconomic levels is the advantage in completion rates
for Black students more pronounced?'
Data: data/nls_ses_processed.csv  (NLS: race, sex, SES, ASVAB ability, class percentile, BA completed)

Method:
  1. Completion rate = mean(BA DEGREE COMPLETED), a binary 0/1.
  2. Segment SES into quintiles (primary) and deciles (robustness).
  3. 'Advantage' for Black students = Black rate - comparator rate (pp) and ratio,
     per SES bin. Comparators: White (primary), Hispanic, overall mean.
  4. Report N per cell and raw counts (s/n) so precision is visible.
  5. Sensitivity: logistic regression completion ~ SESbin + race + SESbin:race
     + ability(ASVAB) + class percentile + sex; check if high-SES Black advantage survives.
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 300); pd.set_option('display.max_rows', 200); pd.set_option('display.max_columns', 30)

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['comp'] = df['BA DEGREE COMPLETED'].astype(int)

def se(x, n):
    if n == 0 or x in (0, 1): return np.nan
    return np.sqrt(x * (1 - x) / n)

def cell_table(bincol, labels):
    pm = df.pivot_table(index=bincol, columns='SAMPLE_RACE', values='comp', aggfunc='mean')
    pn = df.pivot_table(index=bincol, columns='SAMPLE_RACE', values='comp', aggfunc='count')
    ps = df.pivot_table(index=bincol, columns='SAMPLE_RACE', values='comp', aggfunc='sum')
    overall = df['comp'].mean()
    rows = []
    for b in labels:
        if b not in pm.index: continue
        row = {'SES bin': b}
        for race in ['Black', 'White', 'Hispanic']:
            n = int(pn.loc[b, race]); s = int(ps.loc[b, race]); p = pm.loc[b, race]
            row[f'{race} rate%'] = round(p * 100, 2)
            row[f'{race} n'] = n
            row[f'{race} count'] = f'{s}/{n}'
            if race == 'Black':
                row['Black SE(pp)'] = round(se(p, n) * 100, 2)
        B, W, H = pm.loc[b, 'Black'], pm.loc[b, 'White'], pm.loc[b, 'Hispanic']
        row['B-W(pp)'] = round((B - W) * 100, 2)
        row['B-H(pp)'] = round((B - H) * 100, 2)
        row['B-All(pp)'] = round((B - overall) * 100, 2)
        row['B/W ratio'] = round(B / W, 3) if W > 0 else np.inf
        row['B/H ratio'] = round(B / H, 3) if H > 0 else np.inf
        rows.append(row)
    return pd.DataFrame(rows).set_index('SES bin')

# ---- Quintiles (primary) ----
L5 = ['Q1_low', 'Q2', 'Q3_mid', 'Q4', 'Q5_high']
df['SES_Q'] = pd.qcut(df['SES'], 5, labels=L5, duplicates='drop')
print('QUINTILE SES edges (left/right):')
print([ (round(float(c.left),3), round(float(c.right),3)) for c in pd.qcut(df['SES'],5,duplicates='drop').cat.categories ])
print('\n================ QUINTILE TABLE (primary) ================')
print(cell_table('SES_Q', L5).to_string())

# ---- Deciles (robustness) ----
L10 = [f'D{i}' for i in range(1, 11)]
df['SES_D'] = pd.qcut(df['SES'], 10, labels=L10, duplicates='drop')
print('\n================ DECILE TABLE (robustness) ================')
print(cell_table('SES_D', L10).to_string())

print('\nOverall completion: {:.2f}%  |  White {:.2f}%  Black {:.2f}%  Hispanic {:.2f}%'.format(
    df['comp'].mean()*100,
    df.loc[df.SAMPLE_RACE=='White','comp'].mean()*100,
    df.loc[df.SAMPLE_RACE=='Black','comp'].mean()*100,
    df.loc[df.SAMPLE_RACE=='Hispanic','comp'].mean()*100))

# ---- Sensitivity: logistic ----
print('\n================ SENSITIVITY: logistic (covariate-adjusted) ================')
import statsmodels.api as sm
d2 = df.copy()
d2['raceB'] = (d2['SAMPLE_RACE'] == 'Black').astype(int)
d2['raceH'] = (d2['SAMPLE_RACE'] == 'Hispanic').astype(int)
qcat = pd.get_dummies(d2['SES_Q'], prefix='Q', drop_first=True, dtype=float)
inter = pd.DataFrame(index=d2.index)
for c in qcat.columns:
    inter[f'B:{c}'] = d2['raceB'] * qcat[c]
    inter[f'H:{c}'] = d2['raceH'] * qcat[c]
X = pd.concat([d2[['raceB', 'raceH', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS']],
               d2['SAMPLE_SEX'].eq('Female').astype(float), qcat, inter], axis=1)
X = sm.add_constant(X)
mod = sm.Logit(d2['comp'], X).fit(disp=0)
print(f'Pseudo R2={mod.prsquared:.4f}, converged={mod.mle_retvals["converged"]}')
print('Black terms (vs White baseline, Q1 ref; adjusted for ability, class percentile, sex):')
for term in mod.params.index:
    if term == 'raceB' or term.startswith('B:'):
        b = mod.params[term]; p = mod.pvalues[term]
        print(f'  {term:14s} coef={b:+.3f} OR={np.exp(b):.3f} p={p:.4f}')

top = d2[d2['SES_Q'] == 'Q5_high'].copy()
Xt = sm.add_constant(top[['raceB', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS']])
mt = sm.Logit(top['comp'], Xt).fit(disp=0)
print(f'\nTop-quintile only, Black vs White, ability+percentile adjusted: '
      f'OR={np.exp(mt.params["raceB"]):.3f} p={mt.pvalues["raceB"]:.4f}')
print('Top-quintile mean ASVAB by race: ' +
      ', '.join(f'{r}={top.loc[top.SAMPLE_RACE==r,"ABILITY: COMPOSITE OF ASVAB SCORE"].mean():.0f}'
                for r in ['Black','White','Hispanic']))
print('\nDone.')
