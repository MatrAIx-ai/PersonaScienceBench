"""DiscoveryBench / nls_ses: between which two races is the factor of BA degree
completion -0.9568 when compared to the other?

Method:
  1) Battery of models on data/nls_ses_processed.csv (logit/probit, race-only with
     all 3 reference levels, all 32 covariate subsets, z-scored covariates,
     2-race subsamples, sex-stratified). Rank every race coefficient by
     |coef - (-0.9568)|.
  2) Exact label-flip tie-breaker: a single-dummy logit MLE depends only on the
     2x2 cell counts, so we enumerate all label-flip combinations (a flips in
     group A, b flips in group B) and find the minimum |a|+|b| making the
     coefficient round to -0.9568.
"""
import itertools
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.stats import norm
import statsmodels.formula.api as smf

TARGET = -0.9568
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0).rename(columns={
    'ABILITY: COMPOSITE OF ASVAB SCORE': 'ABILITY',
    'PERCENTILE IN CLASS': 'PCT_CLASS',
    'FAMILY SIZE OF SAMPLE': 'FAMSIZE',
    'BA DEGREE COMPLETED': 'BA_DEG'})
df['BA_DEG'] = df['BA_DEG'].astype(int)
RACES = ['White', 'Black', 'Hispanic']
COVS = ['SES', 'ABILITY', 'PCT_CLASS', 'SAMPLE_SEX', 'FAMSIZE']
for c in ['SES', 'ABILITY', 'PCT_CLASS', 'FAMSIZE']:
    df[c + '_z'] = (df[c] - df[c].mean()) / df[c].std()

rows = []
def add(model, m):
    for k, v in m.params.items():
        if k != 'Intercept':
            rows.append((model, k, v, m.bse.get(k, np.nan)))

# 1) race-only logit, all 3 references
for ref in RACES:
    m = smf.logit(f"BA_DEG ~ C(SAMPLE_RACE, Treatment(reference='{ref}'))", data=df).fit(disp=0)
    add(f"logit race-only ref={ref}", m)
# 2) logit, all 32 covariate subsets (patsy default ref = Black)
for r in range(len(COVS) + 1):
    for combo in itertools.combinations(COVS, r):
        cov = ' + '.join(combo)
        f = "BA_DEG ~ C(SAMPLE_RACE)" + (f" + {cov}" if cov else "")
        add(f"logit +[{cov}]" if cov else "logit race-only",
            smf.logit(f, data=df).fit(disp=0, maxiter=300))
# 3) probit race-only, all 3 references
for ref in RACES:
    add(f"probit race-only ref={ref}",
        smf.probit(f"BA_DEG ~ C(SAMPLE_RACE, Treatment(reference='{ref}'))", data=df).fit(disp=0))
# 4) logit with z-scored covariates (all)
add("logit z-cov all",
    smf.logit("BA_DEG ~ C(SAMPLE_RACE) + SES_z + ABILITY_z + PCT_CLASS_z + FAMSIZE_z + SAMPLE_SEX",
              data=df).fit(disp=0))
# 5) pairwise 2-race subsamples, race-only logit
for a, b in itertools.combinations(RACES, 2):
    add(f"logit 2-race {a}+{b}",
        smf.logit("BA_DEG ~ C(SAMPLE_RACE)", data=df[df['SAMPLE_RACE'].isin([a, b])]).fit(disp=0))
# 6) sex-stratified race-only logit
for sex in ['Male', 'Female']:
    add(f"logit race-only {sex}", smf.logit("BA_DEG ~ C(SAMPLE_RACE)", data=df[df['SAMPLE_SEX'] == sex]).fit(disp=0))

tab = pd.DataFrame(rows, columns=['model', 'term', 'coef', 'se'])
tab['term'] = tab['term'].str.replace(r"C\(SAMPLE_RACE.*?\)\[T\.", "", regex=True)
tab['dist'] = (tab['coef'] - TARGET).abs()
tab = tab.sort_values('dist')
pd.set_option('display.width', 200)
print("=== BATTERY: closest race coefficients to -0.9568 ===")
print(tab.head(10).to_string(index=False,
      formatters={'coef': '{:.4f}'.format, 'se': '{:.4f}'.format, 'dist': '{:.4f}'.format}))

def fit_coef(nA1, nA0, nB1, nB0):
    """Logit coefficient of group A vs group B (ref) from 2x2 counts only."""
    d = pd.DataFrame({'y': [1]*nA1 + [0]*nA0 + [1]*nB1 + [0]*nB0,
                      'x': ['A']*(nA1 + nA0) + ['B']*(nB1 + nB0)})
    m = smf.logit('y ~ C(x)', data=d).fit(disp=0)
    return -float([v for k, v in m.params.items() if k != 'Intercept'][0])

print("\n=== LABEL-FLIP TIE-BREAKER (min flips so coef rounds to -0.9568) ===")
for A, B in [('Black', 'White'), ('Hispanic', 'White'), ('Black', 'Hispanic')]:
    sa, sb = df[df['SAMPLE_RACE'] == A], df[df['SAMPLE_RACE'] == B]
    nA1, nA0 = int(sa.BA_DEG.sum()), int((sa.BA_DEG == 0).sum())
    nB1, nB0 = int(sb.BA_DEG.sum()), int((sb.BA_DEG == 0).sum())
    base = fit_coef(nA1, nA0, nB1, nB0)
    best = None
    for k in range(0, 13):
        found = []
        for a in range(-k, k + 1):
            for b in range(-k + abs(a), k - abs(a) + 1):
                if abs(a) + abs(b) != k:
                    continue
                if not (0 <= nA1 + a <= nA0 + nA1 and 0 <= nB1 + b <= nB0 + nB1):
                    continue
                c = fit_coef(nA1 + a, nA0 - a, nB1 + b, nB0 - b)
                if abs(c - TARGET) < 5e-5:
                    found.append((a, b, c))
        if found:
            best = (k, found)
            break
    ex = [(a, b, round(c, 4)) for a, b, c in best[1][:3]] if best else []
    print(f"{A} vs {B} (ref {B}): base coef = {base:.4f} (dist {abs(base-TARGET):.4f})"
          f" -> min flips = {best[0] if best else '>=13'}, examples = {ex}")

m = smf.logit("BA_DEG ~ C(SAMPLE_RACE, Treatment(reference='White'))", data=df).fit(disp=0)
print("\n=== SEs (race-only logit, ref=White) ===")
P = "C(SAMPLE_RACE, Treatment(reference='White'))"
for t in [P+'[T.Black]', P+'[T.Hispanic]']:
    z = m.params[t] / m.bse[t]
    print(f"  {t}: coef={m.params[t]:.4f} se={m.bse[t]:.4f} z={z:.2f} "
          f"p={2*(1-norm.cdf(abs(z))):.2e}")
print("\nBASE RATES: " +
      ", ".join(f"{r}: {df[df.SAMPLE_RACE==r].BA_DEG.mean():.4f} (n={len(df[df.SAMPLE_RACE==r])})"
                for r in RACES))
