"""
DiscoveryBench: Requirements engineering for ML-enabled systems — Q8 role association analysis.

Question: Which two roles have the highest proportion of association with requirements
in ML-enabled systems?

Method (per approved plan):
- Q8_ML_Addressing_<Role> columns are tri-state: "quoted" / "not quoted" / "-77".
- "-77" = no response (82 suspended respondents, block non-response) -> excluded.
- "Association" = "quoted" (role cited as addressing ML aspects in respondent's org).
- Per-role proportion = count("quoted") / item respondents (quoted + not quoted), n=194.
- Bootstrap: respondent-level resampling with replacement, B=10,000, seed=42,
  percentile 95% CI (2.5th-97.5th).
- Sensitivity: repeat on subset excluding suspended respondents AND requiring
  D7_Total_ML_Projects > 0.
"""
import pandas as pd, numpy as np

df = pd.read_csv("data/requirements_engineering_for_ML-enabled_systems.csv")
q8 = ["Q8_ML_Addressing_Project_Lead","Q8_ML_Addressing_Business_Analyst",
      "Q8_ML_Addressing_Requirement_Engineer","Q8_ML_Addressing_Solution_Architect",
      "Q8_ML_Addressing_Data_Scientist","Q8_ML_Addressing_Developer",
      "Q8_ML_Addressing_Tester","Q8_ML_Addressing_Others"]
labels = {"Q8_ML_Addressing_Project_Lead":"Project Lead/Project Manager","Q8_ML_Addressing_Business_Analyst":"Business Analyst",
 "Q8_ML_Addressing_Requirement_Engineer":"Requirements Engineer","Q8_ML_Addressing_Solution_Architect":"Solution Architect",
 "Q8_ML_Addressing_Data_Scientist":"Data Scientist","Q8_ML_Addressing_Developer":"Developer",
 "Q8_ML_Addressing_Tester":"Test Manager/Tester","Q8_ML_Addressing_Others":"Others (free text)"}

valid = df[~(df[q8]=="-77").all(axis=1)].copy()   # drop 82 suspended block non-respondents
X = (valid[q8]=="quoted").astype(int).to_numpy()  # 194 x 8
n = len(valid)

def boot(X, B=10000, seed=42):
    r = np.random.default_rng(seed)
    idx = r.integers(0, X.shape[0], size=(B, X.shape[0]))
    P = X[idx].mean(axis=1)
    return P.mean(axis=0), *np.percentile(P, [2.5, 97.5], axis=0)

mean_p, lo, hi = boot(X)
order = np.argsort(-mean_p)
print(f"=== Primary: respondent-level bootstrap, n={n}, B=10000, seed=42, percentile 95% CI ===")
rows=[]
for i in order:
    rows.append((labels[q8[i]], int(X[:,i].sum()), n, X[:,i].sum()/n, mean_p[i], lo[i], hi[i]))
    print(f"{labels[q8[i]]:32s} quoted={X[:,i].sum():3d}/{n}  prop={X[:,i].sum()/n*100:6.3f}%  "
          f"boot_mean={mean_p[i]*100:6.3f}%  CI95=[{lo[i]*100:6.3f}, {hi[i]*100:6.3f}]")

d7 = pd.to_numeric(valid["D7_Total_ML_Projects"], errors="coerce")
sub = valid[(valid["Status"]!="Suspended (22)") & (d7>0)]
Xs = (sub[q8]=="quoted").astype(int).to_numpy()
ns = len(sub)
ms, los, his = boot(Xs)
orders = np.argsort(-ms)
print(f"\n=== Sensitivity: excl. suspended & D7_Total_ML_Projects>0, n={ns} ===")
for i in orders:
    print(f"{labels[q8[i]]:32s} quoted={Xs[:,i].sum():3d}/{ns}  prop={Xs[:,i].sum()/ns*100:6.3f}%  "
          f"boot_mean={ms[i]*100:6.3f}%  CI95=[{los[i]*100:6.3f}, {his[i]*100:6.3f}]")

pd.DataFrame(rows, columns=["Role","quoted","n","prop","boot_mean","ci_lo","ci_hi"]).to_csv(
    "analysis/q8_bootstrap_primary.csv", index=False)
