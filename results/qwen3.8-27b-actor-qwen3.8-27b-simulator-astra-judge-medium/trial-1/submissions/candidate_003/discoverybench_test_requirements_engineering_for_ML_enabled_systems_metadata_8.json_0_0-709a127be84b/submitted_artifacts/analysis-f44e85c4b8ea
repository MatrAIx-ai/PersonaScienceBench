"""
DiscoveryBench analysis: least-used documentation formats for requirements in
ML-enabled system projects (Q10_ML_Documentation_*), with bootstrap 95% CIs.

Data: data/requirements_engineering_for_ML-enabled_systems.csv
- 276 respondent rows; Q10 block is binary: 'quoted' (format used),
  'not quoted', with NA code '-77' (82 rows, identical across all 12 cols).
- Valid N = 194.
- Not_Documented (absence, not a format) and Others (catch-all, free text =
  Jira/Confluence/Notion/wiki/...) are excluded from the two-format selection.

Method (approved plan):
- per-format % = quoted / 194 (primary); /276 sensitivity check
- nonparametric bootstrap, resampling unit = respondent (row), with
  replacement, n=194, B=10,000, seed=42 (np.random.default_rng),
  CI = empirical 2.5/97.5 percentiles of the bootstrap proportion distribution
"""
import pandas as pd
import numpy as np

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
B, SEED = 10_000, 42
NA_CODE = "-77"

df = pd.read_csv(CSV)
q10 = [c for c in df.columns
       if c.startswith("Q10_ML_Documentation_") and not c.endswith("_Free")]
assert len(q10) == 12, q10

# sanity: same NA rows across all 12 columns
na_mask = df[q10[0]] == NA_CODE
assert all((df[c] == NA_CODE).equals(na_mask) for c in q10)

valid = df[~na_mask].copy()
N_VALID, N_ALL = len(valid), len(df)
print(f"total rows = {N_ALL}; valid N (NA='-77' excluded) = {N_VALID}")

def pct(col, denom):
    return 100.0 * (valid[col] == "quoted").sum() / denom

rows = []
for c in q10:
    name = c.replace("Q10_ML_Documentation_", "")
    rows.append({
        "format": name,
        "quoted": (valid[c] == "quoted").sum(),
        "pct_of_194": pct(c, N_VALID),
        "pct_of_276": pct(c, N_ALL),
    })
tab = pd.DataFrame(rows).sort_values("pct_of_194").reset_index(drop=True)
print("\nAll 12 Q10 columns, sorted by usage (denominator 194; /276 sensitivity):")
print(tab.to_string(index=False))

concrete = tab[~tab["format"].isin(["Not_Documented", "Others"])].copy()
least_two = concrete.head(2)          # least-used first
print("\nTwo least-used concrete formats (excluding Not_Documented, Others):")
print(least_two.to_string(index=False))

# sensitivity: ranking under /276 must be identical
assert list(concrete.sort_values("pct_of_276")["format"]) == \
       list(concrete.sort_values("pct_of_194")["format"]), "ranking changed under /276"
print("Ranking invariant under /276 denominator sensitivity: OK")

# bootstrap, respondent-level resampling
def bootstrap_ci(col, n_boot=B, seed=SEED):
    x = (valid[col] == "quoted").astype(float).to_numpy()
    n = len(x)
    rng = np.random.default_rng(seed)
    idx = rng.integers(0, n, size=(n_boot, n))
    stat = x[idx].mean(axis=1) * 100.0
    lo, hi = np.percentile(stat, [2.5, 97.5])
    return stat.mean(), lo, hi

print("\nBootstrap 95% CIs (B=10,000, seed=42, respondent-level, percentile):")
results = {}
for c in q10:
    name = c.replace("Q10_ML_Documentation_", "")
    m, lo, hi = bootstrap_ci(c)
    results[name] = (m, lo, hi)
    if name in least_two["format"].values:
        print(f"  {name:20s} point={pct(c, N_VALID):.4f}%  boot mean={m:.4f}%  95% CI [{lo:.4f}, {hi:.4f}]")

# Others tie note
tie = tab[(tab["format"] == "Others")]["pct_of_194"].iloc[0]
print(f"\nNote: 'Others' ties MLCanvas at {tie:.4f}% but is a catch-all "
      f"(free text: Jira, Confluence, Notion, wiki, meeting notes) -> excluded.")

print("\nStudy-reported reference values (matched by rank order):")
print("  second-least-used -> MLCanvas:      10.13% (95% CI [9.926, 10.333])")
print("  least-used        -> BDD_Scenarios:  4.366% (95% CI [4.231, 4.501])")
