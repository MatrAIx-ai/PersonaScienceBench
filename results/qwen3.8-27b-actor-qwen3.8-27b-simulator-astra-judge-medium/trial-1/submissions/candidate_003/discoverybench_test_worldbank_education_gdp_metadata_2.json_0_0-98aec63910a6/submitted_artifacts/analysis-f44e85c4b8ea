"""
Main analysis: effect of education expenditure (Adjusted savings: education
expenditure, % of GNI -- series NY.ADJ.AEDU.GN.ZS) on per capita GNI
(constant 2015 US$ -- NY.GNP.PCAP.KD), comparing Lower Middle Income (LMC,
treated as the 'developing countries' arm -- stated assumption) vs
Sub-Saharan Africa (file code SSF). Regional aggregate time series, 1975-2015.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm

df = pd.read_csv('data/worldbank_education_gdp.csv')
yrs = [c for c in df.columns if 'YR' in c]

def row(sc, code):
    s = df[(df['Series Code']==sc)&(df['Country Code']==code)].iloc[0][yrs].astype(float)
    s.index = range(1975, 2016)   # integer years
    return s

V = {}
for g in ['LMC','SSF']:
    for tag, sc in [('gdp','NY.GNP.PCAP.KD'), ('edu','NY.ADJ.AEDU.GN.ZS'),
                    ('exp','NE.EXP.GNFS.KD.ZG'), ('enr1','SE.PRM.ENRR'),
                    ('enr2','SE.SEC.ENRR'), ('lfp','SL.TLF.CACT.ZS')]:
        V[(g,tag)] = row(sc, g)

def ols(y, X, names, label):
    X = sm.add_constant(np.column_stack([np.asarray(c, float) for c in X]))
    m = sm.OLS(np.asarray(y, float), X).fit()
    print(f"\n== {label} (n={int(m.nobs)}) ==")
    for n, b, se, p in zip(names, m.params, m.bse, m.pvalues):
        print(f"   {n:>16}: {b: .4f}  (se {se:.4f}, p {p:.3f})")
    print(f"   R2 = {m.rsquared:.3f}")
    return m

print("#"*70); print("LMC ARM (1991-2015 common support: all six variables present)")
print("#"*70)
g = 'LMC'
w = slice(1991, 2015)
lny   = np.log(V[(g,'gdp')].loc[w])
dlny  = np.diff(lny)                       # 1992-2015, n=24
dedu  = np.diff(V[(g,'edu')].loc[w])
edu   = V[(g,'edu')].loc[w]
edu_l = V[(g,'edu')].loc[1991:2014]   # lag: t=1992..2015 uses edu 1991..2014
enr1  = V[(g,'enr1')].loc[w]; enr2 = V[(g,'enr2')].loc[w]
lfp   = V[(g,'lfp')].loc[w];  expp = V[(g,'exp')].loc[w]

ols(dlny, [dedu], ['dEdu'], "LMC GROWTH (lead): dln(GNI/cap)_t ~ dEdu_t, 1992-2015")
ols(dlny, [dedu, enr1[1:], enr2[1:], lfp[1:], expp[1:]],
    ['dEdu','Enr1','Enr2','LFP','ExpG'],
    "LMC GROWTH + controls (levels of enrollment, LFP, exports growth)")
ols(dlny, [edu_l], ['Edu(t-1)'], "LMC GROWTH alt: dln(GNI/cap)_t ~ Edu_{t-1}")
ols(lny, [edu], ['Edu'], "LMC LEVELS (sensitivity): ln(GNI/cap)_t ~ Edu_t, 1991-2015")
ols(lny, [edu, enr1, enr2, lfp, expp], ['Edu','Enr1','Enr2','LFP','ExpG'],
    "LMC LEVELS + controls, 1991-2015")
lny_f = np.log(V[(g,'gdp')]); edu_f = V[(g,'edu')]
ols(lny_f, [edu_f], ['Edu'], "LMC LEVELS, 1975-2015 bivariate (n=41, robustness)")
ols(np.diff(lny_f), [np.diff(edu_f)], ['dEdu'], "LMC GROWTH, 1976-2015 bivariate (n=40, robustness)")

print(); print("#"*70)
print("SSF (SUB-SAHARAN AFRICA) ARM - per-capita income available 2011-2015 only (n=5)")
print("#"*70)
g = 'SSF'
gdp_w = V[(g,'gdp')].loc[2011:2015]; edu_w = V[(g,'edu')].loc[2011:2015]
print("GNI/cap 2011-2015:      ", [round(x,1) for x in gdp_w])
print("Edu %GNI 2011-2015:     ", [round(x,3) for x in edu_w])
dg = np.diff(np.log(gdp_w))
print("YoY GNI growth 12-15 (%):", [round(100*x,2) for x in dg],
      "| mean = %.2f%%" % (100*dg.mean()))
de = np.diff(edu_w)
print("YoY edu change (pp):     ", [round(x,3) for x in de],
      "| mean = %.3f pp/yr" % de.mean())
print("corr(GNI, Edu) levels n=5: %.3f" % np.corrcoef(gdp_w, edu_w)[0,1])
print("corr(dGNI, dEdu) n=4:      %.3f" % np.corrcoef(dg, de)[0,1])
print("Descriptive slope dlnGNI/dEdu (window): %.4f" % np.polyfit(de, dg, 1)[0])
# 1975-2015 edu trend for context
e = V[(g,'edu')]
print("SSF edu spend: 1975 %.2f -> 1997 peak %.2f -> 2015 %.2f (mean 1991-2015 %.2f)"
      % (e[1975], e.loc[1990:2015].max(), e[2015], e.loc[1991:2015].mean()))
eL = V[('LMC','edu')]
print("LMC edu spend: 1975 %.2f -> 2015 %.2f (mean 1991-2015 %.2f)"
      % (eL[1975], eL[2015], eL.loc[1991:2015].mean()))

print(); print("#"*70); print("CROSS-GROUP COMPARISON INPUTS")
print("#"*70)
gL = V[('LMC','gdp')]
print("LMC GNI/cap: 1975 %.0f -> 1991 %.0f -> 2015 %.0f; CAGR 1991-2015 %.2f%%"
      % (gL[1975], gL[1991], gL[2015], 100*((gL[2015]/gL[1991])**(1/24)-1)))
print("SSF GNI/cap: 2011 %.0f -> 2015 %.0f; CAGR 2011-2015 %.2f%%"
      % (gdp_w.iloc[0], gdp_w.iloc[-1], 100*((gdp_w.iloc[-1]/gdp_w.iloc[0])**(1/4)-1)))
