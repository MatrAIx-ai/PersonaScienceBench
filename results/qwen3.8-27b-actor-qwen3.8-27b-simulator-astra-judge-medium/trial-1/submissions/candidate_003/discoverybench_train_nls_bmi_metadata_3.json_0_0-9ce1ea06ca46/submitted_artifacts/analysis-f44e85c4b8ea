import pandas as pd, numpy as np
import statsmodels.formula.api as smf
from scipy import stats
from numpy.linalg import lstsq

pd.set_option('display.width', 200)
df = pd.read_csv('data/nls_bmi_processed.csv')
df['AGE_c'] = df.AGE - df.AGE.mean()
df['AGE_c2'] = df.AGE_c**2
df['LOGINC'] = np.log1p(df.INCOME)
MEAN_AGE = df.AGE.mean()

full = df.copy()
dedup = df.drop_duplicates().copy()
print(f"Full sample n={len(full)}; dedup sample n={len(dedup)}")
print(f"P(DISSAVED=1): full={full.DISSAVED.mean():.4f}, dedup={dedup.DISSAVED.mean():.4f}")

def vifs(d, cols):
    X = d[cols].values
    out = []
    for j in range(X.shape[1]):
        y = X[:,j]; Xo = np.column_stack([np.ones(len(X)), np.delete(X,j,axis=1)])
        b,_,_,_ = lstsq(Xo, y, rcond=None)
        r2 = 1 - ((y-Xo@b)**2).sum()/((y-y.mean())**2).sum()
        out.append(1/(1-r2))
    return {n: round(v,2) for n,v in zip(cols, out)}

def fit(sample, label, controls=True, drop_bmi=True):
    d = sample.copy()
    if drop_bmi: d = d[d.BMI <= 100]
    f = ('DISSAVED ~ AGE_c + AGE_c2 + C(GENDER) + LOGINC + BMI + BLACK + HISPANIC'
         if controls else 'DISSAVED ~ AGE_c + AGE_c2')
    m = smf.logit(f, data=d).fit(disp=0)
    print(f"\n===== {label} (n={len(d)}, controls={controls}) =====")
    print(m.summary2().tables[1].round(3).to_string())
    f_l = f.replace(' + AGE_c2', '')
    ml = smf.logit(f_l, data=d).fit(disp=0)
    lr = 2*(m.llf - ml.llf)
    print(f"LR test quadratic: chi2={lr:.3f}, p={stats.chi2.sf(lr,1):.4f}")
    b1, b2 = m.params['AGE_c'], m.params['AGE_c2']
    if abs(b2) > 1e-9:
        tp = MEAN_AGE - b1/(2*b2)
        print(f"Turning point AGE = {tp:.2f} ({'inverted-U/peak' if b2<0 else 'U/trough'}); inside 24-32: {24<=tp<=32}")
    for age in [24, 28, 32]:
        c = age - MEAN_AGE
        print(f"  d(logit)/dAGE at age {age} = {b1 + 2*b2*c:.4f}")
    # predicted P at 24 vs 32, controls at typical values (FEMALE, median income, mean BMI, non-black, non-hispanic)
    row = {'AGE': 0, 'AGE_c': 0, 'AGE_c2': 0, 'GENDER': 'FEMALE',
           'LOGINC': np.log1p(d.INCOME.median()), 'BMI': d.BMI[d.BMI<=100].mean(),
           'BLACK': 0, 'HISPANIC': 0}
    if not controls:
        row = {k: row[k] for k in ['AGE','AGE_c','AGE_c2']}
    p24 = p32 = None
    for age, tag in [(24,'24'), (32,'32')]:
        c = age - MEAN_AGE
        r = dict(row); r['AGE'] = age; r['AGE_c'] = c; r['AGE_c2'] = c**2
        p = m.predict(pd.DataFrame([r]))[0]
        if tag=='24': p24 = p
        else: p32 = p
    print(f"  P(DISSAVED=1) age 24 vs 32: {p24:.4f} vs {p32:.4f} (diff {p32-p24:+.4f})")
    cols = ['AGE_c','AGE_c2'] + (['LOGINC','BMI','BLACK','HISPANIC'] if controls else [])
    print("  VIFs:", vifs(d, cols))
    return m

m_f_u = fit(full, 'FULL / unadjusted', controls=False)
m_f_c = fit(full, 'FULL / adjusted', controls=True)
m_d_u = fit(dedup, 'DEDUP / unadjusted', controls=False)
m_d_c = fit(dedup, 'DEDUP / adjusted', controls=True)
fit(full, 'FULL / adjusted / BMI>100 kept', controls=True, drop_bmi=False)

# Nonparametric shape check: 3 age bins
full['agebin'] = pd.cut(full.AGE, [23.5, 26.5, 29.5, 32.5], labels=['24-26','27-29','30-32'])
mb = smf.logit('DISSAVED ~ C(agebin)', data=full[full.BMI<=100]).fit(disp=0)
print('\n===== FULL / binned age (24-26, 27-29, 30-32) =====')
print(mb.summary2().tables[1].round(3).to_string())
preds = []
for b in ['24-26','27-29','30-32']:
    preds.append((b, float(mb.predict(pd.DataFrame([{'agebin': b}]))[0])))
print('Predicted P by bin:', [(b, round(p,4)) for b,p in preds])

# Secondary: SAMESAVE
ms = smf.logit('SAMESAVE ~ AGE_c + AGE_c2 + C(GENDER) + LOGINC + BMI + BLACK + HISPANIC',
               data=full[full.BMI<=100]).fit(disp=0)
print('\n===== SAMESAVE adjusted (full, BMI<=100) =====')
print(ms.summary2().tables[1].round(3).to_string())
msl = smf.logit('SAMESAVE ~ AGE_c + C(GENDER) + LOGINC + BMI + BLACK + HISPANIC',
               data=full[full.BMI<=100]).fit(disp=0)
lr = 2*(ms.llf - msl.llf)
print(f"LR test quadratic SAMESAVE: chi2={lr:.3f}, p={stats.chi2.sf(lr,1):.4f}")
