"""
NLSY79: Does increased time preference associate with higher BMI?
- Time-preference proxy: 1989 savings flow direction (SVC):
    put_in=-1, no_change=0, took_out=+1 (impatient); no_savings excluded from primary.
- BMI: weight 1989 interpreted as POUNDS (metadata says kg, but data are lb:
  median 158, sex split M=175/F=135, implied BMI mean 25.2) / height 1985 in inches.
- Primary: OLS BMI ~ tp + age + sex + race + log income 1989 + wealth 1985 (HC1 SE).
- Robustness: 4-group ANOVA (incl. no_savings), BMI 1992, winzorized weight,
  continuous net savings flow, unadjusted group means, correlations.
- Missing: listwise deletion; income/wealth log+winzor (p99.5) due to top-codes.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_raw.csv')
H85='Height of respondent, 1985'; W89='Weight of respondent, 1989'; W92='Weight of respondent, 1992'
SVC='Was more money put into or taken out of R/spouse savings since last interview, 1989'
SIN='Net amount respondent/spouse put into savings since last interview, 1989'
SOUT='Net amount respondent/spouse took out of savings since last interview, 1989'
AGE89='Age of respondent at interview date, 1989'; SEX='Sex of respondent, 1979'
RACE='Racial/ethnic cohort, 1979'; INC89='Total net family income, previous calendar year, 1989'
NW85='Family net wealth, 1985'
LB2KG=0.45359237; IN2M=0.0254

def winzor(s, lo=0.005, hi=0.995): return s.clip(s.quantile(lo), s.quantile(hi))
def sgl(x): return np.sign(x)*np.log1p(np.abs(x))

df['bmi89']=(df[W89]*LB2KG)/(df[H85]*IN2M)**2
df['bmi92']=(df[W92]*LB2KG)/(df[H85]*IN2M)**2
df['tp']=df[SVC].map({1.0:-1.0, 3.0:0.0, 2.0:1.0})          # no_savings -> NaN (excluded)
df['svc4']=df[SVC].map({1.0:'put_in',2.0:'took_out',3.0:'no_change',4.0:'no_savings'})
df['netflow']=np.where(df[SVC]==1, -np.log1p(df[SIN].fillna(0)),
                np.where(df[SVC]==2,  np.log1p(df[SOUT].fillna(0)), np.nan))
df['netflow']=winzor(df['netflow'])
df['loginc89']=np.log1p(winzor(df[INC89].clip(lower=0)))
df['slw85']=sgl(winzor(df[NW85]))
df['female']=(df[SEX]==2).astype(float)
df['race_hisp']=(df[RACE]==2).astype(float)
df['race_black']=(df[RACE]==1).astype(float)
COV='age + female + race_hisp + race_black + loginc89 + slw85'

res={}
# ---- PRIMARY: 3-group OLS (complete cases)
d=df.dropna(subset=['bmi89','tp',AGE89,'loginc89','slw85']).assign(age=df[AGE89])
m1=smf.ols(f'bmi89 ~ tp + {COV}', data=d).fit(cov_type='HC1')
res['primary_ols']=dict(n=int(m1.nobs), beta_tp=round(m1.params['tp'],3),
    se=round(m1.bse['tp'],3), ci95=[round(x,3) for x in m1.conf_int().loc['tp']],
    t=round(m1.tvalues['tp'],2), p=round(m1.pvalues['tp'],4), r2=round(m1.rsquared,4))
g=d.groupby('svc4')['bmi89'].agg(['count','mean','std'])
res['group_means_3_complete']={k:dict(n=int(v['count']),mean=round(v['mean'],2),sd=round(v['std'],2)) for k,v in g.iterrows()}
t2,p2=stats.ttest_ind(d.loc[d.svc4=='put_in','bmi89'], d.loc[d.svc4=='took_out','bmi89'])
res['ttest_putin_vs_tookout']=dict(diff=round(d.loc[d.svc4=='took_out','bmi89'].mean()-d.loc[d.svc4=='put_in','bmi89'].mean(),2),
                                   t=round(t2,2), p=round(p2,5))
a3,p3=stats.f_oneway(*[d.loc[d.svc4==k,'bmi89'] for k in ['put_in','no_change','took_out']])
res['anova_3group']=dict(F=round(a3,2), p=round(p3,5))

# ---- ROBUSTNESS
# (a) 4-group ANOVA, unadjusted, full BMI+SVC sample
d4=df.dropna(subset=['bmi89','svc4'])
ga=d4.groupby('svc4')['bmi89'].agg(['count','mean','std'])
res['group_means_4_full']={k:dict(n=int(v['count']),mean=round(v['mean'],2),sd=round(v['std'],2)) for k,v in ga.iterrows()}
a4,p4=stats.f_oneway(*[d4.loc[d4.svc4==k,'bmi89'] for k in ['put_in','no_change','took_out','no_savings']])
res['anova_4group']=dict(n=int(len(d4)), F=round(a4,2), p=round(p4,6))
# adjusted 4-group OLS with dummies
d4a=df.dropna(subset=['bmi89','svc4',AGE89,'loginc89','slw85']).assign(age=df[AGE89])
m4=smf.ols(f'bmi89 ~ C(svc4, Treatment(reference="put_in")) + {COV}', data=d4a).fit(cov_type='HC1')
k='C(svc4, Treatment(reference="put_in"))[T.took_out]'
res['fourgroup_ols']=dict(n=int(m4.nobs),
    took_out_vs_put_in=dict(beta=round(m4.params[k],3), ci95=[round(x,3) for x in m4.conf_int().loc[k]],
                            p=round(m4.pvalues[k],5)))
# (b) BMI 1992
d3=df.dropna(subset=['bmi92','tp',AGE89,'loginc89','slw85']).assign(age=df[AGE89])
m3=smf.ols(f'bmi92 ~ tp + {COV}', data=d3).fit(cov_type='HC1')
res['bmi92_ols']=dict(n=int(m3.nobs), beta=round(m3.params['tp'],3),
                      ci95=[round(x,3) for x in m3.conf_int().loc['tp']], p=round(m3.pvalues['tp'],5))
# (c) winzorized weight
dw=df.copy(); dw['bmi89w']=(winzor(dw[W89])*LB2KG)/(dw[H85]*IN2M)**2
d5=dw.dropna(subset=['bmi89w','tp',AGE89,'loginc89','slw85']).assign(age=dw[AGE89])
m5=smf.ols(f'bmi89w ~ tp + {COV}', data=d5).fit(cov_type='HC1')
res['winzor_weight_ols']=dict(n=int(m5.nobs), beta=round(m5.params['tp'],3),
                              ci95=[round(x,3) for x in m5.conf_int().loc['tp']], p=round(m5.pvalues['tp'],5))
# (d) continuous net flow (impatient = positive)
d6=df.dropna(subset=['bmi89','netflow',AGE89,'loginc89','slw85']).assign(age=df[AGE89])
m6=smf.ols(f'bmi89 ~ netflow + {COV}', data=d6).fit(cov_type='HC1')
res['netflow_ols']=dict(n=int(m6.nobs), beta_per_logunit=round(m6.params['netflow'],3),
                        ci95=[round(x,3) for x in m6.conf_int().loc['netflow']], p=round(m6.pvalues['netflow'],5))
# (e) correlations
r_p,pp_p=stats.pearsonr(d.tp, d.bmi89); r_s,pp_s=stats.spearmanr(d.tp, d.bmi89)
res['correlation']=dict(pearson=round(r_p,3), p_p=round(pp_p,5), spearman=round(r_s,3), p_s=round(pp_s,5))
res['sample']=dict(total=len(df), bmi89_valid=int(df.bmi89.notna().sum()), svc_valid=int(df[SVC].notna().sum()),
    primary_n=int(m1.nobs), bmi89_mean=round(df.bmi89.mean(),2), bmi89_median=round(df.bmi89.median(),2),
    bmi_gt40=int((df.bmi89>40).sum()), w89_gt400=int((df[W89]>400).sum()))

print(json.dumps(res, indent=2))
json.dump(res, open('results.json','w'), indent=2)
