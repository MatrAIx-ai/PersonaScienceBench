import pandas as pd, numpy as np
from scipy import stats

ref = 0.0  # reference_epoch_day from input_0.json
df = pd.read_csv("data/input_1.csv")
cases = ["case_000","case_001","case_002","case_003"]

def design(t, pa, pb):
    # A: sin,cos at pa ; B: sin,cos at pb + sin,cos at 2*pb ; + const
    return np.column_stack([
        np.sin(2*np.pi*(t-ref)/pa), np.cos(2*np.pi*(t-ref)/pa),
        np.sin(2*np.pi*(t-ref)/pb), np.cos(2*np.pi*(t-ref)/pb),
        np.sin(4*np.pi*(t-ref)/pb), np.cos(4*np.pi*(t-ref)/pb),
        np.ones_like(t)])
def designB(t, pb):
    return np.column_stack([
        np.sin(2*np.pi*(t-ref)/pb), np.cos(2*np.pi*(t-ref)/pb),
        np.sin(4*np.pi*(t-ref)/pb), np.cos(4*np.pi*(t-ref)/pb),
        np.ones_like(t)])
def degenerate(pa,pb):
    if abs(pa-pb)/pb < 0.04: return True
    if abs(2*pa-pb)/pb < 0.04: return True
    if abs(pa-2*pb)/(2*pb) < 0.04: return True
    return False

summary_rows=[]
pred_rows=[]
report=[]
for c in cases:
    g=df[df.case_id==c].reset_index(drop=True)
    t=g["time_day"].values.astype(float); y=g["obs_0"].values.astype(float)
    w=1.0/g["obs_0_err"].values.astype(float)**2; sw=np.sum(w); n=len(t)
    # --- robust Pb (B-only) ---
    bestB=None
    for pb in np.arange(15,32,0.02):
        S=designB(t,pb);W=np.sqrt(w);cf,_,_,_=np.linalg.lstsq(S*W[:,None],y*W,rcond=None)
        sse=np.sum(w*(y-S@cf)**2)
        if bestB is None or sse<bestB[0]: bestB=(sse,pb,cf)
    SSE0,pb0,cfB=bestB
    # --- joint A+B: coarse then fine, small degeneracy guard ---
    best=None
    for pa in np.arange(3,40,0.25):
        for pb in np.arange(15,32,0.25):
            if degenerate(pa,pb): continue
            S=design(t,pa,pb);W=np.sqrt(w);cf,_,_,_=np.linalg.lstsq(S*W[:,None],y*W,rcond=None)
            sse=np.sum(w*(y-S@cf)**2)
            if best is None or sse<best[0]: best=(sse,pa,pb)
    _,pa_c,pb_c=best
    for pa in np.arange(max(3,pa_c-2),min(40,pa_c+2),0.02):
        for pb in np.arange(max(15,pb_c-2),min(32,pb_c+2),0.02):
            if degenerate(pa,pb): continue
            S=design(t,pa,pb);W=np.sqrt(w);cf,_,_,_=np.linalg.lstsq(S*W[:,None],y*W,rcond=None)
            sse=np.sum(w*(y-S@cf)**2)
            if best is None or sse<best[0]: best=(sse,pa,pb,cf)
    SSE1,pa,pb,cf=best
    a1,a2,b1,b2,b3,b4,off=cf
    # --- F-test (A present?) ---
    F=((SSE0-SSE1)/3)/(SSE1/(n-7)); pval=stats.f.sf(F,3,n-7)
    present = int(pval<0.01)
    Aamp=np.hypot(a1,a2)
    if present:
        pa_out, a1o, a2o = pa, a1, a2
    else:
        pa_out,a1o,a2o = 0.0,0.0,0.0
    summary_rows.append([c,present,pa_out,a1o,a2o,pb,b1,b2,b3,b4,off])
    # --- residual check ---
    rstd0=np.sqrt(SSE0/sw); rstd1=np.sqrt(SSE1/sw); err=g["obs_0_err"].mean()
    report.append((c,pb0,pb,pa,present,F,pval,Aamp,rstd0,rstd1,err))
    # --- predictions (A-only) ---
    for _,row in g[["case_id"]].drop_duplicates().iterrows():
        pass
    t2=pd.read_csv("data/input_2.csv")
    t2c=t2[t2.case_id==c]
    for _,row in t2c.iterrows():
        if present:
            val=a1o*np.sin(2*np.pi*(row["time_day"]-ref)/pa_out)+a2o*np.cos(2*np.pi*(row["time_day"]-ref)/pa_out)
        else:
            val=0.0
        pred_rows.append([c,row["time_day"],val])

# write signal_summary.csv
cols=["case_id","component_a_present","component_a_period_day","component_a_basis1_u0","component_a_basis2_u0",
      "component_b_period_day","component_b_basis1_u0","component_b_basis2_u0","component_b_basis3_u0",
      "component_b_basis4_u0","offset_u0"]
pd.DataFrame(summary_rows,columns=cols).to_csv("signal_summary.csv",index=False)
# write target_predictions.csv (preserve input_2 order)
t2=pd.read_csv("data/input_2.csv")
pd.DataFrame(pred_rows,columns=["case_id","time_day","component_a_value_u0"]).to_csv("target_predictions.csv",index=False)

print("=== signal_summary.csv ===")
print(pd.DataFrame(summary_rows,columns=cols).to_string(index=False))
print("\n=== residual / A-presence report ===")
for (c,pb0,pb,pa,pr,F,pv,Aamp,r0,r1,err) in report:
    print(f"{c}: Pb={pb0:.2f}({pb:.2f}) pa={pa:.2f} present={pr} F={F:.2f} p={pv:.1e} Aamp={Aamp:.2f} | B-only wRMS={r0:.3f} A+B wRMS={r1:.3f} obs0_err~{err:.2f}")
print("\nprediction rows:",len(pred_rows))
