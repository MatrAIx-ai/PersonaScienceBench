#!/usr/bin/env python3
"""
Directed gene regulatory network inference.

Two independent methods:
  A) Linear ODE regression on the time course:  dx_i/dt = b_i + sum_j W_ij x_j(t)
     (Savitzky-Golay smoothing for derivative estimation; ridge regression, numpy implementation).
  B) Steady-state perturbation analysis: regress deviations from the baseline
     steady state (row 0) of each gene on the deviations of the other genes
     (strongly regularized ridge, 15 samples x 24 predictors).

Convention: entry [i, j] = influence of gene j on gene i.
Combination: normalize each matrix by its max |off-diag|, combine
M = wA*A + wB*B (weights from clipped mean R^2), keep an edge only if both
methods agree on the sign, then threshold |M| so off-diagonal nonzero
density falls in 5%-40% (target ~25%). Low-confidence entries set to exactly
0.0. The SAME thresholded topology is used for weights, signs and metrics.
"""
import json
import numpy as np
from scipy.signal import savgol_filter
from scipy.stats import spearmanr

RNG = 0
N_GENES = 25

# ---------------------------------------------------------------- load data
ts = np.load("data/expression_timeseries.npy")          # (5, 50, 25)
ss = np.load("data/perturbation_steady_states.npy")     # (16, 25), row 0 baseline
info = json.load(open("data/system_info.json"))
dt = info["sampling_interval"]
n_series, n_tp, n_genes = ts.shape
assert n_genes == N_GENES and ss.shape[1] == N_GENES

# sanity: row 0 is the baseline (time course converges to it)
end = ts[:, -1, :].mean(axis=0)
print(f"[check] max|ts_end - ss_row0| = {np.abs(end - ss[0]).max():.4f}, "
      f"corr = {np.corrcoef(end, ss[0])[0, 1]:.6f}")

# ------------------------------------------------- Method A: ODE regression

def ridge_fit(X, y, alpha):
    """Manual ridge regression with intercept (centering). Returns (beta, intercept, pred)."""
    xm, ym = X.mean(0), y.mean()
    Xc, yc = X - xm, y - ym
    G = Xc.T @ Xc + alpha * np.eye(X.shape[1])
    beta = np.linalg.solve(G, Xc.T @ yc)
    intercept = ym - xm @ beta
    return beta, intercept

def ridge_predict(X, beta, intercept):
    return X @ beta + intercept

def method_A():
    W = np.zeros((n_genes, n_genes))
    r2 = np.zeros(n_genes)
    per_replicate = []
    for s in range(n_series):
        Ws = np.zeros((n_genes, n_genes))
        for i in range(n_genes):
            sm = savgol_filter(ts[s, :, i], window_length=7, polyorder=2)
            dy = np.gradient(sm, dt, axis=0)
            X = ts[s, :, :]
            beta, intercept = ridge_fit(X, dy, alpha=1.0)
            Ws[i, :] = beta
            pred = ridge_predict(X, beta, intercept)
            r2[i] = 1 - np.sum((dy - pred) ** 2) / np.sum((dy - dy.mean()) ** 2)
        per_replicate.append(Ws)
    W = np.mean(per_replicate, axis=0)
    # stability: mean pairwise spearman of per-replicate weight matrices
    sp = []
    for a in range(n_series):
        for b in range(a + 1, n_series):
            m = (np.arange(n_genes)[:, None] < np.arange(n_genes)[None, :]) | \
                (np.arange(n_genes)[:, None] > np.arange(n_genes)[None, :])
            sp.append(spearmanr(per_replicate[a][m].ravel(),
                                per_replicate[b][m].ravel())[0])
    stability = float(np.mean(sp))
    print(f"[A] mean R^2 = {r2.mean():.4f} (min {r2.min():.3f}, max {r2.max():.3f}), "
          f"stability = {stability:.3f}")
    return W, float(r2.mean()), stability

# ------------------------------------ Method B: steady-state perturbation
def method_B():
    dev = ss[1:] - ss[0]                       # (15, 25)
    C = np.zeros((n_genes, n_genes))
    r2 = np.zeros(n_genes)
    for i in range(n_genes):
        y = dev[:, i]
        idx = [j for j in range(n_genes) if j != i]
        X = dev[:, idx]
        mu, sd = X.mean(0), X.std(0)
        sd[sd < 1e-12] = 1.0
        Xs, ys = (X - mu) / sd, (y - y.mean()) / y.std()
        beta_s, intercept = ridge_fit(Xs, ys, alpha=3.0)
        beta = beta_s / sd                     # back to original scale
        C[i, idx] = beta
        pred = ridge_predict(Xs, beta_s, intercept)
        r2[i] = 1 - np.sum((ys - pred) ** 2) / np.sum((ys - ys.mean()) ** 2)
    # stability: leave-one-perturbation-out spearman vs full model
    sp = []
    for k in range(dev.shape[0]):
        Ck = np.zeros((n_genes, n_genes))
        for i in range(n_genes):
            y = np.delete(dev, k, axis=0)[:, i]
            idx = [j for j in range(n_genes) if j != i]
            X = np.delete(dev, k, axis=0)[:, idx]
            mu, sd = X.mean(0), X.std(0)
            sd[sd < 1e-12] = 1.0
            Xs, ys = (X - mu) / sd, (y - y.mean()) / y.std()
            beta_s, _ = ridge_fit(Xs, ys, alpha=3.0)
            Ck[i, idx] = beta_s / sd
        msk = np.ones((n_genes, n_genes), bool); np.fill_diagonal(msk, False)
        sp.append(spearmanr(C[msk].ravel(), Ck[msk].ravel())[0])
    stability = float(np.mean(sp))
    print(f"[B] mean R^2 (CV-like, in-sample) = {r2.mean():.4f} "
          f"(min {r2.min():.3f}), stability = {stability:.3f}")
    return C, float(r2.mean()), stability

# ---------------------------------------------------------------- combine
W_A, r2_A, stab_A = method_A()
W_B, r2_B, stab_B = method_B()

def normalize(M):
    off = np.abs(M[~np.eye(n_genes, dtype=bool)])
    return M / (off.max() if off.max() > 0 else 1.0)

A_n, B_n = normalize(W_A), normalize(W_B)
wA = np.clip(r2_A, 0.05, 1.0); wB = np.clip(r2_B, 0.05, 1.0)
wA, wB = wA / (wA + wB), wB / (wA + wB)
M = wA * A_n + wB * B_n
print(f"[combine] weights: A={wA:.3f}, B={wB:.3f}")

off = ~np.eye(n_genes, dtype=bool)
signA, signB = np.sign(A_n), np.sign(B_n)
agree = off & (signA == signB) & (signA != 0)

n_total = n_genes * (n_genes - 1)              # 600
lo, hi, target = int(0.05 * n_total), int(0.40 * n_total), int(0.25 * n_total)

cand = np.argwhere(agree)
order = np.argsort(-np.abs(M[cand[:, 0], cand[:, 1]]))
if len(cand) >= lo:
    keep_idx = cand[order[:min(target, len(cand))]]
    thr = np.abs(M[keep_idx[:, 0], keep_idx[:, 1]]).min() if len(keep_idx) else 0.0
else:  # fallback: allow single-method edges, strongest first
    single = off & ~agree & ((np.abs(A_n) > 0.3) | (np.abs(B_n) > 0.3))
    sc = np.argwhere(single)
    so = np.argsort(-np.abs(M[sc[:, 0], sc[:, 1]]))
    extra = sc[so[:max(0, lo - len(cand))]]
    keep_idx = np.vstack([cand, extra]) if len(extra) else cand
    thr = np.abs(M[keep_idx[:, 0], keep_idx[:, 1]]).min()
    print(f"[threshold] fallback used: {len(extra)} single-method edges added")

network = np.zeros((n_genes, n_genes))
network[keep_idx[:, 0], keep_idx[:, 1]] = M[keep_idx[:, 0], keep_idx[:, 1]]
# enforce: any off-diag below threshold or sign-disagreeing -> exactly 0.0
network[~off] = 0.0
network[np.abs(network) < thr] = 0.0
network[~np.isfinite(network)] = 0.0

signs = np.zeros((n_genes, n_genes))
nz = off & (network != 0)
signs[nz] = np.sign(network[nz])
assert (signs[nz] == np.sign(network[nz])).all()
assert np.all(signs[network != 0] != 0) and np.all(network[signs != 0] != 0)

n_edges = int(nz.sum())
density = n_edges / n_total
print(f"[topology] n_edges = {n_edges}, density = {density:.3f} "
      f"(constraint 0.05-0.40: {0.05 <= density <= 0.40}), thr = {thr:.4f}")

# ------------------------------------------------------------- hub genes
out_degree = (nz.sum(axis=0)).astype(int)          # column sums: j influences i
in_degree = (nz.sum(axis=1)).astype(int)
col_strength = np.abs(network).sum(axis=0)         # column strength of |weights|
top2_odeg = np.argsort(-out_degree)[:2]
top2_cstr = np.argsort(-col_strength)[:2]
print(f"[hubs] out-degree top2 = {sorted(top2_odeg)} (deg {out_degree[top2_odeg]}), "
      f"col-strength top2 = {sorted(top2_cstr)}")
hubs = sorted(top2_odeg.tolist())

# ------------------------------------------------------------- write files
np.save("inferred_network.npy", network.astype(np.float64))
np.save("edge_sign_predictions.npy", signs.astype(np.float64))
json.dump({"hub_genes": hubs}, open("hub_genes.json", "w"), indent=2)

method_comparison = {
    "methods": [
        {
            "name": "ode_regression",
            "description": ("Linear ODE regression dx_i/dt = b + sum_j W_ij x_j(t) on 5 "
                            "replicate time courses (Savitzky-Golay derivative, ridge "
                            "alpha=1.0); gives directed signed weights [i,j] = influence of j on i."),
            "score": float(r2_A),
            "metric": "mean_r2",
            "stability": float(stab_A),
            "strengths": ("Directly estimates dynamics and sign from temporal data; "
                          "250 samples per target gene; stable across replicates."),
            "limitations": ("Assumes approximately linear dynamics; derivative estimation "
                            "amplifies measurement noise."),
        },
        {
            "name": "steady_state_perturbations",
            "description": ("Regression of each gene's deviation from the baseline steady "
                            "state (row 0) on the deviations of the other 24 genes across "
                            "15 perturbations (standardized ridge alpha=3.0); second, "
                            "independent influence matrix."),
            "score": float(r2_B),
            "metric": "mean_r2",
            "stability": float(stab_B),
            "strengths": ("Independent of time-course assumptions; captures equilibrium "
                          "couplings induced by interventions."),
            "limitations": ("Only 15 samples for 24 predictors (heavy regularization); "
                            "intervention targets undocumented, so sign can be less "
                            "reliable than the dynamic method."),
        },
    ],
    "combination": ("Matrices normalized by max |off-diag|, combined M = wA*A + wB*B with "
                    "weights from clipped mean R^2 (wA=%.3f, wB=%.3f); edge kept only with "
                    "sign agreement, then |M| threshold %.4f for density in 5-40%%." % (wA, wB, thr)),
}
json.dump(method_comparison, open("method_comparison.json", "w"), indent=2)

network_metrics = {
    "n_edges": n_edges,
    "density": float(density),
    "n_genes": n_genes,
    "in_degree": {
        "description": "row sums of the exact nonzero topology ([i,j]: j influences i)",
        "mean": float(in_degree.mean()), "max": int(in_degree.max()),
        "min": int(in_degree.min()), "std": float(in_degree.std()),
        "per_gene": in_degree.tolist(),
    },
    "out_degree": {
        "description": "column sums of the exact nonzero topology (regulator influence)",
        "mean": float(out_degree.mean()), "max": int(out_degree.max()),
        "min": int(out_degree.min()), "std": float(out_degree.std()),
        "per_gene": out_degree.tolist(),
    },
    "hub_genes": hubs,
    "hub_rationale": ("top-2 by out-degree (nonzero column counts), corroborated by "
                      "column strength (sum of |weights|)"),
    "threshold": float(thr),
}
json.dump(network_metrics, open("network_metrics.json", "w"), indent=2)

print("[done] artifacts written: inferred_network.npy, edge_sign_predictions.npy, "
      "hub_genes.json, method_comparison.json, network_metrics.json")
