class _Canvas:
    def __init__(self, W, H):
        self.a = np.ones((H, W, 3), dtype=np.uint8) * 255
    def px(self, x, y, c):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.a.shape[1] and 0 <= y < self.a.shape[0]:
            self.a[y, x] = c
    def line(self, x1, y1, x2, y2, c, dash=False):
        n = int(max(abs(x2 - x1), abs(y2 - y1))) + 1
        for i in range(n + 1):
            t = i / n
            if dash and (i // 8) % 2 == 1:
                continue
            self.px(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t, c)
    def text(self, x, y, s, c, scale=1):
        cx = x
        for ch in s.upper():
            g = _FONT.get(ch, _FONT[" "])
            for r in range(7):
                for k in range(5):
                    if g[r] & (16 >> k):
                        for dy in range(scale):
                            for dx in range(scale):
                                self.px(cx + k * scale + dx, y + r * scale + dy, c)
            cx += 6 * scale

class _Plot:
    def __init__(self, cv, x0, y0, w, h, xlim, ylim):
        self.cv, self.x0, self.y0, self.w, self.h = cv, x0, y0, w, h
        self.xlim, self.ylim = xlim, ylim
    def X(self, x): return self.x0 + (x - self.xlim[0]) / (self.xlim[1] - self.xlim[0]) * self.w
    def Y(self, y): return self.y0 + (self.ylim[1] - y) / (self.ylim[1] - self.ylim[0]) * self.h
    def line(self, x1, y1, x2, y2, c, dash=False):
        self.cv.line(self.X(x1), self.Y(y1), self.X(x2), self.Y(y2), c, dash)
    def poly(self, xs, ys, c, dash=False):
        for i in range(len(xs) - 1):
            self.line(xs[i], ys[i], xs[i + 1], ys[i + 1], c, dash)
    def pts(self, xs, ys, c, s=2):
        for x, y in zip(xs, ys):
            px, py = self.X(x), self.Y(y)
            for dy in range(-s, s + 1):
                for dx in range(-s, s + 1):
                    self.cv.px(px + dx, py + dy, c)
    def vline(self, x, c, dash=True): self.line(x, self.ylim[0], x, self.ylim[1], c, dash)
    def frame(self, nt=5):
        cv = self.cv
        cv.line(self.x0, self.y0, self.x0 + self.w, self.y0, (90,90,90))
        cv.line(self.x0, self.y0, self.x0, self.y0 + self.h, (90,90,90))
        for i in range(nt):
            fx = i / (nt - 1)
            x = self.xlim[0] + fx * (self.xlim[1] - self.xlim[0])
            y = self.ylim[0] + fx * (self.ylim[1] - self.ylim[0])
            cv.line(self.X(x), self.y0, self.X(x), self.y0 + 4, (90,90,90))
            cv.line(self.x0, self.Y(y), self.x0 - 4, self.Y(y), (90,90,90))
            cv.text(self.X(x) - 12, self.y0 + 6, f"{x:.2f}", (60,60,60))
            cv.text(self.x0 - 46, self.Y(y) - 4, f"{y:.2f}", (60,60,60))
    def title(self, s): self.cv.text(self.x0 + self.w // 2 - 4 * len(s), self.y0 + self.h + 10, s, (20,20,20), 2)
    def xlabel(self, s): self.cv.text(self.x0 + self.w // 2 - 3 * len(s), self.y0 + self.h // 2, s, (20,20,20))
    def ylabel(self, s): self.cv.text(self.x0 + self.w // 2 - 3 * len(s), self.y0 - 22, s, (20,20,20))
    def legend(self, items, x=None, y=None):
        x = self.x0 + 10 if x is None else x
        y = self.y0 + self.h - 14 if y is None else y
        for s, c in items:
            self.cv.line(x, y + 4, x + 14, y + 4, c)
            self.cv.text(x + 18, y, s, (20,20,20))
            y -= 12

