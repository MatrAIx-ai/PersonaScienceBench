#!/usr/bin/env python3
"""Single-cell RNA-seq integrated analysis (B3). NumPy + SciPy only."""
import json
import numpy as np
from scipy.spatial import cKDTree
from scipy.spatial.distance import cdist
from scipy.linalg import eigh
from scipy.stats import kruskal

RNG = np.random.default_rng(42)
INFO = "data/system_info.json"
COUNTS = "data/counts.npy"

def normalize_counts(X):
    lib = X.sum(axis=1, keepdims=True)
    lib = np.where(lib == 0, 1.0, lib)
    return np.log1p(X / lib * 1e4)

def select_hvg(logX, n_hvg=100, min_cells=10):
    expressed = (logX > 0).sum(axis=0)
    var = logX.var(axis=0)
    var = var.copy()
    var[expressed < min_cells] = -np.inf
    return np.sort(np.argsort(var)[::-1][:n_hvg])

def pca(X, n_comp=30):
    Xc = X - X.mean(axis=0)
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    scores = U[:, :n_comp] * S[:n_comp]
    evr = (S ** 2) / np.sum(S ** 2)
    return scores, evr

def knn_graph(Z, k=15):
    n = Z.shape[0]
    tree = cKDTree(Z)
    _, nn = tree.query(Z, k=k + 1)
    nn = nn[:, 1:]
    adj = np.zeros((n, n), dtype=bool)
    for i in range(n):
        adj[i, nn[i]] = True
    A_bool = (adj | adj.T)
    dist = cdist(Z, Z)
    sigma = np.median(dist[A_bool])
    W = np.zeros((n, n))
    W[A_bool] = np.exp(-dist[A_bool] ** 2 / (2 * sigma ** 2))
    W = 0.5 * (W + W.T)
    np.fill_diagonal(W, 0.0)
    return W, sigma

def kmeans(X, k, n_init=20, n_iter=300, seed=0):
    n = X.shape[0]
    best_lab, best_in = None, np.inf
    for s in range(n_init):
        rng = np.random.default_rng(seed + s)
        C = np.empty((k, X.shape[1]))
        C[0] = X[rng.integers(n)]
        d2 = ((X - C[0]) ** 2).sum(1)
        for c in range(1, k):
            tot = d2.sum()
            probs = d2 / tot if tot > 0 else np.full(n, 1.0 / n)
            C[c] = X[rng.choice(n, p=probs)]
            d2 = np.minimum(d2, ((X - C[c]) ** 2).sum(1))
        lab = np.zeros(n, dtype=int)
        for _ in range(n_iter):
            d = ((X[:, None, :] - C[None, :, :]) ** 2).sum(-1)
            nl = d.argmin(1)
            if (nl == lab).all():
                lab = nl
                break
            lab = nl
            for c in range(k):
                m = lab == c
                if m.any():
                    C[c] = X[m].mean(0)
        d = ((X[:, None, :] - C[None, :, :]) ** 2).sum(-1)
        lab = d.argmin(1)
        inertia = d.min(1).sum()
        if inertia < best_in:
            best_in, best_lab = inertia, lab.copy()
    return best_lab

def spectral_cluster(A, k):
    n = A.shape[0]
    d = A.sum(axis=1)
    d = np.where(d == 0, 1e-12, d)
    dinv = 1.0 / np.sqrt(d)
    L = np.eye(n) - np.outer(dinv, dinv) * A
    w, vec = eigh(L)
    emb = vec[:, :k]
    return kmeans(emb, k), w

def diffusion_pseudotime(A):
    n = A.shape[0]
    d = A.sum(axis=1)
    d = np.where(d == 0, 1e-12, d)
    dinv = 1.0 / np.sqrt(d)
    P = np.outer(dinv, dinv) * A
    w, vec = eigh(P)
    order = np.argsort(w)[::-1]
    # skip trivial eigenvalues (=1, one per connected component)
    tol = 1e-4
    r = 0
    while r < len(order) and w[order[r]] > 1.0 - tol:
        r += 1
    main = vec[:, order[r]]
    lo, hi = main.min(), main.max()
    pt = (main - lo) / (hi - lo)
    return pt, lo, hi, r

def graph_denoise(X, A, alpha=0.5):
    d = A.sum(axis=1, keepdims=True)
    d = np.where(d == 0, 1e-12, d)
    P = A / d
    return (1 - alpha) * X + alpha * (P @ X)

def soft(rho, t):
    return np.sign(rho) * np.maximum(np.abs(rho) - t, 0.0)

def elastic_net(X, y, l1_ratio, lam, n_iter=1000, tol=1e-8):
    n, p = X.shape
    w = np.zeros(p)
    l1 = lam * l1_ratio
    l2 = lam * (1 - l1_ratio)
    for _ in range(n_iter):
        w_old = w.copy()
        for j in range(p):
            resid = y - X @ w + X[:, j] * w[j]
            rho = X[:, j] @ resid / n
            w[j] = soft(rho, l1) / (1.0 + l2)
        if np.max(np.abs(w - w_old)) < tol:
            break
    return w

def main():
    info = json.load(open(INFO))
    X = np.load(COUNTS).astype(float)
    n_cells, n_genes = X.shape
    n_clusters = info["n_clusters"]
    n_tf = info["n_tf_genes"]
    tf_idx = info.get("tf_gene_indices", list(range(n_tf)))

    logX = normalize_counts(X)
    hvg = select_hvg(logX, n_hvg=100, min_cells=10)
    Z, evr = pca(logX[:, hvg], n_comp=30)
    A, sigma = knn_graph(Z, k=15)

    labels, lap_eig = spectral_cluster(A, k=n_clusters)
    labels = labels.astype(np.int32)
    sizes = np.bincount(labels, minlength=n_clusters)

    pt, pt_lo, pt_hi, pt_rank = diffusion_pseudotime(A)
    root = int(np.argmin(pt))
    from scipy.sparse.csgraph import connected_components
    n_components, comp_labs = connected_components((A + A.T) > 0, directed=False)
    comp_sizes = [int((comp_labs == c).sum()) for c in range(n_components)]

    scores = np.zeros(n_genes)
    for g in range(n_genes):
        groups = [logX[labels == c, g] for c in range(n_clusters)]
        groups = [gr for gr in groups if gr.size > 0]
        if len(groups) < 2:
            continue
        H, _ = kruskal(*groups)
        logFC = max(logX[labels == c, g].mean() for c in range(n_clusters) if (labels == c).any()) \
                - logX[:, g].mean()
        scores[g] = H * (1.0 + max(0.0, logFC))
    de_genes = np.argsort(scores)[::-1][:20].tolist()

    Xtf = logX[:, tf_idx]
    Xtf_den = graph_denoise(Xtf, A, alpha=0.5)
    Xtf_s = (Xtf_den - Xtf_den.mean(0)) / (Xtf_den.std(0) + 1e-12)
    lam_max = 0.0
    for j in range(n_tf):
        A_ = Xtf_s.copy(); A_[:, j] = 0
        lam_max = max(lam_max, float(np.max(np.abs(A_.T @ Xtf_s[:, j] / n_cells))))
    lam = 0.10 * lam_max
    l1_ratio = 0.5
    grn = np.zeros((n_tf, n_tf))
    for j in range(n_tf):
        A_ = Xtf_s.copy(); A_[:, j] = 0
        w = elastic_net(A_, Xtf_s[:, j], l1_ratio, lam)
        grn[:, j] = w
    floor = 0.10
    grn[np.abs(grn) < floor] = 0.0
    np.fill_diagonal(grn, 0.0)
    n_edges = int(np.sum(grn != 0))

    np.save("clusters.npy", labels)
    np.save("pseudotime.npy", pt.astype(np.float64))
    with open("de_genes.json", "w") as f:
        json.dump({"gene_indices": de_genes}, f, indent=2)
    np.save("grn_scores.npy", grn.astype(np.float64))

    method_choices = {
        "normalization": {
            "method": "Total-count (library-size) normalization to 1e4 UMI + log1p",
            "justification": "Standard scRNA-seq preprocessing (Luecken & Theis 2019 baseline); removes technical library-size variation (observed 901-3992 UMI/cell) before downstream steps."
        },
        "feature_selection": {
            "method": "Top-100 highly-variable genes (variance in log space, expressed in >=10 cells)",
            "justification": "HVG selection denoises the feature space and keeps the most informative genes for PCA/clustering."
        },
        "dimensionality_reduction": {
            "method": "PCA (SVD) to 30 components on HVG log-expression",
            "justification": "Linear dimension reduction stabilizes the kNN graph; PC1 explains ~22% (dominant trajectory)."
        },
        "graph": {
            "method": "k=15 mutual-nearest-neighbor graph, Gaussian-weighted (sigma = median mutual distance)",
            "justification": "Mutual-NN symmetrization keeps the graph connected and robust; Gaussian weights give smooth neighborhoods for both clustering and diffusion."
        },
        "clustering": {
            "method": "Spectral clustering, k=4 (normalized graph Laplacian eigenmap + k-means, 20 restarts)",
            "justification": "k=4 is fixed by system_info metadata (n_clusters); target-k spectral clustering is the cleanest deterministic SciPy-only choice. No elbow/Louvain needed."
        },
        "pseudotime": {
            "method": "Diffusion map (Koehler): P = D^{-1/2} A D^{-1/2}, first non-trivial eigenvector as the gradient coordinate; scaled to [0,1] with root (min) = 0.0, extreme = 1.0",
            "justification": "The kNN graph has 2 connected components (382 and 418 cells). The pseudotime is the first NON-trivial diffusion coordinate (rank 2, skipping the 2 trivial eigenvalues that are component indicators). It captures the dominant within-component gradient: the 382-cell component resolves into 3 ordered sub-clusters (a trajectory, pt 0->1) while the 418-cell component maps to a constant (no gradient along this mode). Scaled to [0,1], root (min)=0."
        },
        "de_genes": {
            "method": "Per-gene Kruskal-Wallis H across the 4 discovered clusters (log-normalized), combined with max cluster fold-change: score = H * (1 + max(0, logFC)); ranked descending, top-20 over all 250 genes",
            "justification": "Non-parametric cluster-separation test (robust to dispersion) plus effect size captures candidate marker genes; no labels required. TFs are not excluded."
        },
        "grn": {
            "method": "Per-target elastic-net regression (L1+L2, coordinate descent with soft-thresholding) on graph-denoised, z-scored TF expression; l1_ratio=0.5, lam=0.10*lam_max; floor threshold 0.10; diagonal = 0. grn[i,j] = edge i->j",
            "justification": "Per-target regression is the standard directed GRN inference (handles direction and sign; i->j != j->i). L1 induces a sparse network. Graph denoising strengthens the signal."
        },
        "assumptions": {
            "counts_raw": "Counts are raw integer droplet-style UMI; library-size + log1p applied.",
            "tf_columns": "First n_tf_genes=20 columns are the TF genes (confirmed by tf_gene_indices and description).",
            "k_fixed": "k=4 taken directly from metadata n_clusters (not inferred).",
            "weak_tf_signal": "TF-TF linear signal is weak (max off-diag correlation ~0.09), so the recovered GRN is expected to be sparse. Documented per researcher guidance.",
            "two_components": "The data resolves into 2 well-separated kNN graph components (382 and 418 cells); PC1 (~22% EV) separates them. The 382-cell component contains 3 sub-clusters forming a trajectory; the 418-cell component is a single cluster with no gradient along the pseudotime mode.",
            "linear_trajectory": "Pseudotime is the first non-trivial diffusion coordinate (within-component gradient), not the component separator; no branching assumed.",
            "no_ground_truth": "No cluster/GRN labels provided; quality judged by internal metrics only."
        },
        "diagnostics": {
            "cluster_sizes": sizes.tolist(),
            "n_graph_components": int(n_components),
            "graph_component_sizes": comp_sizes,
            "pc1_explained_variance": float(evr[0]),
            "n_hvg": int(len(hvg)),
            "root_cell": root,
            "pseudotime_diffusion_rank": int(pt_rank),
            "pseudotime_range": [0.0, 1.0],
            "de_genes_top20": de_genes,
            "grn_n_edges": n_edges,
            "grn_lambda": float(lam),
            "grn_lam_max": float(lam_max),
            "grn_l1_ratio": l1_ratio
        }
    }
    with open("method_choices.json", "w") as f:
        json.dump(method_choices, f, indent=2)

    print("cluster sizes:", sizes.tolist())
    print("pc1 evr:", round(float(evr[0]), 4))
    print("root cell:", root)
    print("de_genes top20:", de_genes)
    print("grn lambda:", round(lam, 5), "lam_max:", round(lam_max, 5), "n_edges:", n_edges)
    print("GRN matrix (i->j):")
    np.set_printoptions(precision=3, suppress=True, linewidth=200)
    print(grn)

if __name__ == "__main__":
    main()
