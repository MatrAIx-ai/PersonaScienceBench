{
  "normalization": {
    "method": "Total-count (library-size) normalization to 1e4 UMI + log1p",
    "justification": "Standard scRNA-seq preprocessing (Luecken & Theis 2019 baseline); removes technical library-size variation (observed 901-3992 UMI/cell) before downstream steps."
  },
  "feature_selection": {
    "method": "Top-100 highly-variable genes (variance in log space, expressed in >=10 cells)",
    "justification": "HVG selection denoises the feature space and keeps the most informative genes for PCA/clustering."
  },
  "dimensionality_reduction": {
    "method": "PCA (SVD) to 30 components on HVG log-expression",
    "justification": "Linear dimension reduction stabilizes the kNN graph; PC1 explains ~22% (dominant trajectory)."
  },
  "graph": {
    "method": "k=15 mutual-nearest-neighbor graph, Gaussian-weighted (sigma = median mutual distance)",
    "justification": "Mutual-NN symmetrization keeps the graph connected and robust; Gaussian weights give smooth neighborhoods for both clustering and diffusion."
  },
  "clustering": {
    "method": "Spectral clustering, k=4 (normalized graph Laplacian eigenmap + k-means, 20 restarts)",
    "justification": "k=4 is fixed by system_info metadata (n_clusters); target-k spectral clustering is the cleanest deterministic SciPy-only choice. No elbow/Louvain needed."
  },
  "pseudotime": {
    "method": "Diffusion map (Koehler): P = D^{-1/2} A D^{-1/2}, first non-trivial eigenvector as the gradient coordinate; scaled to [0,1] with root (min) = 0.0, extreme = 1.0",
    "justification": "The kNN graph has 2 connected components (382 and 418 cells). The pseudotime is the first NON-trivial diffusion coordinate (rank 2, skipping the 2 trivial eigenvalues that are component indicators). It captures the dominant within-component gradient: the 382-cell component resolves into 3 ordered sub-clusters (a trajectory, pt 0->1) while the 418-cell component maps to a constant (no gradient along this mode). Scaled to [0,1], root (min)=0."
  },
  "de_genes": {
    "method": "Per-gene Kruskal-Wallis H across the 4 discovered clusters (log-normalized), combined with max cluster fold-change: score = H * (1 + max(0, logFC)); ranked descending, top-20 over all 250 genes",
    "justification": "Non-parametric cluster-separation test (robust to dispersion) plus effect size captures candidate marker genes; no labels required. TFs are not excluded."
  },
  "grn": {
    "method": "Per-target elastic-net regression (L1+L2, coordinate descent with soft-thresholding) on graph-denoised, z-scored TF expression; l1_ratio=0.5, lam=0.10*lam_max; floor threshold 0.10; diagonal = 0. grn[i,j] = edge i->j",
    "justification": "Per-target regression is the standard directed GRN inference (handles direction and sign; i->j != j->i). L1 induces a sparse network. Graph denoising strengthens the signal."
  },
