tt=np.linspace(1,0,cbh)[:,None]
bar=cmap_div(tt/(1.0)).reshape(-1,3).astype(np.uint8)
canvas[cby:cby+cbh,cbx:cbx+cbw]=np.repeat(bar[:,None,:],cbw,axis=1)
write_png(f"{RES}/overview.png",canvas)
