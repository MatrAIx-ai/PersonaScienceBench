def _png(path, arr):
    import zlib, struct
    h, w, _ = arr.shape
    def chunk(t, d):
        c = t + d
        return struct.pack(">I", len(d)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)
    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(h))
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))
def _px(img, x, y, c):
    if 0 <= x < img.shape[1] and 0 <= y < img.shape[0]:
        img[y, x] = c
def _line(img, x0, y0, x1, y1, c, t=1):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1-x0), abs(y1-y0); sx = 1 if x0<x1 else -1; sy = 1 if y0<y1 else -1
    err = dx-dy
    while True:
        for a in range(t):
            for b in range(t):
                _px(img, x0+a, y0+b, c)
        if x0==x1 and y0==y1: break
        e2 = 2*err
        if e2 > -dy: err -= dy; x0 += sx
        if e2 < dx: err += dx; y0 += sy
def _rect(img, x0, y0, x1, y1, fill=None, edge=None, t=1):
    if fill is not None:
        for y in range(min(int(y0),int(y1)), max(int(y0),int(y1))+1):
            for x in range(min(int(x0),int(x1)), max(int(x0),int(x1))+1):
                _px(img, x, y, fill)
    if edge is not None:
        for a, b in [((x0,y0),(x1,y0)), ((x1,y0),(x1,y1)), ((x1,y1),(x0,y1)), ((x0,y1),(x0,y0))]:
            _line(img, a[0], a[1], b[0], b[1], edge, t)
def _text(img, x, y, s, sc=2, c=(0,0,0)):
    cx = x
    for ch in s:
        g = _FONT.get(ch, _FONT[' '])
        for r in range(7):
            for cc in range(5):
                if g[r][cc] == '1':
                    for a in range(sc):
                        for b in range(sc):
                            _px(img, cx+cc*sc+a, y+r*sc+b, c)
        cx += 6*sc

def overview_pure(path):
    W, H = 1040, 520
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    BLACK=(0,0,0); BLUE=(30,90,200); ORANGE=(220,140,0); RED=(200,30,30); GREEN=(0,140,0); GRAY=(190,190,190)
    # Panel 1: rate curve
    x0,y0,x1,y1 = 70,70,490,430
    xmin,xmax = xs_sorted.min(), xs_sorted.max(); ymin,ymax = ys_sorted.min(), ys_sorted.max()
    p = (ymax-ymin)*0.08 + 1e-12; ymin -= p; ymax += p
    def X1(x): return x0 + (x-xmin)/(xmax-xmin)*(x1-x0)
    def Y1(y): return y1 - (y-ymin)/(ymax-ymin)*(y1-y0)
    _rect(img, x0,y0,x1,y1, edge=BLACK)
    for gy in range(1,5): _line(img, x0, y0+(y1-y0)*gy/5, x1, y0+(y1-y0)*gy/5, GRAY)
    if -lam_tot < xmax:
        _rect(img, int(min(X1(-lam_tot),x1)), y0, x1, y1, fill=(250,224,224))
    _line(img, int(X1(-lam_tot)), y0, int(X1(-lam_tot)), y1, RED)
    for i in range(len(xs_sorted)-1):
        _line(img, X1(xs_sorted[i]),Y1(ys_sorted[i]), X1(xs_sorted[i+1]),Y1(ys_sorted[i+1]), BLUE, 2)
    for i in range(len(xs_sorted)):
        _rect(img, int(X1(xs_sorted[i])-2),int(Y1(ys_sorted[i])-2), int(X1(xs_sorted[i])+2),int(Y1(ys_sorted[i])+2), fill=BLUE)
    _rect(img, int(X1(xs_sorted[ipk_sorted])-4),int(Y1(ys_sorted[ipk_sorted])-4),
          int(X1(xs_sorted[ipk_sorted])+4),int(Y1(ys_sorted[ipk_sorted])+4), fill=GREEN)
    _text(img, (x0+x1)//2-130, 22, "MARCUS RATE CURVE", 2, BLACK)
    _text(img, (x0+x1)//2-100, 44, f"LAMBDA_TOTAL={lam_tot:.4f} EV", 1, BLACK)
    _text(img, (x0+x1)//2-40, y1+18, "DG (EV)", 1, BLACK)
    _text(img, 12, 58, "LOG10 K_ET (1/S)", 1, BLACK)
    _text(img, x0+10, y0+8, "PEAK ID="+str(peak_gid), 1, GREEN)
    _text(img, x0+10, y0+24, "SHADE=INVERTED", 1, RED)
    # Panel 2: |Qi|
    x0b,y0b,x1b,y1b = 590,70,1010,430
    ms = np.arange(nres, dtype=float)
    qmax = max(float(np.abs(Qf_ref).max()), float(np.abs(Qb_ref).max()), 1e-12)
    def X2(x): return x0b + (x-ms.min())/(ms.max()-ms.min())*(x1b-x0b)
    def Y2(y): return y1b - (y/(qmax*1.1))*(y1b-y0b)
    _rect(img, x0b,y0b,x1b,y1b, edge=BLACK)
    for gy in range(1,5): _line(img, x0b, y0b+(y1b-y0b)*gy/5, x1b, y0b+(y1b-y0b)*gy/5, GRAY)
    for i in range(nres-1):
        _line(img, X2(ms[i]),Y2(abs(Qf_ref[i])), X2(ms[i+1]),Y2(abs(Qf_ref[i+1])), BLUE, 2)
        _line(img, X2(ms[i]),Y2(abs(Qb_ref[i])), X2(ms[i+1]),Y2(abs(Qb_ref[i+1])), ORANGE, 2)
    for i in range(nres):
        _rect(img, int(X2(ms[i])-2),int(Y2(abs(Qf_ref[i]))-2), int(X2(ms[i])+2),int(Y2(abs(Qf_ref[i]))+2), fill=BLUE)
        _rect(img, int(X2(ms[i])-2),int(Y2(abs(Qb_ref[i]))-2), int(X2(ms[i])+2),int(Y2(abs(Qb_ref[i]))+2), fill=ORANGE)
    _text(img, (x0b+x1b)//2-90, 22, "MODAL PROFILE", 2, BLACK)
    _text(img, (x0b+x1b)//2-90, 44, "ABS(Q_I) BY MODE", 1, BLACK)
    _text(img, (x0b+x1b)//2-70, y1b+18, "MODE INDEX (0-BASED)", 1, BLACK)
    _text(img, 532, 58, "SQRT(AMU)*ANG", 1, BLACK)
    _text(img, x0b+10, y0b+8, "FORWARD (REF A)", 1, BLUE)
    _text(img, x0b+10, y0b+24, "BACKWARD (REF B)", 1, ORANGE)
    _png(path, img)

