#!/usr/bin/env python3
"""Solution-phase Marcus electron-transfer reorganization-energy & rate analysis.

Reads the inputs in data/ and writes all required outputs under results/.
Conventions:
  * All 21-component vectors and 15-mode bases are in ascending site_id order
    (raw frame rows permuted via frame_site_order.csv).
  * Signed displacement-like outputs use aligned_source - reference_target :
        forward = frame B (aligned into A) - frame A
        backward = frame A (aligned into B) - frame B
  * Cross-frame overlap / transported-profile outputs are magnitude-based.
  * driving-force grid rows are preserved in their original order.
  * overview.png uses matplotlib if available, else a dependency-free fallback.
"""
import os, csv, json
import numpy as np

DATA, RES = "data", "results"
os.makedirs(RES, exist_ok=True)

K_B_EV_K = 8.617333262145e-5    # eV / K
HBAR_EV_S = 6.582119569e-16     # eV * s

# ---------------- metadata ----------------
sites = {}
with open(f"{DATA}/site_table.csv") as f:
    for r in csv.DictReader(f):
        sites[int(r["site_id"])] = float(r["mass_amu"])
site_ids = sorted(sites)
nsite = len(site_ids)

order = {}
with open(f"{DATA}/frame_site_order.csv") as f:
    for r in csv.DictReader(f):
        order.setdefault(r["frame_id"], {})[int(r["row_index"])] = int(r["site_id"])

with open(f"{DATA}/system_manifest.json") as _fh:
    manifest = json.load(_fh)
nres = int(manifest["resolved_rank"])    # 15
nnul = int(manifest["null_rank"])        # 6
freq_scale = float(manifest["freq_scale_factor"])

with open(f"{DATA}/medium_response.json") as _fh:
    med = json.load(_fh)
T = float(med["temp_K"]); kT = K_B_EV_K * T
V = float(med["coupling_eV"]); span_A = float(med["span_A"])

mass = np.repeat([sites[s] for s in site_ids], 3)
sqrt_mass = np.sqrt(mass)

# ---------------- reorder raw rows -> ascending site_id x (x,y,z) ----------------
def coord_index(fr):
    arr = []
    for sid in site_ids:
        row = next(k for k, v in order[fr].items() if v == sid)
        for c in range(3):
            arr.append(row * 3 + c)
    return np.array(arr)

def reorder_coords(c, fr):
    out = np.zeros((nsite, 3))
    for row, sid in order[fr].items():
        out[sid] = c[row]
    return out

A = reorder_coords(np.load(f"{DATA}/frame_a_coords.npy"), "frame_a")
B = reorder_coords(np.load(f"{DATA}/frame_b_coords.npy"), "frame_b")
Ha = np.load(f"{DATA}/frame_a_hessian.npy")[np.ix_(coord_index("frame_a"), coord_index("frame_a"))]
Hb = np.load(f"{DATA}/frame_b_hessian.npy")[np.ix_(coord_index("frame_b"), coord_index("frame_b"))]
Ha = 0.5 * (Ha + Ha.T); Hb = 0.5 * (Hb + Hb.T)

# ---------------- Kabsch alignment (unweighted, per direction) ----------------
def kabsch(P, Q):
    cP = P.mean(0); cQ = Q.mean(0)
    U, S, Vt = np.linalg.svd((Q - cQ).T @ (P - cP))
    D = np.diag([1, 1, np.sign(np.linalg.det(Vt.T @ U.T))])
    R = Vt.T @ D @ U.T
    return R, cP - R @ cQ

def rmsd(P, Q):
    return float(np.sqrt(np.mean(np.sum((P - Q) ** 2, axis=1))))

Rf, tf = kabsch(A, B)
B_aligned = (Rf @ B.T + tf[:, None]).T
d_fwd = (B_aligned - A).reshape(21)          # source - reference
rmsd_fwd = rmsd(A, B_aligned)

Rb, tb = kabsch(B, A)
A_aligned = (Rb @ A.T + tb[:, None]).T
d_bwd = (A_aligned - B).reshape(21)
rmsd_bwd = rmsd(B, A_aligned)

d_fwd_mw = sqrt_mass * d_fwd
d_bwd_mw = sqrt_mass * d_bwd

# ---------------- mass-weighted normal modes: retain resolved_rank (15) ----------------
def mw_modes(H):
    inv = np.diag(1.0 / sqrt_mass)
    w, v = np.linalg.eigh(inv @ H @ inv)     # ascending frequency
    assert len(w) - nres == nnul             # drops exactly the 6 rigid modes
    return w[-nres:], v[:, -nres:]          # top-15 = resolved modes (ascending)

wA, LA = mw_modes(Ha)
wB, LB = mw_modes(Hb)
freqA = freq_scale * np.sqrt(np.clip(wA, 0.0, None))
freqB = freq_scale * np.sqrt(np.clip(wB, 0.0, None))

Qf_ref = LA.T @ d_fwd_mw      # forward  : ref=A, src=B  (signed)
Qf_src = LB.T @ d_fwd_mw
Qb_ref = LB.T @ d_bwd_mw      # backward : ref=B, src=A  (signed)
Qb_src = LA.T @ d_bwd_mw

lam4f = float(0.5 * d_fwd @ Ha @ d_fwd)
lam4b = float(0.5 * d_bwd @ Hb @ d_bwd)
lamnf = float(0.5 * np.sum(wA * Qf_ref ** 2))
lamnb = float(0.5 * np.sum(wB * Qb_ref ** 2))
lam_in  = 0.5 * (lamnf + lamnb)
lam_out = span_A * kT
lam_tot = lam_in + lam_out

proj_fwd_mw = LA @ Qf_ref
proj_bwd_mw = LB @ Qb_ref

ov_fwd = np.abs(LA.T @ LB)
ov_bwd = np.abs(LB.T @ LA)

def marcus(dG, lam):
    return (2.0*np.pi/HBAR_EV_S) * V**2 / np.sqrt(4.0*np.pi*lam*kT) \
           * np.exp(-(dG + lam) ** 2 / (4.0*lam*kT))

k_self = marcus(0.0, lam_tot)

with open(f"{DATA}/driving_force_grid.csv") as _fh:
    grid_rows = list(csv.DictReader(_fh))
gid = np.array([int(r["grid_id"]) for r in grid_rows])
axis = np.array([float(r["axis_eV"]) for r in grid_rows])
k_curve = np.array([marcus(g, lam_tot) for g in axis])
log10k = np.log10(k_curve)

ipk = int(np.argmax(k_curve))
inverted = axis > -lam_tot
inv_detected = bool(inverted.any())
fi = int(np.argmax(inverted)) if inv_detected else -1

np.save(f"{RES}/aligned_displacement_mw.npy", np.stack([d_fwd_mw, d_bwd_mw]))
np.save(f"{RES}/vibrational_basis_mw.npy", np.stack([LA, LB]))
np.save(f"{RES}/mode_overlap.npy", np.stack([ov_fwd, ov_bwd]))
np.save(f"{RES}/projected_displacement_mw.npy", np.stack([proj_fwd_mw, proj_bwd_mw]))
np.save(f"{RES}/transported_mode_projection.npy",
        np.stack([np.stack([np.abs(Qf_ref), np.abs(Qf_src)], axis=1),
                  np.stack([np.abs(Qb_ref), np.abs(Qb_src)], axis=1)]))
np.save(f"{RES}/mode_projection.npy",
        np.stack([np.stack([Qf_ref, freqA, 0.5*wA*Qf_ref**2], axis=1),
                  np.stack([Qb_ref, freqB, 0.5*wB*Qb_ref**2], axis=1)]))

with open(f"{RES}/lambda_summary.csv", "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["lambda_4pt_forward_eV","lambda_4pt_backward_eV","lambda_nm_forward_eV",
                "lambda_nm_backward_eV","lambda_inner_effective_eV","lambda_outer_eV",
                "lambda_total_eV","k_self_exchange_s_inv"])
    w.writerow([lam4f, lam4b, lamnf, lamnb, lam_in, lam_out, lam_tot, k_self])

with open(f"{RES}/rate_curve.csv", "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["grid_id","axis_eV","k_et_s_inv","log10_k_et_s_inv"])
    for i in range(len(gid)):
        w.writerow([gid[i], axis[i], k_curve[i], log10k[i]])

diag = {
    "alignment_rmsd_forward_A": rmsd_fwd,
    "alignment_rmsd_backward_A": rmsd_bwd,
    "closure_error_forward_eV": lam4f - lamnf,
    "closure_error_backward_eV": lam4b - lamnb,
    "effective_inner_consistency_eV": abs(0.5*(lamnf + lamnb) - 0.5*(lam4f + lam4b)),
    "rigid_norm_forward": float(np.linalg.norm(d_fwd_mw - proj_fwd_mw)),
    "rigid_norm_backward": float(np.linalg.norm(d_bwd_mw - proj_bwd_mw)),
    "projected_norm_forward": float(np.linalg.norm(proj_fwd_mw)),
    "projected_norm_backward": float(np.linalg.norm(proj_bwd_mw)),
    "dominant_mode_forward": int(np.argmax(np.abs(Qf_ref))),
    "dominant_mode_backward": int(np.argmax(np.abs(Qb_ref))),
    "rate_peak_grid_id": int(gid[ipk]),
    "rate_peak_axis_eV": float(axis[ipk]),
    "rate_peak_s_inv": float(k_curve[ipk]),
    "inverted_region_detected": inv_detected,
    "first_inverted_grid_id": int(gid[fi]) if inv_detected else None,
    "first_inverted_axis_eV": float(axis[fi]) if inv_detected else None,
}
with open(f"{RES}/diagnostics.json", "w") as _fh:
    json.dump(diag, _fh, indent=2)

xs_sorted = np.sort(axis)
ys_sorted = log10k[np.argsort(axis)]
ipk_sorted = int(np.argmax(ys_sorted))
peak_gid = int(gid[ipk])

def overview_matplotlib(path):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(1, 2, figsize=(13, 5))
    ax = axes[0]
    ax.plot(xs_sorted, ys_sorted, "-o", ms=3, lw=1, label="Marcus k(dG)")
    ax.axvspan(-lam_tot, xs_sorted.max(), color="red", alpha=0.12, label="inverted (dG>-lam)")
    ax.axvline(-lam_tot, color="red", ls="--", lw=1)
    ax.plot([xs_sorted[ipk_sorted]], [ys_sorted[ipk_sorted]], "g*", ms=14, label=f"peak id={peak_gid}")
    ax.set_xlabel("dG (eV)"); ax.set_ylabel("log10 k_ET (s$^{-1}$)")
    ax.set_title(f"Marcus rate curve  (lambda_total={lam_tot:.4f} eV)")
    ax.legend(fontsize=8); ax.grid(alpha=0.3)
    ax = axes[1]
    m = np.arange(nres)
    ax.plot(m, np.abs(Qf_ref), "-o", ms=4, label="forward |Qi| (ref A)")
    ax.plot(m, np.abs(Qb_ref), "-s", ms=4, label="backward |Qi| (ref B)")
    ax.set_xlabel("retained mode index (0-based, ascending freq)")
    ax.set_ylabel("|Qi| (sqrt(amu)*Angstrom)")
    ax.set_title("Modal displacement profile |Qi|")
    ax.legend(fontsize=8); ax.grid(alpha=0.3)
    fig.tight_layout(); fig.savefig(path, dpi=120); plt.close(fig)

