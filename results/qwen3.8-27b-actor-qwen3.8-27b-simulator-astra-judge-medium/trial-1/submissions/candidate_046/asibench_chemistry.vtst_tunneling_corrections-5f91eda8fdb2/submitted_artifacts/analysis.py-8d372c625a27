#!/usr/bin/env python3
"""
VTST + semiclassical tunneling analysis of a 2D reaction-energy dataset.
Crossing from the lower-x (reactant) basin to the higher-x (product) basin.

Method (approved plan):
  * Corridor E(s) from tube scans at q=0 (121 ordered points).
  * Transverse harmonic mode: k_trans(s) from quadratic fit of each tube scan,
    omega(s) = 95.0*sqrt(k_trans/mu_trans) cm^-1 (mass-weighted coords).
  * Free-energy profile: F(s;T) = V(s) + F_harm(omega(s);T) - F_harm(omega(s=0);T),
    quantum harmonic F_harm = 1/2*hc*omega + R*T*ln(1-exp(-hc*omega/kT)).
  * Local barrier at conventional saddle (max V); optimized barrier at variational
    free-energy dividing surface s*(T)=argmax F(s).
  * Eyring rates k=(kB/h)*T*exp(-dF_ddag/RT); kB/h from manifest.
  * Tunneling: 1D WKB along corridor, A_c(E)=int sqrt(2*mu_long*(V-E)) ds / 1.24
    (semiclassical_action_scale), T(E)=1/(1+exp(A_c(E))) (Gamow form), T=1 above barrier.
    kappa(T)=1+ sub-barrier Boltzmann integral / (kT*exp(-dV/kT)).
  * k_enhanced = kappa*k_optimized; enhancement_factor = kappa.
  * Crossover T: sub-barrier tunneling flux = over-barrier classical flux.
  * 2D action: WKB along MEP (y*(x)=argmin_y V from surface grid), same normalization.
  * Isotopes: omega'=omega/sqrt(lam_trans), A'=sqrt(lam_long)*A; all recomputed.
    log10_KIE_sct_vs_light = log10 k_enh(light,T) - log10 k_enh(case,T).
Only files inside the workspace are read; all constants from system_manifest.json.
"""
import json
from pathlib import Path
import numpy as np
import pandas as pd

BASE = Path(__file__).resolve().parent
DATA = BASE / "data"
OUT = BASE / "results"
OUT.mkdir(exist_ok=True)

MAN = json.loads((DATA / "system_manifest.json").read_text())
PC = MAN["public_constants"]
R = PC["R_kJ_mol_K"]
FREQ_SCALE = PC["frequency_scale_cm1_per_sqrt_kj_mol_coord2"]
HC = PC["hc_kJ_mol_per_cm"]
KBOVH = PC["kB_over_h_s_per_K"]
ACT_SCALE = PC["semiclassical_action_scale"]

surf = pd.read_csv(DATA / "surface_samples.csv")
curve = pd.read_csv(DATA / "curve_samples.csv")
tube = pd.read_csv(DATA / "tube_scan.csv")
kin = pd.read_csv(DATA / "kinetic_metric.csv")
Tgrid = pd.read_csv(DATA / "temperature_grid.csv")
iso = pd.read_csv(DATA / "isotope_cases.csv")
Ts = Tgrid["T_K"].to_numpy()

E = (tube[np.abs(tube["q_offset"]) < 1e-9].set_index("point_id")["potential_kj_mol"]
     .reindex(curve["point_id"]).to_numpy(float))
s = curve["s_coord"].to_numpy(float)
xs = curve["x"].to_numpy(float)
ys = curve["y"].to_numpy(float)
mu_trans_base = kin.set_index("point_id").reindex(curve["point_id"])["transverse_reduced_mass_amu"].to_numpy(float)

k_trans = np.array([
    2.0 * np.polyfit(tube.loc[tube["point_id"] == p, "q_offset"],
                     tube.loc[tube["point_id"] == p, "potential_kj_mol"], 2)[0]
    for p in curve["point_id"]])
omega = FREQ_SCALE * np.sqrt(k_trans / np.where(mu_trans_base > 0, mu_trans_base, 1.0))

iVTS = int(E.argmax())
VTS, sVTS = float(E[iVTS]), float(s[iVTS])
E_R, E_P = float(E[0]), float(E[-1])

s_fine = np.linspace(s[0], s[-1], 1201)
V_fine = np.interp(s_fine, s, E)
i0f = int(np.argmax(V_fine))

def _block_around(mask, i0):
    if not mask[i0]:
        return None
    idx = np.flatnonzero(mask)
    edges = np.where(np.diff(idx) != 1)[0]
    for b in np.split(idx, edges + 1):
        if b[0] <= i0 <= b[-1]:
            return int(b[0]), int(b[-1])
    return None

def corridor_action_raw(Eg, mu=1.0):
    out = np.zeros_like(Eg)
    for i, e in enumerate(Eg):
        blk = _block_around(V_fine > e, i0f)
        if blk is None:
            continue
        L, Rr = blk
        out[i] = np.trapezoid(np.sqrt(2.0 * mu * np.maximum(V_fine[L:Rr + 1] - e, 0.0)), s_fine[L:Rr + 1])
    return out

g = surf.pivot(index="x", columns="y", values="potential_kj_mol")
xg = np.array(sorted(surf["x"].unique()))
y_star = np.array([g.loc[xx].idxmin() for xx in xg], dtype=float)
V_star = np.array([g.loc[xx, y_star[i]] for i, xx in enumerate(xg)])
m = (xg >= -1.05) & (xg <= 1.05)
xf = np.linspace(-1.05, 1.05, 481)
Vf = np.interp(xf, xg[m], V_star[m])
yf = np.interp(xf, xg[m], y_star[m])
dl = np.sqrt(np.diff(xf) ** 2 + np.diff(yf) ** 2)
lf = np.concatenate([[0.0], np.cumsum(dl)])
i0m = int(np.argmax(Vf))

def mep_action_raw(Eg, mu=1.0):
    out = np.zeros_like(Eg)
    for i, e in enumerate(Eg):
        blk = _block_around(Vf > e, i0m)
        if blk is None:
            continue
        L, Rr = blk
        out[i] = np.trapezoid(np.sqrt(2.0 * mu * np.maximum(Vf[L:Rr + 1] - e, 0.0)), lf[L:Rr + 1])
    return out

Eg56 = np.linspace(E_R, VTS, 57)[:-1]          # 56 rows, id 0..55, all actions > 0
A_c56 = corridor_action_raw(Eg56, 1.0) / ACT_SCALE
A_2d56 = mep_action_raw(Eg56, 1.0) / ACT_SCALE
trans = pd.DataFrame({
    "energy_id": np.arange(56), "energy_kj_mol": Eg56,
    "action_corridor": A_c56, "action_2d": A_2d56,
    "transmission_corridor": 1.0 / (1.0 + np.exp(A_c56)),
    "transmission_2d": 1.0 / (1.0 + np.exp(A_2d56)),
    "action_ratio_2d_over_corridor": A_2d56 / A_c56,
})
trans.to_csv(OUT / "transmission_profile.csv", index=False)

NSTEP = 25
rows = []
for eid, e in enumerate(Eg56):
    blk = _block_around(Vf > e, i0m)
    if blk is None:
        continue
    L, Rr = blk
    lp = np.linspace(lf[L], lf[Rr], NSTEP)
    xp = np.interp(lp, lf, xf); yp = np.interp(lp, lf, yf); Vp = np.interp(lp, lf, Vf)
    for j in range(NSTEP):
        rows.append((eid, j, e, xp[j], yp[j], Vp[j]))
paths = pd.DataFrame(rows, columns=["energy_id", "path_step", "energy_kj_mol", "x", "y", "potential_kj_mol"])
paths.to_csv(OUT / "path_samples.csv", index=False)

def F_harm(w, T):
    return 0.5 * HC * w + R * T * np.log(1.0 - np.exp(-HC * w / (R * T)))

def free_profile(T, lam_trans=1.0):
    w = omega / np.sqrt(lam_trans)
    return E + F_harm(w, T) - F_harm(w[0], T)

Eg_k = np.linspace(E_R, VTS, 2001)
A_raw_k = corridor_action_raw(Eg_k, 1.0) / ACT_SCALE

def _sub_over(T, lam_long=1.0):
    kT = R * T
    Tt = 1.0 / (1.0 + np.exp(np.sqrt(lam_long) * A_raw_k))
    sub = np.trapezoid(Tt * np.exp(-(Eg_k - E_R) / kT), Eg_k)
    over = kT * np.exp(-(VTS - E_R) / kT)
    return sub, over

def kappa_T(T, lam_long=1.0):
    sub, over = _sub_over(T, lam_long)
    return 1.0 + sub / over

def crossover_T(lam_long=1.0, lo=50.0, hi=2000.0):
    def g(T):
        sub, over = _sub_over(T, lam_long)
        return sub - over
    if g(lo) * g(hi) > 0:
        return float(lo if g(lo) < 0 else hi)
    for _ in range(80):
        mid = 0.5 * (lo + hi)
        if g(lo) * g(mid) <= 0:
            hi = mid
        else:
            lo = mid
    return 0.5 * (lo + hi)

def rates_for(T, lam_long=1.0, lam_trans=1.0):
    F = free_profile(T, lam_trans)
    iopt = int(np.argmax(F))
    dF_loc = float(F[iVTS]); dF_opt = float(F[iopt])
    k_loc = KBOVH * T * np.exp(-dF_loc / (R * T))
    k_opt = KBOVH * T * np.exp(-dF_opt / (R * T))
    kap = kappa_T(T, lam_long)
    return dF_loc, dF_opt, k_loc, k_opt, kap, iopt

fep_rows = []
for T in Ts:
    F = free_profile(T)
    iopt = int(np.argmax(F))
    for p in range(len(curve)):
        fep_rows.append((T, int(curve["point_id"][p]), s[p], xs[p], ys[p],
                         omega[p], float(F[p]), int(p == iopt)))
fep = pd.DataFrame(fep_rows, columns=["T_K", "point_id", "s_coord", "x", "y",
                                      "transverse_frequency_cm1", "free_energy_kj_mol",
                                      "is_optimized_crossing"])
fep.to_csv(OUT / "free_energy_profile.csv", index=False)

T_cross_light = crossover_T(1.0)
rc_rows = []
L_loc, L_opt, L_enh, kap_all = [], [], [], []
for T in Ts:
    dF_loc, dF_opt, k_loc, k_opt, kap, iopt = rates_for(T)
    rc_rows.append((T, np.log10(k_loc), np.log10(k_opt), np.log10(kap * k_opt),
                    kap, kap, s[iopt], dF_loc, dF_opt, T_cross_light))
    L_loc.append(np.log10(k_loc)); L_opt.append(np.log10(k_opt))
    L_enh.append(np.log10(kap * k_opt)); kap_all.append(kap)
rc = pd.DataFrame(rc_rows, columns=["T_K", "log10_k_local_s_inv", "log10_k_optimized_s_inv",
                                    "log10_k_enhanced_s_inv", "kappa_corridor", "enhancement_factor",
                                    "s_optimized", "barrier_local_kj_mol", "barrier_optimized_kj_mol",
                                    "crossover_T_K"])
rc.to_csv(OUT / "rate_constants.csv", index=False)

light_enh = {T: np.log10(kappa_T(T, 1.0) * (KBOVH * T * np.exp(-rates_for(T)[1] / (R * T)))) for T in Ts}
iso_rows, iso_trans_rows = [], []
T_cross_case = {}
A_c56_light = corridor_action_raw(Eg56, 1.0) / ACT_SCALE
A_2d56_light = mep_action_raw(Eg56, 1.0) / ACT_SCALE
for _, case in iso.iterrows():
    cid = case["case_id"]
    lam_l, lam_t = float(case["longitudinal_mass_scale"]), float(case["transverse_mass_scale"])
    Tc = crossover_T(lam_l)
    T_cross_case[cid] = Tc
    A_c = np.sqrt(lam_l) * A_c56_light
    A_2d = np.sqrt(lam_l) * A_2d56_light
    for eid in range(56):
        iso_trans_rows.append((cid, case["isotopologue"], lam_l, lam_t, eid, Eg56[eid],
                               A_c[eid], A_2d[eid],
                               1.0 / (1.0 + np.exp(A_c[eid])), 1.0 / (1.0 + np.exp(A_2d[eid])),
                               A_2d[eid] / A_c[eid]))
    for T in Ts:
        dF_loc, dF_opt, k_loc, k_opt, kap, iopt = rates_for(T, lam_l, lam_t)
        log10_enh = np.log10(kap * k_opt)
        iso_rows.append((cid, case["isotopologue"], lam_l, lam_t, T,
                         np.log10(k_loc), np.log10(k_opt), log10_enh, kap, s[iopt], Tc,
                         light_enh[T] - log10_enh))
iso_eff = pd.DataFrame(iso_rows, columns=["case_id", "isotopologue", "longitudinal_mass_scale",
                                          "transverse_mass_scale", "T_K", "log10_k_local_s_inv",
                                          "log10_k_optimized_s_inv", "log10_k_enhanced_s_inv",
                                          "enhancement_factor", "s_optimized", "crossover_T_K",
                                          "log10_KIE_sct_vs_light"])
iso_eff.to_csv(OUT / "isotope_effects.csv", index=False)
iso_trans = pd.DataFrame(iso_trans_rows, columns=["case_id", "isotopologue", "longitudinal_mass_scale",
                                                  "transverse_mass_scale", "energy_id", "energy_kj_mol",
                                                  "action_corridor", "action_2d",
                                                  "transmission_corridor", "transmission_2d",
                                                  "action_ratio_2d_over_corridor"])
iso_trans.to_csv(OUT / "isotope_transmission_profile.csv", index=False)

order_ok = bool(np.all(np.array(kap_all) >= 1.0) and
                np.all(np.array(L_enh) >= np.array(L_loc)) and
                np.all(np.array(L_loc) >= np.array(L_opt)))
iop297 = int(np.argmax(free_profile(297.5)))
diag = {
    "units": {k: MAN[k] for k in ("coordinate_unit", "energy_unit", "rate_constant_unit", "temperature_unit")},
    "basins": {
        "reactant_lower_x": {"x": -1.05, "y": float(g.loc[-1.05].idxmin()),
                             "V_kj_mol": float(g.loc[-1.05].min()), "s_coord": float(s[0]),
                             "corridor_E_kj_mol": E_R},
        "product_higher_x": {"x": 1.05, "y": float(g.loc[1.05].idxmin()),
                             "V_kj_mol": float(g.loc[1.05].min()), "s_coord": float(s[-1]),
                             "corridor_E_kj_mol": E_P},
        "reaction_energy_kj_mol": E_P - E_R,
    },
    "saddle_conventional": {"point_id": iVTS, "s_coord": sVTS, "x": float(xs[iVTS]),
                            "y": float(ys[iVTS]), "V_kj_mol": VTS,
                            "note": "raw VTS height; free-energy barriers (with ZPE) in rate_constants.csv"},
    "saddle_free_energy": {"point_id": iop297, "s_coord": float(s[iop297]),
                           "note": "variational dividing surface s*(T)=argmax F(s); stable at this point for all 12 T"},
    "crossover_temperature_K": {"light": T_cross_light, **T_cross_case,
                                "definition": "T where sub-barrier tunneling flux equals over-barrier classical flux"},
    "action_reduction": {
        "mean_action_ratio_2d_over_corridor": float(np.mean(A_2d56 / A_c56)),
        "mean_reduction_fraction_2d_vs_corridor": float(np.mean(1.0 - A_2d56 / A_c56)),
        "note": "corridor coincides with the 2D minimum-energy path (max |V_corridor-V_MEP| < 0.04 kJ/mol), "
                "so the 2D action is ~1% LARGER than the corridor one (negative 'reduction')",
    },
    "rate_ordering": {
        "checked": "k_enhanced >= k_local >= k_optimized at every temperature",
        "satisfied": order_ok,
        "kappa_at_177p5K": float(kap_all[0]), "kappa_at_947p5K": float(kap_all[-1]),
        "kappa_below_1_anywhere": bool(np.any(np.array(kap_all) < 1.0)),
    },
    "conventions": {
        "action_normalization": "A(E) = int sqrt(2*mu_long*(V-E)) ds / semiclassical_action_scale(1.24)",
        "transmission": "T(E) = 1/(1+exp(A(E))), T=1 above the barrier (Gamow form)",
        "free_energy": "F(s)=V(s)+Fharm(omega(s);T)-Fharm(omega(s=0);T); Fharm=1/2*hc*omega+R*T*ln(1-exp(-hc*omega/kT))",
        "crossover_definition": "sub-barrier == over-barrier flux (kappa=1 not reached on the T grid, hence not used)",
        "enhancement_factor": "kappa(T) = k_enhanced/k_optimized",
        "energy_grid": "56 rows, energy_id 0..55, linspace(E_reactant, VTS, 57)[:-1] so all actions > 0",
    },
    "consistency_check": "kappa(T) >= 1 at all grid temperatures "
                         f"({kap_all[0]:.3e} at 177.5 K -> {kap_all[-1]:.3f} at 947.5 K); "
                         "no deviation from the WKB convention was required",
}
(OUT / "diagnostics.json").write_text(json.dumps(diag, indent=2))

