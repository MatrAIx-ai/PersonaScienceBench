    _vline(buf, W, H, lx, ly, ly + 62, BLACK); _vline(buf, W, H, lx + 272, ly, ly + 62, BLACK)
    _line(buf, W, H, lx + 10, ly + 12, lx + 40, ly + 12, BLUE)
    _dot(buf, W, H, lx + 25, ly + 12, 3, BLUE, "circle")
    _draw_text(buf, W, H, lx + 50, ly + 6, "k local (conventional)", BLACK)
    _line(buf, W, H, lx + 10, ly + 26, lx + 40, ly + 26, ORANGE)
    _dot(buf, W, H, lx + 25, ly + 26, 3, ORANGE, "square")
