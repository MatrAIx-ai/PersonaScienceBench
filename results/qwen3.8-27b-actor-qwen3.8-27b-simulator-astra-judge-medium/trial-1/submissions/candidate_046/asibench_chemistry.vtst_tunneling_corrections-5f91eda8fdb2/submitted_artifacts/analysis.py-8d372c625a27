def _put_px(buf, W, H, x, y, color):
    if 0 <= x < W and 0 <= y < H:
        i = (y * W + x) * 3
        buf[i:i + 3] = color

def _draw_text(buf, W, H, x, y, text, color, scale=1):
    for ch in text:
        g = _FONT.get(ch, _FONT[' ']).split()
        for r in range(7):
            for cb in range(5):
                if g[r][cb] == '1':
                    for dy in range(scale):
                        for dx in range(scale):
                            _put_px(buf, W, H, x + cb * scale + dx, y + r * scale + dy, color)
        x += 6 * scale

def _hline(buf, W, H, x0, x1, y, color, t=1):
    for yy in range(t):
        for x in range(x0, x1 + 1):
            _put_px(buf, W, H, x, y + yy, color)

def _vline(buf, W, H, x, y0, y1, color, t=1):
    for xx in range(t):
        for y in range(y0, y1 + 1):
            _put_px(buf, W, H, x + xx, y, color)

def _line(buf, W, H, x0, y0, x1, y1, color, t=2):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    n = max(abs(x1 - x0), abs(y1 - y0), 1)
    for i in range(n + 1):
        x = x0 + (x1 - x0) * i / n
        y = y0 + (y1 - y0) * i / n
        for dx in range(t):
            for dy in range(t):
                _put_px(buf, W, H, int(x) + dx, int(y) + dy, color)

def _dline(buf, W, H, x0, y0, x1, y1, color, t=1, dash=7):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    n = max(abs(x1 - x0), abs(y1 - y0), 1)
    for i in range(n + 1):
        if (i // dash) % 2:
            continue
        x = x0 + (x1 - x0) * i / n
        y = y0 + (y1 - y0) * i / n
        for dx in range(t):
            for dy in range(t):
                _put_px(buf, W, H, int(x) + dx, int(y) + dy, color)

def _dot(buf, W, H, cx, cy, r, color, shape="circle"):
    for dy in range(-r, r + 1):
        for dx in range(-r, r + 1):
            keep = ((dx * dx + dy * dy) <= r * r) if shape == "circle" else \
                   (abs(dx) + abs(dy) <= r) if shape == "diamond" else (abs(dx) <= r and abs(dy) <= r)
            if keep:
                _put_px(buf, W, H, cx + dx, cy + dy, color)

def _save_png(path, W, H, buf):
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    raw = b"".join(b"\x00" + bytes(buf[y * W * 3:(y + 1) * W * 3]) for y in range(H))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    Path(path).write_bytes(png)

def make_rate_plot(path, xx, L_loc, L_opt, L_enh, kap):
    xx, kap = np.asarray(xx, float), np.asarray(kap, float)
    L_loc, L_opt, L_enh = (np.asarray(v, float) for v in (L_loc, L_opt, L_enh))
    W, H = 1000, 640
    buf = bytearray([255] * (W * H * 3))
    BLACK, GRID = (0, 0, 0), (215, 215, 215)
    BLUE, ORANGE, GREEN = (31, 119, 180), (255, 127, 14), (44, 160, 44)
    PL, PR, PT, PB = 100, 890, 70, 560
    xv, yv = xx, np.concatenate([L_loc, L_opt, L_enh])
    xlo, xhi = float(xv.min()), float(xv.max())          # 1000/T: high on left (inverted)
    ylo = int(np.floor(yv.min() - 0.5)); yhi = int(np.ceil(yv.max() + 0.5))
    klo, khi = int(np.floor(np.log10(kap.min()))), int(np.ceil(np.log10(kap.max())))
    def X(v): return PL + (xhi - v) / (xhi - xlo) * (PR - PL)
    def Y(v): return PB - (v - ylo) / (yhi - ylo) * (PB - PT)
    def Y2(v): return PB - (v - klo) / (khi - klo) * (PB - PT)
    for xt in range(1, 6):
        _vline(buf, W, H, int(X(xt)), PT, PB, GRID)
        _draw_text(buf, W, H, int(X(xt)) - 3, PB + 8, str(xt), BLACK)
    for yt in range(ylo, yhi + 1, 2):
        _hline(buf, W, H, PL, PR, int(Y(yt)), GRID)
        _draw_text(buf, W, H, PL - 28, int(Y(yt)) - 4, str(yt), BLACK)
    for kt in range(klo, khi + 1):
        lab = "1" if kt == 0 else ("10" if kt == 1 else (f"1e{kt}" if kt >= 3 else str(10 ** kt)))
        _draw_text(buf, W, H, PR + 8, int(Y2(kt)) - 4, lab, BLACK)
    _hline(buf, W, H, PL, PR, PT, BLACK); _hline(buf, W, H, PL, PR, PB, BLACK)
    _vline(buf, W, H, PL, PT, PB, BLACK); _vline(buf, W, H, PR, PT, PB, BLACK)
    for vals, col, shp in ((L_loc, BLUE, "circle"), (L_opt, ORANGE, "square"), (L_enh, GREEN, "diamond")):
        pts = [(int(X(xv[i])), int(Y(vals[i]))) for i in range(len(xv))]
        for a, b in zip(pts[:-1], pts[1:]):
            _line(buf, W, H, a[0], a[1], b[0], b[1], col)
        for (px, py) in pts:
            _dot(buf, W, H, px, py, 3, col, shp)
    kpts = [(int(X(xv[i])), int(Y2(np.log10(kap[i])))) for i in range(len(xv))]
    for a, b in zip(kpts[:-1], kpts[1:]):
        _dline(buf, W, H, a[0], a[1], b[0], b[1], BLACK)
    _draw_text(buf, W, H, 326, 25, "basin-crossing rates: local vs optimized vs tunneling-enhanced", BLACK)
    _draw_text(buf, W, H, 430, 595, "1000 / T [1/K]", BLACK)
    for i, ch in enumerate("log10 k [s^-1]"):
        _draw_text(buf, W, H, 28, 235 + i * 11, ch, BLACK)
    for i, ch in enumerate("kappa (log)"):
