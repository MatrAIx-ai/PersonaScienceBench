def _put_text(img, x, y, s, scale, color):
    cx = x
    for ch in s:
        g = _FONT5X7.get(ch, _FONT5X7[" "])
        for ry in range(7):
            for rx in range(5):
                if g[ry][rx] == "1":
                    img[y + ry * scale: y + (ry + 1) * scale,
                        cx + rx * scale: cx + (rx + 1) * scale] = color
        cx += 6 * scale

def _draw_line(arr, x0, y0, x1, y1, color, width=2):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    for t in range(n + 1):
        x = int(round(x0 + (x1 - x0) * t / n))
        y = int(round(y0 + (y1 - y0) * t / n))
        arr[max(0, y - width // 2): y + width // 2 + 1,
            max(0, x - width // 2): x + width // 2 + 1] = color

def _write_png(path, arr):
    import struct
    import zlib
    H, W = arr.shape[:2]
    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(H))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def make_figure_pil():
    """Stdlib 4-panel diagnostic figure (fallback when matplotlib is absent)."""
    W, H = 1400, 1000
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    black = (0, 0, 0)
    _put_text(img, W // 2 - 120, 14, "CI engine audit", 3, black)
    panels = [
        (20, 60, 680, 480, "engine_score"),
        (700, 60, 1380, 480, "width ratio"),
        (20, 520, 680, 940, "coverage"),
        (700, 520, 1380, 940, "probe metrics"),
    ]
    for (x0, y0, x1, y1, title) in panels:
        img[y0: y1 + 1, x0: x0 + 2] = black
        img[y0: y0 + 2, x0: x1 + 1] = black
        img[y1: y1 + 1, x0: x1 + 1] = black
        img[y0: y1 + 1, x1: x1 + 2] = black
        _put_text(img, x0 + 10, y0 + 8, title, 2, black)
        _draw_line(img, x0, y1 - 20, x1 - 10, y1 - 20, black)
    palette = np.array([[int(200 * (1 - t)), int(200 * t), 120]
                        for t in np.linspace(0, 1, n_eng)], dtype=np.uint8)
    # panel 1: bars of engine_score (selected engine in red)
    x0, y0, x1, y1 = panels[0][:4]
    mx = float(engine_score.max())
    bw = (x1 - x0 - 60) / n_eng
    for j in range(n_eng):
        h = int((y1 - y0 - 80) * engine_score[j] / mx)
        col = (220, 30, 30) if engines[j] == selected_engine else (70, 110, 180)
        img[y1 - 20 - h: y1 - 20, int(x0 + 40 + j * bw): int(x0 + 40 + (j + 1) * bw - 6)] = col
        _put_text(img, int(x0 + 40 + j * bw + bw / 2 - 8), y1 - 4, str(j).rjust(2, "0"), 1, black)
    # panel 2: width ratio lines per engine
    x0, y0, x1, y1 = panels[1][:4]
    lo, hi = float(wr.min()), float(wr.max())
    for j in range(n_eng):
        pts = [(x0 + 40 + (x1 - x0 - 80) * i / (n_case - 1),
                y1 - 20 - (y1 - y0 - 80) * (wr[j, i] - lo) / (hi - lo)) for i in range(n_case)]
        for (xa, ya), (xb, yb) in zip(pts[:-1], pts[1:]):
            _draw_line(img, xa, ya, xb, yb, tuple(int(v) for v in palette[j]))
    # panel 3: coverage lines + nominal dashed line
    x0, y0, x1, y1 = panels[2][:4]
    lo, hi = float(emp_cov.min()) - 0.01, float(emp_cov.max()) + 0.01
    for j in range(n_eng):
        pts = [(x0 + 40 + (x1 - x0 - 80) * i / (n_case - 1),
                y1 - 20 - (y1 - y0 - 80) * (emp_cov[j, i] - lo) / (hi - lo)) for i in range(n_case)]
        for (xa, ya), (xb, yb) in zip(pts[:-1], pts[1:]):
            _draw_line(img, xa, ya, xb, yb, tuple(int(v) for v in palette[j]))
    py = y1 - 20 - (y1 - y0 - 80) * (nominal - lo) / (hi - lo)
    xx = x0 + 40
    while xx < x1 - 40:
        _draw_line(img, xx, py, min(xx + 12, x1 - 40), py, black)
        xx += 20
    _put_text(img, x1 - 100, int(py) - 14, "nominal", 1, black)
    # panel 4: grouped bars of probe metrics
    x0, y0, x1, y1 = panels[3][:4]
    mx = float(probe_means.max())
    gw = (x1 - x0 - 60) / n_eng
    for j in range(n_eng):
        for k in range(5):
            h = int((y1 - y0 - 80) * probe_means[k, j] / mx)
            col = tuple(int(v) for v in palette[j])
            img[y1 - 20 - h: y1 - 20, int(x0 + 40 + j * gw + k * 5): int(x0 + 40 + j * gw + k * 5 + 4)] = col
        _put_text(img, int(x0 + 40 + j * gw + gw / 2 - 8), y1 - 4, str(j).rjust(2, "0"), 1, black)
    _write_png(os.path.join(OUT, "engine_overview.png"), img)


