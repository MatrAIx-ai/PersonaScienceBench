class MiniCanvas:
    """Tiny deterministic RGB raster canvas with text/line/bar primitives."""

    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.px = np.zeros((h, w, 3), np.uint8)
        self.px[..., 0] = bg[0]; self.px[..., 1] = bg[1]; self.px[..., 2] = bg[2]

    def _stamp(self, x, y, s, color):
        x0, x1 = max(0, x), min(self.w, x + s)
        y0, y1 = max(0, y), min(self.h, y + s)
        if x1 > x0 and y1 > y0:
            self.px[y0:y1, x0:x1] = color

    def text(self, x, y, s, color=(0, 0, 0), scale=2):
        x, y = int(x), int(y)
        for ch in str(s):
            g = _FONT.get(ch, _FONT[' '])
            for r in range(7):
                bits = g[r]
                for c in range(5):
                    if bits & (16 >> c):
                        self._stamp(x + c * scale, y + r * scale, scale, color)
            x += 6 * scale
        return x

    def text_w(self, s, scale=2):
        return 6 * scale * len(str(s))

    def hline(self, x0, x1, y, color=(0, 0, 0), thick=1):
        self.px[int(y):int(y) + thick, int(x0):int(x1) + 1] = color

    def vline(self, x, y0, y1, color=(0, 0, 0), thick=1):
        self.px[int(y0):int(y1) + 1, int(x):int(x) + thick] = color

    def line(self, x0, y0, x1, y1, color=(0, 0, 0), thick=2):
        n = int(max(abs(x1 - x0), abs(y1 - y0)) * 2) + 1
        for t in np.linspace(0, 1, n):
            x = x0 + (x1 - x0) * t
            y = y0 + (y1 - y0) * t
            self._stamp(int(x - thick / 2), int(y - thick / 2), thick, color)

    def dot(self, x, y, color=(200, 30, 30), r=4):
        self._stamp(int(x - r), int(y - r), 2 * r + 1, color)

    def rect(self, x0, y0, x1, y1, color):
        self.px[int(y0):int(y1) + 1, int(x0):int(x1) + 1] = color

    def save(self, path):
        h, w, _ = self.px.shape
        raw = b"".join(b"\x00" + self.px[r].tobytes() for r in range(h))

        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data +
                    struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

        png = b"\x89PNG\r\n\x1a\n"
        png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
        png += chunk(b"IDAT", zlib.compress(raw, 9))
        png += chunk(b"IEND", b"")
        with open(path, "wb") as fh:
            fh.write(png)


class Plot:
    """Axis helpers on top of MiniCanvas (data coords -> pixels)."""

    BLACK = (30, 30, 30)
    GRID = (215, 215, 215)

    def __init__(self, w, h, ml=70, mr=20, mt=40, mb=55):
        self.cv = MiniCanvas(w, h)
        self.x0, self.x1 = ml, w - mr
        self.y0, self.y1 = mt, h - mb  # y0 = top (high values)

    def sx(self, v, vmin, vmax):
        return self.x0 + (v - vmin) / (vmax - vmin) * (self.x1 - self.x0)

    def sy(self, v, vmin, vmax):
        return self.y1 - (v - vmin) / (vmax - vmin) * (self.y1 - self.y0)

    def frame(self, xmin, xmax, ymin, ymax, yticks=5, xticks=6, yfmt="{:.2f}"):
        cv = self.cv
        for i in range(yticks + 1):
            v = ymin + (ymax - ymin) * i / yticks
            y = self.sy(v, ymin, ymax)
            cv.hline(self.x0, self.x1, y, self.GRID, 1)
            cv.text(4, int(y) - 6, yfmt.format(v), self.BLACK, 2)
        for i in range(xticks + 1):
            v = xmin + (xmax - xmin) * i / xticks
            x = self.sx(v, xmin, xmax)
            cv.vline(x, self.y0, self.y1, self.GRID, 1)
            cv.text(int(x) - 10, self.y1 + 8, str(int(round(v))), self.BLACK, 2)
        cv.vline(self.x0, self.y0, self.y1, self.BLACK, 2)
        cv.hline(self.x0, self.x1, self.y1, self.BLACK, 2)

    def title(self, s):
        self.cv.text((self.x0 + self.x1 - self.cv.text_w(s, 2)) // 2, 10, s, (0, 0, 0), 2)

    def legend(self, entries, x=None, y=None):
        cv = self.cv
        x = self.x1 - 220 if x is None else x
        y = self.y0 + 8 if y is None else y
        cv.rect(x - 6, y - 6, x + 214, y + 8 + 18 * len(entries), (252, 252, 252))
        for i, (s, c) in enumerate(entries):
            yy = y + 18 * i
            cv.rect(x, yy + 2, x + 18, yy + 10, c)
            cv.text(x + 24, yy, s, self.BLACK, 2)

