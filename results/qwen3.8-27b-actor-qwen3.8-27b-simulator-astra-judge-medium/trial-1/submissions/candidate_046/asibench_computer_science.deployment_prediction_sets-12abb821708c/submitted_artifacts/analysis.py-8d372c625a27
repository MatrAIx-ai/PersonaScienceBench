#!/usr/bin/env python3
"""
analysis.py - Deployment prediction sets under a label-weighted miss-risk target.

Method (approved plan):
  1. Fit a multinomial logistic model (pure numpy) on the 10 anonymous features,
     standardized with calibration statistics, on calibration labels.
  2. Recover k proxy strata by k-means on the pooled (cal+dep) standardized
     features (public information only).
  3. Rank labels per record with blend = w * classifier_score + (1-w) * P_feat.
  4. Policy: per-group top-K_g labels by blend score (sets always non-empty).
  5. Select (w, k, K_g) on an 80/20 calibration holdout (seed 0) with a
     conservative rule: density-weighted holdout risk + Hoeffding UCB (delta from
     risk_spec) <= target, and every group's holdout risk <= target; then
     reduce K_g while a safety slack remains (do not push to the limit).
  6. Deployment risk is estimated by density-ratio correction:
     est_risk(scope) = sum_g dep_frac_g * holdout_risk_g.
     (Deployment labels are intentionally hidden.)
     Density-ratio guard: dep_frac / max(cal_frac, EPS), EPS = 0.01.

All randomness is seeded; the script is deterministic and re-runnable.
"""
import json
import os

import numpy as np
import pandas as pd
from scipy.cluster.vq import kmeans2

DATA = "data"
OUT = "results"
os.makedirs(OUT, exist_ok=True)

EPS_DENSITY = 0.01          # guard for density-ratio estimate (documented)
SLACK = 0.01                # safety slack kept when reducing K_g
W_CANDIDATES = (0.3, 0.5, 0.7)
K_CANDIDATES = (2, 3, 4)
SEED = 0

# ---------------------------------------------------------------- load inputs
lab = pd.read_csv(f"{DATA}/calibration_labels.csv")
cs = pd.read_csv(f"{DATA}/calibration_scores.csv")
cf = pd.read_csv(f"{DATA}/calibration_features.csv")
ds = pd.read_csv(f"{DATA}/deployment_scores.csv")
df = pd.read_csv(f"{DATA}/deployment_features.csv")
with open(f"{DATA}/risk_spec.json") as fh:
    spec = json.load(fh)
with open(f"{DATA}/metadata.json") as fh:
    meta = json.load(fh)

VALID = sorted(spec["label_costs"].keys())
COST = np.array([spec["label_costs"][l] for l in VALID])
MAX_COST = COST.max()
TARGET = float(spec["target_risk"])
DELTA = float(spec["delta"])
FEATS = list(meta["feature_columns"])

assert list(lab.record_id) == list(cs.record_id) == list(cf.record_id)
assert list(ds.record_id) == list(df.record_id)
assert set(lab.true_label) <= set(VALID)

Sc = cs[VALID].to_numpy(float)          # (n_cal, 9) classifier probabilities
Sd = ds[VALID].to_numpy(float)          # (n_dep, 9)
Xc = cf[FEATS].to_numpy(float)
Xd = df[FEATS].to_numpy(float)
y_lbl = lab.true_label.to_numpy()
li = {l: i for i, l in enumerate(VALID)}
y = np.array([li[l] for l in y_lbl])
n_cal, n_dep = len(lab), len(ds)
tidx = np.array([li[l] for l in y_lbl])

# ---------------------------------------------------------------- feature model
mu, sd = Xc.mean(0), Xc.std(0, ddof=0)
Xcn, Xdn = (Xc - mu) / sd, (Xd - mu) / sd


def softmax(z):
    z = z - z.max(1, keepdims=True)
    e = np.exp(z)
    return e / e.sum(1, keepdims=True)


def fit_logistic(X, yy, iters=500, lr=0.5, lam=1e-4):
    """Multinomial logistic regression, full-batch gradient descent (deterministic)."""
    ntr = len(X)
    W = np.zeros((X.shape[1], 9))
    b = np.zeros(9)
    for _ in range(iters):
        P = softmax(X @ W + b)
        G = np.zeros((ntr, 9))
        G[np.arange(ntr), yy] = 1.0
        W -= lr * (X.T @ (P - G) / ntr + lam * W)
        b -= lr * (P - G).mean(0)
    return W, b


# 80/20 calibration split (seeded) for honest risk estimation
rng = np.random.RandomState(SEED)
tr = rng.choice(n_cal, int(n_cal * 0.8), replace=False)
te = np.ones(n_cal, bool)
te[tr] = False
n_te = int(te.sum())

Wtr, btr = fit_logistic(Xcn[tr], y[tr])
Pte = softmax(Xcn[te] @ Wtr + btr)          # feature probs on heldout
# final model: refit on all calibration data for the deployment sets
Wf, bf = fit_logistic(Xcn, y)
Pdep = softmax(Xdn @ Wf + bf)
Pcal_full = softmax(Xcn @ Wf + bf)


# ---------------------------------------------------------------- evaluation
def evaluate(w, k):
    """Select K_g for a (blend weight, number of groups) config; return summary."""
    Z = np.vstack([Xcn, Xdn])
    _, glab = kmeans2(Z, k, minit="++", seed=SEED)
    gcal, gdep = glab[:n_cal], glab[n_cal:]
    gcal_te = gcal[te]
    dep_frac = np.array([(gdep == g).mean() for g in range(k)])
    cal_frac = np.array([(gcal == g).mean() for g in range(k)])
    n_te_g = np.array([int((gcal_te == g).sum()) for g in range(k)])

    blend_te = w * Sc[te] + (1 - w) * Pte
    risk_by_k = {}
    for g in range(k):
        idx = np.where(gcal_te == g)[0]
        M = blend_te[idx]
        cost = COST[tidx[te][idx]]
        tix = tidx[te][idx]
        arr = np.empty(10)
        for K in range(1, 10):
            topk = M.argsort(1)[:, ::-1][:, :K]
            cov = np.any(topk == tix[:, None], axis=1)
            arr[K] = (cost * (~cov)).mean()
        risk_by_k[g] = arr

    ucb_overall = MAX_COST * np.sqrt(np.log(1.0 / DELTA) / (2.0 * n_te))
    ucb_g = [MAX_COST * np.sqrt(np.log(1.0 / (DELTA / k)) / (2.0 * max(n_te_g[g], 1)))
             for g in range(k)]

    def overall(K_g):
        return sum(dep_frac[g] * risk_by_k[g][K_g[g]] for g in range(k))

    K_g = np.ones(k, int)
    # grow the tightest group until constraints hold
    for _ in range(100):
        risks = np.array([risk_by_k[g][K_g[g]] for g in range(k)])
        okA = overall(K_g) + ucb_overall <= TARGET
        okB = bool((risks <= TARGET).all())
        if okA and okB:
            break
        tight = risks + np.array(ucb_g) - TARGET
        gstar = int(np.argmax(tight))
        if K_g[gstar] < 9:
            K_g[gstar] += 1
        else:
            break
    # shrink while a safety slack remains (do not push to the limit)
    for _ in range(100):
        risks = np.array([risk_by_k[g][K_g[g]] for g in range(k)])
        if overall(K_g) + ucb_overall <= TARGET - SLACK and bool((risks <= TARGET - 2 * SLACK).all()):
            margins = risks + np.array(ucb_g) - TARGET
            loose = np.where(K_g > 1)[0]
            if len(loose) == 0:
                break
            gstar = int(loose[np.argmin(margins[loose])])
            K_g[gstar] -= 1
        else:
            break

    risks = np.array([risk_by_k[g][K_g[g]] for g in range(k)])
    return {
        "w": w, "k": k, "K_g": K_g, "dep_frac": dep_frac, "cal_frac": cal_frac,
        "n_te_g": n_te_g, "risk_by_k": risk_by_k, "risks": risks,
        "overall": overall(K_g), "ucb_overall": ucb_overall, "ucb_g": ucb_g,
        "gcal": gcal, "gdep": gdep,
        "mean_size": float((dep_frac * K_g).sum()),
    }


# ---------------------------------------------------------------- select config
configs = [evaluate(w, k) for w in W_CANDIDATES for k in K_CANDIDATES]
feasible = [c for c in configs
            if c["overall"] + c["ucb_overall"] <= TARGET and (c["risks"] <= TARGET).all()]
assert feasible, "no feasible (w, k) configuration found"
best = min(feasible, key=lambda c: (c["mean_size"], -(TARGET - c["overall"] - c["ucb_overall"])))

w_star, k_star = best["w"], best["k"]
K_g = best["K_g"].astype(int).copy()
gcal, gdep = best["gcal"], best["gdep"]
dep_frac, cal_frac = best["dep_frac"], best["cal_frac"]
ucb_overall, ucb_g = best["ucb_overall"], best["ucb_g"]


def _risks_of(K_g):
    return np.array([best["risk_by_k"][g][K_g[g]] for g in range(k_star)])


def _overall_of(K_g):
    return float(sum(dep_frac[g] * best["risk_by_k"][g][K_g[g]] for g in range(k_star)))


# safety: if the slack-based shrink overshot, restore feasibility
while not (_overall_of(K_g) + ucb_overall <= TARGET and bool((_risks_of(K_g) <= TARGET).all())):
    tight = _risks_of(K_g) + np.array(ucb_g) - TARGET
    gstar = int(np.argmax(tight))
    if K_g[gstar] < 9:
        K_g[gstar] += 1
    else:
        raise RuntimeError("configuration infeasible")

risks = _risks_of(K_g)
overall_risk = _overall_of(K_g)
mean_size = float((dep_frac * K_g).sum())
print(f"selected: w={w_star}, k={k_star}, K_g={K_g.tolist()}, "
      f"overall est risk={overall_risk:.4f} (+UCB {ucb_overall:.4f}), mean size={mean_size:.3f}")
for g in range(k_star):
    print(f"  group g{g}: cal_frac={cal_frac[g]:.3f} dep_frac={dep_frac[g]:.3f} "
          f"K={K_g[g]} holdout_risk={risks[g]:.4f} ucb={ucb_g[g]:.4f} n_te={best['n_te_g'][g]}")

# ---------------------------------------------------------------- deployment sets
blend_dep = w_star * Sd + (1 - w_star) * Pdep
sets = []
for i in range(n_dep):
    g = int(gdep[i])
    order = np.lexsort((np.arange(9), -blend_dep[i]))  # desc blend, tie by label idx
    sets.append([VALID[j] for j in order[: K_g[g]]])

pred = pd.DataFrame({
    "record_id": ds.record_id,
    "prediction_set": [" ".join(s) for s in sets],
})
pred.to_csv(f"{OUT}/prediction_sets.csv", index=False)

sizes = np.array([len(s) for s in sets])
assert (sizes == K_g[gdep]).all() and sizes.min() >= 1

set_size = pd.DataFrame({
    "record_id": ds.record_id,
    "set_size": sizes,
    "proxy_stratum": [f"g{g}" for g in gdep],
})
set_size.to_csv(f"{OUT}/set_size_summary.csv", index=False)

# ---------------------------------------------------------------- policy parameters
blend_cal_full = w_star * Sc + (1 - w_star) * Pcal_full
rows = []
for g in range(k_star):
    idx = np.where(gcal == g)[0]
    n_g = len(idx)
    cal_target_g = max(0.0, TARGET - ucb_g[g])
    order = np.argsort(-blend_cal_full[idx], axis=1, kind="stable")
    for l in VALID:
        j = li[l]
        in_set = np.isin(order[:, : K_g[g]], j)
        p_incl = float(in_set.mean())
        thr = float(np.quantile(blend_cal_full[idx, j], np.clip(1.0 - p_incl, 0.001, 0.999)))
        thr = float(np.clip(thr, 0.0, 1.0))
        rows.append({
            "proxy_stratum": f"g{g}",
            "label": l,
            "n_calibration": n_g,
            "n_calibration_label": int((y_lbl[idx] == l).sum()),
            "threshold": round(thr, 6),
            "group_empirical_weighted_miss_risk": round(float(risks[g]), 6),
            "group_upper_confidence_risk": round(float(min(1.0, risks[g] + ucb_g[g])), 6),
            "group_expected_set_size": int(K_g[g]),
            "calibration_target_risk": round(float(cal_target_g), 6),
            "target_risk": TARGET,
        })
pd.DataFrame(rows).to_csv(f"{OUT}/policy_parameters.csv", index=False)

# ---------------------------------------------------------------- audit summaries
p90_overall = float(np.percentile(sizes, 90))
audit_rows = [{
    "scope": "overall", "stratum_id": "all", "n_records": n_dep,
    "empirical_risk": round(float(overall_risk), 6),
    "mean_set_size": round(float(sizes.mean()), 4),
    "p90_set_size": p90_overall,
    "target_risk": TARGET,
    "risk_violation": bool(overall_risk > TARGET),
}]
part_rows, constr_rows = [], []
for g in range(k_star):
    n_g_dep = int((gdep == g).sum())
    r_g = float(risks[g])
    sz_g = float(K_g[g])
    audit_rows.append({
        "scope": "recovered_group", "stratum_id": f"g{g}", "n_records": n_g_dep,
        "empirical_risk": round(r_g, 6),
        "mean_set_size": sz_g, "p90_set_size": sz_g,
        "target_risk": TARGET,
        "risk_violation": bool(r_g > TARGET),
    })
    part_rows.append({
        "scope": "recovered_group", "stratum_id": f"g{g}", "n_records": n_g_dep,
        "empirical_risk": round(r_g, 6),
        "mean_set_size": sz_g, "p90_set_size": sz_g,
        "target_risk": TARGET,
        "risk_margin": round(TARGET - r_g, 6),
    })
    constr_rows.append({
        "scope": "recovered_group", "stratum_id": f"g{g}",
        "empirical_risk": round(r_g, 6), "target_risk": TARGET,
        "risk_violation": bool(r_g > TARGET),
        "violates": bool(r_g > TARGET),
    })
constr_rows.append({
    "scope": "overall", "stratum_id": "all",
    "empirical_risk": round(float(overall_risk), 6), "target_risk": TARGET,
    "risk_violation": bool(overall_risk > TARGET),
    "violates": bool(overall_risk > TARGET),
})
pd.DataFrame(audit_rows).to_csv(f"{OUT}/audit_summary.csv", index=False)
pd.DataFrame(part_rows).to_csv(f"{OUT}/partition_diagnostics.csv", index=False)
pd.DataFrame(constr_rows).to_csv(f"{OUT}/constraint_audit.csv", index=False)

dist_rows = []
for g in range(k_star):
    dist_rows.append({
        "proxy_stratum": f"g{g}",
        "calibration_fraction": round(float(cal_frac[g]), 6),
        "deployment_fraction": round(float(dep_frac[g]), 6),
        "density_ratio_estimate": round(float(dep_frac[g] / max(cal_frac[g], EPS_DENSITY)), 6),
        "absolute_fraction_shift": round(float(abs(dep_frac[g] - cal_frac[g])), 6),
    })
pd.DataFrame(dist_rows).to_csv(f"{OUT}/distribution_diagnostics.csv", index=False)

# ---------------------------------------------------------------- calibration diagnostics
true_score = Sc[np.arange(n_cal), tidx]
cal_bin_rows = []
for g in range(k_star):
    ts_g = true_score[gcal == g]
    for b in range(10):
        lo, hi = b / 10.0, (b + 1) / 10.0
        if b == 9:
            msk = (ts_g >= lo) & (ts_g <= hi)
        else:
            msk = (ts_g >= lo) & (ts_g < hi)
        cal_bin_rows.append({
            "proxy_stratum": f"g{g}", "bin_id": b,
            "score_left": lo, "score_right": hi,
            "n_records": int(msk.sum()),
            "mean_true_label_score": round(float(ts_g[msk].mean()), 6) if msk.any() else np.nan,
        })
pd.DataFrame(cal_bin_rows).to_csv(f"{OUT}/calibration_diagnostics.csv", index=False)


