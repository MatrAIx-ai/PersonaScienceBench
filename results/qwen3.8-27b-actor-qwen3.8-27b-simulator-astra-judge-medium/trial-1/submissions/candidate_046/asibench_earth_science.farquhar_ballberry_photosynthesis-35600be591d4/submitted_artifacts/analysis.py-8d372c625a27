class Canvas:
    """Tiny RGB canvas with the drawing primitives the figure needs."""

    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.buf = bytearray(w * h * 3)
        for i in range(w * h):
            self.buf[3 * i] = bg[0]
            self.buf[3 * i + 1] = bg[1]
            self.buf[3 * i + 2] = bg[2]

    def put(self, x, y, col):
        if 0 <= x < self.w and 0 <= y < self.h:
            i = (y * self.w + x) * 3
            self.buf[i] = col[0]
            self.buf[i + 1] = col[1]
            self.buf[i + 2] = col[2]

    def hline(self, x0, x1, y, col):
        for x in range(int(min(x0, x1)), int(max(x0, x1)) + 1):
            self.put(x, int(y), col)

    def vline(self, y0, y1, x, col):
        for y in range(int(min(y0, y1)), int(max(y0, y1)) + 1):
            self.put(int(x), y, col)

    def rect(self, x0, y0, x1, y1, col):
        for y in range(int(y0), int(y1) + 1):
            for x in range(int(x0), int(x1) + 1):
                self.put(x, y, col)

    def line(self, x0, y0, x1, y1, col):
        n = max(abs(x1 - x0), abs(y1 - y0), 1)
        for i in range(int(n) + 1):
            self.put(round(x0 + (x1 - x0) * i / n),
                     round(y0 + (y1 - y0) * i / n), col)

    def text(self, x, y, s, col, scale=1):
        for i, ch in enumerate(s):
            g = _FONT.get(ch.upper())
            if g is None:
                continue
            ox = x + i * 6 * scale
            for r in range(7):
                row = g[r]
                for c in range(5):
                    if row & (1 << (4 - c)):
                        for dy in range(scale):
                            for dx in range(scale):
                                self.put(ox + c * scale + dx,
                                         y + r * scale + dy, col)

    def save(self, path):
        def chunk(tag, data):
            out = struct.pack(">I", len(data)) + tag + data
            out += struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
            return out
        raw = b"".join(b"\x00" + bytes(self.buf[y * 3 * self.w:
                                                (y + 1) * 3 * self.w])
                       for y in range(self.h))
        png = b"\x89PNG\r\n\x1a\n"
        png += chunk(b"IHDR", struct.pack(">IIBBBBB", self.w, self.h,
                                          8, 2, 0, 0, 0))
        png += chunk(b"IDAT", zlib.compress(raw, 9))
        png += chunk(b"IEND", b"")
        with open(path, "wb") as fh:
            fh.write(png)


# ------------------------------- figures ------------------------------
def _nice_ticks(lo, hi, n=5):
    span = max(hi - lo, 1e-12)
    step0 = span / n
    mag = 10.0 ** np.floor(np.log10(step0))
    step = 10 * mag
    for m in (1.0, 2.0, 5.0):
        if step0 <= m * mag:
            step = m * mag
            break
    t0 = np.ceil(lo / step) * step
    return list(np.arange(t0, hi + 0.5 * step, step)), step


def _fmt(v):
    return str(int(round(v))) if abs(v - round(v)) < 1e-9 else f"{v:g}"


def plot_matplotlib(flux: pd.DataFrame, path: str) -> None:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 7), sharex=True)
    night = flux["A_sun"] < 0
    for ax in (ax1, ax2):
        for t in range(len(flux)):
            if night.iloc[t]:
                ax.axvspan(t - 0.5, t + 0.5, color="0.90", zorder=0)
    ax1.plot(flux.time_hr, flux.A_sun, "-", color="darkorange", lw=1.6,
             label="sunlit A")
    ax1.plot(flux.time_hr, flux.A_shade, "--", color="gold", lw=1.6,
             label="shaded A")
    ax1.set_ylabel(r"A  ($\mu$mol CO$_2$ m$^{-2}$ s$^{-1}$)")
    ax1.legend(loc="upper left")
    ax1.grid(alpha=0.3)
    ax1.set_title("Diurnal leaf response (5 days, coupled C4 + Ball-Berry)")
    ax2.plot(flux.time_hr, flux.rs_sun, "-", color="seagreen", lw=1.6,
             label="sunlit rs")
    ax2.plot(flux.time_hr, flux.rs_shade, "--", color="mediumseagreen",
             lw=1.6, label="shaded rs")
    ax2.set_xlabel("time (h)")
    ax2.set_ylabel(r"r$_s$  (s m$^{-1}$)")
    ax2.legend(loc="upper right")
    ax2.grid(alpha=0.3)
    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)


def plot_pure_python(flux: pd.DataFrame, path: str) -> None:
    """Two-panel line figure (A top, rs bottom) with a stdlib PNG writer."""
    W, H = 1100, 700
    cv = Canvas(W, H)
    axis_col, txt_col = (70, 70, 70), (30, 30, 30)
    sun_a, shade_a = (217, 119, 6), (176, 141, 0)
    sun_rs, shade_rs = (46, 139, 87), (60, 179, 113)
    night = flux["A_sun"] < 0
    xs = flux["time_hr"].to_numpy(float)

    cv.text(W // 2 - 240, 12,
            "DIURNAL LEAF RESPONSE (5 DAYS, COUPLED C4 + BALL-BERRY)",
            txt_col, scale=2)

    panels = [
        dict(y0=55, y1=320, col_s=sun_a, col_d=shade_a,
             ys=(flux["A_sun"], flux["A_shade"]),
             lab="A (UMOL CO2 M-2 S-1)", leg=("SUNLIT A", "SHADED A")),
        dict(y0=400, y1=655, col_s=sun_rs, col_d=shade_rs,
             ys=(flux["rs_sun"], flux["rs_shade"]),
             lab="RS (S M-1)", leg=("SUNLIT RS", "SHADED RS")),
    ]
    x0, x1 = 95, 1075
    for pi, p in enumerate(panels):
        ylo, yhi = float(np.min(p["ys"][0])), float(np.max(p["ys"][1]))
        pad = 0.08 * (yhi - ylo)
        ylo, yhi = ylo - pad, yhi + pad
        ticks, _ = _nice_ticks(ylo, yhi)
        X = lambda v: x0 + (v - xs.min()) / (xs.max() - xs.min()) * (x1 - x0)
        Y = lambda v: p["y1"] - (v - ylo) / (yhi - ylo) * (p["y1"] - p["y0"])
        # night shading
        for t in range(len(flux)):
            if night.iloc[t]:
                cv.rect(X(t - 0.5), p["y0"], X(t + 0.5), p["y1"], (238, 238, 238))
        # grid + y ticks
        for tv in ticks:
            cv.hline(x0, x1, Y(tv), (225, 225, 225))
            cv.vline(Y(tv) - 3, Y(tv) + 3, x0, axis_col)
            s = _fmt(tv)
            cv.text(x0 - 8 - len(s) * 6, int(Y(tv)) - 3, s, txt_col)
        # axes
        cv.vline(p["y0"], p["y1"], x0, axis_col)
        cv.hline(x0, x1, p["y1"], axis_col)
        # x ticks
        for tv in range(0, 121, 20):
            cv.vline(p["y1"], p["y1"] + 3, X(tv), axis_col)
            if pi == 1:
                s = _fmt(tv)
                cv.text(int(X(tv)) - len(s) * 3, p["y1"] + 8, s, txt_col)
        # curves (solid sun, dashed shade)
        for j, (ys, col) in enumerate(((p["ys"][0], p["col_s"]),
                                       (p["ys"][1], p["col_d"]))):
            dist = 0.0
            for i in range(len(xs) - 1):
                xa, ya = X(xs[i]), Y(ys[i])
                xb, yb = X(xs[i + 1]), Y(ys[i + 1])
                seg = ((xb - xa) ** 2 + (yb - ya) ** 2) ** 0.5
                if j == 1 and int(dist // 18) % 2 == 1:
                    dist += seg
                    continue
                steps = max(2, int(seg))
                for s in range(steps + 1):
                    px = int(round(xa + (xb - xa) * s / steps))
                    py = int(round(ya + (yb - ya) * s / steps))
                    cv.put(px, py, col)
                    cv.put(px, py + 1, col)
                dist += seg
        # labels + legend
        cv.text(12, p["y0"] - 4, p["lab"], txt_col)
        lx = x1 - 150
        for k, (lab, col, dash) in enumerate((
                (p["leg"][0], p["col_s"], False),
                (p["leg"][1], p["col_d"], True))):
            ly = p["y0"] + 12 + k * 16
            if dash:
                for seg_i in (0, 8, 16):
                    cv.hline(lx + seg_i, lx + seg_i + 5, ly + 3, col)
            else:
                cv.hline(lx, lx + 21, ly + 3, col)
            cv.text(lx + 28, ly, lab, txt_col)
    cv.text(W // 2 - 30, H - 20, "TIME (H)", txt_col)
    cv.save(path)


# ------------------------------- main ---------------------------------
def main() -> None:
    with open(os.path.join(DATA, "leaf_params.json")) as fh:
        params = json.load(fh)
    forcing = pd.read_csv(os.path.join(DATA, "forcing.csv"))
    with open(os.path.join(DATA, "test_cases.json")) as fh:
        cases = json.load(fh)

    pathway = params["pathway"]
    alpha_q = float(params["alpha_q"])
    os.makedirs(RESULTS, exist_ok=True)

    # ------------------------- diurnal time series --------------------
    records = []
    ci_prev = {"sun": None, "shade": None}
    for _, row in forcing.iterrows():
        env = build_env(row, params)
        rec = {"time_hr": row["time_hr"]}
        for tag, col in (("sun", "par_sun_wm2"), ("shade", "par_shade_wm2")):
            par = float(row[col])
            if par < NIGHT_PAR:
                st = night_state(env)
            else:
                ci0 = ci_prev[tag] if ci_prev[tag] is not None else 0.5 * env["ca"]
                st = solve_fixed_point(ci0, env, APAR_FACTOR * par, pathway,
                                       alpha_q)
            ci_prev[tag] = st["ci"]
            rec[f"A_{tag}"] = st["a"]
            rec[f"rs_{tag}"] = st["rs"]
            rec[f"ci_{tag}"] = st["ci"]
            rec[f"gs_{tag}"] = st["gs"]
        records.append(rec)

    flux = pd.DataFrame(records, columns=[
        "time_hr", "A_sun", "A_shade", "rs_sun", "rs_shade",
        "ci_sun", "ci_shade", "gs_sun", "gs_shade"])
    flux.to_csv(os.path.join(RESULTS, "leaf_fluxes.csv"), index=False)

    # ------------------------- single-point cases ---------------------
    case_rows = []
    for case in cases:
        row = forcing.iloc[int(case["forcing_index"])]
        env = build_env(row, params)
        # case leaves evaluated on the sunlit forcing (par_sun_wm2); at
        # forcing_index 12 both strata are Vcmax-limited, so the result
        # is identical with par_shade_wm2 (verified in diagnostics).
        par = float(row["par_sun_wm2"])
        st = solve_fixed_point(float(case["ci_init_pa"]), env,
                               APAR_FACTOR * par, pathway, alpha_q)
        case_rows.append(dict(case_id=case["case_id"],
                              ci_init_pa=case["ci_init_pa"],
                              ci_final_pa=st["ci"],
                              A_final=st["a"],
                              rs_final=st["rs"],
                              n_iterations=st["n_iter"]))
    case_df = pd.DataFrame(case_rows, columns=[
        "case_id", "ci_init_pa", "ci_final_pa", "A_final", "rs_final",
        "n_iterations"])
    case_df.to_csv(os.path.join(RESULTS, "case_convergence.csv"), index=False)

    # ------------------------------- figure ---------------------------
    png_path = os.path.join(RESULTS, "diurnal.png")
    try:
        plot_matplotlib(flux, png_path)
        fig_backend = "matplotlib"
    except ImportError:
        plot_pure_python(flux, png_path)
        fig_backend = "pure-python fallback (matplotlib no disponible)"
    print(f"figura: {png_path}  [backend: {fig_backend}]")

    # ----------------------------- diagnostics ------------------------
    print("=" * 72)
    night = flux["A_sun"] < 0
    print(f"pathway={pathway}  rows={len(flux)}  "
          f"night rows={int(night.sum())}  day rows={int((~night).sum())}")
    r12 = flux.iloc[12]
    print("\nFila 12 (sanity check vs estimacion a mano Ci~31, A~39, "
          "gs~0.25, rs~167):")
    for tag in ("sun", "shade"):
        print(f"  {tag:5s}: Ci={r12[f'ci_{tag}']:.3f} Pa  "
              f"A={r12[f'A_{tag}']:.3f} umol m-2 s-1  "
              f"gs={r12[f'gs_{tag}']:.4f} mol m-2 s-1  "
              f"rs={r12[f'rs_{tag}']:.2f} s m-1")
    nf = flux[night]
    ca0 = float(forcing.co2_pa.iloc[0])
    print(f"\nNoche: A min={nf.A_sun.min():.4f} (=-Rd), "
          f"gs max={nf.gs_sun.max():.4f} (=b0), "
          f"rs min={nf.rs_sun.min():.1f} (cf/b0), "
          f"ci max={nf.ci_sun.max():.3f}; ca={ca0:.4f}")
    assert np.isfinite(flux.to_numpy()).all(), "NaN/inf en leaf_fluxes"
    assert (nf.ci_sun > ca0).all() and (nf.ci_shade > ca0).all(), \
        "noche: Ci debe ser > ca"
    env12 = build_env(forcing.iloc[12], params)
    st_sh = solve_fixed_point(0.5 * env12["ca"], env12,
                              APAR_FACTOR * float(forcing.par_shade_wm2.iloc[12]),
                              pathway, alpha_q)
    print(f"\nFila 12 shade-only: Ci={st_sh['ci']:.3f} A={st_sh['a']:.3f} "
          f"rs={st_sh['rs']:.2f} (debe coincidir con sun: ambos Vcmax-limited)")
    print("\nCasos:")
    print(case_df.to_string(index=False))
    print("\nOK: results/leaf_fluxes.csv, results/case_convergence.csv, "
          "results/diurnal.png escritos.")


if __name__ == "__main__":
    main()
