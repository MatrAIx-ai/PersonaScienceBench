#!/usr/bin/env python3
"""Leaf physiological response reconstruction (B3 task).

Coupled Farquhar (C3) / Collatz (C4) photosynthesis with Ball-Berry
stomatal conductance, in the land-surface (CLM/Noah-MP) convention
specified by the task brief:

* limitations combined by a hard minimum;
* C3: Wc = Vcmax*(Ci-G*)/(Ci+Kc*(1+O2/Ko)),
      Wj = J*(Ci-G*)/(4*Ci+8*G*), We = 0.5*Vcmax, J = alpha_q*APAR;
* C4: Wc = Vcmax, Wj = alpha_q*APAR, We = 4000*Vcmax*Ci/p_atm;
* A = min(Wc, Wj, We) - Rd, with APAR = 4.6*PAR (no extra absorptance
  factor) and Rd = 0.015*Vcmax;
* CLM/Noah-MP Q10 Vcmax with high-temperature inhibition:
  Vcmax(T) = Vcmax25*2.4^((Tc-25)/10) /
             (1 + exp((-2.2e5 + 710*(Tc+273.16)) / (R*(Tc+273.16))));
* n_factor and btran scale photosynthetic capacity only (the Ball-Berry
  intercept b0 is NOT scaled by btran);
* leaf temperature = air temperature;
  h_s = max(1 - vpd/esat(T), 0.25), bounded above by 1;
* gas-diffusion chain with cf = p_atm/(R*T):
    cs = ca - 1.37*rb*A_mol/cf*p_atm
    gs = m*A_mol*h_s/cs*p_atm + b0
    rs = cf/gs
    Ci = cs - 1.65*rs*A_mol/cf*p_atm
* at night (PAR ~ 0): respiratory assimilation A = -Rd and intercept
  conductance gs = b0, which keeps every quantity finite at PAR = 0.

Under light, (Ci, A, gs, rs, cs) must describe one common coupled fixed
point.  Given Ci everything else is explicit, so the system reduces to the
scalar fixed point Ci = G(Ci), solved by point iteration with a bisection
fallback on F(Ci) = Ci - G(Ci).

Outputs: analysis.py (this file), results/leaf_fluxes.csv,
results/case_convergence.csv, results/diurnal.png.
The figure uses matplotlib when available; otherwise a small built-in
pure-Python PNG renderer produces the same two-panel figure.
"""
from __future__ import annotations

import json
import os
import struct
import zlib

import numpy as np
import pandas as pd

# ------------------------------- constants ----------------------------
R_GAS = 8.314            # J mol-1 K-1
APAR_FACTOR = 4.6        # APAR = 4.6 * PAR (W m-2); no extra absorptance
NIGHT_PAR = 1e-6         # W m-2; PAR below this -> night branch
GS_FLOOR = 1e-6          # mol m-2 s-1; keeps rs finite on pathological iters
CS_FLOOR = 1.0           # Pa; keeps gs finite (never active in this dataset)
TOL_CI = 1e-6            # Pa
TOL_A = 1e-8             # umol m-2 s-1
MAX_ITER = 200

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "data")
RESULTS = os.path.join(HERE, "results")


# ------------------------------- physics ------------------------------
def esat(t_k: float) -> float:
    """Saturation vapour pressure (Pa), CLM formulation (T in deg C)."""
    tc = t_k - 273.15
    return 611.21 * np.exp(17.502 * tc / (240.97 + tc))


def vcmax_temperature(vcmax25: float, t_k: float) -> float:
    """CLM/Noah-MP Q10 response incl. high-temperature inhibition."""
    tc = t_k - 273.15
    base = vcmax25 * 2.4 ** ((tc - 25.0) / 10.0)
    inhib = 1.0 + np.exp((-2.2e5 + 710.0 * (tc + 273.16))
                         / (R_GAS * (tc + 273.16)))
    return base / inhib


def build_env(row: pd.Series, params: dict) -> dict:
    """Row-wise environment + capacity for the coupled model."""
    t_k = float(row["t_air_K"])
    p_atm = float(row["p_atm_Pa"])
    ca = float(row["co2_pa"])
    o2 = float(row["o2_pa"])
    vpd = float(row["vpd_Pa"])
    rb = float(row["rb_sm"])
    btran = float(row["btran"])
    cf = p_atm / (R_GAS * t_k)                       # mol m-3
    h_s = min(max(1.0 - vpd / esat(t_k), 0.25), 1.0)  # surface RH
    # n_factor and btran act on photosynthetic capacity only
    vcmax = vcmax_temperature(params["vcmax25"], t_k) * params["n_factor"] * btran
    return dict(t_k=t_k, p_atm=p_atm, ca=ca, o2=o2, rb=rb, cf=cf, h_s=h_s,
                vcmax=vcmax, rd=0.015 * vcmax,
                m=float(params["bb_slope"]), b0=float(params["bb_intercept"]))


def net_assim(ci: float, env: dict, apar: float, pathway: str,
              alpha_q: float) -> float:
    """Net assimilation A = min(Wc, Wj, We) - Rd (umol m-2 s-1)."""
    vcmax, rd = env["vcmax"], env["rd"]
    if pathway == "C4":
        wc = vcmax
        wj = alpha_q * apar
        we = 4000.0 * vcmax * ci / env["p_atm"]
        w = min(wc, wj, we)
    else:  # C3 Farquhar branch (dormant for this dataset: pathway == "C4")
        tc = env["t_k"] - 273.15
        kc = 30.0 * 2.1 ** ((tc - 25.0) / 10.0)
        ko = 30000.0 * 1.2 ** ((tc - 25.0) / 10.0)
        o2 = env["o2"]
        gstar = 0.5 * (kc / ko) * o2 * 0.21
        j = alpha_q * apar
        wc = vcmax * (ci - gstar) / (ci + kc * (1.0 + o2 / ko))
        wj = j * (ci - gstar) / (4.0 * ci + 8.0 * gstar)
        we = 0.5 * vcmax
        w = min(wc, wj, we)
    return w - rd


def sweep(ci: float, env: dict, apar: float, pathway: str,
          alpha_q: float) -> tuple:
    """One fixed-point sweep: Ci -> A -> cs -> gs -> rs -> Ci_new."""
    a = net_assim(ci, env, apar, pathway, alpha_q)
    a_mol = a * 1e-6                                  # mol m-2 s-1
    d = a_mol / env["cf"] * env["p_atm"]              # = A_mol * R * T
    cs = max(env["ca"] - 1.37 * env["rb"] * d, CS_FLOOR)
    gs = max(env["m"] * a_mol * env["h_s"] / cs * env["p_atm"] + env["b0"],
             GS_FLOOR)
    rs = env["cf"] / gs
    ci_new = cs - 1.65 * rs * d
    return ci_new, a, cs, gs, rs


def solve_fixed_point(ci0: float, env: dict, apar: float, pathway: str,
                      alpha_q: float) -> dict:
    """Solve Ci = G(Ci) under light.

    Point iteration (omega = 1) with a bisection fallback on
    F(Ci) = Ci - G(Ci) over [1e-3, ca]; F is continuous there and
    F(1e-3) < 0 < F(ca) for all daytime rows of this dataset.
    """
    ci = float(ci0)
    a = net_assim(ci, env, apar, pathway, alpha_q)
    n_iter = 0
    for k in range(1, MAX_ITER + 1):
        ci_new, a_new, cs, gs, rs = sweep(ci, env, apar, pathway, alpha_q)
        n_iter = k
        if not (np.isfinite(ci_new) and np.isfinite(a_new)):
            break
        if abs(ci_new - ci) < TOL_CI and abs(a_new - a) < TOL_A:
            return dict(ci=ci_new, a=a_new, cs=cs, gs=gs, rs=rs,
                        n_iter=n_iter, method="fixed_point")
        ci, a = ci_new, a_new

    # ---------------- bisection fallback on F(Ci) = Ci - G(Ci) --------
    def f(c: float) -> float:
        return c - sweep(c, env, apar, pathway, alpha_q)[0]

    lo, hi = 1e-3, env["ca"]
    f_lo, f_hi = f(lo), f(hi)
    if f_lo * f_hi > 0.0:      # no sign change: keep last iterate
        ci_new, a, cs, gs, rs = sweep(ci, env, apar, pathway, alpha_q)
        return dict(ci=ci_new, a=a, cs=cs, gs=gs, rs=rs,
                    n_iter=n_iter, method="fixed_point(no bracket)")
    for _ in range(200):
        mid = 0.5 * (lo + hi)
        f_mid = f(mid)
        n_iter += 1
        if abs(f_mid) < TOL_CI or (hi - lo) < TOL_CI:
            lo = hi = mid
            break
        if f_lo * f_mid <= 0.0:
            hi, f_hi = mid, f_mid
        else:
            lo, f_lo = mid, f_mid
    ci = 0.5 * (lo + hi)
    _, a, cs, gs, rs = sweep(ci, env, apar, pathway, alpha_q)
    return dict(ci=ci, a=a, cs=cs, gs=gs, rs=rs, n_iter=n_iter,
                method="bisection")


def night_state(env: dict) -> dict:
    """Night branch: respiratory assimilation + intercept conductance.

    A = -Rd, gs = b0 (finite at PAR = 0); cs and Ci follow from the same
    diffusion chain (with A < 0 they land slightly above ca).
    """
    a = -env["rd"]
    a_mol = a * 1e-6
    d = a_mol / env["cf"] * env["p_atm"]
    cs = env["ca"] - 1.37 * env["rb"] * d
    gs = env["b0"]
    rs = env["cf"] / gs
    ci = cs - 1.65 * rs * d
    return dict(ci=ci, a=a, cs=cs, gs=gs, rs=rs, n_iter=0, method="night")


