class Canvas:
    def __init__(self,w,h,bg=(255,255,255)):
        self.rgb=np.full((h,w,3),bg,dtype=np.uint8)
    def px(self,x,y,c):
        x=int(round(x)); y=int(round(y))
        if 0<=x<self.rgb.shape[1] and 0<=y<self.rgb.shape[0]:
            self.rgb[y,x]=c
    def line(self,x0,y0,x1,y1,c):
        x0,y0,x1,y1=int(x0),int(y0),int(x1),int(y1)
        dx=abs(x1-x0); dy=abs(y1-y0); sx=1 if x0<x1 else -1
        sy=1 if y0<y1 else -1; err=dx-dy
        while True:
            self.px(x0,y0,c)
            if x0==x1 and y0==y1: break
            e2=2*err
            if e2>-dy: err-=dy; x0+=sx
            if e2<dx: err+=dx; y0+=sy
    def polyline(self,pts,c):
        for i in range(len(pts)-1):
            self.line(pts[i][0],pts[i][1],pts[i+1][0],pts[i+1][1],c)
    def text(self,x,y,s,c,scale=1):
        cx=x
        for ch in s:
            g=FONT.get(ch.upper(),FONT[' '])
            for r in range(7):
                for col in range(5):
                    if g[r][col]=='1': self.px(cx+col*scale,y+r*scale,c)
            cx+=6*scale

def write_png(path,rgb):
    h,w,_=rgb.shape
    raw=b''.join(b'\x00'+rgb[y].tobytes() for y in range(h))
    def chunk(t,d):
        return struct.pack('>I',len(d))+t+d+struct.pack('>I',zlib.crc32(t+d)&0xffffffff)
    png=b'\x89PNG\r\n\x1a\n'
    png+=chunk(b'IHDR',struct.pack('>IIBBBBB',w,h,8,2,0,0,0))
    png+=chunk(b'IDAT',zlib.compress(raw,9))
    png+=chunk(b'IEND',b'')
    open(path,'wb').write(png)

def _fmt(v):
    if abs(v)>=100: return str(int(round(v)))
    if abs(v)>=10: return str(int(round(v)))
    s=f"{v:.0f}"
    return s

def _panel(cv,box,title,ylab,xlab,series,xticks,yticks,ylim,xmin,xmax,names=None):
    x0,y0,x1,y1=box
    ax_x0=x0+8; ax_x1=x1; ax_y0=y0+22; ax_y1=y1-34
    cv.line(ax_x0,ax_y0,ax_x1,ax_y0,(150,150,150))
    cv.line(ax_x0,ax_y1,ax_x1,ax_y1,(150,150,150))
    cv.line(ax_x0,ax_y0,ax_x0,ax_y1,(0,0,0))
    cv.line(ax_x1,ax_y0,ax_x1,ax_y1,(0,0,0))
    cv.text(ax_x0+(ax_x1-ax_x0)//2-len(title)*6,y0,title,(0,0,0),scale=2)
    for color,data in series:
        pts=[]
        for xv,yv in data:
            px=ax_x0+(xv-xmin)/(xmax-xmin)*(ax_x1-ax_x0)
            py=ax_y1-(yv-ylim[0])/(ylim[1]-ylim[0])*(ax_y1-ax_y0)
            pts.append((px,py))
        if len(pts)>1: cv.polyline(pts,color)
    for xt in xticks:
        px=ax_x0+(xt-xmin)/(xmax-xmin)*(ax_x1-ax_x0)
        cv.line(px,ax_y1,px,ax_y1+5,(0,0,0))
        cv.text(px-3,ax_y1+8,_fmt(xt),(0,0,0))
    cv.text(ax_x0+(ax_x1-ax_x0)//2-len(xlab)*3,y1-16,xlab,(0,0,0),scale=1)
    for yt in yticks:
        py=ax_y1-(yt-ylim[0])/(ylim[1]-ylim[0])*(ax_y1-ax_y0)
        cv.line(ax_x0-5,py,ax_x0,py,(0,0,0))
        cv.text(ax_x0-42,py-4,_fmt(yt),(0,0,0))
    cv.text(ax_x0-46,ax_y0-16,ylab,(0,0,0),scale=1)
    if names:
        ly=ax_y0+12
        for (color,_d),nm in zip(series,names):
            cv.line(ax_x1-118,ly,ax_x1-94,ly,color)
            cv.text(ax_x1-88,ly-4,nm,(0,0,0))
            ly+=15

def render(path,snow_state,sm,n_days):
    W,H=1300,940
    cv=Canvas(W,H)
    days=np.arange(1,n_days+1)
    cv.text(W//2-175,14,"3-LAYER SNOWPACK DYNAMICS (ANDERSON-NIU, ENERGY BALANCE, DRAINAGE)",(0,0,0),scale=2)
    P1=(70,70,620,440); P2=(700,70,1250,440); P3=(70,520,620,890); P4=(700,520,1250,890)
    swe=sm["swe_mm"]; depth=sm["snow_depth_m"]; melt=sm["melt_mm"]
    refz=sm["refreeze_mm"]; run=sm["runoff_mm"]; dens=sm["mean_density_kg_m3"]
    xmax=n_days; xticks=[0,10,20,30,40,50,60,68]
    # P1 SWE + depth (depth*100 to share mm axis)
    y1max=max(max(swe),max(depth)*100)*1.1
    _panel(cv,P1,"SNOW WATER EQUIVALENT & DEPTH","SWE (MM)","DAY",
           [((31,119,180),list(zip(days,swe))),((44,160,44),list(zip(days,depth*100)))],
           xticks,[0,y1max/2,y1max],[0,y1max],0,xmax,["SWE","DEPTH X100"])
    # P2 temperatures
    temps=[snow_state[:,i,4]-T0 for i in range(3)]
    tmax=max(max(t) for t in temps)+1; tmin=min(min(t) for t in temps)-1; tmin=min(tmin,-2)
    _panel(cv,P2,"LAYER TEMPERATURES","TEMP (DEG C)","DAY",
           [((31,119,180),list(zip(days,temps[0]))),((214,39,40),list(zip(days,temps[1]))),
            ((8,8,8),list(zip(days,temps[2])))],
           xticks,[tmin,(tmin+tmax)/2,tmax],[tmin,tmax],0,xmax,["TOP","MID","BOTTOM"])
    # P3 melt/refreeze/runoff
    p3max=max(max(melt),max(refz),max(run),0.1)*1.15
    _panel(cv,P3,"DAILY MELT / REFREEZE / RUNOFF","MM/DAY","DAY",
           [((214,39,40),list(zip(days,melt))),((23,190,207),list(zip(days,refz))),
            ((31,119,180),list(zip(days,run)))],
           xticks,[0,p3max/2,p3max],[0,p3max],0,xmax,["MELT","REFREEZE","RUNOFF"])
    # P4 mean density (left) + stacked thickness (right)
    dmax=max(dens)*1.15
    _panel(cv,P4,"MEAN DENSITY & LAYER THICKNESS","DENSITY (KG/M3)","DAY",
           [((8,8,8),list(zip(days,dens)))],
           xticks,[0,dmax/2,dmax],[0,dmax],0,xmax,["DENSITY"])
    x0,y0,x1,y1=P4; ax_x0=x0+8; ax_x1=x1; ax_y0=y0+22; ax_y1=y1-34
    dmax2=max(depth)*1.15
    cols=[(120,190,240),(70,130,200),(20,70,160)]
    for di in range(n_days):
        bot=0
        for i in range(3):
            hh=snow_state[di,i,0]
            xb=ax_x0+di/max(xmax-1,1)*(ax_x1-ax_x0)
            yb=ax_y1-(bot)/dmax2*(ax_y1-ax_y0)
            yb2=ax_y1-(bot+hh)/dmax2*(ax_y1-ax_y0)
            cv.line(xb,yb,xb,yb2,cols[i])
            bot+=hh
    write_png(path,cv.rgb)
