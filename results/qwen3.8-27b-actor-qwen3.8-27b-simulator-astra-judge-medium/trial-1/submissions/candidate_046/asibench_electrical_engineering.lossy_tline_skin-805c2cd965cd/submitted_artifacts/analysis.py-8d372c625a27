#!/usr/bin/env python3
"""
Transmission-line TARGET prediction from CALIBRATION data.

Physical picture
----------------
Each line's intrinsic per-meter propagation constant is  gamma(f) = alpha(f) + 1j*beta(f)
and the (matched) transfer function is  H(f) = exp(-gamma(f)*L)   [exp(+j*w*t) convention].

  * LOSS   alpha(f) [Np/m]  : physics-informed skin + dielectric form
            alpha(f) = a0 + A1*sqrt(f) + A2*f
    with the coefficients (a0,A1,A2) modelled as LINEAR functions of the conductor/geometry
    descriptors (dc_resistance, trace_width, roughness_index), fit on the 8 calibration lines.
    (skin term ~ sqrt(f) from AC resistance; dielectric term ~ f; a0 = small DC offset.)

  * DELAY  beta(f) [rad/m]  : the group-delay SHAPE  S(f)=gd(f)/gd(0)  is nearly universal
    (max spread ~2% across the calibration lines), so
            beta(f) = 2*pi*tau0 * int_0^f S(f') df'
    where tau0 = gd(0)/L (DC delay-per-meter) is modelled as a smooth Gaussian-weighted
    interpolant of the calibration lines in (capacitance, trace_width, roughness) space.
    This reproduces the observed absolute velocity (which is ~6-23% slower than 1/sqrt(L*C),
    i.e. set by an effective inductance L_eff = k*L, k in [1.06,1.23]) and its mild dispersion.

Conventions / consistency
-------------------------
* SI units, exp(+j*w*t).  phase_rad = -beta*L  -> negative, unwrapped branch (phase(0)=0).
* group_delay_s is REPORTED as -d(phase_rad)/d(omega) of the phase we output (consistent).
* attenuation_np_per_m = alpha(f)  (per metre, length-independent).
* magnitude_db = -20*log10(e)*alpha*L  (total, scales with L).

Outputs: results/target_transfer.csv, results/target_waveforms.csv, results/pulse_metrics.csv
"""
import numpy as np, pandas as pd, os

DATA, OUT = "data", "results"
os.makedirs(OUT, exist_ok=True)
LN10E = np.log10(np.e)

# ------------------------------------------------------------------ load
cal_lines = pd.read_csv(f"{DATA}/calibration_lines.csv").set_index("line_id")
tgt_lines = pd.read_csv(f"{DATA}/target_lines.csv")
cal_tr    = pd.read_csv(f"{DATA}/calibration_transfer.csv")
F         = pd.read_csv(f"{DATA}/frequency_grid.csv")["frequency_hz"].values
pulse     = pd.read_csv(f"{DATA}/input_pulse.csv")
t, vin    = pulse["time_s"].values, pulse["input_v"].values
Nt        = len(t)
ids       = list(cal_lines.index)
W_        = 2*np.pi*F

# per-line per-meter alpha, beta, gd
def per_meter(lid):
    d = cal_tr[cal_tr["line_id"]==lid].sort_values("frequency_hz").reset_index(drop=True)
    L = cal_lines.loc[lid,"length_m"]
    return (d["frequency_hz"].values,
            -d["magnitude_db"].values/(20*LN10E*L),   # alpha  [Np/m]
            -d["phase_rad"].values/L,                  # beta   [rad/m]
            d["group_delay_s"].values)                 # gd     [s]
PM = {l: per_meter(l) for l in ids}

# ------------------------------------------------------------------ LOSS model
def fit_alpha_line(a):
    X = np.column_stack([np.ones(len(a)), np.sqrt(F), F])       # a0 + A1*sqrt(f) + A2*f
    return np.linalg.lstsq(X, a, rcond=None)[0]
coef = {l: fit_alpha_line(PM[l][1]) for l in ids}              # [a0,A1,A2]
Cmat = np.array([coef[l] for l in ids])
def pvec(row):  return np.array([row["dc_resistance_ohm_per_m"], row["trace_width_um"], row["roughness_index"]])
Pmat = np.array([pvec(cal_lines.loc[l]) for l in ids]); Xp = np.column_stack([np.ones(len(ids)), Pmat])
loss_coef = {n: np.linalg.lstsq(Xp, Cmat[:,j], rcond=None)[0] for j,n in enumerate(["a0","A1","A2"])}
def predict_alpha(row):
    p = pvec(row)
    a0 = loss_coef["a0"]@[1,*p]; A1 = loss_coef["A1"]@[1,*p]; A2 = loss_coef["A2"]@[1,*p]
    return a0 + A1*np.sqrt(F) + A2*F

# ------------------------------------------------------------------ DELAY model
S    = np.mean([PM[l][3]/PM[l][3][0] for l in ids], axis=0)        # universal dispersion shape
Sint = np.zeros_like(F)
for i in range(1, len(F)):
    Sint[i] = Sint[i-1] + 0.5*(S[i]+S[i-1])*(F[i]-F[i-1])
def dvec(row): return np.array([row["capacitance_f_per_m"], row["trace_width_um"], row["roughness_index"]])
Xd  = np.array([dvec(cal_lines.loc[l]) for l in ids]); Xdn = (Xd-Xd.mean(0))/Xd.std(0)
tau0_cal = np.array([PM[l][3][0]/cal_lines.loc[l,"length_m"] for l in ids])
ELL = 0.8
def predict_tau0(row, Xd_use=None, y_use=None, x=None):
    Xd_u = Xd_use if Xd_use is not None else Xdn
    y_u  = y_use  if y_use  is not None else tau0_cal
    x_u  = x      if x      is not None else (dvec(row)-Xd.mean(0))/Xd.std(0)
    d2 = ((Xd_u-x_u)**2).sum(1); w = np.exp(-d2/(2*ELL**2)); return (w*y_u).sum()/w.sum()

# ------------------------------------------------------------------ build H
def build_H(row):
    L  = row["length_m"]
    a  = predict_alpha(row)
    bt = 2*np.pi*predict_tau0(row)*Sint            # beta [rad/m]
    phase = -bt*L
    mag_db = -20*LN10E*a*L
    gd = -np.gradient(phase, W_)                    # consistent group delay
    return a, bt, phase, mag_db, gd

# ------------------------------------------------------------------ VALIDATION
print("=== VALIDATION: parametric model reconstruction of calibration lines ===")
print(f"{'line':8} {'dMag_RMS_dB':>12} {'dMag_max_dB':>12} {'dPh_RMS_rad':>12} {'dPh_max_rad':>12} {'dGD_max_%':>10}")
for lid in ids:
    d = cal_tr[cal_tr["line_id"]==lid].sort_values("frequency_hz").reset_index(drop=True)
    ph_t, mg_t, gd_t = d["phase_rad"].values, d["magnitude_db"].values, d["group_delay_s"].values
    a_m,bt_m,ph_m,mg_m,gd_m = build_H(cal_lines.loc[lid])
    dph=ph_m-ph_t; dm=mg_m-mg_t; dg=(gd_m-gd_t)/gd_t*100
    print(f"{lid:8} {np.sqrt((dm**2).mean()):12.4f} {np.abs(dm).max():12.4f} "
          f"{np.sqrt((dph**2).mean()):12.3f} {np.abs(dph).max():12.3f} {np.abs(dg).max():10.3f}")

# honest LOO-CV for the two learned maps (magnitude + delay)
print("\n=== LOO-CV (each calibration line predicted from the other 7) ===")
rms_loo=[]; gd_loo=[]
for i in range(len(ids)):
    lid=ids[i]
    Xp_i=np.delete(Xp,i,0); C_i=np.delete(Cmat,i,0)
    lc_i={n:np.linalg.lstsq(Xp_i,C_i[:,j],rcond=None)[0] for j,n in enumerate(["a0","A1","A2"])}
    p=pvec(cal_lines.loc[lid]); a0=lc_i["a0"]@[1,*p]; A1=lc_i["A1"]@[1,*p]; A2=lc_i["A2"]@[1,*p]
    a_pred=a0+A1*np.sqrt(F)+A2*F; L=cal_lines.loc[lid,"length_m"]
    dm=-20*LN10E*(a_pred-PM[lid][1])*L; rms_loo.append(np.sqrt((dm**2).mean()))
    Xd_i=np.delete(Xdn,i,0); t_pred=predict_tau0(None,Xd_i,np.delete(tau0_cal,i,0),Xdn[i])
    gd_loo.append((t_pred-tau0_cal[i])/tau0_cal[i]*100)
print(f"  magnitude LOO RMS: max={max(rms_loo):.3f} dB  mean={np.mean(rms_loo):.3f} dB")
print(f"  delay/tau0 LOO err: max={max(np.abs(gd_loo)):.2f} %  mean={np.mean(np.abs(gd_loo)):.2f} %  "
      f"per={[f'{g:+.1f}' for g in gd_loo]}")

# ------------------------------------------------------------------ TARGET transfer
rows=[]; H_target={}
for _,row in tgt_lines.iterrows():
    tid=row["line_id"]; L=row["length_m"]
    a,bt,phase,mag_db,gd = build_H(row)
    H_target[tid]=np.exp(-(a+1j*bt)*L)
    for i in range(len(F)):
        rows.append([tid, F[i], mag_db[i], phase[i], gd[i], a[i]])
pd.DataFrame(rows,columns=["target_id","frequency_hz","magnitude_db","phase_rad","group_delay_s","attenuation_np_per_m"])\
  .to_csv(f"{OUT}/target_transfer.csv", index=False)

# ------------------------------------------------------------------ WAVEFORMS
V_in = np.fft.rfft(vin, n=Nt)
wrows=[]
for _,row in tgt_lines.iterrows():
    tid=row["line_id"]; v_out=np.fft.irfft(H_target[tid]*V_in, n=Nt)
    for i in range(Nt): wrows.append([tid, t[i], vin[i], v_out[i]])
pd.DataFrame(wrows,columns=["target_id","time_s","input_v","output_v"]).to_csv(f"{OUT}/target_waveforms.csv", index=False)

# ------------------------------------------------------------------ METRICS
def fwhm(t,v):
    pk=v.max(); hi=np.where(v>=pk/2)[0]; return t[hi[-1]]-t[hi[0]], t[np.argmax(v)]
def energy(v): return np.trapezoid(v**2, t)          # true energy  J (V^2*s)
def tail_asym(t,v):
    pk=v.max(); hi=np.where(v>=pk/2)[0]; tl,tl2=t[hi[0]],t[hi[-1]]; tp=t[np.argmax(v)]
    return (tl2-tp)/(tp-tl) if (tp-tl)>0 else np.nan
mrows=[]
for _,row in tgt_lines.iterrows():
    tid=row["line_id"]; v_out=np.fft.irfft(H_target[tid]*V_in, n=Nt)
    infw,itp=fwhm(t,vin); ofw,otp=fwhm(t,v_out)
    mrows.append([tid, infw, ofw, ofw/infw, otp-itp, otp, energy(v_out)/energy(vin), tail_asym(t,v_out)])
mcols=["target_id","input_fwhm_s","output_fwhm_s","fwhm_broadening_ratio","peak_delay_s","output_peak_time_s","energy_ratio","tail_asymmetry"]
pd.DataFrame(mrows,columns=mcols).to_csv(f"{OUT}/pulse_metrics.csv", index=False)
print("\n=== TARGET PULSE METRICS ===")
print(pd.DataFrame(mrows,columns=mcols).to_string(index=False))
print("\nWrote results/target_transfer.csv, results/target_waveforms.csv, results/pulse_metrics.csv")
