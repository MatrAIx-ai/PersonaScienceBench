    curves = [(t_vals, seriesA[0], (44, 160, 44)), (t_vals, seriesB[0], (148, 103, 189))]
    plot_panel(cv, 980, y0, 1380, y1, "m(t) and interface density", curves,
               t_vals.min(), t_vals.max(), 0, ytop, True, False, "t", "")

