def make_figure():
    W, H = 1400, 900
    cv = new_canvas(W, H)
    draw_text(cv, 20, 10, "2D Ising domain growth  T=2.0236 beta=0.4942 seed=1802725656",
              (0, 0, 0), 2)

    # Row 0: six sampled states
    draw_text(cv, 60, 48, "snapshots:", (0, 0, 0), 1)
    for k in range(6):
        x = 60 + k * 210
        draw_snapshot(cv, x, 66, snap_states[k], 200)
        draw_text(cv, x, 272, "t=%d" % int(snapshot_times[k]), (0, 0, 0), 1)

    # Row 1: three diagnostic panels
    y0, y1 = 320, 560
    Lmin, Lmax = L_vals.min(), L_vals.max()
    curves = [(t_vals, L_vals, (0, 0, 0))]
    ft = np.linspace(fit_range[0], fit_range[1], 100)
    curves.append((ft, amplitude * ft ** exponent, (214, 39, 40)))
    plot_panel(cv, 40, y0, 470, y1, "L(t) coarsening r2=%.3f" % r_squared,
               curves, t_vals.min(), t_vals.max(), Lmin * 0.9, Lmax * 1.1,
               True, True, "t", "L")

    curves = [(np.arange(max_r), stackC[k], CC[k]) for k in range(6)]
    plot_panel(cv, 500, y0, 950, y1, "C(r) at snapshots", curves,
               0, max_r - 1, 0, 1, False, False, "r", "C(r)")

