"""Optimistic Q-learning with drift-adaptive bonus and pooled advantage.

Model-free, tabular, horizon-indexed optimistic Q-learning.

Per (h, s, a) cell (O(H*S*A) scalars total):
  * N: total visit count;
  * Q: the value estimate (visit-dependent online update, decaying step
    1/n**ALPHA or plain running mean for ALPHA=1);
  * a bounded sliding window (WINDOW entries, fixed constant) of recent
    drift-corrected bootstrap targets, used for the windowed target
    variance that feeds the Bernstein confidence bonus.

Two complementary targets per observed transition (h, s, a, r, s'):
  * mean target  t_mean = r + max_{a'} Q(h+1, s', a')   (current Q; the
    value estimate is never contaminated by stale early-episode
    bootstraps);
  * variance target  t_var = r + max_{a'} [Q_snap(h+1, s', a')
    + BETA * B_snap(h+1, s', a')], where (Q_snap, B_snap) is the table
    frozen at the start of the current episode (one bounded per-episode
    snapshot, O(H*S*A)), so the variance statistic reflects the recent
    continuation spread and adapts to drift instead of paying one large
    burn-in term.

Optimism / confidence:
  * visited cells get the Bernstein-style bonus
        B = sqrt(SQRT_COEF * v * C / n) + C / n,
    with v the windowed target variance (clipped to V_ub(h) =
    ((H-h+1)/2)^2) and n the total visit count;
  * unvisited cells get bonus UNVISITED_SCALE * (remaining horizon) and,
    if UNVISITED_INIT > 0, carry that value in the bootstrap.

Mixture of two estimates (the key mechanism): the action ranking at (h, s)
uses a shrinkage combination of
  (i)   the per-cell Q advantage  Q(h,s,a) - mean_{a'} Q(h,s,a'), and
  (ii)  a pooled advantage  U(s,a)  maintained per (s, a) from the
        horizon-shifted signal  u = t_mean - mean_{a'} Q(h,s,a'),
        which accumulates the fork/continuation information across all
        horizons that visit (s, a) -- the model-free analogue of sharing
        the transition information across h.
  score(h, s, a) = (1-KAPPA) * Qeff(h,s,a)
                   + KAPPA * (mean_{a'} Qeff(h,s,a') + U(s,a) - Ubar(s))
                   + B(h, s, a)
with random tie-breaking.  No transition model, no next-state count
tensor, no replay, no H*S*A*S memory.
"""
from __future__ import annotations

import numpy as np

# ---- single shared configuration (no branching on case_id/dimensions/MDP) ----
KAPPA = 1.0          # shrinkage weight of the pooled advantage in the ranking
BETA = 0.0           # optimism injected into the frozen variance target
ALPHA = 1.0          # decaying step: 1/n**ALPHA (1.0 = plain running mean)
C_LOG = 1.8          # log/confidence constant of the Bernstein bonus
WINDOW = 32          # sliding-window length for the target-variance estimate
UNVISITED_INIT = 1.0 # Q of unvisited cells in the bootstrap = scale*horizon
UNVISITED_SCALE = 1.0# bonus for unvisited cells = scale * remaining horizon
PREF_UNVISITED = False# prefer any unvisited action at (h, s)
VAR_FLOOR = 0.0      # floor for the windowed target variance
BONUS_MODE = "cell"   # "cell" | "pooled" | "min": source of the confidence bonus
C_START = 1.5        # bonus constant in the first C_RAMP episodes
C_RAMP = 0           # episodes over which C decays from C_START to C_LOG
SQRT_COEF = 0.75     # multiplier of the variance term: B = sqrt(SQRT_COEF*v*C/n) + C/n


def make_agent(env_spec, seed):
    S = int(env_spec["S"])
    A = int(env_spec["A"])
    H = int(env_spec["H"])
    K = int(env_spec["K"])
    return _Agent(S, A, H, K, int(seed),
                  float(KAPPA), float(BETA), float(ALPHA), float(C_LOG),
                  int(WINDOW), float(UNVISITED_INIT), float(UNVISITED_SCALE),
                  bool(PREF_UNVISITED), float(VAR_FLOOR),
                  str(BONUS_MODE), float(C_START), int(C_RAMP), float(SQRT_COEF))


class _Agent:
    def __init__(self, S, A, H, K, seed, kappa, beta, alpha, c_log, window,
                 unv_init, unv_scale, pref_unv, var_floor, bonus_mode,
                 c_start, c_ramp, sqrt_coef):
        self.sqrt_coef = sqrt_coef
        self.bonus_mode = bonus_mode
        self.C_start = c_start
        self.C_ramp = c_ramp
        self.episode = 0
        self.S, self.A, self.H, self.K = S, A, H, K
        self.kappa = kappa
        self.beta = beta
        self.alpha = alpha
        self.C = c_log
        self.W = max(2, window)
        self.unv_init = unv_init
        self.pref_unv = pref_unv
        self.var_floor = var_floor
        self.rng = np.random.default_rng(seed)
        ncells = H * S * A
        self.N = np.zeros(ncells, dtype=np.int64)
        self.Q = np.zeros(ncells, dtype=np.float64)
        self.ring = np.zeros((ncells, self.W), dtype=np.float64)
        self.head = np.zeros(ncells, dtype=np.int64)
        self.wsum = np.zeros(ncells, dtype=np.float64)
        self.wsum2 = np.zeros(ncells, dtype=np.float64)
        self.wcnt = np.zeros(ncells, dtype=np.int64)
        # pooled advantage per (s, a)
        self.U = np.zeros((S, A), dtype=np.float64)
        self.Ucnt = np.zeros((S, A), dtype=np.int64)
        # pooled advantage variance (windowed) per (s, a)
        self.Uring = np.zeros((S, A, self.W), dtype=np.float64)
        self.Uhead = np.zeros((S, A), dtype=np.int64)
        self.Uwsum = np.zeros((S, A), dtype=np.float64)
        self.Uwsum2 = np.zeros((S, A), dtype=np.float64)
        self.Uwcnt = np.zeros((S, A), dtype=np.int64)
        self.maxval = np.array([H - hh for hh in range(H)], dtype=np.float64)
        self.vub = 0.25 * self.maxval ** 2
        self.unv = self.maxval * unv_scale
        self.Q_snap = np.zeros((H, S, A), dtype=np.float64)
        self.B_snap = self._bonus_table()

    def _row(self, hh, state):
        i0 = (hh * self.S + state) * self.A
        return i0, i0 + self.A

    def _qeff_row(self, hh, state):
        i0, i1 = self._row(hh, state)
        n = self.N[i0:i1]
        q = np.clip(self.Q[i0:i1], 0.0, self.maxval[hh])
        return np.where(n > 0, q, self.unv_init * self.maxval[hh])

    def _qeff_table(self):
        q = self.Q.reshape(self.H, self.S, self.A)
        n = self.N.reshape(self.H, self.S, self.A)
        return np.where(n > 0,
                        np.clip(q, 0.0, self.maxval[:, None, None]),
                        self.unv_init * self.maxval[:, None, None])

    def _var_row(self, hh, state):
        i0, i1 = self._row(hh, state)
        cnt = np.maximum(self.wcnt[i0:i1], 1)
        mean = self.wsum[i0:i1] / cnt
        var = self.wsum2[i0:i1] / cnt - mean * mean
        return np.clip(var, self.var_floor, self.vub[hh])

    def _bonus_row(self, hh, state):
        i0, i1 = self._row(hh, state)
        n = self.N[i0:i1]
        var = self._var_row(hh, state)
        b = np.empty(self.A, dtype=np.float64)
        c = self._C_now()
        for a in range(self.A):
            if n[a] == 0:
                b[a] = self.unv[hh]
            else:
                b[a] = np.sqrt(self.sqrt_coef * var[a] * c / n[a]) + c / n[a]
        return b

    def _bonus_table(self):
        b = np.empty((self.H, self.S, self.A), dtype=np.float64)
        for hh in range(self.H):
            for s in range(self.S):
                b[hh, s] = self._bonus_row(hh, s)
        return b

    def _C_now(self):
        if self.C_ramp > 0 and self.episode < self.C_ramp:
            frac = 1.0 - self.episode / float(self.C_ramp)
            return self.C + (self.C_start - self.C) * frac
        return self.C

    def _pooled_bonus(self, state, hh):
        u = self.Uwsum2[state] / np.maximum(self.Uwcnt[state], 1)
        mean = self.Uwsum[state] / np.maximum(self.Uwcnt[state], 1)
        var = np.clip(u - mean * mean, self.var_floor, self.maxval[hh] ** 2)
        n = np.maximum(self.Ucnt[state], 1)
        b = np.sqrt(self.sqrt_coef * var * self._C_now() / n) + self._C_now() / n
        has = self.Ucnt[state] > 0
        b = np.where(has, b, self.unv[hh])
        return b

    def _pooled_adv(self, state):
        """Centered pooled advantage for each action at state."""
        u = self.U[state].copy()
        has = self.Ucnt[state] > 0
        if has.any():
            ubar = self.U[state][has].mean()
            u[~has] = ubar
        else:
            u = np.zeros(self.A, dtype=np.float64)
        return u - u.mean()

    def _push_var(self, i, t):
        old = self.ring[i, self.head[i]]
        self.wsum[i] -= old
        self.wsum2[i] -= old * old
        self.ring[i, self.head[i]] = t
        self.head[i] = (self.head[i] + 1) % self.W
        self.wsum[i] += t
        self.wsum2[i] += t * t
        if self.wcnt[i] < self.W:
            self.wcnt[i] += 1

    # -- interface ---------------------------------------------------------
    def act(self, h, state):
        hh = h - 1
        i0, i1 = self._row(hh, state)
        nrow = self.N[i0:i1]
        if self.pref_unv and nrow.min() == 0:
            cands = np.nonzero(nrow == 0)[0]
            return int(self.rng.choice(cands))
        q = self._qeff_row(hh, state)
        qbar = q.mean()
        adv = self._pooled_adv(state)
        b_cell = self._bonus_row(hh, state)
        if self.bonus_mode == "pooled":
            b = self._pooled_bonus(state, hh)
        elif self.bonus_mode == "min":
            b = np.minimum(b_cell, self._pooled_bonus(state, hh))
        else:
            b = b_cell
        sc = (1.0 - self.kappa) * q + self.kappa * (qbar + adv) + b
        best = sc.max()
        cands = np.nonzero(sc >= best - 1e-9)[0]
        if cands.size == 1:
            return int(cands[0])
        return int(self.rng.choice(cands))

    def observe(self, h, state, action, reward, next_state, done):
        hh = h - 1
        r = float(reward)
        i0, i1 = self._row(hh, state)
        qbar = self._qeff_row(hh, state).mean()
        i = i0 + action
        if hh < self.H - 1:
            qn_row = self._qeff_row(hh + 1, next_state)
            t_mean = r + float(qn_row.max())
            boot = self.Q_snap[hh + 1, next_state] + self.beta * self.B_snap[hh + 1, next_state]
            t_var = r + float(boot.max())
        else:
            t_mean = t_var = r
        lo, hi = 0.0, float(self.H - hh)
        t_mean = min(max(t_mean, lo), hi)
        t_var = min(max(t_var, lo), hi)
        n = self.N[i] + 1
        if self.alpha >= 1.0:
            self.Q[i] += (t_mean - self.Q[i]) / n
        else:
            self.Q[i] += (1.0 / n ** self.alpha) * (t_mean - self.Q[i])
        self.N[i] = n
        self._push_var(i, t_var)
        # pooled advantage update (per (s, a), horizon-shifted signal)
        u = t_mean - qbar
        nu = self.Ucnt[state, action] + 1
        if self.alpha >= 1.0:
            self.U[state, action] += (u - self.U[state, action]) / nu
        else:
            self.U[state, action] += (1.0 / nu ** self.alpha) * (u - self.U[state, action])
        self.Ucnt[state, action] = nu
        hi = int(self.Uhead[state, action])
        old = self.Uring[state, action, hi]
        self.Uwsum[state, action] -= old
        self.Uwsum2[state, action] -= old * old
        self.Uring[state, action, hi] = u
        self.Uhead[state, action] = (hi + 1) % self.W
        self.Uwsum[state, action] += u
        self.Uwsum2[state, action] += u * u
        if self.Uwcnt[state, action] < self.W:
            self.Uwcnt[state, action] += 1

    # -- optional per-episode hooks used by the official runner -----------
    def reset_episode(self, episode, state):
        self.episode = int(episode)
        self.Q_snap = self._qeff_table()
        self.B_snap = self._bonus_table()

    def end_episode(self, episode, episode_reward):
        pass
