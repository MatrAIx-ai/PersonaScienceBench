import sys, json, importlib.util, time
from pathlib import Path
import numpy as np
sys.path.insert(0, str(Path('/workspace/data').resolve()))
import public_calibration_runner as pr

def load_module():
    spec = importlib.util.spec_from_file_location("sub_analysis", "/workspace/analysis.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

mod = load_module()
suite = json.loads(Path('/workspace/data/public_calibration_suite.json').read_text())
strong = {k: v['mean_regret'] for k, v in suite['baselines']['strong_reference']['per_case'].items()}
ucb = {k: v['mean_regret'] for k, v in suite['baselines']['plain_ucb_b']['per_case'].items()}

print("=== (b) Per-case x seed regrets (official protocol) ===")
print(f"{'case':26s} {'seed':>8s} {'regret':>9s}")
for case in suite['cases']:
    cid = case['spec']['case_id']
    for seed in suite['eval_seeds']:
        r = pr.run_case(case, mod.make_agent, seed)
        print(f"{cid:26s} {seed:8d} {r['regret']:9.2f}")

print("\n=== (c) Comparison vs baselines (official seeds) ===")
print(f"{'case':26s} {'FINAL':>8s} {'UCB-B':>8s} {'strong':>8s} {'vs-UCB':>8s} {'vs-strong':>10s}")
tot_f = 0
for case in suite['cases']:
    cid = case['spec']['case_id']
    regs = [pr.run_case(case, mod.make_agent, s)['regret'] for s in suite['eval_seeds']]
    m = float(np.mean(regs)); tot_f += m
    print(f"{cid:26s} {m:8.2f} {ucb[cid]:8.2f} {strong[cid]:8.2f} {ucb[cid]/max(m,0.01):8.2f}x {m/strong[cid]:10.3f}")
print(f"{'TOTAL':26s} {tot_f:8.2f} {sum(ucb.values()):8.2f} {sum(strong.values()):8.2f}")

print("\n=== 13-seed systematic cost (regret - oracle luck floor) ===")
seeds = list(suite['eval_seeds']) + [101, 202, 303, 404, 505, 606, 707, 808, 909, 1010]
oracle = {}
for case in suite['cases']:
    spec = case['spec']
    P = np.asarray(spec['P']); R = np.asarray(spec['R'])
    H, S, A = spec['H'], spec['S'], spec['A']
    V = np.zeros((H+1, S))
    for hh in range(H-1, -1, -1):
        Q = R[hh] + np.matmul(P[hh], V[hh+1])
        V[hh] = Q.max(axis=-1)
    regs = []
    for seed in seeds:
        rng = np.random.default_rng(seed + 9176)
        total = 0.0
        for ep in range(spec['K']):
            s = 0
            for hh in range(H):
                a = int(np.argmax(R[hh, s] + np.matmul(P[hh, s], V[hh+1])))
                total += float(R[hh, s, a])
                s = int(rng.choice(len(P[hh, s, a]), p=P[hh, s, a]))
        regs.append(spec['K']*case['optimal_start_value'] - total)
    oracle[case['spec']['case_id']] = float(np.mean(regs))
for case in suite['cases']:
    cid = case['spec']['case_id']
    regs = [pr.run_case(case, mod.make_agent, s)['regret'] for s in seeds]
    print(f"  {cid:26s} sys_cost={float(np.mean(regs)) - oracle[cid]:8.2f}  (oracle floor {oracle[cid]:7.2f})")
