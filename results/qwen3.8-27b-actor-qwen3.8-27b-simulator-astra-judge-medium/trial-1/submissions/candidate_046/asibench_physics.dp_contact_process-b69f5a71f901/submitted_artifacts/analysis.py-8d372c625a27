#!/usr/bin/env python3
"""
Threshold and scaling analysis of the asymmetric parity-modulated
nearest-neighbor birth-death process defined in ./data/task_input.json.

Model kernel (preserved exactly, from `parameterization`):
  - 1D lattice, periodic boundary condition
  - binary states {0,1}; fully inactive state is absorbing
  - fully active initial condition for every trajectory
  - random-sequential updates: one sweep = L random site visits (with replacement)
  - active site visited: dies with probability dt
  - inactive site i visited: birth with probability
        p_birth = min(1, lambda * dt * parity_scale(i) * (wL*left_active + wR*right_active))
  - rho(t) and survival probability recorded once per sweep, t = 1..t_max

Protocol (single source of truth, from `protocol`):
  lambda_scan, beta_fit_lambdas, system_sizes, n_seeds, t_max, seed.

Common random numbers: for a given (L, seed_idx) the exact same RNG stream
(site-visit order + uniform draws) is used for every lambda, so lambda pairs
are strongly correlated (variance reduction) without altering the Markov
kernel of any individual trajectory.  Run i uses base seed protocol.seed + i,
i = 0..n_seeds-1.

Key empirical finding (see assessment_note in dp_report.json): the scan lies
on the SUBCRITICAL side of the threshold, which sits at/just above the top of
the lambda_scan (lambda_c ~= 1.81).  The analysis is therefore built around
subcritical observables:
  - lambda_c: divergence of the relaxation time, from the density ratio
    S(lambda) = rho(t1)/rho(t2) fitted as log S = d + c*(lambda_c-lambda)^nu_par
  - beta: quasi-stationary (QSS) density of small systems vs (lambda_c-lambda);
    declared not resolvable if the QSS sits in the finite-size crossover
  - delta: L-scaling of the QSS density (rho_QSS ~ L^-delta)
  - z: nu_par / nu_perp from the relaxation-time divergence (DP hypothesis
    nu_perp = 0.731), plus a scaled-curve collapse as a secondary diagnostic

Outputs (./results/): dp_summary.csv, dp_scan.csv, dp_timeseries.csv, dp_report.json
"""

import json
import os

import numpy as np
import pandas as pd
from scipy.optimize import least_squares

INPUT_PATH = "./data/task_input.json"
RESULTS_DIR = "./results"

# Directed-percolation (1+1 DP) reference exponents (hypothesis / plausibility).
Z_DP = 1.772       # nu_par / nu_perp
NU_PAR_DP = 1.2955 # correlation-time exponent
NU_PERP = 0.731    # transverse correlation-length exponent (fixed in fits)
BETA_DP = 0.2765   # order-parameter exponent (plausibility only)
DELTA_DP = 0.1596  # QSS density exponent (plausibility only)

# Pre-registered decision windows around the DP values.
BETA_WINDOW = (0.18, 0.38)
DELTA_WINDOW = (0.08, 0.26)
NU_PAR_WINDOW = (0.9, 1.7)

# Density-ratio windows (t1, t2) for the relaxation-time divergence fit.
RATIO_WINDOWS = [(200, 1000), (400, 1000)]
QSS_T_MIN = 400          # minimum death time for a valid QSS estimate
PROBE_T_MAX = 4000       # extended diagnostic probe at lambda_c (budget allows)


# ----------------------------------------------------------------------------
# Input
# ----------------------------------------------------------------------------
def load_input():
    with open(INPUT_PATH, "r", encoding="utf-8-sig") as f:
        data = json.load(f)
    return data, data["protocol"], data["parameterization"]


# ----------------------------------------------------------------------------
# Simulation
# ----------------------------------------------------------------------------
class Process:
    def __init__(self, L, dt, wL, wR, parity_even, parity_odd):
        self.L = L
        self.dt = dt
        self.wL = wL
        self.wR = wR
        idx = np.arange(L)
        self.left = (idx - 1) % L
        self.right = (idx + 1) % L
        self.parity = np.where(idx % 2 == 0, parity_even, parity_odd)

    def simulate_multi(self, lambdas, t_max, base_seed, n_seeds):
        """Returns rho, alive: (n_lam, n_seeds, t_max)."""
        L = self.L
        n_lam = len(lambdas)
        rho = np.empty((n_lam, n_seeds, t_max))
        alive = np.empty((n_lam, n_seeds, t_max))
        left, right, parity = self.left, self.right, self.parity
        dt, wl, wr = self.dt, self.wL, self.wR
        for s in range(n_seeds):
            rng = np.random.default_rng(base_seed + s)
            order = rng.integers(0, L, size=(t_max, L), dtype=np.int64)
            kill_u = rng.random((t_max, L))
            birth_u = rng.random((t_max, L))
            for li, lam in enumerate(lambdas):
                state = [1] * L
                ldtp = lam * dt
                for t in range(t_max):
                    row_o = order[t]
                    row_k = kill_u[t]
                    row_b = birth_u[t]
                    for k in range(L):
                        i = row_o[k]
                        if state[i]:
                            if row_k[k] < dt:
                                state[i] = 0
                        else:
                            p = ldtp * parity[i] * (wl * state[left[i]] + wr * state[right[i]])
                            if p >= 1.0 or row_b[k] < p:
                                state[i] = 1
                    c = sum(state)
                    rho[li, s, t] = c / L
                    alive[li, s, t] = 1.0 if c > 0 else 0.0
        return rho, alive


# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------
def late_index(t_max):
    """Start index of the late-time window t in (0.8*t_max, t_max]."""
    return int(0.8 * t_max)


def loglog_slope(x, y):
    """OLS slope of log y vs log x; returns (slope, se, r2)."""
    lx, ly = np.log(np.asarray(x, dtype=float)), np.log(np.asarray(y, dtype=float))
    n = len(lx)
    if n < 2:
        return np.nan, np.nan, np.nan
    A = np.vstack([lx, np.ones(n)]).T
    (slope, intercept), _, _, _ = np.linalg.lstsq(A, ly, rcond=None)
    pred = A @ np.array([slope, intercept])
    ss_res = float(np.sum((ly - pred) ** 2))
    ss_tot = float(np.sum((ly - ly.mean()) ** 2))
    r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else np.nan
    se = np.nan
    if n > 2 and ss_res > 0:
        sxx = float(np.sum((lx - lx.mean()) ** 2))
        if sxx > 0:
            se = float(np.sqrt((ss_res / (n - 2)) / sxx))
    return float(slope), se, float(r2)


def qss_extract(rho_run, t_min=QSS_T_MIN):
    """Per-run QSS: death time T (first t with rho=0) and QSS density
    (mean over t in [0.3T, 0.8T]) if T >= t_min, else NaN."""
    T = np.nan
    for t in range(len(rho_run)):
        if rho_run[t] == 0.0:
            T = t + 1
            break
    if not np.isfinite(T) or T < t_min:
        return T, np.nan
    t1, t2 = int(0.3 * T), int(0.8 * T)
    return T, float(rho_run[t1 - 1:t2].mean())


# ----------------------------------------------------------------------------
# lambda_c and nu_par: relaxation-time divergence via density ratios
# ----------------------------------------------------------------------------
def ratio_fit(lam_scan, rho_mean, L, t1, t2, notes, L_name=None):
    """Fit log S(lambda) = d + c*(lambda_c - lambda)^nu_par,
    S = rho(t1)/rho(t2) (seed-averaged density at system index L).
    lambda_c is bounded to lie at/above the top of the scan (the density is
    still decaying at every scan point, so the threshold is not below it)."""
    tag = "L=" + str(L_name if L_name is not None else L)
    lam = np.array(lam_scan, dtype=float)
    S = rho_mean[L, t1 - 1] / rho_mean[L, t2 - 1]
    if np.any(S <= 0) or np.any(~np.isfinite(S)):
        notes.append(f"ratio fit {tag} window=({t1},{t2}) infeasible (non-positive rho).")
        return None
    logS = np.log(S)
    lam_top = lam.max()

    def res(x):
        d, c, lc, nu = x
        return d + c * (lc - lam) ** nu - logS

    best = None
    for x0 in [(0.1, 10.0, lam_top + 0.001, 1.3), (0.3, 25.0, lam_top + 0.04, 1.0),
               (0.0, 5.0, lam_top + 0.02, 1.6), (0.5, 40.0, lam_top + 0.08, 0.8)]:
        try:
            r = least_squares(res, x0,
                              bounds=([-1.0, 0.1, lam_top + 0.001, 0.3],
                                      [3.0, 1e4, lam_top + 0.19, 3.0]),
                              max_nfev=5000)
            if best is None or r.cost < best.cost:
                best = r
        except Exception:
            continue
    if best is None or not np.isfinite(best.cost):
        notes.append(f"ratio fit {tag} window=({t1},{t2}) failed to converge.")
        return None
    d, c, lc, nu = best.x
    pred = d + c * (lc - lam) ** nu
    r2 = 1.0 - float(np.sum((logS - pred) ** 2) / np.sum((logS - logS.mean()) ** 2))
    try:
        J = best.jac
        cov = np.linalg.inv(J.T @ J) * (2.0 * best.cost / max(len(lam) - 4, 1))
        se = np.sqrt(np.clip(np.diag(cov), 0.0, None))
    except Exception:
        se = np.array([np.nan] * 4)
    at_boundary = lc <= lam_top + 0.0015
    if at_boundary:
        notes.append(
            f"ratio fit {tag} window=({t1},{t2}): lambda_c sits at the lower bound "
            f"({lam_top:.3f}); the data only constrain lambda_c from above."
        )
    return {"lc": float(lc), "nu": float(nu), "c": float(c), "d": float(d),
            "se_lc": float(se[2]), "se_nu": float(se[3]), "r2": float(r2),
            "at_boundary": bool(at_boundary), "S": S}


# ----------------------------------------------------------------------------
# beta / delta from quasi-stationary densities
# ----------------------------------------------------------------------------
def fit_beta_qss(lam_scan, qss, lambda_c, notes):
    """qss[(li, j)] = (mean_qss, n_valid). Fit log qss(lambda, L=32) =
    log A + beta*log(lambda_c - lambda).  Returns (beta, se, r2, n) or NaNs
    with a note when the QSS is in the finite-size crossover (no power law)."""
    li32 = 0  # qss is stored in lambda-scan order x size order (sizes ascending)
    pts = []
    for li, lam in enumerate(lam_scan):
        m, n = qss[(li, 0)]
        if n >= 3 and np.isfinite(m) and m > 1e-6 and lam < lambda_c:
            pts.append((lam, m))
    if len(pts) < 5:
        notes.append("beta: too few valid QSS points at L=32; not resolvable.")
        return np.nan, np.nan, np.nan, 0
    x = np.log(lambda_c - np.array([p[0] for p in pts]))
    y = np.log(np.array([p[1] for p in pts]))
    A = np.vstack([x, np.ones(len(x))]).T
    (b, i0), _, _, _ = np.linalg.lstsq(A, y, rcond=None)
    pred = A @ np.array([b, i0])
    ss_res = float(np.sum((y - pred) ** 2))
    ss_tot = float(np.sum((y - y.mean()) ** 2))
    r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else np.nan
    se = np.nan
    if len(pts) > 2 and ss_res > 0:
        sxx = float(np.sum((x - x.mean()) ** 2))
        if sxx > 0:
            se = float(np.sqrt((ss_res / (len(pts) - 2)) / sxx))
    if r2 < 0.7 or abs(b) < 0.05:
        notes.append(
            f"beta: QSS density at L=32 is flat vs (lambda_c-lambda) "
            f"(fit beta={b:.3f}, r2={r2:.2f}): the QSS sits in the finite-size "
            "crossover (L <= xi(lambda) over most of the scan), masking the "
            "(lambda_c-lambda)^beta dependence -> beta NOT resolvable in this "
            "protocol; reported as NaN rather than forced."
        )
        return np.nan, np.nan, float(r2), len(pts)
    return float(b), float(se), float(r2), len(pts)


def fit_delta_qss(lam_scan, sizes, qss, notes):
    """Pooled L-scaling of the QSS density: log qss ~ -delta*log L (all valid
    (lambda, L) points).  Cross-check only: at fixed subcritical lambda the
    scaling function also varies with L, so the slope is an approximate delta."""
    pts = []
    for li in range(len(lam_scan)):
        for j, L in enumerate(sizes):
            m, n = qss[(li, j)]
            if n >= 3 and np.isfinite(m) and m > 1e-6:
                pts.append((L, m))
    if len(pts) < 4:
        notes.append("delta: too few valid QSS points for the L-scaling fit.")
        return np.nan, np.nan, np.nan, 0
    slope, se, r2 = loglog_slope([p[0] for p in pts], [p[1] for p in pts])
    return -slope, se, r2, len(pts)


# ----------------------------------------------------------------------------
# z: dynamic scaling diagnostics
# ----------------------------------------------------------------------------
def dynamic_diagnostics(rho, rho_ss_grid, lam_scan, beta_fit_lambdas, sizes,
                        lambda_c, beta, t_max, notes):
    """t_q(lambda, L) = first t with rho <= rho_ss/2 (secondary diagnostic),
    plus a scaled-curve collapse rho*L^beta vs t/L^z_dp (window
    t in [max(L,50), 0.8*t_max], dropping the fully-active transient)."""
    li_of = {round(l, 12): i for i, l in enumerate(lam_scan)}
    z_q = Z_DP
    tq = {}
    for lam in beta_fit_lambdas:
        li = li_of[round(lam, 12)]
        for j, L in enumerate(sizes):
            rho_t = rho[(li, j)].mean(axis=0)
            r_ss = rho_ss_grid[li, j]
            if r_ss <= 1e-9:
                tq[(lam, L)] = np.nan
                continue
            idx = np.where(rho_t <= 0.5 * r_ss)[0]
            tq[(lam, L)] = float(idx[0] + 1) if len(idx) else np.nan

    curves = []
    for lam in beta_fit_lambdas:
        li = li_of[round(lam, 12)]
        for j, L in enumerate(sizes):
            rho_t = rho[(li, j)].mean(axis=0)
            t0 = max(L, 50)
            t1 = int(0.8 * t_max)
            if t1 <= t0:
                continue
            ts = np.arange(t0, t1 + 1)
            curves.append((ts / L ** z_q, rho_t[t0 - 1:t1] * L ** beta))
    metric = np.nan
    if len(curves) >= 4:
        x_min = max(c[0].min() for c in curves)
        x_max = min(c[0].max() for c in curves)
        if x_max > x_min:
            centers = np.geomspace(x_min, x_max, 8)
            Y = np.array([np.interp(centers, c[0], c[1]) for c in curves])
            within = Y.var(axis=0, ddof=1).mean()
            total = Y.var(ddof=1)
            if total > 0:
                metric = float(1.0 - within / total)

    # L-scaling of t_q at fixed lambda (finite-size cutoff regime), if resolvable
    slopes_L = []
    for lam in beta_fit_lambdas:
        pts = [(L, tq[(lam, L)]) for L in sizes
               if np.isfinite(tq[(lam, L)]) and tq[(lam, L)] >= L]
        if len(pts) >= 3:
            slope, _, _ = loglog_slope([p[0] for p in pts], [p[1] for p in pts])
            if np.isfinite(slope):
                slopes_L.append(slope)
    z_from_L = float(np.mean(slopes_L)) if slopes_L else np.nan

    valid_tq = [v for v in tq.values() if np.isfinite(v)]
    collapse_success = bool(np.isfinite(metric) and metric >= 0.4
                            and np.isfinite(z_from_L) and 1.2 <= z_from_L <= 2.4)
    return {"tq": tq, "z_from_L": z_from_L, "metric": metric,
            "collapse_success": collapse_success, "n_valid_tq": len(valid_tq)}


# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
def main():
    data, proto, param = load_input()
    task_id = data["task_id"]

    # protocol = single source of truth
    lambda_scan = [float(x) for x in proto["lambda_scan"]]
    beta_fit_lambdas = [float(x) for x in proto["beta_fit_lambdas"]]
    system_sizes = [int(x) for x in proto["system_sizes"]]
    n_seeds = int(proto["n_seeds"])
    t_max = int(proto["t_max"])
    seed = int(proto["seed"])

    # model parameters (from parameterization; kernel preserved exactly)
    dt = float(param["dt"])
    wL = float(param["left_neighbor_weight"])
    wR = float(param["right_neighbor_weight"])
    pe = float(param["site_parity_scale"]["even"])
    po = float(param["site_parity_scale"]["odd"])

    notes = []
    os.makedirs(RESULTS_DIR, exist_ok=True)

    # ------------------------------------------------------------------
    # 1. Main scan simulation (protocol t_max, n_seeds)
    # ------------------------------------------------------------------
    rho_all, alive_all = {}, {}
    for j, L in enumerate(system_sizes):
        proc = Process(L, dt, wL, wR, pe, po)
        rho, alive = proc.simulate_multi(lambda_scan, t_max, seed, n_seeds)
        for li in range(len(lambda_scan)):
            rho_all[(li, j)] = rho[li]
            alive_all[(li, j)] = alive[li]

    n_lam, n_L = len(lambda_scan), len(system_sizes)
    rho_mean = np.empty((n_L, t_max, n_lam))       # [j, t, li]
    alive_mean = np.empty((n_L, t_max, n_lam))
    rho_ss_grid = np.empty((n_lam, n_L))
    surv_grid = np.empty((n_lam, n_L))
    for li in range(n_lam):
        for j in range(n_L):
            rho_mean[j, :, li] = rho_all[(li, j)].mean(axis=0)
            alive_mean[j, :, li] = alive_all[(li, j)].mean(axis=0)
            rho_ss_grid[li, j] = rho_all[(li, j)][:, late_index(t_max):].mean()
            surv_grid[li, j] = alive_all[(li, j)][:, -1].mean()

    # steady-state check: late-window drift
    drift = np.array([
        abs(rho_mean[j, int(0.6 * t_max):int(0.8 * t_max), li].mean()
            - rho_mean[j, int(0.8 * t_max):, li].mean())
        for li in range(n_lam) for j in range(n_L)]).reshape(n_lam, n_L)
    notes.append(
        f"steady-state check: late-window density drift |mean(t in (0.6,0.8]t_max)"
        f" - mean(t in (0.8,1]t_max)| spans [{drift.min():.3f}, {drift.max():.3f}] "
        "and is positive at every scan point: the density is still relaxing at "
        f"t_max={t_max} everywhere in the scan (no established steady state)."
    )

    # ------------------------------------------------------------------
    # 2. dp_timeseries.csv  (per (lambda, L), t = 1..t_max, seed-averaged)
    # ------------------------------------------------------------------
    rows = []
    for li in range(n_lam):
        for j in range(n_L):
            rho_t = rho_mean[j, :, li]
            surv_t = alive_mean[j, :, li]
            for t in range(t_max):
                rows.append((lambda_scan[li], system_sizes[j], t + 1,
                             rho_t[t], surv_t[t]))
    ts_df = pd.DataFrame(rows, columns=["lambda", "system_size", "time", "rho",
                                        "survival_prob"])
    ts_df.to_csv(os.path.join(RESULTS_DIR, "dp_timeseries.csv"), index=False,
                 na_rep="NaN")

    # ------------------------------------------------------------------
    # 3. dp_scan.csv  (one row per (lambda, L, run); n_runs = total per group)
    # ------------------------------------------------------------------
    rows = []
    for li in range(n_lam):
        for j in range(n_L):
            r_ss_runs = rho_all[(li, j)][:, late_index(t_max):].mean(axis=1)
            surv_runs = alive_all[(li, j)][:, -1]
            for s in range(n_seeds):
                rows.append((lambda_scan[li], system_sizes[j], r_ss_runs[s],
                             surv_runs[s], n_seeds))
    scan_df = pd.DataFrame(rows, columns=["lambda", "system_size", "rho_ss",
                                          "survival_prob", "n_runs"])
    scan_df.to_csv(os.path.join(RESULTS_DIR, "dp_scan.csv"), index=False,
                   na_rep="NaN")

    # ------------------------------------------------------------------
    # 4. lambda_c and nu_par: relaxation-time divergence (density ratios)
    # ------------------------------------------------------------------
    fits = []
    for (t1, t2) in RATIO_WINDOWS:
        for j in (n_L - 1, n_L - 2):  # L=256 primary, L=128 cross-check
            f = ratio_fit(lambda_scan, rho_mean, j, t1, t2, notes,
                          L_name=system_sizes[j])
            if f is not None:
                f["L"] = system_sizes[j]
                f["window"] = (t1, t2)
                fits.append(f)
    r2_primary = np.nan
    primary = None
    if not fits:
        lambda_c, lc_low, lc_high = np.nan, np.nan, np.nan
        nu_par, se_nu = np.nan, np.nan
        notes.append("lambda_c: all ratio fits failed.")
    else:
        primary_fits = [f for f in fits if f["L"] == max(system_sizes)]
        cross_fits = [f for f in fits if f["L"] != max(system_sizes)]
        primary = primary_fits[0]
        lambda_c = float(np.mean([f["lc"] for f in primary_fits]))
        se_all = [f["se_lc"] for f in primary_fits if np.isfinite(f["se_lc"])]
        se_lc = float(np.max(se_all)) if se_all else 0.04
        lam_top = max(lambda_scan)
        lc_low = lam_top  # hard lower bound: decay observed at top of scan
        # upper bound: fit uncertainty, cross-check spread, or a 0.04 floor
        lc_high = float(max(lambda_c + 1.96 * se_lc,
                            max([f["lc"] for f in cross_fits] + [lambda_c + 0.04])))
        nu_ok = [f for f in primary_fits if f["nu"] < 2.95]  # drop degenerate
        nu_par = float(np.mean([f["nu"] for f in nu_ok])) if nu_ok else np.nan
        se_nu_list = [f["se_nu"] for f in nu_ok if np.isfinite(f["se_nu"])]
        se_nu = (float(np.sqrt(np.mean(np.array(se_nu_list) ** 2)))
                 if se_nu_list else 0.3)
        r2_primary = primary["r2"]
        cross_desc = ("; L=" + str(sorted({f['L'] for f in cross_fits})[0])
                      + " fits are cross-checks" if cross_fits else "")
        notes.append(
            f"lambda_c: density-ratio fits log S = d + c*(lambda_c-lambda)^nu_par "
            f"give lambda_c = " +
            "; ".join(f"L={f['L']}, t in {f['window']}: {f['lc']:.4f} "
                      f"(se {f['se_lc']:.3f}, nu_par {f['nu']:.2f}, r2 {f['r2']:.3f}"
                      + (", degenerate (nu at bound), used as cross-check only"
                         if f["nu"] >= 2.95 else "") + ")"
                      for f in fits) +
            f". Primary estimate from L={max(system_sizes)} fits" + cross_desc +
            ". The threshold lies at/just above the top of "
            "the scan (the whole scan is subcritical), so lambda_c is reported as "
            f"{lambda_c:.4f} with CI [{lc_low:.3f}, {lc_high:.3f}]. "
            f"nu_par = {nu_par:.3f} +/- {se_nu:.3f} (DP: {NU_PAR_DP})."
        )

    # ------------------------------------------------------------------
    # 5. Quasi-stationary extraction (per run, L <= 128) and beta / delta
    # ------------------------------------------------------------------
    qss = {}
    qss_T = {}
    for li in range(n_lam):
        for j in range(n_L):
            if system_sizes[j] > 128:
                qss[(li, j)] = (np.nan, 0)
                qss_T[(li, j)] = (np.nan, 0)
                continue
            vals, Ts = [], []
            for s in range(n_seeds):
                T, q = qss_extract(rho_all[(li, j)][s])
                if np.isfinite(q):
                    vals.append(q)
                    Ts.append(T)
            qss[(li, j)] = (float(np.mean(vals)) if vals else np.nan, len(vals))
            qss_T[(li, j)] = (float(np.median(Ts)) if Ts else np.nan, len(Ts))

    beta_est, beta_se, beta_r2, beta_n = fit_beta_qss(lambda_scan, qss, lambda_c, notes)
    beta_low = beta_est - 1.96 * beta_se if np.isfinite(beta_se) else np.nan
    beta_high = beta_est + 1.96 * beta_se if np.isfinite(beta_se) else np.nan

    # per-lambda L-slope diagnostic on the protocol beta_fit_lambdas (late window)
    per_lambda_beta = {}
    excluded_lambdas = []
    for lam in beta_fit_lambdas:
        li = min(range(n_lam), key=lambda i: abs(lambda_scan[i] - lam))
        vals = [(system_sizes[j], rho_ss_grid[li, j]) for j in range(n_L)]
        valid = [(L, v) for L, v in vals if v > 1e-6]
        if len(valid) < 3:
            excluded_lambdas.append(lam)
            continue
        slope, se, r2 = loglog_slope([v[0] for v in valid], [v[1] for v in valid])
        per_lambda_beta[lam] = {"beta": -slope, "se": se, "r2": r2, "n": len(valid)}
    if excluded_lambdas:
        notes.append(
            f"beta per-lambda L-slope diagnostic: lambda(s) {excluded_lambdas} "
            "excluded (rho_ss ~ 0); not forced into any fit."
        )

    delta_qss, delta_qss_se, delta_qss_r2, delta_qss_n = fit_delta_qss(
        lambda_scan, system_sizes, qss, notes)

    # ------------------------------------------------------------------
    # 6. Diagnostic probe at lambda = lambda_c (extended t, budget allows)
    # ------------------------------------------------------------------
    probe = None
    if np.isfinite(lambda_c):
        lam_c = round(float(lambda_c), 4)
        out_rho, out_alive = {}, {}
        for j, L in enumerate(system_sizes):
            proc = Process(L, dt, wL, wR, pe, po)
            rr, aa = proc.simulate_multi([lam_c], PROBE_T_MAX, seed, n_seeds)
            out_rho[L] = rr[0]
            out_alive[L] = aa[0]
        probe_qss = {}
        for L in (32, 64):
            vals, Ts = [], []
            for s in range(n_seeds):
                T, q = qss_extract(out_rho[L][s], t_min=400)
                if np.isfinite(q):
                    vals.append(q)
                    Ts.append(T)
            probe_qss[L] = (float(np.mean(vals)) if vals else np.nan, len(vals))
        delta_probe = np.nan
        if all(np.isfinite(probe_qss[L][0]) and probe_qss[L][0] > 1e-6 for L in (32, 64)):
            slope, se, r2 = loglog_slope([32, 64],
                                         [probe_qss[32][0], probe_qss[64][0]])
            delta_probe = -slope
        P_end = {L: float(out_alive[L][:, -1].mean()) for L in system_sizes}
        rho_end = {L: float(out_rho[L][:, PROBE_T_MAX - 1].mean()) for L in system_sizes}
        probe = {"lambda": lam_c, "t": PROBE_T_MAX, "qss": probe_qss,
                 "delta": delta_probe, "P_end": P_end, "rho_end": rho_end}
        notes.append(
            f"probe at lambda={lam_c}, t={PROBE_T_MAX}: P_surv = "
            + ", ".join(f"L={L}: {P_end[L]:.3f}" for L in system_sizes)
            + "; rho = " + ", ".join(f"L={L}: {rho_end[L]:.3f}" for L in system_sizes)
            + "; QSS densities L=32/64: "
            + (f"{probe_qss[32][0]:.3f} ({probe_qss[32][1]}/16), "
               f"{probe_qss[64][0]:.3f} ({probe_qss[64][1]}/16)"
               if probe_qss else "n/a")
            + (f"; delta from L=32/64 QSS: {delta_probe:.3f}" if np.isfinite(delta_probe) else "")
            + ". Consistent with the threshold sitting at/just above the scan top."
        )

    # combine delta estimates: the lambda_c probe (rho_QSS(L) ~ L^-delta exactly
    # at the critical point) is the primary estimator; the pooled subcritical
    # QSS L-scaling is a cross-check (at fixed subcritical lambda the scaling
    # function also varies with L, biasing its slope).
    probe_d = (probe["delta"]
               if (probe is not None and np.isfinite(probe["delta"])) else np.nan)
    if np.isfinite(probe_d):
        delta_est = float(probe_d)
        bounds = [(probe_d - 0.1, probe_d + 0.1)]  # 2-point measurement, no SE
        if np.isfinite(delta_qss):
            s = delta_qss_se if np.isfinite(delta_qss_se) else 0.1
            bounds.append((delta_qss - 1.96 * s, delta_qss + 1.96 * s))
        delta_low = float(min(b[0] for b in bounds))
        delta_high = float(max(b[1] for b in bounds))
    elif np.isfinite(delta_qss):
        delta_est = float(delta_qss)
        s = delta_qss_se if np.isfinite(delta_qss_se) else 0.1
        delta_low, delta_high = delta_est - 1.96 * s, delta_est + 1.96 * s
    else:
        delta_est, delta_low, delta_high = np.nan, np.nan, np.nan
        notes.append("delta: no valid estimator.")

    # ------------------------------------------------------------------
    # 7. Dynamic diagnostics (t_q, collapse) and dynamic-scale decision
    # ------------------------------------------------------------------
    dyn = dynamic_diagnostics(rho_all, rho_ss_grid, lambda_scan, beta_fit_lambdas,
                              system_sizes, lambda_c,
                              beta_est if np.isfinite(beta_est) else BETA_DP,
                              t_max, notes)

    cross_ok = (all(abs(f["lc"] - primary["lc"]) <= 0.05 for f in cross_fits)
                if (fits and primary is not None) else False)
    dynamic_ok = bool(np.isfinite(nu_par) and NU_PAR_WINDOW[0] <= nu_par <= NU_PAR_WINDOW[1]
                      and r2_primary >= 0.9 and cross_ok)
    z_est = float(nu_par / NU_PERP) if dynamic_ok else np.nan
    z_low = float((nu_par - 1.96 * se_nu) / NU_PERP) if dynamic_ok else np.nan
    z_high = float((nu_par + 1.96 * se_nu) / NU_PERP) if dynamic_ok else np.nan

    # ------------------------------------------------------------------
    # 8. Decision rule (pre-registered)
    # ------------------------------------------------------------------
    static_ok = bool(np.isfinite(beta_est) and BETA_WINDOW[0] <= beta_est <= BETA_WINDOW[1]
                     and np.isfinite(delta_est) and DELTA_WINDOW[0] <= delta_est <= DELTA_WINDOW[1])
    universality_supported = bool(static_ok and dynamic_ok)
    conclusion = ("consistent_with_directed_percolation"
                  if (static_ok and dynamic_ok) else "inconclusive")
    tau_q_half = None  # no resolved curve collapse -> not reported (per contract)

    # ------------------------------------------------------------------
    # 9. dp_summary.csv
    # ------------------------------------------------------------------
    summary = pd.DataFrame([{
        "task_id": task_id,
        "lambda_c_estimate": round(lambda_c, 6) if np.isfinite(lambda_c) else np.nan,
        "lambda_c_ci_low": round(lc_low, 6) if np.isfinite(lc_low) else np.nan,
        "lambda_c_ci_high": round(lc_high, 6) if np.isfinite(lc_high) else np.nan,
        "beta_estimate": round(beta_est, 6) if np.isfinite(beta_est) else np.nan,
        "beta_ci_low": round(beta_low, 6) if np.isfinite(beta_low) else np.nan,
        "beta_ci_high": round(beta_high, 6) if np.isfinite(beta_high) else np.nan,
        "delta_estimate": round(delta_est, 6) if np.isfinite(delta_est) else np.nan,
        "z_estimate": round(z_est, 6) if np.isfinite(z_est) else np.nan,
        "n_seeds": n_seeds,
        "t_max": t_max,
        "collapse_success": dyn["collapse_success"],
    }])
    summary.to_csv(os.path.join(RESULTS_DIR, "dp_summary.csv"), index=False,
                   na_rep="NaN")

    # ------------------------------------------------------------------
    # 10. dp_report.json
    # ------------------------------------------------------------------
    method_summary = (
        "Monte Carlo simulation of the input-defined asymmetric parity-modulated "
        "nearest-neighbor birth-death process (random-sequential updates, periodic "
        f"BC, fully active IC, dt={dt}, wL={wL}, wR={wR}, parity even/odd={pe}/{po}; "
        f"one sweep = L random site visits; {n_seeds} seeds per (lambda, L), base "
        f"seeds protocol.seed+i, i=0..{n_seeds-1}; common random numbers across "
        "lambda for a given (L, seed_idx)). rho_ss = mean of rho(t) over the late "
        f"window t in ({0.8*t_max:.0f}, {t_max}], identical for every scan point. "
        "Key finding: the scan lies on the SUBCRITICAL side of the threshold "
        "(the density is still decaying at t_max at every scan point and the "
        "smallest system is almost always dead), so the analysis uses "
        "subcritical observables. lambda_c: divergence of the relaxation time, "
        "fitted as log S(lambda) = d + c*(lambda_c-lambda)^nu_par with the density "
        "ratio S = rho(t1)/rho(t2) (windows t1=200,400; t2=1000; L=256 primary, "
        "L=128 cross-check); nu_par is the correlation-time exponent and z = "
        f"nu_par/nu_perp with nu_perp fixed at the DP value {NU_PERP}. beta: "
        "quasi-stationary (QSS) density of the small systems (per-run death time "
        "T, QSS = mean rho over [0.3T, 0.8T]) vs (lambda_c-lambda); declared not "
        "resolvable when the QSS sits in the finite-size crossover. delta: pooled "
        "L-scaling of the QSS density (rho_QSS ~ L^-delta) plus a diagnostic "
        f"probe at lambda=lambda_c extended to t={PROBE_T_MAX} (within the 6 CPU-h "
        "budget). z: from the relaxation-time divergence (primary) plus a "
        f"scaled-curve collapse rho*L^beta vs t/L^{Z_DP} (secondary diagnostic, "
        "window t in [max(L,50), 0.8*t_max]); the collapse is accepted only if "
        "the quality metric >= 0.4 and the t_q L-slope is in [1.2, 2.4], "
        "otherwise it is reported as unresolved (tau_q_half = null, z not forced "
        "by the collapse)."
    )

    note_bits = []
    if fits:
        ztxt = (f"z=nu_par/nu_perp={z_est:.3f} (CI [{z_low:.2f}, {z_high:.2f}])"
                if np.isfinite(z_est) else "z not asserted (dynamic criteria not met).")
        note_bits.append(
            "Relaxation-time divergence: "
            + "; ".join(f"L={f['L']}, t in {f['window']}: lambda_c={f['lc']:.4f}, "
                        f"nu_par={f['nu']:.3f}, r2={f['r2']:.3f}" for f in fits)
            + f". Combined: lambda_c={lambda_c:.4f} CI [{lc_low:.3f}, {lc_high:.3f}] "
            f"(lower bound = top of scan, hard); nu_par={nu_par:.3f}+/-{se_nu:.3f} "
            f"(DP {NU_PAR_DP}); {ztxt}."
        )
    note_bits.append(
        f"Static exponents: beta={'NOT resolvable (NaN)' if not np.isfinite(beta_est) else f'{beta_est:.3f} CI [{beta_low:.3f}, {beta_high:.3f}]'} "
        f"(DP {BETA_DP}); delta={delta_est:.3f} CI [{delta_low:.3f}, {delta_high:.3f}] "
        f"(DP {DELTA_DP}; primary = lambda_c probe rho_QSS(L)~L^-delta"
        + (f" = {probe['delta']:.3f}" if probe is not None and np.isfinite(probe['delta']) else " (unavailable)")
        + f"; cross-check pooled QSS L-scaling = {delta_qss if np.isfinite(delta_qss) else float('nan'):.3f} "
        + f"(n={delta_qss_n}, r2={delta_qss_r2:.2f})). Per-lambda L-slope diagnostics on beta_fit_lambdas (late window; "
        "meaningless as beta here because the late density is a transient that "
        "INCREASES with L): "
        + ("; ".join(f"lambda={k}: slope={-v['beta']:.3f} (r2={v['r2']:.2f})"
                     for k, v in per_lambda_beta.items())
           if per_lambda_beta else "none computable") + "."
    )
    tq_desc = "; ".join(
        f"lambda={lam}: " + ", ".join(
            (f"L={L}: {tq:.0f}" if np.isfinite(tq) else f"L={L}: >t_max")
            for L, tq in [(L, dyn['tq'][(lam, L)]) for L in system_sizes])
        for lam in beta_fit_lambdas)
    note_bits.append(
        f"Dynamic diagnostics: t_q (first t with rho<=rho_ss/2): {tq_desc} "
        f"({dyn['n_valid_tq']} valid); scaled-curve collapse metric="
        f"{dyn['metric'] if np.isfinite(dyn['metric']) else float('nan'):.3f}, "
        f"t_q L-slope={dyn['z_from_L'] if np.isfinite(dyn['z_from_L']) else float('nan'):.3f} "
        "-> strict collapse " + ("resolved" if dyn["collapse_success"] else "NOT resolved") +
        " (the scaled-time windows barely overlap across L for t_max=1000, L<=256). "
        "The relaxation-time divergence (above) is the primary dynamic evidence: it "
        "is consistent with DP but weakly constrained (wide error bars)."
    )
    psm = surv_grid[:, 0]
    note_bits.append(
        f"Smallest system (L={system_sizes[0]}): survival at t_max spans "
        f"[{psm.min():.3f}, {psm.max():.3f}] across the scan -> almost always DEAD "
        "(not an intermediate regime); its QSS death times are nearly lambda-"
        "independent (median ~"
        + (f"{np.nanmedian([qss_T[(li, 0)][0] for li in range(n_lam) if np.isfinite(qss_T[(li, 0)][0])]):.0f}"
           if any(np.isfinite(qss_T[(li, 0)][0]) for li in range(n_lam)) else "n/a")
        + " sweeps), i.e. L=32 is effectively critical over the whole scan "
        "(L <= xi(lambda)), which is why its QSS density is flat and beta is not "
        "resolvable there."
    )
    note_bits.append(
        f"Decision: static_evidence_consistent={static_ok} (requires beta in "
        f"{BETA_WINDOW} and delta in {DELTA_WINDOW}; beta is not resolvable "
        "because the protocol scan does not cross the threshold); "
        f"dynamic_scale_observed={dynamic_ok} (relaxation-time divergence "
        "consistent with DP nu_par, weakly constrained); "
        f"universality_supported={universality_supported}; conclusion='{conclusion}'. "
        + (f"The observed behavior (threshold at/just above the scan top, "
         f"nu_par ~ {nu_par:.2f} vs DP {NU_PAR_DP:.3f}, "
         f"delta ~ {delta_est:.2f} vs DP {DELTA_DP:.3f}"
         + (f", z ~ {z_est:.2f} vs DP {Z_DP:.3f}" if np.isfinite(z_est) else "")
         + ", flat effectively-critical QSS of small systems) is qualitatively "
         "DP-like, but with beta inaccessible and the dynamic constraints weak "
         "under this budget, an inconclusive universality conclusion is the "
         "honest reading.")
    )
    assessment_note = " ".join(notes) + " " + " ".join(note_bits)

    report = {
        "task_id": task_id,
        "model": ("1D asymmetric parity-modulated nearest-neighbor birth-death "
                  "process: binary sites, absorbing all-inactive state, periodic "
                  "BC, fully active IC, random-sequential updates (one sweep = L "
                  f"random site visits), active-site death probability dt={dt} per "
                  f"visit, inactive-site activation "
                  f"p_birth=min(1, lambda*dt*parity(i)*(wL*left+wR*right)) with "
                  f"wL={wL}, wR={wR}, parity even/odd = {pe}/{po}."),
        "method_summary": method_summary,
        "evidence": {
            "collapse_success": dyn["collapse_success"],
            "universality_supported": universality_supported,
            "static_evidence_consistent": static_ok,
            "dynamic_scale_observed": dynamic_ok,
            "z_q_used": Z_DP,
            "tau_q_half": tau_q_half,
            "assessment_note": assessment_note,
        },
        "conclusion": conclusion,
    }
    with open(os.path.join(RESULTS_DIR, "dp_report.json"), "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, ensure_ascii=False)

    # console summary
    print("=== dp analysis summary ===")
    print(f"lambda_c = {lambda_c:.4f}  CI [{lc_low:.4f}, {lc_high:.4f}]  (scan top {max(lambda_scan)})")
    for f in fits:
        print(f"  ratio fit L={f['L']} window={f['window']}: lc={f['lc']:.4f} nu={f['nu']:.3f} r2={f['r2']:.3f}")
    print(f"nu_par = {nu_par:.4f} +/- {se_nu:.3f}  ->  z = {z_est if np.isfinite(z_est) else float('nan'):.3f}")
    print(f"beta = {'NaN (not resolvable)' if not np.isfinite(beta_est) else f'{beta_est:.4f} CI [{beta_low:.3f}, {beta_high:.3f}]'}")
    for k, v in per_lambda_beta.items():
        print(f"  per-lambda L-slope lambda={k}: slope={-v['beta']:.3f} r2={v['r2']:.2f}")
    print(f"delta = {delta_est:.4f}  CI [{delta_low:.4f}, {delta_high:.4f}]")
    print(f"collapse_success={dyn['collapse_success']} (metric={dyn['metric']:.3f}) "
          f"dynamic_ok={dynamic_ok} static_ok={static_ok} conclusion={conclusion}")
    print("QSS (L=32/64/128) per lambda:")
    for li, lam in enumerate(lambda_scan):
        print(f"  lam={lam}: " + "  ".join(
            f"L={system_sizes[j]}: {qss[(li, j)][0]:.3f} ({qss[(li, j)][1]}/16)"
            for j in range(3)))
    print("rho_ss grid (lambda rows x L cols):")
    print(np.round(rho_ss_grid, 4))
    print("P_surv(t_max) grid:")
    print(np.round(surv_grid, 3))


if __name__ == "__main__":
    main()
