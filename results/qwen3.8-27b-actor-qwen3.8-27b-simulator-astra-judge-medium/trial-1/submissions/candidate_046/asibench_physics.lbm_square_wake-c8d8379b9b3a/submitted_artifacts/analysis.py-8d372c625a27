#!/usr/bin/env python3
"""
D2Q9 LBM (BGK) simulation of a square solid obstacle in a 2D channel.

Reads ./data/task_input.json (only input source) and writes:
  ./results/fluid_summary.csv
  ./results/fluid_force_series.csv
  ./results/fluid_centerline.csv
  ./results/fluid_transverse_profile.csv
  ./results/fluid_report.json

Method:
- D2Q9 lattice, BGK collision, nu = uin * square_size / re, tau = 0.5 + 3*nu.
- Solid: square_size x square_size no-slip cells (half-way bounce-back at
  boundary fluid/solid interface via solid-node reflection).
- Force: momentum exchange at the solid interface,
  F = sum over solid nodes s, directions i of e_i * (f_i^streamed(s) - f_opp(i)^streamed(s)).
- Inlet x=0: Zou-He with fixed velocity u = (uin, 0) (u_y extrapolation from x=1 was tested but is numerically unstable for this channel).
- Outlet x=nx-1: zero-gradient extrapolation (copy from x=nx-2).
- Top/bottom y=0, y=ny-1: no-slip bounce-back (bounded channel).
- Initial field: rho=1, u=(uin,0) in fluid, u=0 in solid.
- Sampling: 0-indexed step i in [0, n_steps); exclude i < warmup_steps;
  sample when (i - warmup_steps) % sample_every == 0.
"""
import json
import os

import numpy as np
import pandas as pd

# ---------------------------------------------------------------- D2Q9 setup
EX = np.array([0, 1, -1, 0, 0, 1, -1, 1, -1], dtype=np.int64)
EY = np.array([0, 0, 0, 1, -1, 1, 1, -1, -1], dtype=np.int64)
W = np.array([4 / 9, 1 / 9, 1 / 9, 1 / 9, 1 / 9, 1 / 36, 1 / 36, 1 / 36, 1 / 36])
OPP = np.array([0, 2, 1, 4, 3, 8, 7, 6, 5], dtype=np.int64)

# Zou-He 3x3 linear system for unknowns (f2, f6, f8) at the inlet
M_ZH = np.array([
    [1.0, 1.0, 1.0],
    [-1.0, 0.0, -1.0],
    [0.0, 1.0, -1.0],
])
MINV_ZH = np.linalg.inv(M_ZH)


def eq_pop(rho, ux, uy):
    """Equilibrium populations (9, nx, ny) from rho, ux, uy fields."""
    eu = EX[:, None, None] * ux + EY[:, None, None] * uy  # e_i . u (9, nx, ny)
    u2 = ux * ux + uy * uy
    feq = W[:, None, None] * rho * (1.0 + 3.0 * eu + 4.5 * eu * eu - 1.5 * u2)
    return feq


def simulate(case):
    nx, ny = int(case["nx"]), int(case["ny"])
    uin = float(case["uin"])
    re = float(case["re"])
    cx, cy = (int(v) for v in case["square_center"])
    L = int(case["square_size"])
    n_steps = int(case["n_steps"])
    warmup = int(case["warmup_steps"])
    sample_every = int(case["sample_every"])

    nu = uin * L / re
    tau = 0.5 + 3.0 * nu
    inv_tau = 1.0 / tau

    # solid mask clipped to domain
    half = L // 2
    x0, x1 = max(0, cx - half), min(nx, cx - half + L)
    y0, y1 = max(0, cy - half), min(ny, cy - half + L)
    solid = np.zeros((nx, ny), dtype=bool)
    solid[x0:x1, y0:y1] = True
    fluid = ~solid

    # initial field: rho=1, u=(uin,0) fluid, u=0 solid
    ux0 = np.where(solid, 0.0, uin)
    uy0 = np.zeros((nx, ny))
    f = eq_pop(np.ones((nx, ny)), ux0, uy0)

    # precompute roll shifts per direction
    force_samples = []  # (step, Fx, Fy)

    for i in range(n_steps):
        # ---- collision (BGK)
        rho = f.sum(axis=0)
        ux = f[1] + f[5] + f[7] - f[2] - f[6] - f[8]
        uy = f[3] + f[5] + f[6] - f[4] - f[7] - f[8]
        uxs = ux / rho
        uys = uy / rho
        feq = eq_pop(rho, uxs, uys)
        f = f + (feq - f) * inv_tau

        # ---- streaming
        nf = np.empty_like(f)
        nf[0] = f[0]  # rest population does not stream
        for d in range(1, 9):
            nf[d] = np.roll(f[d], (EX[d], EY[d]), (0, 1))

        # outlet (x = nx-1): zero-gradient extrapolation
        nf[:, nx - 1, :] = nf[:, nx - 2, :]

        # snapshot post-stream populations (before any reflection overwrites)
        pre = nf.copy()

        # top/bottom no-slip: half-way bounce-back (post-stream values)
        for d in range(1, 9):
            nf[d, :, 0] = pre[OPP[d], :, 0]
            nf[d, :, ny - 1] = pre[OPP[d], :, ny - 1]

        # inlet (x = 0): Zou-He with fixed velocity u = (uin, 0).
        # (The u_y-extrapolated-from-x=1 variant was tested and is numerically
        #  unstable for this channel: it amplifies the developing wall-layer
        #  u_y perturbation and diverges by ~step 600, so the inlet transverse
        #  velocity is fixed to 0, its mean value by symmetry.)
        rho0 = nf[:, 0, :].sum(axis=0)
        b0 = rho0 - (nf[0, 0, :] + nf[1, 0, :] + nf[3, 0, :]
                     + nf[4, 0, :] + nf[5, 0, :] + nf[7, 0, :])
        b1 = rho0 * uin - (nf[1, 0, :] + nf[5, 0, :] + nf[7, 0, :])
        b2 = -(nf[3, 0, :] - nf[4, 0, :] + nf[5, 0, :] - nf[7, 0, :])
        sol = MINV_ZH @ np.array([b0, b1, b2])  # (3, ny)
        nf[2, 0, :], nf[6, 0, :], nf[8, 0, :] = sol[0], sol[1], sol[2]

        # ---- solid: momentum exchange from post-stream snapshot, then reflect
        Fx = 0.0
        Fy = 0.0
        for d in range(1, 9):
            s_d = pre[d][solid]
            r_d = pre[OPP[d]][solid]
            Fx += EX[d] * np.sum(s_d - r_d)
            Fy += EY[d] * np.sum(s_d - r_d)
            nf[d][solid] = r_d

        f = nf

        # ---- sampling window (0-indexed step, post-warmup only)
        if i >= warmup and (i - warmup) % sample_every == 0:
            force_samples.append((i, Fx, Fy))

    # ---- final field
    rho = f.sum(axis=0)
    u = (f[1] + f[5] + f[7] - f[2] - f[6] - f[8]) / rho
    v = (f[3] + f[5] + f[6] - f[4] - f[7] - f[8]) / rho

    scale = 0.5 * uin ** 2 * L
    cd = np.array([Fx / scale for _, Fx, _ in force_samples])
    cl = np.array([Fy / scale for _, _, Fy in force_samples])

    cd_mean = float(np.mean(cd))
    cl_rms = float(np.sqrt(np.mean(cl ** 2)))
    last100 = np.mean(cd[-100:]) if len(cd) >= 100 else np.mean(cd)
    converged = int(abs(last100 - cd_mean) / max(abs(cd_mean), 1e-30) < 0.05)

    centerline_u = u[:, cy].copy()
    centerline_u[solid[:, cy]] = 0.0

    x_probe = min(nx - 1, cx + 2 * L)

    return {
        "case_id": case["case_id"],
        "nx": nx, "ny": ny, "re": re, "uin": uin,
        "nu": nu, "tau": tau, "n_steps": n_steps,
        "cd_mean": cd_mean, "cl_rms": cl_rms, "converged": converged,
        "steps": np.array([s for s, _, _ in force_samples], dtype=int),
        "cd": cd, "cl": cl,
        "centerline_u": centerline_u,
        "x_probe": x_probe,
        "profile_u": u[x_probe, :], "profile_v": v[x_probe, :],
    }


def main():
    with open("./data/task_input.json", "r", encoding="utf-8-sig") as fh:
        inp = json.load(fh)

    results_dir = "./results"
    os.makedirs(results_dir, exist_ok=True)

    summaries = []
    series_rows = []
    center_rows = []
    trans_rows = []

    for case in inp["cases"]:
        r = simulate(case)
        summaries.append({
            "case_id": r["case_id"], "nx": r["nx"], "ny": r["ny"],
            "re": r["re"], "uin": r["uin"], "nu": r["nu"], "tau": r["tau"],
            "n_steps": r["n_steps"], "cd_mean": r["cd_mean"],
            "cl_rms": r["cl_rms"], "converged": r["converged"],
        })
        for s, cd, cl in zip(r["steps"], r["cd"], r["cl"]):
            series_rows.append({"case_id": r["case_id"], "step": int(s),
                                "cd": float(cd), "cl": float(cl)})
        for x in range(r["nx"]):
            center_rows.append({"case_id": r["case_id"], "x": x,
                                "u": float(r["centerline_u"][x])})
        for y in range(r["ny"]):
            trans_rows.append({"case_id": r["case_id"], "x_probe": r["x_probe"],
                               "y": y, "u": float(r["profile_u"][y]),
                               "v": float(r["profile_v"][y])})
        print(f"[done] {r['case_id']}: cd_mean={r['cd_mean']:.6f} "
              f"cl_rms={r['cl_rms']:.6f} converged={r['converged']} "
              f"samples={len(r['steps'])}")

    df_sum = pd.DataFrame(summaries, columns=[
        "case_id", "nx", "ny", "re", "uin", "nu", "tau", "n_steps",
        "cd_mean", "cl_rms", "converged"])
    df_ser = pd.DataFrame(series_rows, columns=["case_id", "step", "cd", "cl"])
    df_cen = pd.DataFrame(center_rows, columns=["case_id", "x", "u"])
    df_tr = pd.DataFrame(trans_rows, columns=["case_id", "x_probe", "y", "u", "v"])

    df_sum.to_csv(os.path.join(results_dir, "fluid_summary.csv"), index=False)
    df_ser.to_csv(os.path.join(results_dir, "fluid_force_series.csv"), index=False)
    df_cen.to_csv(os.path.join(results_dir, "fluid_centerline.csv"), index=False)
    df_tr.to_csv(os.path.join(results_dir, "fluid_transverse_profile.csv"), index=False)

    cd_mean_avg = float(df_sum["cd_mean"].mean())
    report = {
        "task_id": inp.get("task_id", "fluid-square-wake-2d-001"),
        "units": inp.get("units", "dimensionless"),
        "cd_mean_avg": cd_mean_avg,
        "method_summary": (
            "D2Q9 lattice Boltzmann method with BGK collision (tau = 0.5 + 3*nu, "
            "nu = uin*square_size/re). Square solid region (square_size x square_size "
            "no-slip cells) treated with half-way bounce-back; force from momentum "
            "exchange at the solid interface, cd = Fx/(0.5*uin^2*square_size), "
            "cl = Fy/(0.5*uin^2*square_size). Inlet: Zou-He with fixed velocity u = (uin, 0) "
            "(u_y extrapolation from x=1 was tested but is numerically unstable for this "
            "channel); outlet: zero-gradient extrapolation; top and "
            "bottom walls: no-slip bounce-back. Initial field rho=1, u=(uin,0). "
            "Force samples at 0-indexed steps i >= warmup_steps with "
            "(i - warmup_steps) % sample_every == 0. cd_mean = mean of cd over the "
            "sampled window; cl_rms = sqrt(mean(cl^2)); converged = 1 if "
            "|mean(cd, last 100 samples) - cd_mean| / |cd_mean| < 0.05, else 0. "
            "Centerline profile along y = square_center_y (u=0 in solid cells); "
            "transverse profile at x_probe = min(nx-1, cx + 2*square_size)."),
    }
    with open(os.path.join(results_dir, "fluid_report.json"), "w",
              encoding="utf-8") as fh:
        json.dump(report, fh, indent=2)

    # ---- contract self-checks
    input_ids = [c["case_id"] for c in inp["cases"]]
    assert list(df_sum["case_id"]) == input_ids, "summary case set mismatch"
    assert list(df_ser["case_id"].unique()) == input_ids
    assert list(df_cen["case_id"].unique()) == input_ids
    assert list(df_tr["case_id"].unique()) == input_ids
    for c in inp["cases"]:
        cid = c["case_id"]
        n_sum = int((df_sum["case_id"] == cid).sum())
        n_cen = int((df_cen["case_id"] == cid).sum())
        n_tr = int((df_tr["case_id"] == cid).sum())
        n_ser = int((df_ser["case_id"] == cid).sum())
        assert n_sum == 1, f"{cid}: summary rows {n_sum} != 1"
        assert n_cen == c["nx"], f"{cid}: centerline rows {n_cen} != nx"
        assert n_tr == c["ny"], f"{cid}: transverse rows {n_tr} != ny"
        assert n_ser >= 10, f"{cid}: force series rows {n_ser} < 10"
    for name, df in [("summary", df_sum), ("series", df_ser),
                     ("centerline", df_cen), ("transverse", df_tr)]:
        vals = df.select_dtypes(include=[np.number]).to_numpy()
        assert np.isfinite(vals).all(), f"non-finite values in {name}"
    print("All contract self-checks passed.")
    print(f"cd_mean_avg = {cd_mean_avg:.6f}")


if __name__ == "__main__":
    main()
