def _put_text(buf, x, y, s, color, scale=1):
    for ch in str(s).upper():
        g = _FONT57.get(ch)
        if g is None:
            x += 6 * scale
            continue
        rows = g.split()
        for r in range(7):
            for c in range(5):
                if rows[r][c] == "1":
                    buf[y + r * scale:y + (r + 1) * scale, x + c * scale:x + (c + 1) * scale] = color
        x += 6 * scale


def _put_line(buf, x0, y0, x1, y1, color, width=1):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    n = max(abs(x1 - x0), abs(y1 - y0), 1)
    H, W = buf.shape[:2]
    for i in range(n + 1):
        x = x0 + (x1 - x0) * i // n
        y = y0 + (y1 - y0) * i // n
        if 0 <= y < H and 0 <= x < W:
            buf[max(0, y):min(H, y + width), max(0, x):min(W, x + width)] = color


def _write_png(path, buf):
    import zlib, struct
    h, w, _ = buf.shape
    raw = b"".join(b"\x00" + buf[i].tobytes() for i in range(h))
    def chunk(t, d):
        c = t + d
        return struct.pack(">I", len(d)) + c + struct.pack(">I", zlib.crc32(c) & 0xFFFFFFFF)
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


def _draw_panel(buf, px0, py0, px1, py1, title, series, fill_neg=(), zero=True):
    allx = np.concatenate([s[0] for s in series])
    ally = np.concatenate([s[1] for s in series])
    fin = np.isfinite(allx) & np.isfinite(ally)
    allx, ally = allx[fin], ally[fin]
    xmin, xmax = float(allx.min()), float(allx.max())
    ymin, ymax = float(ally.min()), float(ally.max())
    pad = 0.08 * (ymax - ymin) if ymax > ymin else 1.0
    ymin -= pad
    ymax += pad
    if zero:
        ymin = min(ymin, -0.05)
        ymax = max(ymax, 0.05)
    def X(v):
        return px0 + (v - xmin) / (xmax - xmin) * (px1 - px0)
    def Y(v):
        return py1 - (v - ymin) / (ymax - ymin) * (py1 - py0)
    _put_line(buf, px0, py0, px1, py0, (0, 0, 0))
    _put_line(buf, px0, py1, px1, py1, (0, 0, 0))
    _put_line(buf, px0, py0, px0, py1, (0, 0, 0))
    _put_line(buf, px1, py0, px1, py1, (0, 0, 0))
    if zero:
        _put_line(buf, int(X(xmin)), int(Y(0)), int(X(xmax)), int(Y(0)), (130, 130, 130))
    for v in range(int(np.ceil(xmin / 150) * 150), int(xmax) + 1, 150):
        xx = int(X(v))
        _put_line(buf, xx, py1, xx, py1 + 4, (0, 0, 0))
        lab = str(int(v))
        _put_text(buf, xx - 3 * len(lab), py1 + 8, lab, (0, 0, 0))
    for f in (0.12, 0.4, 0.68, 0.95):
        v = ymin + f * (ymax - ymin)
        yy = int(Y(v))
        _put_line(buf, px0 - 4, yy, px0, yy, (0, 0, 0))
        lab = f"{v:.1f}"
        _put_text(buf, px0 - 5 - 6 * len(lab), yy - 3, lab, (0, 0, 0))
    for xs, ys, color, dash, label in series:
        fin = np.isfinite(xs) & np.isfinite(ys)
        if fin.sum() < 2:
            continue
        xs, ys = xs[fin], ys[fin]
        px = X(xs)
        py = Y(ys)
        i = 0
        while i < len(xs) - 1:
            if dash == 0 or (i // dash) % 2 == 0:
                _put_line(buf, px[i], py[i], px[i + 1], py[i + 1], color)
            i += 1
        if label in fill_neg:
            yz = int(Y(0))
            for k in range(len(xs)):
                if ys[k] < 0:
                    a, b = sorted((yz, int(py[k])))
                    if b > a:
                        seg = buf[a:b + 1, int(px[k])]
                        buf[a:b + 1, int(px[k])] = np.clip(seg.astype(int) + np.array([170, 0, 0]), 0, 255).astype(np.uint8)
    _put_text(buf, px0, py0 - 18, title, (0, 0, 0), scale=2)
    _put_text(buf, px0 + (px1 - px0) // 2 - 3 * len("WAVELENGTH (NM)"), py1 + 26, "WAVELENGTH (NM)", (0, 0, 0))
    ly = py0 + 8
    for s in series:
        _put_line(buf, px1 - 78, ly + 3, px1 - 56, ly + 3, s[2], width=2)
        _put_text(buf, px1 - 52, ly - 3, s[4], (0, 0, 0))
        ly += 15


