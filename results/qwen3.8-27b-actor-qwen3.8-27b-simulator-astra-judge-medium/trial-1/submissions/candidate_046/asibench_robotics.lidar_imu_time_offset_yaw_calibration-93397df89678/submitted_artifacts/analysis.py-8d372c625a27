def make_figure_fallback():
    """PIL-based renderer for environments without matplotlib."""
    import os
    import subprocess
    import sys

    def dec(a, b, n):
        idx = np.linspace(0, len(a) - 1, min(n, len(a))).astype(int)
        return [float(a[i]) for i in idx], [float(b[i]) for i in idx]

    t1_, w1_ = dec(t_imu[::4], omega[::4], 1600)
    t2g, y2g = dec(t_scan_mid, gyro_yaw_at_mids, 1200)
    t2l, y2l = dec(t_scan_mid[1:], yaw_lidar[1:], 854)
    data = {"W": 1300, "H": 900, "panels": [
        {"title": "Gyro stream + fitted bias", "xlabel": "t (s)",
         "ylabel": "omega_z (rad/s)",
         "xlim": [float(t_imu[0]), float(t_imu[-1])],
         "ylim": [float(omega.min()) - 0.02, float(omega.max()) + 0.02],
         "lines": [{"x": t1_, "y": w1_, "color": "blue", "w": 1},
                   {"x": [0.0, 94.0], "y": [bias_hat, bias_hat],
                    "color": "red", "dash": [8, 5]}],
         "legend": [("gyro stream", "blue"),
                    (f"fit bias = {bias_hat:.5f} rad/s", "red")]},
        {"title": "Integrated yaw: gyro vs LiDAR", "xlabel": "t (s)",
         "ylabel": "integrated yaw (rad)",
         "xlim": [0.0, 94.0],
         "ylim": [min(float(yaw_lidar.min()), float(gyro_yaw_at_mids.min())) - 0.3,
                  max(float(yaw_lidar.max()), float(gyro_yaw_at_mids.max())) + 0.3],
         "lines": [{"x": t2l, "y": y2l, "color": "green", "w": 2},
                   {"x": t2g, "y": y2g, "color": "blue", "w": 1}],
         "legend": [("LiDAR (cum. dyaw)", "green"),
                    (f"gyro (bias/offset removed, tau={tau_hat*1000:.2f} ms)", "blue")]},
        {"title": f"Yaw residuals (train RMS {rms_tr_y:.4f}, held-out RMS {rms_ho_y:.4f})",
         "xlabel": "t (s)", "ylabel": "residual yaw (rad)",
         "xlim": [0.0, 94.0],
         "ylim": [-0.02, 0.02],
         "scatter": [{"x": [float(v) for v in t_scan_mid[train]],
                      "y": [float(v) for v in r_yaw_tr], "color": "blue", "r": 2},
                     {"x": [float(v) for v in t_scan_mid[heldout]],
                      "y": [float(v) for v in r_yaw_ho], "color": "red", "r": 3}],
         "legend": [f"train (n={int(train.sum())})", ""]},
        {"title": "Translation direction vs fitted extrinsic", "xlabel": "t (s)",
         "ylabel": "direction (rad)",
         "xlim": [0.0, 94.0], "ylim": [-0.5, 0.5],
         "scatter": [{"x": [float(v) for v in t_scan_mid],
                      "y": [float(v) for v in dir_ang], "color": "blue", "r": 2}],
         "lines": [{"x": [0.0, 94.0], "y": [-e_hat, -e_hat],
                    "color": "red", "dash": [8, 5]}],
         "legend": [("translation direction (lidar frame)", "blue"),
                    (f"-e (fit e = {e_hat:.5f} rad)", "red")]},
    ]}
    # fix panel-3 legend (two entries, colors blue/red)
    data["panels"][2]["legend"] = [("train (n=%d)" % int(train.sum()), "blue"),
                                   ("held-out (n=%d)" % int(heldout.sum()), "red")]
    with open("figure_data.json", "w") as f:
        json.dump(data, f)
    with open("_fallback_render.py", "w") as f:
        f.write(_FALLBACK_RENDERER)
    cands = [sys.executable, "/usr/bin/python3", "/usr/bin/python3.14",
             "/usr/bin/python3.12"]
    for py in cands:
        if not os.path.exists(py):
            continue
        r = subprocess.run([py, "_fallback_render.py"],
                           capture_output=True, text=True)
        if r.returncode == 0 and os.path.exists("calibration_diagnostics.png"):
            return
        print("fallback renderer failed with", py, ":", r.stderr[-300:])
    raise RuntimeError("could not render calibration_diagnostics.png "
                       "(no matplotlib, no working PIL interpreter)")


