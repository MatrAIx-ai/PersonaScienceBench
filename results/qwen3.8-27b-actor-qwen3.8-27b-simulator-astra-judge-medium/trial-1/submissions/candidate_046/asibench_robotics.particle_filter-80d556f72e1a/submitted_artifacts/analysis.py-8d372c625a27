class _Canvas:
    """Minimal RGB raster with line/point/text primitives and PNG export."""

    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.buf = np.full((h, w, 3), bg, dtype=np.uint8)

    def disk(self, x, y, r, c):
        r = max(0, int(r))
        xx = np.arange(-r, r + 1)
        yy, xxm = np.meshgrid(xx, xx, indexing="ij")
        m = xxm * xxm + yy * yy <= r * r
        xi = np.clip(int(round(x)) + xxm[m], 0, self.w - 1)
        yi = np.clip(int(round(y)) + yy[m], 0, self.h - 1)
        self.buf[yi, xi] = c

    def line(self, x0, y0, x1, y1, c, w=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        ts = np.linspace(0.0, 1.0, n)
        xs = x0 + (x1 - x0) * ts
        ys = y0 + (y1 - y0) * ts
        r = max(0, w // 2)
        for xi, yi in zip(xs, ys):
            self.disk(xi, yi, r, c)

    def dline(self, x0, y0, x1, y1, c, w=1, dash=7, gap=5):
        L = math.hypot(x1 - x0, y1 - y0)
        if L <= 0:
            return
        ux, uy = (x1 - x0) / L, (y1 - y0) / L
        s = 0.0
        while s < L:
            e = min(s + dash, L)
            self.line(x0 + ux * s, y0 + uy * s, x0 + ux * e, y0 + uy * e, c, w)
            s = e + gap

    def text(self, x, y, s, c, sc=1):
        n = len(s)
        M = np.zeros((5, 7 * n), dtype=np.int8)
        for i, ch in enumerate(s):
            g = _FONT.get(ch, _FONT['?'])
            for row in range(5):
                bits = g[row]
                for col in range(7):
                    M[row, i * 7 + col] = (bits >> (6 - col)) & 1
        M = np.kron(M, np.ones((sc, sc), dtype=np.int8))
        h, w = M.shape
        x0, y0 = int(round(x)), int(round(y))
        x1, y1 = min(x0 + w, self.w), min(y0 + h, self.h)
        if x1 <= x0 or y1 <= y0:
            return
        M = M[: y1 - y0, : x1 - x0]
        self.buf[y0:y1, x0:x1][M == 1] = c

    def text_w(self, s, sc=1):
        return 7 * len(s) * sc - sc

    def save(self, path):
        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data +
                    struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
        raw = b"".join(b"\x00" + self.buf[y].tobytes() for y in range(self.h))
        png = b"\x89PNG\r\n\x1a\n"
        png += chunk(b"IHDR", struct.pack(">IIBBBBB", self.w, self.h, 8, 2, 0, 0, 0))
        png += chunk(b"IDAT", zlib.compress(raw, 9))
        png += chunk(b"IEND", b"")
        with open(path, "wb") as f:
            f.write(png)


def _nice_ticks(lo, hi, n=5):
    span = hi - lo
    if span <= 0:
        return [lo]
    step0 = span / n
    mag = 10.0 ** math.floor(math.log10(step0))
    step = 10.0 * mag
    for m in (1.0, 2.0, 5.0):
        if step0 <= m * mag:
            step = m * mag
            break
    ticks, v = [], math.ceil(lo / step) * step
    while v <= hi + 1e-9:
        ticks.append(round(v, 10))
        v += step
    return ticks


def _fmt(v):
    v = float(v)
    if abs(v) < 1e-12:
        return "0"
    if abs(v) >= 10000 or abs(v) < 0.01:
        return f"{v:.0e}"
    s = f"{v:.4g}"
    return s


def _draw_panel(cv, x, y, w, h, title, xlabel, ylabel, xlim, ylim,
                series, vlines=(), hlines=(), legend=(), logy=False):
    L, R, T, B = 56, 14, 34, 36
    ax0, ay0 = x + L, y + T
    aw, ah = w - L - R, h - T - B

    def X(v):
        return ax0 + (v - xlim[0]) / (xlim[1] - xlim[0]) * aw

    def Y(v):
        if logy:
            vv = np.maximum(np.asarray(v, dtype=float), 1e-300)
            v0 = math.log10(max(ylim[0], 1e-300))
            v1 = math.log10(ylim[1])
            return ay0 + ah - (np.log10(vv) - v0) / (v1 - v0) * ah
        return ay0 + ah - (v - ylim[0]) / (ylim[1] - ylim[0]) * ah

    cv.text(ax0 + aw / 2 - cv.text_w(title, 2) / 2, y + 4, title, (20, 20, 20), 2)
    cv.text(ax0, y + 22, "y: " + ylabel, (90, 90, 90), 1)

    tx = _nice_ticks(xlim[0], xlim[1])
    if logy:
        e0 = int(math.floor(math.log10(ylim[0])))
        e1 = int(math.ceil(math.log10(ylim[1])))
        ty = [10.0 ** i for i in range(e0, e1 + 1)]
    else:
        ty = _nice_ticks(ylim[0], ylim[1])
    for v in tx:
        cv.line(X(v), ay0, X(v), ay0 + ah, (230, 230, 230), 1)
        lab = _fmt(v)
        cv.text(X(v) - cv.text_w(lab, 1) / 2, ay0 + ah + 5, lab, (80, 80, 80), 1)
    for v in ty:
        cv.line(ax0, Y(v), ax0 + aw, Y(v), (230, 230, 230), 1)
        lab = _fmt(v)
        cv.text(ax0 - 6 - cv.text_w(lab, 1), Y(v) - 3, lab, (80, 80, 80), 1)
    for v in (ax0, ax0 + aw):
        cv.line(v, ay0, v, ay0 + ah, (110, 110, 110), 1)
    for v in (ay0, ay0 + ah):
        cv.line(ax0, v, ax0 + aw, v, (110, 110, 110), 1)
    cv.text(ax0 + aw / 2 - cv.text_w(xlabel, 1) / 2, y + h - 12, "x: " + xlabel,
            (90, 90, 90), 1)

    for val, col, dash in vlines:
        cv.dline(X(val), ay0, X(val), ay0 + ah, col, 2, dash, dash)
    for val, col, dash in hlines:
        cv.dline(ax0, Y(val), ax0 + aw, Y(val), col, 2, dash, dash)

    for kind, xs, ys, col, kw in series:
        xs = np.asarray(xs, dtype=float)
        ys = np.asarray(ys, dtype=float)
        ok = np.isfinite(xs) & np.isfinite(ys)
        pxs, pys = X(xs), Y(ys)
        if kind == "line":
            for i in range(len(pxs) - 1):
                if ok[i] and ok[i + 1]:
                    cv.line(pxs[i], pys[i], pxs[i + 1], pys[i + 1], col,
                            kw.get("w", 2))
        elif kind == "pts":
            for i in np.where(ok)[0]:
                cv.disk(pxs[i], pys[i], kw.get("r", 2), col)
        elif kind == "cross":
            s = kw.get("s", 4)
            for i in np.where(ok)[0]:
                cv.line(pxs[i] - s, pys[i] - s, pxs[i] + s, pys[i] + s, col, 2)
                cv.line(pxs[i] - s, pys[i] + s, pxs[i] + s, pys[i] - s, col, 2)

    if legend:
        lh = 13
        bw = int(max(cv.text_w(l[0], 1) for l in legend) + 24)
        bx = int(ax0 + aw - bw - 6)
        by = int(ay0 + 6)
        bh = int(lh * len(legend) + 8)
        cv.buf[by:by + bh, bx:bx + bw] = (255, 255, 255)
        for v in (bx, bx + bw):
            cv.line(v, by, v, by + bh, (160, 160, 160), 1)
        for v in (by, by + bh):
            cv.line(bx, v, bx + bw, v, (160, 160, 160), 1)
        for i, (lab, col, kind) in enumerate(legend):
            yy = by + 8 + i * lh
            if kind == "line":
                cv.line(bx + 4, yy, bx + 16, yy, col, 2)
            elif kind == "pts":
                cv.disk(bx + 10, yy, 2, col)
            else:
                cv.line(bx + 6, yy - 4, bx + 14, yy + 4, col, 2)
                cv.line(bx + 6, yy + 4, bx + 14, yy - 4, col, 2)
            cv.text(bx + 20, yy - 3, lab, (40, 40, 40), 1)


