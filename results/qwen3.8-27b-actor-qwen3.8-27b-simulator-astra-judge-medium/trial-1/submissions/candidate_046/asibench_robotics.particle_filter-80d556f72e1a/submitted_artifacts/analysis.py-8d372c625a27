                        ("PF estimate", (31, 119, 180), "line"),
                        ("outlier", (214, 39, 40), "cross"),
                        ("sensor", (20, 20, 20), "cross")])

    xr = t[mask[:, 0]]
    yr_ = Y[mask[:, 0], 0]
    hr = np.hypot(px, py) + bias_r[-1]
    lo = min(yr_.min(), hr.min())
    hi = max(yr_.max(), hr.max())
    pad = (hi - lo) * 0.1
    _draw_panel(cv, pos[1][0], pos[1][1], pw, ph, "Range channel", "t", "range",
                (t.min(), t.max()), (lo - pad, hi + pad),
                [("pts", xr, yr_, (31, 119, 180), {"r": 2}),
                 ("cross", t[np.array(outl[0])], Y[np.array(outl[0]), 0],
                  (214, 39, 40), {"s": 4}),
                 ("line", t, hr, (255, 127, 14), {"w": 2})],
                legend=[("range meas", (31, 119, 180), "pts"),
                        ("outlier", (214, 39, 40), "cross"),
                        ("h_r(est)+b_r", (255, 127, 14), "line")])

    xt = t[mask[:, 1]]
    yt_ = Y[mask[:, 1], 1]
    bth = np.arctan2(py, px) + bias_th[-1]
    bth_u = np.concatenate([[bth[0]],
                          bth[0] + np.cumsum(wrap_pi(np.diff(bth)))])
    lo = min(yt_.min(), bth_u.min())
    hi = max(yt_.max(), bth_u.max())
    pad = (hi - lo) * 0.08
    _draw_panel(cv, pos[2][0], pos[2][1], pw, ph, "Bearing channel", "t",
                "bearing [rad]", (t.min(), t.max()), (lo - pad, hi + pad),
                [("pts", xt, yt_, (31, 119, 180), {"r": 2}),
                 ("cross", t[np.array(outl[1])], Y[np.array(outl[1]), 1],
                  (214, 39, 40), {"s": 4}),
                 ("line", t, bth_u, (255, 127, 14), {"w": 2})],
                vlines=((5.5, (150, 150, 150), 4),) if wrap_events else (),
                legend=[("bearing meas (wrapped)", (31, 119, 180), "pts"),
                        ("outlier", (214, 39, 40), "cross"),
                        ("PF bearing (unwrapped)", (255, 127, 14), "line")])

    ess = di_df.ess.to_numpy()
    res = di_df.resampled.to_numpy()
    _draw_panel(cv, pos[3][0], pos[3][1], pw, ph, "Effective sample size", "t",
                "ESS", (t.min(), t.max()), (0.0, N_PART),
                [("line", tt, ess, (44, 160, 44), {"w": 2}),
                 ("pts", tt[res == 1], ess[res == 1], (214, 39, 40), {"r": 3})],
                hlines=((N_PART / 2, (120, 120, 120), 5),),
                legend=[("ESS", (44, 160, 44), "line"),
                        ("N/2 threshold", (120, 120, 120), "line"),
                        ("resampled", (214, 39, 40), "pts")])

    br_ = np.asarray(bias_r, dtype=float)
    bt_ = np.asarray(bias_th, dtype=float)
    m = max(abs(br_.max()), abs(bt_.max()), 1e-3)
    _draw_panel(cv, pos[4][0], pos[4][1], pw, ph, "Estimated sensor bias states",
                "t", "bias", (t.min(), t.max()), (-1.3 * m, 1.3 * m),
                [("line", t, br_, (31, 119, 180), {"w": 2}),
                 ("line", t, bt_, (255, 127, 14), {"w": 2})],
                legend=[("b_r (range)", (31, 119, 180), "line"),
                        ("b_th (rad)", (255, 127, 14), "line")])

    nis = np.asarray(nis_arr, dtype=float)
    lo = max(0.05, float(nis[nis > 0].min()) / 10.0)
    hi = max(float(nis.max()) * 10.0, 10.0)
    _draw_panel(cv, pos[5][0], pos[5][1], pw, ph,
                "Normalized innovation squared (log)", "t", "NIS/dim",
                (t.min(), t.max()), (lo, hi),
                [("line", t, nis, (148, 104, 189), {"w": 2})],
                hlines=((1.0, (120, 120, 120), 5), (QGATE, (214, 39, 40), 3)),
                legend=[("NEES proxy (NIS/dim)", (148, 104, 189), "line"),
                        ("1 (calibrated)", (120, 120, 120), "line"),
                        ("3 (Q-inflation trigger)", (214, 39, 40), "line")],
                logy=True)

    cv.save(os.path.join(OUT_DIR, "overview.png"))


def make_overview(t, Y, mask, st_df, di_df, xb, yb, tb, outl,
                  wrap_events, nis_arr, bias_r, bias_th):
    if HAVE_MPL:
        _overview_mpl(t, Y, mask, st_df, di_df, xb, yb, tb, outl,
                      wrap_events, nis_arr, bias_r, bias_th)
    else:
        _overview_builtin(t, Y, mask, st_df, di_df, xb, yb, tb, outl,
                          wrap_events, nis_arr, bias_r, bias_th)


if __name__ == "__main__":
    main()
