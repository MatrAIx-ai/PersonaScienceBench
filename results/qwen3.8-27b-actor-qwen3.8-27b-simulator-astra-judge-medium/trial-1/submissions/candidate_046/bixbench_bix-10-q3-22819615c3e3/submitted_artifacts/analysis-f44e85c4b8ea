# -*- coding: utf-8 -*-
"""
BCG-CORONA (TASK008): chi-square test of COVID-19 severity by patient-volume stratum.

Question: In which patient-volume group (patients_seen) do healthcare workers show
statistically significant differences (p<0.05) in COVID-19 severity between BCG and
Placebo, based on chi-square analysis?

Design (approved):
  - Primary: event-level 2x2 (AESEV>=3 'severe' vs AESEV in {1,2} 'not severe')
             x (BCG vs Placebo), Pearson chi-square per patients_seen stratum,
             with Fisher exact as backup when any expected cell < 5.
  - Case definition (primary): AEPT in the 4 COVID-19 terms.
  - Sensitivity 1: subject-level (max AESEV per subject) 2x2 per stratum.
  - Sensitivity 2: 2xk full grade distribution (AESEV 1-4 x treatment) per stratum.
"""
import pandas as pd
import numpy as np
from scipy import stats

DATA = "/workspace/data"
DM = f"{DATA}/TASK008_BCG-CORONA_DM.csv"
AE = f"{DATA}/TASK008_BCG-CORONA_AE.csv"
EX = f"{DATA}/TASK008_BCG-CORONA_EX.csv"   # latin-1 (é in drug name)

COVID_TERMS = ["COVID-19", "Asymptomatic COVID-19", "COVID-19 pneumonia", "SARS-CoV-2 test positive"]
STRATA = ["1-50", "51-100", ">100"]

dm = pd.read_csv(DM)
ae = pd.read_csv(AE)

# ---- sanity: join + exposure ---------------------------------------------
assert len(set(dm.USUBJID) ^ set(ae.USUBJID)) == 0, "USUBJID mismatch DM vs AE"
ex = pd.read_csv(EX, encoding="latin-1")
assert len(set(dm.USUBJID) ^ set(ex.USUBJID)) == 0, "USUBJID mismatch DM vs EX"
print("Sanity: DM/AE/EX all share the same", dm.USUBJID.nunique(), "USUBJID.")
print("DM TRTGRP counts:", dm.TRTGRP.value_counts().to_dict())
print("EX EXDRUG counts:", ex.EXDRUG.value_counts().to_dict())
print("patients_seen groups in DM:", dm.patients_seen.value_counts().to_dict())

# ---- COVID-19 events ------------------------------------------------------
c = ae[ae.AEPT.isin(COVID_TERMS)].copy()
c = c.merge(dm[["USUBJID", "patients_seen"]], on="USUBJID")
print(f"\nCOVID-19 events (4 AEPT terms): {len(c)} events / {c.USUBJID.nunique()} subjects.")

def report(tab, title):
    print(title)
    print(tab)
    try:
        c2, p2, dof, exp = stats.chi2_contingency(tab, correction=False)
        minexp = float(exp.min())
        _, pf = stats.fisher_exact(tab.values)
        flag = "  (expected cell <5 -> Fisher is the backup)" if minexp < 5 else ""
        print(f"    Pearson chi2 = {c2:.3f} (df={dof}), p = {p2:.4f}{flag}")
        print(f"    Fisher exact p = {pf:.4f}")
        return p2, pf
    except ValueError as e:
        print("    chi2 not computable:", e)
        return np.nan, np.nan

# ================= PRIMARY: event-level 2x2 ================================
print("\n" + "="*70)
print("PRIMARY: event-level 2x2  (severe AESEV>=3 vs not severe) x treatment")
print("="*70)
ce = c.dropna(subset=["AESEV"]).copy()
ce["severe"] = (ce.AESEV >= 3).astype(int)
primary_res = {}
for ps in STRATA:
    s = ce[ce.patients_seen == ps]
    tab = pd.crosstab(s.TRTGRP, s.severe).reindex(index=["BCG", "Placebo"], columns=[0, 1]).fillna(0).astype(int)
    p2, pf = report(tab, f"\n--- patients_seen = {ps}   (n events = {len(s)})")
    primary_res[ps] = (p2, pf)

# ================= SENS 1: subject-level 2x2 (max grade) ====================
print("\n" + "="*70)
print("SENSITIVITY 1: subject-level 2x2 (max AESEV per subject) x treatment")
print("="*70)
sub = (ce.groupby("USUBJID")["AESEV"].max().rename("maxsev")
         .reset_index().merge(dm[["USUBJID", "patients_seen", "TRTGRP"]], on="USUBJID"))
sub["severe"] = (sub.maxsev >= 3).astype(int)
subj_res = {}
for ps in STRATA:
    s = sub[sub.patients_seen == ps]
    tab = pd.crosstab(s.TRTGRP, s.severe).reindex(index=["BCG", "Placebo"], columns=[0, 1]).fillna(0).astype(int)
    p2, pf = report(tab, f"\n--- patients_seen = {ps}   (n subjects = {len(s)})")
    subj_res[ps] = (p2, pf)

# ================= SENS 2: 2xk full grade distribution ======================
print("\n" + "="*70)
print("SENSITIVITY 2: 2xk full AESEV grade distribution (1-4) x treatment")
print("="*70)
ce2 = ce.copy()
ce2["AESEV"] = ce2.AESEV.astype(int)
for ps in STRATA:
    s = ce2[ce2.patients_seen == ps]
    tab = pd.crosstab(s.TRTGRP, s.AESEV).reindex(index=["BCG", "Placebo"], columns=[1, 2, 3, 4]).fillna(0).astype(int)
    print(f"\n--- patients_seen = {ps}   (n events = {len(s)})")
    print(tab)
    try:
        c2, p2, dof, exp = stats.chi2_contingency(tab, correction=False)
        print(f"    Pearson chi2 = {c2:.3f} (df={dof}), p = {p2:.4f}")
    except ValueError as e:
        print("    chi2 not computable:", e)

# ================= CONCLUSION ==============================================
print("\n" + "="*70)
print("CONCLUSION (primary design: event-level 2x2, Pearson + Fisher backup)")
print("="*70)
for ps in STRATA:
    p2, pf = primary_res[ps]
    sig = "SIGNIFICANT (p<0.05)" if (p2 < 0.05 and pf < 0.05) else ("Pearson<0.05 / Fisher>=0.05" if p2 < 0.05 else "not significant")
    print(f"  patients_seen = {ps:>7}: Pearson p = {p2:.4f}, Fisher p = {pf:.4f}  -> {sig}")
sig_groups = [ps for ps in STRATA if primary_res[ps][0] < 0.05 and primary_res[ps][1] < 0.05]
print("\n  => Patient-volume group(s) with p<0.05 (Pearson & Fisher):", sig_groups)
