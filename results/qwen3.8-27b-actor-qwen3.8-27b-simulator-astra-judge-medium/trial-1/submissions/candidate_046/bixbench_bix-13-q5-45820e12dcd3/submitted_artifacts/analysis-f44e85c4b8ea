#!/usr/bin/env python3
"""
DESeq2-style differential expression analysis (Python reimplementation).
Design: ~ Media + Strain, reference Strain = 1 (JBX1).
Contrasts: Strain97_vs_1, Strain98_vs_1, Strain99_vs_1.
BH FDR < 0.05 per contrast.
Final: |DE_single1 ∪ DE_single2| - |DE_single1 ∪ DE_single2 ∩ DE_double|

Note: R/DESeq2 unavailable (no internet/apt). This is a faithful Python
reimplementation of the DESeq2 algorithm: size factors, NB GLM, dispersion
estimation with trend shrinkage, Wald test, BH correction.
"""
import numpy as np, pandas as pd, csv, time, warnings
from scipy import stats, optimize
warnings.filterwarnings('ignore')

t0 = time.time()
print("=" * 70)
print("DESeq2-style Differential Expression Analysis (Python reimplementation)")
print("  (R/DESeq2 unavailable in this environment; no internet access)")
print("=" * 70)

# ============================================================
# 1. LOAD DATA
# ============================================================
print("\n[1] Loading data...")
meta = {}
with open('data/experiment_metadata.csv') as f:
    reader = csv.reader(f); next(reader)
    for row in reader:
        meta[row[1]] = {'Media': row[2], 'Strain': row[3], 'Replicate': row[4]}
samples = sorted(meta.keys(), key=lambda x: int(x.split('-')[1]))
n_samples = len(samples)

gene_ids = []; count_matrix = []
with open('data/raw_counts.csv') as f:
    reader = csv.reader(f); next(reader)
    for row in reader:
        gene_ids.append(row[0])
        count_matrix.append([int(row[j]) for j in range(1, len(row))])
count_matrix = np.array(count_matrix, dtype=np.float64)
n_genes = len(gene_ids)
print(f"  Samples: {n_samples}, Genes: {n_genes}, Zeros: {(count_matrix==0).sum()}")

# ============================================================
# 2. DESIGN MATRIX: ~ Media + Strain (ref: Strain 1)
# ============================================================
X = np.zeros((n_samples, 6))
for i, s in enumerate(samples):
    m = meta[s]
    X[i,0]=1
    if m['Media']=='MMGluFePlus': X[i,1]=1
    elif m['Media']=='Succinate': X[i,2]=1
    if m['Strain']=='97': X[i,3]=1
    elif m['Strain']=='98': X[i,4]=1
    elif m['Strain']=='99': X[i,5]=1
print(f"\n[2] Design: ~ Media + Strain (ref=Strain 1/JBX1), shape={X.shape}, rank={np.linalg.matrix_rank(X)}")

# ============================================================
# 3. SIZE FACTORS (median of ratios)
# ============================================================
print("\n[3] Size factors (median of ratios)...")
geo_mean = np.exp(np.log(count_matrix + 1e-10).mean(axis=1))
sf = np.array([np.median(count_matrix[:,j]/geo_mean) for j in range(n_samples)])
print(f"  SF range: [{sf.min():.4f}, {sf.max():.4f}]")

# ============================================================
# 4. NB GLM FITTING FUNCTIONS
# ============================================================
def fit_poisson(y, X, max_it=200, tol=1e-12):
    """Poisson GLM via IRLS (fast initialization)."""
    y_pos = np.maximum(y, 0.5)
    beta = np.linalg.lstsq(X, np.log(y_pos), rcond=None)[0]
    for _ in range(max_it):
        eta = X@beta
        mu = np.exp(np.clip(eta, -50, 50))
        W = mu
        z = eta + (y-mu)/mu
        XtWX = X.T@(W[:,None]*X)
        XtWz = X.T@(W*z)
        try: beta_new = np.linalg.solve(XtWX, XtWz)
        except: beta_new = np.linalg.lstsq(XtWX, XtWz, rcond=None)[0]
        if not np.all(np.isfinite(beta_new)): break
        if np.max(np.abs(beta_new-beta)) < tol: beta=beta_new; break
        beta = beta_new
    return beta

def fit_nb_direct(y, X, alpha, beta0=None):
    """Fit NB GLM by direct optimization. Return (beta, SE)."""
    if beta0 is None:
        beta0 = fit_poisson(y, X)
    def neg_ll(beta):
        eta = X@beta
        mu = np.exp(np.clip(eta, -50, 50))
        r = 1.0/alpha
        p = 1.0/(1.0+alpha*mu)
        ll = stats.nbinom.logpmf(y, n=r, p=p).sum()
        return -ll if np.isfinite(ll) else 1e10
    res = optimize.minimize(neg_ll, beta0, method='Nelder-Mead',
                            options={'maxiter': 2000, 'xatol': 1e-10, 'fatol': 1e-10})
    beta = res.x
    # Fisher information: W = mu/(1+alpha*mu)
    mu = np.exp(X@beta)
    W = mu/(1.0+alpha*mu)
    XtWX = X.T@(W[:,None]*X)
    try: cov = np.linalg.inv(XtWX)
    except: cov = np.linalg.pinv(XtWX)
    se = np.sqrt(np.maximum(np.diag(cov), 0))
    return beta, se

def est_disp_moments(y, X):
    """Method-of-moments dispersion estimate from Poisson GLM."""
    beta = fit_poisson(y, X)
    mu = np.exp(X@beta)
    mu = np.maximum(mu, 1e-10)
    X2 = np.sum((y-mu)**2/mu)
    n = len(y)
    alpha = (X2 - n) / (n * mu.mean())
    return max(alpha, 1e-6)

def bh_correct(pv):
    """Benjamini-Hochberg FDR."""
    n=len(pv); o=np.argsort(pv); r=pv[o]
    b=r*n/np.arange(1,n+1)
    for i in range(n-2,-1,-1): b[i]=min(b[i],b[i+1])
    c=np.empty(n); c[o]=b; return c

# ============================================================
# 5. DISPERSION ESTIMATION
# ============================================================
print("\n[4] Dispersion estimation...")
norm_counts = count_matrix / sf[np.newaxis,:]
means = norm_counts.mean(axis=1)

print("  5a. Gene-wise dispersion (method of moments)...")
disp_mle = np.zeros(n_genes)
for i in range(n_genes):
    y = count_matrix[i,:]
    if y.sum()==0: disp_mle[i]=1.0; continue
    try: disp_mle[i]=est_disp_moments(y,X)
    except: disp_mle[i]=0.1
    if (i+1)%1000==0: print(f"    {i+1}/{n_genes} ({time.time()-t0:.0f}s)")
print(f"  MLE: min={disp_mle.min():.6f} med={np.median(disp_mle):.6f} max={disp_mle.max():.6f}")

print("  5b. Trend + shrinkage...")
valid = (disp_mle>0)&(means>0)
lm = np.clip(np.log(means[valid]),-2,8)
ld = np.log(disp_mle[valid])
b1,b0 = np.polyfit(lm,ld,1)
trend = np.clip(np.exp(b0+b1*np.log(np.maximum(means,1e-10))),1e-6,10)
pw = 1.0/(trend**2)*(n_samples-6)/(n_samples-4)
gw = 1.0/np.maximum(disp_mle,1e-10)**2
disp_sh = np.clip((pw*trend+gw*disp_mle)/(pw+gw),1e-6,10)
print(f"  Trend: log(disp)={b0:.4f}+{b1:.4f}*log(mean)")
print(f"  Shrunk: min={disp_sh.min():.6f} med={np.median(disp_sh):.6f} max={disp_sh.max():.6f}")

# ============================================================
# 6. WALD TEST
# ============================================================
print("\n[5] Wald test (NB GLM with shrunk dispersion)...")
w97=np.zeros(n_genes); w98=np.zeros(n_genes); w99=np.zeros(n_genes)
n_fail = 0
for i in range(n_genes):
    y=count_matrix[i,:]; a=disp_sh[i]
    if y.sum()==0: continue
    try:
        beta, se = fit_nb_direct(y, X, a)
        w97[i]=beta[3]/se[3] if se[3]>0 else 0
        w98[i]=beta[4]/se[4] if se[4]>0 else 0
        w99[i]=beta[5]/se[5] if se[5]>0 else 0
    except:
        n_fail += 1
    if (i+1)%500==0: print(f"    {i+1}/{n_genes} ({time.time()-t0:.0f}s, fails={n_fail})")

pv97=2*(1-stats.norm.cdf(np.abs(w97)))
pv98=2*(1-stats.norm.cdf(np.abs(w98)))
pv99=2*(1-stats.norm.cdf(np.abs(w99)))
print(f"  P97: min={pv97.min():.2e} med={np.median(pv97):.4f} n_sig_p05={np.sum(pv97<0.05)}")
print(f"  P98: min={pv98.min():.2e} med={np.median(pv98):.4f} n_sig_p05={np.sum(pv98<0.05)}")
print(f"  P99: min={pv99.min():.2e} med={np.median(pv99):.4f} n_sig_p05={np.sum(pv99<0.05)}")

# ============================================================
# 7. BH + SET OPERATIONS
# ============================================================
print("\n[6] BH FDR + set operations...")
pa97=bh_correct(pv97); pa98=bh_correct(pv98); pa99=bh_correct(pv99)
FDR=0.05
d97=set(gene_ids[i] for i in range(n_genes) if pa97[i]<FDR)
d98=set(gene_ids[i] for i in range(n_genes) if pa98[i]<FDR)
d99=set(gene_ids[i] for i in range(n_genes) if pa99[i]<FDR)
print(f"  DE 97vs1 (ΔlasI):   {len(d97)}")
print(f"  DE 98vs1 (ΔrhlI):   {len(d98)}")
print(f"  DE 99vs1 (ΔlasIΔrhlI): {len(d99)}")

A=d97|d98; B=d99; ans=A-B
print(f"\n  |A| = |DE_97 ∪ DE_98| = {len(A)}")
print(f"  |B| = |DE_99| = {len(B)}")
print(f"  |A ∩ B| = {len(A & B)}")
print(f"  |A - B| = {len(ans)}  <-- ANSWER")

print("\n"+"="*70)
print(f"ANSWER: {len(ans)} genes")
print(f"  (DE in >=1 single mutant but NOT in double mutant)")
print(f"  Design: ~ Media + Strain, ref=Strain 1 (JBX1)")
print(f"  FDR: BH < 0.05")
print(f"  ASSUMPTION: 97=ΔlasI, 98=ΔrhlI, 99=ΔlasIΔrhlI")
print(f"  (strain-to-mutant mapping not explicitly labelled in metadata)")
print(f"  Total time: {time.time()-t0:.1f}s")

res=pd.DataFrame({'gene':gene_ids,'mean':means,'disp_sh':disp_sh,
    'w97':w97,'pv97':pv97,'pa97':pa97,
    'w98':w98,'pv98':pv98,'pa98':pa98,
    'w99':w99,'pv99':pv99,'pa99':pa99,
    'DE97':[g in d97 for g in gene_ids],
    'DE98':[g in d98 for g in gene_ids],
    'DE99':[g in d99 for g in gene_ids],
    'in_answer':[g in ans for g in gene_ids]})
res.to_csv('/workspace/de_results.csv',index=False)
print("Saved to /workspace/de_results.csv")
