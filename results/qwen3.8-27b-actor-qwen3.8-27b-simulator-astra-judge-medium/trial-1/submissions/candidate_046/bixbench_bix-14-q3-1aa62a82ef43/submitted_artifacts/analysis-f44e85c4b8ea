"""
BixBench bix-14-q3 — Final count of NON-REFERENCE EXONIC variants in CHIP genes
across the 86 samples in data/CHIP_DP10_GQ20_PASS.

Approved decisions:
  D1  splice_region_variant  -> INTRONIC (dropped)
  D2  Zygosity == NaN         -> EXCLUDED (not a variant call)
  D3  CHIP gene = 'Gene Names' (RefSeq) intersect Schenz 2022 list (case-insensitive),
      NOT the pre-computed fuzzy 'Match' column.
  D4  Include all 86 samples (no Patient-only filter).
  Rows read with header=[0,1] (two-row merged header) -> true variant-row counts.

Region encoded by 'RefSeq Genes 110, NCBI' > 'Sequence Ontology (Combined)' (1 SO term/row).
Reference vs non-reference by 'Proband (<smp>)' > 'Zygosity'.
"""
import pandas as pd
import glob, os
from collections import Counter, defaultdict

DATA = "data/CHIP_DP10_GQ20_PASS"
SCHENZ_XLSX = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"

# --- CHIP gene list (Schenz 2022): 56 symbols, no header ---
schenz = set(pd.read_excel(SCHENZ_XLSX, header=None)[0].astype(str).str.strip().str.lower())
assert len(schenz) == 56, len(schenz)

# --- Region mapping from SO (Combined) ---
EXONIC = {"synonymous_variant", "missense_variant", "inframe_insertion",
          "inframe_deletion", "frameshift_variant", "stop_gained",
          "stop_lost", "start_lost"}
NONREF = {"Heterozygous", "Homozygous Variant"}

def is_chip(gene_names):
    if pd.isna(gene_names):
        return False
    toks = {t.strip().lower() for t in str(gene_names).split(",") if t.strip()}
    return bool(toks & schenz)

def chip_gene(gene_names):
    """Return the matched Schenz gene (for per-gene breakdown) or None."""
    if pd.isna(gene_names):
        return None
    toks = {t.strip().lower() for t in str(gene_names).split(",") if t.strip()}
    hit = toks & schenz
    if not hit:
        return None
    # map back to original-case symbol from the Schenz list
    return sorted(s for s in schenz if s in hit)[0].upper()

files = sorted(glob.glob(os.path.join(DATA, "*.xlsx")))
assert len(files) == 86, len(files)

FINAL = 0
per_sample = {}
per_gene = Counter()
# verification counters
so_total = Counter()
zyg_total = Counter()
so_nonref = Counter()
region_exonic_total = 0
region_nonref_total = 0
total_rows = 0

for f in files:
    df = pd.read_excel(f, header=[0,1])
    pg = [c[0] for c in df.columns if c[1] == "Zygosity"][0]
    so = df[("RefSeq Genes 110, NCBI", "Sequence Ontology (Combined)")]
    zyg = df[(pg, "Zygosity")]
    gene = df[("RefSeq Genes 110, NCBI", "Gene Names")]

    n = 0
    for s, z, g in zip(so, zyg, gene):
        total_rows += 1
        so_total[s] += 1
        zyg_total[str(z)] += 1
        exonic = s in EXONIC
        nonref = z in NONREF
        if exonic:
            region_exonic_total += 1
            if nonref:
                region_nonref_total += 1
                so_nonref[s] += 1
        if exonic and nonref and is_chip(g):
            FINAL += 1
            n += 1
            per_gene[chip_gene(g)] += 1
    per_sample[os.path.basename(f)] = n

print("="*60)
print("FINAL COUNT — non-reference exonic variants in CHIP genes (86 samples)")
print("="*60)
print(f"FINAL = {FINAL}")
print(f"total variant rows processed = {total_rows}  (should be sum of per-sample)")
print(f"per-sample sum = {sum(per_sample.values())}")

# --- verification vs previously reported totals ---
exonic_so_sum = sum(v for k, v in so_total.items() if k in EXONIC)
nonref_sum = zyg_total["Heterozygous"] + zyg_total["Homozygous Variant"]
print("\n--- VERIFICATION ---")
print(f"exonic SO rows (all zyg)        = {exonic_so_sum}   (reported ~22470 plain-exonic + splice handled separately)")
print(f"NONREF (Het+HomVar) rows        = {nonref_sum}   (reported 7303+4593={7303+4593})")
print(f"  Heterozygous                  = {zyg_total['Heterozygous']}")
print(f"  Homozygous Variant            = {zyg_total['Homozygous Variant']}")
print(f"  Reference                     = {zyg_total['Reference']}")
print(f"  NaN                           = {zyg_total['nan']}")
print(f"exonic AND nonref rows (any gene)= {region_nonref_total}")
print("SO total distribution:")
for k, v in so_total.most_common():
    print(f"   {v:6d}  {k}")

# --- breakdowns ---
print("\n--- PER-GENE breakdown (top 20) ---")
for g, c in per_gene.most_common(20):
    print(f"   {c:5d}  {g}")
print(f"   ... genes represented: {len(per_gene)}")

print("\n--- PER-SAMPLE breakdown (min/median/max) ---")
vals = sorted(per_sample.values())
import statistics
print(f"   n samples={len(vals)}  min={vals[0]}  median={statistics.median(vals)}  max={vals[-1]}  sum={sum(vals)}")
print("   samples with 0:", sum(1 for v in vals if v == 0))
top_s = sorted(per_sample.items(), key=lambda x: -x[1])[:10]
print("   top-10 samples:")
for fn, c in top_s:
    print(f"   {c:5d}  {fn}")

# save breakdowns
pd.DataFrame({"sample": list(per_sample.keys()), "n_nonref_exonic_chip": list(per_sample.values())}).to_csv("breakdown_per_sample.csv", index=False)
pd.DataFrame({"chip_gene": [g for g,_ in per_gene.most_common()], "n_variants": [c for _,c in per_gene.most_common()]}).to_csv("breakdown_per_gene.csv", index=False)
print("\nSaved breakdown_per_sample.csv and breakdown_per_gene.csv")
