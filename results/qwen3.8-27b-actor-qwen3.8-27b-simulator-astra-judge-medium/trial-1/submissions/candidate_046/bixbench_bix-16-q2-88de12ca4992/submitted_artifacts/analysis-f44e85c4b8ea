#!/usr/bin/env python3
"""
BixBench bix-16-q2
Question: What is the skewness characteristic of the gene expression (log2(TPM+1))
          distribution across all cell lines in the dataset?

Approach (approved plan):
  - Load OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
    (rows = cell lines, cols = genes). Values are ALREADY log2(TPM+1)
    batch-corrected -> used as-is, NO re-transformation.
  - Pool ALL values into a single vector (marginal distribution over all
    gene x cell-line pairs, all 1673 cell lines).
  - scipy.stats.skew (Fisher-Pearson standardized moment coefficient).
  - Key percentiles + ASCII histogram + qualitative description.
"""
import numpy as np
import pandas as pd
from scipy import stats

F = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"

# ---- Load (index_col=0 = cell-line ID; remaining cols = genes) ----
df = pd.read_csv(F, index_col=0)
print("Loaded expression matrix:")
print("  cell lines (rows) :", df.shape[0])
print("  genes      (cols) :", df.shape[1])
print("  total values      :", df.size)
print("  dtype             :", df.dtypes.astype(str).mode().iloc[0])

# Ensure numeric pool (no NaN expected per inspection)
pool = df.to_numpy(dtype=np.float64).ravel()
n = pool.size
n_nan = int(np.isnan(pool).sum())
print("  NaN in pool       :", n_nan)
pool = pool[~np.isnan(pool)]  # drop any NaN (none expected)

# ---- Skewness ----
skew_g1  = stats.skew(pool, bias=True)    # default: adjusted Fisher-Pearson moment (g1)
skew_G1  = stats.skew(pool, bias=False)   # standardized (G1)
print("\nSKEWNESS (pooled, all cell lines):")
print("  scipy.stats.skew (bias=True,  g1) :", round(skew_g1, 6))
print("  scipy.stats.skew (bias=False, G1) :", round(skew_G1, 6))

# ---- Central tendency & spread ----
mean = float(pool.mean()); sd = float(pool.std(ddof=1))
med  = float(np.median(pool))
print("\nDescriptives:")
print("  mean   :", round(mean, 4))
print("  sd     :", round(sd, 4))
print("  median :", round(med, 4))

# ---- Key percentiles ----
qs = [0, 1, 5, 25, 50, 75, 90, 95, 99, 100]
pct = np.percentile(pool, qs)
print("\nPercentiles (log2(TPM+1)):")
labels = {0:"min",1:"p01",5:"p05",25:"Q1",50:"median",75:"Q3",90:"p90",95:"p95",99:"p99",100:"max"}
for q,p in zip(qs,pct):
    print(f"  {labels[q]:>7} ({q:>3}%): {p:.4f}")

# ---- Mass concentration / tail characterization ----
print("\nMass / tail characterization:")
for thr in [0, 1, 2, 3, 5, 8, 10, 12]:
    frac = float((pool < thr).mean())
    print(f"  fraction < {thr:>2} : {frac*100:6.2f}%")
for thr in [10, 12, 14, 16, 18]:
    frac = float((pool > thr).mean())
    print(f"  fraction > {thr:>2} : {frac*100:6.4f}%")

# ---- ASCII histogram (equal-width bins over full range) ----
print("\nHistogram (log2(TPM+1)), pooled across all cell lines:")
nbins = 40
hist, edges = np.histogram(pool, bins=nbins)
mx = hist.max()
for i in range(nbins):
    lo, hi = edges[i], edges[i+1]
    bar = "#" * int(round(hist[i]/mx*60))
    print(f"  [{lo:6.2f},{hi:6.2f}) {hist[i]:>9d} {bar}")

# ---- Optional PNG (best effort) ----
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(figsize=(8,5))
    ax.hist(pool, bins=200, color="#2c7fb8", edgecolor="none")
    ax.axvline(med, color="red", ls="--", lw=1, label=f"median={med:.2f}")
    ax.set_xlabel("log2(TPM+1) expression")
    ax.set_ylabel("count")
    ax.set_title(f"Pooled expression distribution across all {df.shape[0]} cell lines\nskew={skew_g1:.3f}")
    ax.legend()
    fig.tight_layout()
    fig.savefig("skewness_histogram.png", dpi=120)
    print("\nSaved figure: skewness_histogram.png")
except Exception as e:
    print("\n(matplotlib figure skipped:", e, ")")

print("\nDONE")
