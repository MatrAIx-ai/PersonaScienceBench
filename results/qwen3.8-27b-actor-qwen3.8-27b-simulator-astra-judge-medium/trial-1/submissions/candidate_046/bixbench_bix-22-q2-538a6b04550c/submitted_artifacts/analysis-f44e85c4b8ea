import csv, math, sys
from collections import Counter

GM='data/GeneMetaInfo_Zenodo.csv'
MX='data/BatchCorrectedReadCounts_Zenodo.csv'
SA='data/Sample_annotated_Zenodo.csv'

# 1) GeneMetaInfo: protein-coding (token-inclusive) + Length
length={}
pc=set()
with open(GM) as f:
    r=csv.reader(f); next(r)
    for row in r:
        name=row[0]; L=float(row[3]); bio=row[4]
        length[name]=L
        if 'protein_coding' in bio.split(';'):
            pc.add(name)
print('total genes:',len(length))
print('protein_coding (token):',len(pc))
zero_len=[n for n in pc if length[n]==0]
print('PC genes with Length==0:',len(zero_len))

# 2) Sample_annotated: CD4 by celltype
cd4set=set()
with open(SA) as f:
    r=csv.reader(f); next(r)
    for row in r:
        if row[3]=='CD4':
            cd4set.add(row[0])
print('CD4 samples (celltype):',len(cd4set))

# 3) Matrix: mean expression across CD4 columns for PC genes
with open(MX) as f:
    r=csv.reader(f); mh=next(r)
    mcols=mh[1:]
    cd4_idx=[i+1 for i,c in enumerate(mcols) if c in cd4set]
    assert len(cd4_idx)==len(cd4set), (len(cd4_idx),len(cd4set))
    xs=[]; ys=[]; zero_mean=0
    for row in r:
        g=row[0]
        if g not in pc: continue
        s=0.0
        for j in cd4_idx:
            s+=float(row[j])
        mean=s/len(cd4_idx)
        if mean==0: zero_mean+=1
        xs.append(length[g]); ys.append(mean)
print('N (PC genes used):',len(xs))
print('PC genes with mean expression==0:',zero_mean)

# 4) Pearson
n=len(xs)
mx=sum(xs)/n; my=sum(ys)/n
sxy=sum((x-mx)*(y-my) for x,y in zip(xs,ys))
sxx=sum((x-mx)**2 for x in xs)
syy=sum((y-my)**2 for y in ys)
r_pearson=sxy/math.sqrt(sxx*syy)
# significance via t
if sxx>0 and syy>0:
    t=r_pearson*math.sqrt((n-2)/(1-r_pearson**2))
else:
    t=float('nan')
print('mean Length (PC):',round(mx,4))
print('mean mean-expression (PC):',round(my,6))
print('Pearson r:',r_pearson)
print('t-stat (df=n-2):',t)
# two-sided p approx via normal for large n
import math as m
z=abs(t); p=2*(1-0.5*(1+m.erf(z/m.sqrt(2))))
print('approx two-sided p:',p)
print('FINAL_PEARSON_R=%.6f'%r_pearson)
