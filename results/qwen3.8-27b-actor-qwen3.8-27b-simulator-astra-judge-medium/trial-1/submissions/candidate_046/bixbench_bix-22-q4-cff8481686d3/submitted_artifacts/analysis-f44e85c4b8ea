#!/usr/bin/env python3
"""
Pearson correlation between gene length and mean expression (across CD14 samples)
for protein-coding genes.

Steps:
 1. Load GeneMetaInfo, BatchCorrectedReadCounts, Sample_annotated.
 2. Filter protein-coding genes: gene_biotype == 'protein_coding' (EXACT match).
 3. Select CD14 samples (celltype == 'CD14') -> 132 columns.
 4. Per gene, mean of raw batch-corrected read counts across the 132 CD14 samples.
 5. Merge Length with mean_expression on Geneid.
 6. Pearson correlation (scipy.stats.pearsonr) between Length and mean_expression.
"""
import pandas as pd
import numpy as np
from scipy import stats

DATA = "data"

# 1. Load
gene = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv", index_col=0)
counts = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
samples = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")

# 2. Protein-coding genes (EXACT match)
pc_mask = gene["gene_biotype"] == "protein_coding"
pc_genes = gene.loc[pc_mask, ["Length"]].copy()
n_pc = len(pc_genes)

# 3. CD14 samples
cd14_samples = samples.loc[samples["celltype"] == "CD14", "sample"].tolist()
n_cd14 = len(cd14_samples)
assert set(cd14_samples).issubset(counts.columns), "Some CD14 samples missing from counts"

# 4. Mean expression across CD14 samples for each protein-coding gene
cd14_counts = counts.loc[pc_genes.index, cd14_samples]
mean_expr = cd14_counts.mean(axis=1)

# 5. Merge Length and mean_expression
df = pd.DataFrame({"Length": pc_genes["Length"], "mean_expression": mean_expr})
assert df["Length"].notna().all() and df["mean_expression"].notna().all()

# 6. Pearson correlation
r, p = stats.pearsonr(df["Length"], df["mean_expression"])

print("=== RESULTS ===")
print(f"protein_coding genes (exact match) included : {n_pc}")
print(f"CD14 samples used                            : {n_cd14}")
print(f"Pearson r (Length vs mean expression, CD14)  : {r:.6f}")
print(f"P-value                                      : {p:.3e}")
