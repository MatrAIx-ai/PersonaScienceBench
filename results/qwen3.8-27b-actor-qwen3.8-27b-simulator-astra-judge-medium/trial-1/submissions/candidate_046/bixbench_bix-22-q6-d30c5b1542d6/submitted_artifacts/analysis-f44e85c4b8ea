"""
BixBench bix-22-q6: Pearson correlation between gene length and gene expression,
protein-coding genes only.

Decisions (approved by researcher):
  1) protein-coding  = exact match gene_biotype == 'protein_coding'
  2) gene expression = mean of the 723 batch-corrected sample columns per gene
  3) counts used as-is (no log transform, no celltype/batch subsetting)
  4) report r, n genes, p-value, and 95% CI (Fisher z)
"""
import pandas as pd
import numpy as np
from scipy import stats

# ---- Load metadata ----
meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv", index_col=0)
meta.columns = ["Geneid", "Chr", "Length", "gene_biotype"]
print("meta shape:", meta.shape)

# ---- Load expression matrix (genes x samples) ----
expr = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
print("expr shape:", expr.shape)

# ---- Filter protein-coding (exact match) ----
pc_mask = meta["gene_biotype"] == "protein_coding"
pc = meta[pc_mask].copy()
print("protein-coding genes (exact match):", len(pc))

# ---- Align expression rows to the filtered metadata ----
shared = pc.index.intersection(expr.index)
missing = pc.index.difference(expr.index)
print("protein-coding genes missing from expression matrix:", len(missing))
pc = pc.loc[shared]

# ---- Length -> numeric ----
pc["Length_num"] = pd.to_numeric(pc["Length"], errors="coerce")
print("Length NaN after conversion:", int(pc["Length_num"].isna().sum()))

# ---- Expression per gene = mean over the 723 samples ----
e = expr.loc[pc.index]
gene_expr = e.mean(axis=1)
print("expression NaN per gene:", int(gene_expr.isna().sum()))
print("genes with all-zero expression:", int((e.sum(axis=1) == 0).sum()))

# ---- Drop any rows with NaN in Length or expression ----
df = pd.DataFrame({"Length": pc["Length_num"], "Expr": gene_expr}).dropna()
n = len(df)
print("final n (pairs used):", n)

# ---- Pearson correlation ----
r, p = stats.pearsonr(df["Length"], df["Expr"])
# 95% CI via Fisher z-transform
z = np.arctanh(r)
se = 1.0 / np.sqrt(n - 3)
ci_lo, ci_hi = np.tanh(z - 1.959964 * se), np.tanh(z + 1.959964 * se)

print("\n=== RESULT ===")
print(f"n genes (protein-coding): {n}")
print(f"Pearson r (Length vs mean expression): {r:.6f}")
print(f"p-value: {p:.3e}")
print(f"95% CI (Fisher z): [{ci_lo:.6f}, {ci_hi:.6f}]")
