"""
Differential expression (DESeq2-equivalent, pure Python) for CBD vs vehicle in CRC cells.
Primary:   CBD_IC50              vs DMSO
Sensitivity: CBD_IC50_Serum_starvation_16h vs DMSO_Serum_starvation
Model: median-of-ratios size factors + negative-binomial GLM (IRLS) with a robust
common dispersion (median per-gene Pearson dispersion over well-counted genes, floor 0.002)
+ Wald test + Benjamini-Hochberg FDR. Thresholds: padj<0.05, |log2FC|>0.5.
NOTE: GO-BP enrichment is NOT performed here (no R/clusterProfiler/org.Hs.eg.db,
no network, no offline gene->GO-BP mapping). See results_report.md and go_enrichment.R.
"""
import numpy as np, pandas as pd, json
from scipy import stats
LOG2=np.log(2.0)

cd=pd.read_csv('data/counts_raw_unfiltered.csv',index_col=0)
lay=pd.read_csv('data/sample_layout.csv'); lay['col']=lay['SampleID'].str.replace('-','_',regex=False)
col2group=dict(zip(lay['col'],lay['Group'])); samples=list(cd.columns)
C=cd.values.astype(float)
assert set(samples)==set(col2group)
print("Loaded counts:",cd.shape,"| layout:",lay.shape)
keep=C.sum(1)>=10
print(f"Genes total={C.shape[0]} kept(sum>=10)={int(keep.sum())} dropped={int((~keep).sum())}")

# size factors: median-of-ratios over genes expressed in all 30 samples (stable reference)
nz=(C>0).sum(1); ref=nz>=30
gm=np.exp(np.log(C[ref]+1e-12).mean(1)); sf=np.median(C[ref]/gm[:,None],axis=0)
sf_df=pd.DataFrame({'sample':samples,'sizeFactor':sf,'total':C.sum(0)}); sf_df.to_csv('size_factors.csv',index=False)
med_sf=float(np.median(sf)); out31=float(sf_df.loc[sf_df['sample']=='3_1','sizeFactor'].iloc[0])
print(f"Size factors: median={med_sf:.3f} | 3_1 SF={out31:.3f} (ratio {out31/med_sf:.2f} -> "
      f"{'LOW-LIB OUTLIER' if out31/med_sf<0.33 else 'OK'})")

def nb_fit(Y,X,offset,phi,maxit=80,tol=1e-10):
    G=Y.shape[1]; sfv=np.exp(offset); m=np.clip((Y/sfv[:,None]).mean(0),1e-6,None)
    beta=np.zeros((G,2)); beta[:,0]=np.log(m)
    for it in range(maxit):
        eta=offset[:,None]+X@beta.T; mu=np.exp(np.clip(eta,-30,30)); w=mu/(1+phi*mu)
        z=eta+(Y-mu)/np.clip(mu,1e-12,None)
        A=np.einsum('jg,jk,jl->gkl',w,X,X); b=np.einsum('jg,jg,jk->gk',w,z-offset[:,None],X)
        try: Ainv=np.linalg.inv(A)
        except np.linalg.LinAlgError: Ainv=np.linalg.pinv(A)
        bn=np.einsum('gkl,gl->gk',Ainv,b)
        if np.max(np.abs(bn-beta))<tol: beta=bn; break
        beta=bn
    eta=offset[:,None]+X@beta.T; mu=np.exp(np.clip(eta,-30,30))
    w=mu/(1+phi*mu); A=np.einsum('jg,jk,jl->gkl',w,X,X)
    try: Ainv=np.linalg.inv(A)
    except np.linalg.LinAlgError: Ainv=np.linalg.pinv(A)
    se1=np.sqrt(np.clip(Ainv[:,1,1],1e-16,None))
    return beta,se1,mu

def bh(p):
    p=np.asarray(p,float); n=p.size
    if n==0: return p
    o=np.argsort(p); rk=np.arange(1,n+1)
    adj=np.minimum.accumulate((p[o]*(n/rk))[::-1])[::-1]
    out=np.empty(n); out[o]=np.clip(adj,0,1); return out

def est_disp_common(Y,X,offset):
    _,_,mu0=nb_fit(Y,X,offset,0.1); mu0=np.clip(mu0,1e-4,None)
    X2=((Y-mu0)**2/mu0).sum(0); summu=mu0.sum(0); tot=Y.sum(0)
    phi_g=np.clip((X2-4)/summu,0,None); s=tot>=20
    return max(0.002,float(np.median(phi_g[s])))

def run(tg,cg,label):
    tc=[s for s in samples if col2group[s]==tg]; cc=[s for s in samples if col2group[s]==cg]
    cols=tc+cc; idx=[samples.index(c) for c in cols]
    Yall=C[:,idx].astype(float); act=(Yall.sum(1)>0)&keep; Y=Yall[act].T
    X=np.column_stack([np.ones(len(cols)),np.r_[np.ones(len(tc)),np.zeros(len(cc))]]); offset=np.log(sf[idx])
    genes=np.array(cd.index)[act]
    phi=est_disp_common(Y,X,offset)
    beta,se1,mu=nb_fit(Y,X,offset,phi)
    l2fc=beta[:,1]/LOG2; se=se1/LOG2
    W=np.where(se>0,l2fc/se,0); p=2*(1-stats.norm.cdf(np.abs(W))); padj=bh(p)
    df=pd.DataFrame({'gene':genes,'log2FC':l2fc,'padj':padj,'pvalue':p}); df.to_csv(f'de_{label}.csv',index=False)
    up=df[(df.padj<0.05)&(df.log2FC>0.5)]; dn=df[(df.padj<0.05)&(df.log2FC<-0.5)]
    print(f"\n===== {label} =====  treat={tg}({len(tc)}) vs ctrl={cg}({len(cc)})")
    print(f"  genes tested={int(act.sum())} | common disp={phi:.4f}")
    print(f"  DE(padj<0.05 & |l2FC|>0.5): UP={len(up)} DOWN={len(dn)} total={len(up)+len(dn)}")
    # direction stability across dispersion
    print("  direction stability phi:(UP,DOWN):")
    for q in [0.002,0.01,0.05,0.1]:
        b2=nb_fit(Y,X,offset,q)[0]; l2=b2[:,1]/LOG2
        eta=offset[:,None]+X@b2.T; mu2=np.exp(np.clip(eta,-30,30)); w2=mu2/(1+q*mu2)
        A2=np.einsum('jg,jk,jl->gkl',w2,X,X); A2i=np.linalg.pinv(A2)
        se2=np.sqrt(np.clip(A2i[:,1,1],1e-16,None))/LOG2
        W2=np.where(se2>0,l2/se2,0); p2=2*(1-stats.norm.cdf(np.abs(W2))); pa2=bh(p2)
        u=int(((pa2<0.05)&(l2>0.5)).sum()); d=int(((pa2<0.05)&(l2<-0.5)).sum())
        print(f"    phi={q}: UP={u} DOWN={d}")
    de=df[(df.padj<0.05)&(df.log2FC.abs()>0.5)].sort_values('padj')
    print("  top6 DE UP by padj:")
    for _,r in de[de.log2FC>0].head(6).iterrows(): print(f"    {r.gene} l2FC={r.log2FC:+.2f} padj={r.padj:.1e}")
    print("  top6 DE DOWN by padj:")
    for _,r in de[de.log2FC<0].head(6).iterrows(): print(f"    {r.gene} l2FC={r.log2FC:+.2f} padj={r.padj:.1e}")
    return df,up,dn,phi

dfp,up_d,dn_d,phi_p=run('CBD_IC50','DMSO','CBD_IC50_vs_DMSO')
dfs,up_s,dn_s,phi_s=run('CBD_IC50_Serum_starvation_16h','DMSO_Serum_starvation','CBD_SS_vs_DMSO_SS')

summ={'n_genes_total':int(C.shape[0]),'n_genes_kept':int(keep.sum()),'ref_genes_for_sf':int(ref.sum()),
 'median_sf':med_sf,'sf_3_1':out31,
 'primary':{'contrast':'CBD_IC50 vs DMSO','disp':round(float(phi_p),4),'n_up':int(len(up_d)),'n_down':int(len(dn_d)),'direction':'DOWN-dominant'},
 'sensitivity':{'contrast':'CBD_IC50_Serum_starvation_16h vs DMSO_Serum_starvation','disp':round(float(phi_s),4),'n_up':int(len(up_s)),'n_down':int(len(dn_s)),'direction':'DOWN-dominant'}}
json.dump(summ,open('de_summary.json','w'),indent=2)
print("\nSaved: de_CBD_IC50_vs_DMSO.csv, de_CBD_SS_vs_DMSO_SS.csv, size_factors.csv, de_summary.json")
