#!/usr/bin/env Rscript
# Canonical R version (for the R-provisioned runner with internet to rest.kegg.jp).
# KEGG ORA, P. aeruginosa (org 'pa'), downregulated genes (padj<0.05 & log2FC<=-1.5),
# latest KEGG db, logfold cutoff -1.5, adjusted p 0.05; count pathways common in BOTH media.
# NOTE: not executed in the inspection sandbox (no R / no network); logic mirrors the
# executed Python script (kegg_ora_analysis.py).
org <- "pa"; padj_cut <- 0.05; lfc_cut <- -1.5
base <- "https://rest.kegg.jp"
cat("KEGG query timestamp:", format(Sys.time(), "%Y-%m-%dT%H:%M:%S"), "\n")
get <- function(u){ x <- tempfile(); download.file(u, x, quiet = TRUE); readLines(x) }
path_lines <- get(paste0(base, "/list/pathway/", org))
gene_lines <- get(paste0(base, "/list/gene/", org))
link_lines <- get(paste0(base, "/link/pathway/", org))
pid   <- sub("^path:", "", sub("\t.*", "", path_lines))
pdesc <- sub("^\\S+\\t", "", path_lines)
pathways <- setNames(pdesc, pid)
g <- do.call(rbind, strsplit(gene_lines, "\t"))
all_genes  <- g[, 1]
locus_tag  <- trimws(sub(";.*", "", g[, 2]))
locus2kegg <- setNames(g[, 1], locus_tag)
lk <- do.call(rbind, strsplit(link_lines, "\t"))
lk <- lk[grepl("^path:", lk[, 1]) & grepl("^gn:", lk[, 2]), , drop = FALSE]
path2genes <- split(sub("^gn:", "", lk[, 2]), sub("^path:", "", lk[, 1]))
files <- c(GluFe = "data/res_GluFevsGluFePlus.rds", Succ = "data/res_SuccvsGluFePlus.rds")
down <- list()
for (nm in names(files)) {
  d <- readRDS(files[nm]); sel <- d$padj < padj_cut & d$log2FoldChange <= lfc_cut
  down[[nm]] <- rownames(d)[sel]; cat(nm, "downregulated:", length(down[[nm]]), "\n")
}
kegg_down <- lapply(down, function(t) locus2kegg[t])
kegg_down <- lapply(kegg_down, function(x) x[!is.na(x)])
N <- length(all_genes); sig <- list()
for (nm in names(kegg_down)) {
  F <- kegg_down[[nm]]
  pvals <- sapply(names(pathways), function(pth) {
    gset <- intersect(path2genes[[pth]], all_genes)
    n11 <- length(intersect(F, gset)); n12 <- length(F) - n11
    n21 <- length(gset) - n11;         n22 <- N - length(gset) - n12
    fisher.test(matrix(c(n11, n12, n21, n22), 2, byrow = TRUE),
                alternative = "greater")$p.value
  })
  q <- p.adjust(pvals, "BH"); sig[[nm]] <- names(q[q < padj_cut])
  cat(nm, "significant pathways:", length(sig[[nm]]), "\n")
}
common <- intersect(sig$GluFe, sig$Succ)
cat("\nFINAL ANSWER: common pathways in both media =", length(common), "\n")
cat("Common KEGG ids:", paste(sort(common), collapse = ", "), "\n")
cat("GluFe sig:", paste(sort(sig$GluFe), collapse = ", "), "\n")
cat("Succ  sig:", paste(sort(sig$Succ),  collapse = ", "), "\n")
