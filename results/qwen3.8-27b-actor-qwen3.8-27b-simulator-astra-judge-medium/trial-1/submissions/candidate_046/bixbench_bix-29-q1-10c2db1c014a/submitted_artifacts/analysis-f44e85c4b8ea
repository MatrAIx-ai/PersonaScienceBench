#!/usr/bin/env python3
"""
BCG vaccination and COVID-19 severity - ordinal regression analysis
====================================================================
Question: OR of BCG vaccination on COVID-19 severity controlling for prior
medical history count (mh_count) and patient interaction frequency
(patients_seen), including the interaction term mh_count x patients_seen
("interaction between terms" = product of the two adjustment covariates;
NOT an interaction with BCG), fitted with an ordinal regression
(proportional odds) model.

Approved decisions:
- PRIMARY population: subjects with a COVID-19 AE and non-missing AESEV (n=151);
  outcome = max(AESEV) over the subject's COVID-19 AE rows (levels 1-4).
- SENSITIVITY 1: all 1000 subjects, outcome 0-4 with 0 = no infection.
- SENSITIVITY 2 (primary population): mh_count = total # MHTERM rows in
  MHSCAT='MEDICAL HISTORY' (instead of the primary # terms answered 'yes').
- mh_count (primary) = # MHTERM rows with MHORRES==1 in MHSCAT='MEDICAL HISTORY'.
- patients_seen coded ordinal 1-3 (1-50 / 51-100 / >100).
Proportional-odds assumption checked with LR tests via partial proportional
odds models (PPOM): (a) BCG-specific, (b) global (all covariates free).
"""
import warnings
warnings.filterwarnings("ignore", category=UserWarning)
warnings.filterwarnings("ignore", category=FutureWarning)
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel
from statsmodels.api import Logit

DATA = "data"
dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")

# ----------------------------------------------------------------------
# 1) Patient-level covariates
# ----------------------------------------------------------------------
dm["BCG"] = (dm["TRTGRP"] == "BCG").astype(int)
ps_map = {"1-50": 1, "51-100": 2, ">100": 3}
dm["patients_seen_ord"] = dm["patients_seen"].map(ps_map)

mhc = mh[mh["MHSCAT"] == "MEDICAL HISTORY"]
mh_count = (mhc[mhc["MHORRES"] == 1.0].groupby("USUBJID")
                .size().reindex(dm["USUBJID"]).fillna(0).astype(int))
mh_count_total = (mhc.groupby("USUBJID").size()
                      .reindex(dm["USUBJID"]).fillna(0).astype(int))
dm["mh_count"] = mh_count.values
dm["mh_count_total"] = mh_count_total.values

# ----------------------------------------------------------------------
# 2) Ordinal outcome: max AESEV among COVID-19 AE rows per subject
# ----------------------------------------------------------------------
covid = ae[ae["AEPT"].str.contains("COVID", case=False, na=False)]
sev = covid.groupby("USUBJID")["AESEV"].max()
dm["sev"] = sev.reindex(dm["USUBJID"]).values

primary = dm[dm["sev"].notna()].copy()          # n = 151, severity 1-4
alt = dm.copy()                                  # n = 1000, 0 = no infection
alt["sev"] = alt["sev"].fillna(0).astype(int)

print("=" * 78)
print("DATASET")
print(f"  DM subjects: {len(dm)} | primary (infected, AESEV non-null): {len(primary)}")
print(f"  sensitivity (all subjects, 0=no infection): {len(alt)}")
print(f"  primary outcome counts: {primary['sev'].astype(int).value_counts().sort_index().to_dict()}")
print(f"  alt outcome counts:     {alt['sev'].value_counts().sort_index().to_dict()}")
print(f"  BCG arm (primary): {primary['BCG'].value_counts().to_dict()}")
print(f"  mh_count (primary, yes-count) range: {primary['mh_count'].min()}-{primary['mh_count'].max()} (mean {primary['mh_count'].mean():.2f})")
print(f"  patients_seen x severity (primary):\n{pd.crosstab(primary['patients_seen_ord'], primary['sev'].astype(int)).to_string()}")
print("=" * 78)

# ----------------------------------------------------------------------
# 3) Partial proportional odds model (PPOM) for PHO LR tests
#    Covariates in `free_cols` get category-specific effects (delta_k).
# ----------------------------------------------------------------------
class PPOM(OrderedModel):
    """Partial proportional odds model: covariates in free_cols get
    category-specific effects (extra deltas at thresholds 2..K)."""
    def __init__(self, endog, exog, free_cols, **kwds):
        super().__init__(endog, exog, **kwds)
        self.free_cols = free_cols

    def loglikeobs(self, params):
        p = self.exog.shape[1]
        K = self.k_levels
        beta = params[:p]
        alpha = params[p:p + K - 1]
        delta = params[p + K - 1:].reshape(K - 2, len(self.free_cols))
        xb = self.exog @ beta
        dext = np.zeros((self.exog.shape[0], K - 1))
        if len(self.free_cols) > 0:
            # delta: (K-2) x len(free_cols); contribution per threshold 2..K
            dext[:, 1:] = self.exog[:, self.free_cols] @ delta.T
        eta = xb[:, None] + alpha[None, :] + dext
        F = 1.0 / (1.0 + np.exp(-eta))
        y = self.endog                            # 0..K-1
        logL = np.zeros(self.endog.shape[0])
        for k in range(K - 1):
            logL += (y > k) * np.log(1.0 - F[:, k] + 1e-15)
            logL += (y == k) * np.log(F[:, k] + 1e-15)
        return logL

def fit_ppom(y, X, free_cols, po_params):
    K = int(y.max()) - int(y.min()) + 1
    p = X.shape[1]
    start = np.concatenate([po_params[:p], po_params[p:p + K - 1],
                            np.zeros((K - 2) * len(free_cols))])
    model = PPOM(y, X, free_cols=free_cols, distr="logit")
    res = model.fit(start_params=start, method="bfgs", maxiter=1000, disp=False)
    return res

def pho_test(y, X, free_cols, po_res):
    """LR test of proportional odds for `free_cols` via PPOM."""
    K = int(y.max()) - int(y.min()) + 1
    pp = fit_ppom(y, X, free_cols, np.asarray(po_res.params, dtype=float))
    converged = bool(pp.mle_retvals.get("converged", False)) and pp.mle_retvals.get("warnflag", 1) == 0
    LR = 2 * (pp.llf - po_res.llf)
    df = (K - 2) * len(free_cols)
    pval = stats.chi2.sf(LR, df)
    return LR, df, pval, converged

# ----------------------------------------------------------------------
# 4) Fit ordinal models
# ----------------------------------------------------------------------
def design(df, mh_var):
    return pd.DataFrame({
        "BCG": df["BCG"].astype(float),
        "mh_count": df[mh_var].astype(float),
        "patients_seen": df["patients_seen_ord"].astype(float),
        "mh_count:patients_seen": (df[mh_var] * df["patients_seen_ord"]).astype(float),
    })

COLS = ["BCG", "mh_count", "patients_seen", "mh_count:patients_seen"]

def run_ordinal(name, df, mh_var):
    y = df["sev"].values
    X = design(df, mh_var)
    print("-" * 78)
    print(f"MODEL: {name}   (n={len(df)}, mh variable={mh_var})")
    res = OrderedModel(y, X, distr="logit").fit(method="newton", maxiter=500, disp=False)
    converged = bool(res.mle_retvals.get("converged", False)) and res.mle_retvals.get("warnflag", 1) == 0
    method_used = "newton"
    if not converged:
        res = OrderedModel(y, X, distr="logit").fit(method="bfgs", maxiter=1000, disp=False)
        converged = bool(res.mle_retvals.get("converged", False)) and res.mle_retvals.get("warnflag", 1) == 0
        method_used = "bfgs"
    print(f"  converged={converged}, method={method_used}, llf={res.llf:.3f}, "
          f"iterations={res.mle_retvals.get('iterations')}, "
          f"condition number={np.linalg.cond(X.values):.1f}")
    b = res.params
    se = res.bse
    for c in COLS:
        print(f"    {c:24s} beta={b[c]:+.4f}  SE={se[c]:.4f}  OR={np.exp(b[c]):.3f} "
              f"(95% CI {np.exp(b[c]-1.96*se[c]):.3f} - {np.exp(b[c]+1.96*se[c]):.3f})")
    or_, lo, hi = np.exp(b["BCG"]), np.exp(b["BCG"]-1.96*se["BCG"]), np.exp(b["BCG"]+1.96*se["BCG"])
    print(f"  >>> OR of BCG on higher severity = {or_:.3f}  (95% CI {lo:.3f} - {hi:.3f})")
    out = {"name": name, "n": len(df), "converged": converged, "or": or_,
           "lo": lo, "hi": hi, "res": res, "y": y, "X": X}
    if converged:
        pos = {c: i for i, c in enumerate(X.columns)}
        for label, free in (("BCG-specific", [pos["BCG"]]),
                            ("global (all covariates)", list(range(len(COLS))))):
            try:
                LR, dfd, pval, ppconv = pho_test(y, X.values, free, res)
                print(f"  PHO LR test [{label}]: LR={LR:.3f}, df={dfd}, p={pval:.4f} (PPOM converged={ppconv})")
                out.setdefault("pho", {})[label] = (LR, dfd, pval, ppconv)
            except Exception as e:
                print(f"  PHO LR test [{label}] failed: {e}")
    return out

primary_res = run_ordinal("PRIMARY: infected only, sev 1-4, mh yes-count", primary, "mh_count")
sens_mh = run_ordinal("SENSITIVITY: infected only, mh total MHTERM count", primary, "mh_count_total")
sens_pop = run_ordinal("SENSITIVITY: all 1000 subjects, sev 0-4 (0=no infection)", alt, "mh_count")

# ----------------------------------------------------------------------
# 5) Fallback (only if primary did not converge): grouped binary logit
# ----------------------------------------------------------------------
if not primary_res["converged"]:
    print("-" * 78)
    print("FALLBACK: primary ordinal model did not converge -> binary logit "
          "severe (3-4) vs mild (1-2)")
    d = primary.copy()
    d["severe"] = (d["sev"] >= 3).astype(int)
    X = design(d, "mh_count")
    lr = Logit(d["severe"], X).fit(disp=False)
    b, se = lr.params["BCG"], lr.bse["BCG"]
    print(f"  converged={lr.mle_retvals['converged']}")
    print(f"  OR(severe vs mild) BCG = {np.exp(b):.3f} "
          f"(95% CI {np.exp(b-1.96*se):.3f} - {np.exp(b+1.96*se):.3f})")
    primary_res["fallback_or"] = np.exp(b)

print("=" * 78)
print("SUMMARY")
for r in (primary_res, sens_mh, sens_pop):
    pho = r.get("pho", {}).get("BCG-specific")
    pho_s = f", PHO(BCG) p={pho[2]:.3f}" if pho else ""
    print(f"  {r['name']}: n={r['n']}, OR_BCG={r['or']:.3f} "
          f"(95% CI {r['lo']:.3f}-{r['hi']:.3f}), converged={r['converged']}{pho_s}")
print("=" * 78)

# ----------------------------------------------------------------------
# 6) Final answer
# ----------------------------------------------------------------------
r = primary_res
pho_b = r.get("pho", {}).get("BCG-specific")
pho_g = r.get("pho", {}).get("global (all covariates)")
ans = f"""
FINAL ANSWER (primary estimand)
--------------------------------
Odds ratio of BCG vaccination on COVID-19 severity (ordinal, higher = worse),
controlling for prior medical history count and patient interaction frequency,
with their interaction term (mh_count x patients_seen), from a proportional-odds
ordinal regression model (logit link), among subjects with COVID-19 and
measured severity (n={r["n"]}; BCG {int(primary["BCG"].sum())} / Placebo {int((1-primary["BCG"]).sum())}):

  OR = {r["or"]:.3f}  (95% CI {r["lo"]:.3f} - {r["hi"]:.3f})

Exact model: logit[P(sev <= k)] = alpha_k + b1*BCG + b2*mh_count + b3*patients_seen
             + b4*(mh_count x patients_seen)
  BCG (0/1); mh_count = # of prior medical-history terms answered 'yes'
  (MHSCAT='MEDICAL HISTORY', MHORRES==1, by USUBJID); patients_seen ordinal 1-3.
  The interaction term is the product of the two adjustment covariates
  (mh_count x patients_seen), NOT an interaction with BCG.

Proportional odds: BCG-specific LR test p={pho_b[2]:.3f} (not rejected at 5%);
global LR test p={pho_g[2]:.4f} (rejected, driven by covariates other than BCG).
Sensitivity: OR = {sens_mh["or"]:.3f} ({sens_mh["lo"]:.3f}-{sens_mh["hi"]:.3f}) with total MHTERM count (n=151);
             OR = {sens_pop["or"]:.3f} ({sens_pop["lo"]:.3f}-{sens_pop["hi"]:.3f}) with all 1000 subjects, 0=no infection.
The primary (infected-only) estimand is reported as the answer.
"""
print(ans)
with open("results_summary.txt", "w") as f:
    f.write(ans)
