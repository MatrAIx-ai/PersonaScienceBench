import pandas as pd, numpy as np
import statsmodels.formula.api as smf
from statsmodels.miscmodels.ordinal_model import OrderedModel
import warnings; warnings.filterwarnings("ignore")
from scipy.stats import norm as _n

pd.set_option('display.width',200); pd.set_option('display.max_columns',None)

# ---------- Load ----------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

# ---------- Outcome: subject-level max AESEV for documented COVID-19 AEs ----------
cov_mask = ae['AEPT'].str.contains('corona|SARS|CoV', case=False, na=False)
cov = ae[cov_mask]
print("COVID-related AE rows:", len(cov), "subjects:", cov['USUBJID'].nunique())
sev = cov.groupby('USUBJID')['AESEV'].max()          # max severity among their COVID AEs
sev = sev.dropna()                                    # drop subjects with all-NaN AESEV
sev = sev[sev.between(1,4)]
print("Subjects with valid COVID severity (1-4):", len(sev))
print("Severity distribution:\n", sev.value_counts().sort_index())

# ---------- Exposure: count of ongoing conditions (MHONGO=='Yes') ----------
n_ongoing = mh[mh['MHONGO']=='Yes'].groupby('USUBJID').size().reindex(sev.index).fillna(0).astype(int)
print("\nn_ongoing distribution (among outcome subjects):\n", n_ongoing.value_counts().sort_index())
print("mean n_ongoing:", round(n_ongoing.mean(),2), "max:", int(n_ongoing.max()))

# ---------- Covariates from DM ----------
dm_s = dm.set_index('USUBJID').loc[sev.index]
data = pd.DataFrame({
    'severity': sev.astype(int),
    'n_ongoing': n_ongoing.values,
    'TRTGRP': dm_s['TRTGRP'].values,
    'patients_seen': dm_s['patients_seen'].values,
    'work_hours': dm_s['work_hours'].values,
    'expect_interact': dm_s['expect_interact'].values,
})
# ordinal numeric coding for ordered categorical interaction vars (1,2,3)
data['patients_seen_o'] = data['patients_seen'].map({'1-50':1,'51-100':2,'>100':3})
data['work_hours_o']    = data['work_hours'].map({'1-40':1,'41-80':2,'>80':3})
data['expect_interact_o'] = (data['expect_interact']=='Yes').astype(int)
data['trt_bcg'] = (data['TRTGRP']=='BCG').astype(int)
print("\nFinal model dataset (n={}):".format(len(data)))
print(data['severity'].value_counts().sort_index())
print("TRTGRP BCG count:", int(data['trt_bcg'].sum()))
print("nulls:\n", data[['patients_seen_o','work_hours_o','expect_interact_o']].isna().sum())

# ---------- Ordinal (proportional-odds, cumulative logit) model ----------
y = data['severity']
X = data[['n_ongoing','trt_bcg','patients_seen_o','work_hours_o','expect_interact_o']]
model = OrderedModel(y, X, distr='logit')
res = model.fit(method='bfgs', maxiter=1000, disp=0)
print("\n=== OrderedModel fit ===")
print("converged:", res.mle_retvals['converged'])
print(res.summary())

beta = res.params['n_ongoing']
se   = res.bse['n_ongoing']
ci   = res.conf_int().loc['n_ongoing']
pval = 2*(1-_n.cdf(abs(beta/se)))
OR   = np.exp(beta)
pct  = 100*(OR-1)
pct_lo = 100*(np.exp(ci[0])-1)
pct_hi = 100*(np.exp(ci[1])-1)
print("\n=== EFFECT of each additional ongoing condition (n_ongoing) ===")
print(f"beta = {beta:.4f}  (SE={se:.4f}, z={beta/se:.3f}, p={pval:.4f})")
print(f"OR   = {OR:.4f}  95% CI OR = [{np.exp(ci[0]):.4f}, {np.exp(ci[1]):.4f}]")
print(f"% increase in odds of higher severity = {pct:.2f}%")
print(f"95% CI for % = [{pct_lo:.2f}%, {pct_hi:.2f}%]")

# ---------- Proportionality (proportional-odds) check ----------
# ---------- Proportional-odds (Brant) check ----------
print("\n=== Proportional-odds check (Brant-style, adjacent cumulative logits) ===")
cvars = ['n_ongoing','trt_bcg','patients_seen_o','work_hours_o','expect_interact_o']
fits = {}
for k in [1,2,3]:                       # P(Y > k) = P(Y >= k+1)
    col = f"ge{k+1}"
    data[col] = (data['severity'] > k).astype(int)
    m2 = smf.logit(f"{col} ~ " + " + ".join(cvars), data).fit(disp=0, method='newton', maxiter=300)
    fits[k] = m2
    print(f"  cutoff P(Y>{k}): n_ongoing beta={m2.params['n_ongoing']:.4f} (SE={m2.bse['n_ongoing']:.4f})")
R = 0.0
for k in [1,2,3]:
    m2 = fits[k]
    b = m2.params[cvars].values
    V = np.array(m2.cov_params().loc[cvars, cvars])
    R += float(b @ np.linalg.inv(V) @ b)
df_R = len(cvars)*(3-1)   # p*(K-1) for K=3 cumulative logits
from scipy.stats import chi2 as _chi2
pR = 1 - _chi2.cdf(R, df_R)
print(f"  Brant chi2 = {R:.3f}, df = {df_R}, p = {pR:.4f}")
print("  -> " + ("proportional-odds NOT rejected (assumption OK)" if pR>0.05 else "proportional-odds REJECTED"))
print("  Cutoff-specific ORs for n_ongoing (heterogeneity detail):")
for k in [1,2,3]:
    bk = fits[k].params['n_ongoing']
    print(f"    P(Y>{k}): OR={np.exp(bk):.3f}  (+{100*(np.exp(bk)-1):.1f}%)")

# ---------- Sensitivity: categorical (dummy) coding of interaction vars ----------
print("\n=== Sensitivity: patients_seen/work_hours as dummies ===")
d = data.copy()
for v in ['patients_seen','work_hours']:
    for lvl in sorted(d[v].unique()):
        d[f"{v}_{lvl}"] = (d[v]==lvl).astype(int)
X2 = d[['n_ongoing','trt_bcg','expect_interact_o',
        'patients_seen_51-100','patients_seen_>100',
        'work_hours_41-80','work_hours_>80']]  # ref: 1-50 / 1-40
r2 = OrderedModel(d['severity'], X2, distr='logit').fit(method='bfgs', maxiter=3000, disp=0)
b2 = r2.params['n_ongoing']; s2 = r2.bse['n_ongoing']; ci2 = r2.conf_int().loc['n_ongoing']
print(f"  n_ongoing beta={b2:.4f} (SE={s2:.4f}), OR={np.exp(b2):.4f}, %={100*(np.exp(b2)-1):.2f}%, CI%=[{100*(np.exp(ci2[0])-1):.2f}, {100*(np.exp(ci2[1])-1):.2f}]")
