#!/usr/bin/env python3
"""
Final analysis: interaction effect between BCG vaccination status and prior
medical history on COVID-19 severity, as an odds ratio from an ordinal
regression model controlling for patient interaction frequency.

Approved specifications (researcher-approved plan):
  A1: outcome = max(AESEV) over ALL adverse-event records per patient (ordinal 1-4)
  A2: exclude patients whose severity is all-NaN
  A3/A4: MH = binary, >=1 condition with MHORRES==2.0 in MHSCAT=='MEDICAL HISTORY'
  A5: reference levels Placebo (BCG=0) and no-prior-MH (hasMH=0)
  A6: control = patients_seen coded ordinal numeric 1/2/3

Model: proportional-odds (cumulative logit) ordinal regression via
statsmodels.miscmodels.ordinal_model.OrderedModel, distr='logit'.
"""
import numpy as np
import pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel

BASE = "/workspace/data"
dm = pd.read_csv(f"{BASE}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{BASE}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{BASE}/TASK008_BCG-CORONA_MH.csv")

# ---- Outcome: per-patient max AESEV (ordinal 1-4) over ALL AEs (A1) ----
sev = ae.groupby("USUBJID")["AESEV"].max().rename("severity")

# ---- Prior medical history binary (A3/A4) ----
mh_h = mh[(mh["MHSCAT"] == "MEDICAL HISTORY")
          & ~mh["MHTERM"].astype(str).str.startswith("Other:")]
hasmh = (mh_h[mh_h["MHORRES"] == 2.0]
         .groupby("USUBJID").size()
         .reindex(dm["USUBJID"], fill_value=0) > 0).astype(int).rename("hasMH")

# ---- Assemble patient-level dataset ----
d = dm.set_index("USUBJID")[["TRTGRP", "patients_seen"]].copy()
d = d.join(sev).join(hasmh)

n_before = len(d)
n_nan_sev = int(d["severity"].isna().sum())
d = d.dropna(subset=["severity"]).copy()          # A2
d["severity"] = d["severity"].astype(int)
d["BCG"] = (d["TRTGRP"] == "BCG").astype(int)     # A5: ref Placebo
d["interact"] = d["BCG"] * d["hasMH"]

# A6: patients_seen ordinal numeric 1/2/3
ps_map = {"1-50": 1, "51-100": 2, ">100": 3}
d["ps"] = d["patients_seen"].map(ps_map)

N = len(d)
print("=" * 70)
print("DATASET")
print(f"  patients in DM:            {n_before}")
print(f"  excluded (all-NaN AESEV):  {n_nan_sev}")
print(f"  FINAL N:                   {N}")
print(f"  BCG: {int(d['BCG'].sum())} / Placebo: {int((d['BCG']==0).sum())}")
print(f"  hasMH=1: {int(d['hasMH'].sum())} / hasMH=0: {int((d['hasMH']==0).sum())}")
print(f"  patients_seen: {d['ps'].value_counts().to_dict()}")
print("\nSeverity distribution overall:", d["severity"].value_counts().sort_index().to_dict())

# ---- Severity distribution by BCG x MH ----
ct = pd.crosstab([d["BCG"], d["hasMH"]], d["severity"])
ct = ct.reindex(index=[(0, 0), (0, 1), (1, 0), (1, 1)],
                columns=[1, 2, 3, 4], fill_value=0)
ct.index = ["Placebo, noMH", "Placebo, MH", "BCG, noMH", "BCG, MH"]
print("\nSeverity distribution by BCG x MH (rows=groups, cols=severity 1-4):")
print(ct.to_string())
print("\nRow totals:", ct.sum(axis=1).to_dict())

# ---- Ordinal (proportional-odds) regression ----
X = d[["BCG", "hasMH", "interact", "ps"]].astype(float)
y = d["severity"]
res = OrderedModel(y, X, distr="logit").fit(method="bfgs", maxiter=1000, disp=0)
conv = res.mle_retvals["converged"]
ci = res.conf_int()

def fmt(name):
    b = res.params[name]; p = res.pvalues[name]
    lo, hi = ci.loc[name].values
    return (f"  {name:10s} coef={b:+.4f}  OR={np.exp(b):.3f}  "
            f"95%CI[{np.exp(lo):.3f},{np.exp(hi):.3f}]  p={p:.4f}")

print("=" * 70)
print("ORDINAL REGRESSION (proportional-odds, logit)")
print(f"  MLE converged: {conv}   (fcalls={res.mle_retvals['fcalls']}, "
      f"llf={res.llf:.4f})")
print("  Coefficients / OR (exp):")
print(fmt("BCG"))
print(fmt("hasMH"))
print(fmt("interact"))
print(fmt("ps"))
print("  Thresholds (cutpoints):")
for t in ["1/2", "2/3", "3/4"]:
    print(f"    {t}: {res.params[t]:.4f}")

# ---- Proportional-odds assumption: Brant test (score test) ----
# Brant test: logistic regression of each pair of threshold categories,
# check whether slope coefficients are equal across pairs.
def brant(endog, exog):
    """Brant score/Wald test for the proportional-odds assumption.
    For each adjacent category pair (k, k+1) fit a binary logit (with
    intercept) on the restricted support; Wald-test that all K-1 slope
    vectors (incl. intercept) are equal."""
    from statsmodels.api import Logit
    from scipy.stats import chi2
    cats = np.unique(endog)
    K = len(cats)
    m = K - 1
    X = np.column_stack([np.ones(len(endog)), np.asarray(exog, dtype=float)])
    params, covs, conv = [], [], []
    for k in range(m):
        lo, hi = cats[k], cats[k + 1]
        mask = (endog == lo) | (endog == hi)
        y_i = (endog[mask] == hi).astype(int)
        if y_i.sum() == 0 or (~y_i.astype(bool)).sum() == 0:
            return None
        mod = Logit(y_i, X[mask]).fit(disp=0, maxiter=1000)
        params.append(np.asarray(mod.params))
        covs.append(np.asarray(mod.cov_params()))
        conv.append(bool(mod.mle_retvals["converged"]))
    p = params[0].shape[0]
    B = np.concatenate(params)  # (m*p,)
    V = np.zeros((m * p, m * p))
    for a in range(m):
        V[a * p:(a + 1) * p, a * p:(a + 1) * p] = covs[a]
    R = []
    for i in range(1, m):
        for c in range(p):
            row = np.zeros(m * p)
            row[0 * p + c] = 1.0
            row[i * p + c] = -1.0
            R.append(row)
    R = np.vstack(R)  # ((m-1)*p, m*p)
    RB = R @ B
    RVR = R @ V @ R.T
    try:
        stat = float(RB @ np.linalg.solve(RVR, RB))
    except np.linalg.LinAlgError:
        stat = float(RB @ np.linalg.pinv(RVR) @ RB)
    dof = R.shape[0]
    return stat, dof, chi2.sf(stat, dof), conv

import warnings as _w
with _w.catch_warnings():
    _w.simplefilter("ignore")
    b = brant(y.values, X)
print("\nProportional-odds assumption (Brant score/Wald test, adjacent-pair logits):")
if b is None:
    print("  could not compute")
else:
    stat, dof, pval, conv = b
    print(f"  pairwise logit convergence: {conv}")
    print(f"  chi2={stat:.3f}, df={dof}, p={pval:.4f}  "
          f"({'proportional-odds NOT rejected (assumption holds)' if pval>0.05 else 'proportional-odds REJECTED'})")

print("=" * 70)
print("SUMMARY (interaction BCG x MH):")
bi = res.params["interact"]; pi = res.pvalues["interact"]
lo, hi = ci.loc["interact"].values
print(f"  coef={bi:+.4f}  OR={np.exp(bi):.3f}  95%CI[{np.exp(lo):.3f},{np.exp(hi):.3f}]  p={pi:.4f}")
