#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
DESeq2-equivalent differential expression analysis
Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx (sheet 'NormCount')
Design: ~ Tissue (pooled across responder groups): baseline_blood, dentate_gyrus, final_blood (30 each)
Contrasts: final_blood vs baseline_blood ; dentate_gyrus vs baseline_blood ; dentate_gyrus vs final_blood
Statistical model (faithful reimplementation of the DESeq2 pipeline, in Python because
R/Bioconductor and internet are unavailable in this sandbox):
  1) size factors by median-of-ratios
  2) per-gene NB dispersion (profile-likelihood MLE) shrunk toward a quadratic mean-dispersion trend
  3) negative-binomial GLM (log link), Wald test per contrast
  4) Benjamini-Hochberg FDR
NOTE: input is the supplied 'NormCount' matrix (normalized, fractional counts), not raw integer counts.
"""
import numpy as np, openpyxl, os, time, warnings
from scipy.stats import norm
from scipy.special import gammaln
warnings.filterwarnings('ignore')
ETA_CLIP=18.0

# ---------------- NB-GLM core (vectorized over genes) ----------------
def make_X(tissue):
    dent=(tissue=='dentate').astype(float); fin=(tissue=='final').astype(float)
    return np.column_stack([np.ones(len(tissue)), dent, fin])

def init_beta(X, y):
    p=X.shape[1]
    ref=np.ones(X.shape[0],bool)
    for c in range(1,p): ref &= (X[:,c]==0)
    b0=np.log(np.clip(y[ref].mean(axis=0),1e-6,None)); out=[b0]
    for c in range(1,p):
        mc=np.log(np.clip(y[X[:,c]>0.5].mean(axis=0),1e-6,None)); out.append(mc-b0)
    return np.column_stack(out)

def irls_step(X, y, mu, phi_g, eta):
    if np.ndim(phi_g)==0: phi_g=np.full(mu.shape[1], phi_g)
    W=mu/(1.0+phi_g[None,:]*mu); z=mu*(y-mu)+eta
    XtWX=np.einsum('np,ng,nq->g pq',X,W,X)+1e-8*np.eye(X.shape[1])[None]
    XtWz=np.einsum('np,ng,ng->gp',X,W,z)
    return np.einsum('gpp,gp->gp',np.linalg.inv(XtWX),XtWz)

def fit_beta(X, y, phi, beta0=None, n_iter=100, tol=1e-8):
    beta0=init_beta(X,y) if beta0 is None else beta0
    eta=X@beta0.T
    for _ in range(n_iter):
        mu=np.exp(np.clip(eta,-ETA_CLIP,ETA_CLIP)); dbeta=irls_step(X,y,mu,phi,eta)
        step=np.max(np.abs(dbeta)); scale=1.0
        if not np.isfinite(step): scale=0.0
        elif step>0.5: scale=0.5/step
        beta0=beta0+scale*dbeta; eta=X@beta0.T
        if scale*np.max(np.abs(dbeta))<tol: break
    mu=np.exp(np.clip(eta,-ETA_CLIP,ETA_CLIP))
    W=mu/(1.0+np.atleast_1d(phi)[None,:]*mu)
    XtWX=np.einsum('np,ng,nq->g pq',X,W,X)+1e-8*np.eye(X.shape[1])[None]
    return beta0, mu, XtWX

def nb_loglik(y, mu, phi_g):
    a=1.0/np.clip(phi_g,1e-8,None)[None,:]; mu=np.clip(mu,1e-12,None); a_mu=a+mu
    return np.nansum(gammaln(np.clip(y,1e-12,None)+a)-gammaln(a)-gammaln(y+1.0)
                     +a*np.log(a/a_mu)+y*np.log(mu/a_mu),axis=0)

def gene_dispersion(X, y, phi_grid, beta_start, max_iter=40):
    G=y.shape[1]; best_ll=np.full(G,-np.inf); best_phi=np.full(G,phi_grid[0]); beta=beta_start
    for phi in phi_grid:
        beta,_,_=fit_beta(X,y,phi,beta0=beta,n_iter=max_iter)
        ll=nb_loglik(y,np.exp(np.clip(X@beta.T,-ETA_CLIP,ETA_CLIP)),np.full(y.shape[1],phi))
        b=ll>best_ll; best_ll[b]=ll[b]; best_phi[b]=phi
    return best_phi

def shrink_disp(disp, y, m0=10.0):
    mu=y.mean(axis=0); x=np.log(np.clip(mu,1e-6,None)); g=disp>1e-6
    c=np.polyfit(x[g],np.log(disp[g]),2)
    for _ in range(2):
        r=np.log(disp[g])-np.polyval(c,x[g]); s=np.std(r); k=np.abs(r)<3*s
        c=np.polyfit(x[g][k],np.log(disp[g])[k],2)
    lt=np.polyval(c,x); s_i=mu/(mu+m0)
    return np.exp(s_i*np.log(np.clip(disp,1e-8,None))+(1-s_i)*lt)

def bh(p):
    p=np.asarray(p,float); m=p.size; o=np.argsort(p); ps=p[o]; rk=np.arange(1,m+1)
    adj=ps*m/rk
    for i in range(m-2,-1,-1):
        if adj[i]>adj[i+1]: adj[i]=adj[i+1]
    out=np.empty(m); out[o]=adj; return np.clip(out,0,1)

def wald(beta, cov, cvec):
    coef=np.einsum('gp,p->g',beta,cvec); var=np.einsum('gpq,p,q->g',cov,cvec,cvec)
    z=coef/np.sqrt(np.clip(var,1e-12,None)); p=2*norm.sf(np.abs(z))
    return coef/np.log(2.0), p

def size_factors(K):
    gm=np.exp(np.nanmean(np.log(np.where(K>0,K,1)),axis=1))
    return np.nanmedian(K/gm[:,None],axis=0)

def run(X, y, phi_grid):
    bP,_,_=fit_beta(X,y,1e-8,n_iter=100)
    disp=gene_dispersion(X,y,phi_grid,bP)
    ds=shrink_disp(disp,y)
    beta,mu,XtWX=fit_beta(X,y,ds,beta0=bP)
    return beta, np.linalg.inv(XtWX+1e-8*np.eye(X.shape[1])[None])

# ---------------- Load data ----------------
t0=time.time()
wb=openpyxl.load_workbook('data/Data_deposition_RNAseq_Paroxetine_2017.xlsx',read_only=True,data_only=True)
ws=wb['NormCount']; it=ws.iter_rows(values_only=True)
hdr=[next(it) for _ in range(4)]; sample_names=list(hdr[3][2:92])
genes=[]; K=[]
for r in it:
    genes.append(r[1]); K.append([float(x) for x in r[2:92]])
wb.close()
K=np.array(K,float); genes=np.array(genes)
tissue=np.array(['baseline']*30+['dentate']*30+['final']*30)
resp=np.array((['Control']*10+['good']*10+['bad']*10)*3)
print(f'loaded {K.shape[0]} genes x {K.shape[1]} samples in {time.time()-t0:.0f}s')
phi_grid=np.logspace(-8,0.4,14)

# ---------------- Main: 3 tissue contrasts (pooled) ----------------
sf=size_factors(K); y=(K/sf[None,:]).T; X=make_X(tissue)
t0=time.time(); beta,cov=run(X,y,phi_grid); print(f'main fit {time.time()-t0:.0f}s')
contrasts={'final_vs_baseline':np.array([0,0,1.]),
           'dentate_vs_baseline':np.array([0,1.,0]),
           'dentate_vs_final':np.array([0,1.,-1.])}
DE={}; meta={}
for name,c in contrasts.items():
    lfc,p=wald(beta,cov,c); padj=bh(p); DE[name]=padj<0.05; meta[name]=(lfc,padj,p)
u=np.zeros(len(genes),bool); i=np.ones(len(genes),bool)
for n in contrasts: u|=DE[n]; i&=DE[n]

os.makedirs('results',exist_ok=True)
def save(name,mask):
    with open(f'results/DE_{name}.csv','w') as f:
        f.write('GeneID,DE\n')
        for g in genes[mask]: f.write(f'{g},1\n')
for n in contrasts: save(n,DE[n])
with open('results/DE_union.csv','w') as f:
    f.write('GeneID,DE\n')
    for g in genes[u]: f.write(f'{g},1\n')
with open('results/DE_intersection.csv','w') as f:
    f.write('GeneID,DE\n')
    for g in genes[i]: f.write(f'{g},1\n')
# full table
with open('results/all_genes_log2FC_padj.csv','w') as f:
    f.write('GeneID,'+','.join(f'{n}_log2FC' for n in contrasts)+','+','.join(f'{n}_padj' for n in contrasts)+'\n')
    for j,g in enumerate(genes):
        f.write(str(g)+','+','.join(f'{meta[n][0][j]:.5f}' for n in contrasts)+','+','.join(f'{meta[n][1][j]:.6g}' for n in contrasts)+'\n')

lines=[]
lines.append('DESeq2-equivalent (Python) | design ~ Tissue (pooled) | threshold padj<0.05')
lines.append('')
for n in contrasts:
    sens=int(((np.abs(meta[n][0])>1)&(meta[n][1]<0.1)).sum())
    lines.append(f'{n:22s} DE(padj<0.05)={int(DE[n].sum()):6d}   |log2FC|>1 & padj<0.1={sens:6d}')
lines.append('')
lines.append(f'UNION (DE in >=1 of 3)      = {int(u.sum())}')
lines.append(f'INTERSECTION (DE in all 3)  = {int(i.sum())}')
lines.append('')
lines.append('Sensitivity (|log2FC|>1 & padj<0.1):')
for n in contrasts:
    sens=(np.abs(meta[n][0])>1)&(meta[n][1]<0.1)
    lines.append(f'  {n:22s} = {int(sens.sum())}')
su=np.zeros(len(genes),bool); si=np.ones(len(genes),bool)
for n in contrasts:
    s=(np.abs(meta[n][0])>1)&(meta[n][1]<0.1); su|=s; si&=s
lines.append(f'  union={int(su.sum())}  intersection={int(si.sum())}')
open('results/summary.txt','w').write('\n'.join(lines)+'\n')
print('\n'.join(lines))

# ---------------- Sanity check vs 9 embedded comparisons ----------------
emb_padj=[70,366,728,493,755,673,457,27,201]; emb_deg=[22,67,135,115,202,212,119,19,32]
tissues=['baseline','dentate','final']
comps=[('Control','good'),('good','bad'),('bad','good'),('Control','good'),('Control','bad'),('bad','good'),
       ('Control','good'),('Control','bad'),('bad','good')]
lines2=['\nSanity check: my pipeline on the 9 embedded (responder-within-tissue) comparisons']
lines2.append(f'{"comp":5s}{"pair":16s}{"mine_padj<.05":>15s}{"emb_padj<.05":>14s}{"emb_DEGflag":>13s}{"ratio":>8s}')
srows=[]
for k in range(9):
    t=tissues[k//3]; A,B=comps[k]
    idx=[j for j in range(90) if tissue[j]==t and resp[j] in (A,B)]
    Y=y[idx]; Xc=np.column_stack([np.ones(len(idx)),(np.array([resp[j]==B for j in idx])).astype(float)])
    b2,c2=run(Xc,Y,phi_grid)
    lfc,p=wald(b2,c2,np.array([0.,1.])); padj=bh(p); n=int((padj<0.05).sum())
    srows.append((f'C{k+1}',f'{A}>{B} ({t})',n,emb_padj[k],emb_deg[k],round(n/emb_padj[k],2)))
    lines2.append(f'C{k+1:4d}{A+">"+B+" ("+t+")":16s}{n:15d}{emb_padj[k]:14d}{emb_deg[k]:13d}{round(n/emb_padj[k],2):8.2f}')
open('results/sanity_check.txt','w').write('\n'.join(lines2)+'\n')
print('\n'.join(lines2))
print('\nSaved artifacts to results/')
