#!/usr/bin/env python3
"""
BixBench bix-3-q5 : Paroxetine RNA-seq (Mueller 2017)
Question: after DE analysis on three tissue comparisons
  (Final vs Baseline Blood, Dentate gyrus vs Baseline blood, Dentate gyrus vs Final blood)
  and a binomial exact test at a 5% threshold, which tissue comparison shows negligible effects?

Method (approved by researcher):
  1) Direct DE on the 90 normalized sample columns (30 vs 30 per tissue),
     Welch t-test on log2(count+1), BH-FDR, DEG = padj < 0.05.
  2) Binomial exact test per comparison: scipy.stats.binomtest(k, N, p=0.05,
     alternative='greater'), alpha = 0.05.
  3) Report the comparison with negligible effects.
"""
import openpyxl, numpy as np
from scipy import stats
from statsmodels.stats.multitest import multipletests

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# ---------- load 90 normalized sample columns ----------
wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb["NormCount"]
it = ws.iter_rows(values_only=True)
for _ in range(4):                      # 4 header rows (real header = physical row 4)
    next(it)
gene_ids, samples = [], []
for r in it:
    gene_ids.append(r[1])
    samples.append([r[c] if isinstance(r[c], (int, float)) else 0.0 for c in range(2, 92)])
wb.close()
S = np.array(samples, dtype=float)      # genes x 90
print("Loaded genes:", S.shape[0], "| samples:", S.shape[1])

# tissue sample index blocks (30 each: Control/good/bad x 10)
TIS = {"baseline_blood": slice(0, 30), "dentate_gyrus": slice(30, 60), "final_blood": slice(60, 90)}

def de_test(matA, matB, lfc_cut=0.0):
    """matA/matB: genes x 30. Welch t-test on log2(count+1), BH-FDR.
    Returns dict with N, DEG counts (padj<0.05 and padj<0.05 & |lfc|>lfc_cut),
    median |log2FC| of DEGs, arrays."""
    A = np.log2(matA + 1.0); B = np.log2(matB + 1.0)
    keep = (matA.sum(axis=1) > 0) | (matB.sum(axis=1) > 0)   # drop genes absent in BOTH tissues
    N = int(keep.sum())
    pvals = np.full(len(A), np.nan); lfc = np.full(len(A), np.nan)
    for i in np.where(keep)[0]:
        a, b = A[i], B[i]
        if a.std() == 0 and b.std() == 0:
            pvals[i] = 1.0 if np.mean(a) == np.mean(b) else 0.0
        else:
            pvals[i] = stats.ttest_ind(a, b, equal_var=False).pvalue
        lfc[i] = np.mean(b) - np.mean(a)
    _, padj, _, _ = multipletests(pvals[keep], method="fdr_bh")
    padj_full = np.full(len(A), np.nan); padj_full[keep] = padj
    deg = keep & (padj_full < 0.05)
    deg_fc = deg & (np.abs(lfc) > 1.0)          # sensitivity: 2-fold
    return dict(N=N, k=int(deg.sum()), k_fc=int(deg_fc.sum()),
                med_abs=float(np.median(np.abs(lfc[deg]))) if deg.sum() else float("nan"))

def binom(k, N, p=0.05):
    return float(stats.binomtest(k, N, p=p, alternative="greater").pvalue)

comparisons = [
    ("Final vs Baseline Blood",        "final_blood",   "baseline_blood"),
    ("Dentate gyrus vs Baseline blood","dentate_gyrus", "baseline_blood"),
    ("Dentate gyrus vs Final blood",   "dentate_gyrus", "final_blood"),
]

print("\n=== DIRECT DE ANALYSIS (Welch t-test + BH-FDR; DEG = padj<0.05) ===")
print(f"{'Comparison':<34}{'N':>7}{'#DEG':>7}{'prop':>7}{'#DEG|fc|>1':>12}{'med|lfc|':>10}{'binom p':>12}{'binom p(fc)':>12}")
res = {}
for name, tY, tX in comparisons:
    d = de_test(S[:, TIS[tX]], S[:, TIS[tY]])
    d["bp"]  = binom(d["k"],    d["N"], 0.05)   # on padj<0.05 DEG set (as specified)
    d["bpf"]= binom(d["k_fc"], d["N"], 0.05)   # sensitivity: on 2-fold DEG set
    d["prop"] = d["k"] / d["N"]
    res[name] = d
    print(f"{name:<34}{d['N']:>7}{d['k']:>7}{d['prop']:>7.3f}{d['k_fc']:>12}{d['med_abs']:>10.3f}{d['bp']:>12.3e}{d['bpf']:>12.3e}")

# ---------- cross-check: file's precomputed DESeq DEG flags (Median-based) ----------
print("\n=== CROSS-CHECK: file DESeq DEG flags (Median-based, Comparison1-9) ===")
wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb["NormCount"]; it = ws.iter_rows(values_only=True)
for _ in range(4): next(it)
cnt = [0]*9
for r in it:
    for i in range(9):
        if r[179+i] in ("U", "D"): cnt[i] += 1
wb.close()
print("  " + "  ".join(f"C{i+1}:{cnt[i]}" for i in range(9)))

# ---------- extra: fraction 2-fold different (Median tissue values) ----------
print("\n=== EXTRA: fraction of genes 2-fold different (Median tissue values) ===")
wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb["NormCount"]; it = ws.iter_rows(values_only=True)
for _ in range(4): next(it)
Bm=[];Dm=[];Fm=[]
for r in it: Bm.append(r[95]); Dm.append(r[96]); Fm.append(r[97])
wb.close()
Bm=np.array(Bm,float);Dm=np.array(Dm,float);Fm=np.array(Fm,float)
def frac2(a,b):
    m=(a>0)&(b>0); return float((np.abs(np.log2(a[m]/b[m]))>1).mean())
f2={"Final vs Baseline Blood":frac2(Fm,Bm),"Dentate gyrus vs Baseline blood":frac2(Dm,Bm),
    "Dentate gyrus vs Final blood":frac2(Dm,Fm)}
for k,v in f2.items(): print(f"  {k}: {v:.3f}")

# ---------- conclusion ----------
print("\n=== CONCLUSION ===")
order = sorted(res, key=lambda n: res[n]["k"])
for n in order:
    print(f"  {n}: {res[n]['k']} DEGs ({res[n]['prop']:.1%}) [2-fold: {res[n]['k_fc']}], med|lfc|={res[n]['med_abs']:.2f}, "
          f"binom p={res[n]['bp']:.2e} (2-fold: {res[n]['bpf']:.2e})")
neg = order[0]
print(f"\nFewest DEGs / lowest DEG proportion / smallest effect sizes -> {neg}")
print("All three comparisons show significant DE (binom p~0 vs 5% FDR null);")
print("the dentate-gyrus-vs-blood comparisons are dominated by the large brain-vs-blood tissue difference.")
print("=> The comparison with the most NEGIGIBLE effects is:", neg)
