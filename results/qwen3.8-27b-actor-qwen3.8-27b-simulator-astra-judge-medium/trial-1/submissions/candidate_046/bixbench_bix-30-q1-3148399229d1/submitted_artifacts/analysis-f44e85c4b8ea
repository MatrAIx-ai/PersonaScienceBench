#!/usr/bin/env python3
"""
BixBench bix-30-q1
Q: What percentage of miRNAs show significant differential expression between
   patient and control groups BEFORE multiple testing correction?

Data: data/pone.0150501.s002.xls  (legacy BIFF8 .xls, sheet "RAW DATA")
  - Row 0   : title
  - Row 1   : header  -> P_1..P_10 (10 patients), C_11..C_20 (10 controls)
  - Rows 2-176 : 175 miRNAs (col A = miRNA name "hsa-*")
  - Values : raw qPCR Ct (lower Ct = higher expression)
  - "NAN" string cells = undetected -> treated as missing (excluded per miRNA/group)

Method (approved plan):
  - Primary: two-sample Welch t-test (unequal variance), two-tailed, p<0.05 (uncorrected)
  - Robustness: Mann-Whitney U (two-sided) and Student's t-test (pooled)
  - % = (# miRNAs with p<0.05) / 175 * 100
"""
import struct, pickle
import numpy as np
from scipy import stats

# ---------- read .xls (BIFF8) via OLE + record parser ----------
import ole  # local OLE2 parser
o = ole.OLE(open('data/pone.0150501.s002.xls','rb').read())
o.build_fat(); o.read_dir()
wb = [d for d in o.dir if d[0]=='Workbook'][0]
data = o.stream(wb[2], wb[3])

recs=[]; pos=0
while pos+4<=len(data):
    op=struct.unpack('<H',data[pos:pos+2])[0]
    ln=struct.unpack('<H',data[pos+2:pos+4])[0]
    d=data[pos+4:pos+4+ln]; pos+=4+ln
    recs.append([op,d])
merged=[]
for op,d in recs:
    if op==0x003C and merged: merged[-1][1]+=d
    else: merged.append([op,d])
recs=merged

def read_sst(buf):
    uniq=struct.unpack('<I',buf[4:8])[0]; off=8; out=[]
    for _ in range(uniq):
        ln=struct.unpack('<H',buf[off:off+2])[0]; off+=2
        flags=buf[off]; off+=1; rich=0; ext=0
        if flags&0x08: rich=struct.unpack('<H',buf[off:off+2])[0]; off+=2
        if flags&0x04: ext=struct.unpack('<I',buf[off:off+4])[0]; off+=4
        if flags&0x01: s=buf[off:off+2*ln].decode('utf-16-le','replace'); off+=2*ln
        else:          s=buf[off:off+ln].decode('latin-1','replace');  off+=ln
        off+=4*rich+ext; out.append(s)
    return out
def decode_rk(rk):
    is100=(rk&0x02)!=0; isint=(rk&0x01)!=0
    if isint:
        v=rk&0xFFFFFFFC
        if v&0x80000000: v-=(1<<32)
        val=float(v)
    else:
        val=struct.unpack('<d',struct.pack('<QQ',0,rk&0xFFFFFFFC))[1]
    return val/100.0 if is100 else val

sst=[]; cells={}
for op,d in recs:
    if op==0x00FC: sst=read_sst(d)
    elif op==0x00FD:
        r=struct.unpack('<H',d[0:2])[0]; c=struct.unpack('<H',d[2:4])[0]
        si=struct.unpack('<I',d[6:10])[0]; cells[(r,c)]=sst[si]
    elif op==0x0203:
        r=struct.unpack('<H',d[0:2])[0]; c=struct.unpack('<H',d[2:4])[0]
        cells[(r,c)]=struct.unpack('<d',d[6:14])[0]
    elif op==0x027E:
        r=struct.unpack('<H',d[0:2])[0]; c=struct.unpack('<H',d[2:4])[0]
        cells[(r,c)]=decode_rk(struct.unpack('<I',d[6:10])[0])
    elif op==0x00BD:
        r=struct.unpack('<H',d[0:2])[0]; c0=struct.unpack('<H',d[2:4])[0]
        cn=struct.unpack('<H',d[len(d)-2:len(d)])[0]; n=cn-c0+1; off=4
        for i in range(n):
            off+=2; rk=struct.unpack('<I',d[off:off+4])[0]; off+=4
            cells[(r,c0+i)]=decode_rk(rk)

# ---------- build matrix ----------
hdr=[cells.get((1,c)) for c in range(1,21)]
P_cols=[c for c,h in enumerate(hdr,1) if h and str(h).startswith('P_')]
C_cols=[c for c,h in enumerate(hdr,1) if h and str(h).startswith('C_')]
mirna_rows=[r for r in range(2,177) if isinstance(cells.get((r,0)),str)
            and cells[(r,0)].startswith('hsa-')]
def num(r,c):
    v=cells.get((r,c))
    return v if isinstance(v,(int,float)) else np.nan
n_mirna=len(mirna_rows)
print(f"miRNAs detected: {n_mirna} | patient cols={len(P_cols)} control cols={len(C_cols)}")

alpha=0.05
res=[]
low_n=[]
for r in mirna_rows:
    name=cells[(r,0)]
    P=[num(r,c) for c in P_cols]
    C=[num(r,c) for c in C_cols]
    P=np.array(P,float); C=np.array(C,float)
    Pn=P[~np.isnan(P)]; Cn=C[~np.isnan(C)]
    if len(Pn)<2 or len(Cn)<2:
        low_n.append((name,len(Pn),len(Cn)))
        res.append((name,len(Pn),len(Cn),np.nan,np.nan,np.nan)); continue
    tw,pw = stats.ttest_ind(Pn,Cn,equal_var=False)   # Welch
    ts,ps = stats.ttest_ind(Pn,Cn,equal_var=True)     # Student
    mw,pm = stats.mannwhitneyu(Pn,Cn,alternative='two-sided')
    res.append((name,len(Pn),len(Cn),pw,ps,pm))

arr=np.array([(a,b,c,d,e,f) for a,b,c,d,e,f in res],dtype=object)
pw=np.array([x[3] for x in res],float)
ps=np.array([x[4] for x in res],float)
pm=np.array([x[5] for x in res],float)

sig_w = int(np.nansum(pw<alpha))
sig_s = int(np.nansum(ps<alpha))
sig_m = int(np.nansum(pm<alpha))
tot   = n_mirna
print("\n=== SIGNIFICANT at p<0.05 (BEFORE multiple-testing correction) ===")
print(f"Welch t-test      : {sig_w}/{tot}  = {sig_w/tot*100:.2f}%   (headline)")
print(f"Student t-test    : {sig_s}/{tot}  = {sig_s/tot*100:.2f}%   (robustness)")
print(f"Mann-Whitney U    : {sig_m}/{tot}  = {sig_m/tot*100:.2f}%   (robustness)")

print("\n=== miRNAs with n<2 in a group (excluded from tests) ===")
if low_n:
    for nm,a,b in low_n: print(f"  {nm}: n_patient={a}, n_control={b}")
else:
    print("  none - every miRNA had >=2 valid samples in both groups")

# save a small table for evidence
import csv
with open('mirna_pvalues.csv','w',newline='') as f:
    w=csv.writer(f); w.writerow(['miRNA','n_patient','n_control','p_welch','p_student','p_mannwhitney'])
    for x in res:
        w.writerow([x[0],x[1],x[2],
                    f"{x[3]:.6g}" if x[3]==x[3] else 'NA',
                    f"{x[4]:.6g}" if x[4]==x[4] else 'NA',
                    f"{x[5]:.6g}" if x[5]==x[5] else 'NA'])
print("\nSaved per-miRNA p-values -> mirna_pvalues.csv")
