"""
Analysis: Count significantly differentially expressed genes (DEGs) per cell type
from Post vs Pre AAV9 mini-dystrophin treatment DEG tables.

Question: Which immune cell type has the highest number of significantly
          differentially expressed genes after AAV9 mini-dystrophin treatment?

Method:
  - Read all 25 sheets from the supplemental xlsx (one sheet per cell type)
  - Count genes with p_val_adj < 0.05 (FDR-adjusted, BH) per sheet
  - Genes with p_val_adj = 0 are counted as significant
  - No additional |log2FC| filter (the xlsx is already pre-filtered to |FC| >= 0.25)
  - Rank cell types by DEG count (descending)

Input:
  data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx

Output:
  Printed table + answer
"""

import openpyxl
import sys
from pathlib import Path

XLSX_PATH = Path(__file__).resolve().parent.parent / "data" / \
            "Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"

FDR_THRESHOLD = 0.05

def main():
    if not XLSX_PATH.exists():
        print(f"ERROR: File not found: {XLSX_PATH}", file=sys.stderr)
        sys.exit(1)

    wb = openpyxl.load_workbook(str(XLSX_PATH), read_only=True)
    sheet_names = wb.sheetnames

    print(f"{'='*70}")
    print(f"DEG COUNT BY CELL TYPE — Post vs Pre AAV9 mini-dystrophin treatment")
    print(f"Threshold: p_val_adj < {FDR_THRESHOLD} (BH-adjusted FDR)")
    print(f"Source: {XLSX_PATH.name}")
    print(f"Sheets found: {len(sheet_names)}")
    print(f"{'='*70}\n")

    results = []
    anomalies = []

    for name in sheet_names:
        ws = wb[name]
        total_genes = 0
        sig_count = 0
        nan_padj = 0
        padj_zero = 0
        up = 0
        down = 0
        col_count = 0  # to verify structure

        for row in ws.iter_rows(min_row=2, values_only=True):
            # Skip completely empty rows
            if row[0] is None and all(v is None for v in row):
                continue
            total_genes += 1
            col_count = len(row)

            gene = row[0]
            p_val = row[1]
            avg_log2fc = row[2]
            pct1 = row[3]
            pct2 = row[4]
            p_val_adj = row[5]

            # Check for NaN / None in p_val_adj
            if p_val_adj is None:
                nan_padj += 1
                continue

            if p_val_adj == 0:
                padj_zero += 1

            # Count significant: p_val_adj < 0.05 (includes padj=0)
            if p_val_adj < FDR_THRESHOLD:
                sig_count += 1
                if avg_log2fc is not None:
                    if avg_log2fc > 0:
                        up += 1
                    else:
                        down += 1

        # Check for structural anomalies
        if col_count != 6:
            anomalies.append(f"  {name}: unexpected column count = {col_count}")

        if nan_padj > 0:
            anomalies.append(f"  {name}: {nan_padj} rows with NaN/None p_val_adj")

        results.append({
            "cell_type": name,
            "total_genes": total_genes,
            "sig_degs": sig_count,
            "up": up,
            "down": down,
            "padj_zero": padj_zero,
            "nan_padj": nan_padj,
        })

    wb.close()

    # Sort by sig_degs descending, then by cell_type name for ties
    results.sort(key=lambda x: (-x["sig_degs"], x["cell_type"]))

    # Print full table
    print(f"{'Rank':<5} {'Cell Type':<20} {'Sig DEGs':<10} {'Total':<8} {'Up':<6} {'Down':<6} {'padj=0':<8}")
    print(f"{'-'*5} {'-'*20} {'-'*10} {'-'*8} {'-'*6} {'-'*6} {'-'*8}")
    for i, r in enumerate(results, 1):
        print(f"{i:<5} {r['cell_type']:<20} {r['sig_degs']:<10} {r['total_genes']:<8} {r['up']:<6} {r['down']:<6} {r['padj_zero']:<8}")

    print(f"\n{'='*70}")

    # Report anomalies
    if anomalies:
        print("⚠️  ANOMALIES DETECTED:")
        for a in anomalies:
            print(a)
        print()
    else:
        print("✓ No structural anomalies detected (all sheets: 6 columns, no NaN p_val_adj)")
        print()

    # Final answer
    winner = results[0]
    runner_up = results[1]
    margin = winner["sig_degs"] - runner_up["sig_degs"]

    print(f"🏆 ANSWER: {winner['cell_type']} has the highest number of significantly")
    print(f"   differentially expressed genes after AAV9 mini-dystrophin treatment.")
    print(f"   Count: {winner['sig_degs']} DEGs (p_val_adj < {FDR_THRESHOLD})")
    print(f"   ({winner['up']} up-regulated, {winner['down']} down-regulated)")
    print(f"")
    print(f"   2nd place: {runner_up['cell_type']} with {runner_up['sig_degs']} DEGs")
    print(f"   Margin: {margin} DEGs")
    print(f"{'='*70}")

    # Also print a summary for the final answer
    print(f"\nFINAL ANSWER STRING: {winner['cell_type']}")

if __name__ == "__main__":
    main()
