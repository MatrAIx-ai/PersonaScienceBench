#!/usr/bin/env python3
"""
BixBench bix-37-q2
Question: What is the base protein levels of ENO1 in normal samples according
to the proteomic data? Round your answer to 3 significant figures.

Approach:
  - Read 'data/Proteomic_data .xlsx', sheet 'Tumor vs Normal'.
  - Filter rows where gene == 'ENO1' (cross-check with protein accession P06733).
  - Verify exactly ONE row (no isoform/duplicate ambiguity).
  - Extract the 'Normal' column (absolute intensity-based abundance; unit not
    labeled in the sheet -> reported as-is, NO log transform applied).
  - Round to 3 significant figures.
  - Aborts with a clear message on any discrepancy (multiple rows, NaN, missing).
"""
import sys
import math
import pandas as pd

FILE = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"
GENE = "ENO1"


def round_sig(x: float, sig: int = 3) -> float:
    """Round x to `sig` significant figures."""
    if x == 0:
        return 0.0
    return round(x, -int(math.floor(math.log10(abs(x)))) + (sig - 1))


def main():
    df = pd.read_excel(FILE, sheet_name=SHEET)
    print("Loaded sheet:", SHEET, "shape:", df.shape)
    print("Columns:", list(df.columns))

    # --- Filter for ENO1 ---
    gene_col = df["gene"].astype(str).str.strip()
    mask = gene_col == GENE
    sub = df[mask]
    print(f"\nRows where gene == '{GENE}': {len(sub)}")

    # Cross-check by UniProt accession (Alpha-enolase = P06733)
    acc_mask = df["protein"].astype(str).str.strip() == "P06733"
    print(f"Rows where protein == 'P06733': {int(acc_mask.sum())}")

    # --- Discrepancy guards: abort if not exactly one row ---
    if len(sub) == 0:
        print("ERROR: No row found for ENO1. Stopping.")
        sys.exit(1)
    if len(sub) > 1:
        print("ERROR: Multiple rows found for ENO1 (isoform/duplicate ambiguity). Stopping.")
        print(sub[["protein", "gene", "gene_id", "Normal", "Tumor"]].to_string())
        sys.exit(1)
    if not (acc_mask.sum() == 1):
        print("ERROR: protein accession P06733 count != 1. Stopping.")
        sys.exit(1)

    row = sub.iloc[0]
    raw = row["Normal"]
    print("\n--- ENO1 row details ---")
    for c in ["protein", "Description", "gene", "gene_id", "Normal", "Tumor",
              "Ratio", "FC", "log2FC", "p.value", "adj.Pval", "is_sig", "compare"]:
        print(f"  {c}: {row[c]!r}")

    # --- NaN / type guard ---
    raw = float(raw)
    if math.isnan(raw):
        print("ERROR: 'Normal' value is NaN. Stopping.")
        sys.exit(1)

    rounded = round_sig(raw, 3)
    print("\n--- Result ---")
    print(f"Raw 'Normal' (base protein level, normal): {raw!r}")
    print(f"Rounded to 3 significant figures:          {rounded:.0f}")
    print(f"Scientific notation (3 sig figs):           {raw:.2e}")
    print(f"\nANSWER: {rounded:.0f}  (= {raw:.2e})")


if __name__ == "__main__":
    main()
