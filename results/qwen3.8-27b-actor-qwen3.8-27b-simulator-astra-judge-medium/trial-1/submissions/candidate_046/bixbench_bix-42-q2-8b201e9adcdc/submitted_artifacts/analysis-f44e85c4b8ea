"""
Skewness Analysis of RNA Expression Data (COAD)
Question: What is the skewness of the distribution of RNA expression data?

Method: Fisher-Pearson moment coefficient of skewness (scipy.stats.skew, bias=True)
applied to the pooled distribution of all gene expression values.
"""

import numpy as np
import pandas as pd
from scipy import stats

# --- Load data ---
# File is tab-separated text with .xls extension
df = pd.read_csv('data/COAD__geneExp.xls', sep='\t', index_col=0)
print("=" * 60)
print("RNA EXPRESSION SKEWNESS ANALYSIS — TCGA COAD")
print("=" * 60)
print(f"\nData: {df.shape[0]} genes x {df.shape[1]} samples")
print(f"Total expression values: {df.size:,}")
print(f"Value range: [{df.values.min():.4f}, {df.values.max():.4f}]")
print(f"Zeros: {(df.values == 0).sum():,} ({100*(df.values == 0).mean():.1f}%)")
print(f"NaNs: {df.isna().sum().sum()}")
print(f"Scale: FPKM/FCPm (linear, not log-transformed)")

# --- (a) Pooled skewness (all values flattened) ---
pooled = df.values.ravel()
skew_pooled = stats.skew(pooled, bias=True)

print(f"\n{'─' * 60}")
print(f"(a) POOLED SKEWNESS (all {pooled.size:,} values):")
print(f"    scipy.stats.skew = {skew_pooled:.4f}")

# Qualitative interpretation
if skew_pooled > 1:
    interpretation = "highly right-skewed"
elif skew_pooled > 0.5:
    interpretation = "moderately right-skewed"
elif skew_pooled > -0.5:
    interpretation = "approximately normal (symmetric)"
elif skew_pooled > -1:
    interpretation = "moderately left-skewed"
else:
    interpretation = "highly left-skewed"

print(f"    Interpretation: {interpretation}")

# Supplementary: excluding zeros
nonzero = pooled[pooled > 0]
skew_nonzero = stats.skew(nonzero, bias=True)
print(f"    (Supplementary) Excluding zeros: skew = {skew_nonzero:.4f}")

# --- (c) Supplementary: per-gene and per-sample means ---
gene_means = df.mean(axis=1).values
skew_gene = stats.skew(gene_means, bias=True)

sample_means = df.mean(axis=0).values
skew_sample = stats.skew(sample_means, bias=True)

print(f"\n{'─' * 60}")
print(f"(c) SUPPLEMENTARY CONTEXT:")
print(f"    Per-gene means ({len(gene_means):,} values):  skew = {skew_gene:.4f}")
print(f"    Per-sample means ({len(sample_means)} values):  skew = {skew_sample:.4f}")

# --- Final answer ---
print(f"\n{'=' * 60}")
print(f"ANSWER: The distribution of RNA expression data is highly right-skewed")
print(f"        (Fisher-Pearson skewness = {skew_pooled:.1f}).")
print(f"        The long right tail reflects a small number of very highly")
print(f"        expressed genes, while 15% of values are zero (non-expressed).")
print(f"{'=' * 60}")
