#!/usr/bin/env python3
"""
SELF-CONTAINED workflow (BixBench bix-43-q1)
Question: CBD/cisplatin combination vs DMSO control -> GSEA via gseapy.prerank
with the GO_Biological_Process_2021 gene-set library -> which GO Biological
Process has the lowest adjusted p-value (FDR q-value)?

This script does EVERYTHING from scratch (no pre-existing intermediate files):
  (a) load raw counts + ENSG->symbol map + sample layout
  (b) filter: CPM >= 1 in >= 6 samples
  (c) normalize: DESeq2-like median-of-ratios (size factors) + log2
  (d) differential expression: treatment 'Cisplatin_IC50_CBD_IC50' (9-x) vs
      control 'DMSO' (3-x) -> log2 fold change
  (e) map ENSG->symbol (drop no-symbol; collapse duplicate symbols keeping the
      most-expressed transcript), rank ALL genes by log2FC (descending)
  (f) download the GO_Biological_Process_2021 GMT (Enrichr) if absent
  (g) gseapy.prerank GSEA -> report the term with the lowest FDR q-value,
      its NES, core size, and the top-10 terms.

Requires gseapy + internet (to fetch the GMT) ONLY for step (f)-(g).
Steps (a)-(e) run anywhere with pandas/numpy/scipy and print real diagnostics.
"""
import os, sys
import numpy as np
import pandas as pd
from scipy import stats

DATA = "data"
COUNTS = os.path.join(DATA, "counts_raw_unfiltered.csv")
MAP    = os.path.join(DATA, "ensg_to_gene_name.tsv")
LAYOUT = os.path.join(DATA, "sample_layout.csv")

TREAT = "Cisplatin_IC50_CBD_IC50"      # 9-x  (CBD/cisplatin combination)
CTRL  = "DMSO"                          # 3-x  (DMSO control)
LIB   = "GO_Biological_Process_2021"
CPM_THR, CPM_MIN_SAMPLES = 1, 6
OUTDIR = "gsea_out"

# ---------------------------------------------------------------- (a) load
counts = pd.read_csv(COUNTS, index_col=0)                 # genes x samples
ensg2name = pd.read_csv(MAP, sep="\t")                    # ENSG, gene_name
layout   = pd.read_csv(LAYOUT)                            # fileNames, SampleID, Group

# join layout -> counts columns via SampleID (hyphen -> underscore)
sample2col = {sid: sid.replace("-", "_") for sid in layout["SampleID"]}
col2group  = {sample2col[sid]: g for sid, g in zip(layout["SampleID"], layout["Group"])}
assert set(counts.columns) == set(col2group), "counts columns <-> layout mismatch"
treat_cols = [c for c, g in col2group.items() if g == TREAT]
ctrl_cols  = [c for c, g in col2group.items() if g == CTRL]
print(f"[layout] treatment {TREAT}: {treat_cols}")
print(f"[layout] control   {CTRL}: {ctrl_cols}")

# ---------------------------------------------------------------- (b) filter
libsize = counts.sum(axis=0)
cpm = counts.div(libsize, axis=1) * 1e6
n_pass = (cpm >= CPM_THR).sum(axis=1)
keep = n_pass >= CPM_MIN_SAMPLES
counts_f = counts.loc[keep].copy()
print(f"[filter] CPM>={CPM_THR} in >={CPM_MIN_SAMPLES} samples: "
      f"{counts.shape[0]} -> {counts_f.shape[0]} genes")

# ---------------------------------------------------------------- (c) normalize
J = counts_f.shape[1]
gm = (counts_f.prod(axis=1)) ** (1.0 / J)                 # geometric mean per gene
ratio = counts_f.div(gm, axis=0).replace([np.inf, -np.inf], 0.0)
size_factors = ratio.median(axis=0)                        # per-sample size factor
norm = counts_f.div(size_factors, axis=1)                  # size-factor normalized
lognorm = np.log2(norm + 1.0)                              # log2 (pseudo-count 1)
print("[normalization] median-of-ratios size factors:")
print(size_factors.reindex(counts.columns).round(4).to_string())

# ---------------------------------------------------------------- (d) DE
treat_mean = lognorm[treat_cols].mean(axis=1)
ctrl_mean  = lognorm[ctrl_cols].mean(axis=1)
log2fc = treat_mean - ctrl_mean
tstat, pval = stats.ttest_ind(lognorm[treat_cols].to_numpy(),
                              lognorm[ctrl_cols].to_numpy(),
                              axis=1, equal_var=False)      # Welch (context only)
df = pd.DataFrame({"log2fc": log2fc, "tstat": tstat, "pval": pval})

# ---------------------------------------------------------------- (e) symbols + rank
name = ensg2name.set_index("ENSG")["gene_name"].to_dict()
df["symbol"] = df.index.map(lambda e: name.get(e, e))
df = df[df["symbol"] != df.index]                          # drop no-symbol
df["tot"] = counts_f.sum(axis=1)                            # expression for dup resolution
df = (df.sort_values("tot", ascending=False)
          .drop_duplicates(subset="symbol", keep="first"))  # keep most-expressed
df = df.sort_values("log2fc", ascending=False)              # rank: up in treatment first
ranked_symbols = list(df["symbol"])
print(f"[symbols] genes with a real, unique symbol ranked: {len(ranked_symbols)}")
# evidence by-product (regenerated from scratch each run, not a dependency)
df.reset_index().to_csv("ranked_genes.csv", index=False)
with open("rnk.txt", "w") as f:
    f.write("\n".join(ranked_symbols) + "\n")
print("[rank] Top 10 UP:")
print(df.head(10)[["symbol", "log2fc"]].to_string(index=False))
print("[rank] Top 10 DOWN:")
print(df.tail(10).iloc[::-1][["symbol", "log2fc"]].to_string(index=False))

# ---------------------------------------------------------------- (f) gseapy GSEA
try:
    import gseapy as gp
except ImportError:
    print("\n[!! BLOCKED !!] gseapy is NOT installed in this environment "
          "(and no internet to fetch the GMT).")
    print("     Steps (a)-(e) executed; ranked input 'rnk.txt' + 'ranked_genes.csv' written.")
    print("     In a provisioned environment (gseapy + internet) steps (f)-(g) run here.")
    sys.exit(0)

# ---- (f) obtain the GO_Biological_Process_2021 GMT (Enrichr) ----
gmt = LIB + ".gmt"
if not os.path.exists(gmt):
    url = f"https://maayanlab.cloud/Enrichr/download?mode=text&libraryName={LIB}"
    print(f"[gseapy] downloading GMT: {url}")
    import urllib.request
    urllib.request.urlretrieve(url, gmt)

# ---- (g) run pre-ranked GSEA (robust across gseapy versions) ----
os.makedirs(OUTDIR, exist_ok=True)
core = dict(gene_sets=gmt, min_size=15, max_size=500, no_plot=True)
rnk_file = os.path.join(OUTDIR, "rnk.txt")
with open(rnk_file, "w") as f:                 # regenerated from scratch each run
    f.write("\n".join(ranked_symbols) + "\n")
try:                                            # prefer in-memory list (no file dep)
    pr = gp.prerank(rnk=ranked_symbols, outdir=OUTDIR, processes=1, seed=42, **core)
except Exception:                               # file-based, then minimal fallback
    try:
        pr = gp.prerank(rnk=rnk_file, outdir=OUTDIR, processes=1, seed=42, **core)
    except Exception:
        pr = gp.prerank(rnk=rnk_file, **core)

res = pr.results
# adjusted p-value column (gseapy.prerank default = BH 'FDR q value')
if "FDR q value" in res.columns:
    adj = "FDR q value"
else:
    cands = [c for c in res.columns if "fdr" in c.lower() or "q value" in c.lower()
             or "padjust" in c.lower() or "adjusted" in c.lower()]
    adj = cands[0]
res = res.sort_values(adj)
res.to_csv("gsea_results.csv", index=False)
size_col = "Core Size" if "Core Size" in res.columns else None
top10 = res.head(10).copy()
show_cols = [c for c in ["Term", "NES", adj, size_col] if c in top10.columns]
print("\n[gseapy] Top 10 GO Biological Process terms by adjusted p-value:")
print(top10[show_cols].to_string(index=False))

best = res.iloc[0]
print("\n================ ANSWER ================")
print(f"ANSWER: {best['Term']}")
print(f"  adjusted p-value (FDR q): {best[adj]:.6g}")
print(f"  NES: {best['NES']:.4f}")
if size_col:
    print(f"  core size: {best[size_col]}")
print("  (lowest adjusted p-value GO Biological Process in the "
      f"{TREAT} vs {CTRL} GSEA using {LIB})")
