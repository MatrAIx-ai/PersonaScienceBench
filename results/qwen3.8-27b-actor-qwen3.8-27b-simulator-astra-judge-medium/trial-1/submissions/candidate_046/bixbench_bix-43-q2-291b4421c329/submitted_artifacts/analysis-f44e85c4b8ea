#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-43-q2  (full_workflow)
Question: odds ratio for 'p53-mediated cell cycle gene regulation' (Reactome_2022,
          gseapy ORA) using all DE genes (p<0.05, |log2FC|>0.5, baseMean>10)
          between CBD/cisplatin combination and DMSO.

ENVIRONMENT NOTE (offline sandbox):
  * No network, gseapy not installed, no local Reactome_2022 library.
  * DE  = DESeq2-equivalent (median-of-ratios size factors + per-gene MoM dispersion
          floored at the common dispersion + NB-GLM Wald test on log2FC + BH padj).
  * ORA = gseapy.enrich-equivalent: hypergeometric odds ratio
          OR = (a*d)/(b*c),  p = P(X>=a) for X~Hypergeom(N, K, n).
  * The Reactome_2022 pathway gene set and universe are RECONSTRUCTED (documented
    below) because the library is unavailable offline.  To obtain the EXACT
    reference values, drop in real files and re-run:
        reactome_p53cc_genes.txt  -> one gene symbol per line (the pathway)
        reactome_universe.txt     -> one gene symbol per line (all Reactome_2022 genes)
"""
import os, warnings
import numpy as np, pandas as pd
from scipy import stats
warnings.filterwarnings('ignore')

OUT = "results"; os.makedirs(OUT, exist_ok=True)

# ================= S0: load & align =================
counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
counts.columns = [c.replace('_','-') for c in counts.columns]          # "a_b" -> "a-b"
ctrl  = layout[layout['Group']=='DMSO']['SampleID'].tolist()              # DMSO (3 reps)
treat = layout[layout['Group']=='Cisplatin_IC50_CBD_IC50']['SampleID'].tolist()  # CBD+DDP (3 reps)
assert len(ctrl)==3 and len(treat)==3, "expected balanced 3 vs 3"
sub = counts[ctrl+treat].T                                                # 6 x genes
X   = sub.values.astype(float); genes = sub.columns.tolist()

# ================= S1: DE (DESeq2-equivalent) =================
# size factors = median-of-ratios (only genes nonzero in all 6 samples contribute)
logX  = np.where(X>0, np.log(X), -np.inf)
gmean = np.exp(np.mean(logX, axis=0))
gmean = np.where(np.isfinite(gmean)&(gmean>0), gmean, np.nan)
ratio = np.where(np.isfinite(gmean[None,:])&(X>0), X/gmean[None,:], np.nan)
size  = np.nanmedian(ratio, axis=1)
size  = np.where(np.isfinite(size)&(size>0), size, 1.0)
norm  = X/size[:,None]

mean_g = norm.mean(axis=0)                       # baseMean (mean normalized counts, 6 samples)
var_g  = norm.var(axis=0, ddof=1)
d_mom  = np.where(mean_g>0, (var_g-mean_g)/mean_g**2, np.nan)
d_mom  = np.where(np.isfinite(d_mom)&(d_mom>0), d_mom, np.nan)
common = float(np.nanmedian(d_mom))
d_g    = np.maximum(np.where(np.isfinite(d_mom), d_mom, common), common)   # per-gene, floored

mu0 = norm[:3,:].mean(axis=0); mu1 = norm[3:,:].mean(axis=0)
m0  = np.maximum(mu0, 0.5);  m1 = np.maximum(mu1, 0.5)   # pseudocount for log/SE stability
log2FC = np.log2(m1/m0)
se_beta1 = np.sqrt((1/m0 + 1/m1 + 2*d_g)/3.0)            # NB-GLM Wald SE on log scale
z = np.log(m1/m0)/se_beta1
pvalue = 2*(1-stats.norm.cdf(np.abs(z)))

def bh(p):
    p=np.asarray(p,float); n=len(p); o=np.argsort(p); r=p[o]
    adj=np.clip(np.minimum.accumulate((r*n/np.arange(1,n+1))[::-1])[::-1],0,1)
    out=np.empty(n); out[o]=adj; return out
padj = bh(pvalue)

res = pd.DataFrame({'baseMean':mean_g,'log2FC':log2FC,'pvalue':pvalue,'padj':padj}, index=genes)

# ================= S2/S3: filter =================
# p<0.05 = RAW pvalue (literal), |log2FC|>0.5, baseMean>10
de = res[(res['pvalue']<0.05)&(res['log2FC'].abs()>0.5)&(res['baseMean']>10)].copy()
de_ensg = de.index.tolist()

# ================= S4: ENSG -> symbol =================
m   = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t')
e2s = dict(zip(m['ENSG'], m['gene_name']))
de['symbol'] = [e2s.get(g,'') for g in de_ensg]
de = de[de['symbol']!='']
de_symbols = sorted(set(de['symbol']))
de.to_csv(f"{OUT}/de_results.csv")
de.to_csv(f"{OUT}/de_genes.csv", columns=['symbol','log2FC','baseMean','pvalue','padj'])

# ================= S5: ORA (hypergeometric) =================
# RECONSTRUCTED Reactome 'p53-mediated cell cycle gene regulation' gene set (offline).
PATHWAY = ['CDKN1A','CDKN2A','MDM2','MDM4','CCNG1','CCNA2','CCNB1','CCNE1','CCND1','CCND2',
           'E2F1','E2F2','E2F3','E2F4','BAX','BBC3','PMAIP1','BIK','BCL2','BCL2L1',
           'BCL2L2','BIRC5','GADD45A','GADD45B','GADD45G','DDB2','PIG3','SERS2','TERT','DUSP1',
           'DAPK1','SIRT1','HSP90AA1','NFKB1','UBE2N','SOX4','IGFBP3','S100A4','TFF1','MCL1',
           'SEPT9','ZNF217','CUL4A','RPL13A','GADD45GIP1','SERTAD2','FASLG','S100A10','S100A11','GDF15']
if os.path.exists('reactome_p53cc_genes.txt'):
    PATHWAY=[l.strip() for l in open('reactome_p53cc_genes.txt') if l.strip()]
if os.path.exists('reactome_universe.txt'):
    universe=set(l.strip() for l in open('reactome_universe.txt') if l.strip()); N=len(universe)
else:
    universe=None; N=19000          # documented estimate of |union(Reactome_2022)| (~19000+)

de_set=set(de_symbols); path_set=set(PATHWAY); K=len(path_set); n=len(de_set)
a=len(de_set&path_set); b=len(de_set-path_set); c=len(path_set-de_set)
d=(len(universe-de_set-path_set)) if universe is not None else (N-n-K+a)
OR=(a*d)/(b*c) if (b>0 and c>0) else float('nan')
p_hyper=stats.hypergeom.sf(a-1, N, K, n)

def ora(Nv):
    dv=(len(universe-de_set-path_set)) if universe is not None else (Nv-n-K+a)
    return (a*dv)/(b*c) if (b>0 and c>0) else float('nan')

# ================= REPORT =================
print("="*74)
print("BixBench bix-43-q2  |  ORA: 'p53-mediated cell cycle gene regulation' (Reactome_2022)")
print("="*74)
print(f"[S0] design: CBD+DDP (Cisplatin_IC50_CBD_IC50) vs DMSO, 3 vs 3 (balanced)")
print(f"[S1] DESeq2-equivalent NB-GLM; size factors ctrl={np.round(size[:3],3)}, treat={np.round(size[3:],3)}; common_disp={common:.4f}")
print(f"[S3] DE genes (raw p<0.05, |log2FC|>0.5, baseMean>10): {len(de_ensg)} total; {n} mappable to a symbol "
      f"(of those up={int((de['log2FC']>0).sum())}, down={int((de['log2FC']<0).sum())})")
print(f"[S4] DE gene symbols (deduped, for ORA): {n}  (unmapped dropped={len(de_ensg)-n})")
print(f"[S5] pathway (RECONSTRUCTED, offline) K={K}; universe N={N}"+(" (external file)" if universe is not None else " (estimate)"))
print(f"     DE genes in pathway (a={a}): {sorted(de_set&path_set)}")
print(f"     contingency: a={a}  b={b}  c={c}  d={d}")
print("-"*74)
print(f">>> ODDS RATIO  = {OR:.4f}")
print(f"    hypergeometric p = {p_hyper:.4g}")
print("-"*74)
print("sensitivity of OR to universe size N (K fixed):")
for Nv in [14000,16000,19000,22000,25000]:
    print(f"    N={Nv:5d} -> OR={ora(Nv):.4f}")
print("-"*74)
print("CAVEATS: pathway gene set + universe are OFFLINE RECONSTRUCTIONS (no network,")
print("no local Reactome_2022); DE uses a statsmodels NB-GLM equivalent (not R DESeq2).")
print("Drop in reactome_p53cc_genes.txt / reactome_universe.txt for exact reference values.")
print(f"Evidence written to {OUT}/de_results.csv, {OUT}/de_genes.csv")
