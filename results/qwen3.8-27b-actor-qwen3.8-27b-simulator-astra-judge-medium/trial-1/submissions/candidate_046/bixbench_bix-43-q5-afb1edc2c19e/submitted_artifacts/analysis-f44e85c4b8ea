def log_choose(n,k):
    if k<0 or k>n: return -math.inf
    return gammaln(n+1)-gammaln(k+1)-gammaln(n-k+1)
def hyper_p(A,K,N,n):
    if A==0 or A>K or A>n: return 1.0
    mx=log_choose(K,A)+log_choose(N-K,n-A)-log_choose(N,n); s=0.0
    for x in range(A,min(K,n)+1):
        s+=math.exp(log_choose(K,x)+log_choose(N-K,n-x)-log_choose(N,n)-mx)
    return math.exp(mx)*s
def run_enrich(de_syms,label):
    de_s=set(de_syms); n=len(de_s); rows=[]
    for pw,genes in GMT.items():
        A=len(de_s&genes); K=len(genes)
        if A==0: continue
        odds,p=fisher_exact([[A,n-A],[K-A,len(bg)-K]],alternative="greater")
        pe=hyper_p(A,K,len(bg),n)
        rows.append([pw,A,K,round(pe,3),round(odds,3)])
    df=pd.DataFrame(rows,columns=["pathway","DE_in","pathway_size","hyper_pvalue","odds_ratio"]).sort_values("hyper_pvalue")
    print(f"\n===== {label} (DE n={n}) =====")
    print(df.to_string(index=False))
    return df
