"""CBD/cisplatin combination (group 9) vs DMSO (group 3 vehicle): DESeq2-equivalent NB-GLM
DE + Reactome over-representation (Fisher/hypergeometric). 
DESeq2/pydeseq2 and gseapy+Reactome_2022 are NOT available (no network/package); a from-scratch
NB-GLM (median-of-ratios offset, baseMean=colMeans(counts/sf), correct expected-information
Wald weight mu/(1+phi*mu)) and a LOCAL reconstructed Reactome GMT substitute are used."""
import numpy as np, pandas as pd, warnings, math
from scipy.special import gammaln
from scipy.stats import norm, fisher_exact
warnings.filterwarnings("ignore")
COMBO="Cisplatin_IC50_CBD_IC50"; CTRL="DMSO"
