gby=dict(zip(layout["col"],layout["Group"]))
allc=[f"{a}_{b}" for a in range(1,11) for b in range(1,4)]
allc=[c for c in allc if c in counts.columns]
def size_factors(X):
    with np.errstate(divide='ignore',invalid='ignore'):
        gmean=np.exp(np.mean(np.log(X),axis=1))
    v=gmean>0; r=np.full_like(X,np.nan); r[v]=X[v]/gmean[v][:,None]
    return np.nanmedian(r,axis=0)
sel=[c for c in allc if gby[c] in (COMBO,CTRL)]
X=counts[sel].to_numpy(float); n=X.shape[1]
sf=size_factors(X); off=np.log(sf); baseMean=(X/sf).mean(1)
treat=np.array([1.0 if gby[c]==COMBO else 0.0 for c in sel])
design=np.column_stack([np.ones(n),treat]); ctr=np.array([0.,1.]); p=2
print("DE comparison:", COMBO, "vs", CTRL, "| samples:", sel)
print("size factors:", np.round(sf,4).tolist())
MAXB=12.0
def fit_mean(y):
    beta=np.zeros(p)
    def ll(b):
        l=np.clip(design@b+off,-50,50); return np.sum(y*l-np.exp(l))
    for _ in range(500):
        lin=np.clip(design@beta+off,-50,50); mu=np.exp(lin); W=mu
        XtWX=design.T@(W[:,None]*design); grad=design.T@(y-mu)
        try: step=np.linalg.solve(XtWX,grad)
        except: break
        cur=ll(beta); h=1.0
        while h>1e-4:
            cand=np.clip(beta+h*step,-MAXB,MAXB)
            if ll(cand)>cur-1e-9: break
            h*=0.5
        bnew=np.clip(beta+h*step,-MAXB,MAXB)
        if np.max(np.abs(bnew-beta))<1e-8: beta=bnew; break
        beta=bnew
    return beta,np.exp(np.clip(design@beta+off,-50,50))
G=X.shape[0]; genes=counts.index.to_numpy()
try:
    betas=np.load("de_betas.npy"); mus=np.load("de_mus.npy"); print("reusing cached GLM fits")
except Exception:
    betas=np.full((G,p),np.nan); mus=np.zeros((G,n))
    for i in range(G):
        y=X[i]
        if y.sum()<=0: continue
        b,mu=fit_mean(y); betas[i]=b; mus[i]=mu
    np.save("de_betas.npy",betas); np.save("de_mus.npy",mus)
def nbll_vec(Y,M,phi):
    ip=1.0/phi
    return (gammaln(Y+ip)-gammaln(Y+1)-gammaln(ip)+ip*(np.log(M)-np.log1p(phi*M))-Y*np.log1p(phi*M)).sum()
okm=np.isfinite(betas[:,1]); phis=np.logspace(-5,0.5,1200)
tot=np.array([nbll_vec(X[okm],mus[okm],ph) for ph in phis]); phi_shared=phis[np.argmax(tot)]
pearson=np.full(G,np.nan)
for i in range(G):
    y=X[i]
    if y.sum()<=0 or not np.isfinite(betas[i,1]): continue
    mu=mus[i]; S=np.sum((y-mu)**2/mu); sm=mu.sum()
    if sm>0: pearson[i]=max((S-n)/sm,0.0)
ok=(np.isfinite(pearson))&(pearson>1e-5)&(baseMean>0); w=np.full(int(ok.sum()),n-p)
xv=np.log2(baseMean[ok].clip(1e-3,None)); yv=np.log2(pearson[ok])
A=np.column_stack([np.ones_like(xv),xv]); wA=A*w[:,None]
bt=np.linalg.solve(wA.T@A,wA.T@yv)
phi_trend=np.clip(2.0**(bt[0]+bt[1]*np.log2(baseMean.clip(1e-3,None))),1e-5,None)
print("shared dispersion:",round(float(phi_shared),5),"| trend log2(phi)=%.3f+%.3f*log2(bm)"%(bt[0],bt[1]))
def wald_p(betas,mus,phi):
    out=np.full(G,np.nan)
    for i in range(G):
        if not np.isfinite(betas[i,1]): continue
        mu=mus[i]; phi_i=phi[i] if np.ndim(phi)>0 else phi
        W=mu/(1.0+phi_i*mu); M=design.T@(W[:,None]*design)
        if not np.all(np.isfinite(M)): continue
        try: cov=np.linalg.inv(M)
        except: cov=np.linalg.pinv(M)
        v=ctr@cov@ctr
        if v<=0 or not np.isfinite(v): continue
        z=(ctr@betas[i])/np.sqrt(v); out[i]=2*(1-norm.cdf(abs(z)))
    return out
pv_sh=wald_p(betas,mus,phi_shared); pv_tr=wald_p(betas,mus,phi_trend)
lfc=(ctr@betas.T)/np.log(2)
def bh(pv):
    pv=np.asarray(pv,float); m=np.isfinite(pv); out=np.full_like(pv,np.nan)
    if m.sum()==0: return out
    idx=np.where(m)[0]; p=pv[idx]; srt=np.argsort(p); r=np.arange(1,len(p)+1)
    t=np.clip(p[srt]*len(p)/r,0,1); t=np.minimum.accumulate(t[::-1])[::-1]
    arr=np.full(len(p),np.nan); arr[srt]=t; out[idx]=arr; return out
