#!/usr/bin/env python3
"""
BixBench bix-46-q1
Question: log2 fold change (rounded to 2 decimals) for mexG expression in
          Delta-rhlI (strain #97) compared to wt (strain #1).

Inputs:
  data/res_1vs97.rds   : DESeq2 results() table (class DESeqResults), gzip-compressed
                         custom R-serialization variant (see format notes below).
  data/res_1vs98.rds   : same structure, comparison wt vs strain #98 (cross-check only).
  data/Pseudomonas_aeruginosa_UCBPP-PA14.csv : PGDB v22.1 genome annotation
                         (5984 genes); used to map gene name mexG -> locus tag.

No R / pyreadr / internet is available in this environment, so a minimal
parser for the observed binary layout is implemented here.

Decoded binary layout (verified empirically on both files):
  * File = gzip(R-serialized object).
  * Row-name block: at offset 0x5d, 5828 string entries of 18 bytes each:
        04 00 09 00 00 00 <len:1> <utf8 bytes> <00>
    (first entry PA14_09540 = mexG).
  * Six numeric columns, each a block of 5828 BIG-ENDIAN float64 values,
    located right after an 8-byte header  00 00 00 0e 00 00 16 c4
    ('16 c4' = 5828 in big-endian). Block starts (anchor of '16 c4' + 2):
        baseMean=0x1a87c  log2FoldChange=0x25ea4  lfcSE=0x314cc
        stat=0x3caf4      pvalue=0x4811c          padj=0x53744
    Blocks are exactly contiguous (46624 bytes each); column order matches
    the 'names' attribute (baseMean, log2FoldChange, lfcSE, stat, pvalue, padj)
    found at the end of the file, plus class 'DESeqResults' / package 'DESeq2'.
  * Rows are sorted by padj (ascending) in each file.

Validation performed (all must pass):
  V1  5828 row names, all unique, all matching PA14_\\d{5}.
  V2  baseMean > 0 for all rows; lfcSE > 0 for all rows.
  V3  stat == log2FoldChange / lfcSE for all rows (Wald test identity).
  V4  pvalue == 2*(1-Phi(|stat|)) for all rows.
  V5  padj >= pvalue for all rows; padj non-decreasing down the rows.
  V6  Same 5828 locus tags in res_1vs98.rds; same internal identities hold;
      mexG (PA14_09540) found in both files.
  V7  CSV: mexG maps to exactly one locus tag.
"""
import gzip
import math
import re
import struct
import sys

import pandas as pd

N = 5828
TAGS_OFF = 0x5d
ANCHORS = {  # offset of the '16 c4' count field in each column header
    "baseMean": 0x1A87C,
    "log2FoldChange": 0x25EA4,
    "lfcSE": 0x314CC,
    "stat": 0x3CAF4,
    "pvalue": 0x4811C,
    "padj": 0x53744,
}
COLS = list(ANCHORS)


def norm_sf(x):
    """Two-sided normal p-value 2*(1-Phi(|x|)) without scipy."""
    return math.erfc(abs(x) / math.sqrt(2.0))


def load_rds(path):
    raw = gzip.open(path, "rb").read()

    # --- row names (5828 x 18-byte entries) ---
    tags = []
    for i in range(N):
        off = TAGS_OFF + i * 18
        assert raw[off:off + 6] == bytes([4, 0, 9, 0, 0, 0]), (path, i)
        ln = raw[off + 6]
        s = raw[off + 7:off + 7 + ln].decode("utf-8")
        assert raw[off + 7 + ln] == 0, (path, i)
        tags.append(s)

    # --- six big-endian double columns ---
    cols = {}
    for name, anchor in ANCHORS.items():
        assert raw[anchor:anchor + 2] == b"\x16\xc4", (path, name)  # count 5828 BE
        off = anchor + 2
        cols[name] = struct.unpack(f">{N}d", raw[off:off + 8 * N])
    return tags, cols


def validate(path, tags, cols):
    lfc, se, st, pv, pa = (cols[k] for k in
                           ("log2FoldChange", "lfcSE", "stat", "pvalue", "padj"))
    assert len(set(tags)) == N, f"{path}: row names not unique"
    assert all(re.fullmatch(r"PA14_\d{5}", t) for t in tags), f"{path}: bad tag"
    assert all(x > 0 for x in cols["baseMean"]), f"{path}: baseMean not all > 0"
    assert all(x > 0 for x in se), f"{path}: lfcSE not all > 0"
    bad = [i for i in range(N)
           if abs(lfc[i] / se[i] - st[i]) > 1e-3 * max(1.0, abs(st[i]))]
    assert not bad, f"{path}: stat != lfc/se in {len(bad)} rows"
    bad = [i for i in range(N)
           if abs(norm_sf(st[i]) - pv[i]) > 1e-8 * max(pv[i], 1e-300) + 1e-300]
    assert not bad, f"{path}: pvalue != 2*sf(|stat|) in {len(bad)} rows"
    bad = [i for i in range(N) if pa[i] < pv[i] - 1e-12]
    assert not bad, f"{path}: padj < pvalue in {len(bad)} rows"
    bad = [i for i in range(N - 1) if pa[i] > pa[i + 1]]
    assert not bad, f"{path}: padj not sorted ascending"
    print(f"[validate] {path}: all internal-consistency checks passed "
          f"(unique tags, baseMean>0, lfcSE>0, stat=lfc/se, pvalue=2*sf(|stat|), "
          f"padj>=pvalue, rows sorted by padj)")


def main():
    # 1) gene name -> locus tag from PGDB annotation
    df = pd.read_csv("data/Pseudomonas_aeruginosa_UCBPP-PA14.csv")
    hits = df[df["Gene Name"].astype(str).str.strip() == "mexG"]
    assert len(hits) == 1, f"mexG not unique in CSV: {len(hits)} hits"
    locus = hits["Locus Tag"].iloc[0]
    print(f"[map] mexG -> {locus} (CSV rows: {len(df)}, unique match: {len(hits)})")

    # 2) parse both result tables
    tags97, c97 = load_rds("data/res_1vs97.rds")
    tags98, c98 = load_rds("data/res_1vs98.rds")
    validate("data/res_1vs97.rds", tags97, c97)
    validate("data/res_1vs98.rds", tags98, c98)
    assert set(tags97) == set(tags98), "tag sets differ between files"
    print(f"[cross-check] both files contain the same {N} locus tags; "
          f"mexG present in both: {locus in tags97 and locus in tags98}")

    # 3) extract mexG row from the 1vs97 table (wt #1 vs Delta-rhlI #97)
    i = tags97.index(locus)
    row = {k: c97[k][i] for k in COLS}
    print(f"\n[mexG row in res_1vs97] (row index {i}; table sorted by padj asc)")
    for k in COLS:
        print(f"  {k:15s} = {row[k]:.6g}")

    lfc = row["log2FoldChange"]
    answer = round(lfc, 2)
    print(f"\nANSWER: log2FoldChange(mexG, Delta-rhlI #97 vs wt #1) = {lfc:.6f} "
          f"-> rounded to 2 decimals: {answer}")
    return answer


if __name__ == "__main__":
    sys.exit(0 if main() is not None else 1)
