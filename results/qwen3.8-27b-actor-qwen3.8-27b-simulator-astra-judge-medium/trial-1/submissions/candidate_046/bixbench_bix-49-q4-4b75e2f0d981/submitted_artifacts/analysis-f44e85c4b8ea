#!/usr/bin/env Rscript
# ============================================================================
# REQUIRED METHOD: DESeq2 differential expression with LFC shrinkage
#                  lfcShrink(type = "apeglm")
# Question: total number of significantly DE genes (padj < 0.05), UP + DOWN,
#           disease (ASXL1 mutation) vs control.
#
# Dependencies (must be installed in the R environment):
#   DESeq2, apeglm, and readxl (or openxlsx) for the xlsx coldata.
# ============================================================================
suppressPackageStartupMessages({
  library(DESeq2)
  if (!requireNamespace("apeglm", quietly = TRUE))
    stop("Package 'apeglm' is required for lfcShrink(type='apeglm').")
  if (requireNamespace("readxl", quietly = TRUE)) {
    read_xl <- function(p, s="Sheet1") as.data.frame(readxl::read_excel(p, sheet = s))
  } else if (requireNamespace("openxlsx", quietly = TRUE)) {
    read_xl <- function(p, s="Sheet1") as.data.frame(openxlsx::read.xlsx(p, sheet = s))
  } else stop("Need 'readxl' or 'openxlsx' to read the xlsx coldata.")
})

base <- "data"

# ---- 1. Raw featureCounts gene table (whitespace-delimited) ----
counts <- read.table(file.path(base, "Issy_ASXL1_blood_featureCounts_GeneTable_final.txt"),
                     header = TRUE, sep = "\\s+", row.names = 1,
                     check.names = FALSE, comment.char = "", quote = "")
counts <- as.matrix(counts)
storage.mode(counts) <- "integer"
cat("Count matrix read:", nrow(counts), "genes x", ncol(counts), "samples\n")

# ---- 2. coldata (Sheet1) ----
coldata <- read_xl(file.path(base, "Issy_ASXL1_blood_coldata_gender.xlsx"), sheet = "Sheet1")
coldata <- coldata[, c("sample", "condition")]
rownames(coldata) <- coldata$sample
coldata$sample <- NULL

# ---- 3. Keep only samples present in BOTH count table and coldata ----
#        (drops MGD1640B and MGD1641B, which have no condition label)
common  <- intersect(colnames(counts), rownames(coldata))
dropped <- setdiff(colnames(counts), rownames(coldata))
counts  <- counts[, common, drop = FALSE]
coldata <- coldata[common, , drop = FALSE]
cat("Dropped samples (no condition):", paste(dropped, collapse = ", "), "\n")

# ---- 4. condition factor, reference = Control, test = ASXL1 ----
coldata$condition <- factor(coldata$condition, levels = c("Control", "ASXL1"))
stopifnot(!anyNA(coldata$condition), all(colnames(counts) == rownames(coldata)))
tab <- table(coldata$condition)
cat("Groups -> Control =", tab[["Control"]], "  ASXL1 =", tab[["ASXL1"]], "\n")

# ---- 5. DESeqDataSet, design ~ condition ----
dds <- DESeqDataSetFromMatrix(countData = counts, colData = coldata, design = ~ condition)

# ---- 6. DESeq2 (size factors = median-of-ratios; default parametric dispersion) ----
dds <- DESeq(dds)

# ---- 7. Wald results (MLE) + apeglm LFC shrinkage ----
res_mle <- results(dds, contrast = c("condition", "ASXL1", "Control"))
res_ape <- lfcShrink(dds, contrast = c("condition", "ASXL1", "Control"), type = "apeglm")

# ---- 8. Count significant genes (padj < 0.05), UP and DOWN ----
r   <- as.data.frame(res_ape)
sig <- r[!is.na(r$padj) & r$padj < 0.05, , drop = FALSE]
up    <- sum(sig$log2FoldChange > 0)
down  <- sum(sig$log2FoldChange < 0)
total <- nrow(sig)

# ---- 9. Save + report ----
write.csv(r, "results_apeglm.csv", row.names = TRUE)
cat("\n================= DESeq2 + apeglm RESULT =================\n")
cat("n samples         :", ncol(dds), "\n")
cat("  ASXL1 (disease) :", sum(as.character(dds$condition) == "ASXL1"), "\n")
cat("  Control         :", sum(as.character(dds$condition) == "Control"), "\n")
cat("n genes (matrix)  :", nrow(dds), "\n")
cat("n genes w/ padj   :", sum(!is.na(r$padj)), "\n")
cat("UP   (log2FC>0)   :", up, "\n")
cat("DOWN (log2FC<0)   :", down, "\n")
cat("TOTAL padj<0.05   :", total, "\n")
cat("===========================================================\n")
