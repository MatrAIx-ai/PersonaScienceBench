#!/usr/bin/env python3
# ============================================================================
# CAVEAT: This is a PYTHON REIMPLEMENTATION of the DESeq2 + apeglm pipeline,
# used ONLY because R / DESeq2 / apeglm are NOT available in this environment.
# It is a best-effort APPROXIMATION, NOT native DESeq2. The canonical, required
# method is the R script (solution.R) using DESeq2 + lfcShrink(type="apeglm").
#
# Question: total number of significantly DE genes (padj < 0.05), up + down,
#           disease (ASXL1) vs control, with apeglm LFC shrinkage.
# ============================================================================
import numpy as np
import pandas as pd
from scipy.stats import norm

RNG = np.random.default_rng(0)
base = "data"

# ---- 1. Read raw featureCounts gene table (whitespace-delimited) ----
counts = pd.read_csv(f"{base}/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt",
                     sep=r"\s+", index_col=0)
genes = counts.index.astype(str).to_numpy()
sample_cols = list(counts.columns)
counts = counts.values.astype(float)

# ---- 2. Read coldata (Sheet1) ----
coldata = pd.read_excel(f"{base}/Issy_ASXL1_blood_coldata_gender.xlsx", sheet_name="Sheet1")
coldata = coldata.set_index("sample")

# ---- 3. Keep only samples present in BOTH (drops MGD1640B, MGD1641B) ----
common = [c for c in sample_cols if c in coldata.index]
dropped = [c for c in sample_cols if c not in coldata.index]
colpos = {c:i for i,c in enumerate(sample_cols)}
counts = counts[:, [colpos[c] for c in common]]
cond = coldata.loc[common, "condition"].to_numpy()
g = (cond == "ASXL1").astype(bool)
n = counts.shape[1]
n_asxl1, n_ctrl = int(g.sum()), int((~g).sum())
idx1 = np.where(g)[0]; idx0 = np.where(~g)[0]
s = counts[:, idx0]; d1 = counts[:, idx1]   # control, asxl1

# ---- 4. Size factors: median of ratios (genes with all counts > 0) ----
allpos = (counts > 0).all(axis=1)
ref = np.exp(np.log(counts[allpos]).mean(axis=1))
size_factors = np.median(counts[allpos] / ref[:, None], axis=0)

# ---- 5. Normalized counts ----
X0 = s / size_factors[idx0][None, :]   # (genes, n_ctrl)
X1 = d1 / size_factors[idx1][None, :]  # (genes, n_asxl1)

# ---- 6. Group means (Poisson MLE init, small offset) ----
eps = 1e-12
m0 = (X0.sum(axis=1) / n_ctrl).clip(eps)   # per-size-factor mean, control
m1 = (X1.sum(axis=1) / n_asxl1).clip(eps)  # per-size-factor mean, asxl1

# ---- 7. Within-group method-of-moments dispersion (using group means) ----
def within_group_disp(X, m, sf):
    # X: (genes, ng), m: (genes,) per-size-factor mean, sf: (ng,) size factors
    mu = m[:, None] * sf[None, :]           # observed mean per sample
    r = X - mu
    contrib = (r**2 - r) / mu**2            # NB excess-variance contribution
    return np.clip(contrib.mean(axis=1), 0.0, None)

phi_hat = within_group_disp(X0, m0, size_factors[idx0]) + within_group_disp(X1, m1, size_factors[idx1])
phi_hat = phi_hat / 2.0
# refine: one Newton pass for group means given phi_hat, then recompute dispersion
def newton_means(X, m, sf, phi, iters=60):
    # NB score for per-size-factor mean m:  sum_j (y_ij - s_j m)/(k + s_j m) = 0
    # where y_ij = X_ij * s_j  (X = size-factor-normalized counts)
    k = 1.0 / np.maximum(phi, 1e-6)          # (genes,)  NB size
    Y = X * sf[None, :]                       # (genes, ng) raw counts
    for _ in range(iters):
        sm = sf[None, :] * m[:, None]         # (genes, ng)  s_j * m
        kk = k[:, None]
        f  = (sf[None, :] * (X - m[:, None]) / (kk + sm)).sum(axis=1)           # (genes,)
        fp = -(sf[None, :] * (kk + Y) / (kk + sm)**2).sum(axis=1)               # (genes,) <0
        fp = np.where(np.abs(fp) < 1e-30, -1e-30, fp)
        m  = np.clip(m - f / fp, eps, None)   # (genes,)
    return m

phi_pos = np.where(phi_hat > 0, phi_hat, 1e-3)
m0 = newton_means(X0, m0, size_factors[idx0], phi_pos)
m1 = newton_means(X1, m1, size_factors[idx1], phi_pos)
phi_hat = (within_group_disp(X0, m0, size_factors[idx0]) + within_group_disp(X1, m1, size_factors[idx1])) / 2.0

# ---- 8. Parametric dispersion trend + EB shrinkage ----
mean_i = (X0.sum(axis=1) + X1.sum(axis=1)) / n
lm = np.log(mean_i.clip(eps))
valid = (phi_hat > 0) & (mean_i > 0)
A = np.column_stack([np.ones(valid.sum()), lm[valid], lm[valid]**2])
coef, *_ = np.linalg.lstsq(A, np.log(phi_hat[valid]), rcond=None)
trend_log = coef[0] + coef[1]*lm + coef[2]*lm**2
resid = np.log(phi_hat[valid]) - (coef[0] + coef[1]*lm[valid] + coef[2]*lm[valid]**2)
dispPrior = max(np.std(resid, ddof=1), 0.1)
SE_L = 1.0/np.sqrt(n/2.0)          # approx SE of log-dispersion
w = dispPrior**2 / (dispPrior**2 + SE_L**2)
phi_shrunk = np.where(phi_hat > 0,
                      np.exp(w*np.log(phi_hat) + (1-w)*trend_log),
                      np.exp(trend_log))
phi_shrunk = np.clip(phi_shrunk, 1e-4, None)

# ---- 9. Final group means (Newton given shrunken dispersion) + LFC/SE ----
m0f = newton_means(X0, m0, size_factors[idx0], phi_shrunk)
m1f = newton_means(X1, m1, size_factors[idx1], phi_shrunk)
ln2 = np.log(2.0)
log2LFC = (np.log(m1f) - np.log(m0f)) / ln2
# Fisher info for eta_g (natural log scale)
def fisher(X, m, sf, phi):
    sm = m[:, None]*sf[None, :]
    return (sm / (1.0 + phi[:, None]*sm)).sum(axis=1)
I0 = fisher(X0, m0f, size_factors[idx0], phi_shrunk)
I1 = fisher(X1, m1f, size_factors[idx1], phi_shrunk)
SE_eta0 = 1.0/np.sqrt(np.maximum(I0, 1e-30)); SE_eta1 = 1.0/np.sqrt(np.maximum(I1, 1e-30))
SE_log2 = np.sqrt(SE_eta0**2 + SE_eta1**2) / ln2

# mask genes with no info in either group
usable = (I0 > 0) & (I1 > 0) & np.isfinite(log2LFC)

# ---- 10. apeglm-style EB LFC shrinkage (normal-means approximation) ----
b = log2LFC[usable]; sg = SE_log2[usable]
tau2 = max(0.0, (b**2).mean() - (sg**2).mean())
shrink = tau2 / (tau2 + sg**2)
b_shrunk = b * shrink
stat = b_shrunk / sg
p = 2.0*norm.sf(np.abs(stat))
# Benjamini-Hochberg
order = np.argsort(p); ranks = np.arange(1, len(p)+1)
bh = (len(p)/ranks) * p[order]          # t_i = (n/i) * p_(i)
bh = np.minimum.accumulate(bh[::-1])[::-1]  # padj_(i)=min_{j>=i} t_j
padj = np.empty(len(p)); padj[order] = bh



# ---- 11. Report (single best-effort apeglm estimate) ----
def bh(pv):
    o = np.argsort(pv); r = np.arange(1, len(pv)+1)
    t = (len(pv)/r)*pv[o]; t = np.minimum.accumulate(t[::-1])[::-1]
    padj = np.empty(len(pv)); padj[o] = t; return padj
def cnt(bs):
    pv = 2.0*norm.sf(np.abs(bs/sg)); padj = bh(pv); s = padj < 0.05
    return int(s.sum()), int(((bs>0)&s).sum()), int(((bs<0)&s).sum())

z = b/sg
# MLE (unshrunken) reference [DESeq2 results() before lfcShrink]
tot_mle, up_mle, dn_mle = cnt(b)

# PRIMARY apeglm estimate: robust data-driven common-normal EB prior.
#   tau^2 = median over likely-DE genes (|z|>2) of (beta^2 - se^2)  [excess LFC^2]
# This is empirical-Bayes (data-driven) and robust (median, focused on DE genes,
# immune to the huge-SE low-count genes that make the naive MLE prior collapse to 0).
mask_de = np.abs(z) > 2.0
tau2 = max(0.0, np.median(b[mask_de]**2 - sg[mask_de]**2))
shrink = tau2/(tau2 + sg**2)
bs = b*shrink
pv = 2.0*norm.sf(np.abs(bs/sg)); padj = bh(pv); s = padj < 0.05
tot_ap, up_ap, dn_ap = int(s.sum()), int(((bs>0)&s).sum()), int(((bs<0)&s).sum())

pd.DataFrame({"gene": genes, "baseMean": mean_i, "log2FoldChange": b,
              "lfcSE": sg, "log2FC_apeglm_shrunken": bs, "padj_apeglm_est": padj}).to_csv(
              "results_py_estimate.csv", index=False)

print("================= PYTHON BEST-EFFORT apeglm ESTIMATE =================")
print("!! NOT native DESeq2/apeglm: R is objectively unavailable in this env. !!")
print("n samples        :", n, f"( ASXL1={n_asxl1}, Control={n_ctrl} )")
print("dropped (no cond):", dropped)
print("n genes analyzed :", len(genes))
print("---------------------------------------------------------------")
print("PRIOR (apeglm approx): robust common-normal EB, tau^2=%.4g" % tau2)
print("   (median excess LFC^2 over likely-DE genes |z|>2; prior SD=%.3g log2FC)" % np.sqrt(tau2))
print(">>> PRIMARY apeglm best-effort (padj<0.05): TOTAL=%d  (UP=%d, DOWN=%d)" % (tot_ap, up_ap, dn_ap))
print("---------------------------------------------------------------")
print("reference (unshrunken MLE Wald, no apeglm): TOTAL=%d (UP=%d, DOWN=%d)" % (tot_mle, up_mle, dn_mle))
print("NOTE: the naive data-driven (marginal-likelihood) apeglm prior over-shrinks")
print("      to 0 here (modest condition effect); the robust prior above is used.")
print("      Authoritative value = run solution.R with native DESeq2 + apeglm.")
print("=====================================================================")
