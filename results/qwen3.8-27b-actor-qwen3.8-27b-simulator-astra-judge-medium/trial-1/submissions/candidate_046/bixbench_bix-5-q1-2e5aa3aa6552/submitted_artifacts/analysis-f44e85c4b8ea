#!/usr/bin/env python3
"""
BixBench bix-5-q1  --  full workflow
Q: Which is statistically the most enriched GO biological process in
   samples from diseased patients compared to control?

APPROVED PIPELINE (researcher-approved):
 1. Restrict to the 14 samples with coldata (drop MGD1640F/MGD1641F).
 2. DE disease vs control:
    - size-factor normalization (median-of-ratios, DESeq2-style)
    - filterByExpr-style low-count filter (CPM>=10 in >=3 samples)
    - linear model ~ sex + condition  (limma/voom style, t/Wald test)
    - eBayes variance moderation (data-driven df0/s2_0 via fitFDist MLE)
    - Benjamini-Hochberg FDR
 3. Up in disease: padj < 0.05 AND log2FC > 0.
 4. ENSG -> gene symbol via gencode gene_name.
 5. GO BP over-representation enrichment (source auto-detection).

NOTE: gencode `ont` column is EMPTY and no GO:BP annotation is present in
 the inputs; this sandbox has no internet / gseapy / clusterProfiler / R /
 local GO DB -> step 5 reports the blocker (per researcher instruction).
"""
import numpy as np, pandas as pd, glob, warnings
from scipy import stats
from scipy.optimize import minimize_scalar
warnings.filterwarnings("ignore")
DATA = "data"

# --------------------------------------------------------------- inputs
fc  = pd.read_csv(f"{DATA}/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt",
                  sep=r"\s+", index_col=0)
col = pd.read_excel(f"{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx")
gc  = pd.read_csv(f"{DATA}/gencode.v31.primary_assembly.genes.csv")

# [1] 14 samples with metadata
s14 = list(col["sample"])
dropped = sorted(set(fc.columns) - set(s14))
fc = fc[s14]
sex  = (col["sex"] == "M").astype(float).values
cond = (col.condition == "disease").astype(float).values
n = len(s14)
print(f"[1] samples={n}  dropped(no metadata)={dropped}")
print(f"    condition={dict(pd.Series(col['condition']).value_counts())}  "
      f"sex={dict(pd.Series(col['sex']).value_counts())}")

# [2] size factors (median-of-ratios)
C = fc.values.astype(float)                       # G x n
gm = np.where(C.mean(1) > 0, C.mean(1), np.nan)
sf = np.nanmedian(C / gm[:, None], 0)
sf = np.where(np.isfinite(sf) & (sf > 0), sf, 1.0)
cpm = C / sf[None, :] * 1e6

# [2b] filterByExpr-style filter
keep = (cpm >= 10).sum(1) >= 3
Cf = C[keep]
idx = fc.index[keep]
print(f"[2] size factors ok; filter CPM>=10 in >=3 samples: "
      f"{keep.sum()}/{len(idx)} genes kept")

# [2c] log2-CPM (prior count 2) + linear model ~ sex + condition
l2 = np.log2((Cf + 2.0) / sf[None, :])            # Gf x n
X  = np.column_stack([np.ones(n), sex, cond])
p  = X.shape[1]; df = n - p
Y  = l2.T
XtX_inv = np.linalg.inv(X.T @ X)
beta = XtX_inv @ (X.T @ Y)                          # 3 x Gf
resid = Y - X @ beta
s2 = (resid ** 2).sum(0) / df

# [2d] eBayes moderation (fitFDist MLE)
def fit_fd0(s2, df):
    s2 = s2[s2 > 1e-10]; m = s2.size
    df0, s20 = 20.0, float(np.median(s2))
    for _ in range(40):
        s20 = s2.sum() / (m * df0 / (df0 - 2))
        def obj(x):
            return m*(df+x)/2*np.log(x/(x+2)) - x/2*np.sum(np.log(x + df*s2/s20))
        df0 = minimize_scalar(lambda x: -obj(x), bounds=(2.01, 1e5),
                              method="bounded").x
    return s20, df0
s20, df0 = fit_fd0(s2, df)
s2m = (df0*s20 + df*s2) / (df0 + df); dft = df0 + df
se  = np.sqrt(s2m * XtX_inv[2, 2])
l2fc = beta[2]; tstat = l2fc / se
pval = 2.0 * stats.t.sf(np.abs(tstat), dft); pval[s2 <= 0] = 1.0

def bh(p):
    p = np.asarray(p, float); m = len(p); o = np.argsort(p); r = np.arange(1, m+1)
    a = np.minimum.accumulate((p[o]*m/r)[::-1])[::-1]
    out = np.empty(m); out[o] = np.clip(a, 0, 1); return out
padj = bh(pval)

res = pd.DataFrame({"log2FC": l2fc, "pvalue": pval, "padj": padj}, index=idx)
res = res.sort_values("padj")
print(f"[2] DE: genes tested={len(res)}  df0={df0:.2f}  s2_0={s20:.5f}")

# [3] up in disease
up = res[(res["padj"] < 0.05) & (res["log2FC"] > 0)]
print(f"[3] up in disease (padj<0.05 & log2FC>0): {len(up)} genes")

# [4] ENSG -> symbol
sym = gc.set_index("gene_id")["gene_name"]
res["symbol"] = res.index.map(sym)
up = up.copy(); up["symbol"] = up.index.map(sym)
print(f"[4] symbol coverage: {res['symbol'].notna().sum()}/{len(res)}")
print("\nTop up-in-disease genes (by padj):")
print(up.head(20).to_string())

res.to_csv("de_results.csv")
up.to_csv("de_up_in_disease.csv")
print(f"\n[4] up-gene symbols ({len(up)}):")
print(list(up["symbol"].dropna()))

# --------------------------------------------------------------- [5] GO BP ORA
print("\n[5] GO BP enrichment -- source auto-detection:")
ont = gc["ont"]; n_ont = int(ont.notna().sum())
print(f"    gencode 'ont' non-null = {n_ont}/{len(gc)}")
go_tokens = {}
for f in ["data/gencode.v31.primary_assembly.genes.csv", "data/HGNC_05-09-19.txt"]:
    with open(f) as fh:
        go_tokens[f] = sum(1 for line in fh if "GO:" in line)
print(f"    'GO:' lines: {go_tokens}")
pats = ["**/*gene2go*","**/*org.Hs.eg*","**/*GO.db*","**/*goslim*","**/*.gmt",
        "**/*go_bp*","**/*goa*.txt"]
found = set()
for pat in pats:
    for m in glob.glob(pat, recursive=True):
        if "gnome" in m.lower() or "libgoa" in m.lower():
            continue
        found.add(m)
print(f"    local GO annotation files: {sorted(found) if found else 'NONE'}")
try:
    import gseapy; gsea_ok = True
except Exception:
    gsea_ok = False
print(f"    gseapy available: {gsea_ok}")

go_ok = (n_ont > 0) or (any(v > 0 for v in go_tokens.values())) or (len(found) > 0) or gsea_ok
if go_ok:
    print("    -> ORA would run here with the detected GO:BP source.")
else:
    print("    BLOCKED: no gene->GO:BP annotation available in this sandbox.")
    print("      - gencode 'ont' column is empty; no 'GO:' IDs in any input.")
    print("      - no local GO DB / gmt / gene2go; no gseapy/clusterProfiler/R.")
    print("      - no internet access (DNS resolution fails).")
    print("      To complete: supply a gene->GO:BP annotation (gmt/gene2gp/")
    print("      org.Hs.eg.db) or enable network for gseapy/clusterProfiler.")

print("\nDONE")
