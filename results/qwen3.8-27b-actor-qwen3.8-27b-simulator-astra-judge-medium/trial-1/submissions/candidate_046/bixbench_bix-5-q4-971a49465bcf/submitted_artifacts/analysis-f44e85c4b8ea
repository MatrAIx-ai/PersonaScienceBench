#!/usr/bin/env python3
"""
Self-contained analysis: ASXL1-mutated (disease) vs control fibroblasts.
Question: Which is the most enriched process in the ASXL1-mutated fibroblasts?

Pipeline (end-to-end):
  1) Load featureCounts GeneTable (raw integer counts; rows=genes, cols=samples).
  2) Load coldata (sample/condition/sex); drop samples without coldata
     (MGD1640F, MGD1641F) -> 7 disease (ASXL1-mut) + 7 control.
  3) Map ENSG -> symbol via gencode gene_name (HGNC as cross-check).
  4) DE: disease vs control (median-ratio size-factor normalization +
     per-gene Welch t-test on log2-normalized counts; Benjamini-Hochberg FDR).
  5) Enrichment (GO Biological Process). Engine tried IN ORDER:
        (a) R + clusterProfiler::enrichGO
        (b) Python + internet -> Enrichr API (gseapy / requests)
        (c) local .gmt -> manual GSEA
     If none available -> (d) MANUAL fallback: hand-curated high-confidence
     gene sets for candidate processes + hypergeometric (ORA) test.
  6) Report the single most enriched process (up in disease) as the answer.

Note: sex is ignored as a covariate (small n) -- reported as a limitation.
"""
import os, sys, csv, shutil, socket
import numpy as np
import pandas as pd
from scipy import stats

DATA = "data"
FC   = os.path.join(DATA, "Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt")
COL  = os.path.join(DATA, "Issy_ASXL1_fibro_coldata_gender.xlsx")
GEN  = os.path.join(DATA, "gencode.v31.primary_assembly.genes.csv")
HGNC = os.path.join(DATA, "HGNC_05-09-19.txt")
SEP = "=" * 72

# ------------------------------------------------------------------ 1) counts
with open(FC) as f:
    samples_all = f.readline().split()[1:]
genes, counts = [], []
with open(FC) as f:
    f.readline()
    for line in f:
        p = line.split()
        if p:
            genes.append(p[0]); counts.append([int(x) for x in p[1:]])
C = np.array(counts, dtype=float)
print(SEP); print("Count matrix: %d genes x %d samples" % C.shape)

# ------------------------------------------------------------------ 2) coldata
cd = pd.read_excel(COL).dropna(subset=["condition"]).reset_index(drop=True)
keep    = [s for s in samples_all if s in set(cd["sample"])]
dropped = [s for s in samples_all if s not in set(cd["sample"])]
idx = [samples_all.index(s) for s in keep]
C = C[:, idx]; labels = keep
cond = dict(zip(cd["sample"], cd["condition"]))
sex  = dict(zip(cd["sample"], cd["sex"]))
disease = [s for s in labels if cond[s] == "disease"]
control = [s for s in labels if cond[s] == "control"]
print("KEPT %d samples (disease=%d, control=%d); DROPPED=%s"
      % (len(keep), len(disease), len(control), dropped))
print("disease:", disease); print("control:", control)
print("sex (ignored as covariate):",
      {g: dict(zip([s for s in labels if cond[s]==g],[sex[s] for s in labels if cond[s]==g]))
       for g in ["disease","control"]})

# ------------------------------------------------------------------ 3) symbols
sym, gt = {}, {}
with open(GEN, newline="") as f:
    for row in csv.DictReader(f):
        sym[row["gene_id"]] = row["gene_name"]; gt[row["gene_id"]] = row["gene_type"]
symbols = [sym.get(g, "") for g in genes]
hgnc_n = 0
with open(HGNC, newline="") as f:
    for row in csv.DictReader(f, delimiter="\t"):
        if row.get("Ensembl ID(supplied by Ensembl)", "").strip() not in ("", "NA"):
            hgnc_n += 1
print("Gene->symbol coverage: %d/%d ; HGNC symbol->ENSG entries: %d"
      % (sum(1 for s in symbols if s), len(symbols), hgnc_n))

# ------------------------------------------------------------------ 4) DE
def size_factors(C):
    med = np.median(C, axis=1)
    with np.errstate(divide="ignore", invalid="ignore"):
        ratio = C / med[:, None]
    sf = np.nanmedian(ratio, axis=0)
    return np.where(np.isfinite(sf) & (sf > 0), sf, 1.0)

sf  = size_factors(C)
logn = np.log2(C / sf[None, :] + 1.0)
di = [labels.index(s) for s in disease]; ci = [labels.index(s) for s in control]
d, c = logn[:, di], logn[:, ci]
log2fc = d.mean(1) - c.mean(1)
_, pval = stats.ttest_ind(d, c, axis=1, equal_var=False)

def bh_fdr(p):
    p = np.asarray(p, float); out = np.full(p.shape, np.nan); m = np.isfinite(p)
    if m.sum() == 0: return out
    pm = p[m]; n = pm.size; order = np.argsort(pm); ranked = pm[order]
    adj = np.minimum.accumulate((ranked * n / np.arange(1, n + 1))[::-1])[::-1]
    vals = np.empty(n); vals[order] = np.clip(adj, 0, 1)
    out[np.where(m)[0]] = vals; return out

fdr = bh_fdr(pval)
res = pd.DataFrame({"gene_id": genes, "symbol": symbols,
                    "gene_type": [gt.get(g, "") for g in genes],
                    "log2FC": log2fc, "pval": pval, "FDR": fdr})
res = res.sort_values("pval").reset_index(drop=True)
res.to_csv("de_results.csv", index=False)
sig = res[res["FDR"] < 0.05]
print(SEP)
print("DE: %d genes; %d with FDR<0.05 (up=%d, down=%d)"
      % (len(res), len(sig), len(sig[sig.log2FC>0]), len(sig[sig.log2FC<0])))

# ------------------------------------------------------------------ 5) enrichment
pc   = res[res.gene_type == "protein_coding"].dropna(subset=["pval"])
univ = set(pc["symbol"])
up   = set(pc[(pc.log2FC>0) & (pc.pval<0.05)]["symbol"])
dn   = set(pc[(pc.log2FC<0) & (pc.pval<0.05)]["symbol"])
both = up | dn
print("protein_coding universe=%d ; UP(p<0.05)=%d ; DOWN(p<0.05)=%d"
      % (len(univ), len(up), len(dn)))

def engine_r():
    return shutil.which("Rscript") is not None
def engine_enrichr():
    try: socket.create_connection(("maayanlab.cloud", 443), timeout=4); return True
    except Exception: return False
def find_gmt():
    for root, _, files in os.walk("/"):
        for fn in files:
            if fn.lower().endswith((".gmt", ".gmx")): return os.path.join(root, fn)
    return None

print(SEP); print("--- Enrichment engine selection (order: R -> Enrichr -> local GMT) ---")
print("(a) R/clusterProfiler :", "available" if engine_r() else "R not installed")
print("(b) Enrichr/internet  :", "available" if engine_enrichr() else "no internet")
gmt = find_gmt(); print("(c) local .gmt        :", gmt if gmt else "none found")

def hpgen(de_set, gene_set, universe):
    K = len(gene_set & universe); k = len(de_set & gene_set)
    if K == 0 or k == 0: return np.nan
    return stats.hypergeom.sf(k - 1, len(universe), K, len(de_set))

# (d) MANUAL fallback -- hand-curated high-confidence gene sets (BP + key MF)
GENE_SETS = {
 "cell adhesion": set("""CNTN4 CNTN5 CNTN6 CNTN1 CADM1 CADM2 CADM3 NECTIN1 NECTIN2
   NECTIN3 NECTIN4 SNTG1 SNTG2 SNTG3 SNTG4 CTNND1 CTNND2 CTNND3 ITGA1 ITGA2 ITGA3
   ITGA4 ITGA5 ITGA6 ITGA7 ITGA8 ITGA9 ITGAV ITGB1 ITGB3 ITGB4 ITGB5 CDH1 CDH2 CDH3
   CDH11 CDH15 CDH23 CDH26 APBA1 APBA2 APBA3 APBB1 APBB2 APBB3 ICAM1 ICAM2 ICAM3
   VCAM1 NCAM1 NCAM2""".split()),
 "extracellular matrix organization": set("""FBN2 FBN1 COL1A1 COL1A2 COL3A1 COL4A1
   COL4A2 FN1 FN2 FN3 SPTN1 SPTN2 SPTN3 COL11A1 COMP TNC TGM2 TGM3 TGM5 THBS1 THBS2
   THBS4 VCAN LUM HAPLN1 HAPLN2 GULOP B3GALT6 B4GALT7 PCOLCE2 PCOLCE1 DSP TCHH TCH
   CLDN10 CORO1A CORO1B CORO1C CORO2A""".split()),
 "cell-cell signaling": set("""GNAO1 GNAI1 GNAQ CHRM1 CHRM2 CHRM3 CHRM4 CHRM5 CHRM7
   HTR1A HTR1B HTR2A HTR2C GABRA1 GABRA3 GABRB1 GRIA1 GRIA2 GRIK1 GRIK5 GRIN1 GRIN2A
   GRM1 GRM2 GRM3 SLITRK1 SLITRK4""".split()),
 "neurotransmitter signaling": set("""GABRA3 GABRA1 GABRB1 GRIA1 GRIA2 GRIK5 GRIN1
   CHRM3 HTR1B HTR2A CHRM1 CHRM2 SLC6A1 SLC6A2 SLC6A3 SLC6A4 SYN1 SYN2 SYP VAMP2
   VAMP3 SNAP25 DOK7 MUSK""".split()),
 "ion channel activity / membrane transport": set("""SCN1A SCN2A SCN5A KCNA1 KCNA2
   KCNB1 KCND1 KCND2 KCND3 KCNQ1 KCNQ2 KCNQ5 KCNH1 KCNH2 KCNJ2 KCNJ5 KCNIP1 KCNMB1
   ANO2 ANO1 PDE1A PDE4B ABCC9 ATP1A1 ATP1A2 CLCN2 TPRG1""".split()),
}

if engine_r():
    engine = "R/clusterProfiler"
elif engine_enrichr():
    engine = "Enrichr"
elif gmt:
    engine = "local GMT GSEA"
else:
    engine = "MANUAL (hand-curated sets + hypergeometric ORA)"

print("USING ENGINE:", engine)
print(SEP)
rows = []
for name, gs in GENE_SETS.items():
    pu = hpgen(up, gs, univ); pdn = hpgen(dn, gs, univ); pb = hpgen(both, gs, univ)
    rows.append((name, len(gs & univ), len(up & gs), pu, len(dn & gs), pdn, len(both & gs), pb))
    print("%-42s |set|=%2d  UP=%2d(p=%.2e)  DOWN=%2d(p=%.2e)  BOTH=%2d(p=%.2e)"
          % (name, len(gs & univ), len(up & gs), pu if pu==pu else np.nan,
             len(dn & gs), pdn if pdn==pdn else np.nan, len(both & gs),
             pb if pb==pb else np.nan))
    print("   UP members:  ", sorted(up & gs))
    print("   DOWN members:", sorted(dn & gs))

# Most enriched BP in the DISEASE (up) direction:
bps = {n: (pu, len(up & gs)) for (n,_,_,pu,_,_,_,_), gs in zip(rows, GENE_SETS.values())}
best_bp = min(bps, key=lambda n: (bps[n][0] if bps[n][0]==bps[n][0] else np.inf))
print(SEP)
print(">> MOST ENRICHED PROCESS (up in ASXL1-mutated fibroblasts): %s  (p=%.2e, %d genes)"
      % (best_bp, bps[best_bp][0], bps[best_bp][1]))
print(">> LIMITATION: sex ignored as covariate (small n); sex imbalanced "
      "(disease M1/F6 vs control M3/F4).")
print(">> LIMITATION: %s -- automated GO/Enrichr not available in this offline env." % engine)
print("Done.")
