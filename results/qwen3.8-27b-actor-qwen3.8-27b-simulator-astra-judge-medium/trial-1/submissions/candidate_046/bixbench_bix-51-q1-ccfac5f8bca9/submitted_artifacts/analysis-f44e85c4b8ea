import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---- Load data (Sheet1) ----
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print("Raw shape:", df.shape)

# ---- Minimal cleaning ----
# Age is object/mixed (ints + a single ' ' string). Coerce to numeric.
df['Age_num'] = pd.to_numeric(df['Age'], errors='coerce')
# Outcome: 1 if Efficacy == 'PR' else 0
df['is_PR'] = (df['Efficacy'] == 'PR').astype(int)

# Keep only complete rows (numeric Age and non-null Efficacy)
usable = df[df['Age_num'].notna() & df['Efficacy'].notna()].copy()
print("Usable rows (numeric Age + non-null Efficacy):", len(usable))
print("Efficacy dist in usable set:")
print(usable['Efficacy'].value_counts().to_string())
print("is_PR counts:", usable['is_PR'].value_counts().to_dict())

# ---- Logistic regression: Age as ONLY predictor + intercept ----
X = sm.add_constant(usable['Age_num'].astype(float).to_numpy().reshape(-1, 1))  # [const, Age]
y = usable['is_PR'].astype(float).to_numpy()

model = sm.Logit(y, X).fit(disp=0)
print("\n=== Model summary ===")
print(model.summary())

# ---- Predict P(PR) at Age = 65 (literal numeric 65) ----
newx = np.array([[1.0, 65.0]])          # [const, Age]
p_pr_65 = float(model.predict(newx)[0])

# ---- Report ----
print("\n=== RESULTS ===")
print("n used          :", int(len(usable)))
print("coef intercept  :", float(model.params[0]))
print("coef Age        :", float(model.params[1]))
print("Pseudo R-squared:", float(model.prsquared))
print("P(PR) at Age=65 :", p_pr_65)

# sanity: predicted probs at a few ages
print("\nSanity check P(PR) by age:")
for a in [40, 55, 65, 75]:
    p = float(model.predict(np.array([[1.0, float(a)]]))[0])
    print(f"  Age={a}: P(PR)={p:.4f}")
