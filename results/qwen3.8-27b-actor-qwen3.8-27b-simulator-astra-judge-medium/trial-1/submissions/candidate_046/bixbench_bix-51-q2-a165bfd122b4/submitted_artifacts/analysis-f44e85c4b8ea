"""
BixBench bix-51-q2
Question: AIC for the logistic regression model that uses BMI as the sole
predictor of treatment response (efficacy PR).

Flow:
  1. Load data/data.xlsx (Sheet1).
  2. Clean: keep only real records (valid Sequence number) -> drops the stray
     junk row (only Age=' ') and empty formatting rows -> 80 clean records.
  3. Binary response: y = 1 if Efficacy == 'PR' (treatment effective) else 0 (SD/PD).
  4. Fit logistic regression Logit(y ~ BMI) with intercept (statsmodels).
  5. Report AIC = -2*LL + 2*k with k = 2 (intercept + slope).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

PATH = "data/data.xlsx"

# 1) Load
df = pd.read_excel(PATH, sheet_name="Sheet1")

# 2) Clean: keep only real records (valid Sequence number).
df = df[df["Sequence number"].notna()].reset_index(drop=True)
n = len(df)
print("Clean records (n):", n)

# 3) Binary response: PR = 1 (treatment effective), SD/PD = 0
df["y"] = (df["Efficacy"] == "PR").astype(int)
print("Efficacy counts:\n", df["Efficacy"].value_counts().to_string())
print("y=1 (PR):", int(df["y"].sum()), "| y=0 (SD/PD):", int((1 - df["y"]).sum()))

# 4) Fit logistic regression, BMI as sole predictor + intercept, complete cases.
fit = df.dropna(subset=["y", "BMI"]).reset_index(drop=True)
X = sm.add_constant(fit["BMI"].astype(float))      # columns: const, BMI
model = sm.Logit(fit["y"], X).fit(disp=0)

# 5) AIC
LL = model.llf
k = int(len(model.params))                          # number of estimated params = 2
aic = model.aic                                     # statsmodels: -2*LL + 2*k
aic_manual = -2.0 * LL + 2.0 * k                    # explicit: -2*LL + 2*k, k=2
bic = model.bic

print("\n--- Model summary ---")
print(model.summary())
print("\n--- AIC (k = 2: intercept + slope) ---")
print("n (complete cases)   :", len(fit))
print("log-likelihood (LL)  :", LL)
print("-2*LL                :", -2.0 * LL)
print("k (estimated params) :", k, "->", list(model.params.index))
print("AIC (model.aic)      :", aic)
print("AIC (-2*LL + 2*k)    :", aic_manual)
print("AIC rounded (4 dp)   :", round(aic, 4))
print("BIC (for reference)  :", round(bic, 4))
