#!/usr/bin/env python3
"""
BixBench bix-51-q3: Logistic regression — p-value for Age
Model: PR (1) vs no-PR (0) ~ Age + BMI + Gender
Outcome: Partial Response (PR) as binary treatment response
Predictors: Age (continuous), BMI (continuous), Gender (dummy: Male=1, Female=0)
"""

import warnings
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ── 1. Load & clean ──────────────────────────────────────────────
df = pd.read_excel("data/data.xlsx")
print(f"Raw shape: {df.shape}")

# Drop the 41 completely empty rows (no Sequence number)
df = df[df["Sequence number"].notna()].reset_index(drop=True)
print(f"Valid rows after dropping empties: {len(df)}")

# ── 2. Build variables ───────────────────────────────────────────
# Outcome: PR = 1, everything else (PD, SD) = 0
df["PR"] = (df["Efficacy"] == "PR").astype(int)
print(f"\nOutcome distribution:")
print(df["PR"].value_counts().to_string())
print(f"  PR (1): {df['PR'].sum()}, no-PR (0): {(1-df['PR']).sum()}")

# Age: ensure numeric (column was object dtype due to a stray ' ' in empty rows)
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
assert df["Age"].notna().all(), "Age has missing values after conversion!"
df["Age"] = df["Age"].astype(int)

# BMI: already float
df["BMI"] = df["BMI"].astype(float)

# Gender dummy: Male = 1, Female = 0 (reference)
df["Male"] = (df["Gender"] == "Male").astype(int)
print(f"\nGender distribution: Male={df['Male'].sum()}, Female={(1-df['Male']).sum()}")

print(f"Age:  min={df['Age'].min()}, max={df['Age'].max()}, mean={df['Age'].mean():.2f}")
print(f"BMI:  min={df['BMI'].min()}, max={df['BMI'].max()}, mean={df['BMI'].mean():.2f}")

# ── 3. Fit logistic regression ───────────────────────────────────
X = sm.add_constant(df[["Age", "BMI", "Male"]].astype(float))
y = df["PR"].astype(float)

print("\n" + "="*60)
print("FITTING MODEL: PR ~ Age + BMI + Male")
print("="*60)

with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    model = sm.Logit(y, X).fit()
    
    if wlist:
        print("\n⚠️  OPTIMIZER WARNINGS:")
        for w in wlist:
            print(f"  {w.category.__name__}: {w.message}")
    else:
        print("\n✓ No optimizer warnings.")

# ── 4. Full summary ──────────────────────────────────────────────
print("\n" + "="*60)
print("MODEL SUMMARY")
print("="*60)
print(model.summary())

# ── 5. Extract key results ───────────────────────────────────────
print("\n" + "="*60)
print("KEY RESULTS")
print("="*60)
for var in ["Age", "BMI", "Male"]:
    coef = model.params[var]
    pval = model.pvalues[var]
    ci_low = model.conf_int().loc[var, 0]
    ci_high = model.conf_int().loc[var, 1]
    print(f"  {var:6s}: coef={coef:.6f},  p={pval:.6f},  95% CI [{ci_low:.4f}, {ci_high:.4f}]")

age_pvalue = model.pvalues["Age"]
print(f"\n{'='*60}")
print(f"ANSWER: p-value for Age = {age_pvalue:.6f}")
print(f"{'='*60}")

# ── 6. Model diagnostics ─────────────────────────────────────────
print(f"\nModel converged: {model.mle_retvals['converged']}")
print(f"Number of iterations: {model.mle_retvals.get('iterations', 'N/A')}")
print(f"Log-Likelihood: {model.llf:.4f}")
print(f"Pseudo R²: {model.prsquared:.4f}")
print(f"AIC: {model.aic:.4f}")
print(f"BIC: {model.bic:.4f}")
