"""
Logistic regression: change in log-odds of remission per +1 year of age.
Model: Remission ~ Age + BMI + Gender (Male dummy, ref=Female)
Data: data/data.xlsx (Sheet1), 80 real patient rows.
Outcome: remission = 1 if Efficacy == 'PR' (partial response); 0 if SD or PD.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

# ---------- 1) Load & clean ----------
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print("Loaded shape:", df.shape)

# Keep only the 80 real patient rows (filas 0-79); drop 40 empty rows + stray row 120.
data = df.iloc[0:80].copy().reset_index(drop=True)
print("Real data rows used:", len(data))

data["Age"] = pd.to_numeric(data["Age"], errors="coerce")
data["BMI"] = pd.to_numeric(data["BMI"], errors="coerce")
assert data[["Age", "BMI", "Gender", "Efficacy"]].notna().all().all(), "Missing in key columns!"
print("Key columns complete (Age, BMI, Gender, Efficacy): True")

# ---------- 2) Outcome: remission = PR (1); SD+PD = 0 ----------
data["Remission"] = (data["Efficacy"].str.strip() == "PR").astype(int)
print("Remission counts:", data["Remission"].value_counts().to_dict())

# ---------- 3) Gender dummy (reference = Female) ----------
data["Male"] = (data["Gender"].str.strip() == "Male").astype(int)
print("Gender Male=1 counts:", data["Male"].value_counts().to_dict())

# ---------- 4) Fit logistic regression (MLE) ----------
X = sm.add_constant(data[["Age", "BMI", "Male"]])
with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    model = sm.Logit(data["Remission"], X).fit(method="newton")
    all_warnings = [f"{w.category.__name__}: {w.message}" for w in wlist]

converged = model.mle_retvals["converged"]
print("\n=== MODEL SUMMARY (Logit / GLM-Binomial logit) ===")
print(model.summary())

print("\n=== KEY RESULTS ===")
print(f"Converged: {converged}")
print(f"Method: {model.method}, iterations: {model.mle_retvals.get('iterations', 'n/a')}")
print(f"Observations used: {int(model.nobs)}")
print(f"Log-Likelihood: {model.llf:.6f}")
print(f"Deviance (residual, -2*llf): {-2*model.llf:.6f}")
print(f"LR stat (model vs null, 2*(llf-llnull)): {model.llr:.6f}, p={model.llr_pvalue:.6g}")
print(f"Pseudo R2:       {model.prsquared:.6f}")

for name in ["Age", "BMI", "Male"]:
    print(f"\n{name}:")
    print(f"  coef (log-odds) = {model.params[name]:.6f}")
    print(f"  SE              = {model.bse[name]:.6f}")
    ci = model.conf_int().loc[name]
    print(f"  95% CI          = [{ci[0]:.6f}, {ci[1]:.6f}]")
    print(f"  z               = {model.tvalues[name]:.4f}")
    print(f"  p-value         = {model.pvalues[name]:.6g}")

# ---------- 5) Cross-check with GLM Binomial (equivalent) ----------
glm = smf.glm("Remission ~ Age + BMI + Male", data=data,
              family=sm.families.Binomial()).fit()
print("\n=== GLM Binomial cross-check (coefficients should match) ===")
for name in ["Age", "BMI", "Male"]:
    print(f"  {name}: {glm.params[name]:.6f}  (Logit gave {model.params[name]:.6f})")

print("\n=== WARNINGS ===")
if all_warnings:
    for w in all_warnings:
        print("  WARNING:", w)
else:
    print("  (none captured during fit)")

# ---------- 6) Save summary ----------
with open("results_summary.txt", "w") as f:
    f.write(model.summary().as_text())
    f.write("\n\n")
    f.write(f"Converged: {converged}\n")
    f.write(f"nobs={int(model.nobs)}  llfit={model.llf:.6f}  deviance={-2*model.llf:.6f}  lr_stat={model.llr:.6f}  lr_p={model.llr_pvalue:.6g}  prsquared={model.prsquared:.6f}\n")
    ci = model.conf_int().loc["Age"]
    f.write(f"Age log-odds coef={model.params['Age']:.6f}  SE={model.bse['Age']:.6f}  "
            f"CI=[{ci[0]:.6f},{ci[1]:.6f}]  z={model.tvalues['Age']:.4f}  p={model.pvalues['Age']:.6g}\n")
print("\nSaved results_summary.txt")
