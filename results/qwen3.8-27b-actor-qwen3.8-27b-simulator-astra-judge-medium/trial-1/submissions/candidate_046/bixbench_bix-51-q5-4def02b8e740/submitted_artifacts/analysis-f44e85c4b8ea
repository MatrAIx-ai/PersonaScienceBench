"""
BixBench bix-51-q5
Logistic regression: is BMI associated with treatment response?

Model (crude, as approved):  response ~ BMI (continuous)
  - response = 1 if Efficacy == 'PR' else 0  (PR vs SD+PD)
  - N = 80 (trailing empty rows dropped)
Report: BMI coefficient, 95% CI, Wald p-value, LR p-value, optimizer convergence.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.formula.api import logit
from scipy import stats

# ------------------------------------------------------------------
# 1) Load + clean
# ------------------------------------------------------------------
raw = pd.read_excel("data/data.xlsx")
n_raw = len(raw)
df = raw.dropna(subset=["Sequence number", "Groups", "Efficacy", "BMI"]).copy()
n = len(df)
print(f"Raw rows: {n_raw} | Effective rows (non-empty): {n}")

# Outcome coding: response = PR (1) vs SD/PD (0)
df["response"] = (df["Efficacy"] == "PR").astype(int)
print("Outcome counts:", df["response"].value_counts().to_dict())
print("BMI: mean=%.3f sd=%.3f min=%.1f max=%.1f" %
      (df["BMI"].mean(), df["BMI"].std(ddof=1), df["BMI"].min(), df["BMI"].max()))

# ------------------------------------------------------------------
# 2) Fit full model  response ~ BMI   (crude, continuous)
# ------------------------------------------------------------------
captured = []
with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    full = logit("response ~ BMI", data=df).fit()
    for w in wlist:
        captured.append(f"[FULL] {w.category.__name__}: {w.message}")

# Null model  response ~ 1
with warnings.catch_warnings(record=True) as wlist2:
    warnings.simplefilter("always")
    null = logit("response ~ 1", data=df).fit()
    for w in wlist2:
        captured.append(f"[NULL] {w.category.__name__}: {w.message}")

print("\n=== Captured warnings (verbatim) ===")
if captured:
    for c in captured:
        print(c)
else:
    print("(none)")

# ------------------------------------------------------------------
# 3) Extract estimates
# ------------------------------------------------------------------
b   = full.params["BMI"]
se  = full.bse["BMI"]
ci  = full.conf_int().loc["BMI"]
wald_p = full.pvalues["BMI"]
z    = full.tvalues["BMI"]
OR   = np.exp(b)
ORci = np.exp(ci)

# Likelihood-ratio test: full vs null
lr_stat = 2.0 * (full.llf - null.llf)
lr_p    = 1.0 - stats.chi2.cdf(lr_stat, df=1)

# ------------------------------------------------------------------
# 4) Optimizer convergence diagnostics
# ------------------------------------------------------------------
print("\n=== Optimizer / convergence diagnostics (full model) ===")
print("method            :", full.mle_settings.get("method"))
print("maxiter           :", full.mle_settings.get("maxiter"))
print("converged         :", full.mle_retvals.get("converged"))
print("iterations (funcall):", full.mle_retvals.get("funcall"))
print("gnorm (grad norm) :", full.mle_retvals.get("gnorm"))
print("ifault            :", full.mle_retvals.get("ifault"))
print("message           :", full.mle_retvals.get("message"))
print("mle_retvals       :", full.mle_retvals)

# ------------------------------------------------------------------
# 5) Report
# ------------------------------------------------------------------
print("\n=== RESULT: logistic regression  response ~ BMI (crude) ===")
print(full.summary())

print("\n=== KEY NUMBERS ===")
print(f"BMI coefficient (log-odds) : {b:.6f}")
print(f"  SE                        : {se:.6f}")
print(f"  95% CI (log-odds)         : [{ci[0]:.6f}, {ci[1]:.6f}]")
print(f"  z (Wald)                  : {z:.4f}")
print(f"Odds ratio (per 1 kg/m2)    : {OR:.4f}  95% CI [{ORci[0]:.4f}, {ORci[1]:.4f}]")
print(f"Wald p-value (PRIMARY)      : {wald_p:.6f}")
print(f"LR statistic                : {lr_stat:.6f}  (df=1)")
print(f"LR p-value (cross-check)    : {lr_p:.6f}")

# Save a compact machine-readable result
out = {
    "n": int(n),
    "response_counts": {int(k): int(v) for k, v in df["response"].value_counts().items()},
    "bmi_coef_logodds": float(b),
    "bmi_se": float(se),
    "bmi_ci95_logodds": [float(ci[0]), float(ci[1])],
    "bmi_wald_z": float(z),
    "bmi_wald_pvalue": float(wald_p),
    "bmi_odds_ratio": float(OR),
    "bmi_odds_ratio_ci95": [float(ORci[0]), float(ORci[1])],
    "lr_statistic": float(lr_stat),
    "lr_pvalue": float(lr_p),
    "converged": full.mle_retvals.get("converged"),
    "gnorm": full.mle_retvals.get("gnorm"),
    "warnings": captured,
}
pd.to_pickle(out, "results.pkl")
import json
print("\nJSON:", json.dumps({k: v for k, v in out.items() if k != 'warnings'}, indent=2, default=float))
