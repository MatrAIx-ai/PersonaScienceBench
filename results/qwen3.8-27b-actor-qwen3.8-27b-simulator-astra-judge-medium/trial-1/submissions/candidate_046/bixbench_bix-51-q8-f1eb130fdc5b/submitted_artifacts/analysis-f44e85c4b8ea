import pandas as pd
import statsmodels.api as sm

# Load and drop blank trailing rows (rows without a Sequence number)
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
real = df[df["Sequence number"].notna()].copy()
real["Age"] = pd.to_numeric(real["Age"], errors="coerce")

# Response: PR = positive; PD + SD = negative
real["response"] = (real["Efficacy"] == "PR").astype(int)

# Univariate logistic regression: response ~ age (statsmodels Logit)
X = sm.add_constant(real["Age"])
model = sm.Logit(real["response"], X).fit(disp=0)

print(model.summary())
print("\n=== FINAL RESULT ===")
print("N used:", int(len(real)))
print("response positive (PR):", int(real["response"].sum()),
      "| negative (PD+SD):", int((1 - real["response"]).sum()))
print("coef(age) [log-odds per year]:", model.params["Age"])
print("SE(age):", model.bse["Age"])
print("p-value(age):", model.pvalues["Age"])
print("odds ratio(age):", float(__import__("math").exp(model.params["Age"])))
