#!/usr/bin/env python3
"""
BixBench bix-52-q7 — Zebra Finch (ZF) age-related CpG methylation filter.

Question:
  "How many sites are removed when filtering sites that do not show >90% or
   <10% methylation in Zebra Finch?"

Approved method (researcher-approved):
  * A "site" is a unique value of `Pos` (== Chromosome_StartPosition).
  * A site is REMOVED if at least one of its samples has
    MethylationPercentage STRICTLY > 90 or STRICTLY < 10.
  * Count the removed sites.

Input: data/ZF_AgeRelated_CpG_noMT_Final.csv
"""
import pandas as pd
import numpy as np

CSV = "data/ZF_AgeRelated_CpG_noMT_Final.csv"

# ------------------------------------------------------------------ #
# 1) Load
# ------------------------------------------------------------------ #
df = pd.read_csv(CSV)
print("=" * 70)
print("1) LOAD")
print("=" * 70)
print(f"total data rows (excl. header) : {len(df)}")
print(f"columns                        : {list(df.columns)}")
print(f"nulls in MethylationPercentage : {int(df['MethylationPercentage'].isna().sum())}")
print(f"nulls in Pos                   : {int(df['Pos'].isna().sum())}")

# ------------------------------------------------------------------ #
# 2) Define a site = unique Pos (== Chromosome_StartPosition)
# ------------------------------------------------------------------ #
df["site"] = df["Pos"]
# sanity: Pos encodes Chromosome_StartPosition for every row
chk = (df["Chromosome"].astype(str) + "_" + df["StartPosition"].astype(str))
assert (df["Pos"] == chk).all(), "Pos != Chromosome_StartPosition for some row!"
print("\n" + "=" * 70)
print("2) SITES (site = unique Pos)")
print("=" * 70)
total_sites = df["site"].nunique()
print(f"unique Pos (Chromosome_StartPosition) : {total_sites}")
print(f"check Pos == Chromosome_StartPosition : OK (100% of rows)")

mp = df["MethylationPercentage"]
print(f"\nMethylationPercentage range : min={mp.min()}, max={mp.max()}")
print(f"rows exactly == 10 : {int((mp == 10).sum())}")
print(f"rows exactly == 90 : {int((mp == 90).sum())}")

# ------------------------------------------------------------------ #
# 3) Per-site extreme-sample membership (strict >90 / <10)
# ------------------------------------------------------------------ #
print("\n" + "=" * 70)
print("3) PER-SITE EXTREME SAMPLES (strict >90 or <10)")
print("=" * 70)
g = df.groupby("site")["MethylationPercentage"]
site_max = g.max()
site_min = g.min()

any_gt90 = site_max > 90   # at least one sample strictly > 90
any_lt10 = site_min < 10   # at least one sample strictly < 10
both     = any_gt90 & any_lt10
removed  = any_gt90 | any_lt10   # site is removed

n_gt90    = int(any_gt90.sum())
n_lt10    = int(any_lt10.sum())
n_both    = int(both.sum())
n_removed = int(removed.sum())
n_kept    = total_sites - n_removed

print(f"sites with ANY sample strictly > 90 : {n_gt90}")
print(f"sites with ANY sample strictly < 10 : {n_lt10}")
print(f"sites with BOTH (>90 and <10)       : {n_both}")
print(f"check: gt90 + lt10 - both = removed : {n_gt90 + n_lt10 - n_both} (== {n_removed})")

# ------------------------------------------------------------------ #
# 4) Final result
# ------------------------------------------------------------------ #
print("\n" + "=" * 70)
print("4) FINAL RESULT")
print("=" * 70)
print(f"total sites            : {total_sites}")
print(f"REMOVED sites (any of its samples strictly >90 or <10) : {n_removed}")
print(f"KEPT sites (all samples within [10, 90])              : {n_kept}")
print(f"\nANSWER: {n_removed} sites are removed.")

# ------------------------------------------------------------------ #
# 5) Diagnostics / alternatives (for transparency)
# ------------------------------------------------------------------ #
print("\n" + "=" * 70)
print("5) DIAGNOSTICS / ALTERNATIVES")
print("=" * 70)
mean_mp = g.mean()
print(f"per-site MEAN methylation: min={mean_mp.min():.3f}, max={mean_mp.max():.3f} "
      f"-> sites with mean >90 or <10: {int(((mean_mp>90)|(mean_mp<10)).sum())}")
print(f"inclusive boundary (>=90 or <=10), any sample: {int(((site_max>=90)|(site_min<=10)).sum())}")
print(f"row-level strict (>90 or <10) rows           : {int(((mp>90)|(mp<10)).sum())}")
print(f"row-level inclusive (>=90 or <=10) rows      : {int(((mp>=90)|(mp<=10)).sum())}")

# save removed-site list as evidence
removed_sites = removed[removed].index.tolist()
pd.Series(removed_sites).to_csv("zf_removed_sites.csv", index=False, header=["site"])
print(f"\nsaved removed-site list -> zf_removed_sites.csv ({n_removed} sites)")
