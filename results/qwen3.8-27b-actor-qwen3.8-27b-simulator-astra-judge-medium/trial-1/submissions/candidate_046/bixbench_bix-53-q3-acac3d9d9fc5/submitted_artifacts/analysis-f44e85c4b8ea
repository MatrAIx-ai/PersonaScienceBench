# 5. lfc shrinkage
def apeglm_like(beta, var):
    best = (None, -np.inf, None)
    for b1 in [0.05, 0.1, 0.2, 0.3, 0.5, 0.7, 1.0]:
        for b2 in [0.05, 0.1, 0.2, 0.3, 0.5, 0.8, 1.0, 1.5, 2.0, 3.0]:
            pv_ = b1 * np.sqrt(var) + b2
            ll = np.sum(-0.5*np.log(pv_ + var) - 0.5*beta**2/(pv_ + var) - 0.5*np.log(pv_))
            if ll > best[1]:
                best = ((b1, b2), ll, pv_)
    (b1, b2), ll, pv_ = best
    return beta * pv_ / (pv_ + var), (b1, b2)

def normal_shrink(beta, se):
    z = beta / se
    mask = np.isfinite(z) & (np.abs(beta) < 0.59)
    prior_var = np.percentile(z[mask] ** 2, 50) if mask.sum() > 10 else 1.0
    return beta / (1.0 + prior_var * se ** 2), prior_var

