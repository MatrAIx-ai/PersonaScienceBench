def loess_rank(x, y, frac=0.4):
    """LOESS approx: local weighted linear fit over rank window (sorted x)."""
    n = len(x)
    k = max(int(round(frac * n)), 11)
    if k % 2 == 0:
        k += 1
    order = np.argsort(x)
    xs, ys = x[order], y[order]
    pred = np.empty(n)
    half = k // 2
    for i in range(n):
        lo = max(0, i - half); hi = min(n, i + half + 1)
        xw, yw = xs[lo:hi], ys[lo:hi]
        xc = xw[i - lo]
        d = np.abs(xw - xc)
        span = max(d[0], d[-1], 1e-12)
        u = np.minimum(d / span, 1.0)
        w = (1 - u ** 3) ** 3
        A = np.column_stack([np.ones_like(xw), xw - xc])
        coef, *_ = np.linalg.lstsq(A * w[:, None], yw, rcond=None)
        pred[i] = coef[0]
    out = np.empty(n)
    out[order] = pred
    return out


