# 4. NB-GLM via IRLS (log2 scale: beta1 = log2FC), alt. w/ moment dispersion
ALPHA_MIN, ALPHA_MAX = 1e-4, 20.0
def nb_irls(y, cond, sf, alpha_init=0.5, maxit=60, tol=1e-8):
    """NB GLM, natural-log link, design [1, cond]. IRLS + moment dispersion.
    Returns (a0, a1, se1, alpha, conv) where lfc2 = a1/ln2."""
    n = len(y)
    sfl = np.log(sf)
    gKL = y[cond == 1]; gWL = y[cond == 0]
    mKL = max(np.mean(gKL / sf[cond == 1]), 1e-3)
    mWL = max(np.mean(gWL / sf[cond == 0]), 1e-3)
    a0 = float(np.log(mWL)); a1 = float(np.log(mKL / mWL))
    alpha = float(np.clip(alpha_init, ALPHA_MIN, ALPHA_MAX))
    Xd = np.column_stack([np.ones(n), cond])
    conv = False
    for it in range(maxit):
        eta = a0 + a1 * cond + sfl
        mu = np.exp(np.clip(eta, -50, 50))
        # NB IRLS (log link): z = eta + (y-mu)/mu ; w = mu/(1+alpha*mu)
        z = eta + (y - mu) / np.maximum(mu, 1e-12)
        w = mu / (1.0 + alpha * mu)
        WtX = (w[:, None] * Xd).T @ Xd
        Wtz = Xd.T @ (w * z)
        try:
            beta = np.linalg.solve(WtX, Wtz)
        except np.linalg.LinAlgError:
            beta = np.linalg.lstsq(WtX, Wtz, rcond=None)[0]
        a0n = float(np.clip(beta[0], -30, 60))
        a1n = float(np.clip(beta[1], -30, 30))
        d = y - mu
        S2 = float(np.sum(d ** 2)); S1 = float(np.sum(d)); Smu2 = float(np.sum(mu ** 2))
        alpha_new = ((n - 1) / n * S2 - S1) / (n * Smu2) if Smu2 > 0 else alpha
        alpha_new = float(np.clip(alpha_new, ALPHA_MIN, ALPHA_MAX))
        if abs(a0n - a0) < tol and abs(a1n - a1) < tol and abs(alpha_new - alpha) < 1e-6:
            a0, a1, alpha = a0n, a1n, alpha_new
            conv = True
            break
        a0, a1, alpha = a0n, a1n, alpha_new
    # final SE for a1 (fixed alpha)
    eta = a0 + a1 * cond + sfl
    mu = np.exp(np.clip(eta, -50, 50))
    w = mu / (1.0 + alpha * mu)
    WtX = (w[:, None] * Xd).T @ Xd
    try:
        cov = np.linalg.inv(WtX)
        se1 = float(np.sqrt(max(cov[1, 1], 1e-12)))
    except np.linalg.LinAlgError:
        se1 = float('inf')
    return a0, a1, se1, alpha, conv

