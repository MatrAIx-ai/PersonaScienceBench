# 8. ORA Fisher (gseapy.enrichr emulation)
def ora_fisher(dge_ids, path_ids, univ):
    from scipy.stats import fisher_exact
    n_u = len(univ); n_p = len(path_ids & univ); n_d = len(dge_ids & univ)
    k = len(dge_ids & path_ids & univ)
    a, b = k, n_d - k
    c, d = n_p - k, n_u - n_p - n_d + k
    oddsr, p = fisher_exact([[a, b], [c, d]])
    return k, float(p), [[a, b], [c, d]]

