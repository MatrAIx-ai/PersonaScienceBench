#!/usr/bin/env python3
"""UBE2M KD vs WT RNA-seq: DESeq2-equivalent DE + lfcShrink + GSEA (pure Python, offline).
DE: median-ratio size factors; closed-form NB-GLM log2FC & SE (2-group design);
    within-group dispersion -> binned-median trend; Wald raw p; normal-EB LFC shrinkage.
GSEA: standard preranked algorithm (|score| steps), permutation p + FDR.
KEGG_2019_Mouse: required but NOT available offline -> not fabricated (see diagnostics).
"""
import os
import numpy as np
import pandas as pd
from scipy import stats

LN2 = np.log(2.0)
df = pd.read_csv('data/count.csv', index_col=0)
kl, wl = ['KL1','KL2','KL3'], ['WL1','WL2','WL3']
K = df[kl].to_numpy(float); W = df[wl].to_numpy(float)
counts = np.hstack([K, W])
genes = df.index.to_numpy(); n = counts.shape[1]
print(f"[load] genes={counts.shape[0]} samples={n} (KL=KD, WL=WT)")

# size factors (median-of-ratios)
gm = np.exp(np.log(counts+1e-12).mean(axis=1))
with np.errstate(divide='ignore', invalid='ignore'):
    ratio = np.where(gm[:,None]>0, counts/gm[:,None], np.nan)
sf = np.nanmedian(ratio, axis=0); sf = np.where(sf>0, sf, 1.0)
norm = counts/sf[None,:]
baseMean = norm.mean(axis=1)
print(f"[sizefactors] KL={sf[:3].round(4)} WL={sf[3:].round(4)}")

# group means / within-group variances
mu_KD = norm[:, :3].mean(axis=1); mu_WT = norm[:, 3:].mean(axis=1)
var_KD = norm[:, :3].var(axis=1, ddof=1); var_WT = norm[:, 3:].var(axis=1, ddof=1)
eps = 1e-3
with np.errstate(divide='ignore', invalid='ignore'):
    phi_KD = (var_KD - mu_KD)/np.maximum(mu_KD,eps)**2
    phi_WT = (var_WT - mu_WT)/np.maximum(mu_WT,eps)**2
phi_gw = np.nanmean(np.clip(np.stack([phi_KD, phi_WT]), 0, 10), axis=0)

# robust binned-median dispersion trend (log2 phi ~ log2 baseMean)
ok = np.isfinite(phi_gw) & (baseMean > 1)
x = np.log2(baseMean[ok]); yv = np.log2(np.maximum(phi_gw[ok], 1e-4))
qs = np.quantile(x, np.linspace(0,1,21))
bins = np.clip(np.searchsorted(qs, x, side='right')-1, 0, 19)
med = np.array([np.median(yv[bins==b]) if (bins==b).any() else np.nan for b in range(20)])
cx = np.array([np.median(x[bins==b]) if (bins==b).any() else qs[b] for b in range(20)])
cx, order = np.sort(cx), None
# fill nans in med by interpolation
gk = np.isfinite(med); med = np.interp(cx, cx[gk], med[gk])
phi_trend = np.exp2(np.interp(np.log2(np.maximum(baseMean,1e-3)), cx, med))
phi = np.clip(phi_trend, 1e-3, 1.0)
print(f"[dispersion] trend range=[{phi.min():.4f},{phi.max():.4f}] median={np.median(phi):.4f}")

# closed-form log2FC and SE (NB GLM, 2-group design)
log2fc = np.log2((mu_KD+eps)/(mu_WT+eps))
se_ln = np.sqrt((1.0/np.maximum(mu_KD,eps) + 1.0/np.maximum(mu_WT,eps) + 2.0*phi)/3.0)
se = se_ln/LN2
zstat = (np.log((mu_KD+eps)/(mu_WT+eps)))/se_ln
pval = 2.0*stats.norm.sf(np.abs(zstat))
finite = np.isfinite(log2fc) & np.isfinite(se)
print(f"[DE] genes with finite LFC/SE: {int(finite.sum())}")

# log2FC shrinkage: DESeq2 'normal' empirical-Bayes (apeglm R pkg unavailable offline)
mad = np.median(np.abs(log2fc[finite] - np.median(log2fc[finite])))
prior_var = max(0.05, (1.4826*mad)**2)
shrink = prior_var/(prior_var + se**2)
log2fc_shrunk = np.where(finite, log2fc*shrink, np.nan)
print(f"[DE] prior_var(normal EB shrinkage)={prior_var:.4f}")

out = pd.DataFrame({'baseMean':baseMean,'log2FC_raw':log2fc,'log2FC_shrunk':log2fc_shrunk,
                    'pvalue':pval,'disp':phi},index=genes)
DE = out[(out.pvalue<0.05)&(out.log2FC_shrunk.abs()>1)&(out.baseMean>10)].sort_values('pvalue')
print(f"[DE] significant DE (p<0.05, |log2FC_shrunk|>1, baseMean>10): {len(DE)}")
print(f"     up={int((DE.log2FC_shrunk>0).sum())} down={int((DE.log2FC_shrunk<0).sum())}")
print("[DE] top 25 by p-value:")
print(DE.head(25).round(3).to_string())
out.to_csv('de_results.csv'); DE.to_csv('de_significant.csv')

# ranking: ALL genes by log2FC_shrunk (desc)
ranked = out.sort_values('log2FC_shrunk', ascending=False)
ranked.to_csv('gsea_ranking.csv')
print(f"\n[rank] all {len(out)} genes ranked by log2FC_shrunk. top5/bottom5:")
print(ranked.head(5).round(3).to_string()); print(ranked.tail(5).round(3).to_string())

# GSEA preranked (standard algorithm, |score| steps, permutation null by gene identity)
def gse_prerank(ranked_scores, gene_sets, n_perm=1000, seed=0):
    r = np.random.default_rng(seed); names = list(ranked_scores.keys())
    scores = np.array([ranked_scores[g] for g in names], float)
    scores = np.where(np.isfinite(scores), scores, 0.0)
    N = len(names); idx = {g:i for i,g in enumerate(names)}
    def es_from(hit_by_gene, sc):
        order = np.argsort(-sc, kind='stable')          # ranked desc by score
        a = np.abs(sc[order]); hit = hit_by_gene[order]
        Wh = a[hit].sum(); Wm = a[~hit].sum()
        if Wh == 0 or Wm == 0: return 0.0
        c = np.cumsum(np.where(hit, a/Wh, -a/Wm))
        return max(c.max(), -c.min())
    res=[]; pv_all=[]
    for path, mem in gene_sets.items():
        hit_by_gene = np.zeros(N, bool)
        for m in mem:
            if m in idx: hit_by_gene[idx[m]] = True
        if hit_by_gene.sum()==0 or hit_by_gene.sum()==N: continue
        ES = es_from(hit_by_gene, scores)
        ep=[]
        for _ in range(n_perm):
            s2 = scores.copy(); r.shuffle(s2)
            ep.append(es_from(hit_by_gene, s2))
        ep=np.array(ep); NES=ES/(np.mean(np.abs(ep))+1e-12)
        pv = (np.sum(ep>=ES)+1)/(n_perm+1) if ES>0 else (np.sum(ep<=-ES)+1)/(n_perm+1)
        res.append((path,ES,NES,pv)); pv_all.append(pv)
    res = pd.DataFrame(res, columns=['pathway','ES','NES','pvalue']).sort_values('pvalue')
    ea=np.array(pv_all)
    res['FDR']=[(1.0/len(ea))*(1.0-pv)*np.sum(ea<=pv)/max(np.sum(ea<=pv),1) for pv in res.pvalue]
    return res

print("\n[GSEA-verification] toy (KNOWN_UP/DOWN significant, RANDOM not):")
toy={f"g{i}":float(10-i) for i in range(20)}
tsets={'KNOWN_UP':[f"g{i}" for i in range(5)],'KNOWN_DOWN':[f"g{i}" for i in range(15,20)],
       'RANDOM':[f"g{i}" for i in range(0,20,2)]}
print(gse_prerank(toy,tsets,n_perm=1000,seed=1).round(3).to_string(index=False))

# KEGG_2019_Mouse GSEA (needs the library; try local .gmt, then gseapy+internet)
gene_sets=None; src=None
for c in ['KEGG_2019_Mouse.gmt','data/KEGG_2019_Mouse.gmt','gsea-database/KEGG_2019_Mouse.gmt']:
    if os.path.exists(c):
        gs={}
        for line in open(c):
            p=line.rstrip('\n').split('\t'); gs[p[0]]=p[2:]
        gene_sets=gs; src=c; break
if gene_sets is None:
    try:
        import gseapy as gp
        lib=gp.get_library(name='KEGG_2019_Mouse', verbose=False)
        gs={k:list(v) for k,v in lib.items()}
        gene_sets=gs; src='gseapy:KEGG_2019_Mouse'
    except Exception as e:
        print("  gseapy/KEGG download unavailable:", type(e).__name__)
print("\n[KEGG-GSEA] searching KEGG_2019_Mouse library ...")
if gene_sets is None:
    print("  NOT FOUND. No internet (DNS+raw TCP fail), no gseapy, no .gmt on filesystem,")
    print("  no symbol->Ensembl mapping. Official KEGG_2019_Mouse GSEA CANNOT run offline.")
    print("  Per instruction, gene sets were NOT fabricated.")
    print("  => Provide KEGG_2019_Mouse.gmt OR run in a runner with internet+gseapy to get the top pathway.")
else:
    print(f"  loaded {len(gene_sets)} pathways from: {src}")
    gres=gse_prerank({g:out.log2FC_shrunk[g] for g in out.index}, gene_sets, n_perm=1000)
    gres.to_csv('gsea_kegg_results.csv')
    print("  top 15 KEGG pathways (by p-value):")
    print(gres.head(15).round(4).to_string(index=False))
    top=gres.iloc[0]
    print(f"  ==> MOST SIGNIFICANTLY ENRICHED PATHWAY: {top['pathway']}  (NES={top['NES']:.3f}, p={top['pvalue']:.4f}, FDR={top['FDR']:.4f})")
print("\n[DONE] artifacts: analysis.py, de_results.csv, de_significant.csv, gsea_ranking.csv")
