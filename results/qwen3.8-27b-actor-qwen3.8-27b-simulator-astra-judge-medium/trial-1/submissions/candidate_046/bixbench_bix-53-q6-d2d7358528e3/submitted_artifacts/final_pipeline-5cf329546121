#!/usr/bin/env python3
"""END-TO-END pipeline (run in a runner WITH internet + gseapy):
   DE (DESeq2-equivalent) -> ranking by log2FC_shrunk -> gseapy.prerank(KEGG_2019_Mouse)
   -> print most significantly enriched pathway (NES / p-value / FDR).
Requires: pip install gseapy  (internet to fetch the KEGG_2019_Mouse library once).
"""
import numpy as np, pandas as pd
from scipy import stats
LN2 = np.log(2.0)

# ---- DE (DESeq2-equivalent, same as analysis.py) ----
df = pd.read_csv('data/count.csv', index_col=0)
kl, wl = ['KL1','KL2','KL3'], ['WL1','WL2','WL3']
counts = np.hstack([df[kl].to_numpy(float), df[wl].to_numpy(float)])
gm = np.exp(np.log(counts+1e-12).mean(axis=1))
with np.errstate(divide='ignore', invalid='ignore'):
    ratio = np.where(gm[:,None]>0, counts/gm[:,None], np.nan)
sf = np.where(np.nanmedian(ratio, axis=0)>0, np.nanmedian(ratio, axis=0), 1.0)
norm = counts/sf[None,:]
baseMean = norm.mean(axis=1)
mu_KD = norm[:,:3].mean(axis=1); mu_WT = norm[:,3:].mean(axis=1)
var_KD = norm[:,:3].var(axis=1, ddof=1); var_WT = norm[:,3:].var(axis=1, ddof=1)
eps=1e-3
phi = np.nanmean(np.clip(np.stack([(var_KD-mu_KD)/np.maximum(mu_KD,eps)**2,
                                   (var_WT-mu_WT)/np.maximum(mu_WT,eps)**2]),0,10),axis=0)
ok = np.isfinite(phi)&(baseMean>1)
x=np.log2(baseMean[ok]); yv=np.log2(np.maximum(phi[ok],1e-4)); qs=np.quantile(x,np.linspace(0,1,21))
bins=np.clip(np.searchsorted(qs,x,side='right')-1,0,19)
med=np.array([np.median(yv[bins==b]) if (bins==b).any() else np.nan for b in range(20)])
cx=np.array([np.median(x[bins==b]) if (bins==b).any() else qs[b] for b in range(20)]); cx=np.sort(cx)
gk=np.isfinite(med); med=np.interp(cx,cx[gk],med[gk])
phi=np.clip(np.exp2(np.interp(np.log2(np.maximum(baseMean,1e-3)),cx,med)),1e-3,1.0)
log2fc=np.log2((mu_KD+eps)/(mu_WT+eps))
se_ln=np.sqrt((1.0/np.maximum(mu_KD,eps)+1.0/np.maximum(mu_WT,eps)+2.0*phi)/3.0); se=se_ln/LN2
pval=2.0*stats.norm.sf(np.abs(np.log((mu_KD+eps)/(mu_WT+eps))/se_ln))
finite=np.isfinite(log2fc)&np.isfinite(se)
mad=np.median(np.abs(log2fc[finite]-np.median(log2fc[finite]))); prior_var=max(0.05,(1.4826*mad)**2)
log2fc_shrunk=np.where(finite, log2fc*(prior_var/(prior_var+se**2)), np.nan)
out=pd.DataFrame({'baseMean':baseMean,'log2FC_shrunk':log2fc_shrunk,'pvalue':pval},index=df.index)
DE=out[(out.pvalue<0.05)&(out.log2FC_shrunk.abs()>1)&(out.baseMean>10)]
print(f"[DE] significant DE (p<0.05,|log2FC_shrunk|>1,baseMean>10): {len(DE)}")

# ---- ranking: ALL genes by log2FC_shrunk (desc) ----
ranking = out.log2FC_shrunk.sort_values(ascending=False)
print(f"[rank] {len(ranking)} genes ranked (top={ranking.index[0]} {ranking.iloc[0]:.2f}, bottom={ranking.index[-1]} {ranking.iloc[-1]:.2f})")

# ---- GSEA with gseapy + KEGG_2019_Mouse ----
import gseapy as gp
lib = gp.get_library(name='KEGG_2019_Mouse', verbose=False)
print(f"[GSEA] KEGG_2019_Mouse library: {len(lib)} pathways")
rres = gp.prerank(rnk=ranking, gene_sets=lib, outdir='gsea_out', min_size=10, max_size=500,
                  permutation_test_func='gene_set_size', processes=1, verbose=False)
tab = rres.table.sort_values('pval')
pd.set_option('display.width',200)
print("\n[top 15 KEGG_2019_Mouse pathways by p-value]")
print(tab[['Term','NES','size','pval','FDR']].head(15).to_string(index=False))
top = tab.iloc[0]
print(f"\n==> MOST SIGNIFICANTLY ENRICHED PATHWAY: {top['Term']}")
print(f"    NES = {top['NES']:.4f}   p-value = {top['pval']:.4g}   FDR = {top['FDR']:.4g}   size = {int(top['size'])}")
