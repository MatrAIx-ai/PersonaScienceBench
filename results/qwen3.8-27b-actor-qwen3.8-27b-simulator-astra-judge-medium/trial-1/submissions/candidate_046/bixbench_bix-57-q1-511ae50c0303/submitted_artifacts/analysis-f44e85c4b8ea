#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-57-q1 (full_workflow)
Question: "What is the percentage of gap characters relative to total
alignment positions across all alignments after aligning with MAFFT with
the 'auto' parameter?"

Method (per brief):
  * EACH of the 10 data/*.faa files is aligned SEPARATELY -> 10 MSAs.
  * Required engine: MAFFT with the 'auto' parameter (`mafft --auto`).
  * Metric:
      pct = 100 * total_gaps / total_positions
      total_gaps      = sum over the 10 MSAs of the number of '-' characters
      total_positions = sum over the 10 MSAs of (MSA_length_i * n_seqs_i)

MAFFT availability (documented requirement):
  The script FIRST tries MAFFT (shutil.which + `mafft --version`) and logs
  the outcome. In this environment MAFFT is NOT installed and cannot be
  installed (no conda/mamba, no apt sources/cache, no network/DNS).
  When MAFFT is missing, a clearly-labeled FALLBACK is used: a pure-Python
  PROGRESSIVE multiple sequence alignment (UPGMA guide tree from pairwise
  BLOSUM62 distances, BLOSUM62 scores, affine gaps open=10/extend=0.5,
  profile-profile Gotoh DP). Fallback numbers are NOT MAFFT numbers and
  are labeled as such in the log, the summary JSON and the final answer.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from collections import Counter

import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
DATA_DIR = os.path.join(HERE, "data")
MSA_DIR = os.path.join(HERE, "msa_out")
LOG_PATH = os.path.join(HERE, "alignment_run.log")
SUMMARY_PATH = os.path.join(HERE, "results_summary.json")

FILES = [
    "1018517at2759.faa", "1010730at2759.faa", "1019762at2759.faa",
    "1038775at2759.faa", "100698at2759.faa", "1003258at2759.faa",
    "1041560at2759.faa", "1065019at2759.faa", "1079827at2759.faa",
    "1014314at2759.faa",
]

GAP_OPEN = 10.0
GAP_EXT = 0.5

AA = "ARNDCEQGHILKMFPSTWYV"
BLOSUM62 = {
 'A':[ 4,-1,-2,-2, 0,-1,-1, 0,-2,-1,-1,-1,-1,-2,-1, 1, 0,-3,-2, 0],
 'R':[-1, 5, 0,-2,-3, 1, 0,-2, 0,-3,-2, 2,-1,-3,-2,-1,-1,-3,-2,-3],
 'N':[-2, 0, 6, 1,-3, 0, 0, 0, 1,-3,-3, 0,-2,-3,-2, 1, 0,-4,-2,-3],
 'D':[-2,-2, 1, 6,-3, 0, 2,-1,-1,-3,-4,-1,-3,-3,-1, 0,-1,-4,-3,-3],
 'C':[ 0,-3,-3,-3, 9,-3,-4,-3,-3,-1,-1,-3,-1,-2,-3,-1,-1,-2,-2,-1],
 'Q':[-1, 1, 0, 0,-3, 5, 2,-2, 0,-3,-2, 1, 0,-3,-1, 0,-1,-2,-1,-2],
 'E':[-1, 0, 0, 2,-4, 2, 5,-2, 0,-3,-3, 1,-2,-3,-1, 0,-1,-3,-2,-2],
 'G':[ 0,-2, 0,-1,-3,-2,-2, 6,-2,-4,-4,-2,-3,-3,-2, 0,-2,-2,-3,-3],
 'H':[-2, 0, 1,-1,-3, 0, 0,-2, 8,-3,-3,-1,-2,-1,-2,-1,-2,-2, 2,-3],
 'I':[-1,-3,-3,-3,-1,-3,-3,-4,-3, 4, 2,-3, 1, 0,-3,-2,-1,-3,-1, 3],
 'L':[-1,-2,-3,-4,-1,-2,-3,-4,-3, 2, 4,-3, 2, 0,-3,-2,-1,-2,-1, 1],
 'K':[-1, 2, 0,-1,-3, 1, 1,-2,-1,-3,-3, 5,-1,-3,-1, 0,-1,-3,-2,-2],
 'M':[-1,-1,-2,-3,-1, 0,-2,-3,-2, 1, 2,-1, 5,-1,-1,-1,-1,-1,-1, 1],
 'F':[-2,-3,-3,-3,-2,-3,-3,-3,-1, 0, 0,-3,-1, 6,-4,-2,-2, 1, 3,-1],
 'P':[-1,-2,-2,-1,-3,-1,-1,-2,-2,-3,-3,-1,-1,-4, 7,-1,-1,-4,-3,-2],
 'S':[ 1,-1, 1, 0,-1, 0, 0, 0,-1,-2,-2, 0,-1,-2,-1, 4, 1,-3,-2, 0],
 'T':[ 0,-1, 0,-1,-1,-1,-1,-2,-2,-1,-1,-1,-1,-2,-1, 1, 5,-2, 0, 0],
 'W':[-3,-3,-4,-4,-2,-2,-3,-2,-2,-3,-2,-3,-1, 1,-4,-3,-2,11, 2,-3],
 'Y':[-2,-2,-2,-3,-2,-1,-2,-3, 2,-1,-1,-2,-1, 3,-3,-2, 0, 2, 7,-1],
 'V':[ 0,-3,-3,-3,-1,-2,-2,-3,-3, 3, 1,-2, 1,-1,-2, 0, 0,-3,-1, 4],
}
S = [[BLOSUM62[a][AA.index(b)] for b in AA] for a in AA]
Snp = np.array(S, dtype=float)
IDX = {a: i for i, a in enumerate(AA)}

_log = open(LOG_PATH, "w")
def log(msg):
    print(msg, flush=True)
    _log.write(msg + "\n")
    _log.flush()

def parse_fasta(path):
    seqs, cur = [], None
    with open(path) as fh:
        for line in fh:
            line = line.rstrip("\n")
            if line.startswith(">"):
                if cur is not None:
                    seqs.append(cur)
                cur = [line[1:].strip(), ""]
            elif line.strip():
                if cur is None:
                    raise ValueError(f"sequence data before header in {path}")
                cur[1] += line.strip()
    if cur is not None:
        seqs.append(cur)
    return seqs

def check_mafft():
    log("=== MAFFT availability check (required method: MAFFT with 'auto') ===")
    which = shutil.which("mafft")
    log(f"shutil.which('mafft') -> {which!r}")
    try:
        r = subprocess.run(["mafft", "--version"], capture_output=True, text=True, timeout=60)
        log(f"subprocess ['mafft','--version'] -> rc={r.returncode} out={r.stdout.strip()!r} err={r.stderr.strip()!r}")
    except FileNotFoundError as e:
        log(f"subprocess ['mafft','--version'] -> FileNotFoundError: {e}")
    except Exception as e:
        log(f"subprocess ['mafft','--version'] -> {type(e).__name__}: {e}")
    if which:
        log("MAFFT FOUND -> will use `mafft --auto` for each file.")
        return which
    log("RESULT: MAFFT IS NOT AVAILABLE in this environment (no 'mafft' binary on PATH;")
    log("        no conda/mamba; no apt sources or package cache; no network access (DNS")
    log("        resolution fails), so it cannot be installed).")
    log(f"FALLBACK (clearly labeled, NOT MAFFT): pure-Python progressive MSA with UPGMA")
    log(f"guide tree, BLOSUM62 scores, affine gaps open={GAP_OPEN}, extend={GAP_EXT},")
    log("profile-profile Gotoh dynamic programming.")
    return None

def gotoh(nA, nB, sc):
    """Affine-gap DP over column score matrix sc (0-based, shape (nA, nB)).
    Returns (xa, xb, final_score); entries are 1-based indices or None (gap)."""
    NEG = float("-inf")
    M = [[NEG] * (nB + 1) for _ in range(nA + 1)]
    D = [[NEG] * (nB + 1) for _ in range(nA + 1)]  # gap in B
    I = [[NEG] * (nB + 1) for _ in range(nA + 1)]  # gap in A
    M[0][0] = 0.0
    for i in range(1, nA + 1):
        D[i][0] = -GAP_OPEN if i == 1 else D[i - 1][0] - GAP_EXT
    for j in range(1, nB + 1):
        I[0][j] = -GAP_OPEN if j == 1 else I[0][j - 1] - GAP_EXT
    for i in range(1, nA + 1):
        Mi, Di, Ii = M[i], D[i], I[i]
        Mip, Dip, Iip = M[i - 1], D[i - 1], I[i - 1]
        scrow = sc[i - 1]
        for j in range(1, nB + 1):
            b0 = Mip[j - 1]
            if Dip[j - 1] > b0: b0 = Dip[j - 1]
            if Iip[j - 1] > b0: b0 = Iip[j - 1]
            Mi[j] = b0 + scrow[j - 1]
            b1 = Dip[j] - GAP_EXT
            t = Mip[j] - GAP_OPEN
            if t > b1: b1 = t
            t = Iip[j] - GAP_OPEN
            if t > b1: b1 = t
            Di[j] = b1
            b2 = Ii[j - 1] - GAP_EXT
            t = Mi[j - 1] - GAP_OPEN
            if t > b2: b2 = t
            t = Di[j - 1] - GAP_OPEN
            if t > b2: b2 = t
            Ii[j] = b2
    i, j = nA, nB
    xa, xb = [], []
    while i > 0 or j > 0:
        if i > 0 and j > 0:
            Mv, Dv, Iv = M[i][j], D[i][j], I[i][j]
            if Mv >= Dv and Mv >= Iv:
                xa.append(i); xb.append(j); i -= 1; j -= 1
            elif Dv >= Iv:
                xa.append(i); xb.append(None); i -= 1
            else:
                xa.append(None); xb.append(j); j -= 1
        elif i > 0:
            xa.append(i); xb.append(None); i -= 1
        else:
            xa.append(None); xb.append(j); j -= 1
    xa.reverse(); xb.reverse()
    return xa, xb, max(M[nA][nB], D[nA][nB], I[nA][nB])

def merge_clusters(A, B):
    """Merge two cluster alignments (lists of equal-length strings) via
    profile-profile affine-gap alignment. Returns (merged, score)."""
    nA, nB = len(A[0]), len(B[0])
    CA = np.zeros((nA, 20)); CB = np.zeros((nB, 20))
    for i, col in enumerate(zip(*A)):
        for c in col:
            if c != "-":
                CA[i, IDX[c]] += 1
    for j, col in enumerate(zip(*B)):
        for c in col:
            if c != "-":
                CB[j, IDX[c]] += 1
    sc = CA @ Snp @ CB.T
    xa, xb, score = gotoh(nA, nB, sc)
    out = []
    for s in A:
        out.append("".join(s[ia - 1] if ia is not None else "-" for ia, _ in zip(xa, xb)))
    for s in B:
        out.append("".join(s[ib - 1] if ib is not None else "-" for ia, ib in zip(xa, xb)))
    return out, score

def upgma(dist, n):
    alive = list(range(n))
    cd = {i: {j: dist[i][j] for j in range(n) if j != i} for i in range(n)}
    size = {i: 1 for i in range(n)}
    events, nxt = [], n
    while len(alive) > 1:
        best = None
        for a in range(len(alive)):
            for b in range(a + 1, len(alive)):
                i, j = alive[a], alive[b]
                if best is None or cd[i][j] < best[0]:
                    best = (cd[i][j], i, j)
        _, i, j = best
        k = nxt; nxt += 1
        nk = {}
        for x in alive:
            if x != i and x != j:
                nk[x] = (cd[i][x] * size[i] + cd[j][x] * size[j]) / (size[i] + size[j])
        cd[k] = nk
        for x in nk:
            cd[x][k] = nk[x]
        size[k] = size[i] + size[j]
        alive = [x for x in alive if x != i and x != j]
        alive.append(k)
        events.append((i, j, k))
    return events

def progressive_msa(seqs):
    n = len(seqs)
    if n == 1:
        return list(seqs)
    if n == 2:
        aln, _ = merge_clusters([seqs[0]], [seqs[1]])
        return aln
    dist = [[0.0] * n for _ in range(n)]
    for i in range(n):
        for j in range(i + 1, n):
            _, score = merge_clusters([seqs[i]], [seqs[j]])
            sim = score / (len(seqs[i]) + len(seqs[j]))
            d = max(0.0, 1.0 - sim)
            dist[i][j] = dist[j][i] = d
    events = upgma(dist, n)
    prof = {i: [seqs[i]] for i in range(n)}
    for i, j, k in events:
        prof[k], _ = merge_clusters(prof[i], prof[j])
    return prof[events[-1][2]]

def self_test():
    aln, score = merge_clusters(["MVFYLIGL"], ["MVFYLIGL"])
    assert aln == ["MVFYLIGL", "MVFYLIGL"], aln
    assert score == sum(S[IDX[c]][IDX[c]] for c in "MVFYLIGL"), score
    aln, score = merge_clusters(["MAM"], ["MM"])
    assert len(aln[0]) == len(aln[1]) == 3
    assert aln[0].count("-") + aln[1].count("-") == 1
    assert score == 5 + 5 - 10, (aln, score)  # two M-M matches (BLOSUM62 M-M=5), one opened gap
    log("self_test: OK (identical-seq and single-insertion cases pass)")

def main():
    t0 = time.time()
    log("BixBench bix-57-q1 — % of gap characters vs total alignment positions")
    log(f"Python {sys.version.split()[0]}, numpy {np.__version__}")
    log(f"Input files ({len(FILES)}): one MSA per file (NOT pooled).")
    self_test()
    mafft_bin = check_mafft()
    os.makedirs(MSA_DIR, exist_ok=True)
    allowed = set(AA) | {"-"}
    rows = []
    tot_gaps = tot_pos = 0
    for f in FILES:
        path = os.path.join(DATA_DIR, f)
        seqs = parse_fasta(path)
        kept = []
        for name, s in seqs:
            if not s:
                log(f"WARNING {f}: empty sequence {name!r} -> excluded (0 positions)")
                continue
            bad = set(s) - set(AA)
            if bad:
                log(f"WARNING {f}: sequence {name!r} has non-20AA chars {sorted(bad)}")
            kept.append((name, s))
        outp = os.path.join(MSA_DIR, f + ".msa.faa")
        if mafft_bin:
            tmp = os.path.join(MSA_DIR, f + ".unalign")
            with open(tmp, "w") as fh:
                for name, s in kept:
                    fh.write(f">{name}\n{s}\n")
            subprocess.run([mafft_bin, "--auto", "-i", tmp, "-out", outp], check=True)
            aligned = [s for _, s in parse_fasta(outp)]
            engine = "mafft --auto"
        else:
            aligned = progressive_msa([s for _, s in kept])
            engine = "FALLBACK progressive (UPGMA + BLOSUM62, affine gaps 10/0.5) - NOT MAFFT"
        names = [n for n, _ in kept]
        L = len(aligned[0])
        assert all(len(s) == L for s in aligned), f"ragged MSA in {f}"
        gaps = sum(s.count("-") for s in aligned)
        pos = L * len(aligned)
        unexp = sorted(set("".join(aligned)) - allowed)
        with open(outp, "w") as fh:
            for name, s in zip(names, aligned):
                fh.write(f">{name}\n{s}\n")
        rows.append({"file": f, "n_seqs": len(aligned), "msa_len": L,
                     "gaps": gaps, "positions": pos,
                     "gap_pct": 100.0 * gaps / pos, "engine": engine,
                     "unexpected_chars": unexp})
        tot_gaps += gaps
        tot_pos += pos
        log(f"{f:22s} n={len(aligned)} L={L:4d} gaps={gaps:4d} pos={pos:5d} "
            f"pct={100.0*gaps/pos:7.4f}% unexpected_chars={unexp or 'none'}")
    pct = 100.0 * tot_gaps / tot_pos
    summary = {
        "question": "percentage of gap characters relative to total alignment "
                    "positions across all alignments (MAFFT 'auto')",
        "engine_used": "mafft --auto" if mafft_bin else
            "FALLBACK progressive MSA (UPGMA guide tree, BLOSUM62, affine gaps "
            "open=10/extend=0.5) because MAFFT was NOT available in this "
            "environment and could not be installed (no network)",
        "mafft_available": bool(mafft_bin),
        "per_file": rows,
        "total_gaps": tot_gaps,
        "total_positions": tot_pos,
        "gap_percentage": pct,
        "gap_percentage_rounded_2dp": round(pct, 2),
        "runtime_seconds": round(time.time() - t0, 1),
    }
    with open(SUMMARY_PATH, "w") as fh:
        json.dump(summary, fh, indent=2)
    log("-" * 78)
    log(f"TOTAL across 10 alignments: gaps={tot_gaps}  positions={tot_pos}")
    log(f"PERCENTAGE = {pct:.4f}%  (rounded: {round(pct, 2)}%)")
    if not mafft_bin:
        log("DISCLAIMER: MAFFT was NOT available; the percentage above comes from the")
        log("pure-Python PROGRESSIVE fallback aligner (BLOSUM62, affine gaps 10/0.5, UPGMA),")
        log("NOT from MAFFT --auto. It is an approximation of the MAFFT-auto value.")
    log(f"Artifacts: {SUMMARY_PATH} ; MSAs in {MSA_DIR} ; log: {LOG_PATH}")

if __name__ == "__main__":
    main()
