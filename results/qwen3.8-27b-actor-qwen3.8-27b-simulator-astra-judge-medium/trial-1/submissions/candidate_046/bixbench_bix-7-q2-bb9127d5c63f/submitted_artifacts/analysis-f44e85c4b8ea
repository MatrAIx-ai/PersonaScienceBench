"""
Analysis: Average number of CHIP variants per sample after filtering out
intronic, intergenic, and UTR variants.

Dataset: CHIP_DP10_GQ20_PASS/ (86 workbooks, one per sample)
Method:
  - Define variant: Zygosity in {Heterozygous, Homozygous Variant}
  - Exclude SO terms: intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant,
                      5_prime_UTR_premature_start_codon_gain_variant, intergenic_variant
  - Count each row once (one variant call per row)
  - Average = total filtered variants / number of samples
"""

import pandas as pd
import os

# Configuration
DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
SO_COL = ('RefSeq Genes 110, NCBI', 'Sequence Ontology (Combined)')
ZYGO_SUBCOL = 'Zygosity'

# SO terms to EXCLUDE (intronic, intergenic, UTR)
EXCLUDE_SO = {
    'intron_variant',
    '3_prime_UTR_variant',
    '5_prime_UTR_variant',
    '5_prime_UTR_premature_start_codon_gain_variant',
    'intergenic_variant',
}

# Zygosity values that count as variants
VARIANT_ZYGOSITY = {'Heterozygous', 'Homozygous Variant'}

# Process all files
files = sorted(os.listdir(DATA_DIR))
print(f"Total files found: {len(files)}")
print(f"{'Sample':<30} {'Total Rows':>10} {'Non-Ref':>10} {'Filtered':>10}")
print("-" * 65)

per_sample_counts = {}

for f in files:
    filepath = os.path.join(DATA_DIR, f)
    df = pd.read_excel(filepath, header=[0, 1])
    
    # Identify the Zygosity column (group name varies: Proband/Father/Mother/Child)
    zyg_col = None
    for col in df.columns:
        if col[1] == ZYGO_SUBCOL:
            zyg_col = col
            break
    
    if zyg_col is None:
        print(f"  WARNING: No Zygosity column found in {f}")
        continue
    
    # Extract sample ID from filename
    # Pattern: 230209_Exome_GRCh38_CHIP_XXX.xlsx
    sample_id = f.replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
    
    total_rows = len(df)
    
    # Filter: variant zygosity
    variant_mask = df[zyg_col].isin(VARIANT_ZYGOSITY)
    n_nonref = variant_mask.sum()
    
    # Filter: exclude intronic/intergenic/UTR SO terms
    so_filter = ~df[SO_COL].isin(EXCLUDE_SO)
    
    # Combined filter
    filtered_mask = variant_mask & so_filter
    n_filtered = filtered_mask.sum()
    
    per_sample_counts[sample_id] = n_filtered
    print(f"{sample_id:<30} {total_rows:>10} {n_nonref:>10} {n_filtered:>10}")

# Final calculation
total_filtered = sum(per_sample_counts.values())
n_samples = len(per_sample_counts)
average = total_filtered / n_samples

print("-" * 65)
print(f"\n{'SUMMARY':}")
print(f"  Number of samples:        {n_samples}")
print(f"  Total filtered variants:  {total_filtered}")
print(f"  Average variants/sample:  {average:.2f}")

# Also show distribution
import numpy as np
counts = list(per_sample_counts.values())
print(f"\n  Min:  {min(counts)}")
print(f"  Max:  {max(counts)}")
print(f"  Median: {np.median(counts):.0f}")
print(f"  Std:  {np.std(counts):.2f}")

print(f"\n=== FINAL ANSWER: {average:.2f} ===")
