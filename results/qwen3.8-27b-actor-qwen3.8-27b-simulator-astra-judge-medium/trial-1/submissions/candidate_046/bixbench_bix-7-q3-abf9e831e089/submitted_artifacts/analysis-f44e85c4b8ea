"""
CHIP variant count after removing reference calls.
Dataset = 86 supplied files in data/CHIP_DP10_GQ20_PASS (trio sample 533 has no file).
Definitions (researcher-approved):
  - reference call  = Zygosity == 'Reference' (REF/REF); rows with Zygosity NaN (multi-allelic
    sites) are KEPT.
  - primary count   = sum of non-reference rows across all 86 files (per-sample sum).
  - secondary count = unique (Chr:Pos, Ref/Alt) variants among the kept rows.
  - 56-gene list    = sanity check only (In_CHIP is True for all rows).
"""
import glob
import pandas as pd

GLOB = "data/CHIP_DP10_GQ20_PASS/*.xlsx"
GENES_XLSX = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
TRIO_XLSX = "data/230215_Trio_Status.xlsx"

genes = set(pd.read_excel(GENES_XLSX, header=None)[0].astype(str).str.strip().str.upper())
trio = pd.read_excel(TRIO_XLSX)
trio_ids = set(trio["Sample ID"].astype(str).str.replace("\t", "").str.strip())

rows, kept_keys = [], set()
for f in sorted(glob.glob(GLOB)):
    df = pd.read_excel(f, header=[0, 1])
    zc = [c for c in df.columns if c[1] == "Zygosity"][0]
    label = zc[0]                                  # e.g. 'Proband (502-P1)'
    sample_id = label.split("(")[1].rstrip(")")    # e.g. '502-P1'
    n_total = len(df)
    ref_mask = df[zc] == "Reference"
    kept = df[~ref_mask]
    # sanity: In_CHIP all True, genes in list (case-insensitive)
    assert df[("Match String List", "In_CHIP")].fillna(False).all(), f
    g = df[("Match String List", "Match")].astype(str).str.strip().str.upper()
    assert g.isin(genes).all(), f
    keys = set(zip(kept[("Variant Info", "Chr:Pos")].astype(str),
                   kept[("Variant Info", "Ref/Alt")].astype(str)))
    kept_keys |= keys
    rows.append({
        "file": f.split("/")[-1],
        "sample_id": sample_id,
        "trio_match": any(sample_id == t or sample_id.split("-")[0] == t for t in trio_ids),
        "total_rows": n_total,
        "reference_calls": int(ref_mask.sum()),
        "kept_rows": int(len(kept)),
        "kept_unique_in_file": len(keys),
    })

per = pd.DataFrame(rows)
total = per["kept_rows"].sum()
print(per.to_string(index=False))
print()
print(f"Files: {len(per)}  (trio IDs covered {per['trio_match'].sum()}/86; trio ID 533 has no file)")
print(f"Total variant rows:        {per['total_rows'].sum()}")
print(f"Reference calls removed:   {per['reference_calls'].sum()}")
print(f"PRIMARY: non-reference rows kept (sum over 86 files): {total}")
print(f"SECONDARY: unique (Chr:Pos, Ref/Alt) kept variants across dataset: {len(kept_keys)}")
