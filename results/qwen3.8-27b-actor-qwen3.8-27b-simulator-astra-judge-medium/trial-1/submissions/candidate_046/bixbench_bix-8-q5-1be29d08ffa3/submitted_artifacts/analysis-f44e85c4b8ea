"""
Independence test: m6A methylation status (m6A) vs differential expression status (DEG)
in the bladder cancer MeRIP dataset.
- MAIN test: Pearson chi-squared on the 3x3 contingency table (site-level, 12754 sites).
- Sensitivity: (a) Fisher exact on collapsed 2x2; (b) Monte Carlo permutation chi-square on 3x3.
Unit = m6A site (each row is a distinct site). No gene deduplication.
Uses ONLY data/MeRIP_RNA_result.xlsx.
"""
import pandas as pd
import numpy as np
from scipy import stats

F = "data/MeRIP_RNA_result.xlsx"
df = pd.read_excel(F, sheet_name="Date Formatting")
N = len(df)
print(f"Rows (sites) used: {N}")
print(f"m6A levels: {sorted(df['m6A'].unique())}")
print(f"DEG levels: {sorted(df['DEG'].unique())}")
assert df['m6A'].isna().sum() == 0 and df['DEG'].isna().sum() == 0

order_m6a = ["m6A Hyper", "m6A Hypo", "m6A no sig"]
order_deg = ["Down", "Up", "no-DEGs"]

# ---- MAIN: 3x3 Pearson chi-square ----
ct = pd.crosstab(df["m6A"], df["DEG"]).reindex(index=order_m6a, columns=order_deg).fillna(0).astype(int)
print("\n=== 3x3 contingency table (m6A x DEG) ===")
print(ct.to_string())
print("Row totals:", ct.sum(axis=1).to_dict())
print("Col totals:", ct.sum(axis=0).to_dict())

chi2_33, p_33, dof_33, exp = stats.chi2_contingency(ct, correction=False)
print(f"\n--- MAIN: Pearson chi-square 3x3 ---")
print(f"chi2 = {chi2_33:.6f}, dof = {dof_33}, p = {p_33:.6e}")
print(f"p-value (scientific notation) = {p_33:.6e}")
print(f"min expected cell = {exp.min():.3f} (all >5: {bool((exp>5).all())})")

# ---- SENSITIVITY 1: Fisher exact on 2x2 collapse ----
df["m6A_sig"] = df["m6A"].isin(["m6A Hyper", "m6A Hypo"])
df["DE"] = df["DEG"].isin(["Up", "Down"])
ct2 = pd.crosstab(df["m6A_sig"], df["DE"]).reindex(index=[False, True], columns=[False, True]).fillna(0).astype(int)
print("\n=== 2x2 collapse (m6A sig vs not; DE vs not) ===")
print(ct2.to_string())
odds, p_fisher = stats.fisher_exact(ct2)
print(f"Fisher exact 2x2: odds_ratio = {odds:.4f}, p = {p_fisher:.6e}")

# ---- SENSITIVITY 2: Monte Carlo permutation chi-square on 3x3 ----
m6a_i = df["m6A"].map({k: i for i, k in enumerate(order_m6a)}).to_numpy()
deg_i = df["DEG"].map({k: i for i, k in enumerate(order_deg)}).to_numpy()

def chi2_stat(table):
    t = table.astype(float)
    r = t.sum(axis=1, keepdims=True); c = t.sum(axis=0, keepdims=True)
    e = r @ c / t.sum()
    return ((t - e) ** 2 / e).sum()

def table_from(m6a_arr, deg_arr):
    t = np.zeros((3, 3), dtype=float)
    np.add.at(t, (m6a_arr, deg_arr), 1)
    return t

obs_stat = chi2_stat(table_from(m6a_i, deg_i))
rng = np.random.default_rng(42)
n_iter = 20000
cnt = 0
for _ in range(n_iter):
    perm = rng.permutation(deg_i)          # shuffle DEG labels across all sites -> preserves both margins
    if chi2_stat(table_from(m6a_i, perm)) >= obs_stat:
        cnt += 1
p_monte = (cnt + 1) / (n_iter + 1)
print(f"\nMonte Carlo permutation chi-square 3x3 ({n_iter} perms, seed=42): "
      f"observed chi2={obs_stat:.4f}, p = {p_monte:.6e} (count={cnt}; resolution limit = {1/(n_iter+1):.2e})")

print("\n================= SUMMARY =================")
print(f"MAIN p-value (Pearson chi-square, 3x3 table, site-level N={N}): {p_33:.6e}")
print(f"Sensitivity Fisher 2x2: {p_fisher:.6e}")
print(f"Sensitivity Monte Carlo 3x3: {p_monte:.6e}")
