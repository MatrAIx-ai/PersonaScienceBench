import openpyxl, math
from collections import OrderedDict

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

def fnum(x):
    """Parse a cell; '-' / None -> NaN."""
    if isinstance(x, (int, float)):
        return float(x)
    return float('nan')

# ---- Load NormCount: header at row index 3, data from row index 4 ----
wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb["NormCount"]
rows = []
for i, row in enumerate(ws.iter_rows(values_only=True)):
    if i < 4:
        continue
    rows.append(row)
wb.close()
n_gene = len(rows)
print("Genes loaded:", n_gene)

# DESeq bad-vs-Control comparison blocks (9 cols each): baseMean at cs, log2FoldChange at cs+4, padj at cs+6
comparisons = OrderedDict([
    ("baseline_blood", 107),   # Comp2
    ("dentate_gyrus",    134), # Comp5
    ("final_blood",      161), # Comp8
])

# sample column ranges: (Control, good, bad) per tissue
tissue_cols = {
    "baseline_blood": (range(2,12),  range(12,22), range(22,32)),
    "dentate_gyrus":  (range(32,42), range(42,52), range(52,62)),
    "final_blood":    (range(62,72), range(72,82), range(82,92)),
}

def geomean(vals):
    v = [x for x in vals if isinstance(x, (int, float)) and x > 0]
    if not v:
        return float('nan')
    return math.exp(sum(math.log(x) for x in v) / len(v))

results = {}
for tissue, cs in comparisons.items():
    c, g, b = tissue_cols[tissue]
    cnt_main = 0      # lfc>0.5 & basemean>10
    cnt_padj = 0      # + padj<0.05
    cnt_re = 0        # cross-check recomputed
    for r in rows:
        lfc = fnum(r[cs + 4])
        bm  = fnum(r[cs])
        padj= fnum(r[cs + 6])
        if not (lfc > 0.5) or not (bm > 10):
            continue
        cnt_main += 1
        if not math.isnan(padj) and padj < 0.05:
            cnt_padj += 1
        # cross-check: recompute lfc and baseMean from raw normalized counts
        C = geomean([r[x] for x in c])
        B = geomean([r[x] for x in b])
        allv = [r[x] for x in list(c) + list(b)]
        BM = geomean(allv)
        if not (math.isnan(C) or math.isnan(B)):
            lfc_re = math.log(B / C)
            if lfc_re > 0.5 and BM > 10:
                cnt_re += 1
    results[tissue] = dict(main=cnt_main, padj=cnt_padj, recompute=cnt_re)

print("\n=== MAIN (DESeq2 blocks): lfc>0.5 & basemean>10 ===")
for t, d in results.items():
    print(f"  {t:16s} main={d['main']:6d}   +padj<0.05={d['padj']:6d}   recompute={d['recompute']:6d}")

winner = max(results, key=lambda t: results[t]["main"])
print("\nWINNER (main criterion):", winner, "->", results[winner]["main"], "genes")
