import pandas as pd, numpy as np
pd.set_option('display.width',200); pd.set_option('display.max_rows',100)

df = pd.read_csv('data/time_series_data.csv', index_col=0)

# --- Raw century-step pottery series (the real data points) ---
raw = df[df['PotteryForm'].notna()][['CE','PotteryForm','PotteryDecoration','PotteryForm_inter','PotteryDecoration_inter']].copy()
raw = raw.reset_index(drop=True)
print("Raw pottery points: %d (step = 100 yr, CE %d to %d)" % (len(raw), raw.CE.min(), raw.CE.max()))

# Deltas between consecutive 100-yr points
raw['dForm'] = raw['PotteryForm'].diff()
raw['dDeco'] = raw['PotteryDecoration'].diff()
raw['BCE'] = -raw['CE']

# Candidate: strong negative dForm AND strong positive dDeco
cand = raw[(raw['dForm'] < 0) & (raw['dDeco'] > 0)].copy()
cand['score'] = cand['dForm'] + cand['dDeco']  # net; most-negative-form with positive-deco
cand = cand.sort_values('dForm')
cols = ['BCE','PotteryForm','dForm','PotteryDecoration','dDeco']
print("\n=== All steps where Form decreases AND Decoration increases ===")
print(cand[cols].to_string())

# Best simultaneous candidate: most negative dForm among those with positive dDeco
best = cand.loc[cand['dForm'].idxmin()]
print("\n=== BEST simultaneous candidate ===")
print("BCE reached at:", int(best['BCE']))
print("Form: %s -> %s (dForm=%.2f)" % (best.PotteryForm-best.dForm, best.PotteryForm, best.dForm))
print("Deco: %s -> %s (dDeco=%.2f)" % (best.PotteryDecoration-best.dDeco, best.PotteryDecoration, best.dDeco))

# --- Validate with _inter at the same century steps ---
print("\n=== Validation: _inter values at century steps (should equal raw) ===")
chk = raw[['BCE','PotteryForm','PotteryForm_inter','PotteryDecoration','PotteryDecoration_inter']]
chk['form_ok'] = np.isclose(chk['PotteryForm'], chk['PotteryForm_inter'])
chk['deco_ok'] = np.isclose(chk['PotteryDecoration'], chk['PotteryDecoration_inter'])
print("Form raw==inter at all century steps:", chk['form_ok'].all())
print("Deco raw==inter at all century steps:", chk['deco_ok'].all())
print(chk[chk['BCE'].isin([1900,1800,1700,1600])].to_string())

# --- Validate with capital.csv ---
cap = pd.read_csv('data/capital.csv')
def conv(x):
    return x if pd.isna(x) else float(str(x).replace(',','.'))
cap['ZKeform']=cap['ZKeform'].apply(conv); cap['Zkeverz']=cap['Zkeverz'].apply(conv)
cap = cap[['BCE','group','ZKeform','Zkeverz']].sort_values('BCE',ascending=False).reset_index(drop=True)
cap['dForm']=cap['ZKeform'].diff(); cap['dDeco']=cap['Zkeverz'].diff()
print("\n=== capital.csv around transition (BCE, group, form, deco) ===")
print(cap[cap['BCE'].isin([1900,1800,1700,1600,1000,500])].to_string())
# cross-check the key values match
m = raw.merge(cap, left_on='BCE', right_on='BCE')
m['form_match']=np.isclose(m['PotteryForm'],m['ZKeform']); m['deco_match']=np.isclose(m['PotteryDecoration'],m['Zkeverz'])
print("capital.csv matches time_series raw on %d/%d shared BCE points (form & deco)" % (
    (m['form_match']&m['deco_match']).sum(), len(m)))
