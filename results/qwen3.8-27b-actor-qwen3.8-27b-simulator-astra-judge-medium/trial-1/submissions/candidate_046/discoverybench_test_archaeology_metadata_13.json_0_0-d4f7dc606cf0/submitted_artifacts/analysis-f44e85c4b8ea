"""
DiscoveryBench: highest-growth phase between 2000 and 1100 BCE.
Primary growth rate = pollen_grate_100 (100-yr % change of interpolated Belau
pollen/openness). Secondary cross-checks: g_all_mean (KDE growth-rate mean) and
the openness level (MEAN, two-site pollen PC1).
"""
import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
po = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0, decimal=',')

# Interval 2000-1100 BCE -> CE in [-2000, -1100]
m = (ts.CE >= -2000) & (ts.CE <= -1100)
sub = ts[m].copy()
sub['bce'] = -sub.CE
# 100-yr bins on the CE axis; bin label = BCE start year (2000 = 2000-1901 BCE)
sub['bin'] = ((sub.bce - 1)//100)*100 + 100
order = [2000,1900,1800,1700,1600,1500,1400,1300,1200,1100]

# PRIMARY + SECONDARY per-bin means
g = sub.groupby('bin').agg(
    n=('pollen_grate_100','size'),
    pollen_grate_100_mean=('pollen_grate_100','mean'),
    g_all_mean_mean=('g_all_mean','mean'),
).reindex(order)

# SECONDARY openness level (two-site MEAN) per bin + slope
p = po[['CE','MEAN']].copy(); p['bce']=-p.CE
p['bin'] = ((p.bce-1)//100)*100+100
g['MEAN_level'] = p[p.bin.isin(order)].groupby('bin')['MEAN'].mean().reindex(order)
g['MEAN_slope'] = g['MEAN_level'].diff()

print("=== Per-century table (bin = BCE start; 2000 = 2000-1901 BCE) ===")
print(g.to_string(float_format=lambda x: f"{x:.5f}"))

rates = g['pollen_grate_100_mean'].dropna()
peak_bin = rates.idxmax(); peak_val = rates.max()
# contiguous phase = bins with positive rate >= 50% of max, in time order
thr = 0.5*peak_val
phase = [b for b in order if pd.notna(rates.get(b)) and rates[b] > 0 and rates[b] >= thr]
print(f"\nPRIMARY peak: bin {peak_bin} (BCE {peak_bin}-{peak_bin-99}) rate={peak_val:.5f}")
print(f"Contiguous highest-growth phase (positive, >=50% of max): {phase}")

# Robustness: 200-yr centered smoothing of the annual rate
s = sub.copy()
s['rate200'] = s.pollen_grate_100.rolling(200, center=True, min_periods=50).mean()
s['g200']    = s.g_all_mean.rolling(200, center=True, min_periods=50).mean()
i = s.rate200.idxmax(); j = s.g200.idxmax()
print(f"\nROBUSTNESS 200y-smoothed pollen_grate_100 peak: BCE {int(-s.loc[i,'CE'])}")
print(f"ROBUSTNESS 200y-smoothed g_all_mean peak:        BCE {int(-s.loc[j,'CE'])}")
