# -*- coding: utf-8 -*-
"""
PCA on the forms of capital in 100-year time slices.
Objective: characterize the Middle Neolithic (MN, 3400-3000 BCE) and the
Younger Neolithic (SG/YN, 2900-2300 BCE) in terms of PC1 of a PCA on the
forms of capital analyzed in hundred-year time slices.

Data: data/capital.csv  -> 39 rows, one 100-year (century) bin each, from
4300 BCE to 500 BCE, with 12 Z-scored "forms of capital" variables.
Verified: capital.csv Z-values == time_series_data.csv *_inter values at the
century marks (max abs diff 0.0), i.e. capital.csv is the binned (100-y)
interpolated series.

Conventions (documented, per researcher approval):
- PCA on the 12 individual forms of capital (primary reading of the question).
- Standardize each variable to mean 0 / std 1 (ddof=1) before PCA  -> PCA on
  the correlation matrix.
- PC1 sign fixed toward the "greater capital / complexity" direction: the sign
  is flipped if needed so that the mean PC1 score of the high-complexity Bronze
  Age bins (OBA+YBA) is positive. The ABSOLUTE sign is a convention; the
  relative MN vs YN comparison is sign-invariant.
- Periods taken from the 'group' column (MN, SG), which matches the question
  ranges exactly. Binning convention: each row labels a 100-year bin by its
  starting (older) year (e.g. the '3400' bin spans 3400-3301 BCE); the two
  target periods are defined by the group labels, so the exact within-bin
  boundary convention does not affect the period assignment.
"""
import pandas as pd
import numpy as np

pd.set_option('display.width', 200)

# ---------------------------------------------------------------- load
cap = pd.read_csv('data/capital.csv', decimal=',')
zcols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument',
         'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']
assert cap[zcols].isna().sum().sum() == 0, "unexpected missing values"
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)  # old -> young

# ---------------------------------------------------------------- standardize (ddof=1)
X = cap[zcols].to_numpy(dtype=float)
mu = X.mean(axis=0)
sd = X.std(axis=0, ddof=1)
Xs = (X - mu) / sd

# ---------------------------------------------------------------- PCA via SVD
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
eigval = S**2 / (S**2).sum()          # explained variance ratio (total = 1)
scores = U * S                          # component scores (sign arbitrary)
loadings = Vt                            # rows = PCs, cols = variables

# ---- fix PC1 sign toward greater capital/complexity (Bronze Age positive)
bronze_mask = cap['group'].isin(['OBA', 'YBA']).to_numpy()
if scores[bronze_mask, 0].mean() < 0:
    scores[:, 0] = -scores[:, 0]
    loadings[0, :] = -loadings[0, :]
cap['PC1'] = scores[:, 0]
cap['PC2'] = scores[:, 1]

# ---------------------------------------------------------------- helper
def period_stats(df):
    return dict(n=len(df), mean=df['PC1'].mean(), min=df['PC1'].min(),
                max=df['PC1'].max(),
                range=(df['PC1'].max()-df['PC1'].min()))

mn = cap[(cap['BCE'] >= 3000) & (cap['BCE'] <= 3400)]   # 3400-3000 BCE
yn = cap[(cap['BCE'] >= 2300) & (cap['BCE'] <= 2900)]   # 2900-2300 BCE
# cross-check with group labels
assert set(mn['group']) == {'MN'} and set(yn['group']) == {'SG'}

print("="*70)
print("PCA ON THE 12 FORMS OF CAPITAL  (100-year bins, n=39)")
print("="*70)
print("Explained variance ratio (all 12 PCs):")
print(np.round(eigval, 4).tolist())
print(f"PC1 EVR = {eigval[0]:.4f} ; PC1+PC2 = {eigval[0]+eigval[1]:.4f} ; "
      f"cumulative first 3 = {eigval[:3].sum():.4f}")

print("\nPC1 loadings (sorted by |loading|):")
order = np.argsort(-np.abs(loadings[0]))
for j in order:
    print(f"  {zcols[j]:14s} {loadings[0,j]:+.3f}")

print("\nPer-bin PC1 scores (old -> young):")
for _, r in cap.iterrows():
    tag = ''
    if r['group'] == 'MN': tag = '   <== MN (3400-3000)'
    elif r['group'] == 'SG': tag = '   <== YN/SG (2900-2300)'
    print(f"  {int(r['BCE']):5d} BCE  [{r['group']}]  PC1 = {r['PC1']:+.3f}{tag}")

ms, ys = period_stats(mn), period_stats(yn)
# within-period linear trend (slope per 100-yr step, time increasing = BCE decreasing)
mn_t = np.arange(len(mn)); yn_t = np.arange(len(yn))
mn_slope = np.polyfit(mn_t, mn['PC1'].to_numpy(), 1)[0]
yn_slope = np.polyfit(yn_t, yn['PC1'].to_numpy(), 1)[0]

print("\n" + "="*70)
print("MN (3400-3000 BCE)  vs  YN/SG (2900-2300 BCE)  -- PC1")
print("="*70)
print(f"MN : n={ms['n']}  mean={ms['mean']:+.3f}  min={ms['min']:+.3f}  "
      f"max={ms['max']:+.3f}  range={ms['range']:.3f}  trend/100y={mn_slope:+.3f}")
print(f"YN : n={ys['n']}  mean={ys['mean']:+.3f}  min={ys['min']:+.3f}  "
      f"max={ys['max']:+.3f}  range={ys['range']:.3f}  trend/100y={yn_slope:+.3f}")
print(f"Mean difference (MN - YN) = {ms['mean']-ys['mean']:+.3f}")
print(f"MN mean z-score within full series = { (ms['mean']-cap['PC1'].mean())/cap['PC1'].std(ddof=1):+.2f}")
print(f"YN mean z-score within full series = { (ys['mean']-cap['PC1'].mean())/cap['PC1'].std(ddof=1):+.2f}")
print(f"Full-series PC1: min={cap['PC1'].min():+.3f}  max={cap['PC1'].max():+.3f}  "
      f"mean={cap['PC1'].mean():+.3f}")
first_pos = cap[cap['PC1'] > 0]
print(f"First bin with positive PC1: {int(first_pos['BCE'].max()) if len(first_pos) else 'none'} BCE")

# ---------------------------------------------------------------- context: pollen landscape-openness PC1
poll = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
p_mn = poll[(poll['CE'] <= -3000) & (poll['CE'] >= -3400)]
p_yn = poll[(poll['CE'] <= -2300) & (poll['CE'] >= -2900)]
print("\n" + "="*70)
print("CONTEXT (not the target PCA): pollen landscape-openness PC1 (MEAN)")
print("="*70)
for col in ['MEAN', 'SMOOTH_MEAN_100y']:
    print(f"  {col:16s}: MN mean={p_mn[col].mean():+.3f}  |  YN mean={p_yn[col].mean():+.3f}")

# ---------------------------------------------------------------- robustness: capital-group aggregation (ASSUMED mapping)
group_map = {
    'Economic':   ['ZCU_AU', 'Zamber', 'ZSichel', 'ZBeil'],
    'Social':     ['ZMonument', 'ZMW', 'ZHort'],
    'Cultural':   ['ZKeform', 'Zkeverz'],
    'Symbolic':   ['ZAxtSchwert', 'ZDolch'],
    'Domestic':   ['Zhausgr'],
}
assert sorted(sum(group_map.values(), [])) == sorted(zcols)
gmeans = {g: cap[cols].mean(axis=1).to_numpy() for g, cols in group_map.items()}
G = np.column_stack([gmeans[g] for g in group_map])
gm = G.mean(axis=0); gs = G.std(axis=0, ddof=1)
Gs = (G - gm) / gs
Ug, Sg, Vtg = np.linalg.svd(Gs, full_matrices=False)
eg = Sg**2 / (Sg**2).sum()
gscores = Ug * Sg
if gscores[bronze_mask, 0].mean() < 0:
    gscores[:, 0] = -gscores[:, 0]; Vtg[0] = -Vtg[0]
cap['PC1_grp'] = gscores[:, 0]
gm2 = cap[(cap['BCE'] >= 3000) & (cap['BCE'] <= 3400)]['PC1_grp']
gy2 = cap[(cap['BCE'] >= 2300) & (cap['BCE'] <= 2900)]['PC1_grp']
print("\n" + "="*70)
print("ROBUSTNESS (assumed capital-group aggregation -> PCA on group means)")
print("="*70)
print("Group mapping (ASSUMPTION, not documented in study):")
for g, cols in group_map.items():
    print(f"  {g:10s}: {cols}")
print(f"Group-PCA PC1 EVR = {eg[0]:.4f}")
print(f"PC1_grp loadings: " + ", ".join(f"{g}={Vtg[0,i]:+.2f}" for i, g in enumerate(group_map)))
print(f"MN: mean={gm2.mean():+.3f} (min {gm2.min():+.3f}, max {gm2.max():+.3f})")
print(f"YN: mean={gy2.mean():+.3f} (min {gy2.min():+.3f}, max {gy2.max():+.3f})")
print(f"MN-YN mean diff (group PCA) = {gm2.mean()-gy2.mean():+.3f}")

print("\nDone.")
