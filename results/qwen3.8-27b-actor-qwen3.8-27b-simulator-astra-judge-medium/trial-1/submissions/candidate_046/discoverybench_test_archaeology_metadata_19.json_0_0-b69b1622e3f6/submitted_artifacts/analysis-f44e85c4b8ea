import csv
import numpy as np
from numpy.linalg import eigh

# ============================================================
# 1. LOAD DATA (handle comma decimal separator)
# ============================================================
with open('data/capital.csv', 'r') as f:
    reader = csv.reader(f)
    header = next(reader)
    rows = list(reader)

z_cols = header[3:]  # 12 Z columns
bce_list = []
data = []

for r in rows:
    bce = int(r[0])
    bce_list.append(bce)
    vals = []
    for i in range(12):
        raw = r[3+i].strip().replace(',', '.')
        vals.append(float(raw))
    data.append(vals)

data = np.array(data)  # shape: (39, 12)
bce_list = np.array(bce_list)

print("=" * 70)
print("PCA ON FORMS OF CAPITAL — 100-YEAR TIME SLICES")
print("=" * 70)
print(f"\nData shape: {data.shape} (39 time bins × 12 capital variables)")
print(f"BCE range: {min(bce_list)} to {max(bce_list)}")
print(f"Variables: {z_cols}")

# ============================================================
# 2. VERIFY DATA IS ALREADY Z-SCORED
# ============================================================
print(f"\n{'Column':>15} | {'Mean':>8} | {'Std':>8}")
print("-" * 40)
for i, col in enumerate(z_cols):
    print(f"{col:>15} | {data[:,i].mean():>8.4f} | {data[:,i].std(ddof=1):>8.4f}")

# ============================================================
# 3. COMPUTE PCA USING CORRELATION MATRIX
# ============================================================
# Correlation matrix (12x12)
corr_matrix = np.corrcoef(data, rowvar=False)  # 12x12

# Eigendecomposition of correlation matrix
eigenvalues, eigenvectors = eigh(corr_matrix)

# Sort by descending eigenvalue
idx = np.argsort(eigenvalues)[::-1]
eigenvalues = eigenvalues[idx]
eigenvectors = eigenvectors[:, idx]

# PC1
pc1_loadings = eigenvectors[:, 0]
pc1_variance_explained = eigenvalues[0] / np.sum(eigenvalues) * 100

# PC1 scores for all 39 time points
# Score = data @ eigenvector (projection onto PC1 direction)
pc1_scores = data @ pc1_loadings

print(f"\n{'=' * 70}")
print(f"PC1 VARIANCE EXPLAINED: {pc1_variance_explained:.2f}%")
print(f"{'=' * 70}")

# ============================================================
# 4. PC1 LOADINGS
# ============================================================
print(f"\n{'=' * 70}")
print("PC1 LOADINGS (which capital variables dominate)")
print(f"{'=' * 70}")
print(f"\n{'Variable':>15} | {'Loading':>8} | {'|Loading|':>10} | {'Rank':>5}")
print("-" * 50)
sorted_loadings = np.argsort(np.abs(pc1_loadings))[::-1]
for rank, i in enumerate(sorted_loadings, 1):
    print(f"{z_cols[i]:>15} | {pc1_loadings[i]:>8.4f} | {abs(pc1_loadings[i]):>10.4f} | {rank:>5}")

# ============================================================
# 5. PC1 SCORES FOR ALL 39 TIME POINTS
# ============================================================
print(f"\n{'=' * 70}")
print("PC1 SCORES — ALL 39 TIME BINS")
print(f"{'=' * 70}")
print(f"\n{'BCE':>5} | {'PC1 Score':>10} | {'Group'}")
print("-" * 35)

# Get group info
groups = {}
for r in rows:
    groups[int(r[0])] = r[1]

for i in range(len(bce_list)):
    bce = bce_list[i]
    marker = " ◄ YBA" if 500 <= bce <= 1100 else ""
    print(f"{bce:>5} | {pc1_scores[i]:>10.4f} | {groups[bce]}{marker}")

# ============================================================
# 6. PC1 SCORES FOR YBA (1100-500 BCE)
# ============================================================
print(f"\n{'=' * 70}")
print("PC1 SCORES — YOUNGER BRONZE AGE (1100-500 BCE)")
print(f"{'=' * 70}")

yba_mask = (bce_list >= 500) & (bce_list <= 1100)
yba_bce = bce_list[yba_mask]
yba_scores = pc1_scores[yba_mask]

print(f"\n{'BCE':>5} | {'PC1 Score':>10}")
print("-" * 20)
for bce, score in zip(yba_bce, yba_scores):
    print(f"{bce:>5} | {score:>10.4f}")

# ============================================================
# 7. DIFFERENCE: PC1(1100) vs PC1(1000-500)
# ============================================================
print(f"\n{'=' * 70}")
print("DIFFERENCE: PC1(1100 BCE) vs SUBSEQUENT YBA BINS")
print(f"{'=' * 70}")

pc1_1100 = None
for bce, score in zip(yba_bce, yba_scores):
    if bce == 1100:
        pc1_1100 = score
        break

print(f"\nPC1 at 1100 BCE: {pc1_1100:.4f}")
print(f"\n{'BCE':>5} | {'PC1 Score':>10} | {'PC1(1100) - PC1(x)':>18} | {'|Diff|':>8}")
print("-" * 55)

diffs = []
for bce, score in zip(yba_bce, yba_scores):
    if bce == 1100:
        continue
    diff = pc1_1100 - score
    diffs.append(diff)
    print(f"{bce:>5} | {score:>10.4f} | {diff:>18.4f} | {abs(diff):>8.4f}")

print(f"\nMean difference PC1(1100) - PC1(1000-500): {np.mean(diffs):.4f}")
print(f"Std of differences: {np.std(diffs, ddof=1):.4f}")
print(f"Min difference: {np.min(diffs):.4f}")
print(f"Max difference: {np.max(diffs):.4f}")

# ============================================================
# 8. ADDITIONAL: TOP 5 EIGENVALUES
# ============================================================
print(f"\n{'=' * 70}")
print("TOP 5 PRINCIPAL COMPONENTS — VARIANCE EXPLAINED")
print(f"{'=' * 70}")
print(f"\n{'PC':>3} | {'Eigenvalue':>10} | {'Var Explained %':>15} | {'Cumulative %':>13}")
print("-" * 50)
cumulative = 0
for i in range(5):
    var_pct = eigenvalues[i] / np.sum(eigenvalues) * 100
    cumulative += var_pct
    print(f"{'PC'+str(i+1):>3} | {eigenvalues[i]:>10.4f} | {var_pct:>15.2f} | {cumulative:>13.2f}")

# ============================================================
# 9. SUMMARY FOR HYPOTHESIS
# ============================================================
print(f"\n{'=' * 70}")
print("SUMMARY FOR HYPOTHESIS")
print(f"{'=' * 70}")
print(f"""
PC1 explains {pc1_variance_explained:.2f}% of total variance in the 12 forms of capital.

PC1 is dominated by: {z_cols[sorted_loadings[0]]} ({pc1_loadings[sorted_loadings[0]]:.3f}),
{z_cols[sorted_loadings[1]]} ({pc1_loadings[sorted_loadings[1]]:.3f}),
{z_cols[sorted_loadings[2]]} ({pc1_loadings[sorted_loadings[2]]:.3f}).

At 1100 BCE (beginning of YBA), PC1 = {pc1_1100:.4f}.
At 1000-500 BCE, PC1 ranges from {min(yba_scores[1:]):.4f} to {max(yba_scores[1:]):.4f}.

The difference PC1(1100) - PC1(subsequent) is consistently {'positive' if np.mean(diffs) > 0 else 'negative'},
with a mean of {np.mean(diffs):.4f} (range: {np.min(diffs):.4f} to {np.max(diffs):.4f}).

This indicates that at the beginning of the YBA (1100 BCE), the combination of capital
forms is {'stronger' if np.mean(diffs) > 0 else 'weaker'} along the PC1 axis compared to
the subsequent 1000-500 BCE period.
""")

