import pandas as pd, numpy as np

V12 = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
       "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
SYMB = ["Zhausgr","ZDolch","ZAxtSchwert"]

def pca_corr(X, names):
    X = np.asarray(X, float)
    Xs = (X - X.mean(0)) / X.std(0, ddof=1)      # re-standardize
    C = np.corrcoef(Xs, rowvar=False)            # Pearson correlation matrix
    w, V = np.linalg.eigh(C)                     # ascending
    order = np.argsort(w)[::-1]
    w = w[order]; V = V[:, order]
    # sign convention: largest-magnitude loading on each PC -> positive
    for j in range(V.shape[1]):
        k = np.argmax(np.abs(V[:, j]))
        if V[k, j] < 0:
            V[:, j] = -V[:, j]
    scores = Xs @ V
    return w, V, scores, w/ w.sum()

def report(tag, X, names, groups=None):
    w, V, S, evr = pca_corr(X, names)
    print(f"\n===== {tag} =====")
    print("Explained variance ratio (top 6):", np.round(evr[:6],4))
    print("PC1 %var:", round(evr[0]*100,2), " PC2 %var:", round(evr[1]*100,2), " PC1+PC2:", round((evr[0]+evr[1])*100,2))
    print("\nAll loadings (PC1, PC2):")
    for i,n in enumerate(names):
        mk = "  <== SYMBOLIC" if n in SYMB else ""
        print(f"  {n:14s} PC1={V[i,0]:+.4f}  PC2={V[i,1]:+.4f}{mk}")
    print("\nSYMBOLIC loadings:")
    for n in SYMB:
        i = names.index(n)
        print(f"  {n:14s} PC1={V[i,0]:+.4f}  PC2={V[i,1]:+.4f}")
    df = pd.DataFrame(S[:, :2], columns=["PC1","PC2"])
    if groups is not None:
        df["group"] = groups
        print("\nMean PC1/PC2 score per period (group):")
        print(df.groupby("group")[["PC1","PC2"]].mean().round(3).to_string())
        print("\nN per group:", df.groupby("group").size().to_dict())
        # range / spread
        print("\nPC1/PC2 score min-max overall:",
              np.round(df[["PC1","PC2"]].min().values,2), np.round(df[["PC1","PC2"]].max().values,2))
    return V, evr, S, df

# ---------- PRIMARY: capital.csv ----------
cap = pd.read_csv("data/capital.csv", decimal=",")
Xcap = cap[V12].values
groups = cap["group"].values
Vc, evrc, Sc, dfc = report("PRIMARY: capital.csv (39 bins x 12 vars, corr matrix, re-standardized)",
                           Xcap, V12, groups)

# ---------- ROBUSTNESS: time_series_data.csv *_inter binned to 100y ----------
ts = pd.read_csv("data/time_series_data.csv", index_col=0)
mapg = {"HatchetSword":"ZAxtSchwert","Dagger":"ZDolch","HouseSize":"Zhausgr","CopperGold":"ZCU_AU",
        "Amber":"Zamber","MonumentCount":"ZMonument","Depot":"ZHort","Sickle":"ZSichel",
        "AxesCelts":"ZBeil","MonumentSize":"ZMW","PotteryForm":"ZKeform","PotteryDecoration":"Zkeverz"}
ts["BCE"] = -ts["CE"]
ts["bin"] = np.floor(ts["BCE"]/100.0)*100
im = ts.groupby("bin")[[e+"_inter" for e in mapg]].mean()
im.columns = [mapg[c.replace("_inter","")] for c in im.columns]
im = im.reset_index().rename(columns={"bin":"BCE"}).sort_values("BCE")
Xts = im[V12].values
# map group via capital BCE
gmap = dict(zip(cap["BCE"], cap["group"]))
im["group"] = im["BCE"].map(gmap)
gt = im["group"].values
Vt, evrt, St, _ = report("ROBUSTNESS: time_series *_inter binned 100y (mean) x 12 vars", Xts, V12, gt)

# compare symbolic loadings
print("\n===== COMPARISON symbolic loadings (capital vs time_series) =====")
print(f"{'var':14s} {'capPC1':>8s} {'tsPC1':>8s} | {'capPC2':>8s} {'tsPC2':>8s}")
for n in SYMB:
    i = V12.index(n)
    print(f"{n:14s} {Vc[i,0]:+8.4f} {Vt[i,0]:+8.4f} | {Vc[i,1]:+8.4f} {Vt[i,1]:+8.4f}")
