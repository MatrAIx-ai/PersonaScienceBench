"""
Main analysis: MonumentCount & AxesCelts vs symbolic-capital Z-scores,
3400-3000 BCE (5 raw 100-yr bins). Data: time_series_data.csv / capital.csv.
"""
import pandas as pd, numpy as np
from scipy import stats

ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')

# --- 5 raw bins, cross-checked between the two files ---
w = ts[(ts['CE']>=-3400)&(ts['CE']<=-3000)].dropna(subset=['MonumentCount']).copy()
w['BCE'] = -w['CE']
assert len(w)==5, w
cw = cap[(cap['BCE']<=3400)&(cap['BCE']>=3000)].sort_values('BCE', ascending=False).reset_index(drop=True)
for a,b in zip(w['BCE'], cw['BCE']): assert int(a)==int(b)
for t,c in [('MonumentCount','ZMonument'),('AxesCelts','ZBeil'),('HatchetSword','ZAxtSchwert'),
            ('Dagger','ZDolch'),('HouseSize','Zhausgr'),('Depot','ZHort')]:
    assert np.allclose(w[t].values, cw[c].values), t
print("Files agree on all 5 bins x 6 variables.")
print(w[['BCE','MonumentCount','AxesCelts','HatchetSword','Dagger','HouseSize','Depot']].to_string(index=False))

def corr_ci(r, n, alpha=0.05):
    if np.isnan(r) or abs(r)>=1: return (np.nan,np.nan)
    z = np.arctanh(r); se = 1/np.sqrt(n-3)
    lo, hi = np.tanh(z-1.96*se), np.tanh(z+1.96*se)
    return (lo,hi)

out=[]
for y in ['MonumentCount','AxesCelts']:
    for x in ['Zhausgr','ZAxtSchwert','ZDolch','ZHort']:
        col = x if x in w else x
        xv = w[{'Zhausgr':'HouseSize','ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','ZHort':'Depot'}[x]]
        r,p = stats.pearsonr(w[y], xv)
        rho,ps = stats.spearmanr(w[y], xv)
        lo,hi = corr_ci(r,5)
        out.append(dict(outcome=y, predictor=x, n=5, pearson_r=round(r,3) if not np.isnan(r) else np.nan,
                        pearson_p=round(p,3) if not np.isnan(p) else np.nan, ci95=f"[{lo:.2f}, {hi:.2f}]",
                        spearman_rho=round(rho,3) if not np.isnan(rho) else np.nan,
                        spearman_p=round(ps,3) if not np.isnan(ps) else np.nan,
                        x_std=round(xv.std(ddof=1),4)))
res = pd.DataFrame(out)
print(res.to_string(index=False))

# --- OLS: MonumentCount ~ Zhausgr + ZAxtSchwert (ZDolch constant -> excluded) ---
import statsmodels.api as sm
X = sm.add_constant(w[['HouseSize','HatchetSword']])
m = sm.OLS(w['MonumentCount'], X).fit()
print("\nOLS MonumentCount ~ 1 + HouseSize + HatchetSword:\n", m.summary())
print("VIF check: corr(HouseSize,HatchetSword) =", round(w['HouseSize'].corr(w['HatchetSword']),3),
      "| HAxtSchw std =", round(w['HatchetSword'].std(ddof=1),4))

# --- Sensitivity: annual _inter grid (pseudo-replication demo) ---
wa = ts[(ts['CE']>=-3400)&(ts['CE']<=-3000)]
r_bin,_ = stats.pearsonr(w['MonumentCount'], w['HouseSize'])
r_ann,_ = stats.pearsonr(wa['MonumentCount_inter'], wa['HouseSize_inter'])
print(f"\nSensitivity Mon~Hausgr: 5-bin r={r_bin:.3f} | annual _inter r={r_ann:.3f} (n=401, autocorrelated)")

# --- Pollen context (not in core model) ---
p = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
pw = p[(p['CE']>=-3400)&(p['CE']<=-3000)]
m100 = pw.set_index('CE')['SMOOTH_MEAN_100y']
for ce in [-3400,-3300,-3200,-3100,-3000]:
    print(f"pollen SMOOTH_MEAN_100y @ CE {ce}: {m100[ce]:.3f}")
res.to_csv('analysis/correlations_3400_3000.csv', index=False)
print("\nSaved analysis/correlations_3400_3000.csv")
