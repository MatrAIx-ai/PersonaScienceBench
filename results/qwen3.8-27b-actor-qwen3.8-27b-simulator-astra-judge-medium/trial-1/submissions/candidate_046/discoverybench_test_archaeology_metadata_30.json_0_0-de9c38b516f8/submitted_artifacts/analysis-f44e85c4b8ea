"""
DiscoveryBench: first century where Diversity in Pottery Decoration increases
significantly while Diversity in Pottery Form declines simultaneously.

Workflow: load -> comma-to-dot conversion (capital.csv) -> extract 37 raw
century points -> cross-check datasets -> century deltas -> chronological scan
with threshold tau + sensitivity -> robustness checks -> report.
"""
import pandas as pd
import numpy as np

pd.set_option("display.width", 200)

# ---------------------------------------------------------------- load / clean
ts = pd.read_csv("data/time_series_data.csv", index_col=0)
cap = pd.read_csv("data/capital.csv")

# comma -> dot decimal conversion for capital.csv Z columns
for c in cap.columns:
    if c not in ("BCE", "group", "color"):
        cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(",", ".", regex=False), errors="coerce")

# ------------------------------------------------- extract raw century points
decade = ts[ts["CE"] % 100 == 0].copy()
pts = decade[["CE", "PotteryForm", "PotteryDecoration"]].copy()
pts.columns = ["CE", "Form", "Decor"]
assert len(pts) == 37, "expected 37 raw century points"
assert pts[["Form", "Decor"]].notna().all().all(), "raw points must be complete"

# cross-check vs capital.csv (BCE = -CE; capital labels bin by start year)
cap_chk = cap[["BCE", "ZKeform", "Zkeverz"]].copy()
cap_chk["CE"] = -cap_chk["BCE"]
m = pts.merge(cap_chk, on="CE", how="inner")
agree_form = np.allclose(m["Form"], m["ZKeform"])
agree_decor = np.allclose(m["Decor"], m["Zkeverz"])
print(f"[cross-check] merged points: {len(m)}/37 | Form matches capital.csv: {agree_form} | Decor matches: {agree_decor}")

# ------------------------------------------------------------- century deltas
pts["dForm"] = pts["Form"].diff()
pts["dDecor"] = pts["Decor"].diff()
d = pts.dropna(subset=["dForm"]).reset_index(drop=True)   # 36 deltas
print(f"[deltas] n = {len(d)}")

# ------------------------------------------ chronological scan with threshold
def first_opposite(tau):
    hit = d[(d["dDecor"] >= tau) & (d["dForm"] <= -tau)]
    if hit.empty:
        return None
    return hit.iloc[0]

print("\n[scan] first century where Decor rises >= +tau AND Form falls <= -tau:")
for tau in (0.10, 0.15, 0.25, 0.50):
    r = first_opposite(tau)
    if r is None:
        print(f"  tau={tau:.2f}: no event")
    else:
        print(f"  tau={tau:.2f}: CE {int(r['CE'])}  (change between {int(r['CE'])+100} and {int(r['CE'])} CE)  "
              f"dForm={r['dForm']:+.2f}  dDecor={r['dDecor']:+.2f}")

# robust check: |delta| in MAD units of the delta distribution
for col in ("dForm", "dDecor"):
    mad = np.median(np.abs(d[col] - np.median(d[col])))
    print(f"[robust] {col}: median={np.median(d[col]):+.3f}, MAD={mad:.3f}")
rob = d[(d["dDecor"] >= 1.0 * np.median(np.abs(d['dDecor'] - np.median(d['dDecor'])))) &
        (d["dForm"] <= -1.0 * np.median(np.abs(d['dForm'] - np.median(d['dForm']))))]
print(f"[robust] MAD-based (1.0*MAD) first event: "
      + (f"CE {int(rob.iloc[0]['CE'])}" if not rob.empty else "none"))

# -------------------------------------- robustness: bin means of interpolated
b = ts.groupby(ts["CE"] // 100).agg(
    Form_mean=("PotteryForm_inter", "mean"), Decor_mean=("PotteryDecoration_inter", "mean")).reset_index()
b.columns = ["bin_start_CE", "Form_mean", "Decor_mean"]
b["dForm"] = b["Form_mean"].diff()
b["dDecor"] = b["Decor_mean"].diff()
rb = b.dropna(subset=["dForm"])
hit_rb = rb[(rb["dDecor"] >= 0.25) & (rb["dForm"] <= -0.25)]
print(f"[robustness] bin-mean of _inter (tau=0.25): "
      + (f"first event bin starting CE {int(hit_rb.iloc[0]['bin_start_CE'])} (dForm={hit_rb.iloc[0]['dForm']:+.3f}, dDecor={hit_rb.iloc[0]['dDecor']:+.3f})"
         if not hit_rb.empty else "none"))

# ------------------------------------------------------------- full table
tab = d.copy()
tab["qualifies"] = (tab["dDecor"] >= 0.25) & (tab["dForm"] <= -0.25)
print("\n[full table] 36 century deltas (tau=0.25):")
print(tab.to_string(index=False,
                    formatters={"Form": "{:+.2f}".format, "Decor": "{:+.2f}".format,
                                "dForm": "{:+.2f}".format, "dDecor": "{:+.2f}".format,
                                "CE": "{:.0f}".format,
                                "qualifies": lambda x: "  <-- OPPOSITE TRENDS" if x else ""}))

# final answer block
r = first_opposite(0.25)
print("\n[answer] first opposite-trend event (tau=0.25):")
print(f"  change between {int(r['CE'])-100} BCE and {int(r['CE'])} BCE")
print(f"  Form: {r['Form']-r['dForm']:+.2f} -> {r['Form']:+.2f} (dForm={r['dForm']:+.2f})")
print(f"  Decor: {r['Decor']-r['dDecor']:+.2f} -> {r['Decor']:+.2f} (dDecor={r['dDecor']:+.2f})")
print(f"  calBP: {1950 - (int(r['CE'])-100)} -> {1950 - int(r['CE'])} calBP")
print(f"  capital.csv period at {int(r['CE'])} BCE: {cap.loc[cap['BCE']==-int(r['CE']), 'group'].iloc[0]}")
