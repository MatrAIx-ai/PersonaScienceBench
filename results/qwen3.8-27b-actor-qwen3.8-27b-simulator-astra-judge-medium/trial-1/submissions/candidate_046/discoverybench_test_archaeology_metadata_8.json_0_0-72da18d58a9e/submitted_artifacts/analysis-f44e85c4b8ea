"""Analysis: In which millennium did amber have the highest value and in what time interval did it peak?

Workflow: load -> normalize decimal comma (capital.csv) -> select non-NaN 100-year bins
-> argmax -> identify contiguous maximum run -> convert to BCE/CE/calBP.

Study context (archaeology.domain_knowledge.1) confirms the analysis works in 100-year
bins, validating the use of the raw bin values (Amber / Zamber) rather than the
interpolated annual series (Amber_inter).
"""
import pandas as pd

ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv')

# Normalize German decimal comma in capital.csv
cap['zamber'] = cap['Zamber'].str.replace(',', '.', regex=False).astype(float)

# Amber raw values exist only at 100-year bins (CE multiples of 100)
raw = ts.dropna(subset=['Amber']).copy()
assert (raw.CE % 100 == 0).all(), "raw amber not on 100-year grid"
raw['BCE'] = -raw.CE
raw['calBP'] = raw.calBP

# Cross-validate against capital.csv Zamber
merged = raw.merge(cap[['BCE', 'zamber']], on='BCE', how='inner')
assert (merged.Amber == merged.zamber).all(), "Amber vs Zamber mismatch"
print(f"Cross-check: {len(merged)} bins, Amber == Zamber in all of them: True")

mx = raw.Amber.max()
print(f"Maximum amber Z value: {mx}")

peak_bins = raw[raw.Amber == mx]
print(f"Bins at max: BCE {sorted(peak_bins.BCE.tolist())} (i.e. CE {sorted(peak_bins.CE.tolist())})")

# Contiguous run check
bces = sorted(peak_bins.BCE.tolist(), reverse=True)
run = all(bces[i] - bces[i+1] == 100 for i in range(len(bces)-1))
print(f"Contiguous 100-year run: {run}")

start_bce, end_bce = max(bces), min(bces)   # 3300 -> 3000 BCE
start_ce, end_ce = -start_bce, -end_bce     # -3300 -> -3000 CE
row_start = raw[raw.BCE == start_bce].iloc[0]
row_end = raw[raw.BCE == end_bce].iloc[0]
print(f"Peak interval: {start_bce} BCE – {end_bce} BCE  |  CE {start_ce} – {end_ce}  |  calBP {row_start.calBP} – {row_end.calBP}")

# Millennium (strict convention: 4th millennium BCE = 3999–3000 BCE; the plateau 3300–3000 BCE lies fully inside it)
print("Millennium: 4th millennium BCE (3999–3000 BCE; commonly rounded 4000–3001 BCE)")

# Corroboration with interpolated series
mxi = ts.Amber_inter.max()
print(f"Corroboration: max Amber_inter = {mxi} at CE {ts.loc[ts.Amber_inter.idxmax(),'CE']} (same value, forward-filled plateau)")

# Neighborhood for context
nb = raw[raw.BCE.between(2800, 3500)][['BCE','Amber']]
print("Neighborhood:\n" + nb.to_string(index=False))
