"""
Analysis: In which century did summed social capital peak, and which
individual social capital components increased?

Social capital components (per archaeology.domain_knowledge.1):
  - Copper/Gold  (CopperGold_inter / ZCU_AU)
  - Amber        (Amber_inter / Zamber)
  - Monument Count (MonumentCount_inter / ZMonument)

Primary dataset: data/time_series_data.csv (annual, CE -4100 to -500)
Cross-check:     data/capital.csv (100-yr bins, BCE 4300 to 500)
"""

import pandas as pd
import numpy as np

# ── 1. Load and prepare primary dataset ──────────────────────────────
ts = pd.read_csv("data/time_series_data.csv")
ts["bce"] = -ts["CE"]
ts["century_bce"] = np.ceil(ts["bce"] / 100).astype(int)

sc3 = ["CopperGold_inter", "Amber_inter", "MonumentCount_inter"]
ts["sc3_sum"] = ts[sc3].sum(axis=1)

# ── 2. Century-level aggregation (primary: 3 components) ─────────────
cent3 = ts.groupby("century_bce").agg(
    sc3_mean=("sc3_sum", "mean"),
    sc3_max=("sc3_sum", "max"),
    sc3_median=("sc3_sum", "median"),
    CG_mean=("CopperGold_inter", "mean"),
    Am_mean=("Amber_inter", "mean"),
    MC_mean=("MonumentCount_inter", "mean"),
).sort_index(ascending=False)

peak_c = cent3["sc3_mean"].idxmax()
peak_val = cent3["sc3_mean"].max()

print("=" * 70)
print("PRIMARY RESULT: 3-component summed social capital")
print("=" * 70)
print(f"Peak century: {peak_c}th century BCE")
print(f"  Interval: {peak_c*100} - {(peak_c-1)*100+1} BCE")
print(f"  Mean summed SC: {peak_val:.4f}")
print(f"  Max  summed SC: {cent3['sc3_max'].max():.4f} (century {cent3['sc3_max'].idxmax()})")
print(f"  Median summed SC: {cent3['sc3_median'].max():.4f} (century {cent3['sc3_median'].idxmax()})")
print()

# Component values at peak and neighboring centuries
print("Component means around the peak:")
print(f"{'Century':>10} | {'CopperGold':>12} | {'Amber':>10} | {'MonumentCnt':>12} | {'SUM':>10}")
for c in range(peak_c + 3, peak_c - 3, -1):
    if c in cent3.index:
        row = cent3.loc[c]
        marker = "  <<PEAK" if c == peak_c else ""
        print(f"{c:>8} c. | {row['CG_mean']:>12.4f} | {row['Am_mean']:>10.4f} | {row['MC_mean']:>12.4f} | {row['sc3_mean']:>10.4f}{marker}")
print()

# Component changes: peak century vs. preceding century
prev_c = peak_c + 1
if prev_c in cent3.index:
    cg_change = cent3.loc[peak_c, "CG_mean"] - cent3.loc[prev_c, "CG_mean"]
    am_change = cent3.loc[peak_c, "Am_mean"] - cent3.loc[prev_c, "Am_mean"]
    mc_change = cent3.loc[peak_c, "MC_mean"] - cent3.loc[prev_c, "MC_mean"]
    print(f"Changes from {prev_c}th c. -> {peak_c}th c. BCE:")
    print(f"  Copper/Gold:   {cent3.loc[prev_c,'CG_mean']:.4f} -> {cent3.loc[peak_c,'CG_mean']:.4f}  (delta = {cg_change:+.4f})")
    print(f"  Amber:         {cent3.loc[prev_c,'Am_mean']:.4f} -> {cent3.loc[peak_c,'Am_mean']:.4f}  (delta = {am_change:+.4f})")
    print(f"  MonumentCount: {cent3.loc[prev_c,'MC_mean']:.4f} -> {cent3.loc[peak_c,'MC_mean']:.4f}  (delta = {mc_change:+.4f})")
    print()

# ── 3. Cross-check with capital.csv ──────────────────────────────────
cap = pd.read_csv("data/capital.csv")
zcols = ["ZCU_AU", "Zamber", "ZMonument"]
for c in zcols:
    cap[c] = cap[c].str.replace(",", ".").astype(float)
cap["sc3_sum"] = cap[zcols].sum(axis=1)
cap["century_bce"] = np.ceil(cap["BCE"] / 100).astype(int)

cap_check = cap.groupby("century_bce")["sc3_sum"].first().sort_index(ascending=False)
cap_peak = cap_check.idxmax()
print("=" * 70)
print("CROSS-CHECK: capital.csv (100-yr bins)")
print("=" * 70)
print(f"Peak century from capital.csv: {cap_peak}th century BCE")
print(f"  Value: {cap_check.max():.4f}")
print(f"  Matches primary result: {cap_peak == peak_c}")
print()

# ── 4. Sensitivity: 5 components ─────────────────────────────────────
sc5 = sc3 + ["Depot_inter", "MonumentSize_inter"]
ts["sc5_sum"] = ts[sc5].sum(axis=1)
cent5 = ts.groupby("century_bce")["sc5_sum"].mean()
peak5 = cent5.idxmax()

print("=" * 70)
print("SENSITIVITY: 5-component (add Depot + MonumentSize)")
print("=" * 70)
print(f"Peak century: {peak5}th century BCE  (value = {cent5.max():.4f})")
print(f"  3-comp peak was: {peak_c}th c. BCE -> {'SAME' if peak5==peak_c else 'DIFFERENT'}")
print()
print("Top-5 centuries (5-comp):")
for c, v in cent5.sort_values(ascending=False).head(5).items():
    print(f"  {c}th c. BCE: {v:.4f}")
print()

# ── 5. Full century table (3-comp) for reference ─────────────────────
print("=" * 70)
print("FULL TABLE: 3-component summed SC by century (BCE, desc)")
print("=" * 70)
print(cent3[["sc3_mean","CG_mean","Am_mean","MC_mean"]].to_string())
print()

# ── 6. Summary for hypothesis ────────────────────────────────────────
print("=" * 70)
print("SUMMARY FOR HYPOTHESIS")
print("=" * 70)
print(f"Summed social capital (CopperGold + Amber + MonumentCount) peaked in the")
print(f"{peak_c}th century BCE ({peak_c*100}-{(peak_c-1)*100+1} BCE).")
print(f"Peak mean value: {peak_val:.4f}")
print()
print(f"Components increasing into the peak (vs. {prev_c}th c. BCE):")
print(f"  Copper/Gold:  {cent3.loc[prev_c,'CG_mean']:.2f} -> {cent3.loc[peak_c,'CG_mean']:.2f} (delta={cg_change:+.2f}) - major increase")
print(f"  MonumentCnt:  {cent3.loc[prev_c,'MC_mean']:.2f} -> {cent3.loc[peak_c,'MC_mean']:.2f} (delta={mc_change:+.2f}) - major increase")
print(f"  Amber:        {cent3.loc[prev_c,'Am_mean']:.2f} -> {cent3.loc[peak_c,'Am_mean']:.2f} (delta={am_change:+.2f}) - marginal")

