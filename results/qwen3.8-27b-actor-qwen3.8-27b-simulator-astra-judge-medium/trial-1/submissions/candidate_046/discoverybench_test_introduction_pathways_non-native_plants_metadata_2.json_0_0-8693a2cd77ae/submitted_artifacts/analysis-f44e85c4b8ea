"""
FINAL ANALYSIS (executed)
Question: How does the prevalence of non-native plants introduced via gardening
vary based on habitat type?

Primary data : data/invaded_niche_pathways.csv  (TSV), 1 row per plot (n=632).
Context data : data/invasion_success_pathways.csv (1 row per species) -> one line only.

Deliverables
  (1) Prevalence per habitat = fraction of plots with n.gard>=1, Wilson 95% CI, n/k explicit.
  (2) Binomial GLM  I(n.gard>0) ~ habitat : odds ratios (95% CI) vs Croplands + global LRT p.
  (3) Complement: mean n.gard per plot; note that sum(n.gard)/sum(n.total) is unstable for small denominators.
  (4) Natural-language, data-grounded hypothesis (gradient direction + non-causal caveat).
"""
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.formula.api import glm
from scipy.stats import chi2

pd.set_option('display.max_columns', None); pd.set_option('display.width', 200)
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv('data/invasion_success_pathways.csv')
df['gard_present'] = (df['n.gard'] > 0).astype(int)
N = len(df)

def wilson(k, n, z=1.959964):
    p = k/n; den = 1 + z*z/n; c = (p + z*z/(2*n))/den
    h = (z*np.sqrt(p*(1-p)/n + z*z/(4*n*n)))/den
    return float(np.clip(c-h, 0, 1)), float(np.clip(c+h, 0, 1))

# ---------- (1) prevalence per habitat ----------
rows = []
for h, g in df.groupby('habitat'):
    n = len(g); k = int(g['gard_present'].sum()); lo, hi = wilson(k, n)
    rows.append(dict(habitat=h, n_plots=n, n_gard_plots=k, prevalence_pct=100*k/n,
                     CI95_lo=100*lo, CI95_hi=100*hi, mean_gard_per_plot=g['n.gard'].mean(),
                     sum_ngard=int(g['n.gard'].sum()), sum_ntotal=int(g['n.total'].sum())))
pv = pd.DataFrame(rows).sort_values('prevalence_pct', ascending=False).reset_index(drop=True)
ov_k = int(df['gard_present'].sum()); ov_lo, ov_hi = wilson(ov_k, N)
print("="*96)
print("(1) TABLE 1 -- GARDENING PREVALENCE BY HABITAT  (main metric = % of plots with n.gard>=1, Wilson 95% CI)")
print("="*96)
print(pv.round(2).to_string(index=False))
print(f"\nOVERALL: n={N}, k={ov_k}  prevalence={100*ov_k/N:.2f}%  (Wilson 95% CI {100*ov_lo:.1f}-{100*ov_hi:.1f}%)")

# ---------- (2) binomial GLM ----------
REF = 'Croplands'
df['hab_cat'] = pd.Categorical(df['habitat'], categories=[c for c in pv['habitat']], ordered=False)
full = glm('gard_present ~ C(hab_cat, Treatment(reference="%s"))' % REF,
           data=df, family=sm.families.Binomial()).fit()
null = glm('gard_present ~ 1', data=df, family=sm.families.Binomial()).fit()
lr = 2*(full.llf - null.llf); dfdiff = int(full.df_model - null.df_model)
p_global = float(chi2.sf(lr, dfdiff))
pseudo_r2 = 1.0 - full.llf/null.llf          # McFadden
ci = full.conf_int()
m = {}
for name in full.params.index:
    if name == 'Intercept': continue
    hname = name.split('T.')[1].rstrip(']'); lo, hi = ci.loc[name]
    m[hname] = (float(np.exp(full.params[name])), float(np.exp(lo)), float(np.exp(hi)), float(full.pvalues[name]))
m[REF] = (1.0, 1.0, 1.0, np.nan)
def fmt_or(v, lo, hi):
    return '~0 (0 events, separated)' if np.isinf(hi) else f"{v:.2f} ({lo:.2f}-{hi:.2f})"
def fmt_p(p):
    return 'ref' if np.isnan(p) else ('<0.001' if p < 0.001 else f"{p:.3f}")
print("\n"+"="*96)
print(f"(2) TABLE 2 -- BINOMIAL GLM  I(n.gard>0) ~ habitat   (reference = {REF})")
print("="*96)
print(f"{'habitat':<22} {'n':>3} {'k':>2}  {'prev%':>7}  {'odds ratio (95% CI) vs Croplands':<28} p")
print("-"*96)
for _, r in pv.iterrows():
    h = r['habitat']; v, lo, hi, p = m[h]
    print(f"{h:<22} {int(r['n_plots']):>3} {int(r['n_gard_plots']):>2}  {r['prevalence_pct']:>6.2f}%  "
          f"{fmt_or(v,lo,hi):<28} {fmt_p(p)}")
print(f"\nGLOBAL TEST (habitat -> gardening presence): LRT chi2={lr:.2f}, df={dfdiff}, p_global={p_global:.3e}  "
      f"(McFadden pseudo-R2={pseudo_r2:.3f})")
print("Significant vs Croplands (p<0.05):",
      ", ".join(h for h in pv['habitat'] if h != REF and m[h][3] < 0.05))

# ---------- (3) complement ----------
pv['prop_gard_of_total_pct'] = 100*pv['sum_ngard']/pv['sum_ntotal'].replace(0, np.nan)
print("\n"+"="*96)
print("(3) TABLE 3 -- COMPLEMENT: mean n.gard per plot (richness)  +  NOTE on sum(n.gard)/sum(n.total)")
print("="*96)
print(pv[['habitat','n_plots','mean_gard_per_plot','sum_ngard','sum_ntotal','prop_gard_of_total_pct']]
      .sort_values('mean_gard_per_plot', ascending=False).round(3).to_string(index=False))
small = pv[pv['sum_ntotal'] <= 8]
print("\nNOTE: sum(n.gard)/sum(n.total) is UNSTABLE where sum(n.total) is tiny (small-sample artifact, NOT high prevalence):")
print(small[['habitat','sum_ngard','sum_ntotal','prop_gard_of_total_pct']].round(1).to_string(index=False))

# ---------- (4) species context (one line) ----------
gp = sp['intro.pathway'].value_counts()
print("\n"+"="*96); print("(SPECIES-LEVEL CONTEXT, one line)"); print("="*96)
print(f"Of {len(sp)} recorded invasive species, {gp['Gardening']} ({100*gp['Gardening']/len(sp):.0f}%) were introduced via "
      f"gardening; gardening species occupy a narrower habitat.range (mean {sp.loc[sp['intro.pathway']=='Gardening','habitat.range'].mean():.1f} of 10) "
      f"than Unintentional (mean {sp.loc[sp['intro.pathway']=='Unintentional','habitat.range'].mean():.1f}).")

# ---------- save artifacts ----------
pv.round(3).to_csv('/workspace/output_prevalence_by_habitat.csv', index=False)
num = pd.DataFrame([{'habitat': r['habitat'], 'n_plots': int(r['n_plots']), 'n_gard_plots': int(r['n_gard_plots']),
                     'prevalence_pct': round(r['prevalence_pct'], 2),
                     'OR': (np.nan if np.isinf(m[r['habitat']][2]) else round(m[r['habitat']][0], 4)),
                     'OR_lo': (np.nan if np.isinf(m[r['habitat']][2]) else round(m[r['habitat']][1], 4)),
                     'OR_hi': (np.nan if np.isinf(m[r['habitat']][2]) else round(m[r['habitat']][2], 4)),
                     'pvalue': (np.nan if np.isnan(m[r['habitat']][3]) else round(m[r['habitat']][3], 4))}
                    for _, r in pv.iterrows()])
num.to_csv('/workspace/output_glm_gardening_by_habitat.csv', index=False)
print("\nSaved: output_prevalence_by_habitat.csv, output_glm_gardening_by_habitat.csv")
