#!/usr/bin/env python3
"""Main analysis: gardening pathway prevalence styles across habitat types.
Workflow: (0) data audit -> (1) small-cell decision -> (2) contingency + pairwise
Fisher -> (3) VIF covariate selection -> (4) 3-step models (presence/abundance/
composition; habitat-only, env-only, habitat+env) -> (5) habitat x covariate
interactions -> (6) species-level trait cross -> (7) phylo mapping check.
"""
import pandas as pd, numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.outliers_influence import variance_inflation_factor
import warnings; warnings.filterwarnings('ignore')

pd.set_option('display.width', 220); pd.set_option('display.max_rows', 200)
OUT = open('analysis_results.txt', 'w')
def p(*a):
    s = ' '.join(str(x) for x in a); print(s); OUT.write(s + '\n')

d = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
inv = pd.read_csv('data/invasion_success_pathways.csv')
dt  = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

p('='*80); p('STEP 0 - DATA AUDIT (repeat of plan stage)'); p('='*80)
p('plots:', d.shape[0], '| cols:', d.shape[1], '| missing:', int(d.isna().sum().sum()))
p('n.total == n.gard+n.unint+n.agfo in all rows:', bool((d['n.total']==d['n.gard']+d['n.unint']+d['n.agfo']).all()))
p('plots with n.total==0:', int((d['n.total']==0).sum()), '| with n.gard>0:', int((d['n.gard']>0).sum()))

p(); p('='*80); p('STEP 1 - SMALL-CELL DECISION (documented)'); p('='*80)
hsum = d.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum().copy()
hsum['n_plots'] = d.groupby('habitat').size()
# DECISION: composition (species-level share) main claim restricted to habitats
# with n.total >= 40 introduced species. Presence/abundance (plot-level) keep all
# 10 habitats (smallest plot N = 29, Coastal). Low-power habitats reported apart
# and tested with exact Fisher tests, flagged as insufficient power.
MAIN = hsum[hsum['n.total']>=40].index.tolist()
LOW  = hsum[hsum['n.total']<40].index.tolist()
p('MAIN habitats (n.total>=40 species):', {h:int(hsum.loc[h,'n.total']) for h in MAIN})
p('LOW-POWER habitats (reported apart):', {h:int(hsum.loc[h,'n.total']) for h in LOW})

p(); p('='*80); p('STEP 2 - COMPOSITION: contingency + pairwise Fisher'); p('='*80)
ct = hsum[['n.gard','n.unint','n.agfo']]
chi2, pchi, dof, _ = stats.chi2_contingency(ct)
p(f'Full 10-habitat x 3-pathway chi2: chi2={chi2:.1f}, dof={dof}, p={pchi:.3e}')
def fisher_pair(a, b):
    ta = hsum.loc[a]; tb = hsum.loc[b]
    tab = np.array([[ta['n.gard'], ta['n.total']-ta['n.gard']],[tb['n.gard'], tb['n.total']-tb['n.gard']]])
    return stats.fisher_exact(tab)[1]
pairs = [(a,b) for i,a in enumerate(MAIN) for b in MAIN[i+1:]]
res = {pr: fisher_pair(*pr) for pr in pairs}
res_corr = {pr: min(1.0, v*len(pairs)) for pr,v in res.items()}
p('Pairwise Fisher (gard vs non-gard share), Bonferroni x%d:' % len(pairs))
for pr, v in sorted(res.items(), key=lambda x: x[1]):
    p(f'  {pr[0]:15s} vs {pr[1]:15s}: p_raw={v:.2e}  p_Bonf={res_corr[pr]:.2e}  {"***" if res_corr[pr]<0.05 else ""}')
p('Low-power habitats (exact Fisher vs each MAIN, NOT part of main claim):')
for h in LOW:
    for m in MAIN:
        pv = fisher_pair(h, m)
        p(f'  {h:18s} vs {m:12s}: p={pv:.3f}  [insufficient power: n.total={int(hsum.loc[h,"n.total"])}]')
p()
p('Gardening share (n.gard/n.total) MAIN habitats:')
for h in MAIN:
    p(f'  {h:12s} {hsum.loc[h,"n.gard"]:3d}/{int(hsum.loc[h,"n.total"]):3d} = {hsum.loc[h,"n.gard"]/hsum.loc[h,"n.total"]:.3f}')

p(); p('='*80); p('STEP 3 - COVARIATE BLOCK & VIF (500 m buffer, 2009)'); p('='*80)
REN = {'urban.2009.500m':'urban_2009_500','cropland.2009.500m':'cropland_2009_500','distance.stream':'dist_stream','distance.road':'dist_road','annual.rainfall':'rainfall'}
d = d.rename(columns=REN)
COVS = ['elevation','urban_2009_500','cropland_2009_500','dist_stream','dist_road','rainfall']
X = sm.add_constant(d[COVS])
vifs = {COVS[i]: variance_inflation_factor(X.values, i+1) for i in range(len(COVS))}
p('VIF:', {k: round(v,2) for k,v in vifs.items()})
keep = [k for k,v in vifs.items() if v < 5]
dropped = [k for k,v in vifs.items() if v >= 5]
p('Kept (VIF<5):', keep, '| Dropped:', dropped)

p(); p('='*80); p('STEP 4 - THREE-STEP MODELS'); p('='*80)
d['presence'] = (d['n.gard']>0).astype(int)
d['ngard'] = d['n.gard']
dc = d[d['n.total']>0].copy()   # composition subset
dc['n_ng'] = dc['n.total'] - dc['n.gard']
dc['ngard'] = dc['n.gard']
# DECISION (documented): composition GLMs restricted to MAIN habitats (n.total>=40
# species) to avoid quasi-separation in constant-share habitats (Broad-leaved 4/4,
# Rock 0/1). Full-10-habitat composition reported via descriptive shares + Fisher.
dc_main = dc[dc['habitat'].isin(MAIN)].copy()

import patsy as _patsy
def fit_and_report(name, formula, data, y, trials=None, family='binom'):
    if trials is not None:
        rhs = formula.split('~', 1)[1]
        X = _patsy.dmatrix(rhs, data=data, return_type='dataframe')
        endog = np.column_stack([data[y].values, data[trials].values])
        m = sm.GLM(endog, X, family=sm.families.Binomial()).fit()
    elif family == 'poisson':
        m = smf.glm(formula, data=data, family=sm.families.Poisson()).fit()
        scale = m.scale
        if scale > 1.5:
            p(f'  [overdispersion scale={scale:.2f}; robust SEs used]')
    else:
        m = smf.glm(formula, data=data, family=sm.families.Binomial()).fit()
    p(f'{name}:')
    p(f'  n={int(m.nobs)}  AIC={m.aic:.1f}  scale={m.scale:.3f}')
    for t, r in m.params.items():
        if t=='Intercept': continue
        p(f'    {t:38s} coef={r:8.3f}  z={m.tvalues[t]:7.2f}  p={m.pvalues[t]:.3e}')
    return m

for outcome, ycol, fam, sub, trials in [
        ('PRESENCE (binomial, all plots)','presence','binom',d,None),
        ('ABUNDANCE (Poisson n.gard, all plots)','ngard','poisson',d,None),
        ('COMPOSITION (binomial n.gard/(n.total), MAIN habitats only, plots w/ species)','ngard','binom',dc_main,'n_ng')]:
    p('-'*70)
    p(f'### {outcome}')
    s1 = fit_and_report('  Step 1 (habitat only)', f'{ycol} ~ C(habitat)', sub, ycol, trials, fam)
    s2 = fit_and_report('  Step 2 (environment only)', f'{ycol} ~ ' + ' + '.join(keep), sub, ycol, trials, fam)
    s3 = fit_and_report('  Step 3 (habitat + environment)', f'{ycol} ~ C(habitat) + ' + ' + '.join(keep), sub, ycol, trials, fam)

p(); p('='*80); p('STEP 5 - HETEROGENEITY: habitat x covariate interactions'); p('='*80)
for cov in ['urban_2009_500','dist_stream','dist_road','elevation']:
    for outcome, ycol, sub, trials in [('presence','presence',d,None),('composition','ngard',dc_main,'n_ng')]:
        if trials is not None:
            def _fit(rhs):
                X = _patsy.dmatrix(rhs, data=sub, return_type='dataframe')
                e = np.column_stack([sub[ycol].values, sub[trials].values])
                return sm.GLM(e, X, family=sm.families.Binomial()).fit()
            m = _fit(f'C(habitat) * {cov}')
            m0 = _fit('C(habitat)')
        else:
            m = smf.glm(f'{ycol} ~ C(habitat) * {cov}', data=sub, family=sm.families.Binomial()).fit()
            m0 = smf.glm(f'{ycol} ~ C(habitat)', data=sub, family=sm.families.Binomial()).fit()
        from scipy.stats import chi2
        ddev = 2*(m.llf - m0.llf)
        dfd = m.df_model - m0.df_model
        pl = chi2.sf(ddev, dfd)
        p(f'{outcome:12s} x {cov:18s}: LRT dev={ddev:.1f}, df={int(dfd)}, p={pl:.3e}')
# also show significant specific interactions for the strongest covariate
p()
p('Significant specific habitat contrasts for presence ~ C(habitat)*urban_2009_500:')
m = smf.glm('presence ~ C(habitat) * urban_2009_500', data=d, family=sm.families.Binomial()).fit()
pv = m.pvalues[m.pvalues.index.str.contains(':urban_')]
for t, v in pv[pv<0.05].items():
    p(f'  {t}: coef={m.params[t]:.3f}, p={v:.3e}')

p(); p('='*80); p('STEP 6 - SPECIES-LEVEL TRAIT CROSS (invasion_success)'); p('='*80)
# dedupe: keep primary row (duplicated=False) per species
prim = inv[~inv['duplicated']].copy()
prim['in_gardening'] = inv.groupby('Scientific_name')['intro.pathway'].apply(lambda s: (s=='Gardening').any()).reindex(prim['Scientific_name']).values
g, o = prim[prim['in_gardening']], prim[~prim['in_gardening']]
p(f'unique species: {len(prim)} | gardening-involved: {len(g)} | others: {len(o)}')
for c in ['mrt','habitat.range','invaded.niche.breadth','native.niche.breadth','number.of.invaded.plots','height']:
    u, pv = stats.mannwhitneyu(g[c], o[c], alternative='two-sided')
    p(f'{c:26s} gard med={g[c].median():7.2f} vs other med={o[c].median():7.2f}  U-test p={pv:.3e}')
p('growth.form (gard):', g['growth.form'].value_counts().to_dict())
p('dispersal (gard):', g['dispersal'].value_counts().to_dict())
p('vegetative (gard):', g['vegetative'].value_counts().to_dict())

p(); p('='*80); p('STEP 7 - PHYLO MAPPING (context only)'); p('='*80)
import re
txt = open('data/phylogenetic_tree.txt').read()
tips = set(t for t in re.findall(r'([A-Za-z][A-Za-z0-9._-]*):\d', txt) if not t.startswith('mrca'))
lab = set(inv['phylo.tip.label'].dropna())
p(f'tree tips={len(tips)} | species labels={len(lab)} | matched={len(tips & lab)} | extra tips={sorted(tips-lab)}')

p(); p('='*80); p('STEP 8 - ENVIRONMENTAL CONTEXT OF GARDENING PRESENCE (by habitat)'); p('='*80)
envs = ['elevation','urban_2009_500','cropland_2009_500','dist_stream','dist_road','rainfall']
prof = d[d['n.gard']>0].groupby('habitat')[envs].mean().round(2)
p(prof.to_string())
p()
p('Univariate logistic screening (presence ~ covariate):')
for c in envs:
    m = smf.logit('presence ~ ' + c, data=d).fit()
    p(f'  {c:18s} coef={m.params[c]:8.4f}  p={m.pvalues[c]:.3e}')

OUT.close()
print('\nSaved analysis_results.txt')
