#!/usr/bin/env python3
"""
Analysis: In what scenario did urban land use promote a specific type of plant invasion?
Data: Non-native plant invasions in Barcelona province, Catalonia.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats
import warnings
warnings.filterwarnings('ignore')

# ============================================================
# LOAD DATA
# ============================================================
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t', quotechar='"')
species = pd.read_csv('data/invasion_success_pathways.csv')
temporal = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t', quotechar='"')

# Rename columns to avoid patsy dot-interpretation
df = df.rename(columns={
    'n.gard': 'n_gard', 'n.unint': 'n_unint', 'n.agfo': 'n_agfo', 'n.total': 'n_total',
    'urban.2009.50m': 'urban_2009_50m', 'urban.1956.50m': 'urban_1956_50m',
    'progressive.1956.2009.50m': 'progressive_1956_2009_50m',
    'distance.road': 'distance_road', 'distance.stream': 'distance_stream'
})

print("=" * 70)
print("ANALYSIS: Urban land use and plant invasion pathways in Barcelona")
print("=" * 70)

# ============================================================
# BLOCK 1: GLM — Urban land use / habitat effect on pathway invasion
# ============================================================
print("\n" + "=" * 70)
print("BLOCK 1: GLM — Urban land use effect on pathway-specific invasion")
print("=" * 70)

# VIF check
df['is_urban'] = (df['habitat'] == 'Urban').astype(int)
corr_urban = np.corrcoef(df['urban_2009_50m'], df['is_urban'])[0, 1]
vif = 1 / (1 - corr_urban**2)
print(f"\nCollinearity check: r(urban_2009_50m, is_urban) = {corr_urban:.3f}, VIF = {vif:.2f}")
print(f"  -> VIF < 5: no need for simplified model, but reporting both for transparency")

# --- Main Poisson GLM for each pathway ---
print(f"\n{'Pathway':10s} | {'urban_2009_50m IRR (95% CI)':35s} | {'p':>10s} | {'Habitat=Urban IRR (95% CI)':35s} | {'p':>10s}")
print("-" * 120)

for pathway in ['n_gard', 'n_unint', 'n_agfo']:
    try:
        model = smf.glm(formula=f'{pathway} ~ urban_2009_50m + C(habitat) + elevation + distance_road',
                        data=df, family=sm.families.Poisson()).fit()
        u_irr = np.exp(model.params['urban_2009_50m'])
        u_ci = model.conf_int().loc['urban_2009_50m']
        u_p = model.pvalues['urban_2009_50m']
        h_irr = np.exp(model.params['C(habitat)[T.Urban]'])
        h_ci = model.conf_int().loc['C(habitat)[T.Urban]']
        h_p = model.pvalues['C(habitat)[T.Urban]']
        print(f"{pathway:10s} | {u_irr:.3f} ({np.exp(u_ci[0]):.3f}–{np.exp(u_ci[1]):.3f}){'':>10s} | {u_p:>10.4f} | {h_irr:.3f} ({np.exp(h_ci[0]):.3f}–{np.exp(h_ci[1]):.3f}){'':>10s} | {h_p:>10.4f}")
    except Exception as e:
        print(f"{pathway:10s} | ERROR: {e}")

# --- Simplified model (no habitat) ---
print(f"\n--- Simplified model (no habitat): pathway ~ urban_2009_50m + elevation + distance_road ---")
for pathway in ['n_gard', 'n_unint', 'n_agfo']:
    try:
        model = smf.glm(formula=f'{pathway} ~ urban_2009_50m + elevation + distance_road',
                        data=df, family=sm.families.Poisson()).fit()
        u_irr = np.exp(model.params['urban_2009_50m'])
        u_ci = model.conf_int().loc['urban_2009_50m']
        u_p = model.pvalues['urban_2009_50m']
        print(f"  {pathway}: IRR = {u_irr:.3f} ({np.exp(u_ci[0]):.3f}–{np.exp(u_ci[1]):.3f}), p = {u_p:.4f}")
    except Exception as e:
        print(f"  {pathway}: ERROR {e}")

# --- Sensitivity: with progressive ---
print(f"\n--- Sensitivity: + progressive_1956_2009_50m (main model) ---")
for pathway in ['n_gard', 'n_unint', 'n_agfo']:
    try:
        model = smf.glm(formula=f'{pathway} ~ urban_2009_50m + C(habitat) + elevation + distance_road + progressive_1956_2009_50m',
                        data=df, family=sm.families.Poisson()).fit()
        u_irr = np.exp(model.params['urban_2009_50m'])
        u_ci = model.conf_int().loc['urban_2009_50m']
        u_p = model.pvalues['urban_2009_50m']
        h_irr = np.exp(model.params['C(habitat)[T.Urban]'])
        h_p = model.pvalues['C(habitat)[T.Urban]']
        print(f"  {pathway}: urban IRR = {u_irr:.3f} (p={u_p:.4f}), Urban habitat IRR = {h_irr:.3f} (p={h_p:.4f})")
    except Exception as e:
        print(f"  {pathway}: ERROR {e}")

# --- Peri-urban: non-Urban plots, logistic for n_unint ---
print(f"\n--- Peri-urban effect (non-Urban plots, n={len(df[df['habitat']!='Urban'])}) ---")
df_nonurban = df[df['habitat'] != 'Urban'].copy()
df_nonurban['unint_present'] = (df_nonurban['n_unint'] > 0).astype(int)
df_nonurban['gard_present'] = (df_nonurban['n_gard'] > 0).astype(int)

for var, label in [('unint_present', 'n_unint>0'), ('gard_present', 'n_gard>0')]:
    try:
        model = smf.glm(formula=f'{var} ~ urban_2009_50m + C(habitat) + elevation + distance_road',
                        data=df_nonurban, family=sm.families.Binomial()).fit()
        u_or = np.exp(model.params['urban_2009_50m'])
        u_ci = model.conf_int().loc['urban_2009_50m']
        u_p = model.pvalues['urban_2009_50m']
        print(f"  P({label}) ~ urban_2009_50m: OR = {u_or:.3f} ({np.exp(u_ci[0]):.3f}–{np.exp(u_ci[1]):.3f}), p = {u_p:.4f}")
    except Exception as e:
        print(f"  {label}: ERROR {e}")

# --- Descriptive: Urban vs non-Urban ---
urban = df[df['habitat'] == 'Urban']
non_urban = df[df['habitat'] != 'Urban']
print(f"\n--- Descriptive: Urban vs non-Urban ---")
print(f"  Urban (n={len(urban)}): mean n_gard={urban['n_gard'].mean():.2f}, % n_gard>0={(urban['n_gard']>0).mean()*100:.1f}%, mean urban_2009_50m={urban['urban_2009_50m'].mean():.3f}")
print(f"  Non-Urban (n={len(non_urban)}): mean n_gard={non_urban['n_gard'].mean():.2f}, % n_gard>0={(non_urban['n_gard']>0).mean()*100:.1f}%, mean urban_2009_50m={non_urban['urban_2009_50m'].mean():.3f}")
print(f"  Urban land use change in Urban habitat: {urban['urban_1956_50m'].mean():.3f} (1956) → {urban['urban_2009_50m'].mean():.3f} (2009)")

# ============================================================
# BLOCK 2: Pathway × Growth form (species-level)
# ============================================================
print("\n" + "=" * 70)
print("BLOCK 2: Pathway × Growth form (species-level, n=81)")
print("=" * 70)

ct = pd.crosstab(species['intro.pathway'], species['growth.form'])
ct = ct.reindex(index=['Gardening', 'Unintentional', 'AgriForest'],
               columns=['Shrub/tree', 'Perennial fg', 'Annual fg'], fill_value=0)
print(f"\n{ct.to_string()}")

# Fisher's exact tests
gard = species[species['intro.pathway'] == 'Gardening']
non_gard = species[species['intro.pathway'] != 'Gardening']

# Shrub/tree
shrub_g = len(gard[gard['growth.form'] == 'Shrub/tree'])
shrub_ng = len(non_gard[non_gard['growth.form'] == 'Shrub/tree'])
or1, p1 = stats.fisher_exact([[shrub_g, len(gard)-shrub_g], [shrub_ng, len(non_gard)-shrub_ng]])
print(f"\nFisher's exact (Shrub/tree, Gardening vs rest): OR = {or1:.2f}, p = {p1:.4f}")

# Annual fg
ann_g = len(gard[gard['growth.form'] == 'Annual fg'])
ann_ng = len(non_gard[non_gard['growth.form'] == 'Annual fg'])
or2, p2 = stats.fisher_exact([[ann_g, len(gard)-ann_g], [ann_ng, len(non_gard)-ann_ng]])
print(f"Fisher's exact (Annual fg, Gardening vs rest): OR = {or2:.2f}, p = {p2:.4f}")

# Vegetative
veg_g = len(gard[gard['vegetative'] == 'Yes'])
veg_ng = len(non_gard[non_gard['vegetative'] == 'Yes'])
or3, p3 = stats.fisher_exact([[veg_g, len(gard)-veg_g], [veg_ng, len(non_gard)-veg_ng]])
print(f"Fisher's exact (Vegetative=Yes, Gardening vs rest): OR = {or3:.2f}, p = {p3:.4f}")

# ============================================================
# BLOCK 3: Temporal trends
# ============================================================
print("\n" + "=" * 70)
print("BLOCK 3: Temporal trends in introduction pathways")
print("=" * 70)

temp_wide = temporal.pivot(index='introduction.period', columns='pathway', values='n')
temp_wide = temp_wide.reindex(index=['Before 1500', '1501-1900', '1901-1984', '1985-2019'])
temp_wide['Total'] = temp_wide.sum(axis=1)
temp_wide['Gardening %'] = (temp_wide['Gardening'] / temp_wide['Total'] * 100).round(1)
print(f"\n{temp_wide.to_string()}")

contingency = temp_wide[['AgriForest', 'Gardening', 'Unintentional']].values
chi2, p_chi, dof, expected = stats.chi2_contingency(contingency)
print(f"\nChi-square test of independence: χ² = {chi2:.1f}, df = {dof}, p = {p_chi:.2e}")

# ============================================================
# BLOCK 4 (brief): Phylogenetic note
# ============================================================
print("\n" + "=" * 70)
print("BLOCK 4 (brief): Phylogenetic context")
print("=" * 70)

gard_fam = gard['family'].value_counts()
print(f"\nGardening pathway: {len(gard)} species, {gard['family'].nunique()} families")
print(f"Top families: {gard_fam.head(5).to_dict()}")
print(f"Note: Gardening species span 30/33 families → no strong phylogenetic clustering at family level.")
print(f"Full Pagel's λ test omitted (requires tree parsing; not critical for hypothesis).")

# ============================================================
# FINAL HYPOTHESIS
# ============================================================
print("\n" + "=" * 70)
print("FINAL HYPOTHESIS")
print("=" * 70)

hypothesis = (
    "In urban habitats in the Barcelona province, urban land use promoted invasion via the "
    "Gardening pathway—i.e., the establishment of ornamental woody (shrub/tree) and perennial "
    "herbaceous plants that escaped from gardens. Urban habitat plots had a 5.9-fold higher rate "
    "of Gardening-pathway species (IRR = 5.94, 95% CI: 1.97–17.90, p = 0.0015; n = 632 plots, "
    "65 urban, 567 non-urban) compared to other habitats. Gardening-pathway species were "
    "disproportionately woody (47.6% shrub/tree) and perennial (42.9%) relative to other pathways "
    "(Fisher's exact OR = 4.16 for shrub/tree, p = 0.005; OR = 0.10 for annual, p = 0.0001), "
    "consistent with the ornamental-plant escape mechanism. This pattern coincides with the "
    "dramatic rise in Gardening-pathway introductions since 1985 (75.2% of all introductions in "
    "1985–2019 vs. 16.8% before 1500; χ² = 230.4, df = 6, p < 10⁻⁴⁷), reflecting the expansion "
    "of urban land use in the region. In peri-urban areas (non-urban plots with urban land use in "
    "the 50 m buffer), urban land use also significantly increased the probability of "
    "Unintentional-pathway invasion (OR = 7.88, 95% CI: 1.30–47.86, p = 0.025), suggesting that "
    "urbanization facilitates both ornamental escape and accidental introduction of non-native plants."
)
print(f"\n{hypothesis}")

print("\n" + "=" * 70)
print("WORKFLOW SUMMARY")
print("=" * 70)
workflow = (
    "1) Poisson GLM of pathway-specific species counts (n.gard, n.unint, n.agfo) on urban land "
    "cover (50 m buffer, 2009), habitat, elevation, and distance to road (n = 632 plots); "
    "simplified and sensitivity models (± progressive change, ± habitat) for robustness. "
    "2) Fisher's exact tests on pathway × growth form (n = 81 species). "
    "3) Chi-square test on 4×3 temporal contingency table of introduction pathways. "
    "4) Peri-urban logistic regression on non-urban plots (n = 567)."
)
print(f"\n{workflow}")

