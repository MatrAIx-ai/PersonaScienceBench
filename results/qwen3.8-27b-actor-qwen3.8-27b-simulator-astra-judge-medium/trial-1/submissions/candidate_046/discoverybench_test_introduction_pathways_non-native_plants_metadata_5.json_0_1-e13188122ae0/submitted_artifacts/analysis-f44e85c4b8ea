import pandas as pd, numpy as np, patsy
import statsmodels.formula.api as smf
from statsmodels.genmod.families import Poisson
from scipy.special import gammaln, xlogy, psi
from scipy.optimize import minimize
from scipy.stats import norm
import warnings; warnings.filterwarnings('ignore')
pd.set_option('display.width', 200)

df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df['urban_change_500'] = df['urban.2009.500m'] - df['urban.1956.500m']

rows = []
for p, col in [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo')]:
    d = df.copy(); d['pathway'] = p; d['n'] = d[col]; rows.append(d)
long = pd.concat(rows, ignore_index=True)
long['plot_id'] = np.repeat(np.arange(len(df)), 3)
long['is_gard']  = (long.pathway=='Gardening').astype(int)
long['is_unint'] = (long.pathway=='Unintentional').astype(int)
print("Long format:", long.shape, "| rows with n>0:", int((long.n>0).sum()))

CTRL = 'C(habitat) + elevation + Q("distance.road") + Q("distance.stream") + Q("cropland.2009.500m")'
def F_per_path(urb):
    u = f'Q("{urb}")'
    return f'n ~ is_gard + is_unint + {u} + {u}:is_gard + {u}:is_unint + {CTRL}'

def slope_table(m, U, label, cov=None):
    UN = f'Q("{U}")'
    c = m.conf_int()
    print(f"\n--- {label} ---")
    for p, k in [('AgriForest', UN), ('Gardening', f'Q("{U}"):is_gard'), ('Unintentional', f'Q("{U}"):is_unint')]:
        if p == 'AgriForest':
            b, lo, hi, pv = m.params[k], c.loc[k,0], c.loc[k,1], m.pvalues[k]
        else:
            b = m.params[UN] + m.params[k]
            se = np.sqrt(m.cov_params().loc[UN,UN] + m.cov_params().loc[k,k] + 2*m.cov_params().loc[UN,k])
            lo, hi = b - 1.96*se, b + 1.96*se
            pv = 2*norm.sf(abs(b/se))
        print(f"  {p:14s}: slope={b:+.3f}  95%CI [{lo:+.3f},{hi:+.3f}]  p={pv:.4g}  OR(+0.1 urban)={np.exp(b*0.1):.3f} [{np.exp(lo*0.1):.3f},{np.exp(hi*0.1):.3f}]")
    for p, k in [('Gardening', f'Q("{U}"):is_gard'), ('Unintentional', f'Q("{U}"):is_unint')]:
        print(f"  diff {p} vs AgriForest: {m.params[k]:+.3f}  95%CI [{c.loc[k,0]:+.3f},{c.loc[k,1]:+.3f}]  p={m.pvalues[k]:.4g}")

U = 'urban.2009.500m'
F = F_per_path(U)
y, X = patsy.dmatrices(F, data=long, return_type='dataframe')
yv = y.values.ravel().astype(float); Xv = X.values.astype(float)

# ---------- M1 MAIN: Poisson GLM, cluster-robust by plot ----------
m1 = smf.glm(F, data=long, family=Poisson()).fit(cov_type='cluster', cov_kwds={'groups': long['plot_id'].values})
slope_table(m1, U, "M1 MAIN: Poisson GLM (long; SE cluster-robust by plot); urban.2009.500m")

# ---------- M2: Negative Binomial (manual MLE, profiled + BFGS) ----------
def nb_ll(theta):
    beta, lnp = theta[:-1], theta[-1]
    p = np.exp(lnp); mu = np.exp(Xv @ beta)
    return (gammaln(yv+p) - gammaln(p) - gammaln(yv+1) + p*np.log(p/(p+mu)) + xlogy(yv, mu/(p+mu))).sum()
def nb_grad(theta):
    beta, lnp = theta[:-1], theta[-1]
    p = np.exp(lnp); mu = np.exp(Xv @ beta)
    g_beta = Xv.T @ (p*(yv-mu)/(p+mu))
    g_lnp = (p*(np.log(p/(p+mu)) - (p+yv)/(p+mu) + psi(yv+p) - psi(p))).sum()
    return np.append(g_beta, g_lnp)
def nb_fit_beta(p, b0):
    r = minimize(lambda b: -nb_ll(np.append(b, np.log(p))), b0, method='Nelder-Mead',
                 options={'maxiter': 30000, 'xatol':1e-7, 'fatol':1e-7})
    return r.x, -r.fun
b0 = m1.params.values
best = None
for p in [0.5, 0.8, 1.0, 1.5, 2.0, 3.0, 5.0, 10.0, 50.0, 1e6]:
    b, l_ = nb_fit_beta(p, b0)
    if best is None or l_ > best[1]: best = (p, l_, b)
pstar, llf_nb, bn = best
res = minimize(lambda t: -nb_ll(t), np.append(bn, np.log(pstar)), jac=lambda t: -nb_grad(t),
               method='BFGS', options={'maxiter': 800, 'gtol': 1e-9})
beta_nb, lnp_nb = res.x[:-1], res.x[-1]
H = np.zeros((len(res.x), len(res.x)))
for i in range(len(res.x)):
    e = np.zeros_like(res.x); e[i] = 1e-5
    H[i] = (nb_grad(res.x+e) - nb_grad(res.x-e)) / 2e-5
Vnb = np.linalg.pinv(-H)
names = list(X.columns); idx = {n:i for i,n in enumerate(names)}
UN = f'Q("{U}")'
print(f"\n--- M2: Negative Binomial (manual MLE; size p*={np.exp(lnp_nb):.2f}; llf={-res.fun:.1f} vs Poisson {m1.llf:.1f}; AIC {2*len(res.x)+2*res.fun:.0f} vs {2*len(m1.params)-2*m1.llf:.0f}) ---")
for lab, i, j in [('AgriForest', idx[UN], None), ('Gardening', idx[UN], idx[f'Q("{U}"):is_gard']), ('Unintentional', idx[UN], idx[f'Q("{U}"):is_unint'])]:
    if j is None: b, se_b = beta_nb[i], np.sqrt(np.clip(Vnb[i,i],0,None))
    else:
        b = beta_nb[i] + beta_nb[j]; se_b = np.sqrt(np.clip(Vnb[i,i]+Vnb[j,j]+2*Vnb[i,j],0,None))
    print(f"  {lab:14s}: slope={b:+.3f}  95%CI [{b-1.96*se_b:+.3f},{b+1.96*se_b:+.3f}]  p={2*norm.sf(abs(b/se_b)):.4g}  OR(+0.1)={np.exp(b*0.1):.3f}")

# ---------- M3: Separate Poisson GLMs per pathway ----------
print("\n--- M3: Separate Poisson GLMs per pathway (urban.2009.500m + controls) ---")
for p, col in [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo')]:
    d = df.copy(); d['n'] = d[col]
    m = smf.glm(f'n ~ Q("{U}") + {CTRL}', data=d, family=Poisson()).fit()
    kk = f'Q("{U}")'
    lo, hi = m.conf_int().loc[kk]
    print(f"  {p:14s}: slope={m.params[kk]:+.3f}  95%CI [{lo:+.3f},{hi:+.3f}]  p={m.pvalues[kk]:.4g}  OR(+0.1)={np.exp(m.params[kk]*0.1):.3f} | plots n>0: {(d.n>0).sum()}/{len(d)}")

# ---------- M4: ZIP ----------
from statsmodels.discrete.count_model import ZeroInflatedPoisson
mz = ZeroInflatedPoisson(yv, Xv).fit(maxiter=500)
ncol = len(names)
zp = pd.Series(mz.params[:ncol], index=names); zb = pd.Series(mz.bse[:ncol], index=names)
zv = pd.Series(mz.pvalues[:ncol], index=names); zc = pd.DataFrame(mz.cov_params()[:ncol,:ncol], index=names, columns=names)
print(f"  (ZIP: count part = first {ncol} params; last = zero-inflation intercept {mz.params[-1]:+.3f})")
print(f"  ZIP llf={mz.llf:.2f}  AIC={2*(len(mz.params))+2*mz.llf if False else 2*len(mz.params)-2*mz.llf:.1f}   (Poisson llf={m1.llf:.2f} AIC={2*len(m1.params)-2*m1.llf:.1f}; NB llf={-res.fun:.2f} AIC={2*len(res.x)+2*res.fun:.1f})")
# ZIP with full in-formula (all covariates in zero-inflation part too)
mz2 = ZeroInflatedPoisson(yv, Xv, in_formula=list(range(ncol))).fit(maxiter=800)
zp2 = pd.Series(mz2.params[:ncol], index=names); zb2 = pd.Series(mz2.bse[:ncol], index=names)
zc2 = pd.DataFrame(mz2.cov_params()[:ncol,:ncol], index=names, columns=names)
print("  ZIP (full in-formula) llf=", round(mz2.llf,2), " AIC=", round(2*len(mz2.params)-2*mz2.llf,1))
for lab, i, j in [('AgriForest', UN, None), ('Gardening', UN, f'Q("{U}"):is_gard'), ('Unintentional', UN, f'Q("{U}"):is_unint')]:
    if j is None:
        b, se_b = zp2[i], zb2[i]
    else:
        b = zp2[i] + zp2[j]; se_b = np.sqrt(zc2.loc[i,i] + zc2.loc[j,j] + 2*zc2.loc[i,j])
    pv = 2*norm.sf(abs(b/se_b))
    print(f"    {lab:14s}: slope={b:+.3f}  95%CI [{b-1.96*se_b:+.3f},{b+1.96*se_b:+.3f}]  p={pv:.4g}  OR(+0.1)={np.exp(b*0.1):.3f}")
print("\n--- M4: Zero-Inflated Poisson (long; count-part slopes) ---")
for lab, i, j in [('AgriForest', UN, None), ('Gardening', UN, f'Q("{U}"):is_gard'), ('Unintentional', UN, f'Q("{U}"):is_unint')]:
    if j is None:
        b, se_b, pv = zp[i], zb[i], zv[i]
    else:
        b = zp[i] + zp[j]; se_b = np.sqrt(zc.loc[i,i] + zc.loc[j,j] + 2*zc.loc[i,j])
        pv = 2*norm.sf(abs(b/se_b))
    print(f"  {lab:14s}: slope={b:+.3f}  95%CI [{b-1.96*se_b:+.3f},{b+1.96*se_b:+.3f}]  p={pv:.4g}  OR(+0.1)={np.exp(b*0.1):.3f}")

# ---------- M5: Hurdle ----------
long['pos'] = (long.n > 0).astype(int)
Fh = F.replace('n ~','pos ~')
mh1 = smf.logit(Fh, data=long).fit()
print("\n--- M5a: Hurdle part 1: logistic P(n>0) ---")
c = mh1.conf_int(); UN = f'Q("{U}")'
for p, k in [('AgriForest', UN), ('Gardening', f'Q("{U}"):is_gard'), ('Unintentional', f'Q("{U}"):is_unint')]:
    if p == 'AgriForest':
        b, lo, hi, pv = mh1.params[k], c.loc[k,0], c.loc[k,1], mh1.pvalues[k]
    else:
        b = mh1.params[UN] + mh1.params[k]; pv = mh1.pvalues[k]
        se = np.sqrt(mh1.cov_params().loc[UN,UN] + mh1.cov_params().loc[k,k] + 2*mh1.cov_params().loc[UN,k])
        lo, hi = b-1.96*se, b+1.96*se
    pv = mh1.pvalues[k] if p=='AgriForest' else 2*norm.sf(abs(b/se))
    print(f"  {p:14s}: log-odds slope={b:+.3f}  OR(+0.1)={np.exp(b*0.1):.3f}  95%CI [{lo:+.3f},{hi:+.3f}]  p={pv:.4g}")
pos = long[long.n > 0].copy()
mh2 = smf.glm(F, data=pos, family=Poisson()).fit()
slope_table(mh2, U, f"M5b: Hurdle part 2: Poisson on positives (n={len(pos)} rows)")

# ---------- Descriptives ----------
print("\n--- Descriptive: mean pathway counts by urban.2009.500m tertile ---")
df['urb_t'] = pd.qcut(df[U], 3, labels=['low','mid','high'])
for p, col in [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo')]:
    g = df.groupby('urb_t')[col].agg(['mean','count'])
    print(f"  {p:14s}: " + ", ".join(f"{ix}={row['mean']:.3f} (n={int(row['count'])})" for ix,row in g.iterrows()))
inv = df[df['n.total']>0]
print(f"  pathway share of invaded species-plot records (invaded plots, n={len(inv)}):")
print(f"   Gardening={inv['n.gard'].sum()/inv['n.total'].sum():.3f}  Unintentional={inv['n.unint'].sum()/inv['n.total'].sum():.3f}  AgriForest={inv['n.agfo'].sum()/inv['n.total'].sum():.3f}")
print(f"  mean {U}: all plots={df[U].mean():.3f}; invaded plots={inv[U].mean():.3f}")
