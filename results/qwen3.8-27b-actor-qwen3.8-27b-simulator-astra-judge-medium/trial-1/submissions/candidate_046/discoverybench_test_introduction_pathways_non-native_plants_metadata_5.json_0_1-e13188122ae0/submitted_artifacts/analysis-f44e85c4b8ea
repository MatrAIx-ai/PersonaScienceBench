# ================= SENSITIVITIES =================
def sens_fit(data, urb, with_habitat=True, label=""):
    ctrl = (CTRL if with_habitat else 'elevation + Q("distance.road") + Q("distance.stream") + Q("cropland.2009.500m")')
    f = F_per_path(urb).replace(' + ' + CTRL, ' + ' + ctrl)
    m = smf.glm(f, data=data, family=Poisson()).fit(cov_type='cluster', cov_kwds={'groups': data['plot_id'].values})
    UN = f'Q("{urb}")'
    c = m.conf_int()
    out = []
    for p, k in [('AgriForest', UN), ('Gardening', f'Q("{urb}"):is_gard'), ('Unintentional', f'Q("{urb}"):is_unint')]:
        if p == 'AgriForest':
            b, se_b = m.params[k], m.bse[k]
        else:
            b = m.params[UN] + m.params[k]
            se_b = np.sqrt(m.cov_params().loc[UN,UN] + m.cov_params().loc[k,k] + 2*m.cov_params().loc[UN,k])
        pv = 2*norm.sf(abs(b/se_b))
        sig = '*' if pv < 0.05 else ''
        out.append(f"{p[0]}: {b:+.2f} [{b-1.96*se_b:+.2f},{b+1.96*se_b:+.2f}] p={pv:.3f}{sig}")
    print(f"  {label:34s} | " + " | ".join(out))

print("\n================ SENSITIVITIES (Poisson GLM long, cluster-robust) ================")
print("\nS1: alternative urban variables (all 632 plots, full controls):")
for urb, lab in [('urban.2009.50m','urban 2009 @50m'), ('urban.2009.1000m','urban 2009 @1000m'),
                 ('urban.1993.500m','urban 1993 @500m'), ('urban.1956.500m','urban 1956 @500m'),
                 ('urban_change_500','urban change 1956->2009 @500m')]:
    sens_fit(long, urb, True, lab)

print("\nS2: subset with n.total>0 (invaded plots only, n=191):")
sub = long[long['n.total'].values > 0 if 'n.total' in long else np.repeat(df['n.total'].values,3) > 0].copy()
sens_fit(sub, U, True, "n.total>0 subset")

print("\nS3: excluding Urban habitat (n=567):")
noU = long[long.habitat != 'Urban'].copy()
sens_fit(noU, U, True, "no Urban habitat")

print("\nS4: no habitat control (confounding check):")
sens_fit(long, U, False, "without C(habitat)")

print("\nS5: no controls at all (raw association):")
f5 = f'n ~ is_gard + is_unint + Q("{U}") + Q("{U}"):is_gard + Q("{U}"):is_unint'
m5 = smf.glm(f5, data=long, family=Poisson()).fit(cov_type='cluster', cov_kwds={'groups': long['plot_id'].values})
c5 = m5.conf_int(); UN5 = f'Q("{U}")'
for p, k in [('AgriForest', UN5), ('Gardening', f'Q("{U}"):is_gard'), ('Unintentional', f'Q("{U}"):is_unint')]:
