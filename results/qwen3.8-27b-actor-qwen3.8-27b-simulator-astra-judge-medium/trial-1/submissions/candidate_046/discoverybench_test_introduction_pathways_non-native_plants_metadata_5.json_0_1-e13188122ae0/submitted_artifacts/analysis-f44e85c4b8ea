        se_b = np.sqrt(m5.cov_params().loc[UN5,UN5] + m5.cov_params().loc[k,k] + 2*m5.cov_params().loc[UN5,k])
    pv = 2*norm.sf(abs(b/se_b))
    print(f"  {p:14s}: slope={b:+.3f}  95%CI [{b-1.96*se_b:+.3f},{b+1.96*se_b:+.3f}]  p={pv:.4g}  OR(+0.1)={np.exp(b*0.1):.3f}")
