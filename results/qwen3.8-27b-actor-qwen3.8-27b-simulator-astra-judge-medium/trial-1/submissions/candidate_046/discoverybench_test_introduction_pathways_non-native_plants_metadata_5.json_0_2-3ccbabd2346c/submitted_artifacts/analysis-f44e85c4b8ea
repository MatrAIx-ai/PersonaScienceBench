              f' | chg IRR/0.1={r.loc[f"urb_chg_{s}", "IRR0.1"]:.2f} '
              f"[{r.loc[f'urb_chg_{s}','IRR0.1_lo']:.2f}-{r.loc[f'urb_chg_{s}','IRR0.1_hi']:.2f}] p={r.loc[f'urb_chg_{s}','p']:.3f}")

print('\n' + '=' * 100)
