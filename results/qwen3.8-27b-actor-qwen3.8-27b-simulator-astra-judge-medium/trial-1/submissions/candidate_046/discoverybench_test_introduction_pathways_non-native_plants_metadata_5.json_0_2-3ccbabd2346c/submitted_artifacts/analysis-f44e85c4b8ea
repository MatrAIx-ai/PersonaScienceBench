print('\n[PART D done]')

print('=' * 100)
print('13) PHYLOGENETIC SIGNAL of invasion success (number_of_invaded_plots)')
print('=' * 100)
def parse_newick(s):
    i = [0]
    n = len(s)
    def parse_node():
        node = {'label': None, 'length': None, 'children': []}
        if i[0] < n and s[i[0]] == '(':
            i[0] += 1
            while True:
                node['children'].append(parse_node())
                if s[i[0]] == ',':
                    i[0] += 1
                    continue
                i[0] += 1  # skip ')'
                break
        start = i[0]
        while i[0] < n and s[i[0]] not in ':,();':
            i[0] += 1
        node['label'] = s[start:i[0]]
        if i[0] < n and s[i[0]] == ':':
            i[0] += 1
            start = i[0]
            while i[0] < n and s[i[0]] not in ',();':
                i[0] += 1
            node['length'] = float(s[start:i[0]])
        return node
    root = parse_node()
    return root

tree_s = open('data/phylogenetic_tree.txt').read().strip()
root = parse_newick(tree_s)
# collect tips and branch-length vectors
edge_col = {}
def number(node):
    edge_col[id(node)] = len(edge_col)
    for c in node['children']:
        number(c)
number(root)
P = len(edge_col)
tips, rows = [], []
def walk(node, acc):
    acc = acc.copy()
    acc[edge_col[id(node)]] = node['length'] if node['length'] is not None else 0.0
    if not node['children']:
        tips.append(node['label'])
        rows.append(acc)
    else:
        for c in node['children']:
            walk(c, acc)
walk(root, np.zeros(P))
tips_arr = np.array(tips)
B = np.array(rows, dtype=float)
C = B @ B.T
sp_order = sp.set_index('phylo_tip_label').loc[tips_arr, 'number_of_invaded_plots'].values
x = sp_order.astype(float)
print(f'tips={len(tips)}, C trace={C.trace():.1f}')

V0 = x.var(ddof=1)
Ic = np.eye(len(x))
def negloglik(log_s2):
    s2 = np.exp(log_s2)
    M = C + s2 * Ic
    from scipy.linalg import solve, cholesky
    try:
        L = cholesky(M, lower=True)
        sol = solve(M, x)
        ll = -0.5 * (len(x) * np.log(2 * np.pi) + 2 * np.log(np.diag(L)).sum() + x @ sol)
        return -ll
    except Exception:
        return 1e100
res = minimize_scalar(negloglik, bounds=(-10, 10), method='bounded')
s2 = np.exp(res.x)
xhat = C @ np.linalg.solve(C + s2 * Ic, x)

def K_stat(x, xhat):
    V0 = x.var(ddof=1)
    V1_resid = (x - xhat).var(ddof=1)
    V1_hat = xhat.var(ddof=1)
    return (V0 - V1_resid) / V0, (V0 - V1_hat) / V0, V0, V1_resid, V1_hat

# simulation validation: BM traits should give K ~ 1
def bm_sim():
    z = rng.standard_normal(B.shape[1])
    return B @ z
Ks_resid, Ks_hat = [], []
for _ in range(200):
    xs = bm_sim()
    def nll(log_s2, xs=xs):
        s2 = np.exp(log_s2)
        M = C + s2 * Ic
        from scipy.linalg import solve, cholesky
        try:
            L = cholesky(M, lower=True)
            sol = solve(M, xs)
            return 0.5 * (len(xs) * np.log(2 * np.pi) + 2 * np.log(np.diag(L)).sum() + xs @ sol)
        except Exception:
            return 1e100
    r = minimize_scalar(nll, bounds=(-10, 10), method='bounded')
    s2s = np.exp(r.x)
    xhs = C @ np.linalg.solve(C + s2s * Ic, xs)
    a, b, *_ = K_stat(xs, xhs)
    Ks_resid.append(a); Ks_hat.append(b)
print(f'BM simulation (n=200): mean K residual-formula={np.mean(Ks_resid):.3f}, mean K hat-formula={np.mean(Ks_hat):.3f} (target ~1)')
kr, kh, V0, V1r, V1h = K_stat(x, xhat)
print(f'Observed: K (residual form)={kr:.3f}, K (hat form)={kh:.3f}; V0={V0:.3f}, V1_resid={V1r:.3f}, V1_hat={V1h:.3f}, sigma2={s2:.3f}')

# phylogenetic Moran's I (Morris et al.)
xm = x - x.mean()
num = 0.0
den = 0.0
Cj = C.copy()
np.fill_diagonal(Cj, 0.0)
num = (xm[:, None] * Cj * xm[None, :]).sum() / 2
den = 0.5 * Cj.sum() * V0
print(f"phylogenetic Moran's I = {num/den:.3f} (0 = no signal, >0 positive phylogenetic structure)")

# per-pathway mean invasion success is captured in sec.11; also K for Gardening-only trait not possible (subset pruning skipped)
print('\n[PART E done]')
