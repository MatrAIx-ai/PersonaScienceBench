                          int(df.loc[df.habitat != 'Urban', 'n_gard'].sum()),
                          int(df.loc[df.habitat != 'Urban', 'n_unint'].sum())]})
tab2 = occ.pivot(index='site', columns='pathway', values='n')
from scipy.stats import chi2_contingency
chi2, pchi, dof, _ = chi2_contingency(tab2)
print(tab2.to_string())
print(f'chi2={chi2:.2f}, df={dof}, p={pchi:.5f}')
print('share Gardening: Urban %.1f%% vs non-Urban %.1f%%' %
      (tab2.loc['Urban', 'Gardening'] / tab2.loc['Urban'].sum() * 100,
       tab2.loc['non-Urban', 'Gardening'] / tab2.loc['non-Urban'].sum() * 100))

print('=' * 100)
print('11) SPECIES-LEVEL CHARACTERIZATION BY PATHWAY (81 species x pathway rows)')
print('=' * 100)
print('\ngrowth.form composition per pathway (n=81 rows):')
print(pd.crosstab(sp['intro_pathway'], sp['growth_form'], margins=True).to_string())
print('\nshare of growth form within pathway (%):')
print((pd.crosstab(sp['intro_pathway'], sp['growth_form'], normalize='index') * 100).round(1).to_string())
print('\nTop 5 families per pathway:')
for pw in ['Gardening', 'Unintentional', 'AgriForest']:
