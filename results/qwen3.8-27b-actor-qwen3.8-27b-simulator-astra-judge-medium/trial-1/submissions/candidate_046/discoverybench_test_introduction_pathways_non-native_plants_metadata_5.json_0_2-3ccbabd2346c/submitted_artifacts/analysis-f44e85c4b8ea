    gc = ts.loc[f'C(pathway, Treatment(reference="Unintentional"))[T.{pw}]:urb_chg_500m', 'coef']
    pl = ts.loc[f'C(pathway, Treatment(reference="Unintentional"))[T.{pw}]:urb_lvl_500m', 'p']
    pc = ts.loc[f'C(pathway, Treatment(reference="Unintentional"))[T.{pw}]:urb_chg_500m', 'p']
    print(f'{pw} vs Unint: interaction lvl IRR/0.1={np.exp(gl*0.1):.3f} (p={pl:.4f}) -> total lvl IRR/0.1={np.exp((base_lvl+gl)*0.1):.3f}'
          f' | interaction chg IRR/0.1={np.exp(gc*0.1):.3f} (p={pc:.4f}) -> total chg IRR/0.1={np.exp((base_chg+gc)*0.1):.3f}')

print('=' * 100)
print('6) OVERDISPERSION CHECK (justifies NB) + ZIP note')
print('=' * 100)
