    qp = fit_qp(df[resp], X500)
    dfree = len(df) - X500.shape[1]
    print(f'  {resp}: Poisson pearson_chi2/df = {qp.pearson_chi2/dfree:.2f} (NB alpha fitted in sec.1)')
print('  Note: ZeroInflatedPoisson fits were attempted as sensitivity but the zero-part is')
