    sig = {k: round(v, 3) for k, v in t.loc[CTRL, 'p'].items() if v < 0.1}
    print('  significant controls (p<0.1):', sig)
    tq = coef_table(fit_qp(df[resp], X500))
    print('  quasi-Poisson check:', {k: (round(tq.loc[k, 'IRR0.1'], 3), round(tq.loc[k, 'p'], 3))
          for k in ['urb_lvl_500m', 'urb_chg_500m']})
print('\n[PART A done]')

print('=' * 100)
print('2) ROBUSTNESS - same model at 50 m and 1000 m (NB, IRR per 0.1)')
print('=' * 100)
