#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Main analysis (approved plan):
"How did urban land use affect the invasion of different types of introduced plants?"
Data: data/invaded_niche_pathways.csv (plot-level, n=632, TAB),
      data/invasion_success_pathways.csv (species x pathway, n=81),
      data/temporal_trends_contingency_table.csv, data/phylogenetic_tree.txt
Design:
  Response: n.gard / n.unint / n.agfo (plot counts by pathway) + n.total
  Urban (primary 500 m): urb_lvl = urban.2009.500m ; urb_chg = urban.2009.500m - urban.1956.500m
  Controls: elevation, annual.temperature, annual.rainfall, annual.radiation,
            distance.road, distance.stream, cropland.2009.500m (z-scored),
            habitat fixed effect (ref = Scrublands)
  Models: NB GLM (outer alpha search) primary; quasi-Poisson check; ZIP sensitivity;
          stacked interaction model (plot-clustered SE) for pathway contrasts;
          robustness 50/1000 m, excl. Urban habitat, no-habitat model, VIF, Moran's I.
  Descriptive: growth.form / family / mrt / invasion success per pathway (81 rows).
  Context: temporal contingency table; phylogenetic signal of invasion success.
"""
import warnings
warnings.filterwarnings('ignore')
import numpy as np
import pandas as pd
import patsy
import statsmodels.api as sm
from statsmodels.genmod.families import NegativeBinomial, Poisson
from scipy.stats import norm
from scipy.optimize import minimize_scalar
from scipy.linalg import cholesky, solve
from scipy.spatial import cKDTree

pd.set_option('display.width', 250)
rng = np.random.default_rng(42)

df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv('data/invasion_success_pathways.csv')
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
df.columns = [c.replace('.', '_') for c in df.columns]
sp.columns = [c.replace('.', '_') for c in sp.columns]
tt.columns = [c.replace('.', '_') for c in tt.columns]

for s in ['50m', '500m', '1000m']:
    df[f'urb_lvl_{s}'] = df[f'urban_2009_{s}']
    df[f'urb_chg_{s}'] = df[f'urban_2009_{s}'] - df[f'urban_1956_{s}']

CTRL = ['elevation', 'annual_temperature', 'annual_rainfall', 'annual_radiation',
        'distance_road', 'distance_stream', 'cropland_2009_500m']
df = df.assign(**{c: (df[c] - df[c].mean()) / df[c].std(ddof=0) for c in CTRL})

def base_formula(scale='500m', with_habitat=True):
    f = f'urb_lvl_{scale} + urb_chg_{scale} + ' + ' + '.join(CTRL)
    if with_habitat:
        f += ' + C(habitat, Treatment(reference="Scrublands"))'
    return f

def design_matrix(formula, data=None):
    data = df if data is None else data
    return patsy.dmatrix(formula, data, return_type='dataframe', NA_action='raise')

def fit_nb(y, X):
    best = None
    for a in np.geomspace(1e-3, 1e3, 50):
        try:
            m = sm.GLM(y, X, family=NegativeBinomial(alpha=a)).fit(maxiter=500, tol=1e-9)
            ll = m.llf
            if np.isfinite(ll) and (best is None or ll > best[1]):
                best = (a, ll, m)
        except Exception:
            pass
    a0, ll0, m0 = best
    for a in np.geomspace(a0 / 5, a0 * 5, 25):
        try:
            m = sm.GLM(y, X, family=NegativeBinomial(alpha=a)).fit(maxiter=500, tol=1e-9)
            if np.isfinite(m.llf) and m.llf > ll0:
                a0, ll0, m0 = a, m.llf, m
        except Exception:
            pass
    return m0, a0

def fit_qp(y, X):
    return sm.GLM(y, X, family=Poisson()).fit(maxiter=500)

def coef_table(m, irr_per=0.1):
    p = m.params
    ci = m.conf_int()
    return pd.DataFrame({'coef': p, 'se': m.bse, 'p': m.pvalues,
                         'IRR0.1': np.exp(p * irr_per),
                         'IRR0.1_lo': np.exp(ci[0] * irr_per), 'IRR0.1_hi': np.exp(ci[1] * irr_per)})

def show_urb(t):
    r = t.loc[['urb_lvl_500m', 'urb_chg_500m']]
    return (f"lvl IRR/0.1={r.loc['urb_lvl_500m','IRR0.1']:.2f} "
            f"[{r.loc['urb_lvl_500m','IRR0.1_lo']:.2f}-{r.loc['urb_lvl_500m','IRR0.1_hi']:.2f}] "
            f"p={r.loc['urb_lvl_500m','p']:.3f} | chg IRR/0.1={r.loc['urb_chg_500m','IRR0.1']:.2f} "
            f"[{r.loc['urb_chg_500m','IRR0.1_lo']:.2f}-{r.loc['urb_chg_500m','IRR0.1_hi']:.2f}] "
            f"p={r.loc['urb_chg_500m','p']:.3f}")

