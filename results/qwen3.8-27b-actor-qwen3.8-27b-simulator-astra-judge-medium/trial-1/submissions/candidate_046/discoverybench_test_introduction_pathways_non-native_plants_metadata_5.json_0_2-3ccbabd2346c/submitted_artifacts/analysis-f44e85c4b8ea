print('\n' + '=' * 100)
print('4) VIF (500 m design, continuous terms; top 8)')
print('=' * 100)
from statsmodels.stats.outliers_influence import variance_inflation_factor
Xv = sm.add_constant(X500.copy())
vifs = {c: variance_inflation_factor(Xv.values, i) for i, c in enumerate(Xv.columns) if c != 'const'}
print({k: round(v, 2) for k, v in sorted(vifs.items(), key=lambda kv: -kv[1])[:8]})

print('\n[PART B done]')

print('=' * 100)
print('5) PATHWAY CONTRAST - stacked model, Poisson with plot-clustered robust SE')
print('=' * 100)
long = pd.DataFrame({
    'plot': np.tile(np.arange(len(df)), 3),
    'pathway': np.repeat(['Gardening', 'Unintentional', 'AgriForest'], len(df)),
    'count': np.concatenate([df['n_gard'].values, df['n_unint'].values, df['n_agfo'].values]),
})
for c in ['urb_lvl_500m', 'urb_chg_500m'] + CTRL + ['habitat']:
    long[c] = np.tile(df[c].values, 3)
Fstack = ('C(pathway, Treatment(reference="Unintentional")) + urb_lvl_500m + urb_chg_500m'
          ' + C(pathway, Treatment(reference="Unintentional")):urb_lvl_500m'
          ' + C(pathway, Treatment(reference="Unintentional")):urb_chg_500m'
          ' + ' + ' + '.join(CTRL)
          + ' + C(habitat, Treatment(reference="Scrublands"))')
Xs = patsy.dmatrix(Fstack, long, return_type='dataframe', NA_action='raise')
ms = sm.GLM(long['count'], Xs, family=Poisson()).fit(
    maxiter=500, cov_type='cluster', cov_kwds={'groups': long['plot'].values})
ts = coef_table(ms)
print('\nUrban terms (IRR per 0.1 unit, plot-clustered SE):')
for k in ts.index:
    if 'urb' in k:
        print(f'  {k:75s} IRR/0.1={ts.loc[k,"IRR0.1"]:.3f} [{ts.loc[k,"IRR0.1_lo"]:.3f}-{ts.loc[k,"IRR0.1_hi"]:.3f}] p={ts.loc[k,"p"]:.4f}')
base_lvl, base_chg = ts.loc['urb_lvl_500m', 'coef'], ts.loc['urb_chg_500m', 'coef']
print(f'\nUnintentional (ref): urban-level IRR/0.1 = {np.exp(base_lvl*0.1):.3f}, urban-change IRR/0.1 = {np.exp(base_chg*0.1):.3f}')
for pw in ['Gardening', 'AgriForest']:
