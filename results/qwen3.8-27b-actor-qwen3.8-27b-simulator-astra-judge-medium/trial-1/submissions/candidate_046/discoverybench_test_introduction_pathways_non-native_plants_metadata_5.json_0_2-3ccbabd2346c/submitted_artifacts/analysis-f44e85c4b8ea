deg = W.sum(1)
Wn = np.divide(W, deg[:, None], out=np.zeros_like(W), where=deg[:, None] > 0)
yz = mr - mr.mean()
moran = (len(df) / Wn.sum()) * (yz @ Wn @ yz) / (yz @ yz)
print(f"Moran's I = {moran:.3f}")

