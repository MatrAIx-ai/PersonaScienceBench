"""
Main analysis: In which domains do original effect sizes tend to be larger
than replication effect sizes?

Data: meta-regression_joined_data_heterogeneity_in_replication_projects.csv
(86 original studies, one row per study, joined with replication project data.)

Primary scale: Fisher-z (fiso, fisr) -- variance-stabilizing for correlations.
Per-study signed difference: d = fiso - fisr (original minus replication).
Domain levels reported: discipline (Cognitive/Social/Economics) and
replication project (Psychology / Experimental Economics).
Summary stats per domain: median and mean of d, % studies with d > 0,
mean relative_es (= rr/ro), sign-flip rate (rr < 0).
Sensitivities: (a) correlation scale d = ro - rr; (b) exclude replications
with nr < 30.
"""
import pandas as pd
import numpy as np

CSV = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(CSV, na_values=["NA", ""])

# ---------- Data quality checks ----------
assert len(df) == 86, f"unexpected n={len(df)}"
key_cols = ["ro", "rr", "fiso", "fisr", "se_fiso", "se_fisr", "no", "nr", "relative_es"]
assert df[key_cols].notna().all().all(), "missing values in key columns"
assert df["study"].is_unique, "duplicate studies"
assert np.max(np.abs(df["fiso"] - np.arctanh(df["ro"]))) < 1e-9
assert np.max(np.abs(df["fisr"] - np.arctanh(df["rr"]))) < 1e-9

# ---------- Per-study signed differences ----------
df["d_fz"] = df["fiso"] - df["fisr"]     # primary: Fisher-z scale
df["d_r"] = df["ro"] - df["rr"]          # sensitivity: correlation scale
df["sign_flip"] = df["rr"] < 0

def summarize(g):
    return pd.Series({
        "n": len(g),
        "median_d_fz": g["d_fz"].median(),
        "mean_d_fz": g["d_fz"].mean(),
        "pct_d_fz_gt0": (g["d_fz"] > 0).mean(),
        "median_d_r": g["d_r"].median(),
        "mean_d_r": g["d_r"].mean(),
        "mean_relative_es": g["relative_es"].mean(),
        "median_relative_es": g["relative_es"].median(),
        "pct_sign_flip": g["sign_flip"].mean(),
        "mean_no": g["no"].mean(),
        "mean_nr": g["nr"].mean(),
    })

out = []
for label, col in [("discipline", "discipline"), ("project", "project.x")]:
    for name, g in df.groupby(col, sort=True):
        out.append(summarize(g).add_prefix("all_"))
        g30 = g[g["nr"] >= 30]
        s30 = summarize(g30)
        out.append(pd.Series({
            "n_excl_nr30": len(g30),
            "median_d_fz_excl_nr30": s30["median_d_fz"],
            "mean_d_fz_excl_nr30": s30["mean_d_fz"],
            "pct_d_fz_gt0_excl_nr30": s30["pct_d_fz_gt0"],
            "median_d_r_excl_nr30": s30["median_d_r"],
            "mean_relative_es_excl_nr30": s30["mean_relative_es"],
        }))
    out.append(pd.Series({"domain_level": label}))
# build long-form table instead (cleaner)
rows = []
for label, col in [("discipline", "discipline"), ("project", "project.x")]:
    for name, g in df.groupby(col, sort=True):
        base = summarize(g)
        g30 = g[g["nr"] >= 30]
        s30 = summarize(g30)
        rows.append({
            "level": label, "domain": name,
            "n": base["n"],
            "median_d_fz": base["median_d_fz"], "mean_d_fz": base["mean_d_fz"],
            "pct_d_fz_gt0": base["pct_d_fz_gt0"],
            "median_d_r": base["median_d_r"], "mean_d_r": base["mean_d_r"],
            "mean_relative_es": base["mean_relative_es"],
            "median_relative_es": base["median_relative_es"],
            "pct_sign_flip": base["pct_sign_flip"],
            "n_excl_nr30": len(g30),
            "median_d_fz_excl_nr30": s30["median_d_fz"],
            "mean_d_fz_excl_nr30": s30["mean_d_fz"],
            "pct_d_fz_gt0_excl_nr30": s30["pct_d_fz_gt0"],
            "median_d_r_excl_nr30": s30["median_d_r"],
            "mean_relative_es_excl_nr30": s30["mean_relative_es"],
        })
tab = pd.DataFrame(rows)
pd.set_option("display.width", 250)

print("=" * 100)
print("PRIMARY TABLE (all 86 studies) -- d = fiso - fisr (Fisher-z), original minus replication")
print("=" * 100)
cols = ["level","domain","n","median_d_fz","mean_d_fz","pct_d_fz_gt0",
        "median_d_r","mean_d_r","mean_relative_es","pct_sign_flip"]
print(tab[cols].round(3).to_string(index=False))

print()
print("=" * 100)
print("SENSITIVITY: exclude replications with nr < 30")
print("=" * 100)
cols2 = ["level","domain","n_excl_nr30","median_d_fz_excl_nr30","mean_d_fz_excl_nr30",
         "pct_d_fz_gt0_excl_nr30","median_d_r_excl_nr30","mean_relative_es_excl_nr30"]
print(tab[cols2].round(3).to_string(index=False))

print()
print("Excluded studies (nr < 30):")
print(df[df["nr"] < 30][["study","project.x","discipline","ro","rr","d_fz","no","nr"]].to_string(index=False))

print()
print("=" * 100)
print("RANKINGS")
print("=" * 100)
print("By discipline, ranked by median d_fz (largest inflation first):")
print(tab[tab.level=="discipline"].sort_values("median_d_fz", ascending=False)[["domain","median_d_fz","mean_d_fz","mean_relative_es","pct_sign_flip"]].round(3).to_string(index=False))
print("\nBy discipline, ranked by mean relative_es (smallest = strongest shrinkage first):")
print(tab[tab.level=="discipline"].sort_values("mean_relative_es")[["domain","mean_relative_es","median_relative_es"]].round(3).to_string(index=False))
print("\nBy project, ranked by median d_fz:")
print(tab[tab.level=="project"].sort_values("median_d_fz", ascending=False)[["domain","median_d_fz","mean_d_fz","mean_relative_es","pct_sign_flip"]].round(3).to_string(index=False))

tab.round(4).to_csv("analysis_table.csv", index=False)
print("\nSaved analysis_table.csv")
