# Final analysis: In which domain did both original and replication studies
# primarily use student subjects (original: 82.4%, replication: 80.9%)?
#
# Question targets the 'discipline' of the original paper (Social / Cognitive /
# Economics) in the meta-regression study dataset (CSV 1). CSV 2 is not needed.
import pandas as pd

CSV1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(CSV1)

# --- Step 1: cleaning / analytic unit -------------------------------------
for c in ['discipline', 'subjects.o', 'subjects.r']:
    df[c] = df[c].astype('string').str.strip()
    df.loc[df[c].isin(['', 'NA', 'na', 'NaN']), c] = pd.NA
print('rows:', len(df), '| unique O/R pairs (id):', df['id'].nunique())
print('missing after clean: discipline=%d subjects.o=%d subjects.r=%d' % (
    df['discipline'].isna().sum(), df['subjects.o'].isna().sum(), df['subjects.r'].isna().sum()))
print('rows with unreadable subjects:', df.loc[df['subjects.o'].isna() | df['subjects.r'].isna(), 'id'].tolist())

# --- Step 2: student share per discipline, row- and study-level -----------
def shares(d, col):
    d = d.dropna(subset=[col])  # exclude unreadable subject values from denominator
    return {disc: (int((g[col] == 'students').sum()), len(g),
                   round(100 * (g[col] == 'students').mean(), 1))
            for disc, g in d.groupby('discipline')}

# --- Step 3+4: sensitivity table (row vs first-per-id; drop/aggregated) ----
variants = {
    'all rows (n=927)': df,
    'drop==False': df[df['drop'] == False],
    'aggregated!=True': df[df['aggregated'] != True],
    'drop==False & aggregated!=True': df[(df['drop'] == False) & (df['aggregated'] != True)],
    'first row per id': df.drop_duplicates('id', keep='first'),
    'first/id, drop==False': df[df['drop'] == False].drop_duplicates('id', keep='first'),
    'first/id, aggregated!=True': df[df['aggregated'] != True].drop_duplicates('id', keep='first'),
    'first/id, drop==F & agg!=T': df[(df['drop'] == False) & (df['aggregated'] != True)].drop_duplicates('id', keep='first'),
}

TARGET_O, TARGET_R = 82.4, 80.9
rows = []
for name, d in variants.items():
    o = shares(d, 'subjects.o'); r = shares(d, 'subjects.r')
    for disc in sorted(set(o) | set(r)):
        ko, no, po = o.get(disc, (0, 0, float('nan')))
        kr, nr, pr = r.get(disc, (0, 0, float('nan')))
        close = abs(po - TARGET_O) < 5 and abs(pr - TARGET_R) < 5
        rows.append((name, disc, ko, no, po, kr, nr, pr, 'YES' if close else ''))
tab = pd.DataFrame(rows, columns=['variant', 'discipline', 'o_students', 'o_n', 'o_%',
                                  'r_students', 'r_n', 'r_%', 'near 82.4/80.9'])
print('\n=== SENSITIVITY TABLE (share of studies using student subjects) ===')
print(tab.to_string(index=False))

# --- Verdict ---------------------------------------------------------------
print('\n=== VERDICT ===')
# study-level, unfiltered (closest to question wording)
d = df.drop_duplicates('id', keep='first')
o = shares(d, 'subjects.o'); r = shares(d, 'subjects.r')
for disc in sorted(o):
    print(f'{disc:10s} original: {o[disc][2]:5.1f}% ({o[disc][0]}/{o[disc][1]})  '
          f'replication: {r[disc][2]:5.1f}% ({r[disc][0]}/{r[disc][1]})')
best = min(o, key=lambda x: abs(o[x][2] - TARGET_O) + abs(r[x][2] - TARGET_R))
print('Discipline closest to (82.4%, 80.9%):', best)
print('Economics delta:', abs(o['Economics'][2]-TARGET_O), abs(r['Economics'][2]-TARGET_R))
print('Cognitive delta:', abs(o['Cognitive'][2]-TARGET_O), abs(r['Cognitive'][2]-TARGET_R))
print('Social    delta:', abs(o['Social'][2]-TARGET_O), abs(r['Social'][2]-TARGET_R))
