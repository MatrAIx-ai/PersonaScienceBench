import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# Filter Experimental Economics
ee = df[df['project'] == 'ee'].copy()

# Denominator: distinct original studies by id
n_originals = ee['id'].nunique()

# Numerator: originals conducted in the United Kingdom
uk_mask = ee['experiment_country.o'] == 'United Kingdom'
n_uk = ee.loc[uk_mask, 'id'].nunique()

# Missing country check
n_missing = int(ee['experiment_country.o'].isna().sum())

# Duplicate check (by id, title, authors.o)
dup_id = int(ee['id'].duplicated().sum())

proportion = n_uk / n_originals
pct = 100 * proportion

print(f"EE rows: {len(ee)}")
print(f"Distinct original studies (by id): {n_originals}")
print(f"UK originals: {n_uk}")
print(f"Missing country in EE: {n_missing}")
print(f"Duplicate ids in EE: {dup_id}")
print(f"Proportion: {n_uk}/{n_originals} = {proportion:.4f} = {pct:.2f}%")
print()
print("Country breakdown:")
print(ee['experiment_country.o'].value_counts())
