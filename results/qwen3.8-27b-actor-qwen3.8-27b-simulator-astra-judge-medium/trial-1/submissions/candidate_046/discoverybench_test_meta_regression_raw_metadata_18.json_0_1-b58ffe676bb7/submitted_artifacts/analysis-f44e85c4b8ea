"""
Analysis: What proportion of studies in Experimental Economics were conducted in a lab setting?

Data:
  file1 = data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
  file2 = data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv (verification/context only)

Definition:
  No explicit lab/non-lab variable exists. We use `online == 0` (experiment NOT conducted
  online) as the proxy for "conducted in a lab setting", corroborated by subjects type
  (students/community). `lab_id` is empty for all ee rows and identifies the replication
  lab (ml1/ml3 only); `us_lab` only encodes country, so neither is usable as a modality flag.

Denominator:
  We report the proportion for original studies (online.o == 0), for replications
  (online.r == 0), and at study level (both), to show the result is robust to the choice.
"""
import pandas as pd

F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
F2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(F1, dtype=str, keep_default_na=False)
df = df.fillna("")

# --- Filter to Experimental Economics project ---
ee = df[df["project"] == "ee"].copy()
assert (ee["drop"] == "FALSE").all(), "unexpected drop=TRUE rows in ee"
assert ee["id"].is_unique, "ee rows should be one per study"
n_studies = len(ee)

# --- Lab-setting proxy: online == 0 ---
ee["lab_o"] = (ee["online.o"].str.strip() == "0").astype(int)
ee["lab_r"] = (ee["online.r"].str.strip() == "0").astype(int)
ee["lab_both"] = ((ee["lab_o"] == 1) & (ee["lab_r"] == 1)).astype(int)

lab_o = int(ee["lab_o"].sum())
lab_r = int(ee["lab_r"].sum())
lab_both = int(ee["lab_both"].sum())

print("=" * 70)
print(f"EE studies (project=='ee', unique ids): {n_studies}")
print(f"Originals conducted in lab  (online.o==0): {lab_o}/{n_studies} = {lab_o/n_studies:.1%}")
print(f"Replications in lab         (online.r==0): {lab_r}/{n_studies} = {lab_r/n_studies:.1%}")
print(f"Studies (original+replication in lab):     {lab_both}/{n_studies} = {lab_both/n_studies:.1%}")
print("=" * 70)

# Supporting context
print("\nCorroborating fields within ee:")
print("  online.o :", dict(ee["online.o"].value_counts()))
print("  online.r :", dict(ee["online.r"].value_counts()))
print("  subjects.o:", dict(ee["subjects.o"].value_counts()))
print("  subjects.r:", dict(ee["subjects.r"].value_counts()))
print("  lab_id non-empty:", int((ee["lab_id"].str.strip() != "").sum()), "(empty -> lab_id unusable for ee)")
print("  us_lab.o  (US-lab, country only):", dict(ee["us_lab.o"].value_counts()))
print("  us_lab.r  (US-lab, country only):", dict(ee["us_lab.r"].value_counts()))

# --- Verification with file 2 (context only; no modality fields) ---
df2 = pd.read_csv(F2, dtype=str, keep_default_na=False)
ee2 = df2[df2["project"] == "Experimental Economics"]
print(f"\nFile 2 verification: {len(ee2)} 'Experimental Economics' studies "
      f"(matches {n_studies} ee studies in file 1); file 2 has no lab/online fields, "
      "so it contributes effect-size context only.")

# Per-study table (compact)
tab = ee[["id", "title", "online.o", "online.r", "subjects.o", "subjects.r",
          "lab_o", "lab_r"]].copy()
tab["title"] = tab["title"].str.slice(0, 45)
print("\nPer-study table:")
print(tab.to_string(index=False))
