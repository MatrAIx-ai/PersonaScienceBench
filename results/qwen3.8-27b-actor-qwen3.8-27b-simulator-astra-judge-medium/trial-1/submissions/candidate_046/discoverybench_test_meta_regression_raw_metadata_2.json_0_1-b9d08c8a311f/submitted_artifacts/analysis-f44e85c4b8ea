import pandas as pd
import numpy as np

# Load data
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# 1) Filter to project in {ee, rpp}
sub = df[df['project'].isin(['ee', 'rpp'])].copy()

# 2) Exclude rows where drop == True
sub = sub[sub['drop'] != True].copy()

# 3) Compute mean(length) per group
results = sub.groupby('project')['length'].agg(['count', 'mean', 'min', 'max']).reset_index()
results.columns = ['project', 'n', 'mean_length', 'min_length', 'max_length']

print("=" * 60)
print("AVERAGE LENGTH OF ORIGINAL PAPERS BY PROJECT")
print("=" * 60)
print()
print("Note: 'length' = number of pages of the original paper.")
print("Filter: project in {ee, rpp}; drop == True excluded.")
print()
print(results.to_string(index=False))
print()

# Formatted summary
for _, row in results.iterrows():
    proj_label = "Experimental Economics (ee)" if row['project'] == 'ee' else "Psychology (rpp)"
    print(f"{proj_label}: mean length = {row['mean_length']:.4f} pages (n={int(row['n'])}, "
          f"min={int(row['min_length'])}, max={int(row['max_length'])})")

print()
print("Summary table:")
print("-" * 60)
print(f"{'project':<10} {'n':>5} {'mean_length':>12} {'min':>5} {'max':>5}")
print("-" * 60)
for _, row in results.iterrows():
    print(f"{row['project']:<10} {int(row['n']):>5} {row['mean_length']:>12.4f} {int(row['min_length']):>5} {int(row['max_length']):>5}")
print("-" * 60)
