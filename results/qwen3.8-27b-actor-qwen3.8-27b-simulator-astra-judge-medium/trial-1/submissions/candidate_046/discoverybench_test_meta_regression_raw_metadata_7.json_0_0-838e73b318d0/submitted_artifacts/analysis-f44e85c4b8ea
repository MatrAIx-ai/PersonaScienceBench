"""
DiscoveryBench / BixBench analysis
Question: In which domain do the majority of authors tend to be male for both
original and replication studies?

Data: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
  - `discipline` in {Social, Cognitive, Economics}  == "domain"
  - `authors_male.o` = ratio of male authors in the ORIGINAL study  (proportion in [0,1])
  - `authors_male.r` = ratio of male authors in the REPLICATION study (proportion in [0,1])

Criterion (Variant A, primary):
  For each discipline, share of studies where the authorship is MAJORITY-MALE
  (ratio > 0.5) in BOTH the original AND the replication study.
Robustness:
  Variant B: share majority-male in .o  and  share majority-male in .r (separately).
  Variant C: weighted share of authors that are male (male_authors / total_authors),
             computed as sum(ratio * n_authors) / sum(n_authors).
"""
import pandas as pd

F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(F1)

print("Loaded FILE1:", len(df), "rows,", len(df.columns), "cols")
print("Fields used: discipline, authors_male.o, authors_male.r, n_authors.o, n_authors.r")
print("Missing -> discipline:", df['discipline'].isna().sum(),
      "| authors_male.o:", df['authors_male.o'].isna().sum(),
      "| authors_male.r:", df['authors_male.r'].isna().sum())

domains = ["Social", "Cognitive", "Economics"]
rows = []
for d in domains:
    g = df[df["discipline"] == d]
    n = len(g)
    maj_o = g["authors_male.o"] > 0.5
    maj_r = g["authors_male.r"] > 0.5
    # Variant A: majority-male in BOTH original and replication
    varA = (maj_o & maj_r).mean()
    # Variant B: separately
    varB_o = maj_o.mean()
    varB_r = maj_r.mean()
    # Variant C: weighted by number of authors
    tot_o = g["n_authors.o"].sum();  male_o = (g["authors_male.o"] * g["n_authors.o"]).sum()
    tot_r = g["n_authors.r"].sum();  male_r = (g["authors_male.r"] * g["n_authors.r"]).sum()
    varC_o = male_o / tot_o
    varC_r = male_r / tot_r
    rows.append(dict(discipline=d, n_studies=n,
                     A_both=varA,
                     B_o=varB_o, B_r=varB_r,
                     C_o=varC_o, C_r=varC_r))

res = pd.DataFrame(rows).set_index("discipline")
pd.set_option("display.float_format", lambda x: f"{x:.3f}")
print("\n=== PER-DISCIPLINE RESULTS ===")
print(res.to_string())

# Decision (Variant A): domain with the highest share of studies majority-male in both
winner = res["A_both"].idxmax()
print("\n=== DECISION (Variant A) ===")
print("Domain with largest share of studies majority-male in BOTH original & replication:", winner)
print("Domains where Variant A share > 0.5:", list(res[res["A_both"] > 0.5].index))
