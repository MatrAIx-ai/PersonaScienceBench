"""
Analysis: Demographic disparities in median 1985 wealth AMONG individuals ever incarcerated.
Data: NLS79 processed (data/nls_incarceration_processed.csv)

PRIMARY FOCUS (per researcher): disparities WITHIN the ever_jailed=1 group:
  - by sex (male vs female)
  - by race (black, white, hispanic)
  - by race x sex (6 cells)
CONTEXT: jailed vs non-jailed median difference by cell.

Estimators: median (robust to skew/zero-inflation).
Inference: bootstrap CI (percentile, B=5000) for each median;
           permutation test (B=10000) for pairwise median differences;
           Kruskal-Wallis for overall race / sex effect within jailed.
Multiple-comparison control: Benjamini-Hochberg FDR.
"""
import numpy as np
import pandas as pd
from scipy import stats

rng = np.random.default_rng(42)
B_BOOT = 5000
B_PERM = 10000

# ---------------- load & clean ----------------
df = pd.read_csv("data/nls_incarceration_processed.csv")
# documented normalization of typo 'hipanic' -> 'hispanic'
df["race"] = df["race"].str.replace("hipanic", "hispanic", regex=False)
assert set(df["race"].unique()) == {"black", "white", "hispanic"}, df["race"].unique()
assert set(df["sex"].unique()) == {"male", "female"}
assert set(df["ever_jailed"].unique()) == {0, 1}
W = "composite_wealth_1985"

jailed = df[df["ever_jailed"] == 1].copy()
notj   = df[df["ever_jailed"] == 0].copy()

# ---------------- helpers ----------------
def boot_ci_median(x, B=B_BOOT, ci=0.95, seed=42):
    r = np.random.default_rng(seed)
    x = np.asarray(x, dtype=float)
    n = len(x)
    if n == 0:
        return np.nan, np.nan, np.nan
    m = np.median(x)
    boots = np.median(r.choice(x, size=(B, n), replace=True), axis=1)
    lo = np.percentile(boots, 100*(1-ci)/2)
    hi = np.percentile(boots, 100*(1+ci)/2)
    return m, lo, hi

def perm_median_diff(a, b, B=B_PERM, seed=42):
    """Two-sample permutation test on difference of medians (a - b).
    Returns (diff, p_two_sided, ci_lo, ci_hi)."""
    a = np.asarray(a, float); b = np.asarray(b, float)
    if len(a) == 0 or len(b) == 0:
        return np.nan, np.nan, np.nan, np.nan
    d0 = np.median(a) - np.median(b)
    pooled = np.concatenate([a, b])
    na, nb = len(a), len(b)
    r = np.random.default_rng(seed)
    obs = np.abs(d0)
    cnt = 0
    diffs = np.empty(B)
    for i in range(B):
        idx = r.permutation(na+nb)
        da = np.median(pooled[idx[:na]])
        db = np.median(pooled[idx[na:]])
        diffs[i] = da - db
        if abs(da - db) >= obs - 1e-12:
            cnt += 1
    p = (cnt + 1) / (B + 1)
    lo = np.percentile(diffs, 2.5)
    hi = np.percentile(diffs, 97.5)
    return d0, p, lo, hi

def fdr(pvals):
    pvals = np.asarray(pvals)
    m = len(pvals)
    order = np.argsort(pvals)
    ranked = pvals[order]
    adj = np.empty(m)
    adj[order] = ranked
    # Benjamini-Hochberg
    adj_bonf = ranked * m / np.arange(1, m+1)
    adj_bonf = np.minimum.accumulate(adj_bonf[::-1])[::-1]
    adj_bonf = np.clip(adj_bonf, 0, 1)
    out = np.empty(m)
    out[order] = adj_bonf
    return out

# ---------------- 1) WITHIN-JAILED: by sex ----------------
print("="*70)
print("PRIMARY: disparities WITHIN ever_jailed=1  (n=%d)" % len(jailed))
print("="*70)

print("\n--- By SEX (median 1985 wealth) ---")
sex_rows = {}
for s in ["male", "female"]:
    x = jailed.loc[jailed["sex"] == s, W].values
    m, lo, hi = boot_ci_median(x)
    sex_rows[s] = (len(x), m, lo, hi)
    print(f"  {s:6s}: n={len(x):4d}  median={m:12,.0f}  95%CI=[{lo:12,.0f}, {hi:12,.0f}]")
d_sex, p_sex, lo_sex, hi_sex = perm_median_diff(
    jailed.loc[jailed['sex']=='male', W].values,
    jailed.loc[jailed['sex']=='female', W].values)
print(f"  male - female: diff={d_sex:,.0f}  95%CI=[{lo_sex:,.0f},{hi_sex:,.0f}]  p_perm={p_sex:.4f}")
# Kruskal / wilcoxon sex
u_sex, p_u_sex = stats.mannwhitneyu(
    jailed.loc[jailed['sex']=='male', W], jailed.loc[jailed['sex']=='female', W],
    alternative='two-sided', method='exact')
print(f"  Mann-Whitney U (male vs female): U={u_sex:.0f}  p={p_u_sex:.4f}")

# ---------------- 2) WITHIN-JAILED: by race ----------------
print("\n--- By RACE (median 1985 wealth) ---")
race_rows = {}
for rc in ["black", "white", "hispanic"]:
    x = jailed.loc[jailed["race"] == rc, W].values
    m, lo, hi = boot_ci_median(x)
    race_rows[rc] = (len(x), m, lo, hi)
    print(f"  {rc:8s}: n={len(x):4d}  median={m:12,.0f}  95%CI=[{lo:12,.0f}, {hi:12,.0f}]")
kw_stat, kw_p = stats.kruskal(*[jailed.loc[jailed['race']==rc, W].values for rc in ["black","white","hispanic"]])
print(f"  Kruskal-Wallis (race): H={kw_stat:.3f}  p={kw_p:.4f}")
# pairwise race
pairwise = {}
races = ["black","white","hispanic"]
for i in range(len(races)):
    for j in range(i+1, len(races)):
        a, b = races[i], races[j]
        d, p, lo, hi = perm_median_diff(
            jailed.loc[jailed['race']==a, W].values,
            jailed.loc[jailed['race']==b, W].values)
        pairwise[(a,b)] = (d, p, lo, hi)
        print(f"  {a} - {b}: diff={d:,.0f}  95%CI=[{lo:,.0f},{hi:,.0f}]  p_perm={p:.4f}")

# ---------------- 3) WITHIN-JAILED: race x sex cells ----------------
print("\n--- By RACE x SEX (median 1985 wealth) ---")
cell_rows = {}
for rc in ["black","white","hispanic"]:
    for s in ["male","female"]:
        x = jailed[(jailed['race']==rc)&(jailed['sex']==s)][W].values
        m, lo, hi = boot_ci_median(x)
        cell_rows[(rc,s)] = (len(x), m, lo, hi)
        print(f"  {rc:8s} {s:6s}: n={len(x):4d}  median={m:12,.0f}  95%CI=[{lo:12,.0f}, {hi:12,.0f}]")

# ---------------- 4) CONTEXT: jailed vs not-jailed by cell ----------------
print("\n" + "="*70)
print("CONTEXT: jailed vs NOT-jailed median diff by cell")
print("="*70)
ctx_rows = {}
for rc in ["black","white","hispanic"]:
    for s in ["male","female"]:
        a = jailed[(jailed['race']==rc)&(jailed['sex']==s)][W].values
        b = notj [(notj['race']==rc)&(notj['sex']==s)][W].values
        ma, loa, hoa = boot_ci_median(a)
        mb, lob, hob = boot_ci_median(b)
        d, p, lo, hi = perm_median_diff(a, b)
        ctx_rows[(rc,s)] = (len(a), ma, loa, hoa, len(b), mb, lob, hob, d, p, lo, hi)
        print(f"  {rc:8s} {s:6s}: jailed n={len(a):3d} med={ma:10,.0f} | "
              f"notj n={len(b):5d} med={mb:10,.0f} | diff={d:10,.0f}  p={p:.4f}")

# overall pooled jailed vs not jailed
a = jailed[W].values; b = notj[W].values
d, p, lo, hi = perm_median_diff(a, b)
print(f"  POOLED: jailed n={len(a)} med={np.median(a):,.0f} | notj n={len(b)} med={np.median(b):,.0f} | "
      f"diff={d:,.0f} p={p:.4f}")

# ---------------- 5) FDR over the main within-jailed pairwise p's ----------------
print("\n" + "="*70)
print("FDR (BH) adjustment over main within-jailed pairwise tests")
print("="*70)
primary_tests = {
    "sex: male-female": p_sex,
    "race: black-white": pairwise[("black","white")][1],
    "race: black-hispanic": pairwise[("black","hispanic")][1],
    "race: white-hispanic": pairwise[("white","hispanic")][1],
}
pv = np.array(list(primary_tests.values()))
adj = fdr(pv)
for k, (p, a) in zip(primary_tests, zip(pv, adj)):
    print(f"  {k:24s}: p={p:.4f}  p_FDR={a:.4f}")

# =================== save artifacts ===================
def fmt(x):
    return f"{x:,.0f}"

lines = []
lines.append("# NLS79: Demographic disparities in 1985 median wealth AMONG ever-incarcerated\n")
lines.append(f"Data: data/nls_incarceration_processed.csv (n={len(df)}). 'hipanic'->'hispanic' normalized.")
lines.append(f"Primary group ever_jailed=1: n={len(jailed)} (male={sum(sex_rows[s][0] for s in ['male'])}, "
             f"female={sex_rows['female'][0]}). Estimator=median; CI=percentile bootstrap (B={B_BOOT}); "
             f"p=permutation (B={B_PERM}).\n")

lines.append("## Within ever_jailed=1: by SEX\n")
lines.append("| sex | n | median 1985 wealth | 95% CI |")
lines.append("|---|---|---|---|")
for s in ["male","female"]:
    n,m,lo,hi = sex_rows[s]
    lines.append(f"| {s} | {n} | {fmt(m)} | [{fmt(lo)}, {fmt(hi)}] |")
lines.append(f"\n**male - female** = {fmt(d_sex)} (95%CI [{fmt(lo_sex)}, {fmt(hi_sex)}]); "
             f"permutation p={p_sex:.4f}; Mann-Whitney p={p_u_sex:.4f}\n")

lines.append("## Within ever_jailed=1: by RACE\n")
lines.append("| race | n | median 1985 wealth | 95% CI |")
lines.append("|---|---|---|---|")
for rc in ["black","white","hispanic"]:
    n,m,lo,hi = race_rows[rc]
    lines.append(f"| {rc} | {n} | {fmt(m)} | [{fmt(lo)}, {fmt(hi)}] |")
lines.append(f"\nKruskal-Wallis (race): H={kw_stat:.3f}, p={kw_p:.4f}\n")
lines.append("Pairwise (permutation):")
for (a,b),(d,p,lo,hi) in pairwise.items():
    lines.append(f"- {a} - {b} = {fmt(d)} (95%CI [{fmt(lo)}, {fmt(hi)}]); p={p:.4f}")
lines.append("")

lines.append("## Within ever_jailed=1: by RACE x SEX\n")
lines.append("| race | sex | n | median 1985 wealth | 95% CI |")
lines.append("|---|---|---|---|---|")
for (rc,s),(n,m,lo,hi) in cell_rows.items():
    lines.append(f"| {rc} | {s} | {n} | {fmt(m)} | [{fmt(lo)}, {fmt(hi)}] |")
lines.append("")

lines.append("## CONTEXT: jailed vs not-jailed by cell\n")
lines.append("| race | sex | jailed n | jailed med | notj n | notj med | diff | p |")
lines.append("|---|---|---|---|---|---|---|---|")
for (rc,s),r in ctx_rows.items():
    na,ma,loa,hoa,nb,mb,lob,hob,d,p,lo,hi = r
    lines.append(f"| {rc} | {s} | {na} | {fmt(ma)} | {nb} | {fmt(mb)} | {fmt(d)} | {p:.4f} |")
lines.append("")

lines.append("## FDR (BH) over main within-jailed tests\n")
for k, p, a in zip(primary_tests, pv, adj):
    lines.append(f"- {k}: p={p:.4f}, p_FDR={a:.4f}")
lines.append("")

with open("results.md","w") as f:
    f.write("\n".join(lines))

print("\nSaved results.md and analysis.py")
print("\n----- results.md -----")
print("\n".join(lines))
