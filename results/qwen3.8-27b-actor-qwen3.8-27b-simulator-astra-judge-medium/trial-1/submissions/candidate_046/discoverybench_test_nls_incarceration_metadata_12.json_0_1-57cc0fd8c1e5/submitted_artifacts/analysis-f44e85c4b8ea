import pandas as pd, numpy as np
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

df = pd.read_csv("data/nls_incarceration_processed.csv")
b = df[df['race']=='black'].copy()
wealth = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']

print("N black total:", len(b), "| ever_jailed==1:", (b['ever_jailed']==1).sum())

# terciles of baseline wealth
b['tercile'] = pd.qcut(b['composite_wealth_1985'], 3, labels=['low','mid','high'])

# sub-group table
print("\n=== Black: mean/median cw by tercile x ever_jailed ===")
g = b.groupby(['tercile','ever_jailed'], observed=True)[wealth].agg(['count','mean','median'])
print(g.round(1).to_string())

# delta
b['delta'] = b['composite_wealth_1996'] - b['composite_wealth_1985']
print("\n=== Black: mean delta(1996-1985) by tercile x ever_jailed ===")
print(b.groupby(['tercile','ever_jailed'], observed=True)['delta'].agg(['count','mean','median']).round(1).to_string())

# Overall jailed vs not delta
print("\n=== Black: delta overall jailed vs not ===")
print(b.groupby('ever_jailed')['delta'].agg(['count','mean','median']).round(1).to_string())

# Interaction regression: delta ~ ever_jailed + tercile + sex + ever_jailed:tercile
X = pd.get_dummies(b[['tercile','sex']], drop_first=False, dtype=float)
X = X.rename(columns={'sex_male':'sex_male','tercile_low':'t_low','tercile_mid':'t_mid','tercile_high':'t_high'})
# drop one tercile ref (low) and sex ref (female)
X = X.drop(columns=['t_low','sex_male'])
X['ever_jailed'] = b['ever_jailed'].astype(float)
for t in ['t_mid','t_high']:
    X[f'jail:{t}'] = (b['ever_jailed'].astype(float)*X[t]).values
X = sm.add_constant(X)
y = b['delta'].astype(float)
mod = sm.OLS(y, X).fit(cov_type='HC1')
print("\n=== OLS: delta ~ ever_jailed + tercile + sex + jail:tercile (HC1) ===")
print(mod.summary())

# log robustness: y = log(1+delta) but delta can be negative; use log of 1996 wealth
ylog = np.log1p(b['composite_wealth_1996'].clip(lower=0).astype(float))
modl = sm.OLS(ylog, X).fit(cov_type='HC1')
print("\n=== OLS log robustness: log1p(cw_1996) ===")
print(modl.summary().tables[1])

# IC95 for interaction terms
ci = mod.conf_int()
for t in ['jail:t_mid','jail:t_high','ever_jailed']:
    print(f"IC95 {t}: [{ci.loc[t,0]:.1f}, {ci.loc[t,1]:.1f}] coef={mod.params[t]:.1f} p={mod.pvalues[t]:.4f}")
