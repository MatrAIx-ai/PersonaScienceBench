import pandas as pd
import numpy as np

# ------------------------------------------------------------------
# Question: Between which years did the largest increases in median
#           wealth occur among black females?
# Data:     data/nls_incarceration_processed.csv
# Method:   filter race=='black' & sex=='female'; compute the MEDIAN of
#           composite_wealth_1985 / _1990 / _1996; compare ABSOLUTE
#           increases for the two consecutive intervals (85->90, 90->96).
#           Secondary note: relative (%) increase.
#           ever_jailed is NOT used (no incarceration filter requested).
# ------------------------------------------------------------------
df = pd.read_csv("data/nls_incarceration_processed.csv")

# 1) Filter
bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
n = len(bf)

# 2) Medians
cols = {"1985": "composite_wealth_1985",
        "1990": "composite_wealth_1990",
        "1996": "composite_wealth_1996"}
med = {y: bf[c].median() for y, c in cols.items()}

# 3) Absolute deltas for consecutive intervals
d_85_90 = med["1990"] - med["1985"]
d_90_96 = med["1996"] - med["1990"]

# 4) Secondary: relative (percent) deltas
p_85_90 = d_85_90 / med["1985"] * 100.0
p_90_96 = d_90_96 / med["1990"] * 100.0

# 5) Decide by ABSOLUTE increase (primary criterion)
intervals = {"1985->1990": d_85_90, "1990->1996": d_90_96}
winner = max(intervals, key=intervals.get)

print("=== BLACK FEMALE SUBSET ===")
print(f"n = {n}")
print(f"nulls in wealth cols = {int(bf[list(cols.values())].isna().sum().sum())}")
print("\n=== MEDIANS (composite wealth) ===")
for y in ["1985", "1990", "1996"]:
    print(f"  {y}: median = {med[y]:.1f}")
print("\n=== ABSOLUTE INCREASES (PRIMARY) ===")
print(f"  1985 -> 1990: {d_85_90:+.1f}")
print(f"  1990 -> 1996: {d_90_96:+.1f}")
print(f"  => LARGEST absolute increase: {winner}")
print("\n=== RELATIVE INCREASES (SECONDARY NOTE) ===")
print(f"  1985 -> 1990: {p_85_90:+.1f}%")
print(f"  1990 -> 1996: {p_90_96:+.1f}%")
