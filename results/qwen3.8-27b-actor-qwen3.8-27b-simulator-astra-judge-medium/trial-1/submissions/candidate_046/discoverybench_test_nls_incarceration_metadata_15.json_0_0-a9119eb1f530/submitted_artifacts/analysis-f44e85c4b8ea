"""
Wealth Inequality Analysis: White Males & Females, NLSY79, 1990 vs 1996
No sampling weights (weight=1 per observation).
Main metrics: Gini (shifted for negatives), P90/P50 ratio.
Complementary: CV, Mean-Median gap, Variance.
"""
import pandas as pd
import numpy as np

# ── Load & filter ──────────────────────────────────────────────────────
df = pd.read_csv('data/nls_incarceration_processed.csv')
white = df[df['race'] == 'white'].copy()

subsets = {
    ('male',   1990): white.loc[white['sex']=='male',   'composite_wealth_1990'].values,
    ('male',   1996): white.loc[white['sex']=='male',   'composite_wealth_1996'].values,
    ('female', 1990): white.loc[white['sex']=='female', 'composite_wealth_1990'].values,
    ('female', 1996): white.loc[white['sex']=='female', 'composite_wealth_1996'].values,
}

# ── Metric functions ───────────────────────────────────────────────────
def gini_shifted(x):
    """Gini coefficient; shift = -min(x) so all values >= 0."""
    x = np.asarray(x, dtype=float)
    shift = -x.min() if x.min() < 0 else 0.0
    xs = np.sort(x + shift)
    n = len(xs)
    total = xs.sum()
    if total == 0:
        return 0.0
    ranks = np.arange(1, n + 1)
    return (2.0 * np.sum(ranks * xs)) / (n * total) - (n + 1.0) / n

def p90_p50_ratio(x):
    """P90 / median ratio. (P25=0 due to zero mass in >25% of cases.)"""
    x = np.asarray(x, dtype=float)
    p90, p50 = np.percentile(x, 90), np.percentile(x, 50)
    if p50 == 0:
        return np.inf
    return p90 / p50

def cv(x):
    x = np.asarray(x, dtype=float)
    return x.std() / x.mean()

def mean_median_gap(x):
    x = np.asarray(x, dtype=float)
    return x.mean() - np.median(x)

def variance(x):
    return float(np.var(np.asarray(x, dtype=float)))

# ── Compute ────────────────────────────────────────────────────────────
R = {}
for key, vals in subsets.items():
    sex, year = key
    R[key] = dict(
        n=len(vals),
        zero_pct=(vals == 0).mean() * 100,
        neg_pct=(vals < 0).mean() * 100,
        Gini=gini_shifted(vals),
        P90_P50=p90_p50_ratio(vals),
        CV=cv(vals),
        MeanMed=mean_median_gap(vals),
        Var=variance(vals),
        Mean=vals.mean(),
        Median=np.median(vals),
        P25=np.percentile(vals, 25),
        P50=np.percentile(vals, 50),
        P75=np.percentile(vals, 75),
        P90=np.percentile(vals, 90),
    )

# ── Print ──────────────────────────────────────────────────────────────
W = 80
print("=" * W)
print("WEALTH INEQUALITY ANALYSIS: WHITE MALES & FEMALES, 1990 vs 1996")
print("NLSY79 cohort | No sampling weights (weight = 1 per observation)")
print("=" * W)

for sex in ['male', 'female']:
    for year in [1990, 1996]:
        r = R[(sex, year)]
        print(f"\n{'='*60}")
        print(f"  {sex.upper()} — {year}  (n={r['n']},  zeros={r['zero_pct']:.1f}%,  neg={r['neg_pct']:.1f}%)")
        print(f"{'='*60}")
        print(f"  MAIN:")
        print(f"    Gini (shifted):  {r['Gini']:.4f}")
        print(f"    P90/P50:         {r['P90_P50']:.4f}")
        print(f"  COMPLEMENTARY:")
        print(f"    CV:              {r['CV']:.4f}")
        print(f"    Mean-Median:     {r['MeanMed']:,.0f}")
        print(f"    Variance:        {r['Var']:,.0f}")
        print(f"  DISTRIBUTION:")
        print(f"    Mean:  {r['Mean']:>12,.0f}   Median: {r['Median']:>12,.0f}")
        print(f"    P25:   {r['P25']:>12,.0f}   P75:    {r['P75']:>12,.0f}   P90: {r['P90']:>12,.0f}")

# Intra-sex
print(f"\n{'='*W}")
print("INTRA-SEX CHANGES  (1990 → 1996)")
print(f"{'='*W}")
for sex in ['male', 'female']:
    r90, r96 = R[(sex,1990)], R[(sex,1996)]
    print(f"\n  {sex.upper()}  1990 → 1996:")
    print(f"    Gini:         {r90['Gini']:.4f}  →  {r96['Gini']:.4f}   (Δ = {r96['Gini']-r90['Gini']:+.4f})")
    print(f"    P90/P50:      {r90['P90_P50']:.4f}  →  {r96['P90_P50']:.4f}   (Δ = {r96['P90_P50']-r90['P90_P50']:+.4f})")
    print(f"    CV:           {r90['CV']:.4f}  →  {r96['CV']:.4f}   (Δ = {r96['CV']-r90['CV']:+.4f})")
    print(f"    Mean-Median:  {r90['MeanMed']:>10,.0f}  →  {r96['MeanMed']:>10,.0f}   (Δ = {r96['MeanMed']-r90['MeanMed']:+,.0f})")
    print(f"    Variance:     {r90['Var']:>18,.0f}  →  {r96['Var']:>18,.0f}")
    print(f"    Median:       {r90['Median']:>10,.0f}  →  {r96['Median']:>10,.0f}")
    print(f"    Zero share:   {r90['zero_pct']:.1f}%  →  {r96['zero_pct']:.1f}%")

# Inter-sex
print(f"\n{'='*W}")
print("INTER-SEX COMPARISON  (Male vs Female)")
print(f"{'='*W}")
for year in [1990, 1996]:
    rm, rf = R[('male',year)], R[('female',year)]
    print(f"\n  {year}:")
    print(f"    Gini:        Male {rm['Gini']:.4f}  vs  Female {rf['Gini']:.4f}   (M-F = {rm['Gini']-rf['Gini']:+.4f})")
    print(f"    P90/P50:     Male {rm['P90_P50']:.4f}  vs  Female {rf['P90_P50']:.4f}   (M-F = {rm['P90_P50']-rf['P90_P50']:+.4f})")
    print(f"    CV:          Male {rm['CV']:.4f}  vs  Female {rf['CV']:.4f}   (M-F = {rm['CV']-rf['CV']:+.4f})")

g90 = R[('male',1990)]['Gini'] - R[('female',1990)]['Gini']
g96 = R[('male',1996)]['Gini'] - R[('female',1996)]['Gini']
p90 = R[('male',1990)]['P90_P50'] - R[('female',1990)]['P90_P50']
p96 = R[('male',1996)]['P90_P50'] - R[('female',1996)]['P90_P50']
print(f"\n  Change in inter-sex gap  (Male - Female):")
print(f"    Gini:       {g90:+.4f}  →  {g96:+.4f}   (Δ = {g96-g90:+.4f})")
print(f"    P90/P50:    {p90:+.4f}  →  {p96:+.4f}   (Δ = {p96-p90:+.4f})")

print(f"\n{'='*W}")
print("ANALYSIS COMPLETE")
print(f"{'='*W}")
