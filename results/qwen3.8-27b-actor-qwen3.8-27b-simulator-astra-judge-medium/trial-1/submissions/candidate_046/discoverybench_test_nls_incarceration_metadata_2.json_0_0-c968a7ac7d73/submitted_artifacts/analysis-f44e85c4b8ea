import pandas as pd
import numpy as np
from scipy import stats

rng = np.random.default_rng(42)
df = pd.read_csv('data/nls_incarceration_processed.csv')
years = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
jailed = df[df['ever_jailed']==1]
nojailed = df[df['ever_jailed']==0]
print(f"N jailed={len(jailed)}, no-jailed={len(nojailed)}")

# permutation test: one-sided p = P(diff_perm <= observed) for mean(jailed)-mean(nojailed)
def perm_test_one_sided(a, b, nboot=20000, rng=rng):
    a = np.asarray(a); b = np.asarray(b)
    obs = a.mean() - b.mean()
    pooled = np.concatenate([a,b])
    na = len(a)
    diffs = np.empty(nboot)
    for i in range(nboot):
        idx = rng.permutation(len(pooled))
        diffs[i] = pooled[idx[:na]].mean() - pooled[idx[na:]].mean()
    return (diffs <= obs).mean()

rows=[]
for col in years:
    y = col.split('_')[-1]
    a = jailed[col].values
    b = nojailed[col].values
    # Mann-Whitney U one-sided: H1 jailed < nojailed -> alternative='less'
    u1, p1 = stats.mannwhitneyu(a, b, alternative='less')
    _, p2 = stats.mannwhitneyu(a, b, alternative='two-sided')
    # Welch t-test
    t1, pt1 = stats.ttest_ind(a, b, equal_var=False, alternative='less')
    pt2 = stats.ttest_ind(a, b, equal_var=False, alternative='two-sided').pvalue
    # permutation one-sided
    pp = perm_test_one_sided(a, b)
    rows.append((y, len(a), len(b), a.mean(), b.mean(), np.median(a), np.median(b),
                 round(p1,6), round(p2,6), round(pt1,6), round(pp,6)))

res = pd.DataFrame(rows, columns=['year','n_j','n_nj','mean_j','mean_nj','med_j','med_nj',
                                  'mw_p1','mw_p2','welch_p1','perm_p1'])
bonf = 0.05/3
res['mw_sig_one'] = res['mw_p1'] < 0.05
res['mw_sig_bonf'] = res['mw_p1'] < bonf
pd.set_option('display.width',200)
print("\n=== RESULTS ===")
print(res.to_string(index=False))
print("\nBonferroni threshold:", round(bonf,5))
print("Years significant (MW one-sided, alpha=0.05):",
      list(res.loc[res['mw_sig_one'],'year']))
print("Years significant (MW one-sided, Bonferroni):",
      list(res.loc[res['mw_sig_bonf'],'year']))
res.to_csv('results_summary.csv', index=False)
