import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from scipy.stats import f as fdist

df = pd.read_csv('data/nls_raw.csv')
N0 = len(df)

# Outcome: baseline schooling (Option A), recode 95 -> NA
y = df['Highest grade completed, 1979'].astype(float); y[y==95]=np.nan

sex   = (df['Sex of respondent, 1979']==1).astype(float)
age   = df['Age of respondent, 1979'].astype(float)
fam   = df['Family size, 1979'].astype(float)
race  = df['Racial/ethnic cohort, 1979']
black = (race==1).astype(float); hispanic=(race==2).astype(float)

inc    = df['Total net family income, previous calendar year, 1979'].astype(float)
loginc = np.log(inc.where(inc>0))
mogr   = df["Highest grade completed by respondent's mother, 1979"].astype(float)
fagr   = df["Highest grade completed by respondent's father, 1979"].astype(float)
wealth = df['Family net wealth, 1985'].astype(float)

asv_cols = {'AR':'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
            'WK':'ASVAB - Word Knowledge Z Score (rounded), 1981',
            'PC':'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
            'MK':'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'}
Z={k:(df[c].astype(float)-df[c].astype(float).mean())/df[c].astype(float).std() for k,c in asv_cols.items()}
asv_comp = pd.DataFrame(Z).mean(axis=1)
rank   = df['Rank in class last year attended at this school, 1981'].astype(float)
nstud  = df['Number of students in class last year attended at this school, 1981'].astype(float)
rank_pct = rank/nstud

D = pd.DataFrame({'grade':y,'black':black,'hispanic':hispanic,'sex':sex,'age1979':age,
                  'famsize':fam,'loginc':loginc,'mother_grade':mogr,'father_grade':fagr,
                  'asvab_comp':asv_comp,
                  'asv_AR':Z['AR'],'asv_WK':Z['WK'],'asv_PC':Z['PC'],'asv_MK':Z['MK'],
                  'rank_pct':rank_pct,'wealth1985':wealth})

SES=['loginc','mother_grade','father_grade']
RACE=['black','hispanic']
DEMO=['sex','age1979','famsize']

def fit(cols, data=D):
    d = data[['grade']+cols].dropna()
    m = sm.OLS(d['grade'], sm.add_constant(d[cols])).fit()
    return m

def show(m, label):
    t=pd.DataFrame({'coef':m.params,'se':m.bse,'p':m.pvalues})
    print(f"\n### {label}  N={int(m.nobs)} R2={m.rsquared:.4f}")
    print(t.round(4).to_string()); return t

def pct(a,b): return np.where((a!=0),100*(b-a)/np.abs(a),np.nan)

mR=fit(SES+RACE+DEMO); mF=fit(SES+RACE+DEMO+['asvab_comp'])
tR=show(mR,"MODEL R (SES+race+demo)"); tF=show(mF,"MODEL F (+ASVAB composite)")

cmp=pd.DataFrame({'R_coef':tR['coef'],'R_p':tR['p'],'F_coef':tF['coef'],'F_p':tF['p']})
cmp['pct_change']=pct(cmp['R_coef'],cmp['F_coef'])
print("\n### COMPARISON R vs F (primary OLS)")
print(cmp.round(4).to_string())
print(f"\nDelta R2 (F-R) = {mF.rsquared-mR.rsquared:.4f}")
ssr_r=(mR.resid**2).sum(); ssr_f=(mF.resid**2).sum()
Fstat=((ssr_r-ssr_f)/1)/(ssr_f/mF.df_resid)
print(f"Nested F-test adding asvab_comp: F(1,{int(mF.df_resid)})={Fstat:.2f} p={fdist.sf(Fstat,1,mF.df_resid):.3e}")

# Ordered logit secondary
od=D[['grade']+SES+RACE+DEMO+['asvab_comp']].dropna()
od=od[od['grade'].between(0,18)]
try:
    oR=OrderedModel(od['grade'],od[SES+RACE+DEMO],distr='logit').fit(disp=0,maxiter=1000)
    oF=OrderedModel(od['grade'],od[SES+RACE+DEMO+['asvab_comp']],distr='logit').fit(disp=0,maxiter=1000)
    print("\n### ORDERED LOGIT (secondary)  N=",int(oF.nobs))
    print("R:\n",oR.params.round(4).to_string())
    print("F:\n",oF.params.round(4).to_string())
    print(f"logLR 2*(F-R)={2*(oF.llf-oR.llf):.1f}")
except Exception as e:
    print("Ordered logit error:",repr(e))

# Sensitivities
mS4=fit(SES+RACE+DEMO+['asv_AR','asv_WK','asv_PC','asv_MK']); show(mS4,"SENS: 4 individual ASVAB")
mSR=fit(SES+RACE+DEMO+['asvab_comp','rank_pct']); show(mSR,"SENS: + rank percentile")
mSW=fit(SES+RACE+DEMO+['asvab_comp','wealth1985']); show(mSW,"SENS: + wealth 1985")

# MI (m=20) on loginc, mother_grade, father_grade
rng=np.random.default_rng(42); M=20
vars=['loginc','mother_grade','father_grade']
pooled={v:[] for v in vars}; pse={v:[] for v in vars}; pp={v:[] for v in vars}
impX=sm.add_constant(pd.DataFrame({'black':black,'hispanic':hispanic,'sex':sex,'age1979':age,'famsize':fam,'asvab_comp':asv_comp,'grade':y}).fillna(0))
for mi in range(M):
    d=D.copy()
    for var in vars:
        miss=d[var].isna()
        if not miss.any(): continue
        sub=pd.concat([d[var],impX],axis=1).dropna(subset=[var])
        beta=sm.OLS(sub[var],sub[impX.columns]).fit().params
        sd=sub[var].std()
        d.loc[miss,var]=(impX.loc[miss].values@beta.values)+rng.normal(0,sd,miss.sum())
    dd=d[['grade']+SES+RACE+DEMO+['asvab_comp']].dropna()
    mm=sm.OLS(dd['grade'],sm.add_constant(dd[SES+RACE+DEMO+['asvab_comp']])).fit()
    for v in vars:
        pooled[v].append(mm.params[v]); pse[v].append(mm.bse[v]); pp[v].append(mm.pvalues[v])
print("\n### SENS: MI m=20 on income/mother/father grade (Model F), pooled")
for v in vars:
    mp=np.mean(pooled[v]); print(f"  {v:14s} pooled={mp:.4f}  avg_p={np.mean(pp[v]):.4f}")
print("\nDONE")
