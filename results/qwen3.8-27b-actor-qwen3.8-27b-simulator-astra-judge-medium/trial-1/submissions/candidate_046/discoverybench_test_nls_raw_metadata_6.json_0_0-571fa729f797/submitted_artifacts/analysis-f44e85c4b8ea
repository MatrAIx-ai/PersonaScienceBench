# =====================================================================
# Final analysis: BA-track educational progress x race x SES (NLSY79)
# Outcome proxy: 'Highest grade completed, 1979' >= 14 (2+ yrs college
# by ages 14-22). NO real BA-completion variable exists in the dataset.
# SES: tertiles of log1p(total net family income, 1978, recorded 1979).
# ASVAB composite standardized by us: z=(x-mean)/sd; used ONLY in
# sensitivity (measured 1981, i.e., after the 1979 outcome).
# =====================================================================
import pandas as pd, numpy as np
import statsmodels.formula.api as smf
from statsmodels.stats.proportion import proportion_confint

df = pd.read_csv('data/nls_raw.csv')
RACE='Racial/ethnic cohort, 1979'; GRADE='Highest grade completed, 1979'
INC79='Total net family income, previous calendar year, 1979'
INC85='Total net family income, previous calendar year, 1985'
W85='Family net wealth, 1985'
MOM="Highest grade completed by respondent's mother, 1979"
DAD="Highest grade completed by respondent's father, 1979"
race_lbl={1:'Black',2:'Hispanic',3:'Non-Black/Non-Hisp'}

df['grade']=df[GRADE].replace(95,np.nan)          # 95 = 'don't know' code (n=2)
df['college14']=(df['grade']>=14).astype(int)     # primary proxy
df['college13']=(df['grade']>=13).astype(int)
df['college16']=(df['grade']>=16).astype(int)
df['loginc79']=np.log1p(df[INC79].clip(lower=0))  # top-coded 75001 kept
df['SES']=pd.qcut(df['loginc79'],3,labels=['Low','Mid','High'],duplicates='drop')
asv=['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
     'ASVAB - Word Knowledge Z Score (rounded), 1981',
     'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
     'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
a=df[asv].mean(axis=1)
df['asvab_z']=(a-a.mean())/a.std()                 # NOT real z-scores (raw mean ~476)
df['sex_m']=(df['Sex of respondent, 1979']==1).astype(int)
df['age']=df['Age of respondent, 1979']; df['famsize']=df['Family size, 1979']
df['mom_ed']=df[MOM]; df['dad_ed']=df[DAD]
df['black']=(df[RACE]==1).astype(int); df['hisp']=(df[RACE]==2).astype(int)

base=df.dropna(subset=['grade','loginc79','SES']).copy()
print(f'N={len(df)}; analysis sample (grade+income1979): n={len(base)}')

def show(m, terms):
    ci=m.conf_int()
    print(f'  n={int(m.nobs)} pseudoR2={m.prsquared:.4f}')
    for p in terms:
        print(f'  {p:14s} OR={np.exp(m.params[p]):7.3f}  95%CI [{np.exp(ci.loc[p,0]):7.3f}, {np.exp(ci.loc[p,1]):7.3f}]')

print('\n[1] Descriptive % (grade>=14 in 1979) by race x SES, Wilson 95% CI:')
for ses in ['Low','Mid','High']:
    for r in [1,2,3]:
        s=base[(base[RACE]==r)&(base['SES']==ses)]['college14']
        lo,hi=proportion_confint(s.sum(),len(s),method='wilson')
        print(f'  {ses:5s} {race_lbl[r]:20s} {s.mean()*100:5.1f}% [{lo*100:4.1f},{hi*100:4.1f}] (n={len(s)})')

print('\n[2] Primary logistic models (college14):')
m1=smf.logit('college14 ~ black + hisp', base).fit(disp=0); show(m1,['black','hisp'])
m2=smf.logit('college14 ~ black + hisp + loginc79', base).fit(disp=0); show(m2,['black','hisp','loginc79'])
m3=smf.logit('college14 ~ black + hisp + loginc79 + age + sex_m + famsize', base).fit(disp=0)
show(m3,['black','hisp','loginc79','age','sex_m','famsize'])

print('\n[3] M4 race x SES interaction (controls: age, sex, famsize):')
b=base.copy()
b['ses_mid']=(b['SES']=='Mid').astype(int); b['ses_high']=(b['SES']=='High').astype(int)
f='college14 ~ black + hisp + ses_mid + ses_high + black:ses_mid + black:ses_high + hisp:ses_mid + hisp:ses_high + age + sex_m + famsize'
m4=smf.logit(f,b).fit(disp=0); cov=m4.cov_params(); ci=m4.conf_int()
print(f'  n={int(m4.nobs)} pseudoR2={m4.prsquared:.4f}')
for p in ['black','hisp','ses_mid','ses_high','black:ses_mid','black:ses_high','hisp:ses_mid','hisp:ses_high']:
    print(f'  {p:16s} OR={np.exp(m4.params[p]):7.3f}  95%CI [{np.exp(ci.loc[p,0]):7.3f}, {np.exp(ci.loc[p,1]):7.3f}]')
def cell_or(cc):
    idx=list(cc); V=cov.loc[idx,idx].values; c=np.array([cc[k] for k in idx])
    b_=float(c@np.array([m4.params[k] for k in idx])); se=np.sqrt(c@V@c)
    return np.exp(b_), np.exp(b_-1.96*se), np.exp(b_+1.96*se)
print('  Cell ORs vs same-SES Non-Black/Non-Hisp:')
for k,v in {'Black x Low SES':{'black':1},'Black x Mid SES':{'black':1,'black:ses_mid':1},
            'Black x High SES':{'black':1,'black:ses_high':1},
            'Hispanic x Low SES':{'hisp':1},'Hispanic x Mid SES':{'hisp':1,'hisp:ses_mid':1},
            'Hispanic x High SES':{'hisp':1,'hisp:ses_high':1}}.items():
    o,lo,hi=cell_or(v); print(f'  {k:20s} OR={o:6.3f}  95%CI [{lo:6.3f}, {hi:6.3f}]')

print('\n[4] Sensitivity:')
for o in ['college13','college16']:
    mm=smf.logit(f'{o} ~ black + hisp + loginc79 + age + sex_m + famsize', base).fit(disp=0)
    print(f'  outcome {o}:'); show(mm,['black','hisp','loginc79'])
for alt,col in [('INC85',INC85),('W85',W85)]:
    d2=df.dropna(subset=['grade']).copy()
    d2[alt]=pd.qcut(np.log1p(d2[col].clip(lower=0)),3,labels=['Low','Mid','High'],duplicates='drop')
    dd=d2.dropna(subset=[alt]); dd['a_mid']=(dd[alt]=='Mid').astype(int); dd['a_high']=(dd[alt]=='High').astype(int)
    mm=smf.logit('college14 ~ black + hisp + a_mid + a_high + age', dd).fit(disp=0)
    print(f'  SES from {col}:'); show(mm,['black','hisp','a_mid','a_high'])
mm=smf.logit('college14 ~ black + hisp + loginc79 + age + sex_m + famsize + asvab_z',
             base.dropna(subset=['asvab_z'])).fit(disp=0)
print('  ASVAB-adjusted (1981, post-outcome; exploratory only):'); show(mm,['black','hisp','loginc79','asvab_z'])
