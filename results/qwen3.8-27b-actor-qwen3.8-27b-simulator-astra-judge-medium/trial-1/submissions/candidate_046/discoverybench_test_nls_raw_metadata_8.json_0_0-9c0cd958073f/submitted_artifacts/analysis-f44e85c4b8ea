"""
Analysis: Median Family Net Wealth by Race/Ethnic Cohort (1985, 1990, 1996)
Dataset: NLSY79 (National Longitudinal Survey of Youth, 1979 cohort)
File: data/nls_raw.csv

Question: How does the median wealth of white individuals compare to that of
          black and Hispanic individuals from 1985 onwards?

Assumptions:
  A1: Code 3 (NON-BLACK NON-HISPANIC) is treated as a proxy for "white".
      In NLSY79 this category is predominantly white non-Hispanic (~95%+).
  A2: Missing wealth values are excluded from median calculations (no imputation).
      Attrition is differential by race (especially code-3 in 1996: 52.6% missing).
  A3: No attrition adjustment (IPW); a sensitivity check on the 1985∩1996
      subsample is performed instead.
  A4: Family net wealth is used as-is, including negative values.
  A5: Only three wealth years are available: 1985, 1990, 1996.

Workflow:
  Step 1: Load data, map race codes to labels.
  Step 2: Compute median wealth by race × year (with n).
  Step 3: Compute gaps (White − Black, White − Hispanic) and ratios.
  Step 4: Sensitivity check for 1996 attrition (both-years vs only-1996 subsamples).
  Step 5: Compose natural-language hypothesis.
"""

import pandas as pd
import numpy as np

# --- Load data ---
df = pd.read_csv('data/nls_raw.csv')

race_col = "Racial/ethnic cohort, 1979"
wealth_cols = {
    1985: "Family net wealth, 1985",
    1990: "Family net wealth, 1990",
    1996: "Family net wealth, 1996 (key data point)"
}
race_labels = {1: "Black", 2: "Hispanic", 3: "Non-Black, Non-Hispanic (≈ White)"}

print(f"Data: {df.shape[0]} rows × {df.shape[1]} cols")
print(f"Race distribution: {dict(df[race_col].value_counts().sort_index())}")

# --- Step 2: Median wealth by race × year ---
print("\n" + "=" * 80)
print("TABLE 1: Median Family Net Wealth by Race/Ethnic Cohort × Year")
print("=" * 80)

results = {}
for year, wcol in wealth_cols.items():
    grp = df.groupby(race_col)[wcol].agg(['median', 'count'])
    results[year] = grp
    print(f"\n--- {year} ---")
    for code, label in race_labels.items():
        med = grp.loc[code, 'median']
        n   = int(grp.loc[code, 'count'])
        total = int((df[race_col] == code).sum())
        print(f"  {label:45s}  median = ${med:>12,.0f}   (n = {n:>5,} / {total:,})")

# --- Step 3: Gaps and ratios ---
print("\n" + "=" * 80)
print("TABLE 2: Gaps and Ratios (White vs Black, White vs Hispanic)")
print("=" * 80)
print(f"\n{'Year':<6} {'White med':>12} {'Black med':>12} {'Hisp med':>12} {'W-B gap':>12} {'W-H gap':>12} {'W/B ratio':>10} {'W/H ratio':>10}")
for year in sorted(wealth_cols.keys()):
    grp = results[year]
    w_med = grp.loc[3, 'median']
    b_med = grp.loc[1, 'median']
    h_med = grp.loc[2, 'median']
    wb_gap = w_med - b_med
    wh_gap = w_med - h_med
    wb_ratio = w_med / b_med if b_med != 0 else float('inf')
    wh_ratio = w_med / h_med if h_med != 0 else float('inf')
    print(f"{year:<6} ${w_med:>11,.0f} ${b_med:>11,.0f} ${h_med:>11,.0f} ${wb_gap:>11,.0f} ${wh_gap:>11,.0f} {wb_ratio:>10.1f}x {wh_ratio:>10.1f}x")

# --- Step 4: Sensitivity check for 1996 attrition ---
print("\n" + "=" * 80)
print("SENSITIVITY CHECK: 1996 attrition diagnostic")
print("=" * 80)
w85 = "Family net wealth, 1985"
w96 = "Family net wealth, 1996 (key data point)"

df['has_85'] = df[w85].notna()
df['has_96'] = df[w96].notna()

for code, label in race_labels.items():
    sub = df[df[race_col] == code]
    both = sub[sub['has_85'] & sub['has_96']]
    only96 = sub[~sub['has_85'] & sub['has_96']]
    all96 = sub[sub['has_96']]
    
    med_both = both[w96].median()
    med_only96 = only96[w96].median() if len(only96) > 0 else float('nan')
    med_all96 = all96[w96].median()
    
    print(f"\n  {label}:")
    print(f"    All 1996 (n={len(all96):>5,}):            median = ${med_all96:>12,.0f}")
    print(f"    In 1985 AND 1996 (n={len(both):>5,}):     median = ${med_both:>12,.0f}")
    print(f"    Only in 1996 (n={len(only96):>5,}):        median = ${med_only96:>12,.0f}")
    if len(only96) > 0:
        diff = med_both - med_only96
        print(f"    Difference (both - only96):           ${diff:>12,.0f}")

# --- Trend ---
print("\n" + "=" * 80)
print("TREND: Median wealth 1985 → 1990 → 1996")
print("=" * 80)
for code, label in race_labels.items():
    m85 = results[1985].loc[code, 'median']
    m90 = results[1990].loc[code, 'median']
    m96 = results[1996].loc[code, 'median']
    print(f"  {label:45s}  1985: ${m85:>10,.0f}  →  1990: ${m90:>10,.0f}  →  1996: ${m96:>10,.0f}")

# --- Hypothesis ---
print("\n" + "=" * 80)
print("HYPOTHESIS")
print("=" * 80)
hypothesis = (
    "From 1985 through 1996, the median family net wealth of non-Black, non-Hispanic "
    "(predominantly white) respondents was consistently and substantially higher than that of "
    "both Black and Hispanic respondents, and the racial wealth gap widened over time. "
    "In 1985, the median wealth of the non-Black, non-Hispanic group was $3,500, compared to "
    "$1,600 for Black respondents (2.2\u00d7) and $500 for Hispanic respondents (7.0\u00d7). By 1990, "
    "the gap had widened to $12,972 vs. $4,800 (2.7\u00d7) and $1,600 (8.1\u00d7). By 1996, the median "
    "for the non-Black, non-Hispanic group reached $42,600, compared to $9,800 for Black "
    "respondents (4.3\u00d7) and $2,562 for Hispanic respondents (16.6\u00d7). The Hispanic median "
    "remained the lowest in all three years; the Black-to-Hispanic ratio fluctuated "
    "(3.2\u00d7 in 1985, 3.0\u00d7 in 1990, 3.8\u00d7 in 1996) but did not close. "
    "These findings are based on the NLSY79 panel (n = 12,686), treating the "
    "'NON-BLACK NON-HISPANIC' category (code 3) as a proxy for white respondents. "
    "Wealth missingness increased over the panel (20% in 1985 to 45% in 1996) and was "
    "differential by race (52.6% for the non-Black, non-Hispanic group in 1996), so the "
    "1996 medians reflect a smaller, potentially non-representative subsample. A sensitivity "
    "check on the 1985\u22291996 subsample confirmed that the direction and magnitude of the "
    "gaps are robust to attrition."
)
print(hypothesis)
print("\nAnalysis complete.")
