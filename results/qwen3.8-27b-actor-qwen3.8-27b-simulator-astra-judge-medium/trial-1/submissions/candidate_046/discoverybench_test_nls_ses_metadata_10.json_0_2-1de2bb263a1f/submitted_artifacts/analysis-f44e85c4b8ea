import pandas as pd, numpy as np, statsmodels.api as sm
import warnings; warnings.filterwarnings("ignore")
df = pd.read_csv("data/nls_ses_processed.csv"); df["BA"]=df["BA DEGREE COMPLETED"].astype(int)
def z(s): return (s-s.mean())/s.std(ddof=1)
df["SES_z"]=z(df["SES"]); df["AB_z"]=z(df["ABILITY: COMPOSITE OF ASVAB SCORE"]); df["PE_z"]=z(df["PERCENTILE IN CLASS"]); df["FS_z"]=z(df["FAMILY SIZE OF SAMPLE"]); df["Female"]=(df["SAMPLE_SEX"]=="Female").astype(int)
df["Black"]=(df["SAMPLE_RACE"]=="Black").astype(int); df["Hispan"]=(df["SAMPLE_RACE"]=="Hispanic").astype(int)
y=df["BA"].values
def show(label, cols, key, robust=False):
    cov = dict(cov_type="HC1") if robust else {}
    m=sm.Logit(y, sm.add_constant(df[cols])).fit(disp=0, method="newton", **cov)
    b=m.params[key]; p=m.pvalues[key]; ci=m.conf_int().loc[key]
    print(f"{label}: beta={b:+.4f} p={p:.4f} CI[{ci[0]:+.4f},{ci[1]:+.4f}] sig05={p<0.05}")

print("--- STANDARDIZED (SES_z) ---")
show("M1 BA~SES_z            ", ["SES_z"], "SES_z")
show("M2 +race+AB+PE         ", ["SES_z","Black","Hispan","AB_z","PE_z"], "SES_z")
show("M2 robust (HC1)        ", ["SES_z","Black","Hispan","AB_z","PE_z"], "SES_z", robust=True)
print("\n--- RAW log-odds (SES) ---")
show("M1 BA~SES              ", ["SES"], "SES")
show("M2 +race+AB+PE         ", ["SES","Black","Hispan","ABILITY: COMPOSITE OF ASVAB SCORE","PERCENTILE IN CLASS"], "SES")
show("M2 robust (HC1)        ", ["SES","Black","Hispan","ABILITY: COMPOSITE OF ASVAB SCORE","PERCENTILE IN CLASS"], "SES", robust=True)

print("\n--- Sign-flip check (std, M1 -> M2) ---")
cands={"SES":"SES_z","FAMILY":"FS_z","ABILITY":"AB_z","PERCENTILE":"PE_z","SEX":"Female"}
for name,k in cands.items():
    acad=[a for a in ["AB_z","PE_z"] if a!=k]
    m1=sm.Logit(y, sm.add_constant(df[[k]])).fit(disp=0).params[k]
    m2=sm.Logit(y, sm.add_constant(df[[k,"Black","Hispan"]+acad])).fit(disp=0).params[k]
    p2=sm.Logit(y, sm.add_constant(df[[k,"Black","Hispan"]+acad])).fit(disp=0).pvalues[k]
    flip=(m1>0 and m2<0) or (m1<0 and m2>0)
    print(f"  {name:9s}: M1={m1:+.4f} -> M2={m2:+.4f} (p2={p2:.4f})  SIGNFLIP={flip}")
