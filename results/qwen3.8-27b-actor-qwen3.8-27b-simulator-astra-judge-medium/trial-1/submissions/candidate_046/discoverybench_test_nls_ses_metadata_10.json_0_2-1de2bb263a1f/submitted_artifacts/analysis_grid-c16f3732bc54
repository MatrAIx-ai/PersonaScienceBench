import pandas as pd, numpy as np, statsmodels.api as sm, itertools
import warnings; warnings.filterwarnings("ignore")
df = pd.read_csv("data/nls_ses_processed.csv"); df["BA"]=df["BA DEGREE COMPLETED"].astype(int)
def z(s): return (s-s.mean())/s.std(ddof=1)
df["SES_z"]=z(df["SES"]); df["AB_z"]=z(df["ABILITY: COMPOSITE OF ASVAB SCORE"]); df["PE_z"]=z(df["PERCENTILE IN CLASS"]); df["FS_z"]=z(df["FAMILY SIZE OF SAMPLE"])
df["Black"]=(df["SAMPLE_RACE"]=="Black").astype(int); df["Hispan"]=(df["SAMPLE_RACE"]=="Hispanic").astype(int); df["Female"]=(df["SAMPLE_SEX"]=="Female").astype(int)
y=df["BA"].values
t1,t2=0.3636,-0.2293
def run(cols,use_std):
    key="SES_z" if use_std else "SES"
    res=sm.Logit(y, sm.add_constant(df[cols])).fit(disp=0)
    return res.params[key], res.pvalues[key], res.conf_int().loc[key]

print("=== M1 search: BA~SES + extras (standardized & raw) ===")
extras=[[],["Female"],["FS_z"],["Female","FS_z"]]
for e in extras:
    for use_std in [True]:
        cols=(["SES_z"]+e)
        b,p,ci=run(cols,use_std)
        print(f"  extras={e} std: beta={b:+.4f} p={p:.4f} | d1={abs(b-t1):.4f}")
    b,p,ci=run(["SES"]+e,False)
    print(f"  extras={e} raw: beta={b:+.4f} p={p:.4f} | d1={abs(b-t1):.4f}")

print("\n=== M2 search: BA~SES + race + academics + extras (raw & std) ===")
acadsets=[["AB_z"],["PE_z"],["AB_z","PE_z"]]
extras=[[],["Female"],["FS_z"],["Female","FS_z"]]
for ac in acadsets:
    for e in extras:
        for use_std in [True,False]:
            base = "SES_z" if use_std else "SES"
            acs = ac if use_std else [( "ABILITY: COMPOSITE OF ASVAB SCORE" if x=="AB_z" else "PERCENTILE IN CLASS") for x in ac]
            cols=[base,"Black","Hispan"]+acs+e
            b,p,ci=run(cols,use_std)
            tag="std" if use_std else "raw"
            print(f"  acad={ac} extras={e} {tag}: beta={b:+.4f} p={p:.4f} CI[{ci[0]:+.3f},{ci[1]:+.3f}] | d2={abs(b-t2):.4f} sig={p<0.05}")
