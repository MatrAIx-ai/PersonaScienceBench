import pandas as pd, numpy as np, statsmodels.api as sm
import warnings; warnings.filterwarnings("ignore")

df = pd.read_csv("data/nls_ses_processed.csv")
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)

# Standardized versions
def z(s): return (s - s.mean())/s.std()
df["SES_z"] = z(df["SES"])
df["ABILITY_z"] = z(df["ABILITY: COMPOSITE OF ASVAB SCORE"])
df["PERCENTILE_z"] = z(df["PERCENTILE IN CLASS"])
df["FAMILY_z"] = z(df["FAMILY SIZE OF SAMPLE"])
df["Black"] = (df["SAMPLE_RACE"]=="Black").astype(int)
df["Hispanic"] = (df["SAMPLE_RACE"]=="Hispanic").astype(int)
df["Female"] = (df["SAMPLE_SEX"]=="Female").astype(int)

# candidate -> (raw col, standardized col)
cands = {
    "SES": ("SES","SES_z"),
    "FAMILY SIZE": ("FAMILY SIZE OF SAMPLE","FAMILY_z"),
    "SEX": ("SAMPLE_SEX","Female"),  # handle separately
    "ABILITY": ("ABILITY: COMPOSITE OF ASVAB SCORE","ABILITY_z"),
    "PERCENTILE": ("PERCENTILE IN CLASS","PERCENTILE_z"),
}
ACADS = ["ABILITY: COMPOSITE OF ASVAB SCORE","PERCENTILE IN CLASS"]
ACADS_z = ["ABILITY_z","PERCENTILE_z"]
RACE = ["Black","Hispanic"]

def fit(modelspec, y, use_std):
    X = modelspec
    X = sm.add_constant(X)
    try:
        logit = sm.Logit(y, X).fit(disp=0)
        return ("logit", logit)
    except Exception as e:
        return ("err", str(e))

def report(name, Xcol, Xzcol, y):
    print(f"\n######## CANDIDATE X = {name} ########")
    acad = [c for c in ACADS if c != Xcol]
    acad_z = [c for c in ACADS_z if c != Xzcol]
    race = RACE
    # Model 1: BA ~ X ; Model 2: BA ~ X + race + academics
    for tag, use_std in [("RAW(log-odds)", False), ("STANDARDIZED(z)", True)]:
        for model, cols in [("M1", [Xzcol if use_std else Xcol]),
                            ("M2", ([Xzcol if use_std else Xcol] + race + (acad_z if use_std else acad)))]:
            Xd = df[cols].copy()
            res = sm.Logit(y, sm.add_constant(Xd)).fit(disp=0)
            key = Xzcol if use_std else Xcol
            b = res.params[key]
            p = res.pvalues[key]
            ci = res.conf_int().loc[key]
            print(f"  {tag} {model}: beta={b:+.4f}  p={p:.4f}  CI[{ci[0]:+.4f},{ci[1]:+.4f}]")

y = df["BA"].values
report("SES","SES","SES_z", y)
report("FAMILY SIZE","FAMILY SIZE OF SAMPLE","FAMILY_z", y)
report("ABILITY","ABILITY: COMPOSITE OF ASVAB SCORE","ABILITY_z", y)
report("PERCENTILE","PERCENTILE IN CLASS","PERCENTILE_z", y)
# SEX special: X = Female dummy
print("\n######## CANDIDATE X = SEX (Female) ########")
for model, cols in [("M1", ["Female"]),
                    ("M2", ["Female"] + RACE + ACADS_z)]:
    res = sm.Logit(y, sm.add_constant(df[cols])).fit(disp=0)
    b=res.params["Female"]; p=res.pvalues["Female"]; ci=res.conf_int().loc["Female"]
    print(f"  LOGIT {model}: beta={b:+.4f}  p={p:.4f}  CI[{ci[0]:+.4f},{ci[1]:+.4f}]")

# OLS robustness for SES
print("\n######## OLS robustness (SES) ########")
for model, cols in [("M1",["SES_z"]), ("M2",["SES_z"]+RACE+ACADS_z)]:
    res = sm.OLS(y, sm.add_constant(df[cols])).fit()
    b=res.params["SES_z"]; p=res.pvalues["SES_z"]; ci=res.conf_int().loc["SES_z"]
    print(f"  OLS {model} (SES_z): beta={b:+.4f}  p={p:.4f}  CI[{ci[0]:+.4f},{ci[1]:+.4f}]")
