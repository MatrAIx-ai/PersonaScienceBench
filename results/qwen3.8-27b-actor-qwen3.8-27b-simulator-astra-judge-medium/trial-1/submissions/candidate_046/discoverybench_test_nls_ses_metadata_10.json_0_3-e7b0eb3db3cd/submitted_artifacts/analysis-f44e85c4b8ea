"""
DiscoveryBench - NLS SES task
Question: The effect of which variable on BA degree completion decreases from
0.5024 to 0.0923 (while becoming insignificant) when both SES and academic
characteristics are included in analysis?

Approach:
  - Logistic regression (logit), outcome = BA DEGREE COMPLETED (0/1).
  - Base model:  BA ~ X_candidate  (each variable tested as candidate)
  - Full models: BA ~ X_candidate + SES + academic characteristics
      F1: academic characteristics = ABILITY + PERCENTILE (both)
      F2: academic characteristics = ABILITY only
      F3: academic characteristics = PERCENTILE (class rank) only
  - Sensitivity: standardized scales, PERCENTILE as quartiles, subset (female).
"""
import warnings; warnings.filterwarnings('ignore')
import pandas as pd, numpy as np
from statsmodels.formula.api import logit
import statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv')
df = df.rename(columns={'ABILITY: COMPOSITE OF ASVAB SCORE':'ABILITY',
                        'PERCENTILE IN CLASS':'PERCENTILE',
                        'FAMILY SIZE OF SAMPLE':'FAMILY_SIZE'})
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
for c in ['SES','ABILITY','PERCENTILE','FAMILY_SIZE']:
    df[c+'_s'] = (df[c]-df[c].mean())/df[c].std()
df['isBlack'] = (df['SAMPLE_RACE']=='Black').astype(int)
print(f"n={len(df)}, events={int(df.BA.sum())}, base rate={df.BA.mean():.4f}")

def fit(f, data): return logit(f, data=data).fit(disp=0)
def row(m, v):
    b,se,pv = m.params[v], m.bse[v], m.pvalues[v]
    lo,hi = m.conf_int().loc[v]
    return dict(b=b, se=se, ci=(lo,hi), p=pv, orr=np.exp(b))

def dedupe(f):
    rhs = f.split('~',1)[1]
    toks = [t.strip() for t in rhs.split('+') if t.strip()]
    return 'BA ~ ' + ' + '.join(dict.fromkeys(toks))

cands = [('SES','SES','SES'), ('ABILITY','ABILITY','ABILITY'),
         ('PERCENTILE','PERCENTILE','PERCENTILE'), ('FAMILY_SIZE','FAMILY_SIZE','FAMILY_SIZE'),
         ('SES_std','SES_s','SES_s'), ('ABILITY_std','ABILITY_s','ABILITY_s'),
         ('PERCENTILE_std','PERCENTILE_s','PERCENTILE_s'),
         ('SEX(F>M)','C(SAMPLE_SEX)','C(SAMPLE_SEX)[T.Male]'),
         ('RACE_Black','isBlack','isBlack'),
         ('RACE_Hispanic','C(SAMPLE_RACE)','C(SAMPLE_RACE)[T.Hispanic]')]
fulls = {'F1:+SES+ABIL+PERC':' + SES + ABILITY + PERCENTILE',
         'F2:+SES+ABIL':' + SES + ABILITY',
         'F3:+SES+PERC':' + SES + PERCENTILE'}

print("\n" + "="*118)
print(f"{'candidate':<16} {'spec':<18} {'coef':>9} {'SE':>9} {'CI95':>22} {'p':>10} {'OR':>8}")
print("="*118)
for label, bf, coef in cands:
    base = fit(f'BA ~ {bf}', df)
    r0 = row(base, coef)
    print(f"{label:<16} {'BASE':<18} {r0['b']:>9.4f} {r0['se']:>9.4f} [{r0['ci'][0]:>8.4f},{r0['ci'][1]:>8.4f}] {r0['p']:>10.3g} {r0['orr']:>8.3f}")
    for vn, add in fulls.items():
        f = dedupe(f'BA ~ {bf}{add}')
        if f == f'BA ~ {bf}': continue
        try:
            r1 = row(fit(f, df), coef)
            print(f"{'':<16} {vn:<18} {r1['b']:>9.4f} {r1['se']:>9.4f} [{r1['ci'][0]:>8.4f},{r1['ci'][1]:>8.4f}] {r1['p']:>10.3g} {r1['orr']:>8.3f}")
        except Exception: pass
    print('-'*118)

# VIF for full predictor set
X = sm.add_constant(df[['SES','ABILITY','PERCENTILE']].astype(float))
print("\nVIF (SES, ABILITY, PERCENTILE):")
for nm in X.columns[1:]:
    o = [c for c in X.columns if c not in ('const', nm)]
    r2 = sm.OLS(X[nm], X[['const']+o]).fit().rsquared
    print(f"  {nm}: {1/(1-r2):.3f}")

# ---- Sensitivity analyses around the target 0.5024 -> 0.0923 ----
print("\n" + "="*118)
print("SENSITIVITY (candidate = SES):")
b0 = fit('BA ~ SES', df); r0 = row(b0,'SES')
print(f"  base BA~SES:                       b={r0['b']:.4f} SE={r0['se']:.4f} p={r0['p']:.3g}  (target 0.5024)")
m = fit('BA ~ SES + PERCENTILE', df); r = row(m,'SES')
print(f"  full BA~SES+PERCENTILE:            b={r['b']:.4f} SE={r['se']:.4f} CI95 [{r['ci'][0]:.4f},{r['ci'][1]:.4f}] p={r['p']:.3g}  (target 0.0923)")
df['PERC_q'] = pd.qcut(df['PERCENTILE'],4,labels=False,duplicates='drop')
m = fit('BA ~ SES + C(PERC_q)', df); r = row(m,'SES')
print(f"  full BA~SES+PERCENTILE(quartiles): b={r['b']:.4f} SE={r['se']:.4f} CI95 [{r['ci'][0]:.4f},{r['ci'][1]:.4f}] p={r['p']:.3g}")
sub = df[df.SAMPLE_SEX=='Female']
b0f = fit('BA ~ SES', sub); r0f = row(b0f,'SES')
mf = fit('BA ~ SES + PERCENTILE', sub); rf = row(mf,'SES')
print(f"  [subsample females] base:          b={r0f['b']:.4f} SE={r0f['se']:.4f} p={r0f['p']:.3g}")
print(f"  [subsample females] +PERCENTILE:   b={rf['b']:.4f} SE={rf['se']:.4f} CI95 [{rf['ci'][0]:.4f},{rf['ci'][1]:.4f}] p={rf['p']:.3g}")
m = fit('BA ~ SES + ABILITY + PERCENTILE', df); r = row(m,'SES')
print(f"  full BA~SES+ABILITY+PERCENTILE:    b={r['b']:.4f} SE={r['se']:.4f} CI95 [{r['ci'][0]:.4f},{r['ci'][1]:.4f}] p={r['p']:.3g}")
m = fit('BA ~ SES + ABILITY', df); r = row(m,'SES')
print(f"  full BA~SES+ABILITY:               b={r['b']:.4f} SE={r['se']:.4f} CI95 [{r['ci'][0]:.4f},{r['ci'][1]:.4f}] p={r['p']:.3g}")
print("\nTarget pattern (0.5024 sig -> 0.0923 insig) is reproduced ONLY by SES,")
print("best with academic characteristics = class rank (PERCENTILE IN CLASS).")
