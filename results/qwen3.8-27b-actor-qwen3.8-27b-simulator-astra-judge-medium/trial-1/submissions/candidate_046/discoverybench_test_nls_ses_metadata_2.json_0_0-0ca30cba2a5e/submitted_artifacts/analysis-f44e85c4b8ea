"""
Full-workflow analysis for: Is the SES -> BA-degree-completion relation modulated by racial lines?
Data: data/nls_ses_processed.csv  (NLSY79 processed subset)
Workflow:
  M1  logistic BA ~ SES(continuous) * RACE (ref=White), no ability covariates  [total effect]
      -> LR test + joint Wald test of the SES x RACE interaction  (homogeneity of effect)
  Stratification: per-race logistic SES slope + CI; crosstab BA rate by race x SES tercile
      (with event counts); predicted-probability curves vs SES by race
  M2  M1 + SAMPLE_SEX + FAMILY SIZE   [background confounders]
  M3  M1 + ASVAB composite(std) + PERCENTILE IN CLASS(std)  [direct effect / sensitivity]
Firth penalized logistic implemented as fallback / cross-check (no external package available).
"""
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.stats.proportion import proportion_confint
from scipy import stats

pd.set_option("display.width", 200); pd.set_option("display.max_columns", 50)

# ---------------- load & clean ----------------
df = pd.read_csv("data/nls_ses_processed.csv")
df = df.drop(columns=["Unnamed: 0"])
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
N = len(df)
print(f"Loaded N={N}, missing cells={int(df.isna().sum().sum())}")

# standardize continuous predictors (z-scores) so ORs are per +1 SD
for c in ["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS"]:
    df[c+"_z"] = (df[c] - df[c].mean()) / df[c].std()
df["SES_terc"] = pd.qcut(df["SES"], 3, labels=["Low","Mid","High"])

# one-hot race, reference = White
race = pd.get_dummies(df["SAMPLE_RACE"], prefix="R", drop_first=False)
race_black, race_hisp = race["R_Black"], race["R_Hispanic"]
X_base = sm.add_constant(pd.DataFrame({
    "SES_z": df["SES_z"], "Black": race_black, "Hispanic": race_hisp,
    "SES_z:Black": df["SES_z"]*race_black, "SES_z:Hispanic": df["SES_z"]*race_hisp}))
y = df["BA"].values

# ---------------- Firth (bias-reduced) logistic, manual ----------------
def firth_logit(X, y, tol=1e-9, maxit=200):
    X = np.asarray(X, float); y = np.asarray(y, float); n, k = X.shape
    b = np.zeros(k)
    for it in range(maxit):
        xb = X @ b
        p = 1/(1+np.exp(-xb)); p = np.clip(p, 1e-12, 1-1e-12)
        w = p*(1-p)
        I = X.T @ (w[:,None]*X)                 # Fisher info
        Iinv = np.linalg.inv(I)
        M = X @ Iinv @ X.T                       # n x n
        mdiag = np.diag(M)
        resid = (y - p) + 0.5*mdiag*w*(1-2*p)   # Firth modified score residual
        step = Iinv @ (X.T @ resid)
        b = b + step
        if np.max(np.abs(step)) < tol: break
    xb = X @ b; p = 1/(1+np.exp(-xb)); p=np.clip(p,1e-12,1-1e-12)
    w = p*(1-p); I = X.T @ (w[:,None]*X)
    se = np.sqrt(np.diag(np.linalg.inv(I)))
    llf = np.sum(y*np.log(p)+(1-y)*np.log(1-p))
    return b, se, llf, it+1, (it+1<maxit)

def fit_and_report(name, X, y):
    X = X.astype(float)
    m = sm.Logit(y, X).fit(disp=0, maxiter=200)
    conv = bool(m.converged)
    finite_se = bool(np.all(np.isfinite(m.bse)))
    sep = finite_se and (m.bse > 20).any()      # heuristic for separation/degenerate SE
    method = "standard MLE"
    if not (conv and finite_se and not sep):
        b, se, llf, it, ok = firth_logit(X, y)
        method = "Firth (penalized)"
        res = pd.DataFrame({"coef": b, "se": se, "OR": np.exp(b),
                            "lo": np.exp(b-1.96*se), "hi": np.exp(b+1.96*se)}, index=X.columns)
        z = b/se; pval = 2*stats.norm.sf(np.abs(z))
        res["z"]=z; res["p"]=pval
        print(f"\n### {name}  [{method}]  iters={it}")
        print(res.round(3).to_string())
        return res, method, None
    else:
        res = pd.DataFrame({"coef": m.params, "se": m.bse, "OR": np.exp(m.params),
                            "lo": np.exp(m.params-1.96*m.bse), "hi": np.exp(m.params+1.96*m.bse),
                            "z": m.tvalues, "p": m.pvalues}, index=m.params.index)
        print(f"\n### {name}  [{method}]")
        print(res.round(3).to_string())
        return res, method, m

# ================= M1 =================
m1_res, m1_method, m1 = fit_and_report("M1  BA ~ SES_z * RACE (ref=White), no ability covariates", X_base, y)

# interaction test: full vs main-effects-only
X_red = sm.add_constant(pd.DataFrame({"SES_z": df["SES_z"], "Black": race_black, "Hispanic": race_hisp}))
m_red = sm.Logit(y, X_red.astype(float)).fit(disp=0)
LR = 2*(m1.llf - m_red.llf); p_lr = stats.chi2.sf(LR, 2)
print(f"\n--- M1 interaction homogeneity test ---")
print(f"LR test (full vs main-effects), df=2:  LR={LR:.3f}  p={p_lr:.3e}")
R = np.zeros((2, len(m1.params))); R[0, list(m1.params.index).index("SES_z:Black")]=1
R[1, list(m1.params.index).index("SES_z:Hispanic")]=1
wt = m1.wald_test((R, [0, 0]), scalar=True)
print("Wald joint test of (SES_z:Black, SES_z:Hispanic):  chi2=%.3f  p=%.3e" % (wt.statistic, wt.pvalue))

# per-race OR of SES (per +1 SD)
or_white = np.exp(m1.params["SES_z"])
or_black = np.exp(m1.params["SES_z"]+m1.params["SES_z:Black"])
or_hisp  = np.exp(m1.params["SES_z"]+m1.params["SES_z:Hispanic"])
print(f"OR per +1SD SES:  White={or_white:.3f}   Black={or_black:.3f}   Hispanic={or_hisp:.3f}")
print(f"Ratio of ORs (interaction):  Black/White={np.exp(m1.params['SES_z:Black']):.3f}  Hispanic/White={np.exp(m1.params['SES_z:Hispanic']):.3f}")

# ============ stratification: per-race models + crosstab ============
print("\n--- Stratified per-race logistic (BA ~ SES_z) ---")
strat_rows=[]
for r in ["White","Black","Hispanic"]:
    d = df[df["SAMPLE_RACE"]==r]
    Xr = sm.add_constant(d[["SES_z"]])
    mr = sm.Logit(d["BA"], Xr).fit(disp=0)
    orr = np.exp(mr.params["SES_z"]); lo=np.exp(mr.params["SES_z"]-1.96*mr.bse["SES_z"]); hi=np.exp(mr.params["SES_z"]+1.96*mr.bse["SES_z"])
    strat_rows.append({"race":r,"n":len(d),"events":int(d['BA'].sum()),
                       "OR_per_SD":round(orr,3),"CIlo":round(lo,3),"CIhi":round(hi,3),"p":round(mr.pvalues['SES_z'],4)})
strat = pd.DataFrame(strat_rows).set_index("race")
print(strat.to_string())

print("\n--- Crosstab BA rate by RACE x SES tercile (events / n = rate) ---")
def cell(g):
    return f"{int(g['BA'].sum())}/{len(g)} = {g['BA'].mean()*100:.2f}%"
ct = df.groupby(["SAMPLE_RACE","SES_terc"]).apply(cell, include_groups=False)
print(ct.to_string())

# predicted-probability curves vs SES (M1), saved as data (no matplotlib available)
grid = np.linspace(df["SES_z"].min(), df["SES_z"].max(), 25)
curve = pd.DataFrame({"SES_z": grid})
for r,bl,h in [("White",0,0),("Black",1,0),("Hispanic",0,1)]:
    Xg = pd.DataFrame({"const":1,"SES_z":grid,"Black":bl,"Hispanic":h,
                       "SES_z:Black":grid*bl,"SES_z:Hispanic":grid*h})
    curve[f"prob_{r}"] = 1/(1+np.exp(-(Xg.values @ m1.params.values)))
curve.to_csv("artifacts/pred_prob_curves_M1.csv", index=False)
print("\nPredicted P(BA) vs SES (M1) at selected z (saved -> artifacts/pred_prob_curves_M1.csv):")
print(curve.iloc[np.linspace(0,24,9).astype(int)].round(4).to_string())

# ================= M2 =================
X_m2 = X_base.join(pd.DataFrame({
    "Female": (df["SAMPLE_SEX"]=="Female").astype(int),
    "famsize": df["FAMILY SIZE OF SAMPLE"]}, index=X_base.index))
m2_res, m2_method, m2 = fit_and_report("M2  M1 + SEX + FAMILY SIZE", X_m2, y)
X_m2_red = sm.add_constant(pd.DataFrame({"SES_z": df["SES_z"], "Black": race_black, "Hispanic": race_hisp,
    "Female": (df["SAMPLE_SEX"]=="Female").astype(int), "famsize": df["FAMILY SIZE OF SAMPLE"]}))
m2_red = sm.Logit(y, X_m2_red.astype(float)).fit(disp=0)
LR2 = 2*(m2.llf - m2_red.llf); p_lr2 = stats.chi2.sf(LR2, 2)
print(f"M2 interaction LR test df=2: LR={LR2:.3f} p={p_lr2:.3e}")
print(f"M2 interaction ORs (per +1SD): Black/White={np.exp(m2.params['SES_z:Black']):.3f} Hispanic/White={np.exp(m2.params['SES_z:Hispanic']):.3f}")

# ================= M3 =================
X_m3 = X_base.join(pd.DataFrame({
    "ASVAB_z": df["ABILITY: COMPOSITE OF ASVAB SCORE_z"],
    "percentile_z": df["PERCENTILE IN CLASS_z"]}, index=X_base.index))
m3_res, m3_method, m3 = fit_and_report("M3  M1 + ASVAB_z + PERCENTILE_z (direct effect / sensitivity)", X_m3, y)
X_m3_red = sm.add_constant(pd.DataFrame({"SES_z": df["SES_z"], "Black": race_black, "Hispanic": race_hisp,
    "ASVAB_z": df["ABILITY: COMPOSITE OF ASVAB SCORE_z"], "percentile_z": df["PERCENTILE IN CLASS_z"]}))
m3_red = sm.Logit(y, X_m3_red.astype(float)).fit(disp=0)
LR3 = 2*(m3.llf - m3_red.llf); p_lr3 = stats.chi2.sf(LR3, 2)
print(f"M3 interaction LR test df=2: LR={LR3:.3f} p={p_lr3:.3e}")
print(f"M3 interaction ORs (per +1SD): Black/White={np.exp(m3.params['SES_z:Black']):.3f} Hispanic/White={np.exp(m3.params['SES_z:Hispanic']):.3f}")

# Firth cross-check on M1
b,se,llf,it,ok = firth_logit(X_base, y)
print(f"\n--- Firth cross-check (M1) iters={it} ---")
print(pd.DataFrame({"coef":b,"se":se,"OR":np.exp(b),"lo":np.exp(b-1.96*se),"hi":np.exp(b+1.96*se)},index=X_base.columns).round(3).to_string())
ordx=list(X_base.columns)
print("Firth interaction ORs: Black/White=%.3f Hispanic/White=%.3f"%(np.exp(b[ordx.index("SES_z:Black")]),np.exp(b[ordx.index("SES_z:Hispanic")])))

# save summary
with open("artifacts/results_summary.txt","w") as f:
    f.write(f"N={N}\n")
    f.write(f"M1 method={m1_method}\n{m1_res.to_string()}\n")
    f.write(f"M1 LR test df=2: LR={LR:.3f} p={p_lr:.3e}\n")
    f.write(f"M1 Wald joint: chi2={wt.statistic:.3f} p={wt.pvalue:.3e}\n")
    f.write(f"OR per +1SD SES: White={or_white:.3f} Black={or_black:.3f} Hispanic={or_hisp:.3f}\n")
    f.write(f"\nStratified:\n{strat.to_string()}\n\nCrosstab:\n{ct.to_string()}\n")
    f.write(f"\nM2 method={m2_method}\n{m2_res.to_string()}\nM2 LR df=2: {LR2:.3f} p={p_lr2:.3e}\n")
    f.write(f"\nM3 method={m3_method}\n{m3_res.to_string()}\nM3 LR df=2: {LR3:.3f} p={p_lr3:.3e}\n")
print("\nSaved artifacts/results_summary.txt and artifacts/pred_prob_curves_M1.csv")
