"""
NLS SES x Race: where is the Black BA-completion advantage most pronounced?
Workflow: (1) inspection -> (2) descriptive completion tables by SES stratum
(Wilson 95% CIs, Black-White abs gap & Black/White ratio) -> (3) logistic
regression race(Black) x SES interaction (coef + 95% CI), robustness via
binned-SES logit -> (4) interpretation.
Primary 'advantage' definition: absolute Black - White completion-rate gap
within each SES stratum (White = reference); Black/White ratio as robustness.
"""
import warnings, numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.stats.proportion import proportion_confint
warnings.simplefilter('ignore')
pd.set_option('display.width', 220); pd.set_option('display.max_columns', 25)

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['com'] = df['BA DEGREE COMPLETED'].astype(int)

def wilson(k, n):
    return (np.nan, np.nan) if n == 0 else proportion_confint(k, n, method='wilson')

def cell(sub, race):
    s = sub[sub['SAMPLE_RACE'] == race]; n = len(s); k = int(s['com'].sum())
    lo, hi = wilson(k, n)
    return (k / n if n else np.nan, n, k, lo, hi)

def show(title, dfx, col):
    print("\n" + "=" * 100 + "\n" + title + "\n" + "=" * 100)
    rows = []
    for g, sub in dfx.groupby(col, observed=True):
        B, W = cell(sub, 'Black'), cell(sub, 'White')
        rows.append({col: g,
            'Blk%': round(B[0], 4), 'Blk_n': B[1], 'Blk_k': B[2], 'Blk_CI95': f"[{B[3]:.3f},{B[4]:.3f}]",
            'Wht%': round(W[0], 4), 'Wht_n': W[1], 'Wht_k': W[2], 'Wht_CI95': f"[{W[3]:.3f},{W[4]:.3f}]",
            'B-W_abs(pp)': round((B[0] - W[0]) * 100, 2), 'B/W_ratio': round(B[0] / W[0], 3) if W[0] else np.nan})
    return pd.DataFrame(rows).set_index(col)

# (1) inspection
print("=" * 100 + "\nSTEP 1 - INSPECTION\n" + "=" * 100)
print("shape:", df.shape, "| total missing:", int(df.isna().sum().sum()))
print("BA-completed base rate:", round(df['com'].mean(), 4), f"(n_true={int(df['com'].sum())})")
print("SES (continuous, std.): min/med/max =", round(df['SES'].min(), 3), round(df['SES'].median(), 3), round(df['SES'].max(), 3))
print("Race counts:", df['SAMPLE_RACE'].value_counts().to_dict())
print("Global completion by race (pp):", (df.groupby('SAMPLE_RACE')['com'].mean() * 100).round(2).to_dict())
print("ABILITY mean by race:", df.groupby('SAMPLE_RACE')['ABILITY: COMPOSITE OF ASVAB SCORE'].mean().round(0).to_dict())

# (2) descriptive
q3 = df['SES'].quantile([0, 1/3, 2/3, 1.0])
df['SES_ter'] = pd.cut(df['SES'], bins=q3, labels=['Low', 'Mid', 'High'], include_lowest=True)
t_ter = show("STEP 2a - Completion by race x SES TERTILE (rate, n, k, Wilson95; B-W abs gap in pp; B/W ratio)", df, 'SES_ter')
print(t_ter.to_string())
df['SES_dec'] = pd.qcut(df['SES'], 10, labels=[f"D{i}" for i in range(10)], duplicates='drop')
t_dec = show("STEP 2b - Completion by race x SES DECILE (D0=lowest ... D9=highest)", df, 'SES_dec')
print(t_dec.to_string())
print("\nDecile(s) where Black rate >= White rate:", t_dec.index[t_dec['Blk%'] >= t_dec['Wht%']].tolist())
print("Top-decile (D9) SES range:", round(df.loc[df['SES_dec']=='D9','SES'].min(),3), "to", round(df.loc[df['SES_dec']=='D9','SES'].max(),3))

# (3a) logit continuous SES
X = pd.DataFrame({
    'Black': (df['SAMPLE_RACE'] == 'Black').astype(float),
    'Hispanic': (df['SAMPLE_RACE'] == 'Hispanic').astype(float),
    'SES': df['SES'],
    'Black_x_SES': (df['SAMPLE_RACE'] == 'Black').astype(float) * df['SES'],
    'ability': df['ABILITY: COMPOSITE OF ASVAB SCORE'] - df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean(),
    'sex_M': (df['SAMPLE_SEX'] == 'Male').astype(float),
    'fam': df['FAMILY SIZE OF SAMPLE'] - df['FAMILY SIZE OF SAMPLE'].mean()})
X = sm.add_constant(X)
m = sm.Logit(df['com'], X).fit(disp=0); cim = m.conf_int()
print("\n" + "=" * 100 + "\nSTEP 3a - LOGIT (continuous SES, controls: ability, sex, family)\n" + "=" * 100)
print(m.summary2().tables[1].round(4).to_string())
b, pB = m.params['Black_x_SES'], m.params['Black']
print(f"\nINTERACTION Black x SES: coef={b:.4f} se={m.bse['Black_x_SES']:.4f} 95%CI=[{cim.loc['Black_x_SES',0]:.4f},{cim.loc['Black_x_SES',1]:.4f}] p={m.pvalues['Black_x_SES']:.3f}")
print(f"  OR per +1 SES (Black vs White) = {np.exp(b):.3f} [{np.exp(cim.loc['Black_x_SES',0]):.3f},{np.exp(cim.loc['Black_x_SES',1]):.3f}]")
print(f"  Black main effect at SES=0 (adj) = {pB:.4f} (p={m.pvalues['Black']:.3f}) -> SES* where gap=0: {-pB/b:.3f}")

# (3b) binned logit robustness
X2 = pd.DataFrame({'SES_Mid': (df.SES_ter == 'Mid').astype(float), 'SES_High': (df.SES_ter == 'High').astype(float),
                   'Black': (df.SAMPLE_RACE == 'Black').astype(float)})
X2['Mid_x_Black'] = X2.SES_Mid * X2.Black; X2['High_x_Black'] = X2.SES_High * X2.Black
X2['ability'] = df['ABILITY: COMPOSITE OF ASVAB SCORE'] - df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()
X2['sex_M'] = (df.SAMPLE_SEX == 'Male').astype(float); X2 = sm.add_constant(X2)
m2 = sm.Logit(df['com'], X2).fit(disp=0); ci2 = m2.conf_int()
print("\n" + "=" * 100 + "\nSTEP 3b - Binned-SES logit (ref SES=Low), robustness of interaction\n" + "=" * 100)
for term in ['Black', 'SES_High', 'Mid_x_Black', 'High_x_Black']:
    print(f"  {term}: coef={m2.params[term]:.4f} 95%CI=[{ci2.loc[term,0]:.4f},{ci2.loc[term,1]:.4f}] OR={np.exp(m2.params[term]):.3f}")

# (3c) relative boost vs own low-SES baseline
def w(k, n): return proportion_confint(k, n, method='wilson')
base = df[(df.SES_ter == 'Low') & (df.SAMPLE_RACE == 'Black')]['com'].mean()
print("\n" + "=" * 100 + "\nSTEP 3c - Black completion vs its own LOW-SES baseline (relative boost)\n" + "=" * 100)
for g in ['Low', 'Mid', 'High']:
    s = df[(df.SES_ter == g) & (df.SAMPLE_RACE == 'Black')]['com']; k = int(s.sum()); lo, hi = w(k, len(s))
    print(f"  {g}: rate={s.mean():.4f} (n={len(s)}, k={k}) CI=[{lo:.3f},{hi:.3f}]  x{s.mean()/base:.2f} vs Low")
bw = df[(df.SES_ter == 'Low') & (df.SAMPLE_RACE == 'White')]['com'].mean()
print("  (White contrast: Low->High x{:.2f})".format(df[(df.SES_ter == 'High') & (df.SAMPLE_RACE == 'White')]['com'].mean() / bw))

# (4) interpretation
print("\n" + "=" * 100 + "\nSTEP 4 - INTERPRETATION\n" + "=" * 100)
print("Black-White abs gap (pp) by tercile:", t_ter['B-W_abs(pp)'].to_dict())
print("Black-White abs gap (pp) by decile:", t_dec['B-W_abs(pp)'].to_dict())
print("Direction of Black x SES interaction: POSITIVE in both continuous & binned models -> Black-White gap shrinks as SES rises.")
print("=> Advantage most pronounced at HIGH SES (top tercile / top decile D9, SES>~0.95).")
print("Caveat: continuous interaction p=%.2f (CI includes 0); top-decile rests on k=%d (n=%d) -> wide CI." % (
    m.pvalues['Black_x_SES'], int(df[(df.SES_dec == 'D9') & (df.SAMPLE_RACE == 'Black')]['com'].sum()),
    len(df[(df.SES_dec == 'D9') & (df.SAMPLE_RACE == 'Black')])))
