"""
DiscoveryBench - NLS/SES: BA degree completion ~ race (logistic regression)
Question: "Between which two races is the factor of BA degree completion -0.9568
when compared to the other?"

Approach (researcher-approved):
  - Reference category = White
  - Model = UNIVARIATE logistic regression: BA_DEGREE_COMPLETED ~ race
  - -0.9568 interpreted as a LOGIT (log-odds) coefficient
  - No survey weighting (no weight column present)
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

CSV = "data/nls_ses_processed.csv"
TARGET = -0.9568

df = pd.read_csv(CSV)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)

print("="*70)
print("1) INSPECTION")
print("="*70)
n = len(df)
print(f"Observations (n)            : {n}")
print(f"Columns (substantive)       : {[c for c in df.columns if c != 'Unnamed: 0']}")
print(f"Undocumented data columns   : none (8 match datasets.json; 'Unnamed: 0' is a row index)")
print(f"\nSAMPLE_RACE counts (nulls={df['SAMPLE_RACE'].isna().sum()}):")
print(df["SAMPLE_RACE"].value_counts().to_string())
print(f"\nBA DEGREE COMPLETED (nulls={df['BA DEGREE COMPLETED'].isna().sum()}): "
      f"True={int(df['ba'].sum())} ({df['ba'].mean()*100:.2f}%), False={int((1-df['ba']).sum())}")
print("\nBA=1 proportion by race:")
g = df.groupby("SAMPLE_RACE")["ba"].agg(["count", "sum", "mean"])
g["pct"] = (g["mean"] * 100).round(2)
print(g.to_string())
print("\nCross-tab race x BA(0/1):")
print(pd.crosstab(df["SAMPLE_RACE"], df["ba"]).to_string())

print("\n" + "="*70)
print("2) UNIVARIATE LOGIT: ba ~ race  (reference = White)")
print("="*70)
df["c_Black"]    = (df["SAMPLE_RACE"] == "Black").astype(int)
df["c_Hispanic"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)
m = smf.logit("ba ~ c_Black + c_Hispanic", data=df).fit(disp=0, maxiter=200)
print(f"{'term':14s}{'log-odds':>12s}{'OR':>10s}{'p':>12s}")
for name in m.params.index:
    print(f"{name:14s}{m.params[name]:12.6f}{np.exp(m.params[name]):10.4f}{m.pvalues[name]:12.3g}")

# Candidate coefficients (log-odds) vs target
cand = {
    "Hispanic vs White": m.params["c_Hispanic"],
    "Black    vs White": m.params["c_Black"],
}
print(f"\nTarget coefficient               : {TARGET}")
for k, v in cand.items():
    print(f"  {k:22s} coef={v:+.6f}   |diff|={abs(v-TARGET):.4f}")
best = min(cand, key=lambda k: abs(cand[k]-TARGET))
print(f"\nClosest reproducible coefficient : {best} ({cand[best]:+.6f})")

print("\n" + "="*70)
print("3) INTERPRETATION OF -0.9568")
print("="*70)
print(f"exp({TARGET}) = {np.exp(TARGET):.4f}  ->  (OR-1) = {(np.exp(TARGET)-1)*100:.1f}%")
print("=> -0.9568 is a LOGIT (log-odds) coefficient (negative => not an odds ratio).")
print("=> It represents ~62% LOWER odds of completing a BA vs White (univariate).")

print("\n" + "="*70)
print("4) SENSITIVITY / ROBUSTNESS")
print("="*70)
# multivariate (collapses race effects)
df["ses"] = df["SES"]; df["abil"] = df["ABILITY: COMPOSITE OF ASVAB SCORE"]; df["pct"] = df["PERCENTILE IN CLASS"]
mv = smf.logit("ba ~ c_Black + c_Hispanic + ses + abil + pct", data=df).fit(disp=0, maxiter=300)
print(f"Multivariate (+SES,ability,percentile): Black={mv.params['c_Black']:+.4f}, "
      f"Hispanic={mv.params['c_Hispanic']:+.4f}  -> race effects ~0, incompatible with -0.9568")
print("Survey weights: NONE present in dataset -> unweighted model.")

print("\n" + "="*70)
print("CONCLUSION")
print("="*70)
print("The -0.9568 log-odds factor corresponds to the HISPANIC vs WHITE comparison.")
print(f"(reproducible Hispanic-vs-White = {cand['Hispanic vs White']:+.6f}; nearest of the two candidates)")
