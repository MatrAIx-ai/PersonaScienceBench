import pandas as pd, numpy as np

df = pd.read_csv("data/requirements_engineering_for_ML-enabled_systems.csv")
q8 = [c for c in df.columns if c.startswith("Q8_ML_Addressing") and not c.endswith("_Free")]
role = {
 "Q8_ML_Addressing_Project_Lead":"Project Lead",
 "Q8_ML_Addressing_Business_Analyst":"Business Analyst",
 "Q8_ML_Addressing_Requirement_Engineer":"Requirements Engineer",
 "Q8_ML_Addressing_Solution_Architect":"Solution Architect",
 "Q8_ML_Addressing_Data_Scientist":"Data Scientist",
 "Q8_ML_Addressing_Developer":"Developer",
 "Q8_ML_Addressing_Tester":"Tester",
 "Q8_ML_Addressing_Others":"Others",
}
B, SEED = 10000, 42

def boot(arr, B=B, seed=SEED):
    arr = np.asarray(arr, float); n = len(arr)
    idx = np.random.default_rng(seed).integers(0, n, size=(B, n))
    d = arr[idx].mean(axis=1)
    return np.percentile(d, [2.5, 97.5])

def analyze(subset_full, denom_valid, label):
    print(f"\n=== {label} ===")
    rows=[]
    for c in q8:
        s = df[c]
        if denom_valid:
            vals = s[s != "-77"]          # excluye NA
        else:
            vals = s                       # NA conteados como 'no'
        arr = (vals == "quoted").to_numpy(float)
        p = arr.mean(); lo,hi = boot(arr)
        rows.append((role[c], int(arr.sum()), len(arr), p, lo, hi))
    rows.sort(key=lambda x:-x[3])
    for r in rows:
        print(f"{r[0]:22s} quoted={r[1]:3d}/{r[2]:3d}  {r[3]*100:6.3f}%  CI95 [{r[4]*100:.3f}, {r[5]*100:.3f}]")
    return rows

main = analyze(True,  True,  "PRINCIPAL: quoted=sí, -77 excluido, denom válido (194)")
varA = analyze(False, False, "VARIANTE A: denominador 276 (NA como 'no')")
varB = [r for r in main if r[0]!="Others"]
print("\n=== VARIANTE B: principal sin columna Others ===")
for r in varB:
    print(f"{r[0]:22s} {r[3]*100:6.3f}%  CI95 [{r[4]*100:.3f}, {r[5]*100:.3f}]")

print("\n=== Top2 principal ===")
for r in main[:2]:
    print(f"  {r[0]}: {r[3]*100:.3f}% CI95 [{r[4]*100:.3f}, {r[5]*100:.3f}]")

print("\n=== ¿Reproduce el enunciado (49.6% y 61.389%)? ===")
targets=[49.6, 61.389]
for name, rs in [("principal",main),("denom276",varA),("sinOthers",varB)]:
    for t in targets:
        best=min(rs, key=lambda r:abs(r[3]*100-t))
        print(f"{name:10s} target {t:7.3f}% -> mejor {best[0]:20s} {best[3]*100:6.3f}% (diff {abs(best[3]*100-t):.3f})")
