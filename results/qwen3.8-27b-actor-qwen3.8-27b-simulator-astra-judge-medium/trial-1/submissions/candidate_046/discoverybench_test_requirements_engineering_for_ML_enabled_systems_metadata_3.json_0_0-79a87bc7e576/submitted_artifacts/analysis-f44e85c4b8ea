"""
Q9 Elicitation technique usage - requirements engineering for ML-enabled systems.
- Maps '-77' (no-answer block code) to NaN and restricts to respondents with complete Q9.
- Computes 'quoted' (used) proportion per technique.
- Bootstrap (respondent-level, B=10000, seed=42) 95% percentile CI per technique.
- Sensitivity: denominator = all 276 (suspended counted as not used).
"""
import pandas as pd
import numpy as np

SEED = 42
B = 10000
CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"

TECHS = [
    "Q9_ML_Elicitation_Interviews",
    "Q9_ML_Elicitation_Scenarios",
    "Q9_ML_Elicitation_Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings",
    "Q9_ML_Elicitation_Observation",
    "Q9_ML_Elicitation_Others",
]
SHORT = {
    "Q9_ML_Elicitation_Interviews": "Interviews",
    "Q9_ML_Elicitation_Scenarios": "Scenarios",
    "Q9_ML_Elicitation_Prototyping": "Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings": "Workshops/Meetings",
    "Q9_ML_Elicitation_Observation": "Observation",
    "Q9_ML_Elicitation_Others": "Others",
}

df = pd.read_csv(CSV)
n_total = len(df)

# --- Cleaning: '-77' = no answer (block skipped by suspended respondents) ---
q9 = df[TECHS].replace("-77", np.nan)
valid = q9.dropna().reset_index(drop=True)
n_valid = len(valid)
print(f"Total respondents: {n_total}; with complete Q9 (no -77): {n_valid}; excluded: {n_total - n_valid}")

# --- Binary usage indicator: 'quoted' = technique used ---
used = (valid == "quoted").astype(int)
counts = used.sum(axis=0)
pct = 100.0 * counts / n_valid

# --- Respondent-level nonparametric bootstrap, 95% percentile CI ---
rng = np.random.default_rng(SEED)
idx = rng.integers(0, n_valid, size=(B, n_valid))
boot = used.to_numpy()
boot_props = boot[idx].mean(axis=1)  # (B, 6)
ci_lo = 100.0 * np.percentile(boot_props, 2.5, axis=0)
ci_hi = 100.0 * np.percentile(boot_props, 97.5, axis=0)

table = pd.DataFrame({
    "Technique": [SHORT[c] for c in TECHS],
    "Used (quoted)": counts.values,
    "n (valid)": n_valid,
    "Pct used (%)": [round(p, 3) for p in pct.values],
    "CI95 low (%)": [round(x, 3) for x in ci_lo],
    "CI95 high (%)": [round(x, 3) for x in ci_hi],
})
table = table.sort_values("Pct used (%)", ascending=False).reset_index(drop=True)
table["Rank"] = table.index + 1
print("\n=== Q9 elicitation technique usage (n=194, bootstrap B=10000, seed=42, percentile 95% CI) ===")
print(table.to_string(index=False))

winner = table.iloc[0]
print(f"\nWinner: {winner['Technique']} | {winner['Pct used (%)']}% used | 95% CI [{winner['CI95 low (%)']}, {winner['CI95 high (%)']}]")

# --- Sensitivity: denominator = all 276 (suspended/-77 counted as not used) ---
used_all = (df[TECHS] == "quoted").astype(int)
pct_all = 100.0 * used_all.sum(axis=0) / n_total
print("\n--- Sensitivity (denominator 276, -77 as not used) ---")
sens = pd.DataFrame({
    "Technique": [SHORT[c] for c in TECHS],
    "Pct used of 276 (%)": [round(p, 3) for p in pct_all.values],
}).sort_values("Pct used of 276 (%)", ascending=False).reset_index(drop=True)
print(sens.to_string(index=False))
print(f"Ranking with n=276 identical to n=194: {list(sens['Technique']) == list(table['Technique'])}")

# --- Check vs the stated 69.399% [69.062, 69.735] ---
print("\n--- Reproducibility check of stated 69.399% [69.062, 69.735] ---")
print(f"Max pct under n=194: {pct.max():.3f}%; under n=276: {pct_all.max():.3f}%")
print("127/183 = 69.3989% is the only simple fraction matching 69.399%, but no Q9 column has count 127/183.")
print("Stated CI half-width ~0.34 pp is far narrower than a respondent-level bootstrap at n~194 (~6.7 pp),")
print("so the stated figure is not reproducible from this binarized CSV under the tested definitions.")

table.to_csv("q9_usage_table.csv", index=False)
