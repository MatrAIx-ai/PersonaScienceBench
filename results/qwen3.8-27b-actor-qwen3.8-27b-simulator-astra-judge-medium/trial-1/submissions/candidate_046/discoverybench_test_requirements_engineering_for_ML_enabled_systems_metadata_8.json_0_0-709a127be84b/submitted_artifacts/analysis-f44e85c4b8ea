"""
Analysis: least-used documentation formats for ML requirements (Q10).
Data: data/requirements_engineering_for_ML-enabled_systems.csv (276 rows).
Encoding: 'quoted' -> 1, 'not quoted' -> 0, '-77' (or any negative/-99 sentinel) -> NA.
Bootstrap: row (respondent) resampling with replacement, B=10,000, seed=42, percentile 95% CI.
"""
import csv, random
from collections import Counter

PATH = "data/requirements_engineering_for_ML-enabled_systems.csv"
B, SEED = 10000, 42

with open(PATH, newline='') as f:
    r = csv.reader(f)
    header = next(r)
    rows = list(r)

q10 = [i for i, h in enumerate(header) if h.startswith("Q10_ML_Documentation_") and not h.endswith("_Free")]
si, ofi = header.index("Status"), header.index("Q10_ML_Documentation_Others_Free")
names = [header[i].replace("Q10_ML_Documentation_", "") for i in q10]

def val(row, i):
    v = row[i].strip()
    if v in ("", "-77") or (v.lstrip("-").isdigit() and int(v) < 0):
        return None          # NA / sentinel
    return 1 if v == "quoted" else 0

# ---- subsets -------------------------------------------------------------
allrows = rows
valid   = [row for row in allrows if val(row, q10[0]) is not None]                      # n=194
comp    = [row for row in allrows if row[si] in ("Completed (31)", "Completed after break (32)")]  # n=188
comp_only = [row for row in allrows if row[si] == "Completed (31)"]                      # n=164

def props(subset, d, others_free_text=False):
    out = {}
    for k, i in enumerate(q10):
        c = 0
        for row in subset:
            v = val(row, i)
            if v == 1:
                if others_free_text and names[k] == "Others" and row[ofi].strip() in ("", "-99", "-66"):
                    continue
                c += 1
        out[names[k]] = (c, c / d * 100)
    return out

# ---- bootstrap -----------------------------------------------------------
def bootstrap(subset, B=B, seed=SEED):
    rng = random.Random(seed)
    n = len(subset)
    # binary matrix: n x 12 (None -> 0 in resample only if row excluded; rows are pre-filtered valid)
    M = [[val(row, i) or 0 for i in q10] for row in subset]
    dists = {names[k]: [] for k in range(len(q10))}
    for _ in range(B):
        idx = [rng.randrange(n) for _ in range(n)]
        for k in range(len(q10)):
            dists[names[k]].append(sum(M[j][k] for j in idx) / n * 100)
    ci = {}
    for k in range(len(q10)):
        s = sorted(dists[names[k]])
        ci[names[k]] = (s[int(0.025 * B)], s[int(0.975 * B)])
    return ci

ci194 = bootstrap(valid)

# ---- results -------------------------------------------------------------
p194 = props(valid, len(valid))
rank = sorted(p194.items(), key=lambda kv: kv[1][1])

print(f"n_primary(valid Q10 respondents) = {len(valid)}")
print(f"n_sensitivity: completed* = {len(comp)}, completed only = {len(comp_only)}, all rows = {len(allrows)}")
print(f"{'Format':<22}{'n=194':>10}{'95% CI [lo,hi]':>24}{'d=276':>10}{'d=188':>10}{'d=164':>10}")
p276, p188, p164 = props(allrows, 276), props(comp, len(comp)), props(comp_only, len(comp_only))
for name, (c, pct) in rank:
    lo, hi = ci194[name]
    print(f"{name:<22}{pct:>9.3f}%{f'[{lo:.3f}, {hi:.3f}]':>24}{p276[name][1]:>9.3f}%{p188[name][1]:>9.3f}%{p164[name][1]:>9.3f}%")

# free-text-adjusted Others
po = props(valid, len(valid), others_free_text=True)
print(f"\nOthers with free-text criterion: {po['Others'][0]}/194 = {po['Others'][1]:.3f}%  (vs MLCanvas {p194['MLCanvas'][1]:.3f}%)")
lo, hi = ci194['BDD_Scenarios']; print(f"BDD_Scenarios  : 4/194 = {p194['BDD_Scenarios'][1]:.3f}%  CI [{lo:.3f}, {hi:.3f}]")
lo, hi = ci194['MLCanvas'];      print(f"MLCanvas       : 15/194 = {p194['MLCanvas'][1]:.3f}%  CI [{lo:.3f}, {hi:.3f}]")
lo, hi = ci194['Others'];        print(f"Others (plain) : 15/194 = {p194['Others'][1]:.3f}%  CI [{lo:.3f}, {hi:.3f}]")

# save table
with open("q10_results.csv", "w", newline='') as f:
    w = csv.writer(f)
    w.writerow(["format", "count_n194", "pct_n194", "ci_lo", "ci_hi", "pct_d276", "pct_d188", "pct_d164"])
    for name, (c, pct) in rank:
        lo, hi = ci194[name]
        w.writerow([name, c, f"{pct:.3f}", f"{lo:.3f}", f"{hi:.3f}", f"{p276[name][1]:.3f}", f"{p188[name][1]:.3f}", f"{p164[name][1]:.3f}"])
print("\nwrote q10_results.csv")
