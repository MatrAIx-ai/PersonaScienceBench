import csv, statistics, math

CSV='data/worldbank_education_gdp.csv'
with open(CSV, newline='') as f:
    reader = csv.DictReader(f)
    rows = list(reader)
years = [c for c in reader.fieldnames if c.startswith(('19','20'))]
def yr(c): return int(c.split('[')[0].strip())

# ---- reshape wide -> long ----
def series(code, group):
    for r in rows:
        if r['Series Code']==code and r['Country Code']==group:
            return r
    return None

EDU='NY.ADJ.AEDU.GN.ZS'   # education expenditure (% GNI)
GNI='NY.GNP.PCAP.KD'      # per capita GDP (GNI per capita const 2015 USD)

def build(group):
    a=series(EDU,group); b=series(GNI,group)
    d={}
    for c in years:
        va=a[c].strip(); vb=b[c].strip()
        if va and vb:
            d[yr(c)]=(float(va),float(vb))  # (edu, gni)
    return d

def ols(xs,ys):
    n=len(xs)
    mx,my=sum(xs)/n,sum(ys)/n
    sxy=sum((x-mx)*(y-my) for x,y in zip(xs,ys))
    sxx=sum((x-mx)**2 for x in xs)
    slope=sxy/sxx; intercept=my-slope*mx
    # r2
    ss_res=sum((y-(intercept+slope*x))**2 for x,y in zip(xs,ys))
    ss_tot=sum((y-my)**2 for y in ys)
    r2=1-ss_res/ss_tot if ss_tot else float('nan')
    return slope, intercept, r2

def corr(xs,ys):
    n=len(xs); mx,my=sum(xs)/n,sum(ys)/n
    cov=sum((x-mx)*(y-my) for x,y in zip(xs,ys))
    sx=(sum((x-mx)**2 for x in xs))**.5; sy=(sum((y-my)**2 for y in ys))**.5
    return cov/(sx*sy)

print("="*70)
print("ANALISIS: gasto educacion vs PIB per capita, por grupo")
print("="*70)
results={}
for g in ['LMC','SSF']:
    d=build(g)
    ys=sorted(d)
    edus=[d[y][0] for y in ys]; gnis=[d[y][1] for y in ys]
    print(f"\n### GRUPO {g}  (n={len(ys)}, {ys[0]}–{ys[-1]})")
    # descriptive
    print(f"  Gasto educacion: min={min(edus):.3f}  max={max(edus):.3f}  "
          f"ini={edus[0]:.3f}  fin={edus[-1]:.3f}  (delta={edus[-1]-edus[0]:+.3f} p.p.)")
    print(f"  PIB per capita: min={min(gnis):.1f}  max={max(gnis):.1f}  "
          f"ini={gnis[0]:.1f}  fin={gnis[-1]:.1f}  (delta={gnis[-1]-gnis[0]:+,.1f})")
    print(f"  Correlacion cruda (edu, gni): r={corr(edus,gnis):+.3f}")
    # OLS levels
    sl,ic,r2=ols(edus,gnis)
    print(f"  OLS niveles:  GNI = {ic:.1f} + ({sl:.1f})*edu   R2={r2:.3f}")
    # first-difference (growth)
    d_edu=[edus[i]-edus[i-1] for i in range(1,len(edus))]
    d_gni=[gnis[i]-gnis[i-1] for i in range(1,len(gnis))]
    sl2,ic2,r22=ols(d_edu,d_gni)
    print(f"  OLS 1er dif.: dGNI = {ic2:.2f} + ({sl2:.1f})*dEdu  R2={r22:.3f}  (n={len(d_edu)})")
    results[g]=dict(n=len(ys), r=corr(edus,gnis),
                    levels=(sl,ic,r2), fdiff=(sl2,ic2,r22),
                    edu_delta=edus[-1]-edus[0], gni_delta=gnis[-1]-gnis[0])

print("\n"+"="*70)
print("COMPARACION")
print("="*70)
for g in ['LMC','SSF']:
    r=results[g]
    print(f"{g}: r_cruda={r['r']:+.3f} | OLS niveles pendiente={r['levels'][0]:+.1f} (R2={r['levels'][2]:.3f}) "
          f"| OLS 1er-dif pendiente={r['fdiff'][0]:+.1f} (R2={r['fdiff'][2]:.3f})")
