"""
Final analysis: How does age influence the likelihood of withdrawing more money
from savings than putting in?  Outcome = DISSAVED (1 = net dissaver).
NLSY79, 1989 cross-section. Association only (no causal claims).
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

pd.set_option('display.width', 200)
df = pd.read_csv("data/nls_bmi_processed.csv")

# ---------- derived variables ----------
age_mean = df['AGE'].mean()
df['AGE_c']  = df['AGE'] - age_mean          # centered age (kills AGE/AGE_2 collinearity)
df['AGE2_c'] = df['AGE_c']**2                # centered quadratic
df['LOGINC'] = np.log1p(df['INCOME'])        # tame right skew + zeros
df['MALE']   = (df['GENDER'] == 'MALE').astype(int)
bmi_cap = df['BMI'].quantile(0.99)
df['BMI_w'] = df['BMI'].clip(upper=bmi_cap)  # winsorized BMI for sensitivity
y = df['DISSAVED']

def fit(cols, bmi='BMI'):
    X = df[cols].copy()
    if 'BMI' in cols:
        X['BMI'] = df[bmi]
    X = sm.add_constant(X)
    return sm.Logit(y, X).fit(disp=0), X

def show(m, label):
    b=m.params; ci=m.conf_int()
    t=pd.DataFrame({'coef':b,'OR':np.exp(b),'OR_lo':np.exp(ci[0]),
                    'OR_hi':np.exp(ci[1]),'z':m.tvalues,'p':m.pvalues})
    print(f"\n===== {label} =====")
    print(t.round(4).to_string()); print(f"Pseudo R2={m.prsquared:.4f}")
    return t

covs     = ['AGE_c','AGE2_c','LOGINC','BMI','MALE','BLACK','HISPANIC']
covs_noinc = ['AGE_c','AGE2_c','BMI','MALE','BLACK','HISPANIC']

# (i) headline (with income) & no-income sensitivity & BMI-winsorized sensitivity
head, Xh = fit(covs, 'BMI');       show(head, "HEADLINE (with INCOME, quadratic age, raw BMI)")
noinc, _ = fit(covs_noinc, 'BMI'); show(noinc, "SENSITIVITY (no INCOME)")
headw, _ = fit(covs, 'BMI_w');     show(headw, "SENSITIVITY (BMI winsorized @99th pct)")

# (ii) average marginal effect of +1 yr age (finite difference, recompute quadratic)
p0 = head.predict(Xh)
Xd = Xh.copy(); Xd['AGE_c'] += 1; Xd['AGE2_c'] = (df['AGE_c']+1)**2
p1 = head.predict(Xd)
ame  = (p1-p0).mean()
print(f"\n[ME] Avg marginal effect of +1 yr AGE on P(DISSAVED=1) [headline] = {ame:.5f}")
print(f"[ME] Per 5-yr increment = {5*ame:.5f}")

# (iii) predicted P at ages 24,28,32 at mean covariates
exog_order = list(Xh.columns)
mc = {'AGE_c':0.0,'AGE2_c':0.0,'LOGINC':df['LOGINC'].mean(),'BMI':df['BMI'].mean(),
      'MALE':df['MALE'].mean(),'BLACK':df['BLACK'].mean(),'HISPANIC':df['HISPANIC'].mean()}
print("\n[PRED] P(DISSAVED=1) at mean covariates:")
for a in [24,28,32]:
    v={'AGE_c':a-age_mean,'AGE2_c':(a-age_mean)**2}
    v.update({k:mc[k] for k in mc if k not in v})
    exog=np.array([[1.0]+[v[c] for c in exog_order[1:]]])
    print(f"  age {a}: {head.predict(exog)[0]:.4f}")

# (iv) non-parametric per-age observed rates
print("\n[NONPARAM] Observed DISSAVED rate by age:")
print(df.groupby('AGE')['DISSAVED'].agg(['count','mean']).round(4).to_string())

# (v) quadratic-vs-linear Wald test
w = head.wald_test("AGE2_c = 0", scalar=True)
print(f"\n[WALD] AGE2_c = 0 (quadratic term): chi2={w.statistic:.3f}, p={w.pvalue:.4f}")

# (vi) supplementary SAMESAVE-conditional estimand
sub = df[df['SAMESAVE']==0]
print(f"\n[SUPPL] P(DISSAVED=1 | SAMESAVE=0) = {sub['DISSAVED'].mean():.4f}  (n={len(sub)})")
print(f"[SUPPL] P(DISSAVED=1) full sample   = {df['DISSAVED'].mean():.4f}  (n={len(df)})")
Xs = sm.add_constant(sub[['AGE_c','AGE2_c','LOGINC','BMI','MALE','BLACK','HISPANIC']])
ms = sm.Logit(sub['DISSAVED'], Xs).fit(disp=0)
print(f"[SUPPL] conditional logistic: AGE_c coef={ms.params['AGE_c']:.4f} (p={ms.pvalues['AGE_c']:.3f}), pseudoR2={ms.prsquared:.4f}")

# VIF (centered)
Xv = df[['AGE_c','AGE2_c','LOGINC','BMI','MALE','BLACK','HISPANIC']]
vifs = {c: round(variance_inflation_factor(Xv.values,i),2) for i,c in enumerate(Xv.columns)}
print(f"\n[VIF] {vifs}")

# save summary
with open('results_summary.txt','w') as f:
    f.write("HEADLINE: DISSAVED ~ AGE_c + AGE2_c + LOGINC + BMI + MALE + BLACK + HISPANIC (n=12686)\n")
    f.write(str(show.__wrapped__ if hasattr(show,'__wrapped__') else '') )
    f.write(str(pd.DataFrame({'coef':head.params,'OR':np.exp(head.params),
        'p':head.pvalues}).round(4))+"\n")
    f.write(f"Pseudo R2={head.prsquared:.4f}\n")
    f.write(f"AME(+1yr AGE)={ame:.5f}; per5yr={5*ame:.5f}\n")
    f.write(f"Wald AGE2_c=0: chi2={w.statistic:.3f} p={w.pvalue:.4f}\n")
    f.write(f"no-income AGE_c coef={noinc.params['AGE_c']:.4f} (p={noinc.pvalues['AGE_c']:.3f})\n")
    f.write(f"Supplementary P(DISSAVED=1|SAMESAVE=0)={sub['DISSAVED'].mean():.4f}\n")
    f.write(f"VIF={vifs}\n")
print("\nwrote results_summary.txt")
