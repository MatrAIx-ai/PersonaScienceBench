"""
Analysis: Does increased time preference (proxy: 1989 savings behavior) associate with higher BMI?
Data: NLSY79 (data/nls_raw.csv).
BMI = 703 * weight_1989(lb) / height_1985(in)^2   (units corrected: weight is pounds, height inches)
Time-preference proxy: categorical savings 1989, ordinal score 1(put in, most patient)->4(no savings, least patient).
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
import warnings; warnings.filterwarnings("ignore")

df = pd.read_csv("data/nls_raw.csv")
rename={"Weight of respondent, 1989":"W89","Height of respondent, 1985":"H85",
 "Was more money put into or taken out of R/spouse savings since last interview, 1989":"SAV",
 "Sex of respondent, 1979":"SEX","Racial/ethnic cohort, 1979":"RACE",
 "Family size, 1979":"FAM","Age of respondent at interview date, 1989":"AGE89",
 "Total net family income, previous calendar year, 1985":"INC85",
 "Type of residence respondent is living in, 1989":"RES89",
 "Weight of respondent, 1981":"W81","Weight of respondent, 1992":"W92"}
df=df.rename(columns=rename)
W89="W89"; H85="H85"; SAV="SAV"; SEX="SEX"; RACE="RACE"; FAM="FAM"
AGE89="AGE89"; INC85="INC85"; RES89="RES89"

print("="*70)
print("1) SAMPLE CONSTRUCTION")
print("="*70)
base = df[[W89,H85,SAV,SEX,RACE,FAM,AGE89,INC85,RES89]].copy()
base["bmi"] = 703*base[W89]/base[H85]**2
# trim extreme BMI outliers (measurement error): keep 12-60
n_all = len(base)
base = base[base["bmi"].between(12,60)].copy()
print(f"Rows with weight1989+height1985+savings1989 (any BMI): {n_all}")
print(f"Rows after BMI plausibility trim (12<=BMI<=60): {len(base)}")

# covariates
base["male"] = (base[SEX]==1).astype(int)
base["race_black"] = (base[RACE]==1).astype(int)
base["race_hisp"]  = (base[RACE]==2).astype(int)
base["res_own"] = (base[RES89]==11).astype(int)
base["tp_score"] = base[SAV]                      # 1..4 ordinal
base["tp_bin"] = (base[SAV].isin([2,4])).astype(int)  # 1 = less patient (took out / no savings)
base["saver"]  = (base[SAV]==1).astype(int)

X_cols = ["male","race_black","race_hisp","AGE89","FAM","INC85","res_own"]

# complete-case sample
cc = base.dropna(subset=["bmi","tp_score"]+X_cols).copy()
print(f"Complete-case analysis sample: {len(cc)}")

print("\n" + "="*70)
print("2) DESCRIPTIVE: BMI BY SAVINGS CATEGORY (unadjusted)")
print("="*70)
cat_lab={1:"1 Put more in (most patient)",2:"2 Took more out",3:"3 No change",4:"4 No savings (least patient)"}
desc = cc.groupby("tp_score")["bmi"].agg(["count","mean","std","median"])
desc.index=[f"{int(i)}: {cat_lab[i]}" for i in desc.index]
print(desc.round(2))

print("\n" + "="*70)
print("3) PRIMARY MODEL: OLS  BMI ~ tp_score + covariates  (complete cases)")
print("="*70)
X = sm.add_constant(cc[["tp_score"]+X_cols])
m1 = sm.OLS(cc["bmi"], X).fit(cov_type="HC1")
print(m1.summary().tables[1])
b=m1.params["tp_score"]; se=m1.bse["tp_score"]; p=m1.pvalues["tp_score"]
lo,hi = m1.conf_int().loc["tp_score"]
print(f"\nInterpretation: each +1 step toward LESS patient (higher time preference)")
print(f"  -> BMI change = {b:.3f} (95% CI {lo:.3f} to {hi:.3f}, p={p:.4f})")
print(f"  Full 1->4 range (3 steps) = {3*b:.3f} BMI units")

print("\n" + "="*70)
print("4) ROBUSTNESS A: binary  BMI ~ (less patient: took out/no savings) + covariates")
print("="*70)
Xb = sm.add_constant(cc[["tp_bin"]+X_cols])
mb = sm.OLS(cc["bmi"], Xb).fit(cov_type="HC1")
print(mb.summary().tables[1])
bb=mb.params["tp_bin"]; pb=mb.pvalues["tp_bin"]; lob,hib=mb.conf_int().loc["tp_bin"]
print(f"Binary: less-patient vs put-in  BMI diff = {bb:.3f} (95% CI {lob:.3f}-{hib:.3f}, p={pb:.4f})")

print("\n" + "="*70)
print("5) ROBUSTNESS B: no covariates (raw)  BMI ~ tp_score")
print("="*70)
mr = sm.OLS(cc["bmi"], sm.add_constant(cc[["tp_score"]])).fit()
br=mr.params["tp_score"]; pr=mr.pvalues["tp_score"]
print(f"Raw slope = {br:.3f} (p={pr:.4f})")

print("\n" + "="*70)
print("6) SENSITIVITY: multiple imputation (m=10, regression+residual noise)")
print("="*70)
def impute_cc(missing_rows, full, target, predictors, rng):
    """Impute target in missing_rows using OLS on full rows where target present."""
    train = full.dropna(subset=[target]+predictors)
    Xtr = sm.add_constant(train[predictors]); ytr=train[target]
    betas=sm.OLS(ytr,Xtr).fit().params
    resid = (ytr - Xtr@betas).std()
    Xmi = missing_rows[predictors].copy().reset_index(drop=True)
    Xmi.insert(0, "const", 1.0)
    Xmi = Xmi[Xtr.columns]
    pred = Xmi.values @ betas.values
    return pred + rng.normal(0, resid, size=len(missing_rows))

rng=np.random.default_rng(42)
imp_targets = ["AGE89","INC85"]   # the two incomplete covariates
imp_preds = ["male","race_black","race_hisp","FAM","res_own","tp_score"]
coefs=[]; 
for mi in range(10):
    d = base.copy()
    for t in imp_targets:
        idx = d.index[d[t].isna()]
        if len(idx):
            d.loc[idx, t] = impute_cc(d.loc[idx], d, t, imp_preds, rng)
    d = d.dropna(subset=["bmi","tp_score"]+X_cols)
    Xim = sm.add_constant(d[["tp_score"]+X_cols])
    fim = sm.OLS(d["bmi"], Xim).fit(cov_type="HC1")
    coefs.append(fim.params["tp_score"])
coefs=np.array(coefs)
print(f"MI (m=10) slope on tp_score: mean={coefs.mean():.3f}  SD={coefs.std():.3f}  range=[{coefs.min():.3f},{coefs.max():.3f}]")
# pooled approx
print(f"MI 95% CI approx: {coefs.mean()-1.96*coefs.std():.3f} to {coefs.mean()+1.96*coefs.std():.3f}")

print("\n" + "="*70)
print("7) SELECTION BIAS DOCUMENTATION (increasing weight missingness)")
print("="*70)
for w,y in [("W81","1981"),("W89","1989"),("W92","1992")]:
    print(f"Weight {y}: missing {df[w].isna().mean()*100:.1f}%")
print("Note: 1989 sample (used for BMI) is NOT a random subsample of the full cohort;")
print("attrition grows with age, so findings are conditional on being observed in 1989.")

print("\n" + "="*70)
print("SUMMARY NUMBERS")
print("="*70)
print(f"Analysis N (complete cases) = {len(cc)}")
print(f"Primary adjusted slope (per +1 less-patient step): {b:.3f} BMI units, 95% CI [{lo:.3f},{hi:.3f}], p={p:.4f}")
print(f"Full 1->4 effect: {3*b:.3f} BMI units")
print(f"Binary less-patient vs put-in: {bb:.3f} (p={pb:.4f})")
print(f"Raw slope: {br:.3f} (p={pr:.4f})")
print(f"MI slope: {coefs.mean():.3f} (SD {coefs.std():.3f})")
