#!/usr/bin/env python3
"""
Sparse/Noisy Compact-Star Sequence Reconstruction
Reconstructs a physically self-consistent white-dwarf sequence from sparse
noisy mass-radius observations and partially-missing internal profile
fragments, then predicts holdout values.
"""
import numpy as np, pandas as pd, json, os, zlib, struct

mr = pd.read_csv("data/mr_observations.csv")
pf = pd.read_csv("data/profile_fragments.csv")
qt = json.load(open("data/query_targets.json"))
os.makedirs("results", exist_ok=True)

M_obs = mr["mass_solar_obs"].values
R_obs = mr["radius_km_obs"].values
sig_R = mr["sigma_radius_km"].values
query_masses = np.array(qt["mr_eval_masses_solar"])
target_masses = np.array(qt["profile_target_masses_solar"])
radius_grid = np.array(qt["radius_fraction_grid"])

# 1. MR: weighted cubic WLS
A = np.column_stack([np.ones_like(M_obs), M_obs, M_obs**2, M_obs**3])
w = 1.0/sig_R; W = np.diag(w**2)
c = np.linalg.solve(A.T @ W @ A, A.T @ W @ R_obs)
def R_of_M(M):
    M = np.asarray(M, float)
    return c[0] + c[1]*M + c[2]*M**2 + c[3]*M**3

Rf = R_of_M(M_obs); res = R_obs - Rf
chi2 = np.sum((res/sig_R)**2); dof = len(M_obs)-4
print(f"[MR] coef={c}")
print(f"[MR] chi2={chi2:.2f}, dof={dof}, chi2/dof={chi2/dof:.3f}")
print(f"[MR] max|resid|/sig={np.max(np.abs(res)/sig_R):.3f}")

roots = np.roots([c[3], c[2], c[1], c[0]])
rr = roots[np.abs(roots.imag)<1e-8].real
mass_limit = float(np.max(rr[rr>0]))
print(f"[MR] mass_limit={mass_limit:.6f}")
Mc = np.linspace(0.25, mass_limit*0.999, 1000)
print(f"[MR] monotonic={np.all(np.diff(R_of_M(Mc))<0)}")

query_radii = R_of_M(query_masses)
pd.DataFrame({"mass_solar": query_masses, "radius_km": query_radii}).to_csv("results/mr_reconstruction.csv", index=False)
print(f"[MR] wrote mr_reconstruction.csv ({len(query_masses)} rows)")

# 2. Profiles: basis expansion with BCs built in
# g(x,M)=(1-x)*(1+x*P(x,M))  -> g(0)=1, g(1)=0
# f(x,M)=x*(1+(1-x)*Q(x,M))  -> f(0)=0, f(1)=1
K, J = 4, 3; NP = K*J
dr, mr2 = [], []
for _, r in pf.iterrows():
    x, M = r["radius_fraction"], r["target_mass_solar"]
    if not pd.isna(r["density_fraction_obs"]):
        dr.append((x, M, r["density_fraction_obs"], r["sigma_density_fraction"]))
    if not pd.isna(r["enclosed_mass_fraction_obs"]):
        mr2.append((x, M, r["enclosed_mass_fraction_obs"], r["sigma_enclosed_mass_fraction"]))
da = np.array(dr); ma = np.array(mr2)
print(f"[PROF] n_dens={len(da)}, n_mass={len(ma)}")

def bld(x, M, ch):
    A_ = np.zeros((len(x), NP))
    for i in range(len(x)):
        for k in range(K):
            for j in range(J):
                A_[i,k*J+j] = ((1-x[i])*x[i] if ch==0 else x[i]*(1-x[i])) * x[i]**k * M[i]**j
    return A_

Ad = bld(da[:,0], da[:,1], 0); Am = bld(ma[:,0], ma[:,1], 1)
td = da[:,2]-(1-da[:,0]); tm = ma[:,2]-ma[:,0]

def wls(A_, y, s):
    w_ = 1.0/s; W_ = np.diag(w_**2)
    return np.linalg.solve(A_.T @ W_ @ A_, A_.T @ W_ @ y)

cd_ = wls(Ad, td, da[:,3]); cm_ = wls(Am, tm, ma[:,3])

def gv(x, M, co):
    x = np.asarray(x, float); M = np.asarray(M, float)
    P = np.zeros_like(x)
    for k in range(K):
        for j in range(J):
            P += co[k*J+j]*x**k*M**j
    return (1-x)*(1+x*P)

def fv(x, M, co):
    x = np.asarray(x, float); M = np.asarray(M, float)
    Q = np.zeros_like(x)
    for k in range(K):
        for j in range(J):
            Q += co[k*J+j]*x**k*M**j
    return x*(1+(1-x)*Q)

gf = gv(da[:,0], da[:,1], cd_); rg = da[:,2]-gf
cf = np.sum((rg/da[:,3])**2); dg = len(da)-NP
print(f"[PROF] dens chi2={cf:.2f} dof={dg} chi2/dof={cf/dg:.3f} maxr={np.max(np.abs(rg)/da[:,3]):.3f}")
ff = fv(ma[:,0], ma[:,1], cm_); rf = ma[:,2]-ff
cf2 = np.sum((rf/ma[:,3])**2); df2 = len(ma)-NP
print(f"[PROF] mass chi2={cf2:.2f} dof={df2} chi2/dof={cf2/df2:.3f} maxr={np.max(np.abs(rf)/ma[:,3]):.3f}")

def enforce_mono_decreasing(v):
    """Enforce v is non-increasing (for density)."""
    v = v.copy()
    for i in range(1, len(v)):
        if v[i] > v[i-1] + 1e-15:
            v[i] = v[i-1]
    return v

def enforce_mono_increasing(v):
    """Enforce v is non-decreasing (for mass fraction)."""
    v = v.copy()
    for i in range(1, len(v)):
        if v[i] < v[i-1] - 1e-15:
            v[i] = v[i-1]
    return v

dp = np.zeros((len(target_masses), len(radius_grid)))
mp_ = np.zeros((len(target_masses), len(radius_grid)))
for i, Mt in enumerate(target_masses):
    g_raw = np.clip(gv(radius_grid, Mt, cd_), 0, 1)
    f_raw = np.clip(fv(radius_grid, Mt, cm_), 0, 1)
    # Enforce monotonicity
    g_mono = enforce_mono_decreasing(g_raw)
    f_mono = enforce_mono_increasing(f_raw)
    # Restore exact boundary conditions
    g_mono[0] = 1.0; g_mono[-1] = 0.0
    f_mono[0] = 0.0; f_mono[-1] = 1.0
    dp[i] = g_mono; mp_[i] = f_mono
    ng = np.max(np.abs(g_mono - g_raw)); nf = np.max(np.abs(f_mono - f_raw))
    print(f"[PROF] M={Mt}: g_mono={np.all(np.diff(dp[i])<=0)}, f_mono={np.all(np.diff(mp_[i])>=0)}, "
          f"max_correction g={ng:.6f} f={nf:.6f}")

np.savez("results/profiles_reconstruction.npz",
         density_fraction=dp, enclosed_mass_fraction=mp_,
         radius_fraction=radius_grid, target_masses_solar=target_masses)
print(f"[PROF] wrote npz ({dp.shape}, {mp_.shape})")

# 3. Summary
smry = {
    "mass_limit_solar": round(mass_limit, 6),
    "radius_at_0p6Msun_km": round(float(R_of_M(0.6)), 3),
    "radius_at_1p0Msun_km": round(float(R_of_M(1.0)), 3),
    "radius_at_1p2Msun_km": round(float(R_of_M(1.2)), 3),
    "radius_at_1p3Msun_km": round(float(R_of_M(1.3)), 3),
}
json.dump(smry, open("results/summary.json","w"), indent=2)
print(f"[SUM] {json.dumps(smry, indent=2)}")

# 4. Plot (minimal PNG, no matplotlib)
def _crc(d): return zlib.crc32(d) & 0xFFFFFFFF
def _ch(t, d):
    c = struct.pack('>I',len(d))+t+d
    return c+struct.pack('>I',_crc(t+d))
def wpng(fn, img):
    h,w,_ = img.shape
    raw = b''.join(b'\x00'+img[r].tobytes() for r in range(h))
    with open(fn,'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n')
        f.write(_ch(b'IHDR',struct.pack('>IIBBBBB',w,h,8,2,0,0,0)))
        f.write(_ch(b'IDAT',zlib.compress(raw,9)))
        f.write(_ch(b'IEND',b''))

def dline(img,x0,y0,x1,y1,col,th=2):
    h,w = img.shape[:2]
    dx,dy = abs(x1-x0),abs(y1-y0)
    sx,sy = (1 if x0<x1 else -1),(1 if y0<y1 else -1)
    err,dx2,dy2 = dx-dy,dx,dy
    hf = max(th//2,0)
    while True:
        for ex in range(-hf,hf+1):
            for ey in range(-hf,hf+1):
                px,py = x0+ex,y0+ey
                if 0<=px<w and 0<=py<h: img[py,px]=col
        if x0==x1 and y0==y1: break
        e2=2*err
        if e2>-dy2: err-=dy2; x0+=sx
        if e2<dx2: err+=dx2; y0+=sy

def ddot(img,x,y,col,r=3):
    h,w = img.shape[:2]
    for dy in range(-r,r+1):
        for dx in range(-r,r+1):
            if dx*dx+dy*dy<=r*r:
                px,py=x+dx,y+dy
                if 0<=px<w and 0<=py<h: img[py,px]=col

Wp,Hp = 1400,600
img = np.full((Hp,Wp,3),255,dtype=np.uint8)
blk,gr = (0,0,0),(200,200,200)
blu,rd,gn = (31,119,180),(214,39,40),(44,160,44)
mg2,gap2 = 60,30
pw = (Wp-2*mg2-gap2)//2; ph = Hp-2*mg2
px0,py0 = mg2,mg2; px1,py1 = mg2+pw,mg2+ph
dline(img,px0,py1,px1,py1,blk,2); dline(img,px0,py0,px0,py1,blk,2)
Mmn,Mmx = 0.2,mass_limit*1.02; Rmn,Rmx = 0,R_obs.max()*1.1
def m2p(M,R):
    x=px0+int((M-Mmn)/(Mmx-Mmn)*(px1-px0-10))
    y=py1-int((R-Rmn)/(Rmx-Rmn)*(py1-py0-10))
    return max(px0,min(px1-1,x)),max(py0,min(py1-1,y))
for Mg in np.arange(0.5,Mmx,0.5):
    x,_=m2p(Mg,0); dline(img,x,py0,x,py1,gr,1)
for Rg in np.arange(2000,Rmx,2500):
    _,y=m2p(0,Rg); dline(img,px0,y,px1,y,gr,1)
Mf2 = np.linspace(0.25,mass_limit*0.999,300); Rf2 = R_of_M(Mf2)
for i in range(len(Mf2)-1):
    x0,y0=m2p(Mf2[i],Rf2[i]); x1,y1=m2p(Mf2[i+1],Rf2[i+1])
    dline(img,x0,y0,x1,y1,blu,2)
for i in range(len(M_obs)):
    x,y=m2p(M_obs[i],R_obs[i])
    yt=py1-int((R_obs[i]+sig_R[i]-Rmn)/(Rmx-Rmn)*(py1-py0-10))
    yb=py1-int((R_obs[i]-sig_R[i]-Rmn)/(Rmx-Rmn)*(py1-py0-10))
    dline(img,x,max(py0,yt),x,min(py1,yb),rd,1); ddot(img,x,y,rd,3)
xml,_=m2p(mass_limit,0); dline(img,xml,py0,xml,py1,(255,0,0),1)
qx0=mg2+pw+gap2; qx1=qx0+pw; qy0,qy1=py0,py1
dline(img,qx0,qy1,qx1,qy1,blk,2); dline(img,qx0,qy0,qx0,qy1,blk,2)
for xg in np.arange(0.2,1.0,0.2):
    x=qx0+int(xg*(qx1-qx0-10)); dline(img,x,qy0,x,qy1,gr,1)
for yg in np.arange(0.2,1.0,0.2):
    y=qy1-int(yg*(qy1-qy0-10)); dline(img,qx0,y,qx1,y,gr,1)
def p2p(xf,v):
    x=qx0+int(xf*(qx1-qx0-10)); y=qy1-int(v*(qy1-qy0-10))
    return max(qx0,min(qx1-1,x)),max(qy0,min(qy1-1,y))
cols=[blu,gn,rd]
for i in range(len(target_masses)):
    col=cols[i]
    for j in range(len(radius_grid)-1):
        x0,y0=p2p(radius_grid[j],dp[i,j]); x1,y1=p2p(radius_grid[j+1],dp[i,j+1])
        dline(img,x0,y0,x1,y1,col,2)
    for j in range(0,len(radius_grid)-1,2):
        x0,y0=p2p(radius_grid[j],mp_[i,j])
        x1,y1=p2p(radius_grid[min(j+1,len(radius_grid)-1)],mp_[i,min(j+1,len(radius_grid)-1)])
        dline(img,x0,y0,x1,y1,col,1)
wpng("results/reconstruction_plot.png", img)
print("[PLOT] wrote results/reconstruction_plot.png")
print("\n=== ALL OUTPUTS WRITTEN ===")
