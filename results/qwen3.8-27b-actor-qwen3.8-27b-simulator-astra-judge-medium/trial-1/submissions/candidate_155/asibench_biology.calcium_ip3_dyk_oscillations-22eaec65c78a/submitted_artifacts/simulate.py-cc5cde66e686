def _png_fallback(traces, po_traces, summary):
    import zlib, struct
    W, H = 1200, 900
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    BLACK=(0,0,0); BLUE=(31,119,180); ORANGE=(255,127,14); GREEN=(44,160,44); RED=(214,39,40)
    def put(x,y,c):
        x=int(x); y=int(y)
        if 0<=x<W and 0<=y<H: img[y,x]=c
    def line(x0,y0,x1,y1,c):
        x0,y0,x1,y1=int(x0),int(y0),int(x1),int(y1)
        dx=abs(x1-x0); dy=-abs(y1-y0); sx=1 if x0<x1 else -1; sy=1 if y0<y1 else -1
        err=dx+dy
        while True:
            put(x0,y0,c)
            if x0==x1 and y0==y1: break
            e2=2*err
            if e2>=dy: err+=dy; x0+=sx
            if e2<=dx: err+=dx; y0+=sy
    def text(x,y,s,c,sc=2):
        x0=x
        for ch in s:
            g=_FONT.get(ch)
            if g is None:
                x0+=6*sc; continue
            for r in range(7):
                row=g[r]
                for cc in range(5):
                    if row & (1<<(4-cc)):
                        for a in range(sc):
                            for b in range(sc):
                                put(x0+cc*sc+a, y+r*sc+b, c)
            x0+=6*sc
    def panel(px,py,pw,ph,title,xs,ys,xlab,color):
        line(px,py,px+pw,py,BLACK); line(px+pw,py,px+pw,py+ph,BLACK)
        line(px+pw,py+ph,px,py+ph,BLACK); line(px,py+ph,px,py,BLACK)
        text(px+6,py+6,title,BLACK)
        text(px+6,py+ph-16,xlab,BLACK)
        pts=[(float(x),float(y)) for x,y in zip(xs,ys) if y is not None and np.isfinite(float(y))]
        if len(pts)>=2:
            xmin=min(p[0] for p in pts); xmax=max(p[0] for p in pts)
            ymin=min(p[1] for p in pts); ymax=max(p[1] for p in pts)
            if xmax==xmin: xmax=xmin+1
            if ymax==ymin: ymax=ymin+1
            L=70; B=34; R=24; T=34
            def X(v): return px+L+(v-xmin)/(xmax-xmin)*(pw-L-R)
            def Y(v): return py+ph-B-(v-ymin)/(ymax-ymin)*(ph-B-T)
            prev=None
            for xv,yv in pts:
                p=(X(xv),Y(yv))
                if prev is not None: line(prev[0],prev[1],p[0],p[1],color)
                put(p[0],p[1],color)
                prev=p
    jmax=len(channel_counts)-1; cr_idx=summary["cr_ip3_idx_used"]
    t=np.arange(n_samples)*dt_out
    key="ip3%d_N%d"%(2,jmax)
    panel(40,70,540,360,"Ca cyt trace (IP3=%.3g,N=%d)"%(ip3_levels[2],channel_counts[jmax]),
          t,traces[key][0],"t (s)",BLUE)
    panel(620,70,540,360,"Period vs IP3 (N=%d)"%channel_counts[jmax],
          ip3_levels,summary["period_vs_ip3"],"IP3 (uM)",ORANGE)
    panel(40,470,540,360,"CV of ISI vs N (IP3 idx=%d)"%cr_idx,
          channel_counts,summary["cv_isi_vs_N"],"N (channels)",GREEN)
    panel(620,470,540,360,"Popen vs IP3 (N=%d)"%channel_counts[jmax],
          ip3_levels,summary["p_open_vs_ip3"],"IP3 (uM)",RED)
    raw=b''
    for y in range(H):
        raw+=b'\x00'+img[y].tobytes()
    comp=zlib.compress(raw,9)
    def chunk(tag,data):
        return struct.pack(">I",len(data))+tag+data+struct.pack(">I",zlib.crc32(tag+data)&0xffffffff)
    ihdr=struct.pack(">IIBBBBB",W,H,8,2,0,0,0)
    png=b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',ihdr)+chunk(b'IDAT',comp)+chunk(b'IEND',b'')
    with open("calcium_summary.png","wb") as f:
        f.write(png)

def main():
    print("Running stochastic sweep: %d IP3 x %d N x %d replicates, T=%g s"
          % (len(ip3_levels), len(channel_counts), n_rep, T_obs))
    traces, po_traces, cons_errors = run_sweep()
    summary = compute_summary(traces, po_traces, cons_errors)
    np.savez("ca_traces.npz", **traces)
    with open("summary_stats.json", "w") as f:
        json.dump(summary, f, indent=2)
    backend = make_figure(traces, po_traces, summary)
    print("Wrote ca_traces.npz (%d keys), summary_stats.json, calcium_summary.png [%s]"
          % (len(traces), backend))
    print("summary_stats.json:")
    print(json.dumps(summary, indent=2))

if __name__ == "__main__":
    main()
