"""Directed, signed GRN inference. Convention: inferred_network[i,j] = strength of gene j's
influence on gene i. in-degree = row count, out-degree = col count of nonzero topology."""
import json
import numpy as np

ts = np.load("data/expression_timeseries.npy")          # (5, 50, 25)
ps = np.load("data/perturbation_steady_states.npy")     # (16, 25)
info = json.load(open("data/system_info.json"))
n_rep, n_t, n_g = ts.shape
assert n_g == 25

def method_ode(ts, lam=1.0):
    A_list, r2_list = [], []
    for r in range(n_rep):
        X = ts[r]
        dX = np.gradient(X, axis=0)
        D = np.hstack([np.ones((n_t, 1)), X])           # (50, 26)
        A_r = np.zeros((n_g, n_g)); r2s = np.zeros(n_g)
        for i in range(n_g):
            y = dX[:, i]
            coef = np.linalg.solve(D.T @ D + lam * np.eye(D.shape[1]), D.T @ y)
            A_r[i, :] = coef[1:]
            pred = D @ coef
            ss_tot = float(np.sum((y - y.mean()) ** 2))
            r2s[i] = 1.0 - float(np.sum((y - pred) ** 2)) / ss_tot if ss_tot > 0 else 0.0
        A_list.append(A_r); r2_list.append(r2s)
    A_ode = np.mean(A_list, axis=0)
    stab = []
    for i in range(n_g):
        rows = np.stack([a[i] for a in A_list]); c = np.corrcoef(rows)
        stab.append(float(np.nanmean(np.abs(c[~np.eye(n_rep, dtype=bool)]))))
    np.fill_diagonal(A_ode, 0.0)
    return A_ode, {"mean_r2": float(np.mean(r2_list)), "stability": float(np.mean(stab))}

A_ode, m1 = method_ode(ts)

def method_sem(ps, lam=1.0):
    P = (ps - ps.mean(axis=0)) / (ps.std(axis=0) + 1e-12)
    n = P.shape[0]
    coef = np.zeros((n_g, n_g)); r2 = np.zeros(n_g)
    for i in range(n_g):
        others = [j for j in range(n_g) if j != i]
        X = P[:, others]; y = P[:, i]
        Xd = np.hstack([np.ones((n, 1)), X])
        c = np.linalg.solve(Xd.T @ Xd + lam * np.eye(Xd.shape[1]), Xd.T @ y)
        pred = Xd @ c
        ss_tot = float(np.sum((y - y.mean()) ** 2))
        r2[i] = 1.0 - float(np.sum((y - pred) ** 2)) / ss_tot if ss_tot > 0 else 0.0
        for k, j in enumerate(others):
            coef[i, j] = c[1 + k]
    W = np.zeros((n_g, n_g))
    for i in range(n_g):
        for j in range(i + 1, n_g):
            if r2[i] >= r2[j]:
                W[i, j] = coef[i, j]
            else:
                W[j, i] = coef[j, i]
    ret = W != 0
    np.fill_diagonal(W, 0.0)
    return W, {"mean_r2": float(np.mean(r2)),
               "mean_abs_std_coef": float(np.mean(np.abs(W[ret]))) if ret.any() else 0.0}

W_sem, m2 = method_sem(ps)

def zscore_offdiag(M):
    Z = np.zeros_like(M, dtype=float); off = M[~np.eye(n_g, dtype=bool)]
    Z[~np.eye(n_g, dtype=bool)] = (off - off.mean()) / (off.std() + 1e-12)
    np.fill_diagonal(Z, 0.0); return Z

combined = 0.6 * zscore_offdiag(A_ode) + 0.4 * zscore_offdiag(W_sem)
np.fill_diagonal(combined, 0.0)
off_mask = ~np.eye(n_g, dtype=bool); n_off = off_mask.sum()
k_edges = int(round(0.20 * n_off))
mag = np.abs(combined); vals = mag[off_mask]
thr = np.sort(vals)[::-1][k_edges - 1]
keep = off_mask & (mag >= thr)
density = keep.sum() / n_off
if not (0.05 <= density <= 0.40):
    thr = np.quantile(vals, 0.85); keep = off_mask & (mag >= thr); density = keep.sum() / n_off
network = np.where(keep, combined, 0.0).astype(np.float64)
np.fill_diagonal(network, 0.0)
assert np.isfinite(network).all()
signs = np.zeros((n_g, n_g), dtype=np.float64)
signs[keep & (network > 0)] = 1.0; signs[keep & (network < 0)] = -1.0
np.fill_diagonal(signs, 0.0)
assert np.all(signs[network == 0] == 0) and np.isfinite(signs).all()

nonzero = network != 0; np.fill_diagonal(nonzero, False)
in_deg = nonzero.sum(axis=1).astype(int)
out_deg = nonzero.sum(axis=0).astype(int)
n_edges = int(nonzero.sum())
out_weight = np.abs(network).sum(axis=0)
order = sorted(range(n_g), key=lambda g: (-out_deg[g], -out_weight[g]))
hubs = [int(order[0]), int(order[1])]

metrics = {
    "n_genes": n_g, "n_edges": n_edges, "density": float(density),
    "off_diagonal_density": float(density),
    "in_degree": {"mean": float(in_deg.mean()), "max": int(in_deg.max()),
                  "min": int(in_deg.min()), "values": in_deg.tolist()},
    "out_degree": {"mean": float(out_deg.mean()), "max": int(out_deg.max()),
                   "min": int(out_deg.min()), "values": out_deg.tolist()},
    "convention": "[i,j] = influence of gene j on gene i; in-degree=row sum, out-degree=col sum of nonzero topology",
}

method_comparison = {"methods": [
    {"name": "Method 1 - dynamic linear ODE regression",
     "family": "continuous-time linear dynamical system / ODE-based GRN inference",
     "data": "time-course (5 replicates x 50 time points)",
     "description": "Model dX_i/dt = b_i + sum_j A_ij X_j per target gene i; dX/dt by central finite differences, ridge fit per replicate, A averaged over the 5 replicates. A_ij (row=target, col=source) gives direction and sign directly.",
     "mean_r2": round(m1["mean_r2"], 4), "stability": round(m1["stability"], 4),
     "strengths": "Direction and sign are inherent to the ODE; exploits rich temporal dynamics; denoised by averaging 5 consistent replicates.",
     "limitations": "Assumes a linear ODE; finite-difference dX/dt on 50 points amplifies noise; 25 predictors with only 50 samples is tight."},
    {"name": "Method 2 - steady-state linear SEM (regression-based DAG)",
     "family": "cross-sectional linear structural equation model / regression-based DAG",
     "data": "steady-state perturbations (16 conditions, 1 sample each)",
     "description": "Standardize the 16 steady states; regress each gene on all other genes; sign = sign(coef); each pair oriented by regression asymmetry (higher R2 = target). Perturbation rows treated as undocumented MULTI-target interventions (assumption, not confirmed).",
     "mean_r2": round(m2["mean_r2"], 4), "weight": round(m2["mean_abs_std_coef"], 4),
     "strengths": "Independent of the dynamic ODE family; uses the steady-state perturbation data directly; gives a signed directed graph.",
     "limitations": "GENUINELY UNDERPOWERED: only 16 samples for 25 nodes, so coefficients are noisy and edges weakly identified; the multi-target reading is an assumption. Weighted less (0.4 vs 0.6) in the combination."},
],
 "combination": "z-score each method's off-diagonal weights; combined = 0.6*z_ODE + 0.4*z_SEM so the time-course method dominates on disagreement; threshold to ~20% off-diagonal density."}

np.save("inferred_network.npy", network)
np.save("edge_sign_predictions.npy", signs)
json.dump({"hub_genes": hubs}, open("hub_genes.json", "w"), indent=2)
json.dump(method_comparison, open("method_comparison.json", "w"), indent=2)
json.dump(metrics, open("network_metrics.json", "w"), indent=2)

print("=== FINAL REPORT ===")
print("off-diagonal nonzero density:", round(density, 4), "->", n_edges, "edges /", n_off)
print("hubs (out-degree):", hubs, "out-degrees:", [int(out_deg[hubs[0]]), int(out_deg[hubs[1]])])
print("out-degree vector:", out_deg.tolist())
print("in-degree vector :", in_deg.tolist())
print("Method1 mean_r2=%.4f stability=%.4f" % (m1["mean_r2"], m1["stability"]))
print("Method2 mean_r2=%.4f mean|coef|=%.4f" % (m2["mean_r2"], m2["mean_abs_std_coef"]))
print("\nTop-20 edges by |combined| (source -> target, sign):")
idx = np.dstack(np.where(keep))[0]
order2 = sorted(idx, key=lambda p: -abs(network[p[0], p[1]]))
for t, s in order2[:20]:
    print("  %2d -> %2d   w=%+.4f  sign=%d" % (s, t, network[t, s], int(signs[t, s])))
print("\nNaN/Inf network:", not np.isfinite(network).all(), " signs:", not np.isfinite(signs).all())
print("sign==0 wherever network==0:", bool(np.all(signs[network == 0] == 0)))
