def _draw_text(img, x, y, s, color, scale=2):
    for ch in s:
        g = _FONT.get(ch, _FONT[" "])
        for ry, row in enumerate(g.split()):
            for rx, bit in enumerate(row):
                if bit == "1":
                    y0, x0 = y + ry * scale, x + rx * scale
                    img[y0:y0 + scale, x0:x0 + scale] = color

def _text_w(s, scale=2):
    return len(s) * 6 * scale - scale

def _hv_rgb(t):
    """simple hue->rgb colormap, t in [0,1]"""
    t = np.clip(np.asarray(t, dtype=float), 0, 1)
    h = (t * 5.0 + 0.25) % 1.0
    r = 1.0 - np.minimum(6.0 * h, np.minimum(12.0 - 6.0 * h, 2.0))
    g = 1.0 - np.minimum(6.0 * h, np.minimum(12.0 - 6.0 * h, 2.0))
    r = 1.0 - np.minimum(6.0 * ((h + 0.3333) % 1.0), np.minimum(12.0 - 6.0 * ((h + 0.3333) % 1.0), 2.0))
    g = 1.0 - np.minimum(6.0 * ((h + 0.6667) % 1.0), np.minimum(12.0 - 6.0 * ((h + 0.6667) % 1.0), 2.0))
    b = 1.0 - np.minimum(6.0 * h, np.minimum(12.0 - 6.0 * h, 2.0))
    return np.clip(np.stack([r, g, b], axis=-1) * 255, 0, 255).astype(int)

def _make_figure_fallback():
    W, H = 1400, 1000
    img = np.full((H, W, 3), 255, dtype=int)
    black = (30, 30, 30)
    panels = [(40, 40, 640, 430), (720, 40, 640, 430), (40, 520, 640, 430), (720, 520, 640, 430)]
    titles = ["FINAL CONFIGURATION (LOWEST T)", "Q HISTOGRAMS PER T",
              "HEAT CAPACITY C(T) - MBAR + DIRECT", "FREE ENERGY PROFILE F(Q) AT T* NEAR"]
    for (px, py, pw, ph), title in zip(panels, titles):
        img[py:py + ph, px:px + pw] = 255
        for c in range(pw):
            img[py, px + c] = black; img[py + ph - 1, px + c] = black
        for r in range(ph):
            img[py + r, px] = black; img[py + r, px + pw - 1] = black
        _draw_text(img, px + (pw - _text_w(title)) // 2, py + 8, title, black, 2)
        # plot rect
        ax0, ay0, ax1, ay1 = px + 55, py + 45, px + pw - 15, py + ph - 45
        _bresenham(img, ax0, ay0, ax1, ay0, black)
        _bresenham(img, ax0, ay0, ax0, ay1, black)
    def X(v, v0, v1, ax0, ax1):
        if v1 == v0:
            return (ax0 + ax1) / 2
        return ax0 + (v - v0) / (v1 - v0) * (ax1 - ax0)
    def Y(v, v0, v1, ay0, ay1):
        if v1 == v0:
            return (ay0 + ay1) / 2
        return ay1 - (v - v0) / (v1 - v0) * (ay1 - ay0)
    # panel A: final configuration 2D projection
    px, py, pw, ph = panels[0]
    ax0, ay0, ax1, ay1 = px + 55, py + 45, px + pw - 15, py + ph - 45
    xs, ys = final_coords[:, 0], final_coords[:, 1]
    x0, x1, y0, y1 = xs.min() - 1, xs.max() + 1, ys.min() - 1, ys.max() + 1
    for i in range(N - 1):
        _bresenham(img, X(xs[i], x0, x1, ax0, ax1), Y(ys[i], y0, y1, ay0, ay1),
                   X(xs[i + 1], x0, x1, ax0, ax1), Y(ys[i + 1], y0, y1, ay0, ay1), (80, 80, 80))
    for i in range(N):
        cx = int(X(xs[i], x0, x1, ax0, ax1)); cy = int(Y(ys[i], y0, y1, ay0, ay1))
        col = _hv_rgb(i / max(N - 1, 1))[0]
        img[cy - 4:cy + 5, cx - 4:cx + 5] = col
    _draw_text(img, px + 260, py + ph - 28, "BEAD INDEX: BLUE -> RED", black, 1)
    # panel B: Q histograms per T
    px, py, pw, ph = panels[1]
    ax0, ay0, ax1, ay1 = px + 55, py + 45, px + pw - 15, py + ph - 45
    dens = Qhist / (centers[1] - centers[0])
    dmax = dens.max() * 1.05
    for k in range(K):
        col = (int(200 - 180 * k / (K - 1)), 60, int(200 * k / (K - 1)))
        for i in range(len(centers) - 1):
            _bresenham(img, X(centers[i], 0, 1, ax0, ax1), Y(dens[k, i], 0, dmax, ay0, ay1),
                       X(centers[i + 1], 0, 1, ax0, ax1), Y(dens[k, i + 1], 0, dmax, ay0, ay1), col)
        _draw_text(img, ax1 - 150, ay0 + 8 + 12 * k, f"T={temps[k]:.3f}", col, 1)
    _draw_text(img, px + pw // 2 - 8, py + ph - 28, "Q", black, 2)
    # panel C: C(T)
    px, py, pw, ph = panels[2]
    ax0, ay0, ax1, ay1 = px + 55, py + 45, px + pw - 15, py + ph - 45
    cmax = max(C_fine.max(), C_direct.max()) * 1.08
    t0, t1 = T_fine[0], T_fine[-1]
    for i in range(len(T_fine) - 1):
        _bresenham(img, X(T_fine[i], t0, t1, ax0, ax1), Y(C_fine[i], 0, cmax, ay0, ay1),
                   X(T_fine[i + 1], t0, t1, ax0, ax1), Y(C_fine[i + 1], 0, cmax, ay0, ay1), (30, 100, 200))
    for k in range(K):
        cx = int(X(temps[k], t0, t1, ax0, ax1)); cy = int(Y(C_direct[k], 0, cmax, ay0, ay1))
        img[cy - 3:cy + 4, cx - 3:cx + 4] = (20, 20, 20)
    tx = int(X(T_star, t0, t1, ax0, ax1))
    for r in range(ay0, ay1, 6):
        img[r:r + 3, tx] = (200, 30, 30)
    _draw_text(img, px + pw // 2 - 8, py + ph - 28, "T", black, 2)
    _draw_text(img, px + 12, ay0 + 8, f"T*={T_star:.3f}", (200, 30, 30), 1)
    # panel D: F(Q)
    px, py, pw, ph = panels[3]
    ax0, ay0, ax1, ay1 = px + 55, py + 45, px + pw - 15, py + ph - 45
    fmax = F.max() * 1.08
    for i in range(len(centers) - 1):
        _bresenham(img, X(centers[i], 0, 1, ax0, ax1), Y(F[i], 0, fmax, ay0, ay1),
                   X(centers[i + 1], 0, 1, ax0, ax1), Y(F[i + 1], 0, fmax, ay0, ay1), (30, 60, 160))
    for m in mode_locations:
        mx = int(X(m, 0, 1, ax0, ax1))
        for r in range(ay0, ay1, 6):
            img[r:r + 3, mx] = (200, 30, 30)
    _draw_text(img, px + pw // 2 - 8, py + ph - 28, "Q", black, 2)
    _draw_text(img, px + 12, ay0 + 8, f"MIN F = 0, MODES MARKED RED", black, 1)
    _png_write("visualization.png", img.astype(np.uint8))
    return True

