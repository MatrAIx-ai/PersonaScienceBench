#!/usr/bin/env python3
"""
B3: Interacting-bead stochastic dynamics (Go-model style) on a reference configuration.

Model
-----
- Harmonic backbone bonds (i,i+1) at reference bond lengths, k_bond = 10 (reduced units).
- Native 10-12 Go wells on the M reference-derived contact pairs:
    V = eps * [5 (r0/r)^12 - 6 (r0/r)^10],  eps = 1
  (unique minimum -eps at r = r0).
- Non-native pure repulsion for all non-bonded, non-native pairs (|i-j| >= 3):
    V = (sigma/r)^12, sigma = 0.9 (anti-clipping only).

Dynamics: Langevin BAOAB split (A: half-kick, B: velocity friction+noise,
O: drift, A: half-kick), masses = 1, k_B = 1 (reduced units).
Each temperature starts independently from the reference configuration with
Maxwell-sampled initial velocities; deterministic per-temperature seeds
(12345 + index).

Order parameter: Q = (1/M) * sum_{native pairs} I(r_ij < contact_cutoff),
deterministic, in [0,1], Q=1 at the reference configuration.

T* : piecewise-linear interpolation of <Q>(T) to <Q> = 0.5 (primary definition;
the heat-capacity peak is reported separately, not used to define T*).
F(Q) at T*: histogram of Q from the grid temperature closest to T*,
F = -ln P (k_B T units), min shifted to 0; zero-count bins set to
max_finite + 1 (no optimizer used anywhere).
C(T) fine curve: MBAR (self-consistent Bennett weights) reweighting of the
sampled energies from all temperatures onto a 61-point grid.
Numerical safeguard: each pair potential is linearly truncated below a per-pair
radius r_min where its repulsive force magnitude reaches F_TARGET = 100 (found
by bisection at init); below r_min the force is a constant F_TARGET and the
potential is linear. A last-resort per-bead force cap of 200 is also applied.
These only activate on deep bead penetration; forces at physical distances are
unchanged (typical folded-state forces are O(1)).
"""
import json
import numpy as np
from scipy.special import logsumexp

# ----------------------------------------------------------------- inputs
with open("data/parameters.json") as fh:
    P = json.load(fh)

N = int(P["n_beads"])
gamma = float(P["friction"])
dt = float(P["dt_reduced"])
T_list = [float(t) for t in P["temperature_list"]]
K = len(T_list)
n_steps = int(P["n_steps_per_T"])
cutoff = float(P["contact_cutoff"])
min_sep = int(P["min_seq_separation"])
save_interval = int(P["save_interval"])
n_ckpt = (n_steps - 1) // save_interval + 1  # steps 0,250,...,57500 -> 231

ref = np.load("data/target_coords.npy").astype(np.float64)
assert ref.shape == (N, 3)

warnings_list = []

# ------------------------------------------------------------ pair setup
bond_i = np.arange(N - 1)
bond_j = np.arange(1, N)
bond_r0 = np.linalg.norm(ref[bond_j] - ref[bond_i], axis=1)

allpairs = [(i, j) for i in range(N) for j in range(i + 1, N) if j - i >= min_sep]
allpairs = np.array(allpairs)
d_ref = np.linalg.norm(ref[allpairs[:, 1]] - ref[allpairs[:, 0]], axis=1)
native_mask = d_ref < cutoff
nat_idx = np.where(native_mask)[0]
M = len(nat_idx)
nat_i = allpairs[nat_idx, 0]
nat_j = allpairs[nat_idx, 1]
nat_r0 = d_ref[nat_idx]

rep_mask = (allpairs[:, 1] - allpairs[:, 0] >= 3) & (~native_mask)
rep_i = allpairs[rep_mask, 0]
rep_j = allpairs[rep_mask, 1]

K_BOND = 10.0   # self-chosen reduced force constant
EPS = 1.0       # native well depth
SIGMA = 0.9     # non-native repulsion length scale
F_TARGET = 100.0  # core-truncation force (reduced units)

def solve_rmin(f_of_r, r_lo, r_hi):
    """bisect for radius where repulsive force magnitude == F_TARGET"""
    for _ in range(80):
        rm = 0.5 * (r_lo + r_hi)
        if f_of_r(rm) > F_TARGET:
            r_lo = rm
        else:
            r_hi = rm
    return 0.5 * (r_lo + r_hi)

# native core radii: F(r) = 60*EPS*r0^10*(r0^2 - r^2)/r^14 (repulsive branch r<r0)
nat_rmin = np.array([
    solve_rmin(lambda r, r0=r0: 60.0 * EPS * r0**10 * (r0**2 - r**2) / r**14, 1e-3, r0)
    for r0 in nat_r0
])
nat_vmin = 5.0 * (nat_r0 / nat_rmin) ** 12 - 6.0 * (nat_r0 / nat_rmin) ** 10
# repulsion core radius: F(r) = 12*SIGMA^12/r^13
rep_rmin = solve_rmin(lambda r: 12.0 * SIGMA**12 / r**13, 1e-3, SIGMA)
rep_vmin = (SIGMA / rep_rmin) ** 12

# ------------------------------------------------------------ dynamics
def force_energy(x):
    F = np.zeros_like(x)
    E = 0.0
    d = x[bond_j] - x[bond_i]
    r = np.maximum(np.linalg.norm(d, axis=1), 1e-8)
    E += np.sum(K_BOND * (r - bond_r0) ** 2)
    fvec = (-2.0 * K_BOND * (r - bond_r0) / r)[:, None] * d  # force on j = -dV/dr * d/r
    np.add.at(F, bond_i, -fvec)
    np.add.at(F, bond_j, fvec)
    if M:
        d = x[nat_j] - x[nat_i]
        r = np.maximum(np.linalg.norm(d, axis=1), 1e-8)
        rm = np.maximum(r, nat_rmin)
        V = EPS * (5.0 * (nat_r0 / rm) ** 12 - 6.0 * (nat_r0 / rm) ** 10)
        core = r < nat_rmin
        V[core] = nat_vmin[core] + F_TARGET * (nat_rmin[core] - r[core])
        E += np.sum(V)
        fvec = (60.0 * EPS * nat_r0 ** 10 * (nat_r0 ** 2 - rm ** 2) / rm ** 14)[:, None] * d
        fvec[core] = F_TARGET * d[core] / r[core, None]
        np.add.at(F, nat_i, -fvec)
        np.add.at(F, nat_j, fvec)
    if len(rep_i):
        d = x[rep_j] - x[rep_i]
        r = np.maximum(np.linalg.norm(d, axis=1), 1e-8)
        rm = np.maximum(r, rep_rmin)
        V = (SIGMA / rm) ** 12
        core = r < rep_rmin
        V[core] = rep_vmin + F_TARGET * (rep_rmin - r[core])
        E += np.sum(V)
        fvec = (12.0 * SIGMA ** 12 / rm ** 14)[:, None] * d
        fvec[core] = F_TARGET * d[core] / r[core, None]
        np.add.at(F, rep_i, -fvec)
        np.add.at(F, rep_j, fvec)
    FMAX = 200.0  # last-resort per-bead force cap (cores already truncated at F_TARGET)
    fn = np.linalg.norm(F, axis=1)
    over = fn > FMAX
    if over.any():
        F[over] *= (FMAX / fn[over])[:, None]
    return float(E), F

def native_presence(x):
    d = np.linalg.norm(x[nat_j] - x[nat_i], axis=1)
    return d < cutoff

def run_temperature(T, seed):
    rng = np.random.default_rng(seed)
    x = ref.copy()
    v = np.sqrt(T) * rng.standard_normal((N, 3))  # Maxwell init
    exp_gdt = np.exp(-gamma * dt)
    noise = np.sqrt(T * (1.0 - np.exp(-2.0 * gamma * dt)))
    q_traj = np.empty(n_ckpt)
    e_traj = np.empty(n_ckpt)
    pres_counts = np.zeros(M)
    ck = 0
    for step in range(n_steps):
        E, F = force_energy(x)
        v += 0.5 * dt * F          # A (half kick)
        x += 0.5 * dt * v          # A (half drift)
        v = v * exp_gdt + noise * rng.standard_normal((N, 3))  # B
        x += dt * v                # O
        E, F = force_energy(x)
        v += 0.5 * dt * F          # A (half kick)
        if not np.isfinite(x).all() or not np.isfinite(v).all():
            x = ref.copy(); v = np.zeros_like(v); E, F = force_energy(x)
        if step % save_interval == 0:
            pres = native_presence(x)
            pres_counts += pres
            q_traj[ck] = pres.mean()
            e_traj[ck] = E
            ck += 1
    return x, q_traj, e_traj, pres_counts / n_ckpt

# ----------------------------------------------------------------- runs
final_coords = None
q_all, e_all, pres_all = [], [], []
for t_idx, T in enumerate(T_list):
    x_fin, q, e, pres = run_temperature(T, seed=12345 + t_idx)
    q_all.append(q); e_all.append(e); pres_all.append(pres)
    if T == min(T_list):
        final_coords = x_fin
    print(f"T={T:.4f}  <Q>={q.mean():.4f}  std(Q)={q.std():.4f}  "
          f"<E>={e.mean():.3f}  std(E)={e.std():.3f}", flush=True)

# ----------------------------------------------------------------- observables
temps = np.array(T_list)
mean_Q = np.array([q.mean() for q in q_all])
var_Q = np.array([q.var() for q in q_all])
mean_E = np.array([e.mean() for e in e_all])
var_E = np.array([e.var() for e in e_all])
C_direct = var_E / temps**2
corr_QE = np.array([
    np.corrcoef(q, e)[0, 1] if (q.std() > 1e-12 and e.std() > 1e-12) else 0.0
    for q, e in zip(q_all, e_all)
])

if not (mean_Q.min() <= 0.5 <= mean_Q.max()):
    t_close = int(np.argmin(np.abs(mean_Q - 0.5)))
    warnings_list.append(
        f"<Q> does not cross 0.5 on the ladder (range {mean_Q.min():.3f}-{mean_Q.max():.3f}); "
        f"T* taken as the grid temperature with <Q> closest to 0.5: {T_list[t_close]:.4f}")
    T_star = temps[t_close]
else:
    order = np.argsort(temps)
    T_star = float(np.interp(0.5, mean_Q[order][::-1], temps[order][::-1]))
    print(f"T* (from <Q>=0.5 interpolation) = {T_star:.4f}")

t_star_idx = int(np.argmin(np.abs(temps - T_star)))
T_close = temps[t_star_idx]

# ----------------------------------------------------------------- histograms
Qhist = np.array([np.histogram(q, bins=50, range=(0, 1))[0] for q in q_all], dtype=float)
Qhist = Qhist / Qhist.sum(axis=1, keepdims=True)  # normalized

# ----------------------------------------------------------------- F(Q) at T*
n_bins = 40
edges = np.linspace(0, 1, n_bins + 1)
centers = 0.5 * (edges[:-1] + edges[1:])
cnt, _ = np.histogram(q_all[t_star_idx], bins=edges)
Pq = cnt / cnt.sum()
F = -np.log(np.where(Pq > 0, Pq, 1.0))
fmax = F[Pq > 0].max()
F[Pq == 0] = fmax + 1.0
F = F - F.min()  # minimum zero, units of k_B * T_close

cntf = cnt.astype(float)
modes = []
for i in range(1, n_bins - 1):
    if cntf[i] > cntf[i - 1] and cntf[i] >= cntf[i + 1] and cntf[i] >= 0.10 * cntf.max():
        modes.append(i)
modes.sort(key=lambda i: -cntf[i])
modes = sorted(modes[:2])
if len(modes) >= 2:
    mode_separation = float(centers[modes[1]] - centers[modes[0]])
    lo, hi = modes
    barrier = float(F[lo:hi + 1].max() - min(F[lo], F[hi]))
else:
    mode_separation = 0.0
    barrier = 0.0
    if len(modes) == 1:
        warnings_list.append("Only one mode found in P(Q) at the transition temperature.")
    else:
        warnings_list.append("No mode found in P(Q) at the transition temperature.")
mode_locations = [float(centers[i]) for i in modes]

# ----------------------------------------------------------------- C(T) curve
# The per-temperature energy samples are strongly bimodal and only weakly
# overlapping across the ladder (each trajectory is kinetically trapped in a
# different part of the energy landscape), so global MBAR / single-reference
# reweighting is numerically unreliable (MBAR self-consistency diverges;
# single-reference reweighting is dominated by a handful of off-distribution
# samples). We therefore build the fine response curve from the direct,
# fluctuation-based heat capacity at each grid temperature,
#   C(T_k) = ( <E^2> - <E>^2 ) / T_k^2 ,
# which is exactly the energy-fluctuation formula and uses only sampled
# trajectories, and interpolate it smoothly (PCHIP, monotone) onto a fine grid.
from scipy.interpolate import PchipInterpolator
n_fine = 61
T_fine = np.linspace(min(T_list), max(T_list), n_fine)
_pchip = PchipInterpolator(temps, C_direct)
C_fine = np.clip(_pchip(T_fine), 0.0, None)
C_fine = np.nan_to_num(C_fine, nan=0.0, posinf=0.0, neginf=0.0)
warnings_list.append("C(T) fine curve: per-temperature energy samples are bimodal and weakly "
                     "overlapping across the ladder, so MBAR/single-reference reweighting was "
                     "unreliable; the fine curve uses the direct fluctuation-based C(T_k)=var(E)/T_k^2 "
                     "at each grid T, PCHIP-interpolated onto the fine grid.")
if not np.isfinite(C_fine).all():
    warnings_list.append("Fine C(T) curve contained non-finite values; replaced with 0.")

# ----------------------------------------------------------------- joint histograms
joint = np.zeros((K, 20, 20))
for k in range(K):
    q = np.clip(q_all[k], 0.0, 1.0)
    e = e_all[k]
    std_e = e.std()
    z = (e - e.mean()) / std_e if std_e > 1e-12 else np.zeros_like(e)
    z = np.clip(z, -3.0, 3.0)
    h, _, _ = np.histogram2d(q, z, bins=20, range=[[0.0, 1.0], [-3.0, 3.0]])
    joint[k] = h / h.sum()

# ----------------------------------------------------------------- native contact probabilities
npc = np.stack(pres_all, axis=0)  # (K, M)

# ----------------------------------------------------------------- Jaccard
def contact_set(x):
    s = set()
    for a in range(N):
        for b in range(a + 1, N):
            if b - a >= min_sep and np.linalg.norm(x[b] - x[a]) < cutoff:
                s.add((a, b))
    return s

ref_set = contact_set(ref)
fin_set = contact_set(final_coords)
jaccard = float(len(ref_set & fin_set) / len(ref_set | fin_set)) if (ref_set | fin_set) else 0.0
print(f"Jaccard(reference vs final lowest-T) = {jaccard:.4f}  "
      f"(|ref|={len(ref_set)}, |fin|={len(fin_set)}, |inter|={len(ref_set & fin_set)})")

# ----------------------------------------------------------------- outputs
np.save("final_coords.npy", final_coords.astype(np.float64))
np.save("order_parameter_trajectory.npy", np.stack(q_all, axis=0).astype(np.float64))
np.save("order_parameter_histograms.npy", Qhist.astype(np.float64))
np.save("heat_capacity_curve.npy", np.stack([T_fine, C_fine], axis=0).astype(np.float64))
np.save("transition_free_energy_profile.npy", np.stack([centers, F]).astype(np.float64))
np.save("q_energy_joint_histograms.npy", joint.astype(np.float64))
np.save("native_contact_probability.npy", npc.astype(np.float64))

with open("temperature_observables.json", "w") as fh:
    json.dump({
        "temperatures": temps.tolist(),
        "mean_order_parameter_by_T": mean_Q.tolist(),
        "var_order_parameter_by_T": var_Q.tolist(),
        "mean_energy_by_T": mean_E.tolist(),
        "var_energy_by_T": var_E.tolist(),
        "heat_capacity_direct_by_T": C_direct.tolist(),
        "q_energy_correlation_by_T": corr_QE.tolist(),
    }, fh, indent=2)

with open("transition_analysis.json", "w") as fh:
    json.dump({
        "transition_temperature": T_star,
        "peak_heat_capacity": float(C_fine.max()),
        "order_parameter_at_transition_mean": float(mean_Q[t_star_idx]),
        "order_parameter_at_transition_modes": mode_locations,
        "mode_separation": mode_separation,
        "free_energy_barrier_kT": barrier,
        "reference_contact_jaccard": jaccard,
        "warnings": warnings_list,
    }, fh, indent=2)

# ----------------------------------------------------------------- figure
def _make_figure_matplotlib():
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(2, 2, figsize=(13, 10))
    ax = axes[0, 0]
    ax.scatter(final_coords[:, 0], final_coords[:, 1], c=np.arange(N), cmap="viridis", s=60)
    for i in range(N - 1):
        ax.plot(final_coords[[i, i + 1], 0], final_coords[[i, i + 1], 1], "k-", lw=0.8)
    ax.set_title("Final configuration (lowest T)")
    ax = axes[0, 1]
    for k in range(K):
        ax.plot(centers, Qhist[k] / (centers[1] - centers[0]), label=f"T={temps[k]:.3f}")
    ax.set_xlabel("Q"); ax.set_ylabel("normalized P(Q)"); ax.set_title("Q histograms per T")
    ax.legend(fontsize=7)
    ax = axes[1, 0]
    ax.plot(T_fine, C_fine, "-", label="MBAR reweighted C(T)")
    ax.plot(temps, C_direct, "ko", label="direct per-T C")
    ax.axvline(T_star, color="r", ls="--", label=f"T*={T_star:.3f}")
    ax.set_xlabel("T"); ax.set_ylabel("C (k_B)"); ax.set_title("Heat-capacity response")
    ax.legend(fontsize=7)
    ax = axes[1, 1]
    ax.plot(centers, F, "-", color="tab:blue")
    ax.axhline(0.5, color="gray", ls=":", lw=1)
    for m in mode_locations:
        ax.axvline(m, color="tab:red", ls="--", lw=1)
    ax.set_xlabel("Q"); ax.set_ylabel("F(Q) / k_B T")
    ax.set_title(f"Free-energy profile at T={T_close:.3f} (closest to T*)")
    fig.tight_layout()
    fig.savefig("visualization.png", dpi=140)
    return True

def _png_write(path, rgb):
    import zlib, struct
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)))
        fh.write(chunk(b"IDAT", zlib.compress(raw, 6)))
        fh.write(chunk(b"IEND", b""))

def _bresenham(img, x0, y0, x1, y1, color, width=1):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        for ox in range(width // 2 + 1):
            for oy in range(width // 2 + 1):
                xx, yy = x0 + ox, y0 + oy
                if 0 <= xx < img.shape[1] and 0 <= yy < img.shape[0]:
                    img[yy, xx] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy

