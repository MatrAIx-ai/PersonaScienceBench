def draw_text(canvas, x, y, text, scale=1, color=(0, 0, 0)):
    cx = x
    for ch in text:
        g = FONT.get(ch, FONT[' '])
        for r in range(7):
            bits = g[r]
            for c in range(5):
                if bits & (1 << (4 - c)):
                    for dy in range(scale):
                        for dx in range(scale):
                            canvas[y + r * scale + dy, cx + c * scale + dx] = color
        cx += 6 * scale


def write_png(path, canvas):
    h, w, _ = canvas.shape
    raw = b"".join(b"\x00" + canvas[y].tobytes() for y in range(h))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


def rdbu(t):
    """Diverging blue-white-red colormap, t in [0,1]."""
    if t < 0.5:
        u = t / 0.5
        return tuple(int(a + (255 - a) * u) for a in (33, 102, 172))
    u = (t - 0.5) / 0.5
    return tuple(int(255 + (a - 255) * u) for a in (178, 24, 43))


def render_overview(path, field_slices, rows, vmax):
    W, H = 1460, 980
    canvas = np.full((H, W, 3), 255, np.uint8)
    title = "IMPLICIT-SOLVENT BINDING RESPONSE: PB (PRIMARY) VS BORN CROSS-TERM (SECONDARY)"
    draw_text(canvas, (W - len(title) * 12) // 2, 18, title, scale=2)
    px = 8  # pixels per voxel
    for ci, row in enumerate(rows):
        r, c = divmod(ci, 4)
        x0 = 30 + c * 310
        y0 = 70 + r * 430
        sl = field_slices[ci]
        tvals = np.clip(0.5 + 0.5 * sl / vmax, 0.0, 1.0)
        cols = np.array([rdbu(t) for t in tvals.ravel()], np.uint8).reshape(35, 35, 3)
        img = np.repeat(np.repeat(cols, px, axis=0), px, axis=1)
        canvas[y0:y0 + 280, x0:x0 + 280] = img
        canvas[y0:y0 + 280, x0] = 0
        canvas[y0:y0 + 280, x0 + 279] = 0
        canvas[y0, x0:x0 + 280] = 0
        canvas[y0 + 279, x0:x0 + 280] = 0
        ty = y0 + 286
        draw_text(canvas, x0, ty, row["label"], scale=2)
        for k, line in enumerate(row["lines"]):
            draw_text(canvas, x0, ty + 24 + k * 12, line)
    # shared color scale
    bx, by, bh = 1300, 70, 780
    for yy in range(bh):
        t = 1.0 - yy / (bh - 1)
        canvas[by + yy, bx:bx + 24] = rdbu(t)
    canvas[by - 1:by + bh + 1, bx - 1] = 0
    canvas[by - 1:by + bh + 1, bx + 24] = 0
    draw_text(canvas, bx + 30, by, f"+{vmax:.1f}")
    draw_text(canvas, bx + 30, by + bh // 2 - 3, "0.0")
    draw_text(canvas, bx + 30, by + bh - 7, f"-{vmax:.1f}")
    draw_text(canvas, bx - 40, by + bh + 16, "REACTION FIELD")
    draw_text(canvas, bx - 40, by + bh + 28, "(KCAL/MOL/E)")
    draw_text(canvas, 30, H - 30,
              "FIELD = ASSEMBLY REACTION FIELD (MEDIUM - VACUUM); ZERO DIRICHLET OUTER BOUNDARY; GRID 35X35X35 PER CASE",
              scale=1)
    write_png(path, canvas)


# ----------------------------------------------------------------------
# main
# ----------------------------------------------------------------------
def main():
    t_start = time.time()
    global SITES
    with open("data/manifest.json") as f:
        man = json.load(f)
    with open("data/plane_spec.json") as f:
        planes = json.load(f)["planes"]
    SITES = pd.read_csv("data/sites.csv")
    volA = np.load("data/volume_a.npy")   # (8,35,35,35) float32, SDF, negative inside
    volB = np.load("data/volume_b.npy")
    queries = np.load("data/queries.npy")  # (8,24,3) float32
    cases = man["cases"]
    assert [c["case_id"] for c in cases] == man["case_order"]

    os.makedirs("results", exist_ok=True)
    field_samples = np.zeros((len(cases), 24))
    field_slices = np.zeros((len(cases), 35, 35))
    summary = []
    diag_lines = []
    rows_for_fig = []

    for ci, case in enumerate(cases):
        t_case = time.time()
        grid = case["grid"]
        s = grid["spacing_angstrom"]
        rp = case["response_parameters"]
        sur = case["surface_parameters"]
        eps_in, eps_out = rp["inner_dielectric"], rp["outer_dielectric"]
        kappa = rp["screening_kappa_per_angstrom"]
        T = rp["temperature_kelvin"]
        regime = rp["response_regime"]
        smodel = sur["surface_model"]
        probe = sur["probe_radius_angstrom"]
        win = sur["smoothing_window_angstrom"]
        cid = case["case_id"]

        # --- entity surfaces / solvent fractions / dielectrics ---
        # assembly: provided tensors authoritative (mol -> volume_a, smol -> volume_b)
        sdf_asm = (volA[ci] if smodel == "mol" else volB[ci]).astype(np.float64)
        t_m = time.time()
        sdf_a = entity_sdf(cid, grid, "part_a", probe)
        sdf_b = entity_sdf(cid, grid, "part_b", probe)
        t_mask = time.time() - t_m
        sf_asm = solvent_fraction(sdf_asm, smodel, win)
        sf_a = solvent_fraction(sdf_a, smodel, win)
        sf_b = solvent_fraction(sdf_b, smodel, win)
        eps_asm = eps_field(sf_asm, eps_in, eps_out)
        eps_a = eps_field(sf_a, eps_in, eps_out)
        eps_b = eps_field(sf_b, eps_in, eps_out)
        sf_map = {"assembly": sf_asm, "part_a": sf_a, "part_b": sf_b}
        eps_map = {"assembly": eps_asm, "part_a": eps_a, "part_b": eps_b}

        # --- charges ---
        ent = {}
        for name in ("assembly", "part_a", "part_b"):
            sub = SITES[(SITES["case_id"] == cid) & (SITES["entity_id"] == name)]
            ent[name] = (sub[["x_angstrom", "y_angstrom", "z_angstrom"]].to_numpy(dtype=float),
                         sub["charge_e"].to_numpy(dtype=float))

        # --- vacuum system (uniform eps_in, sf=0, kappa=0): one factorization per case ---
        t_f = time.time()
        L_vac, _ = build_L(np.full((35, 35, 35), eps_in), np.zeros((35, 35, 35)), 0.0, s)
        A_vac = L_vac.tocsc()
        t_vac_fact = time.time() - t_f

        energies = {}
        phi_R_asm_full = None
        newton_info = {}
        fact_times = {}
        for name in ("assembly", "part_a", "part_b"):
            pos, q = ent[name]
            rho = cic_rho(q, pos, grid)
            b = (4.0 * np.pi * KCAL * rho[1:34, 1:34, 1:34]).ravel()
            t_f = time.time()
            L, scr = build_L(eps_map[name], sf_map[name], kappa, s)
            if regime == "linearized_screening":
                phi_med, iters = cg_solve((L + sp.diags(scr)).tocsc(), b)
                res = np.abs((L + sp.diags(scr)) @ phi_med - b).max()
            else:
                beta = 1.0 / (R_KCAL * T)   # (kcal/mol)^-1 for potentials in kcal/mol/e
                phi_med, iters, res = solve_nonlinear(L, scr, b, beta)
                newton_info[name] = (iters, res)
            fact_times[name] = time.time() - t_f
            phi_vac, _ = cg_solve(A_vac, b)
            phi_R = phi_med - phi_vac
            phi_R_full = np.zeros((35, 35, 35))
            phi_R_full[1:34, 1:34, 1:34] = phi_R.reshape(33, 33, 33)
            if name == "assembly":
                phi_R_asm_full = phi_R_full
            energies[name] = 0.5 * np.sum(q * trilinear(phi_R_full, pos, grid))

        primary = energies["assembly"] - energies["part_a"] - energies["part_b"]
        secondary, n_kept = secondary_metric(case, grid, sdf_a, sdf_b)
        gap = primary - secondary

        # --- field outputs (assembly reaction field, field entity) ---
        field_samples[ci] = trilinear(phi_R_asm_full, queries[ci], grid)
        pl = planes[ci]
        if pl["axis"] == "z":
            sl = phi_R_asm_full[:, :, pl["plane_index"]]
            slice_note = f"SLICE: Z[{pl['plane_index']}] X-Y"
        else:
            sl = phi_R_asm_full[:, pl["plane_index"], :]
            slice_note = f"SLICE: Y[{pl['plane_index']}] X-Z"
        field_slices[ci] = sl

        summary.append((cid, primary, secondary, gap))
        rows_for_fig.append({
            "label": f"CASE_{ci:03d}".upper(),
            "lines": [
                f"REGIME: {'LINEARIZED' if regime == 'linearized_screening' else 'NONLINEAR'}",
                f"SURF: {smodel.upper()} P={probe:.1f} W={win:.1f}",
                slice_note,
                f"PRIMARY: {primary:+.2f} KCAL/MOL",
                f"SECONDARY: {secondary:+.2f} KCAL/MOL",
                f"GAP: {gap:+.2f} KCAL/MOL",
            ],
        })
        diag_lines.append(
            f"{cid} | {regime:22s} {smodel} p={probe:.1f} w={win:.1f} | "
            f"E_asm={energies['assembly']:+10.3f} E_a={energies['part_a']:+10.3f} E_b={energies['part_b']:+10.3f} | "
            f"primary={primary:+10.3f} secondary={secondary:+10.3f} gap={gap:+10.3f} | "
            f"masks={t_mask:5.1f}s vacfact={t_vac_fact:5.2f}s "
            f"medfact=" + "/".join(f"{fact_times[n]:5.2f}" for n in ("assembly", "part_a", "part_b")) +
            (" | newton=" + "/".join(f"{newton_info[n][0]}it,res={newton_info[n][1]:.1e}" for n in newton_info)
             if newton_info else "") +
            f" | sec_kept={n_kept} | field[min={phi_R_asm_full.min():+.2f},max={phi_R_asm_full.max():+.2f}] | "
            f"case_time={time.time()-t_case:6.1f}s"
        )

    # --- outputs ---
    with open("results/summary_metrics.csv", "w") as f:
        f.write("case_id,metric_primary_kcal_mol,metric_secondary_kcal_mol,metric_gap_kcal_mol\n")
        for cid, p, sec, g in summary:
            # full-precision round-trip so that gap == primary - secondary holds exactly
            # when the written values are re-parsed as float64
            f.write(f"{cid},{float(p)!r},{float(sec)!r},{float(g)!r}\n")
    np.save("results/field_samples.npy", field_samples.astype(np.float32))
    np.save("results/field_slice.npy", field_slices.astype(np.float32))
    vmax = float(np.abs(field_slices).max())
    render_overview("results/overview.png", field_slices, rows_for_fig, vmax)

    print("\n".join(diag_lines))
    print(f"\ntotal wall time: {time.time()-t_start:.1f} s")
    print("outputs:")
    for p in ("results/summary_metrics.csv", "results/field_samples.npy",
              "results/field_slice.npy", "results/overview.png"):
        st = os.stat(p)
        print(f"  {p}: {st.st_size} bytes")
    print("field_samples (saved):", field_samples.shape, "float32")
    print("field_slice   (saved):", field_slices.shape, "float32")


if __name__ == "__main__":
    main()
