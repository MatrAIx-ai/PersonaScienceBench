KCAL = 332.06371          # Coulomb constant, kcal*Angstrom/(mol*e^2)
R_KCAL = 1.987204134e-3   # gas constant, kcal/(mol*K)
GATE = 6.5                # secondary-metric gate, Angstrom
SINH_CLIP = 60.0          # overflow guard for sinh/cosh arguments (true solution stays far below)
SITES = None


def axis_coords(grid):
    """Node positions (35,3): center - half + i*spacing, per axis."""
    h = grid["box_half_extent_angstrom"]
    s = grid["spacing_angstrom"]
    c = np.asarray(grid["box_center_angstrom"], dtype=float)
    return np.arange(35)[:, None] * s + (c - h)[None, :]  # (35,3): coords per axis


def frac_indices(pos, grid):
    """Global Angstrom positions -> fractional node indices."""
    h = grid["box_half_extent_angstrom"]
    s = grid["spacing_angstrom"]
    c = np.asarray(grid["box_center_angstrom"], dtype=float)
    return (pos - (c - h)) / s


def trilinear(field, pos, grid):
    """Trilinear interpolation of a (35,35,35) field at positions (...,3) in Angstrom."""
    f = frac_indices(pos, grid)
    i0 = np.clip(np.floor(f).astype(np.int64), 0, 33)
    t = np.clip(f - i0, 0.0, 1.0)
    out = np.zeros(f.shape[:-1])
    for dx in (0, 1):
        wx = t[..., 0] if dx else 1.0 - t[..., 0]
        for dy in (0, 1):
            wy = t[..., 1] if dy else 1.0 - t[..., 1]
            for dz in (0, 1):
                wz = t[..., 2] if dz else 1.0 - t[..., 2]
                out += wx * wy * wz * field[i0[..., 0] + dx, i0[..., 1] + dy, i0[..., 2] + dz]
    return out


def voxel_mask(case_id, grid, entity):
    """VDW voxel mask: node inside iff min_i (|x - c_i| - r_i) <= 0."""
    sub = SITES[(SITES["case_id"] == case_id) & (SITES["entity_id"] == entity)]
    pos = sub[["x_angstrom", "y_angstrom", "z_angstrom"]].to_numpy(dtype=float)
    rad = sub["radius_angstrom"].to_numpy(dtype=float)
    ax = axis_coords(grid)
    nodes = np.stack(np.meshgrid(ax[:, 0], ax[:, 1], ax[:, 2], indexing="ij"), -1).reshape(-1, 3)
    n = len(nodes)
    dmin = np.full(n, np.inf)
    NB, NA = 8192, 512
    for b0 in range(0, n, NB):
        nb = nodes[b0:b0 + NB]
        for a0 in range(0, len(pos), NA):
            p = pos[a0:a0 + NA]
            r = rad[a0:a0 + NA]
            d2 = (nb[:, None, 0] - p[None, :, 0]) ** 2
            d2 += (nb[:, None, 1] - p[None, :, 1]) ** 2
            d2 += (nb[:, None, 2] - p[None, :, 2]) ** 2
            d = np.sqrt(d2) - r[None, :]
            dmin[b0:b0 + NB] = np.minimum(dmin[b0:b0 + NB], d.min(1))
    return (dmin <= 0.0).reshape(35, 35, 35)


def sdf_from_mask(M, s):
    """Signed distance field, NEGATIVE inside / POSITIVE outside (verified)."""
    return (distance_transform_edt(~M) * s - distance_transform_edt(M) * s)


def ses_mask(V, probe):
    """SES = dilate(V, probe) then erode(., probe), union with the VDW mask.

    Prescribed recipe, kept literal. On these grids the opening is a subset of
    V, so the union equals V (verified numerically for all probe>0 cases).
    """
    if probe <= 0.0:
        return V
    D = distance_transform_edt(~V) <= probe          # dilation by probe
    E = D & (distance_transform_edt(~D) >= probe)    # then erosion by probe
    return E | V                                      # union with VDW mask


def entity_sdf(case_id, grid, entity, probe):
    V = voxel_mask(case_id, grid, entity)
    return sdf_from_mask(ses_mask(V, probe), grid["spacing_angstrom"])


# ----------------------------------------------------------------------
# finite-volume PB operator
# ----------------------------------------------------------------------
def solvent_fraction(sdf, surface_model, w):
    """sf: 0 inside, 1 outside. mol: sharp indicator; smol: tanh transition."""
    if surface_model == "mol":
        return (sdf > 0.0).astype(np.float64)
    # w = smoothing_window_angstrom, read as half-width of the interface (see module docstring)
    return 0.5 * (1.0 + np.tanh(sdf / (2.0 * w)))


def eps_field(sf, eps_in, eps_out):
    return eps_in + (eps_out - eps_in) * sf


def build_L(eps, sf, kappa, s):
    """Build L (positive definite face-Laplacian; zero Dirichlet handled by
    dropping boundary off-diagonals) and the screening diagonal
    scr = kappa^2 * solvent_fraction over interior nodes (indices 1..33).
    Returns (L, scr_flat)."""
    N = 33
    ii = np.arange(1, 34).reshape(N, 1, 1)
    jj = np.arange(1, 34).reshape(1, N, 1)
    kk = np.arange(1, 34).reshape(1, 1, N)
    inv_s2 = 1.0 / (s * s)
    lap_diag = np.zeros((N, N, N))
    rows = ((ii - 1) * N + (jj - 1)) * N + (kk - 1)
    rr = rows.ravel()
    rs, cs, ds = [], [], []
    for (di, dj, dk, off) in ((1, 0, 0, N * N), (-1, 0, 0, -N * N),
                              (0, 1, 0, N), (0, -1, 0, -N),
                              (0, 0, 1, 1), (0, 0, -1, -1)):
        ni, nj, nk = ii + di, jj + dj, kk + dk
        ec = eps[ii, jj, kk]
        en = eps[ni, nj, nk]
        ef = 2.0 * ec * en / (ec + en)               # harmonic face average
        lap_diag += inv_s2 * ef
        m = (ni >= 1) & (ni <= 33) & (nj >= 1) & (nj <= 33) & (nk >= 1) & (nk <= 33)
        rs.append(rows[m].ravel())
        cs.append((rows + off)[m].ravel())
        ds.append((inv_s2 * ef)[m].ravel())
    L = sp.coo_matrix((np.concatenate(ds), (np.concatenate(rs), np.concatenate(cs)))).tocsr()
    L = L + sp.diags(lap_diag.ravel())
    L.sort_indices()
    scr = (kappa * kappa) * sf[ii, jj, kk]           # screening term kappa^2 * solvent_fraction
    return L, scr.ravel()


def cg_solve(A, b, tol=1e-12, maxit=6000):
    """Conjugate-gradient solve for the SPD systems (validated against a direct
    splu solve to <3e-12 relative difference). Returns (x, iterations)."""
    x = np.zeros_like(b)
    r = b - A @ x
    p = r.copy()
    rs = r @ r
    bnorm = max(1.0, np.linalg.norm(b))
    it = 0
    for it in range(1, maxit + 1):
        Ap = A @ p
        alpha = rs / (p @ Ap)
        x += alpha * p
        r -= alpha * Ap
        rs2 = r @ r
        if np.sqrt(rs2) < tol * bnorm:
            break
        p = r + (rs2 / rs) * p
        rs = rs2
    return x, it


def cic_rho(charges, pos, grid):
    """Trilinear cloud-in-cell deposition; density = deposited charge / spacing^3."""
    rho = np.zeros((35, 35, 35))
    f = frac_indices(pos, grid)
    i0 = np.floor(f).astype(np.int64)
    t = f - i0
    s3 = grid["spacing_angstrom"] ** 3
    for i, q in enumerate(charges):
        if q == 0.0:
            continue
        x, y, z = i0[i]
        tx, ty, tz = t[i]
        for dx in (0, 1):
            wx = tx if dx else 1.0 - tx
            for dy in (0, 1):
                wy = ty if dy else 1.0 - ty
                for dz in (0, 1):
                    w = wx * wy * (tz if dz else 1.0 - tz)
                    ii, jj, kk = x + dx, y + dy, z + dz
                    if 0 <= ii < 35 and 0 <= jj < 35 and 0 <= kk < 35:
                        rho[ii, jj, kk] += w * q / s3
    return rho


def solve_nonlinear(L, scr, b, beta):
    """Solve L phi + scr * sinh(beta phi)/beta = b by damped Newton (CG steps).

    (Linearized limit: L phi + scr phi = b.) Returns (phi, iterations, |residual|inf).

    The linearized solution is used as the starting point but capped per node:
    at any node with screening, the true solution satisfies
    scr*sinh(beta*phi)/beta <= 2*Lii*|phi| + |b|max, so phi is bounded by
    (1/beta)*asinh(beta*(2*Lii*|phi0| + bmax)/scr); iterating this estimate a
    few times gives a tight per-node cap. Starting inside the cap keeps the
    Newton iterates in a well-conditioned regime (the uncapped linearized
    solution overshoots by orders of magnitude near charges).
    """
    A_lin_scr = (L + sp.diags(scr)).tocsc()
    phi, _ = cg_solve(A_lin_scr, b)                         # start: linearized solution
    Lii = L.diagonal()
    bmax = np.abs(b).max()
    cap = np.full_like(phi, np.inf)
    active = scr > 1e-200   # every screened node (tanh tails are never exactly 0)
    if active.any():
        phi0 = np.abs(phi).max()
        for _ in range(4):
            rhs = 2.0 * Lii[active] * phi0 + bmax
            cap[active] = np.arcsinh(beta * rhs / scr[active]) / beta
            phi0 = cap[active].max()
    phi = np.clip(phi, -cap, cap)

    def resid(p):
        return L @ p + scr * np.sinh(np.clip(beta * p, -SINH_CLIP, SINH_CLIP)) / beta - b

    F = resid(phi)
    tol = 1e-10 * max(1.0, np.abs(b).max())
    it = 0
    for it in range(1, 51):
        J = (L + sp.diags(scr * np.cosh(np.clip(beta * phi, -SINH_CLIP, SINH_CLIP)))).tocsc()
        delta, _ = cg_solve(J, F)
        scale = max(1.0, np.abs(phi).max())
        step = 1.0
        F0 = np.abs(F).max()
        for _ in range(12):                                # backtracking on residual
            phi_new = np.clip(phi - step * delta, -cap, cap)  # project onto proven range
            F_new = resid(phi_new)
            if np.isfinite(F_new).all() and np.abs(F_new).max() <= F0:
                phi, F = phi_new, F_new
                break
            step *= 0.5
        if step == 0.5 ** 12:
            break                                          # no progress possible
        if np.abs(F).max() < tol or (step * np.abs(delta).max()) < 1e-11 * scale:
            break
    return phi, it, np.abs(F).max()


# ----------------------------------------------------------------------
# secondary (Born cross-term) metric
# ----------------------------------------------------------------------
def secondary_metric(case, grid, sdf_a, sdf_b):
    rp = case["response_parameters"]
    eps_in, eps_out = rp["inner_dielectric"], rp["outer_dielectric"]
    kappa = rp["screening_kappa_per_angstrom"]
    cid = case["case_id"]
    pa = SITES[(SITES["case_id"] == cid) & (SITES["entity_id"] == "part_a")]
    pb = SITES[(SITES["case_id"] == cid) & (SITES["entity_id"] == "part_b")]
    pos_a = pa[["x_angstrom", "y_angstrom", "z_angstrom"]].to_numpy(dtype=float)
    q_a = pa["charge_e"].to_numpy(dtype=float)
    r_a = pa["radius_angstrom"].to_numpy(dtype=float)
    pos_b = pb[["x_angstrom", "y_angstrom", "z_angstrom"]].to_numpy(dtype=float)
    q_b = pb["charge_e"].to_numpy(dtype=float)
    r_b = pb["radius_angstrom"].to_numpy(dtype=float)
    # Born radius: max(atom radius, distance to own component's reconstructed SES boundary)
    a_i = np.maximum(r_a, np.abs(trilinear(sdf_a, pos_a, grid)))
    a_j = np.maximum(r_b, np.abs(trilinear(sdf_b, pos_b, grid)))
    d = pos_a[:, None, :] - pos_b[None, :, :]
    rij2 = (d ** 2).sum(-1)
    rij = np.sqrt(rij2)
    keep = rij.min(1) <= GATE                              # 6.5 Angstrom gate on nearest part_b
    ai = a_i[keep, None]
    aj = a_j[None, :]
    r2 = rij2[keep]
    with np.errstate(divide="ignore", invalid="ignore"):
        f = np.sqrt(r2 + ai * aj * np.exp(-r2 / (4.0 * ai * aj)))
    f = np.where(f > 0.0, f, np.inf)
    term = ((1.0 / eps_in) - np.exp(-kappa * f) / eps_out) / f
    return -KCAL * np.sum(q_a[keep, None] * q_b[None, :] * term), int(keep.sum())


