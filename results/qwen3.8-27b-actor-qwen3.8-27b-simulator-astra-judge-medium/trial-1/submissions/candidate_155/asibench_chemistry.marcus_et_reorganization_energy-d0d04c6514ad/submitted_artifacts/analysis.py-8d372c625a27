#!/usr/bin/env python3
"""Solution-phase electron-transfer reorganization-energy response calculation.
Reads data/ and writes the 10 required outputs under results/.

APPROVED METHOD (researcher rulings):
  (A) 15 retained modes from manifest (null_rank=6 / resolved_rank=15); drop the
      6 lowest (null) eigenvalues, keep the 15 highest, indexed by ascending w2.
  (B) Alignment = UNWEIGHTED Kabsch (rotation+translation only, det=+1).
      forward = B-in-A (reference A), backward = A-in-B (reference B).
      Signed displacement = aligned source - reference target.
  (C) Hessian is site-major (3 consecutive components per site, frame site order).
  (D) lambda_4pt = full 21-dim quadratic; lambda_nm = sum over 15 retained modes.
      For an exact quadratic these close (closure_error ~ 0).
  (E) lambda_inner_effective = (forward + backward) / 2.
  (F) lambda_outer = (1/eps_op - 1/eps_s) * span_A  [MLJ dielectric form].
      NOTE (uncertainty, recorded per researcher request): the geometric
      prefactor is uncertain by a possible 1/2 factor; we use span_A directly
      (no 1/2). span_A=9.2503 < shell_0_A+shell_1_A=9.8998 is consistent with a
      two-site combination including a cross term. Robustness: for every listed
      lambda_outer candidate lambda_total > 2.6 eV, so the Marcus peak
      (dG=-lambda_total) always lies outside the driving-force grid (grid min
      axis=-1.5138 eV); the whole curve is in the normal region and
      inverted_region_detected is False regardless of the 1/2 choice.
  (G) k_self_exchange uses lambda_total (self-exchange dG0=0).
  (H) axis_eV is the driving force dG0 (negative=exergonic);
      Marcus k = prefactor * exp(-(lambda+dG0)^2/(4 lambda kBT)).
  (I) mode_projection cols=[signed modal coord q_k, |q_k|, 0.5*w2_k*q_k^2];
      transported_mode_projection cols=[|V_ref[k].q_mw|, |transported V_src[k].q_mw|];
      dominant_mode=argmax_k |signed modal coord| (zero-based retained index).
  (J) freq_scale_factor used only for the overview frequency display.
All outputs are derived from the same intermediate quantities (no independent
fitting of any terminal scalar or the rate curve).
"""
import os, csv, json
import numpy as np
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

DATA = "data"; OUT = "results"
os.makedirs(OUT, exist_ok=True)
HBAR = 1.054571817e-34      # J s
KB   = 1.380649e-23         # J / K
EV2J = 1.602176634e-19      # J / eV
NSITE = 7

def load_order():
    rows = list(csv.DictReader(open(os.path.join(DATA, "frame_site_order.csv"))))
    order = {}
    for r in rows:
        order.setdefault(r["frame_id"], {})[int(r["row_index"])] = int(r["site_id"])
    return order

def asc_perm(site_by_row, n=NSITE):
    inv = {s: row for row, s in site_by_row.items()}
    return [inv[s] for s in range(n)]

def perm21(sites):
    p = []
    for s in sites:
        p.extend([3 * s, 3 * s + 1, 3 * s + 2])
    return p

order = load_order()
pa = asc_perm(order["frame_a"]); pb = asc_perm(order["frame_b"])
P21a = perm21(pa); P21b = perm21(pb)

st = list(csv.DictReader(open(os.path.join(DATA, "site_table.csv"))))
mass_site = np.array([float(r["mass_amu"]) for r in st])   # site_id 0..6 ascending
M = np.repeat(mass_site, 3)          # (21,) site-major
sqrtM = np.sqrt(M)

A = np.load(os.path.join(DATA, "frame_a_coords.npy"))[pa]    # (7,3)
B = np.load(os.path.join(DATA, "frame_b_coords.npy"))[pb]    # (7,3)
HA = np.load(os.path.join(DATA, "frame_a_hessian.npy"))[np.ix_(P21a, P21a)]
HB = np.load(os.path.join(DATA, "frame_b_hessian.npy"))[np.ix_(P21b, P21b)]

manifest = json.load(open(os.path.join(DATA, "system_manifest.json")))
NULL_RANK = int(manifest["null_rank"]); RESOLVED_RANK = int(manifest["resolved_rank"])
FREQ_SCALE = float(manifest["freq_scale_factor"])
assert NULL_RANK + RESOLVED_RANK == 3 * NSITE

med = json.load(open(os.path.join(DATA, "medium_response.json")))
COUPLING_EV = float(med["coupling_eV"]); TEMP_K = float(med["temp_K"])

grid = list(csv.DictReader(open(os.path.join(DATA, "driving_force_grid.csv"))))
grid_ids = [int(r["grid_id"]) for r in grid]
axis = np.array([float(r["axis_eV"]) for r in grid])

def kabsch(P, Q):
    cp = P.mean(0); cq = Q.mean(0); Pc = P - cp; Qc = Q - cq
    U, S, Vt = np.linalg.svd(Pc.T @ Qc)
    d = np.sign(np.linalg.det(Vt.T @ U.T)); D = np.diag([1.0, 1.0, float(d)])
    return Vt.T @ D @ U.T, cq - (Vt.T @ D @ U.T) @ cp

def transport(vec21, R):
    m = vec21.reshape(NSITE, 3)
    return (R @ m.T).T.reshape(21)

def mw_hessian(H):
    inv = np.diag(1.0 / np.sqrt(M))
    return inv @ H @ inv

def retained_modes(H):
    w2, V = np.linalg.eigh(mw_hessian(H))
    keep = np.arange(NULL_RANK, 3 * NSITE)
    return w2[keep], V[:, keep]

# ---------------- alignment (B) ----------------
Rf, tf = kabsch(B, A)    # align B onto A  -> forward (B-in-A)
Rb, tb = kabsch(A, B)    # align A onto B  -> backward (A-in-B)
B_in_A = (Rf @ B.T).T + tf
A_in_B = (Rb @ A.T).T + tb
disp_f = (B_in_A - A).reshape(21)   # aligned source (B) - reference (A)
disp_b = (A_in_B - B).reshape(21)   # aligned source (A) - reference (B)
q_f = sqrtM * disp_f
q_b = sqrtM * disp_b
aligned_displacement_mw = np.stack([q_f, q_b], axis=0)       # (2,21)
rmsd_f = float(np.sqrt(np.sum(disp_f**2) / NSITE))
rmsd_b = float(np.sqrt(np.sum(disp_b**2) / NSITE))

# ---------------- vibrational modes (A) ----------------
w2A, VA = retained_modes(HA)
w2B, VB = retained_modes(HB)
vibrational_basis_mw = np.stack([VA, VB], axis=0)           # (2,21,15)

# ---------------- projected displacement ----------------
proj_f = VA @ (VA.T @ q_f)
proj_b = VB @ (VB.T @ q_b)
projected_displacement_mw = np.stack([proj_f, proj_b], axis=0)  # (2,21)
rigid_norm_f = float(np.linalg.norm(q_f - proj_f))
rigid_norm_b = float(np.linalg.norm(q_b - proj_b))
proj_norm_f = float(np.linalg.norm(proj_f))
proj_norm_b = float(np.linalg.norm(proj_b))

# ---------------- cross-frame overlap (magnitude-based) ----------------
def transported_basis(V, R):
    return np.column_stack([transport(V[:, j], R) for j in range(V.shape[1])])
VB_in_A = transported_basis(VB, Rf)
VA_in_B = transported_basis(VA, Rb)
mode_overlap = np.stack([
    np.abs(VA.T @ VB_in_A),
    np.abs(VB.T @ VA_in_B),
], axis=0)                                                                    # (2,15,15)

# ---------------- transported mode projection (magnitude-based) ----------------
transported_mode_projection = np.stack([
    np.column_stack([np.abs(VA.T @ q_f), np.abs(VB_in_A.T @ q_f)]),
    np.column_stack([np.abs(VB.T @ q_b), np.abs(VA_in_B.T @ q_b)]),
], axis=0)                                                                    # (2,15,2)

# ---------------- mode projection (3 cols) ----------------
cf = VA.T @ q_f
cb = VB.T @ q_b
mode_projection = np.stack([
    np.column_stack([cf, np.abs(cf), 0.5 * w2A * cf**2]),
    np.column_stack([cb, np.abs(cb), 0.5 * w2B * cb**2]),
], axis=0)                                                                    # (2,15,3)
dominant_f = int(np.argmax(np.abs(cf)))
dominant_b = int(np.argmax(np.abs(cb)))

# ---------------- lambda (D/E/F) ----------------
def full_quad(q, H):
    return float(0.5 * q @ mw_hessian(H) @ q)
lam4p_f = full_quad(q_f, HA); lam4p_b = full_quad(q_b, HB)
lamnm_f = float(np.sum(0.5 * w2A * cf**2)); lamnm_b = float(np.sum(0.5 * w2B * cb**2))
closure_f = abs(lam4p_f - lamnm_f); closure_b = abs(lam4p_b - lamnm_b)
inner_eff = 0.5 * (lam4p_f + lam4p_b)
eff_consistency = abs(inner_eff - 0.5 * (lamnm_f + lamnm_b))
dielectric_factor = (1.0 / med["eps_fast"] - 1.0 / med["eps_slow"])
lam_outer = dielectric_factor * med["span_A"]     # (F); 1/2-factor uncertainty in header
lam_total = inner_eff + lam_outer

# ---------------- Marcus rate (G/H) ----------------
def marcus_k(dG_eV, lam_eV, V_eV, T):
    VJ = V_eV * EV2J; lJ = lam_eV * EV2J; dGJ = dG_eV * EV2J
    pref = (2.0 * np.pi / HBAR) * VJ**2 * (4.0 * np.pi * lJ * KB * T) ** (-0.5)
    return float(pref * np.exp(-(lJ + dGJ) ** 2 / (4.0 * lJ * KB * T)))

k_self = marcus_k(0.0, lam_total, COUPLING_EV, TEMP_K)
k_curve = np.array([marcus_k(g, lam_total, COUPLING_EV, TEMP_K) for g in axis])
log10_k = np.log10(k_curve)
peak_idx = int(np.argmax(k_curve))
rate_peak_grid_id = int(grid_ids[peak_idx]); rate_peak_axis = float(axis[peak_idx])
rate_peak_s_inv = float(k_curve[peak_idx])
inverted_mask = axis < (-lam_total)
inverted_detected = bool(np.any(inverted_mask))
if inverted_detected:
    first_idx = int(np.argmax(inverted_mask))
    first_inverted_grid_id = int(grid_ids[first_idx]); first_inverted_axis = float(axis[first_idx])
else:
    first_inverted_grid_id = None; first_inverted_axis = None

# ---------------- write npy ----------------
for name, arr in [("aligned_displacement_mw", aligned_displacement_mw),
                  ("vibrational_basis_mw", vibrational_basis_mw),
                  ("mode_overlap", mode_overlap),
                  ("projected_displacement_mw", projected_displacement_mw),
                  ("transported_mode_projection", transported_mode_projection),
                  ("mode_projection", mode_projection)]:
    np.save(os.path.join(OUT, name + ".npy"), arr)

# ---------------- write csv ----------------
with open(os.path.join(OUT, "lambda_summary.csv"), "w", newline="") as f:
    w = csv.writer(f); w.writerow(["lambda_4pt_forward_eV", "lambda_4pt_backward_eV",
        "lambda_nm_forward_eV", "lambda_nm_backward_eV", "lambda_inner_effective_eV",
        "lambda_outer_eV", "lambda_total_eV", "k_self_exchange_s_inv"])
    w.writerow([lam4p_f, lam4p_b, lamnm_f, lamnm_b, inner_eff, lam_outer, lam_total, k_self])
with open(os.path.join(OUT, "rate_curve.csv"), "w", newline="") as f:
    w = csv.writer(f); w.writerow(["grid_id", "axis_eV", "k_et_s_inv", "log10_k_et_s_inv"])
    for i in range(len(grid_ids)):
        w.writerow([grid_ids[i], axis[i], k_curve[i], log10_k[i]])

# ---------------- diagnostics (exactly the 17 required keys) ----------------
diagnostics = {
    "alignment_rmsd_forward_A": rmsd_f, "alignment_rmsd_backward_A": rmsd_b,
    "closure_error_forward_eV": closure_f, "closure_error_backward_eV": closure_b,
    "effective_inner_consistency_eV": eff_consistency,
    "rigid_norm_forward": rigid_norm_f, "rigid_norm_backward": rigid_norm_b,
    "projected_norm_forward": proj_norm_f, "projected_norm_backward": proj_norm_b,
    "dominant_mode_forward": dominant_f, "dominant_mode_backward": dominant_b,
    "rate_peak_grid_id": rate_peak_grid_id, "rate_peak_axis_eV": rate_peak_axis,
    "rate_peak_s_inv": rate_peak_s_inv, "inverted_region_detected": inverted_detected,
    "first_inverted_grid_id": first_inverted_grid_id, "first_inverted_axis_eV": first_inverted_axis,
}
with open(os.path.join(OUT, "diagnostics.json"), "w") as f:
    json.dump(diagnostics, f, indent=2)


# ---- fallback PNG writer (used only when matplotlib is unavailable) ----
def _write_png(path, rgb):
    import zlib, struct
    h, w = rgb.shape[:2]
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
    def chunk(typ, data):
        c = typ + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) +
                chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))

def _draw_line(img, x0, y0, x1, y1, color, thick=1):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx = abs(x1 - x0); dy = -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        for ox in range(thick):
            for oy in range(thick):
                xx, yy = x0 + ox, y0 + oy
                if 0 <= xx < img.shape[1] and 0 <= yy < img.shape[0]:
                    img[yy, xx] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy

def _make_overview_fallback(path, A, B, B_in_A, rmsd_f, w2A, w2B, FREQ_SCALE,
                            axis, k_curve, lam_total, rate_peak_axis,
                            cf, cb, dominant_f, dominant_b, case_id):
    H, W = 620, 820
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    BLACK=(0,0,0); BLUE=(31,119,180); RED=(214,39,40); PURP=(148,103,189); GRAY=(110,110,110)
    # title bar
    for yy in range(0, 4):
        img[yy, :] = BLACK
    # panel 1: rate curve (log10 k vs dG)
    _draw_line(img, 60, 300, 780, 300, GRAY, 1)
    _draw_line(img, 60, 40,  60, 300, GRAY, 1)
    _draw_line(img, 780, 300, 780, 40, GRAY, 1)
    _draw_line(img, 60, 40, 780, 40, GRAY, 1)
    ax_min, ax_max = float(axis.min()), float(axis.max())
    logk = np.log10(k_curve); lk_min, lk_max = float(logk.min()), float(logk.max())
    def px(xv): return 60 + (xv - ax_min)/(ax_max - ax_min + 1e-12)*(780 - 60)
    def py(yv): return 300 - (yv - lk_min)/(lk_max - lk_min + 1e-12)*(300 - 60)
    for i in range(len(axis) - 1):
        _draw_line(img, px(axis[i]), py(logk[i]), px(axis[i+1]), py(logk[i+1]), PURP, 2)
    pk = int(np.argmax(k_curve))
    _draw_line(img, px(axis[pk])-4, py(logk[pk])-4, px(axis[pk])+4, py(logk[pk])+4, RED, 1)
    # panel 2: signed modal coordinates
    _draw_line(img, 60, 580, 780, 580, GRAY, 1)
    _draw_line(img, 60, 360,  60, 580, GRAY, 1)
    cmax = float(np.abs(np.concatenate([cf, cb])).max()) + 1e-12
    def py2(v): return 470 - (v/cmax)*100
    n = 15
    for k in range(n):
        xx = 80 + k*(700/n)
        _draw_line(img, xx,   470, xx,   py2(cf[k]), BLUE, 3)
        _draw_line(img, xx+6, 470, xx+6, py2(cb[k]), RED, 3)
    _write_png(path, img)

# ---------------- overview.png ----------------
if HAVE_MPL:
    freqA = np.sqrt(w2A) * FREQ_SCALE   # cm^-1 (display only)
    freqB = np.sqrt(w2B) * FREQ_SCALE
    fig, ax = plt.subplots(2, 2, figsize=(13, 10))
    fig.suptitle("Marcus ET reorganization-energy response  (case "
                 f"{manifest.get('case_id','')})", fontsize=13)

    ax0 = ax[0, 0]
    ax0.scatter(A[:, 0], A[:, 1], A[:, 2], c="tab:blue", label="frame A (ref)", s=40)
    ax0.scatter(B[:, 0], B[:, 1], B[:, 2], c="tab:red", label="frame B (raw)", s=40)
    ax0.scatter(B_in_A[:, 0], B_in_A[:, 1], B_in_A[:, 2], c="tab:green",
                marker="^", label="B aligned into A", s=40)
    ax0.set_title(f"Kabsch alignment  (fwd RMSD={rmsd_f:.4f} A)")
    ax0.set_xlabel("x"); ax0.set_ylabel("y"); ax0.set_zlabel("z"); ax0.legend(fontsize=8)

    ax1 = ax[0, 1]
    x = np.arange(15)
    ax1.stem(x - 0.2, freqA, linefmt="C0-", markerfmt="C0o", basefmt=" ", label="frame A")
    ax1.stem(x + 0.2, freqB, linefmt="C1-", markerfmt="C1o", basefmt=" ", label="frame B")
    ax1.set_title("Retained vibrational frequencies (cm$^{-1}$, display only)")
    ax1.set_xlabel("retained mode (asc $\\omega^2$)"); ax1.set_ylabel("cm$^{-1}$"); ax1.legend()

    ax2 = ax[1, 0]
    ax2.semilogy(axis, k_curve, "o-", color="tab:purple")
    ax2.axvline(-lam_total, color="k", ls="--", lw=1,
                label=f"peak @ $\\Delta G$=-$\\lambda$={-lam_total:.2f} eV")
    ax2.plot(rate_peak_axis, rate_peak_s_inv, "r*", ms=14, label="grid max")
    ax2.set_title(f"Marcus rate curve  ($\\lambda_{{total}}$={lam_total:.3f} eV)")
    ax2.set_xlabel("$\\Delta G^\\circ$ (eV)"); ax2.set_ylabel("$k_{ET}$ (s$^{-1}$)")
    ax2.legend(fontsize=8); ax2.grid(alpha=0.3)

    ax3 = ax[1, 1]
    ax3.bar(x - 0.2, cf, color="tab:blue", alpha=0.8, label="forward (B-in-A)")
    ax3.bar(x + 0.2, cb, color="tab:red", alpha=0.8, label="backward (A-in-B)")
    ax3.axvline(dominant_f - 0.2, color="tab:blue", ls=":", lw=1)
    ax3.axvline(dominant_b + 0.2, color="tab:red", ls=":", lw=1)
    ax3.set_title(f"Signed modal coordinates  (dominant f={dominant_f}, b={dominant_b})")
    ax3.set_xlabel("retained mode"); ax3.set_ylabel("$q_k$"); ax3.legend(fontsize=8)

    fig.tight_layout(rect=[0, 0, 1, 0.97])
    fig.savefig(os.path.join(OUT, "overview.png"), dpi=110)
    plt.close(fig)
else:
    _make_overview_fallback(
        os.path.join(OUT, 'overview.png'),
        A, B, B_in_A, rmsd_f, w2A, w2B, FREQ_SCALE,
        axis, k_curve, lam_total, rate_peak_axis,
        cf, cb, dominant_f, dominant_b, manifest.get('case_id', ''))

# ---------------- console summary ----------------
print("=== SHAPES ===")
for name in ["aligned_displacement_mw", "vibrational_basis_mw", "mode_overlap",
             "projected_displacement_mw", "transported_mode_projection", "mode_projection"]:
    print(f"  {name}: {np.load(os.path.join(OUT, name + '.npy')).shape}")
print("  rate_curve rows:", len(grid_ids))
print("=== LAMBDA (eV) ===")
print(f"  4pt fwd/bwd : {lam4p_f:.6f} / {lam4p_b:.6f}")
print(f"  nm  fwd/bwd : {lamnm_f:.6f} / {lamnm_b:.6f}")
print(f"  closure f/b : {closure_f:.2e} / {closure_b:.2e}")
print(f"  inner_eff   : {inner_eff:.6f}   eff_consistency: {eff_consistency:.2e}")
print(f"  dielectric  : {dielectric_factor:.6f}  outer: {lam_outer:.6f}")
print(f"  total       : {lam_total:.6f}")
print(f"  k_self      : {k_self:.6e} s^-1")
print("=== DIAGNOSTICS ===")
print(json.dumps(diagnostics, indent=2))
print("=== DONE: all outputs written to", OUT, "===")
