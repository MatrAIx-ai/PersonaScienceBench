#!/usr/bin/env python3
"""
2D FES of ACE-CYS-NME in vacuum at 300 K via well-tempered metadynamics.
OpenMM Reference platform + AMBER ff14SB + NoCutoff.
CVs: phi=C(ACE)-N(CYS)-CA(CYS)-C(CYS) [4,6,8,15]
     psi=N(CYS)-CA(CYS)-C(CYS)-N(NME) [6,8,15,17]
"""
import numpy as np, os, sys, time
try:
    import openmm, openmm.app as app, openmm.unit as unit
    print(f"[OK] OpenMM {openmm.__version__}")
except ImportError as e:
    print(f"[FATAL] OpenMM import failed: {e}"); sys.exit(1)

T_K=300.0; kT=0.008314472*T_K
DELTA=5.0; H0=1.0; SIG_DEG=5.0; SIG_RAD=np.radians(SIG_DEG)
DEP_INT=100; DT_FS=2.0; N_STEPS=50_000_000
CONV_WIN=5_000_000; CONV_THR=0.5
NG=72; GMIN=-180.0; GW=360.0/NG
GC=GMIN+GW*(np.arange(NG)+0.5)
NBUF=500
PHI_IDX=[4,6,8,15]; PSI_IDX=[6,8,15,17]

def compute_dihedral(pos,i1,i2,i3,i4):
    from openmm import Vec3
    p1=Vec3(*pos[i1]);p2=Vec3(*pos[i2]);p3=Vec3(*pos[i3]);p4=Vec3(*pos[i4])
    b1=p2-p1;b2=p3-p2;b3=p4-p3
    n1=b1.cross(b2);n2=b2.cross(b3)
    n1n=n1/(n1.dot(n1))**0.5;n2n=n2/(n2.dot(n2))**0.5
    x=n1n.dot(n2n);y=(n1n.cross(n2n)).dot(b2/(b2.dot(b2))**0.5)
    return np.degrees(np.arctan2(y,x))

def both_dih(pos):
    return compute_dihedral(pos,*PHI_IDX),compute_dihedral(pos,*PSI_IDX)

def _wrap(a): return ((a+180.0)%360.0)-180.0

def _add_g(grid,p,s,h,sigma=SIG_DEG):
    sg=sigma/GW;ext=max(1,int(np.ceil(3*sg)))
    pi=int((p-GMIN)/GW)%NG;pj=int((s-GMIN)/GW)%NG
    for di in range(-ext,ext+1):
        for dj in range(-ext,ext+1):
            i=(pi+di)%NG;j=(pj+dj)%NG
            grid[i,j]+=h*np.exp(-0.5*(di*GW/sigma)**2-0.5*(dj*GW/sigma)**2)

def _bias_grid(grid,p,s):
    pf=(p-GMIN)/GW;sf=(s-GMIN)/GW
    i0=int(pf)%NG;j0=int(sf)%NG;i1=(i0+1)%NG;j1=(j0+1)%NG
    di=pf-int(pf);dj=sf-int(sf)
    return ((1-di)*(1-dj)*grid[i0,j0]+(1-di)*dj*grid[i0,j1]+
            di*(1-dj)*grid[i1,j0]+di*dj*grid[i1,j1])

def build_fes(all_g,cv):
    Vg=np.zeros((NG,NG))
    for gp,gs,gh in all_g: _add_g(Vg,gp,gs,gh)
    Pg=np.zeros((NG,NG))
    for cp,cs in cv:
        Pg[int((cp-GMIN)/GW)%NG,int((cs-GMIN)/GW)%NG]+=1
    Pt=Pg.sum()
    if Pt>0: Pg/=Pt
    F=np.where(Pg>0,-kT*np.log(np.where(Pg>0,Pg,1.0))-Vg,np.nan)
    Vm=Vg.max()
    Fb=np.where(Vg>1e-10,-(kT+DELTA)*np.log(np.where(Vg>1e-10,Vg,1.0)/Vm),np.nan)
    F=np.where(np.isnan(F),Fb,F);F=np.where(np.isnan(F),0.0,F)
    return F-F.min()

def find_minima(fes,mx=5):
    from scipy.ndimage import label,maximum_filter
    inv=-fes;nb=maximum_filter(inv,size=3,mode='wrap')
    lm=(inv==nb)&(fes<np.percentile(fes,70))
    lbl,n=label(lm,structure=np.ones((3,3)))
    if n==0: return []
    sc=[]
    for i in range(1,n+1):
        m=lbl==i;idx=np.argmin(fes[m])
        fi,fj=np.unravel_index(np.where(m)[0][idx],fes.shape)
        sc.append((fes[fi,fj],fi,fj))
    sc.sort();mins=[]
    for r,(f0,fi,fj) in enumerate(sc[:mx]):
        fi2=(fi-1)%NG;fi3=(fi+1)%NG;fj2=(fj-1)%NG;fj3=(fj+1)%NG
        di=0.5*(fes[fi2,fj]-fes[fi3,fj])/(fes[fi2,fj]-2*fes[fi,fj]+fes[fi3,fj]+1e-15)
        dj=0.5*(fes[fi,fj2]-fes[fi,fj3])/(fes[fi,fj2]-2*fes[fi,fj]+fes[fi,fj3]+1e-15)
        mins.append({'name':f'min_{r+1}','cv1':round(_wrap(GC[fi]+di*GW),2),
                     'cv2':round(_wrap(GC[fj]+dj*GW),2),'delta_g_kj_mol':round(f0,4)})
    mins.sort(key=lambda x:x['delta_g_kj_mol'])
    uniq=[]
    for m in mins:
        dup=any(min(abs(m['cv1']-u['cv1']),360-abs(m['cv1']-u['cv1']))<10 and
                min(abs(m['cv2']-u['cv2']),360-abs(m['cv2']-u['cv2']))<10 for u in uniq)
        if not dup: uniq.append(m)
    for i,m in enumerate(uniq[:mx]): m['name']=f'min_{i+1}'
    return uniq[:mx]

def make_plot(fes,mins,fp):
    import matplotlib; matplotlib.use('Agg'); import matplotlib.pyplot as plt
    fig,ax=plt.subplots(figsize=(8,6))
    im=ax.pcolormesh(GC,GC,fes.T,cmap='viridis',shading='auto',vmin=0,vmax=max(fes.max(),10))
    fig.colorbar(im,ax=ax,label='Free energy (kJ/mol)')
    ax.set_xlabel(r'$\phi$ (degrees)');ax.set_ylabel(r'$\psi$ (degrees)')
    ax.set_title('2D FES - ACE-CYS-NME (well-tempered metadynamics, ff14SB)')
    ax.set_xlim(-180,180);ax.set_ylim(-180,180)
    for m in mins:
        ax.plot(m['cv1'],m['cv2'],'r*',ms=15,zorder=5)
        ax.annotate(f"{m['name']}\ndG={m['delta_g_kj_mol']:.1f}",(m['cv1'],m['cv2']),
                    textcoords='offset points',xytext=(8,8),fontsize=8,color='red')
    plt.tight_layout();plt.savefig(fp,dpi=150);plt.close()
    print(f"[plot] {fp}")

def main():
    os.makedirs('results',exist_ok=True)
    t0=time.time()
    print("[setup] Loading PDB + ff14SB...")
    pdb=app.PDBFile('data/dipeptide.pdb')
    ff=app.ForceField('amber14sb.xml')
    system=ff.createSystem(pdb.topology,nonbondedMethod=app.NoCutoff,constraints=None)
    platform=openmm.Platform.getPlatformByName('Reference')
    print(f"[setup] {system.getNumParticles()} particles, {len(system.getForces())} forces")
    integrator=openmm.LangevinIntegrator(T_K*unit.kelvin,1.0/unit.picoseconds,DT_FS*unit.femtoseconds)
    sim=app.Simulation(pdb.topology,system,integrator,platform)
    sim.context.setPositions(pdb.positions)
    sim.context.setVelocitiesToTemperature(T_K*unit.kelvin)
    # Metadynamics bias: CustomExternalForce with NBUF Gaussians
    s2=SIG_RAD**2
    terms=[f'-H{i}*exp(-(1-cos(phi-phi{i}))/s2)*exp(-(1-cos(psi-psi{i}))/s2)' for i in range(NBUF)]
    bf=openmm.CustomExternalForce(' + '.join(terms))
    for i in range(NBUF):
        bf.addGlobalParameter(f'phi{i}',0.0);bf.addGlobalParameter(f'psi{i}',0.0);bf.addGlobalParameter(f'H{i}',0.0)
    bf.addGlobalParameter('s2',s2);bf.addGlobalParameter('phi',0.0);bf.addGlobalParameter('psi',0.0)
    system.addForce(bf);bf.addParticle(0,[])
    sim.context=openmm.Context(system,integrator,platform)
    sim.context.setPositions(pdb.positions)
    sim.context.setVelocitiesToTemperature(T_K*unit.kelvin)
    all_g=[];cv=[];snaps=[]
    bphi=np.zeros(NBUF);bpsy=np.zeros(NBUF);bH=np.zeros(NBUF);bidx=0;bn=0
    bg=np.zeros((NG,NG))
    print(f"[run] {N_STEPS} steps ({N_STEPS*DT_FS/1e6:.0f} ns)")
    for st in range(N_STEPS):
        sim.context.getIntegrator().step(1)
        pos=sim.context.getState(getPositions=True).getPositions()
        phi,psi=both_dih(pos)
        bf.setGlobalParameterByName('phi',np.radians(phi))
        bf.setGlobalParameterByName('psi',np.radians(psi))
        if st%10==0: cv.append((phi,psi))
        if st%DEP_INT==0:
            vb=_bias_grid(bg,phi,psi)
            h=H0*max(0.0,1.0-vb/(2*DELTA))
            if h>0:
                _add_g(bg,phi,psi,h)
                bphi[bidx]=np.radians(phi);bpsy[bidx]=np.radians(psi);bH[bidx]=h
                bidx=(bidx+1)%NBUF;bn=min(bn+1,NBUF)
                for i in range(bn):
                    bi=(bidx-bn+i)%NBUF
                    bf.setGlobalParameterByName(f'phi{bi}',bphi[bi])
                    bf.setGlobalParameterByName(f'psi{bi}',bpsy[bi])
                    bf.setGlobalParameterByName(f'H{bi}',bH[bi])
                all_g.append((phi,psi,h))
        if (st+1)%CONV_WIN==0:
            f=build_fes(all_g,cv);snaps.append(f.copy())
            print(f"  {(st+1)*DT_FS/1e6:5.0f} ns Fmax={f.max():.2f} t={time.time()-t0:.0f}s G={len(all_g)}")
    fes=build_fes(all_g,cv)
    print(f"[done] {N_STEPS*DT_FS/1e6:.0f} ns G={len(all_g)} t={time.time()-t0:.0f}s")
    print("\n=== Convergence ===")
    if len(snaps)>=2:
        for i in range(1,len(snaps)):
            d=np.abs(snaps[i]-snaps[i-1]).max()
            print(f"  W{i}->W{i+1}: max|dF|={d:.4f} kJ/mol")
        ld=np.abs(snaps[-1]-snaps[-2]).max()
        print(f"  Converged (<{CONV_THR}): {'YES' if ld<CONV_THR else 'NO'}")
    print(f"\n=== FES === shape={fes.shape} min={fes.min():.4f} max={fes.max():.4f} mean={fes.mean():.4f}")
    np.save('results/fes_2d.npy',fes.astype(np.float64));print("[save] results/fes_2d.npy")
    mins=find_minima(fes)
    print(f"\n=== Minima ({len(mins)}) ===")
    for m in mins: print(f"  {m['name']}: phi={m['cv1']:8.2f} psi={m['cv2']:8.2f} dG={m['delta_g_kj_mol']:8.4f}")
    with open('results/minima.csv','w') as f:
        f.write('name,cv1,cv2,delta_g_kj_mol\n')
        for m in mins: f.write(f"{m['name']},{m['cv1']},{m['cv2']},{m['delta_g_kj_mol']}\n")
    print("[save] results/minima.csv")
    make_plot(fes,mins,'results/fes_plot.png')
    cvt="""Collective Variables - ACE-CYS-NME Metadynamics
=====================================================
System: ACE-CYS-NME (23 atoms), vacuum, 300 K
Force field: AMBER ff14SB (amber14sb.xml), NoCutoff
Platform: OpenMM Reference

CV1 = phi: C(ACE)-N(CYS)-CA(CYS)-C(CYS)
  PDB serials (1-based): 5, 7, 9, 16 | 0-based: 4, 6, 8, 15
  Periodicity 360 deg, range [-180, 180)

CV2 = psi: N(CYS)-CA(CYS)-C(CYS)-N(NME)
  PDB serials (1-based): 7, 9, 16, 18 | 0-based: 6, 8, 15, 17
  Periodicity 360 deg, range [-180, 180)

Rationale: Single CYS residue between ACE/NME caps -> one phi-psi pair
spans the full backbone conformational space (Ramachandran).

Metadynamics: well-tempered, Delta=5 kJ/mol, H0=1 kJ/mol, sigma=5 deg,
deposition every 100 steps (0.2 ps at 2 fs timestep).
Bias force: CustomExternalForce, rolling window of 500 Gaussians.
Grid: 72x72, [-180,180), 5 deg cell-centred.
FES: direct reweighting F=-kT*ln[P*exp(V/kT)].
"""
    with open('results/cv_definition.txt','w') as f: f.write(cvt)
    print("[save] results/cv_definition.txt")
    print("\n=== All outputs generated ===")

if __name__=='__main__': main()
