    def my(v): return y1 - (v - ymin) / (ymax - ymin) * (y1 - y0)
    xticks = [(mx(v), "%.0f" % v) for v in range(2, 6)]
    yticks = [(my(v), "%.0f" % v) for v in range(-3, int(ymax), 3)]
    def extra(im):
        for gx in range(2, 6):
