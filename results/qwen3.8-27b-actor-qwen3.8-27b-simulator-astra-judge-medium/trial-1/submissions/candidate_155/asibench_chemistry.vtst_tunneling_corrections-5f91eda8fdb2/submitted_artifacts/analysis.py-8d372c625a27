#!/usr/bin/env python3
"""
VTST + semiclassical tunneling analysis of a 2D reaction-energy dataset.

Crossing from the lower-x (reactant) basin to the higher-x (product) basin:
  * free-energy profile from the ordered corridor (curve_samples) with a
    quantum-harmonic transverse mode built from the local transverse scans
    (tube_scan);
  * TST rates at the conventional saddle ("local") and at the VTST-optimized
    free-energy dividing surface ("optimized");
  * 1D corridor WKB transmission coefficient (Boltzmann-averaged, normalized
    to 1 in the over-barrier limit) -> tunneling-enhanced rate;
  * 2D minimum-action (WKB) path on the surface grid for the 2D action;
  * isotope mass-scaling cases (longitudinal mass -> actions, transverse mass
    -> transverse frequencies / vibrational free energies).

All rates in s^-1; energies in kJ/mol; coordinates are mass-weighted reduced
coordinates; constants taken from data/system_manifest.json (used as-is).
"""
import json
import heapq
import numpy as np
import pandas as pd
import scipy.optimize as opt
from scipy.interpolate import CubicSpline, RegularGridInterpolator

R = 0.00831446261815324          # kJ mol^-1 K^-1
HC = 0.0119626565638697          # kJ mol^-1 cm^-1
HCK = 1.438776877                # K cm  (hc/kB)
KBH = 20836619120.0              # s^-1 K^-1 (kB/h)
FREQ_SCALE = 95.0                # cm^-1 per sqrt(kJ mol^-1 coord^-2 / amu)
ACTION_SCALE = 1.24              # semiclassical action scale (effective hbar)
trap = np.trapezoid

# ----------------------------------------------------------------------------
# 1. Load data
# ----------------------------------------------------------------------------
curve = pd.read_csv("data/curve_samples.csv")
tube = pd.read_csv("data/tube_scan.csv")
kin = pd.read_csv("data/kinetic_metric.csv")
temps = pd.read_csv("data/temperature_grid.csv")
iso = pd.read_csv("data/isotope_cases.csv")
surf = pd.read_csv("data/surface_samples.csv")
manifest = json.load(open("data/system_manifest.json"))

# ----------------------------------------------------------------------------
# 2. Corridor potential V(s)  (q_offset = 0 samples)
# ----------------------------------------------------------------------------
onpath = (tube[np.isclose(tube.q_offset, 0.0)]
          .merge(curve[["point_id", "s_coord"]], on="point_id")
          .sort_values("point_id").reset_index(drop=True))
S = onpath.s_coord.values
V = onpath.potential_kj_mol.values
Xc = onpath.x.values
Yc = onpath.y.values
NPT = len(S)
V_R = float(V[0])                       # reactant reference (corridor start)
E_B = float(V.max())                    # conventional saddle (corridor max)
I_SADDLE = int(np.argmax(V))            # point 60
Cs = CubicSpline(S, V)

def corridor_turning_points(E):
    """s1, s2 where V(s) = E (clamped to corridor ends)."""
    if E >= E_B:
        return S[I_SADDLE], S[I_SADDLE]
    r1 = S[0] if Cs(S[0]) >= E else opt.brentq(lambda x: Cs(x) - E, S[0], S[I_SADDLE])
    r2 = S[-1] if Cs(S[-1]) >= E else opt.brentq(lambda x: Cs(x) - E, S[I_SADDLE], S[-1])
    return r1, r2

def corridor_action(E, mu_long=1.0, n=4001):
    """2 * integral sqrt(2 mu (V(s)-E)) ds between turning points."""
    if E >= E_B:
        return 0.0
    r1, r2 = corridor_turning_points(E)
    if r2 - r1 < 1e-10:
        return 0.0
    gg = np.linspace(r1, r2, n)
    return 2.0 * trap(np.sqrt(2.0 * mu_long * np.maximum(Cs(gg) - E, 0.0)), gg)

# ----------------------------------------------------------------------------
# 3. Transverse scans: curvature (central 5 offsets) -> frequencies
# ----------------------------------------------------------------------------
k_curv = np.zeros(NPT)
for i in range(NPT):
    sc = tube[tube.point_id == i].sort_values("q_offset")
    c5 = sc.iloc[4:9]
    k_curv[i] = np.polyfit(c5.q_offset.values, c5.potential_kj_mol.values, 2)[0]

def transverse_freq(k_curv_arr, mu_trans):
    return FREQ_SCALE * np.sqrt(k_curv_arr / mu_trans)

# ----------------------------------------------------------------------------
# 4. Free energy profile (quantum-harmonic transverse mode)
#    F(s,T) = V(s) + 1/2 hc nu + RT ln(1 - exp(-hc nu / kT))
# ----------------------------------------------------------------------------
def free_energy_profile(T, mu_trans=1.0):
    nu = transverse_freq(k_curv, mu_trans)
    Fvib = 0.5 * HC * nu + R * T * np.log(1.0 - np.exp(-HCK * nu / T))
    return V + Fvib

def vtst_point(F):
    """VTST dividing surface = location of the free-energy maximum."""
    return int(np.argmax(F))

# ----------------------------------------------------------------------------
# 5. 1D WKB transmission and T-dependent (Boltzmann-averaged) coefficient
#    kappa_1D(T) = 1 + I_tun(T)/I_over(T),
#    I_tun  = int_0^Eb kappa(E) e^{-beta E} dE ,  I_over = e^{-beta Eb}/beta
#    (ratio of the full 1D semiclassical rate to its over-barrier part;
#     kappa_1D -> 1 as T -> inf)
# ----------------------------------------------------------------------------
E_TUN = np.linspace(0.0, E_B, 4001)

def kappa_E(S_of_E):
    return 1.0 / (1.0 + np.exp(S_of_E / ACTION_SCALE))

def kappa_1D(T, S_arr):
    """S_arr: corridor actions on E_TUN (precomputed)."""
    beta = 1.0 / (R * T)
    kap = kappa_E(S_arr)
    I_tun = trap(kap * np.exp(-beta * E_TUN), E_TUN)
    I_over = np.exp(-beta * E_B) / beta
    return 1.0 + I_tun / I_over

S_TUN = np.array([corridor_action(e) for e in E_TUN])   # light, mu_long = 1

def crossover_T(S_arr, threshold=1.2, t_lo=100.0, t_hi=5000.0, n=1961):
    Tg = np.linspace(t_lo, t_hi, n)
    k = np.array([kappa_1D(t, S_arr) for t in Tg])
    d = k - threshold
    if d.min() > 0 or d.max() < 0:
        return None
    i = int(np.argmax(d[:-1] * d[1:] < 0))
    t1, t2 = Tg[i], Tg[i + 1]
    k1, k2 = d[i], d[i + 1]
    return float(t1 + (t2 - t1) * (-k1) / (k2 - k1))

# ----------------------------------------------------------------------------
# 6. 2D minimum-action path (WKB) on a 4x-refined interpolated surface grid
# ----------------------------------------------------------------------------
X = np.unique(surf.x.values)
Y = np.unique(surf.y.values)
Wg = (surf.pivot(index="y", columns="x", values="potential_kj_mol")
      .reindex(index=Y, columns=X).values - V_R)
interp2d = RegularGridInterpolator((Y, X), Wg, method="cubic",
                                   bounds_error=False, fill_value=None)
REF = 4
dxf = (X[1] - X[0]) / REF
dyf = (Y[1] - Y[0]) / REF
Xf = np.arange(X[0], X[-1] + 1e-12, dxf)
Yf = np.arange(Y[0], Y[-1] + 1e-12, dyf)
_pts = np.stack(np.meshgrid(Yf, Xf, indexing="ij"), axis=-1)
Wf = interp2d(_pts)
NYF, NXF = Wf.shape
J_MID = NXF // 2                      # x = 0 column

def seg_cost(wa, wb, L, E, mu_long):
    """Exact integral of sqrt(2 mu max(W-E,0)) along a segment with linear W."""
    if wa <= E and wb <= E:
        return 0.0
    if wa > E and wb > E:
        a = wb - wa
        if abs(a) < 1e-14:
            return np.sqrt(2.0 * mu_long * (wa - E)) * L
        return (2.0 * L * np.sqrt(2.0 * mu_long) / (3.0 * a)) * ((wb - E) ** 1.5 - (wa - E) ** 1.5)
    t0 = (E - wa) / (wb - wa)
    if wb > E:
        return np.sqrt(2.0 * mu_long * (wb - E)) * L * (2.0 / 3.0) * (1.0 - t0) ** 1.5
    return np.sqrt(2.0 * mu_long * (wa - E)) * L * (2.0 / 3.0) * t0 ** 1.5

def action2d(E, mu_long=1.0, want_path=False):
    """2 * minimum (over 2D paths) of int sqrt(2 mu max(W-E,0)) dl."""
    Em = max(E, Wf[:, :J_MID].min())
    src = (Wf <= Em); src[:, J_MID:] = False
    dst = (Wf <= Em); dst[:, :J_MID + 1] = False
    INF = np.inf
    dist = np.where(src, 0.0, INF).copy()
    par = np.full((NYF, NXF), -1, dtype=np.int64)
    si, sj = np.where(src)
    pq = [(0.0, i * NXF + j) for i, j in zip(si, sj)]
    heapq.heapify(pq)
    while pq:
        d, idx = heapq.heappop(pq)
        i, j = divmod(idx, NXF)
        if d > dist[i, j] + 1e-15:
            continue
        for di, dj, dl in ((1, 0, dyf), (-1, 0, dyf), (0, 1, dxf), (0, -1, dxf)):
            ni, nj = i + di, j + dj
            if 0 <= ni < NYF and 0 <= nj < NXF:
                c = seg_cost(Wf[i, j], Wf[ni, nj], dl, E, mu_long)
                nd = d + c
                if nd < dist[ni, nj]:
                    dist[ni, nj] = nd
                    par[ni, nj] = idx
                    heapq.heappush(pq, (nd, ni * NXF + nj))
    if not want_path:
        return 2.0 * dist[dst].min()
    gi = int(np.argmin(np.where(dst, dist, INF)))
    path = []
    idx = gi
    while idx != -1:
        path.append(idx)
        idx = par[idx // NXF, idx % NXF]
    path.reverse()
    pts = [(Xf[idx % NXF], Yf[idx // NYF if False else idx // NXF],
            Wf[idx // NXF, idx % NXF] + V_R) for idx in path]
    return 2.0 * dist[gi // NXF, gi % NXF], pts

def transmission(action):
    """WKB/Langer transmission; exactly 1 above the barrier (action = 0)."""
    a = np.asarray(action, dtype=float)
    return np.where(a > 1e-12, 1.0 / (1.0 + np.exp(a / ACTION_SCALE)), 1.0)

# ----------------------------------------------------------------------------
# 7. Energy grid for transmission profiles (60 rows, 0..50 kJ/mol)
# ----------------------------------------------------------------------------
N_EN = 60
E_GRID = np.linspace(0.0, 50.0, N_EN)

act_corr = np.array([corridor_action(e) for e in E_GRID])
act_2d = np.empty(N_EN)
paths = {}
PATH_IDS = [0, 6, 12, 18, 24, 30, 36, 42, 48, 54]
for k, e in enumerate(E_GRID):
    if k in PATH_IDS:
        a2, pts = action2d(e, want_path=True)
        paths[k] = pts
    else:
        a2 = action2d(e)
    act_2d[k] = a2
ratio_2d = np.divide(act_2d, act_corr, out=np.ones_like(act_2d), where=act_corr > 0)

trans_profile = pd.DataFrame({
    "energy_id": np.arange(N_EN),
    "energy_kj_mol": E_GRID,
    "action_corridor": act_corr,
    "action_2d": act_2d,
    "transmission_corridor": transmission(act_corr),
    "transmission_2d": transmission(act_2d),
    "action_ratio_2d_over_corridor": ratio_2d,
})
trans_profile.to_csv("results/transmission_profile.csv", index=False)

rows = []
for pid in PATH_IDS:
    e = E_GRID[pid]
    for step, (x, y, pot) in enumerate(paths[pid]):
        rows.append({"energy_id": pid, "path_step": step, "energy_kj_mol": e,
                     "x": x, "y": y, "potential_kj_mol": pot})
pd.DataFrame(rows).to_csv("results/path_samples.csv", index=False)

p0 = np.array(paths[PATH_IDS[0]])
dmin = np.array([np.min(np.hypot(Xc - x, Yc - y)) for x, y, _ in p0])
path_dev_max = float(dmin.max())

# ----------------------------------------------------------------------------
# 8. Free-energy profile + rates for the light case
# ----------------------------------------------------------------------------
T_LIST = temps.T_K.values
kappa_light = {T: kappa_1D(T, S_TUN) for T in T_LIST}
cross_light = crossover_T(S_TUN)

fep_rows = []
rate_rows = []
for T in T_LIST:
    F = free_energy_profile(T)
    Frel = F - F[0]
    iopt = vtst_point(F)
    barr_local = float(Frel[I_SADDLE])
    barr_opt = float(Frel[iopt])
    pref = KBH * T
    k_local = pref * np.exp(-barr_local / (R * T))
    k_opt = pref * np.exp(-barr_opt / (R * T))
    kap = kappa_light[T]
    k_enh = kap * k_opt
    rate_rows.append({
        "T_K": T, "log10_k_local_s_inv": np.log10(k_local),
        "log10_k_optimized_s_inv": np.log10(k_opt),
        "log10_k_enhanced_s_inv": np.log10(k_enh),
        "kappa_corridor": kap, "enhancement_factor": kap,
        "s_optimized": S[iopt],
        "barrier_local_kj_mol": barr_local,
        "barrier_optimized_kj_mol": barr_opt,
        "crossover_T_K": cross_light,
    })
    nu = transverse_freq(k_curv, 1.0)
    for i in range(NPT):
        fep_rows.append({
            "T_K": T, "point_id": i, "s_coord": S[i], "x": Xc[i], "y": Yc[i],
            "transverse_frequency_cm1": nu[i],
            "free_energy_kj_mol": Frel[i],
            "is_optimized_crossing": i == iopt,
        })
fep = pd.DataFrame(fep_rows)
fep.to_csv("results/free_energy_profile.csv", index=False)
rates = pd.DataFrame(rate_rows)
rates.to_csv("results/rate_constants.csv", index=False)

# ----------------------------------------------------------------------------
# 9. Isotope cases
#    longitudinal mass scale -> all actions (x sqrt(scale));
#    transverse mass scale   -> transverse frequencies / vibrational free energy
# ----------------------------------------------------------------------------
iso_rows = []
iso_trans_rows = []
cross_iso = {}
for _, c in iso.iterrows():
    case_id = c.case_id
    sl, st = float(c.longitudinal_mass_scale), float(c.transverse_mass_scale)
    sqrt_sl = np.sqrt(sl)
    S_iso_arr = S_TUN * sqrt_sl               # actions scale with sqrt(mu_long)
    nu = transverse_freq(k_curv, st)
    Fvib = 0.5 * HC * nu                      # ZPE part (T-independent)
    kap_T = {}
    for T in T_LIST:
        F = V + Fvib + R * T * np.log(1.0 - np.exp(-HCK * nu / T))
        iopt = vtst_point(F)
        barr_local = float(F[I_SADDLE] - F[0])
        barr_opt = float(F[iopt] - F[0])
        pref = KBH * T
        k_local = pref * np.exp(-barr_local / (R * T))
        k_opt = pref * np.exp(-barr_opt / (R * T))
        kap = kap_T.get(T)
        if kap is None:
            kap = kappa_1D(T, S_iso_arr)
            kap_T[T] = kap
        k_enh = kap * k_opt
        iso_rows.append({
            "case_id": case_id, "isotopologue": c.isotopologue,
            "longitudinal_mass_scale": sl, "transverse_mass_scale": st,
            "T_K": T,
            "log10_k_local_s_inv": np.log10(k_local),
            "log10_k_optimized_s_inv": np.log10(k_opt),
            "log10_k_enhanced_s_inv": np.log10(k_enh),
            "enhancement_factor": kap, "s_optimized": S[iopt],
            "crossover_T_K": None,
        })
    cross_iso[case_id] = crossover_T(S_iso_arr)
    for k, e in enumerate(E_GRID):
        iso_trans_rows.append({
            "case_id": case_id, "isotopologue": c.isotopologue,
            "longitudinal_mass_scale": sl, "transverse_mass_scale": st,
            "energy_id": k, "energy_kj_mol": e,
            "action_corridor": act_corr[k] * sqrt_sl,
            "action_2d": act_2d[k] * sqrt_sl,
            "transmission_corridor": transmission(act_corr[k] * sqrt_sl),
            "transmission_2d": transmission(act_2d[k] * sqrt_sl),
            "action_ratio_2d_over_corridor": ratio_2d[k],
        })
iso_df = pd.DataFrame(iso_rows)
light_enh = {r.T_K: r.log10_k_enhanced_s_inv for r in rates.itertuples()}
iso_df["log10_KIE_sct_vs_light"] = [
    light_enh[r.T_K] - r.log10_k_enhanced_s_inv for r in iso_df.itertuples()]
for case_id, ct in cross_iso.items():
    iso_df.loc[iso_df.case_id == case_id, "crossover_T_K"] = ct
iso_df.to_csv("results/isotope_effects.csv", index=False)
pd.DataFrame(iso_trans_rows).to_csv("results/isotope_transmission_profile.csv", index=False)

# ----------------------------------------------------------------------------
# 10. Diagnostics
# ----------------------------------------------------------------------------
lo = surf[surf.x < -0.3]; hi = surf[surf.x > 0.3]
il, ih = lo.potential_kj_mol.idxmin(), hi.potential_kj_mol.idxmin()

def naive_avg(T):
    """Cross-check only: unnormalized Boltzmann average (always <= 1)."""
    beta = 1.0 / (R * T)
    kap = kappa_E(S_TUN)
    return (trap(kap * np.exp(-beta * E_TUN), E_TUN) + np.exp(-beta * E_B) / beta) * beta

diag = {
    "units": {k: manifest[k] for k in ("coordinate_unit", "energy_unit",
                                       "temperature_unit", "rate_constant_unit")},
    "energy_reference": "reactant corridor endpoint V(s=0) = %.6f kJ/mol (relative energies)" % V_R,
    "basins": {
