                     "corridor_endpoint": {"x": float(Xc[0]), "y": float(Yc[0]), "s_coord": 0.0, "E_kj_mol": float(V[0])},
                     "grid_minimum": {"x": float(lo.x[il]), "y": float(lo.y[il]), "E_kj_mol": float(lo.potential_kj_mol[il])}},
        "product": {"side": "higher x",
                    "corridor_endpoint": {"x": float(Xc[-1]), "y": float(Yc[-1]), "s_coord": float(S[-1]), "E_kj_mol": float(V[-1])},
                    "grid_minimum": {"x": float(hi.x[ih]), "y": float(hi.y[ih]), "E_kj_mol": float(hi.potential_kj_mol[ih])}},
    },
    "conventional_saddle": {"point_id": I_SADDLE, "x": float(Xc[I_SADDLE]), "y": float(Yc[I_SADDLE]),
                            "s_coord": float(S[I_SADDLE]), "E_kj_mol": float(E_B),
                            "grid_minimax_barrier_kj_mol": 47.8235},
    "vtst_dividing_surface_s": {str(T): float(r.s_optimized) for T, r in zip(T_LIST, rates.itertuples())},
    "barriers_kj_mol": {"local": {str(T): float(r.barrier_local_kj_mol) for T, r in zip(T_LIST, rates.itertuples())},
                        "optimized": {str(T): float(r.barrier_optimized_kj_mol) for T, r in zip(T_LIST, rates.itertuples())}},
    "crossover_temperature_K": {"definition": "kappa_1D(T) = 1.2 (20% tunneling enhancement)",
                                "light": cross_light, **{k: v for k, v in cross_iso.items()}},
    "action_reduction": {
        "mean_fraction_2d_vs_corridor": float(np.mean(1.0 - ratio_2d)),
        "mean_ratio_2d_over_corridor": float(np.mean(ratio_2d)),
        "min_ratio": float(ratio_2d.min()), "max_ratio": float(ratio_2d.max()),
        "note": "ratio is mass-independent (both actions scale with sqrt(mu_long)); "
                "2D minimum-action path on a 4x-refined grid with analytic piecewise-linear segment costs",
    },
    "rate_ordering": {
        "T=177.5K": "k_enhanced >> k_local > k_optimized (tunneling-dominated)",
        "T=947.5K": "k_enhanced > k_local > k_optimized (mild tunneling, ~%.2f x)" % float(rates.enhancement_factor.iloc[-1]),
        "note": "k_optimized (VTST free-energy surface) is the lower TST bound; k_local uses the conventional saddle",
    },
    "transmission_definition": {
        "kappa_1D(T)": "1 + I_tun/I_over with I_tun = int_0^Eb kappa(E) e^{-beta E} dE, I_over = e^{-beta Eb}/beta; "
                       "kappa(E) = 1/(1+exp(S_1D(E)/1.24)); equals full 1D semiclassical rate over its over-barrier part",
        "naive_boltzmann_average_crosscheck": {
            "note": "int kappa(E) beta e^{-beta E} dE over all E is <= 1 for any barrier and would give NO crossover at 1.2; not used",
            "value_at_177.5K": float(naive_avg(177.5)), "value_at_947.5K": float(naive_avg(947.5))},
    },
    "notes": [
