def _png(path, img):
    h, w = img.shape[:2]
    raw = b''.join(b'\x00' + img[r].tobytes() for r in range(h))
    def chunk(t, d):
        c = t + d
        return struct.pack(">I", len(d)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)
    with open(path, "wb") as f:
        f.write(b'\x89PNG\r\n\x1a\n')
        f.write(chunk(b'IHDR', struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)))
        f.write(chunk(b'IDAT', zlib.compress(raw, 9)))
        f.write(chunk(b'IEND', b''))

def _text(img, x, y, s, scale=1, color=(0, 0, 0)):
    x, y = int(x), int(y)
    cx = x
    for ch in s.upper():
        g = FONT.get(ch, FONT[' '])
        for r in range(7):
            for c in range(5):
                if g[r][c] == '#':
                    for dr in range(scale):
                        for dc in range(scale):
                            yy, xx = y + r*scale + dr, cx + c*scale + dc
                            if 0 <= yy < img.shape[0] and 0 <= xx < img.shape[1]:
                                img[yy, xx] = color
        cx += 6 * scale

def _line(img, x0, y0, x1, y1, color, wpx=1):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    if n < 2:
        xx, yy = int(round(x0)), int(round(y0))
        if 0 <= yy < img.shape[0] and 0 <= xx < img.shape[1]:
            img[yy, xx] = color
        return
    for k in range(n):
        x = int(round(x0 + (x1 - x0) * k / (n - 1)))
        y = int(round(y0 + (y1 - y0) * k / (n - 1)))
        for dr in range(wpx):
            for dc in range(wpx):
                yy, xx = y + dr, x + dc
                if 0 <= yy < img.shape[0] and 0 <= xx < img.shape[1]:
                    img[yy, xx] = color

def _hline(img, y, x0, x1, color, wpx=1):
    y, x0, x1 = int(y), int(x0), int(x1)
    for xx in range(x0, x1 + 1):
        for dr in range(wpx):
            if 0 <= y + dr < img.shape[0]:
                img[y + dr, xx] = color

def _dash(img, y, x0, x1, color, per=8):
    y, x0, x1 = int(y), int(x0), int(x1)
    xx = x0
    while xx < x1:
        _hline(img, y, xx, min(xx + 5, x1), color)
        xx += per

def _plot_panel(img, x0, y0, x1, y1, title, xl, yl,
                xticks, yticks, series, logy=False, extra=None):
    _hline(img, y1, x0, x1, (0, 0, 0))
    _hline(img, y0, x0, x1, (0, 0, 0))
    _line(img, x0, y0, x0, y1, (0, 0, 0))
    _line(img, x1, y0, x1, y1, (0, 0, 0))
    _text(img, (x0 + x1) // 2 - 4 * len(title), y1 - 18, title)
    _text(img, (x0 + x1) // 2 - 3 * len(xl), y0 + 14, xl)
    _text(img, x0 - 6 * len(yl) - 4, y0 + 4, yl)
    for xv, lab in xticks:
        _line(img, xv, y0, xv, y0 + 4, (0, 0, 0))
        _text(img, xv - 3 * len(lab), y0 + 8, lab)
    for yv, lab in yticks:
        _line(img, x0 - 4, yv, x0, yv, (0, 0, 0))
        _text(img, x0 - 6 - 6 * len(lab), yv - 3, lab)
    for (xs, ys, color, name, marker) in series:
        for i in range(len(xs) - 1):
            _line(img, xs[i], ys[i], xs[i + 1], ys[i + 1], color, 2)
        if marker:
            for xx, yy in zip(xs, ys):
                _line(img, xx - 3, yy, xx + 3, yy, color, 1)
                _line(img, xx, yy - 3, xx, yy + 3, color, 1)
    if extra:
        extra(img)

