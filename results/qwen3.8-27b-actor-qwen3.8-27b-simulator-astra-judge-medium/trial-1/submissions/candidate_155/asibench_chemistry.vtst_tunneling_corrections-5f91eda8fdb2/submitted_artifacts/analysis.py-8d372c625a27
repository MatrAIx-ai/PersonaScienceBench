def _panel2(img):
    x0, y0, x1, y1 = 640, 40, 1060, 400
    xmin, xmax = invT.max() * 1.06, invT.min() * 0.92
    lymin, lymax = 0.0, np.log10(kap.max()) * 1.15
    def mx(v): return x0 + (v - xmin) / (xmax - xmin) * (x1 - x0)
    def my(v): return y1 - (np.log10(v) - lymin) / (lymax - lymin) * (y1 - y0)
    ylabs = {}
    for e in range(0, int(np.floor(lymax)) + 1):
        ylabs[my(10 ** e)] = "1e%d" % e
    xticks = [(mx(v), "%.0f" % v) for v in range(2, 6)]
