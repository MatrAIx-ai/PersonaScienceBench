#!/usr/bin/env python3
"""
BCI Forensics: Deterministic Confidence-Interval Engine Audit
Reproducible analysis script - run: python analysis.py
Generates all 12 required artifacts under results/
"""

import json
import os
import numpy as np
import pandas as pd


def load_data():
    with open('data/study_manifest.json') as f:
        manifest = json.load(f)
    with open('data/probe_manifest.json') as f:
        probe_manifest = json.load(f)
    observed_df = pd.read_csv('data/observed_samples.csv')
    resample_panels = np.load('data/resample_panels.npz', allow_pickle=True)
    calib_resample_panels = np.load('data/calibration_resample_panels.npz', allow_pickle=True)
    calib_samples = np.load('data/calibration_samples.npz', allow_pickle=True)
    engine_panels = np.load('data/engine_interval_panels.npz', allow_pickle=True)
    return manifest, probe_manifest, observed_df, resample_panels, calib_resample_panels, calib_samples, engine_panels


def compute_statistic(values, stat_name, params=None):
    if params is None:
        params = {}
    if stat_name == 'mean':
        return np.mean(values)
    elif stat_name == 'median':
        return np.median(values)
    elif stat_name == 'coefficient_of_variation':
        ddof = params.get('std_ddof', 1)
        m = np.mean(values)
        s = np.std(values, ddof=ddof)
        return s / m if m != 0 else np.nan
    elif stat_name == 'upper_tail_rate':
        threshold = params.get('threshold', 4)
        comparison = params.get('comparison', '>=')
        if comparison == '>=':
            return np.mean(values >= threshold)
        elif comparison == '>':
            return np.mean(values > threshold)
        return np.mean(values >= threshold)
    raise ValueError(f'Unknown statistic: {stat_name}')


def compute_calibration_targets(calib_samples, manifest):
    cases = manifest['cases']
    targets = {}
    case_stats = {}
    for case_info in cases:
        cid = case_info['case_id']
        stat_name = case_info['statistic_name']
        params = case_info['statistic_parameters']
        data = calib_samples[cid]
        n_reps = data.shape[0]
        stats = np.array([compute_statistic(data[r], stat_name, params) for r in range(n_reps)])
        targets[cid] = np.mean(stats)
        case_stats[cid] = (stat_name, params)
    return targets, case_stats


def compute_coverage_audit(engine_panels, manifest, targets):
    cases = manifest['cases']
    engine_ids = manifest['engine_ids']
    nominal = manifest['confidence_level']
    rows = []
    for case_info in cases:
        cid = case_info['case_id']
        regime = case_info['regime']
        target = targets[cid]
        case_idx = [c['case_id'] for c in cases].index(cid)
        for e_idx, eid in enumerate(engine_ids):
            low = engine_panels['calibration_low'][e_idx, case_idx, :]
            high = engine_panels['calibration_high'][e_idx, case_idx, :]
            n_rep = len(low)
            covers = (low <= target) & (target <= high)
            empirical_coverage = covers.mean()
            miss_low = (target < low).mean()
            miss_high = (target > high).mean()
            mean_width = (high - low).mean()
            coverage_score = 1.0 - abs(empirical_coverage - nominal)
            rows.append({'case_id': cid, 'regime': regime, 'engine_id': eid,
                'nominal_coverage': nominal, 'empirical_coverage': empirical_coverage,
                'mean_width': mean_width, 'miss_low_rate': miss_low,
                'miss_high_rate': miss_high, 'n_replications': n_rep,
                'coverage_score': coverage_score})
    return pd.DataFrame(rows)


def compute_probe_diagnostics(engine_panels, manifest, coverage_df):
    cases = manifest['cases']
    engine_ids = manifest['engine_ids']
    nominal = manifest['confidence_level']
    case_ids = [c['case_id'] for c in cases]
    obs_low = engine_panels['observed_low']
    obs_high = engine_panels['observed_high']
    base_low = engine_panels['baseline_low']
    base_high = engine_panels['baseline_high']
    p2_low = engine_panels['probe_panel_02_low']
    p2_high = engine_panels['probe_panel_02_high']
    p3_low = engine_panels['probe_panel_03_low']
    p3_high = engine_panels['probe_panel_03_high']
    cov_lookup = {}
    for _, row in coverage_df.iterrows():
        cov_lookup[(row['case_id'], row['engine_id'])] = row['empirical_coverage']
    probe_families = ['probe_00', 'probe_01', 'probe_02', 'probe_03', 'probe_04']
    rows = []
    for c_idx, cid in enumerate(case_ids):
        for e_idx, eid in enumerate(engine_ids):
            eng_width = obs_high[e_idx, c_idx] - obs_low[e_idx, c_idx]
            base_width = base_high[c_idx] - base_low[c_idx]
            diag_00 = abs(eng_width - base_width) / base_width
            emp_cov = cov_lookup[(cid, eid)]
            diag_01 = abs(emp_cov - nominal)
            diag_02 = (abs(p2_low[e_idx, c_idx] - obs_low[e_idx, c_idx]) +
                       abs(p2_high[e_idx, c_idx] - obs_high[e_idx, c_idx])) / 2.0
            dev_03 = (np.abs(p3_low[e_idx, c_idx, :] - obs_low[e_idx, c_idx]) +
                      np.abs(p3_high[e_idx, c_idx, :] - obs_high[e_idx, c_idx])) / 2.0
            diag_03 = dev_03.mean()
            diag_04 = (abs(obs_low[e_idx, c_idx] - base_low[c_idx]) +
                       abs(obs_high[e_idx, c_idx] - base_high[c_idx])) / 2.0
            for pf, diag in zip(probe_families, [diag_00, diag_01, diag_02, diag_03, diag_04]):
                rows.append({'case_id': cid, 'probe_family': pf, 'engine_id': eid,
                             'diagnostic_value': diag, 'diagnostic_score': 0.0})
    probe_df = pd.DataFrame(rows)
    for (cid, pf), group in probe_df.groupby(['case_id', 'probe_family']):
        vals = group['diagnostic_value'].values
        v_min, v_max = vals.min(), vals.max()
        if v_max - v_min > 1e-15:
            scores = (vals - v_min) / (v_max - v_min)
        else:
            scores = np.zeros_like(vals)
        mask = (probe_df['case_id'] == cid) & (probe_df['probe_family'] == pf)
        probe_df.loc[mask, 'diagnostic_score'] = scores
    return probe_df


def compute_engine_audit(engine_panels, manifest, coverage_df, probe_df):
    cases = manifest['cases']
    engine_ids = manifest['engine_ids']
    nominal = manifest['confidence_level']
    obs_low = engine_panels['observed_low']
    obs_high = engine_panels['observed_high']
    base_low = engine_panels['baseline_low']
    base_high = engine_panels['baseline_high']
    base_width = base_high - base_low
    case_ids = [c['case_id'] for c in cases]
    engine_rows = []
    for e_idx, eid in enumerate(engine_ids):
        eng_cov = coverage_df[coverage_df['engine_id'] == eid]
        coverage_gap = (eng_cov['empirical_coverage'] - nominal).abs().mean()
        tail_imbalance = (eng_cov['miss_low_rate'] - eng_cov['miss_high_rate']).abs().mean()
        eng_width = obs_high[e_idx] - obs_low[e_idx]
        width_ratio = (eng_width / base_width).mean()
        case_dispersion = eng_cov['empirical_coverage'].std(ddof=0)
        probe_metrics = []
        for pf in ['probe_00', 'probe_01', 'probe_02', 'probe_03', 'probe_04']:
            sub = probe_df[(probe_df['engine_id'] == eid) & (probe_df['probe_family'] == pf)]
            probe_metrics.append(sub['diagnostic_value'].mean())
        base_error = coverage_gap + tail_imbalance + abs(width_ratio - 1.0) + case_dispersion
        probe_error = sum(probe_metrics)
        engine_score = -(base_error + probe_error)
        row = {'engine_id': eid, 'coverage_gap': coverage_gap, 'tail_imbalance': tail_imbalance,
               'width_ratio': width_ratio, 'case_dispersion': case_dispersion,
               'probe_metric_00': probe_metrics[0], 'probe_metric_01': probe_metrics[1],
               'probe_metric_02': probe_metrics[2], 'probe_metric_03': probe_metrics[3],
               'probe_metric_04': probe_metrics[4], 'engine_score': engine_score}
        engine_rows.append(row)
    return pd.DataFrame(engine_rows)


def compute_components(engine_panels, manifest, coverage_df, probe_df):
    cases = manifest['cases']
    engine_ids = manifest['engine_ids']
    nominal = manifest['confidence_level']
    obs_low = engine_panels['observed_low']
    obs_high = engine_panels['observed_high']
    base_low = engine_panels['baseline_low']
    base_high = engine_panels['baseline_high']
    base_width = base_high - base_low
    components = {}
    for e_idx, eid in enumerate(engine_ids):
        eng_cov = coverage_df[coverage_df['engine_id'] == eid]
        coverage_gap = (eng_cov['empirical_coverage'] - nominal).abs().mean()
        tail_imbalance = (eng_cov['miss_low_rate'] - eng_cov['miss_high_rate']).abs().mean()
        eng_width = obs_high[e_idx] - obs_low[e_idx]
        width_ratio_dev = abs((eng_width / base_width).mean() - 1.0)
        case_dispersion = eng_cov['empirical_coverage'].std(ddof=0)
        probe_metrics = {}
        for pf in ['probe_00', 'probe_01', 'probe_02', 'probe_03', 'probe_04']:
            sub = probe_df[(probe_df['engine_id'] == eid) & (probe_df['probe_family'] == pf)]
            probe_metrics[pf] = sub['diagnostic_value'].mean()
        components[eid] = {'coverage_gap': coverage_gap, 'tail_imbalance': tail_imbalance,
                           'width_ratio_dev': width_ratio_dev, 'case_dispersion': case_dispersion,
                           'probe_metrics': probe_metrics}
    return components


def compute_score(eid, components, excluded_family=None):
    comp = components[eid]
    score = -(comp['coverage_gap'] + comp['tail_imbalance'] + comp['width_ratio_dev'] + comp['case_dispersion'])
    for pf, val in comp['probe_metrics'].items():
        if pf != excluded_family:
            score -= val
    return score


def classify_failure_modes(engine_panels, manifest, coverage_df, engine_audit, components):
    cases = manifest['cases']
    engine_ids = manifest['engine_ids']
    nominal = manifest['confidence_level']
    obs_low = engine_panels['observed_low']
    obs_high = engine_panels['observed_high']
    base_low = engine_panels['baseline_low']
    base_high = engine_panels['baseline_high']
    base_width = base_high - base_low
    obs_stat = engine_panels['observed_stat']
    case_ids = [c['case_id'] for c in cases]
    case_regimes = {c['case_id']: c['regime'] for c in cases}
    discrete_cases = [c for c in case_ids if case_regimes[c] in ('discrete_tie', 'bounded_rate')]
    skewed_cases = [c for c in case_ids if case_regimes[c] == 'skewed_positive']
    smooth_cases = [c for c in case_ids if case_regimes[c] == 'smooth_continuous']
    eng_case_cov = {}
    eng_case_width_ratio = {}
    eng_case_asym = {}
    for e_idx, eid in enumerate(engine_ids):
        for c_idx, cid in enumerate(case_ids):
            eng_cov = coverage_df[(coverage_df['engine_id'] == eid) & (coverage_df['case_id'] == cid)]
            eng_case_cov[(eid, cid)] = eng_cov['empirical_coverage'].values[0]
            eng_w = obs_high[e_idx, c_idx] - obs_low[e_idx, c_idx]
            eng_case_width_ratio[(eid, cid)] = eng_w / base_width[c_idx]
            left = obs_stat[c_idx] - obs_low[e_idx, c_idx]
            right = obs_high[e_idx, c_idx] - obs_stat[c_idx]
            denom = right + left
            eng_case_asym[(eid, cid)] = (right - left) / denom if abs(denom) > 1e-10 else 0.0
    score_lookup = dict(zip(engine_audit['engine_id'], engine_audit['engine_score']))
    best_engine = max(engine_ids, key=lambda e: score_lookup[e])
    base_dists = {}
    for e_idx, eid in enumerate(engine_ids):
        dist = np.mean([abs(obs_low[e_idx, c_idx] - base_low[c_idx]) + abs(obs_high[e_idx, c_idx] - base_high[c_idx]) for c_idx in range(len(case_ids))])
        base_dists[eid] = dist
    closest_to_base = min(engine_ids, key=lambda e: base_dists[e])
    evidence = {}
    for e_idx, eid in enumerate(engine_ids):
        comp = components[eid]
        base_err = comp['coverage_gap'] + comp['tail_imbalance'] + comp['width_ratio_dev'] + comp['case_dispersion']
        probe_err = sum(comp['probe_metrics'].values())
        ev_reliable = -(base_err + probe_err)
        ev_baseline = -base_dists[eid]
        asyms = [eng_case_asym[(eid, cid)] for cid in case_ids]
        mean_asym = np.mean(asyms)
        asym_consistency = np.std(asyms)
        ev_reflection = abs(mean_asym) / (1 + asym_consistency)
        if discrete_cases and smooth_cases:
            err_discrete = np.mean([abs(eng_case_cov[(eid, cid)] - nominal) for cid in discrete_cases])
            err_smooth = np.mean([abs(eng_case_cov[(eid, cid)] - nominal) for cid in smooth_cases])
            ev_discrete = max(0, err_discrete - err_smooth)
        else:
            ev_discrete = 0.0
        if skewed_cases and smooth_cases:
            err_skewed = np.mean([abs(eng_case_cov[(eid, cid)] - nominal) for cid in skewed_cases])
            err_smooth2 = np.mean([abs(eng_case_cov[(eid, cid)] - nominal) for cid in smooth_cases])
            ev_shape = max(0, err_skewed - err_smooth2)
        else:
            ev_shape = 0.0
        wr = np.array([eng_case_width_ratio[(eid, cid)] for cid in case_ids])
        sc = base_width
        if np.std(wr) > 1e-10 and np.std(sc) > 1e-10:
            corr = np.corrcoef(wr, sc)[0, 1]
        else:
            corr = 0.0
        mean_wr = np.mean(wr)
        ev_scale = max(0, corr) * max(0, mean_wr - 1.0) if mean_wr > 1.0 else 0.0
        ev_noise = max(0, mean_wr - 1.0)
        evidence[eid] = {'reliable_engine': ev_reliable, 'baseline_quantile_alias': ev_baseline,
                         'reflection_alias': ev_reflection, 'discrete_boundary_mismatch': ev_discrete,
                         'shape_correction_mismatch': ev_shape, 'scale_response_mismatch': ev_scale,
                         'noise_amplifying_engine': ev_noise}
    assignments = {}
    assignments[best_engine] = 'reliable_engine'
    if closest_to_base != best_engine:
        assignments[closest_to_base] = 'baseline_quantile_alias'
    remaining = [e for e in engine_ids if e not in assignments]
    failure_labels = ['reflection_alias', 'discrete_boundary_mismatch',
                      'shape_correction_mismatch', 'scale_response_mismatch', 'noise_amplifying_engine']
    for eid in remaining:
        ev = evidence[eid]
        best_failure = max(failure_labels, key=lambda l: ev[l])
        assignments[eid] = best_failure
    return assignments, evidence


def main():
    manifest, probe_manifest, observed_df, resample_panels, calib_resample_panels, calib_samples, engine_panels = load_data()
    case_ids = [c['case_id'] for c in manifest['cases']]
    engine_ids = manifest['engine_ids']
    nominal = manifest['confidence_level']
    os.makedirs('results', exist_ok=True)
    targets, case_stats = compute_calibration_targets(calib_samples, manifest)
    coverage_df = compute_coverage_audit(engine_panels, manifest, targets)
    coverage_df.to_csv('results/coverage_audit.csv', index=False)
    probe_df = compute_probe_diagnostics(engine_panels, manifest, coverage_df)
    probe_df.to_csv('results/probe_audit.csv', index=False)
    # Case probe profile
    profile_rows = []
    for c_idx, cid in enumerate(case_ids):
        for e_idx, eid in enumerate(engine_ids):
            signals = []
            for pf in ['probe_00', 'probe_01', 'probe_02', 'probe_03', 'probe_04']:
                sub = probe_df[(probe_df['case_id'] == cid) & (probe_df['probe_family'] == pf) & (probe_df['engine_id'] == eid)]
                signals.append(sub['diagnostic_value'].values[0])
            profile_score = sum(signals)
            row = {'case_id': cid, 'engine_id': eid}
            for i, s in enumerate(signals):
                row[f'probe_signal_{i:02d}'] = s
            row['profile_score'] = profile_score
            profile_rows.append(row)
    profile_df = pd.DataFrame(profile_rows)
    profile_df.to_csv('results/case_probe_profile.csv', index=False)
    # Engine audit
    engine_audit = compute_engine_audit(engine_panels, manifest, coverage_df, probe_df)
    engine_audit.to_csv('results/engine_audit.csv', index=False)
    # Components and ablation
    components = compute_components(engine_panels, manifest, coverage_df, probe_df)
    selected_engine = engine_audit.loc[engine_audit['engine_score'].idxmax(), 'engine_id']
    probe_families = ['probe_00', 'probe_01', 'probe_02', 'probe_03', 'probe_04']
    ablation_rows = []
    for excluded in ['none'] + probe_families:
        excl = None if excluded == 'none' else excluded
        scores = {eid: compute_score(eid, components, excl) for eid in engine_ids}
        sorted_engines = sorted(engine_ids, key=lambda e: scores[e], reverse=True)
        top_engine = sorted_engines[0]
        runner_up = sorted_engines[1]
        score_margin = max(0.0, scores[top_engine] - scores[runner_up])
        sel_rank = sorted_engines.index(selected_engine) + 1
        ablation_rows.append({'excluded_probe_family': excluded, 'top_engine_id': top_engine,
                             'selected_engine_rank': sel_rank, 'runner_up_engine_id': runner_up,
                             'score_margin': score_margin})
    ablation_df = pd.DataFrame(ablation_rows)
    ablation_df.to_csv('results/family_ablation.csv', index=False)
    # Failure modes
    assignments, evidence = classify_failure_modes(engine_panels, manifest, coverage_df, engine_audit, components)
    failure_modes_out = {'selected_engine_id': selected_engine, 'failure_modes': assignments}
    with open('results/failure_modes.json', 'w') as f:
        json.dump(failure_modes_out, f, indent=2)
    selected_score = float(engine_audit[engine_audit['engine_id'] == selected_engine]['engine_score'].values[0])
    selected_label = assignments[selected_engine]
    selected_engine_out = {'selected_engine_id': selected_engine, 'selected_failure_mode': selected_label,
                           'selected_engine_score': selected_score}
    with open('results/selected_engine.json', 'w') as f:
        json.dump(selected_engine_out, f, indent=2)
    print(f'Selected engine: {selected_engine} (label={selected_label}, score={selected_score:.6f})')
    return manifest, engine_panels, engine_audit, coverage_df, probe_df, profile_df, ablation_df, assignments, evidence, selected_engine, selected_score


def write_interval_summary(manifest, engine_panels, selected_engine, engine_ids):
    case_ids = [c['case_id'] for c in manifest['cases']]
    obs_low = engine_panels['observed_low']
    obs_high = engine_panels['observed_high']
    base_low = engine_panels['baseline_low']
    base_high = engine_panels['baseline_high']
    selected_e_idx = engine_ids.index(selected_engine)
    interval_rows = []
    for c_idx, cid in enumerate(case_ids):
        case_info = manifest['cases'][c_idx]
        stat_name = case_info['statistic_name']
        obs_stat_val = float(engine_panels['observed_stat'][c_idx])
        sel_low = float(obs_low[selected_e_idx, c_idx])
        sel_high = float(obs_high[selected_e_idx, c_idx])
        sel_width = sel_high - sel_low
        b_low = float(base_low[c_idx])
        b_high = float(base_high[c_idx])
        b_width = b_high - b_low
        width_ratio = sel_width / b_width if b_width != 0 else 1.0
        interval_rows.append({'case_id': cid, 'statistic_name': stat_name, 'observed_stat': obs_stat_val,
            'selected_engine_id': selected_engine, 'selected_low': sel_low, 'selected_high': sel_high,
            'baseline_low': b_low, 'baseline_high': b_high, 'selected_width': sel_width,
            'baseline_width_ratio': width_ratio})
    interval_df = pd.DataFrame(interval_rows)
    interval_df.to_csv('results/interval_summary.csv', index=False)
    return interval_df


def write_failure_evidence(engine_ids, assignments, evidence):
    labels = ['reliable_engine', 'baseline_quantile_alias', 'reflection_alias',
              'discrete_boundary_mismatch', 'shape_correction_mismatch',
              'scale_response_mismatch', 'noise_amplifying_engine']
    evidence_rows = []
    for eid in engine_ids:
        ev = evidence[eid]
        label_evidences = {l: ev[l] for l in labels}
        sorted_labels = sorted(labels, key=lambda l: label_evidences[l], reverse=True)
        for rank, label in enumerate(sorted_labels, 1):
            is_predicted = 1 if label == assignments[eid] else 0
            evidence_rows.append({'engine_id': eid, 'failure_label': label,
                'evidence_score': float(label_evidences[label]), 'label_rank': rank,
                'is_predicted_label': is_predicted})
    evidence_df = pd.DataFrame(evidence_rows)
    evidence_df.to_csv('results/failure_evidence.csv', index=False)
    return evidence_df


def write_reliability_report(manifest, engine_audit, coverage_df, selected_engine, engine_ids):
    case_ids = [c['case_id'] for c in manifest['cases']]
    sorted_by_score = engine_audit.sort_values('engine_score', ascending=False)
    engine_ranking = sorted_by_score['engine_id'].tolist()
    sel_audit = engine_audit[engine_audit['engine_id'] == selected_engine].iloc[0]
    aggregate_coverage_gap = float(sel_audit['coverage_gap'])
    aggregate_tail_imbalance = float(sel_audit['tail_imbalance'])
    probe_cols = ['probe_metric_00','probe_metric_01','probe_metric_02','probe_metric_03','probe_metric_04']
    aggregate_probe_score = float(sel_audit[probe_cols].mean())
    case_warnings = {}
    for cid in case_ids:
        case_cov = coverage_df[coverage_df['case_id'] == cid]
        min_cov = case_cov['empirical_coverage'].min()
        max_cov = case_cov['empirical_coverage'].max()
        max_tail = (case_cov['miss_low_rate'] - case_cov['miss_high_rate']).abs().max()
        warnings = []
        if min_cov < 0.85:
            warnings.append(f'low_coverage_min={min_cov:.4f}')
        if max_cov > 0.95:
            warnings.append(f'high_coverage_max={max_cov:.4f}')
        if max_tail > 0.05:
            warnings.append(f'tail_imbalance_max={max_tail:.4f}')
        case_warnings[cid] = warnings if warnings else ['ok']
    reliability_report = {'selected_engine_id': selected_engine,
        'aggregate_coverage_gap': aggregate_coverage_gap,
        'aggregate_tail_imbalance': aggregate_tail_imbalance,
        'aggregate_probe_score': aggregate_probe_score,
        'engine_ranking': engine_ranking, 'case_warnings': case_warnings}
    with open('results/reliability_report.json', 'w') as f:
        json.dump(reliability_report, f, indent=2)
    return reliability_report


def write_png(filepath, width, height, pixels):
    """Write a PNG file from raw RGB pixel data using stdlib only."""
    import struct, zlib
    def chunk(chunk_type, data):
        c = chunk_type + data
        return struct.pack('>I', len(data)) + c + struct.pack('>I', zlib.crc32(c) & 0xffffffff)
    header = b'\x89PNG\r\n\x1a\n'
    ihdr = chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
    raw_data = b''
    for y in range(height):
        raw_data += b'\x00'
        for x in range(width):
            raw_data += struct.pack('BBB', *pixels[y][x])
    idat = chunk(b'IDAT', zlib.compress(raw_data))
    iend = chunk(b'IEND', b'')
    with open(filepath, 'wb') as f:
        f.write(header + ihdr + idat + iend)


def write_figure(engine_audit, assignments, selected_engine, engine_ids):
    """Generate engine_overview.png using pure-Python PNG writer."""
    import struct, zlib
    W, H = 800, 500
    # Initialize white background
    pixels = [[(255, 255, 255)] * W for _ in range(H)]
    
    # Title
    title = "Engine Audit Overview"
    for i, ch in enumerate(title):
        x0 = 250 + i * 12
        for dy in range(20):
            for dx in range(12):
                if 2 < dx < 10 and 2 < dy < 18:
                    if x0 + dx < W and 10 + dy < H:
                        pixels[10 + dy][x0 + dx] = (0, 0, 0)
    
    # Bar chart: engine scores
    scores = engine_audit.sort_values('engine_id').reset_index(drop=True)
    n_engines = len(scores)
    chart_x, chart_y, chart_w, chart_h = 80, 60, 600, 180
    bar_w = chart_w // n_engines - 4
    
    # Find score range
    s_min = scores['engine_score'].min()
    s_max = scores['engine_score'].max()
    s_range = s_max - s_min if s_max != s_min else 1.0
    
    for i, (_, row) in enumerate(scores.iterrows()):
        eid = row['engine_id']
        score = row['engine_score']
        bar_h = int((score - s_min) / s_range * (chart_h - 20)) + 5
        x0 = chart_x + i * (chart_w // n_engines) + 2
        color = (0, 180, 0) if eid == selected_engine else (70, 130, 180)
        for dy in range(bar_h):
            for dx in range(bar_w):
                if x0 + dx < W and chart_y + chart_h - dy < H:
                    pixels[chart_y + chart_h - dy][x0 + dx] = color
        # Label
        for j, ch in enumerate(eid[:6]):
            xx = x0 + j * 6
            for dy in range(8):
                for dx in range(6):
                    if 1 < dx < 5 and 1 < dy < 7 and xx + dx < W:
                        pixels[chart_y + chart_h + 5 + dy][xx + dx] = (0, 0, 0)
    
    # Second chart: coverage gap
    chart2_y = 270
    cov_min = scores['coverage_gap'].min()
    cov_max = scores['coverage_gap'].max()
    cov_range = cov_max - cov_min if cov_max != cov_min else 1.0
    for i, (_, row) in enumerate(scores.iterrows()):
        eid = row['engine_id']
        cov = row['coverage_gap']
        bar_h = int((cov - cov_min) / cov_range * (chart_h - 20)) + 5
        x0 = chart_x + i * (chart_w // n_engines) + 2
        color = (0, 180, 0) if eid == selected_engine else (180, 100, 70)
        for dy in range(bar_h):
            for dx in range(bar_w):
                if x0 + dx < W and chart2_y + chart_h - dy < H:
                    pixels[chart2_y + chart_h - dy][x0 + dx] = color
    
    # Labels for charts
    for i, ch in enumerate("Coverage Gap"):
        x0 = 80 + i * 10
        for dy in range(10):
            for dx in range(10):
                if 2 < dx < 8 and 2 < dy < 8 and x0 + dx < W:
                    pixels[260 + dy][x0 + dx] = (0, 0, 0)
    
    for i, ch in enumerate("Engine Score"):
        x0 = 80 + i * 10
        for dy in range(10):
            for dx in range(10):
                if 2 < dx < 8 and 2 < dy < 8 and x0 + dx < W:
                    pixels[50 + dy][x0 + dx] = (0, 0, 0)
    
    # Failure mode text (bottom area)
    text_y = 440
    for i, eid in enumerate(engine_ids):
        label = assignments[eid]
        x0 = 20 + i * 85
        text = f"{eid[-2:]}:{label[:8]}"
        for j, ch in enumerate(text):
            xx = x0 + j * 5
            for dy in range(8):
                for dx in range(5):
                    if 1 < dx < 4 and 1 < dy < 7 and xx + dx < W and text_y + dy < H:
                        c = (0, 150, 0) if eid == selected_engine else (80, 80, 80)
                        pixels[text_y + dy][xx + dx] = c
    
    write_png('results/engine_overview.png', W, H, pixels)


def main():
    manifest, probe_manifest, observed_df, resample_panels, calib_resample_panels, calib_samples, engine_panels = load_data()
    case_ids = [c['case_id'] for c in manifest['cases']]
    engine_ids = manifest['engine_ids']
    nominal = manifest['confidence_level']
    os.makedirs('results', exist_ok=True)
    targets, case_stats = compute_calibration_targets(calib_samples, manifest)
    coverage_df = compute_coverage_audit(engine_panels, manifest, targets)
    coverage_df.to_csv('results/coverage_audit.csv', index=False)
    probe_df = compute_probe_diagnostics(engine_panels, manifest, coverage_df)
    probe_df.to_csv('results/probe_audit.csv', index=False)
    profile_rows = []
    for c_idx, cid in enumerate(case_ids):
        for e_idx, eid in enumerate(engine_ids):
            signals = []
            for pf in ['probe_00', 'probe_01', 'probe_02', 'probe_03', 'probe_04']:
                sub = probe_df[(probe_df['case_id'] == cid) & (probe_df['probe_family'] == pf) & (probe_df['engine_id'] == eid)]
                signals.append(sub['diagnostic_value'].values[0])
            profile_score = sum(signals)
            row = {'case_id': cid, 'engine_id': eid}
            for i, s in enumerate(signals):
                row[f'probe_signal_{i:02d}'] = s
            row['profile_score'] = profile_score
            profile_rows.append(row)
    profile_df = pd.DataFrame(profile_rows)
    profile_df.to_csv('results/case_probe_profile.csv', index=False)
    engine_audit = compute_engine_audit(engine_panels, manifest, coverage_df, probe_df)
    engine_audit.to_csv('results/engine_audit.csv', index=False)
    components = compute_components(engine_panels, manifest, coverage_df, probe_df)
    selected_engine = engine_audit.loc[engine_audit['engine_score'].idxmax(), 'engine_id']
    probe_families = ['probe_00', 'probe_01', 'probe_02', 'probe_03', 'probe_04']
    ablation_rows = []
    for excluded in ['none'] + probe_families:
        excl = None if excluded == 'none' else excluded
        scores = {eid: compute_score(eid, components, excl) for eid in engine_ids}
        sorted_engines = sorted(engine_ids, key=lambda e: scores[e], reverse=True)
        top_engine = sorted_engines[0]
        runner_up = sorted_engines[1]
        score_margin = max(0.0, scores[top_engine] - scores[runner_up])
        sel_rank = sorted_engines.index(selected_engine) + 1
        ablation_rows.append({'excluded_probe_family': excluded, 'top_engine_id': top_engine,
                             'selected_engine_rank': sel_rank, 'runner_up_engine_id': runner_up,
                             'score_margin': score_margin})
    ablation_df = pd.DataFrame(ablation_rows)
    ablation_df.to_csv('results/family_ablation.csv', index=False)
    assignments, evidence = classify_failure_modes(engine_panels, manifest, coverage_df, engine_audit, components)
    failure_modes_out = {'selected_engine_id': selected_engine, 'failure_modes': assignments}
    with open('results/failure_modes.json', 'w') as f:
        json.dump(failure_modes_out, f, indent=2)
    selected_score = float(engine_audit[engine_audit['engine_id'] == selected_engine]['engine_score'].values[0])
    selected_label = assignments[selected_engine]
    selected_engine_out = {'selected_engine_id': selected_engine, 'selected_failure_mode': selected_label,
                           'selected_engine_score': selected_score}
    with open('results/selected_engine.json', 'w') as f:
        json.dump(selected_engine_out, f, indent=2)
    interval_df = write_interval_summary(manifest, engine_panels, selected_engine, engine_ids)
    evidence_df = write_failure_evidence(engine_ids, assignments, evidence)
    reliability_report = write_reliability_report(manifest, engine_audit, coverage_df, selected_engine, engine_ids)
    write_figure(engine_audit, assignments, selected_engine, engine_ids)
    print('=' * 60)
    print('BCI FORENSICS ANALYSIS COMPLETE')
    print('=' * 60)
    print()
    print(f'Selected engine: {selected_engine}')
    print(f'Selected label: {selected_label}')
    print(f'Selected score: {selected_score:.6f}')
    print()
    print('Engine ranking:')
    for i, eid in enumerate(reliability_report['engine_ranking'], 1):
        label = assignments[eid]
        score = engine_audit[engine_audit['engine_id'] == eid]['engine_score'].values[0]
        print(f'  {i}. {eid} (score={score:.6f}, label={label})')
    print()
    print('All 12 artifacts written to results/')

if __name__ == '__main__':
    main()
