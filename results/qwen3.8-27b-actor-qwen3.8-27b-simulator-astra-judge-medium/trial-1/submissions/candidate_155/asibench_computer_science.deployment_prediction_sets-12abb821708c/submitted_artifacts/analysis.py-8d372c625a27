class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.px = np.zeros((h, w, 3), np.uint8)
        self.px[:] = bg

    def _in(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def rect(self, x0, y0, x1, y1, color, fill=True):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        if x1 < x0: x0, x1 = x1, x0
        if y1 < y0: y0, y1 = y1, y0
        x0c, y0c = max(0, x0), max(0, y0)
        x1c, y1c = min(self.w - 1, x1), min(self.h - 1, y1)
        if x1c < x0c or y1c < y0c: return
        if fill:
            self.px[y0c:y1c + 1, x0c:x1c + 1] = color
        else:
            self.px[y0c, x0c:x1c + 1] = color
            self.px[y1c, x0c:x1c + 1] = color
            self.px[y0c:y1c + 1, x0c] = color
            self.px[y0c:y1c + 1, x1c] = color

    def line(self, x0, y0, x1, y1, color, thick=1, dash=0):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx + dy
        i = 0
        while True:
            if dash == 0 or (i // dash) % 2 == 0:
                if thick <= 1:
                    if self._in(x0, y0): self.px[y0, x0] = color
                else:
                    r = thick // 2
                    self.rect(x0 - r, y0 - r, x0 + r, y0 + r, color)
            if x0 == x1 and y0 == y1: break
            e2 = 2 * err
            if e2 >= dy: err += dy; x0 += sx
            if e2 <= dx: err += dx; y0 += sy
            i += 1

    def hline(self, x0, x1, y, color, thick=1, dash=0):
        self.line(x0, y, x1, y, color, thick, dash)

    def vline(self, x, y0, y1, color, thick=1, dash=0):
        self.line(x, y0, x, y1, color, thick, dash)

    def poly(self, pts, color, thick=1):
        for (a, b) in zip(pts[:-1], pts[1:]):
            self.line(a[0], a[1], b[0], b[1], color, thick)

    def dot(self, x, y, r, color):
        self.rect(x - r, y - r, x + r, y + r, color)

    def scatter(self, xs, ys, r, color):
        xs = np.clip(xs.astype(int), 0, self.w - 1)
        ys = np.clip(ys.astype(int), 0, self.h - 1)
        for dx in range(-r, r + 1):
            for dy in range(-r, r + 1):
                xx = np.clip(xs + dx, 0, self.w - 1)
                yy = np.clip(ys + dy, 0, self.h - 1)
                self.px[yy, xx] = color

    def text(self, x, y, s, color=(0, 0, 0), scale=1):
        cx = int(x)
        for ch in s.upper():
            g = FONT5X7.get(ch, FONT5X7[' '])
            for ry in range(7):
                row = g[ry]
                for rx in range(5):
                    if row & (1 << (4 - rx)):
                        self.rect(cx + rx * scale, y + ry * scale,
                                  cx + rx * scale + scale - 1,
                                  y + ry * scale + scale - 1, color)
            cx += 6 * scale
        return cx

    def text_w(self, s, scale=1):
        return len(s) * 6 * scale - scale

    def save(self, path):
        def chunk(tag, data):
            c = struct.pack('>I', len(data)) + tag + data
            return c + struct.pack('>I', zlib.crc32(tag + data) & 0xFFFFFFFF)
        raw = b''.join(b'\x00' + self.px[y].tobytes() for y in range(self.h))
        png = (b'\x89PNG\r\n\x1a\n'
               + chunk(b'IHDR', struct.pack('>IIBBBBB', self.w, self.h, 8, 2, 0, 0, 0))
               + chunk(b'IDAT', zlib.compress(raw, 9))
               + chunk(b'IEND', b''))
        with open(path, 'wb') as fh:
            fh.write(png)

