#!/usr/bin/env python3
"""
Deployment prediction sets under a cost-weighted miss risk target.

APPROVED POLICY DESIGN
----------------------
- Proxy strata: quintiles of feature v000 (cutpoints computed on the 70% model-fit
  split only; v000 is the strongest public proxy for classifier reliability).
- Label-recovery model: k=11 kNN with score-weighted neighbour votes on
  standardized features, fit on the 70% fit split ONLY.
- Threshold selection: STRICTLY on the 30% holdout split (conformal-style split;
  the kNN model never sees threshold-selection data).
- Per stratum g, inclusion rule for deployment record i:
      prediction_set(i) = { l : score_l(i) >= t_g }  U  { kNN top-k_g labels(i) }
  (k_g >= 1 guarantees non-empty sets, as required by risk_spec.json).
- (t_g, k_g) chosen per stratum to MINIMIZE holdout mean set size subject to
  holdout cost-weighted miss risk <= margin * target. The margin starts at 0.85
  and tightens (0.75, 0.65, ...) until the deployment-weighted overall estimate
  <= target_risk (0.1084). Both constraints are retained.
- Deployment risk is an ESTIMATE (deployment labels are hidden):
      est_risk_overall = sum_g deployment_fraction_g * holdout_risk_g
  i.e. per-stratum holdout risk weighted by the deployment/calibration density.

Outputs: all 11 required files under results/ (schemas from data/metadata.json).
"""
import json
import os

import numpy as np
import pandas as pd
from scipy.spatial import cKDTree


RNG_SEED = 42
KNN_K = 11
N_STRATA = 5
MARGIN_STEPS = [0.85, 0.75, 0.65, 0.55, 0.45, 0.35, 0.25]
T_GRID = [0.05, 0.10, 0.15, 0.20, 0.30, 0.40, 0.50, 0.60]
K_GRID = [1, 2, 3, 4, 5, 6, 7, 8, 9]
CONF = 0.95

# ---------------------------------------------------------------- load inputs
with open("data/risk_spec.json") as fh:
    risk_spec = json.load(fh)
with open("data/metadata.json") as fh:
    metadata = json.load(fh)

TARGET = float(risk_spec["target_risk"])          # 0.1084
COSTS = {k: float(v) for k, v in risk_spec["label_costs"].items()}
LABELS = list(metadata["label_columns"])          # label_00..label_08
FEATS = list(metadata["feature_columns"])         # v000..v009
MAX_COST = max(COSTS.values())

cal_scores = pd.read_csv("data/calibration_scores.csv")
cal_labels = pd.read_csv("data/calibration_labels.csv")
cal_feats = pd.read_csv("data/calibration_features.csv")
dep_scores = pd.read_csv("data/deployment_scores.csv")
dep_feats = pd.read_csv("data/deployment_features.csv")

cal = cal_scores.merge(cal_labels, on="record_id").merge(cal_feats, on="record_id")
dep = dep_scores.merge(dep_feats, on="record_id")

assert cal[["record_id"]].duplicated().sum() == 0
assert dep[["record_id"]].duplicated().sum() == 0
assert not cal["true_label"].isna().any() and cal["true_label"].isin(LABELS).all()
assert (cal[LABELS].sum(axis=1) - 1.0).abs().max() < 1e-9
assert (dep[LABELS].sum(axis=1) - 1.0).abs().max() < 1e-9
assert "true_label" not in dep.columns

S = cal[LABELS].to_numpy()
y = cal["true_label"].to_numpy()
ti = np.array([LABELS.index(l) for l in y])
cost_y = np.array([COSTS[l] for l in y])
X = cal[FEATS].to_numpy()
D = dep[LABELS].to_numpy()
XD = dep[FEATS].to_numpy()
n_cal, n_dep = len(cal), len(dep)

# ------------------------------------------------- conformal-style split 70/30
rng = np.random.default_rng(RNG_SEED)
fit_idx, hold_idx = [], []
for l in LABELS:
    m = np.where(y == l)[0]
    perm = rng.permutation(m)
    cut = int(round(0.70 * len(m)))
    fit_idx.extend(perm[:cut].tolist())
    hold_idx.extend(perm[cut:].tolist())
fit_idx = np.array(sorted(fit_idx))
hold_idx = np.array(sorted(hold_idx))
n_fit, n_hold = len(fit_idx), len(hold_idx)

# ----------------------------------------------- kNN model (fit split only)
mu_x, sd_x = X[fit_idx].mean(0), X[fit_idx].std(0)
Xd_fit = (X[fit_idx] - mu_x) / sd_x
tree = cKDTree(Xd_fit)
S_fit = S[fit_idx]
ti_fit = ti[fit_idx]

def knn_topk(Xq, k):
    """(n, k) label indices: top-k by mean neighbour score (score-weighted votes)."""
    _, nn = tree.query((Xq - mu_x) / sd_x, k=KNN_K)
    soft = S_fit[nn].mean(axis=1)
    return np.argsort(-soft, axis=1)[:, :k]

# --------------------------------------------- proxy strata: v000 quintiles
cutpoints = np.quantile(X[fit_idx, 0], np.linspace(0, 1, N_STRATA + 1)[1:-1])
def stratum_of(v000):
    return np.clip(np.searchsorted(cutpoints, v000), 0, N_STRATA - 1)
G_hold = stratum_of(X[hold_idx, 0])
G_dep = stratum_of(XD[:, 0])
SNAME = [f"Q{g+1}" for g in range(N_STRATA)]

# ------------------------------------------------ candidate grid on holdout
def eval_candidates_on_holdout():
    """Per stratum: holdout risk and mean set size for every (t, k)."""
    S_h = S[hold_idx]
    out = {}
    for g in range(N_STRATA):
        m = G_hold == g
        idxs_by_k = {k: knn_topk(X[hold_idx[m]], k) for k in K_GRID}
        tab = []
        for t in T_GRID:
            for k in K_GRID:
                idxs = idxs_by_k[k]
                ng = m.sum()
                miss = np.zeros(ng, dtype=bool)
                sz = np.zeros(ng)
                for i in range(ng):
                    s = np.unique(np.concatenate([np.where(S_h[m][i] >= t)[0], idxs[i]]))
                    sz[i] = len(s)
                    miss[i] = ti[hold_idx[m]][i] not in s
                tab.append((t, k, int(ng),
                            float(np.sum(cost_y[hold_idx[m]][miss]) / ng),
                            float(sz.mean())))
        out[g] = tab
    return out

def pick_policy(margin):
    """Per stratum: min mean set size s.t. holdout risk <= margin*TARGET.
    Fallback: min-risk candidate. Returns g -> (t, k, risk, msz, feasible)."""
    tabs = eval_candidates_on_holdout()
    choice = {}
    for g in range(N_STRATA):
        tab = tabs[g]
        feas = [r for r in tab if r[3] <= margin * TARGET + 1e-12]
        if feas:
            t, k, ng, risk, msz = min(feas, key=lambda r: (r[4], r[3], r[0], r[1]))
            choice[g] = (t, k, risk, msz, True)
        else:
            t, k, ng, risk, msz = min(tab, key=lambda r: (r[3], r[4]))
            choice[g] = (t, k, risk, msz, False)
    return choice

def overall_risk(choice):
    f_dep = np.bincount(G_dep, minlength=N_STRATA) / n_dep
    return float(np.sum(f_dep * [choice[g][2] for g in range(N_STRATA)]))

def mean_dep_set_size(choice):
    sizes = np.empty(n_dep)
    for g in range(N_STRATA):
        m = G_dep == g
        t, k = choice[g][0], choice[g][1]
        idxs = knn_topk(XD[m], k)
        sh = D[m]
        sizes[m] = [len(np.unique(np.concatenate([np.where(sh[i] >= t)[0], idxs[i]])))
                    for i in range(m.sum())]
    return float(sizes.mean())

# ------------------------------------------------- margin search (both constraints)
margin_used, choice = None, None
margin_curve = []
for margin in MARGIN_STEPS:
    ch = pick_policy(margin)
    ov = overall_risk(ch)
    msz = mean_dep_set_size(ch)
    margin_curve.append((margin, ov, msz, ch))
# chosen policy = tightest margin whose deployment-weighted overall estimate
# meets the target (all steps are computed so the tradeoff curve is complete)
for margin, ov, msz, ch in margin_curve:
    if ov <= TARGET + 1e-12:
        margin_used, choice = margin, ch
        break
if choice is None:
    margin_used, choice = MARGIN_STEPS[-1], margin_curve[-1][3]

def in_sample_risk(ch):
    tot = 0.0
    for g in range(N_STRATA):
        m = stratum_of(X[fit_idx, 0]) == g
        t, k = ch[g][0], ch[g][1]
        idxs = knn_topk(X[fit_idx[m]], k)
        Sh = S[fit_idx[m]]
        for i in range(m.sum()):
            s = np.unique(np.concatenate([np.where(Sh[i] >= t)[0], idxs[i]]))
            if ti_fit[m][i] not in s:
                tot += cost_y[fit_idx[m]][i]
    return tot / n_fit

# ------------------------------------------------- kNN in-sample vs holdout gap
def knn_coverage(idxs_arr, k):
    topk = knn_topk(X[idxs_arr], k)
    t = ti[idxs_arr]
    return float(np.mean([t[i] in topk[i, :k] for i in range(len(idxs_arr))]))

gap_rows = {
    "knn_top1_fit":     knn_coverage(fit_idx, 1),
    "knn_top1_holdout": knn_coverage(hold_idx, 1),
    "knn_top3_fit":     knn_coverage(fit_idx, 3),
    "knn_top3_holdout": knn_coverage(hold_idx, 3),
}

# ------------------------------------------------- deployment prediction sets
dep_sets, dep_sizes = {}, np.empty(n_dep, dtype=int)
for g in range(N_STRATA):
    m = G_dep == g
    t, k = choice[g][0], choice[g][1]
    idxs = knn_topk(XD[m], k)
    sh = D[m]
    for i in range(m.sum()):
        s = np.unique(np.concatenate([np.where(sh[i] >= t)[0], idxs[i]]))
        if len(s) == 0:                      # safety: never empty
            s = np.array([int(np.argmax(sh[i]))])
        gi = int(np.where(m)[0][i])
        dep_sets[gi] = s
        dep_sizes[gi] = len(s)

pd.DataFrame([(dep["record_id"][i], " ".join(LABELS[j] for j in np.sort(dep_sets[i])))
              for i in range(n_dep)],
             columns=["record_id", "prediction_set"]).to_csv(
    "results/prediction_sets.csv", index=False)

# ------------------------------------------------- per-stratum holdout stats
def holdout_stratum_stats(g):
    m = G_hold == g
    t, k = choice[g][0], choice[g][1]
    idxs = knn_topk(X[hold_idx[m]], k)
    Sh = S[hold_idx[m]]
    sizes, miss_cost = [], []
    for i in range(m.sum()):
        s = np.unique(np.concatenate([np.where(Sh[i] >= t)[0], idxs[i]]))
        sizes.append(len(s))
        miss_cost.append(cost_y[hold_idx[m]][i] if ti[hold_idx[m]][i] not in s else 0.0)
    risk = float(np.mean(miss_cost))
    uc = risk + MAX_COST * np.sqrt(np.log(1 / (1 - CONF)) / (2 * m.sum()))  # Hoeffding
    return dict(n=int(m.sum()), risk=risk, uc=float(uc),
                msz=float(np.mean(sizes)), p90=float(np.percentile(sizes, 90)),
                label_counts={l: int((y[hold_idx[m]] == l).sum()) for l in LABELS})

hstat = {g: holdout_stratum_stats(g) for g in range(N_STRATA)}
f_dep = np.bincount(G_dep, minlength=N_STRATA) / n_dep
f_cal = np.bincount(stratum_of(X[:, 0]), minlength=N_STRATA) / n_cal
ov_est = overall_risk(choice)

# ------------------------------------------------- results/policy_parameters.csv
pol = []
for g in range(N_STRATA):
    t, k, risk, msz, feas = choice[g]
    st = hstat[g]
    for l in LABELS:
        pol.append(dict(
            proxy_stratum=SNAME[g], label=l,
            n_calibration=st["n"], n_calibration_label=st["label_counts"][l],
            threshold=t,
            group_empirical_weighted_miss_risk=risk,
            group_upper_confidence_risk=st["uc"],
            group_expected_set_size=msz,
            calibration_target_risk=margin_used * TARGET,
            target_risk=TARGET))
pd.DataFrame(pol).to_csv("results/policy_parameters.csv", index=False)

# ------------------------------------------------- results/set_size_summary.csv
pd.DataFrame({
    "record_id": dep["record_id"],
    "set_size": dep_sizes,
    "proxy_stratum": [SNAME[g] for g in G_dep],
}).to_csv("results/set_size_summary.csv", index=False)

# ------------------------------------------------- per-stratum deployment set stats
dep_p90 = {g: float(np.percentile(dep_sizes[G_dep == g], 90)) for g in range(N_STRATA)}
dep_msz = {g: float(dep_sizes[G_dep == g].mean()) for g in range(N_STRATA)}

# ------------------------------------------------- results/audit_summary.csv
# NOTE: empirical_risk is a holdout-based ESTIMATE (deployment labels hidden),
# shift-adjusted by per-stratum deployment/calibration fractions.
aud = [dict(scope="overall", stratum_id="all", n_records=n_dep,
            empirical_risk=ov_est, mean_set_size=float(dep_sizes.mean()),
            p90_set_size=float(np.percentile(dep_sizes, 90)),
            target_risk=TARGET, risk_violation=bool(ov_est > TARGET))]
for g in range(N_STRATA):
    r = hstat[g]["risk"]
    aud.append(dict(scope="proxy_stratum", stratum_id=SNAME[g],
                    n_records=int((G_dep == g).sum()),
                    empirical_risk=r, mean_set_size=dep_msz[g],
                    p90_set_size=dep_p90[g],
                    target_risk=TARGET, risk_violation=bool(r > TARGET)))
pd.DataFrame(aud).to_csv("results/audit_summary.csv", index=False)

# ------------------------------------------------- results/partition_diagnostics.csv
part = []
for g in range(N_STRATA):
    r = hstat[g]["risk"]
    part.append(dict(scope="proxy_stratum", stratum_id=SNAME[g],
                     n_records=int((G_dep == g).sum()),
                     empirical_risk=r, mean_set_size=dep_msz[g],
                     p90_set_size=dep_p90[g], target_risk=TARGET,
                     risk_margin=TARGET - r))
pd.DataFrame(part).to_csv("results/partition_diagnostics.csv", index=False)

# ------------------------------------------------- results/distribution_diagnostics.csv
dist = []
for g in range(N_STRATA):
    cf_, df_ = f_cal[g], f_dep[g]
    dist.append(dict(proxy_stratum=SNAME[g], calibration_fraction=cf_,
                     deployment_fraction=df_,
                     density_ratio_estimate=df_ / max(cf_, 1.0 / n_cal),
                     absolute_fraction_shift=abs(df_ - cf_)))
pd.DataFrame(dist).to_csv("results/distribution_diagnostics.csv", index=False)

# ------------------------------------------------- results/calibration_diagnostics.csv
cd = []
G_all = stratum_of(X[:, 0])
maxscore = S.max(axis=1)
for g in range(N_STRATA):
    m = G_all == g
    edges = np.quantile(maxscore[m], np.linspace(0, 1, 11))
    bb = np.full(n_cal, -1)
    bb[np.where(m)[0]] = np.clip(np.searchsorted(edges, maxscore[m], side="right") - 1, 0, 9)
    for b_id in range(10):
        mb = m & (bb == b_id)
        ii = np.where(mb)[0]
        cd.append(dict(proxy_stratum=SNAME[g], bin_id=f"b{b_id+1:02d}",
                       score_left=float(edges[b_id]), score_right=float(edges[b_id + 1]),
                       n_records=int(mb.sum()),
                       mean_true_label_score=float(S[ii, ti[ii]].mean()) if mb.sum() else np.nan))
# kNN in-sample vs holdout gap (documented convention:
# proxy_stratum='model_gap'; mean_true_label_score = kNN top-k true-label coverage)
for name, val in gap_rows.items():
    cd.append(dict(proxy_stratum="model_gap", bin_id=name,
                   score_left=0.0, score_right=1.0,
                   n_records=(n_fit if "fit" in name else n_hold),
                   mean_true_label_score=val))
pd.DataFrame(cd).to_csv("results/calibration_diagnostics.csv", index=False)

# ------------------------------------------------- results/constraint_audit.csv
ca = [dict(scope="overall", stratum_id="all", empirical_risk=ov_est,
           target_risk=TARGET, risk_violation=bool(ov_est > TARGET),
           violates=bool(ov_est > TARGET))]
for g in range(N_STRATA):
    r = hstat[g]["risk"]
    ca.append(dict(scope="proxy_stratum", stratum_id=SNAME[g], empirical_risk=r,
                   target_risk=TARGET, risk_violation=bool(r > TARGET),
                   violates=bool(r > TARGET)))
pd.DataFrame(ca).to_csv("results/constraint_audit.csv", index=False)

