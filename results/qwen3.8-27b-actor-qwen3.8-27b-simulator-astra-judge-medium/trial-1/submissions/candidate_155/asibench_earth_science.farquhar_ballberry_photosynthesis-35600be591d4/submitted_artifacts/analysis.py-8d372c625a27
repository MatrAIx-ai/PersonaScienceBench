#!/usr/bin/env python3
"""
Leaf Physiological Response Reconstruction
==========================================
Land-surface coupled Farquhar(C3) / Collatz(C4) photosynthesis + Ball-Berry
stomatal conductance, closed with a gas-diffusion chain to a common
(Ci, A) fixed point, following the exact scientific convention in the task.

Outputs (under results/):
  leaf_fluxes.csv       one row per forcing.csv row
  case_convergence.csv  one row per test_cases.json record
  diurnal.png           diurnal A and rs for sunlit + shaded leaves (5 days)

The figure is rendered with a small self-contained PNG writer (numpy +
zlib + struct) so the script runs without matplotlib / PIL.
"""
import os
import json
import math
import zlib
import struct
import numpy as np
import pandas as pd

# ----------------------------------------------------------------------
# Physical constants / conventions
# ----------------------------------------------------------------------
R = 8.314                 # J mol-1 K-1
Kc25 = 30.0               # Pa   (C3 CO2 affinity at 25 C)
Ko25 = 30000.0            # Pa   (C3 O2 affinity at 25 C)
Q10_Kc = 2.1              # Q10 for Kc
Q10_Ko = 1.2              # Q10 for Ko
# (Vcmax Q10 = 2.4 is in the Vcmax(T) formula)

NIGHT_PAR_THRESH = 1e-6   # W m-2 ; below this -> night (respiratory)
TOL = 1e-8                # Ci convergence tolerance (Pa)
MAXIT = 1000              # max Picard iterations


def esat_water(T_K):
    """Saturation vapour pressure over liquid water (Pa), Magnus/Tetens."""
    Tc = T_K - 273.15
    return 611.21 * np.exp(17.502 * Tc / (T_K - 38.15))


def vcmax_T(vcmax25, T_K):
    """CLM/Noah-MP Q10 Vcmax with high-temperature inhibition (umol m-2 s-1)."""
    Tc = T_K - 273.16
    Tk = Tc + 273.16
    base = vcmax25 * 2.4 ** ((Tc - 25.0) / 10.0)
    inhib = 1.0 + np.exp((-2.2e5 + 710.0 * Tk) / (R * Tk))
    return base / inhib


def kc_ko_gs(T_K, o2_pa):
    """C3 temperature-scaled Kc, Ko and CO2 compensation point Gamma_star."""
    Tc = T_K - 273.16
    Kc = Kc25 * Q10_Kc ** ((Tc - 25.0) / 10.0)
    Ko = Ko25 * Q10_Ko ** ((Tc - 25.0) / 10.0)
    gamma_star = 0.5 * (Kc / Ko) * o2_pa * 0.21
    return Kc, Ko, gamma_star


class LeafModel:
    """Leaf parameters + per-row forcing -> coupled (Ci, A) solve."""

    def __init__(self, params):
        self.pathway = params["pathway"]
        self.vcmax25 = float(params["vcmax25"])
        self.bb_slope = float(params["bb_slope"])      # m
        self.b0 = float(params["bb_intercept"])        # intercept conductance
        self.alpha_q = float(params["alpha_q"])
        self.n_factor = float(params["n_factor"])

    def _derived(self, row):
        T = float(row["t_air_K"])
        p_atm = float(row["p_atm_Pa"])
        Vc_T = vcmax_T(self.vcmax25, T)
        Vc_eff = Vc_T * self.n_factor * float(row["btran"])
        Rd = 0.015 * Vc_eff
        cf = p_atm / (R * T)
        es = esat_water(T)
        h_s = min(max(1.0 - float(row["vpd_Pa"]) / es, 0.25), 1.0)
        return T, p_atm, Vc_eff, Rd, cf, h_s

    def _gross(self, Ci, Vc_eff, Rd, APAR, p_atm, o2_pa, T):
        """min(Wc, Wj, We) - Rd  (Ci in Pa, umol m-2 s-1)."""
        if self.pathway == "C4":
            Wc = Vc_eff
            Wj = self.alpha_q * APAR
            We = 4000.0 * Vc_eff * Ci / p_atm
        else:  # C3 (Farquhar)
            Kc, Ko, gamma_star = kc_ko_gs(T, o2_pa)
            Wc = Vc_eff * (Ci - gamma_star) / (Ci + Kc * (1.0 + o2_pa / Ko))
            J = self.alpha_q * APAR
            Wj = J * (Ci - gamma_star) / (4.0 * Ci + 8.0 * gamma_star)
            We = 0.5 * Vc_eff
        return min(Wc, Wj, We) - Rd

    def _diffusion(self, A_umol, ca, rb, cf, p_atm, h_s, gs_override=None):
        """Given A (umol), return cs, gs, rs, Ci (Pa)."""
        A_mol = A_umol / 1e6
        cs = ca - 1.37 * rb * A_mol / cf * p_atm
        if gs_override is not None:
            gs = gs_override
        else:
            gs = self.bb_slope * A_mol * h_s / cs * p_atm + self.b0
        rs = cf / gs
        ci = cs - 1.65 * rs * A_mol / cf * p_atm
        return cs, gs, rs, ci

    def solve_day(self, row, par, ci0, tol=TOL, maxit=MAXIT):
        """Coupled (Ci, A) fixed point under light."""
        T, p_atm, Vc_eff, Rd, cf, h_s = self._derived(row)
        ca = float(row["co2_pa"]); o2 = float(row["o2_pa"])
        rb = float(row["rb_sm"])
        APAR = 4.6 * max(par, 0.0)

        ci = ci0
        n_iter = 0
        A = self._gross(ci, Vc_eff, Rd, APAR, p_atm, o2, T)
        for it in range(1, maxit + 1):
            cs, gs, rs, ci_new = self._diffusion(A, ca, rb, cf, p_atm, h_s)
            n_iter = it
            if abs(ci_new - ci) < tol:
                ci = ci_new
                break
            ci = ci_new
            A = self._gross(ci, Vc_eff, Rd, APAR, p_atm, o2, T)
        A = self._gross(ci, Vc_eff, Rd, APAR, p_atm, o2, T)
        cs, gs, rs, ci = self._diffusion(A, ca, rb, cf, p_atm, h_s)
        return {"A": A, "ci": ci, "gs": gs, "rs": rs, "n_iter": n_iter}

    def solve_night(self, row):
        """Night: respiratory assimilation A=-Rd, intercept conductance b0."""
        T, p_atm, Vc_eff, Rd, cf, h_s = self._derived(row)
        ca = float(row["co2_pa"]); rb = float(row["rb_sm"])
        A = -Rd
        cs, gs, rs, ci = self._diffusion(A, ca, rb, cf, p_atm, h_s,
                                         gs_override=self.b0)
        return {"A": A, "ci": ci, "gs": gs, "rs": rs, "n_iter": 0}

    def solve(self, row, par, ci0):
        """Dispatch day/night for a given PAR value (ci0 used for day only)."""
        if par <= NIGHT_PAR_THRESH:
            return self.solve_night(row)
        return self.solve_day(row, par, ci0)


# ----------------------------------------------------------------------
# Minimal PNG writer (no external image library)
# ----------------------------------------------------------------------
def write_png(path, img):
    """img: uint8 HxWx3 RGB array."""
    h, w = img.shape[:2]

    def chunk(typ, data):
        c = typ + data
        return struct.pack(">I", len(data)) + c + struct.pack(
            ">I", zlib.crc32(c) & 0xFFFFFFFF)

    raw = bytearray()
    for y in range(h):
        raw.append(0)                 # filter type 0 (None)
        raw.extend(img[y].tobytes())
    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)  # 8-bit RGB
    with open(path, "wb") as f:
        f.write(sig)
        f.write(chunk(b"IHDR", ihdr))
        f.write(chunk(b"IDAT", zlib.compress(bytes(raw), 6)))
        f.write(chunk(b"IEND", b""))


