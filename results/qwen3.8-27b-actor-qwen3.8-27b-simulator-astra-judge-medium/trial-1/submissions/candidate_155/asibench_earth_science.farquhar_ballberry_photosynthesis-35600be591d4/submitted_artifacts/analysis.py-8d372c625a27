def _stamp(img, x, y, r, color):
    x = int(round(x)); y = int(round(y))
    H, W = img.shape[:2]
    for dy in range(-r, r + 1):
        yy = y + dy
        if yy < 0 or yy >= H:
            continue
        for dx in range(-r, r + 1):
            xx = x + dx
            if 0 <= xx < W:
                img[yy, xx] = color


def _line(img, x0, y0, x1, y1, color, r=2, dash=None):
    dx = x1 - x0; dy = y1 - y0
    L = math.hypot(dx, dy)
    if L == 0:
        _stamp(img, x0, y0, r, color); return
    n = max(2, int(L))
    for i in range(n + 1):
        t = i / n
        if dash and (i % dash) > dash * 0.55:
            continue
        _stamp(img, x0 + dx * t, y0 + dy * t, r, color)


def _rect(img, x0, y0, x1, y1, color, r=1):
    _line(img, x0, y0, x1, y0, color, r)
    _line(img, x1, y0, x1, y1, color, r)
    _line(img, x1, y1, x0, y1, color, r)
    _line(img, x0, y1, x0, y0, color, r)


def _text(img, x, y, s, color, scale=2):
    cx = x
    H, W = img.shape[:2]
    for ch in s:
        g = FONT.get(ch)
        if g is not None:
            for ry in range(7):
                row = g[ry]
                for rx in range(5):
                    if row[rx] == '1':
                        for sy in range(scale):
                            yy = int(round(y + ry * scale + sy))
                            if yy < 0 or yy >= H:
                                continue
                            for sx in range(scale):
                                xx = int(round(cx + rx * scale + sx))
                                if 0 <= xx < W:
                                    img[yy, xx] = color
        cx += 6 * scale
    return cx


def _text_w(s, scale=2):
    return len(s) * 6 * scale


def _nice_ticks(lo, hi, n=5):
    if hi <= lo:
        hi = lo + 1.0
    span = hi - lo
    step0 = span / max(1, n)
    mag = 10 ** math.floor(math.log10(step0))
    step = mag
    for m in (1, 2, 2.5, 5, 10):
        step = m * mag
        if step >= step0:
            break
    start = math.ceil(lo / step) * step
    ticks = []
    v = start
    while v <= hi + 1e-9:
        ticks.append(v)
        v += step
    return ticks


def make_figure(flux, path):
    W, H = 1000, 700
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    BLACK = (0, 0, 0)
    GRAY = (205, 205, 205)
    SUN = (232, 119, 30)
    SHADE = (218, 165, 32)

    t = flux["time_hr"].to_numpy(dtype=float)
    x_lo, x_hi = float(t.min()), float(t.max())
    LX, RX = 75, 940

    title = "Diurnal A and rs (sun vs shade) - 5 days"
    _text(img, (W - _text_w(title)) // 2, 12, title, BLACK, 3)

    def draw_panel(y0, y1, y_sun, y_shd, ylab, y_lo, y_hi):
        def X(x): return LX + (x - x_lo) / (x_hi - x_lo) * (RX - LX)
        def Y(y): return y1 - (y - y_lo) / (y_hi - y_lo) * (y1 - y0)
        _rect(img, LX, y0, RX, y1, BLACK, 1)
        for gx in _nice_ticks(x_lo, x_hi, 6):
            _line(img, X(gx), y0, X(gx), y1, GRAY, 1)
        for gy in _nice_ticks(y_lo, y_hi, 5):
            _line(img, LX, Y(gy), RX, Y(gy), GRAY, 1)
        if y_lo < 0 < y_hi:
            _line(img, LX, Y(0), RX, Y(0), (150, 150, 150), 1)
        for i in range(len(t) - 1):
            _line(img, X(t[i]), Y(y_shd[i]), X(t[i + 1]), Y(y_shd[i + 1]),
                  SHADE, 2, dash=9)
        for i in range(len(t) - 1):
            _line(img, X(t[i]), Y(y_sun[i]), X(t[i + 1]), Y(y_sun[i + 1]),
                  SUN, 2)
        for gx in _nice_ticks(x_lo, x_hi, 6):
            lab = "%d" % int(round(gx))
            _text(img, X(gx) - _text_w(lab) // 2, y1 + 6, lab, BLACK, 2)
        for gy in _nice_ticks(y_lo, y_hi, 5):
            lab = "%d" % int(round(gy))
            _text(img, LX - _text_w(lab) - 6, Y(gy) - 7, lab, BLACK, 2)
        _text(img, 8, (y0 + y1) // 2 - 7, ylab, BLACK, 2)

    A_sun = flux["A_sun"].to_numpy(dtype=float)
    A_shd = flux["A_shade"].to_numpy(dtype=float)
    rs_sun = flux["rs_sun"].to_numpy(dtype=float)
    rs_shd = flux["rs_shade"].to_numpy(dtype=float)

    # A panel: include 0 and a little pad
    a_lo = min(A_sun.min(), A_shd.min(), 0.0)
    a_hi = max(A_sun.max(), A_shd.max())
    a_pad = (a_hi - a_lo) * 0.07
    draw_panel(60, 330, A_sun, A_shd, "A (umol m-2 s-1)", a_lo - a_pad,
               a_hi + a_pad)

    # rs panel: from 0
    r_hi = max(rs_sun.max(), rs_shd.max())
    draw_panel(400, 655, rs_sun, rs_shd, "rs (s m-1)", 0.0, r_hi * 1.07)

    xtitle = "time (h)"
    _text(img, (W - _text_w(xtitle)) // 2, H - 22, xtitle, BLACK, 2)

    # legend (top-right of A panel)
    lx, ly = RX - 150, 60 + 12
    _line(img, lx, ly, lx + 34, ly, SUN, 2)
    _text(img, lx + 42, ly - 7, "sun", BLACK, 2)
    _line(img, lx, ly + 22, lx + 34, ly + 22, SHADE, 2, dash=9)
    _text(img, lx + 42, ly + 15, "shade", BLACK, 2)

    write_png(path, img)


def main():
    base = os.path.dirname(os.path.abspath(__file__))
    data = os.path.join(base, "data")
    out = os.path.join(base, "results")
    os.makedirs(out, exist_ok=True)

    with open(os.path.join(data, "leaf_params.json")) as f:
        params = json.load(f)
    forcing = pd.read_csv(os.path.join(data, "forcing.csv"))
    with open(os.path.join(data, "test_cases.json")) as f:
        cases = json.load(f)

    model = LeafModel(params)

    # ---- leaf_fluxes.csv (one row per forcing row) --------------------
    records = []
    prev_ci = {"sun": float(forcing["co2_pa"].iloc[0]),
               "shade": float(forcing["co2_pa"].iloc[0])}
    for _, row in forcing.iterrows():
        sun = model.solve(row, float(row["par_sun_wm2"]), prev_ci["sun"])
        shd = model.solve(row, float(row["par_shade_wm2"]), prev_ci["shade"])
        prev_ci["sun"] = sun["ci"]
        prev_ci["shade"] = shd["ci"]
        records.append({
            "time_hr": row["time_hr"],
            "A_sun": sun["A"], "A_shade": shd["A"],
            "rs_sun": sun["rs"], "rs_shade": shd["rs"],
            "ci_sun": sun["ci"], "ci_shade": shd["ci"],
            "gs_sun": sun["gs"], "gs_shade": shd["gs"],
        })
    flux = pd.DataFrame(records, columns=[
        "time_hr", "A_sun", "A_shade", "rs_sun", "rs_shade",
        "ci_sun", "ci_shade", "gs_sun", "gs_shade"])
    flux.to_csv(os.path.join(out, "leaf_fluxes.csv"), index=False)

    # ---- case_convergence.csv (iterate from ci_init to convergence) ---
    crecords = []
    for c in cases:
        row = forcing.iloc[int(c["forcing_index"])].copy()
        ci0 = float(c["ci_init_pa"])
        res = model.solve(row, float(row["par_sun_wm2"]), ci0)
        crecords.append({
            "case_id": c["case_id"],
            "ci_init_pa": ci0,
            "ci_final_pa": res["ci"],
            "A_final": res["A"],
            "rs_final": res["rs"],
            "n_iterations": res["n_iter"],
        })
    cdf = pd.DataFrame(crecords, columns=[
        "case_id", "ci_init_pa", "ci_final_pa", "A_final", "rs_final",
        "n_iterations"])
    cdf.to_csv(os.path.join(out, "case_convergence.csv"), index=False)

    # ---- diurnal.png ---------------------------------------------------
    make_figure(flux, os.path.join(out, "diurnal.png"))

    # ---- console summary ----------------------------------------------
    pd.set_option("display.width", 200)
    print("=== leaf_fluxes.csv (head/tail) ===")
    print(flux.head(3).to_string(index=False))
    print("...")
    print(flux.tail(3).to_string(index=False))
    print("\nA_sun range   :", round(float(flux["A_sun"].min()), 4),
          "to", round(float(flux["A_sun"].max()), 4))
    print("A_shade range :", round(float(flux["A_shade"].min()), 4),
          "to", round(float(flux["A_shade"].max()), 4))
    print("rs_sun range  :", round(float(flux["rs_sun"].min()), 3),
          "to", round(float(flux["rs_sun"].max()), 3))
    print("ci range      :",
          round(float(min(flux["ci_sun"].min(), flux["ci_shade"].min())), 3),
          "to",
          round(float(max(flux["ci_sun"].max(), flux["ci_shade"].max())), 3))
    print("\n=== case_convergence.csv ===")
    print(cdf.to_string(index=False))
    print("\nWrote:", sorted(os.listdir(out)))


if __name__ == "__main__":
    main()
