    def _save_png(path, buf):
        H, W = buf.shape[:2]
        raw = b"".join(b"\x00" + buf[y].tobytes() for y in range(H))
        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data
                    + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
        with open(path, "wb") as fh:
            fh.write(b"\x89PNG\r\n\x1a\n")
            fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)))
            fh.write(chunk(b"IDAT", zlib.compress(raw, 9)))
            fh.write(chunk(b"IEND", b""))

    class MiniCanvas:
        def __init__(self, W, H, bg=(255, 255, 255)):
            self.buf = np.full((H, W, 3), bg, np.uint8)
            self.H, self.W = H, W
        def rect(self, x0, y0, x1, y1, c):
            x0, y0 = max(0, int(x0)), max(0, int(y0))
            x1, y1 = min(self.W - 1, int(x1)), min(self.H - 1, int(y1))
            if x1 >= x0 and y1 >= y0:
                self.buf[y0:y1 + 1, x0:x1 + 1] = c
        def line(self, x0, y0, x1, y1, c, w=1):
            n = max(abs(int(x1) - int(x0)), abs(int(y1) - int(y0)), 1) * 2 + 1
            for t in np.linspace(0.0, 1.0, n):
                x = x0 + (x1 - x0) * t
                y = y0 + (y1 - y0) * t
                self.rect(x - w / 2, y - w / 2, x + w / 2 - 1, y + w / 2 - 1, c)
        def text(self, x, y, s, c, sc=2):
            x0 = x
            for ch in s.upper():
                g = _FONT.get(ch, _FONT[" "])
                for r in range(7):
                    bits = g[r]
                    for col in range(5):
                        if bits & (0x10 >> col):
                            self.rect(x0 + col * sc, y + r * sc,
                                      x0 + col * sc + sc - 1, y + (r + 1) * sc - 1, c)
                x0 += 6 * sc
        def textw(self, s, sc=2):
            return 6 * len(s) * sc

    class Panel:
        def __init__(self, cv, x, y, w, h):
            self.cv, self.x, self.y, self.w, self.h = cv, x, y, w, h
            self.xmin, self.xmax, self.ymin, self.ymax = 0.0, 1.0, 0.0, 1.0
        def rng(self, xmin, xmax, ymin, ymax):
            self.xmin, self.xmax, self.ymin, self.ymax = xmin, xmax, ymin, ymax
        def px(self, x):
            return self.x + (x - self.xmin) / (self.xmax - self.xmin) * self.w
        def py(self, y):
            return self.y + self.h - (y - self.ymin) / (self.ymax - self.ymin) * self.h
        def frame(self):
            c = (60, 60, 60)
            self.cv.rect(self.x, self.y, self.x + self.w, self.y, c)
            self.cv.rect(self.x, self.y + self.h, self.x + self.w, self.y + self.h, c)
            self.cv.rect(self.x, self.y, self.x, self.y + self.h, c)
            self.cv.rect(self.x + self.w, self.y, self.x + self.w, self.y + self.h, c)
        def plot(self, xs, ys, c, w=2, dashed=False):
            xs, ys = np.asarray(xs, float), np.asarray(ys, float)
            step = 2 if dashed else 1
            for i in range(0, len(xs) - 1, step):
                j = min(i + 1, len(xs) - 1)
                self.cv.line(self.px(xs[i]), self.py(ys[i]),
                             self.px(xs[j]), self.py(ys[j]), c, w)
        def xticks(self, vals, labels):
            for v, lab in zip(vals, labels):
                xp = int(self.px(v))
                self.cv.rect(xp, self.y + self.h, xp, self.y + self.h + 4, (60, 60, 60))
                self.cv.text(xp - self.cv.textw(lab) // 2, self.y + self.h + 6, lab, (0, 0, 0))
        def yticks(self, vals, labels, side="left", c=(0, 0, 0)):
            for v, lab in zip(vals, labels):
                yp = int(self.py(v))
                if side == "left":
                    self.cv.rect(self.x - 4, yp, self.x, yp, c)
                    self.cv.text(self.x - 6 - self.cv.textw(lab), yp - 7, lab, c)
                else:
                    self.cv.rect(self.x + self.w, yp, self.x + self.w + 4, yp, c)
                    self.cv.text(self.x + self.w + 6, yp - 7, lab, c)
        def legend(self, items, x=None, y=None):
            if x is None:
                x = self.x + self.w - 140
            if y is None:
                y = self.y + 8
            for (c, lab) in items:
                self.cv.line(x, y + 6, x + 18, y + 6, c, 2)
