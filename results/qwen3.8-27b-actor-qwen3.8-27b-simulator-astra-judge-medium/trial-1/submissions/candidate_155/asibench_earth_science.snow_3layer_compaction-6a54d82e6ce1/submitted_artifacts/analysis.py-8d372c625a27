#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
3-layer process-based snowpack model (fixed layer count = 3).

Inputs
  data/snowpack_init.json : initial state, 3 layers x
                            [thickness_m, density_kg_m3, ice_mm, liq_mm, temp_K]
                            (ice_mm is the layer ice water equivalent, mm;
                             verified: ice_mm == thickness_m * density_kg_m3)
  data/forcing.csv        : hourly t_air_K, p_atm_Pa, snowfall_mm_hr,
                            rainfall_mm_hr, sw_in_wm2, lw_in_wm2 (1632 h = 68 d)

Outputs (results/)
  snow_state.npy   : float64 (68, 3, 5), last axis =
                     [thickness_m, density_kg_m3, ice_mm, liq_mm, temp_K],
                     row d = state at t = 24*d h (row 0 = initial state,
                     row 67 = state at t = 1608 h)
  snow_summary.csv : day, swe_mm, snow_depth_m, melt_mm, refreeze_mm,
                     runoff_mm, mean_density_kg_m3
                     (daily fluxes accumulated over the 24 h preceding the
                      recorded state; day 0 = 0 by definition)
  snow_evolution.png : 2x3 diagnostic panels

ASSUMPTIONS (parameter choices, NOT data -- no wind, humidity, albedo or
ground heat flux are provided in the forcing):
  * sensible heat coefficient  h_s = 5.0 W m-2 K-1
  * latent heat coefficient    h_l = 2.0 W m-2 Pa-1, acting on
                              (e_air - e_surface), with fixed RH_air = 0.8
  * albedo 0.80 dry, 0.50 wet (linear in surface liquid fraction),
    emissivity 0.99
  * fresh-snow density rho_f = 100 + 2.0*(T_air - 263.15) kg/m3,
    clipped to [70, 200] kg/m3
  * adiabatic bottom boundary (no ground heat flux available)
  * water-holding capacity WHC = 0.33*(rho/1000)^(-0.5908) * ice_mm
    (Brun et al. 1992); excess liquid percolates downward; excess at the
    bottom of layer 3 while T >= 273.15 K leaves as runoff
  * compaction: Anderson & Niu (1999)
        drho/dt = C1*(1 - rho/rho_c)*exp(C2*rho/rho_c)*(dP/dt)/(rho_f*g)
    with C1 = 1.0e-3 s-1, C2 = 2.22, rho_c = 550 kg/m3,
    dP/dt = finite difference of overburden pressure, clamped >= 0
  * thermal conductivity k(rho) = 2.098 + 3.518e-3*rho W m-1 K-1 (Hutter 1983)
  * internal timestep dt = 300 s; forcing linearly interpolated hourly->5 min
  * new snowfall is merged into the top layer (fixed 3-layer structure)
    with SWE-weighted density and temperature
  * rainfall enters as liquid at 273.15 K (rain cooling neglected; rainfall
    is identically zero in this forcing)

Mass closure (asserted at every 300 s step, tolerance 1e-6 mm):
  SWE_total(t) = SWE_total(0) + cum_snowfall + cum_rainfall - cum_runoff
"""
import json
import os

import numpy as np
import pandas as pd

# ----------------------------------------------------------------- constants
G = 9.81                 # m s-2
T0 = 273.15              # K
L_F = 333_700.0          # J kg-1 latent heat of fusion
SIGMA = 5.670374e-8      # W m-2 K-4
EPS = 0.99               # snow emissivity
H_S = 5.0                # W m-2 K-1  (assumption: no wind in forcing)
H_L = 2.0                # W m-2 Pa-1 (assumption: no humidity in forcing)
RH_A = 0.8               # fixed relative humidity of air (assumption)
ALB_DRY, ALB_WET = 0.80, 0.50
C1, C2, RHO_C = 1.0e-3, 2.22, 550.0   # Anderson & Niu (1999)
RHO_F_DEFAULT = 100.0    # kg/m3, used before first snowfall
DT = 300.0               # s internal timestep
T_END_H = 1632.0         # forcing length
N_STEPS = int(round(T_END_H * 3600.0 / DT))   # 19584
N_DAYS = 68

# ----------------------------------------------------------------- helpers
def e_sat(T):
    """Saturation vapour pressure, Pa (Magnus)."""
    Tc = T - 273.15
    return 611.2 * np.exp(17.67 * Tc / (Tc + 243.5))


def rho_fresh(Ta):
    return float(np.clip(100.0 + 2.0 * (Ta - 263.15), 70.0, 200.0))


def k_cond(rho):
    return 2.098 + 3.518e-3 * rho


def whc_mm(rho, ice):
    """Water-holding capacity, mm liquid per layer (Brun et al. 1992)."""
    return 0.33 * (np.maximum(rho, 1.0) / 1000.0) ** (-0.5908) * ice


def cv_area(ice_mm, liq_mm, h_m):
    """Volumetric heat capacity per m2 of ground, J m-2 K-1."""
    air_vol = max(0.0, h_m - ice_mm / 917.0 - liq_mm / 1000.0)
    return ice_mm * 2100.0 + liq_mm * 4180.0 + air_vol * 1200.0


def surf_flux(Ts, Ta, SW, LW, alpha):
    """Net surface heat flux W m-2 (positive into the snowpack)."""
    ea = RH_A * e_sat(Ta)
    return ((1.0 - alpha) * SW + LW - EPS * SIGMA * Ts ** 4
            + H_S * (Ta - Ts) + H_L * (ea - e_sat(Ts)))


def thickness(ice, liq, rho):
    # h[m] = ice_mm/rho (since ice_mm = h_ice_m * rho) + liq_mm/1000
    return ice / rho + liq / 1000.0


def overburden(rho, h):
    P = np.zeros(3)
    for i in range(3):
        P[i] = sum(rho[j] * G * h[j] for j in range(i + 1, 3))
    return P


# ----------------------------------------------------------------- load data
init = json.load(open("data/snowpack_init.json"))
layers = init["layers"]
ice = np.array([l["ice_mm"] for l in layers])
liq = np.array([l["liq_mm"] for l in layers])
T = np.array([l["temp_K"] for l in layers])
rho = np.array([l["density_kg_m3"] for l in layers])
rho0 = rho.copy()

f = pd.read_csv("data/forcing.csv")
fhr = f["time_hr"].to_numpy()
ft_air = f["t_air_K"].to_numpy()
f_sw = f["sw_in_wm2"].to_numpy()
f_lw = f["lw_in_wm2"].to_numpy()
f_sf = f["snowfall_mm_hr"].to_numpy()
f_rf = f["rainfall_mm_hr"].to_numpy()

SWE0 = float(ice.sum() + liq.sum())
h = thickness(ice, liq, rho)
for i in range(3):
    assert abs(ice[i] - (h[i] - liq[i] / 1000.0) * rho[i]) < 1e-6, "ice_mm != h*rho in input"
print(f"initial: SWE0 = {SWE0:.3f} mm, depth = {h.sum():.4f} m")

# ----------------------------------------------------------------- state out
state = np.zeros((N_DAYS, 3, 5), dtype=np.float64)
summary_rows = []
cum_sf = cum_rf = cum_runoff = 0.0
melt_acc = refreeze_acc = runoff_acc = 0.0
melt_all = refreeze_all = runoff_all = 0.0
melt_hours = 0.0
surf_Ts_max = []
rho_f_now = RHO_F_DEFAULT
P_prev = overburden(rho, h)
max_liq, max_liq_t, max_liq_layer = 0.0, 0.0, -1
n_checks = 0


def record(idx):
    h = thickness(ice, liq, rho)
    state[idx] = np.stack([h, rho, ice, liq, T], axis=1)
    swe = (ice + liq).sum()
    mean_rho = float((rho * (ice + liq)).sum() / swe)
    summary_rows.append({
        "day": idx,
        "swe_mm": swe,
        "snow_depth_m": h.sum(),
        "melt_mm": melt_acc,
        "refreeze_mm": refreeze_acc,
        "runoff_mm": runoff_acc,
        "mean_density_kg_m3": mean_rho,
    })

# ----------------------------------------------------------------- main loop
def update_peak():
    global max_liq, max_liq_t, max_liq_layer
    j = int(np.argmax(liq))
    if liq[j] > max_liq:
        max_liq, max_liq_t, max_liq_layer = float(liq[j]), t_h, j


for k in range(N_STEPS + 1):
    t_h = k * DT / 3600.0
    day_idx = round(t_h / 24.0)
    # daily recording at day starts: t = 0, 24, ..., 1608 h
    if abs(t_h / 24.0 - day_idx) < 1e-9 and day_idx < N_DAYS:
        record(day_idx)
        melt_acc = refreeze_acc = runoff_acc = 0.0
    if k == N_STEPS:
        break

    t = k * DT
    Ta = float(np.interp(t_h, fhr, ft_air))
    SW = float(np.interp(t_h, fhr, f_sw))
    LW = float(np.interp(t_h, fhr, f_lw))
    SF = float(np.interp(t_h, fhr, f_sf))
    RF = float(np.interp(t_h, fhr, f_rf))

    # ------------------------------------------------ precipitation
    sf = SF * DT / 3600.0   # mm
    rf = RF * DT / 3600.0   # mm
    if sf > 0.0:
        r_f = rho_fresh(Ta)
        w_old = ice[0] + liq[0]
        rho[0] = (rho[0] * w_old + r_f * sf) / (w_old + sf)
        T[0] = (T[0] * w_old + Ta * sf) / (w_old + sf)
        ice[0] += sf
        cum_sf += sf
        rho_f_now = r_f
    if rf > 0.0:
        liq[0] += rf
        cum_rf += rf

    h = thickness(ice, liq, rho)

    # ------------------------------------------------ surface energy balance
    # The surface temperature Ts solves
    #   (1-a)*SW + LW - eps*sigma*Ts^4 + h_s*(Ta-Ts) + h_l*(ea-es(Ts))
    #       = k0*(Ts - T[0])/(h0/2)          (conduction into layer 0)
    # i.e. surf_h(Ts) = 0 with surf_h strictly decreasing -> unique root.
    # If the root lies above 273.15 K the surface is pinned at 0 C and the
    # surplus energy melts ice (energy-balance melt).
    swe0 = ice[0] + liq[0]
    liq_frac0 = liq[0] / swe0 if swe0 > 0 else 0.0
    alpha = max(ALB_WET, ALB_DRY - 0.3 * liq_frac0)
    h0 = thickness(ice, liq, rho)[0]
    k0 = k_cond(rho[0])
    def surf_h(Ts):
        return (surf_flux(Ts, Ta, SW, LW, alpha)
                - k0 * (Ts - T[0]) / (0.5 * h0))
    if swe0 > 0.0 and ice[0] > 0.0:
        h273 = surf_h(T0)
        if h273 > 0.0:
            melt_hours += DT / 3600.0
            m0 = min(ice[0], h273 * DT / L_F)
            ice[0] -= m0
            liq[0] += m0
            melt_acc += m0
            melt_all += m0
            F_top = k0 * (T0 - T[0]) / (0.5 * h0)
        else:
            lo, hi = 180.0, T0
            for _ in range(60):
                mid = 0.5 * (lo + hi)
                if surf_h(mid) > 0.0:
                    lo = mid
                else:
                    hi = mid
            Ts = 0.5 * (lo + hi)
            surf_Ts_max.append(Ts)
            F_top = k0 * (Ts - T[0]) / (0.5 * h0)
    else:
        # layer 0 fully liquid (guard): wet 0 C surface, no ice to melt
        F_top = k0 * (T0 - T[0]) / (0.5 * h0) if swe0 > 0.0 else 0.0

    update_peak()   # transient meltwater before in-step refreeze

    # ------------------------------------------------ inter-layer conduction
    h = thickness(ice, liq, rho)
    k01 = 2.0 * k_cond(rho[0]) * k_cond(rho[1]) / (k_cond(rho[0]) + k_cond(rho[1]))
    k12 = 2.0 * k_cond(rho[1]) * k_cond(rho[2]) / (k_cond(rho[1]) + k_cond(rho[2]))
    F01 = k01 * (T[0] - T[1]) / (0.5 * (h[0] + h[1]))
    F12 = k12 * (T[1] - T[2]) / (0.5 * (h[1] + h[2]))

    # ------------------------------------------------ layer heat balances
    # (a) spontaneous refreeze of supercooled liquid (releases latent heat)
    # (b) net conducted/surface heat: warm to 0 C, then melt (or cool/refreeze)
    for i in range(3):
        Qin = 0.0
        if i == 0:
            Qin += F_top - F01
        if i == 1:
            Qin += F01 - F12
        if i == 2:
            Qin += F12
        E = Qin * DT                       # J m-2
        Cv = cv_area(ice[i], liq[i], h[i])
        Ti = T[i]
        if Ti < T0 and liq[i] > 0.0:
            ref_cap = (T0 - Ti) * Cv / L_F
            ref = min(liq[i], ref_cap)
            liq[i] -= ref
            ice[i] += ref
            refreeze_acc += ref
            refreeze_all += ref
            Ti += ref * L_F / Cv
        if E > 0.0:
            if Ti < T0:
                need = (T0 - Ti) * Cv
                if E <= need:
                    Ti += E / Cv
                else:
                    E -= need
                    Ti = T0
                    mlt = min(ice[i], E / L_F)
                    ice[i] -= mlt
                    liq[i] += mlt
                    melt_acc += mlt
                    melt_all += mlt
                    E -= mlt * L_F
                    if E > 0:
                        Ti = T0 + E / Cv
            else:
                avail = Cv * (Ti - T0) + E
                if ice[i] > 0:
                    mlt = min(ice[i], avail / L_F)
                    ice[i] -= mlt
                    liq[i] += mlt
                    melt_acc += mlt
                    melt_all += mlt
                    avail -= mlt * L_F
                Ti = T0 + avail / Cv
        else:
            Ti += E / Cv
            if Ti < T0 and liq[i] > 0.0:
                ref = min(liq[i], (T0 - Ti) * Cv / L_F)
                liq[i] -= ref
                ice[i] += ref
                refreeze_acc += ref
                refreeze_all += ref
                Ti += ref * L_F / Cv
        T[i] = Ti

    # ------------------------------------------------ drainage / runoff
    for i in range(2):
        ex = liq[i] - whc_mm(rho[i], ice[i])
        if ex > 0.0:
            liq[i] -= ex
            liq[i + 1] += ex
    ex = liq[2] - whc_mm(rho[2], ice[2])
    if ex > 0.0 and T[2] >= T0:
        liq[2] -= ex
        runoff_acc += ex
        runoff_all += ex
        cum_runoff += ex

    # ------------------------------------------------ compaction (A-N 1999)
    h = thickness(ice, liq, rho)
    P = overburden(rho, h)
    dPdt = np.maximum((P - P_prev) / DT, 0.0)
    for i in range(3):
        if rho[i] < RHO_C:
            drho = (C1 * (1.0 - rho[i] / RHO_C)
                    * np.exp(C2 * rho[i] / RHO_C)
                    * dPdt[i] / (rho_f_now * G))
            rho[i] = min(RHO_C, rho[i] + drho * DT)
    P_prev = P
    # ------------------------------------------------ track peak liquid
    update_peak()

    # ------------------------------------------------ mass closure
    n_checks += 1
    swe_now = float(ice.sum() + liq.sum())
    expected = SWE0 + cum_sf + cum_rf - cum_runoff
    if abs(swe_now - expected) > 1e-6:
        raise AssertionError(
            f"mass closure failed at t={t_h:.3f} h: SWE={swe_now:.9f} mm "
            f"expected={expected:.9f} mm (diff {swe_now - expected:.3e})")

# ----------------------------------------------------------------- outputs
summary = pd.DataFrame(summary_rows)
assert len(summary) == N_DAYS, f"expected {N_DAYS} daily rows, got {len(summary)}"
assert list(summary.columns) == ["day", "swe_mm", "snow_depth_m", "melt_mm",
                                 "refreeze_mm", "runoff_mm",
                                 "mean_density_kg_m3"]
os.makedirs("results", exist_ok=True)
summary.to_csv("results/snow_summary.csv", index=False)
np.save("results/snow_state.npy", state)
assert state.shape == (N_DAYS, 3, 5) and state.dtype == np.float64

