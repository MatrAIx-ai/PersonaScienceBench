"""
Transmission-Line Target Prediction
===================================
Predicts the intrinsic frequency-domain transfer functions and received pulse
waveforms of 3 target lines from 8 calibration lines.

MODEL
-----
A 4-feature surrogate, validated against the 8 calibration lines at the data
noise floor (phase residual RMS ~0.024 rad, magnitude RMS ~0.05-0.12 dB):

    H(f) = exp( -2*pi*j*f*A  -  j*b*sqrt(f)  -  L*(a1*sqrt(f) + a2*f) )

  A    total one-way delay [s] = tau0*L + d*(L, r)
       tau0 = sqrt(L_per_m * C_per_m)   (per-meter delay from the CSV params)
       d*   length-independent pure-delay term (ns) fitted as
            d* = c0 + c1*L + c2*r   (all 8 calibration lines carry the same
            ~0.42 ns extra delay; it is part of the intrinsic line response
            generated by the same pipeline as the targets)
  b    sqrt(f) phase-dispersion coefficient [rad sqrt(Hz)]; per-meter physics:
       b = (s0 + s1*Rdc + s2*r) * L
  a1   skin-effect loss coefficient [Np/m / sqrt(Hz)]:
       a1 = p0 + p1*Rdc + p2*r
  a2   high-frequency (f-linear) loss coefficient [Np/m / Hz]:
       a2 = q0 + q1*Rdc + q2*r

All regression coefficients are re-fitted from the calibration data at
runtime (least squares, 8 points, linear features only).

CONVENTIONS
-----------
* SI units, exp(+j*omega*t) phasor convention: H(omega) = int h(t) e^{-j w t} dt,
  synthesis y(t) = ifft(H * fft(x)) (numpy ifft uses e^{+j2*pi*k*n/N}).
* phase_rad: continuous unwrapped branch through 0 at f=0 (monotonically
  decreasing). group_delay_s = -d(phase_rad)/d(omega):
  analytic A + b/(4*pi*sqrt(f)) for f > 0, and the one-sided finite
  difference of the *reported* phase array at f = 0.
* Waveform: the 2049-point frequency grid is exactly the DFT grid of the
  4096-sample input pulse (df = 1/(N*dt)), so no windowing or zero-padding.
  Two-sided spectrum: H_full[0] = 1 exactly, H_full[1..2047] = one-sided
  model values, Nyquist bin (2048) forced real, and conjugate mirror
  H_full[2049+k] = conj(H_full[2047-k]) for k = 0..2046 (H_full[k] =
  conj(H_full[N-k])), which guarantees a real-valued output.

METRIC DEFINITIONS
------------------
* input_fwhm_s / output_fwhm_s: full width at half maximum, half-maximum
  crossings found by linear interpolation of the sampled pulse.
* fwhm_broadening_ratio = output_fwhm_s / input_fwhm_s.
* peak positions: parabolic interpolation around the maximum sample.
* peak_delay_s = output peak time - input peak time.
* output_peak_time_s: parabolic-interpolated time of the output maximum.
* energy_ratio = sum(output^2) / sum(input^2)  (dt cancels).
* tail_asymmetry: (t_r - t_p) / (t_p - t_l) evaluated at the 50% (half-max)
  level of the OUTPUT pulse, where t_l, t_r are the left/right half-maximum
  crossing times and t_p the parabolic peak time. A symmetric pulse gives
  1.0; values > 1 mean a heavier right tail.
"""
import numpy as np
import pandas as pd

DATA = "data"
OUT = "results"
DB2NP = 20.0 / np.log(10.0)   # 8.68589...

# ----------------------------------------------------------------------
# 1. Load data
# ----------------------------------------------------------------------
cal_lines = pd.read_csv(f"{DATA}/calibration_lines.csv")
tgt_lines = pd.read_csv(f"{DATA}/target_lines.csv")
cal_tf = pd.read_csv(f"{DATA}/calibration_transfer.csv")
freq_grid = pd.read_csv(f"{DATA}/frequency_grid.csv")["frequency_hz"].values
pulse = pd.read_csv(f"{DATA}/input_pulse.csv")
t = pulse["time_s"].values
x = pulse["input_v"].values
N = len(t)
dt = t[1] - t[0]

# ----------------------------------------------------------------------
# 2. Per-calibration-line feature fits (f = 0 excluded from the fits)
# ----------------------------------------------------------------------
A_list, b_list, a1_list, a2_list = [], [], [], []
fit_quality = []
for _, row in cal_lines.iterrows():
    g = cal_tf[cal_tf["line_id"] == row["line_id"]].sort_values("frequency_hz")
    f = g["frequency_hz"].values
    mag = g["magnitude_db"].values
    ph = g["phase_rad"].values
    m = f > 0.0
    w = 2.0 * np.pi * f[m]
    # phase: -ph = w*A + b*sqrt(f)
    (A, b), *_ = np.linalg.lstsq(np.column_stack([w, np.sqrt(f[m])]), -ph[m], rcond=None)
    # attenuation per meter: alpha = a1*sqrt(f) + a2*f
    alpha = -mag[m] / DB2NP / row["length_m"]
    (a1, a2), *_ = np.linalg.lstsq(np.column_stack([np.sqrt(f[m]), f[m]]), alpha, rcond=None)
    A_list.append(A); b_list.append(b); a1_list.append(a1); a2_list.append(a2)
    # fit quality (for the report)
    Hm = np.exp(-1j * w * A - 1j * b * np.sqrt(f[m]) - row["length_m"] * (a1 * np.sqrt(f[m]) + a2 * f[m]))
    Hd = 10 ** (mag[m] / 20.0) * np.exp(1j * ph[m])
    fit_quality.append((row["line_id"],
                        np.sqrt(np.mean((20 * np.log10(np.abs(Hm) / np.abs(Hd))) ** 2)),
                        np.sqrt(np.mean((np.unwrap(np.angle(Hm)) - ph[m]) ** 2))))

A_arr = np.array(A_list)
b_arr = np.array(b_list)
a1_arr = np.array(a1_list)
a2_arr = np.array(a2_list)
L = cal_lines["length_m"].values
r = cal_lines["roughness_index"].values
Rdc = cal_lines["dc_resistance_ohm_per_m"].values
tau0 = np.sqrt(cal_lines["inductance_h_per_m"].values * cal_lines["capacitance_f_per_m"].values)

# ----------------------------------------------------------------------
# 3. Linear feature regressions on (L, r, Rdc)
# ----------------------------------------------------------------------
def linfit(y, cols):
    X = np.column_stack([np.ones(len(y))] + list(cols))
    coef, *_ = np.linalg.lstsq(X, y, rcond=None)
    return coef

dstar = (A_arr - tau0 * L) * 1e9                      # ns
cd = linfit(dstar, [L, r])                             # d* = c0 + c1*L + c2*r
ca1 = linfit(a1_arr, [Rdc, r])                         # a1
ca2 = linfit(a2_arr, [Rdc, r])                         # a2
cs = linfit(b_arr / L, [Rdc, r])                       # b/L

# ----------------------------------------------------------------------
# 4. Target features
# ----------------------------------------------------------------------
targets = []
for _, row in tgt_lines.iterrows():
    t0 = np.sqrt(row["inductance_h_per_m"] * row["capacitance_f_per_m"])
    dd = (cd[0] + cd[1] * row["length_m"] + cd[2] * row["roughness_index"]) * 1e-9  # s
    A_t = t0 * row["length_m"] + dd
    a1_t = ca1[0] + ca1[1] * row["dc_resistance_ohm_per_m"] + ca1[2] * row["roughness_index"]
    a2_t = ca2[0] + ca2[1] * row["dc_resistance_ohm_per_m"] + ca2[2] * row["roughness_index"]
    b_t = (cs[0] + cs[1] * row["dc_resistance_ohm_per_m"] + cs[2] * row["roughness_index"]) * row["length_m"]
    targets.append(dict(line_id=row["line_id"], L=row["length_m"], tau0=t0,
                        A=A_t, b=b_t, a1=a1_t, a2=a2_t, dstar=dd))

def target_spectrum(tg):
    """One-sided H(f) on the frequency grid; H(0)=1 exactly."""
    A, b, a1, a2, Lm = tg["A"], tg["b"], tg["a1"], tg["a2"], tg["L"]
    sf = np.sqrt(freq_grid)
    H1 = np.exp(-1j * 2.0 * np.pi * freq_grid * A - 1j * b * sf - Lm * (a1 * sf + a2 * freq_grid))
    H1[0] = 1.0 + 0.0j
    return H1

# ----------------------------------------------------------------------
# 5. results/target_transfer.csv
# ----------------------------------------------------------------------
f = freq_grid
w = 2.0 * np.pi * f
rows = []
for tg in targets:
    A, b, a1, a2, Lm = tg["A"], tg["b"], tg["a1"], tg["a2"], tg["L"]
    sf = np.sqrt(f)
    phase = -w * A - b * sf          # continuous unwrapped branch, 0 at f=0
    phase[0] = 0.0
    mag_db = -DB2NP * Lm * (a1 * sf + a2 * f)
    mag_db[0] = 0.0
    att = a1 * sf + a2 * f           # Np per meter
    gd = np.empty_like(f)
    gd[1:] = A + b / (4.0 * np.pi * sf[1:])   # analytic, for f > 0
    # f = 0: one-sided finite difference of the REPORTED phase array
    gd[0] = -(phase[1] - phase[0]) / (w[1] - w[0])
    for fi, md, ph_, gdi, ati in zip(f, mag_db, phase, gd, att):
        rows.append([tg["line_id"], fi, md, ph_, gdi, ati])
pd.DataFrame(rows, columns=["target_id", "frequency_hz", "magnitude_db",
                            "phase_rad", "group_delay_s", "attenuation_np_per_m"]
             ).to_csv(f"{OUT}/target_transfer.csv", index=False)

# ----------------------------------------------------------------------
# 6. results/target_waveforms.csv
# ----------------------------------------------------------------------
X = np.fft.fft(x)

def two_sided(H1):
    """Build the 4096-pt (N=4096) spectrum from the 2049-pt one-sided values.
    H_full[0] = 1 exactly; H_full[1..2047] = one-sided model values.
    The Nyquist bin (index 2048) is forced real (the model value there is
    complex, but |X| at 62.5 GHz is ~1e-30, so this is negligible; forcing
    it real is required for a real-valued output). Conjugate mirror:
    H_full[2049+k] = conj(H_full[2047-k]) for k = 0..2046, i.e.
    H_full[k] = conj(H_full[N-k]) for all k, which guarantees y is real."""
    Hfull = np.empty(N, dtype=complex)
    Hfull[0] = 1.0 + 0.0j
    Hfull[1:2048] = H1[1:2048]
    Hfull[2048] = H1[2048].real
    Hfull[2049:] = np.conj(Hfull[2047:0:-1])
    return Hfull

out_wave = {}
rows = []
for tg in targets:
    Hfull = two_sided(target_spectrum(tg))
    y = np.fft.ifft(Hfull * X).real
    out_wave[tg["line_id"]] = y
    for ti, xi, yi in zip(t, x, y):
        rows.append([tg["line_id"], ti, xi, yi])
pd.DataFrame(rows, columns=["target_id", "time_s", "input_v", "output_v"]
             ).to_csv(f"{OUT}/target_waveforms.csv", index=False)

# ----------------------------------------------------------------------
# 7. results/pulse_metrics.csv
# ----------------------------------------------------------------------
def half_crossings(t, v, level):
    i = int(np.argmax(v))
    l = i
    while v[l] > level:
        l -= 1
    tl = t[l] + (level - v[l]) / (v[l + 1] - v[l]) * (t[l + 1] - t[l])
    rr = i
    while v[rr] > level:
        rr += 1
    tr = t[rr] + (level - v[rr]) / (v[rr - 1] - v[rr]) * (t[rr - 1] - t[rr])
    return tl, tr

def parabolic_peak_time(t, v):
    i = int(np.argmax(v))
    if 0 < i < len(v) - 1:
        den = v[i - 1] - 2.0 * v[i] + v[i + 1]
        if den != 0.0:
            off = 0.5 * (v[i - 1] - v[i + 1]) / den
            return t[i] + off * (t[1] - t[0])
    return t[i]

def fwhm(t, v):
    tl, tr = half_crossings(t, v, 0.5 * v.max())
    return tr - tl

in_fwhm = fwhm(t, x)
in_peak = parabolic_peak_time(t, x)
in_energy = float(np.sum(x ** 2))

mrows = []
for tg in targets:
    y = out_wave[tg["line_id"]]
    out_fwhm = fwhm(t, y)
    out_peak = parabolic_peak_time(t, y)
    tl_out, tr_out = half_crossings(t, y, 0.5 * y.max())
    # tail_asymmetry: (t_r - t_p)/(t_p - t_l) at the 50% level of the output
    # pulse; 1.0 = symmetric, >1 = heavier right tail.
    tail_asym = (tr_out - out_peak) / (out_peak - tl_out)
    energy_ratio = float(np.sum(y ** 2)) / in_energy
    mrows.append([tg["line_id"], in_fwhm, out_fwhm, out_fwhm / in_fwhm,
                  out_peak - in_peak, out_peak, energy_ratio, tail_asym])
pd.DataFrame(mrows, columns=["target_id", "input_fwhm_s", "output_fwhm_s",
                             "fwhm_broadening_ratio", "peak_delay_s",
                             "output_peak_time_s", "energy_ratio", "tail_asymmetry"]
             ).to_csv(f"{OUT}/pulse_metrics.csv", index=False)

# ----------------------------------------------------------------------
# 8. Console report
# ----------------------------------------------------------------------
print("=== Calibration feature fits (per line) ===")
print(f"{'line':7s} {'A[ns]':>9s} {'b[rad*sqrtHz]':>15s} {'a1[Np/m/sqrtHz]':>17s} "
      f"{'a2[Np/m/Hz]':>13s} {'RMSdB':>7s} {'RMSrad':>8s}")
for i, (lid, rd, rp) in enumerate(fit_quality):
    print(f"{lid:7s} {A_arr[i]*1e9:9.4f} {b_arr[i]:15.4e} {a1_arr[i]:17.4e} "
          f"{a2_arr[i]:13.4e} {rd:7.4f} {rp:8.4f}")

print("\n=== Regression coefficients ===")
print(f"d* [ns]        = {cd[0]:.6f} + ({cd[1]:.6f})*L + ({cd[2]:.6f})*r")
print(f"a1 [Np/m/rtHz] = {ca1[0]:.4e} + ({ca1[1]:.4e})*Rdc + ({ca1[2]:.4e})*r")
print(f"a2 [Np/m/Hz]   = {ca2[0]:.4e} + ({ca2[1]:.4e})*Rdc + ({ca2[2]:.4e})*r")
print(f"b/L [rad*rtHz] = {cs[0]:.4e} + ({cs[1]:.4e})*Rdc + ({cs[2]:.4e})*r")

print("\n=== Target predictions ===")
for tg in targets:
    att62 = (tg["a1"] * np.sqrt(62.5e9) + tg["a2"] * 62.5e9) * tg["L"] * DB2NP
    print(f"{tg['line_id']}: tau0={tg['tau0']*1e9:.4f} ns/m  d*={tg['dstar']*1e9:.4f} ns  "
          f"A={tg['A']*1e9:.4f} ns  a1={tg['a1']:.4e}  a2={tg['a2']:.4e}  "
          f"b={tg['b']:.4e}  att@62.5GHz={att62:.3f} dB")

print("\n=== Pulse metrics ===")
print(f"input: FWHM={in_fwhm*1e9:.6f} ns  peak={in_peak*1e9:.6f} ns")
for mrow in mrows:
    print(f"{mrow[0]}: outFWHM={mrow[2]*1e9:.6f} ns  ratio={mrow[3]:.5f}  "
          f"peak_delay={mrow[4]*1e9:.6f} ns  outPeak={mrow[5]*1e9:.6f} ns  "
          f"E_out/E_in={mrow[6]:.6f}  tail_asym={mrow[7]:.5f}")

print("\nWrote: results/target_transfer.csv, results/target_waveforms.csv, results/pulse_metrics.csv")
