def render_fallback(path):
    W, H = 1600, 1000
    img = np.ones((H, W, 3), np.uint8) * 255
    BLACK = (0, 0, 0); BLUE = (0, 0, 190); RED = (200, 0, 0)
    GREEN = (0, 140, 0); PURP = (150, 0, 150)
    SNAPC = [(0, 0, 190), (200, 0, 0), (0, 140, 0), (150, 0, 150), (0, 140, 140), (190, 120, 0)]

    def px(x, y, c, r=1):
        x = int(round(x)); y = int(round(y))
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                xx, yy = x + dx, y + dy
                if 0 <= xx < W and 0 <= yy < H:
                    img[yy, xx] = c

    def seg(x0, y0, x1, y1, c, r=1):
        n = max(int(abs(x1 - x0) + abs(y1 - y0)) * 2, 2)
        for k in range(n + 1):
            f = k / n
            px(x0 + (x1 - x0) * f, y0 + (y1 - y0) * f, c, r)

    def border(x0, y0, x1, y1, c=BLACK, r=1):
        seg(x0, y0, x1, y0, c, r); seg(x0, y1, x1, y1, c, r)
        seg(x0, y0, x0, y1, c, r); seg(x1, y0, x1, y1, c, r)

    def text(x, y, s, c=BLACK, sc=2):
        cx = x
        for ch in s:
            g = FONT.get(ch.upper(), FONT[' '])
            for rr in range(7):
                for cc in range(5):
                    if g[rr][cc]:
                        px(cx + cc * sc, y + rr * sc, c, sc)
            cx += 6 * sc

    def axmap(x0, y0, x1, y1, v, lo, hi, log):
        f = (np.log(v) - np.log(lo)) / (np.log(hi) - np.log(lo)) if log else (v - lo) / (hi - lo)
        return x0 + f * (x1 - x0)

    def axmapy(x0, y0, x1, y1, v, lo, hi, log):
        f = (np.log(v) - np.log(lo)) / (np.log(hi) - np.log(lo)) if log else (v - lo) / (hi - lo)
        return y1 - f * (y1 - y0)

    def plot(x0, y0, x1, y1, xs, ys, xlo, xhi, ylo, yhi, c, logx, logy, r=1):
        xs = np.asarray(xs, float); ys = np.asarray(ys, float)
        ok = np.isfinite(xs) & np.isfinite(ys)
        ok &= (xs > 0) if logx else (xs >= xlo) & (xs <= xhi)
        ok &= (ys > 0) if logy else (ys >= ylo) & (ys <= yhi)
        prev = None
        for i in range(len(xs)):
            if not ok[i]:
                prev = None; continue
            Xp = axmap(x0, y0, x1, y1, xs[i], xlo, xhi, logx)
            Yp = axmapy(x0, y0, x1, y1, ys[i], ylo, yhi, logy)
            if prev is not None:
                seg(prev[0], prev[1], Xp, Yp, c, r)
            else:
                px(Xp, Yp, c, r)
            prev = (Xp, Yp)

    def scatter(x0, y0, x1, y1, xs, ys, xlo, xhi, ylo, yhi, c, logx, logy, r=1):
        xs = np.asarray(xs, float); ys = np.asarray(ys, float)
        for i in range(len(xs)):
            if not (np.isfinite(xs[i]) and np.isfinite(ys[i])): continue
            if logx and not xs[i] > 0: continue
            if not logx and not xlo <= xs[i] <= xhi: continue
            if logy and not ys[i] > 0: continue
            if not logy and not ylo <= ys[i] <= yhi: continue
            px(axmap(x0, y0, x1, y1, xs[i], xlo, xhi, logx),
               axmapy(x0, y0, x1, y1, ys[i], ylo, yhi, logy), c, r)

    def state_img(x0, y0, data, size):
        for j in range(size):
            for i in range(size):
                v = data[int(i * N / size), int(j * N / size)]
                px(x0 + i, y0 + j, (10, 10, 200) if v > 0 else (235, 235, 245))

    cw, ch = W // 3, (H - 40) // 2
    def panel(r, c):
        x0 = c * cw + 30; y0 = 40 + r * ch + 34
        x1 = (c + 1) * cw - 30; y1 = 40 + (r + 1) * ch - 16
        return x0, y0, x1, y1

    text(20, 8, "2D ISING DOMAIN GROWTH  MODEL A  T=CONTROL=%.4F" % T, BLACK, 2)

    x0, y0, x1, y1 = panel(0, 0); border(x0, y0, x1, y1)
    text(x0 + 4, y0 - 24, "SAMPLE STATES", BLACK, 2)
    sz = 90
    for k, t in enumerate(fig_t):
        state_img(x0 + 8 + k * (sz + 8), y0 + 30, captured[t], sz)
        text(x0 + 8 + k * (sz + 8), y0 + 30 + sz + 4, "T=%d" % t, BLACK, 1)

    x0, y0, x1, y1 = panel(0, 1); border(x0, y0, x1, y1)
    text(x0 + 4, y0 - 24, "SERIES A  L(T)", BLACK, 2)
    plot(x0, y0, x1, y1, mt, seriesA[0], 4, 13000, 8, 300, BLUE, True, True)
    plot(x0, y0, x1, y1, mt, seriesA[1], 4, 13000, 8, 300, RED, True, True, 1)

    x0, y0, x1, y1 = panel(0, 2); border(x0, y0, x1, y1)
    text(x0 + 4, y0 - 24, "SERIES B  |M|, RHO", BLACK, 2)
    plot(x0, y0, x1, y1, mt, seriesB[0], 4, 13000, 0.005, 1.0, GREEN, True, True)
    plot(x0, y0, x1, y1, mt, seriesB[1], 4, 13000, 0.005, 1.0, PURP, True, True, 1)

    x0, y0, x1, y1 = panel(1, 0); border(x0, y0, x1, y1)
    text(x0 + 4, y0 - 24, "C(R) AT SNAPSHOTS", BLACK, 2)
    rr = np.arange(max_r, dtype=float)
    for si in range(n_snap):
        plot(x0, y0, x1, y1, rr, stackC[si], 1, 100, -0.2, 1.05, SNAPC[si], True, False, 1)

    x0, y0, x1, y1 = panel(1, 1); border(x0, y0, x1, y1)
    text(x0 + 4, y0 - 24, "COLLAPSE C(R/L)", BLACK, 2)
    for si in range(n_snap):
        scatter(x0, y0, x1, y1, xs[si], ys[si], xmin, xmax, -0.2, 1.05, SNAPC[si], False, False, 1)
    bb = np.linspace(xmin, xmax, 200)
    mm = np.interp(bb, np.linspace(xmin, xmax, NBINS), master)
    plot(x0, y0, x1, y1, bb, mm, xmin, xmax, -0.2, 1.05, BLACK, False, False, 2)

    x0, y0, x1, y1 = panel(1, 2); border(x0, y0, x1, y1)
    text(x0 + 4, y0 - 24, "L(T) POWER-LAW FIT", BLACK, 2)
    plot(x0, y0, x1, y1, mt, seriesA[0], 4, 13000, 8, 300, BLUE, True, True)
    tf = np.linspace(FIT_TMIN, FIT_TMAX, 100)
    plot(x0, y0, x1, y1, tf, amplitude * tf ** alpha, 4, 13000, 8, 300, RED, True, True, 2)

    _png_write(path, W, H, img)

