#!/usr/bin/env python3
"""
analysis.py — Complete computational science study of the semilinear screened
Poisson equation on a torus point cloud:

        -Δ_M u + α u + β u^3 = h ,   (θ, φ) ∈ [0, 2π)^2

Phase 1 — Discretization design & validation
    Local kNN polynomial (SPD-type) discretization of the Laplace-Beltrami
    operator. All distances/neighbor searches are 2π-periodic (minimum-image
    on the 2-torus, implemented with a KD-tree over the 9 periodic images).
    Metric coefficients are evaluated analytically at the stencil center.
    Validated on f_test = sin(3θ)cos(2φ) with its exact analytic Δ_M f at
    five densities (N, N/2, N/4, N/8, N/16). Polynomial degree p is selected
    from {3,4,6} by empirical convergence order subject to an acceptable
    stencil condition number.
Phase 2 — Nonlinear solver with diagnostics
    Damped Newton with analytic Jacobian J = -L + αI + 3β diag(u^2),
    Armijo backtracking, full residual/step history, convergence-rate
    estimate. Warm start from the linear (β=0) solution.
Phase 3 — Error & robustness analysis
    Point-cloud noise (3 levels, periodic wrap), α/β parameter sensitivity
    (±10%, ±20%), linear-vs-nonlinear comparison.
Phase 4 — Scientific interpretation
    Extrema, dominant length scales, symmetry probes, statistics, nonlinear
    effect distribution, error discussion, improvement directions.

Self-contained; uses only numpy and scipy.
"""

import json
import os
import time

import numpy as np
from scipy.spatial import cKDTree
from scipy.sparse import csr_matrix, diags
from scipy.sparse.linalg import splu

# ----------------------------------------------------------------------
# Constants
# ----------------------------------------------------------------------
TWOPI = 2.0 * np.pi
SEED = 42
K = 35                     # k nearest neighbors; stencil = k+1 points (incl. center)
P_CANDIDATES = (3, 4, 6)   # local polynomial degree candidates (task gives l = 6)
COND_ACCEPT_MED = 1e7      # acceptable median stencil condition number
RESID_REL_TARGET = 1e-10   # Newton stop: ||F||_2 <= 1e-10 * ||h||_2
MAXIT = 100
NOISE_LEVELS = (1e-4, 5e-4, 1e-3)   # as a fraction of the 2π domain size
NONLIN_SIG_FRAC = 0.1      # |u_nl - u_lin| > 0.1*std(u_nl) => significant
N_STENCIL_SAMPLES = 5      # stencils recorded for validation
DENSITIES = (("N", 1), ("N/2", 2), ("N/4", 4), ("N/8", 8), ("N/16", 16))


# ----------------------------------------------------------------------
# Data
# ----------------------------------------------------------------------
def load_data():
    with open("data/parameters.json") as f:
        P = json.load(f)
    pts = np.loadtxt("data/points_2d.csv", delimiter=",")
    h = np.loadtxt("data/h_2d.csv", delimiter=",")
    assert pts.shape == (P["N"], 2) and h.shape == (P["N"],)
    assert np.isfinite(pts).all() and np.isfinite(h).all()
    assert (pts >= 0).all() and (pts < TWOPI).all()
    return P, pts, h


# ----------------------------------------------------------------------
# Periodic geometry
# ----------------------------------------------------------------------
def wrap(d):
    """Minimum-image difference on the 2-torus (period 2π)."""
    return np.mod(d + np.pi, TWOPI) - np.pi


def periodic_tree(pts):
    """KD-tree over the 9 periodic images of the point set.

    Points lie strictly inside [0,2π)^2, so the 9 images with offsets
    {-2π,0,2π}^2 contain every periodic neighbor of every point.
    """
    offs = np.array([[a, b] for a in (-1, 0, 1) for b in (-1, 0, 1)], float) * TWOPI
    return cKDTree(np.concatenate([pts + o for o in offs]))


def knn(pts, k):
    """(N, k) periodic nearest-neighbor indices (self excluded)."""
    N = len(pts)
    tree = periodic_tree(pts)
    d, idx = tree.query(pts, k=k + 1)
    # nearest image must be the zero-offset self image (unique points)
    assert np.all(d[:, 0] < 1e-12), "duplicate points detected"
    return idx[:, 1:] % N


# ----------------------------------------------------------------------
# Local polynomial discretization of the Laplace-Beltrami operator
# ----------------------------------------------------------------------
def monomial_list(p):
    """Total-degree monomials (a,b) with a+b <= p."""
    return [(a, tot - a) for tot in range(p + 1) for a in range(tot + 1)]


def stencil_weights(pts, i, nbrs, p):
    """Weight vectors over the stencil (center + k neighbors) for
    u_theta, u_thetatheta, u_phiphi from an unweighted least-squares fit of
    a polynomial of degree p in locally scaled coordinates
    x = (θ-θ_i)/s, y = (φ-φ_i)/s, s = max stencil radius.

    Derivatives at the center: u_θ = c_(1,0)/s,
    u_θθ = 2 c_(2,0)/s^2, u_φφ = 2 c_(0,2)/s^2 (Taylor coefficients).
    """
    S = np.concatenate(([i], nbrs[i]))
    dth = wrap(pts[S, 0] - pts[i, 0])
    dph = wrap(pts[S, 1] - pts[i, 1])
    rad = np.hypot(dth, dph)
    s = rad.max()
    x, y = dth / s, dph / s
    mono = monomial_list(p)
    V = np.empty((len(S), len(mono)))
    for m, (a, b) in enumerate(mono):
        V[:, m] = x**a * y**b
    VtV = V.T @ V
    idx = {m: n for n, m in enumerate(mono)}
    E = np.eye(len(mono))[:, [idx[(1, 0)], idx[(2, 0)], idx[(0, 2)]]]
    G = np.linalg.solve(VtV, E)          # G[:,k] = (V^T V)^{-1} e_{m_k}
    w10 = (V @ G[:, 0]) / s
    w20 = 2.0 * (V @ G[:, 1]) / s**2
    w02 = 2.0 * (V @ G[:, 2]) / s**2
    return w10, w20, w02, s, VtV


def build_L(pts, p, k, R, r):
    """Assemble the sparse discrete Laplace-Beltrami operator.

    At point i:  Δ_M u ≈ (1/r²) u_θθ - [sinθ_i/(r(R+r cosθ_i))] u_θ
                     + [1/(R+r cosθ_i)²] u_φφ
    with metric coefficients evaluated analytically at the center (the metric
    is smooth and known exactly — no estimation from the cloud is needed).
    Returns (L, nbrs, diam, cond) where diam[i] is the stencil diameter
    (max pairwise periodic distance) and cond[i] = cond(V^T V) of the fit.
    """
    N = len(pts)
    nbrs = knn(pts, k)
    size = N * (k + 1)
    rows = np.empty(size, np.int64)
    cols = np.empty(size, np.int64)
    vals = np.empty(size)
    diam = np.empty(N)
    cond = np.empty(N)
    for i in range(N):
        w10, w20, w02, s, VtV = stencil_weights(pts, i, nbrs, p)
        th = pts[i, 0]
        a = R + r * np.cos(th)
        w = (1.0 / r**2) * w20 - (np.sin(th) / (r * a)) * w10 + (1.0 / a**2) * w02
        sl = slice(i * (k + 1), (i + 1) * (k + 1))
        rows[sl] = i
        cols[sl] = np.concatenate(([i], nbrs[i]))
        vals[sl] = w
        P2 = pts[np.concatenate(([i], nbrs[i]))]
        dt = wrap(P2[:, 0][:, None] - P2[:, 0][None, :])
        dp = wrap(P2[:, 1][:, None] - P2[:, 1][None, :])
        diam[i] = np.hypot(dt, dp).max()
        cond[i] = np.linalg.cond(VtV)
    L = csr_matrix((vals, (rows, cols)), shape=(N, N))
    return L, nbrs, diam, cond


def stencil_row(pts, i, nbrs, p, R, r):
    """Full discrete operator row (k+1 weights) and stencil diameter at i."""
    w10, w20, w02, s, VtV = stencil_weights(pts, i, nbrs, p)
    th = pts[i, 0]
    a = R + r * np.cos(th)
    w = (1.0 / r**2) * w20 - (np.sin(th) / (r * a)) * w10 + (1.0 / a**2) * w02
    P2 = pts[np.concatenate(([i], nbrs[i]))]
    dt = wrap(P2[:, 0][:, None] - P2[:, 0][None, :])
    dp = wrap(P2[:, 1][:, None] - P2[:, 1][None, :])
    return w, np.hypot(dt, dp).max()


# ----------------------------------------------------------------------
# Analytic test problem
# ----------------------------------------------------------------------
def f_test(theta, phi):
    return np.sin(3 * theta) * np.cos(2 * phi)


def dM_f_test(theta, phi, R, r):
    """Exact Δ_M [sin(3θ)cos(2φ)] (derived analytically; verified against
    central finite differences to <1e-6)."""
    s3 = np.sin(3 * theta)
    c3 = np.cos(3 * theta)
    c2 = np.cos(2 * phi)
    a = R + r * np.cos(theta)
    return (-(9.0 / r**2) * s3 * c2
            - (3.0 * np.sin(theta) * c3 * c2) / (r * a)
            - (4.0 * s3 * c2) / a**2)


# ----------------------------------------------------------------------
# Nonlinear solver (damped Newton)
# ----------------------------------------------------------------------
def newton_solve(L, alpha, beta, h, u0, target, maxit=MAXIT):
    """Solve F(u) = -L u + α u + β u^3 - h = 0 by damped Newton with
    analytic Jacobian and Armijo backtracking (sufficient decrease 1e-4)."""
    N = len(h)
    A0 = (-L + diags(np.full(N, alpha))).tocsc()

    def resid(u):
        return -L.dot(u) + alpha * u + beta * u**3 - h

    u = np.array(u0, dtype=float)
    res0 = float(np.linalg.norm(resid(u)))
    Fv = resid(u)
    res = res0
    hist_r, hist_s = [], []
    backtracks = 0
    stall = 0
    for _ in range(1, maxit + 1):
        J = (A0 + diags(3.0 * beta * u * u)).tocsc()
        lu = splu(J)
        du = lu.solve(-Fv)
        t = 1.0
        u_new = u + t * du
        Fn = resid(u_new)
        rn = float(np.linalg.norm(Fn))
        while rn > res * (1.0 - 1e-4 * t) and t > 1e-12:
            t *= 0.5
            backtracks += 1
            u_new = u + t * du
            Fn = resid(u_new)
            rn = float(np.linalg.norm(Fn))
        u = u_new
        # stagnation detection: no >=1% improvement over the last 10 iters
        if len(hist_r) >= 10:
            best_prev = min(hist_r[-10:])
            stall = stall + 1 if rn >= 0.99 * best_prev else 0
        hist_r.append(rn)
        hist_s.append(t * float(np.linalg.norm(du)))
        Fv, res = Fn, rn
        if rn < target:
            break
        if stall >= 10:
            break
    # asymptotic convergence order: ratio of consecutive log-residuals
    order = None
    if len(hist_r) >= 2 and hist_r[-1] < hist_r[-2] and hist_r[-1] > 1e-13:
        order = float(np.log10(hist_r[-1]) / np.log10(hist_r[-2]))
    return u, {
        "iterations": len(hist_r),
        "residual_history": hist_r,
        "step_size_history": hist_s,
        "backtrack_count": backtracks,
        "convergence_order_estimate": order,
        "final_residual": hist_r[-1],
        "initial_residual": res0,
        "converged": res < target,
    }


def linear_solve(L, alpha, h):
    return splu((-L + diags(np.full(len(h), alpha))).tocsc()).solve(h)


# ----------------------------------------------------------------------
# Analysis helpers
# ----------------------------------------------------------------------
def circular_mean(x):
    return float(np.angle(np.exp(1j * x).mean()))


def dominant_wavenumber(profile):
    """Dominant periodic wavenumber (k >= 1) of a 1-D binned profile."""
    F = np.abs(np.fft.rfft(profile - profile.mean()))
    F[0] = 0.0
    return int(np.argmax(F[1:]) + 1), F


def binned_profile(pts, u, col, nbins=64):
    """Mean of u in periodic bins of coordinate `col`; empty bins filled by
    circular interpolation of occupied bins."""
    edges = np.linspace(0.0, TWOPI, nbins + 1)
    centers = (edges[:-1] + edges[1:]) / 2.0
    idx = np.clip(np.digitize(pts[:, col], edges) - 1, 0, nbins - 1)
    prof = np.zeros(nbins)
    cnt = np.zeros(nbins)
    np.add.at(prof, idx, u)
    np.add.at(cnt, idx, 1.0)
    empty = cnt == 0
    if empty.any():
        occ = ~empty
        prof[empty] = np.interp(centers[empty], centers[occ],
                                prof[occ] / cnt[occ], period=TWOPI)
    return prof / np.maximum(cnt, 1.0)


# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------
def main():
    t_start = time.time()
    P, pts, h = load_data()
    R, r, alpha0, beta0, lpar, N = (P["R"], P["r"], P["alpha"], P["beta"],
                                    P["l"], P["N"])
    os.makedirs("results/discretization", exist_ok=True)
    os.makedirs("results/solver", exist_ok=True)
    os.makedirs("results/robustness", exist_ok=True)
    os.makedirs("results/analysis", exist_ok=True)

    # ==================================================================
    # Phase 1 — discretization study & validation
    # ==================================================================
    print("[Phase 1] convergence study over polynomial degrees ...")
    study = {}
    for p in P_CANDIDATES:
        dens = []
        cond_full = None
        for lab, s in DENSITIES:
            ps = pts[::s]
            Ls, _, _, cond_s = build_L(ps, p, K, R, r)
            if s == 1:
                cond_full = cond_s
            err = Ls.dot(f_test(ps[:, 0], ps[:, 1])) \
                - dM_f_test(ps[:, 0], ps[:, 1], R, r)
            dens.append({
                "density": lab, "n_points": int(len(ps)),
                "max_error": float(np.abs(err).max()),
                "rms_error": float(np.sqrt(np.mean(err**2))),
            })
        hs = np.array([TWOPI / np.sqrt(d["n_points"]) for d in dens])
        rms = np.array([d["rms_error"] for d in dens])
        mx = np.array([d["max_error"] for d in dens])
        study[p] = {
            "density_results": dens,
            "order_rms": float(np.polyfit(np.log(hs), np.log(rms), 1)[0]),
            "order_max": float(np.polyfit(np.log(hs), np.log(mx), 1)[0]),
            "cond_median_full": float(np.median(cond_full)),
            "cond_max_full": float(cond_full.max()),
        }
        print(f"  p={p}: order_rms={study[p]['order_rms']:.3f} "
              f"order_max={study[p]['order_max']:.3f} "
              f"cond_med={study[p]['cond_median_full']:.2e} "
              f"cond_max={study[p]['cond_max_full']:.2e}")

    # select p: highest empirical order among candidates whose median
    # stencil condition number is acceptable
    acceptable = [p for p in P_CANDIDATES
                  if study[p]["cond_median_full"] <= COND_ACCEPT_MED]
    p_sel = max(acceptable, key=lambda p: (study[p]["order_rms"],
                                           -study[p]["cond_median_full"]))
    print(f"  selected polynomial degree p = {p_sel} "
          f"(order {study[p_sel]['order_rms']:.3f})")

    # final operator at full density
    L, nbrs, diam, cond = build_L(pts, p_sel, K, R, r)

    # sanity checks on the final operator
    err_full = L.dot(f_test(pts[:, 0], pts[:, 1])) \
        - dM_f_test(pts[:, 0], pts[:, 1], R, r)
    ones_err = float(np.abs(L.dot(np.ones(N))).max())
    print(f"  full-N test-function error: max={np.abs(err_full).max():.3e} "
          f"rms={np.sqrt(np.mean(err_full**2)):.3e}; max|L@1|={ones_err:.3e}")

    # --- convergence_test.json (selected method) ---
    conv_json = {
        "test_function": "sin(3*theta)*cos(2*phi)",
        "polynomial_degree": int(p_sel),
        "estimated_convergence_order": study[p_sel]["order_rms"],
        "density_results": study[p_sel]["density_results"],
    }
    with open("results/discretization/convergence_test.json", "w") as f:
        json.dump(conv_json, f, indent=2)

    # --- stencil validation (5 random points) ---
    rng_st = np.random.default_rng(SEED)
    sample_idx = np.sort(rng_st.choice(N, N_STENCIL_SAMPLES, replace=False))
    stencil_json = []
    for i in sample_idx:
        w, dmax = stencil_row(pts, int(i), nbrs, p_sel, R, r)
        stencil_json.append({
            "point_index": int(i),
            "theta": float(pts[i, 0]),
            "phi": float(pts[i, 1]),
            "stencil_weights": [float(v) for v in w],
            "weight_sum": float(w.sum()),
            "stencil_diameter": float(dmax),
        })
    with open("results/discretization/stencil_validation.json", "w") as f:
        json.dump(stencil_json, f, indent=2)

    # ==================================================================
    # Phase 2 — nonlinear solve with diagnostics
    # ==================================================================
    print("[Phase 2] linear warm start + damped Newton ...")
    target = RESID_REL_TARGET * float(np.linalg.norm(h, 2))
    u_lin = linear_solve(L, alpha0, h)
    u, diag = newton_solve(L, alpha0, beta0, h, u_lin, target)
    print(f"  iterations={diag['iterations']} backtracks={diag['backtrack_count']} "
          f"final_residual={diag['final_residual']:.3e} "
          f"order_est={diag['convergence_order_estimate']}")

    with open("results/solver/solver_diagnostics.json", "w") as f:
        json.dump(diag, f, indent=2)

    iters = np.arange(1, len(diag["residual_history"]) + 1)
    plot = np.column_stack([
        iters,
        np.log10(np.array(diag["residual_history"])),
        np.log10(np.maximum(np.array(diag["step_size_history"]), 1e-300)),
    ])
    np.savetxt("results/solver/convergence_plot_data.csv", plot,
               delimiter=",",
               header="iteration,log10_residual_norm,log10_step_norm",
               comments="")

    with open("results/u_pred.csv", "w") as f:
        f.write("\n".join(f"{v:.17e}" for v in u) + "\n")

    # ==================================================================
    # Phase 3 — robustness
    # ==================================================================
    print("[Phase 3] robustness ...")
    # --- point-cloud noise ---
    # Levels are calibrated to the mesh scale h ~ 2π/sqrt(N) ≈ 0.06 rad:
    # 1e-4/5e-4/1e-3 of 2π correspond to σ/h ≈ 1% / 5% / 10%, bracketing
    # the graceful-degradation / breakdown transition of the method.
    h_est = TWOPI / np.sqrt(N)
    rng = np.random.default_rng(SEED)
    noise_results = []
    noise_extra = []   # (iters, rms change, correlation, frac |Δ|>0.5)
    p6lin_extra = []   # linear p=6 comparison: Δ∞ at same levels
    p3lin_extra = []   # linear p=3 comparison: Δ∞ at same levels
    L3_base, _, _, _ = build_L(pts, 3, K, R, r)
    u_lin3 = linear_solve(L3_base, alpha0, h)
    for sigma_rel in NOISE_LEVELS:
        sigma = sigma_rel * TWOPI
        pts_n = (pts + rng.normal(0.0, sigma, size=pts.shape)) % TWOPI
        L_n, _, _, _ = build_L(pts_n, p_sel, K, R, r)
        u_n, d_n = newton_solve(L_n, alpha0, beta0, h, u, target, maxit=60)
        d = u_n - u
        chg = float(np.abs(d).max())
        noise_results.append({
            "noise_sigma": float(sigma),
            "solution_change_linf": chg,
            "relative_change": chg / float(np.abs(u).max()),
            "converged": bool(d_n["converged"]),
            "final_residual": float(d_n["final_residual"]),
        })
        noise_extra.append((
            d_n["iterations"],
            float(np.sqrt(np.mean(d**2))),
            float(np.corrcoef(u, u_n)[0, 1]),
            float((np.abs(d) > 0.5).mean()),
        ))
        # linear comparisons at the same perturbation (p=6 and p=3)
        u_lin6_n = linear_solve(L_n, alpha0, h)
        p6lin_extra.append(float(np.abs(u_lin6_n - u_lin).max()))
        L3_n, _, _, _ = build_L(pts_n, 3, K, R, r)
        u_lin3_n = linear_solve(L3_n, alpha0, h)
        p3lin_extra.append(float(np.abs(u_lin3_n - u_lin3).max()))
        print(f"  noise sigma={sigma:.5f} (σ/h={sigma/h_est:.3f}): "
              f"iters={d_n['iterations']} conv={d_n['converged']} "
              f"Δ∞={chg:.4e} rel={noise_results[-1]['relative_change']:.4e} "
              f"corr={noise_extra[-1][2]:.4f} "
              f"[lin p=6 Δ∞={p6lin_extra[-1]:.3e} "
              f"lin p=3 Δ∞={p3lin_extra[-1]:.3e}]")
    with open("results/robustness/point_cloud_sensitivity.json", "w") as f:
        json.dump({"noise_results": noise_results}, f, indent=2)

    # --- parameter sensitivity ---
    pert_labels = {
        "alpha_p10": (1.10 * alpha0, beta0), "alpha_m10": (0.90 * alpha0, beta0),
        "alpha_p20": (1.20 * alpha0, beta0), "alpha_m20": (0.80 * alpha0, beta0),
        "beta_p10": (alpha0, 1.10 * beta0), "beta_m10": (alpha0, 0.90 * beta0),
        "beta_p20": (alpha0, 1.20 * beta0), "beta_m20": (alpha0, 0.80 * beta0),
    }
    pert_results = {}
    for lab, (ap, bp) in pert_labels.items():
        u_p, _ = newton_solve(L, ap, bp, h, u, target)
        chg = float(np.abs(u_p - u).max())
        pert_results[lab] = {
            "alpha": float(ap), "beta": float(bp),
            "solution_change_linf": chg,
            "relative_change": chg / float(np.abs(u).max()),
        }
        print(f"  {lab}: Δ∞={chg:.4e} rel={pert_results[lab]['relative_change']:.4e}")
    with open("results/robustness/parameter_sensitivity.json", "w") as f:
        json.dump({"perturbation_results": pert_results}, f, indent=2)

    # --- linear vs nonlinear ---
    d_nl = u - u_lin
    np.savetxt("results/robustness/linear_vs_nonlinear.csv",
               np.column_stack([u_lin, u]), delimiter=",", fmt="%.17e")
    sig_mask = np.abs(d_nl) > NONLIN_SIG_FRAC * u.std()
    nlin_frac = float(sig_mask.mean())
    print(f"  nonlinear effect: mean|Δ|={np.abs(d_nl).mean():.4f} "
          f"max|Δ|={np.abs(d_nl).max():.4f} "
          f"fraction(|Δ|>0.1*std(u))={nlin_frac:.4f}")

    # ==================================================================
    # Phase 4 — scientific analysis
    # ==================================================================
    print("[Phase 4] analysis ...")
    i_max = int(np.argmax(u))
    i_min = int(np.argmin(u))
    # dominant length scales (binned spectral analysis of the solution —
    # analysis only, not used for discretization)
    prof_th = binned_profile(pts, u, 0)
    prof_ph = binned_profile(pts, u, 1)
    k_th, _ = dominant_wavenumber(prof_th)
    k_ph, _ = dominant_wavenumber(prof_ph)
    # symmetry probes: correlation of u with u composed with a torus map
    tree = periodic_tree(pts)
    sym_maps = {
        "central_inversion (θ,φ)->(2π-θ,2π-φ)":
            (2 * np.pi - pts[:, 0], 2 * np.pi - pts[:, 1]),
        "phi_translation (θ,φ)->(θ,φ+π)": (pts[:, 0], pts[:, 1] + np.pi),
        "theta_translation (θ,φ)->(θ+π,φ)": (pts[:, 0] + np.pi, pts[:, 1]),
        "theta_reflection (θ,φ)->(2π-θ,φ)": (2 * np.pi - pts[:, 0], pts[:, 1]),
        "phi_reflection (θ,φ)->(θ,2π-φ)": (pts[:, 0], 2 * np.pi - pts[:, 1]),
    }
    sym_results = {}
