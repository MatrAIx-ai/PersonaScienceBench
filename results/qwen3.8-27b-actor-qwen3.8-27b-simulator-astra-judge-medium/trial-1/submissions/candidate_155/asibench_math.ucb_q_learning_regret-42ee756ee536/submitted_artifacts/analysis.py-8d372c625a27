"""Optimistic 2-step Bernstein Q-learning for finite-horizon MDPs.

Model-free, tabular, online agent.

Design
------
* Horizon-indexed Q values Q[h][s][a], h = 1..H, clipped to [0, H-h+1]
  (rewards are declared in [0,1] for every case).
* Update rule (one update per visit, applied at episode end): the
  2-step return
      target = G2 = r + r_next + V[s''],
  where V[s] = max_a Q[h+1][s] and the bootstrap is horizon-truncated
  (V = 0 past the end of the horizon).  The 2-step leg injects the
  directly observed next-step reward into the target, which removes the
  one-step bootstrap lag that makes plain UCB-B's sampled next-value
  targets drift while downstream Q estimates are still being learned
  (the main finite-sample burn-in cost when rewards are delayed).
* Optimism: Bernstein (variance-sensitive) radius
      b(h,s,a) = C*(H-h+1)*sqrt(2*vhat*L/(n+1)) + L/(n+1)^2,
  with vhat the running variance of the normalized target (target /
  (H-h+1)) and L = ln(K*H*S*A); unvisited cells get b = H-h+1 (full
  optimistic initialization), so every reachable (h,s,a) is tried early.
  Action selection is argmax_a (Q[h][s][a] + b(h,s,a)); the targets
  themselves use the pure V (no bonus inside the target), so Q remains
  an estimate and optimism lives only in selection.
* Learning rate: alpha_n = 1/(n+1) (running mean, consistent with the
  Bernstein radius).
* Storage: Q, visit counts n, second-moment accumulators (3*H*S*A) and
  a deterministic tie-break table (H*S*A), plus ONE bounded episode
  trace (H tuples) used to form the 2-step returns. Total O(H*S*A).

The agent reads only S, A, H, K, initial_state from env_spec.  It NEVER
reads P or R.  No branching on case_id or dimensions: one shared set of
constants is used for every case.
"""

import math

# ---- shared hyperparameters: ONE set, independent of case_id and dimensions
_C_BONUS = 0.4     # Bernstein variance-term multiplier
_L_MODE = "bare"   # L = ln(K*H*S*A)
_LR_MODE = "mean"  # alpha_n = 1/(n+1)
_TIE_EPS = 1e-9    # deterministic tie-break magnitude (negligible)
_K_DEFAULT = 1000  # fallback if K is absent from env_spec


class _Agent:
    __slots__ = ("S", "A", "H", "L", "Q", "n", "m2", "T", "scale", "trace")

    def __init__(self, S, A, H, K, seed):
        self.S = S
        self.A = A
        self.H = H
        self.L = math.log(max(1.0, K * H * S * A))
        # 0-indexed h0 = 0..H-1 corresponds to 1-indexed h = 1..H
        self.Q = [[[0.0] * A for _ in range(S)] for _ in range(H)]
        self.n = [[[0] * A for _ in range(S)] for _ in range(H)]
        self.m2 = [[[0.0] * A for _ in range(S)] for _ in range(H)]
        # deterministic per-cell tie-break offsets in [0, _TIE_EPS)
        import random
        rng = random.Random(seed)
        self.T = [[[rng.random() * _TIE_EPS for _ in range(A)] for _ in range(S)]
                  for _ in range(H)]
        # value scale at each 0-indexed step: H - h0
        self.scale = [H - h0 for h0 in range(H)]
        # ONE bounded episode trace: list of (h0, s, a, r, s_next)
        self.trace = []

    # ------------------------------------------------------------------ utils
    def _update(self, h0, s, a, target):
        n = self.n[h0][s][a] + 1
        self.n[h0][s][a] = n
        sc = self.scale[h0]
        if _LR_MODE == "mean":
            alpha = 1.0 / n
        else:
            alpha = min(1.0, n ** (-2.0 / 3.0))
        q = self.Q[h0][s][a] + alpha * (target - self.Q[h0][s][a])
        if q < 0.0:
            q = 0.0
        elif q > sc:
            q = sc
        self.Q[h0][s][a] = q
        self.m2[h0][s][a] += (target / sc) ** 2

    def _bonus(self, h0, s, a):
        sc = self.scale[h0]
        n = self.n[h0][s][a]
        q = self.Q[h0][s][a]
        if n == 0:
            b = sc
        else:
            mu = q / sc
            v = self.m2[h0][s][a] / n - mu * mu
            if v < 0.0:
                v = 0.0
            elif v > 1.0:
                v = 1.0
            b = (_C_BONUS * sc * math.sqrt(2.0 * v * self.L / (n + 1))
                 + self.L / ((n + 1) ** 2))
        rem = sc - q
        if b > rem:
            b = rem
        return b

    # ----------------------------------------------------------------- API
    def act(self, h: int, state: int) -> int:
        h0 = h - 1
        qrow = self.Q[h0][state]
        trow = self.T[h0][state]
        best_a = 0
        best_v = -1.0
        for a in range(self.A):
            val = qrow[a] + self._bonus(h0, state, a) + trow[a]
            if val > best_v:
                best_v = val
                best_a = a
        return best_a

    def observe(self, h: int, state: int, action: int, reward: float,
                next_state: int, done: bool) -> None:
        h0 = h - 1
        self.trace.append((h0, state, action, reward, next_state))
        if not done:
            return
        # Episode end: update every visited step with its 2-step return.
        H = self.H
        for i in range(len(self.trace) - 1, -1, -1):
            h0, s, a, r, s_next = self.trace[i]
            if i < len(self.trace) - 1:
                h1, s1, a1, r1, s1_next = self.trace[i + 1]
                # G2 = r + r_next + V[h+2][s''], horizon-truncated
                if h1 < H - 1:
                    g2 = r + r1 + max(self.Q[h1][s1_next])
                else:
                    g2 = r + r1
            else:
                g2 = r  # terminal step: no continuation
            self._update(h0, s, a, g2)
        self.trace = []

    # optional runner hooks (safety only)
    def reset_episode(self, episode, state):
        self.trace = []

    def end_episode(self, episode, reward):
        self.trace = []


def make_agent(env_spec, seed):
    S = int(env_spec["S"])
    A = int(env_spec["A"])
    H = int(env_spec["H"])
    K = int(env_spec.get("K", _K_DEFAULT))
    return _Agent(S, A, H, K, int(seed))
