#!/usr/bin/env python3
"""D2Q9 LBM (BGK) - optimized pure numpy."""
import json, os, time
import numpy as np
import pandas as pd

EX=np.array([0,1,0,-1,0,1,-1,-1,1],dtype=np.float64)
EY=np.array([0,0,1,0,-1,1,1,-1,-1],dtype=np.float64)
W=np.array([4/9,1/9,1/9,1/9,1/9,1/36,1/36,1/36,1/36],dtype=np.float64)
OPP=np.array([0,3,4,1,2,7,8,5,6],dtype=np.int64)
EXN=EX[None,None,:]; EYN=EY[None,None,:]; WN=W[None,None,:]; W3N=(3*W)[None,None,:]; W45N=(4.5*W)[None,None,:]

def inlet_feq(uin):
    eu=EX*uin; u2=uin*uin
    return W*(1.0+3.0*eu+4.5*eu*eu-1.5*u2)

def run_case(case):
    nx=case['nx'];ny=case['ny'];uin=case['uin'];re=case['re']
    cx,cy=case['square_center'];sq=case['square_size']
    n_steps=case['n_steps'];warmup=case['warmup_steps'];se=case['sample_every']
    nu=uin*sq/re;tau=0.5+3.0*nu;om=1.0/tau
    half=sq//2
    x0=max(0,cx-half);x1=min(nx,cx-half+sq)
    y0=max(0,cy-half);y1=min(ny,cy-half+sq)
    solid=np.zeros((nx,ny),dtype=bool);solid[x0:x1,y0:y1]=True
    feq_in=inlet_feq(uin)
    f=np.empty((nx,ny,9),dtype=np.float64)
    u2i=uin*uin
    f[:,:,0]=(4/9)*(1-1.5*u2i)
    f[:,:,1]=(1/9)*(1+3*uin+4.5*uin*uin-1.5*u2i)
    f[:,:,2]=(1/9)*(1-1.5*u2i)
    f[:,:,3]=(1/9)*(1-3*uin+4.5*uin*uin-1.5*u2i)
    f[:,:,4]=(1/9)*(1-1.5*u2i)
    f[:,:,5]=(1/36)*(1+3*uin+4.5*uin*uin-1.5*u2i)
    f[:,:,6]=(1/36)*(1-3*uin+4.5*uin*uin-1.5*u2i)
    f[:,:,7]=(1/36)*(1-3*uin+4.5*uin*uin-1.5*u2i)
    f[:,:,8]=(1/36)*(1+3*uin+4.5*uin*uin-1.5*u2i)
    fp=np.empty_like(f);fn=np.empty_like(f)
    feq=np.empty_like(f);ba=np.empty_like(f);bb=np.empty_like(f)
    rho=np.empty((nx,ny));ux=np.empty((nx,ny));uy=np.empty((nx,ny))
    u2b=np.empty((nx,ny))
    force_recs=[];t0=time.time()
    one_om=1.0-om
    for step in range(n_steps):
        # Macroscopic via einsum
        np.einsum('xyi->xy',f,out=rho)
        np.einsum('i,xyi->xy',EX,f,out=ux);ux/=rho
        np.einsum('i,xyi->xy',EY,f,out=uy);uy/=rho
        # Equilibrium (in-place vectorized)
        np.multiply(ux[:,:,None],EXN,out=ba)
        np.multiply(uy[:,:,None],EYN,out=bb)
        np.add(ba,bb,out=ba)           # ba=eu
        np.multiply(ba,ba,out=feq)     # feq=eu^2
        feq*=W45N                       # feq=W45*eu^2
        np.multiply(ba,W3N,out=bb)     # bb=W3*eu
        feq+=bb                         # feq=W45*eu^2+W3*eu
        u2b[:]=1.0-1.5*(ux*ux+uy*uy)
        np.multiply(u2b[:,:,None],WN,out=bb)
        feq+=bb                         # +W1*(1-1.5*u2)
        feq*=rho[:,:,None]              # *rho
        # BGK: fp=(1-om)*f+om*feq
        np.multiply(f,one_om,out=fp)
        np.multiply(feq,om,out=feq)
        fp+=feq
        fp[solid]=f[solid]
        # Force (momentum exchange)
        fs=fp[solid]
        Fx=2.0*np.sum((fs[:,1]-fs[:,3])+(fs[:,5]-fs[:,7])+(fs[:,8]-fs[:,6]))
        Fy=2.0*np.sum((fs[:,2]-fs[:,4])+(fs[:,5]-fs[:,7])+(fs[:,6]-fs[:,8]))
        if step>=warmup and (step-warmup)%se==0:
            force_recs.append((step,Fx/(0.5*uin*uin*sq),Fy/(0.5*uin*uin*sq)))
        # Bounce-back
        sf=fs.copy();fp[solid]=sf[:,OPP]
        # Streaming
        fn[:,:,0]=fp[:,:,0]
        fn[1:,:,1]=fp[:-1,:,3]
        fn[:,1:,2]=fp[:,:-1,4]
        fn[:,0,2]=fp[:,-1,4]
        fn[:-1,:,3]=fp[1:,:,1]
        fn[:,:-1,4]=fp[:,1:,2]
        fn[:,-1,4]=fp[:,0,2]
        fn[1:,1:,5]=fp[:-1,:-1,7]
        fn[1:,0,5]=fp[:-1,-1,7]
        fn[:-1,1:,6]=fp[1:,:-1,8]
        fn[:-1,0,6]=fp[1:,-1,8]
        fn[:-1,:-1,7]=fp[1:,1:,5]
        fn[:-1,-1,7]=fp[1:,0,5]
        fn[1:,:-1,8]=fp[:-1,1:,6]
        fn[1:,-1,8]=fp[:-1,0,6]
        # BCs
        fn[0,:,1]=feq_in[1];fn[0,:,5]=feq_in[5];fn[0,:,8]=feq_in[8]
        fn[-1,:,3]=fn[-2,:,3];fn[-1,:,6]=fn[-2,:,6];fn[-1,:,7]=fn[-2,:,7]
        f,fn=fn,f
    elapsed=time.time()-t0
    # Final velocity
    np.einsum('xyi->xy',f,out=rho)
    np.einsum('i,xyi->xy',EX,f,out=ux);ux/=rho
    np.einsum('i,xyi->xy',EY,f,out=uy);uy/=rho
    cl_u=ux[:,cy]
    xp=min(nx-1,cx+2*sq)
    tu=ux[xp,:];tv=uy[xp,:]
    cd_arr=np.array([r[1] for r in force_recs])
    cl_arr=np.array([r[2] for r in force_recs])
    st_arr=np.array([r[0] for r in force_recs])
    cd_mean=np.mean(cd_arr);cl_rms=np.sqrt(np.mean(cl_arr*cl_arr))
    allf=np.all(np.isfinite(cd_arr)) and np.all(np.isfinite(cl_arr))
    nh=len(cd_arr)//2
    drift=abs(np.mean(cd_arr[nh:])-cd_mean)/max(abs(cd_mean),1e-12)
    conv=allf and (drift<0.50)
    return dict(case_id=case['case_id'],nx=nx,ny=ny,re=re,uin=uin,nu=nu,tau=tau,
                n_steps=n_steps,cd_mean=cd_mean,cl_rms=cl_rms,converged=conv,
                steps=st_arr,cds=cd_arr,cls=cl_arr,cl_u=cl_u,xp=xp,tu=tu,tv=tv,
                elapsed=elapsed,ns=len(force_recs))

def main():
    with open('./data/task_input.json','r',encoding='utf-8-sig') as fh:
        data=json.load(fh)
    cases=data['cases']
    task_id=data.get('task_id','fluid-square-wake-2d-001')
    units=data.get('units','dimensionless')
    os.makedirs('./results',exist_ok=True)
    all_res=[]
    for case in cases:
        print(f"Running {case['case_id']} ...",flush=True)
        r=run_case(case)
        print(f"  {r['elapsed']:.1f}s cd={r['cd_mean']:.6f} cl_rms={r['cl_rms']:.6f} conv={r['converged']} n={r['ns']}",flush=True)
        all_res.append(r)
    rows=[{'case_id':r['case_id'],'nx':r['nx'],'ny':r['ny'],'re':r['re'],'uin':r['uin'],
           'nu':r['nu'],'tau':r['tau'],'n_steps':r['n_steps'],
           'cd_mean':r['cd_mean'],'cl_rms':r['cl_rms'],'converged':r['converged']} for r in all_res]
    pd.DataFrame(rows,columns=['case_id','nx','ny','re','uin','nu','tau','n_steps','cd_mean','cl_rms','converged']).to_csv('./results/fluid_summary.csv',index=False)
    rows=[]
    for r in all_res:
        for i in range(len(r['cds'])):
            rows.append({'case_id':r['case_id'],'step':int(r['steps'][i]),'cd':r['cds'][i],'cl':r['cls'][i]})
    pd.DataFrame(rows,columns=['case_id','step','cd','cl']).to_csv('./results/fluid_force_series.csv',index=False)
    rows=[]
    for r in all_res:
        for x in range(r['nx']):
            rows.append({'case_id':r['case_id'],'x':x,'u':r['cl_u'][x]})
    pd.DataFrame(rows,columns=['case_id','x','u']).to_csv('./results/fluid_centerline.csv',index=False)
    rows=[]
    for r in all_res:
        for y in range(r['ny']):
            rows.append({'case_id':r['case_id'],'x_probe':r['xp'],'y':y,'u':r['tu'][y],'v':r['tv'][y]})
    pd.DataFrame(rows,columns=['case_id','x_probe','y','u','v']).to_csv('./results/fluid_transverse_profile.csv',index=False)
    cd_avg=float(np.mean([r['cd_mean'] for r in all_res]))
    ms=("D2Q9 LBM, BGK collision tau=0.5+3*nu. Solid 9x9 no-slip bounce-back. "
        "Inlet: prescribed eq (u=uin,rho=1). Outlet: zero-gradient. Top/Bottom: periodic. "
        "Force: momentum exchange sum_i e_i*(f_i-f_opp(i)) at solid nodes, post-collision pre-bounce-back. "
        "Sampling: (step-warmup_steps)%sample_every==0, first warmup_steps excluded. "
        "Centerline/transverse profiles: final step (step=n_steps-1). "
        "Converged: all values finite AND |mean_cd_second_half - mean_cd_full|/|mean_cd_full| < 0.50. "
        "No hidden pre/post settling. Pure numpy (numba unavailable).")
    with open('./results/fluid_report.json','w') as fh:
        json.dump({'task_id':task_id,'units':units,'cd_mean_avg':cd_avg,'method_summary':ms},fh,indent=2)
    print("\n=== SELF-CHECK ===")
    input_ids=set(c['case_id'] for c in cases)
    for fp in ['./results/fluid_summary.csv','./results/fluid_force_series.csv',
               './results/fluid_centerline.csv','./results/fluid_transverse_profile.csv',
               './results/fluid_report.json']:
        print(f"  {fp}: {'OK' if os.path.isfile(fp) else 'MISSING!'}")
    df_s=pd.read_csv('./results/fluid_summary.csv')
    for cid in input_ids:
        n=len(df_s[df_s['case_id']==cid])
        print(f"  summary {cid}: {n} {'OK' if n==1 else 'ERR'}")
    df_f=pd.read_csv('./results/fluid_force_series.csv')
    for cid in input_ids:
        n=len(df_f[df_f['case_id']==cid])
        print(f"  force {cid}: {n} {'OK' if n>=10 else 'ERR'}")
    df_c=pd.read_csv('./results/fluid_centerline.csv')
    for case in cases:
        n=len(df_c[df_c['case_id']==case['case_id']])
        print(f"  centerline {case['case_id']}: {n}/{case['nx']} {'OK' if n==case['nx'] else 'ERR'}")
    df_t=pd.read_csv('./results/fluid_transverse_profile.csv')
    for case in cases:
        n=len(df_t[df_t['case_id']==case['case_id']])
        print(f"  transverse {case['case_id']}: {n}/{case['ny']} {'OK' if n==case['ny'] else 'ERR'}")
    for nm,df in [('summary',df_s),('force',df_f),('centerline',df_c),('transverse',df_t)]:
        print(f"  ids {nm}: {'MATCH' if set(df['case_id'].unique())==input_ids else 'MISMATCH'}")
    for nm,df in [('summary',df_s),('force',df_f),('centerline',df_c),('transverse',df_t)]:
        nc=df.select_dtypes(include=[np.number]).columns
        ok=all(np.all(np.isfinite(df[c].values)) for c in nc)
        print(f"  finite {nm}: {'OK' if ok else 'NaN/Inf!'}")
    print(f"\nTotal sim time: {sum(r['elapsed'] for r in all_res):.1f}s")

if __name__=='__main__':
    main()
