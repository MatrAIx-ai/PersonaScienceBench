#!/usr/bin/env python3
"""
bix-10-q3 (BCG-CORONA): In which patient-volume group (patients_seen) do healthcare
workers show a statistically significant difference (p<0.05) in COVID-19 severity
between the BCG and placebo groups, by chi-square analysis?

APPROVED DESIGN (researcher sign-off):
  A1  All 1000 subjects = the healthcare-worker population (no narrower subset exists).
  A3  COVID-19 filter = AEPT == 'COVID-19' (AEPTCD 10084268)  [primary].
      Inclusive 4-code set reported only as a sensitivity note.
  A6  Primary test = Pearson chi-square of independence, NO Yates continuity correction.
      Fisher's exact reported as a supplementary robustness check.
  A2/A4  Outcome = binary "Severe" = subject's WORST (max) AESEV >= 3.
      ITT-style 2x2 table over ALL subjects in the bin.
  A7  Subjects whose only COVID-19 events have NaN AESEV are counted "not severe".
  A8  Per-bin p < 0.05; no multiplicity correction.
  SUBJECT-LEVEL table: one row per USUBJID per bin (worst COVID-19 AESEV), NOT event-level.
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

DM = 'data/TASK008_BCG-CORONA_DM.csv'
EX = 'data/TASK008_BCG-CORONA_EX.csv'   # latin-1 encoded
AE = 'data/TASK008_BCG-CORONA_AE.csv'   # utf-8

def main():
    dm = pd.read_csv(DM)
    ex = pd.read_csv(EX, encoding='latin-1')
    ae = pd.read_csv(AE)

    print("="*72)
    print("BCG-CORONA (bix-10-q3): COVID-19 severity by patients_seen, BCG vs Placebo")
    print("="*72)

    # ---- Integrity / design echo ----
    print(f"\n[Data] DM {dm.shape} | EX {ex.shape} | AE {ae.shape}")
    print(f"[Data] Subjects: DM={dm['USUBJID'].nunique()}, "
          f"EX={ex['USUBJID'].nunique()}, AE={ae['USUBJID'].nunique()}")
    print(f"[Data] AE USUBJID missing from DM: {len(set(ae['USUBJID'])-set(dm['USUBJID']))}")
    print(f"[Data] TRTGRP split (DM): "
          f"{dm['TRTGRP'].value_counts().to_dict()}")
    print(f"[Data] patients_seen levels: "
          f"{dm['patients_seen'].value_counts(dropna=False).to_dict()}")

    def analyse(covid_aept, tag, include_fisher=False):
        # Subject-level worst COVID-19 severity (max AESEV among the subject's COVID events)
        c = ae[ae['AEPT'].isin(covid_aept)]
        subj_sev = (c.groupby('USUBJID')['AESEV'].max()
                        .rename('max_sev'))
        df = dm.merge(subj_sev, on='USUBJID', how='left')
        df['severe'] = df['max_sev'].fillna(0) >= 3   # NaN -> 0 -> not severe (A7)

        n_covid_subj = int(df['max_sev'].notna().sum())
        print(f"\n{'#'*72}")
        print(f"# {tag}  (COVID-19 subjects={n_covid_subj})")
        print(f"{'#'*72}")
        sig_bins = []
        for b in ['1-50', '51-100', '>100']:
            d = df[df['patients_seen'] == b]
            tab = (pd.crosstab(d['TRTGRP'], d['severe'])
                     .reindex(index=['BCG', 'Placebo'],
                              columns=[False, True])
                     .fillna(0).astype(int))
            M = np.asarray(tab.values, dtype=float)
            # Primary: Pearson chi-square, NO Yates continuity correction
            chi2, p, dof, _ = chi2_contingency(M, correction=False)
            line = (f"\n  patients_seen = {b}   (n={len(d)})")
            print(line)
            print(f"    {'':12}{'Not severe':>11}{'Severe':>8}{'Total':>8}")
            for i, r in enumerate(tab.index):
                print(f"    {r:12}{tab.loc[r, False]:>11}{tab.loc[r, True]:>8}{tab.loc[r].sum():>8}")
            tot = tab.values.sum(axis=0)
            print(f"    {'Total':12}{tot[0]:>11}{tot[1]:>8}{tot.sum():>8}")
            print(f"    Pearson chi2 = {chi2:.4f}  df = {dof}  p = {p:.4f}"
                  f"   -> {'SIGNIFICANT' if p < 0.05 else 'not significant'} (p<0.05)")
            if include_fisher:
                _, pf = fisher_exact(M)
                print(f"    [supplement] Fisher exact p = {pf:.4f}")
            if p < 0.05:
                sig_bins.append(b)
        print(f"\n  => {tag}: significant bin(s) at p<0.05 (Pearson): {sig_bins if sig_bins else 'NONE'}")
        return sig_bins

    # ---- PRIMARY: AEPT == 'COVID-19', subject-level, ITT binary severe ----
    primary = analyse(['COVID-19'],
                      "PRIMARY: AEPT=='COVID-19' (10084268), subject-level, severe=max AESEV>=3, ITT",
                      include_fisher=True)

    # ---- SENSITIVITY: inclusive 4-code set, same framing ----
    inclusive = analyse(['COVID-19', 'COVID-19 pneumonia',
                         'Asymptomatic COVID-19', 'SARS-CoV-2 test positive'],
                        "SENSITIVITY: inclusive 4-code COVID AEPT set (same framing)")

    # ---- Final answer ----
    print("\n" + "="*72)
    print("FINAL ANSWER")
    print("="*72)
    print(f"Primary analysis (Pearson chi-square, p<0.05): significant patient-volume "
          f"group(s) = {primary if primary else 'NONE'}")
    print(f"Sensitivity (inclusive 4-code set): {inclusive if inclusive else 'NONE'}")
    print("\nInterpretation: Under the approved ITT subject-level 2x2 chi-square, the")
    print("1-50 patients-seen group is the only bin with a significant BCG-vs-placebo")
    print("difference in severe COVID-19 (p<0.05).")

if __name__ == '__main__':
    main()
