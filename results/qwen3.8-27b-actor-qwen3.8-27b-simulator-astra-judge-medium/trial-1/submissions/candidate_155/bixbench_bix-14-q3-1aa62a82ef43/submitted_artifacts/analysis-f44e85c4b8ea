#!/usr/bin/env python3
"""
Final analysis: non-reference exonic variant calls in CHIP genes across 86 samples.

Method (approved by researcher):
 1. CHIP gene list = 56 gene symbols from 230214_Schenz_et_al_2022_CHIP_Genes.xlsx (col A, headerless).
 2. Load all 86 sample files (data/CHIP_DP10_GQ20_PASS/*.xlsx) with header=None, skiprows=2
    (2-row merged header; 33 fields, layout verified identical across all files).
 3. CHIP-gene filter: split 'Gene Names' (col 12) on commas; keep rows where any symbol is in the 56-gene set.
 4. Reference filter: keep only Zygosity (col 4) in {Heterozygous, Homozygous Variant};
    drop 'Reference' and empty (not-genotyped) rows.
 5. Exonic filter (SO terms, col 13 'Sequence Ontology (Combined)'):
    keep {synonymous_variant, missense_variant, inframe_insertion, inframe_deletion, frameshift_variant};
    intron_variant, splice_region_variant (intronic by SO definition), UTR terms, upstream_gene_variant excluded.
 6. Headline = total variant calls across all 86 samples (sample x variant rows).
    Supplements: unique variants (Chr:Pos + Ref/Alt), per-gene counts, zygosity breakdown.
"""
import glob
import os
import sys
from collections import Counter, defaultdict

import pandas as pd

BASE = os.path.dirname(os.path.abspath(__file__))
CHIP_FILE = os.path.join(BASE, "data", "230214_Schenz_et_al_2022_CHIP_Genes.xlsx")
SAMPLE_DIR = os.path.join(BASE, "data", "CHIP_DP10_GQ20_PASS")

# Field positions (row-2 header of every file; verified identical across all 86)
COL_POS, COL_REFALT, COL_ZYG, COL_GENE, COL_SO = 0, 1, 4, 12, 13
EXPECTED_HEADER = [
    "Chr:Pos", "Ref/Alt", "Primary Findings", "Incidental Findings", "Zygosity",
    "Mendel Error", "Inherited From", "Read Depths (DP)", "Genotype Qualities (GQ)",
    "Variant Allele Freq", "In ACMG SF Genes?", "Match", "Gene Names",
    "Sequence Ontology (Combined)", "Effect (Combined)",
    "Transcript Name (Clinically Relevant)", "Exon Number (Clinically Relevant)",
    "HGVS c. (Clinically Relevant)", "HGVS p. (Clinically Relevant)", "Filter",
    "Alt Allele Freq (AF)", "Alt Allele Count (AC)", "#Alleles (AN)",
    "Homozgyous Count (Hom)", "Variant ID", "Classification",
    "Aggregate of Interpretations from Submissions", "Review Status", "Conditions",
    "In_CHIP", "Match", "In_DNAm", "Match",
]

NONREF_ZYG = {"Heterozygous", "Homozygous Variant"}
EXONIC_SO = {
    "synonymous_variant", "missense_variant", "inframe_insertion",
    "inframe_deletion", "frameshift_variant",
}


def main():
    # (i) CHIP gene list
    chip_df = pd.read_excel(CHIP_FILE, header=None)
    chip_genes = set(chip_df[0].dropna().astype(str).str.strip())
    assert len(chip_genes) == 56, f"expected 56 CHIP genes, got {len(chip_genes)}"

    files = sorted(glob.glob(os.path.join(SAMPLE_DIR, "*.xlsx")))
    assert len(files) == 86, f"expected 86 sample files, got {len(files)}"

    total_calls = 0
    unique_variants = set()
    per_gene = Counter()
    per_zyg = Counter()
    per_so = Counter()
    per_file = {}
    n_rows = 0
    parse_errors = []
    header_mismatch = []

    # (ii)-(v) per-file load + filters
    for f in files:
        name = os.path.basename(f)
        try:
            df = pd.read_excel(f, header=None)
        except Exception as e:  # noqa: BLE001
            parse_errors.append((name, repr(e)))
            continue
        if df.shape[1] != 33:
            parse_errors.append((name, f"unexpected column count {df.shape[1]}"))
            continue
        hdr = [None if (isinstance(v, float) and pd.isna(v)) else v for v in df.iloc[1].tolist()]
        if hdr != EXPECTED_HEADER:
            header_mismatch.append(name)
            continue
        data = df.iloc[2:]
        n_rows += len(data)

        zyg = data.iloc[:, COL_ZYG]
        so = data.iloc[:, COL_SO]
        gene = data.iloc[:, COL_GENE].fillna("")
        pos = data.iloc[:, COL_POS].astype(str)
        refalt = data.iloc[:, COL_REFALT].astype(str)

        in_chip = gene.apply(lambda v: any(g in chip_genes for g in str(v).split(",")))
        keep = (
            in_chip
            & zyg.isin(NONREF_ZYG)
            & so.isin(EXONIC_SO)
        )
        sub = data[keep]
        n = int(keep.sum())
        per_file[name] = n
        total_calls += n

        for (p, r), g, z, s in zip(
            zip(pos[keep], refalt[keep]), gene[keep], zyg[keep], so[keep]
        ):
            unique_variants.add((p, r))
            per_zyg[z] += 1
            per_so[s] += 1
            for gsym in str(g).split(","):
                gsym = gsym.strip()
                if gsym in chip_genes:
                    per_gene[gsym] += 1

    # --- reporting ---
    print("=" * 70)
    print("FINAL RESULT: non-reference exonic variant calls in CHIP genes (86 samples)")
    print("=" * 70)
    print(f"Files loaded OK           : {len(per_file)}/86")
    print(f"Parse errors              : {parse_errors if parse_errors else 'none'}")
    print(f"Header mismatches         : {header_mismatch if header_mismatch else 'none'}")
    print(f"Total data rows scanned   : {n_rows}")
    print()
    print(f"TOTAL non-ref exonic calls: {total_calls}")
    print(f"Unique variants (Pos+Ref/Alt): {len(unique_variants)}")
    print()
    print("By zygosity:")
    for z in ("Heterozygous", "Homozygous Variant"):
        print(f"  {z:22s}: {per_zyg.get(z, 0)}")
    print()
    print("By SO term:")
    for s, c in sorted(per_so.items(), key=lambda kv: -kv[1]):
        print(f"  {s:22s}: {c}")
    print()
    print(f"Per-gene counts ({len(per_gene)} CHIP genes with >=1 call; "
          f"sum={sum(per_gene.values())}; rows affecting >1 gene counted per gene):")
    for g, c in sorted(per_gene.items(), key=lambda kv: (-kv[1], kv[0])):
        print(f"  {g:10s}: {c}")
    print()
    print("Per-sample counts (min/mean/max):",
          min(per_file.values()), round(sum(per_file.values()) / len(per_file), 1),
          max(per_file.values()))

    assert len(per_file) == 86 and not parse_errors and not header_mismatch
    return 0


if __name__ == "__main__":
    sys.exit(main())
