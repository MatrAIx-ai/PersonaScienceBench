"""
Skewness of the pooled gene expression (log2(TPM+1), batch-corrected) distribution
across all cell lines.

Data:
  - data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
    First column = cell-line ModelID; remaining 19,138 columns = genes.
    1,673 cell lines x 19,138 genes = 32,017,874 values.
    Values are ALREADY on the log2(TPM+1) scale and batch-corrected; no re-transform.

Method:
  Pool every gene x cell-line value into a single vector and compute the
  Fisher-Pearson moment coefficient of skewness (m3 / m2**1.5).
  Primary: scipy.stats.skew(x, bias=True). Secondary: bias=False.
  Also report n, mean, std (population, ddof=0, to match moment definition).
"""
import csv
import numpy as np

PATH = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
N_GENE_COLS = 19138

# Stream rows, build a float64 array of shape (n_cells, n_genes)
rows = []
with open(PATH, newline="") as f:
    header = next(f)
    for line in f:
        parts = line.rstrip("\n").split(",")
        # parts[0] is the cell-line ID; the rest are gene values
        rows.append(parts[1:])

X = np.array(rows, dtype=np.float64)
assert X.shape == (1673, N_GENE_COLS), X.shape

vals = X.ravel()
n = vals.size

mean = vals.mean()
# population std (ddof=0) consistent with moment-based skewness
std_pop = vals.std(ddof=0)
std_sample = vals.std(ddof=1)

m2 = ((vals - mean) ** 2).mean()
m3 = ((vals - mean) ** 3).mean()
skew_fp = m3 / (m2 ** 1.5)

try:
    from scipy import stats
    skew_b1 = float(stats.skew(vals, bias=True))
    skew_b0 = float(stats.skew(vals, bias=False))
    have_scipy = True
except Exception as e:
    skew_b1 = skew_fp
    skew_b0 = float("nan")
    have_scipy = False

print("=== POOLED GENE EXPRESSION (log2(TPM+1), batch-corrected) ===")
print(f"n (values)          : {n:,}")
print(f"cell lines          : {X.shape[0]}")
print(f"genes               : {X.shape[1]}")
print(f"min / max           : {vals.min():.6f} / {vals.max():.6f}")
print(f"mean                : {mean:.6f}")
print(f"std (pop, ddof=0)   : {std_pop:.6f}")
print(f"std (sample, ddof=1): {std_sample:.6f}")
print(f"skewness (F-P, manual m3/m2^1.5): {skew_fp:.6f}")
if have_scipy:
    print(f"skewness scipy bias=True  : {skew_b1:.6f}")
    print(f"skewness scipy bias=False : {skew_b0:.6f}")
