import pandas as pd
import numpy as np
from scipy import stats

# 1. Load gene metadata
g = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)

# 2. Load sample annotation -> CD4 samples (authoritative: celltype == 'CD4')
s = pd.read_csv('data/Sample_annotated_Zenodo.csv')
cd4 = s.loc[s['celltype'] == 'CD4', 'sample'].tolist()
print('Number of CD4 samples:', len(cd4))

# 3. Load read-count matrix (gene x sample)
bc = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)

# Verify all CD4 samples present
missing = [c for c in cd4 if c not in bc.columns]
print('CD4 samples missing from matrix:', len(missing))

# 4. Filter to protein-coding genes
pc = g[g['gene_biotype'] == 'protein_coding']
print('Number of protein-coding genes:', len(pc))

# Ensure all protein-coding genes are in the matrix
pc_in_matrix = pc.index.intersection(bc.index)
print('Protein-coding genes present in matrix:', len(pc_in_matrix))

# 5. Mean expression across the 151 CD4 samples (arithmetic mean of raw counts)
mean_expr = bc.loc[pc_in_matrix, cd4].mean(axis=1)

# 6. Length for those genes
length = pc.loc[pc_in_matrix, 'Length']

# Drop any (unexpected) non-finite values
mask = np.isfinite(length.values) & np.isfinite(mean_expr.values)
length = length[mask]
mean_expr = mean_expr[mask]

n = len(length)
print('Number of genes used in correlation:', n)
print('Length stats: min', length.min(), 'max', length.max())
print('Mean-expr stats: min', mean_expr.min(), 'max', mean_expr.max())

# 7. Pearson correlation
r, p = stats.pearsonr(length.values, mean_expr.values)
print()
print('=== RESULT ===')
print(f'Pearson r = {r:.6f}')
print(f'p-value   = {p:.6e}')
print(f'n genes   = {n}')
