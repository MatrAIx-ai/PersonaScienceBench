"""
BixBench bix-22-q4: Pearson correlation between gene length and mean expression
(across samples) for protein-coding genes in CD14 immune cells.

Steps:
1. Load GeneMetaInfo (index_col=0) and BatchCorrectedReadCounts (index_col=0).
2. Select CD14 samples via Sample_annotated celltype == 'CD14' (exact match).
3. Per gene: arithmetic mean expression across the 132 CD14 sample columns.
4. Inner join with GeneMetaInfo.Length (gene symbols align 1:1, verified).
5. Filter gene_biotype == 'protein_coding' (exact, case-sensitive).
6. Pearson correlation on paired (Length, mean_expr); listwise deletion as
   fallback (0 missing in this data, so no pairs removed).
"""
import pandas as pd
import numpy as np
from scipy import stats

DATA = "data"

meta = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv", index_col=0)
expr = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
annot = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")

# --- 1. CD14 samples ---
cd14 = annot.loc[annot["celltype"] == "CD14", "sample"].tolist()
assert all(c in expr.columns for c in cd14), "CD14 cols missing from matrix"
print(f"CD14 sample count: {len(cd14)}")

# --- 2. Mean expression per gene across CD14 samples ---
sub = expr[cd14].astype("float64")
mean_expr = sub.mean(axis=1)
print(f"Genes in expression matrix: {len(mean_expr)}")
print(f"NA mean-expression values: {int(mean_expr.isna().sum())}")

# --- 3. Join Length, filter protein-coding (exact match) ---
df = mean_expr.rename("mean_expr").to_frame()
df["Length"] = meta.loc[df.index, "Length"].values
df["gene_biotype"] = meta.loc[df.index, "gene_biotype"].values
pc = df[df["gene_biotype"] == "protein_coding"].copy()
print(f"protein_coding genes: {len(pc)}")

# --- 4. Pairwise (listwise) deletion fallback ---
pc = pc.dropna(subset=["Length", "mean_expr"])
print(f"Final paired observations n: {len(pc)}")

# --- 5. Pearson correlation ---
r, p = stats.pearsonr(pc["Length"].to_numpy(), pc["mean_expr"].to_numpy())
r_np = np.corrcoef(pc["Length"].to_numpy(), pc["mean_expr"].to_numpy())[0, 1]
print(f"Pearson r (scipy.stats.pearsonr): {r:.10f}")
print(f"Pearson r (numpy.corrcoef) check: {r_np:.10f}")
print(f"p-value (scipy): {p:.6e}")
print(f"mean Length (pc, CD14 set): {pc['Length'].mean():.2f}")
print(f"mean expression (pc, CD14 set): {pc['mean_expr'].mean():.4f}")
