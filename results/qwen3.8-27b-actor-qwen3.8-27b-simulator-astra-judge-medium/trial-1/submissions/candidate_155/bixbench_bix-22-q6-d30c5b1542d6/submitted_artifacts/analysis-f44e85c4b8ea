"""
BixBench bix-22-q6
Question: When examining protein-coding genes only, what is the Pearson
correlation coefficient between gene length and gene expression?

Approved pipeline:
  - protein-coding genes: gene_biotype == 'protein_coding' (exact match)
  - expression per gene = mean of log1p(batch-corrected read counts) over all 723 samples
  - Pearson correlation between Length (bp) and that expression value
  - also report raw-counts mean as a cross-check
"""
import pandas as pd
import numpy as np
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"

meta = pd.read_csv(META, index_col=0)
counts = pd.read_csv(COUNTS, index_col=0)

# --- consistency checks (report before proceeding) ---
print("meta shape:", meta.shape)
print("counts shape:", counts.shape)
print("index==Geneid all equal:", (meta.index == meta["Geneid"]).all())
print("meta index dup:", meta.index.duplicated().sum())
print("counts index dup:", counts.index.duplicated().sum())
ci, mi = set(counts.index), set(meta.index)
print("counts rows not in meta:", len(ci - mi))
print("meta rows not in counts:", len(mi - ci))

# align counts rows to meta order
counts = counts.loc[meta.index]

# --- protein-coding filter (exact) ---
pc_mask = meta["gene_biotype"] == "protein_coding"
pc = meta[pc_mask]
X = counts.loc[pc.index].values
Length = pc["Length"].values
print("protein-coding genes (n):", len(pc))
print("samples used:", X.shape[1])
print("Length nulls:", int(pd.isna(Length).sum()),
      "| count nulls:", int(np.isnan(X).sum()))

# --- main metric: log1p then mean over samples ---
expr_log = np.log1p(X).mean(axis=1)
r_log, p_log = stats.pearsonr(Length, expr_log)

# --- cross-check: raw counts mean over samples ---
expr_raw = X.mean(axis=1)
r_raw, p_raw = stats.pearsonr(Length, expr_raw)

print("\n=== RESULTS ===")
print(f"MAIN (log1p mean):  Pearson r = {r_log:.6f}, p = {p_log:.4e}, n = {len(pc)}")
print(f"CROSS-CHECK (raw mean): Pearson r = {r_raw:.6f}, p = {p_raw:.4e}, n = {len(pc)}")
