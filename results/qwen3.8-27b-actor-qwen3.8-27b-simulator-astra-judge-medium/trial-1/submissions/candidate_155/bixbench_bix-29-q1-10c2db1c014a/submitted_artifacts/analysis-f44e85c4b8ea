#!/usr/bin/env python3
"""
TASK008 BCG-CORONA: Ordinal regression of BCG vaccination on COVID-19 severity,
controlling for prior medical-history count and patients interaction frequency,
with BCG x interaction-frequency interaction (primary) and
MH-count x interaction-frequency interaction (sensitivity).

Approved design:
- Outcome: max AESEV per USUBJID over AE rows with AEPT=='COVID-19'
  (levels 1=Mild < 2=Moderate < 3=Severe < 4=Life-threatening).
  Subjects with no non-null AESEV are excluded (case-only sample).
- MH count: per USUBJID, count of MHTERM rows with MHORRES==2 (affirmative
  medical history) in the MEDICAL HISTORY subcategory; 0 when none.
- Interaction frequency: DM.patients_seen banded ordinal -> midpoints 30/75/150.
- Model: proportional-odds (cumulative-logit, logit link) ordinal regression.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from scipy import stats

DATA = "data"
dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")

# ---------------- Outcome ----------------
cov = ae[ae["AEPT"] == "COVID-19"].copy()
n_cov_rows, n_cov_subj = len(cov), cov["USUBJID"].nunique()
max_sev = cov.groupby("USUBJID")["AESEV"].max()          # primary
first_sev = (cov.sort_values("AESTDTC")
                  .groupby("USUBJID")["AESEV"].first())  # sensitivity
y = max_sev.dropna()
n_excl = n_cov_subj - len(y)

# ---------------- Covariates ----------------
mt = mh[mh["MHTERM"].notna()]                            # MEDICAL HISTORY subcat
mh_count = mt[mt["MHORRES"] == 2].groupby("USUBJID").size()

mid = {"1-50": 30, "51-100": 75, ">100": 150}
dm = dm.assign(interact_freq=dm["patients_seen"].map(mid),
               BCG=(dm["TRTGRP"] == "BCG").astype(int))

def build_df(sev_series):
    df = (sev_series.dropna().to_frame("severity").reset_index()
          .merge(mh_count.rename("mh_count").reset_index(), on="USUBJID", how="left")
          .merge(dm[["USUBJID", "BCG", "interact_freq"]], on="USUBJID"))
    df["mh_count"] = df["mh_count"].fillna(0).astype(int)
    return df

df = build_df(max_sev)
assert df["severity"].between(1, 4).all()
n = len(df)
print(f"COVID-19 AE rows={n_cov_rows}, subjects with COVID-19 AE={n_cov_subj}, "
      f"excluded (no non-null AESEV)={n_excl}, model n={n}")
print("Severity distribution:", df["severity"].value_counts().sort_index().to_dict())
print("BCG in sample:", df["BCG"].value_counts().to_dict())
print("mh_count: mean=%.2f min=%d max=%d (subjects with >=1 affirmative: %d)"
      % (df["mh_count"].mean(), df["mh_count"].min(), df["mh_count"].max(),
         (df["mh_count"] > 0).sum()))
print("interact_freq: mean=%.1f (30/75/150 midpoints)" % df["interact_freq"].mean())

# ---------------- helpers ----------------
def or_ci(mod, freq_series, param, at_mean_of=None):
    """exp(beta) or exp(beta + mean(freq)*beta2) with delta-method 95% CI."""
    sel = [param] + ([at_mean_of] if at_mean_of else [])
    w = np.zeros(len(sel)); w[0] = 1.0
    if at_mean_of:
        w[1] = np.mean(freq_series)
    idx = [mod.params.index.get_loc(c) for c in sel]
    log_or = w @ mod.params.values[idx]
    var = w @ mod.cov_params().values[np.ix_(idx, idx)] @ w
    return np.exp(log_or), np.exp(log_or - 1.96*np.sqrt(var)), np.exp(log_or + 1.96*np.sqrt(var))

def brant_test(y, X):
    """Brant test: regress each X on cumulative-logit threshold dummies; Wald."""
    K = int(y.max())
    dummies = pd.DataFrame({f"cl{k}": (y > k).astype(float) for k in range(1, K)})
    per = {}
    for c in X.columns:
        reg = X[[c]].assign(const=1.0).join(dummies)
        res = sm.OLS(reg[[c]], reg[["const"] + list(dummies.columns)]).fit()
        f = res.fvalue
        p = 1 - stats.f.cdf(f, dummies.shape[1], res.df_resid)
        per[c] = (f * dummies.shape[1], p)
    chi2 = sum(v[0] for v in per.values())
    p_tot = 1 - stats.chi2.cdf(chi2, dummies.shape[1]*len(X.columns))
    return per, chi2, p_tot

# ---------------- PRIMARY: BCG x interact_freq ----------------
X = pd.DataFrame({"BCG": df["BCG"], "mh_count": df["mh_count"],
                  "interact_freq": df["interact_freq"],
                  "BCG_x_freq": df["BCG"] * df["interact_freq"]})
mod = OrderedModel(df["severity"], X, distr="logit").fit(method="bfgs", disp=1)
print("\n=== PRIMARY: proportional-odds (cumulative logit) ===")
print(mod.summary())

or_main, lo_main, hi_main = or_ci(mod, df["interact_freq"], "BCG")
or_marg, lo_marg, hi_marg = or_ci(mod, df["interact_freq"], "BCG", "BCG_x_freq")
or_int, lo_int, hi_int = or_ci(mod, df["interact_freq"], "BCG_x_freq")
or_mh, lo_mh, hi_mh = or_ci(mod, df["interact_freq"], "mh_count")
or_f, lo_f, hi_f = or_ci(mod, df["interact_freq"], "interact_freq")
print(f"\nOR BCG main effect (at interact_freq=0):              {or_main:.3f}  95% CI [{lo_main:.3f}, {hi_main:.3f}]")
print(f"OR BCG marginal (at mean interact_freq="
      f"{df['interact_freq'].mean():.1f}): {or_marg:.3f}  95% CI [{lo_marg:.3f}, {hi_marg:.3f}]")
print(f"OR BCG x interact_freq (per 1-pt unit of freq):        {or_int:.3f}  95% CI [{lo_int:.3f}, {hi_int:.3f}]")
print(f"OR mh_count (per additional condition):                {or_mh:.3f}  95% CI [{lo_mh:.3f}, {hi_mh:.3f}]")
print(f"OR interact_freq (per 1-pt unit):                      {or_f:.3f}  95% CI [{lo_f:.3f}, {hi_f:.3f}]")
print(f"Wald p: BCG={mod.pvalues['BCG']:.3f}, mh_count={mod.pvalues['mh_count']:.3f}, "
      f"interact_freq={mod.pvalues['interact_freq']:.3f}, BCG_x_freq={mod.pvalues['BCG_x_freq']:.3f}")

per, chi2, p_br = brant_test(df["severity"], X)
print("\nBrant test per term: " + ", ".join(f"{k}: chi2={v[0]:.2f}, p={v[1]:.3f}" for k, v in per.items()))
print(f"Brant overall: chi2={chi2:.2f}, df={4*2}, p={p_br:.3f}")

# ---------------- Sensitivity 1: first AE by AESTDTC ----------------
df2 = build_df(first_sev)
X2 = pd.DataFrame({"BCG": df2["BCG"], "mh_count": df2["mh_count"],
                   "interact_freq": df2["interact_freq"],
                   "BCG_x_freq": df2["BCG"] * df2["interact_freq"]})
mod2 = OrderedModel(df2["severity"], X2, distr="logit").fit(method="bfgs", disp=0)
o2, l2, h2 = or_ci(mod2, df2["interact_freq"], "BCG")
o2m, l2m, h2m = or_ci(mod2, df2["interact_freq"], "BCG", "BCG_x_freq")
print(f"\nSENSITIVITY first-AE-by-AESTDTC (n={len(df2)}): "
      f"OR BCG main={o2:.3f} 95% CI [{l2:.3f}, {h2:.3f}]; "
      f"marginal at mean freq={o2m:.3f} 95% CI [{l2m:.3f}, {h2m:.3f}]")

# ---------------- Sensitivity 2: mh_count x interact_freq ----------------
X3 = pd.DataFrame({"BCG": df["BCG"], "mh_count": df["mh_count"],
                   "interact_freq": df["interact_freq"],
                   "mh_x_freq": df["mh_count"] * df["interact_freq"]})
mod3 = OrderedModel(df["severity"], X3, distr="logit").fit(method="bfgs", disp=0)
o3, l3, h3 = or_ci(mod3, df["interact_freq"], "BCG")
o3m, l3m, h3m = or_ci(mod3, df["interact_freq"], "BCG", "mh_x_freq")
print(f"SENSITIVITY mh_count x freq interaction (n={len(df)}): "
      f"OR BCG main={o3:.3f} 95% CI [{l3:.3f}, {h3:.3f}]; "
      f"marginal at mean freq={o3m:.3f} 95% CI [{l3m:.3f}, {h3m:.3f}]; "
      f"OR mh_x_freq={np.exp(mod3.params['mh_x_freq']):.3f} (p={mod3.pvalues['mh_x_freq']:.3f})")

# ---------------- Sensitivity 3: ordinal 1/2/3 coding ----------------
ord_code = {"1-50": 1, "51-100": 2, ">100": 3}
dfo = df.assign(interact_freq=df["interact_freq"].map({30: 1, 75: 2, 150: 3}))
Xo = pd.DataFrame({"BCG": dfo["BCG"], "mh_count": dfo["mh_count"],
                   "interact_freq": dfo["interact_freq"],
                   "BCG_x_freq": dfo["BCG"] * dfo["interact_freq"]})
modo = OrderedModel(dfo["severity"], Xo, distr="logit").fit(method="bfgs", disp=0)
oo, loo, hao = or_ci(modo, dfo["interact_freq"], "BCG")
oom, lom, ham = or_ci(modo, dfo["interact_freq"], "BCG", "BCG_x_freq")
print(f"SENSITIVITY patients_seen ordinal 1/2/3 (n={len(df)}): "
      f"OR BCG main={oo:.3f} 95% CI [{loo:.3f}, {hao:.3f}]; "
      f"marginal at mean freq={oom:.3f} 95% CI [{lom:.3f}, {ham:.3f}]")

print("\nDONE")
