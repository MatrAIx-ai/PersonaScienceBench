# -*- coding: utf-8 -*-
"""
BixBench bix-29-q2: independent effect of each additional ongoing medical
condition (MHONGO) on the odds of higher COVID-19 severity, controlling for
BCG vaccination status and patient interaction variables, via ordinal regression.
Effect expressed as (exp(beta)-1)*100% increase in odds.
"""
import numpy as np
import pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel
from statsmodels.stats.contrast import WaldTestResults

DATA = "data"
dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")

# ---------- 1. Outcome: subject-level max AESEV among COVID-19 AE rows ----------
cov = ae[ae.AEPT.str.lower().str.contains("covid", na=False)]
sev = (cov.groupby("USUBJID").AESEV.max()
         .dropna().astype(int))          # analysis set: non-missing severity
print("Subjects with COVID-19 AE:", cov.USUBJID.nunique())
print("Analysis set (non-missing AESEV):", len(sev))
print("Severity distribution:\n", sev.value_counts().sort_index())

# ---------- 2. Exposure: n_ongoing = dedup count of MHONGO=='Yes' ----------
ong = mh[mh.MHONGO == "Yes"].copy()
ong["cond"] = (ong.MHDECOD.fillna(ong.MHTERM).astype(str).str.upper().str.strip())
n_ongoing = ong.groupby("USUBJID")["cond"].nunique().rename("n_ongoing")
print("Subjects with >=1 ongoing condition:", len(n_ongoing))

# ---------- 3. Merge at subject level ----------
df = (dm.set_index("USUBJID")[["TRTGRP", "work_hours", "patients_seen", "expect_interact"]]
        .join(sev.rename("severity"))
        .join(n_ongoing)
        .reset_index())
df = df.dropna(subset=["severity"]).copy()
df["severity"] = df["severity"].astype(int)
df["n_ongoing"] = df["n_ongoing"].fillna(0).astype(int)
df["bcg"] = (df.TRTGRP == "BCG").astype(int)
df["exp_it"] = (df.expect_interact == "Yes").astype(int)
wh41 = (df.work_hours == "41-80").astype(int)
wh80 = (df.work_hours == ">80").astype(int)
ps51 = (df.patients_seen == "51-100").astype(int)
ps100 = (df.patients_seen == ">100").astype(int)
print("\nAnalysis-set n =", len(df))
print(pd.crosstab(df.severity, df.bcg))
print("n_ongoing dist:", df.n_ongoing.value_counts().sort_index().to_dict())
print("work_hours:", df.work_hours.value_counts().to_dict())
print("patients_seen:", df.patients_seen.value_counts().to_dict())
print("expect_interact:", df.exp_it.value_counts().to_dict())

# ---------- 4. Ordinal regression (proportional odds, logit link) ----------
X = pd.DataFrame({
    "bcg": df.bcg,
    "n_ongoing": df.n_ongoing,
    "wh_41-80": wh41, "wh_>80": wh80,
    "ps_51-100": ps51, "ps_>100": ps100,
    "expect_interact": df.exp_it,
})
y = df.severity
model = OrderedModel(y, X, distr="logit")
res = model.fit(method="newton", disp=False, maxiter=500)
print("\nConverged:", res.mle_retvals["converged"])
print(res.summary())

# ---------- 5. Effect of n_ongoing ----------
b = res.params["n_ongoing"]
se = res.bse["n_ongoing"]
orv = np.exp(b)
ci = np.exp(res.conf_int().loc["n_ongoing"])
pct = (orv - 1) * 100
print("\n=== KEY RESULT: n_ongoing ===")
print(f"coefficient = {b:.4f} (SE {se:.4f})")
print(f"OR per additional ongoing condition = {orv:.4f}  95% CI [{ci[0]:.4f}, {ci[1]:.4f}]")
print(f"Increase in odds of higher severity = {pct:.1f}%  (95% CI [{(ci[0]-1)*100:.1f}%, {(ci[1]-1)*100:.1f}%])")

# ---------- 6. Brant test: proportional-odds (parallel lines) assumption ----------
from statsmodels.genmod.generalized_linear_model import GLM
from statsmodels.genmod.families import Binomial
cats = sorted(y.unique())
coefs, vars_ = [], []
for k in cats[:-1]:
    yk = (y <= k).astype(float).values
    f = GLM(yk, X, family=Binomial()).fit(disp=False)
    coefs.append(f.params.values)
    vars_.append(f.cov_params().values)
K = len(coefs)
bbar = np.mean(coefs, axis=0)
Vbar = np.sum(vars_, axis=0) / K
diff = np.array([c - bbar for c in coefs])
W = np.sum(np.einsum("ij,jk,ik->i", diff, np.linalg.inv(Vbar), diff))
df_chi2 = (K - 1) * len(coefs[0])
from scipy.stats import chi2 as chi2dist
p_brant = chi2dist.sf(W, df_chi2)
print(f"\nBrant test: chi2 = {W:.3f}, df = {df_chi2}, p = {p_brant:.3f}")
print("Parallel-odds assumption:", "not rejected" if p_brant > 0.05 else "REJECTED (consider partial-odds model)")

# sensitivity: ordinal numeric coding (1,2,3) for work_hours / patients_seen
wh_ord = df.work_hours.map({"1-40":1,"41-80":2,">80":3})
ps_ord = df.patients_seen.map({"1-50":1,"51-100":2,">100":3})
X3 = pd.DataFrame({"bcg": df.bcg, "n_ongoing": df.n_ongoing,
                   "wh_ord": wh_ord, "ps_ord": ps_ord, "expect_interact": df.exp_it})
res3 = OrderedModel(y, X3, distr="logit").fit(method="newton", disp=False, maxiter=500)
b3 = res3.params["n_ongoing"]; orv3 = np.exp(b3); ci3 = np.exp(res3.conf_int().loc["n_ongoing"])
print("\nSensitivity (ordinal coding 1-3 for wh/ps):")
print(f"  n_ongoing coef = {b3:.4f}, OR = {orv3:.4f}, 95% CI [{ci3[0]:.4f}, {ci3[1]:.4f}], +{(orv3-1)*100:.1f}%")

# who are the 2 work_hours>80 subjects?
print("\nwork_hours>80 subjects:", df.loc[df.work_hours==">80", ["USUBJID","severity","n_ongoing"]].to_dict("records"))

# threshold parameters
print("\nThresholds (cumulative logits):")
for t in ["1/2", "2/3", "3/4"]:
    print(f"  {t}: {res.params[t]:.3f} (SE {res.bse[t]:.3f})")

# per-threshold coefficient table (Brant diagnostics detail)
print("\nPer-threshold cumulative-logit coefficients (Brant diagnostics):")
rows = []
for k in cats[:-1]:
    yk = (y <= k).astype(float).values
    f = GLM(yk, X, family=Binomial()).fit(disp=False)
    rows.append(pd.Series(f.params.values, index=X.columns, name=f"<= {k}"))
tab = pd.DataFrame(rows)
print(tab.round(3))
print("\nRange across thresholds per covariate (larger => stronger PO violation):")
print((tab.max() - tab.min()).round(3).sort_values(ascending=False))

# sensitivity: refit with only the covariates that respect PO (n_ongoing, bcg)
X2 = X[["bcg", "n_ongoing", "expect_interact"]]
res2 = OrderedModel(y, X2, distr="logit").fit(method="newton", disp=False, maxiter=500)
co2, va2 = [], []
for k in cats[:-1]:
    yk = (y <= k).astype(float).values
    f = GLM(yk, X2, family=Binomial()).fit(disp=False)
    co2.append(f.params.values); va2.append(f.cov_params().values)
bbar2 = np.mean(co2, axis=0); Vbar2 = np.sum(va2, axis=0)/len(co2)
d2 = np.array([c - bbar2 for c in co2])
W2 = np.sum(np.einsum("ij,jk,ik->i", d2, np.linalg.inv(Vbar2), d2))
p2 = chi2dist.sf(W2, (len(co2)-1)*len(co2[0]))
b2 = res2.params["n_ongoing"]; orv2 = np.exp(b2); ci2 = np.exp(res2.conf_int().loc["n_ongoing"])
print("\nSensitivity (covariates: bcg, n_ongoing, expect_interact):")
print(f"  n_ongoing coef = {b2:.4f}, OR = {orv2:.4f}, 95% CI [{ci2[0]:.4f}, {ci2[1]:.4f}], +{(orv2-1)*100:.1f}%")
print(f"  Brant: chi2 = {W2:.3f}, df = {(len(co2)-1)*len(co2[0])}, p = {p2:.3f}")
