import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

# ---------- Load ----------
dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv", low_memory=False)
mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv", low_memory=False)

# ---------- BCG status (Placebo = reference 0, BCG = 1) ----------
dm["BCG"] = (dm["TRTGRP"] == "BCG").astype(int)

# ---------- Prior medical history (any standard MHTERM with MHORRES==2) ----------
std = mh[mh["MHTERM"].notna() & ~mh["MHTERM"].astype(str).str.startswith("Other:")]
pmh_counts = std[std["MHORRES"] == 2.0].groupby("USUBJID").size()
dm["PMH"] = pmh_counts.reindex(dm["USUBJID"].values).fillna(0).astype(int).clip(upper=1).to_numpy()

# ---------- Patient interaction frequency: patients_seen -> ordinal 1,2,3 ----------
seen_map = {"1-50": 1, "51-100": 2, ">100": 3}
dm["patients_seen_ord"] = dm["patients_seen"].map(seen_map)

# ---------- Outcome: COVID-19 AE severity = max AESEV per subject ----------
cov = ae[ae["AEPT"] == "COVID-19"].dropna(subset=["AESEV"])
sev = cov.groupby("USUBJID")["AESEV"].max()
sub = sev.index.values

# ---------- Assemble analysis dataset (n=148) ----------
d = dm.set_index("USUBJID").loc[sub].reset_index()
d["severity"] = sev.reindex(d["USUBJID"]).astype(int).values

print("Analysis N:", len(d))
print("Severity dist:", d["severity"].value_counts().sort_index().to_dict())
print("BCG x PMH table:")
print(pd.crosstab(d["BCG"], d["PMH"]))
print("Missing in analysis set: BCG", d["BCG"].isna().sum(),
      "PMH", d["PMH"].isna().sum(),
      "patients_seen_ord", d["patients_seen_ord"].isna().sum(),
      "severity", d["severity"].isna().sum())

# ---------- Ordinal regression (proportional odds, logit) ----------
y = d["severity"]
X = pd.DataFrame({
    "BCG": d["BCG"],
    "PMH": d["PMH"],
    "BCGxPMH": d["BCG"] * d["PMH"],
    "patients_seen": d["patients_seen_ord"],
})
X = X.copy()  # no explicit constant; OrderedModel estimates cut-points

model = OrderedModel(y, X, distr="logit")
res = model.fit(method="bfgs", maxiter=500, disp=0)

print("\n=== OrderedModel (logit) summary ===")
print(res.summary())

# ---------- Extract interaction OR ----------
b = res.params
bci = res.conf_int()
pval = res.pvalues
beta_int = b["BCGxPMH"]
or_int = np.exp(beta_int)
ci_int = np.exp(bci.loc["BCGxPMH"])
p_int = pval["BCGxPMH"]

print("\n=== Interaction BCG:PMH ===")
print(f"beta = {beta_int:.4f}")
print(f"OR   = {or_int:.4f}")
print(f"95% CI = [{ci_int.iloc[0]:.4f}, {ci_int.iloc[1]:.4f}]")
print(f"p    = {p_int:.4f}")

print("\n=== All coefficients (OR = exp(beta)) ===")
tab = pd.DataFrame({
    "coef": b,
    "OR": np.exp(b),
    "CI_low": np.exp(bci.iloc[:, 0]),
    "CI_high": np.exp(bci.iloc[:, 1]),
    "p": pval,
})
print(tab)

# ---------- Convergence / diagnostics ----------
print("\nConverged:", res.mle_retvals["converged"])
print("N obs:", int(res.nobs))
print("LLF:", res.llf)
# condition number of X (collinearity check)
Xv = np.asarray(X.values, dtype=float)
cond = np.linalg.cond(Xv)
print("cond(X):", cond)
corr = np.corrcoef(Xv[:, 1:].T)
print("correlation matrix (non-constant):")
print(pd.DataFrame(corr, index=X.columns[1:], columns=X.columns[1:]).round(3))

# Save model output
with open("results.txt", "w") as f:
    f.write(res.summary().as_text())
    f.write("\n\nInteraction BCG:PMH OR=%.4f CI=[%.4f,%.4f] p=%.4f\n" % (or_int, ci_int.iloc[0], ci_int.iloc[1], p_int))
print("\nSaved results.txt")

# ---------- Manual LRT for proportional-odds (parallel-lines) assumption ----------
from scipy.optimize import minimize
from scipy.special import logsumexp
import numpy as np

def logit(x):
    return np.log1p(np.exp(-np.abs(x))) * np.sign(x) + np.where(x >= 0, 0, -np.inf) * 0  # placeholder

Xn = X.values.astype(float)  # includes no constant; we add alpha per cutpoint
p = Xn.shape[1]
K = 4  # severity categories 1..4
yarr = y.values.astype(int)

def llf_PO(theta):
    # theta: [alpha (K-1), beta (p)] shared
    al = theta[:K-1]
    be = theta[K-1:]
    eta = Xn @ be  # (n,1)
    lin = al + eta
    # cum probs
    logF = []
    for k in range(K-1):
        # F(lin_k) = log(1/(1+exp(-lin_k)))
        Fk = np.logaddexp(0, -(-lin[k]))  # log(1+exp(lin_k)) -> log F = lin_k - log(1+exp(lin_k))
    # do it properly
    def logF(v):
        return np.where(v >= 0, v - np.log1p(np.exp(-v)), np.log1p(np.exp(v)))
    def logS(v):
        return -np.log1p(np.exp(v))
    # cumulative: P(Y<=k) = F(lin_k)
    L = np.zeros(len(yarr))
    for i in range(len(yarr)):
        yv = yarr[i]
        if yv == 1:
            L[i] = logS(lin[i, 0])
        elif yv == K:
            L[i] = logF(lin[i, K-2])
        else:
            L[i] = logF(lin[i, yv-1]) - logF(lin[i, yv-2])
    return L.sum()

def llf_general(theta):
    # theta: (K-1) x (1+p) -> alpha_k + beta_k per cutpoint
    M = theta.reshape(K-1, 1+p)
    def logF(v):
        return np.where(v >= 0, v - np.log1p(np.exp(-v)), np.log1p(np.exp(v)))
    def logS(v):
        return -np.log1p(np.exp(v))
    L = np.zeros(len(yarr))
    for i in range(len(yarr)):
        yv = yarr[i]
        if yv == 1:
            L[i] = logS(M[0, 0] + Xn[i] @ M[0, 1:])
        elif yv == K:
            L[i] = logF(M[K-2, 0] + Xn[i] @ M[K-2, 1:])
        else:
            a = M[yv-1, 0] + Xn[i] @ M[yv-1, 1:]
            b = M[yv-2, 0] + Xn[i] @ M[yv-2, 1:]
            L[i] = logF(a) - logF(b)
    return L.sum()

from scipy.stats import chi2
import warnings
warnings.filterwarnings("ignore")

# PO fit (reuse res.llf)
llf_po = res.llf
# general (category-specific) fit
npar = (K-1)*(1+p)
init = []
for cn in ["1/2","2/3","3/4"]:
    init.append(res.params[cn])
    init += [0.0]*p
try:
    res_gen = minimize(lambda t: -llf_general(t), init, method="L-BFGS-B",
                       options=dict(maxiter=2000))
    llf_gen = -res_gen.fun
except Exception as e:
    llf_gen = float("nan")

# Separation check: if general-model log-likelihood per obs is implausibly
# large (perfect fit), the LRT is unbounded/unreliable (quasi-separation).
sep = (not np.isnan(llf_gen)) and (llf_gen / len(yarr) > 1.0)
if np.isnan(llf_gen) or sep:
    print("\n=== Proportional-odds (parallel-lines) diagnostic ===")
    print("PO model LLF = %.4f (converged)." % llf_po)
    print("General (category-specific) model log-likelihood: %s" % llf_gen)
    print("WARNING: general model is quasi-separated (top severity categories are "
          "sparse: n=%d in cat 3, n=%d in cat 4). Its likelihood is unbounded, "
          "so the standard parallel-lines LRT is NOT reliably computable here." %
          (int((yarr==3).sum()), int((yarr==4).sum())))
    print("We therefore do NOT formally reject the proportional-odds assumption, "
          "but the single common OR should be interpreted with caution.")
    lrt = float("nan"); p_lrt = float("nan"); df_lrt = (K-1)*p
else:
    lrt = 2*(llf_gen - llf_po)
    df_lrt = (K-1)*p
    p_lrt = chi2.sf(lrt, df_lrt)
    print("\n=== Proportional-odds LRT (manual) ===")
    print("LLF_PO=%.4f LLF_general=%.4f  LRT chi2=%.4f df=%d p=%.4f" %
          (llf_po, llf_gen, lrt, df_lrt, p_lrt))

with open("results.txt", "a") as f:
    f.write("\nProportional-odds diagnostic: PO LLF=%.4f; general LLF=%s; "
            "separation_flag=%s; LRT chi2=%s df=%d p=%s\n" %
            (llf_po, llf_gen, sep, lrt, df_lrt, p_lrt))
print("Updated results.txt")
