"""
BixBench bix-3-q5 : Paroxetine 2017 RNA-seq - which tissue comparison shows negligible effects?
DESeq2 not installed -> DESeq2-style per-gene Wald test on the DESeq-NORMALIZED counts.
Response groups pooled -> 3 tissue groups of 30 samples each; 3 tissue comparisons.
DEG: padj<0.05 (BH) AND |log2FC|>0.65.  Binomial exact tests at 5% (two-sided).
"""
import pandas as pd, numpy as np
from scipy import stats
from statsmodels.stats.multitest import multipletests

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
FC, PADJ = 0.65, 0.05
xl = pd.ExcelFile(XLSX)
nc = xl.parse("NormCount", header=None)
data = nc.iloc[4:].copy(); data.columns = range(188)

raw = np.array([pd.to_numeric(data[i], errors="coerce") for i in range(2, 92)], dtype=float)  # (90,genes)
flat = raw[~np.isnan(raw)]
frac_int = float((flat == np.round(flat)).mean())
print("=== Normalization status ===")
print(f"fraction integer-like = {frac_int:.4f}  -> DESeq-NORMALIZED (non-integer): {frac_int<0.9}; "
      f"used directly, NO size-factor re-normalisation.\n")

samp = {i-2: str(nc.iloc[3, i]) for i in range(2, 92)}
def tissue(c):
    for t in ("baseline_blood", "dentate_gyrus", "final_blood"):
        if ("_"+t) in c: return t
tc = {"baseline_blood": [], "dentate_gyrus": [], "final_blood": []}
for pos, n in samp.items(): tc[tissue(n)].append(pos)
for t, v in tc.items(): print(f"{t}: {len(v)} samples")
C = raw.T                              # (genes, samples)
L = np.log2(np.where(C > 0, C, 0) + 1)
N = C.shape[0]
print("n_genes =", N, "\n")

def welch(A, B):
    nA, nB = A.shape[1], B.shape[1]
    mA, mB = A.mean(1), B.mean(1)
    vA, vB = A.var(1, ddof=1), B.var(1, ddof=1)
    se = np.sqrt(vA/nA + vB/nB)
    with np.errstate(divide="ignore", invalid="ignore"):
        t = (mB - mA) / se
    num = (vA/nA + vB/nB)**2
    den = (vA/nA)**2/(nA-1) + (vB/nB)**2/(nB-1)
    dof = num/np.where(den == 0, np.nan, den)
    p = 2*stats.t.sf(np.abs(t), dof)
    p = np.where(np.isnan(p), 1.0, p)
    return (mB - mA), p

comparisons = [
    ("C1", "Final vs Baseline Blood",        "baseline_blood", "final_blood"),
    ("C2", "Dentate gyrus vs Baseline blood", "baseline_blood", "dentate_gyrus"),
    ("C3", "Dentate gyrus vs Final blood",    "final_blood",    "dentate_gyrus"),
]
print("=== Results ===")
hdr = (f"{'Comp':<4}{'comparison':<32}{'U':>6}{'D':>6}{'tot':>7}{'%DEG':>7}"
       f"{'binom U/D p':>14}{'binom count(p=.05) p':>22}")
print(hdr); print("-"*len(hdr))
res = {}
for cid, label, ta, tb in comparisons:
    A, B = L[:, tc[ta]], L[:, tc[tb]]
    lfc, p = welch(A, B)
    padj = multipletests(p, method="fdr_bh")[1]
    U = int(np.sum((padj < PADJ) & (lfc >  FC)))
    D = int(np.sum((padj < PADJ) & (lfc < -FC)))
    tot = U + D
    pct = 100*tot/N
    # (approved) up/down balance test
    b_ud = stats.binomtest(U, tot, 0.5, alternative="two-sided").pvalue if tot else float("nan")
    # effect-magnitude test: are DEGs more than the 5% false-positive baseline?
    b_cnt = stats.binomtest(tot, N, 0.05, alternative="greater").pvalue
    res[cid] = dict(label=label, U=U, D=D, tot=tot, pct=pct, b_ud=b_ud, b_cnt=b_cnt)
    print(f"{cid:<4}{label:<32}{U:>6}{D:>6}{tot:>7}{pct:>6.1f}%{b_ud:>14.3g}{b_cnt:>22.3g}")

print("\n=== Interpretation ===")
for cid, r in res.items():
    print(f"{cid} {r['label']}: {r['tot']} DEGs ({r['pct']:.1f}% of {N}); "
          f"up/down balance p={r['b_ud']:.2g}; DEG-count vs 5% FP-rate p={r['b_cnt']:.2g}")
fewest = min(res, key=lambda c: res[c]["tot"])
print(f"\nFewest DEGs / smallest effect: {fewest} {res[fewest]['label']} ({res[fewest]['tot']} DEGs, "
      f"{res[fewest]['pct']:.1f}%)  vs  " + ", ".join(f"{c}:{res[c]['tot']}" for c in res if c != fewest))
