"""
Analysis: percentage of miRNAs with significant differential expression
between patient (P_*) and control (C_*) groups BEFORE multiple testing
correction, from data/pone.0150501.s002.xls (Table S1: Ct values for 175
miRNAs in DM1 patients and healthy controls, serum).

Method (approved by researcher):
  - Primary test : two-sided Student's t-test (scipy.stats.ttest_ind,
                   equal_var=True) on raw Ct values (Ct is already log-scale;
                   no 2^-Ct transform).
  - Significance : unadjusted (raw) two-sided p < 0.05.
  - Missing data : literal 'NAN' cells = missing; pairwise deletion within
                   each group (each group tested with its available samples).
  - Denominator  : all 175 miRNAs.
  - Sensitivity  : Welch t-test (equal_var=False), Mann-Whitney U.
"""
import sys
import numpy as np
from scipy import stats

sys.path.insert(0, '/workspace')
from xls_reader import read_xls

XLS = '/workspace/data/pone.0150501.s002.xls'
ALPHA = 0.05

# ---------- load ----------
sheets = read_xls(XLS)
assert len(sheets) == 1, 'expected a single worksheet'
rows = next(iter(sheets.values()))
title = rows[0][0]
header = rows[1][1:]                       # sample IDs
patients = [h for h in header if h.startswith('P_')]
controls = [h for h in header if h.startswith('C_')]
data_rows = rows[2:]

assert len(data_rows) == 175 and len(patients) == 10 and len(controls) == 10
assert len(set(r[0] for r in data_rows)) == 175, 'duplicate miRNA labels'

P, C, names = [], [], []
for r in data_rows:
    names.append(r[0])
    P.append([np.nan if isinstance(v, str) else float(v)
              for v in (r[1 + header.index(h)] for h in patients)])
    C.append([np.nan if isinstance(v, str) else float(v)
              for v in (r[1 + header.index(h)] for h in controls)])
P = np.array(P)
C = np.array(C)
n_missing = int(np.isnan(P).sum() + np.isnan(C).sum())

# ---------- tests ----------
def clean(x):
    return x[~np.isnan(x)]

def pvalues(kind):
    out = []
    for i in range(len(names)):
        a, b = clean(P[i]), clean(C[i])
        if kind == 'student':
            out.append(stats.ttest_ind(a, b, equal_var=True).pvalue)
        elif kind == 'welch':
            out.append(stats.ttest_ind(a, b, equal_var=False).pvalue)
        elif kind == 'mw':
            out.append(stats.mannwhitneyu(a, b, alternative='two-sided').pvalue)
    return np.array(out)

p_student = pvalues('student')
p_welch = pvalues('welch')
p_mw = pvalues('mw')

# ---------- results table ----------
table = []
for i, nm in enumerate(names):
    table.append({
        'miRNA': nm,
        'n_patient': int((~np.isnan(P[i])).sum()),
        'n_control': int((~np.isnan(C[i])).sum()),
        'mean_Ct_patient': round(float(np.nanmean(P[i])), 4),
        'mean_Ct_control': round(float(np.nanmean(C[i])), 4),
        'p_student': p_student[i],
        'p_welch': p_welch[i],
        'p_mannwhitney': p_mw[i],
        'significant_student_p0.05': bool(p_student[i] < ALPHA),
    })

with open('/workspace/results_table.csv', 'w') as f:
    f.write('miRNA,n_patient,n_control,mean_Ct_patient,mean_Ct_control,'
            'p_student,p_welch,p_mannwhitney,significant_student_p0.05\n')
    for t in table:
        f.write(f"{t['miRNA']},{t['n_patient']},{t['n_control']},"
                f"{t['mean_Ct_patient']},{t['mean_Ct_control']},"
                f"{t['p_student']:.6g},{t['p_welch']:.6g},"
                f"{t['p_mannwhitney']:.6g},{t['significant_student_p0.05']}\n")

# ---------- summary ----------
n_sig = int((p_student < ALPHA).sum())
n_w = int((p_welch < ALPHA).sum())
n_m = int((p_mw < ALPHA).sum())
print('=' * 72)
print('Input :', XLS)
print('Sheet : RAW DATA |', title.strip())
print('miRNAs: %d (unique) | patients: %d (%s..%s) | controls: %d (%s..%s)'
      % (len(names), len(patients), patients[0], patients[-1],
         len(controls), controls[0], controls[-1]))
print('Ct values: %d numeric, range %.4f-%.4f | missing "NAN" cells: %d'
      % (int((~np.isnan(P)).sum() + (~np.isnan(C)).sum()),
         float(np.nanmin(np.concatenate([P.ravel(), C.ravel()]))),
         float(np.nanmax(np.concatenate([P.ravel(), C.ravel()]))), n_missing))
print('-' * 72)
print('PRIMARY  two-sided Student t-test on Ct, raw p < 0.05:')
print('  significant miRNAs : %d / %d' % (n_sig, len(names)))
print('  FINAL PERCENTAGE   : %.2f%%' % (100.0 * n_sig / len(names)))
print('SENSITIVITY (same data, same missingness handling):')
print('  Welch t-test       : %d / %d = %.2f%%' % (n_w, len(names), 100.0 * n_w / len(names)))
print('  Mann-Whitney U     : %d / %d = %.2f%%' % (n_m, len(names), 100.0 * n_m / len(names)))
print('-' * 72)
print('Top 10 by p_student (smallest first):')
order = np.argsort(p_student)
for i in order[:10]:
    print('  %-16s p_student=%.3g  p_welch=%.3g  p_mw=%.3g'
          % (names[i], p_student[i], p_welch[i], p_mw[i]))
print('Full per-miRNA table written to /workspace/results_table.csv')
print('=' * 72)
