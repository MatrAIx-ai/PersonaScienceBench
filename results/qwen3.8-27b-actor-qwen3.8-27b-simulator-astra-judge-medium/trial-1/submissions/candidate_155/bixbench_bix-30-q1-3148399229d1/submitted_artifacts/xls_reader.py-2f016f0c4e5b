"""Minimal pure-Python reader for legacy .xls (OLE2/CFB + BIFF8)."""
import struct

FREESECT = 0xFFFFFFFF
ENDOFCHAIN = 0xFFFFFFFE

def _le_u16(b, o): return struct.unpack_from('<H', b, o)[0]
def _le_u32(b, o): return struct.unpack_from('<I', b, o)[0]

class OleFile:
    def __init__(self, path):
        self.data = open(path, 'rb').read()
        d = self.data
        assert d[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1', 'not OLE2'
        self.major = _le_u16(d, 0x1A)
        self.ss = 1 << _le_u16(d, 0x1E)
        self.mss = 1 << _le_u16(d, 0x20)
        self.first_dir = _le_u32(d, 0x30)
        self.mini_cutoff = _le_u32(d, 0x38)
        self.first_minifat = _le_u32(d, 0x3C)
        self.minifat_count = _le_u32(d, 0x40)
        self.difat = list(struct.unpack_from('<109I', d, 0x4C))
        self._build_fat()
        self._read_directory()
        self._read_minifat()
        self._read_root()

    def _sector(self, sid):
        off = 512 + sid * self.ss
        return self.data[off:off + self.ss]

    def _build_fat(self):
        self.fat = []
        for s in self.difat:
            if s in (ENDOFCHAIN, FREESECT):
                continue
            sec = self._sector(s)
            self.fat.extend(struct.unpack_from('<%dI' % (self.ss // 4), sec, 0))

    def _chain(self, start):
        out = []
        sid = start
        seen = set()
        while sid not in (ENDOFCHAIN, FREESECT) and sid not in seen:
            seen.add(sid)
            out.append(sid)
            sid = self.fat[sid] if sid < len(self.fat) else ENDOFCHAIN
        return out

    def _read_directory(self):
        blob = b''.join(self._sector(s) for s in self._chain(self.first_dir))
        self.entries = []
        for i in range(len(blob) // 128):
            e = blob[i * 128:(i + 1) * 128]
            nsize = _le_u16(e, 0x40)
            name = e[:max(0, nsize - 2)].decode('utf-16-le', 'replace') if nsize > 0 else ''
            self.entries.append({
                'name': name, 'type': e[0x42],
                'start': _le_u32(e, 0x74),
                'size': _le_u32(e, 0x78) if self.major == 3 else struct.unpack_from('<Q', e, 0x78)[0]})

    def _read_minifat(self):
        self.minifat = []
        if self.minifat_count:
            blob = b''.join(self._sector(s) for s in self._chain(self.first_minifat))
            self.minifat = list(struct.unpack_from('<%dI' % (len(blob) // 4), blob, 0))

    def _read_root(self):
        root = self.entries[0]
        assert root['type'] == 5, 'entry 0 is not root'
        self.root_stream = b''.join(self._sector(s) for s in self._chain(root['start']))[:root['size']]

    def get_stream(self, name):
        for e in self.entries:
            if e['name'] == name and e['type'] == 2:
                size = e['size']
                if size < self.mini_cutoff:
                    out, sid, seen = [], e['start'], set()
                    while sid not in (ENDOFCHAIN, FREESECT) and sid not in seen:
                        seen.add(sid)
                        off = sid * self.mss
                        out.append(self.root_stream[off:off + self.mss])
                        sid = self.minifat[sid] if sid < len(self.minifat) else ENDOFCHAIN
                    return b''.join(out)[:size]
                return b''.join(self._sector(s) for s in self._chain(e['start']))[:size]
        raise KeyError(name)

    def list_streams(self):
        return [(e['name'], e['type'], e['size']) for e in self.entries]

def _read_sst_chars(buf, pos, cch, compressed):
    """Read up to cch chars from buf at pos. Returns (chars, new_pos, remaining)."""
    out = []
    n = cch
    while n > 0 and pos < len(buf):
        if compressed:
            b = buf[pos:pos + n]
            out.append(b.decode('cp1252', 'replace'))
            pos += len(b)
            n = 0
        else:
            take = max(min(n, (len(buf) - pos) // 2), 0)
            if take:
                out.append(buf[pos:pos + 2 * take].decode('utf-16-le', 'replace'))
                pos += 2 * take
            n -= take
    return ''.join(out), pos, n

def _parse_sst(sst_data, continues):
    """Parse SST. NOTE: some writers (e.g. old Mac Excel) swap the two count
    fields; we therefore parse strings until the data is exhausted and verify
    exact consumption, rather than trusting the count fields."""
    total1, total2 = _le_u32(sst_data, 0), _le_u32(sst_data, 4)
    strings = []
    cur = sst_data
    pos = 8
    ci = 0
    cp = 0

    def advance():
        nonlocal cur, pos, ci, cp
        if ci >= len(continues):
            raise ValueError('SST: missing CONTINUE record')
        cur = continues[ci]
        ci += 1
        cp = 0

    while pos < len(cur) or (ci < len(continues) and pos >= len(cur)):
        if pos >= len(cur):
            advance()
            grbit = cur[cp]; cp += 1
            cch = _le_u16(cur, cp); cp += 2
            flags = grbit
            p = cp
        else:
            cch = _le_u16(cur, pos); pos += 2
            flags = cur[pos]; pos += 1
            p = pos
        if flags & 0x04:
            p += 4 * _le_u16(cur, p)
        if flags & 0x08:
            p += 4 + _le_u32(cur, p)
        pos = p
        chars, pos, remaining = _read_sst_chars(cur, pos, cch, not (flags & 1))
        while remaining > 0:
            advance()
            grbit = cur[cp]; cp += 1
            chars, cp, remaining = _read_sst_chars(cur, cp, remaining, not (grbit & 1))
        strings.append(chars)
    expected = max(total1, total2)
    if len(strings) not in (total1, total2, expected):
        print('SST WARNING: parsed %d strings, header says %d/%d'
              % (len(strings), total1, total2))
    return strings

def _rk_to_float(rk):
    if rk & 0x02:
        return float(struct.unpack('<h', struct.pack('<H', rk & 0xFFFE))[0])
    if rk & 0x01:
        return struct.unpack('<i', struct.pack('<I', rk & 0xFFFFFFFC))[0] / 100.0
    return struct.unpack('<d', struct.pack('<8B', 0, 0, 0, 0,
                   *(rk & 0xFFFFFFFC).to_bytes(4, 'little')))[0]

def read_xls(path):
    ole = OleFile(path)
    streams = ole.list_streams()
    wb_name = None
    for name, t, sz in streams:
        if t == 2 and name.lower() in ('workbook', 'book'):
            wb_name = name
            break
    if wb_name is None:
        raise KeyError('no Workbook stream; streams=%r' % streams)
    wb = ole.get_stream(wb_name)
    records = []
    pos = 0
    while pos + 4 <= len(wb):
        rtype, rlen = _le_u16(wb, pos), _le_u16(wb, pos + 2)
        records.append((rtype, wb[pos + 4:pos + 4 + rlen]))
        pos += 4 + rlen
    sheets = []
    sst = []
    cur = None
    grids, order = {}, []
    in_global = True
    i = 0
    while i < len(records):
        rtype, data = records[i]
        if rtype == 0x0809:  # BOF
            if in_global:
                in_global = False
            else:
                if sheets:
                    cur = sheets.pop(0)
                    grids[cur] = {}
                    order.append(cur)
        elif rtype == 0x0085:  # BoundSheet8
            cch, flags = _le_u16(data, 8), data[9]
            p = 10
            if flags & 0x04:
                p += 4 * _le_u16(data, p)
            if flags & 0x08:
                p += 4 + _le_u32(data, p)
            nm = (data[p:p + 2 * cch].decode('utf-16-le', 'replace') if flags & 1
                  else data[p:p + cch].decode('cp1252', 'replace'))
            sheets.append(nm)
        elif rtype == 0x00FC:  # SST
            conts = []
            j = i + 1
            while j < len(records) and records[j][0] == 0x003C:
                conts.append(records[j][1])
                j += 1
            sst = _parse_sst(data, conts)
            i = j - 1
        elif cur is not None:
            g = grids[cur]
            if rtype == 0x0203:  # Number
                g[(_le_u16(data, 0), _le_u16(data, 2))] = struct.unpack('<d', data[6:14])[0]
            elif rtype == 0x00FD:  # LabelSst
                g[(_le_u16(data, 0), _le_u16(data, 2))] = sst[_le_u32(data, 6)]
            elif rtype == 0x027E:  # RK
                g[(_le_u16(data, 0), _le_u16(data, 2))] = _rk_to_float(_le_u32(data, 6))
            elif rtype == 0x00BD:  # MulRk
                row, c0, c1 = _le_u16(data, 0), _le_u16(data, 2), _le_u16(data, len(data) - 2)
                p = 4
                for c in range(c0, c1 + 1):
                    g[(row, c)] = _rk_to_float(_le_u32(data, p + 2))
                    p += 6
            elif rtype == 0x0006:  # Formula
                row, col, opt = _le_u16(data, 0), _le_u16(data, 2), data[14]
                if opt & 0x01:
                    g[(row, col)] = '#ERR'
                elif opt & 0x02:
                    g[(row, col)] = bool(data[6])
                elif opt & 0x04:
                    slen = _le_u16(data, 15)
                    g[(row, col)] = data[17:17 + slen].decode('cp1252', 'replace')
                else:
                    g[(row, col)] = struct.unpack('<d', data[6:14])[0]
            elif rtype == 0x0205:  # BoolErr
                g[(_le_u16(data, 0), _le_u16(data, 2))] = (bool(data[6]) if data[7] else '#ERR')
        i += 1
    out = {}
    for name in order:
        g = grids[name]
        if not g:
            out[name] = []
            continue
        maxr = max(r for r, c in g)
        maxc = max(c for r, c in g)
        out[name] = [[g.get((r, c)) for c in range(maxc + 1)] for r in range(maxr + 1)]
    return out

if __name__ == '__main__':
    import sys
    path = sys.argv[1] if len(sys.argv) > 1 else '/workspace/data/pone.0150501.s002.xls'
    ole = OleFile(path)
    print('streams:', ole.list_streams())
    sheets = read_xls(path)
    for name, rows in sheets.items():
        print('SHEET %r: %d rows x %d cols' % (name, len(rows),
              max((len(r) for r in rows), default=0)))
        for r in rows[:5]:
            print('  ', r[:12])
