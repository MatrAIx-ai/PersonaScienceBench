#!/usr/bin/env python3
"""
KEGG over-representation analysis (ORA) pipeline for the three P. aeruginosa
quorum-sensing mutant comparisons (Strain 97/98/99 vs wildtype Strain 1).

Steps
  1. Load DESeq2 results (.rds) -> data frame [baseMean, log2FoldChange, lfcSE, stat, pvalue, padj]
  2. Filter: pvalue < 0.05 AND log2FoldChange < -1.5  (significant DOWN-regulated, mutant vs WT)
  3. Map gene IDs (PA14_XXXXX) to KEGG organism 'psa' (Pseudomonas aeruginosa PAO1)
  4. Per comparison: ORA = right-tailed Fisher/hypergeometric test vs background, BH-FDR adjust
  5. 'Consistently enriched' = same KEGG pathway with adjusted p < 0.05 in ALL THREE comparisons

DATA REQUIREMENT (Step 3): a KEGG pathway->gene mapping for organism 'psa' AND a
PA14->psa gene-ID (or KO) mapping. In a provisioned environment this is obtained via
KEGG (https://rest.kegg.jp) / clusterProfiler. In THIS sandbox there is no network and
no local KEGG data, so Step 3 cannot be completed here (disclosed in the report).
"""
import gzip, struct, re, json, math, os, sys
from math import lgamma

G = 5828
COLS = ['baseMean','log2FoldChange','lfcSE','stat','pvalue','padj']
FILES = {'97':'data/res_1vs97.rds','98':'data/res_1vs98.rds','99':'data/res_1vs99.rds'}

# ---------- load DESeq2 results (hand parser; use readRDS in R provisioned env) ----------
def load_results(path):
    b = gzip.open(path,'rb').read()
    i=0; cols=[]
    while True:
        i=b.find(b'\x0e\x00\x00\x16\xc4', i)   # REALSXP tag + header, len 0x16c4=5828
        if i==-1: break
        cols.append(i); i+=1
    C={COLS[k]:[struct.unpack('<d',b[t+6+j*8:t+6+j*8+8])[0] for j in range(G)] for k,t in enumerate(cols[:6])}
    ids=[x.decode() for x in re.findall(rb'PA14_\d{5}', b)]
    return ids, C

def filter_down(ids, C, pcut=0.05, lfcut=-1.5):
    return [ids[i] for i in range(G) if C['pvalue'][i]<pcut and C['log2FoldChange'][i]<lfcut]

# ---------- ORA: right-tailed hypergeometric + BH ----------
def hypergeom_right(K, N, n, k):
    # P(X >= k), X ~ Hypergeometric(N, K, n)
    if k<=0: return 1.0
    if k>K or k>n: return 0.0
    def lcomb(a,b):
        if b<0 or b>a: return -1e300
        return lgamma(a+1)-lgamma(b+1)-lgamma(a-b+1)
    lnK_N_n = lcomb(N,K)+lcomb(N-K,n-K)  # not used directly; compute tail sum
    tot=0.0
    lo=max(0, n+K-N)
    for x in range(k, min(n,K)+1):
        tot += math.exp(lcomb(K,x)+lcomb(N-K,n-x)-lcomb(N,n))
    return min(1.0, tot)

def bh_adjust(pvals):
    m=len(pvals); order=sorted(range(m), key=lambda i:pvals[i])
    adj=[0.0]*m
    prev=1.0
    for r in range(m,0,-1):
        i=order[r-1]
        val=pvals[i]*m/r
        prev=min(prev,val); adj[i]=min(1.0,prev)
    return adj

def ora(gene_list, background, pathway2genes):
    """Return {pathway: (raw_p, adj_p, overlap)} for pathways with >=1 gene in background."""
    bg=set(background); lst=set(gene_list)
    results={}
    for pw, genes in pathway2genes.items():
        K=len(bg & set(genes))          # pathway genes in background
        if K==0: continue
        n=len(lst); k=len(lst & set(genes))
        if k==0: 
            results[pw]=(1.0,0); continue
        p=hypergeom_right(K, len(bg), n, k)
        results[pw]=(p,k)
    pvals={pw:v[0] for pw,v in results.items()}
    adj=bh_adjust(list(pvals.values()))
    out={}
    for pw,v in results.items():
        out[pw]=(pvals[pw], adj[list(pvals.values()).index(pvals[pw])], v[1])
    return out

def main():
    os.chdir('/workspace')
    print("=== Step 1-2: load + filter (pvalue<0.05 & log2FC<-1.5) ===")
    filtered={}; counts={}
    for s,f in FILES.items():
        ids,C=load_results(f)
        fl=filter_down(ids,C)
        filtered[s]=fl; counts[s]=len(fl)
        print(f"  Strain {s} vs 1: {len(fl)} down-regulated genes")
    json.dump(filtered, open('filtered_genes.json','w'), indent=1)

    print("\n=== Step 3: KEGG mapping (organism 'psa') ===")
    # Look for a local KEGG psa pathway->gene mapping + PA14->psa ID map.
    kmap=None
    for cand in ['kegg_psa_pathways.json','kegg_psa.json','psa_pathways.json','kegg_mapping.json']:
        if os.path.exists(cand):
            kmap=json.load(open(cand)); print("  loaded local KEGG map:",cand); break
    if kmap is None:
        print("  *** NO local KEGG psa mapping found and NO network access in this sandbox.")
        print("  *** Step 3 (PA14->KEGG psa) and Steps 4-5 (ORA) CANNOT be executed here.")
        print("  *** In a provisioned env, obtain via: KEGG REST (rest.kegg.jp/link/psa) or")
        print("      clusterProfiler::enrichKEGG (R). See kegg_ora_analysis.R.")
        return
    # (would continue with ORA if kmap present)
    full_background=list(load_results(FILES['97'])[0])
    for s in FILES:
        res=ora(filtered[s], full_background, kmap)
        sig={pw:v for pw,v in res.items() if v[1]<0.05}
        print(f"  Strain {s}: {len(sig)} pathways adj.p<0.05")
    # consistent
    s97=ora(filtered['97'],full_background,kmap); s98=ora(filtered['98'],full_background,kmap); s99=ora(filtered['99'],full_background,kmap)
    common=set([pw for pw,v in s97.items() if v[1]<0.05]) & set([pw for pw,v in s98.items() if v[1]<0.05]) & set([pw for pw,v in s99.items() if v[1]<0.05])
    print("  Consistent (adj.p<0.05 in all 3):", sorted(common))

if __name__=='__main__':
    main()

