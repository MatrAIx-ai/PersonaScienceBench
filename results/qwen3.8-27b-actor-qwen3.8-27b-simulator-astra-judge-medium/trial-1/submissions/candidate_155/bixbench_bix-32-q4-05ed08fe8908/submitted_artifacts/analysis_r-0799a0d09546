#!/usr/bin/env Rscript
# KEGG ORA for P. aeruginosa QS mutants (Strain 97/98/99 vs WT Strain 1).
# Intended to run in a provisioned environment (R + BiocManager + clusterProfiler + KEGG access).
#
#   library(clusterProfiler); library(org.Ps.eg.db)   # org.Ps.eg = P. aeruginosa PAO1 annotation
#   KEGG organism code: "psa"
#
# NOTE on ID mapping: row names are PA14_XXXXX (PA14 strain). KEGG 'psa' is PAO1.
#   Map PA14 -> PAO1/pa KEGG gene IDs (or KOs) via org.Ps.eg.db / a PA14 annotation
#   carrying KEGG IDs, then run enrichKEGG. Document the exact mapping used.

library(clusterProfiler)
comp <- c("97"="data/res_1vs97.rds","98"="data/res_1vs98.rds","99"="data/res_1vs99.rds")

# 1) load + filter: pvalue < 0.05 AND log2FoldChange < -1.5  (down in mutant vs WT)
lists <- list(); bg <- NULL
for (nm in names(comp)) {
  res <- readRDS(comp[nm])                 # DESeqResults data frame
  d <- res[res$pvalue < 0.05 & res$log2FoldChange < -1.5, ]
  lists[[nm]] <- rownames(d)
  if (is.null(bg)) bg <- rownames(res)     # 5828-gene tested universe
  cat(sprintf("Strain %s vs 1: %d down-regulated genes (p<0.05 & lfc<-1.5)\n", nm, nrow(d)))
}

# 2) map PA14 -> KEGG psa gene IDs (EXAMPLE using org.Ps.eg.db; adapt to PA14 annotation)
#    bg_gene  <- mapIds(org.Ps.eg, keys=bg,     column="GENEID", keytype=... )
#    (replace with the actual PA14->psa/KO mapping you use; state it in the report)

# 3) ORA per comparison, BH-adjusted (enrichKEGG does Fisher/hypergeometric + BH internally)
ora <- lapply(names(lists), function(nm)
  enrichKEGG(gene   = lists[[nm]],
             organism = "psa",
             pvalueCutoff = 1,      # keep all, inspect padj
             readable = TRUE))

# 4) consistent enrichment: same KEGG pathway with padj < 0.05 in ALL THREE
hit <- lapply(ora, function(e) e$geneID)  # placeholder; use e$KEGG / e$pathwayID + e$padj
tab <- do.call(rbind, lapply(ora, function(e) data.frame(pathway=e$description,
                                                          padj=e$padj, KEGG=e$KEGG)))
