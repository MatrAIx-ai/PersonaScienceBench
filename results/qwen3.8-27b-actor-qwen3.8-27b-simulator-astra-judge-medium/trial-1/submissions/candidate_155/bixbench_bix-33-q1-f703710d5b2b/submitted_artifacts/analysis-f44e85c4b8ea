#!/usr/bin/env python3
"""
Analysis: Which immune cell type has the highest number of significantly
differentially expressed genes after AAV9 mini-dystrophin treatment?

Input: Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx
Method: Count genes with p_val_adj < 0.05 (BH-corrected) per cell type sheet.
Significance: p_val_adj < 0.05 only (no additional |avg_log2FC| threshold).
Comparison: Post (after AAV9 mini-dystrophin treatment) vs Pre (before treatment).
"""

import openpyxl
import pandas as pd
import sys

XLSX_PATH = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
P_ADJ_THRESHOLD = 0.05

# Non-immune cell types to exclude from the "immune cell type" ranking
NON_IMMUNE = {"Eryth", "Platelet"}

def main():
    wb = openpyxl.load_workbook(XLSX_PATH, read_only=True)
    
    results = []
    for sheet_name in wb.sheetnames:
        ws = wb[sheet_name]
        rows = list(ws.iter_rows(min_row=2, values_only=True))  # skip header row
        if not rows:
            continue
        df = pd.DataFrame(rows, columns=["gene", "p_val", "avg_log2FC", "pct1", "pct2", "p_val_adj"])
        
        # Ensure numeric types
        df["p_val_adj"] = pd.to_numeric(df["p_val_adj"], errors="coerce")
        df["p_val"] = pd.to_numeric(df["p_val"], errors="coerce")
        df["avg_log2FC"] = pd.to_numeric(df["avg_log2FC"], errors="coerce")
        
        n_total = len(df)
        n_sig = int((df["p_val_adj"] < P_ADJ_THRESHOLD).sum())
        n_up = int(((df["p_val_adj"] < P_ADJ_THRESHOLD) & (df["avg_log2FC"] > 0)).sum())
        n_down = int(((df["p_val_adj"] < P_ADJ_THRESHOLD) & (df["avg_log2FC"] < 0)).sum())
        is_immune = sheet_name not in NON_IMMUNE
        
        results.append({
            "cell_type": sheet_name,
            "immune": is_immune,
            "total_genes_tested": n_total,
            "sig_DEGs_padj<0.05": n_sig,
            "upregulated": n_up,
            "downregulated": n_down,
        })
    
    wb.close()
    
    df_results = pd.DataFrame(results)
    
    # Print full table
    print("=" * 85)
    print("DEG Analysis: Post (after AAV9 mini-dystrophin) vs Pre (before treatment)")
    print(f"Significance threshold: p_val_adj < {P_ADJ_THRESHOLD} (BH-corrected)")
    print("=" * 85)
    print()
    
    # Sort by sig_DEGs descending
    df_sorted = df_results.sort_values("sig_DEGs_padj<0.05", ascending=False).reset_index(drop=True)
    df_sorted.index = df_sorted.index + 1  # 1-based rank
    
    print(f"{'Rank':<5} {'Cell Type':<22} {'Immune':<8} {'Total':>7} {'Sig DEGs':>10} {'Up':>6} {'Down':>6}")
    print("-" * 70)
    for idx, row in df_sorted.iterrows():
        immune_str = "YES" if row["immune"] else "NO"
        print(f"{idx:<5} {row['cell_type']:<22} {immune_str:<8} {row['total_genes_tested']:>7} {row['sig_DEGs_padj<0.05']:>10} {row['upregulated']:>6} {row['downregulated']:>6}")
    
    print()
    print("=" * 85)
    
    # Rank among immune cell types only
    immune_df = df_sorted[df_sorted["immune"]].reset_index(drop=True)
    immune_df.index = immune_df.index + 1
    
    print("\nRANKING AMONG IMMUNE CELL TYPES ONLY (excluding Eryth, Platelet):")
    print(f"{'Rank':<5} {'Cell Type':<22} {'Sig DEGs':>10} {'Up':>6} {'Down':>6}")
    print("-" * 50)
    for idx, row in immune_df.iterrows():
        print(f"{idx:<5} {row['cell_type']:<22} {row['sig_DEGs_padj<0.05']:>10} {row['upregulated']:>6} {row['downregulated']:>6}")
    
    # Final answer
    top = immune_df.iloc[0]
    print()
    print("=" * 85)
    print(f"FINAL ANSWER:")
    print(f"  The immune cell type with the highest number of significantly")
    print(f"  differentially expressed genes after AAV9 mini-dystrophin treatment")
    print(f"  is: {top['cell_type']}")
    print(f"  with {int(top['sig_DEGs_padj<0.05'])} significant DEGs (p_val_adj < 0.05)")
    print(f"  ({int(top['upregulated'])} upregulated, {int(top['downregulated'])} downregulated)")
    print("=" * 85)
    
    # Also save results to CSV for traceability
    df_sorted.to_csv("deg_counts_by_cell_type.csv", index=False)
    print("\nResults saved to: deg_counts_by_cell_type.csv")

if __name__ == "__main__":
    main()
