"""
BixBench bix-37-q2
Question: What is the base protein level of ENO1 in normal samples
          according to the proteomic data? Round to 3 significant figures.

Approach:
  - Open 'data/Proteomic_data .xlsx', sheet 'Tumor vs Normal'.
  - Locate the row where the 'gene' column == 'ENO1' (case-insensitive match,
    then verify exact 'ENO1'); cross-check against Description GN=ENO1 and
    protein P06733.
  - Read the 'Normal' column value (base protein level in normal samples).
  - Round to 3 significant figures and print.
"""
import math
import openpyxl

XLSX = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"
GENE = "ENO1"


def round_sig(x, sig=3):
    """Round x to `sig` significant figures."""
    if x == 0:
        return 0.0
    return round(x, -int(math.floor(math.log10(abs(x)))) + (sig - 1))


def main():
    wb = openpyxl.load_workbook(XLSX, data_only=True)
    ws = wb[SHEET]

    # Map header names -> column index (row 1)
    header = {}
    for c in range(1, ws.max_column + 1):
        name = ws.cell(row=1, column=c).value
        if name is not None:
            header[str(name).strip()] = c
    col_gene = header["gene"]
    col_desc = header["Description"]
    col_prot = header["protein"]
    col_normal = header["Normal"]

    # Locate ENO1 rows (case-insensitive), then require exact 'ENO1'
    matches = []
    for r in range(2, ws.max_row + 1):
        g = ws.cell(row=r, column=col_gene).value
        if g is not None and str(g).strip().upper() == GENE:
            matches.append(r)

    print(f"Rows matching gene=='{GENE}' (case-insensitive): {matches}")
    if len(matches) != 1:
        raise SystemExit(f"Expected exactly 1 ENO1 row, found {len(matches)}")
    r = matches[0]

    gene = ws.cell(row=r, column=col_gene).value
    desc = ws.cell(row=r, column=col_desc).value
    prot = ws.cell(row=r, column=col_prot).value
    normal = ws.cell(row=r, column=col_normal).value

    # Cross-check identity
    assert str(gene).strip() == "ENO1", f"gene not exact ENO1: {gene!r}"
    assert "GN=ENO1" in str(desc), f"Description missing GN=ENO1: {desc!r}"
    assert prot == "P06733", f"Unexpected UniProt: {prot!r}"

    print(f"ENO1 row (Excel row {r}):")
    print(f"  protein   = {prot}")
    print(f"  Description = {desc}")
    print(f"  gene      = {gene}")
    print(f"  Normal (raw)   = {normal}")

    rounded = round_sig(normal, 3)
    print(f"  Normal (3 sig figs) = {rounded}")
    print(f"  Normal (3 sig figs, sci) = {rounded:.3g}")

    return rounded


if __name__ == "__main__":
    main()
