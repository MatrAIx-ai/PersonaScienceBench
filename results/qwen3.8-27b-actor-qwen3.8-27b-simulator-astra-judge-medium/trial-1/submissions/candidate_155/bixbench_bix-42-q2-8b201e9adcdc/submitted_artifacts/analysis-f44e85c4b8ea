"""
BixBench bix-42-q2: Skewness of the RNA expression distribution (TCGA COAD).

Question: What is the skewness of the distribution of RNA expression data
(highly/minimally right or left skewed, or approximately normal)?

Method (approved plan):
- Read data/COAD__geneExp.xls (tab-delimited: 20,502 genes x 328 samples).
- Pool all gene-by-sample values into a single vector (n = 6,724,656).
- Primary: sample skewness coefficient g1 = m3/m2^1.5 via scipy.stats.skew(bias=True)
  on the raw (as-shipped, linear normalized) values.
- Sensitivity: log1p-transformed pooled values; raw values with zeros excluded.
- Data are NOT log-transformed (continuous, min 0, max ~1.34e6, 15.2% exact zeros).
"""
import numpy as np
import pandas as pd
from scipy import stats

SRC = "data/COAD__geneExp.xls"

# --- Load: genes = rows, samples = columns, first col = GeneSymbol ---
df = pd.read_csv(SRC, sep="\t", low_memory=False)
mat = df.drop(columns=["GeneSymbol"]).to_numpy(dtype="float64")
r = mat.ravel()

n = r.size
mean, median, vmin, vmax = r.mean(), np.median(r), r.min(), r.max()
n_zeros = int((r == 0).sum())

# --- Primary: raw-scale pooled skewness ---
skew_raw = stats.skew(r, bias=True)            # moment coefficient g1
skew_raw_adj = stats.skew(r, bias=False)       # adjusted (n-1) form, sensitivity
# --- Sensitivity: log1p scale ---
skew_log1p = stats.skew(np.log1p(r), bias=True)
skew_log1p_nz = stats.skew(np.log1p(r[r > 0]), bias=True)
# --- Sensitivity: raw scale, zeros excluded ---
skew_raw_nz = stats.skew(r[r > 0], bias=True)

# --- Compact results table ---
print("=" * 62)
print("RNA expression skewness - TCGA COAD (data/COAD__geneExp.xls)")
print("=" * 62)
print(f"genes x samples          : {df.shape[0]} x {mat.shape[1]}")
print(f"n (pooled gene-sample)   : {n:,}")
print(f"mean / median            : {mean:,.2f} / {median:,.2f}")
print(f"min / max                : {vmin:.4f} / {vmax:,.2f}")
print(f"zeros                    : {n_zeros:,} ({100*n_zeros/n:.2f}%)")
print("-" * 62)
print(f"skew_raw (PRIMARY)       : {skew_raw:+.4f}")
print(f"skew_raw (bias=False)    : {skew_raw_adj:+.4f}")
print(f"skew_raw_nozeros         : {skew_raw_nz:+.4f}")
print(f"skew_log1p               : {skew_log1p:+.4f}")
print(f"skew_log1p_nozeros       : {skew_log1p_nz:+.4f}")
print("=" * 62)

if skew_raw > 1:
    verdict = "highly right-skewed"
elif 0.5 < skew_raw <= 1:
    verdict = "moderately right-skewed"
elif abs(skew_raw) <= 0.5:
    verdict = "approximately normal"
elif -1 <= skew_raw < -0.5:
    verdict = "moderately left-skewed"
else:
    verdict = "highly left-skewed"
print(f"VERDICT (raw scale)      : {verdict} (g1 = {skew_raw:+.2f})")
print(f"Secondary (log1p scale)  : g1 = {skew_log1p:+.2f} -> "
      + ("slightly left-skewed" if -1 < skew_log1p < -0.1 else "approximately normal"))
