"""
Complete analysis: CBD/cisplatin (Group 9) vs DMSO (Group 3)
DE + GSEA with GO_Biological_Process_2021 (approximated)
"""
import pandas as pd, numpy as np, json
from scipy import stats
import warnings, time
warnings.filterwarnings('ignore')
t0 = time.time()

# === PART 1: Data & DE ===
counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
counts_np = counts.values.astype(float)
layout = pd.read_csv('data/sample_layout.csv')
sample_to_group = {r['SampleID'].replace('-','_'): r['Group'] for _,r in layout.iterrows()}
ctrl = [s for s,g in sample_to_group.items() if g=='DMSO']
treat = [s for s,g in sample_to_group.items() if g=='Cisplatin_IC50_CBD_IC50']

# Median-of-ratios
log_mat = np.full_like(counts_np, -np.inf)
nz = counts_np > 0
log_mat[nz] = np.log(counts_np[nz])
geo_mean = np.exp(np.mean(log_mat, axis=1))
valid = geo_mean > 0
sf = np.median(counts_np[valid,:] / geo_mean[valid].reshape(-1,1), axis=0)
norm = counts_np / sf[None,:]

col_list = counts.columns.tolist()
ci = [col_list.index(s) for s in ctrl]
ti = [col_list.index(s) for s in treat]
ln = np.log2(norm + 1)
log2fc = ln[:,ti].mean(axis=1) - ln[:,ci].mean(axis=1)
_, p_val = stats.ttest_ind(ln[:,ti], ln[:,ci], axis=1, equal_var=False)
p_val = np.nan_to_num(p_val, nan=1.0)

n = len(p_val); order = np.argsort(p_val); ps = p_val[order]
bh = np.minimum.accumulate((ps*n/np.arange(1,n+1))[::-1])[::-1]
adj_p = np.empty(n); adj_p[order] = np.clip(bh,0,1)

mapping = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t')
e2s = dict(zip(mapping['ENSG'], mapping['gene_name']))
syms, l2f = [], []
for i, e in enumerate(counts.index):
    s = e2s.get(e)
    if s is not None and pd.notna(s) and str(s).strip():
        syms.append(str(s).strip().replace(' ','_'))
        l2f.append(log2fc[i])
rnk = pd.DataFrame({'name':syms,'rank':l2f})
rnk.to_csv('/workspace/ranked_gene_list.csv', index=False)

# === PART 2: GSEA ===
with open('/workspace/go_bp_sets.json') as f:
    go_sets = json.load(f)

rnk_sorted = rnk.sort_values('rank', ascending=False).reset_index(drop=True)
names = rnk_sorted['name'].values
vals = rnk_sorted['rank'].values
n_genes = len(names)
n_permuts = 1000
np.random.seed(42)

results = []
for term, gene_list in go_sets.items():
    gset = set(gene_list)
    hit_mask = np.array([g in gset for g in names])
    n_hit = hit_mask.sum()
    n_miss = n_genes - n_hit
    if n_hit == 0 or n_miss == 0:
        continue
    step = np.where(hit_mask, (1.0/n_hit)*np.abs(vals), -1.0/n_miss)
    running = np.cumsum(step)
    es_obs = max(running.max(), running.min(), key=abs)
    es_perms = np.empty(n_permuts)
    for p in range(n_permuts):
        pv = np.random.permutation(vals)
        sp = np.where(hit_mask, (1.0/n_hit)*np.abs(pv), -1.0/n_miss)
        rp = np.cumsum(sp)
        es_perms[p] = max(rp.max(), rp.min(), key=abs)
    p_val_gsea = (np.sum(np.abs(es_perms) >= np.abs(es_obs)) + 1) / (n_permuts + 1)
    results.append({'term':term,'ES':es_obs,'p_value':p_val_gsea,
                    'n_hit':n_hit,'n_total':len(gset),
                    'direction':'up' if es_obs>0 else 'down'})

res = pd.DataFrame(results)
# NES
up_es = res[res['ES']>0]['ES'].abs().values
dn_es = res[res['ES']<0]['ES'].abs().values
res['NES'] = 0.0
for i,row in res.iterrows():
    if row['ES']>0:
        res.loc[i,'NES'] = row['ES']/np.sqrt(max(len(up_es),1))
    else:
        res.loc[i,'NES'] = row['ES']/np.sqrt(max(len(dn_es),1))
# BH FDR
nt = len(res); ord2 = np.argsort(res['p_value'].values)
ps2 = res['p_value'].values[ord2]
bh2 = np.minimum.accumulate((ps2*nt/np.arange(1,nt+1))[::-1])[::-1]
fdr = np.empty(nt); fdr[ord2] = np.clip(bh2,0,1)
res['fdr_qvalue'] = fdr
res = res.sort_values('fdr_qvalue').reset_index(drop=True)
res.to_csv('/workspace/gsea_results.csv', index=False)

print(f"{'='*70}")
print(f"GSEA RESULTS (sorted by FDR q-value)")
print(f"{'='*70}")
for _,r in res.iterrows():
    print(f"  {r['term']:<50s} NES={r['NES']:>8.4f} ES={r['ES']:>8.4f} p={r['p_value']:>8.4f} FDR={r['fdr_qvalue']:>8.4f} {r['direction']:>4s} {r['n_hit']}/{r['n_total']}")

top = res.iloc[0]
print(f"\nTOP TERM: {top['term']}")
print(f"  NES = {top['NES']:.4f}")
print(f"  ES = {top['ES']:.4f}")
print(f"  p_value = {top['p_value']:.4f}")
print(f"  FDR q-value = {top['fdr_qvalue']:.4f}")
print(f"  Direction: {top['direction']}")
print(f"  Hits: {top['n_hit']}/{top['n_total']}")
print(f"\nTotal time: {time.time()-t0:.1f}s")
