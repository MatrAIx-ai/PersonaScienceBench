#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
analysis.py  --  BixBench bix-43-q2
Odds ratio for "p53-mediated cell cycle gene regulation" via gseapy Reactome_2022,
using all DE genes (p<0.05, |log2FC|>0.5, baseMean>10), CBD/cisplatin combo (group 9) vs DMSO (group 3).
Robust to environment: DESeq2(R) if available else offline NB-Wald; gseapy -> Enrichr REST -> local GMT.
"""
import os, sys, json, csv, time, shutil, subprocess, warnings
warnings.filterwarnings("ignore")
import numpy as np, pandas as pd
from scipy.special import gammaln
from scipy.optimize import minimize
from scipy.stats import norm

DATA = "data"; COMB = "Cisplatin_IC50_CBD_IC50"; CTRL = "DMSO"
DB = "Reactome_2022"; TARGET = "p53-mediated cell cycle gene regulation"
log = lambda *a: print(*a, flush=True)

def load_layout():
    m = {}
    with open(f"{DATA}/sample_layout.csv") as f:
        for row in csv.DictReader(f):
            m[row["SampleID"].replace("-", "_")] = row["Group"].strip()
    return m

def load_counts():
    return pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0)

def load_symbol_map():
    m = {}
    with open(f"{DATA}/ensg_to_gene_name.tsv") as f:
        next(f)
        for line in f:
            p = line.rstrip("\n").split("\t")
            if len(p) >= 2 and p[1]:
                m[p[0]] = p[1]
    return m

R_CODE = r'''
suppressMessages(library(DESeq2))
counts  <- as.matrix(read.csv("counts_for_deseq2.csv", row.names=1, check.names=FALSE))
coldata <- read.csv("coldata.csv", check.names=FALSE)
rownames(coldata) <- coldata$Sample
counts <- counts[, coldata$Sample, drop=FALSE]
coldata$Group <- factor(coldata$Group)
dds <- DESeqDataSetFromMatrix(countData=counts, colData=coldata, design=~Group)
dds <- DESeq(dds)
res <- results(dds, contrast=c("Group","__COMB__","__CTRL__"))
o <- as.data.frame(res); o$ENSG <- rownames(o)
o <- o[, c("ENSG","baseMean","log2FoldChange","pvalue","padj")]
colnames(o)[2:5] <- c("baseMean","log2FC","pvalue","padj")
write.csv(o, "de_deseq2_results.csv", row.names=FALSE)
cat("DESeq2_OK\n")
'''.replace("__COMB__", COMB).replace("__CTRL__", CTRL)

def r_deseq2_available():
    if not shutil.which("Rscript"):
        return False
    try:
        r = subprocess.run(["Rscript", "-e", 'if(!requireNamespace("DESeq2",quietly=TRUE)) quit(status=1)'],
                           capture_output=True, timeout=120)
        return r.returncode == 0
    except Exception:
        return False

def de_deseq2_r(col2group, df):
    cols = list(df.columns)
    df[cols].to_csv("counts_for_deseq2.csv")
    pd.DataFrame({"Sample": cols, "Group": [col2group[c] for c in cols]}).to_csv("coldata.csv", index=False)
    open("de_deseq2.R", "w").write(R_CODE)
    r = subprocess.run(["Rscript", "de_deseq2.R"], capture_output=True, text=True, timeout=3600)
    if "DESeq2_OK" not in r.stdout:
        raise RuntimeError("DESeq2 failed:\n" + (r.stderr or r.stdout)[-2000:])
    res = pd.read_csv("de_deseq2_results.csv", index_col="ENSG"); res.index.name = "ENSG"
    return res

def de_offline(col2group, df):
    K = df.values.astype(float); cols = list(df.columns); m = K.shape[0]
    logK = np.where(K > 0, np.log(np.where(K > 0, K, 1)), np.nan)
    g = np.exp(np.nanmean(logK, axis=1)); g[~np.isfinite(g)] = np.nan
    sf = np.nanmedian(K / g[:, None], axis=0); sf[~np.isfinite(sf)] = 1.0
    baseMean = (K / sf[None, :]).mean(axis=1)
    i9 = [cols.index(c) for c in cols if col2group[c] == COMB]
    i3 = [cols.index(c) for c in cols if col2group[c] == CTRL]
    idx = i3 + i9
    x = np.array([0 if i in i3 else 1 for i in idx], float)
    off = np.log(sf[idx]); y = K[:, idx]
    def fit_one(yr):
        if yr.sum() == 0:
            return 0.0, np.nan
        def negLL(p):
            b0, b1, lp = p; phi = np.exp(lp); mu = np.exp(off + b0 + b1 * x); a = 1 / phi
            return -( (gammaln(yr + a) - gammaln(a) - gammaln(yr + 1)
                       + a * np.log(a / (a + mu)) + yr * np.log(mu / (a + mu))).sum() )
        m0 = np.mean(np.log(np.maximum(yr[x == 0], 0) + 0.5)) - np.mean(off[x == 0])
        r = minimize(negLL, [m0, 0.0, np.log(0.1)], method="L-BFGS-B",
                     bounds=[(-25, 25), (-25, 25), (-8, 2)], options={"maxiter": 300})
        b0, b1, lp = r.x; phi = np.exp(lp); mu = np.exp(off + b0 + b1 * x)
        V = mu * (1 + phi * mu); w = mu ** 2 / V
        S00 = w.sum(); S01 = (w * x).sum(); S11 = (w * x * x).sum(); det = S00 * S11 - S01 * S01
        se = np.sqrt(S00 / det) if det > 1e-12 else np.nan
        return b1, se
    b1v = np.zeros(m); sev = np.full(m, np.nan)
    for i in range(m):
        b1, se = fit_one(y[i]); b1v[i] = b1; sev[i] = se
    log2FC = b1v / np.log(2)
    pval = 2 * norm.sf(np.abs(np.where(sev > 0, b1v / sev, 0.0)))
    order = np.argsort(pval); rk = np.empty(m, float); rk[order] = np.arange(1, m + 1)
    padj = np.clip(pval * m / rk, 0, 1); ps = padj[order]
    ps = np.minimum.accumulate(ps[::-1])[::-1]; padj[order] = ps
    return pd.DataFrame({"baseMean": baseMean, "log2FC": log2FC, "pvalue": pval, "padj": padj},
                        index=df.index)

def run_de(col2group, df):
    if r_deseq2_available():
        try:
            log("[DE] using canonical DESeq2 (R)")
            return de_deseq2_r(col2group, df), "DESeq2 (R)"
        except Exception as e:
            log("[DE] DESeq2(R) failed ->", str(e)[:300])
    log("[DE] using offline NB-Wald DESeq2-equivalent (no R/DESeq2 in this env)")
    return de_offline(col2group, df), "offline NB-Wald (DESeq2-equivalent)"

def apply_filters(res):
    res = res.copy(); res["absFC"] = res["log2FC"].abs()
    fp  = (res["pvalue"] < 0.05) & (res["absFC"] > 0.5) & (res["baseMean"] > 10)
    fpa = (res["padj"]   < 0.05) & (res["absFC"] > 0.5) & (res["baseMean"] > 10)
    return fp, fpa

def enrichr_gseapy(symbols):
    import gseapy as gp
    enr = gp.enrichr(gene_list=symbols, gene_sets=DB, organism="Human",
                     outdir="enrichr_out", no_plot=True, permutation_test=False, processes=1)
    if isinstance(enr, (list, tuple)):
        enr = enr[0]
    return enr

def enrichr_rest(symbols):
    import urllib.request, urllib.parse
    base = "https://maayanlab.cloud/Enrichr"
    data = urllib.parse.urlencode({"content": "\n".join(symbols), "description": "DE_CBD_cis_vs_DMSO"}).encode()
    with urllib.request.urlopen(urllib.request.Request(base + "/addList/", data=data, method="POST"), timeout=180) as r:
        lid = r.read().decode().strip()
    data2 = urllib.parse.urlencode({"userListId": lid, "backgroundType": DB, "classic": "1"}).encode()
    with urllib.request.urlopen(urllib.request.Request(base + "/enrich/", data=data2, method="POST"), timeout=300) as r:
        j = json.loads(r.read().decode())
    rows = []
    for lib, entries in j.items():
        for e in entries:
            rows.append({"Term": e[0], "P-value": float(e[1]), "Adjusted P-value": float(e[2]),
                         "Odds Ratio": float(e[3]), "Combined Score": float(e[4]),
                         "Gene List": e[5], "Genes": e[6]})
    return pd.DataFrame(rows)

def enrichr_local(symbols, gmt="reactome_2022.gmt"):
    from scipy.stats import hypergeom
    sets = {}
    with open(gmt) as f:
        for line in f:
            p = line.rstrip("\n").split("\t")
            if len(p) >= 3:
                sets[p[0]] = set(p[2:])
    L = set(symbols); U = set(load_symbol_map().values())
    rows = []
    for name, G in sets.items():
        a = len(L & G); b = len(L - G); c = len(G - L); d = max(len(U - (L | G)), 0)
        orr = np.inf if (b == 0 or d == 0) else (a / b) / (c / d)
        p = hypergeom.sf(a - 1, len(U), len(G), len(L)) if a > 0 else 1.0
        rows.append({"Term": name, "P-value": p, "Adjusted P-value": np.nan,
                     "Odds Ratio": orr, "Combined Score": np.nan,
                     "Gene List": ";".join(sorted(L & G)), "Genes": ";".join(sorted(G))})
    return pd.DataFrame(rows).sort_values("P-value")

def run_enrichment(symbols):
    cands = [("gseapy.enrichr", lambda: enrichr_gseapy(symbols)),
             ("Enrichr REST API", lambda: enrichr_rest(symbols))]
    if os.path.exists("reactome_2022.gmt"):
        cands.append(("local GMT + hypergeometric", lambda: enrichr_local(symbols)))
    for name, fn in cands:
        try:
            log(f"[ENR] trying {name} ...")
            df = fn(); log(f"[ENR] {name} OK ({len(df)} terms)")
            return df, name
        except Exception as e:
            log(f"[ENR] {name} FAILED: {type(e).__name__}: {str(e)[:200]}")
    return None, None

def extract_target(dfdf, target=TARGET):
    if dfdf is None or len(dfdf) == 0:
        return None, None
    tl = target.lower()
    for idx, row in dfdf.iterrows():
        if str(row["Term"]).lower() == tl:
            return row, str(row["Term"])
    c = dfdf[dfdf["Term"].str.lower().str.contains("p53") & dfdf["Term"].str.lower().str.contains("cell cycle")]
    if len(c):
        return c.iloc[0], str(c.iloc[0]["Term"])
    c2 = dfdf[dfdf["Term"].str.lower().str.contains("p53")]
    if len(c2):
        return c2.iloc[0], str(c2.iloc[0]["Term"])
    return None, None

def main():
    t0 = time.time()
    col2group = load_layout(); df = load_counts(); sym = load_symbol_map()
    log(f"Loaded {df.shape[0]} genes x {df.shape[1]} samples; {len(set(col2group.values()))} groups.")
    res, de_method = run_de(col2group, df)
    res.to_csv("de_results.csv")
    fp, fpa = apply_filters(res)
    de_ensg = list(df.index[fp]); de_sym = [s for s in (sym.get(e) for e in de_ensg) if s]
    de_ensg_pa = list(df.index[fpa]); de_sym_pa = [s for s in (sym.get(e) for e in de_ensg_pa) if s]
    open("de_gene_list_primary.txt", "w").write("\n".join(de_sym))
    open("de_gene_list_padj.txt", "w").write("\n".join(de_sym_pa))
    report = {
        "de_method": de_method,
        "a_DE_counts": {
            "pvalue<0.05": {"n": int(fp.sum()), "up": int(((fp) & (res.log2FC > 0.5)).sum()),
                            "down": int(((fp) & (res.log2FC < -0.5)).sum())},
            "padj<0.05": {"n": int(fpa.sum()), "up": int(((fpa) & (res.log2FC > 0.5)).sum()),
                          "down": int(((fpa) & (res.log2FC < -0.5)).sum())},
        },
        "b_symbols": {
            "pvalue_primary": len(de_sym), "pvalue_nosymbol_dropped": len(de_ensg) - len(de_sym),
            "padj_sensitivity": len(de_sym_pa), "padj_nosymbol_dropped": len(de_ensg_pa) - len(de_sym_pa),
        },
    }
    enr, path = run_enrichment(de_sym)
    report["enrichment_path"] = path
    report["c_target_row"] = None; report["d_exact_term"] = None
    if enr is not None:
        enr.to_csv("enrichr_results.csv")
        row, term = extract_target(enr)
        if row is not None:
            report["c_target_row"] = {k: (round(float(row[k]), 6)
                                          if k in ("P-value", "Adjusted P-value", "Odds Ratio", "Combined Score")
                                          else row[k])
                                       for k in row.index
                                       if k in ("Term", "P-value", "Adjusted P-value", "Odds Ratio", "Combined Score", "Gene List")}
            report["d_exact_term"] = term
            report["FINAL_ODDS_RATIO"] = float(row["Odds Ratio"])
        enr2, _ = run_enrichment(de_sym_pa)
        if enr2 is not None:
            row2, _ = extract_target(enr2)
            if row2 is not None:
                report["sensitivity_padj_ODDS_RATIO"] = float(row2["Odds Ratio"])
    else:
        report["note"] = ("Enrichr/Reactome_2022 unreachable in this env (no gseapy, no network, "
                          "no local GMT). DE list is real; Enrichr step must run in provisioned runner. "
                          "No odds ratio fabricated.")
    report["runtime_s"] = round(time.time() - t0, 1)
    json.dump(report, open("analysis_report.json", "w"), indent=2, default=str)
    print("\n" + "=" * 70)
    print(json.dumps(report, indent=2, default=str))
    print("=" * 70)

if __name__ == "__main__":
    main()
