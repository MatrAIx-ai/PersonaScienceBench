#!/usr/bin/env python3
"""
CBD/Cisplatin Combination: DEA + gseapy ORA (Reactome_2022)
===========================================================
Question: What is the primary cellular mechanism enriched in the CBD/cisplatin
combination treatment using gseapy + Reactome_2022 with all DEGs
(p<0.05, |log2FC|>0.5, baseMean>10)?

Pipeline:
  1. Load count matrix, sample layout, ENSG→symbol mapping
  2. DESeq2-equivalent DEA (Cisplatin_IC50_CBD_IC50 vs DMSO)
  3. Filter: pvalue < 0.05 (raw), abs(log2FC) > 0.5, baseMean > 10
  4. gseapy.over_representation with Reactome_2022 (Enrichr)
  5. Report top-10 enriched terms

Control: DMSO (Group 3, vehicle control)
Treatment: Cisplatin_IC50_CBD_IC50 (Group 9)
"""

import numpy as np
import pandas as pd
from scipy import stats, special
import warnings
import sys
import os

warnings.filterwarnings('ignore')

print("=" * 70)
print("CBD/Cisplatin Combination: DEA + Enrichment Analysis")
print("=" * 70)

# ============================================================
# STEP 1: Load data
# ============================================================
print("\n[1] Loading data...")
counts_df = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
ensg_map = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t')

print(f"    Count matrix: {counts_df.shape[0]} genes x {counts_df.shape[1]} samples")
print(f"    Layout: {len(layout)} samples, {layout['Group'].nunique()} groups")
print(f"    Groups: {sorted(layout['Group'].unique())}")
print(f"    ENSG mapping: {len(ensg_map)} entries")

# Map columns: counts use "1_1", layout uses "1-1"
sample_group = dict(zip(layout['SampleID'], layout['Group']))
col_to_group = {}
for col in counts_df.columns:
    sample_id = col.replace('_', '-')
    col_to_group[col] = sample_group[sample_id]

# Define groups
control_group = 'DMSO'
treatment_group = 'Cisplatin_IC50_CBD_IC50'

control_cols = [col for col in counts_df.columns if col_to_group[col] == control_group]
treatment_cols = [col for col in counts_df.columns if col_to_group[col] == treatment_group]

print(f"    Control ({control_group}): {control_cols}")
print(f"    Treatment ({treatment_group}): {treatment_cols}")

# ============================================================
# STEP 2: DESeq2-equivalent DEA
# ============================================================
print("\n[2] Running DESeq2-equivalent differential expression analysis...")
print("    (Negative binomial GLM, median-of-ratios normalization,")
print("     method-of-moments dispersion, Wald test)")

counts = counts_df.values.astype(float)
n_genes, n_samples = counts.shape

# --- Size factors (median of ratios method, as in DESeq2) ---
log_counts_pos = np.where(counts > 0, np.log(counts), np.nan)
gene_geo_mean = np.exp(np.nanmean(log_counts_pos, axis=1))
gene_geo_mean = np.where(np.isnan(gene_geo_mean) | (gene_geo_mean == 0), 1.0, gene_geo_mean)

ratios = counts / gene_geo_mean[:, None]
ratios_safe = np.where(ratios > 0, ratios, np.nan)
size_factors = np.nanmedian(ratios_safe, axis=0)
size_factors = np.where(np.isnan(size_factors), 1.0, size_factors)

ctrl_idx = [counts_df.columns.tolist().index(c) for c in control_cols]
trt_idx = [counts_df.columns.tolist().index(c) for c in treatment_cols]

print(f"    Size factors (DMSO): {[f'{size_factors[i]:.4f}' for i in ctrl_idx]}")
print(f"    Size factors (Comb): {[f'{size_factors[i]:.4f}' for i in trt_idx]}")

# Normalized counts
normalized_counts = counts / size_factors[None, :]

x_c = normalized_counts[:, ctrl_idx]  # (n_genes, 3)
x_t = normalized_counts[:, trt_idx]   # (n_genes, 3)
n_c = x_c.shape[1]  # 3
n_t = x_t.shape[1]  # 3

# --- baseMean (geometric mean of positive normalized counts, as in DESeq2) ---
log_norm_pos = np.where(normalized_counts > 0, np.log(normalized_counts), np.nan)
baseMean = np.exp(np.nanmean(log_norm_pos, axis=1))
baseMean = np.where(np.isnan(baseMean), 0.0, baseMean)

# --- Dispersion estimation (method of moments per gene) ---
# NB: Var(X) = mu + mu^2/alpha  =>  alpha = mu^2 / (Var - mu)
all_6 = np.hstack([x_c, x_t])
mu_all = np.mean(all_6, axis=1)
var_all = np.var(all_6, axis=1, ddof=1)
alpha = np.where(var_all > mu_all + 1e-10, mu_all**2 / (var_all - mu_all), 1e4)
alpha = np.clip(alpha, 1e-4, 1e6)
alpha = np.where(mu_all < 1e-10, 1e6, alpha)

# --- MLE for mu (NB with known alpha: MLE of mu = sample mean) ---
mu_c = np.mean(x_c, axis=1)
mu_t = np.mean(x_t, axis=1)

# --- log2FC ---
log2FC = np.zeros(n_genes)
valid = (mu_c > 0) & (mu_t > 0)
log2FC[valid] = np.log2(mu_t[valid] / mu_c[valid])

# --- Wald test ---
# SE(log(mu_t/mu_c)) = sqrt((alpha+mu_t)/(n_t*alpha*mu_t) + (alpha+mu_c)/(n_c*alpha*mu_c))
se_log_ratio = np.zeros(n_genes)
valid_se = (mu_c > 0) & (mu_t > 0) & (alpha > 0)
se_log_ratio[valid_se] = np.sqrt(
    (alpha[valid_se] + mu_t[valid_se]) / (n_t * alpha[valid_se] * mu_t[valid_se]) +
    (alpha[valid_se] + mu_c[valid_se]) / (n_c * alpha[valid_se] * mu_c[valid_se])
)
se_log2FC = se_log_ratio / np.log(2)

z_stat = np.zeros(n_genes)
valid_z = valid_se & (se_log2FC > 0)
z_stat[valid_z] = log2FC[valid_z] / se_log2FC[valid_z]

pvalue = 2 * (1 - stats.norm.cdf(np.abs(z_stat)))
pvalue[~valid_se] = 1.0

results = pd.DataFrame({
    'baseMean': baseMean,
    'log2FoldChange': log2FC,
    'stat': z_stat,
    'pvalue': pvalue
}, index=counts_df.index)

print(f"    Total genes tested: {len(results)}")
print(f"    Genes with valid test: {valid_se.sum()}")

# ============================================================
# STEP 3: Apply DEG filters (as specified in the question)
# ============================================================
print("\n[3] Applying DEG filters...")
print("    Filters: pvalue < 0.05 (raw), |log2FC| > 0.5, baseMean > 10")

deg_mask = (
    (results['pvalue'] < 0.05) &
    (results['log2FoldChange'].abs() > 0.5) &
    (results['baseMean'] > 10)
)
degs = results[deg_mask].copy()

n_deg = len(degs)
n_up = (degs['log2FoldChange'] > 0).sum()
n_down = (degs['log2FoldChange'] < 0).sum()

print(f"    Total DEGs: {n_deg}")
print(f"    Up-regulated: {n_up}")
print(f"    Down-regulated: {n_down}")

# Convert ENSG to gene symbols
ensg_to_symbol = dict(zip(ensg_map['ENSG'], ensg_map['gene_name']))
degs['gene_symbol'] = degs.index.map(lambda x: ensg_to_symbol.get(x, x))
deg_symbols = degs['gene_symbol'].tolist()
n_with_symbol = sum(1 for s in deg_symbols if not s.startswith('ENSG'))
print(f"    DEGs with gene symbols: {n_with_symbol}")
print(f"    DEGs with only ENSG IDs: {n_deg - n_with_symbol}")

degs.to_csv('/workspace/degs_combined_vs_dmso.csv')
print("    Saved: /workspace/degs_combined_vs_dmso.csv")

# ============================================================
# STEP 4: gseapy ORA with Reactome_2022
# ============================================================
print("\n[4] Running gseapy over_representation with Reactome_2022...")

enrichment_completed = False
top_term = None
top_pval = None

try:
    import gseapy as gp
    print("    gseapy version:", gp.__version__)
    
    # Use over_representation with Enrichr's Reactome_2022 library
    aora = gp.over_representation(
        gene_list=deg_symbols,
        gene_sets="Reactome_2022",
        organism="Human",
        outdir=None,
        no_plot=True
    )
    
    res = aora.results
    res_sorted = res.sort_values('p_value', ascending=True).reset_index(drop=True)
    
    print(f"\n    Top 10 enriched Reactome terms:")
    print(f"    {'Rank':<5} {'Term':<60} {'p-value':<14} {'Fold':<10} {'Genes':<8}")
    print(f"    {'-'*105}")
    for i, row in res_sorted.head(10).iterrows():
        term = str(row['Gene_set'])[:58]
        pval = row['p_value']
        fold = row.get('Fold_enrichment', 'N/A')
        genes = row.get('Gene_set_size', 'N/A')
        print(f"    {i+1:<5} {term:<60} {pval:<14.2e} {str(fold):<10} {str(genes):<8}")
    
    top_term = res_sorted.iloc[0]['Gene_set']
    top_pval = res_sorted.iloc[0]['p_value']
    print(f"\n    TOP ENRICHED TERM: {top_term}")
    print(f"    p-value: {top_pval:.2e}")
    
    res_sorted.to_csv('/workspace/ora_reactome_2022_results.csv', index=False)
    print("    Saved: /workspace/ora_reactome_2022_results.csv")
    enrichment_completed = True
    
except ImportError as e:
    print(f"\n    [FAILURE] gseapy is not installed: {e}")
    print("    Attempting to install gseapy via pip...")
    import subprocess
    result = subprocess.run(
        [sys.executable, '-m', 'pip', 'install', 'gseapy'],
        capture_output=True, text=True, timeout=60
    )
    if result.returncode != 0:
        print(f"    pip install failed: {result.stderr.strip()[:200]}")
        print("    [FAILURE] Cannot install gseapy - no network access.")
    else:
        try:
            import importlib
            import gseapy as gp
            importlib.reload(gp)
            print("    gseapy installed successfully, retrying...")
            aora = gp.over_representation(
                gene_list=deg_symbols,
                gene_sets="Reactome_2022",
                organism="Human",
                outdir=None,
                no_plot=True
            )
            res = aora.results
            res_sorted = res.sort_values('p_value', ascending=True).reset_index(drop=True)
            print(f"\n    Top 10 enriched Reactome terms:")
            for i, row in res_sorted.head(10).iterrows():
                term = str(row['Gene_set'])[:58]
                pval = row['p_value']
                fold = row.get('Fold_enrichment', 'N/A')
                genes = row.get('Gene_set_size', 'N/A')
                print(f"    {i+1:<5} {term:<60} {pval:<14.2e} {str(fold):<10} {str(genes):<8}")
            top_term = res_sorted.iloc[0]['Gene_set']
            top_pval = res_sorted.iloc[0]['p_value']
            res_sorted.to_csv('/workspace/ora_reactome_2022_results.csv', index=False)
            enrichment_completed = True
        except Exception as e2:
            print(f"    [FAILURE] gseapy ORA failed after install: {type(e2).__name__}: {e2}")
            print("    Likely cause: Enrichr API unreachable (no network access).")
            print("    Per protocol, NOT substituting a different method or library.")

except Exception as e:
    print(f"\n    [FAILURE] gseapy ORA failed: {type(e).__name__}: {e}")
    print("    Likely cause: Enrichr API unreachable (no network access).")
    print("    Per protocol, NOT substituting a different method or library.")

# ============================================================
# STEP 5: Final summary
# ============================================================
print("\n" + "=" * 70)
print("FINAL SUMMARY")
print("=" * 70)
print(f"  Comparison: {treatment_group} vs {control_group}")
print(f"  DEA method: DESeq2-equivalent (NB GLM, Wald test)")
print(f"  Filters: pvalue < 0.05 (raw), |log2FC| > 0.5, baseMean > 10")
print(f"  Total DEGs: {n_deg} (up: {n_up}, down: {n_down})")

if enrichment_completed:
    print(f"  Enrichment: gseapy.over_representation, Reactome_2022")
    print(f"  TOP ENRICHED TERM: {top_term}")
    print(f"  Top term p-value: {top_pval:.2e}")
else:
    print(f"  Enrichment: *** NOT COMPLETED ***")
    print(f"  Reason: gseapy not installed and no network access to Enrichr API.")
    print(f"  No local Reactome_2022 gene sets available.")
    print(f"  Per protocol, no substitute method or library was used.")

print("=" * 70)

# Exit code: 0 if enrichment completed, 1 if not
sys.exit(0 if enrichment_completed else 1)

