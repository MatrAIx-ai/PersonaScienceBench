#!/usr/bin/env python3
"""DESeq2-style DE: ASXL1 vs Control, lfcShrink(apeglm), padj<0.05
Uses per-gene NB GLM fit via coordinate descent on the NB log-likelihood."""
import numpy as np, pandas as pd, warnings, time
from scipy.special import gammaln, xlogy
from scipy.optimize import minimize_scalar
from scipy.stats import norm
warnings.filterwarnings('ignore'); np.seterr(all='ignore')
print("="*70); print("DESeq2-style DE: ASXL1 vs Control"); print("="*70)

# 1. LOAD
print("\n[1] Loading...")
with open('/workspace/data/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt') as f:
    header = f.readline().split()
    rows = [l.strip().split() for l in f]
gene_ids = [r[0] for r in rows]
sample_names = header[1:]
K = np.array([r[1:] for r in rows], dtype=np.float64)
coldata = pd.read_excel('/workspace/data/Issy_ASXL1_blood_coldata_gender.xlsx')
cd_s = set(coldata['sample'].tolist())
rem = [s for s in sample_names if s not in cd_s]
if rem:
    print(f"  Removing {len(rem)}: {rem}")
    keep = [s not in rem for s in sample_names]
    K = K[:, keep]; sample_names = [s for s in sample_names if s not in rem]
gen = pd.read_csv('/workspace/data/gencode.v31.primary_assembly.genes.csv')
gn_map = dict(zip(gen['gene_id'], gen['gene_name']))
gene_names = [gn_map.get(g,'NA') for g in gene_ids]
cdi = coldata.set_index('sample').loc[sample_names]
x = (cdi['condition'].values=='ASXL1').astype(float)
n_d,n_c,n_s,n_g = int(x.sum()),int(len(x)-x.sum()),len(x),K.shape[0]
print(f"  {n_g} genes x {n_s} samples (ASXL1={n_d}, Control={n_c})")

# 2. SIZE FACTORS
print("\n[2] Size factors (median of ratios)...")
logK = np.where(K>0,np.log(K),-np.inf)
gm = np.exp(np.nanmean(logK,axis=1)); gm=np.nan_to_num(gm,nan=0)
nz = gm>0
sf = np.median(K[nz,:]/gm[nz,None],axis=0)
sf = np.where(sf>0,sf,1.0)
print(f"  SF: min={sf.min():.4f} med={np.median(sf):.4f} max={sf.max():.4f}")

# 3. NB LOG-LIKELIHOOD helpers
def _nb_ll(b0, b1, Kj, X0, X1, off, phi):
    mu = np.exp(np.clip(X0*b0 + X1*b1 + off, -30, 30))
    mu = np.maximum(mu, 1e-10)
    ll = gammaln(Kj+phi) - gammaln(Kj+1) - gammaln(phi)
    ll += phi*(np.log(phi)-np.log(phi+mu))
    ll += xlogy(Kj, mu/(phi+mu))
    return np.sum(ll)

# 4. ADJUSTED MEANS
K_adj = K / sf[None,:]
cm = x==0; dm = x==1
mu_c = np.maximum(K_adj[:,cm].mean(axis=1), 1e-10)
mu_d = np.maximum(K_adj[:,dm].mean(axis=1), 1e-10)
mean_expr = (mu_c*n_c+mu_d*n_d)/n_s
mu_init = np.zeros_like(K)
mu_init[:,cm]=mu_c[:,None]; mu_init[:,dm]=mu_d[:,None]

# 5. DISPERSION (method of moments)
print("\n[3] Dispersion (method of moments)...")
var_adj = K_adj.var(axis=1, ddof=1)
mean_adj = K_adj.mean(axis=1)
phi_mle = np.maximum((var_adj - mean_adj) / np.maximum(mean_adj**2, 1e-10), 0.001)
phi_mle = np.clip(phi_mle, 0.001, 10.0)
vm = np.ones(n_g, dtype=bool)
fail = 0
print(f"  phi: med={np.median(phi_mle):.6f} 25th={np.percentile(phi_mle,25):.6f} 75th={np.percentile(phi_mle,75):.6f}")

# 6. TREND
print("\n[4] Mean-dispersion trend...")
vt = vm & (mean_expr>0.1)
xt_=np.log(mean_expr[vt]); yt_=np.log(phi_mle[vt])
Xt=np.column_stack([np.ones(len(xt_)),xt_,xt_**2])
tc,_,_,_=np.linalg.lstsq(Xt,yt_,rcond=None)
resid=yt_-Xt@tc; rm,rx=np.min(resid),np.max(resid)
print(f"  n={vt.sum()} coef=({tc[0]:.4f},{tc[1]:.4f},{tc[2]:.4f})")
print(f"  Resid range: [{rm:.4f},{rx:.4f}]")
lma=np.log(np.maximum(mean_expr,1e-10))
lpt=np.column_stack([np.ones(n_g),lma,lma**2])@tc

# 7. SHRINKAGE
print("\n[5] Dispersion shrinkage...")
tau2=max(np.var(resid),1e-4)
Ij=np.maximum(n_s/(2.0*(1.0+phi_mle*mean_expr)),1e-6)
ws=np.clip(Ij/(Ij+1.0/tau2),0.05,0.95)
phi_shr=np.clip(np.exp(ws*np.log(phi_mle)+(1-ws)*lpt),1e-4,10.0)
print(f"  tau2={tau2:.4f}")
print(f"  MLE:    med={np.median(phi_mle[vm]):.6f} min={np.min(phi_mle[vm]):.6f} max={np.max(phi_mle[vm]):.6f}")
print(f"  Shrunk: med={np.median(phi_shr):.6f} min={phi_shr.min():.6f} max={phi_shr.max():.6f}")

# 8. GLM FIT (coordinate descent per gene)
print("\n[6] NB GLM fit (coordinate descent)...")
X0=np.ones(n_s); X1=x; off=np.log(sf)
beta_f=np.zeros((n_g,2)); se1=np.zeros(n_g)
conv_f=np.zeros(n_g,dtype=bool); itr_f=np.zeros(n_g,dtype=int)
t0=time.time()
for j in range(n_g):
    if K[j].sum()==0:
        beta_f[j]=[np.log(mu_c[j]),0.0]; se1[j]=10.0; itr_f[j]=0; continue
    b0=np.log(mu_c[j]); b1=np.log(max(mu_d[j]/mu_c[j],1e-10))
    for it in range(80):
        r0=minimize_scalar(lambda b0: -_nb_ll(b0,b1,K[j],X0,X1,off,phi_shr[j]),
                           bounds=(-15,15),method='bounded',options={'xatol':1e-8})
        r1=minimize_scalar(lambda b1: -_nb_ll(r0.x,b1,K[j],X0,X1,off,phi_shr[j]),
                           bounds=(-8,8),method='bounded',options={'xatol':1e-8})
        b0n,b1n=r0.x,r1.x
        if abs(b0n-b0)<1e-7 and abs(b1n-b1)<1e-7:
            b0,b1=b0n,b1n; conv_f[j]=True; itr_f[j]=it+1; break
        b0,b1=b0n,b1n
    else: itr_f[j]=80
    beta_f[j]=[b0,b1]
    mu=np.exp(np.clip(X0*b0+X1*b1+off,-30,30)); mu=np.maximum(mu,1e-10)
    w=np.maximum(mu/(1.0+phi_shr[j]*mu),1e-12)
    A=np.sum(w); B=np.sum(w*X1)
    se1[j]=np.sqrt(A/max(abs(B*(A-B)),1e-12))
    if (j+1)%5000==0: print(f"  ...{j+1}/{n_g} ({time.time()-t0:.0f}s)")
print(f"  {time.time()-t0:.1f}s, conv={conv_f.sum()}/{n_g} ({100*conv_f.sum()/n_g:.1f}%)")
print(f"  Iter: min={itr_f.min()} med={np.median(itr_f):.0f} max={itr_f.max()}")

# 9. WALD TEST
log2fc = beta_f[:,1]/np.log(2.0)
se_l2 = se1/np.log(2.0)
z = beta_f[:,1]/se1
p = 2.0*norm.sf(np.abs(z))
p = np.nan_to_num(p, nan=1.0, posinf=0.0, neginf=1.0); p=np.clip(p,0,1)
print(f"\n[7] raw p<0.05: {(p<0.05).sum()}")

# 10. BH
print("[8] BH FDR...")
m=n_g; ord_=np.argsort(p); sp=p[ord_]
bh=sp*m/np.arange(1,m+1)
for i in range(m-2,-1,-1): bh[i]=min(bh[i],bh[i+1])
padj=np.empty(m); padj[ord_]=bh; padj=np.clip(padj,0,1)
n_sig=int((padj<0.05).sum())
n_up=int(((padj<0.05)&(log2fc>0)).sum())
n_dn=int(((padj<0.05)&(log2fc<0)).sum())
print(f"  padj<0.05: {n_sig}")

# 11. LFC SHRINKAGE (apeglm-style)
zsq=(log2fc/np.maximum(se_l2,1e-10))**2
sw=np.where(np.isfinite(1.0-1.0/(1.0+zsq)), 1.0-1.0/(1.0+zsq), 0.0)
l2fcs=log2fc*sw

# 12. TOP 10
print("\n"+"="*70); print("TOP 10 BY PADJ"); print("="*70)
print(f"{'Gene':<18}{'l2FC_shrunk':>14}{'l2FC_raw':>12}{'padj':>14}{'Dir':>6}")
print("-"*70)
for idx in np.argsort(padj)[:10]:
    d="UP" if log2fc[idx]>0 else "DOWN"
    print(f"{gene_names[idx]:<18}{l2fcs[idx]:>14.4f}{log2fc[idx]:>12.4f}{padj[idx]:>14.2e}{d:>6}")
print("-"*70)

# 13. DIAGNOSTICS
print("\n"+"="*70); print("DIAGNOSTICS"); print("="*70)
print(f"  Genes={n_g} Samples={n_s} (ASXL1={n_d} Ctrl={n_c})")
print(f"  Disp MoM: {vm.sum()}/{n_g} ({100*vm.sum()/n_g:.1f}%)")
print(f"  Disp MoM fail: {fail}")
print(f"  GLM conv: {conv_f.sum()}/{n_g} ({100*conv_f.sum()/n_g:.1f}%)")
print(f"  Iter: min={itr_f.min()} med={np.median(itr_f):.0f} max={itr_f.max()}")
print(f"  MLE phi: med={np.median(phi_mle[vm]):.6f} min={np.min(phi_mle[vm]):.6f} max={np.max(phi_mle[vm]):.6f}")
print(f"  Shr phi: med={np.median(phi_shr):.6f} min={phi_shr.min():.6f} max={phi_shr.max():.6f}")
print(f"  Trend resid: [{rm:.4f},{rx:.4f}]  tau2={tau2:.4f}")
print(f"  log2FC: min={log2fc.min():.2f} max={log2fc.max():.2f}")

# 14. SAVE
df=pd.DataFrame({'gene_id':gene_ids,'gene_name':gene_names,'baseMean':mean_expr,
    'log2FoldChange':log2fc,'lfcSE':se_l2,'log2FC_shrunk':l2fcs,
    'WaldStat':z,'pvalue':p,'padj':padj})
df.to_csv('/workspace/deseq2_results.csv',index=False)
print(f"\n  Saved to /workspace/deseq2_results.csv")
print("\n"+"="*70)
print(f"FINAL: padj<0.05 total={n_sig}  UP={n_up}  DOWN={n_dn}")
print("="*70)
