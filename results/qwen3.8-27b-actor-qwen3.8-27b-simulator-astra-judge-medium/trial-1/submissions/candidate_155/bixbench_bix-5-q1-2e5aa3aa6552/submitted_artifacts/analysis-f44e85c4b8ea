"""
Differential expression: NB-GLM (log link) Wald test, design ~ sex + condition.
DESeq2-equivalent: median-of-ratios size factors as GLM offset; per-gene NB
dispersion by method of moments (falls back to Poisson when ~0).
Reference: control; level of interest: disease. Restricted to the 14 coldata
samples. Significant: padj<0.05 (BH) & |log2FC|>1.
GO:BP enrichment is NOT performed: no gene->GO:BP annotation is available in
this offline environment (verified: gencode 'ont' empty, no GO package/file, no network).
"""
import warnings; warnings.filterwarnings("ignore")
import numpy as np, pandas as pd, time
import statsmodels.api as sm
from statsmodels.genmod.families import Poisson, NegativeBinomial
from scipy import stats

t0 = time.time()
# ---------------- load ----------------
fc = pd.read_csv('data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt', sep='\s+')
fc.columns = [c.strip() for c in fc.columns]
cd = pd.read_excel('data/Issy_ASXL1_fibro_coldata_gender.xlsx')

samples = list(cd['sample'])                       # 14 samples (drops MGD1640F/MGD1641F)
fc = fc.set_index('Geneid')
counts = fc[samples].astype(float).values          # (60662 genes, 14 samples)
genes = list(fc.index)
print('counts shape', counts.shape, 'samples:', samples, flush=True)

sex     = (cd['sex'] == 'M').astype(int).values
disease = (cd['condition'] == 'disease').astype(int).values   # reference = control
X = np.column_stack([np.ones(len(samples)), sex, disease])

# ---------------- median-of-ratios size factors ----------------
gm = np.exp(np.nanmean(np.log(counts + 1e-12), axis=1))
ratio = counts / gm[:, None]
sf = np.nanmedian(ratio, axis=0); sf[sf <= 0] = 1.0
offset = np.log(sf)
print('size factors min/max:', round(sf.min(),4), round(sf.max(),4), flush=True)

# ---------------- per-gene Wald test on 'disease' ----------------
def wald_p(y, a):
    fam = Poisson() if a < 1e-6 else NegativeBinomial(alpha=a)
    m = sm.GLM(y, X, family=fam, offset=offset).fit(disp=False)
    return 2 * stats.norm.sf(abs(m.tvalues[2]))

n = len(genes); pvals = np.full(n, np.nan)
for i in range(n):
    y = counts[i]; mu = y.mean()
    if mu <= 0:
        continue
    a = max(0.0, (y.var(ddof=1) - mu) / mu**2)
    pvals[i] = wald_p(y, a)
    if i % 10000 == 0:
        print(f'  {i}/{n} elapsed {time.time()-t0:.0f}s', flush=True)

# ---------------- log2 fold change (size-factor normalised group means) ----------------
dm = disease == 1; cm = disease == 0
norm = counts / sf[None, :]                      # size-factor normalised
log2fc = (np.log2(norm[:, dm].mean(1) + 1e-12)
          - np.log2(norm[:, cm].mean(1) + 1e-12))

# ---------------- Benjamini-Hochberg FDR ----------------
valid = ~np.isnan(pvals)
order = np.argsort(pvals)
pv = pvals[order]; m = int(valid.sum())
pvv = pv[~np.isnan(pv)]
pvbh = pvv * m / np.arange(1, m + 1)
for r in range(m - 2, -1, -1):
    pvbh[r] = min(pvbh[r], pvbh[r + 1])
padj = np.full(n, np.nan); padj[order[~np.isnan(pv)]] = pvbh
padj = np.clip(padj, 0, 1)

res = pd.DataFrame({'gene_id': genes, 'log2FC': log2fc, 'pvalue': pvals, 'padj': padj})
res.to_csv('de_results_full.tsv', sep='\t', index=False)

# ---------------- HGNC symbol mapping ----------------
h = pd.read_csv('data/HGNC_05-09-19.txt', sep='\t')
ens2sym = dict(zip(h['Ensembl ID(supplied by Ensembl)'].dropna(), h['Approved symbol']))
gc = pd.read_csv('data/gencode.v31.primary_assembly.genes.csv')
gc2sym = dict(zip(gc['gene_id'].str.split('.').str[0], gc['gene_name']))
res['symbol'] = [ens2sym.get(g.split('.')[0]) or gc2sym.get(g.split('.')[0]) for g in genes]

# ---------------- significance ----------------
sig = res[(res['padj'] < 0.05) & (res['log2FC'].abs() > 1)].copy()
up = sig[sig['log2FC'] > 0]
down = sig[sig['log2FC'] < 0]
print('=== SIGNIFICANT DE (padj<0.05 & |log2FC|>1) ===', flush=True)
print('up (disease):', len(up), ' down (disease):', len(down), ' combined:', len(sig), flush=True)

top10 = up.sort_values('padj').head(10)
print('\n=== TOP 10 DISEASE-UP BY ADJUSTED P ===', flush=True)
print(top10[['symbol','gene_id','log2FC','pvalue','padj']].to_string(index=False), flush=True)

# save tables
res.sort_values('padj').to_csv('de_results_sorted.tsv', sep='\t', index=False)
up.sort_values('padj').to_csv('de_up.tsv', sep='\t', index=False)
down.sort_values('padj').to_csv('de_down.tsv', sep='\t', index=False)
print('\nALL DONE in', round(time.time()-t0,1), 's', flush=True)
