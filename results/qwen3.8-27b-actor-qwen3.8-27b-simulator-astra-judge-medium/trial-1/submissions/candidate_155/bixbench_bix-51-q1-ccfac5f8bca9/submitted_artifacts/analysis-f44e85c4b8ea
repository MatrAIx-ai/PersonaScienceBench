import pandas as pd
import numpy as np
import statsmodels.api as sm

# (1) Load Sheet1, drop fully-empty trailing rows and the junk row with Age=' '
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
d = df.dropna(how='all').copy()
d = d[d['Efficacy'].notna()].copy()          # removes junk row (Age=' ', all else NaN)
assert len(d) == 80, len(d)

# (2) Coerce Age to integer
d['Age'] = pd.to_numeric(d['Age'], errors='coerce').astype(int)
assert d['Age'].notna().all()

# (3) Binary outcome y = 1 where Efficacy=='PR' else 0
d['y'] = (d['Efficacy'] == 'PR').astype(int)

# (4) Fit logistic regression logit(P) = beta0 + beta1*Age
X = sm.add_constant(d['Age'].astype(float))
model = sm.Logit(d['y'], X).fit(disp=0)

# (5) Predict P(y=1 | Age=65)
b0 = float(model.params["const"]); b1 = float(model.params["Age"])
logit65 = b0 + b1 * 65.0
p65 = 1.0 / (1.0 + np.exp(-logit65))

print("n =", len(d), "| PR events =", int(d['y'].sum()))
print("intercept (beta0) =", float(model.params['const']))
print("slope (beta1, Age) =", float(model.params['Age']))
print("log-likelihood =", float(model.llf))
print("linear predictor at Age=65 =", logit65)
print("Predicted P(PR | Age=65) =", p65)
print("Predicted P(PR | Age=65) to 4 dp =", round(p65, 4))
