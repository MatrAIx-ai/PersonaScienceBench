"""
Logistic regression: BMI as the sole predictor of treatment response (efficacy PR).

Question: What is the AIC for the logistic regression model that uses BMI as the
sole predictor of treatment response (efficacy PR)?

Method (approved by researcher):
  - Data: data/data.xlsx, Sheet1
  - Cleaning: drop the 41 blank rows (rows lacking a 'Sequence number');
    all 80 remaining valid rows have both 'Efficacy' and 'BMI'.
  - Outcome (binary): PR -> 1 (response), SD and PD -> 0 (no response).
    (No 'CR' category exists in the data, so 'PR' == 'PR+CR'.)
  - Predictor: raw BMI (no standardization / transformation / winsorization).
  - Model: logit(P(PR=1)) = beta0 + beta1 * BMI  (intercept included, k = 2).
  - Fitted with statsmodels.api.Logit (MLE).
  - AIC read from result: res.aic  (= -2*logLik + 2*k, k includes intercept).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---------------------------------------------------------------------------
# 1. Load data
# ---------------------------------------------------------------------------
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print("Raw shape:", df.shape)

# ---------------------------------------------------------------------------
# 2. Clean: keep rows that actually contain a sequence number (valid records)
# ---------------------------------------------------------------------------
valid = df[df["Sequence number"].notna()].copy()

# Binarize efficacy: PR -> 1 (response); SD / PD -> 0 (no response)
valid["response"] = (valid["Efficacy"] == "PR").astype(int)

# Drop any row missing outcome or predictor (none expected)
valid = valid.dropna(subset=["response", "BMI"]).copy()

n = len(valid)
n_pos = int(valid["response"].sum())
n_neg = n - n_pos
print(f"Valid sample n = {n}  (PR=1: {n_pos}, SD+PD=0: {n_neg})")

# ---------------------------------------------------------------------------
# 3. Fit logistic regression: response ~ BMI (raw, intercept included)
# ---------------------------------------------------------------------------
X = sm.add_constant(valid["BMI"].astype(float))   # column 0 = intercept
y = valid["response"].astype(float)

model = sm.Logit(y, X)
res = model.fit(disp=0)

# ---------------------------------------------------------------------------
# 4. Extract results
# ---------------------------------------------------------------------------
aic = res.aic
loglik = res.llf
k = int(res.df_model + 1)          # df_model excludes intercept; +1 -> 2 params
beta0 = res.params["const"]
beta1 = res.params["BMI"]
p0 = res.pvalues["const"]
p1 = res.pvalues["BMI"]

# Manual AIC cross-check: AIC = -2*logLik + 2*k
aic_manual = -2 * loglik + 2 * k

print("\n=== Fit summary ===")
print(res.summary())
print("\n=== Key results ===")
print(f"n            = {n}")
print(f"k (params)   = {k}  (intercept + BMI)")
print(f"log-likelihood = {loglik:.6f}")
print(f"beta0 (const) = {beta0:.6f}   p = {p0:.6g}")
print(f"beta1 (BMI)   = {beta1:.6f}   p = {p1:.6g}")
print(f"AIC (res.aic) = {aic:.6f}")
print(f"AIC (manual -2*ll+2k) = {aic_manual:.6f}")
