# Analysis: logistic regression, outcome = PR (1) vs SD/PD (0), predictors Age + BMI + Gender
# Software: Python, statsmodels Logit (MLE). Reports Wald chi-square p-value for Age.
import pandas as pd
import statsmodels.api as sm
import scipy.stats as st

df = pd.read_excel('/workspace/data/data.xlsx', sheet_name='Sheet1')

# Drop trailing empty rows (rows where Sequence number is NaN) -> n = 80
df = df.dropna(subset=['Sequence number']).reset_index(drop=True)
print("n =", len(df))

# Binary outcome: PR = 1, SD or PD = 0
df['PR'] = (df['Efficacy'] == 'PR').astype(int)
print("Outcome: PR=1:", df['PR'].sum(), " PR=0:", (1 - df['PR']).sum())

# Covariates: Age and BMI continuous; Gender Female=1, Male=0
df['Age'] = df['Age'].astype(float)
df['Female'] = (df['Gender'] == 'Female').astype(int)
print("Age range:", df['Age'].min(), "-", df['Age'].max())
print("BMI range:", df['BMI'].min(), "-", df['BMI'].max())
print("Female=1:", df['Female'].sum(), " Male=0:", (1 - df['Female']).sum())

X = sm.add_constant(df[['Age', 'BMI', 'Female']])
model = sm.Logit(df['PR'], X).fit(disp=0)
print(model.summary())

age_z = model.tvalues['Age']
age_p = model.pvalues['Age']
print()
print("Age: coef =", model.params['Age'], " z =", age_z,
      " Wald chi2 (df=1) =", age_z**2, " P>|z| =", age_p)
print("Cross-check p via chi2.sf:", st.chi2.sf(age_z**2, 1))
