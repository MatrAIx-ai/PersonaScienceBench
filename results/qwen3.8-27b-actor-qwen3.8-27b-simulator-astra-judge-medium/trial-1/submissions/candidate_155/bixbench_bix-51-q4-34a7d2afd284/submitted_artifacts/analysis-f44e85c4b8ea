"""
Logistic regression: remission ~ Age + BMI + Gender
Question: change in log-odds of remission per one-year increase in age.
"""
import warnings
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

# ---- Load ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
print("Raw sheet shape:", df.shape)

# ---- Drop the 41 empty trailing rows (keep only real data: Sequence number present) ----
real = df[df['Sequence number'].notna()].copy().reset_index(drop=True)
print("Rows after dropping empty trailing rows (n):", len(real))

# ---- Build binary outcome: remission = 1 if Efficacy == 'PR' else 0 (PD/SD = 0) ----
real['remission'] = (real['Efficacy'] == 'PR').astype(int)
print("Remission split: remission=%d, non-remission=%d" %
      (int(real['remission'].sum()), int((real['remission'] == 0).sum())))

# ---- Predictors ----
real['Age'] = pd.to_numeric(real['Age'], errors='raise')          # continuous, not centered
real['BMI'] = pd.to_numeric(real['BMI'], errors='raise')          # continuous
real['Gender_male'] = (real['Gender'] == 'Male').astype(int)       # Female=0 (ref), Male=1

# Sanity: no missing in the four fields
print("Missing in used fields:",
      int(real[['remission', 'Age', 'BMI', 'Gender_male']].isna().sum().sum()))

# ---- Fit logistic regression (main effects + intercept) ----
with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    model = smf.logit('remission ~ Age + BMI + Gender_male', data=real).fit()
    fit_warnings = [str(w.message) for w in wlist]

print("\nConverged:", model.mle_retvals['converged'])
print("Fit method:", model.method)
print("Number of iterations:", model.mle_retvals.get('iterations', None))
print("Warnings during fit: %d" % len(fit_warnings))
for w in fit_warnings:
    print("  WARNING:", w)

print("\n=== Model summary ===")
print(model.summary())

# ---- Extract Age coefficient (the answer) ----
age_coef = model.params['Age']
age_se = model.bse['Age']
conf = model.conf_int().loc['Age']
age_p = model.pvalues['Age']

print("\n=== ANSWER: Age coefficient ===")
print("Age coef (log-odds of remission per +1 year): %.6f" % age_coef)
print("SE: %.6f" % age_se)
print("95%% CI: [%.6f, %.6f]" % (conf.iloc[0], conf.iloc[1]))
print("p-value: %.6g" % age_p)
print("Odds ratio per +1 year: %.6f" % np.exp(age_coef))

# Full coefficient table
print("\n=== All coefficients ===")
tab = pd.DataFrame({'coef': model.params, 'SE': model.bse,
                    'CI_low': model.conf_int()[0].values,
                    'CI_high': model.conf_int()[1].values,
                    'p': model.pvalues})
print(tab.to_string())
