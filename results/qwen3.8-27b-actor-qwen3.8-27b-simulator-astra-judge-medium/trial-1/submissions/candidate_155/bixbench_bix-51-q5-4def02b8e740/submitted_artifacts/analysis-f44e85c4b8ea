"""
BixBench bix-51-q5
Question: Using a logistic regression model, what is the p-value for evaluating
          the null hypothesis that BMI is not associated with treatment response?

Approach (approved by researcher):
  - Response: RECIST coding -> Responder=1 (Efficacy in {CR, PR}), Non-responder=0 (SD/PD)
  - Predictor: BMI, entered as a continuous variable
  - Model: univariate logistic regression Responder ~ BMI (no covariates)
  - Primary test: Wald test p-value on the BMI coefficient
  - Cross-check: likelihood-ratio test p-value (full model vs intercept-only)
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from scipy import stats

# ---------------------------------------------------------------- load & clean
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
# The file has 41 fully-empty trailing rows + 1 stray empty row; keep only real records.
df = df.dropna(how="all").reset_index(drop=True)
df = df[df["Sequence number"].notna()].reset_index(drop=True)
df = df.reset_index(drop=True)
print("Analysis set:", df.shape)

# --------------------------------------------------------- response coding
df["Responder"] = np.where(df["Efficacy"].isin(["CR", "PR"]), 1, 0)
print("Responder (1=PR)     :", int(df["Responder"].sum()))
print("Non-responder (SD/PD):", int((1 - df["Responder"]).sum()))

# ------------------------------------------------------------- fit model
X = sm.add_constant(df["BMI"].astype(float))
y = df["Responder"].astype(int)
model = sm.Logit(y, X).fit(disp=0)

print("\n==================== MODEL SUMMARY ====================")
print(model.summary())

# -------------------------------------------------------- extract key stats
b = model.params["BMI"]
se = model.bse["BMI"]
z = model.tvalues["BMI"]
p_wald = model.pvalues["BMI"]
ci = model.conf_int().loc["BMI"]
odds_ratio = np.exp(b)
ci_or = np.exp(ci)

print("\n==================== KEY RESULT (BMI) ====================")
print(f"Coefficient (log-odds)      : {b:.6f}")
print(f"Standard error              : {se:.6f}")
print(f"z-statistic                 : {z:.6f}")
print(f"p-value (Wald)  [PRIMARY]   : {p_wald:.6f}")
print(f"95% CI (log-odds)           : [{ci[0]:.6f}, {ci[1]:.6f}]")
print(f"Odds ratio                  : {odds_ratio:.6f}")
print(f"95% CI (odds ratio)         : [{ci_or[0]:.6f}, {ci_or[1]:.6f}]")

print("\n==================== MODEL METRICS ====================")
print(f"n (obs)                : {int(model.nobs)}")
print(f"Pseudo R-squared       : {model.prsquared:.6f}")
print(f"Log-likelihood (full)  : {model.llf:.6f}")
print(f"AIC                    : {model.aic:.4f}")
print(f"BIC                    : {model.bic:.4f}")

# ------------------------------------------------- LRT cross-check (vs intercept-only)
null_model = sm.Logit(y, np.ones(len(y))).fit(disp=0)
lrt_stat = 2 * (model.llf - null_model.llf)
p_lrt = float(stats.chi2.sf(lrt_stat, df=1))
print(f"\nLRT statistic            : {lrt_stat:.6f}")
print(f"p-value (LRT) [cross-check]: {p_lrt:.6f}")

print("\n==================== FINAL ANSWER ====================")
print(f"p-value (Wald, BMI) = {p_wald:.6f}")
print(f"p-value (LRT)       = {p_lrt:.6f}")
