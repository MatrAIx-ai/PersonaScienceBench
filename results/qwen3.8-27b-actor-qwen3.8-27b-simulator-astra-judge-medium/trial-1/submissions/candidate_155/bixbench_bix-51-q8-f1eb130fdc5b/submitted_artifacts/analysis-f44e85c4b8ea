"""
BixBench bix-51-q8: simple logistic regression, camrelizumab response ~ Age.
Approved plan: drop padding rows, response = (Efficacy == 'PR'), single-predictor
logit on raw Age, statsmodels. Secondary: standardised-age coefficient and
Groups(1/2) outcome cross-check.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# (1) Load and clean
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
n_raw = len(df)
d = df[df['Sequence number'].notna()].reset_index(drop=True)
d['Age_num'] = pd.to_numeric(d['Age'], errors='coerce')
assert len(d) == 80, len(d)
assert d['Age_num'].notna().all()
assert ((d['Age_num'] < 0) | (d['Age_num'] > 120)).sum() == 0

# (2) Binary outcome: response = PR
y = (d['Efficacy'] == 'PR').astype(int)
print(f"rows kept: {len(d)} (dropped {n_raw - len(d)} padding rows)")
print(f"events (PR=1): {y.sum()}, non-events: {(1-y).sum()}")
print(f"Age: min={d['Age_num'].min()}, max={d['Age_num'].max()}, "
      f"mean={d['Age_num'].mean():.4f}, sd={d['Age_num'].std(ddof=1):.4f}")

# (3) Single-predictor logistic regression on raw Age
X = sm.add_constant(d['Age_num'])
model = sm.Logit(y, X).fit(disp=0)
print("\n=== Primary model: y ~ Age (raw years) ===")
print(model.summary2().tables[1])
print(f"nobs = {model.nobs:.0f}")
print(f"log-likelihood = {model.llf:.6f}")

beta = model.params['Age_num']
se = model.bse['Age_num']
z = model.tvalues['Age_num']
p = model.pvalues['Age_num']
print(f"\nAge coefficient (log-odds per 1 year) = {beta:.6f}")
print(f"  SE = {se:.6f}, z = {z:.6f}, p = {p:.6f}")
print(f"Intercept = {model.params['const']:.6f} (SE {model.bse['const']:.6f}, "
      f"z {model.tvalues['const']:.6f}, p {model.pvalues['const']:.6f})")

# (5a) Standardised-age coefficient
sd_age = d['Age_num'].std(ddof=1)
print(f"\nStandardised-age coefficient (raw x SD, SD={sd_age:.4f}) = {beta*sd_age:.6f}")

# (5b) Cross-check with Groups(1/2) as outcome
y2 = (d['Groups'] == 1).astype(int)
model2 = sm.Logit(y2, X).fit(disp=0)
print(f"\nCross-check outcome Groups(1/2): Age coeff = {model2.params['Age_num']:.6f}, "
      f"identical to primary: {np.isclose(model2.params['Age_num'], beta)}")

# odds ratio for context
print(f"\nOdds ratio per 1-year increase = {np.exp(beta):.4f}")
