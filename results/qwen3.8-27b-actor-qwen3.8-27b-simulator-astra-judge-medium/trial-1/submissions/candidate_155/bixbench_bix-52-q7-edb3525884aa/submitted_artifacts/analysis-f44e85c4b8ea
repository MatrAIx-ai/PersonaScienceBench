import pandas as pd

# Load Zebra Finch methylation data
df = pd.read_csv('data/ZF_AgeRelated_CpG_noMT_Final.csv')

print("=" * 60)
print("Zebra Finch CpG Methylation Filter Analysis")
print("=" * 60)
print(f"File: ZF_AgeRelated_CpG_noMT_Final.csv")
print(f"Total rows: {len(df)}")
print(f"Total unique sites (Pos): {df['Pos'].nunique()}")
print(f"MethylationPercentage range: [{df['MethylationPercentage'].min()}, {df['MethylationPercentage'].max()}]")
print(f"MethylationPercentage scale: 0-100 percentage")
print()

# Flag rows where methylation is extreme: strictly >90 OR strictly <10
df['extreme'] = (df['MethylationPercentage'] > 90) | (df['MethylationPercentage'] < 10)

print(f"Rows with methylation > 90: {(df['MethylationPercentage'] > 90).sum()}")
print(f"Rows with methylation < 10: {(df['MethylationPercentage'] < 10).sum()}")
print(f"Rows flagged extreme (>90 or <10): {df['extreme'].sum()}")
print(f"Rows NOT extreme (10 <= m <= 90): {(~df['extreme']).sum()}")
print()

# Boundary diagnostics
exact_10 = (df['MethylationPercentage'] == 10.0).sum()
exact_90 = (df['MethylationPercentage'] == 90.0).sum()
print(f"Rows at exactly 10.0%: {exact_10}")
print(f"Rows at exactly 90.0%: {exact_90}")
print()

# Group by site (Pos): a site is KEPT if at least one row is extreme
# A site is REMOVED if NO row is extreme (all rows in [10, 90])
site_extreme = df.groupby('Pos')['extreme'].any()

total_sites = len(site_extreme)
kept_sites = site_extreme.sum()
removed_sites = (~site_extreme).sum()

print("=" * 60)
print("RESULTS")
print("=" * 60)
print(f"Total unique sites:        {total_sites}")
print(f"Sites kept (any row >90 or <10): {kept_sites}")
print(f"Sites REMOVED (no row >90 or <10): {removed_sites}")
print()
print(f"ANSWER: {removed_sites} sites are removed")
print("=" * 60)
