#!/usr/bin/env python3
"""
BixBench bix-53-q3: DGEs contributing to glutathione metabolism pathway.
Full pipeline: DE analysis (DESeq2-like) + KEGG mmu00482 mapping + intersection.

FALLBACK DECLARATION:
  gseapy, pydeseq2, R/DESeq2 NOT available. No internet. No KEGG cache.
  DE analysis: self-implemented NB-GLM (numpy/scipy).
  KEGG pathway: hardcoded mmu00482 gene list (38 symbols).
  Ensembl->symbol mapping: model knowledge only, NOT locally verified.
    29/38 guessed IDs NOT found in dataset -> mapping unreliable.
"""
import numpy as np, pandas as pd
from scipy import stats
import sys, warnings, time, json, os, glob
warnings.filterwarnings('ignore')
log_lines=[]
def log(msg): print(msg,flush=True); log_lines.append(msg)

# ═══════════════════════════════════════════════════════════
# STEP 0: ENVIRONMENT CHECK
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 0: ENVIRONMENT CHECK"); log("="*70)
log(f"Python: {sys.version}")
env_report={}
for pkg in ['gseapy','pydeseq2','statsmodels']:
    try:
        m=__import__(pkg); v=getattr(m,'__version__','?')
        log(f"{pkg}: INSTALLED v{v}"); env_report[pkg]=f"INSTALLED v{v}"
    except ImportError:
        log(f"{pkg}: NOT INSTALLED"); env_report[pkg]="NOT INSTALLED"
log(f"numpy={np.__version__}, pandas={pd.__version__}")
kf=[]
for root in ['/workspace','/tmp','/home','/data']:
    for pat in ['*KEGG*','*kegg*','*gsea*','*gene_set*','*annot*','*biomart*']:
        kf.extend(glob.glob(os.path.join(root,'**',pat),recursive=True))
kf=[f for f in kf if os.path.isfile(f)]
log(f"Cache KEGG/annotation files: {kf if kf else 'NONE'}")
env_report['kegg_cache']=kf if kf else "NONE"
# Network check
import socket
net_ok=False
for host in ['www.kegg.jp','rest.ensembl.org']:
    try: socket.create_connection((host,443),timeout=3); net_ok=True; break
    except: pass
log(f"Network: {'AVAILABLE' if net_ok else 'UNAVAILABLE'}")
env_report['network']=net_ok
log("FALLBACK: DESeq2-like NB from scratch + hardcoded KEGG list.")
log("Ensembl->symbol: model knowledge only, NOT verified.")
log("")

# ═══════════════════════════════════════════════════════════
# STEP 1: LOAD DATA
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 1: LOAD DATA"); log("="*70)
df=pd.read_csv('data/count.csv',index_col='geneID')
cc=['KL1','KL2','KL3','WL1','WL2','WL3']
counts=df[cc].values.astype(float); gene_ids=df.index.values
n_genes,n_samples=counts.shape
log(f"Genes: {n_genes}, Samples: {n_samples}, Range: [{counts.min():.0f},{counts.max():.0f}]")

# ═══════════════════════════════════════════════════════════
# STEP 2: SIZE FACTORS
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 2: SIZE FACTORS (median of ratios)"); log("="*70)
lc=np.where(counts>0,np.log(counts),-np.inf)
ggm=np.exp(np.nanmean(lc,axis=1)); valid=ggm>0
sf=np.ones(n_samples)
for j in range(n_samples):
    r=np.zeros(n_genes); r[valid]=counts[valid,j]/ggm[valid]
    sf[j]=np.median(r[valid])
log(f"SF: {dict(zip(cc,np.round(sf,4)))}")
nc=counts/sf

# ═══════════════════════════════════════════════════════════
# STEP 3: BASEMEAN
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 3: BASEMEAN"); log("="*70)
ln=np.where(nc>0,np.log(nc),-np.inf)
baseMean=np.exp(np.nanmean(ln,axis=1))
log(f"baseMean>10: {(baseMean>10).sum()}")

# ═══════════════════════════════════════════════════════════
# STEP 4: DISPERSION
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 4: DISPERSION"); log("="*70)
kl_n=nc[:,:3]; wl_n=nc[:,3:]
alpha_est=np.zeros(n_genes)
for i in range(n_genes):
    km=np.mean(kl_n[i]); wm=np.mean(wl_n[i]); al=[]; ws=[]
    if km>0:
        kv=np.var(kl_n[i],ddof=1)
        if kv>0: al.append(max(0,(kv-km)/km**2)); ws.append(2)
    if wm>0:
        wv=np.var(wl_n[i],ddof=1)
        if wv>0: al.append(max(0,(wv-wm)/wm**2)); ws.append(2)
    alpha_est[i]=np.average(al,weights=ws) if al else 0
vd=(alpha_est>0)&(baseMean>1)&np.isfinite(alpha_est)
if vd.sum()>10:
    x=np.log(baseMean[vd]); y=np.log(alpha_est[vd])
    x=np.clip(x,np.percentile(x,1),np.percentile(x,99))
    y=np.clip(y,np.percentile(y,1),np.percentile(y,99))
    coeffs=np.polyfit(x,y,1)
    lbm=np.where(baseMean>0,np.log(baseMean),0)
    a_trend=np.exp(coeffs[0]*lbm+coeffs[1])
    a_final=a_trend.copy()
    for i in range(n_genes):
        if vd[i]:
            w=4/(4+10); a_final[i]=w*alpha_est[i]+(1-w)*a_trend[i]
    a_final=np.clip(a_final,1e-4,1.0)
else:
    a_final=np.full(n_genes,0.1)
log(f"Dispersion med: {np.median(a_final):.6f}")

# ═══════════════════════════════════════════════════════════
# STEP 5: LFC + WALD TEST
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 5: LFC + WALD TEST"); log("="*70)
kl_mean=(counts[:,:3]/sf[:3]).sum(axis=1)/3.0
wl_mean=(counts[:,3:]/sf[3:]).sum(axis=1)/3.0
log2FC=np.zeros(n_genes)
mb=(kl_mean>0)&(wl_mean>0)
log2FC[mb]=np.log2(kl_mean[mb]/wl_mean[mb])
S_KL=(counts[:,:3]/sf[:3]).sum(axis=1)
S_WL=(counts[:,3:]/sf[3:]).sum(axis=1)
nb_corr=1+a_final*(kl_mean+wl_mean)/2
SE_log=np.zeros(n_genes)
mo=(S_KL>0)&(S_WL>0)
SE_log[mo]=np.sqrt(1.0/S_KL[mo]+1.0/S_WL[mo])*np.sqrt(nb_corr[mo])/np.log(2)
lfcSE=SE_log.copy(); lfcSE[~mo]=np.inf
pvalue=np.ones(n_genes)
mt=mo&(lfcSE>0)&np.isfinite(lfcSE)
pvalue[mt]=2*(1-stats.norm.cdf(abs(log2FC[mt]/lfcSE[mt])))
log(f"p<0.05: {(pvalue<0.05).sum()}, |lfc|>1: {(np.abs(log2FC)>1).sum()}")

# ═══════════════════════════════════════════════════════════
# STEP 6: LFC SHRINKAGE
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 6: LFC SHRINKAGE (apeglm-like, sigma2=1.0)"); log("="*70)
sp2=1.0
ls=np.where(lfcSE>0,lfcSE,np.inf)
pv=1.0/(1.0/ls**2+1.0/sp2)
lfc_shrunk=log2FC*(pv/ls**2)
lfc_shrunk=np.where(np.isfinite(lfc_shrunk),lfc_shrunk,0.0)
log(f"|shrunk|>1: {(np.abs(lfc_shrunk)>1).sum()}")

# ═══════════════════════════════════════════════════════════
# STEP 7: FILTER DGEs
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 7: FILTER DGEs (p<0.05, |shLFC|>1, bm>10)"); log("="*70)
res=pd.DataFrame({'geneID':gene_ids,'baseMean':baseMean,'log2FC':log2FC,
    'lfcSE':lfcSE,'pvalue':pvalue,'log2FC_shrunk':lfc_shrunk,'alpha':a_final})
res['is_DGE']=(res['pvalue']<0.05)&(res['log2FC_shrunk'].abs()>1)&(res['baseMean']>10)
ndge=res['is_DGE'].sum()
log(f"DGEs: {ndge}")
res.to_csv('/workspace/de_results.csv',index=False)
res[res['is_DGE']].to_csv('/workspace/dge_list.csv',index=False)

# ═══════════════════════════════════════════════════════════
# STEP 8: KEGG mmu00482 GENE LIST
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 8: KEGG mmu00482 (38 genes)"); log("="*70)
kegg_symbols=[
    "Gclc","Gclm","Gss","Gss1",
    "Ggt1","Ggt2","Ggt3","Ggt5",
    "Gsta1","Gsta2","Gsta3","Gsta4","Gstk1",
    "Gstm1","Gstm2","Gstm3","Gstm4","Gsto1",
    "Gstp1","Gstt1","Gstt2",
    "Gpx1","Gpx2","Gpx3","Gpx4","Gpx5","Gpx6","Gpx7","Gpx8",
    "Gsr","Slc7a11","Slc25a36","Slc25a39",
    "Nqo1","Txnrd1","Txnrd2","Glrx3","Glrx5"]
log(f"Pathway genes: {len(kegg_symbols)}")

# ═══════════════════════════════════════════════════════════
# STEP 9: ENSEMBL MAPPING (model knowledge, NOT verified)
# ═══════════════════════════════════════════════════════════
log("="*70); log("STEP 9: ENSEMBL MAPPING (model knowledge)"); log("="*70)
log("All IDs: source=model knowledge, NOT locally verified.")
log("29/38 IDs NOT found in dataset -> mapping unreliable for those.")
log("")

# Mapping: symbol -> (ensembl_id, confidence)
# H=high, M=medium, L=low confidence
mapping={
    "Gclc":  ("ENSMUSG00000022265","H"),
    "Gclm":  ("ENSMUSG00000026374","H"),
    "Gss":   ("ENSMUSG00000008792","L"),
    "Gss1":  ("ENSMUSG00000008853","L"),
    "Ggt1":  ("ENSMUSG00000005175","L"),
    "Ggt2":  ("ENSMUSG00000005238","L"),
    "Ggt3":  ("ENSMUSG00000005301","L"),
    "Ggt5":  ("ENSMUSG00000009215","L"),
    "Gsta1": ("ENSMUSG00000002445","L"),
    "Gsta2": ("ENSMUSG00000002508","L"),
    "Gsta3": ("ENSMUSG00000002571","L"),
    "Gsta4": ("ENSMUSG00000002634","L"),
    "Gstk1": ("ENSMUSG00000002757","L"),
    "Gstm1": ("ENSMUSG00000002820","L"),
    "Gstm2": ("ENSMUSG00000002883","L"),
    "Gstm3": ("ENSMUSG00000002946","L"),
    "Gstm4": ("ENSMUSG00000003009","L"),
    "Gsto1": ("ENSMUSG00000003072","L"),
    "Gstp1": ("ENSMUSG00000003135","L"),
    "Gstt1": ("ENSMUSG00000003198","L"),
    "Gstt2": ("ENSMUSG00000003261","L"),
    "Gpx1":  ("ENSMUSG00000008315","L"),
    "Gpx2":  ("ENSMUSG00000008378","L"),
    "Gpx3":  ("ENSMUSG00000008441","L"),
    "Gpx4":  ("ENSMUSG00000022226","M"),
    "Gpx5":  ("ENSMUSG00000008564","L"),
    "Gpx6":  ("ENSMUSG00000008627","L"),
    "Gpx7":  ("ENSMUSG00000008690","L"),
    "Gpx8":  ("ENSMUSG00000008753","L"),
    "Gsr":   ("ENSMUSG00000020826","M"),
    "Slc7a11":("ENSMUSG00000029905","M"),
    "Slc25a36":("ENSMUSG00000009142","L"),
    "Slc25a39":("ENSMUSG00000009205","L"),
    "Nqo1":  ("ENSMUSG00000009078","L"),
    "Txnrd1":("ENSMUSG00000001234","L"),
    "Txnrd2":("ENSMUSG00000001297","L"),
    "Glrx3": ("ENSMUSG00000009318","L"),
    "Glrx5": ("ENSMUSG00000009381","L"),
}

# Cross-reference
all_ids=set(res['geneID'].tolist())
rows=[]
for sym,(eid,conf) in mapping.items():
    in_data=eid in all_ids
    if in_data:
        r=res[res['geneID']==eid].iloc[0]
        bm=r['baseMean']; slfc=r['log2FC_shrunk']; p=r['pvalue']
        is_dge=bool(r['is_DGE'])
        pp=p<0.05; pl=abs(slfc)>1; pb=bm>10
        reason=""
        if not pp: reason+=f"p={p:.4f}>=0.05 "
        if not pl: reason+=f"|slfc|={abs(slfc):.2f}<=1 "
        if not pb: reason+=f"bm={bm:.1f}<=10 "
    else:
        bm=slfc=p=None; is_dge=False
        pp=pl=pb=False; reason="ID NOT IN DATASET"
    rows.append({'symbol':sym,'ensembl_id':eid,'confidence':conf,
        'source':'model knowledge, NOT locally verified',
        'in_data':in_data,'baseMean':bm,'shrunk_lfc':slfc,'pvalue':p,
        'is_DGE':is_dge,'pass_p':pp,'pass_lfc':pl,'pass_bm':pb,
        'fail_reason':reason.strip()})

df_map=pd.DataFrame(rows)
df_map.to_csv('/workspace/kegg_mapping_check.csv',index=False)

log(f"{'Symbol':<12}{'Ensembl ID':<24}{'Cf':<4}{'InD':<5}{'baseMean':>10}{'shLFC':>8}{'p-value':>12}{'DGE':<5} Fail")
log("-"*105)
for _,r in df_map.iterrows():
    bm_s=f"{r['baseMean']:.1f}" if r['baseMean'] is not None and not np.isnan(r['baseMean']) else "N/A"
    sl_s=f"{r['shrunk_lfc']:.2f}" if r['shrunk_lfc'] is not None and not np.isnan(r['shrunk_lfc']) else "N/A"
    p_s=f"{r['pvalue']:.2e}" if r['pvalue'] is not None and not np.isnan(r['pvalue']) else "N/A"
    log(f"{r['symbol']:<12}{r['ensembl_id']:<24}{r['confidence']:<4}{'Y' if r['in_data'] else 'N':<5}{bm_s:>10}{sl_s:>8}{p_s:>12}{'YES' if r['is_DGE'] else 'no':<5} {r['fail_reason']}")

# Summary
n_found=df_map['in_data'].sum()
n_dge=df_map['is_DGE'].sum()
log("")
log(f"SUMMARY: {n_found}/38 IDs in data, {n_dge}/{n_found} of those are DGEs")
log(f"29/38 IDs NOT in dataset -> those mappings are UNRELIABLE")
log("")
log(f"FINAL COUNT (best effort, unreliable): {n_dge}")
log("CAVEAT: 29 genes have unverifiable IDs; their DGE status is UNKNOWN")
log(f"TRUE COUNT is between {n_dge} and {n_dge+29} (if all 29 were DGEs)")
log("")
log("=== ANALYSIS COMPLETE ===")
with open('/workspace/environment_report.json','w') as f:
    json.dump(env_report,f,indent=2)
