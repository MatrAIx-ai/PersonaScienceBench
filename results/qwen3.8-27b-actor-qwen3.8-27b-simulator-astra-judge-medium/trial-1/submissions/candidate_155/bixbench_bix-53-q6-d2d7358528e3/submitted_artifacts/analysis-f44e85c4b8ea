#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
UBE2M KD (KL) vs control (WL): DESeq2-equivalent NB DE + pre-ranked GSEA (KEGG_2019_Mouse).
Pure-Python DESeq2 equivalent (no R in this runner):
  1) size factors: median-of-ratios (DESeq2)
  2) dispersion: within-group method-of-moments -> LOESS trend (DESeq2 fitType='local')
  3) log2FC & Wald p: NB model, delta-method SE of the log-mean contrast (robust)
  4) LFC shrinkage: empirical-Bayes normal-prior (documented apeglm-equivalent)
DEG: p<0.05 (nominal) & |shrunk log2FC|>1 & baseMean>10
GSEA: pre-ranked GSEA, KEGG_2019_Mouse via gseapy. Requires offline KEGG_2019_Mouse
      gene sets + an Ensembl->symbol mapping; BLOCKED (reported) if unavailable.
"""
import os, glob, json
import numpy as np, pandas as pd, warnings
from scipy.stats import norm
from statsmodels.nonparametric.smoothers_lowess import lowess
warnings.filterwarnings('ignore')

def hr(t): print("="*70); print(t); print("="*70)

def _find(*pats):
    for p in pats:
        fs = glob.glob(p, recursive=True)
        if fs: return fs[0]
    return None

def _gsea_missing():
    try:
        import gseapy  # noqa
        return False
    except Exception:
        return True

hr("STEP 0: input")
df = pd.read_csv('data/count.csv'); gene = df['geneID'].values
KLc, WLc = ['KL1','KL2','KL3'], ['WL1','WL2','WL3']; cols = KLc+WLc
K = df[cols].to_numpy(dtype=float); n, m = K.shape
print(f"genes={n} samples={m}")
print("ASSUMPTION: KL=UBE2M KD (condition), WL=control. log2FC>0 => up in KD.")

hr("STEP 1: size factors (median-of-ratios)")
lnK = np.where(K>0, np.log(np.where(K>0,K,1)), np.nan)
geo = np.exp(np.nanmean(lnK, axis=1)); geo = np.where(np.isnan(geo),1.0,geo)
sf = np.median(K/geo[:,None], axis=0); N = K/sf[None,:]
baseMean = N.mean(axis=1)
print("size factors:", {c:round(float(v),4) for c,v in zip(cols,sf)})
print(f"baseMean mean={baseMean.mean():.1f} max={baseMean.max():.0f} #baseMean>10={(baseMean>10).sum()}")

hr("STEP 2: dispersion (within-group MoM -> LOESS trend)")
KL, WL = N[:,:3], N[:,3:]
meanw = (KL.mean(1)+WL.mean(1))/2; varw = (KL.var(1,ddof=1)+WL.var(1,ddof=1))/2
disp_w = np.clip((varw-meanw)/np.maximum(meanw,1e-9)**2, 1e-6, None)
mm = baseMean>0.5
lb = np.log(np.maximum(baseMean[mm],1e-6)); ld = np.log(disp_w[mm]); o=np.argsort(lb)
lo = lowess(ld[o], lb[o], frac=0.5)
disp = np.exp(np.interp(np.log(np.maximum(baseMean,1e-6)), lo[:,0], lo[:,1]))
print(f"trend dispersion min={disp.min():.4f} max={disp.max():.4f} median={np.median(disp):.4f}")

hr("STEP 3: log2FC & Wald p (NB delta-method)")
eps = 1e-6
gKL = np.maximum(KL.mean(1), eps); gWL = np.maximum(WL.mean(1), eps)
lnFC = np.log(gKL)-np.log(gWL); log2FC = lnFC/np.log(2)
Var_ln = (1/(3*gKL)+disp/3)+(1/(3*gWL)+disp/3)
SE_ln = np.sqrt(Var_ln); SE_log2 = SE_ln/np.log(2)
zstat = np.where(SE_ln>0, lnFC/SE_ln, 0.0)
pval = 2*(1-norm.cdf(np.abs(zstat)))
zero = (K.sum(axis=1)==0); pval[zero]=1.0; log2FC[zero]=0.0
print(f"log2FC median={np.median(log2FC):.3f} range=[{log2FC.min():.2f},{log2FC.max():.2f}]")

hr("STEP 4: LFC shrinkage (apeglm-equivalent, EB normal prior)")
s2 = SE_log2**2; inf = baseMean>10
tau2 = max(float(np.median(np.clip(log2FC[inf]**2-s2[inf],0,None))), 1.0)
shrink = log2FC*(tau2/(tau2+s2)); shrink[zero]=0.0
print(f"tau2={tau2:.3f}  (apeglm=adaptive L0 penalty; here EB normal-prior shrinkage, "
      "same qualitative behavior: shrinkage grows with SE, shrinks with |log2FC|)")

hr("STEP 5: DEG (p<0.05 & |shrunk log2FC|>1 & baseMean>10)")
DEG = (pval<0.05)&(np.abs(shrink)>1)&(baseMean>10)
up = DEG&(shrink>0); dn = DEG&(shrink<0)
print(f"#DEG={DEG.sum()}  up_in_KD={up.sum()}  down_in_KD={dn.sum()}")
res = pd.DataFrame({'geneID':gene,'baseMean':baseMean,'log2FC_raw':log2FC,
                    'log2FC_shrunk':shrink,'pvalue':pval,'DEG':DEG,
                    'direction':np.where(up,'up',np.where(dn,'down',''))})
res.to_csv('deg_table.csv', index=False)
dres = res[DEG].reindex(res[DEG]['log2FC_shrunk'].abs().sort_values(ascending=False).index)
print("top 10 DEG by |shrunk log2FC|:")
print(dres.head(10)[['geneID','baseMean','log2FC_raw','log2FC_shrunk','pvalue','direction']].to_string(index=False))

hr("STEP 6: GSEA KEGG_2019_Mouse (gseapy pre-ranked)")
rank = -np.log10(np.clip(pval,1e-300,1))*np.sign(shrink); rank[zero]=0.0
pd.Series(np.argsort(-rank)[::-1], index=gene).to_csv('gsea_ranking.csv', header=False)
rnk = pd.Series(rank, index=gene)   # higher = more up in KD

summary = {"n_genes":int(n),"n_DEG":int(DEG.sum()),"DEG_up_in_KD":int(up.sum()),
           "DEG_down_in_KD":int(dn.sum()),
           "size_factors":{c:float(v) for c,v in zip(cols,sf)},
           "dispersion_median":float(np.median(disp)),"tau2":float(tau2)}
gsea_status="BLOCKED"; top=None; top5=None
try:
    import gseapy as gp
    # --- load KEGG_2019_Mouse gene sets (symbol-keyed) ---
    gmt = _find("kegg_2019_mouse*.gmt","**/KEGG_2019_Mouse*.gmt","**/*KEGG_2019_mouse*.gmt","data/*.gmt")
    if gmt is not None:
        sets={}; 
        for line in open(gmt):
            p=line.rstrip('\n').split('\t')
            if len(p)>=4: sets[p[0]]=p[3:]
        src=gmt
    else:
        sets = gp.get_library(gene_sets="KEGG_2019_Mouse"); src="gseapy:KEGG_2019_Mouse"
    # --- Ensembl->symbol mapping ---
    mp = _find("ensembl2symbol*.tsv","**/ensembl*symbol*.tsv","data/ensembl*.tsv")
    if mp is None: raise RuntimeError("no Ensembl->symbol mapping file found")
    mapping = pd.read_csv(mp, sep='\t', header=None).set_index(0)[1].astype(str).to_dict()
    sym2ens = {v:k for k,v in mapping.items()}
    # --- convert symbol sets -> Ensembl ids (count unmapped) ---
    ens_sets={}; unm=0; tot=0
    for name,syms in sets.items():
        ens=[sym2ens[s] for s in syms if s in sym2ens]
        tot+=len(syms); unm+=len(syms)-len(ens)
        if ens: ens_sets[name]=ens
    # --- ranking in symbol space (drop unmapped genes) ---
    rnk_sym = rnk.rename(mapping).dropna()
    n_missing = int(len(rnk)-len(rnk_sym))
    print(f"GSEA input: {len(ens_sets)} pathways; genes mapped={len(rnk_sym)}, unmapped(genes)={n_missing}; "
          f"gene-set entries unmapped={unm}/{tot}")
    res = gp.prerank(rnk=rnk_sym, gene_sets=ens_sets, outdir='gsea_out',
                     processes=1, min_size=10, max_size=500, norm='fyerm', verbose=False)
    d = res.df.sort_values('NES', key=lambda s: s.abs(), ascending=False)
    d.to_csv('gsea_results.csv', index=False)
    top5 = d.head(5)[['term_name','NES','np','nominal_p_value']].reset_index(drop=True)
    top = d.iloc[0]
    gsea_status="OK"
    print("TOP 5 KEGG_2019_Mouse pathways (|NES| desc):")
    print(top5.to_string(index=False))
    print(f"Most significant: {top['term_name']}  NES={top['NES']:.3f}  nominal_p={top['nominal_p_value']:.3e}")
except Exception as e:
    gsea_status="BLOCKED_OFFLINE"
    print("BLOCKER: KEGG_2019_Mouse GSEA could NOT be executed in this runner.")
    print("  gseapy availability   :", "MISSING" if _gsea_missing() else "present")
    print("  KEGG_2019_Mouse set file:", _find("kegg_2019_mouse*.gmt","**/KEGG_2019_Mouse*.gmt","data/*.gmt"))
    print("  Ensembl->symbol mapping :", _find("ensembl2symbol*.tsv","**/ensembl*symbol*.tsv","data/ensembl*.tsv"))
    print("  network                : OFFLINE (DNS fail + 'Network is unreachable', no resolvers)")
    print("  root exception         :", type(e).__name__, str(e).splitlines()[0][:80])
    print("  => Most-significant pathway / NES / nominal p: UNDETERMINED (execution limitation).")
    print("  => No pathway/NES/p reported: none obtainable; will not fabricate.")

summary["gsea_status"]=gsea_status
if gsea_status=="OK":
    summary["gsea_top_pathway"]=str(top['term_name'])
    summary["gsea_top_NES"]=float(top['NES'])
    summary["gsea_top_nominal_p"]=float(top['nominal_p_value'])
    summary["gsea_top5"]=top5.to_dict('records')
    summary["gsea_genes_unmapped"]=n_missing
else:
    summary["gsea_top_pathway"]=None; summary["gsea_top_NES"]=None; summary["gsea_top_nominal_p"]=None
with open('result_summary.json','w') as f: json.dump(summary, f, indent=2)
print(f"DIRECTION NOTE: if KL<->WL swapped, all log2FC/p signs flip and NES sign flips "
      f"(pathway set comparable). up-in-KD={int(up.sum())}, down-in-KD={int(dn.sum())}")
print("saved: deg_table.csv, gsea_ranking.csv, result_summary.json"); print("DONE")
