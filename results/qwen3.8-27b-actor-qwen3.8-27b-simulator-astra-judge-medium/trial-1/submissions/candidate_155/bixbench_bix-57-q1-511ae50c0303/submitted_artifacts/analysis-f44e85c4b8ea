#!/usr/bin/env python3
"""
BixBench bix-57-q1: Percentage of gap characters relative to total alignment
positions across all alignments after aligning with MAFFT with the 'auto' parameter.

Approved protocol:
  (i)  Run `mafft --auto` once per input file (10 independent alignments).
  (ii) Gap character = '-' in the aligned output ('.' also counted as a
       robustness check).
  (iii) Total alignment positions = sum over the 10 alignments of
       (number of columns x number of sequences in that alignment),
       i.e. total cell count over all alignment matrices.
       gap% = total gap chars / total cells * 100.

No Biopython: FASTA parsing is implemented below. If the mafft binary is
unavailable, every per-file attempt is caught and the failure reason is
recorded explicitly (no silent skips).
"""
import os
import shutil
import subprocess
import sys

DATA_DIR = "data"
OUT_DIR = "aligned"

FILES = [
    "1018517at2759.faa", "1010730at2759.faa", "1019762at2759.faa",
    "1038775at2759.faa", "100698at2759.faa", "1003258at2759.faa",
    "1041560at2759.faa", "1065019at2759.faa", "1079827at2759.faa",
    "1014314at2759.faa",
]


def parse_fasta(path):
    """Minimal FASTA parser -> list of (name, sequence)."""
    seqs, name, chunks = [], None, []
    with open(path) as f:
        for line in f:
            line = line.rstrip("\n")
            if line.startswith(">"):
                if name is not None:
                    seqs.append((name, "".join(chunks)))
                name, chunks = line[1:].strip(), []
            elif name is not None:
                chunks.append(line)
    if name is not None:
        seqs.append((name, "".join(chunks)))
    return seqs


def write_fasta(path, seqs):
    with open(path, "w") as f:
        for name, seq in seqs:
            f.write(f">{name}\n")
            for i in range(0, len(seq), 60):
                f.write(seq[i:i + 60] + "\n")


def main():
    os.makedirs(OUT_DIR, exist_ok=True)
    mafft = shutil.which("mafft")
    print(f"mafft binary found at: {mafft}")
    if mafft:
        try:
            ver = subprocess.run([mafft, "--version"], capture_output=True,
                                 text=True, timeout=30)
            print(f"mafft version output: {ver.stdout.strip() or ver.stderr.strip()}")
        except Exception as e:
            print(f"WARNING: could not query mafft version: {e}")

    per_file = []
    failures = []
    for fn in FILES:
        src = os.path.join(DATA_DIR, fn)
        dst = os.path.join(OUT_DIR, fn)
        label = f"[{fn}] "
        try:
            seqs = parse_fasta(src)
            write_fasta(src, seqs)  # normalize (identical content)
            if mafft is None:
                raise FileNotFoundError(
                    "[Errno 2] mafft: binary not found on PATH "
                    "(shutil.which('mafft') returned None; no network to "
                    "install: DNS resolution and outbound TCP both fail)")
            r = subprocess.run([mafft, "--auto", src], capture_output=True,
                               text=True, timeout=600)
            if r.returncode != 0 or not r.stdout.strip():
                raise RuntimeError(
                    f"mafft exit code {r.returncode}; "
                    f"stderr={r.stderr.strip()[:500]!r}; stdout_len={len(r.stdout)}")
            aln = parse_fasta_from_text(r.stdout)
        except FileNotFoundError as e:
            aln = None
            failures.append((fn, f"mafft executable not found: {e}"))
            print(label + "FAILED: " + f"mafft executable not found: {e}")
            per_file.append({"file": fn, "n_seq": len(parse_fasta(src)),
                             "cols": None, "gaps": None, "dots": None,
                             "cells": None, "status": "mafft not found"})
            continue
        except Exception as e:
            aln = None
            failures.append((fn, f"alignment failed: {type(e).__name__}: {e}"))
            print(label + f"FAILED: {type(e).__name__}: {e}")
            per_file.append({"file": fn, "n_seq": None, "cols": None,
                             "gaps": None, "dots": None, "cells": None,
                             "status": "alignment error"})
            continue

        names = [n for n, _ in aln]
        if len(set(names)) != len(names):
            print(label + f"WARNING: duplicate names in alignment: {names}")
        cols = None
        gaps = dots = 0
        for n, s in aln:
            if cols is None:
                cols = len(s)
            elif len(s) != cols:
                raise RuntimeError(f"ragged alignment for {n}: {len(s)} vs {cols}")
            gaps += s.count("-")
            dots += s.count(".")
        cells = cols * len(aln)
        per_file.append({"file": fn, "n_seq": len(aln), "cols": cols,
                         "gaps": gaps, "dots": dots, "cells": cells,
                         "status": "ok"})
        with open(dst, "w") as f:
            f.write(r.stdout)
        print(label + f"ok: n_seq={len(aln)} cols={cols} gaps(-)={gaps} "
                      f"dots(.)={dots} cells={cells}")

    # summary
    ok = [p for p in per_file if p["status"] == "ok"]
    print("\n=== per-file table ===")
    print(f"{'file':<22}{'n_seq':>6}{'cols':>7}{'gaps(-)':>9}{'dots(.)':>9}{'cells':>9}  status")
    for p in per_file:
        print(f"{p['file']:<22}{str(p['n_seq']):>6}{str(p['cols']):>7}"
              f"{str(p['gaps']):>9}{str(p['dots']):>9}{str(p['cells']):>9}  {p['status']}")

    if ok:
        tot_gaps = sum(p["gaps"] for p in ok)
        tot_dots = sum(p["dots"] for p in ok)
        tot_cells = sum(p["cells"] for p in ok)
        pct = 100.0 * tot_gaps / tot_cells
        pct_incl_dots = 100.0 * (tot_gaps + tot_dots) / tot_cells
        print("\n=== summary ===")
        print(f"aligned files: {len(ok)}/{len(FILES)}")
        print(f"total gap characters ('-'): {tot_gaps}")
        print(f"total '.' characters: {tot_dots}")
        print(f"total alignment positions (sum of cols x n_seq): {tot_cells}")
        print(f"gap percentage ('-' only): {pct:.2f}%")
        print(f"gap percentage ('-' + '.', robustness): {pct_incl_dots:.2f}%")
        print(f"FINAL ANSWER: {pct:.2f}%")
    else:
        print("\n=== summary ===")
        print(f"aligned files: 0/{len(FILES)} -- NO ALIGNMENTS PRODUCED")
        print("FAILURES (explicit, no silent skips):")
        for fn, reason in failures:
            print(f"  {fn}: {reason}")
        print("RESULT: percentage CANNOT be computed; mafft --auto could not be "
              "executed in this environment.")
        print("FINAL ANSWER: NOT COMPUTABLE (mafft unavailable)")


def parse_fasta_from_text(text):
    seqs, name, chunks = [], None, []
    for line in text.splitlines():
        if line.startswith(">"):
            if name is not None:
                seqs.append((name, "".join(chunks)))
            name, chunks = line[1:].strip(), []
        elif name is not None and line.strip():
            chunks.append(line)
    if name is not None:
        seqs.append((name, "".join(chunks)))
    return seqs


if __name__ == "__main__":
    main()
