#!/usr/bin/env python3
"""
CHIP Variant Analysis
=====================
Question: What is the average number of CHIP variants per sample after filtering 
          out intronic, intergenic, and UTR variants?

Method:
  1. Read each of the 86 xlsx files in CHIP_DP10_GQ20_PASS/
  2. Skip 2 header rows (group header + column names), data starts at row 3
  3. Identify variant rows: Zygosity in {Heterozygous, Homozygous Variant}
  4. Exclude SO terms: intron_variant, intergenic_variant, 3_prime_UTR_variant,
     5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant
  5. Count remaining variants per sample
  6. Compute average (2 decimal places), min, max, median

Columns used (0-indexed):
  - Col 4 (Zygosity)
  - Col 13 (Sequence Ontology (Combined))
"""

import openpyxl
import os
import statistics
from pathlib import Path

# Configuration
DATA_DIR = Path("data/CHIP_DP10_GQ20_PASS")
ZYGOSITY_COL = 4       # 0-indexed (column 5)
SO_COL = 13            # 0-indexed (column 14)
DATA_START_ROW = 3     # 1-indexed (skip 2 header rows)

# Variant zygosity values (exclude Reference and None)
VARIANT_ZYGOSITY = {"Heterozygous", "Homozygous Variant"}

# SO terms to exclude (intronic, intergenic, UTR + subtypes)
EXCLUDE_SO_TERMS = {
    "intron_variant",
    "intergenic_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}


def analyze_file(filepath: str) -> int:
    """Count CHIP variants in a single sample file after filtering."""
    wb = openpyxl.load_workbook(filepath, data_only=True)
    ws = wb.active
    count = 0
    for row in ws.iter_rows(min_row=DATA_START_ROW, max_row=ws.max_row, values_only=True):
        zygosity = row[ZYGOSITY_COL]
        so_term = row[SO_COL]
        # Must be a variant (not Reference, not None)
        if zygosity not in VARIANT_ZYGOSITY:
            continue
        # Must not be in excluded SO categories
        if so_term in EXCLUDE_SO_TERMS:
            continue
        count += 1
    wb.close()
    return count


def main():
    # Gather all xlsx files
    files = sorted(DATA_DIR.glob("*.xlsx"))
    print(f"Found {len(files)} sample files in {DATA_DIR}")
    print("=" * 70)
    
    per_sample = {}
    for f in files:
        sample_id = f.stem.replace("230209_Exome_GRCh38_CHIP_", "")
        count = analyze_file(str(f))
        per_sample[sample_id] = count
    
    # Compute statistics
    counts = list(per_sample.values())
    n = len(counts)
    avg = sum(counts) / n
    mn = min(counts)
    mx = max(counts)
    med = statistics.median(counts)
    
    # Output per-sample results
    print(f"\n{'Sample ID':<20s} {'Variant Count':>14s}")
    print("-" * 36)
    for sid in sorted(per_sample.keys()):
        print(f"{sid:<20s} {per_sample[sid]:>14d}")
    
    print("-" * 36)
    print(f"\n{'STATISTICS':s}")
    print(f"  Number of samples:  {n}")
    print(f"  Total variants:     {sum(counts)}")
    print(f"  Average per sample: {avg:.2f}")
    print(f"  Min:                {mn}")
    print(f"  Max:                {mx}")
    print(f"  Median:             {med}")
    print(f"  Std Dev (sample):   {statistics.stdev(counts):.2f}")
    
    # Final answer
    print(f"\n{'=' * 70}")
    print(f"ANSWER: The average number of CHIP variants per sample after filtering")
    print(f"        out intronic, intergenic, and UTR variants is {avg:.2f}.")
    print(f"{'=' * 70}")


if __name__ == "__main__":
    main()
