"""
BixBench bix-7-q3: How many CHIP variants remain after removing reference calls?

Method (approved by researcher):
- Load all 86 per-sample CHIP files in data/CHIP_DP10_GQ20_PASS (header row 2, 33 columns).
- Every row is a CHIP variant (In_CHIP=True throughout; no extra gene-list filter).
- A 'reference call' = a row whose Zygosity is exactly 'Reference'; only those rows are removed.
- Blank-zygosity (uncalled) rows are NOT reference calls and remain in the count.
- Answer = total remaining variant rows summed across all 86 files (no de-duplication).
"""
import glob
import os
import pandas as pd

FILES = sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx'))
print(f"Files found: {len(FILES)}")

total_rows = 0
total_reference = 0
total_remaining = 0
zyg_totals = {}
per_file = []

for f in FILES:
    df = pd.read_excel(f, header=1)  # row 1 = group labels, row 2 = column names
    assert len(df.columns) == 33, f"unexpected column count in {f}: {len(df.columns)}"
    assert 'Zygosity' in df.columns and 'In_CHIP' in df.columns, f"missing key columns in {f}"
    assert (df['In_CHIP'].astype(str) == 'True').all(), f"In_CHIP not all-True in {f}"

    n = len(df)
    n_ref = int((df['Zygosity'] == 'Reference').sum())
    n_rem = n - n_ref
    total_rows += n
    total_reference += n_ref
    total_remaining += n_rem
    for z, c in df['Zygosity'].value_counts(dropna=False).items():
        zyg_totals[z] = zyg_totals.get(z, 0) + c
    per_file.append((os.path.basename(f), n, n_ref, n_rem))

print("\nPer-file: file, rows, reference_removed, remaining")
for name, n, r, rem in per_file:
    print(f"{name}: {n}, {r}, {rem}")

print("\nZygosity totals across all files:")
for z, c in sorted(zyg_totals.items(), key=lambda kv: str(kv[0])):
    print(f"  {z!r}: {c}")

print(f"\nTotal variant rows:            {total_rows}")
print(f"Reference-call rows removed:   {total_reference}")
print(f"REMAINING CHIP VARIANT ROWS:   {total_remaining}")
assert total_remaining == total_rows - total_reference
print("\nFinal answer:", total_remaining)
