#!/usr/bin/env python3
"""
Independence test: m6A methylation status vs differential expression (DEG) status
in the bladder cancer MeRIP-RNA dataset (data/MeRIP_RNA_result.xlsx).

Primary: 3x3 Pearson chi-square test of independence on m6A x DEG.
Sensitivity (i): 2x2 merged (m6A sig vs no-sig  x  DEG vs no-DEG), chi2 + Fisher exact.
Sensitivity (ii): 3x3 chi2 after deduplicating to one row per gene_id
                  (rule: first row per gene_id in file order).
"""
import pandas as pd
from scipy import stats

df = pd.read_excel("data/MeRIP_RNA_result.xlsx")
print(f"Loaded MeRIP_RNA_result.xlsx: {df.shape[0]} rows, {df.shape[1]} cols")
print("Missing values per column:\n", df.isna().sum().to_string())

# ---- Primary: 3x3 contingency table ----
tab3 = pd.crosstab(df["m6A"], df["DEG"])
# fix column order
tab3 = tab3[["Down", "Up", "no-DEGs"]]
print("\n=== PRIMARY: 3x3 contingency table (m6A x DEG) ===")
print(tab3.to_string())

chi2, p, dof, expected = stats.chi2_contingency(tab3, correction=False)
print(f"\nChi2 = {chi2:.6f}, dof = {dof}, p = {p:.3e}")
print("Expected counts:\n", pd.DataFrame(expected, index=tab3.index, columns=tab3.columns).round(2).to_string())
print("min expected count:", expected.min())

# ---- Sensitivity (i): 2x2 merged ----
df["m6A_sig"] = df["m6A"].map(lambda x: x != "m6A no sig")
df["DEG_flag"] = df["DEG"].map(lambda x: x != "no-DEGs")
tab2 = pd.crosstab(df["m6A_sig"], df["DEG_flag"])
tab2 = tab2.reindex(index=[False, True], columns=[False, True])
tab2.index = ["m6A no sig", "m6A sig"]
tab2.columns = ["no-DEG", "DEG"]
print("\n=== SENSITIVITY (i): 2x2 merged table ===")
print(tab2.to_string())
chi2_2, p_2, dof_2, exp_2 = stats.chi2_contingency(tab2, correction=False)
print(f"Chi2 = {chi2_2:.6f}, dof = {dof_2}, p = {p_2:.3e}")
# Fisher exact (2x2)
oddsr, p_fisher = stats.fisher_exact(tab2.values)
print(f"Fisher exact: p = {p_fisher:.3e} (odds ratio = {oddsr:.4f})")

# ---- Sensitivity (ii): gene_id level, first row per gene_id ----
df_gene = df.drop_duplicates(subset="gene_id", keep="first")
print(f"\n=== SENSITIVITY (ii): dedup by gene_id (first row per gene in file order) ===")
print(f"Rows after dedup: {len(df_gene)} (unique gene_id = {df_gene['gene_id'].nunique()})")
tab3g = pd.crosstab(df_gene["m6A"], df_gene["DEG"])
tab3g = tab3g[["Down", "Up", "no-DEGs"]]
print(tab3g.to_string())
chi2_g, p_g, dof_g, exp_g = stats.chi2_contingency(tab3g, correction=False)
print(f"Chi2 = {chi2_g:.6f}, dof = {dof_g}, p = {p_g:.3e}")

# ---- Final answer ----
print("\n================ FINAL ANSWER (primary) ================")
print(f"3x3 Pearson chi-square test of independence, m6A x DEG (n = {len(df)}):")
print(f"  chi2 = {chi2:.4f}, dof = {dof}")
print(f"  p-value = {p:.3e}  (scientific notation)")
