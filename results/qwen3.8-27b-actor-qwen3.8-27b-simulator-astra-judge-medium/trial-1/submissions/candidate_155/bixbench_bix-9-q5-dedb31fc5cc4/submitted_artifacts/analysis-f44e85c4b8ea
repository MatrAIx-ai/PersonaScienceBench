#!/usr/bin/env python3
"""
BixBench Q5: In which tissue type do bad responders show the highest number of
significantly differentially expressed (lfc>0.5 and basemean>10) genes compared to controls?

Data: Data_deposition_RNAseq_Paroxetine_2017.xlsx
- Sheet 'Mapping_statistics': sample metadata (90 samples = 3 tissues x 3 groups x 10)
- Sheet 'NormCount': normalized counts + pre-computed DESeq2 results (25,402 genes)

Method:
1. Load NormCount sheet (data starts at row 4, 0-indexed; row 3 = column headers)
2. Determine A/B group direction for each DESeq comparison block by correlating
   log2FC with log2(group_mean_B / group_mean_A) for all 6 possible directed pairs
3. Identify the 'bad_responder vs Control' comparison per tissue
4. Apply filter: log2FoldChange > 0.5 AND baseMean > 10
5. Count qualifying genes per tissue; report the tissue with the highest count
"""

import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# ============================================================
# LOAD DATA
# ============================================================
XLSX = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'

# NormCount: row 0=tissue group headers, row 1=blank, row 2=sub-headers,
#            row 3=column names, row 4+=gene data
nc = pd.read_excel(XLSX, sheet_name='NormCount', header=None, skiprows=4)
print(f"Loaded NormCount: {nc.shape[0]} genes x {nc.shape[1]} columns")

# Mapping statistics for reference
mapping = pd.read_excel(XLSX, sheet_name='Mapping_statistics')
print(f"Loaded Mapping_statistics: {mapping.shape[0]} samples")
print(f"  Response groups: {sorted(mapping['Response'].unique())}")
print(f"  Tissues: {sorted(mapping['Tissue'].unique())}")
print(f"  Samples per tissue/group: " +
      ", ".join(f"{r}/{t}={n}" for (r,t), n in 
               mapping.groupby(['Response','Tissue']).size().items()))

# ============================================================
# TISSUE SAMPLE COLUMN RANGES (0-indexed in NormCount)
# ============================================================
tissue_cols = {
    'baseline_blood': {
        'Control': list(range(2, 12)),
        'good_responder': list(range(12, 22)),
        'bad_responder': list(range(22, 32))
    },
    'dentate_gyrus': {
        'Control': list(range(32, 42)),
        'good_responder': list(range(42, 52)),
        'bad_responder': list(range(52, 62))
    },
    'final_blood': {
        'Control': list(range(62, 72)),
        'good_responder': list(range(72, 82)),
        'bad_responder': list(range(82, 92))
    }
}
tissue_names = ['baseline_blood', 'dentate_gyrus', 'final_blood']

# ============================================================
# STEP 1: DETERMINE A/B DIRECTION FOR EACH COMPARISON BLOCK
# ============================================================
# For each of the 9 DESeq blocks, correlate log2FC with
# log2(groupB_mean) - log2(groupA_mean) for all 6 directed pairs.
# The pair with highest correlation identifies A and B.

print("\n" + "="*70)
print("STEP 1: Determine A/B direction per comparison block")
print("="*70)

comparison_mapping = {}  # comp_idx -> (group_A, group_B)

for comp in range(9):
    start = 98 + comp * 9
    tissue = tissue_names[comp // 3]
    comp_in_tissue = comp % 3 + 1
    
    baseMeanA = pd.to_numeric(nc.iloc[:, start+1], errors='coerce')
    baseMeanB = pd.to_numeric(nc.iloc[:, start+2], errors='coerce')
    log2FC = pd.to_numeric(nc.iloc[:, start+4], errors='coerce')
    
    # Compute per-gene group means (across 10 samples each)
    ctrl_mean = nc.iloc[:, tissue_cols[tissue]['Control']].apply(pd.to_numeric, errors='coerce').mean(axis=1)
    bad_mean = nc.iloc[:, tissue_cols[tissue]['bad_responder']].apply(pd.to_numeric, errors='coerce').mean(axis=1)
    good_mean = nc.iloc[:, tissue_cols[tissue]['good_responder']].apply(pd.to_numeric, errors='coerce').mean(axis=1)
    
    # Mask: sufficient expression in all groups
    mask = (ctrl_mean > 5) & (bad_mean > 5) & (good_mean > 5) & log2FC.notna()
    
    groups_log2 = {
        'Control': np.log2(ctrl_mean[mask].clip(lower=0.1)),
        'bad_responder': np.log2(bad_mean[mask].clip(lower=0.1)),
        'good_responder': np.log2(good_mean[mask].clip(lower=0.1))
    }
    
    log2FC_m = log2FC[mask]
    finite = np.isfinite(log2FC_m)
    
    best_corr = -2
    best_pair = None
    for gA in groups_log2:
        for gB in groups_log2:
            if gA == gB:
                continue
            predicted = groups_log2[gB][finite] - groups_log2[gA][finite]
            actual = log2FC_m[finite]
            corr = np.corrcoef(predicted, actual)[0, 1]
            if corr > best_corr:
                best_corr = corr
                best_pair = (gA, gB)
    
    comparison_mapping[comp] = best_pair
    print(f"  Comp {comp+1} ({tissue}, C{comp_in_tissue}): "
          f"A={best_pair[0]}, B={best_pair[1]} (corr={best_corr:.4f})")

# Summary
print("\n  PATTERN: C1=Control vs Good, C2=Control vs Bad, C3=Bad vs Good")
print("  => 'bad responders vs controls' = C2 per tissue (Comps 2, 5, 8)")

# ============================================================
# STEP 2: APPLY FILTER AND COUNT
# ============================================================
print("\n" + "="*70)
print("STEP 2: Count genes with log2FC > 0.5 AND baseMean > 10")
print("        for bad-responder-vs-control comparisons")
print("="*70)

# bad-vs-control comparisons: Comp 2 (idx 1), Comp 5 (idx 4), Comp 8 (idx 7)
bad_vs_ctrl_comps = [1, 4, 7]

results = {}
gene_lists = {}

for comp_idx in bad_vs_ctrl_comps:
    start = 98 + comp_idx * 9
    tissue = tissue_names[comp_idx // 3]
    
    baseMean = pd.to_numeric(nc.iloc[:, start], errors='coerce')
    log2FC = pd.to_numeric(nc.iloc[:, start+4], errors='coerce')
    pval = pd.to_numeric(nc.iloc[:, start+5], errors='coerce')
    padj = pd.to_numeric(nc.iloc[:, start+6], errors='coerce')
    gene_ids = nc.iloc[:, 1]
    
    # Primary filter: log2FC > 0.5 AND baseMean > 10
    mask = (log2FC > 0.5) & (baseMean > 10) & log2FC.notna() & np.isfinite(log2FC) & np.isfinite(baseMean)
    count = int(mask.sum())
    results[tissue] = count
    gene_lists[tissue] = gene_ids[mask].tolist()
    
    lfc_vals = log2FC[mask]
    bm_vals = baseMean[mask]
    
    print(f"\n  {tissue} (Comp {comp_idx+1}):")
    print(f"    Genes with log2FC > 0.5 AND baseMean > 10: {count}")
    print(f"    log2FC: median={lfc_vals.median():.3f}, range=[{lfc_vals.min():.3f}, {lfc_vals.max():.3f}]")
    print(f"    baseMean: median={bm_vals.median():.2f}, range=[{bm_vals.min():.2f}, {bm_vals.max():.2f}]")
    
    # Supplementary: with padj < 0.05
    mask_strict = mask & (padj < 0.05) & padj.notna()
    print(f"    [Supplementary] Also padj < 0.05: {int(mask_strict.sum())}")

# ============================================================
# FINAL ANSWER
# ============================================================
print("\n" + "="*70)
print("FINAL ANSWER")
print("="*70)
print()
for tissue in tissue_names:
    print(f"  {tissue:20s}: {results[tissue]:4d} genes")
print()
winner = max(results, key=results.get)
print(f"  >>> WINNING TISSUE: {winner} with {results[winner]} genes <<<")
print(f"  (criteria: log2FC > 0.5 AND baseMean > 10, bad responders vs controls)")
print()
print("Top 10 genes in winning tissue:")
top10_idx = nc[nc.iloc[:, 1].isin(gene_lists[winner][:10])].index[:10]
for idx in top10_idx:
    row = nc.iloc[idx]
    comp_idx = bad_vs_ctrl_comps[tissue_names.index(winner)]
    start = 98 + comp_idx * 9
    print(f"  {row.iloc[1]:20s}  log2FC={float(row.iloc[start+4]):.3f}  baseMean={float(row.iloc[start]):.2f}")

print("\nAnalysis complete.")
