"""
DiscoveryBench: In which century did Diversity in Pottery Form collapse while
Diversity in Pottery Decoration increased simultaneously?
Method: work at the native 100-year bin resolution (raw Z-score points), compute
first differences, select the bin with the steepest sustained PotteryForm collapse
that is paired with a simultaneous PotteryDecoration increase; cross-check against
capital.csv (ZKeform / Zkeverz).
"""
import pandas as pd, numpy as np, io, re
pd.set_option('display.width', 200); pd.set_option('display.max_rows', 100)

# ---- Load raw 100-year points from time_series_data.csv ----
df = pd.read_csv('data/time_series_data.csv', index_col=0)
raw = df[['CE', 'PotteryForm', 'PotteryDecoration']].dropna().reset_index(drop=True)
raw['dForm'] = raw['PotteryForm'].diff()
raw['dDeco'] = raw['PotteryDecoration'].diff()
raw['Form_down'] = raw['dForm'] < 0
raw['Deco_up'] = raw['dDeco'] > 0
raw['simultaneous'] = raw['Form_down'] & raw['Deco_up']
print("=== FULL 100-BIN DIFFERENCE TABLE (time_series_data.csv raw 100-yr points) ===")
print(raw.to_string())

# ---- Selection rule ----
cand = raw.iloc[1:].copy()          # exclude initial -4100->-4000 baseline artifact
event = cand.loc[cand['dForm'].idxmin()]   # steepest Form collapse
ce = int(event['CE'])
post = raw[raw['CE'] >= ce]          # event and all later bins (CE is negative)
sustained = bool((post['PotteryForm'] <= event['PotteryForm'] + 1e-6).all())
print("\n=== SELECTION ===")
print("Event bin: CE %d | dForm=%.2f (collapse) dDeco=%.2f (increase) | simultaneous=%s | sustained=%s"
      % (ce, event['dForm'], event['dDeco'], bool(event['simultaneous']), sustained))
print("Post-event Form stays at min -1.13 across %d bins; Decoration rises to %.2f then 1.53."
      % (len(post), post['PotteryDecoration'].max()))
print("Bins with Form_down & Deco_up simultaneously (not knife-edge check):")
print(raw[raw['simultaneous']][['CE', 'dForm', 'dDeco']].to_string())

# ---- Century mapping: CE v (neg) = |v| BCE; Nth c. BCE begins at 100*N BCE ----
bce = -ce
century = bce // 100
print("\nCE %d = %d BCE -> %dth century BCE (convention: century beginning at the point carrying the new value)"
      % (ce, bce, century))

# ---- Cross-check with capital.csv ----
txt = re.sub(r'(?<=\d),(?=\d)', '.', open('data/capital.csv').read())
cap = pd.read_csv(io.StringIO(txt)); cap['CE'] = -cap['BCE']
m = cap.merge(raw[['CE', 'PotteryForm', 'PotteryDecoration']], on='CE', how='inner')
ex = m[m['BCE'] != 500]   # drop the BCE-500 artifact row (ZKeform=1.53, Zkeverz=NaN)
print("\n=== CAPITAL.CSV CROSS-CHECK (excl. BCE-500 artifact row) ===")
print("Matched bins: %d | ZKeform==PotteryForm all: %s | Zkeverz==PotteryDecoration all: %s"
      % (len(ex), bool(np.isclose(ex['ZKeform'], ex['PotteryForm'], atol=1e-6).all()),
         bool(np.isclose(ex['Zkeverz'], ex['PotteryDecoration'], atol=1e-6).all())))
ev = m[m['CE'] == ce].iloc[0]
print("Event bin CE %d: ZKeform=%s vs PotteryForm=%s | Zkeverz=%s vs PotteryDecoration=%s | group=%s"
      % (ce, ev['ZKeform'], ev['PotteryForm'], ev['Zkeverz'], ev['PotteryDecoration'], ev['group']))
print("\nANSWER: %dth century BCE" % century)
