"""DiscoveryBench: highest growth phase, 2000-1100 BCE.
Primary indicator: pollen_grate_100 (defined growth rate).
Rule: per-century mean over 100 annual rows in half-open bins [lo, lo+100);
peak century = argmax; phase = maximal contiguous run containing the peak
whose century means are all positive and in the top-3.
Cross-check: g_all_mean per-century means.
"""
import csv

rows = []
with open('data/time_series_data.csv') as f:
    for r in csv.DictReader(f):
        rows.append(r)
by_ce = {int(r['CE']): r for r in rows}

bins = [(-2000, -1900), (-1900, -1800), (-1800, -1700), (-1700, -1600),
        (-1600, -1500), (-1500, -1400), (-1400, -1300), (-1300, -1200),
        (-1200, -1100)]

def century_mean(col, lo, hi):
    vals = [float(by_ce[ce][col]) for ce in range(lo, hi) if by_ce[ce][col].strip() != '']
    return sum(vals) / len(vals), len(vals)

res = []
for lo, hi in bins:
    gm, ng = century_mean('pollen_grate_100', lo, hi)
    ga, na = century_mean('g_all_mean', lo, hi)
    res.append((lo, hi, gm, ng, ga, na))

print(f"{'bin':<16}{'n':>4}  {'mean pollen_grate_100':>22}  {'mean g_all_mean':>18}")
for lo, hi, gm, ng, ga, na in res:
    print(f"[{lo},{hi})".ljust(16) + f"{ng:>4}  {gm:>+22.6f}  {ga:>+18.7f}")

means = [(lo, hi, gm) for lo, hi, gm, ng, ga, na in res]
top3 = sorted(means, key=lambda t: -t[2])[:3]
peak_lo, peak_hi, peak_v = max(means, key=lambda t: t[2])
# maximal contiguous run containing peak: positive means and in top-3
run = [t for t in means if peak_lo == t[0] or True]
in_top = set((t[0], t[1]) for t in top3)
lo0, hi0 = peak_lo, peak_hi
lo = peak_lo
while lo - 100 >= -2000 and (lo - 100, lo) in in_top and next(g for l, h, g in means if (l, h) == (lo - 100, lo)) > 0:
    lo -= 100
hi = peak_hi
while hi <= -1100 and (hi, hi + 100) in in_top and next(g for l, h, g in means if (l, h) == (hi, hi + 100)) > 0:
    hi += 100

def cename(lo):
    return f"{-lo // 100}th century BCE"

print(f"\nPeak century: [{peak_lo},{peak_hi}) = {-peak_lo//100}th century BCE, mean = {peak_v:+.6f}")
print(f"Sustained phase: [{lo},{hi}) = {cename(lo)} through {cename(hi - 100)} (i.e., {-hi} BCE to {-lo} BCE)")
print("Top-3 centuries:", [(f"[{a},{b})", round(g, 6)) for a, b, g in top3])
