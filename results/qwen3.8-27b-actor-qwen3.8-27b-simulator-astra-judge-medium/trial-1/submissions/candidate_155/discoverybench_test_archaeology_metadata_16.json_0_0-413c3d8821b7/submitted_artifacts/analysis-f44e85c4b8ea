import pandas as pd, numpy as np

ZCOLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
DIM = {'ZAxtSchwert':'symbolic','ZDolch':'symbolic','Zhausgr':'symbolic',
       'ZCU_AU':'social','Zamber':'social','ZMonument':'social',
       'ZKeform':'cultural','Zkeverz':'cultural',
       'ZHort':'economic','ZSichel':'economic','ZBeil':'economic','ZMW':'economic'}

def pca1(X):
    """SVD PCA; returns (scores, loadings, evr) for PC1, sign fixed so loadings sum > 0."""
    X = np.asarray(X, float)
    Xc = X - X.mean(axis=0)
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    evr = (S**2)/ (S**2).sum()
    load = Vt[0]
    sc = U[:,0]*S[0]
    if load.sum() < 0: load, sc = -load, -sc
    return sc, load, evr

df = pd.read_csv('data/capital.csv')
for c in ZCOLS:
    df[c] = df[c].astype(str).str.replace(',','.').astype(float)
df = df[['BCE'] + ZCOLS].sort_values('BCE').reset_index(drop=True)
print('parsed shape:', df.shape, 'NaNs:', int(df[ZCOLS].isna().sum().sum()))

Xs = (df[ZCOLS] - df[ZCOLS].mean())/df[ZCOLS].std(ddof=1)
s_std, l_std, evr = pca1(Xs.values)
print(f'--- standardised (z-score) PCA ---')
print('PC1 explained variance ratio:', round(evr[0],4), '| top-3 sum:', round(evr[:3].sum(),4))
for c, l in sorted(zip(ZCOLS, l_std), key=lambda t: -abs(t[1])):
    print(f'  {c:14s} [{DIM[c]:8s}] loading={l:+.3f}')

s_raw, l_raw, evr2 = pca1(df[ZCOLS].values)
print(f'--- raw-values PCA (robustness) ---')
print('PC1 explained variance ratio:', round(evr2[0],4))
print('correlation(PC1_std, PC1_raw):', round(np.corrcoef(s_std, s_raw)[0,1],4))
for c, l in sorted(zip(ZCOLS, l_raw), key=lambda t: -abs(t[1]))[:6]:
    print(f'  top |loading|: {c:14s} {l:+.3f}')

out = pd.DataFrame({'BCE': df['BCE'], 'PC1_std': s_std, 'PC1_raw': s_raw})
print('\nPC1 scores per bin (standardised fit):')
print(out.to_string(index=False))

for name, lo, hi in [('MN 3400-3000',3000,3400), ('YN 2900-2300',2300,2900)]:
    ph = out[out['BCE'].between(lo,hi)].sort_values('BCE',ascending=False)
    first, last = ph['PC1_std'].iloc[0], ph['PC1_std'].iloc[-1]
    slope = np.polyfit(ph['BCE'].values, ph['PC1_std'].values, 1)[0]
    print(f'\n{name}: bins={list(ph.BCE)}')
    print('  PC1:', [round(v,3) for v in ph.PC1_std])
    print(f'  first={first:+.3f} last={last:+.3f} delta={last-first:+.3f} '
          f'mean={ph.PC1_std.mean():+.3f} slope={slope:+.4f} per +100 BCE '
          f'(i.e. {slope*-100:+.3f} per century in time)')

# Cross-check: 100-y bins of raw time_series_data.csv
ts = pd.read_csv('data/time_series_data.csv')
tmap = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
        'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount',
        'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize',
        'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
ts['BCE'] = -ts['CE']
ts['bin'] = np.ceil(ts['BCE']/100.0)*100
sub = ts[ts['bin'].between(500,4300)]
binned = sub.groupby('bin')[[tmap[c] for c in ZCOLS]].mean().reindex(range(4300,400,-100))
binned.columns = ZCOLS
Xb = binned.dropna()
print('\ncross-check bins available:', len(Xb), 'range', Xb.index.min(), '-', Xb.index.max())
Xbs = (Xb - Xb.mean())/Xb.std(ddof=1)
sb, lb, evr3 = pca1(Xbs.values)
chk = pd.DataFrame({'BCE': Xb.index, 'PC1_ts': sb})
print('cross-check PC1 EVR:', round(evr3[0],4))
for name, lo, hi in [('MN',3000,3400),('YN',2300,2900)]:
    ph = chk[chk['BCE'].between(lo,hi)].sort_values('BCE',ascending=False)
    print(f'{name}: PC1={[round(v,3) for v in ph.PC1_ts]} '
          f'first={ph.PC1_ts.iloc[0]:+.3f} last={ph.PC1_ts.iloc[-1]:+.3f} '
          f'delta={ph.PC1_ts.iloc[-1]-ph.PC1_ts.iloc[0]:+.3f}')
print(chk[chk['BCE'].between(2300,3400)].to_string(index=False))
out.to_csv('pc1_scores.csv', index=False)
