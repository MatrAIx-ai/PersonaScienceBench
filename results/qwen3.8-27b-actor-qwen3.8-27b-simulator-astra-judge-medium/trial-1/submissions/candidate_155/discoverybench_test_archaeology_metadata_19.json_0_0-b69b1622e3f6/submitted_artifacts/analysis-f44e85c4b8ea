import csv, numpy as np

# ---------- 1. Parse (decimal-comma) ----------
rows=[]
with open('data/capital.csv', newline='') as f:
    r=csv.reader(f); header=next(r)
    for line in r:
        if not line: continue
        rows.append(dict(zip(header,line)))

def tf(v):
    v=v.strip()
    return None if v=='' else float(v.replace(',','.'))

# Parse-verification: show raw vs parsed for the 1100 BCE row (incl. negatives)
print("=== PARSE VERIFICATION (raw -> parsed) ===")
for d in rows:
    if tf(d['BCE'])==1100:
        for c in header[3:]:
            print(f"  {c:12s} raw={d[c]:28s} -> {tf(d[c])}")
        break

bce=[tf(d['BCE']) for d in rows]
zcols=[c for c in header if c.startswith('Z')]   # 12 columns, documented order
print("\nN slices:", len(rows), "| N Z-cols:", len(zcols))
print("Z-col order:", zcols)

# ---------- 2. Build matrix ----------
X=np.array([[tf(d[c]) for c in zcols] for d in rows], dtype=float)
assert X.shape==(39,12), X.shape
assert not np.isnan(X).any(), "NaN present!"

# ---------- 3. Standardise (ddof=0, matches sklearn StandardScaler) ----------
mu=X.mean(axis=0); sd=X.std(axis=0, ddof=0)
Xs=(X-mu)/sd

# ---------- 4. Full-series PCA (correlation matrix) ----------
C=np.cov(Xs, rowvar=False)      # == correlation matrix since Xs standardised
evals,evecs=np.linalg.eigh(C)
order=np.argsort(evals)[::-1]
evals=evals[order]; evecs=evecs[:,order]
v1=evecs[:,0]
scores=Xs@v1                     # PC1 score per slice
evr=evals/evals.sum()

# Sign anchor: make the largest-magnitude loading positive
if np.argmax(np.abs(v1)) and v1[np.argmax(np.abs(v1))]<0:
    v1=-v1; scores=-scores

# ---------- 5. Window readout ----------
def score_at(b): return scores[list(bce).index(b)]
win=[1100,1000,900,800,700,600,500]
s1100=score_at(1100)
sub=[score_at(b) for b in win[1:]]   # 1000..500
sub_mean=float(np.mean(sub)); sub_min=float(np.min(sub)); sub_max=float(np.max(sub))
sub_range=sub_max-sub_min
diff=s1100-sub_mean
print("\n=== FULL-SERIES PCA (39 slices x 12 capitals) ===")
print(f"PC1 explained variance: {evr[0]*100:.1f}%  (PC2 {evr[1]*100:.1f}%)")
print("\nPC1 scores in YBA window (sign anchored so largest |loading| > 0):")
print(f"  1100 BCE : {s1100:+.4f}   <-- beginning of period")
for b,s in zip(win[1:],sub):
    print(f"  {b:4d} BCE : {s:+.4f}")
print(f"\nSubsequent six (1000-500): mean={sub_mean:+.4f}  min={sub_min:+.4f}  max={sub_max:+.4f}  range={sub_range:.4f}")
print(f"Difference 1100 - mean(1000-500) = {diff:+.4f}  (magnitude {abs(diff):.4f})")
print(f"1100 vs subsequent: {'HIGHER' if diff>0 else 'LOWER' if diff<0 else 'COMPARABLE'} by {abs(diff):.4f} PC1 units")
# extremum check (sign-invariant)
all7=[s1100]+sub
print(f"1100 is the {'MAX' if s1100==max(all7) else 'MIN' if s1100==min(all7) else 'interior point'} of the 7 YBA slices")
print(f"|1100|={abs(s1100):.4f} vs mean|subsequent|={np.mean([abs(s) for s in sub]):.4f}")

# ---------- 6. Top loadings on PC1 ----------
print("\n=== PC1 LOADINGS (all 12, sorted by |loading|) ===")
idx=np.argsort(np.abs(v1))[::-1]
for i in idx:
    print(f"  {zcols[i]:12s} {v1[i]:+.4f}")

# ---------- 7. Sensitivity: window-restricted PCA, drop ZSichel & ZKeform ----------
keep=[c for c in zcols if c not in ('ZSichel','ZKeform')]
Xw=np.array([[tf(d[c]) for c in keep] for d in rows if 500<=tf(d['BCE'])<=1100], dtype=float)
print("\n=== SENSITIVITY: window-only PCA (7 rows x", len(keep), "caps, ZSichel/ZKeform dropped) ===")
muw=Xw.mean(axis=0); sdw=Xw.std(axis=0, ddof=0)
Xws=(Xw-muw)/sdw
Cw=np.cov(Xws,rowvar=False)
ew,vw=np.linalg.eigh(Cw); ow=np.argsort(ew)[::-1]
ew=ew[ow]; vw=vw[:,ow]
v1w=vw[:,0]
if vw[np.argmax(np.abs(v1w)),0]<0:
    v1w=-v1w
sw=Xws@v1w
order_b=[1100,1000,900,800,700,600,500]
print(f"PC1 explained variance: {ew[0]/ew.sum()*100:.1f}%")
for i,b in enumerate(order_b):
    print(f"  {b:4d} BCE : {sw[i]:+.4f}")
sw1100=sw[0]; swsub=sw[1:]
print(f"  1100 - mean(subsequent) = {sw1100-np.mean(swsub):+.4f}  -> {'HIGHER' if sw1100>np.mean(swsub) else 'LOWER'}")
print(f"  1100 is {'MAX' if sw1100==max(sw) else 'MIN' if sw1100==min(sw) else 'interior'} of the 7")
