"""
PCA on forms of capital, analyzed in 100-year time slices.
Data: data/capital.csv (39 x 100-year bins, BCE 4300-500, already z-scored)
Method: standard unrotated PCA via numpy SVD on the (re-)standardized 12 capital
variables. Sign convention: largest-magnitude loading on each PC made positive.
"""
import pandas as pd
import numpy as np

pd.set_option('display.width', 200)
cap = pd.read_csv('data/capital.csv', decimal=',')
zcols = [c for c in cap.columns if c.startswith('Z')]
sym = ['ZAxtSchwert', 'ZDolch', 'Zhausgr']
names = {
    'ZAxtSchwert': 'Hatchets/Swords', 'ZDolch': 'Daggers', 'Zhausgr': 'House Size',
    'ZCU_AU': 'Copper/Gold', 'Zamber': 'Amber', 'ZMonument': 'Monument Count',
    'ZHort': 'Depot', 'ZSichel': 'Sickle', 'ZBeil': 'Axes/Celts', 'ZMW': 'Monument Size',
    'ZKeform': 'Pottery Form', 'Zkeverz': 'Pottery Decoration',
}

def run_pca(df, label):
    df = df.reset_index(drop=True)
    X = df[zcols].values.astype(float)
    X = (X - X.mean(0)) / X.std(0, ddof=1)          # re-standardize (no-op)
    Xc = X - X.mean(0)
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    evr = S**2 / (S**2).sum()
    # sign convention: largest-|loading| positive on each PC
    for i in range(Vt.shape[0]):
        j = np.argmax(np.abs(Vt[i]))
        if Vt[i, j] < 0:
            Vt[i] = -Vt[i]
    scores = U * S  # bin scores
    print(f"=== {label} (n_bins={X.shape[0]}, n_vars={X.shape[1]}) ===")
    print("EV ratio PC1/PC2: %.4f / %.4f (cum %.4f)" % (evr[0], evr[1], evr[:2].sum()))
    print("\nAll PC1 loadings:")
    for c, v in sorted(zip(zcols, Vt[0]), key=lambda t: -abs(t[1])):
        print(f"  {c:12s} {names[c]:16s} {v:+.4f}")
    print("All PC2 loadings:")
    for c, v in sorted(zip(zcols, Vt[1]), key=lambda t: -abs(t[1])):
        print(f"  {c:12s} {names[c]:16s} {v:+.4f}")
    print("\nSymbolic variables — PC1 loadings:")
    for c in sym:
        print(f"  {c:12s} {names[c]:16s} PC1={Vt[0, zcols.index(c)]:+.4f}  PC2={Vt[1, zcols.index(c)]:+.4f}")
    # Each variable's value along the PC2 direction: contribution of variable j
    # to the PC2 bin score = z-score of variable j at bin k * PC2 loading of j.
    print("\nPC2 direction: each variable's bin values along PC2")
    print("(contrib_k = z_k(j) * loading_PC2(j); PC2 score_k = sum_j contrib_k(j))")
    rows = []
    for c in sym:
        j = zcols.index(c)
        contrib = Xc[:, j] * Vt[1, j]
        rows.append((c, names[c], Vt[1, j],
                     contrib.mean(), contrib.std(ddof=1), contrib.min(), contrib.max()))
    tab = pd.DataFrame(rows, columns=['var', 'name', 'PC2_loading', 'contrib_mean',
                                      'contrib_std', 'contrib_min', 'contrib_max'])
    print(tab.round(4).to_string(index=False))
    # how well each variable tracks the PC2 bin score
    s2 = scores[:, 1]
    for c in sym:
        j = zcols.index(c)
        print(f"  corr(PC2 score, {c} z-series) = {np.corrcoef(Xc[:, j], s2)[0,1]:+.3f}")
    # separation: bins with extreme PC2 scores
    top = np.argsort(s2)[-4:]
    bot = np.argsort(s2)[:4]
    print(f"\n  Top-4 PC2 bins (BCE {sorted(df.loc[top,'BCE'].tolist())}): "
          f"PC2 mean {s2[top].mean():+.3f}")
    print(f"  Bottom-4 PC2 bins (BCE {sorted(df.loc[bot,'BCE'].tolist())}): "
          f"PC2 mean {s2[bot].mean():+.3f}")
    for grp, idx in (("top", top), ("bottom", bot)):
        vals = {names[c]: Xc[idx, zcols.index(c)].mean() for c in sym}
        print(f"    {grp}: " + ", ".join(f"{k} z={v:+.3f}" for k, v in vals.items()))
    # bin scores on PC1/PC2
    print("\nPC1/PC2 bin scores (first/last 5 bins):")
    for b, s1, s2 in list(zip(df.BCE, scores[:, 0], scores[:, 1]))[:3] + \
                      list(zip(df.BCE, scores[:, 0], scores[:, 1]))[-3:]:
        print(f"  BCE {b}: PC1={s1:+.3f} PC2={s2:+.3f}")
    print(f"  PC1 scores: mean={scores[:,0].mean():+.4f} std={scores[:,0].std(ddof=1):.4f} "
          f"range [{scores[:,0].min():+.3f}, {scores[:,0].max():+.3f}]")
    print(f"  PC2 scores: mean={scores[:,1].mean():+.4f} std={scores[:,1].std(ddof=1):.4f} "
          f"range [{scores[:,1].min():+.3f}, {scores[:,1].max():+.3f}]")
    # where is house size largest relative to the other two along PC2?
    h = Xc[:, zcols.index('Zhausgr')]
    hi = h > h.mean()
    print("\nIn bins where HouseSize z > mean (n=%d):" % hi.sum())
    for c in ['ZAxtSchwert', 'ZDolch']:
        print(f"  {names[c]} mean z = {Xc[hi, zcols.index(c)].mean():+.3f} "
              f"(overall mean {Xc[:, zcols.index(c)].mean():+.3f})")
    return evr, Vt, scores

evr_full, Vt_full, _ = run_pca(cap, "MAIN: all 39 bins (BCE 4300-500)")
print("\n" + "#" * 70)
run_pca(cap[cap.BCE <= 4100], "SENSITIVITY: 37 bins (BCE 4100-500, excl. 4300/4200)")
