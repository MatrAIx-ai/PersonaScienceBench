#!/usr/bin/env python3
"""
Analysis: How do monuments and axes change with symbolic capital elements
between 3400 BCE and 3000 BCE?

Data-grounded descriptive analysis of 5 raw observations at 100-year bins.
"""

import pandas as pd
import numpy as np
from scipy import stats

# ── 1. Load data ──────────────────────────────────────────────────────────────
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')

# Convert capital.csv comma-decimal strings to floats
for col in ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZMonument', 'ZBeil']:
    cap[col + '_num'] = cap[col].str.replace(',', '.').astype(float)

# ── 2. Extract the 5 raw data points in 3400–3000 BCE ────────────────────────
bce_points = [3400, 3300, 3200, 3100, 3000]

# From time_series_data (CE = -BCE)
ts_window = ts[ts['CE'].isin([-b for b in bce_points])].copy()
ts_window['BCE'] = -ts_window['CE']
ts_window = ts_window.set_index('BCE').loc[bce_points]

# Build a clean 5×5 table
table = pd.DataFrame({
    'BCE':             bce_points,
    'MonumentCount':   ts_window['MonumentCount'].values,
    'AxesCelts':       ts_window['AxesCelts'].values,
    'HatchetSword':    ts_window['HatchetSword'].values,
    'Dagger':          ts_window['Dagger'].values,
    'HouseSize':       ts_window['HouseSize'].values,
})

print("=" * 70)
print("RAW DATA: 3400–3000 BCE (5 observations at 100-year bins)")
print("=" * 70)
print(table.to_string(index=False))
print()

# ── 3. Trajectory description ────────────────────────────────────────────────
print("=" * 70)
print("TRAJECTORY CHARACTERIZATION")
print("=" * 70)

def describe_trajectory(name, vals, bce):
    """Describe the shape of a 5-point trajectory."""
    peak_idx = int(np.argmax(vals))
    trough_idx = int(np.argmin(vals))
    peak_bce = bce[peak_idx]
    trough_bce = bce[trough_idx]
    total_range = vals.max() - vals.min()
    cv = np.std(vals) / abs(np.mean(vals)) if np.mean(vals) != 0 else float('inf')
    
    print(f"\n{name}:")
    print(f"  Values: {[f'{v:.4f}' for v in vals]}")
    print(f"  Range: {vals.min():.4f} to {vals.max():.4f} (span = {total_range:.4f})")
    print(f"  Peak: {vals[peak_idx]:.4f} at {peak_bce} BCE")
    print(f"  Trough: {vals[trough_idx]:.4f} at {trough_bce} BCE")
    print(f"  Coefficient of variation: {cv:.3f}")
    
    # Step-by-step changes
    print(f"  Step changes:")
    for i in range(len(vals)-1):
        delta = vals[i+1] - vals[i]
        direction = "↑" if delta > 0.005 else ("↓" if delta < -0.005 else "→")
        print(f"    {bce[i]}→{bce[i+1]}: {direction} Δ={delta:+.4f}")
    
    return {'name': name, 'peak_bce': peak_bce, 'trough_bce': trough_bce,
            'range': total_range, 'cv': cv, 'values': vals}

bce_arr = np.array(bce_points)
results = {}
for col in ['MonumentCount', 'AxesCelts', 'HatchetSword', 'Dagger', 'HouseSize']:
    results[col] = describe_trajectory(col, table[col].values, bce_arr)

# ── 4. Temporal ordering of peaks and troughs ────────────────────────────────
print("\n" + "=" * 70)
print("TEMPORAL ORDERING OF PEAKS AND TROUGHS")
print("=" * 70)
for col in ['MonumentCount', 'AxesCelts', 'HatchetSword', 'Dagger', 'HouseSize']:
    r = results[col]
    print(f"  {col:>15}: peak at {r['peak_bce']} BCE, trough at {r['trough_bce']} BCE, span={r['range']:.4f}")

print("""
Key temporal observations:
  • HouseSize drops sharply from 2.05 (3400 BCE) to 0.79 (3300 BCE) — a
    62% decline in Z-score — BEFORE the monument/axes peak.
  • MonumentCount rises steadily from 3400→3200 BCE, peaking at 0.91 (3200 BCE).
  • AxesCelts spikes from 0.32 (3300 BCE) to 2.60 (3200 BCE) — the same bin
    as the MonumentCount peak.
  • Both MonumentCount and AxesCelts peak at 3200 BCE (temporally coincident).
  • Both then decline through 3100 and 3000 BCE.
  • HatchetSword is essentially flat (range = 0.01) — no meaningful peak/trough.
  • Dagger is completely constant at −0.58 — zero variation.
""")

# ── 5. Pairwise Pearson correlations (descriptive, n=5) ─────────────────────
print("=" * 70)
print("PAIRWISE PEARSON CORRELATIONS (descriptive only, n=5, df=3)")
print("=" * 70)
print(f"Critical |r| for p<0.05 at df=3: {abs(stats.t.ppf(0.025, 3)):.4f} → "
      f"r_crit = {stats.t.ppf(0.025, 3):.4f}")
# Actually compute critical r
from scipy.stats import t
t_crit = t.ppf(0.975, 3)
r_crit = t_crit / np.sqrt(t_crit**2 + 3)
print(f"t_crit(0.975, df=3) = {t_crit:.4f}, r_crit = {r_crit:.4f}")
print()

focal = ['MonumentCount', 'AxesCelts']
symbolic = ['HatchetSword', 'Dagger', 'HouseSize']

print(f"{'Focal':>15} vs {'Symbolic':>15} | {'r':>8} | {'p':>8} | Note")
print("-" * 65)
for f in focal:
    for s in symbolic:
        x = table[f].values
        y = table[s].values
        if np.std(y) < 1e-10:
            print(f"{f:>15} vs {s:>15} | {'N/A':>8} | {'N/A':>8} | zero variance in {s}")
        elif np.std(x) < 1e-10:
            print(f"{f:>15} vs {s:>15} | {'N/A':>8} | {'N/A':>8} | zero variance in {f}")
        else:
            r, p = stats.pearsonr(x, y)
            note = "significant" if abs(r) > r_crit else "not significant"
            print(f"{f:>15} vs {s:>15} | {r:>8.4f} | {p:>8.4f} | {note}")

print()

# ── 6. Linear trend slopes (OLS on time) ────────────────────────────────────
print("=" * 70)
print("LINEAR TREND SLOPES (OLS against BCE, per 100 years)")
print("=" * 70)
for col in ['MonumentCount', 'AxesCelts', 'HatchetSword', 'Dagger', 'HouseSize']:
    y = table[col].values
    x = bce_arr.astype(float)
    slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)
    # slope is per year; convert to per 100 years
    slope_100 = slope * 100
    print(f"  {col:>15}: slope = {slope_100:+.4f} per 100 yr (r={r_value:.4f}, p={p_value:.4f})")

print()

# ── 7. Spearman (rank) correlations as robustness check ──────────────────────
print("=" * 70)
print("SPEARMAN RANK CORRELATIONS (descriptive, n=5)")
print("=" * 70)
print(f"{'Focal':>15} vs {'Symbolic':>15} | {'rho':>8} | {'p':>8}")
print("-" * 55)
for f in focal:
    for s in symbolic:
        x = table[f].values
        y = table[s].values
        if np.std(y) < 1e-10:
            print(f"{f:>15} vs {s:>15} | {'N/A':>8} | {'N/A':>8}")
        else:
            rho, p = stats.spearmanr(x, y)
            print(f"{f:>15} vs {s:>15} | {rho:>8.4f} | {p:>8.4f}")

print()

# ── 8. Cross-check with capital.csv ──────────────────────────────────────────
print("=" * 70)
print("CROSS-CHECK: capital.csv values match time_series_data.csv")
print("=" * 70)
cap_window = cap[cap['BCE'].isin(bce_points)].set_index('BCE').loc[bce_points]
pairs = [('ZMonument_num','MonumentCount'), ('ZBeil_num','AxesCelts'),
         ('ZAxtSchwert_num','HatchetSword'), ('ZDolch_num','Dagger'),
         ('Zhausgr_num','HouseSize')]
all_match = True
for cap_col, ts_col in pairs:
    for bce in bce_points:
        v1 = cap_window.loc[bce, cap_col]
        v2 = table.loc[table['BCE']==bce, ts_col].values[0]
        if abs(v1 - v2) > 1e-6:
            print(f"  MISMATCH at {bce} BCE: {cap_col}={v1} vs {ts_col}={v2}")
            all_match = False
print(f"  All values match: {all_match}")
print(f"  Group for all 5 points: {cap_window['group'].unique()}")

# ── 9. Supplementary: interpolated trend shape (for visualization only) ─────
print()
print("=" * 70)
print("SUPPLEMENTARY: Interpolated trend shape (401 pts, NOT independent data)")
print("=" * 70)
ts_inter_window = ts[(ts['CE'] >= -3400) & (ts['CE'] <= -3000)]
for col in ['MonumentCount_inter', 'AxesCelts_inter', 'HouseSize_inter']:
    vals = ts_inter_window[col].values
    print(f"  {col}: min={vals.min():.4f}, max={vals.max():.4f}, "
          f"at CE={ts_inter_window['CE'].values[np.argmax(vals)]} (peak), "
          f"at CE={ts_inter_window['CE'].values[np.argmin(vals)]} (trough)")

# ── 10. Final synthesis ──────────────────────────────────────────────────────
print()
print("=" * 70)
print("SYNTHESIS")
print("=" * 70)
print("""
Between 3400 and 3000 BCE (5 observations at 100-year bins, all Middle
Neolithic), the following patterns emerge:

1. MONUMENTS AND AXES PEAK SIMULTANEOUSLY AT 3200 BCE:
   - MonumentCount rises from −0.46 (3400) to +0.91 (3200), then falls to
     −0.36 (3000).
   - AxesCelts spikes from 0.32 (3300) to 2.60 (3200), then falls to 0.80
     (3100–3000).
   - The co-peak at 3200 BCE suggests a synchronized burst of monumental
     construction and stone tool (axe/celt) production.

2. HOUSE SIZE (residential scale) DROPS BEFORE THE PEAK:
   - HouseSize falls sharply from 2.05 (3400) to 0.79 (3300), continues to
     −0.06 (3100), then partially recovers to 0.19 (3000).
   - The residential-scale decline precedes and coincides with the early
     rise of monuments and axes, suggesting that the monumental/axe peak
     occurred in a context of shrinking domestic architecture.

3. WEAPON-RELATED SYMBOLIC CAPITAL IS EFFECTIVELY CONSTANT:
   - HatchetSword varies by only 0.01 (−0.43 to −0.42) — negligible.
   - Dagger is perfectly constant at −0.58 — zero variation.
   - These two elements provide no signal of co-variation with monuments
     or axes in this window.

4. THE "RELATIONSHIP WITH SYMBOLIC CAPITAL" IS DOMINATED BY HOUSE SIZE:
   - Because HatchetSword and Dagger are constant, the only symbolic-capital
     element that varies is HouseSize.
   - The MonumentCount–HouseSize relationship is inversely shaped: as
     HouseSize declines (3400→3100), MonumentCount rises (to 3200) then
     falls. The AxesCelts–HouseSize relationship is similar.
   - This is consistent with a reallocation of social energy from domestic
     space to monumental and technological (axe) displays.

CAVEATS:
   - n=5; all correlations are descriptive, not inferential.
   - Z-scores are standardized; absolute magnitudes are not interpretable
     as counts or areas.
   - 100-year binning may obscure sub-decadal timing.
   - The 3200 BCE co-peak could be a binning artifact.
""")
