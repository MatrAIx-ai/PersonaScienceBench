"""
Amber peak analysis
Question: In which millennium did amber have the highest value and in what
time interval did it peak?

Primary source : raw Z-values (time_series_data.csv `Amber`, capital.csv `Zamber`)
Cross-check     : time_series_data.csv `Amber_inter`
Convention      : negative CE = BCE ; calBP = years before 1950 AD (CE + calBP = 1950)
Millennium      : Nth millennium BCE = N*1000 .. (N-1)*1000+1 BCE  (e.g. 4th = 4000..3001 BCE)
"""
import pandas as pd
import numpy as np

pd.set_option('display.width', 120)

# ---------------------------------------------------------------- load
ts = pd.read_csv('data/time_series_data.csv')

# capital.csv uses European decimal comma -> parse manually
import csv
def parse_eu(v):
    v = v.strip().strip('"')
    if v in ('', 'NA', 'nan', 'NaN'):
        return np.nan
    return float(v.replace(',', '.'))

with open('data/capital.csv') as f:
    rdr = csv.reader(f)
    hdr = next(rdr)
    cap_rows = list(rdr)
cap = pd.DataFrame(cap_rows, columns=hdr)
zamber = pd.to_numeric(cap['Zamber'].map(parse_eu))
cap['Zamber_num'] = zamber
cap['BCE_num'] = pd.to_numeric(cap['BCE'])

# ---------------------------------------------------------------- amber (raw, 100-yr bins)
amber = ts[ts['Amber'].notna()][['CE', 'calBP', 'Amber']].copy()
amber['BCE'] = -amber['CE']
amber = amber.sort_values('BCE').reset_index(drop=True)

zmax = amber['Amber'].max()
peak = amber[amber['Amber'] >= zmax - 1e-9].copy()   # all bins at the global max
print("=== RAW Amber (100-yr bins) ===")
print(f"Global max Z = {zmax}")
print(f"Peak bins (Z == {zmax}): BCE {peak['BCE'].min()} .. {peak['BCE'].max()} "
      f"({len(peak)} bins)")
print("Peak bin detail:")
print(peak[['BCE', 'CE', 'calBP', 'Amber']].to_string(index=False))

# high-value region (>= 1.46) for context
hi = amber[amber['Amber'] >= 1.46 - 1e-9]
print(f"\nHigh-value region (Z >= 1.46): BCE {hi['BCE'].min()} .. {hi['BCE'].max()}")

# ---------------------------------------------------------------- cross-check capital.csv
zmax_cap = cap['Zamber_num'].max()
peak_cap = cap[cap['Zamber_num'] >= zmax_cap - 1e-9]
print("\n=== capital.csv Zamber (cross-check) ===")
print(f"Global max Z = {zmax_cap}; peak bins BCE {peak_cap['BCE_num'].min()} .. {peak_cap['BCE_num'].max()}")

# verify overlap agreement (raw Amber vs Zamber)
m = amber.merge(cap[['BCE_num', 'Zamber_num']].rename(
    columns={'BCE_num': 'BCE', 'Zamber_num': 'Zamber'}), on='BCE')
m['diff'] = (m['Amber'] - m['Zamber']).abs()
print(f"Overlap bins={len(m)}, max |Amber-Zamber| = {m['diff'].max():.2e} (0 => identical)")

# ---------------------------------------------------------------- cross-check Amber_inter
ai = ts['Amber_inter'].dropna()
imax = ai.max()
plat = ts[ts['Amber_inter'] >= imax - 1e-9]
print("\n=== Amber_inter (cross-check) ===")
print(f"Global max Z = {imax}; plateau CE {plat['CE'].min()} .. {plat['CE'].max()} "
      f"(BCE {-plat['CE'].max()} .. {-plat['CE'].min()}, {len(plat)} annual rows)")

# ---------------------------------------------------------------- millennium assignment
def millennium_bce(bce):
    """Nth millennium BCE for a BCE year (astronomical/historical convention)."""
    return int(np.floor((bce - 1) / 1000)) + 1

peak_bins = sorted(peak['BCE'].tolist())
mil = {b: millennium_bce(b) for b in peak_bins}
print("\n=== Millennium of each peak bin ===")
for b in peak_bins:
    print(f"BCE {b} -> {mil[b]}th millennium BCE")
from collections import Counter
cnt = Counter(mil.values())
print("Millennium counts over peak bins:", dict(cnt))
# millennium with the highest sustained amber (use all bins >=1.46)
hi_mil = Counter(millennium_bce(b) for b in hi['BCE'].tolist())
print("Millennium counts over high-value (>=1.46) bins:", dict(hi_mil))

# ---------------------------------------------------------------- final summary
print("\n================ FINAL ==================")
peak_lo, peak_hi = int(peak['BCE'].min()), int(peak['BCE'].max())
calhi = int(ts.loc[ts['CE'] == -peak_hi, 'calBP'].iloc[0])  # BCE peak_hi -> calBP
callo = int(ts.loc[ts['CE'] == -peak_lo, 'calBP'].iloc[0])
print(f"Highest amber Z-value : {zmax}")
print(f"Peak time interval    : BCE {peak_lo}-{peak_hi} "
      f"(CE -{peak_hi}..-{peak_lo}; calBP {callo}-{calhi})")
print(f"Millennium            : 4th millennium BCE (4000-3001 BCE)")
print("Note: the BCE 3000 bin (Z=1.54) sits at the start of the 3rd millennium BCE;")
print("      the remaining peak bins (BCE 3100/3200/3300) are in the 4th millennium BCE,")
print("      and the 4th millennium BCE also holds the 1.46 high (BCE 3400-4000).")
