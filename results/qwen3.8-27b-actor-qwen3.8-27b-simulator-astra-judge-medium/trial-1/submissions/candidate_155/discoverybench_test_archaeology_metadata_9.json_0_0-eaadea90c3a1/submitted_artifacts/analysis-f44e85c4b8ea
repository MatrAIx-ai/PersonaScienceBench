"""
Summed social capital index: peak century and rising components.
Source: data/capital.csv (100-yr bins, 4300-500 BCE; z-scores of archaeological capital).
Index = equal-weighted sum of z-scores: ZCU_AU (Copper&Gold) + Zamber (Amber) + ZMonument (Monument count).
Sensitivity: add ZMW (Monument size).
"""
import pandas as pd
import numpy as np

cap = pd.read_csv('data/capital.csv', decimal=',')
cap = cap.drop(columns=['group', 'color'])

comps = ['ZCU_AU', 'Zamber', 'ZMonument']
cap['sum3'] = cap[comps].sum(axis=1)
cap['sum4'] = cap['sum3'] + cap['ZMW']

# Peak of primary (3-component) index
peak_idx = cap['sum3'].idxmax()
peak_bce = int(cap.loc[peak_idx, 'BCE'])
max_val = cap['sum3'].max()
tied = cap.index[cap['sum3'] == max_val]
tied_bce = [int(cap.loc[i, 'BCE']) for i in tied]
print(f"Primary index (3-comp) max = {max_val:.4f} at {peak_bce} BCE; tied bins: {tied_bce}")

# Sensitivity: 4-component index
peak4_idx = cap['sum4'].idxmax()
print(f"Sensitivity index (4-comp incl. MonumentSize) max = {cap['sum4'].max():.4f} at {int(cap.loc[peak4_idx,'BCE'])} BCE")

# Per-component trajectories over the 6 bins preceding the peak (4000-yr? no: 600 yr)
window = 6
row = cap.loc[peak_idx]
start = peak_idx - window
traj = cap.loc[start:peak_idx, ['BCE'] + comps + ['ZMW', 'sum3']].copy()
print("\nTrajectory (600 yr before and including peak):")
print(traj.to_string(index=False))

# Classify each component: change from 2 bins (200 yr) and 4 bins (400 yr) before peak
print("\nComponent changes into the peak:")
for c in comps + ['ZMW']:
    v0 = row[c]; v2 = cap.loc[peak_idx-2, c]; v4 = cap.loc[peak_idx-4, c]
    d2 = v0 - v2; d4 = v0 - v4
    def label(d):
        return 'rising' if d > 0.1 else ('falling' if d < -0.1 else 'flat/marginal')
    print(f"  {c}: {v4:.3f} (400y before) -> {v2:.3f} (200y before) -> {v0:.3f} (peak); "
          f"d400={d4:+.3f}, d200={d2:+.3f} => {label(d2)} (200 yr), 400 yr: {label(d4)}")

# Full index table for the record
out = cap[['BCE','ZCU_AU','Zamber','ZMonument','ZMW','sum3','sum4']].copy()
out.to_csv('summed_social_capital_index.csv', index=False)
print("\nSaved summed_social_capital_index.csv (39 rows)")
