"""
Full analysis: Prevalence of gardening-introduced non-native plants by habitat type.
Primary file: invaded_niche_pathways.csv (plot-level).
Prevalence metric (primary): gardening share = n.gard / n.total per habitat (pooled).
Supporting: mean n.gard per plot; probability a plot has >=1 gardening species.
Step 1: descriptive per-habitat table + Wilson 95% CI + chi-square + permutation test.
Step 2: quasibinomial GLM (binomial with dispersion correction) of gardening share ~ habitat (+ env covariates).
"""
import pandas as pd, numpy as np
from scipy import stats
import statsmodels.api as sm
import warnings, json
warnings.filterwarnings("ignore")
pd.set_option("display.max_columns", None); pd.set_option("display.width", 200)

df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
df3 = pd.read_csv("data/invasion_success_pathways.csv")
dfT = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")

def wilson_ci(k, n, z=1.959964):
    if n == 0: return (np.nan, np.nan)
    p = k / n
    den = 1 + z*z/n
    c = (p + z*z/(2*n)) / den
    h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n)) / den
    return (max(0.0, c-h), min(1.0, c+h))

# =====================================================================
# STEP 1
# =====================================================================
rows = []
for h, g in df.groupby("habitat"):
    n_plots = len(g)
    sg, su, sa, st = g["n.gard"].sum(), g["n.unint"].sum(), g["n.agfo"].sum(), g["n.total"].sum()
    share = sg/st if st>0 else np.nan
    lo, hi = wilson_ci(sg, st)
    rows.append(dict(
        habitat=h, n_plots=n_plots,
        n_gard=int(sg), n_unint=int(su), n_agfo=int(sa), n_invaded_species=int(st),
        gardening_share=round(share,3) if st>0 else np.nan,
        wilson_ci_lo=round(lo,3), wilson_ci_hi=round(hi,3),
        mean_n_gard_per_plot=round(g["n.gard"].mean(),3),
        pct_plots_with_gard=round((g["n.gard"]>0).mean()*100,1),
        n_invaded_plots=int((g["n.total"]>0).sum()),
        small_sample_flag="YES (<10 invaded species)" if st<10 else ""))
step1 = pd.DataFrame(rows).sort_values("gardening_share", ascending=False)
step1.to_csv("step1_habitat_gardening_summary.csv", index=False)

# Overall
st_all = df["n.total"].sum(); sg_all = df["n.gard"].sum()
lo_all, hi_all = wilson_ci(sg_all, st_all)

# Chi-square: habitat x pathway (pooled species-observations)
tab = df.groupby("habitat")[["n.gard","n.unint","n.agfo"]].sum().astype(int)
tab.columns = ["Gardening","Unintentional","AgriForest"]
chi2, pchi, dof, exp = stats.chi2_contingency(tab.values)

# Permutation test (robust to small cells): permute pathway label among all species-observations
_hab = df["habitat"].to_numpy()
_gard = df["n.gard"].to_numpy(int); _unint = df["n.unint"].to_numpy(int); _agfo = df["n.agfo"].to_numpy(int)
long = pd.DataFrame({
    "pathway": np.concatenate([np.full(_gard.sum(),"Gardening"),
                               np.full(_unint.sum(),"Unintentional"),
                               np.full(_agfo.sum(),"AgriForest")]),
    "habitat": np.concatenate([np.repeat(_hab,_gard), np.repeat(_hab,_unint), np.repeat(_hab,_agfo)])})
_ct = pd.crosstab(long["habitat"], long["pathway"]).reindex(index=tab.index, columns=tab.columns).fillna(0).astype(int)
assert _ct.equals(tab), "long table mismatch:\n%s" % _ct.to_string()
rng = np.random.default_rng(42)
def tab_chi2(hab, path):
    t = pd.crosstab(hab, path)
    return stats.chi2_contingency(t.values)[0]
obs_chi2 = tab_chi2(long["habitat"], long["pathway"])
Nperm = 20000
null = np.empty(Nperm)
paths = long["pathway"].values
for i in range(Nperm):
    perm = rng.permutation(paths)
    null[i] = tab_chi2(long["habitat"].values, perm)
_k = int((null >= obs_chi2).sum())
p_perm = _k / Nperm
p_perm_corrected = (_k + 1) / (Nperm + 1)

# =====================================================================
# STEP 2  (quasibinomial GLM: binomial + Pearson dispersion correction)
# =====================================================================
d = df[df["n.total"]>0].copy()
y = d[["n.gard","n.total"]].values.astype(float)   # (successes, trials)
REF = "Croplands"
hab_dum = pd.get_dummies(d["habitat"], prefix="hab", dtype=float)
hab_dum = hab_dum.drop(columns=["hab_"+REF])
cov_cols = ["elevation","urban.2009.50m","cropland.2009.50m","distance.road","distance.stream","annual.temperature"]
cov = (d[cov_cols] - d[cov_cols].mean()) / d[cov_cols].std()   # z-standardized

def fit_quasibin(Xmat):
    m = sm.GLM(y, Xmat, family=sm.families.Binomial()).fit()
    phi = m.pearson_chi2 / m.df_resid
    se = np.sqrt(np.diag(m.cov_params()) * phi)
    return m, phi, se

# Model A: habitat only
XA = sm.add_constant(hab_dum)
mA, phiA, seA = fit_quasibin(XA)
# Covariates-only model (for habitat-block LRT)
XC = sm.add_constant(cov)
mC, phiC, seC = fit_quasibin(XC)
# Model B: habitat + covariates
XB = sm.add_constant(pd.concat([hab_dum, cov], axis=1))
mB, phiB, seB = fit_quasibin(XB)

def or_table(m, se, hab_dum, cov_cols):
    out=[]
    for name in m.params.index:
        b = m.params[name]; s = se[m.params.index.get_loc(name)]
        out.append(dict(term=name, logOR=round(b,4), OR=round(np.exp(b),3),
                        qSE_logOR=round(s,4), CI_lo=round(np.exp(b-1.96*s),3), CI_hi=round(np.exp(b+1.96*s),3),
                        significant="yes" if (np.exp(b-1.96*s)>1 or np.exp(b+1.96*s)<1) else "no"))
    return pd.DataFrame(out)
orA = or_table(mA, seA, hab_dum, cov_cols)
orB = or_table(mB, seB, hab_dum, cov_cols)

# Likelihood-ratio tests
def lrt(full, red):
    chi2 = 2*(full.llf - red.llf); dof = full.df_model - red.df_model
    return chi2, dof, stats.chi2.sf(chi2, dof)
lrt_habit_block  = lrt(mB, mC)   # habitat effect beyond environment  <-- KEY
lrt_env_over_hab = lrt(mB, mA)   # environment adds beyond habitat
lrt_hab_vs_int   = lrt(mA, sm.GLM(y, sm.add_constant(np.ones(len(d))), family=sm.families.Binomial()).fit())
# ---- SENSITIVITY: refit Model B excluding the two separation habitats ----
SEP = ["Rock outcrops", "Broad-leaved forests"]
d2 = d[~d["habitat"].isin(SEP)].copy()
y2 = d2[["n.gard","n.total"]].values.astype(float)
hab2 = pd.get_dummies(d2["habitat"], prefix="hab", dtype=float).drop(columns=["hab_"+REF])
cov2 = (d2[cov_cols]-d2[cov_cols].mean())/d2[cov_cols].std()
XB2 = sm.add_constant(pd.concat([hab2, cov2], axis=1))
mB2 = sm.GLM(y2, XB2, family=sm.families.Binomial()).fit()
phiB2 = mB2.pearson_chi2/mB2.df_resid
seB2 = np.sqrt(np.diag(mB2.cov_params())*phiB2)
def orB2row(name):
    i = mB2.params.index.get_loc(name); b=mB2.params[name]; s=seB2[i]
    return dict(habitat=name.replace("hab_",""), OR=round(np.exp(b),3), qSE=round(s,3),
                CI_lo=round(np.exp(b-1.96*s),3), CI_hi=round(np.exp(b+1.96*s),3))
sens = pd.DataFrame([orB2row(n) for n in mB2.params.index if n.startswith("hab_")])
# habitat-block LRT & Wald in sensitivity model
XB2c = sm.add_constant(cov2)
mB2c = sm.GLM(y2, XB2c, family=sm.families.Binomial()).fit()
lrt2 = lrt(mB2, mB2c)
_hb2=[i for i,n in enumerate(mB2.params.index) if n.startswith("hab_")]
_b2=mB2.params.iloc[_hb2].to_numpy(); _V2=(mB2.cov_params().iloc[_hb2,_hb2].to_numpy())*phiB2
W2=float(_b2@np.linalg.inv(_V2)@_b2); pW2=stats.chi2.sf(W2,len(_hb2))

# Wald test of the habitat block in Model B (cross-check on the LRT)
_hb = [i for i,n in enumerate(mB.params.index) if n.startswith("hab_")]
_b = mB.params.iloc[_hb].to_numpy()
_V = (mB.cov_params().iloc[_hb,_hb].to_numpy()) * phiB
W_hab = float(_b @ np.linalg.inv(_V) @ _b)
p_wald_hab = stats.chi2.sf(W_hab, len(_hb))

orA.to_csv("step2_glm_habitat_only.csv", index=False)
orB.to_csv("step2_glm_habitat_plus_covariates.csv", index=False)

# =====================================================================
# COMPOSE REPORT
# =====================================================================
R = []
R.append("STEP 1 - Gardening prevalence by habitat (primary metric: gardening share = sum n.gard / sum n.total)\n")
R.append(step1.to_string(index=False))
R.append(f"\nOVERALL: gardening share = {sg_all}/{st_all} = {sg_all/st_all:.3f}  Wilson95% CI = ({lo_all:.3f},{hi_all:.3f}); "
         f"mean n.gard/plot = {df['n.gard'].mean():.3f}; plots with >=1 gardening species = {(df['n.gard']>0).sum()}/{len(df)} ({(df['n.gard']>0).mean()*100:.1f}%); "
         f"invaded plots (n.total>0) = {int((df['n.total']>0).sum())}/{len(df)}.")
R.append(f"\nChi-square (habitat x pathway, pooled): chi2={chi2:.2f}, dof={dof}, p={pchi:.2e}  [caveat: several habitats <5 expected counts]")
R.append(f"Permutation test (habitat x pathway, N={Nperm}): obs chi2={obs_chi2:.2f}, exceedances={_k}, p={p_perm:.5f} (corrected p={p_perm_corrected:.6f})  [robust to small cells]")
R.append("\n\nSTEP 2 - Quasibinomial GLM of gardening share (trials=n.total), restricted to %d invaded plots\n" % len(d))
R.append(f"Model A (habitat only): Pearson dispersion phi={phiA:.3f}, llf={mA.llf:.2f}, df_resid={mA.df_resid:.0f}")
R.append("Reference habitat: %s\n" % REF)
R.append(orA.to_string(index=False))
R.append(f"\nModel B (habitat + env covariates: elevation, urban.2009.50m, cropland.2009.50m, distance.road, distance.stream, annual.temperature): phi={phiB:.3f}, llf={mB.llf:.2f}, df_resid={mB.df_resid:.0f}")
R.append(orB.to_string(index=False))
R.append(f"\n--- KEY TEST: does habitat remain significant after adding environment? ---")
R.append("LRT habitat-block (Model B vs covariates-only): chi2=%.2f, df=%d, p=%.3e" % lrt_habit_block)
R.append("LRT environment-over-habitat (Model B vs habitat-only): chi2=%.2f, df=%d, p=%.3e" % lrt_env_over_hab)
R.append("LRT habitat vs intercept-only (Model A): chi2=%.2f, df=%d, p=%.3e" % lrt_hab_vs_int)
R.append(f"Wald test, habitat block in Model B: W={W_hab:.2f}, df={len(_hb)}, p={p_wald_hab:.4f}  [cross-check on LRT habitat-block]")
R.append(f"\nSENSITIVITY (Model B excluding separation habitats {SEP}, n={len(d2)} invaded plots): phi={phiB2:.3f}")
R.append(sens.to_string(index=False))
R.append(f"Sensitivity habitat-block: LRT chi2={lrt2[0]:.2f}, df={lrt2[1]}, p={lrt2[2]:.3e};  Wald W={W2:.2f}, df={len(_hb2)}, p={pW2:.3e}")
# Temporal context
gT = dfT.pivot(index="introduction.period", columns="pathway", values="n")
R.append("\nTEMPORAL CONTEXT (temporal_trends_contingency_table.csv):")
R.append(gT.loc[["Before 1500","1501-1900","1901-1984","1985-2019"]].to_string())
report = "\n".join(R)
print(report)
with open("analysis_results.md","w") as f:
    f.write(report)
print("\n\nSaved: step1_habitat_gardening_summary.csv, step2_glm_habitat_only.csv, step2_glm_habitat_plus_covariates.csv, analysis_results.md")
