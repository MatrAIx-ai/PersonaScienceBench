#!/usr/bin/env python3
"""
DiscoveryBench: In what context does the gardening pathway for introducing
non-native plants show different prevalence styles across habitat types?
Region: Catalonia / Barcelona province. Fully reproducible analysis script.
"""
import re, itertools
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm

rng = np.random.default_rng(42)
pd.set_option('display.width', 200)

# ---------- load ----------
niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
inv   = pd.read_csv('data/invasion_success_pathways.csv')
cont  = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
newick = open('data/phylogenetic_tree.txt').read().strip()

print('='*80)
print('STEP 1  Pathway x Habitat contingency table (plot counts)')
print('='*80)
tab = niche.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum()
tab['n.total'] = niche.groupby('habitat')['n.total'].sum()
tab['gard.share'] = (tab['n.gard']/tab['n.total']).round(3)
tab['unint.share'] = (tab['n.unint']/tab['n.total']).round(3)
tab['agfo.share'] = (tab['n.agfo']/tab['n.total']).round(3)
print(tab.sort_values('n.gard', ascending=False))

# chi-square 3 pathways x 10 habitats
chi2, p, dof, exp = stats.chi2_contingency(tab[['n.gard','n.unint','n.agfo']].values)
n_cells = exp.size
n_low = (exp < 5).sum()
print(f'\n3x10 chi2={chi2:.2f}, p={p:.3e}, dof={dof}; expected<5: {n_low}/{n_cells} cells ({100*n_low/n_cells:.0f}%)')

# 2x10 gardening vs non-gardening
tab2 = pd.DataFrame({'Gardening': tab['n.gard'], 'NonGardening': tab['n.unint']+tab['n.agfo']})
chi2b, pb, dofb, expb = stats.chi2_contingency(tab2.values)
print(f'2x10 chi2={chi2b:.2f}, p={pb:.3e}, dof={dofb}; expected<5: {(expb<5).sum()}/{expb.size} cells')

def cramers_v(x, obs):
    n = np.asarray(obs).sum()
    return np.sqrt(x/(n*(min(obs.shape)-1)))
print(f'Cramers V (3x10) = {cramers_v(chi2, tab.values):.3f}; V (2x10) = {cramers_v(chi2b, tab2.values):.3f}')

# Fisher on aggregated 2x2: human-modified (Urban+Croplands) vs semi/natural (rest)
groups = {'Human-modified': ['Urban','Croplands'], 'Semi/natural': ['Riparian','Wetlands','Coastal','Coniferous forests','Broad-leaved forests','Meadows','Scrublands','Rock outcrops']}
m = np.array([[tab.loc[habs,'n.gard'].sum(), (tab.loc[habs,'n.unint']+tab.loc[habs,'n.agfo']).sum()] for g,habs in groups.items()])
odd, pf = stats.fisher_exact(m)
print(f'Fisher 2x2 (Gardening vs rest; human-modified vs semi/natural): OR={odd:.2f}, p={pf:.4f}\n  table:\n{pd.DataFrame(m, index=list(groups), columns=["Gardening","NonGardening"])}')

# gardening share restricted to plots with any non-native (n.total>0)
sub = niche[niche['n.total']>0]
t2 = sub.groupby('habitat')[['n.gard','n.total']].sum()
t2['gard.share.nn'] = (t2['n.gard']/t2['n.total']).round(3)
print('\nGardening share among plots with >=1 non-native:')
print(t2.sort_values('gard.share.nn', ascending=False))

print()
print('='*80)
print('STEP 2  GLMs: n.gard ~ habitat + urban.2009.50m + progressive.1993.2009.50m + elevation')
print('='*80)
X = pd.get_dummies(niche['habitat'], drop_first=True, dtype=float)
X['urban.2009.50m'] = niche['urban.2009.50m']
X['progressive.1993.2009.50m'] = niche['progressive.1993.2009.50m']
X['elevation'] = niche['elevation']
X = sm.add_constant(X)
y = niche['n.gard'].astype(float)

pois = sm.GLM(y, X, family=sm.families.Poisson()).fit()
od = pois.deviance/pois.df_resid
print(f'Poisson: deviance/df = {od:.2f} (overdispersed if >>1)')
if od > 1.5:
    model = sm.GLMNegativeBinomial(y, X).fit()
    kind = 'NegativeBinomial'
else:
    model = pois
    kind = 'Poisson'
print(f'\n{kind} model for n.gard (IRR / OR):')
res = pd.DataFrame({'coef': model.params, 'p': model.pvalues, 'exp': np.exp(model.params)}).round(4)
print(res)

# logistic for presence of gardening species
yp = (niche['n.gard']>0).astype(float)
logit = sm.GLM(yp, X, family=sm.families.Binomial()).fit()
lr = pd.DataFrame({'coef': logit.params, 'p': logit.pvalues, 'OR': np.exp(logit.params)}).round(4)
print('\nLogistic (n.gard>0), odds ratios:')
print(lr)

print()
print('='*80)
print('STEP 3  Species level: Gardening vs other pathways (invasion_success)')
print('='*80)
gd = inv[inv['intro.pathway']=='Gardening']; ng = inv[inv['intro.pathway']!='Gardening']
print(f'Gardening n={len(gd)}, other n={len(ng)}')
for col in ['habitat.range','number.of.invaded.plots','mrt','invaded.niche.breadth']:
    u, pu = stats.mannwhitneyu(gd[col], ng[col], alternative='two-sided')
    print(f'Mann-Whitney {col}: Gardening mean={gd[col].mean():.2f} vs other={ng[col].mean():.2f}, U={u:.0f}, p={pu:.4f}')
# 3-group Kruskal-Wallis on habitat.range
H, pK = stats.kruskal(*[inv[inv['intro.pathway']==g]['habitat.range'] for g in ['Gardening','Unintentional','AgriForest']])
print(f'Kruskal-Wallis habitat.range (3 pathways): H={H:.2f}, p={pK:.4f}')
# chi-square growth.form
ct = pd.crosstab(inv['intro.pathway'], inv['growth.form'])
c2, pc, d2, e2 = stats.chi2_contingency(ct)
print(f'chi2 growth.form x pathway: chi2={c2:.2f}, p={pc:.4f}; expected<5: {(e2<5).sum()}/{e2.size}')
print(ct)
# sensitivity: drop duplicated=TRUE
inv2 = inv[inv['duplicated']!=True]
gd2 = inv2[inv2['intro.pathway']=='Gardening']; ng2 = inv2[inv2['intro.pathway']!='Gardening']
u,pu = stats.mannwhitneyu(gd2['habitat.range'], ng2['habitat.range'], alternative='two-sided')
print(f'Sensitivity (drop 4 duplicated rows, n={len(gd2)}/{len(ng2)}): habitat.range p={pu:.4f}')

print()
print('='*80)
print('STEP 4  Temporal trends')
print('='*80)
ct2 = cont.pivot(index='introduction.period', columns='pathway', values='n').fillna(0)
order = ['Before 1500','1501-1900','1901-1984','1985-2019']
ct2 = ct2.loc[order]
ct2['total'] = ct2.sum(axis=1)
ct2['gard.share'] = (ct2['Gardening']/ct2['total']).round(3)
print(ct2)
chit, pt, _, _ = stats.chi2_contingency(ct2[['AgriForest','Gardening','Unintentional']].values)
print(f'chi2 period x pathway: chi2={chit:.2f}, p={pt:.3e}')

print()
print('='*80)
print('STEP 5  Phylogenetic clustering (matched species only)')
print('='*80)
# minimal Newick parser
s = newick
pos = [0]
def parse_node():
    if s[pos[0]] == '(':
        pos[0] += 1
        children = []
        while True:
            children.append(parse_node())
            if s[pos[0]] == ',': pos[0] += 1; continue
            elif s[pos[0]] == ')': pos[0] += 1; break
        node = {'children': children, 'name': None}
    else:
        node = {'children': [], 'name': None}
    label = ''
    while pos[0] < len(s) and s[pos[0]] not in ':;,)':
        label += s[pos[0]]; pos[0] += 1
    if node['name'] is None: node['name'] = label
    ln = ''
    if pos[0] < len(s) and s[pos[0]] == ':':
        pos[0] += 1
        while pos[0] < len(s) and s[pos[0]] not in ';,)':
            ln += s[pos[0]]; pos[0] += 1
    node['length'] = float(ln) if ln else 0.0
    return node
root = parse_node()
tips = []
def dfs(n, depth):
    d = depth + n['length']
    if not n['children']:
        tips.append((n['name'], d))
    else:
        for c in n['children']: dfs(c, d)
dfs(root, 0.0)
depth = dict(tips)
print(f'parsed tips: {len(tips)}')

inv_matched = inv[inv['phylo.tip.label'].isin(depth)]
gd_lab = set(inv_matched[inv_matched['intro.pathway']=='Gardening']['phylo.tip.label'])
ng_lab = set(inv_matched[inv_matched['intro.pathway']!='Gardening']['phylo.tip.label'])
print(f'matched species: {len(inv_matched)} (Gardening {len(gd_lab)}, other {len(ng_lab)})')

# pairwise tip distances via LCA on the small tree: use path sums
# build children map + parent map
parent = {}
def build(n, p):
    for c in n['children']:
        parent[id(c)] = n
        build(c, n)
build(root, None)
def lca(a, b):
    da = set()
    x = a
    while x is not None:
        da.add(id(x)); x = parent.get(id(x))
    y = b
    while id(y) not in da: y = parent.get(id(y))
    return y
def dist(a, b):
    c = lca(a, b)
    def d_to(t, anc):
        tot, x = 0.0, t
        while x is not anc:
            tot += x['length']; x = parent.get(id(x))
        return tot
    return d_to(a, c) + d_to(b, c)
# map tip names -> nodes
tip_nodes = {}
def collect(n):
    if not n['children']: tip_nodes[n['name']] = n
    else:
        for c in n['children']: collect(c)
collect(root)

def mean_within(labelset):
    labs = [l for l in labelset if l in tip_nodes]
    ds = [dist(tip_nodes[a], tip_nodes[b]) for a,b in itertools.combinations(labs,2)]
    return np.mean(ds), len(ds)
mw_g, ngp = mean_within(gd_lab)
mw_ng, ngp2 = mean_within(ng_lab)
print(f'mean within-group pairwise distance: Gardening={mw_g:.3f} (n pairs {ngp}), other={mw_ng:.3f} (n pairs {ngp2})')

# permutation test: same group size, random assignment
all_labs = list(gd_lab | ng_lab)
obs = mw_g
nperm = 2000
cnt = 0
for _ in range(nperm):
    perm = rng.choice(all_labs, size=len(gd_lab), replace=False)
    m, _ = mean_within(set(perm))
    cnt += (m <= obs)
p_perm = (cnt+1)/(nperm+1)
print(f'permutation test (clustering = lower within-group distance): p={p_perm:.4f}')
