#!/usr/bin/env python3
"""
DISCOVERYBENCH: 'In what scenario did urban land use promote a specific type of plant invasion?'
=============================================================================================
Data: invaded_niche_pathways.csv (632 plots x 37 vars). Each row = one sampled plot.
  - Response: per-plot species count per introduction pathway:
        n.gard (Gardening), n.unint (Unintentional), n.agfo (AgriForest)
  - 'Urban land use': urban.<year>.<scale> = % urban land cover in 50/500/1000 m buffer
        (years 1956/1993/2009).
  - Covariates: habitat (10 types), distance.road, distance.stream, elevation.
  - Aux (plan B): regressive.1956.2009.50m = fraction of 50 m buffer that urbanized/
        intensified 1956->2009 (inferred; see ASSUMPTION below).

Model: Poisson GLM (log link); switch to Negative Binomial if dispersion > 2.
'Promote' = positive urban association (IRR > 1).
"""
import pandas as pd, numpy as np, warnings, json
warnings.filterwarnings('ignore')
import statsmodels.api as sm
from statsmodels.discrete.discrete_model import NegativeBinomial
from statsmodels.stats.multitest import multipletests

# ---------------- load & validate ----------------
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t', dtype=str)
for c in df.columns:
    if c != 'habitat':
        v = pd.to_numeric(df[c], errors='coerce')
        if v.notna().all():
            df[c] = v
df['habitat'] = df['habitat'].astype('category')
assert int((df['n.total'] != df['n.gard'] + df['n.unint'] + df['n.agfo']).sum()) == 0
PATHS = {'Gardening': 'n.gard', 'Unintentional': 'n.unint', 'AgriForest': 'n.agfo'}
SCALES = ['50m', '500m', '1000m']
CTRL = ['distance.road', 'distance.stream', 'elevation']
KEY = ['Riparian', 'Coastal', 'Wetlands']          # water-adjacent semi-natural habitats
PRIMARY_SCALE = '500m'

def glm(y, X, nb=True):
    m = sm.GLM(y, X, family=sm.families.Poisson()).fit()
    disp = m.deviance / m.df_resid
    use = 'Poisson'
    if nb and disp > 2.0:
        try:
            nbm = NegativeBinomial(y, X, freq=False, alpha=1.0).fit(method='lbfgs', maxiter=5000)
            if nbm.mle_retvals['converged']:
                m, use = nbm, 'NegBin'
        except Exception:
            pass
    return m, use, disp

def irr(m, col, scale_sd=1.0):
    b, se = m.params[col], m.bse[col]
    return (round(float(np.exp(b*scale_sd)), 3),
            round(float(np.exp((b-1.96*se)*scale_sd)), 3),
            round(float(np.exp((b+1.96*se)*scale_sd)), 3),
            round(float(m.pvalues[col]), 4))

X = pd.DataFrame()

# ================= (a) POOLED model: urban.2009 per pathway per scale =================
rows = []
for pname, pcol in PATHS.items():
    y = df[pcol].astype(float).values
    for sc in SCALES:
        ucol = f'urban.2009.{sc}'
        X = pd.concat([pd.get_dummies(df['habitat'], prefix='hab', drop_first=True, dtype=float),
                       df[[ucol]], df[CTRL]], axis=1).reset_index(drop=True)
        X = sm.add_constant(X)
        m, use, disp = glm(y, X)
        iu, lu, hu, pu = irr(m, ucol)                       # per unit (per +100% urban)
        sd = df[ucol].std()
        isd, lsd, hsd, psd = irr(m, ucol, sd)               # per 1-SD
        rows.append(dict(pathway=pname, scale=sc, model=use, dispersion=round(disp, 2),
                         IRR_perunit=iu, perunit_CI=f"[{lu},{hu}]", p_perunit=pu,
                         IRR_perSD=isd, perSD_CI=f"[{lsd},{hsd}]", p_perSD=psd,
                         urban_mean=round(df[ucol].mean(), 3)))
a = pd.DataFrame(rows)
print("================= (a) POOLED Poisson GLM: urban.2009 per pathway per scale =================")
print(a.to_string(index=False))
a.to_csv('results_a_pooled_urban2009.csv', index=False)

# ================= (b) STANDARDIZED cross-pathway comparison @ 500m (pooled) =================
sc = PRIMARY_SCALE; ucol = f'urban.2009.{sc}'; sd = df[ucol].std()
b = []
for pname, pcol in PATHS.items():
    y = df[pcol].astype(float).values
    X = sm.add_constant(pd.concat([pd.get_dummies(df['habitat'], prefix='hab', drop_first=True, dtype=float),
                                   df[[ucol]], df[CTRL]], axis=1).reset_index(drop=True))
    m, use, disp = glm(y, X)
    i, lo, hi, p = irr(m, ucol, sd)
    b.append(dict(pathway=pname, scale=sc, IRR_perSD_std=i, CI=f"[{lo},{hi}]", p=p))
b = pd.DataFrame(b)
print(f"\n================= (b) STANDARDIZED cross-pathway comparison @ {sc} (pooled) =================")
print(b.to_string(index=False))
b.to_csv('results_b_std_crosspathway.csv', index=False)

# ================= (c) PER-HABITAT stratification @ 500m (full cov) + FDR =================
print(f"\n================= (c) PER-HABITAT urban effect @ {sc}, full covariates, BH-FDR =================")
cfull = []
for pname, pcol in PATHS.items():
    pvals, recs = [], []
    for h, grp in df.groupby('habitat'):
        y = grp[pcol].astype(float).reset_index(drop=True)
        if y.sum() < 3:
            continue
        X = sm.add_constant(pd.concat([grp[[ucol]].reset_index(drop=True), grp[CTRL].reset_index(drop=True)], axis=1))
        m, use, disp = glm(y.values, X)
        i, lo, hi, p = irr(m, ucol, sd)
        recs.append(dict(pathway=pname, habitat=h, n=len(grp), events=int(y.sum()),
                         IRR_perSD=i, CI=f"[{lo},{hi}]", p=p, model=use))
        pvals.append(p)
    rej, _, _, _ = multipletests(np.array(pvals), method='fdr_bh')
    for r, rv in zip(recs, rej):
        r['FDR_significant'] = bool(rv)
        cfull.append(r)
cfull = pd.DataFrame(cfull)
print(cfull.to_string(index=False))
cfull.to_csv('results_c_perhabitat_fullcov.csv', index=False)

# ---- (c2) cross-pathway within KEY habitats @ 500m, urban-only (cleanest association) ----
c2 = []
for h in KEY:
    grp = df[df.habitat == h]
    for pname, pcol in PATHS.items():
        y = grp[pcol].astype(float).reset_index(drop=True)
        if y.sum() < 3:
            c2.append(dict(habitat=h, pathway=pname, events=int(y.sum()), IRR_perSD=np.nan, p=np.nan, note='too few events'))
            continue
        X = sm.add_constant(grp[[ucol]].reset_index(drop=True))
        m, use, disp = glm(y.values, X)
        i, lo, hi, p = irr(m, ucol, sd)
        c2.append(dict(habitat=h, pathway=pname, n=len(grp), events=int(y.sum()),
                       IRR_perSD=i, CI=f"[{lo},{hi}]", p=p))
c2 = pd.DataFrame(c2)
print("\n================= (c2) CROSS-PATHWAY within KEY habitats @ 500m (urban-only) =================")
print(c2.to_string(index=False))
c2.to_csv('results_c2_crosspathway_keyhabitats.csv', index=False)

# ================= (d) SCALE comparison for Unintentional in KEY habitats =================
d = []
for sc in SCALES:
    ucol = f'urban.2009.{sc}'; sd = df[ucol].std()
    for h in KEY:
        grp = df[df.habitat == h]
        y = grp['n.unint'].astype(float).reset_index(drop=True)
        X = sm.add_constant(grp[[ucol]].reset_index(drop=True))
        m, use, disp = glm(y.values, X)
        i, lo, hi, p = irr(m, ucol, sd)
        d.append(dict(pathway='Unintentional', habitat=h, scale=sc, IRR_perSD=i, CI=f"[{lo},{hi}]", p=p))
d = pd.DataFrame(d)
print("\n================= (d) Unintentional per-habitat across SCALES (urban-only) =================")
print(d.to_string(index=False))
d.to_csv('results_d_scale_comparison.csv', index=False)

# ================= (e) TIME DIMENSION: level 2009 vs change 1956->2009 (Unintentional) =================
df['durban500'] = df['urban.2009.500m'] - df['urban.1956.500m']
e = []
for h in KEY:
    grp = df[df.habitat == h]
    y = grp['n.unint'].astype(float).reset_index(drop=True)
    for lab, col in [('LEVEL_2009', 'urban.2009.500m'), ('CHANGE_1956_2009', 'durban500')]:
        sd = grp[col].std()
        X = sm.add_constant(grp[[col]].reset_index(drop=True))
        m, use, disp = glm(y.values, X)
        i, lo, hi, p = irr(m, col, sd)
        e.append(dict(habitat=h, metric=lab, IRR_perSD=i, CI=f"[{lo},{hi}]", p=p))
e = pd.DataFrame(e)
print("\n================= (e) TIME DIMENSION: level(2009) vs change(1956->2009), Unintentional @500m =================")
print(e.to_string(index=False))
e.to_csv('results_e_time_dimension.csv', index=False)

# ================= (f) ROBUSTNESS: full-covariate per-habitat, Unintentional @500m =================
f = []
for h in KEY:
    grp = df[df.habitat == h]
    y = grp['n.unint'].astype(float).reset_index(drop=True)
    X = sm.add_constant(pd.concat([grp[[ucol]].reset_index(drop=True), grp[CTRL].reset_index(drop=True)], axis=1))
    m, use, disp = glm(y.values, X)
    i, lo, hi, p = irr(m, ucol, sd)
    f.append(dict(habitat=h, urban_IRR_perSD=i, CI=f"[{lo},{hi}]", p=p,
                  stream_p=round(float(m.pvalues['distance.stream']), 3)))
f = pd.DataFrame(f)
print("\n================= (f) ROBUSTNESS: full-covariate per-habitat, Unintentional @500m =================")
print(f.to_string(index=False))
f.to_csv('results_f_robustness.csv', index=False)

# ================= (g) AUX PLAN B: regressive.1956.2009.50m (inferred urbanization) =================
# ASSUMPTION: regressive = fraction of buffer that URBANIZED/intensified 1956->2009.
# If the original definition is the OPPOSITE, the sign of every coefficient below flips.
rcol = 'regressive.1956.2009.50m'; rsd = df[rcol].std()
g = []
for pname, pcol in PATHS.items():
    y = df[pcol].astype(float).values
    X = sm.add_constant(pd.concat([pd.get_dummies(df['habitat'], prefix='hab', drop_first=True, dtype=float),
                                   df[[rcol]], df[CTRL]], axis=1).reset_index(drop=True))
    m, use, disp = glm(y, X)
    i, lo, hi, p = irr(m, rcol, rsd)
    g.append(dict(pathway=pname, model=use, dispersion=round(disp, 2),
                  regressive_IRR_perSD=i, CI=f"[{lo},{hi}]", p=p))
g = pd.DataFrame(g)
print("\n================= (g) AUX PLAN B: regressive.1956.2009.50m (pooled) [50 m only] =================")
print(g.to_string(index=False))
g.to_csv('results_g_aux_regressive.csv', index=False)

print("\nAll results saved to results_*.csv")
