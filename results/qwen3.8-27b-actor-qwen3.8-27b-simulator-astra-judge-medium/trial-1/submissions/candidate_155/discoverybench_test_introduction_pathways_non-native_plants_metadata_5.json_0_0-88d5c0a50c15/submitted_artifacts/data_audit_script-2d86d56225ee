#!/usr/bin/env python3
"""Preliminary data audit for the 4 supplied files (read-only)."""
import pandas as pd, numpy as np, re

pd.set_option('display.width', 200)

# 1) temporal trends (TSV)
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
print("temporal_trends:", tt.shape, "cols:", list(tt.columns), "n range:", tt['n'].min(), tt['n'].max())
print(tt.to_string(index=False))

# 2) phylo tree
tree = open('data/phylogenetic_tree.txt').read().strip()
tips = set(t for t in re.findall(r'([A-Za-z0-9._\-]+):[\d.]+', tree)
           if not t.startswith('mrca') and not t.startswith('Spermatophyta'))
print("phylo tips (excl internal):", len(tips))

# 3) species-level
sp = pd.read_csv('data/invasion_success_pathways.csv')
print("invasion_success:", sp.shape, "NA per col>0:", {k:int(v) for k,v in sp.isna().sum().items() if v})
print("intro.pathway:", sp['intro.pathway'].value_counts().to_dict())
print("sp tips in tree:", sp['phylo.tip.label'].isin(tips).all())

# 4) plot-level (core)
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t', dtype=str)
num = lambda c: pd.to_numeric(df[c], errors='coerce')
print("invaded_niche:", df.shape)
print("any NA in any col:", int(df.isna().sum().sum()))
urban = [f"urban.{y}.{s}" for y in ['1956','1993','2009'] for s in ['50m','500m','1000m']]
print("9 urban cols present:", all(c in df.columns for c in urban),
      "all non-null:", all(num(c).notna().all() for c in urban))
for c in ['n.gard','n.unint','n.agfo','n.total']:
    print(f"  {c}: nulls={num(c).isna().sum()} range=[{num(c).min()},{num(c).max()}]")
print("n.total == sum(3 pathways) violations:",
      int((num('n.total') != num('n.gard')+num('n.unint')+num('n.agfo')).sum()))
print("habitat:", df['habitat'].value_counts().to_dict())
for win in ['1956.2009','1993.2009']:
    s = num(f'progressive.{win}.50m')+num(f'regressive.{win}.50m')+num(f'no.changes.{win}.50m')
    print(f"  {win}: continuous? nunique={s.nunique()}, sum==1 rows={(abs(s-1)<1e-6).sum()}, sum<0.95 rows={(s<0.95).sum()}")
    print(f"    corr(progressive, d_urban+crop)={np.corrcoef(num(f'progressive.{win}.50m'), num('urban.2009.50m')-num('urban.1956.50m')+num('cropland.2009.50m')-num('cropland.1956.50m'))[0,1]:.2f}, "
          f"corr(regressive, d_urban)={np.corrcoef(num(f'regressive.{win}.50m'), num('urban.2009.50m')-num('urban.1956.50m'))[0,1]:.2f}")
u=num('urban.2009.500m')
print("corr(urban.2009.500m, pathway):",
      {p: round(float(np.corrcoef(num(p),u)[0,1]),3) for p in ['n.gard','n.unint','n.agfo','n.total']})
