#!/usr/bin/env python3
"""
DiscoveryBench: "What types of plant introductions were influenced by urban land use?"
Main analysis on data/invaded_niche_pathways.csv (plot-level, n=632).
Response: n.gard / n.unint / n.agfo (counts of non-native species per plot by pathway).
Main predictor: urban.2009.500m (fraction of urban land cover, 500 m buffer).
Controls: habitat, elevation, cropland.2009.500m, distance.stream, distance.road,
          annual.temperature, annual.rainfall.
Method: negative-binomial GLM on z-scored predictors (standardized coefficients).
Sensitivity: same models without habitat.
Spatial check: Moran's I (10-NN, row-standardized) on raw n.total and model residuals.
Background only (not in models): temporal_trends_contingency_table.csv,
invasion_success_pathways.csv.
"""
import numpy as np, pandas as pd, scipy.stats as sps
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.discrete.discrete_model import NegativeBinomial

pd.set_option('display.width', 200)
RNG = np.random.default_rng(42)

df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
print(f"Loaded invaded_niche_pathways.csv: {df.shape[0]} rows x {df.shape[1]} cols; "
      f"missing={int(df.isna().sum().sum())}")

# ---------- 1) handling of progressive/regressive/no.changes anomaly ----------
for a, b, c in [('progressive.1956.2009.50m', 'regressive.1956.2009.50m', 'no.changes.1956.2009.50m'),
                ('progressive.1993.2009.50m', 'regressive.1993.2009.50m', 'no.changes.1993.2009.50m')]:
    s = df[a] + df[b] + df[c]
    n_anom = int((s < 0.999).sum())
    print(f"  {a[:12]}...50m triple sum: min={s.min():.3f} max={s.max():.3f}; rows with sum<1: {n_anom}/{len(df)}")
print("  -> DECISION: rows are KEPT (anomaly noted, not excluded); these change variables are NOT in the main model.")

# ---------- 2) standardized predictors ----------
CONTROLS = ['elevation', 'cropland.2009.500m', 'distance.stream', 'distance.road',
            'annual.temperature', 'annual.rainfall']
PRED = ['urban.2009.500m'] + CONTROLS
z = (df[PRED] - df[PRED].mean()) / df[PRED].std(ddof=0)
d = df.copy()
for c in PRED:
    d['z_' + c] = z[c].values
d['habitat'] = d['habitat'].astype('category')
hab_dum = pd.get_dummies(d['habitat'], drop_first=True, dtype=float, prefix='hab')
d = pd.concat([d, hab_dum], axis=1)
HAB_COLS = list(hab_dum.columns)

def fit_nb(y, x_names, data, label):
    X = sm.add_constant(data[x_names].astype(float))
    try:
        m = NegativeBinomial(data[y], X).fit(method='lbfgs', maxiter=500, disp=0)
        if not m.mle_retvals['converged']:
            raise RuntimeError('no convergence')
        return m
    except Exception as e:
        print(f"  NB failed for {label}: {e}")
        return None

def report(m, yname, label):
    b = float(m.params['z_urban.2009.500m'])
    lo, hi = m.conf_int().loc['z_urban.2009.500m'].tolist()
    p = float(m.pvalues['z_urban.2009.500m'])
    print(f"  [{label}] {yname}: NB coef(urban.2009.500m)={b:+.3f} (95% CI {lo:+.3f},{hi:+.3f}) "
          f"p={p:.4f}; rate ratio per 1 SD urban = {np.exp(b):.3f} (CI {np.exp(lo):.3f}-{np.exp(hi):.3f}); "
          f"alpha={m.params['alpha']:.3f}; n={int(m.nobs)}")
    return b, lo, hi, p

print("\n=== MAIN MODELS (with habitat + controls), NegBin, z-scored predictors ===")
results = {}
for y in ['n.gard', 'n.unint', 'n.agfo']:
    m = fit_nb(y, ['z_urban.2009.500m'] + ['z_' + c for c in CONTROLS] + HAB_COLS, d, f"with-habitat {y}")
    if m is not None:
        results[(y, 'with_habitat')] = report(m, y, 'with habitat')
    else:
        results[(y, 'with_habitat')] = None

print("\n=== SENSITIVITY (without habitat), NegBin, z-scored predictors ===")
for y in ['n.gard', 'n.unint', 'n.agfo']:
    m = fit_nb(y, ['z_urban.2009.500m'] + ['z_' + c for c in CONTROLS], d, f"wo-habitat {y}")
    if m is not None:
        results[(y, 'wo_habitat')] = report(m, y, 'wo habitat')
    else:
        results[(y, 'wo_habitat')] = None

# ---------- 3) fallback nonparametric tests (used if NB failed; always reported as check) ----------
print("\n=== NONPARAMETRIC CHECKS (Mann-Whitney, urban.2009.500m top vs bottom half by median) ===")
med = df['urban.2009.500m'].median()
hi, lo = df[df['urban.2009.500m'] > med], df[df['urban.2009.500m'] <= med]
np_results = {}
for y in ['n.gard', 'n.unint', 'n.agfo', 'n.total']:
    u, p = sps.mannwhitneyu(hi[y], lo[y], alternative='two-sided')
    # rank-biserial r
    n1, n2 = len(hi), len(lo)
    r = 1 - 2 * u / (n1 * n2)
    np_results[y] = (p, r)
    print(f"  {y}: med_hi={hi[y].median():.1f} vs med_lo={lo[y].median():.1f}, "
          f"Mann-Whitney p={p:.3e}, rank-biserial r={r:+.3f}")
print("  Per-half MEANS (zero-inflation check):")
for y in ['n.gard', 'n.unint', 'n.agfo', 'n.total']:
    print(f"  {y}: mean_hi={hi[y].mean():.3f} vs mean_lo={lo[y].mean():.3f} (med_hi={hi[y].median():.0f}, med_lo={lo[y].median():.0f})")
# Fisher exact on presence x urban-median split
print("  Fisher exact (presence>0 x urban-median split):")
for y in ['n.gard', 'n.unint', 'n.agfo']:
    tab = pd.crosstab(df[y] > 0, df['urban.2009.500m'] > med)
    od, p = sps.fisher_exact(tab.values)
    print(f"  {y}: table={tab.values.tolist()}, OR={od:.3f}, p={p:.4f}")

# ---------- 4) Moran's I (10-NN row-standardized) ----------
def moran_i(x, coords, k=10):
    xy = np.column_stack([np.asarray(c, dtype=float) for c in coords])
    d2 = ((xy[:, None, :] - xy[None, :, :]) ** 2).sum(-1)
    np.fill_diagonal(d2, np.inf)
    nn = np.argsort(d2, axis=1)[:, :k]
    n = len(x)
    W = np.zeros((n, n))
    W[np.arange(n)[:, None], nn] = 1.0 / k
    x = np.asarray(x, float); x = (x - x.mean()) / x.std(ddof=0)
    S0 = (W ** 2).sum()
    S1 = 0.0  # row-standardized
    S2 = ((W @ W.T).diagonal()).sum()
    # I = [n * sum_ij w_ij x_i x_j / S0] / sum_i (x_i - xbar)^2 ; with unit-pop-var x: sum (x_i-xbar)^2 = n
    I = (W @ x).dot(x) / S0
    mu = -1.0 / (n - 1)
    var = (n ** 2 * S0 - 2 * S1 + 2 * S2) / ((n - 1) * S0 ** 2) - mu ** 2
    zscore = (I - mu) / np.sqrt(var)
    p = 2 * (1 - sps.norm.cdf(abs(zscore)))
    return I, zscore, p

coords = [df['longitude'].values, df['latitude'].values]
print("\n=== MORAN'S I (10-NN, row-standardized) ===")
for name, x in [('n.total (raw)', df['n.total'].values)]:
    I, z, p = moran_i(x, coords)
    print(f"  {name}: I={I:+.3f}, z={z:+.2f}, p={p:.4f}")
# residuals from full n.total model
mt = fit_nb('n.total', ['z_urban.2009.500m'] + ['z_' + c for c in CONTROLS] + HAB_COLS, d, 'n.total full')
if mt is not None:
    resid = mt.resid
    I, z, p = moran_i(resid, coords)
    print(f"  n.total full-model residuals: I={I:+.3f}, z={z:+.2f}, p={p:.4f}")
for y in ['n.gard', 'n.unint']:
    m = fit_nb(y, ['z_urban.2009.500m'] + ['z_' + c for c in CONTROLS] + HAB_COLS, d, f'{y} resid')
    if m is not None:
        I, z, p = moran_i(m.resid, coords)
        print(f"  {y} full-model residuals: I={I:+.3f}, z={z:+.2f}, p={p:.4f}")

# ---------- 5) background (NOT in models) ----------
print("\n=== BACKGROUND (context only) ===")
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
print(tt.to_string(index=False))
for per, g in tt.groupby('introduction.period', sort=False):
    g2 = g.sort_values('n', ascending=False)
    top = g2.iloc[0]
    print(f"  {per}: n={int(g['n'].sum())}, dominant={top['pathway']} ({int(top['n'])}/{int(g['n'].sum())} = {top['n']/g['n'].sum():.0%})")
sp = pd.read_csv('data/invasion_success_pathways.csv')
spu = sp[sp['duplicated'] != 'TRUE']
vc = spu['intro.pathway'].value_counts()
print(f"invasion_success_pathways: {len(spu)} unique species; pathways: {dict(vc)}")
print(f"  mean mrt by pathway: {spu.groupby('intro.pathway')['mrt'].mean().round(1).to_dict()}")

# ---------- 5b) multi-scale robustness (without habitat) ----------
print("\n=== MULTI-SCALE ROBUSTNESS (without habitat; controls incl. cropland same-year/scale) ===")
for radius in ['50m', '500m', '1000m']:
    ctrl = ['elevation', f'cropland.2009.{radius}', 'distance.stream', 'distance.road',
            'annual.temperature', 'annual.rainfall']
    names = ['urban.2009.' + radius] + ctrl
    zz = (df[names] - df[names].mean()) / df[names].std(ddof=0)
    d2 = df.copy()
    for c in names:
        d2['z_' + c] = zz[c].values
    line = f"  {radius}: "
    for y in ['n.gard', 'n.unint', 'n.agfo']:
        m = fit_nb(y, ['z_urban.2009.' + radius] + ['z_' + c for c in ctrl], d2, f'{y} {radius}')
        if m is not None:
            b = float(m.params['z_urban.2009.' + radius]); p = float(m.pvalues['z_urban.2009.' + radius])
            line += f"{y}={b:+.3f}(p={p:.3f})  "
        else:
            line += f"{y}=NB-failed  "
    print(line)

# ---------- 6) final summary table ----------
print("\n=== SUMMARY: standardized urban.2009.500m effect per pathway ===")
rows = []
for y in ['n.gard', 'n.unint', 'n.agfo']:
    for sens in ['with_habitat', 'wo_habitat']:
        r = results.get((y, sens))
        if r:
            rows.append({'pathway': y, 'model': sens, 'coef': round(r[0], 3),
                         'ci_low': round(r[1], 3), 'ci_high': round(r[2], 3), 'p': r[3]})
        else:
            rows.append({'pathway': y, 'model': sens, 'coef': 'NB-failed->see nonparametric'})
sumdf = pd.DataFrame(rows)
print(sumdf.to_string(index=False))
sumdf.to_csv('/workspace/results_summary.csv', index=False)
print("\nSaved /workspace/results_summary.csv")
