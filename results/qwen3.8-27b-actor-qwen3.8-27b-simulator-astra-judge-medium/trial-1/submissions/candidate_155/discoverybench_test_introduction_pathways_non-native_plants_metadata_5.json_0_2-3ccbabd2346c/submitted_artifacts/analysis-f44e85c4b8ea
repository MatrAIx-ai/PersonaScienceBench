import numpy as np, pandas as pd, json, warnings, re
warnings.filterwarnings('ignore')
from scipy.stats import chi2_contingency, kruskal
import json
A = json.load(open('results_A.json'))
RNG = np.random.default_rng(42)

# ---------------- TEMPORAL contingency ----------------
t = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
tab = t.pivot(index='introduction.period', columns='pathway', values='n').fillna(0)
order = ['Before 1500', '1501-1900', '1901-1984', '1985-2019']
tab = tab.reindex(order)
chi2, p, dof, _ = chi2_contingency(tab.values)
n_tot = int(tab.values.sum()); k = min(tab.shape) - 1
cramers_v = float(np.sqrt(chi2 / (n_tot * k)))
row_pct = tab.div(tab.sum(axis=1), axis=0) * 100
A['temporal'] = dict(chi2=round(float(chi2), 2), p=float(p), dof=int(dof),
                     cramers_v=round(cramers_v, 3), n_total=n_tot,
                     table={i: {c: int(tab.loc[i, c]) for c in tab.columns} for i in order},
                     row_pct={i: {c: round(float(row_pct.loc[i, c]), 1) for c in tab.columns} for i in order})

# ---------------- INVASION SUCCESS by pathway ----------------
s = pd.read_csv('data/invasion_success_pathways.csv')
success = {}
for var in ['number.of.invaded.plots', 'area.of.occupancy.10km', 'invaded.niche.breadth', 'mrt']:
    groups = [s.loc[s['intro.pathway'] == p, var].dropna().values for p in ['Gardening', 'Unintentional', 'AgriForest']]
    H, p = kruskal(*groups)
    success[var] = dict(H=round(float(H), 2), p=float(p),
                        med={p_: float(np.median(g)) for p_, g in zip(['Gardening', 'Unintentional', 'AgriForest'], groups)},
                        n={p_: int(len(g)) for p_, g in zip(['Gardening', 'Unintentional', 'AgriForest'], groups)})
A['invasion_success'] = success
A['invasion_success_note'] = 'Kruskal-Wallis across pathways; differences modest (see p).'

# ---------------- PHYLOGENETIC ----------------
def parse_newick(txt):
    txt = txt.strip()
    if txt.endswith(';'): txt = txt[:-1]
    pos = 0
    def read_num():
        nonlocal pos
        st = pos
        while pos < len(txt) and (txt[pos].isdigit() or txt[pos] in '.eE+-'):
            pos += 1
        return float(txt[st:pos]) if pos > st else 0.0
    def parse():
        nonlocal pos
        if txt[pos] == '(':
            pos += 1
            children = []
            while True:
                children.append(parse())
                if txt[pos] == ',': pos += 1; continue
                if txt[pos] == ')': pos += 1; break
            node = {'children': children, 'name': None}
        else:
            st = pos
            while pos < len(txt) and txt[pos] not in ':,)': pos += 1
            node = {'children': None, 'name': txt[st:pos]}
        if pos < len(txt) and txt[pos] == ':':
            pos += 1; node['bl'] = read_num()
        else:
            node['bl'] = 0.0
        return node
    return parse()

tree_txt = open('data/phylogenetic_tree.txt').read()
root = parse_newick(tree_txt)
tips = {}
def walk(node, depth, level):
    nd = depth + node['bl']; node['_depth'] = nd; node['_level'] = level
    if node['children'] is None:
        tips[node['name']] = nd
    else:
        for c in node['children']: walk(c, nd, level + 1)
walk(root, 0.0, 0)
A['phylo_n_tips'] = len(tips)

labels = s['phylo.tip.label'].dropna().tolist()
present = [l for l in labels if l in tips]
missing = [l for l in labels if l not in tips]
A['phylo_labels_total'] = len(labels)
A['phylo_labels_in_tree'] = len(present)
A['phylo_labels_missing'] = missing

parent = {}
def build_parent(node):
    if node['children'] is not None:
        for c in node['children']:
            parent[id(c)] = node; build_parent(c)
build_parent(root)
tipnode = {}
def collect(node):
    if node['children'] is None: tipnode[node['name']] = node
    else:
        for c in node['children']: collect(c)
collect(root)
def lca_depth(a, b):
    na, nb = tipnode[a], tipnode[b]
    while na['_level'] > nb['_level']: na = parent[id(na)]
    while nb['_level'] > na['_level']: nb = parent[id(nb)]
    while na is not nb:
        na = parent[id(na)]; nb = parent[id(nb)]
    return na['_depth']
def coph(a, b): return tips[a] + tips[b] - 2 * lca_depth(a, b)
def mean_pw(names):
    if len(names) < 2: return np.nan
    return float(np.mean([coph(a, b) for i, a in enumerate(names) for b in names[i+1:]]))

pair = list(zip(labels, s['intro.pathway']))
alltips = present
cluster = {}
for p in ['Gardening', 'Unintentional', 'AgriForest']:
    grp = [l for l, p2 in pair if p2 == p and l in tips]
    obs = mean_pw(grp)
    null = [mean_pw(list(RNG.permutation(alltips)[:len(grp)])) for _ in range(999)]
    null = np.array([x for x in null if np.isfinite(x)])
    pv = float((np.sum(null >= obs) + 1) / (len(null) + 1))
    cluster[p] = dict(n_species=len(grp), obs_mean_pw=round(obs, 4),
                      null_mean=round(float(np.mean(null)), 4), p_monophyly_signal=pv)
A['phylo_clustering'] = cluster
A['phylo_note'] = ('Test: mean pairwise cophenetic distance within each pathway vs 999 tip permutations. '
                   'Lower obs than null = phylogenetic clustering of that pathway.')

json.dump(A, open('results_A.json', 'w'), indent=2, default=float)
print("TEMPORAL: chi2=%.1f p=%.3g CV=%.3f" % (A['temporal']['chi2'], A['temporal']['p'], A['temporal']['cramers_v']))
print("  row_pct:", json.dumps(A['temporal']['row_pct']))
print("\nINVASION SUCCESS (Kruskal p):")
for k, v in success.items(): print(f"  {k}: p={v['p']:.4f} med={v['med']}")
print("\nPHYLO: tips=%d labels_in_tree=%d/%d missing=%s" % (A['phylo_n_tips'], A['phylo_labels_in_tree'], A['phylo_labels_total'], missing))
for k, v in cluster.items(): print(f"  {k}: n={v['n_species']} obs={v['obs_mean_pw']} null={v['null_mean']} p={v['p_monophyly_signal']}")
