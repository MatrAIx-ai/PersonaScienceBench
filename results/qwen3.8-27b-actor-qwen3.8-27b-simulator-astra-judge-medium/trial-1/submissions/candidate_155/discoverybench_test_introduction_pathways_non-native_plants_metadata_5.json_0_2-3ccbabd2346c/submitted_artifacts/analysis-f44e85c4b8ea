# ---------- FULL ZINB (as requested) with caveat ----------
def zinb_nll(theta, Xc, Xz, y, J):
    p, q = J
    b, a = theta[:p], theta[p:p+q]
    alpha = np.exp(np.clip(theta[-1], -4, 6))
    mu = np.exp(np.clip(Xc @ b, -30, 30)); pi = expit(Xz @ a)
    lnb = (gammaln(y + alpha) - gammaln(alpha) - gammaln(y + 1)
           + alpha * np.log(alpha / (alpha + mu)) + y * np.log(mu / (alpha + mu)))
    lp0 = np.log(np.clip(1 - pi + pi * np.exp(lnb), 1e-300, None))
    lpg = np.log(np.clip(1 - pi, 1e-300, None)) + lnb
    return -np.where(y == 0, lp0, lpg).sum()

def fit_zinb(Xc, Xz, y, names):
    p, q = Xc.shape[1], Xz.shape[1]
    try: a0 = sm.Logit((y == 0).astype(float), Xz).fit(disp=0).params
    except Exception: a0 = np.full(q, -2.0)
    try: b0 = sm.GLM(y, Xc, family=sm.families.Poisson()).fit(disp=0).params
    except Exception: b0 = np.zeros(p)
    best = None
    for t0 in [np.concatenate([b0, a0, [0.0]]), np.concatenate([np.zeros(p), np.full(q, -2.0), [0.0]])]:
        res = minimize(zinb_nll, t0, args=(Xc, Xz, y, (p, q)), method='L-BFGS-B',
                       options={'maxiter': 6000, 'ftol': 1e-12})
        if best is None or res.fun < best.fun: best = res
    theta = best.x
    idx = list(names).index('urban_2009_50m')
    b, a = theta[:p], theta[p:p+q]
    return dict(alpha=float(np.exp(np.clip(theta[-1], -4, 6))), llf=round(-best.fun, 2),
                count_urban=dict(coef=round(float(b[idx]), 4), ratio=round(float(np.exp(b[idx])), 3)),
                zi_urban=dict(coef=round(float(a[idx]), 4), ratio=round(float(np.exp(a[idx])), 3)),
                ok=bool(best.success))

zinb = {}
for yname, label in PATHS:
    y = d[yname].values
    for wh, tag in [(False, 'no_habitat'), (True, 'with_habitat')]:
        X, names = design(d, 'urban_2009_50m', wh)
        zinb[f'{label}|{tag}'] = fit_zinb(X.values, X.values, y, names)
OUT['zinb_2009_50m'] = zinb
OUT['zinb_caveat'] = ('alpha -> infinity (Poisson limit): no supported overdispersion; the urban effect on '
                      'presence is identifiable but its split between the Poisson mean and the excess-zero '
                      'probability is not (flat likelihood ridge, very large ZI SEs). Two-part model reported as '
                      'the well-identified equivalent.')

# ---------- SCALE sensitivity (two-part, no habitat) ----------
scale = {}
