# ---------- generic GLM helpers ----------
def design(df, urban_col, with_habitat, extra=()):
    cols = [urban_col] + [f'{c}_z' for c in covs] + ['cropland_2009_50m_z'] + list(extra)
    if with_habitat:
        cols += [f'hab_{h}' for h in hab_levels[1:]]
    X = pd.DataFrame(index=df.index); X['const'] = 1.0
    for c in cols: X[c] = df[c]
    X = X[['const'] + cols]
    return X, ['const'] + cols

def coef_ci(fit, names, name):
    pos = names.index(name)
    b = float(np.asarray(fit.params)[pos]); se = float(np.asarray(fit.bse)[pos])
    pv = np.asarray(fit.pvalues)
    p = float(pv[pos]) if (pv.size == len(names) and np.isfinite(pv).all()) else float('nan')
    return dict(coef=round(b, 4), se=round(se, 4),
                ratio=round(float(np.exp(b)), 3),
                lo=round(float(np.exp(b - 1.96 * se)), 3),
                hi=round(float(np.exp(b + 1.96 * se)), 3),
                p=round(p, 5))

# ---------- ridge (Firth-like) logistic for quasi-separation ----------
def ridge_logit(y, X, names, lam=1.0):
    n, k = X.shape
    mask = np.ones(k); mask[0] = 0.0  # don't penalize intercept
    def nll(beta):
        eta = X @ beta
        p = expit(eta)
        p = np.clip(p, 1e-12, 1 - 1e-12)
        ll = (y * np.log(p) + (1 - y) * np.log(1 - p)).sum()
        return -(ll - 0.5 * lam * (mask * beta) @ (mask * beta))
    res = minimize(nll, np.zeros(k), method='L-BFGS-B', options={'maxiter': 5000})
    beta = res.x
    # Hessian of penalized nll
    p = np.clip(expit(X @ beta), 1e-9, 1 - 1e-9)
    W = X.T @ (p * (1 - p)[:, None]) @ X - lam * np.diag(mask)
    try:
        se = np.sqrt(np.clip(np.diag(np.linalg.pinv(-W)), 0, None))
    except Exception:
        se = np.full(k, np.nan)
    class R: pass
    r = R(); r.params = pd.Series(beta, index=names); r.bse = pd.Series(se, index=names)
    with np.errstate(divide='ignore', invalid='ignore'):
        z = np.abs(beta / se)
        r.pvalues = pd.Series(2 * (1 - snorm.cdf(z)), index=names)
    r.llf = -res.fun + 0.5 * lam * (mask * beta) @ (mask * beta)
    return r

# ---------- TWO-PART (hurdle) model: presence logit + Poisson count on y>0 ----------
def two_part(df, yname, urban_col, with_habitat):
    y = df[yname].values
    pres = (y > 0).astype(float)
    X, names = design(df, urban_col, with_habitat)
    Xv = X.values
    if with_habitat:
        lf = ridge_logit(pres, Xv, names, lam=1.0)
    else:
        lf = sm.Logit(pres, Xv).fit(disp=0, maxiter=5000)
    nz = y > 0
    cf = sm.GLM(y[nz], Xv[nz], family=sm.families.Poisson()).fit(disp=0, maxiter=5000)
    mu = cf.mu; resid = (y[nz] - mu) ** 2 / mu
    disp = float(resid.sum() / (nz.sum() - len(names)))
    return dict(presence=coef_ci(lf, names, urban_col), count=coef_ci(cf, names, urban_col),
                n_nonzero=int(nz.sum()), overdisp_ratio=round(disp, 2),
                presence_all={nm: coef_ci(lf, names, nm) for nm in names if nm != 'const'},
                count_all={nm: coef_ci(cf, names, nm) for nm in names if nm != 'const'})

tp = {}
for yname, label in PATHS:
