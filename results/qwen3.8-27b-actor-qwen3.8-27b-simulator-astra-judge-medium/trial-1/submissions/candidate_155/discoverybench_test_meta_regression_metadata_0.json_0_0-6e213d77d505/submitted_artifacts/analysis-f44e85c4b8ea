"""
Formal analysis: In which domains are original-study effect sizes larger than
replication-study effect sizes (and by how much)?

Data: data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv
One row per (original study, replication) pair; 86 rows.

Metrics per domain (discipline level, primary; project level, robustness):
  - Absolute inflation: mean / median of (ro - rr)  [correlation scale]
                         and (fiso - fisr)          [Fisher-z scale, robustness]
  - Relative retention: mean / median of relative_es (= signed rr/ro; <1 => original larger)
  - Direction: fraction of studies with ro > rr; count of sign flips (relative_es < 0)
  - Paired test: Wilcoxon signed-rank on (ro - rr) and (fiso - fisr)
  - Bootstrap 95% CI on mean(ro - rr) (10,000 resamples)

Special case: Eitam et al. (Social) has rr = +0.1049 but relative_es = -0.472,
i.e. relative_es preserves the replication's sign vs the original direction
while rr appears sign-stripped. Flagged in tables; sensitivity analysis
recomputes Social metrics treating that rr as negative.
"""
import numpy as np
import pandas as pd
from scipy import stats

RNG = np.random.default_rng(42)
CSV = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(CSV, keep_default_na=False, na_values=["NA", ""])
assert len(df) == 86 and df["study"].is_unique

# integrity checks
assert (np.abs(np.arctanh(df["ro"]) - df["fiso"]).max() < 1e-10)
assert (np.abs(np.arctanh(df["rr"]) - df["fisr"]).max() < 1e-10)
rat = df["rr"] / df["ro"]
mismatch = (rat - df["relative_es"]).abs() > 1e-6
assert mismatch.sum() == 1 and df.loc[mismatch, "study"].iloc[0].startswith("B Eitam")
df["eitam_flag"] = mismatch

def bootstrap_ci(x, n=10000):
    x = np.asarray(x, dtype=float)
    means = [RNG.choice(x, size=len(x), replace=True).mean() for _ in range(n)]
    return np.percentile(means, [2.5, 97.5])

def summarize(g):
    d_r = g["ro"] - g["rr"]
    d_z = g["fiso"] - g["fisr"]
    lo, hi = bootstrap_ci(d_r)
    return pd.Series({
        "n": len(g),
        "mean_ro": g["ro"].mean(), "mean_rr": g["rr"].mean(),
        "mean_ro_minus_rr": d_r.mean(),
        "median_ro_minus_rr": d_r.median(),
        "ci95_mean_ro_minus_rr": f"[{lo:.3f}, {hi:.3f}]",
        "mean_fiso_minus_fisr": d_z.mean(),
        "median_fiso_minus_fisr": d_z.median(),
        "mean_rel_es": g["relative_es"].mean(),
        "median_rel_es": g["relative_es"].median(),
        "frac_ro_gt_rr": (g["ro"] > g["rr"]).mean(),
        "n_sign_flip": int((g["relative_es"] < 0).sum()),
        "wilcoxon_p_cor": stats.wilcoxon(d_r).pvalue,
        "wilcoxon_p_fz": stats.wilcoxon(d_z).pvalue,
    })

print("=" * 100)
print("PRIMARY LEVEL: discipline  (Social / Cognitive / Economics)")
print("=" * 100)
tab = df.groupby("discipline").apply(summarize, include_groups=False).round(4)
print(tab.to_string())

print("\nRanking by absolute inflation  mean(ro-rr)   :")
print(tab.sort_values("mean_ro_minus_rr", ascending=False)["mean_ro_minus_rr"].to_string())
print("Ranking by relative shrinkage 1-mean(rel_es) :")
print((1 - tab["mean_rel_es"]).sort_values(ascending=False).round(4).to_string())
print("Ranking by relative shrinkage 1-median(rel_es):")
print((1 - tab["median_rel_es"]).sort_values(ascending=False).round(4).to_string())

# scale-consistency check
print("\nScale consistency (correlation vs Fisher-z):")
print("  mean(ro-rr)   order:", list(tab.sort_values("mean_ro_minus_rr", ascending=False).index))
print("  mean(fiso-fisr) order:", list(tab.sort_values("mean_fiso_minus_fisr", ascending=False).index))
print("  median(ro-rr) order:", list(tab.sort_values("median_ro_minus_rr", ascending=False).index))
print("  median(fiso-fisr) order:", list(tab.sort_values("median_fiso_minus_fisr", ascending=False).index))

print("\n" + "=" * 100)
print("ROBUSTNESS LEVEL: project  (Psychology vs Experimental Economics)")
print("=" * 100)
tab_p = df.groupby("project.x").apply(summarize, include_groups=False).round(4)
print(tab_p.to_string())

print("\n" + "=" * 100)
print("SPECIAL ROW: Eitam et al. (Social) -- rr=+0.1049 but relative_es=-0.472")
print("=" * 100)
row = df[df["eitam_flag"]].iloc[0]
print(f"  study={row['study']!r}  ro={row['ro']:.4f}  rr={row['rr']:.4f}  "
      f"relative_es={row['relative_es']:.4f}")

# sensitivity: treat that rr as negative (i.e. replication went opposite direction)
df_alt = df.copy()
df_alt.loc[df_alt["eitam_flag"], "rr"] = -df_alt.loc[df_alt["eitam_flag"], "rr"]
df_alt.loc[df_alt["eitam_flag"], "fisr"] = np.arctanh(df_alt.loc[df_alt["eitam_flag"], "rr"])
soc = df_alt[df_alt["discipline"] == "Social"]
d_r = soc["ro"] - soc["rr"]
print(f"  If rr treated as -0.1049:  mean(ro-rr) {df[df['discipline']=='Social']['ro'].sub(df[df['discipline']=='Social']['rr']).mean():.4f} -> {d_r.mean():.4f} (increases)")
print(f"  median(ro-rr): {df[df['discipline']=='Social']['ro'].sub(df[df['discipline']=='Social']['rr']).median():.4f} -> {d_r.median():.4f}")
print(f"  frac ro>rr: {(df[df['discipline']=='Social']['ro']>df[df['discipline']=='Social']['rr']).mean():.3f} -> {(soc['ro']>soc['rr']).mean():.3f}")
print(f"  sign flips counted via relative_es unchanged (row already negative in relative_es): "
      f"{(df[df['discipline']=='Social']['relative_es']<0).sum()} -> {(soc['relative_es']<0).sum()}")
print(f"  mean(relative_es) unchanged: {df[df['discipline']=='Social']['relative_es'].mean():.4f} -> {soc['relative_es'].mean():.4f}")
print(f"  Wilcoxon p: {stats.wilcoxon(df[df['discipline']=='Social']['ro']-df[df['discipline']=='Social']['rr']).pvalue:.2e} -> {stats.wilcoxon(d_r).pvalue:.2e}")

print("\n" + "=" * 100)
print("ALL-DOMAINS CHECK: is original > replication in every domain?")
print("=" * 100)
for dom, g in df.groupby("discipline"):
    print(f"  {dom:12s} n={len(g):2d}  ro>rr in {(g['ro']>g['rr']).mean()*100:5.1f}% of studies  "
          f"median(relative_es)={g['relative_es'].median():.3f}  Wilcoxon p={stats.wilcoxon(g['ro']-g['rr']).pvalue:.2e}")

tab.to_csv("output/discipline_table.csv")
tab_p.to_csv("output/project_table.csv")
print("\nTables saved to output/discipline_table.csv, output/project_table.csv")
