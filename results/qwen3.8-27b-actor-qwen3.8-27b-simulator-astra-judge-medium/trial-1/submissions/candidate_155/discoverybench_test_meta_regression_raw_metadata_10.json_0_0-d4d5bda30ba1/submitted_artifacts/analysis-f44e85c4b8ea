import csv
from collections import Counter

PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
with open(PATH) as f:
    rows = list(csv.DictReader(f))

print("total rows:", len(rows))

# Filter: Psychology (project=='rpp') AND replicated studies (replicated=='1')
rpp = [r for r in rows if r['project'].strip() == 'rpp']
rep = [r for r in rpp if r['replicated'].strip() == '1']

print("rpp rows:", len(rpp))
print("rpp replicated==1 (denominator):", len(rep))

# Check for missing/empty seniority.r or replicated within the subset
missing_sen = sum(1 for r in rep if not r['seniority.r'].strip())
print("replicated rpp rows with empty seniority.r:", missing_sen)

# Junior professor definition (A): seniority.r == 'Assistant Professor'
junior = [r for r in rep if r['seniority.r'].strip() == 'Assistant Professor']
print("seniority.r distribution in subset:",
      dict(Counter(r['seniority.r'].strip() for r in rep)))
print("junior (Assistant Professor) count (numerator):", len(junior))

den = len(rep)
num = len(junior)
prop = num/den
print(f"proportion = {num}/{den} = {prop:.6f} ({prop*100:.2f}%)")
