"""
DiscoveryBench: In which domain did both original and replication studies
primarily use student subjects (original: 82.4%, replication: 80.9%)?

Main unit: study-level (one row per O/R-pair id):
  - ml1/ml3: the aggregated=True (pooled) row
  - rpp/ee : the single study row
Sensitivity: row-level (all 927 lab/single rows), and drop==False subsets.
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
TARGET = (82.4, 80.9)

df = pd.read_csv(CSV)
for c in ("subjects.o", "subjects.r", "discipline"):
    df[c] = df[c].astype("object").str.strip().str.lower()

def stu(v):
    """boolean 'is students'; NA -> False (counted in denominator)."""
    return v.eq("students").fillna(False)

def report(d, label):
    print(f"--- {label} ---")
    for disc, g in sorted(d.groupby("discipline")):
        o = stu(g["subjects.o"]); r = stu(g["subjects.r"])
        print(f"  {disc:12s} n={len(g):3d}  "
              f"o: {int(o.sum())}/{len(g)} = {100*o.mean():.1f}%   "
              f"r: {int(r.sum())}/{len(g)} = {100*r.mean():.1f}%")
    print()

# ---- study-level frame (one row per id) ----
agg = df[df["aggregated"] == True]                       # pooled rows for ml1/ml3
study = pd.concat([agg, df[~df["id"].isin(set(agg["id"]))]])
assert study["id"].is_unique, "study-level frame must have one row per id"

print(f"rows={len(df)}  unique ids={df['id'].nunique()}  study-level studies={len(study)}\n")

# MAIN scheme: study-level, missing counted as non-student (in denominator)
report(study, "MAIN: study-level, denominator incl. missing")
# missing excluded from denominator
print("--- study-level, denominator excl. missing ---")
for disc, g in sorted(study.groupby("discipline")):
    vo, vr = g["subjects.o"], g["subjects.r"]
    print(f"  {disc:12s} o: {int(stu(vo).sum())}/{int(vo.notna().sum())} = "
          f"{100*stu(vo).sum()/vo.notna().sum():.1f}%   r: {int(stu(vr).sum())}/{int(vr.notna().sum())} = "
          f"{100*stu(vr).sum()/vr.notna().sum():.1f}%")
print()

report(df, "SENSITIVITY: row-level (all 927 rows)")
report(df[df["drop"] == False], "SENSITIVITY: row-level, drop==False")
report(study[study["drop"] == False], "SENSITIVITY: study-level, drop==False")

# ---- domain selection under main scheme ----
print("=== Domain selection (main scheme, distance to 82.4/80.9) ===")
best, best_d = None, None
for disc, g in study.groupby("discipline"):
    o_p = 100*stu(g["subjects.o"]).mean(); r_p = 100*stu(g["subjects.r"]).mean()
    d2 = (o_p - TARGET[0])**2 + (r_p - TARGET[1])**2
    print(f"  {disc:12s} o={o_p:.1f}% r={r_p:.1f}%  dist={d2:.1f}  "
          f"primarily(>50% both)={o_p>50 and r_p>50}")
    if best is None or d2 < best_d:
        best, best_d = disc, d2
g = study[study["discipline"] == best]
print(f"\nSELECTED DOMAIN: {best.upper()}  "
      f"(o={100*stu(g['subjects.o']).mean():.1f}%, r={100*stu(g['subjects.r']).mean():.1f}%, n={len(g)} studies)")
