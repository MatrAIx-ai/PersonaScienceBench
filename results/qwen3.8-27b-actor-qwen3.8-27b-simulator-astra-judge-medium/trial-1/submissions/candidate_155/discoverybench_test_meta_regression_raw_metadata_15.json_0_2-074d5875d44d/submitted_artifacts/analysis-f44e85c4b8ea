"""
Question: What proportion of original studies in Experimental Economics were conducted in the United Kingdom?

Method:
- Load the study-level meta-regression dataset.
- Filter to project == 'ee' (Experimental Economics).
- Verify each row is a distinct original study (unique id / title / authors.o).
- Numerator: rows with experiment_country.o == 'United Kingdom' (strip guard).
- Denominator: all ee rows (== distinct original studies, verified no duplicates).
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

ee = df[df["project"] == "ee"].copy()
n_rows = len(ee)

# Distinctness verification
assert ee["id"].nunique() == n_rows, "duplicate ids found"
assert ee["title"].str.strip().str.lower().nunique() == n_rows, "duplicate titles found"
assert ee["authors.o"].str.strip().str.lower().nunique() == n_rows, "duplicate author lists found"

country = ee["experiment_country.o"].astype(str).str.strip()
missing = country.isna().sum() + (country == "").sum()
uk = (country == "United Kingdom").sum()

print(f"ee rows: {n_rows}")
print(f"distinct original studies (by id/title/authors): {ee['id'].nunique()}")
print(f"missing/blank experiment_country.o: {missing}")
print(f"country value counts:\n{country.value_counts().to_string()}")
print(f"United Kingdom rows: {uk} -> {sorted(ee[country == 'United Kingdom']['id'].tolist())}")
print(f"Proportion: {uk}/{n_rows} = {uk/n_rows:.4f} ({uk/n_rows*100:.1f}%)")
