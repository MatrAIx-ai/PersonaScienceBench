"""
Analysis: What proportion of studies in Experimental Economics were conducted in a lab setting?

Data source: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
Operative variable: online.o  (1 = online, 0 = not online -> lab)
"""
import pandas as pd

# Load the study-level dataset
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")

# Filter to the Experimental Economics project
ee = df[df["project"] == "ee"].copy()

print(f"Total rows in dataset: {len(df)}")
print(f"EE (Experimental Economics) rows: {len(ee)}")

# --- Verify online.o integrity ---
print(f"\nonline.o dtype: {ee['online.o'].dtype}")
print(f"online.o value counts (incl. NaN): {ee['online.o'].value_counts(dropna=False).to_dict()}")
print(f"online.o NaN count: {ee['online.o'].isna().sum()}")
assert ee["online.o"].isna().sum() == 0, "Unexpected NaN in online.o"
assert set(ee["online.o"].unique()) == {0.0}, f"Unexpected online.o values: {ee['online.o'].unique()}"

# --- Verify lab_id is not applicable ---
print(f"\nlab_id non-null count: {ee['lab_id'].notna().sum()} / {len(ee)}")
print(f"lab_id distinct non-null values: {ee['lab_id'].nunique()}")

# --- Compute the proportion ---
# online.o == 0  ->  not online  ->  lab setting
lab_count = int((ee["online.o"] == 0).sum())
total     = len(ee)
proportion = lab_count / total

print(f"\n--- Result ---")
print(f"Studies in lab setting (online.o == 0): {lab_count}")
print(f"Total EE studies:                        {total}")
print(f"Proportion conducted in a lab setting:   {lab_count}/{total} = {proportion:.4f} ({proportion*100:.1f}%)")

# --- Cross-check: second file has no setting indicator ---
df2 = pd.read_csv("data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv")
setting_cols = [c for c in df2.columns if any(k in c.lower() for k in ["online", "lab", "setting", "subject"])]
print(f"\nSecond file columns: {list(df2.columns)}")
print(f"Second file setting-indicator columns: {setting_cols if setting_cols else 'NONE'}")

# --- Cross-check: subjects.o is consistent with lab work ---
print(f"\nsubjects.o in EE: {ee['subjects.o'].value_counts().to_dict()}")
print(f"online.r in EE:    {ee['online.r'].value_counts().to_dict()}")

print("\nDone.")
