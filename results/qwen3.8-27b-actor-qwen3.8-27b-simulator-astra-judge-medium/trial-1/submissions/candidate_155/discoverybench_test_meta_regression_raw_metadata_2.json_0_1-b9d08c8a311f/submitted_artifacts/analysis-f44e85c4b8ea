"""
Final analysis: average length (pages) of original papers in
Experimental Economics (project == 'ee') vs Psychology (project == 'rpp').

Data source: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
- 'length' = number of pages of the original paper (only file containing it).
- Project mapping per schema: ee = Experimental Economics, rpp = Psychology
  (cross-validated against the second dataset, which lists 18 'Experimental Economics'
   rows matching the 18 'ee' rows here).
Filters:
- project in {ee, rpp}
- drop == False  (data-quality flag; 7 rpp rows flagged, incl. rpp.46 with n.o=230025)
Sensitivity: row-level vs duplicate-record dedup vs unique-title (paper-level).
"""
import pandas as pd
import numpy as np

F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
F2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(F1)
print("Total rows:", len(df))
print("Project counts:", df["project"].value_counts().to_dict())

# ---------- Main analysis ----------
sub = df[df["project"].isin(["ee", "rpp"]) & (df["drop"] == False)].copy()
print("Rows after filters (drop==False):", len(sub),
      "| dropped rpp rows:", int((df["project"] == "rpp").sum() - (sub["project"] == "rpp").sum()))

res = {}
for code, name in [("ee", "Experimental Economics"), ("rpp", "Psychology")]:
    g = sub[sub["project"] == code]["length"]
    res[code] = dict(n=len(g), mean=g.mean(), sd=g.std(ddof=1), median=g.median(),
                     min=g.min(), max=g.max())
    print(f"\n{name} (project={code}): n={len(g)} mean={g.mean():.4f} sd={g.std(ddof=1):.4f} "
          f"median={g.median():.1f} min={g.min()} max={g.max()}")

ratio = res["ee"]["mean"] / res["rpp"]["mean"]
print(f"\nRatio EE/Psychology mean length: {ratio:.3f}")

# ---------- Sensitivity checks (Psychology) ----------
rpp_all = df[df["project"] == "rpp"]
rpp_nd = rpp_all[rpp_all["drop"] == False]
sens = {
    "main (drop==False, row level, n=90)": rpp_nd["length"].mean(),
    "dedup exact duplicate rpp.149 (n=89)":
        rpp_nd.drop_duplicates(subset=["title", "n.o", "effect_size.o", "length"])["length"].mean(),
    "unique original papers by title (n=88)":
        rpp_nd.drop_duplicates("title")["length"].mean(),
    "no drop filter, all 97 rows": rpp_all["length"].mean(),
}
print("\nSensitivity - Psychology mean length:")
for k, v in sens.items():
    print(f"  {k}: {v:.4f}")

# Data-quality notes
print("\nlength missing:", df["length"].isna().sum(), "| zeros:", int((df["length"] == 0).sum()))
print("ee fully duplicated rows:", df[df["project"] == "ee"].duplicated().sum())
print("rpp fully duplicated rows:", df[df["project"] == "rpp"].duplicated().sum())

# Cross-validation with second file (naming / counts only; it has no 'length')
df2 = pd.read_csv(F2)
print("\nCross-check file 2 projects:", df2["project"].value_counts().to_dict(),
      "| has length col:", "length" in df2.columns)
