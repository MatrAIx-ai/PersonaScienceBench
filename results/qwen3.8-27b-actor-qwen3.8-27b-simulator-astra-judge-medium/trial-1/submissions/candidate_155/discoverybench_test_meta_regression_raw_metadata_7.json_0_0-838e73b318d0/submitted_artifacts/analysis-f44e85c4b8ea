"""
Analysis: In which domain do the majority of authors tend to be male
for both original and replication studies?

Dataset: meta-regression_study_data_heterogeneity_in_replication_projects.csv
"""
import pandas as pd
import numpy as np

# Load data
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
print(f"Loaded dataset: {len(df)} rows x {len(df.columns)} columns")

# --- Step 1: Check drop column ---
print("\n" + "="*60)
print("STEP 1: Check 'drop' column")
print("="*60)
print(f"  drop=True:  {df['drop'].sum()} rows")
print(f"  drop=False: {(df['drop']==False).sum()} rows")
print(f"  Dropped rows by discipline: {df[df['drop']==True]['discipline'].value_counts().to_dict()}")

# Filter out dropped rows
df_clean = df[df['drop'] == False].copy()
print(f"  Working dataset (drop==False): {len(df_clean)} rows")

# --- Step 2: Discipline distribution ---
print("\n" + "="*60)
print("STEP 2: Discipline distribution (after filtering)")
print("="*60)
for d in sorted(df_clean['discipline'].unique()):
    n = (df_clean['discipline'] == d).sum()
    print(f"  {d:12s}: {n} rows ({n/len(df_clean)*100:.1f}%)")

# --- Step 3: Main analysis - strict > 0.5 ---
print("\n" + "="*60)
print("STEP 3: Strict threshold (authors_male.o > 0.5 AND authors_male.r > 0.5)")
print("="*60)
mask_strict = (df_clean["authors_male.o"] > 0.5) & (df_clean["authors_male.r"] > 0.5)
for d in sorted(df_clean['discipline'].unique()):
    sub = df_clean[df_clean['discipline'] == d]
    count = mask_strict[sub.index].sum()
    total = len(sub)
    print(f"  {d:12s}: {count:4d} / {total:4d}  ({count/total*100:.1f}%)")
print(f"  {'TOTAL':12s}: {mask_strict.sum():4d} / {len(df_clean):4d}  ({mask_strict.sum()/len(df_clean)*100:.1f}%)")

# --- Step 4: Mean and median ---
print("\n" + "="*60)
print("STEP 4: Mean and median of male author ratios by discipline")
print("="*60)
for d in sorted(df_clean['discipline'].unique()):
    sub = df_clean[df_clean['discipline'] == d]
    print(f"  {d:12s}:")
    print(f"    authors_male.o : mean={sub['authors_male.o'].mean():.4f}, median={sub['authors_male.o'].median():.4f}")
    print(f"    authors_male.r : mean={sub['authors_male.r'].mean():.4f}, median={sub['authors_male.r'].median():.4f}")

# --- Step 5: Sensitivity check - >= 0.5 ---
print("\n" + "="*60)
print("STEP 5: Sensitivity check (authors_male.o >= 0.5 AND authors_male.r >= 0.5)")
print("="*60)
mask_loose = (df_clean["authors_male.o"] >= 0.5) & (df_clean["authors_male.r"] >= 0.5)
for d in sorted(df_clean['discipline'].unique()):
    sub = df_clean[df_clean['discipline'] == d]
    count = mask_loose[sub.index].sum()
    total = len(sub)
    print(f"  {d:12s}: {count:4d} / {total:4d}  ({count/total*100:.1f}%)")
print(f"  {'TOTAL':12s}: {mask_loose.sum():4d} / {len(df_clean):4d}  ({mask_loose.sum()/len(df_clean)*100:.1f}%)")

# Boundary rows
boundary = (df_clean["authors_male.o"] == 0.5) & (df_clean["authors_male.r"] == 0.5)
print(f"\n  Boundary rows (both exactly 0.5): {boundary.sum()}")
print(f"  By discipline: {df_clean[boundary]['discipline'].value_counts().to_dict()}")

# --- Step 6: Compare before/after drop filtering ---
print("\n" + "="*60)
print("STEP 6: Before vs After drop filtering (strict > 0.5)")
print("="*60)
mask_all = (df["authors_male.o"] > 0.5) & (df["authors_male.r"] > 0.5)
for d in sorted(df['discipline'].unique()):
    before = df[df['discipline'] == d]
    after = df_clean[df_clean['discipline'] == d]
    cb = mask_all[before.index].sum()
    ca = mask_strict[after.index].sum()
    print(f"  {d:12s}: before {cb}/{len(before)} ({cb/len(before)*100:.1f}%)  →  after {ca}/{len(after)} ({ca/len(after)*100:.1f}%)")

# --- Step 7: Final summary table ---
print("\n" + "="*60)
print("STEP 7: Final summary")
print("="*60)
rows = []
for d in sorted(df_clean['discipline'].unique()):
    sub = df_clean[df_clean['discipline'] == d]
    rows.append({
        "discipline": d,
        "n": len(sub),
        "count_strict": ((sub['authors_male.o']>0.5) & (sub['authors_male.r']>0.5)).sum(),
        "pct_strict": round(((sub['authors_male.o']>0.5) & (sub['authors_male.r']>0.5)).mean()*100, 1),
        "count_loose": ((sub['authors_male.o']>=0.5) & (sub['authors_male.r']>=0.5)).sum(),
        "pct_loose": round(((sub['authors_male.o']>=0.5) & (sub['authors_male.r']>=0.5)).mean()*100, 1),
        "mean_male_o": round(sub['authors_male.o'].mean(), 4),
        "mean_male_r": round(sub['authors_male.r'].mean(), 4),
        "median_male_o": sub['authors_male.o'].median(),
        "median_male_r": sub['authors_male.r'].median(),
    })
summary = pd.DataFrame(rows)
print(summary.to_string(index=False))

# --- Conclusion ---
print("\n" + "="*60)
print("CONCLUSION")
print("="*60)
print("""
Economics is the domain where the majority of authors are male for BOTH
original and replication studies, most prominently:

  - Highest proportion of studies with >50% male authors in both:
    55.6% strict (>0.5), 83.3% loose (>=0.5)
  - Highest mean male-author ratio:
    Original:  0.870 (median 1.0)
    Replication: 0.837 (median 1.0)
  - All 18 Economics studies come from the Experimental Economics (ee) project.

Cognitive science follows (41.1% strict, mean_o=0.773, mean_r=0.514),
and Social science has the lowest proportion (25.6% strict, mean_o=0.683,
mean_r=0.507) despite having the largest number of studies (n=550).

Note: Economics has a small sample (n=18), so the proportion estimate
has wider uncertainty. However, the effect is strong (median=1.0 for both),
and the conclusion is robust to the threshold choice (>0.5 vs >=0.5).
""")
