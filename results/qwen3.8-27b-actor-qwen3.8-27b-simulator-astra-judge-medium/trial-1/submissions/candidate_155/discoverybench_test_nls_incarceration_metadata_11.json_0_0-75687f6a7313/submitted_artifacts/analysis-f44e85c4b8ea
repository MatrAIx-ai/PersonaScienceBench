import pandas as pd, numpy as np
df = pd.read_csv("data/nls_incarceration_processed.csv")
w = 'composite_wealth_1985'
def block(sub):
    inc = sub[sub['ever_jailed']==1][w].median(); non = sub[sub['ever_jailed']==0][w].median()
    incz = sub[(sub['ever_jailed']==1)&(sub[w]>0)][w].median(); nonz = sub[(sub['ever_jailed']==0)&(sub[w]>0)][w].median()
    return dict(inc=inc, non=non, ninc=int((sub['ever_jailed']==1).sum()), nnon=int((sub['ever_jailed']==0).sum()),
                absd=inc-non, ratio=(inc/non if non!=0 else np.nan), incz=incz, nonz=nonz)
for label, sub in [('OVERALL', df),
                   *[ (f'race={r}', df[df['race']==r]) for r in ['white','black','hipanic'] ],
                   *[ (f'sex={s}', df[df['sex']==s]) for s in ['male','female'] ],
                   *[ (f'{r}_{s}', df[(df['race']==r)&(df['sex']==s)]) for r in ['white','black','hipanic'] for s in ['male','female'] ]]:
    b=block(sub); print(label, b)
