"""
Reproducible analysis: How does incarceration affect the wealth of black
individuals based on their (proxy) economic/wealth levels?

Data: data/nls_incarceration_processed.csv
  Columns: race, sex, ever_jailed, composite_wealth_1985/1990/1996
  - No income variable exists; composite_wealth_1985 (pre-incarceration-window
    baseline, 1985 < 1985-1994 window) is used as a proxy for income/economic level.
  - ever_jailed = 1 if jailed 1985-1994 (binary; no duration/timing).

Approach (descriptive, association not causation):
  1. Restrict to race == 'black'.
  2. Stratify by 1985 baseline wealth into tertiles (low/mid/high).
  3. Within each tier compare ever_jailed (1) vs not (0) on:
       - primary: d96 = wealth_1996 - wealth_1985  (post-window change)
       - aux:     d90 = wealth_1990 - wealth_1985  (mid-window change)
       - level:   wealth_1996
     Report n, mean and median for each group; sex as a simple control.
  4. Report gap = not-jailed minus jailed (descriptive shortfall).

Outputs: prints a report and writes results_summary.txt
"""
import pandas as pd
import numpy as np

DATA = "data/nls_incarceration_processed.csv"

def main():
    df = pd.read_csv(DATA)
    b = df[df["race"] == "black"].copy()

    # --- proxy for income/economic level: 1985 baseline wealth tertiles ---
    q33 = b["composite_wealth_1985"].quantile(1 / 3)   # = 0.0
    q67 = b["composite_wealth_1985"].quantile(2 / 3)   # = 3830.0
    b["tier"] = pd.cut(b["composite_wealth_1985"],
                       bins=[-np.inf, q33, q67, np.inf],
                       labels=["low", "mid", "high"])

    # --- wealth changes ---
    b["d96"] = b["composite_wealth_1996"] - b["composite_wealth_1985"]  # primary
    b["d90"] = b["composite_wealth_1990"] - b["composite_wealth_1985"]  # aux
    b["w96"] = b["composite_wealth_1996"]                              # level

    lines = []
    def p(s=""):
        lines.append(s)
        print(s)

    p("=" * 70)
    p("BLACK SAMPLE OVERVIEW")
    p("=" * 70)
    p(f"n_black = {len(b)}; ever_jailed = {int(b.ever_jailed.sum())} "
      f"({b.ever_jailed.mean()*100:.1f}%); sex male% = {b.sex.eq('male').mean()*100:.1f}")
    p(f"1985 wealth tertile cutoffs: q33={q33:.0f}, q67={q67:.0f}")
    p("\nCross-tab (rows=tier, cols=ever_jailed):")
    p(pd.crosstab(b["tier"], b["ever_jailed"], margins=True).to_string())
    p("\n1985 wealth range per tier:")
    p(b.groupby("tier")["composite_wealth_1985"].agg(["min", "max", "count"]).to_string())

    # --- cell viability check (jail sub-cell < 15 -> would merge) ---
    jailed_by_tier = b.groupby("tier")["ever_jailed"].sum()
    thin = jailed_by_tier[jailed_by_tier < 15]
    p(f"\nJailed sub-cell sizes by tier: {jailed_by_tier.to_dict()}"
      f" -> {'THIN (merge to 2 tiers)' if len(thin) else 'all >= 15, keep 3 tiers'}")

    p("\n" + "=" * 70)
    p("JAILED vs NOT-JAILED WITHIN EACH 1985-WEALTH TIER (descriptive)")
    p("gap = not-jailed minus jailed  (positive gap = jailed group lags)")
    p("=" * 70)
    for t, g in b.groupby("tier"):
        p(f"\n--- tier={t}  (1985 wealth {g['composite_wealth_1985'].min()}..{g['composite_wealth_1985'].max()}) ---")
        row = {}
        for j, gg in g.groupby("ever_jailed"):
            row[j] = gg
            p(f"  jailed={j}: n={len(gg):4d} | "
              f"d96 mean={gg.d96.mean():10.1f} med={gg.d96.median():9.1f} | "
              f"d90 mean={gg.d90.mean():10.1f} | "
              f"w96 mean={gg.w96.mean():10.1f} med={gg.w96.median():9.1f} | "
              f"male%={gg.sex.eq('male').mean()*100:3.0f} | "
              f"1985w mean={gg['composite_wealth_1985'].mean():9.1f}")
        nj, jl = row[0], row[1]
        p(f"  GAP (not-jailed - jailed): d96={nj.d96.mean()-jl.d96.mean():10.1f}  "
          f"d90={nj.d90.mean()-jl.d90.mean():10.1f}  w96={nj.w96.mean()-jl.w96.mean():10.1f}")

    p("\n" + "=" * 70)
    p("OVERALL BLACK (all tiers) Jailed vs Not-Jailed")
    p("=" * 70)
    nj = b[b.ever_jailed == 0]; jl = b[b.ever_jailed == 1]
    p(f"not-jailed: n={len(nj):4d} d96 mean={nj.d96.mean():.1f} med={nj.d96.median():.1f} "
      f"w96 mean={nj.w96.mean():.1f} male%={nj.sex.eq('male').mean()*100:.0f} 1985w={nj['composite_wealth_1985'].mean():.1f}")
    p(f"jailed:     n={len(jl):4d} d96 mean={jl.d96.mean():.1f} med={jl.d96.median():.1f} "
      f"w96 mean={jl.w96.mean():.1f} male%={jl.sex.eq('male').mean()*100:.0f} 1985w={jl['composite_wealth_1985'].mean():.1f}")
    p(f"gap d96 = {nj.d96.mean()-jl.d96.mean():.1f}")

    p("\n" + "=" * 70)
    p("KEY ASSUMPTIONS & LIMITATIONS (disclosed)")
    p("=" * 70)
    p("- No income variable in data; 1985 baseline WEALTH used as proxy for income/economic level.")
    p("- Descriptive association, NOT causation; selection/confounding bias (jailed group is 90% male, lower 1985 wealth).")
    p("- ever_jailed is binary (jailed 1985-1994), no duration/timing; 1990 is mid-window, 1996 post-window.")
    p("- Only sex available as a simple control; no other covariates.")
    p("- Small jailed cells (n=76/39/44); low power; composite wealth has zeros/negatives, right-skewed, not inflation-adjusted.")

    with open("results_summary.txt", "w") as f:
        f.write("\n".join(lines) + "\n")
    print("\nWrote results_summary.txt")

if __name__ == "__main__":
    main()
