"""
Analysis: Largest increases in median wealth among black females
Dataset: NLSY79 processed data (data/nls_incarceration_processed.csv)
Question: Between which years did the largest increases in median wealth occur among black females?
"""
import pandas as pd
import numpy as np

# (1) Load data
df = pd.read_csv("data/nls_incarceration_processed.csv")
print(f"Total rows loaded: {len(df)}")
print(f"Columns: {df.columns.tolist()}")

# (2) Filter to black females
bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
print(f"\nBlack-female subgroup size: {len(bf)}")

# (3) Compute median of each composite_wealth variable
wealth_cols = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
medians = {}
for col in wealth_cols:
    medians[col] = bf[col].median()
    print(f"Median {col}: {medians[col]:,.0f}")

m1985 = medians["composite_wealth_1985"]
m1990 = medians["composite_wealth_1990"]
m1996 = medians["composite_wealth_1996"]

# (4) Compute absolute and relative increases for each interval
# Interval 1: 1985 -> 1990
abs_inc_1 = m1990 - m1985
rel_inc_1 = (m1990 - m1985) / m1985 if m1985 != 0 else float("inf")

# Interval 2: 1990 -> 1996
abs_inc_2 = m1996 - m1990
rel_inc_2 = (m1996 - m1990) / m1990 if m1990 != 0 else float("inf")

print(f"\n=== Interval Comparisons ===")
print(f"1985 → 1990: absolute increase = {abs_inc_1:,.0f} | relative increase = {rel_inc_1:.4f} ({rel_inc_1*100:.1f}%)")
print(f"1990 → 1996: absolute increase = {abs_inc_2:,.0f} | relative increase = {rel_inc_2:.4f} ({rel_inc_2*100:.1f}%)")

# (5) Identify the interval with the largest increase
if abs_inc_1 >= abs_inc_2:
    largest_interval = "1985–1990"
    largest_abs = abs_inc_1
    largest_rel = rel_inc_1
else:
    largest_interval = "1990–1996"
    largest_abs = abs_inc_2
    largest_rel = rel_inc_2

print(f"\n=== RESULT ===")
print(f"Largest increase in median wealth among black females occurred between: {largest_interval}")
print(f"  Absolute increase:  {largest_abs:,.0f}")
print(f"  Relative increase:  {largest_rel*100:.1f}%")

# Also check if both criteria agree
criteria_agree = (abs_inc_1 >= abs_inc_2) == (rel_inc_1 >= rel_inc_2)
print(f"  Absolute and relative criteria agree: {criteria_agree}")

# Save summary
print("\n=== SUMMARY TABLE ===")
summary = pd.DataFrame({
    "Interval": ["1985→1990", "1990→1996"],
    "Median_start": [m1985, m1990],
    "Median_end": [m1990, m1996],
    "Absolute_increase": [abs_inc_1, abs_inc_2],
    "Relative_increase_pct": [rel_inc_1*100, rel_inc_2*100]
})
print(summary.to_string(index=False))
