"""
Analysis: Wealth Inequality Changes for White Males and Females (1990 → 1996)
Data: NLSY79 cohort - nls_incarceration_processed.csv
"""
import pandas as pd
import numpy as np
import json

# ============================================================
# 1. Load data
# ============================================================
df = pd.read_csv('data/nls_incarceration_processed.csv')
print(f"Total observations: {len(df)}")
print(f"Columns: {list(df.columns)}")
print(f"Missing values:\n{df.isnull().sum()}\n")

# ============================================================
# 2. Define subgroups
# ============================================================
white_male = df[(df['race'] == 'white') & (df['sex'] == 'male')]
white_female = df[(df['race'] == 'white') & (df['sex'] == 'female')]
print(f"White male: n = {len(white_male)}")
print(f"White female: n = {len(white_female)}\n")

# ============================================================
# 3. Inequality metrics
# ============================================================
def gini(x):
    """Gini coefficient (works with negative and zero values)."""
    x = np.sort(x)
    n = len(x)
    if np.sum(x) == 0:
        return np.nan
    index = np.arange(1, n + 1)
    return (2 * np.sum(index * x) - (n + 1) * np.sum(x)) / (n * np.sum(x))

def compute_metrics(s, label):
    s = s.dropna()
    n = len(s)
    n_zero = int((s == 0).sum())
    n_neg = int((s < 0).sum())
    n_pos = int((s > 0).sum())
    mean_val = s.mean()
    median_val = s.median()
    std_val = s.std()
    p10 = s.quantile(0.10)
    p25 = s.quantile(0.25)
    p75 = s.quantile(0.75)
    p90 = s.quantile(0.90)
    # P90/median (P90/P25 undefined since P25=0 in this data)
    p90_over_median = p90 / median_val if median_val != 0 else np.inf
    gini_full = gini(s.values)
    s_pos = s[s > 0]
    gini_pos = gini(s_pos.values) if len(s_pos) > 1 else np.nan
    return {
        'label': label, 'n': n, 'n_zero': n_zero, 'pct_zero': n_zero/n*100,
        'n_neg': n_neg, 'pct_neg': n_neg/n*100, 'n_pos': n_pos,
        'mean': mean_val, 'median': median_val, 'std': std_val,
        'p10': p10, 'p25': p25, 'p75': p75, 'p90': p90,
        'p90_over_median': p90_over_median,
        'gini_full': gini_full, 'gini_positive': gini_pos,
    }

def gini_trimmed(s, trim_pct=0.01, positive_only=False):
    """Gini after trimming top X% extreme values (sensitivity check)."""
    s = s.dropna()
    if positive_only:
        s = s[s > 0]
    if len(s) < 10:
        return np.nan, 0
    threshold = s.quantile(1 - trim_pct)
    s_trimmed = s[s <= threshold]
    return gini(s_trimmed.values), len(s_trimmed)

# ============================================================
# 4. Compute for each subgroup × year
# ============================================================
results = {}
for sex, sub in [('male', white_male), ('female', white_female)]:
    results[sex] = {}
    for year in ['1990', '1996']:
        col = f'composite_wealth_{year}'
        results[sex][year] = compute_metrics(sub[col], f'white_{sex}_{year}')

# ============================================================
# 5. Sensitivity: trim top 1%
# ============================================================
sensitivity = {}
for sex, sub in [('male', white_male), ('female', white_female)]:
    sensitivity[sex] = {}
    for year in ['1990', '1996']:
        col = f'composite_wealth_{year}'
        s = sub[col]
        g_full_trim, n_ft = gini_trimmed(s, 0.01, positive_only=False)
        g_pos_trim, n_pt = gini_trimmed(s, 0.01, positive_only=True)
        sensitivity[sex][year] = {
            'gini_full_trimmed': g_full_trim, 'n_full_trimmed': n_ft,
            'gini_positive_trimmed': g_pos_trim, 'n_positive_trimmed': n_pt,
        }

# ============================================================
# 6. Print results
# ============================================================
print("\n" + "="*70)
print("MAIN RESULTS")
print("="*70)

for sex in ['male', 'female']:
    m90 = results[sex]['1990']
    m96 = results[sex]['1996']
    print(f"\n--- WHITE {sex.upper()} (n={m90['n']}) ---")
    for key in ['pct_zero', 'pct_neg', 'mean', 'median', 'std',
                'p75', 'p90', 'p90_over_median', 'gini_full', 'gini_positive']:
        v90, v96 = m90[key], m96[key]
        chg = v96 - v90
        chg_pct = chg / abs(v90) * 100 if v90 != 0 else 0
        print(f"  {key:<22} 1990={v90:>12.4f}  1996={v96:>12.4f}  Δ={chg:>+12.4f} ({chg_pct:+.2f}%)")

print("\n" + "="*70)
print("SENSITIVITY: Gini after trimming top 1%")
print("="*70)
for sex in ['male', 'female']:
    for year in ['1990', '1996']:
        d = sensitivity[sex][year]
        print(f"White {sex} {year}: Gini(full,trim)={d['gini_full_trimmed']:.4f}, "
              f"Gini(pos,trim)={d['gini_positive_trimmed']:.4f}")

print("\n" + "="*70)
print("GENDER COMPARISON")
print("="*70)
print(f"{'Metric':<22} {'WM Δ%':>10} {'WF Δ%':>10}  {'Same Dir?'}")
print("-" * 58)
for label, key in [('Gini (full)', 'gini_full'), ('Gini (positive)', 'gini_positive'),
                   ('P90/Median', 'p90_over_median'), ('Std Dev', 'std'),
                   ('Mean', 'mean'), ('Median', 'median'), ('% zero', 'pct_zero')]:
    wm_chg_pct = (results['male']['1996'][key] - results['male']['1990'][key]) / abs(results['male']['1990'][key]) * 100
    wf_chg_pct = (results['female']['1996'][key] - results['female']['1990'][key]) / abs(results['female']['1990'][key]) * 100
    same = "Yes" if ((results['male']['1996'][key]-results['male']['1990'][key]) > 0) == \
                     ((results['female']['1996'][key]-results['female']['1990'][key]) > 0) else "No"
    print(f"{label:<22} {wm_chg_pct:>+9.2f}% {wf_chg_pct:>+9.2f}%  {same}")

# ============================================================
# 7. Save results
# ============================================================
output = {
    'white_male': {'1990': results['male']['1990'], '1996': results['male']['1996']},
    'white_female': {'1990': results['female']['1990'], '1996': results['female']['1996']},
    'sensitivity_top1pct': sensitivity,
}
with open('analysis_results.json', 'w') as f:
    json.dump(output, f, indent=2, default=str)
print("\n\nResults saved to analysis_results.json")
