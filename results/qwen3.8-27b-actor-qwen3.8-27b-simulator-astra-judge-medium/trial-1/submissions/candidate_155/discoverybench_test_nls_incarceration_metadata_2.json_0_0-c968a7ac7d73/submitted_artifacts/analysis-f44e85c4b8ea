"""
Main analysis: wealth comparison by ever_jailed (criminal-record proxy) across 1985, 1990, 1996.
Primary: Mann-Whitney U (two-sided) per year, BH-FDR at q=0.05 decision rule.
Sensitivity: Welch t-test, Bonferroni, stratification by race and sex.
"""
import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv('data/nls_incarceration_processed.csv')
df['race'] = df['race'].replace({'hipanic': 'hispanic'})

YEARS = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
LABELS = ['1985', '1990', '1996']

def rank_biserial(u, n1, n2):
    # Vargha-Delaney style rank-biserial r = 1 - 2U/(n1*n2)
    return 1 - 2 * u / (n1 * n2)

rows = []
for y, lab in zip(YEARS, LABELS):
    a = df.loc[df['ever_jailed'] == 1, y].to_numpy()
    b = df.loc[df['ever_jailed'] == 0, y].to_numpy()
    u, p_mwu = stats.mannwhitneyu(a, b, alternative='two-sided', method='exact' if len(a)*len(b) < 1e6 else 'asymptotic')
    t, p_welch = stats.ttest_ind(a, b, equal_var=False)
    rows.append({
        'year': lab,
        'n_jailed': len(a), 'n_not': len(b),
        'mean_jailed': a.mean(), 'mean_not': b.mean(),
        'median_jailed': np.median(a), 'median_not': np.median(b),
        'median_diff': np.median(a) - np.median(b),
        'mwu_U': u, 'mwu_p': p_mwu,
        'rank_biserial_r': rank_biserial(u, len(a), len(b)),
        'welch_t': t, 'welch_p': p_welch,
    })

res = pd.DataFrame(rows)

# Multiple-testing corrections across the 3 years (on MWU p-values)
pvals = res['mwu_p'].to_numpy()
order = np.argsort(pvals)
m = len(pvals)
bh_adj = np.empty(m)
for rank_idx, idx in enumerate(order, start=1):
    bh_adj[idx] = pvals[idx] * m / rank_idx
bh_adj = np.minimum.accumulate(bh_adj[::-1][::-1])  # enforce monotonicity (step-up)
# proper BH: sort ascending, adj_i = min(p_i * m / i) with cumulative min from top
sorted_p = np.sort(pvals)
bh_sorted = np.minimum.accumulate(sorted_p * m / np.arange(1, m+1))[::-1]
bh_adj = np.empty(m)
bh_adj[order] = bh_sorted
bonf_adj = np.minimum(pvals * m, 1.0)

res['bh_fdr_adj_p'] = bh_adj
res['bonferroni_adj_p'] = bonf_adj
res['sig_BH_fdr_005'] = res['bh_fdr_adj_p'] < 0.05
res['sig_Bonferroni_005'] = res['bonferroni_adj_p'] < 0.05

pd.set_option('display.width', 250)
print("=== PRIMARY RESULTS (full sample) ===")
print(res.to_string(index=False, float_format=lambda x: f'{x:,.6g}'))

sig_years = res.loc[res['sig_BH_fdr_005'], 'year'].tolist()
print("\nSignificant at BH-FDR q=0.05:", sig_years)
print("Significant at Bonferroni alpha=0.05:", res.loc[res['sig_Bonferroni_005'], 'year'].tolist())

# Stratified sensitivity: by race and by sex
def strat_strata(col):
    out = []
    for val in sorted(df[col].unique()):
        sub = df[df[col] == val]
        for y, lab in zip(YEARS, LABELS):
            a = sub.loc[sub['ever_jailed'] == 1, y].to_numpy()
            b = sub.loc[sub['ever_jailed'] == 0, y].to_numpy()
            if len(a) < 10:
                out.append({'stratum': f'{col}={val}', 'year': lab, 'n_jailed': len(a),
                            'mwu_p': np.nan, 'note': 'n_jailed<10, skipped'})
                continue
            u, p = stats.mannwhitneyu(a, b, alternative='two-sided')
            out.append({'stratum': f'{col}={val}', 'year': lab, 'n_jailed': len(a), 'n_not': len(b),
                        'median_jailed': np.median(a), 'median_not': np.median(b),
                        'mwu_p': p, 'sig_raw_005': p < 0.05})
    return pd.DataFrame(out)

print("\n=== SENSITIVITY: by race (raw p, no correction within strata) ===")
print(strat_strata('race').to_string(index=False, float_format=lambda x: f'{x:,.4g}'))
print("\n=== SENSITIVITY: by sex ===")
print(strat_strata('sex').to_string(index=False, float_format=lambda x: f'{x:,.4g}'))

res.to_csv('analysis/results_primary.csv', index=False)
print("\nSaved analysis/results_primary.csv")
