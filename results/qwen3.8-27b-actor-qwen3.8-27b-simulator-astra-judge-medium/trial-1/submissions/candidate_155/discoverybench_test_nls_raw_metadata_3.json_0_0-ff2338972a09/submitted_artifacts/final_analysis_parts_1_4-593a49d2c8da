import pandas as pd, numpy as np
import statsmodels.api as sm
from scipy import stats
import warnings
warnings.filterwarnings('ignore')
np.random.seed(42)

df = pd.read_csv('data/nls_raw.csv')
res_cols=[c for c in df.columns if c.startswith('Type of residence')]
dorm=pd.Series(False,index=df.index)
for c in res_cols: dorm = dorm | (df[c]==3)
df['dorm']=dorm.astype(int)
asv_cols=['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
          'ASVAB - Word Knowledge Z Score (rounded), 1981',
          'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
          'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
for c in asv_cols: df[c+'_z']=(df[c]-df[c].mean())/df[c].std()
df['asvab_comp']=df[[c+'_z' for c in asv_cols]].mean(axis=1)
df['income79']=df['Total net family income, previous calendar year, 1979']
df['wealth85']=df['Family net wealth, 1985']
df['mom_ed']=df["Highest grade completed by respondent's mother, 1979"]
df['dad_ed']=df["Highest grade completed by respondent's father, 1979"]
df['parent_ed']=np.maximum(df['mom_ed'],df['dad_ed'])
df['grade79']=df['Highest grade completed, 1979']
df['age79']=df['Age of respondent, 1979']; df['famsize']=df['Family size, 1979']
df['sex_f']=(df['Sex of respondent, 1979']==2).astype(int)
df['race']=df['Racial/ethnic cohort, 1979']
df['Black']=(df['race']==1).astype(int); df['Hispanic']=(df['race']==2).astype(int)
df['Minority']=(df['race']<3).astype(int); df['sample_id']=df['Sample ID, 1979 (interview)']
def log1p_winsor(s,lo=0.01,hi=0.99):
    s=s.copy();a=s.quantile(lo);b=s.quantile(hi);return np.log1p(s.clip(a,b))
def winsor(s,lo=0.01,hi=0.99):
    s=s.copy();a=s.quantile(lo);b=s.quantile(hi);return s.clip(a,b)
def zfull(col):
    s=df[col];m=s.mean();sd=s.std();return (s-m)/sd
df['inc_l']=log1p_winsor(df['income79']); df['wea_w']=winsor(df['wealth85'])
df['inc_z']=zfull('inc_l'); df['wea_z']=zfull('wea_w'); df['pared_z']=zfull('parent_ed')
df['SES_main']=(df['inc_z']+df['pared_z'])/2.0
df['SES_full']=(df['inc_z']+df['wea_z']+df['pared_z'])/3.0
df['asvab_z']=zfull('asvab_comp')
CTL=['sex_f','age79','famsize']; RACE3=['Black','Hispanic']

def run_reg(model,y,xvars,data,robust=True):
    X=data[xvars].copy(); X=sm.add_constant(X); yv=data[y]
    fit=getattr(sm,model)(yv,X).fit(disp=0)
    names=list(fit.params.index)
    if robust:
        if model=='OLS':
            r=fit.get_robustcov_results(cov_type='HC1')
            bse=pd.Series(np.asarray(r.bse),index=names); p=pd.Series(np.asarray(r.pvalues),index=names)
        else:
            b=np.asarray(fit.params); resid=np.asarray(yv)-np.asarray(fit.fittedvalues)
            XtXinv=np.linalg.inv(X.values.T.dot(X.values))
            Vrob=XtXinv.dot(X.values.T.dot((resid**2)[:,None]*X.values)).dot(XtXinv)
            bse=pd.Series(np.sqrt(np.diag(Vrob)),index=names)
            p=pd.Series(2*(1-stats.norm.cdf(np.abs(b/np.sqrt(np.diag(Vrob))))),index=names)
    else:
        bse=fit.bse; p=fit.pvalues
    rsq=getattr(fit,'rsquared',getattr(fit,'prsquared',np.nan))
    return dict(names=names,params=fit.params,bse=bse,p=p,rsq=rsq,n=len(data))
def coef(m,v): return m['params'][v],m['bse'][v],m['p'][v]
def att(cA,cB): return 1.0-cB/cA if cA!=0 else np.nan

core=['grade79','dorm','asvab_z','SES_main','inc_z','pared_z','Black','Hispanic','Minority']
cc=df.dropna(subset=core+CTL).copy()
R=[]
def P(s=""): R.append(s)

P("="*74); P("NLSY79: How academic characteristics alter SES & race effects on"); P("education attainment (BA completion proxy). Complete-case primary, N=%d"%len(cc)); P("="*74)

P("\n### PART 1 — Model A vs B, PRIMARY outcome = grade1979 (OLS, robust HC1)")
mA=run_reg('OLS','grade79',['SES_main']+RACE3+CTL,cc)
mB=run_reg('OLS','grade79',['SES_main']+RACE3+['asvab_z']+CTL,cc)
P("Model A R2=%.3f | Model B R2=%.3f"%(mA['rsq'],mB['rsq']))
P("%-9s | A coef/SE/p          | B coef/SE/p          | attenu."%"var")
for v in ['SES_main']+RACE3:
    cA,bA,pA=coef(mA,v);cB,bB,pB=coef(mB,v)
    P("%-9s | %+.3f/%.3f p=%.3f   | %+.3f/%.3f p=%.3f   | %+.1f%%"%(v,cA,bA,pA,cB,bB,pB,100*att(cA,cB)))
P("asvab_z(Model B): %+.3f p=%.4f"%(coef(mB,'asvab_z')[0],coef(mB,'asvab_z')[2]))

P("\n### PART 1b — Model A vs B, CROSS-VALIDATION outcome = ever-in-college-dorm (Logit, robust HC0)")
la=run_reg('Logit','dorm',['SES_main']+RACE3+CTL,cc)
lb=run_reg('Logit','dorm',['SES_main']+RACE3+['asvab_z']+CTL,cc)
P("%-9s | A logit/OR/p        | B logit/OR/p        | attenu."%"var")
for v in ['SES_main']+RACE3:
    cA,bA,pA=coef(la,v);cB,bB,pB=coef(lb,v)
    P("%-9s | %+.3f/%.2f p=%.3f   | %+.3f/%.2f p=%.3f   | %+.1f%%"%(v,cA,np.exp(cA),pA,cB,np.exp(cB),pB,100*att(cA,cB)))
P("asvab_z(Model B): logit %+.3f OR=%.2f p=%.4f"%(coef(lb,'asvab_z')[0],np.exp(coef(lb,'asvab_z')[0]),coef(lb,'asvab_z')[2]))

P("\n### PART 2 — Causal mediation (bootstrap 2000), Y=grade1979, M=asvab_z")
P("   (each X holds the OTHER race groups + SES + demographics constant)")
def mediation(Xcol,base,data,y='grade79',M='asvab_z',B=2000,seed=1):
    rng=np.random.RandomState(seed); n=len(data)
    ind=np.zeros(B);prop=np.zeros(B);direct=np.zeros(B);total=np.zeros(B)
    for b in range(B):
        s=data.iloc[rng.choice(n,n,replace=True)]
        try:
            at=run_reg('OLS',M,[Xcol]+base,s,robust=False)['params'][Xcol]
            r=run_reg('OLS',y,[Xcol,M]+base,s,robust=False); bt=r['params'][M]; cprime=r['params'][Xcol]
            c0=run_reg('OLS',y,[Xcol]+base,s,robust=False)['params'][Xcol]
        except Exception: continue
        ind[b]=at*bt;direct[b]=cprime;total[b]=c0;prop[b]=ind[b]/c0 if abs(c0)>1e-9 else 0
    return dict(indirect=np.mean(ind),direct=np.mean(direct),total=np.mean(total),prop=np.mean(prop),
        ind_ci=(np.percentile(ind,2.5),np.percentile(ind,97.5)),
        prop_ci=(np.percentile(prop,2.5),np.percentile(prop,97.5)),
        dir_ci=(np.percentile(direct,2.5),np.percentile(direct,97.5)))
med_specs={'SES_main':['Black','Hispanic']+CTL,'Black':['SES_main','Hispanic']+CTL,'Hispanic':['SES_main','Black']+CTL}
for Xcol,base in med_specs.items():
    r=mediation(Xcol,base,cc)
    sig="sig." if not (r['ind_ci'][0]<0<r['ind_ci'][1]) else "NS (CI x 0)"
    P("\nX=%s"%Xcol)
    P("  total=%+.4f  direct=%+.4f CI[%.4f,%.4f]"%(r['total'],r['direct'],r['dir_ci'][0],r['dir_ci'][1]))
    P("  indirect=%+.4f CI[%.4f,%.4f] -> %s"%(r['indirect'],r['ind_ci'][0],r['ind_ci'][1],sig))
    P("  mediation proportion=%+.3f CI[%.3f,%.3f]"%(r['prop'],r['prop_ci'][0],r['prop_ci'][1]))

P("\n### PART 3 — Interaction (moderation) terms, Y=grade1979, Model B + X*asvab")
cc2=cc.copy()
cc2['SES_asv']=cc2['SES_main']*cc2['asvab_z']; cc2['Black_asv']=cc2['Black']*cc2['asvab_z']; cc2['Hispanic_asv']=cc2['Hispanic']*cc2['asvab_z']
mi=run_reg('OLS','grade79',['SES_main']+RACE3+['asvab_z','SES_asv','Black_asv','Hispanic_asv']+CTL,cc2)
for v in ['SES_asv','Black_asv','Hispanic_asv']:
    c,b,p=coef(mi,v); P("  %-13s %+.4f SE=%.4f p=%.4f  %s"%(v,c,b,p,"(moderation)" if p<0.05 else "(ns)"))

P("\n### PART 4a — Robustness: BINARY race (Minority vs non-minority), Y=grade1979")
a4=run_reg('OLS','grade79',['SES_main','Minority']+CTL,cc); b4=run_reg('OLS','grade79',['SES_main','Minority','asvab_z']+CTL,cc)
for v in ['SES_main','Minority']:
    cA,bA,pA=coef(a4,v);cB,bB,pB=coef(b4,v); P("  %-9s A %+.3f p=%.3f -> B %+.3f p=%.3f | att %+.1f%%"%(v,cA,pA,cB,pB,100*att(cA,cB)))
P("\n### PART 4b — Robustness: SINGLE-COMPONENT SES, Y=grade1979")
for lbl,sesvar in [("income only",'inc_z'),("parent-ed only",'pared_z'),("wealth only 1985",'wea_z'),("full SES(inc+wealth+pared)",'SES_full')]:
    xvars=[sesvar]+RACE3+CTL
    sub=cc.dropna(subset=[sesvar,'asvab_z','grade79'])
    A=run_reg('OLS','grade79',xvars,sub); B=run_reg('OLS','grade79',xvars+['asvab_z'],sub)
    cA,bA,pA=coef(A,sesvar); cB,bB,pB=coef(B,sesvar)
    P("  %-28s SES A %+.3f p=%.3f -> B %+.3f p=%.3f | att %+.1f%%  (n=%d)"%(lbl,cA,pA,cB,pB,100*att(cA,cB),len(sub)))
P("\n### PART 4c — Robustness: binary race on DORM outcome (Logit)")
a4c=run_reg('Logit','dorm',['SES_main','Minority']+CTL,cc); b4c=run_reg('Logit','dorm',['SES_main','Minority','asvab_z']+CTL,cc)
for v in ['SES_main','Minority']:
    cA,bA,pA=coef(a4c,v);cB,bB,pB=coef(b4c,v); P("  %-9s A logit %+.3f OR%.2f p=%.3f -> B %+.3f OR%.2f p=%.3f | att %+.1f%%"%(v,cA,np.exp(cA),pA,cB,np.exp(cB),pB,100*att(cA,cB)))

open('results.txt','w').write("\n".join(R))
print("\n".join(R))
