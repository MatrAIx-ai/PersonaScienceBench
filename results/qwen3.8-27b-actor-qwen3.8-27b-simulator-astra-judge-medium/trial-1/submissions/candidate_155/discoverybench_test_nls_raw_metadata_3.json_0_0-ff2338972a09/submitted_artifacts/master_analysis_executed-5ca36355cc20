def run_reg(model,y,xvars,data,robust=True):
    X=data[xvars].copy(); X=sm.add_constant(X); yv=data[y]
    fit=getattr(sm,model)(yv,X).fit(disp=0)
    names=list(fit.params.index)
    if robust:
        if model=='OLS':
            r=fit.get_robustcov_results(cov_type='HC1')
            bse=pd.Series(np.asarray(r.bse),index=names); p=pd.Series(np.asarray(r.pvalues),index=names)
        else:
            b=np.asarray(fit.params); resid=np.asarray(yv)-np.asarray(fit.fittedvalues)
            XtXinv=np.linalg.inv(X.values.T.dot(X.values))
            Vrob=XtXinv.dot(X.values.T.dot((resid**2)[:,None]*X.values)).dot(XtXinv)
            bse=pd.Series(np.sqrt(np.diag(Vrob)),index=names)
            p=pd.Series(2*(1-stats.norm.cdf(np.abs(b/np.sqrt(np.diag(Vrob))))),index=names)
    else:
        bse=fit.bse; p=fit.pvalues
    rsq=getattr(fit,'rsquared',getattr(fit,'prsquared',np.nan))
    return dict(names=names,params=fit.params,bse=bse,p=p,rsq=rsq,n=len(data))
