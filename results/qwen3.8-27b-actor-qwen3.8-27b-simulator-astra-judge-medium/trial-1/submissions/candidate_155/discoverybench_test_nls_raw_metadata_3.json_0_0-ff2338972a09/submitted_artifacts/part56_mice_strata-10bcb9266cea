fb_fit=sm.OLS(ccs['grade79'],ex_b).fit()
fb=fb_fit.get_robustcov_results(cov_type='HC1')
namesb=list(ex_b.columns); fb.params=fb_fit.params
pa=pd.Series(np.asarray(fa.pvalues),index=names); pb=pd.Series(np.asarray(fb.pvalues),index=namesb)
ba=pd.Series(np.asarray(fa.bse),index=names); bb=pd.Series(np.asarray(fb.bse),index=namesb)
P("%-9s | A(fe) coef/p       | B(fe) coef/p       | attenu."%"var")
for v in ['SES_main']+RACE3:
    cA=fa.params[v];pA=pa[v];cB=fb.params[v];pB=pb[v]
    P("%-9s | %+.3f p=%.3f   | %+.3f p=%.3f   | %+.1f%%"%(v,cA,pA,cB,pB,100*(1-cB/cA)))

