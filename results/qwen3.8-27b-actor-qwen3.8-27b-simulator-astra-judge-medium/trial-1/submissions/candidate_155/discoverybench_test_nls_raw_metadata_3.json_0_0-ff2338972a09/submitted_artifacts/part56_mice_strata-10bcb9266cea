np.random.seed(42)

df = pd.read_csv('data/nls_raw.csv')
res_cols=[c for c in df.columns if c.startswith('Type of residence')]
dorm=pd.Series(False,index=df.index)
for c in res_cols: dorm = dorm | (df[c]==3)
df['dorm']=dorm.astype(int)
asv_cols=['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
          'ASVAB - Word Knowledge Z Score (rounded), 1981',
          'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
          'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
for c in asv_cols: df[c+'_z']=(df[c]-df[c].mean())/df[c].std()
df['asvab_comp']=df[[c+'_z' for c in asv_cols]].mean(axis=1)
df['income79']=df['Total net family income, previous calendar year, 1979']
df['wealth85']=df['Family net wealth, 1985']
df['mom_ed']=df["Highest grade completed by respondent's mother, 1979"]
df['dad_ed']=df["Highest grade completed by respondent's father, 1979"]
df['parent_ed']=np.maximum(df['mom_ed'],df['dad_ed'])
df['grade79']=df['Highest grade completed, 1979']
df['age79']=df['Age of respondent, 1979']; df['famsize']=df['Family size, 1979']
df['sex_f']=(df['Sex of respondent, 1979']==2).astype(int)
df['race']=df['Racial/ethnic cohort, 1979']
df['Black']=(df['race']==1).astype(int); df['Hispanic']=(df['race']==2).astype(int)
df['sample_id']=df['Sample ID, 1979 (interview)']
def log1p_winsor(s,lo=0.01,hi=0.99):
    s=s.copy();a=s.quantile(lo);b=s.quantile(hi);return np.log1p(s.clip(a,b))
def winsor(s,lo=0.01,hi=0.99):
    s=s.copy();a=s.quantile(lo);b=s.quantile(hi);return s.clip(a,b)
# full-data anchors (from original, non-missing)
inc_l_full=log1p_winsor(df['income79'])
wea_w_full=winsor(df['wealth85'])
def zfull(s):
    m=s.mean();sd=s.std();return (s-m)/sd
INCm,INCsd=inc_l_full.mean(),inc_l_full.std()
WEAm,WEAsd=wea_w_full.mean(),wea_w_full.std()
PEm,PEsd=df['parent_ed'].mean(),df['parent_ed'].std()
ACm,ACsd=df['asvab_comp'].mean(),df['asvab_comp'].std()

CTL=['sex_f','age79','famsize']; RACE3=['Black','Hispanic']
def run_reg(model,y,xvars,data,robust=True):
    X=data[xvars].copy(); X=sm.add_constant(X); yv=data[y]
    fit=getattr(sm,model)(yv,X).fit(disp=0)
    names=list(fit.params.index)
    if robust and model=='OLS':
        r=fit.get_robustcov_results(cov_type='HC1')
        bse=pd.Series(np.asarray(r.bse),index=names); p=pd.Series(np.asarray(r.pvalues),index=names)
    else:
        bse=fit.bse; p=fit.pvalues
    return dict(names=names,params=fit.params,bse=bse,p=p,n=len(data))
def coef(m,v): return m['params'][v],m['bse'][v],m['p'][v]

# ---- MICE on raw targets ----
targets=['income79','wealth85','mom_ed','dad_ed',asv_cols[0],asv_cols[1],asv_cols[2],asv_cols[3],'grade79']
obs_pred=['age79','sex_f','famsize','Black','Hispanic']
def mice_impute(base, m=20, burnin=10, niter=20, seed=42):
    rng=np.random.RandomState(seed); imps=[]
    for k in range(m):
        d=base.copy()
        for t in targets: d.loc[d[t].isna(),t]=d[t].mean()
        for it in range(burnin+niter):
            for t in targets:
                pred=[x for x in (targets+obs_pred) if x!=t]
                mask=d[t].notna()
                X=d.loc[mask,pred].dropna(); y=d.loc[mask,t].dropna()
                idx=X.index.intersection(y.index); X=X.loc[idx]; y=y.loc[idx]
                if len(X)<50: continue
                try:
                    mf=sm.OLS(y,sm.add_constant(X)).fit()
                    pred_all=sm.add_constant(d[pred])
                    d.loc[d[t].isna(),t]=pred_all.loc[d[t].isna()].predict(mf)
                except Exception: pass
        imps.append(d)
    return imps

base=df[['income79','wealth85','mom_ed','dad_ed']+asv_cols+['grade79','age79','sex_f','famsize','Black','Hispanic']].copy()
print("Running MICE m=20 ...")
imps=mice_impute(base, m=20, burnin=10, niter=20, seed=42)

def build(d):
    d=d.copy()
    for c in asv_cols: d[c+'_z']=(d[c]-d[c].mean())/d[c].std()
    d['asvab_comp']=d[[c+'_z' for c in asv_cols]].mean(axis=1)
    d['parent_ed']=np.maximum(d['mom_ed'],d['dad_ed'])
    d['inc_l']=np.log1p(d['income79'].clip(0,None)); 
    # recompute transformed using full anchors for comparability
    d['inc_z']=(np.log1p(d['income79'])-INCm)/INCsd
    d['wea_z']=(d['wealth85']-WEAm)/WEAsd
    d['pared_z']=(d['parent_ed']-PEm)/PEsd
    d['SES_main']=(d['inc_z']+d['pared_z'])/2.0
    d['asvab_z']=(d['asvab_comp']-ACm)/ACsd
    d['dorm']=dorm.reindex(d.index).fillna(0).astype(int)
    return d

# complete-case reference (from full df)
core=['grade79','asvab_z','SES_main','inc_z','pared_z','Black','Hispanic']
cc=df.copy()
cc['inc_z']=zfull(inc_l_full); cc['wea_z']=zfull(wea_w_full); cc['pared_z']=zfull(df['parent_ed'])
cc['SES_main']=(cc['inc_z']+cc['pared_z'])/2.0
cc['asvab_z']=zfull(df['asvab_comp'])
cc=cc.dropna(subset=core+CTL)
mA=run_reg('OLS','grade79',['SES_main']+RACE3+CTL,cc)
mB=run_reg('OLS','grade79',['SES_main']+RACE3+['asvab_z']+CTL,cc)
R=[]
def P(s=""): R.append(s)
P("="*74); P("### PART 5 — Multiple Imputation (MICE, m=20, OLS chained eqs) sensitivity"); P("="*74)
P("Complete-case reference (n=%d):"%(len(cc)))
for v in ['SES_main']+RACE3:
    cA,bA,pA=coef(mA,v);cB,bB,pB=coef(mB,v)
    P("  %-9s A %+.3f -> B %+.3f  (att %+.1f%%)"%(v,cA,cB,100*(1-cB/cA)))

def rubin(q,u,m):
    qbar=np.mean(q); Ubar=np.mean(u); B=np.var(q,ddof=1)
    T=Ubar+(1+1/m)*B; se=np.sqrt(T)
    return qbar,se,1.96*se   # normal approx on pooled total SE (m=20)
qA={v:[] for v in ['SES_main']+RACE3}; uA={v:[] for v in qA}
qB={v:[] for v in qA}; uB={v:[] for v in qA}
for d in imps:
    dd=build(d)
    A=run_reg('OLS','grade79',['SES_main']+RACE3+CTL,dd)
    B=run_reg('OLS','grade79',['SES_main']+RACE3+['asvab_z']+CTL,dd)
    for v in ['SES_main']+RACE3:
        cA,bA,pA=coef(A,v); qA[v].append(cA); uA[v].append(bA**2)
        cB,bB,pB=coef(B,v); qB[v].append(cB); uB[v].append(bB**2)
P("\nMICE pooled (Rubin's rules, m=20):")
P("%-9s | A pooled [CI]        | B pooled [CI]        | attenu(pooled)"%"var")
for v in ['SES_main']+RACE3:
    qAb,sAb,hAb=rubin(np.array(qA[v]),np.array(uA[v]),20)
    qBb,sBb,hBb=rubin(np.array(qB[v]),np.array(uB[v]),20)
    P("%-9s | %+.3f [%.3f,%.3f]   | %+.3f [%.3f,%.3f]   | %+.1f%%"%(v,qAb,qAb-hAb,qAb+hAb,qBb,qBb-hBb,qBb+hBb,100*(1-qBb/qAb)))

# ---- PART 6 stratum (Sample ID fixed effects) ----
P("\n"+"="*74); P("### PART 6 — Stratum sensitivity: Sample-ID (20 strata) fixed effects, Y=grade1979"); P("="*74)
