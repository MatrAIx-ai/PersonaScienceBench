import pandas as pd, numpy as np
from scipy import stats

df = pd.read_csv('data/nls_raw.csv')
N = len(df)
RACE="Racial/ethnic cohort, 1979"
GRADE="Highest grade completed, 1979"
INC="Total net family income, previous calendar year, 1979"
MOM="Highest grade completed by respondent's mother, 1979"
FATH="Highest grade completed by respondent's father, 1979"
W85="Family net wealth, 1985"; W90="Family net wealth, 1990"; W96="Family net wealth, 1996 (key data point)"

# ---- Build variables ----
g = pd.to_numeric(df[GRADE], errors='coerce')
g[g>30] = np.nan                      # 95 sentinel -> missing
df['grade'] = g
df['BA']   = (g>=16).astype(float)    # main BA proxy (baseline grade>=16)
df['HS']   = (g>=12).astype(float)    # sensitivity: high school completion
df['COL']  = (g>=13).astype(float)    # sensitivity: some college+
df['race'] = pd.to_numeric(df[RACE], errors='coerce')
df['inc']  = pd.to_numeric(df[INC],  errors='coerce')
df['momg'] = pd.to_numeric(df[MOM],  errors='coerce')
df['fathg']= pd.to_numeric(df[FATH], errors='coerce')

race_name = {1:'Black',2:'Hispanic',3:'NonBlackNonHisp'}

out=[]
def P(*a):
    s=" ".join(str(x) for x in a); out.append(s); print(s)

P("="*70); P("NLSY79 nls_raw.csv — BA completion (proxy) vs SES, Black vs others"); P("="*70)
P(f"Total N = {N}")
P("\nNOTE: The only education variable is 'Highest grade completed, 1979' — a BASELINE (1979) highest-grade measure, NOT a later degree-completion outcome. BA proxy = grade>=16 (16 = BA-equivalent).")

# ---- Overall race counts ----
P("\n--- (3) Racial/ethnic cohort, 1979 ---")
vc = df['race'].value_counts().sort_index()
for k,v in vc.items():
    P(f"  {race_name[int(k)]:<16} n={int(v)} ({v/N*100:.1f}%), missing race={df['race'].isna().sum()} total")

# ---- SES: 1979 income terciles (computed on non-missing income) ----
q1 = df['inc'].quantile(1/3); q2 = df['inc'].quantile(2/3)
def terc(x):
    if pd.isna(x): return np.nan
    if x<=q1: return 1
    if x<=q2: return 2
    return 3
df['inc_terc']=df['inc'].map(terc)
P("\n--- (2) SES primary window: 1979 family income terciles ---")
P(f"  income tercile cutpoints: T1<={q1:.0f}, T2 in ({q1:.0f},{q2:.0f}], T3>{q2:.0f}")
P(f"  income non-missing overall: {df['inc'].notna().sum()} ({df['inc'].notna().mean()*100:.1f}%)")

# ---- Complete-case definition for main analysis ----
# complete = race in {1,3} (Black vs ref), grade not nan, income not nan
cc = df['race'].isin([1,3]) & df['grade'].notna() & df['inc'].notna()
P("\n--- (3) Complete-case sample-size change (before -> after) by race x income tercile ---")
P("  (main analysis population = Black(1) & NonBlackNonHisp(3); complete = grade & income non-missing)")
before = df['race'].isin([1,3])
tab = df[before].groupby(['race','inc_terc']).size().unstack(fill_value=0)
tab_cc = df[cc].groupby(['race','inc_terc']).size().unstack(fill_value=0)
P("  before (race x tercile):")
P(tab.reindex([1,3]).to_string())
P("  after complete-case (race x tercile):")
P(tab_cc.reindex([1,3]).to_string())

# ---- binomial CI (Wilson) ----
def wilson(k,n,z=1.96):
    if n==0: return (np.nan,np.nan)
    p=k/n
    den=1+z*z/n
    c=p+z*z/(2*n)
    m=z*np.sqrt(p*(1-p)/n+z*z/(4*n*n))
    return ((c-m)/den,(c+m)/den)

def rate(sub,col):
    n=len(sub); k=int(sub[col].sum()) if n else 0
    return k,n,(k/n if n else np.nan)

def compare(out, sub_black, sub_ref, col, label):
    kb,nb,rb = rate(sub_black,col)
    kr,nr,rr = rate(sub_ref,col)
    lo_b,hi_b = wilson(kb,nb); lo_r,hi_r = wilson(kr,nr)
    diff = (rb-rr) if (nb and nr) else np.nan
    ratio = (rb/rr) if (nr and rr>0) else np.nan
    P(f"    {label}: Black {kb}/{nb}={rb*100:.2f}%[{lo_b*100:.2f},{hi_b*100:.2f}]  |  ref {kr}/{nr}={rr*100:.2f}%[{lo_r*100:.2f},{hi_r*100:.2f}]  |  diff={diff*100:+.2f}pp  ratio={ratio:.3f}" if nr and rr>0 else
      f"    {label}: Black {kb}/{nb}={rb*100:.2f}%  |  ref {kr}/{nr}={rr*100:.2f}%  (ref=0, ratio n/a)  diff={diff*100:+.2f}pp")

P("\n--- (1) MAIN: BA proxy (grade>=16) by income tercile, Black vs NonBlackNonHisp (complete-case) ---")
P("    (descriptive; binomial Wilson 95% CI; interaction regression unreliable at n>=16=37)")
rows=[]
for t in [1,2,3]:
    sb = df[cc & (df['race']==1) & (df['inc_terc']==t)]
    sr = df[cc & (df['race']==3) & (df['inc_terc']==t)]
    compare(out, sb, sr, 'BA', f"T{t}")
    rows.append([t,len(sb),int(sb['BA'].sum()),len(sr),int(sr['BA'].sum())])
P("\n  (cell sample sizes: tercile, nBlack, kBlack, nRef, kRef)")
for r in rows: P("    "+str(r))

P("\n--- Overall (all income) BA>=16, Black vs ref ---")
compare(out, df[cc&(df['race']==1)], df[cc&(df['race']==3)], 'BA','ALL')

P("\n--- SENSITIVITY: HS completion (grade>=12) by income tercile ---")
for t in [1,2,3]:
    compare(out, df[cc&(df['race']==1)&(df['inc_terc']==t)], df[cc&(df['race']==3)&(df['inc_terc']==t)], 'HS', f"T{t}")
compare(out, df[cc&(df['race']==1)], df[cc&(df['race']==3)], 'HS','ALL')

P("\n--- SENSITIVITY: some college+ (grade>=13) by income tercile ---")
for t in [1,2,3]:
    compare(out, df[cc&(df['race']==1)&(df['inc_terc']==t)], df[cc&(df['race']==3)&(df['inc_terc']==t)], 'COL', f"T{t}")
compare(out, df[cc&(df['race']==1)], df[cc&(df['race']==3)], 'COL','ALL')

# ---- Secondary: logistic interaction (reference only) ----
P("\n--- SECONDARY (reference only): logistic HS(>=12) ~ Black*inc_terc, complete-case ---")
try:
    import statsmodels.api as sm
    d2 = df[cc].copy()
    d2['blk']=(d2['race']==1).astype(int)
    d2['t2']=(d2['inc_terc']==2).astype(int)
    d2['t3']=(d2['inc_terc']==3).astype(int)
    d2['b_t2']=d2['blk']*d2['t2']; d2['b_t3']=d2['blk']*d2['t3']
    X=sm.add_constant(d2[['blk','t2','t3','b_t2','b_t3']])
    m=sm.Logit(d2['HS'],X).fit(disp=0)
    P("  coeffs: "+", ".join(f"{c}={v:.3f}" for c,v in m.params.items()))
    P("  p-values: "+", ".join(f"{c}={p:.3f}" for c,p in m.pvalues.items()))
except Exception as e:
    P("  logistic not available: "+str(e))

# ---- Sensitivity: wealth windows (report valid n per cell esp Black) ----
P("\n--- SENSITIVITY: SES via family net wealth terciles (valid n per race cell) ---")
for wc in [W85,W90,W96]:
    w=pd.to_numeric(df[wc],errors='coerce')
    wq1=w.quantile(1/3); wq2=w.quantile(2/3)
    wt=w.map(lambda x: np.nan if pd.isna(x) else (1 if x<=wq1 else (2 if x<=wq2 else 3)))
    P(f"\n  {wc}  (non-missing {w.notna().sum()}, {w.notna().mean()*100:.1f}%)")
    for t in [1,2,3]:
        sb=df[(df['race']==1)&(wt==t)&(g.notna())]; sr=df[(df['race']==3)&(wt==t)&(g.notna())]
        P(f"    T{t}: nBlack={len(sb)} (BA>=16: {int(sb['BA'].sum())}), nRef={len(sr)} (BA>=16: {int(sr['BA'].sum())})")

# ---- Sensitivity: parent-education SES ----
P("\n--- SENSITIVITY: SES via mean parent grade terciles ---")
par=(df['momg'].fillna(df['fathg'])+df['fathg'].fillna(df['momg']))/2
pq1=par.quantile(1/3);pq2=par.quantile(2/3)
pt=par.map(lambda x: np.nan if pd.isna(x) else (1 if x<=pq1 else (2 if x<=pq2 else 3)))
for t in [1,2,3]:
    sb=df[cc&(df['race']==1)&(pt==t)]; sr=df[cc&(df['race']==3)&(pt==t)]
    P(f"    T{t}: HS(>=12) Black {int(sb['HS'].sum())}/{len(sb)} vs ref {int(sr['HS'].sum())}/{len(sr)}")

with open('analysis_output.txt','w') as f:
    f.write("\n".join(out))
print("\nSaved analysis_output.txt")
