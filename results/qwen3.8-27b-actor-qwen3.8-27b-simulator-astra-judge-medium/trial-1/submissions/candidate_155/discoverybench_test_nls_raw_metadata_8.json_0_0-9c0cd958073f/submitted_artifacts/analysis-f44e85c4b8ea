"""
NLSY79 - Median family net wealth by racial/ethnic cohort, 1985/1990/1996.

Method (approved plan):
- Cohort: "Racial/ethnic cohort, 1979" (1=Black, 2=Hispanic, 3=Non-Black Non-Hispanic).
- For each wave and cohort: unweighted median of family net wealth among respondents
  with non-missing wealth at that wave (listwise deletion).
- Negative (net-debt) values and top-coded tail values are RETAINED.
- n per cell reported; overall all-race wave medians for context.
"""
import pandas as pd

df = pd.read_csv('data/nls_raw.csv')
RACE = 'Racial/ethnic cohort, 1979'
WEALTH = {
    '1985': 'Family net wealth, 1985',
    '1990': 'Family net wealth, 1990',
    '1996': 'Family net wealth, 1996 (key data point)',
}
LABELS = {1: 'Black (1)', 2: 'Hispanic (2)', 3: 'Non-Black Non-Hispanic (3)'}
BASE = df[RACE].value_counts()  # 1979 cohort sizes

rows = []
for wave, col in WEALTH.items():
    s = pd.to_numeric(df[col], errors='coerce')
    rows.append({
        'Wave': wave, 'Cohort': 'ALL races',
        'n': int(s.notna().sum()),
        'median': s.median(),
        'n_negative': int((s < 0).sum()),
        'n_at_cap': int((s == s.max()).sum()),
        'retention_pct_of_1979': round(100 * s.notna().sum() / len(df), 1),
    })
    for code in (1, 2, 3):
        sub = s[df[RACE] == code]
        rows.append({
            'Wave': wave, 'Cohort': LABELS[code],
            'n': int(sub.notna().sum()),
            'median': sub.median(),
            'n_negative': int((sub < 0).sum()),
            'n_at_cap': int((sub == sub.max()).sum()),
            'retention_pct_of_1979': round(100 * sub.notna().sum() / BASE[code], 1),
        })

res = pd.DataFrame(rows)
pd.set_option('display.width', 200)
print(res.to_string(index=False))
res.to_csv('analysis/median_wealth_by_race_results.csv', index=False)

# Median gap of code 3 vs codes 1 and 2 (ratio and difference), per wave
print("\nGap summary (code3 - codeX, and code3/codeX ratio):")
for wave in WEALTH:
    m = {c: res[(res.Wave == wave) & (res.Cohort == LABELS[c])]['median'].iloc[0] for c in (1, 2, 3)}
    print(f"{wave}: 3={m[3]:,.0f} | vs Black: diff={m[3]-m[1]:+,.0f}, ratio={m[3]/m[1]:.2f}x" if m[1] else "",
          end='  ')
    print(f"| vs Hispanic: diff={m[3]-m[2]:+,.0f}, ratio={m[3]/m[2]:.2f}x")
