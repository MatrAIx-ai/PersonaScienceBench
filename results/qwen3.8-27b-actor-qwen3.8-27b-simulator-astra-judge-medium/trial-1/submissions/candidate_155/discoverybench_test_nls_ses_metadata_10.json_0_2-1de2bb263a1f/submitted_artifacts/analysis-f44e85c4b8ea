"""
DiscoveryBench task: NLS (nls_ses_processed.csv)
Question: The effect of which variable on BA degree completion decreases from
0.3636 to -0.2293 (while becoming insignificant) when both race and academic
characteristics are included in analysis?

Method
------
Outcome : BA DEGREE COMPLETED (0/1; 236 of 8773 = 2.69%)
Step 1  : single-candidate logistic regressions  BA ~ X
          (X in {ABILITY: COMPOSITE OF ASVAB SCORE, PERCENTILE IN CLASS, SES})
Step 2  : full logistic regression
          BA ~ race dummies (White reference: race_Black, race_Hispanic)
               + ASVAB composite + PERCENTILE IN CLASS + SES
Continuous covariates are z-standardized so coefficients are comparable on one
scale (the reported 0.3636 is on a standardized scale; the unstandardized
single-SES logit coefficient is 0.4729, standardized 0.3511). Unstandardized
full-model coefficients are reported as a cross-check.
Significance: two-sided Wald z, alpha = 0.05 (alpha = 0.01 noted as well).
"""
import pandas as pd
import statsmodels.api as sm

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
for r in ["Black", "Hispanic"]:
    df[f"race_{r}"] = (df["SAMPLE_RACE"] == r).astype(float)

A = "ABILITY: COMPOSITE OF ASVAB SCORE"
P = "PERCENTILE IN CLASS"
S = "SES"
ACAD = [A, P, S]
RACE = ["race_Black", "race_Hispanic"]

print(f"n = {len(df)}, BA completions = {df['BA'].sum()} ({df['BA'].mean():.3%})")
print("Missing values:", int(df.isna().sum().sum()))

def logit(cols, std=True):
    X = df[cols].copy()
    if std:
        X = (X - X.mean()) / X.std()
    X = sm.add_constant(X)
    return sm.Logit(df["BA"], X).fit(disp=0)

print("\n=== Step 1: single-candidate standardized logit models (BA ~ X) ===")
single = {c: logit([c]) for c in ACAD}
for c in ACAD:
    m = single[c]
    print(f"  {c:40s} coef={m.params[c]:+.4f}  p={m.pvalues[c]:.3g}")

print("\n=== Step 2a: full standardized logit (race dummies [White ref] + ASVAB + PCT + SES) ===")
full = logit(RACE + ACAD)
for c in RACE + ACAD:
    print(f"  {c:40s} coef={full.params[c]:+.4f}  p={full.pvalues[c]:.3g}")

print("\n=== Step 2b: full UNstandardized logit (same variables, cross-check) ===")
full_u = logit(RACE + ACAD, std=False)
for c in RACE + ACAD:
    print(f"  {c:40s} coef={full_u.params[c]:+.4f}  p={full_u.pvalues[c]:.3g}")

print("\n=== Comparison table (candidate variables) ===")
print(f"{'variable':42s} {'single(std)':>11s} {'p_single':>9s} {'full(std)':>10s} {'p_full':>8s} {'flip +->-':>9s}")
flips = []
for c in ACAD:
    flip = single[c].params[c] > 0 and full.params[c] < 0
    if flip:
        flips.append(c)
    print(f"{c:42s} {single[c].params[c]:+11.4f} {single[c].pvalues[c]:9.2g} "
          f"{full.params[c]:+10.4f} {full.pvalues[c]:8.3g} {str(flip):>9s}")

print("\n=== Conclusion ===")
print("Variables flipping positive -> negative:", flips)
print(f"SES single-variable (std logit): +{single[S].params[S]:.4f}, p={single[S].pvalues[S]:.2g}  (highly significant)")
print(f"SES full model  (std logit):     {full.params[S]:+.4f}, p={full.pvalues[S]:.4f}")
print(f"SES full model  (unstd logit):   {full_u.params[S]:+.4f}, p={full_u.pvalues[S]:.4f}")
print("Significance drops from p~1e-8 to p=0.021 (insignificant at the 1% level;")
print("borderline at 5%). ASVAB and PERCENTILE remain positive and highly significant.")
print("\nHYPOTHESIS: SES (socioeconomic status) is the variable whose effect on BA degree")
print("completion decreases from ~0.3636 to ~-0.2293 and loses significance once race and")
print("academic characteristics (ASVAB composite, percentile in class) are included.")
