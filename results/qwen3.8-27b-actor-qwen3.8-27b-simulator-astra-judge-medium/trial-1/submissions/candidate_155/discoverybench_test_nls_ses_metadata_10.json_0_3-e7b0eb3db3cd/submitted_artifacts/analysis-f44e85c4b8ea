import pandas as pd, numpy as np
import statsmodels.api as sm
import warnings
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_ses_processed.csv')
y = df['BA DEGREE COMPLETED'].astype(int)
SES = df['SES'].values
AB = df['ABILITY: COMPOSITE OF ASVAB SCORE'].values
PC = df['PERCENTILE IN CLASS'].values
n = len(df)
print("n =", n, " base rate =", round(y.mean(),4), " successes =", int(y.sum()))

def fit(X_df, label):
    """X_df: df of predictors already encoded. Fit Logit, return table rows for each predictor."""
    X = sm.add_constant(X_df)
    res = sm.Logit(y, X).fit(disp=0)
    rows=[]
    for c in X_df.columns:
        b=res.params[c]; se=res.bse[c]; p=res.pvalues[c]
        rows.append((label, c, b, se, p))
    return res, rows

# standardized versions of continuous controls
SESz=(SES-SES.mean())/SES.std(ddof=1)
ABz=(AB-AB.mean())/AB.std(ddof=1)
PCz=(PC-PC.mean())/PC.std(ddof=1)

print("\n================= CORRELATIONS / MEAN DIFFS (candidate vs blocks) =================")
# continuous candidate: family size
fs = df['FAMILY SIZE OF SAMPLE']
print("\nFAMILY SIZE (continuous): Pearson r with blocks")
for nm,v in [('SES',SES),('ABILITY',AB),('PERCENTILE',PC)]:
    print(f"  r(FAMILY SIZE,{nm}) = {np.corrcoef(fs.values,v)[0,1]:.4f}")
print("  corr(FAMILY SIZE, BA) = ", round(np.corrcoef(fs.values,y.values)[0,1],4))

# categorical: mean of blocks across categories
for col in ['SAMPLE_RACE','SAMPLE_SEX']:
    grp = df.groupby(col)
    print(f"\n{col}: mean of blocks per category")
    for cat, g in grp:
        print(f"  {cat:9s} n={len(g):5d}  SES={g['SES'].mean():7.4f}  ABILITY={g['ABILITY: COMPOSITE OF ASVAB SCORE'].mean():8.2f}  PERCENTILE={g['PERCENTILE IN CLASS'].mean():7.3f}  BA_rate={g['BA DEGREE COMPLETED'].mean():.4f}")

print("\n================= COEFFICIENT TABLES =================")
def show(res, rows):
    print(f"{res.model.endog_name if hasattr(res.model,'endog_name') else 'model'}  (n={int(res.nobs)}, llf={res.llf:.2f}, converged={res.mle_retvals['converged']})")
    print(f"  {'predictor':22s} {'coef':>9s} {'se':>9s} {'p':>10s}")
    for lab,c,b,se,p in rows:
        print(f"  {c:22s} {b:9.4f} {se:9.4f} {p:10.4g}")

# ---- FAMILY SIZE (continuous) ----
print("\n### CANDIDATE: FAMILY SIZE OF SAMPLE (continuous) ###")
# unadjusted
x = pd.DataFrame({'FAMILY_SIZE':fs.values})
res,rows = fit(x,"unadj"); show(res,rows)
# adjusted raw scale
x = pd.DataFrame({'FAMILY_SIZE':fs.values,'SES':SES,'ABILITY':AB,'PERCENTILE':PC})
res,rows = fit(x,"adj"); show(res,rows)
# unadjusted standardized
x = pd.DataFrame({'FAMILY_SIZE_z':(fs.values-fs.mean())/fs.std(ddof=1)})
res,rows = fit(x,"unadj_z"); show(res,rows)
# adjusted standardized (all z)
x = pd.DataFrame({'FAMILY_SIZE_z':(fs.values-fs.mean())/fs.std(ddof=1),'SES_z':SESz,'ABILITY_z':ABz,'PERCENTILE_z':PCz})
res,rows = fit(x,"adj_z"); show(res,rows)

# ---- SAMPLE_SEX (Female ref) ----
print("\n### CANDIDATE: SAMPLE_SEX (Female reference) ###")
male = (df['SAMPLE_SEX']=='Male').astype(int)
x = pd.DataFrame({'MALE':male.values})
res,rows = fit(x,"unadj"); show(res,rows)
x = pd.DataFrame({'MALE':male.values,'SES':SES,'ABILITY':AB,'PERCENTILE':PC})
res,rows = fit(x,"adj"); show(res,rows)
x = pd.DataFrame({'MALE':male.values,'SES_z':SESz,'ABILITY_z':ABz,'PERCENTILE_z':PCz})
res,rows = fit(x,"adj_z"); show(res,rows)

# ---- SAMPLE_RACE (White reference) ----
print("\n### CANDIDATE: SAMPLE_RACE (White reference) ###")
black=(df['SAMPLE_RACE']=='Black').astype(int)
hisp=(df['SAMPLE_RACE']=='Hispanic').astype(int)
x = pd.DataFrame({'BLACK':black.values,'HISPANIC':hisp.values})
res,rows = fit(x,"unadj"); show(res,rows)
x = pd.DataFrame({'BLACK':black.values,'HISPANIC':hisp.values,'SES':SES,'ABILITY':AB,'PERCENTILE':PC})
res,rows = fit(x,"adj"); show(res,rows)
x = pd.DataFrame({'BLACK':black.values,'HISPANIC':hisp.values,'SES_z':SESz,'ABILITY_z':ABz,'PERCENTILE_z':PCz})
res,rows = fit(x,"adj_z"); show(res,rows)
