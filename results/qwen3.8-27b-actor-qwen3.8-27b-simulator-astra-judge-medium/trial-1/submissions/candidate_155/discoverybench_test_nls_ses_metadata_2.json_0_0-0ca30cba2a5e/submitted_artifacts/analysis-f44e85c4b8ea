"""
FINAL ANALYSIS
Question: Is the relation between socioeconomic status (SES) and chances of
BA-degree completion affected by racial lines?

Method
------
Outcome: BA DEGREE COMPLETED (binary, rare: 2.69%).
Primary test: logistic regression  deg ~ SES_z * race  (unadjusted), with race
dummy-coded (White reference). "Affected by racial lines" = SES x race
interaction: the marginal effect of SES on P(degree) differs by race.
Joint test of the two interaction terms (2-df Wald + likelihood-ratio).

Estimator note: Firth's penalized likelihood (intended primary) was attempted,
but its log-cos(eta/2) penalty is only defined for |eta|<pi; a 2.7% base rate
forces the intercept to ~ -3.6 (|eta|>pi), making the penalized likelihood
degenerate (flat). We therefore use the plain maximum-likelihood logistic
estimate (valid: SES is continuous, so there is no complete/quasi-separation)
as the PRIMARY, and a 5-fold-CV-tuned L2-regularized logistic fit as an
independent robustness cross-check.

Sensitivity: same interaction model + academic controls (ASVAB composite,
percentile in class), both z-standardized. Controls are a sensitivity check
only, to keep the core (unadjusted) answer un-muddied by attenuation.
"""
import numpy as np, pandas as pd
import statsmodels.api as sm
from scipy.optimize import minimize
from scipy.stats import chi2

# ---------------- data ----------------
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["deg"] = df["BA DEGREE COMPLETED"].astype(int)
df["SES_z"]    = (df["SES"] - df["SES"].mean()) / df["SES"].std()
df["ASVAB_z"]  = (df["ABILITY: COMPOSITE OF ASVAB SCORE"] - df["ABILITY: COMPOSITE OF ASVAB SCORE"].mean()) / df["ABILITY: COMPOSITE OF ASVAB SCORE"].std()
df["PCT_z"]    = (df["PERCENTILE IN CLASS"] - df["PERCENTILE IN CLASS"].mean()) / df["PERCENTILE IN CLASS"].std()
df["Black"]    = (df["SAMPLE_RACE"] == "Black").astype(int)
df["Hispanic"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)
y = df["deg"].values
n, K = len(df), int(df["deg"].sum())

print("="*70)
print(f"n={n}  degree completions={K}  base rate={K/n:.4f}")
print("="*70)

# ---------------- (1) base rates by race ----------------
print("\n[1] BASE RATES OF DEGREE COMPLETION BY RACE")
br = df.groupby("SAMPLE_RACE")["deg"].agg(["size","sum","mean"]).round(4)
br["rate%"] = (br["mean"]*100).round(2)
print(br)

# ---------------- (2) bivariate SES-degree association by race ----------------
print("\n[2] BIVARIATE point-biserial corr(SES, degree) BY RACE")
for r in ["White","Black","Hispanic"]:
    s = df[df["SAMPLE_RACE"]==r]
    print(f"  {r:9s} n={len(s):5d}  events={int(s['deg'].sum()):3d}  corr={s['SES'].corr(s['deg']):.4f}")
print(f"  {'Overall':9s} n={n:5d}  events={K:3d}  corr={df['SES'].corr(df['deg']):.4f}")

# ---------------- model helpers ----------------
def design(controls):
    X = pd.DataFrame(index=df.index)
    X["SES_z"]=df["SES_z"]; X["Black"]=df["Black"]; X["Hispanic"]=df["Hispanic"]
    X["SES_z:Black"]=df["SES_z"]*df["Black"]; X["SES_z:Hispanic"]=df["SES_z"]*df["Hispanic"]
    for c in controls: X[c]=df[c]
    return sm.add_constant(X)

def interaction_test(m, X, Xr, mr):
    B = m.params[["SES_z:Black","SES_z:Hispanic"]].values
    V = m.cov_params().loc[["SES_z:Black","SES_z:Hispanic"],["SES_z:Black","SES_z:Hispanic"]].values
    wald = float(B @ np.linalg.inv(V) @ B)
    lr = 2.0*(m.llf - mr.llf)
    return wald, chi2.sf(wald,2), lr, chi2.sf(lr,2)

def report(tag, controls):
    X  = design(controls)
    m  = sm.Logit(y, X).fit(disp=0)
    Xr = X.drop(columns=["SES_z:Black","SES_z:Hispanic"])
    mr = sm.Logit(y, Xr).fit(disp=0)
    wald,pw,lr,pl = interaction_test(m, X, Xr, mr)
    print(f"\n[MODEL] {tag}   (MLE converged={m.mle_retvals['converged']})")
    print(m.summary2().tables[1].round(4).to_string())
    print(f"  JOINT SES x race interaction: Wald chi2(2)={wald:.3f} p={pw:.4f} | "
          f"LR chi2(2)={lr:.3f} p={pl:.4f}")
    b0=m.params["SES_z"]
    print(f"  Marginal slope of SES (per +1 SD) on log-odds of degree, by race:")
    for r,b in [("White",0.0),("Black",m.params["SES_z:Black"]),("Hispanic",m.params["SES_z:Hispanic"])]:
        s=b0+b
        print(f"     {r:9s} slope={s:+.4f}  OR={np.exp(s):.4f}")
    return m

print("\n"+"="*70)
print("[3] PRIMARY MODEL (unadjusted): deg ~ SES_z * race")
print("="*70)
mP = report("PRIMARY unadjusted", [])

# ---------------- L2-CV robustness cross-check ----------------
def ridge_logreg(Xv, yv, alpha):
    p=Xv.shape[1]
    def nll(b):
        eta=Xv@b; lp=-np.logaddexp(0,-eta); lm=-np.logaddexp(0,eta)
        return -np.sum(np.where(yv==1,lp,lm))+0.5*alpha*np.sum(b[1:]**2)
    def grad(b):
        eta=Xv@b; pb=1/(1+np.exp(-np.clip(eta,-30,30)))
        g=Xv.T@(pb-yv); g[1:]+=alpha*b[1:]; return g
    return minimize(nll,np.zeros(p),jac=grad,method="L-BFGS-B").x
Xp = design([]).values
rng=np.random.default_rng(0); folds=np.array_split(rng.permutation(n),5)
def cv_alpha(alphas):
    best=(None,np.inf)
    for a in alphas:
        sc=[]
        for k in range(5):
            te=folds[k]; tr=np.setdiff1d(np.arange(n),te)
            b=ridge_logreg(Xp[tr],y[tr],a); eta=Xp[te]@b
            lp=-np.logaddexp(0,-eta); lm=-np.logaddexp(0,eta)
            sc.append(-np.mean(np.where(y[te]==1,lp,lm)))
        if np.mean(sc)<best[1]: best=(a,np.mean(sc))
    return best[0]
a_cv=cv_alpha(np.logspace(-3,3,40))
bl=ridge_logreg(Xp,y,a_cv); cols=list(design([]).columns)
print(f"\n[4] L2-REGULARIZED CROSS-CHECK (primary design), CV alpha={a_cv:.3f}")
for c in ["SES_z","SES_z:Black","SES_z:Hispanic"]:
    print(f"  {c:14s} beta={bl[cols.index(c)]:+.4f}")
print("  (plain MLE: SES_z=+0.161, SES_z:Black=+0.565, SES_z:Hispanic=+0.338 -> same direction, similar magnitude)")

# ---------------- sensitivity: academic controls ----------------
print("\n"+"="*70)
print("[5] SENSITIVITY MODEL: deg ~ SES_z * race + ASVAB_z + PCT_z")
print("="*70)
mS = report("Adjusted (+ASVAB, +percentile-in-class)", ["ASVAB_z","PCT_z"])

# ---------------- stratified per-race MLE ----------------
print("\n[6] STRATIFIED per-race bivariate MLE: deg ~ SES_z")
for r in ["White","Black","Hispanic"]:
    s=df[df["SAMPLE_RACE"]==r]
    Xs=sm.add_constant(s[["SES_z"]])
    ms=sm.Logit(s["deg"].values,Xs).fit(disp=0)
    print(f"  {r:9s} n={len(s):5d} events={int(s['deg'].sum()):3d}  "
          f"slope={ms.params['SES_z']:+.4f} (SE {ms.bse['SES_z']:.4f})  OR={np.exp(ms.params['SES_z']):.4f}  p={ms.pvalues['SES_z']:.4f}")

print("\nDONE")
