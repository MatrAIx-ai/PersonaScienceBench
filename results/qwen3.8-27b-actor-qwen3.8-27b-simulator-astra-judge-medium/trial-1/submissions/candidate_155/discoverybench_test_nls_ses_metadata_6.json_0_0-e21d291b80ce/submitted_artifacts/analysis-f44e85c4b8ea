#!/usr/bin/env python3
"""
Analysis: At what socioeconomic levels is the advantage in completion rates
for Black students more pronounced?
Dataset: data/nls_ses_processed.csv
Outcome: BA DEGREE COMPLETED (boolean)
Primary contrast: Black vs White completion rate gap by SES level
"""
import pandas as pd, numpy as np
from scipy import stats
import warnings; warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
print("="*70); print("DATA OVERVIEW"); print("="*70)
print(f"Rows: {len(df)}, Cols: {len(df.columns)}, Missing: {df.isnull().sum().sum()}")
print(f"Race: {df['SAMPLE_RACE'].value_counts().to_dict()}")
print(f"SES: mean={df['SES'].mean():.4f}, SD={df['SES'].std():.4f}, range=[{df['SES'].min():.4f}, {df['SES'].max():.4f}]")
print(f"BA DEGREE COMPLETED: {int(df['BA DEGREE COMPLETED'].sum())} True ({df['BA DEGREE COMPLETED'].mean()*100:.2f}%)")

# PRIMARY: SES DECILES
print("\n" + "="*70); print("PRIMARY: Completion Rate by SES Decile (Black vs White)"); print("="*70)
df['SES_decile'] = pd.qcut(df['SES'], 10, labels=False)
dec_results = []
for d in range(10):
    sub = df[df['SES_decile']==d]
    b = sub[sub['SAMPLE_RACE']=='Black']; w = sub[sub['SAMPLE_RACE']=='White']; h = sub[sub['SAMPLE_RACE']=='Hispanic']
    bn,bc = len(b), int(b['BA DEGREE COMPLETED'].sum())
    wn,wc = len(w), int(w['BA DEGREE COMPLETED'].sum())
    hn,hc = len(h), int(h['BA DEGREE COMPLETED'].sum())
    br,wr,hr = bc/bn, wc/wn, hc/hn
    gap = br - wr; ratio = br/wr if wr>0 else np.nan
    try: _,p = stats.fisher_exact([[bc,bn-bc],[wc,wn-wc]])
    except: p = np.nan
    dec_results.append({'decile':d+1,'ses_lo':sub['SES'].min(),'ses_hi':sub['SES'].max(),'n':len(sub),
        'bn':bn,'bc':bc,'br':br,'wn':wn,'wc':wc,'wr':wr,'hn':hn,'hc':hc,'hr':hr,
        'gap':gap,'ratio':ratio,'p':p})
dec = pd.DataFrame(dec_results)
print(f"\n{'Dec':<4} {'SES Range':<22} {'N':<6} {'Black':<14} {'White':<14} {'Hisp':<14} {'B-W Gap':<10} {'B/W':<8} {'Fisher p':<10}")
print("-"*100)
for _,r in dec.iterrows():
    print(f"D{int(r['decile']):<3} [{r['ses_lo']:.3f}, {r['ses_hi']:.3f}]  {int(r['n']):<6} "
          f"{r['br']:.4f}({int(r['bc'])}/{int(r['bn'])})  {r['wr']:.4f}({int(r['wc'])}/{int(r['wn'])})  "
          f"{r['hr']:.4f}({int(r['hc'])}/{int(r['hn'])})  {r['gap']:+.4f}  {r['ratio']:.3f}  {r['p']:.4f}")
pos = dec[dec['gap']>0]; neg = dec[dec['gap']<0]
print(f"\nDeciles where Black > White: {pos['decile'].tolist()}")
print(f"Deciles where Black < White: {neg['decile'].tolist()}")

# SENSITIVITY 1: TERTILES
print("\n" + "="*70); print("SENSITIVITY 1: SES Tertiles"); print("="*70)
df['SES_tertile'] = pd.qcut(df['SES'], 3, labels=False)
print(f"\n{'Tert':<5} {'SES Range':<22} {'N':<6} {'Black':<14} {'White':<14} {'B-W Gap':<10}")
print("-"*75)
for t in range(3):
    sub = df[df['SES_tertile']==t]
    b = sub[sub['SAMPLE_RACE']=='Black']; w = sub[sub['SAMPLE_RACE']=='White']
    bn,bc = len(b), int(b['BA DEGREE COMPLETED'].sum())
    wn,wc = len(w), int(w['BA DEGREE COMPLETED'].sum())
    br,wr = bc/bn, wc/wn
    print(f"T{t+1:<4} [{sub['SES'].min():.3f}, {sub['SES'].max():.3f}]  {len(sub):<6} "
          f"{br:.4f}({bc}/{bn})  {wr:.4f}({wc}/{wn})  {br-wr:+.4f}")

# SENSITIVITY 2: FIXED BINS
print("\n" + "="*70); print("SENSITIVITY 2: Fixed SES Bins"); print("="*70)
bins = [df['SES'].min()-0.01, -1.5, -1.0, -0.5, 0, 0.5, 1.0, 1.5, 2.0, df['SES'].max()+0.01]
labels = ['<-1.5','-1.5 to -1.0','-1.0 to -0.5','-0.5 to 0','0 to 0.5','0.5 to 1.0','1.0 to 1.5','1.5 to 2.0','>2.0']
df['SES_bin'] = pd.cut(df['SES'], bins=bins, labels=labels)
print(f"\n{'Bin':<15} {'N':<6} {'Black':<14} {'White':<14} {'B-W Gap':<10}")
print("-"*70)
for b in labels:
    sub = df[df['SES_bin']==b]
    if len(sub)==0: continue
    bs = sub[sub['SAMPLE_RACE']=='Black']; ws = sub[sub['SAMPLE_RACE']=='White']
    bn,bc = len(bs), int(bs['BA DEGREE COMPLETED'].sum())
    wn,wc = len(ws), int(ws['BA DEGREE COMPLETED'].sum())
    br = bc/bn if bn>0 else np.nan; wr = wc/wn if wn>0 else np.nan
    gap = br-wr if not(np.isnan(br) or np.isnan(wr)) else np.nan
    print(f"{b:<15} {len(sub):<6} {br:.4f}({bc}/{bn})  {wr:.4f}({wc}/{wn})  {gap:+.4f}")

# SENSITIVITY 3: LOGISTIC REGRESSION
print("\n" + "="*70); print("SENSITIVITY 3: Logistic Regression (Adjusted)"); print("="*70)
import statsmodels.api as sm
df['is_black'] = (df['SAMPLE_RACE']=='Black').astype(int)
df['is_male'] = (df['SAMPLE_SEX']=='Male').astype(int)
df['ability_z'] = (df['ABILITY: COMPOSITE OF ASVAB SCORE'] - df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()) / df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['outcome'] = df['BA DEGREE COMPLETED'].astype(int)
for d in range(2,11):
    df[f'D{d}'] = (df['SES_decile']==d-1).astype(int)
    df[f'Black_D{d}'] = df['is_black'] * df[f'D{d}']

X_cols = ['is_black','D2','D3','D4','D5','D6','D7','D8','D9','D10','ability_z','is_male',
          'Black_D2','Black_D3','Black_D4','Black_D5','Black_D6','Black_D7','Black_D8','Black_D9','Black_D10']
X = sm.add_constant(df[X_cols])
model = sm.Logit(df['outcome'], X).fit(disp=0)

print("\nAdjusted Black vs White OR by SES decile (controlling for ability, sex):")
print(f"{'Dec':<5} {'OR(adj)':<10} {'95% CI':<24} {'p-value':<10}")
for d in range(1,11):
    if d==1:
        log_or = model.params['is_black']; se = model.bse['is_black']
    else:
        log_or = model.params['is_black'] + model.params[f'Black_D{d}']
        covmat = model.cov_params()
        var = covmat.loc['is_black','is_black'] + covmat.loc[f'Black_D{d}',f'Black_D{d}'] + 2*covmat.loc['is_black',f'Black_D{d}']
        se = np.sqrt(var)
    or_adj = np.exp(log_or)
    ci_lo = np.exp(log_or-1.96*se); ci_hi = np.exp(log_or+1.96*se)
    z = log_or/se; p_val = 2*(1-stats.norm.cdf(abs(z)))
    print(f"D{d:<4} {or_adj:.3f}    [{ci_lo:.3f}, {ci_hi:.3f}]       {p_val:.4f}")

# ADDITIONAL CHECKS
print("\n" + "="*70); print("ADDITIONAL: Ability and Percentile Gaps by Decile"); print("="*70)
print(f"\n{'Dec':<5} {'Black Abil':<12} {'White Abil':<12} {'Abil Gap':<12} {'Black %ile':<12} {'White %ile':<12} {'%ile Gap':<10}")
for d in range(10):
    sub = df[df['SES_decile']==d]
    b = sub[sub['SAMPLE_RACE']=='Black']; w = sub[sub['SAMPLE_RACE']=='White']
    ba,wa = b['ABILITY: COMPOSITE OF ASVAB SCORE'].mean(), w['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()
    bp,wp = b['PERCENTILE IN CLASS'].mean(), w['PERCENTILE IN CLASS'].mean()
    print(f"D{d+1:<4} {ba:.1f}       {wa:.1f}       {ba-wa:+.1f}      {bp:.1f}       {wp:.1f}       {bp-wp:+.1f}")

print("\nSex distribution in D10:")
d10 = df[df['SES_decile']==9]
print(d10.groupby(['SAMPLE_RACE','SAMPLE_SEX']).size())
print("\nCompletion by race x sex in D10:")
print(d10.groupby(['SAMPLE_RACE','SAMPLE_SEX'])['BA DEGREE COMPLETED'].agg(['count','sum','mean']))

# SUMMARY
print("\n" + "="*70); print("SUMMARY"); print("="*70)
print(f"\nOverall completion: {df['BA DEGREE COMPLETED'].mean()*100:.2f}%")
print(f"White: {df[df['SAMPLE_RACE']=='White']['BA DEGREE COMPLETED'].mean()*100:.2f}%, "
      f"Black: {df[df['SAMPLE_RACE']=='Black']['BA DEGREE COMPLETED'].mean()*100:.2f}%, "
      f"Hispanic: {df[df['SAMPLE_RACE']=='Hispanic']['BA DEGREE COMPLETED'].mean()*100:.2f}%")
print(f"\nGap narrows from D1 ({dec.iloc[0]['gap']:+.4f}) to D10 ({dec.iloc[9]['gap']:+.4f})")
print(f"D10 is the only decile where Black > White")
print(f"Fisher p for D10: {dec.iloc[9]['p']:.4f} (not significant)")
print(f"Only {int(dec.iloc[9]['bc'])} Black completions in D10")
dec.to_csv('/workspace/decile_results.csv', index=False)
print("\nDecile results saved to /workspace/decile_results.csv")
