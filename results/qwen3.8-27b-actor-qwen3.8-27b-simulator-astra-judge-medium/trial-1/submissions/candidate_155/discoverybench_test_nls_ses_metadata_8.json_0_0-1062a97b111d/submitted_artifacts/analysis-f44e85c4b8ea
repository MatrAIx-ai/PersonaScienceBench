"""
DiscoveryBench: nls_ses — identify the two races behind 'factor of BA degree completion = -0.9568'
Executed analysis: descriptive stats + logistic regressions (3 refs x 4 covariate sets),
matching at +/-0.001 then +/-0.005, plus extended search (all covariate subsets, probit,
OLS, L2-regularized logit) to locate the closest candidate.
"""
import numpy as np, pandas as pd, itertools
import statsmodels.api as sm

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
df["sex_Male"] = (df["SAMPLE_SEX"] == "Male").astype(float)
races = ["White", "Black", "Hispanic"]
TARGET = -0.9568

print(f"n={len(df)}, BA completions={int(df['ba'].sum())} ({df['ba'].mean()*100:.2f}%)")
g = df.groupby("SAMPLE_RACE")["ba"].agg(["count", "sum", "mean"])
print("Completion rates:\n", g.round(4))

SETS = {
    "(a) race only": [],
    "(b) race+SES+sex": ["SES", "sex_Male"],
    "(c) race+SES+sex+ABILITY+PERCENTILE": ["SES", "sex_Male",
        "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS"],
    "(d) all 5 covariates": ["SES", "sex_Male", "ABILITY: COMPOSITE OF ASVAB SCORE",
        "PERCENTILE IN CLASS", "FAMILY SIZE OF SAMPLE"],
}
rows = []
for ref in races:
    for sname, covs in SETS.items():
        X = pd.DataFrame(index=df.index)
        for r in races:
            if r != ref: X[f"race_{r}"] = (df["SAMPLE_RACE"] == r).astype(float)
        for c in covs: X[c] = df[c]
        X = sm.add_constant(X)
        m = sm.Logit(df["ba"], X).fit(disp=0)
        for t in X.columns:
            rows.append(dict(ref=ref, set=sname, term=t, coef=m.params[t], se=m.bse[t]))
res = pd.DataFrame(rows)
res["absdiff"] = (res["coef"] - TARGET).abs()

print("\n=== Requested logistic specs: intercepts + race coefficients ===")
print(res[res["term"].isin(["const"]) | res["term"].str.startswith("race_")][
      ["ref","set","term","coef","se","absdiff"]].round(6).to_string(index=False))

for tol in (0.001, 0.005):
    hits = res[res["absdiff"] <= tol]
    print(f"\nMatching requested specs within +/-{tol}: {len(hits)} hit(s)")
    if len(hits): print(hits.round(6).to_string(index=False))

# Extended search: all 32 covariate subsets x 3 refs, unpenalized logit
cov_pool = list(SETS["(d) all 5 covariates"])
vals = []
for k in range(0, 6):
    for combo in itertools.combinations(cov_pool, k):
        for ref in races:
            X = pd.DataFrame(index=df.index)
            for r in races:
                if r != ref: X[f"race_{r}"] = (df["SAMPLE_RACE"] == r).astype(float)
            for c in combo: X[c] = df[c]
            X = sm.add_constant(X)
            m = sm.Logit(df["ba"], X).fit(disp=0)
            for t in X.columns:
                if t.startswith("race_"):
                    vals.append(dict(term=t, ref=ref, covs="+".join(combo) or "none",
                                     coef=m.params[t], absdiff=abs(m.params[t]-TARGET)))
ev = pd.DataFrame(vals).sort_values("absdiff")
print("\n=== Extended unpenalized search (96 race coefs): top 5 closest to -0.9568 ===")
print(ev.head(5).round(6).to_string(index=False))

# L2-regularized logit (Newton), race only — default-strength regularization check
def logit_newton(X, y, lam, maxit=300):
    n, p = X.shape; beta = np.zeros(p)
    for _ in range(maxit):
        mu = 1/(1+np.exp(-X@beta)); W = mu*(1-mu)
        grad = X.T@(y-mu) - lam*np.concatenate([[0], beta[1:]])
        H = -(X*(W[:,None])).T@X - lam*np.diag(np.concatenate([[0], np.ones(p-1)]))
        step = np.linalg.solve(H, -grad); beta += step
        if np.max(np.abs(step)) < 1e-12: break
    return beta
Xr = np.column_stack([np.ones(len(df)),
                      (df["SAMPLE_RACE"]=="Black").astype(float).values,
                      (df["SAMPLE_RACE"]=="Hispanic").astype(float).values])
print("\n=== L2-regularized logit (race only), lambda scan ===")
for lam in [0.0, 0.5, 1.0, 1.1, 1.2, 2.0]:
    b = logit_newton(Xr, df["ba"].values, lam)
    print(f"lam={lam}: Black={b[1]:.6f} (diff {b[1]-TARGET:+.4f})  Hispanic={b[2]:.6f} (diff {b[2]-TARGET:+.4f})")

print("\n=== CONCLUSION ===")
print("No unpenalized MLE spec hits -0.9568 within +/-0.001 or +/-0.005.")
print("Closest unpenalized: Hispanic vs White race-only -0.924136 (|diff|=0.0327); "
      "Black vs White race-only -1.005703 (|diff|=0.0489).")
print("-0.9568 lies on the L2-shrinkage path of the Black-vs-White coefficient "
      "(lambda ~ 1.05; default C=1 gives -0.961397, |diff|=0.0046 <= 0.005); "
      "the Hispanic coefficient moves AWAY from -0.9568 under any shrinkage.")
print(f"Odds ratio at -0.9568: {np.exp(TARGET):.3f}")
print("\nFINAL HYPOTHESIS: In a logistic (log-odds) model of BA DEGREE COMPLETED, "
      "the race coefficient of -0.9568 corresponds to Black compared to White: "
      "Black respondents have lower log-odds (odds ratio ~0.38) of completing a BA "
      "degree than White respondents.")
