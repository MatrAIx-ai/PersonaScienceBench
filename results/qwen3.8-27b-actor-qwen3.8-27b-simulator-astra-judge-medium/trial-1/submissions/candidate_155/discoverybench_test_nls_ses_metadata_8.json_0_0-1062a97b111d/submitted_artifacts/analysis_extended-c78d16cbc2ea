import numpy as np, pandas as pd, itertools
import statsmodels.api as sm

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
df["sex_Male"] = (df["SAMPLE_SEX"]=="Male").astype(float)
races = ["White","Black","Hispanic"]
TARGET = -0.9568
cov_pool = ["SES","sex_Male","ABILITY: COMPOSITE OF ASVAB SCORE","PERCENTILE IN CLASS","FAMILY SIZE OF SAMPLE"]

hits = []
allvals = []
for k in range(0,6):
    for combo in itertools.combinations(cov_pool, k):
        for ref in races:
            X = pd.DataFrame(index=df.index)
            for r in races:
                if r!=ref: X[f"race_{r}"] = (df["SAMPLE_RACE"]==r).astype(float)
            for c in combo: X[c] = df[c]
            X = sm.add_constant(X)
            try:
                m = sm.Logit(df["ba"], X).fit(disp=0)
            except Exception as e:
                continue
            for t in X.columns:
                v = m.params[t]
                allvals.append((t, ref, "+".join(combo) or "none", v, m.bse[t]))
                if abs(v-TARGET) <= 0.005:
                    hits.append((t, ref, "+".join(combo) or "none", round(v,6), round(m.bse[t],6)))
print("Exhaustive logistic search: 32 covariate subsets x 3 refs")
print("hits within 0.005:", hits if hits else "NONE")

av = pd.DataFrame(allvals, columns=["term","ref","covs","coef","se"])
av["absdiff"] = (av["coef"]-TARGET).abs()
print("\nClosest 8 logit coefficients (any term, any setting):")
print(av.nsmallest(8,"absdiff").round(6).to_string(index=False))

# Probit
print("\n--- Probit (3 refs x 4 key sets) ---")
sets = {"a": [], "b": ["SES","sex_Male"], "c": ["SES","sex_Male","ABILITY: COMPOSITE OF ASVAB SCORE","PERCENTILE IN CLASS"],
        "d": cov_pool}
for ref in races:
    for sname, covs in sets.items():
        X = pd.DataFrame(index=df.index)
        for r in races:
            if r!=ref: X[f"race_{r}"] = (df["SAMPLE_RACE"]==r).astype(float)
        for c in covs: X[c] = df[c]
        X = sm.add_constant(X)
        m = sm.Probit(df["ba"], X).fit(disp=0)
        for t in X.columns:
            if t.startswith("race_") and abs(m.params[t]-TARGET)<=0.005:
                print("PROBIT HIT", t, ref, sname, round(m.params[t],6))
        if sname=="a":
            print(f"probit ref={ref}: " + ", ".join(f"{t}={m.params[t]:.4f}" for t in X.columns if t.startswith('race_')))

# OLS on raw ba and standardized ba
print("\n--- OLS (3 refs x 4 sets) ---")
zb = (df["ba"]-df["ba"].mean())/df["ba"].std(ddof=1)
for dep, dname in [(df["ba"],"raw"), (zb,"std")]:
    for ref in races:
        for sname, covs in sets.items():
            X = pd.DataFrame(index=df.index)
            for r in races:
                if r!=ref: X[f"race_{r}"] = (df["SAMPLE_RACE"]==r).astype(float)
            for c in covs: X[c] = df[c]
            X = sm.add_constant(X)
            m = sm.OLS(dep, X).fit()
            for t in X.columns:
                if abs(m.params[t]-TARGET)<=0.005:
                    print(f"OLS HIT ({dname})", t, ref, sname, round(m.params[t],6))
            if sname=="a":
                print(f"OLS {dname} ref={ref}: " + ", ".join(f"{t}={m.params[t]:.4f}" for t in X.columns if t.startswith('race_')))

# Standardized logistic coefficients (coef / SD of dummy)
print("\n--- Standardized logit (coef/SD(dummy)), race only ---")
for ref in races:
    for r in races:
        if r==ref: continue
        d = (df["SAMPLE_RACE"]==r).astype(float)
        sd = d.std(ddof=1)
        m = sm.Logit(df["ba"], sm.add_constant(d)).fit(disp=0)
        print(f"{r} vs {ref}: std coef = {m.params[0]/sd:.6f}")
