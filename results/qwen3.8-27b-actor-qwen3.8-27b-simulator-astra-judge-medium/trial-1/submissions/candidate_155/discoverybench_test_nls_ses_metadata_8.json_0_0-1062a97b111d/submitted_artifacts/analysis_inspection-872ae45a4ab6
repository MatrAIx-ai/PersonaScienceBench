import pandas as pd
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("\n--- SAMPLE_RACE value counts (incl NaN) ---")
print(df["SAMPLE_RACE"].value_counts(dropna=False))
print("unique:", sorted(df["SAMPLE_RACE"].dropna().unique()))
print("n missing:", df["SAMPLE_RACE"].isna().sum())

print("\n--- BA DEGREE COMPLETED ---")
print("dtype:", df["BA DEGREE COMPLETED"].dtype)
print(df["BA DEGREE COMPLETED"].value_counts(dropna=False))
print("n missing/other:", df["BA DEGREE COMPLETED"].isna().sum())

print("\n--- other key fields ---")
for c in ["SAMPLE_SEX","SES","ABILITY: COMPOSITE OF ASVAB SCORE","PERCENTILE IN CLASS","FAMILY SIZE OF SAMPLE","CASE ID"]:
    s = df[c]
    print(c, "| dtype:", s.dtype, "| missing:", s.isna().sum(),
          "| min:", s.min() if s.dtype!=object else "-", "| max:", s.max() if s.dtype!=object else "-",
          "| nunique:", s.nunique())

print("\n--- dup CASE ID:", df["CASE ID"].duplicated().sum())

print("\n--- BA completion rate by race (descriptive) ---")
df["ba"] = df["BA DEGREE COMPLETED"].map({"True":1,"False":0})
tab = df.groupby("SAMPLE_RACE")["ba"].agg(["count","sum","mean"])
print(tab.round(4))
print("\npairwise mean diffs (mean_BA_x - mean_BA_y):")
races = list(tab.index)
for i,a in enumerate(races):
    for b in races[i+1:]:
        print(f"{a} - {b}: {tab.loc[a,'mean']-tab.loc[b,'mean']:.6f}")
