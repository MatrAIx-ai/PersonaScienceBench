"""
Analysis: which two roles have the highest proportion of association with
requirements in ML-enabled systems (survey Q8_ML_Addressing_*), with
bootstrap 95% CIs.

Coding rule:
  value == 'quoted'      -> 1 (role associated with ML-related requirements)
  value == 'not quoted'  -> 0
  value == '-77'         -> NA (suspended surveys); EXCLUDED from denominator
                            (dataset uses -77, not -99, for Q8 items)

Primary analysis: respondent-level proportion, denominator = 194 valid respondents.
Secondary analysis: project-weighted proportion, weight = D7_Total_ML_Projects
                     (its -99 values excluded; 16 of 194 respondents dropped).

Bootstrap: B=10,000 resamples WITH REPLACEMENT at the RESPONDENT level,
           95% CI = 2.5th / 97.5th percentiles, fixed seed 42.
"""
import csv
import random

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
B = 10_000
SEED = 42

ROLES = [
    ("Project Lead",        "Q8_ML_Addressing_Project_Lead"),
    ("Business Analyst",    "Q8_ML_Addressing_Business_Analyst"),
    ("Requirement Engineer","Q8_ML_Addressing_Requirement_Engineer"),
    ("Solution Architect",  "Q8_ML_Addressing_Solution_Architect"),
    ("Data Scientist",      "Q8_ML_Addressing_Data_Scientist"),
    ("Developer",           "Q8_ML_Addressing_Developer"),
    ("Tester",              "Q8_ML_Addressing_Tester"),
    ("Others",              "Q8_ML_Addressing_Others"),
]

with open(CSV) as f:
    reader = csv.reader(f)
    header = next(reader)
    rows = list(reader)

idx = {c: header.index(c) for c in header}

# ---- build respondent records (exclude -77 block) ----
recs = []  # (y_dict, w)
for row in rows:
    y = {name: 1 if row[idx[col]] == "quoted" else
               (0 if row[idx[col]] == "not quoted" else None)
         for name, col in ROLES}
    if any(v is None for v in y.values()):
        continue  # -77 NA block (suspended surveys) -> excluded
    d7 = row[idx["D7_Total_ML_Projects"]].strip()
    w = float(d7) if (d7 not in ("", "-99") and float(d7) >= 0) else None
    recs.append((y, w))

n = len(recs)
print(f"valid respondents (Q8 answered): {n} of {len(rows)}")

def prop_unweighted(sample):
    return {name: sum(r[0][name] for r in sample) / len(sample) for name, _ in ROLES}

def prop_weighted(sample):
    out = {}
    for name, _ in ROLES:
        num = sum(r[1] * r[0][name] for r in sample if r[1] is not None)
        den = sum(r[1] for r in sample if r[1] is not None)
        out[name] = num / den
    return out

# ---- point estimates ----
p_unw = prop_unweighted(recs)
p_wgt = prop_weighted(recs)
print("\n=== PRIMARY: respondent-level proportions (n=%d) ===" % n)
print(f"{'role':24s} {'quoted':>6s} {'prop':>8s}")
for name, _ in ROLES:
    q = sum(r[0][name] for r in recs)
    print(f"{name:24s} {q:6d} {100*p_unw[name]:7.3f}%")

print("\n=== SECONDARY: project-weighted proportions (D7 weight, sum w=%d) ===" %
      sum(r[1] for r in recs if r[1] is not None))
for name, _ in ROLES:
    print(f"{name:24s} {100*p_wgt[name]:7.3f}%")

# ---- bootstrap (respondent-level, with replacement, B=10000, seed 42) ----
rng = random.Random(SEED)
boot_unw = {name: [] for name, _ in ROLES}
boot_wgt = {name: [] for name, _ in ROLES}
for _ in range(B):
    sample = [recs[rng.randrange(n)] for _ in range(n)]
    pu = prop_unweighted(sample)
    for name, _ in ROLES:
        boot_unw[name].append(pu[name])
    pw = prop_weighted(sample)
    for name, _ in ROLES:
        boot_wgt[name].append(pw[name])

def ci(vals, lo=2.5, hi=97.5):
    s = sorted(vals)
    k = (len(s) - 1) * lo / 100.0
    fl = int(k); fr = min(fl + 1, len(s) - 1)
    lo_v = s[fl] + (k - fl) * (s[fr] - s[fl])
    k = (len(s) - 1) * hi / 100.0
    fl = int(k); fr = min(fl + 1, len(s) - 1)
    hi_v = s[fl] + (k - fl) * (s[fr] - s[fl])
    return lo_v, hi_v

print("\n=== BOOTSTRAP 95 CI (B=%d, respondent-level w/ replacement, seed %d) ===" % (B, SEED))
print(f"{'role':24s} {'est':>8s} {'CI lo':>8s} {'CI hi':>8s}   [weighted est / CI]")
results = []
for name, _ in ROLES:
    lo_u, hi_u = ci(boot_unw[name])
    lo_w, hi_w = ci(boot_wgt[name])
    results.append((name, p_unw[name], lo_u, hi_u, p_wgt[name], lo_w, hi_w))
for name, e, lo_u, hi_u, ew, lo_w, hi_w in sorted(results, key=lambda t: -t[1]):
    print(f"{name:24s} {100*e:7.3f}% {100*lo_u:7.3f}% {100*hi_u:7.3f}%   "
          f"[{100*ew:7.3f}% / {100*lo_w:7.3f}-{100*hi_w:7.3f}%]")

top2 = sorted(results, key=lambda t: -t[1])[:2]
print("\nTOP-2 ROLES (primary, respondent-level):",
      ", ".join(f"{t[0]} ({100*t[1]:.3f}%, 95% CI [{100*t[2]:.3f}, {100*t[3]:.3f}])" for t in top2))
top2w = sorted(results, key=lambda t: -t[4])[:2]
print("TOP-2 ROLES (secondary, weighted):",
      ", ".join(f"{t[0]} ({100*t[4]:.3f}%, 95% CI [{100*t[5]:.3f}, {100*t[6]:.3f}])" for t in top2w))
