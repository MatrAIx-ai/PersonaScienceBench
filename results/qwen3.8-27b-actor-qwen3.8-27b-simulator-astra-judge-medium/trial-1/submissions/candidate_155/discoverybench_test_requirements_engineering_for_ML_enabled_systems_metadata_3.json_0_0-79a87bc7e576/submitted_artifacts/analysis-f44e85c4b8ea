"""
DiscoveryBench: Requirements elicitation techniques in ML-enabled systems.
Encodes Q9 elicitation columns, computes usage proportions + respondent-level
bootstrap 95% CIs, and a non-Suspended sensitivity analysis.
"""
import csv, json
import numpy as np

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
SEED = 42
B = 10_000

Q9 = {
    "Interviews": "Q9_ML_Elicitation_Interviews",
    "Scenarios": "Q9_ML_Elicitation_Scenarios",
    "Prototyping": "Q9_ML_Elicitation_Prototyping",
    "Workshops_Meetings": "Q9_ML_Elicitation_Workshops_Meetings",
    "Observation": "Q9_ML_Elicitation_Observation",
    "Others": "Q9_ML_Elicitation_Others",
}
FREE = "Q9_ML_Elicitation_Others_Free"
NA_SENTINELS = {"-77", "-99", "-66", "", "0"}  # negative/NA sentinels excluded

with open(CSV) as f:
    r = csv.reader(f)
    header = next(r)
    idx = {n: i for i, n in enumerate(header)}
    data = list(r)

status_i = idx["Status"]
def enc(val):
    if val == "quoted":
        return 1
    if val == "not quoted":
        return 0
    if val in NA_SENTINELS:
        return np.nan
    return np.nan  # any unexpected value treated as NA

# Build per-technique arrays aligned to rows
rows_valid = []   # indices of respondents with at least one valid Q9 response
tech = {k: [] for k in Q9}
for j, row in enumerate(data):
    vals = {k: enc(row[idx[c]]) for k, c in Q9.items()}
    if all(np.isnan(v) for v in vals.values()):
        continue
    rows_valid.append(j)
    for k in Q9:
        tech[k].append(vals[k])

n_valid = len(rows_valid)
status_valid = [data[j][status_i] for j in rows_valid]

def proportion_ci(arr, seed=SEED, B=B):
    """percentile bootstrap of the mean of a 0/1 array (NA removed)."""
    x = np.asarray(arr, dtype=float)
    x = x[~np.isnan(x)]
    n = len(x)
    p = x.mean()
    rng = np.random.default_rng(seed)
    idxs = rng.integers(0, n, size=(B, n))
    boots = x[idxs].mean(axis=1)
    lo, hi = np.percentile(boots, [2.5, 97.5])
    return p, lo, hi, n

def run(subset_mask, label):
    out = {}
    for k in Q9:
        arr = [tech[k][m] for m, keep in enumerate(subset_mask) if keep]
        p, lo, hi, n = proportion_ci(arr)
        out[k] = {"p_pct": round(100*p, 3), "ci_lo": round(100*lo, 3),
                  "ci_hi": round(100*hi, 3), "n_used": int(np.nansum(arr)), "n_valid": n}
    return out

# Primary: all valid respondents (denom=194)
mask_all = [True]*n_valid
primary = run(mask_all, "primary")

# Sensitivity: non-Suspended only
mask_ns = [s != "Suspended (22)" for s in status_valid]
sens = run(mask_ns, "sensitivity_non_suspended")
n_ns = sum(mask_ns)

# Others free-text (descriptive)
free_vals = [row[idx[FREE]] for row in data if row[idx[Q9["Others"]]] == "quoted"]

# ranking
def ranked(res):
    return sorted(res.items(), key=lambda kv: kv[1]["p_pct"], reverse=True)

print(f"n valid respondents (primary denom) = {n_valid}")
print(f"n non-Suspended (sensitivity denom) = {n_ns}")
print("\n=== PRIMARY (denom=194, valid respondents) ===")
for k, v in ranked(primary):
    print(f"  {k:<20} p={v['p_pct']:7.3f}%  CI95=[{v['ci_lo']:.3f}, {v['ci_hi']:.3f}]  (used={v['n_used']}/{v['n_valid']})")
print("\n=== SENSITIVITY (non-Suspended, denom={}) ===".format(n_ns))
for k, v in ranked(sens):
    print(f"  {k:<20} p={v['p_pct']:7.3f}%  CI95=[{v['ci_lo']:.3f}, {v['ci_hi']:.3f}]  (used={v['n_used']}/{v['n_valid']})")

top_p = ranked(primary)[0]
top_s = ranked(sens)[0]
print(f"\nMost-used technique (primary): {top_p[0]} ({top_p[1]['p_pct']}%)")
print(f"Most-used technique (sensitivity): {top_s[0]} ({top_s[1]['p_pct']}%)")
print(f"\nOthers free-text (n={len(free_vals)}): {free_vals}")

# save JSON artifact
result = {"n_valid": n_valid, "n_non_suspended": n_ns, "primary": primary,
          "sensitivity_non_suspended": sens, "others_free_text": free_vals,
          "target": {"pct": 69.399, "ci": [69.062, 69.735]},
          "bootstrap": {"B": B, "seed": SEED, "method": "percentile, respondent-level resampling"}}
with open("analysis_result.json", "w") as f:
    json.dump(result, f, indent=2)
print("\nSaved analysis_result.json")
