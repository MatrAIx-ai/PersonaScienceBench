"""
Main analysis: documentation format usage rates for requirements in
ML-enabled system projects (Q10_ML_Documentation_*), with bootstrap 95% CIs.

Coding: 'quoted' = format used; 'not quoted' = not used; '-77' = skipped (NA).
Denominator: respondents who answered Q10 (n=194; the 82 '-77' rows are the
82 'Suspended (22)' respondents, identical across all 12 columns).
Bootstrap: resample respondents (rows) with replacement, B=10,000, seed=42.
CI: percentile (primary), BCa (scipy) and Wilson as checks.
"""
import numpy as np
import pandas as pd
from scipy import stats

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
B, SEED, ALPHA = 10000, 42, 0.05

df = pd.read_csv(CSV)
q10 = [c for c in df.columns if c.startswith("Q10_ML_Documentation") and not c.endswith("_Free")]
assert len(q10) == 12

# --- NA handling: drop respondents who skipped Q10 ('-77' in every col) ---
skip = (df[q10[0]] == "-77")
assert all((df[c] == "-77").equals(skip) for c in q10), "-77 rows differ across columns"
valid = df[~skip].reset_index(drop=True)
n = len(valid)
assert valid["Status"].eq("Suspended (22)").sum() == (skip.sum() - skip.sum() + valid["Status"].eq("Suspended (22)").sum())
print(f"total rows={len(df)}  skipped(-77)={int(skip.sum())}  valid n={n}")
print("status of valid rows:", dict(valid["Status"].value_counts()))

# binary usage matrix: 1 if 'quoted'
X = (valid[q10].eq("quoted")).astype(int).to_numpy()
names = [c.replace("Q10_ML_Documentation_", "") for c in q10]

def wilson(k, nn, alpha=ALPHA):
    z = stats.norm.ppf(1 - alpha / 2)
    p = k / nn
    den = 1 + z * z / nn
    ctr = (p + z * z / (2 * nn)) / den
    half = z * np.sqrt(p * (1 - p) / nn + z * z / (4 * nn * nn)) / den
    return ctr - half, ctr + half


def bca_ci(x, B, SEED):
    """Manual BCa CI for the mean of a 0/1 vector (robust to ties)."""
    rng = np.random.default_rng(SEED)
    nn = len(x)
    p0 = x.mean()
    boot = np.array([x[rng.integers(0, nn, size=nn)].mean() for _ in range(B)])
    # z0 with tie correction
    c = np.searchsorted(np.sort(boot), p0, side="left")  # # bootstrap values < p0
    c = min(max(c, 1), B - 1)
    z0 = stats.norm.ppf(c / B)
    # acceleration via jackknife
    jack = np.array([(x.sum() - x[i]) / (nn - 1) for i in range(nn)])
    jbar = jack.mean()
    num = ((jack - jbar) ** 3).sum()
    den = 6 * (((jack - jbar) ** 2).sum() ** 1.5)
    a = num / den if den > 0 else 0.0
    z_lo = stats.norm.ppf(ALPHA / 2)
    z_hi = stats.norm.ppf(1 - ALPHA / 2)
    def adj(z):
        return z0 + (z0 + z) / (1 - a * (z0 + z))
    lo = np.percentile(boot, 100 * stats.norm.cdf(adj(z_lo)))
    hi = np.percentile(boot, 100 * stats.norm.cdf(adj(z_hi)))
    return lo, hi

rng = np.random.default_rng(SEED)
boot = np.empty((B, X.shape[1]))
for b in range(B):
    idx = rng.integers(0, n, size=n)
    boot[b] = X[idx].mean(axis=0)

results = []
for j, name in enumerate(names):
    k = int(X[:, j].sum())
    p = k / n
    lo, hi = np.percentile(boot[:, j], [100 * ALPHA / 2, 100 * (1 - ALPHA / 2)])
    bca_lo, bca_hi = bca_ci(X[:, j], B, SEED)
    wlo, whi = wilson(k, n)
    results.append(dict(format=name, quoted=k, n=n, rate_pct=100 * p,
                        ci_lo_pct=100 * lo, ci_hi_pct=100 * hi,
                        bca_lo_pct=100 * bca_lo, bca_hi_pct=100 * bca_hi,
                        wilson_lo_pct=100 * wlo, wilson_hi_pct=100 * whi))

tab = pd.DataFrame(results).sort_values("rate_pct").reset_index(drop=True)
tab.insert(0, "rank", tab.index + 1)
pd.set_option("display.width", 200)
print("\n=== Full ranking, ascending by point estimate (percentile bootstrap 95% CI, B=10000, seed=42) ===")
print(tab.to_string(index=False, float_format=lambda x: f"{x:.3f}"))

core = [r for r in results if r["format"] not in ("Not_Documented", "Others")]
lowest = min(core, key=lambda r: r["rate_pct"])
second = min((r for r in core if r["format"] != lowest["format"]), key=lambda r: r["rate_pct"])
tie_others = next(r for r in results if r["format"] == "Others")
print(f"\nLowest: {lowest['format']}  {lowest['rate_pct']:.3f}%  95% CI [{lowest['ci_lo_pct']:.3f}, {lowest['ci_hi_pct']:.3f}]")
print(f"Second lowest: {second['format']}  {second['rate_pct']:.3f}%  95% CI [{second['ci_lo_pct']:.3f}, {second['ci_hi_pct']:.3f}]")
print(f"Tie disclosure: Others free-text fallback = {tie_others['rate_pct']:.3f}% (same as {second['format']})")
tab.to_csv("q10_format_usage_ranking.csv", index=False)
print("\nsaved q10_format_usage_ranking.csv")
