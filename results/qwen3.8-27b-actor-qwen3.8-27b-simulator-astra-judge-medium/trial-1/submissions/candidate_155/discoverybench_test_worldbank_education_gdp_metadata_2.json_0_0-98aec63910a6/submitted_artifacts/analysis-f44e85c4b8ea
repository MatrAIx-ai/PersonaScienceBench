#!/usr/bin/env python3
"""
DiscoveryBench analysis: effect of education expenditure on per-capita income,
Lower middle income (LMC) vs Sub-Saharan Africa (SSA), 1975-2015 (WDI group
aggregates, worldbank_education_gdp.csv).

Design (approved by researcher):
  - Separate group-level models. NO imputation/back-fill of SSA GNI 1975-2010.
  - LMC main: ARDL(1,1) with lagged dynamics (levels + lagged GNI), 1976-2015.
  - LMC robustness: (i) first-difference spec, (ii) naive levels spec,
    (iii) controls spec 1992-2015 (enrollment, labor force, exports growth),
    (iv) time-trend ARDL diagnostic (trend-robustness of the main spec).
  - SSA: bivariate OLS of GNI on lagged education expenditure (2012-2015, n=4)
    + concurrent sensitivity (2011-2015, n=5); inference INDICATIVE ONLY.
  - NO formal test of the difference between the two slopes (5 SSA points);
    side-by-side point estimates with verbal comparison.
  - LMC slope translated back to a level statement (US$ per capita per +1pp).
"""
import warnings
warnings.filterwarnings("ignore")
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

pd.set_option("display.width", 200)

df = pd.read_csv("data/worldbank_education_gdp.csv")
year_cols = [c for c in df.columns if c[:4].isdigit()]
years = [int(c[:4]) for c in year_cols]

def tidy(group):
    sub = df[df["Country Group"] == group].set_index("Series Code")
    out = pd.DataFrame({"year": years})
    for name, code in [
        ("edu", "NY.ADJ.AEDU.GN.ZS"),
        ("gni", "NY.GNP.PCAP.KD"),
        ("exp", "NE.EXP.GNFS.KD.ZG"),
        ("prim", "SE.PRM.ENRR"),
        ("sec", "SE.SEC.ENRR"),
        ("lfp", "SL.TLF.CACT.ZS"),
    ]:
        out[name] = pd.to_numeric(sub.loc[code, year_cols].values, errors="coerce")
    return out

lmc = tidy("Lower middle income")
ssa = tidy("Sub-Saharan Africa")
# lags/differences on the FULL frame so no year is lost
lmc["d_gni"] = lmc["gni"].diff()
lmc["edu_l1"] = lmc["edu"].shift(1)
lmc["gni_l1"] = lmc["gni"].shift(1)
lmc["d_gni_l1"] = lmc["d_gni"].shift(1)
lmc["trend"] = np.arange(len(lmc))

def report(title, res):
    print("\n" + "=" * 78)
    print(title)
    print("=" * 78)
    print(res.summary())
    resid = res.resid
    dw = float(np.sum(np.diff(resid) ** 2) / np.sum(resid ** 2))
    print(f"R2={res.rsquared:.4f}  adjR2={res.rsquared_adj:.4f}  DW={dw:.3f}")
    return res

print("Sample sizes: LMC gni n=%d (1975-2015); SSA gni n=%d (2011-2015)"
      % (lmc.gni.notna().sum(), ssa.gni.notna().sum()))

# ---------------------------------------------------------------- LMC main
d = lmc[lmc.year >= 1976].dropna(subset=["gni", "edu", "edu_l1", "gni_l1"])
X = sm.add_constant(d[["edu", "edu_l1", "gni_l1"]])
res_main = report("LMC MAIN  ARDL(1,1):  GNI_t = a + b1*edu_t + b2*edu_{t-1} + g*GNI_{t-1}   (n=%d, 1976-2015)" % len(X),
                  sm.OLS(d["gni"], X).fit())
b1, b2, g = (res_main.params[k] for k in ("edu", "edu_l1", "gni_l1"))
mean_gni = lmc["gni"].mean()
print(f"\nLEVEL TRANSLATION (LMC, main spec):")
print(f"  +1pp edu/GNI, same year  : {b1:+.1f} US$ (const 2015) per capita (~{100*b1/mean_gni:+.2f}% of mean GNI {mean_gni:.0f})")
print(f"  +1pp edu/GNI, 1-year lag : {b2:+.1f} US$")
print(f"  lagged-GNI persistence   : {g:.3f}  (>1 => levels non-stationary; ARDL long-run formula NOT valid, not reported)")

# ------------------------------------------------- LMC robustness: 1st diff
d1 = lmc[lmc.year >= 1977].dropna(subset=["d_gni", "edu_l1", "d_gni_l1"])
X1 = sm.add_constant(d1[["edu_l1", "d_gni_l1"]])
res_fd = report("LMC ROBUSTNESS 1  first differences:  dGNI_t = a + b*edu_{t-1} + g*dGNI_{t-1}   (n=%d, 1977-2015)" % len(X1),
                sm.OLS(d1["d_gni"], X1).fit())
print(f"  dGNI per +1pp edu (lagged): {res_fd.params['edu_l1']:+.1f} US$/yr")

# ------------------------------------------------- LMC robustness: naive levels
d2 = lmc[lmc.year >= 1976].dropna(subset=["gni", "edu"])
X2 = sm.add_constant(d2[["edu"]])
res_lv = report("LMC ROBUSTNESS 2  naive levels:  GNI_t = a + b*edu_t   (n=%d, 1976-2015)  [trending-levels, expected spurious]" % len(X2),
                sm.OLS(d2["gni"], X2).fit())

# ------------------------------------------------- LMC robustness: controls
d3 = lmc[lmc.year >= 1992].dropna(subset=["gni", "edu", "edu_l1", "gni_l1", "prim", "sec", "lfp", "exp"])
X3 = sm.add_constant(d3[["edu", "edu_l1", "gni_l1", "prim", "sec", "lfp", "exp"]])
res_c = report("LMC ROBUSTNESS 3  controls 1992-2015:  GNI_t = a + b1*edu_t + b2*edu_{t-1} + g*GNI_{t-1} + prim + sec + lfp + exp   (n=%d)" % len(X3),
               sm.OLS(d3["gni"], X3).fit())
vif = pd.Series([variance_inflation_factor(X3.values, i) for i in range(X3.shape[1])], index=X3.columns)
print("VIF (controls spec):\n" + vif.round(1).to_string())
b1c, b2c, gc = (res_c.params[k] for k in ("edu", "edu_l1", "gni_l1"))

# ------------------------------------------------- LMC diagnostic: + time trend
d4 = lmc[lmc.year >= 1976].dropna(subset=["gni", "edu", "edu_l1", "gni_l1"])
X4 = sm.add_constant(d4[["edu", "edu_l1", "gni_l1", "trend"]])
res_tr = report("LMC DIAGNOSTIC 4  ARDL(1,1) + linear time trend   (n=%d, 1976-2015)" % len(X4),
                sm.OLS(d4["gni"], X4).fit())
print(f"  education coefficients with trend: b1={res_tr.params['edu']:+.1f}, b2={res_tr.params['edu_l1']:+.1f} US$/pp")

print("\n" + "=" * 78)
print("COEFFICIENT STABILITY CHECK (LMC education coefficients, US$ per +1pp edu/GNI)")
print("=" * 78)
print(f"  short-run (same-year):  main {b1:+.1f} | +trend {res_tr.params['edu']:+.1f} | controls {b1c:+.1f}")
print(f"  1-year lagged:          main {b2:+.1f} | +trend {res_tr.params['edu_l1']:+.1f} | controls {b2c:+.1f}")
print(f"  first-diff (lagged):    {res_fd.params['edu_l1']:+.1f} US$/yr")
print(f"  naive levels (spurious, trend-driven): {res_lv.params['edu']:+.1f}")
print("  Note: controls spec gni_l1 = %.3f (<1), implied long-run (b1+b2)/(1-g) = %+.1f US$ (n=24, VIF high; indicative)" % (gc, (b1c + b2c) / (1 - gc)))

# ----------------------------------------------------------------- SSA spec
s = ssa.dropna(subset=["gni", "edu"]).copy()
s["edu_l1"] = s["edu"].shift(1)
print("\nSSA GNI available years:", list(s.year), "| SSA edu share those years:",
      [round(v, 2) for v in s.edu])
Xs = sm.add_constant(s[["edu_l1"]].dropna())
res_s = report("SSA BIVARIATE  GNI_t = a + b*edu_{t-1}   (n=%d, 2012-2015)   -- inference INDICATIVE ONLY" % len(Xs),
               sm.OLS(s["gni"].loc[Xs.index], Xs).fit())
print(f"  95% CI (INDICATIVE ONLY): {res_s.conf_int().loc['edu_l1'].values}")
Xs2 = sm.add_constant(s[["edu"]])
res_s2 = report("SSA SENSITIVITY  concurrent GNI_t = a + b*edu_t   (n=%d, 2011-2015)   -- INDICATIVE ONLY" % len(Xs2),
                sm.OLS(s["gni"].loc[Xs2.index], Xs2).fit())
print(f"  95% CI (INDICATIVE ONLY): {res_s2.conf_int().loc['edu'].values}")

# ------------------------------------------------------------- side by side
print("\n" + "=" * 78)
print("SIDE-BY-SIDE POINT ESTIMATES (US$ const-2015 per-capita income per +1pp edu/GNI)")
print("=" * 78)
print(f"  LMC short-run (same-year) : {b1:+.1f}     [ARDL(1,1), n=40, p={res_main.pvalues['edu']:.2f}]")
print(f"  LMC w/ time trend         : {res_tr.params['edu']:+.1f}     [n=40, p={res_tr.pvalues['edu']:.2f}]")
print(f"  LMC w/ controls           : {b1c:+.1f}     [n=24, p={res_c.pvalues['edu']:.2f}]")
print(f"  LMC first-diff (lagged)   : {res_fd.params['edu_l1']:+.1f}   [n=39, p={res_fd.pvalues['edu_l1']:.2f}]")
print(f"  SSA slope (lagged)        : {res_s.params['edu_l1']:+.1f}   [bivariate, n=4, INDICATIVE]")
print(f"  SSA slope (concurrent)    : {res_s2.params['edu']:+.1f}   [bivariate, n=5, INDICATIVE]")
print("  NO formal test of the difference is reported (5 SSA points).")

# descriptive context
print("\nDESCRIPTIVE CONTEXT")
print(f"  LMC edu share 1975 -> 2015: {lmc.edu.iloc[0]:.2f} -> {lmc.edu.iloc[-1]:.2f} (peak {lmc.edu.max():.2f} in {int(lmc.year[lmc.edu.idxmax()])})")
print(f"  LMC GNI/cap  1975 -> 2015: {lmc.gni.iloc[0]:.0f} -> {lmc.gni.iloc[-1]:.0f}")
print(f"  SSA edu share 1975 -> 2015: {ssa.edu.iloc[0]:.2f} -> {ssa.edu.iloc[-1]:.2f}")
print(f"  SSA GNI/cap  2011 -> 2015: {s.gni.iloc[0]:.0f} -> {s.gni.iloc[-1]:.0f} (+{100*(s.gni.iloc[-1]/s.gni.iloc[0]-1):.1f}%)")

rows = []
for tag, r in [("LMC main ARDL(1,1) n=40", res_main), ("LMC 1st-diff n=39", res_fd),
               ("LMC naive levels n=40", res_lv), ("LMC ARDL+trend n=40", res_tr),
               ("LMC controls 1992-2015 n=24", res_c),
               ("SSA bivar lagged n=4 (indicative)", res_s),
               ("SSA bivar concurrent n=5 (indicative)", res_s2)]:
    for k, v in r.params.items():
        if k == "const":
            continue
        rows.append({"spec": tag, "term": k, "coef": round(float(v), 2),
                     "se": round(float(r.bse[k]), 2), "p": round(float(r.pvalues[k]), 4)})
pd.DataFrame(rows).to_csv("results_table.csv", index=False)
print("\nSaved results_table.csv")
