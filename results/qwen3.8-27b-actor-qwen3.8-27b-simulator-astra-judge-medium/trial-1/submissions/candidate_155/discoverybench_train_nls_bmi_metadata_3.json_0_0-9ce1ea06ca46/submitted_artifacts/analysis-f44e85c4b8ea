"""
Analysis: How does age influence the likelihood of withdrawing more money from
savings than putting in?

Data: data/nls_bmi_processed.csv (NLSY79, 1989 snapshot)
Primary frame: SAMESAVE == 0 (any change in savings), deduplicated.
Outcome: DISSAVED (1 = withdrew more than put in).
Predictors of interest: AGE (linear) and AGE_2 (= AGE^2, quadratic).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 50)

# ----------------------------------------------------------------------
# 1. Load and deduplicate
# ----------------------------------------------------------------------
df_full = pd.read_csv('data/nls_bmi_processed.csv')
N_raw = len(df_full)

df = df_full.drop_duplicates().reset_index(drop=True)
N_dedup = len(df)
print("="*70)
print("1. SAMPLE SIZES")
print("="*70)
print(f"Raw rows (as supplied)          : {N_raw}")
print(f"Unique rows (after dedup)        : {N_dedup}")
print(f"Duplicate rows removed           : {N_raw - N_dedup}")

# ----------------------------------------------------------------------
# 2. Restrict to SAMESAVE == 0 (primary frame)
# ----------------------------------------------------------------------
df_full_frame = df  # dedup full sample
df_r = df[df['SAMESAVE'] == 0].reset_index(drop=True)
N_full = len(df_full_frame)
N_r = len(df_r)
print("\n" + "="*70)
print("2. ANALYTICAL FRAMES")
print("="*70)
print(f"Full sample (dedup)              : N = {N_full}")
print(f"Restricted SAMESAVE=0 (dedup)    : N = {N_r}")
print(f"  DISSAVED=1 (restricted)        : {int(df_r['DISSAVED'].sum())} "
      f"({df_r['DISSAVED'].mean()*100:.1f}%)")
print(f"  DISSAVED=1 (full)              : {int(df_full_frame['DISSAVED'].sum())} "
      f"({df_full_frame['DISSAVED'].mean()*100:.1f}%)")

# Structural check
print("\nStructural check: DISSAVED among SAMESAVE=1 (should be all 0):")
s1 = df[df['SAMESAVE']==1]
print(f"  SAMESAVE=1 N={len(s1)}, DISSAVED=1 count={int(s1['DISSAVED'].sum())}")

# ----------------------------------------------------------------------
# 3. Descriptive: DISSAVED rate by single-year age
# ----------------------------------------------------------------------
print("\n" + "="*70)
print("3. DESCRIPTIVE: DISSAVED rate by age (restricted SAMESAVE=0)")
print("="*70)
desc = df_r.groupby('AGE')['DISSAVED'].agg(N='count', events='sum',
                                           rate='mean').round(4)
desc['events'] = desc['events'].astype(int)
print(desc.to_string())

print("\nFull-sample DISSAVED rate by age:")
descf = df_full_frame.groupby('AGE')['DISSAVED'].agg(N='count', events='sum',
                                                     rate='mean').round(4)
descf['events'] = descf['events'].astype(int)
print(descf.to_string())

# ----------------------------------------------------------------------
# 4. Models (restricted sample = primary)
# ----------------------------------------------------------------------
def fit_logit(data, formula):
    return smf.logit(formula, data=data).fit(disp=0)

print("\n" + "="*70)
print("4. MODELS (restricted SAMESAVE=0, dedup)")
print("="*70)

# Center age to reduce collinearity
age_mean = df_r['AGE'].mean()
df_r = df_r.assign(AGE_c=df_r['AGE']-age_mean, AGE_c2=(df_r['AGE']-age_mean)**2)
df_full_frame = df_full_frame.assign(AGE_c=df_full_frame['AGE']-age_mean,
                                     AGE_c2=(df_full_frame['AGE']-age_mean)**2)
print(f"Age centered at mean = {age_mean:.3f}")

# 4a. Linear-only
m_lin = fit_logit(df_r, 'DISSAVED ~ AGE_c')
# 4b. Quadratic
m_quad = fit_logit(df_r, 'DISSAVED ~ AGE_c + AGE_c2')

print("\n--- Linear model: DISSAVED ~ AGE_c ---")
print(m_lin.summary2().tables[1].round(4).to_string())
print(f"Log-Likelihood: {m_lin.llf:.4f}")

print("\n--- Quadratic model: DISSAVED ~ AGE_c + AGE_c2 ---")
print(m_quad.summary2().tables[1].round(4).to_string())
print(f"Log-Likelihood: {m_quad.llf:.4f}")

# Likelihood-ratio test
lrt_stat = 2*(m_quad.llf - m_lin.llf)
lrt_p = stats.chi2.sf(lrt_stat, df=1)
print(f"\nLikelihood-Ratio Test (quadratic vs linear):")
print(f"  LRT statistic = {lrt_stat:.4f}, df=1, p = {lrt_p:.4f}")
print(f"  Significant at 0.05? {lrt_p < 0.05}")

# Wald test on quadratic coef
wald_z = m_quad.params['AGE_c2'] / m_quad.bse['AGE_c2']
wald_p = 2*stats.norm.sf(abs(wald_z))
print(f"Wald test on AGE_c2: z={wald_z:.4f}, p={wald_p:.4f}")

# Interpret coefficients in terms of uncentered age
# probit/logit: use marginal / predicted probabilities at age endpoints
print("\n--- Predicted P(DISSAVED=1) across age (restricted, quadratic model) ---")
for a in range(24, 33):
    ac = a - age_mean
    p_quad = m_quad.predict(pd.DataFrame({'AGE_c':[ac], 'AGE_c2':[ac**2]}))
    p_lin  = m_lin.predict(pd.DataFrame({'AGE_c':[ac]}))
    print(f"  Age {a}: P_quad={p_quad[0]:.4f}  P_lin={p_lin[0]:.4f}")

# ----------------------------------------------------------------------
# 5. Covariate-adjusted model (restricted)
# ----------------------------------------------------------------------
print("\n" + "="*70)
print("5. COVARIATE-ADJUSTED MODEL (restricted SAMESAVE=0, dedup)")
print("="*70)
df_r2 = df_r.copy()
df_r2['LOGINCOME'] = np.log(df_r2['INCOME'] + 1)
df_r2['FEMALE'] = (df_r2['GENDER']=='FEMALE').astype(int)
m_adj = fit_logit(df_r2, 'DISSAVED ~ AGE_c + AGE_c2 + LOGINCOME + FEMALE + BLACK + HISPANIC')
print(m_adj.summary2().tables[1].round(4).to_string())
print(f"Log-Likelihood: {m_adj.llf:.4f}")

# LRT quadratic within adjusted model
m_adj_lin = fit_logit(df_r2, 'DISSAGED ~ AGE_c + LOGINCOME + FEMALE + BLACK + HISPANIC') if False else \
            fit_logit(df_r2, 'DISSAVED ~ AGE_c + LOGINCOME + FEMALE + BLACK + HISPANIC')
lrt_adj = 2*(m_adj.llf - m_adj_lin.llf)
lrt_adj_p = stats.chi2.sf(lrt_adj, df=1)
print(f"\nLRT quadratic (adjusted): stat={lrt_adj:.4f}, p={lrt_adj_p:.4f}")

# ----------------------------------------------------------------------
# 6. Full-sample models (for comparison)
# ----------------------------------------------------------------------
print("\n" + "="*70)
print("6. FULL-SAMPLE MODELS (dedup, for comparison)")
print("="*70)
m_full_lin  = fit_logit(df_full_frame, 'DISSAVED ~ AGE_c')
m_full_quad = fit_logit(df_full_frame, 'DISSAVED ~ AGE_c + AGE_c2')
print("--- Quadratic (full) ---")
print(m_full_quad.summary2().tables[1].round(4).to_string())
lrt_full = 2*(m_full_quad.llf - m_full_lin.llf)
lrt_full_p = stats.chi2.sf(lrt_full, df=1)
print(f"\nLRT quadratic (full): stat={lrt_full:.4f}, p={lrt_full_p:.4f}")

# ----------------------------------------------------------------------
# 7. Odds-ratio interpretation for linear age effect
# ----------------------------------------------------------------------
print("\n" + "="*70)
print("7. EFFECT SIZE (restricted, linear model)")
print("="*70)
b_age = m_lin.params['AGE_c']
print(f"Log-odds per 1-year increase in age : {b_age:.4f}")
print(f"Odds ratio per 1-year increase      : {np.exp(b_age):.4f}")
print(f"  => each additional year multiplies odds of DISSAVED by {np.exp(b_age):.3f}")

# Age 24 vs 32 change in predicted prob (quadratic)
p24 = m_quad.predict(pd.DataFrame({'AGE_c':[24-age_mean], 'AGE_c2':[(24-age_mean)**2]}))[0]
p32 = m_quad.predict(pd.DataFrame({'AGE_c':[32-age_mean], 'AGE_c2':[(32-age_mean)**2]}))[0]
print(f"\nPredicted P(DISSAVED=1) age 24 -> age 32 (restricted, quadratic):")
print(f"  {p24:.4f} -> {p32:.4f}  (absolute change {p32-p24:+.4f})")

# Save results
desc.to_csv('output/dissaved_rate_by_age_restricted.csv')
print("\nSaved: output/dissaved_rate_by_age_restricted.csv")

# ----------------------------------------------------------------------
# 8. Robustness: HC3 robust SEs on restricted quadratic + marginal effect
# ----------------------------------------------------------------------
print("\n" + "="*70)
print("8. ROBUSTNESS CHECKS (restricted SAMESAVE=0, dedup)")
print("="*70)
m_quad_rob = smf.logit('DISSAVED ~ AGE_c + AGE_c2', data=df_r).fit(disp=0, cov_type='HC3')
print("Quadratic model with robust (HC3) SEs:")
print(m_quad_rob.summary2().tables[1].round(4).to_string())
lrt_rob = 2*(m_quad_rob.llf - m_lin.llf)  # llf unchanged by cov type
print(f"LRT (robust fit, llf-based): stat={lrt_rob:.4f}, p={stats.chi2.sf(lrt_rob,1):.4f}")

# Marginal effect of age at the mean (restricted, quadratic)
import statsmodels.api as sm
# Manual marginal effect dP/dAGE at the mean (AGE_c=0): P(1-P)*(b1+2*b2*AGE_c)
def pred_p(m, ac):
    x=pd.DataFrame({'AGE_c':[ac],'AGE_c2':[ac**2]})
    return m.predict(x)[0]
p_mean = pred_p(m_quad, 0.0)
b1=m_quad.params['AGE_c']; b2=m_quad.params['AGE_c2']
dP_dage_mean = p_mean*(1-p_mean)*(b1+2*b2*0.0)
print(f"\nMarginal effect at mean age ({age_mean:.1f}): dP/dAGE ≈ {dP_dage_mean:+.4f} (P={p_mean:.3f})")
print(f"  (i.e., ~{dP_dage_mean*100:+.2f} percentage points per additional year at the mean age)")

# Vertex of the fitted quadratic (in original age units)
a = m_quad.params['AGE_c2']; b = m_quad.params['AGE_c']
vertex_c = -b/(2*a)
print(f"\nFitted quadratic vertex at AGE_c = {vertex_c:.3f}  =>  AGE ≈ {age_mean+vertex_c:.2f}")
print(f"Quadratic coefficient sign: {'concave-down (inverted-U)' if a<0 else 'concave-up (U)'}")

# Sensitivity: does the quadratic survive if we drop the single-year age 32 (small N=144)?
df_r3 = df_r[df_r['AGE']!=32]
m_q3 = smf.logit('DISSAVED ~ AGE_c + AGE_c2', data=df_r3).fit(disp=0)
m_l3 = smf.logit('DISSAVED ~ AGE_c', data=df_r3).fit(disp=0)
lrt3 = 2*(m_q3.llf - m_l3.llf)
print(f"\nSensitivity (drop age 32): LRT quadratic p = {stats.chi2.sf(lrt3,1):.4f}; "
      f"AGE_c2 coef={m_q3.params['AGE_c2']:.4f} p={m_q3.pvalues['AGE_c2']:.4f}")
