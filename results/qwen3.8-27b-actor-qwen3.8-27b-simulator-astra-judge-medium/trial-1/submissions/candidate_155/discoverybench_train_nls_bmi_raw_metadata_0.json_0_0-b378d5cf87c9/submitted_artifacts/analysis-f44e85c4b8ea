import pandas as pd, numpy as np
import statsmodels.api as sm
from statsmodels.formula.api import ols, logit
from scipy import stats

pd.set_option('display.width', 200)
df = pd.read_csv('data/nls_raw.csv')
N = len(df)

W81 = pd.to_numeric(df['Weight of respondent, 1981'])
H85 = pd.to_numeric(df['Height of respondent, 1985'])
CAT = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
SAV_IN  = pd.to_numeric(df['Net amount respondent/spouse put into savings since last interview, 1989'])
SAV_OUT = pd.to_numeric(df['Net amount respondent/spouse took out of savings since last interview, 1989'])
AGE81 = pd.to_numeric(df['Age of respondent at interview date, 1981'])
RACE  = df['Racial/ethnic cohort, 1979']
SEX   = df['Sex of respondent, 1979']
EDU   = pd.to_numeric(df['Highest grade completed, 1979'])
INC89 = pd.to_numeric(df['Total net family income, previous calendar year, 1989'])

# ---- BMI (W81 lb, H85 in) ----
d = pd.DataFrame({
    'bmi': (W81*0.453592)/(H85*0.0254)**2,
    'cat': CAT, 'sav_in': SAV_IN, 'sav_out': SAV_OUT,
    'age81': AGE81, 'sex': SEX, 'race': RACE, 'edu': EDU, 'inc89': INC89,
    'asvab': df[[c for c in df.columns if c.startswith('ASVAB')]].mean(axis=1),
})
d['bmi_w'] = d['bmi'].clip(d['bmi'].quantile(.01), d['bmi'].quantile(.99))
d['present'] = (d['cat']==2).astype(float)          # main binary
d.loc[d['cat'].isin([1,2]), 'net'] = d.loc[d['cat'].isin([1,2]), 'sav_in'].fillna(0) - d.loc[d['cat'].isin([1,2]), 'sav_out'].fillna(0)
d.loc[d['cat'].isin([1,2]), 'slognet'] = np.sign(d.loc[d['cat'].isin([1,2]), 'net']) * np.log1p(d.loc[d['cat'].isin([1,2]), 'net'].abs())
d['loginc89'] = np.log1p(d['inc89'].fillna(0))
d['incmiss']  = d['inc89'].isna().astype(float)

print("STAGE SAMPLES")
print("BMI n:", int(d.bmi.notna().sum()))
print("BMI & CAT n:", int((d.bmi.notna() & d.cat.notna()).sum()))
print("BMI & CAT(1/2) n:", int((d.bmi.notna() & d.cat.isin([1,2])).sum()))
print("BMI & CAT & loginc89 n:", int((d.bmi.notna() & d.cat.notna() & d.inc89.notna()).sum()))

m = d.bmi.notna() & d.cat.notna()
sub = d[m].copy()
print("\nDESCRIPTIVE: BMI by savings category (all, then by sex)")
for lab, s in [('ALL', sub), ('MALE', sub[sub.sex==1]), ('FEMALE', sub[sub.sex==2])]:
    t = s.groupby('cat')['bmi'].agg(['count','mean','median','std']).round(2)
    print(lab); print(t)
ov = sub[sub.cat.isin([1,2])]
print("PUT-IN vs TOOK-OUT (main binary):")
print(ov.groupby('present')['bmi'].agg(['count','mean','median','std']).round(3))

print("\nUNIVARIATE (CAT 1 vs 2)")
g1 = ov[ov.present==0].bmi; g2 = ov[ov.present==1].bmi
tt = stats.ttest_ind(g2, g1)
pb = g2.corr(g1)
r_pb = stats.pointbiserialr(ov.present, ov.bmi)
print(f"t-test: t={tt.statistic:.2f}, p={tt.pvalue:.2e}; diff={g2.mean()-g1.mean():.2f} kg/m2")
print(f"point-biserial r={r_pb.statistic:.4f}, p={r_pb.pvalue:.2e}")
# spearman on 4-level ordinal (order: 1 put-in,3 no change,4 no savings,2 took-out)
ordm = d[m].copy(); ordm['tord'] = ordm.cat.map({1:1,3:2,4:3,2:4})
rs, ps = stats.spearmanr(ordm.tord, ordm.bmi)
print(f"Spearman (4-level ordinal vs BMI): rho={rs:.4f}, p={ps:.2e}")

def fit(formula, data, model=ols):
    res = model(formula, data=data).fit(cov_type='HC1')
    return res

print("\nMAIN OLS: bmi ~ present + covariates")
main_d = sub[sub.cat.isin([1,2])].copy()
main_d['race1'] = (main_d.race==1).astype(float); main_d['race2'] = (main_d.race==2).astype(float)
main_d['female'] = (main_d.sex==2).astype(float)
f1 = 'bmi ~ present + female + age81 + race1 + race2 + loginc89 + incmiss + edu'
res1 = fit(f1, main_d)
print(f"n={int(res1.nobs)}  R2={res1.rsquared:.4f}")
print(res1.params.round(4)); print("CI:"); print(res1.conf_int().round(4))
# standardized present coefficient
b_p = res1.params['present']
sd = main_d.bmi.std()
print(f"Std effect of present-oriented: {b_p/sd:.4f} SD of BMI; 95% CI via CI/sd")

print("\nSENSITIVITY (a): 4-level ordinal (1 put-in < 3 no-change < 4 no-savings < 2 took-out)")
sa = sub.copy(); sa['tord'] = sa.cat.map({1:1,3:2,4:3,2:4})
sa['race1']=(sa.race==1).astype(float); sa['race2']=(sa.race==2).astype(float); sa['female']=(sa.sex==2).astype(float)
res2 = fit('bmi ~ tord + female + age81 + race1 + race2 + loginc89 + incmiss + edu', sa)
print(f"n={int(res2.nobs)} coef(tord)={res2.params['tord']:.4f} CI={res2.conf_int().loc['tord'].round(4).tolist()}")

print("\nSENSITIVITY (b): continuous signed log net savings")
sb = sub[sub.slognet.notna()].copy()
sb['race1']=(sb.race==1).astype(float); sb['race2']=(sb.race==2).astype(float); sb['female']=(sb.sex==2).astype(float)
res3 = fit('bmi ~ slognet + female + age81 + race1 + race2 + loginc89 + incmiss + edu', sb)
print(f"n={int(res3.nobs)} coef(slognet)={res3.params['slognet']:.4f} CI={res3.conf_int().loc['slognet'].round(4).tolist()}")

print("\nSENSITIVITY (c): logistic BMI>=30 ~ present + covariates")
sc = main_d.copy(); sc['obese'] = (sc.bmi>=30).astype(float)
res4 = fit('obese ~ present + female + age81 + race1 + race2 + loginc89 + incmiss + edu', sc, logit)
ci = res4.conf_int().loc['present']
print('n=%d OR(present)=%.3f CI=(%.3f, %.3f)' % (int(res4.nobs), np.exp(res4.params['present']), np.exp(ci[0]), np.exp(ci[1])))

print("\nSENSITIVITY (d): main model + ASVAB composite")
sd_ = main_d[main_d.asvab.notna()].copy()
res5 = fit(f1 + ' + asvab', sd_)
print(f"n={int(res5.nobs)} coef(present)={res5.params['present']:.4f} CI={res5.conf_int().loc['present'].round(4).tolist()}")

print("\nSENSITIVITY (e): winsorized BMI (1-99%), main binary model")
se = main_d.copy()
res6 = fit('bmi_w ~ present + female + age81 + race1 + race2 + loginc89 + incmiss + edu', se)
print(f"n={int(res6.nobs)} coef(present)={res6.params['present']:.4f} CI={res6.conf_int().loc['present'].round(4).tolist()}")

print("\nSENSITIVITY (f): BMI from H81/10 (corrupted height) for comparison")
H81 = pd.to_numeric(df['Height of respondent, 1981'])
d2 = d.copy(); d2['bmi81'] = (W81*0.453592)/((H81/10)*0.0254)**2
m2 = d2.bmi81.notna() & d2.cat.isin([1,2])
s2 = d2[m2].copy()
s2['race1']=(s2.race==1).astype(float); s2['race2']=(s2.race==2).astype(float); s2['female']=(s2.sex==2).astype(float)
res7 = fit('bmi81 ~ present + female + age81 + race1 + race2 + loginc89 + incmiss + edu', s2)
print(f"n={int(res7.nobs)} coef(present)={res7.params['present']:.4f} CI={res7.conf_int().loc['present'].round(4).tolist()}")
