#!/usr/bin/env python3
"""
Sparse / noisy compact-star (cold white-dwarf) sequence reconstruction.
Outputs (results/): mr_reconstruction.csv, profiles_reconstruction.npz,
summary.json, reconstruction_plot.png

MASS-RADIUS MODEL (primary): R(M) = K*M^(-1/3)*(1-(M/Mmax)^2)^(1/2)
  M^(-1/3): non-relativistic degenerate (n=3/2) limit; (1-(M/Mmax)^2)^1/2:
  relativistic bend-over, R->0 at M=Mmax, R~(Mmax-M)^1/2 near the limit.
  K,Mmax fit by weighted LS (w=1/sigma_radius). CHOICE NOTE: a 3-param variant
  R=K*M^(-a)*(1-(M/Mmax)^2)^1/2 fits marginally better (chi2~6 vs ~11, Mmax
  ~1.378 vs 1.353); we keep the physical a=1/3 form as PRIMARY. The
  (1-(M/Mmax)^(4/3))^1/2 form (Mmax~1.44) is rejected by the data.

INTERNAL PROFILES (single family): rho/rho_c=(1-(r/R)^p)^q, p(M)=p0+p1*M,
q(M)=q0+q1*M (linear in M). Fragments are far more centrally concentrated than
any Lane-Emden polytrope n=0..4, so (1-(r/R)^p)^q is the right family (fits at
noise level). p(M),q(M) fitted jointly over all fragment density points ->
smooth/conservative mass-dependence; 1.3 Msun is a mild linear extrapolation.
enclosed_mass_fraction=M(r)/M from integrating 4*pi*r^2*rho (self-consistent,
M(R)/M=1). Surface threshold 1e-4 reached just inside r/R=1 (consistent).
"""
import json, os
import numpy as np
import pandas as pd
from scipy.optimize import least_squares

DATA, OUT = "data", "results"
os.makedirs(OUT, exist_ok=True)

mr = pd.read_csv(f"{DATA}/mr_observations.csv")
prof = pd.read_csv(f"{DATA}/profile_fragments.csv")
qt = json.load(open(f"{DATA}/query_targets.json"))
mani = json.load(open(f"{DATA}/physics_manifest.json"))

M_obs = mr["mass_solar_obs"].to_numpy(float)
R_obs = mr["radius_km_obs"].to_numpy(float)
sR    = mr["sigma_radius_km"].to_numpy(float)
mr_eval   = np.asarray(qt["mr_eval_masses_solar"], float)
prof_mass = np.asarray(qt["profile_target_masses_solar"], float)
rgrid     = np.asarray(qt["radius_fraction_grid"], float)
Ngrid = len(rgrid)
SURF = float(mani.get("surface_threshold", 1e-4))

# 1. M-R reconstruction (primary a=1/3)
def mr2(M,K,Mmax): return K*M**(-1/3)*np.sqrt(np.clip(1-(M/Mmax)**2,0,None))
def mr3(M,K,a,Mmax): return K*M**(-a)*np.sqrt(np.clip(1-(M/Mmax)**2,0,None))
s2 = least_squares(lambda x:(R_obs-mr2(M_obs,*x))/sR, x0=[8000,1.35], bounds=([1,0.9],[1e6,2.0]))
K, Mmax = (float(v) for v in s2.x)
chi2_2p = float(np.sum(((R_obs-mr2(M_obs,K,Mmax))/sR)**2))
s3 = least_squares(lambda x:(R_obs-mr3(M_obs,*x))/sR, x0=[7800,0.34,1.38], bounds=([1,0.25,1.2],[1e6,0.5,2.0]))
a3, Mmax3 = float(s3.x[1]), float(s3.x[2])
chi2_3p = float(np.sum(((R_obs-mr3(M_obs,*s3.x))/sR)**2))
R_model = mr2

# fine grid, augmented with exact holdout + observed masses (lookup robustness)
M_grid = np.unique(np.concatenate([np.linspace(0.20, Mmax, 400), mr_eval, M_obs]))
M_grid = M_grid[(M_grid>=0.20)&(M_grid<=Mmax)]
R_grid = R_model(M_grid, K, Mmax)
for i in range(1,len(R_grid)): R_grid[i]=min(R_grid[i],R_grid[i-1])
pd.DataFrame({"mass_solar":M_grid,"radius_km":R_grid}).to_csv(f"{OUT}/mr_reconstruction.csv",index=False)

def R_at(m): return float(R_model(np.array([m]),K,Mmax)[0])
summary = {"mass_limit_solar":Mmax,"radius_at_0p6Msun_km":R_at(0.6),
           "radius_at_1p0Msun_km":R_at(1.0),"radius_at_1p2Msun_km":R_at(1.2),
           "radius_at_1p3Msun_km":R_at(1.3)}
json.dump(summary, open(f"{OUT}/summary.json","w"), indent=2)

# 2. internal profiles  (JOINT fit: density AND derived mass fraction)
#    Both channels are independent noisy views of ONE profile; the mass fraction
#    is a deterministic functional of the density, so we fit p(M),q(M) to the
#    combined chi2. This keeps density and M(r)/M self-consistent and matches the
#    observed mass-concentration trend (half-mass radius decreases with mass).
dxs,dys,dss,dM=[],[],[],[]; mxs,mys,mss,mM2=[],[],[],[]
for _,r in prof.iterrows():
    m=r["target_mass_solar"]; x=r["radius_fraction"]
    if r["density_fraction_obs"] is not None and not np.isnan(r["density_fraction_obs"]):
        dxs.append(x); dys.append(r["density_fraction_obs"])
        dss.append(r["sigma_density_fraction"]); dM.append(m)
    if r["enclosed_mass_fraction_obs"] is not None and not np.isnan(r["enclosed_mass_fraction_obs"]):
        mxs.append(x); mys.append(r["enclosed_mass_fraction_obs"])
        mss.append(r["sigma_enclosed_mass_fraction"]); mM2.append(m)
dxs,dys,dss,dM=map(np.array,(dxs,dys,dss,dM)); dM=dM.astype(float)
mxs,mys,mss,mM2=map(np.array,(mxs,mys,mss,mM2)); mM2=mM2.astype(float)
def dens(x,p,q): return (1.0-np.clip(x,0,1)**p)**q
FINE=2001; xf=np.linspace(0,1,FINE)
def mfrac(p,q):
    rho=dens(xf,p,q); dV=4*np.pi*xf**2*rho
    Mf_=np.concatenate([[0.0],np.cumsum(0.5*(dV[1:]+dV[:-1])*np.diff(xf))]); return Mf_/Mf_[-1]
def pres(th):
    p0,p1,q0,q1=th
    r1=(dys-dens(dxs,p0+p1*dM,q0+q1*dM))/dss
    uniq=np.unique(mM2); mfc={m:mfrac(p0+p1*m,q0+q1*m) for m in uniq}
    r2=np.array([(mys[i]-np.interp(mxs[i],xf,mfc[mM2[i]]))/mss[i] for i in range(len(mxs))])
    return np.concatenate([r1,r2])
sp=least_squares(pres,x0=[1.7,-0.3,1.8,1.4],bounds=([0.5,-1.5,1.0,-2.0],[3.0,1.5,6.0,4.0]))
p0,p1,q0,q1=(float(v) for v in sp.x)
chi2_prof=float(np.sum(pres(sp.x)**2))
pM=lambda m: float(p0+p1*m); qM=lambda m: float(q0+q1*m)
for m in np.unique(np.concatenate([dM,mM2,prof_mass])):
    assert pM(m)>0 and qM(m)>0, f"unphysical p/q at M={m}"

dens_arr=np.zeros((len(prof_mass),Ngrid)); mass_arr=np.zeros_like(dens_arr)
FINE2=4001; xf2=np.linspace(0,1,FINE2)
for i,m in enumerate(prof_mass):
    p,q=pM(m),qM(m); rho=dens(xf2,p,q); dV=4*np.pi*xf2**2*rho
    Mf_=np.concatenate([[0.0],np.cumsum(0.5*(dV[1:]+dV[:-1])*np.diff(xf2))]); Mf_/=Mf_[-1]
    dens_arr[i]=np.interp(rgrid,xf2,rho); mass_arr[i]=np.interp(rgrid,xf2,Mf_)
dens_arr[:,0]=1.0; mass_arr[:,0]=0.0; mass_arr[:,-1]=1.0
np.savez(f"{OUT}/profiles_reconstruction.npz", density_fraction=dens_arr,
         enclosed_mass_fraction=mass_arr, masses=prof_mass, radius_fraction=rgrid)

print("=== M-R (a=1/3) === K=%.2f Mmax=%.4f chi2=%.2f"%(K,Mmax,chi2_2p))
print("    [3p cross-check] a=%.4f Mmax=%.4f chi2=%.2f"%(a3,Mmax3,chi2_3p))
print("    holdout km:",{k:round(v,1) for k,v in summary.items() if k!='mass_limit_solar'})
print("=== profiles JOINT fit p0,p1,q0,q1 = %.3f,%.3f,%.3f,%.3f  chi2=%.1f ==="%(p0,p1,q0,q1,chi2_prof))
for i,m in enumerate(prof_mass):
    hm=float(np.interp(0.5,mass_arr[i],rgrid))   # r/R where M/M=0.5
    print("    M=%.1f p=%.3f q=%.3f half-mass r/R=%.3f dens(0.5)=%.3f mf(0.5)=%.3f"
          %(m,pM(m),qM(m),hm,dens_arr[i,Ngrid//2],mass_arr[i,Ngrid//2]))
print("    shapes dens",dens_arr.shape,"mass",mass_arr.shape,"mr",M_grid.shape,"Ngrid",Ngrid)
print("    (Ngrid=%d: columns match radius_fraction_grid exactly)"%Ngrid)

# 4. PLOT (hand-rolled PNG - no matplotlib/PIL in runtime)
import zlib, struct
def write_png(path,a):
    h,w,_=a.shape; raw=b"".join(b"\x00"+a[y].tobytes() for y in range(h))
    def ch(t,d): return struct.pack(">I",len(d))+t+d+struct.pack(">I",zlib.crc32(t+d)&0xffffffff)
    open(path,"wb").write(b"\x89PNG\r\n\x1a\n"+ch(b"IHDR",struct.pack(">IIBBBBB",w,h,8,2,0,0,0))+ch(b"IDAT",zlib.compress(raw,9))+ch(b"IEND",b""))
FONT={
'0':["01110","10001","10011","10101","11001","10001","01110"],'1':["00100","01100","00100","00100","00100","00100","01110"],
'2':["01110","10001","00001","00010","00100","01000","11111"],'3':["11111","00010","00100","00010","00001","10001","01110"],
