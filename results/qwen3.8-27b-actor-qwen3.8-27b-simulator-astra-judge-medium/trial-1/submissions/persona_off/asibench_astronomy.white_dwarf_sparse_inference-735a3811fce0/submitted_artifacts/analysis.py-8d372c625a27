'K':["10001","10010","10100","11000","10100","10010","10001"],'L':["10000","10000","10000","10000","10000","10000","11111"],
'M':["10001","11011","10101","10101","10001","10001","10001"],'N':["10001","11001","10101","10011","10001","10001","10001"],
'O':["01110","10001","10001","10001","10001","10001","01110"],'P':["11110","10001","10001","11110","10000","10000","10000"],
'Q':["01110","10001","10001","10001","10101","10010","01101"],'R':["11110","10001","10001","11110","10100","10010","10001"],
'S':["01111","10000","10000","01110","00001","00001","11110"],'T':["11111","00100","00100","00100","00100","00100","00100"],
'U':["10001","10001","10001","10001","10001","10001","01110"],'V':["10001","10001","10001","10001","10001","01010","00100"],
'W':["10001","10001","10001","10101","10101","10101","01010"],'X':["10001","10001","01010","00100","01010","10001","10001"],
'Y':["10001","10001","01010","00100","00100","00100","00100"],'Z':["11111","00001","00010","00100","01000","10000","11111"],
' ':["00000","00000","00000","00000","00000","00000","00000"],'.':["00000","00000","00000","00000","00000","01100","01100"],
'-':["00000","00000","00000","11111","00000","00000","00000"],'/':["00001","00010","00010","00100","01000","01000","10000"],
'(':["00010","00100","01000","01000","01000","00100","01000"],')':["01000","00100","00010","00010","00010","00100","01000"],
':':["00000","01100","01100","00000","01100","01100","00000"],'+':["00000","00100","00100","11111","00100","00100","00000"]}
W,H=1280,760; img=np.full((H,W,3),255,np.uint8)
def put(x,y,c):
    if 0<=x<W and 0<=y<H: img[y,x]=c
def block(x,y,w,h,c):
    for yy in range(y,y+h):
        for xx in range(x,x+w): put(xx,yy,c)
def line(x0,y0,x1,y1,c,th=2):
    n=int(max(abs(x1-x0),abs(y1-y0)))+1
    for i in range(n+1):
        t=i/n; x=x0+(x1-x0)*t; y=y0+(y1-y0)*t
        for d in range(th): put(int(x)+d//2,int(y),c)
def dashed(x0,y0,x1,y1,c,th=2,gap=10):
    L=np.hypot(x1-x0,y1-y0); k=0
    while k<L:
        a=min(k+gap,L); b=min(k+2*gap,L)
        line(x0+(x1-x0)*a/L,y0+(y1-y0)*a/L,x0+(x1-x0)*b/L,y0+(y1-y0)*b/L,c,th); k+=2*gap
def text(x,y,s,c,scale=1):
    for ch in str(s).upper():
        g=FONT.get(ch,FONT[' '])
        for rr,row in enumerate(g):
            for cc,b in enumerate(row):
                if b=='1': block(x+cc*scale,y+rr*scale,scale,scale,c)
        x+=6*scale
def text_c(cx,y,s,c,scale=1):
    text(cx-len(str(s))*6*scale//2,y,s,c,scale)
def dot(x,y,r,c):
    for yy in range(int(y-r),int(y+r+1)):
        for xx in range(int(x-r),int(x+r+1)):
            if (xx-x)**2+(yy-y)**2<=r*r: put(xx,yy,c)
BLACK=(0,0,0); BLUE=(30,100,220); RED=(220,40,40); GREEN=(20,150,70); GRAY=(160,160,160); ORANGE=(220,110,20)
text_c(W//2,16,"COMPACT-STAR M-R RECONSTRUCTION  AND  INTERNAL PROFILES",BLACK,2)
# LEFT PANEL: M-R
lx0,lx1,ly0,ly1=100,600,90,650; Mlo,Mhi,Rlo,Rhi=0.2,1.4,0,13000
X=lambda M: lx0+(M-Mlo)/(Mhi-Mlo)*(lx1-lx0); Y=lambda R: ly1-(R-Rlo)/(Rhi-Rlo)*(ly1-ly0)
for (a,b,c,d) in [(lx0,ly0,lx1,ly0),(lx0,ly1,lx1,ly1),(lx0,ly0,lx0,ly1),(lx1,ly0,lx1,ly1)]: line(a,b,c,d,BLACK,2)
for M in np.arange(0.2,1.41,0.2):
    line(int(X(M)),ly1,int(X(M)),ly1+6,GRAY,1); text_c(int(X(M)),ly1+10,"%.1f"%M,BLACK,1)
for R in range(0,13001,2000):
    line(lx0-6,int(Y(R)),lx0,int(Y(R)),GRAY,1); text(lx0-80,int(Y(R))-7,str(R),BLACK,1)
pts=[(int(X(m)),int(Y(r))) for m,r in zip(M_grid,R_grid)]
for i in range(len(pts)-1): line(pts[i][0],pts[i][1],pts[i+1][0],pts[i+1][1],BLUE,2)
for m,r,s in zip(M_obs,R_obs,sR):
    line(int(X(m)),int(Y(r-s)),int(X(m)),int(Y(r+s)),RED,1)
    line(int(X(m))-4,int(Y(r-s)),int(X(m))+4,int(Y(r-s)),RED,1)
    line(int(X(m))-4,int(Y(r+s)),int(X(m))+4,int(Y(r+s)),RED,1); dot(int(X(m)),int(Y(r)),4,RED)
for m in mr_eval: dot(int(X(m)),int(Y(R_at(m))),3,GREEN)
text_c((lx0+lx1)//2,ly1+44,"MASS (MSUN)",BLACK,1)
text(lx0-160,(ly0+ly1)//2-40,"RADIUS (KM)",BLACK,1)
text_c((lx0+lx1)//2,ly0-26,"MASS-RADIUS SEQUENCE",BLACK,1)
lgx,lgy=lx1-158,ly0+14
line(lgx,lgy,lgx+26,lgy,BLUE,2); text(lgx+32,lgy-7,"MODEL",BLACK,1)
dot(lgx+13,lgy+22,4,RED); text(lgx+32,lgy+15,"DATA",BLACK,1)
dot(lgx+13,lgy+44,3,GREEN); text(lgx+32,lgy+37,"HOLDOUT",BLACK,1)
# RIGHT PANEL: profiles
rx0,rx1,ry0,ry1=740,1240,90,650; FHI=1.05
PX=lambda x: rx0+x*(rx1-rx0); PY=lambda f: ry1-f/FHI*(ry1-ry0)
for (a,b,c,d) in [(rx0,ry0,rx1,ry0),(rx0,ry1,rx1,ry1),(rx0,ry0,rx0,ry1),(rx1,ry0,rx1,ry1)]: line(a,b,c,d,BLACK,2)
for x in np.arange(0,1.01,0.2):
    line(int(PX(x)),ry1,int(PX(x)),ry1+6,GRAY,1); text_c(int(PX(x)),ry1+10,"%.1f"%x,BLACK,1)
for f in np.arange(0,1.01,0.2):
    line(rx0-6,int(PY(f)),rx0,int(PY(f)),GRAY,1); text(rx0-80,int(PY(f))-7,"%.1f"%f,BLACK,1)
cols=[BLUE,ORANGE,GREEN]
for i,(m,c) in enumerate(zip(prof_mass,cols)):
    dp=[(int(PX(x)),int(PY(d))) for x,d in zip(rgrid,dens_arr[i])]
    mp=[(int(PX(x)),int(PY(v))) for x,v in zip(rgrid,mass_arr[i])]
    for j in range(len(dp)-1): line(dp[j][0],dp[j][1],dp[j+1][0],dp[j+1][1],c,2)
    for j in range(len(mp)-1): dashed(mp[j][0],mp[j][1],mp[j+1][0],mp[j+1][1],c,2)
text_c((rx0+rx1)//2,ry1+44,"R / R",BLACK,1)
text(rx0-160,(ry0+ry1)//2-20,"FRACTION",BLACK,1)
text_c((rx0+rx1)//2,ry0-26,"NORMALIZED PROFILES",BLACK,1)
lgx,lgy=rx1-158,ry0+14
line(lgx,lgy,lgx+26,lgy,BLUE,2); text(lgx+32,lgy-7,"M=0.6",BLACK,1)
line(lgx,lgy+22,lgx+26,lgy+22,ORANGE,2); text(lgx+32,lgy+15,"M=1.0",BLACK,1)
line(lgx,lgy+44,lgx+26,lgy+44,GREEN,2); text(lgx+32,lgy+37,"M=1.3",BLACK,1)
text(lgx-30,lgy+72,"SOLID=DENS",BLACK,1); text(lgx-30,lgy+88,"DASH=MASS",BLACK,1)
write_png(f"{OUT}/reconstruction_plot.png",img)
print("wrote results/reconstruction_plot.png (%dx%d)"%(W,H)); print("DONE")
