def _put(img, x, y, color):
    if 0 <= y < img.shape[0] and 0 <= x < img.shape[1]:
        img[y, x] = color


def _text(img, x, y, s, color, sc=2):
    cx = x
    for ch in s:
        g = FONT.get(ch, FONT[' '])
        for ry in range(7):
            row = g[ry]
            for rx in range(5):
                if (row >> (4 - rx)) & 1:
                    for sy in range(sc):
                        for sx in range(sc):
                            _put(img, cx + rx * sc + sx, y + ry * sc + sy, color)
        cx += 6 * sc


def _line(img, x1, y1, x2, y2, color, w=1):
    x1, y1, x2, y2 = int(x1), int(y1), int(x2), int(y2)
    steps = max(abs(x2 - x1), abs(y2 - y1), 1)
    for k in range(steps + 1):
        x = x1 + (x2 - x1) * k / steps
        y = y1 + (y2 - y1) * k / steps
        for oy in range(w):
            for ox in range(w):
                _put(img, int(round(x)) + ox, int(round(y)) + oy, color)


def _rect(img, x, y, w, h, color):
    _line(img, x, y, x + w, y, color)
    _line(img, x, y + h, x + w, y + h, color)
    _line(img, x, y, x, y + h, color)
    _line(img, x + w, y, x + w, y + h, color)


def _panel(img, x0, y0, W, H, title, xlabel, ylabel, series, xf, yf, xlim, ylim):
    ml, mr, mt, mb = 58, 14, 34, 44
    ax, ay = x0 + ml, y0 + mt
    aw, ah = W - ml - mr, H - mt - mb
    _rect(img, ax, ay, aw, ah, (60, 60, 60))
    xr = xf(xlim[-1]) - xf(xlim[0]); yr = yf(ylim[-1]) - yf(ylim[0])
    for xv in xlim:
        px = ax + (xf(xv) - xf(xlim[0])) / xr * aw
        _line(img, px, ay + ah, px, ay + ah + 5, (60, 60, 60))
        lab = ("%.2f" % xv) if (xlim[-1] - xlim[0]) < 2 else ("%d" % int(round(xf(xv))))
        _text(img, int(px) - len(lab) * 3, ay + ah + 7, lab, (60, 60, 60), 2)
    for yv in ylim:
        py = ay + ah - (yf(yv) - yf(ylim[0])) / yr * ah
        _line(img, ax, py, ax - 5, py, (60, 60, 60))
        lab = ("%.2f" % yv) if (ylim[-1] - ylim[0]) < 2 else ("%d" % int(round(yf(yv))))
        _text(img, ax - 8 - len(lab) * 6, int(py) - 3, lab, (60, 60, 60), 2)
    for (xs, ys, color) in series:
        for k in range(len(xs) - 1):
            if np.isnan(xs[k]) or np.isnan(xs[k + 1]) or np.isnan(ys[k]) or np.isnan(ys[k + 1]):
                continue
            px1 = ax + (xf(xs[k]) - xf(xlim[0])) / xr * aw
            py1 = ay + ah - (yf(ys[k]) - yf(ylim[0])) / yr * ah
            px2 = ax + (xf(xs[k + 1]) - xf(xlim[0])) / xr * aw
            py2 = ay + ah - (yf(ys[k + 1]) - yf(ylim[0])) / yr * ah
            _line(img, px1, py1, px2, py2, color, 1)
    _text(img, x0 + W // 2 - len(title) * 3, y0 + 6, title, (0, 0, 0), 2)
    _text(img, x0 + W // 2 - len(xlabel) * 3, y0 + H - 12, xlabel, (0, 0, 0), 2)
    _text(img, x0 + 2, y0 + mt - 20, ylabel, (0, 0, 0), 2)


def _write_png(path, img):
    h, w, _ = img.shape
    raw = b''.join(b'\x00' + img[y].tobytes() for y in range(h))

    def chunk(t, d):
        return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)

    open(path, 'wb').write(b'\x89PNG\r\n\x1a\n' +
                           chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)) +
                           chunk(b'IDAT', zlib.compress(raw, 9)) + chunk(b'IEND', b''))


