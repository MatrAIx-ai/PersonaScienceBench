"""
Cellular signaling dynamics from channel-level kinetic data (B3).

Hybrid stochastic-deterministic simulation of the De Young-Keizer / Li-Rinzel
IP3 receptor coupled to the cytosol/ER calcium balance, per the public contract
in data/system_info.json.

- Channel: 3 subunits x 8 states (s = 4k + 2j + i).  A channel conducts iff all
  three subunits are simultaneously in state 3 (i=1, j=1, k=0).
- Subunits are independent continuous-time Markov chains given (Ca_cyt, IP3);
  each sub-step they are propagated exactly over dt_sub via P = expm(Q dt_sub).
- Calcium: 2-compartment closed system, Ca_cyt + c1*Ca_lum = c0.
  dCa_cyt/dt = (rate_ch*p_open + rate_leak)*(Ca_lum - Ca_cyt) - Vmax*Ca_cyt^2/(Km^2+Ca_cyt^2)
  dCa_lum/dt = -dCa_cyt/dt / c1,  integrated with RK4 (p_open held constant/step).

Outputs (written to the current working directory):
  simulate.py, ca_traces.npz, summary_stats.json, calcium_summary.png
"""
import json
import struct
import zlib
import numpy as np
from scipy.linalg import expm
from scipy.signal import find_peaks

# ---------------------------------------------------------------------------
# Load the public contract and the scan specification
# ---------------------------------------------------------------------------
with open("data/system_info.json") as f:
    sysinfo = json.load(f)
with open("data/scan_spec.json") as f:
    scan = json.load(f)

_bi = sysinfo["receptor_kinetics"]["binding_interactions"]
_A = {b["idx"]: b["forward_rate"] for b in _bi}
_KD = {b["idx"]: b["equilibrium_kd"] for b in _bi}
a1, d1 = _A[1], _A[1] * _KD[1]
a2, d2 = _A[2], _A[2] * _KD[2]
a3, d3 = _A[3], _A[3] * _KD[3]
a4, d4 = _A[4], _A[4] * _KD[4]
a5, d5 = _A[5], _A[5] * _KD[5]

c1 = sysinfo["compartment"]["volume_ratio_lumen_to_cyt"]
c0 = sysinfo["compartment"]["total_free_ca_micromolar"]
_cf = sysinfo["channel_flux_and_pump"]
rate_ch = _cf["max_channel_flux_rate_per_second"]
rate_leak = _cf["lumen_leak_rate_per_second"]
Vmax = _cf["reuptake_vmax_micromolar_per_second"]
Km = _cf["reuptake_km_micromolar"]
Km2 = Km * Km
ca_cyt_init = sysinfo["initial_conditions_hint"]["ca_cyt_initial_micromolar"]

ip3s = list(scan["ip3_levels_micromolar"])
Ns = list(scan["channel_counts"])
n_rep = int(scan["n_replicates"])
T_obs = float(scan["T_obs_seconds"])
dt_out = float(scan["dt_out_seconds"])
n_samples = int(round(T_obs / dt_out))

DT_SUB = 0.005
BASE_SEED = 20240517


def flip_rates(Ca, IP3):
    r_i = np.empty(8); r_j = np.empty(8); r_k = np.empty(8)
    for s in range(8):
        i = s & 1; j = (s >> 1) & 1; k = (s >> 2) & 1
        r_i[s] = (a1 if k == 0 else a3) * IP3 if i == 0 else (d1 if k == 0 else d3)
        r_j[s] = a5 * Ca if j == 0 else d5
        r_k[s] = (a4 if i == 0 else a2) * Ca if k == 0 else (d4 if i == 0 else d2)
    return r_i, r_j, r_k


def build_Q(Ca, IP3):
    r_i, r_j, r_k = flip_rates(Ca, IP3)
    Q = np.zeros((8, 8))
    for s in range(8):
        Q[s, s ^ 1] = r_i[s]
        Q[s, s ^ 2] = r_j[s]
        Q[s, s ^ 4] = r_k[s]
        Q[s, s] = -(r_i[s] + r_j[s] + r_k[s])
    return Q


def simulate(N, IP3, seed):
    rng = np.random.default_rng(seed)
    Ca_cyt = ca_cyt_init
    Ca_lum = (c0 - Ca_cyt) / c1
    nsub = 3 * N
    S = np.zeros(nsub, dtype=np.int64)
    nsteps = int(round(T_obs / DT_SUB))
    out_every = int(round(dt_out / DT_SUB))
    out = np.empty(n_samples, dtype=np.float64)
    p_open_sum = 0.0
    cons_err = 0.0
    oi = 0
    for step in range(nsteps):
        S3 = S.reshape(N, 3)
        O = int(np.count_nonzero((S3 == 3).all(axis=1)))
        p_open = O / N
        p_open_sum += p_open * DT_SUB
        u, v = Ca_cyt, Ca_lum
        def F(uu, vv):
            return rate_ch * p_open * (vv - uu) + rate_leak * (vv - uu) - Vmax * uu * uu / (Km2 + uu * uu)
        f1 = F(u, v);                       k1u = f1;  k1v = -f1 / c1
        f2 = F(u + 0.5 * DT_SUB * k1u, v + 0.5 * DT_SUB * k1v); k2u = f2;  k2v = -f2 / c1
        f3 = F(u + 0.5 * DT_SUB * k2u, v + 0.5 * DT_SUB * k2v); k3u = f3;  k3v = -f3 / c1
        f4 = F(u + DT_SUB * k3u, v + DT_SUB * k3v);             k4u = f4;  k4v = -f4 / c1
        Ca_cyt = u + DT_SUB / 6.0 * (k1u + 2 * k2u + 2 * k3u + k4u)
        Ca_lum = v + DT_SUB / 6.0 * (k1v + 2 * k2v + 2 * k3v + k4v)
        err = abs(Ca_cyt + c1 * Ca_lum - c0) / c0
        if err > cons_err:
            cons_err = err
        P = expm(build_Q(Ca_cyt, IP3) * DT_SUB)
        cumP = np.cumsum(P, axis=1)
        cumP[:, -1] = 1.0
        uu = rng.random(nsub)
        S = np.argmax(cumP[S] >= uu[:, None], axis=1)
        if step % out_every == 0:
            out[oi] = Ca_cyt
            oi += 1
    return out, p_open_sum / T_obs, cons_err


# ---------------------------------------------------------------------------
# Run the full grid
# ---------------------------------------------------------------------------
ca = {}; popen = {}; cons = {}
for i, ip3 in enumerate(ip3s):
    for j, N in enumerate(Ns):
        key = "ip3%d_N%d" % (i, j)
        rc = np.empty((n_rep, n_samples), dtype=np.float64)
        rp = np.empty(n_rep); ce = np.empty(n_rep)
        for r in range(n_rep):
            seed = BASE_SEED + i * 100000 + j * 100 + r
            rc[r], rp[r], ce[r] = simulate(N, ip3, seed)
        ca[key] = rc; popen[key] = rp; cons[key] = ce
        print("done %-9s p_open_mean=%.5f cons_err=%.2e" % (key, rp.mean(), ce.max()))

# ---------------------------------------------------------------------------
# Peak / ISI helpers (robust for relaxation oscillations)
# ---------------------------------------------------------------------------
def isis_of(trace, dt_out):
    rng_ = trace.max() - trace.min()
    if rng_ <= 0:
        return None
    pk, _ = find_peaks(trace, prominence=0.3 * rng_)
    if len(pk) < 2:
        return None
    return np.diff(pk) * dt_out


def pooled_isis(key):
    out = []
    for r in range(n_rep):
        isi = isis_of(ca[key][r], dt_out)
        if isi is not None:
            out.extend(isi.tolist())
    return out


j_max = Ns.index(max(Ns))
period_vs_ip3 = []
for i in range(len(ip3s)):
    isis = pooled_isis("ip3%d_N%d" % (i, j_max))
    period_vs_ip3.append(float(np.median(isis)) if len(isis) >= 1 else None)


def total_isis(idx):
    return sum(len(pooled_isis("ip3%d_N%d" % (idx, j))) for j in range(len(Ns)))

cr_ip3_idx_used = max([0, 1], key=total_isis)

cv_isi_vs_N = []
for j in range(len(Ns)):
    isis = pooled_isis("ip3%d_N%d" % (cr_ip3_idx_used, j))
    cv_isi_vs_N.append(float(np.std(isis, ddof=1) / np.mean(isis)) if len(isis) >= 2 else None)

p_open_vs_ip3 = [float(popen["ip3%d_N%d" % (i, j_max)].mean()) for i in range(len(ip3s))]
conservation_error_max = float(max(cons["ip3%d_N%d" % (i, j)].max()
                                   for i in range(len(ip3s)) for j in range(len(Ns))))

# ---------------------------------------------------------------------------
# Write ca_traces.npz and summary_stats.json
# ---------------------------------------------------------------------------
np.savez("ca_traces.npz", **{k: ca[k] for k in ca})


def _clean(x):
    if x is None:
        return None
    if isinstance(x, float) and (np.isnan(x) or np.isinf(x)):
        return None
    return x


summary = {
    "ip3_levels": ip3s,
    "channel_counts": Ns,
    "period_vs_ip3": [_clean(v) for v in period_vs_ip3],
    "cv_isi_vs_N": [_clean(v) for v in cv_isi_vs_N],
    "p_open_vs_ip3": [_clean(v) for v in p_open_vs_ip3],
    "conservation_error_max": _clean(conservation_error_max),
    "cr_ip3_idx_used": int(cr_ip3_idx_used),
}
with open("summary_stats.json", "w") as f:
    json.dump(summary, f, indent=2)

# ===========================================================================
# Diagnostic figure (4 panels).  Primary path uses matplotlib (Agg); a
# self-contained pure-Python PNG writer is used as a fallback so the script
# still produces calcium_summary.png if matplotlib is unavailable.
# ===========================================================================
def _figure_data():
    t = np.arange(n_samples) * dt_out
    i_rep, j_rep = 2, 2
    return {
        "t": t,
        "trace": ca["ip3%d_N%d" % (i_rep, j_rep)],
        "ip3_rep": ip3s[i_rep], "N_rep": Ns[j_rep],
        "ip3s": np.array(ip3s), "Nlog": np.log10(np.array(Ns, float)),
        "period": np.array([np.nan if v is None else v for v in period_vs_ip3]),
        "cv": np.array([np.nan if v is None else v for v in cv_isi_vs_N]),
        "popen": np.array(p_open_vs_ip3),
        "cr_idx": cr_ip3_idx_used, "Nmax": max(Ns),
        "cons": conservation_error_max,
    }


def _figure_matplotlib(d):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(2, 2, figsize=(12, 9))
    ax = axes[0, 0]
    for r in range(n_rep):
        ax.plot(d["t"], d["trace"][r], lw=0.8, label="rep %d" % r)
    ax.set_title("Representative Ca_cyt trace\nIP3=%.4f uM, N=%d" % (d["ip3_rep"], d["N_rep"]))
    ax.set_xlabel("time (s)"); ax.set_ylabel("Ca_cyt (uM)"); ax.legend()
    ax = axes[0, 1]
    ax.plot(d["ip3s"], d["period"], "o-", color="tab:blue")
    ax.set_title("Period vs IP3 (N=%d)" % d["Nmax"])
    ax.set_xlabel("IP3 (uM)"); ax.set_ylabel("period (s)")
    ax.set_yscale("log", nonpositive="mask")
    ax = axes[1, 0]
    ax.plot(d["Nlog"], d["cv"], "s-", color="tab:red")
    ax.set_xticks(np.log10(np.array(Ns, float)))
    ax.set_xticklabels([str(n) for n in Ns])
    ax.set_title("CV of ISI vs N (IP3 idx %d, %.4f uM)" % (d["cr_idx"], ip3s[d["cr_idx"]]))
    ax.set_xlabel("channel count N"); ax.set_ylabel("CV (std/mean)")
    ax = axes[1, 1]
    ax.plot(d["ip3s"], d["popen"], "^-", color="tab:green")
    ax.set_title("Time-averaged open fraction vs IP3 (N=%d)" % d["Nmax"])
    ax.set_xlabel("IP3 (uM)"); ax.set_ylabel("p_open")
    fig.suptitle("IP3R calcium oscillation diagnostics (conservation max err %.1e)" % d["cons"])
    fig.tight_layout()
    fig.savefig("calcium_summary.png", dpi=130)


