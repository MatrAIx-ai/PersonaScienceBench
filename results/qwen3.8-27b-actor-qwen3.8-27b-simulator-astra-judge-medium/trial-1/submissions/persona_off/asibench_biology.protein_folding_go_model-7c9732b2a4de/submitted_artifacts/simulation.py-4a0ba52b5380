class Canvas:
    """Minimal RGB raster with line/rect/dot/text primitives and PNG export."""

    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.px = np.full((h, w, 3), bg, dtype=np.uint8)

    def _fr(self, x0, y0, x1, y1, c):
        x0 = max(0, int(x0)); y0 = max(0, int(y0))
        x1 = min(self.w, int(x1)); y1 = min(self.h, int(y1))
        if x1 > x0 and y1 > y0:
            self.px[y0:y1, x0:x1] = c

    def rect(self, x0, y0, x1, y1, c, fill=False):
        if fill:
            self._fr(x0, y0, x1, y1, c)
        else:
            self._fr(x0, y0, x1, y0 + 1, c)
            self._fr(x0, y1 - 1, x1, y1, c)
            self._fr(x0, y0, x0 + 1, y1, c)
            self._fr(x1 - 1, y0, x1, y1, c)

    def line(self, x0, y0, x1, y1, c, t=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        n = max(abs(x1 - x0), abs(y1 - y0), 1)
        tt = np.linspace(0.0, 1.0, n)
        for s in tt:
            x = x0 + (x1 - x0) * s
            y = y0 + (y1 - y0) * s
            self._fr(x - t / 2, y - t / 2, x + t / 2 + 1, y + t / 2 + 1, c)

    def vline(self, x, y0, y1, c, t=1, dash=6):
        y0, y1 = int(y0), int(y1)
        while y0 < y1:
            y1s = min(y0 + dash, y1)
            self.line(x, y0, x, y1s, c, t)
            y0 = y1s + dash

    def dot(self, x, y, r, c):
        X, Y = int(x), int(y)
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                if dx * dx + dy * dy <= r * r and 0 <= Y + dy < self.h and 0 <= X + dx < self.w:
                    self.px[Y + dy, X + dx] = c

    def text(self, x, y, s, c=(0, 0, 0), size=2):
        x, y = int(x), int(y)
        for ch in str(s).upper():
            g = FONT.get(ch, FONT[" "])
            for row in range(7):
                bits = g[row]
                for col in range(5):
                    if (bits >> (4 - col)) & 1:
                        self._fr(x + col * size, y + row * size,
                                 x + (col + 1) * size, y + (row + 1) * size, c)
            x += 6 * size

    def save(self, path):
        import zlib
        import struct
        px = self.px
        h, w = px.shape[:2]
        raw = b"".join(b"\x00" + px[y].tobytes() for y in range(h))

        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data
                    + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

        with open(path, "wb") as f:
            f.write(b"\x89PNG\r\n\x1a\n"
                    + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
                    + chunk(b"IDAT", zlib.compress(raw, 6))
                    + chunk(b"IEND", b""))

COLS = [(0, 0, 255), (255, 0, 0), (0, 140, 0), (255, 120, 0), (140, 0, 140), (0, 140, 140)]


def _ticks(lo, hi, n=5):
    return lo + (hi - lo) / (n - 1) * np.arange(n)


def _xticks(cv, X, y, vals, fmt="%.3f"):
    for v in vals:
        px = X(v)
        cv.line(px, y, px, y + 6, (0, 0, 0), 1)
        s = fmt % v
        cv.text(px - len(s) * 3, y + 8, s, size=1)


def _yticks(cv, Y, x, vals, fmt="%.3f", side="left"):
    for v in vals:
        py = Y(v)
        if side == "left":
            cv.line(x - 6, py, x, py, (0, 0, 0), 1)
            s = fmt % v
            cv.text(x - 8 - len(s) * 6, py - 4, s, size=1)
        else:
            cv.line(x, py, x + 6, py, (0, 0, 0), 1)
            s = fmt % v
            cv.text(x + 8, py - 4, s, size=1)


def _fig_custom(fc, TS, hist50, T_fine, C_fine, T_star, T_prof, fe_centers,
                fe_profile, modes, h_prof, jaccard):
    cv = Canvas(1600, 1240)
    cv.text(40, 10, "B3 GO-MODEL DYNAMICS: N=20, 6 TEMPERATURES, SEED 42", size=2)
    P1 = (40, 48, 790, 600)
    P2 = (810, 48, 1560, 600)
    P3 = (40, 640, 790, 1192)
    P4 = (810, 640, 1560, 1192)

    # ---- panel 1: final configuration (isometric)
    X0, Y0, X1, Y1 = P1
    cv.rect(X0, Y0, X1, Y1, (0, 0, 0))
    cv.text(X0 + 10, Y0 + 10, "FINAL CONFIGURATION (LOWEST T)", size=2)
    xs, ys, zs = fc[:, 0], fc[:, 1], fc[:, 2]
    pd_ = xs - 0.5 * ys
    qd_ = 0.866 * ys - zs
    s = min((X1 - X0 - 60) / max(pd_.max() - pd_.min(), 1e-9),
            (Y1 - Y0 - 90) / max(qd_.max() - qd_.min(), 1e-9))
    px = (X0 + X1) / 2 + (pd_ - pd_.mean()) * s
    py = (Y0 + Y1) / 2 + (qd_ - qd_.mean()) * s
    for i in range(N - 1):
        cv.line(px[i], py[i], px[i + 1], py[i + 1], (0, 0, 200), 2)
    for i in range(N):
        cv.dot(px[i], py[i], 4, (200, 0, 0))
    cv.text(X0 + 10, Y1 - 30, "T=%.3f  JACCARD=%.3f" % (TS[int(np.argmin(TS))], jaccard), size=2)

    # ---- panel 2: per-T Q histograms
    X0, Y0, X1, Y1 = P2
    L, R, T_, B = X0 + 50, X1 - 200, Y0 + 45, Y1 - 45
    cv.rect(X0, Y0, X1, Y1, (0, 0, 0))
    cv.text(X0 + 10, Y0 + 10, "Q HISTOGRAMS BY T", size=2)
    cv.rect(L, T_, R, B, (0, 0, 0))
    ym = float(hist50.max()) * 1.08
    Xf = lambda v: L + (v - 0.0) * (R - L)
    Yf = lambda v: B - (v / ym) * (B - T_)
    bc = 0.5 * (np.linspace(0, 1, 51)[:-1] + np.linspace(0, 1, 51)[1:])
    for k in range(K_T):
        pts = list(zip(Xf(bc), Yf(hist50[k])))
        for a, b_ in zip(pts[:-1], pts[1:]):
            cv.line(a[0], a[1], b_[0], b_[1], COLS[k], 2)
    _xticks(cv, Xf, B, _ticks(0, 1, 5))
    _yticks(cv, Yf, L, _ticks(0, ym, 5))
    for k in range(K_T):
        yy = T_ + 20 + k * 26
        cv.line(R + 15, yy, R + 45, yy, COLS[k], 2)
        cv.text(R + 52, yy - 5, "T=%.3f" % TS[k], size=1)
    cv.text((L + R) / 2 - 20, Y1 - 25, "Q", size=2)

    # ---- panel 3: heat capacity
    X0, Y0, X1, Y1 = P3
    L, R, T_, B = X0 + 50, X1 - 20, Y0 + 45, Y1 - 45
    cv.rect(X0, Y0, X1, Y1, (0, 0, 0))
    cv.text(X0 + 10, Y0 + 10, "HEAT CAPACITY C(T) (REWEIGHTED)", size=2)
    cv.rect(L, T_, R, B, (0, 0, 0))
    xm0, xm1 = float(T_fine.min()), float(T_fine.max())
    ym = float(C_fine.max()) * 1.12
    Xg = lambda v: L + (v - xm0) / (xm1 - xm0) * (R - L)
    Yg = lambda v: B - (v / ym) * (B - T_)
    pts = list(zip(Xg(T_fine), Yg(C_fine)))
    for a, b_ in zip(pts[:-1], pts[1:]):
        cv.line(a[0], a[1], b_[0], b_[1], (0, 140, 0), 2)
    ipk = int(np.argmax(C_fine))
    cv.dot(Xg(T_fine[ipk]), Yg(C_fine[ipk]), 4, (255, 0, 0))
    cv.text(Xg(T_fine[ipk]) - 60, Yg(C_fine[ipk]) - 20, "PEAK=%.3f" % C_fine[ipk], size=2)
    if xm0 <= T_star <= xm1:
        cv.vline(Xg(T_star), T_, B, (200, 0, 0), 1)
        cv.text(Xg(T_star) + 6, T_ + 8, "T*=%.3f" % T_star, size=2)
    _xticks(cv, Xg, B, _ticks(xm0, xm1, 5))
    _yticks(cv, Yg, L, _ticks(0, ym, 5))
    cv.text((L + R) / 2 - 20, Y1 - 25, "T", size=2)

    # ---- panel 4: Q distribution + F profile at profile temperature
    X0, Y0, X1, Y1 = P4
    L, R, T_, B = X0 + 50, X1 - 50, Y0 + 45, Y1 - 45
    cv.rect(X0, Y0, X1, Y1, (0, 0, 0))
    cv.text(X0 + 10, Y0 + 10, "Q DIST AND F PROFILE AT T=%.3f" % T_prof, size=2)
    cv.rect(L, T_, R, B, (0, 0, 0))
    ym1 = float(max(h_prof.max(), 1e-12)) * 1.1
    ym2 = float(max(fe_profile.max(), 1e-12)) * 1.15
    Xh = lambda v: L + v * (R - L)
    Yh = lambda v: B - (v / ym1) * (B - T_)
    YF = lambda v: B - (v / ym2) * (B - T_)
    for i in range(50):
        if h_prof[i] > 0:
            xa = Xh(i / 50)
            xb = Xh((i + 1) / 50)
            cv.rect(xa, Yh(h_prof[i]), xb, B, (210, 210, 210), fill=True)
    pts = list(zip(Xh(fe_centers), YF(fe_profile)))
    for a, b_ in zip(pts[:-1], pts[1:]):
        cv.line(a[0], a[1], b_[0], b_[1], (255, 0, 0), 2)
    for m in modes:
        hb = h_prof[int(np.clip(int(m * 50), 0, 49))]
        cv.dot(Xh(m), Yh(hb), 4, (0, 0, 200))
    _xticks(cv, Xh, B, _ticks(0, 1, 5))
    _yticks(cv, Yh, L, _ticks(0, ym1, 5))
    _yticks(cv, YF, R, _ticks(0, ym2, 5), side="right")
    cv.text(L + 8, T_ + 8, "HIST", size=1)
    cv.text(R - 90, T_ + 8, "F (KBT)", size=1)
    cv.text((L + R) / 2 - 20, Y1 - 25, "Q", size=2)
    cv.save("visualization.png")
    return "custom"


def _fig_mpl(fc, TS, hist50, T_fine, C_fine, T_star, T_prof, fe_centers,
             fe_profile, modes, h_prof, jaccard):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, axs = plt.subplots(2, 2, figsize=(12, 9))
    ax = axs[0, 0]
    ax.plot(fc[:, 0], fc[:, 1], "o-", color="tab:blue", label="x-y")
    ax.plot(fc[:, 0], fc[:, 2], "s--", color="tab:red", label="x-z")
    ax.set_title("Final configuration (lowest T)")
    ax.legend()
    ax = axs[0, 1]
    bc = 0.5 * (np.linspace(0, 1, 51)[:-1] + np.linspace(0, 1, 51)[1:])
    for k in range(K_T):
        ax.plot(bc, hist50[k], label="T=%.3f" % TS[k])
    ax.set_title("Q histograms by T")
    ax.set_xlabel("Q")
    ax.legend(fontsize=7)
    ax = axs[1, 0]
    ax.plot(T_fine, C_fine, color="green")
    ipk = int(np.argmax(C_fine))
    ax.plot([T_fine[ipk]], [C_fine[ipk]], "ro")
    if T_fine.min() <= T_star <= T_fine.max():
        ax.axvline(T_star, color="red", ls="--", label="T*=%.3f" % T_star)
        ax.legend(fontsize=8)
    ax.set_title("Heat capacity C(T)")
    ax.set_xlabel("T")
    ax = axs[1, 1]
    ax.bar(np.linspace(0, 1, 51)[:-1], h_prof, width=0.02, color="lightgray", label="hist")
    ax.set_title("Q dist and F profile at T=%.3f" % T_prof)
    ax.set_xlabel("Q")
    ax2 = ax.twinx()
    ax2.plot(fe_centers, fe_profile, "r-", label="F (kBT)")
    for m in modes:
        ax.axvline(m, color="blue", ls=":")
    fig.tight_layout()
    fig.savefig("visualization.png", dpi=150)
    plt.close(fig)
    return "matplotlib"


def make_visualization(fc, TS, hist50, T_fine, C_fine, T_star, T_prof,
                       fe_centers, fe_profile, modes, h_prof, jaccard, warnings):
    try:
        backend = _fig_mpl(fc, TS, hist50, T_fine, C_fine, T_star, T_prof,
                           fe_centers, fe_profile, modes, h_prof, jaccard)
    except Exception as e:  # matplotlib unavailable or failed
        warnings.append("matplotlib unavailable or failed (%s); figure rendered with "
                        "built-in numpy PNG writer." % type(e).__name__)
        backend = _fig_custom(fc, TS, hist50, T_fine, C_fine, T_star, T_prof,
                              fe_centers, fe_profile, modes, h_prof, jaccard)
    print("visualization backend:", backend)

