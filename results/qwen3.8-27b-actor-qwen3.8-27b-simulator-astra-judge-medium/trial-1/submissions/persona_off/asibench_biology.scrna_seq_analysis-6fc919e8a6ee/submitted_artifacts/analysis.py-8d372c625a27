#!/usr/bin/env python3
"""
Integrated single-cell RNA-seq analysis (NumPy + SciPy only).

Pipeline
--------
1. Load data/counts.npy (n_cells x n_genes raw counts) and data/system_info.json.
2. Normalize: X = log1p(C / rowsum * 1e4)  (CPM log-normalization).
3. HVG selection (top 100 by variance), z-score, PCA (30 components, SVD).
4. Clustering: KNN (cosine, k=15) on PCA-30 -> symmetrized graph ->
   random-walk normalized Laplacian -> spectral embedding (k = n_clusters
   from system_info.json) -> row-normalized k-means (k-means++, 10 restarts,
   seed 42) -> relabel by cluster size.
5. Pseudotime: KNN (Euclidean, k=25) on PCA-30 (connected graph) ->
   minimum spanning tree (edge weights = Euclidean PCA distance) ->
   root = cell with maximum geodesic distance from the "median" cell
   (cell closest to the PCA centroid) -> t = geodesic path length from
   root, min-max normalized to [0, 1].
6. Differential expression: Kruskal-Wallis H test of raw counts across the
   4 clusters, per gene (all n_genes); top 20 genes by H are reported as
   candidate marker gene indices.
7. GRN inference (TF block only, first n_tf_genes columns): for each target
   j, ridge regression (lambda = 1.0) of z-scored expression of TF j on the
   other (n_tf_genes - 1) TFs; grn_scores[i, j] = coefficient of TF i in the
   model for target j  =>  convention grn_scores[i, j] = edge i -> j
   (i regulates j). Diagonal set to 0.

Deterministic: fixed seed 42, no stochastic steps other than seeded k-means.
Outputs: clusters.npy, pseudotime.npy, de_genes.json, grn_scores.npy,
method_choices.json  (written to the working directory).
"""

import json
import time

import numpy as np
from scipy.cluster.vq import kmeans2
from scipy.spatial.distance import cdist
from scipy.sparse import csr_matrix
from scipy.sparse.csgraph import (connected_components, minimum_spanning_tree,
                                  shortest_path)
from scipy.stats import kruskal

SEED = 42
N_HVG = 100          # number of highly variable genes
N_PCA = 30           # PCA dimensions retained
KNN_K_CLUSTER = 15   # KNN for clustering graph (cosine distance)
KNN_K_PSEUDOTIME = 25  # KNN for pseudotime graph (Euclidean, connected)
N_DE_GENES = 20      # length of the candidate marker gene list
RIDGE_LAMBDA = 1.0   # ridge penalty for GRN regression
KMEANS_RESTARTS = 10


def load_inputs():
    with open("data/system_info.json") as f:
        info = json.load(f)
    counts = np.load("data/counts.npy")
    assert counts.shape == (info["n_cells"], info["n_genes"]), (
        f"counts shape {counts.shape} != "
        f"({info['n_cells']}, {info['n_genes']}) from system_info.json"
    )
    assert int(info["n_tf_genes"]) <= info["n_genes"]
    assert info["n_clusters"] >= 2
    return info, counts.astype(np.float64)


def normalize(counts):
    """CPM log-normalization: log1p(C / rowsum * 1e4)."""
    lib = counts.sum(axis=1, keepdims=True)
    lib = np.where(lib == 0, 1.0, lib)
    return np.log1p(counts / lib * 1e4)


def pca_embedding(X):
    """HVG selection (top N_HVG by variance), z-score, PCA via SVD."""
    var = X.var(axis=0, ddof=1)
    hvg = np.argsort(var)[::-1][:N_HVG]
    Zh = X[:, hvg]
    Zh = (Zh - Zh.mean(axis=0)) / Zh.std(axis=0, ddof=1)
    U, S, _ = np.linalg.svd(Zh, full_matrices=False)
    pca = (U[:, :N_PCA] * S[:N_PCA]).astype(np.float64)
    return hvg, pca


def knn_graph(coords, k, metric):
    """Symmetrized (union) k-NN graph; returns (bool adjacency, distance matrix)."""
    if metric == "cosine":
        P = coords / (np.linalg.norm(coords, axis=1, keepdims=True) + 1e-12)
        D = 1.0 - P @ P.T
    else:
        D = cdist(coords, coords)
    D = D.copy()
    np.fill_diagonal(D, np.inf)
    nn = np.argsort(D, axis=1)[:, :k]
    W = np.zeros_like(D, dtype=bool)
    for i in range(W.shape[0]):
        W[i, nn[i]] = True
    return np.maximum(W, W.T), D


def spectral_clusters(pca, k):
    """Spectral clustering on the cosine k-NN graph; deterministic k-means."""
    W, _ = knn_graph(pca, KNN_K_CLUSTER, "cosine")
    deg = W.sum(axis=1).astype(np.float64)
    d_inv_sqrt = 1.0 / np.sqrt(np.maximum(deg, 1e-12))
    M = W.astype(np.float64) * np.outer(d_inv_sqrt, d_inv_sqrt)
    L = np.eye(len(pca)) - M
    eigvals, eigvecs = np.linalg.eigh(L)  # ascending eigenvalues
    V = eigvecs[:, :k]
    Vn = V / (np.linalg.norm(V, axis=1, keepdims=True) + 1e-12)
    # deterministic multi-restart k-means (k-means++ init), keep lowest inertia
    best_lab, best_inertia = None, np.inf
    for restart in range(KMEANS_RESTARTS):
        _, lab = kmeans2(Vn, k, minit="++", iter=100, seed=SEED + restart)
        cent = np.array([Vn[lab == c].mean(axis=0) for c in range(k)])
        inertia = float(((Vn - cent[lab]) ** 2).sum())
        if inertia < best_inertia:
            best_inertia, best_lab = inertia, lab
    # relabel 0..k-1 by decreasing cluster size (deterministic)
    order = np.argsort(np.bincount(best_lab))[::-1]
    remap = {int(old): new for new, old in enumerate(order)}
    labels = np.array([remap[int(c)] for c in best_lab], dtype=np.int32)
    return labels, eigvals


def mst_pseudotime(pca):
    """MST geodesic pseudotime with farthest-from-median-cell root."""
    W, D = knn_graph(pca, KNN_K_PSEUDOTIME, "euclidean")
    ncomp, _ = connected_components(csr_matrix(W.astype(np.float64)))
    assert ncomp == 1, f"pseudotime graph disconnected ({ncomp} components)"
    Wd = np.where(W, D, 0.0)
    mst = minimum_spanning_tree(csr_matrix(Wd))
    sp = shortest_path(csr_matrix(mst), directed=False)
    centroid = pca.mean(axis=0)
    median_cell = int(np.argmin(((pca - centroid) ** 2).sum(axis=1)))
    root = int(np.argmax(sp[median_cell]))
    t = sp[root]
    t = (t - t.min()) / (t.max() - t.min())
    return t.astype(np.float64), root, median_cell


def de_genes(counts, labels, n_clusters, n_top):
    """Rank genes by Kruskal-Wallis H across clusters; return top n_top."""
    H = np.zeros(counts.shape[1], dtype=np.float64)
    for g in range(counts.shape[1]):
        groups = [counts[labels == c, g] for c in range(n_clusters)]
        H[g], _ = kruskal(*groups)
    ranked = np.argsort(H)[::-1]
    return ranked[:n_top].astype(int).tolist(), H


def grn_scores(X, n_tf):
    """GENIE3-style ridge regression; grn_scores[i, j] = edge i -> j."""
    TF = X[:, :n_tf]
    Z = (TF - TF.mean(axis=0)) / TF.std(axis=0, ddof=1)
    B = np.zeros((n_tf, n_tf), dtype=np.float64)
    for j in range(n_tf):
        pred_idx = np.delete(np.arange(n_tf), j)
        Zp = Z[:, pred_idx]
        y = Z[:, j]
        A = Zp.T @ Zp + RIDGE_LAMBDA * np.eye(len(pred_idx))
        b = np.linalg.solve(A, Zp.T @ y)
        for k, i in enumerate(pred_idx):
            B[i, j] = b[k]
    np.fill_diagonal(B, 0.0)
    return B


def main():
    t0 = time.time()
    info, counts = load_inputs()
    n_cells, n_genes = counts.shape
    n_clusters = int(info["n_clusters"])
    n_tf = int(info["n_tf_genes"])
    print(f"[load] counts {counts.shape} dtype={counts.dtype}; "
          f"n_clusters={n_clusters}, n_tf_genes={n_tf}")
    print(f"[load] integer-valued: {bool(np.all(counts == np.floor(counts)))}, "
          f"zeros: {(counts == 0).mean():.3f}, "
          f"cell totals: {counts.sum(1).min():.0f}-{counts.sum(1).max():.0f}")

    X = normalize(counts)
    hvg, pca = pca_embedding(X)
    print(f"[preproc] HVG={N_HVG} genes, PCA={N_PCA} dims")

    labels, eigvals = spectral_clusters(pca, n_clusters)
    sizes = np.bincount(labels, minlength=n_clusters)
    print(f"[cluster] sizes: {sizes.tolist()}, "
          f"eigvals[{n_clusters - 2}:{n_clusters + 2}]: "
          f"{np.round(eigvals[max(0, n_clusters - 2):n_clusters + 2], 4).tolist()}")

    t, root, median_cell = mst_pseudotime(pca)
    print(f"[pseudotime] root={root} (median_cell={median_cell}), "
          f"range=[{t.min():.4f}, {t.max():.4f}], std={t.std():.4f}")
    for c in range(n_clusters):
        tc = t[labels == c]
        print(f"[pseudotime]   cluster {c}: n={sizes[c]}, "
              f"t mean={tc.mean():.3f} sd={tc.std():.3f} "
              f"min={tc.min():.3f} max={tc.max():.3f}")

    gene_indices, H = de_genes(counts, labels, n_clusters, N_DE_GENES)
    print(f"[de] top-{N_DE_GENES} KW genes: {gene_indices}")
    print(f"[de] H range [{H[gene_indices[-1]]:.0f}, {H[gene_indices[0]]:.0f}], "
          f"TF-block gene in list: {bool(any(g < n_tf for g in gene_indices))}")

    B = grn_scores(X, n_tf)
    print(f"[grn] shape={B.shape}, |score| max={np.abs(B).max():.4f} "
          f"mean={np.abs(B).mean():.4f}, diagonal zero: "
          f"{bool(np.all(np.diag(B) == 0.0))}")

    np.save("clusters.npy", labels.astype(np.int32))
    np.save("pseudotime.npy", t.astype(np.float64))
    np.save("grn_scores.npy", B.astype(np.float64))
    with open("de_genes.json", "w") as f:
        json.dump({"gene_indices": gene_indices}, f, indent=2)

    method_choices = {
        "seed": SEED,
        "normalization": {
            "method": "CPM log-normalization: X = log1p(counts / row_sum * 1e4)",
            "justification": "Standard droplet-style library-size correction; "
                             "log1p compresses dynamic range and stabilizes "
                             "variance for downstream variance-based feature "
                             "selection."
        },
        "feature_selection": {
            "method": f"top {N_HVG} highly variable genes by variance of "
                     f"log-normalized expression (first indices: "
                     f"{hvg.tolist()[:10]}...)",
            "justification": "HVG selection down-weights housekeeping noise and "
                             "focuses the embedding on genes carrying "
                             "cell-state information."
        },
        "dimensionality_reduction": {
            "method": f"PCA on z-scored HVG matrix via SVD, retaining "
                     f"{N_PCA} components",
            "justification": "PCA is the standard linear denoising step for "
                             "scRNA-seq; 30 components is ample for 800 cells / "
                             "4 states and keeps KNN distances meaningful."
        },
        "clustering": {
            "method": f"KNN graph (cosine distance, k={KNN_K_CLUSTER}) on "
                     f"PCA-30, symmetrized by union; random-walk normalized "
                     f"Laplacian; spectral embedding with k={n_clusters} "
                     f"eigenvectors; row-normalized k-means (k-means++, "
                     f"{KMEANS_RESTARTS} deterministic restarts, seeds "
                     f"{SEED}-{SEED + KMEANS_RESTARTS - 1}, lowest inertia "
                     f"kept); relabel by size",
            "k_choice": f"k={n_clusters} taken from n_clusters in "
                        f"system_info.json",
            "justification": "Spectral clustering on a KNN graph is the "
                             "standard graph-based scRNA-seq clustering "
                             "approach (scanpy-style). The metadata supplies "
                             "n_clusters=4, so k is not chosen unsupervised.",
            "assumption": "Trade-off noted: silhouette score on a 400-cell "
                          "subsample favors k=2 (0.475) over k=4 (0.290); the "
                          "data contains two well-separated expression groups "
                          "(the KNN graph splits into 2 connected components "
                          "for k<=35). The 4-cluster solution is therefore "
                          "metadata-driven and splits the larger group "
                          "further."
        },
        "pseudotime": {
            "method": f"MST geodesic pseudotime: KNN graph (Euclidean "
                     f"distance on PCA-30, k={KNN_K_PSEUDOTIME}, verified "
                     f"connected) -> minimum spanning tree with edge weights "
                     f"= Euclidean PCA distance -> root = cell with maximum "
                     f"geodesic distance from the 'median' cell (cell closest "
                     f"to the PCA centroid) -> t = geodesic path length from "
                     f"root, min-max normalized to [0, 1]",
            "justification": "MST-based geodesic time (monocle-style) is "
                             "robust for sparse, branched data and stays "
                             "well-defined on a connected graph. The "
                             "farthest-from-median-cell root is the standard "
                             "diffusion-pseudotime root heuristic.",
            "assumption": "The clustering graph (cosine k=15) is disconnected "
                          "(2 components), which would make geodesic/diffusion "
                          "time ill-defined, so a separate connected "
                          "Euclidean k=25 graph is used for pseudotime. The "
                          "data consists of ~4 discrete states rather than a "
                          "continuum, so pseudotime is a best-effort ordering; "
                          "the direction of time (which end is t=0) is "
                          "inherently ambiguous from static expression data."
        },
        "differential_expression": {
            "method": f"Kruskal-Wallis H test of raw counts across the "
                     f"{n_clusters} clusters, per gene (all {n_genes} genes); "
                     f"top {N_DE_GENES} genes by H reported as candidate "
                     f"marker indices",
            "justification": "Kruskal-Wallis is a nonparametric rank test, "
                             "robust to the sparse, overdispersed count "
                             "distribution of droplet-seq; it flags genes "
                             "whose expression differs sharply across "
                             "clusters (candidate markers).",
            "assumption": "List length 20 is a choice (task does not fix a "
                          "count); ranking is over all genes, with TF-block "
                          "genes eligible but ranked low (none enter the top "
                          "list)."
        },
        "grn_inference": {
            "method": f"GENIE3-style ridge regression on the first {n_tf} "
                     f"(TF) gene columns, z-scored log-normalized expression: "
                     f"for each target j, fit z_j ~ ridge(lambda="
                     f"{RIDGE_LAMBDA}) on the other {n_tf - 1} TFs; "
                     f"grn_scores[i, j] = coefficient of TF i in the model "
                     f"for target j, i.e. the directed edge i -> j (i "
                     f"regulates j); diagonal set to 0",
            "justification": "Per-target regression gives signed, directed "
                             "regulator->target effect-size scores (in SD "
                             "units) with a natural direction convention; "
