        }
    }
    with open("method_choices.json", "w") as f:
        json.dump(method_choices, f, indent=2)

    print(f"[done] wrote clusters.npy, pseudotime.npy, de_genes.json, "
          f"grn_scores.npy, method_choices.json in {time.time() - t0:.1f}s")


if __name__ == "__main__":
    main()
