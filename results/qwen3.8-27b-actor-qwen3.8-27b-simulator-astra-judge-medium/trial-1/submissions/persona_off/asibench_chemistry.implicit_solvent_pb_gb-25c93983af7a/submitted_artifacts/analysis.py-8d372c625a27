def draw_text(cv,x,y,txt,scale=2,color=(0,0,0)):
    cx=x
    for ch in txt:
        g=FONT.get(ch,FONT[' '])
        for r in range(7):
            for cc in range(5):
                if g[r][cc]=='1':
                    cv[y+r*scale:y+(r+1)*scale,cx+cc*scale:cx+(cc+1)*scale]=color
        cx+=scale*6
def save_png(cv,path):
    cv=cv.astype(np.uint8); h,w,_=cv.shape
    raw=b''.join(b'\x00'+cv[r].tobytes() for r in range(h))
    def chunk(t,d):
        c=t+d; return struct.pack('>I',len(d))+c+struct.pack('>I',zlib.crc32(c)&0xffffffff)
    ihdr=struct.pack('>IIBBBBB',w,h,8,2,0,0,0)
    open(path,'wb').write(b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',ihdr)+chunk(b'IDAT',zlib.compress(raw,9))+chunk(b'IEND',b''))
def bwr(t):
    t=np.clip(t,0,1)
    r=np.where(t<0.5,(t/0.5)*255,255); b=np.where(t<0.5,255,(1-(t-0.5)/0.5)*255)
    return np.stack([r,255*np.ones_like(r),b],-1)
