import numpy as np, json, os, zlib, struct
import pandas as pd
from scipy.ndimage import distance_transform_edt
from scipy.sparse import coo_matrix, diags
from scipy.sparse.linalg import splu, spsolve, cg
from scipy.spatial import cKDTree

DATA='data'; RES='results'
os.makedirs(RES, exist_ok=True)
N=35; B=N-2; B2=B*B
KCAL=332.06371
RGAS=0.0019872042586400361

man=json.load(open(f'{DATA}/manifest.json'))
cases=man['cases']
planes={p['case_id']:p for p in json.load(open(f'{DATA}/plane_spec.json'))['planes']}
va=np.load(f'{DATA}/volume_a.npy'); vb=np.load(f'{DATA}/volume_b.npy')
queries=np.load(f'{DATA}/queries.npy')
sites=pd.read_csv(f'{DATA}/sites.csv')

def grid_info(g):
    c=np.array(g['box_center_angstrom']); h=g['spacing_angstrom']; he=g['box_half_extent_angstrom']
    return c, c-he, h

def trilinear(F, pts, ax0, h):
    idx=(pts-ax0)/h
    i0=np.clip(np.floor(idx).astype(int),0,N-2)
    t=np.clip(idx-i0,0,1)
    out=np.empty(len(pts))
    for m in range(len(pts)):
        i,j,k=i0[m]; a,b,c=t[m]
        F00=(F[i,j,k]*(1-a)+F[i+1,j,k]*a)*(1-b)+(F[i,j+1,k]*(1-a)+F[i+1,j+1,k]*a)*b
        F11=(F[i,j,k+1]*(1-a)+F[i+1,j,k+1]*a)*(1-b)+(F[i,j+1,k+1]*(1-a)+F[i+1,j+1,k+1]*a)*b
        out[m]=F00*(1-c)+F11*c
    return out

def deposit(chg, pos, ax0, h):
    rho=np.zeros((N,N,N))
    idx=(pos-ax0)/h
    i0=np.clip(np.floor(idx).astype(int),0,N-2)
    t=np.clip(idx-i0,0,1)
    for di in (0,1):
        for dj in (0,1):
            for dk in (0,1):
                wt=chg*((1-t[:,0]) if di==0 else t[:,0])*((1-t[:,1]) if dj==0 else t[:,1])*((1-t[:,2]) if dk==0 else t[:,2])
                np.add.at(rho,(i0[:,0]+di,i0[:,1]+dj,i0[:,2]+dk),wt)
    return rho/h**3

def build_S(eps, h):
    ii,jj,kk=np.meshgrid(np.arange(1,N-1),np.arange(1,N-1),np.arange(1,N-1),indexing='ij')
    p=(ii-1)*B2+(jj-1)*B+(kk-1)
    ep_p=eps[ii,jj,kk]; h2=h*h
    dirs=[(ii+1,jj,kk),(ii-1,jj,kk),(ii,jj+1,kk),(ii,jj-1,kk),(ii,jj,kk+1),(ii,jj,kk-1)]
    diag=np.zeros(p.size); rows=[];cols=[];vals=[]
    for (ni,nj,nk) in dirs:
        ef=2.0/(1.0/ep_p+1.0/eps[ni,nj,nk])
        diag+=ef.ravel()/h2
        interior=(ni>=1)&(ni<=N-2)&(nj>=1)&(nj<=N-2)&(nk>=1)&(nk<=N-2)
        nblin=(ni-1)*B2+(nj-1)*B+(nk-1)
        msk=interior.ravel()
        rows.append(p.ravel()[msk]); cols.append(nblin.ravel()[msk]); vals.append((-ef/h2).ravel()[msk])
    rows=np.concatenate(rows); cols=np.concatenate(cols); vals=np.concatenate(vals)
    rr=np.concatenate([p.ravel(),rows]); cc=np.concatenate([p.ravel(),cols]); vv=np.concatenate([diag,vals])
    return coo_matrix((vv,(rr,cc)),shape=(B2*B,B2*B)).tocsr()

def solve_entity(sdf, chg, pos, ax0, h, sp, rp):
    model=sp['surface_model']; win=sp['smoothing_window_angstrom']
    sf=(sdf>0).astype(float) if model=='mol' else 0.5*(1.0-np.tanh(sdf/win))
    e_in=rp['inner_dielectric']; e_out=rp['outer_dielectric']; kap=rp['screening_kappa_per_angstrom']
    eps=e_in+(e_out-e_in)*sf
    rho=deposit(chg,pos,ax0,h)
    S=build_S(eps,h); RT=RGAS*rp['temperature_kelvin']; n=B2*B
    idx=np.arange(n)
    sf_i=sf[1:-1,1:-1,1:-1].ravel(); rho_i=rho[1:-1,1:-1,1:-1].ravel()
    if rp['response_regime']=='linearized_screening':
        A=S+coo_matrix((kap*sf_i,(idx,idx)),shape=(n,n)).tocsr()
        phi_flat=spsolve(A,4*np.pi*KCAL*rho_i)
    else:
        base=4*np.pi*KCAL*rho_i
        phi_flat=spsolve(S+diags(kap*sf_i),base)*(1.0-sf_i)
        clip=50.0
        for it in range(40):
            arg=np.clip(phi_flat/RT,-clip,clip)
            F=S@phi_flat+kap*sf_i*np.sinh(arg)-base
            J=S+diags(kap*sf_i*np.cosh(arg)/RT)
            d,info=cg(J,-F,rtol=1e-7,maxiter=300)
            step=1.0; Fn=np.linalg.norm(F)
            for _ in range(20):
                pn=phi_flat+step*d
                if np.linalg.norm(S@pn+kap*sf_i*np.sinh(np.clip(pn/RT,-clip,clip))-base)<Fn: break
                step*=0.5
            phi_flat=phi_flat+step*d
            if np.max(np.abs(d))<1e-7: break
    phi=np.zeros((N,N,N))
    phi[1:-1,1:-1,1:-1]=phi_flat.reshape(B,B,B)
    Sv=build_S(np.full((N,N,N),e_in),h)
    phi_v=np.zeros((N,N,N)); phi_v[1:-1,1:-1,1:-1]=spsolve(Sv,4*np.pi*KCAL*rho_i).reshape(B,B,B)
    RF=phi-phi_v
    E=0.5*np.sum(chg*trilinear(RF,pos,ax0,h))
    return RF, E

def ses_sdf(positions, radii, ax0, h, probe):
    ax=ax0[0]+np.arange(N)*h; ay=ax0[1]+np.arange(N)*h; az=ax0[2]+np.arange(N)*h
    X,Y,Z=np.meshgrid(ax,ay,az,indexing='ij')
    nodes=np.stack([X.ravel(),Y.ravel(),Z.ravel()],1)
    A=np.column_stack([positions,radii])
    inside=np.zeros(len(nodes),bool)
    for st in range(0,len(A),300):
        Bc=A[st:st+300]; d=np.linalg.norm(nodes[:,None,:3]-Bc[None,:,:3],axis=2)
        inside|=(d<=Bc[None,:,3]).any(1)
    M=inside.reshape(N,N,N)
    D=(distance_transform_edt(~M)*h<=probe) if probe>0 else M
    E=(distance_transform_edt(~D)*h>=probe) if probe>0 else np.ones_like(M)
    SES=M|(D&E)
    return distance_transform_edt(~SES)*h-distance_transform_edt(SES)*h

summary=[]
field_samples=np.zeros((len(cases),24),np.float32)
field_slice=np.zeros((len(cases),35,35),np.float32)
for ci,c in enumerate(cases):
    g=c['grid']; sp=c['surface_parameters']; rp=c['response_parameters']
    _,ax0,h=grid_info(g)
    sub=sites[sites.case_id==c['case_id']]
    def get(ent):
        s=sub[sub.entity_id==ent]
        return s[['x_angstrom','y_angstrom','z_angstrom']].values, s['charge_e'].values, s['radius_angstrom'].values
    posA,chA,rA=get('part_a'); posB,chB,rB=get('part_b')
    posAs=np.vstack([posA,posB]); chAs=np.concatenate([chA,chB])
    RF_as,E_as=solve_entity(vb[ci], chAs, posAs, ax0, h, sp, rp)
    probe=sp['probe_radius_angstrom']
    sdf_a=ses_sdf(posA,rA,ax0,h,probe); sdf_b=ses_sdf(posB,rB,ax0,h,probe)
    _,E_a=solve_entity(sdf_a, chA, posA, ax0, h, sp, rp)
    _,E_b=solve_entity(sdf_b, chB, posB, ax0, h, sp, rp)
    primary=E_as-E_a-E_b
    field_samples[ci]=trilinear(RF_as, queries[ci], ax0, h)
    pl=planes[c['case_id']]
    field_slice[ci]=RF_as[:,:,pl['plane_index']] if pl['axis']=='z' else RF_as[:,pl['plane_index'],:]
    e_in=rp['inner_dielectric']; e_out=rp['outer_dielectric']; kap=rp['screening_kappa_per_angstrom']
    aa=np.maximum(rA,np.abs(trilinear(sdf_a,posA,ax0,h)))
    bb=np.maximum(rB,np.abs(trilinear(sdf_b,posB,ax0,h)))
    dn,_=cKDTree(posB).query(posA); keep=dn<=6.5; sec=0.0
    for i in np.where(keep)[0]:
        r2=((posA[i]-posB)**2).sum(1); fij=np.sqrt(r2+aa[i]*bb*np.exp(-r2/(4*aa[i]*bb)))
        sec+=chA[i]*np.sum(chB*((1/e_in)-np.exp(-kap*fij)/e_out)/fij)
    secondary=-KCAL*sec
    summary.append([c['case_id'],primary,secondary,primary-secondary])
    print(f"{c['case_id']}: primary={primary:.4f} secondary={secondary:.4f} gap={primary-secondary:.4f} (E_as={E_as:.3f} E_a={E_a:.3f} E_b={E_b:.3f})")

df=pd.DataFrame(summary,columns=['case_id','metric_primary_kcal_mol','metric_secondary_kcal_mol','metric_gap_kcal_mol'])
df.to_csv(f'{RES}/summary_metrics.csv',index=False)
np.save(f'{RES}/field_samples.npy',field_samples.astype(np.float32))
np.save(f'{RES}/field_slice.npy',field_slice.astype(np.float32))
print('SAVED')

