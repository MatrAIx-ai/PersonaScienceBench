#!/usr/bin/env python3
"""
analysis.py -- solution-phase electron-transfer response calculation
(asibench: chemistry.marcus_et_reorganization_energy). Reads only from data/,
writes only to results/.

Documented assumption set (approved plan):
 1. Hessian rows = 3 consecutive (x,y,z) rows per raw site row, in
    frame_site_order.csv order (verified: exact 6 rigid nulls + 15 resolved
    modes, matching system_manifest; rigid null-space invariance H.t, H.(rx c) ~ 0).
 2. Hessians are Cartesian (eV/angstrom^2 per manifest), NOT mass-weighted:
    H_mw = M^-1/2 H M^-1/2; d_mw = M^1/2 d.
 3. Retained modes = 15 largest eigenvalues of each mass-weighted Hessian
    (6 smallest are exact rigid translation/rotation nulls); ascending
    eigenvalue order; "zero-based retained-mode index" uses that ordering.
 4. Kabsch (SVD) rigid alignment. Forward = frame B aligned into frame A
    (source B, reference A); backward = frame A into frame B. Signed
    displacement outputs = aligned source minus reference.
 5. lambda_4pt_forward = 1/2 d_fwd^T H_A d_fwd (reference-frame A surface at
    B's aligned geometry); backward analog with H_B. Standard four-point
    method; normal-mode decomposition closes to ~1e-17.
 6. lambda_outer = two-sphere Marcus outer-sphere (Levich-Dogadov) formula:
    (e^2/8 pi eps0)(1/span_A - 1/(2 shell_0_A) - 1/(2 shell_1_A))
    (1/eps_fast - 1/eps_slow). Negative for this synthetic geometry
    (shell_0 + shell_1 > span); reported as-is per approved plan.
 7. lambda_total = (lambda_4pt_fwd + lambda_4pt_bwd)/2 (four-point average);
    lambda_inner_effective = lambda_total - lambda_outer; lambda_total used
    for the Marcus rate curve and k_self_exchange (DeltaG = 0).
 8. Marcus rate k(DeltaG) = (2 pi/hbar) |V|^2 (4 pi lambda kBT)^-1/2
    exp(-(DeltaG + lambda)^2/(4 lambda kBT)); V = coupling_eV, T = temp_K.
 9. dominant_mode = argmax |q_i| over the 15 retained modes (zero-based).
 10. mode_projection columns = [signed q in reference basis, signed q in
     transported source basis, 1/2 omega^2 q_ref^2 (eV)]; column 3 sums to
     lambda_nm per direction. transported_mode_projection = abs of cols 1-2.
 11. mode_overlap / transported_mode_projection are magnitude-based (abs),
     sign-invariant. Eigenvector signs fixed deterministically (largest-
     |component| entry positive).
 12. Inverted region = grid points with axis_eV more negative than the
     discrete peak point; first_inverted = inverted point closest to the
     peak. rate_curve.csv preserves the supplied grid row order.
 13. rigid_norm = ||d_mw - projected d_mw|| (discarded 6-mode subspace,
     mass-weighted); closure_error = lambda_4pt - lambda_nm.
"""
import json
import os

import numpy as np

DATA = "data"
OUT = "results"

HBAR_EV_S = 6.582119569e-16        # hbar, eV s
KB_EV_K = 8.617333262e-5           # Boltzmann, eV/K
E2_8PE0_EV_A = 7.1998227392127775  # e^2/(8 pi eps0), eV angstrom


def load_inputs():
    import csv
    with open(os.path.join(DATA, "site_table.csv")) as f:
        site = list(csv.DictReader(f))
    masses = {int(r["site_id"]): float(r["mass_amu"]) for r in site}
    with open(os.path.join(DATA, "frame_site_order.csv")) as f:
        order = list(csv.DictReader(f))
    with open(os.path.join(DATA, "driving_force_grid.csv")) as f:
        grid = list(csv.DictReader(f))
    with open(os.path.join(DATA, "system_manifest.json")) as f:
        manifest = json.load(f)
    with open(os.path.join(DATA, "medium_response.json")) as f:
        medium = json.load(f)
    coords = {
        "frame_a": np.load(os.path.join(DATA, "frame_a_coords.npy")),
        "frame_b": np.load(os.path.join(DATA, "frame_b_coords.npy")),
    }
    hess = {
        "frame_a": np.load(os.path.join(DATA, "frame_a_hessian.npy")),
        "frame_b": np.load(os.path.join(DATA, "frame_b_hessian.npy")),
    }
    return masses, order, grid, manifest, medium, coords, hess


def frame_permutations(order, frame):
    """(coord_row_perm, hessian_21_perm) mapping raw rows -> ascending site_id."""
    sids = [int(r["site_id"]) for r in order if r["frame_id"] == frame]
    pos = [sids.index(i) for i in range(len(sids))]
    h21 = np.concatenate([[3 * p + k for k in range(3)] for p in pos])
    return np.array(pos), h21


def kabsch(src, ref):
    """Rigid rotation/translation mapping src onto ref (least squares)."""
    cs, cr = src.mean(axis=0), ref.mean(axis=0)
    X, Y = src - cs, ref - cr
    U, _, Vt = np.linalg.svd(X.T @ Y)
    d = np.sign(np.linalg.det(Vt.T @ U.T))
    R = Vt.T @ np.diag([1.0, 1.0, d]) @ U.T
    t = cr - R @ cs
    return R, t


def fix_signs(V):
    """Deterministic eigenvector sign: largest-|component| entry positive."""
    V = V.copy()
    for j in range(V.shape[1]):
        i = int(np.argmax(np.abs(V[:, j])))
        if V[i, j] < 0:
            V[:, j] = -V[:, j]
    return V


def rot21(R, n_sites):
    """21x21 block-diagonal rotation (one 3x3 block per site)."""
    return np.kron(np.eye(n_sites), R)


def main():
    os.makedirs(OUT, exist_ok=True)
    masses, order, grid, manifest, medium, coords, hess = load_inputs()
    n_sites = len(masses)

    (posA, idxA), (posB, idxB) = (frame_permutations(order, "frame_a"),
                                  frame_permutations(order, "frame_b"))
    A = coords["frame_a"][posA]                      # (7,3) ascending site_id
    B = coords["frame_b"][posB]
    HA = hess["frame_a"][idxA][:, idxA]              # (21,21) ascending site_id
    HB = hess["frame_b"][idxB][:, idxB]

    mvec = np.repeat([masses[i] for i in range(n_sites)], 3)
    D = np.sqrt(mvec)

    # ---------------- alignment (Kabsch, rigid) ----------------
    Rf, tf = kabsch(B, A)      # forward: B into A
    Rb, tb = kabsch(A, B)      # backward: A into B
    B_in_A = B @ Rf.T + tf
    A_in_B = A @ Rb.T + tb
    d_fwd = (B_in_A - A).ravel()     # source B - reference A
    d_bwd = (A_in_B - B).ravel()     # source A - reference B
    rmsd_f = float(np.sqrt(((B_in_A - A) ** 2).sum() / n_sites))
    rmsd_b = float(np.sqrt(((A_in_B - B) ** 2).sum() / n_sites))

    d_mw = np.stack([D * d_fwd, D * d_bwd])          # (2,21)

    # ---------------- vibrational bases (15 retained modes) ----------------
    w, V, idx15 = {}, {}, {}
    for tag, H in (("frame_a", HA), ("frame_b", HB)):
        Hm = H / (D[:, None] * D[None, :])           # M^-1/2 H M^-1/2
        wv, vv = np.linalg.eigh(Hm)
        keep = np.argsort(wv)[::-1][:15][::-1]       # 15 largest, ascending
        w[tag], V[tag], idx15[tag] = wv, fix_signs(vv), keep

    basis = np.stack([V["frame_a"][:, idx15["frame_a"]],
                      V["frame_b"][:, idx15["frame_b"]]])      # (2,21,15)

    # ---------------- modal coordinates ----------------
    q = np.zeros((2, 15))            # signed, reference-frame basis
    q_src = np.zeros((2, 15))        # signed, transported source-frame basis
    for d, ref, src, R in ((0, "frame_a", "frame_b", Rf),
                           (1, "frame_b", "frame_a", Rb)):
        q[d] = V[ref][:, idx15[ref]].T @ d_mw[d]
        q_src[d] = (rot21(R, n_sites) @ V[src][:, idx15[src]]).T @ d_mw[d]

    E_mode = np.stack([0.5 * w["frame_a"][idx15["frame_a"]] * q[0] ** 2,
                       0.5 * w["frame_b"][idx15["frame_b"]] * q[1] ** 2])   # eV

    proj = np.stack([V["frame_a"][:, idx15["frame_a"]] @ q[0],
                     V["frame_b"][:, idx15["frame_b"]] @ q[1]])             # signed mw

    # ---------------- mode overlap (magnitude-based) ----------------
    O = np.zeros((2, 15, 15))
    O[0] = np.abs(V["frame_a"][:, idx15["frame_a"]].T
                  @ (rot21(Rf, n_sites) @ V["frame_b"][:, idx15["frame_b"]]))
    O[1] = np.abs(V["frame_b"][:, idx15["frame_b"]].T
                  @ (rot21(Rb, n_sites) @ V["frame_a"][:, idx15["frame_a"]]))

    # ---------------- reorganization energies ----------------
    lam4 = np.array([0.5 * d_fwd @ HA @ d_fwd, 0.5 * d_bwd @ HB @ d_bwd])
    lam_nm = np.array([0.5 * float(np.sum(w["frame_a"][idx15["frame_a"]] * q[0] ** 2)),
                       0.5 * float(np.sum(w["frame_b"][idx15["frame_b"]] * q[1] ** 2))])
    closure = lam4 - lam_nm

    lam_outer = float(E2_8PE0_EV_A * (1.0 / medium["span_A"]
                                      - 0.5 / medium["shell_0_A"]
                                      - 0.5 / medium["shell_1_A"])
                      * (1.0 / medium["eps_fast"] - 1.0 / medium["eps_slow"]))
    lam_total = float(0.5 * (lam4[0] + lam4[1]))
    lam_inner_eff = lam_total - lam_outer
    lam_nm_avg = float(0.5 * (lam_nm[0] + lam_nm[1]))
    inner_consistency = abs(lam_inner_eff - lam_nm_avg)

    T = float(medium["temp_K"])
    Vcoupling = float(medium["coupling_eV"])
    kBT = KB_EV_K * T
    pref = (2.0 * np.pi / HBAR_EV_S) * Vcoupling ** 2 / np.sqrt(4.0 * np.pi * lam_total * kBT)
    k_self = float(pref * np.exp(-lam_total / (4.0 * kBT)))

    # ---------------- rate curve (preserve grid row order) ----------------
    gid = np.array([int(r["grid_id"]) for r in grid])
    axis = np.array([float(r["axis_eV"]) for r in grid])
    k_et = pref * np.exp(-(axis + lam_total) ** 2 / (4.0 * lam_total * kBT))

    ipk = int(np.argmax(k_et))
    inv_mask = axis < axis[ipk]
    inv_idx = np.where(inv_mask)[0]
    if inv_idx.size:
        fi = int(inv_idx[np.argmax(axis[inv_idx])])
        inverted = True
    else:
        fi, inverted = -1, False

    # ---------------- diagnostics ----------------
    rigid_norm = np.linalg.norm(d_mw - proj, axis=1)
    projected_norm = np.linalg.norm(proj, axis=1)
    dominant = np.argmax(np.abs(q), axis=1)

    diagnostics = {
        "alignment_rmsd_forward_A": rmsd_f,
        "alignment_rmsd_backward_A": rmsd_b,
        "closure_error_forward_eV": float(closure[0]),
        "closure_error_backward_eV": float(closure[1]),
        "effective_inner_consistency_eV": float(inner_consistency),
        "rigid_norm_forward": float(rigid_norm[0]),
        "rigid_norm_backward": float(rigid_norm[1]),
        "projected_norm_forward": float(projected_norm[0]),
        "projected_norm_backward": float(projected_norm[1]),
        "dominant_mode_forward": int(dominant[0]),
        "dominant_mode_backward": int(dominant[1]),
        "rate_peak_grid_id": int(gid[ipk]),
        "rate_peak_axis_eV": float(axis[ipk]),
        "rate_peak_s_inv": float(k_et[ipk]),
        "inverted_region_detected": bool(inverted),
        "first_inverted_grid_id": int(gid[fi]) if inverted else -1,
        "first_inverted_axis_eV": float(axis[fi]) if inverted else None,
        "assumptions": [
            "Hessian rows = 3 consecutive (x,y,z) rows per raw site row (frame_site_order order); exact 6 rigid nulls + 15 resolved modes verified.",
            "Hessians Cartesian (eV/angstrom^2); H_mw = M^-1/2 H M^-1/2; d_mw = M^1/2 d.",
            "Retained modes = 15 largest mass-weighted eigenvalues (6 rigid nulls dropped), ascending eigenvalue order.",
            "Kabsch rigid alignment; forward = B in A, backward = A in B; signed outputs = aligned source - reference.",
            "lambda_4pt dir = 1/2 d^T H_ref d (reference-frame surface); normal-mode closure ~1e-17.",
            "lambda_outer = two-sphere Marcus outer-sphere formula; negative for this geometry, reported as-is.",
            "lambda_total = four-point average; used for rate curve and k_self_exchange (DeltaG=0).",
            "dominant_mode = argmax |q_i| over retained modes; mode_projection cols = [q_ref, q_src-transported, 1/2 omega^2 q_ref^2 (eV)].",
        ],
    }

    # ---------------- write outputs ----------------
    np.save(os.path.join(OUT, "aligned_displacement_mw.npy"), d_mw)
    np.save(os.path.join(OUT, "vibrational_basis_mw.npy"), basis)
    np.save(os.path.join(OUT, "mode_overlap.npy"), O)
    np.save(os.path.join(OUT, "projected_displacement_mw.npy"), proj)
    np.save(os.path.join(OUT, "transported_mode_projection.npy"),
            np.stack([np.abs(q), np.abs(q_src)], axis=2))
    np.save(os.path.join(OUT, "mode_projection.npy"),
            np.stack([q, q_src, E_mode], axis=2))

    import csv
    with open(os.path.join(OUT, "lambda_summary.csv"), "w", newline="") as f:
        wtr = csv.writer(f)
        wtr.writerow(["lambda_4pt_forward_eV", "lambda_4pt_backward_eV",
                      "lambda_nm_forward_eV", "lambda_nm_backward_eV",
                      "lambda_inner_effective_eV", "lambda_outer_eV",
                      "lambda_total_eV", "k_self_exchange_s_inv"])
        wtr.writerow([repr(float(lam4[0])), repr(float(lam4[1])),
                      repr(float(lam_nm[0])), repr(float(lam_nm[1])),
                      repr(lam_inner_eff), repr(lam_outer),
                      repr(lam_total), repr(k_self)])

    with open(os.path.join(OUT, "rate_curve.csv"), "w", newline="") as f:
        wtr = csv.writer(f)
        wtr.writerow(["grid_id", "axis_eV", "k_et_s_inv", "log10_k_et_s_inv"])
        for i in range(len(grid)):
            wtr.writerow([int(gid[i]), repr(float(axis[i])),
                          repr(float(k_et[i])),
                          repr(float(np.log10(k_et[i])))])

    with open(os.path.join(OUT, "diagnostics.json"), "w") as f:
        json.dump(diagnostics, f, indent=2)

    # ---------------- overview figure (4 panels) ----------------
    fs = float(manifest.get("freq_scale_factor", 521.4708983725066))
    fA = fs * np.sqrt(np.clip(w["frame_a"][idx15["frame_a"]], 0, None))
    fB = fs * np.sqrt(np.clip(w["frame_b"][idx15["frame_b"]], 0, None))
    make_overview(os.path.join(OUT, "overview.png"), {
        "axis": axis, "k_et": k_et, "lam_total": lam_total,
        "ipk": ipk, "fi": fi, "inverted": inverted, "gid": gid,
        "q": q, "fA": fA, "fB": fB,
        "lam4": [float(lam4[0]), float(lam4[1])],
        "lam_nm": [float(lam_nm[0]), float(lam_nm[1])],
        "lam_inner_eff": lam_inner_eff, "lam_outer": lam_outer,
        "O": O[0], "case_id": str(manifest.get("case_id", "")),
    })

    # ---------------- console summary ----------------
    print("wrote 10 outputs to", OUT)
    print(f"rmsd fwd/bwd (A)  : {rmsd_f:.6f} / {rmsd_b:.6f}")
    print(f"lambda_4pt f/b    : {lam4[0]:.6f} / {lam4[1]:.6f} eV")
    print(f"lambda_nm  f/b    : {lam_nm[0]:.6f} / {lam_nm[1]:.6f} eV")
    print(f"closure    f/b    : {closure[0]:.3e} / {closure[1]:.3e} eV")
    print(f"lambda_outer      : {lam_outer:.6f} eV")
    print(f"lambda_inner_eff  : {lam_inner_eff:.6f} eV")
    print(f"lambda_total      : {lam_total:.6f} eV")
    print(f"k_self_exchange   : {k_self:.6e} s^-1")
    print(f"rate peak         : gid {gid[ipk]} @ {axis[ipk]:.6f} eV, k={k_et[ipk]:.4e} s^-1")
    if inverted:
        print(f"inverted region   : detected; first gid {gid[fi]} @ {axis[fi]:.6f} eV")
    else:
        print("inverted region   : not detected")
    print(f"dominant modes    : fwd {int(dominant[0])}, bwd {int(dominant[1])}")
    print(f"col3 sum check    : {E_mode[0].sum():.8f} vs {lam_nm[0]:.8f} | "
          f"{E_mode[1].sum():.8f} vs {lam_nm[1]:.8f}")




def _overview_mpl(path, c):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    axis, k_et = c["axis"], c["k_et"]
    lam_total = c["lam_total"]
    ipk, fi, inverted = c["ipk"], c["fi"], c["inverted"]
    gid, q = c["gid"], c["q"]

    fig, axes = plt.subplots(2, 2, figsize=(12, 9))
    fig.suptitle("Marcus ET reorganization-energy response "
                 f"(case {c['case_id']})", fontsize=11)

    ax = axes[0, 0]
    srt = np.argsort(axis)
    ax.plot(axis[srt], np.log10(k_et[srt]), "b-", lw=1.5, label="k_ET(dG)")
    ax.axvline(-lam_total, color="gray", ls="--", lw=1,
               label=f"-lambda_total = {lam_total:.4f} eV")
    ax.plot(axis[ipk], np.log10(k_et[ipk]), "r*", ms=14,
            label=f"peak (gid {gid[ipk]})")
    if inverted:
        ax.plot(axis[fi], np.log10(k_et[fi]), "o", color="orange", ms=8,
                label=f"first inverted (gid {gid[fi]})")
        ax.axvspan(axis.min(), axis[ipk], color="orange", alpha=0.12)
    ax.set_xlabel("driving force dG (eV)")
    ax.set_ylabel("log10 k_ET (s$^{-1}$)")
    ax.set_title("(a) Marcus rate curve")
    ax.legend(fontsize=8)
    ax.grid(alpha=0.3)

    ax = axes[0, 1]
    x = np.arange(15)
    ax.bar(x - 0.2, q[0], width=0.4, color="tab:blue",
           label="forward (frame A modes)")
    ax.bar(x + 0.2, q[1], width=0.4, color="tab:red",
           label="backward (frame B modes)")
    ax.axhline(0, color="k", lw=0.5)
    ax.set_xlabel("retained mode index (ascending w^2)")
    ax.set_ylabel("signed modal coordinate q (sqrt(amu)*A)")
    ax.set_title("(b) Displacement in the 15-mode basis")
    ax2 = ax.twiny()
    ax2.plot(x, c["fA"], "b:", ms=3)
    ax2.plot(x, c["fB"], "r:", ms=3)
    ax2.set_ylabel("freq (cm$^{-1}$)", fontsize=8)
    ax2.tick_params(labelsize=7)
    ax.legend(fontsize=8, loc="upper left")
    ax.grid(alpha=0.3, axis="y")

    ax = axes[1, 0]
    labels = ["4pt\nfwd", "4pt\nbwd", "nm\nfwd", "nm\nbwd",
              "inner\neff", "outer\n(medium)", "total"]
    vals = [c["lam4"][0], c["lam4"][1], c["lam_nm"][0], c["lam_nm"][1],
            c["lam_inner_eff"], c["lam_outer"], lam_total]
    colors = ["tab:blue", "tab:blue", "tab:cyan", "tab:cyan",
              "tab:green", "tab:orange", "tab:red"]
    ax.bar(range(len(vals)), vals, color=colors)
    ax.set_xticks(range(len(vals)))
    ax.set_xticklabels(labels, fontsize=8)
    ax.set_ylabel("eV")
    ax.set_title("(c) Reorganization-energy decomposition")
    for i, v in enumerate(vals):
        ax.text(i, v + (0.02 if v >= 0 else -0.07), f"{v:.3f}",
                ha="center", fontsize=7)
    ax.grid(alpha=0.3, axis="y")

    ax = axes[1, 1]
    im = ax.imshow(c["O"], cmap="viridis", vmin=0, vmax=1)
    ax.set_xlabel("source mode (frame B, transported)")
    ax.set_ylabel("reference mode (frame A)")
    ax.set_title("(d) |mode overlap| forward")
    fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04)

    fig.tight_layout(rect=[0, 0, 1, 0.97])
    fig.savefig(path, dpi=140)
    plt.close(fig)




