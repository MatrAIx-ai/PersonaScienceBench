def _fb_write_png(path, buf):
    import struct, zlib
    h, w = buf.shape[:2]

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

    raw = b"".join(b"\x00" + buf[y].tobytes() for y in range(h))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


class _FBCanvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.buf = np.zeros((h, w, 3), np.uint8)
        self.buf[...] = bg

    def hline(self, x0, x1, y, c):
        self.buf[int(y), max(0, int(x0)):min(self.buf.shape[1], int(x1) + 1)] = c

    def vline(self, x, y0, y1, c):
        self.buf[max(0, int(y0)):min(self.buf.shape[0], int(y1) + 1), int(x)] = c

    def rect(self, x0, y0, x1, y1, c, fill=False):
        X0, Y0, X1, Y1 = int(x0), int(y0), int(x1), int(y1)
        if fill:
            self.buf[Y0:Y1 + 1, X0:X1 + 1] = c
        else:
            self.buf[Y0, X0:X1 + 1] = c
            self.buf[Y1, X0:X1 + 1] = c
            self.buf[Y0:Y1 + 1, X0] = c
            self.buf[Y0:Y1 + 1, X1] = c

    def line(self, x0, y0, x1, y1, c, width=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx + dy
        while True:
            for ox in range(width):
                for oy in range(width):
                    xx, yy = x0 + ox, y0 + oy
                    if 0 <= xx < self.buf.shape[1] and 0 <= yy < self.buf.shape[0]:
                        self.buf[yy, xx] = c
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x0 += sx
            if e2 <= dx:
                err += dx
                y0 += sy

    def vline_dash(self, x, y0, y1, c, dash=6, gap=4):
        y = int(y0)
        while y <= int(y1):
            self.buf[y:min(y + dash, int(y1) + 1), int(x)] = c
            y += dash + gap

    def circle(self, cx, cy, r, c, fill=True):
        for yy in range(int(cy - r), int(cy + r) + 1):
            for xx in range(int(cx - r), int(cx + r) + 1):
                if (xx - cx) ** 2 + (yy - cy) ** 2 <= r * r and \
                        0 <= xx < self.buf.shape[1] and 0 <= yy < self.buf.shape[0]:
                    if fill or (xx - cx) ** 2 + (yy - cy) ** 2 >= (r - 1.5) ** 2:
                        self.buf[yy, xx] = c

    def text(self, x, y, s, c=(0, 0, 0), scale=2):
        xx = int(x)
        for ch in str(s).upper():
            glyph = _FB_FONT.get(ch, _FB_FONT[" "])
            for row, pat in enumerate(glyph):
                for col, bit in enumerate(pat):
                    if bit == "1":
                        self.rect(xx + col * scale, int(y) + row * scale,
                                  xx + col * scale + scale - 1,
                                  int(y) + row * scale + scale - 1, c, fill=True)
            xx += 4 * scale

    def text_w(self, s, scale=2):
        return 4 * scale * len(str(s))




def _fb_viridis(v):
    stops = [(0.0, (68, 1, 84)), (0.25, (59, 82, 139)), (0.5, (33, 145, 140)),
             (0.75, (94, 201, 98)), (1.0, (253, 231, 37))]
    v = min(1.0, max(0.0, float(v)))
    for (t0, c0), (t1, c1) in zip(stops, stops[1:]):
        if v <= t1:
            f = (v - t0) / (t1 - t0)
            return tuple(int(a + f * (b - a)) for a, b in zip(c0, c1))
    return stops[-1][1]


def _fb_axes(cv, x0, y0, x1, y1, xmin, xmax, ymin, ymax,
             xticks, yticks, xlab, ylab, title):
    cv.rect(x0, y0, x1, y1, (0, 0, 0))
    for xv in xticks:
        px = x0 + (xv - xmin) / (xmax - xmin) * (x1 - x0)
        cv.vline(px, y1, y1 + 5, (0, 0, 0))
        lab = f"{xv:g}"
        cv.text(px - cv.text_w(lab, 1) / 2, y1 + 7, lab, scale=1)
    for yv in yticks:
        py = y1 - (yv - ymin) / (ymax - ymin) * (y1 - y0)
        cv.hline(x0 - 5, x0, py, (0, 0, 0))
        lab = f"{yv:g}"
        cv.text(x0 - 8 - cv.text_w(lab, 1), py - 3, lab, scale=1)
    cv.text(x0 + (x1 - x0) / 2 - cv.text_w(xlab, 1) / 2, y1 + 21, xlab, scale=1)
    cv.text(x0, y0 - 20, ylab, scale=1)
    cv.text(x0 + (x1 - x0) / 2 - cv.text_w(title, 2) / 2, y0 - 42, title, scale=2)

    def mappt(xv, yv):
        return (x0 + (xv - xmin) / (xmax - xmin) * (x1 - x0),
                y1 - (yv - ymin) / (ymax - ymin) * (y1 - y0))
    return mappt


def _overview_fallback(path, c):
    W, H = 1160, 880
    cv = _FBCanvas(W, H)
    cv.text(W / 2 - cv.text_w("MARCUS ET REORGANIZATION-ENERGY RESPONSE", 2) / 2,
            14, "MARCUS ET REORGANIZATION-ENERGY RESPONSE", scale=2)
    cv.text(W / 2 - cv.text_w(f"CASE {c['case_id']}", 1) / 2, 34,
            f"CASE {c['case_id']}", scale=1)

    axis, k_et = c["axis"], c["k_et"]
    lam_total = c["lam_total"]
    ipk, fi, inverted = c["ipk"], c["fi"], c["inverted"]
    gid, q = c["gid"], c["q"]
    lg = np.log10(k_et)

    # --- (a) rate curve ---
    x0, y0, x1, y1 = 110, 100, 545, 385
    axmin, axmax = float(axis.min()), float(axis.max())
    pad = (axmax - axmin) * 0.03
    m = float(lg.min())
    M = float(lg.max())
    mp = (M - m) * 0.08
    mp_ = _fb_axes(cv, x0, y0, x1, y1, axmin - pad, axmax + pad, m - mp, M + mp,
                   [round(axmin, 1), round(axmin + (axmax - axmin) * 0.33, 1),
                    round(axmin + (axmax - axmin) * 0.66, 1), round(axmax, 1)],
                   [int(m), int(m + (M - m) * 0.33), int(m + (M - m) * 0.66), int(M)],
                   "DRIVING FORCE (EV)", "LOG10 K (1/S)", "A  MARCUS RATE CURVE")
    srt = np.argsort(axis)
    pts = [mp_(axis[i], lg[i]) for i in srt]
    for (xa, ya), (xb, yb) in zip(pts[:-1], pts[1:]):
        cv.line(xa, ya, xb, yb, (31, 84, 171), width=2)
    pxl, _ = mp_(-lam_total, 0)
    cv.vline_dash(pxl, y0, y1, (130, 130, 130))
    cv.circle(*mp_(axis[ipk], lg[ipk]), 5, (200, 30, 30))
    if inverted:
        cv.circle(*mp_(axis[fi], lg[fi]), 5, (230, 140, 20))
    cv.line(x0 + 8, y0 + 12, x0 + 34, y0 + 12, (31, 84, 171), width=2)
    cv.text(x0 + 40, y0 + 7, "K(DELTA G)", scale=1)
    cv.circle(x0 + 16, y0 + 28, 4, (200, 30, 30))
    cv.text(x0 + 40, y0 + 23, f"PEAK GID {gid[ipk]}", scale=1)
    cv.circle(x0 + 16, y0 + 44, 4, (230, 140, 20))
    cv.text(x0 + 40, y0 + 39, f"1ST INV GID {gid[fi] if inverted else -1}", scale=1)
    cv.text(x0 + 40, y0 + 55, f"-LAMBDA TOTAL = {lam_total:.4f} EV", scale=1)

    # --- (b) modal coordinates ---
    x0, y0, x1, y1 = 665, 100, 1100, 385
    qmax = float(np.max(np.abs(q))) * 1.25 or 1.0
    mp_ = _fb_axes(cv, x0, y0, x1, y1, -0.6, 14.6, -qmax, qmax,
                   [0, 5, 10, 14],
                   [round(-qmax, 1), 0, round(qmax, 1)],
                   "RETAINED MODE INDEX (ASC W^2)", "Q (SQRT(AMU)*A)",
                   "B  DISPLACEMENT IN 15-MODE BASIS")
    zy = mp_(0, 0)[1]
    cv.hline(x0, x1, zy, (120, 120, 120))
    for i in range(15):
        for off, d, col in ((-0.28, 0, (31, 84, 171)), (0.28, 1, (200, 30, 30))):
            xa, ya = mp_(i + off - 0.22, 0)
            xb, yb = mp_(i + off + 0.22, q[d, i])
            cv.rect(xa, min(ya, yb), xb, max(ya, yb), col, fill=True)
            cv.rect(xa, min(ya, yb), xb, max(ya, yb), (0, 0, 0))
    cv.text(x0 + 8, y0 + 8, "BLUE: FWD (A MODES)", scale=1)
    cv.text(x0 + 8, y0 + 22, "RED: BWD (B MODES)", scale=1)

    # --- (c) lambda decomposition ---
    x0, y0, x1, y1 = 110, 500, 545, 785
    vals = [c["lam4"][0], c["lam4"][1], c["lam_nm"][0], c["lam_nm"][1],
            c["lam_inner_eff"], c["lam_outer"], lam_total]
    cols = [(31, 84, 171), (31, 84, 171), (0, 170, 190), (0, 170, 190),
            (40, 160, 70), (230, 140, 20), (200, 30, 30)]
    vlabels = ["4PT F", "4PT B", "NM F", "NM B", "IN EFF", "OUTER", "TOTAL"]
    vmin = min(0.0, min(vals)) * 1.35
    vmax = max(vals) * 1.3
    mp_ = _fb_axes(cv, x0, y0, x1, y1, -0.7, 6.7, vmin, vmax,
                   [0, 1, 2, 3, 4, 5, 6],
                   [vmin, 0, vmax], "LAMBDA TERMS", "EV",
                   "C  REORGANIZATION-ENERGY DECOMPOSITION")
    zy = mp_(0, 0)[1]
    cv.hline(x0, x1, zy, (120, 120, 120))
    for i, (v, col, lab) in enumerate(zip(vals, cols, vlabels)):
        xa, ya = mp_(i - 0.38, 0)
        xb, yb = mp_(i + 0.38, v)
        cv.rect(xa, min(ya, yb), xb, max(ya, yb), col, fill=True)
        cv.rect(xa, min(ya, yb), xb, max(ya, yb), (0, 0, 0))
        tlab = f"{v:.3f}"
        tx = (xa + xb) / 2 - cv.text_w(tlab, 1) / 2
        ty = min(ya, yb) - 12 if v >= 0 else max(ya, yb) + 3
        cv.text(tx, ty, tlab, scale=1)
        cv.text((xa + xb) / 2 - cv.text_w(lab, 1) / 2, y1 + 7, lab, scale=1)

    # --- (d) mode overlap heatmap ---
    O = c["O"]
    cx0, cy0, cs = 665, 500, 20
    cv.text(cx0, cy0 - 42, "D  |MODE OVERLAP| FORWARD", scale=2)
    cv.text(cx0, cy0 - 20, "REF MODE (A) VS SOURCE MODE (B, TRANSPORTED)", scale=1)
    for i in range(15):
        for j in range(15):
            cv.rect(cx0 + j * cs, cy0 + i * cs, cx0 + (j + 1) * cs - 1,
                    cy0 + (i + 1) * cs - 1, _fb_viridis(O[i, j]), fill=True)
    cv.rect(cx0, cy0, cx0 + 15 * cs, cy0 + 15 * cs, (0, 0, 0))
    cbx, cby, cbw, cbh = cx0 + 15 * cs + 25, cy0, 14, 15 * cs
    for k in range(cbh):
        cv.hline(cbx, cbx + cbw, cby + k, _fb_viridis(1.0 - k / (cbh - 1)))
    cv.rect(cbx, cby, cbx + cbw, cby + cbh, (0, 0, 0))
    cv.text(cbx + cbw + 4, cby - 2, "1", scale=1)
    cv.text(cbx + cbw + 4, cby + cbh - 8, "0", scale=1)

    _fb_write_png(path, cv.buf)


