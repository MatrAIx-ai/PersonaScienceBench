#!/usr/bin/env python3
"""
VTST tunneling-correction analysis for a 2D reaction-energy surface.

Self-contained: reads only data/*.csv and data/system_manifest.json,
writes all deliverables under results/ plus this script.

Method summary
--------------
* Corridor free energy:  G(s) = V(s) - RT ln[Z(s)/Z(0)], Z(s) = trapz exp(-V(s,q)/RT) dq
  over the 13-point transverse scan; transverse frequency from quadratic fit
  omega = 95 * sqrt(k_q / mu_trans)  [cm^-1].
* Local crossing: corridor point nearest the conventional 2D saddle (ridge minimum).
  Optimized crossing: argmax_s G(s) per temperature (optimal dividing surface).
* TST rates: k = (kB T / h) exp(-dG*/RT), dG* referenced to the reactant basin
  (corridor point 0, G=0 by construction).
* Enhanced rates: WKB transmission kappa = 1/(1+exp(2 S/h)) evaluated at the
  barrier-top energy; S/h = 1.24 * integral_{V>E} sqrt(2 mu_long (V-E)) ds
  (semiclassical_action_scale from the manifest).
* 2D action: Eberly minimum-energy path (MEP) between the two basin minima,
  action evaluated along the MEP for the classically forbidden part.
* Crossover temperature: T_c = (hc/kB) |omega_imag| / 2, imaginary longitudinal
  frequency at the optimized crossing (OTST/instanton crossover).
* Isotope cases: potential scans are mass-independent; isotope effects enter via
  (a) harmonic vibrational free-energy shift of the transverse mode with
  omega -> omega/sqrt(transverse_mass_scale), and (b) action scaling
  S -> sqrt(longitudinal_mass_scale) S (corridor and 2D).
"""
import json
import numpy as np
import pandas as pd

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

DATA = "data"
OUT = "results"

# ---------------------------------------------------------------- load data
manifest = json.load(open(f"{DATA}/system_manifest.json"))
C = manifest["public_constants"]
R = C["R_kJ_mol_K"]
HBAR = C["hc_kJ_mol_per_cm"]            # hc in kJ mol^-1 cm^-1
HCKB = C["hc_over_kB_K_cm"]             # K cm^-1
KBH = C["kB_over_h_s_per_K"]            # s^-1 K^-1
FREQ_SCALE = C["frequency_scale_cm1_per_sqrt_kj_mol_coord2"]
ACTION_SCALE = C["semiclassical_action_scale"]

surface = pd.read_csv(f"{DATA}/surface_samples.csv")
curve = pd.read_csv(f"{DATA}/curve_samples.csv")
tube = pd.read_csv(f"{DATA}/tube_scan.csv")
kin = pd.read_csv(f"{DATA}/kinetic_metric.csv")
temps = pd.read_csv(f"{DATA}/temperature_grid.csv")
isotopes = pd.read_csv(f"{DATA}/isotope_cases.csv")

Nx, Ny = int(surface.grid_x_index.max()) + 1, int(surface.grid_y_index.max()) + 1
gx, gy = np.unique(surface.x.values), np.unique(surface.y.values)
Vgrid = np.full((Nx, Ny), np.nan)
Vgrid[surface.grid_x_index.values, surface.grid_y_index.values] = surface.potential_kj_mol.values

s = curve.s_coord.values
P = len(curve)
X_c, Y_c = curve.x.values, curve.y.values

# corridor potential V(s) from q=0 tube_scan values
c0 = tube[tube.q_offset == 0].set_index("point_id")["potential_kj_mol"]
Vc = c0.reindex(range(P)).values.copy()

# transverse curvature and frequency (light, mu = 1 amu, mass-weighted)
kq = np.empty(P)
for p in range(P):
    row = tube[tube.point_id == p].sort_values("q_offset")
    kq[p] = 2.0 * np.polyfit(row.q_offset.values, row.potential_kj_mol.values, 2)[0]
omega_trans = FREQ_SCALE * np.sqrt(kq / 1.0)     # cm^-1

# longitudinal curvature along corridor (2nd difference in s)
ks = np.empty(P)
for i in range(1, P - 1):
    h1, h2 = s[i] - s[i - 1], s[i + 1] - s[i]
    ks[i] = 2.0 * ((Vc[i + 1] - Vc[i]) / h2 - (Vc[i] - Vc[i - 1]) / h1) / (h1 + h2)
ks[0] = ks[1]; ks[-1] = ks[-2]

# ---------------------------------------------------------------- basins & saddle
def basin_min(xlo, xhi):
    m = ((surface.x >= xlo) & (surface.x <= xhi)).to_numpy()
    idx = np.nonzero(m)[0][np.argmin(surface.potential_kj_mol.to_numpy()[m])]
    r = surface.iloc[idx]
    return float(r.x), float(r.y), float(r.potential_kj_mol)

react_min = basin_min(-1.32, -0.5)
prod_min = basin_min(0.5, 1.32)

# conventional 2D saddle: minimum over y of the ridge (max over x)
ridge = np.array([[y, Vgrid[:, j].max()] for j, y in enumerate(gy)])
i_ridge = ridge[:, 1].argmin()
saddle_y = float(ridge[i_ridge, 0])
jy = int(np.argmin(np.abs(gy - saddle_y)))
jx = int(Vgrid[:, jy].argmax())
saddle = (float(gx[jx]), float(gy[jy]), float(Vgrid[jx, jy]))

# local crossing: corridor point nearest the conventional saddle
d2 = (X_c - saddle[0]) ** 2 + (Y_c - saddle[1]) ** 2
p_local = int(d2.argmin())
s_local = float(s[p_local])

# ---------------------------------------------------------------- transverse partition functions
def Z_trans(p, T):
    row = tube[tube.point_id == p].sort_values("q_offset")
    return np.trapezoid(np.exp(-row.potential_kj_mol.values / (R * T)), row.q_offset.values)

def G_profile(T):
    Z0 = Z_trans(0, T)
    Z = np.array([Z_trans(p, T) for p in range(P)])
    return Vc - R * T * np.log(Z / Z0)

# ---------------------------------------------------------------- WKB actions
def action_corridor(E, mu):
    mask = Vc > E
    if not mask.any():
        return 0.0
    integrand = np.zeros(P)
    integrand[mask] = ACTION_SCALE * np.sqrt(2.0 * mu * (Vc[mask] - E))
    return np.trapezoid(integrand, s)

def wkb_transmission(S):
    return 1.0 / (1.0 + np.exp(2.0 * S))

# ---------------- Eberly minimum-energy path (2D tunneling path)
def interp2(x, y):
    xi = np.clip(np.searchsorted(gx, x) - 1, 0, Nx - 2)
    yi = np.clip(np.searchsorted(gy, y) - 1, 0, Ny - 2)
    x0, x1 = gx[xi], gx[xi + 1]
    y0, y1 = gy[yi], gy[yi + 1]
    tx = np.clip((x - x0) / (x1 - x0), 0, 1)
    ty = np.clip((y - y0) / (y1 - y0), 0, 1)
    v00 = Vgrid[xi, yi]; v10 = Vgrid[xi + 1, yi]
    v01 = Vgrid[xi, yi + 1]; v11 = Vgrid[xi + 1, yi + 1]
    return (1 - tx) * (1 - ty) * v00 + tx * (1 - ty) * v10 \
        + (1 - tx) * ty * v01 + tx * ty * v11

N_NODES = 61
path = np.stack([
    np.linspace(react_min[0], prod_min[0], N_NODES),
    np.linspace(react_min[1], prod_min[1], N_NODES),
], axis=1)
for it in range(3000):
    max_move = 0.0
    for i in range(1, N_NODES - 1):
        a, b = path[i - 1], path[i + 1]
        d = b - a
        n = np.array([-d[1], d[0]])
        n = n / (np.linalg.norm(n) + 1e-300)
        mid = 0.5 * (a + b)
        t = np.dot(path[i] - mid, n)
        new = mid + t * n
        for step in np.linspace(-0.02, 0.02, 21):
            cand = mid + (t + step) * n
            if interp2(*cand) < interp2(*new):
                new = cand
        mv = np.linalg.norm(new - path[i])
        max_move = max(max_move, mv)
        path[i] = new
    if max_move < 1e-7:
        break

def resample(pts, n):
    seg = np.linalg.norm(np.diff(pts, axis=0), axis=1)
    cum = np.concatenate([[0], np.cumsum(seg)])
    tt = np.linspace(0, cum[-1], n)
    return np.stack([np.interp(tt, cum, pts[:, 0]),
                     np.interp(tt, cum, pts[:, 1])], axis=1)

mep = resample(path, 401)
mep_V = np.array([interp2(x, y) for x, y in mep])
mep_l = np.concatenate([[0], np.cumsum(np.linalg.norm(np.diff(mep, axis=0), axis=1))])

def action_2d(E, mu):
    mask = mep_V > E
    if not mask.any():
        return 0.0
    integrand = np.zeros(len(mep_l))
    integrand[mask] = ACTION_SCALE * np.sqrt(2.0 * mu * (mep_V[mask] - E))
    return np.trapezoid(integrand, mep_l)

# ---------------------------------------------------------------- rate machinery
def harmonic_Fvib(omega_cm1, T):
    """Harmonic vibrational free energy, kJ/mol."""
    x = HCKB * omega_cm1 / T
    return 0.5 * HBAR * omega_cm1 + R * T * np.log1p(-np.exp(-x))

def rates_for_case(T, mu_long, trans_scale):
    """Rate quantities for one mass case at temperature T."""
    om_t = omega_trans / np.sqrt(trans_scale)
    G = G_profile(T)
    dF = harmonic_Fvib(om_t, T) - harmonic_Fvib(omega_trans, T)
    G = G + dF - dF[0]
    s_opt = int(G.argmax())
    dG_local = G[p_local] - G[0]
    dG_opt = G[s_opt] - G[0]
    k_local = KBH * T * np.exp(-dG_local / (R * T))
    k_opt = KBH * T * np.exp(-dG_opt / (R * T))
    om_img = FREQ_SCALE * np.sqrt(abs(ks[s_opt]) / mu_long)
    T_c = HCKB * om_img / 2.0
    E_top = Vc[s_opt]
    S = action_corridor(E_top, mu_long)
    kappa = wkb_transmission(S)
    k_enh = kappa * k_opt
    return dict(s_opt=s_opt, s_optimized=float(s[s_opt]), dG_local=dG_local,
                dG_opt=dG_opt, k_local=k_local, k_opt=k_opt, kappa=kappa,
                k_enh=k_enh, T_c=T_c, G=G)

# ---------------------------------------------------------------- 1) free energy profile
rows = []
for T in temps.T_K.values:
    G = G_profile(T)
    p_opt = int(G.argmax())
    for p in range(P):
        rows.append(dict(T_K=T, point_id=p, s_coord=s[p], x=X_c[p], y=Y_c[p],
                         transverse_frequency_cm1=omega_trans[p],
                         free_energy_kj_mol=G[p],
                         optimized_crossing=int(p == p_opt)))
fef = pd.DataFrame(rows)
fef.to_csv(f"{OUT}/free_energy_profile.csv", index=False)

# ---------------------------------------------------------------- 2) rate constants
rate_rows = []
base = {}
for T in temps.T_K.values:
    r = rates_for_case(T, 1.0, 1.0)
    base[T] = r
    rate_rows.append(dict(T_K=T,
                          log10_k_local_s_inv=np.log10(r["k_local"]),
                          log10_k_optimized_s_inv=np.log10(r["k_opt"]),
                          log10_k_enhanced_s_inv=np.log10(r["k_enh"]),
                          kappa_corridor=r["kappa"],
                          enhancement_factor=r["kappa"],
                          s_optimized=r["s_optimized"],
                          barrier_local_kj_mol=r["dG_local"],
                          barrier_optimized_kj_mol=r["dG_opt"],
                          crossover_T_K=r["T_c"]))
rates = pd.DataFrame(rate_rows)
rates.to_csv(f"{OUT}/rate_constants.csv", index=False)

# ---------------------------------------------------------------- 3) transmission profile
E_grid = np.linspace(0.0, 60.0, 56)
tprof_rows = []
for i, E in enumerate(E_grid):
    Sc = action_corridor(E, 1.0)
    S2 = action_2d(E, 1.0)
    tprof_rows.append(dict(energy_id=i, energy_kj_mol=E,
                           action_corridor=Sc, action_2d=S2,
                           transmission_corridor=wkb_transmission(Sc),
                           transmission_2d=wkb_transmission(S2),
                           action_ratio_2d_over_corridor=(S2 / Sc if Sc > 0 else 1.0)))
tprof = pd.DataFrame(tprof_rows)
tprof.to_csv(f"{OUT}/transmission_profile.csv", index=False)

both = (tprof.action_corridor > 0) & (tprof.action_2d >= 0)
mean_reduction = float(np.mean(1.0 - tprof.action_2d[both] / tprof.action_corridor[both]))

# ---------------------------------------------------------------- 4) path samples
sel_ids = [0, 8, 16, 24, 32, 40, 48, 55]
ps_rows = []
for eid in sel_ids:
    E = E_grid[eid]
    mask = mep_V > E
    pts = mep[mask]
    vpts = mep_V[mask]
    if len(pts) == 0:
        pts = mep[np.argmax(mep_V)][None, :]
        vpts = mep_V[np.argmax(mep_V)][None]
    samp = np.linspace(0, len(pts) - 1, min(20, len(pts))).astype(int)
    for step, idx in enumerate(samp):
        ps_rows.append(dict(energy_id=eid, path_step=step, energy_kj_mol=E,
                            x=pts[idx, 0], y=pts[idx, 1], potential_kj_mol=vpts[idx]))
pd.DataFrame(ps_rows).to_csv(f"{OUT}/path_samples.csv", index=False)

# ---------------------------------------------------------------- 5/6) isotope effects
iso_rows, itprof_rows = [], []
for case in isotopes.itertuples():
    mlong = float(case.longitudinal_mass_scale)
    mtrans = float(case.transverse_mass_scale)
    for T in temps.T_K.values:
        r = rates_for_case(T, mlong, mtrans)
        ref = base[T]
        iso_rows.append(dict(case_id=case.case_id, isotopologue=case.isotopologue,
                             longitudinal_mass_scale=mlong, transverse_mass_scale=mtrans,
                             T_K=T,
                             log10_k_local_s_inv=np.log10(r["k_local"]),
                             log10_k_optimized_s_inv=np.log10(r["k_opt"]),
                             log10_k_enhanced_s_inv=np.log10(r["k_enh"]),
                             enhancement_factor=r["kappa"],
                             s_optimized=r["s_optimized"],
                             crossover_T_K=r["T_c"],
                             log10_KIE_sct_vs_light=np.log10(ref["k_enh"]) - np.log10(r["k_enh"])))
    for i, E in enumerate(E_grid):
        Sc = action_corridor(E, mlong)
        S2 = action_2d(E, mlong)
        itprof_rows.append(dict(case_id=case.case_id, isotopologue=case.isotopologue,
                                longitudinal_mass_scale=mlong, transverse_mass_scale=mtrans,
                                energy_id=i, energy_kj_mol=E,
                                action_corridor=Sc, action_2d=S2,
                                transmission_corridor=wkb_transmission(Sc),
                                transmission_2d=wkb_transmission(S2),
                                action_ratio_2d_over_corridor=(S2 / Sc if Sc > 0 else 1.0)))
iso_fx = pd.DataFrame(iso_rows)
iso_fx.to_csv(f"{OUT}/isotope_effects.csv", index=False)
pd.DataFrame(itprof_rows).to_csv(f"{OUT}/isotope_transmission_profile.csv", index=False)

# ---------------------------------------------------------------- 7) diagnostics
T0 = float(temps.T_K.iloc[0])
diag = {
    "basins": {
        "reactant": {"x": react_min[0], "y": react_min[1], "V_kj_mol": react_min[2],
                     "note": "lower-x side"},
        "product": {"x": prod_min[0], "y": prod_min[1], "V_kj_mol": prod_min[2],
                    "note": "higher-x side"},
    },
    "conventional_saddle_location": {"x": saddle[0], "y": saddle[1], "V_kj_mol": saddle[2],
                                     "method": "minimum over y of ridge (max over x)"},
    "crossings": {
        "local": {"point_id": p_local, "s_coord": s_local,
                  "x": X_c[p_local], "y": Y_c[p_local], "V_kj_mol": float(Vc[p_local]),
                  "definition": "corridor point nearest conventional 2D saddle"},
        "optimized": {"point_id": int(base[T0]["s_opt"]),
                      "s_coord": float(base[T0]["s_optimized"]),
                      "definition": "argmax of corridor free-energy profile G(s)"},
    },
    "crossover_temperature_K": {
        "light": float(base[T0]["T_c"]),
        "definition": "T_c = (hc/kB)|omega_imag|/2 at optimized crossing",
    },
    "crossover_temperature_K_by_case": {
        case.case_id: float(rates_for_case(T0,
                                           float(case.longitudinal_mass_scale),
                                           float(case.transverse_mass_scale))["T_c"])
        for case in isotopes.itertuples()
    },
    "action_reduction": {
        "mean_2d_vs_corridor_action_reduction_fraction": mean_reduction,
        "definition": "mean(1 - action_2d/action_corridor) over the 56 energies with action_corridor > 0",
    },
    "rate_ordering": {
        "description": "per-temperature ordering of log10 rates",
        "all_T_k_local_le_k_optimized_le_k_enhanced": bool(
            ((rates.log10_k_local_s_inv <= rates.log10_k_optimized_s_inv + 1e-12)
             & (rates.log10_k_optimized_s_inv <= rates.log10_k_enhanced_s_inv + 1e-12)).all()),
        "kappa_range": [float(rates.kappa_corridor.min()), float(rates.kappa_corridor.max())],
    },
    "barriers_kj_mol_at_297p5K": {
        "local": float(rates.loc[rates.T_K == 297.5, "barrier_local_kj_mol"].iloc[0]),
        "optimized": float(rates.loc[rates.T_K == 297.5, "barrier_optimized_kj_mol"].iloc[0]),
        "reference": "reactant basin (corridor point 0, G=0)",
    },
}
json.dump(diag, open(f"{OUT}/diagnostics.json", "w"), indent=2)

# ---------------------------------------------------------------- 8) rate plot
if HAVE_MPL:
    fig, ax = plt.subplots(figsize=(8, 5))
    ax.plot(rates.T_K, rates.log10_k_local_s_inv, "o-", label="local crossing (TST)")
    ax.plot(rates.T_K, rates.log10_k_optimized_s_inv, "s-", label="optimized crossing (TST)")
    ax.plot(rates.T_K, rates.log10_k_enhanced_s_inv, "^-", label="enhanced (WKB transmission)")
    ax.set_xlabel("T (K)")
    ax.set_ylabel(r"log$_{10}$ k (s$^{-1}$)")
    ax.set_title("Corridor crossing rates with tunneling enhancement")
    ax2 = ax.twinx()
    ax2.plot(rates.T_K, rates.enhancement_factor, "k--", alpha=0.6, label="enhancement factor")
    ax2.set_ylabel(r"enhancement factor $\kappa$ (corridor WKB)")
    h1, l1 = ax.get_legend_handles_labels()
    h2, l2 = ax2.get_legend_handles_labels()
    ax.legend(h1 + h2, l1 + l2, loc="lower left")
    fig.tight_layout()
    fig.savefig(f"{OUT}/rate_plot.png", dpi=150)
else:
    # ---- self-contained fallback: minimal raster plot + 3x5 font PNG writer
    import struct, zlib
    FONT = {
        '0':'111101101101111','1':'010110010010111','2':'111001111100111','3':'111001011001111',
        '4':'101101111001001','5':'111100111001111','6':'111100111101111','7':'111001001010010',
        '8':'111101111101111','9':'111101111001111','a':'000000110101111','b':'110101110101110',
        'c':'011100100100011','d':'001101101101011','e':'111100110100111','f':'111100110100100',
        'g':'000111101111011','h':'100100110101101','i':'010000010010111','j':'010000001001101',
        'k':'100101110101101','l':'010010010010111','m':'010111111101101','n':'000110101101101',
        'o':'000111101101111','p':'000110111110100','q':'000111101111010','r':'000110101100100',
        's':'111100110001111','t':'110100110100010','u':'000101101101111','v':'000101101101010',
        'w':'000101111111101','x':'000101010101000','y':'000101101111010','z':'111001010100111',
        'A':'010101111101101','B':'110101110101110','C':'011100100100011','D':'110101101101110',
        'E':'111100110100111','F':'111100110100100','G':'011100101101011','H':'101101111101101',
        'I':'111010010010111','J':'001001001001111','K':'101101110101101','L':'100100100100111',
        'M':'101111111101101','N':'101111111111101','O':'010101101101010','P':'110101110100100',
        'Q':'010101101110010','R':'110101110101101','S':'111100110001111','T':'111010010010010',
        'U':'101101101101111','V':'101101101101010','W':'101111111111101','X':'101101010101101',
        'Y':'101101010010010','Z':'111001010100111',' ':'000000000000000','.':'000000000000010',
        '-':'000000111000000','(':'001010010010001',')':'001010010010100','/':'001001010100100',
        '^':'010101000000000','_':'000000000000111',
    }
    W, H = 820, 520
    buf = np.zeros((H, W, 3), dtype=np.uint8)
    buf[:, :] = 255
    def text(x, y, msg, color, scale=2):
        cx = x
        for ch in msg:
            g = FONT.get(ch, FONT[' '])
            for r in range(5):
                for c in range(3):
                    if g[r * 3 + c] == '1':
                        buf[y + r * scale:y + (r + 1) * scale, cx + c * scale:cx + (c + 1) * scale] = color
            cx += 4 * scale
    def hline(x0, x1, y, color, dash=0):
        for x in range(int(x0), int(x1)):
            if dash == 0 or (x // dash) % 2 == 0:
                buf[y, x] = color
    def vline(x, y0, y1, color):
        buf[int(y0):int(y1), x] = color
    def polyline(xs, ys, color, dash=0):
        n = len(xs)
        for i in range(n - 1):
            x0, y0, x1, y1 = xs[i], ys[i], xs[i + 1], ys[i + 1]
            steps = max(abs(int(x1) - int(x0)), abs(int(y1) - int(y0)), 1)
            for t in np.linspace(0, 1, steps):
                x = int(round(x0 + t * (x1 - x0))); y = int(round(y0 + t * (y1 - y0)))
                if 0 <= x < W and 0 <= y < H and (dash == 0 or (x // dash) % 2 == 0):
                    buf[y, x] = color
    L, Rr, Tt, Bb = 90, 660, 45, 410
    hline(L, Rr, Bb, (0, 0, 0)); vline(L, Tt, Bb, (0, 0, 0)); vline(Rr, Tt, Bb, (0, 0, 0))
    tx0, tx1 = 150.0, 975.0
    ly0 = rates.log10_k_local_s_inv.min() - 1
    ly1 = rates.log10_k_enhanced_s_inv.max() + 1
    def X(t): return L + (t - tx0) / (tx1 - tx0) * (Rr - L)
    def Y(v): return Bb - (v - ly0) / (ly1 - ly0) * (Bb - Tt)
    for t in [200, 400, 600, 800]:
        vline(int(X(t)), Bb, Bb + 6, (0, 0, 0)); text(int(X(t)) - 12, Bb + 10, str(t), (0, 0, 0))
    v = np.arange(int(np.ceil(ly0)), int(np.floor(ly1)) + 1)
    for vv in v:
        hline(L - 6, L, int(Y(vv)), (0, 0, 0)); text(L - 30, int(Y(vv)) - 5, str(vv), (0, 0, 0))
    text(280, H - 30, "T (K)", (0, 0, 0), 2)
    text(12, 180, "log10 k (s-1)", (0, 0, 0), 2)
    text(676, 200, "kappa", (0, 0, 0), 2)
    for kv in [0.0, 0.25, 0.5, 0.75, 1.0]:
