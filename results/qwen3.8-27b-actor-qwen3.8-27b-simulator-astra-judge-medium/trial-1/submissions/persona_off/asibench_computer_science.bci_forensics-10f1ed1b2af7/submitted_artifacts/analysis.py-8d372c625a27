#!/usr/bin/env python3
"""
Reproducible confidence-interval engine forensics.

Reads only the supplied files under data/ and writes all artifacts under results/.
Deterministic: no random number generation, no reliance on row order for engine choice.
"""
import json
import os
import csv

import numpy as np

DATA = "data"
OUT = "results"
os.makedirs(OUT, exist_ok=True)

# ----------------------------------------------------------------------
# 1. Manifests
# ----------------------------------------------------------------------
with open(os.path.join(DATA, "study_manifest.json")) as f:
    manifest = json.load(f)
with open(os.path.join(DATA, "probe_manifest.json")) as f:
    probe_manifest = json.load(f)

CONF = float(manifest["confidence_level"])
ALPHA = 1.0 - CONF
CASES = [c["case_id"] for c in manifest["cases"]]
CASE_META = {c["case_id"]: c for c in manifest["cases"]}
ENGINES = list(manifest["engine_ids"])
LABELS = list(manifest["failure_label_vocabulary"])
PROBE_FAMILIES = list(probe_manifest["probe_families"])
assert len(CASES) == 6 and len(ENGINES) == 9 and len(PROBE_FAMILIES) == 5

# ----------------------------------------------------------------------
# 2. Observed samples
# ----------------------------------------------------------------------
obs_raw = {c: {} for c in CASES}
with open(os.path.join(DATA, "observed_samples.csv")) as f:
    for row in csv.DictReader(f):
        obs_raw[row["case_id"]][int(row["observation_id"])] = float(row["value"])
X = {c: np.array([obs_raw[c][i] for i in range(len(obs_raw[c]))]) for c in CASES}

# ----------------------------------------------------------------------
# 3. Public statistic evaluator (last axis = sample axis)
# ----------------------------------------------------------------------
def statistic(arr, name, par):
    if name == "mean":
        return arr.mean(axis=-1)
    if name == "median":
        return np.median(arr, axis=-1)
    if name == "coefficient_of_variation":
        ddof = int(par.get("std_ddof", 1))
        return arr.std(axis=-1, ddof=ddof) / arr.mean(axis=-1)
    if name == "upper_tail_rate":
        thr = par["threshold"]
        if par.get("comparison", ">=") == ">=":
            return (arr >= thr).mean(axis=-1)
        return (arr > thr).mean(axis=-1)
    raise ValueError(name)

def case_stat(c):
    m = CASE_META[c]
    return m["statistic_name"], dict(m.get("statistic_parameters", {}))

# ----------------------------------------------------------------------
# 4. Deterministic reference percentile intervals (observed cases),
#    reconstructed from supplied resampling index panels + observed samples.
# ----------------------------------------------------------------------
rp = np.load(os.path.join(DATA, "resample_panels.npz"))
REF = {}
for c in CASES:
    name, par = case_stat(c)
    bs = statistic(X[c][rp[c]], name, par)
    REF[c] = (float(np.quantile(bs, ALPHA / 2, method="linear")),
              float(np.quantile(bs, 1 - ALPHA / 2, method="linear")))

# ----------------------------------------------------------------------
# 5. Engine panels
# ----------------------------------------------------------------------
pan = np.load(os.path.join(DATA, "engine_interval_panels.npz"))
assert list(pan["engine_ids"]) == ENGINES and list(pan["case_ids"]) == CASES
OL = pan["observed_low"]
OH = pan["observed_high"]
CL = pan["calibration_low"]
CH = pan["calibration_high"]
P2L, P2H = pan["probe_panel_02_low"], pan["probe_panel_02_high"]
P3L, P3H = pan["probe_panel_03_low"], pan["probe_panel_03_high"]
BASE_L, BASE_H = pan["baseline_low"], pan["baseline_high"]
OBS_STAT = pan["observed_stat"]

for ci, c in enumerate(CASES):
    name, par = case_stat(c)
    assert abs(statistic(X[c][None, :], name, par)[0] - OBS_STAT[ci]) < 1e-12

# ----------------------------------------------------------------------
# 6. Per-case targets from calibration samples + coverage diagnostics
# ----------------------------------------------------------------------
cal = np.load(os.path.join(DATA, "calibration_samples.npz"))
N_REP = 108
TARGET = {}
for c in CASES:
    name, par = case_stat(c)
    t = np.array([statistic(cal[c][r][None, :], name, par)[0] for r in range(N_REP)])
    TARGET[c] = float(t.mean())

emp_cov = np.zeros((9, 6))
miss_lo = np.zeros((9, 6))
miss_hi = np.zeros((9, 6))
calib_width = np.zeros((9, 6))
for ci, c in enumerate(CASES):
    tgt = TARGET[c]
    for e in range(9):
        lo, hi = CL[e, ci], CH[e, ci]
        emp_cov[e, ci] = np.mean((lo <= tgt) & (tgt <= hi))
        miss_lo[e, ci] = np.mean(tgt < lo)
        miss_hi[e, ci] = np.mean(tgt > hi)
        calib_width[e, ci] = np.mean(hi - lo)

# ----------------------------------------------------------------------
# 7. Calibration reference distances (neutral extra evidence), from the
#    supplied calibration resampling panels (vectorized).
# ----------------------------------------------------------------------
crp = np.load(os.path.join(DATA, "calibration_resample_panels.npz"))
calib_ref_dist = np.zeros((9, 6))
for ci, c in enumerate(CASES):
    name, par = case_stat(c)
    x = cal[c]
    idx = crp[c]
    bs = statistic(x[np.arange(N_REP)[:, None, None], idx], name, par)
    lo_r = np.quantile(bs, ALPHA / 2, axis=1)
    hi_r = np.quantile(bs, 1 - ALPHA / 2, axis=1)
    for e in range(9):
        calib_ref_dist[e, ci] = np.mean(np.maximum(np.abs(CL[e, ci] - lo_r),
                                                   np.abs(CH[e, ci] - hi_r)))

# ----------------------------------------------------------------------
# 8. Per-engine signatures
# ----------------------------------------------------------------------
ref_lo = np.array([REF[c][0] for c in CASES])
ref_hi = np.array([REF[c][1] for c in CASES])
ref_c = (ref_lo + ref_hi) / 2
ref_w = ref_hi - ref_lo
base_w = BASE_H - BASE_L

obs_dist = np.maximum(np.abs(OL - ref_lo[None, :]), np.abs(OH - ref_hi[None, :]))
obs_dist_total = obs_dist.sum(axis=1)
obs_dist_mean = obs_dist.mean(axis=1)
base_dist = np.maximum(np.abs(OL - BASE_L[None, :]), np.abs(OH - BASE_H[None, :]))

reflection_dist = np.zeros(9)
for e in range(9):
    reflection_dist[e] = np.max(np.maximum(
        np.abs(OL[e] - (2 * OBS_STAT - ref_hi)),
        np.abs(OH[e] - (2 * OBS_STAT - ref_lo))))

width = OH - OL
wr = width / base_w[None, :]
wr_dev_max = np.abs(wr - 1.0).max(axis=1)
wr_dev_mean = np.abs(wr - 1.0).mean(axis=1)
width_ratio = wr.mean(axis=1)

center_dev = (OL + OH) / 2 - ref_c[None, :]
skew_cdev = np.maximum(np.abs(center_dev[:, 1]) / ref_w[1],
                       np.abs(center_dev[:, 5]) / ref_w[5])
ratio_narrow = np.maximum(0.0, 1.0 - wr[:, 2])

p2_width = P2H - P2L
mult = p2_width / width
med_mult = np.median(mult, axis=0)
probe02_diag = np.abs(np.log(mult / med_mult))

p3_center = (P3L + P3H) / 2
probe03_diag = (np.abs(p3_center - ((OL + OH) / 2)[..., None]) / width[..., None]).mean(axis=2)

probe01_diag = np.abs(emp_cov - CONF) + np.abs(miss_lo - miss_hi)
probe00_diag = obs_dist
probe04_diag = base_dist

probe_diag = {"probe_00": probe00_diag, "probe_01": probe01_diag,
              "probe_02": probe02_diag, "probe_03": probe03_diag,
              "probe_04": probe04_diag}
probe_metric = {k: v.mean(axis=1) for k, v in probe_diag.items()}

def norm01(v):
    v = np.asarray(v, dtype=float)
    rng = v.max() - v.min()
    return (v - v.min()) / rng if rng > 0 else np.zeros_like(v)

# ----------------------------------------------------------------------
# 9. Engine audit components + combined score (higher = more reliable)
# ----------------------------------------------------------------------
coverage_gap = np.abs(emp_cov - CONF).mean(axis=1)
tail_imbalance = np.abs(miss_lo - miss_hi).mean(axis=1)
case_dispersion = np.std(obs_dist + np.abs(emp_cov - CONF), axis=1)

ref_component = norm01(obs_dist_mean)
probe_component = norm01(np.mean([probe_metric[k] for k in PROBE_FAMILIES], axis=0))
cov_component = np.mean([norm01(coverage_gap), norm01(tail_imbalance),
                         norm01(np.abs(width_ratio - 1.0)), norm01(case_dispersion)], axis=0)
W_REF, W_PROBE, W_COV = 0.40, 0.40, 0.20

def combined_score(exclude=None):
    fams = [k for k in PROBE_FAMILIES if k != exclude]
    pc = norm01(np.mean([probe_metric[k] for k in fams], axis=0))
    return 1.0 - (W_REF * ref_component + W_PROBE * pc + W_COV * cov_component)

engine_score = combined_score(None)
rank_order = list(np.argsort(-engine_score))
SELECTED = ENGINES[rank_order[0]]

# ----------------------------------------------------------------------
# 10. Failure-label evidence (data-derived signatures, in [0,1])
# ----------------------------------------------------------------------
ev = {
    "reflection_alias": np.exp(-reflection_dist / 0.012) * (1.0 - norm01(wr_dev_max)),
    "discrete_boundary_mismatch": norm01(np.maximum(0.0, 1.0 - wr[:, 3])),
    "shape_correction_mismatch": 0.5 * norm01(skew_cdev) + 0.5 * norm01(ratio_narrow),
    "scale_response_mismatch": norm01(np.abs(mult.mean(axis=1) - np.median(mult.mean(axis=1))))
                               * (1.0 - 0.5 * norm01(obs_dist_total)),
    "noise_amplifying_engine": 0.7 * norm01(wr_dev_mean) + 0.3 * norm01(probe03_diag.mean(axis=1)),
}
calib_dist_mean = calib_ref_dist.mean(axis=1)
bqa_base = (1.0 - 0.5 * norm01(obs_dist_total) - 0.5 * norm01(calib_dist_mean))
bqa_base[rank_order[0]] = 0.0
top_other = np.max([ev[l] for l in LABELS
                    if l not in ("reliable_engine", "baseline_quantile_alias")], axis=0)
ev["baseline_quantile_alias"] = bqa_base * (1.0 - top_other)
top_failure = np.max([ev[l] for l in LABELS if l != "reliable_engine"], axis=0)
ev["reliable_engine"] = (1.0 - norm01(obs_dist_total)) * (1.0 - top_failure)

predicted = {}
for e in range(9):
    predicted[ENGINES[e]] = max(LABELS, key=lambda l: ev[l][e])

# ----------------------------------------------------------------------
# 11. Write results
# ----------------------------------------------------------------------
def write_csv(path, header, rows):
    with open(path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(header)
        w.writerows(rows)

# --- engine_audit.csv
rows = []
for e in range(9):
    rows.append([ENGINES[e], f"{coverage_gap[e]:.6f}", f"{tail_imbalance[e]:.6f}",
                 f"{width_ratio[e]:.6f}", f"{case_dispersion[e]:.6f}"] +
                [f"{probe_metric[k][e]:.6f}" for k in PROBE_FAMILIES] +
                [f"{engine_score[e]:.6f}"])
write_csv(os.path.join(OUT, "engine_audit.csv"),
          ["engine_id", "coverage_gap", "tail_imbalance", "width_ratio", "case_dispersion",
           "probe_metric_00", "probe_metric_01", "probe_metric_02", "probe_metric_03",
           "probe_metric_04", "engine_score"], rows)

# --- coverage_audit.csv (case-major, then engine)
rows = []
for ci, c in enumerate(CASES):
    for e in range(9):
        rows.append([c, CASE_META[c]["regime"], ENGINES[e], f"{CONF:.4f}",
                     f"{emp_cov[e, ci]:.6f}", f"{calib_width[e, ci]:.6f}",
                     f"{miss_lo[e, ci]:.6f}", f"{miss_hi[e, ci]:.6f}",
                     str(N_REP),
                     f"{1.0 - (np.abs(emp_cov[e, ci] - CONF) + np.abs(miss_lo[e, ci] - miss_hi[e, ci])):.6f}"])
write_csv(os.path.join(OUT, "coverage_audit.csv"),
          ["case_id", "regime", "engine_id", "nominal_coverage", "empirical_coverage",
           "mean_width", "miss_low_rate", "miss_high_rate", "n_replications", "coverage_score"], rows)

# --- probe_audit.csv (case, family, engine)
rows = []
for ci, c in enumerate(CASES):
    for fam in PROBE_FAMILIES:
        v = probe_diag[fam][:, ci]
        nrm = norm01(v)
        for e in range(9):
            rows.append([c, fam, ENGINES[e], f"{v[e]:.6f}", f"{nrm[e]:.6f}"])
write_csv(os.path.join(OUT, "probe_audit.csv"),
          ["case_id", "probe_family", "engine_id", "diagnostic_value", "diagnostic_score"], rows)

# --- case_probe_profile.csv (case, engine)
rows = []
for ci, c in enumerate(CASES):
    for e in range(9):
        sigs = [probe_diag[k][e, ci] for k in PROBE_FAMILIES]
        rows.append([c, ENGINES[e]] + [f"{s:.6f}" for s in sigs] + [f"{np.mean(sigs):.6f}"])
write_csv(os.path.join(OUT, "case_probe_profile.csv"),
          ["case_id", "engine_id", "probe_signal_00", "probe_signal_01", "probe_signal_02",
           "probe_signal_03", "probe_signal_04", "profile_score"], rows)

# --- failure_evidence.csv (engine, label; rank 1 = predicted)
rows = []
for e in range(9):
    order = sorted(LABELS, key=lambda l: -ev[l][e])
    for rank, l in enumerate(order, start=1):
        rows.append([ENGINES[e], l, f"{ev[l][e]:.6f}", str(rank),
                     "1" if l == predicted[ENGINES[e]] else "0"])
write_csv(os.path.join(OUT, "failure_evidence.csv"),
          ["engine_id", "failure_label", "evidence_score", "label_rank", "is_predicted_label"], rows)

# --- family_ablation.csv
rows = []
for excl in ["none"] + PROBE_FAMILIES:
    s = combined_score(None if excl == "none" else excl)
    order = list(np.argsort(-s))
    top, runner = ENGINES[order[0]], ENGINES[order[1]]
    sel_rank = int(np.where(order == rank_order[0])[0][0]) + 1
    rows.append([excl, top, str(sel_rank), runner, f"{s[order[0]] - s[order[1]]:.6f}"])
write_csv(os.path.join(OUT, "family_ablation.csv"),
          ["excluded_probe_family", "top_engine_id", "selected_engine_rank",
           "runner_up_engine_id", "score_margin"], rows)

# --- interval_summary.csv
rows = []
se = ENGINES.index(SELECTED)
for ci, c in enumerate(CASES):
    sel_w = OH[se, ci] - OL[se, ci]
    rows.append([c, CASE_META[c]["statistic_name"], f"{OBS_STAT[ci]:.6f}", SELECTED,
                 f"{OL[se, ci]:.6f}", f"{OH[se, ci]:.6f}",
                 f"{BASE_L[ci]:.6f}", f"{BASE_H[ci]:.6f}",
                 f"{sel_w:.6f}", f"{sel_w / base_w[ci]:.6f}"])
write_csv(os.path.join(OUT, "interval_summary.csv"),
          ["case_id", "statistic_name", "observed_stat", "selected_engine_id",
           "selected_low", "selected_high", "baseline_low", "baseline_high",
           "selected_width", "baseline_width_ratio"], rows)

# --- failure_modes.json / selected_engine.json
with open(os.path.join(OUT, "failure_modes.json"), "w") as f:
    json.dump({"selected_engine_id": SELECTED,
               "failure_modes": predicted}, f, indent=2)
with open(os.path.join(OUT, "selected_engine.json"), "w") as f:
    json.dump({"selected_engine_id": SELECTED,
               "selected_failure_mode": predicted[SELECTED],
               "selected_engine_score": float(engine_score[se])}, f, indent=2)

# --- reliability_report.json
case_warnings = {}
for ci, c in enumerate(CASES):
    notes = []
    bad = np.where(np.abs(emp_cov[:, ci] - CONF) > 0.04)[0]
    if bad.size:
        notes.append("coverage deviation >0.04 for " + ", ".join(ENGINES[i] for i in bad))
    narrow = np.where(wr[:, ci] < 0.95)[0]
    if narrow.size:
        notes.append("width ratio <0.95 for " + ", ".join(ENGINES[i] for i in narrow))
    wide = np.where(wr[:, ci] > 1.05)[0]
    if wide.size:
        notes.append("width ratio >1.05 for " + ", ".join(ENGINES[i] for i in wide))
    if CASE_META[c]["regime"] == "discrete_tie":
        notes.append("discrete_tie regime: quantile ties make endpoint differences coarse")
    case_warnings[c] = "; ".join(notes) if notes else "no notable anomalies"
with open(os.path.join(OUT, "reliability_report.json"), "w") as f:
    json.dump({"selected_engine_id": SELECTED,
               "aggregate_coverage_gap": float(coverage_gap[se]),
               "aggregate_tail_imbalance": float(tail_imbalance[se]),
               "aggregate_probe_score": float(np.mean([probe_metric[k][se] for k in PROBE_FAMILIES])),
               "engine_ranking": [ENGINES[e] for e in rank_order],
               "case_warnings": case_warnings}, f, indent=2)

