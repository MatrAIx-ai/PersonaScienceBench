def _draw_text(cv, x, y, s, scale, color):
    cx = x
    for ch in s.upper():
        g = _FONT.get(ch, _FONT[" "])
        for r in range(7):
            bits = g.split()[r]
            for cbit in range(5):
                if bits[cbit] == "1":
                    cv[y + r*scale: y + (r+1)*scale, cx + cbit*scale: cx + (cbit+1)*scale] = color
        cx += 6 * scale

def _fill(cv, x0, y0, x1, y1, color):
    cv[max(0,y0):y1, max(0,x0):x1] = color

def _bars(cv, px, py, pw, ph, vals, title, color_sel=None, log=False):
    _fill(cv, px, py, px+pw, py+ph, (255,255,255))
    _fill(cv, px, py, px+pw, py+2, (0,0,0)); _fill(cv, px, py+ph-2, px+pw, py+ph, (0,0,0))
    _fill(cv, px, py, px+2, py+ph, (0,0,0)); _fill(cv, px+pw-2, py, px+pw, py+ph, (0,0,0))
    _draw_text(cv, px+10, py+8, title, 2, (0,0,0))
    v = np.asarray(vals, dtype=float)
    vv = np.log10(np.clip(v, 1e-6, None)) if log else v
    vmax = max(float(vv.max()), 1e-12)
    n = len(vv)
    base = py + ph - 30
    top = py + 40
    bw = (pw - 60) / n
    for i in range(n):
        h = int((base - top) * vv[i] / vmax)
        x0 = int(px + 30 + i*bw + 3)
        x1 = int(px + 30 + (i+1)*bw - 3)
        col = (0,150,0) if (color_sel is not None and i == color_sel) else (90,120,200)
        _fill(cv, x0, base - h, x1, base, col)
        _draw_text(cv, x0, base + 4, "E%02d" % i, 1, (0,0,0))
    _draw_text(cv, px+10, py+ph-22, "MAX=%.4G" % vmax, 1, (80,80,80))

def _lines(cv, px, py, pw, ph, series, title, sel_idx):
    _fill(cv, px, py, px+pw, py+ph, (255,255,255))
    _fill(cv, px, py, px+pw, py+2, (0,0,0)); _fill(cv, px, py+ph-2, px+pw, py+ph, (0,0,0))
    _fill(cv, px, py, px+2, py+ph, (0,0,0)); _fill(cv, px+pw-2, py, px+pw, py+ph, (0,0,0))
    _draw_text(cv, px+10, py+8, title, 2, (0,0,0))
    allv = np.concatenate([s for s in series])
    lo, hi = float(allv.min()), float(allv.max())
    pad = 0.1 * (hi - lo)
    lo, hi = lo - pad, hi + pad
    left, right = px + 30, px + pw - 20
    top, base = py + 40, py + ph - 30
    def X(k): return int(left + (right-left) * k / 5)
    def Y(v): return int(base - (base-top) * (v-lo) / (hi-lo))
    y10 = Y(1.0)
    for xx in range(left, right, 12):
        cv[y10-1:y10+1, xx:xx+6] = (120,120,120)
    palette = [(0,150,0),(200,0,0),(0,0,200),(200,120,0),(120,0,200),(0,150,150),
               (200,0,120),(120,120,0),(60,60,60)]
    for i, s in enumerate(series):
        col = palette[i] if i != sel_idx else (0,150,0)
        for k in range(5):
            x0, x1 = X(k), X(k+1)
            y0, y1 = Y(s[k]), Y(s[k+1])
            steps = max(abs(x1-x0), abs(y1-y0), 1)
            for t in range(steps+1):
                xx = int(x0 + (x1-x0)*t/steps); yy = int(y0 + (y1-y0)*t/steps)
