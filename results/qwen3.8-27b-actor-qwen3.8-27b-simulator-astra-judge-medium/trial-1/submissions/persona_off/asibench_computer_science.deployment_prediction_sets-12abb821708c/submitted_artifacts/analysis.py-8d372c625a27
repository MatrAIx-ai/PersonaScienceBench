    return _FONT.get(ch, _FONT[' '])

class Canvas:
    def __init__(self, W, H, bg=(255,255,255)):
        self.W=W; self.H=H
        self.a=np.tile(np.array(bg,dtype=np.uint8),(H,W,1))
    def px(self,x,y,c):
        x=int(x); y=int(y)
        if 0<=x<self.W and 0<=y<self.H: self.a[y,x]=c
    def rect(self,x,y,w,h,c,fill=True):
        if fill:
            for yy in range(int(y),int(y+h)):
                for xx in range(int(x),int(x+w)): self.px(xx,yy,c)
        else:
            self.line(x,y,x+w,y,c,1); self.line(x+w,y,x+w,y+h,c,1)
            self.line(x+w,y+h,x,y+h,c,1); self.line(x,y+h,x,y,c,1)
    def hline(self,x0,x1,y,c,t=1):
        for _ in range(t): self.line(x0,y,x1,y,c,1)
    def vline(self,x,y0,y1,c,t=1):
        for _ in range(t): self.line(x,y0,x,y1,c,1)
    def line(self,x0,y0,x1,y1,c,t=1):
        x0,y0,x1,y1=int(x0),int(y0),int(x1),int(y1)
        dx=abs(x1-x0); dy=-abs(y1-y0); sx=1 if x0<x1 else -1
        sy=1 if y0<y1 else -1; err=dx+dy
        while True:
            for ox in range(t):
                for oy in range(t): self.px(x0+ox,y0+oy,c)
            if x0==x1 and y0==y1: break
            e2=2*err
            if e2>=dy: err+=dy; x0+=sx
            if e2<=dx: err+=dx; y0+=sy
    def text(self,x,y,s,scale=1,c=(0,0,0)):
        cx=int(x)
        for ch in str(s):
            g=_glyph(ch)
            for r in range(7):
                for col in range(5):
                    if g[r][col]=='1':
                        for sy in range(scale):
                            for sx in range(scale):
                                self.px(cx+col*scale+sx, y+r*scale+sy, c)
            cx += 6*scale
    def text_w(self,s,scale=1):
        return 6*scale*len(str(s))
    def save(self,path):
        H,W=self.H,self.W
        raw=bytearray()
        for y in range(H):
            raw.append(0); raw.extend(self.a[y].tobytes())
        def chunk(typ,data):
            c=struct.pack(">I",len(data))+typ+data
            return c+struct.pack(">I",zlib.crc32(typ+data)&0xffffffff)
        png=b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack(">IIBBBBB",W,H,8,2,0,0,0))\
            +chunk(b'IDAT',zlib.compress(bytes(raw),9))+chunk(b'IEND',b'')
        open(path,'wb').write(png)

