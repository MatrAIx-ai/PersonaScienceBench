# =================================================================== PLOTS
class Plot:
    def __init__(self, cv, left, top, right, bottom):
        self.cv = cv; self.left = left; self.top = top
        self.right = right; self.bottom = bottom
        self.xmin = 0; self.xmax = 1; self.ymin = 0; self.ymax = 1
    def set_range(self, xmin, xmax, ymin, ymax):
        self.xmin, self.xmax, self.ymin, self.ymax = xmin, xmax, ymin, ymax
    def X(self, x): return self.left + (x - self.xmin) / (self.xmax - self.xmin) * (self.right - self.left)
    def Y(self, y): return self.bottom - (y - self.ymin) / (self.ymax - self.ymin) * (self.bottom - self.top)
    def frame(self):
        cv = self.cv
        cv.line(self.left, self.top, self.right, self.top, BLACK, 1)
        cv.line(self.right, self.top, self.right, self.bottom, BLACK, 1)
        cv.line(self.left, self.top, self.left, self.bottom, BLACK, 1)
        cv.line(self.left, self.bottom, self.right, self.bottom, BLACK, 1)
    def hline(self, y, color, th=1, dash=False):
        py = self.Y(y); cv = self.cv; x = self.left
        if not dash: cv.line(x, py, self.right, py, color, th); return
        while x < self.right: cv.line(x, py, min(x + 6, self.right), py, color, th); x += 12
    def vline(self, x, color, th=1, dash=False):
        px = self.X(x); cv = self.cv; y = self.top
        if not dash: cv.line(px, y, px, self.bottom, color, th); return
        while y < self.bottom: cv.line(px, y, px, min(y + 6, self.bottom), color, th); y += 12
    def plot(self, xs, ys, color, th=2):
        pts = [(self.X(x), self.Y(y)) for x, y in zip(xs, ys)]
        for i in range(len(pts) - 1):
            self.cv.line(pts[i][0], pts[i][1], pts[i + 1][0], pts[i + 1][1], color, th)
    def dot(self, x, y, color, r=3):
        self.cv.rect(self.X(x) - r, self.Y(y) - r, 2 * r, 2 * r, color)
    def bar(self, xc, h, color, w=0.6):
        x0, x1 = self.X(xc - w / 2), self.X(xc + w / 2)
        yb, yt = self.Y(0), self.Y(h)
        self.cv.rect(x0, yt, max(1, x1 - x0), max(1, yb - yt), color)
    def tickx(self, ticks, fmt="%g"):
        for t in ticks:
            px = self.X(t); self.cv.line(px, self.bottom, px, self.bottom + 4, BLACK, 1)
            s = fmt % t; self.cv.text(px - self.cv.text_w(s, 1) / 2, self.bottom + 6, s, 1)
    def ticky(self, ticks, fmt="%g"):
        for t in ticks:
            py = self.Y(t); self.cv.line(self.left - 4, py, self.left, py, BLACK, 1)
            s = fmt % t; self.cv.text(self.left - 8 - self.cv.text_w(s, 1), py - 3, s, 1)

