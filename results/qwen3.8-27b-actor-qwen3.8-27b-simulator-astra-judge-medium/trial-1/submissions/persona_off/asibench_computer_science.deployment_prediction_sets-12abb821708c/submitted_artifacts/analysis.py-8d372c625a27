spec = json.load(open(os.path.join(DATA, "risk_spec.json")))
meta = json.load(open(os.path.join(DATA, "metadata.json")))
target_risk = float(spec["target_risk"])          # 0.1084 hard deployment ceiling
delta = float(spec["delta"])                      # 0.1366 confidence level only
cal_target = 0.09                                 # safety-margin calibration risk
labels = meta["label_columns"]
feat_cols = meta["feature_columns"]
sig_cols = feat_cols[:6]                          # v000-v005 signal block
costs = np.array([float(spec["label_costs"][l]) for l in labels])
L = len(labels)

df_cal_f = pd.read_csv(os.path.join(DATA, "calibration_features.csv"))
df_cal_l = pd.read_csv(os.path.join(DATA, "calibration_labels.csv"))
df_cal_s = pd.read_csv(os.path.join(DATA, "calibration_scores.csv"))
df_dep_f = pd.read_csv(os.path.join(DATA, "deployment_features.csv"))
df_dep_s = pd.read_csv(os.path.join(DATA, "deployment_scores.csv"))

cal_ids = df_cal_s["record_id"].values
dep_ids = df_dep_s["record_id"].values
Xc = df_cal_f[feat_cols].values
Xd = df_dep_f[feat_cols].values
sc = df_cal_s[labels].values.astype(float)
sdd = df_dep_s[labels].values.astype(float)
tl = df_cal_l["true_label"].values
ti = np.array([labels.index(t) for t in tl])
true_score = np.array([sc[i, ti[i]] for i in range(len(sc))])
n, nd = len(sc), len(sdd)
assert n == meta["n_calibration"] and nd == meta["n_deployment"]

# 1) recover 4 proxy strata (public, feature-based)
mu, sd_ = Xc.mean(0), Xc.std(0)
Xc_z = (Xc - mu) / sd_
Xd_z = (Xd - mu) / sd_
K = 4
cent, lab = kmeans2(Xc_z[:, :len(sig_cols)], K, minit="++", seed=0)
order = np.argsort([true_score[lab == c].mean() for c in range(K)])
remap = {old: new for new, old in enumerate(order)}
lab = np.array([remap[l] for l in lab])
labd = np.array([remap[c] for c in np.argmin(
    cdist(Xd_z[:, :len(sig_cols)], cent, "euclidean"), axis=1)])
strat_ids = [f"S{c}" for c in range(K)]

# 2) conformal threshold builder
def conformal_threshold(scores, alpha):
    s = np.sort(np.asarray(scores, float))
    m = len(s)
    if m == 0:
        return 0.0
    k = int(np.ceil(alpha * (m + 1)))
    k = min(max(k, 0), m)
    return float(s[k - 1]) if k >= 1 else 0.0

def build_policy(ct):
    q = np.zeros((K, L))
    for c in range(K):
        for y in range(L):
            al = min(1.0, ct / costs[y])
            q[c, y] = conformal_threshold(true_score[(lab == c) & (ti == y)], al)
    return q

def policy_stats(q):
    cal_risk = float(np.mean([costs[ti[i]] * (sc[i, ti[i]] < q[lab[i], ti[i]])
                              for i in range(n)]))
    cal_size = np.array([int(np.sum(sc[i] >= q[lab[i]])) for i in range(n)])
    dep_size = np.array([int(np.sum(sdd[i] >= q[labd[i]])) for i in range(nd)])
    empty = int((dep_size == 0).sum())
    dep_size_fixed = dep_size.copy()
    dep_size_fixed[dep_size_fixed == 0] = 1        # no empty sets -> add top-1
    return cal_risk, cal_size, dep_size, dep_size_fixed, empty

q = build_policy(cal_target)
cal_risk, cal_size, dep_size, dep_size_fixed, n_empty = policy_stats(q)

# 3) prediction sets (deployment)
sets_rows = []
for i in range(nd):
    c = labd[i]
    keep = [labels[y] for y in range(L) if sdd[i, y] >= q[c, y]]
    if not keep:
        keep = [labels[int(np.argmax(sdd[i]))]]
    sets_rows.append({"record_id": dep_ids[i], "prediction_set": " ".join(keep)})
pd.DataFrame(sets_rows, columns=["record_id", "prediction_set"]).to_csv(
    os.path.join(OUT, "prediction_sets.csv"), index=False)
print("chunk1 ok: prediction_sets written, n_empty_fixed=", n_empty)

# 4) per-stratum / per-cell stats
n_cal_strat = np.bincount(lab, minlength=K)
n_dep_strat = np.bincount(labd, minlength=K)
cal_risk_strat = np.array([float(np.mean([costs[ti[i]] *
                          (sc[i, ti[i]] < q[lab[i], ti[i]])
                          for i in np.where(lab == c)[0]])) for c in range(K)])
cal_size_strat = np.array([float(cal_size[lab == c].mean()) for c in range(K)])
dep_size_strat = np.array([float(dep_size_fixed[labd == c].mean()) for c in range(K)])
dep_p90_strat = np.array([float(np.quantile(dep_size_fixed[labd == c], 0.9))
                          for c in range(K)])
per_rec = np.array([costs[ti[i]] * (sc[i, ti[i]] < q[lab[i], ti[i]])
                    for i in range(n)])
z = float(norm.ppf(1.0 - delta))                   # one-sided (1-delta) z
cal_risk_upper_strat = np.array([
    cal_risk_strat[c] + z * per_rec[lab == c].std(ddof=1) / np.sqrt(n_cal_strat[c])
    for c in range(K)])

# 5) policy_parameters.csv
pp = []
for c in range(K):
    for y in range(L):
        n_cell = int(((lab == c) & (ti == y)).sum())
        pp.append({"proxy_stratum": strat_ids[c], "label": labels[y],
                   "n_calibration": int(n_cal_strat[c]),
                   "n_calibration_label": n_cell,
                   "threshold": round(float(q[c, y]), 6),
                   "group_empirical_weighted_miss_risk": round(float(cal_risk_strat[c]), 6),
                   "group_upper_confidence_risk": round(float(cal_risk_upper_strat[c]), 6),
                   "group_expected_set_size": round(float(cal_size_strat[c]), 4),
                   "calibration_target_risk": cal_target, "target_risk": target_risk})
