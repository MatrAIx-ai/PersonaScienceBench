def _write_png(path, arr):
    import struct
    import zlib
    arr = np.ascontiguousarray(arr, dtype=np.uint8)
    H, W = arr.shape[:2]

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(H))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


class MiniPlot:
    def __init__(self, W, H):
        self.img = np.full((H, W, 3), 255, dtype=np.uint8)

    def _px(self, x, y, color, r=0):
        H, W = self.img.shape[:2]
        x0, x1 = max(0, int(x) - r), min(W, int(x) + r + 1)
        y0, y1 = max(0, int(y) - r), min(H, int(y) + r + 1)
        if x0 < x1 and y0 < y1:
            self.img[y0:y1, x0:x1] = color

    def line(self, x0, y0, x1, y1, color, w=1):
        n = max(2, int(max(abs(x1 - x0), abs(y1 - y0))))
        for i in range(n + 1):
            tt = i / n
            self._px(x0 + (x1 - x0) * tt, y0 + (y1 - y0) * tt, color, w // 2)

    def poly(self, pts, color, w=1):
        for i in range(len(pts) - 1):
            self.line(pts[i][0], pts[i][1], pts[i + 1][0], pts[i + 1][1], color, w)

    def rect(self, x, y, w, h, color, fill=True):
        x, y, w, h = int(x), int(y), int(w), int(h)
        if fill:
            self.img[max(0, y):y + h, max(0, x):x + w] = color
        else:
            self.line(x, y, x + w, y, color)
            self.line(x + w, y, x + w, y + h, color)
            self.line(x + w, y + h, x, y + h, color)
            self.line(x, y + h, x, y, color)

    def text(self, x, y, s, color=(0, 0, 0), scale=1):
        for ch in s.upper():
            g = _FONT.get(ch, _FONT[" "])
            rows = g.split()
            for ry in range(7):
                for rx in range(5):
                    if rows[ry][rx] == "1":
                        self._px(x + rx * scale, y + ry * scale, color, (scale - 1) // 2)
            x += 6 * scale


def make_overview_fallback(t, rows, v, r2, kept_c, dH, a0, aw, edges, n_bins):
    W, H = 1240, 920
    mp = MiniPlot(W, H)
    BLUE = (31, 119, 180)
    RED = (214, 39, 40)
    GREEN = (44, 160, 44)
    ORANGE = (255, 127, 14)
    PURPLE = (148, 103, 189)
    BLACK = (30, 30, 30)
    GREY = (150, 150, 150)
    mp.text(380, 12, "HMC FUNNEL FORENSIC AUDIT OVERVIEW", BLACK, 2)
    panels = [(40, 70, 560, 380), (640, 70, 560, 380), (40, 500, 560, 380), (640, 500, 560, 380)]
    titles = ["FUNNEL PROFILE (KEPT SAMPLES)", "V TRACES (KEPT)", "PRODUCTION AUDIT WINDOW (LAST %d)" % aw, "CANDIDATE AUDIT"]

    def frame(p, title):
        x, y, w, h = p
        mp.rect(x, y, w, h, (250, 250, 250))
        mp.rect(x, y, w, h, BLACK, fill=False)
        mp.text(x + 8, y + 8, title, BLACK, 1)

    # (a) histogram + radius2 lines
    frame(panels[0], titles[0])
    x, y, w, h = panels[0]
    ax0, ay0, awd, aht = x + 40, y + 40, w - 70, h - 90
    counts, _ = np.histogram(v, bins=edges)
    mc = max(counts.max(), 1)
    bw = awd / n_bins
    for b in range(n_bins):
        bh = int(counts[b] / mc * (aht - 10))
        mp.rect(ax0 + b * bw + 2, ay0 + aht - bh, bw - 4, bh, BLUE)
    selms = []
    for b in range(n_bins):
        lo, hi = edges[b], edges[b + 1]
        selm = (v >= lo) & (v < hi) if b < n_bins - 1 else (v >= lo) & (v <= hi)
        selms.append(selm)
    allr = [r2[s].mean() if s.any() else np.nan for s in selms]
    exp2 = [(t.dim - 1) * np.exp(v[s]).mean() if s.any() else np.nan for s in selms]
    mrad = np.nanmax(allr + exp2 + [1.0])
    cx = [ax0 + (b + 0.5) * bw for b in range(n_bins)]
    for b in range(n_bins):
        if not np.isnan(allr[b]):
            yy = ay0 + aht - int(allr[b] / mrad * (aht - 10))
            mp._px(cx[b], yy, RED, 3)
    pts = [(cx[b], ay0 + aht - int(exp2[b] / mrad * (aht - 10))) for b in range(n_bins) if not np.isnan(exp2[b])]
    mp.poly(pts, BLACK, 1)
    mp.text(ax0 + 10, ay0 + aht + 12, "V", BLACK)
    mp.text(ax0 + 150, ay0 - 24, "BLUE: COUNT  RED: MEAN RADIUS2  BLACK: EXPECTED RADIUS2", BLACK)

    # (b) v traces
    frame(panels[1], titles[1])
    x, y, w, h = panels[1]
    ax0, ay0, awd, aht = x + 40, y + 40, w - 70, h - 90
    vv = kept_c[..., 0]
    vmin, vmax = float(vv.min()), float(vv.max())
    cols = [BLUE, RED, GREEN, ORANGE]
    step = max(1, vv.shape[1] // 400)
    for c in range(vv.shape[0]):
        ys = vv[c, ::step]
        pts = [(ax0 + int(i / (len(ys) - 1) * awd),
                ay0 + aht - int((ys[i] - vmin) / (vmax - vmin) * (aht - 10))) for i in range(len(ys))]
        mp.poly(pts, cols[c % 4], 1)
    mp.text(ax0 + 10, ay0 + aht + 12, "KEPT TRANSITIONS", BLACK)
    mp.text(ax0 - 34, ay0 + 4, "V", BLACK)
    mp.text(ax0 - 20, ay0 - 24, "CHAIN 0-3", BLACK)

    # (c) |dH| in audit window
    frame(panels[2], titles[2])
    x, y, w, h = panels[2]
    ax0, ay0, awd, aht = x + 40, y + 40, w - 70, h - 90
    ad = np.log10(1.0 + np.abs(dH[:, a0:]))
    amax = float(ad.max())
    for c in range(ad.shape[0]):
        ys = ad[c, ::max(1, ad.shape[1] // 400)]
        pts = [(ax0 + int(i / (len(ys) - 1) * awd),
                ay0 + aht - int(ys[i] / amax * (aht - 10))) for i in range(len(ys))]
        mp.poly(pts, cols[c % 4], 1)
    mp.text(ax0 + 10, ay0 + aht + 12, "TRANSITION (AUDIT WINDOW)", BLACK)
    mp.text(ax0 - 60, ay0 + 4, "LOG10(1+|DH|)", BLACK)

    # (d) validity + acceptance bars
    frame(panels[3], titles[3])
    x, y, w, h = panels[3]
    ax0, ay0, awd, aht = x + 40, y + 40, w - 70, h - 90
    gw = awd / len(rows)
    for i, r in enumerate(rows):
        h1 = int(r["validity_score"] * (aht - 10))
        h2 = int(r["acceptance_rate"] * (aht - 10))
        mp.rect(ax0 + i * gw + 6, ay0 + aht - h1, gw // 2 - 8, h1, BLUE)
        mp.rect(ax0 + i * gw + gw // 2 + 2, ay0 + aht - h2, gw // 2 - 8, h2, GREEN)
        mp.text(ax0 + i * gw + gw // 2 - 8, ay0 + aht + 12, "K%02d" % i, BLACK)
    mp.line(ax0, ay0 + aht, ax0 + awd, ay0 + aht, BLACK)
    mp.text(ax0 + 150, ay0 - 24, "BLUE: VALIDITY  GREEN: PANEL ACCEPTANCE", BLACK)
    _write_png(os.path.join(OUT, "overview.png"), mp.img)


def make_overview_mpl(t, rows, v, r2, kept_c, dH, a0, aw, edges, n_bins):
    fig, axes = plt.subplots(2, 2, figsize=(12, 9))
    ax = axes[0, 0]
    ax.hist(v, bins=edges, density=True, alpha=0.5, label="v histogram")
    centers = 0.5 * (edges[:-1] + edges[1:])
    selms = []
    for b in range(n_bins):
        lo, hi = edges[b], edges[b + 1]
        selms.append((v >= lo) & (v < hi) if b < n_bins - 1 else (v >= lo) & (v <= hi))
    mr2_b = [r2[s].mean() if s.any() else np.nan for s in selms]
    er2_b = [(t.dim - 1) * np.exp(v[s]).mean() if s.any() else np.nan for s in selms]
    ax2 = ax.twinx()
    ax2.plot(centers, er2_b, "k--", label="expected radius2")
    ax2.plot(centers, mr2_b, "ro", label="mean radius2")
    ax.set_xlabel("v"); ax.set_ylabel("density")
    ax2.set_ylabel("radius2")
    ax.set_title("Funnel profile (kept samples)")
    ax.legend(loc="upper left"); ax2.legend(loc="upper right")

    ax = axes[0, 1]
    xs = np.linspace(0, 1, kept_c.shape[1])[::5]
    for c in range(kept_c.shape[0]):
        ax.plot(xs, kept_c[c, ::5, 0], lw=0.6, label=f"chain {c}")
    ax.set_xlabel("kept transitions (fraction)"); ax.set_ylabel("v")
    ax.set_title("v traces (kept, downsampled)"); ax.legend()

    ax = axes[1, 0]
    for c in range(dH.shape[0]):
        ax.plot(np.abs(dH[c, a0:]), lw=0.4, alpha=0.7)
    ax.set_yscale("log")
    ax.set_xlabel(f"audit window transitions (last {aw})")
    ax.set_ylabel("|delta H|"); ax.set_title("Production audit window")

    ax = axes[1, 1]
    x = np.arange(len(rows))
    ax.bar(x - 0.2, [r["validity_score"] for r in rows], width=0.4, label="validity score")
    ax.bar(x + 0.2, [r["acceptance_rate"] for r in rows], width=0.4, label="panel acceptance")
    ax.set_xticks(x, [r["candidate_id"] for r in rows], rotation=30)
    ax.set_title("Candidate audit"); ax.legend()

    fig.suptitle("HMC funnel forensic audit overview")
    fig.tight_layout()
    fig.savefig(os.path.join(OUT, "overview.png"), dpi=130)
    plt.close(fig)


def fmt(x):
    if isinstance(x, str):
        return x
    if isinstance(x, float):
        return f"{x:.10g}"
    return str(x)


def main():
    os.makedirs(OUT, exist_ok=True)
    m, s = load_target()
    t = Target(m)
    bundle = np.load(os.path.join(DATA, "candidate_transition_bundle.npz"), allow_pickle=True)
    panel = np.load(os.path.join(DATA, "candidate_chain_panel.npz"), allow_pickle=True)

    # ---------------- candidate audit ----------------
    rows = audit_candidates(t, s, bundle, panel)
    labels = assign_labels(rows)
    sel = max(rows, key=lambda r: r["validity_score"])

    cols = ["candidate_id", "energy_rmse", "energy_slope", "reverse_p95",
            "volume_logdet_abs", "acceptance_rate", "panel_mean_v", "panel_var_v",
            "panel_ess_v", "panel_rhat_v", "validity_score"]
    with open(os.path.join(OUT, "kernel_audit.csv"), "w") as f:
        f.write(",".join(cols) + "\n")
        for r in rows:
            f.write(",".join(fmt(r[c]) for c in cols) + "\n")

    with open(os.path.join(OUT, "failure_modes.json"), "w") as f:
        json.dump(labels, f, indent=2)
    base = int(np.argmin(np.abs(bundle["step_size_ladder"] - s["step_size"])))
    with open(os.path.join(OUT, "selected_kernel.json"), "w") as f:
        json.dump({
            "candidate_id": sel["candidate_id"],
            "validity_score": sel["validity_score"],
            "evidence": {
                "energy_rmse_base_step": sel["energy_rmse"],
                "energy_slope": sel["energy_slope"],
                "reverse_p95": sel["reverse_p95"],
                "volume_logdet_abs": sel["volume_logdet_abs"],
                "acceptance_rate": sel["acceptance_rate"],
                "panel_var_v": sel["panel_var_v"],
            },
            "inferred_map": ("18-substep kick-drift-kick leapfrog in sampler coordinates, "
                             "warp-corrected chart gradient, proposal momentum p_n (no flip)"),
            "base_ladder_step": float(bundle["step_size_ladder"][base]),
        }, f, indent=2)

    # ---------------- production replay ----------------
    q0 = np.load(os.path.join(DATA, "initial_latent_states.npy"))
    mom = np.load(os.path.join(DATA, "transition_momenta.npy"))
    uni = np.load(os.path.join(DATA, "transition_uniforms.npy"))
    acc_lat, prop_lat, dH, prob, acc = replay(
        t, q0, mom, uni, s["step_size"], s["integration_steps"])

    warm = s["warmup_transitions"]
    kept = acc_lat[:, warm:, :]
    kept_c = t.to_centered(kept.reshape(-1, t.dim)).reshape(kept.shape)
    np.save(os.path.join(OUT, "latent_samples.npy"), kept)
    np.save(os.path.join(OUT, "samples.npy"), kept_c)

    aw = s["audit_transitions"]
    a0 = s["total_transitions"] - aw
    np.savez(os.path.join(OUT, "transition_audit.npz"),
             accepted_latent=acc_lat[:, a0:, :], proposal_latent=prop_lat[:, a0:, :],
             delta_h=dH[:, a0:], accept_prob=prob[:, a0:], accepted=acc[:, a0:])

    with open(os.path.join(OUT, "energy_diagnostics.csv"), "w") as f:
        f.write("chain_id,acceptance_rate,mean_abs_delta_h,p95_abs_delta_h,max_abs_delta_h\n")
        chain_acc = []
        for c in range(q0.shape[0]):
            a = float(acc[c, :].mean())
            chain_acc.append(a)
            ad = np.abs(dH[c, :])
            f.write(f"{c},{a:.6f},{ad.mean():.6f},{np.percentile(ad, 95):.6f},{ad.max():.6f}\n")

    # ---------------- holdout replay ----------------
    hq0 = np.load(os.path.join(DATA, "holdout_initial_latent_states.npy"))
    hh = np.load(os.path.join(DATA, "holdout_transition_momenta.npy"))
    hu = np.load(os.path.join(DATA, "holdout_transition_uniforms.npy"))
    hacc_lat, hprop_lat, hdH, hprob, hacc = replay(
        t, hq0, hh, hu, s["holdout_step_size"], s["holdout_integration_steps"])
    ha = s["holdout_audit_transitions"]
    np.savez(os.path.join(OUT, "holdout_transition_audit.npz"),
             accepted_latent=hacc_lat[:, -ha:, :], proposal_latent=hprop_lat[:, -ha:, :],
             delta_h=hdH[:, -ha:], accept_prob=hprob[:, -ha:], accepted=hacc[:, -ha:])
    np.save(os.path.join(OUT, "holdout_terminal_states.npy"), hacc_lat[:, -1, :])

    # ---------------- funnel profile ----------------
    bins = np.genfromtxt(os.path.join(DATA, "profile_bins.csv"), delimiter=",", names=True)
    edges = np.concatenate([bins["v_left"], [bins["v_right"][-1]]])
    v = kept_c[..., 0].reshape(-1)
    r2 = np.sum(kept_c[..., 1:] ** 2, axis=-1).reshape(-1)
    with open(os.path.join(OUT, "funnel_profile.csv"), "w") as f:
        f.write("bin_id,v_left,v_right,count,fraction,mean_v,mean_radius2,expected_radius2\n")
        for b in range(len(bins)):
            lo, hi = float(bins["v_left"][b]), float(bins["v_right"][b])
            selm = (v >= lo) & (v < hi) if b < len(bins) - 1 else (v >= lo) & (v <= hi)
            n_b = int(selm.sum())
            if n_b > 0:
                mv = float(v[selm].mean())
                mr2 = float(r2[selm].mean())
                er2 = float((t.dim - 1) * np.exp(v[selm]).mean())
            else:
                mv = mr2 = er2 = 0.0
            f.write(f"{b},{lo},{hi},{n_b},{n_b / v.size:.6f},{mv:.6f},{mr2:.6f},{er2:.6f}\n")

    # ---------------- diagnostics ----------------
    kp = s["kept_transitions"]
    z = t.z_res(kept_c.reshape(-1, t.dim))
    diag = {
        "mean_v": float(v.mean()),
        "var_v": float(v.var(ddof=1)),
        "mean_radius2": float(r2.mean()),
        "split_rhat_v": split_rhat([kept_c[c, :, 0] for c in range(kept.shape[0])]),
        "ess_v": ess_ips(v),
        "split_rhat_radius2": split_rhat([r2[c * kp:(c + 1) * kp] for c in range(kept.shape[0])]),
        "ess_radius2": ess_ips(r2),
        "overall_acceptance_rate": float(acc.mean()),
        "chain_acceptance_rates": chain_acc,
        "mean_abs_delta_h": float(np.abs(dH).mean()),
        "p95_abs_delta_h": float(np.percentile(np.abs(dH), 95)),
        "max_abs_delta_h": float(np.abs(dH).max()),
        "latent_mean_abs_max": float(np.max(np.abs(z.mean(axis=0)))),
        "latent_var_abs_max": float(np.max(z.var(axis=0, ddof=1))),
        "left_tail_prob_v_lt_minus5": float(np.mean(v < -5.0)),
        "right_tail_prob_v_gt_5": float(np.mean(v > 5.0)),
    }
    with open(os.path.join(OUT, "diagnostics.json"), "w") as f:
        json.dump(diag, f, indent=2)

    # ---------------- overview figure ----------------
    if HAVE_MPL:
        make_overview_mpl(t, rows, v, r2, kept_c, dH, a0, aw, edges, len(bins))
    else:
        make_overview_fallback(t, rows, v, r2, kept_c, dH, a0, aw, edges, len(bins))

    # ---------------- console report ----------------
    print("== selected kernel ==")
    print(sel["candidate_id"], "validity_score=%.4f" % sel["validity_score"])
    print("== failure modes ==")
    for cid in sorted(labels):
        print(f"  {cid}: {labels[cid]}")
    print("== kernel audit ==")
    for r in rows:
        print(f"  {r['candidate_id']}: rmse={r['energy_rmse']:.3e} slope={r['energy_slope']:.3f} "
              f"rev_p95={r['reverse_p95']:.3e} vol={r['volume_logdet_abs']:.3e} "
              f"acc={r['acceptance_rate']:.3f} var_v={r['panel_var_v']:.3f} "
              f"ess={r['panel_ess_v']:.1f} rhat={r['panel_rhat_v']:.3f} "
              f"validity={r['validity_score']:.4f}")
    print("== production replay ==")
    print("overall acceptance (full stream): %.4f" % diag["overall_acceptance_rate"])
    print("chain acceptance:", ["%.4f" % a for a in chain_acc])
    print("split_rhat_v=%.4f ess_v=%.1f" % (diag["split_rhat_v"], diag["ess_v"]))
    print("kept: mean_v=%.3f var_v=%.3f mean_radius2=%.3f" % (diag["mean_v"], diag["var_v"], diag["mean_radius2"]))
    print("latent_mean_abs_max=%.4f latent_var_abs_max=%.4f" % (diag["latent_mean_abs_max"], diag["latent_var_abs_max"]))
    print("tails: P(v<-5)=%.4f P(v>5)=%.4f" % (diag["left_tail_prob_v_lt_minus5"], diag["right_tail_prob_v_gt_5"]))
    print("delta_h: mean_abs=%.4f p95_abs=%.4f max_abs=%.4f" % (diag["mean_abs_delta_h"], diag["p95_abs_delta_h"], diag["max_abs_delta_h"]))
    print("holdout acceptance: %.4f" % hacc.mean())
    print("kept v range: [%.3f, %.3f]" % (v.min(), v.max()))
    for name, arr in [("kept", kept), ("kept_c", kept_c), ("dH", dH), ("prob", prob),
                      ("hdH", hdH), ("hacc_lat", hacc_lat)]:
        if not np.isfinite(arr).all():
            WARNINGS.append(f"non-finite output in {name}")
    print("warnings:", WARNINGS if WARNINGS else "none")


if __name__ == "__main__":
    main()
