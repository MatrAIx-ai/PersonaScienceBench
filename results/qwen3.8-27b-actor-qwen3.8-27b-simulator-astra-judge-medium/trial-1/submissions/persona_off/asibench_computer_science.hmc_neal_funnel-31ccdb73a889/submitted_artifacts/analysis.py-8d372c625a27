class Target:
    """Funnel target: chart, potential, kinetic metric, leapfrog transition."""

    def __init__(self, m):
        self.dim = int(m["dimension"])
        self.sv = float(m["sigma_v"])
        self.G = np.asarray(m["kinetic_metric"]["inverse_mass_matrix"], dtype=float)
        self.M = np.asarray(m["sampler_chart"]["matrix"], dtype=float)
        self.shift = np.asarray(m["sampler_chart"]["shift"], dtype=float)
        self.w = float(m["sampler_chart"]["warp_strength"])
        self.ph = np.asarray(m["sampler_chart"]["warp_phase"], dtype=float)
        self.ids = list(m["public_candidate_ids"])

    def to_centered(self, q):
        q = np.atleast_2d(q)
        u = (q - self.shift) @ self.M.T
        c = u.copy()
        c[:, 1:] = u[:, 1:] + self.w * np.sin(u[:, 0:1] + self.ph)
        return c

    def to_sampler(self, c):
        c = np.atleast_2d(c)
        u = c.copy()
        u[:, 1:] = c[:, 1:] - self.w * np.sin(c[:, 0:1] + self.ph)
        # exact inverse of u = (q - shift) @ M.T  (M is not orthogonal)
        return u @ np.linalg.inv(self.M.T) + self.shift

    def U(self, c):
        c = np.atleast_2d(c)
        v = c[:, 0]
        x = c[:, 1:]
        return 0.5 * (v / self.sv) ** 2 + 0.5 * (self.dim - 1) * v \
            + 0.5 * np.exp(-v) * np.sum(x ** 2, axis=1)

    def gradU_c(self, c):
        c = np.atleast_2d(c)
        v = c[:, 0]
        x = c[:, 1:]
        e = np.exp(-v)
        g = np.empty_like(c)
        g[:, 0] = v / self.sv ** 2 + 0.5 * (self.dim - 1) - 0.5 * e * np.sum(x ** 2, axis=1)
        g[:, 1:] = e[:, None] * x
        return g

    def gradU_q(self, q):
        c = self.to_centered(q)
        u = c.copy()
        u[:, 1:] = c[:, 1:] - self.w * np.sin(c[:, 0:1] + self.ph)
        gu = self.gradU_c(c)
        gu[:, 0] = gu[:, 0] + self.w * np.sum(gu[:, 1:] * np.cos(u[:, 0:1] + self.ph), axis=1)
        return gu @ self.M

    def K(self, p):
        p = np.atleast_2d(p)
        return 0.5 * np.einsum("ij,jk,ik->i", p, self.G, p)

    def H(self, q, p):
        return self.U(self.to_centered(q)) + self.K(p)

    def z_res(self, c):
        c = np.atleast_2d(c)
        v = c[:, 0]
        z = np.empty_like(c)
        z[:, 0] = v / self.sv
        z[:, 1:] = np.exp(-v / 2.0)[:, None] * c[:, 1:]
        return z

    def leapfrog(self, q, p, h, n):
        q = np.asarray(q, dtype=float)
        p = np.asarray(p, dtype=float)
        p = p - 0.5 * h * self.gradU_q(q)
        for k in range(n):
            q = q + h * (self.G @ p.T).T
            if k < n - 1:
                p = p - h * self.gradU_q(q)
        p = p - 0.5 * h * self.gradU_q(q)
        return q, p  # proposal momentum p_n (no terminal flip)


def ess_ips(x):
    """Initial-positive-sequence (Geyer) ESS estimate."""
    x = np.asarray(x, dtype=float)
    n = len(x)
    xc = x - x.mean()
    acov = np.correlate(xc, xc, "full")[n - 1:]
    M = n // 2
    S = acov[0]
    for k in range(2, M, 2):
        s = acov[k] + (acov[k + 1] if k + 1 < n else 0.0)
        if s <= 0:
            break
        S += s
    return float(n * acov[0] / S) if S > 0 else float(n)


def split_rhat(chains):
    """Standard split R-hat; each chain split in half."""
    chains = [np.asarray(c, dtype=float) for c in chains]
    n = min(len(c) for c in chains) // 2
    halves = np.stack([c[:n] for c in chains] + [c[n:2 * n] for c in chains])
    m, nn = halves.shape
    within = halves.var(axis=1, ddof=1).mean()
    between = halves.mean(axis=1).var(ddof=1)
    V = (nn - 1) / nn * within + between / nn
    return float(np.sqrt(V / within))


def linear_score(x, full, zero):
    if x <= full:
        return 1.0
    if x >= zero:
        return 0.0
    return (zero - x) / (zero - full)


def audit_candidates(t, s, bundle, panel):
    ladder = bundle["step_size_ladder"]
    base = int(np.argmin(np.abs(ladder - s["step_size"])))
    ps, pm = bundle["probe_states"], bundle["probe_momenta"]
    H0 = t.H(ps, pm)
    vi = bundle["volume_input"]
    X = np.c_[vi, np.ones(len(vi))]

    rows = []
    for i, cid in enumerate(bundle["candidate_ids"]):
        rmse = []
        for b in range(len(ladder)):
            dH = t.H(bundle["proposal_states"][i, b], bundle["proposal_momenta"][i, b]) - H0
            rmse.append(float(np.sqrt(np.mean(dH ** 2))))
        energy_rmse = rmse[base]
        energy_slope = float(np.polyfit(np.log(ladder), np.log(rmse), 1)[0])
        rev = (np.linalg.norm(bundle["reverse_states"][i, base] - ps, axis=1)
               + np.linalg.norm(bundle["reverse_momenta"][i, base] + pm, axis=1))
        reverse_p95 = float(np.percentile(rev, 95))
        A_b = np.linalg.lstsq(X, bundle["volume_output"][i], rcond=None)[0]
        A = A_b[: len(vi[0])]
        volume_logdet_abs = float(abs(np.linalg.slogdet(A)[1]))
        acc = panel["panel_accepted"][i]
        acceptance_rate = float(acc.mean())
        v = panel["panel_centered_samples"][i, :, :, 0]
        panel_mean_v = float(v.mean())
        panel_var_v = float(v.reshape(len(v), -1).var(ddof=1))
        panel_rhat_v = split_rhat([v[j, :] for j in range(len(v))])
        panel_ess_v = ess_ips(v.reshape(-1))
        score = (0.24 * linear_score(energy_rmse, 0.01, 0.18)
                 + 0.24 * linear_score(reverse_p95, 1e-8, 5e-3)
                 + 0.20 * linear_score(volume_logdet_abs, 1e-5, 0.08)
                 + 0.16 * linear_score(abs(panel_var_v - t.sv ** 2) / t.sv ** 2, 0.08, 0.55)
                 + 0.16 * linear_score(abs(0.82 - acceptance_rate), 0.25, 0.80))
        rows.append(dict(candidate_id=cid, energy_rmse=energy_rmse, energy_slope=energy_slope,
                         reverse_p95=reverse_p95, volume_logdet_abs=volume_logdet_abs,
                         acceptance_rate=acceptance_rate, panel_mean_v=panel_mean_v,
                         panel_var_v=panel_var_v, panel_ess_v=panel_ess_v,
                         panel_rhat_v=panel_rhat_v, validity_score=float(score)))
    return rows


def assign_labels(rows):
    """Data-driven canonical label assignment (see plan)."""
    valid = max(rows, key=lambda r: r["validity_score"])["candidate_id"]
    rest = [r for r in rows if r["candidate_id"] != valid]
    coord = max(rest, key=lambda r: r["reverse_p95"])["candidate_id"]
    rest = [r for r in rest if r["candidate_id"] != coord]
    vol = max(rest, key=lambda r: r["volume_logdet_abs"])["candidate_id"]
    rest = [r for r in rest if r["candidate_id"] != vol]
    drift = max(rest, key=lambda r: r["energy_rmse"])["candidate_id"]
    rest = [r for r in rest if r["candidate_id"] != drift]
    assert len(rest) == 2, f"expected 2 remaining candidates, got {len(rest)}"
    delayed = min(rest, key=lambda r: r["energy_slope"])["candidate_id"]
    terminal = [r["candidate_id"] for r in rest if r["candidate_id"] != delayed][0]
    return {valid: "valid_transition", coord: "coordinate_mismatch",
            vol: "volume_loss", drift: "energy_drift",
            delayed: "delayed_response", terminal: "terminal_imbalance"}


def replay(t, q0, momenta, uniforms, h, n_steps):
    """Replay one stream. Returns per-transition arrays (T, ...)."""
    T = momenta.shape[1]
    n_ch = q0.shape[0]
    q = np.atleast_2d(q0).copy()
    accepted_latent = np.empty((n_ch, T, t.dim))
    proposal_latent = np.empty((n_ch, T, t.dim))
    delta_h = np.empty((n_ch, T))
    accept_prob = np.empty((n_ch, T))
    accepted = np.empty((n_ch, T), dtype=bool)
    for k in range(T):
        p = momenta[:, k, :]
        with np.errstate(over="ignore", invalid="ignore"):
            qp, pp = t.leapfrog(q, p, h, n_steps)
            dH = t.H(qp, pp) - t.H(q, p)
            prob = np.minimum(1.0, np.exp(-np.clip(dH, None, 700.0)))
        acc = uniforms[:, k] < prob
        if not (np.isfinite(qp).all() and np.isfinite(dH).all()):
            WARNINGS.append(f"non-finite values at transition {k}")
        q = np.where(acc[:, None], qp, q)
        accepted_latent[:, k] = q
        proposal_latent[:, k] = qp
        delta_h[:, k] = dH
        accept_prob[:, k] = prob
        accepted[:, k] = acc
    return accepted_latent, proposal_latent, delta_h, accept_prob, accepted


