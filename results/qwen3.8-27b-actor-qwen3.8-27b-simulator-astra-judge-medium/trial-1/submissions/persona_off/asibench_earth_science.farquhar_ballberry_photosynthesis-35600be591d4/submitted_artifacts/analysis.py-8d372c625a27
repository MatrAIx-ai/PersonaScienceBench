def _fb_text(img, x, y, s, color, scale=2):
    H, W, _ = img.shape
    cx = x
    for ch in s:
        g = _FONT.get(ch) or _FONT.get(ch.upper()) or _FONT[' ']
        for r in range(7):
            for c in range(5):
                if g[r][c] == '1':
                    for dr in range(scale):
                        for dc in range(scale):
                            xx = cx + c * scale + dc
                            yy = y + r * scale + dr
                            if 0 <= xx < W and 0 <= yy < H:
                                img[yy, xx] = color
        cx += 6 * scale
    return cx - x


def _fb_line(img, x0, y0, x1, y1, color, w=1):
    H, W, _ = img.shape
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    while True:
        for dc in range(-(w // 2), w // 2 + 1):
            for dr in range(-(w // 2), w // 2 + 1):
                xx, yy = x0 + dc, y0 + dr
                if 0 <= xx < W and 0 <= yy < H:
                    img[yy, xx] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy
            x0 += sx
        if e2 < dx:
            err += dx
            y0 += sy


def _fb_polyline(img, pts, color, w=2, dash=None):
    n = len(pts)
    if n < 2:
        return
    if dash is None:
        for i in range(n - 1):
            _fb_line(img, int(pts[i][0]), int(pts[i][1]),
                     int(pts[i + 1][0]), int(pts[i + 1][1]), color, w)
        return
    on, off = dash
    fine = [pts[0] + (0.0,)]
    for i in range(n - 1):
        x0, y0 = pts[i]; x1, y1 = pts[i + 1]
        seg = math.hypot(x1 - x0, y1 - y0)
        nsub = max(1, int(round(seg)))
        for s in range(1, nsub + 1):
            t = s / nsub
            cx = x0 + (x1 - x0) * t
            cy = y0 + (y1 - y0) * t
            acc = math.hypot(cx - fine[-1][0], cy - fine[-1][1])
            fine.append((cx, cy, fine[-1][2] + acc))
    for i in range(len(fine) - 1):
        dmid = 0.5 * (fine[i][2] + fine[i + 1][2])
        if (dmid % (on + off)) < on:
            _fb_line(img, int(fine[i][0]), int(fine[i][1]),
                     int(fine[i + 1][0]), int(fine[i + 1][1]), color, w)


def _fb_write_png(path, img):
    import zlib, struct
    H, W, _ = img.shape
    raw = b""
    for row in img:
        raw += b"\x00" + row.tobytes()

    def chunk(typ, data):
        c = struct.pack(">I", len(data)) + typ + data
        c += struct.pack(">I", zlib.crc32(typ + data) & 0xffffffff)
        return c

    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)
    png = sig + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b"")
    with open(path, "wb") as fh:
        fh.write(png)


def _fallback_figure(path, flux):
    W, H = 1000, 700
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    black = (0, 0, 0); green = (0, 120, 0); red = (190, 0, 0); grid = (228, 228, 228)

    title = "DIURNAL A AND RS  (C4 LEAF)"
    _fb_text(img, (W - len(title) * 6 * 2) // 2, 12, title, black, 2)

    tlo = float(flux["time_hr"].min()); thi = float(flux["time_hr"].max())
    x0, x1 = 95, 975
    tt = flux["time_hr"].to_numpy(dtype=float)

    def panel(ax0, ay0, ax1, ay1, sun, shade, ylo, yhi, yticks, linecol, ylab):
        _fb_line(img, ax0, ay0, ax1, ay0, black, 1)
        _fb_line(img, ax0, ay1, ax1, ay1, black, 1)
        _fb_line(img, ax0, ay0, ax0, ay1, black, 1)
        _fb_line(img, ax1, ay0, ax1, ay1, black, 1)
        for yt in yticks:
            py = int(ay1 - (yt - ylo) / (yhi - ylo) * (ay1 - ay0))
            _fb_line(img, ax0, py, ax1, py, grid, 1)
            lab = str(int(yt))
            _fb_text(img, ax0 - 8 - len(lab) * 6, py - 3, lab, black, 1)
        for xt in [0, 20, 40, 60, 80, 100, 120]:
            if xt > thi:
                continue
            px = int(ax0 + (xt - tlo) / (thi - tlo) * (ax1 - ax0))
            _fb_line(img, px, ay1, px, ay1 + 4, black, 1)
            lab = str(xt)
            _fb_text(img, px - len(lab) * 3, ay1 + 7, lab, black, 1)

        def pts(arr):
            arr = np.asarray(arr, dtype=float)
            px = ax0 + (tt - tlo) / (thi - tlo) * (ax1 - ax0)
            py = ay1 - (arr - ylo) / (yhi - ylo) * (ay1 - ay0)
            return list(zip(px, py))
        _fb_polyline(img, pts(shade), linecol, 2, dash=(9, 5))
        _fb_polyline(img, pts(sun), linecol, 3, dash=None)

        _fb_text(img, ax0 - 8, ay0 - 24, ylab, black, 2)
        lx, ly = ax1 - 150, ay0 + 12
        _fb_line(img, lx, ly + 6, lx + 30, ly + 6, linecol, 3)
        _fb_text(img, lx + 36, ly, "SUN", black, 1)
        _fb_polyline(img, [(lx, ly + 28), (lx + 30, ly + 28)], linecol, 2, dash=(6, 4))
        _fb_text(img, lx + 36, ly + 22, "SHADE", black, 1)

    A = np.concatenate([flux["A_sun"].to_numpy(), flux["A_shade"].to_numpy()])
    ylo = math.floor(A.min() / 10) * 10
    yhi = math.ceil(A.max() / 10) * 10
    panel(x0, 55, x1, 340, flux["A_sun"], flux["A_shade"], ylo, yhi,
          list(range(int(ylo), int(yhi) + 1, 10)), green, "A (UMOL/M2/S)")

    rr = np.concatenate([flux["rs_sun"].to_numpy(), flux["rs_shade"].to_numpy()])
    yhi = math.ceil(rr.max() / 200) * 200
    panel(x0, 400, x1, 655, flux["rs_sun"], flux["rs_shade"], 0, yhi,
          list(range(0, int(yhi) + 1, 200)), red, "RS (S/M)")

    xl = "TIME (H)"
    _fb_text(img, (W - len(xl) * 6 * 2) // 2, 676, xl, black, 2)
    _fb_write_png(path, img)


def make_figure(flux, path):
    """Render the diurnal figure with matplotlib if present, else fallback."""
    if HAS_MPL:
        x = flux["time_hr"]
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 7), sharex=True)
        ax1.plot(x, flux["A_sun"], color="tab:green", label="A  sun")
        ax1.plot(x, flux["A_shade"], color="tab:green", ls="--", label="A  shade")
        ax1.axhline(0.0, color="k", lw=0.6, alpha=0.5)
        ax1.set_ylabel("A  (umol CO$_2$ m$^{-2}$ s$^{-1}$)")
        ax1.set_title("Diurnal leaf response  (C4  coupled Farquhar-Collatz / Ball-Berry)")
        ax1.legend(loc="upper left"); ax1.grid(alpha=0.3)
        ax2.plot(x, flux["rs_sun"], color="tab:red", label="rs  sun")
        ax2.plot(x, flux["rs_shade"], color="tab:red", ls="--", label="rs  shade")
        ax2.set_ylabel("rs  (s m$^{-1}$)")
        ax2.set_xlabel("time  (h)")
        ax2.legend(loc="upper right"); ax2.grid(alpha=0.3)
        fig.tight_layout()
        fig.savefig(path, dpi=150)
        plt.close(fig)
    else:
        _fallback_figure(path, flux)


def main():
    base = os.path.dirname(os.path.abspath(__file__))
    data_dir = os.path.join(base, "data")
    out_dir = os.path.join(base, "results")
    os.makedirs(out_dir, exist_ok=True)

    with open(os.path.join(data_dir, "leaf_params.json")) as fh:
        p = json.load(fh)
    p["m"] = p["bb_slope"]              # Ball-Berry slope
    p["b0"] = p["bb_intercept"]         # Ball-Berry intercept (NOT btran-scaled)

    forcing = pd.read_csv(os.path.join(data_dir, "forcing.csv"))
    with open(os.path.join(data_dir, "test_cases.json")) as fh:
        cases = json.load(fh)

    # ------------------------------------------------------------------
    # leaf_fluxes.csv : one row per forcing row (sun & shade)
    # ------------------------------------------------------------------
    flux_cols = ["time_hr", "A_sun", "A_shade", "rs_sun", "rs_shade",
                 "ci_sun", "ci_shade", "gs_sun", "gs_shade"]
    rows = []
    prev_ci = {"sun": None, "shade": None}   # warm start (result init-independent)
    fb_rows = []                              # rows needing the bisection fallback
    for _, r in forcing.iterrows():
        out = {"time_hr": r["time_hr"]}
        for leaf, parcol in (("sun", "par_sun_wm2"), ("shade", "par_shade_wm2")):
            par = r[parcol]
            ci_init = prev_ci[leaf] if prev_ci[leaf] is not None else r["co2_pa"]
            ci, a, rs, gs, cs, n_iter, fb = evaluate(
                par, r["t_air_K"], r["p_atm_Pa"], r["co2_pa"], r["o2_pa"],
                r["vpd_Pa"], r["rb_sm"], r["btran"], p, ci_init)
            out[f"A_{leaf}"] = a
            out[f"rs_{leaf}"] = rs
            out[f"ci_{leaf}"] = ci
            out[f"gs_{leaf}"] = gs
            prev_ci[leaf] = ci
            if fb:
                fb_rows.append((r["time_hr"], leaf))
        rows.append(out)
    flux = pd.DataFrame(rows, columns=flux_cols)
    flux.to_csv(os.path.join(out_dir, "leaf_fluxes.csv"), index=False,
                float_format="%.6f")

    # ------------------------------------------------------------------
    # case_convergence.csv : one row per test case (sunlit, 0-based index)
    # ------------------------------------------------------------------
    case_cols = ["case_id", "ci_init_pa", "ci_final_pa", "A_final",
                 "rs_final", "n_iterations"]
    crows = []
    for c in cases:
        r = forcing.iloc[c["forcing_index"]]          # 0-based
        par = r["par_sun_wm2"]                        # A8: sunlit leaf
        ci_init = c["ci_init_pa"]
        ci, a, rs, gs, cs, n_iter, fb = evaluate(
            par, r["t_air_K"], r["p_atm_Pa"], r["co2_pa"], r["o2_pa"],
            r["vpd_Pa"], r["rb_sm"], r["btran"], p, ci_init)
        crows.append({"case_id": c["case_id"], "ci_init_pa": ci_init,
                      "ci_final_pa": ci, "A_final": a, "rs_final": rs,
                      "n_iterations": int(n_iter)})
    ccase = pd.DataFrame(crows, columns=case_cols)
    ccase.to_csv(os.path.join(out_dir, "case_convergence.csv"), index=False,
                 float_format="%.6f")

    # ------------------------------------------------------------------
