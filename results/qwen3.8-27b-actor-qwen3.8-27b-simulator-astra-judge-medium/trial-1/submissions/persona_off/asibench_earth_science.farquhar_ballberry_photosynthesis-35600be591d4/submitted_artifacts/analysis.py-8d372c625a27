# ----------------------------------------------------------------------------
# Constants / conventions
# ----------------------------------------------------------------------------
R = 8.31446                 # universal gas constant, J mol^-1 K^-1
KC25 = 30.0                 # Kc at 25 C, Pa
KO25 = 30000.0              # Ko at 25 C, Pa
Q10_KC, Q10_KO, Q10_GS = 2.1, 1.2, 2.4     # Q10 for (Kc, Ko, Gamma_star)
RATIO_O2 = 0.21             # factor in Gamma_star = 0.5*(Kc/Ko)*O2*0.21
RD_FRAC = 0.015             # Rd = 0.015 * Vcmax
APAR_COEF = 4.6             # APAR = 4.6 * PAR (no extra absorptance)
NIGHT_PAR = 1e-6            # W m^-2 ; below this -> night branch

TOL_CI = 1e-9               # Pa, successive-substitution convergence
MAX_ITER = 100              # max successive-substitution iterations
MAX_BISECT = 200            # max bisection iterations (fallback)


def esat_magnus(t_c):
    """Saturation vapour pressure [Pa], Magnus formula, t in Celsius."""
    return 611.2 * np.exp(17.67 * t_c / (t_c + 243.5))


def vcmax_temperature(t_c, vcmax25, n_factor, btran):
    """Temperature-scaled photosynthetic capacity.

    Vcmax = Vcmax25 * n_factor * btran * 2.4^((Tc-25)/10) / (1+exp(...)).
    n_factor and btran scale the capacity (and therefore Rd = 0.015*Vcmax).
    """
    q = 2.4 ** ((t_c - 25.0) / 10.0)
    t_k = t_c + 273.16
    inh = 1.0 / (1.0 + np.exp((-2.2e5 + 710.0 * t_k) / (R * t_k)))
    return vcmax25 * n_factor * btran * q * inh


def c3_constants(t_c, o2_pa):
    """Temperature-scaled Kc, Ko, Gamma_star for the C3 branch."""
    kc = KC25 * Q10_KC ** ((t_c - 25.0) / 10.0)
    ko = KO25 * Q10_KO ** ((t_c - 25.0) / 10.0)
    gs25 = 0.5 * (KC25 / KO25) * o2_pa * RATIO_O2
    gamma_star = gs25 * Q10_GS ** ((t_c - 25.0) / 10.0)
    return kc, ko, gamma_star


def assimilation(par, ci, vcmax, rd, alpha_q, pathway, t_c, o2_pa, p_atm):
    """Net assimilation A [umol m^-2 s^-1] = min(Wc,Wj,We) - Rd at internal Ci."""
    wj = alpha_q * APAR_COEF * par
    if pathway == "C4":
        wc = vcmax
        we = 4000.0 * vcmax * ci / p_atm
    else:  # C3
        kc, ko, gamma_star = c3_constants(t_c, o2_pa)
        wc = vcmax * (ci - gamma_star) / (ci + kc * (1.0 + o2_pa / ko))
        we = 0.5 * vcmax
    return min(wc, wj, we) - rd


def day_step(ci, par, t_air, p_atm, ca, o2_pa, vpd, rb, btran, p):
    """One coupled step for a daytime leaf.

    Returns (ci_new, a_umol, rs, gs, cs).  a_umol in umol m^-2 s^-1,
    a_mol = a_umol*1e-6 mol m^-2 s^-1.
    """
    t_c = t_air - 273.15
    vcmax = vcmax_temperature(t_c, p["vcmax25"], p["n_factor"], btran)
    rd = RD_FRAC * vcmax
    a = assimilation(par, ci, vcmax, rd, p["alpha_q"], p["pathway"], t_c, o2_pa, p_atm)
    a_mol = a * 1e-6
    cf = p_atm / (R * t_air)
    h_s = min(max(1.0 - vpd / esat_magnus(t_c), 0.25), 1.0)
    cs = ca - 1.37 * rb * a_mol / cf * p_atm
    gs = p["m"] * a_mol * h_s / cs * p_atm + p["b0"]   # b0 NOT scaled by btran
    rs = cf / gs
    ci_new = cs - 1.65 * rs * a_mol / cf * p_atm
    return ci_new, a, rs, gs, cs


def solve_daytime(par, t_air, p_atm, ca, o2_pa, vpd, rb, btran, p, ci_init):
    """Solve the coupled fixed point for a daytime leaf.

    Successive substitution Ci_{k+1}=Ci_new(Ci_k) seeded by ci_init; converges
    when |Ci_{k+1}-Ci_k| < TOL_CI.  Bisection fallback on f(Ci)=Ci_new(Ci)-Ci.
    Returns (ci_final, a, rs, gs, cs, n_iter, used_fallback).
    """
    args = (par, t_air, p_atm, ca, o2_pa, vpd, rb, btran, p)
    ci = ci_init
    for it in range(1, MAX_ITER + 1):
        ci_new, a, rs, gs, cs = day_step(ci, *args)
        if abs(ci_new - ci) < TOL_CI:
            _, a, rs, gs, cs = day_step(ci_new, *args)   # values at the fixed point
            return ci_new, a, rs, gs, cs, it, False
        ci = ci_new

    # ---- bisection fallback (defensive; not expected to trigger) ----
    def f(c):
        cn, *_ = day_step(c, *args)
        return cn - c

    lo, hi = 0.0, ca * 2.0
    flo, fhi = f(lo), f(hi)
    if flo * fhi > 0.0:
        _, a, rs, gs, cs = day_step(ci, *args)
        return ci, a, rs, gs, cs, MAX_ITER, True
    for it in range(1, MAX_BISECT + 1):
        mid = 0.5 * (lo + hi)
        fm = f(mid)
        if abs(fm) < TOL_CI or (hi - lo) < TOL_CI:
            break
        if flo * fm <= 0.0:
            hi = mid
        else:
            lo, flo = mid, fm
    ci = 0.5 * (lo + hi)
    _, a, rs, gs, cs = day_step(ci, *args)
    return ci, a, rs, gs, cs, MAX_ITER + it, True


def night_solve(t_air, p_atm, ca, rb, btran, p):
    """Night branch: A=-Rd, gs=b0, then the same diffusion chain.

    Returns (ci, a, rs, gs, cs).
    """
    t_c = t_air - 273.15
    vcmax = vcmax_temperature(t_c, p["vcmax25"], p["n_factor"], btran)
    rd = RD_FRAC * vcmax
    a = -rd
    a_mol = a * 1e-6
    cf = p_atm / (R * t_air)
    gs = p["b0"]                       # intercept conductance only
    rs = cf / gs
    cs = ca - 1.37 * rb * a_mol / cf * p_atm
    ci = cs - 1.65 * rs * a_mol / cf * p_atm
    return ci, a, rs, gs, cs


def evaluate(par, t_air, p_atm, ca, o2_pa, vpd, rb, btran, p, ci_init):
    """Dispatch to night branch or daytime coupled solve."""
    if par < NIGHT_PAR:
        ci, a, rs, gs, cs = night_solve(t_air, p_atm, ca, rb, btran, p)
        return ci, a, rs, gs, cs, 0, False
    return solve_daytime(par, t_air, p_atm, ca, o2_pa, vpd, rb, btran, p, ci_init)


