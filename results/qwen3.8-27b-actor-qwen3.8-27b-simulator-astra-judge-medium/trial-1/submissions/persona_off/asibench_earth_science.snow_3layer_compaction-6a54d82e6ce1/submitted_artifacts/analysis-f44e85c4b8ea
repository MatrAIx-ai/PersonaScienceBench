#!/usr/bin/env python3
"""
Three-layer process-based snowpack model (fixed layer count = 3).

State per layer (index 0 = top, 2 = bottom):
    s   : ice SWE [mm water]
    lq  : liquid SWE [mm water]
    T   : temperature [K]
    rho : ice-skeleton density [kg/m3] (ice mass / total layer volume)
    h   : thickness [m] = s*1e-3/rho  (liquid stored in pore space,
          so it does not change thickness; initial state satisfies this exactly)

Per 15-min substep (explicit Euler; hourly forcing zero-order held):
  1. Deposition: snowfall -> ice at fresh-snow density (mass-weighted
     density mixing in top layer); rainfall -> liquid in top layer.
  2. Surface energy balance on a thin surface skin (top ~5 cm of layer 1,
     heat capacity = 8% of the top layer, conductively coupled to it with
     C_c = k(rho)/D_SKIN) so the surface can reach 0 C and melt while the
     bulk top layer stays cold (a whole-layer isothermal surface would
     over-estimate the thermal inertia of the melting zone):
        F = (1-alpha)*SW_in + LW_in - eps*sigma*Ts^4 + C_h*(T_air - Ts)
     Ground heat flux = 0 (not provided); latent heat flux = 0 (no humidity).
  3. Inter-layer conduction: F_ij = k_eff*(Ti-Tj)/((hi+hj)/2),
     k(rho) = 0.25*(rho/100)^0.39 W/m/K (dry snow approximation).
  4. Temperature update: T += F_net*dt / E, E = s*C_ice + lq*C_w [J/m2/K].
  5. Melt/refreeze with latent-heat pinning at 273.15 K (skin first, then
     each layer): excess energy above freezing melts ice (T pinned),
     deficit refreezes liquid (latent heat warms layer, T capped).
  6. Compaction (Anderson/Niu-style): rho relaxes toward
     rho_inf(sigma) = 917/(1 + 9*exp(-sigma/1000))  [sigma = overburden Pa
     from SWE of layers above], with Arrhenius temperature dependence:
     tau = 7 d * (1000 Pa/sigma) * exp(4000 K*(1/T - 1/270 K)).
     rho_inf was calibrated so the initial profile (104/157/274 kg/m3) is
     at (near-)equilibrium, avoiding spurious initial compaction.
  7. Drainage: field capacity w_max = 0.07*(1-rho/917) [m3 liq/m3 snow];
     liquid above capacity drains to the layer below (top-to-bottom
     cascade); overflow from the bottom layer = runoff.
  8. Mass closure checked at every substep:
     dSWE_total = snowfall + rainfall - runoff.

Outputs (under results/):
  snow_state.npy    float64 (n_days, 3, 5)  [h_m, rho, ice_mm, liq_mm, T_K]
                    state at end of each day (hour 24, 48, ...)
  snow_summary.csv  day, swe_mm, snow_depth_m, melt_mm, refreeze_mm,
                    runoff_mm, mean_density_kg_m3   (day = 0..67)
  snow_evolution.png  diagnostic figure
"""
import json
import os

import numpy as np
import pandas as pd

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    _HAS_MPL = True
except ImportError:  # fall back to built-in pure-Python PNG renderer
    _HAS_MPL = False

# ----------------------------- constants ------------------------------------
RHO_ICE = 917.0        # kg/m3
RHO_W = 1000.0         # kg/m3
L_F = 334000.0         # J/kg latent heat of fusion
C_ICE = 2100.0         # J/kg/K
C_W = 4180.0           # J/kg/K
SB = 5.670374419e-8    # W/m2/K4
GRAV = 9.81            # m/s2
T_MELT = 273.15        # K
T_LIQ_CAP = 276.0      # K cap for superheated liquid-only layers

ALPHA = 0.8            # snow albedo (dry snow, constant)
EPS = 0.99             # surface emissivity
C_H = 4.0              # W/m2/K bulk sensible-heat coefficient (assumed)
RHO_F = 100.0          # kg/m3 fresh-snow density
WFC = 0.07             # field-capacity coefficient

# compaction (Anderson/Niu-style, calibrated to initial profile)
COMP_A = 9.0           # rho_inf = 917/(1 + COMP_A*exp(-sigma/COMP_B))
COMP_B = 1000.0        # Pa
TAU0 = 7.0 * 86400.0   # s, relaxation time at SIG_REF, T_REF
SIG_REF = 1000.0       # Pa
T_REF = 270.0          # K
B_ACT = 4000.0         # K, activation parameter (E_a/R)

DT = 900.0             # s, substep (15 min)
N_SUB = 4              # substeps per hour
N_LAYERS = 3
D_SKIN = 0.05          # m, thickness of the surface skin (top of layer 1)
SKIN_FRACTION = 0.08   # skin heat capacity as fraction of top-layer capacity
E_SKIN_MIN = 10000.0   # J/m2/K floor for the skin capacity

DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data")
OUT_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "results")


def thickness_m(s, rho):
    """Layer thickness [m]: h = s/rho with s in mm SWE (1 mm = 1 kg/m2).

    Liquid lives in pore space, so it does not change thickness."""
    return np.where(s > 0.0, s / np.maximum(rho, 1e-9), 0.0)


def k_cond(rho):
    """Effective thermal conductivity of dry snow, W/m/K."""
    return 0.25 * (np.maximum(rho, 1e-9) / 100.0) ** 0.39


def rho_inf(sigma):
    """Equilibrium density from overburden stress (Pa)."""
    return RHO_ICE / (1.0 + COMP_A * np.exp(-np.maximum(sigma, 0.0) / COMP_B))


def main():
    # ------------------------------ inputs ----------------------------------
    with open(os.path.join(DATA_DIR, "snowpack_init.json")) as f:
        init = json.load(f)
    layers = init["layers"]
    s = np.array([ly["ice_mm"] for ly in layers], dtype=float)
    lq = np.array([ly["liq_mm"] for ly in layers], dtype=float)
    T = np.array([ly["temp_K"] for ly in layers], dtype=float)
    rho = np.array([ly["density_kg_m3"] for ly in layers], dtype=float)
    Ts = float(T[0])  # surface skin temperature (top of layer 1)
    swe0 = float((s + lq).sum())
    depth0 = float(thickness_m(s, rho).sum())

    df = pd.read_csv(os.path.join(DATA_DIR, "forcing.csv"))
    n_hours = len(df)
    n_days = n_hours // 24
    assert n_hours == n_days * 24, "forcing length must be a whole number of days"

    t_air = df["t_air_K"].to_numpy()
    sw = df["sw_in_wm2"].to_numpy()
    lw = df["lw_in_wm2"].to_numpy()
    psnow = df["snowfall_mm_hr"].to_numpy()
    prain = df["rainfall_mm_hr"].to_numpy()

    os.makedirs(OUT_DIR, exist_ok=True)

    state = np.zeros((n_days, N_LAYERS, 5), dtype=np.float64)
    sum_rows = []

    melt_d = refr_d = run_d = 0.0
    cum_snow = cum_rain = cum_melt = cum_refr = cum_run = 0.0
    max_imbal = 0.0
    max_liq = float(lq.max())
    max_rho = float(rho.max())

    for hi in range(n_hours):
        ta, swi, lwi, psi, pri = t_air[hi], sw[hi], lw[hi], psnow[hi], prain[hi]
        psu, pru = psi / N_SUB, pri / N_SUB  # deposition per 15-min substep
        for sub in range(N_SUB):
            swe_prev = float((s + lq).sum())
            run_sub = 0.0

            # 1. deposition
            if psu > 0.0:
                rho[0] = (s[0] * rho[0] + psu * RHO_F) / (s[0] + psu)
                s[0] += psu
            if pru > 0.0:
                lq[0] += pru
            if sub == 0:
                cum_snow += psi
                cum_rain += pri

            # 2./3. fluxes
            h = thickness_m(s, rho)
            E = s * C_ICE + lq * C_W  # J/m2/K  (1 mm SWE = 1 kg/m2)
            E_skin = max(SKIN_FRACTION * E[0], E_SKIN_MIN)
            if E[0] > 1e-6:
                F0 = (1.0 - ALPHA) * swi + lwi - EPS * SB * Ts ** 4 + C_H * (ta - Ts)
                # skin <-> layer bulk: conductance k across the layer depth
                Fc = k_cond(rho[0]) / max(h[0], D_SKIN) * (T[0] - Ts)
            else:  # no snow on surface: hold skin at air temp, discard flux
                Ts = ta
                T[0] = ta
                F0 = 0.0
                Fc = 0.0
            F12 = 0.0
            if h[0] + h[1] > 1e-6 and E[0] > 1e-6 and E[1] > 1e-6:
                keff = 0.5 * (k_cond(rho[0]) + k_cond(rho[1]))
                F12 = keff * (T[0] - T[1]) / (0.5 * (h[0] + h[1]))
            F23 = 0.0
            if h[1] + h[2] > 1e-6 and E[1] > 1e-6 and E[2] > 1e-6:
                keff = 0.5 * (k_cond(rho[1]) + k_cond(rho[2]))
                F23 = keff * (T[1] - T[2]) / (0.5 * (h[1] + h[2]))

            # 4. temperature update
            Ts += (F0 + Fc) * DT / E_skin
            # conduction: F12 > 0 means heat flows 0 -> 1 (layer 0 loses it)
            Fnet = np.array([-Fc - F12, F12 - F23, F23])
            for i in range(N_LAYERS):
                if E[i] > 1e-6:
                    T[i] += Fnet[i] * DT / E[i]

            # 5. melt / refreeze (latent-heat pinned); surface skin first
            if Ts > T_MELT:
                if s[0] > 1e-9:
                    excess = E_skin * (Ts - T_MELT)
                    dm = min(s[0], excess / L_F)
                    s[0] -= dm
                    lq[0] += dm
                    Ts = T_MELT + min(T_LIQ_CAP - T_MELT,
                                      max(0.0, excess - dm * L_F) / E_skin)
                    melt_d += dm
                    cum_melt += dm
                else:
                    Ts = min(Ts, T_LIQ_CAP)
            elif Ts < T_MELT and lq[0] > 1e-9:
                deficit = E_skin * (T_MELT - Ts)
                dm = min(lq[0], deficit / L_F)
                lq[0] -= dm
                s[0] += dm
                Ts = min(T_MELT, Ts + dm * L_F / E_skin)
                refr_d += dm
                cum_refr += dm
            for i in range(N_LAYERS):
                if T[i] > T_MELT:
                    if s[i] > 1e-9:
                        E_i = s[i] * C_ICE + lq[i] * C_W
                        excess = E_i * (T[i] - T_MELT)
                        dm = min(s[i], excess / L_F)
                        s[i] -= dm
                        lq[i] += dm
                        T[i] = min(T_LIQ_CAP,
                                   T_MELT + max(0.0, excess - dm * L_F) / E_i)
                        melt_d += dm
                        cum_melt += dm
                    else:
                        T[i] = min(T[i], T_LIQ_CAP)
                elif T[i] < T_MELT and lq[i] > 1e-9 and i > 0:
                    # layer-0 liquid is managed by the surface skin; interior
                    # layers refreeze liquid with latent heat (energy-consistent)
                    E_i = s[i] * C_ICE + lq[i] * C_W
                    deficit = E_i * (T_MELT - T[i])
                    dm = min(lq[i], deficit / L_F)
                    lq[i] -= dm
                    s[i] += dm
                    T[i] = min(T_MELT, T[i] + dm * L_F / E_i)
                    refr_d += dm
                    cum_refr += dm

            # 6. compaction
            swe_above = np.cumsum(s + lq)
            for i in range(N_LAYERS):
                # overburden stress [Pa]: 1 mm SWE = 1 kg/m2 -> sigma = SWE_mm * g
                sig = swe_above[i - 1] * GRAV if i > 0 else 0.0
                if sig >= 1.0 and s[i] > 1e-9:
                    rinf = rho_inf(sig)
                    if rinf > rho[i]:
                        tau = TAU0 * (SIG_REF / sig) * np.exp(
                            B_ACT * (1.0 / T[i] - 1.0 / T_REF)
                        )
                        dr = (rinf - rho[i]) * (1.0 - np.exp(-DT / tau))
                        rho[i] = min(rho[i] + dr, RHO_ICE)

            # 7. drainage (top -> bottom cascade); bottom overflow = runoff
            h = thickness_m(s, rho)
            for i in range(N_LAYERS):
                if s[i] + lq[i] <= 1e-9:
                    continue
                cap = WFC * (1.0 - rho[i] / RHO_ICE) * h[i] * 1000.0
                if lq[i] > cap:
                    excess = lq[i] - cap
                    lq[i] = cap
                    if i < N_LAYERS - 1:
                        lq[i + 1] += excess
                    else:
                        run_sub = excess
                        run_d += excess
                        cum_run += excess

            # 8. mass closure
            imbal = abs(float((s + lq).sum()) - (swe_prev + psu + pru) + run_sub)
            max_imbal = max(max_imbal, imbal)
            max_liq = max(max_liq, float(lq.max()))
            max_rho = max(max_rho, float(rho.max()))

            # daily snapshot at end of each day
            step_idx = hi * N_SUB + sub
            if (step_idx + 1) % (24 * N_SUB) == 0:
                day = (step_idx + 1) // (24 * N_SUB) - 1
                h = thickness_m(s, rho)
                state[day, :, 0] = h
                state[day, :, 1] = rho
                state[day, :, 2] = s
                state[day, :, 3] = lq
                state[day, :, 4] = T
                swe = float((s + lq).sum())
                depth = float(h.sum())
                mean_rho = swe * 1e-3 / depth if depth > 1e-9 else 0.0
                sum_rows.append(
                    [day, swe, depth, melt_d, refr_d, run_d, mean_rho]
                )
                melt_d = refr_d = run_d = 0.0
    # ------------------------------ outputs ---------------------------------
    np.save(os.path.join(OUT_DIR, "snow_state.npy"), state)

    summary = pd.DataFrame(
        sum_rows,
        columns=["day", "swe_mm", "snow_depth_m", "melt_mm",
                 "refreeze_mm", "runoff_mm", "mean_density_kg_m3"],
    )
    summary.to_csv(os.path.join(OUT_DIR, "snow_summary.csv"), index=False)

    # ------------------------------ figure ----------------------------------
    days = np.arange(n_days)
    swe_t = state[:, :, 2].sum(axis=1) + state[:, :, 3].sum(axis=1)
    depth_t = state[:, :, 0].sum(axis=1)
    h_mm = state[:, :, 0] * 1000.0
    fig_path = os.path.join(OUT_DIR, "snow_evolution.png")
    if _HAS_MPL:
        _figure_mpl(days, swe_t, depth_t, h_mm, state, summary, t_air, sw,
                    n_hours, n_days, fig_path)
    else:
        _figure_plain(days, swe_t, depth_t, h_mm, state, summary, t_air, sw,
                      n_hours, n_days, fig_path)
        print("  (matplotlib not available: used built-in PNG renderer)")

    # ------------------------------ diagnostics -----------------------------
    print("=" * 64)
    print("Diagnostics")
    print("=" * 64)
    print(f"n_days               : {n_days}")
    print(f"initial SWE          : {swe0:.3f} mm   (depth {depth0:.4f} m)")
    print(f"final SWE            : {swe_t[-1]:.3f} mm   (depth {depth_t[-1]:.4f} m)")
    print(f"cumulative snowfall  : {cum_snow:.3f} mm")
    print(f"cumulative rainfall  : {cum_rain:.3f} mm")
    print(f"cumulative melt      : {cum_melt:.3f} mm")
    print(f"cumulative refreeze  : {cum_refr:.3f} mm")
    print(f"cumulative runoff    : {cum_run:.3f} mm")
    print(f"max liquid in any layer: {max_liq:.3f} mm")
    print(f"max density reached  : {max_rho:.2f} kg/m3")
    print(f"max mass-closure imbalance: {max_imbal:.3e} mm")
    print(f"mass balance check   : dSWE + runoff = {swe_t[-1]-swe0+cum_run:.4f} mm "
          f"vs inputs {cum_snow+cum_rain:.4f} mm")
    print("\nFinal state (top -> bottom):")
    for i in range(3):
        print(f"  layer {i+1}: h={state[-1,i,0]*1000:8.1f} mm  rho={state[-1,i,1]:7.2f}  "
              f"ice={state[-1,i,2]:7.2f} mm  liq={state[-1,i,3]:6.2f} mm  T={state[-1,i,4]:7.2f} K")
    md = summary[summary["melt_mm"] > 0]
    print(f"\ndays with melt > 0     : {len(md)} / {n_days}"
          + (f"  (first: day {int(md['day'].min())})" if len(md) else ""))
    print("\nFirst 5 / last 5 summary rows:")
    print(summary.head(5).to_string(index=False))
    print(summary.tail(5).to_string(index=False))
    print("\nOutput verification:")
    chk = np.load(os.path.join(OUT_DIR, "snow_state.npy"))
    print(f"  snow_state.npy: shape={chk.shape}, dtype={chk.dtype}")
    cchk = pd.read_csv(os.path.join(OUT_DIR, "snow_summary.csv"))
    print(f"  snow_summary.csv: {len(cchk)} rows, columns={list(cchk.columns)}")
    assert chk.shape == (n_days, 3, 5) and chk.dtype == np.float64
    assert list(cchk.columns) == ["day", "swe_mm", "snow_depth_m", "melt_mm",
                                  "refreeze_mm", "runoff_mm", "mean_density_kg_m3"]
    print("  OK: shape (n_days, 3, 5) float64 and 7 required CSV columns.")




