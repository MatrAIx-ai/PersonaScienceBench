def _png_write(path, arr):
    """Write an HxWx3 uint8 RGB array as a PNG file (stdlib only)."""
    h, w = arr.shape[:2]
    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(h))

    def _chunk(tag, data):
        return (_struct.pack(">I", len(data)) + tag + data
                + _struct.pack(">I", _zlib.crc32(tag + data) & 0xFFFFFFFF))

    png = b"\x89PNG\r\n\x1a\n"
    png += _chunk(b"IHDR", _struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += _chunk(b"IDAT", _zlib.compress(raw, 9))
    png += _chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


class MiniCanvas:
    """Tiny anti-aliased RGB raster canvas with line/fill/text primitives."""

    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.px = np.full((h, w, 3), bg, dtype=np.float64)

    def rect(self, x0, y0, x1, y1, col, a=1.0):
        xa, ya = max(0, int(x0)), max(0, int(y0))
        xb, yb = min(self.w, int(x1) + 1), min(self.h, int(y1) + 1)
        if xb <= xa or yb <= ya or a <= 0:
            return
        c = np.asarray(col, dtype=np.float64)
        if a >= 1:
            self.px[ya:yb, xa:xb] = c
        else:
            self.px[ya:yb, xa:xb] = (1 - a) * self.px[ya:yb, xa:xb] + a * c

    def line(self, x0, y0, x1, y1, col, lw=1.0, a=1.0):
        x0, y0, x1, y1 = float(x0), float(y0), float(x1), float(y1)
        pad = int(lw) + 2
        xa = max(0, int(min(x0, x1)) - pad)
        xb = min(self.w, int(max(x0, x1)) + pad + 1)
        ya = max(0, int(min(y0, y1)) - pad)
        yb = min(self.h, int(max(y0, y1)) + pad + 1)
        if xa >= xb or ya >= yb:
            return
        yy, xx = np.mgrid[ya:yb, xa:xb]
        dx, dy = x1 - x0, y1 - y0
        L2 = dx * dx + dy * dy
        if L2 < 1e-12:
            d = np.hypot(xx - x0, yy - y0)
        else:
            t = np.clip(((xx - x0) * dx + (yy - y0) * dy) / L2, 0.0, 1.0)
            d = np.hypot(xx - (x0 + t * dx), yy - (y0 + t * dy))
        cov = np.clip(0.5 * lw + 0.5 - d, 0.0, 1.0) * a
        m = cov > 0
        if not m.any():
            return
        sub = self.px[ya:yb, xa:xb]
        c = np.asarray(col, dtype=np.float64)
        sub[m] = (1 - cov[m])[:, None] * sub[m] + cov[m][:, None] * c

    def dline(self, x0, y0, x1, y1, col, lw=1.2, dash=7.0, gap=5.0, a=1.0):
        L = np.hypot(x1 - x0, y1 - y0)
        if L < 1e-9:
            return
        n = int(L // (dash + gap)) + 1
        for i in range(n + 1):
            t0 = i * (dash + gap) / L
            t1 = min(1.0, (i * (dash + gap) + dash) / L)
            if t0 >= 1.0:
                break
            self.line(x0 + (x1 - x0) * t0, y0 + (y1 - y0) * t0,
                      x0 + (x1 - x0) * t1, y0 + (y1 - y0) * t1, col, lw, a)

    def polyline(self, xs, ys, col, lw=1.5, a=1.0):
        for i in range(len(xs) - 1):
            self.line(xs[i], ys[i], xs[i + 1], ys[i + 1], col, lw, a)

    def fill_between_px(self, xs, yt, yb, col, a=1.0):
        """Fill between two pixel-space curves (xs: increasing int pixel x)."""
        x0, x1 = int(xs[0]), int(xs[-1])
        n = len(xs)
        c = np.asarray(col, dtype=np.float64)
        for x in range(max(0, x0), min(self.w, x1 + 1)):
            k = int(np.searchsorted(xs, x, side="right")) - 1
            k = min(max(k, 0), n - 2)
            u = (x - xs[k]) / max(1e-9, (xs[k + 1] - xs[k]))
            yti = yt[k] + (yt[k + 1] - yt[k]) * u
            ybi = yb[k] + (yb[k + 1] - yb[k]) * u
            lo = max(0, int(np.floor(min(yti, ybi))))
            hi = min(self.h - 1, int(np.ceil(max(yti, ybi))))
            if hi >= lo:
                if a >= 1:
                    self.px[lo:hi + 1, x] = c
                else:
                    self.px[lo:hi + 1, x] = (1 - a) * self.px[lo:hi + 1, x] + a * c

    def text(self, x, y, s, size=2, col=(0, 0, 0), align="left"):
        wch = 6 * size
        total = len(s) * wch - size
        if align == "center":
            x0 = int(x - total / 2.0)
        elif align == "right":
            x0 = int(x - total)
        else:
            x0 = int(x)
        y0 = int(y)
        for ch in s:
            g = _FONT5x7.get(ch, _FONT5x7["?"])
            for r in range(7):
                row = g[r]
                if not row:
                    continue
                for cb in range(5):
                    if (row >> (4 - cb)) & 1:
                        self.rect(x0 + cb * size, y0 + r * size,
                                  x0 + cb * size + size - 1,
                                  y0 + r * size + size - 1, col)
            x0 += wch

    def text_v(self, x, y, s, size=2, col=(0, 0, 0)):
        """Vertical text, reading top to bottom."""
        for i, ch in enumerate(s):
            self.text(x, y + i * 8 * size, ch, size, col)

    def save(self, path):
        _png_write(path, np.clip(self.px, 0, 255).astype(np.uint8))


def _nice_ticks(lo, hi, n=5):
    span = hi - lo
    if span <= 0:
        return np.array([lo])
    step0 = span / n
    mag = 10.0 ** np.floor(np.log10(step0))
    step = 10 * mag
    for m in (1.0, 2.0, 5.0, 10.0):
        if step0 <= m * mag:
            step = m * mag
            break
    start = np.ceil(lo / step) * step
    return np.arange(start, hi + 1e-9 * step, step)


def _fmt_tick(v):
    if abs(v) < 1e-9:
        return "0"
    if abs(v) >= 100:
        return str(int(round(v)))
    s = f"{v:.2f}".rstrip("0").rstrip(".")
    return s


class Panel:
    """Axis box with transforms, ticks and labels on a MiniCanvas."""

    def __init__(self, cv, x0, y0, x1, y1, xlim, ylim,
                 title="", xlabel="", ylabel=""):
        self.cv, self.x0, self.y0, self.x1, self.y1 = cv, x0, y0, x1, y1
        self.xlim, self.ylim = xlim, ylim
        self.X = lambda x: x0 + (x - xlim[0]) / (xlim[1] - xlim[0]) * (x1 - x0)
        self.Y = lambda y: y1 - (y - ylim[0]) / (ylim[1] - ylim[0]) * (y1 - y0)
        c = (60, 60, 60)
        cv.line(x0, y0, x1, y0, c, 1.2)
        cv.line(x0, y1, x1, y1, c, 1.2)
        cv.line(x0, y0, x0, y1, c, 1.2)
        cv.line(x1, y0, x1, y1, c, 1.2)
        for v in _nice_ticks(xlim[0], xlim[1], 6):
            px = self.X(v)
            cv.line(px, y1, px, y1 + 5, c, 1)
            cv.text(px, y1 + 8, _fmt_tick(v), 2, align="center")
        for v in _nice_ticks(ylim[0], ylim[1], 5):
            py = self.Y(v)
            cv.line(x0, py, x0 - 5, py, c, 1)
            cv.text(x0 - 8, py - 7, _fmt_tick(v), 2, align="right")
        if title:
            cv.text((x0 + x1) / 2, y0 - 22, title, 2, align="center")
        if xlabel:
            cv.text((x0 + x1) / 2, y1 + 30, xlabel, 2, align="center")
        if ylabel:
            cv.text_v(x0 - 46, y0 - 4, ylabel, 2)


def _legend(cv, x, y, entries):
    hgt = len(entries) * 18 + 8
    wdt = 150
    cv.rect(x, y, x + wdt, y + hgt, (255, 255, 255), 0.85)
    for (xa, ya, xb, yb) in [(x, y, x + wdt, y), (x, y + hgt, x + wdt, y + hgt),
                             (x, y, x, y + hgt), (x + wdt, y, x + wdt, y + hgt)]:
        cv.line(xa, ya, xb, yb, (120, 120, 120), 1)
    for i, (lab, col) in enumerate(entries):
        yy = y + 13 + i * 18
        cv.line(x + 8, yy, x + 30, yy, col, 2.2)
        cv.text(x + 38, yy - 7, lab, 2)


BLUE, ORANGE, GREEN, RED = (31, 119, 180), (255, 127, 14), (44, 160, 44), (214, 39, 40)
PURPLE, BROWN, YELLOW = (148, 103, 189), (140, 86, 75), (200, 180, 0)


def _figure_plain(days, swe_t, depth_t, h_mm, state, summary, t_air, sw,
                  n_hours, n_days, path):
    W, H = 1600, 800
    cv = MiniCanvas(W, H)
    cv.text(W / 2, 14, "Three-layer snowpack evolution (68 days of hourly forcing)",
            3, align="center")
    cols = [(70, 70, 530, 390), (570, 70, 1030, 390), (1070, 70, 1530, 390),
            (70, 450, 530, 770), (570, 450, 1030, 770), (1070, 450, 1530, 770)]
    daysf = days.astype(float)

    # P1: SWE and depth
    p = Panel(cv, *cols[0], (0, n_days - 1), (0, 2000),
              "Total SWE and snow depth", "Day", "mm")
    cv.polyline([p.X(v) for v in daysf], [p.Y(v) for v in swe_t], BLUE, 1.8)
    cv.polyline([p.X(v) for v in daysf], [p.Y(v * 1000) for v in depth_t], GREEN, 1.8)
    _legend(cv, p.x1 - 160, p.y0 + 8, [("SWE (mm)", BLUE), ("Depth (mm)", GREEN)])

    # P2: stacked per-layer thickness (top layer drawn on top)
    p = Panel(cv, *cols[1], (0, n_days - 1), (0, 2000),
              "Per-layer thickness (stacked)", "Day", "Thickness (mm)")
    xp = np.rint(p.X(daysf)).astype(int)
    c0 = h_mm[:, 0]
    c1 = h_mm[:, 0] + h_mm[:, 1]
    c2 = c1 + h_mm[:, 2]
    cv.fill_between_px(xp, p.Y(np.zeros_like(c0)), p.Y(c0), BROWN, 0.85)
    cv.fill_between_px(xp, p.Y(c0), p.Y(c1), PURPLE, 0.85)
    cv.fill_between_px(xp, p.Y(c1), p.Y(c2), BLUE, 0.85)
    cv.polyline([p.X(v) for v in daysf], [p.Y(v * 1000) for v in depth_t],
                (0, 0, 0), 1.4)
    _legend(cv, p.x1 - 160, p.y0 + 8, [("Top layer", BLUE), ("Middle layer", PURPLE),
                                       ("Bottom layer", BROWN), ("Total", (0, 0, 0))])

    # P3: per-layer temperature
    tlo = float(np.floor(state[:, :, 4].min() - 1))
    thi = float(np.ceil(state[:, :, 4].max() + 1))
    p = Panel(cv, *cols[2], (0, n_days - 1), (tlo, thi),
              "Per-layer temperature", "Day", "T (K)")
    for i, col in enumerate((BLUE, ORANGE, GREEN)):
        cv.polyline([p.X(v) for v in daysf], [p.Y(v) for v in state[:, i, 4]], col, 1.5)
    p.cv.dline(p.X(0), p.Y(273.15), p.X(n_days - 1), p.Y(273.15), (0, 0, 0), 1.2)
    cv.text(p.X(n_days - 1) - 4, p.Y(273.15) - 14, "273.15 K", 2, align="right")
    _legend(cv, p.x1 - 160, p.y0 + 8,
            [(f"Layer {i+1}", c) for i, c in enumerate((BLUE, ORANGE, GREEN))])

    # P4: per-layer density
    p = Panel(cv, *cols[3], (0, n_days - 1), (90, 450),
              "Per-layer density (compaction)", "Day", "Density (kg/m3)")
    for i, col in enumerate((BLUE, ORANGE, GREEN)):
        cv.polyline([p.X(v) for v in daysf], [p.Y(v) for v in state[:, i, 1]], col, 1.5)
    _legend(cv, p.x1 - 160, p.y0 + 8,
            [(f"Layer {i+1}", c) for i, c in enumerate((BLUE, ORANGE, GREEN))])

    # P5: daily melt / refreeze / runoff bars
    mmax = max(float(summary[["melt_mm", "refreeze_mm", "runoff_mm"]].max().max()), 0.1)
    p = Panel(cv, *cols[4], (0, n_days - 1), (0, mmax * 1.15),
              "Daily melt / refreeze / runoff", "Day", "mm/day")
    bw = (p.x1 - p.x0) / n_days
    vals = summary[["melt_mm", "refreeze_mm", "runoff_mm"]].to_numpy()
    for i in range(n_days):
        xc = p.X(i)
        for off, col, v in zip((-0.6, 0.0, 0.6), (BLUE, ORANGE, RED), vals[i]):
            if v > 0:
                cv.rect(xc + off * bw - bw * 0.28, p.Y(v),
                        xc + off * bw + bw * 0.28, p.Y(0), col)
    _legend(cv, p.x1 - 160, p.y0 + 8,
            [("Melt", BLUE), ("Refreeze", ORANGE), ("Runoff", RED)])

    # P6: forcing (air temp left axis, SW right axis)
    p = Panel(cv, *cols[5], (0, n_hours / 24.0), (-15, 7),
              "Forcing: air temperature and shortwave", "Time (days)", "T_air (degC)")
    th = (t_air - 273.15).astype(float)
    thx = np.arange(n_hours, dtype=float) / 24.0
    cv.polyline([p.X(v) for v in thx], [p.Y(v) for v in th], RED, 1.0)
    # right axis for SW
    sw_lo, sw_hi = 0, 650
    for v in _nice_ticks(sw_lo, sw_hi, 5):
        py = p.y1 - (v - sw_lo) / (sw_hi - sw_lo) * (p.y1 - p.y0)
        cv.line(p.x1, py, p.x1 + 5, py, (60, 60, 60), 1)
        cv.text(p.x1 + 8, py - 7, _fmt_tick(v), 2)
    cv.polyline([p.X(v) for v in thx],
                [p.y1 - v / 650.0 * (p.y1 - p.y0) for v in sw], YELLOW, 1.0)
    cv.text_v(p.x1 + 26, p.y0 - 4, "SW (W/m2)", 2)
    cv.text(p.x1 - 160, p.y0 + 10, "T_air (degC)", 2, col=RED)
    cv.text(p.x1 - 160, p.y0 + 28, "SW (W/m2)", 2, col=YELLOW)

    cv.save(path)


def _figure_mpl(days, swe_t, depth_t, h_mm, state, summary, t_air, sw,
                n_hours, n_days, path):
    fig, axes = plt.subplots(2, 3, figsize=(16, 8))
    fig.suptitle("Three-layer snowpack evolution (68 days of hourly forcing)",
                 fontsize=13)

    ax = axes[0, 0]
    ax.plot(days, swe_t, "b-", lw=2, label="SWE (mm)")
    ax.plot(days, depth_t * 1000.0, "g-", lw=2, label="Depth (mm)")
    ax.set_xlabel("Day"); ax.set_ylabel("mm")
    ax.set_title("Total SWE and snow depth"); ax.legend(); ax.grid(alpha=0.3)

    ax = axes[0, 1]
    ax.stackplot(days, h_mm[:, 2], h_mm[:, 1], h_mm[:, 0],
                 labels=["Bottom", "Middle", "Top"], alpha=0.8)
    ax.plot(days, depth_t * 1000.0, "k-", lw=1.2, label="Total")
    ax.set_xlabel("Day"); ax.set_ylabel("Thickness (mm)")
    ax.set_title("Per-layer thickness (stacked)"); ax.legend(loc="upper left"); ax.grid(alpha=0.3)

    ax = axes[0, 2]
    for i in range(3):
        ax.plot(days, state[:, i, 4], label=f"Layer {i+1}")
    ax.axhline(T_MELT, color="k", ls="--", lw=1, label="273.15 K")
    ax.set_xlabel("Day"); ax.set_ylabel("T (K)")
    ax.set_title("Per-layer temperature"); ax.legend(); ax.grid(alpha=0.3)

    ax = axes[1, 0]
    for i in range(3):
        ax.plot(days, state[:, i, 1], label=f"Layer {i+1}")
    ax.set_xlabel("Day"); ax.set_ylabel("Density (kg/m$^3$)")
    ax.set_title("Per-layer density (compaction)"); ax.legend(); ax.grid(alpha=0.3)

    ax = axes[1, 1]
    ax.bar(days, summary["melt_mm"], width=1.0, color="tab:blue", label="Melt")
    ax.bar(days, summary["refreeze_mm"], width=1.0, color="tab:orange", label="Refreeze")
    ax.bar(days, summary["runoff_mm"], width=1.0, color="tab:red", label="Runoff")
    ax.set_xlabel("Day"); ax.set_ylabel("mm/day")
    ax.set_title("Daily melt / refreeze / runoff"); ax.legend(); ax.grid(alpha=0.3)

    ax = axes[1, 2]
    ax.plot(np.arange(n_hours) / 24.0, t_air - 273.15, "r-", lw=0.8, label="T_air (degC)")
    ax.axhline(0.0, color="k", ls=":", lw=0.8)
    ax.set_xlabel("Time (days)"); ax.set_ylabel("T_air (degC)", color="r")
    ax2 = ax.twinx()
    ax2.plot(np.arange(n_hours) / 24.0, sw, color="goldenrod", lw=0.6, alpha=0.7,
             label="SW (W/m$^2$)")
    ax2.set_ylabel("SW in (W/m$^2$)", color="k")
    ax.set_title("Forcing: air temperature and shortwave"); ax.grid(alpha=0.3)

    fig.tight_layout(rect=[0, 0, 1, 0.97])
    fig.savefig(path, dpi=150)
    plt.close(fig)


