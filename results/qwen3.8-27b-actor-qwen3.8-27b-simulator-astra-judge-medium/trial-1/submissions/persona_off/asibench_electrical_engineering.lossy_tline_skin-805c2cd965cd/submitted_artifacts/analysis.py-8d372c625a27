#!/usr/bin/env python3
"""
Transmission-Line Target Prediction
====================================
Uses the 8 calibration lines to predict the intrinsic frequency-domain transfer
functions and received pulse waveforms for the 3 target lines.

Model
-----
The intrinsic transfer function of a line of length L is the matched-line
propagation response  H(f) = exp(-gamma(f) * L)  with a PER-METER propagation
constant gamma = alpha + j*beta.  Verified from the calibration data: phase
scales linearly with length and group_delay_s == -d(phase)/d(omega).

The tabulated L, C, G columns are NOT the electromagnetic per-unit-length
parameters (no physical R(f) can reproduce the measured beta with them); they
are geometry bookkeeping values.  We therefore learn the per-meter response
empirically from the calibration lines and interpolate to the targets (all three
targets are interior points of the calibration parameter box).

Per-meter response decomposition (verified to <0.3% on the calibration set):
  beta(f)  = 2*pi*tg40*I(f)      (phase; tg40 = per-meter group delay @ 40 GHz,
                                  I(f) = common dispersion integral)
  alpha(f) = a0 + a1*sqrt(f) + a2*f   (attenuation; max residual ~0.01 Np/m)
where
  tg40(width) = sqrt(LC) * ratio(width)   (phase velocity; ratio smooth in width)
  a0,a1,a2    = local (IDW) interpolation in (width, roughness, R_dc).

Outputs (SI units, exp(+j*omega*t) convention):
  results/target_transfer.csv
  results/target_waveforms.csv
  results/pulse_metrics.csv
"""
import os
import numpy as np
import pandas as pd
from scipy.interpolate import CubicSpline

# ----------------------------------------------------------------------
# 1. Load data
# ----------------------------------------------------------------------
cl = pd.read_csv('data/calibration_lines.csv').set_index('line_id')
ct = pd.read_csv('data/calibration_transfer.csv')
tl = pd.read_csv('data/target_lines.csv')
fg = pd.read_csv('data/frequency_grid.csv')
ip = pd.read_csv('data/input_pulse.csv')

f   = fg.frequency_hz.values.astype(float)          # 2049 pts, 0..62.5 GHz
w   = 2*np.pi*f
fG  = f/1e9
t   = ip.time_s.values.astype(float)                # 4096 pts, 0..32.76 ns
vin = ip.input_v.values.astype(float)
os.makedirs('results', exist_ok=True)

# ----------------------------------------------------------------------
# 2. Extract per-meter alpha, beta, group-delay for each calibration line
# ----------------------------------------------------------------------
lines = list(cl.index)
PL = {}
for lid in lines:
    r = cl.loc[lid]; L = r.length_m
    sub = ct[ct.line_id == lid].sort_values('frequency_hz').reset_index(drop=True)
    alpha = -sub.magnitude_db.values*np.log(10)/(20.0*L)  # Np/m  (|H|=10^(dB/20))
    beta  = -sub.phase_rad.values/L                      # 1/m
    tg    = sub.group_delay_s.values/L                   # s/m
    PL[lid] = dict(width=r.trace_width_um, rough=r.roughness_index,
                   Rdc=r.dc_resistance_ohm_per_m, Lc=r.inductance_h_per_m,
                   Cc=r.capacitance_f_per_m, Gg=r.conductance_s_per_m,
                   L=L, alpha=alpha, beta=beta, tg=tg)

# ----------------------------------------------------------------------
# 3. Velocity (phase) model:  tg40 = sqrt(LC) * ratio(width)
# ----------------------------------------------------------------------
i40 = int(np.argmin(np.abs(f-40e9)))
recs = [(PL[l]['width'], PL[l]['tg'][i40],
         np.sqrt(PL[l]['Lc']*PL[l]['Cc']), l) for l in lines]

# --- global quadratic fit on all 8 points -> cal_6 diagnostic ---
W8 = np.array([r[0] for r in recs], float)
r8 = np.array([r[1]/r[2] for r in recs], float)
c8 = np.polyfit(W8, r8, 2)
res8 = np.abs(r8-np.polyval(c8, W8))/r8*100.0
med8 = np.median(res8)
i6 = [r[3] for r in recs].index('cal_6')
cal6_outlier = bool(res8[i6] > 3.0*med8)

print("=== Velocity model diagnostics ===")
print(f"ratio~width quadratic (all 8): cal_6 residual={res8[i6]:.3f}%  "
      f"median={med8:.3f}%  ratio={res8[i6]/med8:.2f}x  -> outlier={cal6_outlier}")
for r in sorted(recs, key=lambda x: x[0]):
    i = [x[3] for x in recs].index(r[3])
    flag = "  <-- down-weighted" if (cal6_outlier and r[3]=='cal_6') else ""
    print(f"   {r[3]:6s} w={r[0]:5.1f}  ratio={r8[i]:.4f}  resid={res8[i]:+6.3f}%{flag}")

# --- keep points (exclude cal_6 if flagged) and build local spline in width ---
keep = [r for r in recs if (r[3] != 'cal_6' if cal6_outlier else True)]
keep.sort(key=lambda x: x[0])
Wk = np.array([r[0] for r in keep], float)
rk = np.array([r[1]/r[2] for r in keep], float)
ratio_spline = CubicSpline(Wk, rk)

# cross-validation of the local ratio spline (LOO)
loo = []
for lo in range(len(Wk)):
    idx = [j for j in range(len(Wk)) if j != lo]
    csl = CubicSpline(Wk[idx], rk[idx])
    loo.append(abs(csl(Wk[lo])-rk[lo])/rk[lo]*100.0)
print(f"local ratio-spline LOO-CV: max={max(loo):.3f}%  median={np.median(loo):.3f}%")

# --- common dispersion D(f) and its integral I(f) ---
D  = np.array([PL[l]['tg']/PL[l]['tg'][i40] for l in lines])   # 8 x Nf
Dm = D.mean(axis=0)
I  = np.concatenate([[0.0], np.cumsum(0.5*(Dm[1:]+Dm[:-1])*np.diff(f))])
maxbeta_err = 0.0
for l in lines:
    recon = 2*np.pi*PL[l]['tg'][i40]*I
    m = fG >= 0.3
    err = np.max(np.abs(recon[m]-PL[l]['beta'][m])/np.abs(PL[l]['beta'][m]))*100
    maxbeta_err = max(maxbeta_err, err)
print(f"beta reconstruction 2*pi*tg40*I(f): max err over calibration = {maxbeta_err:.4f}%")

def per_meter_beta(width, sqrtLC):
    tg40 = sqrtLC*float(ratio_spline(width))
    return 2*np.pi*tg40*I, tg40

# ----------------------------------------------------------------------
# 4. Attenuation (alpha) model:  alpha(f) = a0 + a1*sqrt(f) + a2*f
# ----------------------------------------------------------------------
mask = fG >= 0.3
A = np.vstack([np.ones(mask.sum()), np.sqrt(fG[mask]), fG[mask]]).T
coef = {}
for l in lines:
    coef[l] = np.linalg.lstsq(A, PL[l]['alpha'][mask], rcond=None)[0]
Cmat = np.array([coef[l] for l in lines])            # 8 x 3
fitres = max(np.max(np.abs(PL[l]['alpha'][mask]-A@coef[l])) for l in lines)
print(f"\nalpha=f0+f1*sqrt(f)+f2*f  max fit residual = {fitres:.4f} Np/m")

# Linear (affine) model of each alpha coefficient in (width, rough, R_dc);
# chosen because it gives the lowest LOO-CV error with 8 calibration points.
FEAT = np.column_stack([np.ones(len(lines)),
                        [PL[l]['width'] for l in lines],
                        [PL[l]['rough'] for l in lines],
                        [PL[l]['Rdc']   for l in lines]])
REG = np.linalg.lstsq(FEAT, Cmat, rcond=None)[0]      # 4 x 3
loocv_a1 = []
for lo in range(len(lines)):
    idx = [j for j in range(len(lines)) if j != lo]
    reg_lo = np.linalg.lstsq(FEAT[idx], Cmat[idx], rcond=None)[0]
    pred = FEAT[lo]@reg_lo
    loocv_a1.append(abs(pred[1]-Cmat[lo,1])/abs(Cmat[lo,1]))   # skin coeff rel err
print(f"linear (width,rough,Rdc) a1(skin) LOO-CV max rel err = {max(loocv_a1)*100:.2f}%  "
      f"median={np.median(loocv_a1)*100:.2f}%")

def reg_coef(target):
    x = np.array([1.0, target['trace_width_um'], target['roughness_index'],
                  target['dc_resistance_ohm_per_m']], float)
    return x@REG

# ----------------------------------------------------------------------
# 5. Build target transfer functions
# ----------------------------------------------------------------------
print("\n=== Per-target velocity / phase-error estimate ===")
i10 = int(np.argmin(np.abs(f-10e9)))
i62 = int(np.argmin(np.abs(f-62.5e9)))
target_rows = []
for _, r in tl.iterrows():
    L = r.length_m
    width = r.trace_width_um
    sqrtLC = np.sqrt(r.inductance_h_per_m*r.capacitance_f_per_m)
    a0, a1, a2 = reg_coef(r)
    alpha_t = a0 + a1*np.sqrt(fG) + a2*fG
    beta_t, tg40_t = per_meter_beta(width, sqrtLC)
    gamma_t = alpha_t + 1j*beta_t
    H_t = np.exp(-gamma_t*L)
    magdb_t = 20*np.log10(np.abs(H_t))
    phase_t = -beta_t*L                      # unwrapped, starts at 0, decreases
    gdelay_t = -np.gradient(phase_t, w)      # consistent with -dphase/domega
    evel = np.median(loo)
    dph10 = 2*np.pi*(sqrtLC*(evel/100.0)*float(ratio_spline(width)))*I[i10]*L
    dph62 = 2*np.pi*(sqrtLC*(evel/100.0)*float(ratio_spline(width)))*I[i62]*L
    print(f"  {r.line_id}: width={width:.0f}um ratio={float(ratio_spline(width)):.4f} "
          f"tg40={tg40_t:.3e}s/m  a0={a0:.4f} a1={a1:.4f} a2={a2:.2e}  "
          f"est.phase-err ~ {dph10:.2f}rad@10G, {dph62:.2f}rad@62.5G")
    target_rows.append(dict(target_id=r.line_id, frequency_hz=f, magdb_t=magdb_t,
                            phase_t=phase_t, gdelay_t=gdelay_t, alpha_t=alpha_t,
                            H_t=H_t, L=L))

# ----------------------------------------------------------------------
# 6. results/target_transfer.csv
# ----------------------------------------------------------------------
tt = []
for tr in target_rows:
    tt.append(pd.DataFrame({
        'target_id': tr['target_id'],
        'frequency_hz': tr['frequency_hz'],
        'magnitude_db': tr['magdb_t'],
        'phase_rad': tr['phase_t'],
        'group_delay_s': tr['gdelay_t'],
        'attenuation_np_per_m': tr['alpha_t'],
    }))
pd.concat(tt, ignore_index=True).to_csv('results/target_transfer.csv', index=False)

# ----------------------------------------------------------------------
# 7. results/target_waveforms.csv  (IFFT of H(f)*FFT(input))
# ----------------------------------------------------------------------
Nt = len(vin)
X = np.fft.fft(vin)

def output_waveform(H):
    Hfull = np.empty(Nt, complex)
    Hfull[:len(f)] = H
    Hfull[len(f):] = np.conj(Hfull[len(f)-2:0:-1])  # Hfull[N-k]=conj(Hfull[k])
    return np.fft.ifft(X*Hfull).real

wave_rows = []
for tr in target_rows:
    vout = output_waveform(tr['H_t'])
    wave_rows.append(pd.DataFrame({
        'target_id': tr['target_id'], 'time_s': t, 'input_v': vin, 'output_v': vout,
    }))
pd.concat(wave_rows, ignore_index=True).to_csv('results/target_waveforms.csv', index=False)

# ----------------------------------------------------------------------
# 8. results/pulse_metrics.csv
# ----------------------------------------------------------------------
def half_crossings(time, sig, peak_idx):
    peak = sig[peak_idx]
    half = 0.5*abs(peak)
    rise = fall = None
    for i in range(peak_idx, 0, -1):
        if abs(sig[i]) >= half and abs(sig[i-1]) < half:
            fr = (half-abs(sig[i-1]))/(abs(sig[i])-abs(sig[i-1]))
            rise = time[i-1]+fr*(time[i]-time[i-1]); break
    for i in range(peak_idx, len(sig)-1):
        if abs(sig[i]) >= half and abs(sig[i+1]) < half:
            ff = (abs(sig[i])-half)/(abs(sig[i])-abs(sig[i+1]))
            fall = time[i]+ff*(time[i+1]-time[i]); break
    return rise, fall

def fwhm(time, sig):
    pk = int(np.argmax(np.abs(sig)))
    rise, fall = half_crossings(time, sig, pk)
    wdt = (fall-rise) if (rise is not None and fall is not None) else np.nan
    return wdt, pk, rise, fall

inp_fwhm, in_pk, _, _ = fwhm(t, vin)
metric_rows = []
for tr in target_rows:
    vout = output_waveform(tr['H_t'])
    out_fwhm, out_pk, rise, fall = fwhm(t, vout)
    in_peak_t = t[in_pk]; out_peak_t = t[out_pk]
    energy_ratio = np.trapezoid(vout**2, t)/np.trapezoid(vin**2, t)
    tail_asym = ((fall-out_peak_t)/(out_peak_t-rise)
                 if (rise is not None and fall is not None) else np.nan)
    metric_rows.append(dict(
        target_id=tr['target_id'],
        input_fwhm_s=inp_fwhm,
        output_fwhm_s=out_fwhm,
        fwhm_broadening_ratio=out_fwhm/inp_fwhm,
        peak_delay_s=out_peak_t-in_peak_t,
        output_peak_time_s=out_peak_t,
        energy_ratio=energy_ratio,
        tail_asymmetry=tail_asym,
    ))
pd.DataFrame(metric_rows).to_csv('results/pulse_metrics.csv', index=False)

print("\nWrote results/target_transfer.csv, results/target_waveforms.csv, results/pulse_metrics.csv")
print(pd.DataFrame(metric_rows).to_string(index=False))
