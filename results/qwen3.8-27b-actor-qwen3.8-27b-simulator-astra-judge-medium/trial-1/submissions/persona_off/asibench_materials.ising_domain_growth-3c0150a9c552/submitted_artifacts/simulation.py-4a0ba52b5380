#!/usr/bin/env python3
"""
B3: Hidden binary-grid time evolution  (episode: materials.ising_domain_growth)
=============================================================================
Model inferred from the inputs (no external description is provided):

* The state is a +/-1 spin on an L x L lattice with periodic (torus)
  boundaries.  The supplied initial state is an uncorrelated 50/50 random
  state (white noise: NN agreement ~0.50, flat power spectrum), i.e. the
  standard starting condition for coarsening (domain growth).

* `control` = 2.0236 is interpreted as the temperature T of the 2D Ising
  model with J = k_B = 1.  The exact 2D Ising T_c = 2/ln(1+sqrt(2)) =
  2.26919, so the system is prepared BELOW T_c (T/T_c = 0.892) -> ordered
  phase -> non-conserved order-parameter coarsening, R(t) ~ t^(1/2) for
  Glauber dynamics in 2D.

Dynamics: one "step" = one Monte-Carlo sweep = L^2 single-site Glauber
update attempts in a uniformly random order (the standard Markov process
whose stationary distribution is the Gibbs measure at temperature T).
For each site:
    h_i = sum of the 4 nearest-neighbour spins of site i (periodic)
    P(i flips) = 1/(1 + exp(2 s_i h_i / T)) = 0.5 (1 - s_i tanh(h_i/T))
Sites are processed in random chunks of 64 for vectorization; within a
chunk, neighbours in the same chunk use the chunk-start values (an
O(64/L^2) approximation to exact sequential dynamics).
Random numbers: numpy default_rng seeded with `dynamics_seed`.

Observables:
seriesA [2,n_meas]: row0 = |m(t)| (magnetization magnitude);
                    row1 = R(t) = integral correlation length of C(r,t)
seriesB [2,n_meas]: row0 = S(k_min,t) (S at the 4 smallest nonzero k, avg);
                    row1 = interface density (fraction broken NN bonds)
stackC  [n_snap,max_r]: circularly averaged radial correlation C(r,t)
stackD  [n_snap,L]: 1D periodic autocorrelation, lags 0..L-1
stackE  [n_snap,2,L]: structure factor along x (row0) and y (row1) axes
metadataA: dynamic-scaling collapse C(r,t) = f(r/R(t)) on stackC
metadataB: power-law fit R(t) = A t^alpha on a documented window

Only numpy / scipy / matplotlib are used.  Deterministic from dynamics_seed.
"""
import json
import numpy as np
from scipy import stats
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAS_MPL = True
except Exception:  # matplotlib not importable in this interpreter
    HAS_MPL = False

# ----------------------------------------------------------------------
# 1. Inputs
# ----------------------------------------------------------------------
with open("data/parameters.json") as fh:
    P = json.load(fh)

L       = int(P["grid_size"])
T       = float(P["control"])
n_steps = int(P["n_steps"])
snap_t  = np.asarray(P["snapshot_times"], dtype=float)
meas_t  = np.asarray(P["measurement_times"], dtype=float)
max_r   = int(P["max_r"])
seed    = int(P["dynamics_seed"])
n_meas  = len(meas_t)
n_snap  = len(snap_t)

s0 = np.load("data/initial_state.npy")
assert s0.shape == (L, L), "initial state shape mismatch"
assert set(np.unique(s0)).issubset({-1, 1}), "state is not binary +/-1"
s0 = s0.astype(np.int8)

# ----------------------------------------------------------------------
# 2. Precomputed geometry
# ----------------------------------------------------------------------
# Minimum-image offset set i, j in [-L/2, L/2) (L even): each distinct
# periodic shift exactly once.  Group offsets by rounded Euclidean distance.
half = L // 2
groups = {r: [] for r in range(max_r)}
for i in range(-half, half):
    for j in range(-half, half):
        r = int(round(np.hypot(i, j)))
        if r < max_r:
            groups[r].append((i, j))
for r in range(max_r):
    assert groups[r], f"no offsets for radial bin r={r}"

k_axis = np.fft.fftfreq(L, d=1.0 / L)          # [0,1,...,49,-50,...,-1]
kx, ky = np.meshgrid(k_axis, k_axis, indexing="ij")
k2 = kx * kx + ky * ky
k2_mask = k2 > 0.0

# ----------------------------------------------------------------------
# 3. Observable functions
# ----------------------------------------------------------------------
def structure_factor(s):
    F = np.fft.fft2(s.astype(np.float64))
    return np.abs(F) ** 2

def R_from_radial(cr):
    """Domain size / integral correlation length from the radial
    correlation C(r):  R = sum_r C(r) / C(0)  (standard integral
    correlation length, i.e. the area under C(r) normalized by C(0)).
    Tracks the growing domain size during coarsening and saturates near
    L/2 once a single domain spans the torus.
    """
    c0 = cr[0]
    if abs(c0) < 1e-12:
        return 0.0
    return float((cr / c0).sum())

def s_kmin(S):
    """Structure-factor intensity at the 4 smallest non-zero wavevectors."""
    return float(np.mean([S[1, 0], S[0, 1], S[-1, 0], S[0, -1]]))

def interface_density(s):
    ah = (s == np.roll(s, 1, axis=1)).mean()
    av = (s == np.roll(s, 1, axis=0)).mean()
    return float(1.0 - 0.5 * (ah + av))

def circ_autocorr(s):
    """A[i,j] = sum_{x,y} s[x,y] s[x+i, y+j] (periodic), via FFT."""
    F = np.fft.fft2(s.astype(np.float64))
    return np.fft.ifft2(F * np.conj(F)).real

def radial_from_A(A):
    c = np.empty(max_r, dtype=np.float64)
    for r in range(max_r):
        acc = 0.0
        for i, j in groups[r]:
            acc += A[i, j]
        c[r] = acc / (len(groups[r]) * L * L)
    return c

def line_from_A(A):
    d = np.arange(L)
    return (A[d, 0] + A[0, d]) / (2.0 * L * L)

# ----------------------------------------------------------------------
# 4. Time evolution (parallel Glauber sweeps)
# ----------------------------------------------------------------------
rng = np.random.default_rng(seed)
s = s0.copy()

meas_idx = {int(t): k for k, t in enumerate(meas_t)}
snap_idx = {int(t): k for k, t in enumerate(snap_t)}

seriesA = np.empty((2, n_meas), dtype=np.float64)
seriesB = np.empty((2, n_meas), dtype=np.float64)
stackC  = np.empty((n_snap, max_r), dtype=np.float64)
stackD  = np.empty((n_snap, L), dtype=np.float64)
stackE  = np.empty((n_snap, 2, L), dtype=np.float64)
snap_states = {}
R_snap = np.empty(n_snap, dtype=np.float64)

PTAB = np.array([0.5 * (1.0 - np.tanh(h / T))
                 for h in (-4.0, -2.0, 0.0, 2.0, 4.0)])
CHUNK = 64

def _sweep(state, rng):
    """One Monte-Carlo sweep: L^2 sequential Glauber attempts, random
    order, vectorized in random chunks of CHUNK sites."""
    idx = rng.permutation(L * L)
    for c in range(0, L * L, CHUNK):
        sel = idx[c:c + CHUNK]
        rows = sel // L
        cols = sel % L
        h = (state[(rows - 1) % L, cols] + state[(rows + 1) % L, cols]
             + state[rows, (cols - 1) % L]
             + state[rows, (cols + 1) % L]).astype(np.float64)
        hidx = ((h + 4.0) // 2).astype(np.int8)
        p = np.where(state[rows, cols] > 0,
                     PTAB[hidx], 1.0 - PTAB[hidx])
        fl = rng.random(len(sel)) < p
        if fl.any():
            state[rows[fl], cols[fl]] = -state[rows[fl], cols[fl]]
    return state

for t in range(1, n_steps + 1):
    s = _sweep(s, rng)

    if t in meas_idx:
        k = meas_idx[t]
        A = circ_autocorr(s)
        seriesA[0, k] = abs(float(s.mean()))
        seriesA[1, k] = R_from_radial(radial_from_A(A))
        S = structure_factor(s)
        seriesB[0, k] = s_kmin(S)
        seriesB[1, k] = interface_density(s)

    if t in snap_idx:
        k = snap_idx[t]
        A = circ_autocorr(s)
        cr = radial_from_A(A)
        stackC[k] = cr
        stackD[k] = line_from_A(A)
        S = structure_factor(s)
        stackE[k, 0] = S[:, 0]
        stackE[k, 1] = S[0, :]
        R_snap[k] = R_from_radial(cr)
        snap_states[k] = s.copy()

# ----------------------------------------------------------------------
# 5. metadataB: power-law fit  R(t) = A * t^alpha
# ----------------------------------------------------------------------
# Window selection rule (documented): local log-log slopes between
# consecutive measurements; reference slope = median of the local slopes
# over the first half of the (log-spaced) measurement schedule, where the
# coarsening is active; the window is the longest contiguous run of local
# slopes within +/-0.10 of the reference.  This isolates the intermediate-
# time power-law regime between the early-time relaxation from the
# uncorrelated initial state and the late-time finite-size saturation.
lt = np.log(meas_t)
lx = np.log(seriesA[1])
beta_local = np.diff(lx) / np.diff(lt)
first_half = slice(0, len(beta_local) // 2)
beta_ref = float(np.median(beta_local[first_half]))
good = np.abs(beta_local - beta_ref) <= 0.10

# longest contiguous True run of `good`
best_len, best_i, best_j = 0, 0, 0
i = 0
while i < len(good):
    if good[i]:
        j = i
        while j + 1 < len(good) and good[j + 1]:
            j += 1
        if j - i + 1 > best_len:
            best_len, best_i, best_j = j - i + 1, i, j
        i = j + 1
    else:
        i += 1
i0, i1 = best_i, best_j + 1        # measurement-index window (inclusive)
if best_len < 5:                    # fallback: first half of the run
    i0, i1 = first_half.start, first_half.stop + 1

sel = np.arange(i0, i1 + 1)
fit_t = meas_t[sel]
fit_R = seriesA[1, sel]
fit = stats.linregress(lt[sel], lx[sel])
alpha = float(fit.slope)
alpha_se = float(fit.stderr)
amplitude = float(np.exp(fit.intercept))
r_squared = float(fit.rvalue ** 2)
fit_range = [float(fit_t[0]), float(fit_t[-1])]

metadataB = {
    "exponent": alpha,
    "exponent_std_error": alpha_se,
    "amplitude": amplitude,
    "fit_range": fit_range,
    "r_squared": r_squared,
    "notes": [
        "Fit: log R(t) = log A + alpha * log t (ordinary least squares on "
        "the log-log data of seriesA row 1, where R(t) is the integral "
        "correlation length of the radial correlation C(r,t): "
        "R = sum_r C(r) / C(0) (area under C(r), normalized by C(0)).",
        f"Window rule: longest contiguous run of local log-log slopes within "
        f"+/-0.10 of the median local slope over the first half of the "
        f"schedule (reference slope {beta_ref:.4f}); selected measurement "
        f"indices [{i0}, {i1}] -> fit_range = {fit_range}.",
        f"Number of measurements used in the fit: n = {len(fit_t)}.",
        "Expected asymptotic exponent for 2D Ising Glauber coarsening is 1/2; "
        "deviations reflect finite-size effects (L = 100) at long times and "
        "the early-time crossover from the uncorrelated initial state.",
    ],
}

# ----------------------------------------------------------------------
# 6. metadataA: dynamic-scaling collapse  C(r,t) = f(r / R(t))
# ----------------------------------------------------------------------
collapse_grid_size = 200
x_s = np.arange(max_r, dtype=np.float64)[None, :] / R_snap[:, None]
x_max = float(x_s[:, -1].min())          # overlap of all rescaled curves
xg = np.linspace(0.0, x_max, collapse_grid_size)
Y = np.stack([np.interp(xg, x_s[ss], stackC[ss]) for ss in range(n_snap)])
Y_bar = Y.mean(axis=0)
num = np.sqrt((Y - Y_bar[None, :]) ** 2).mean()
den = np.sqrt((Y_bar ** 2).mean())
rel_rms_spread = float(num / den)
collapse_quality = float(np.clip(1.0 - rel_rms_spread, 0.0, 1.0))

metadataA = {
    "collapse_check_applicable": True,
    "collapse_quality": collapse_quality,
    "collapse_relative_rms_spread": rel_rms_spread,
    "collapse_dimension": 2,
    "collapse_snapshot_times": [float(t) for t in snap_t],
    "collapse_lengths": [float(r) for r in R_snap],
    "collapse_x_range": [0.0, x_max],
    "collapse_grid_size": collapse_grid_size,
    "notes": [
        "Dynamic-scaling test C(r,t) = f(r/R(t)) applied to stackC using "
        "R(t) = integral correlation length of the radial correlation, "
        "evaluated at the 6 snapshot times (3 of which lie off the "
        "measurement schedule, so R was computed directly from the state "
        "at those times).",
        "Each radial correlation curve was rescaled as x = r/R(t) and "
        f"linearly resampled onto a common grid of {collapse_grid_size} "
        f"points over the overlap x in [0, {x_max:.4f}].",
        "collapse_relative_rms_spread = rms over (curve, x) of "
        "(C_s(x) - mean_s C_s(x)) divided by the rms of the mean curve; "
        "collapse_quality = clip(1 - spread, 0, 1).",
        "collapse_dimension = 2 refers to the 2D radial (circularly "
        "averaged) correlation; collapse_grid_size would be 0 iff not "
        "applicable.",
    ],
}

# ----------------------------------------------------------------------
# 7. Save arrays (exact shapes, float64, finite) and JSON metadata
# ----------------------------------------------------------------------
def save(name, arr):
    arr = np.ascontiguousarray(arr, dtype=np.float64)
    assert np.all(np.isfinite(arr)), f"{name} contains non-finite values"
    np.save(name, arr)
    return arr

save("seriesA.npy", seriesA)
save("seriesB.npy", seriesB)
save("stackC.npy", stackC)
save("stackD.npy", stackD)
save("stackE.npy", stackE)

with open("metadataA.json", "w") as fh:
    json.dump(metadataA, fh, indent=2)
with open("metadataB.json", "w") as fh:
    json.dump(metadataB, fh, indent=2)

