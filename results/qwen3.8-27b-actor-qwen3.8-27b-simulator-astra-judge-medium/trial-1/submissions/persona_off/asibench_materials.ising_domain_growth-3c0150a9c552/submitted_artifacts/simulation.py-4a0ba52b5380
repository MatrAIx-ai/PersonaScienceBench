def _png_write(path, rgb):
    """Write an HxWx3 uint8 array as PNG (Python stdlib only)."""
    import zlib, struct
    h, w = rgb.shape[:2]
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", ihdr))
        fh.write(chunk(b"IDAT", zlib.compress(raw, 9)))
        fh.write(chunk(b"IEND", b""))

def _put_text(cv, x, y, s, color, scale=1):
    cx = x
    for ch in s:
        g = _FONT5X7.get(ch, _FONT5X7["?"])
        for ry in range(7):
            bits = g[ry]
            if not bits:
                continue
            for rx in range(5):
                if bits & (1 << (4 - rx)):
                    yy = y + ry * scale
                    xx = cx + rx * scale
                    cv[yy:yy + scale, xx:xx + scale] = color
        cx += 6 * scale

def _put_line(cv, x0, y0, x1, y1, color, w=2, dash=None):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    H, W = cv.shape[:2]
    for i in range(n + 1):
        if dash is not None:
            on, off = dash
            if (i % (on + off)) >= on:
                continue
        x = int(round(x0 + (x1 - x0) * i / n))
        y = int(round(y0 + (y1 - y0) * i / n))
        for dx in range(w):
            for dy in range(w):
                xx, yy = x + dx, y + dy
                if 0 <= xx < W and 0 <= yy < H:
                    cv[yy, xx] = color

def _fmt_num(v):
    if v == 0:
        return "0"
    a = abs(v)
    if a >= 100:
        return str(int(round(v)))
    if a >= 1:
        r = round(v, 1)
        return str(int(r)) if r == int(r) else f"{r:.1f}"
    s = f"{round(v, 2):.2f}".rstrip("0").rstrip(".")
    return s if s else "0"

def _log_tick_label(v):
    n = int(round(np.log10(v)))
    return {0: "1", 1: "10", 2: "100", 3: "1000", 4: "10000",
            -1: "0.1", -2: "0.01"}.get(n, f"1e{n}")

def _put_text_rot(cv, x, y, s, color, scale=1):
    tmp = np.zeros((7 * scale, max(1, len(s) * 6 * scale), 3), np.uint8)
    _put_text(tmp, 0, 0, s, color, scale)
    rot = np.rot90(tmp, 1)
    h2, w2 = rot.shape[:2]
    H, W = cv.shape[:2]
    y2 = max(0, min(y, H - h2)); x2 = max(0, min(x, W - w2))
    m = rot.sum(axis=2, keepdims=True) > 0
    cv[y2:y2 + h2, x2:x2 + w2] = np.where(m, rot, cv[y2:y2 + h2, x2:x2 + w2])

def _frame(cv, x0, y0, x1, y1):
    _put_line(cv, x0, y0, x1, y0, (0, 0, 0), 2)
    _put_line(cv, x0, y1, x1, y1, (0, 0, 0), 2)
    _put_line(cv, x0, y0, x0, y1, (0, 0, 0), 2)
    _put_line(cv, x1, y0, x1, y1, (0, 0, 0), 2)

def _image_panel(cv, x0, y0, pw, ph, title, data):
    _put_text(cv, x0 + 8, y0 + 6, title, (0, 0, 0))
    px0, py0 = x0 + 10, y0 + 24
    w2, h2 = pw - 20, ph - 58
    img = np.where(data[..., None] > 0,
                   np.array([178, 24, 43], np.uint8),
                   np.array([33, 102, 172], np.uint8))
    ys = (np.arange(h2) * data.shape[0] // h2)
    xs = (np.arange(w2) * data.shape[1] // w2)
    cv[py0:py0 + h2, px0:px0 + w2] = img[ys][:, xs]
    _frame(cv, px0, py0, px0 + w2, py0 + h2)

def _plot_panel(cv, x0, y0, pw, ph, title, ylab, xlab, curves,
                xmode="lin", ymode="lin", xlim=None, ylim=None,
                show_labels=True):
    _put_text(cv, x0 + 8, y0 + 6, title, (0, 0, 0))
    px0, py0 = x0 + 58, y0 + 24
    pw2, ph2 = pw - 70, ph - 58
    # data ranges (log axes: positive values only)
    def range_of(arr, mode):
        if mode == "log":
            v = arr[arr > 0]
            if len(v) == 0:
                return 1e-6, 1.0
            return float(v.min()), float(v.max())
        return float(arr.min()), float(arr.max())
    def pad(lo, hi, mode):
        if mode == "log":
            llo, lhi = np.log10(lo), np.log10(hi)
            span = lhi - llo
            return 10 ** (llo - 0.05 * span), 10 ** (lhi + 0.05 * span)
        span = hi - lo
        if span == 0:
            span = 1.0
        return lo - 0.05 * span, hi + 0.05 * span
    if xlim is None:
        lo = min(range_of(c[0], xmode)[0] for c in curves)
        hi = max(range_of(c[0], xmode)[1] for c in curves)
        xlim = pad(lo, hi, xmode)
    if ylim is None:
        lo = min(range_of(c[1], ymode)[0] for c in curves)
        hi = max(range_of(c[1], ymode)[1] for c in curves)
        ylim = pad(lo, hi, ymode)
    def tr(v, lo, hi, mode):
        if mode == "log":
            llo, lhi = np.log10(lo), np.log10(hi)
            return (np.log10(v) - llo) / (lhi - llo)
        return (v - lo) / (hi - lo)
    def X(v):
        return px0 + tr(v, xlim[0], xlim[1], xmode) * pw2
    def Y(v):
        return py0 + ph2 - tr(v, ylim[0], ylim[1], ymode) * ph2
    _frame(cv, px0, py0, px0 + pw2, py0 + ph2)
    # ticks
    def ticks(lo, hi, mode):
        if mode == "log":
            nlo, nhi = int(np.ceil(np.log10(lo))), int(np.floor(np.log10(hi)))
            return [10.0 ** n for n in range(nlo, nhi + 1)]
        n = 5
        return [lo + (hi - lo) * i / (n - 1) for i in range(n)]
    for v in ticks(*xlim, xmode):
        if not (xlim[0] <= v <= xlim[1]):
            continue
        xx = int(X(v))
        _put_line(cv, xx, py0 + ph2, xx, py0 + ph2 + 5, (0, 0, 0), 1)
        lab = _log_tick_label(v) if xmode == "log" else _fmt_num(v)
        _put_text(cv, xx - 3 * len(lab), py0 + ph2 + 8, lab, (0, 0, 0))
    for v in ticks(*ylim, ymode):
        if not (ylim[0] <= v <= ylim[1]):
            continue
        yy = int(Y(v))
        _put_line(cv, px0 - 5, yy, px0, yy, (0, 0, 0), 1)
        lab = _log_tick_label(v) if ymode == "log" else _fmt_num(v)
        _put_text(cv, px0 - 8 - 6 * len(lab), yy - 3, lab, (0, 0, 0))
    _put_text(cv, px0 + pw2 // 2 - 3 * len(xlab), y0 + ph - 14, xlab, (0, 0, 0))
    _put_text_rot(cv, x0 + 2, py0 + ph2 // 2 - 3 * len(ylab), ylab, (0, 0, 0))
    # curves
    for (xs, ys, color, dash, lab) in curves:
        ok = (xs > 0) if xmode == "log" else np.ones(len(xs), bool)
        ok &= (ys > 0) if ymode == "log" else np.ones(len(ys), bool)
        prev = None
        for i in range(len(xs)):
            if ok[i]:
                p = (int(X(xs[i])), int(Y(ys[i])))
                if prev is not None:
                    _put_line(cv, prev[0], prev[1], p[0], p[1], color, 2, dash)
                prev = p
            else:
                prev = None
        if show_labels and prev is not None:
            cw = cv.shape[1]
            _put_text(cv, min(prev[0] + 3, cw - 42), max(prev[1] - 9, 0),
                      lab, color)

