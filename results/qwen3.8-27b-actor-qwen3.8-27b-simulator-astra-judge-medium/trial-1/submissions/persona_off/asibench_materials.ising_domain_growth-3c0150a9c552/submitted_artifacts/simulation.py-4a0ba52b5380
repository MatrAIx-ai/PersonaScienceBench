def make_figure_mpl():
    """Multi-panel diagnostic figure via matplotlib."""
    fig = plt.figure(figsize=(17, 20), dpi=140)
    gs = fig.add_gridspec(4, 3, hspace=0.35, wspace=0.35)

    # rows 1-2: the six sampled states
    for ss in range(n_snap):
        ax = fig.add_subplot(gs[ss // 3, ss % 3])
        ax.imshow(snap_states[ss], cmap="bwr", vmin=-1.0, vmax=1.0,
                  interpolation="nearest")
        ax.set_title(f"state at t = {snap_t[ss]:.0f}")
        ax.set_xticks([]); ax.set_yticks([])

    # row 3: seriesA + power-law fit
    ax = fig.add_subplot(gs[2, 0])
    ax.loglog(meas_t, seriesA[0], lw=1.2, label="|m(t)|")
    ax.loglog(meas_t, seriesA[1], lw=1.2, label="R(t) (integral corr. length)")
    tf = np.linspace(fit_range[0], fit_range[1], 50)
    ax.loglog(tf, amplitude * tf ** alpha, "r--", lw=1.5,
              label=f"fit: R = {amplitude:.2f} t^{alpha:.3f} "
                    f"(R$^2$={r_squared:.3f})")
    ax.set_xlabel("t (steps)"); ax.set_ylabel("value")
    ax.set_title("seriesA: |m(t)| and R(t)")
    ax.legend(fontsize=8); ax.grid(alpha=0.3, which="both")

    # row 3: seriesB
    ax = fig.add_subplot(gs[2, 1])
    ax.loglog(meas_t, seriesB[0], lw=1.2, label="S(k_min, t)")
    ax.loglog(meas_t, seriesB[1], lw=1.2, label="interface density I(t)")
    ax.set_xlabel("t (steps)"); ax.set_ylabel("value")
    ax.set_title("seriesB: S(k_min) and interface density")
    ax.legend(fontsize=8); ax.grid(alpha=0.3, which="both")

    # row 3: stackC raw radial correlations
    ax = fig.add_subplot(gs[2, 2])
    for ss in range(n_snap):
        ax.semilogy(np.arange(max_r), stackC[ss], lw=1.2,
                    label=f"t={snap_t[ss]:.0f}")
    ax.set_xlabel("r"); ax.set_ylabel("C(r, t)")
    ax.set_title("stackC: radial correlation C(r,t)")
    ax.legend(fontsize=7); ax.grid(alpha=0.3, which="both")

    # row 4: the collapse
    ax = fig.add_subplot(gs[3, 0])
    for ss in range(n_snap):
        ax.plot(xg, Y[ss], lw=1.2, label=f"t={snap_t[ss]:.0f}")
    ax.plot(xg, Y_bar, "k-", lw=1.8, alpha=0.7, label="mean")
    ax.set_xlabel(r"$r / R(t)$"); ax.set_ylabel(r"$C(r,t)$")
    ax.set_title(f"collapse C(r,t)=f(r/R(t))  (quality={collapse_quality:.3f})")
    ax.legend(fontsize=7); ax.grid(alpha=0.3)

    # row 4: stackD 1D autocorrelation
    ax = fig.add_subplot(gs[3, 1])
    for ss in range(n_snap):
        ax.semilogy(np.arange(L), stackD[ss], lw=1.2, label=f"t={snap_t[ss]:.0f}")
    ax.set_xlabel("lag d"); ax.set_ylabel("$C_{1d}(d,t)$")
    ax.set_title("stackD: 1D periodic autocorrelation")
    ax.legend(fontsize=7); ax.grid(alpha=0.3, which="both")

    # row 4: stackE structure factor along the two axes
    ax = fig.add_subplot(gs[3, 2])
    ks = np.arange(1, L)
    for ss in range(n_snap):
        ax.semilogy(ks, stackE[ss, 0, 1:], lw=1.2, label=f"t={snap_t[ss]:.0f} (x)")
    ax.semilogy(ks, stackE[n_snap - 1, 1, 1:], ":", color="gray", lw=1.5,
                label=f"t={snap_t[-1]:.0f} (y)")
    ax.set_xlabel("k"); ax.set_ylabel("$S(k)$")
    ax.set_title("stackE: structure factor along x (solid) and y (dotted, last t)")
    ax.legend(fontsize=7); ax.grid(alpha=0.3, which="both")

    fig.suptitle(
        f"2D Ising domain growth, L={L}, T={T:.4f} (< Tc=2.2692), Glauber, "
        f"seed={seed}\n"
        f"R(t) = {amplitude:.3f} t^{alpha:.3f} +/- {alpha_se:.3f} on "
        f"t in [{fit_range[0]:.0f}, {fit_range[1]:.0f}], R$^2$={r_squared:.4f};  "
        f"collapse quality = {collapse_quality:.3f}",
        fontsize=12,
    )
    fig.savefig("figure.png")
    plt.close(fig)

