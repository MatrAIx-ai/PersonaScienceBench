"""Solve bounded instances of  a*sigma(n) - b*n = c  for 1 <= n <= U.

Approach: a structure-aware, recursive prime-power factorization tree.
We build n from its prime-power factors in strictly increasing prime order
(so every n is enumerated exactly once), tracking (n0, sigma(n0)).  Two
prunings keep the search small:

  * Corner bound: any completion is n = n0*m with m in [1, U//n0] and
    f = sigma(m)/m in [1, R] (R = Robin's upper bound on the abundancy
    index).  The residual a*sigma(n) - b*n = m*(A*f - B) with A = a*s0,
    B = b*n0 is bilinear in (m, f), so it attains its min/max at the four
    corners of the rectangle; if c lies outside that range the whole
    subtree is pruned.
  * Tail solve: once n0*p^2 > U the remaining multiplier can only be 1 or a
    single prime, which we solve analytically in O(1) instead of looping.

This avoids a flat O(U log U) divisor-sum precompute.
"""

import math

# e^gamma (Gompertz constant), needed for Robin's bound; hardcoded because
# math.euler_gamma is not available in every build.
_E_GAMMA = 1.7810724179901979852365041031071795491697


def _primes_upto(n):
    """Return the list of all primes <= n (bytearray slicing sieve)."""
    if n < 2:
        return []
    sieve = bytearray([1]) * (n + 1)
    sieve[0:2] = b'\x00\x00'
    limit = math.isqrt(n)
    for i in range(2, limit + 1):
        if sieve[i]:
            step = i
            start = i * i
            sieve[start::step] = bytearray(len(sieve[start::step]))
    return [i for i in range(2, n + 1) if sieve[i]]


def _abundancy_bound(U):
    """Safe upper bound on sigma(m)/m for 1 <= m <= U (Robin's theorem)."""
    if U < 3:
        return 4.0
    lnln = math.log(math.log(U))
    if lnln <= 0:
        return 4.0
    # sigma(m)/m < e^gamma * ln(ln m) + 0.6483 / ln(ln m) for m >= 3;
    # the +1 margin also covers the small-m non-monotonicity.
    return _E_GAMMA * lnln + 0.6483 / lnln + 1.0


def solve(a: int, b: int, c: int, U: int) -> list[int]:
    """Return all n in [1, U] with a*sigma(n) = b*n + c, sorted ascending."""
    U = int(U)
    if U < 1:
        return []

    # ---- Special case a == 0: the equation reduces to 0 = b*n + c. ----
    if a == 0:
        if b == 0:
            # 0 = c: every n works when c == 0, otherwise none.
            return list(range(1, U + 1)) if c == 0 else []
        # b*n = -c  ->  n = -c / b
        if c % b == 0:
            n = -c // b
            if 1 <= n <= U:
                return [n]
        return []

    # ---- Early exit: a*sigma(n) is a multiple of a, so b*n + c must be too.
    #      This is possible only when gcd(a, b) divides c. ----
    if c % math.gcd(a, b) != 0:
        return []

    primes = _primes_upto(U)
    is_prime = set(primes)
    R = _abundancy_bound(U)
    res = []
    import sys
    sys.setrecursionlimit(100000)

    def dfs(idx, n0, s0):
        # Stop-test: n0 itself satisfies the equation.
        if a * s0 - b * n0 == c:
            res.append(n0)

        M = U // n0
        if M < 2:
            return

        A = a * s0
        B = b * n0
        # Corner bound for the residual m*(A*f - B), m in [1, M], f in [1, R].
        v = (A - B, A * R - B, M * (A - B), M * (A * R - B))
        if c < min(v) or c > max(v):
            return

        for i in range(idx, len(primes)):
            p = primes[i]
            if n0 * p > U:
                break
            if n0 * p * p > U:
                # Tail: remaining factor is 1 or a single prime q >= p.
                den = A - B
                if den == 0:
                    if a * s0 == c:
                        j = i
                        while j < len(primes):
                            q = primes[j]
                            if n0 * q > U:
                                break
                            res.append(n0 * q)
                            j += 1
                else:
                    num = c - a * s0
                    if num % den == 0:
                        q = num // den
                        if q >= p and n0 * q <= U and q in is_prime:
                            res.append(n0 * q)
                break
            # Normal recursion: append p^e for e >= 1 while n0*p^e <= U.
            pe = p
            se = 1 + p  # sigma(p)
            while n0 * pe <= U:
                dfs(i + 1, n0 * pe, s0 * se)
                pe *= p
                se += pe  # sigma(p^(e+1)) = sigma(p^e) + p^(e+1)

    dfs(0, 1, 1)
    return sorted(set(res))


if __name__ == "__main__":
    # Small self-demo (not required by the scorer).
    print(solve(6, 7, 77, 250000))
