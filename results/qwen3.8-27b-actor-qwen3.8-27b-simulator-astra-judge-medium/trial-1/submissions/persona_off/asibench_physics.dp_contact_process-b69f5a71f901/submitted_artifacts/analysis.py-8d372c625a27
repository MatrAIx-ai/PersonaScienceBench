#!/usr/bin/env python3
"""
Threshold and scaling analysis of the asymmetric parity-modulated nearest-neighbor
birth-death (contact-type) process defined in ./data/task_input.json.

Model (exactly as specified by the input contract):
  - 1D lattice, periodic BC, binary states 0/1, fully active initial condition.
  - Random-sequential updates: one sweep = L random site visits, implemented as a
    uniform random permutation of the L sites (each site visited exactly once).
  - Visited active site dies with probability dt.
  - Visited inactive site i is born with
      p_birth = min(1, lambda * dt * parity_scale(i) * (lw*s[i-1] + rw*s[i+1])).
  - rho(t) and survival probability recorded once per sweep, t = 1..t_max.

Outputs: ./results/dp_summary.csv, dp_scan.csv, dp_timeseries.csv, dp_report.json
"""
import json
import os

import numpy as np
import pandas as pd
from scipy.optimize import minimize

# ----------------------------------------------------------------------
# Input parsing: protocol is the single source of truth
# ----------------------------------------------------------------------
BASE = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(BASE, "data", "task_input.json"), encoding="utf-8-sig") as fh:
    INP = json.load(fh)

PROTO = INP["protocol"]
LAMBDA_SCAN = [float(x) for x in PROTO["lambda_scan"]]
BETA_FIT_LAMBDAS = [float(x) for x in PROTO["beta_fit_lambdas"]]
SYSTEM_SIZES = [int(x) for x in PROTO["system_sizes"]]
N_SEEDS = int(PROTO["n_seeds"])
T_MAX = int(PROTO["t_max"])
SEED = int(PROTO["seed"])
TASK_ID = INP["task_id"]

PAR = INP["parameterization"]
DT = float(PAR["dt"])
LW = float(PAR["left_neighbor_weight"])
RW = float(PAR["right_neighbor_weight"])
PEVEN = float(PAR["site_parity_scale"]["even"])
PODD = float(PAR["site_parity_scale"]["odd"])

# DP reference values, used only as consistency targets (not as model inputs)
DP_BETA = 0.408
DP_DELTA = 0.802
NU_PERP = 0.509
DP_Z = 3.08

RHO_SS_WINDOW = T_MAX // 2  # rho_ss = mean of rho over t in (t_max/2, t_max]


def make_parity(L):
    return [PEVEN if i % 2 == 0 else PODD for i in range(L)]


def simulate_run(L, lam, t_max, rng, replace=False):
    """One trajectory. Returns (rho[t=1..t_max], death_sweep or t_max+1)."""
    state = [1] * L
    count = L
    parity = make_parity(L)
    order = np.arange(L)
    rho = np.zeros(t_max)
    rand = rng.random
    death = t_max + 1
    for t in range(1, t_max + 1):
        if replace:
            idxs = rng.integers(0, L, L)
        else:
            rng.shuffle(order)
            idxs = order
        for i in idxs:
            if state[i]:
                if rand() < DT:
                    state[i] = 0
                    count -= 1
            else:
                p = lam * DT * parity[i] * (LW * state[i - 1] + RW * state[(i + 1) % L])
                if p > 0.0 and rand() < p:
                    state[i] = 1
                    count += 1
        if count == 0:
            death = t
            break
        rho[t - 1] = count / L
    return rho, death


def main():
    os.makedirs(os.path.join(BASE, "results"), exist_ok=True)
    n_l = len(LAMBDA_SCAN)
    n_s = len(SYSTEM_SIZES)

    # ------------------------------------------------------------------
    # Main simulation: all (lambda, L, seed) trajectories
    # ------------------------------------------------------------------
    runs = {}
    for li, lam in enumerate(LAMBDA_SCAN):
        for si, L in enumerate(SYSTEM_SIZES):
            lst = []
            for ri in range(N_SEEDS):
                rng = np.random.default_rng((SEED, li, si, ri))
                rho, death = simulate_run(L, lam, T_MAX, rng)
                lst.append((rho, death))
            runs[(li, si)] = lst
            print(f"done lam={lam} L={L}", flush=True)

    rho_mean = {}
    alive_frac_t = {}
    rho_ss = {}
    surv_end = {}
    for li in range(n_l):
        for si in range(n_s):
            lst = runs[(li, si)]
            rm = np.mean([r for r, _ in lst], axis=0)
            rho_mean[(li, si)] = rm
            af = np.array(
                [sum(1 for _, d in lst if d >= t) for t in range(1, T_MAX + 1)]
            ) / N_SEEDS
            alive_frac_t[(li, si)] = af
            rho_ss[(li, si)] = float(np.mean(rm[RHO_SS_WINDOW:]))
            surv_end[(li, si)] = float(af[-1])

    # ------------------------------------------------------------------
    # dp_timeseries.csv and dp_scan.csv
    # ------------------------------------------------------------------
    ts_rows = []
    for li, lam in enumerate(LAMBDA_SCAN):
        for si, L in enumerate(SYSTEM_SIZES):
            rm = rho_mean[(li, si)]
            af = alive_frac_t[(li, si)]
            for t in range(1, T_MAX + 1):
                ts_rows.append((lam, L, t, float(rm[t - 1]), float(af[t - 1])))
    df_ts = pd.DataFrame(
        ts_rows, columns=["lambda", "system_size", "time", "rho", "survival_prob"]
    )
    df_ts.to_csv(os.path.join(BASE, "results", "dp_timeseries.csv"), index=False)

    sc_rows = []
    for li, lam in enumerate(LAMBDA_SCAN):
        for si, L in enumerate(SYSTEM_SIZES):
            sc_rows.append((lam, L, rho_ss[(li, si)], surv_end[(li, si)], N_SEEDS))
    df_sc = pd.DataFrame(
        sc_rows, columns=["lambda", "system_size", "rho_ss", "survival_prob", "n_runs"]
    )
    df_sc.to_csv(os.path.join(BASE, "results", "dp_scan.csv"), index=False)

    # ------------------------------------------------------------------
    # lambda_c estimation: four independent indicators, median + spread CI
    # ------------------------------------------------------------------
    # (1) FSS fit of rho_ss over all 36 points, lc constrained to the scan vicinity:
    #     rho_ss(L, lam) = A * L^{-delta} * F((lam-lc)*L^{1/nu_perp})
    #     F(x) = x^beta/(1+x^{beta/nu_perp})  (x>0);  exp(-w*(-x)) (x<=0)
    data_lam = np.array([LAMBDA_SCAN[li] for li in range(n_l) for si in range(n_s)])
    data_L = np.array([SYSTEM_SIZES[si] for li in range(n_l) for si in range(n_s)])
    data_rho = np.array([rho_ss[(li, si)] for li in range(n_l) for si in range(n_s)])
    log_rho_d = np.log(np.maximum(data_rho, 1e-4))

    def fss_logmodel(p):
        u, logA, v, beta, w = p
        lc = 1.70 + 0.09 / (1.0 + np.exp(-u))  # lc in (1.70, 1.79)
        delta = 0.05 + 1.45 / (1.0 + np.exp(-v))  # delta in (0.05, 1.50)
        x = (data_lam - lc) * data_L ** (1.0 / NU_PERP)
        pos = x > 0
        g = np.empty_like(x)
        g[pos] = x[pos] ** beta / (1.0 + x[pos] ** (beta / NU_PERP))
        g[~pos] = np.exp(-w * (-x[~pos]))
        return logA - delta * np.log(data_L) + np.log(g + 1e-12)

    def fss_obj(p):
        r = fss_logmodel(p) - log_rho_d
        return float(np.sum(r * r))

    best = None
    for u0 in (-2.0, 0.0, 2.0):
        p0 = np.array([u0, np.log(0.3), 0.8, 0.4, 1.0])
        res = minimize(fss_obj, p0, method="Nelder-Mead",
                       options={"maxiter": 40000, "xatol": 1e-9, "fatol": 1e-11})
        if best is None or res.fun < best.fun:
            best = res
    lc_fss = 1.70 + 0.09 / (1.0 + np.exp(-best.x[0]))
    chi2_fss = float(best.fun)
    v_fss = best.x[2]
    delta_fss = 0.05 + 1.45 / (1.0 + np.exp(-v_fss))
    beta_fss, w_fss = best.x[3], best.x[4]
    delta_fss_lower_bound = bool(delta_fss <= 0.06)
    npts = len(data_rho)
    J = np.zeros((npts, 5))
    base_res = fss_logmodel(best.x) - log_rho_d
    for k in range(5):
        h = 1e-6 * max(1.0, abs(best.x[k]))
        pp = best.x.copy(); pp[k] += h
        J[:, k] = (fss_logmodel(pp) - log_rho_d - base_res) / h
    try:
        cov = np.linalg.inv(J.T @ J) * (chi2_fss / max(1, npts - 5))
        se_fss = np.sqrt(np.maximum(np.diag(cov), 0.0))
    except np.linalg.LinAlgError:
        se_fss = np.full(5, np.nan)
    sig_v = 1.0 / (1.0 + np.exp(-v_fss))
    se_delta_fss = float(se_fss[2] * 1.45 * sig_v * (1.0 - sig_v)) if np.isfinite(se_fss[2]) else np.nan

    # (2) logistic MLE on L=32 survival vs lambda
    si32 = SYSTEM_SIZES.index(32) if 32 in SYSTEM_SIZES else 0
    s32 = np.array([surv_end[(li, si32)] * N_SEEDS for li in range(n_l)])
    lam32 = np.array(LAMBDA_SCAN)

    def loglik_neg(p):
        lc, w = p
        p_i = 1.0 / (1.0 + np.exp(-(lam32 - lc) / w))
        p_i = np.clip(p_i, 1e-12, 1 - 1e-12)
        return float(-np.sum(s32 * np.log(p_i) + (N_SEEDS - s32) * np.log(1 - p_i)))

    res_log = minimize(loglik_neg, [1.74, 0.02], method="L-BFGS-B",
                       bounds=[(1.68, 1.80), (1e-3, 0.15)])
    lc_logi = float(res_log.x[0])
    se_logi = np.nan
    H = np.zeros((2, 2))
    f0 = loglik_neg(res_log.x)
    for a in range(2):
        for b in range(2):
            h = 1e-5
            pa = res_log.x.copy(); pa[a] += h; f1 = loglik_neg(pa)
            pb = res_log.x.copy(); pb[b] += h; f2 = loglik_neg(pb)
            pab = res_log.x.copy(); pab[a] += h; pab[b] += h; f3 = loglik_neg(pab)
            H[a, b] = (f3 - f1 - f2 + f0) / h / h
    try:
        eig = np.linalg.eigvalsh(H)
        if np.all(eig > 1e-12):
            se_logi = float(np.sqrt(np.linalg.inv(H)[0, 0]))
    except np.linalg.LinAlgError:
        pass

    # (3) diagnostic: power-law knee fit on L=32 rho_ss
    rho32 = np.array([rho_ss[(li, si32)] for li in range(n_l)])

    def knee_obj(p):
        lc, logB, beta = p
        d = lam32 - lc
        pred = np.where(d > 0, np.exp(logB) * np.maximum(d, 1e-9) ** beta, 1e-4)
        r = np.log(pred) - np.log(np.maximum(rho32, 1e-4))
        return float(np.sum(r * r))

    best_k = None
    for lc0 in (1.70, 1.73, 1.76):
        res_k = minimize(knee_obj, [lc0, np.log(0.3), 0.5], method="Nelder-Mead",
                         options={"maxiter": 20000, "xatol": 1e-8, "fatol": 1e-10})
        if best_k is None or res_k.fun < best_k.fun:
            best_k = res_k
    lc_knee = float(best_k.x[0])

    # (4) slope indicator: lambda where L=256 decay slope crosses -DP_BETA/DP_Z
    def slope256(lam, t0=20, t1=500):
        si = SYSTEM_SIZES.index(256)
        rm = rho_mean[(LAMBDA_SCAN.index(lam), si)]
        tg = np.arange(t0, t1 + 1)
        y = rm[tg - 1]
        good = y > 1e-4
        if good.sum() < 10:
            return np.nan
        x = np.log(tg[good]); yy = np.log(y[good])
        c = np.polyfit(x, yy, 1)
        pred = np.polyval(c, x)
        ss_res = float(np.sum((yy - pred) ** 2))
        ss_tot = float(np.sum((yy - yy.mean()) ** 2))
        r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else np.nan
        return float(c[0]), r2

    slopes = {}
    for lam in LAMBDA_SCAN:
        sl = slope256(lam)
        slopes[lam] = sl
    target_slope = -DP_BETA / DP_Z
    lc_slope = np.nan
    for i in range(n_l - 1):
        s1 = slopes[LAMBDA_SCAN[i]][0]
        s2 = slopes[LAMBDA_SCAN[i + 1]][0]
        if np.isfinite(s1) and np.isfinite(s2) and (s1 - target_slope) * (s2 - target_slope) < 0:
            f = (target_slope - s1) / (s2 - s1)
            lc_slope = LAMBDA_SCAN[i] + f * (LAMBDA_SCAN[i + 1] - LAMBDA_SCAN[i])
            break

    indicators = {
        "fss_fit": float(lc_fss),
        "l32_logistic": float(lc_logi),
        "l32_rho_knee": float(lc_knee),
        "slope_indicator": float(lc_slope) if np.isfinite(lc_slope) else None,
    }
    finite = [v for v in indicators.values() if v is not None and np.isfinite(v)]
    lc_final = float(np.median(finite))
    lc_lo, lc_hi = float(min(finite)), float(max(finite))
    lc_spread = lc_hi - lc_lo

    # ------------------------------------------------------------------
    # beta from beta_fit_lambdas (supercritical side), L=256 primary
    # ------------------------------------------------------------------
    def beta_fit(L, lams):
        si = SYSTEM_SIZES.index(L)
        pts = []
        for lam in lams:
            if lam > lc_final + 1e-9 and lam in LAMBDA_SCAN:
                li = LAMBDA_SCAN.index(lam)
                pts.append((lam, rho_ss[(li, si)]))
        if len(pts) < 2:
            return np.nan, np.nan, 0
        x = np.log([p[0] - lc_final for p in pts])
        y = np.log(np.maximum([p[1] for p in pts], 1e-6))
        A = np.vstack([x, np.ones_like(x)]).T
        coef, res, rank, _ = np.linalg.lstsq(A, y, rcond=None)
        beta, logB = coef
        resid = y - A @ coef
        dof = max(1, len(pts) - 2)
        se = float(np.sqrt(np.sum(resid * resid) / dof / np.sum((x - x.mean()) ** 2)))
        return float(beta), se, len(pts)

    beta_256, se_256, n256 = beta_fit(256, BETA_FIT_LAMBDAS)
    beta_128, se_128, n128 = beta_fit(128, BETA_FIT_LAMBDAS)
    beta_256_7, se_256_7, n256_7 = beta_fit(256, [l for l in LAMBDA_SCAN if l > lc_final])
    if np.isfinite(beta_256):
        half_candidates = [se_256]
        if np.isfinite(beta_128):
            half_candidates.append(abs(beta_256 - beta_128) / 2.0)
        if np.isfinite(beta_256_7):
            half_candidates.append(abs(beta_256 - beta_256_7) / 2.0)
        half = max(half_candidates)
        beta_final, beta_lo, beta_hi = beta_256, beta_256 - half, beta_256 + half
    else:
        beta_final, beta_lo, beta_hi = np.nan, np.nan, np.nan

    # delta from the (constrained) FSS fit; diagnostic direct fit at lambda*
    delta_final = float(delta_fss)
    se_delta = se_delta_fss
    li_star = int(np.argmin([abs(lam - lc_final) for lam in LAMBDA_SCAN]))
    lam_star = LAMBDA_SCAN[li_star]
    rho_at_star = np.array([rho_ss[(li_star, si)] for si in range(n_s)])
    Ls = np.array(SYSTEM_SIZES, dtype=float)
    ok = rho_at_star > 1e-4
    cdir = np.polyfit(np.log(Ls[ok]), np.log(rho_at_star[ok]), 1) if ok.sum() >= 2 else np.array([np.nan, np.nan])

    # ------------------------------------------------------------------
    # z from critical decay slope rho(t) ~ t^{-beta/z} at lambda*
    # ------------------------------------------------------------------
    def z_from_size(L):
        si = SYSTEM_SIZES.index(L)
        rm = rho_mean[(li_star, si)]
        tg = np.arange(20, 501)
        y = rm[tg - 1]
        good = y > 1e-4
        if good.sum() < 10:
            return np.nan, np.nan, np.nan
        x = np.log(tg[good]); yy = np.log(y[good])
        coef = np.polyfit(x, yy, 1)
        slope = float(coef[0])
        pred = np.polyval(coef, x)
        ss_res = float(np.sum((yy - pred) ** 2))
        ss_tot = float(np.sum((yy - yy.mean()) ** 2))
        r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else np.nan
        n = len(x)
        se_slope = float(np.sqrt(ss_res / max(1, n - 2) / np.sum((x - x.mean()) ** 2)))
        if slope >= -0.02 or not np.isfinite(beta_final) or beta_final < 0.1 or beta_final > 1.2:
            return np.nan, r2, se_slope
        z = -beta_final / slope
        se_z = z * float(np.sqrt((se_slope / slope) ** 2
                                  + ((se_256 if np.isfinite(se_256) else 0.2) / beta_final) ** 2))
        return z, r2, se_z

    z_256, r2_256, sez_256 = z_from_size(256)
    z_128, r2_128, _ = z_from_size(128)
    if np.isfinite(z_256) and r2_256 >= 0.8:
        z_final, se_z_final, z_fit_ok = float(z_256), float(sez_256), True
    elif np.isfinite(z_128) and r2_128 >= 0.8:
        z_final, se_z_final, z_fit_ok = float(z_128), np.nan, True
    else:
        z_final, se_z_final, z_fit_ok = float("nan"), float("nan"), False
    # DP-consistent diagnostic: z implied by the measured slope assuming DP beta
    sl_star = slopes[lam_star][0]
    z_implied_dp = float(DP_BETA / abs(sl_star)) if (np.isfinite(sl_star) and sl_star < 0) else np.nan

    # ------------------------------------------------------------------
    # Dynamic collapse test: rho(t)*t^{beta/z} vs t^{1/z}/L at lambda*
    # ------------------------------------------------------------------
    z_used = z_final if (z_fit_ok and 1.5 <= z_final <= 8.0) else DP_Z
    beta_used = beta_final if (np.isfinite(beta_final) and 0.1 <= beta_final <= 1.5) else DP_BETA

    tgrid = np.arange(20, T_MAX + 1)
    xvals = tgrid ** (1.0 / z_used)
    scale_t = tgrid ** (beta_used / z_used)
    per_L_scaled = {}
    sigma_noise = 0.0
    for si, L in enumerate(SYSTEM_SIZES):
        rm = rho_mean[(li_star, si)]
        y = rm[tgrid - 1] * scale_t
        per_L_scaled[L] = (xvals / L, y)
        sig = []
        for t in tgrid[::5]:
            vals = np.array([r[t - 1] for r, _ in runs[(li_star, si)]])
            vals = vals[vals > 1e-4]
            if len(vals) >= 3:
                m = float(np.mean(vals))
                if m > 1e-4:
                    sig.append(float(np.std(np.log(vals))))
        sigma_noise = max(sigma_noise, float(np.mean(sig)) if sig else 0.0)

    X = np.concatenate([v[0] for v in per_L_scaled.values()])
    Y = np.concatenate([v[1] for v in per_L_scaled.values()])
    msk = (X > 0) & (Y > 1e-4)
    lx, ly = np.log(X[msk]), np.log(Y[msk])
    coef_c = np.polyfit(lx, ly, 3)
    pred = np.polyval(coef_c, lx)
    ss_res = float(np.sum((ly - pred) ** 2))
    ss_tot = float(np.sum((ly - ly.mean()) ** 2))
    r2_collapse = 1.0 - ss_res / ss_tot if ss_tot > 0 else np.nan
    resid_per_L = {}
    for L in per_L_scaled:
        xl = np.log(per_L_scaled[L][0])
        yl = np.log(per_L_scaled[L][1])
        resid_per_L[L] = float(np.std(yl - np.polyval(coef_c, xl)))
    max_r = max(resid_per_L.values())
    collapse_success = bool(np.isfinite(r2_collapse) and r2_collapse > 0.90
                            and max_r < sigma_noise + 0.10)
    dynamic_scale_observed = bool(collapse_success and z_fit_ok
                                  and np.isfinite(z_final) and r2_256 >= 0.8)
    tau_q_half = 0.5 * z_used * NU_PERP

    # ------------------------------------------------------------------
    # Sensitivity check: sweep convention (permutation vs i.i.d. replacement)
    # ------------------------------------------------------------------
    sens_lams = LAMBDA_SCAN[1::2]
    sens = {}
    for conv, rep in (("permutation", False), ("with_replacement", True)):
        rec = []
        for lam in sens_lams:
            s = 0
            rho_s = 0.0
            for ri in range(8):
                rng = np.random.default_rng((SEED + 7777, int(lam * 1000), 0, ri))
                rho_t, death = simulate_run(32, lam, T_MAX, rng, replace=rep)
                s += 1 if death >= T_MAX else 0
                rho_s += float(np.mean(rho_t[RHO_SS_WINDOW:]))
            rec.append((lam, s / 8.0, rho_s / 8.0))
        sens[conv] = rec

    def knee_proxy(rec):
        for lam, sv, rh in rec:
            if rh > 0.2:
                return lam
        return None

    kv_p = dict((l, s) for l, s, _ in sens["permutation"])
    kv_w = dict((l, s) for l, s, _ in sens["with_replacement"])
    sens_note = (
        f"sweep-convention sensitivity (L=32, 8 seeds, t_max={T_MAX}): "
        f"first lambda with late-time rho>0.2: permutation ~ {knee_proxy(sens['permutation'])}, "
        f"with-replacement ~ {knee_proxy(sens['with_replacement'])}; "
        f"survival@1.778: {kv_p.get(1.778, float('nan')):.2f} vs {kv_w.get(1.778, float('nan')):.2f}"
    )

    # ------------------------------------------------------------------
    # Verdicts
    # ------------------------------------------------------------------
    lambda_c_interior = bool(LAMBDA_SCAN[0] < lc_final < LAMBDA_SCAN[-1])
    static_evidence_consistent = bool(
        lambda_c_interior
        and np.isfinite(beta_final) and 0.10 <= beta_final <= 0.75
        and np.isfinite(delta_final) and 0.05 <= delta_final <= 1.40
    )
    beta_half = (beta_hi - beta_lo) / 2 if np.isfinite(beta_final) else 1.0
    delta_half = abs(se_delta) if np.isfinite(se_delta) else 1.0
    universality_supported = bool(
        static_evidence_consistent
        and abs(beta_final - DP_BETA) <= max(0.20, beta_half)
        and abs(delta_final - DP_DELTA) <= max(0.30, delta_half)
    )
    conclusion = (
        "consistent_with_directed_percolation"
        if (static_evidence_consistent and universality_supported)
        else "inconclusive"
    )

    # ------------------------------------------------------------------
    # dp_summary.csv
    # ------------------------------------------------------------------
    z_str = f"{z_final:.6f}" if np.isfinite(z_final) else "nan"
    df_sum = pd.DataFrame(
        [
            {
                "task_id": TASK_ID,
                "lambda_c_estimate": f"{lc_final:.6f}",
                "lambda_c_ci_low": f"{lc_lo:.6f}",
                "lambda_c_ci_high": f"{lc_hi:.6f}",
                "beta_estimate": f"{beta_final:.6f}",
                "beta_ci_low": f"{beta_lo:.6f}",
                "beta_ci_high": f"{beta_hi:.6f}",
                "delta_estimate": f"{delta_final:.6f}",
                "z_estimate": z_str,
                "n_seeds": N_SEEDS,
