#!/usr/bin/env python3
"""
B3: 2D Nonlinear Field Prediction - complete, reproducible analysis + simulation.

Pipeline: load data -> characterize structure -> predict field at target time ->
extract scored diagnostics -> write all artifacts -> verify finiteness.

Model notes: the episode is a 2D anisotropic nonlinear field (Kuramoto-Sivashinsky
family). The observed state is a 1D-in-x wave train (kx~0.59) with a slow y-envelope
(ky~0.26); ~95% of spectral power is on the ky=0 axis; the mean is conserved to ~1e-6.
The dynamics are genuinely nonlinear (a linear dispersion does not fit the observed
modal growth rates) and the amplitude growth DECELERATES (L2^2 is concave) -> nonlinear
saturation. A canonical KS operator with the 7 supplied coefficients grows far too fast
to match the observed slow evolution, so we use a data-calibrated spectral extrapolation
for the prediction and a modal-linear surrogate for the divergence measure.
"""
import json
import os
import struct
import zlib
import numpy as np

DATA_DIR = "data"
OUT_DIR = "."
rng_seed = 1729
rng_pert = 1e-8

with open(os.path.join(DATA_DIR, "system_info.json")) as f:
    info = json.load(f)
fe = np.load(os.path.join(DATA_DIR, "field_evolution.npy"))   # (T, Nx, Ny)
ic = np.load(os.path.join(DATA_DIR, "initial_condition.npy"))  # (Nx, Ny)

T, Nx, Ny = fe.shape
dx = float(info["dx"]); dy = float(info["dy"])
Lx = float(info["domain_length_x"]); Ly = float(info["domain_length_y"])
obs_time = float(info["observation_time"]); target_time = float(info["target_time"])
dt_obs = obs_time / (T - 1)
t_obs = np.arange(T) * dt_obs
coeffs = [info[f"system_coefficient_{i}"] for i in range(1, 8)]

kx = 2 * np.pi * np.fft.fftfreq(Nx, d=dx)
ky = 2 * np.pi * np.fft.fftfreq(Ny, d=dy)
KX, KY = np.meshgrid(kx, ky, indexing="ij")
KR = np.hypot(KX, KY)
K_CORNER = float(KR.max())
N_ANN = 65
ANN_W = K_CORNER / N_ANN

def fft2(u, axes=None):
    return np.fft.fft2(u, axes=axes)

def radial_psd(u, n_ann=N_ANN):
    P = np.abs(fft2(u)) ** 2 / u.size
    b = np.clip(np.floor(KR / ANN_W).astype(int), 0, n_ann - 1)
    acc = np.zeros(n_ann); cnt = np.zeros(n_ann)
    np.add.at(acc, b.ravel(), P.ravel())
    np.add.at(cnt, b.ravel(), 1.0)
    acc = acc / np.maximum(cnt, 1.0)
    return (np.arange(n_ann) + 0.5) * ANN_W, acc

def dominant_wavenumber_1d(P2d, axis):
    prof = P2d.sum(axis=1) if axis == 0 else P2d.sum(axis=0)
    prof = prof.copy(); prof[0] = 0.0
    idx = int(np.argmax(prof))
    return abs(float(kx[idx] if axis == 0 else ky[idx])), idx

def first_zero_crossing(sig, ts):
    for i in range(1, len(sig)):
        if sig[i - 1] * sig[i] < 0:
            frac = sig[i - 1] / (sig[i - 1] - sig[i])
            return ts[i - 1] + frac * (ts[i] - ts[i - 1])
    return None

def periodic_line_autocorr_avg(u, direction):
    if direction == "x":
        lines = u; N = Nx
    else:
        lines = u.T; N = Ny
    c = lines - lines.mean(axis=0, keepdims=True)
    ac = np.real(np.fft.ifft(np.abs(np.fft.fft(c, axis=0)) ** 2, axis=0)) / N
    return ac.mean(axis=1), N

# ---- data exploration (OBSERVED) -> data_exploration.json ----
P_obs = (np.abs(fft2(fe, axes=(1, 2))) ** 2).mean(axis=0)
cs1_obs, _ = dominant_wavenumber_1d(P_obs, 0)
cs2_obs, _ = dominant_wavenumber_1d(P_obs, 1)

c_pix = fe[:, Nx // 2, Ny // 2]
cm = c_pix - c_pix.mean()
ac_t = np.correlate(cm, cm, mode="full")[len(cm) - 1:]
ac_t = ac_t / ac_t[0]
tds = first_zero_crossing(ac_t, t_obs)
if tds is None:
    tds = obs_time / 4.0

rad_stack = np.array([radial_psd(fe[t])[1] for t in range(T)])
rad_ta = rad_stack.mean(axis=0)
rad_centers = (np.arange(N_ANN) + 0.5) * ANN_W
peak_idx = int(np.argmax(rad_ta))
sel = (rad_centers > rad_centers[peak_idx]) & (rad_centers < 0.65 * K_CORNER) & (rad_ta > 0)
decay_exponent = float(np.polyfit(np.log(rad_centers[sel]), np.log(rad_ta[sel]), 1)[0])
structural_ratio_obs = float(cs1_obs / cs2_obs) if cs2_obs != 0 else float(cs1_obs)

data_exploration = {
    "characteristic_scale_1": float(cs1_obs),
    "characteristic_scale_2": float(cs2_obs),
    "temporal_decay_scale": float(tds),
    "decay_exponent": decay_exponent,
    "structural_ratio": structural_ratio_obs,
}

# ---- PREDICT field at target time from IC ----
F = np.fft.fft2(fe, axes=(1, 2))
amp = np.abs(F)
phase = np.unwrap(np.angle(F), axis=0)
r_recent = (np.log(amp[-1] + 1e-30) - np.log(amp[T // 2] + 1e-30)) / (t_obs[-1] - t_obs[T // 2])
om = (phase[-1] - phase[0]) / (t_obs[-1] - t_obs[0])

L2_obs = np.linalg.norm(fe, axis=(1, 2))
cL2sq = np.polyfit(t_obs, L2_obs ** 2, 2)
L2_target = float(np.sqrt(max(np.polyval(cL2sq, target_time), 1e-6)))

order = np.argsort((amp[-1] ** 2).ravel())[::-1]
N_EXTRAP = 12                      # extrapolate only the reliable dominant modes
sig_set = set(order[:N_EXTRAP])

DAMP = 0.5
HORIZON = target_time - obs_time
uhat = amp[-1] * np.exp(1j * phase[-1])
for idx in sig_set:
    ix, iy = divmod(idx, Ny)
    aT = amp[-1, ix, iy] * np.exp(DAMP * r_recent[ix, iy] * HORIZON)
    uhat[ix, iy] = aT * np.exp(1j * (phase[-1, ix, iy] + om[ix, iy] * HORIZON))
predicted_field = np.real(np.fft.ifft2(uhat))
predicted_field *= L2_target / np.linalg.norm(predicted_field)
predicted_field = np.ascontiguousarray(predicted_field, dtype=np.float64)

# ---- physical quantities (PREDICTED) -> physical_quantities.json ----
P_pred = np.abs(fft2(predicted_field)) ** 2
cs1_pred, _ = dominant_wavenumber_1d(P_pred, 0)
cs2_pred, _ = dominant_wavenumber_1d(P_pred, 1)

acx, Nx_ = periodic_line_autocorr_avg(predicted_field, "x")
cl1 = first_zero_crossing(acx, np.arange(Nx_) * dx)
acy, Ny_ = periodic_line_autocorr_avg(predicted_field, "y")
cl2 = first_zero_crossing(acy, np.arange(Ny_) * dy)
if cl1 is None:
    cl1 = Lx / 2.0
if cl2 is None:
    cl2 = Ly / 2.0

def modal_evolve(u, lam, dt):
    return np.real(np.fft.ifft2(fft2(u) * np.exp(np.clip(lam * dt, -50, 50))))

lam_full = (np.log(amp[-1] + 1e-30) - np.log(amp[0] + 1e-30)) / (t_obs[-1] - t_obs[0])

# Dynamical model for the divergence measure: a modal-linear surrogate consistent
# with the data-calibrated prediction, in which each reliable Fourier mode (power
# > 0.5% of the max) evolves at its observed full-window growth rate (clipped to
# [-0.5, 0.5] to bound the rate) and the remaining tiny/noise modes are held
# neutral (rate 0). The Benettin renormalization protocol is applied to this model.
_amp_thr = 0.005 * amp[-1].max()
lam_div = np.where(amp[-1] > _amp_thr, np.clip(lam_full, -0.5, 0.5), 0.0)

def benettin(u0, lam, t_end, seg, pnorm=rng_pert, seed=rng_seed):
    rng = np.random.default_rng(seed)
    p = rng.standard_normal((Nx, Ny))
    p = (p - p.mean()) / np.linalg.norm(p) * pnorm
    u = u0.copy(); log_growth = 0.0; norms = []
    for _ in range(int(round(t_end / seg))):
        u_u = modal_evolve(u, lam, seg)
        u_p = modal_evolve(u + p, lam, seg)
        d = u_p - u_u; dn = np.linalg.norm(d)
        norms.append(dn)
        if dn > 0:
            log_growth += np.log(dn / pnorm)
            p = d / dn * pnorm
        u = u_u + p
    return log_growth / t_end, norms

# divergence_measure = the Benettin renormalization-protocol result (per the
# scored convention): min(target_time, 8) s in 2 s segments, rng(1729) perturbation
# of norm 1e-8, renormalized at each segment boundary.
divergence_measure, _bnorms = benettin(ic, lam_div, min(target_time, 8.0), 2.0)
# Degeneracy check: if the perturbation collapses to (near-)zero the protocol is
# degenerate; we log it but still report the protocol's computed value.
_benettin_degenerate = bool(min(_bnorms) < 1e-12)
# (informational) largest reliable modal growth rate, the asymptotic Lyapunov value
_topN = [divmod(i, Ny) for i in order[:N_EXTRAP]]
_lyap_asymptotic = float(max(lam_full[ix, iy] for ix, iy in _topN))
structural_ratio_pred = float(cs1_pred / cs2_pred) if cs2_pred != 0 else float(cs1_pred)

physical_quantities = {
    "divergence_measure": float(divergence_measure),
    "coherence_length_1": float(cl1),
    "coherence_length_2": float(cl2),
    "characteristic_scale_1": float(cs1_pred),
    "characteristic_scale_2": float(cs2_pred),
    "structural_ratio": structural_ratio_pred,
}

# ---- spectral density (radial PSD of PREDICTED field) ----
_, spectral_density = radial_psd(predicted_field)
spectral_density = np.ascontiguousarray(spectral_density, dtype=np.float64)

# ---- rendering (matplotlib if available, else minimal PNG encoder) ----
def write_png(path, rgb):
    rgb = np.ascontiguousarray(rgb, dtype=np.uint8)
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
    def chunk(typ, data):
        c = typ + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))

def _interp_cmap(v, stops):
    pos = np.array([s[0] for s in stops]); col = np.array([s[1] for s in stops], float)
    out = np.empty(v.shape + (3,))
    for c in range(3):
        out[..., c] = np.interp(v, pos, col[:, c])
    return out.astype(np.uint8)

CMAP_DIVERGE = [(0.0, (33, 102, 214)), (0.5, (245, 245, 245)), (1.0, (178, 24, 43))]
CMAP_HOT = [(0.0, (0, 0, 0)), (0.35, (140, 0, 0)), (0.7, (230, 120, 0)), (1.0, (255, 240, 120))]

def render_array(arr, cmap_stops, vmin=None, vmax=None, size=220):
    a = np.asarray(arr, float)
    if vmin is None: vmin = a.min()
    if vmax is None: vmax = a.max()
    if vmax - vmin < 1e-12: vmax = vmin + 1e-12
    v = np.clip((a - vmin) / (vmax - vmin), 0, 1)
    H, W = a.shape
    rows = np.linspace(0, H - 1, size).astype(int)
    cols = np.linspace(0, W - 1, size).astype(int)
    return _interp_cmap(v[np.ix_(rows, cols)], cmap_stops)

def render_line(x, y, size=220, logx=False, logy=False, color=(33, 102, 214)):
    canvas = np.full((size, size, 3), 255, np.uint8)
    m = 40
    if logx: x = np.log10(np.clip(np.asarray(x, float), 1e-300, None))
    if logy: y = np.log10(np.clip(np.asarray(y, float), 1e-300, None))
    x = np.asarray(x, float); y = np.asarray(y, float)
    valid = np.isfinite(x) & np.isfinite(y)
    x = x[valid]; y = y[valid]
    if len(x) < 2: return canvas
    x0, x1 = x.min(), x.max(); y0, y1 = y.min(), y.max()
    if x1 - x0 < 1e-12: x1 = x0 + 1e-12
    if y1 - y0 < 1e-12: y1 = y0 + 1e-12
    ph = pw = size - 2 * m
    px = ((x - x0) / (x1 - x0) * (pw - 1)).astype(int) + m
    py = ((1 - (y - y0) / (y1 - y0)) * (ph - 1)).astype(int) + m
    canvas[m, m:size - m] = 0; canvas[size - m, m:size - m] = 0
    canvas[m:size - m, m] = 0; canvas[m:size - m, size - m] = 0
    for xi, yi in zip(px, py):
        canvas[yi, xi] = color
    return canvas

def grid(panels, ncols, gap=12, bg=255):
    nrows = (len(panels) + ncols - 1) // ncols
    ph = panels[0].shape[0]; pw = panels[0].shape[1]
    H = nrows * ph + (nrows + 1) * gap; W = ncols * pw + (ncols + 1) * gap
    canvas = np.full((H, W, 3), bg, np.uint8)
    for i, p in enumerate(panels):
        r, c = divmod(i, ncols)
        y0 = gap + r * (ph + gap); x0 = gap + c * (pw + gap)
        canvas[y0:y0 + ph, x0:x0 + pw] = p
    return canvas

def field_panel(u, vmin, vmax):
    return render_array(u, CMAP_DIVERGE, vmin, vmax)

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

vmm = float(max(np.abs(fe).max(), np.abs(predicted_field).max()))
snap_idx = [0, T // 4, T // 2, 3 * T // 4, T - 1]

if HAVE_MPL:
    fig, axes = plt.subplots(3, 3, figsize=(12, 12))
    panels_field = [(fe[i], f"t={t_obs[i]:.1f}s") for i in snap_idx]
    panels_field.append((predicted_field, f"t={target_time:.0f}s (pred)"))
    for ax, (u, ttl) in zip(axes.ravel()[:6], panels_field):
        ax.imshow(u, cmap="RdBu_r", vmin=-vmm, vmax=vmm, origin="upper")
        ax.set_title(ttl); ax.axis("off")
    axes.ravel()[6].plot(t_obs, L2_obs, "o-"); axes.ravel()[6].set_title("L2 norm (obs)")
    axes.ravel()[7].plot(fe[0, :, 0], label="t=0"); axes.ravel()[7].plot(fe[-1, :, 0], label="t=10")
    axes.ravel()[7].plot(predicted_field[:, 0], label="t=30"); axes.ravel()[7].set_title("x-profile @ y=0")
    axes.ravel()[8].plot(fe[0, 0, :], label="t=0"); axes.ravel()[8].plot(fe[-1, 0, :], label="t=10")
    axes.ravel()[8].plot(predicted_field[0, :], label="t=30"); axes.ravel()[8].set_title("y-profile @ x=0")
    fig.tight_layout(); fig.savefig(os.path.join(OUT_DIR, "field_visualization.png"), dpi=110); plt.close(fig)

    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    axes[0, 0].imshow(np.log10(np.abs(fft2(predicted_field)) ** 2 + 1e-30), cmap="inferno", origin="lower")
    axes[0, 0].set_title("2D PSD (predicted)")
    axes[0, 1].imshow(np.log10(np.abs(fft2(fe[-1])) ** 2 + 1e-30), cmap="inferno", origin="lower")
    axes[0, 1].set_title("2D PSD (obs t=10)")
    rc, rp = radial_psd(predicted_field)
    axes[1, 0].loglog(rc, rp, "o-"); axes[1, 0].set_title("radial PSD (predicted)")
    axes[1, 1].loglog(rad_centers, rad_ta, "o-"); axes[1, 1].set_title("radial PSD (time-avg obs)")
    fig.tight_layout(); fig.savefig(os.path.join(OUT_DIR, "spectral_visualization.png"), dpi=110); plt.close(fig)
else:
    fp = [field_panel(fe[i], -vmm, vmm) for i in snap_idx]
    fp.append(field_panel(predicted_field, -vmm, vmm))
    fp.append(render_line(t_obs, L2_obs))
    fp.append(render_line(np.tile(np.arange(Nx) * dx, 3), np.concatenate([fe[0, :, 0], fe[-1, :, 0], predicted_field[:, 0]]), color=(178, 24, 43)))
    fp.append(render_line(np.tile(np.arange(Ny) * dy, 3), np.concatenate([fe[0, 0, :], fe[-1, 0, :], predicted_field[0, :]]), color=(178, 24, 43)))
    write_png(os.path.join(OUT_DIR, "field_visualization.png"), grid(fp, 3))

    Pp = np.log10(np.abs(fft2(predicted_field)) ** 2 + 1e-30)
    Po = np.log10(np.abs(fft2(fe[-1])) ** 2 + 1e-30)
    rc, rp = radial_psd(predicted_field)
    sp = [render_array(Pp, CMAP_HOT), render_array(Po, CMAP_HOT),
          render_line(rc, rp, logx=True, logy=True), render_line(rad_centers, rad_ta, logx=True, logy=True)]
    write_png(os.path.join(OUT_DIR, "spectral_visualization.png"), grid(sp, 2))

# ---- save all artifacts + finiteness check ----
def save(name, arr):
    arr = arr.astype(np.float64)
    assert np.all(np.isfinite(arr)), f"{name} has non-finite values"
    np.save(os.path.join(OUT_DIR, name), arr)

def save_json(name, d):
    for k, v in d.items():
        assert np.isfinite(v), f"{name}.{k} non-finite"
    with open(os.path.join(OUT_DIR, name), "w") as f:
        json.dump(d, f, indent=2)

save("predicted_field.npy", predicted_field)
save("spectral_density.npy", spectral_density)
save_json("data_exploration.json", data_exploration)
save_json("physical_quantities.json", physical_quantities)

print("=== B3 2D Nonlinear Field Prediction - summary ===")
print(f"grid {Nx}x{Ny}  dx={dx} dy={dy}  k_corner={K_CORNER:.4f}  annulus_width={ANN_W:.4f}  HAVE_MPL={HAVE_MPL}")
print(f"IC == fe[0]: maxdiff={np.abs(ic - fe[0]).max():.2e}")
print(f"L2: {L2_obs[0]:.1f} -> {L2_obs[-1]:.1f} (obs); target L2(t={target_time})={L2_target:.1f}")
print(f"extrapolated dominant modes: {N_EXTRAP}  divergence_measure(Benettin)={divergence_measure:.4f}  [asymptotic Lyapunov={_lyap_asymptotic:.4f}, degenerate={_benettin_degenerate}, seg_norms={[float(f"{x:.3e}") for x in _bnorms]}]")
print(f"predicted: L2={np.linalg.norm(predicted_field):.1f} min={predicted_field.min():.3f} max={predicted_field.max():.3f} finite={np.all(np.isfinite(predicted_field))}")
print("\ndata_exploration.json:\n" + json.dumps(data_exploration, indent=2))
print("\nphysical_quantities.json:\n" + json.dumps(physical_quantities, indent=2))
print(f"\nspectral_density: shape={spectral_density.shape} peak_bin={int(np.argmax(spectral_density))} finite={np.all(np.isfinite(spectral_density))}")
print("\nArtifacts:")
for n in ["predicted_field.npy", "spectral_density.npy", "data_exploration.json",
          "physical_quantities.json", "field_visualization.png", "spectral_visualization.png", "simulation.py"]:
    p = os.path.join(OUT_DIR, n)
    print(f"  {n}: {os.path.getsize(p)} bytes")
