def _fb_draw_text(img, x, y, s, scale, color):
    cx = x
    for ch in s:
        g = _FONT5X7.get(ch) or _FONT5X7.get(ch.upper()) or _FONT5X7[' ']
        for ry in range(7):
            row = g[ry]
            for rx in range(5):
                if row & (16 >> rx):
                    img[y + ry*scale:y + (ry+1)*scale, cx + rx*scale:cx + (rx+1)*scale] = color
        cx += 6*scale
def _fb_text_w(s, scale):
    return len(s) * 6 * scale - scale
def _fb_line(img, x0, y0, x1, y1, color, dash=None):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    n = max(abs(x1-x0), abs(y1-y0), 1)
    xs = np.linspace(x0, x1, n).round().astype(int)
    ys = np.linspace(y0, y1, n).round().astype(int)
    if dash is None:
        img[ys, xs] = color
    else:
        on, off = dash
        for i in range(0, n, on+off):
            j = min(i+on, n)
            img[ys[i:j], xs[i:j]] = color
def _fb_lerp_uniform(x, y, xi):
    pos = (xi - x[0]) / (x[-1] - x[0]) * (len(x) - 1)
    i0 = np.clip(np.floor(pos).astype(int), 0, len(x) - 2)
    frac = np.clip(pos - i0, 0.0, 1.0)
    return y[i0] * (1.0 - frac) + y[i0 + 1] * frac
def _fb_panel(img, x0, y0, x1, y1, title, xlabel, yticks, xticks):
    _fb_line(img, x0, y0, x1, y0, (0,0,0)); _fb_line(img, x1, y0, x1, y1, (0,0,0))
    _fb_line(img, x1, y1, x0, y1, (0,0,0)); _fb_line(img, x0, y1, x0, y0, (0,0,0))
    if len(xticks) >= 2 and xticks[-1] != xticks[0]:
        for xt in xticks:
            px = int(x0 + (xt - xticks[0]) / (xticks[-1] - xticks[0]) * (x1 - x0))
            _fb_line(img, px, y1, px, y1+4, (0,0,0))
            _fb_draw_text(img, px - _fb_text_w(str(int(xt)),1)//2, y1+6, str(int(xt)), 1, (0,0,0))
    if len(yticks) >= 2 and yticks[-1] != yticks[0]:
        for yt in yticks:
            py = int(y1 - (yt - yticks[0]) / (yticks[-1] - yticks[0]) * (y1 - y0))
            _fb_line(img, x0, py, x0-4, py, (0,0,0))
            _fb_draw_text(img, x0-4-_fb_text_w(str(int(yt)),1), py-3, str(int(yt)), 1, (0,0,0))
    _fb_draw_text(img, x0 + (x1-x0)//2 - _fb_text_w(title,2)//2, y0-24, title, 2, (0,0,0))
    _fb_draw_text(img, x0 + (x1-x0)//2 - _fb_text_w(xlabel,1)//2, y1+22, xlabel, 1, (0,0,0))
def _fb_curve(img, xd, yd, x0, y0, x1, y1, y_lo, y_hi, color, dash=None):
    px = (x0 + (xd - xd[0]) / (xd[-1] - xd[0]) * (x1 - x0)).round().astype(int)
    py = (y1 - (yd - y_lo) / (y_hi - y_lo) * (y1 - y0)).round().astype(int)
    for i in range(len(px)-1):
        _fb_line(img, px[i], py[i], px[i+1], py[i+1], color, dash=dash)
def _fb_fill_neg(img, xd, yd, x0, y0, x1, y1, y_lo, y_hi):
    pxc = np.arange(x0+1, x1)
    xdat = xd[0] + (pxc - x0) / (x1 - x0) * (xd[-1] - xd[0])
    vals = _fb_lerp_uniform(xd, yd, xdat)
    y0px = y1 - (0.0 - y_lo) / (y_hi - y_lo) * (y1 - y0)
    for k, v in enumerate(vals):
        if v < 0:
            ya = y1 - (v - y_lo) / (y_hi - y_lo) * (y1 - y0)
            hi, lo = int(max(y0px, ya)), int(min(y0px, ya))
            img[lo:hi, pxc[k]] = (255, 190, 190)
def _fb_write_png(path, arr):
    import struct, zlib
    h, w = arr.shape[:2]
    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(h))
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag+data) & 0xffffffff)
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)))
        fh.write(chunk(b"IDAT", zlib.compress(raw, 9)))
        fh.write(chunk(b"IEND", b""))
