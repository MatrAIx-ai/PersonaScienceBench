"""
Negative-Index Retrieval in Paired-Nanorod Metamaterials
=========================================================
Coherent workflow (single compact model family explains calibration retrievals,
held-out predictions, and the negative-index summary):

1. Load calibration/held-out sample tables and calibration optics
   (amplitude + principal-value phase of t and r on a 126-point wavelength grid).
2. Phase-aware retrieval of effective n and z from (t, r) using the exact
   effective-slab model (slab of thickness d in air):
       forward:  D = (1+z)^2 - (1-z)^2 e^{2i beta},  beta = 2 pi n d / lam
                 t = 4 z e^{i beta} / D,   r = (1 - z^2) (1 - e^{2i beta}) / D
       inverse:  t u^2 - (1 + t^2 - r^2) u + t = 0,  u = e^{i beta}
                 passive root |u| <= 1  (u = e^{i beta} => |u| = e^{-Im beta})
                 beta = -i log u  (Re(beta) unwrapped along the grid)
                 n = beta / (k0 d),  z = (1 - t u - r) / (1 + r - t u)
   Sign convention: e^{-i omega t}; passive medium => Im(n) > 0, Re(z) > 0.
   The calibration data reconstructs from (n, z) to machine precision,
   confirming the model manifold.
3. Compact family comparison (per-sample fits to the retrieved n, z):
       electric_only:                        n = nb + Sn/(ln - lam - i gn),  z = 1/n
       electric_magnetic_dual_resonance:     n = nb + Sn/(ln - lam - i gn)
                                             z = zb + Sz/(lz - lam - i gz)
       dual_resonance_plus_substrate_shift:  same per-sample form, plus explicit
                                             substrate-index shifts
                                             ln -> ln + a_ns*(ns-1), lz -> lz + b_ns*(ns-1)
   Transfer to unseen geometries: low-dimensional LINEAR maps (intercept + up to
   two standardized geometry features, np.linalg.lstsq) from
   (rod_length, rod_width, gap, spacer, substrate_index) to each family
   parameter, selected and validated by leave-one-sample-out cross-validation.
   No interpolation / surrogate APIs are used anywhere.
4. Held-out prediction: the SELECTED family + its transfer map (fit on all
   calibration samples) -> forward slab model over the full wavelength grid.
5. Negative-index summary (first/last grid point with n_real < 0; documented
   zero-width no-band fallback) for calibration (direct retrieval) and held-out
   (selected family) samples.

Outputs: results/calibration_retrieval.csv, results/model_comparison.csv,
results/heldout_prediction.csv, results/negative_index_summary.csv,
results/retrieval_diagnostics.png, results/conclusion.txt
"""
import time
import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except ImportError:
    HAVE_MPL = False
from scipy.optimize import least_squares

T0 = time.time()
DATA = "data"
OUT = "results"

# ----------------------------------------------------------------------------
# 0. Load
# ----------------------------------------------------------------------------
cs = pd.read_csv(f"{DATA}/calibration_samples.csv")
ho = pd.read_csv(f"{DATA}/heldout_samples.csv")
opt = pd.read_csv(f"{DATA}/calibration_optics.csv")

lam = np.sort(opt["wavelength_nm"].unique()).astype(float)
NWL = len(lam)
D = float(cs["slab_thickness_nm"].iloc[0])
assert np.allclose(cs["slab_thickness_nm"], D) and np.allclose(ho["slab_thickness_nm"], D)
K0D = 2.0 * np.pi * D / lam  # k0(lam) * d  (rad)

cal_ids = cs["sample_id"].tolist()
ho_ids = ho["sample_id"].tolist()
all_df = pd.concat([cs, ho], ignore_index=True)
ALL_IDS = all_df["sample_id"].tolist()
GEOM = all_df.set_index("sample_id")
FEATURES = ["rod_length_nm", "rod_width_nm", "gap_nm", "spacer_thickness_nm", "substrate_index"]

# ----------------------------------------------------------------------------
# 1. Complex fields (measured), phase-unwrapped per sample along the grid
# ----------------------------------------------------------------------------
opt = opt.sort_values(["sample_id", "wavelength_nm"]).reset_index(drop=True)
assert opt.groupby("sample_id")["wavelength_nm"].count().eq(NWL).all()
cal_complex = {}
for sid, g in opt.groupby("sample_id"):
    g = g.sort_values("wavelength_nm")
    assert np.allclose(g["wavelength_nm"].to_numpy(), lam)
    pt = g.t_amp.to_numpy() * np.exp(1j * np.unwrap(g.phi_t_rad.to_numpy()))
    pr = g.r_amp.to_numpy() * np.exp(1j * np.unwrap(g.phi_r_rad.to_numpy()))
    cal_complex[sid] = (pt, pr)

# ----------------------------------------------------------------------------
# 2. Slab forward / retrieval (verified: machine-precision reconstruction)
# ----------------------------------------------------------------------------
def slab_forward(n, z, lam):
    b = K0D * n
    Dm = (1.0 + z) ** 2 - (1.0 - z) ** 2 * np.exp(2j * b)
    t = 4.0 * z * np.exp(1j * b) / Dm
    r = (1.0 - z ** 2) * (1.0 - np.exp(2j * b)) / Dm
    return t, r

def retrieve(t, r, lam):
    """Inverse slab model. Returns (n, z) on the passive branch."""
    A = t
    B = -(1.0 + t * t - r * r)
    disc = B * B - 4.0 * A * A
    s1 = (-B + np.sqrt(disc)) / (2.0 * A)
    s2 = (-B - np.sqrt(disc)) / (2.0 * A)
    u = np.where(np.abs(s1) <= np.abs(s2), s1, s2)   # passive: |u| <= 1
    beta = -1j * np.log(u)
    beta = np.unwrap(beta.real) + 1j * beta.imag     # resolve 2*pi branch by continuity
    n = beta / K0D
    z = (1.0 - t * u - r) / (1.0 + r - t * u)
    return n, z

cal_nz = {}
recon_errs = []
for sid in cal_ids:
    t, r = cal_complex[sid]
    n, z = retrieve(t, r, lam)
    tf, rf = slab_forward(n, z, lam)
    recon_errs.append(np.sqrt(np.mean(np.abs(t - tf) ** 2 + np.abs(r - rf) ** 2)))
    cal_nz[sid] = (n, z)
recon_rmse = float(np.max(recon_errs))
print(f"[check] max reconstruction RMSE over calibration: {recon_rmse:.3e}")
assert recon_rmse < 1e-8, "retrieval/forward pair inconsistent with data"

# ----------------------------------------------------------------------------
# 3. Compact family definitions
# ----------------------------------------------------------------------------
PARAMS = ["nb", "Sn", "ln", "gn", "zb", "Sz", "lz", "gz"]

def lor(lam, S, l0, gam):
    return S / (l0 - lam - 1j * gam)

def n_of(p, lam):
    return p[0] + lor(lam, p[1], p[2], p[3])

def z_of(p, lam):
    return p[4] + lor(lam, p[5], p[6], p[7])

LB8 = np.array([-5.0, -9000.0, 1100.0, 5.0, -5.0, -9000.0, 1100.0, 5.0])
UB8 = np.array([10.0, 9000.0, 1900.0, 3000.0, 10.0, 9000.0, 1900.0, 3000.0])
BOUNDS8 = (LB8, UB8)
BOUNDS4 = (LB8[:4], UB8[:4])
STARTS = [(ln0, lz0) for ln0 in (1350.0, 1420.0, 1500.0) for lz0 in (1300.0, 1400.0, 1500.0)]

def resid_dual(p, n, z):
    nn = n_of(p, lam)
    zz = z_of(p, lam)
    return np.concatenate([(nn - n).real, (nn - n).imag, (zz - z).real, (zz - z).imag])

def resid_eonly(p, n, z):
    nn = n_of(p, lam)
    zz = 1.0 / nn
    return np.concatenate([(nn - n).real, (nn - n).imag, (zz - z).real, (zz - z).imag])

def fit_family(fam, n, z):
    resid = resid_eonly if fam == "electric_only" else resid_dual
    bounds = BOUNDS4 if fam == "electric_only" else BOUNDS8
    best = None
    for ln0, lz0 in STARTS:
        p0 = [1.0, 400.0, ln0, 80.0]
        if fam != "electric_only":
            p0 += [1.2, 200.0, lz0, 80.0]
        try:
            sol = least_squares(resid, p0, bounds=bounds, args=(n, z), max_nfev=20000)
            if best is None or sol.cost < best.cost:
                best = sol
        except Exception:
            pass
    return best.x

# ----------------------------------------------------------------------------
# 4. Transfer maps (linear, standardized features, LOOCV-selected)
# ----------------------------------------------------------------------------
fmean = GEOM[FEATURES].mean()
fstd = GEOM[FEATURES].std().replace(0.0, 1.0)
XALL = ((GEOM[FEATURES] - fmean) / fstd).to_numpy()
id2row = {s: i for i, s in enumerate(ALL_IDS)}
cal_idx = np.array([id2row[s] for s in cal_ids])

def map_predict(feat_idx, Xtr, ytr, Xq):
    X = np.column_stack([np.ones(len(Xtr))] + [Xtr[:, j] for j in feat_idx])
    coef, *_ = np.linalg.lstsq(X, ytr, rcond=None)
    Xq = np.column_stack([np.ones(len(Xq))] + [Xq[:, j] for j in feat_idx])
    return Xq @ coef

def choose_map(target, parr, feat_pool, cal_idx):
    """LOOCV pick of feature set (2-feature, 1-feature, or constant) for one parameter."""
    from itertools import combinations
    y = parr[cal_idx, target]
    best = (float(np.sqrt(np.mean((y - y.mean()) ** 2))), None)  # constant baseline
    for r in (2, 1):
        for fs in combinations(range(len(feat_pool)), r):
            idx = [feat_pool[j] for j in fs]
            errs = []
            for k in range(len(cal_idx)):
                tr = [j for j in range(len(cal_idx)) if j != k]
                pred = map_predict(idx, XALL[cal_idx[tr]], y[tr], XALL[cal_idx[k:k + 1]])
                errs.append(abs(pred[0] - y[k]))
            rmse = float(np.sqrt(np.mean(np.array(errs) ** 2)))
            if rmse < best[0] - 1e-9:
                best = (rmse, idx)
    return best[1]  # None => constant

def build_maps(fam, parr, cal_idx):
    """maps = {param position: feat_idx or None}; substrate feature excluded from
    ln/lz maps of the substrate-shift family (it enters via explicit shift terms)."""
    pool_all = list(range(len(FEATURES)))
    pool_nosub = [j for j in pool_all if FEATURES[j] != "substrate_index"]
    maps = {}
    for k, p in enumerate(PARAMS):
        if fam == "dual_resonance_plus_substrate_shift" and p in ("ln", "lz"):
            pool = pool_nosub
        else:
            pool = pool_all
        maps[k] = choose_map(k, parr, pool, cal_idx)
    return maps

def predict_params(fam, maps, parr, cal_idx, sid):
    parr_cal = parr[cal_idx]
    Xcal = XALL[cal_idx]
    out = np.empty(8)
    for k, p in enumerate(PARAMS):
        fs = maps[k]
        if fs is None:
            out[k] = parr_cal[:, k].mean()
        else:
            out[k] = float(map_predict(fs, Xcal, parr_cal[:, k],
                                       XALL[id2row[sid]:id2row[sid] + 1])[0])
    if fam == "dual_resonance_plus_substrate_shift":
        ns = float(GEOM.loc[sid, "substrate_index"])
        for k in (2, 6):  # ln, lz
            fs = maps[k]
            base = (parr_cal[:, k].mean() if fs is None
                    else map_predict(fs, Xcal, parr_cal[:, k],
                                     np.vstack([XALL[i] for i in cal_idx])))
            resid = parr_cal[:, k] - base
            dn = GEOM.loc[[ALL_IDS[i] for i in cal_idx], "substrate_index"].to_numpy() - 1.0
            a = float(np.dot(dn, resid) / np.dot(dn, dn)) if np.std(dn) > 1e-12 else 0.0
            out[k] += a * (ns - 1.0)
    return out

# ----------------------------------------------------------------------------
# 5. Family comparison: per-sample fits, calibration RMSE, LOOCV, phase RMSE
# ----------------------------------------------------------------------------
FAMS = ["electric_only", "electric_magnetic_dual_resonance",
        "dual_resonance_plus_substrate_shift"]
fitted = {}
for fam in FAMS:
    parr = np.zeros((len(cal_ids), 8))
    for i, sid in enumerate(cal_ids):
        n, z = cal_nz[sid]
        if fam == "electric_only":
            p = fit_family(fam, n, z)
            p = np.concatenate([p, [1.2, 200.0, 1400.0, 80.0]])  # z-block unused (z=1/n)
        else:
            p = fit_family(fam, n, z)
        parr[i, :] = p
    fitted[fam] = parr

def fam_nz(fam, p):
    n = n_of(p, lam)
    z = (1.0 / n) if fam == "electric_only" else z_of(p, lam)
    return n, z

def complex_rmse(t_pred, r_pred, t_meas, r_meas):
    return float(np.sqrt(np.mean(np.abs(t_pred - t_meas) ** 2 + np.abs(r_pred - r_meas) ** 2)))

results = {}
for fam in FAMS:
    parr = fitted[fam]
    errs = []
    for i, sid in enumerate(cal_ids):
        t_m, r_m = cal_complex[sid]
        n, z = fam_nz(fam, parr[i])
        t_p, r_p = slab_forward(n, z, lam)
        errs.append(complex_rmse(t_p, r_p, t_m, r_m))
    cal_rmse = float(np.sqrt(np.mean(np.array(errs) ** 2)))
    fold_errs = []
    for k in range(len(cal_ids)):
        tr = np.array([j for j in range(len(cal_ids)) if j != k])
        maps = build_maps(fam, parr, tr)
        pred = predict_params(fam, maps, parr, tr, cal_ids[k])
        n, z = fam_nz(fam, pred)
        t_p, r_p = slab_forward(n, z, lam)
        t_m, r_m = cal_complex[cal_ids[k]]
        fold_errs.append(complex_rmse(t_p, r_p, t_m, r_m))
    cv_rmse = float(np.sqrt(np.mean(np.array(fold_errs) ** 2)))
    ph_errs = []
    for i, sid in enumerate(cal_ids):
        n_f, _ = fam_nz(fam, parr[i])
        n_r, _ = cal_nz[sid]
        ph_errs.append(np.mean((K0D * (n_f - n_r).real) ** 2))
    ph_rmse = float(np.sqrt(np.mean(np.array(ph_errs) ** 2)))
    n_params = 4 if fam == "electric_only" else (10 if fam == "dual_resonance_plus_substrate_shift" else 8)
    results[fam] = dict(cal_rmse=cal_rmse, cv_rmse=cv_rmse, ph_rmse=ph_rmse, n_params=n_params)
    print(f"[family] {fam}: cal_rmse={cal_rmse:.4f} cv_rmse={cv_rmse:.4f} "
          f"ph_rmse={ph_rmse:.4f} n_params={n_params}")

preferred = min(FAMS, key=lambda f: (results[f]["cv_rmse"], results[f]["cal_rmse"]))
print(f"[select] preferred family: {preferred}")

MECH = {
    "electric_only": ("Electric-dipole resonance only: n = n_bg + S_n/(l_n - lam - i g_n), "
                      "mu = 1 (z = 1/n). 4 parameters/sample."),
    "electric_magnetic_dual_resonance": ("Electric (n-pole) + magnetic (z-pole) Lorentz resonances: "
                                         "n = n_bg + S_n/(l_n - lam - i g_n), z = z_bg + S_z/(l_z - lam - i g_z); "
                                         "geometry->parameter transfer via LOOCV-selected 2-feature linear maps "
                                         "(no dedicated substrate mechanism). 8 parameters/sample."),
    "dual_resonance_plus_substrate_shift": ("Dual n-pole/z-pole Lorentz resonances PLUS explicit substrate-index "
                                            "shifts: l_n -> l_n + a_ns*(n_sub - 1), l_z -> l_z + b_ns*(n_sub - 1); "
                                            "geometry maps use only L/W/gap/spacer, the substrate feature enters "
                                            "solely through the two shift coefficients a_ns, b_ns. 10 parameters/sample."),
}

mc = pd.DataFrame([
    dict(model_name=f,
         calibration_rmse=results[f]["cal_rmse"],
         crossval_rmse=results[f]["cv_rmse"],
         phase_consistency_rmse=results[f]["ph_rmse"],
         num_parameters=results[f]["n_params"],
         preferred=(f == preferred),
         mechanism_summary=MECH[f])
    for f in FAMS
])
mc.to_csv(f"{OUT}/model_comparison.csv", index=False)

# ----------------------------------------------------------------------------
# 6. calibration_retrieval.csv  (measured observables + retrieved n, z)
# ----------------------------------------------------------------------------
rows = []
for sid in cal_ids:
    n, z = cal_nz[sid]
    g = opt[opt["sample_id"] == sid].sort_values("wavelength_nm")
    rows.append(pd.DataFrame(dict(
        sample_id=sid, split="calibration", wavelength_nm=lam,
        t_amp=g.t_amp.to_numpy(), r_amp=g.r_amp.to_numpy(),
        phi_t_rad=g.phi_t_rad.to_numpy(), phi_r_rad=g.phi_r_rad.to_numpy(),
        n_real=n.real, n_imag=n.imag, z_real=z.real, z_imag=z.imag)))
cal_ret = pd.concat(rows, ignore_index=True)
cal_ret.to_csv(f"{OUT}/calibration_retrieval.csv", index=False)
print(f"[out] calibration_retrieval.csv rows={len(cal_ret)}")

# ----------------------------------------------------------------------------
# 7. Held-out prediction with the selected family
# ----------------------------------------------------------------------------
maps_full = build_maps(preferred, fitted[preferred], cal_idx)
ho_rows = []
ho_nz = {}
for sid in ho_ids:
    p = predict_params(preferred, maps_full, fitted[preferred], cal_idx, sid)
    n, z = fam_nz(preferred, p)
    t, r = slab_forward(n, z, lam)
    ho_nz[sid] = (n, z)
    ho_rows.append(pd.DataFrame(dict(
        sample_id=sid, wavelength_nm=lam,
        t_amp=np.abs(t), r_amp=np.abs(r),
        phi_t_rad=np.angle(t), phi_r_rad=np.angle(r),
        n_real=n.real, n_imag=n.imag, z_real=z.real, z_imag=z.imag)))
ho_pred = pd.concat(ho_rows, ignore_index=True)
ho_pred.to_csv(f"{OUT}/heldout_prediction.csv", index=False)
print(f"[out] heldout_prediction.csv rows={len(ho_pred)}")

# ----------------------------------------------------------------------------
# 8. Negative-index summary (documented first/last rule + no-band fallback)
# ----------------------------------------------------------------------------
def band_summary(sid, split, n_real):
    neg = n_real < 0.0
    i_min = int(np.argmin(n_real))
    min_n = float(n_real[i_min])
    lam_min = float(lam[i_min])
    if neg.any():
        idx = np.where(neg)[0]
        s, e = int(idx[0]), int(idx[-1])
        return dict(sample_id=sid, split=split,
                    negative_band_start_nm=float(lam[s]),
                    negative_band_end_nm=float(lam[e]),
                    negative_band_center_nm=0.5 * float(lam[s] + lam[e]),
                    min_n_real=min_n, min_n_real_wavelength_nm=lam_min,
                    band_width_nm=float(lam[e] - lam[s]),
                    negative_fraction_of_grid=float(neg.sum()) / NWL)
    return dict(sample_id=sid, split=split,
                negative_band_start_nm=lam_min,
                negative_band_end_nm=lam_min,
                negative_band_center_nm=lam_min,
                min_n_real=min_n, min_n_real_wavelength_nm=lam_min,
                band_width_nm=0.0, negative_fraction_of_grid=0.0)

sum_rows = [band_summary(s, "calibration", cal_nz[s][0].real) for s in cal_ids]
sum_rows += [band_summary(s, "heldout", ho_nz[s][0].real) for s in ho_ids]
ni_sum = pd.DataFrame(sum_rows)
ni_sum.to_csv(f"{OUT}/negative_index_summary.csv", index=False)
print(f"[out] negative_index_summary.csv:\n{ni_sum.to_string(index=False)}")

# ----------------------------------------------------------------------------
# 9. Diagnostics figure
# ----------------------------------------------------------------------------
def make_figure_mpl():
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    fig.suptitle("Paired-nanorod negative-index retrieval "
                 f"(selected family: {preferred})", fontsize=13)

    ax = axes[0, 0]
    for sid in cal_ids:
        n = cal_nz[sid][0]
        ax.plot(lam, n.real, label=sid, lw=1.4)
        neg = n.real < 0
        if neg.any():
            idx = np.where(neg)[0]
            ax.fill_between(lam, n.real, 0, where=neg, alpha=0.18)
    ax.axhline(0.0, color="k", lw=0.8)
    ax.set_xlabel("wavelength (nm)")
    ax.set_ylabel("retrieved n_real")
    ax.set_title("(a) Calibration: phase-aware retrieved n_real(lam); shaded = n_real < 0")
    ax.legend(fontsize=8, ncol=2)
    ax.grid(alpha=0.3)

    ax = axes[0, 1]
    rep = cal_ids[0]
    t_m, r_m = cal_complex[rep]
    n_f, z_f = fam_nz(preferred, fitted[preferred][cal_ids.index(rep)])
    t_p, r_p = slab_forward(n_f, z_f, lam)
    ax.plot(lam, np.abs(t_m), "o-", ms=2.5, label="measured |t|")
    ax.plot(lam, np.abs(t_p), "--", label=f"{preferred} |t|")
    ax.plot(lam, np.abs(r_m), "s-", ms=2.5, label="measured |r|")
    ax.plot(lam, np.abs(r_p), ":", label=f"{preferred} |r|")
    ax.set_xlabel("wavelength (nm)")
    ax.set_ylabel("amplitude")
    ax.set_title(f"(b) {rep}: family vs measured t and r (per-sample fit)")
    ax.legend(fontsize=8)
    ax.grid(alpha=0.3)

    ax = axes[1, 0]
    for sid in ho_ids:
        n = ho_nz[sid][0]
        ax.plot(lam, n.real, label=sid, lw=1.4)
        neg = n.real < 0
        if neg.any():
            ax.fill_between(lam, n.real, 0, where=neg, alpha=0.15)
    ax.axhline(0.0, color="k", lw=0.8)
    ax.set_xlabel("wavelength (nm)")
    ax.set_ylabel("predicted n_real")
    ax.set_title("(c) Held-out: predicted n_real(lam) from selected family")
    ax.legend(fontsize=8)
    ax.grid(alpha=0.3)

    ax = axes[1, 1]
    ax.axis("off")
    tbl = mc.copy()
    tbl["preferred"] = tbl["preferred"].map({True: "YES", False: ""})
    disp = tbl.copy()
    for c in ["calibration_rmse", "crossval_rmse", "phase_consistency_rmse"]:
        disp[c] = tbl[c].map(lambda v: f"{v:.4f}")
    disp = disp.rename(columns={"calibration_rmse": "cal RMSE", "crossval_rmse": "CV RMSE",
                                "phase_consistency_rmse": "phase RMSE (rad)",
                                "num_parameters": "#params", "model_name": "model"})
    ax.set_title("(d) Model comparison", pad=12)
    tab = ax.table(cellText=disp.values, colLabels=disp.columns, loc="center", cellLoc="left")
    tab.auto_set_font_size(False)
    tab.set_fontsize(8.5)
    tab.scale(1.0, 1.6)
    for (r, c), cell in tab.get_celld().items():
        if r == 0:
            cell.set_facecolor("#d0d0d0")
        elif disp.iloc[r - 1, 0] == preferred:
            cell.set_facecolor("#cdeccd")
    fig.tight_layout(rect=[0, 0, 1, 0.97])
    fig.savefig(f"{OUT}/retrieval_diagnostics.png", dpi=150)

