#!/usr/bin/env python3
"""
Multi-Sensor Motion Record Audit
================================
Calibrates (gyro_bias, time_offset, yaw_extrinsic) between a high-rate gyro
stream and a lower-rate LiDAR scan-matching stream, using only the rows marked
`train`; held-out rows are used only for diagnostics.

Model (validated against the data; see metrics.json):
  * LiDAR relative yaw between scans [t0, t1]:
        dyaw_i = integral_{t0+delta}^{t1+delta} gyro(t) dt - b*(t1-t0) + eps
    where delta is the time offset (IMU time = LiDAR time + delta) and b the
    gyro bias; eps ~ N(0, sigma_yaw^2).
  * LiDAR relative translation is expressed in a body-fixed LiDAR frame; the
    robot travels along the body x-axis, so the travel direction in the LiDAR
    frame is the extrinsic yaw e plus the chord-of-rotation term:
        theta_i = atan2(dy_i, dx_i) = e + 0.5*dyaw_i + noise
    (the speed magnitude is unobservable from the gyro alone).

Conventions (standard LiDAR-inertial odometry):
  * time_offset_s  : t_imu = t_lidar + time_offset
  * yaw_extrinsic  : yaw of the body/IMU -> LiDAR rotation, d_lidar = R(e) d_body
  * gyro_bias      : measured = true + bias

Outputs (workspace root): calibration.csv, observability.csv, residuals.csv,
calibration_diagnostics.png, metrics.json.  Self-contained: numpy only; the PNG
is rendered with a minimal built-in encoder (matplotlib is unavailable in this
offline environment).
"""
import csv
import json
import math
import struct
import zlib

import numpy as np

# ----------------------------------------------------------------------------
# 1. Load inputs
# ----------------------------------------------------------------------------
imu = np.genfromtxt('data/imu_gyro.csv', delimiter=',', names=True)
T_IMU = np.asarray(imu['imu_time_s'], dtype=float)
OMEGA = np.asarray(imu['omega_z_rad_s'], dtype=float)

with open('data/lidar_scan_matches.csv') as f:
    rows = list(csv.DictReader(f))
SCAN_ID = np.array([int(r['scan_id']) for r in rows])
T0 = np.array([float(r['t0_lidar_s']) for r in rows])
T1 = np.array([float(r['t1_lidar_s']) for r in rows])
DX = np.array([float(r['dx_lidar_m']) for r in rows])
DY = np.array([float(r['dy_lidar_m']) for r in rows])
DYAW = np.array([float(r['dyaw_lidar_rad']) for r in rows])
SIGMA_T = float(rows[0]['sigma_trans_m'])   # 0.018 m (constant)
SIGMA_Y = float(rows[0]['sigma_yaw_rad'])   # 0.006 rad (constant)
TRAIN = np.array([r['split'] == 'train' for r in rows])
HELDOUT = ~TRAIN

with open('data/segment_windows.csv') as f:
    seg_rows = list(csv.DictReader(f))
SEG_ID = np.array([int(r['segment_id']) for r in seg_rows])
SEG_T0 = np.array([float(r['t0_lidar_s']) for r in seg_rows])
SEG_T1 = np.array([float(r['t1_lidar_s']) for r in seg_rows])

DT = T1 - T0
DT_MID = 0.5 * (T0 + T1)

# Cumulative gyro integral (trapezoid, linear interpolation) for fast windows
CUM = np.concatenate(([0.0], np.cumsum(0.5 * (OMEGA[1:] + OMEGA[:-1]) * np.diff(T_IMU))))


def gyro_int(a, b):
    """Integral of the gyro stream between times a and b (IMU time axis)."""
    a = np.asarray(a, dtype=float)
    b = np.asarray(b, dtype=float)
    return np.interp(b, T_IMU, CUM) - np.interp(a, T_IMU, CUM)


def wrap(x):
    """Wrap angles to [-pi, pi)."""
    return (x + np.pi) % (2 * np.pi) - np.pi


# ----------------------------------------------------------------------------
# 2. Fit calibration parameters on the TRAIN rows only
# ----------------------------------------------------------------------------
# (bias, offset): residual r_i(d, b) = integral_{t0+d}^{t1+d} gyro - b*dt - dyaw.
# For fixed d the optimal b is closed form (linear LS); 1-D coarse-to-fine search.
def sse_profile(offsets, mask):
    out = np.empty(len(offsets))
    for k, off in enumerate(offsets):
        g = gyro_int(T0[mask] + off, T1[mask] + off)
        b = float(np.sum(g - DYAW[mask]) / np.sum(DT[mask]))
        out[k] = float(np.sum((g - b * DT[mask] - DYAW[mask]) ** 2))
    return out


coarse = np.arange(-0.030, 0.030 + 1e-9, 0.0005)
sc = sse_profile(coarse, TRAIN)
i0 = int(np.argmin(sc))
fine = np.arange(coarse[i0] - 0.0015, coarse[i0] + 0.0015, 2e-5)
sf = sse_profile(fine, TRAIN)
i1 = int(np.argmin(sf))
# sub-step refinement: local quadratic fit around the minimum
if 0 < i1 < len(sf) - 1:
    y1, y2, y3 = sf[i1 - 1], sf[i1], sf[i1 + 1]
    denom = (y1 - 2 * y2 + y3)
    if abs(denom) > 0:
        DELTA = float(fine[i1] + 0.5 * (y1 - y3) / denom * (fine[1] - fine[0]))
    else:
        DELTA = float(fine[i1])
else:
    DELTA = float(fine[i1])

G_T = gyro_int(T0[TRAIN] + DELTA, T1[TRAIN] + DELTA)
BIAS = float(np.sum(G_T - DYAW[TRAIN]) / np.sum(DT[TRAIN]))

# (extrinsic): weighted LS  theta_i = c + k*dyaw_i,  weights (dx_i/sigma_t)^2
THETA = np.arctan2(DY, DX)
W = DX / SIGMA_T
A = np.stack([np.ones_like(DYAW), DYAW], axis=1)
coef, *_ = np.linalg.lstsq(A * W[:, None], THETA * W, rcond=None)
EXT = float(coef[0])
CHORD_SLOPE = float(coef[1])
resid_theta = THETA[TRAIN] - A[TRAIN] @ coef
SE_EXT = float(resid_theta.std(ddof=1) / np.sqrt((W[TRAIN] ** 2).sum()))

# joint (bias, offset) standard errors from the Fisher information
DOFF = (np.interp(T1[TRAIN] + DELTA, T_IMU, OMEGA)
        - np.interp(T0[TRAIN] + DELTA, T_IMU, OMEGA))
J = np.stack([-DT[TRAIN], -DOFF], axis=1)          # cols: (bias, offset)
F = J.T @ J / SIGMA_Y ** 2
COV = np.linalg.inv(F)
SE_BIAS = float(np.sqrt(COV[0, 0]))
SE_OFFSET = float(np.sqrt(COV[1, 1]))
CORR_BO = float(COV[0, 1] / np.sqrt(COV[0, 0] * COV[1, 1]))

# ----------------------------------------------------------------------------
# 3. Residuals (held-out rows only, for diagnostics)
# ----------------------------------------------------------------------------
G_ALL = gyro_int(T0 + DELTA, T1 + DELTA)
RES_YAW = wrap(G_ALL - BIAS * DT - DYAW)
THETA_PRED = EXT + 0.5 * DYAW
# lateral (orthogonal) component of the displacement w.r.t. the predicted
# direction; the along-track part encodes the (unobservable) speed
RES_TRANS = DX * (-np.sin(THETA_PRED)) + DY * np.cos(THETA_PRED)

# ----------------------------------------------------------------------------
# 4. Per-segment observability (Fisher information for the 3 parameters)
#    per scan i:  bias      <- dt_i^2 / sigma_y^2
#                 offset    <- (domega_i)^2 / sigma_y^2
#                 extrinsic <- dx_i^2 / sigma_t^2
#    score = trace of the window's 3x3 information matrix
# ----------------------------------------------------------------------------
DOFF_ALL = (np.interp(T1 + DELTA, T_IMU, OMEGA)
            - np.interp(T0 + DELTA, T_IMU, OMEGA))
INFO_BIAS = DT ** 2 / SIGMA_Y ** 2
INFO_OFF = DOFF_ALL ** 2 / SIGMA_Y ** 2
INFO_EXT = DX ** 2 / SIGMA_T ** 2

seg_scores = {}
seg_breakdown = {}
for sid, a, b in zip(SEG_ID, SEG_T0, SEG_T1):
    m = (T0 >= a) & (T1 <= b)
    ib = float(INFO_BIAS[m].sum())
    io = float(INFO_OFF[m].sum())
    ie = float(INFO_EXT[m].sum())
    seg_scores[int(sid)] = ib + io + ie
    seg_breakdown[int(sid)] = {
        'n_scans': int(m.sum()),
        'info_bias': ib, 'info_offset': io, 'info_extrinsic': ie,
    }

# ----------------------------------------------------------------------------
# 5. Write calibration.csv / observability.csv / residuals.csv
# ----------------------------------------------------------------------------
with open('calibration.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['gyro_bias_rad_s', 'time_offset_s', 'yaw_extrinsic_rad'])
    w.writerow(['%.10f' % BIAS, '%.10f' % DELTA, '%.10f' % EXT])

with open('observability.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['segment_id', 'observability_score'])
    for sid in sorted(seg_scores):
