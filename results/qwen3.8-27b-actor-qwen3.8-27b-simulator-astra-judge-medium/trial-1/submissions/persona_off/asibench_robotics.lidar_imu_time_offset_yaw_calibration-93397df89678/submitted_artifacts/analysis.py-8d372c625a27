with open('residuals.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['scan_id', 'residual_yaw_rad', 'residual_trans_m'])
    for i in np.where(HELDOUT)[0]:
        w.writerow([int(SCAN_ID[i]), '%.8f' % RES_YAW[i], '%.8f' % RES_TRANS[i]])

