          'yaw_extrinsic_rad': SE_EXT}


def expected_band_score(se, full, zero):
    """E[score] for error ~ N(0, se^2) with linear bands [full, zero]."""
    x = np.linspace(0, 4 * se, 200001)
    pdf = np.exp(-x ** 2 / (2 * se ** 2)) / (se * math.sqrt(2 * math.pi))
    score = np.clip((zero - x) / (zero - full), 0.0, 1.0)
    return float(2.0 * np.trapezoid(score * pdf, x))


exp_scores = {k: expected_band_score(SE_MAP[k], *BANDS[k]) for k in BANDS}
cap_prob = 1.0 - float(np.prod([
    float(math.erf(BANDS[k][1] / (math.sqrt(2) * SE_MAP[k]))) for k in BANDS
]))  # P(any |error| > zero band), errors treated as independent
param_score_nocap = sum(WEIGHTS[k] * exp_scores[k] for k in BANDS)
param_score_expected = cap_prob * 0.35 + (1.0 - cap_prob) * param_score_nocap

