        IMG[y, x] = color


def draw_text(x, y, s, color, scale=2):
    cx = x
    for ch in s:
        g = FONT.get(ch, FONT['?'])
        for r in range(5):
            row = g[r]
            for cb in range(3):
                if row[cb] == '1':
                    for dy in range(scale):
                        for dx in range(scale):
                            put_px(cx + cb * scale + dx, y + r * scale + dy, color)
        cx += 4 * scale


def line_p(x1, y1, x2, y2, color, dash=0):
    """Pixel-space line; dash>0 gives an on/off pixel pattern."""
    n = int(max(abs(x2 - x1), abs(y2 - y1))) + 1
    for i in range(n):
        t = i / (n - 1) if n > 1 else 0
        x = int(round(x1 + (x2 - x1) * t))
        y = int(round(y1 + (y2 - y1) * t))
        if dash == 0 or (i % (2 * dash)) < dash:
            put_px(x, y, color)


class Panel:
    def __init__(self, x0, y0, x1, y1, title):
        self.px0, self.px1 = x0 + 46, x1 - 12
        self.py0, self.py1 = y0 + 30, y1 - 24
        for (a, b_, c, d) in [(x0, y0, x1, y0), (x0, y1, x1, y1),
                              (x0, y0, x0, y1), (x1, y0, x1, y1)]:
            line_p(a, b_, c, d, BLACK)
        draw_text(x0 + 8, y0 + 6, title, BLACK)

    def X(self, x, xmin, xmax):
        return self.px0 + (x - xmin) / (xmax - xmin) * (self.px1 - self.px0)

    def Y(self, y, ymin, ymax):
        return self.py1 - (y - ymin) / (ymax - ymin) * (self.py1 - self.py0)

    def data_line(self, x1, y1, x2, y2, color, xmin, xmax, ymin, ymax, dash=0):
        line_p(int(self.X(x1, xmin, xmax)), int(self.Y(y1, ymin, ymax)),
               int(self.X(x2, xmin, xmax)), int(self.Y(y2, ymin, ymax)), color, dash)

    def polyline(self, xs, ys, color, xmin, xmax, ymin, ymax):
        for i in range(len(xs) - 1):
            self.data_line(xs[i], ys[i], xs[i + 1], ys[i + 1],
                           color, xmin, xmax, ymin, ymax)

    def tick_x(self, v, lab, xmin, xmax):
        x = int(self.X(v, xmin, xmax))
        line_p(x, self.py1, x, self.py1 + 4, BLACK)
        draw_text(x - 4 * 2 * len(lab) // 2, self.py1 + 6, lab, BLACK)

    def tick_y(self, v, lab, ymin, ymax):
        y = int(self.Y(v, ymin, ymax))
        line_p(self.px0 - 4, y, self.px0, y, BLACK)
        draw_text(self.px0 - 4 - 4 * 2 * len(lab), y - 5, lab, BLACK)


