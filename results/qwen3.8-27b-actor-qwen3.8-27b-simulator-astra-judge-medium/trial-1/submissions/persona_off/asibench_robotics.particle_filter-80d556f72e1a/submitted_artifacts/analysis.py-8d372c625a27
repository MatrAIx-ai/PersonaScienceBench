def _put(img, x, y, rgb):
    x=int(x); y=int(y)
    if 0<=x<img.shape[1] and 0<=y<img.shape[0]:
        img[y,x]=rgb
def draw_px(img, x, y, r, g, b, rad=1):
    for dy in range(-rad, rad+1):
        for dx in range(-rad, rad+1):
            if dx*dx+dy*dy<=rad*rad:
                _put(img, x+dx, y+dy, (r,g,b))
def draw_line(img, x0,y0,x1,y1, rgb, rad=1):
    x0,y0,x1,y1=int(x0),int(y0),int(x1),int(y1)
    n=max(abs(x1-x0),abs(y1-y0),1)
    for k in range(n+1):
        tt=k/n; draw_px(img, x0+(x1-x0)*tt, y0+(y1-y0)*tt, *rgb, rad)
def draw_rect(img, x0,y0,x1,y1, rgb):
    draw_line(img,x0,y0,x1,y0,rgb); draw_line(img,x1,y0,x1,y1,rgb)
    draw_line(img,x1,y1,x0,y1,rgb); draw_line(img,x0,y1,x0,y0,rgb)
def draw_text(img, x, y, s, rgb, sc=2):
    cx=x
    for ch in s.upper():
        g=FONT.get(ch, FONT[' '])
        for ry,row in enumerate(g):
            for rx,bit in enumerate(row):
                if bit=='1':
                    for a in range(sc):
                        for b in range(sc):
                            _put(img, cx+rx*sc+a, y+ry*sc+b, rgb)
        cx += 6*sc
def write_png(path, img):
    h,w,_=img.shape; raw=b''
    for y in range(h):
        raw += b'\x00'+img[y].tobytes()
    def chunk(typ,data):
        c=typ+data; return struct.pack('>I',len(data))+c+struct.pack('>I',zlib.crc32(c)&0xffffffff)
    ihdr=struct.pack('>IIBBBBB',w,h,8,2,0,0,0)
    png=b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',ihdr)+chunk(b'IDAT',zlib.compress(raw,9))+chunk(b'IEND',b'')
    open(path,'wb').write(png)

def render_fallback(path, t, ref_px, ref_py, pf_px, pf_py, meas_px, meas_py,
                    out_idx, cr_idx, diag):
    W,H=1000,700; img=np.full((H,W,3),255,np.uint8)
    ax0,ay0,ax1,ay1=40,40,690,430
    draw_rect(img,ax0,ay0,ax1,ay1,(60,60,60))
    allx=np.concatenate([ref_px,pf_px,meas_px]); ally=np.concatenate([ref_py,pf_py,meas_py])
    xmin,xmax=np.min(allx)-0.3,np.max(allx)+0.3
    ymin,ymax=np.min(ally)-0.3,np.max(ally)+0.3
    def mx(x): return ax0+(x-xmin)/(xmax-xmin)*(ax1-ax0)
    def my(y): return ay1-(y-ymin)/(ymax-ymin)*(ay1-ay0)
    for gx in np.linspace(xmin,xmax,8):
        draw_line(img,mx(gx),ay0,mx(gx),ay1,(235,235,235))
    for gy in np.linspace(ymin,ymax,8):
        draw_line(img,ax0,my(gy),ax1,my(gy),(235,235,235))
    for i in range(len(t)-1):
        draw_line(img,mx(ref_px[i]),my(ref_py[i]),mx(ref_px[i+1]),my(ref_py[i+1]),(30,90,220),2)
    for i in range(len(t)-1):
        draw_line(img,mx(pf_px[i]),my(pf_py[i]),mx(pf_px[i+1]),my(pf_py[i+1]),(220,30,30),1)
    for i in range(len(t)):
        draw_px(img,mx(meas_px[i]),my(meas_py[i]),30,170,60,2)
    for i in out_idx:
        draw_px(img,mx(meas_px[i]),my(meas_py[i]),240,150,0,3)
    for i in cr_idx:
        draw_px(img,mx(meas_px[i]),my(meas_py[i]),200,0,200,3)
    draw_text(img,ax0+8,ay0+6,"TRAJECTORY (PX,PY)",(0,0,0),2)
    ly=ay1-78
    for txt,rgb in [("PF",(220,30,30)),("REF",(30,90,220)),("MEAS",(30,170,60)),
                    ("OUT",(240,150,0)),("CRSS",(200,0,200))]:
        draw_line(img,ax1-150,ly+4,ax1-124,ly+4,rgb,2)
        draw_text(img,ax1-118,ly,txt,(0,0,0),1)
        ly+=15
    bx0,by0,bx1,by1=40,470,960,660
    draw_rect(img,bx0,by0,bx1,by1,(60,60,60))
    ess=diag[:,4]; bres=diag[:,9]
    def dx(i): return bx0+i/(len(t)-1)*(bx1-bx0)
    def dyes(e): return by1-(e/N_PART)*(by1-by0-20)-10
    bmax=max(float(np.max(np.abs(bres))),1e-6)
    def dyb(b): return by1-10-abs(b)/bmax*(by1-by0-30)
    for i in range(len(t)-1):
        draw_line(img,dx(i),dyes(ess[i]),dx(i+1),dyes(ess[i+1]),(30,90,220),1)
        draw_line(img,dx(i),dyb(bres[i]),dx(i+1),dyb(bres[i+1]),(220,30,30),1)
    for i in range(len(t)):
        if diag[i,5]>0.5:
            draw_line(img,dx(i),by1-2,dx(i),by1-12,(0,170,0),1)
    draw_text(img,bx0+8,by0+6,"DIAG: ESS(BLUE) BRESID(RED) RESAMPLE(GRN)",(0,0,0),2)
    draw_text(img,20,14,"TARGET TRACKING OVERVIEW",(0,0,0),3)
    write_png(path, img)

def render_overview(path, t, ref_px, ref_py, pf_px, pf_py, meas_px, meas_py,
                    out_idx, cr_idx, diag):
    try:
        import matplotlib
        matplotlib.use('Agg')
        import matplotlib.pyplot as plt
        fig,axes=plt.subplots(2,1,figsize=(10,8))
        ax=axes[0]
        ax.plot(ref_px,ref_py,'b-',lw=2,label='reference')
        ax.plot(pf_px,pf_py,'r-',lw=1,label='PF estimate')
        ax.scatter(meas_px,meas_py,c='g',s=18,zorder=3,label='measurement')
        ax.scatter(meas_px[out_idx],meas_py[out_idx],c='orange',s=45,zorder=4,label='outlier')
        ax.scatter(meas_px[cr_idx],meas_py[cr_idx],c='m',s=45,zorder=4,label='crossing')
        ax.set_xlabel('px'); ax.set_ylabel('py'); ax.set_title('Trajectory'); ax.legend(); ax.grid(True)
        ax=axes[1]
        ax.plot(t,diag[:,4],'b-',lw=1,label='ESS')
        ax.plot(t,diag[:,9],'r-',lw=1,label='bearing residual')
        ax.scatter(t[diag[:,5]>0.5],diag[diag[:,5]>0.5,4],c='g',s=20,label='resample')
        ax.set_xlabel('t'); ax.set_title('Diagnostics'); ax.legend(); ax.grid(True)
        fig.tight_layout(); fig.savefig(path,dpi=110); plt.close(fig)
        return
    except Exception:
        render_fallback(path, t, ref_px, ref_py, pf_px, pf_py, meas_px, meas_py,
                        out_idx, cr_idx, diag)

def main():
    os.makedirs('results', exist_ok=True)
    Y, t, mask = load()
    n = len(t)
    range_c, bearing_c = infer_channels(Y, mask)
    r  = Y[:, range_c];  th = Y[:, bearing_c]
    mr = mask[:, range_c]; mb = mask[:, bearing_c]
    n_wraps = count_wraps(th, mb)

    ref_px, ref_py, ref_vpx, ref_vpy = build_reference(t, r, th, mr, mb)
    outlier, maneuver = classify_events(t, r, th, mr, mb)
    est, cov4, diag, resample_count, weight_degen = particle_filter(t, r, th, mr, mb, outlier, maneuver)
    cov = np.einsum('nii->ni', cov4)   # diagonal for the CSV output

    pf_px, pf_py = est[:,0], est[:,1]
    pf_vx, pf_vy = est[:,2], est[:,3]
    pos_err = np.hypot(pf_px-ref_px, pf_py-ref_py)
    vel_err = np.hypot(pf_vx-ref_vpx, pf_vy-ref_vpy)
    r_typ = float(np.median(r[mr])) if mr.any() else 2.0
    ref_unc_pos = (2.0*SIG_R)**2 + (2.0*r_typ*SIG_TH)**2
    ref_unc_vel = (SIG_R)**2 + (r_typ*SIG_TH)**2
    nees = np.zeros(n)
    for i in range(n):
        d = np.array([pf_px[i]-ref_px[i], pf_py[i]-ref_py[i],
                      pf_vx[i]-ref_vpx[i], pf_vy[i]-ref_vpy[i]])
        Pis = 0.5*(cov4[i]+cov4[i].T)
        Pis[np.diag_indices(4)] += np.array([ref_unc_pos, ref_unc_pos, ref_unc_vel, ref_unc_vel])
        Pis = Pis + 1e-6*np.eye(4)
        try:
            nees[i] = float(d @ np.linalg.solve(Pis, d))
        except Exception:
            nees[i] = float(np.sum(d*d/np.clip(np.diag(Pis),1e-9,None)))
    diag[:,1] = pos_err; diag[:,2] = vel_err; diag[:,3] = nees

    th_u = unwrap_masked(th, mb)
    out_idx = np.where(outlier)[0]                       # isolated spikes (classifier)
    dbear = np.abs(np.diff(th_u, prepend=th_u[0]))
    cr_idx = np.where(maneuver & (dbear > 0.5))[0]       # sharp bearing-turn maneuvers (crossing)

    se = pd.DataFrame({
        't': t, 'px': pf_px, 'py': pf_py, 'vx': pf_vx, 'vy': pf_vy,
        'cov_px': cov[:,0], 'cov_py': cov[:,1], 'cov_vx': cov[:,2], 'cov_vy': cov[:,3]})
    se = se.map(fin)
    se.to_csv('results/state_estimates.csv', index=False)

    fd = pd.DataFrame({
        't': diag[:,0], 'rmse_pos': diag[:,1], 'rmse_vel': diag[:,2], 'nees': diag[:,3],
        'ess': diag[:,4], 'resampled': diag[:,5].astype(int), 'weight_entropy': diag[:,6],
        'max_log_weight': diag[:,7], 'min_log_weight': diag[:,8],
        'bearing_residual_mean': diag[:,9], 'bearing_residual_std': diag[:,10]})
    fd = fd.map(fin)
    fd.to_csv('results/filter_diagnostics.csv', index=False)

    summary = {
        'pos_rmse':        fin(np.sqrt(np.mean(pos_err**2))),
        'vel_rmse':        fin(np.sqrt(np.mean(vel_err**2))),
        'mean_nees':       fin(np.mean(nees)),
        'median_nees':     fin(np.median(nees)),
        'ess_min':         fin(np.min(diag[:,4])),
        'ess_mean':        fin(np.mean(diag[:,4])),
        'resampling_count': int(resample_count),
        'weight_degeneracy_detected': bool(weight_degen),
        'used_log_weights': True,
        'angle_wrapping_detected': bool(n_wraps >= 1),
        'angle_wrap_event_count': int(n_wraps),
        'n_particles': int(N_PART),
        'n_steps': int(n),
        'range_channel': int(range_c),
        'bearing_channel': int(bearing_c),
        'final_range_bias': fin(est[-1,4]),
        'final_bearing_bias': fin(est[-1,5]),
        'n_outliers_flagged': int(len(out_idx)),
        'n_crossing_steps': int(len(cr_idx)),
    }
    with open('results/summary.json','w') as f:
        json.dump(summary, f, indent=2)

    concl = (
        "Particle-filter state estimation -- conclusion\n"
        "=============================================\n"
        f"Input      : data/measurements.npz  (N={n}, dt=1.0, 2 channels)\n"
        f"Channels   : column {range_c} = range (non-negative, bounded); "
        f"column {bearing_c} = bearing (wrapped to [-pi, pi]).\n"
        "Sensor     : assumed at the origin; range-bearing model "
        "z_r=|x|+b_r, z_th=atan2(py,px)+b_th.\n"
        f"Filter     : SIR particle filter, N={N_PART}, log-weights, systematic "
        f"resampling when ESS<N*{ESS_FRAC}; Student-t (nu={NU:.0f}) robust "
        "likelihood; robust reversion-test maneuver widening; slow range/bearing "
        "bias random-walk states.\n"
        f"Angle wrap : {n_wraps} modulo-2pi wrap event(s) detected "
        "(raw bearing step > pi); handled with wrap-invariant residuals.\n"
        "Maneuvers  : close target crossing at t=36-37 tracked as a genuine state "
        "change. An offline robust reversion test on back-projected positions "
        "classifies each unusual step: a sharp bearing turn whose 2-D position "
        "CONTINUES is a maneuver (process noise widened); a large one-step jump "
        "whose position REVERTS is an isolated spike (down-weighted).\n"
        f"Outliers   : {len(out_idx)} isolated spike step(s) flagged "
        f"(idx {out_idx.tolist()}) down-weighted by the heavy-tailed likelihood "
        "(not removed).\n"
        "Missing    : range missing t=22-31, bearing missing t=55-63; "
        "skipped in the likelihood (no imputation into the filter).\n\n"
        "IMPORTANT -- PROXY METRICS (no ground-truth state is public):\n"
        "  pos_rmse / vel_rmse / mean_nees / median_nees are PROXIES measured "
        "against a robust measurement-derived reference trajectory, NOT true "
        "state error. The reference is built by back-projecting valid "
        "range-bearing measurements to Cartesian (unwrapped bearing), removing "
        "isolated spikes with a median filter (window 3), smoothing with "
        "Savitzky-Golay (win 9, poly 2), and gap-filling the missing windows "
        "with the smooth fit. NEES uses the filter's per-step position/velocity "
        "covariance (a well-calibrated 4-state filter gives NEES ~ 4).\n\n"
        f"Results    : pos_rmse={summary['pos_rmse']:.4f}, "
        f"vel_rmse={summary['vel_rmse']:.4f}, "
        f"mean_nees={summary['mean_nees']:.3f}, "
        f"median_nees={summary['median_nees']:.3f}\n"
        f"             ess_min={summary['ess_min']:.1f}, "
        f"ess_mean={summary['ess_mean']:.1f}, "
        f"resampling_count={summary['resampling_count']}, "
        f"weight_degeneracy={summary['weight_degeneracy_detected']}\n"
        f"             final range bias={summary['final_range_bias']:.4f}, "
        f"final bearing bias={summary['final_bearing_bias']:.4f} rad\n"
        "Interpretation: the filter tracks the approach, the close crossing and the "
        "receding coast, down-weights the isolated spikes, and bridges the two "
        "missing windows. The NEES proxy is low/well-behaved in cruise and "
        "elevated only at the hard crossing (a conservative, safe calibration)."

    )
    with open('results/conclusion.txt','w') as f:
        f.write(concl)

    meas_px = np.where(mr & mb, r*np.cos(th_u), np.nan)
    meas_py = np.where(mr & mb, r*np.sin(th_u), np.nan)
    okm = ~np.isnan(meas_px)
    render_overview('results/overview.png', t, ref_px, ref_py, pf_px, pf_py,
                    np.where(okm, meas_px, 0.0), np.where(okm, meas_py, 0.0),
                    out_idx, cr_idx, diag)

    for fn in ['state_estimates.csv','filter_diagnostics.csv']:
        df = pd.read_csv('results/'+fn)
        assert np.isfinite(df.select_dtypes('number').to_numpy()).all(), fn
    j = json.load(open('results/summary.json'))
    for k in ['pos_rmse','vel_rmse','mean_nees','median_nees','ess_min','ess_mean',
              'resampling_count','weight_degeneracy_detected','used_log_weights',
              'angle_wrapping_detected','angle_wrap_event_count']:
        assert k in j, k
    for fn in ['state_estimates.csv','filter_diagnostics.csv','summary.json',
               'overview.png','conclusion.txt']:
        assert os.path.exists('results/'+fn), fn
    print("OK: all artifacts written and verified finite.")
    print(json.dumps({k: j[k] for k in
        ['pos_rmse','vel_rmse','mean_nees','median_nees','ess_min','ess_mean',
         'resampling_count','weight_degeneracy_detected','used_log_weights',
         'angle_wrapping_detected','angle_wrap_event_count']}, indent=2))

if __name__ == '__main__':
    main()
