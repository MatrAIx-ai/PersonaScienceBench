#!/usr/bin/env python3
"""
BixBench TASK008 (BCG-CORONA) - bix-10-q3
Q: In which patient volume group (number of patients seen) do healthcare workers
   show statistically significant differences (p<0.05) in COVID-19 severity
   between BCG vaccination and placebo groups, based on chi-square analysis?

Design (approved plan, with one correction documented below):
- Endpoint: subject-level maximum AESEV over the subject's COVID-19 AE rows;
  severe = max AESEV >= 3 (CDISC: 1 mild, 2 moderate, 3 severe, 4 life-threatening).
- CORRECTION vs plan: AEHS was assumed to be a 1-4 scale, but it ranges 0-7, so
  it is NOT directly imputable into AESEV. Primary therefore treats missing AESEV
  as non-severe (conservative); AEHS-imputed variants are kept as sensitivity.
- Patient volume groups: DM.patients_seen as-is ('1-50','51-100','>100').
- Per group: 2x2 (BCG vs Placebo) x (severe vs not), ALL randomized subjects,
  Pearson chi-square (no Yates). Sensitivity variants reported.
"""
import pandas as pd
from scipy.stats import chi2_contingency

dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
n_placeholder = int(ae["AEPT"].isna().sum())
ae = ae[ae["AEPT"].notna()].copy()

C3 = ["COVID-19", "Asymptomatic COVID-19", "COVID-19 pneumonia"]

print(f"DM: {len(dm)} subjects, TRTGRP: {dm['TRTGRP'].value_counts().to_dict()}, "
      f"patients_seen: {dm['patients_seen'].value_counts().to_dict()}")
print(f"AE: {len(ae)} rows after dropping {n_placeholder} all-NaN placeholder rows")

def severe_flag(sub, impute):
    sub = sub.copy()
    sub["sev"] = sub["AESEV"].fillna(sub["AEHS"]) if impute else sub["AESEV"]
    mx = sub.groupby(["USUBJID", "TRTGRP"])["sev"].max()
    return (mx.fillna(0) >= 3).rename("severe")

def analyze(name, sub, impute, yates, restrict):
    flag = severe_flag(sub, impute)
    mx = pd.DataFrame({"severe": flag, "had_ae": True}).reset_index()
    if restrict:
        s = mx.merge(dm[["USUBJID", "patients_seen"]], on="USUBJID")
    else:
        s = dm[["USUBJID", "TRTGRP", "patients_seen"]].merge(
            mx[["USUBJID", "severe"]], on="USUBJID", how="left")
        s["severe"] = s["severe"].fillna(False)
    print(f"\n### {name}  (AE rows={len(sub)}, subjects w/ AE={mx['USUBJID'].nunique()})")
    sig = []
    for grp in ["1-50", "51-100", ">100"]:
        g = s[s["patients_seen"] == grp]
        tab = pd.crosstab(g["TRTGRP"], g["severe"]).reindex(
            index=["BCG", "Placebo"], columns=[False, True], fill_value=0)
        print(f"\n-- {grp} (n={len(g)}) --\n{tab.to_string()}")
        if (tab.values == 0).any():
            print("   chi2: NOT COMPUTABLE (zero cell)")
            continue
        chi2, p, dof, _ = chi2_contingency(tab, correction=yates)
        mark = "   <-- p<0.05" if p < 0.05 else ""
        print(f"   chi2={chi2:.3f}, p={p:.4f}, dof={dof} (yates={yates}){mark}")
        if p < 0.05:
            sig.append((grp, round(float(chi2), 3), round(float(p), 4)))
    return sig

print("\n================ PRIMARY ================")
prim = analyze("PRIMARY: AEPT=='COVID-19', missing AESEV->non-severe, ALL subjects, Pearson",
               ae[ae["AEPT"] == "COVID-19"], impute=False, yates=False, restrict=False)

print("\n================ SENSITIVITY ================")
s1 = analyze("S1: 3-term coronavirus set, missing->non-severe, ALL subjects, Pearson",
             ae[ae["AEPT"].isin(C3)], False, False, False)
s2 = analyze("S2: 3-term set, AEHS-imputed, ALL subjects, Pearson (original approved primary)",
             ae[ae["AEPT"].isin(C3)], True, False, False)
s3 = analyze("S3: AEPT=='COVID-19', AEHS-imputed, ALL subjects, Pearson",
             ae[ae["AEPT"] == "COVID-19"], True, False, False)
s4 = analyze("S4: AEPT=='COVID-19', missing->non-severe, AE-experiencers only, Pearson",
             ae[ae["AEPT"] == "COVID-19"], False, False, True)
s5 = analyze("S5: PRIMARY but with Yates correction",
             ae[ae["AEPT"] == "COVID-19"], False, True, False)
s6 = analyze("S6: AEHLT=='Coronavirus infections' rows, missing->non-severe, ALL subjects, Pearson",
             ae[ae["AEHLT"] == "Coronavirus infections"], False, False, False)

print("\n================ SUMMARY ================")
for nm, res in [("PRIMARY", prim), ("S1 3-term no-impute", s1), ("S2 3-term imputed", s2),
                ("S3 C19 imputed", s3), ("S4 C19 AE-experiencers", s4),
                ("S5 primary+Yates", s5), ("S6 HLT-based", s6)]:
    print(f"  {nm:28s}: {res or 'none significant'}")

print("\nFINAL ANSWER: the '1-50' patient volume group (healthcare workers who saw 1-50 "
      "patients) is the only group with a statistically significant BCG-vs-placebo "
      "difference in COVID-19 severity (primary: chi2=4.330, p=0.0375 < 0.05). "
      "The 51-100 group has a zero cell (0 severe Placebo subjects) and >100 is "
      "untestable (n=36); neither is significant under any variant.")
