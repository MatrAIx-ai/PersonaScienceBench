#!/usr/bin/env python3
"""DESeq2-equivalent (offline; R/DESeq2 not installable). Reproduces DESeq2's core:
median-of-ratios size factors; per-gene NB GLM (log link, Fisher-info IRLS);
dispersion = gene-wise MLE -> mean trend (moving median) -> MAP gamma-prior shrinkage;
Wald test per strain coefficient vs JBX1 (reference strain '1'); BH FDR; DE:=padj<0.05.
Design ~ Media + Strain (Media pooled as blocking factor).
Uniquely DE = (DE_lasI union DE_rhlI) minus DE_double."""
import csv, numpy as np, sys
from scipy.stats import norm
from deseq2_core import irls_beta, mle_r, map_dispersion
W_prior = float(sys.argv[1]) if len(sys.argv)>1 else 3.0
with open('data/raw_counts.csv') as f:
    rd=csv.reader(f); header=next(rd); data=[r for r in rd]
genes=[r[0] for r in data]; counts=np.array([[int(v) for v in r[1:]] for r in data],float)
samples=header[1:]
with open('data/experiment_metadata.csv') as f:
    rm=csv.reader(f); mh=next(rm); meta={row[1]:row for row in rm}
mi={c:i for i,c in enumerate(mh)}
strain={s:meta[s][mi['Strain']] for s in samples}; media={s:meta[s][mi['Media']] for s in samples}
N=len(genes)
X=np.zeros((len(samples),6))
for j,s in enumerate(samples):
    X[j,0]=1; X[j,1]=(media[s]=='MMGluFePlus'); X[j,2]=(media[s]=='Succinate')
    X[j,3]=(strain[s]=='97'); X[j,4]=(strain[s]=='98'); X[j,5]=(strain[s]=='99')
geo=np.exp(np.log(counts+1e-9).mean(0)); sf=np.median(counts/geo,0); sf/=np.median(sf)
def gene_mle(y):
    b0=np.linalg.lstsq(X,np.log(y+0.5),rcond=None)[0]; r=10.0
    for _ in range(20):
        b,mu,w,cov=irls_beta(y,X,r,b0); r2=mle_r(y,mu)
        if abs(r2-r)<1e-5*max(1,r): r=r2; break
        r=r2
    b,mu,w,cov=irls_beta(y,X,r,b0); return b0,1.0/r,mu.mean()
# PASS 1: gene-wise MLE dispersion + mean
alpha_g=np.full(N,np.nan); mu_mean=np.full(N,np.nan)
for gi,y in enumerate(counts):
    _,alpha_g[gi],mu_mean[gi]=gene_mle(y)
# trend
lm=np.log(np.clip(mu_mean,1e-6,None)); la=np.log(np.clip(alpha_g,1e-6,None))
order=np.argsort(lm); ld=la[order]
def mmed(v,win):
    n=len(v); out=np.empty(n)
    for i in range(n):
        a=max(0,i-win//2); b=min(n,i+win//2+1); out[i]=np.median(v[a:b])
    return out
trend_alpha=np.empty(N); trend_alpha[order]=np.exp(mmed(ld,300))
# PASS 2: MAP dispersion + refit + Wald
idx={'97':3,'98':4,'99':5}
lfc={k:np.full(N,np.nan) for k in idx}; pv={k:np.full(N,np.nan) for k in idx}; disp=np.full(N,np.nan)
for gi,y in enumerate(counts):
    b0,ag,mmean=gene_mle(y)
    a=map_dispersion(y, np.exp(np.clip(X@b0,-30,30)), trend_alpha[gi], W_prior); disp[gi]=a
    b,mu,w,cov=irls_beta(y,X,1.0/a,b0)
    for s,i in idx.items():
        se=np.sqrt(max(cov[i,i],1e-12)); lfc[s][gi]=b[i]/np.log(2); pv[s][gi]=2*(1-norm.cdf(abs(b[i]/se)))
def bh(p):
    p=np.asarray(p,float); n=len(p); o=np.argsort(p); r=np.arange(1,n+1)
    adj=np.minimum.accumulate((p[o]*n/r)[::-1])[::-1]; adj=np.clip(adj,0,1)
    out=np.empty(n); out[o]=adj; return out
padj={s:bh(pv[s]) for s in pv}; DE={s:set(np.where(padj[s]<0.05)[0]) for s in padj}
print(f"[W_prior={W_prior}] max|LFC|={max(np.nanmax(np.abs(lfc[s])) for s in lfc):.2f} disp median={np.nanmedian(disp):.4f}")
print("DE vs JBX1: " + " ".join(f"{s}={len(DE[s])}" for s in ['97','98','99']))
print("min raw-p: " + " ".join(f"{s}={pv[s].min():.3e}" for s in ['97','98','99']))
gi=genes.index('PA14_10360')
print(f"PA14_10360: disp={disp[gi]:.4f} p97={pv['97'][gi]:.2e} p98={pv['98'][gi]:.2e} p99={pv['99'][gi]:.2e}")
scen={}
for d in ['97','98','99']:
    singles=[x for x in ['97','98','99'] if x!=d]
    union=DE[singles[0]]|DE[singles[1]]; uniq=union-DE[d]; scen[d]=len(uniq)
    print(f"double={d} singles={singles}: |union|={len(union)} |DE_double|={len(DE[d])} unique={len(uniq)}")
for s in ['97','98','99']:
    with open(f'DE_strain{s}_vs_JBX1.csv','w',newline='') as f:
        w=csv.writer(f); w.writerow(['gene','log2FC','pvalue','padj_BH','DE'])
        for gi in range(N):
            w.writerow([genes[gi], f"{lfc[s][gi]:.6f}", f"{pv[s][gi]:.6g}", f"{padj[s][gi]:.6g}", int(padj[s][gi]<0.05)])
for d in scen:
    singles=[x for x in ['97','98','99'] if x!=d]
    uniq=sorted((DE[singles[0]]|DE[singles[1]])-DE[d])
    with open(f'unique_DE_double_{d}.csv','w',newline='') as f:
        w=csv.writer(f); w.writerow(['gene']); [w.writerow([genes[i]]) for i in uniq]
print("PRIMARY (double=99) UNIQUE DE COUNT =", scen['99'], " all:", scen)
