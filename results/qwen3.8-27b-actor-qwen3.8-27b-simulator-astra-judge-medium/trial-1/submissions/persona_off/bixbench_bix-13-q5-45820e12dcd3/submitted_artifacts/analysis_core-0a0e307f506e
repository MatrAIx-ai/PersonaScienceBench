"""DESeq2-equivalent NB GLM (log link). Correct Fisher-information IRLS weights.
Var = mu + alpha*mu^2 (alpha=1/r); d mu/d eta = mu (log link).
Working weight w = (d mu/d eta)^2 / Var = mu^2/(mu+alpha*mu^2) = mu/(1+alpha*mu).
Working response z = eta + (y-mu)/mu.  Cov(beta) = (X'WX)^{-1}."""
import numpy as np
from scipy.special import gammaln
from scipy.optimize import minimize_scalar

def irls_beta(y, X, r, b0):
    a=1.0/r; b=b0.copy()
    for _ in range(100):
        eta=X@b; mu=np.exp(np.clip(eta,-30,30))
        w=mu/(1.0+a*mu)                       # (d mu/d eta)^2 / Var
        z=eta+(y-mu)/mu                        # working response
        XtWX=X.T@(w[:,None]*X); XtWz=X.T@(w*z)
        try: b2=np.linalg.solve(XtWX,XtWz)
        except np.linalg.LinAlgError: b2=np.linalg.lstsq(XtWX,XtWz,rcond=None)[0]
        if np.allclose(b,b2,rtol=1e-9,atol=1e-11): b=b2; break
        b=b2
    eta=X@b; mu=np.exp(np.clip(eta,-30,30)); w=mu/(1.0+a*mu)
    XtWX=X.T@(w[:,None]*X)
    try: cov=np.linalg.inv(XtWX)
    except np.linalg.LinAlgError: cov=np.linalg.pinv(XtWX)
    return b,mu,w,cov

def mle_r(y, mu):
    g=lambda rr:(-gammaln(y+rr)+gammaln(rr)-rr*np.log(rr)+(y+rr)*np.log(rr+mu)).sum()
    res=minimize_scalar(g,bounds=(1e-3,1e3),method='bounded')
    return res.x if res.success else 10.0

def nb_loglik_alpha(y, mu, alpha):
    r=1.0/alpha
    return (gammaln(y+r)-gammaln(r)+r*np.log(r+1e-300)-(y+r)*np.log(r+mu)).sum()

def map_dispersion(y, mu, alpha_prior, W):
    rate=W/alpha_prior
    def negpost(alpha):
        return -(nb_loglik_alpha(y,mu,alpha) - (W-1)*np.log(alpha) - rate*alpha)
    res=minimize_scalar(negpost,bounds=(1e-4,10),method='bounded')
    return res.x if res.success else alpha_prior
