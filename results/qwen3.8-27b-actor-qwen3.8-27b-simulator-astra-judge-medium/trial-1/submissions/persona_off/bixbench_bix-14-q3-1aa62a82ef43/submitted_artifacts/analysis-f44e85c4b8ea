#!/usr/bin/env python3
"""
BixBench bix-14-q3 analysis:
"After filtering out reference variant calls and variants located in intronic,
intergenic, or UTR regions, how many non-reference exonic variants remain in
CHIP genes from the 86 samples analyzed?"

Self-contained; run from the directory containing data/.
"""
import glob
import os
import re
import pandas as pd

DATA_DIR = "data"
SAMPLE_DIR = os.path.join(DATA_DIR, "CHIP_DP10_GQ20_PASS")
CHIP_GENE_FILE = os.path.join(DATA_DIR, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx")

# SO terms to EXCLUDE (intronic / intergenic-like / UTR)
EXCLUDE_SO = {
    "intron_variant",
    "upstream_gene_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}
# CDS-only sensitivity: additionally exclude splice_region_variant
EXCLUDE_SO_CDS_ONLY = EXCLUDE_SO | {"splice_region_variant"}

NON_REFERENCE_ZYG = {"Heterozygous", "Homozygous Variant"}


def load_chip_genes(path):
    df = pd.read_excel(path, header=None)  # no header row; ABL1 is a data row
    genes = set(df.iloc[:, 0].dropna().astype(str).str.strip())
    return genes


def sample_id_from_filename(fname):
    m = re.search(r"CHIP_(\S+)\.xlsx", os.path.basename(fname))
    return m.group(1)


def main():
    chip_genes = load_chip_genes(CHIP_GENE_FILE)
    print(f"CHIP gene list ({CHIP_GENE_FILE}): {len(chip_genes)} genes")

    files = sorted(glob.glob(os.path.join(SAMPLE_DIR, "*.xlsx")))
    print(f"Sample workbooks found: {len(files)}\n")

    records = []          # one row per qualifying (sample, variant) record
    per_sample = []       # (sample, n_qualifying)
    totals = {"rows": 0, "nonref": 0, "nonref_chip": 0,
              "nonref_chip_exonic": 0, "nonref_chip_exonic_cdsonly": 0,
              "dupes_removed": 0}
    so_breakdown = {}
    gene_breakdown = {}

    for f in files:
        sample = sample_id_from_filename(f)
        df = pd.read_excel(f, header=1)  # row 1 = group header, row 2 = column names

        totals["rows"] += len(df)

        # (4) de-duplicate exact (Chr:Pos, Ref/Alt) within sample, keep first
        before = len(df)
        df = df.drop_duplicates(subset=["Chr:Pos", "Ref/Alt"], keep="first")
        totals["dupes_removed"] += before - len(df)

        # (1) non-reference: Zygosity in {Heterozygous, Homozygous Variant}
        #     ('Reference' and blank zygosity are excluded; blanks all lack VAF)
        d = df[df["Zygosity"].isin(NON_REFERENCE_ZYG)].copy()
        totals["nonref"] += len(d)

        # (3) in a CHIP gene: any comma-split symbol in the 56-gene list; row counted once
        def in_chip(s):
            return any(g.strip() in chip_genes for g in str(s).split(","))
        d = d[d["Gene Names"].apply(in_chip)]
        totals["nonref_chip"] += len(d)

        # (2) exonic: keep all SO terms except the 5 excluded
        d["chip_gene"] = d["Gene Names"].apply(
            lambda s: next(g.strip() for g in s.split(",") if g.strip() in chip_genes))
        exonic = d[~d["Sequence Ontology (Combined)"].isin(EXCLUDE_SO)]
        totals["nonref_chip_exonic"] += len(exonic)
        cdsonly = d[~d["Sequence Ontology (Combined)"].isin(EXCLUDE_SO_CDS_ONLY)]
        totals["nonref_chip_exonic_cdsonly"] += len(cdsonly)

        per_sample.append((sample, len(exonic)))
        for _, r in exonic.iterrows():
            records.append((sample, r["Chr:Pos"], r["Ref/Alt"],
                            r["Sequence Ontology (Combined)"], r["chip_gene"],
                            r["Zygosity"]))
            so_breakdown[r["Sequence Ontology (Combined)"]] = \
                so_breakdown.get(r["Sequence Ontology (Combined)"], 0) + 1
            gene_breakdown[r["chip_gene"]] = gene_breakdown.get(r["chip_gene"], 0) + 1

    rec_df = pd.DataFrame(records, columns=["sample", "chr_pos", "ref_alt",
                                            "so_term", "chip_gene", "zygosity"])

    print("=" * 72)
    print("GLOBAL TOTALS")
    print("=" * 72)
    print(f"Total data rows across 86 workbooks        : {totals['rows']}")
    print(f"Exact (Chr:Pos,Ref/Alt) dupes removed      : {totals['dupes_removed']}")
    print(f"Non-reference rows (Het or HomVar)         : {totals['nonref']}")
    print(f"  ...in a CHIP gene (56-gene list)         : {totals['nonref_chip']}")
    print(f"  ...exonic (primary: excl. intron/interg./UTR): {totals['nonref_chip_exonic']}")
    print(f"  ...exonic (CDS-only sensitivity)         : {totals['nonref_chip_exonic_cdsonly']}")
    print(f"  ...of which splice_region_variant        : "
          f"{so_breakdown.get('splice_region_variant', 0)}")

    print("\n" + "=" * 72)
    print("SO-TERM BREAKDOWN (primary exonic set, qualifying records)")
    print("=" * 72)
    for k, v in sorted(so_breakdown.items(), key=lambda x: -x[1]):
        print(f"  {v:5d}  {k}")

    uniq = rec_df.drop_duplicates(subset=["chr_pos", "ref_alt"])
    print("\n" + "=" * 72)
    print("SUPPLEMENTARY: UNIQUE GENOMIC VARIANTS ACROSS ALL 86 SAMPLES")
    print("=" * 72)
    print(f"Unique (Chr:Pos, Ref/Alt) qualifying variants : {len(uniq)}")
    print(f"Samples with >=1 qualifying variant          : "
          f"{rec_df['sample'].nunique()} / {len(files)}")
    print(f"Median qualifying variants per sample        : "
          f"{pd.Series([n for _, n in per_sample]).median():.0f}")

    print("\n" + "=" * 72)
    print("PER-GENE BREAKDOWN (qualifying variant-sample records)")
    print("=" * 72)
    gdf = pd.Series(gene_breakdown).sort_values(ascending=False)
    print(gdf.to_string())
    print(f"Gene total: {gdf.sum()} across {len(gdf)} genes")

    print("\n" + "=" * 72)
    print("PER-SAMPLE COUNTS (primary exonic definition)")
    print("=" * 72)
    ps = pd.Series(dict(per_sample))
    print(ps.to_string())

    print("\n" + "=" * 72)
    print("ANSWER")
    print("=" * 72)
    print(f"After excluding reference calls and intronic/intergenic/UTR variants, "
          f"{totals['nonref_chip_exonic']} non-reference exonic variant records "
          f"remain in CHIP genes across the 86 samples "
          f"(CDS-only sensitivity: {totals['nonref_chip_exonic_cdsonly']}; "
          f"unique genomic variants: {len(uniq)}).")

    # save intermediate results for evidence
    rec_df.to_csv("chip_exonic_qualifying_records.csv", index=False)
    pd.Series(dict(per_sample)).to_csv("chip_exonic_per_sample_counts.csv",
                                       header=["n_qualifying"])
    print("\nSaved: chip_exonic_qualifying_records.csv, chip_exonic_per_sample_counts.csv")


if __name__ == "__main__":
    main()
