"""
BixBench bix-16-q2: Skewness of gene expression (log2(TPM+1)) distribution
across all cell lines in the dataset.

Method (per approved plan):
- Load data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
  (rows = cell-line ModelIDs, cols = protein-coding genes, values = log2(TPM+1)).
- Pool ALL values (all genes x all cell lines) into one 1-D vector.
- No gene filtering, no imputation, no clipping of negative batch-corrected values.
- Skewness = scipy.stats.skew (Fisher-Pearson moment coefficient, g1 = m3/m2^1.5).
- Qualitative characterization supported by mean-vs-median and percentile checks.
"""
import numpy as np
import pandas as pd
from scipy import stats

CSV = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"

df = pd.read_csv(CSV, index_col=0)
n_cell, n_gene = df.shape
print(f"Matrix shape: {n_cell} cell lines x {n_gene} genes")

vals = df.to_numpy(dtype=float).ravel()  # pooled 1-D vector
print(f"Pooled vector length: {vals.size:,}")

skew = stats.skew(vals)  # Fisher-Pearson moment coefficient (biased)
skew_unbiased = stats.skew(vals, bias=False)

mean = float(vals.mean())
median = float(np.median(vals))
std = float(vals.std())
p = np.percentile(vals, [1, 5, 25, 50, 75, 95, 99])

print("\n--- Descriptive statistics (pooled distribution) ---")
print(f"min      : {vals.min():.6f}")
print(f"max      : {vals.max():.6f}")
print(f"mean     : {mean:.6f}")
print(f"median   : {median:.6f}")
print(f"std      : {std:.6f}")
print("percentiles (1,5,25,50,75,95,99):")
for q, v in zip([1,5,25,50,75,95,99], p):
    print(f"  P{q:<3d}: {v:.4f}")

print("\n--- Skewness ---")
print(f"scipy.stats.skew (Fisher-Pearson, biased)  g1 = {skew:.6f}")
print(f"scipy.stats.skew (bias=False, corrected)   G1 = {skew_unbiased:.6f}")

# Qualitative interpretation
def char(s):
    if s > 0.5: return "strongly right-skewed (positive)"
    if s > 0.1: return "right-skewed (positive)"
    if s < -0.5: return "strongly left-skewed (negative)"
    if s < -0.1: return "left-skewed (negative)"
    return "approximately symmetric"

print(f"\nInterpretation: {char(skew)}")
print("mean > median =>", mean > median, f"(mean {mean:.4f} vs median {median:.4f})")
print("long right tail => P99-P50 =", f"{p[6]-p[3]:.3f}", "vs P50-P1 =", f"{p[3]-p[0]:.3f}")

print("\nRESULT:")
print(f"Skewness of pooled log2(TPM+1) expression distribution = {skew:.4f} -> {char(skew)}")
