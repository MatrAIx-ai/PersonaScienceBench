"""
BixBench bix-22-q2
Q: Pearson correlation between gene length and mean expression (across samples)
   for protein-coding genes in CD4 immune cells.

Approved method:
  - protein-coding: exact gene_biotype == 'protein_coding'
  - CD4 samples: celltype == 'CD4' (from Sample_annotated)
  - expression: raw batch-corrected read counts, arithmetic mean across CD4 samples
  - include all protein-coding genes (no zero-expression filter)
  - scipy.stats.pearsonr(Length, mean_CD4_expr)
"""
import pandas as pd
import numpy as np
from scipy import stats

# ---- Load inputs ----
gm  = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)
sa  = pd.read_csv('data/Sample_annotated_Zenodo.csv')
cnt = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)

# ---- Step A: protein-coding genes (exact biotype) ----
pc_mask = gm['gene_biotype'] == 'protein_coding'
pc_genes = gm.index[pc_mask].tolist()
print(f"Protein-coding genes (exact 'protein_coding'): {len(pc_genes)}")

# ---- Step B: CD4 samples ----
cd4_samples = sa.loc[sa['celltype'] == 'CD4', 'sample'].tolist()
print(f"CD4 samples (celltype=='CD4'): {len(cd4_samples)}")

# safety: confirm all CD4 samples exist as columns
missing = [s for s in cd4_samples if s not in cnt.columns]
print(f"CD4 samples missing from count matrix: {len(missing)}")

# ---- Step C: mean raw expression across CD4 samples for protein-coding genes ----
sub = cnt.loc[pc_genes, cd4_samples]          # genes x 151 samples
mean_expr = sub.mean(axis=1)                  # arithmetic mean per gene
length    = gm.loc[pc_genes, 'Length']        # gene length

# align / sanity
assert len(mean_expr) == len(length) == len(pc_genes)
x = length.to_numpy(dtype=float)
y = mean_expr.to_numpy(dtype=float)
print(f"n = {len(x)}")
print(f"Length: min={x.min():.0f} max={x.max():.0f} mean={x.mean():.2f}")
print(f"Mean CD4 expr: min={y.min():.4f} max={y.max():.4f} mean={y.mean():.4f}")
print(f"genes with zero mean CD4 expr: {(y==0).sum()}")

# ---- Step D: Pearson correlation ----
r, p = stats.pearsonr(x, y)
# cross-check with numpy
r_np = np.corrcoef(x, y)[0, 1]

print("\n===== RESULT =====")
print(f"Pearson r          = {r:.6f}")
print(f"  (numpy corrcoef) = {r_np:.6f}")
print(f"p-value            = {p:.6e}")
print(f"n                  = {len(x)}")
