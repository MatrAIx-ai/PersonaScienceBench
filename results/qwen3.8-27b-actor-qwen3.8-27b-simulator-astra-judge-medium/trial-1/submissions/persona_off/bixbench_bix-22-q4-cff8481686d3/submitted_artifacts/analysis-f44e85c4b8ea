"""BixBench bix-22-q4: Pearson correlation between gene length and mean expression
(protein-coding genes, CD14 immune cells).

Approved decisions:
(a) gene_biotype == 'protein_coding' exact match
(b) CD14 samples via annotation celltype == 'CD14'
(c) per-gene mean across those columns, stored batch-corrected values, no transform
(d) join on first gene-symbol column
(e) Pearson r via scipy.stats.pearsonr
"""
import csv
import numpy as np
from scipy import stats

DATA = "/workspace/data"

# 1. Load sample annotation -> CD14 sample names
cd14_samples = []
with open(f"{DATA}/Sample_annotated_Zenodo.csv") as f:
    r = csv.reader(f)
    next(r)
    for row in r:
        if row[3] == "CD14":
            cd14_samples.append(row[0])
print(f"CD14 samples: {len(cd14_samples)}")

# 2. Load gene meta info: gene symbol -> (Length, biotype)
meta_len, meta_bio = {}, {}
with open(f"{DATA}/GeneMetaInfo_Zenodo.csv") as f:
    r = csv.reader(f)
    next(r)
    for row in r:
        meta_len[row[0]] = int(row[3])
        meta_bio[row[0]] = row[4]
print(f"genes in meta: {len(meta_len)}")

# 3. Load counts, keep CD14 columns, compute per-gene mean (stored values)
mean_expr, mean_expr_log1p = {}, {}
with open(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv") as f:
    r = csv.reader(f)
    header = next(r)
    idx = [i for i, h in enumerate(header) if h in set(cd14_samples)]
    assert len(idx) == len(cd14_samples), "missing CD14 columns"
    n_genes = 0
    for row in r:
        g = row[0]
        vals = np.array([float(row[i]) for i in idx])
        mean_expr[g] = vals.mean()
        mean_expr_log1p[g] = np.log1p(vals).mean()
        n_genes += 1
print(f"genes in counts: {n_genes}")

def pearson(genes):
    length = np.array([meta_len[g] for g in genes], dtype=float)
    expr = np.array([mean_expr[g] for g in genes], dtype=float)
    expr_l = np.array([mean_expr_log1p[g] for g in genes], dtype=float)
    if length.std() == 0 or expr.std() == 0:
        return None, None, None
    r1, p1 = stats.pearsonr(length, expr)
    r2, _ = stats.pearsonr(length, np.log1p(expr))  # log1p of per-gene mean
    r3, _ = stats.pearsonr(length, expr_l)          # mean of log1p
    return r1, p1, r3

# 4. Primary: exact protein_coding match, raw stored values
pc_exact = [g for g, b in meta_bio.items() if b == "protein_coding"]
missing = [g for g in pc_exact if g not in mean_expr]
print(f"protein_coding (exact): {len(pc_exact)}; missing from matrix: {len(missing)}")
r_primary, p_primary, r_log1p_mean = pearson(pc_exact)
print(f"\nPRIMARY (exact protein_coding, raw values): n={len(pc_exact)}  r={r_primary:.6f}  p={p_primary:.3e}")

# 5. Sensitivity A: contains protein_coding
pc_contains = [g for g, b in meta_bio.items() if "protein_coding" in b.split(";")]
r_cont, p_cont, _ = pearson(pc_contains)
print(f"SENSITIVITY (contains protein_coding, raw): n={len(pc_contains)}  r={r_cont:.6f}  p={p_cont:.3e}")

# 6. Sensitivity B: log1p of per-gene mean (raw-value-based)
length = np.array([meta_len[g] for g in pc_exact], dtype=float)
expr = np.array([mean_expr[g] for g in pc_exact], dtype=float)
r_log, p_log = stats.pearsonr(length, np.log1p(expr))
print(f"SENSITIVITY (exact, log1p(mean)): n={len(pc_exact)}  r={r_log:.6f}  p={p_log:.3e}")
