"""
BixBench bix-22-q6: Pearson correlation between gene length and gene expression,
protein-coding genes only.

Method (approved plan):
  1. Join GeneMetaInfo to BatchCorrectedReadCounts on gene symbol
     (first unnamed column of each file; verified identical keys).
  2. Filter to gene_biotype == 'protein_coding' (exact match).
  3. Per-gene expression = mean of RAW batch-corrected read counts across
     all 723 sample columns.
  4. Pearson r between Length and that mean expression (scipy.stats.pearsonr).
Sensitivity checks: log1p-transformed mean expression; excluding all-zero
expression genes.
"""
import pandas as pd
import numpy as np
from scipy import stats

meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
expr = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0, low_memory=False)
expr.index.name = 'Geneid'

# 1. Join on gene symbol
df = expr.join(meta.set_index('Geneid')[['Length', 'gene_biotype']], how='inner')
assert len(df) == len(expr) == len(meta), "join size mismatch"

# 2. Protein-coding only (exact biotype match)
pc = df[df['gene_biotype'] == 'protein_coding'].copy()
n_pc = len(pc)

# 3. Per-gene mean of raw counts across ALL sample columns only
sample_cols = [c for c in pc.columns if c not in ('Length', 'gene_biotype')]
n_samples = len(sample_cols)
pc['mean_expr_raw'] = pc[sample_cols].mean(axis=1)
pc['mean_expr_log1p'] = np.log1p(pc[sample_cols].mean(axis=1))
pc['all_zero'] = (pc[sample_cols].to_numpy(dtype=float) == 0).all(axis=1)

# 4. Primary: Pearson r on raw means
r_raw, p_raw = stats.pearsonr(pc['Length'], pc['mean_expr_raw'])

# Sensitivity A: log1p-transformed mean expression
r_log, p_log = stats.pearsonr(pc['Length'], pc['mean_expr_log1p'])

# Sensitivity B: exclude all-zero-expression genes (raw means)
pc_nz = pc[~pc['all_zero']]
r_nz, p_nz = stats.pearsonr(pc_nz['Length'], pc_nz['mean_expr_raw'])

print(f"n protein-coding genes            : {n_pc}")
print(f"n samples used (all columns)      : {n_samples}")
print(f"pc genes with all-zero expression : {int(pc['all_zero'].sum())}")
print()
print(f"PRIMARY  Pearson r (raw mean expr vs Length)        : {r_raw:.6f}   (p = {p_raw:.3e}, n = {n_pc})")
print(f"SENS A   Pearson r (log1p mean expr vs Length)      : {r_log:.6f}   (p = {p_log:.3e}, n = {n_pc})")
print(f"SENS B   Pearson r (raw, excl. zero-expr genes)     : {r_nz:.6f}   (p = {p_nz:.3e}, n = {len(pc_nz)})")
