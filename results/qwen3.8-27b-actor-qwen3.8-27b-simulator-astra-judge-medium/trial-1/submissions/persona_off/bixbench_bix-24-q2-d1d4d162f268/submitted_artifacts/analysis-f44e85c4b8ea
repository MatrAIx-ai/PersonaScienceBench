#!/usr/bin/env python3
"""CBD metabolic effects in CRC: UP vs DOWN regulation.
DE (CBD_IC50 vs DMSO) + GO:BP enrichment (up & down separately). Self-contained,
degrades gracefully. Thresholds exactly: padj<0.05 AND |log2FC|>0.5."""
import os, sys, json, shutil, socket, subprocess, re, glob, warnings
warnings.filterwarnings("ignore")
import numpy as np, pandas as pd
from scipy import stats

DATA="data"; COUNTS=os.path.join(DATA,"counts_raw_unfiltered.csv")
LAYOUT=os.path.join(DATA,"sample_layout.csv"); OUT="results"
os.makedirs(OUT, exist_ok=True)
LFC_TH, PADJ_TH = 0.5, 0.05
MIN_CPM, MIN_SAMPLES = 1.0, 6

counts_df = pd.read_csv(COUNTS, index_col=0)
layout = pd.read_csv(LAYOUT)
C = counts_df.values.astype(float)
genes_all = counts_df.index.values
sid2col = {c.replace("_","-"): c for c in counts_df.columns}
layout["col"] = layout["SampleID"].map(sid2col)
assert layout["col"].notna().all(), "SampleID->column join failed"
g2idx = {c:i for i,c in enumerate(counts_df.columns)}
layout["gidx"] = layout["col"].map(g2idx)
print(f"[load] genes={C.shape[0]} samples={C.shape[1]} groups={layout['Group'].nunique()}")

logC = np.where(C>0, np.log(C), -np.inf)          # -inf at zeros
gm = np.exp(np.mean(logC, axis=1))                 # 0 for genes with any zero (DESeq2)
valid = gm > 0
ratio = C[valid]/gm[valid][:,None]                 # median-of-ratios over expressed genes
sf = np.median(ratio, axis=0); sf = np.where(sf==0, 1.0, sf)
cpm = C/sf[None,:]
logcpm = np.log2(cpm+1.0)
keep = (cpm>=MIN_CPM).sum(axis=1) >= MIN_SAMPLES
genes = genes_all[keep]
print(f"[filter] CPM>={MIN_CPM} in >={MIN_SAMPLES} samples: kept {keep.sum()}/{C.shape[0]}")

def cols_for(group):
    return [int(i) for i in layout.loc[layout["Group"]==group,"gidx"]]

def eb_t_de(idx_a, idx_b):
    X = logcpm[keep][:,idx_a]; Y = logcpm[keep][:,idx_b]
    n1,n2 = X.shape[1], Y.shape[1]
    m1,m2 = X.mean(1), Y.mean(1); v1,v2 = X.var(1,ddof=1), Y.var(1,ddof=1)
    dof = n1+n2-2; sp2 = ((n1-1)*v1+(n2-1)*v2)/dof
    d0=4.0; s0=np.median(sp2); s2=(d0*s0+dof*sp2)/(d0+dof)
    se = np.sqrt(s2*(1.0/n1+1.0/n2)); lfc=m1-m2; t=lfc/se
    p = 2*stats.t.sf(np.abs(t), d0+dof)
    order=np.argsort(p); m=len(p); pv=p[order]
    bh=pv*np.arange(1,m+1)/m; adj=np.minimum.accumulate(bh[::-1])[::-1]
    padj=np.empty(m); padj[order]=adj
    return pd.DataFrame({"log2FC":lfc,"p":p,"padj":padj}, index=genes)

def deseq2_de(group_a, group_b, tag):
    rscript = shutil.which("Rscript")
    if not rscript:
        return None
    a=cols_for(group_a); b=cols_for(group_b); sel=a+b
    pd.DataFrame(C[:,sel], index=genes_all).to_csv(f"{OUT}/_sub_{tag}.csv")
    rcode = f'''
suppressMessages({{library(DESeq2)}})
m <- as.matrix(read.csv("{OUT}/_sub_{tag}.csv", row.names=1))
g <- c(rep("{group_a}",{len(a)}), rep("{group_b}",{len(b)}))
dds <- DESeqDataSetFromMatrix(countData=m, colData=data.frame(condition=g), design=~condition)
dds <- DESeq(dds)
res <- results(dds, contrast=c("condition","{group_a}","{group_b}"),
              independentFiltering=TRUE, lfcThreshold={LFC_TH}, minCount=10, alpha={PADJ_TH})
res <- as.data.frame(res); res$gene <- rownames(res)
write.csv(res, "{OUT}/deseq2_{tag}.csv", row.names=FALSE)
'''
    with open(f"{OUT}/_deseq2_{tag}.R","w") as f:
        f.write("setwd('%s')\n"%OUT+rcode)
    try:
        r = subprocess.run([rscript,f"{OUT}/_deseq2_{tag}.R"],capture_output=True,text=True,timeout=1800)
        if r.returncode==0 and os.path.exists(f"{OUT}/deseq2_{tag}.csv"):
            return pd.read_csv(f"{OUT}/deseq2_{tag}.csv", index_col="gene")
        print(f"[deseq2] R present, run failed: {r.stderr[-300:]}")
    except Exception as e:
        print(f"[deseq2] unavailable: {e}")
    return None

def run_de(group_a, group_b, tag, label):
    res = deseq2_de(group_a, group_b, tag); tool="DESeq2"
    if res is None:
        res = eb_t_de(cols_for(group_a), cols_for(group_b)); tool="EB-moderated t (limma-style, pure Python)"
    res["padj"] = res["padj"].fillna(1.0)
    sig = res[(res["padj"]<PADJ_TH) & (res["log2FC"].abs()>LFC_TH)]
    up = sig[sig["log2FC"]>LFC_TH]; down = sig[sig["log2FC"]<-LFC_TH]
    res.to_csv(f"{OUT}/de_{tag}.csv")
    pd.Series(up.index).to_csv(f"{OUT}/de_{tag}_up.csv", index=False, header=False)
    pd.Series(down.index).to_csv(f"{OUT}/de_{tag}_down.csv", index=False, header=False)
    print(f"\n[DE:{label}] tool={tool}  padj<{PADJ_TH} & |log2FC|>{LFC_TH}")
    print(f"   significant DE = {len(sig)}   UP = {len(up)}   DOWN = {len(down)}")
    tu = up.sort_values('log2FC',ascending=False).index[:5]
    td = down.sort_values('log2FC').index[:5]
    print("   top UP  : "+", ".join(f"{g}({up.loc[g,'log2FC']:.2f})" for g in tu))
    print("   top DOWN: "+", ".join(f"{g}({down.loc[g,'log2FC']:.2f})" for g in td))
    return res, up, down

def _net_ok(host="rest.ensembl.org", port=443, t=4):
    try:
        s=socket.socket(); s.settimeout(t); s.connect((host,port)); s.close(); return True
    except Exception:
        return False

def load_go_bp_map():
    """Return (records, source). records = list of (ens_id, go_id, go_name) for BP."""
    rscript = shutil.which("Rscript")
    if rscript:
        rcode = f'''
ok <- requireNamespace("org.Hs.eg.db",quietly=TRUE) && requireNamespace("AnnotationDbi",quietly=TRUE)
if (ok) {{
  library(org.Hs.eg.db); library(AnnotationDbi)
  s2e <- as.data.frame(org.Hs.egSYMBOL); s2e$ens <- rownames(org.Hs.egSYMBOL)
  bp <- select(org.Hs.eg.db, keys=names(org.Hs.egSYMBOL), columns="GOBP", keytype="SYMBOL")
  m <- merge(s2e, bp, by.x="SYMBOL", by.y="SYMBOL", all=FALSE)
  write.csv(m, "{OUT}/go_bp_map.csv", row.names=FALSE)
}}
'''
        with open(f"{OUT}/_go.R","w") as f:
            f.write("setwd('%s')\n"%OUT+rcode)
        try:
            subprocess.run([rscript,f"{OUT}/_go.R"],capture_output=True,text=True,timeout=1800)
            if os.path.exists(f"{OUT}/go_bp_map.csv"):
                m=pd.read_csv(f"{OUT}/go_bp_map.csv")
                return list(zip(m["ens"].astype(str),m["GOBP"].astype(str),m["GOBP"])), "R org.Hs.eg.db"
        except Exception as e:
            print(f"[go-map] R attempt failed: {e}")
    for root in ["data",".",OUT,"/workspace","/"]:
        for pat in ["*gene2go*","*gene2gp*","*go_bp*","*goa*","*.gmt","*annotation*"]:
            for f in glob.glob(os.path.join(root,pat)):
                if os.path.isfile(f) and os.path.getsize(f)>10000:
                    print(f"[go-map] local candidate: {f}")
    if _net_ok():
        return None, "network present; full gene2go fetch not completed in this run"
    return None, "NO_GO_BP_MAPPING: no R/Bioconductor, no local annotation file, no network"

def ora(de_set, background, go_map):
    bg=set(background); term_genes={}
    for ens,go,name in go_map:
        term_genes.setdefault(go,{"name":name,"genes":set()})
        term_genes[go]["genes"].add(ens)
    rows=[]
    for go,d in term_genes.items():
        gset=d["genes"]&bg
        if len(gset)<5: continue
        a=len(de_set&gset); b=len(gset)-a; c=len(de_set&bg)-a; d2=len(bg)-len(gset)-c
        if a<0 or c<0 or d2<0: continue
        p=stats.fisher_exact([[a,b],[c,d2]],alternative="greater")[1]
        rows.append({"GO":go,"name":d["name"],"DE_in":a,"term_size":len(gset),"p":p})
    df=pd.DataFrame(rows)
    if df.empty: return df
    order=df["p"].values.argsort(); m=len(df); pv=df["p"].values[order]
    bh=pv*np.arange(1,m+1)/m; adj=np.minimum.accumulate(bh[::-1])[::-1]
    df=df.sort_values("p").reset_index(drop=True)
    df["padj"]=np.empty(m); df["padj"].values[order]=adj
    return df

METABOLIC_KW=re.compile(
    r"metabolis|glycol|gluconeogen|citrate|tricarboxylic|oxidative phosphorylation|electron transport|"
    r"fatty acid|lipid|amino acid|nucleotide|one-carbon|carbohydrate|energy|respiration|ferment|"
    r"pyruvate|organic acid|detoxification", re.I)

def main():
    res_p, up_p, down_p = run_de("CBD_IC50","DMSO","primary","CBD_IC50 vs DMSO")
    res_s, up_s, down_s = run_de("CBD_IC50_Serum_starvation_16h","DMSO_Serum_starvation","sensitivity","CBD_IC50_SS vs DMSO_SS")
    up_set=set(up_p.index); down_set=set(down_p.index)
    background=set(genes)

    go_map, go_src = load_go_bp_map()
    go_report={}
    if go_map:
        print(f"\n[GO:BP] mapping source: {go_src}  ({len(go_map)} ens->GO:BP records)")
        up_ora=ora(up_set,background,go_map); down_ora=ora(down_set,background,go_map)
        up_ora.to_csv(f"{OUT}/go_bp_up.csv",index=False); down_ora.to_csv(f"{OUT}/go_bp_down.csv",index=False)
        for name,oda in [("UP",up_ora),("DOWN",down_ora)]:
            met=oda[oda["name"].astype(str).str.contains(METABOLIC_KW)]
            sig=oda[oda["padj"]<PADJ_TH]; sigmet=met[met["padj"]<PADJ_TH]
            print(f"\n[GO:BP {name}] terms={len(oda)} sig(padj<.05)={len(sig)} "
                  f"metabolic_terms={len(met)} sig_metabolic={len(sigmet)}")
            top=sigmet.head(8) if len(sigmet) else sig.head(8)
            for _,r in top.iterrows():
                print(f"    {r['GO']:12s} padj={r['padj']:.2e} n={int(r['DE_in'])}/{int(r['term_size'])}  {str(r['name'])[:60]}")
            go_report[name]={"terms":len(oda),"sig":len(sig),"metabolic_terms":len(met),
                             "sig_metabolic":len(sigmet)}
    else:
        print(f"\n[GO:BP] {go_src}")
        print("[GO:BP] SKIPPED: no Ensembl->GO:BP mapping reachable "
              "(no R/Bioconductor, no local annotation file, no network).")

    n_up,n_down=len(up_set),len(down_set)
    s_up,s_down=len(up_s),len(down_s)
    # robustness of the primary up:down balance across filter/offset variants
    print("\n[robustness] primary CBD_IC50 vs DMSO up:down under variants:")
    for off,fn in [(1.0,6),(0.5,6),(1.0,3),(1.0,10)]:
        k=(cpm>=1).sum(axis=1)>=fn; lc=np.log2(cpm[k]+off)
        X=lc[:,cols_for('CBD_IC50')]; Y=lc[:,cols_for('DMSO')]
        n1,n2=X.shape[1],Y.shape[1]; m1,m2=X.mean(1),Y.mean(1)
        v1,v2=X.var(1,ddof=1),Y.var(1,ddof=1); dof=n1+n2-2
        sp2=((n1-1)*v1+(n2-1)*v2)/dof; d0=4.0; s0=np.median(sp2)
        s2=(d0*s0+dof*sp2)/(d0+dof); se=np.sqrt(s2*(1/n1+1/n2)); lfc=m1-m2
        p=2*stats.t.sf(np.abs(lfc/se),d0+dof); o=np.argsort(p); m=len(p); pv=p[o]
        bh=pv*np.arange(1,m+1)/m; adj=np.minimum.accumulate(bh[::-1])[::-1]
        padj=np.empty(m); padj[o]=adj; sig=(padj<0.05)&(np.abs(lfc)>0.5)
        print(f"   log2(CPM+{off}) filt>={fn}: UP={int((sig&(lfc>0.5)).sum())} DOWN={int((sig&(lfc<-0.5)).sum())}")
    print("\n"+"="*70)
    print("DECISION  criterion: (1) # sig DE genes/direction; (2) # sig metabolic BP terms/direction;")
    print("                  (3) overlap of each direction with metabolic BP genes")
    print(f"  (1) PRIMARY  CBD_IC50 vs DMSO:        UP={n_up}  DOWN={n_down}  ratio={n_up/max(n_down,1):.2f}x")
    print(f"      SENSITIVITY CBD_IC50_SS vs DMSO_SS: UP={s_up}  DOWN={s_down}  ratio={s_up/max(s_down,1):.2f}x")
    if go_map:
        print(f"  (2) # sig metabolic BP terms:  UP={go_report['UP']['sig_metabolic']}  "
              f"DOWN={go_report['DOWN']['sig_metabolic']}")
        print(f"  (3) metabolic BP gene overlap:  UP={go_report['UP']['sig_metabolic']}  DOWN={go_report['DOWN']['sig_metabolic']}")
    else:
        print("  (2) # sig metabolic BP terms:  NOT COMPUTED (no GO:BP mapping available offline)")
        print("  (3) metabolic BP gene overlap: NOT COMPUTED (no GO:BP mapping available offline)")
    print("="*70)
    concl = ("UPREGULATION is the marginally dominant direction of the clean CBD-vs-vehicle "
             "response (consistent ~1.2x up:down across variants), but the response is broad and "
             "near-balanced; the matched serum-starvation contrast tilts DOWN. A definitive "
             "up-vs-down attribution to METABOLIC (GO:BP) terms requires the GO:BP enrichment, "
             "which was infeasible offline (no R/Bioconductor, no local annotation, no network).")
    print("CONCLUSION:", concl)
    with open(f"{OUT}/summary.json","w") as f:
        json.dump({"primary":{"up":n_up,"down":n_down},"sensitivity":{"up":s_up,"down":s_down},
                   "go_source":go_src,"go_available":bool(go_map),"conclusion":concl},f,indent=2)
    print(f"\n[done] outputs in {OUT}/")

if __name__=="__main__":
    main()
