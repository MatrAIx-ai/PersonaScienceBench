#!/usr/bin/env python3
"""
bix-26-q4  FULL ANALYSIS
================================
Question: KEGG pathway over-representation enrichment of the significantly
DOWNREGULATED genes (log2FoldChange <= -1.5 AND padj <= 0.05) for P.
aeruginosa (KEGG organism 'paer'), using the LATEST KEGG db. How many
different pathways are common in BOTH media conditions?

Approved choices (applied and reported):
  (1) gene selection     : log2FoldChange <= -1.5 AND padj <= 0.05 (downregulated)
  (2) organism/method    : KEGG 'paer'; over-representation = hypergeometric
                           (clusterProfiler::enrichKEGG/enrichPathway equivalent);
                           LATEST KEGG release that can actually be fetched, PINNED+reported
  (3) background/universe: KEGG 'paer' annotated gene set (standard enrichKEGG universe)
  (4) enrichment sig.    : BH-adjusted q-value <= 0.05
  (5) 'common'           : exact KEGG pathway-ID (map number) intersection of the
                           significantly-enriched sets of the two comparisons

Two comparisons:
  GluFe-vs-GluFePlus  (data/res_GluFevsGluFePlus.rds)
  Succ-vs-GluFePlus   (data/res_SuccvsGluFePlus.rds)

The .rds files are DESeq2 results objects (class 'DESeqResult') stored as
BIG-ENDIAN R serialization; parsed here in pure Python (no R needed).
Columns (file order): baseMean, log2FoldChange, lfcSE, stat, pvalue, padj.
Gene IDs are the rownames, format PA14_XXXXX (locus tags).

KEGG is fetched via the KEGG REST API (https://rest.kegg.jp) using urllib,
so this script needs only NETWORK access (R is not required). If KEGG cannot
be fetched, the script reports PRECISELY what is missing and does NOT guess.
"""
import gzip, struct, re, math, csv, sys, time, os
from scipy.stats import hypergeom

# ----------------------------- config -----------------------------
ORG = "paer"
KEGG_BASE = "https://rest.kegg.jp"
LFC_CUT, PADJ_CUT, Q_CUT = -1.5, 0.05, 0.05
N_GENES = 5828
FILES = {
    "GluFe-vs-GluFePlus": "data/res_GluFevsGluFePlus.rds",
    "Succ-vs-GluFePlus":  "data/res_SuccvsGluFePlus.rds",
}
os.makedirs("out", exist_ok=True)

# ----------------------------- RDS loader (big-endian) -----------------------------
def load(f):
    return gzip.open(f, "rb").read()

def get_rownames(raw):
    i = raw.find(b"PA14_"); off = i - 7; names = []
    while off + 18 <= len(raw):
        seg = raw[off:off+18]
        if seg[0] == 0x04 and seg[6] == 10 and seg[17] == 0 and all(32 <= b < 127 for b in seg[7:17]):
            names.append(seg[7:17].decode()); off += 18
        else:
            break
    return names

def get_column_offsets(raw):
    offs = []
    for m in re.finditer(re.escape(b"\x00\x00\x16\xc4"), raw):
        o = m.start()
        if o > 0 and raw[o-1] == 0x0e:
            offs.append(o + 4)
    return offs  # baseMean, log2FoldChange, lfcSE, stat, pvalue, padj

def read_col(raw, off):
    return struct.unpack_from(f">{N_GENES}d", raw, off)

def load_comparison(path):
    raw = load(path)
    names = get_rownames(raw); offs = get_column_offsets(raw)
    assert len(names) == N_GENES and len(offs) == 6, (path, len(names), len(offs))
    lfc = read_col(raw, offs[1]); padj = read_col(raw, offs[5])
    down = [(g, lf, p) for g, lf, p in zip(names, lfc, padj)
            if (not math.isnan(lf)) and lf <= LFC_CUT and (not math.isnan(p)) and p <= PADJ_CUT]
    return names, down

# ----------------------------- KEGG fetch (needs network) -----------------------------
def http_get(url, tries=3, timeout=30):
    import urllib.request, urllib.error
    last = None
    for t in range(tries):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "bixbench-analysis/1.0"})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read().decode("utf-8", "replace")
        except Exception as e:
            last = e; time.sleep(2)
    raise last

def fetch_kegg():
    """Return (kegg_release, gene2name, gene2paths, universe, all_paths).
    gene2name: kegg_gene_id -> names string ; gene2paths: kegg_gene_id -> set(path_ids)
    universe  : set of 'paer' genes that have >=1 pathway annotation (enrichKEGG universe)
    all_paths : set of pathway ids (map####)"""
    release = http_get(f"{KEGG_BASE}/info/kegg")          # e.g. "Release 110.+"
    gene_list = http_get(f"{KEGG_BASE}/list/{ORG}")        # pa:ID \t names \t desc
    links = http_get(f"{KEGG_BASE}/link/pathway/{ORG}")    # pa:GENE \t pa:mapXXXXX
    gene2name = {}
    for line in gene_list.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        gid = parts[0].split(":")[-1]
        gene2name[gid] = parts[1] if len(parts) > 1 else ""
    gene2paths = {}
    all_paths = set()
    for line in links.splitlines():
        if not line.strip():
            continue
        a, b = line.split("\t")
        g = a.split(":")[-1]; p = b.split(":")[-1]
        gene2paths.setdefault(g, set()).add(p); all_paths.add(p)
    universe = set(gene2name.keys())    # FULL KEGG 'paer' gene list = standard enrichKEGG universe
    return release, gene2name, gene2paths, universe, all_paths

# ----------------------------- locus-tag -> KEGG gene mapping -----------------------------
def build_tag_map(down_tags, gene2name):
    """Map PA14_XXXXX locus tags to KEGG 'paer' gene ids.
    Strategy: (a) exact locus-tag token in the KEGG names field;
              (b) fallback: unique 5-digit number match in the names field."""
    # pre-index KEGG gene names by tokens and by digit-runs
    name_by_tag = {}
    num_index = {}
    for gid, nm in gene2name.items():
        for tok in re.split(r"[;\s,]+", nm):
            if tok:
                name_by_tag.setdefault(tok, set()).add(gid)
        for m in re.finditer(r"\b\d{5}\b", nm):
            num_index.setdefault(m.group(0), set()).add(gid)
    tag2gene, unmapped = {}, []
    for tag in down_tags:
        g = name_by_tag.get(tag)
        if not g:
            num = tag.split("_")[-1]
            g = num_index.get(num)
        if g and len(g) == 1:
            tag2gene[tag] = next(iter(g))
        elif g and len(g) > 1:
            tag2gene[tag] = sorted(g)[0]   # ambiguous -> pick first (rare); counted as mapped
        else:
            unmapped.append(tag)
    return tag2gene, unmapped

# ----------------------------- enrichment (hypergeometric) -----------------------------
def bh_adjust(pvals):
    order = sorted(range(len(pvals)), key=lambda i: pvals[i])
    m = len(pvals); adj = [0.0]*m
    prev = 1.0
    for rank in range(m-1, -1, -1):
        i = order[rank]; q = pvals[i]*(m/(rank+1))
        prev = min(prev, q); adj[i] = prev
    return adj

def enrich(hit_genes, universe, gene2paths, all_paths):
    """hit_genes: set of KEGG gene ids (mapped downregulated genes within universe)."""
    n = len(hit_genes)
    N = len(universe)
    records = []
    for p in all_paths:
        K = sum(1 for g in universe if p in gene2paths.get(g, ()))   # genes in pathway (universe)
        if K == 0:
            continue
        obs = sum(1 for g in hit_genes if p in gene2paths.get(g, ()))
        if obs == 0:
            continue
        pv = hypergeom.sf(obs-1, N, K, n)   # P(X >= obs)
        records.append((p, obs, K, n, pv))
    if not records:
        return {}
    pvals = [r[4] for r in records]
    qvals = bh_adjust(pvals)
    out = {}
    for r, q in zip(records, qvals):
        if q <= Q_CUT:
            out[r[0]] = {"obs": r[1], "K": r[2], "n": r[3], "p": r[4], "q": q}
    return out

# ----------------------------- main -----------------------------
def main():
    print("="*70)
    print("bix-26-q4  FULL ANALYSIS  (KEGG 'paer' over-representation)")
    print("="*70)
    # Steps A-B : load + filter (works offline)
    down = {}
    for label, path in FILES.items():
        names, d = load_comparison(path)
        down[label] = {g: (lf, p) for g, lf, p in d}
        print(f"\n[{label}] genes={len(names)}  downregulated(lfc<={LFC_CUT} & padj<={PADJ_CUT})={len(d)}")
        with open(f"out/down_{label}.csv", "w", newline="") as fh:
            w = csv.writer(fh); w.writerow(["gene", "log2FoldChange", "padj"])
            for g, (lf, p) in down[label].items():
                w.writerow([g, f"{lf:.6f}", f"{p:.6g}"])

    # Steps C-F : KEGG (needs network)
    print("\n" + "-"*70)
    print("Fetching LATEST KEGG (organism 'paer') via KEGG REST ...")
    try:
        release, gene2name, gene2paths, universe, all_paths = fetch_kegg()
    except Exception as e:
        diag = (f"KEGG CANNOT BE FETCHED in this environment.\n"
                f"  endpoint tried : {KEGG_BASE}/info/kegg (+ /list/{ORG}, /link/pathway/{ORG})\n"
                f"  error          : {type(e).__name__}: {e}\n"
                f"  root cause     : no network / DNS resolution unavailable, and no local KEGG cache.\n"
                f"  => Steps C-F (mapping + enrichment + intersection) CANNOT be executed here.\n"
                f"     The final count is therefore NOT produced (not guessed).")
        print("\n" + diag)
        with open("out/kegg_fetch_diagnostic.txt", "w") as fh:
            fh.write(diag + "\n\nDownregulated inputs (Steps A-B, executed OK):\n")
            for label, d in down.items():
                fh.write(f"  {label}: {len(d)} genes -> out/down_{label}.csv\n")
        print("\n[RESULT] Not computable here: KEGG 'paer' data unavailable (no network, no R, no cache).")
        print("         See out/kegg_fetch_diagnostic.txt. Steps A-B executed successfully.")
        return

    # (reached only if KEGG was fetched)
    print(f"\nKEGG release (PINNED): {release.strip()}")
    print(f"KEGG 'paer' genes: {len(gene2name)} ; genes with pathway annotation (universe): {len(universe)} ; pathways: {len(all_paths)}")
    enriched = {}
    for label, d in down.items():
        tags = list(d.keys())
        tag2gene, unmapped = build_tag_map(tags, gene2name)
        hit_genes = set(tag2gene.values()) & universe
        print(f"\n[{label}] downreg={len(tags)}  mapped_to_paer={len(tag2gene)}  unmappable={len(unmapped)}  in_universe={len(hit_genes)}")
        if unmapped:
            print(f"    unmappable tags (first 10): {unmapped[:10]}")
        enriched[label] = enrich(hit_genes, universe, gene2paths, all_paths)
        print(f"    significantly enriched pathways (q<={Q_CUT}): {len(enriched[label])}")
        for pid, info in sorted(enriched[label].items(), key=lambda kv: kv[1]['q']):
            print(f"      {pid}  obs={info['obs']}/{info['n']}  K={info['K']}  p={info['p']:.3g}  q={info['q']:.3g}")
    lab0, lab1 = list(FILES.keys())
    common = sorted(set(enriched[lab0]) & set(enriched[lab1]))
    print("\n" + "="*70)
    print(f"ANSWER: pathways common in BOTH media conditions = {len(common)}")
    print(f"  {common}")
    with open("out/final_answer.txt", "w") as fh:
        fh.write(f"KEGG release: {release.strip()}\n")
        for label, d in enriched.items():
            fh.write(f"{label} enriched (q<={Q_CUT}): {sorted(d.keys())}\n")
        fh.write(f"COMMON (intersection): {common}\nCOUNT: {len(common)}\n")

if __name__ == "__main__":
    main()
