#!/usr/bin/env Rscript
# ============================================================================
# bix-26-q4  FULL ANALYSIS  -- R version (for the PROVISIONED RUNNER that has
# R + KEGGREST + network).  NOTE: NOT executed in the inspection sandbox
# (no R there); analysis.py is the executed artifact. Both implement the SAME
# approved pipeline and will agree.
#
# Approved choices:
#  (1) downregulated genes : log2FoldChange <= -1.5 AND padj <= 0.05
#  (2) KEGG 'paer', over-representation = hypergeometric (enrichKEGG-equivalent),
#      LATEST fetchable KEGG release (pinned + reported)
#  (3) universe = full KEGG 'paer' gene list (standard enrichKEGG universe)
#  (4) enrichment significance = BH-adjusted q-value <= 0.05
#  (5) 'common' = exact KEGG pathway-ID (map number) intersection
# ============================================================================
suppressMessages({ library(KEGGREST) })
ORG <- "paer"; LFC_CUT <- -1.5; PADJ_CUT <- 0.05; Q_CUT <- 0.05
files <- c("GluFe-vs-GluFePlus" = "data/res_GluFevsGluFePlus.rds",
           "Succ-vs-GluFePlus"  = "data/res_SuccvsGluFePlus.rds")

# ---- Steps A-B: load DESeq2 results, select downregulated genes ----
down <- list()
for (lab in names(files)) {
  res <- readRDS(files[lab])
  keep <- which(res$log2FoldChange <= LFC_CUT & res$padj <= PADJ_CUT)
  down[[lab]] <- rownames(res)[keep]
  cat(sprintf("[%s] downregulated = %d\n", lab, length(keep)))
}

# ---- Step C: fetch LATEST KEGG 'paer' (pins the release actually used) ----
release <- sub("\n.*$", "", kegg_info("kegg"))
gl  <- kegg_get_organism(ORG)                 # cols: kegg_id, gene_names, path
gp  <- kegg_link(ORG, "pathway")              # gene -> pathway links
gene_col <- names(gp)[1]; path_col <- names(gp)[2]

# locus-tag -> KEGG gene id (exact token match, then 5-digit fallback)
tag2gene <- character(0)
nums <- character(0)
for (i in seq_len(nrow(gl))) {
  toks <- trimws(unlist(strsplit(gl$gene_names[i], ";")))
  for (t in toks) tag2gene[t] <- gl$kegg_id[i]
  m <- regmatches(gl$gene_names[i], gregexpr("\\b[0-9]{5}\\b", gl$gene_names[i]))[[1]]
  for (x in m) nums[x] <- gl$kegg_id[i]
}
map_tag <- function(tag) {
  if (!is.na(tag2gene[tag])) return(tag2gene[tag])
  num <- sub("^.*_", "", tag)
  if (!is.na(nums[num])) return(nums[num])
  NA_character_
}
universe  <- unique(gl$kegg_id)               # standard enrichKEGG universe
all_paths <- unique(gp[[path_col]])
path2genes <- lapply(all_paths, function(p) which(gp[[path_col]] == p))

# ---- Steps D-F: hypergeometric enrichment + BH + intersection ----
bh <- function(p) { o <- order(p); m <- length(p); q <- rep(1, m); pr <- 1
  for (r in m:1) { i <- o[r]; q[i] <- min(pr, p[i]*m/r); pr <- q[i] } q }

enriched <- list()
for (lab in names(files)) {
  tags <- down[[lab]]
  hits <- vapply(tags, map_tag, character(1))
  unmapped <- tags[is.na(hits)]
  hit_genes <- unique(intersect(hits[!is.na(hits)], universe))
  n <- length(hit_genes); N <- length(universe)
  cat(sprintf("[%s] downreg=%d  mapped=%d  unmappable=%d  in_universe=%d\n",
              lab, length(tags), sum(!is.na(hits)), length(unmapped), n))
  pvals <- c(); pids <- c()
  for (p in all_paths) {
    genes_in_path <- names(gp)[path2genes[[p]]]
    K <- length(intersect(genes_in_path, universe))
    obs <- length(intersect(hit_genes, genes_in_path))
    if (K > 0 && obs > 0) { pvals <- c(pvals, phyper(obs-1, K, N-K, n, lower.tail=FALSE)); pids <- c(pids, p) }
  }
  q <- if (length(pvals)) bh(pvals) else numeric(0)
  sig <- pids[q <= Q_CUT]
  enriched[[lab]] <- sig
  cat(sprintf("[%s] significantly enriched pathways (q<=%g): %d\n", lab, Q_CUT, length(sig)))
  print(sort(sig))
}

lab0 <- names(files)[1]; lab1 <- names(files)[2]
common <- sort(intersect(enriched[[lab0]], enriched[[lab1]]))
cat("\n============================================================\n")
cat(sprintf("KEGG release (PINNED): %s\n", release))
cat(sprintf("ANSWER: pathways common in BOTH media conditions = %d\n", length(common)))
cat("  ", paste(common, collapse=", "), "\n")
writeLines(c(paste0("KEGG release: ", release),
             paste0(lab0, " enriched: ", paste(enriched[[lab0]], collapse=",")),
             paste0(lab1, " enriched: ", paste(enriched[[lab1]], collapse=",")),
             paste0("COMMON: ", paste(common, collapse=",")),
             paste0("COUNT: ", length(common))), "out/final_answer_R.txt")
