#!/usr/bin/env python3
"""
TASK008 BCG-CORONA: odds ratio of BCG vaccination on COVID-19 severity,
ordinal (proportional-odds) logistic regression, adjusted for prior medical
history count and patient-interaction frequency, with interaction terms.

Primary specification (researcher-approved plan):
  outcome    : subject-level MAX AESEV over AEPT=='COVID-19' AE rows,
               categories 1-4 (mild/moderate/severe/life-threatening);
               subjects with no non-missing severity excluded (n=148)
  model      : proportional-odds (partial) ordinal logit,
               logit P(Y<=k) = alpha_k - X.beta, same beta for k=1,2,3,
               fitted by direct maximum likelihood (numpy/scipy).
               (No R and no internet package installs in this environment.)
  predictors : BCG (0/1), mh_count = #MHTERM rows with MHORRES==2,
               pseen = patients_seen (1-50=1, 51-100=2, >100=3)
  interactions: BCG:pseen and BCG:mh_count

Convention for reported odds ratios:
  exp(beta)   = common OR of being in category <= k (lower severity)
  1/exp(beta) = common OR of being in a HIGHER severity category.
  Headline 'OR of BCG on severity' = exp(-beta_BCG) = OR for higher severity.
"""
import warnings
import numpy as np
import pandas as pd
from scipy.special import expit
from scipy.optimize import minimize
from scipy.stats import chi2
import statsmodels.api as sm

warnings.simplefilter("ignore", RuntimeWarning)
pd.set_option("display.width", 200)

dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv").set_index("USUBJID")
ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv")

dm["BCG"] = (dm["TRTGRP"] == "BCG").astype(int)
dm["pseen"] = dm["patients_seen"].map({"1-50": 1, "51-100": 2, ">100": 3})
dm["pseen_mid"] = dm["patients_seen"].map({"1-50": 25, "51-100": 75, ">100": 150})
dm["expect_interact"] = (dm["expect_interact"] == "Yes").astype(int)

t = mh[mh["MHTERM"].notna()]
std = t[~t["MHTERM"].str.startswith("Other:")]
oth = t[t["MHTERM"].str.startswith("Other:")]
dm["mh_a"] = mh.groupby("USUBJID").size()
dm["mh_b"] = t.groupby("USUBJID").size()
dm["mh_c"] = ((std.MHORRES == 2).groupby(std.USUBJID).sum()
              .add(oth.groupby(oth.USUBJID).size(), fill_value=0))

sev = ae[ae["AEPT"] == "COVID-19"].groupby("USUBJID").AESEV.max()
dm["sev"] = sev
d = dm.dropna(subset=["sev"]).reset_index()
d["sev"] = d["sev"].astype(int)
print(f"n infected subjects with non-missing max COVID-19 severity: {len(d)}")
print("severity counts by arm:\n", pd.crosstab(d.sev, d.BCG))

def log_phi(z):
    return -np.logaddexp(0, -z)

def po_nll(theta, y, X, K=3, pen=1e4):
    alpha, beta = theta[:K], theta[K:]
    z = X @ beta
    nll = 0.0
    for i in range(len(y)):
        j = y[i]
        if j == 1:
            nll -= log_phi(alpha[0] - z[i])
        elif j == K + 1:
            nll -= log_phi(z[i] - alpha[K - 1])
        else:
            hi = log_phi(alpha[j - 1] - z[i])
            lo = log_phi(alpha[j - 2] - z[i])
            dd = lo - hi
            nll += pen if dd > -1e-12 else -(hi + np.log1p(-np.exp(dd)))
    return nll

def po_grad(theta, y, X, K=3):
    """Gradient of the NEGATIVE log-likelihood."""
    alpha, beta = theta[:K], theta[K:]
    z = X @ beta
    g_a = np.zeros(K); g_b = np.zeros_like(beta)
    for i in range(len(y)):
        j = y[i]
        pi = np.array([0.0] + [expit(alpha[k] - z[i]) for k in range(K)] + [1.0])
        p = pi[j] - pi[j - 1]
        for k in range(K):
            c = int(k + 1 == j) - int(k + 1 == j - 1)
            if c:
                dd = pi[k + 1] * (1 - pi[k + 1]) * c / p
                g_a[k] += -dd
                g_b += dd * X[i]
    return np.concatenate([g_a, g_b])

def hessian_nll(theta, y, X, K=3):
    f0 = po_nll(theta, y, X, K)
    n = len(theta); H = np.zeros((n, n)); h = 1e-5
    for i in range(n):
        for j in range(i, n):
            if i == j:
                tp = theta.copy(); tp[i] += h
                tm = theta.copy(); tm[i] -= h
                H[i, j] = (po_nll(tp, y, X, K) - 2 * f0 + po_nll(tm, y, X, K)) / h**2
            else:
                tpp = theta.copy(); tpp[i] += h; tpp[j] += h
                tpm = theta.copy(); tpm[i] += h; tpm[j] -= h
                tmp = theta.copy(); tmp[i] -= h; tmp[j] += h
                tmn = theta.copy(); tmn[i] -= h; tmn[j] -= h
                H[i, j] = (po_nll(tpp, y, X, K) - po_nll(tpm, y, X, K)
                           - po_nll(tmp, y, X, K) + po_nll(tmn, y, X, K)) / (4 * h * h)
            H[j, i] = H[i, j]
    return H

def fit_po(y, X, K=3, starts=None):
    p = X.shape[1]
    if starts is None:
        ac = np.arange(K, dtype=float)
        starts = [np.concatenate([ac, np.zeros(p)]),
                  np.concatenate([ac, np.full(p, 0.1)]),
                  np.concatenate([ac, np.full(p, -0.3)]),
                  np.zeros(K + p)]
    best = None
    for s in starts:
        r = minimize(po_nll, s, args=(y, X, K), jac=po_grad, method="L-BFGS-B",
                     options=dict(maxiter=5000, gtol=1e-12))
        if best is None or r.fun < best.fun:
            best = r
    H = hessian_nll(best.x, y, X, K)
    return best, np.linalg.inv(H), H

def po_table(best, cov, names):
    beta = best.x[3:]
    se = np.sqrt(np.diag(cov)[3:])
    return pd.DataFrame({"term": names, "coef": beta, "se": se,
                         "OR_lower_or_equal": np.exp(beta),
                         "OR_higher_sev": np.exp(-beta),
                         "CI95_higher_lo": np.exp(-beta - 1.96 * se),
                         "CI95_higher_hi": np.exp(-beta + 1.96 * se)})

# ----------------------------------------------------------------------------
# Validation of the MLE implementation
# ----------------------------------------------------------------------------
print("\n=== Validation ===")
y2 = (d.sev >= 3).astype(int)
Xv = np.column_stack([d.BCG.values])
r1, c1, _ = fit_po(y2 + 1, Xv, K=1)
m1 = sm.Logit(y2, sm.add_constant(Xv)).fit(disp=0)
print(f"K=1: MLE (alpha,beta) = {np.round(r1.x,4)} | statsmodels (const,beta) = "
      f"{np.round(np.asarray(m1.params),4)}  [alpha should equal -const]")
Xc = d[["BCG", "mh_c", "pseen"]].values.astype(float)
th0 = np.array([0.2, 1.1, 2.0, 0.1, -0.05, 0.05])
g = po_grad(th0, d.sev.values, Xc)
gn = np.zeros_like(th0); h = 1e-6
for i in range(len(th0)):
    tp = th0.copy(); tp[i] += h
    tm = th0.copy(); tm[i] -= h
    gn[i] = (po_nll(tp, d.sev.values, Xc) - po_nll(tm, d.sev.values, Xc)) / (2 * h)
print(f"gradient check max|analytic-numeric| = {np.abs(g - gn).max():.2e}")

# ----------------------------------------------------------------------------
# PRIMARY model
# ----------------------------------------------------------------------------
d["BCG_pseen"] = d.BCG * d.pseen
d["BCG_mh"] = d.BCG * d.mh_c
cols = ["BCG", "mh_c", "pseen", "BCG_pseen", "BCG_mh"]
y = d.sev.values
X = d[cols].values.astype(float)

best, cov, H = fit_po(y, X)
tab = po_table(best, cov, cols)
print("\n=== PRIMARY proportional-odds model (n=%d) ===" % len(y))
print("converged:", best.success, "| neg-loglik:", round(best.fun, 3),
      "| Hessian cond:", f"{np.linalg.cond(H):.1f}")
print(tab.to_string(index=False, float_format=lambda v: f"{v: .4f}"))
print("cutpoint alphas:", np.round(best.x[:3], 3))

# global-optimality check: 25 random starts
rng = np.random.default_rng(42)
nlls = [best.fun]
for _ in range(25):
    s = rng.uniform(-2, 2, size=3 + X.shape[1])
    rr = minimize(po_nll, s, args=(y, X, 3), jac=po_grad, method="L-BFGS-B",
                  options=dict(maxiter=3000, gtol=1e-12))
    nlls.append(rr.fun)
print(f"multi-start check: best negll across 26 starts = {min(nlls):.3f} "
      f"(primary = {best.fun:.3f}) -> "
      + ("global optimum confirmed" if min(nlls) >= best.fun - 1e-6 else "PRIMARY FIT IS NOT GLOBAL!"))
b = best.x[3:]; se = np.sqrt(np.diag(cov)[3:])
iB, iM, iP, iBP, iBM = 0, 1, 2, 3, 4
def or_higher_at(mh, ps):
    ln = b[iB] + b[iBM] * mh + b[iBP] * ps
    s = np.sqrt(se[iB]**2 + (mh * se[iBM])**2 + (ps * se[iBP])**2)
    return np.exp(-ln), np.exp(-ln - 1.96 * s), np.exp(-ln + 1.96 * s)
print("\nHeadline BCG OR for HIGHER severity (common PO OR):")
print(f"  at reference (mh_count=0, pseen=1): "
      f"{np.exp(-b[iB]):.3f}  95% CI {np.exp(-b[iB]-1.96*se[iB]):.3f}-{np.exp(-b[iB]+1.96*se[iB]):.3f}")
p, lo, hi = or_higher_at(d.mh_c.median(), d.pseen.median())
print(f"  at medians (mh={d.mh_c.median():.0f}, pseen={d.pseen.median():.2f}): {p:.3f}  95% CI {lo:.3f}-{hi:.3f}")
p, lo, hi = or_higher_at(d.mh_c.mean(), d.pseen.mean())
print(f"  at means   (mh={d.mh_c.mean():.2f}, pseen={d.pseen.mean():.2f}): {p:.3f}  95% CI {lo:.3f}-{hi:.3f}")
print(f"Interaction ORs (higher severity): BCG:pseen = {np.exp(-b[iBP]):.3f} "
      f"(95% CI {np.exp(-b[iBP]-1.96*se[iBP]):.3f}-{np.exp(-b[iBP]+1.96*se[iBP]):.3f}); "
      f"BCG:mh_count = {np.exp(-b[iBM]):.3f} "
      f"(95% CI {np.exp(-b[iBM]-1.96*se[iBM]):.3f}-{np.exp(-b[iBM]+1.96*se[iBM]):.3f})")
print(f"Main-effect ORs (higher severity): mh_count = {np.exp(-b[iM]):.3f}, "
      f"pseen = {np.exp(-b[iP]):.3f}")

# ----------------------------------------------------------------------------
# Proportional-odds assumption checks
# ----------------------------------------------------------------------------
print("\n=== Proportional-odds checks ===")
Xs = sm.add_constant(d[cols])
B = []; V = []; status = []
for k in (1, 2, 3):
    ok = False
    for method in ("newton", "bfgs"):
        try:
            m = sm.Logit((y <= k).astype(float), Xs).fit(disp=0, maxiter=2000,
                                                         method=method)
            if m.mle_retvals["converged"] and np.all(np.isfinite(m.params)):
                B.append(np.asarray(m.params)[1:])
                V.append(np.asarray(m.cov_params())[1:, 1:])
                status.append(f"y<={k}: converged ({method})")
                ok = True
                break
        except Exception:
            pass
    if not ok:
        B.append(np.full(X.shape[1], np.nan))
        V.append(np.full((X.shape[1], X.shape[1]), np.nan))
        status.append(f"y<={k}: MLE AT BOUNDARY (quasi-separation; no finite MLE)")
if bool(np.isfinite(np.array(V)).all()):
    Vi = np.array([np.linalg.inv(v) for v in V])
    Vbar = np.linalg.inv(np.sum(Vi, axis=0))
    Bbar = Vbar @ sum(Vi[k] @ B[k] for k in range(3))
    brant = sum(float((B[k] - Bbar) @ np.linalg.inv(V[k] + Vbar) @ (B[k] - Bbar))
                for k in range(3))
    df = X.shape[1] * 2
    print(f"Brant score test: chi2 = {brant:.2f}, df = {df}, p = {chi2.sf(brant, df):.3f}")
else:
    print("Brant score test: NOT COMPUTABLE - at least one per-cutpoint binary MLE is at the")
    print("boundary (quasi-separation), so Brant's Wald-type statistic is undefined.")
for idx, k in enumerate((1, 2, 3)):
    beta_k = float(B[idx][0]); se_k = float(np.sqrt(V[idx][0, 0]))
    ors = (f"OR_higher {np.exp(-beta_k): .3f} (95% CI {np.exp(-beta_k-1.96*se_k): .3f}-"
           f"{np.exp(-beta_k+1.96*se_k): .3f})") if np.isfinite(beta_k) else "OR_higher diverges"
    print(f"  per-cutpoint BCG: {status[idx]} | beta = {beta_k: .3f} (se {se_k: .3f}) -> {ors}")

def partial_nll(theta, y, X, K=3, pen=1e4):
    alpha, Bp = theta[:K], theta[K:].reshape(K, -1)
    nll = 0.0
    for i in range(len(y)):
        j = y[i]
        if j == 1:
            nll -= log_phi(alpha[0] - X[i] @ Bp[0])
        elif j == K + 1:
            nll -= log_phi(X[i] @ Bp[K - 1] - alpha[K - 1])
        else:
            hi = log_phi(alpha[j - 1] - X[i] @ Bp[j - 1])
            lo = log_phi(alpha[j - 2] - X[i] @ Bp[j - 2])
            dd = lo - hi
            nll += pen if dd > -1e-12 else -(hi + np.log1p(-np.exp(dd)))
    return nll

def partial_grad(theta, y, X, K=3):
    alpha, Bp = theta[:K], theta[K:].reshape(K, -1)
    ga = np.zeros(K); gb = np.zeros_like(Bp)
    for i in range(len(y)):
        j = y[i]
        pi = np.array([0.0] + [expit(alpha[k] - X[i] @ Bp[k]) for k in range(K)] + [1.0])
        p = pi[j] - pi[j - 1]
        for k in range(K):
            c = int(k + 1 == j) - int(k + 1 == j - 1)
            if c:
                dd = pi[k + 1] * (1 - pi[k + 1]) * c / p
                ga[k] += -dd
                gb[k] += dd * X[i]
    return np.concatenate([ga, gb.ravel()])

start_p = np.concatenate([best.x[:3], np.tile(best.x[3:], 3)])
res_p = minimize(partial_nll, start_p, args=(y, X, 3), jac=partial_grad,
                 method="L-BFGS-B", options=dict(maxiter=8000, gtol=1e-12))
lrt = 2 * (res_p.fun - best.fun)
if lrt >= 0:
    print(f"Partial-odds LRT: converged={res_p.success}, chi2 = {lrt:.2f}, df = {2 * X.shape[1]}, "
          f"p = {chi2.sf(lrt, 2 * X.shape[1]):.4f}")
else:
    bp = res_p.x[3:].reshape(3, -1)
    print(f"Partial-odds model (cutpoint-specific slopes) fits substantially BETTER: "
          f"negll {res_p.fun:.1f} vs PO {best.fun:.1f} (delta = {-lrt:.2f}).")
    print("  The standard LRT is therefore not valid (the partial-odds MLE sits at/near the")
    print("  boundary due to quasi-separation in the top category; the statistic is negative).")
    print("  Per-cutpoint BCG coefs in the partial model:")
    for kk, name in enumerate(("y<=1", "y<=2", "y<=3")):
        print(f"    {name}: BCG beta = {bp[kk][0]: .3f} (OR_higher = {np.exp(-bp[kk][0]): .3f})")

# ----------------------------------------------------------------------------
# Sensitivities
# ----------------------------------------------------------------------------
def run_model(dd, c, label):
    yv = dd.sev.values
    Xv = dd[c].values.astype(float)
    r, cv, Hv = fit_po(yv, Xv)
    tb = po_table(r, cv, c)
    print(f"\n--- {label} (n={len(yv)}, converged={r.success}, negll={r.fun:.1f}) ---")
    print(tb.to_string(index=False, float_format=lambda v: f"{v: .3f}"))
    # BCG OR for higher severity at the median of every non-BCG covariate in the model
    bb = r.x[3:]; sev_ = np.sqrt(np.diag(cv)[3:])
    # BCG effect = BCG main effect + interaction terms (covariate main effects cancel)
    ln = bb[0]
    s2 = sev_[0] ** 2
    meddesc = []
    for j, cname in enumerate(c[1:], start=1):
        if cname.startswith("BCG_"):
            base = {"BCG_pseen": "pseen", "BCG_mh": "mh_c", "BCG_mha": "mh_a",
                    "BCG_mhb": "mh_b", "BCG_exint": "expect_interact"}[cname]
            val = float(np.median(dd[base]))          # BCG=1 at median base value
            ln += bb[j] * val
            s2 += (bb[j] * val) ** 2
            meddesc.append(f"{base}={val:g}")
        else:
            meddesc.append(f"{cname}={float(np.median(dd[cname])):g}")
    orv, l, h = np.exp(-ln), np.exp(-ln - 1.96 * np.sqrt(s2)), np.exp(-ln + 1.96 * np.sqrt(s2))
    print(f"  BCG OR higher severity at covariate medians "
          f"({', '.join(dict.fromkeys(meddesc))}): {orv:.3f}  95% CI {l:.3f}-{h:.3f}")
    return tb

print("\n=== Sensitivities ===")
d["BCG_mha"] = d.BCG * d.mh_a
run_model(d, ["BCG", "mh_a", "pseen", "BCG_pseen", "BCG_mha"],
          "S1: MH count = ALL MH rows per subject (34-42)")
d["BCG_mhb"] = d.BCG * d.mh_b
run_model(d, ["BCG", "mh_b", "pseen", "BCG_pseen", "BCG_mhb"],
          "S2: MH count = ALL MHTERM rows per subject (18-21)")
d["BCG_exint"] = d.BCG * d.expect_interact
run_model(d, ["BCG", "mh_c", "expect_interact", "BCG_exint", "BCG_mh"],
          "S3: expect_interact (Yes/No) instead of patients_seen")
co_ids = ae[ae["AEPT"] == "COVID-19"].USUBJID
d2 = dm.loc[co_ids.unique()].reset_index(); d2["sev"] = d2.sev.fillna(1).astype(int)
d2["BCG_pseen"] = d2.BCG * d2.pseen; d2["BCG_mh"] = d2.BCG * d2.mh_c
run_model(d2, ["BCG", "mh_c", "pseen", "BCG_pseen", "BCG_mh"],
          "S4: infected n=189, missing severity imputed as category 1 (n=%d)" % len(d2))
d3 = d.copy(); d3["pseen"] = d3.pseen_mid
d3["BCG_pseen"] = d3.BCG * d3.pseen
run_model(d3, ["BCG", "mh_c", "pseen", "BCG_pseen", "BCG_mh"],
          "S5: pseen coded by bin midpoints (25/75/150)")

# ----------------------------------------------------------------------------
# Quasi-separation diagnostics
# ----------------------------------------------------------------------------
print("\n=== Separation / small-cell diagnostics ===")
print("severity>=3 by arm:\n", pd.crosstab(d.sev >= 3, d.BCG))
top = d[d.sev >= 3]
print(f"severity>=3: n={len(top)} (BCG={int(top.BCG.sum())}); "
      f"mh_c range {top.mh_c.min():.0f}-{top.mh_c.max():.0f}, "
      f"pseen range {top.pseen.min():.0f}-{top.pseen.max():.0f}")
print(f"subjects with mh_c==0: {int((d.mh_c == 0).sum())}; "
      f"BCG=1 & pseen=3: {int(((d.BCG == 1) & (d.pseen == 3)).sum())}; "
      f"BCG=1 & pseen=3 & sev>=3: {int(((d.BCG == 1) & (d.pseen == 3) & (d.sev >= 3)).sum())}")
print(f"Hessian condition number (primary): {np.linalg.cond(H):.1f}")
