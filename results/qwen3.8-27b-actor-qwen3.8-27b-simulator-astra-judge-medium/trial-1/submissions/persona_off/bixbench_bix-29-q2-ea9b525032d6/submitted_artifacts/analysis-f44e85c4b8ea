"""
BixBench bix-29-q2 — Ordinal regression: independent effect of each additional
ongoing medical condition (MHONGO) on the odds of higher COVID-19 severity,
controlling for BCG vaccination status (TRTGRP) and patient interaction
variables (patients_seen, expect_interact).
"""
import numpy as np, pandas as pd
from scipy.stats import chi2 as chi2dist
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

# ---------- 1. Subject-level frame (n=1000) ----------
s = dm[['USUBJID','TRTGRP','patients_seen','expect_interact']].copy()
s['BCG'] = (s['TRTGRP'] == 'BCG').astype(int)
s['ps_51_100'] = (s['patients_seen'] == '51-100').astype(int)
s['ps_gt100']  = (s['patients_seen'] == '>100').astype(int)
s['expect_interact'] = (s['expect_interact'] == 'Yes').astype(int)

# ongoing medical conditions: MH condition rows (MHTERM) with MHONGO == 'Yes'
ongo = (mh[mh['MHONGO'] == 'Yes'].groupby('USUBJID').size()
          .rename('n_ongoing').reset_index())
s = s.merge(ongo, on='USUBJID', how='left')
s['n_ongoing'] = s['n_ongoing'].fillna(0).astype(int)

# primary outcome: per-subject max AESEV, 0 = no AE with severity recorded
ms = pd.DataFrame({'USUBJID': ae.groupby('USUBJID')['AESEV'].max().index,
                   'Y': ae.groupby('USUBJID')['AESEV'].max().values})
s = s.merge(ms, on='USUBJID', how='left')
s['Y'] = s['Y'].fillna(0).astype(int)

# sensitivity (a): severity from COVID-19-related AEs only
covid = ae[ae['AEPT'].astype(str).str.contains('COVID', case=False, na=False)]
mc = pd.DataFrame({'USUBJID': covid.groupby('USUBJID')['AESEV'].max().index,
                   'Y_covid': covid.groupby('USUBJID')['AESEV'].max().values})
s = s.merge(mc, on='USUBJID', how='left')
s['Y_covid'] = s['Y_covid'].fillna(0).astype(int)

# sensitivity (b): pool top levels 3 and 4
s['Y_pool34'] = np.minimum(s['Y'], 3)

print("n subjects:", len(s))
print("Y (0-4):", s['Y'].value_counts().sort_index().to_dict())
print("Y_covid (0-4):", s['Y_covid'].value_counts().sort_index().to_dict(),
      "| subjects with COVID-AE severity:", int((s['Y_covid']>0).sum()))
print("Y_pool34 (0-3):", s['Y_pool34'].value_counts().sort_index().to_dict())
print("n_ongoing dist:", s['n_ongoing'].value_counts().sort_index().to_dict())
print("BCG:", s['BCG'].value_counts().to_dict())
print("cor(n_ongoing, BCG):", round(s['n_ongoing'].corr(s['BCG']),3),
      "| cor(n_ongoing, Y):", round(s['n_ongoing'].corr(s['Y']),3))

X_cols = ['n_ongoing','BCG','ps_51_100','ps_gt100','expect_interact']

def fit_ordinal(y, X, label):
    r = OrderedModel(y.astype(float), X.astype(float), distr='logit').fit(method='bfgs', disp=0, maxiter=5000)
    print(f"\n===== {label} =====")
    print("converged:", bool(r.mle_retvals['converged']))
    ci = r.conf_int()
    out = pd.DataFrame({'coef': r.params, 'OR': np.exp(r.params),
                        'OR_lo': np.exp(ci[0]), 'OR_hi': np.exp(ci[1]),
                        'p': r.pvalues})
    print(out.round(4).to_string())
    return r, out

def brant(y, X, label):
    """Proportional-odds (Brant) test: equal covariate effects across cutpoints."""
    Xd = sm.add_constant(X.astype(float))
    K = int(np.max(y))
    fits = {k: sm.Logit((y <= k).astype(int), Xd).fit(disp=0, method='bfgs', maxiter=5000)
            for k in range(1, K)}
    b1, V1 = np.asarray(fits[1].params), np.asarray(fits[1].cov_params())
    W, dfW = 0.0, 0
    for k in range(2, K):
        bk, Vk = np.asarray(fits[k].params), np.asarray(fits[k].cov_params())
        d = bk - b1
        W += d @ np.linalg.inv(Vk + V1) @ d
        dfW += len(d)
    p = 1 - chi2dist.cdf(W, dfW)
    print(f"[Brant {label}] chi2({dfW})={W:.2f}, p={p:.4f} -> "
          + ("proportional-odds assumption OK" if p > 0.05 else "VIOLATED"))
    return W, p

# ---------- 2. Primary model ----------
X = s[X_cols]
r, out = fit_ordinal(s['Y'], X, "PRIMARY: Y = per-subject max AESEV (0-4), n=1000")
brant(s['Y'], X, "primary")
b, (lo, hi) = r.params['n_ongoing'], r.conf_int().loc['n_ongoing']
pct = (np.exp(b)-1)*100
print(f"\nHEADLINE: per additional ongoing MHONGO condition: beta={b:.4f}, OR={np.exp(b):.4f}"
      f" -> {pct:.2f}% increase in odds of higher severity "
      f"(95% CI {(np.exp(lo)-1)*100:.2f}% to {(np.exp(hi)-1)*100:.2f}%), p={r.pvalues['n_ongoing']:.3g}")

# ---------- 3. Sensitivity (a): COVID-19-related AEs only ----------
ra, outa = fit_ordinal(s['Y_covid'], X, "SENS (a): Y = max AESEV of COVID-19 AEs (0-4), n=1000")
brant(s['Y_covid'], X, "sens-a")
ba, (loa, hia) = ra.params['n_ongoing'], ra.conf_int().loc['n_ongoing']
print(f"SENS (a) headline: {(np.exp(ba)-1)*100:.2f}% "
      f"(CI {(np.exp(loa)-1)*100:.2f}% to {(np.exp(hia)-1)*100:.2f}%), p={ra.pvalues['n_ongoing']:.3g}")

sub_mask = s['Y_covid'] > 0
rs, outs = fit_ordinal(s.loc[sub_mask,'Y_covid'], X.loc[sub_mask],
                       f"SENS (a2): subset with a COVID-19 AE of known severity, n={int(sub_mask.sum())}")
bs, (los, his) = rs.params['n_ongoing'], rs.conf_int().loc['n_ongoing']
print(f"SENS (a2) headline: {(np.exp(bs)-1)*100:.2f}% "
      f"(CI {(np.exp(los)-1)*100:.2f}% to {(np.exp(his)-1)*100:.2f}%), p={rs.pvalues['n_ongoing']:.3g}")

# ---------- 4. Sensitivity (b): pool levels 3-4 ----------
rb, outb = fit_ordinal(s['Y_pool34'], X, "SENS (b): Y = max AESEV with 3&4 pooled (0-3), n=1000")
brant(s['Y_pool34'], X, "sens-b")
bb, (lob, hib) = rb.params['n_ongoing'], rb.conf_int().loc['n_ongoing']
print(f"SENS (b) headline: {(np.exp(bb)-1)*100:.2f}% "
      f"(CI {(np.exp(lob)-1)*100:.2f}% to {(np.exp(hib)-1)*100:.2f}%), p={rb.pvalues['n_ongoing']:.3g}")

# ---------- 5. Cutpoint-specific diagnostics (partial-PO fallback view) ----------
print("\nCutpoint-specific logistic coefficients for n_ongoing (diagnostic):")
Xd = sm.add_constant(X.astype(float))
for k in range(1, 4):
    fk = sm.Logit((s['Y'] <= k).astype(int), Xd).fit(disp=0, method='bfgs', maxiter=5000)
    bk = fk.params['n_ongoing']
    print(f"  P(Y<={k}): beta={bk:.4f} -> OR={np.exp(bk):.4f} ({(np.exp(bk)-1)*100:.2f}%)")

print("\nDONE")
# ---------- 6. Partial proportional-odds fallback (n_ongoing slope free per cutpoint) ----------
from scipy.optimize import minimize

Yv = s['Y'].values.astype(float)
nv = s['n_ongoing'].values.astype(float)
xc = s[['BCG','ps_51_100','ps_gt100','expect_interact']].values.astype(float)
sig = lambda z: 1.0/(1.0+np.exp(-z))

# OrderedModel convention: P(Y<=k) = F(cut_{k+1} - x beta)
# statsmodels stores threshold params as (raw cut0, log-increments)
t = np.array([r.params[k] for k in ['0.0/1.0','1.0/2.0','2.0/3.0','3.0/4.0']])
c_thr = np.concatenate([t[:1], np.exp(t[1:])]).cumsum()  # actual cuts
b0 = -np.array([r.params[k] for k in ['BCG','ps_51_100','ps_gt100','expect_interact']])
d0 = -r.params['n_ongoing']
print(f"\nprimary OrderedModel llf = {r.llf:.2f} (PPOM must be >= this)")

def loglik(th, complex_ok=False):
    a, d, b = th[0:4], th[4:8], th[8:12]
    F = [sig(a[k] + d[k]*nv + xc @ b) for k in range(4)]
    P = np.empty((len(Yv), 5), dtype=np.complex128 if complex_ok else float)
    P[:,0] = F[0]; P[:,1] = F[1]-F[0]; P[:,2] = F[2]-F[1]; P[:,3] = F[3]-F[2]; P[:,4] = 1-F[3]
    return np.sum(np.log(np.clip(P[np.arange(len(Yv)), Yv.astype(int)], 1e-300, None)))

def obj(t):
    return float(-np.real(loglik(t)))

th0 = np.concatenate([c_thr, np.full(4, d0), b0])
print("initial loglik (should ~ primary llf):", float(np.real(loglik(th0))))
res = minimize(obj, th0, method='L-BFGS-B', options={'maxiter': 10000, 'ftol': 1e-12})
th = res.x
ll0 = float(np.real(loglik(th)))
print("converged:", res.success, "| PPOM loglik:", round(ll0,2))

# complex-step Hessian
h = 1e-5
fx = float(np.real(loglik(th)))
Fi = np.array([loglik(th + 1j*h*np.eye(12)[i], complex_ok=True) for i in range(12)])
H = np.zeros((12,12))
for i in range(12):
    H[i,i] = (float(np.real(Fi[i])) - fx)/h**2
    for j in range(i+1, 12):
        Fij = loglik(th + 1j*h*(np.eye(12)[i] + np.eye(12)[j]), complex_ok=True)
        H[i,j] = (float(np.real(Fij)) - float(np.real(Fi[i])) - float(np.real(Fi[j])) + fx)/h**2
        H[j,i] = H[i,j]
se = np.sqrt(np.clip(np.diag(np.linalg.pinv(-H)), 0, None))
print("\n===== PPOM fallback: n_ongoing slope free per cutpoint (primary outcome) =====")
# F_k = P(Y<=k) = sig(a_k + d_k*n + b*x); odds of HIGHER severity (Y>k) per +1 condition = exp(-d_k)
ors = [np.exp(-th[4+k]) for k in range(4)]
gm = float(np.prod(ors))**0.25
for k in range(4):
    d, sd = th[4+k], se[4+k]
    lo_ci = (np.exp(-d-1.96*sd)-1)*100; hi_ci = (np.exp(-d+1.96*sd)-1)*100
    se_note = " [SE unreliable: near-flat direction]" if sd < 1e-3 else ""
    print(f"  cutpoint k={k}: P(Y>k) OR per +1 condition = {np.exp(-d):.4f} "
          f"= +{(np.exp(-d)-1)*100:.2f}% (95% CI +{lo_ci:.2f}% to +{hi_ci:.2f}%), delta={d:.4f} (SE {sd:.4f}){se_note}")
print(f"  geometric-mean OR across cutpoints: {gm:.4f} -> +{(gm-1)*100:.2f}% increase in odds of higher severity")
for i, nm in enumerate(['BCG','ps51','ps100','expect']):
    b, sb = th[8+i], se[8+i]
    print(f"  {nm}: beta={b:.4f} (SE {sb:.4f}) OR={np.exp(b):.4f}")
print("\nALL DONE")
