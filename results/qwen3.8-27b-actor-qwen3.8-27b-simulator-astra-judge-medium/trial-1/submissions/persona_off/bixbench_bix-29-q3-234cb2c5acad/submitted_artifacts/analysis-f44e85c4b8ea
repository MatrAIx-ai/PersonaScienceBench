#!/usr/bin/env python3
"""
BCG vaccination x prior medical history interaction on COVID-19 severity.
Proportional-odds ordinal logit regression controlling for patient
interaction frequency (patients_seen).

Population: subjects with an AEPT=='COVID-19' adverse event and non-missing
severity; multiple COVID rows per subject reduced to max(AESEV).
"""
import warnings
import numpy as np
import pandas as pd
import patsy
from statsmodels.miscmodels.ordinal_model import OrderedModel

warnings.simplefilter("ignore")
pd.set_option("display.width", 200); pd.set_option("display.max_columns", None)

BASE = "data/TASK008_BCG-CORONA"
dm = pd.read_csv(f"{BASE}_DM.csv", low_memory=False)
ae = pd.read_csv(f"{BASE}_AE.csv", low_memory=False)
mh = pd.read_csv(f"{BASE}_MH.csv", low_memory=False)

# ---- BCG status + patients_seen (DM is 1 row/subject) ----
sub = dm[["USUBJID", "TRTGRP", "patients_seen"]].drop_duplicates("USUBJID").copy()
sub["BCG"] = (sub["TRTGRP"] == "BCG").astype(int)
sub["ps_num"] = sub["patients_seen"].map({"1-50": 1, "51-100": 2, ">100": 3})

# ---- Prior medical history: >=1 standard condition with MHONGO=='Yes' ----
std = mh[mh["MHTERM"].notna() & ~mh["MHTERM"].astype(str).str.startswith("Other:")]
pmh_series = ((std[std["MHONGO"] == "Yes"].groupby("USUBJID").size()
               .reindex(sub["USUBJID"], fill_value=0) > 0).astype(int))
sub["pmh"] = pmh_series.values

# ---- COVID-19 severity: AEPT=='COVID-19', max severity per subject ----
c = ae[ae["AEPT"] == "COVID-19"].copy()
c["AESEV"] = pd.to_numeric(c["AESEV"], errors="coerce")
cmax = c.dropna(subset=["AESEV"]).groupby("USUBJID")["AESEV"].max().rename("sev")
sub = sub.merge(cmax, on="USUBJID", how="left")
df = sub.dropna(subset=["sev"]).copy()
df["sev"] = df["sev"].astype(int)

print("Analysis population (COVID-19, non-missing max severity):", len(df))
print("TRTGRP:", df["TRTGRP"].value_counts().to_dict())
print("pmh (MHONGO==Yes):", df["pmh"].value_counts().to_dict())
print("patients_seen:", df["patients_seen"].value_counts().to_dict())
print("severity (4-level):", df["sev"].value_counts().sort_index().to_dict())
print()


def fit_ordinal(data, response, formula, label):
    y, X = patsy.dmatrices(f"{response} ~ {formula}", data=data,
                           return_type="dataframe")
    X = X.drop(columns=["Intercept"])
    cols = list(X.columns)
    m = OrderedModel(y.values, X.values, distr="logit")
    try:
        r = m.fit(method="bfgs", disp=False)
    except Exception as e:
        print(f"[{label}] FIT FAILED: {e}\n"); return None
    se = np.asarray(r.bse); pv = np.asarray(r.pvalues); par = np.asarray(r.params)
    ci = np.asarray(r.conf_int())
    p = len(cols)                      # regression coefs are the LAST p params
    par, se, pv = par[-p:], se[-p:], pv[-p:]
    ci = ci[-p:]
    thr = par[:-p] if len(par) > p else np.array([])
    tab = pd.DataFrame({"coef": par, "SE": se, "p": pv,
                        "OR": np.exp(par),
                        "OR_lo": np.exp(ci[:, 0]), "OR_hi": np.exp(ci[:, 1])},
                       index=cols)
    conv = r.mle_retvals.get("converged")
    print(f"===== {label} =====")
    print(f"n={int(r.nobs)}  llf={r.llf:.4f}  converged={conv}  "
          f"iterations={r.mle_retvals.get('iterations')}")
    print(tab.round(4).to_string())
    # interaction
    if "BCG:pmh" in tab.index:
        row = tab.loc["BCG:pmh"]
        sep = row["SE"] is np.nan or np.isnan(row["SE"])
        print(f"  >> BCG:pmh  coef={row['coef']:.4f}  SE={row['SE']}  "
              f"OR={row['OR']:.4f}  95%CI=[{row['OR_lo']}, {row['OR_hi']}]  "
              f"p={row['p']}  SE_STABLE={'NO (separation)' if sep else 'yes'}")
        for k in ["BCG", "pmh"]:
            if k in tab.index:
                rr = tab.loc[k]
                print(f"     main {k:4s} OR={rr['OR']:.4f}  "
                      f"95%CI=[{rr['OR_lo']}, {rr['OR_hi']}]  p={rr['p']}")
    nan_se = (np.isnan(se)).sum()
    print(f"  SEs: {nan_se} NaN; max finite SE={np.nanmax(se):.4f}\n")
    return r, tab


# ============ HEADLINE: 4-level, patients_seen ordinal-numeric ============
res44, t44 = fit_ordinal(df, "sev",
                          "BCG + pmh + BCG:pmh + ps_num",
                          "HEADLINE 4-level ordinal logit, patients_seen=ordinal-numeric")

# ============ ROBUST 1: 3-level collapse (3 & 4 -> severe) ============
d3 = df.copy()
d3["sev3"] = np.where(d3["sev"] >= 3, 3, d3["sev"])
print("3-level severity dist:", d3["sev3"].value_counts().sort_index().to_dict())
res43, t43 = fit_ordinal(d3, "sev3",
                          "BCG + pmh + BCG:pmh + ps_num",
                          "ROBUST 1: 3-level collapse (3&4 -> severe)")

# ============ ROBUST 2: patients_seen categorical (2 df) ============
res4c, t4c = fit_ordinal(df, "sev",
                          "BCG + pmh + BCG:pmh + C(patients_seen)",
                          "ROBUST 2: 4-level, patients_seen categorical (2 df)")

print("=" * 60)
print("SUMMARY")
for label, tab in [("HEADLINE 4-level", t44),
                   ("ROBUST 1 (3-level)", t43),
                   ("ROBUST 2 (ps categorical)", t4c)]:
    if tab is not None and "BCG:pmh" in tab.index:
        r = tab.loc["BCG:pmh"]
        print(f"{label:28s}: interaction OR={r['OR']:.4f}  "
              f"95%CI=[{r['OR_lo']:.3f},{r['OR_hi']:.3f}]  p={r['p']:.4f}")


# ============ DIAGNOSTICS: quasi-separation / identifiability ============
print("=" * 60)
print("DIAGNOSTICS")
df["BCGpmh"] = df["BCG"] * df["pmh"]
X = df[["BCG", "pmh", "BCGpmh", "ps_num"]].values.astype(float)
Xc = X - X.mean(0)
print(f"Design cond={np.linalg.cond(np.column_stack([np.ones(len(X)), Xc])):.3f}, "
      f"rank={np.linalg.matrix_rank(np.column_stack([np.ones(len(X)), Xc]))}")
top = df[df.sev >= 3]
print(f"Top-severity (sev>=3) n={len(top)}: "
      f"BCG mean={top.BCG.mean():.2f}, pmh mean={top.pmh.mean():.2f}, "
      f"ps_num mean={top.ps_num.mean():.2f}")
print(f"  -> {int((top.pmh==1).sum())}/{len(top)} have prior med history; "
      f"{int((top.ps_num==1).sum())}/{len(top)} in lowest patients_seen band")
print("Severity mean by interaction cell:")
df["cell"] = df.BCG.astype(str) + "x" + df.pmh.astype(str)
print(df.groupby("cell")["sev"].agg(["count", "mean"]).round(3).to_string())
print()
print("NOTE: the single large coefficient (coef~1.06, SE~0.10) relocates to")
print("BCG:pmh (headline), ps_num (3-level), and pmh (ps-categorical) across")
print("specs with an implausibly small p (~1e-25) at n=148 -> quasi-separation")
print("in the 14 sparse top-severity subjects, not an identifiable interaction.")

print("=" * 60)
print("FINAL ANSWER")
print("BCG x prior-medical-history interaction on COVID-19 severity")
print("  HEADLINE 4-level ordinal logit (ps ordinal-numeric):")
print("    interaction OR = 2.89  95%CI [2.37, 3.53]  p~2e-25  (NOT robust)")
print("  ROBUST 1  3-level collapse (3&4->severe):")
print("    interaction OR = 0.94  95%CI [0.34, 2.58]  p=0.91  (ns)")
print("  ROBUST 2  patients_seen categorical:")
print("    interaction OR = 0.92  95%CI [0.46, 1.85]  p=0.82  (ns)")
print("Conclusion: the BCG x prior-medical-history interaction is NOT")
print("robustly significant. The headline 4-level OR of ~2.89 is a")
print("quasi-separation artifact in the sparse top severity levels; both")
print("pre-committed robustness checks give OR~0.9 (ns). Robust answer:")
print("no significant interaction (OR ~0.9, CI spans 1).")
