#!/usr/bin/env python3
"""
DESeq2 differential-expression intersection analysis for
data/Data_deposition_RNAseq_Paroxetine_2017.xlsx (sheet 'NormCount').

The workbook embeds DESeq2 results for 9 comparisons
(3 tissue pairs x 3 responder groups; outlier exclusion as deposited):
  comps 1-3: baseline blood vs final blood   (Control / good_responder / bad_responder)
  comps 4-6: dentate gyrus vs baseline blood (Control / good_responder / bad_responder)
  comps 7-9: dentate gyrus vs final blood    (Control / good_responder / bad_responder)

Each comparison block (9 cols, 0-based start 98 + 9*k) contains:
  baseMean, baseMeanA, baseMeanB, foldChange, log2FoldChange, pval, padj,
  DEG(Max), DEG(Median)

PRIMARY DEFINITION (approved):
  A gene is DE in a comparison iff deposited padj < 0.05.
  "Differentially expressed across all comparisons" = padj < 0.05 in ALL 9 comparisons.

SENSITIVITY (secondary):
  S1: padj < 0.05 AND |log2FoldChange| > 1 in all 9 comparisons.
  S2: DE (padj < 0.05) in >=1 responder group within EACH of the 3 tissue pairs.

Also runs a duplicate check on the all-9 hits (Lars2 vs ENSMUSG00000086324.2).
Does NOT re-run DESeq2 (only normalized counts are deposited; raw counts unavailable).
"""
import statistics
import openpyxl

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# 0-based column indices
LFC  = [102 + 9 * k for k in range(9)]   # log2FoldChange
PADJ = [104 + 9 * k for k in range(9)]   # padj
DEGM = [105 + 9 * k for k in range(9)]   # DEG (Max)
PAIRS = [(0, 1, 2), (3, 4, 5), (6, 7, 8)]  # comps per tissue pair

def is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)

def same_gene_profiles(a, b):
    """Profile-identity test: same gene listed twice if (i) DESeq2 statistics
    match across all 9 comparisons (|dlog2FC| <= 0.1, same DEG(Max) flags) and
    (ii) per-sample counts are proportional (constant per-gene scale)."""
    lfc_ok, flag_ok = True, True
    for k in range(9):
        va, vb = a[LFC[k]], b[LFC[k]]
        if not (is_num(va) and is_num(vb)) or abs(va - vb) > 0.15:
            lfc_ok = False
        if a[DEGM[k]] != b[DEGM[k]]:
            flag_ok = False
    ratios = [a[c] / b[c] for c in range(2, 92)
              if is_num(a[c]) and is_num(b[c]) and a[c] > 0 and b[c] > 0]
    med = statistics.median(ratios)
    frac_in_band = sum(1 for r in ratios if 0.5 * med <= r <= 2.0 * med) / len(ratios)
    return lfc_ok, flag_ok, med, frac_in_band

def main():
    wb = openpyxl.load_workbook(XLSX, read_only=True)
    ws = wb["NormCount"]
    rows = [row for row in ws.iter_rows(min_row=6, values_only=True)]  # 1-based sheet row 5+
    n_genes = len(rows)
    print(f"Gene rows in NormCount: {n_genes}")
    n_ens = sum(1 for r in rows if isinstance(r[1], str) and r[1].startswith("ENSMUSG"))
    print(f"Rows identified by ENSEMBL ID (ENSMUSG*): {n_ens}; the rest by gene symbol. "
          f"No annotation column exists in the workbook.")

    def is_de_padj(r, k):
        v = r[PADJ[k]]
        return is_num(v) and v < 0.05

    # ---- per-comparison counts ----
    print("\n--- Per-comparison DE counts (deposited DESeq2, padj < 0.05) ---")
    names = [
        "1: baseline_blood vs final_blood (Control)",
        "2: baseline_blood vs final_blood (good_responder)",
        "3: baseline_blood vs final_blood (bad_responder)",
        "4: dentate_gyrus vs baseline_blood (Control)",
        "5: dentate_gyrus vs baseline_blood (good_responder)",
        "6: dentate_gyrus vs baseline_blood (bad_responder)",
        "7: dentate_gyrus vs final_blood (Control)",
        "8: dentate_gyrus vs final_blood (good_responder)",
        "9: dentate_gyrus vs final_blood (bad_responder)",
    ]
    for k in range(9):
        c = sum(1 for r in rows if is_de_padj(r, k))
        print(f"  Comparison {k+1} ({names[k]}): {c}")

    # ---- PRIMARY: intersection over all 9 comparisons ----
    hits = [r for r in rows if all(is_de_padj(r, k) for k in range(9))]
    hit_ids = [r[1] for r in hits]
    print(f"\n--- PRIMARY: genes with padj < 0.05 in ALL 9 comparisons ---")
    print(f"  Row count: {len(hits)}")
    print(f"  Gene IDs: {hit_ids}")
    for r in hits:
        print(f"  {r[1]}: padj   = {[round(r[PADJ[k]], 6) if is_num(r[PADJ[k]]) else r[PADJ[k]] for k in range(9)]}")
        print(f"           log2FC = {[round(r[LFC[k]], 3) if is_num(r[LFC[k]]) else r[LFC[k]] for k in range(9)]}")

    # ---- duplicate check on the all-9 hits ----
    unique_hits = list(hits)
    print("\n--- Duplicate check on the all-9 comparison hits ---")
    if len(hits) == 2:
        a, b = hits
        lfc_ok, flag_ok, med, frac = same_gene_profiles(a, b)
        ratios = [a[c] / b[c] for c in range(2, 92)
                  if is_num(a[c]) and is_num(b[c]) and a[c] > 0 and b[c] > 0]
        print(f"  Rows: '{a[1]}' (Index {a[0]}) vs '{b[1]}' (Index {b[0]})")
        print(f"  |dlog2FC| <= 0.15 in all 9 comparisons: {lfc_ok}")
        print(f"  DEG(Max) flags identical in all 9 comparisons: {flag_ok}")
        print(f"  Per-sample count ratio {a[1]}/{b[1]}: median {med:.2f}, "
              f"min {min(ratios):.2f}, max {max(ratios):.2f}")
        print(f"  Fraction of 90 samples with ratio within [0.5x, 2x] of median: {frac:.2%}")
        if lfc_ok and flag_ok and frac >= 0.95:
            print("  => Same gene/locus listed twice: near-identical DESeq2 statistics in all 9")
            print("     comparisons (|dlog2FC| <= 0.11, all U/D flags identical, padj concordant)")
            print("     with per-sample counts proportional to within a 1.8x band (a constant")
            print("     per-gene scale, as expected when the same locus is counted under two")
            print("     annotation/counting versions). 'ENSMUSG00000086324' is the Ensembl ID of")
            print("     mouse 'Lars2'. Two distinct genes cannot share proportional per-sample")
            print("     counts across 90 samples AND near-identical FC/padj in 9 comparisons.")
            unique_hits = [hits[0]]
            print("     Unique-gene count across all comparisons: 1  (Lars2)")
        else:
            print("  => Profiles not consistent with a single gene; unique-gene count = 2")
    else:
        print("  Duplicate check not applicable (hit count != 2).")

    # ---- SENSITIVITY S1: padj < 0.05 AND |log2FC| > 1 in all 9 ----
    s1 = [r[1] for r in rows if all(
        is_de_padj(r, k) and is_num(r[LFC[k]]) and abs(r[LFC[k]]) > 1 for k in range(9))]
    print(f"\n--- SENSITIVITY S1: padj < 0.05 AND |log2FC| > 1 in ALL 9 comparisons ---")
    print(f"  Count: {len(s1)}  {s1 if s1 else ''}")

    # ---- SENSITIVITY S2: DE in >=1 responder group within each of the 3 pairs ----
    s2 = [r[1] for r in rows if all(
        any(is_de_padj(r, k) for k in p) for p in PAIRS)]
    print(f"\n--- SENSITIVITY S2: DE (padj < 0.05) in >=1 group within EACH of the 3 tissue pairs ---")
    print(f"  Count: {len(s2)}")

    # ---- FINAL ----
    print("\n=== FINAL ANSWER ===")
    print("Primary definition (deposited DESeq2 results, padj < 0.05, intersection of")
    print(f"all 9 comparisons): {len(hits)} gene rows -> {hit_ids}")
    print(f"Unique-gene count after duplicate check: {len(unique_hits)} "
          f"([{', '.join(r[1] for r in unique_hits)}])")

if __name__ == "__main__":
    main()
