#!/usr/bin/env python3
"""
BixBench bix-3-q5 — Differential expression across three tissue comparisons
(Final vs Baseline Blood, Dentate gyrus vs Baseline blood, Dentate gyrus vs Final blood)
followed by a binomial exact test (5% threshold) to identify the comparison with
negligible effects.

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx, sheet 'NormCount'.
  - 25,402 genes x 90 samples (3 tissues x 3 response groups x 10 replicates).
  - Sample columns hold DESeq-normalized counts (verified: no missing values).

PRIMARY PROTOCOL (approved):
  1. Per-gene tissue summary = median of the 30 normalized counts, pseudocount +1.
  2. log2FC = log2(median_A + 1) - log2(median_B + 1), A = first-named tissue.
  3. DEG if |log2FC| > 0.5 (mirrors the depositor's own DEG rule: padj<0.05 & |log2FC|>0.5).
  4. Two-sided binomial exact test: trials n = U + D, successes k = U, p0 = 0.5
     (H0: no directional effect). alpha = 0.05.
  5. 'Negligible effects' = comparison failing to reject H0 (p >= 0.05).

SENSITIVITY VARIANTS (supporting evidence only):
  V1: |log2FC| > 1.0 (median-based).
  V2: rate interpretation — binomtest(k_DEG, N_genes, p0=0.05, one-sided 'greater'),
      i.e. is the DEG count significantly above the 5% false-positive background.
  V3: mean-based summary instead of median.
  V4: per-gene Welch t-test on log2(count+1) + Benjamini-Hochberg FDR;
      DEG = padj < 0.05 & |median log2FC| > 0.5; balance test on U vs D.
"""
import numpy as np
import openpyxl
from scipy import stats
from statsmodels.stats.multitest import multipletests

XLSX = "/workspace/data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
ALPHA = 0.05
RESPONSES = ["Control", "good_responder", "bad_responder"]
TISSUES = ["baseline_blood", "dentate_gyrus", "final_blood"]
COMPARISONS = [
    ("Final vs Baseline Blood", "final_blood", "baseline_blood"),
    ("Dentate gyrus vs Baseline blood", "dentate_gyrus", "baseline_blood"),
    ("Dentate gyrus vs Final blood", "dentate_gyrus", "final_blood"),
]

# ---------------------------------------------------------------- load data
wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb["NormCount"]
rows = list(ws.iter_rows(values_only=True))
wb.close()
header = list(rows[3])                      # row 4 = real header
data = np.asarray(rows[4:], dtype=object)
# keep only non-empty rows
mask = np.array([any(v is not None and v != "" for v in r) for r in data])
data = data[mask]
n_genes = len(data)
print(f"Loaded NormCount: {n_genes} genes x {len(header)} columns")

# sample column indices per tissue (exact sample codes from the header)
tissue_cols = {}
for t in TISSUES:
    idx = [i for i, h in enumerate(header)
           if h is not None and any(str(h).startswith(f"{g}_{t}") for g in RESPONSES)]
    assert len(idx) == 30, (t, len(idx))
    tissue_cols[t] = idx
print("Sample columns per tissue:", {t: len(v) for t, v in tissue_cols.items()})

# numeric matrices (genes x 30)
M = {t: np.asarray(data[:, tissue_cols[t]], dtype=float) for t in TISSUES}
assert not np.isnan(M["baseline_blood"]).any(), "missing values present"

# sanity: per-tissue medians must match the sheet's own 'Median' columns
med_hdr = {t: header.index(h) for t, h in
           [("baseline_blood", "baseline_blood"), ("dentate_gyrus", "dentate_gyrus"),
            ("final_blood", "final_blood")]}
# the three 'Median' block columns are at positions 95, 96, 97
for t, pos in zip(TISSUES, (95, 96, 97)):
    sheet_med = np.asarray(data[:, pos], dtype=float)
    mine = np.median(M[t], axis=1)
    nd = int((np.abs(mine - sheet_med) > 1e-6).sum())
    print(f"Sanity {t}: my median vs sheet Median col -> {nd} differing genes")

# ---------------------------------------------------------------- primary
def balance_test(U, D):
    n = U + D
    if n == 0:
        return float("nan")
    return stats.binomtest(U, n, 0.5, alternative="two-sided").pvalue

def rate_test(k):
    return stats.binomtest(k, n_genes, 0.05, alternative="greater").pvalue

print("\n=== PRIMARY PROTOCOL: median log2FC, pseudocount 1, |log2FC|>0.5, "
      "two-sided binom(U, U+D, 0.5) ===")
primary = {}
for name, a, b in COMPARISONS:
    lfc = np.log2(np.median(M[a], axis=1) + 1) - np.log2(np.median(M[b], axis=1) + 1)
    sig = np.abs(lfc) > 0.5
    U = int(((lfc > 0) & sig).sum()); D = int(((lfc < 0) & sig).sum())
    p = balance_test(U, D)
    primary[name] = (U, D, U + D, p)
    print(f"{name:34s} U={U:5d} D={D:5d} n={U+D:5d}  p={p:.4g}  "
          f"{'NEGLIGIBLE (p>=0.05)' if p >= ALPHA else 'significant (p<0.05)'}")

# ---------------------------------------------------------------- variants
print("\n=== V1: |log2FC|>1.0 (median-based, balance test) ===")
for name, a, b in COMPARISONS:
    lfc = np.log2(np.median(M[a], axis=1) + 1) - np.log2(np.median(M[b], axis=1) + 1)
    sig = np.abs(lfc) > 1.0
    U = int(((lfc > 0) & sig).sum()); D = int(((lfc < 0) & sig).sum())
    print(f"{name:34s} U={U:5d} D={D:5d} n={U+D:5d}  p={balance_test(U, D):.4g}")

print("\n=== V2: rate interpretation binomtest(k_DEG, N, 0.05, greater) ===")
for name, a, b in COMPARISONS:
    for thr in (0.5, 1.0):
        lfc = np.log2(np.median(M[a], axis=1) + 1) - np.log2(np.median(M[b], axis=1) + 1)
        k = int((np.abs(lfc) > thr).sum())
        print(f"{name:34s} |lfc|>{thr}: k={k:5d} ({100*k/n_genes:.2f}%)  p={rate_test(k):.4g}")

print("\n=== V3: mean-based summary, |log2FC|>0.5, balance test ===")
for name, a, b in COMPARISONS:
    lfc = np.log2(np.mean(M[a], axis=1) + 1) - np.log2(np.mean(M[b], axis=1) + 1)
    sig = np.abs(lfc) > 0.5
    U = int(((lfc > 0) & sig).sum()); D = int(((lfc < 0) & sig).sum())
    print(f"{name:34s} U={U:5d} D={D:5d} n={U+D:5d}  p={balance_test(U, D):.4g}")

print("\n=== V4: per-gene Welch t-test on log2(count+1), BH-FDR, "
      "DEG = padj<0.05 & |median log2FC|>0.5 ===")
for name, a, b in COMPARISONS:
    X = np.log2(M[a] + 1); Y = np.log2(M[b] + 1)
    p = np.nan_to_num(stats.ttest_ind(X, Y, axis=1, equal_var=False)[1], nan=1.0)
    padj = multipletests(p, method="fdr_bh")[1]
    lfc = np.median(X, axis=1) - np.median(Y, axis=1)
    sig = (padj < 0.05) & (np.abs(lfc) > 0.5)
    U = int(((lfc > 0) & sig).sum()); D = int(((lfc < 0) & sig).sum())
    print(f"{name:34s} U={U:5d} D={D:5d} n={U+D:5d}  p={balance_test(U, D):.4g}")

# ---------------------------------------------------------------- summary
print("\n=== SUMMARY (primary protocol) ===")
print(f"{'comparison':34s} {'U':>6s} {'D':>6s} {'n':>6s} {'p':>12s}  verdict")
negligible = []
for name, a, b in COMPARISONS:
    U, D, n, p = primary[name]
    verdict = "NEGLIGIBLE" if p >= ALPHA else "significant"
    if p >= ALPHA:
        negligible.append(name)
    print(f"{name:34s} {U:6d} {D:6d} {n:6d} {p:12.4g}  {verdict}")
print("\nComparison(s) with negligible effects (p >= 0.05):",
      ", ".join(negligible) if negligible else "NONE")
