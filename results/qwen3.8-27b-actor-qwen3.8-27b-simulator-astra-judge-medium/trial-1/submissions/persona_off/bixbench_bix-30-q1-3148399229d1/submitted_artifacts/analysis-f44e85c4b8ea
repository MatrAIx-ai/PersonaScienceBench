"""
Differential expression: patient (P_1..P_10) vs control (C_11..C_20)
on qPCR Ct values from data/pone.0150501.s002.xls (Table S1).

Primary: per-miRNA Welch two-sample t-test, two-sided, unadjusted p < 0.05,
         'NAN' text cells = missing (pairwise deletion), denominator = 175.
Sensitivity: Student's t-test; Wilcoxon rank-sum; variant excluding miRNAs
         with any missing value (denominator = 161).
Executed on: 2026-10-19
Pipeline: /workspace/scripts/parse_xls.py (minimal BIFF8 reader, run with
/usr/bin/python3.14 which has olefile) -> grid.tsv -> this script (scipy).
"""
import numpy as np
from scipy import stats

ALPHA = 0.05
rows = []
with open('/workspace/scripts/grid.tsv') as f:
    for line in f:
        rows.append(line.rstrip('\n').split('\t'))

title = rows[0][0]
header = rows[1]
p_cols = [i for i, h in enumerate(header) if h.startswith('P_')]
c_cols = [i for i, h in enumerate(header) if h.startswith('C_')]
data_rows = rows[2:]
print(title)
print(f"miRNAs: {len(data_rows)}, patients: {len(p_cols)}, controls: {len(c_cols)}")

def to_float(v):
    if v in ('', 'NAN', 'NaN', 'nan', 'NA'):
        return np.nan
    return float(v)

miRNA, P, C, nmiss = [], [], [], []
for r in data_rows:
    miRNA.append(r[0])
    P.append(np.array([to_float(r[i]) for i in p_cols]))
    C.append(np.array([to_float(r[i]) for i in c_cols]))
    nmiss.append(np.isnan(P[-1]).sum() + np.isnan(C[-1]).sum())
nmiss = np.array(nmiss)

def test_pairwise(P, C, kind):
    """Per-miRNA test with pairwise deletion of NaNs. Returns p (nan on failure)."""
    ps = []
    for p, c in zip(P, C):
        m = ~(np.isnan(p) | np.isnan(c))
        p2, c2 = p[m], c[m]
        if len(p2) < 2 or len(c2) < 2:
            ps.append(np.nan); continue
        try:
            if kind == 'welch':
                ps.append(stats.ttest_ind(p2, c2, equal_var=False).pvalue)
            elif kind == 'student':
                ps.append(stats.ttest_ind(p2, c2, equal_var=True).pvalue)
            elif kind == 'wilcoxon':
                res = stats.mannwhitneyu(p2, c2, alternative='two-sided')
                ps.append(res.pvalue)
        except Exception:
            ps.append(np.nan)
    return np.array(ps)

def test_complete_only(P, C, kind, keep):
    """Only miRNAs with no missing values (keep mask), same tests."""
    ps = np.full(len(keep), np.nan)
    for i in np.where(keep)[0]:
        p2, c2 = P[i], C[i]
        try:
            if kind == 'welch':
                ps[i] = stats.ttest_ind(p2, c2, equal_var=False).pvalue
            elif kind == 'student':
                ps[i] = stats.ttest_ind(p2, c2, equal_var=True).pvalue
            elif kind == 'wilcoxon':
                ps[i] = stats.mannwhitneyu(p2, c2, alternative='two-sided').pvalue
        except Exception:
            pass
    return ps

nmiss_mirna = int((nmiss > 0).sum())
print(f"\nmiRNAs with any missing value: {nmiss_mirna} (missing cells: {int(nmiss.sum())}; denom variant: {175 - nmiss_mirna})")

print("\n=== PRIMARY: Welch t-test, pairwise deletion, unadjusted two-sided p < 0.05, denom 175 ===")
pw = test_pairwise(P, C, 'welch')
sig_w = np.sum(pw < ALPHA)
print(f"significant: {int(sig_w)}/175 = {100*sig_w/175:.2f}%")

print("\n=== SENSITIVITY (pairwise deletion, denom 175) ===")
ps_s = test_pairwise(P, C, 'student')
ps_wx = test_pairwise(P, C, 'wilcoxon')
sig_s = np.sum(ps_s < ALPHA); sig_wx = np.sum(ps_wx < ALPHA)
print(f"Student t:    {int(sig_s)}/175 = {100*sig_s/175:.2f}%")
print(f"Wilcoxon:     {int(sig_wx)}/175 = {100*sig_wx/175:.2f}%")

print("\n=== SENSITIVITY (exclude miRNAs with any missing, denom 161) ===")
keep = nmiss == 0
ps_wc = test_complete_only(P, C, 'welch', keep)
ps_sc = test_complete_only(P, C, 'student', keep)
ps_wxc = test_complete_only(P, C, 'wilcoxon', keep)
sc_w = np.nansum(ps_wc < ALPHA); sc_s = np.nansum(ps_sc < ALPHA); sc_wx = np.nansum(ps_wxc < ALPHA)
print(f"Welch:    {int(sc_w)}/161 = {100*sc_w/161:.2f}%")
print(f"Student:  {int(sc_s)}/161 = {100*sc_s/161:.2f}%")
print(f"Wilcoxon: {int(sc_wx)}/161 = {100*sc_wx/161:.2f}%")

# significant miRNA list (primary)
print("\n=== miRNAs significant under PRIMARY (Welch, p<0.05) ===")
for name, p in sorted(zip(miRNA, pw), key=lambda x: x[1]):
    if p < ALPHA:
        print(f"  {name}: p={p:.3g}")

# borderline: 0.05 <= p < 0.10 (test-choice sensitivity)
print("\nBorderline (0.05 <= p_welch < 0.10):")
for name, p in sorted(zip(miRNA, pw), key=lambda x: x[1]):
    if ALPHA <= p < 0.10:
        print(f"  {name}: p={p:.4f}")
