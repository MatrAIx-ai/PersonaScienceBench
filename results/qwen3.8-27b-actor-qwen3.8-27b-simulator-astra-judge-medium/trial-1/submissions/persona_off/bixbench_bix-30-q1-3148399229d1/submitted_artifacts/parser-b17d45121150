"""Minimal BIFF8 .xls reader (no xlrd available offline).
Extracts the Workbook stream via olefile, parses records, builds grids.
"""
import sys, struct
import olefile

PATH = '/workspace/data/pone.0150501.s002.xls'

ole = olefile.OleFileIO(PATH)
wb = ole.openstream('Workbook').read()
ole.close()

pos = 0
records = []  # (rectype, data, offset)
while pos + 4 <= len(wb):
    rectype, length = struct.unpack('<HH', wb[pos:pos+4])
    data = wb[pos+4:pos+4+length]
    records.append((rectype, data, pos))
    pos += 4 + length

def parse_sst(sst_data, continues):
    """Parse SST with CONTINUE support (MS-OI29500)."""
    total, unique = struct.unpack('<II', sst_data[:8])
    blocks = [sst_data[8:]] + continues
    strings = []
    bi, bo = 0, 0  # block index, offset within block
    def read_u16():
        nonlocal bi, bo
        if bo + 2 > len(blocks[bi]):
            bi += 1; bo = 0
        v = struct.unpack('<H', blocks[bi][bo:bo+2])[0]; bo += 2; return v
    def read_byte():
        nonlocal bi, bo
        if bo + 1 > len(blocks[bi]):
            bi += 1; bo = 0
        v = blocks[bi][bo]; bo += 1; return v
    def read_char(compressed):
        nonlocal bi, bo
        if compressed:
            if bo + 1 > len(blocks[bi]):
                bi += 1; bo = 0
            v = blocks[bi][bo]; bo += 1; return chr(v)
        else:
            if bo + 2 > len(blocks[bi]):
                bi += 1; bo = 0
                # per spec, first byte of new block is a flags byte for continued string
            v = struct.unpack('<H', blocks[bi][bo:bo+2])[0]; bo += 2; return chr(v)
    for _ in range(unique):
        cch = read_u16()
        grbit = read_byte()
        compressed = not (grbit & 1)
        rt = high = 0
        if grbit & 2: rt = read_u16()
        if grbit & 8: high = read_u16()
        chars = []
        for _ in range(cch):
            if bo + (1 if compressed else 2) > len(blocks[bi]):
                bi += 1; bo = 0
                # continued: first byte flags compression for this block
                f = blocks[bi][bo]; bo += 1
                compressed = not (f & 1)
            chars.append(read_char(compressed))
        s = ''.join(chars)
        if rt:
            bo += 4 * rt
        strings.append(s)
    return strings

# collect SST + its CONTINUEs
sst_strings = []
i = 0
while i < len(records):
    t, d, off = records[i]
    if t == 0x00FC:  # SST
        cont = []
        j = i + 1
        while j < len(records) and records[j][0] == 0x003C:
            cont.append(records[j][1]); j += 1
        sst_strings = parse_sst(d, cont)
        i = j
    else:
        i += 1

def rk_to_num(rk):
    if rk & 0x02:
        v = rk >> 16
        if v & 0x8000: v -= 0x10000
    else:
        v = struct.unpack('<d', struct.pack('<QQ', (rk & 0xFFFFFFFC) << 32, 0))[0]
    return v / 100.0 if rk & 0x01 else float(v)

sheets = []  # (name, grid)
for t, d, off in records:
    if t == 0x0085:  # BOUNDSHEET
        xfar, vis, typ = struct.unpack('<IBB', d[:6])
        n = d[6]
        name = d[7:7+n].decode('utf-16-le')
        sheets.append([name, xfar, {}])

for t, d, off in records:
    if t == 0x00FD:  # LABELSST
        r, c, xf, sst_i = struct.unpack('<HHHI', d[:10])
        if sheets: sheets[-1][2].setdefault((r,c), sst_strings[sst_i])
    elif t == 0x0203:  # NUMBER
        r, c, xf = struct.unpack('<HHH', d[:6])
        v = struct.unpack('<d', d[6:14])[0]
        if sheets: sheets[-1][2].setdefault((r,c), v)
    elif t == 0x027E:  # RK
        r, c, xf = struct.unpack('<HHH', d[:6])
        v = rk_to_num(struct.unpack('<I', d[6:10])[0])
        if sheets: sheets[-1][2].setdefault((r,c), v)
    elif t == 0x00BD:  # MULRK
        r, c1 = struct.unpack('<HH', d[:4])
        n = (len(d) - 6) // 6
        c2 = struct.unpack('<H', d[4+2*n:4+2*n+2])[0]
        for k in range(n):
            xf, rk = struct.unpack('<HI', d[4+k*6:4+k*6+6])
            if sheets: sheets[-1][2].setdefault((r, c1+k), rk_to_num(rk))
    elif t == 0x0006:  # FORMULA
        r, c, xf = struct.unpack('<HHH', d[:6])
        res = d[6:14]
        last = res[-1]
        if last == 0x20:
            if res[-2] == 0x00:
                val = struct.unpack('<d', res[:-2])[0]
            else:
                val = 'STR?'
        else:
            val = struct.unpack('<d', res)[0]
        if sheets: sheets[-1][2].setdefault((r,c), val)
    elif t == 0x0205:  # BOOLERR
        r, c, xf = struct.unpack('<HHH', d[:6])
        v, f = struct.unpack('<HB', d[6:8])
        val = bool(v) if f == 0 else ('ERR:%d' % v)
        if sheets: sheets[-1][2].setdefault((r,c), val)

print("SHEETS:", [(s[0], len(s[2])) for s in sheets])
for name, xfar, grid in sheets:
    if not grid: continue
    maxr = max(r for r,c in grid) + 1
    maxc = max(c for r,c in grid) + 1
    print(f"\n===== SHEET '{name}' dims {maxr} rows x {maxc} cols =====")
    nrows = min(maxr, 12)
    for r in range(nrows):
        row = []
        for c in range(min(maxc, 40)):
            v = grid.get((r,c), '')
            if isinstance(v, float):
                v = f"{v:.6g}"
            row.append(str(v)[:22])
        print(r, ' | '.join(row))

# --- dump grid to TSV for downstream (scipy) analysis ---
if len(sys.argv) > 1 and sys.argv[1] == 'dump':
    out = sys.argv[2]
    name, xfar, grid = sheets[0]
    maxr = max(r for r,c in grid)+1
    maxc = max(c for r,c in grid)+1
    with open(out, 'w') as f:
        for r in range(maxr):
            row = []
            for c in range(maxc):
                v = grid.get((r,c))
                if v is None: v = ''
                row.append(str(v).replace('\t',' '))
            f.write('\t'.join(row) + '\n')
    print("dumped", maxr, "x", maxc, "->", out)
