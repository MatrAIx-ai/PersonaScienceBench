"""bix-33-q1: Which immune cell type has the highest number of significantly
differentially expressed genes after AAV9 mini-dystrophin treatment?

Source: Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx
Criteria (approved):
  - significant = p_val_adj < 0.05 (per cell-type sheet)
  - sensitivity = |avg_log2FC| > 0.25 AND p_val_adj < 0.05
  - top immune cell type = max over sheets excluding HSPC, Eryth, Platelet
"""
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
NON_IMMUNE = {"HSPC", "Eryth", "Platelet"}

xl = pd.ExcelFile(XLSX)
rows = []
for s in xl.sheet_names:
    d = pd.read_excel(XLSX, sheet_name=s)
    d.columns = [c for c in d.columns]  # keep
    gene = d.iloc[:, 0]
    sig = (d["p_val_adj"] < 0.05)
    sens = sig & (d["avg_log2FC"].abs() > 0.25)
    rows.append({
        "cell_type": s,
        "n_genes": len(d),
        "n_sig_padj<0.05": int(sig.sum()),
        "n_sig_padj<0.05_and_|fc|>0.25": int(sens.sum()),
        "immune": s not in NON_IMMUNE,
    })

res = pd.DataFrame(rows)
res = res.sort_values("n_sig_padj<0.05", ascending=False).reset_index(drop=True)
res.insert(0, "rank", res.index + 1)

pd.set_option("display.width", 200)
print("RANKED — all 25 cell types (sorted by # genes with p_val_adj < 0.05):")
print(res.to_string(index=False))

print("\n--- Immune-only ranking (excluding HSPC, Eryth, Platelet) ---")
imm = res[res["immune"]].copy()
print(imm.to_string(index=False))

print("\n--- Sensitivity (|log2FC|>0.25 AND p_val_adj<0.05), immune-only top ---")
imm2 = res[res["immune"]].sort_values("n_sig_padj<0.05_and_|fc|>0.25", ascending=False)
print(imm2.head(8).to_string(index=False))

winner = imm.iloc[0]
winner_sens = imm2.iloc[0]
print("\n=== RESULT ===")
print(f"Top immune cell type (p_val_adj<0.05): {winner['cell_type']} "
      f"with {winner['n_sig_padj<0.05']} significantly DE genes "
      f"(of {winner['n_genes']} listed)")
print(f"Sensitivity winner (|log2FC|>0.25 & padj<0.05): {winner_sens['cell_type']} "
      f"with {winner_sens['n_sig_padj<0.05_and_|fc|>0.25']} genes")
print(f"Overall (all 25) top: {res.iloc[0]['cell_type']} "
      f"({res.iloc[0]['n_sig_padj<0.05']} genes)")

# Persist the ranked table for evidence
res.to_csv("deg_counts_by_cell_type.csv", index=False)
print("\nSaved: deg_counts_by_cell_type.csv")
