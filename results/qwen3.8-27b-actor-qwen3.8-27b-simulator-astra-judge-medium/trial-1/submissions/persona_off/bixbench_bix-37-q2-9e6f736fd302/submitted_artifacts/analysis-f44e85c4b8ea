import openpyxl, math, os

path = "data/Proteomic_data .xlsx"
wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
ws = wb["Tumor vs Normal"]

rows = ws.iter_rows(values_only=True)
hdr = list(next(rows))
idx_gene = hdr.index("gene")
idx_normal = hdr.index("Normal")
idx_protein = hdr.index("protein")

eno = [r for r in rows if str(r[idx_gene]).strip() == "ENO1"]
assert len(eno) == 1, f"Expected 1 ENO1 row, got {len(eno)}"
val = float(eno[0][idx_normal])
protein = eno[0][idx_protein]

def round_sig(x, sig=3):
    if x == 0:
        return 0.0
    return round(x, -int(math.floor(math.log10(abs(x)))) + (sig - 1))

rounded = round_sig(val, 3)
print("protein:", protein)
print("raw Normal:", val)
print("3 sig figs:", rounded)
print("scientific: {:.2e}".format(rounded))
