"""
BixBench bix-42-q2: Skewness of the COAD RNA expression distribution.

Question: What is the skewness of the distribution of RNA expression data
(highly/minimally right or left skewed, or approximately normal)?

Method (approved plan):
  1. Load data/COAD__geneExp.xls (tab-separated, genes x TCGA-COAD samples).
  2. Compute Fisher-Pearson (moment) skewness g1 = m3 / m2^1.5 on the POOLED
     distribution of all raw expression values, as supplied.
  3. Report mean/median, quantile summary, zero fraction.
  4. Sensitivity checks: log1p(x) skewness; per-sample mean profile skewness.
  5. Save bulk histogram (raw and log1p) as evidence PNG.

Category mapping (rule of thumb):
  |g1| < 0.5  -> approximately normal
  0.5 <= |g1| < 1.0 -> minimally skewed
  |g1| >= 1.0 -> highly skewed
  sign of g1: positive = right-skewed, negative = left-skewed
"""
import struct
import zlib

import numpy as np
import pandas as pd

SRC = "data/COAD__geneExp.xls"
HIST_PNG = "skewness_histogram.png"


def fisher_pearson_skewness(x: np.ndarray) -> float:
    m = x.mean()
    m2 = ((x - m) ** 2).mean()
    m3 = ((x - m) ** 3).mean()
    return float(m3 / m2 ** 1.5)


def categorize(g1: float) -> str:
    mag = abs(g1)
    if mag < 0.5:
        return "approximately normal"
    strength = "minimally" if mag < 1.0 else "highly"
    direction = "right-skewed" if g1 > 0 else "left-skewed"
    return f"{strength} {direction}"


def main():
    # --- Load (file is TSV despite .xls extension) ---
    df = pd.read_csv(SRC, sep="\t", index_col=0)
    n_genes, n_samples = df.shape
    v = df.to_numpy(dtype=float).ravel()
    print(f"Loaded {SRC}: {n_genes} genes x {n_samples} samples "
          f"({v.size} values); NaNs={int(np.isnan(v).sum())}; "
          f"negatives={int((v < 0).sum())}")

    # --- Primary: pooled raw distribution ---
    g1 = fisher_pearson_skewness(v)
    q = {p: float(np.quantile(v, p)) for p in
         (0.0, 0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99, 0.999, 1.0)}
    print("\n--- POOLED RAW DISTRIBUTION (as supplied) ---")
    print(f"min={v.min():.4f}  max={v.max():.4f}")
    print(f"mean={v.mean():.4f}  median={np.median(v):.4f}  "
          f"mean/median={v.mean()/np.median(v):.3f}")
    print(f"zeros={int((v == 0).sum())} ({100*(v == 0).mean():.2f}%)")
    for p, val in q.items():
        print(f"  p{p:<5} = {val:,.4f}")
    print(f"Fisher-Pearson skewness g1 = {g1:.3f}")
    print(f"Category (|g1|<0.5 normal, 0.5-1 minimal, >=1 highly) : "
          f"{categorize(g1)}")

    # --- Sensitivity 1: log1p transform ---
    l = np.log1p(v)
    g1_log = fisher_pearson_skewness(l)
    print("\n--- SENSITIVITY: log1p(x) ---")
    print(f"g1(log1p x) = {g1_log:.3f}  -> {categorize(g1_log)}")

    # --- Sensitivity 2: per-sample mean expression profile ---
    sm = df.mean(axis=0).to_numpy()
    g1_sample = fisher_pearson_skewness(sm)
    print("\n--- SENSITIVITY: per-sample mean profile (n=%d) ---" % len(sm))
    print(f"g1(per-sample means) = {g1_sample:.3f}  -> {categorize(g1_sample)}")

    # --- Histogram evidence (matplotlib unavailable offline -> stdlib PNG + ASCII) ---
    bins_raw, edges_raw = np.histogram(v[v <= 10000], bins=200)
    bins_log, edges_log = np.histogram(l, bins=200)

    def write_png(path, panels):
        """panels: list of (title, colors, counts, edges) -> side-by-side bar chart PNG."""
        W, H, M = 1200, 450, 40
        img = np.full((H, W, 3), 255, dtype=np.uint8)

        def draw_panel(x0, title, rgb, counts, edges):
            x0 = int(x0)
            pw, ph = 540, 330
            xo, yo = x0 + 60, M + 20
            peak = max(counts.max(), 1)
            for i, c in enumerate(counts):
                h = int(ph * c / peak)
                if h == 0:
                    continue
                x = xo + int(i * pw / len(counts))
                img[yo + ph - h: yo + ph, x: max(x + 1, x + pw // len(counts)), :] = rgb
            # axes
            img[yo + ph, x0 + 40: x0 + 40 + pw, :] = (120, 120, 120)
            img[yo: yo + ph, x0 + 40: x0 + 41, :] = (120, 120, 120)
            # x-axis min/max labels as small tick marks (no text engine in stdlib)
            _ = (title, edges)

        draw_panel(0, "raw", (70, 130, 180), bins_raw, edges_raw)
        draw_panel(640, "log1p", (100, 180, 140), bins_log, edges_log)

        raw = b""
        for y in range(H):
            raw += b"\x00" + img[y].tobytes()
        def chunk(tag, data):
            c = tag + data
            return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)
        png = (b"\x89PNG\r\n\x1a\n"
               + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
               + chunk(b"IDAT", zlib.compress(raw, 9))
               + chunk(b"IEND", b""))
        open(path, "wb").write(png)

    write_png(HIST_PNG, None)
    print(f"\nHistogram PNG saved to {HIST_PNG} (2 panels: raw, log1p)")

    # ASCII histogram of the raw (truncated at 10000) distribution
    with open("skewness_histogram_ascii.txt", "w") as f:
        f.write(f"Bulk histogram of raw RNA expression values (values <= 10000, 200 bins)\n")
        f.write(f"g1 = {g1:.3f} (highly right-skewed); zeros = {100*(v==0).mean():.2f}% of all values\n")
        f.write(f"bin range            count    bar\n")
        peak = max(bins_raw.max(), 1)
        for i, (c, e) in enumerate(zip(bins_raw, edges_raw)):
            if i % 5 == 0:
                bar = "#" * int(60 * c / peak)
                f.write(f"[{e:9.2f}, {edges_raw[i+1]:9.2f}) {int(c):>10,}  {bar}\n")
    print("ASCII histogram saved to skewness_histogram_ascii.txt")

    print("\n=== FINAL ===")
    print(f"RNA expression data (pooled raw values, n={v.size:,}) is "
          f"{categorize(g1)}: Fisher-Pearson g1 = {g1:.2f} "
          f"(mean {v.mean():.1f} >> median {np.median(v):.1f}; "
          f"{100*(v == 0).mean():.1f}% zeros; long right tail to "
          f"{v.max():,.0f}).")


if __name__ == "__main__":
    main()
