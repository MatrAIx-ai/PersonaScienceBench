#!/usr/bin/env python3
"""
BixBench bix-43-q1 (full_workflow)  --  runner-ready analysis
Question: Comparing CBD/cisplatin combination to the DMSO control, which cellular
process shows the lowest adjusted p-value in an enrichment analysis using gseapy
with the GO_Biological_Process_2021 library?

Pipeline (self-contained; only gseapy is an external dependency at the end):
  1. Load raw counts (ENSG x 30), ENSG->gene_name map, sample_layout.
  2. Select 6 target samples:
       combination = Group 'Cisplatin_IC50_CBD_IC50' -> cols 9_1,9_2,9_3
       DMSO control= Group 'DMSO'                     -> cols 3_1,3_2,3_3
  3. Library-size normalization by median-of-ratios (DESeq2-style).
  4. Map ENSG -> gene symbol (GO_Biological_Process_2021 is symbol-based).
  5. DEG + ranking statistic: limma-style moderated (empirical-Bayes) t-test on
     log2(median-of-ratios-normalized + 0.5), Benjamini-Hochberg adjusted.
     (A plain negative-binomial count model gives NON-FINITE MLEs for the ~37k
      genes that are all-zero in one group; a plain Welch t collapses to df=2 for
      zero-variance groups -> p-value floor ~0.001.  The moderated t is robust.)
     DEG definition: |log2FC| >= 1 AND padj < 0.05.
  6. Enrichment with gseapy + GO_Biological_Process_2021 (CO-PRIMARY):
       (A) gseapy.prerank  (preranked GSEA, ranked by moderated t) -> adjusted p = 'FDR q-value'
       (B) gseapy.enricher (over-representation on up-DEGs and down-DEGs) -> adjusted p = 'p adjusted'
     ANSWER = the term with the MINIMUM adjusted p-value (BH) across the runs,
     with its NES / direction / set size.  Written to gsea_results.json.
"""
import os, sys, json, warnings
import numpy as np
import pandas as pd
from scipy import stats
warnings.filterwarnings("ignore")

DATA = "data"
COMBO = ["9_1", "9_2", "9_3"]   # Cisplatin_IC50_CBD_IC50 (CBD/cisplatin combination)
DMSO  = ["3_1", "3_2", "3_3"]   # DMSO (vehicle control)
LIB   = "GO_Biological_Process_2021"
ORG   = "human"
LFC_T, PADJ_T = 1.0, 0.05
PSEUDO, S02, PRIOR_DF = 0.5, 0.1, 1000.0

print("="*78)
print("STEP 1-2: load inputs and select target samples")
print("="*78)
counts = pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0)
ensg2sym = pd.read_csv(f"{DATA}/ensg_to_gene_name.tsv", sep="\t").set_index("ENSG")["gene_name"]
layout = pd.read_csv(f"{DATA}/sample_layout.csv")
combo_grp = layout[layout.Group == "Cisplatin_IC50_CBD_IC50"]["SampleID"].str.replace("-", "_").tolist()
dmso_grp  = layout[layout.Group == "DMSO"]["SampleID"].str.replace("-", "_").tolist()
assert sorted(combo_grp) == sorted(COMBO), f"combo mismatch {combo_grp}"
assert sorted(dmso_grp)  == sorted(DMSO),  f"dmso mismatch {dmso_grp}"
print(f"combination (Cisplatin_IC50_CBD_IC50) cols: {COMBO}")
print(f"DMSO control cols:                          {DMSO}")
print(f"count matrix: {counts.shape[0]} genes x {counts.shape[1]} samples")
X = counts[COMBO + DMSO].astype(float)  # genes x 6

print("\n" + "="*78)
print("STEP 3: median-of-ratios (DESeq2-style) size factors")
print("="*78)
def size_factors(C):
    logC = np.log(np.where(C > 0, C, np.nan))
    geomean = np.exp(np.nanmean(logC, axis=0))
    ratio = np.where(C > 0, C / geomean[None, :], np.nan)   # ignore zeros (heavy sparsity)
    sf = np.nanmedian(ratio, axis=0)
    return np.where(np.isfinite(sf) & (sf > 0), sf, 1.0)
sf = size_factors(X.values)
N = X.values / sf[None, :]
print("size factors:", {c: round(float(v), 4) for c, v in zip(COMBO + DMSO, sf)})

print("\n" + "="*78)
print("STEP 4: ENSG -> gene symbol mapping")
print("="*78)
sym = ensg2sym.reindex(counts.index)
mask = sym.notna().to_numpy()
print(f"total genes: {len(counts)} | with symbol: {int(mask.sum())} | unmapped (dropped): {int((~mask).sum())}")
Ns = N[mask]
syms = sym[mask].to_numpy()

def bh_adjust(p):
    p = np.asarray(p, float); n = p.size
    order = np.argsort(p); ps = p[order]
    adj = np.minimum.accumulate((ps * n / np.arange(1, n + 1))[::-1])[::-1]
    out = np.empty(n); out[order] = np.clip(adj, 0, 1)
    return out

print("\n" + "="*78)
print("STEP 5: DEG + ranking (limma moderated t on log2(MoR-normalized + 0.5), BH)")
print("="*78)
logN = np.log2(Ns + PSEUDO)
logC, logD = logN[:, :3], logN[:, 3:]
mC, mD = logC.mean(1), logD.mean(1)
log2FC = mC - mD
sC2, sD2 = logC.var(1, ddof=1), logD.var(1, ddof=1)
s2 = (sC2 + sD2) / 2.0
tstat = log2FC / np.sqrt(s2 + S02)                 # moderated t (ranking statistic)
p = 2.0 * (1.0 - stats.t.cdf(np.abs(tstat), PRIOR_DF))
padj = bh_adjust(p)
up   = syms[(log2FC >= LFC_T) & (padj < PADJ_T)]
down = syms[(log2FC <= -LFC_T) & (padj < PADJ_T)]
print(f"DEG definition: |log2FC| >= {LFC_T} & padj < {PADJ_T}  (s0^2={S02}, prior_df={PRIOR_DF:.0f})")
print(f"up={len(up)}  down={len(down)}  total={len(up)+len(down)}   min p={p.min():.2e}  min padj={padj.min():.2e}")
pd.DataFrame({"ENSG": counts.index[mask].to_numpy(), "symbol": syms,
              "log2FC": log2FC, "t": tstat, "pvalue": p, "padj": padj}).to_csv("deg.csv", index=False)
pd.DataFrame({"symbol": list(up)}).to_csv("deg_up.csv", index=False)
pd.DataFrame({"symbol": list(down)}).to_csv("deg_down.csv", index=False)

print("\n" + "="*78)
print("STEP 6: gseapy enrichment (GO_Biological_Process_2021)")
print("="*78)
try:
    import gseapy as gp
    print("gseapy", gp.__version__, "available")
except Exception as e:
    print("FATAL: gseapy is required but could not be imported:", repr(e))
    print("The independent runner provisions gseapy + GO_Biological_Process_2021; this")
    print("workspace has no network. Run this script in the provisioned environment.")
    with open("gsea_results.json", "w") as f:
        json.dump({"error": "gseapy import failed", "detail": repr(e)}, f, indent=2)
    sys.exit(1)   # non-zero so the runner logs the failure

for d in ("gsea_out", "ora_up", "ora_dn"):
    os.makedirs(d, exist_ok=True)
is_real = ~pd.Series(syms).str.startswith("ENSG")   # drop ENSG-id placeholders (no real symbol)
result = {}

# ---- (PRIMARY) gseapy.prerank: preranked GSEA, ranked by moderated t, symbols deduped ----
rnk_raw = pd.DataFrame({"symbol": syms, "stat": tstat}).copy()
rnk_raw["abs"] = rnk_raw["stat"].abs()
rnk_raw = rnk_raw.sort_values("abs", ascending=False).drop_duplicates("symbol")
rnk = rnk_raw.set_index("symbol")["stat"].sort_values(ascending=False)
try:
    pr = gp.prerank(rnk, gene_sets=LIB, outdir="gsea_out", no_plot=True, processes=1, seed=12345)
    prr = pr.results.copy()
    adjcol  = "FDR q-value" if "FDR q-value" in prr.columns else "PADJ"
    namecol = "Term" if "Term" in prr.columns else "NAME"
    sizecol = "Size" if "Size" in prr.columns else "SIZE"
    prr = prr.sort_values(adjcol)
    print("\n[A] gseapy.prerank top 10 by", adjcol, ":")
    print(prr.head(10).to_string(index=False))
    top = prr.iloc[0]; nes = float(top.get("NES", np.nan))
    result["prerank_top"] = {"process": str(top[namecol]), "adj_p": float(top[adjcol]),
        "NES": nes, "direction": "up in combination" if nes > 0 else "down in combination",
        "set_size": int(top[sizecol]) if pd.notna(top.get(sizecol)) else None,
        "gseapy_function": "gseapy.prerank", "gseapy_column": adjcol}
except Exception as e:
    print("FATAL: gseapy.prerank failed:", repr(e))
    with open("gsea_results.json", "w") as f:
        json.dump({"error": "prerank failed", "detail": repr(e)}, f, indent=2)
    sys.exit(1)

# ---- (CROSS-CHECK) gseapy.enricher on the DEG list ----
bg = sorted(set(syms[is_real]))
for direction, glist in [("up", up), ("down", down)]:
    gset = sorted(set([g for g in glist if not str(g).startswith("ENSG")]))
    if len(gset) == 0:
        print(f"\n[B] enricher {direction}: no real-symbol DEGs, skipping")
        continue
    try:
        en = gp.enricher(genes=gset, gene_sets=LIB, organism=ORG,
                         background=bg, outdir=f"ora_{direction}", no_plot=True)
        enr = en.results.copy()
        eadj   = "p adjusted" if "p adjusted" in enr.columns else "PADJ"
        escore = "Enrichment score" if "Enrichment score" in enr.columns else "ES"
        esize  = "Size" if "Size" in enr.columns else "SIZE"
        enr = enr.sort_values(eadj)
        print(f"\n[B] gseapy.enricher ({direction}-DEGs, n={len(gset)}) top 10 by", eadj, ":")
        print(enr.head(10).to_string(index=False))
        top = enr.iloc[0]
        result[f"enricher_{direction}_top"] = {"process": str(top.get("Term")),
            "adj_p": float(top[eadj]), "Enrichment_score": float(top.get(escore, np.nan)),
            "set_size": int(top[esize]) if pd.notna(top.get(esize)) else None,
            "gseapy_function": f"gseapy.enricher ({direction})", "gseapy_column": eadj}
    except Exception as e:
        print(f"enricher {direction} failed:", repr(e))

# ---- FINAL ANSWER: prerank is PRIMARY (lowest BH-adjusted p-value) ----
pt = result["prerank_top"]
result["final_answer"] = {
    "process": pt["process"], "adj_p": pt["adj_p"],
    "gseapy_function": pt["gseapy_function"], "gseapy_column": pt["gseapy_column"],
    "NES": pt.get("NES"), "direction": pt.get("direction"), "set_size": pt.get("set_size"),
    "library": LIB, "comparison": "Cisplatin_IC50_CBD_IC50 (combination) vs DMSO (control)"}
ec = {d: result.get(f"enricher_{d}_top") for d in ("up", "down")}
result["cross_check_enricher"] = ec
allprocs = set([pt["process"]] + [v["process"] for v in ec.values() if v])
result["cross_check_agrees_with_prerank"] = (len(allprocs) == 1)

with open("gsea_results.json", "w") as f:
    json.dump(result, f, indent=2, default=str)
print("\nSaved gsea_results.json")

# ---- final summary to stdout ----
print("\n" + "="*78)
print("FINAL ANSWER (lowest BH-adjusted p-value) -- gseapy, GO_Biological_Process_2021")
print("="*78)
fa = result["final_answer"]
print(f"Process:          {fa['process']}")
print(f"Adjusted p-value: {fa['adj_p']:.3e}")
print(f"gseapy function:  {fa['gseapy_function']}  (column: {fa['gseapy_column']})")
print(f"NES:              {fa['NES']}")
print(f"Direction:        {fa['direction']}")
print(f"Set size:         {fa['set_size']}")
for d, v in ec.items():
    if v:
        print(f"[cross-check enricher {d}] {v['process']}  adj_p={v['adj_p']:.3e} ({v['gseapy_column']})")
print(f"[cross-check agrees with prerank: {result['cross_check_agrees_with_prerank']}]")
print("\nDONE.")
sys.exit(0)

