#!/usr/bin/env python3
"""
Reproducible pipeline for bix-43-q2.
Q: odds ratio for 'p53-mediated cell cycle gene regulation' in gseapy Reactome_2022
   enrichment, using all DE genes (raw p<0.05, |log2FC|>0.5, baseMean>10) between
   CBD/cisplatin combination (Group 9) and DMSO (Group 3).

Steps:
  1) DESeq2 (R) for DE  -> de_genes_ensg.txt
  2) ENSG -> gene symbol mapping
  3) gseapy.enrichr(gene_sets='Reactome_2022', organism='Human')
  4) report the 'Odds Ratio' for the p53 / cell-cycle term
"""
import subprocess, sys, os, re
import pandas as pd

# ---- Step 1: DESeq2 DE (R) ----
print("=== STEP 1: DESeq2 (R) ===", flush=True)
r = subprocess.run(["Rscript", "deseq2_de.R"], capture_output=True, text=True)
print(r.stdout)
if r.returncode != 0:
    print("R STDERR:", r.stderr)
    print("DESeq2 step FAILED (R/DESeq2 unavailable). Cannot continue to real gseapy path.")
    sys.exit(1)

with open("de_genes_ensg.txt") as f:
    de_ensg = [l.strip() for l in f if l.strip()]
print(f"DE genes (ENSG): {len(de_ensg)}")

# ---- Step 2: ENSG -> symbol ----
print("=== STEP 2: ID -> symbol mapping ===", flush=True)
ensg2sym = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t").set_index("ENSG")["gene_name"]
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
universe = sorted(set(ensg2sym.loc[counts.index.intersection(ensg2sym.index)].tolist()))
de_symbols = sorted(set(ensg2sym.loc[[e for e in de_ensg if e in ensg2sym.index]].tolist()))
print(f"universe (all mappable symbols in matrix): {len(universe)}")
print(f"DE symbols passed to enrichment: {len(de_symbols)} "
      f"(of {len(de_ensg)} DE ENSG, {len(de_ensg)-len(de_symbols)} unmapped)")

# ---- Step 3: gseapy.enrichr (Reactome_2022) ----
print("=== STEP 3: gseapy.enrichr Reactome_2022 ===", flush=True)
try:
    import gseapy as gp
except Exception as e:
    print("gseapy import FAILED:", repr(e))
    print("gseapy unavailable (and no network to Enrichr). Cannot run real enrichment.")
    sys.exit(2)

enr = gp.enrichr(genes=list(de_symbols), gene_sets="Reactome_2022",
                 organism="Human", gene_universe=list(universe),
                 outdir=None, no_plot=True)
res = enr.res2d.copy()
print("Result columns:", list(res.columns))

# ---- Step 4: find p53 / cell-cycle term ----
print("=== STEP 4: locate term ===", flush=True)
mask = res["Term"].str.lower().str.contains("p53") & \
       res["Term"].str.lower().str.contains("cell cycle")
sel = res[mask]
print("Matched rows:\n", sel.to_string(index=False))
if len(sel) == 0:
    print("No term matched 'p53'+'cell cycle'; showing all p53 terms:")
    print(res[res["Term"].str.lower().str.contains("p53")][["Term","Odds Ratio","P-Value"]].to_string(index=False))
    sys.exit(3)
row = sel.iloc[0]
print("\n=== FINAL ANSWER ===")
print("Term        :", row["Term"])
print("Odds Ratio  :", row["Odds Ratio"])
print("Full row:")
print(row.to_string())
