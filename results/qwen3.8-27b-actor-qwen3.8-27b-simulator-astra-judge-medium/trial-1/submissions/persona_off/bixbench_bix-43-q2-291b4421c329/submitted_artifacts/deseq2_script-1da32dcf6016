#!/usr/bin/env Rscript
# DESeq2 DE: CBD/cisplatin combination (Group 'Cisplatin_IC50_CBD_IC50') vs DMSO
suppressMessages({
  if (!requireNamespace("DESeq2", quietly=TRUE)) stop("DESeq2 not installed")
})
counts <- as.matrix(read.csv("data/counts_raw_unfiltered.csv", row.names=1, check.names=FALSE))
layout <- read.csv("data/sample_layout.csv")
colnames(counts) <- sub("_", "-", colnames(counts))   # 1_1 -> 1-1
stopifnot(all(colnames(counts) %in% layout$SampleID))
layout <- layout[match(colnames(counts), layout$SampleID), ]
colData <- data.frame(condition=layout$Group, row.names=layout$SampleID)
colData$condition <- relevel(colData$condition, ref="DMSO")
dds <- DESeqDataSetFromMatrix(countData=counts, colData=colData, design=~condition)
dds <- dds[rowSums(counts[rownames(dds)]) > 0, ]
dds <- DESeq(dds)
res <- results(dds, contrast=c("condition","Cisplatin_IC50_CBD_IC50","DMSO"))
res <- as.data.frame(res)
# Locked filters: RAW pvalue < 0.05, |log2FoldChange| > 0.5, baseMean > 10, BOTH directions
sig <- res[!is.na(res$pvalue) & res$pvalue < 0.05 & abs(res$log2FoldChange) > 0.5 & res$baseMean > 10, ]
writeLines(rownames(sig), "de_genes_ensg.txt")
cat("N_RAW_GENES_IN_MATRIX=", nrow(counts), "\n")
cat("N_DESIG_GENES=", nrow(sig), "\n")
cat("N_UP=", sum(sig$log2FoldChange > 0), "\n")
cat("N_DOWN=", sum(sig$log2FoldChange < 0), "\n")
