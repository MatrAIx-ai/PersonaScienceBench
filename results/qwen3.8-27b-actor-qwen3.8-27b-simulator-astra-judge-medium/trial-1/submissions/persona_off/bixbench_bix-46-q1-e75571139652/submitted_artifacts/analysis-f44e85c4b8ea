#!/usr/bin/env python3
"""
mexG log2 fold change in Delta-rhlI (strain #97) vs wt (strain #1).

Inputs:
  data/res_1vs97.rds  : DESeq2 'results' object (big-endian R serialization).
                        Genes keyed by LOCUS TAG in rowNames; rowData columns
                        = baseMean, log2FoldChange, lfcSE, stat, pvalue, padj.
  data/Pseudomonas_aeruginosa_UCBPP-PA14.csv : annotation; maps Gene Name -> Locus Tag.

The .rds is a DESeq2 results object (class "DESeq2"); its log2FoldChange column is
the MLE log2FC for "Strain 97 vs 1" (verified from the object's own metadata), which
is exactly the requested direction (Delta-rhlI #97 vs wt #1). No sign flip needed.

R is not installed here and there is no internet, so we parse the big-endian R
serialization directly in Python. The parse is cross-validated (see checks below).
"""
import gzip, struct, re, csv, math, sys

RDS = "data/res_1vs97.rds"
CSV = "data/Pseudomonas_aeruginosa_UCBPP-PA14.csv"
GENE = "mexG"

# ---------------------------------------------------------------------------
# (1) Map gene name -> locus tag from the annotation CSV (must be a single match)
# ---------------------------------------------------------------------------
with open(CSV, newline="") as f:
    rows = [r for r in csv.DictReader(f) if (r["Gene Name"] or "").strip() == GENE]
assert len(rows) == 1, f"expected exactly 1 '{GENE}' in CSV, found {len(rows)}"
locus = rows[0]["Locus Tag"].strip()
print(f"[csv] {GENE} -> Locus Tag = {locus}  (Product: {rows[0]['Product Name'].strip()})")

# ---------------------------------------------------------------------------
# (2) Load the big-endian R-serialized results object
# ---------------------------------------------------------------------------
raw = gzip.open(RDS, "rb").read()
print(f"[rds] decompressed size = {len(raw)} bytes")

# ---------------------------------------------------------------------------
# (3) Re-verify the contrast DIRECTION from the object's own metadata
# ---------------------------------------------------------------------------
assert raw.count(b"Strain 97 vs 1") >= 1, "'Strain 97 vs 1' not found in metadata"
assert raw.count(b"Strain 1 vs 97") == 0, "unexpected 'Strain 1 vs 97' in metadata"
i = raw.find(b"log2 fold change")
desc = raw[i:i+40].decode("utf-8", "replace").rstrip("\x00")
print(f"[rds] metadata: '{desc}'  -> direction is #97 vs #1 (matches question)")

# ---------------------------------------------------------------------------
# (4) Extract rowNames (ordered locus tags) and locate mexG's row
# ---------------------------------------------------------------------------
rowNames = [m.group().decode() for m in re.finditer(rb"PA14_\d{5}", raw)]
n = len(rowNames)
assert locus in rowNames, f"{locus} not present in rowNames"
idx = rowNames.index(locus)
print(f"[rds] n genes = {n}; rowNames[0] = {rowNames[0]}; {locus} at row index {idx}")

# ---------------------------------------------------------------------------
# (5) Locate the 6 numeric column vectors (big-endian: [4B count=n][n x 8B double])
# ---------------------------------------------------------------------------
count_be = struct.pack(">i", n)
def is_finite_run(p):
    d0 = p + 4
    try:
        for k in range(n):
            v = struct.unpack_from(">d", raw, d0 + 8*k)[0]
            if v != v or v in (float("inf"), float("-inf")):
                return False
    except struct.error:
        return False
    return True

starts = [m.start() for m in re.finditer(re.escape(count_be), raw) if is_finite_run(m.start())]
# The 6 rowData columns are 6 consecutive, equally-spaced count positions.
# (Each vector = [4B header][4B count=n][8n doubles], so spacing = 8 + 8n.)
best, i = [], 0
while i < len(starts):
    j = i
    if j + 1 < len(starts):
        d = starts[j+1] - starts[j]
        while j + 1 < len(starts) and starts[j+1] - starts[j] == d:
            j += 1
    run = starts[i:j+1]
    if len(run) > len(best):
        best = run
    i = j + 1
assert len(best) == 6, f"expected a run of 6 column vectors, got {len(best)}: {best}"
colvec = best
print(f"[rds] 6 column-vector starts = {colvec}")

def col(p):
    return [struct.unpack_from(">d", raw, p + 4 + 8*k)[0] for k in range(n)]
cols = [col(p) for p in colvec]
order = ["baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]

# ---------------------------------------------------------------------------
# (6) Cross-validate the parse
# ---------------------------------------------------------------------------
def finite(v): return [x for x in v if x == x]
bm, lfc, se, st, pv, adj = cols
checks = {}
checks["baseMean all > 0"]            = all(x > 0 for x in bm)
checks["lfcSE all > 0"]               = all(x > 0 for x in se)
checks["pvalue all in [0,1]"]         = all(0.0 <= x <= 1.0 for x in pv)
checks["padj in [0,1] (ignoring NA)"] = all(0.0 <= x <= 1.0 for x in finite(adj))
# Wald statistic identity: stat == log2FoldChange / lfcSE
bad = sum(1 for a, b, c in zip(lfc, se, st) if b != 0 and abs(c - a/b) > 1e-6*max(1.0, abs(c)))
checks["stat == lfc/lfcSE (all rows)"] = (bad == 0)
for k, v in checks.items():
    print(f"[check] {k:32s} : {v}")
assert all(checks.values()), "parse validation failed"

# ---------------------------------------------------------------------------
# (7) Read mexG's log2FoldChange and round to 2 decimals
# ---------------------------------------------------------------------------
val = lfc[idx]
raw_repr = repr(val)
rounded = round(val, 2)
print("\n================ RESULT ================")
print(f"gene            : {GENE}  (locus tag {locus}, row {idx})")
print(f"comparison      : Strain 97 (Delta-rhlI) vs Strain 1 (wt)  [MLE log2FC]")
print(f"baseMean        : {bm[idx]:.6g}")
print(f"log2FoldChange  : {raw_repr}")
print(f"lfcSE           : {se[idx]:.6g}")
print(f"stat            : {st[idx]:.6g}")
print(f"pvalue          : {pv[idx]:.6g}")
print(f"padj            : {adj[idx] if adj[idx]==adj[idx] else 'NA'}")
print(f"ROUND(val,2)    : {rounded}")
print(f"formatted       : {rounded:.2f}")
print("========================================")
