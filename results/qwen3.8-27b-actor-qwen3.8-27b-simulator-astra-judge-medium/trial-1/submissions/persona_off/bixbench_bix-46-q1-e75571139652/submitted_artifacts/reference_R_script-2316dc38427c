# Canonical R/DESeq2 approach (reference / cross-check).
# The executed, verifiable artifact in this sandbox is mexG_log2fc.py
# (R is not installed here and there is no internet to install it).
# In an environment with R + DESeq2 this one-liner gives the same answer.

res <- readRDS("data/res_1vs97.rds")          # DESeq2 'results' object (class "DESeq2")
ann <- read.csv("data/Pseudomonas_aeruginosa_UCBPP-PA14.csv")
locus <- ann$Locus.Tag[ann$`Gene Name` == "mexG"]   # "PA14_09540"  (single match)

# results() object: rowNames are locus tags; log2FoldChange is the MLE for
# "Strain 97 vs 1" (Delta-rhlI #97 vs wt #1) -- exactly the requested direction.
df  <- as.data.frame(res)                      # cols: baseMean, log2FoldChange, lfcSE, stat, pvalue, padj
val <- df[locus, "log2FoldChange"]

cat("locus tag :", locus, "\n")
cat("raw log2FC:", val, "\n")
cat("rounded   :", round(val, 2), "\n")        # -4.96
