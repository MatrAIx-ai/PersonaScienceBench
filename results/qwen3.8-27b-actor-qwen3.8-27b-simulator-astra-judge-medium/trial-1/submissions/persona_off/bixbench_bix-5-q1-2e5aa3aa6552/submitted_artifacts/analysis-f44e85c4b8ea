"""
Knowledge-based GO Biological Process enrichment (fallback: no GO db / no network).
- DE UP list (14 symbols) from executed analysis_de.py
- Background = 18,918 unique symbols in the DESeq2 tested set (N)
- Each UP gene mapped to canonical GO BP terms from well-established gene-function
  KNOWLEDGE (NOT a database lookup). Gene-set sizes K are knowledge-based estimates
  of the human gene count per GO BP term (documented below).
- Exact hypergeometric test (scipy), Benjamini-Hochberg across candidate terms.
"""
import numpy as np, pandas as pd
from scipy.stats import hypergeom

N = 18918          # background unique symbols (DESeq2 tested set)
up = open("/workspace/de_up_symbols.txt").read().split()
n = len(up)        # 14
print("UP (DE) list size n =", n)
print("background N =", N)
print("UP genes:", up)

# ---- Knowledge-based annotation: gene -> set of (GO_ID, GO_name) ----
# Only confident, canonical BP assignments. Rationale per gene:
A = {
 "CNTN4":  {"GO:0007155":"cell adhesion","GO:0030183":"neuron differentiation",
            "GO:0045166":"synapse organization","GO:0007267":"cell-cell signaling"},
 "CNTN6":  {"GO:0007155":"cell adhesion","GO:0030183":"neuron differentiation",
            "GO:0045166":"synapse organization","GO:0007267":"cell-cell signaling"},
 "PCDH19": {"GO:0007155":"cell adhesion","GO:0030183":"neuron differentiation",
            "GO:0045166":"synapse organization","GO:0007267":"cell-cell signaling"},
 "TNMD":   {"GO:0030183":"neuron differentiation"},
 "CHRM3":  {"GO:0008015":"G protein coupled receptor signaling pathway",
            "GO:0007267":"cell-cell signaling","GO:0007165":"signal transduction"},
 "GNAO1":  {"GO:0008015":"G protein coupled receptor signaling pathway",
            "GO:0007165":"signal transduction"},
 "KCNIP1": {"GO:0007165":"signal transduction"},
 "KRT17":  {"GO:0009988":"keratinization"},
 "TBX20":  {"GO:0007507":"heart development"},
 "UGT3A2": {"GO:0008357":"glucuronidation"},
 # FRRS1L, LUZP2, MTCO3P12, TRIM55: no confident canonical BP -> unannotated
}

# ---- Knowledge-based human gene-set size estimates (K) per GO BP term ----
K = {
 "GO:0007155": 550,   # cell adhesion
 "GO:0030183": 330,   # neuron differentiation
 "GO:0045166": 150,   # synapse organization
 "GO:0007267": 900,   # cell-cell signaling
 "GO:0008015": 280,   # G protein coupled receptor signaling pathway
 "GO:0007165": 1900,  # signal transduction (broad)
 "GO:0009988": 20,    # keratinization
 "GO:0007507": 120,   # heart development
 "GO:0008357": 15,    # glucuronidation
}
names = {g:v for d in A.values() for g,v in d.items()}

# gather candidate terms (those with >=1 UP gene annotated)
terms = {}
for g, d in A.items():
    for go, nm in d.items():
        terms.setdefault(go, set()).add(g)

rows=[]
for go, genes in terms.items():
    k = len(genes)
    Kt = K[go]
    # exact hypergeometric P(X >= k)
    p = hypergeom.sf(k-1, N, Kt, n)   # sf(x) = P(X > x)
    rows.append({"GO":go,"name":names[go],"k":k,"K":Kt,"p":p,"genes":sorted(genes)})
df = pd.DataFrame(rows)

# BH across candidate terms
m = len(df); o = np.argsort(df["p"].values); r = np.arange(1,m+1)
ps = df["p"].values[o]; adj = np.minimum.accumulate(ps*m/r)[::-1][::-1]
adj = np.clip(adj,0,1); df_sorted = df.iloc[o]; df_sorted["padj"] = adj
df_sorted = df_sorted.sort_values("padj")

print("\n=== Knowledge-based GO BP enrichment (hypergeometric + BH) ===")
print(f"{'GO ID':<12}{'term':<42}{'k':>3}{'K':>5}{'p.value':>12}{'p.adjust':>12}")
for _,t in df_sorted.iterrows():
    print(f"{t['GO']:<12}{t['name']:<42}{t['k']:>3}{t['K']:>5}{t['p']:>12.3e}{t['padj']:>12.3e}")

top = df_sorted.iloc[0]
print("\n=== MOST ENRICHED GO BP (knowledge-based) ===")
print("term        :", top["name"])
print("GO ID       :", top["GO"])
print("p.value     :", f"{top['p']:.4e}")
print("p.adjust(BH):", f"{top['padj']:.4e}")
print("Count (k)   :", int(top["k"]), "of n=", n)
print("gene set K  :", int(top["K"]), "(estimate)  | background N =", N)
print("enrichment FC (obs/exp):", f"{top['k']/ (n*top['K']/N):.2f}")
print("genes       :", top["genes"])
print("\nCoverage: UP genes annotated to >=1 BP =", sum(1 for g in up if g in A), "of", n,
      "| unannotated:", [g for g in up if g not in A])
