"""
DESeq2-equivalent differential expression (Python, scipy).
Primary model: design ~ condition (disease vs control), 14 metadata-labeled samples.
- Median-of-ratios size-factor normalization
- Per-gene negative-binomial GLM (MLE on beta + size a), Wald test on condition coef
- Benjamini-Hochberg FDR
Outputs: DE results CSV + up/down/combined gene lists (Ensembl -> symbol via Gencode).
"""
import numpy as np, pandas as pd
from scipy.optimize import minimize
from scipy.special import gammaln
from scipy import stats

DATA = "/workspace/data"
OUT  = "/workspace"

# ---- load counts ----
mat = pd.read_csv(f"{DATA}/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt",
                  sep=r"\s+", index_col=0)
meta = pd.read_excel(f"{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx")
labeled = list(meta["sample"])                 # 14 labeled samples
dropped = [c for c in mat.columns if c not in set(labeled)]
mat = mat[labeled].astype(float)
print("matrix cols after dropping unlabeled:", mat.shape[1], "dropped:", dropped)

# ---- low-count filter: >=10 counts in at least 5 samples ----
keep = (mat >= 10).sum(axis=1) >= 5
n_before = mat.shape[0]
mat = mat.loc[keep]
print(f"filter: {n_before} -> {mat.shape[0]} genes (>=10 counts in >=5 samples)")

# ---- design matrix ----
cond = meta.set_index("sample").loc[labeled, "condition"]
x = (cond == "disease").astype(int).values    # 1=disease, 0=control
n = x.size
X = np.column_stack([np.ones(n), x])
print("n disease:", int(x.sum()), "n control:", int(n - x.sum()))

# ---- median-of-ratios size factors ----
geomean = np.exp(np.log(mat.values + 1e-9).mean(axis=0))   # per-sample geomean across genes
ratio = mat.values / geomean[None, :]
sf = np.median(ratio, axis=0)
sf[sf == 0] = 1.0
norm = mat.values / sf[None, :]
print("size factors (2dp):", np.round(sf, 2).tolist())

# ---- per-gene NB GLM MLE ----
def nbl(neg):
    b0, b1, la = neg
    a = np.exp(la)
    mu = np.exp(b0 + b1 * x)
    # NB loglik, size parameter a, mean mu
    ll = (gammaln(y + a) - gammaln(a) - gammaln(y + 1)
          + a * np.log(a / (a + mu)) + y * np.log(mu / (a + mu)))
    return -ll.sum()

results = []
for gi, g in enumerate(mat.index):
    y = mat.values[gi]
    if y.sum() == 0:
        continue
    # Poisson MLE init
    b0 = np.log(np.mean(y[y > 0]) + 1e-6) if (y > 0).any() else 0.0
    # simple init for b1
    d = y[x == 1]; c = y[x == 0]
    b1 = np.log((d.mean() + 1) / (c.mean() + 1)) if c.mean() > 0 else 0.0
    res = minimize(nbl, [b0, b1, 0.0], method="Nelder-Mead",
                   options={"maxiter": 2000, "xatol": 1e-8, "fatol": 1e-8})
    b0, b1, la = res.x
    a = np.exp(la)
    mu = np.exp(b0 + b1 * x)
    # observed information for beta (fix a)
    w = mu / (mu + 1.0 / a)          # NB var = mu + mu^2/a ; I = sum w_i x_i x_i'
    Z = X
    I = (Z.T * w) @ Z
    try:
        cov = np.linalg.inv(I)
        se = np.sqrt(cov[1, 1])
    except np.linalg.LinAlgError:
        se = np.nan
    z = b1 / se if se > 0 else 0.0
    p = 2 * (1 - stats.norm.cdf(abs(z)))
    results.append([g, np.log2(2) * 0 + b1, p, a])   # log2FC = b1
results = pd.DataFrame(results, columns=["gene_id", "log2FC", "pvalue", "disp_size"])
# BH manually (robust)
def bh(p):
    p = np.asarray(p, float); m = len(p); o = np.argsort(p); r = np.arange(1, m + 1)
    adj = np.empty(m); adj[o] = np.minimum.accumulate(p[o] * m / r)[::-1][::-1]
    # standard: adj[i] = min over j>=i of p_sorted[j]*m/j
    ps = p[o]; adj_sorted = ps * m / r
    adj_sorted = np.minimum.accumulate(adj_sorted[::-1])[::-1]
    adj[o] = np.clip(adj_sorted, 0, 1)
    return adj
results["padj"] = bh(results["pvalue"].values)
results.to_csv(f"{OUT}/de_results.csv", index=False)

# ---- map to symbol via Gencode (prefer protein_coding, single stable Ensembl per symbol) ----
gen = pd.read_csv(f"{DATA}/gencode.v31.primary_assembly.genes.csv")
gen = gen[gen["gene_id"].isin(set(results["gene_id"]))].copy()
pc = gen[gen["gene_type"] == "protein_coding"].copy()
oth = gen[gen["gene_type"] != "protein_coding"].copy()
# deterministic: for each symbol, prefer a protein_coding ensembl; else first
pc["rank"] = 0; oth["rank"] = 1
gen2 = pd.concat([pc, oth], ignore_index=True).sort_values(["gene_name", "rank"])
sym2ens = gen2.drop_duplicates("gene_name").set_index("gene_name")["gene_id"].to_dict()
ens2sym = gen2.drop_duplicates("gene_id").set_index("gene_id")["gene_name"].to_dict()

results["symbol"] = results["gene_id"].map(ens2sym)
unmapped = results["symbol"].isna().sum()
print("DE genes total:", len(results), "unmapped to symbol:", unmapped)

# ---- DE lists (primary: UP in disease: log2FC>1 & padj<0.05) ----
up = results[(results["log2FC"] > 1) & (results["padj"] < 0.05)]
down = results[(results["log2FC"] < -1) & (results["padj"] < 0.05)]
comb = results[(results["log2FC"].abs() > 1) & (results["padj"] < 0.05)]
print(f"UP (log2FC>1 & padj<0.05): {len(up)}")
print(f"DOWN (log2FC<-1 & padj<0.05): {len(down)}")
print(f"COMBINED (|log2FC|>1 & padj<0.05): {len(comb)}")
# also log2FC>0 & padj<0.05 (no FC filter) for reference
up0 = results[(results["log2FC"] > 0) & (results["padj"] < 0.05)]
print(f"(ref) UP log2FC>0 & padj<0.05: {len(up0)}")

# background = all genes in tested set that have a symbol
bg_ens = set(results["gene_id"])
bg_sym = set(s for s in results["symbol"].dropna())
print("background (tested set) genes:", len(bg_ens), "unique symbols:", len(bg_sym))

def write_syms(df, name):
    s = df["symbol"].dropna().tolist()
    # unique symbols
    pd.Series(sorted(set(s))).to_csv(f"{OUT}/{name}.txt", index=False, header=False)
    return len(set(s))
print("UP symbols written:", write_syms(up, "de_up_symbols"))
print("DOWN symbols written:", write_syms(down, "de_down_symbols"))
print("COMBINED symbols written:", write_syms(comb, "de_combined_symbols"))

# top up genes
top = up.sort_values("padj").head(15)
print("\nTop UP genes (padj):")
print(top[["symbol", "log2FC", "pvalue", "padj"]].to_string(index=False))
print("\nDONE DE")
