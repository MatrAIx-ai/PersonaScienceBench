#!/usr/bin/env Rscript
# ============================================================================
# BixBench bix-5-q1 : Most enriched GO Biological Process, disease vs control
# PRIMARY pipeline (approved):
#   - 14 metadata-labeled samples (drop MGD1640F, MGD1641F)
#   - DESeq2 on raw integer counts, internal size-factor normalization
#   - design ~ condition (disease vs control)  [NO sex covariate for primary]
#   - UP in disease: log2FC > 1 AND padj < 0.05 (BH)
#   - map Ensembl -> official symbol via Gencode gene_name
#     (prefer protein_coding, single stable Ensembl per symbol)
#   - clusterProfiler enrichGO, ontology=BP, keyType=SYMBOL,
#     background = all symbols in the DESeq2 tested set
#   - "most enriched" = BP term with smallest adjusted p-value (BH)
# Sensitivity checks: down, combined, and design ~ sex + condition.
# ============================================================================
suppressPackageStartupMessages({
  library(DESeq2); library(clusterProfiler); library(dplyr)
})
DATA <- "data"

# ---- load ----
counts <- as.matrix(read.table(file.path(DATA,"Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt"),
                               sep="\\s+", header=TRUE, row.names=1, check.names=FALSE))
counts <- counts[, colnames(counts) %in% c("MGD1544F","MGD1546F","MGD1547F","MGD1548F",
  "MGD1549F","MGD1550F","MGD1551F","MGD1557F","MGD1558F","MGD1560F","MGD1613F",
  "MGD1614F","MGD1615F","MGD1616F")]                    # drop MGD1640F, MGD1641F
counts <- counts[apply(counts,1,any,fun = function(r) any(r>0)), ]
coldata <- readxl::read_excel(file.path(DATA,"Issy_ASXL1_fibro_coldata_gender.xlsx"))
coldata$condition <- relevel(factor(coldata$condition), "control")
coldata$sex       <- factor(coldata$sex)
coldata <- coldata[coldata$sample %in% colnames(counts), ]
rownames(coldata) <- coldata$sample
colnames(counts) <- coldata$sample

# ---- low-count filter (>=10 counts in >=5 samples) ----
keep <- rowSums(counts >= 10) >= 5
counts_f <- counts[keep, ]
cat("filter:", nrow(counts), "->", nrow(counts_f), "genes\n")

# ---- Gencode Ensembl -> symbol (prefer protein_coding, one stable Ensembl/symbol) ----
gen <- read.csv(file.path(DATA,"gencode.v31.primary_assembly.genes.csv"), stringsAsFactors=FALSE)
gen$rank <- ifelse(gen$gene_type=="protein_coding", 0, 1)
gen <- gen[order(gen$gene_name, gen$rank), ]
sym_map <- gen[!duplicated(gen$gene_name), c("gene_id","gene_name")]
ens2sym <- setNames(sym_map$gene_name, sym_map$gene_id)

run_design <- function(design, tag){
  dds <- DESeqDataSetFromMatrix(countData=counts_f, colData=coldata, design=design)
  dds <- DESeq(dds)
  res <- results(dds, contrast=c("condition","disease","control"), alpha=0.05)
  res <- res[order(res$padj), ]
  up   <- res[res$log2FoldChange >  1 & res$padj < 0.05, ]
  down <- res[res$log2FoldChange < -1 & res$padj < 0.05, ]
  comb <- res[abs(res$log2FoldChange) > 1 & res$padj < 0.05, ]
  cat(sprintf("[%s] UP=%d DOWN=%d COMBINED=%d\n", tag, nrow(up), nrow(down), nrow(comb)))
  list(up=up, down=down, comb=comb)
}
r <- run_design(~ condition, "primary ~condition")

# background = all tested-set genes with a mappable symbol
bg_syms <- unique(ens2sym[rownames(counts_f) %in% names(ens2sym)])
cat("background symbols:", length(bg_syms), "\n")

enrich <- function(res, tag){
  ids <- rownames(res)
  ids <- ids[ids %in% names(ens2sym)]
  unmapped <- length(ids) - sum(ens2sym[ids] %in% bg_syms)
  g <- unique(ens2sym[ids])
  g <- g[g %in% bg_syms]
  cat(sprintf("[%s] DE genes=%d  used for GO=%d  dropped(no mappable symbol)=%d\n",
              tag, length(ids), length(g), length(ids)-length(g)))
  if(length(g) < 1) { cat("[",tag,"] too few genes\n"); return(invisible(NULL)) }
  go <- enrichGO(gene=g, OrgDb=NULL, universe=bg_syms, ont="BP", keyType="SYMBOL",
                 pAdjustMethod="BH", pValueCutoff=1, qvalueCutoff=1)
  go <- go[order(go$p.adjust), ]
  if(nrow(go)==0){ cat("[",tag,"] no significant BP\n"); return(invisible(NULL)) }
  t <- go[1,]
  cat(sprintf("=== [%s] MOST ENRICHED GO BP ===\n", tag))
  cat("  term   :", t$Description, "\n")
  cat("  GO ID  :", t$ID, "\n")
  cat("  p.value:", t$pvalue, "  p.adjust:", t$p.adjust, "\n")
  cat("  count  :", t$Count, " (geneListSize=", t$geneSetSize, ")\n")
  cat("  enrichFC:", sprintf("%.3f", t$enrichment_ratio), "\n")
  print(head(t[,c("ID","Description","pvalue","p.adjust","Count","geneSetSize","enrichment_ratio")],5))
  invisible(go)
}
cat("\n##### PRIMARY (UP, design ~condition) #####\n")
enrich(r$up, "UP")

cat("\n##### SENSITIVITY #####\n")
enrich(r$down, "DOWN")
enrich(r$comb, "COMBINED")
rs <- run_design(~ sex + condition, "~sex+condition")
enrich(rs$up, "UP sex+condition")
