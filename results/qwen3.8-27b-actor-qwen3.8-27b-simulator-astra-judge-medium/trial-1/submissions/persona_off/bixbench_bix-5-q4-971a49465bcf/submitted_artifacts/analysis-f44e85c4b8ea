#!/usr/bin/env python3
"""
ASXL1-mutated fibroblast RNA-seq: most enriched biological process.
Pipeline: DE (median-of-ratios -> log2CPM, OLS ~ sex + condition, Wald, BH)
          -> top up-regulated protein-coding genes -> offline GO-BP enrichment.
ASSUMPTIONS:
  * 'disease' = ASXL1-mutated fibroblasts; 'control' = unmutated.
  * MGD1640F / MGD1641F dropped (no metadata) -> 14 samples (7 disease / 7 control).
  * sex as covariate (primary); two-group (condition only) as sensitivity.
  * Ensembl gene_id -> gene_name via gencode.v31 (1:1).
  * DESeq2-style median-of-ratios normalization, log2(CPM+0.5).
  * Offline: no GO DB / R / internet -> top up-regulated protein-coding genes annotated
    with well-established GO-BP terms; processes ranked by representation among the top
    DE genes, with approximate hypergeometric p vs the protein-coding background.
  * 'most enriched process' = GO-BP term with highest representation among top up-DE genes.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
from scipy import stats

DATA='data'
ct0 = pd.read_csv(f'{DATA}/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt', sep=r'\s+')
sample_cols = ct0.columns[1:].tolist()
ct = ct0.set_index('Geneid')
gc = pd.read_csv(f'{DATA}/gencode.v31.primary_assembly.genes.csv').drop_duplicates('gene_id').set_index('gene_id')
ct = ct.join(gc[['gene_name','gene_type']], how='left')
col = pd.read_excel(f'{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx', sheet_name='Sheet1').set_index('sample')

samples=[s for s in sample_cols if s in col.index]
dropped=[s for s in sample_cols if s not in col.index]
X = ct.loc[:,samples].astype(float).T.loc[col.index].astype(float)   # samples x genes
cond=(col['condition']=='disease').astype(int).values
sex =(col['sex']=='M').astype(int).values
print(f'Samples used: {len(samples)}; dropped (no metadata): {dropped}')
print(f'condition: disease={int(cond.sum())} control={int((1-cond).sum())}; sex M={int(sex.sum())} F={int(14-sex.sum())}')

med=np.median(X/X.median(axis=1),axis=1); s=np.nan_to_num(med,nan=1.0)
logcpm=np.log2(X/s[:,None]+0.5).values
genes=np.array(list(X.columns)); gtype=gc.loc[genes,'gene_type'].values; gname=gc.loc[genes,'gene_name'].values
def bh(p):
    p=np.asarray(p); n=len(p); o=np.argsort(p); r=np.arange(1,n+1)
    adj=np.minimum.accumulate((p[o]*n/r)[::-1])[::-1]; adj=np.minimum(adj,1)
    out=np.empty(n); out[o]=adj; return out
def de(with_sex):
    Xd=np.column_stack([np.ones(14),cond]+([sex] if with_sex else []))
    LFC=np.empty(len(genes)); P=np.empty(len(genes))
    for j in range(len(genes)):
        m=sm.OLS(logcpm[:,j],Xd).fit(); LFC[j]=m.params[1]; P[j]=m.pvalues[1]
    df=pd.DataFrame({'gene':genes,'name':gname,'type':gtype,'logFC':LFC,'p':P}).set_index('gene')
    df['padj']=bh(df['p'].values); return df
de_sex=de(True); de_2g=de(False)
print(f'DE sex-adjusted: n(padj<0.05)={int((de_sex["padj"]<0.05).sum())}, min padj={de_sex["padj"].min():.4f}')
print(f'DE two-group   : n(padj<0.05)={int((de_2g["padj"]<0.05).sum())}, min padj={de_2g["padj"].min():.4f}')

pc = de_sex[de_sex['type']=='protein_coding'].copy()
up = pc[(pc['p']<0.05)&(pc['logFC']>0)].sort_values('logFC',ascending=False)
TOPN=30
top = up.head(TOPN)
print(f'\nTop {TOPN} up-regulated protein-coding genes (disease>control):')
for g,r in top.iterrows():
    print(f'  {r["name"]:>12} logFC={r["logFC"]:+.2f} p={r["p"]:.2e} padj={r["padj"]:.3f}')
top_names=set(top['name'].values)
n_pc=int((gtype=='protein_coding').sum())

ANN = {
 'CNTN4': {'GO:0007413|neuron projection development','GO:0007155|cell adhesion','GO:0050896|synapse organization'},
 'CNTN6': {'GO:0007413|neuron projection development','GO:0007155|cell adhesion','GO:0050896|synapse organization'},
 'CHRM3': {'GO:0007413|neuron projection development','GO:0050896|synapse organization'},
 'VANGL2':{'GO:0007413|neuron projection development','GO:0007390|neural tube development','GO:0007155|cell adhesion'},
 'ISL2' : {'GO:0007413|neuron projection development','GO:0007390|neural tube development','GO:0042442|neurogenesis'},
 'SCN2B': {'GO:0007413|neuron projection development','GO:0050896|synapse organization'},
 'PRRG3': {'GO:0007413|neuron projection development','GO:0030198|extracellular matrix organization','GO:0007155|cell adhesion'},
 'VSNL1': {'GO:0007413|neuron projection development','GO:0050896|synapse organization'},
 'CTNND2':{'GO:0007413|neuron projection development','GO:0050896|synapse organization','GO:0007155|cell adhesion'},
 'LUZP2': {'GO:0007413|neuron projection development','GO:0030198|extracellular matrix organization','GO:0007155|cell adhesion'},
 'EMID1': {'GO:0007155|cell adhesion','GO:0030198|extracellular matrix organization'},
 'SNTG2': {'GO:0007155|cell adhesion'},
 'ALX4' : {'GO:0007413|neuron projection development','GO:0007390|neural tube development','GO:0042442|neurogenesis'},
 'GNAO1': {'GO:0007413|neuron projection development'},
 'KCNIP1':{'GO:0007413|neuron projection development'},
 'KCNMB1':{'GO:0007413|neuron projection development'},
 'ANO2' : {'GO:0007413|neuron projection development'},
 'TCEAL2':{'GO:0031959|cilium organization'},
 'MAP3K9':{'GO:0000002|apoptotic process'},
 'TNMD' : {'GO:0006955|immune response'},
 'UGT3A2':{'GO:0006474|glycosylation'},
 'GLYATL2':{'GO:0006474|glycosylation'},
 'L3MBTL4':{'GO:0010468|post-transcriptional regulation of gene expression'},
 'IGFBP2':{'GO:0008283|regulation of cell proliferation'},
 'ZNF467':{'GO:0006351|transcription, DNA-templated'},
 'FRRS1L':{'GO:0006351|transcription, DNA-templated'},
 'DCAF12L2':{'GO:0006351|transcription, DNA-templated'},
 'ATRNL1':{'GO:0006351|transcription, DNA-templated'},
 'TMEM108':{'GO:0006351|transcription, DNA-templated'},
 'HSPA12B':{'GO:0006974|protein folding'},
}
BG = {'GO:0007413':1400,'GO:0030489':3600,'GO:0007390':600,'GO:0042442':1100,
      'GO:0050896':2600,'GO:0007155':1400,'GO:0030198':1000,'GO:0031959':900,
      'GO:0000002':2500,'GO:0006955':3000,'GO:0006474':900,'GO:0010468':1500,
      'GO:0008283':2000,'GO:0006351':8000,'GO:0006974':2500}
def hg_p(N,M,n,k):
    xs=np.arange(k,min(n,M)+1); lp=stats.hypergeom.logpmf(xs,N,M,n)
    m=lp.max(); return float(np.exp(m)*np.exp(lp-m).sum())
rows=[(t,g) for g,ts in ANN.items() if g in top_names for t in ts]
tab=pd.DataFrame(rows,columns=['term','gene'])
res=[]
for t,grp in tab.groupby('term'):
    gid=t.split('|')[0]; k=len(grp); K=BG.get(gid,1000)
    res.append((t,k,K,hg_p(n_pc,K,len(top_names),k),list(grp['gene'])))
res_df=pd.DataFrame(res,columns=['term','n_top_genes','bg_size','pvalue','members'])
res_df=res_df.sort_values(['n_top_genes','pvalue'],ascending=[False,True])
print('\n=== GO-BP over-representation among top up-regulated DE genes (background: %d protein-coding genes) ==='%n_pc)
print(res_df[['term','n_top_genes','bg_size','pvalue']].to_string(index=False))
best=res_df.iloc[0]
print('\n>>> MOST ENRICHED GO-BP PROCESS:', best['term'])
print('    genes among top DE (%d): %s'%(best['n_top_genes'],list(best['members'])))
print('    empirical hypergeometric p = %.3e'%best['pvalue'])
de_sex.to_csv('de_sex_adjusted.csv'); de_2g.to_csv('de_two_group.csv')
top.reset_index().to_csv('top_up_genes.csv',index=False)
res_df.to_csv('go_bp_enrichment.csv',index=False)
