"""
BixBench bix-51-q1: Logistic regression (age as sole predictor) for predicted
probability of efficacy PR at age 65.

Approach (researcher-approved):
- 'with treatment' interpreted as trial context -> use all 80 real patients
- y = 1 if Efficacy == 'PR' else 0 (PD, SD pooled as non-PR)
- Logit(y ~ 1 + age), statsmodels MLE
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---------- 1. Load & clean ----------
df = pd.read_excel('/workspace/data/data.xlsx')
n_raw = len(df)
df = df[df['Sequence number'].notna()].copy()   # drop 41 empty padding rows
df['age'] = pd.to_numeric(df['Age'], errors='coerce')
assert df['age'].notna().all(), 'unexpected missing age'
assert df['Efficacy'].notna().all(), 'unexpected missing efficacy'
n = len(df)

# ---------- 2. Encode outcome ----------
df['y'] = (df['Efficacy'] == 'PR').astype(int)

print('=== Data summary ===')
print(f'raw rows: {n_raw}, analyzed rows: {n}')
print(f'age: min={df.age.min()}, max={df.age.max()}, mean={df.age.mean():.2f}, missing=0')
print(f'outcome PR: {df.y.sum()}, non-PR: {(1-df.y).sum()}')
print(f'efficacy counts: {df.Efficacy.value_counts().to_dict()}')
print(f'group counts: {df.Groups.value_counts().to_dict()}')

# ---------- 3. Fit logistic regression ----------
X = sm.add_constant(df['age'])
model = sm.Logit(df['y'], X).fit(disp=0)

print('\n=== Coefficient estimates ===')
params = model.params
bse = model.bse
ci = model.conf_int()
pvals = model.pvalues
for name in ['const', 'age']:
    print(f'{name:6s} coef={params[name]:+.4f}  SE={bse[name]:.4f}  '
          f'95% CI=[{ci.loc[name,0]:+.4f}, {ci.loc[name,1]:+.4f}]  p={pvals[name]:.4g}')
print(f'LLF={model.llf:.3f}  Pseudo R2={model.prsquared:.4f}  n={int(model.nobs)}')

# ---------- 4. Predict at age = 65 ----------
age65 = 65.0
logit65 = params['const'] + params['age'] * age65
p65 = 1.0 / (1.0 + np.exp(-logit65))
p65_check = model.predict(pd.DataFrame({'const': [1], 'age': [age65]}))[0]
assert abs(p65 - p65_check) < 1e-12

print('\n=== Prediction at age = 65 ===')
print(f'logit(P) = {params["const"]:.4f} + ({params["age"]:.4f})*65 = {logit65:.4f}')
print(f'P(PR | age=65) = {p65:.4f}')
