"""
BixBench bix-51-q2: AIC for logistic regression of treatment response (efficacy PR)
on BMI (sole continuous predictor).

Steps:
1) Load data/data.xlsx (Sheet1); drop trailing empty padding rows (n=80).
   Note: 40 rows are fully NaN; 1 further padding row contains only a
   whitespace string (' ') in 'Age'. We strip whitespace from string columns
   and listwise-delete rows missing 'Efficacy' or 'BMI' (the model variables).
2) Binary outcome: Efficacy == 'PR' -> 1, else 0.
3) Fit statsmodels Logit with BMI as the sole continuous predictor.
4) Report AIC (2k - 2*ln(L), k = 2 incl. intercept), coefficients,
   log-likelihood, convergence status.
"""
import warnings
import pandas as pd
import numpy as np
import statsmodels.api as sm

# --- 1. Load & clean ---
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
n_raw = len(df)
# Treat whitespace-only strings as missing, then drop rows lacking model variables
for c in df.select_dtypes(include="object").columns:
    df[c] = df[c].map(lambda v: v.strip() if isinstance(v, str) else v)
    df[c] = df[c].replace("", np.nan)
df = df.dropna(subset=["Efficacy", "BMI"]).reset_index(drop=True)
n = len(df)
assert df[["Efficacy", "BMI"]].notna().all().all(), "missing values remain in Efficacy/BMI"
assert df["BMI"].dtype.kind == "f", "BMI not numeric"

# --- 2. Binary outcome ---
df["PR"] = (df["Efficacy"] == "PR").astype(int)
n_events = int(df["PR"].sum())
print(f"Raw rows: {n_raw}; effective rows after cleaning: {n}")
print(f"Efficacy counts:\n{df['Efficacy'].value_counts().to_string()}")
print(f"Binary outcome PR=1: {n_events} events, {n - n_events} non-events")
print(f"BMI: min={df['BMI'].min()}, max={df['BMI'].max()}, mean={df['BMI'].mean():.3f}")

# --- 3. Fit logistic regression: PR ~ BMI (continuous, sole predictor) ---
X = sm.add_constant(df["BMI"].astype(float))
y = df["PR"].astype(float)

with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    model = sm.Logit(y, X)
    res = model.fit(method="newton", maxiter=100)
    fit_warnings = [str(w.message) for w in wlist]

# --- 4. Report ---
print("\n=== Logit fit summary ===")
print(f"Converged: {res.mle_retvals['converged']}")
print(f"Warnings during fit: {fit_warnings if fit_warnings else 'none'}")
print(f"Log-likelihood: {res.llf:.6f}")
print(f"Number of parameters k (incl. intercept): {int(res.df_model + 1)}")
print(f"AIC = 2k - 2*ln(L) = {res.aic:.6f}")
print("\nCoefficients:")
print(res.params.to_string())
print("\nStd errors:")
print(res.bse.to_string())
print("p-values:")
print(res.pvalues.to_string())
ci = res.conf_int()
print(f"\nPR odds ratio per +1 BMI unit: {np.exp(res.params['BMI']):.4f} "
      f"(95% CI [{np.exp(ci.loc['BMI', 0]):.4f}, {np.exp(ci.loc['BMI', 1]):.4f}])")

# Cross-check AIC manually: AIC = -2*llf + 2*k
k = int(res.df_model + 1)
aic_manual = -2 * res.llf + 2 * k
print(f"\nManual AIC cross-check (-2*llf + 2*k, k={k}): {aic_manual:.6f}")

print(f"\nFINAL ANSWER: AIC = {res.aic:.4f}")
