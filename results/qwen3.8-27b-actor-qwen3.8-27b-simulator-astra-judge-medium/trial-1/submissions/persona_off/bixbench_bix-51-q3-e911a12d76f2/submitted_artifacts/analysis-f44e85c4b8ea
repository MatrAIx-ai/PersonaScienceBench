"""
BixBench bix-51-q3
Question: In a combined logistic regression model combining BMI, age, and gender,
          what is the p-value for age as a predictor of treatment response (PR)?

Approach:
  PR ~ BMI + Age + Gender
  - Outcome y = 1 if Efficacy == 'PR' else 0  (SD/PD both = non-response; no CR present)
  - Age continuous, BMI continuous, Gender binary dummy (reference Male -> Female indicator)
  - Primary metric : Wald z-test p-value for Age
  - Sensitivity    : per-term likelihood-ratio (LR) p-value for Age
  - Diagnostics    : convergence, no separation among the 3 predictors,
                     reference-category / centering invariance of the Age p-value
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

# ----------------------------------------------------------------------
# 1. LOAD + CLEAN: keep the 80 real data rows (drop 40 empty + 1 spacer row)
# ----------------------------------------------------------------------
raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print("As-read shape:", raw.shape)
df = raw[raw["Sequence number"].notna()].copy().reset_index(drop=True)
print("Rows after cleaning (Sequence number notna):", df.shape[0])

# ----------------------------------------------------------------------
# 2. OUTCOME: PR = 1, non-PR (SD/PD) = 0
# ----------------------------------------------------------------------
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
df["y_PR"] = (df["Efficacy"] == "PR").astype(int)
print("Efficacy counts:", df["Efficacy"].value_counts().to_dict())
print("PR vs non-PR:", df["y_PR"].value_counts().to_dict(),
      " PR rate =", round(df["y_PR"].mean(), 4))

# ----------------------------------------------------------------------
# 3. PREDICTORS: Age continuous, BMI continuous, Gender binary dummy
# ----------------------------------------------------------------------
df["GenderFemale"] = (df["Gender"] == "Female").astype(int)
print("Gender counts:", df["Gender"].value_counts().to_dict(),
      " Age range:", df["Age"].min(), "-", df["Age"].max(),
      " BMI range:", df["BMI"].min(), "-", df["BMI"].max())
print("Missing in model cols:",
      df[["y_PR", "BMI", "Age", "GenderFemale"]].isnull().sum().to_dict())

# ----------------------------------------------------------------------
# 4. FIT combined logistic regression (statsmodels, MLE)
# ----------------------------------------------------------------------
model = smf.logit("y_PR ~ BMI + Age + GenderFemale", data=df).fit(disp=0)
print("\n===== MODEL SUMMARY (statsmodels Logit) =====")
print(model.summary())

# PRIMARY: Wald z-test p-value for Age
print("\n===== PRIMARY ANSWER: Wald z-test for Age =====")
print(f"Age coefficient = {model.params['Age']:.6f}")
print(f"Age SE          = {model.bse['Age']:.6f}")
print(f"Age z           = {model.tvalues['Age']:.6f}")
print(f"Age Wald p-value = {model.pvalues['Age']:.6f}")

# ----------------------------------------------------------------------
# 5. SENSITIVITY: per-term LR p-value for Age (full vs reduced w/o Age)
# ----------------------------------------------------------------------
reduced = smf.logit("y_PR ~ BMI + GenderFemale", data=df).fit(disp=0)
lr_diff = 2 * (model.llf - reduced.llf)
lr_p_age = 1 - stats.chi2.cdf(lr_diff, 1)
print("\n===== SENSITIVITY: per-term LR test for Age =====")
print(f"LR statistic = {lr_diff:.6f} (df=1), Age LR p-value = {lr_p_age:.6f}")

# ----------------------------------------------------------------------
# 6. DIAGNOSTICS
# ----------------------------------------------------------------------
print("\n===== DIAGNOSTICS =====")
print("Converged:", model.mle_retvals["converged"],
      "| iterations:", model.mle_retvals["iterations"])

pred = model.predict(df)
print("mean(predicted P(PR)) =", round(float(np.mean(pred)), 6),
      " vs observed =", round(float(df["y_PR"].mean()), 6),
      " (intercept score sum(pred-y) =",
      round(float(np.sum(pred - df["y_PR"])), 8), ")")

print("\nPredictor correlation matrix:\n",
      df[["BMI", "Age", "GenderFemale"]].corr().round(3).to_string())

print("\nSingle-predictor logit (separation screen; large |coef|/SE => separation):")
for name in ["BMI", "Age", "GenderFemale"]:
    s = smf.logit("y_PR ~ x",
                  data=pd.DataFrame({"x": df[name], "y_PR": df["y_PR"]})).fit(disp=0)
    print(f"  {name}: coef={s.params['x']:.3f}, SE={s.bse['x']:.3f}, "
          f"|coef|/SE={abs(s.params['x'])/s.bse['x']:.1f}")

# Invariance checks (Age p-value should be unchanged)
df["GenderMale"] = (df["Gender"] == "Male").astype(int)
m_gm = smf.logit("y_PR ~ BMI + Age + GenderMale", data=df).fit(disp=0)
df["Age_c"] = df["Age"] - df["Age"].mean()
m_ac = smf.logit("y_PR ~ BMI + Age_c + GenderFemale", data=df).fit(disp=0)
print("\nInvariance checks (Age Wald p should stay ~0.0025):")
print("  GenderMale reference :", round(m_gm.pvalues["Age"], 6))
print("  Age centered         :", round(m_ac.pvalues["Age_c"], 6))

print("\n===== FINAL =====")
print(f"Age Wald z-test p-value (PRIMARY) = {model.pvalues['Age']:.6f}")
print(f"Age per-term LR p-value (sensitivity) = {lr_p_age:.6f}")
