"""
Analysis: change in log-odds of remission per one-year increase in age,
from a logistic regression with predictors Age, BMI, Gender.

Data: data/data.xlsx, Sheet1.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm

# ------------------------------------------------------------------
# 1) Load Sheet1
# ------------------------------------------------------------------
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
# Drop columns that are entirely unnamed/empty (trailing None columns)
df = df.loc[:, ~df.columns.isna()]
n_raw = len(df)

# ------------------------------------------------------------------
# 2) Clean: keep real rows (Sequence number present), drop empty rows
#    and the stray whitespace Age row
# ------------------------------------------------------------------
real = df[df["Sequence number"].notna()].copy()
n_dropped = n_raw - len(real)

# Coerce Age and BMI to numeric (handles stray whitespace / strings)
real["Age"] = pd.to_numeric(real["Age"], errors="coerce")
real["BMI"] = pd.to_numeric(real["BMI"], errors="coerce")

# Drop any rows where the predictors/outcome are still missing
real = real.dropna(subset=["Efficacy", "Age", "BMI", "Gender"]).reset_index(drop=True)
n = len(real)

# ------------------------------------------------------------------
# 3) Define binary remission outcome: remission = (Efficacy == 'PR')
# ------------------------------------------------------------------
real["remission"] = (real["Efficacy"] == "PR").astype(int)

# ------------------------------------------------------------------
# 4) Prepare predictors: Age (cont), BMI (cont), Gender (binary)
#    Gender coded Female=1, Male=0 (reference = Male). This choice only
#    affects the intercept, not the Age coefficient.
# ------------------------------------------------------------------
real["Gender_Female"] = (real["Gender"] == "Female").astype(int)

X = real[["Age", "BMI", "Gender_Female"]].copy()
X = sm.add_constant(X)
y = real["remission"]

# ------------------------------------------------------------------
# 5) Fit logistic regression (statsmodels Logit)
# ------------------------------------------------------------------
with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    model = sm.Logit(y, X).fit(disp=0)
    conv_warnings = [str(w.message) for w in wlist if "converg" in str(w.message).lower()]

# Condition number / separation diagnostics
Xv = X.values
cond = np.linalg.cond(Xv)
# max |z| for the three predictors (large values suggest separation)
b = model.params.drop("const")
z = b / model.bse.drop("const")

# ------------------------------------------------------------------
# 6) Report
# ------------------------------------------------------------------
print("=" * 60)
print("DATASET")
print(f"  raw rows in Sheet1          : {n_raw}")
print(f"  rows dropped (empty/stray)  : {n_dropped}")
print(f"  effective n                 : {n}")
print(f"  Efficacy counts             : {real['Efficacy'].value_counts().to_dict()}")
print(f"  Gender counts               : {real['Gender'].value_counts().to_dict()}")
print(f"  remission (PR) events       : {int(y.sum())} / {n}  ({y.mean()*100:.1f}%)")
print(f"  Age range / mean            : {real['Age'].min():.0f}-{real['Age'].max():.0f} / {real['Age'].mean():.2f}")
print(f"  BMI range / mean            : {real['BMI'].min():.1f}-{real['BMI'].max():.1f} / {real['BMI'].mean():.2f}")
print("=" * 60)
print("LOGISTIC REGRESSION  remission ~ Age + BMI + Gender(Female)")
print(model.summary())
print("=" * 60)
print("DIAGNOSTICS")
print(f"  convergence warnings        : {conv_warnings if conv_warnings else 'NONE'}")
print(f"  matrix condition number     : {cond:.4g}")
print(f"  max |z| over predictors     : {z.abs().max():.2f}  (>=~3-4 flags possible separation)")
print(f"  MLE converged               : {model.mle_retvals['converged']}")
print("=" * 60)
age_coef = model.params["Age"]
age_se = model.bse["Age"]
age_or = np.exp(age_coef)
ci_lo = np.exp(model.conf_int().loc["Age", 0])
ci_hi = np.exp(model.conf_int().loc["Age", 1])
print(f"AGE COEFFICIENT (log-odds per 1-year increase) : {age_coef:.6f}")
print(f"  standard error              : {age_se:.6f}")
print(f"  95% CI (log-odds)           : {model.conf_int().loc['Age'].values}")
print(f"  odds ratio exp(coef)        : {age_or:.6f}  (95% CI {ci_lo:.4f}-{ci_hi:.4f})")
