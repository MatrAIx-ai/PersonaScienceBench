"""
BixBench bix-51-q5
Question: Using a logistic regression model, what is the p-value for evaluating
the null hypothesis that BMI is not associated with treatment response?

Approach (approved):
- Data: data/data.xlsx, Sheet1. Keep 80 real records (drop 41 trailing empty rows).
- Binary outcome 'treatment response': responder (1) = Efficacy 'PR';
  non-responder (0) = 'SD' or 'PD' (RECIST).
- Predictor: continuous BMI.
- Model: UNIVARIABLE logistic regression  response ~ BMI  (statsmodels Logit + constant).
- Reported answer: Wald p-value for the BMI coefficient.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# --- Load & clean ---
df = pd.read_excel('data/data.xlsx')
real = df[df['Sequence number'].notna()].copy()
assert len(real) == 80, len(real)

# --- Binary outcome ---
real['resp'] = (real['Efficacy'] == 'PR').astype(int)
assert set(real['Efficacy'].unique()) <= {'PR', 'SD', 'PD'}
print("Response counts:", real['resp'].value_counts().to_dict())
print("BMI missing:", real['BMI'].isna().sum())

# --- Univariable logistic regression ---
X = sm.add_constant(real['BMI'])
model = sm.Logit(real['resp'], X).fit(disp=0)
print(model.summary().tables[1])

wald_p = model.pvalues['BMI']
wald_chi2 = model.tvalues['BMI'] ** 2
coef = model.params['BMI']
z = model.tvalues['BMI']

# Equivalent likelihood-ratio test for dropping BMI
model0 = sm.Logit(real['resp'], np.ones(len(real))).fit(disp=0)
lr_chi2 = 2 * (model.llf - model0.llf)
lr_p = 1 - __import__('scipy').stats.chi2.cdf(lr_chi2, df=1)

print("\n--- RESULTS ---")
print(f"BMI coef        = {coef:.6f}")
print(f"Wald z          = {z:.6f}")
print(f"Wald chi-square = {wald_chi2:.6f}")
print(f"Wald p-value    = {wald_p:.6f}")
print(f"LR chi-square   = {lr_chi2:.6f}")
print(f"LR p-value      = {lr_p:.6f}")

with open('analysis_output.txt', 'w') as f:
    f.write(f"BMI univariable logistic regression (response: PR=1 vs SD/PD=0)\n")
    f.write(f"n = {len(real)} (41 responders, 39 non-responders)\n")
    f.write(f"BMI coef = {coef:.6f}\n")
    f.write(f"Wald chi-square = {wald_chi2:.6f}\n")
    f.write(f"Wald p-value (ANSWER) = {wald_p:.6f}\n")
    f.write(f"LR chi-square = {lr_chi2:.6f}, LR p-value = {lr_p:.6f}\n")
