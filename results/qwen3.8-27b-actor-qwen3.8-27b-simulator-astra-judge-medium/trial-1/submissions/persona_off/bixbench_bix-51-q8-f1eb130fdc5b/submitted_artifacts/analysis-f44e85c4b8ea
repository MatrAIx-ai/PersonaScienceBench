"""
Univariate Logistic Regression: Age and Camrelizumab Treatment Response
Question: What is the coefficient estimate (change in log-odds) for age?
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# 1. Load data
df = pd.read_excel('data/data.xlsx')

# Drop fully-empty rows (41 trailing empty rows)
df = df.dropna(how='all').reset_index(drop=True)

# Drop the space-only row (row where Age == ' ' and everything else is NaN)
df = df[df['Sequence number'].notna()].reset_index(drop=True)

# Convert Age to numeric
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')

# 2. Create binary outcome: PR -> 1, otherwise (SD, PD) -> 0
df['response'] = (df['Efficacy'] == 'PR').astype(int)

# Verify
print(f"Sample size: {len(df)}")
print(f"Response distribution: {df['response'].value_counts().to_dict()}")
print(f"Age range: {df['Age'].min()} - {df['Age'].max()}")
print()

# 3. Fit univariate logistic regression: response ~ age
X = df['Age'].values
X = sm.add_constant(X)  # add intercept
y = df['response'].values

model = sm.Logit(y, X)
result = model.fit(disp=0)

# 4. Report results
print("=" * 60)
print("LOGISTIC REGRESSION RESULTS: response ~ age")
print("=" * 60)
print(result.summary())
print()
print("=" * 60)
print("KEY ESTIMATES")
print("=" * 60)
print(f"Intercept (β₀): {result.params[0]:.6f}")
print(f"  SE:           {result.bse[0]:.6f}")
print(f"  z:            {result.tvalues[0]:.4f}")
print(f"  p-value:      {result.pvalues[0]:.6f}")
print()
print(f"Age coefficient (β₁): {result.params[1]:.6f}")
print(f"  SE:           {result.bse[1]:.6f}")
print(f"  z:            {result.tvalues[1]:.4f}")
print(f"  p-value:      {result.pvalues[1]:.6f}")
print()
print(f"Odds ratio for age (exp(β₁)): {np.exp(result.params[1]):.6f}")
print(f"95% CI for β₁: [{result.conf_int()[1][0]:.6f}, {result.conf_int()[1][1]:.6f}]")
print()

# 5. Answer
print("=" * 60)
print("ANSWER")
print("=" * 60)
print(f"The coefficient estimate (change in log-odds) for age is: {result.params[1]:.4f}")
