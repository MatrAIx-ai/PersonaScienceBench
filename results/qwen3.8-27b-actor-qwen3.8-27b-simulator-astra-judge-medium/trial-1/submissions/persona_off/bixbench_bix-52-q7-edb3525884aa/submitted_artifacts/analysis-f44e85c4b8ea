#!/usr/bin/env python3
"""
BixBench bix-52-q7: How many sites are removed when filtering sites that do not
show >90% or <10% methylation in Zebra Finch?

Reading B (approved by researcher):
  - Site key = Pos (1:1 with Chromosome+StartPosition+EndPosition); 1,140 sites.
  - A site "shows >90% or <10% methylation" if AT LEAST ONE of its per-sample
    rows has MethylationPercentage > 90 or < 10.
  - KEPT   = sites that show an extreme value (at least one row >90 or <10).
  - REMOVED = sites that do NOT show an extreme value, i.e., ALL their per-sample
    values fall within [10%, 90%] (inclusive boundaries).
"""
import pandas as pd

CSV = "data/ZF_AgeRelated_CpG_noMT_Final.csv"

df = pd.read_csv(CSV)
total_sites = df["Pos"].nunique()
total_rows = len(df)

# Per-site: does ANY row exceed the extreme threshold?
extreme = (df["MethylationPercentage"] > 90) | (df["MethylationPercentage"] < 10)
site_extreme = extreme.groupby(df["Pos"]).any()

kept_sites = int(site_extreme.sum())                 # sites showing >90 or <10 in >=1 sample
removed_sites = int((~site_extreme).sum())           # sites with all values in [10,90]

print("=== Zebra Finch methylation filter (Reading B) ===")
print(f"Input rows (site x sample): {total_rows}")
print(f"Total unique sites (Pos):   {total_sites}")
print(f"Kept sites (show >90% or <10% in >=1 sample): {kept_sites}")
print(f"REMOVED sites (all per-sample values in [10%,90%]): {removed_sites}")
print(f"Check kept + removed == total: {kept_sites + removed_sites} == {total_sites}")

# Verification: removed sites must have every row in [10,90]
removed_pos = set(df.loc[~extreme, "Pos"].unique()) - set(site_extreme[site_extreme].index)
# simpler:
removed_pos = set(site_extreme[~site_extreme].index)
sub = df[df["Pos"].isin(removed_pos)]
print(f"Min meth among removed-site rows: {sub['MethylationPercentage'].min()}")
print(f"Max meth among removed-site rows: {sub['MethylationPercentage'].max()}")
print(f"All removed-site rows within [10,90]: {bool(((sub['MethylationPercentage']>=10)&(sub['MethylationPercentage']<=90)).all())}")

print("\nFINAL ANSWER: sites removed =", removed_sites)
