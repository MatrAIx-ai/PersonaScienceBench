"""
Companion to final_analysis.py : focused, deliberate Ensembl<->symbol mapping
attempt for the 25 KEGG mmu00480 (Glutathione metabolism) genes, then
intersection with the DGE sets.

Method (per researcher request):
  1. Recall, ONE BY ONE, the mouse Ensembl (ENSMUSG) ID for each symbol
     (primary recall + alternatives where available).
  2. Check each recalled ID against the 21,884 geneID column (inData yes/no)
     and record total expression (plausibility check).
  3. Count how many of the 25 map to an ID present in the data.
  4. Intersect the mapped pathway Ensembl IDs with:
       - the 93 DGEs (apeglm, raw p<0.05, |lfc|>1, baseMean>10)  [PRIMARY]
       - the 1,188 DGEs (normal shrinkage, same filters)         [sensitivity]
  5. Report the integer |DGE ∩ pathway| for each, with a confidence label.

CAVEAT (stated up front): BioMart/KEGG/internet are unreachable in this
sandbox and no local annotation exists, so the mapping below is reconstructed
from model knowledge of mouse Ensembl gene IDs. Each ID is printed with its
inData status and total expression so the mapping is fully auditable.
"""
import pandas as pd, numpy as np
BASE='/workspace'
df = pd.read_csv(f'{BASE}/data/count.csv', dtype={'geneID':str})
data = df.set_index('geneID')[['KL1','KL2','KL3','WL1','WL2','WL3']].astype(float)
ids = set(df.geneID)
res = pd.read_csv(f'{BASE}/analysis/de_results.csv', dtype={'geneID':str})
d93   = set(res[(res.pvalue<0.05)&(res.baseMean>10)&(res.lfc_apeglm.abs()>1)].geneID)
d1188 = set(res[(res.pvalue<0.05)&(res.baseMean>10)&(res.lfc_normal.abs()>1)].geneID)
print(f"universe={len(ids)}  DGE(apeglm)={len(d93)}  DGE(normal)={len(d1188)}")

# symbol -> [candidate Ensembl IDs, best recall first, then alternatives]
recall = {
 "G6pd":  ["ENSMUSG00000031535"],
 "Pgd":   ["ENSMUSG00000029158","ENSMUSG00000032590"],
 "Gsr":   ["ENSMUSG00000030925","ENSMUSG00000028599"],
 "Gpx1":  ["ENSMUSG00000022454","ENSMUSG00000035664"],
 "Gpx2":  ["ENSMUSG00000029209"],
 "Gpx3":  ["ENSMUSG00000020301","ENSMUSG00000033535"],
 "Gpx4":  ["ENSMUSG00000023394"],
 "Gpx6":  ["ENSMUSG00000021325"],
 "Gpx7":  ["ENSMUSG00000028896"],
 "Gclc":  ["ENSMUSG00000059874"],
 "Gclm":  ["ENSMUSG00000023308","ENSMUSG00000024781"],
 "Gss":   ["ENSMUSG00000028384"],
 "Gss2":  ["ENSMUSG00000032029"],
 "Hmox1": ["ENSMUSG00000042885","ENSMUSG00000028691"],
 "Akr1a1":["ENSMUSG00000020234"],
 "Txn":   ["ENSMUSG00000032024"],
 "Txnrd1":["ENSMUSG00000035477","ENSMUSG00000029158"],
 "Txnrd2":["ENSMUSG00000029793"],
 "Mt1a":  ["ENSMUSG00000027528"],
 "Mt1e":  ["ENSMUSG00000059979"],
 "Mt1f":  ["ENSMUSG00000033923"],
 "Mt2a":  ["ENSMUSG00000032603"],
 "Rpe":   ["ENSMUSG00000025850"],
 "Rpia":  ["ENSMUSG00000032151"],
 "Gnpda1":["ENSMUSG00000029872"],
}
# expression-plausibility class: 'constitutive' must be expressed; 'inducible' may be ~0
constitutive = {"G6pd","Pgd","Gsr","Gpx1","Gpx2","Gpx4","Gclc","Gclm","Gss","Txn","Txnrd1","Gpx7","Akr1a1","Gpx6"}
print("\n%-7s %-22s %-22s %-7s %-8s %-9s %s"%("symbol","primary ID","alt ID","inData","totExpr","plaus","isDGE93"))
mapped_present=0; mapped_plausible=0
path_present=set(); path_plausible=set()
rows=[]
for sym,cands in recall.items():
    prim=cands[0]; alt=cands[1] if len(cands)>1 else "-"
    # pick first candidate present in data
    chosen=None
    for c in cands:
        if c in ids: chosen=c; break
    if chosen is None:
        print("%-7s %-22s %-22s %-7s %-8s %-9s %s"%(sym,prim,alt,"NO","-","-","-"))
        continue
    tot=int(data.loc[chosen].values.sum())
    inD="yes"
    plaus = "ok" if (tot>0 or sym not in constitutive) else "SUSPECT(0)"
    if plaus=="ok": mapped_plausible+=1
    mapped_present+=1
    path_present.add(chosen)
    if plaus=="ok": path_plausible.add(chosen)
    isd = "YES" if chosen in d93 else ("(d1188)" if chosen in d1188 else "no")
    print("%-7s %-22s %-22s %-7s %-8s %-9s %s"%(sym,prim,alt,inD,tot,plaus,isd))
    rows.append((sym,chosen,tot,plaus))

print(f"\n(a) symbols mapped to an ID PRESENT in data : {mapped_present}/25")
print(f"    of those, expression-plausible          : {mapped_plausible}/25")

# (b)/(c) intersections
def inter(dset, pathset, label):
    hit = sorted(dset & pathset)
    print(f"{label}: |DGE ∩ pathway| = {len(hit)}   {hit}")
    return len(hit)
print("\n(b/c) Intersections:")
n93_full   = inter(d93,   path_present,   "DGE93  vs all-present(12)")
n1188_full = inter(d1188, path_present,   "DGE1188 vs all-present(12)")
n93_plaus  = inter(d93,   path_plausible, "DGE93  vs plausible-only")
n1188_plaus= inter(d1188, path_plausible, "DGE1188 vs plausible-only")

print("\n"+"="*60)
print("ANSWER (best-effort, mapping from model knowledge)")
print("="*60)
conf = "MEDIUM" if mapped_present>=15 else ("LOW" if mapped_present<10 else "LOW-MEDIUM")
print(f"mapping reliability: {mapped_present}/25 present, {mapped_plausible}/25 plausible -> {conf} confidence")
print(f"PRIMARY  |DGE93   ∩ pathway| = {n93_full}   (all-present mapping)  / {n93_plaus} (plausible-only)")
print(f"SENSITIV |DGE1188 ∩ pathway| = {n1188_full}   (all-present mapping)  / {n1188_plaus} (plausible-only)")
print("NOTE: hits rely on recalled IDs; verify each hit below before trusting.")
for sym,e,_,_ in rows:
    if e in d93 or e in d1188:
        r=res[res.geneID==e].iloc[0]
        print(f"  HIT {sym}={e}  baseMean={r.baseMean:.0f}  lfc_ape={r.lfc_apeglm:.2f}  lfc_norm={r.lfc_normal:.2f}")
