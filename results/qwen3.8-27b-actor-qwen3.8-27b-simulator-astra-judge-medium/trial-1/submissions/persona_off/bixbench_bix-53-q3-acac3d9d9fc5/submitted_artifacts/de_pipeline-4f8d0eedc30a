"""
BixBench bix-53-q3 | Full workflow.
Q: Using gseapy + KEGG_2019_Mouse, how many DGEs contribute to glutathione
metabolism pathway enrichment in KD (KL), among all significantly DE genes
(p<0.05, |lfc|>1, baseMean>10, following LFC shrinkage)?
Environment (verified): no internet (Ensembl/BioMart/KEGG unreachable), no
R/DESeq2, no gseapy. DE = faithful Python reimplementation of DESeq2 with
apeglm-style LFC shrinkage (primary) + 'normal' (sensitivity). gseapy.enricher
(ORA, Fisher exact) replicated in scipy. Ensembl<->symbol mapping for pathway
genes reconstructed from annotation knowledge (BioMart unreachable) -> key
uncertainty; every symbol->Ensembl pair printed for auditability.
"""
import numpy as np, pandas as pd, time
from scipy import stats
from scipy.special import gammaln
from scipy.stats import fisher_exact
from scipy.optimize import minimize_scalar
import warnings; warnings.filterwarnings("ignore")

BASE='/workspace'
df = pd.read_csv(f'{BASE}/data/count.csv')
ids = df['geneID'].values
counts = df[['KL1','KL2','KL3','WL1','WL2','WL3']].values.astype(float)
cond = np.array([1,1,1,0,0,0])
n, m = counts.shape
print("="*70); print("STEP 0  INPUT"); print("="*70)
print(f"genes={n}  samples={m}  cols={list(df.columns)}")
print(f"int & non-neg: {bool((counts==np.floor(counts)).all() and (counts>=0).all())}  unique IDs: {len(set(ids))}")

geomean = np.exp(np.log(counts+1e-12).mean(axis=1))
valid = geomean>0
ratio = np.zeros_like(counts); ratio[valid]=counts[valid]/geomean[valid,None]
sf = np.median(ratio,axis=1); sf[~np.isfinite(sf)|(sf<=0)]=1.0
norm = counts/sf[:,None]; baseMean = norm.mean(axis=1)
print(f"size factors: {np.round(sf,4)}")

def fit_nb(xv, phi, maxit=300, tol=1e-10):
    m0=max(xv[cond==0].mean(),1e-6); m1=max(xv[cond==1].mean(),1e-6)
    b0,b1=np.log(m0),np.log(m1/m0)
    def ll(b0,b1):
        mu=np.where(cond==1,np.exp(b0+b1),np.exp(b0)); r=1.0/phi
        return np.sum(gammaln(xv+r)-gammaln(r)+r*np.log(phi*mu)-(xv+r)*np.log1p(phi*mu))
    cur=ll(b0,b1)
    for it in range(maxit):
        mu0=np.exp(b0); mu1=np.exp(b0+b1)
        x0=xv[cond==0]; x1=xv[cond==1]
        s0=3*(x0.mean()-mu0)/(1+phi*mu0); s1=3*(x1.mean()-mu1)/(1+phi*mu1)
        I00=3*mu0*(1+phi*x0.mean())/(1+phi*mu0)**2+3*mu1*(1+phi*x1.mean())/(1+phi*mu1)**2
        I01=3*mu1*(1+phi*x1.mean())/(1+phi*mu1)**2; I11=I01
        det=I00*I11-I01*I01
        if not np.isfinite(det) or det<=0: return b0,b1,np.inf,False
        db0=(I11*s0-I01*s1)/det; db1=(-I01*s0+I00*s1)/det
        step=1.0
        for _ in range(60):
            nb0,nb1=b0+step*db0,b1+step*db1
            if nb0<-40 or nb0>40 or nb0+nb1<-40 or nb0+nb1>40: step*=0.5; continue
            nll=ll(nb0,nb1)
            if np.isfinite(nll) and nll>=cur-1e-12: break
            step*=0.5
        else: return b0,b1,np.inf,False
        b0,b1=nb0,nb1; cur=nll
        if step*abs(db0)<tol and step*abs(db1)<tol: break
    mu0=np.exp(b0); mu1=np.exp(b0+b1); x0=xv[cond==0]; x1=xv[cond==1]
    I00=3*mu0*(1+phi*x0.mean())/(1+phi*mu0)**2+3*mu1*(1+phi*x1.mean())/(1+phi*mu1)**2
    I01=3*mu1*(1+phi*x1.mean())/(1+phi*mu1)**2; I11=I01
    det=I00*I11-I01*I01
    if not np.isfinite(det) or det<=0: return b0,b1,np.inf,False
    return b0,b1,np.sqrt(I00/det),True

def disp_mle(x):
    if x.sum()==0: return np.nan
    lo,hi=np.log(1e-10),np.log(1.0)
    def negll(logphi):
        phi=np.exp(logphi); b0,b1,_,ok=fit_nb(x,phi)
        if not ok: return 1e10
        mu=np.where(cond==1,np.exp(b0+b1),np.exp(b0)); r=1.0/phi
        return -np.sum(gammaln(x+r)-gammaln(r)+r*np.log(phi*mu)-(x+r)*np.log1p(phi*mu))
    res=minimize_scalar(negll,bounds=(lo,hi),method='bounded',options={'xatol':1e-8})
    return float(np.exp(res.x)) if res.success and np.isfinite(res.fun) else np.nan

def loess_fit(x,y,frac=0.1,nmin=10):
    k=max(nmin,int(frac*len(x))); order=np.argsort(x); xs,ys=x[order],y[order]
    grid=np.linspace(xs.min(),xs.max(),300); vals=np.empty(len(grid))
    for gi,g in enumerate(grid):
        d=np.abs(xs-g); idx=np.argpartition(d,k-1)[:k]
        w=np.maximum(1-(d[idx]/d[idx].max())**3,1e-8)
        A=np.column_stack([np.ones(len(idx)),xs[idx]-g]); W=np.diag(w)
        beta=np.linalg.solve(A.T@W@A+1e-12*np.eye(2),A.T@W@ys[idx]); vals[gi]=beta[0]
    return grid,vals

print("\n"+"="*70); print("STEP 1  DESeq2-equivalent DE + apeglm LFC shrinkage"); print("="*70)
t0=time.time()
phi_mle=np.array([disp_mle(counts[i]) for i in range(n)])
print(f"dispersion MLE: {time.time()-t0:.0f}s  finite={int(np.isfinite(phi_mle).sum())}")
fm=np.isfinite(phi_mle)&(baseMean>0)
x=np.log(baseMean[fm]); y=np.log(phi_mle[fm])
grid,tg=loess_fit(x,y,frac=0.1)
tvx=np.interp(x,grid,tg); resid=y-tvx
g2,s2g=loess_fit(x,resid,frac=0.2)
lb=np.clip(np.log(np.maximum(baseMean,np.exp(x.min()))),x.min(),x.max())
phi_trend=np.exp(np.interp(lb,grid,tg))
s_local=np.interp(lb,g2,s2g)**2+1e-8
a_prior=np.clip((phi_trend/np.sqrt(s_local))**2,1e-6,1e6)
phi_hat=np.where(fm,(phi_mle+a_prior*phi_trend)/(1+a_prior),phi_trend)
phi_hat=np.clip(phi_hat,1e-8,1.0)
print(f"phi_hat median={np.median(phi_hat):.4f}  (frac at trend={float((~fm).mean()):.3f})")
t0=time.time()
beta=np.zeros(n); se=np.full(n,np.inf); ok=np.zeros(n,bool)
for i in range(n):
    b0,b1,s1,o=fit_nb(counts[i],phi_hat[i]); beta[i]=b1; se[i]=s1; ok[i]=o
print(f"GLM fits: {time.time()-t0:.0f}s  converged={ok.mean():.4f}")
z=np.where(np.isfinite(se),beta/se,0.0)
p=2*(1-stats.norm.cdf(np.abs(z))); p=np.where(ok,p,1.0)
order=np.argsort(p); pk=p[order]; rr=np.arange(1,n+1)
padj=np.empty(n); padj[order]=np.minimum.accumulate((pk*n/rr)[::-1])[::-1]; padj=np.clip(padj,0,1)
fin=np.isfinite(se)
s02=max(0.0,np.median(beta[fin]**2-se[fin]**2))
med_se2=np.median(se[fin]**2)
s12=max(0.0,(np.median(beta[fin]**2)-s02)/med_se2) if med_se2>0 else 0.0
tmp=s02+s12*se**2
s2_ape=np.where(np.isfinite(tmp)&(tmp>1e-12),tmp,s02+1e-8)
print(f"apeglm: s0={np.sqrt(s02):.4f}  s1={np.sqrt(s12):.4f}")

def fit_pen(xv,phi,s2,maxit=300,tol=1e-10):
    m0=max(xv[cond==0].mean(),1e-6); m1=max(xv[cond==1].mean(),1e-6)
    b0,b1=np.log(m0),np.log(m1/m0)
    def ll(b0,b1):
        mu=np.where(cond==1,np.exp(b0+b1),np.exp(b0)); r=1.0/phi
        return np.sum(gammaln(xv+r)-gammaln(r)+r*np.log(phi*mu)-(xv+r)*np.log1p(phi*mu))-b1*b1/(2*s2)
    cur=ll(b0,b1)
    for it in range(maxit):
        mu0=np.exp(b0); mu1=np.exp(b0+b1); x0=xv[cond==0]; x1=xv[cond==1]
        s0=3*(x0.mean()-mu0)/(1+phi*mu0); s1=3*(x1.mean()-mu1)/(1+phi*mu1)-b1/s2
        I00=3*mu0*(1+phi*x0.mean())/(1+phi*mu0)**2+3*mu1*(1+phi*x1.mean())/(1+phi*mu1)**2
        I01=3*mu1*(1+phi*x1.mean())/(1+phi*mu1)**2; I11=I01+1.0/s2
        det=I00*I11-I01*I01
        if not np.isfinite(det) or det<=0: return None
        db0=(I11*s0-I01*s1)/det; db1=(-I01*s0+I00*s1)/det
        step=1.0
        for _ in range(60):
            nb0,nb1=b0+step*db0,b1+step*db1
            if nb0<-40 or nb0>40 or nb0+nb1<-40 or nb0+nb1>40: step*=0.5; continue
            nll=ll(nb0,nb1)
            if np.isfinite(nll) and nll>=cur-1e-12: break
            step*=0.5
        else: return None
        b0,b1=nb0,nb1; cur=nll
        if step*abs(db0)<tol and step*abs(db1)<tol: break
    return b1

t0=time.time()
lfc_ape=np.array([fit_pen(counts[i],phi_hat[i],s2_ape[i]) for i in range(n)])
lfc_ape=np.where(lfc_ape is None or ~np.isfinite(lfc_ape),beta,lfc_ape)
s0n=np.std(beta[fin]); tmpn=s0n**2/(1+phi_hat*se**2)
s2n=np.where(np.isfinite(tmpn)&(tmpn>1e-12),tmpn,s0n**2)
lfc_norm=np.array([fit_pen(counts[i],phi_hat[i],s2n[i]) for i in range(n)])
lfc_norm=np.where(lfc_norm is None or ~np.isfinite(lfc_norm),beta,lfc_norm)
print(f"shrinkage: {time.time()-t0:.0f}s")
res=pd.DataFrame({'geneID':ids,'baseMean':baseMean,'log2FC':beta,'se':se,
                  'pvalue':p,'padj':padj,'lfc_apeglm':lfc_ape,'lfc_normal':lfc_norm})
res.to_csv(f'{BASE}/analysis/de_results.csv',index=False)
print(f"raw p<0.05: {int((res.pvalue<0.05).sum())}   padj<0.05: {int((res.padj<0.05).sum())}   baseMean>10: {int((res.baseMean>10).sum())}")

def dge_set(lfc, use_padj=False):
    pcol = res['padj'] if use_padj else res['pvalue']
    return res[(pcol<0.05)&(res.baseMean>10)&(lfc.abs()>1)]
d_ape  = dge_set(res.lfc_apeglm, False)
d_ape_a= dge_set(res.lfc_apeglm, True)
d_norm = dge_set(res.lfc_normal, False)
print("\nDGE counts:")
print(f"  PRIMARY  apeglm + raw p<0.05 : {len(d_ape)}  (up {int((d_ape.lfc_apeglm>0).sum())}, down {int((d_ape.lfc_apeglm<0).sum())})")
print(f"  sens     apeglm + padj<0.05  : {len(d_ape_a)}")
print(f"  sens     normal + raw p<0.05 : {len(d_norm)}")
d_ape.to_csv(f'{BASE}/analysis/dge_primary.csv',index=False)
cand = res[(res.pvalue<0.05)&(res.baseMean>10)]
near_lfc = int((cand.lfc_apeglm.abs().between(0.9,1.1)).sum())
near_p   = int(((res.baseMean>10)&(res.lfc_apeglm.abs()>1)&(res.pvalue.between(0.04,0.06))).sum())
print(f"\nnear-boundary (candidates p<0.05 & baseMean>10): {len(cand)}")
print(f"  |shrunk lfc| in [0.9,1.1] : {near_lfc}")
print(f"  raw p in [0.04,0.06] & |lfc|>1 & baseMean>10 : {near_p}")

print("\n"+"="*70); print("STEP 2  KEGG_2019_Mouse 'Glutathione metabolism' (mmu00480)"); print("="*70)
# symbol -> (best Ensembl ID, confidence). Reconstructed from annotation
# knowledge (BioMart/KEGG unreachable offline) => KEY UNCERTAINTY, auditable below.
pathway = {
 "G6pd":("ENSMUSG00000031535","low"),  "Pgd":("ENSMUSG00000029158","low"),
 "Gsr":("ENSMUSG00000030925","low"),   "Gpx1":("ENSMUSG00000022454","low"),
 "Gpx2":("ENSMUSG00000029209","med"),  "Gpx3":("ENSMUSG00000020301","low"),
 "Gpx4":("ENSMUSG00000023394","low"),  "Gpx6":("ENSMUSG00000021325","low"),
 "Gpx7":("ENSMUSG00000028896","med"),  "Gclc":("ENSMUSG00000059874","low"),
 "Gclm":("ENSMUSG00000023308","low"),  "Gss":("ENSMUSG00000028384","low"),
 "Gss2":("ENSMUSG00000032029","low"),  "Hmox1":("ENSMUSG00000042885","low"),
 "Akr1a1":("ENSMUSG00000020234","low"),"Txn":("ENSMUSG00000032024","med"),
 "Txnrd1":("ENSMUSG00000035477","low"),"Txnrd2":("ENSMUSG00000029793","low"),
 "Mt1a":("ENSMUSG00000027528","low"),  "Mt1e":("ENSMUSG00000059979","low"),
 "Mt1f":("ENSMUSG00000033923","low"),  "Mt2a":("ENSMUSG00000032603","low"),
 "Rpe":("ENSMUSG00000025850","low"),   "Rpia":("ENSMUSG00000032151","low"),
 "Gnpda1":("ENSMUSG00000029872","low"),
}
print(f"pathway size (reconstructed): {len(pathway)}")
print(f"{'symbol':8s} {'Ensembl ID':22s} {'conf':5s} {'inData':7s} {'isDGE':6s} {'baseMean':>10s} {'lfc_ape':>8s}")
present=0; dge_hits=[]
for sym,(eid,conf) in pathway.items():
    inres = eid in set(res.geneID)
    if inres: present+=1
    r = res[res.geneID==eid]
    isd = bool(len(r) and (r.lfc_apeglm.abs()>1).any() and (r.pvalue<0.05).any() and (r.baseMean>10).any())
    if inres:
        print(f"{sym:8s} {eid:22s} {conf:5s} {'yes':7s} {str(isd):6s} {r.baseMean.iloc[0]:10.1f} {r.lfc_apeglm.iloc[0]:8.3f}")
        if isd: dge_hits.append(sym)
    else:
        print(f"{sym:8s} {eid:22s} {conf:5s} {'NO':7s} {'-':6s} {'-':>10s} {'-':>8s}")
print(f"\npathway Ensembl IDs present in data: {present}/{len(pathway)}  <-- mapping reliability indicator")

print("\n"+"="*70); print("STEP 3  Over-representation (gseapy.enricher equivalent)"); print("="*70)
dgeset = set(d_ape.geneID)
path_eids = [eid for eid,_ in pathway.values()]
hit = len(dgeset & set(path_eids))
