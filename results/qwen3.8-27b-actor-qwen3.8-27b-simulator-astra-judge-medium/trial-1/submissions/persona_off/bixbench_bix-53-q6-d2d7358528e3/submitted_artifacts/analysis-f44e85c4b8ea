#!/usr/bin/env python3
"""
UBE2M knockdown (KD) RNA-seq -> GSEA (KEGG_2019_Mouse)
Question: most significantly enriched KEGG pathway in the UBE2M KD model.
DE definition: p<0.05, |log2FC|>1, baseMean>10. LFC shrinkage applied (apeglm).

Pipeline:
  1) DE: DESeq2-equivalent (median-of-ratios size factors; NB mean model =
     closed-form Poisson MLE for the 2-group offset design; NB dispersion-scaled
     Wald SE; apeglm log2FC shrinkage).
  2) Ranking: FULL ranked list, rank = sign(log2FC_shrunk) * -log10(p).
  3) GSEA: gseapy with the KEGG_2019_Mouse library (PRIMARY, as required by the
     question). If gseapy/the library is unavailable (offline runner), fall back
     to a faithful pure-Python GSEA engine IF a KEGG_2019_Mouse GMT is supplied,
     otherwise report clearly that GSEA could not be executed.
"""
import os, sys, warnings, pickle, time
import numpy as np
import pandas as pd
from scipy import stats
warnings.filterwarnings("ignore")

T0=time.time()
DATA="data/count.csv"
OUT="results"
os.makedirs(OUT, exist_ok=True)

# ----------------------------------------------------------------------
# 0) Load + group definition  (ASSUMPTION: KL1-3 = UBE2M KD, WL1-3 = control)
# ----------------------------------------------------------------------
df = pd.read_csv(DATA)
geneID = df["geneID"].values
C = df.drop(columns=["geneID"]).values.astype(float)
n, m = C.shape
print("counts:", C.shape, "samples:", list(df.columns[1:]))
group = np.array([1,1,1,0,0,0], float)   # KD=1, control=0
X = np.column_stack([np.ones(m), group])
KD_idx = group==1; WT_idx = group==0

# ----------------------------------------------------------------------
# 1a) median-of-ratios size factors
# ----------------------------------------------------------------------
geo = np.exp(np.log(C+1e-9).mean(axis=1))
keep = C.min(1) > 0                       # DESeq2: exclude genes with any zero
sf  = np.array([np.median(C[keep,j]/geo[keep]) for j in range(m)])
offset = np.log(sf)
print("size factors:", {c: round(float(s),3) for c,s in zip(df.columns[1:], sf)})

# ----------------------------------------------------------------------
# 1b) NB mean model (closed-form Poisson MLE for 2-group offset design)
#     NB and Poisson share the same mean model -> identical beta MLE.
# ----------------------------------------------------------------------
sumK = C[:,KD_idx].sum(1); sumW = C[:,WT_idx].sum(1)
sfK  = sf[KD_idx].sum();    sfW  = sf[WT_idx].sum()
with np.errstate(divide="ignore", invalid="ignore"):
    beta1 = np.log((sumK/sfK + 1e-9)/(sumW/sfW + 1e-9))   # natural logFC
    beta0 = np.log(sumW/sfW + 1e-9)
mu = sf[None,:] * np.exp(beta0[:,None] + beta1[:,None]*group[None,:])  # (n,6)
# Poisson Fisher information  I = X' diag(mu) X  -> SE(beta1)
WX = mu[:,:,None] * X[None,:,:]                # (n,6,2)
I  = np.einsum('ab,nak->nbk', X, WX)           # (n,2,2)
Iinv = np.linalg.inv(I)
se_pois = np.sqrt(np.clip(Iinv[:,1,1], 1e-12, None))

# ----------------------------------------------------------------------
# 1c) dispersion: per-gene (Fisher) -> trend -> shrunken (DESeq2-style)
# ----------------------------------------------------------------------
baseMean = C.mean(1)
p = 2
dev = ((C-mu)**2/mu - 1.0)/mu
alpha_gw = np.clip(dev.mean(1)/(m-p), 1e-4, 10.0)
alpha_common = float(np.median(alpha_gw))
# trend: binned median of log(alpha_gw) vs log(baseMean)
x = np.log(np.clip(baseMean,1e-9,None)); y = np.log(alpha_gw)
rng = x.max()-x.min(); nb=40; lt=np.zeros_like(x)
for i in range(n):
    sel = np.abs(x-x[i]) < rng/nb
    lt[i] = np.median(y[sel]) if sel.sum()>2 else y.mean()
order=np.argsort(x); alpha_trend = np.exp(np.interp(x, x[order], lt[order]))
alpha_final = np.sqrt(np.clip(alpha_gw,1e-4,None)*np.clip(alpha_trend,1e-4,None))  # shrunken

# ----------------------------------------------------------------------
# 1d) Wald test with NB-scaled SE  (SE_NB = SE_pois * sqrt(1+alpha*baseMean))
# ----------------------------------------------------------------------
se_nb = se_pois * np.sqrt(1.0 + alpha_final*baseMean)
log2FC   = beta1/np.log(2)
se_log2  = se_nb/np.log(2)
z = beta1/se_nb
pval = 2*stats.norm.sf(np.abs(z))

# ----------------------------------------------------------------------
# 1e) apeglm log2FC shrinkage
#     theta = argmin 0.5*((theta-m)/s)^2 + log(1+(theta/s)^2)   (Cauchy prior)
# ----------------------------------------------------------------------
def apeglm_shrink(m, s):
    s = np.where(s<1e-6, 1e-6, s)
    out = np.empty_like(m)
    for i in range(len(m)):
        mi, si = m[i], s[i]
        if mi==0: out[i]=0; continue
        f = lambda t: 0.5*((t-mi)/si)**2 + np.log(1.0+(t/si)**2)
        r = stats.norm  # placeholder
        from scipy.optimize import minimize_scalar
        sol = minimize_scalar(f, bounds=(-abs(mi)*1.0, abs(mi)*1.0), method='bounded')
        out[i]=sol.x
    return out
print("apeglm shrinkage on", n, "genes ...")
t1=time.time()
log2FC_shrunk = apeglm_shrink(log2FC, se_log2)
print("  apeglm done in", round(time.time()-t1,1),"s")

# ----------------------------------------------------------------------
# 1f) DE set + ranked list
# ----------------------------------------------------------------------
de_mask = (pval<0.05) & (np.abs(log2FC_shrunk)>1.0) & (baseMean>10.0)
n_up   = int(((pval<0.05)&(log2FC_shrunk>1)&(baseMean>10)).sum())
n_dn   = int(((pval<0.05)&(log2FC_shrunk<-1)&(baseMean>10)).sum())
print(f"DE genes (p<0.05,|log2FC|>1,baseMean>10): {int(de_mask.sum())}  (up={n_up}, down={n_dn})")

neglogp = -np.log10(np.clip(pval,1e-300,None))
rank_full   = np.sign(log2FC_shrunk)*neglogp     # PRIMARY ranking (full list)
rank_ponly  = neglogp                            # sensitivity: -log10(p) only
order_full  = np.argsort(-rank_full)
genes_ranked = geneID[order_full]
np.savez(os.path.join(OUT,"de_results.npz"),
         geneID=geneID, log2FC=log2FC, log2FC_shrunk=log2FC_shrunk,
         pval=pval, baseMean=baseMean, se_log2=se_log2,
         rank_full=rank_full, rank_ponly=rank_ponly, de_mask=de_mask,
         sf=sf, group=group)
pd.DataFrame({"geneID":geneID,"baseMean":baseMean,"log2FC":log2FC,
              "log2FC_shrunk":log2FC_shrunk,"pvalue":pval,"DE":de_mask}
             ).to_csv(os.path.join(OUT,"de_results.csv"),index=False)
pd.DataFrame({"gene":genes_ranked,"rank":rank_full[order_full]}
             ).to_csv(os.path.join(OUT,"ranked_list.csv"),index=False)

# ----------------------------------------------------------------------
# 2) GSEA
# ----------------------------------------------------------------------
def gsea_gseapy(ranked, gene_sets_name="KEGG_2019_Mouse"):
    """PRIMARY required method: gseapy + KEGG_2019_Mouse library."""
    import gseapy as gp
    kwargs=dict(out_dir=OUT, processes=1, verbose=False,
                permutation_num=1000, min_size=15, max_size=500)
    try:
        res = gp.gsea_prerank(ranked, gene_sets=gene_sets_name, **kwargs)
    except Exception as e1:
        # fallback to a local GMT if gseapy cannot resolve the library name
        res = gp.gsea_prerank(ranked, gene_sets=gene_sets_name+".gmt", **kwargs)
    return res

def gsea_pure_python(ranked_genes, ranked_vals, gene_sets):
    """Faithful Subramanian/gseapy-style GSEA (ES via running sum; NES via
    gene-set-size permutation null). gene_sets: dict name->set(genes)."""
    N=len(ranked_vals); inrank=set(ranked_genes)
    def ES(gset):
        gset=gset & inrank
        if len(gset)<1: return 0.0
        hit=np.array([1 if g in gset else 0 for g in ranked_genes])
        P_hit=hit.sum(); P_miss=N-P_hit
        if P_hit==0 or P_miss==0: return 0.0
        rs=np.cumsum((hit/P_hit)-((1-hit)/P_miss))
        return max(rs.max(), -(-rs.min())) if rs.max()>-rs.min() else rs.min()
    # permutation null: random sets of same size
    rng=np.random.default_rng(0); genes_all=np.array(list(inrank))
    results=[]
    for name,gset in gene_sets.items():
        e0=ES(gset)
        sz=len(gset&inrank)
        if sz<1: continue
        perm=[]
        for _ in range(1000):
            perm.append(ES(set(genes_all[rng.choice(len(genes_all),sz,replace=False)])))
        perm=np.array(perm)
        NES=e0/ (np.mean(perm)+1e-9)
        pv=np.mean(np.abs(perm)>=abs(e0))
        results.append({"pathway":name,"ES":e0,"NES":NES,"pval":pv,"size":sz})
    tab=pd.DataFrame(results)
    tab["FDR_q"]=(tab["pval"].rank()*len(tab)/tab["pval"].count())  # BH approx
    return tab.sort_values("NES",ascending=False)

gsea_done=False
# (a) try gseapy + KEGG_2019_Mouse (PRIMARY)
try:
    import gseapy  # noqa
    have_gp=True
except Exception:
    have_gp=False
if have_gp:
    try:
        r=gsea_gseapy(pd.Series(rank_full, index=genes_ranked), "KEGG_2019_Mouse")
        tab=r.res2d.copy()
        tab.to_csv(os.path.join(OUT,"gsea_results.csv"),index=False)
        gsea_done=True
        print("GSEA via gseapy (KEGG_2019_Mouse) OK")
        print(tab.head(10).to_string())
    except Exception as e:
        print("gseapy GSEA failed:", repr(e))
# (b) pure-python fallback IF a KEGG_2019_Mouse GMT is present locally
gmt_candidates=["KEGG_2019_Mouse.gmt","data/KEGG_2019_Mouse.gmt","kegg_2019_mouse.gmt"]
if not gsea_done:
    for gmt in gmt_candidates:
        if os.path.exists(gmt):
            gs={}
            for line in open(gmt):
                p=line.rstrip("\n").split("\t")
                if len(p)>=3: gs[p[0]]=set(p[2:])
            tab=gsea_pure_python(genes_ranked, rank_full, gs)
            tab.to_csv(os.path.join(OUT,"gsea_results.csv"),index=False)
            gsea_done=True
            print("GSEA via pure-python fallback on", gmt)
            print(tab.head(10).to_string())
            break

if not gsea_done:
    print("\n[GSEA NOT EXECUTED] gseapy + KEGG_2019_Mouse unavailable in this "
          "offline environment (no network / no gseapy / no local KEGG GMT). "
          "The DE step above WAS executed. The primary gseapy path "
          "(gp.gsea_prerank(..., gene_sets='KEGG_2019_Mouse')) will produce the "
          "pathway in a provisioned (internet) runner.")

# summary
o=np.argsort(-rank_full)
lines=[]
lines.append("UBE2M KD (KL1-3) vs control (WL1-3) | DESeq2-equivalent DE + GSEA(KEGG_2019_Mouse)")
lines.append("Size factors: "+", ".join("%s=%.3f"%(c,s) for c,s in zip(df.columns[1:],sf)))
lines.append("DE genes (p<0.05, |log2FC_shrunk|>1, baseMean>10): %d (up=%d, down=%d)"%(int(de_mask.sum()),n_up,n_dn))
lines.append("p<0.05 (no LFC/baseMean filter): %d"%int((pval<0.05).sum()))
lines.append("")
lines.append("Top 15 genes by rank = sign(log2FC_shrunk)*-log10(p):")
for i in o[:15]:
    lines.append("  %s  log2FC=%.2f shrunk=%.2f p=%.2e baseMean=%.0f"%(
        geneID[i], log2FC[i], log2FC_shrunk[i], pval[i], baseMean[i]))
lines.append("")
lines.append("GSEA status: "+("EXECUTED (see gsea_results.csv)" if gsea_done else
    "NOT EXECUTED offline (no network/gseapy/KEGG_2019_Mouse). The gseapy path "
    "gp.gsea_prerank(rnk, gene_sets='KEGG_2019_Mouse') completes it in a "
    "provisioned (internet) runner."))
open(os.path.join(OUT,"summary.txt"),"w").write("\n".join(lines)+"\n")
print("\n".join(lines))
print("\nTOTAL runtime", round(time.time()-T0,1),"s")
