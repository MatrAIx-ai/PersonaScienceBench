"""
BixBench bix-7-q2: Average number of CHIP variants per sample after filtering out
intronic, intergenic, and UTR variants.

Data:
  - data/CHIP_DP10_GQ20_PASS/*.xlsx : 86 per-sample workbooks (2-level header, 33 cols).
    Every row is a CHIP-panel variant (In_CHIP == True in all files); DP>=10/GQ>=20
    quality filters are pre-applied (folder name).
  - data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx : 56-gene CHIP panel (documentation only;
    files are already CHIP-scoped, so no re-filtering).
  - data/230215_Trio_Status.xlsx : trio metadata; NOT used for sample selection
    (no controls; 57/86 files use SRR IDs not present in it).

Approved logic (researcher-confirmed):
  * Keep rule: Zygosity != 'Reference' (NaN-zyg rows INCLUDED - valid DP/GQ, blank VAF
    is a reporting artifact).
  * Excluded SO terms: {intron_variant, intergenic_variant, 3_prime_UTR_variant,
    5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant}
    (the last is an SO child of 5_prime_UTR_variant -> semantically a UTR variant).
  * upstream_gene_variant is KEPT (not the literal 'intergenic_variant' term, which
    does not occur in the data).
  * Count one per row (no row carries multiple SO terms; duplicated Chr:Pos|Ref/Alt
    rows never pass the filter, so no dedup needed).
  * Denominator: all 86 samples.
"""
import glob
import os

import pandas as pd

EXCLUDE_SO = {
    "intron_variant",
    "intergenic_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}

files = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
assert len(files) == 86, f"expected 86 workbooks, found {len(files)}"

counts_primary = {}   # keep: zyg != 'Reference' (NaN included); exclude 5 UTR/intronic terms
counts_no_nan = {}    # sensitivity (i): only explicit Heterozygous / Homozygous Variant
counts_keep_pscg = {} # sensitivity (ii): do NOT exclude 5_prime_UTR_premature_start_codon_gain_variant
EXCL_NO_PSCG = EXCLUDE_SO - {"5_prime_UTR_premature_start_codon_gain_variant"}

for f in files:
    sample = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    df = pd.read_excel(f, header=[0, 1])
    zcol = [c for c in df.columns if c[1] == "Zygosity"][0]
    zyg = df[zcol]
    so = df[("RefSeq Genes 110, NCBI", "Sequence Ontology (Combined)")].astype(str)

    non_ref = zyg.astype(str) != "Reference"          # NaN -> 'nan' != 'Reference' -> True (included)
    explicit = zyg.isin(["Heterozygous", "Homozygous Variant"])

    counts_primary[sample] = int((non_ref & ~so.isin(EXCLUDE_SO)).sum())
    counts_no_nan[sample] = int((explicit & ~so.isin(EXCLUDE_SO)).sum())
    counts_keep_pscg[sample] = int((non_ref & ~so.isin(EXCL_NO_PSCG)).sum())

s_primary = pd.Series(counts_primary)
s_no_nan = pd.Series(counts_no_nan)
s_keep_pscg = pd.Series(counts_keep_pscg)

print(f"Samples analyzed: {len(s_primary)}")
print()
print("=== PRIMARY RESULT ===")
print(f"Total non-intronic/intergenic/UTR CHIP variants: {s_primary.sum()}")
print(f"Average per sample: {s_primary.mean():.4f}")
print(f"Min: {s_primary.min()}, Max: {s_primary.max()}, Median: {s_primary.median():.1f}")
print(f"Std: {s_primary.std(ddof=1):.2f}")
print()
print("Per-sample distribution:")
print(s_primary.describe().to_string())
print()
print("=== SENSITIVITY ===")
print(f"(i)  Exclude NaN-zyg rows (explicit Het/Homo only):  total={s_no_nan.sum()}, avg={s_no_nan.mean():.4f}")
print(f"(ii) Keep 5_prime_UTR_premature_start_codon_gain:    total={s_keep_pscg.sum()}, avg={s_keep_pscg.mean():.4f}")
print()
print("Per-sample counts (primary):")
print(s_primary.sort_values(ascending=False).to_string())
