"""
CHIP variants remaining after removing reference calls.

Interpretation (per researcher decision):
  - Counting unit = remaining variant CALLS (rows), one row per sample per variant entry.
  - Reference call := Zygosity == 'Reference'. Drop those rows.
  - Keep rows with missing (NaN) zygosity (a missing call is not a reference call).
  - No deduplication of multi-transcript (Chr:Pos, Ref/Alt) rows.
  - Headline = total non-Reference rows across all 86 sample workbooks.

Sensitivity / secondary:
  - Strict het+homvar only (exclude missing zygosity).
  - Unique variant positions (Chr:Pos|Ref/Alt) with >=1 non-ref call (incl. missing) / (het+homvar only).
"""
import glob, os, re
import pandas as pd

DATA = "data/CHIP_DP10_GQ20_PASS"
files = sorted(glob.glob(os.path.join(DATA, "*.xlsx")))
print(f"Sample workbooks found: {len(files)}")

def sample_id(fn):
    b = os.path.basename(fn).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    return b.strip()

records = []
for fn in files:
    # Two-row header: row 0 = group labels, row 1 = real column names -> header=1
    df = pd.read_excel(fn, header=1)
    df["__sample"] = sample_id(fn)
    records.append(df[["__sample", "Chr:Pos", "Ref/Alt", "Zygosity", "In_CHIP"]])

allv = pd.concat(records, ignore_index=True)

total_rows   = len(allv)
ref_rows     = int((allv["Zygosity"] == "Reference").sum())
nan_rows     = int(allv["Zygosity"].isna().sum())
nonref_any   = allv["Zygosity"] != "Reference"                 # keeps NaN (missing)
nonref_strict= allv["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])

# ---- HEADLINE: rows / calls ----
headline          = int(nonref_any.sum())
strict_het_homvar = int(nonref_strict.sum())

# ---- Secondary: unique variant positions ----
allv["vid"] = allv["Chr:Pos"] + "|" + allv["Ref/Alt"]
uniq_total      = allv["vid"].nunique()
uniq_nonref     = allv.loc[nonref_any, "vid"].nunique()       # >=1 non-ref call (incl. missing)
uniq_nonref_str = allv.loc[nonref_strict, "vid"].nunique()    # >=1 het/homvar call

# ---- Trio reconciliation: confirm 533 has no file ----
ts = pd.read_excel("data/230215_Trio_Status.xlsx")
trio_ids = set(str(x).strip() for x in ts["Sample ID"])
file_ids = set(sample_id(f) for f in files)
trio_numeric = {i for i in trio_ids if re.match(r"^\d+$", i)}
file_numeric_prefix = {re.match(r"^(\d+)", s).group(1) for s in file_ids if re.match(r"^\d+", s)}
missing_files = sorted(trio_numeric - file_numeric_prefix)

print("=" * 60)
print("HEADLINE (rows/calls, keep missing zygosity, no dedup):")
print(f"  total rows across all files      : {total_rows}")
print(f"  Reference rows removed           : {ref_rows}")
print(f"  non-Reference rows remaining     : {headline}")
print(f"    (missing/NaN zygosity kept     : {nan_rows})")
print("Sensitivity (strict het+homvar only, drop missing):")
print(f"  het+homvar rows                  : {strict_het_homvar}")
print("Secondary (unique variant positions Chr:Pos|Ref/Alt):")
print(f"  total unique variants            : {uniq_total}")
print(f"  unique with >=1 non-ref call     : {uniq_nonref}")
print(f"  unique with >=1 het/homvar call  : {uniq_nonref_str}")
print("Trio reconciliation:")
print(f"  trio IDs: {len(trio_ids)}  |  variant files: {len(file_ids)}")
print(f"  trio numeric IDs with NO variant file: {missing_files}")
print("=" * 60)
print(f"FINAL ANSWER: {headline} CHIP variant calls remain after removing reference calls.")
