import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_excel('data/MeRIP_RNA_result.xlsx', sheet_name='Date Formatting')
assert df[['m6A','DEG']].notna().all().all()

# (1) 3x3 contingency table
ct = pd.crosstab(df['m6A'], df['DEG'])
print("Contingency table (m6A x DEG):")
print(ct)
print("N =", ct.values.sum())

# (2) Primary: Pearson chi-squared test of independence
chi2, p, dof, exp = stats.chi2_contingency(ct)
print("\n--- PRIMARY: 3x3 Pearson chi-square ---")
print(f"chi2 = {chi2:.6f}, dof = {dof}, p = {p:.6e}")
print("Expected counts:\n", pd.DataFrame(exp, index=ct.index, columns=ct.columns).round(3))
print("Min expected:", exp.min().round(3))

# (3a) Sensitivity: binary reduction
# methylated = Hyper or Hypo ; unmethylated = no sig
# DE = Up or Down ; nonDE = no-DEGs
m_meth = df['m6A'].isin(['m6A Hyper','m6A Hypo']).astype(int)
d_de   = df['DEG'].isin(['Up','Down']).astype(int)
ct2 = pd.crosstab(m_meth, d_de)
print("\nBinary contingency table:\n", ct2)
chi2b, pb, dofb, expb = stats.chi2_contingency(ct2)
print(f"--- SENSITIVITY: binary chi-square ---")
print(f"chi2 = {chi2b:.6f}, dof = {dofb}, p = {pb:.6e}")

# (3b) Sensitivity: Fisher exact on 3x3
res = stats.fisher_exact if ct.shape==(2,2) else stats.fisher_exact
# scipy fisher_exact is 2x2 only; use chi2 for 3x3. Provide fisher for binary 2x2.
fr = stats.fisher_exact(ct2)
print(f"\n--- SENSITIVITY: Fisher exact (binary 2x2) ---")
print(f"odds_ratio = {fr.statistic:.6f}, p = {fr.pvalue:.6e}")

print("\n=== FINAL ANSWER (primary 3x3 Pearson chi-square p-value) ===")
print(f"{p:.3e}")
