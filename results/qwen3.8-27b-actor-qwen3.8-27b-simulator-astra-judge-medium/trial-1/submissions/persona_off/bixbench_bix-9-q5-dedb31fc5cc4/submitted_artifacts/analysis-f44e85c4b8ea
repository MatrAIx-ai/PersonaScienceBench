"""
BixBench bix-9-q5
Question: In which tissue type do bad responders show the highest number of
significantly differentially expressed (lfc>0.5 and basemean>10) genes
compared to controls?

Approach:
- NormCount sheet: row 3 is the header; 25402 gene rows follow.
- The "bad_responder vs Control" DESeq comparison is the 2nd block of each tissue:
    baseline_blood -> Comparison 2  (baseMean col 107, log2FoldChange col 111)
    dentate_gyrus  -> Comparison 5  (baseMean col 134, log2FoldChange col 138)
    final_blood    -> Comparison 8  (baseMean col 161, log2FoldChange col 165)
- Per tissue, count genes with log2FoldChange > 0.5 AND baseMean > 10 (NA/NaN excluded).
- Primary: signed lfc > 0.5. Sensitivity: reverse direction lfc < -0.5.
"""
import openpyxl
import numpy as np

def sf(x):
    if x is None:
        return np.nan
    try:
        return float(x)
    except (ValueError, TypeError):
        return np.nan

PATH = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# Comparison blocks: tissue -> (comparison_num, baseMean_col, lfc_col)  [0-indexed cols]
# base for comparison k (0-indexed) = 98 + 9*k ; baseMean=base+0, lfc=base+4
BLOCKS = {
    "baseline_blood": {"comp": 2, "basemean_col": 107, "lfc_col": 111},
    "dentate_gyrus":  {"comp": 5, "basemean_col": 134, "lfc_col": 138},
    "final_blood":    {"comp": 8, "basemean_col": 161, "lfc_col": 165},
}

wb = openpyxl.load_workbook(PATH, read_only=True)
ws = wb["NormCount"]

gene_ids = []
lfc = {t: [] for t in BLOCKS}
bmean = {t: [] for t in BLOCKS}

n = 0
for i, row in enumerate(ws.iter_rows(values_only=True)):
    if i < 4:  # skip 4 header rows (rows 0-3)
        continue
    gene_ids.append(row[1])
    for t, b in BLOCKS.items():
        lfc[t].append(sf(row[b["lfc_col"]]))
        bmean[t].append(sf(row[b["basemean_col"]]))
    n += 1
wb.close()

print(f"Loaded {n} gene rows from NormCount.")
print()

results = {}
for t in BLOCKS:
    L = np.array(lfc[t], dtype=float)
    B = np.array(bmean[t], dtype=float)
    # primary: signed lfc > 0.5 AND baseMean > 10
    primary = int(np.nansum((L > 0.5) & (B > 10)))
    # sensitivity: reverse direction lfc < -0.5 AND baseMean > 10
    reverse = int(np.nansum((L < -0.5) & (B > 10)))
    # how many genes have valid lfc / basemean at all
    valid_lfc = int(np.nansum(~np.isnan(L)))
    valid_bm = int(np.nansum(~np.isnan(B)))
    results[t] = (primary, reverse)
    print(f"{t:16s} (Comparison {BLOCKS[t]['comp']}): "
          f"lfc>0.5 & basemean>10 = {primary:5d}   |   lfc<-0.5 & basemean>10 = {reverse:5d}   "
          f"(valid lfc={valid_lfc}, valid basemean={valid_bm})")

print()
print("=" * 70)
best_primary = max(results, key=lambda t: results[t][0])
best_reverse = max(results, key=lambda t: results[t][1])
print("PRIMARY (literal signed lfc > 0.5):")
for t in sorted(results, key=lambda t: -results[t][0]):
    mark = "  <== MAX" if t == best_primary else ""
    print(f"   {t:16s} {results[t][0]:5d}{mark}")
print(f"   -> TISSUE WITH MAXIMUM: {best_primary}")
print()
print("SENSITIVITY (reverse direction lfc < -0.5):")
for t in sorted(results, key=lambda t: -results[t][1]):
    mark = "  <== MAX" if t == best_reverse else ""
    print(f"   {t:16s} {results[t][1]:5d}{mark}")
print(f"   -> TISSUE WITH MAXIMUM: {best_reverse}")
