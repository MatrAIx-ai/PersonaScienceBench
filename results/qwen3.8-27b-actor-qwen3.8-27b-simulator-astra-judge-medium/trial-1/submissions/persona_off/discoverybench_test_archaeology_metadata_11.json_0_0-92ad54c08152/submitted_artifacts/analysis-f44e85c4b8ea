import pandas as pd, numpy as np
df = pd.read_csv('data/time_series_data.csv', index_col=0)

# Primary signal: raw 100-year Z-values
sub = df[df['PotteryForm'].notna()][['CE','PotteryForm','PotteryDecoration']].copy()
sub['dForm'] = sub['PotteryForm'].diff()
sub['dDeco'] = sub['PotteryDecoration'].diff()
sub['BCE'] = -sub['CE']

# Identify the step with largest simultaneous Form-collapse + Decoration-increase
# score: steps where dForm<0 and dDeco>0, ranked by (magnitude of drop + rise)
cand = sub[(sub['dForm']<0)&(sub['dDeco']>0)].copy()
cand['score'] = (-cand['dForm']) + cand['dDeco']
best = cand.sort_values('score', ascending=False).iloc[0]
print("=== Best simultaneous transition ===")
print(f"Step: {best['BCE']+100:.0f} BCE -> {best['BCE']:.0f} BCE")
print(f"  PotteryForm: {best['PotteryForm']-best['dForm']:.2f} -> {best['PotteryForm']:.2f}  (dForm={best['dForm']:.2f})")
print(f"  PotteryDecoration: {best['PotteryDecoration']-best['dDeco']:.2f} -> {best['PotteryDecoration']:.2f}  (dDeco={best['dDeco']:.2f})")

# z-score of differences to confirm dominance
zF = (sub['dForm']-sub['dForm'].mean())/sub['dForm'].std()
zD = (sub['dDeco']-sub['dDeco'].mean())/sub['dDeco'].std()
sub['zF'], sub['zD'] = zF, zD
print("\n=== Difference table (all 100-yr steps) ===")
print(sub[['BCE','PotteryForm','dForm','zF','PotteryDecoration','dDeco','zD']].to_string(index=False, float_format=lambda x: f"{x: .2f}"))

# Cross-check with interpolated series: transition confined to -1800..-1700
w = df[(df['CE']>=-1850)&(df['CE']<=-1650)][['CE','PotteryForm_inter','PotteryDecoration_inter']]
print("\n=== Interpolated cross-check (every 25 yr) ===")
print(w[w['CE']%25==0].to_string(index=False, float_format=lambda x: f"{x: .3f}"))

# Net change across the window
a = df[df['CE']==-1800].iloc[0]; b = df[df['CE']==-1700].iloc[0]
print(f"\nNet change 1800->1700 BCE (inter): Form {a['PotteryForm_inter']:.2f}->{b['PotteryForm_inter']:.2f} ({b['PotteryForm_inter']-a['PotteryForm_inter']:+.2f}); "
      f"Deco {a['PotteryDecoration_inter']:.2f}->{b['PotteryDecoration_inter']:.2f} ({b['PotteryDecoration_inter']-a['PotteryDecoration_inter']:+.2f})")
