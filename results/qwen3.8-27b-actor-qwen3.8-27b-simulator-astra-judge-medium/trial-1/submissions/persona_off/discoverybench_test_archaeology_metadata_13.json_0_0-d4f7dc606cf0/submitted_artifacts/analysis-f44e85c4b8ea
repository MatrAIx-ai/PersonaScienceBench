import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv')
m = ts[(ts.CE >= -2000) & (ts.CE <= -1100)].copy()
m['bce'] = -m.CE
m['century'] = (m.bce // 100) + 1  # 15th c. BCE = 1500-1401 BCE -> bce//100+1
m['century'] = m['century'].astype(int)

tab = m.groupby('century').agg(
    mean_grate=('pollen_grate_100', 'mean'),
    max_grate=('pollen_grate_100', 'max'),
    mean_gall=('g_all_mean', 'mean'),
    max_gall=('g_all_mean', 'max'),
    mean_level=('pollen_inter_100', 'mean'),
    n=('CE', 'size'),
).sort_index(ascending=False)
tab = tab.reindex(range(20, 11, -1))
pd.set_option('display.float_format', lambda x: f'{x:.5f}')
print(tab.to_string())

# ranking by mean growth rate
rank = tab.sort_values('mean_grate', ascending=False)
print('\nRanking by mean pollen_grate_100:'); print(rank['mean_grate'].to_string())
rank2 = tab.sort_values('mean_gall', ascending=False)
print('\nRanking by mean g_all_mean:'); print(rank2['mean_gall'].to_string())

top = rank.index[0]; second = rank.index[1]
print(f'\nTop century: {top}th c. BCE (mean grate {tab.loc[top,"mean_grate"]:.5f}), '
      f'second: {second}th c. BCE ({tab.loc[second,"mean_grate"]:.5f}), '
      f'ratio {tab.loc[top,"mean_grate"]/tab.loc[second,"mean_grate"]:.2f}')

# annual peak location
pk = m.nlargest(15, 'pollen_grate_100')[['CE', 'pollen_grate_100', 'g_all_mean']]
print('\nTop 15 annual years by pollen_grate_100:'); print(pk.to_string(index=False))

# level peak cross-check
lv = m.nlargest(10, 'pollen_inter_100')[['CE', 'pollen_inter_100']]
print('\nTop 10 annual years by pollen_inter_100 (level):'); print(lv.to_string(index=False))
lvbin = m.groupby('century')['pollen_inter_100'].max().sort_values(ascending=False)
print('\nMax level per century:'); print(lvbin.to_string())

# sustained-growth check: contiguous positive centuries
pos = tab[tab['mean_grate'] > 0]
print('\nCenturies with positive mean growth:', pos.index.tolist())

# share of years with positive grate per century
posshare = m[m.pollen_grate_100 > 0].groupby('century').size() / m.groupby('century').size()
print('\nShare of years with positive growth:'); print(posshare.to_string())
