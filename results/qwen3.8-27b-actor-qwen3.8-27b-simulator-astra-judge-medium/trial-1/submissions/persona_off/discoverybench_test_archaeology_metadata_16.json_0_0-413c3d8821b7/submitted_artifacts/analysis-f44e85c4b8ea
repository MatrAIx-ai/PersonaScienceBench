"""
PCA on forms-of-capital variables in 100-year slices (capital.csv).
Compute PC1 per slice and characterize the Middle Neolithic (MN, 3400-3000 BCE)
and Younger Neolithic (SG, 2900-2300 BCE) phases.
"""
import pandas as pd
import numpy as np

# ---------- Load & parse (comma decimal separators) ----------
df = pd.read_csv('data/capital.csv')
zcols = [c for c in df.columns if c.startswith('Z')]
assert len(zcols) == 12, f"expected 12 Z cols, got {len(zcols)}"

for c in zcols:
    df[c] = df[c].apply(lambda s: np.nan if pd.isna(s) else float(str(s).replace(',', '.')))

X = df[zcols].values.astype(float)
n_obs, n_var = X.shape
print(f"slices(observations)={n_obs}  capital variables={n_var}")
print("missing values per column:\n", df[zcols].isna().sum().to_string())

# ---------- PCA on correlation matrix (center + scale) ----------
Xs = (X - X.mean(0)) / X.std(0, ddof=0)          # standardize each variable
C = np.corrcoef(Xs, rowvar=False)                 # correlation matrix
evals, evecs = np.linalg.eigh(C)
order = np.argsort(evals)[::-1]
evals, evecs = evals[order], evecs[:, order]
eigvals = evals * n_var                          # eigenvalues (Kaiser form)
evr = evals / evals.sum()

scores = Xs @ evecs                              # PC scores per slice
df['PC1'] = scores[:, 0]

print("\nEigenvalues (Kaiser):", np.round(eigvals, 3))
print("Explained variance ratio:", np.round(evr, 4))
print("Cumulative EVR:", np.round(np.cumsum(evr), 4))
print(f"PC1 eigenvalue={eigvals[0]:.3f}, EVR={evr[0]*100:.1f}%")

print("\nPC1 loadings (correlation basis):")
for c, l in sorted(zip(zcols, evecs[:, 0]), key=lambda t: -abs(t[1])):
    print(f"  {c:14s} {l:+.3f}")

# ---------- Phase assignment (by BCE range, verified vs group col) ----------
def phase(b):
    if 3000 <= b <= 3400: return 'MN'
    if 2300 <= b <= 2900: return 'SG'
    return None
df['phase'] = df['BCE'].apply(phase)

# sanity: group vs our BCE-based phase
chk = df[df.phase.notna()][['BCE', 'group', 'phase']]
print("\nPhase mapping check (MN should=group MN, SG should=group SG):")
print(chk.to_string(index=False))

# ---------- (a) per-slice PC1 ----------
print("\n=== (a) Per-slice PC1 for the two phases ===")
for p in ['MN', 'SG']:
    sub = df[df.phase == p].sort_values('BCE', ascending=False)
    print(f"\n{p}:")
    for _, r in sub.iterrows():
        print(f"  {int(r.BCE)} BCE  PC1={r.PC1:+.4f}")

# ---------- (b) mean +/- SD per phase ----------
print("\n=== (b) Mean +/- SD PC1 per phase ===")
summ = {}
for p in ['MN', 'SG']:
    s = df[df.phase == p]['PC1']
    summ[p] = (s.mean(), s.std(ddof=1), s.min(), s.max(), len(s))
    print(f"  {p}: mean={s.mean():+.3f}  SD={s.std(ddof=1):.3f}  min={s.min():+.3f}  max={s.max():+.3f}  n={len(s)}")

# ---------- (c) within-phase trend (slope of PC1 vs time) ----------
# time axis: use -BCE so increasing = forward in time (older -> younger)
print("\n=== (c) Within-phase linear trend (slope of PC1 per 100-yr slice, forward in time) ===")
for p in ['MN', 'SG']:
    sub = df[df.phase == p].sort_values('BCE', ascending=False)
    t = sub['BCE'].values.astype(float)
    y = sub['PC1'].values
    slope = np.polyfit(t, y, 1)[0]   # per unit BCE; per 100-yr = slope*100
    print(f"  {p}: d(PC1)/d(BCE)={slope:+.4f}  -> per 100yr (forward in time)={-slope*100:+.3f}")

# ---------- (d) relative magnitude vs overall + adjacent phases ----------
print("\n=== (d) Relative magnitude ===")
overall = df['PC1']
print(f"  Overall series: mean={overall.mean():+.3f} SD={overall.std(ddof=1):.3f} min={overall.min():+.3f} max={overall.max():+.3f}")
# group-based adjacent phases
for g in ['EN', 'MN', 'SG', 'LN', 'OBA', 'YBA']:
    s = df[df.group == g]['PC1']
    print(f"  group {g:4s}: mean PC1={s.mean():+.3f}  (n={len(s)})")
print(f"  MN relative to overall mean: {summ['MN'][0]-overall.mean():+.3f}")
print(f"  SG relative to overall mean: {summ['SG'][0]-overall.mean():+.3f}")
print(f"  MN - SG (mean difference): {summ['MN'][0]-summ['SG'][0]:+.3f}")
# percentile ranks within full series
for p in ['MN', 'SG']:
    s = df[df.phase == p]['PC1']
    ov = overall.values
    pct = np.array([(ov < v).mean() for v in s.values])
    print(f"  {p} PC1 percentiles in full series: {np.round(pct*100,0)}")

# ---------- save tables ----------
out = df[['BCE', 'group', 'phase'] + zcols + ['PC1']].copy()
out = out.sort_values('BCE', ascending=False)
out.to_csv('pc1_scores_per_slice.csv', index=False)

phase_tab = pd.DataFrame({
    'phase': ['MN (3400-3000)', 'SG (2900-2300)'],
    'mean_PC1': [summ['MN'][0], summ['SG'][0]],
    'SD_PC1': [summ['MN'][1], summ['SG'][1]],
    'min_PC1': [summ['MN'][2], summ['SG'][2]],
    'max_PC1': [summ['MN'][3], summ['SG'][3]],
    'n': [summ['MN'][4], summ['SG'][4]],
})
phase_tab.to_csv('pc1_phase_summary.csv', index=False)

load_tab = pd.DataFrame({'variable': zcols, 'PC1_loading': evecs[:, 0]})
load_tab['eigenvalue_PC1'] = eigvals[0]
load_tab['evr_PC1'] = evr[0]
load_tab.to_csv('pc1_loadings.csv', index=False)

print("\nSaved: pc1_scores_per_slice.csv, pc1_phase_summary.csv, pc1_loadings.csv")
