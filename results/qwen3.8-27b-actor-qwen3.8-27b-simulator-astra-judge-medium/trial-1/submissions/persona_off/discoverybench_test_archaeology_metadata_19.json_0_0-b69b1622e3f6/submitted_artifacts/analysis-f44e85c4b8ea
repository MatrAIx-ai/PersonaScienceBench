import pandas as pd, numpy as np

raw = pd.read_csv('data/capital.csv')
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
def conv(x):
    if pd.isna(x): return np.nan
    return float(str(x).replace(',','.'))
for c in zcols: raw[c]=raw[c].map(conv)
raw=raw.sort_values('BCE').reset_index(drop=True)
bins=[1100,1000,900,800,700,600,500]
win=raw[raw['BCE'].isin(bins)].reset_index(drop=True)

def pca_scores(X):
    # X already standardized (z-scored); correlation PCA = SVD of X
    U,S,Vt=np.linalg.svd(X,full_matrices=False)
    comp1=Vt[0]
    scores=U[:,0]*S[0]
    evr=S**2/np.sum(S**2)
    return scores,evr,comp1

print("="*60)
print("PRIMARY: PCA on full dataset (39 x 12), existing Z-scores")
print("="*60)
X=raw[zcols].values
sc,evr,comp1=pca_scores(X)
raw['PC1']=sc
print("PC1 explained var ratio:", round(evr[0],4))
print("top3 evr:", np.round(evr[:3],4))
ld=pd.Series(comp1,index=zcols).sort_values(key=abs,ascending=False)
print("\nTop loadings PC1 (full):"); print(ld.round(3).to_string())
print("\nPC1 scores at window bins (full-data PCA):")
sub=raw.set_index('BCE')['PC1'].reindex(bins)
print(sub.round(4).to_string())
pc1100=sub[1100]; rest=sub[[1000,900,800,700,600,500]]
print(f"\nPC1@1100={pc1100:.4f}; rest mean={rest.mean():.4f} range=[{rest.min():.4f},{rest.max():.4f}]")
print(f"contrast 1100-rest_mean={pc1100-rest.mean():.4f}; 1100 is {'ABOVE' if pc1100>rest.mean() else 'BELOW'} rest")

print("\n"+"="*60)
print("SENSITIVITY: PCA on sub-window only (7 rows), re-standardized, drop zero-var")
print("="*60)
wz=win[zcols].copy()
keep=[c for c in zcols if wz[c].nunique()>1]
print("dropped:", [c for c in zcols if c not in keep])
Zs=(wz[keep]-wz[keep].mean())/(wz[keep].std(ddof=0))
sc2,evr2,comp2=pca_scores(Zs.values)
wz['PC1']=sc2
print("PC1 evr (window):", round(evr2[0],4))
print(wz.set_index('BCE')['PC1'].reindex(bins).round(4).to_string())
