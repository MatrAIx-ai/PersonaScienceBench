import pandas as pd, numpy as np

# ---- Load ----
cap = pd.read_csv("data/capital.csv", decimal=",")
cap = cap.drop(columns=["group", "color"])
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
names = {'ZAxtSchwert':'Hatchet/Sword','ZDolch':'Dagger','Zhausgr':'House Size',
         'ZCU_AU':'Copper/Gold','Zamber':'Amber','ZMonument':'Monument Count',
         'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'Axes/Celts','ZMW':'Monument Size',
         'ZKeform':'Pottery Form','Zkeverz':'Pottery Decor'}
# sort ascending in time (oldest first)
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)  # BCE desc -> earliest(4300) first
X = cap[zcols].astype(float).to_numpy()
n, p = X.shape
bce = cap['BCE'].to_numpy()

# ---- Standardize (ddof=1) ----
mu = X.mean(axis=0); sd = X.std(axis=0, ddof=1)
Xs = (X - mu) / sd

# ---- Correlation matrix + eigendecomposition ----
C = np.corrcoef(Xs, rowvar=False)          # == (1/(n-1)) Xs.T Xs
w, V = np.linalg.eigh(C)                   # ascending
idx = np.argsort(w)[::-1]
w = w[idx]; V = V[:, idx]
# fix sign: largest-|loading| positive
for j in range(V.shape[1]):
    k = np.argmax(np.abs(V[:, j]))
    if V[k, j] < 0:
        V[:, j] = -V[:, j]
evr = w / w.sum() * 100

# ---- Scores ----
scores = Xs @ V                            # n x p ; PC1=scores[:,0], PC2=scores[:,1]

# ---- Report ----
print("n slices =", n, " n vars =", p)
print("\n=== Eigenvalues & % variance explained ===")
for j in range(p):
    mark = "  <== PC%d"% (j+1) if j<2 else ""
    print(f"PC{j+1:2d}: eig={w[j]:7.4f}  var%={evr[j]:6.2f}{mark}")
print(f"PC1+PC2 combined var% = {evr[0]+evr[1]:.2f}")

def loadings(pc):
    return V[:, pc]

print("\n=== Loadings (eigenvector coefficients) on PC1 and PC2 ===")
print(f"{'Variable':<16}{'PC1':>8}{'PC2':>8}")
for i,c in enumerate(zcols):
    star = " *" if c in ['ZAxtSchwert','ZDolch','Zhausgr'] else ""
    print(f"{names[c]:<16}{V[i,0]:>8.3f}{V[i,1]:>8.3f}{star}")
print("(* = the 3 symbolic-capital indicators)")

# ---- Scores of the 3 symbolic vars? Actually scores are per-slice. ----
# Temporal spread of PC2 scores overall + PC2 loadings of the 3 vars
print("\n=== PC1 / PC2 scores per 100-yr slice (all 39) ===")
print(f"{'BCE':>6}{'PC1_score':>11}{'PC2_score':>11}")
for t in range(n):
    print(f"{bce[t]:>6}{scores[t,0]:>11.3f}{scores[t,1]:>11.3f}")

pc1s = scores[:,0]; pc2s = scores[:,1]
print(f"\nPC1 score range: {pc1s.min():.3f} .. {pc1s.max():.3f} (mean {pc1s.mean():.3f})")
print(f"PC2 score range: {pc2s.min():.3f} .. {pc2s.max():.3f} (mean {pc2s.mean():.3f})")

# The 3 symbolic vars' own raw Z trajectories to describe their PC2 spread in variable terms
print("\n=== The 3 symbolic vars: raw Z per slice (subset) ===")
sym = ['ZAxtSchwert','ZDolch','Zhausgr']
sub = cap[['BCE']+sym].copy()
print(sub.to_string(index=False))

# ---- Stability: bootstrap (resample slices with replacement) on var% and PC2 loadings ----
rng = np.random.default_rng(0)
B = 500
boot_evr1 = np.empty(B); boot_evr2 = np.empty(B)
boot_pc2 = np.empty((B, p))
for b in range(B):
    s = rng.integers(0, n, n)
    Xb = Xs[s]
    Cb = np.corrcoef(Xb, rowvar=False)
    wb, Vb = np.linalg.eigh(Cb)
    ib = np.argsort(wb)[::-1]
    wb = wb[ib]; Vb = Vb[:, ib]
    boot_evr1[b] = wb[0]/wb.sum()*100
    boot_evr2[b] = wb[1]/wb.sum()*100
    # align PC2 sign to the main solution
    k = np.argmax(np.abs(V[:,1]))
    if np.dot(Vb[:,1], V[:,1]) < 0:
        Vb[:,1] = -Vb[:,1]
    boot_pc2[b] = Vb[:,1]
print("\n=== Bootstrap stability (B=500, resample 39 slices) ===")
print(f"PC1 var% : mean={boot_evr1.mean():.2f}  5-95% CI=[{np.percentile(boot_evr1,5):.2f},{np.percentile(boot_evr1,95):.2f}]")
print(f"PC2 var% : mean={boot_evr2.mean():.2f}  5-95% CI=[{np.percentile(boot_evr2,5):.2f},{np.percentile(boot_evr2,95):.2f}]")
for i,c in enumerate(zcols):
    v = boot_pc2[:,i]
    star = " *" if c in sym else ""
    print(f"PC2 loading {names[c]:<14}: est={V[i,1]: .3f}  5-95% CI=[{np.percentile(v,5): .3f},{np.percentile(v,95): .3f}]{star}")
