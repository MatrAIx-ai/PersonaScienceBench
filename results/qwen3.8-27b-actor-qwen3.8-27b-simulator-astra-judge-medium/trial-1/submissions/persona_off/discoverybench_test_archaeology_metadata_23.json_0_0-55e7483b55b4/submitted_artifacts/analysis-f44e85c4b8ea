#!/usr/bin/env python3
"""
DiscoveryBench archaeology: MonumentCount & AxesCelts vs symbolic-capital
elements (HatchetSword, Dagger, HouseSize) over 3400-3000 BCE, contextualized
by pollen openness (Belau+Woserin PC1) and demographic KDE proxies.

All capital variables are Z-scores -> statements are about RELATIVE ABUNDANCE,
not literal counts. 5-point correlations are DIRECTIONAL only (n=5, low power).
"""
import pandas as pd, numpy as np

pd.set_option('display.width', 220)
pd.set_option('display.float_format', lambda x: f'{x:.3f}')

GRID = [-3400, -3300, -3200, -3100, -3000]   # CE (negative = BCE), forward in time
BCE  = [-c for c in GRID]

# ---------- load ----------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)

cap = pd.read_csv('data/capital.csv')
cap_num = [c for c in cap.columns if c not in ('BCE','group','color')]
for c in cap_num:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',','.').str.strip(), errors='coerce')

pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
pol_num = [c for c in pol.columns if c not in ('calBP','CE')]
for c in pol_num:
    pol[c] = pd.to_numeric(pol[c].astype(str).str.replace(',','.').str.strip(), errors='coerce')

# ---------- Step 1: 5-point window table ----------
core = {
    'MonumentCount': 'MonumentCount', 'AxesCelts': 'AxesCelts',
    'HatchetSword': 'HatchetSword', 'Dagger': 'Dagger', 'HouseSize': 'HouseSize',
}
rows = []
for ce in GRID:
    r = {'CE': ce, 'BCE': -ce, 'calBP': -ce + 1950}
    for k, col in core.items():
        r[k] = ts.loc[ts.CE == ce, col].iloc[0]          # RAW 100-yr grid point
    r['Pollen_MEAN']      = pol.loc[pol.CE == ce, 'MEAN'].iloc[0]
    r['Pollen_SMOOTH_100']= pol.loc[pol.CE == ce, 'SMOOTH_MEAN_100y'].iloc[0]
    r['kde_all_mean']     = ts.loc[ts.CE == ce, 'kde_all_mean'].iloc[0]
    r['g_all_mean']       = ts.loc[ts.CE == ce, 'g_all_mean'].iloc[0]
    rows.append(r)
tbl = pd.DataFrame(rows)

print('='*90)
print('STEP 1 — 5-POINT WINDOW TABLE (3400 -> 3000 BCE), RAW 100-yr grid points + context')
print('='*90)
print(tbl.to_string(index=False))

# cross-check capital.csv identity for core vars
cap_w = cap[cap.BCE.isin(BCE)].sort_values('BCE', ascending=False).reset_index(drop=True)
mp = {'MonumentCount':'ZMonument','AxesCelts':'ZBeil','HatchetSword':'ZAxtSchwert',
      'Dagger':'ZDolch','HouseSize':'Zhausgr'}
ident = all(np.allclose(tbl[k].values, cap_w[mp[k]].values) for k in core)
print(f'\n[cross-file check] core 5-pt values identical between time_series RAW & capital.csv: {ident}')

# ---------- Step 2: per-variable delta + peak/trough ----------
print('\n'+'='*90)
print('STEP 2 — WITHIN-WINDOW CHANGE (delta 3400->3000) and PEAK / TROUGH')
print('='*90)
core_cols = list(core.keys())
for k in core_cols + ['Pollen_MEAN','Pollen_SMOOTH_100','kde_all_mean']:
    v = tbl[k].values
    d = v[-1] - v[0]
    ipk = int(np.argmax(v)); itr = int(np.argmin(v))
    print(f'{k:18s} 3400BCE={v[0]:+.3f}  3000BCE={v[-1]:+.3f}  delta={d:+.3f}  '
          f'peak@{BCE[ipk]}BCE={v[ipk]:+.3f}  trough@{BCE[itr]}BCE={v[itr]:+.3f}')

# ---------- Step 3: trend slopes ----------
def trend(y):
    x = np.arange(len(y), dtype=float)
    slope, intercept = np.polyfit(x, y, 1)          # per 100-yr step
    yhat = slope*x + intercept
    ss_res = np.sum((y-yhat)**2); ss_tot = np.sum((y-np.mean(y))**2)
    r2 = 1 - ss_res/ss_tot if ss_tot > 0 else np.nan
    return slope, r2

print('\n'+'='*90)
print('STEP 3a — LINEAR TREND (primary, 5 RAW points): slope per 100-yr step, R^2')
print('='*90)
for k in core_cols + ['Pollen_MEAN','Pollen_SMOOTH_100','kde_all_mean']:
    s, r2 = trend(tbl[k].values)
    print(f'{k:18s} slope(0-100yr)={s:+.4f}   R^2={r2:.3f}')

# interpolated sensitivity trend (401 pts, per year)
win = ts[(ts.CE >= -3400) & (ts.CE <= -3000)].reset_index(drop=True)
x401 = (win.CE.values + 3400).astype(float)         # 0..400, forward in time
print('\n'+'='*90)
print('STEP 3b — LINEAR TREND (SENSITIVITY, 401 interpolated pts): slope per year, R^2')
print('='*90)
for k in core_cols:
    y = win[k+'_inter'].values
    slope_per_yr, _ = np.polyfit(x401, y, 1)
    yhat = np.polyval(np.polyfit(x401, y, 1), x401)
    ss_res = np.sum((y-yhat)**2); ss_tot = np.sum((y-np.mean(y))**2)
    r2 = 1 - ss_res/ss_tot if ss_tot > 0 else np.nan
    print(f'{k:18s} slope(per yr)={slope_per_yr:+.5f}  (total 400yr ~ {slope_per_yr*400:+.3f})  R^2={r2:.3f}')

# ---------- Step 4: correlation matrix, 5-pt primary ----------
print('\n'+'='*90)
print('STEP 4 — PEARSON CORRELATION MATRIX (PRIMARY, 5 RAW points) — DIRECTIONAL ONLY, n=5')
print('='*90)
print('NOTE: Dagger is constant in-window (std=0) -> correlation undefined (NaN).')
C5 = tbl[core_cols].corr(method='pearson')
print(C5.to_string(float_format=lambda x: f'{x:+.3f}' if not np.isnan(x) else '  nan'))

# ---------- Step 5: 401-pt interpolated sensitivity correlation ----------
print('\n'+'='*90)
print('STEP 5 — PEARSON CORRELATION MATRIX (SENSITIVITY, 401 interpolated pts)')
print('='*90)
print('Caveat: interpolated points are autocorrelated -> effective n inflated; direction only.')
inter = {k: win[k+'_inter'].values for k in core_cols}
inter['Pollen_MEAN'] = pol.loc[pol.CE.isin(range(-3400,-2999)), 'MEAN'].sort_index().values
inter['kde_all_mean']= win['kde_all_mean'].values
C401 = pd.DataFrame(inter).corr(method='pearson')
print(C401.to_string(float_format=lambda x: f'{x:+.3f}'))

# ---------- Step 6: contextual openness / demographic trend ----------
print('\n'+'='*90)
print('STEP 6 — CONTEXT: openness & demographic trend across window')
print('='*90)
pm = tbl['Pollen_MEAN'].values
print(f"Pollen MEAN: 3400BCE={pm[0]:+.3f} -> 3000BCE={pm[-1]:+.3f}  (delta {pm[-1]-pm[0]:+.3f}; "
      f"monotonic decline={bool(np.all(np.diff(pm)<0))})")
ps = tbl['Pollen_SMOOTH_100'].values
print(f"Pollen SMOOTH_100y: 3400BCE={ps[0]:+.3f} -> 3000BCE={ps[-1]:+.3f}  (delta {ps[-1]-ps[0]:+.3f})")
kd = tbl['kde_all_mean'].values
print(f"kde_all_mean: 3400BCE={kd[0]:.6f} -> 3000BCE={kd[-1]:.6f}  (delta {kd[-1]-kd[0]:+.6f}; "
      f"declining={bool(kd[-1]<kd[0])})")
print(f"g_all_mean (growth rate) range in window: {tbl['g_all_mean'].min():+.6f} .. {tbl['g_all_mean'].max():+.6f} "
      f"(all negative={bool((tbl['g_all_mean']<0).all())})")

# ---------- save report ----------
import io, contextlib
buf = io.StringIO()
with contextlib.redirect_stdout(buf):
    pass
