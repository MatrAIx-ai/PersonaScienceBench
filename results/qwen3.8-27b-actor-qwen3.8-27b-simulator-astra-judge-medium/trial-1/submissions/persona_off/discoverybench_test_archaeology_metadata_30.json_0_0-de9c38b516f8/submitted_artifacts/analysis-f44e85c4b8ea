import pandas as pd, numpy as np

df = pd.read_csv('data/time_series_data.csv', index_col=0)

# --- (a) centennial points -> per-century delta table ---
def centennial(col):
    s = df[col].dropna()
    return s.index.values, s.values

for col in ['PotteryForm','PotteryDecoration']:
    idx, vals = centennial(col)
    ce = df.loc[idx,'CE'].values
    d = np.diff(vals)  # delta from ce[i] to ce[i+1]
    # the century the interval belongs to (start-based): floor(ce[i]/100)
    k = np.floor(ce[:-1]/100).astype(int)
    print(col, 'n deltas', len(d))

pf_idx, pf_v = centennial('PotteryForm')
pd_idx, pd_v = centennial('PotteryDecoration')
ce = df.loc[pf_idx,'CE'].values
d_form = np.diff(pf_v)
d_dec  = np.diff(pd_v)
k = np.floor(ce[:-1]/100).astype(int)   # start-based century label (negative = BCE)

tab = pd.DataFrame({
    'century_label': k,
    'century_str': [f"{abs(x)}th c. BCE" for x in k],
    'span': [f"{abs(a)}-{abs(b)} BCE" for a,b in zip(ce[:-1], ce[1:])],
    'form_start': pf_v[:-1], 'form_end': pf_v[1:], 'd_form': d_form,
    'dec_start': pd_v[:-1], 'dec_end': pd_v[1:], 'd_dec': d_dec,
})
pd.set_option('display.width',200)
print(tab.to_string(index=False))

# --- (b) apply rule, first qualifying scanning oldest->newest ---
def first_qualifying(T, require_form_sig=False):
    mask = (tab.d_dec > T) & (tab.d_form < 0)
    if require_form_sig:
        mask = mask & (tab.d_form < -T)
    q = tab[mask]
    if len(q)==0: return None
    r = q.iloc[0]
    return r

for T in [0.3,0.5,1.0]:
    r = first_qualifying(T)
    if r is None: print('T',T,'-> none')
    else:
        print(f"T={T}: first qualifying = {r.century_str} ({r.span})  d_dec={r.d_dec:+.3f} d_form={r.d_form:+.3f}")

# also with form-significance required at T=0.5
r=first_qualifying(0.5, require_form_sig=True)
print("T=0.5 (form also sig):", r.century_str, r.span, f"d_dec={r.d_dec:+.3f} d_form={r.d_form:+.3f}")

# --- (c) cross-check with capital.csv ---
cap = pd.read_csv('data/capital.csv')
for c in ['ZKeform','Zkeverz']:
    cap[c] = cap[c].astype(str).str.replace(',','.').astype(float)
cap = cap.sort_values('BCE', ascending=False)  # oldest (largest BCE) first
bce = cap.BCE.values
df_ = np.diff(cap.ZKeform.values)
dd_ = np.diff(cap.Zkeverz.values)
kk = bce[:-1]  # start BCE of each interval
ct = pd.DataFrame({'BCE_start':kk,'BCE_end':bce[1:],
                   'd_form':df_,'d_dec':dd_})
ct['century'] = [f"{a}-{b} BCE" for a,b in zip(kk, bce[1:])]
print("\ncapital.csv deltas (nonzero only):")
print(ct[(ct.d_form!=0)|(ct.d_dec!=0)].to_string(index=False))
mask_c = (ct.d_dec>0.5)&(ct.d_form<0)
print("capital.csv first qualifying (T=0.5):")
print(ct[mask_c].head().to_string(index=False))
