#!/usr/bin/env python3
"""
Analysis: Locate the amber maximum, convert to CE millennium, and define the peak interval.
Dataset: time_series_data.csv (primary), capital.csv (cross-check)
"""
import csv

# ─── Load time_series_data.csv ───
with open('data/time_series_data.csv', 'r') as f:
    reader = csv.reader(f)
    header = next(reader)
    rows = list(reader)

ce_idx = header.index('CE')
calbp_idx = header.index('calBP')
amber_idx = header.index('Amber')
amber_inter_idx = header.index('Amber_inter')

print("=" * 70)
print("AMBER PEAK ANALYSIS")
print("=" * 70)

# ─── Step 1: Find global max of Amber_inter ───
max_val = -float('inf')
max_indices = []
for i, row in enumerate(rows):
    val = float(row[amber_inter_idx])
    if val > max_val:
        max_val = val
        max_indices = [i]
    elif val == max_val:
        max_indices.append(i)

# Contiguous range
start_idx = max_indices[0]
end_idx = max_indices[-1]
ce_early = int(rows[start_idx][ce_idx])   # most negative CE = earliest in time (e.g., -3300)
ce_late = int(rows[end_idx][ce_idx])      # least negative CE = latest in time (e.g., -3000)

bce_early = -ce_early  # 3300 (earlier in time, larger BCE number)
bce_late = -ce_late    # 3000 (later in time, smaller BCE number)

print(f"\n1. GLOBAL MAXIMUM of Amber_inter: {max_val:.4f}")
print(f"   Contiguous CE range: {ce_early} to {ce_late} ({len(max_indices)} years)")
print(f"   Contiguous BCE interval: {bce_early} BCE to {bce_late} BCE")

# ─── Step 2: Convert to millennium ───
def bce_to_millennium(bce_year):
    """Nth millennium BCE covers years N*1000 to N*1000-999 BCE.
    1st: 1000-1, 2nd: 2000-1001, 3rd: 3000-2001, 4th: 4000-3001"""
    return (bce_year - 1) // 1000 + 1

mill_early = bce_to_millennium(bce_early)  # millennium of 3300 BCE
mill_late = bce_to_millennium(bce_late)    # millennium of 3000 BCE

# Count years in each millennium
# 4th millennium BCE: 4000-3001 BCE
# 3rd millennium BCE: 3000-2001 BCE
years_in_4th = 0  # years from 3300 to 3001 BCE
years_in_3rd = 0  # years from 3000 to 3000 BCE
for bce in range(bce_late, bce_early + 1):  # iterate from 3000 to 3300
    if bce >= 3001:
        years_in_4th += 1
    else:
        years_in_3rd += 1

print(f"\n2. MILLENNIUM ASSIGNMENT:")
print(f"   {bce_early} BCE → {mill_early}th millennium BCE (4000–3001 BCE)")
print(f"   {bce_late} BCE → {mill_late}th millennium BCE (3000–2001 BCE)")
print(f"   Years in {mill_early}th millennium BCE: {years_in_4th}")
print(f"   Years in {mill_late}th millennium BCE: {years_in_3rd}")
print(f"   → Peak is in the {mill_early}th millennium BCE")

# ─── Step 3: Cross-check with capital.csv ───
print(f"\n3. CROSS-CHECK with capital.csv (Zamber):")
with open('data/capital.csv', 'r') as f:
    reader = csv.reader(f)
    cap_header = next(reader)
    cap_rows = list(reader)

cap_zamber_idx = cap_header.index('Zamber')
cap_bce_idx = cap_header.index('BCE')

cap_max = -float('inf')
cap_max_bces = []
for row in cap_rows:
    bce = int(row[cap_bce_idx])
    z = float(row[cap_zamber_idx].replace(',', '.'))
    if z > cap_max:
        cap_max = z
        cap_max_bces = [bce]
    elif z == cap_max:
        cap_max_bces.append(bce)

print(f"   Max Zamber in capital.csv: {cap_max:.4f}")
print(f"   At BCE years: {cap_max_bces}")
print(f"   Matches time_series_data max? {abs(cap_max - max_val) < 1e-9}")

# Show raw data points in peak region
print(f"\n   Raw 100-year data points at maximum:")
for i in range(start_idx, end_idx + 1):
    ce = int(rows[i][ce_idx])
    raw = rows[i][amber_idx].strip()
    if raw:
        bce = -ce
        print(f"     {bce} BCE: Zamber = {raw}")

# ─── Step 4: Final summary ───
print(f"\n{'=' * 70}")
print("CONCLUSION")
print(f"{'=' * 70}")
print(f"""
Amber (Z-score) peaked in the 4th millennium BCE.

The maximum Z-score of 1.54 was sustained over the interval
3300–3000 BCE (301 years), corresponding to four consecutive
100-year data bins (3300, 3200, 3100, 3000 BCE) in the raw
dataset. The plateau lies entirely within the 4th millennium
BCE for 300 years (3300–3001 BCE) and touches the 3rd
millennium BCE by one year (3000 BCE) under strict millennium
boundary conventions.
""")
