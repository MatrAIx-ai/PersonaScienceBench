import pandas as pd
import numpy as np

# ── 1. Load data ──────────────────────────────────────────────────────
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv')

# ── 2. Summed social-capital index ────────────────────────────────────
cap['SummedSC'] = cap['ZCU_AU'] + cap['Zamber'] + cap['ZMonument']

# ── 3. Identify peak century (handle ties) ───────────────────────────
peak_val = cap['SummedSC'].max()
peak_rows = cap[cap['SummedSC'] == peak_val].sort_values('BCE', ascending=False)
peak_bce_list = peak_rows['BCE'].tolist()
peak_group = peak_rows['group'].iloc[0]

def bce_to_century(bce):
    """Convert BCE year (multiple of 100) to century label."""
    c = bce // 100  # e.g. 1400 -> 14
    return f"{c}th century BCE"

peak_centuries = [bce_to_century(b) for b in peak_bce_list]
print("=" * 65)
print(f"PEAK: SummedSC = {peak_val:.4f}")
for _, r in peak_rows.iterrows():
    print(f"  BCE {r['BCE']} ({r['group']}): CuAu={r['ZCU_AU']:+.2f}, "
          f"Amb={r['Zamber']:+.2f}, Mon={r['ZMonument']:+.4f}")
print(f"  Century label(s): {', '.join(peak_centuries)}")
print("=" * 65)

# ── 4. Component trends toward the peak ──────────────────────────────
peak_bce = peak_bce_list[0]  # earliest (largest BCE) peak century
baseline_bce = peak_bce + 400  # 4 centuries before

base_row = cap[cap['BCE'] == baseline_bce].iloc[0]
peak_row = cap[cap['BCE'] == peak_bce].iloc[0]

comps = {'Copper/Gold (ZCU_AU)': 'ZCU_AU',
         'Amber (Zamber)':        'Zamber',
         'Monument Count (ZMonument)': 'ZMonument'}

print(f"\nComponent trends  BCE {baseline_bce} → {peak_bce}  ({(baseline_bce - peak_bce)//100} centuries):")
print(f"{'Component':<30} {'Baseline':>10} {'Peak':>10} {'Δ':>10} {'slope/c':>10}")
n_steps = (baseline_bce - peak_bce) // 100
for label, col in comps.items():
    b, p = base_row[col], peak_row[col]
    delta = p - b
    slope = delta / n_steps
    print(f"{label:<30} {b:>+10.4f} {p:>+10.4f} {delta:>+10.4f} {slope:>+10.4f}")
total_d = peak_row['SummedSC'] - base_row['SummedSC']
print(f"{'SummedSC':<30} {base_row['SummedSC']:>+10.4f} {peak_row['SummedSC']:>+10.4f} {total_d:>+10.4f} {total_d/n_steps:>+10.4f}")

# Longer window (6 centuries) for robustness
baseline6 = peak_bce + 600
base6 = cap[cap['BCE'] == baseline6].iloc[0]
n6 = (baseline6 - peak_bce) // 100
print(f"\nRobustness check  BCE {baseline6} → {peak_bce}  ({n6} centuries):")
for label, col in comps.items():
    delta = peak_row[col] - base6[col]
    print(f"  {label:<30} Δ = {delta:>+8.4f}  slope = {delta/n6:>+8.4f}/c")

# ── 5. Cross-validation with time_series_data.csv ────────────────────
ts_raw = ts[ts['CopperGold'].notna()].copy()
ts_raw['BCE'] = -ts_raw['CE']
ts_raw['SummedSC'] = ts_raw['CopperGold'] + ts_raw['Amber'] + ts_raw['MonumentCount']
ts_peak_val = ts_raw['SummedSC'].max()
ts_peak_rows = ts_raw[ts_raw['SummedSC'] == ts_peak_val]
print(f"\nCross-validation (time_series_data.csv raw values):")
print(f"  Peak SummedSC = {ts_peak_val:.4f} at BCE {ts_peak_rows['BCE'].tolist()}")
match = np.isclose(peak_val, ts_peak_val)
print(f"  Matches capital.csv peak ({peak_val:.4f}): {match}")

# ── 6. Full century table (for the record) ───────────────────────────
print(f"\n{'BCE':>6} {'grp':>4} {'CuAu':>7} {'Amb':>7} {'Mon':>9} {'SumSC':>9}")
for _, r in cap.sort_values('BCE', ascending=False).iterrows():
    star = " *" if r['BCE'] in peak_bce_list else ""
    print(f"{r['BCE']:>6} {r['group']:>4} {r['ZCU_AU']:>+7.2f} {r['Zamber']:>+7.2f} "
          f"{r['ZMonument']:>+9.4f} {r['SummedSC']:>+9.4f}{star}")
