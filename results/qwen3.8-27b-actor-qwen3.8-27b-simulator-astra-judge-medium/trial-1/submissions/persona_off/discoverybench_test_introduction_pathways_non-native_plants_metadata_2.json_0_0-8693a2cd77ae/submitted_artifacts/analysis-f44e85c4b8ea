import pandas as pd, numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf
import warnings; warnings.filterwarnings('ignore')
np.random.seed(42)

niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t', quotechar='"')
sp = pd.read_csv('data/invasion_success_pathways.csv')

RNG = np.random.default_rng(42)
def boot_ci(vals, n=5000, ci=0.95):
    vals = np.asarray(vals, float); vals = vals[~np.isnan(vals)]
    if len(vals)==0: return np.nan
    bs = [RNG.choice(vals, size=len(vals), replace=True).mean() for _ in range(n)]
    lo,hi = np.percentile(bs, [100*(1-ci)/2, 100*(1+ci)/2])
    return vals.mean(), lo, hi

print("="*80)
print("1) PER-HABITAT TABLE")
print("="*80)
rows=[]
for hab, g in niche.groupby('habitat'):
    n_plots = len(g)
    mean_gard = g['n.gard'].mean()
    total_gard = g['n.gard'].sum()
    empty = (g['n.total']==0).sum()
    empty_share = empty/n_plots
    inv = g[g['n.total']>0]
    if len(inv)>0:
        share = (inv['n.gard']/inv['n.total']).values
        m,lo,hi = boot_ci(share)
    else:
        m=lo=hi=np.nan
    rows.append(dict(habitat=hab, n_plots=n_plots, mean_n_gard=mean_gard,
                     total_n_gard=int(total_gard), share_empty=empty_share,
                     share_n_gard=m, ci_lo=lo, ci_hi=hi, n_invaded=len(inv)))
tab = pd.DataFrame(rows).sort_values('share_n_gard', ascending=False)
cols=['habitat','n_plots','mean_n_gard','total_n_gard','share_empty','share_n_gard','ci_lo','ci_hi']
print(tab[cols].round(4).to_string(index=False))

print("\nOverall mean n.gard per plot: %.4f | overall share n.gard/n.total (invaded): %.4f" %
      (niche['n.gard'].mean(), (niche.loc[niche['n.total']>0,'n.gard'].sum()/niche.loc[niche['n.total']>0,'n.total'].sum())))

print("\n"+"="*80)
print("2) NEGATIVE-BINOMIAL GLM: n.gard ~ habitat + offset(log n.total), n.total>0")
print("="*80)
d = niche[niche['n.total']>0].copy()
d['logtotal'] = np.log(d['n.total'])
ref = 'Scrublands'  # most frequent habitat (defensible reference)
hab_dum = pd.get_dummies(d['habitat'], prefix='hab', drop_first=False, dtype=float)
hab_dum = hab_dum.drop(columns=['hab_%s'%ref])
X = sm.add_constant(hab_dum)
model = sm.GLM(d['n.gard'].values, X, family=sm.families.NegativeBinomial(),
              offset=d['logtotal'].values).fit()
print("reference level = %s (most frequent habitat, n=%d plots)"%(ref,(niche['habitat']==ref).sum()))
try: print("Dispersion (alpha):", round(model.bdisp,4))
except Exception: print("Dispersion (scale):", round(float(model.scale),4))
irr = np.exp(model.params.drop('const'))
irr.index.name='habitat'
print("\nIncidence-rate ratios (IRR) vs %s, 95%% CI:"%ref)
ci = model.conf_int().drop('const')
ci = np.exp(ci)
irr_tab = pd.DataFrame({'IRR':irr.values, 'ci_lo':ci[0].values, 'ci_hi':ci[1].values}, index=irr.index)
irr_tab = irr_tab.sort_values('IRR', ascending=False)
print(irr_tab.round(3).to_string())

print("\n"+"="*80)
print("3) ROBUSTNESS CHECKS")
print("="*80)
# Kruskal-Wallis on n.gard among invaded plots by habitat
kw = stats.kruskal(*[g['n.gard'] for _,g in d.groupby('habitat')])
print("Kruskal-Wallis on n.gard (invaded plots) by habitat: H=%.2f, p=%.3e"%(kw.statistic,kw.pvalue))
# chi-square: gardening presence (n.gard>0) vs not, among invaded plots
ct = pd.crosstab(d['habitat'], (d['n.gard']>0))
ct = ct.drop(columns=[c for c in ct.columns if ct[c].sum()==0])
ch2, p, dof, exp = stats.chi2_contingency(ct)
print("Chi-square (gardening presence vs habitat, invaded plots): chi2=%.2f, dof=%d, p=%.3e"%(ch2,dof,p))
# Mann-Whitney highest vs lowest share habitats (Urban vs Broad-leaved)
a=d[d.habitat=='Urban']['n.gard'].values; b=d[d.habitat=='Broad-leaved forests']['n.gard'].values
u,pu = stats.mannwhitneyu(a,b,alternative='two-sided')
print("Mann-Whitney Urban vs Broad-leaved n.gard: U=%.0f, p=%.3e"%(u,pu))

print("\n"+"="*80)
print("4) SECONDARY SPECIES-LEVEL CHECK (invasion_success_pathways.csv)")
print("="*80)
print("Note: 3 gardening rows flagged duplicated=TRUE kept (no fully-duplicated rows exist).")
print("intro.pathway counts:", sp['intro.pathway'].value_counts().to_dict())
print("habitat.range by pathway:")
print(sp.groupby('intro.pathway')['habitat.range'].agg(['count','mean','median','min','max']).round(3).to_string())
garden=sp[sp['intro.pathway']=='Gardening']; un=sp[sp['intro.pathway']=='Unintentional']
t,pv=stats.mannwhitneyu(garden['habitat.range'],un['habitat.range'],alternative='two-sided')
print("Mann-Whitney gardening vs unintentional habitat.range: U=%.0f, p=%.4f"%(t,pv))
print("gardening habitat.range dist:", garden['habitat.range'].value_counts().sort_index().to_dict())

tab.to_csv('per_habitat_table.csv', index=False)
irr_tab.to_csv('glm_irr.csv')
print("\nSaved per_habitat_table.csv and glm_irr.csv")
