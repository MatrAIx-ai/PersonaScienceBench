#!/usr/bin/env python3
"""
Analysis: In what context does the gardening pathway for introducing non-native
plants show different prevalence styles across habitat types?

Primary data: data/invaded_niche_pathways.csv (632 plots, Barcelona province).
Corroboration: data/temporal_trends_contingency_table.csv,
               data/invasion_success_pathways.csv.
"""
import csv, math, collections
import numpy as np
from scipy import stats
import statsmodels.api as sm

# ---------------- load ----------------
def load_tsv(path):
    with open(path, newline='') as f:
        return list(csv.DictReader(f, delimiter='\t'))

rows = load_tsv('data/invaded_niche_pathways.csv')
for r in rows:
    for k in r:
        if k != 'habitat':
            r[k] = float(r[k])

habitat = [r['habitat'] for r in rows]
n_gard  = np.array([r['n.gard'] for r in rows])
n_unint = np.array([r['n.unint'] for r in rows])
n_agfo  = np.array([r['n.agfo'] for r in rows])
n_tot   = np.array([r['n.total'] for r in rows])

# sanity
assert np.allclose(n_gard + n_unint + n_agfo, n_tot)

# ---------------- 1) per-habitat descriptive table ----------------
def wilson_ci(k, n, z=1.96):
    if n == 0: return (0.0, 0.0)
    p = k / n
    denom = 1 + z*z/n
    center = (p + z*z/(2*n)) / denom
    half = z * math.sqrt(p*(1-p)/n + z*z/(4*n*n)) / denom
    return (max(0.0, center-half), min(1.0, center+half))

habs = sorted(set(habitat))
print("="*100)
print("TABLE 1. Per-habitat prevalence of the Gardening pathway (plot-level data, n=632 plots)")
print("="*100)
hdr = (f"{'habitat':<22}{'plots':>6}{'plots_g>0':>10}{'plot_prev':>10}"
       f"{'S_gard':>8}{'S_total':>9}{'gard_share':>11}{'CI95':>18}"
       f"{'mean_g/plot':>12}{'mean_g/pos':>11}")
print(hdr)
tab = {}
for h in habs:
    m = np.array([x==h for x in habitat])
    k  = int(m.sum())
    gp = int((n_gard[m]>0).sum())
    sg = int(n_gard[m].sum()); st = int(n_tot[m].sum())
    share = sg/st if st else float('nan')
    lo,hi = wilson_ci(sg, st) if st else (float('nan'),float('nan'))
    mg = n_gard[m].mean()
    mpg = n_gard[m][n_gard[m]>0].mean() if gp else float('nan')
    tab[h] = dict(plots=k, plots_g=gp, plot_prev=gp/k, S_gard=sg, S_total=st,
                  share=share, ci=(lo,hi), mean_g=mg, mean_g_pos=mpg)
    print(f"{h:<22}{k:>6}{gp:>10}{gp/k:>10.3f}{sg:>8}{st:>9}{share:>11.3f}"
          f"{f'[{lo:.3f},{hi:.3f}]':>18}{mg:>12.3f}{mpg:>11.3f}")

# ---------------- 2) chi-square: gardening vs other pathways, by habitat ----------------
print()
print("="*100)
print("TABLE 2. Chi-square test: gardening vs non-gardening NN species occurrences by habitat")
print("        Sparse habitats (Rock outcrops, Broad-leaved forests, Coniferous forests;")
print("        S_total <= 8) pooled into 'Natural/forested'.")
print("="*100)
SPARSE = {'Rock outcrops','Broad-leaved forests','Coniferous forests'}
def group(h): return 'Natural/forested' if h in SPARSE else h
g = [group(h) for h in habitat]
groups = sorted(set(g))
table = np.array([[int((np.array(g)==gr).sum() & (n_gard>0).sum()) for gr in groups]])  # placeholder
# build 2 x k table: rows = gardening species occurrences vs other; cols = habitat groups
gard_occ  = n_gard.sum()
other_occ = (n_unint + n_agfo).sum()
tab2 = np.zeros((2, len(groups)), dtype=int)
for i, gr in enumerate(groups):
    m = np.array([x==gr for x in g])
    tab2[0, i] = int(n_gard[m].sum())
    tab2[1, i] = int((n_unint[m]+n_agfo[m]).sum())
print("habitat groups:", {gr: int((np.array(g)==gr).sum()) for gr in groups})
chi2, p, dof, exp = stats.chi2_contingency(tab2)
print("contingency (rows: gardening / other pathways):")
for i, gr in enumerate(groups):
    tot = tab2[:,i].sum()
    print(f"  {gr:<22} gard={tab2[0,i]:>4}  other={tab2[1,i]:>4}  share={tab2[0,i]/tot if tot else float('nan'):.3f}")
print(f"chi2={chi2:.2f}, dof={dof}, p={p:.2e}")
# permutation test (10k) for the gardening-vs-other contingency, robust to small cells
rng = np.random.default_rng(42)
def chi_stat(tab):
    c,_,_,_ = stats.chi2_contingency(tab, correction=False)
    return c
obs = chi_stat(tab2)
# proper null: fix both margins - shuffle the 117 gardening labels among 646
# column slots (column totals fixed)
col_ids = np.repeat(np.arange(tab2.shape[1]), tab2.sum(axis=0))
n_gard_tot = tab2[0].sum()
sim = np.empty(10000)
for i in range(10000):
    perm = rng.permutation(col_ids)
    out = np.zeros_like(tab2)
    for j in range(tab2.shape[1]):
        out[0,j] = (perm[:n_gard_tot]==j).sum()
        out[1,j] = tab2[:,j].sum() - out[0,j]
    sim[i] = chi_stat(out)
p_perm = (np.sum(sim >= obs)+1)/(len(sim)+1)
print(f"Permutation test (10k, row-assignment within columns): chi2_obs={obs:.2f}, p_perm={p_perm:.4f}")

# focused contrast: human-modified (Urban, Riparian, Wetlands, Coastal) vs
# agricultural/natural (Croplands, Meadows, Scrublands, Natural/forested)
HM = {'Urban','Riparian','Wetlands','Coastal'}
hm = np.array([group(h) in HM for h in habitat])
t2 = np.array([[int(n_gard[hm].sum()), int(n_gard[~hm].sum())],
               [int((n_unint[hm]+n_agfo[hm]).sum()), int((n_unint[~hm]+n_agfo[~hm]).sum())]])
oddsr, pf = stats.fisher_exact(t2)
print(f"\nFocused 2x2 (human-modified vs ag/natural): gardening share HM={t2[0,0]/t2[:,0].sum():.3f} vs AN={t2[0,1]/t2[:,1].sum():.3f}; Fisher OR={oddsr:.2f}, p={pf:.2e}")

print("expected counts min:", f"{exp.min():.2f}", "(all >=5:", bool((exp>=5).all()), ")")

# also full 3-pathway x habitat-group table for context
tab3 = np.array([[int(n_gard[m].sum()), int(n_unint[m].sum()), int(n_agfo[m].sum())]
                 for m in [np.array([x==gr for x in g]) for gr in groups]]).T
chi2b, pb, dofb, expb = stats.chi2_contingency(tab3)
print(f"\nFull 3-pathway x habitat-group chi2: chi2={chi2b:.2f}, dof={dofb}, p={pb:.2e}")

# ---------------- 3) landscape context comparison ----------------
print()
print("="*100)
print("TABLE 3. Landscape/climatic context by habitat (median [IQR]) - full plot sets")
print("="*100)
CAND = ['elevation','urban.2009.50m','urban.2009.1000m','cropland.2009.50m',
        'progressive.1956.2009.50m','distance.stream','distance.road',
        'annual.temperature','annual.rainfall']
print(f"{'habitat':<22}" + "".join(f"{c[:16]:>18}" for c in CAND))
for h in habs:
    m = np.array([x==h for x in habitat])
    vals = []
    for c in CAND:
        v = np.array([r[c] for r in rows])[m]
        med = np.median(v); q1,q3 = np.percentile(v,[25,75])
        vals.append(f"{med:.3f}[{q1:.3f},{q3:.3f}]")
    print(f"{h:<22}" + "".join(f"{v:>18}" for v in vals))

# ---------------- 4) logistic model: n.gard>0 ~ habitat + landscape ----------------
print()
print("="*100)
print("TABLE 4. Logistic regression: plot has >=1 gardening species")
print("        Model A: habitat only.  Model B: habitat + elevation + urban.2009.500m")
print("        + progressive.1956.2009.50m + distance.stream + distance.road")
print("="*100)
y = (n_gard > 0).astype(float)
# use the 8 pooled groups (sparse natural/forested pooled) to avoid a zero-event
# reference cell; ref = 'Natural/forested' (11 events / 202 plots)
ref = 'Natural/forested'
ghab = [group(h) for h in habitat]
dums = {h: np.array([x==h for x in ghab], dtype=float) for h in sorted(set(ghab)) if h != ref}
Xa = np.column_stack([np.ones(len(y))] + [dums[h] for h in sorted(dums)])
ma = sm.Logit(y, Xa).fit(disp=0)
print("Model A (habitat groups only), ref = Natural/forested; OR (95% CI), p:")
names = ['const'] + sorted(dums)
for nm, b, se, pv in zip(names, ma.params, ma.bse, ma.pvalues):
    lo, hi = b-1.96*se, b+1.96*se
    print(f"  {nm:<22} OR={math.exp(b):>7.3f} [{math.exp(lo):.3f},{math.exp(hi):.3f}]  p={pv:.2e}")
print(f"  pseudo-R2={ma.prsquared:.3f}, LLR p={ma.llr_pvalue:.2e}, events={int(y.sum())}/{len(y)}")

land = np.column_stack([
    np.array([r['elevation'] for r in rows])/100.0,
    np.array([r['urban.2009.500m'] for r in rows]),
    np.array([r['progressive.1956.2009.50m'] for r in rows]),
    np.array([r['distance.stream'] for r in rows])/100.0,
    np.array([r['distance.road'] for r in rows])/100.0,
])
Xb = np.column_stack([Xa, land])
mb = sm.Logit(y, Xb).fit(disp=0)
names_b = names + ['elevation/100','urban.2009.500m','progress.56-09.50m','dist.stream/100','dist.road/100']
print("\nModel B (habitat + landscape), ref = Natural/forested; OR (95% CI), p:")
for nm, b, se, pv in zip(names_b, mb.params, mb.bse, mb.pvalues):
    lo, hi = b-1.96*se, b+1.96*se
    print(f"  {nm:<22} OR={math.exp(b):>7.3f} [{math.exp(lo):.3f},{math.exp(hi):.3f}]  p={pv:.2e}")
print(f"  pseudo-R2={mb.prsquared:.3f}, LLR p={mb.llr_pvalue:.2e}")

# ---------------- 5) corroboration ----------------
print()
print("="*100)
print("CORROBORATION")
print("="*100)
tt = load_tsv('data/temporal_trends_contingency_table.csv')
tot_all = sum(int(r['n']) for r in tt)
for per in ['Before 1500','1501-1900','1901-1984','1985-2019']:
    d = {r['pathway']: int(r['n']) for r in tt if r['introduction.period']==per}
    s = sum(d.values())
    print(f"{per:<13} total={s:>4}  Gard={d['Gardening']:>4} ({d['Gardening']/s:.1%})  "
          f"Unint={d['Unintentional']:>3} ({d['Unintentional']/s:.1%})  Agfo={d['AgriForest']:>3} ({d['AgriForest']/s:.1%})")
print(f"Overall: {tot_all} introductions; Gardening = {sum(int(r['n']) for r in tt if r['pathway']=='Gardening')/tot_all:.1%}")

with open('data/invasion_success_pathways.csv', newline='') as f:
    sp = list(csv.DictReader(f))
pc = collections.Counter(r['intro.pathway'] for r in sp)
print(f"Species-level (n={len(sp)} rows, 77 unique species): " +
      ", ".join(f"{k} {v}" for k,v in pc.most_common()))
hr_gard = [int(r['habitat.range']) for r in sp if r['intro.pathway']=='Gardening']
hr_other = [int(r['habitat.range']) for r in sp if r['intro.pathway']!='Gardening']
t,u = stats.ttest_ind(hr_gard, hr_other)
print(f"habitat.range: Gardening mean={np.mean(hr_gard):.2f} vs other {np.mean(hr_other):.2f} (t-test p={u:.3f})")

# save tables
with open('results_table1_habitat.csv','w',newline='') as f:
    w = csv.writer(f)
    w.writerow(['habitat','plots','plots_gard>0','plot_prevalence','sum_gard','sum_total','gard_share','ci_lo','ci_hi','mean_gard_per_plot','mean_gard_per_pos_plot'])
    for h in habs:
        d = tab[h]
        w.writerow([h,d['plots'],d['plots_g'],f"{d['plot_prev']:.3f}",d['S_gard'],d['S_total'],
                    f"{d['share']:.3f}",f"{d['ci'][0]:.3f}",f"{d['ci'][1]:.3f}",
                    f"{d['mean_g']:.3f}",f"{d['mean_g_pos']:.3f}"])
print("\nSaved results_table1_habitat.csv")
