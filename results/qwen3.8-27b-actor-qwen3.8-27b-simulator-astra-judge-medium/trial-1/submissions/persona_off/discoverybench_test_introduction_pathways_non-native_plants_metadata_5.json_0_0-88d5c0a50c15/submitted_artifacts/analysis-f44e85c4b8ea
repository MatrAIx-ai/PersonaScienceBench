import pandas as pd, numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv('data/invasion_success_pathways.csv')
paths = ['n.gard','n.unint','n.agfo']
urb = [f"urban.{y}.{b}m" for y in (1956,1993,2009) for b in (50,500,1000)]
crop = [f"cropland.{y}.{b}m" for y in (1956,1993,2009) for b in (50,500,1000)]

print("="*80)
print("PART 1: DESCRIPTIVE")
print("="*80)
# 1a correlations
print("\n1a) Pearson r of urban vars vs log1p(pathway counts):")
rows = []
for u in urb:
    row = {'urban': u}
    for p in paths: row[p] = df[u].corr(np.log1p(df[p]))
    rows.append(row)
print(pd.DataFrame(rows).set_index('urban').round(3).to_string())

print("\n1b) Spearman rho of urban vars vs pathway counts:")
rows = []
for u in urb:
    row = {'urban': u}
    for p in paths: row[p] = stats.spearmanr(df[u], df[p]).statistic
    rows.append(row)
print(pd.DataFrame(rows).set_index('urban').round(3).to_string())

print("\n1c) Mean urban % by pathway presence (2009):")
for p in paths:
    g = df.groupby(df[p]>0)['urban.2009.500m'].agg(['mean','count'])
    print(p, "present: %.3f (n=%d)  absent: %.3f (n=%d)" % (g.loc[True,'mean'], g.loc[True,'count'], g.loc[False,'mean'], g.loc[False,'count']))

print("\n1d) Habitat-stratified: mean urban.2009.500m and pathway counts per habitat:")
g = df.groupby('habitat').agg(n=('habitat','size'),
    urban2009_500=('urban.2009.500m','mean'), **{p:(p,'mean') for p in paths})
print(g.round(3).to_string())

print("\n1e) Urban-habitat vs rest (2009, 500m):")
mask = df.habitat=='Urban'
for p in paths:
    t = stats.mannwhitneyu(df.loc[mask,p], df.loc[~mask,p])
    print(p, "Urban-hab mean %.2f vs other %.2f, MW p=%.3g" % (df.loc[mask,p].mean(), df.loc[~mask,p].mean(), t.pvalue))


hab = pd.get_dummies(df['habitat'], prefix='hab', drop_first=True, dtype=float)
log_road = np.log1p(df['distance.road']); log_stream = np.log1p(df['distance.stream'])
ctrl = np.column_stack([hab, df['elevation'], log_road, log_stream])
ctrl_cols = list(hab.columns) + ['elevation','log_road','log_stream']

print("="*80)
print("PART 2: NEGATIVE-BINOMIAL GLMs per pathway (urban + cropland same buffer/year + controls)")
print("="*80)
for p in paths:
    print(f"\n--- outcome {p} ---")
    rows = []
    for b in (50,500,1000):
        for y in (1956,1993,2009):
            u, c = f"urban.{y}.{b}m", f"cropland.{y}.{b}m"
            exog = pd.DataFrame({'const':1,'urban':df[u],'cropland':df[c], **{c2:ctrl[:,i] for i,c2 in enumerate(ctrl_cols)}})
            r = sm.GLM(df[p], exog, family=sm.families.NegativeBinomial()).fit()
            rows.append([b, y, r.params['urban'], r.bse['urban'], r.pvalues['urban'], np.exp(r.params['urban'])])
    tab = pd.DataFrame(rows, columns=['buffer','year','coef_urban','se','pval','exp_coef'])
    print(tab.round(4).to_string(index=False))

print("\n" + "="*80)
print("PART 3: LANDSCAPE-CHANGE SENSITIVITY (50m buffers)")
print("="*80)
for p in paths:
    print(f"\n--- outcome {p} ---")
    for per in ('1956.2009','1993.2009'):
        for ch in ('progressive','regressive'):
            col = f"{ch}.{per}.50m"
            r = stats.spearmanr(df[col], np.log1p(df[p]))
            exog = pd.DataFrame({'const':1,'chg':df[col],'urban2009':df['urban.2009.50m'], **{c2:hab[c2] for c2 in hab.columns}})
            m = sm.GLM(df[p], exog, family=sm.families.NegativeBinomial()).fit()
            print(f"{col}: spearman r={r.statistic:.3f}; NB coef={m.params['chg']:.3f} (p={m.pvalues['chg']:.3f})")
    col = 'progressive.1956.2009.50m'
    d = df.copy(); d['prog_bin'] = (d[col]>0).astype(int)
    g = d.groupby('prog_bin')[p].mean()
    print(f"mean {p}: prog>0 = {g[1]:.3f} (n={(d.prog_bin==1).sum()}) vs prog=0 = {g[0]:.3f} (n={(d.prog_bin==0).sum()})")

print("\n" + "="*80)
print("PART 4: SPECIES-LEVEL CROSS-REFERENCE")
print("="*80)
print("\nMean / median invaded plots by pathway x growth form:")
print(sp.groupby(['intro.pathway','growth.form'])['number.of.invaded.plots'].agg(['count','mean','median']).round(2).to_string())
print("\nGrowth-form composition per pathway:")
for pw in sp['intro.pathway'].unique():
    print(" ", pw, sp.loc[sp['intro.pathway']==pw,'growth.form'].value_counts(normalize=True).round(3).to_dict())
print("\nTop 10 most successful species:")
print(sp.nlargest(10,'number.of.invaded.plots')[['Scientific_name','intro.pathway','growth.form','number.of.invaded.plots']].to_string(index=False))
print("\nDuplicated rows:", sp.loc[sp['duplicated']==True,'Scientific_name'].tolist())

print("\n" + "="*80)
print("PART 5: ADJUSTED MODELS WITHOUT HABITAT DUMMIES (urban + cropland + elevation + distances)")
print("="*80)
for p in paths:
    print(f"\n--- outcome {p} ---")
    rows = []
    for b in (50,500,1000):
        for y in (1956,1993,2009):
            u, c = f"urban.{y}.{b}m", f"cropland.{y}.{b}m"
            exog = pd.DataFrame({'const':1,'urban':df[u],'crop':df[c],'elev':df['elevation'],
                                 'lr':np.log1p(df['distance.road']),'ls':np.log1p(df['distance.stream'])})
            r = sm.GLM(df[p], exog, family=sm.families.NegativeBinomial()).fit()
            rows.append([b, y, r.params['urban'], r.bse['urban'], r.pvalues['urban'], np.exp(r.params['urban'])])
    tab = pd.DataFrame(rows, columns=['buffer','year','coef_urban','se','pval','rate_ratio_per_unit_urban'])
    print(tab.round(4).to_string(index=False))

print("\nEffect size illustration (n.unint, urban.2009.500m, model A):")
q = df['urban.2009.500m'].quantile([0.5,0.75,0.9]).to_dict()
print("urban.2009.500m quantiles: med=%.3f q75=%.3f q90=%.3f" % (q[0.5],q[0.75],q[0.9]))
print("expected count ratio q75 vs median: %.2f ; q90 vs median: %.2f" % (
    np.exp(1.676*(q[0.75]-q[0.5])), np.exp(1.676*(q[0.9]-q[0.5]))))
print("mean n.unint by quartile of urban.2009.500m:")
df['uq'] = pd.qcut(df['urban.2009.500m'], 4, labels=False, duplicates='drop')
print(df.groupby('uq')['n.unint'].agg(['mean','count']).round(3).to_string())
