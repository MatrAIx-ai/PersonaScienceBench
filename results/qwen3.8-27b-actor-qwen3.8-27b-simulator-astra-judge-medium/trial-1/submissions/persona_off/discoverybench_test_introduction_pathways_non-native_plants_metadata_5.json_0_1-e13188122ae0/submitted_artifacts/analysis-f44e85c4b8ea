"""
DiscoveryBench: What types of plant introductions were influenced by urban land use?
Plot-level analysis of invaded_niche_pathways.csv (632 plots x 37 covariates).
Response = pathway-specific species counts (n.gard/n.unint/n.agfo).
Predictor = urban land cover (3 years 1956/1993/2009 x 3 buffers 50/500/1000 m).
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
from statsmodels.formula.api import glm
from statsmodels.genmod.families import Poisson
from scipy.spatial.distance import cdist

safe=lambda c: c.replace('.','_')
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df.columns=[safe(c) for c in df.columns]
print("Loaded", df.shape)

YEARS=[1956,1993,2009]; BUFFERS=[50,500,1000]
pathways={'Gardening':'n_gard','Unintentional':'n_unint','AgriForest':'n_agfo'}

# ---------- A) Dominant-pathway descriptive ----------
occ = df[df['n_total']>0].copy()
print("\n=== A) PLOTS WITH >=1 NNS:", len(occ), "of", len(df))
def dominant(row):
    vals={'Gardening':row['n_gard'],'Unintentional':row['n_unint'],'AgriForest':row['n_agfo']}
    mx=max(vals.values())
    return [k for k,v in vals.items() if v==mx]
dom=[(ix,t) for ix,row in occ.iterrows() for t in dominant(row)]
dom=pd.DataFrame(dom,columns=['idx','pathway'])
print("plots where pathway is (co-)dominant (ties counted once each):")
print(dom['pathway'].value_counts().to_dict())
desc=[]
for p in pathways:
    sub=occ.loc[dom[dom['pathway']==p]['idx']]
    desc.append({'pathway':p,'n_plots':len(sub),
                 'urban_2009_500m':round(sub['urban_2009_500m'].mean(),3),
                 'urban_2009_1000m':round(sub['urban_2009_1000m'].mean(),3),
                 'urban_2009_50m':round(sub['urban_2009_50m'].mean(),3)})
descdf=pd.DataFrame(desc)
print("\nMean urban cover among (co-)dominant-pathway plots:")
print(descdf.to_string(index=False))

# ---------- B) Primary Poisson GLMs (full model, 2009 500m) ----------
PRIMARY='urban_2009_500m'
cov='habitat + elevation + cropland_2009_500m + distance_road + distance_stream + annual_temperature + annual_rainfall'
print("\n=== B) PRIMARY Poisson GLMs, count ~ ",PRIMARY," + covariates (all 632 plots) ===")
resB=[]
for p,col in pathways.items():
    m=glm(f"{col} ~ {PRIMARY} + {cov}", data=df, family=Poisson()).fit()
    b=m.params[PRIMARY]; lo,hi=m.conf_int().loc[PRIMARY]
    sd=df[PRIMARY].std(); logchg=b*sd; pct=(np.exp(logchg)-1)*100
    resB.append({'pathway':p,'raw_coef':round(b,4),'ci_lo':round(lo,4),'ci_hi':round(hi,4),
                 'p':round(m.pvalues[PRIMARY],4),'logchg_perSD_urban':round(logchg,4),
                 'pct_chg_perSD_urban':round(pct,1),'n_obs':int(df[col].sum())})
resBdf=pd.DataFrame(resB)
print(resBdf.to_string(index=False))

# ---------- C) Sensitivity grid: per-pathway univariate Poisson ----------
print("\n=== C) SENSITIVITY GRID: log-count change per 1-SD urban (univariate Poisson) ===")
grid=[]
for y in YEARS:
    for b in BUFFERS:
        c=f"urban_{y}_{b}m"
        for p,col in pathways.items():
            xz=(df[c]-df[c].mean())/df[c].std()
            mz=glm(f"{col} ~ xz", data=pd.DataFrame({col:df[col],'xz':xz}), family=Poisson()).fit()
            grid.append({'year':y,'buffer':b,'pathway':p,
                         'logchg_perSD_urban':round(mz.params['xz'],4),
                         'p':round(mz.pvalues['xz'],4),'sig':'*' if mz.pvalues['xz']<0.05 else ''})
gridf=pd.DataFrame(grid)
pivot=gridf.pivot_table(index=['year','buffer'],columns='pathway',values='logchg_perSD_urban').round(3)
print(pivot.to_string())
gridf['is_max']=gridf.groupby(['year','buffer'])['logchg_perSD_urban'].transform(max)==gridf['logchg_perSD_urban']
print("\n# of 9 year/buffer cells where each pathway has the strongest urban beta:")
print(gridf[gridf['is_max']].groupby('pathway').size().to_dict())
print("\nSign consistency (positive cells / 9) and mean per pathway:")
for p in pathways:
    s=gridf[gridf['pathway']==p]['logchg_perSD_urban']
    print(f"  {p}: {int((s>0).sum())}/9 positive, mean={s.mean():.3f}")

# ---------- D) Spatial autocorrelation (permutation Moran's I) ----------
def moran_I(x,W):
    x=np.asarray(x); xz=x-x.mean(); return len(x)*(xz@(W@xz))/(xz@xz)
def moran_test(x,coords,k=10,nperm=999,seed=1):
    x=np.asarray(x); n=len(x)
    d=cdist(coords,coords); idx=np.argsort(d,axis=1)[:,1:k+1]
    W=np.zeros((n,n)); W[np.arange(n)[:,None],idx]=1.0; W=W/W.sum(axis=1,keepdims=True)
    I0=moran_I(x,W); rng=np.random.default_rng(seed)
    perm=[moran_I(rng.permutation(x),W) for _ in range(nperm)]
    p=(np.sum(np.abs(np.array(perm))>=np.abs(I0))+1)/(nperm+1)
    return I0,p
print("\n=== D) Permutation Moran's I on primary-model (2009.500m) Pearson residuals ===")
coords=df[['longitude','latitude']].values
for path,col in pathways.items():
    m=glm(f"{col} ~ {PRIMARY} + {cov}", data=df, family=Poisson()).fit()
    I0,pv=moran_test(m.resid_pearson,coords)
    print(f"  {path}: Moran's I={I0:.3f}, perm p={pv:.3f} ({'spatial autocorrelation present' if pv<0.05 else 'n.s.'})")

# save tables
descdf.to_csv('output_dominant_pathway.csv',index=False)
resBdf.to_csv('output_primary_Poisson.csv',index=False)
gridf.to_csv('output_sensitivity_grid.csv',index=False)
print("\nDONE. Saved output_dominant_pathway.csv, output_primary_Poisson.csv, output_sensitivity_grid.csv")
