#!/usr/bin/env python3
"""Analysis: How did urban land use affect the invasion of different types of
introduced plants? (Barcelona province non-native plant plots)
Design (approved): 632 plots x 3 pathways (long form, 1896 rows); response =
current per-plot count per pathway; temporal dimension via predictors
(urban.2009.50m primary, Durban 1956-2009, progressive.1956.2009.50m,
cropland.2009.50m); within-plot correlation via cluster-robust covariance
grouped by plot (GLMM (1|plot) analogue); key term pathway x urban.2009.50m;
sensitivity at 500m/1000m; zero-inflation diagnostics; species-level
permutation tests; phylogenetic PVP signal; contingency-table context."""
import warnings
warnings.filterwarnings('ignore')
import numpy as np
import pandas as pd
from scipy import stats
from scipy.spatial import cKDTree
import glm_fit

RNG = np.random.default_rng(42)
nPERM = 999
plots = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp    = pd.read_csv('data/invasion_success_pathways.csv')
ct    = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
tree  = open('data/phylogenetic_tree.txt').read().strip()
plots['plot_id'] = np.arange(1, len(plots)+1)
long = pd.concat([
    plots.assign(pathway='Gardening',    count=plots['n.gard']),
    plots.assign(pathway='Unintentional',count=plots['n.unint']),
    plots.assign(pathway='AgriForest',   count=plots['n.agfo']),
])
long['pathway'] = pd.Categorical(long['pathway'], ['Gardening','Unintentional','AgriForest'])
out = []
def P(s=''):
    out.append(s); print(s)

def fit_main(scale='50m', family='poisson'):
    d = long.copy()
    d['urban']  = d[f'urban.2009.{scale}']
    d['durban'] = d[f'urban.2009.{scale}'] - d[f'urban.1956.{scale}']
    # NOTE: annual.temperature / annual.rainfall dropped (r = -0.96 / 0.86 with
    # elevation; VIF > 100) - elevation kept as the single climate-gradient proxy.
    covs = ['urban','durban','cropland.2009.'+scale,'elevation','distance.road',
            'distance.stream']
    if scale == '50m':
        d['progressive'] = d['progressive.1956.2009.50m']; covs.append('progressive')
        # first-order spatial controls (residual Moran's I = 2.96, p=0.01 without them)
        covs += ['longitude','latitude']
    Xdf = pd.get_dummies(d[['pathway','habitat']],
        columns=['pathway','habitat'], drop_first=True, dtype=float)
    Xdf.insert(0, 'const', 1.0)
    Xdf = pd.concat([Xdf, d[covs]], axis=1)
    # pathway x urban interaction terms (KEY TERM)
    Xdf['pathway_Unintentional:urban'] = Xdf['pathway_Unintentional']*d['urban'].values
    Xdf['pathway_AgriForest:urban']    = Xdf['pathway_AgriForest']*d['urban'].values
    y = d['count'].values; g = d['plot_id'].values
    if family == 'poisson':
        m = glm_fit.poisson_glm(y, Xdf.values, list(Xdf.columns), g)
    else:
        m = glm_fit.nb_glm(y, Xdf.values, list(Xdf.columns), g)
    return m, d

def show_interaction(m, title):
    P(f"\n-- {title}")
    rows = [r for r in m.params.index if ':urban' in r or r=='urban']
    P(f"{'term':<30}{'coef':>10}{'SE':>10}{'z':>8}{'p':>10}   {'95% CI':>24}")
    for r in rows:
        b=m.params[r]; se=m.bse[r]; z=m.tvalues[r]; p=m.pvalues[r]; ci=m.conf_int().loc[r]
        P(f"{r:<30}{b:>10.4f}{se:>10.4f}{z:>8.2f}{p:>10.4f}   [{ci[0]:>9.4f}, {ci[1]:>9.4f}]")
    P("Marginal effect per +10 pp urban (coef*0.1):")
    for r in rows:
        b=m.params[r]; ci=m.conf_int().loc[r]
        P(f"  {r:<30}{b*0.1:>10.4f}   [{ci[0]*0.1:>9.4f}, {ci[1]*0.1:>9.4f}]")

P("="*100)
P("PART A - PLOT-LEVEL: pathway x urban GLM, cluster-robust by plot")
P("="*100)
P(f"plots={len(plots)}, long rows={len(long)}, occurrences={long['count'].sum()}, "
  f"zeros={int((long['count']==0).sum())} ({(long['count']==0).mean():.3f})")

m50,_ = fit_main('50m','poisson')
P(f"\nPOISSON 50m: n={m50.nobs}, dev={m50.deviance:.1f}, dof={m50.df_model}, "
  f"dispersion(dev/dof)={m50.deviance/m50.df_model:.2f}")
show_interaction(m50, "PRIMARY 50m: pathway x urban.2009.50m (ref pathway=Gardening, ref habitat=Coastal)")
tab = pd.DataFrame({'coef':m50.params,'se':m50.bse,'z':m50.tvalues,'p':m50.pvalues})
tab['ci_lo'],tab['ci_hi'] = m50.conf_int().T.values
P("\nFull coefficient table (50m Poisson, cluster-robust):")
P(tab.round(4).to_string())

# cluster (plot-level) bootstrap CI for the key terms (robustness check)
P("\n-- CLUSTER BOOTSTRAP (B=199, resampling plots) for key terms, 50m")
def fit_counts(data, scale='50m'):
    d = data.copy()
    d['urban']  = d[f'urban.2009.{scale}']
    d['durban'] = d[f'urban.2009.{scale}'] - d[f'urban.1956.{scale}']
    covs = ['urban','durban','cropland.2009.'+scale,'elevation','distance.road',
            'distance.stream']
    if scale == '50m':
        d['progressive'] = d['progressive.1956.2009.50m']; covs.append('progressive')
        covs += ['longitude','latitude']
    Xdf = pd.get_dummies(d[['pathway','habitat']],
        columns=['pathway','habitat'], drop_first=True, dtype=float)
    Xdf.insert(0, 'const', 1.0)
    Xdf = pd.concat([Xdf, d[covs]], axis=1)
    Xdf['pathway_Unintentional:urban'] = Xdf['pathway_Unintentional']*d['urban'].values
    Xdf['pathway_AgriForest:urban']    = Xdf['pathway_AgriForest']*d['urban'].values
    m = glm_fit.poisson_glm(d['count'].values, Xdf.values, list(Xdf.columns),
                            d['plot_id'].values)
    return m
boot = {r: [] for r in ['urban','pathway_Unintentional:urban','pathway_AgriForest:urban']}
for b in range(199):
    sel = RNG.choice(len(plots), size=len(plots), replace=True)
    try:
        mb_ = fit_counts(long.iloc[np.repeat(sel,3)*3 + np.tile([0,1,2],len(sel))].reset_index(drop=True))
        for r in boot: boot[r].append(mb_.params[r])
    except Exception:
        pass
for r in boot:
    v = np.array(boot[r])
    P(f"  {r:<30} boot 95% CI [{np.percentile(v,2.5):>9.4f}, {np.percentile(v,97.5):>9.4f}]  "
      f"(point est {m50.params[r]:.4f}; frac fit {len(v)/199:.2f})")

# --- zero-inflation diagnostics ---
P("\n-- ZERO-INFLATION DIAGNOSTICS (50m)")
mu = np.exp(m50.predict())
P(f"observed zero fraction: {(long['count']==0).mean():.3f}")
P(f"fitted zero fraction (Poisson): {(1-np.exp(-mu)).mean():.3f}  "
  f"(obs/fitted ratio = {(long['count']==0).mean()/(1-np.exp(-mu)).mean():.2f})")
P(f"observed/expected count ratio: {long['count'].mean()/mu.mean():.2f}")
long['present'] = (long['count']>0).astype(int)
long['durban'] = long['urban.2009.50m'] - long['urban.1956.50m']
long['progressive'] = long['progressive.1956.2009.50m']
covs50 = ['urban.2009.50m','durban','cropland.2009.50m','progressive','elevation',
          'distance.road','distance.stream']
Xb = pd.get_dummies(long[['pathway','habitat']], columns=['pathway','habitat'],
    drop_first=True, dtype=float)
Xb.insert(0, 'const', 1.0)
Xb = pd.concat([Xb, long[covs50]], axis=1)
Xb['pathway_Unintentional:urban.2009.50m'] = Xb['pathway_Unintentional']*long['urban.2009.50m'].values
Xb['pathway_AgriForest:urban.2009.50m']    = Xb['pathway_AgriForest']*long['urban.2009.50m'].values
mb = glm_fit.binomial_glm(long['present'].values, Xb.values, list(Xb.columns),
                          long['plot_id'].values)
pos = long[long['count']>0].copy()
Xp = pd.get_dummies(pos[['pathway','habitat']], columns=['pathway','habitat'],
    drop_first=True, dtype=float)
Xp.insert(0, 'const', 1.0)
Xp = pd.concat([Xp, pos[covs50]], axis=1)
Xp['pathway_Unintentional:urban.2009.50m'] = Xp['pathway_Unintentional']*pos['urban.2009.50m'].values
Xp['pathway_AgriForest:urban.2009.50m']    = Xp['pathway_AgriForest']*pos['urban.2009.50m'].values
mp = glm_fit.poisson_glm(pos['count'].values, Xp.values, list(Xp.columns),
                         pos['plot_id'].values)
key = ['urban.2009.50m','pathway_Unintentional:urban.2009.50m','pathway_AgriForest:urban.2009.50m']
P("\nTwo-part model, pathway x urban.2009.50m terms (cluster-robust):")
P("  [presence/absence, binomial]")
for r in key:
    ci = mb.conf_int().loc[r]
    P(f"    {r:<40}{mb.params[r]:>9.4f}  [{ci[0]:>9.4f}, {ci[1]:>9.4f}]  p={mb.pvalues[r]:.4f}")
P("  [richness among invaded plots, Poisson]")
for r in key:
    ci = mp.conf_int().loc[r]
    P(f"    {r:<40}{mp.params[r]:>9.4f}  [{ci[0]:>9.4f}, {ci[1]:>9.4f}]  p={mp.pvalues[r]:.4f}")

# --- cluster bootstrap for the two-part presence model (robust inference) ---
P("\n-- CLUSTER BOOTSTRAP (B=199) for two-part PRESENCE model (log-odds), 50m")
bootp = {r: [] for r in ['urban.2009.50m','pathway_Unintentional:urban.2009.50m','pathway_AgriForest:urban.2009.50m']}
for b in range(199):
    sel = RNG.choice(len(plots), size=len(plots), replace=True)
    sub = long.iloc[np.repeat(sel,3)*3 + np.tile([0,1,2],len(sel))].copy()
    Xs = pd.get_dummies(sub[['pathway','habitat']], columns=['pathway','habitat'],
                        drop_first=True, dtype=float)
    Xs.insert(0, 'const', 1.0)
    Xs = pd.concat([Xs, sub[covs50]], axis=1)
    Xs['pathway_Unintentional:urban.2009.50m'] = Xs['pathway_Unintentional']*sub['urban.2009.50m'].values
    Xs['pathway_AgriForest:urban.2009.50m'] = Xs['pathway_AgriForest']*sub['urban.2009.50m'].values
    try:
        mbp = glm_fit.binomial_glm((sub['count']>0).astype(float).values, Xs.values,
                                   list(Xs.columns), sub['plot_id'].values)
        for r in bootp: bootp[r].append(mbp.params[r])
    except Exception:
        pass
for r in bootp:
    v = np.array(bootp[r])
    P(f"  {r:<40} point {mb.params[r]:>8.4f}  boot 95% CI [{np.percentile(v,2.5):>8.4f}, {np.percentile(v,97.5):>8.4f}]")
P("  NOTE: residuals of the count model are strongly spatially autocorrelated (Moran's I below);")
P("  cluster-robust sandwich SEs are therefore optimistic - the cluster bootstrap CIs are the")
P("  conservative reference. The presence-model interactions remain significant under bootstrap.")

# --- sensitivity 500m / 1000m ---
for s in ['500m','1000m']:
    try:
        m,_ = fit_main(s,'poisson')
        P(f"\nSENSITIVITY {s}: n={m.nobs}, dev/dof={m.deviance/m.df_model:.2f}")
        show_interaction(m, f"{s}: pathway x urban.2009.{s}")
    except Exception as e:
        P(f"\nSENSITIVITY {s} failed: {e}")

# --- spatial autocorrelation on 50m Poisson deviance residuals ---
P("\n-- SPATIAL AUTOCORRELATION (Moran's I on 50m deviance residuals, k=10 neighbours)")
res = long[['longitude','latitude','plot_id']].copy()
res['r'] = m50.deviance_residuals
res = res.groupby('plot_id', as_index=False).agg(lon=('longitude','first'),
                                                lat=('latitude','first'), r=('r','mean'))
xy = res[['lon','lat']].values.astype(float)
tr = cKDTree(xy); idx = tr.query(xy, k=11)[1][:,1:]
W = np.zeros((len(res),len(res)))
for i,j in enumerate(idx):
    for jj in j: W[i,jj]=1
Wn = W/W.sum(axis=1)[:,None]
z = np.asarray((res['r']-res['r'].mean())/res['r'].std(ddof=1))
I = len(res)*np.sum(Wn*z[:,None]*z)/W.sum()
cnt = 0
for _ in range(199):
    zp = RNG.permutation(z)
    if len(res)*np.sum(Wn*zp[:,None]*zp)/W.sum() >= I: cnt += 1
P(f"Moran's I = {I:.3f} (permutation p = {(cnt+1)/200:.3f})")

# --- descriptive tables ---
P("\n-- DESCRIPTIVE: mean count per plot by pathway x urban.2009.50m bin")
long['urb.bin'] = pd.cut(long['urban.2009.50m'], [-0.001,0,0.25,1.001], labels=['zero','0-25%','>25%'])
P(long.pivot_table(index='urb.bin', columns='pathway', values='count', aggfunc='mean').round(3).to_string())
long['durban'] = long['urban.2009.50m'] - long['urban.1956.50m']
long['durb.sign'] = pd.cut(long['durban'], [-1,0,1], labels=['no urban change','urban increased >0'])
P("\nby urban change 1956->2009 (50m):")
P(long.pivot_table(index='durb.sign', columns='pathway', values='count', aggfunc='mean').round(3).to_string())

P("\n"+"="*100)
P("PART B - SPECIES-LEVEL: invasion success by type (permutation ANOVA)")
P("="*100)
spu = sp[sp['duplicated'].astype(str).str.upper()!='TRUE'].copy()
P(f"unique species (deduped) = {len(spu)}; species x pathway rows = {len(sp)}")
sp['logplots']  = np.log(sp['number.of.invaded.plots'])
spu['logplots'] = np.log(spu['number.of.invaded.plots'])

def perm_anova(df, group, resp):
    g = df[group].astype(str).values; y = df[resp].values
    uniq = np.unique(g); grand = y.mean()
    means = {u: y[g==u].mean() for u in uniq}
    ssb = sum((g==u).sum()*(means[u]-grand)**2 for u in uniq)
    ssw = sum(((y[g==u]-means[u])**2).sum() for u in uniq)
    F_obs = (ssb/(len(uniq)-1))/(ssw/(len(y)-len(uniq)))
    cnt = 0
    for _ in range(nPERM):
        yp = RNG.permutation(y)
        m2 = {u: yp[g==u].mean() for u in uniq}
        ssb2 = sum((g==u).sum()*(m2[u]-yp.mean())**2 for u in uniq)
        gm = np.array([yp[g==u].mean() for u in uniq])
        ssw2 = ((yp-gm[np.searchsorted(uniq,g)])**2).sum()
        if (ssb2/(len(uniq)-1))/(ssw2/(len(yp)-len(uniq))) >= F_obs: cnt += 1
    return F_obs, (cnt+1)/(nPERM+1), {u:(int((g==u).sum()), means[u]) for u in uniq}

for label, df, grp in [
    ("intro.pathway (81 species x pathway rows)", sp, 'intro.pathway'),
    ("growth.form (77 species)", spu, 'growth.form'),
    ("dispersal (77 species)", spu, 'dispersal'),
    ("vegetative (77 species)", spu, 'vegetative'),
]:
    P(f"\n-- {label}")
    for resp in ['logplots','invaded.niche.breadth','habitat.range','area.of.occupancy.10km']:
        F,p,info = perm_anova(df, grp, resp)
        P(f"  {resp:<24} F={F:7.2f} p={p:.4f} | "
          + "; ".join(f"{u}: n={n}, mean={m:.3f}" for u,(n,m) in info.items()))

P("\n-- PHYLOGENETIC SIGNAL (PVP-based, 81-tip tree; supplementary)")
def parse_newick(s):
    pos = 0
    def parse_node():
        nonlocal pos
        if s[pos]=='(':
            pos += 1
            children = [parse_node()]
            while s[pos]!=')':
                pos += 1; children.append(parse_node())
            pos += 1
        else:
            children = None
        name = ''
        while pos < len(s) and s[pos] not in '(),:;':
            name += s[pos]; pos += 1
        length = 0.0
        if pos < len(s) and s[pos]==':':
            pos += 1; start = pos
            while pos < len(s) and (s[pos].isdigit() or s[pos] in '.eE+-'):
                pos += 1
            length = float(s[start:pos]) if pos>start else 0.0
        return {'name':name,'len':length,'children':children}
    return parse_node()
root = parse_newick(tree)
tips = []
def collect(n):
    if n['children'] is None: tips.append(n['name'])
    else:
        for c in n['children']: collect(c)
collect(root)
tipset = set(tips)
def pvp(node, vals):
    if node['children'] is None: return 0.0, 1
    tot = 0.0
    ms = []
    for c in node['children']:
        v, nc = pvp(c, vals); tot += v
        def cm(x):
            if x['children'] is None: return vals[x['name']], 1
            s=0; nn=0
            def acc(y):
                nonlocal s,nn
                if y['children'] is None: s+=vals[y['name']]; nn+=1
                else:
                    for zz in y['children']: acc(zz)
            acc(x); return s/nn, nn
        ms.append(cm(c))
    contrib = 0.0
    for i in range(len(ms)):
        for j in range(i+1,len(ms)):
            contrib += (ms[i][0]-ms[j][0])**2*ms[i][1]*ms[j][1]/(ms[i][1]+ms[j][1])
    return tot + node['len']*contrib, 1
sp_t = sp.set_index('phylo.tip.label')
for resp in ['logplots','invaded.niche.breadth']:
    names = [t for t in sp_t.index if t in tipset]
    vals = {t: float(sp_t.loc[t, resp]) for t in names}
    pvp_obs,_ = pvp(root, vals)
    yall = np.array([vals[t] for t in names]); cnt = 0
    for _ in range(499):
        vp = dict(zip(names, RNG.permutation(yall)))
        if pvp(root, vp)[0] >= pvp_obs: cnt += 1
    P(f"  {resp:<24} PVP={pvp_obs:10.2f}  perm p = {(cnt+1)/500:.3f}  (p<0.05 => phylogenetic signal)")

P("\n"+"="*100)
P("PART C - CONTEXT: temporal trends contingency table")
P("="*100)
tab2 = ct.pivot(index='introduction.period', columns='pathway', values='n')
order_p = ['Before 1500','1501-1900','1901-1984','1985-2019']
tab2 = tab2.reindex(order_p)
P(tab2.to_string())
P("gardening share by period: "
  + str([(i, round(float(tab2.loc[i,'Gardening']/tab2.loc[i].sum()),3)) for i in order_p]))
chi2,pchi,dof,_ = stats.chi2_contingency(tab2.values)
P(f"chi2(period x pathway) = {chi2:.1f}, dof={dof}, p={pchi:.3e}")

