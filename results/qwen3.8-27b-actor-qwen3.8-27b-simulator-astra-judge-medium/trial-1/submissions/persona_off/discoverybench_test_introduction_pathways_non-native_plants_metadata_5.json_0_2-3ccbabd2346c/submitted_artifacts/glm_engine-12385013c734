#!/usr/bin/env python3
"""Minimal GLM machinery (statsmodules GLM is unavailable in this environment).
- Poisson/beta GLM via IRLS, log/logit link.
- Cluster-robust (sandwich/GEE) covariance grouped by plot, with small-sample
  correction  (n/(n-p)) * (G/(G-p)).
- Negative-binomial (NB2) MLE via L-BFGS-B (model-based SEs) for robustness.
"""
import numpy as np
import pandas as pd
from scipy.special import xlogy, gammaln
from scipy.optimize import minimize
from scipy.stats import norm

class Fit:
    def __init__(self, params, bse, deviance, df_model, nobs, mu, devres, names, alpha=None, converged=True):
        self.params = pd_series(params, names)
        self.bse = pd_series(bse, names)
        z = params/bse
        self.tvalues = pd_series(z, names)
        self.pvalues = pd_series(2*norm.sf(np.abs(z)), names)
        self.deviance = deviance; self.df_model = df_model; self.nobs = nobs
        self._mu = mu; self._devres = devres; self._names = names; self.alpha = alpha
        ci = np.column_stack([params-1.96*bse, params+1.96*bse])
        self._ci = pd.DataFrame(ci, index=names, columns=[0,1]); self.converged = converged
    def predict(self): return self._mu
    def conf_int(self): return self._ci
    @property
    def deviance_residuals(self): return self._devres

def pd_series(v, names):
    return pd.Series(v, index=names)

def _irls(y, X, fam, groups, maxiter=300, tol=1e-10):
    n, p = X.shape
    beta = np.zeros(p)
    for _ in range(maxiter):
        if fam == 'poisson':
            mu = np.exp(X @ beta); W = 1.0/mu; grad = X.T @ ((y-mu)/mu)
        else:
            mu = 1.0/(1.0+np.exp(-X @ beta)); W = 1.0/(mu*(1.0-mu)); grad = X.T @ (y-mu)
        H = X.T @ (W[:, None]*X)
        db = np.linalg.solve(H, grad)
        beta = beta + db
        if np.max(np.abs(db)) < tol: break
    if fam == 'poisson':
        di = 2*(xlogy(y, y) - xlogy(y, mu) - y + mu)
    else:
        di = 2*(xlogy(y, y) - xlogy(y, mu) + xlogy(1-y, 1-y) - xlogy(1-y, 1-mu))
    dev = float(np.sum(di))
    devres = np.sign(y-mu)*np.sqrt(np.maximum(di, 0))
    return beta, mu, dev, devres, H

def _cluster_cov(X, W, resid, H, groups):
    n, p = X.shape
    G = len(np.unique(groups))
    Xe = (W[:, None]*X)*resid[:, None]
    meat = np.zeros((p, p))
    for g in np.unique(groups):
        s = Xe[groups == g].sum(axis=0)
        meat += np.outer(s, s)
    corr = (n/(n-p))*(G/(G-p))
    Hi = np.linalg.inv(H)
    return corr * (Hi @ meat @ Hi)

def poisson_glm(y, X, names, groups):
    y = np.asarray(y, float); X = np.asarray(X, float)
    beta, mu, dev, devres, H = _irls(y, X, 'poisson', groups)
    cov = _cluster_cov(X, 1.0/mu, y-mu, H, groups)
    return Fit(beta, np.sqrt(np.diag(cov)), dev, X.shape[1]-1, len(y), mu, devres, names)

def binomial_glm(y, X, names, groups):
    y = np.asarray(y, float); X = np.asarray(X, float)
    beta, mu, dev, devres, H = _irls(y, X, 'binomial', groups)
    cov = _cluster_cov(X, 1.0/(mu*(1-mu)), y-mu, H, groups)
    return Fit(beta, np.sqrt(np.diag(cov)), dev, X.shape[1]-1, len(y), mu, devres, names)

def nb_glm(y, X, names, groups, init_beta=None):
    """NB2 MLE, model-based SEs (robustness check only)."""
    y = np.asarray(y, float); X = np.asarray(X, float)
    n, p = X.shape
    if init_beta is None:
        init_beta, _, _, _, _ = _irls(y, X, 'poisson', groups)
    def nll(th):
        b = th[:p]; a = np.exp(th[p])
        mu = np.exp(X @ b)
        ll = (gammaln(y+a) - gammaln(y+1) - gammaln(a)
              + a*np.log(a/(a+mu)) + y*np.log(mu/(a+mu))).sum()
        return -ll
    from scipy.special import digamma
    def nllg(th, g=True):
        b = th[:p]; a = np.exp(th[p])
        mu2 = np.exp(X @ b)
        ll = (gammaln(y+a) - gammaln(y+1) - gammaln(a)
              + a*np.log(a/(a+mu2)) + y*np.log(mu2/(a+mu2))).sum()
        if not g: return -ll
        grad_b = X.T @ (a*(y - mu2)/(a + mu2))
        grad_a = np.sum(digamma(y+a) - digamma(a) + np.log(a/(a+mu2))
                        + 1 - (a+y)/(a+mu2)) * a
        return -ll, np.append(-grad_b, -grad_a)
    res = minimize(nllg, np.append(init_beta, np.log(0.2)), jac=True,
                   method='L-BFGS-B', options={'maxiter':2000,'maxfun':20000})
    th0 = res.x
    beta = res.x[:p]; alpha = np.exp(res.x[p])
    mu = np.exp(X @ beta)
    di = 2*(xlogy(y, y) - xlogy(y, mu) - y + mu)
    dev = float(np.sum(di))
    devres = np.sign(y-mu)*np.sqrt(np.maximum(di, 0))
    # numerical Hessian (L-BFGS-B hess_inv is not a matrix)
    def grad(th):
        b = th[:p]; a = np.exp(th[p])
        mu2 = np.exp(X @ b)
        # d logL / d beta_j = sum( (y - mu) * x_j * (1 - 1/(alpha+mu)) ... ) via finite diff
        return None
    hess = np.zeros((p+1, p+1))
    def nll2(th):
        b = th[:p]; a = np.exp(th[p])
        mu2 = np.exp(X @ b)
        ll = (gammaln(y+a) - gammaln(y+1) - gammaln(a)
              + a*np.log(a/(a+mu2)) + y*np.log(mu2/(a+mu2))).sum()
        return -ll
    h = 1e-5
    for i in range(p+1):
        for j in range(i, p+1):
            e1 = np.zeros(p+1); e1[i] = h
            e2 = np.zeros(p+1); e2[j] = h
            hess[i,j] = (nll2(th0+e1+e2) - nll2(th0+e1-e2) - nll2(th0-e1+e2) + nll2(th0-e1-e2))/(4*h*h)
            hess[j,i] = hess[i,j]
    Hinv = np.linalg.inv(hess)
    bse = np.sqrt(np.maximum(np.diag(Hinv[:p,:p]), 0))
    return Fit(beta, bse, dev, p-1, n, mu, devres, names, alpha=alpha, converged=bool(res.success))
