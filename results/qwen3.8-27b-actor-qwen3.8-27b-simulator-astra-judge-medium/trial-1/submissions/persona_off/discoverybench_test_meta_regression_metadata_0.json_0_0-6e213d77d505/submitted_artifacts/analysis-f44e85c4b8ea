"""
Analysis: For which domains do effect size estimates tend to be larger in
original studies compared to replication studies?

Data: data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv
Each row = one original study paired with its replication.
Effect sizes: ro/rr (correlation scale), fiso/fisr (Fisher-z scale),
relative_es = rr/ro (already in data).

Approach:
  1. Paired (row-level) differences fiso-fisr and ro-rr per domain.
  2. Mean ES per domain on both scales + mean relative_es.
  3. Direction counts (fraction of pairs with rr > ro).
  4. Nonparametric tests: paired Wilcoxon per domain; Kruskal-Wallis on
     relative_es across disciplines (exploratory, small N).
  5. Sensitivity: dual scale (raw r vs Fisher-z); and excluding sign-reversed
     replications (rr < 0).
Domains: discipline (Cognitive/Social/Economics) primary;
project.x (Psychology / Experimental Economics) for completeness.
"""
import numpy as np
import pandas as pd
from scipy import stats

CSV = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)
print(f"Rows: {len(df)}; missing in ro/rr/fiso/fisr/relative_es: "
      f"{df[['ro','rr','fiso','fisr','relative_es']].isna().sum().sum()}")

def report(g, label):
    n = len(g)
    d_fisher = g["fiso"] - g["fisr"]
    d_raw = g["ro"] - g["rr"]
    w_f, p_f = stats.wilcoxon(g["fiso"] - g["fisr"])  # two-sided
    w_r, p_r = stats.wilcoxon(g["ro"] - g["rr"])
    row = dict(
        n=n,
        mean_ro=g["ro"].mean(), mean_rr=g["rr"].mean(),
        mean_fiso=g["fiso"].mean(), mean_fisr=g["fisr"].mean(),
        mean_diff_fisher=d_fisher.mean(), median_diff_fisher=d_fisher.median(),
        mean_diff_raw=d_raw.mean(), median_diff_raw=d_raw.median(),
        mean_relative_es=g["relative_es"].mean(),
        frac_rr_gt_ro=(g["rr"] > g["ro"]).mean(),
        frac_rr_negative=(g["rr"] < 0).mean(),
        wilcoxon_diff_fisher_p=p_f, wilcoxon_diff_raw_p=p_r,
    )
    print(f"\n=== Domain: {label} (n={n}) ===")
    for k, v in row.items():
        print(f"  {k:24s} {v:.4f}" if isinstance(v, float) else f"  {k:24s} {v}")
    return row

print("\n" + "#" * 70)
print("# 3-level: discipline")
disc_rows = {d: report(g, f"discipline={d}") for d, g in df.groupby("discipline")}

print("\n" + "#" * 70)
print("# 2-level: project")
proj_rows = {p: report(g, f"project={p}") for p, g in df.groupby("project.x")}

# Kruskal-Wallis on relative_es across disciplines
groups = [g["relative_es"].values for _, g in df.groupby("discipline")]
H, p = stats.kruskal(*groups)
print(f"\nKruskal-Wallis on relative_es across 3 disciplines: H={H:.3f}, p={p:.4f}")

# paired Wilcoxon across disciplines on relative_es (Cognitive vs Social)
c, s, e = [df.loc[df.discipline == d, "relative_es"].values
           for d in ("Cognitive", "Social", "Economics")]
# (no natural pairing across disciplines; use Mann-Whitney for pairwise)
for a, b, la, lb in [(c, s, "Cognitive", "Social"), (c, e, "Cognitive", "Economics"),
                     (s, e, "Social", "Economics")]:
    u, p = stats.mannwhitneyu(a, b, alternative="two-sided")
    print(f"Mann-Whitney relative_es {la} vs {lb}: U={u:.1f}, p={p:.4f}")

# Sensitivity: exclude sign-reversed replications (rr < 0)
print("\n" + "#" * 70)
print("# Sensitivity: excluding sign-reversed replications (rr < 0)")
df2 = df[df["rr"] >= 0].copy()
print(f"Rows after exclusion: {len(df2)}")
sens = df2.assign(d_f=df2.fiso - df2.fisr, d_r=df2.ro - df2.rr).groupby("discipline").agg(
    n=("d_f", "size"),
    mean_diff_fisher=("d_f", "mean"),
    mean_diff_raw=("d_r", "mean"),
    mean_relative_es=("relative_es", "mean"),
    frac_rr_gt_ro=("relative_es", lambda x: (x > 1).mean()),
)
print(sens.round(4))

# Summary table for the record
print("\n" + "#" * 70)
print("# Summary table (discipline level)")
summ = pd.DataFrame(disc_rows).T
cols = ["n","mean_ro","mean_rr","mean_fiso","mean_fisr","mean_diff_fisher",
       "mean_diff_raw","mean_relative_es","frac_rr_gt_ro","frac_rr_negative",
       "wilcoxon_diff_fisher_p","wilcoxon_diff_raw_p"]
print(summ[cols].round(4).to_string())
summ[cols].round(4).to_csv("analysis/summary_discipline.csv")
print("\nSaved analysis/summary_discipline.csv")
