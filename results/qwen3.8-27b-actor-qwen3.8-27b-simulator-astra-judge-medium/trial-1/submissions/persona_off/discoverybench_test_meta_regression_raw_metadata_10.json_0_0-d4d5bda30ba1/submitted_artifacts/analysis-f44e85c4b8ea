"""
Question: What is the proportion of junior professors in replicated studies in Psychology?

Definition choices (approved):
  - Psychology replication project      -> project == 'rpp'
  - 'replicated studies'                 -> binary replicated flag == 1
                                            (replicated = p<=0.05 & same direction as original)
  - 'junior professor'                   -> seniority.r == 'Assistant Professor'
                                            (excludes the separate non-professor 'Assistant' category)
  - seniority column                     -> seniority.r (most senior author of the replication study)
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

print("Total rows in dataset:", len(df))

# Filter: Psychology (rpp) AND successfully replicated (replicated == 1)
mask = (df["project"] == "rpp") & (df["replicated"] == 1)
sub = df[mask]
n = len(sub)
print("Rows with project=='rpp' & replicated==1 (denominator):", n)

# Junior professor = 'Assistant Professor' only
junior_mask = sub["seniority.r"] == "Assistant Professor"
k = int(junior_mask.sum())
print("Rows with seniority.r=='Assistant Professor' (numerator):", k)

prop = k / n
print("Proportion: {} / {} = {:.6f} ({:.2%})".format(k, n, prop, prop))

print("\n--- seniority.r breakdown within the filtered subset (n={}) ---".format(n))
print(sub["seniority.r"].value_counts(dropna=False).to_string())

# Sanity checks
assert n == 35, f"expected 35 filtered rows, got {n}"
print("\nSanity check passed: denominator == 35")
