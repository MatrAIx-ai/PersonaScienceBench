import pandas as pd

f = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(f, dtype=str, keep_default_na=False)

def is_students(s):
    return s.str.strip().str.lower() == "students"

df["o_student"] = is_students(df["subjects.o"])
df["r_student"] = is_students(df["subjects.r"])

# ---- Primary: row-level (each row = one original/replication lab pair) ----
row_shares = df.groupby("discipline").agg(
    n_pairs=("id", "size"),
    o_students_pct=("o_student", lambda s: s.mean() * 100),
    r_students_pct=("r_student", lambda s: s.mean() * 100),
).round(2)
print("=== PRIMARY: row-level (lab-pair) student shares by discipline ===")
print(row_shares.to_string())

# ---- Robustness: study-level (unique id) ----
u = df.drop_duplicates("id", keep="first").copy()
r_any = df.groupby("id")["r_student"].any().rename("r_student_any")
u = u.set_index("id").join(r_any)
study_shares = u.groupby("discipline").agg(
    n_studies=("o_student", "size"),
    o_students_pct=("o_student", lambda s: s.mean() * 100),
    r_any_lab_pct=("r_student_any", lambda s: s.mean() * 100),
    r_first_lab_pct=("r_student", lambda s: s.mean() * 100),
).round(2)
print("\n=== ROBUSTNESS: study-level (unique id) student shares ===")
print(study_shares.to_string())

# ---- Match against question targets (o=82.4%, r=80.9%) ----
target = (82.4, 80.9)
def dist(row): return (row.o_students_pct - target[0])**2 + (row.r_students_pct - target[1])**2
ranked = row_shares.assign(target_dist=row_shares.apply(dist, axis=1)).sort_values("target_dist")
print("\n=== Row-level disciplines ranked by distance to targets (82.4%, 80.9%) ===")
print(ranked.to_string())
print("\nAnswer discipline:", ranked.index[0])
