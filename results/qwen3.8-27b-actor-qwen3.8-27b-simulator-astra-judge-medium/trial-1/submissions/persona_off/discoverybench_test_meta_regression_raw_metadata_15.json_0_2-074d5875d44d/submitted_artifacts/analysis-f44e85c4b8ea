import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# Filter to Experimental Economics project, dedup by original-study id (no-op: all EE ids unique)
ee = df[df['project'] == 'ee'].drop_duplicates(subset='id', keep='first')

# Denominator: all EE original studies with a recorded country
denom = ee['experiment_country.o'].notna().sum()

# Numerator: original studies conducted in the United Kingdom
uk = ee[ee['experiment_country.o'] == 'United Kingdom']
num = len(uk)

proportion = num / denom
us = (ee['experiment_country.o'] == 'United States').sum()

print('Total EE rows after dedup:', len(ee))
print('Denominator (EE with recorded country.o):', denom)
print('Numerator (United Kingdom):', num)
print('UK study:', uk[['id', 'title', 'pub_year', 'journal']].to_string(index=False))
print('Proportion (UK / EE):', num, '/', denom, '=', round(proportion, 4), f'({proportion*100:.2f}%)')
print('US count:', us, f'({us/denom*100:.1f}%)')
print()
print('Full EE country breakdown:')
print(ee['experiment_country.o'].value_counts().to_string())
