import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
print('Total rows:', len(df))
print('\n=== project value counts (incl. NaN) ===')
print(df['project'].value_counts(dropna=False))
print('\n=== experiment_country.o value counts (ALL rows) ===')
print(df['experiment_country.o'].value_counts(dropna=False))
ee = df[df['project'] == 'ee']
print('\n=== experiment_country.o value counts (project==ee) ===')
print(ee['experiment_country.o'].value_counts(dropna=False))
print('\nEE rows total:', len(ee), '| EE rows with null country:', ee['experiment_country.o'].isna().sum())
print('EE unique ids:', ee['id'].nunique())
g = df.groupby('id')['experiment_country.o'].nunique(dropna=False)
print('ids with >1 distinct country.o value (all projects):', (g > 1).sum())
print('\n=== EE rows detail ===')
print(ee[['id', 'title', 'pub_year', 'journal', 'experiment_country.o', 'n.o']].to_string())
