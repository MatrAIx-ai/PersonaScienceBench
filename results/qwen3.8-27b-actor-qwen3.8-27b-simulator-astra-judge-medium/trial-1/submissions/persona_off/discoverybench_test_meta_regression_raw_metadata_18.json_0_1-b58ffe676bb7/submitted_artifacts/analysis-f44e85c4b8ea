"""
Final analysis: proportion of Experimental Economics (ee) studies conducted in a lab setting.

Indicator (approved): lab setting := online.o == 0 (not conducted online).
Denominator: all rows with project == 'ee'.
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

# --- Subset: Experimental Economics ---
ee = df[df["project"] == "ee"].copy()
n_ee = len(ee)

# --- Lab indicator: online.o == 0 ---
lab = (ee["online.o"] == 0)
n_lab = int(lab.sum())
n_notlab = int((ee["online.o"] == 1).sum())
n_na = int(ee["online.o"].isna().sum())

proportion = n_lab / n_ee

# --- Supporting counts ---
print("=== Experimental Economics (project == 'ee') lab-setting analysis ===")
print(f"Total ee studies (denominator)      : {n_ee}")
print(f"  online.o == 0 (lab / not online)  : {n_lab}")
print(f"  online.o == 1 (online)            : {n_notlab}")
print(f"  online.o NA                       : {n_na}")
print(f"Proportion in a lab setting         : {n_lab}/{n_ee} = {proportion:.4f} ({proportion*100:.1f}%)")
print()
print("Supporting breakdowns (ee subset):")
print("  online.o  :", ee["online.o"].value_counts(dropna=False).to_dict())
print("  online.r  :", ee["online.r"].value_counts(dropna=False).to_dict())
print("  subjects.o:", ee["subjects.o"].value_counts(dropna=False).to_dict())
print("  us_lab.o  :", ee["us_lab.o"].value_counts(dropna=False).to_dict())
print("  drop      :", ee["drop"].value_counts(dropna=False).to_dict())
