import pandas as pd

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")

results = {}
for p in ["ee", "rpp"]:
    sub = df.loc[df["project"] == p, "length"]
    assert sub.notna().all(), f"unexpected missing length in {p}"
    results[p] = {"n": int(len(sub)), "mean_pages": float(sub.mean())}
    print(f"project={p}: n={len(sub)}, mean length = {sub.mean():.4f} pages")

print(results)
