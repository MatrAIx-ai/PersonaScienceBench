"""
Question: In which domain do the majority of authors tend to be male for both
original and replication studies?

Data: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
(one row per original x replication-lab pair; `discipline` in {Social, Cognitive, Economics};
authors_male.o / authors_male.r = ratio of male authors, [0,1], no missing values).

Primary measure: unweighted, row-level. 'Male majority' per row = ratio > 0.5 (strict).
Sensitivity checks: (1) author-count-weighted means; (2) original-study-deduped mean for .o.
"""
import pandas as pd

F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(F1)

assert df[["discipline", "authors_male.o", "authors_male.r"]].notna().all().all(), "missing values present"
assert ((df["authors_male.o"].between(0, 1)) & (df["authors_male.r"].between(0, 1))).all(), "out-of-range ratio"

# ---- Primary: unweighted row-level table per discipline ----
rows = []
for disc, g in df.groupby("discipline"):
    rows.append({
        "discipline": disc,
        "n_rows": len(g),
        "mean_male_o": g["authors_male.o"].mean(),
        "mean_male_r": g["authors_male.r"].mean(),
        "pct_rows_gt05_o": 100 * (g["authors_male.o"] > 0.5).mean(),
        "pct_rows_gt05_r": 100 * (g["authors_male.r"] > 0.5).mean(),
        "pct_rows_both_gt05": 100 * ((g["authors_male.o"] > 0.5) & (g["authors_male.r"] > 0.5)).mean(),
    })
tab = pd.DataFrame(rows).set_index("discipline")
print("=== PRIMARY (unweighted, row-level) ===")
print(tab.round(2).to_string())

primary_answer = tab[(tab["mean_male_o"] > 0.5) & (tab["mean_male_r"] > 0.5)].index.tolist()
print("\nDisciplines with mean(o)>0.5 AND mean(r)>0.5:", primary_answer)

# ---- Sensitivity 1: author-count-weighted means ----
rows = []
for disc, g in df.groupby("discipline"):
    wo = (g["authors_male.o"] * g["n_authors.o"]).sum() / g["n_authors.o"].sum()
    wr = (g["authors_male.r"] * g["n_authors.r"]).sum() / g["n_authors.r"].sum()
    rows.append({"discipline": disc, "wmean_male_o": wo, "wmean_male_r": wr})
tab_w = pd.DataFrame(rows).set_index("discipline")
print("\n=== SENSITIVITY 1: author-count-weighted means ===")
print(tab_w.round(4).to_string())
print("Weighted both>0.5:", tab_w[(tab_w["wmean_male_o"] > 0.5) & (tab_w["wmean_male_r"] > 0.5)].index.tolist())

# ---- Sensitivity 2: original-study-deduped mean for .o (row-level .r unchanged) ----
rows = []
for disc, g in df.groupby("discipline"):
    o_dedup = g.groupby("id")["authors_male.o"].first()  # authors_male.o constant per id
    rows.append({"discipline": disc,
                 "mean_male_o_dedup": o_dedup.mean(),
                 "n_originals": o_dedup.size,
                 "mean_male_r": g["authors_male.r"].mean()})
tab_d = pd.DataFrame(rows).set_index("discipline")
print("\n=== SENSITIVITY 2: original-study-deduped mean(o) + row-level mean(r) ===")
print(tab_d.round(4).to_string())
print("Deduped-o both>0.5:", tab_d[(tab_d["mean_male_o_dedup"] > 0.5) & (tab_d["mean_male_r"] > 0.5)].index.tolist())

# ---- Overall context ----
print("\nOverall means: o=%.4f r=%.4f (n=%d)" % (df["authors_male.o"].mean(), df["authors_male.r"].mean(), len(df)))
