"""
Analysis: Demographic disparities in median 1985 wealth among individuals
who were ever incarcerated (NLSY79 processed dataset).

Incarceration subset: ever_jailed == 1 (jailed 1985-1994), n=289.
Target statistic: median of composite_wealth_1985 per demographic stratum.
Context: non-incarcerated (ever_jailed == 0) medians for the same strata.
"""
import pandas as pd
import numpy as np

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 20)

df = pd.read_csv("data/nls_incarceration_processed.csv")
W = "composite_wealth_1985"

inc = df[df["ever_jailed"] == 1].copy()
non = df[df["ever_jailed"] == 0].copy()

def med(g):
    return g[W].median()

def block(sub, label):
    print(f"\n===== {label} (n={len(sub)}) =====")
    print(f"Overall median 1985 wealth: {sub[W].median():,.0f}")

    by_race = sub.groupby("race")[W].agg(median="median", n="size").reindex(["white","black","hipanic"])
    print("\nMedian 1985 wealth by race (code value verbatim):")
    print(by_race)

    by_sex = sub.groupby("sex")[W].agg(median="median", n="size").reindex(["male","female"])
    print("\nMedian 1985 wealth by sex:")
    print(by_sex)

    by_rs = sub.groupby(["race","sex"])[W].agg(median="median", n="size").reindex(
        [("white","male"),("white","female"),("black","male"),("black","female"),
         ("hipanic","male"),("hipanic","female")])
    print("\nMedian 1985 wealth by race x sex:")
    print(by_rs)
    return by_race, by_sex, by_rs

block(inc, "INCARCERATED SUBSET (ever_jailed==1)")
block(non, "NON-INCARCERATED (ever_jailed==0) - CONTEXT")

# Narrative-facing table with 'Hispanic' label for race x sex (incarcerated)
print("\n\n===== NARRATIVE: incarcerated subset, median 1985 wealth =====")
print("Overall (all incarcerated):", round(inc[W].median(),0), "n=", len(inc))
for r in ["white","black","hipanic"]:
    print(f"race={r}: median={inc[inc.race==r][W].median():.0f}  n={ (inc.race==r).sum() }")
for s in ["male","female"]:
    print(f"sex={s}: median={inc[inc.sex==s][W].median():.0f}  n={ (inc.sex==s).sum() }")
print("\nRace x sex (incarcerated):")
for r in ["white","black","hipanic"]:
    for s in ["male","female"]:
        sub = inc[(inc.race==r)&(inc.sex==s)]
        print(f"  {r}/{s}: median={sub[W].median():.0f}  n={len(sub)}")

# Non-incarcerated context race x sex
print("\nRace x sex (non-incarcerated, context):")
for r in ["white","black","hipanic"]:
    for s in ["male","female"]:
        sub = non[(non.race==r)&(non.sex==s)]
        print(f"  {r}/{s}: median={sub[W].median():.0f}  n={len(sub)}")

# Save a compact results CSV for the artifact
res = pd.DataFrame({
    "group": ["overall_inc"] + [f"race_{r}" for r in ["white","black","hipanic"]] +
             [f"sex_{s}" for s in ["male","female"]] +
             [f"rs_{r}_{s}" for r in ["white","black","hipanic"] for s in ["male","female"]],
    "median_1985_wealth": [inc[W].median()] +
        [inc[inc.race==r][W].median() for r in ["white","black","hipanic"]] +
        [inc[inc.sex==s][W].median() for s in ["male","female"]] +
        [inc[(inc.race==r)&(inc.sex==s)][W].median() for r in ["white","black","hipanic"] for s in ["male","female"]],
    "n": [len(inc)] +
        [(inc.race==r).sum() for r in ["white","black","hipanic"]] +
        [(inc.sex==s).sum() for s in ["male","female"]] +
        [len(inc[(inc.race==r)&(inc.sex==s)]) for r in ["white","black","hipanic"] for s in ["male","female"]],
})
res.to_csv("results_inc_median_1985.csv", index=False)
print("\nSaved results_inc_median_1985.csv")
