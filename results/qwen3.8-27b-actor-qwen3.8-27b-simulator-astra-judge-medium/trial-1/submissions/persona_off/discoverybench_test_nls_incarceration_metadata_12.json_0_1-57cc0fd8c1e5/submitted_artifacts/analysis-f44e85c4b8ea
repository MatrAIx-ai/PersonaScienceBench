"""
How does incarceration (ever_jailed) affect wealth trajectories for Black
respondents, stratified by income level?
INCOME PROXY: no income/earnings variable exists -> baseline composite_wealth_1985
used as a pre-incarceration wealth/income-status proxy (explicitly labeled as proxy).
Framing: ASSOCIATIONAL, not causal. NLSY1979 processed data.
"""
import pandas as pd, numpy as np
from scipy import stats
import statsmodels.api as sm
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 30)

df = pd.read_csv("data/nls_incarceration_processed.csv")
b = df[df['race'] == 'black'].copy()
WEALTH = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']

print("="*72)
print("ANALYTICAL SAMPLE: Black respondents  N =", len(b))
print("ever_jailed:", dict(b['ever_jailed'].value_counts()),
      "| jailed pct: %.2f%%" % (100*b['ever_jailed'].mean()))
print("sex x ever_jailed:\n", pd.crosstab(b['sex'], b['ever_jailed']))

# ---- Income/wealth-status tiers: explicit zero/negative group + quartiles of positive ----
w0 = b['composite_wealth_1985']
pos = b.loc[w0 > 0, 'composite_wealth_1985']
q25, q50, q75 = pos.quantile([0.25, 0.50, 0.75]).tolist()
def tier(x):
    if x <= 0:   return 'T0_ZeroNeg'
    if x <= q25: return 'T1_Low'
    if x <= q50: return 'T2_Mid'
    if x <= q75: return 'T3_High'
    return 'T4_Top'
b['tier'] = w0.map(tier)
TIERS = ['T0_ZeroNeg','T1_Low','T2_Mid','T3_High','T4_Top']
print("\nIncome/wealth-status tiers (baseline wealth 1985, POSITIVE quartiles + zero/neg group):")
print("  positive quartiles: Low<=%.0f | Mid<=%.0f | High<=%.0f | Top>%.0f" % (q25,q50,q75,q75))
print(b['tier'].value_counts().reindex(TIERS).to_string())

# ---- A. Descriptive trajectory ----
print("\n" + "="*72)
print("A. MEAN composite wealth by tier x ever_jailed (Black)")
print("="*72)
for t in TIERS:
    sub = b[b['tier']==t]
    g = sub.groupby('ever_jailed')[WEALTH].agg(['mean','count'])
    print(f"\n-- {t} (n={len(sub)}) --")
    print(g.to_string())

# ---- B. DiD ----
b['d_post'] = b['composite_wealth_1996'] - b['composite_wealth_1990']   # PRIMARY (post)
b['d_full'] = b['composite_wealth_1996'] - b['composite_wealth_1985']   # full span
print("\n" + "="*72)
print("B. DIFFERENCE-IN-DIFFERENCES (Black)  DiD = jailed - non-jailed change")
print("   PRIMARY: POST 1990->1996 (cleaner; jail window 1985-1994 overlaps 1985 pre)")
print("="*72)
for label, col in [("POST 1990->1996 (primary)","d_post"), ("FULL 1985->1996","d_full")]:
    print(f"\n--- {label} ---")
    for t in TIERS:
        sub = b[b['tier']==t]
        m0 = sub.loc[sub['ever_jailed']==0, col].mean(); n0=(sub['ever_jailed']==0).sum()
        m1 = sub.loc[sub['ever_jailed']==1, col].mean(); n1=(sub['ever_jailed']==1).sum()
        if n1>=2 and n0>=2 and not np.isnan(m1):
            tt,pv = stats.ttest_ind(sub.loc[sub['ever_jailed']==1,col],
                                    sub.loc[sub['ever_jailed']==0,col], equal_var=False)
            print(f"  {t:11s}: non-jailed {m0:9.0f}(n={n0:4d}) | jailed {m1:9.0f}(n={n1:3d}) | "
                  f"DiD {m1-m0:9.0f} | t={tt:6.2f} p={pv:.3f}")
        else:
            print(f"  {t:11s}: non-jailed {m0 if not np.isnan(m0) else float('nan'):9.0f}(n={n0:4d}) | "
                  f"jailed {m1:9.0f}(n={n1:3d}) | too few for test")

# ---- C. Regression ----
b['sex_m'] = (b['sex']=='male').astype(int)
b['ln_w96'] = np.log1p(b['composite_wealth_1996'].clip(lower=0))
tiers = pd.get_dummies(b['tier'], prefix='tier', drop_first=False).astype(int)
tier_cols = tiers[[c for c in tiers.columns if c != 'tier_T0_ZeroNeg']]
base = pd.concat([b[['ever_jailed','composite_wealth_1985','sex_m']], tier_cols], axis=1)
base_int = base.copy()
for c in tier_cols.columns:
    base_int['ej:'+c] = b['ever_jailed'] * tiers[c]

def run_reg(y, X, label):
    m = sm.OLS(y, sm.add_constant(X)).fit(cov_type='HC1')
    print(f"\n--- {label} ---  (n={int(m.nobs)}, R2={m.rsquared:.3f})")
    for k in m.params.index:
        print(f"  {k:24s} coef={m.params[k]:11.2f}  p={m.pvalues[k]:.4f}")
    return m

print("\n" + "="*72)
print("C. REGRESSIONS (HC1 robust SE; ref tier = T0_ZeroNeg)")
print("="*72)
run_reg(b['composite_wealth_1996'], base,     "M1 raw 1996: ever_jailed + baseline + sex + tier")
run_reg(b['composite_wealth_1996'], base_int, "M2 raw 1996: + ever_jailed:tier interactions")
run_reg(b['ln_w96'],               base_int,  "M3 ln(1+w1996): + ever_jailed:tier interactions")
run_reg(b['d_post'],               base_int,  "M4 POST change 1990->1996: + interactions")

# Overall (unstratified) Black ever_jailed effect for context
run_reg(b['composite_wealth_1996'], b[['ever_jailed','composite_wealth_1985','sex_m']],
        "M0 raw 1996: ever_jailed + baseline + sex (no stratification)")
print("\nDONE")
