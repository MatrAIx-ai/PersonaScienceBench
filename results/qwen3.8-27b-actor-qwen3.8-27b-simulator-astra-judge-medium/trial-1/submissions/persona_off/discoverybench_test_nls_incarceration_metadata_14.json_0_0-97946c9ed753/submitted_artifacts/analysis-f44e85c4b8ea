import pandas as pd
import numpy as np

df = pd.read_csv("data/nls_incarceration_processed.csv")

# (a) Filter to black females
bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
n = len(bf)
print(f"Black females: n = {n}")

wealth_cols = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]

# Assert no missing values
for c in wealth_cols:
    assert bf[c].isna().sum() == 0, f"Missing values in {c}"
print("Missing values in subset: 0 (all three columns)")

# (b) Median composite wealth at each timepoint
medians = {c: float(bf[c].median()) for c in wealth_cols}
for c, m in medians.items():
    print(f"Median {c} = {m:,.0f}")

m85, m90, m96 = (medians[c] for c in wealth_cols)

# (c) Consecutive-period changes
d1 = m90 - m85
d2 = m96 - m90
d_span = m96 - m85
print(f"\nChange 1985->1990 (d1) = {d1:+,.0f}")
print(f"Change 1990->1996 (d2) = {d2:+,.0f}")
print(f"Sensitivity: 1985->1996 span = {d_span:+,.0f}")

# (d) Largest increase among adjacent intervals
if d1 > d2:
    winner = "1985 and 1990"
elif d2 > d1:
    winner = "1990 and 1996"
else:
    winner = "tie"
print(f"\nLargest adjacent-interval increase: {winner} (d1={d1:+,.0f} vs d2={d2:+,.0f})")

# Sensitivity: exclude negative wealth values
neg_med = {c: float(bf[bf[c] >= 0][c].median()) for c in wealth_cols}
print("\nSensitivity (excluding negatives):")
for c, m in neg_med.items():
    print(f"  Median {c} = {m:,.0f}")
print(f"  d1={neg_med['composite_wealth_1990']-neg_med['composite_wealth_1985']:+,.0f}, "
      f"d2={neg_med['composite_wealth_1996']-neg_med['composite_wealth_1990']:+,.0f}")
