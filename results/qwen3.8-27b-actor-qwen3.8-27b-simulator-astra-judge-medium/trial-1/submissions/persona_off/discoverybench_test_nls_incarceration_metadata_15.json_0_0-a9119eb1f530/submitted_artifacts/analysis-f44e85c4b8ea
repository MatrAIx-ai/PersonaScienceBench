"""
Final analysis: changes in wealth inequality for white males and females,
1990 -> 1996, from data/nls_incarceration_processed.csv (NLSY79 cohort).

Primary reading: WITHIN-GROUP dispersion (inequality within white males,
within white females). Secondary: between-group male-female gap.
"""
import pandas as pd, numpy as np

df = pd.read_csv("data/nls_incarceration_processed.csv")
w = df[df["race"] == "white"].copy()   # question scope: white only

def gini(x):
    x = np.sort(np.asarray(x, float)); n = len(x)
    if n == 0 or x.sum() == 0: return np.nan
    return (2*np.sum(np.arange(1, n+1)*x) - (n+1)*x.sum()) / (n*x.sum())

def stats(x):
    x = np.asarray(x, float)
    p90 = np.percentile(x, 90); p10 = np.percentile(x, 10)
    topdec = x[x >= np.percentile(x, 90)]
    r = dict(n=len(x), mean=np.mean(x), median=np.median(x),
             sd=np.std(x, ddof=1), gini=gini(x),
             cv=np.std(x, ddof=1)/np.mean(x),
             p90=p90, p99=np.percentile(x, 99),
             topdec_share=100*topdec.sum()/x.sum(),
             nzero=int((x == 0).sum()), nneg=int((x < 0).sum()))
    # 90/10 ratio: undefined here because p10 == 0 (large zero mass)
    r["p90_p10_ratio"] = (p90/p10) if p10 != 0 else np.nan
    return r

results = {}
for sex in ["male", "female"]:
    results[sex] = {
        "1990": stats(w[(w["sex"] == sex)]["composite_wealth_1990"].dropna()),
        "1996": stats(w[(w["sex"] == sex)]["composite_wealth_1996"].dropna()),
    }

print("=== SAMPLE (white, both years present) ===")
print("white male n =", len(w[w['sex']=='male']),
      "| white female n =", len(w[w['sex']=='female']))

print("\n=== PRIMARY: WITHIN-GROUP INEQUALITY ===")
for sex in ["male", "female"]:
    a, b = results[sex]["1990"], results[sex]["1996"]
    print(f"\nWhite {sex} (n={a['n']}):")
    for k in ["mean","median","gini","cv","p90","p99","topdec_share","nzero","nneg"]:
        print(f"  {k:14s} 1990={a[k]:.4g}   1996={b[k]:.4g}")

print("\n=== SECONDARY: BETWEEN-GROUP (male - female) GAP ===")
for c in ["composite_wealth_1990", "composite_wealth_1996"]:
    m = w[w['sex']=='male'][c].dropna(); f = w[w['sex']=='female'][c].dropna()
    print(f"  {c}: mean gap M-F={m.mean()-f.mean():.1f}  median gap M-F={m.median()-f.median():.1f}")

print("\n=== INTERPRETATION ===")
for sex in ["male", "female"]:
    a, b = results[sex]["1990"], results[sex]["1996"]
    dg = b["gini"] - a["gini"]; dt = b["topdec_share"] - a["topdec_share"]
    print(f"White {sex}: dGini={dg:+.4f}, d(top-decile share)={dt:+.2f} pts, "
          f"dCV={b['cv']-a['cv']:+.3f} -> within-group inequality essentially unchanged.")
