"""
Analysis: Does ever_jailed=1 (criminal record) associate with significantly lower
composite wealth than ever_jailed=0 in 1985, 1990, and 1996?

Primary test:  Mann-Whitney U (two-sided, alpha=0.05), per year.
Sensitivity:   Welch t-test; Cochran-Mantel-Haenszel across 6 race x sex strata;
               Bonferroni-adjusted p-values (3 tests); de-duplicated data run.
"""
import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv("data/nls_incarceration_processed.csv")
YEARS = ["1985", "1990", "1996"]
COLS = {y: f"composite_wealth_{y}" for y in YEARS}
ALPHA = 0.05

def cph_stratified(df, year_col):
    """Manual Cochran-Mantel-Haenszel test: exposure=ever_jailed, outcome higher-wealth indicator per stratum."""
    strata = df.groupby(["race", "sex"])
    num = den = 0.0
    for _, g in strata:
        n1 = (g.ever_jailed == 1).sum()
        n0 = (g.ever_jailed == 0).sum()
        if n1 == 0 or n0 == 0:
            continue
        # rank-based (Mantel) CMH: use midranks of wealth within stratum
        ranks = g[year_col].rank(method="average")
        r1 = ranks[g.ever_jailed == 1].sum()
        n = len(g)
        E = n1 * (n + 1) / 2.0
        Var = n1 * n0 * (n + 1) / 12.0
        if Var > 0:
            num += (r1 - E) / np.sqrt(Var)
    chi2 = num ** 2   # Mantel-Haenszel: (sum of standardized deviations)^2, df=1
    p = stats.chi2.sf(chi2, df=1)
    return chi2, p

def analyze(data, label):
    rows = []
    mw_p, welch_p, cph_p = {}, {}, {}
    for y in YEARS:
        c = COLS[y]
        a = data.loc[data.ever_jailed == 1, c]   # jailed
        b = data.loc[data.ever_jailed == 0, c]   # not jailed
        u, p_mw = stats.mannwhitneyu(a, b, alternative="two-sided")
        t, p_w = stats.ttest_ind(a, b, equal_var=False)
        chi2, p_c = cph_stratified(data, c)
        mw_p[y], welch_p[y], cph_p[y] = p_mw, p_w, p_c
        rows.append(dict(year=y, n_jailed=len(a), median_jailed=a.median(), mean_jailed=round(a.mean(), 1),
                         n_no_jailed=len(b), median_no_jailed=b.median(), mean_no_jailed=round(b.mean(), 1),
                         MWU_U=round(u, 1), MWU_p=p_mw, Welch_t=round(t, 3), Welch_p=p_w,
                         CMH_chi2=round(chi2, 2), CMH_p=p_c,
                         MWU_p_Bonferroni=min(p_mw * 3, 1.0)))
    return pd.DataFrame(rows)

print("=" * 110)
print("PRIMARY ANALYSIS (all 12,013 rows)")
print("=" * 110)
res = analyze(df, "full")
pd.set_option("display.width", 200)
print(res.to_string(index=False, float_format=lambda v: f"{v:.6g}"))

print()
for y in YEARS:
    sig = res.loc[res.year == y, "MWU_p"].iloc[0] < ALPHA
    direction = res.loc[res.year == y, "median_jailed"].iloc[0] < res.loc[res.year == y, "median_no_jailed"].iloc[0]
    print(f"{y}: MWU p = {res.loc[res.year==y,'MWU_p'].iloc[0]:.3e} -> "
          f"{'SIGNIFICANTLY LOWER' if (sig and direction) else 'not significant'} wealth for jailed group "
          f"(Bonferroni p = {res.loc[res.year==y,'MWU_p_Bonferroni'].iloc[0]:.3e})")

print()
print("=" * 110)
print("SENSITIVITY: de-duplicated data (drop exact duplicate rows)")
print("=" * 110)
df_dd = df.drop_duplicates()
print(f"rows after de-duplication: {len(df_dd)} (removed {len(df) - len(df_dd)})")
res_dd = analyze(df_dd, "dedup")
print(res_dd.to_string(index=False, float_format=lambda v: f"{v:.6g}"))

print()
print("ever_jailed counts: full =", df.ever_jailed.value_counts().to_dict(),
      "| dedup =", df_dd.ever_jailed.value_counts().to_dict())
