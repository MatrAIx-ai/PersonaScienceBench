import pandas as pd, numpy as np
import statsmodels.api as sm
pd.set_option("display.width", 200)

df = pd.read_csv("data/nls_raw.csv")
RACE = "Racial/ethnic cohort, 1979"
INC  = "Total net family income, previous calendar year, 1979"
W85  = "Family net wealth, 1985"
MOM  = "Highest grade completed by respondent's mother, 1979"
DAD  = "Highest grade completed by respondent's father, 1979"
G79  = "Highest grade completed, 1979"
RANK = "Rank in class last year attended at this school, 1981"
NS   = "Number of students in class last year attended at this school, 1981"
ASV  = [c for c in df.columns if c.startswith("ASVAB")]
SEX  = "Sex of respondent, 1979"

d = pd.DataFrame()
d["grade"] = df[G79]
d["black"] = (df[RACE]==1).astype(float)
d["hisp"]  = (df[RACE]==2).astype(float)
d["race"]  = df[RACE]
d["sex"]   = (df[SEX]==1).astype(float)
d["inc"]   = np.log1p(df[INC])
d["w85"]   = np.log1p(df[W85])
d["pe"]    = (df[MOM].fillna(df[DAD]) + df[DAD].fillna(df[MOM])) / 2  # parent-ed composite (fill with other parent, drop if both missing)
d["pe"]    = d["pe"].where(df[MOM].notna() | df[DAD].notna())
d["asvab"] = df[ASV].mean(axis=1)
d["rankpct"] = 1 - (d["rank"] if False else (df[RANK]-1)/df[NS])
# standardize academic vars within full sample for interpretability
d["asvab_z"] = (d["asvab"] - d["asvab"].mean())/d["asvab"].std()
d["asvab_raw"] = d["asvab"]

def ols(y, X, d, name):
    sub = d[[y, *X] + ["race"]].dropna()
    Xd = sm.add_constant(sub[X])
    m = sm.OLS(sub[y], Xd).fit()
    sd_y = sub[y].std()
    betas = {k: v*sub[k].std()/sd_y for k,v in m.params.items() if k!="const"}
    print(f"\n### {name} | OLS, y={y}, n={int(m.nobs)}")
    print("race composition: black %.1f%%, hisp %.1f%%, white %.1f%%" % (
        100*sub["black"].mean(), 100*sub["hisp"].mean(), 100*(1-sub['black']-sub['hisp']).mean()))
    for k in m.params.index:
        print(f"  {k:<10} b={m.params[k]:>8.4f}  se={m.bse[k]:>8.4f}  p={m.pvalues[k]:.4g}  beta_std={betas.get(k, float('nan')):>8.4f}")
    return m, sub

def report(mA, mB, names, label):
    print(f"\n=== ATTENUATION {label}: Stage A -> Stage B ===")
    for k in names:
        a, b = mA.params[k], mB.params[k]
        print(f"  {k:<10} A={a:.4f} (p={mA.pvalues[k]:.3g})  B={b:.4f} (p={mB.pvalues[k]:.3g})  change={100*(b-a)/abs(a):+6.1f}%")

# ---------------- PRIMARY: income 1979 ----------------
mA, sA = ols("grade", ["black","hisp","inc"], d, "Stage A: race + income1979(log)")
mB, sB = ols("grade", ["black","hisp","inc","asvab_z"], d, "Stage B: race + income1979 + ASVAB")
mB2, sB2 = ols("grade", ["black","hisp","inc","asvab_z","rankpct"], d, "Stage B2: + class-rank percentile")
report(mA, mB, ["black","hisp","inc"], "PRIMARY (income1979, ASVAB)")
report(mB, mB2, ["black","hisp","inc","asvab_z"], "B -> B2 (adding class rank)")

# sex-adjusted robustness
mA_s, _ = ols("grade", ["black","hisp","inc","sex"], d, "Stage A sex-adj")
mB_s, _ = ols("grade", ["black","hisp","inc","asvab_z","sex"], d, "Stage B sex-adj")
report(mA_s, mB_s, ["black","hisp","inc"], "SEX-ADJ (income1979)")

# ---------------- SENSITIVITY SES: parent education ----------------
mA_p, _ = ols("grade", ["black","hisp","pe"], d, "Stage A: race + parent-ed composite")
mB_p, _ = ols("grade", ["black","hisp","pe","asvab_z"], d, "Stage B: race + parent-ed + ASVAB")
report(mA_p, mB_p, ["black","hisp","pe"], "PARENT-ED (ASVAB)")

# ---------------- SENSITIVITY SES: wealth 1985 ----------------
mA_w, _ = ols("grade", ["black","hisp","w85"], d, "Stage A: race + wealth1985(log)")
mB_w, _ = ols("grade", ["black","hisp","w85","asvab_z"], d, "Stage B: race + wealth1985 + ASVAB")
report(mA_w, mB_w, ["black","hisp","w85"], "WEALTH1985 (ASVAB)")

# ---------------- BINARY OUTCOME: college completion (>12) ----------------
d["college"] = (d["grade"]>12).astype(float)
def logit(y, X, d, name):
    sub = d[[y,*X]].dropna()
    Xd = sm.add_constant(sub[X])
    m = sm.Logit(sub[y], Xd).fit(disp=0)
    print(f"\n### {name} | LOGIT, n={int(m.nobs)}, events={int(sub[y].sum())}")
    for k in m.params.index:
        print(f"  {k:<10} b={m.params[k]:>8.4f}  se={m.bse[k]:>8.4f}  p={m.pvalues[k]:.4g}  OR={np.exp(m.params[k]):>7.3f}")
    return m
lA = logit("college", ["black","hisp","inc"], d, "Logit Stage A: college(>12) ~ race + income")
lB = logit("college", ["black","hisp","inc","asvab_z"], d, "Logit Stage B: + ASVAB")
print("\n=== ATTENUATION LOGIT college completion ===")
for k in ["black","hisp","inc"]:
    a,b = lA.params[k], lB.params[k]
    print(f"  {k:<10} A={a:.4f} (p={lA.pvalues[k]:.3g})  B={b:.4f} (p={lB.pvalues[k]:.3g})  change={100*(b-a)/abs(a):+6.1f}%")

# ---------------- DESCRIPTIVE BA (>=16) ----------------
print("\n=== DESCRIPTIVE: BA (grade>=16) in 1979, n tiny ===")
d["ba"] = (d["grade"]>=16).astype(float)
print("BA rate by race:"); print((d.groupby("race")["ba"].agg(["sum","count","mean"])).round(4))
sub = d[["ba","inc"]].dropna()
sub["q"] = pd.qcut(sub["inc"], 5, labels=["Q1(low)","Q2","Q3","Q4","Q5(high)"])
print("BA rate by income1979 quintile:"); print(sub.groupby("q")["ba"].agg(["sum","count","mean"]).round(4))

# ---------------- ASVAB raw-scale coefficient for interpretability ----------------
mBraw, _ = ols("grade", ["black","hisp","inc","asvab_raw"], d, "Stage B raw ASVAB scale (100-800)")
print("\nASVAB raw-scale: 1 SD (100 pts on ASVAB scale) of composite ->",
      round(mBraw.params["asvab_raw"]*100,3), "years of schooling")
