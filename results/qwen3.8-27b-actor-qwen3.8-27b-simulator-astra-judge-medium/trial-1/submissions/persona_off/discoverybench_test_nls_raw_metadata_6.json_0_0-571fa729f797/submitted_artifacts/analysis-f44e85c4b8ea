import pandas as pd, numpy as np
import warnings; warnings.filterwarnings('ignore')
try:
    import statsmodels.api as sm
    HAVE_SM = True
except Exception:
    HAVE_SM = False
print("statsmodels available:", HAVE_SM)

df = pd.read_csv('data/nls_raw.csv')
EDU='Highest grade completed, 1979'
RACE='Racial/ethnic cohort, 1979'
AGE='Age of respondent, 1979'
SEX='Sex of respondent, 1979'
INC='Total net family income, previous calendar year, 1979'
MOM="Highest grade completed by respondent's mother, 1979"
DAD="Highest grade completed by respondent's father, 1979"
WEAL85='Family net wealth, 1985'
az=['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981','ASVAB - Word Knowledge Z Score (rounded), 1981','ASVAB - Paragraph Comprehension Z Score (rounded), 1981','ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
df['ASVAB']=df[az].mean(axis=1)

# exclude DK(95) and NaN edu
df = df[df[EDU].notna() & (df[EDU]!=95)].copy().reset_index(drop=True)
df['Black']=(df[RACE]==1).astype(int)
df['Hispanic']=(df[RACE]==2).astype(int)
df['HS']=(df[EDU]>=12).astype(int)
df['BA']=(df[EDU]>=16).astype(int)
df['parent_edu']=(df[MOM]+df[DAD])/2  # composite; NaN if either missing
print("\n=== (1) RACE GAP in outcomes by 1979-family-income SES tertile ===")
d = df[df[INC].notna() & (df[INC]>0)].copy()
d['SES']=pd.qcut(d[INC],3,labels=['Low','Mid','High'])
print("n in SES-stratified sample:", len(d))
for o in ['HS','BA']:
    print(f"\n-- {o} rate by SES x race (%) --")
    print((pd.crosstab(d['SES'],d[RACE],values=d[o],aggfunc='mean')*100).round(2))
    print("Black gap (NonBlack - Black) by SES:")
    tab=pd.crosstab(d['SES'],d[RACE],values=d[o],aggfunc='mean')
    print(((tab[3]-tab[1])*100).round(2))
print("\n-- continuous grade mean by SES x race --")
print((pd.crosstab(d['SES'],d[RACE],values=d[EDU],aggfunc='mean')).round(3))
print("Black gap (NonBlack - Black) continuous grade by SES:")
tab=pd.crosstab(d['SES'],d[RACE],values=d[EDU],aggfunc='mean')
print((tab[3]-tab[1]).round(3))

print("\n=== (2) MODELS (outcome on Black/Hispanic, income, parent_edu, ASVAB, sex, age, Black x income) ===")
# continuous income in $1000, standardized for interaction
base = df[df[[INC,MOM,DAD,"ASVAB",SEX,AGE]].notna().all(axis=1).values].copy().reset_index(drop=True)
base['inc_k']=base[INC]/1000.0
base['inc_z']=(base['inc_k']-base['inc_k'].mean())/base['inc_k'].std()
base['sex']=base[SEX]  # 1 male 2 female
print("complete-case n:", len(base))

def run_model(dep, kind):
    X=pd.DataFrame({
        'Black':base['Black'],'Hispanic':base['Hispanic'],
        'inc_z':base['inc_z'],'parent_edu':base['parent_edu'],
        'ASVAB':base['ASVAB'],'sex':base['sex'],'age':base[AGE],
        'Black_x_inc':base['Black']*base['inc_z']})
    X=sm.add_constant(X)
    if kind=='logit':
        m=sm.Logit(base[dep],X).fit(disp=0)
    else:
        m=sm.OLS(base[dep],X).fit()
    print(f"\n--- {kind} on {dep} (n={int(m.nobs)}) ---")
    r2 = (1 - m.llf/m.llnull) if kind=="logit" else m.rsquared_adj
    print("Pseudo/Adj R2:", round(r2,4))
    for c in ['Black','Hispanic','inc_z','parent_edu','ASVAB','sex','age','Black_x_inc']:
        b=m.params[c]; se=m.bse[c]; p=m.pvalues[c]
        if kind=='logit':
            odds=np.exp(b)
            print(f"  {c:12s} b={b:+.3f} OR={odds:.3f} (se {se:.3f}) p={p:.3g}")
        else:
            print(f"  {c:12s} b={b:+.3f} (se {se:.3f}) p={p:.3g}")
    return m

if HAVE_SM:
    run_model('HS','logit')
    run_model(EDU,'ols')

print("\n=== (3) ROBUSTNESS: parental-education composite as SES (no income) ===")
if HAVE_SM:
    X=pd.DataFrame({'Black':base['Black'],'Hispanic':base['Hispanic'],
                    'parent_edu':base['parent_edu'],'ASVAB':base['ASVAB'],
                    'sex':base['sex'],'age':base[AGE]})
    X=sm.add_constant(X)
    for dep,kind in [('HS','logit'),(EDU,'ols')]:
        m=sm.Logit(base[dep],X).fit(disp=0) if kind=='logit' else sm.OLS(base[dep],X).fit()
        print(f"\n--- {kind} on {dep}, SES=parent_edu (n={int(m.nobs)}) ---")
        for c in ['Black','Hispanic','parent_edu','ASVAB']:
            b=m.params[c]; se=m.bse[c]; p=m.pvalues[c]
            print(f"  {c:12s} b={b:+.3f} OR={np.exp(b):.3f} (se {se:.3f}) p={p:.3g}" if kind=='logit'
                  else f"  {c:12s} b={b:+.3f} (se {se:.3f}) p={p:.3g}")

print("\n=== (4) IMPUTATION SENSITIVITY (median-impute income & parent_edu) ===")
if HAVE_SM:
    b2 = df[df[["ASVAB",SEX,AGE]].notna().all(axis=1).values].copy().reset_index(drop=True)
    b2['inc_k']=b2[INC]/1000.0
    inc_med=b2['inc_k'].median()
    b2['inc_k']=b2['inc_k'].fillna(inc_med)
    pe_med=b2['parent_edu'].median()
    b2['parent_edu']=b2['parent_edu'].fillna(pe_med)
    b2['inc_z']=(b2['inc_k']-b2['inc_k'].mean())/b2['inc_k'].std()
    X=pd.DataFrame({'Black':b2['Black'],'Hispanic':b2['Hispanic'],
                    'inc_z':b2['inc_z'],'parent_edu':b2['parent_edu'],
                    'ASVAB':b2['ASVAB'],'sex':b2[SEX],'age':b2[AGE],
                    'Black_x_inc':b2['Black']*b2['inc_z']})
    X=sm.add_constant(X)
    m=sm.Logit(b2['HS'],X).fit(disp=0)
    print(f"imputed logit HS (n={int(m.nobs)}) Black b={m.params['Black']:+.3f} OR={np.exp(m.params['Black']):.3f} p={m.pvalues['Black']:.3g}; Black_x_inc b={m.params['Black_x_inc']:+.3f} p={m.pvalues['Black_x_inc']:.3g}")
    m=sm.OLS(b2[EDU],X).fit()
    print(f"imputed OLS grade (n={int(m.nobs)}) Black b={m.params['Black']:+.3f} p={m.pvalues['Black']:.3g}; Black_x_inc b={m.params['Black_x_inc']:+.3f} p={m.pvalues['Black_x_inc']:.3g}")

print("\nDONE")
