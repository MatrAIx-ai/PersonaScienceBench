"""
NLSY79: Median family net wealth by racial/ethnic cohort, 1985/1990/1996.

Question: How does the median wealth of white individuals compare to that of
black and Hispanic individuals from 1985 onwards?

Primary estimate: median family net wealth per (year x racial/ethnic group)
over non-missing values (listwise exclusion, per-group n reported).

Robustness / sensitivity:
  - 90th percentile (upper-tail location)
  - drop top-coded repeated values (1,321,099 in 1990; 1,232,183 in 1996)
  - per-capita (family net wealth / Family size, 1979)
"""
import pandas as pd
import numpy as np

CSV = "data/nls_raw.csv"
RACE = "Racial/ethnic cohort, 1979"
FAMSIZE = "Family size, 1979"
WEALTH = {
    "1985": "Family net wealth, 1985",
    "1990": "Family net wealth, 1990",
    "1996": "Family net wealth, 1996 (key data point)",
}
GROUPS = {1: "Black", 2: "Hispanic", 3: "White-proxy (non-Black/non-Hispanic)"}
WHITE, BLACK, HISP = 3, 1, 2
TOPCODE = {"1985": None, "1990": 1321099.0, "1996": 1232183.0}

df = pd.read_csv(CSV)
n_total = len(df)

def fmt(v, dec=0):
    return f"{v:,.{dec}f}"

def show(title, dframe):
    print("\n" + "=" * 80)
    print(title)
    print("=" * 80)
    print(dframe.to_string(index=False))

# ----------------------------------------------------------------------
# (A) Primary: median family net wealth, non-missing, per group/year
# ----------------------------------------------------------------------
rows = []
for year, col in WEALTH.items():
    for g, name in GROUPS.items():
        sub = df.loc[df[RACE] == g, col].dropna()
        rows.append({"year": year, "group": name, "code": g,
                     "n": len(sub), "median": sub.median()})
primary = pd.DataFrame(rows).sort_values(["year", "code"]).reset_index(drop=True)
primary["median_$"] = primary["median"].map(fmt)
show("(A) PRIMARY: Median family net wealth (nominal $), non-missing values",
     primary[["year", "group", "n", "median_$"]])

# Ratios: white/black and white/hispanic (median-based)
rat_rows = []
for year in WEALTH:
    y = primary[primary.year == year]
    w = float(y.loc[y.code == WHITE, "median"].iloc[0])
    b = float(y.loc[y.code == BLACK, "median"].iloc[0])
    h = float(y.loc[y.code == HISP, "median"].iloc[0])
    rat_rows.append({"year": year, "white": fmt(w), "black": fmt(b),
                     "hisp": fmt(h), "white/black": f"{w/b:.2f}x",
                     "white/hispanic": f"{w/h:.2f}x"})
ratios = pd.DataFrame(rat_rows)
show("Median ratios (White-proxy / Black, White-proxy / Hispanic)", ratios)

# ----------------------------------------------------------------------
# (B) Robustness 1: 90th percentile
# ----------------------------------------------------------------------
rows = []
for year, col in WEALTH.items():
    for g, name in GROUPS.items():
        sub = df.loc[df[RACE] == g, col].dropna()
        rows.append({"year": year, "group": name, "code": g,
                     "n": len(sub), "p90": sub.quantile(0.90)})
p90 = pd.DataFrame(rows).sort_values(["year", "code"]).reset_index(drop=True)
p90["p90_$"] = p90["p90"].map(fmt)
show("(B) ROBUSTNESS: 90th percentile of family net wealth (nominal $)",
     p90[["year", "group", "n", "p90_$"]])

# ----------------------------------------------------------------------
# (C) Robustness 2: drop top-coded repeated values, recompute median
# ----------------------------------------------------------------------
rows = []
for year, col in WEALTH.items():
    tc = TOPCODE[year]
    for g, name in GROUPS.items():
        sub = df.loc[df[RACE] == g, col].dropna()
        if tc is not None:
            n_dropped = int((sub == tc).sum())
            sub = sub[sub != tc]
        else:
            n_dropped = 0
        rows.append({"year": year, "group": name, "code": g,
                     "n": len(sub), "dropped": n_dropped, "median": sub.median()})
drop = pd.DataFrame(rows).sort_values(["year", "code"]).reset_index(drop=True)
drop["median_$"] = drop["median"].map(fmt)
show("(C) ROBUSTNESS: Median after dropping top-coded repeated value "
     "(1990: 1,321,099; 1996: 1,232,183)",
     drop[["year", "group", "n", "dropped", "median_$"]])

# ----------------------------------------------------------------------
# (D) Sensitivity: per-capita (family net wealth / Family size, 1979)
# ----------------------------------------------------------------------
rows = []
for year, col in WEALTH.items():
    for g, name in GROUPS.items():
        m = (df[RACE] == g) & df[col].notna()
        sub = df.loc[m, col] / df.loc[m, FAMSIZE]
        rows.append({"year": year, "group": name, "code": g,
                     "n": len(sub), "median_percap": sub.median()})
pc = pd.DataFrame(rows).sort_values(["year", "code"]).reset_index(drop=True)
pc["median_percap_$"] = pc["median_percap"].map(fmt)
show("(D) SENSITIVITY: Per-capita median (family net wealth / Family size, 1979)",
     pc[["year", "group", "n", "median_percap_$"]])

# ----------------------------------------------------------------------
# (E) Missingness / attrition by group and year
# ----------------------------------------------------------------------
rows = []
for year, col in WEALTH.items():
    for g, name in GROUPS.items():
        sel = df.loc[df[RACE] == g, col]
        rows.append({"year": year, "group": name, "code": g,
                     "n_obs": int(sel.notna().sum()),
                     "n_missing": int(sel.isna().sum()),
                     "pct_missing": f"{100*sel.isna().mean():.1f}%"})
miss = pd.DataFrame(rows).sort_values(["year", "code"]).reset_index(drop=True)
show("(E) Missingness (attrition) by group and year",
     miss[["year", "group", "n_obs", "n_missing", "pct_missing"]])

# ----------------------------------------------------------------------
# Save tables + numeric CSVs
# ----------------------------------------------------------------------
with open("results_tables.txt", "w") as f:
    f.write("NLSY79 median family net wealth by racial/ethnic cohort\n")
    f.write(f"Total respondents: {n_total:,}\n")
    for tag, d in [("A PRIMARY median", primary[["year","group","n","median_$"]]),
                   ("Ratios", ratios),
                   ("B 90th pct", p90[["year","group","n","p90_$"]]),
                   ("C drop topcode", drop[["year","group","n","dropped","median_$"]]),
                   ("D per-capita", pc[["year","group","n","median_percap_$"]]),
                   ("E missingness", miss[["year","group","n_obs","n_missing","pct_missing"]])]:
        f.write(f"\n{tag}:\n{d.to_string(index=False)}\n")
primary.drop(columns=["median_$"]).to_csv("primary_median_wealth.csv", index=False)
ratios.to_csv("median_ratios.csv", index=False)
print("\nSaved: results_tables.txt, primary_median_wealth.csv, median_ratios.csv")
