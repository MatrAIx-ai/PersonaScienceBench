"""
DiscoveryBench: NLS SES -> BA degree completion
Question: which variable's coefficient on BA completion drops from ~0.3636 to
~-0.2293 (becoming insignificant) when race + academic characteristics are added?

Method:
  1) Univariate logistic regression of BA_DEGREE_COMPLETED on each candidate
     predictor (raw and, for continuous vars, z-standardized).
  2) Full logistic model: BA ~ SES + race dummies (Black, Hispanic; White ref)
     + ABILITY composite + PERCENTILE IN CLASS (raw and z-standardized variants).
  3) Significance via Wald z-test (p < 0.05).
  4) OLS (linear probability) sensitivity check.
  5) VIF / condition number for collinearity.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

df = pd.read_csv('data/nls_ses_processed.csv')
y = df['BA DEGREE COMPLETED'].astype(int)
df['Black'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['Hispanic'] = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['Male'] = (df['SAMPLE_SEX'] == 'Male').astype(int)
CONT = ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE']
for c in CONT:
    df[c + '_z'] = (df[c] - df[c].mean()) / df[c].std()
A, P = 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS'

def zscore(name):
    return name + '_z' if name in CONT else name

def logit(cols, scale='raw'):
    X = df[[zscore(c) if scale == 'z' else c for c in cols]]
    return sm.Logit(y, sm.add_constant(X)).fit(disp=0)

def ols(cols, scale='raw'):
    X = df[[zscore(c) if scale == 'z' else c for c in cols]]
    return sm.OLS(y, sm.add_constant(X)).fit()

def row(m, name):
    return (name, m.params[name], m.bse[name], m.tvalues[name], m.pvalues[name])

print('#' * 78)
print('# N = %d, BA completion rate = %.4f (%d/%d)' % (len(df), y.mean(), y.sum(), len(df)))
print('#' * 78)

print('\n### 1. UNIVARIATE LOGISTIC (BA ~ X) ###')
for c in ['SES', zscore('SES'), A, P, 'FAMILY SIZE OF SAMPLE', 'Male']:
    m = sm.Logit(y, sm.add_constant(df[[c]])).fit(disp=0)
    print('  BA ~ %-28s coef=%8.4f  SE=%7.4f  z=%7.3f  p=%.3g' % (c, m.params[c], m.bse[c], m.tvalues[c], m.pvalues[c]))

print('\n### 2. FULL LOGISTIC MODELS (BA ~ SES + race + academics) ###')
for scale in ['raw', 'z']:
    cols = ['SES', 'Black', 'Hispanic', A, P]
    m = logit(cols, scale)
    print('\n  [scale=%s]' % scale)
    for name in ['SES', 'Black', 'Hispanic', A, P]:
        n = zscore(name) if scale == 'z' else name
        _, b, se, z, p = row(m, n)
        print('    %-28s coef=%8.4f  SE=%7.4f  z=%7.3f  p=%.4g%s' % (n, b, se, z, p, '   <<<' if name == 'SES' else ''))

print('\n### 3. SES COEFFICIENT TRANSITION (the answer) ###')
b0 = sm.Logit(y, sm.add_constant(df[['SES_z']])).fit(disp=0).params['SES_z']
b0r = sm.Logit(y, sm.add_constant(df[['SES']])).fit(disp=0).params['SES']
f_raw = logit(['SES', 'Black', 'Hispanic', A, P], 'raw')
f_z = logit(['SES', 'Black', 'Hispanic', A, P], 'z')
print('  baseline BA ~ SES (raw):          %.4f' % b0r)
print('  baseline BA ~ SES_z:              %.4f   (target ~0.3636)' % b0)
print('  full raw  SES:   %.4f  p=%.4g  (target ~-0.2293)' % (f_raw.params['SES'], f_raw.pvalues['SES']))
print('  full z    SES_z: %.4f  p=%.4g' % (f_z.params['SES_z'], f_z.pvalues['SES_z']))

print('\n### 4. OLS SENSITIVITY (linear probability) ###')
o0 = ols(['SES']); o0z = ols(['SES'], 'z')
of = ols(['SES', 'Black', 'Hispanic', A, P])
print('  OLS baseline SES:  %.4f -> full SES: %.4f (p=%.3g)' % (o0.params['SES'], of.params['SES'], of.pvalues['SES']))
print('  OLS baseline SES_z: %.4f' % o0z.params['SES_z'])

print('\n### 5. COLLINEARITY CHECK (raw full model) ###')
Xv = sm.add_constant(df[['SES', 'Black', 'Hispanic', A, P]])
vif = {k: variance_inflation_factor(Xv.values, j) for j, k in enumerate(Xv.columns)}
print('  VIF:', {k: round(v, 2) for k, v in vif.items()})
print('  condition number: %.1f' % np.linalg.cond(df[['SES', 'Black', 'Hispanic', A, P]].values))

print('\n### 6. MECHANISM EVIDENCE ###')
print('  corr(SES, ABILITY)     = %.3f' % df['SES'].corr(df[A]))
print('  corr(SES, PERCENTILE)  = %.3f' % df['SES'].corr(df[P]))
print('  SES mean by race:      ' + ', '.join('%s %.3f' % (r, g['SES'].mean()) for r, g in df.groupby('SAMPLE_RACE')))
print('  BA rate by race:       ' + ', '.join('%s %.3f' % (r, g['BA DEGREE COMPLETED'].mean()) for r, g in df.groupby('SAMPLE_RACE')))
