"""DiscoveryBench: which variable's effect on BA degree completion drops from
0.5024 to 0.0923 (becoming insignificant) when SES + academic characteristics
(ABILITY ASVAB composite, PERCENTILE IN CLASS) are included?

Approach: nested logistic regressions (OLS sensitivity) for each candidate
variable X: Model A = BA ~ X ; Model B = BA ~ X + SES + ABILITY + PCTCLASS.
Compare X's coefficient, p-value and 95% CI across models.
"""
import pandas as pd
from statsmodels.formula.api import logit, ols

df = pd.read_csv('data/nls_ses_processed.csv').rename(columns={
    'ABILITY: COMPOSITE OF ASVAB SCORE': 'ABILITY',
    'PERCENTILE IN CLASS': 'PCTCLASS',
    'FAMILY SIZE OF SAMPLE': 'FAMSIZ',
    'BA DEGREE COMPLETED': 'BA',
    'SAMPLE_RACE': 'RACE', 'SAMPLE_SEX': 'SEX'})
df['BA'] = df['BA'].astype(int)
print(f'n={len(df)}, BA completion={df["BA"].sum()} ({df["BA"].mean():.4f}), missing={int(df.isna().sum().sum())}')

COVS = ['SES', 'ABILITY', 'PCTCLASS']   # SES + academic characteristics
CANDS = {
    'SES': 'SES', 'ABILITY': 'ABILITY', 'PCTCLASS': 'PCTCLASS',
    'FAMSIZ': 'FAMSIZ', 'RACE': 'C(RACE)', 'SEX': 'C(SEX)'}

def report(fn, label):
    print(f'\n===== {label} =====')
    for name, term in CANDS.items():
        mA = fn(f'BA ~ {term}', data=df).fit(disp=0)
        mB = fn(f'BA ~ {term} + ' + ' + '.join(COVS), data=df).fit(disp=0)
        for p in mA.params.index:
            if p == term or p.startswith(term + '[') or p.startswith(term + ','):
                ciA = mA.conf_int().loc[p]
                ciB = mB.conf_int().loc[p] if p in mB.params.index else (float('nan'),)*2
                print(f'{name} | {p}\n  A (X only):        coef={mA.params[p]: .4f}  p={mA.pvalues[p]:.4g}  CI95=[{ciA[0]: .4f},{ciA[1]: .4f}]'
                      f'\n  B (X + SES+acad): coef={mB.params[p]: .4f}  p={mB.pvalues[p]:.4g}  CI95=[{ciB[0]: .4f},{ciB[1]: .4f}]')

report(logit, 'LOGISTIC (primary)')
report(ols, 'OLS (sensitivity)')
