"""
NLS SES analysis: is the SES -> BA-degree-completion relationship moderated by race?
Primary: logistic regression with SES x race interaction + covariates.
Robustness: Firth penalized logistic, stratified per-race slopes, minimal adjustment, probit link.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.formula.api import logit, probit
from scipy.optimize import minimize
from scipy import stats
import warnings
warnings.filterwarnings("ignore")

pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 30)

# ------------------------------------------------------------------ load
df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)

def z(s): return (s - s.mean()) / s.std(ddof=1)
df["SES_z"] = z(df["SES"])
df["ABILITY_z"] = z(df["ABILITY: COMPOSITE OF ASVAB SCORE"])
df["PERCENTILE_z"] = z(df["PERCENTILE IN CLASS"])
df["FAMSIZ_z"] = z(df["FAMILY SIZE OF SAMPLE"])
df["Male"] = (df["SAMPLE_SEX"] == "Male").astype(int)
df["Black"] = (df["SAMPLE_RACE"] == "Black").astype(int)
df["Hispanic"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)

print("n =", len(df), " events(BA=1) =", int(df["BA"].sum()),
      " rate =", round(df["BA"].mean()*100, 3), "%")
print("Events by race:")
print(df.groupby("SAMPLE_RACE")["BA"].agg(["count", "sum", "mean"]).round(4))

def fmt(coef, se):
    orv = np.exp(coef); lo = np.exp(coef - 1.96*se); hi = np.exp(coef + 1.96*se)
    return f"beta={coef:+.3f}  OR={orv:.3f}  95%CI[{lo:.3f},{hi:.3f}]"

def lincomb(res, terms):
    p = res.params; c = res.cov_params()
    est = sum(p[t] for t in terms)
    var = sum(c.loc[a, b] for a in terms for b in terms)
    return est, np.sqrt(var)

# ================================================================== PRIMARY
print("\n" + "="*72)
print("PRIMARY MODEL: logistic, SES_z x race interaction + covariates")
print("="*72)
full = logit("BA ~ SES_z*(Black+Hispanic) + ABILITY_z + PERCENTILE_z + Male + FAMSIZ_z", data=df).fit()
null = logit("BA ~ SES_z + Black + Hispanic + ABILITY_z + PERCENTILE_z + Male + FAMSIZ_z", data=df).fit()
print(full.summary())

lr = 2*(full.llf - null.llf); dfdiff = len(full.params) - len(null.params)
p_int = 1 - stats.chi2.cdf(lr, dfdiff)
print(f"\nJOINT INTERACTION TEST (SES x race): LR={lr:.3f}, df={dfdiff}, p={p_int:.5f}")

print("\nPER-RACE MARGINAL SES EFFECT (adjusted, per +1 SD SES):")
for race, terms in [("White", ["SES_z"]), ("Black", ["SES_z","SES_z:Black"]),
                    ("Hispanic", ["SES_z","SES_z:Hispanic"])]:
    est, se = lincomb(full, terms)
    zstat = est/se; pv = 2*(1-stats.norm.cdf(abs(zstat)))
    print(f"  {race:9s}: {fmt(est, se)}  z={zstat:+.2f}  p={pv:.4f}")

# ================================================================== MINIMAL ADJ
print("\n" + "="*72)
print("SENSITIVITY: minimal adjustment (SES_z x race, no other covariates)")
print("="*72)
minfull = logit("BA ~ SES_z*(Black+Hispanic)", data=df).fit()
minnull = logit("BA ~ SES_z + Black + Hispanic", data=df).fit()
lr_m = 2*(minfull.llf - minnull.llf); dfm = len(minfull.params)-len(minnull.params)
p_m = 1 - stats.chi2.cdf(lr_m, dfm)
print(f"JOINT INTERACTION (minimal): LR={lr_m:.3f}, df={dfm}, p={p_m:.5f}")
for race, terms in [("White", ["SES_z"]), ("Black", ["SES_z","SES_z:Black"]),
                    ("Hispanic", ["SES_z","SES_z:Hispanic"])]:
    est, se = lincomb(minfull, terms)
    print(f"  {race:9s}: {fmt(est, se)}")

# ================================================================== STRATIFIED
print("\n" + "="*72)
print("STRATIFIED MODELS: SES_z -> BA within each race (covariates adjusted)")
print("="*72)
strat = {}
for race in ["White", "Black", "Hispanic"]:
    sub = df[df["SAMPLE_RACE"] == race]
    m = logit("BA ~ SES_z + ABILITY_z + PERCENTILE_z + Male + FAMSIZ_z", data=sub).fit()
    b = m.params["SES_z"]; se = m.bse["SES_z"]
    pv = 2*(1-stats.norm.cdf(abs(b/se)))
    strat[race] = (b, se)
    print(f"  {race:9s} (n={len(sub)}, events={int(sub['BA'].sum())}): {fmt(b, se)}  p={pv:.4f}")

def slope_diff(a, b):
    ba, sea = strat[a]; bb, seb = strat[b]
    d = ba - bb; sd = np.sqrt(sea**2 + seb**2); zz = d/sd
    return d, sd, zz, 2*(1-stats.norm.cdf(abs(zz)))
for a, b in [("Black","White"), ("Hispanic","White"), ("Black","Hispanic")]:
    d, sd, zz, p = slope_diff(a, b)
    print(f"  slope {a} - {b}: diff={d:+.4f} (per SD SES), z={zz:+.2f}, p={p:.4f}")

# ================================================================== PROBIT
print("\n" + "="*72)
print("ROBUSTNESS: probit link, same full model")
print("="*72)
pf = probit("BA ~ SES_z*(Black+Hispanic) + ABILITY_z + PERCENTILE_z + Male + FAMSIZ_z", data=df).fit()
pn = probit("BA ~ SES_z + Black + Hispanic + ABILITY_z + PERCENTILE_z + Male + FAMSIZ_z", data=df).fit()
lr_p = 2*(pf.llf - pn.llf); dfp = len(pf.params)-len(pn.params)
p_pp = 1 - stats.chi2.cdf(lr_p, dfp)
print(f"JOINT INTERACTION (probit): LR={lr_p:.3f}, df={dfp}, p={p_pp:.5f}")
for race, terms in [("White", ["SES_z"]), ("Black", ["SES_z","SES_z:Black"]),
                    ("Hispanic", ["SES_z","SES_z:Hispanic"])]:
    est, se = lincomb(pf, terms)
    print(f"  {race:9s}: beta={est:+.3f} (probit scale)")

# ================================================================== FIRTH
print("\n" + "="*72)
print("ROBUSTNESS: Firth penalized logistic (full interaction model)")
print("="*72)
colmap = ["const","SES_z","Black","Hispanic","SES_z:Black","SES_z:Hispanic",
          "ABILITY_z","PERCENTILE_z","Male","FAMSIZ_z"]
Xb = np.column_stack([np.ones(len(df)), df["SES_z"].values, df["Black"].values,
                      df["Hispanic"].values, (df["SES_z"]*df["Black"]).values,
                      (df["SES_z"]*df["Hispanic"]).values, df["ABILITY_z"].values,
                      df["PERCENTILE_z"].values, df["Male"].values, df["FAMSIZ_z"].values])
yv = df["BA"].values
def firth_nll(b):
    p = 1/(1+np.exp(-Xb @ b)); p = np.clip(p, 1e-12, 1-1e-12)
    ll = np.sum(yv*np.log(p) + (1-yv)*np.log(1-p))
    w = p*(1-p); XWX = Xb.T @ (w[:,None]*Xb)
    sign, logdet = np.linalg.slogdet(XWX)
    return 1e10 if sign <= 0 else -(ll + 0.5*logdet)
res = minimize(firth_nll, x0=np.zeros(len(colmap)), method="BFGS",
               options=dict(maxiter=20000, gtol=1e-12))
bf = res.x
def num_hess(f, x, eps=1e-5):
    n = len(x); H = np.zeros((n, n)); f0 = f(x)
    for i in range(n):
        for j in range(i, n):
            if i == j:
                xp = x.copy(); xp[i] += eps; xm = x.copy(); xm[i] -= eps
                H[i,j] = (f(xp) - 2*f0 + f(xm))/eps**2
            else:
                pp = x.copy(); pp[i]+=eps; pp[j]+=eps
                pm = x.copy(); pm[i]+=eps; pm[j]-=eps
                mp = x.copy(); mp[i]-=eps; mp[j]+=eps
                mm = x.copy(); mm[i]-=eps; mm[j]-=eps
                H[i,j] = (f(pp)-f(pm)-f(mp)+f(mm))/(4*eps**2)
            H[j,i] = H[i,j]
    return H
H = num_hess(firth_nll, bf)
V = np.linalg.inv(H); se_f = np.sqrt(np.clip(np.diag(V), 0, None))
print("Firth estimates (per +1 SD SES terms):")
for i, c in enumerate(colmap):
    print(f"  {c:14s}: {bf[i]:+.4f}  (SE {se_f[i]:.4f})")
print("MARGINAL per-race SES effect (Firth):")
for race, idx in [("White",[1]), ("Black",[1,4]), ("Hispanic",[1,5])]:
    est = sum(bf[i] for i in idx)
    se = np.sqrt(sum(V[i,j] for i in idx for j in idx))
    print(f"  {race:9s}: {fmt(est, se)}")

print("\nDONE.")
