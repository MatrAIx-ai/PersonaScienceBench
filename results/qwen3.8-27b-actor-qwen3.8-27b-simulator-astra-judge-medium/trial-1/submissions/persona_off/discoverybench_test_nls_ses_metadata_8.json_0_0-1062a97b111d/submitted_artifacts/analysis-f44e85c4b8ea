"""
DiscoveryBench: 'factor' of BA degree completion = -0.9568
Identify the pair of races whose factor (log-odds coefficient) is closest to -0.9568
when compared to the third race.

Data: data/nls_ses_processed.csv
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

TARGET = -0.9568
RACES = ["White", "Black", "Hispanic"]

# ---------------------------------------------------------------- load / prep
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["SEX"] = (df["SAMPLE_SEX"] == "Male").astype(float)
y = df["BA"].values
n = len(df)

print("=" * 70)
print("DATA OVERVIEW")
print("=" * 70)
print("rows x cols:", df.shape, " missing:", int(df.isna().sum().sum()))
ct = pd.crosstab(df["SAMPLE_RACE"], df["BA"], margins=True)
print(ct.to_string())
print("\nBA rate by race:")
print(df.groupby("SAMPLE_RACE")["BA"].agg(["count", "sum", "mean"]).round(4).to_string())

# ---------------------------------------------------------------- Firth (bias-reduced logit)
def firth(X, y, tol=1e-10, maxit=5000):
    n, p = X.shape
    beta = np.zeros(p)
    it = 0
    for it in range(maxit):
        p_ = np.clip(1 / (1 + np.exp(-X @ beta)), 1e-12, 1 - 1e-12)
        w = p_ * (1 - p_)
        I = X.T @ (w[:, None] * X)
        U = X.T @ (y - p_)
        Iinv = np.linalg.pinv(I)
        h = np.diag(X @ Iinv @ X.T)          # leverages
        Up = U + 0.5 * (X.T @ (w * h))        # Firth modified score
        step = np.linalg.pinv(I) @ Up
        beta = beta + step
        if np.max(np.abs(step)) < tol:
            break
    return beta, it

def mlogit(X, y):
    return sm.Logit(y, X).fit(disp=0, maxiter=1000).params, None

# ---------------------------------------------------------------- (1) two-races-vs-third
print("\n" + "=" * 70)
print("(1) TWO-RACES-VS-THIRD LOGISTIC MODELS  (factor = log-odds of the PAIR vs the third)")
print("=" * 70)
pair_results = {}
for third in RACES:
    pair = [r for r in RACES if r != third]
    # code: third=1, pair=0  ->  factor (pair vs third) = -coef_third
    z = np.column_stack([np.ones(n), (df["SAMPLE_RACE"] == third).astype(int).values])
    try:
        pm, _ = mlogit(z, y); mle = -pm[1]
    except Exception:
        mle = np.nan
    fb, _ = firth(z, y); firthv = -fb[1]
    pair_results[(tuple(pair), third)] = (mle, firthv)
    print("pair %-22s vs %-9s  MLE=%+.5f  Firth=%+.5f  |diff MLE|=%.5f"
          % ("+".join(pair), third, mle, firthv, abs(mle - TARGET)))

# ---------------------------------------------------------------- (2) three pairwise contrasts
print("\n" + "=" * 70)
print("(2) THREE PAIRWISE CONTRASTS (3-group reference-coded logistic)")
print("=" * 70)
for ref in RACES:
    d = pd.get_dummies(df["SAMPLE_RACE"], drop_first=False).drop(columns=ref).astype(float)
    z = sm.add_constant(np.column_stack([d[c].values for c in d.columns]))
    pm, _ = mlogit(z, y)
    line = "ref=%-9s " % ref
    for c, v in zip(d.columns, pm[1:1 + len(d.columns)]):
        line += "%s vs %s = %+.5f   " % (c, ref, v)
    print(line)

# ---------------------------------------------------------------- (3) confirm closest pairing
print("\n" + "=" * 70)
print("(3) RANKING: which 'pair vs third' factor is closest to %.4f" % TARGET)
print("=" * 70)
rows = []
for (pair, third), (mle, firthv) in pair_results.items():
    rows.append((abs(mle - TARGET), "pair %s vs %s" % ("+".join(pair), third), mle, firthv))
rows.sort()
for d, lab, mle, firthv in rows:
    print("  |diff|=%7.5f  %-28s  MLE=%+.5f  Firth=%+.5f" % (d, lab, mle, firthv))
best = rows[0]
print("\n>>> CLOSEST PAIRING:", best[1], " (MLE %+.5f, Firth %+.5f)" % (best[2], best[3]))

# ---------------------------------------------------------------- (4) sensitivity: covariates
print("\n" + "=" * 70)
print("(4) SENSITIVITY: {Black,Hispanic} vs White, adding covariates (factor = -coef_white)")
print("=" * 70)
covs = ["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS",
        "FAMILY SIZE OF SAMPLE", "SEX"]
from itertools import combinations
def subsets():
    for r in range(0, 6):
        for p in combinations(covs, r):
            yield list(p)
sens = []
for cs in subsets():
    Xcols = [(df["SAMPLE_RACE"] == "White").astype(int).values] + [df[c].values for c in cs]
    z = sm.add_constant(np.column_stack(Xcols))
    try:
        pm, _ = mlogit(z, y); sens.append((abs(-pm[1] - TARGET), -pm[1], cs, "ok"))
    except Exception as e:
        sens.append((np.nan, np.nan, cs, "FAIL(separation)"))
sens.sort(key=lambda t: (np.isnan(t[0]), t[0]))
for d, v, cs, st in sens[:6]:
    print("  covs=%-55s factor=%+.5f  %s" % (str(cs), v, st))
fails = [c for d, v, c, st in sens if st != "ok"]
print("  (# covariate subsets that failed to converge / separation: %d of %d)"
      % (len(fails), len(sens)))

# ---------------------------------------------------------------- FINAL HYPOTHESIS
print("\n" + "=" * 70)
print("FINAL")
print("=" * 70)
hypothesis = (
    "In the NLS dataset, comparing the combined Black and Hispanic groups to White "
    "respondents in a logistic regression of BA DEGREE COMPLETED on SAMPLE_RACE, the "
    "factor (log-odds coefficient) for the Black+Hispanic pair relative to White is about "
    "-0.96 to -0.97 (MLE -0.974; Firth bias-corrected -0.966), i.e. the reported value "
    "-0.9568. This is the only two-races-vs-third pairing whose factor is near -0.9568; "
    "the other groupings ({White,Hispanic} vs Black = -0.876 and {White,Black} vs Hispanic "
    "= -0.722) and the single-race-vs-White contrasts (Black vs White = -1.006, Hispanic vs "
    "White = -0.924) do not match. Thus the two races are Black and Hispanic, compared to "
    "White, and the negative factor means the Black/Hispanic group has lower odds of "
    "completing a BA degree than White respondents."
)
print(hypothesis)

workflow = (
    "Loaded nls_ses_processed.csv (8773 x 8, no missing). Treated 'factor' as the "
    "log-odds coefficient from a logistic regression of the binary outcome BA DEGREE "
    "COMPLETED on race. (1) Fitted the three 'two-races-vs-third' logistic models (pair "
    "combined vs the remaining race) with MLE and Firth bias-corrected estimation. "
    "(2) Fitted the three-group reference-coded model to get the three pairwise log-odds "
    "contrasts. (3) Ranked all 'pair vs third' factors by |value - (-0.9568)|; "
    "{Black,Hispanic} vs White was closest (MLE -0.974, Firth -0.966). (4) Sensitivity: "
    "re-fit the {Black,Hispanic} vs White model across all covariate subsets (SES, ABILITY, "
    "PERCENTILE, FAMILY SIZE, SEX); the unadjusted model is closest to the target, "
    "while adding covariates moves the factor toward 0/positive and makes the race estimates unstable (3-group full-model race coefficients flip sign), supporting a simple unadjusted logistic specification. "
    "Concluded the pair is Black and Hispanic vs White."
)
print("\nWORKFLOW:")
print(workflow)
