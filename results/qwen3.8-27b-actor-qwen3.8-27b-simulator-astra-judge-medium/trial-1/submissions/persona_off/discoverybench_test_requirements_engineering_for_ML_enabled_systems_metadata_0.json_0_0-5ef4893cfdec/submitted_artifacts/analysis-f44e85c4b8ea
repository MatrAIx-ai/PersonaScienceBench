import pandas as pd
import numpy as np
import json

# ============================================================
# Step A: Load data and define analysis population
# ============================================================
df = pd.read_csv("data/requirements_engineering_for_ML-enabled_systems.csv")
print(f"Total rows loaded: {len(df)}")

q8_cols = [c for c in df.columns if c.startswith("Q8_ML_Addressing_") and not c.endswith("_Free")]
role_names = {
    "Q8_ML_Addressing_Project_Lead": "Project Lead",
    "Q8_ML_Addressing_Business_Analyst": "Business Analyst",
    "Q8_ML_Addressing_Requirement_Engineer": "Requirement Engineer",
    "Q8_ML_Addressing_Solution_Architect": "Solution Architect",
    "Q8_ML_Addressing_Data_Scientist": "Data Scientist",
    "Q8_ML_Addressing_Developer": "Developer",
    "Q8_ML_Addressing_Tester": "Tester",
    "Q8_ML_Addressing_Others": "Others"
}

# Exclude -77 (suspended surveys that never reached Q8)
valid = df[df[q8_cols[0]] != "-77"].copy()
n = len(valid)
print(f"Valid respondents (excluding -77): {n}")
print(f"Excluded (-77): {len(df) - n}")

# Verify: all Q8 columns have the same -77 rows
for c in q8_cols:
    assert (valid[c] != "-77").all(), f"Unexpected -77 in {c} after filtering"
print("Verified: no -77 remains in any Q8 column after filtering\n")

# ============================================================
# Step B: Compute point estimates
# ============================================================
print("=" * 70)
print(f"{'Role':<28} {'Quoted':>8} {'Not Quoted':>12} {'Proportion':>12}")
print("=" * 70)

proportions = {}
for c in q8_cols:
    role = role_names[c]
    quoted = int((valid[c] == "quoted").sum())
    not_quoted = int((valid[c] == "not quoted").sum())
    prop = quoted / n
    proportions[role] = prop
    print(f"{role:<28} {quoted:>8} {not_quoted:>12} {prop*100:>11.2f}%")

print("=" * 70)
ranked = sorted(proportions.items(), key=lambda x: x[1], reverse=True)
print(f"\nTop role: {ranked[0][0]} at {ranked[0][1]*100:.2f}%")
print(f"2nd role: {ranked[1][0]} at {ranked[1][1]*100:.2f}%")

# ============================================================
# Step C: Non-parametric bootstrap for 95% CIs
# ============================================================
B = 10000
np.random.seed(42)

# Build binary matrix: rows = respondents, cols = roles
binary = np.zeros((n, len(q8_cols)), dtype=int)
for j, c in enumerate(q8_cols):
    binary[:, j] = (valid[c].values == "quoted").astype(int)

# Bootstrap: resample rows with replacement
boot_props = np.zeros((B, len(q8_cols)))
for b in range(B):
    idx = np.random.randint(0, n, size=n)
    boot_props[b, :] = binary[idx, :].mean(axis=0)

ci_lower = np.percentile(boot_props, 2.5, axis=0)
ci_upper = np.percentile(boot_props, 97.5, axis=0)

print(f"\nBootstrap 95% CIs (B={B:,}, row-level resampling, seed=42):")
print("=" * 70)
print(f"{'Role':<28} {'Prop %':>8} {'CI Lower %':>11} {'CI Upper %':>11}")
print("=" * 70)
for j, c in enumerate(q8_cols):
    role = role_names[c]
    print(f"{role:<28} {proportions[role]*100:>7.2f}% {ci_lower[j]*100:>10.2f}% {ci_upper[j]*100:>10.2f}%")
print("=" * 70)

# ============================================================
# Step D: Identify top two roles and produce final output
# ============================================================
top2 = ranked[:2]
print(f"\n{'='*70}")
print(f"TOP TWO ROLES WITH HIGHEST PROPORTION OF ASSOCIATION")
print(f"{'='*70}")
for i, (role, prop) in enumerate(top2, 1):
    j = list(role_names.values()).index(role)
    print(f"  {i}. {role}: {prop*100:.2f}% (95% CI [{ci_lower[j]*100:.3f}%, {ci_upper[j]*100:.3f}%])")

# Additional diagnostics
print(f"\nDiagnostics:")
print(f"  Total respondents: {len(df)}")
print(f"  Excluded (-77, Suspended): {len(df)-n}")
print(f"  Analysis population: {n}")
print(f"  Bootstrap replicates: {B:,}")
print(f"  Bootstrap method: non-parametric, row-level resampling with replacement")

# Check: 6 suspended respondents with valid Q8 data
suspended_valid = df[(df['Status'] == 'Suspended (22)') & (df[q8_cols[0]] != '-77')]
print(f"  Suspended respondents WITH valid Q8 data (included): {len(suspended_valid)}")

# Others free-text summary
others_quoted = valid[valid['Q8_ML_Addressing_Others'] == 'quoted']
print(f"  'Others' role: {len(others_quoted)} unique free-text entries (each appears once)")

# Save results
results = {
    "total_rows": len(df),
    "excluded_77": len(df) - n,
    "analysis_n": n,
    "bootstrap_B": B,
    "roles": {}
}
for j, c in enumerate(q8_cols):
    role = role_names[c]
    results["roles"][role] = {
        "quoted": int((valid[c] == "quoted").sum()),
        "not_quoted": int((valid[c] == "not quoted").sum()),
        "proportion": round(proportions[role], 6),
        "proportion_pct": round(proportions[role] * 100, 3),
        "ci_lower_pct": round(ci_lower[j] * 100, 3),
        "ci_upper_pct": round(ci_upper[j] * 100, 3),
    }

with open("results.json", "w") as f:
    json.dump(results, f, indent=2)
print(f"\nResults saved to results.json")
