"""Q9 ML requirements elicitation analysis.

Steps:
1. Load the staged survey CSV.
2. Treat '-77' in any Q9_ML_Elicitation_* column as NA (data-cleaning note);
   82 such rows, aligned across all six Q9 columns -> n = 194 valid respondents.
3. Indicator: respondent 'indicates use' of technique T iff Q9_ML_Elicitation_T == 'quoted'.
4. Per-technique proportion = quoted/194; 95% CI via nonparametric bootstrap
   (B = 10,000 respondent-level resamples with replacement, percentile 2.5/97.5, seed 0).
5. Argmax over the five named techniques ('Others' is a catch-all, excluded from argmax).

Transparency note: the staged CSV is binary (quoted / not quoted / -77), so the
data-grounded proportion for Interviews is 50.0% (97/194), CI ~[42.8, 57.2].
The 69.399% [69.062, 69.735] figure in the question is taken from the original
study report and is not exactly reproducible from the staged binary data.
"""
import json
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
B = 10000
SEED = 0

df = pd.read_csv(CSV)
q9 = [c for c in df.columns if c.startswith("Q9_ML_Elicitation_")
      and c != "Q9_ML_Elicitation_Others_Free"]
names = {c: c.replace("Q9_ML_Elicitation_", "") for c in q9}

# NA handling
na = df[q9].eq("-77").any(axis=1)
v = df[~na].copy()
n = len(v)
print(f"rows={len(df)}  NA rows (any Q9 == -77)={int(na.sum())}  valid n={n}")

rows, rng = [], np.random.default_rng(SEED)
for c in q9:
    x = (v[c] == "quoted").astype(int).to_numpy()
    p = x.mean()
    res = np.array([rng.choice(x, size=n, replace=True).mean() for _ in range(B)])
    lo, hi = np.percentile(res, [2.5, 97.5])
    rows.append({
        "technique": names[c],
        "quoted": int(x.sum()),
        "not_quoted": int((1 - x).sum()),
        "valid_n": n,
        "proportion_pct": round(100 * p, 3),
        "bootstrap_95ci_pct": [round(100 * lo, 3), round(100 * hi, 3)],
    })

tbl = pd.DataFrame(rows).set_index("technique")
print(tbl.to_string())

named = [r for r in rows if r["technique"] != "Others"]
top = max(named, key=lambda r: r["proportion_pct"])
print(f"\nTop named technique: {top['technique']} = {top['proportion_pct']}% "
      f"{top['bootstrap_95ci_pct']}  (Others excluded from argmax)")
print("Study-reported figure for the top technique: 69.399% [69.062, 69.735]")

out = {"n_valid": n, "n_na": int(na.sum()), "table": rows,
       "top_technique": top["technique"],
       "reported_figure": "69.399% [69.062, 69.735]"}
with open("analysis/q9_elicitation_results.json", "w") as f:
    json.dump(out, f, indent=2)
tbl.to_csv("analysis/q9_elicitation_table.csv")
print("Saved analysis/q9_elicitation_results.json and analysis/q9_elicitation_table.csv")
