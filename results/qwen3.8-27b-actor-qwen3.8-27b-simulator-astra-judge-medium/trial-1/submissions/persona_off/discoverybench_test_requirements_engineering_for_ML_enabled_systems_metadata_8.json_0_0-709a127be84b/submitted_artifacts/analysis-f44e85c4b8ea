"""
Q10 Documentation-format usage analysis with respondent-level bootstrap.
Data: data/requirements_engineering_for_ML-enabled_systems.csv
- 'quoted'  = respondent indicated the format is used
- 'not quoted' = not used
- '-77'    = missing (survey suspended at Q10 block); excluded
"""
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
SEED = 42
B = 10000

df = pd.read_csv(CSV)
q10 = [c.replace("Q10_ML_Documentation_", "") for c in df.columns
       if c.startswith("Q10_ML_Documentation_") and c != "Q10_ML_Documentation_Others_Free"]

df["is77"] = df["Q10_ML_Documentation_Not_Documented"] == "-77"
valid = df[~df["is77"]].reset_index(drop=True)   # n = 194
n = len(valid)

# binary indicators (1 = 'quoted', 0 = 'not quoted'), -77 rows already dropped
X = np.column_stack([(valid["Q10_ML_Documentation_" + f] == "quoted").to_numpy() for f in q10]).astype(float)

# (a) point estimates on n=194, sensitivity on 276 and 188
p194 = X.mean(axis=0) * 100
p276 = (df["Q10_ML_Documentation_" + q10[0]] != None)  # placeholder
ind276 = np.column_stack([(df["Q10_ML_Documentation_" + f] == "quoted").to_numpy() for f in q10]).astype(float)
p276 = ind276.mean(axis=0) * 100
comp = df[df["Status"].str.startswith("Completed")]
ind188 = np.column_stack([(comp["Q10_ML_Documentation_" + f] == "quoted").to_numpy() for f in q10]).astype(float)
p188 = ind188.mean(axis=0) * 100

# (b) respondent-level nonparametric bootstrap, percentile 95% CI
rng = np.random.default_rng(SEED)
idx = rng.integers(0, n, size=(B, n))
boot = X[idx].mean(axis=1) * 100                      # (B, 12)
lo = np.percentile(boot, 2.5, axis=0)
hi = np.percentile(boot, 97.5, axis=0)

table = pd.DataFrame({
    "format": q10,
    "count_quoted": X.sum(axis=0).astype(int),
    "pct_n194": p194, "ci_lo": lo, "ci_hi": hi,
    "pct_n276": p276, "pct_n188": p188,
})
table = table.sort_values("pct_n194").reset_index(drop=True)
table["rank"] = table.index + 1

pd.set_option("display.width", 200)
print(f"n respondents answering Q10: {n}  (all rows: {len(df)}, completed: {len(comp)})")
print(table.to_string(index=False, float_format=lambda v: f"{v:7.3f}"))

# (c) ranking of the 10 real documentation formats (exclude Not_Documented, Others)
ranked = table[table["format"].isin(
    ["Vision_Document", "Requirements_Lists", "Goal_Models", "Use_Case_Models",
     "Prototypes", "User_Stories", "BDD_Scenarios", "MLCanvas", "Notebooks", "Data_Models"])]
least2 = ranked.head(2)
print("\nTwo least-used documentation formats (of 10, excluding Not_Documented & Others):")
print(least2[["format", "count_quoted", "pct_n194", "ci_lo", "ci_hi"]].to_string(index=False, float_format=lambda v: f"{v:7.3f}"))

# tie check with Others
print("\nOthers catch-all (excluded from ranking):",
      f"{table[table['format']=='Others']['count_quoted'].iloc[0]}/{n} =",
      f"{table[table['format']=='Others']['pct_n194'].iloc[0]:.3f}%")

out = table.to_csv("q10_bootstrap_results.csv", index=False)
print("\nSaved q10_bootstrap_results.csv")
