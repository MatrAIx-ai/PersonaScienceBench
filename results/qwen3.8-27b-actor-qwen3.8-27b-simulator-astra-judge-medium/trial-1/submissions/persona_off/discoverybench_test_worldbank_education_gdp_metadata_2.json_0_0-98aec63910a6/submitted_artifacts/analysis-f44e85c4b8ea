import pandas as pd, numpy as np
import statsmodels.api as sm

df = pd.read_csv('data/worldbank_education_gdp.csv')
year_cols = [c for c in df.columns if c.startswith(('19','20'))]
years = [int(c.split(' ')[0]) for c in year_cols]

# ---- reshape long -> wide panel: one row per (unit, year), col per series ----
def series(code, scode):
    r = df[(df['Country Code']==code)&(df['Series Code']==scode)].iloc[0]
    return pd.Series([float(v) if str(v).strip()!='' else np.nan for v in r[year_cols]], index=years)

panel = pd.DataFrame(index=years)
for code,name in [('LMC','LMC'),('SSF','SSF')]:
    panel[f'logGDP_{code}']  = np.log(series(code,'NY.GNP.PCAP.KD'))
    panel[f'edu_{code}']     = series(code,'NY.ADJ.AEDU.GN.ZS')
    panel[f'prim_{code}']    = series(code,'SE.PRM.ENRR')
    panel[f'sec_{code}']     = series(code,'SE.SEC.ENRR')
    panel[f'exp_{code}']     = series(code,'NE.EXP.GNFS.KD.ZG')
    panel[f'labor_{code}']   = series(code,'SL.TLF.CACT.ZS')

print("=== WIDE PANEL (sample rows) ===")
print(panel.loc[[1975,1990,2000,2010,2011,2015]].round(4).to_string())

# ================= LMC ESTIMATION =================
lm = panel.dropna(subset=['logGDP_LMC']).copy()
lm['dlogGDP'] = lm['logGDP_LMC'].diff()
lm['dedu']    = lm['edu_LMC'].diff()
lm['dprim']   = lm['prim_LMC'].diff()
lm['dsec']    = lm['sec_LMC'].diff()
lm['dlabor']  = lm['labor_LMC'].diff()
lm['L_logGDP']= lm['logGDP_LMC'].shift(1)
lm['L_edu']   = lm['edu_LMC'].shift(1)

# controls availability
lm['has_labor'] = lm['labor_LMC'].notna()

def run(x, y, label):
    X = sm.add_constant(x)
    m = sm.OLS(y, X).fit(cov_type='HAC', cov_kwds={'maxlags':4})
    print(f"\n--- {label} (n={int(m.nobs)}) R2={m.rsquared:.3f} ---")
    for n in m.params.index:
        if n=='const': continue
        print(f"   {n:10s} coef={m.params[n]:+.4f}  se={m.bse[n]:.4f}  p={m.pvalues[n]:.4f}")
    return m

# Spec A1: log-levels dynamic, all controls incl labor
a1 = lm.dropna(subset=['L_logGDP','L_edu','exp_LMC','prim_LMC','sec_LMC','labor_LMC'])
x1 = a1[['L_logGDP','L_edu','prim_LMC','sec_LMC','exp_LMC','labor_LMC']]
run(x1, a1['logGDP_LMC'], "A1 log-levels dynamic + labor")

# Spec A2: log-levels dynamic, no labor (full window)
a2 = lm.dropna(subset=['L_logGDP','L_edu','exp_LMC','prim_LMC','sec_LMC'])
x2 = a2[['L_logGDP','L_edu','prim_LMC','sec_LMC','exp_LMC']]
run(x2, a2['logGDP_LMC'], "A2 log-levels dynamic (no labor)")

# Spec B1: first-differences, all controls incl dlabor
b1 = lm.dropna(subset=['dlogGDP','dedu','dprim','dsec','dlabor','exp_LMC'])
x3 = b1[['dedu','dprim','dsec','exp_LMC','dlabor']]
run(x3, b1['dlogGDP'], "B1 first-differences + labor")

# Spec B2: first-differences, no labor
b2 = lm.dropna(subset=['dlogGDP','dedu','dprim','dsec','exp_LMC'])
x4 = b2[['dedu','dprim','dsec','exp_LMC']]
run(x4, b2['dlogGDP'], "B2 first-differences (no labor)")

# ================= SSA 5-YEAR DESCRIPTIVE =================
ss = panel.dropna(subset=['logGDP_SSF'])
print("\n=== SSA 5-YEAR (2011-2015) DESCRIPTIVE CO-MOVEMENT ===")
ss_show = ss[['edu_SSF','logGDP_SSF']].copy()
ss_show['GNI'] = np.exp(ss_show['logGDP_SSF'])
print(ss_show.round(4).to_string())
corr = ss_show['edu_SSF'].corr(ss_show['logGDP_SSF'])
print(f"\nSSA Pearson corr(edu, logGNI) over 5 yrs = {corr:+.3f}")
print(f"SSA edu: {ss_show['edu_SSF'].iloc[0]:.3f} -> {ss_show['edu_SSF'].iloc[-1]:.3f} "
      f"(delta {ss_show['edu_SSF'].diff().sum():+.3f} pp)")
print(f"SSA GNI: {np.exp(ss_show['logGDP_SSF'].iloc[0]):.1f} -> {np.exp(ss_show['logGDP_SSF'].iloc[-1]):.1f} "
      f"(delta {np.exp(ss_show['logGDP_SSF'].iloc[-1])-np.exp(ss_show['logGDP_SSF'].iloc[0]):+.1f} US$)")
# simple OLS slope (descriptive only)
sm_ols = sm.OLS(ss_show['logGDP_SSF'], sm.add_constant(ss_show['edu_SSF'])).fit()
print(f"SSA simple OLS slope (logGNI on edu, 5 obs) = {sm_ols.params['edu_SSF']:+.4f} (p={sm_ols.pvalues['edu_SSF']:.3f}) -- NOT reliable, n=5")

# LMC context
print("\n=== LMC CONTEXT ===")
print(f"LMC GNI: {np.exp(lm['logGDP_LMC'].iloc[0]):.1f} (1975) -> {np.exp(lm['logGDP_LMC'].iloc[-1]):.1f} (2015)")
ev = lm['edu_LMC'].dropna()
print(f"LMC edu: min={ev.min():.3f} max={ev.max():.3f} mean={ev.mean():.3f} (range {ev.max()-ev.min():.3f} pp over 41 yrs)")
