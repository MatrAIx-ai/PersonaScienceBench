import pandas as pd, numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_bmi_processed.csv')
n_full = len(df)

# Center AGE at mean to reduce collinearity
mu = df.AGE.mean()
df['AGE_c'] = df.AGE - mu
df['AGE2_c'] = df.AGE_c**2

def fit(formula, data, label):
    m = smf.logit(formula, data=data).fit(cov_type='HC1')
    print(f"--- {label} (n={len(data)}) ---")
    print(m.summary())
    print("Odds ratios:")
    print((np.exp(m.params)).round(4))
    print()
    return m

# 1) Main: centered quadratic logit, full sample
m_main = fit('DISSAVED ~ AGE_c + AGE2_c', df, 'MAIN: quadratic, full sample, HC1')

# 2) Restricted: SAMESAVE == 0
d0 = df[df.SAMESAVE == 0]
m_res = fit('DISSAVED ~ AGE_c + AGE2_c', d0, 'RESTRICTED: quadratic, SAMESAVE=0, HC1')

# 3) Linear-only, full sample
m_lin = fit('DISSAVED ~ AGE_c', df, 'LINEAR-ONLY, full sample, HC1')

# 4) + INCOME control (log1p), full sample
df['LOGINC'] = np.log1p(df.INCOME)
m_inc = fit('DISSAVED ~ AGE_c + AGE2_c + LOGINC', df, 'QUADRATIC + log(INCOME), full sample, HC1')

# 5) Drop exact duplicates
du = df.drop_duplicates()
m_dedup = fit('DISSAVED ~ AGE_c + AGE2_c', du, 'QUADRATIC, duplicates dropped, HC1')

# 6) + GENDER control
df['FEMALE'] = (df.GENDER == 'FEMALE').astype(int)
m_gen = fit('DISSAVED ~ AGE_c + AGE2_c + FEMALE + LOGINC', df, 'QUADRATIC + gender + log(INCOME), full sample, HC1')

print("\nDescriptive DISSAVED rate by AGE (full sample):")
print(df.groupby('AGE').DISSAVED.agg(['mean','count']).round(4))
print("\nDescriptive DISSAVED rate by AGE (SAMESAVE=0):")
print(d0.groupby('AGE').DISSAVED.agg(['mean','count']).round(4))

# Predicted probabilities at ages 24, 28, 32 from main model
for age in [24, 28, 32]:
    x = pd.DataFrame({'AGE_c':[age-mu],'AGE2_c':[(age-mu)**2]})
    p_full = m_main.predict(x)[0]
    p_res  = m_res.predict(x)[0]
    print(f"age {age}: P(DISSAVED) main={p_full:.4f}, restricted={p_res:.4f}")
