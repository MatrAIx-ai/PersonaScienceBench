#!/usr/bin/env python
"""
NLSY79: Is increased time preference (present-biased savings flow, 1985-89)
associated with higher BMI?

Data: data/nls_raw.csv (N=12,686)
Unit corrections (evidence-based, see inspection notes):
  - Weights are POUNDS (doc says kg); convert /2.2046226218 to kg.
  - Height 1985 is clean INCHES; used as the height denominator for ALL BMI.
  - Height 1981 is not in inches (range 400-611, clustered, 600-spike) -> NOT used.
Time preference proxy: 1989 savings-flow categorical (1985->1989 window),
  ordinal present-bias score: PUT IN=0, NO CHANGE=1, TOOK OUT=2, NO SAVINGS=3.
"""
import pandas as pd, numpy as np
import statsmodels.formula.api as smf
from statsmodels.miscmodels.ordinal_model import OrderedModel
import warnings; warnings.filterwarnings('ignore')

pd.set_option('display.width', 250)
df = pd.read_csv('data/nls_raw.csv')
LB, IN = 2.2046226218, 39.3701

# ---------- build variables ----------
h_m   = df['Height of respondent, 1985'] / IN
def bmi(wcol): return (df[wcol] / LB) / h_m**2
bmi81_r, bmi89_r, bmi92_r = bmi('Weight of respondent, 1981'), bmi('Weight of respondent, 1989'), bmi('Weight of respondent, 1992')

# winsorize 1-99 pct (computed on non-missing)
def wins(s, lo=.01, hi=.99):
    a, b = s.quantile(lo), s.quantile(hi)
    return s.clip(a, b)
bmi81_w, bmi89_w, bmi92_w = wins(bmi81_r), wins(bmi89_r), wins(bmi92_r)
bmi81_t = bmi81_r.clip(12, 45); bmi89_t = bmi89_r.clip(12, 45); bmi92_t = bmi92_r.clip(12, 45)

cat = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
tp_score = cat.map({1.0:0, 3.0:1, 2.0:2, 4.0:3}).astype(float)     # present-bias 0..3
tp_high  = cat.isin([2.0, 4.0]).astype(float)                      # high TP = {took out, no savings}

# covariates
age81 = df['Age of respondent at interview date, 1981']
age81_i = age81.fillna(age81.mean())
male  = (df['Sex of respondent, 1979'] == 1).astype(float)
race  = df['Racial/ethnic cohort, 1979']
black = (race == 1).astype(float); hisp = (race == 2).astype(float)
inc = df['Total net family income, previous calendar year, 1985'].fillna(
       df['Total net family income, previous calendar year, 1979'])
log_inc = np.log1p(inc.clip(lower=0)).fillna(np.log1p(inc.clip(lower=0)).mean())
w85 = df['Family net wealth, 1985'].clip(upper=df['Family net wealth, 1985'].quantile(.99))
log_wealth = np.log1p(w85.clip(lower=0))
log_wealth = log_wealth.fillna(log_wealth.mean())
grade = df['Highest grade completed, 1979'].fillna(df['Highest grade completed, 1979'].mean())
asv = df[['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981','ASVAB - Word Knowledge Z Score (rounded), 1981',
          'ASVAB - Paragraph Comprehension Z Score (rounded), 1981','ASVAB - Mathematics Knowledge Z Score (rounded), 1981']].mean(axis=1)
asv_i = asv.fillna(asv.mean())
jail = pd.Series(False, index=df.index)
for yr in [1985,1986,1987,1988,1989]:
    jail |= (df[f'Type of residence respondent is living in, {yr}'] == 5)
jail = jail.astype(float)

covs = 'age81i + male + black + hisp + log_inc + log_wealth + grade + asv + jail'
D = pd.DataFrame({
    'bmi81': bmi81_w, 'bmi89': bmi89_w, 'bmi92': bmi92_w,
    'bmi81_r': bmi81_r, 'bmi89_r': bmi89_r, 'bmi92_r': bmi92_r,
    'bmi81_t': bmi81_t, 'bmi89_t': bmi89_t, 'bmi92_t': bmi92_t,
    'dbmi': bmi89_w - bmi81_w,
    'tp_score': tp_score, 'tp_high': tp_high, 'cat': cat,
    'd_tookout': (cat==2).astype(float), 'd_nochg': (cat==3).astype(float), 'd_nosav': (cat==4).astype(float),
    'age81i': age81_i, 'male': male, 'black': black, 'hisp': hisp,
    'log_inc': log_inc, 'log_wealth': log_wealth, 'grade': grade, 'asv': asv_i, 'jail': jail,
    'age81_raw': age81, 'inc_raw': inc, 'w85_raw': df['Family net wealth, 1985'],
    'grade_raw': df['Highest grade completed, 1979'], 'asv_raw': asv,
})
# obesity category (winsorized bmi89)
D['obes'] = pd.cut(D['bmi89'], [-np.inf, 25, 30, np.inf], labels=[0,1,2]).astype(float)
# net saving flow (secondary): log1p(put) for cat1, -log1p(take) for cat2
put  = np.log1p(df['Net amount respondent/spouse put into savings since last interview, 1989'].fillna(0).clip(lower=0))
take = np.log1p(df['Net amount respondent/spouse took out of savings since last interview, 1989'].fillna(0).clip(lower=0))
netflow = pd.Series(np.where(cat==1, put, np.where(cat==2, -take, np.nan)))
netflow = wins(netflow)
D['netflow'] = netflow

out = []
def report(tag, res, key, n=None):
    p = res.params[key]; lo, hi = res.conf_int().loc[key]
    r2 = res.rsquared if hasattr(res, 'rsquared') else np.nan
    out.append((tag, key, p, lo, hi, n if n else int(res.nobs), r2))
    print(f"{tag:58s} {key:10s} coef={p:+.3f}  95%CI [{lo:+.3f}, {hi:+.3f}]  n={n if n else int(res.nobs)}  R2={r2:.3f}")
    return res

print("="*130)
print("SAMPLE SIZES")
print(f"  tp_score present: {D['tp_score'].notna().sum()}")
print(f"  + bmi89: {(D['tp_score'].notna() & D['bmi89'].notna()).sum()}")
print(f"  + bmi92: {(D['tp_score'].notna() & D['bmi92'].notna()).sum()}")
print(f"  + bmi81 & bmi89 (delta): {(D['tp_score'].notna() & D['dbmi'].notna()).sum()}")
print(f"  netflow subsample (cat 1/2 with amounts): {D['netflow'].notna().sum()}")
print(f"  jail85-89: {int(D['jail'].sum())}")

print("="*130)
print("RAW (UNADJUSTED) MEANS BY SAVINGS CATEGORY  [1=PUT IN, 2=TOOK OUT, 3=NO CHANGE, 4=NO SAVINGS]")
for b in ['bmi81','bmi89','bmi92']:
    t = D[D['cat'].notna()].groupby('cat')[b].agg(n='count', mean='mean', sd='std').round(2)
    t.index = ['1 PUT IN','2 TOOK OUT','3 NO CHANGE','4 NO SAVINGS']
    print(f"\n{b}:\n{t.to_string()}")
t = D[D['cat'].notna()].groupby('tp_score')[['bmi81','bmi89','bmi92']].mean().round(2)
t.index = ['TP=0 PUT IN','TP=1 NO CHANGE','TP=2 TOOK OUT','TP=3 NO SAVINGS']
print("\nBy TP score:\n", t.to_string())

print("="*130)
print("PRIMARY MODELS  (OLS, HC1 robust SEs, covariates: age81, sex, race, log income, log wealth,")
print("grade, ASVAB, incarceration 1985-89; covariates mean-imputed)")
m1 = smf.ols('bmi89 ~ tp_score + ' + covs, data=D).fit(cov_type='HC1')
report("PRIMARY: BMI_1989 ~ TP score (per +1 present-bias point)", m1, 'tp_score')
Dcat = D[D['cat'].notna()]
m2 = smf.ols('bmi89 ~ tp_high + ' + covs, data=Dcat).fit(cov_type='HC1')
report("PRIMARY: BMI_1989 ~ High TP {took out, no savings}", m2, 'tp_high')
m3 = smf.ols('bmi89 ~ d_tookout + d_nochg + d_nosav + ' + covs, data=Dcat).fit(cov_type='HC1')
for k in ['d_tookout','d_nochg','d_nosav']:
    report(f"4-dummy vs PUT IN: {k}", m3, k)
print(f"  (4-dummy model n={int(m3.nobs)}, R2={m3.rsquared:.3f})")

print("="*130)
print("SECONDARY OUTCOMES")
m4 = smf.ols('bmi92 ~ tp_score + ' + covs, data=D).fit(cov_type='HC1')
report("BMI_1992 ~ TP score", m4, 'tp_score')
m5 = smf.ols('dbmi ~ tp_score + bmi81 + ' + covs, data=Dcat).fit(cov_type='HC1')
report("DELTA BMI 81->89 ~ TP score (+baseline BMI)", m5, 'tp_score')
m6 = smf.ols('dbmi ~ tp_high + bmi81 + ' + covs, data=Dcat).fit(cov_type='HC1')
report("DELTA BMI 81->89 ~ High TP (+baseline BMI)", m6, 'tp_high')
m0 = smf.ols('bmi89 ~ tp_score', data=D).fit()
report("UNADJUSTED: BMI_1989 ~ TP score (for raw-vs-adj compare)", m0, 'tp_score')

print("="*130)
print("ROBUSTNESS")
# R1 drop NO SAVINGS
D1 = D[D['cat'] != 4]
r1 = smf.ols('bmi89 ~ tp_score + ' + covs, data=D1).fit(cov_type='HC1')
report("R1 drop NO SAVINGS: BMI_1989 ~ TP score (0-2)", r1, 'tp_score')
# R2 sex-stratified
for s, lab in [(1,'MALES'),(0,'FEMALES')]:
    rs = smf.ols('bmi89 ~ tp_score + ' + covs.replace('male + ',''), data=D[D['male']==s]).fit(cov_type='HC1')
    report(f"R2 sex-stratified {lab}: BMI_1989 ~ TP score", rs, 'tp_score')
# R3 winsorization sensitivity
r3a = smf.ols('bmi89_r ~ tp_score + ' + covs, data=D).fit(cov_type='HC1')
report("R3a no winsorization: BMI_1989 ~ TP score", r3a, 'tp_score')
r3b = smf.ols('bmi89_t ~ tp_score + ' + covs, data=D).fit(cov_type='HC1')
report("R3b trim BMI to [12,45]: BMI_1989 ~ TP score", r3b, 'tp_score')
# R4 ordered logit on obesity category
subr = D.dropna(subset=['obes','tp_score'])
om = OrderedModel(subr['obes'], subr[['tp_score']+covs.split(' + ')], distr='logit').fit(disp=0)
pv = om.params['tp_score']
from scipy.stats import t as tdist
ci = tdist.ppf(.975, om.nobs - len(om.params)) * om.bse['tp_score']
report("R4 ordered logit: obesity cat (0/1/2) ~ TP score", om, 'tp_score', n=int(om.nobs))
print(f"   (log-odds shift per +1 TP point; OR={np.exp(pv):.3f})")
# R5 listwise deletion (no imputation)
D5 = D.dropna(subset=['age81_raw','inc_raw','w85_raw','grade_raw','asv_raw'])
D5 = D5.assign(log_inc=np.log1p(D5['inc_raw'].clip(lower=0)),
               log_wealth=np.log1p(D5['w85_raw'].clip(upper=D5['w85_raw'].quantile(.99)).clip(lower=0)),
               age81i=D5['age81_raw'], grade=D5['grade_raw'], asv=D5['asv_raw'])
r5 = smf.ols('bmi89 ~ tp_score + ' + covs, data=D5).fit(cov_type='HC1')
report("R5 listwise deletion (no imputation)", r5, 'tp_score')
# R6 continuous net saving flow
D6 = D[D['netflow'].notna()]
r6 = smf.ols('bmi89 ~ netflow + ' + covs, data=D6).fit(cov_type='HC1')
report("R6 net saving flow (log$, cat 1/2 subsample): BMI_1989 ~ netflow", r6, 'netflow')
print(f"   (subsample: {int((D6['cat']==1).sum())} put-in / {int((D6['cat']==2).sum())} took-out)")

# adjusted means at TP=0 vs TP=3 (from m1)
X0 = D.loc[D['tp_score'].notna() & D['bmi89'].notna()].mean(numeric_only=True)
adj0 = m1.params['Intercept'] + m1.params['tp_score']*0 + sum(m1.params[c]*X0[c] for c in covs.split(' + '))
adj3 = adj0 + 3*m1.params['tp_score']
raw0 = D.loc[D['tp_score']==0,'bmi89'].mean(); raw3 = D.loc[D['tp_score']==3,'bmi89'].mean()
print("="*130)
print("RAW vs ADJUSTED (PUT IN vs NO SAVINGS, BMI_1989)")
print(f"  raw mean diff (TP3 - TP0): {raw3-raw0:+.3f}")
print(f"  adjusted diff (3 x per-point coef): {3*m1.params['tp_score']:+.3f}")
print(f"  adjusted means: TP0={adj0:.2f}, TP3={adj3:.2f}")

ext = D[(D['bmi89_r']>45) & D['tp_score'].notna()]
print("="*130)
print(f"DIAGNOSTIC: extreme BMI_1989 (>45, un-winsorized): N={len(ext)}; by TP score:", dict(ext.groupby('tp_score').size()))
m0r = smf.ols('bmi89_r ~ tp_score', data=D).fit()
report("DIAGNOSTIC: UNADJUSTED, no winsorization: BMI_1989 ~ TP score", m0r, 'tp_score')
pd.DataFrame(out, columns=['model','term','coef','ci_lo','ci_hi','n','r2']).to_csv('analysis_results.csv', index=False)
with open('analysis_summary.txt','w') as f:
    f.write("NLSY79 time preference (1989 savings flow) and BMI - full results\n")
    for row in out:
        f.write(f"{row[0]:58s} {row[1]:10s} coef={row[2]:+.3f} 95%CI [{row[3]:+.3f},{row[4]:+.3f}] n={row[5]} R2={row[6]:.3f}\n")
print("\nSaved: analysis_results.csv, analysis_summary.txt")

print("="*130)
print("PRIMARY MODEL COVARIATES (for reference)")
ci = m1.conf_int()
for k in ['tp_score','jail','male','black','hisp','log_inc','log_wealth','age81i','asv','grade']:
    print(f"  {k:10s} coef={m1.params[k]:+.3f}  95%CI [{ci.loc[k,0]:+.3f}, {ci.loc[k,1]:+.3f}]")
