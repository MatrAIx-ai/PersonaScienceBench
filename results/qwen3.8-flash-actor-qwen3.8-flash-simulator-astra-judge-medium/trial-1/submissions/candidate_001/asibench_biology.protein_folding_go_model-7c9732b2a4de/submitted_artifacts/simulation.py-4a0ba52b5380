 "Z": ["11111", "00001", "00010", "00100", "01000", "10000", "11111"],
 ".": ["00000", "00000", "00000", "00000", "00000", "01100", "01100"],
 ",": ["00000", "00000", "00000", "00000", "01100", "00100", "01000"],
 ":": ["00000", "01100", "01100", "00000", "01100", "01100", "00000"],
 "=": ["00000", "00000", "11111", "00000", "11111", "00000", "00000"],
 "-": ["00000", "00000", "00000", "11111", "00000", "00000", "00000"],
 "(": ["00010", "00100", "01000", "01000", "01000", "00100", "00010"],
 ")": ["01000", "00100", "00010", "00010", "00010", "00100", "01000"],
 "*": ["00000", "10101", "01110", "11111", "01110", "10101", "00000"],
 "/": ["00001", "00010", "00010", "00100", "01000", "01000", "10000"],
 "+": ["00000", "00100", "00100", "11111", "00100", "00100", "00000"],
}

def _fallback_figure(path, fin, ref, centers, histQ, temps, T_fine, cv_fine,
                     temps2, cv_dir, T_star, cF, F, q_modes, barrier, jaccard):
    """Dependency-free 4-panel PNG (used only when matplotlib is unavailable)."""
    import struct, zlib
    Wd, Hd = 1400, 1000
    img = np.full((Hd, Wd, 3), 255, np.uint8)
    def px(x, y, c):
        if 0 <= int(y) < Hd and 0 <= int(x) < Wd:
            img[int(y), int(x)] = c
    def line(x0, y0, x1, y1, c):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        while True:
            px(x0, y0, c)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy; x0 += sx
            if e2 <= dx:
                err += dx; y0 += sy
    def circ(x, y, r, c, hollow=False):
        for yy in range(-r, r + 1):
            for xx in range(-r, r + 1):
                d2 = xx * xx + yy * yy
                if hollow and (d2 > r * r or d2 < (r - 1.5) ** 2):
                    continue
                if d2 <= r * r:
                    px(x + xx, y + yy, c)
    def text(x, y, s, sc=2, c=(0, 0, 0)):
        cx = x
        for ch in str(s).upper():
            g = _PNGFONT.get(ch, _PNGFONT[" "])
            for j, row in enumerate(g):
                for i, bit in enumerate(row):
                    if bit == "1":
                        for oy in range(sc):
                            for ox in range(sc):
                                px(cx + i * sc + ox, y + j * sc + oy, c)
            cx += 6 * sc
    def panel(x0, y0, x1, y1, xlab, title):
        line(x0, y1, x1, y1, (0, 0, 0)); line(x0, y0, x0, y1, (0, 0, 0))
        line(x1, y0, x1, y1, (0, 0, 0)); line(x0, y0, x1, y0, (0, 0, 0))
        text(x0 + 8, y0 + 6, title)
        text((x0 + x1) // 2 - 15, y1 - 26, xlab)
    PAL = [(31, 119, 180), (255, 127, 14), (44, 160, 44),
           (214, 39, 40), (148, 103, 189), (140, 86, 75)]
    def curve(xs, ys, bb, c, X0, Y0, X1, Y1, pts=False):
        xa, xb, ya, yb = bb
        pxs = [X0 + (v - xa) / (xb - xa + 1e-30) * (X1 - X0) for v in xs]
        pys = [Y1 - (v - ya) / (yb - ya + 1e-30) * (Y1 - Y0) for v in ys]
        for a in range(len(pxs) - 1):
            line(pxs[a], pys[a], pxs[a + 1], pys[a + 1], c)
        if pts:
            for a in range(len(pxs)):
                circ(pxs[a], pys[a], 4, c)
    X0, Y0, X1, Y1 = 80, 40, 640, 460
    allx = np.concatenate([fin[:, 0], ref[:, 0]])
    ally = np.concatenate([fin[:, 1], ref[:, 1]])
    bx0, bx1 = allx.min() - 1, allx.max() + 1
    by0, by1 = ally.min() - 1, ally.max() + 1
    panel(X0, Y0, X1, Y1, "X",
          "FINAL LOW-T (COLOR) VS REF (HOLLOW) JACCARD=%.2F" % jaccard)
    for a in range(len(ref)):
        circ(X0 + (ref[a, 0] - bx0) / (bx1 - bx0) * (X1 - X0),
             Y1 - (ref[a, 1] - by0) / (by1 - by0) * (Y1 - Y0), 7, (120, 120, 120), True)
    for a in range(len(fin)):
        circ(X0 + (fin[a, 0] - bx0) / (bx1 - bx0) * (X1 - X0),
             Y1 - (fin[a, 1] - by0) / (by1 - by0) * (Y1 - Y0), 7, PAL[a % 6])
    X0, Y0, X1, Y1 = 800, 40, 1360, 460
    panel(X0, Y0, X1, Y1, "Q", "P(Q) BY TEMPERATURE (T LABELS RIGHT)")
    mmax = max(histQ.max() * 1.1, 1e-9)
    for k in range(len(temps)):
        curve(centers, histQ[k], (0, 1, 0, mmax), PAL[k % 6], X0, Y0, X1, Y1)
    for k in range(len(temps)):
        text(X1 - 130, Y0 + 40 + 24 * k, "%.2F" % temps[k], 2, PAL[k % 6])
    X0, Y0, X1, Y1 = 80, 560, 640, 950
    panel(X0, Y0, X1, Y1, "T", "CV REWEIGHTED LINE, DIRECT DOTS, T* DASHED")
    cmax = max(cv_fine.max(), cv_dir.max(), 1e-9) * 1.15
    curve(T_fine, cv_fine, (T_fine.min(), T_fine.max(), 0, cmax), PAL[0], X0, Y0, X1, Y1)
    curve(temps2, cv_dir, (T_fine.min(), T_fine.max(), 0, cmax), PAL[3], X0, Y0, X1, Y1, True)
    xs = X0 + (T_star - T_fine.min()) / (T_fine.max() - T_fine.min()) * (X1 - X0)
    for yy in range(int(Y0), int(Y1), 6):
        line(xs, yy, xs, yy + 3, (214, 39, 40))
    text(xs + 6, Y0 + 40, "T*=%.3F" % T_star, 2, (214, 39, 40))
    X0, Y0, X1, Y1 = 800, 560, 1360, 950
    panel(X0, Y0, X1, Y1, "Q",
          "LANDSCAPE AT T*: MODES " + " ".join("%.2F" % m for m in q_modes) +
          " DF=%.2F KT" % barrier)
    fmax = max(F.max(), 1e-9) * 1.1
    curve(cF, F, (0, 1, 0, fmax), PAL[0], X0, Y0, X1, Y1)
    for m in q_modes:
        xs = X0 + m * (X1 - X0)
        for yy in range(int(Y0), int(Y1), 6):
            line(xs, yy, xs, yy + 3, (44, 160, 44))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    raw = b"".join(b"\x00" + img[r].tobytes() for r in range(Hd))
    png = (b"\x89PNG\r\n\x1a\n" +
           chunk(b"IHDR", struct.pack(">IIBBBBB", Wd, Hd, 8, 2, 0, 0, 0)) +
           chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)

