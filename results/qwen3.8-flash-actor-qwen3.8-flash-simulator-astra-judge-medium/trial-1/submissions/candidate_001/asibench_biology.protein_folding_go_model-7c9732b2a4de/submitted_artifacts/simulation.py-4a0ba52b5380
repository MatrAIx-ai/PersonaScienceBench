    ax4.plot(centers, F, label=f"direct @T={temps[k_star]:.3f}")
    ax4.plot(centers, np.maximum(-np.log(np.maximum(h_rw, 1e-12)) / temps[k_star], 0),
             "--", label="reweighted check")
    for m in q_modes:
