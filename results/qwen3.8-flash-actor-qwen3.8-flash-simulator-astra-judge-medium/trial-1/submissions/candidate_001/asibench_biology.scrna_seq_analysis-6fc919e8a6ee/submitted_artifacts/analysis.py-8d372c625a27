for nm, d in smooth_controls.items():
    log(f"    {nm:34s} held-out R2={d['mean_heldout_R2']:.3f}  max|TF-TF corr|={d['max_abs_TF_TF_corr']:.3f}")
log(f"  -> smoothing scheme fixed a priori: kNN(k={SMOOTH_K}) neighbourhood mean on the marker-PC graph "
    f"(pseudotime-independent, so it cannot manufacture temporal ordering); only lambda is CV-selected")

log(f"edge STRENGTH: ridge on kNN-smoothed (k={SMOOTH_K}) TF profiles + pseudotime (linear+quad) "
    f"covariates; lambda per target by {N_FOLD}-fold held-out R^2 (grid {LAMS.min():.0e}-{LAMS.max():.0e}); "
    f"beta therefore = residual (pseudotime-partialled) association")
B_sm, B_sm_raw, lam_sm, r2_sm = coef_matrix_multi(TFsm, extra)
B_rw, B_rw_raw, lam_rw, r2_rw = coef_matrix_multi(TFraw, extra)
log(f"held-out R^2 (smoothed predictors): mean={r2_sm.mean():.3f} range=[{r2_sm.min():.3f},{r2_sm.max():.3f}]; "
