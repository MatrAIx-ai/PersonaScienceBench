#!/usr/bin/env python3
"""
Single-cell RNA-seq integrated analysis (B3) -- NumPy/SciPy only.

Pipeline (see method_choices.json for per-step methods + justifications):
  QC (flag, never drop) -> CP10K + log1p -> binned-dispersion HVG -> PCA (denoising)
  -> kNN graph (union symmetrisation, adaptive sigma) -> spectral clustering k=4
     (marker-block tie-breaker vs NMF / Ward candidates)
  -> graph geodesic (Dijkstra) pseudotime from peripheral centroid, min-max [0,1]
     (orientation rule = TF-block structure; UNVERIFIED assumption, diagnostics logged)
  -> DE: specificity score (ANOVA F + log2FC + prevalence), per-cluster top markers
     deduped at head, remainder by global F -> all 250 gene indices ranked
  -> GRN (TF x TF, directed): ridge |beta| edge strength on kNN-smoothed profiles
     (pseudotime as covariate) x directionality from pseudotime-LAGGED cross-correlation
     computed on RAW (unsmoothed) profiles. diagonal = 0, clipped, min-max [0,1].

Everything is deterministic (fixed seeds, no unseeded RNG), no cells/genes are removed.
"""
import json
import os
import numpy as np
from scipy.spatial.distance import cdist
from scipy.sparse import csr_matrix
from scipy.sparse.csgraph import connected_components, dijkstra
from scipy.cluster.hierarchy import linkage, fcluster

SEED = 0
K_CANDIDATES_MAX = 5
DATA_DIR = "data"
OUT_DIR = "."
LOG = []


def log(msg=""):
    print(msg, flush=True)
    LOG.append(str(msg))


def spearman(a, b):
    a = np.asarray(a, float); b = np.asarray(b, float)
    ra = np.argsort(np.argsort(a)).astype(float)
    rb = np.argsort(np.argsort(b)).astype(float)
    ra -= ra.mean(); rb -= rb.mean()
    d = np.sqrt((ra ** 2).sum() * (rb ** 2).sum())
    return float((ra * rb).sum() / d) if d > 0 else 0.0


def contingency(lev, lgt):
    lev = np.asarray(lev); lgt = np.asarray(lgt)
    a, b = int(lev.max()) + 1, int(lgt.max()) + 1
    c = np.zeros((a, b))
    np.add.at(c, (lev, lgt), 1.0)
    return c


def ari(lev, lgt):
    c = contingency(lev, lgt); n = c.sum()
    C2 = lambda v: float((v * (v - 1) / 2).sum())
    ai, bj = c.sum(1), c.sum(0)
    nij = C2(c.ravel()); ni, nj = C2(ai), C2(bj)
    exp = ni * nj / (n * (n - 1) / 2) if n > 1 else 0.0
    mean = (ni + nj) / 2.0
    den = mean - exp
    return float((nij - exp) / den) if abs(den) > 1e-12 else 0.0


def nmi(lev, lgt):
    c = contingency(lev, lgt); n = c.sum()
    p = c / n
    pi, pj = p.sum(1, keepdims=True), p.sum(0, keepdims=True)
    with np.errstate(divide="ignore", invalid="ignore"):
        mi = np.nansum(np.where(p > 0, p * np.log(p / (pi * pj)), 0.0))
        hi = float(-np.nansum(np.where(pi > 0, pi * np.log(pi), 0.0)))
        hj = float(-np.nansum(np.where(pj > 0, pj * np.log(pj), 0.0)))
    return float(2 * mi / (hi + hj)) if (hi + hj) > 0 else 0.0


# ---------------------------------------------------------------- load
X = np.asarray(np.load(os.path.join(DATA_DIR, "counts.npy")), dtype=np.float64)
info = json.load(open(os.path.join(DATA_DIR, "system_info.json")))
n_cells, n_genes = X.shape
n_tf = int(info["n_tf_genes"])
tf_idx = np.asarray(info["tf_gene_indices"], dtype=int)
k_clusters = int(info.get("n_clusters", 0)) or 4
log("== 0. INPUT ==")
log(f"counts.npy shape={X.shape} dtype=float64 finite={bool(np.isfinite(X).all())} "
    f"min={X.min():.0f} max={X.max():.0f} integer_valued={bool(np.array_equal(X, np.floor(X)))}")
log(f"metadata: n_cells={info['n_cells']} n_genes={info['n_genes']} n_clusters={k_clusters} "
    f"n_tf_genes={n_tf} tf_gene_indices=[{tf_idx[0]}..{tf_idx[-1]}]")
log(f"NOT provided by metadata (=> assumptions elsewhere): gene names, pseudotime root/anchor, "
    f"DE comparison definition, library-size/ambient/batch metadata")

# ------------------------------------------------- 1. QC (flag, never drop)
log("\n== 1. QC / FILTERING (flags only -- output shape forbids dropping cells) ==")
lib = X.sum(1)
genes_det = (X > 0).sum(1)
med_lib = float(np.median(lib))
lo_lib = np.percentile(lib, 1); lo_det = np.percentile(genes_det, 1)
qc_flag = np.where((lib <= lo_lib) | (genes_det <= lo_det))[0]
log(f"library size: min={lib.min():.0f} p25={np.percentile(lib,25):.0f} med={med_lib:.0f} "
    f"p75={np.percentile(lib,75):.0f} max={lib.max():.0f} CV={lib.std()/lib.mean():.3f}")
log(f"genes/cell: min={genes_det.min()} med={np.median(genes_det):.0f} max={genes_det.max()}; "
    f"global zero fraction={(X==0).mean():.4f}; median count/detected gene={np.median(X[X>0]):.1f}")
log(f"cells flagged as low-quality (kept, reassigned later): n={len(qc_flag)} ids={qc_flag.tolist()}")

# data-driven 'marker-like' high-expression block (metadata: non-TF cols contain cluster markers)
gm = X.mean(0)
pos = np.sort(gm[gm > 0])
cand = np.where(pos[:-1] > 0)[0]   # largest multiplicative gap in the sorted gene-mean spectrum
gi = cand[np.argmax(np.log(pos[cand + 1] / pos[cand]))]
mk_thr = float(np.sqrt(pos[gi] * pos[gi + 1]))
marker_block = np.where(gm > mk_thr)[0]
log(f"gene-magnitude bimodality: gap between {pos[gi]:.2f} and {pos[gi+1]:.2f} counts -> "
    f"threshold={mk_thr:.2f}; high-expression ('marker-like') block: {len(marker_block)} genes "
    f"(remaining {n_genes-len(marker_block)} low-expression incl. the {n_tf} TFs)")

# ------------------------------------------------- 2. normalisation
log("\n== 2. NORMALISATION ==")
cp10k = X / lib[:, None] * 1e4
L = np.log1p(cp10k)
log("CP10K (counts / library_size * 1e4) + log1p  [Luecken & Theis 2019]")

# ------------------------------------------------- 3. HVG
log("\n== 3. HVG SELECTION (binned log-dispersion z-score, Seurat-style) ==")
det_rate = (X > 0).mean(0)
# HVG candidacy = detected in >=5% of cells AND mean count >= 1 count (the gene-magnitude gap shows a
# 170-gene ambient/noise floor at <0.7 mean counts, which is Poisson-noise dominated and must not be
# selected as 'highly variable')
keep_g = (det_rate >= 0.05) & (gm >= 1.0)
mu = L.mean(0); var = L.var(0)
disp = np.log(var + 1e-9)
z = np.zeros(n_genes)
idx = np.argsort(np.where(keep_g, mu, -np.inf))
nbins = 20
usable = idx[keep_g[idx]]
for b in np.array_split(usable, min(nbins, max(1, len(usable) // 5))):
    if len(b) > 2:
        z[b] = (disp[b] - disp[b].mean()) / (disp[b].std(ddof=0) + 1e-12)
n_hvg = int(min(150, max(10, keep_g.sum())))
hvg = np.argsort(-np.where(keep_g, z, -np.inf))[:n_hvg]
log(f"expressed candidate genes={int(keep_g.sum())}; HVG={n_hvg}; HVG overlap with marker-like block="
    f"{len(set(hvg.tolist()) & set(marker_block.tolist()))}/{len(marker_block)}; "
    f"TF genes among HVG={len(set(hvg.tolist()) & set(tf_idx.tolist()))} (expected ~0; TFs are low-count)")

# ------------------------------------------------- 4. PCA
log("\n== 4. PCA DENOISING ==")
H = L[:, hvg]
Hs = (H - H.mean(0)) / (H.std(0) + 1e-12)
U, S, Vt = np.linalg.svd(Hs, full_matrices=False)
evr = (S ** 2) / (S ** 2).sum()
floor = float(np.median(evr[10:21])) if n_cells > 25 else float(np.median(evr))
n_pc_noise = int(np.sum(evr[:20] >= 1.5 * floor))          # noise-floor (scree/elbow) rule
# floor at k_clusters: a k-cluster spectral embedding needs >= k-1 informative dimensions
n_pc = int(min(8, max(k_clusters, n_pc_noise, 2)))
PC = U[:, :n_pc] * S[:n_pc]
log(f"explained variance ratio PCs1-8: {np.round(evr[:8],4).tolist()} (noise floor med PCs10-20={floor:.5f})")
log(f"rule: n[evr >= 1.5*noise_floor]={n_pc_noise}, floored at k_clusters={k_clusters}, capped 8 -> n_pc={n_pc} "
    f"(note: PC1 alone only encodes a 2-group split; PCs2-{n_pc} carry the finer structure)")

# ------------------------------------------------- 5. kNN graph + outliers
log("\n== 5. kNN GRAPH ==")
K_NN = 15
D = cdist(PC, PC)
nn = np.argsort(D, 1)[:, 1:K_NN + 1]
rows = np.repeat(np.arange(n_cells)[:, None], K_NN, 1).ravel()
A = np.zeros((n_cells, n_cells))
A[rows, nn.ravel()] = 1.0
A = np.maximum(A, A.T)              # union symmetrisation
np.fill_diagonal(A, 0)
sigma = float(np.median(np.sort(D, 1)[:, K_NN]) ** 2)
W = A * np.exp(-D ** 2 / sigma)
log(f"k={K_NN}, Euclidean in PC space, union symmetrisation, gaussian sigma=median(kNN dist)^2="
    f"{sigma:.3f}; mean degree={A.sum(1).mean():.1f}")
# shared-NN structure => outlier flag
Snn = (A > 0) & (A.T > 0)
np.fill_diagonal(Snn, True)
ncc, mem = connected_components(csr_matrix(Snn.astype(float)), directed=False)
sizes = np.bincount(mem)
singletons = np.where(sizes[mem] == 1)[0]
log(f"shared-NN connected components: {int(ncc)} (top sizes {np.sort(sizes)[::-1][:6].tolist()}) "
    f"-> {len(singletons)} singleton (unconnected/contamination-like) cells: {singletons.tolist()}")
Laplacian_eig = None

# ------------------------------------------------- helpers: clustering
def kmeans_pp(Y, k, seed=SEED, n_iter=300, n_init=25):
    """Deterministic k-means++ (NumPy only)."""
    best_lab, best_iner = None, np.inf
    for it in range(n_init):
        rng = np.random.default_rng(seed + 1000 * it)
        C = np.empty((k, Y.shape[1]))
        C[0] = Y[rng.integers(len(Y))]
        d = ((Y - C[0]) ** 2).sum(1)
        for j in range(1, k):
            p = d / d.sum() if d.sum() > 0 else np.full(len(Y), 1.0 / len(Y))
            C[j] = Y[rng.choice(len(Y), p=p)]
            d = np.minimum(d, ((Y - C[j]) ** 2).sum(1))
        lab = np.zeros(len(Y), dtype=int)
        for _ in range(n_iter):
            d2 = ((Y ** 2).sum(1)[:, None] - 2 * Y @ C.T + (C ** 2).sum(1)[None])
            new = d2.argmin(1)
            if np.array_equal(new, lab):
                break
            lab = new
            for j in range(k):
                m = lab == j
                C[j] = Y[m].mean(0) if m.any() else C[j]
        iner = float(((Y - C[lab]) ** 2).sum())
        if iner < best_iner:
            best_iner, best_lab = iner, lab.copy()
    return best_lab, best_iner


def relabel(lab):
    """Compact labels to 0..K-1 ordered by cluster size (desc) -> deterministic."""
    lab = np.asarray(lab)
    order = np.argsort([-(lab == c).sum() for c in np.unique(lab)], kind="stable")
    out = np.zeros_like(lab)
    for new, old in enumerate(order):
        out[lab == old] = new
    return out.astype(np.int32)


def modularity(lab, Adj):
    lab = np.asarray(lab); K = int(lab.max()) + 1
    deg = Adj.sum(1); m2 = Adj.sum()
    if m2 <= 0:
        return 0.0
    Q = 0.0
    for a in range(K):
        ia = np.where(lab == a)[0]
        Q += Adj[np.ix_(ia, ia)].sum() - deg[ia].sum() ** 2 / m2
    return float(Q / m2)


def silhouette_labeled(D, lab, sample=400, seed=SEED):
    lab = np.asarray(lab); K = int(lab.max()) + 1
    if K < 2:
        return 0.0
    rng = np.random.default_rng(seed)
    idx = rng.choice(len(lab), size=min(sample, len(lab)), replace=False)
    vals = []
    for i in idx:
        own = lab == lab[i]; own[i] = False
        if not own.any():
            continue
        a = D[i][own].mean()
        others = [D[i][lab == c].mean() for c in range(K) if c != lab[i] and (lab == c).any()]
        if not others:
            continue
        b = min(others)
        vals.append((b - a) / max(a, b, 1e-12))
    return float(np.mean(vals))


def eta2_marker(lab, M):
    """Mean fraction of marker-block variance explained by the partition (separation quality)."""
    lab = np.asarray(lab); K = int(lab.max()) + 1
    tot = ((M - M.mean(0)) ** 2).sum(0)
    bet = np.zeros(M.shape[1])
    for c in range(K):
        m = lab == c
        if m.sum() > 0:
            bet += m.sum() * (M[m].mean(0) - M.mean(0)) ** 2
    with np.errstate(invalid="ignore", divide="ignore"):
        e = np.where(tot > 1e-12, bet / np.maximum(tot, 1e-12), 0.0)
    return float(e.mean()), float(np.median(e))


def marker_enrichment(lab, Bin):
    """mean within-cluster positivity fraction of each cluster's top-10 marker genes
    minus the same genes' positivity outside the cluster (chance = 0)."""
    lab = np.asarray(lab); K = int(lab.max()) + 1
    diffs = []
    for c in range(K):
        ins = lab == c
        if not ins.any():
            continue
        prof_in = Bin[ins].mean(0); prof_out = Bin[~ins].mean(0)
        top = np.argsort(-(prof_in - prof_out))[:10]
        diffs.append(prof_in[top].mean() - prof_out[top].mean())
    return float(np.mean(diffs)) if diffs else float("nan")


# ------------------------------------------------- 6. clustering
log("\n== 6. CLUSTERING (no Louvain/Leiden available; spectral primary + marker tie-breaker) ==")
log(f"k fixed to metadata n_clusters={k_clusters} (also the modularity/NMF-size optimum in scouting)")

# -- candidate A: spectral clustering on the kNN graph
deg = W.sum(1) + 1e-12
Dinv = 1.0 / np.sqrt(deg)
Lsym = csr_matrix(np.eye(n_cells) - (W * Dinv[:, None]) * Dinv[None, :])
ev, Ve = np.linalg.eigh(Lsym.toarray())
Laplacian_eig = ev[:10]
Ys = Ve[:, 1:k_clusters]
Ys = Ys / (np.linalg.norm(Ys, axis=1, keepdims=True) + 1e-12)
lab_spec, iner_spec = kmeans_pp(Ys, k_clusters)
lab_spec = relabel(lab_spec)

# -- candidate B: NMF(k) on the marker-like block (multiplicative updates, seeded)
def nmf(V, k, seed=SEED, iters=400):
    rng = np.random.default_rng(seed)
    Wf = rng.random((V.shape[0], k)) + 0.1
    Hf = rng.random((k, V.shape[1])) + 0.1
    for _ in range(iters):
        Wf *= (V @ Hf.T) / (Wf @ Hf @ Hf.T + 1e-12)
        Hf *= (Wf.T @ V) / (Wf.T @ Wf @ Hf + 1e-12)
    return Wf, Hf

Mk = np.log1p(cp10k[:, marker_block])
Wn, Hn = nmf(Mk, k_clusters)
lab_nmf = relabel(Wn.argmax(1))

# -- candidate C: Ward hierarchical on PCs
lab_ward = relabel(fcluster(linkage(PC, "ward"), k_clusters, "maxclust"))

# -- marker-block tie-breaker (researcher decision rule)
Bin = (X[:, marker_block] > 0).astype(float)
Dmk = cdist(Mk - Mk.mean(0), Mk - Mk.mean(0))
cands = {}
for nm, lab in [("spectral_kNN", lab_spec), ("NMF_marker_block", lab_nmf), ("Ward_on_PCA", lab_ward)]:
    e_mean, e_med = eta2_marker(lab, Mk)
    cands[nm] = dict(labels=lab, sizes_nonempty=int((np.bincount(lab, minlength=k_clusters) > 0).sum()),
                     marker_eta2_mean=round(e_mean, 4),
                     marker_eta2_median=round(e_med, 4),
                     marker_enrichment=round(marker_enrichment(lab, Bin), 4),
                     marker_silhouette=round(silhouette_labeled(Dmk, lab), 4),
                     graph_modularity=round(modularity(lab, W), 4))
    log(f"  {nm:17s} sizes={np.bincount(lab,minlength=k_clusters).tolist()} "
        f"marker_eta2_mean={cands[nm]['marker_eta2_mean']:.4f} "
        f"marker_eta2_med={cands[nm]['marker_eta2_median']:.4f} "
        f"marker_enrich={cands[nm]['marker_enrichment']:.4f} "
        f"marker_sil={cands[nm]['marker_silhouette']:.4f} Q={cands[nm]['graph_modularity']:.4f}")

non_degenerate = [nm for nm in cands if cands[nm]["sizes_nonempty"] == k_clusters]
rank_key = lambda nm: (cands[nm]["marker_silhouette"], cands[nm]["marker_eta2_mean"],
                       cands[nm]["marker_enrichment"])
SIL_MARGIN = 0.01            # a candidate must beat the primary by this much to displace it
best_nm = max(non_degenerate, key=rank_key)
spec_key = rank_key("spectral_kNN"); best_key = rank_key(best_nm)
margin = best_key[0] - spec_key[0]
ari_sp_nm = ari(lab_spec, lab_nmf)
nmi_sp_nm = nmi(lab_spec, lab_nmf)
log(f"  agreement spectral vs NMF: ARI={ari_sp_nm:.3f} NMI={nmi_sp_nm:.3f}; "
    f"degenerate (empty-cluster) candidates excluded from tie-breaker: "
    f"{[nm for nm in cands if nm not in non_degenerate]}")
if best_nm == "spectral_kNN":
    chosen_nm, decision = "spectral_kNN", "primary spectral labels are also the best marker-separating partition"
elif margin < SIL_MARGIN:
    chosen_nm, decision = "spectral_kNN", (f"tie-breaker is a statistical tie (best marker silhouette {best_key[0]:.4f} "
                                          f"vs spectral {spec_key[0]:.4f}, margin {margin:.4f} < {SIL_MARGIN}) -> "
                                          f"primary spectral labels kept")
elif ari_sp_nm < 0.4:
    chosen_nm, decision = "spectral_kNN", ("ARI(spectral,NMF)<0.4 means the candidate methods disagree strongly; "
                                          "primary spectral labels kept and uncertainty logged")
else:
    chosen_nm, decision = best_nm, (f"tie-breaker displaced the primary: marker silhouette {best_key[0]:.4f} vs "
                                    f"spectral {spec_key[0]:.4f} (margin {margin:.4f} >= {SIL_MARGIN})")
log(f"  DECISION: final labels from '{chosen_nm}' -- {decision}")
clusters = cands[chosen_nm]["labels"].astype(np.int32)

# -- singleton/flagged cells: re-assign to nearest centroid (never dropped)
reassigned = {}
cent = np.array([PC[clusters == c].mean(0) for c in range(k_clusters)])
for c0 in list(dict.fromkeys(singletons.tolist() + qc_flag.tolist())):
    old = int(clusters[c0]); new = int(np.argmin(((cent - PC[c0]) ** 2).sum(1)))
    if new != old:
        clusters[c0] = new
        reassigned[int(c0)] = [old, new]
log(f"  outlier/QC-flagged cells re-assigned to nearest centroid: {len(reassigned)} -> {reassigned}")
_Mk = L[:, marker_block]
_tot = ((_Mk - _Mk.mean(0)) ** 2).sum(0)
def _eta(lab):
    b = sum(((lab == c).sum() * (_Mk[lab == c].mean(0) - _Mk.mean(0)) ** 2) for c in range(k_clusters))
    return float(np.median(np.where(_tot > 1e-12, b / np.maximum(_tot, 1e-12), 0.0)))
_eta_obs = _eta(clusters)
_rng = np.random.default_rng(SEED)
_null = np.array([_eta(_rng.permutation(clusters)) for _ in range(200)])
perm_p = float((np.sum(_null >= _eta_obs) + 1) / (len(_null) + 1))
log(f"  marker-signal significance of the FINAL labels: median marker-block eta2={_eta_obs:.3f} vs label-permutation "
    f"null median={np.median(_null):.4f} max={_null.max():.4f} -> permutation p={perm_p:.4f}")
log(f"  FINAL cluster sizes: {np.bincount(clusters, minlength=k_clusters).tolist()} "
    f"(expected ~{n_cells//k_clusters}/cluster if balanced); "
    f"global PC-space silhouette={silhouette_labeled(D, clusters):.3f}")

# ------------------------------------------------- 7. pseudotime
log("\n== 7. PSEUDOTIME (graph geodesic; root/orientation = DOCUMENTED ASSUMPTION) ==")
# geodesic graph: edge weight = Euclidean distance in PC space, restricted to the kNN graph
E = W > 0
Wgeo = csr_matrix(np.where(E, D, 0.0))
from scipy.sparse.csgraph import minimum_spanning_tree
ncc_g0, mem_c = connected_components(Wgeo, directed=False)
bridges = 0
if ncc_g0 > 1:
    # A geodesic is undefined between disconnected components and no cell may be dropped, so the
    # components are joined by the SHORTEST inter-component edges (Kruskal order on the complete
    # PC-distance graph). This is a documented graph augmentation, not a biological assumption.
    Wd = Wgeo.toarray()
    mst = minimum_spanning_tree(csr_matrix(D)).tocoo()
    mem_cur = mem_c.copy()
    for i, j, v in zip(mst.row, mst.col, mst.data):
        if mem_cur[i] != mem_cur[j]:
            Wd[i, j] = Wd[j, i] = float(max(v, 1e-6))
            old = mem_cur[j]; mem_cur[mem_cur == old] = mem_cur[i]
            bridges += 1
    Wgeo = csr_matrix(Wd)
    ncc_g, mem_g = connected_components(Wgeo, directed=False)
else:
    ncc_g, mem_g = ncc_g0, mem_c
log(f"geodesic graph: components before bridging={int(ncc_g0)}, shortest-MST bridge edges added={bridges}, components after={int(ncc_g)} (connected graph is required for a defined geodesic)")

cent_cells = []
cent_pc = np.array([PC[clusters == c].mean(0) for c in range(k_clusters)])
for c in range(k_clusters):
    m = np.where(clusters == c)[0]
    cent_cells.append(int(m[np.argmin(((PC[m] - cent_pc[c]) ** 2).sum(1))]))
ecc = {}
for c in range(k_clusters):
    dd = dijkstra(Wgeo, indices=cent_cells[c], directed=False)
    ecc[c] = float(np.mean(dd[np.isfinite(dd)]))
order_root = sorted(ecc, key=lambda c: -ecc[c])
log("cluster centroid graph-eccentricity (mean geodesic distance to all cells): "
    + ", ".join(f"c{c}={ecc[c]:.2f}" for c in range(k_clusters)))
root_c, root_c2 = order_root[0], order_root[1]
root_cell = cent_cells[root_c]
log(f"ASSUMPTION: pseudotime root/orientation are NOT defined anywhere in the metadata. "
    f"Rule: root = most peripheral cluster centroid by graph eccentricity -> cluster {root_c} "
    f"(cell {root_cell}); runner-up root = cluster {root_c2}")

def geodesic_pt(cell):
    dd = dijkstra(Wgeo, indices=cell, directed=False)
    fin = np.isfinite(dd)
    if not fin.all():   # should not happen after bridging; guard anyway
        dd[~fin] = float(dd[fin].max()) if fin.any() else 0.0
    rng_ = dd.max() - dd.min()
    return (dd - dd.min()) / (rng_ if rng_ > 0 else 1.0)

pt_root = geodesic_pt(root_cell)
pt_root2 = geodesic_pt(cent_cells[root_c2])
root_sensitivity = spearman(pt_root, pt_root2)
