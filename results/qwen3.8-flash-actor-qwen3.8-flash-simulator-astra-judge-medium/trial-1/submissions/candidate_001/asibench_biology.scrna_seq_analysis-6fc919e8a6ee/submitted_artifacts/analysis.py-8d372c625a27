mean_in = np.zeros((K, n_genes)); mean_out = np.zeros((K, n_genes))
prev_in = np.zeros((K, n_genes)); prev_out = np.zeros((K, n_genes))
for c in range(K):
    m = clusters == c
    mean_in[c] = cpm[m].mean(0); mean_out[c] = cpm[~m].mean(0)
    prev_in[c] = (cpm[m] > 0).mean(0); prev_out[c] = (cpm[~m] > 0).mean(0)
gm_all = L.mean(0)
bet = sum((clusters == c).sum() * (L[clusters == c].mean(0) - gm_all) ** 2 for c in range(K))
wit = sum(((L[clusters == c] - L[clusters == c].mean(0)) ** 2).sum(0) for c in range(K))
