log("\n== 9. GRN (directed TF->TF scores, first n_tf_genes columns only) ==")
SMOOTH_K = 30
N_BINS, LAG = 20, 2
N_FOLD, LAMS = 5, np.logspace(-2, 4, 19)

def solve_ridge(Xd, y, lam):
    p = Xd.shape[1]
    return np.linalg.solve(Xd.T @ Xd + lam * np.eye(p), Xd.T @ y)

def ridge_cv(Xd, y, lams=LAMS, nfold=N_FOLD):
    idx = np.arange(len(y)); rng = np.random.default_rng(SEED); rng.shuffle(idx)
    folds = np.array_split(idx, nfold)
    ybar = y.mean(); sstot = float(((y - ybar) ** 2).sum())
    best = (-np.inf, lams[0])
    for lam in lams:
        ss = 0.0
        for f in folds:
            tr = np.setdiff1d(idx, f)
            ss += float(((y[f] - Xd[f] @ solve_ridge(Xd[tr], y[tr], lam)) ** 2).sum())
        r2 = 1.0 - ss / sstot
        if r2 > best[0]:
            best = (r2, float(lam))
    return best

pt_z = (pseudotime - pseudotime.mean()) / (pseudotime.std() + 1e-12)
pt2 = pseudotime ** 2
pt2_z = (pt2 - pt2.mean()) / (pt2.std() + 1e-12)
extra = np.column_stack([pt_z, pt2_z])

def coef_matrix_multi(Smat, extras):
    Z = np.column_stack([Smat[:, i] for i in range(n_tf)] + [extras])
    Z = (Z - Z.mean(0)) / (Z.std(0) + 1e-12)
    ncol = Z.shape[1]
    B = np.zeros((n_tf, n_tf)); Braw = np.zeros((n_tf, n_tf))
    lams = np.zeros(n_tf); r2s = np.zeros(n_tf)
    for j in range(n_tf):
        keep = [c for c in range(ncol) if c != j]
        y = Z[:, j] - Z[:, j].mean()
        r2, lam = ridge_cv(Z[:, keep], y)
        b = solve_ridge(Z[:, keep], y, lam)
        lams[j], r2s[j] = lam, r2
        for pos, c in enumerate(keep):
            if c < n_tf:
                Braw[c, j] = b[pos]; B[c, j] = abs(b[pos])
    return B, Braw, lams, r2s

# --- smoothing-scheme control (documented, NOT used to pick the scheme) ---
def knn_smooth(mat, ref, kk):
    nbk = np.argsort(cdist(ref, ref), 1)[:, :kk + 1]
    return mat[nbk].mean(1)

def pt_smooth(mat, w):
    o = np.argsort(pseudotime, kind="stable"); out = np.empty_like(mat)
    for pos_i, i in enumerate(o):
        out[i] = mat[o[max(0, pos_i - w):min(len(o), pos_i + w + 1)]].mean(0)
    return out

smooth_controls = {}
for nm, S in [("raw (no smoothing)", TFraw)] + \
              [(f"kNN(k={kk}) on marker-PC graph", knn_smooth(TFraw, PC, kk)) for kk in (10, 20, 30, 50, 80)] + \
              [("pseudotime window +/-50 cells", pt_smooth(TFraw, 50))]:
    Zc = np.column_stack([S[:, i] for i in range(n_tf)] + [np.column_stack([
        (pseudotime - pseudotime.mean()) / (pseudotime.std() + 1e-12),
        ((pseudotime ** 2) - (pseudotime ** 2).mean()) / ((pseudotime ** 2).std() + 1e-12)])])
    Zc = (Zc - Zc.mean(0)) / (Zc.std(0) + 1e-12)
    rr = [ridge_cv(Zc[:, [c for c in range(Zc.shape[1]) if c != j]], Zc[:, j] - Zc[:, j].mean())[0]
          for j in range(n_tf)]
    co = np.corrcoef(S.T)[np.triu_indices(n_tf, 1)]
    smooth_controls[nm] = {"mean_heldout_R2": round(float(np.mean(rr)), 3),
                           "max_abs_TF_TF_corr": round(float(np.abs(co).max()), 3)}
log("smoothing-scheme control (held-out R^2 is NOT a fair criterion across schemes, because smoothing "
    "along pseudotime inflates it by construction -- the pseudotime-window scheme 'wins' trivially and is "
