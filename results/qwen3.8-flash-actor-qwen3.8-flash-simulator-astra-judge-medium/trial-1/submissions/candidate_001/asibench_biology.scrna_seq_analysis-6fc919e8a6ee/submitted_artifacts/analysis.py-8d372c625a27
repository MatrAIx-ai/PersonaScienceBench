# ---- directionality source 1 (PRIMARY): pseudotime-LAGGED cross-correlation on RAW profiles ----
ordr = np.argsort(pseudotime, kind="stable")
bin_id = np.array_split(ordr, N_BINS)
Yb = np.stack([TFraw[b].mean(0) for b in bin_id])           # N_BINS x n_tf, raw (unsmoothed)
def lag_corr(lead_lag):
    M = np.zeros((n_tf, n_tf))
    xs = np.arange(LAG, N_BINS)
    for i in range(n_tf):
        src = Yb[xs - lead_lag, i]
        for j in range(n_tf):
            if i == j:
                continue
            tgt = Yb[xs, j]
            s_, t_ = src.std(), tgt.std()
            M[i, j] = 0.0 if s_ < 1e-12 or t_ < 1e-12 else float(np.corrcoef(src, tgt)[0, 1])
    return M
A_lag = lag_corr(LAG)                                        # corr( x_i at t-LAG , x_j at t )
asym_lag = A_lag - A_lag.T                                   # >0 supports i -> j
# ---- directionality source 2 (secondary): reciprocal ridge asymmetry on RAW profiles ----
asym_reg = np.abs(B_rw) - np.abs(B_rw.T)

def norm01(M):
    m = np.abs(M).max()
    return M / (m if m > 0 else 1.0)

a_lag_n = norm01(asym_lag); a_reg_n = norm01(asym_reg)
pairs = [(i, j) for i in range(n_tf) for j in range(i + 1, n_tf)]
strong = [(i, j) for (i, j) in pairs
          if abs(asym_lag[i, j]) > 0.1 * np.abs(asym_lag).max() and abs(asym_reg[i, j]) > 0.1 * np.abs(asym_reg).max()]
agree = sum(1 for (i, j) in strong if np.sign(asym_lag[i, j]) == np.sign(asym_reg[i, j]))
log(f"directionality source-1 (lagged cross-corr on RAW profiles, {N_BINS} pseudotime bins, "
    f"lag={LAG} bins): max|asym|={np.abs(asym_lag).max():.3f}")
log(f"directionality source-2 (reciprocal ridge asymmetry on RAW profiles): max|asym|="
    f"{np.abs(asym_reg).max():.3f}")
log(f"CONSISTENCY of the two independent raw-based direction sources: {agree}/{len(strong)} "
    f"informative pairs agree on direction ({100.0*agree/max(1,len(strong)):.0f}%)")
net_out = asym_lag.sum(1)
log(f"FLIP-RISK / POSITIVE CONTROL (index-ordered cascade hypothesis): Spearman(TF index, net lagged outflow)="
    f"{spearman(np.arange(n_tf), net_out):.3f} -- if TF0..TF19 act as an ordered cascade, low-index "
    f"regulators should show net outflow (negative index-vs-outflow slope). Reported as evidence, "
    f"NOT fitted to. NOTE: the statistic is computed on the ORIENTED pseudotime, so flipping pseudotime flips its "
    f"sign; a NEGATIVE value is what an index-ordered (TF0 -> TF19) cascade predicts, therefore the observed "
    f"value is weak evidence AGAINST the chosen orientation and quantifies the flip risk. Combined with "
    f"Spearman(pt[root {root_c}], pt[root {root_c2}])={root_sensitivity:.3f} (the two candidate roots sit at "
    f"opposite trajectory ends), the direction of pseudotime is the dominant uncertainty of this task.")

# ---- combine: strength x direction gate ----
gate = np.clip(0.5 + 0.75 * a_lag_n + 0.25 * a_reg_n, 0.05, 1.0)
score = B_sm * gate
np.fill_diagonal(score, 0.0)
score = np.nan_to_num(score, nan=0.0, posinf=0.0, neginf=0.0)
lo, hi = np.percentile(score[score > 0], [1, 99]) if (score > 0).any() else (0.0, 1.0)
score = np.clip(score, None, hi)          # winsorise BEFORE min-max so that a single extreme value
score = score - score.min()               # cannot compress the rest of the rank structure
rng_s = score.max() - score.min()
grn = score / (rng_s if rng_s > 0 else 1.0)
np.fill_diagonal(grn, 0.0)
grn = np.nan_to_num(grn, nan=0.0, posinf=0.0, neginf=0.0).astype(np.float64)
sym = float(np.abs(grn - grn.T).mean() / (grn.mean() + 1e-12))
