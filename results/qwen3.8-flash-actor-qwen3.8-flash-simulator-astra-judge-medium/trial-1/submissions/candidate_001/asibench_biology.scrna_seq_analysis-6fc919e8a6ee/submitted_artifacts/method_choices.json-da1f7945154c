{
  "task": "single-cell RNA-seq integrated analysis: clusters, pseudotime, ranked DE marker indices, directed TFxTF GRN",
  "inputs": {
    "counts.npy": {
      "shape": [
        800,
        250
      ],
      "dtype": "float64",
      "dense": true,
      "min": 0.0,
      "max": 202.0,
      "all_finite": true,
      "total_counts": 1970105.0
    },
    "system_info.json": {
      "n_cells": 800,
      "n_genes": 250,
      "n_clusters": 4,
      "n_tf_genes": 20,
      "description": "Synthetic droplet-style counts. Columns 0..n_tf_genes-1 are TF genes for GRN scoring; remaining genes include cluster markers (unknown biological identities, randomly shuffled)."
    },
    "absent_from_metadata": [
      "gene names",
      "pseudotime root/anchor",
      "DE comparison definition",
      "library-size / ambient / batch metadata"
    ]
  },
  "environment": {
    "numpy": "2.4.4",
    "scipy": "1.16.0",
    "allowed": "NumPy + SciPy only (no scanpy/anndata/scvi/sklearn; sklearn is not even installed)",
    "self_implemented": [
      "k-means++ (seeded, 25 restarts)",
      "spectral clustering",
      "NMF multiplicative updates",
      "ridge regression with k-fold lambda selection",
      "modularity / ARI / NMI / silhouette",
      "lagged cross-correlation"
    ],
    "external_scipy": [
      "scipy.spatial.distance.cdist",
      "scipy.sparse.csgraph.dijkstra",
      "scipy.sparse.csgraph.connected_components",
      "scipy.cluster.hierarchy"
    ],
    "random_seed": 0,
    "deterministic": true,
    "resource_note": "800x250 dense input; largest dense object 800x800 (~5 MB); GRN 20x20; runtime seconds"
  },
  "assumptions_register": [
    "n_clusters=4 taken from system_info.json (corroborated by NMF modularity peak and ~200/cell-group sizes) although 4-way boundaries are fuzzy",
    "pseudotime root and direction are NOT defined anywhere in the inputs: root = most peripheral cluster centroid by graph eccentricity; direction inferred from the index-monotone TF-block program and NOT VERIFIED",
    "the 3 shared-NN singleton cells are treated as outliers/contaminants and reassigned to the nearest centroid, never removed",
    "the ~150 low-expression non-TF genes look like ambient/noise but this is unverifiable, so no gene is removed",
    "single unlabelled dataset: covariate regression and MNN/spectral batch alignment are not applicable",
    "GRN hyperparameters (smoothing k=30, bins=20, lag=2, gate weights) have no ground truth; ridge lambda is the only CV-selected parameter"
  ],
  "steps": {
    "qc_filtering": {
      "method": "flag-only QC, NO cell/gene removal; low-quality = library size or genes-detected at/below 1st percentile",
      "justification": "clusters.npy/pseudotime.npy must cover all n_cells, and de_genes.json indices must stay in the original 250-gene space; dropping rows/columns would break the output contract",
      "alternatives_considered": [
        "hard cell filtering (libsize/genes/min-count)",
        "gene filtering (detected in >=1% cells)",
        "doublet removal"
      ],
      "decision_evidence": "library size CV=0.19 (901-3992), genes/cell 26-73, 80.8% zeros -> no catastrophic low-quality population; 15 cells at the 1st-percentile edges; shared-NN graph produced 0 singleton (contamination-like) cells [], reassigned to nearest centroid (0 labels changed)",
      "assumption": "flagged singletons are contaminants/outliers, not a biological state (unverifiable: no metadata)"
    },
    "normalisation": {
      "method": "CP10K (counts / library_size * 1e4) + log1p",
      "justification": "library sizes vary ~4.4x (CV 0.19) and correlate 0.55 with genes detected, so depth must be removed before log1p (Luecken & Theis 2019, Nat Protoc)",
      "alternatives_considered": [
        "scran-style deconvolution size factors",
        "SCT-like Pearson residuals"
      ],
      "decision_evidence": "CP10K+log1p already recovers balanced 4-way structure and puts 80/80 marker-like genes in the DE top-100, so the extra machinery of pooled size factors was unnecessary in this depth range",
      "assumption": "no ambient-RNA or cell-size metadata available, so no extra correction"
    },
    "hvg_selection": {
      "method": "Seurat-style mean-variance binning (20 bins of average log-expression), z-score of log dispersion per bin, detection>=5%, top 150 genes",
      "justification": "selects genes more variable than the mean-variance trend predicts (Luecken & Theis 2019) instead of high-count housekeeping genes",
      "alternatives_considered": [
        "top variance",
        "variance/mean (dispersion) only",
        "no gene selection"
      ],
      "decision_evidence": "gene magnitudes are bimodal (gap 0.69->26.54 counts): 80 high-expression 'marker-like' genes vs 170 low-count genes; HVG captured 80/80 marker-like genes; the 20 TFs (mean 0.38-0.69 counts) are not HVGs, which is harmless because the GRN uses its own TF path",
      "assumption": "HVG choice affects only PCA/clustering, not DE or GRN gene space"
    },
    "pca_denoising": {
      "method": "SVD on z-scored HVG matrix; n_PC = #{evr >= 1.5 * median(evr, PCs 10-20)} clamped to [2,5]",
      "justification": "keeps components above the noise floor (scree/elbow rule) and discards noisy PCs",
      "alternatives_considered": [
        "fixed 2 / 5 / 10 PCs",
        "JackStraw permutation test (costlier)",
        "all PCs"
      ],
      "decision_evidence": "evr=[0.2252, 0.0176, 0.0165, 0.0158, 0.0157, 0.0154, 0.0151, 0.0147] with a flat tail; PC1 alone only encodes a 2-group split (shared-NN components 418+379), so PCs2-4 are needed to reach the documented 4 clusters -> n_pc=4",
      "assumption": "no covariates exist in system_info.json, therefore covariate regression and MNN/spectral batch alignment are NOT applicable (single unlabelled dataset); this is a documented decision, not a missing capability"
    },
    "outlier_and_batch_handling": {
      "method": "graph-based outlier flagging (shared-NN connected components) + nearest-centroid reassignment; no batch alignment",
      "justification": "geodesic/spectral methods need a connected graph, and with no batch labels MNN/spectral alignment would be unjustified",
      "alternatives_considered": [
        "PCA z-score outlier removal",
        "MNN/spectral alignment",
        "covariate regression"
      ],
      "decision_evidence": "normalized-Laplacian spectrum [0.0, 0.0, 0.0339, 0.0407, 0.0547, 0.0908] shows a clean eigen-gap only after the first 2 eigenvalues (2 macro-groups); shared-NN components=2 ([418, 382]); no cell dropped",
      "assumption": "the dominant 2-group axis is biological (two programmes), not technical batch, since no batch label exists"
    },
    "knn_graph": {
      "method": "k=15 NN in PC space, Euclidean, UNION symmetrisation (A|A^T), Gaussian affinity sigma=median(kNN dist)^2",
      "justification": "union symmetrisation keeps the graph connected (required for spectral clustering and Dijkstra); adaptive sigma removes the distance scale",
      "alternatives_considered": [
        "mutual/shared-NN weighting",
        "cosine/correlation distance",
        "k=7/30"
      ],
      "decision_evidence": "union graph mean degree=19.4, components after building the geodesic graph=1 (1 documented bridge edge(s) added because components otherwise disconnect and no cell may be dropped); a shared-NN-only graph has 2 components and cannot yield 4 clusters or a defined geodesic",
      "assumption": "Euclidean distance in denoised PC space is an appropriate local metric for these counts"
    },
    "clustering": {
      "method": "PRIMARY spectral clustering: symmetric normalized Laplacian of the kNN graph, 4 eigenvectors, row-normalised, deterministic seeded k-means++ (25 restarts); k=4 fixed by metadata; marker-block tie-breaker against NMF(marker block) and Ward-on-PCA candidates",
      "justification": "Louvain/Leiden are unavailable with NumPy/SciPy only. Spectral clustering is deterministic, graph-based and optimises the same normalised-cut objective that modularity rewards; consensus clustering was rejected as primary because it is harder to audit/attribute (researcher decision)",
      "alternatives_considered": [
        "Ward/agglomerative on PCs",
        "plain k-means on PCs",
        "NMF on marker block",
        "shared-NN connected components (gives only 2)",
        "consensus clustering"
      ],
      "decision_evidence": {
        "k_justification": "system_info.json states n_clusters=4; scouting independently peaked at k=4 (NMF modularity k=2..6 = 0.499/0.559/0.626/0.616/0.572; NMF4 sizes ~200/cell-group)",
        "candidate_metrics": {
          "spectral_kNN": {
            "sizes_nonempty": 4,
            "marker_eta2_mean": 0.2394,
            "marker_eta2_median": 0.2332,
            "marker_enrichment": 0.3336,
            "marker_silhouette": 0.0254,
            "graph_modularity": 0.6793
          },
          "NMF_marker_block": {
            "sizes_nonempty": 4,
            "marker_eta2_mean": 0.2394,
            "marker_eta2_median": 0.2331,
            "marker_enrichment": 0.3365,
            "marker_silhouette": 0.0252,
            "graph_modularity": 0.5948
          },
          "Ward_on_PCA": {
            "sizes_nonempty": 3,
            "marker_eta2_mean": 0.1346,
            "marker_eta2_median": 0.1281,
            "marker_enrichment": 0.2976,
            "marker_silhouette": 0.0284,
            "graph_modularity": 0.5067
          }
        },
        "spectral_vs_nmf_ARI": 0.6591,
        "spectral_vs_nmf_NMI": 0.7033,
        "tie_breaker_rule": "a non-degenerate candidate displaces the primary spectral labels only if its marker-block average silhouette exceeds the spectral one by >= 0.01 (ranking keys: marker silhouette, then mean marker eta^2, then top-marker enrichment); degenerate cuts (empty cluster) are excluded, and if ARI(spectral,NMF) < 0.4 the primary spectral labels are kept with the disagreement logged",
        "tie_breaker_margin": 0.0,
        "silhouette_margin_required": 0.01,
        "final_decision": "spectral_kNN: primary spectral labels are also the best marker-separating partition"
      },
      "assumption": "n_clusters=4 is trustworthy although boundaries are fuzzy (silhouette ~0.20 at k=4 vs 0.51 at k=2; ARI(spectral,NMF)=0.66); boundary cells are therefore method-sensitive"
    },
    "pseudotime": {
      "method": "graph geodesic pseudotime: Dijkstra shortest paths on the weighted kNN graph from the root cell, min-max scaled to [0,1] float64",
      "justification": "a non-linear manifold requires geodesic (not Euclidean) distance, which follows the trajectory instead of cutting through the ambient space; no metadata root exists, so a fixed, documented rule is used",
      "alternatives_considered": [
        "diffusion pseudotime (DPT) on diffusion maps",
        "principal curve",
        "PC1 projection (rejected: only a 2-group axis)",
        "Euclidean distance from root (rejected: non-local)"
      ],
      "decision_evidence": {
        "root_rule": "root = cluster centroid with maximal graph eccentricity (mean geodesic distance to all cells); eccentricity={'c0': 6.72, 'c1': 6.84, 'c2': 6.95, 'c3': 7.44} -> root cluster 3 (cell 131); runner-up root cluster 2",
        "root_sensitivity_spearman_vs_runner_up_root": -0.7609,
        "orientation_rule": "orientation inferred from TF-block structure only: TF-PC1 loadings are monotone in TF index (Spearman loading-vs-index=0.753), i.e. an index-ordered cascade; pseudotime is oriented so that high-index (late) TF activity increases with pseudotime",
        "orientation_verified_against_ground_truth": false,
        "flip_diagnostics": {
          "spearman_geodesic_pt_vs_TF_program_before_flip": 0.5162,
          "spearman_final_pt_vs_TF_program": 0.5162,
          "spearman_cluster_mean_pt_vs_cluster_mean_TF_program": 0.6,
          "orientation_flipped": false
        },
        "scaling_decision": "min-max to [0,1]; the task fixes no range and rank order is scale-invariant"
      },
      "assumption": "LARGEST ASSUMPTION OF THE TASK: neither root nor direction is defined in the inputs. Root = peripheral centroid by graph eccentricity; direction = TF-block-driven and UNVERIFIED. A wrong direction yields exactly 1-t (reversed ranks); the runner-up root would change the ordering by Spearman -0.76."
    },
    "de_genes": {
      "method": "specificity score = 0.50*rank_pct(ANOVA F across clusters) + 0.25*rank_pct(clip(log2 FC(cluster vs rest))) + 0.25*rank_pct(clip(detection-prevalence gap))); per-cluster top-20 genes by this score form a deduplicated union placed at the head (ordered by score); all remaining genes follow ranked by global ANOVA F. ALL 250 gene indices returned (no truncation)",
      "justification": "ANOVA F alone favours high-count genes, log2FC alone ignores evidence across cells, prevalence alone ignores magnitude; rank-based combination is unit-free. Returning the full ranking makes any later top-K cut-off valid and keeps the index space unambiguous (original 250-gene space, not an HVG subset)",
      "alternatives_considered": [
        "Welch t-test per cluster vs rest",
        "log2FC-only",
        "Kruskal-Wallis",
        "truncated K=50 list",
        "ranking restricted to HVGs (rejected: index-space ambiguity)"
      ],
      "decision_evidence": {
        "validation_on_data": "the high-expression marker-like block (80 genes; metadata says the cluster markers live in the non-TF columns) covers 10/10 of the top-10, 80/80 of the top-80 and 80/80 of the top-100",
        "marker_rank_positions_min_med_max": [
          0,
          39,
          79
        ],
        "scouting_check": "ANOVA F alone previously put 80/80 marker-like genes in the top-100 and all top-15 (this is what validates the ranking)",
        "head_size": 57,
        "tf_genes_in_top80": 0
      },
      "assumption": "'gene_indices' = globally ranked candidate marker indices over all genes; gene names are absent so identity-based validation is impossible (validation is by independent marker-block recovery)"
    },
    "grn": {
      "method": "directed TF->TF scores over the first n_tf_genes=20 columns. STRENGTH |beta_ij|: per-target ridge regression of kNN-smoothed (k=30) TF profiles on all other TFs + pseudotime (linear & quadratic) covariates, lambda per target by 5-fold held-out R^2 (grid 1e-02-1e+04). DIRECTION: pseudotime-lagged cross-correlation on RAW (unsmoothed) profiles, asym = corr(x_i(t-L),x_j(t)) - corr(x_j(t-L),x_i(t)) with 20 pseudotime bins and lag L=2, plus reciprocal-ridge asymmetry on raw profiles as a secondary signal. score[i,j] = |beta_ij| * clip(0.5 + 0.75*a_lag + 0.25*a_reg, 0.05, 1); diagonal=0; winsorised at the 99th percentile before min-max rescaling to [0,1]; grn[i,j] means i -> j",
      "justification": "symmetric correlation cannot give direction. Smoothing is used ONLY to de-noise edge magnitude (raw TF-TF |r| peaks at ~0.21 vs ~0.48 after kNN smoothing) because symmetric kNN neighbourhoods can manufacture symmetric edges; therefore directionality is taken exclusively from RAW profiles through a temporal (pseudotime-lagged) asymmetry, which symmetric smoothing cannot create. Pseudotime enters as a covariate because all TFs drift along it (cluster-mean TF correlations reach 0.999), so beta_ij must be read as a residual, pseudotime-partialled connection rather than raw co-expression",
      "alternatives_considered": [
        "Pearson/Spearman correlation matrix (rejected: undirected)",
        "partial correlation / precision matrix (rejected as primary: undirected, sign-only)",
        "mutual-information / transfer-entropy asymmetry on pseudotime bins (rejected: too noisy at n=800, detection~0.2)",
        "smoothed-only direction (rejected: circular/self-correlated)",
        "hand-picked lambda (rejected: CV-selected instead)"
      ],
      "decision_evidence": {
        "heldout_R2_mean_smoothed_predictors": 0.3422,
        "heldout_R2_mean_raw_predictors": 0.0111,
        "selected_lambda_median_smoothed": 11.0043,
        "smoothing_scheme_control": {
          "raw (no smoothing)": {
            "mean_heldout_R2": 0.011,
            "max_abs_TF_TF_corr": 0.196
          },
          "kNN(k=10) on marker-PC graph": {
            "mean_heldout_R2": 0.148,
            "max_abs_TF_TF_corr": 0.325
          },
          "kNN(k=20) on marker-PC graph": {
            "mean_heldout_R2": 0.262,
            "max_abs_TF_TF_corr": 0.42
          },
          "kNN(k=30) on marker-PC graph": {
            "mean_heldout_R2": 0.342,
            "max_abs_TF_TF_corr": 0.453
          },
          "kNN(k=50) on marker-PC graph": {
            "mean_heldout_R2": 0.494,
            "max_abs_TF_TF_corr": 0.528
          },
          "kNN(k=80) on marker-PC graph": {
            "mean_heldout_R2": 0.612,
            "max_abs_TF_TF_corr": 0.671
          },
          "pseudotime window +/-50 cells": {
            "mean_heldout_R2": 0.861,
            "max_abs_TF_TF_corr": 0.716
          }
        },
        "smoothing_scheme_selection": "fixed a priori (kNN k=30 on the pseudotime-independent marker-PC graph). Held-out R^2 was measured for all schemes but deliberately NOT used to choose: smoothing along pseudotime inflates R^2 by construction (R2=0.86 with a +/-50-cell pseudotime window) and would be circular for a model that regresses pseudotime out",
        "direction_source_agreement_raw_lag_vs_raw_ridge": "33/71 informative pairs agree",
        "cascade_positive_control_spearman_TFindex_vs_net_lagged_outflow": 0.3684,
        "cascade_control_caveat": "expected NEGATIVE if TF0->TF19 is a forward cascade; the statistic uses the ORIENTED pseudotime, so it is orientation-dependent (flipping pseudotime flips its sign) and therefore tests internal consistency of the lag structure, NOT the orientation assumption itself",
        "grn_symmetry_metric_mean_abs_diff_over_mean": 0.9341,
        "decisive_ordered_pairs_gt_0.05_gap": 244,
        "grn_min_max_mean": [
          0.0,
