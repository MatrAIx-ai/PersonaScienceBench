import json, numpy as np
from scipy.stats import spearmanr
X=np.load('data/counts.npy'); info=json.load(open('data/system_info.json'))
n,p=X.shape; lib=X.sum(1); L=np.log1p(X/lib[:,None]*1e4); gm=X.mean(0)
mb=np.where(gm>4.29)[0]
cl=np.load('clusters.npy'); pt=np.load('pseudotime.npy'); grn=np.load('grn_scores.npy')
de=json.load(open('de_genes.json'))['gene_indices']
print("== contract ==")
print("clusters", cl.shape, cl.dtype, "labels", sorted(set(cl.tolist())), "sizes", np.bincount(cl).tolist())
print("pseudotime", pt.shape, pt.dtype, "range", (pt.min(), pt.max()), "finite", bool(np.isfinite(pt).all()))
print("grn", grn.shape, grn.dtype, "diag0", bool(np.all(np.diag(grn)==0)), "finite", bool(np.isfinite(grn).all()), "range",(grn.min(),grn.max()))
print("de list len", len(de), "unique", len(set(de)), "valid range", min(de)>=0 and max(de)<p)
print("\n== cluster quality (independent of clustering code) ==")
K=cl.max()+1; M=L[:,mb]
tot=((M-M.mean(0))**2).sum(0); bet=sum(((cl==c).sum()*(M[cl==c].mean(0)-M.mean(0))**2) for c in range(K))
eta=np.where(tot>1e-12,bet/np.maximum(tot,1e-12),0)
rng=np.random.default_rng(0); perm=[]
for _ in range(50):
    lp=rng.permutation(cl); b=sum(((lp==c).sum()*(M[lp==c].mean(0)-M.mean(0))**2) for c in range(K))
    perm.append(np.median(np.where(tot>1e-12,b/np.maximum(tot,1e-12),0)))
print(f"marker-block eta2: median={np.median(eta):.3f} mean={eta.mean():.3f} | label-permutation null median={np.mean(perm):.3f} max={np.max(perm):.3f} -> p<{(sum(np.array(perm)>=np.median(eta))+1)/51:.3f}")
for c in range(K):
    m=cl==c; top=np.argsort(-(L[m].mean(0)-L[~m].mean(0)))[:6]
    print(f"  c{c} n={m.sum():4d} top-specific genes={top.tolist()} in_marker_block={[int(t in set(mb.tolist())) for t in top]}")
print("\n== DE list ==")
for k in [10,20,40,80]:
    print(f"  top-{k}: {len(set(de[:k]) & set(mb.tolist()))}/{k} from marker block, TF-genes={len(set(de[:k]) & set(range(20)))}")
print("  first 15 indices:", de[:15])
print("\n== pseudotime sanity ==")
TF=L[:, :20]
for c in range(K):
    print(f"  c{c}: mean pt={pt[cl==c].mean():.3f} sd={pt[cl==c].std():.3f}")
prog = TF @ np.array([1 if i<10 else -1 for i in range(20)],float)
print(f"  Spearman(pt, early-vs-late TF index contrast) = {spearmanr(pt, prog).statistic:.3f}")
print(f"  Spearman(pt, marker PC1) = {spearmanr(pt, (X[:,mb]-X[:,mb].mean(0))@np.linalg.svd(X[:,mb]-X[:,mb].mean(0),full_matrices=False)[2][0]).statistic:.3f}")
print("\n== GRN structure ==")
iu=np.triu_indices(20,1)
print(f"  mean|S-S^T|={np.abs(grn-grn.T).mean():.4f}; edges with S>0.5: {int((grn>0.5).sum())}; top5 edges (i->j, score):")
fl=grn.copy(); np.fill_diagonal(fl,-1)
for idx in np.argsort(-fl, axis=None)[:5]:
    i,j=np.unravel_index(idx, grn.shape); print(f"    TF{i} -> TF{j}: {grn[i,j]:.3f} (reverse {grn[j,i]:.3f})")
i,j=np.unravel_index(np.argsort(-(grn-grn.T), axis=None)[:5], grn.shape)
print("  most directional pairs:", [(int(a),int(b)) for a,b in zip(i,j)])
