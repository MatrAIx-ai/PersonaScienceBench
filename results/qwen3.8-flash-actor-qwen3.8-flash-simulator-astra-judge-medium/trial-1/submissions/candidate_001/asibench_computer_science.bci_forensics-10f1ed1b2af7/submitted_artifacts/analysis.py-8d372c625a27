        if np.allclose(p2l[:, ci], ol[:, ci]) and np.allclose(p2h[:, ci], oh[:, ci]):
            fl.append("aux_panel_probe_02_identical_to_observed(no_engine_discrimination)")
        if pr02[sel_ei, ci] < 1e-12:
            fl.append("selected_engine_invariant_to_probe_02_perturbation")
        warnings[c] = fl
    report = {
        "selected_engine_id": sel,
        "aggregate_coverage_gap": round(float(coverage_gap[sel_ei]), 6),
        "aggregate_tail_imbalance": round(float(tail_imbalance[sel_ei]), 6),
