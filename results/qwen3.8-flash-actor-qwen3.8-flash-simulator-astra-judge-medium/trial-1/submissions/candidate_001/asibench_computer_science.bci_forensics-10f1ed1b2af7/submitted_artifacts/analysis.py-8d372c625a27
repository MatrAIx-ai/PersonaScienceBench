        },
    }
    with open(R("reliability_report.json"), "w") as fh:
        json.dump(report, fh, indent=2)

    # ---------------- figure -----------------------------------------------
    _make_figure(R("engine_overview.png"), dict(
        cov=cov, CONF=CONF, case_ids=case_ids, engine_ids=engine_ids,
        families=families, probe_score=probe_score, case_dispersion=case_dispersion,
        ml=ml, mh=mh, ev=ev, labels=labels, pred=pred, sel=sel, sel_ei=sel_ei,
        engine_score=engine_score, width_ratio_cal=width_ratio_cal))

    # ---------------- console summary ---------------------------------------
    print("selected:", sel, pred[sel], "score", round(float(engine_score[sel_ei]), 4))
    print("ranking:", [engine_ids[ei] for ei in order])
    print("labels:", {e: pred[e] for e in engine_ids})
    print("reflect partners:", {engine_ids[k]: v for k, v in reflect_partner.items()})
    print("twin donors:", {engine_ids[k]: v for k, v in twin_donor.items()})
    assert pred[sel] == "reliable_engine", "selected engine must be labelled reliable"
    print("engine  gap    tail   wratio disp   p00    p01    p02    p03    p04   score")
    for ei, e in enumerate(engine_ids):
        print(e, f"{coverage_gap[ei]:.4f} {tail_imbalance[ei]:.4f} {width_ratio[ei]:.4f} "
              f"{case_dispersion[ei]:.4f} " + " ".join(f"{probe_metric[k, ei]:.4f}" for k in range(5))
              + f" {engine_score[ei]:.4f}")
    print("evidence:")
