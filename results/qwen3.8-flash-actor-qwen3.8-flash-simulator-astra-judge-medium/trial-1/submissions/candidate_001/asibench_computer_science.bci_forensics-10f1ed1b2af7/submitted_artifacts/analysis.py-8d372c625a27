def _text(img, x, y, s, sc=2, col=(0, 0, 0)):
    H, W, _ = img.shape
    cx = x
    for ch in str(s).upper():
        g = _FONT.get(ch)
        if g is None:
            cx += 4 * sc
            continue
        for r, row in enumerate(g):
            for c, px in enumerate(row):
                if px == '#':
                    yy, xx = y + r * sc, cx + c * sc
                    if 0 <= yy < H and 0 <= xx + sc <= W:
                        img[yy:yy + sc, xx:xx + sc] = col
        cx += 4 * sc

def _sev_col(v):  # severity 0..1 -> white to red
    v = float(np.clip(v, 0, 1))
    return (255, int(255 * (1 - v)), int(120 * (1 - v)))

def _heat(img, x0, y0, cw, ch, mat, vmax=None):
    mat = np.asarray(mat, float)
    mx = vmax if vmax is not None else max(mat.max(), 1e-9)
    for i in range(mat.shape[0]):
        for j in range(mat.shape[1]):
            c = _sev_col(mat[i, j] / mx)
            img[y0 + i * ch: y0 + (i + 1) * ch, x0 + j * cw: x0 + (j + 1) * cw] = c
            img[y0 + i * ch, x0:j + 1 and x0 + (j + 1) * cw] = 0

def _frame(img, x0, y0, x1, y1):
    img[y0, x0:x1] = 0; img[y1 - 1, x0:x1] = 0
    img[y0:y1, x0] = 0; img[y0:y1, x1 - 1] = 0

def _bars(img, x0, y0, w, vals, colors, vmax):
    n = len(vals); bh = max(int(20), 8)
    for i, v in enumerate(vals):
        y = y0 + i * (bh + 4)
        L = int(w * float(np.clip(v / max(vmax, 1e-12), 0, 1)))
        img[y:y + bh, x0:x0 + L] = colors[i]
        _frame(img, x0, y, x0 + w, y + bh)

def _save_png(path, img):
    import struct, zlib
    H, W, _ = img.shape
    raw = b''.join(b'\x00' + img[y].tobytes() for y in range(H))
    def chunk(t, d):
        return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    with open(path, 'wb') as fh:
        fh.write(b'\x89PNG\r\n\x1a\n')
        fh.write(chunk(b'IHDR', struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0)))
        fh.write(chunk(b'IDAT', zlib.compress(raw, 9)))
        fh.write(chunk(b'IEND', b''))

