#!/usr/bin/env python3
"""
Deterministic confidence-interval engine forensics — reproducible analysis.

Run:  python analysis.py        (CPU numpy/matplotlib only; no randomness anywhere)

Axis discipline (asserted at runtime, see validate()):
  * observed_low / observed_high / probe panels : (engine, case[, aux])
  * calibration_low / calibration_high          : (engine, case, replication) with
    replication axis = 108 (the axis written to coverage_audit.n_replications).
    The 374 axis in calibration_resample_panels.npz is the engine-internal
    bootstrap size (manifest n_calibration_bootstrap) and is consumed ONLY
    through the precomputed calibration endpoint panels; we never resample.
  * endpoint arrays are consumed as (low, high) pairs keyed by their names
    ('*_low' with '*_high'), never positionally; low<=high is asserted.

Baseline definition (binding clarification #1):
  baseline_low / baseline_high are a TRANSPARENT REFERENCE INTERVAL that this
  script computes itself: the standard percentile bootstrap of the public
  statistic at the manifest confidence level (0.9021), using
  data/resample_panels.npz and data/observed_samples.csv.  It does NOT depend
  on any anonymous engine id or on our classification.  (Verified at runtime:
  it reproduces the supplied baseline_low/baseline_high arrays exactly.)

Target definition:
  Exact population targets are not public, so the per-case coverage target is
  the pooled calibration statistic: statistic(all 108*74 calibration values).
  (A per-replication target is degenerate — every engine then covers its own
  replication statistic with probability 1 — see recon log.)

Orientation convention (used everywhere):
  Every diagnostic_value / diagnostic_score / probe_signal / profile_score /
  metric in engine_audit / coverage_score is a SEVERITY measure: 0 = perfect,
  larger = worse.  engine_score is the mean of min-max-normalized severities
  across audit components; the selected engine is the argmin of engine_score
  with a declared tie-break on lexicographically smallest engine_id (a
  deterministic convention only; ids carry no signal — they are stored
  alphabetically and Spearman(index, audit quality) ~ 0.33, non-monotone).

Degenerate-value guards:
  All width denominators are floored at MIN_WIDTH = 0.0417 (the observed
  minimum interval width across all panels), log width ratios are clipped to
  [-1.5, 1.5], and case_03 (only 38 unique bootstrap values) is flagged in
  case_warnings as extreme_discreteness.  All outputs are finite.
"""
import csv
import json
import os

import numpy as np

MIN_WIDTH = 0.0417          # empirical minimum width across all panels
LOG_CLIP = 1.5              # clip for log width ratios (ratio in [0.22, 4.48])
EPS = 1e-12

HERE = os.path.dirname(os.path.abspath(__file__))
D = lambda *p: os.path.join(HERE, "data", *p)
R = lambda *p: os.path.join(HERE, "results", *p)


def statistic(x, name, params, axis=None):
    """Public statistic definitions from study_manifest.json (vectorized)."""
    if name == "mean":
        return np.mean(x, axis=axis)
    if name == "median":
        return np.median(x, axis=axis)
    if name == "coefficient_of_variation":
        return np.std(x, axis=axis, ddof=params.get("std_ddof", 1)) / np.mean(x, axis=axis)
    if name == "upper_tail_rate":
        return np.mean((x >= params["threshold"]).astype(float), axis=axis)
    raise ValueError(f"unknown statistic {name}")


def main():
    man = json.load(open(D("study_manifest.json")))
    pman = json.load(open(D("probe_manifest.json")))
    CONF = man["confidence_level"]
    cases_meta = man["cases"]
    case_ids = [c["case_id"] for c in cases_meta]
    engine_ids = list(man["engine_ids"])
    labels = list(man["failure_label_vocabulary"])
    nc, ne = len(case_ids), len(engine_ids)

    rows = list(csv.DictReader(open(D("observed_samples.csv"))))
    obs = {c: np.array([float(r["value"]) for r in rows if r["case_id"] == c]) for c in case_ids}

    rp = np.load(D("resample_panels.npz"))
    cs = np.load(D("calibration_samples.npz"))
    crp = np.load(D("calibration_resample_panels.npz"))
    zp = np.load(D("engine_interval_panels.npz"))

    eng = [str(e) for e in zp["engine_ids"]]
    cid = [str(c) for c in zp["case_ids"]]
    ol, oh = zp["observed_low"], zp["observed_high"]          # (engine, case)
    clo, chi = zp["calibration_low"], zp["calibration_high"]  # (engine, case, rep)
    p2l, p2h = zp["probe_panel_02_low"], zp["probe_panel_02_high"]
    p3l, p3h = zp["probe_panel_03_low"], zp["probe_panel_03_high"]
    stat_obs = zp["observed_stat"]
    nrep = clo.shape[2]

    def validate():
        assert eng == engine_ids, "engine axis order mismatch"
        assert cid == case_ids, "case axis order mismatch"
        assert ol.shape == oh.shape == (ne, nc)
        assert clo.shape == chi.shape == (ne, nc, nrep)
        assert nrep == cases_meta[0]["n_calibration_replications"] == 108, "replication axis must be 108"
        assert crp[cid[0]].shape[0] == nrep
        assert crp[cid[0]].shape[2] == 74
        for a in (ol, oh, clo, chi, p2l, p2h, p3l, p3h, stat_obs):
            assert np.all(np.isfinite(a))
        assert np.all(clo <= chi + 1e-12) and np.all(ol <= oh + 1e-12)  # (low,high) pairs checked
        assert p3l.shape[2] == man["split_count"] == 6
        for i, c in enumerate(case_ids):
            assert obs[c].shape == (74,) and cs[c].shape == (nrep, 74)
            assert rp[c].shape[1] == 74 and crp[c].shape[0] == nrep
            got = statistic(obs[c], cases_meta[i]["statistic_name"],
                            cases_meta[i]["statistic_parameters"])
            assert abs(got - stat_obs[i]) < 1e-9, f"statistic mismatch {c}"
    validate()

    # ---------------- transparent baseline (binding #1) ----------------
    base_lo, base_hi = np.zeros(nc), np.zeros(nc)
    for i, cd in enumerate(cases_meta):
        xb = obs[cid[i]][rp[cid[i]]]                            # (885, 74)
        bs = statistic(xb, cd["statistic_name"], cd["statistic_parameters"], axis=1)
        base_lo[i], base_hi[i] = np.quantile(bs, [(1 - CONF) / 2, 1 - (1 - CONF) / 2])
    # cross-check: our explicit reference equals the supplied baseline_* arrays exactly
    assert np.allclose(base_lo, zp["baseline_low"]) and np.allclose(base_hi, zp["baseline_high"])
    base_w = np.maximum(base_hi - base_lo, MIN_WIDTH)

    # ---------------- coverage audit (deterministic; no new resampling) ----
    targets = np.array([
        statistic(cs[cid[i]].reshape(-1), cd["statistic_name"], cd["statistic_parameters"])
        for i, cd in enumerate(cases_meta)])
    cov = np.zeros((ne, nc)); ml = np.zeros((ne, nc))
    mh = np.zeros((ne, nc)); mw = np.zeros((ne, nc))
    n_unique_boot = {}
    for i, cd in enumerate(cases_meta):
        c = cid[i]; S = cs[c]; P = crp[c]
        xb = S[np.arange(nrep)[:, None, None], P]  # -> (108, 374, 74) sample values
        bs = statistic(xb, cd["statistic_name"], cd["statistic_parameters"], axis=2)
        n_unique_boot[c] = int(np.unique(np.round(bs, 12)).size)
        cov[:, i] = ((clo[:, i, :] <= targets[i]) & (targets[i] <= chi[:, i, :])).mean(axis=1)
        ml[:, i] = (targets[i] < clo[:, i, :]).mean(axis=1)
        mh[:, i] = (targets[i] > chi[:, i, :]).mean(axis=1)
        mw[:, i] = (chi[:, i, :] - clo[:, i, :]).mean(axis=1)
    rep_stats = [statistic(cs[cid[i]], cd["statistic_name"], cd["statistic_parameters"], axis=1)
                 for i, cd in enumerate(cases_meta)]

    coverage_score = np.abs(cov - CONF)  # severity per (engine, case)
    # One-sided undercoverage with a +-2 binomial SE tolerance band (n=108 ->
    # SE ~= 0.028): over-coverage earns no credit, so wide engines cannot win
    # reliability on raw coverage (binding clarification #3).
    SE = float(np.sqrt(CONF * (1 - CONF) / nrep))
    under = np.clip(CONF - 2 * SE - cov, 0, None)          # (engine, case)

    # ---------------- coverage-side engine metrics ------------------------
    # Raw widths vs the naive percentile baseline swing 0.78..1.46 BY CASE for
    # every engine (percentile width varies with regime); engine-specific width
    # behaviour is therefore measured against the per-case cross-engine
    # consensus width (median across engines), isolating engine from regime.
    coverage_gap = coverage_score.mean(axis=1)             # reported metric
    width_ratio_cal = mw / base_w[None, :]                 # reported metric
    width_ratio = width_ratio_cal.mean(axis=1)             # reported metric
    wsc = np.log(np.maximum(mw, MIN_WIDTH))
    wsc = wsc - np.median(wsc, axis=0)                     # per-case consensus-relative
    lw = np.clip(wsc, -LOG_CLIP, LOG_CLIP)                 # engine width deviation
    tail_imbalance = np.abs(ml - mh).mean(axis=1)
    case_dispersion = np.std(under, axis=1) + np.std(lw, axis=1)

    # ---------------- probe families (all severity: higher = worse) --------
    # probe_00 centering error  |pos(stat in interval) - 0.5|
    # probe_01 per-case |coverage - nominal|
    # probe_02 disagreement of auxiliary probe_02 panel with the engine's own
    #          observed endpoints (perturbation robustness), width-normalized
    # probe_03 split instability: std of probe_03 endpoints over the 6 splits
    # probe_04 distance of observed endpoints from the transparent baseline
    wgt = np.maximum(oh - ol, MIN_WIDTH)
    pos = (stat_obs[None, :] - ol) / wgt
    pr00 = np.abs(pos - 0.5)
    pr01 = coverage_score
    pr02 = (np.abs(p2l - ol) + np.abs(p2h - oh)) / np.maximum(
        np.maximum(oh - ol, np.maximum(p2h - p2l, MIN_WIDTH)), MIN_WIDTH)
    pr03 = (p3l.std(axis=2) + p3h.std(axis=2)) / wgt
    pr04 = (np.abs(ol - base_lo[None, :]) + np.abs(oh - base_hi[None, :])) / base_w[None, :]
    probe_raw = np.stack([pr00, pr01, pr02, pr03, pr04])        # (5, engine, case)
    families = pman["probe_families"]
    assert len(families) == 5

    def minmax01(a, axis):
        a = np.moveaxis(a, axis, 0)
        lo, hi = a.min(0), a.max(0)
        rng = hi - lo
        out = np.where(rng > 1e-9, (a - lo) / np.where(rng > 1e-9, rng, 1.0), 0.0)
        return np.moveaxis(out, 0, axis)

    probe_score = minmax01(probe_raw, axis=1)      # normalized per (family, case)
    probe_metric = probe_raw.mean(axis=2)          # engine-level mean severity

    # ---------------- combined engine score --------------------------------
    # Components: 4 coverage-side severities + 5 probe-family mean severities
    # + alias_risk (forensic severity: max of baseline-alias and reflection-alias
    # evidence, both probe/geometry-derived).  Each component is min-max
    # normalized across the 9 engines, then averaged with equal weight.
    comp_names = ["undercoverage", "tail_imbalance", "abs_width_dev", "case_dispersion"]
    components_cov = [under.mean(axis=1), tail_imbalance, np.abs(lw).mean(axis=1),
                      case_dispersion]

    def combined_scores(exclude_family=None, alias_risk=None, clean_margin=None):
        # alias_risk (baseline/reflection/twin-copy forensic severity) and
        # clean_margin carry double weight: an engine that is a derived copy of
        # another, or whose failure-evidence profile is not clean, cannot be
        # 'most reliable' regardless of its raw coverage/probe metrics.
        comps = [v for _, v in zip(comp_names, components_cov)]
        for f_i in range(5):
            if exclude_family is not None and families[f_i] == exclude_family:
                continue
            comps.append(probe_metric[f_i])
        if alias_risk is not None and exclude_family != families[4]:
            comps.extend([alias_risk, alias_risk])
        if clean_margin is not None and exclude_family != families[4]:
            comps.extend([clean_margin, clean_margin])
        norm = [minmax01(np.asarray(v), axis=0) for v in comps]
        return np.mean(np.array(norm), axis=0)

    # ---------------- failure evidence (0..1 per label, higher = stronger) --
    p04m = pr04.mean(axis=1)
    # aliasing requires NEAR-ZERO distance to the transparent baseline; the
    # threshold 0.04 sits midway between engine_08 (~0.007) and the next
    # closest engine (~0.071), i.e. it flags genuine aliases only.
    ev_baseline = np.clip(1.0 - p04m / 0.04, 0, 1)

    ev_reflect = np.zeros(ne); reflect_partner = {}
    for a in range(ne):
        for b in range(a + 1, ne):
            wa, wb = chi[a] - clo[a], chi[b] - clo[b]
            if np.abs(wa - wb).max() / max(wa.mean(), MIN_WIDTH) >= 0.01:
                continue                                  # widths not identical -> no pair
            resid = []
            for i in range(nc):
                ca = (clo[a, i] + chi[a, i]) / 2; cb = (clo[b, i] + chi[b, i]) / 2
                resid.append(np.abs(ca + cb - 2 * rep_stats[i]).mean()
                             / max(wa[i].mean(), MIN_WIDTH))
            s = 1.0 - float(np.clip(np.mean(resid) / 0.05, 0, 1))
            if s > 0.5:
                # symmetric pair: the member FARTHER from the transparent
                # baseline is the reflected (derived) engine; the closer one is
                # handled by baseline_quantile_alias evidence instead.
                aliased, donor = (a, b) if p04m[a] >= p04m[b] else (b, a)
                ev_reflect[aliased] = max(ev_reflect[aliased], s)
                reflect_partner[aliased] = engine_ids[donor]

    c3 = case_ids.index("case_03")
    skewset = [i for i, cd in enumerate(cases_meta)
               if cd["regime"] in ("skewed_positive", "ratio_statistic")]
    othset = [i for i in range(nc) if i not in skewset]
    signed = pos - 0.5
    mean_skew = signed.mean(axis=1)
    sign_frac = np.maximum((signed > 0).mean(axis=1), (signed < 0).mean(axis=1))
    ev_shape = np.clip(np.abs(mean_skew) / 0.05, 0, 1) * sign_frac
    # regime-specific variant kept for interpretation only:
    skew_regime = signed[:, skewset].mean(axis=1)

    lw_dev_c3 = np.abs(lw[:, c3])          # lw is consensus-relative now
    pos_dev_c3 = np.abs(pos[:, c3] - 0.5)
    lw_excess = np.clip((lw_dev_c3 - np.median(lw_dev_c3)) / 0.06, 0, 1)
    pos_excess = np.clip((pos_dev_c3 - np.median(pos_dev_c3)) / 0.06, 0, 1)
    ev_discrete = 0.5 * lw_excess + 0.5 * pos_excess

    mean_lw, sd_lw = lw.mean(axis=1), lw.std(axis=1)
    # constant width deviation from the per-case consensus across ALL regimes
    ev_scale_consensus = np.clip(np.abs(mean_lw) / 0.08, 0, 1) * np.clip(1 - sd_lw / 0.05, 0, 1)
    # directed twin-copy test: engine a is a constant-SCALE COPY of donor b if
    # w_a/w_b is nearly constant (per-replication sd < 0.01) and != 1 by > 1%.
    # Direction of derivation: the member deviating MORE from the per-case
    # consensus width is the copy (the donor sits at consensus).
    ev_twin = np.zeros(ne); twin_donor = {}
    for a in range(ne):
        for b in range(ne):
            if a == b:
                continue
            r = (chi[a] - clo[a]) / np.maximum(chi[b] - clo[b], MIN_WIDTH)
            m, sd_r = float(r.mean()), float(r.std(axis=1).max())
            if sd_r < 0.01 and abs(m - 1.0) > 0.01:
                if abs(mean_lw[a]) <= abs(mean_lw[b]):
                    continue                      # a is closer to consensus -> donor
                sc_ = (1.0 - sd_r / 0.01) * min(abs(m - 1.0) / 0.05, 1.0)
                if sc_ > ev_twin[a]:
                    ev_twin[a] = sc_; twin_donor[a] = engine_ids[b]
    ev_scale = np.clip(np.maximum(ev_scale_consensus, ev_twin), 0, 1)

    def zmad(v):
        m = np.median(v)
        return (v - m) / (np.median(np.abs(v - m)) + EPS)
    ev_noise = np.clip(
        0.5 * np.clip(np.maximum(zmad(case_dispersion), 0) / 2.0, 0, 1)
        + 0.5 * np.clip(np.maximum(zmad(probe_metric[3]), 0) / 2.0, 0, 1)
        + 0.25 * np.clip(np.maximum(zmad(coverage_gap), 0) / 2.0, 0, 1), 0, 1)

    alias_risk = np.maximum(np.maximum(ev_baseline, ev_reflect), ev_twin)
    fail_keys = [l for l in labels if l != "reliable_engine"]

    def build(alias_risk_v, clean_v):
        sc = combined_scores(alias_risk=alias_risk_v, clean_margin=clean_v)
        rel = np.clip(0.95 * (1.0 - minmax01(sc, axis=0)), 0, 1)
        e = {"reliable_engine": rel, "baseline_quantile_alias": ev_baseline,
             "reflection_alias": ev_reflect, "discrete_boundary_mismatch": ev_discrete,
             "shape_correction_mismatch": ev_shape, "scale_response_mismatch": ev_scale,
             "noise_amplifying_engine": np.clip(ev_noise, 0, 1)}
        return sc, e

    # fixed point: clean_margin severity = max(0, 0.5 - max failure evidence)
    # inverted to severity 1-clean; converged in a few iterations.
    clean = np.ones(ne)
    for _ in range(30):
        sc, e = build(alias_risk, clean)
        mx = np.max(np.stack([e[l] for l in fail_keys]), axis=0)
        new_clean = np.clip(0.5 - mx, 0, None)
        if np.allclose(new_clean, clean, atol=1e-12):
            clean = new_clean
            break
        clean = new_clean
    sc, e = build(alias_risk, clean)
    # residual clean severity column for the composite (1 = clean profile)
    clean_sev = 1.0 - minmax01(clean, axis=0)
    engine_score = combined_scores(alias_risk=alias_risk, clean_margin=clean_sev)
    engine_score = engine_score - minmax01(engine_score, axis=0) * 0  # keep raw scale
    ev = e
    ev["reliable_engine"] = np.clip(0.95 * (1.0 - minmax01(engine_score, axis=0)), 0, 1)
    for k, v in ev.items():
        assert np.all(np.isfinite(v)) and np.all(v >= 0), k

    # predicted label = argmax evidence; ties -> vocabulary order
    pred = {}
    for ei, e_ in enumerate(engine_ids):
        best = max(range(len(labels)), key=lambda li: (round(float(ev[labels[li]][ei]), 9), -li))
        pred[e_] = labels[best]

    # ---------------- selection: argmin combined score, id tie-break -------
    order = sorted(range(ne), key=lambda ei: (np.round(engine_score[ei], 9), engine_ids[ei]))
    sel_ei = order[0]
    sel = engine_ids[sel_ei]

    # ---------------- write tables -----------------------------------------
    os.makedirs(R(), exist_ok=True)
    fam_idx = {f: i for i, f in enumerate(families)}

    with open(R("engine_audit.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(man["audit_columns"]["engine_audit"])
        for ei, e in enumerate(engine_ids):
            w.writerow([e, f"{coverage_gap[ei]:.6f}", f"{tail_imbalance[ei]:.6f}",
                        f"{width_ratio[ei]:.6f}", f"{case_dispersion[ei]:.6f}"]
                       + [f"{probe_metric[k, ei]:.6f}" for k in range(5)]
                       + [f"{engine_score[ei]:.6f}"])

    with open(R("coverage_audit.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(man["audit_columns"]["coverage_audit"])
        for ci, c in enumerate(case_ids):
            for ei, e in enumerate(engine_ids):
                w.writerow([c, cases_meta[ci]["regime"], e, f"{CONF:.4f}", f"{cov[ei, ci]:.6f}",
                            f"{mw[ei, ci]:.6f}", f"{ml[ei, ci]:.6f}", f"{mh[ei, ci]:.6f}",
                            nrep, f"{coverage_score[ei, ci]:.6f}"])

    with open(R("probe_audit.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(man["audit_columns"]["probe_audit"])
        for ci, c in enumerate(case_ids):
            for f in families:
                for ei, e in enumerate(engine_ids):
                    k = fam_idx[f]
                    w.writerow([c, f, e, f"{probe_raw[k, ei, ci]:.6f}",
                                f"{probe_score[k, ei, ci]:.6f}"])

    with open(R("case_probe_profile.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(man["audit_columns"]["case_probe_profile"])
        for ci, c in enumerate(case_ids):
            for ei, e in enumerate(engine_ids):
                sig = [probe_score[k, ei, ci] for k in range(5)]
                w.writerow([c, e] + [f"{s:.6f}" for s in sig] + [f"{np.mean(sig):.6f}"])

    with open(R("failure_evidence.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(man["audit_columns"]["failure_evidence"])
        for ei, e in enumerate(engine_ids):
            sc = [round(float(ev[l][ei]), 9) for l in labels]
            rank = {li: 1 + sorted(range(len(labels)), key=lambda j: (-sc[j], j)).index(li)
                    for li in range(len(labels))}
            for li, l in enumerate(labels):
                w.writerow([e, l, f"{sc[li]:.6f}", rank[li], 1 if pred[e] == l else 0])

    # family ablation: SAME combined ranking used for selection, one family's
    # contribution (and, for probe_04, the derived alias-risk term) removed.
    with open(R("family_ablation.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(man["audit_columns"]["family_ablation"])
        rows_ab = []
        for f in [None] + families:
            s = combined_scores(exclude_family=f, alias_risk=alias_risk, clean_margin=clean_sev)
            o = sorted(range(ne), key=lambda ei: (np.round(s[ei], 9), engine_ids[ei]))
            top, second = engine_ids[o[0]], engine_ids[o[1]]
            rank_sel = [i for i, ei in enumerate(o) if ei == sel_ei][0] + 1
            margin = abs(float(s[o[1]]) - float(s[o[0]]))
            rows_ab.append([f or "none", top, rank_sel, second, f"{margin:.6f}"])
            w.writerow(rows_ab[-1])

    # interval summary (binding #1: selected endpoints come from the ANONYMOUS
    # OBSERVED-CASE panel only; baseline = transparent percentile reference)
    with open(R("interval_summary.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["case_id", "statistic_name", "observed_stat", "selected_engine_id",
                    "selected_low", "selected_high", "baseline_low", "baseline_high",
                    "selected_width", "baseline_width_ratio"])
        for ci, c in enumerate(case_ids):
            lo, hi = ol[sel_ei, ci], oh[sel_ei, ci]
            bw = max(base_hi[ci] - base_lo[ci], MIN_WIDTH)
            w.writerow([c, cases_meta[ci]["statistic_name"], f"{stat_obs[ci]:.6f}", sel,
                        f"{lo:.6f}", f"{hi:.6f}", f"{base_lo[ci]:.6f}", f"{base_hi[ci]:.6f}",
                        f"{hi - lo:.6f}", f"{(hi - lo) / bw:.6f}"])

    with open(R("failure_modes.json"), "w") as fh:
        json.dump({"selected_engine_id": sel,
                   "failure_modes": {e: pred[e] for e in engine_ids}}, fh, indent=2)
    with open(R("selected_engine.json"), "w") as fh:
        json.dump({"selected_engine_id": sel, "selected_failure_mode": pred[sel],
                   "selected_engine_score": round(float(engine_score[sel_ei]), 6)}, fh, indent=2)

    se_binom = float(np.sqrt(CONF * (1 - CONF) / nrep))
    warnings = {}
    for ci, c in enumerate(case_ids):
        fl = []
        if cov[sel_ei, ci] < CONF - 1.96 * se_binom:
            fl.append(f"selected_engine_undercoverage_below_nominal({cov[sel_ei, ci]:.3f}"
                      f"<{CONF - 1.96 * se_binom:.3f})")
        if cov[sel_ei, ci] > CONF + 1.96 * se_binom:
            fl.append(f"selected_engine_overcoverage_above_nominal({cov[sel_ei, ci]:.3f})")
        if n_unique_boot[c] < 100:
