def _make_figure(path, A):
    try:
        import matplotlib
        matplotlib.use('Agg')
        import matplotlib.pyplot as plt
    except ImportError:
        _fallback_figure(path, A)
        return
    ne, nc = len(A['engine_ids']), len(A['case_ids'])
    labels, ev, pred, sel, sel_ei = A['labels'], A['ev'], A['pred'], A['sel'], A['sel_ei']
    fig, ax = plt.subplots(2, 3, figsize=(16, 9))
    x = np.arange(nc); xs = np.arange(ne)
    a = ax[0, 0]
    for ei in range(ne):
        a.plot(x, A['cov'][ei], 'o-', ms=3, lw=2.5 if ei == sel_ei else 1,
               color='green' if ei == sel_ei else None, label=A['engine_ids'][ei])
    a.axhline(A['CONF'], ls='--', c='k'); a.set_xticks(x)
    a.set_xticklabels(A['case_ids'], rotation=45, fontsize=7)
    a.set_title(f"empirical coverage vs nominal ({A['CONF']:.4f})"); a.legend(fontsize=5, ncol=2)
    a = ax[0, 1]
    for ei in range(ne):
        a.plot(x, A['width_ratio_cal'][ei], 'o-', ms=3, lw=2.5 if ei == sel_ei else 1,
               color='green' if ei == sel_ei else None)
    a.axhline(1.0, ls='--', c='k'); a.set_xticks(x)
    a.set_xticklabels(A['case_ids'], rotation=45, fontsize=7)
    a.set_title('calibration mean width / transparent baseline width')
    a = ax[0, 2]
    im = a.imshow(A['probe_score'].mean(axis=2), aspect='auto', cmap='Reds', vmin=0, vmax=1)
    a.set_xticks(range(5)); a.set_xticklabels(A['families'], rotation=45, fontsize=7)
    a.set_yticks(xs); a.set_yticklabels(A['engine_ids'], fontsize=7)
    a.set_title('probe severity (mean over cases)'); fig.colorbar(im, ax=a, fraction=0.046)
    a = ax[1, 0]
    a.bar(xs, A['case_dispersion'], color=['green' if i == sel_ei else 'steelblue' for i in range(ne)])
    a.set_xticks(xs); a.set_xticklabels(A['engine_ids'], rotation=90, fontsize=7)
    a.set_title('case_dispersion (severity)')
    a = ax[1, 1]
    wdt = 0.4
    a.bar(xs - wdt / 2, A['ml'].mean(axis=1), wdt, label='miss low')
    a.bar(xs + wdt / 2, A['mh'].mean(axis=1), wdt, label='miss high')
    a.axhline((1 - A['CONF']) / 2, ls='--', c='k')
    a.set_xticks(xs); a.set_xticklabels(A['engine_ids'], rotation=90, fontsize=7)
    a.set_title('mean tail miss rates'); a.legend(fontsize=7)
    a = ax[1, 2]
    mat = np.array([[ev[l][ei] for ei in range(ne)] for l in labels])
    im = a.imshow(mat, aspect='auto', cmap='viridis', vmin=0, vmax=1)
    a.set_xticks(xs); a.set_xticklabels(A['engine_ids'], rotation=90, fontsize=7)
    a.set_yticks(range(len(labels))); a.set_yticklabels([l[:24] for l in labels], fontsize=6)
    for li in range(len(labels)):
        for ei in range(ne):
            if pred[A['engine_ids'][ei]] == labels[li]:
                a.text(ei, li, '*', ha='center', va='center', c='red', fontsize=12)
    a.set_title('failure evidence (* = predicted label)')
    fig.suptitle(f'Anonymous CI-engine audit - selected: {sel} ({pred[sel]}); '
                 'severity orientation: lower/brighter = better')
    fig.tight_layout(); fig.savefig(path, dpi=140)


