               bb_slope=params["bb_slope"], bb_intercept=params["bb_intercept"])
    print("=" * 78)
    print("COUPLED FARQUHAR/COLLATZ + BALL-BERRY -- run diagnostics")
    print("=" * 78)
    print(f"pathway = {params['pathway']!r}  (single global field; applied to "
          f"sun, shade AND all cases; C3 branch dormant)")
    print(f"vcmax25={params['vcmax25']}  n_factor={params['n_factor']}  "
          f"alpha_q={params['alpha_q']}  bb_slope={params['bb_slope']}  "
          f"b0={params['bb_intercept']}")
    print(f"btran (from forcing) = {sorted(forcing.btran.unique())}   "
          f"ca = {sorted(forcing.co2_pa.unique())} Pa   "
          f"rb = {sorted(forcing.rb_sm.unique())} s/m   "
          f"p_atm = {sorted(forcing.p_atm_Pa.unique())} Pa")
    print(f"esat = CLM/Buck(611.21 Pa)   R = {R_GAS}   tol = {TOL_PA} Pa   "
          f"omega = {OMEGA}   max_iter = {MAX_ITER}   residual tol = "
          f"{RESID_TOL_PA} Pa")
    print(f"figure backend = {'matplotlib' if HAVE_MPL else 'bundled numpy raster (no matplotlib in this environment)'}")

    def make_pp(row):
        pp = dict(pp0)
        pp.update(t_air_k=float(row.t_air_K), p_atm=float(row.p_atm_Pa),
                  ca=float(row.co2_pa), o2_pa=float(row.o2_pa),
                  vpd=float(row.vpd_Pa), rb=float(row.rb_sm),
                  btran=float(row.btran))
        return pp

    default_ci = 0.7 * float(forcing.co2_pa.iloc[0])
    print(f"leaf_fluxes rows use generic start ci_init = 0.7*ca = "
          f"{default_ci:.4f} Pa (forcing.csv supplies no ci_init)")

    stats = {"cross_hist": {}, "n_lit": 0, "n_widened": 0}
    rows, diag_rows = [], []
    for idx, fr in forcing.iterrows():
        pp = make_pp(fr)
        rec = {"time_hr": fr.time_hr}
        for stream, pcol in (("sun", "par_sun_wm2"), ("shade", "par_shade_wm2")):
            ans = solve_point(float(fr[pcol]), pp, default_ci, stats=stats,
                              tag=f"row{idx}/{stream}")
            r = residual_report(ans, pp)
            worst = max(r[0], r[2], r[3])
            if ans["par"] > 0.0:
                worst = max(worst, r[1])            # BB applies only in light
                if abs(r[1]) > 1e-9:
                    raise AssertionError(f"BB residual {r[1]} at row{idx}/{stream}")
            if worst > RESID_TOL_PA:
                raise AssertionError(f"closure residual {worst} at row{idx}/"
                                     f"{stream}: {r}")
            rec[f"A_{stream}"] = ans["a"]
            rec[f"rs_{stream}"] = ans["rs"]
            rec[f"ci_{stream}"] = ans["ci"]
            rec[f"gs_{stream}"] = ans["gs"]
            diag_rows.append(dict(idx=idx, time_hr=fr.time_hr, stream=stream,
                                  par=ans["par"], apar=ans["apar"],
                                  vcmax=ans["vcmax"], rd=ans["rd"], hs=ans["hs"],
                                  binding=ans["binding"], A=ans["a"], ci=ans["ci"],
                                  cs=ans["cs"], gs=ans["gs"], rs=ans["rs"],
                                  n_iter=ans["n_iter"], last_step_pa=ans["last_step"],
                                  resid_cs_Pa=r[0], resid_gs_mol=r[1],
                                  resid_rs_s=r[2], resid_ci_Pa=r[3],
                                  night_bb_dev_mol=(r[1] if ans["par"] <= 0 else 0.0),
                                  widened=ans["widened"],
                                  widen_reason=ans.get("widen_reason", "night")))
        rows.append(rec)

    flux = pd.DataFrame(rows)[["time_hr", "A_sun", "A_shade", "rs_sun",
                               "rs_shade", "ci_sun", "ci_shade", "gs_sun",
                               "gs_shade"]]
    diag = pd.DataFrame(diag_rows)

    # ------------------------------ test cases -------------------------------
    print("\n" + "-" * 78)
    print("CASE CONVERGENCE (cases use par_sun_wm2 -> sunlit leaf)")
    print("-" * 78)
    cstats = {"cross_hist": {}, "n_lit": 0, "n_widened": 0}
    case_rows = []
    for c in cases:
        fr = forcing.iloc[int(c["forcing_index"])]
        pp = make_pp(fr)
        ans = solve_point(float(fr.par_sun_wm2), pp, float(c["ci_init_pa"]),
                          stats=cstats, tag=c["case_id"])
        r = residual_report(ans, pp)
        if max(r) > RESID_TOL_PA:
            raise AssertionError(f"case {c['case_id']} residual {r}")
        print(f"{c['case_id']} idx={c['forcing_index']} "
              f"ci_init={c['ci_init_pa']:>9.4f} -> ci_final="
              f"{ans['ci']:>12.8f}  A_final={ans['a']:>9.6f}  rs_final="
              f"{ans['rs']:>10.6f}  n_iter={ans['n_iter']:>3d}  limit="
              f"{ans['binding']:>3s}  widened={str(ans['widened']):>5s}  "
              f"resid(cs,gs,rs,Ci)=({r[0]:.1e},{r[1]:.1e},{r[2]:.1e},{r[3]:.1e})")
        case_rows.append(dict(case_id=c["case_id"], ci_init_pa=c["ci_init_pa"],
                              ci_final_pa=ans["ci"], A_final=ans["a"],
                              rs_final=ans["rs"],
                              n_iterations=int(ans["n_iter"])))
    cdf = pd.DataFrame(case_rows)

    # --- CHECK 1: all cases must reach the SAME coupled fixed point ----------
    ci_sp = cdf.ci_final_pa.max() - cdf.ci_final_pa.min()
    a_sp = cdf.A_final.max() - cdf.A_final.min()
    rs_sp = cdf.rs_final.max() - cdf.rs_final.min()
    print("\n" + "-" * 78)
    print("CHECK 1 -- common fixed point from ci_init = 0.1 .. 1.1 x ca")
    print("-" * 78)
    print(f"  spread ci_final = {ci_sp:.3e} Pa | A_final = {a_sp:.3e} "
          f"umol m-2 s-1 | rs_final = {rs_sp:.3e} s m-1")
    if max(ci_sp, a_sp, rs_sp) > 10 * TOL_PA:
        raise SystemExit("FATAL: cases did not converge to a common fixed "
                         "point -- solver bug, not shipping the table")
    print(f"  PASS: identical to within {10*TOL_PA:.0e} "
          f"(n_iterations differ only because starts are farther from the root)")

    # --- CHECK 2: uniqueness, bracket widening, binding limitation -----------
    print("\n" + "-" * 78)
    print("CHECK 2 -- root uniqueness / bracket widening / binding limitation")
    print("-" * 78)
    print(f"  time series: lit (row,stream) solves = {stats['n_lit']}, "
          f"sign-change histogram = {stats['cross_hist']}, rows needing bracket "
          f"widening beyond ca = {stats['n_widened']}")
    print(f"  cases:       solves = {cstats['n_lit']}, sign-change histogram = "
          f"{cstats['cross_hist']}, needing hi = 1.5*ci_init > ca = "
          f"{cstats['n_widened']}")
    print(f"  widening reasons: time series = "
          f"{stats.get('reasons', {})}, cases = {cstats.get('reasons', {})}")
    if set(stats["cross_hist"]) | set(cstats["cross_hist"]) != {1}:
        raise SystemExit("FATAL: non-unique root encountered")
    print("  PASS: exactly one sign change of the residual per lit solve")
    lit = diag[diag.par > 0]
    print("\n  binding limitation over lit rows:")
    print(lit.groupby(["stream", "binding"]).size().to_string())
    sh = lit[lit.stream == "shade"]
    print(f"\n  DIAGNOSTIC shade: light-limited (Wj) fraction of lit hours = "
          f"{(sh.binding == 'Wj').mean():.3f} "
          f"({int((sh.binding == 'Wj').sum())}/{len(sh)}) -> explains the "
          f"dawn/dusk ramp of A_shade")
    su = lit[lit.stream == "sun"]
    print(f"  DIAGNOSTIC sun:   light-limited (Wj) fraction of lit hours = "
          f"{(su.binding == 'Wj').mean():.3f}")
    xover = forcing.p_atm_Pa.iloc[0] / 4000.0
    print(f"  We == Wc crossover Ci = p_atm/4000 = {xover:.4f} Pa")
    su_real = su[su.par >= 1.0]
    print(f"  sunlit A over lit hours with par>=1 W/m2: min={su_real.A.min():.4f} "
          f"max={su_real.A.max():.4f} umol m-2 s-1 (n={len(su_real)}); the only "
          f"lower outliers are the {int((su.par < 1).sum())} flagged "
          f"near-zero-PAR rows (A={su[su.par<1].A.iloc[0]:.4f})")
    print(f"  sunlit A == Wc - Rd on {(su.binding=='Wc').sum()}/{len(su)} lit "
          f"rows; We-binding rows = {int((su.binding=='We').sum())} "
          f"(no lit row has Ci below the {xover:.2f} Pa We=Wc crossover)")
    print(f"  Vcmax(T)*n_factor*btran sets the plateau: "
          f"A_sun = Wc-Rd with Wc in [{su_real.vcmax.min():.3f}, "
          f"{su_real.vcmax.max():.3f}] over lit hours")

    # --- CHECK 3: alignment / headers / finiteness ---------------------------
    print("\n" + "-" * 78)
    print("CHECK 3 -- shape, row alignment, headers, finiteness")
    print("-" * 78)
    assert len(flux) == len(forcing) == 120, "row-count mismatch"
    assert np.array_equal(flux.time_hr.values, forcing.time_hr.values), \
        "time_hr misalignment with forcing.csv"
    assert list(flux.columns) == ["time_hr", "A_sun", "A_shade", "rs_sun",
                                  "rs_shade", "ci_sun", "ci_shade", "gs_sun",
                                  "gs_shade"]
    assert list(cdf.columns) == ["case_id", "ci_init_pa", "ci_final_pa",
                                 "A_final", "rs_final", "n_iterations"]
    assert np.isfinite(flux.to_numpy()).all(), "NaN/inf in leaf_fluxes"
    assert np.isfinite(cdf.select_dtypes(include=[np.number]).to_numpy()
                       ).all(), "NaN/inf in case_convergence"
    night = forcing.par_sun_wm2.values <= 0
    print(f"  leaf_fluxes.csv: {len(flux)} rows, 1:1 with forcing.csv, "
          f"time_hr matched exactly; headers exact; no NaN/inf")
    print(f"  night rows (PAR<=0) = {int(night.sum())}; all night gs == b0 "
          f"exactly: "
          f"{bool(np.all(flux.gs_sun[night] == params['bb_intercept']) and np.all(flux.gs_shade[night] == params['bb_intercept']))}")
    print(f"  night A = -Rd: range [{flux.A_sun[night].min():.6f}, "
          f"{flux.A_sun[night].max():.6f}] umol m-2 s-1; night Ci > ca holds: "
          f"{bool((flux.ci_sun[night] > forcing.co2_pa.values[night]).all())}")
    print(f"  re-evaluated closure residuals over all {len(diag)} solves:  "
          f"max |dr_cs| = {diag.resid_cs_Pa.max():.2e} Pa,  "
          f"max |dr_ci| = {diag.resid_ci_Pa.max():.2e} Pa,  "
          f"max |dr_rs| = {diag.resid_rs_s.max():.2e} s/m  "
          f"(all <= {RESID_TOL_PA:.0e}); max fixed-point step at convergence = "
          f"{np.nanmax(diag.last_step_pa.values):.2e} Pa")
    print(f"  Ball-Berry residual (light rows only): max |dr_gs| = "
          f"{diag[diag.par>0].resid_gs_mol.max():.2e} mol/m2/s")
    print(f"  NOTE (by design, not a failure): at night gs = b0 rather than "
          f"Ball-Berry evaluated at A<0, so |gs - BB(A=-Rd)| = "
          f"{diag[diag.par<=0].night_bb_dev_mol.max():.3e} mol/m2/s "
          f"({100*diag[diag.par<=0].night_bb_dev_mol.max()/params['bb_intercept']:.1f}% of b0) "
          f"on the {int((diag.par<=0).sum())} night rows.")
    print(f"  gs safety floor (1e-6) never bound (asserted in solve_point)")
    nz = forcing[(forcing.par_sun_wm2 > 0) & (forcing.par_sun_wm2 < 1.0)]
    print(f"  FLAGGED near-zero-but-positive PAR rows solved in the LIGHT "
          f"branch (literal PAR<=0 rule): time_hr = {nz.time_hr.tolist()} "
          f"(par = {nz.par_sun_wm2.iloc[0]:.3e} W m-2 s-1)")

    # ------------------------------- write -----------------------------------
    flux.to_csv(os.path.join(RESULTS, "leaf_fluxes.csv"), index=False)
    cdf.to_csv(os.path.join(RESULTS, "case_convergence.csv"), index=False)
    diag.to_csv(os.path.join(RESULTS, "solver_diagnostics.csv"), index=False)

    make_figure(flux, forcing.par_sun_wm2.values <= 0,
                os.path.join(RESULTS, "diurnal.png"),
                f"Coupled Farquhar/Collatz + Ball-Berry leaf fluxes "
                f"(pathway = {params['pathway']}; 5 repeated diurnal cycles)")
    # ---- self-audit of the WRITTEN files (re-read from disk, recompute) -----
    w_flux = pd.read_csv(os.path.join(RESULTS, "leaf_fluxes.csv"))
    w_case = pd.read_csv(os.path.join(RESULTS, "case_convergence.csv"))
    assert list(w_flux.columns) == list(flux.columns)
    assert list(w_case.columns) == list(cdf.columns)
    assert np.array_equal(w_flux.time_hr.values, forcing.time_hr.values)
    m = dict(A=0.0, cs=0.0, ci=0.0, rs=0.0, gs=0.0)
    for i, fr in forcing.iterrows():
        vcm = params["vcmax25"] * vcmax_temperature(fr.t_air_K) \
            * params["n_factor"] * fr.btran
        cf = fr.p_atm_Pa / (R_GAS * fr.t_air_K)
        hsv = min(max(1.0 - fr.vpd_Pa / esat_buck(fr.t_air_K - 273.15),
                      0.25), 1.0)
        for s, pcol in (("sun", "par_sun_wm2"), ("shade", "par_shade_wm2")):
            A = w_flux[f"A_{s}"][i]; rs = w_flux[f"rs_{s}"][i]
            ci = w_flux[f"ci_{s}"][i]; gs = w_flux[f"gs_{s}"][i]
            am = A * UMOL_TO_MOL
            cs = fr.co2_pa - KB_H2O * fr.rb_sm * am / cf * fr.p_atm_Pa
            exp_A = (-0.015 * vcm if fr[pcol] <= 0 else
                     min(vcm, params["alpha_q"] * 4.6 * fr[pcol],
                         4000.0 * vcm * ci / fr.p_atm_Pa) - 0.015 * vcm)
            exp_gs = (params["bb_intercept"] if fr[pcol] <= 0 else
                      params["bb_slope"] * am * hsv / cs * fr.p_atm_Pa
                      + params["bb_intercept"])
            m["A"] = max(m["A"], abs(A - exp_A))
            m["gs"] = max(m["gs"], abs(gs - exp_gs))
            m["rs"] = max(m["rs"], abs(rs - cf / gs))
            m["ci"] = max(m["ci"], abs(ci - (cs - KB_CO2 * rs * am / cf
                                             * fr.p_atm_Pa)))
            m["cs"] = max(m["cs"], abs(ci + KB_CO2 * rs * am / cf * fr.p_atm_Pa
                                       - cs))          # Ci inverted independently
    print("\n" + "-" * 78)
    print("SELF-AUDIT of written results/leaf_fluxes.csv (re-read from disk)")
    print("-" * 78)
    print("  max |A - (hard-min - Rd)| = %.2e umol/m2/s | max |gs - gs(BB or b0)|"
          " = %.2e mol/m2/s" % (m["A"], m["gs"]))
    print("  max |rs - cf/gs| = %.2e s/m | max |Ci - (cs - 1.65 rs A/cf p)| = "
          "%.2e Pa | max |cs(rb) - cs(inverted from Ci)| = %.2e Pa"
          % (m["rs"], m["ci"], m["cs"]))
    if max(m.values()) > 1e-6:
        raise SystemExit("FATAL: written table does not satisfy the closure")
    print("  PASS: every written row satisfies all four gas-diffusion relations "
          "+ the hard-minimum assimilation identity")
    assert len(w_case) == len(cases)
    assert np.array_equal(w_case.case_id.values,
                          np.array([c["case_id"] for c in cases]))
    ci_in = np.array([c["ci_init_pa"] for c in cases], float)
    ci_echo = max(abs(w_case.ci_init_pa.values - ci_in))
    # CSV text is not bit-exact for every float (<=1 ULP here), so compare to a
    # tolerance far below any physical significance and report the deviation.
    assert ci_echo < 1e-12, f"ci_init_pa echo drifted by {ci_echo}"
    assert int(w_case.n_iterations.min()) >= 1
    print(f"  PASS: case_convergence.csv has {len(w_case)} rows, case_id echoed "
          f"exactly, ci_init_pa echoed to {ci_echo:.1e} Pa (CSV text rounding), "
          f"n_iterations >= 1 "
          f"(range {int(w_case.n_iterations.min())}-"
          f"{int(w_case.n_iterations.max())})")
    # ---- dormant-branch smoke test: the C3 switch works but is NOT used -----
    fr12 = forcing.iloc[12]
    pp12 = make_pp(fr12)
    vc12 = pp12["vcmax25"] * vcmax_temperature(fr12.t_air_K) \
        * pp12["n_factor"] * fr12.btran
    a3, wc3, wj3, we3, rd3, bind3, gs3 = photosynthesis(
        "C3", 30.0, vc12, 4.6 * fr12.par_sun_wm2, pp12["alpha_q"],
        fr12.o2_pa, fr12.p_atm_Pa, fr12.t_air_K)
    _q = (fr12.t_air_K - 273.15 - 25.0) / 10.0
    # textbook form uses the O2 PARTIAL PRESSURE (Pa); the brief's literal form
    # multiplies o2_pa by an extra 0.21, i.e. it double-counts O2 by 0.21.
    gam_txt = 0.5 * (KC25 * Q10_KC ** _q) / (KO25 * Q10_KO ** _q) * fr12.o2_pa
    print("\n" + "-" * 78)
    print("DORMANT C3 BRANCH SMOKE TEST (executed for validation only; no "
          "output file depends on it)")
    print("-" * 78)
    print(f"  C3 at Ci=30 Pa, row 12: Wc={wc3:.4f} Wj={wj3:.4f} We={we3:.4f} "
          f"Rd={rd3:.4f} -> A={a3:.4f} (binds: {bind3})")
    print(f"  Gamma_star literal 0.5*(Kc/Ko)*o2_pa*0.21 = {gs3:.4f} Pa vs "
          f"textbook 0.5*(Kc/Ko)*o2_pa = {gam_txt:.4f} Pa -> ratio "
          f"{gs3/gam_txt:.4f} = the extra 0.21 factor (the O2 double-count "
          f"noted in the plan). Implemented literally, NOT corrected, and "
          f"unused because pathway = C4.")
    print(f"  (assert dormant path is selectable and finite: "
          f"{bool(np.isfinite(a3))})")
    assert params["pathway"].upper() == "C4", \
        "outputs below were validated for C4; re-derive if pathway changes"

    print("\nwrote results/leaf_fluxes.csv, results/case_convergence.csv, "
          "results/diurnal.png (+ results/solver_diagnostics.csv)")

    print("\n" + "-" * 78)
    print("results/leaf_fluxes.csv (head) | results/case_convergence.csv")
    print("-" * 78)
    print(flux.head(6).to_string(index=False))
    print(cdf.to_string(index=False))
