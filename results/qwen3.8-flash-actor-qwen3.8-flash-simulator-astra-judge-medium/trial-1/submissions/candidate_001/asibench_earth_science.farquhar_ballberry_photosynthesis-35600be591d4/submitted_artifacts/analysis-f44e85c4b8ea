# --------------------------------------------------------------------- consts
R_GAS = 8.314          # J mol-1 K-1
UMOL_TO_MOL = 1e-6     # A [umol m-2 s-1] -> A_mol [mol m-2 s-1]
KB_H2O = 1.37          # CO2/H2O boundary-layer ratio (cs term)
KB_CO2 = 1.65          # CO2/H2O mesophyll+boundary ratio (Ci term)
KC25, KO25 = 30.0, 30000.0                  # Pa
Q10_VCMAX, Q10_KC, Q10_KO = 2.4, 2.1, 1.2   # (Vcmax, Kc, Ko)
TOL_PA = 1e-8          # fixed-point tolerance on Ci (Pa)
MAX_ITER = 200
OMEGA = 0.5            # fixed-point damping
RESID_TOL_PA = 1e-6    # acceptance threshold on re-evaluated Ci residual
GS_FLOOR = 1e-6        # mol m-2 s-1 safety floor; asserted never to bind

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "data")
RESULTS = os.path.join(HERE, "results")


def esat_buck(t_c):
    """CLM/Buck saturation vapour pressure over water [Pa], t_c in degC."""
    return 611.21 * np.exp((18.678 - t_c / 234.5) * (t_c / (257.14 + t_c)))


def vcmax_temperature(t_air_k):
    """CLM/Noah-MP Q10 temperature response incl. high-T inhibition."""
    t_c = t_air_k - 273.15
    t_k = t_c + 273.16
    q10 = Q10_VCMAX ** ((t_c - 25.0) / 10.0)
    inhib = 1.0 + np.exp((-2.2e5 + 710.0 * t_k) / (R_GAS * t_k))
    return q10 / inhib


def photosynthesis(pathway, ci, vcmax, apar, alpha_q, o2_pa, p_atm, t_air_k):
    """Return (A, Wc, Wj, We, Rd, binding, Gamma_star).  A in umol m-2 s-1."""
    rd = 0.015 * vcmax                      # Rd follows the scaled Vcmax object
    gamma_star = 0.0
    if pathway.upper() == "C3":
        # DORMANT for this dataset (pathway == "C4").
        q = (t_air_k - 273.15 - 25.0) / 10.0
        kc = KC25 * Q10_KC ** q
        ko = KO25 * Q10_KO ** q
        # literal per brief: uses o2_pa AND an extra 0.21 factor, i.e. an O2
        # double-count relative to textbook Gamma* = 0.5*(Kc/Ko)*O2_molefrac.
        gamma_star = 0.5 * (kc / ko) * o2_pa * 0.21
        j = alpha_q * apar                  # linear J, no curvature
        wc = vcmax * (ci - gamma_star) / (ci + kc * (1.0 + o2_pa / ko))
        wj = j * (ci - gamma_star) / (4.0 * ci + 8.0 * gamma_star)
        we = 0.5 * vcmax
    elif pathway.upper() == "C4":
        wc = vcmax
        wj = alpha_q * apar                 # NOT scaled by btran / n_factor
        we = 4000.0 * vcmax * ci / p_atm
    else:
        raise ValueError(f"unknown pathway {pathway!r}")

    w = min(min(wc, wj), we)                # HARD minimum, no soft colimiting
    binding = "Wc" if abs(wc - w) <= 1e-12 * max(1.0, abs(w)) else (
              "Wj" if abs(wj - w) <= 1e-12 * max(1.0, abs(w)) else "We")
    return w - rd, wc, wj, we, rd, binding, gamma_star


def closure(ci, a, ca, rb, cf, p_atm, hs, bb_slope, bb_intercept):
    """cs -> gs -> rs -> Ci_new for a given A (explicit once A is known)."""
    a_mol = a * UMOL_TO_MOL
    cs = ca - KB_H2O * rb * a_mol / cf * p_atm
    gs_raw = bb_slope * a_mol * hs / cs * p_atm + bb_intercept
    gs = max(gs_raw, GS_FLOOR)
    rs = cf / gs
    ci_new = cs - KB_CO2 * rs * a_mol / cf * p_atm
    return a_mol, cs, gs_raw, gs, rs, ci_new


def solve_point(par, pp, ci_init_pa, stats=None, tag=""):
    """Solve the coupled Ci/A/gs/rs/cs fixed point for one (row, stream).

    pp: dict of parameters/forcing scalars for this point.
    Returns dict with a, gs, rs, cs, ci, n_iter, binding, diagnostics.
    """
    t_air_k, p_atm, ca, o2_pa = pp["t_air_k"], pp["p_atm"], pp["ca"], pp["o2_pa"]
    vcmax = pp["vcmax25"] * vcmax_temperature(t_air_k) * pp["n_factor"] * pp["btran"]
    cf = p_atm / (R_GAS * t_air_k)
    hs = min(max(1.0 - pp["vpd"] / esat_buck(t_air_k - 273.15), 0.25), 1.0)
    apar = 4.6 * par                                    # no absorptance factor
    rd = 0.015 * vcmax
    base = dict(vcmax=vcmax, hs=hs, cf=cf, rd=rd, apar=apar, par=par)

    # ------------------------- night branch (PAR <= 0) -----------------------
    if par <= 0.0:
        a = -rd
        gs = pp["bb_intercept"]                         # intercept conductance
        if gs <= GS_FLOOR:
            raise AssertionError("night gs at/below safety floor")
        _, cs, gs_raw, _, rs, ci = closure(0.0, a, ca, pp["rb"], cf, p_atm, hs,
                                           pp["bb_slope"], pp["bb_intercept"])
        rs = cf / gs                                    # water-based, gs = b0
        ci = cs - KB_CO2 * rs * (a * UMOL_TO_MOL) / cf * p_atm
        return dict(base, a=a, gs=gs, rs=rs, cs=cs, ci=ci, n_iter=1,
                    binding="night(Rd)", resid=0.0, last_step=0.0,
                    widened=False, widen_reason="night",
                    gs_raw=gs_raw, wc=np.nan, wj=np.nan, we=np.nan)

    # ---------------- light branch: damped + bracketed fixed point -----------
    def resid(ci):
        a, *_ = photosynthesis(pp["pathway"], ci, vcmax, apar, pp["alpha_q"],
                               o2_pa, p_atm, t_air_k)
        return ci - closure(ci, a, ca, pp["rb"], cf, p_atm, hs,
                            pp["bb_slope"], pp["bb_intercept"])[5]

    lo = 1e-9 * max(ca, 1.0)
    # physical upper bound on Ci is ca (A > 0 => cs < ca); widen to 1.5*ci_init
    # ONLY when the supplied start guess exceeds ca (case_03/04 do).
    widened = ci_init_pa > ca * (1.0 + 1e-12)          # start guess above ca
    widen_reason = "ci_init>ca" if widened else "none"
    hi = 1.5 * ci_init_pa if widened else ca
    for _ in range(200):                                # residual monotone in Ci
        if resid(lo) < 0.0:
            break
        lo *= 0.1
    else:
        raise AssertionError(f"could not bracket from below ({tag})")
    for _ in range(200):
        if resid(hi) > 0.0:
            break
        hi *= 1.5
        widened = True
        widen_reason = "root>ca (A<0 row)"
    else:
        raise AssertionError(f"could not bracket from above ({tag})")

    # single-crossing (root uniqueness) assertion on a grid across the bracket
    grid = np.linspace(lo, hi, 801)
    gv = np.array([resid(c) for c in grid])
    n_cross = int(np.sum(np.diff(np.sign(gv)) != 0))
    if stats is not None:
        h = stats["cross_hist"]
        h[n_cross] = h.get(n_cross, 0) + 1
        stats["n_lit"] += 1
        if widened:
            stats["n_widened"] += 1
            stats.setdefault("reasons", {}).setdefault(widen_reason, 0)
            stats["reasons"][widen_reason] += 1
    if n_cross != 1:
        raise AssertionError(f"expected 1 root crossing, found {n_cross} "
                             f"({tag}, par={par}, ci_init={ci_init_pa})")

    ci = min(max(ci_init_pa, lo), hi)
    n_lo, n_hi = lo, hi
    n_iter, last_step = None, np.nan
    for k in range(1, MAX_ITER + 1):
        g = resid(ci)
        if g < 0.0:
            n_lo = max(n_lo, ci)
        elif g > 0.0:
            n_hi = min(n_hi, ci)
        a, *_ = photosynthesis(pp["pathway"], ci, vcmax, apar, pp["alpha_q"],
                               o2_pa, p_atm, t_air_k)
        step = closure(ci, a, ca, pp["rb"], cf, p_atm, hs, pp["bb_slope"],
                       pp["bb_intercept"])[5] - ci
        if abs(step) < TOL_PA and abs(g) < TOL_PA:
            n_iter, last_step = k, abs(step)
            break
        cand = ci + OMEGA * step                        # damped update
        if not (n_lo < cand < n_hi):                    # fall back to bisection
            cand = 0.5 * (n_lo + n_hi)
        ci = cand
    else:
        raise AssertionError(f"no convergence in {MAX_ITER} it ({tag}, "
                             f"ci_init={ci_init_pa})")

    # -------- re-evaluate everything AT the reported Ci (reported answer) ----
    a, wc, wj, we, rd_, binding, gs_ = photosynthesis(
        pp["pathway"], ci, vcmax, apar, pp["alpha_q"], o2_pa, p_atm, t_air_k)
    a_mol, cs, gs_raw, gs, rs, ci_new = closure(
        ci, a, ca, pp["rb"], cf, p_atm, hs, pp["bb_slope"], pp["bb_intercept"])
    if gs_raw <= GS_FLOOR:
        raise AssertionError(f"gs safety floor BOUND at {tag}")
    return dict(base, a=a, gs=gs, rs=rs, cs=cs, ci=ci_new, n_iter=n_iter,
                binding=binding, wc=wc, wj=wj, we=we, gs_raw=gs_raw,
                resid=resid(ci), last_step=last_step, widened=widened,
                widen_reason=widen_reason, gamma_star=gs_)


def residual_report(ans, pp):
    """Re-evaluate the four closure relations independently at the answer."""
    a_mol = ans["a"] * UMOL_TO_MOL
    cf, p_atm = ans["cf"], pp["p_atm"]
    r1 = ans["cs"] - (pp["ca"] - KB_H2O * pp["rb"] * a_mol / cf * p_atm)
    r2 = ans["gs"] - (pp["bb_slope"] * a_mol * ans["hs"] / ans["cs"] * p_atm
                      + pp["bb_intercept"])
    r3 = ans["rs"] - cf / ans["gs"]
    r4 = ans["ci"] - (ans["cs"] - KB_CO2 * ans["rs"] * a_mol / cf * p_atm)
    return abs(r1), abs(r2), abs(r3), abs(r4)




