def _nice_ticks(vmin, vmax, n=6):
    span = (vmax - vmin) or abs(vmax) or 1.0
    raw = span / n
    mag = 10.0 ** np.floor(np.log10(raw))
    step = mag * (1 if raw / mag < 1.5 else 2 if raw / mag < 3 else 5)
    lo = np.floor(vmin / step) * step
    hi = np.ceil(vmax / step) * step
    return list(np.round(np.arange(lo, hi + step / 2, step), 10)), lo, hi


def _write_png(path, rgb):
    """Minimal PNG encoder (8-bit RGB, no filters) using only zlib/struct."""
    import struct, zlib
    h, w, _ = rgb.shape
    arr = np.ascontiguousarray(rgb, dtype=np.uint8)
    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(h))
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)


class _Canvas:
    """Tiny raster canvas: lines, rectangles, filled bands and 5x7 text."""

    def __init__(self, w, h):
        self.buf = np.full((h, w, 3), 255, np.uint8)
        self.w, self.h = w, h

    def px(self, x, y, col):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.buf[y, x] = col

    def rect(self, x0, y0, x1, y1, col, fill=False):
        if fill:
            self.buf[max(0, int(y0)):int(y1) + 1, max(0, int(x0)):int(x1) + 1] = col
            return
        for x in range(int(x0), int(x1) + 1):
            self.px(x, int(y0), col); self.px(x, int(y1), col)
        for y in range(int(y0), int(y1) + 1):
            self.px(int(x0), y, col); self.px(int(x1), y, col)

    def line(self, x0, y0, x1, y1, col, width=1, dash=None):
        x0, y0, x1, y1 = float(x0), float(y0), float(x1), float(y1)
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        seg = np.linspace(0.0, 1.0, n)
        for k, s in enumerate(seg):
            if dash and (k // dash[0]) % 2:
                continue
            x, y = x0 + (x1 - x0) * s, y0 + (y1 - y0) * s
            off = width // 2
            for dx in range(-off, off + 1):
                for dy in range(-off, off + 1):
                    self.px(int(round(x)) + dx, int(round(y)) + dy, col)

    def text(self, x, y, s, col=(0, 0, 0), scale=2):
        cx = int(x)
        for ch in str(s):
            g = _F5x7.get(ch, _F5x7[" "])
            for ci, colbits in enumerate(g):
                for r in range(7):
                    if colbits >> r & 1:
                        for sy in range(scale):
                            for sx in range(scale):
                                self.px(cx + ci * scale + sx,
                                        int(y) + r * scale + sy, col)
            cx += 6 * scale
        return cx

    def text_w(self, s, scale=2):
        return len(str(s)) * 6 * scale


def make_figure(flux, nightmask, path, title):
    """Two-panel figure: A and rs for sunlit + shaded leaves vs time.

    matplotlib is used when the environment provides it; otherwise the same
    figure is drawn by the bundled numpy raster backend (this environment has
    neither matplotlib nor network access to install it).
    """
    t = flux.time_hr.values
    panels = [("A  [umol CO2 m^-2 s^-1]",
               [("A_sun", flux.A_sun.values, (210, 105, 30), False),
                ("A_shade", flux.A_shade.values, (46, 139, 87), True)]),
              ("rs  [s m^-1]",
               [("rs_sun", flux.rs_sun.values, (210, 105, 30), False),
                ("rs_shade", flux.rs_shade.values, (46, 139, 87), True)])]

    if HAVE_MPL:
        fig, axes = plt.subplots(2, 1, figsize=(11, 7.5), sharex=True)
        for ax, (ylab, series) in zip(axes, panels):
            for name, y, _c, dashed in series:
                ax.plot(t, y, lw=1.9, label=name, ls="--" if dashed else "-")
            ax.set_ylabel(ylab)
            ax.grid(alpha=0.3)
            ax.legend(loc="upper right", ncol=2)
            ax.fill_between(t, *ax.get_ylim(), where=nightmask, color="navy",
                            alpha=0.08, step="mid")
            ax.axhline(0, color="grey", lw=0.6)
        axes[0].set_title(title + ", night shaded")
        axes[1].set_xlabel("time [h]")
        fig.tight_layout()
        fig.savefig(path, dpi=150)
        plt.close(fig)
        return

    W, H, SC = 1180, 800, 2
    ml, mr, mt, mb, gap = 110, 40, 70, 80, 60
    pw = W - ml - mr
    ph = (H - mt - mb - gap) // 2
    cv = _Canvas(W, H)
    cv.text(ml, 20, title + ", night shaded", scale=2)
    for pi, (ylab, series) in enumerate(panels):
        y0, y1 = mt + pi * (ph + gap), mt + pi * (ph + gap) + ph
        allv = np.concatenate([s[1] for s in series])
        vmin, vmax = float(allv.min()), float(allv.max())
        pad = 0.08 * ((vmax - vmin) or abs(vmax) or 1.0)
        ticks, lo, hi = _nice_ticks(vmin - pad, vmax + pad, 6)
        X = lambda v: ml + (v - t.min()) / (t.max() - t.min()) * pw
        Y = lambda v: y1 - (v - lo) / (hi - lo) * ph
        for i in range(len(t) - 1):                      # night shading bands
            if nightmask[i]:
                cv.rect(X(t[i]), y0, X(t[i + 1]), y1, (231, 235, 247), fill=True)
        for tv in ticks:
            yy = int(Y(tv))
            cv.line(ml, yy, ml + pw, yy, (224, 224, 224))
            lab = f"{tv:g}"
            cv.text(ml - 10 - cv.text_w(lab, SC), yy - 7, lab, scale=SC)
        for hv in range(0, int(t.max()) + 1, 12):
            xx = int(X(hv))
            cv.line(xx, y1, xx, y1 + 7, (60, 60, 60))
            if pi == len(panels) - 1:
                lab = str(hv)
                cv.text(xx - cv.text_w(lab, SC) / 2, y1 + 12, lab, scale=SC)
        cv.rect(ml, y0, ml + pw, y1, (50, 50, 50))
        for si, (name, yv, col, dashed) in enumerate(series):
            pts = [(X(a), Y(b)) for a, b in zip(t, yv)]
            for (xa, ya), (xb, yb) in zip(pts[:-1], pts[1:]):
                cv.line(xa, ya, xb, yb, col, width=3,
                        dash=(4, 3) if dashed else None)
            cv.text(ml + pw - 260 + si * 130, y0 + 12, name, col, scale=2)
        cv.text(14, y0 + ph // 2 - 8, ylab, scale=SC)
    cv.text(ml + pw // 2 - 40, H - 30, "time [h]", scale=SC)
    _write_png(path, cv.buf)


