def text(img, x, y, st, color=(0, 0, 0)):
    cx = int(x)
    for ch in st.upper():
        g = FONT.get(ch)
        if g is None:
            cx += 6; continue
        block = img[int(y):int(y) + 7, cx:cx + 5]
        if block.shape[:2] == (7, 5):
            block[g] = color
        cx += 6

def line(img, p0, p1, color):
    (x0, y0), (x1, y1) = p0, p1
    n = int(max(abs(x1 - x0), abs(y1 - y0), 1))
    xs = np.linspace(x0, x1, n + 1).astype(int)
    ys = np.linspace(y0, y1, n + 1).astype(int)
    Hh, Ww = img.shape[:2]
    ok = (xs >= 0) & (xs < Ww) & (ys >= 0) & (ys < Hh)
    img[ys[ok], xs[ok]] = color

def frame(img, box):
    x0, y0, x1, y1 = [int(v) for v in box]
    for a, b in [((x0, y0), (x1, y0)), ((x0, y1), (x1, y1)),
                 ((x0, y0), (x0, y1)), ((x1, y0), (x1, y1))]:
        line(img, a, b, (0, 0, 0))

def plot_xy(img, box, xs, ys, color, logx=False, logy=False):
    x0, y0, x1, y1 = [float(v) for v in box]
    xs = np.asarray(xs, float); ys = np.asarray(ys, float)
    if logx: xs = np.log10(np.maximum(xs, 1e-12))
    if logy: ys = np.log10(np.maximum(ys, 1e-12))
    xmn, xmx = xs.min(), xs.max(); ymn, ymx = ys.min(), ys.max()
    px = x0 + (xs - xmn) / max(xmx - xmn, 1e-12) * (x1 - x0)
    py = y1 - (ys - ymn) / max(ymx - ymn, 1e-12) * (y1 - y0)
    pts = list(zip(px.tolist(), py.tolist()))
    for a, b in zip(pts[:-1], pts[1:]):
        line(img, a, b, color)

def put_image(img, x, y, arr):
    a = (np.clip(arr, 0, 1) * 255).astype(np.uint8)
    img[y:y + a.shape[0], x:x + a.shape[1]] = a[:, :, None].repeat(3, 2)

def ticks_log(img, box, mn, mx):
    x0, y0, x1, y1 = [int(v) for v in box]
    for e in range(int(np.floor(np.log10(mn))), int(np.ceil(np.log10(mx))) + 1):
        for m in (1, 10):
            v = m * 10.0 ** e
            if v < mn or v > mx: continue
            px = x0 + (np.log10(v) - np.log10(mn)) / (np.log10(mx) - np.log10(mn)) * (x1 - x0)
            line(img, (px, y1), (px, y1 - 5), (0, 0, 0))
            sv = f"{v:.0f}" if v >= 1 else f"{v:g}"
            text(img, px - 3 * len(sv), y1 + 2, sv)

def write_png(path, img):
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[r].tobytes() for r in range(h))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    open(path, "wb").write(
        b"\x89PNG\r\n\x1a\n" +
        chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) +
        chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))

def build_figure(path):
