#!/usr/bin/env python3
"""
Shared-mode recovery from complex response curves.

Model:  R(x) = a0 + sum_k a_k / (1 + (i*x*tau_k)^phi_k),  principal branch
        (i*x*tau)^phi = (x*tau)^phi * exp(i*pi*phi/2)
Constraints: tau_k > 0, 0 < phi_k <= 1, per-curve amplitudes a0, a_k >= 0.

Method: variable projection. Only shared (log10 tau_k, phi_k) are searched;
per-curve nonnegative amplitudes (a0, a_k) are eliminated by NNLS at every
objective evaluation (equal weights on re/im: measured sigma_re ~ sigma_im
~ 0.05 on every curve, so per-curve / per-component weighting was
considered and rejected on evidence). Multistart L-BFGS-B -> derivative-free
Powell polish on the 2K shared parameters (the projected objective has
NNLS active-set kinks, so the *polished* optimum is the reported one) ->
NNLS re-solve at the final polished shared parameters. Model order K chosen
by BIC on the 960 stacked complex points, cross-checked with leave-one-
curve-out prediction error (smaller K preferred on disagreement).
Stability: restart clusters, LOO refits, Jacobian-based standard errors.
Ordering of tau is a canonicalisation for clustering/reporting only, never
a constraint during fitting.

Reproducible: fixed SEED. Outputs: stdout diagnostics, results/modes.csv.
"""
import numpy as np
import pandas as pd
from scipy.optimize import nnls, minimize
from scipy.signal import savgol_filter, find_peaks

SEED = 12345
rng = np.random.default_rng(SEED)

# ---------------------------------------------------------------- data
df = pd.read_csv("data/curves.csv")
curves = sorted(df["curve"].unique())
M = len(curves)
x = df[df["curve"] == curves[0]]["x"].to_numpy()
X = np.stack([df[df["curve"] == c][["re", "im"]].to_numpy() for c in curves])
n = len(x)
lx = np.log10(x)
N = M * 2 * n
OBS = np.concatenate([np.concatenate([X[m, :, 0], X[m, :, 1]]) for m in range(M)])

def basis(tau, phi):
    u = (x[:, None] * tau[None, :]) ** phi[None, :]
    return 1.0 / (1.0 + u * np.exp(1j * np.pi * phi[None, :] / 2.0))

def design(B):
    """(n,K) complex basis -> stacked per-curve design A (2n, K+1)."""
    Fr, Fi = B.real, B.imag
    D_re = np.hstack([np.ones((n, 1)), Fr])
    D_im = np.hstack([np.zeros((n, 1)), Fi])
    return np.vstack([D_re, D_im])

def solve_amplitudes(B, curves_idx=None):
    """NNLS amplitudes per curve on the given curve subset -> (amps, ssr, models)."""
    idx = range(M) if curves_idx is None else curves_idx
    A = design(B)
    amps = np.zeros((M, B.shape[1] + 1))
    models = np.zeros((M, 2 * n))
    ssr = 0.0
    for m in idx:
        b = np.concatenate([X[m, :, 0], X[m, :, 1]])
        a, _ = nnls(A, b)
        amps[m] = a
        models[m] = A @ a
        ssr += np.sum((A @ a - b) ** 2)
    return amps, ssr, models

def ssr_of(theta, K, curves_idx=None):
    tau = 10.0 ** theta[:K]
    phi = theta[K:]
    if np.any(phi <= 1e-3) or np.any(phi > 1.0):
        return 1e6
    return solve_amplitudes(basis(tau, phi), curves_idx)[1]

def bounds(K):
    return list(zip(np.r_[[-4.5] * K, [1e-3] * K], np.r_[[4.5] * K, [1.0] * K]))

# feature candidates for seeding (peak picking on mean smoothed spectra)
IMm = np.stack([X[m, :, 1] for m in range(M)]).mean(0)
REm = np.stack([X[m, :, 0] for m in range(M)]).mean(0)
loss_s = savgol_filter(-IMm, 15, 2)
dre_s = savgol_filter(-np.gradient(REm, lx), 15, 2)
pk_l, _ = find_peaks(loss_s, prominence=0.04)
pk_d, _ = find_peaks(dre_s, prominence=0.10)
CAND = np.unique(np.round(np.r_[lx[pk_l], lx[pk_d]], 2))

def make_starts(K, n_rand=48):
    starts = []
    score = {c: loss_s[np.abs(lx - c).argmin()] + dre_s[np.abs(lx - c).argmin()]
             for c in CAND}
    ranked = sorted(CAND, key=lambda c: -score[c])[: min(K + 2, len(CAND))]
    for _ in range(8):
        cb = rng.choice(ranked, size=min(K, len(ranked)), replace=False) \
            if len(ranked) >= K else rng.choice(CAND, size=K)
        th = np.r_[np.sort(cb)[::-1][:K], rng.uniform(0.2, 1.0, K)] \
            if len(cb) >= K else None
        if th is None:
            th = np.r_[np.sort(rng.choice(CAND, size=K))[::-1],
                       rng.uniform(0.2, 1.0, K)]
        starts.append(np.clip(th, *np.array(bounds(K)).T))
    for _ in range(n_rand):
        th = np.r_[np.sort(rng.uniform(-3.6, 3.6, K))[::-1],
                   rng.uniform(0.15, 1.0, K)]
        starts.append(np.clip(th, *np.array(bounds(K)).T))
    return starts

def fit_K(K, n_rand=48, curves_idx=None, theta0=None):
    lb, ub = np.array(bounds(K)).T
    starts = make_starts(K, n_rand) if theta0 is None else [np.clip(theta0, lb, ub)]
    res = []
    for th0 in starts:
        r = minimize(ssr_of, th0, args=(K, curves_idx), method="L-BFGS-B",
                     bounds=bounds(K), options=dict(maxiter=400, ftol=1e-12))
        res.append((r.fun, r.x))
    res.sort(key=lambda t: t[0])
    # derivative-free polish on top solutions (required step, not decoration).
    # NOTE: scipy Powell with bounds can return points whose TRUE objective is
    # worse than its start (line search uses a surrogate), so we carry the
    # best-so-far explicitly and keep Powell's output only if truly better.
    def polish(th0, f0, xtol, ftol):
        best = (f0, np.array(th0))
        for _ in range(3):
            rp = minimize(ssr_of, best[1], args=(K, curves_idx),
                          method="Powell", bounds=bounds(K),
                          options=dict(maxiter=20000, xtol=xtol, ftol=ftol))
            for cand in (rp.x, np.clip(rp.x, *np.array(bounds(K)).T)):
                fc = ssr_of(cand, K, curves_idx)
                if fc < best[0]:
                    best = (fc, np.array(cand))
        return best

    pol = [polish(th0, f0, 1e-8, 1e-12) for f0, th0 in res[:10]]
    pol.sort(key=lambda t: t[0])
    pol.append(polish(pol[0][1], pol[0][0], 1e-9, 1e-13))  # deep restart
    pol.sort(key=lambda t: t[0])
    best_f, best_th = pol[0]
    idx = np.argsort(-best_th[:K])              # canonicalisation only
    best_th = np.r_[best_th[:K][idx], best_th[K:][idx]]
    amps, ssr, models = solve_amplitudes(basis(10**best_th[:K], best_th[K:]),
                                         curves_idx)
    if curves_idx is None:
        npar = 2 * K + M * (K + 1)
        bic = N * np.log(ssr / N) + npar * np.log(N)
    else:
        bic = np.nan
    print(f"  K={K}: SSR={ssr:.3f} rms={np.sqrt(ssr/(M*2*n)):.4f} BIC={bic:.1f} "
          f"logtau={np.round(best_th[:K],3)} phi={np.round(best_th[K:],3)}")
    return dict(K=K, theta=best_th, f=best_f, ssr=ssr, bic=bic, amps=amps,
                models=models, polished=pol, raw=res)

def loo_pred_ssr(K, theta):
    """Amplitudes solved on 4 curves; SSR predicting withheld curve."""
    A = design(basis(10**theta[:K], theta[K:]))
    tot = 0.0
    for mout in range(M):
        keep = [m for m in range(M) if m != mout]
        Arows = np.tile(A, (len(keep), 1))
        b = np.concatenate([np.concatenate([X[m, :, 0], X[m, :, 1]]) for m in keep])
        a, _ = nnls(Arows, b)
        obs = np.concatenate([X[mout, :, 0], X[mout, :, 1]])
        tot += np.sum((A @ a - obs) ** 2)
    return tot

def jac_se(theta, K):
    """Curvature-based SEs on shared params from final-fit residual Jacobian."""
    def r_of(th):
        tau = 10.0 ** th[:K]
        phi = th[K:]
        if np.any(phi <= 1e-3) or np.any(phi > 1.0):
            return np.full(N, 1e3)
        _, _, models = solve_amplitudes(basis(tau, phi))
        return np.concatenate([models[m] for m in range(M)]) - OBS
    r0 = r_of(theta)
    J = np.zeros((N, 2 * K))
    for j in range(2 * K):
        h = 1e-4
        tp = theta.copy(); tp[j] += h
        tm = theta.copy(); tm[j] -= h
        J[:, j] = (r_of(tp) - r_of(tm)) / (2 * h)
    s2 = np.sum(r0 ** 2) / (N - 2 * K)
    cov = np.linalg.pinv(J.T @ J) * s2
    return np.sqrt(np.maximum(np.diag(cov), 0.0)), np.sqrt(s2)

# ---------------------------------------------------------------- main run
print("=" * 70)
print("Model order scan: variable projection + NNLS, multistart L-BFGS-B")
print("+ Powell polish (reported optimum = polished one)")
print("=" * 70)
fits = {K: fit_K(K) for K in range(1, 7)}

print("\nK vs fit and K vs LOO held-out prediction:")
print(f"{'K':>2} {'SSR':>10} {'rms':>7} {'BIC':>10} {'LOO_SSR':>10} {'LOO_rms':>8}")
for K in fits:
    f = fits[K]
    f["loo"] = loo_pred_ssr(K, f["theta"])
    print(f"{K:>2} {f['ssr']:>10.2f} {np.sqrt(f['ssr']/N):>7.4f} {f['bic']:>10.1f} "
          f"{f['loo']:>10.2f} {np.sqrt(f['loo']/N):>8.4f}")
kb = min(fits, key=lambda K: fits[K]["bic"])
kl = min(fits, key=lambda K: fits[K]["loo"])
K = kb if kb == kl else min(kb, kl)
print(f"\nBIC-best K = {kb}; LOO-best K = {kl}; selected K = {K} "
      + ("(agree)" if kb == kl else "(disagree -> smaller K preferred)"))

best = fits[K]
th = best["theta"]

# ---------------------------------------------------------------- stability
print("\n" + "=" * 70)
print(f"Stability diagnostics for selected K = {K}")
print("=" * 70)
ltc = np.sort(th[:K])[::-1]
# (a) basin capture: every start (L-BFGS-B) and every polished candidate that
#     lands within 1% of the winner's SSR must match its centres within 0.1 dex
allcand = [(f, t) for f, t in best["raw"]] + [(f, t) for f, t in best["polished"]]
match = [(f, t) for f, t in allcand if f <= 1.01 * best['f']]
mt = np.array([np.sort(t[:K])[::-1] for f, t in match])
mphi = np.array([t[K:][np.argsort(-t[:K])] for f, t in match])
dev = np.abs(mt - ltc)
print(f"candidates within 1% of best SSR: {len(match)}/{len(allcand)}")
print("restart-cluster frac among near-optimal candidates (within 0.1 dex "
      "of winner): " + f"{np.round([(dev[:, j] <= 0.1).mean() for j in range(K)], 2)}  (need >=0.8)")
print("tau spread across near-optimal candidates (dex): "
      f"{np.round(mt.max(0) - mt.min(0), 3)}")
print("phi spread across near-optimal candidates:       "
      f"{np.round(mphi.max(0) - mphi.min(0), 3)}")
tops = best["polished"][:10]
lt = np.array([np.sort(t[1][:K])[::-1] for t in tops])
print("polished top-10 SSRs: " + str(np.round([t[0] for t in tops], 4)))

print("\nLOO full refits (shared params refitted with one curve withheld):")
loo_taus = []
loo_phis = []
for mout in range(M):
    keep = [m for m in range(M) if m != mout]
    r = fit_K(K, n_rand=0, curves_idx=keep, theta0=th)
    lt_ = np.sort(r["theta"][:K])[::-1]
    loo_taus.append(lt_)
    loo_phis.append(r["theta"][K:][np.argsort(-r["theta"][:K])])
    print(f"  drop curve {mout}: logtau={np.round(lt_,3)} "
          f"phi={np.round(loo_phis[-1],3)}")
loo_taus = np.array(loo_taus)
print("LOO tau drift vs full fit (max |Δ| dex per mode): "
      f"{np.round(np.abs(loo_taus - ltc).max(0), 3)}")
print("LOO tau spread (std per mode, dex):             "
      f"{np.round(loo_taus.std(0), 3)}")

se, rms = jac_se(th, K)
print(f"\nJacobian SEs at final polished fit (residual rms = {rms:.4f}; "
      f"noise estimate ~0.05):")
for j in range(K):
    print(f"  mode {j}: log10 tau = {th[j]:+.3f} +- {se[j]:.3f} "
          f"(tau = {10**th[j]:.4g}), phi = {th[K+j]:.3f} +- {se[K+j]:.3f}")

gaps = -np.diff(np.sort(th[:K])[::-1])
print(f"\nadjacent mode separations (dex): {np.round(gaps,3)}  (merge rule <0.05)")
sums = best["amps"][:, 1:K+1].sum(0)
print(f"per-mode amplitude summed over curves: {np.round(sums,3)}")

# ---------------------------------------------------------------- diagnostics
print("\n" + "=" * 70)
print("Residual diagnostics (equal weights justified: per-curve RMS balance)")
print("=" * 70)
resid = np.stack([best["models"][m] for m in range(M)]) - OBS.reshape(M, 2 * n)
resid = -resid  # obs - model
bins = np.array_split(np.arange(n), 8)
print(f"{'curve':>5} {'rms_re':>7} {'rms_im':>7}  binned mean im-residual (8 log-x bins)")
for m in range(M):
    rr, ri = resid[m, :n], resid[m, n:]
    print(f"{m:>5} {np.sqrt(np.mean(rr**2)):>7.4f} {np.sqrt(np.mean(ri**2)):>7.4f}  "
          + " ".join(f"{ri[b].mean():+.3f}" for b in bins))

print("\nPlateaus, data vs final fit:")
for m in range(M):
    re, p = X[m, :, 0], best["models"][m][:n]
    print(f"  curve {m}: low-x {re[:6].mean():.3f}/{p[:6].mean():.3f}  "
          f"high-x {re[-6:].mean():.3f}/{p[-6:].mean():.3f}  "
          f"a0={best['amps'][m,0]:.3f}  sum_a={best['amps'][m,1:K+1].sum():.3f}")
P = best["models"][:, :n].mean(0)
print(f"\nmean-curve total re drop: data {REm[0]-REm[-1]:.3f}, fit {P[0]-P[-1]:.3f}")
pkf, _ = find_peaks(savgol_filter(-np.gradient(P, lx), 15, 2), prominence=0.1)
print(f"fit -dre/dlogx peaks log10x = {np.round(lx[pkf],2)} "
      f"(data eyeball: -1.6, -0.1, +1.65, +2.7)")
print(f"fitted im <= 0.005 fraction: {np.mean(best['models'][:, n:] <= 0.005):.3f}")

# ---------------------------------------------------------------- output
lt_sorted = np.sort(th[:K])[::-1]
perm = np.argsort(-th[:K])
out = pd.DataFrame({"tau": 10.0 ** lt_sorted})
for m in range(M):
    out[f"a_{m}"] = best["amps"][m, 1:K+1][perm]
out.to_csv("results/modes.csv", index=False, float_format="%.6g")
print("\nresults/modes.csv (amplitudes re-solved by NNLS at final polished "
      "centres):")
print(out.to_string(index=False))
