#!/usr/bin/env python3
"""
Maneuver-adaptive particle filter for a two-channel (range + bearing) sensor stream.

Design (agreed with researcher):
  * State per particle: [px, py, vx, vy, b_range, b_bearing] + discrete maneuver mode.
  * 2-mode Markov-switched constant-velocity dynamics (calm / maneuver) -> IMM-style
    maneuver adaptation inside a bootstrap particle filter.
  * Slowly drifting additive sensor bias on both channels (random walk, tight priors).
    Bias is only partially identifiable (regularized estimate, not confirmed truth).
  * Student-t (heavy-tailed) per-channel likelihood -> soft outlier down-weighting.
    No observation is deleted or replaced.
  * Missing channels (mask=False / NaN) are skipped in the likelihood.
  * Angle wrapping handled by wrapping bearing innovations to (-pi, pi].
  * Systematic resampling when ESS < N/2.  N = 1000 (<= 1500 limit).
  * Ground truth is NOT public: rmse_pos/rmse_vel are posterior-spread proxies,
    nees is a normalized-innovation-squared (NIS) proxy, plus an independent
    observation-domain consistency residual (robustified).

Outputs: results/state_estimates.csv, results/filter_diagnostics.csv,
         results/summary.json, results/overview.png, results/conclusion.txt
         (plus results/audit_extra.csv with per-step audit detail).
Runs with no command-line arguments. Deterministic (fixed seeds).
"""
import json
import math
import os
import time

import numpy as np
import pandas as pd

T_START = time.time()
RNG_SEED = 42
DT_DEFAULT = 1.0


def wrap_angle(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi


def student_t_logpdf(resid, scale, dof):
    z = resid / scale
    return -0.5 * (dof + 1.0) * np.log1p(z * z / dof) - np.log(scale)


def systematic_resample(w, rng):
    n = len(w)
    pos = (rng.random() + np.arange(n)) / n
    idx = np.searchsorted(np.cumsum(w), pos)
    return np.clip(idx, 0, n - 1)


# ---------------------------------------------------------------- load data
data = np.load("data/measurements.npz", allow_pickle=True)
Y = np.asarray(data["Y"], dtype=float)
t = np.asarray(data["t"], dtype=float)
mask = np.asarray(data["mask"]).astype(bool) if "mask" in data else ~np.isnan(Y)
T = len(t)
dt = float(np.median(np.diff(t))) if T > 1 else DT_DEFAULT
if not np.isfinite(dt) or dt <= 0:
    dt = DT_DEFAULT

c0, c1 = Y[:, 0], Y[:, 1]
c0_pos = bool(np.nanmin(c0) > 0.0)
c1_in_pi = bool(np.nanmax(np.abs(c1)) <= np.pi + 0.05)
if c0_pos and c1_in_pi:
    RANGE_COL, BEAR_COL = 0, 1
    structure_note = ("column 0 inferred range-like (strictly positive), "
                      "column 1 inferred bearing-like (values within [-pi, pi] "
                      "with wrap events)")
else:
    RANGE_COL, BEAR_COL = (0, 1) if c0_pos else (1, 0)
    structure_note = "fallback column assignment based on positivity"

zr = Y[:, RANGE_COL].copy()
zb = Y[:, BEAR_COL].copy()
mr = mask[:, RANGE_COL].copy() & ~np.isnan(Y[:, RANGE_COL])
mb = mask[:, BEAR_COL].copy() & ~np.isnan(Y[:, BEAR_COL])

# gap-aware wrap-event count on raw bearing (adjacent valid steps only)
valid_b_idx = np.where(mb)[0]
wrap_events = 0
for a, b in zip(valid_b_idx[:-1], valid_b_idx[1:]):
    if (b - a) == 1 and abs(zb[b] - zb[a]) > np.pi:
        wrap_events += 1
angle_wrapping_detected = wrap_events > 0

# ------------------------------------------------------- initialization fit
dual = np.where(mr & mb)[0]
k_idx = dual[dual < dual[0] + 8]
xk = zr[k_idx] * np.cos(zb[k_idx])
yk = zr[k_idx] * np.sin(zb[k_idx])
A = np.column_stack([np.ones(len(k_idx)), t[k_idx] - t[k_idx[0]]])
cx = np.linalg.lstsq(A, xk, rcond=None)[0]
cy = np.linalg.lstsq(A, yk, rcond=None)[0]
mu0 = np.array([cx[0], cy[0], cx[1], cy[1]])
init_std = np.array([0.15, 0.15, 0.06, 0.06])

# ------------------------------------------------------------ particle filter
P_TRANS = np.array([[0.94, 0.06],    # calm -> [calm, maneuver]
                    [0.03, 0.97]])    # maneuver -> [calm, maneuver]
SIG_A = np.array([0.008, 0.30])      # accel sigma per mode
T_DOF = 4.0                          # Student-t dof (both channels)
NIS_VAR = T_DOF / (T_DOF - 2.0)      # Student-t variance factor nu/(nu-2)=2,
                                     # used in the NIS denominator so the
                                     # innovation variance is t-consistent
SIG_BIAS_R_STEP = 0.002
SIG_BIAS_B_STEP = 0.001
BIAS_R0, BIAS_B0 = 0.05, 0.03

OUT_KEYS = ("px", "py", "vx", "vy", "cov_px", "cov_py", "cov_vx", "cov_vy",
            "ess", "entropy", "maxlw", "minlw", "nis", "nis_r", "nis_b",
            "p_man", "bias_r", "bias_b", "pred_r", "pred_b", "res_r", "res_b",
            "rz", "bz", "resampled")


def run_filter(n_part, s_r, s_b, seed):
    rng = np.random.default_rng(seed)
    n_calm = int(round(n_part * P_TRANS[0, 0]))
    X = np.concatenate([np.zeros(n_calm, dtype=np.int64),
                        np.ones(n_part - n_calm, dtype=np.int64)])
    st = mu0[None, :] + rng.standard_normal((n_part, 4)) * init_std[None, :]
    px, py, vx, vy = st[:, 0].copy(), st[:, 1].copy(), st[:, 2].copy(), st[:, 3].copy()
    br = rng.standard_normal(n_part) * BIAS_R0
    bb = rng.standard_normal(n_part) * BIAS_B0

    out = {k: np.zeros(T) for k in OUT_KEYS}
    for step in range(T):
        if step > 0:
            u = rng.random(n_part)
            flip = ((X == 0) & (u < P_TRANS[0, 1])) | ((X == 1) & (u >= P_TRANS[1, 0]))
            X = np.where(flip, 1 - X, X)
            sa = SIG_A[X]
            ax = rng.standard_normal(n_part) * sa
            ay = rng.standard_normal(n_part) * sa
            px = px + vx * dt + 0.5 * ax * dt * dt
            py = py + vy * dt + 0.5 * ay * dt * dt
            vx = vx + ax * dt
            vy = vy + ay * dt
            br = br + rng.standard_normal(n_part) * SIG_BIAS_R_STEP
            bb = bb + rng.standard_normal(n_part) * SIG_BIAS_B_STEP

        r_hat = np.hypot(px, py) + br
        b_hat = np.arctan2(py, px) + bb

        lw = np.zeros(n_part)
        if mr[step]:
            lw += student_t_logpdf(zr[step] - r_hat, s_r, T_DOF)
        if mb[step]:
            lw += student_t_logpdf(wrap_angle(zb[step] - b_hat), s_b, T_DOF)

        mx = np.max(lw)
        w_un = np.exp(lw - mx)
        w = w_un / w_un.sum()
        logw = lw - (mx + math.log(w_un.sum()))
        finite = np.isfinite(logw)

        # innovations and NIS from predicted predictive-moment statistics
        mu_r = float(w @ r_hat)
        res_r = float(zr[step] - mu_r) if mr[step] else 0.0
        nis_r = 0.0
        if mr[step]:
            S_r = max(float(w @ (r_hat - mu_r) ** 2), 1e-12) + NIS_VAR * s_r * s_r
            nis_r = res_r * res_r / S_r
        mu_b = math.atan2(float(w @ np.sin(b_hat)), float(w @ np.cos(b_hat)))
        res_b = float(wrap_angle(zb[step] - mu_b)) if mb[step] else 0.0
        nis_b = 0.0
        if mb[step]:
            S_b = max(float(w @ (wrap_angle(b_hat - mu_b)) ** 2), 1e-12) + NIS_VAR * s_b * s_b
            nis_b = res_b * res_b / S_b
        active = int(mr[step]) + int(mb[step])
        nis = (nis_r + nis_b) / max(active, 1)

        # weighted marginal moments (mode and bias marginalized out; total
        # covariance computed from full ensemble -> includes between-mode spread)
        mean = np.array([w @ px, w @ py, w @ vx, w @ vy])
        dmat = np.column_stack([px - mean[0], py - mean[1],
                                vx - mean[2], vy - mean[3]])
        cov = (dmat * w[:, None]).T @ dmat

        ess = 1.0 / float(np.sum(w ** 2))
        clipped = np.clip(w, 1e-300, None)
        ent = float(-np.sum(w * np.log(clipped)))
        maxlw = float(np.max(logw[finite])) if finite.any() else -700.0
        minlw = max(float(np.min(logw[finite])), -700.0) if finite.any() else -700.0

        resampled = 0
        if ess < 0.5 * n_part:
            idx = systematic_resample(w, rng)
            px, py, vx, vy = px[idx].copy(), py[idx].copy(), vx[idx].copy(), vy[idx].copy()
            br, bb, X = br[idx].copy(), bb[idx].copy(), X[idx].copy()
            resampled = 1
        p_man = float(np.mean(X)) if resampled else float(w[X == 1].sum())

        out["px"][step], out["py"][step] = mean[0], mean[1]
        out["vx"][step], out["vy"][step] = mean[2], mean[3]
        out["cov_px"][step], out["cov_py"][step] = cov[0, 0], cov[1, 1]
        out["cov_vx"][step], out["cov_vy"][step] = cov[2, 2], cov[3, 3]
        out["ess"][step], out["entropy"][step] = ess, ent
        out["maxlw"][step], out["minlw"][step] = maxlw, minlw
        out["nis"][step], out["nis_r"][step], out["nis_b"][step] = nis, nis_r, nis_b
        out["p_man"][step] = p_man
        out["bias_r"][step], out["bias_b"][step] = float(w @ br), float(w @ bb)
        out["pred_r"][step], out["pred_b"][step] = mu_r, mu_b
        out["res_r"][step], out["res_b"][step] = res_r, res_b
        out["rz"][step] = res_r / s_r if mr[step] else 0.0
        out["bz"][step] = res_b / s_b if mb[step] else 0.0
        out["resampled"][step] = resampled
    return out

# ---- data-anchored scales + ONE bounded NIS sanity check ----------------
# robust measurement-noise floor from second differences of consecutive valid
# samples (MAD-based, immune to the sparse outliers; bearing pre-unwrapped)
def robust_noise_floor(vals, valid, wrapped):
    ii = np.where(valid)[0]
    v = vals[ii].astype(float)
    if wrapped:
        v = np.unwrap(v)
    tt = t[ii]
    if len(v) < 5:
        return 0.01
    d2 = v[2:] - 2.0 * v[1:-1] + v[:-2]
    cons = (tt[2:] - tt[1:-1] == dt) & (tt[1:-1] - tt[:-2] == dt)
    d2 = d2[cons]
    if len(d2) < 5:
        return 0.01
    return float(1.4826 * np.median(np.abs(d2)) / math.sqrt(6.0))


noise_r = robust_noise_floor(zr, mr, False)
noise_b = robust_noise_floor(zb, mb, True)
# tempering factors absorb model mismatch (maneuver lag near closest approach,
# bias drift) beyond the raw white-noise floor; kept bounded and then verified
# by the NIS check below.
s_r = float(np.clip(3.0 * noise_r, 0.01, 0.2))
s_b = float(np.clip(6.0 * noise_b, 0.005, 0.1))
target = 1.5
calib_hist = []
probe = run_filter(1000, s_r, s_b, seed=RNG_SEED)
mn = float(np.mean(probe["nis"]))
calib_hist.append((round(s_r, 5), round(s_b, 5), round(mn, 3)))
if not (0.7 <= mn <= 3.0):
    adj = math.sqrt(mn / target)
    s_r = float(np.clip(s_r * adj, 0.5 * 3.0 * noise_r, 2.0 * 3.0 * noise_r))
    s_b = float(np.clip(s_b * adj, 0.5 * 6.0 * noise_b, 2.0 * 6.0 * noise_b))
    probe = run_filter(1000, s_r, s_b, seed=RNG_SEED)
    calib_hist.append((round(s_r, 5), round(s_b, 5),
                       round(float(np.mean(probe["nis"])), 3)))

N_PART = 1000
res = run_filter(N_PART, s_r, s_b, seed=RNG_SEED)
if float(np.mean(res["ess"])) < 0.25 * N_PART:
    # "systematically far below N/2" criterion from the consultation
    N_PART = 1200
    res = run_filter(N_PART, s_r, s_b, seed=RNG_SEED)
    n_part_reason = "N raised 1000->1200: time-mean ESS < 25% of N"
else:
    n_part_reason = ("N=1000 kept (researcher default): time-mean ESS ~ "
                     f"{np.mean(res['ess']):.0f} ({100*np.mean(res['ess'])/N_PART:.0f}% of N), "
                     "not systematically far below N/2; transient ESS dips "
                     "occur only at outlier bursts / closest-approach steps")

# --------------------------------------------------- proxies and diagnostics
pos_spread = np.sqrt(np.maximum(res["cov_px"], 0) + np.maximum(res["cov_py"], 0))
vel_spread = np.sqrt(np.maximum(res["cov_vx"], 0) + np.maximum(res["cov_vy"], 0))

br_mean = np.zeros(T)
br_std = np.zeros(T)
hist = []
for k in range(T):
    if mb[k]:
        hist.append(res["res_b"][k])
        win = hist[-11:]
        br_mean[k] = float(np.mean(win))
        br_std[k] = float(np.std(win)) if len(win) > 1 else 0.0
    else:
        br_mean[k] = 0.0   # documented fallback: angular channel unavailable
        br_std[k] = 0.0

bearing_gap_steps = (int(t[~mb][0]), int(t[~mb][-1])) if (~mb).any() else None
range_gap_steps = (int(t[~mr][0]), int(t[~mr][-1])) if (~mr).any() else None

# independent observation-domain consistency (triangulated pseudo-measurements)
dual_idx = np.where(mr & mb)[0]
xt = zr[dual_idx] * np.cos(zb[dual_idx])
yt = zr[dual_idx] * np.sin(zb[dual_idx])
pos_err = np.hypot(xt - res["px"][dual_idx], yt - res["py"][dual_idx])
obs_median = float(np.median(pos_err))
mad = float(np.median(np.abs(pos_err - obs_median)) * 1.4826)
kept = pos_err <= obs_median + 3.0 * max(mad, 1e-6)
obs_rms_robust = float(np.sqrt(np.mean(pos_err[kept] ** 2)))


def lag1(a):
    a = np.asarray(a)
    if len(a) < 3 or np.std(a) < 1e-12:
        return 0.0
    return float(np.corrcoef(a[:-1], a[1:])[0, 1])


nis_r_series = res["res_r"][mr] / np.sqrt(np.maximum(res["nis_r"][mr], 1e-12))
nis_b_series = res["res_b"][mb] / np.sqrt(np.maximum(res["nis_b"][mb], 1e-12))
nis_lag1_r = lag1(nis_r_series)
nis_lag1_b = lag1(nis_b_series)

# smoothed maneuver-mode indicator: 5-point moving average of the posterior
# maneuver-mode probability; threshold 0.10 is ~1.7x the stationary maneuver
# prior (6%), i.e. clearly elevated maneuver activity (documented in conclusion)
pm_raw = res["p_man"]
pm_sm = np.convolve(pm_raw, np.ones(5) / 5.0, mode="same")
PM_THRESH = 0.10
pman = pm_sm > PM_THRESH
runs, k = [], 0
while k < T:
    if pman[k]:
        j = k
        while j + 1 < T and pman[j + 1]:
            j += 1
        if j - k + 1 >= 2:
            runs.append((int(t[k]), int(t[j])))
        k = j + 1
    else:
        k += 1
maneuver_intervals_str = "; ".join(f"t={a}..{b}" for a, b in runs) or \
    "none (smoothed P(maneuver)<0.25 everywhere)"

flag_r = np.where(np.abs(res["rz"]) > 4)[0]
flag_b = np.where(np.abs(res["bz"]) > 4)[0]
flagged = sorted(set(int(t[i]) for i in flag_r) | set(int(t[i]) for i in flag_b))
flagged_both = sorted(set(int(t[i]) for i in flag_r) & set(int(t[i]) for i in flag_b))

ess = res["ess"]
resampling_count = int(res["resampled"].sum())
deg = int(bool(np.any(ess < 0.05 * N_PART) or np.any(np.exp(res["maxlw"]) > 0.9)))
degen_steps = "; ".join(str(int(t[i])) for i in np.where(ess < 0.05 * N_PART)[0]) or "none"
mean_nees = float(np.mean(res["nis"]))
median_nees = float(np.median(res["nis"]))
bias_r_final = float(res["bias_r"][-1])
bias_b_final = float(res["bias_b"][-1])
bias_r_drift = float(np.max(res["bias_r"]) - np.min(res["bias_r"]))
bias_b_drift = float(np.max(res["bias_b"]) - np.min(res["bias_b"]))


def fin(x, fill=0.0):
    x = float(x)
    return x if math.isfinite(x) else fill

# ------------------------------------------------------------------- outputs
os.makedirs("results", exist_ok=True)

est = pd.DataFrame({
    "t": t,
    "px": [fin(v) for v in res["px"]], "py": [fin(v) for v in res["py"]],
    "vx": [fin(v) for v in res["vx"]], "vy": [fin(v) for v in res["vy"]],
    "cov_px": [fin(v, 1e-6) for v in res["cov_px"]],
    "cov_py": [fin(v, 1e-6) for v in res["cov_py"]],
    "cov_vx": [fin(v, 1e-6) for v in res["cov_vx"]],
    "cov_vy": [fin(v, 1e-6) for v in res["cov_vy"]],
})
est.to_csv("results/state_estimates.csv", index=False)

diag = pd.DataFrame({
    "t": t,
    "rmse_pos": [fin(v) for v in pos_spread],
    "rmse_vel": [fin(v) for v in vel_spread],
    "nees": [fin(v) for v in res["nis"]],
    "ess": [fin(v) for v in ess],
    "resampled": res["resampled"].astype(int),
    "weight_entropy": [fin(v) for v in res["entropy"]],
    "max_log_weight": [fin(v, -700.0) for v in res["maxlw"]],
    "min_log_weight": [fin(v, -700.0) for v in res["minlw"]],
    "bearing_residual_mean": [fin(v) for v in br_mean],
    "bearing_residual_std": [fin(v) for v in br_std],
})
diag.to_csv("results/filter_diagnostics.csv", index=False)

audit = pd.DataFrame({
    "t": t,
    "range_valid": mr.astype(int), "bearing_valid": mb.astype(int),
    "range_residual": [fin(v) for v in res["res_r"]],
    "bearing_residual_wrapped": [fin(v) for v in res["res_b"]],
    "range_resid_over_scale": [fin(v) for v in res["rz"]],
    "bearing_resid_over_scale": [fin(v) for v in res["bz"]],
    "nis_range": [fin(v) for v in res["nis_r"]],
    "nis_bearing": [fin(v) for v in res["nis_b"]],
    "p_maneuver_mode": [fin(v) for v in res["p_man"]],
    "bias_range_mean": [fin(v) for v in res["bias_r"]],
    "bias_bearing_mean": [fin(v) for v in res["bias_b"]],
    "outlier_flag": np.isin(np.arange(T), flagged).astype(int),
})
audit.to_csv("results/audit_extra.csv", index=False)

runtime = time.time() - T_START
summary = {
    "pos_rmse": fin(float(np.mean(pos_spread))),
    "vel_rmse": fin(float(np.mean(vel_spread))),
    "mean_nees": fin(mean_nees),
    "median_nees": fin(median_nees),
    "ess_min": fin(float(np.min(ess))),
    "ess_mean": fin(float(np.mean(ess))),
    "resampling_count": resampling_count,
    "weight_degeneracy_detected": deg,
    "used_log_weights": 1,
    "angle_wrapping_detected": int(angle_wrapping_detected),
    "angle_wrap_event_count": int(wrap_events),
    "n_particles": N_PART,
    "n_particles_reason": n_part_reason,
    "dt": fin(dt),
    "student_t_scale_range": fin(s_r),
    "student_t_scale_bearing": fin(s_b),
    "student_t_dof": T_DOF,
    "calibration_history": str(calib_hist),
    "bearing_gap_fallback_steps": (f"t={bearing_gap_steps[0]}..{bearing_gap_steps[1]}"
                                   if bearing_gap_steps else "none"),
    "range_gap_steps": (f"t={range_gap_steps[0]}..{range_gap_steps[1]}"
                        if range_gap_steps else "none"),
    "bearing_fallback_value": 0.0,
    "obs_domain_pos_residual_rms_robust": fin(obs_rms_robust),
    "obs_domain_pos_residual_median": fin(obs_median),
    "nis_lag1_autocorr_range": fin(nis_lag1_r),
    "nis_lag1_autocorr_bearing": fin(nis_lag1_b),
    "maneuver_intervals": maneuver_intervals_str,
    "maneuver_indicator": ("intervals where 5-pt moving-average posterior "
                           "P(maneuver mode) > 0.10 (stationary prior 0.06), "
                           "min length 2"),
    "p_maneuver_max": fin(float(np.max(pm_sm))),
    "ess_deg<5pct_steps": degen_steps,
    "bias_range_final": fin(bias_r_final),
    "bias_bearing_final": fin(bias_b_final),
    "bias_range_total_drift": fin(bias_r_drift),
    "bias_bearing_total_drift": fin(bias_b_drift),
    "outlier_flagged_steps": "; ".join(str(s) for s in flagged) or "none",
    "outlier_flagged_steps_both_channels": "; ".join(str(s) for s in flagged_both) or "none",
    "ess_min_at_t": int(t[int(np.argmin(ess))]),
    "resampling_steps": "; ".join(str(int(t[i])) for i in np.where(res["resampled"] > 0)[0]) or "none",
    "measurement_structure": structure_note,
    "runtime_seconds": fin(runtime),
    "pos_rmse_definition": ("PROXY (ground truth not public): time-mean of posterior "
                            "position 1-sigma sqrt(cov_px+cov_py); equals an RMSE "
                            "estimate only if the filter covariance is calibrated"),
    "vel_rmse_definition": ("PROXY: time-mean of posterior velocity 1-sigma "
                            "sqrt(cov_vx+cov_vy)"),
    "nees_definition": ("PROXY: per-step normalized innovation squared averaged over "
                        "active channels; expected ~1 if covariance calibrated"),
    "bias_identifiability": ("bias states are regularized estimates, only partially "
                             "identifiable; not confirmed truth"),
}
with open("results/summary.json", "w") as f:
    json.dump(summary, f, indent=2)

# --------------------------------------------------- plot (mpl, PNG fallback)

def make_plot_mpl():
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, axs = plt.subplots(2, 2, figsize=(11, 8))
    ax = axs[0, 0]
    ax.plot(res["px"], res["py"], "-", color="tab:blue", lw=1.5, label="filtered mean")
    ax.plot(xt, yt, ".", color="0.6", ms=3, alpha=0.6, label="triangulated (r,b)")
    ax.plot(res["px"][0], res["py"][0], "g^", label="start")
    ax.plot(res["px"][-1], res["py"][-1], "rs", label="end")
    for k in range(0, T, 4):
        ax.plot([res["px"][k]], [res["py"][k]], ".", color="tab:blue", ms=3)
    ax.set_xlabel("x"); ax.set_ylabel("y"); ax.legend(fontsize=7)
    ax.set_title("Estimated trajectory"); ax.axis("equal"); ax.grid(alpha=0.3)

    ax = axs[0, 1]
    ax.plot(t[mr], zr[mr], ".", color="tab:orange", label="range obs")
    ax.plot(t, res["pred_r"], "-", color="k", lw=1, label="predicted")
    fk = [k for k in flagged if mr[k]]
    if fk:
        ax.plot(t[fk], zr[fk], "rx", ms=8, label="down-weighted")
    ax.set_xlabel("t"); ax.set_ylabel("range"); ax.legend(fontsize=7)
    ax.set_title("Range channel"); ax.grid(alpha=0.3)

    ax = axs[1, 0]
    ax.plot(t[mb], np.degrees(br_mean[mb]), "-", color="tab:green",
            label="bearing resid mean (deg, rolling)")
    ax.plot(t[mb], np.degrees(br_std[mb]), "--", color="tab:red",
            label="bearing resid std (deg, rolling)")
    if bearing_gap_steps:
        ax.axvspan(bearing_gap_steps[0], bearing_gap_steps[1], color="0.85")
        ax.text(np.mean(bearing_gap_steps), float(np.degrees(br_std[mb]).max()),
                " bearing gap (0.0 fallback)", fontsize=7, va="top")
    ax.set_xlabel("t"); ax.set_ylabel("deg"); ax.legend(fontsize=7)
    ax.set_title("Bearing residual stats"); ax.grid(alpha=0.3)

    ax = axs[1, 1]
    ax.plot(t, ess, "-", color="tab:purple", label="ESS")
    ax.axhline(0.5 * N_PART, color="k", ls=":", lw=0.8)
    for k in np.where(res["resampled"] > 0)[0]:
        ax.axvline(t[k], color="tab:purple", alpha=0.15, lw=0.8)
    ax.set_xlabel("t"); ax.set_ylabel("ESS", color="tab:purple")
    ax2 = ax.twinx()
    ax2.plot(t, res["nis"], "-", color="tab:red", lw=1, label="NIS")
    ax2.set_ylabel("NIS", color="tab:red")
    ax.legend(loc="upper left", fontsize=7)
    ax.set_title("ESS (vlines = resample) and NIS")
    fig.suptitle("Maneuver-adaptive particle filter diagnostics")
    fig.tight_layout()
    fig.savefig("results/overview.png", dpi=120)
    plt.close(fig)


def _rline(img, x0, y0, x1, y1, color):
    H, W, _ = img.shape
    n = int(max(abs(x1 - x0), abs(y1 - y0), 1) * 2)
    xs = np.linspace(x0, x1, n).astype(int)
    ys = np.linspace(y0, y1, n).astype(int)
    ok = (xs >= 0) & (xs < W) & (ys >= 0) & (ys < H)
    img[ys[ok], xs[ok]] = color


def make_plot_fallback():
    Wpx, Hpx = 1000, 620
    img = np.full((Hpx, Wpx, 3), 255, dtype=np.uint8)
    pad, cw, ch = 50, 420, 220

    def rect(col, row):
        return pad + col * (cw + pad), pad + row * (ch + pad)

    def box(x0, y0):
        for (xa, ya, xb, yb) in ((x0, y0, x0 + cw, y0), (x0, y0 + ch, x0 + cw, y0 + ch),
                                 (x0, y0, x0, y0 + ch), (x0 + cw, y0, x0 + cw, y0 + ch)):
            _rline(img, xa, ya, xb, yb, (0, 0, 0))

    def poly(vals_x, vals_y, x0, y0, xlim, ylim, color):
        sx = (cw - 10) / (xlim[1] - xlim[0] + 1e-12)
        sy = (ch - 10) / (ylim[1] - ylim[0] + 1e-12)
        pxs = x0 + 5 + (np.asarray(vals_x) - xlim[0]) * sx
        pys = y0 + ch - 5 - (np.asarray(vals_y) - ylim[0]) * sy
        for a in range(len(pxs) - 1):
            _rline(img, pxs[a], pys[a], pxs[a + 1], pys[a + 1], color)

    def dots(vals_x, vals_y, x0, y0, xlim, ylim, color):
        sx = (cw - 10) / (xlim[1] - xlim[0] + 1e-12)
        sy = (ch - 10) / (ylim[1] - ylim[0] + 1e-12)
        pxs = (x0 + 5 + (np.asarray(vals_x) - xlim[0]) * sx).astype(int)
        pys = (y0 + ch - 5 - (np.asarray(vals_y) - ylim[0]) * sy).astype(int)
        H, W, _ = img.shape
        ok = (pxs >= 0) & (pxs < W) & (pys >= 0) & (pys < H)
        img[pys[ok], pxs[ok]] = color

    # panel (0,0): trajectory
    x0, y0 = rect(0, 0); box(x0, y0)
    xlim = (min(res["px"].min(), xt.min()) - .1, max(res["px"].max(), xt.max()) + .1)
    ylim = (min(res["py"].min(), yt.min()) - .1, max(res["py"].max(), yt.max()) + .1)
    dots(xt, yt, x0, y0, xlim, ylim, (160, 160, 160))
    poly(res["px"], res["py"], x0, y0, xlim, ylim, (31, 119, 180))
    # panel (1,0): range obs vs predicted
    x0, y0 = rect(1, 0); box(x0, y0)
    rlim = (0.0, float(np.nanmax(zr)) + 0.3)
    poly(t, res["pred_r"], x0, y0, (0, T - 1), rlim, (0, 0, 0))
    dots(t[mr], zr[mr], x0, y0, (0, T - 1), rlim, (255, 127, 14))
    # panel (0,1): ESS + NIS (NIS clipped to ESS axis scale for visibility)
    x0, y0 = rect(0, 1); box(x0, y0)
    poly(t, ess, x0, y0, (0, T - 1), (0, float(N_PART)), (148, 103, 189))
    poly(t, np.minimum(res["nis"] / 20.0, 1.0) * N_PART, x0, y0,
         (0, T - 1), (0, float(N_PART)), (214, 39, 40))
    # panel (1,1): bearing residual rolling mean (deg)
    x0, y0 = rect(1, 1); box(x0, y0)
    bm = np.degrees(br_mean)
    poly(t[mb], bm[mb], x0, y0, (0, T - 1),
         (float(bm[mb].min()) - 1, float(bm[mb].max()) + 1), (44, 160, 44))

    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(Hpx))
    import zlib
    import struct

    def chunk(tag, payload):
        return (struct.pack(">I", len(payload)) + tag + payload
                + struct.pack(">I", zlib.crc32(tag + payload) & 0xFFFFFFFF))

    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", Wpx, Hpx, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    with open("results/overview.png", "wb") as f:
        f.write(png)


