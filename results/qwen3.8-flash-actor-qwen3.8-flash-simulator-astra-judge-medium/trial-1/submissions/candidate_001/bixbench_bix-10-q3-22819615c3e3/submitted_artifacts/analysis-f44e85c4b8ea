"""
bixbench bix-10-q3  |  In which patient volume group (number of patients seen) do healthcare workers show
statistically significant differences (p<0.05) in COVID-19 severity between BCG and placebo, chi-square based?

APPROVED (binding) DESIGN
 PRIMARY   denominator : patients with >=1 COVID-19 AE (infection-conditional), n = 197
           severity    : patient-level WORST AEHS over that patient's COVID-19 AE records
                         (worst = max of AEHS, AEHSFU, OnsetHS, AEWK1HS..AEWK12HS)
           dichotomy   : severe = worst AEHS >= 3   vs   non-severe = 0..2
           arm         : DM.TRTGRP ("BCG" vs "Placebo"), ITT (EX confirms 1000/1000 injections, 0 arm mismatches)
           strata      : DM.patients_seen as given: "1-50", "51-100", ">100" (no re-banding)
 TESTS     per-band 2x2 chi-square (correction=False) AND Fisher exact always reported; Yates p, exact
           conditional mid-p and Haldane-Anscombe 0.5-corrected chi-square p reported for sparse cells;
           min expected count < 5 flagged; non-testable bands -> "not testable" with p = NaN (never 0.0);
           tiny/degenerate bands declared UNDERPOWERED rather than "no difference"
 MULTIPLICITY  unadjusted p (what the question asks), Holm-adjusted p (primary claim gate), BH also shown
 SENSITIVITY   6 severity/denominator definitions x 3 bands, cells = 2x2 counts + chi2 p + Fisher p
 CAVEAT        No CRD/protocol/CRF is supplied with the capsule, so "COVID-19 severity" is a data-derived
           inference from the AE domain (AEHS 0-7 scale, 7 = death anchor verified on 3 fatal AEs).
"""
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests
from statsmodels.stats.contingency_tables import StratifiedTable

pd.set_option("display.width", 240)
DATA, OUT = "/workspace/data/", "/workspace/outputs/"
BANDS = ["1-50", "51-100", ">100"]
ARMS = ["BCG", "Placebo"]
SCORE_COLS = ["AEHS", "AEHSFU", "OnsetHS"] + [f"AEWK{i}HS" for i in range(1, 13)]

log = []
def say(*a):
    line = " ".join(str(x) for x in a)
    print(line)
    log.append(line)

def fm(v, n=4):
    return "NA" if pd.isna(v) else f"{float(v):.{n}f}"

# ---------------------------------------------------------- 1. LOAD + arm verification
say("=" * 110); say("1. LOAD INPUTS")
dm = pd.read_csv(DATA + "TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(DATA + "TASK008_BCG-CORONA_AE.csv")
ex = pd.read_csv(DATA + "TASK008_BCG-CORONA_EX.csv", encoding="latin-1")   # EX has non-UTF8 bytes (Guérin)
say(f"DM rows={len(dm)} patients={dm.USUBJID.nunique()} | AE rows={len(ae)} patients={ae.USUBJID.nunique()} "
    f"| EX rows={len(ex)} patients={ex.USUBJID.nunique()}")
a1 = ae[["USUBJID", "TRTGRP"]].drop_duplicates().merge(dm[["USUBJID", "TRTGRP"]], on="USUBJID", suffixes=("_ae", "_dm"))
drug = ex[["USUBJID", "EXDRUG"]].drop_duplicates()
drug["arm_ex"] = np.where(drug.EXDRUG.str.contains("Calmette"), "BCG", "Placebo")
a2 = drug.merge(dm[["USUBJID", "TRTGRP"]], on="USUBJID")
say(f"arm concordance: AE-vs-DM mismatches={(a1.TRTGRP_ae != a1.TRTGRP_dm).sum()}/{len(a1)}; "
    f"EX-vs-DM mismatches={(a2.arm_ex != a2.TRTGRP).sum()}/{len(a2)}")
say(f"EX injection-administration deviations (EXORRES==1) noted, NOT excluded (ITT kept): n={(ex.EXORRES == 1).sum()}")

# ---------------------------------------------------------- 2. AE hygiene / collapse
say("\n" + "=" * 110); say("2. AE CLEANING / PATIENT-LEVEL COLLAPSE")
core = [c for c in ae.columns if c not in ("STUDYID", "TRTGRP", "USUBJID")]
blank = ae[core].isna().all(axis=1)
say(f"dropping fully-blank AE rows: n={int(blank.sum())}")
ae = ae.loc[~blank].copy()
say(f"AE analysis rows={len(ae)}; unique (USUBJID,AESPID)={ae.groupby(['USUBJID','AESPID']).ngroups} "
    f"-> ongoing/follow-up duplicate records collapsed by worst-wins max")
for c in SCORE_COLS + ["AESEV"]:
    ae[c] = pd.to_numeric(ae[c], errors="coerce")   # score columns only; 'N_A' -> NaN; USUBJID untouched

# ---------------------------------------------------------- 3. cohort + severity
say("\n" + "=" * 110); say("3. COVID-19 COHORT AND PATIENT-LEVEL SEVERITY")
covid = ae["AEPT"].fillna("").str.contains("COVID|SARS-CoV-2", case=False, regex=True)
cv = ae.loc[covid].copy()
say("COVID-19 AEPT records:", cv.AEPT.value_counts().to_dict())
say(f"COVID AE records={len(cv)} covering patients={cv.USUBJID.nunique()}")
cv["worst_score"] = cv[SCORE_COLS].max(axis=1, skipna=True)
pat = (cv.groupby("USUBJID")
         .agg(n_covid_ae=("AEPT", "size"), worst_aehs=("worst_score", "max"), aehs_only=("AEHS", "max"),
              sev_aesev=("AESEV", "max"),
              ser_yes=("AESER", lambda s: (s.astype("string").str.strip().str.lower() == "yes").any())).reset_index())
df = dm[["USUBJID", "TRTGRP", "patients_seen"]].merge(pat, on="USUBJID", how="left")
coh = df[df.worst_aehs.notna()].copy()
coh["severe"] = (coh.worst_aehs >= 3).astype(int)
say(f"ITT population={len(df)}; PRIMARY infection-conditional denominator={len(coh)}")
say("worst AEHS distribution in cohort:", coh.worst_aehs.value_counts(dropna=False).sort_index().to_dict())
say(f"severe (worst AEHS>=3) = {int(coh.severe.sum())}; non-severe = {int((1 - coh.severe).sum())}")
say("severe count by band x arm:\n" + pd.crosstab(coh.patients_seen, coh.TRTGRP, values=coh.severe, aggfunc="sum")
    .reindex(BANDS).fillna(0).astype(int).to_string())

# ---------------------------------------------------------- 4. test machinery
def test_band(sub, sev_col):
    tab = pd.crosstab(sub[sev_col], sub.TRTGRP).reindex(index=[1, 0], columns=ARMS).fillna(0)
    a, b = int(tab.loc[1, "BCG"]), int(tab.loc[1, "Placebo"])
    c, d = int(tab.loc[0, "BCG"]), int(tab.loc[0, "Placebo"])
    obs = tab.values.astype(float)
    r = dict(n=a + b + c + d, n_BCG=a + c, n_PBO=b + d, severe_BCG=a, severe_PBO=b, nonsev_BCG=c, nonsev_PBO=d,
             table_BCG=f"{a}/{c}", table_PBO=f"{b}/{d}",
             rate_BCG=a / (a + c) if a + c else np.nan, rate_PBO=b / (b + d) if b + d else np.nan,
             zero_cell=bool(0 in (a, b, c, d)))
    if r["n_BCG"] == 0 or r["n_PBO"] == 0 or obs.sum(0).min() == 0 or obs.sum(1).min() == 0:
        r.update(status="NOT TESTABLE (structural zero: an arm or a severity level is empty)", min_expected=np.nan,
                 chi2=np.nan, chi2_p=np.nan, chi2_p_yates=np.nan, fisher_p=np.nan, p_mid=np.nan, p_haldane=np.nan,
                 odds_ratio=np.nan, risk_diff=np.nan)
        return r
    chi2, p, dof, exp = stats.chi2_contingency(obs, correction=False)
    r.update(chi2=chi2, chi2_p=p, chi2_p_yates=stats.chi2_contingency(obs, correction=True)[1],
             fisher_p=stats.fisher_exact(obs)[1], min_expected=float(exp.min()),
             risk_diff=r["rate_BCG"] - r["rate_PBO"])
    obs_c = obs + 0.5 if r["zero_cell"] else obs          # Haldane-Anscombe for OR / chi-square
    r["odds_ratio"] = (obs_c[0, 0] * obs_c[1, 1]) / (obs_c[0, 1] * obs_c[1, 0])
    # exact conditional mid-p (correct sparse-data companion; scipy silently ignores non-integer Fisher tables)
    n1, n2, m = r["n_BCG"], r["n_PBO"], a + b
    k = np.arange(0, min(n1, m) + 1)
    pm = stats.hypergeom.pmf(k, n1 + n2, m, n1)
    pm = pm / pm.sum()
    p_obs = pm[a]
    r["p_mid"] = float(pm[pm < p_obs - 1e-12].sum() + 0.5 * p_obs)
    if r["zero_cell"]:
        r["p_haldane"] = stats.chi2_contingency(obs + 0.5, correction=False)[1]
    else:
        r["p_haldane"] = np.nan
    st = "testable"
    if exp.min() < 5:
        st += f"; min expected={fm(exp.min(),2)}<5 -> Fisher exact governs"
    if r["zero_cell"]:
        st += "; ZERO CELL -> uncorrected chi-square unreliable (Yates / HA-corrected chi2 / mid-p reported)"
    if min(r["n_BCG"], r["n_PBO"]) <= 5 or a + b <= 2:
        st += "; UNDERPOWERED (tiny arm n and/or <=2 severe events) -> essentially uninformative, NOT evidence of no difference"
    r["status"] = st
    return r

def run_definition(data, sev_col):
    out = pd.DataFrame([dict(band=b, **test_band(data[data.patients_seen == b], sev_col)) for b in BANDS])
    ok = out.chi2_p.notna()
    for col, meth in [("chi2_p_holm", "holm"), ("chi2_p_bh", "fdr_bh")]:
        out[col] = np.nan
        if ok.sum():
            out.loc[ok, col] = multipletests(out.loc[ok, "chi2_p"], method=meth)[1]
    out["fisher_p_holm"] = np.nan
    fok = out.fisher_p.notna()
    if fok.sum():
        out.loc[fok, "fisher_p_holm"] = multipletests(out.loc[fok, "fisher_p"], method="holm")[1]
    return out

DISP = ["band", "n", "n_BCG", "n_PBO", "severe_BCG", "severe_PBO", "nonsev_BCG", "nonsev_PBO", "rate_BCG",
        "rate_PBO", "odds_ratio", "risk_diff", "min_expected", "chi2", "chi2_p", "chi2_p_yates", "fisher_p",
        "p_mid", "p_haldane", "chi2_p_holm", "chi2_p_bh", "fisher_p_holm", "status"]

def show(out, title):
    say("\n" + title)
    o = out[DISP].copy()
    for c in DISP[8:22]:
        o[c] = o[c].map(lambda v: "NA" if pd.isna(v) else f"{float(v):.4g}")
    say(o.to_string(index=False))

# ---------------------------------------------------------- 5. PRIMARY
say("\n" + "=" * 110)
say("4. PRIMARY ANALYSIS - COVID-19 cases (n=197) x worst AEHS>=3 x TRTGRP, within patients_seen bands")
prim = run_definition(coh, "severe")
prim.insert(0, "definition", "worst AEHS>=3 (COVID cases)")
show(prim, "PRIMARY per-band results")
for _, r in prim.iterrows():
    say(f"  band '{r.band}': severe BCG {r.severe_BCG}/{r.n_BCG} vs placebo {r.severe_PBO}/{r.n_PBO} | "
        f"chi2={fm(r.chi2)} chi-square p={fm(r.chi2_p,6)} (Holm {fm(r.chi2_p_holm,6)}, BH {fm(r.chi2_p_bh,6)}) "
        f"Fisher p={fm(r.fisher_p,6)}, Yates p={fm(r.chi2_p_yates,6)}, mid-p={fm(r.p_mid,6)}, "
        f"HA-corrected chi2 p={fm(r.p_haldane,6)} | "
        f"{'SIGNIFICANT unadj' if pd.notna(r.chi2_p) and r.chi2_p < 0.05 else 'ns unadj'} / "
        f"{'SIGNIFICANT Holm' if pd.notna(r.chi2_p_holm) and r.chi2_p_holm < 0.05 else 'ns Holm'}")

# ---------------------------------------------------------- 6. SENSITIVITY GRID
say("\n" + "=" * 110); say("5. MANDATORY SENSITIVITY GRID (severity definition is an inference, not a documented endpoint)")
cc = coh[coh.sev_aesev.notna()].copy()
cc["sev3"] = (cc.sev_aesev >= 3).astype(int)
say(f"AESEV>=3 complete-case denominator = {len(cc)}/{len(coh)} (dropped {len(coh) - len(cc)} patients with missing AESEV)")
itt = df.copy()
itt["severe"] = (itt.worst_aehs.fillna(0) >= 3).astype(int)
defs = [("worst AEHS>=3 (PRIMARY; COVID cases)", coh, "severe"),
        ("worst AEHS>=2 moderate+ (COVID cases)", coh.assign(s2=(coh.worst_aehs >= 2).astype(int)), "s2"),
        ("AESEV>=3 complete-case (COVID cases)", cc, "sev3"),
        ('AESER=="Yes" serious (COVID cases)', coh.assign(aeser=coh.ser_yes.astype(int)), "aeser"),
        ("AEHS-only>=3, no AEHSFU/OnsetHS/weekly (COVID cases)", coh.assign(a3=(coh.aehs_only >= 3).astype(int)), "a3"),
        ("worst AEHS>=3, ITT denominator (all 1000)", itt, "severe")]
rows = []
for name, data, col in defs:
    out = run_definition(data, col)
    out.insert(0, "definition", name)
    show(out, f"-- definition: {name}")
    for _, r in out.iterrows():
        rows.append(dict(definition=name, band=r.band, n=r.n, table_BCG=r.table_BCG, table_PBO=r.table_PBO,
                         chi2_p=r.chi2_p, fisher_p=r.fisher_p, chi2_p_yates=r.chi2_p_yates, p_mid=r.p_mid,
                         chi2_p_holm=r.chi2_p_holm, status=r.status,
                         sig_chi2_unadj=bool(pd.notna(r.chi2_p) and r.chi2_p < 0.05),
                         sig_chi2_holm=bool(pd.notna(r.chi2_p_holm) and r.chi2_p_holm < 0.05),
                         sig_fisher_unadj=bool(pd.notna(r.fisher_p) and r.fisher_p < 0.05)))
grid = pd.DataFrame(rows)
grid["cell"] = grid.apply(lambda r: f"chi2p={fm(r.chi2_p,5)} fisherP={fm(r.fisher_p,5)} yatesP={fm(r.chi2_p_yates,5)}"
                                    f" holmP={fm(r.chi2_p_holm,5)}{' *' if r.sig_chi2_unadj else ''}"
                                    f"{' H' if r.sig_chi2_holm else ''}", axis=1)
say("\nGRID: rows = severity definitions, cols = patients_seen bands  (* unadjusted chi2 p<0.05, H Holm chi2 p<0.05)")
say(grid.pivot(index="definition", columns="band", values="cell").reindex(columns=BANDS).to_string())
say("\nGRID 2x2 counts (severe/non-severe per arm):")
say(pd.concat([grid.pivot(index="definition", columns="band", values="table_BCG").reindex(columns=BANDS).add_prefix("BCG "),
               grid.pivot(index="definition", columns="band", values="table_PBO").reindex(columns=BANDS).add_prefix("PBO ")],
              axis=1).to_string())
win_u = grid[grid.sig_chi2_unadj].groupby("band").definition.nunique().reindex(BANDS).fillna(0).astype(int)
win_h = grid[grid.sig_chi2_holm].groupby("band").definition.nunique().reindex(BANDS).fillna(0).astype(int)
win_f = grid[grid.sig_fisher_unadj].groupby("band").definition.nunique().reindex(BANDS).fillna(0).astype(int)
say("\nSTABILITY across the 6 definitions (#definitions significant per band)")
say(f"  unadjusted chi2 p<0.05: {win_u.to_dict()} | Holm chi2 p<0.05: {win_h.to_dict()} | "
    f"unadjusted Fisher p<0.05: {win_f.to_dict()}")
for b in BANDS:
    g = grid[(grid.band == b) & grid.sig_chi2_unadj]
    say(f"  band '{b}': unadjusted-significant definitions ({len(g)}/{len(defs)}): {list(g.definition) or 'none'}")

# informational: pooled CMH over the 3 bands (NOT the requested per-band test)
tabs = np.array([[[r.severe_BCG, r.severe_PBO], [r.nonsev_BCG, r.nonsev_PBO]] for _, r in prim.iterrows()], float)
cmh = StratifiedTable(tabs.transpose(1, 2, 0)).test_null_odds()
say(f"\nInformational only (not the requested test): Cochran-Mantel-Haenszel pooled over the 3 bands: "
    f"chi2={cmh.statistic:.4f}, p={cmh.pvalue:.4f}")

# ---------------------------------------------------------- 7. ANSWER
say("\n" + "=" * 110); say("6. ANSWER")
sig_un = prim[prim.chi2_p < 0.05]
if len(sig_un):
    a = sig_un.iloc[0]
    vh = "also survives Holm adjustment" if pd.notna(a.chi2_p_holm) and a.chi2_p_holm < 0.05 else \
         f"NOT significant after Holm adjustment (Holm p={fm(a.chi2_p_holm,4)})"
    vf = "Fisher exact p<0.05 too" if pd.notna(a.fisher_p) and a.fisher_p < 0.05 else \
         f"but Fisher exact p={fm(a.fisher_p,4)} is NOT <0.05 and min expected count={fm(a.min_expected,2)}<5, so the exact test governs"
    others = ", ".join(f"'{r.band}': chi2 p={fm(r.chi2_p,4)}" for _, r in prim[prim.band != a.band].iterrows())
    say(f"\nFINAL ONE-LINE ANSWER: the '{a.band}' patients_seen group - severe COVID-19 in BCG {a.severe_BCG}/{a.n_BCG} "
        f"vs placebo {a.severe_PBO}/{a.n_PBO} (chi-square p={fm(a.chi2_p,4)}, Fisher p={fm(a.fisher_p,4)}, "
        f"Yates p={fm(a.chi2_p_yates,4)}, Holm-adjusted chi-square p={fm(a.chi2_p_holm,4)}); it is the ONLY band with "
        f"unadjusted chi-square p<0.05 ({others}); gate used = the unadjusted chi-square p<0.05 the question asks for, "
        f"finding is fragile ({vh}, {vf}, and significant in only {int(win_u.max())}/{len(defs)} severity definitions); "
        f"caveat: 'COVID-19 severity' is a data-derived inference (worst AEHS>=3 among COVID-19 AE records; AEHS 0-7, "
        f"7=death) because no CRD/protocol/CRF is supplied with the capsule.")
else:
    say("\nFINAL ONE-LINE ANSWER: no patients_seen band shows unadjusted chi-square p<0.05 under the primary definition.")
flip = (f"A single band ('{win_u.idxmax()}') is ever significant, but significance is NOT stable across severity "
        f"definitions ({int(win_u.max())}/{len(defs)}); report it with the definition attached, not as a robust effect."
        if (win_u > 0).sum() == 1 and win_u.max() < len(defs) else
        "Multiple/zero bands significant - see grid.")
say("STABILITY VERDICT: " + flip)

prim.to_csv(OUT + "primary_results_by_band.csv", index=False)
grid.to_csv(OUT + "sensitivity_grid.csv", index=False)
with open(OUT + "analysis_log.txt", "w") as fh:
    fh.write("\n".join(log) + "\n")
print("\nsaved:", OUT + "primary_results_by_band.csv,", OUT + "sensitivity_grid.csv,", OUT + "analysis_log.txt")
