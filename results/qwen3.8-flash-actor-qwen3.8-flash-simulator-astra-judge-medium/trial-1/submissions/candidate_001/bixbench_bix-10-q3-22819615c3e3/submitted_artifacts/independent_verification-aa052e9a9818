"""Independent re-derivation with a different code path: raw counting + manual chi-square + R-style Fisher."""
import pandas as pd, numpy as np, math
from scipy.stats import fisher_exact, chi2 as chi2dist
from statsmodels.stats.contingency_tables import StratifiedTable, Table2x2

ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
sc = ["AEHS","AEHSFU","OnsetHS"]+[f"AEWK{i}HS" for i in range(1,13)]
ae = ae[ae.AEPT.notna()]                       # drop the 143 fully-blank rows
cv = ae[ae.AEPT.str.contains("COVID|SARS-CoV-2", case=False, na=False)]
print("COVID records:", len(cv), "patients:", cv.USUBJID.nunique())
worst = {}
for _, r in cv.iterrows():
    vals = [pd.to_numeric(r[c], errors="coerce") for c in sc]
    vals = [v for v in vals if pd.notna(v)]
    if vals:
        worst[r.USUBJID] = max(worst.get(r.USUBJID, -1), max(vals))
print("patients with worst score:", len(worst), "severe>=3:", sum(v>=3 for v in worst.values()))

d = dm.copy()
d["sev"] = d.USUBJID.map(worst)
d = d[d.sev.notna()]
print("cohort n:", len(d))
for band in ["1-50","51-100",">100"]:
    s = d[d.patients_seen==band]
    b = s[s.TRTGRP=="BCG"]; p = s[s.TRTGRP=="Placebo"]
    a_, c_ = int((b.sev>=3).sum()), int((b.sev<3).sum())
    b_, d_ = int((p.sev>=3).sum()), int((p.sev<3).sum())
    n = a_+b_+c_+d_
    # manual Pearson chi-square, no correction
    row1, row2, col1, col2 = a_+b_, c_+d_, a_+c_, b_+d_
    cells = np.array([[a_,b_],[c_,d_]], float)
    exp = np.outer([row1,row2],[col1,col2])/n
    X2 = float(((cells-exp)**2/exp).sum())
    p_manual = chi2dist.sf(X2,1)
    t = Table2x2(cells)
    fp = fisher_exact(cells)[1]
    print(f"{band:>7}: table={cells.tolist()} n={n} minExp={exp.min():.3f} X2_manual={X2:.4f} p_manual={p_manual:.6f} "
          f"statsmodels_chi2={t.test_nominal_association().statistic:.4f}/{t.test_nominal_association().pvalue:.6f} fisher={fp:.6f} OR_ha={(cells+0.5).prod(axis=1)[0]/(cells+0.5).prod(axis=1)[1]:.2f}")

# CMH / stratified (informational: pooled stratum-adjusted test)
tabs=[]
for band in ["1-50","51-100",">100"]:
    s=d[d.patients_seen==band]
    tabs.append([[ (s[(s.TRTGRP=='BCG')].sev>=3).sum(), (s[(s.TRTGRP=='Placebo')].sev>=3).sum()],
                 [ (s[(s.TRTGRP=='BCG')].sev<3).sum(),  (s[(s.TRTGRP=='Placebo')].sev<3).sum()]])
st = StratifiedTable(np.array(tabs,float).transpose(1,2,0))
print("\nCMH stratified (informational, not the requested test): chi2=%.4f p=%.4f" % (st.test_null_odds().statistic, st.test_null_odds().pvalue))
