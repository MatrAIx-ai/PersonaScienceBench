"""
BixBench bix-14-q3
Q: After filtering out reference variant calls and variants located in intronic,
intergenic, or UTR regions, how many non-reference exonic variants remain in CHIP
genes from the 86 samples analyzed?

Researcher-approved decisions (D1-D6):
 D1 primary unit = sample x variant calls (rows); unique variants secondary
 D2 CHIP filter  = strict 56-gene list INTERSECT Gene Names (comma split, case-sensitive)
 D3 splice_region_variant -> removed (intron-side; HGVS +n/-n)
 D4 5_prime_UTR_premature_start_codon_gain_variant -> removed (name-based UTR rule); shown in sensitivity
 D5 upstream_gene_variant -> removed (not exonic / intergenic-like)
 D6 all 86 files (probands + relatives); Trio Status for QC/metadata only (strip whitespace);
    sample 533 has no variant file -> not part of the 86
No derived data files are written; the script only prints diagnostics.
"""
from pathlib import Path
import re
import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
GENE_XLSX = ROOT / "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
TRIO_XLSX = ROOT / "data/230215_Trio_Status.xlsx"
VARIANT_DIR = ROOT / "data/CHIP_DP10_GQ20_PASS"

REF_LABEL, HET_LABEL, HOM_LABEL = "Reference", "Heterozygous", "Homozygous Variant"
NONREF_LABELS = [HET_LABEL, HOM_LABEL]
CORE_EXONIC = {"synonymous_variant", "missense_variant", "frameshift_variant",
               "inframe_insertion", "inframe_deletion"}
REMOVED = {"intron_variant", "3_prime_UTR_variant", "5_prime_UTR_variant",
           "splice_region_variant", "5_prime_UTR_premature_start_codon_gain_variant",
           "upstream_gene_variant"}
CANON = ["Chr:Pos", "Ref/Alt", "Primary Findings", "Incidental Findings", "Zygosity",
         "Mendel Error", "Inherited From", "Read Depths (DP)", "Genotype Qualities (GQ)",
         "Variant Allele Freq", "In ACMG SF Genes?", "Match_ACMG", "Gene Names",
         "Sequence Ontology (Combined)", "Effect (Combined)",
         "Transcript Name (Clinically Relevant)", "Exon Number (Clinically Relevant)",
         "HGVS c. (Clinically Relevant)", "HGVS p. (Clinically Relevant)", "Filter",
         "Alt Allele Freq (AF)", "Alt Allele Count (AC)", "#Alleles (AN)",
         "Homozgyous Count (Hom)", "Variant ID", "Classification",
         "Aggregate of Interpretations from Submissions", "Review Status", "Conditions",
         "In_CHIP", "CHIP_Match_Gene", "In_DNAm", "DNAm_Match"]

def banner(t):
    print("\n" + "=" * 78 + "\n" + t + "\n" + "=" * 78)

banner("STEP 1  CHIP gene list (strict, case-sensitive)")
CHIP = [str(g).strip() for g in pd.read_excel(GENE_XLSX, header=None)[0].tolist()]
assert len(CHIP) == 56 and len(set(CHIP)) == 56, (len(CHIP), len(set(CHIP)))
CHIP = set(CHIP)
print("CHIP gene symbols:", len(CHIP), "| e.g.", sorted(CHIP)[:3], "...", sorted(CHIP)[-2:])

banner("STEP 2  Trio Status QC (metadata only; no filtering of variants)")
trio = pd.read_excel(TRIO_XLSX)
trio.columns = [str(c).strip() for c in trio.columns]
trio["Sample ID"] = trio["Sample ID"].astype(str).str.strip()
trio["Status"] = trio["Status"].astype(str).str.strip()   # 'Mother ' -> 'Mother'
print("trio rows:", len(trio), "| unique IDs:", trio["Sample ID"].nunique())
print("Status (after strip):", trio["Status"].value_counts().to_dict())
files = sorted(VARIANT_DIR.glob("*.xlsx"))
assert len(files) == 86, len(files)
print("variant files found:", len(files))

banner("STEP 3  read 86 files (header=1 i.e. spreadsheet row 2), 33 cols by index")
parts, role_map = [], {}
for f in files:
    base = re.sub(r"^230209_Exome_GRCh38_CHIP_", "", f.stem)
    grp = pd.read_excel(f, sheet_name=0, header=None, nrows=1).iloc[0]
    lab = [str(x) for x in grp if isinstance(x, str) and re.match(r"(Proband|Mother|Father|Child) \(", x)]
    assert len(lab) == 1, (base, lab)
    role, sid = re.match(r"(\w+) \((.*)\)", lab[0]).groups()
    df = pd.read_excel(f, sheet_name=0, header=1)
    assert df.shape[1] == 33, (base, df.shape)
    df.columns = CANON                      # three 'Match' columns -> explicit names
    df.insert(0, "sample", base)
    df.insert(1, "role_in_file", role)
    parts.append(df)
    role_map[base] = (sid, role)
A = pd.concat(parts, ignore_index=True)
banner("STEP 4  stacked table")
print("rows total:", len(A), "| files:", A["sample"].nunique(), "| unique Chr:Pos:", A["Chr:Pos"].nunique())
fam = dict(zip(trio["Sample ID"], trio["Status"]))
QC = pd.DataFrame([(b, s, r, fam.get(s.split("-")[0], "NO TRIO ROW"))
                   for b, (s, r) in role_map.items()],
                  columns=["file", "id_in_header", "role_in_file", "trio_status"])
QC["agree"] = QC.apply(lambda r: {"Proband": "Patient"}.get(r.role_in_file, r.role_in_file) == r.trio_status, axis=1)
print("files joined to Trio:", int((QC.trio_status != "NO TRIO ROW").sum()), "/", len(QC),
      "| role agreement:", int(QC.agree.sum()), "/", len(QC))
print("Trio IDs with no variant file (excluded, not part of the 86):",
      sorted(set(trio["Sample ID"]) - {s.split("-")[0] for s, _ in role_map.values()}))

banner("STEP 5  dedupe on (sample, Chr:Pos, Ref/Alt, SO term)")
before = len(A)
A = A.drop_duplicates(["sample", "Chr:Pos", "Ref/Alt", "Sequence Ontology (Combined)"])
print(f"rows {before} -> {len(A)} (removed {before - len(A)} duplicate rows)")

banner("STEP 6  drop reference calls (Zygosity)")
zyg = A["Zygosity"].astype(str).str.strip()
vals = sorted(set(zyg.where(A["Zygosity"].notna(), "<BLANK>")))
print("distinct Zygosity values:", vals)
for lab in (REF_LABEL, HET_LABEL, HOM_LABEL):
    assert lab in vals, f"exact label '{lab}' missing: {vals}"
print("Reference rows:", int((zyg == REF_LABEL).sum()),
      "| blank/no-call rows (in neither class):", int(A["Zygosity"].isna().sum()))
B = A[A["Zygosity"].isin(NONREF_LABELS)].copy()
print(f"non-reference calls: {len(A)} -> {len(B)}")

banner("STEP 7  region filter on 'Sequence Ontology (Combined)'")
soB = B["Sequence Ontology (Combined)"].astype(str).str.strip()
print("non-reference calls by SO term BEFORE region filter:")
print(soB.value_counts().to_string())
soA = A["Sequence Ontology (Combined)"].astype(str).str.strip()
assert set(soA.unique()) <= (CORE_EXONIC | REMOVED), sorted(set(soA.unique()) - (CORE_EXONIC | REMOVED))
C = B[soB.isin(CORE_EXONIC)].copy()
print(f"kept exonic terms: {sorted(CORE_EXONIC)}")
print(f"non-reference exonic calls: {len(B)} -> {len(C)} (dropped {len(B)-len(C)} intronic / UTR / UTR-named / intergenic-like)")
print("retained SO counts:"); print(C["Sequence Ontology (Combined)"].value_counts().to_string())

banner("STEP 8  strict CHIP gene filter (Gene Names split ',', case-sensitive exact symbol)")
def chip_genes(cell):
    return [t.strip() for t in str(cell).split(",") if t.strip() in CHIP]
C["CHIP_gene"] = C["Gene Names"].apply(chip_genes)
is_chip = C["CHIP_gene"].map(len) > 0
print("rows dropped for having no 56-list symbol in Gene Names:", int((~is_chip).sum()),
      "| their Gene Names:", C.loc[~is_chip, "Gene Names"].value_counts().to_dict())
D = C[is_chip].copy().explode("CHIP_gene")
print(f"non-reference exonic calls in CHIP genes: {len(C)} -> {len(D)}")
print("duplicate rows still present:", int(D.duplicated(['sample','Chr:Pos','Ref/Alt','Sequence Ontology (Combined)']).sum()), "(expected 0)")
print("blank-Zygosity rows in final set:", int(D["Zygosity"].isna().sum()), "(expected 0)")
PRIMARY = len(D)
banner("PRIMARY ANSWER")
print("non-reference EXONIC variant calls in strict CHIP genes, 86 samples =", PRIMARY)

banner("STEP 9  secondary units")
print("unique (Chr:Pos, Ref/Alt)            =", D.drop_duplicates(["Chr:Pos","Ref/Alt"]).shape[0])
print("unique (Chr:Pos, Ref/Alt, CHIP gene) =", D.drop_duplicates(["Chr:Pos","Ref/Alt","CHIP_gene"]).shape[0])
print("distinct CHIP genes hit              =", D["CHIP_gene"].nunique())
print("zygosity split:", D["Zygosity"].value_counts().to_dict())

banner("STEP 10  distributions")
print("TOP 15 genes:"); print(D["CHIP_gene"].value_counts().head(15).to_string())
print("CHIP genes with ZERO such calls:", sorted(CHIP - set(D["CHIP_gene"])))
ps = D.groupby("sample").size().sort_values(ascending=False)
print(f"per-sample calls: n={len(ps)} min={ps.min()} median={int(ps.median())} max={ps.max()} total={ps.sum()}")
print("top 8:", ps.head(8).to_dict())
print("bottom 5:", ps.tail(5).to_dict())
role_of = {b: r for b, (s, r) in role_map.items()}
rs = D["sample"].map(role_of).value_counts()
print("role composition of final calls:", rs.to_dict())
print("per-role call counts per file (median):",
      D.assign(role=D["sample"].map(role_of)).groupby("role")["sample"].apply(lambda s: s.value_counts().median()).to_dict())
print("top 10 recurrent variants (calls per variant across samples):")
print(D.groupby(["Chr:Pos","Ref/Alt","CHIP_gene"]).size().sort_values(ascending=False).head(10).to_string())

banner("STEP 11  sensitivity table")
A["is_chip_strict"] = A["Gene Names"].apply(lambda c: len(chip_genes(c)) > 0)
nr = A["Zygosity"].isin(NONREF_LABELS)
all_true = pd.Series(True, index=A.index)
def tally(terms, gene_mask, label):
    S = A[nr & soA.isin(terms) & gene_mask]
    u = S.drop_duplicates(["Chr:Pos","Ref/Alt"]).shape[0]
    G = S.copy(); G["CHIP_gene"] = G["Gene Names"].apply(chip_genes)
    G = G.explode("CHIP_gene").dropna(subset=["CHIP_gene"])
    u2 = G.drop_duplicates(["Chr:Pos","Ref/Alt","CHIP_gene"]).shape[0] if len(G) else 0
    print(f"{label:<60} calls={len(S):5d} uniq(pos,alt)={u:4d} uniq(pos,alt,gene)={u2:4d}")
tally(CORE_EXONIC, A["is_chip_strict"], "PRIMARY core exonic + strict 56-gene list")
tally(CORE_EXONIC, all_true, "S1 core exonic + In_CHIP=True (all rows)")
tally(CORE_EXONIC | {"splice_region_variant"}, A["is_chip_strict"], "S2 keep splice_region_variant + strict list")
tally(CORE_EXONIC | {"5_prime_UTR_premature_start_codon_gain_variant"}, A["is_chip_strict"], "S3 keep 5'UTR-PSG (HGVS coding) + strict list")
tally(CORE_EXONIC | {"splice_region_variant","5_prime_UTR_premature_start_codon_gain_variant"}, A["is_chip_strict"], "S4 keep both ambiguous + strict list")
tally(CORE_EXONIC | {"splice_region_variant","5_prime_UTR_premature_start_codon_gain_variant"}, all_true, "S5 keep both + In_CHIP=True")
tally(CORE_EXONIC, ~A["is_chip_strict"], "S6 spurious-gene rows only (MMAB/MMACHC/SF3B2)")

banner("STEP 12  audit trail")
print(f"57,258 raw rows (86 files) -> dedupe {len(A)} -> non-reference {len(B)} -> exonic {len(C)} -> strict CHIP gene {PRIMARY}")
print("FINAL ANSWER (primary, sample x variant calls):", PRIMARY)

banner("STEP 13  robustness / independent re-count")
# (a) what did dedupe actually remove, and did it touch the exonic non-reference set?
raw = pd.concat([pd.read_excel(f, sheet_name=0, header=1).assign(
        sample=re.sub(r"^230209_Exome_GRCh38_CHIP_", "", f.stem)) for f in files],
        ignore_index=True)
so_raw = raw["Sequence Ontology (Combined)"].astype(str).str.strip()
nr_raw = raw["Zygosity"].isin(NONREF_LABELS)
ex_raw = nr_raw & so_raw.isin(CORE_EXONIC) & raw["Gene Names"].apply(lambda c: len(chip_genes(c)) > 0)
print("WITHOUT any dedupe  : raw rows", len(raw), "| non-ref", int(nr_raw.sum()),
      "| non-ref exonic CHIP-gene =", int(ex_raw.sum()), "(must equal PRIMARY)")
dupmask = raw.duplicated(["sample", "Chr:Pos", "Ref/Alt", "Sequence Ontology (Combined)"])
print("duplicate rows removed:", int(dupmask.sum()),
      "| of which non-reference:", int((dupmask & nr_raw).sum()),
      "| of which exonic-CHIP:", int((dupmask & ex_raw).sum()), "(must be 0)")
print("duplicate rows Zygosity mix:", raw.loc[dupmask, "Zygosity"].fillna("<BLANK>").value_counts().to_dict())
# (b) rows carrying >=2 symbols of the 56-gene list (would be double counted by explode)
multi = raw["Gene Names"].apply(lambda c: len(chip_genes(c)))
print("rows with >=2 CHIP symbols in Gene Names:", int((multi > 1).sum()),
      "| multi-gene rows (comma, >=1 CHIP):", int(((raw['Gene Names'].astype(str).str.contains(',')) & (multi >= 1)).sum()))
# (c) fully independent pure-python re-count
import openpyxl
tot = 0
per = {}
for f in files:
    # read_only=True is NOT usable here: these workbooks carry a broken sheet
    # dimension record (max_row/max_column reported as 1x1), so rows come back
    # truncated to one column. Normal mode reads the real cells.
    wb = openpyxl.load_workbook(f, data_only=True); ws = wb[wb.sheetnames[0]]
    hdr = next(ws.iter_rows(min_row=2, max_row=2, values_only=True))
    assert hdr[4] == "Zygosity" and hdr[12] == "Gene Names" and hdr[13] == "Sequence Ontology (Combined)"
    n = 0
    for r in ws.iter_rows(min_row=3, values_only=True):
        if r[4] in NONREF_LABELS and str(r[13]).strip() in CORE_EXONIC \
           and any(t.strip() in CHIP for t in str(r[12]).split(",")):
            n += 1
    tot += n; per[re.sub(r'^230209_Exome_GRCh38_CHIP_', '', f.stem)] = n
    wb.close()
print("openpyxl independent count (no dedupe):", tot, "| pandas PRIMARY:", PRIMARY,
      "| equal:", tot == PRIMARY)
print("samples with <35 calls:", {k: v for k, v in per.items() if v < 35})
print("ALL CHECKS PASS:", tot == PRIMARY and int((dupmask & ex_raw).sum()) == 0
      and int(D["Zygosity"].isna().sum()) == 0 and len(per) == 86)
