"""
BixBench bix-16-q2: Skewness characteristic of gene expression
(log2(TPM+1), batch-corrected) distribution across all cell lines.

Approved method:
- Primary: pooled flattened skewness over ALL 1673 cell lines x 19138 genes,
  scipy.stats.skew (Fisher-Pearson g1, bias=True / adjusted=False),
  nan_policy='omit'. No filtering, no subsampling, no re-transform.
- Supporting: per-gene skewness distribution (19138 values),
  per-cell-line skewness distribution (1673 values).
- Hygiene: duplicate/ambiguous gene labels, NaN/inf counts, Model.csv join check.
- CRISPRGeneEffect.csv intentionally EXCLUDED: question concerns the
  expression matrix only; CRISPR file is not needed to characterize its skew.
"""
import numpy as np
import pandas as pd
from scipy import stats

EXPR = 'data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv'
MODEL = 'data/Model.csv'

# ---------- Load ----------
expr = pd.read_csv(EXPR, index_col=0)
print(f"Loaded expression matrix: {expr.shape[0]} cell lines x {expr.shape[1]} genes")
n_rows, n_cols = expr.shape

# ---------- Hygiene / diagnostics ----------
labels = pd.Series(expr.columns)
dup_cols = int(labels.duplicated(keep=False).sum())
dup_unique_names = int(labels.duplicated().sum())
ambiguous_paren = int(labels.str.contains(r'\(', regex=True).sum())  # all carry (Entrez)
nan_total = int(expr.isna().values.sum())
vals = expr.to_numpy(dtype=np.float64)
inf_total = int(np.isinf(vals).sum())
zero_total = int((vals == 0).sum())
neg_total = int((vals < 0).sum())
print(f"NaN cells: {nan_total} | inf cells: {inf_total} | exact zeros: {zero_total} | negatives: {neg_total}")
print(f"Duplicate gene-label columns: {dup_cols} ({dup_unique_names} redundant); "
      f"labels with Entrez-id suffix '(n)': {ambiguous_paren}")

model = pd.read_csv(MODEL)
m = model.set_index('ModelID')
missing_in_model = expr.index.difference(m.index)
mtypes = m.loc[expr.index, 'ModelType'].value_counts()
print(f"Model.csv join: {len(missing_in_model)} expression rows missing from Model.csv; "
      f"ModelType counts for the {n_rows} used rows: {dict(mtypes)}")
print("Rows dropped due to Model.csv filtering: 0 (no filtering applied)")

# ---------- Primary: pooled skewness ----------
flat = vals.ravel()
mask = ~np.isnan(flat)
flat_omitted = flat[mask]
g1 = stats.skew(flat_omitted, bias=True, nan_policy='omit')
n = flat_omitted.size
G1 = g1 * np.sqrt(n * (n - 1)) / (n - 2)  # bias-corrected (adjusted=True equivalent)

mean_ = flat_omitted.mean()
std_ = flat_omitted.std(ddof=0)
q = np.percentile(flat_omitted, [1, 5, 25, 50, 75, 95, 99])
print("\n===== PRIMARY: pooled distribution over all "
      f"{n_rows} cell lines x {n_cols} genes (n={n:,} values) =====")
print(f"Pooled Fisher-Pearson skewness g1 (scipy.stats.skew, adjusted=False): {g1:.4f}")
print(f"Bias-corrected G1 (adjusted=True):                                   {G1:.4f}")
print(f"|G1 - g1| = {abs(G1 - g1):.2e}  (negligible)")
print(f"mean={mean_:.4f}  median={q[3]:.4f}  std={std_:.4f}")
print(f"min={flat_omitted.min():.4f}  max={flat_omitted.max():.4f}")
print("quantiles (1/5/25/50/75/95/99 %): " + ", ".join(f"{x:.3f}" for x in q))
pearson2 = 3 * (mean_ - q[3]) / std_
print(f"Cross-check Pearson 2nd skew coefficient 3(mean-median)/std = {pearson2:.4f}")

# ---------- Supporting layer (c): per-gene skewness ----------
gene_skew = stats.skew(vals, axis=0, bias=True)  # 19138 values
gq = np.percentile(gene_skew, [5, 25, 50, 75, 95])
frac_pos = float((gene_skew > 0).mean())
frac_gt1 = float((gene_skew > 1).mean())
frac_lt_m1 = float((gene_skew < -1).mean())
print("\n===== SUPPORTING (c): per-gene skewness (one value per gene, across cell lines) =====")
print(f"n genes = {gene_skew.size}")
print(f"median={gq[2]:.4f}  IQR=[{gq[1]:.3f}, {gq[3]:.3f}]  "
      f"5%/95%=[{gq[0]:.3f}, {gq[4]:.3f}]  min={gene_skew.min():.3f}  max={gene_skew.max():.3f}")
print(f"Fraction of genes with positive skew: {frac_pos:.3f} | with skew>1: {frac_gt1:.3f} | "
      f"with skew<-1: {frac_lt_m1:.3f}")

# ---------- Supporting layer (b): per-cell-line skewness ----------
line_skew = stats.skew(vals, axis=1, bias=True)  # 1673 values
lq = np.percentile(line_skew, [5, 25, 50, 75, 95])
print("\n===== SUPPORTING (b): per-cell-line skewness (one value per cell line) =====")
print(f"n cell lines = {line_skew.size}")
print(f"median={lq[2]:.4f}  IQR=[{lq[1]:.3f}, {lq[3]:.3f}]  "
      f"5%/95%=[{lq[0]:.3f}, {lq[4]:.3f}]  range=[{line_skew.min():.3f}, {line_skew.max():.3f}]")
print(f"CV of per-cell-line skewness = {line_skew.std(ddof=0)/line_skew.mean():.3f}")

# ---------- Which layer drives pooled shape ----------
print("\n===== Layer attribution =====")
print(f"Pooled g1={g1:.3f} vs per-gene median skew={gq[2]:.3f} vs per-cell-line median skew={lq[2]:.3f}")
print("Interpretation rule: if per-cell-line skew values are tightly clustered near the pooled")
print("value while per-gene skew varies widely, the pooled right-skew reflects the cross-gene")
print("expression spectrum (many near-silent genes + long high-expression tail), not a few")
print("aberrant cell lines.")
