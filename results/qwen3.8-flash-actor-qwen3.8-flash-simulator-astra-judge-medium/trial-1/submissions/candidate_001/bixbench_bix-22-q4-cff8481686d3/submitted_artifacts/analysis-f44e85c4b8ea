#!/usr/bin/env python3
"""
BixBench bix-22-q4
Question: Pearson correlation between gene length and mean expression (across samples)
for protein-coding genes in CD14 immune cells.

PRIMARY (approved): x = GeneMetaInfo.Length (bp; documented proxy for gene length, NOT a
confirmed genomic span), y = arithmetic mean of the raw batch-corrected integer read counts
across the 132 CD14 samples; genes = exact gene_biotype == 'protein_coding' (n = 19,942);
no filtering (zero-expression genes kept), no CPM/log transform, no trimming.
Everything else below is sensitivity / robustness and does not change the answer.
"""
import numpy as np
import pandas as pd
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANNOT = "data/Sample_annotated_Zenodo.csv"

meta = pd.read_csv(META, index_col=0)
cnt = pd.read_csv(COUNTS, index_col=0)
ann = pd.read_csv(ANNOT)

# ---- CD14 sample selection (annotation-driven; cross-checked against column names) ----
cd14_set = set(ann.loc[ann["celltype"] == "CD14", "sample"])
assert cd14_set == set(c for c in cnt.columns if "CD14" in c), "CD14 annotation/name mismatch"
cd14 = [c for c in cnt.columns if c in cd14_set]          # matrix order, deterministic
assert len(cd14) == 132, len(cd14)

# ---- protein-coding gene selection (exact match) ----
pc_exact = set(meta.loc[meta["gene_biotype"] == "protein_coding", "Geneid"])
assert len(pc_exact) == 19942, len(pc_exact)
pc_any = set(meta.loc[meta["gene_biotype"].str.contains("protein_coding"), "Geneid"])
assert cnt.index.is_unique and meta["Geneid"].is_unique
assert set(cnt.index) == set(meta["Geneid"])

length = meta.loc[~meta.index.duplicated(), "Length"]
X_all = cnt[cd14]

def gene_vec(genes):
    g = [x for x in cnt.index if x in genes]               # matrix order -> deterministic
    return length.loc[g].to_numpy(float), X_all.loc[g]

def pearson(x, y):
    r, p = stats.pearsonr(x, y)
    return float(r), float(p)

# ============================ PRIMARY ============================
x, mat = gene_vec(pc_exact)
mean_raw = mat.mean(axis=1).to_numpy(float)
assert mean_raw.shape == x.shape == (19942,)
r_main, p_main = pearson(x, mean_raw)
rho_main, rho_p_main = stats.spearmanr(x, mean_raw)

print("=" * 78)
print("PRIMARY  Length vs raw mean expression across 132 CD14 samples")
print("  genes (gene_biotype == 'protein_coding', exact)   n = %d" % len(x))
print("  samples                                           %d" % len(cd14))
print("  Pearson r    = %.6f   (%.4f)" % (r_main, round(r_main, 4)))
print("  p-value      = %.6g" % p_main)
print("  Spearman rho = %.6f  (p = %.3g)   [robustness]" % (rho_main, rho_p_main))
print("  mean expr: min %.4f  median %.4f  max %.1f ; zero-mean genes = %d"
      % (mean_raw.min(), np.median(mean_raw), mean_raw.max(), int((mean_raw == 0).sum())))
print("  Length:    min %.0f  median %.0f  max %.0f" % (x.min(), np.median(x), x.max()))
print("=" * 78)
print("ANSWER: Pearson r = %.4f  (n = %d protein-coding genes, 132 CD14 samples, p = %.3g)"
      % (r_main, len(x), p_main))
print("=" * 78)

# ==================== SENSITIVITY / ROBUSTNESS ====================
rows = [("PRIMARY: raw counts mean, all PC genes", r_main, len(x), "reported answer")]

for lab, keep in [("drop mean==0 genes", mean_raw > 0), ("keep mean>=1", mean_raw >= 1.0)]:
    r, p = pearson(x[keep], mean_raw[keep]); rows.append((lab, r, int(keep.sum()), "p=%.3g" % p))

cpm = X_all / X_all.sum(axis=0).to_numpy(float) * 1e6
mean_cpm = cpm.loc[mat.index].mean(axis=1).to_numpy(float)   # PC genes only, matrix order
r, p = pearson(x, mean_cpm); rows.append(("CPM-normalised then mean (all PC)", r, len(x), "p=%.3g" % p))

r, p = pearson(x, np.log2(mean_raw + 1)); rows.append(("raw mean -> log2(mean+1)", r, len(x), "p=%.3g" % p))
r, p = pearson(np.log2(x), np.log2(mean_raw + 1)); rows.append(("log2 Length vs log2(raw mean+1)", r, len(x), "p=%.3g" % p))
r, p = pearson(x, np.log2(mean_cpm + 1)); rows.append(("Length vs log2(CPM mean+1)", r, len(x), "p=%.3g" % p))

rows.append(("Spearman rho (raw mean)", float(rho_main), len(x), "p=%.3g" % rho_p_main))
rho_c, _ = stats.spearmanr(x, mean_cpm)
rows.append(("Spearman rho (CPM mean)", float(rho_c), len(x), ""))

x2, mat2 = gene_vec(pc_any)
r, p = pearson(x2, mat2.mean(axis=1).to_numpy(float))
rows.append(("incl. 12 multi-valued 'protein_coding' rows", r, len(x2), "p=%.3g" % p))

pc_genes = [g for g in cnt.index if g in pc_exact]
x_pc = length.loc[pc_genes].to_numpy(float)
for ct in ["PBMC", "CD4", "CD8", "CD19"]:
    cols = [c for c in cnt.columns if c in set(ann.loc[ann["celltype"] == ct, "sample"])]
    mraw = cnt.loc[pc_genes, cols].mean(axis=1).to_numpy(float)
    r, p = pearson(x_pc, mraw)
    rows.append(("control cell type %s (%d samples)" % (ct, len(cols)), r, len(x_pc), "p=%.3g" % p))

print("\nSENSITIVITY / ROBUSTNESS (supplementary; primary answer unchanged)")
print("%-44s %10s %8s  %s" % ("variant", "Pearson r", "n", "note"))
print("-" * 78)
for lab, r, n, note in rows:
    print("%-44s %10.4f %8d  %s" % (lab, r, n, note))

print("\nLIMITATIONS: Length is the provided column (featureCounts-style summed length; CSMD1=18705"
      "\n  shows it is NOT genomic span); batch (4 levels) / sex / samtype confounding NOT adjusted;"
      "\n  CD14 library sizes range 1.6M-47M reads; p-values unreliable under heavy right-skew and"
      "\n  outlier domination -> treat Spearman rho and CPM rows as the robustness checks.")
