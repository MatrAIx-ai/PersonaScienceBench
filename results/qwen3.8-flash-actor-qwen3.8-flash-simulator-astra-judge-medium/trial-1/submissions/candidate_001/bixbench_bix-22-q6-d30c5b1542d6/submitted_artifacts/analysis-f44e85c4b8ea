"""
bixbench:bix-22-q6
Question: When examining protein-coding genes only, what is the pearson
correlation coefficient between gene length and gene expression?

Approved scope:
  - protein-coding genes only (gene_biotype == 'protein_coding'), inner join on Geneid
  - per-gene expression = arithmetic mean of raw batch-corrected counts over all 723 samples
  - PRIMARY estimate = scipy.stats.pearsonr(Length, raw mean expression) -> r
  - Sensitivity diagnostics ONLY (do not replace primary): log2(mean+1), median,
    row-sum, drop all-zero genes, drop low-expression genes, drop top-1% longest genes
  - No CPM/quantile/voom-type normalization, no zero filtering in the primary estimate
  - Sample_annotated_Zenodo.csv used only as a sanity check (no filter / no subgroup)
"""
import numpy as np
import pandas as pd
from scipy.stats import pearsonr

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANNOT = "data/Sample_annotated_Zenodo.csv"

# ---------- load ----------
meta = pd.read_csv(META)
counts = pd.read_csv(COUNTS, index_col=0)
annot = pd.read_csv(ANNOT)

print("=== SANITY CHECKS ===")
print("meta shape:", meta.shape, list(meta.columns))
print("counts shape (genes x samples):", counts.shape)
print("counts dtypes unique:", set(map(str, counts.dtypes)))
print("counts NAs:", int(counts.isna().sum().sum()))
print("annot shape:", annot.shape, list(annot.columns))
print("samples in annot matched to count columns: %d/%d ; unmatched columns: %d"
      % (annot["sample"].isin(counts.columns).sum(), len(annot),
         len(set(counts.columns) - set(annot["sample"]))))
print("Geneid unique:", meta["Geneid"].is_unique)

# ---------- protein-coding subset, inner join on Geneid ----------
pc = meta.loc[meta["gene_biotype"] == "protein_coding", ["Geneid", "Length"]]
print("\nprotein_coding rows in meta:", len(pc))

expr = counts.mean(axis=1)                      # primary per-gene scalar: raw mean
med = counts.median(axis=1)
tot = counts.sum(axis=1)
n_nonzero = (counts > 0).sum(axis=1)

df = pc.set_index("Geneid").join(
    pd.DataFrame({"mean_raw": expr, "median_raw": med, "rowsum": tot,
                  "n_nonzero": n_nonzero}),
    how="inner"
)
print("after inner join (analysis rows):", len(df))
assert len(df) == len(pc)

length = df["Length"].to_numpy(float)
mean_raw = df["mean_raw"].to_numpy(float)

# ---------- PRIMARY ESTIMATE ----------
r_primary, p_primary = pearsonr(length, mean_raw)
print("\n=== PRIMARY (raw mean expression, no normalization, no filtering) ===")
print("n genes = %d   Pearson r = %.6f   p = %.3e" % (len(df), r_primary, p_primary))

# ---------- SENSITIVITY DIAGNOSTICS ----------
rows = []
def add(name, x, y):
    r, p = pearsonr(np.asarray(x, float), np.asarray(y, float))
    rows.append({"variant": name, "n": len(x), "pearson_r": r, "p_value": p})

add("PRIMARY: raw mean", length, mean_raw)
add("log2(mean+1)", length, np.log2(mean_raw + 1.0))
add("log10(mean+1)", length, np.log10(mean_raw + 1.0))
add("per-gene median", length, df["median_raw"])
add("row-sum (total counts)", length, df["rowsum"])
add("log2(rowsum+1)", length, np.log2(df["rowsum"] + 1.0))
add("drop all-zero genes", df.loc[df["mean_raw"] > 0, "Length"], df.loc[df["mean_raw"] > 0, "mean_raw"])
add("drop mean_raw < 1", df.loc[df["mean_raw"] >= 1, "Length"], df.loc[df["mean_raw"] >= 1, "mean_raw"])
add("drop expressed in <10% samples", df.loc[df["n_nonzero"] >= 0.10 * counts.shape[1], "Length"],
    df.loc[df["n_nonzero"] >= 0.10 * counts.shape[1], "mean_raw"])
thr = np.quantile(length, 0.99)
add("drop top-1%% longest genes (Length <= %.0f)" % thr,
    df.loc[df["Length"] <= thr, "Length"], df.loc[df["Length"] <= thr, "mean_raw"])
add("Spearman on raw mean (robustness)", length, mean_raw)

sens = pd.DataFrame(rows)
sens.loc[sens.index[-1], "variant"] = "Spearman rho on raw mean (robustness only)"
from scipy.stats import spearmanr
rho, prho = spearmanr(length, mean_raw)
sens.loc[sens.index[-1], ["pearson_r", "p_value"]] = [rho, prho]

print("\n=== SENSITIVITY TABLE (diagnostics; primary NOT replaced) ===")
print(sens.to_string(index=False, float_format=lambda v: f"{v:.6g}"))

print("\n=== DISTRIBUTION DIAGNOSTICS ===")
print("Length: min %d max %d mean %.1f median %.1f" %
      (df["Length"].min(), df["Length"].max(), df["Length"].mean(), df["Length"].median()))
print("raw mean expr: min %.4f max %.2f mean %.2f median %.4f" %
      (df["mean_raw"].min(), df["mean_raw"].max(), df["mean_raw"].mean(), df["mean_raw"].median()))
print("protein-coding genes with mean_raw == 0: %d (%.2f%%)" %
      ((df["mean_raw"] == 0).sum(), 100 * (df["mean_raw"] == 0).mean()))
print("overall matrix zeros (all genes): %.3f%%" % (100 * (counts.to_numpy() == 0).mean()))
print("zero fraction within protein-coding block: %.3f%%"
      % (100 * (counts.loc[df.index].to_numpy() == 0).mean()))
print("top-5 longest protein-coding genes:\n",
      df["Length"].sort_values(ascending=False).head(5).to_string())

print("\nANSWER (primary): Pearson r = %.6f  (n = %d protein-coding genes)"
      % (r_primary, len(df)))
