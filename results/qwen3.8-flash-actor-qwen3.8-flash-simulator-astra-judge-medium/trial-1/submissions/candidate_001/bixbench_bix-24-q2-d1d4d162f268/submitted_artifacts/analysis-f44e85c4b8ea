#!/usr/bin/env python3
"""
CBD vs DMSO / CBD+SS vs DMSO+SS in CRC cells: DE + GO-BP-proxy enrichment to
determine whether up- or down-regulation drives metabolic effects.

TOOLING (attempted, logged): sandbox has NO R (Rscript absent), NO network
(DNS + direct-IP blocked), NO pydeseq2/gseapy/clusterProfiler, NO local
Ensembl/GENCODE annotation files (filesystem search). Therefore:
  * DE = pure-Python DESeq2-equivalent (independent implementation in
    de_engine.py: median-of-ratios size factors, NB2 GLM IRLS, dispersion
    MLE + trend + EB shrinkage, Wald test, BH FDR). NOT validated against
    DESeq2; no claim of running DESeq2.
  * GO BP = curated offline proxy: high-confidence ENSG seeds per GO-BP term,
    each ID validated (exists in table, expressed in controls, co-expression
    linked to a module mate at Spearman>=0.45), modules then expanded on
    group-centered co-expression (residual Spearman>=0.65), plus the
    self-verifying chrM block (GO:0006119, MT-encoded OXPHOS). Coverage is
    far below 50% of tested genes -> reported as a conclusion-shaping
    limitation, per researcher condition.
Pre-registered decision ladder (fixed before seeing enrichment output):
  M1 = # metabolic GO-BP terms padj<0.05 (up vs down, summed over contrasts)
  M2 = tie-break: lowest metabolic padj per direction
  M3 = support: median log2FC of leading-edge metabolic genes; MT-OXPHOS anchor
  Cross-contrast agreement required; disagreement would be reported as such.
"""
import json, subprocess, sys
import numpy as np, pandas as pd
from scipy.stats import hypergeom, mannwhitneyu, ttest_ind
from statsmodels.stats.multitest import multipletests

LOG=[]
def log(msg): print(msg); LOG.append(str(msg))

# ---------- 0. tooling attempts (evidence) ----------
try:
    subprocess.run(["Rscript","--version"],capture_output=True,check=True); log("R AVAILABLE")
except Exception as e: log(f"R unavailable: {type(e).__name__}")
try:
    import pydeseq2; log("pydeseq2 available")
except ImportError: log("pydeseq2 unavailable")
try:
    import gseapy; log("gseapy available")
except ImportError: log("gseapy unavailable")
try:
    import urllib.request; urllib.request.urlopen("https://pypi.org/simple/",timeout=8); log("network OK")
except Exception as e: log(f"network unavailable: {type(e).__name__}")

# ---------- 1. load ----------
counts=pd.read_csv("data/counts_raw_unfiltered.csv",index_col=0)
layout=pd.read_csv("data/sample_layout.csv"); layout["col"]=layout.SampleID.str.replace("-","_")
g2s=dict(zip(layout.col,layout.Group))
groups=np.array([g2s[c] for c in counts.columns])
assert sorted(groups)==sorted(layout.Group.tolist())
log(f"counts {counts.shape}, integer raw: {(counts.values%1==0).all() and (counts.values>=0).all()}")

# ---------- 2. DE (pure-python DESeq2-equivalent) ----------
import de_engine as de
CONTRASTS={"CBD_IC50_vs_DMSO":("DMSO","CBD_IC50"),
           "CBD_IC50_SS16h_vs_DMSO_SS":("DMSO_Serum_starvation","CBD_IC50_Serum_starvation_16h")}
DE={}
for name,(ctrl,trt) in CONTRASTS.items():
    res,sf,keep,popt,pv=de.de_analysis(counts,groups,ctrl,trt)
    res["log2FC"]=res["log2FC_CBDvsCtrl"]
    res["up"]=  (res.padj<0.05)&(res.log2FC> 0.5)
    res["down"]=(res.padj<0.05)&(res.log2FC<-0.5)
    DE[name]=res
    res.to_csv(f"results/DE_{name}.csv",index=False)
    res[res.up].to_csv(f"results/DP_up_{name}.csv",index=False)
    res[res.down].to_csv(f"results/DP_down_{name}.csv",index=False)
    log(f"[{name}] tested={len(res)} up={int(res.up.sum())} down={int(res.down.sum())} "
        f"(padj<0.05 any={int((res.padj<0.05).sum())}); SF={np.round(sf,3)}")

# sanity cross-check of engine vs Welch t-test on log2 CPM
cpm=np.log2(counts/counts.sum(axis=0)*1e6+1)
for name,(ctrl,trt) in CONTRASTS.items():
    cols=np.isin(groups,[ctrl,trt]); a=cols&(groups==ctrl); b=cols&(groups==trt)
    sub=cpm.values[:,cols]
    t,p=ttest_ind(sub[:,b[cols]],sub[:,a[cols]],axis=1,equal_var=False)
    tt=pd.Series(t,index=counts.index)
    j=pd.DataFrame({"t":tt}).join(DE[name].set_index("ensembl_id")[["stat"]],how="inner").dropna()
    ta=set(j.t.abs().nlargest(500).index); st=set(j["stat"].abs().nlargest(500).index)
    log(f"[sanity {name}] n={len(j)} Spearman(NB-Wald z, Welch t)={j.t.corr(j['stat'],method='spearman'):.3f}; top500 overlap={len(ta&st)}")

# ---------- 3. annotation (curated GO-BP-proxy, validated) ----------
SEEDS={
 "GO:0006695|cholesterol biosynthetic process|(metabolic)":{"HMGCR":"ENSG00000113161","HMGCS1":"ENSG00000112972",
   "SQLE":"ENSG00000104549","LDLR":"ENSG00000130164","INSIG1":"ENSG00000186480","CYP51A1":"ENSG00000001630",
   "DHCR24":"ENSG00000116133","EBP":"ENSG00000147155","SC5D":"ENSG00000109929"},
 "GO:0006096|glycolytic process|(metabolic)":{"GAPDH":"ENSG00000111640","ENO1":"ENSG00000074800","PKM":"ENSG00000067225",
   "PGK1":"ENSG00000102144","ALDOA":"ENSG00000149925","SLC2A1":"ENSG00000117394","PGAM1":"ENSG00000109107","GPI":"ENSG00000105220"},
 "GO:0006635|fatty acid biosynthetic process|(metabolic)":{"SREBF1":"ENSG00000146112","SCD":"ENSG00000140465","FASN":"ENSG00000019186"},
 "GO:0006119|oxidative phosphorylation, MT-encoded|(metabolic)":None,
 "GO:0034976|response to ER stress / UPR|(non-metabolic)":{"HSPA5":"ENSG00000044574","TRIB3":"ENSG00000101255","SLC7A11":"ENSG00000151012"},
 "GO:0006915_0034198|apoptosis / p53 stress response|(non-metabolic)":{"TP53":"ENSG00000141510","CDKN1A":"ENSG00000124762",
   "BAX":"ENSG00000087088","MDM2":"ENSG00000135679","GADD45A":"ENSG00000116717"},
}
pos=list(counts.index).index("ENSG00000198804")  # MT-CO1; self-verifying chrM block
MTpc=[e for e in counts.index[pos-8:pos+25]
      if e.startswith(("ENSG000001986","ENSG000001987","ENSG000001988","ENSG000001989"))]
log(f"MT-encoded (self-verified chrM block) protein-coding genes n={len(MTpc)}")

cpm0=counts/counts.sum(axis=0)*1e6
ctrl_cols=["3_1","3_2","3_3","4_1","4_2","4_3"]
l=np.log2(cpm0+1)
gc=l.copy()
for gg in np.unique(groups): gc.loc[:,groups==gg]=l.loc[:,groups==gg].sub(l.loc[:,groups==gg].mean(axis=1),axis=0)
R=gc.rank(axis=1).values
Rm=((R-R.mean(axis=1,keepdims=True))/np.maximum(R.std(axis=1,keepdims=True),1e-9))
index=list(gc.index); pos_of={e:i for i,e in enumerate(index)}
tested=set(DE["CBD_IC50_vs_DMSO"].ensembl_id)&set(DE["CBD_IC50_SS16h_vs_DMSO_SS"].ensembl_id)
val_rows=[]; MODULES={}
for term,seeds in SEEDS.items():
    if seeds is None:
        MODULES[term]=set(MTpc)
        val_rows.append({"term":term,"gene":"MT_BLOCK","ensg":f"n={len(MTpc)}","kept":True,"note":"self-verified chrM block"})
        continue
    ids={s:e for s,e in seeds.items() if e in counts.index}
    for s,e in seeds.items():
        if e not in counts.index: val_rows.append({"term":term,"gene":s,"ensg":e,"kept":False,"note":"ID_NOT_IN_TABLE"})
    expr={s:e for s,e in ids.items() if cpm0.loc[e,ctrl_cols].mean()>=1}
    for s in set(ids)-set(expr): val_rows.append({"term":term,"gene":s,"ensg":ids[s],"kept":False,"note":"NOT_EXPRESSED_CTRL"})
    syms=list(expr)
    M=np.zeros((len(syms),len(syms)))
    for i,a in enumerate(syms):
        for j,b in enumerate(syms):
            M[i,j]=Rm[pos_of[expr[a]]]@Rm[pos_of[expr[b]]]/Rm.shape[1]
    kept=set()
    for i,a in enumerate(syms):
        best=max([M[i,j] for j in range(len(syms)) if j!=i] or [0])
        if best>=0.45: kept.add(a)
        else: val_rows.append({"term":term,"gene":a,"ensg":expr[a],"kept":False,"note":f"NO_COEXP_PARTNER maxr={best:.2f}"})
    if len(kept)<3:
        for a in kept: val_rows.append({"term":term,"gene":a,"ensg":expr[a],"kept":False,"note":"MODULE_TOO_SMALL_DROPPED"})
        continue
    prof=Rm[[pos_of[expr[a]] for a in kept]].mean(axis=0); prof=(prof-prof.mean())/max(prof.std(),1e-9)
    rvec=Rm@prof/Rm.shape[1]
    genes={expr[a] for a in kept}; n_seed=len(genes)
    for i,e in enumerate(index):
        if rvec[i]>=0.65 and e in tested and counts.loc[e].mean()>=5: genes.add(e)
    MODULES[term]=genes
    log(f"module {term[:52]}: seeds_kept={n_seed} expanded_to={len(genes)}")
    for a in kept: val_rows.append({"term":term,"gene":a,"ensg":expr[a],"kept":True,"note":"seed_validated"})
pd.DataFrame(val_rows).to_csv("results/annotation_validation.csv",index=False)

universe=set().union(*MODULES.values())&tested
log(f"ANNOTATION COVERAGE: universe=annotated&tested = {len(universe)} "
    f"({100*len(universe)/len(tested):.2f}% of {len(tested)} tested) << 50% -> conclusion-shaping limitation")

# ---------- 4. separate up/down GO-BP enrichment ----------
enr_rows=[]
for name in CONTRASTS:
    res=DE[name].set_index("ensembl_id"); univ=sorted(universe)
    for direc in ["up","down"]:
        de_g=set(res.index[res[direc]]); sample_n=len(de_g&set(univ)); rows=[]
        for term,genes in MODULES.items():
            K=len(genes&set(univ)); k=len(genes&de_g&set(univ))
            p=float(hypergeom.sf(k-1,len(univ),K,sample_n)) if K>0 and sample_n>0 and k>0 else 1.0
            medlfc=float(np.median([res.log2FC[e] for e in sorted(genes&set(univ))]))
            rows.append({"contrast":name,"direction":direc,"term":term,"N_universe":len(univ),"K_term":K,
                         "n_de_in_universe":sample_n,"k_obs":k,"p":p,"medianLFC_term":round(medlfc,3),
                         "DE_members":",".join(sorted(genes&de_g)[:15])})
        adj=multipletests([r["p"] for r in rows],method="fdr_bh")[1]
        for r,q in zip(rows,adj): r["padj"]=round(float(q),4); enr_rows.append(r)
E=pd.DataFrame(enr_rows); E.to_csv("results/enrichment_all.csv",index=False)
log("\n=== ENRICHMENT (BH within contrast x direction) ===")
for name in CONTRASTS:
    for direc in ["up","down"]:
        sub=E[(E.contrast==name)&(E.direction==direc)].sort_values("p")
        log(f"-- {name} | {direc} (n_DE_in_universe={sub.n_de_in_universe.iloc[0]}):")
        for _,r in sub.iterrows():
            log(f"   {'MET ' if '(metabolic)' in r.term else '    '}{r.term[:56]:56s} k={r.k_obs:3d}/{r.K_term:3d} p={r.p:.2e} padj={r.padj:.3f} medLFC={r.medianLFC_term:+.2f}")

# ---------- 5. pre-registered decision ladder ----------
met=lambda t:"(metabolic)" in t
sig=E[E.padj<0.05]; summary={}
for direc in ["up","down"]:
    m=sig[sig.term.map(met)&(sig.direction==direc)]
    summary[f"M1_metabolic_terms_{direc}"]=len(m)
    summary[f"M1_detail_{direc}"]=[f"{r.contrast}:{r.term}" for _,r in m.iterrows()]
    summary[f"M2_min_metabolic_padj_{direc}"]=float(E[E.term.map(met)&(E.direction==direc)].padj.min())
log("\n=== DECISION LADDER ===")
for k,v in summary.items(): log(f"{k}: {v}")
mtg=MODULES["GO:0006119|oxidative phosphorylation, MT-encoded|(metabolic)"]
for name in CONTRASTS:
    r=DE[name].set_index("ensembl_id")
    mg=sorted(set().union(*[g for t,g in MODULES.items() if met(t)]).intersection(universe))
    ng=sorted(set().union(*[g for t,g in MODULES.items() if not met(t)]).intersection(universe))
    u=mannwhitneyu([r.log2FC[e] for e in mg],[r.log2FC[e] for e in ng])
    log(f"[M3 {name}] medianLFC metabolic={np.median([r.log2FC[e] for e in mg]):+.3f} "
        f"nonmet-stress={np.median([r.log2FC[e] for e in ng]):+.3f} MWU p={u.pvalue:.2e} | "
        f"MT-OXPHOS medLFC={np.median([r.log2FC[e] for e in mtg if e in r.index]):+.3f}")
with open("results/decision_summary.json","w") as f: json.dump(summary,f,indent=1)
with open("results/run_log.txt","w") as f: f.write("\n".join(LOG))
log("\nDONE")
