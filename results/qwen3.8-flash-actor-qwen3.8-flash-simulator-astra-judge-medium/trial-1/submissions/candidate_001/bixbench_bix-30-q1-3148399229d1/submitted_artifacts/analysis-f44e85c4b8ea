#!/usr/bin/env python3
"""BixBench bix-30-q1: % of miRNAs with significant patient-vs-control
differential expression before multiple-testing correction.

Input : data/pone.0150501.s002.xls  (single sheet 'RAW DATA', 175 miRNA rows x
        20 sample columns P_1..P_10 = DM1 patients, C_11..C_20 = controls,
        raw technical-replicate-averaged Ct values, 22 literal 'NAN' cells)
Primary: two-sided independent-samples Student's t-test on raw Ct per miRNA,
        pairwise deletion of 'NAN'; significant = raw p < 0.05 (strict).
Run:   python3 work/analysis.py
"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from scipy import stats
import biff

XLS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                   'data', 'pone.0150501.s002.xls')

# ---------------------------------------------------------------- load
grid = biff.read_xls(XLS)[0]['RAW DATA']
hdr = grid[1]
samples = [str(h) for h in hdr[1:]]
groups = [0 if s.startswith('P') else 1 for s in samples]   # 0=patient, 1=control
rows = grid[2:]
names, mat = [], []
for r in rows:
    vals = []
    for ci in range(1, len(samples) + 1):
        v = r[ci] if ci < len(r) else None
        vals.append(float(v) if isinstance(v, (int, float)) else np.nan)  # 'NAN' -> nan
    names.append(str(r[0]))
    mat.append(vals)
names = np.array(names)
X = np.array(mat, dtype=float)
P = np.array(groups) == 0

assert X.shape == (175, 20), X.shape
assert len(set(names.tolist())) == 175
print('sheet: RAW DATA | miRNAs = %d | samples = %d (patients %d, controls %d)'
      % (X.shape[0], X.shape[1], P.sum(), (~P).sum()))
print("missing cells ('NAN' text -> nan): %d of %d" % (int(np.isnan(X).sum()), X.size))
print('Ct range: %.3f - %.3f (mean %.3f)\n' % (np.nanmin(X), np.nanmax(X), np.nanmean(X)))

# ---------------------------------------------------------------- tests
def run(test, data, kwargs=None):
    """Per-miRNA two-sided test patients vs controls, pairwise deletion."""
    kw = kwargs or {}
    out = []
    for i in range(data.shape[0]):
        a = data[i][P]; b = data[i][~P]
        a = a[~np.isnan(a)]; b = b[~np.isnan(b)]
        try:
            p = test(a, b, **kw).pvalue
        except Exception:
            p = np.nan
        if p is None or np.isnan(p):
            p = np.nan
        out.append(float(p))
    return np.array(out, dtype=float)

res = {}
res['primary_student'] = run(stats.ttest_ind, X, dict(equal_var=True))
res['welch']           = run(stats.ttest_ind, X, dict(equal_var=False))
res['mannwhitney']     = run(stats.mannwhitneyu, X, dict(alternative='two-sided'))
# Ct >= 35 treated as undetermined and excluded
X35 = np.where(X >= 35, np.nan, X)
res['excl_Ct_ge_35']   = run(stats.ttest_ind, X35, dict(equal_var=True))
# expression scale sensitivity
res['neg2_pow_Ct']     = run(stats.ttest_ind, np.power(2.0, -X), dict(equal_var=True))

print('=' * 78)
print('%-28s %10s %10s   %s' % ('VARIANT', 'n_sig', 'n_tested', 'percent'))
print('-' * 78)
for k, p in res.items():
    ok = ~np.isnan(p)
    n_sig = int(np.nansum(p < 0.05))
    print('%-28s %10d %10d   %6.2f%%' % (k, n_sig, int(ok.sum()), 100.0 * n_sig / ok.sum()))

# complete-case variant: miRNAs with no missing value at all (denominator 161)
cc = ~np.isnan(X).any(axis=1)
p_cc = res['primary_student'][cc]
print('%-28s %10d %10d   %6.2f%%   [variant: complete-case miRNAs only]'
      % ('student_completecase', int((p_cc < 0.05).sum()), int(cc.sum()),
         100.0 * (p_cc < 0.05).sum() / cc.sum()))

n_sig = int((res['primary_student'] < 0.05).sum())
print('\nHEADLINE: %d of %d = %.2f%%  (%.4f%%)'
      % (n_sig, X.shape[0], 100.0 * n_sig / X.shape[0], 100.0 * n_sig / X.shape[0]))

# ---------------------------------------------------------------- p distribution
print('\np-value distribution (Student t, raw Ct, n=175):')
for th in (0.0001, 0.001, 0.01, 0.05, 0.10):
    print('   p < %-7g : %3d  (%.2f%%)' % (th, int((res['primary_student'] < th).sum()),
                                           100.0 * (res['primary_student'] < th).mean()))
order = np.argsort(res['primary_student'])
print('\nsmallest 12 primary p-values:')
for i in order[:12]:
    print('   %-16s p=%.3e  meanP=%6.3f  meanC=%6.3f  dCt=%+.3f'
          % (names[i], res['primary_student'][i],
             np.nanmean(X[i][P]), np.nanmean(X[i][~P]),
             np.nanmean(X[i][P]) - np.nanmean(X[i][~P])))
print('\ntop 5 non-significant (largest count-driving borderline):')
ns = [(res['primary_student'][i], names[i]) for i in range(len(names))
      if not res['primary_student'][i] < 0.05]
for p, nm in sorted(ns)[:5]:
    print('   %-16s p=%.4f' % (nm, p))

# ---------------------------------------------------------------- flips
def flips(key, label):
    sig = res['primary_student'] < 0.05
    o = ~np.isnan(res[key]) & (res[key] < 0.05)
    diff = np.where(sig != o)[0]
    print('\nFlips: primary Student vs %s -> %d miRNA(s)' % (label, len(diff)))
    for i in diff:
        pp, po = res['primary_student'][i], res[key][i]
        band = 'BORDERLINE (0.03<=p<=0.08)' if (0.03 <= min(pp, po) <= 0.08 or 0.03 <= max(pp, po) <= 0.08) else 'not borderline'
        print('   %-16s student p=%.4f (%s) | %s p=%.4f (%s) -> %s'
              % (names[i], pp, 'sig' if sig[i] else 'ns', label, po,
                 'sig' if o[i] else 'ns', band))
    return diff

flips('welch', 'Welch')
flips('mannwhitney', 'MannWhitney')
flips('excl_Ct_ge_35', 'Student_exclCt35')
flips('neg2_pow_Ct', 'Student_2^-Ct')

# borderline miRNAs near threshold in primary
print('\nprimary p in [0.03, 0.08] (borderline zone):')
for i in np.argsort(res['primary_student']):
    p = res['primary_student'][i]
    if 0.03 <= p <= 0.08:
        print('   %-16s p=%.4f  welch=%.4f  mwu=%.4f' % (names[i], p, res['welch'][i], res['mannwhitney'][i]))
print('=' * 78)
