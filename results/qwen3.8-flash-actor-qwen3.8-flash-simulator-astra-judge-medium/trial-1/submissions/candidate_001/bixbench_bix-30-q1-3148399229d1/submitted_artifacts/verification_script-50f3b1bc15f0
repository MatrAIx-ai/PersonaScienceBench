#!/usr/bin/env python3
"""Independent re-computation of the headline from work/mirna_ct_clean.csv
(written directly from the parsed BIFF8 grid) to confirm reproducibility."""
import os, sys, csv
import numpy as np
from scipy import stats
here = os.path.dirname(os.path.abspath(__file__))
rows = list(csv.reader(open(os.path.join(here, 'mirna_ct_clean.csv'))))
hdr, body = rows[0], rows[1:]
samples = hdr[1:]
P = np.array([s.startswith('P') for s in samples])
X = np.array([[float(v) if v != '' else np.nan for v in r[1:]] for r in body])
print('rows=%d cols=%d patients=%d controls=%d missing=%d' %
      (X.shape[0], X.shape[1], P.sum(), (~P).sum(), int(np.isnan(X).sum())))
ps = np.array([stats.ttest_ind(X[i][P][~np.isnan(X[i][P])],
                               X[i][~P][~np.isnan(X[i][~P])],
                               equal_var=True).pvalue for i in range(X.shape[0])])
sig = ps < 0.05
print('CSV path: %d of %d = %.4f%%' % (sig.sum(), X.shape[0], 100.0 * sig.mean()))
names = np.array([r[0] for r in body])
d = np.nanmean(X[:, P], axis=1) - np.nanmean(X[:, ~P], axis=1)
print('among significant: %d lower Ct in patients (= higher expression), %d higher Ct'
      % (int((d[sig] < 0).sum()), int((d[sig] > 0).sum())))
print('min p=%.3e (%s); max p=%.3f' % (ps.min(), names[ps.argmin()], ps.max()))
