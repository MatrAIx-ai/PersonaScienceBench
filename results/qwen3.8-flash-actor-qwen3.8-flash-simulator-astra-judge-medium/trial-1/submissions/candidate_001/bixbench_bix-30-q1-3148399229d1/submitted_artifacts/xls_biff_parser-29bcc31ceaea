"""Minimal BIFF8 (.xls worksheet) parser on top of ole.Ole."""
import struct
from ole import Ole

CONTINUE = 0x003C
SST = 0x00FC

def decode_rk(rk):
    div100 = rk & 1
    is_int = (rk >> 1) & 1
    if is_int:
        val = float(struct.unpack('<i', struct.pack('<I', rk & 0xfffffffc))[0] >> 2)
    else:
        val = struct.unpack('<d', b'\x00\x00\x00\x00' + struct.pack('<I', rk & 0xfffffffc))[0]
    return val / 100.0 if div100 else val

class BlockReader:
    """Reader over a first payload then CONTINUE payloads; exposes raw byte positions."""
    def __init__(self, blocks):
        self.blocks = list(blocks); self.bi = 0; self.pos = 0
    def cur(self):
        return self.blocks[self.bi]
    def read_byte(self):
        if self.pos >= len(self.cur()):
            self.bi += 1; self.pos = 0
        b = self.cur()[self.pos]; self.pos += 1; return b
    def read_uint16(self):
        b0 = self.read_byte(); b1 = self.read_byte(); return b0 | (b1 << 8)
    def read_uint32(self):
        return self.read_uint16() | (self.read_uint16() << 16)
    def skip(self, n):
        for _ in range(n):
            self.read_byte()
    def read_string(self, nchars, high_byte):
        chars = []
        while len(chars) < nchars:
            blk = self.cur()
            avail = len(blk) - self.pos
            if high_byte:
                take = min(nchars - len(chars), avail // 2)
                for k in range(take):
                    chars.append(struct.unpack('<H', blk[self.pos + 2 * k:self.pos + 2 * k + 2])[0])
                self.pos += 2 * take
            else:
                take = min(nchars - len(chars), avail)
                for k in range(take):
                    chars.append(blk[self.pos + k])
                self.pos += take
            if len(chars) < nchars:
                self.bi += 1; self.pos = 0
                flags = self.read_byte()          # options byte at CONTINUE boundary
                high_byte = bool(flags & 1)
        return ''.join(chr(c) for c in chars)

def parse_sst(blocks):
    r = BlockReader(blocks)
    total = r.read_uint32(); unique = r.read_uint32()
    out = []
    for _ in range(unique):
        nchars = r.read_uint16(); flags = r.read_byte()
        high = bool(flags & 1); rich = bool(flags & 0x08); extst = bool(flags & 0x04)
        cbrun = r.read_uint16() if rich else 0
        cbext = r.read_uint32() if extst else 0
        s = r.read_string(nchars, high)
        r.skip(4 * cbrun); r.skip(cbext)
        out.append(s)
    return out

def read_xls(path):
    ole = Ole(path)
    wb = ole.stream('Workbook') or ole.stream('Book')
    if wb is None:
        raise RuntimeError('no Workbook stream; entries=%s' % ole.names())
    n = len(wb)
    def recs_at(start, stop):
        i = start
        while i + 4 <= stop:
            rid, ln = struct.unpack('<HH', wb[i:i + 4])
            yield i, rid, wb[i + 4:i + 4 + ln], ln
            i += 4 + ln
    # top-level records (globals)
    sheets = []
    sst = []
    for i, rid, p, ln in recs_at(0, n):
        if rid == 0x0085:  # BoundSheet8
            pos = struct.unpack('<I', p[:4])[0]
            cch, flags = p[6], p[7]
            if flags & 1:
                name = ''.join(chr(struct.unpack('<H', p[8 + 2 * j:10 + 2 * j])[0]) for j in range(cch))
            else:
                name = ''.join(chr(p[8 + j]) for j in range(cch))
            sheets.append((name, pos))
        elif rid == SST:
            blocks = [p]
        elif rid == CONTINUE and sheets == [] and 'blocks' in dir() and sst == []:
            pass
    # gather SST from globals: find SST record and its CONTINUEs
    i = 0
    while i + 4 <= n:
        rid, ln = struct.unpack('<HH', wb[i:i + 4])
        if rid == SST:
            blocks = [wb[i + 4:i + 4 + ln]]; i += 4 + ln
            while i + 4 <= n:
                r2, l2 = struct.unpack('<HH', wb[i:i + 4])
                if r2 != CONTINUE:
                    break
                blocks.append(wb[i + 4:i + 4 + l2]); i += 4 + l2
            sst = parse_sst(blocks)
            break
        i += 4 + ln
    bounds = sorted(set([p for _, p in sheets] + [n]))
    result = {}
    for name, start in sheets:
        stop = min([b for b in bounds if b > start] + [n])
        cells = {}; formula_last = None
        for i, rid, p, ln in recs_at(start, stop):
            if rid == 0x00FD and len(p) >= 10:      # LABELSST
                r, c, xf, isst = struct.unpack('<HHHI', p[:10])
                cells[(r, c)] = sst[isst] if isst < len(sst) else '#SST%d' % isst
            elif rid == 0x0203 and len(p) >= 14:    # NUMBER
                r, c = struct.unpack('<HH', p[:4])
                cells[(r, c)] = struct.unpack('<d', p[6:14])[0]
            elif rid == 0x027E and len(p) >= 10:    # RK
                r, c, xf, rk = struct.unpack('<HHHI', p[:10])
                cells[(r, c)] = decode_rk(rk)
            elif rid == 0x00BD:                     # MULRK
                r, c1 = struct.unpack('<HH', p[:4])
                m = (len(p) - 6) // 6
                for q in range(m):
                    off = 4 + 6 * q
                    rk = struct.unpack('<I', p[off + 2:off + 6])[0]
                    cells[(r, c1 + q)] = decode_rk(rk)
            elif rid == 0x0204 and len(p) >= 9:     # LABEL
                r, c, xf, cc = struct.unpack('<HHHH', p[:8])
                fl = p[8]
                if fl & 1:
                    cells[(r, c)] = ''.join(chr(struct.unpack('<H', p[9 + 2 * t:11 + 2 * t])[0]) for t in range(cc))
                else:
                    cells[(r, c)] = ''.join(chr(p[9 + t]) for t in range(cc))
            elif rid == 0x0205 and len(p) >= 8:     # BOOLERR
                r, c, xf, v, e = struct.unpack('<HHHBB', p[:8])
                cells[(r, c)] = ('#ERR%d' % e) if e else bool(v)
            elif rid == 0x0006 and len(p) >= 14:    # FORMULA: placeholder by value type
                r, c = struct.unpack('<HH', p[:4])
                cells[(r, c)] = None if formula_last is None else formula_last
                formula_last = 'F'
            elif rid == 0x0207:                     # STRING (result of formula)
                cc = struct.unpack('<H', p[:2])[0]; fl = p[2]
                if fl & 1:
                    formula_last = ''.join(chr(struct.unpack('<H', p[3 + 2 * t:5 + 2 * t])[0]) for t in range(cc))
                else:
                    formula_last = ''.join(chr(p[3 + t]) for t in range(cc))
                cells['LAST_FORMULA'] = formula_last
            elif rid == 0x000A:                     # EOF
                break
        cells.pop('LAST_FORMULA', None)
        if not cells:
            result[name] = []; continue
        maxr = max(k[0] for k in cells); maxc = max(k[1] for k in cells)
        grid = [[None] * (maxc + 1) for _ in range(maxr + 1)]
        for (r, c), v in cells.items():
            grid[r][c] = v
        result[name] = grid
    return result, sst
