"""Minimal OLE2 (Compound File Binary Format) reader -- no external deps."""
import struct

class Ole:
    def __init__(self, path):
        self.data = open(path, 'rb').read()
        assert self.data[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1', 'not OLE2'
        h = self.data[:512]
        self.sector_shift = struct.unpack('<H', h[0x1e:0x20])[0]
        self.mini_shift = struct.unpack('<H', h[0x20:0x22])[0]
        self.sector_size = 1 << self.sector_shift
        self.mini_size = 1 << self.mini_shift
        self.num_fat = struct.unpack('<I', h[0x2c:0x30])[0]
        self.dir_start = struct.unpack('<I', h[0x30:0x34])[0]
        self.mini_cutoff = struct.unpack('<I', h[0x38:0x3c])[0]
        self.minifat_start = struct.unpack('<I', h[0x3c:0x40])[0]
        self.num_minifat = struct.unpack('<I', h[0x40:0x44])[0]
        self.difat_start = struct.unpack('<I', h[0x44:0x48])[0]
        self.num_difat = struct.unpack('<I', h[0x48:0x4c])[0]
        self._load_difat(); self._load_fat()
        self.dir = self._read_chain(self.dir_start)
        self.entries = self._parse_dir()
        self.root = [e for e in self.entries if e['type'] == 5][0]
        self.ministream = self._read_chain(self.root['start'], size=self.root['size'])
        self._load_minifat()

    def _sec(self, sid):
        off = (sid + 1) << self.sector_shift
        return self.data[off:off + self.sector_size]

    def _load_difat(self):
        self.difat = list(struct.unpack('<109I', self.data[0x4c:0x4c + 436]))
        s = self.difat_start; guard = 0
        while s not in (0xfffffffe, 0xffffffff) and guard < 100000:
            sec = self._sec(s)
            self.difat.extend(struct.unpack('<%dI' % (self.sector_size // 4 - 1), sec[:self.sector_size - 4]))
            s = struct.unpack('<I', sec[self.sector_size - 4:])[0]; guard += 1

    def _load_fat(self):
        fat = b''
        for sid in self.difat[:self.num_fat]:
            if sid in (0xfffffffe, 0xffffffff):
                continue
            fat += self._sec(sid)
        self.fat = list(struct.unpack('<%dI' % (len(fat) // 4), fat))

    def _read_chain(self, start, size=None):
        out = b''; s = start; guard = 0
        while s not in (0xfffffffe, 0xffffffff) and s < len(self.fat) and guard < 10**7:
            out += self._sec(s); s = self.fat[s]; guard += 1
            if size is not None and len(out) >= size:
                break
        return out[:size] if size is not None else out

    def _parse_dir(self):
        ents = []
        for i in range(len(self.dir) // 128):
            e = self.dir[i * 128:(i + 1) * 128]
            nlen = struct.unpack('<H', e[0x40:0x42])[0]
            name = e[:max(0, nlen - 2)].decode('utf-16-le', 'replace') if nlen >= 2 else ''
            typ = e[0x42]
            if typ == 0:
                continue
            ents.append(dict(name=name, type=typ,
                             start=struct.unpack('<I', e[0x74:0x78])[0],
                             size=struct.unpack('<I', e[0x78:0x7c])[0]))
        return ents

    def _load_minifat(self):
        mf = self._read_chain(self.minifat_start) if self.minifat_start not in (0xfffffffe, 0xffffffff) else b''
        self.minifat = list(struct.unpack('<%dI' % (len(mf) // 4), mf)) if mf else []

    def _read_mini_chain(self, start, size):
        out = b''; s = start; guard = 0
        while s not in (0xfffffffe, 0xffffffff) and s < len(self.minifat) and guard < 10**7:
            off = s << self.mini_shift
            out += self.ministream[off:off + self.mini_size]
            s = self.minifat[s]; guard += 1
            if len(out) >= size:
                break
        return out[:size]

    def stream(self, name):
        for e in self.entries:
            if e['name'] == name:
                if e['size'] < self.mini_cutoff and e['type'] != 5:
                    return self._read_mini_chain(e['start'], e['size'])
                return self._read_chain(e['start'], e['size'])
        return None

    def names(self):
        return [(e['name'], e['type'], e['size']) for e in self.entries]
