"""Inspection-only extractor for the three DESeq2 .rds result tables in this capsule.

Environment constraints (verified in this sandbox):
  * no R / Rscript, no pyreadr / rpy2 installed
  * no network access (DNS + raw TCP egress both fail), so nothing can be installed
  * the .rds files are gzip-wrapped R binary serialization (XDR, big-endian,
    serialization version 3); they are read here with a small format-aware parser.

Strategy (validated, not guessed):
  1) locate the STRSXP that follows the symbol 'rownames' -> gene identifiers
  2) locate every REALSXP vector whose declared length equals the row count
     -> the numeric result columns
  3) read the DESeq2 column *description* strings to label the columns
  4) cross-check the labels numerically (baseMean >= 0, 0 <= p <= 1, padj >= p, ...)
"""
import gzip, re, struct
import pandas as pd, numpy as np

CHR_FLAGS = b'\x00\x04\x00\x09'   # CHARSXP (type 9) element header

def payload(path):
    raw = open(path, 'rb').read()
    return gzip.decompress(raw) if raw[:2] == b'\x1f\x8b' else raw

def read_strings(p, off, n):
    out = []
    for _ in range(n):
        assert p[off:off+4] == CHR_FLAGS, (off, p[off:off+4].hex())
        ln = int.from_bytes(p[off+4:off+8], 'big')
        assert 0 <= ln < 10000, (off, ln)
        out.append(p[off+8:off+8+ln].decode('utf-8', 'replace'))
        off += 8 + ln
    return out, off

def find_rownames(p):
    m = re.search(re.escape(b'rownames'), p)
    if not m:
        raise RuntimeError('rownames symbol not found')
    i = m.end()
    while i < len(p) - 8:
        if p[i:i+4] == b'\x00\x00\x00\x10':          # STRSXP header
            n = int.from_bytes(p[i+4:i+8], 'big')
            if 100 < n < 100000:
                names, end = read_strings(p, i+8, n)
                return names, i, end
        i += 1
    raise RuntimeError('no STRSXP after rownames')

def find_real_columns(p, nrow):
    hdr = b'\x00\x00\x00\x0e' + nrow.to_bytes(4, 'big')
    hits = []
    for m in re.finditer(re.escape(hdr), p):
        off = m.start()
        vals = np.array(struct.unpack_from('>%dd' % nrow, p, off+8), dtype=float)
        hits.append((off, vals))
    return hits

COLS = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']

def column_labels(p):
    labels = []
    for m in re.finditer(CHR_FLAGS, p):
        ln = int.from_bytes(p[m.start()+4:m.start()+8], 'big')
        if 5 < ln < 200:
            s = p[m.start()+8:m.start()+8+ln].decode('utf-8', 'replace')
            if ('normalized counts' in s or 'log2 fold change' in s or 'Wald' in s
                    or s.startswith('standard error') or 'adjusted p' in s):
                labels.append(s)
    return labels

def contrast(p):
    m = re.search(rb'Strain \d+ vs \d+', p)
    return m.group().decode() if m else None

def read_table(path):
    p = payload(path)
    names, rstart, rend = find_rownames(p)
    n = len(names)
    cols = find_real_columns(p, n)
    df = pd.DataFrame({name: vals for (off, vals), name in zip(cols, COLS)})
    df.index = names
    meta = dict(path=path, bytes=len(p), nrow=n, n_real_blocks=len(cols),
                labels=column_labels(p), contrast=contrast(p))
    return df, meta

if __name__ == '__main__':
    for f in ['data/res_1vs97.rds', 'data/res_1vs98.rds', 'data/res_1vs99.rds']:
        df, meta = read_table(f)
        print('='*90)
        print(f)
        print('  uncompressed payload bytes :', meta['bytes'])
        print('  rows (rownames)            :', meta['nrow'], ' unique:', df.index.nunique())
        print('  numeric REALSXP blocks     :', meta['n_real_blocks'])
        print('  columns                    :', list(df.columns))
        print('  contrast string in file    :', meta['contrast'])
        print('  DESeq2 column descriptions :')
        for s in meta['labels']:
            print('      -', s)
        print('  dtypes / NA counts / ranges:')
        for c in df.columns:
            v = df[c].to_numpy(dtype=float)
            print('     %-15s dtype=%-8s NA/NaN=%-5d min=%10.4f med=%10.4f max=%10.4f' %
                  (c, str(df[c].dtype), int(np.isnan(v).sum()), np.nanmin(v), np.nanmedian(v), np.nanmax(v)))
        print('  first index values:', list(df.index[:5]), '...', list(df.index[-3:]))
        print(df.head(3).to_string())
