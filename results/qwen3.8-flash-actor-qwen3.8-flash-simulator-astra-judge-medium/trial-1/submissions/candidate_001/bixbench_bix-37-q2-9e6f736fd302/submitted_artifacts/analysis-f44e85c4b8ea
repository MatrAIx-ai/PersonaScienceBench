"""
BixBench bix-37-q2 -- Base protein level of ENO1 in normal samples.

Read-only lookup with verification, per approved plan:
  * sheet 'Tumor vs Normal', header=0, junk columns Dropped
  * ENO1 identified by EXACT gene-symbol match (no substring matching),
    cross-checked against gene_id (Entrez 2023) and UniProt P06733
  * stored `Normal` field used AS-IS: no aggregation, no de-log, no re-normalization,
    and NOT reconstructed from Tumor/FC (those derived columns are pre-rounded)
No extra statistics / plots / normalizations.
"""
from math import floor, log10

import pandas as pd

SRC = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"


def sigfig(x: float, n: int = 3) -> float:
    """Round x to n significant figures."""
    if x == 0:
        return 0.0
    return round(x, -int(floor(log10(abs(x)))) + (n - 1))


# ---------------------------------------------------------------- load
df = pd.read_excel(SRC, sheet_name=SHEET, header=0)
junk = [c for c in ("列1", "列2") if c in df.columns]
df = df.drop(columns=junk)
print(f"[load] {SRC} :: '{SHEET}' -> {df.shape[0]} data rows x {df.shape[1]} cols "
      f"(dropped all-null {junk})")

# ------------------------------------------- (a) exact match + asserts
gene = df["gene"].astype(str).str.strip()
hit = df[gene == "ENO1"]
n = len(hit)
print(f"[match] exact gene.str.strip()=='ENO1' -> {n} row(s)")
assert n == 1, f"expected exactly 1 ENO1 row, found {n}"
row = hit.iloc[0]

assert str(row["gene_id"]).strip() == "2023", f"Entrez cross-check failed: {row['gene_id']!r}"
assert str(row["protein"]).strip() == "P06733", f"UniProt cross-check failed: {row['protein']!r}"
print(f"[cross-check] gene_id == '2023' OK ; protein == 'P06733' OK ; "
      f"gene_id type={type(row['gene_id']).__name__}")

# negative control: show what a naive substring search would have dragged in
sub = sorted(set(df.loc[gene.str.contains("ENO", na=False), "gene"]))
print(f"[control] substring 'ENO' would have matched {len(sub)} symbols: {sub}")
print(f"[control] substring-matched symbols that are NOT ENO1: "
      f"{[g for g in sub if g != 'ENO1']}")

# junk columns on the ENO1 row (confirmation only)
orig = pd.read_excel(SRC, sheet_name=SHEET, header=0)
orow = orig[orig["gene"].astype(str).str.strip() == "ENO1"].iloc[0]
print(f"[junk-cols] ENO1 row 列1={orow['列1']!r} 列2={orow['列2']!r} -> both null, no effect")

# ------------------------------------- (b) raw full-precision Normal
normal = row["Normal"]
assert pd.notna(normal), "ENO1 Normal is missing"
assert isinstance(normal, float) or pd.api.types.is_numeric_dtype(type(normal)), \
    "ENO1 Normal is not numeric"
print("\n[raw row] " + " | ".join(
    f"{k}={row[k]!r}" for k in ("protein", "gene", "gene_id", "Normal", "Tumor",
                                "Ratio", "FC", "log2FC", "p.value", "adj.Pval",
                                "is_sig", "compare")))
print(f"[raw] Normal (full stored precision) = {normal!r}")
print(f"[raw] Normal (17 sig digits)         = {normal:.17g}")
print(f"[raw] stored as dtype {df['Normal'].dtype}, linear abundance scale "
      f"(file has no units column)")

# -------------------------------------------- (c) 3 significant figures
sf3 = sigfig(float(normal), 3)
print(f"\n[sigfig] {normal:.10g} -> 3 s.f. = {sf3:g} = {sf3:.3g} = {sf3:,.0f}")

# why we do NOT reconstruct Normal from Tumor/FC (derived cols are pre-rounded)
recon = row["Tumor"] / row["FC"]
print(f"[precision] Tumor/FC (pre-rounded FC=4.81) = {recon:.10g} -> 3 s.f. = "
      f"{sigfig(float(recon), 3):,.0f}   <-- differs in the 3rd s.f.; NOT used")
print(f"[precision] stored Normal                          -> 3 s.f. = "
      f"{sf3:,.0f}   <-- used (source of record)")

import math
print(f"[scale note] log10(Normal) = {math.log10(normal):.2f} -- NOT the answer, "
      f"scale illustration only")

# --------------------------------------------------- (d) final answer
ANSWER = "7.29e7 (72,900,000)"
print("\n" + "=" * 78)
print(f"FINAL ANSWER: base protein level of ENO1 in normal samples = {ANSWER}")
print(f"  exact stored value: {normal!r}; units are UNLABELED in the source file "
      f"(linear relative-abundance / intensity scale, as stored).")
print("=" * 78)
