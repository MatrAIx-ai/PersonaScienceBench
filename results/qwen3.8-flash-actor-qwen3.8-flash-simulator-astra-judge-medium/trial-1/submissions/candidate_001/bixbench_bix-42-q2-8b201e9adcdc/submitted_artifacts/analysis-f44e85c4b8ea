"""
BixBench bix-42-q2: Skewness of RNA expression distribution (COAD).
Self-contained analysis of data/COAD__geneExp.xls (TSV despite .xls extension).

Primary answer: skewness (scipy.stats.skew, Fisher-Pearson standardized moment)
of the FLATTENED, AS-PROVIDED RAW expression matrix (all genes x all samples).
Diagnostics: per-sample skew, per-gene skew (zero-variance genes excluded),
log1p sensitivity (diagnostic only), robust summary stats, tumor-vs-normal
subset sensitivity (low-cost).
"""
import numpy as np
import pandas as pd
from scipy import stats

EXPR = "data/COAD__geneExp.xls"

def main():
    df = pd.read_csv(EXPR, sep="\t", index_col=0)
    arr = df.to_numpy(dtype=np.float64)
    n_genes, n_samples = arr.shape
    flat = arr.ravel()
    n_cells = flat.size

    print("=" * 72)
    print("RNA expression file:", EXPR)
    print(f"Shape: {n_genes} genes x {n_samples} samples ({n_cells:,} cells)")
    print(f"Missing / non-numeric cells: {int(np.isnan(arr).sum())}")
    print(f"Duplicate gene symbols: {int(df.index.duplicated().sum())} "
          f"(kept as-provided; negligible effect on flattened distribution)")

    # ---------------- robust summary of raw distribution ----------------
    print("\n--- Raw (as-provided) expression distribution: summary ---")
    qs = np.percentile(flat, [50, 90, 99])
    print(f"min={flat.min():.4f}  max={flat.max():.4f}")
    print(f"mean={flat.mean():.4f}  median={np.median(flat):.4f}  "
          f"(mean/median ratio = {flat.mean()/max(np.median(flat),1e-12):.2f})")
    print(f"p50={qs[0]:.4f}  p90={qs[1]:.4f}  p99={qs[2]:.4f}  max={flat.max():.4f}")
    print(f"zero fraction: {(flat == 0).mean()*100:.2f}% "
          f"({int((flat == 0).sum()):,} of {n_cells:,} cells)")

    # ---------------- PRIMARY: flattened raw-scale skew ----------------
    skew_flat = stats.skew(flat)                      # bias-corrected (default)
    k2, pval = stats.skewtest(flat)
    print("\n=== PRIMARY ANSWER (as-provided RAW scale) ===")
    print(f"Flattened skewness (scipy.stats.skew, raw values, "
          f"all {n_cells:,} cells) = {skew_flat:.3f}")
    print(f"D'Agostino-Pearson normality test p-value = {pval:.3e} "
          f"(distribution is definitively NOT normal)")
    print(f"Interpretation: mean >> median, long heavy right tail, "
          f"p99/max >> p50 => HIGHLY RIGHT-SKEWED on the raw scale.")

    # ---------------- per-sample skew distribution ----------------
    ss = stats.skew(arr, axis=0)                      # across genes, per sample
    print("\n--- Diagnostics: per-sample skew (across genes, raw values) ---")
    print(f"median={np.median(ss):.2f}  Q1={np.percentile(ss,25):.2f}  "
          f"Q3={np.percentile(ss,75):.2f}  min={ss.min():.2f}  max={ss.max():.2f}")
    print(f"fraction of samples with skew > 0:  {(ss > 0).mean()*100:.1f}%   "
          f"(> +2, 'highly right-skewed'): {(ss > 2).mean()*100:.1f}%")

    # ---------------- per-gene skew (exclude zero-variance genes) ----------------
    gene_sd = arr.std(axis=1)
    keep = gene_sd > 0
    gs = stats.skew(arr[keep], axis=1)
    print("\n--- Diagnostics: per-gene skew (across samples, raw values) ---")
    print(f"genes analyzed: {int(keep.sum())} "
          f"(excluded {int((~keep).sum())} zero-variance genes)")
    print(f"median={np.median(gs):.2f}  Q1={np.percentile(gs,25):.2f}  "
          f"Q3={np.percentile(gs,75):.2f}  min={gs.min():.2f}  max={gs.max():.2f}")
    print(f"fraction of genes with skew > 0: {(gs > 0).mean()*100:.1f}%   "
          f"(> +2): {(gs > 2).mean()*100:.1f}%")

    # ---------------- log1p sensitivity (DIAGNOSTIC ONLY) ----------------
    skew_log = stats.skew(np.log1p(flat))
    print("\n--- Sensitivity (DIAGNOSTIC ONLY, not the answer): log1p scale ---")
    print(f"Flattened skewness of log1p(expression) = {skew_log:.3f} "
          f"(approximately symmetric after log transform)")

    # ---------------- optional low-cost tumor vs normal sensitivity ----------------
    print("\n--- Optional sensitivity: tumor vs normal subsets (raw scale) ---")
    codes = np.array([c.split("-")[3] for c in df.columns])
    tumor_cols = np.isin(codes, ["01A", "01B"])
    normal_cols = codes == "11A"
    for name, mask in [("Tumor samples", tumor_cols), ("Normal samples", normal_cols)]:
        if mask.sum() > 0:
            s = stats.skew(arr[:, mask].ravel())
            print(f"{name}: n={int(mask.sum())}  flattened skew = {s:.3f}")

    print("\nFINAL ANSWER: HIGHLY RIGHT-SKEWED "
          f"(raw flattened skewness = {skew_flat:.1f}).")

if __name__ == "__main__":
    main()
