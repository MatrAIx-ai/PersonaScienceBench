"""
BixBench bix-43-q1 — CBD/cisplatin combination vs DMSO control: DE + ranked gene list.
Pipeline: ENSG->symbol (sum-collapse, drop unmapped) -> filter count>=10 in >=3 of the
6 relevant samples -> DESeq2-style NB GLM: median-of-ratios size factors stabilized on
ALL 30 samples (per researcher), vectorized Newton-IRLS MLE, MoM dispersions + quadratic
mean-dispersion trend + COX-like shrinkage, Wald test, BH padj.
Ranking metric = sign(log2FC) * -log10(pvalue).
DISCLOSED BLOCKER: gseapy prerank on GO_Biological_Process_2021 could NOT be executed
in this environment (no network, gseapy not installable, no local GO GMT). No enrichment
results are fabricated; deliverables here are the DE table and ranked list.
"""
import numpy as np, pandas as pd
from scipy.special import gammaln
from scipy import stats as sps

DATA, OUT = "/workspace/data", "/workspace/out"
counts = pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv(f"{DATA}/sample_layout.csv")
layout["col"] = layout.SampleID.str.replace("-", "_", regex=False)
mapping = pd.read_csv(f"{DATA}/ensg_to_gene_name.tsv", sep="\t")
assert set(layout["col"]) == set(counts.columns)
grp = layout.set_index("col")["Group"]
TREAT = [c for c in counts.columns if grp[c] == "Cisplatin_IC50_CBD_IC50"]
CTRL  = [c for c in counts.columns if grp[c] == "DMSO"]
REL = TREAT + CTRL
print("treatment (combination):", TREAT, "| control:", CTRL)

cnt = counts.copy()
cnt["symbol"] = mapping.set_index("ENSG")["gene_name"].reindex(cnt.index).values
n_unmapped = int(cnt["symbol"].isna().sum())
sym = cnt.dropna(subset=["symbol"]).groupby("symbol").sum()
sym = sym[(sym[REL] >= 10).sum(axis=1) >= 3]
print(f"unmapped ENSG dropped: {n_unmapped}; symbols after collapse: {len(cnt.dropna(subset=['symbol']).groupby('symbol').sum())}; after filter: {len(sym)}")

allpos = sym[(sym > 0).all(axis=1)]
sf_full = (allpos.div(np.exp(np.log(allpos).mean(axis=1)), axis=0)).median(axis=0)
print(f"size factors from {len(allpos)} genes positive in all 30 samples; relevant sf: "
      f"{sf_full[REL].round(3).to_dict()}")

Y = sym[REL].values.astype(float)                 # G x 6
X = np.column_stack([np.ones(6), np.array([1.,1,1,0,0,0])])   # col1 = combination indicator
lsf = np.log(sf_full[REL].values)                 # offsets
G = Y.shape[0]

def irls(a):
    """Vectorized Newton-IRLS for NB2 log-link GLM, per-gene dispersion a (G,) or scalar."""
    a = np.full(G, a, float) if np.isscalar(a) else np.asarray(a, float)
    ysum = Y.sum(axis=1)
    b = np.column_stack([np.log(np.maximum(ysum/np.exp(lsf).sum(), 1e-3)), np.zeros(G)])
    for _ in range(50):
        eta = b @ X.T + lsf
        mu = np.exp(np.clip(eta, -25, 25))
        w = mu / (1 + a[:, None] * mu)            # (dmu/deta)^2 / Var
        u = (b @ X.T) + (Y - mu) / np.maximum(mu, 1e-12)
        GW = X[None] * w[:, :, None]              # G x 6 x 2
        A = np.einsum("gti,tj->gij", GW, X) + 1e-9*np.eye(2)[None]
        r = np.einsum("gti,gt->gi", GW, u)
        b_new = np.clip(np.linalg.solve(A, r[..., None])[..., 0], [-15, -12], [15, 12])
        if np.max(np.abs(b_new - b)) < 1e-8:
            b = b_new; break
        b = 0.5*b + 0.5*b_new                     # damping for stability
    return b

# 1) gene-wise betas at provisional dispersion
b0 = irls(0.05)
mu0 = np.exp(np.clip(b0 @ X.T + lsf, -25, 25))

# 2) MoM dispersions
alpha = ((Y-mu0)**2 - mu0).sum(axis=1) / np.maximum((mu0**2).sum(axis=1), 1e-12)
alpha = np.clip(alpha, 1e-8, 50)

# 3) quadratic mean-dispersion trend + shrinkage (DESeq2-style)
gm = np.exp(np.log(np.maximum(Y, 1e-8)).mean(axis=1))
fit = (alpha < 49) & (alpha > 1e-6) & (gm > 1)
lx, ly = np.log(gm[fit]), np.log(alpha[fit])
Afit = np.column_stack([np.ones(fit.sum()), lx, lx**2])
c = np.linalg.lstsq(Afit, ly, rcond=None)[0]
lt = np.log(np.maximum(gm, 1e-8))
trend = np.clip(np.exp(c[0] + c[1]*lt + c[2]*lt**2), 1e-8, 50)
lr = np.log(alpha/trend)
mad = max(np.median(np.abs(lr - np.median(lr))), 1e-2)
pv_ = (np.pi**2)/6/(np.sqrt(3)*mad)**2 + 0.5
disp = np.clip(trend*np.exp((pv_/(pv_+np.pi**2/6))*lr), 1e-8, 50)
print(f"dispersion medians: MoM={np.median(alpha):.4f}  trend={np.median(trend):.4f}  shrunk={np.median(disp):.4f}")

# 4) final MLE + Wald with shrunk dispersions
b = irls(disp)
mu = np.exp(np.clip(b @ X.T + lsf, -25, 25))
w = mu / (1 + disp[:, None]*mu)
GW = X[None] * w[:, :, None]
I = np.einsum("gti,tj->gij", GW, X)
covb = np.linalg.inv(I + 1e-9*np.eye(2)[None])
se = np.sqrt(np.clip(covb[:, 1, 1], 1e-12, None))
beta = b[:, 1]
z = beta / se
p = 2 * sps.norm.sf(np.abs(z))

res = pd.DataFrame({"baseMean": mu.mean(axis=1), "log2FC": beta/np.log(2),
                    "se": se/np.log(2), "stat": z, "pvalue": p}, index=sym.index)
res.index.name = "gene_symbol"
pvv = res["pvalue"].clip(lower=1e-300).values
o = np.argsort(pvv); bh = np.empty(G)
bh[o] = np.minimum.accumulate((pvv[o]*G/np.arange(1, G+1))[::-1])[::-1]
res["padj"] = np.clip(bh, 0, 1)
res["rank_metric"] = np.sign(res["log2FC"])*(-np.log10(pvv))
res = res.sort_values("rank_metric", ascending=False)
res.to_csv(f"{OUT}/de_combination_vs_dmso.csv")
res[["log2FC", "pvalue", "rank_metric"]].to_csv(f"{OUT}/ranked_gene_list.csv")

print("\nTop 15 UP in combination:")
print(res.head(15)[["baseMean","log2FC","stat","pvalue","padj"]].round(4).to_string())
print("\nTop 15 DOWN in combination:")
print(res.tail(15)[["baseMean","log2FC","stat","pvalue","padj"]].round(4).to_string())
sig = (res["padj"] < 0.05) & (res["log2FC"].abs() > 1)
print(f"\nDE (padj<0.05, |log2FC|>1): up={int((res.loc[sig,'log2FC']>0).sum())}, "
      f"down={int((res.loc[sig,'log2FC']<0).sum())}, total={int(sig.sum())} / {G}")
print("sanity MKI67:", res.loc["MKI67", ["log2FC","pvalue","padj"]].round(4).to_dict() if "MKI67" in res.index else "filtered")
