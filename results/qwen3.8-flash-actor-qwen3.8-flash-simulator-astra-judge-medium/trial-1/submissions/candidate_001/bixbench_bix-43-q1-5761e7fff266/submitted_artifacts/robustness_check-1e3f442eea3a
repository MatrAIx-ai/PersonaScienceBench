"""Robustness of top ranked-list signal across 3 ranking variants (bix-43-q1).
Variants: (1) original sign(log2FC)*-log10(p); (2) log2FC-only; (3) -log10(p) capped at 16.
Hand-curated marker sets (NOT GO files - no GO source available offline) used as diagnostics
to decide which biological program dominates each tail, and to test stability."""
import numpy as np, pandas as pd
de = pd.read_csv("out/de_combination_vs_dmso.csv", index_col=0)
de = de[de.baseMean >= 5]
capped = np.sign(de.log2FC)*np.minimum(-np.log10(de.pvalue.clip(lower=1e-300)), 16)
rank_fc = de.log2FC.rank(pct=True); rank_cap = capped.rank(pct=True)
sets = {
 "p53/DNA-damage": "GDA CDKN1A BTG2 AEN MDM2 GADD45A TP53I3 TP53I11 RPS27L SESN1 SESN2 FAS TNFRSF10B BBC3 ZMAT3 TRIAP1 DDB2 XPC POLH TIGAR GDF15 PLK3 RRAGD EDA2R TP53INP1 PHLDA3 ACER2 CCNG1 FDXR GLS2 TP53AIP1 MUL1 NISCH ATF3 ERCC5 CASP3 APAF1 PMAIP1 TNFRSF10A ISCU PADI2 SLC19A2".split(),
 "HR/DNA-repair": "RAD51 RAD51C BRCA1 BRCA2 FANCA FANCD2 ERCC1 ERCC5 XPA XPC DDB1 DDB2 PARP1 XRCC1 CHEK1 CHEK2 ATM ATR MRE11 RAD50 NBN BLM TOPBP1".split(),
 "cell-cycle/E2F": "MKI67 CCNE1 CCNA2 CCNB1 CDK1 CDK2 MCM2 MCM7 PCNA E2F1 TYMS RRM2 AURKA PLK1 BUB1 TOP2A FOXM1 MYBL2 CDC20 CDC6 TK1 UBE2C KIF11".split(),
 "AP-1/IEG": "FOS FOSB FOSL1 FOSL2 JUN JUNB JUND EGR1 EGR2 EGR3 ATF3 IER2 IER3 DUSP1 KLF4 NR4A1".split(),
 "HIF/glycolysis": "HK1 HK2 GPI PFKL PFKM PFKP ALDOA ALDOC TPI1 GAPDH PGK1 PGAM1 ENO1 ENO2 PKM LDHA SLC2A1 PDK1 VEGFA CA9 BNIP3 ADM EGLN3 P4HA1 P4HA2 KDM3A SLC16A3".split(),
 "cholesterol/SREBP": "HMGCR HMGCS1 SQLE INSIG1 LDLR FDFT1 IDI1 MVD MSMO1 DHCR7 FDPS LSS CYP51A1 ACAT2 FASN SCD ACACA".split(),
}
for nm, g in sets.items():
    g = [x for x in dict.fromkeys(g) if x in de.index]
    print(f"{nm:18s} n={len(g):3d}  pctile orig={de.loc[g,'rank_metric'].mean():+7.2f}(mean) | "
          f"medFC={rank_fc[g].median():.3f} medCap={rank_cap[g].median():.3f}")
print("top-300 overlap orig-vs-capped:",
      len(set(de.rank_metric.nlargest(300).index) & set(capped.nlargest(300).index)))
