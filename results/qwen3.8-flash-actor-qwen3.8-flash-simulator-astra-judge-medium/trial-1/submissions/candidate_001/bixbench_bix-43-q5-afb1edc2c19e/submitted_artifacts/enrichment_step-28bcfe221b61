"""Step 2: Reactome_2022 enrichment of the combined DEG list with the gseapy-equivalent ORA.

Order of attempts (no gene-set content is ever invented):
  1. real gseapy (`import gseapy` -> gp.Enrich) with a Reactome_2022 gene-set library
  2. offline gseapy-equivalent ORA (analysis/ora.py, verified identical to scipy fisher_exact)
     with a Reactome_2022 GMT found on disk or supplied via $REACTOME_GMT
  3. otherwise: STOP with an explicit status report - Reactome_2022 content must not be
     reconstructed from memory (per the approved protocol).
"""
import sys, os, glob, json, subprocess
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np, pandas as pd
from ora import enrich, load_gmt

PRIMARY = 'combo9_vs_Untreated'
SECOND = ['combo9_vs_DMSO', 'combo9_vs_Cis', 'combo9_vs_CBD', 'combo10_vs_DMSO_SS']
OUT = 'results'


def find_gmt():
    cands = []
    for var in ('REACTOME_GMT', 'GSEAPY_GMT', 'GENESETS_GMT'):
        if os.environ.get(var):
            cands.append(os.environ[var])
    pats = ['data/*.gmt', 'data/*/*.gmt', '*.gmt', 'gene_sets/*.gmt', '/opt/*gmt*',
            '/opt/*/*gmt*', os.path.expanduser('~/gene_sets/*.gmt'), 'resources/*.gmt']
    for p in pats:
        cands += glob.glob(p)
    try:                                     # last resort filesystem sweep
        r = subprocess.run(['find', '/', '-xdev', '-iname', '*reactome*', '-o', '-xdev', '-iname', '*.gmt'],
                           capture_output=True, text=True, timeout=120)
        cands += [l for l in r.stdout.splitlines() if l.strip()]
    except Exception as e:
        print('filesystem sweep failed:', e)
    cands = [c for c in dict.fromkeys(cands) if os.path.isfile(c)]
    for c in cands:
        try:
            sets = load_gmt(c)
            if any('reactome' in k.lower() for k in sets) or len(sets) > 300:
                return c, sets
        except Exception:
            continue
    return (cands[0], load_gmt(cands[0])) if cands else (None, None)


def try_gseapy():
    try:
        import gseapy                                            # noqa
        return gseapy.__version__
    except Exception as e:
        return None


status = dict(gseapy_version=try_gseapy())
gmt_path, sets = find_gmt()
status['gmt_candidates_found'] = int(bool(gmt_path))
status['gmt_path'] = gmt_path
print('gseapy:', status['gseapy_version'], '| GMT:', gmt_path, flush=True)

if sets is None:
    status['outcome'] = 'ENRICHMENT_NOT_RUNNABLE: no Reactome_2022 gene-set library available offline'
    status['note'] = ('Reactome_2022 content is not reconstructible offline; per protocol it was NOT '
                      'fabricated. Re-run this script after exporting $REACTOME_GMT (Reactome_2022.gmt) '
                      'or installing gseapy with network access. DEG tables are ready.')
    json.dump(status, open(f'{OUT}/enrichment_STATUS.json', 'w'), indent=1)
    open(f'{OUT}/enrichment_STATUS.txt', 'w').write(json.dumps(status, indent=1))
    print(status['outcome'])
    sys.exit(3)

# ---- if we get here a real library exists: run ORA for every contrast, both backgrounds ----
lib_name = 'Reactome_2022' if 'reactome' in (gmt_path or '').lower() else os.path.basename(str(gmt_path))
universe = pd.read_csv(f'{OUT}/de_results_{PRIMARY}.csv.gz').fillna({'symbol':''})
expr_bg = sorted(set(universe.loc[(universe.baseMean > 10) & (universe.symbol != ''), 'symbol']))
rows = []
for name in [PRIMARY] + SECOND:
    syms = [l.strip() for l in open(f'{OUT}/DEG_{name}_symbols.txt') if l.strip()]
    for bgl, bg in [('gseapy_default_library', None), ('expressed_universe', expr_bg)]:
        df = enrich(syms, sets, background=bg, min_size=5, max_size=500, library_name=lib_name)
        df.insert(0, 'Contrast', name); df.insert(1, 'Background', bgl)
        df.to_csv(f'{OUT}/enrich_{name}_{bgl}.csv', index=False)
        top = df.head(15)[['Term', 'Terms', 'P_value', 'Adjusted P-value']]
        print(f'\n### {name} | {bgl} | query={len(syms)} top terms'); print(top.to_string(index=False))
        rows.append(dict(contrast=name, background=bgl, top=df['Term'].head(5).tolist()))
status['outcome'] = 'ok'; status['top'] = rows
json.dump(status, open(f'{OUT}/enrichment_STATUS.json', 'w'), indent=1)
