"""Stop-gap diagnostic (clearly NOT the requested Reactome analysis):
  (a) hypergeometric ORA (same validated machinery as the gseapy-equivalent) of the combined DEG
      list against hand-listed marker panels, background = expressed universe (baseMean>10).
  (b) directional battery summary: mean log2FC and #DEG inside each panel, per contrast.
  (c) combination-specificity: overlap with single-agent DEG sets.
"""
import sys, os, json
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np, pandas as pd
from ora import enrich
from panels import PANELS

OUT = 'results'
CONTR = ['combo9_vs_Untreated', 'combo9_vs_DMSO', 'combo9_vs_Cis', 'combo9_vs_CBD',
         'Cis_vs_Untreated', 'CBD_vs_Untreated', 'Cis_vs_DMSO', 'CBD_vs_DMSO',
         'combo10_vs_DMSO_SS']
tab = pd.read_csv(f'{OUT}/de_results_combo9_vs_Untreated.csv.gz').fillna({'symbol':''})
bg = sorted(set(tab.loc[(tab.baseMean > 10) & (tab.symbol != ''), 'symbol']))
print('expressed background size (baseMean>10, symbol):', len(bg))

deg_syms = {}
for c in CONTR:
    deg_syms[c] = set(l.strip() for l in open(f'{OUT}/DEG_{c}_symbols.txt') if l.strip())

# (c) combination specificity
spec = {}
for c in ['combo9_vs_Untreated', 'combo9_vs_DMSO']:
    cis = deg_syms['Cis_vs_Untreated' if 'Untreated' in c else 'Cis_vs_DMSO']
    cbd = deg_syms['CBD_vs_Untreated' if 'Untreated' in c else 'CBD_vs_DMSO']
    d = deg_syms[c]
    spec[c] = dict(combo_DEG=len(d), cis_DEG=len(cis), cbd_DEG=len(cbd),
                   combo_and_cis=len(d & cis), combo_and_cbd=len(d & cbd),
                   combo_only_not_either_single=len(d - cis - cbd),
                   jaccard_cis=len(d & cis) / len(d | cis), jaccard_cbd=len(d & cbd) / len(d | cbd),
                   overlap_untreated_vs_DMSO_lists=len(deg_syms['combo9_vs_Untreated'] & deg_syms['combo9_vs_DMSO']))
json.dump(spec, open(f'{OUT}/combo_specificity.json', 'w'), indent=1)
print(json.dumps(spec, indent=1))

# (a) ORA vs panels
rows = []
for c in CONTR:
    df = enrich(sorted(deg_syms[c]), PANELS, background=bg, min_size=5, max_size=500,
                library_name='hand_listed_marker_panels_NOT_REACTOME')
    if len(df):
        df.insert(0, 'Contrast', c); rows.append(df)
ora = pd.concat(rows) if rows else pd.DataFrame()
ora.to_csv(f'{OUT}/marker_panel_ORA.csv', index=False)
print('\n--- marker-panel ORA (NOT Reactome) : best panel per contrast ---')
print(ora.sort_values(['Contrast', 'P_value']).groupby('Contrast').head(2)[
    ['Contrast', 'Term', 'Terms', 'Overlap', 'Set_size', 'P_value', 'Adjusted P-value']].to_string(index=False))

# (b) directional battery summary
print('\n--- directional battery summary (mean log2FC of panel genes; DEG count / panel size) ---')
lines = []
for c in CONTR:
    t = pd.read_csv(f'{OUT}/de_results_{c}.csv.gz').fillna({'symbol':''})
    t = t[(t.baseMean > 10) & (t.symbol != '')]
    out = {}
    for pname, gl in PANELS.items():
        s = t[t.symbol.isin(set(gl))]
        if len(s) == 0:
            continue
        isdeg = (s.log2FoldChange.abs() > 0.5) & (s.pvalue < 0.05)
        out[pname] = dict(n=len(s), mean_lfc=round(float(s.log2FoldChange.mean()), 3),
                          n_DEG=int(isdeg.sum()), frac_DEG=round(float(isdeg.mean()), 2),
                          n_up=int(((s.log2FoldChange > 0.5) & (s.pvalue < 0.05)).sum()),
                          n_down=int(((s.log2FoldChange < -0.5) & (s.pvalue < 0.05)).sum()))
    d = pd.DataFrame(out).T
    d = d.sort_values('mean_lfc')
    lines.append(f'\n### {c}  (query DEG symbols: {len(deg_syms[c])})')
    lines.append(d.to_string())
    with open(f'{OUT}/battery_{c}.txt', 'w') as fh:
        fh.write(d.to_string())
open(f'{OUT}/battery_all_contrasts.txt', 'w').write('\n'.join(lines))
print('\n'.join(lines[:8]))
