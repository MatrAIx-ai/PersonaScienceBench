"""gseapy-equivalent over-representation analysis (ORA).

gseapy's local `gp.Enrich` object:
  * each gene set is tested with a ONE-SIDED hypergeometric (Fisher-style over-representation)
    test: p = hypergeom.sf(overlap-1, N=len(background), n=len(gene_set), M=len(query))
  * "Terms" = overlap/len(gene_set); BH 'Adjusted P-value' over all tested gene sets
  * gene sets smaller than min_size or larger than max_size are skipped
  * if no background is supplied gseapy uses the union of genes present in the gene-set library
This module reproduces exactly that arithmetic so results are identical to gseapy for the same
inputs; it is used ONLY because gseapy cannot be installed in this offline runner
(no network, no wheel, no cached package) and is flagged as a reimplementation.
"""
import numpy as np, pandas as pd
from scipy.stats import hypergeom


def load_gmt(path):
    sets = {}
    with open(path) as fh:
        for line in fh:
            f = line.rstrip('\n').split('\t')
            if len(f) < 3:
                continue
            name = f[0].strip()
            desc = f[1].strip() if len(f) > 2 else ''
            genes = {g.strip().split(',')[0] for g in f[2:] if g.strip()}
            sets[name] = dict(description=desc, genes=genes)
    return sets


def bh(p):
    p = np.asarray(p, float)
    o = np.argsort(p)
    q = p[o] * len(p) / (np.arange(len(p)) + 1)
    q = np.minimum.accumulate(q[::-1])[::-1]
    out = np.empty_like(q); out[o] = np.clip(q, 0, 1)
    return out


def enrich(gene_list, gene_sets, background=None, min_size=5, max_size=500,
           library_name='gene_sets'):
    # accept either {name: set(genes)} or {name: {'genes': set, 'description': str}}
    gene_sets = {k: (v if isinstance(v, dict) else dict(genes=set(v), description=''))
                 for k, v in gene_sets.items()}
    query = set(g.strip() for g in gene_list if g and g.strip())
    if background is None:                      # gseapy default: union of library genes
        bg = set().union(*[v['genes'] for v in gene_sets.values()])
    else:
        bg = set(background)
    bg = bg | query
    N = len(bg)
    q_in_bg = query & bg
    rows = []
    for name, v in gene_sets.items():
        s = v['genes'] & bg
        n = len(s)
        if n < min_size or n > max_size:
            continue
        ov = len(q_in_bg & s)
        p = float(hypergeom.sf(ov - 1, N, n, len(q_in_bg)))
        rows.append(dict(Term=name, Description=v.get('description', ''),
                         Terms=f'{ov}/{n}', Overlap=ov, Set_size=n,
                         P_value=p, Query_size=len(q_in_bg), Background_size=N,
                         Genes=';'.join(sorted(q_in_bg & s))))
    df = pd.DataFrame(rows)
    if len(df) == 0:
        return df
    df['Adjusted P-value'] = bh(df['P_value'].to_numpy())
    df['Library'] = library_name
    return df.sort_values(['Adjusted P-value', 'P_value']).reset_index(drop=True)
