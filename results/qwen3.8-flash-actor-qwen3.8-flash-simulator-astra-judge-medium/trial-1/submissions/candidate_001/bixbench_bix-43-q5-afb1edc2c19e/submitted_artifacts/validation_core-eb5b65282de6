import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np, deseq_np as D
from scipy.optimize import minimize_scalar
from scipy.stats import nbinom
rng = np.random.default_rng(0)
g, n = 500, 30
mu = np.exp(rng.uniform(1, 8, (g, 1))) * np.ones((1, n))
alpha = np.exp(rng.uniform(-6, 0, g))
p = 1.0 / (1 + alpha[:, None] * mu)
y = rng.negative_binomial(1.0 / alpha[:, None], p, size=(g, n)).astype(float)

# 1) loglik formula vs scipy.stats.nbinom
size = 1.0 / alpha
scipy_ll = nbinom.logpmf(y, size[:, None], p).sum(axis=1)
mine_ll = D.nb_loglik_alpha(y, mu, alpha)
print('loglik max abs diff vs scipy.nbinom: %.3e' % np.abs(scipy_ll - mine_ll).max())

# 2) analytic score vs finite difference
h = 1e-5
fd = (D.nb_loglik_alpha(y, mu, alpha + h) - D.nb_loglik_alpha(y, mu, alpha - h)) / (2 * h)
an = D.nb_score_alpha(y, mu, alpha)
print('score max rel err vs FD: %.3e' % np.nanmax(np.abs(fd - an) / np.maximum(np.abs(fd), 1e-8)))

# 3) MLE alpha vs scipy bounded scalar optimiser (30 genes)
mine = D.mle_alpha(y, mu, D.mom_alpha(y, mu))
bad = 0
for i in range(30):
    def nll(la, i=i):
        return -float(D.nb_loglik_alpha(y[i:i + 1], mu[i:i + 1], np.exp(la))[0])
    r = minimize_scalar(nll, bounds=(-15, 4), method='bounded', options={'xatol': 1e-9})
    if abs(np.log(mine[i]) - r.x) > 0.02 * max(1.0, abs(r.x)):
        bad += 1
print('MLE mismatches vs scipy: %d/30 | mean alpha true %.4f, MoM %.4f, MLE %.4f'
      % (bad, alpha.mean(), D.mom_alpha(y, mu).mean(), mine.mean()))

# 4) Wald test vs statsmodels NB GLM (fixed alpha), two-group contrast
import statsmodels.api as sm
groups = np.array([0]*15 + [1]*15)
sf = np.exp(rng.normal(0, 0.4, n))
y2 = rng.negative_binomial(1.0 / alpha[:, None], 1.0/(1.0 + alpha[:, None] * (mu * sf[None, :])), size=(g, n)).astype(float)
bidx = np.array([0]*15 + [1]*15)
beta, mu_fit = D.group_beta_means(y2.astype(int), sf, bidx)
grid_x, grid_y = D.dispersion_trend(mine, (y2/sf).mean(1))
a_shr, lt = D.shrink_alpha(y2, mu_fit, mine, grid_x, grid_y, (y2/sf).mean(1))
res = D.wald_contrast(y2, mu_fit, a_shr, bidx, {1: 1.0, 0: -1.0}, beta)
mm = np.argsort(-res['pvalue'])[:5]
for i in mm:
    X = np.column_stack([np.ones(n), (bidx == 1).astype(float)])
    fit = sm.GLM(y2[i], X, family=sm.families.NegativeBinomial(alpha=float(a_shr[i]))).fit()
    # statsmodels uses log link by default for NB? verify coefficients
    myb = beta[i]
    print('gene%3d  sm beta_int %.4f beta_g1 %.4f | my b0 %.4f b1 %.4f | sm lfc %.4f my lfc %.4f | sm se %.4f my se %.4f | sm p %.3g my p %.3g'
          % (i, fit.params[0], fit.params[1], myb[0], myb[1], fit.params[1], res['log2FoldChange'][i],
             fit.bse[1], res['lfcSE'][i]*np.log(2), fit.pvalues[1], res['pvalue'][i]))
