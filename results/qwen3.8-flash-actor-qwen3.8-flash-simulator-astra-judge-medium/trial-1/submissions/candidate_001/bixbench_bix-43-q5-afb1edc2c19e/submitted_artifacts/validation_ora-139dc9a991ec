"""Validate the ORA reimplementation: (1) hypergeometric p vs scipy fisher_exact,
(2) planted-signal recovery on synthetic data."""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np, pandas as pd
from scipy.stats import fisher_exact
from ora import enrich, bh

rng = np.random.default_rng(1)
universe = [f'G{i}' for i in range(10000)]
sets = {f'SET{i}': set(rng.choice(universe, size=rng.integers(40, 160), replace=False)) for i in range(40)}
sets['HIT_A'] = set(rng.choice(universe, size=60, replace=False))
sets['HIT_B'] = set(rng.choice(universe, size=120, replace=False))
planted = (sets['HIT_A'] | sets['HIT_B']) | set(rng.choice(universe, size=30, replace=False))
res = enrich(sorted(planted), sets, background=universe, min_size=5, max_size=500)
print('top 5 rows of planted-signal test:')
print(res[['Term', 'Terms', 'P_value', 'Adjusted P-value']].head(5).to_string(index=False))
# cross-check hypergeom against fisher_exact for 6 sets
for t in res['Term'].head(3).tolist() + list(sets)[:3]:
    s = sets[t] & set(universe); ov = len(planted & s)
    N = len(universe); q = len(planted)
    tab = [[ov, len(s) - ov], [q - ov, N - len(s) - (q - ov)]]
    fp = fisher_exact(tab, alternative='greater')[1]
    hp = float(res.loc[res.Term == t, 'P_value'].iloc[0]) if (res.Term == t).any() else np.nan
    print(f'{t}: overlap {ov} set {len(s)}  hypergeom {hp:.4g}  fisher_exact {fp:.4g}  match={np.isclose(hp, fp, rtol=1e-10)}')
print('\nBH check: manual vs module ->', np.allclose(bh(res["P_value"].to_numpy()), res["Adjusted P-value"].to_numpy()))
print('library-default-background mode (background=None) rows:', len(enrich(sorted(planted), sets)))
