"""Independent validation of the closed-form group-mean betas / Fisher-information SE / Wald p:
re-fit each gene with a SEPARATELY written NB likelihood (scipy.stats.nbinom.logpmf) and a
generic optimiser + numerical Hessian, on REAL data (combo group 9 vs Untreated)."""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np, pandas as pd, deseq_np as D
from scipy.stats import nbinom, norm
from scipy.optimize import minimize

cnt, labels, mapdf = None, None, None
from common import load_all
cnt, labels, mapdf = load_all()
labels = np.array(labels)
X = cnt.values.astype(np.int64)
A, B = 'Cisplatin_IC50_CBD_IC50', 'Untreated'
mA, mB = labels == A, labels == B
sub = X[:, mA | mB]
sf_all = D.size_factors(X)
sf = sf_all[mA | mB]
y = sub[sub.sum(1) > 0].astype(float)
bidx = np.concatenate([np.ones(mA.sum(), int), np.zeros(mB.sum(), int)])
beta, mu = D.group_beta_means(sub[sub.sum(1) > 0], sf, bidx)
alpha = D.mle_alpha(y, mu, D.mom_alpha(y, mu))
res = D.wald_contrast(y, mu, alpha, bidx, {1: 1.0, 0: -1.0}, beta)
nsamp = y.shape[1]


def nll(par, yi):
    xb = np.where(bidx == 1, par[0] + par[1], par[0])
    b = sf * np.exp(xb)
    a = np.exp(par[2])
    return -nbinom.logpmf(yi, 1.0 / a, 1.0 / (1.0 + a * b)).sum()


order = np.argsort(res['pvalue'])[:10]
ens = cnt.index.to_numpy()[sub.sum(1) > 0]
rows = []
for i in order:
    f = lambda p: nll(p, y[i])
    r = minimize(f, x0=[np.log(max(y[i].mean(), 1.0)), 0.0, np.log(max(alpha[i], 1e-4))],
                 method='Nelder-Mead', options={'xatol': 1e-9, 'fatol': 1e-9, 'maxfev': 40000})
    h = 1e-4
    H = np.zeros((3, 3))
    for a_ in range(3):
        for b_ in range(3):
            ea = np.zeros(3); ea[a_] = h
            eb = np.zeros(3); eb[b_] = h
            H[a_, b_] = (f(r.x + ea + eb) - f(r.x + ea - eb) - f(r.x - ea + eb) + f(r.x - ea - eb)) / (4 * h * h)
    se = np.sqrt(np.linalg.inv(H)[1, 1])
    indep_lfc = r.x[1] / np.log(2); indep_p = 2 * norm.sf(abs(r.x[1] / se))
    rows.append((ens[i], res['log2FoldChange'][i], indep_lfc, res['lfcSE'][i], se / np.log(2),
                 res['pvalue'][i], indep_p, alpha[i], np.exp(r.x[2])))
    print('%-16s lfc  mine %+0.4f indep %+0.4f | se mine %.4f indep %.4f | p mine %.2e indep %.2e | alpha mine %.4f indep %.4f'
          % rows[-1], flush=True)
arr = np.array([[r[1], r[2], r[3], r[4], np.log10(max(r[5], 1e-300)), np.log10(max(r[6], 1e-300))] for r in rows])
print('\nmax |dlfc| = %.2e ; max |dSE| = %.2e ; max |d log10 p| = %.3f'
      % (np.abs(arr[:, 0] - arr[:, 1]).max(), np.abs(arr[:, 2] - arr[:, 3]).max(),
         np.abs(arr[:, 4] - arr[:, 5]).max()))
