#!/usr/bin/env python3
"""
BixBench bix-46-q1
Question: log2 fold change (rounded to 2 dp) for mexG expression in
          Delta-rhlI (strain #97) compared to wt (strain #1).

Inputs
  data/res_1vs97.rds  DESeq2 results object, column metadata reads
                      "log2 fold change (MLE): Strain 97 vs 1"  -> MAIN/ANSWER FILE
  data/res_1vs98.rds  DESeq2 results object, "Strain 98 vs 1"   -> SANITY CHECK ONLY
  data/Pseudomonas_aeruginosa_UCBPP-PA14.csv  PA14 gene table (Gene Name -> Locus Tag)

Runtime constraints (verified in this runner): no R, no rpy2/pyreadr, no network,
so the RDS byte stream is decoded by a small structural pure-Python decoder
(grammar probe: analysis/rds_reader.py ; flag calibration: scratch/calib.py).
Every structural assumption is re-asserted at run time; any mismatch aborts.

Block-to-name assignment logic:
  In a DESeqResults (S4 / DFrame) object the six result columns are six consecutive
  REALSXP vectors of length nrow (5828). Their order is fixed by the trailing
  `names` attribute of the column list --
      baseMean, log2FoldChange, lfcSE, stat, pvalue, padj
  -- and by the per-column mcols descriptions ("mean of normalized counts ...",
  "log2 fold change (MLE): Strain 97 vs 1", "standard error ...", "Wald statistic ...",
  "Wald test p-value ...", "BH adjusted p-values"). The assignment is then
  independently confirmed by identities that hold only for that assignment:
      stat == log2FoldChange / lfcSE   (every row)
      padj >= pvalue                   (every row)
      baseMean > 0, lfcSE > 0, pvalue in [0,1]
      only log2FoldChange and stat take negative values
"""
import csv, gzip, math, os, re, struct, sys
from decimal import Decimal, ROUND_HALF_UP

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
DATA = os.path.join(ROOT, 'data')
MAIN_RDS = os.path.join(DATA, 'res_1vs97.rds')   # "Strain 97 vs 1"
SANE_RDS = os.path.join(DATA, 'res_1vs98.rds')   # "Strain 98 vs 1"
GENES_CSV = os.path.join(DATA, 'Pseudomonas_aeruginosa_UCBPP-PA14.csv')
OUT_MANIFEST = os.path.join(HERE, 'mexG_log2fc_manifest.csv')
OUT_LOG = os.path.join(HERE, 'run_log.txt')

REALSXP, STRSXP, CHARSXP = 14, 16, 9
COL_ORDER = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
log_lines = []


def log(msg=''):
    print(msg)
    log_lines.append(str(msg))


class Abort(Exception):
    pass


class RDS:
    """Minimal structural RDS reader (XDR, format v3): header, STRSXP, REALSXP."""

    def __init__(self, path):
        self.path = path
        with gzip.open(path, 'rb') as fh:
            self.buf = fh.read()
        self.p = 0
        self.header = self._header()

    def _u32(self, off=None):
        o = self.p if off is None else off
        if o + 4 > len(self.buf):
            raise Abort('read past EOF at %d' % o)
        return struct.unpack_from('>I', self.buf, o)[0]

    def _i32(self, off):
        return struct.unpack_from('>i', self.buf, off)[0]

    def _raw(self, n):
        v = self.buf[self.p:self.p + n]
        if len(v) != n:
            raise Abort('read past EOF')
        self.p += n
        return v

    def _header(self):
        if self._raw(1) != b'X' or self._raw(1) != b'\n':
            raise Abort('%s: not an RDS file (magic)' % self.path)
        fmt = self._i32(self.p); self.p += 4
        rver = self._i32(self.p); self.p += 4
        minv = self._i32(self.p); self.p += 4
        n = self._i32(self.p); self.p += 4
        charset = self._raw(n).decode('ascii', 'replace') if n >= 0 else None
        ver = lambda v: '%d.%d.%d' % ((v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF)
        return {'format_version': fmt, 'r_version': ver(rver),
                'min_reader_version': ver(minv), 'charset': charset,
                'bytes': len(self.buf)}

    def read_strsxp_at(self, off):
        flags = self._u32(off)
        if (flags & 0xFF) != STRSXP:
            raise Abort('expected STRSXP at %d, found type %d' % (off, flags & 0xFF))
        n = self._i32(off + 4)
        p = off + 8
        out = []
        for _ in range(n):
            f = self._u32(p); p += 4
            if (f & 0xFF) != CHARSXP:
                raise Abort('expected CHARSXP at %d (type %d)' % (p - 4, f & 0xFF))
            ln = self._i32(p); p += 4
            if ln < 0:
                out.append(None); continue
            s = self.buf[p:p + ln].decode('utf-8', 'replace'); p += ln
            if len(s) != ln:
                raise Abort('truncated CHARSXP at %d' % p)
            out.append(s)
        return out, p

    def read_realsxp_at(self, off):
        flags = self._u32(off)
        if (flags & 0xFF) != REALSXP:
            raise Abort('expected REALSXP at %d, found type %d' % (off, flags & 0xFF))
        n = self._i32(off + 4)
        if off + 8 + 8 * n > len(self.buf):
            raise Abort('REALSXP at %d runs past EOF' % off)
        return list(struct.unpack_from('>%dd' % n, self.buf, off + 8)), off + 8 + 8 * n

    def find_realsxp_of_len(self, n):
        pat = struct.pack('>i', n)
        hits = []
        for m in re.finditer(re.escape(pat), self.buf):
            off = m.start() - 4
            if off >= 0 and (self._u32(off) & 0xFF) == REALSXP:
                hits.append(off)
        return hits


def extract(path):
    rds = RDS(path)
    log('  RDS header : %s' % rds.header)
    off = 84  # first STRSXP header (DFrame `rownames` slot), re-verified below
    if (rds._u32(off) & 0xFF) != STRSXP:
        off = next(i for i in range(len(rds.buf) - 4) if (rds._u32(i) & 0xFF) == STRSXP)
        log('  rownames offset fell back to first STRSXP header: %d' % off)
    rownames, end = rds.read_strsxp_at(off)
    log('  rownames   : offset %d, n=%d, unique=%d, data ends at %d'
        % (off, len(rownames), len(set(rownames)), end))
    bad = [g for g in rownames if not re.match(r'^PA14_\d+$', str(g))]
    if bad:
        raise Abort('unexpected row-name format: %s' % bad[:5])
    nrows = len(rownames)
    blocks = rds.find_realsxp_of_len(nrows)
    log('  REALSXP(len=%d) blocks: %s' % (nrows, blocks))
    if len(blocks) != 6:
        raise Abort('expected 6 column blocks, found %d' % len(blocks))
    spacings = [blocks[i + 1] - blocks[i] for i in range(5)]
    log('  spacing    : %s (expected %d = 8 + 8*%d)' % (spacings, 8 + 8 * nrows, nrows))
    if len(set(spacings)) != 1:
        raise Abort('column blocks not regularly spaced -> alignment suspect')
    cols = {}
    for name, o in zip(COL_ORDER, blocks):
        vals, _e = rds.read_realsxp_at(o)
        if len(vals) != nrows:
            raise Abort('column %s length %d != nrow %d' % (name, len(vals), nrows))
        cols[name] = vals
    txt = gzip.open(path, 'rb').read().decode('latin-1')
    labels = sorted(set(re.findall(r'log2 fold change \(MLE\): [A-Za-z0-9 ]+', txt)))
    log('  comparison label(s) inside object: %s' % labels)
    return rds, rownames, cols, labels


def confirmations(rownames, cols):
    n = len(rownames)
    log('PUSH-BASED CONFIRMATIONS')
    log('  [1] rownames length == 5828                       : %s (n=%d)' % (n == 5828, n))
    assert n == 5828, 'row count mismatch'
    blk = RDS(MAIN_RDS).find_realsxp_of_len(n)
    sp = [blk[i + 1] - blk[i] for i in range(len(blk) - 1)]
    log('  [2] six REALSXP blocks, uniform %d B spacing      : %s' % (8 + 8 * n, set(sp) == {8 + 8 * n}))
    assert set(sp) == {8 + 8 * n}, 'block spacing mismatch'
    ok = sum(1 for l, s, e in zip(cols['log2FoldChange'], cols['stat'], cols['lfcSE'])
             if not (math.isnan(l) or math.isnan(s) or math.isnan(e)) and e != 0
             and abs(l / e - s) < 1e-6)
    log('  [3] stat == log2FoldChange / lfcSE                : %d/%d rows' % (ok, n))
    assert ok == n, 'identity stat == lfc/se failed -> assignment suspect'
    pv_ok = sum(1 for a, b in zip(cols['pvalue'], cols['padj'])
                if not (math.isnan(a) or math.isnan(b)) and b >= a - 1e-12)
    pv_tot = sum(1 for a in cols['pvalue'] if not math.isnan(a))
    log('  [4] padj >= pvalue                                : %d/%d rows' % (pv_ok, pv_tot))
    assert pv_ok == pv_tot, 'padj >= pvalue failed'
    bm_ok = all(x > 0 for x in cols['baseMean'] if not math.isnan(x))
    se_ok = all(x > 0 for x in cols['lfcSE'] if not math.isnan(x))
    pv_rng = all(0.0 <= x <= 1.0 for x in cols['pvalue'] if not math.isnan(x))
    neg = {k: sum(1 for x in v if not math.isnan(x) and x < 0) for k, v in cols.items()}
    log('  [5] baseMean>0 / lfcSE>0 / pvalue in [0,1]        : %s / %s / %s' % (bm_ok, se_ok, pv_rng))
    log('  [6] negative count per block                      : %s' % neg)
    assert bm_ok and se_ok and pv_rng, 'range check failed'
    assert neg['baseMean'] == 0 and neg['lfcSE'] == 0 and neg['pvalue'] == 0 and neg['padj'] == 0
    assert neg['log2FoldChange'] > 0 and neg['stat'] > 0, 'sign pattern unexpected'
    raw = gzip.open(MAIN_RDS, 'rb').read()
    tail_order = []
    for m in re.finditer(rb'[ -~]{3,}', raw):
        s = m.group().decode()
        if s in COL_ORDER and s not in tail_order:
            tail_order.append(s)
    log('  [7] trailing names attribute order                 : %s' % tail_order)
    assert tail_order == COL_ORDER, 'trailing names attribute order mismatch'
    for path, expect in ((MAIN_RDS, 'Strain 97 vs 1'), (SANE_RDS, 'Strain 98 vs 1')):
        t = gzip.open(path, 'rb').read().decode('latin-1')
        found = ('log2 fold change (MLE): %s' % expect) in t
        log('  [8] %-14s has label "log2 fold change (MLE): %s" : %s'
            % (os.path.basename(path), expect, found))
        assert found, 'comparison label missing'


def gene_lookup(sym):
    rows = list(csv.DictReader(open(GENES_CSV, newline='')))
    log('gene table: %d rows; columns used: Gene Name, Locus Tag, Gene synonyns, Product Name' % len(rows))
    key = sym.strip().lower()
    exact = [r for r in rows if (r['Gene Name'] or '').strip().lower() == key]
    partial = [r for r in rows if key in (r['Gene synonyns'] or '').lower()
               or key in (r['Product Name'] or '').lower()
               or key in (r['Product Synonyms'] or '').lower()]
    log('  exact `Gene Name` match for %-5s : %s' % (sym, [(r['Gene Name'], r['Locus Tag']) for r in exact]))
    log('  synonym/product matches          : %s' % [(r['Gene Name'], r['Locus Tag']) for r in partial])
    if len(exact) != 1:
        raise Abort('expected exactly one Gene Name match for %r, got %d' % (sym, len(exact)))
    if partial:
        log('  NOTE: synonym/product hits exist but are NOT used; exact Gene Name only.')
    return exact[0]


def fmt(x):
    return 'NA/NaN' if x is None or (isinstance(x, float) and math.isnan(x)) else repr(x)


def main():
    log('=' * 78)
    log('STEP 1  locate mexG in the PA14 gene table (exact Gene Name match only)')
    log('=' * 78)
    g = gene_lookup('mexG')
    locus = g['Locus Tag'].strip()

    log('')
    log('=' * 78)
    log('STEP 2  decode MAIN result object: %s' % os.path.basename(MAIN_RDS))
    log('=' * 78)
    _, rownames, cols, labels_main = extract(MAIN_RDS)

    log('')
    log('=' * 78)
    log('STEP 3  push-based confirmations (re-run of the structural checks)')
    log('=' * 78)
    confirmations(rownames, cols)

    log('')
    log('=' * 78)
    log('STEP 4  extract the mexG row')
    log('=' * 78)
    hits = [i for i, r in enumerate(rownames) if r == locus]
    log('  locus tag %s -> row index %s (of %d rows, 1-based rank %d by padj order)'
        % (locus, hits, len(rownames), (hits[0] + 1) if hits else -1))
    if len(hits) != 1:
        raise Abort('locus tag must appear exactly once, found %d' % len(hits))
    i = hits[0]
    vals = {c: cols[c][i] for c in COL_ORDER}
    na_present = any(isinstance(v, float) and math.isnan(v) for v in vals.values())
    log('  NA/NaN on this row across all six fields          : %s' % na_present)
    if na_present:
        raise Abort('NA/NaN present on the mexG row: %s' % vals)

    log('')
    log('  FULL-PRECISION (unrounded, repr) values -- Gene Name "%s", Locus Tag %s' % (g['Gene Name'], locus))
    log('  product name: "%s"; gene synonyns: "%s"' % (g['Product Name'], g['Gene synonyns']))
    for c in COL_ORDER:
        log('    %-14s = %s' % (c, fmt(vals[c])))
    lfc = vals['log2FoldChange']

    r_half_up = Decimal(repr(lfc)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
    r_py = round(lfc, 2)
    same = Decimal(repr(r_py)) == r_half_up
    log('')
    log('  ROUNDING')
    log('    Decimal(repr(log2FoldChange)) = %s' % Decimal(repr(lfc)))
    log('    ROUND_HALF_UP -> 2 dp         : %s' % r_half_up)
    log('    Python round(log2FC, 2)       : %s' % repr(r_py))
    log('    both methods identical        : %s' % same)

    log('')
    log('  SIGN / DIRECTION CHECK (arithmetic, not magnitude)')
    log('    column label read from object : "%s"' % (labels_main[0] if labels_main else '?'))
    log('    DESeq2 convention             : log2FoldChange = log2(mean_norm(#97)/mean_norm(#1))')
    log('    requested contrast            : Delta-rhlI (#97) vs wt (#1)  == identical orientation')
    log('    => value is reported AS-IS (sign preserved); |value| is NOT the answer.')
    log('    sign(log2FC) = %s' % ('negative' if lfc < 0 else 'positive'))

    log('')
    log('=' * 78)
    log('STEP 5  sanity check with %s  (NOT part of the answer)' % os.path.basename(SANE_RDS))
    log('=' * 78)
    _, rn98, cols98, labels98 = extract(SANE_RDS)
    # NOTE: DESeq2 sorts results() by padj, so each object has its own row ORDER.
    #       What must match is the gene SET (same filtering), not the order.
    same_set = set(rn98) == set(rownames)
    log('  same 5828-gene universe in both objects (set equal): %s' % same_set)
    log('  row ORDER identical (expected False: padj-sorted)   : %s' % (rn98 == rownames))
    if not same_set:
        raise Abort('gene sets differ between the two objects -> mapping suspect')
    i98 = rn98.index(locus)
    v98 = {c: cols98[c][i98] for c in COL_ORDER}
    log('  %s -> log2FoldChange(%s) = %s   [decoy/sanity object, excluded from answer]'
        % (os.path.basename(SANE_RDS), locus, fmt(v98['log2FoldChange'])))
    differ = any(abs(v98[c] - vals[c]) > 1e-12 for c in COL_ORDER)
    log('  the two files are genuinely different result objects: %s' % differ)
    if abs(v98['log2FoldChange'] - lfc) < 1e-12:
        raise Abort('sanity file identical to main file - files may be swapped')

    log('')
    log('=' * 78)
    log('FINAL ANSWER')
    log('=' * 78)
    log('  gene           : mexG (%s), P. aeruginosa UCBPP-PA14' % locus)
    log('  contrast       : strain #97 (Delta-rhlI) vs strain #1 (wt), DESeq2 MLE log2FoldChange')
    log('  source         : data/res_1vs97.rds  (label "Strain 97 vs 1")')
    log('  unrounded      : %s' % fmt(lfc))
    log('  rounded (2 dp) : %s   [ROUND_HALF_UP == Python round(): %s]' % (r_half_up, same))

    with open(OUT_MANIFEST, 'w', newline='') as fh:
        w = csv.writer(fh)
        w.writerow(['gene_name', 'locus_tag', 'product_name', 'source_file', 'comparison',
                    'row_index', 'baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue',
                    'padj', 'log2FoldChange_rounded_2dp', 'rounding_mode', 'na_present'])
        w.writerow([g['Gene Name'], locus, g['Product Name'], os.path.basename(MAIN_RDS),
                    'Strain 97 vs 1', i, repr(vals['baseMean']), repr(lfc), repr(vals['lfcSE']),
                    repr(vals['stat']), repr(vals['pvalue']), repr(vals['padj']),
                    str(r_half_up), 'ROUND_HALF_UP', str(na_present)])
        w.writerow([g['Gene Name'], locus, g['Product Name'], os.path.basename(SANE_RDS),
                    'Strain 98 vs 1 (sanity check, excluded)', i98, repr(v98['baseMean']),
                    repr(v98['log2FoldChange']), repr(v98['lfcSE']), repr(v98['stat']),
                    repr(v98['pvalue']), repr(v98['padj']),
                    str(Decimal(repr(v98['log2FoldChange'])).quantize(Decimal('0.01'),
                                                                      rounding=ROUND_HALF_UP)),
                    'ROUND_HALF_UP', str(any(isinstance(v, float) and math.isnan(v) for v in v98.values()))])
    log('  manifest written -> %s' % OUT_MANIFEST)
    with open(OUT_LOG, 'w') as fh:
        fh.write('\n'.join(log_lines) + '\n')
    return 0


if __name__ == '__main__':
    sys.exit(main())
