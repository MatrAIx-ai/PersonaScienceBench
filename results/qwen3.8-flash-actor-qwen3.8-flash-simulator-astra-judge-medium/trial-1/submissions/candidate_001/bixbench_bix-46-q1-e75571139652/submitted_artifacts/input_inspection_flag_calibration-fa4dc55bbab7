import gzip, struct, itertools, sys

NILVALUE=254; NILNAME=253; CHARSXP=9; SYMSXP=1; LISTSXP=2; LGLSXP=10
INTSXP=13; REALSXP=14; CPLXSXP=15; STRSXP=16; VECSXP=19; EXPRSXP=20
S4SXP=25; RAWSXP=24; EXTPTRSXP=22; REFSXP=255; CLASSREFSXP=246
NA_INT=-2147483648

class P:
    def __init__(self, buf, attr_bit, tag_bit, charxp_mask=0x40000):
        self.b=buf; self.p=0; self.attr=attr_bit; self.tag=tag_bit; self.cm=charxp_mask
    def i32(self):
        v=struct.unpack_from('>i',self.b,self.p)[0]; self.p+=4; return v
    def u32(self):
        v=struct.unpack_from('>I',self.b,self.p)[0]; self.p+=4; return v
    def i8(self):
        v=struct.unpack_from('>b',self.b,self.p)[0]; self.p+=1; return v
    def f64(self):
        v=struct.unpack_from('>d',self.b,self.p)[0]; self.p+=8; return v
    def raw(self,n):
        v=self.b[self.p:self.p+n]; self.p+=n; return v
    def header(self):
        assert self.raw(1)==b'X' and self.raw(1)==b'\n'
        fmt=self.i32(); rv=self.i32(); mv=self.i32()
        n=self.i32(); cs=self.raw(n).decode() if n>=0 else None
        return fmt,rv,mv,cs
    def read(self, depth=0):
        if depth>60: raise ValueError('too deep')
        flags=self.u32(); t=flags & 0xFF
        has_attr = bool(flags & self.attr) if self.attr else False
        has_tag  = bool(flags & self.tag)  if self.tag  else False
        if t in (NILVALUE, NILNAME): return None
        attrs = self.read(depth+1) if has_attr else None
        if t in (CHARSXP, SYMSXP):
            if t==SYMSXP:
                inner=self.read(depth+1)
                return ('sym', inner[1] if inner and inner[0]=='char' else inner)
            n=self.i32()
            if n<0: return ('char', None)
            return ('char', self.raw(n).decode('utf-8','replace'))
        if t==REFSXP: return ('ref', (flags>>8)&0xFFF)
        if t==CLASSREFSXP: return ('classref', self.i32())
        if t in (INTSXP, LGLSXP):
            n=self.i32()
            return ('int' if t==INTSXP else 'lgl', [self.i32() for _ in range(n)])
        if t==REALSXP:
            n=self.i32(); return ('real', [self.f64() for _ in range(n)])
        if t==RAWSXP:
            n=self.i32(); return ('raw', self.raw(n))
        if t==CPLXSXP:
            n=self.i32(); return ('cplx', [(self.f64(),self.f64()) for _ in range(n)])
        if t==STRSXP:
            n=self.i32(); return ('str', [self.read(depth+1) for _ in range(n)])
        if t in (VECSXP, EXPRSXP):
            n=self.i32(); return ('list', [self.read(depth+1) for _ in range(n)])
        if t in (LISTSXP, S4SXP):
            items=[]
            while True:
                tag=self.read(depth+1)
                if tag is None: break
                val=self.read(depth+1)
                items.append((tag,val))
            return ('s4' if t==S4SXP else 'pair', items)
        if t==EXTPTRSXP: return ('ptr', flags)
        raise ValueError('bad type %d at %d' % (t, self.p-4))

def try_parse(path, attr_bit, tag_bit):
    buf=gzip.open(path,'rb').read()
    p=P(buf, attr_bit, tag_bit)
    p.header()
    obj=p.read()
    return obj, p.p, len(buf)

def shape(o, d=0):
    if not isinstance(o,tuple): return repr(o)
    k=o[0]
    if k in ('char','sym','ref','classref','int','lgl','real','raw','cplx','ptr'):
        v=o[1]
        if k in ('int','lgl','real','str') and isinstance(v,list) and len(v)>6: return f'{k}({len(v)})'
        return f'{k}:{str(v)[:30]}'
    if k=='str': return 'str(%d)'%len(o[1])
    if k=='list': return 'list[%s]'%','.join(shape(x,d+1) for x in o[1][:4])
    if k in ('pair','s4'):
        return f'{k}{{{",".join(str(t[1])[:14] for t in o[1][:12])}}}'
    return k

if __name__=='__main__':
    path=sys.argv[1]
    cands=[0x100,0x200,0x400,0x800,0x1000,0x2000,0x4000,0x8000,0x10000,0x40000]
    for ab in [None]+cands:
        for tb in [0x400]:
            try:
                obj,end,total=try_parse(path,ab,tb)
                print('attr_bit',ab,'tag_bit',tb,'-> OK end',end,'of',total, 'shape:', shape(obj))
            except Exception as e:
                print('attr_bit',ab,'-> fail', str(e)[:60])
