"""Minimal pure-Python reader for RDS files (R XDR serialization).

Why this exists: the analysis runner has no R and no network access (rpy2 /
pyreadr cannot be installed), so the DESeq2 result objects saved with saveRDS()
are decoded directly from the RDS byte stream.

Grammar facts (verified empirically against these files):
  * header : 'X' '\\n' <format> <Rver> <minver> <charset-string>   (no native byte)
  * item   : <flags:u32> [attributes] [tag] payload
  * flags  : type = flags & 0xFF ; HAS_TAG = 0x400 ; HAS_ATTR = 0x40000
             (0x10000 = "object" flag; other high bits unused here)
  * pairlist: tagged nodes terminated by a NILVALUE (type 254) item
  * S4     : SEXPTYPE 25 (S4SXP) followed directly by its slot pairlist;
             class names live in the trailing class-reference table
  * strings: SEXPTYPE 9 (CHARSXP) with HAS_ATTR set (UTF-8 encoding attribute)

This module only decodes bytes; it draws no biological conclusions.
"""
import gzip, struct

NILVALUE=254; NILNAME=253; CLASSREFSXP=246
CHARSXP=9; SYMSXP=1; LISTSXP=2; ENVSXP=4; LGLSXP=10; INTSXP=13
REALSXP=14; CPLXSXP=15; STRSXP=16; DOTSXP=17; VECSXP=19; EXPRSXP=20
EXTPTRSXP=22; RAWSXP=24; S4SXP=25
NA_INT=-2147483648
HAS_TAG=0x400; HAS_ATTR=0x40000; OBJECT_FLAG=0x10000

NAMES={NILVALUE:'NIL',NILNAME:'NILNAME',CHARSXP:'CHARSXP',SYMSXP:'SYM',
       LISTSXP:'LISTSXP',ENVSXP:'ENV',LGLSXP:'LGLSXP',INTSXP:'INTSXP',
       REALSXP:'REALSXP',CPLXSXP:'CPLXSXP',STRSXP:'STRSXP',DOTSXP:'DOTS',
       VECSXP:'VECSXP',EXPRSXP:'EXPRSXP',EXTPTRSXP:'EXTPTR',RAWSXP:'RAW',
       S4SXP:'S4',CLASSREFSXP:'CLASSREF'}


class RDSError(Exception):
    pass


class Node:
    """A decoded R object."""
    def __init__(self, rtype, value=None, attrs=None):
        self.type=rtype; self.value=value; self.attrs=attrs or {}
    @property
    def tname(self): return NAMES.get(self.type, 'TYPE%d' % self.type)
    def names(self):
        return str_list(self.attrs.get('names'))
    def __repr__(self):
        v=self.value
        if isinstance(v,list): v='list(len=%d)' % len(v)
        elif isinstance(v,dict): v='dict(%s)' % list(v)
        elif isinstance(v,str) and len(v)>40: v=v[:40]+'...'
        return '<%s attrs=%s value=%s>' % (self.tname, list(self.attrs), v)


def str_list(node):
    """Return a python list of str from a STRSXP/CHARSXP node (or None)."""
    if node is None: return None
    if isinstance(node,str): return [node]
    if isinstance(node,Node) and node.type==STRSXP:
        return [x.value if isinstance(x,Node) else x for x in node.value]
    if isinstance(node,Node) and node.type==CHARSXP:
        return [node.value]
    return None


class Reader:
    def __init__(self, buf):
        self.b=buf; self.p=0
    # --- primitives ---
    def _i32(self):
        v=struct.unpack_from('>i', self.b, self.p)[0]; self.p+=4; return v
    def _u32(self):
        v=struct.unpack_from('>I', self.b, self.p)[0]; self.p+=4; return v
    def _i8(self):
        v=struct.unpack_from('>b', self.b, self.p)[0]; self.p+=1; return v
    def _f64(self):
        v=struct.unpack_from('>d', self.b, self.p)[0]; self.p+=8; return v
    def _raw(self, n):
        v=self.b[self.p:self.p+n]; self.p+=n; return v
    # --- header ---
    def header(self):
        if self._raw(1)!=b'X': raise RDSError('not an RDS file')
        if self._raw(1)!=b'\n': raise RDSError('bad RDS magic newline')
        fmt=self._i32(); rver=self._i32(); minver=self._i32()
        n=self._i32()
        charset=None if n<0 else self._raw(n).decode('ascii','replace')
        return {'format_version':fmt,
                'r_version':'%d.%d.%d'%((rver>>16)&0xFF,(rver>>8)&0xFF,rver&0xFF),
                'min_reader_version':'%d.%d.%d'%((minver>>16)&0xFF,(minver>>8)&0xFF,minver&0xFF),
                'charset':charset}
    # --- items ---
    def read(self):
        flags=self._u32(); t=flags & 0xFF
        has_tag=bool(flags & HAS_TAG); has_attr=bool(flags & HAS_ATTR)
        if t in (NILVALUE, NILNAME): return None
        attrs=self.read() if has_attr else {}
        attrs=self._as_dict(attrs)
        if t==CHARSXP or t==SYMSXP:
            if t==SYMSXP:
                inner=self.read()          # symbol name written as a CHARSXP item
                name=inner.value if isinstance(inner,Node) else inner
            else:
                n=self._i32()
                name=None if n<0 else self._raw(n).decode('utf-8','replace')
            node=Node(t, name, attrs)
            if t==CHARSXP: self.class_refs_seen=None
            return node
        if t==CLASSREFSXP:
            return Node(t, self._i32(), attrs)      # index into trailing class table
        if t in (INTSXP, LGLSXP):
            n=self._i32()
            vals=[self._i32() for _ in range(n)]
            if t==INTSXP: vals=[None if v==NA_INT else v for v in vals]
            else: vals=[None if v==NA_INT else bool(v) for v in vals]
            return Node(t, vals, attrs)
        if t==REALSXP:
            n=self._i32()
            return Node(t, [self._f64() for _ in range(n)], attrs)
        if t==RAWSXP:
            n=self._i32(); return Node(t, self._raw(n), attrs)
        if t==CPLXSXP:
            n=self._i32()
            return Node(t, [(self._f64(), self._f64()) for _ in range(n)], attrs)
        if t==STRSXP:
            n=self._i32()
            vals=[]
            for _ in range(n):
                item=self.read()
                if isinstance(item,Node) and item.type==CHARSXP and not item.attrs:
                    vals.append(Node(CHARSXP, item.value))
                else:
                    vals.append(item)
            return Node(t, vals, attrs)
        if t in (VECSXP, EXPRSXP):
            n=self._i32()
            return Node(t, [self.read() for _ in range(n)], attrs)
        if t in (LISTSXP, S4SXP):
            node=Node(t, [], attrs)
            while True:
                item=self.read()
                if item is None: break                      # end of pairlist
                tag=item.value if isinstance(item,Node) else item
                val=self.read()
                node.value.append((tag, val))
            if t==S4SXP: node.value=dict(node.value)
            return node
        if t==ENVSXP:
            raise RDSError('ENVSXP not supported by this minimal reader')
        if t==EXTPTRSXP:
            return Node(t, '<external pointer>', attrs)
        raise RDSError('unhandled SEXPTYPE %d at offset %d' % (t, self.p-4))
    def _as_dict(self, attrs):
        if attrs is None: return {}
        if isinstance(attrs,Node) and attrs.type==LISTSXP:
            return {k: v for k, v in attrs.value}
        if isinstance(attrs,dict): return attrs
        raise RDSError('attribute container is not a pairlist: %r' % (attrs,))


def read_rds(path):
    with gzip.open(path,'rb') as fh:
        buf=fh.read()
    r=Reader(buf)
    hdr=r.header()
    obj=r.read()
    return hdr, obj, r, buf
