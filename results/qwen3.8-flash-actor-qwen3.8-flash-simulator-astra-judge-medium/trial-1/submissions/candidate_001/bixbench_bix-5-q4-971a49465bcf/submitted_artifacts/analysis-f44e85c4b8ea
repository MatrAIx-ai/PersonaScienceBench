#!/usr/bin/env python3
"""bixbench:bix-5-q4 driver: DE (primary ~sex+condition, sensitivity ~condition) + GO BP enrichment.
Fixed decisions (pre-registered): universe = GENCODE v31 protein_coding with count>=5 in >=7 samples;
symbols from GENCODE gene_name, _PAR_Y dropped; sets FDR<0.05 & |log2FC|>=0.585 (primary) / >=1 (secondary),
up/down/union; headline = GO Biological Process term with smallest BH-adjusted p (ties: OR, then gene count).
"""
import json, os, sys, time, urllib.request
import numpy as np, pandas as pd
sys.path.insert(0, "/workspace/analysis")
from de_core import run_de, size_factors

DATA, OUT = "/workspace/data", "/workspace/analysis/results"
os.makedirs(OUT, exist_ok=True)
LOG = []
def log(*a):
    s = " ".join(str(x) for x in a); print(s, flush=True); LOG.append(s)

log("### 1 LOAD / TRAPS")
cnt = pd.read_csv(f"{DATA}/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt", sep=r"\s+").set_index("Geneid")
log(f"counts: SPACE-padded (not tab) -> sep=r'\\s+'; shape={cnt.shape}")
col = pd.read_excel(f"{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx", sheet_name="Sheet1")
log(f"coldata: shape={col.shape} condition={dict(col.condition.value_counts())} sex={dict(col.sex.value_counts())}")
log(f"samples in counts w/o metadata -> DROPPED: {sorted(set(cnt.columns)-set(col['sample']))}")
samples = col['sample'].tolist(); cnt = cnt[samples]; N = len(samples)
meta = col.set_index('sample').loc[samples]
log(f"N={N}\n{pd.crosstab(meta.condition, meta.sex)}")
is_d = (meta.condition == 'disease').values.astype(float)
is_m = (meta.sex == 'M').values.astype(float)

log("\n### 2 UNIVERSE")
g = pd.read_csv(f"{DATA}/gencode.v31.primary_assembly.genes.csv")
assert set(cnt.index) == set(g.gene_id)
pc = g[g.gene_type == 'protein_coding'].copy().set_index('gene_id')
pc['gene_id'] = pc.index.to_numpy()
par = pc[pc.gene_id.str.contains('_PAR_Y')]
log(f"protein_coding={len(pc)}; _PAR_Y dropped={len(par)} symbols={sorted(set(par.gene_name))}")
pc = pc[~pc.gene_id.str.contains('_PAR_Y') & pc.gene_id.isin(cnt.index)]
M = cnt.loc[pc.gene_id]
n_before = len(pc)
sel = ((M >= 5).sum(axis=1) >= 7).values
M, pc = M.loc[sel], pc.loc[sel]
log(f"expression filter count>=5 in >=7: kept {len(pc)} dropped {n_before-len(pc)}")
drop_log = []
for sym, sub in pc[pc.gene_name.duplicated(keep=False)].groupby('gene_name'):
    tot = M.loc[sub.gene_id].sum(axis=1).sort_values(ascending=False)
    for gid in tot.index[1:]:
        drop_log.append(dict(gene_id=gid, symbol=sym, total_counts=int(tot[gid])))
    log(f"duplicate symbol {sym}: kept {tot.index[0]} (sum={int(tot.iloc[0])}), dropped {list(tot.index[1:])}")
M = M.loc[~M.index.isin([d['gene_id'] for d in drop_log])]
pc = pc.loc[M.index]
log(f"FINAL background = {len(pc)} genes / {pc.gene_name.nunique()} unique symbols; symbol missing={pc.gene_name.isna().sum()}")
h = pd.read_csv(f"{DATA}/HGNC_05-09-19.txt", sep='\t')
ha = h[(h.Status == 'Approved') & h['Ensembl ID(supplied by Ensembl)'].notna()]
hmap = dict(zip(ha['Ensembl ID(supplied by Ensembl)'], ha['Approved symbol']))
hsym = pc.gene_id.str.split('.').str[0].map(hmap)
has = hsym.notna().values; agr = (hsym.values[has] == pc.gene_name.values[has])
log(f"HGNC cross-check (not fallback): present {has.sum()}/{len(pc)}, symbol agreement {agr.sum()} ({100*agr.mean():.2f}%), mismatched={sorted(set(pc.gene_name.values[has][~agr]))[:12]}")
log(f"unmapped-to-HGNC kept via GENCODE symbol = {int((~has).sum())}")

log("\n### 3 DE (hand-rolled DESeq2-equivalent NB2 GLM - declared substitution)")
one = np.ones((N, 1))
Dp = np.hstack([one, is_m[:, None], is_d[:, None]])
Ds = np.hstack([one, is_d[:, None]])
log(f"primary design = ['Intercept','sex_M','condition_disease']; sensitivity = ['Intercept','condition_disease']")
log("primary design matrix (rows=samples):\n" + pd.DataFrame(Dp.astype(int), index=samples,
    columns=['Intercept','sex_M','condition_disease']).to_string())
res_p, sf, gd_p, sh_p, tr_p = run_de(M, Dp, pc.gene_name.values)
res_s, sf_s, gd_s, sh_s, tr_s = run_de(M, Ds, pc.gene_name.values)
log(f"size factors: {dict(zip(samples, np.round(sf,4).tolist()))}")
for nm, gd, sh in [("primary", gd_p, sh_p), ("sensitivity", gd_s, sh_s)]:
    log(f"dispersion {nm}: gene-wise median={np.median(gd):.4f} IQR=({np.percentile(gd,25):.4f},{np.percentile(gd,75):.4f}); "
        f"shrunk median={np.median(sh):.4f} IQR=({np.percentile(sh,25):.4f},{np.percentile(sh,75):.4f})")
res_p.to_csv(f"{OUT}/DE_primary_sex_plus_condition.csv", index=False)
res_s.to_csv(f"{OUT}/DE_sensitivity_condition_only.csv", index=False)
counts_tab = {}
for nm, r in [("primary", res_p), ("sensitivity", res_s)]:
    for lab, m in [("FDR<0.05", r.FDR < 0.05),
                   ("FDR<0.05&|lfc|>=0.585(PRIMARY)", (r.FDR < 0.05) & (r.log2FC.abs() >= 0.585)),
                   ("FDR<0.05&|lfc|>=1(SECONDARY)", (r.FDR < 0.05) & (r.log2FC.abs() >= 1.0))]:
        s_ = r[m]; counts_tab[f"{nm}|{lab}"] = dict(n=len(s_), up=int((s_.log2FC > 0).sum()), down=int((s_.log2FC < 0).sum()))
        log(f"{nm:12s} {lab:32s} n={len(s_):5d} up={counts_tab[f'{nm}|{lab}']['up']:4d} down={counts_tab[f'{nm}|{lab}']['down']:4d}")
log("\ntop 15 by FDR, primary model:\n" + res_p.sort_values('FDR').head(15).to_string(index=False))
log("ASXL1 in primary DE table:\n" + res_p[res_p.gene_name == 'ASXL1'].to_string(index=False))
log("ASXL1 in sensitivity DE table:\n" + res_s[res_s.gene_name == 'ASXL1'].to_string(index=False))

log("\n### 4 QC GENES (normalized CPM by group/sex; ASXL1 = filename-based assumption check)")
sf_all = size_factors(cnt); norm = (cnt.values / sf_all)
cpm = norm / norm.sum(axis=0, keepdims=True) * 1e6
qc = {}
for sym, gid in [("ASXL1", "ENSG00000171456"), ("XIST", "ENSG00000229807"), ("RPS4Y1", "ENSG00000129824"), ("DDX3Y", "ENSG00000067048")]:
    hit = [i for i in cnt.index if i.split('.')[0] == gid]
    if not hit:
        log(f"{sym}: absent from counts"); continue
    v = cpm[list(cnt.index).index(hit[0])]
    gid_used = hit[0]
    qc[sym] = dict(counts_id=gid_used, mean_CPM_disease=float(v[meta.condition.values == 'disease'].mean()),
                   mean_CPM_control=float(v[meta.condition.values == 'control'].mean()),
                   mean_CPM_F=float(v[meta.sex.values == 'F'].mean()), mean_CPM_M=float(v[meta.sex.values == 'M'].mean()),
                   in_background=bool(gid_used in set(pc.gene_id)))
    log(f"{sym:7s} CPM disease={qc[sym]['mean_CPM_disease']:8.2f} control={qc[sym]['mean_CPM_control']:8.2f} F={qc[sym]['mean_CPM_F']:8.2f} M={qc[sym]['mean_CPM_M']:8.2f} in_background={qc[sym]['in_background']}")
pd.DataFrame([qc]).T.to_csv(f"{OUT}/qc_gene_cpm.csv")

log("\n### 5 GENE SETS")
sets = {}
for nm, r in [("primary", res_p), ("sensitivity", res_s)]:
    for thr, tn in [(0.585, "lfc0.585"), (1.0, "lfc1")]:
        b = r[(r.FDR < 0.05) & (r.log2FC.abs() >= thr)]
        for d_, s_ in [("up", b[b.log2FC > 0]), ("down", b[b.log2FC < 0]), ("union", b)]:
            key = f"{nm}_{tn}_{d_}"; sets[key] = sorted(map(str, s_.gene_name))
            s_.sort_values('FDR').to_csv(f"{OUT}/geneset_{key}.csv", index=False)
json.dump(sets, open(f"{OUT}/gene_sets.json", "w"), indent=1)
log("set sizes: " + json.dumps({k: len(v) for k, v in sets.items()}))
json.dump(dict(size_factor_counts=dict(zip(samples, sf.tolist())),
               dispersion_summary={k: float(np.median(v)) for k, v in
                   [("gene_wise_primary", gd_p), ("shrunk_primary", sh_p), ("gene_wise_sensitivity", gd_s), ("shrunk_sensitivity", sh_s)]},
               de_counts=counts_tab, qc_cpm=qc, dropped_dup_symbols=drop_log,
               background_n=int(len(pc))), open(f"{OUT}/model_report.json", "w"), indent=1, default=float)
open(f"{OUT}/qc_log.txt", "w").write("\n".join(LOG) + "\n")
log("\nDONE. outputs: " + ", ".join(sorted(os.listdir(OUT))))
