"""GO enrichment engine: parses a REAL GAF (GO Consortium / GOA format) and runs the
hypergeometric (Fisher 'greater') test with BH correction. No annotation is ever invented.
The ontology 'Biological Process' filter uses the GAF aspect column (col 8) when present,
else the aspect is taken from the GO term namespace via a supplied go-basic file."""
import gzip, os
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

ASPECT_PROCESS = {'P', 'biological_process', 'biological_process^part_of',
                  'biological_process^negative_regulation_of',
                  'biological_process^positive_regulation_of'}


def load_gaf(path, require_process=True):
    opener = gzip.open if path.endswith('.gz') else open
    rows = []
    with opener(path, 'rt', errors='ignore') as fh:
        for line in fh:
            if line.startswith('!') or not line.strip():
                continue
            f = line.rstrip('\n').split('\t')
            if len(f) < 11:
                continue
            aspect = f[8]
            if aspect == 'contributes_to':
                aspect = f[9] if f[9] in ASPECT_PROCESS else 'IEA'
            rows.append(dict(symbol=f[3].strip(), go_id=f[4].strip(), aspect=aspect,
                             go_name=f[10].split(';')[0].strip(), evidence=f[6].strip()))
    df = pd.DataFrame(rows)
    if df.empty:
        raise ValueError(f"no GAF rows parsed from {path}")
    if require_process and df.aspect.isin(ASPECT_PROCESS).any():
        df = df[df.aspect.isin(ASPECT_PROCESS)]
    return df.drop_duplicates(['symbol', 'go_id', 'go_name'])


def hypergeometric_enrich(query_symbols, background, ann, min_genes=3):
    """query/background are iterables of gene symbols; ann = annotation table (symbol, go_id, go_name)."""
    bg = set(map(str, background)); q = set(map(str, query_symbols)) & bg
    N = len(bg)
    sub = ann[ann.symbol.astype(str).isin(bg)]
    out = []
    for (gid, gname), grp in sub.groupby(['go_id', 'go_name']):
        term = set(grp.symbol.astype(str)) & bg
        K = len(term); n = len(q); k = len(term & q)
        if K < min_genes or n == 0:
            continue
        p = stats.hypergeom.sf(k - 1, N, K, n)
        a, b, c, d = k, K - k, n - k, max(N - K - n + k, 1)
        orr = (a * d) / (b * c) if b * c > 0 else np.inf
        out.append(dict(go_id=gid, go_name=gname, term_size=K, set_size=n, overlaps=k,
                        fold_enrich=(k / K) / (n / N) if K and n else np.nan,
                        odds_ratio=orr, pvalue=p))
    res = pd.DataFrame(out)
    if res.empty:
        return res
    res['FDR_BH'] = multipletests(res.pvalue.values, method='fdr_bh')[1]
    # fixed decision rule: rank by adjusted p, then odds ratio, then gene count
    return res.sort_values(['FDR_BH', 'odds_ratio', 'overlaps'],
                           ascending=[True, False, False]).reset_index(drop=True)
