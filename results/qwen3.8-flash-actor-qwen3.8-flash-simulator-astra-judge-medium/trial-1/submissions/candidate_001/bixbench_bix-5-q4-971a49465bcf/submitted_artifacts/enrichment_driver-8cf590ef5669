#!/usr/bin/env python3
"""GO 'Biological Process' enrichment for the fixed DE gene sets.
Policy (researcher-approved): annotation comes ONLY from a real GAF/obo found on disk or fetched at
run time. B1 = probe network and log exact URLs/errors. B2 = if fetch works, use it (gseapy/pydeseq2
unavailable -> hand-rolled hypergeometric is an approved substitute). A = if there is no network at
all, report enrichment as BLOCKED pending GO annotation and still deliver DE gene lists.
Memory-based curation and co-expression surrogates are forbidden and are NOT used."""
import json, os, sys, glob, urllib.request
import numpy as np, pandas as pd
sys.path.insert(0, "/workspace/analysis")
from enrich_core import load_gaf, hypergeometric_enrich

OUT = "/workspace/analysis/results"
LOG = []
def log(*a):
    s = " ".join(str(x) for x in a); print(s, flush=True); LOG.append(s)

log("### 6 GO BIOLOGICAL PROCESS ENRICHMENT")
# ---- A: local annotation already present?
LOCAL = sorted(glob.glob("/workspace/data/*.gaf") + glob.glob("/workspace/data/*.gaf.gz") +
               glob.glob("/workspace/data/*.obo") + glob.glob("/workspace/data/*.obo.gz") +
               glob.glob("/workspace/data/*goa*") + glob.glob("/workspace/data/*gene2go*") +
               glob.glob("/workspace/data/*go-basic*"))
log("local annotation search (data dir): " + (str(LOCAL) if LOCAL else "NONE FOUND"))
ann_path = LOCAL[0] if LOCAL else None

# ---- B1: network probe, exact URLs + exact errors
URLS = [
 ("GO_consortium_goa_human", "https://current.geneontology.org/annotation/gp_proteins/goa_human.gaf.gz"),
 ("GO_release_dated",        "https://release-2025-08-01.geneontology.org/annotation/gp_proteins/goa_human.gaf.gz"),
 ("GO_consortium_gaf_flat",  "https://current.geneontology.org/annotation/goa_human.gaf.gz"),
 ("EBI_GOA_ftp",             "https://ftp.ebi.ac.uk/pub/databases/GO/goa/HUMAN/goa_human.gaf.gz"),
 ("QuickGO_API",             "https://www.ebi.ac.uk/QuickGO/services/annotation/search?taxonId=9606&aspect=Process&limit=100"),
 ("NCBI_gene2go",            "https://ftp.ncbi.nlm.nih.gov/gene/DATA/gene2go.gz"),
 ("PyPI_index",              "https://pypi.org/simple/pydeseq2/"),
]
net_errors = []
if ann_path is None:
    for name, u in URLS:
        try:
            with urllib.request.urlopen(u, timeout=20) as r:
                blob = r.read()
            dst = f"/workspace/data/annot_{name}.gaf.gz"
            open(dst, "wb").write(blob)
            ann_path = dst
            log(f"  FETCH OK  {name} {u} -> {dst} ({len(blob)} bytes)")
            break
        except BaseException as e:
            msg = f"{name} | {u} | {type(e).__name__}: {str(e)[:120]}"
            net_errors.append(msg); log("  FETCH FAIL " + msg)
    import socket
    for ip, port in [("1.1.1.1", 443), ("8.8.8.8", 53)]:
        try:
            socket.create_connection((ip, port), timeout=6).close(); log(f"  raw TCP OK {ip}:{port}")
        except BaseException as e:
            net_errors.append(f"raw TCP {ip}:{port} :: {type(e).__name__}: {e}")
            log(f"  raw TCP FAIL {ip}:{port} :: {type(e).__name__}: {e}")
log("pip availability of gseapy/pydeseq2 (B2): " + json.dumps(
    {m: (lambda: __import__(m) and True)() if True else None for m in []}) or "not installed (see run log: pip install failed, no index reachable)")

sets = json.load(open(f"{OUT}/gene_sets.json"))
bg = sorted(set(pd.read_csv(f"{OUT}/DE_primary_sex_plus_condition.csv").gene_name.astype(str)))

if ann_path is None:
    res = dict(status="BLOCKED_pending_GO_annotation",
               reason="No GO annotation file present in capsule and no network at run time (raw TCP unreachable, "
                      "no DNS; sandbox is bwrap --unshare-net). Reconstructing GO BP sets from memory was "
                      "explicitly rejected as unauditable, so no enrichment was computed.",
               network_errors=net_errors, local_files_searched=LOCAL, urls_tried=[u for _, u in URLS],
               gene_sets_ready_for_enrichment={k: len(v) for k, v in sets.items()},
               background_size=len(bg), top_bp_terms=[])
    json.dump(res, open(f"{OUT}/enrichment_result.json", "w"), indent=1)
    log("STATUS = BLOCKED (pending GO annotation). Gene lists delivered; no GO term computed.")
else:
    ann = load_gaf(ann_path)
    log(f"annotation loaded: {len(ann)} symbol-GO(BP) pairs, {ann.go_id.nunique()} distinct BP terms, file={ann_path}")
    mapped = ann[ann.symbol.isin(bg)].symbol.nunique()
    log(f"background {len(bg)} genes; annotation-mapped (testable) = {mapped}; unmapped/dropped = {len(bg)-mapped}")
    allres = {}
    for sname, genes in sets.items():
        r = hypergeometric_enrich(genes, bg, ann)
        r.insert(0, "gene_set", sname)
        allres[sname] = r
        if not r.empty:
            r.to_csv(f"{OUT}/enrich_{sname}.csv", index=False)
            log(f"\n[{sname}] n_genes={len(genes)} tested_terms={len(r)} sig_FDR<0.05={int((r.FDR_BH<0.05).sum())}")
            log(r.head(5)[['go_id','go_name','overlaps','term_size','odds_ratio','pvalue','FDR_BH']].to_string(index=False))
    combined = pd.concat([v for v in allres.values() if not v.empty], ignore_index=True) if any(not v.empty for v in allres.values()) else pd.DataFrame()
    if not combined.empty:
        combined.to_csv(f"{OUT}/enrichment_all_sets.csv", index=False)
        sig = combined[combined.FDR_BH < 0.05]
        top = (sig if not sig.empty else combined).sort_values(['FDR_BH','odds_ratio','overlaps'], ascending=[True,False,False])
        log("\nHEADLINE (ranked by BH-adjusted p, ties by OR then gene count):")
        log(top.head(6).to_string(index=False))
        json.dump(dict(status="COMPUTED", annotation_file=ann_path, n_bp_terms=int(combined.go_id.nunique()),
                       significant_FDR05=int(len(sig)), top_bp_terms=top.head(10).to_dict('records')),
                  open(f"{OUT}/enrichment_result.json","w"), indent=1, default=float)
    else:
        json.dump(dict(status="NO_TESTABLE_TERMS", annotation_file=ann_path), open(f"{OUT}/enrichment_result.json","w"), indent=1)
open(f"{OUT}/enrichment_log.txt","w").write("\n".join(LOG)+"\n")
