"""
BixBench bix-51-q1
Question: Using a logistic regression model and age as the only predictor, what is the
predicted probability of achieving efficacy PR with treatment in patients aged 65?

Pipeline: load -> clean -> code outcome -> Logit(y ~ Age) MLE (statsmodels)
          -> predict at Age=65 (fraction primary, % secondary)
          -> diagnostics + robustness/sensitivity checks.
Primary estimate = statsmodels MLE.  No standardization / binning / splines.
'Groups' is NOT a covariate (perfectly associated with outcome; question says age only).
"""
import json
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

XLSX = "data/data.xlsx"
AGE_AT = 65.0
out = {}

# ---------------------------------------------------------------- 1. load / inspect
raw = pd.read_excel(XLSX, sheet_name="Sheet1")
out["raw_shape"] = list(raw.shape)
out["columns"] = list(raw.columns)

# blank rows + trailing row holding only a whitespace string in Age
df = raw[raw["Sequence number"].notna()].copy()
out["n_after_drop_blank_rows"] = int(len(df))
out["seq_contiguous_1_n"] = bool(sorted(df["Sequence number"]) == list(range(1, len(df) + 1)))

# Age -> numeric (raw years, no transformation)
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
df["Efficacy"] = df["Efficacy"].astype(str).str.strip()
out["age_missing_after_cast"] = int(df["Age"].isna().sum())
out["age_min"], out["age_max"] = float(df["Age"].min()), float(df["Age"].max())
out["age_mean"], out["age_sd"] = float(df["Age"].mean()), float(df["Age"].std(ddof=1))
out["n_age_exactly_65"] = int((df["Age"] == AGE_AT).sum())
out["efficacy_counts"] = {k: int(v) for k, v in df["Efficacy"].value_counts().items()}
out["groups_counts"] = {str(k): int(v) for k, v in df["Groups"].value_counts().items()}
out["groups_x_efficacy"] = pd.crosstab(df["Groups"], df["Efficacy"]).to_dict()

# ---------------------------------------------------------------- 2. outcome coding
df["y"] = (df["Efficacy"] == "PR").astype(int)          # SD and PD pooled as non-PR
n = len(df); n_ev = int(df["y"].sum()); n_ne = int(n - n_ev)
out["n"] = n; out["n_events_PR"] = n_ev; out["n_non_events_SD_PD"] = n_ne
out["unconditional_PR_rate"] = round(n_ev / n, 4)
out["age_by_group"] = {str(k): [float(v["count"]), float(v["mean"]), float(v["min"]), float(v["max"])]
                       for k, v in df.groupby("Groups")["Age"].describe().iterrows()}
out["age_by_efficacy"] = {k: [int(v["count"]), float(v["mean"]), float(v["min"]), float(v["max"])]
                          for k, v in df.groupby("Efficacy")["Age"].describe().iterrows()}

# ---------------------------------------------------------------- 3. fit Logit(y ~ Age)
X = sm.add_constant(df["Age"].to_numpy(float), has_constant="add")   # [const, Age]
y = df["y"].to_numpy(float)
model = sm.Logit(y, X)
res = model.fit(disp=0, maxiter=200)
b0, b1 = float(res.params[0]), float(res.params[1])
se0, se1 = float(res.bse[0]), float(res.bse[1])
out["fit"] = {
    "converged": bool(res.mle_retvals["converged"]),
    "nobs": int(res.nobs), "df_model": int(res.df_model),
    "beta0_intercept": b0, "beta1_age": b1,
    "se_beta0": se0, "se_beta1": se1,
    "odds_ratio_age": float(np.exp(b1)),
    "p_value_age": float(res.pvalues[1]),
    "llf": float(res.llf), "llf_null": float(res.llnull),
    "llr_p": float(res.llr_pvalue),
    "pseudo_r2_mcfadden": float(res.prsquared),
    "aic": float(res.aic), "bic": float(res.bic),
    "coef_ci95": {"const": [float(res.conf_int()[0][0]), float(res.conf_int()[0][1])],
                  "Age": [float(res.conf_int()[1][0]), float(res.conf_int()[1][1])]},
}

# independent ILS/Newton re-implementation as MLE cross-check (sklearn not installed offline)
def irls(X, y, iters=200, tol=1e-12):
    b = np.zeros(X.shape[1])
    for _ in range(iters):
        p = 1.0 / (1.0 + np.exp(-X @ b))
        W = np.diag(p * (1 - p))
        grad = X.T @ (y - p)
        H = X.T @ W @ X
        step = np.linalg.solve(H, grad)
        b = b + step
        if np.max(np.abs(step)) < tol:
            break
    return b
b_irls = irls(X, y)
out["irls_manual_check"] = {"beta": [float(v) for v in b_irls],
                            "max_abs_diff_vs_statsmodels": float(np.max(np.abs(b_irls - np.array([b0, b1]))))}

# ---------------------------------------------------------------- 4. prediction at Age = 65
def predict_and_ci(beta, cov, a=AGE_AT):
    x = np.array([1.0, a])
    lp = float(x @ beta)
    p = 1.0 / (1.0 + np.exp(-lp))
    d = np.array([p * (1 - p), a * p * (1 - p)])          # dp/dbeta (delta method)
    se = float(np.sqrt(d @ np.asarray(cov) @ d))
    z = stats.norm.ppf(0.975)
    return lp, p, se, (max(0.0, p - z * se), min(1.0, p + z * se))

beta = np.array([b0, b1])
lp65, p65, se65, ci65 = predict_and_ci(beta, res.cov_params(), AGE_AT)

# profile-likelihood CI for p(65), for completeness
AGE_VEC = df["Age"].to_numpy(float)

def profile_llf(p_target):
    """Max llf of Logit(Age) constrained so that p(65) = p_target (intercept reparameterised)."""
    from scipy.optimize import minimize_scalar
    def negllf(b1_):
        b0_ = np.log(p_target / (1 - p_target)) - b1_ * AGE_AT
        eta = b0_ + b1_ * AGE_VEC
        return -np.sum(y * eta - np.logaddexp(0.0, eta))
    r = minimize_scalar(negllf, bounds=(b1 - 3.0, b1 + 3.0), method="bounded",
                        options={"xatol": 1e-10})
    return -float(r.fun)

crit = res.llf - 0.5 * stats.chi2.ppf(0.95, 1)
from scipy.optimize import brentq
def f_prof(pt):
    return profile_llf(pt) - crit
try:
    # locate bracket by coarse scan, then refine
    def find_bracket(a, b, npts=80):
        """first adjacent pair that changes sign from >=0 (inside CI) to <0 (outside)."""
        xs = np.linspace(a, b, npts)
        fs = [f_prof(x) for x in xs]
        for i in range(len(xs) - 1):
            if (fs[i] >= 0) != (fs[i + 1] >= 0):
                return xs[i], xs[i + 1]
        return None
    br_lo = find_bracket(p65, 1e-4)
    br_hi = find_bracket(p65, 1 - 1e-4)
    prof_lo = float(brentq(f_prof, *br_lo, xtol=1e-7)) if br_lo else float("nan")
    prof_hi = float(brentq(f_prof, *br_hi, xtol=1e-7)) if br_hi else float("nan")
except Exception as e:
    prof_lo = prof_hi = float("nan")
    out["profile_ci_error"] = str(e)

pr = res.get_prediction(sm.add_constant(np.array([[AGE_AT]]), has_constant="add"))
sm_wald = pr.conf_int(alpha=0.05)[0]
out["statsmodels_get_prediction_crosscheck"] = {
    "p": round(float(pr.predicted[0]), 4),
    "se": round(float(pr.se[0]), 4),
    "ci95": [round(float(sm_wald[0]), 4), round(float(sm_wald[1]), 4)],
}

out["prediction_age_65"] = {
    "age": AGE_AT,
    "linear_predictor": round(lp65, 6),
    "predicted_probability_fraction_PRIMARY": round(p65, 4),
    "predicted_probability_percent_secondary": round(100 * p65, 2),
    "delta_method_se": round(se65, 4),
    "delta_method_ci95": [round(ci65[0], 4), round(ci65[1], 4)],
    "profile_likelihood_ci95": [round(prof_lo, 4), round(prof_hi, 4)],
}

# fitted values / ROC / Hosmer-Lemeshow style grouping (diagnostics only)
pfit = res.predict(X)
out["diagnostics"] = {
    "pred_min_max": [float(pfit.min()), float(pfit.max())],
    "pred_mean_vs_obs_rate": [round(float(pfit.mean()), 4), round(n_ev / n, 4)],
    "roc_auc": float(stats.rankdata(pfit)[y == 1].mean() / n - (n_ev + 1) / (2.0 * n) + 0.5
                     if False else (stats.rankdata(pfit)[y == 1].sum() - n_ev * (n_ev + 1) / 2)
                     / (n_ev * n_ne)),
    "n_per_group_for_HL": 5,
}
g = pd.qcut(pfit, 5, labels=False, duplicates="drop")
tab = pd.DataFrame({"g": g, "y": y, "p": pfit}).groupby("g").agg(
    n=("y", "size"), obs=("y", "sum"), exp=("p", "mean"))
hl = float(np.sum((tab["obs"] - tab["n"] * tab["exp"]) ** 2 / (tab["n"] * tab["exp"] * (1 - tab["exp"]))))
out["diagnostics"]["hosmer_lemeshow_chi2_df4"] = round(hl, 3)
out["diagnostics"]["hosmer_lemeshow_p"] = float(stats.chi2.sf(hl, int(len(tab)) - 2))
out["diagnostics"]["group_calibration"] = tab.round(3).to_dict()

# ---------------------------------------------------------------- 5. sensitivity checks
# (a) SD excluded -> PR vs PD only
sub = df[df["Efficacy"].isin(["PR", "PD"])].copy()
Xs = sm.add_constant(sub["Age"].to_numpy(float), has_constant="add")
ys = (sub["Efficacy"] == "PR").astype(float).to_numpy()
rs = sm.Logit(ys, Xs).fit(disp=0, maxiter=200)
lp_s, p_s, se_s, ci_s = predict_and_ci(np.asarray(rs.params, float), rs.cov_params(), AGE_AT)
out["sensitivity_PR_vs_PD_only"] = {
    "n": int(len(sub)), "n_events_PR": int(ys.sum()), "n_non_events_PD": int(len(sub) - ys.sum()),
    "beta0": round(float(rs.params[0]), 4), "beta1": round(float(rs.params[1]), 4),
    "predicted_probability_age65": round(p_s, 4), "ci95_delta": [round(ci_s[0], 4), round(ci_s[1], 4)],
    "abs_diff_vs_primary": round(abs(p_s - p65), 4),
}
# (b) Group-1-only: all 41 are PR -> outcome constant, model NOT identifiable (documented, not fitted)
out["group1_only_note"] = {
    "n_group1": int((df["Groups"] == 1).sum()),
    "efficacy_levels": sorted(df.loc[df["Groups"] == 1, "Efficacy"].unique().tolist()),
    "identifiable": False,
    "reason": "outcome constant (all PR) -> complete separation, logistic MLE diverges; reported as note only",
}
# (c) standardised-age refit (must reproduce identical fitted probability at 65)
az = (df["Age"] - df["Age"].mean()) / df["Age"].std(ddof=1)
rz = sm.Logit(y, sm.add_constant(az.to_numpy(float), has_constant="add")).fit(disp=0)
b0z, b1z = float(rz.params[0]), float(rz.params[1])
p65z = 1 / (1 + np.exp(-(b0z + b1z * (AGE_AT - df["Age"].mean()) / df["Age"].std(ddof=1))))
out["sensitivity_standardised_age_refit"] = {"beta0": round(b0z, 4), "beta1": round(b1z, 4),
                                             "p_at_65": round(float(p65z), 4),
                                             "identical_to_primary": bool(abs(p65z - p65) < 1e-9)}
# (d) raw Age == 65 empirical PR rate (non-model reference)
d65 = df[df["Age"] == AGE_AT]
out["empirical_reference_age65"] = {"n": int(len(d65)), "n_PR": int((d65["Efficacy"] == "PR").sum()),
                                    "observed_PR_rate": round(float((d65["Efficacy"] == "PR").mean()), 4)}

print(json.dumps(out, indent=2, default=str))
with open("analysis/results.json", "w") as f:
    json.dump(out, f, indent=2, default=str)

print("\n=== ANSWER ===")
print(f"Logit(PR) = {b0:.4f} + {b1:.4f} * Age   (n=80, {n_ev} PR vs {n_ne} SD/PD)")
print(f"Predicted P(PR | Age=65) = {p65:.4f}  ({100*p65:.2f}% ), 95% CI {ci65[0]:.4f}-{ci65[1]:.4f}")
