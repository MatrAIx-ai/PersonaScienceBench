# BixBench bix-51-q3 -- FINAL ANALYSIS (approved spec)
# Q: p-value for Age in combined logistic regression (BMI + Age + Gender)
#    predicting treatment response PR (PR=1 vs SD/PD=0), n=80.
import numpy as np
import pandas as pd
import statsmodels.api as sm
import warnings

df = pd.read_excel('data/data.xlsx')
df = df.dropna(how='all')
df = df[df['Efficacy'].notna()].reset_index(drop=True)
print(f"Valid analysis rows: {len(df)}")

y = df['Efficacy'].eq('PR').astype(float)                 # PR=1, SD/PD=0
X = pd.DataFrame({
    'Age': pd.to_numeric(df['Age'], errors='coerce'),
    'BMI': pd.to_numeric(df['BMI'], errors='coerce'),
    'Gender_Male': df['Gender'].eq('Male').astype(float), # Female=0 reference
})
keep = X.notna().all(axis=1)
X, y = X[keep], y[keep]
print(f"Outcome counts (1=PR): {y.value_counts().to_dict()} | n={len(y)}")

Xc = sm.add_constant(X)
with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter("always")
    model = sm.Logit(y, Xc).fit(disp=0, method='newton', maxiter=200)
    msgs = [str(w.message) for w in wlist]

print("\nConverged:", model.mle_retvals['converged'],
      "| iterations:", model.mle_retvals['iterations'])
print("Warnings:", msgs if msgs else "none")
print("Fitted prob range:", round(model.predict(Xc).min(), 4), "-",
      round(model.predict(Xc).max(), 4))
print("Max |coef|:", round(np.abs(model.params).max(), 4),
      "| max SE:", round(model.bse.max(), 4))

res = pd.DataFrame({
    'coef': model.params, 'se': model.bse, 'z': model.tvalues,
    'p_value': model.pvalues, 'odds_ratio': np.exp(model.params),
})
pd.set_option('display.float_format', lambda v: f"{v:.6g}")
print("\n=== Full model summary table (PR ~ Age + BMI + Gender_Male) ===")
print(res.to_string())
print(f"\nModel fit: llf={model.llf:.4f}, LRT p={model.llr_pvalue:.6g}, "
      f"pseudo-R2={model.prsquared:.4f}, nobs={int(model.nobs)}")

a = model.params['Age']; se = model.bse['Age']; pv = model.pvalues['Age']
print(f"\n>>> AGE: coef={a:.6f}  SE={se:.6f}  z={model.tvalues['Age']:.6f}  "
      f"OR={np.exp(a):.6f}  p={pv:.6g}")

# ---- Sensitivity: drop SD, fit PR vs PD only (NOT the headline answer) ----
sub = df[df['Efficacy'].isin(['PR', 'PD'])].reset_index(drop=True)
ys = sub['Efficacy'].eq('PR').astype(float)
Xs = pd.DataFrame({'Age': pd.to_numeric(sub['Age'], errors='coerce'),
                   'BMI': pd.to_numeric(sub['BMI'], errors='coerce'),
                   'Gender_Male': sub['Gender'].eq('Male').astype(float)})
ks = Xs.notna().all(axis=1)
ms = sm.Logit(ys[ks], sm.add_constant(Xs[ks])).fit(disp=0)
print(f"\n[Sensitivity PR vs PD only, n={int(ks.sum())}] Age p="
      f"{ms.pvalues['Age']:.6g} (coef={ms.params['Age']:.4f}) "
      "- main answer remains the agreed SD=0 model.")

with open('answer_age_pvalue.txt', 'w') as f:
    f.write(f"{pv:.6g}\n")
