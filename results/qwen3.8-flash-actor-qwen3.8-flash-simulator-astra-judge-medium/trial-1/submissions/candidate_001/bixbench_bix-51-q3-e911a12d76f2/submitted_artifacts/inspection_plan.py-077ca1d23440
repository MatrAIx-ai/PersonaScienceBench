# BixBench bix-51-q3 -- INPUT INSPECTION (plan stage; no final model fitting yet)
# Question: p-value for Age in combined logistic regression (BMI + Age + Gender)
#           predicting treatment response (PR) .
import pandas as pd

df = pd.read_excel('data/data.xlsx')
print("Raw shape:", df.shape, "| sheets: Sheet1")

# Drop fully/partially blank trailing rows (only a whitespace 'Age' cell remains)
df = df.dropna(how='all')
df = df[df['Efficacy'].notna()].reset_index(drop=True)
print("Valid analysis rows:", df.shape)

# Proposed encoding (NOT yet fitted):
y = df['Efficacy'].eq('PR').astype(int)             # PR=1 ; SD,PD=0
X = pd.DataFrame({
    'Age': pd.to_numeric(df['Age'], errors='coerce'),
    'BMI': pd.to_numeric(df['BMI'], errors='coerce'),
    'Gender_Male': df['Gender'].eq('Male').astype(int),
})
complete = X.dropna()
print("Outcome counts:", y[X.notna().all(axis=1).values].value_counts().to_dict())
print("Complete cases for model:", len(complete))
print("Crosstab Groups x Efficacy:\n", pd.crosstab(df['Groups'], df['Efficacy']))
