"""
BixBench bix-51-q4: logistic regression of remission on Age + BMI + Gender.

Primary (approved) outcome coding -- ASSUMPTION, not data-proven:
    remission = 1 if Efficacy == 'PR' (response), else 0 (SD + PD).
Gender dummy: Female = 0 (reference), Male = 1. Age, BMI kept continuous.
Rows: 41 trailing blank rows dropped -> n = 80. MLE logit, main effects only.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

DATA = "data/data.xlsx"

raw = pd.read_excel(DATA, sheet_name="Sheet1")
print(f"raw shape: {raw.shape}")

df = raw.dropna(subset=["Efficacy", "Age", "BMI", "Gender"]).copy()
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
df["BMI"] = pd.to_numeric(df["BMI"], errors="coerce")
print(f"analysis rows: {len(df)}")
print("missing in model vars:\n", df[["Efficacy", "Age", "BMI", "Gender"]].isna().sum().to_string())
print("Efficacy counts:\n", df["Efficacy"].value_counts().to_string())

# ---- primary coding: PR = 1 (remission), SD/PD = 0
df["remission"] = (df["Efficacy"].str.strip() == "PR").astype(int)
df["Male"] = (df["Gender"].str.strip() == "Male").astype(int)   # Female = reference
print(f"events (remission=1): {int(df.remission.sum())}, non-events: {int((1-df.remission).sum())}")

X = sm.add_constant(df[["Age", "BMI", "Male"]].astype(float))
model = sm.Logit(df["remission"].astype(float), X)
res = model.fit(disp=0, method="newton", maxiter=200)
print(res.summary())

ci = res.conf_int(alpha=0.05)
tab = pd.DataFrame({
    "coef": res.params, "SE": res.bse, "z": res.tvalues,
    "p": res.pvalues, "ci_low": ci[0], "ci_high": ci[1], "OR": np.exp(res.params),
    "OR_low": np.exp(ci[0]), "OR_high": np.exp(ci[1]),
})
print("\n=== coefficient table (primary: PR vs SD+PD) ===")
print(tab.round(4).to_string())

a = res.params["Age"]
print("\n--- PRIMARY ANSWER ---")
print(f"Age log-odds change per +1 year = {a:.6f}  (SE={res.bse['Age']:.4f}, "
      f"z={res.tvalues['Age']:.3f}, p={res.pvalues['Age']:.5g}, "
      f"95% CI [{ci.loc['Age',0]:.4f}, {ci.loc['Age',1]:.4f}], OR={np.exp(a):.4f})")
print(f"converged={res.mle_retvals['converged']}, iters={res.mle_retvals['iterations']}, "
      f"n={int(res.nobs)}, loglik={res.llf:.4f}, llnull={res.llnull:.4f}, "
      f"pseudo_R2(McFadden)={res.prsquared:.4f}, LR p={res.llr_pvalue:.5g}")
print(f"max |coef| = {res.params.abs().max():.3f} (separation check)")

# ---- sensitivity: PR+SD (disease control) vs PD  -- NOT primary
alt = df.copy()
alt["remission_dc"] = alt["Efficacy"].str.strip().isin(["PR", "SD"]).astype(int)
Xa = sm.add_constant(alt[["Age", "BMI", "Male"]].astype(float))
ra = sm.Logit(alt["remission_dc"].astype(float), Xa).fit(disp=0, method="newton", maxiter=200)
cia = ra.conf_int()
print("\n=== sensitivity (NOT primary): PR+SD vs PD ===")
print(f"Age coef = {ra.params['Age']:.6f} (SE={ra.bse['Age']:.4f}, p={ra.pvalues['Age']:.5g}, "
      f"95% CI [{cia.loc['Age',0]:.4f}, {cia.loc['Age',1]:.4f}], OR={np.exp(ra.params['Age']):.4f}); "
      f"n={int(ra.nobs)}, events={int(alt.remission_dc.sum())}, converged={ra.mle_retvals['converged']}")
