"""
BixBench bix-51-q5
Question: "Using a logistic regression model, what is the p-value for evaluating the
null hypothesis that BMI is not associated with treatment response?"

Deliverable per researcher approval:
  HEADLINE   : unadjusted logistic regression of binary response on continuous BMI.
               Answer = Wald z p-value on the BMI coefficient; LR (1 df) as concordance.
  SENSITIVITY: (a) BMI in quartiles, joint LR test; (b) 4-covariate adjusted model
               (age, gender, ECOG-PS, Child-Pugh); Groups EXCLUDED (complete separation).
  DIAGNOSTICS: convergence/separation checks, observed vs predicted response by BMI quartile.

Reproducible end-to-end from data/data.xlsx. Read-only inspection: analysis/inspect_data.py
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

pd.set_option("display.width", 200)
PATH = "data/data.xlsx"
BAR = "=" * 78


def head(t):
    print("\n" + BAR + f"\n{t}\n" + BAR)


# ---------------------------------------------------------------- 1. CLEANING
head("1. LOAD + CLEAN")
raw = pd.read_excel(PATH, sheet_name="Sheet1")
print(f"parsed shape: {raw.shape}")

named = [c for c in raw.columns if not str(c).startswith("Unnamed")]
dropped = [c for c in raw.columns if c not in named]
df = raw[named].copy()
print(f"dropped {len(dropped)} trailing columns (verified empty in inspection)")

n_before = len(df)
df = df[df["Sequence number"].notna()].copy()
print(f"dropped {n_before - len(df)} non-record rows (blank tail + stray ' ' at D122) "
      f"-> analytic N = {len(df)}")

df["response"] = (df["Efficacy"].str.strip() == "PR").astype(int)   # 1=PR, 0=SD/PD
ecog = df["ECOG-PS"].astype(str).str.strip()                        # mixed int/str column
assert set(ecog.unique()) == {"0-1", "2"}, ecog.unique()
df["ecog2"] = (ecog == "2").astype(int)
df["female"] = (df["Gender"].str.strip() == "Female").astype(int)
df["childB"] = (df["Child-Pugh"].str.strip() == "B").astype(int)
df["age"] = pd.to_numeric(df["Age"])

print(f"response coding counts: {df['response'].value_counts().to_dict()}")
print(f"missing in analytic frame: "
      f"{df[['response','BMI','age','female','ecog2','childB']].isna().sum().sum()}")
print(f"BMI: n={df['BMI'].notna().sum()} mean={df['BMI'].mean():.3f} sd={df['BMI'].std():.3f} "
      f"min={df['BMI'].min()} max={df['BMI'].max()} unique={df['BMI'].nunique()}")
print("\nBMI by outcome group (descriptive):")
print(df.groupby("response")["BMI"].agg(["count", "mean", "std", "min", "max"]).round(3).to_string())
n_ev = int(df["response"].sum()); n_nev = int((1 - df["response"]).sum())
print(f"events={n_ev} non-events={n_nev} -> EPV unadjusted (1 term) = {min(n_ev, n_nev)}")


def fit(X, y, label):
    """Logit by MLE; capture every warning and record convergence/separation diagnostics."""
    X = sm.add_constant(X)
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        res = sm.Logit(y, X).fit(disp=0, method="newton", maxiter=200)
    msgs = [f"{x.category.__name__}: {x.message}" for x in w]
    # NOTE: for Logit, res.fittedvalues is the LINEAR PREDICTOR (log-odds);
    # separation / calibration checks need predicted PROBABILITIES from res.predict().
    mu = np.asarray(res.predict(), dtype=float)
    diag = {"label": label, "convered": bool(res.mle_retvals["converged"]),
            "iters": int(res.mle_retvals["iterations"]), "n_warn": len(msgs),
            "warnings": sorted(set(msgs)), "n_warn_unique": len(set(msgs)),
            "max_se": float(res.bse.max()),
            "max_abs_coef": float(np.abs(res.params.drop("const")).max()),
            "fitted_min": float(mu.min()), "fitted_max": float(mu.max()),
            "perfect_fit_cells": int(((mu < 1e-6) | (mu > 1 - 1e-6)).sum()),
            "max_abs_dev_y_mu": float(np.abs(mu - res.model.endog).max()),
            "llf": float(res.llf), "llnull": float(res.llnull)}
    print(f"\n[{label}] converged={diag['convered']} iters={diag['iters']} "
          f"warnings={diag['n_warn']} max_SE={diag['max_se']:.4f} "
          f"max|beta|={diag['max_abs_coef']:.4f} fitted_p=[{diag['fitted_min']:.4f},"
          f"{diag['fitted_max']:.4f}] boundary_cells={diag['perfect_fit_cells']}")
    for m in sorted(set(msgs)):
        print(f"    WARNING x{msgs.count(m)} -> {m[:110]}")
    return res, diag


# ------------------------------------------- 2. HEADLINE: UNADJUSTED BMI MODEL
head("2. HEADLINE (THE ANSWER): UNADJUSTED logistic regression  response ~ BMI")
y = df["response"]
X_u = df[["BMI"]]
unadj, d_u = fit(X_u, y, "unadjusted BMI")
print("\n", unadj.summary2().tables[1].to_string())

beta = float(unadj.params["BMI"]); se = float(unadj.bse["BMI"])
z = float(unadj.tvalues["BMI"]); p_wald = float(unadj.pvalues["BMI"])
lo, hi = unadj.conf_int().loc["BMI"]
lr_stat = 2.0 * (unadj.llf - unadj.llnull)
p_lr = float(stats.chi2.sf(lr_stat, df=1))
p_llr_sm = float(unadj.llr_pvalue)          # statsmodels' own LR p-value
mu_u = np.asarray(unadj.predict(), dtype=float)
# Independent score test on the SAME null. It must be evaluated at the RESTRICTED
# (intercept-only) MLE, not at the full MLE, where the score is zero by construction.
null_res, _ = fit(pd.DataFrame(index=df.index), y, "intercept-only (null)")
pi0 = float(np.asarray(null_res.predict(), dtype=float)[0])
xb = df["BMI"].to_numpy() - df["BMI"].to_numpy().mean()
score_u = float((xb * (y.to_numpy() - pi0)).sum())
info_u = float((xb ** 2 * pi0 * (1 - pi0)).sum())
chi2_score = score_u ** 2 / info_u
p_score = float(stats.chi2.sf(chi2_score, df=1))

print(f"\nIntercept (log-odds at BMI=0) = {float(unadj.params['const']):.6f} "
      f"(SE {float(unadj.bse['const']):.4f})")
print(f"Beta_BMI (log-odds per 1 kg/m2) = {beta:.6f}   SE = {se:.6f}")
print(f"OR per 1 kg/m2 = {np.exp(beta):.6f}  95% CI [{np.exp(lo):.6f}, {np.exp(hi):.6f}]")
print(f"Wald z = {z:.6f}      Wald p = {p_wald:.6g}   <-- PRIMARY / THE ANSWER")
print(f"LR chi2(1) = {lr_stat:.6f}   LR p = {p_lr:.6g}   "
      f"(statsmodels llr_pvalue = {p_llr_sm:.6g})")
print(f"Score test (at restricted MLE, pi0={pi0:.4f}) chi2(1) = "
      f"{chi2_score:.6f}   p = {p_score:.6g}")
print(f"McFadden pseudo-R2 = {unadj.prsquared:.6f}  loglik = {unadj.llf:.4f}  "
      f"null loglik = {unadj.llnull:.4f}  n = {int(unadj.nobs)}")
print(f"\n>>> ANSWER: Wald p-value for BMI = {p_wald:.4g}  ->  "
      f"{'REJECT' if p_wald < 0.05 else 'DO NOT REJECT'} the BMI null at alpha = 0.05; "
      f"direction: {'positive' if beta > 0 else 'inverse'}")
same_decision = (p_wald < 0.05) == (p_lr < 0.05)
rel = abs(p_wald - p_lr) / p_wald
print(f">>> Wald vs LR: p {p_wald:.6g} vs {p_lr:.6g}; abs diff = {abs(p_wald - p_lr):.3g} "
      f"({100*rel:.1f}% relative); same 0.05 decision = {same_decision} -> "
      f"{'CONCORDANT (small-sample Wald/LR curvature only)' if same_decision and rel < 0.25 else 'MATERIAL DISAGREEMENT - report both'}")

glm = sm.GLM(y, sm.add_constant(X_u), family=sm.families.Binomial()).fit()
print(f"GLM/IRLS cross-check (different optimiser): beta={float(glm.params['BMI']):.6f} "
      f"z={float(glm.tvalues['BMI']):.6f} p={float(glm.pvalues['BMI']):.6g}")


# ---------------------------------------- 3. SENSITIVITY (a): BMI IN QUARTILES
head("3. SENSITIVITY (a): BMI as QUARTILES - joint LR test + linearity diagnostics")
df["bmi_q"] = pd.qcut(df["BMI"], 4, labels=False, duplicates="drop")
print("quartile bins (data-derived):\n",
      df.groupby("bmi_q")["BMI"].agg(["min", "max", "count"]).round(2).to_string())
qdm = pd.get_dummies(df["bmi_q"], prefix="q", drop_first=True).astype(float)
print("design columns:", list(qdm.columns))
qres, d_q = fit(qdm, y, "BMI quartiles")
print("\n", qres.summary2().tables[1].to_string())
kq = len(qdm.columns)
lr_q = 2.0 * (qres.llf - unadj.llnull); p_lr_q = float(stats.chi2.sf(lr_q, df=kq))
lr_nl = 2.0 * (qres.llf - unadj.llf); df_nl = kq - 1
p_nl = float(stats.chi2.sf(lr_nl, df=df_nl))
print(f"\nJoint LR (quartiles vs intercept-only), df={kq}: chi2={lr_q:.6f} p={p_lr_q:.6g} "
      f"[SENSITIVITY, not the answer]")
print(f"Non-linearity LR (quartiles vs linear BMI), df={df_nl}: chi2={lr_nl:.6f} p={p_nl:.6g}")

print("\nObserved vs predicted response rate by BMI quartile "
      "(predictions from the UNADJUSTED linear model):")
df["pred"] = mu_u
tab = df.groupby("bmi_q").agg(n=("response", "size"), bmi_mean=("BMI", "mean"),
                              bmi_min=("BMI", "min"), bmi_max=("BMI", "max"),
                              observed_resp=("response", "sum"),
                              observed_rate=("response", "mean"),
                              predicted_rate=("pred", "mean"))
tab["bmi_mean"] = tab["bmi_mean"].round(2)
tab["observed_rate"] = tab["observed_rate"].round(4)
tab["predicted_rate"] = tab["predicted_rate"].round(4)
print(tab.to_string())
hl = float((((tab["observed_resp"] - tab["n"] * tab["predicted_rate"]) ** 2)
            / (tab["n"] * tab["predicted_rate"] * (1 - tab["predicted_rate"]))).sum())
print(f"Hosmer-Lemeshow-style chi2 over 4 quartile groups = {hl:.4f}, df=4 -> "
      f"p = {float(stats.chi2.sf(hl, df=4)):.4g} (approximate; only 4 groups)")

Xq = df[["BMI"]].copy(); Xq["BMI2"] = df["BMI"] ** 2
qfit, d_q2 = fit(Xq, y, "BMI + BMI^2")
print(f"\nQuadratic probe: BMI^2 beta={float(qfit.params['BMI2']):.6g} "
      f"Wald p={float(qfit.pvalues['BMI2']):.6g}; BMI in quadratic model "
      f"beta={float(qfit.params['BMI']):.6g} p={float(qfit.pvalues['BMI']):.6g}")


# ------------------------- 4. SENSITIVITY (b): ADJUSTED MODEL (Groups excluded)
head("4. SENSITIVITY (b): ADJUSTED  response ~ BMI + age + female + ecog2 + childB")
X_a = df[["BMI", "age", "female", "ecog2", "childB"]]
adj, d_a = fit(X_a, y, "adjusted 4 covariates")
print("\n", adj.summary2().tables[1].to_string())
ba = float(adj.params["BMI"]); pa = float(adj.pvalues["BMI"])
alo, ahi = adj.conf_int().loc["BMI"]
adj_nobmi, _ = fit(X_a.drop(columns=["BMI"]), y, "adjusted WITHOUT BMI (nested null)")
lr_a = 2.0 * (adj.llf - adj_nobmi.llf); p_lr_a = float(stats.chi2.sf(lr_a, 1))
print(f"\nBMI in adjusted model: beta={ba:.6f} (SE {float(adj.bse['BMI']):.6f}) "
      f"OR={np.exp(ba):.4f} 95% CI [{np.exp(alo):.4f}, {np.exp(ahi):.4f}]")
print(f"Wald z={float(adj.tvalues['BMI']):.6f}  Wald p={pa:.6g} | partial LR chi2(1)={lr_a:.6f} "
      f"p={p_lr_a:.6g}   [SENSITIVITY, not the answer]")
print(f"adjusted McFadden R2={adj.prsquared:.4f}; params={X_a.shape[1]+1}; "
      f"EPV={min(n_ev, n_nev)/(X_a.shape[1]+1):.1f}")

head("4b. EVIDENCE FOR EXCLUDING 'Groups' (demonstrated, not assumed)")
gres, d_g = fit(df[["BMI", "Groups"]], y, "BMI + Groups (ILL-POSED)")
print(f"Groups beta={float(gres.params['Groups']):.4f} SE={float(gres.bse['Groups']):.4f} "
      f"Wald p={float(gres.pvalues['Groups']):.4g}: the arm coefficient diverges to the "
      f"log-odds boundary and its SE explodes to ~{d_g['max_se']:.0f}, i.e. the parameter is "
      f"numerically non-identified. Adjusting for arm is therefore meaningless here; the "
      f"apparent BMI term in this ill-posed fit must NOT be used.")


# --------------------------------- 5. DIAGNOSTIC SUMMARY + ASSUMPTION AUDIT
head("5. DIAGNOSTIC SUMMARY / ASSUMPTION AUDIT (A1-A6)")
rows = [dict(model=d["label"], converged=d["convered"], iters=d["iters"], n_warnings=d["n_warn"],
             max_SE=round(d["max_se"], 4), max_abs_beta=round(d["max_abs_coef"], 4),
             fitted_p_min=round(d["fitted_min"], 6), fitted_p_max=round(d["fitted_max"], 6),
             boundary_cells=d["perfect_fit_cells"])
        for d in (d_u, d_q, d_a, d_q2, d_g)]
print(pd.DataFrame(rows).to_string(index=False))
print(f"\nA1 binary collapse PR vs SD/PD applied -> {n_ev} vs {n_nev} events")
print(f"A2 analytic N = {len(df)} (Sequence-numbered rows only)")
print(f"A3 BMI continuous (kg/m2), linear term primary: linear Wald p={p_wald:.4g}, "
      f"non-linearity p={p_nl:.4g} -> "
      f"{'no evidence against linearity' if p_nl > .05 else 'NON-LINEARITY SUGGESTED - flag'}")
print(f"A4 one row = one patient: unique ids {df['Sequence number'].nunique()}/{len(df)}")
print("A5 Groups excluded (complete separation demonstrated in 4b)")
print(f"A6 Wald primary={p_wald:.6g} vs LR={p_lr:.6g} vs GLM/IRLS="
      f"{float(glm.pvalues['BMI']):.6g} vs score={p_score:.6g}")

print("\n" + BAR + "\nFINAL QUOTED ANSWER\n" + BAR)
print("Unadjusted logistic regression, N=80, response = 1 if Efficacy=='PR' else 0 "
      "(SD/PD), single predictor = continuous BMI (kg/m2):")
print(f"  Wald p-value for BMI = {p_wald:.4g}    "
      f"[LR chi2(1) = {lr_stat:.4f}, p = {p_lr:.4g}]")
print(f"  beta_BMI = {beta:.4f} log-odds per kg/m2 (SE {se:.4f}); "
      f"OR = {np.exp(beta):.3f} (95% CI {np.exp(lo):.3f}-{np.exp(hi):.3f}); "
      f"intercept = {float(unadj.params['const']):.4f}")
print(f"  BMI null {'REJECTED' if p_wald < 0.05 else 'NOT rejected'} at the 0.05 level; "
      f"{'higher BMI -> higher odds of response' if beta > 0 else 'higher BMI -> lower odds of response'}.")

pd.DataFrame([
    dict(model="unadjusted BMI (HEADLINE)", term="BMI (1 df)", beta=beta, se=se, OR=np.exp(beta),
         ci_lo=np.exp(lo), ci_hi=np.exp(hi), z=z, p_wald=p_wald, p_lr=p_lr),
    dict(model="BMI quartiles (sensitivity)", term="BMI (3 df)", beta=np.nan, se=np.nan, OR=np.nan,
         ci_lo=np.nan, ci_hi=np.nan, z=np.nan, p_wald=np.nan, p_lr=p_lr_q),
    dict(model="non-linearity: linear vs quartiles", term="BMI nonlin (2 df)", beta=np.nan,
         se=np.nan, OR=np.nan, ci_lo=np.nan, ci_hi=np.nan, z=np.nan, p_wald=np.nan, p_lr=p_nl),
    dict(model="adjusted +age+female+ecog2+childB (sensitivity)", term="BMI (1 df)", beta=ba,
         se=float(adj.bse["BMI"]), OR=np.exp(ba), ci_lo=np.exp(alo), ci_hi=np.exp(ahi),
         z=float(adj.tvalues["BMI"]), p_wald=pa, p_lr=p_lr_a),
]).to_csv("analysis/results_table.csv", index=False)
tab.to_csv("analysis/quartile_calibration.csv")
print("\nwrote analysis/results_table.csv and analysis/quartile_calibration.csv")


# ------------------- 6. INDEPENDENT CROSS-CHECKS OF THE HEADLINE CONCLUSION ---
head("6. INDEPENDENT CROSS-CHECKS (not alternative specifications of the answer)")
b1 = df.loc[df["response"] == 1, "BMI"]; b0 = df.loc[df["response"] == 0, "BMI"]
tt = stats.ttest_ind(b1, b0, equal_var=False)
mw = stats.mannwhitneyu(b1, b0, alternative="two-sided")
print(f"mean BMI responders {b1.mean():.3f} (SD {b1.std():.3f}, n={b1.size}) vs "
      f"non-responders {b0.mean():.3f} (SD {b0.std():.3f}, n={b0.size}); "
      f"diff = {b1.mean()-b0.mean():.3f} kg/m2")
print(f"  Welch t-test p = {tt.pvalue:.6g}  |  Mann-Whitney p = {mw.pvalue:.6g} "
      f"-> both {'>' if tt.pvalue > 0.05 else '<'} 0.05, consistent with Wald p = {p_wald:.4g}")
# manual profile-likelihood CI (statsmodels conf_int() has no profile option here)
from scipy.optimize import minimize_scalar, brentq
_x = df["BMI"].to_numpy(); _y = y.to_numpy(); _llmax = float(unadj.llf)
def prof_ll(b):
    nll = lambda a: -float((_y * (a + b * _x) - np.logaddexp(0.0, a + b * _x)).sum())
    return -minimize_scalar(nll, bounds=(-20, 20), method="bounded").fun
target = _llmax - stats.chi2.ppf(0.95, 1) / 2.0
lo_p = brentq(lambda b: prof_ll(b) - target, beta - 3, beta)
hi_p = brentq(lambda b: prof_ll(b) - target, beta, beta + 3)
print(f"profile-likelihood 95% CI for beta_BMI = [{lo_p:.6f}, {hi_p:.6f}] -> OR "
      f"[{np.exp(lo_p):.4f}, {np.exp(hi_p):.4f}]; excludes 0 on log scale = "
      f"{lo_p > 0 or hi_p < 0}  (Wald CI was [{lo:.6f}, {hi:.6f}])")
# lowest p across all three asymptotic tests on the same null
print(f"spread of the three tests on the same null: Wald {p_wald:.4g}, "
      f"LR {p_lr:.4g}, score {p_score:.4g}; "
      f"all {'>0.05 (consistent: do not reject)' if min(p_wald, p_lr, p_score) > 0.05 else 'straddle 0.05 - report the Wald value and flag'}")
print("\nNOTE ON OUTCOME GRANULARITY (limitation, per approval): Efficacy is a 3-level "
      "ordinal (PR 41 / SD 17 / PD 22); collapsing SD+PD into one non-response class is "
      "required for a binary logistic model and discards the SD-vs-PD distinction.")


# --------------- 7. IMPLEMENTATION-INDEPENDENT VERIFICATION OF THE ANSWER ------
head("7. HAND-ROLLED NEWTON VERIFICATION (guards against a library/typo error)")
from scipy.optimize import minimize
Xd = np.column_stack([np.ones(len(df)), df["BMI"].to_numpy()])
yv = y.to_numpy()
def nll(th):
    e = Xd @ th
    return float((np.logaddexp(0.0, e) - yv * e).sum())
opt = minimize(nll, x0=np.zeros(2), jac=lambda th: -(Xd.T @ (yv - 1/(1+np.exp(-(Xd @ th))))),
               method="BFGS", tol=1e-12)
mu = 1/(1+np.exp(-(Xd @ opt.x)))
cov = np.linalg.inv(Xd.T @ np.diag(mu * (1 - mu)) @ Xd)      # observed information inverse
b_ind, se_ind = opt.x[1], np.sqrt(cov[1, 1])
z_ind = b_ind / se_ind; p_ind = float(2 * stats.norm.sf(abs(z_ind)))
print(f"hand-rolled Newton/Fisher-scoring MLE: beta={b_ind:.8f} SE={se_ind:.8f} "
      f"z={z_ind:.8f} p={p_ind:.8g}")
print(f"statsmodels:                          beta={beta:.8f} SE={se:.8f} "
      f"z={z:.8f} p={p_wald:.8g}")
print(f"max abs discrepancy = {max(abs(b_ind-beta), abs(se_ind-se), abs(p_ind-p_wald)):.3g} "
      f"-> {'matches; the quoted Wald p-value is implementation-independent' if abs(p_ind-p_wald) < 1e-8 else 'MISMATCH - investigate'}")
print(f"null deviance = {2*(-unadj.llnull):.4f}, residual deviance = {-2*unadj.llf:.4f}, "
      f"deviance drop = {lr_stat:.4f} on 1 df (equals LR chi2 above)")

print("\n" + BAR)
print(f"DELIVERABLE SUMMARY -- HEADLINE ANSWER: Wald p = {p_wald:.4g} "
      f"(beta={beta:.4f}, SE={se:.4f}, OR={np.exp(beta):.3f}, 95% CI "
      f"{np.exp(lo):.3f}-{np.exp(hi):.3f}); BMI null NOT rejected at 0.05; "
      f"positive (inverse-BMI-lower-response) direction.")
print(BAR)
