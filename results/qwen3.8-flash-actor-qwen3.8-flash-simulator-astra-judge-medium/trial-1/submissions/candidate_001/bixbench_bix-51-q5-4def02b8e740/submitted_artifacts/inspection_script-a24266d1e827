"""Read-only inspection of data/data.xlsx (Sheet1) for the BMI / treatment-response
logistic-regression question. NO MODEL IS FIT HERE and no p-value is produced.

Checks: header cells (incl. unnamed trailing ones), shape, dtypes, per-column
distinct values & counts, missingness, BMI storage/sentinels, Efficacy coding level
count, response/non-response event counts, and Efficacy x Groups confounding.
"""
import openpyxl
import pandas as pd

PATH = "data/data.xlsx"
pd.set_option("display.width", 250)

# --- 1. raw worksheet geometry -------------------------------------------------
wb = openpyxl.load_workbook(PATH, data_only=True)
ws = wb["Sheet1"]
print("sheet range:", ws.dimensions, "| rows:", ws.max_row, "| cols:", ws.max_column)
named = [(c.coordinate, c.value) for c in ws[1] if c.value is not None]
unnamed = [(c.coordinate, c.value) for c in ws[1] if c.value is None]
print("named header cells:", len(named), [v for _, v in named])
print("blank header cells:", len(unnamed), [co for co, _ in unnamed])
stray = [(c.coordinate, repr(c.value))
         for row in ws.iter_rows(min_row=1, max_row=ws.max_row, min_col=len(named) + 1)
         for c in row if c.value is not None and str(c.value).strip() != ""]
print("non-empty cells in unnamed columns:", len(stray), stray)
odd = [(c.coordinate, repr(c.value))
       for row in ws.iter_rows(min_row=len(named) + 2, max_row=ws.max_row)
       for c in row if c.value is not None and str(c.value).strip() == ""]
print("whitespace-only cells in data area:", odd)

# --- 2. parsed frame ----------------------------------------------------------
raw = pd.read_excel(PATH, sheet_name="Sheet1")
print("\nparsed shape:", raw.shape)
print("dtypes:\n", raw.dtypes.to_string())
df = raw[raw["Sequence number"].notna()].copy()
print("\nanalytic N (rows with Sequence number):", len(df),
      "| seq range:", df["Sequence number"].min(), df["Sequence number"].max(),
      "| unique:", df["Sequence number"].nunique(), "| dup rows:", df.duplicated().sum())

# --- 3. distinct values & counts ---------------------------------------------
for col in ["Efficacy", "BMI", "Age", "Groups", "Gender", "Family history",
            "ECOG-PS", "Child-Pugh", "Chemotherapy experience", "HBV infection",
            "Toxic and side effect"]:
    print(f"\n=== {col} === dtype={df[col].dtype} missing={df[col].isna().sum()} "
          f"pytypes={df[col].map(type).value_counts().to_dict()}")
    vc = df[col].value_counts(dropna=False)
    print(vc.to_string() if len(vc) <= 25 else f"{len(vc)} distinct values\n" + vc.describe().to_string())

# --- 4. missingness -----------------------------------------------------------
print("\nmissingness, 80 valid rows:\n", df.isna().sum().to_string())
print("missingness, all parsed rows:\n", raw.isna().sum().to_string())

# --- 5. BMI storage diagnostics ----------------------------------------------
b = df["BMI"]
print("\nBMI describe:\n", b.describe().to_string())
print("distinct BMI:", b.nunique(), "| decimals seen:",
      sorted({len(str(x).split('.')[-1]) if '.' in str(x) else 0 for x in b}))
for s in [0, 99, 999, 9999]:
    print(f"  sentinel {s}: {(b == s).sum()}")
print("  n<10:", (b < 10).sum(), "| n>60:", (b > 60).sum(), "| n outside [15,40]:",
      ((b < 15) | (b > 40)).sum())

# --- 6. outcome coding & events-per-variable ---------------------------------
eff = sorted(df["Efficacy"].unique())
print("\nEfficacy distinct levels:", eff, "-> n levels =", len(eff))
resp = (df["Efficacy"] == "PR").astype(int)
print("binary response (PR=1 vs SD/PD=0): events =", int(resp.sum()),
      "| non-events =", int((1 - resp).sum()))
print("n covariates affordable at EPV>=10:", int(resp.sum() // 10), "or",
      int((1 - resp).sum() // 10))
print("\nEfficacy x Groups crosstab (confounding check):")
print(pd.crosstab(df["Efficacy"], df["Groups"], margins=True).to_string())
