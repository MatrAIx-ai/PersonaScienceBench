#!/usr/bin/env python3
"""
BixBench bix-52-q7 -- Zebra Finch: how many sites are removed when filtering out
sites that do NOT show >90% or <10% methylation?

Approved method (locked by researcher):
  * Scope: data/ZF_AgeRelated_CpG_noMT_Final.csv only.
      - data/JD_AgeRelated_CpG_noMT_Final.csv is a different cohort/species table -> out of scope
        for a "in Zebra Finch" question.
      - data/ZF_Chromosome_Length.csv and data/JD_Chromosome_Length.csv are byte-identical
        reference tables (diff => no differences) and are not needed for a site-count filter -> not joined.
  * Denominator = distinct sites keyed on Pos (Pos == Chromosome_StartPosition, Start==End).
  * Keep-rule: a site is KEPT if ANY of its per-sample rows has MethylationPercentage > 90 or < 10
    (STRICT inequalities). A site is REMOVED if no row of that site is extreme.
  * No coverage / read-depth filter, no chromosome join. Coverage profile printed as a caveat only.
"""
import hashlib
import numpy as np
import pandas as pd

DATA = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
HI, LO = 90.0, 10.0

def rule_counts(df, hi=HI, lo=LO):
    """Per-site any-row extreme rule -> (kept_mask indexed by site, kept, removed)."""
    ext = (df.MethylationPercentage > hi) | (df.MethylationPercentage < lo)
    kept = ext.groupby(df.Pos).any()
    return kept, int(kept.sum()), int((~kept).sum())

def main():
    zf = pd.read_csv(DATA)
    print("=" * 78)
    print("SCOPE")
    print("=" * 78)
    print(f"input file analysed      : {DATA}")
    print(f"sha256                   : {hashlib.sha256(open(DATA,'rb').read()).hexdigest()[:16]}")
    print("excluded inputs          : data/JD_AgeRelated_CpG_noMT_Final.csv (different cohort/species;")
    print("                             question is Zebra Finch only),")
    print("                           data/ZF_Chromosome_Length.csv + data/JD_Chromosome_Length.csv")
    print("                             (byte-identical 44-row reference tables; no join needed for a")
    print("                             per-site filtering-rule count)")

    # ---------- integrity guards ----------
    assert zf.isna().sum().sum() == 0, "unexpected NA values"
    den = zf.CountMethylated + zf.CountNonMethylated
    max_dev_mp = float((zf.MethylationPercentage - 100.0 * zf.CountMethylated / den).abs().max())
    assert max_dev_mp < 1e-6, f"MP not derivable from counts (max dev {max_dev_mp})"
    n_cov_mismatch = int((zf.Coverage != den).sum())
    assert n_cov_mismatch == 0, "Coverage != CountMethylated + CountNonMethylated"
    assert (zf.StartPosition == zf.EndPosition).all(), "Start != End somewhere"
    assert (zf.Pos == zf.Chromosome.astype(str) + "_" + zf.StartPosition.astype(str)).all(), \
        "Pos is not Chromosome_StartPosition"
    n_dup_site_sample = len(zf) - len(zf.drop_duplicates(["Pos", "Sample"]))
    assert n_dup_site_sample == 0, "duplicate (site, Sample) rows"
    print("\n" + "=" * 78)
    print("INTEGRITY GUARDS (all assertions passed)")
    print("=" * 78)
    print(f"NA cells                              : {int(zf.isna().sum().sum())}")
    print(f"max |MP - 100*CM/(CM+CNM)|            : {max_dev_mp:.3e}  (percent scale, <=8 stored decimals)")
    print(f"rows with Coverage != CM+CNM          : {n_cov_mismatch}")
    print(f"duplicate (Pos, Sample) rows          : {n_dup_site_sample}")
    print(f"zero-coverage rows                    : {int((zf.Coverage == 0).sum())}  (min coverage {int(zf.Coverage.min())})")
    print(f"MP range                              : {zf.MethylationPercentage.min()} .. {zf.MethylationPercentage.max()} (0-100 scale)")

    # ---------- (a) rows, (b) sites ----------
    n_rows = len(zf)
    n_sites = zf.Pos.nunique()
    print("\n" + "=" * 78)
    print("DENOMINATOR  (rows and sites are different objects - do not conflate)")
    print("=" * 78)
    print(f"(a) total rows (site x sample measurements) : {n_rows}")
    print(f"(b) total DISTINCT SITES (unique Pos)       : {n_sites}   <- denominator")
    print(f"    rows per site: min {int(zf.groupby('Pos').size().min())}, "
          f"median {zf.groupby('Pos').size().median():.0f}, max {int(zf.groupby('Pos').size().max())}; "
          f"samples={zf.Sample.nunique()}, SampleL groups={sorted(zf.SampleL.unique().tolist())}")

    # ---------- (c) kept, (d) removed = ANSWER ----------
    ext_row = (zf.MethylationPercentage > HI) | (zf.MethylationPercentage < LO)
    kept_mask, kept, removed = rule_counts(zf)
    print("\n" + "=" * 78)
    print("HEADLINE RULE: keep site if ANY row has MP > 90 OR MP < 10 (STRICT)")
    print("=" * 78)
    print(f"extreme rows (row-level)     : {int(ext_row.sum())} of {n_rows} rows "
          f"(> 90: {int((zf.MethylationPercentage > HI).sum())}, < 10: {int((zf.MethylationPercentage < LO).sum())})")
    print(f"(c) SITES KEPT               : {kept}")
    print(f"(d) SITES REMOVED = ANSWER   : {removed}   (= {n_sites} - {kept})")

    # ---------- (e) inclusive-boundary variant ----------
    n_eq10 = int((zf.MethylationPercentage == 10).sum())
    n_eq90 = int((zf.MethylationPercentage == 90).sum())
    bnd = zf[zf.MethylationPercentage.isin([10.0, 90.0])]
    assert bnd.Coverage.eq(10).all() and set(bnd.CountMethylated.tolist()) <= {1, 9}, \
        "boundary rows are not all coverage-10 9:1 splits"
    # inclusive rule == strict rule on the band-complement using >=90 / <=10
    ext_inc = (zf.MethylationPercentage >= HI) | (zf.MethylationPercentage <= LO)
    kept_inc = ext_inc.groupby(zf.Pos).any()
    print("\n" + "=" * 78)
    print("(e) BOUNDARY SENSITIVITY (inclusive >= 90 / <= 10)")
    print("=" * 78)
    print(f"rows exactly == 10.0 : {n_eq10}   rows exactly == 90.0 : {n_eq90}   "
          f"(total {len(bnd)} boundary rows, all coverage == 10 with a 9:1 methylated:unmethylated read split)")
    print(f"inclusive rule       : kept {int(kept_inc.sum())}, removed {int((~kept_inc).sum())}"
          f"   -> {int((~kept_inc).sum()) - removed:+d} vs strict headline")

    # ---------- (h) sites holding BOTH a >90 and a <10 row ----------
    hi_site = (zf.MethylationPercentage > HI).groupby(zf.Pos).any()
    lo_site = (zf.MethylationPercentage < LO).groupby(zf.Pos).any()
    both = int((hi_site & lo_site).sum())
    print("\n" + "=" * 78)
    print("(h) WHY AN ANY-ROW RULE IS THE ONLY NON-DEGENERATE SITE RULE")
    print("=" * 78)
    print(f"sites with >=1 row > 90                 : {int(hi_site.sum())}")
    print(f"sites with >=1 row < 10                 : {int(lo_site.sum())}")
    print(f"sites with BOTH a >90 and a <10 row     : {both}  "
          "<- a site is bimodal across samples, so any site-level average can never be extreme")

    # ---------- (f) rejected alternates ----------
    smean = zf.groupby("Pos").MethylationPercentage.mean()
    smean_kept = int(((smean > HI) | (smean < LO)).sum())
    grp = zf.groupby(["Pos", "SampleL"]).MethylationPercentage.mean()
    sl_any = ((grp > HI) | (grp < LO)).groupby("Pos").any()
    sl_kept = int(sl_any.sum())
    all_rows = ext_row.groupby(zf.Pos).all()
    print("\n" + "=" * 78)
    print("(f) REJECTED ALTERNATE DECISION UNITS (printed for transparency)")
    print("=" * 78)
    print(f"site MEAN across samples > 90 / < 10 : kept {smean_kept}, removed {n_sites - smean_kept}"
          f"  (REJECTED: site means span only {smean.min():.2f}-{smean.max():.2f}%, so no site mean is "
          f"extreme -> degenerate 'remove everything' answer)")
    print(f"ANY SampleL age-pair MEAN extreme    : kept {sl_kept}, removed {n_sites - sl_kept}"
          f"  (REJECTED: collapses the 2 samples per pair, so single-sample extremes vanish; the question "
          f"is about sites that 'show' extremes, not about group means)")
    print(f"ALL rows of a site extreme           : kept {int(all_rows.sum())}, removed {n_sites - int(all_rows.sum())}"
          f"  (REJECTED: no site is extreme in every sample; would be a trivial answer)")
    print(f"row-level filter (not a site count)  : removed {n_rows - int(ext_row.sum())} of {n_rows} rows"
          f"  (REJECTED: question asks for SITES removed)")

    # ---------- (g) coverage caveat ----------
    ext_rows = zf[ext_row]
    print("\n" + "=" * 78)
    print("(g) COVERAGE CAVEAT / SENSITIVITY (NOT applied to the headline answer)")
    print("=" * 78)
    print(f"extreme rows: n = {len(ext_rows)}  coverage min {int(ext_rows.Coverage.min())}, "
          f"median {ext_rows.Coverage.median():.0f}, max {int(ext_rows.Coverage.max())}")
    print(f"  of those, coverage < 10 : {int((ext_rows.Coverage < 10).sum())}  "
          f"({100*(ext_rows.Coverage < 10).mean():.1f}%)   "
          f"coverage < 5 : {int((ext_rows.Coverage < 5).sum())}  ({100*(ext_rows.Coverage < 5).mean():.1f}%)")
    print(f"  all rows with coverage < 10 in the table: {int((zf.Coverage < 10).sum())} of {n_rows}")
    for thr in (10, 5):
        sub = zf[zf.Coverage >= thr]
        m = ((sub.MethylationPercentage > HI) | (sub.MethylationPercentage < LO)).groupby(sub.Pos).any()
        print(f"  sensitivity: pre-filter Coverage >= {thr}: kept {int(m.sum())}, "
              f"removed {n_sites - int(m.sum())} (sites still observed: {sub.Pos.nunique()})")
    print("  NOTE: the question is a filtering-rule count, so no depth filter is imposed on the headline.")

    print("\n" + "=" * 78)
    print(f"ANSWER: {removed} of the {n_sites} Zebra Finch CpG sites are removed "
          f"({kept} kept) under the strict >90%/<10% any-row site rule.")
    print("=" * 78)

    return dict(rows=n_rows, sites=n_sites, kept=kept, removed=removed,
                removed_inclusive=int((~kept_inc).sum()), sites_both=both)

if __name__ == "__main__":
    main()
