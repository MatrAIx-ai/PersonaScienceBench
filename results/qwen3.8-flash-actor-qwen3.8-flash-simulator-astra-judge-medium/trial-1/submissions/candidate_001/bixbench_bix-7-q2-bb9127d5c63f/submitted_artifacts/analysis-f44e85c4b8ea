"""BixBench bix-7-q2: average number of CHIP variants per sample after
filtering out intronic, intergenic, and UTR variants.

Primary rule (researcher-approved):
- carried = Zygosity in {Heterozygous, Homozygous Variant} (blank no-calls excluded)
- SO exclusion = substring rule on lowercase term(s): intron / utr / intergenic /
  upstream / downstream; a concatenated cell is excluded only if ALL terms excluded
- dedup within sample on (Chr:Pos, Ref/Alt)
- mean over all 86 samples (zero-count samples included in denominator)
"""
import glob, collections
import pandas as pd

FILES = sorted(glob.glob('/workspace/data/CHIP_DP10_GQ20_PASS/*.xlsx'))
EXCL_SUBSTR = ('intron', 'utr', 'intergenic', 'upstream', 'downstream')
EXACT_EXCL = {'intron_variant', '3_prime_UTR_variant', '5_prime_UTR_variant',
              'intergenic_region'}  # sensitivity only
CARRIED = {'Heterozygous', 'Homozygous Variant'}

def so_excluded(cell, exact=False):
    if pd.isna(cell):
        return False  # keep unknown annotation
    terms = [t.strip().lower() for t in str(cell).replace('&', ',').split(',') if t.strip()]
    if exact:
        return all(t in EXACT_EXCL for t in terms)
    return all(any(s in t for s in EXCL_SUBSTR) for t in terms)

rows = []
failed = []
raw_total = 0
for f in FILES:
    try:
        df = pd.read_excel(f, header=[0, 1])
    except Exception as e:
        failed.append((f, repr(e)))
        continue
    zc = [c for c in df.columns if c[1] == 'Zygosity'][0]
    sample = f.split('CHIP_')[-1].replace('.xlsx', '')
    assert sample == zc[0][zc[0].find('(') + 1:-1], f'ID mismatch {f}'
    sub = pd.DataFrame({
        'sample': sample,
        'chrpos': df[('Variant Info', 'Chr:Pos')],
        'refalt': df[('Variant Info', 'Ref/Alt')],
        'zyg': df[zc],
        'so': df[('RefSeq Genes 110, NCBI', 'Sequence Ontology (Combined)')],
    })
    raw_total += len(sub)
    rows.append(sub)
assert not failed, failed

allr = pd.concat(rows, ignore_index=True)
print('n files parsed OK:', len(rows), '| failed:', len(failed))
print('total rows before filtering:', raw_total)

# dedup within sample on (sample, chrpos, refalt)
dedup = allr.drop_duplicates(subset=['sample', 'chrpos', 'refalt'])
n_dupes = len(allr) - len(dedup)
print('exact within-sample duplicate rows removed:', n_dupes)

# zygosity filter
car = dedup[dedup['zyg'].isin(CARRIED)]
print('rows removed by zygosity filter (Reference/blank):', len(dedup) - len(car))
print('carried rows after zygosity filter:', len(car))

# SO filter (primary substring rule)
excl_mask = car['so'].map(so_excluded)
kept = car[~excl_mask]
print('rows removed by SO filter (primary substring rule):', int(excl_mask.sum()))
print('kept rows total:', len(kept))
print('\nExcluded SO terms and totals (among carried rows):')
for term, n in car.loc[excl_mask, 'so'].value_counts().items():
    print(f'  {n:5d}  {term}')
print('\nKept SO terms (among carried rows):')
for term, n in kept['so'].value_counts().items():
    print(f'  {n:5d}  {term}')

# per-sample counts, denominator = all samples parsed
counts = kept.groupby('sample').size().reindex([r['sample'].iloc[0] for r in rows if False] or
        sorted(set(allr['sample'])), fill_value=0)
print('\n--- per-sample kept variant counts ---')
print(counts.to_string())
n = len(counts)
mean = counts.mean()
print(f'\nn samples: {n}')
print(f'per-sample min/median/max: {counts.min()} / {counts.median()} / {counts.max()}')
print(f'SD (sample): {counts.std(ddof=1):.3f}   range: {counts.max()-counts.min()}')
print(f'zero-count samples: {(counts==0).sum()} -> list: {list(counts[counts==0].index)}')
print(f'PRIMARY ANSWER mean kept variants per sample: {mean:.4f}')

# --- sensitivities (not headline) ---
kept_exact = car[~car['so'].map(lambda c: so_excluded(c, exact=True))]
print(f'\nSensitivity A (exact-term exclusion): mean = {kept_exact.groupby("sample").size().reindex(counts.index, fill_value=0).mean():.4f}')
allrows_kept = dedup[~dedup['so'].map(so_excluded)]
print(f'Sensitivity B (all rows incl. Reference, after SO filter): mean = {allrows_kept.groupby("sample").size().reindex(counts.index, fill_value=0).mean():.4f}')
counts.to_csv('/workspace/analysis/per_sample_counts.csv')
