"""
CHIP variant count after removing reference calls.

Question: "How many CHIP variants remain after removing reference calls from the dataset?"

Approved method (researcher decisions 1-6):
  * Unit : one row = one variant call in one sample; primary count sums rows over 86 files.
  * Rule : "reference call" == sample-column Zygosity == "Reference" -> removed.
           retained = Zygosity in {"Heterozygous", "Homozygous Variant"}.
           blank Zygosity = "no call" -> excluded from retained, reported separately.
  * Scope: all 86 samples; no trio restriction; CHIP gene list re-filter confirmed no-op.
  * Irregular 380-P / 381-PM stay in scope as-is, reported separately.
  * No de-duplication for the primary number; unique-variant figures are secondary.
  * Mendel Error / MIE is NOT part of the removal rule (aside only).
"""
import json
import os
import re
from collections import Counter

import pandas as pd

DATA = "data"
VAR_DIR = os.path.join(DATA, "CHIP_DP10_GQ20_PASS")
GENE_FILE = os.path.join(DATA, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx")
TRIO_FILE = os.path.join(DATA, "230215_Trio_Status.xlsx")

NONREF = ("Heterozygous", "Homozygous Variant")
REF = "Reference"
ROLE_RE = re.compile(r"^(Proband|Mother|Father|Child|Patient)\s*\((.*)\)\s*$")


def load_workbook(path):
    """Read one per-sample export. All 86 files share the same two-row header;
    the sheet name is used for reporting only, never as a row count."""
    sheet = pd.ExcelFile(path).sheet_names[0]
    df = pd.read_excel(path, sheet_name=sheet, header=[0, 1])
    level0 = [c[0] for c in df.columns]
    df.columns = [c[1] for c in df.columns]
    sample_label = None
    for l0, l1 in zip(level0, df.columns):
        if isinstance(l0, str) and ROLE_RE.match(l0.strip()) and l1 == "Zygosity":
            sample_label = l0.strip()
            break
    assert sample_label, "no sample Zygosity column found in " + path
    m = ROLE_RE.match(sample_label)
    df["_zyg"] = df["Zygosity"].astype("string").str.strip()
    df["_role"] = m.group(1)
    df["_sample"] = m.group(2)
    return sheet, df


# --------------------------------------------------------------- per-file scan
files = sorted(os.listdir(VAR_DIR))
rows = []
union_variants = set()
mendel = Counter()
gene_counter = Counter()

for f in files:
    sheet, df = load_workbook(os.path.join(VAR_DIR, f))
    z = df["_zyg"]
    mask_keep = z.isin(NONREF)
    ref = int((z == REF).sum())
    het = int((z == "Heterozygous").sum())
    hom = int((z == "Homozygous Variant").sum())
    blank = int(z.isna().sum())
    other = len(df) - ref - het - hom - blank
    retained = het + hom

    key = df["Chr:Pos"].astype(str) + "|" + df["Ref/Alt"].astype(str)
    unique_keys = int(key.nunique())
    union_variants |= set(key[mask_keep])

    sheet_n = int(re.search(r"(\d+)\)", sheet).group(1))
    rows.append(dict(
        file=f, sample=df["_sample"].iloc[0], role=df["_role"].iloc[0], sheet=sheet,
        sheet_label_number=sheet_n,
        layout="irregular" if sheet_n in (704, 705) else "standard",
        total_rows=len(df), reference=ref, heterozygous=het,
        homozygous_variant=hom, no_call_blank=blank, other_zygosity=other,
        retained=retained, unique_variant_keys=unique_keys,
        duplicate_keys_within_file=int(len(df) - unique_keys),
        retained_dedup_variants=int(key[mask_keep].nunique()),
    ))
    mendel.update(str(v) for v in df.loc[mask_keep, "Mendel Error"])
    gene_counter.update(df["Gene Names"].dropna().astype(str).str.strip())

per = pd.DataFrame(rows)

# ------------------------------------------------------- primary aggregation
total_rows = int(per["total_rows"].sum())
n_ref, n_blank = int(per["reference"].sum()), int(per["no_call_blank"].sum())
n_het, n_hom = int(per["heterozygous"].sum()), int(per["homozygous_variant"].sum())
n_other = int(per["other_zygosity"].sum())
primary = int(per["retained"].sum())
alt_convention = total_rows - n_ref          # blanks counted as "not Reference"
irreg = per[per["layout"] == "irregular"]
std = per[per["layout"] == "standard"]
retained_mendel_error = sum(v for k, v in mendel.items() if k not in ("nan", "None"))

# --------------------------------------------- metadata: CHIP gene list (no-op)
chip_genes = [str(x).strip() for x in pd.read_excel(GENE_FILE, header=None)[0].dropna()]
chip_lookup, data_genes = set(chip_genes), set(gene_counter)
chips = dict(
    gene_file_rows_no_header=len(chip_genes), gene_file_unique=len(chip_lookup),
    gene_file_duplicates=[g for g, n in Counter(chip_genes).items() if n > 1],
    header_row_present=False, first_row=chip_genes[0],
    distinct_gene_names_in_workbooks=len(data_genes),
    workbook_genes_not_in_56_gene_list=sorted(data_genes - chip_lookup),
    extra_list_genes_absent_from_data=sorted(chip_lookup - data_genes),
    chip_flag_column_true_fraction=None,
)

# ------------------------------------------------- metadata: trio status (context)
trio = pd.read_excel(TRIO_FILE)
trio_ids = {str(s).strip() for s in trio["Sample ID"]}
workbook_ids = set(per["sample"])
role_breakdown = per.groupby("role").agg(
    files=("file", "count"), total_rows=("total_rows", "sum"),
    reference=("reference", "sum"), no_call_blank=("no_call_blank", "sum"),
    retained=("retained", "sum")).to_dict("index")

# verify the In_CHIP flag column is all-True (proves the gene list is a no-op)
inchip = Counter()
for f in files:
    p = os.path.join(VAR_DIR, f)
    sh = pd.ExcelFile(p).sheet_names[0]
    g = pd.read_excel(p, sheet_name=sh, header=None, skiprows=2, usecols=[29])
    inchip.update(str(v) for v in g.iloc[:, 0])
chips["chip_flag_column_counts"] = dict(inchip)
chips["refilter_is_noop"] = (chips["chip_flag_column_counts"] == {"True": total_rows})

out = dict(
    primary_answer=primary,
    answer_sentence=(f"{primary:,} CHIP variants remain after removing reference calls, "
                     "counting one row as one variant call in one sample, summed across "
                     "all 86 per-sample workbooks."),
    counting_unit="variant call rows summed over all 86 per-sample workbooks",
    class_partition=dict(
        total_rows=total_rows, reference_removed=n_ref, no_call_blank=n_blank,
        heterozygous=n_het, homozygous_variant=n_hom, other_zygosity=n_other,
        check_total_minus_ref_minus_blank=total_rows - n_ref - n_blank,
        check_het_plus_hom=n_het + n_hom,
        partition_ok=(total_rows - n_ref - n_blank == primary and n_het + n_hom == primary),
    ),
    sensitivity=dict(
        retained_if_blanks_counted_as_not_reference=alt_convention,
        removed_if_blanks_are_reference=n_ref,
        removed_if_blanks_are_uncalled=total_rows - primary,
        ambiguity_width_rows=alt_convention - primary,
    ),
    per_sample_summary=dict(
        n_files=int(len(per)), min=int(per["retained"].min()),
        median=float(per["retained"].median()), max=int(per["retained"].max()),
        mean=round(float(per["retained"].mean()), 2),
        min_file=per.loc[per["retained"].idxmin(), "file"],
        max_file=per.loc[per["retained"].idxmax(), "file"],
    ),
    irregular_files=irreg.to_dict("records"),
    standard_files_aggregate=dict(
        files=int(len(std)), total_rows=int(std["total_rows"].sum()),
        reference=int(std["reference"].sum()), no_call_blank=int(std["no_call_blank"].sum()),
        retained=int(std["retained"].sum()), min=int(std["retained"].min()),
        median=float(std["retained"].median()), max=int(std["retained"].max())),
    secondary_unique_variant_figures=dict(
        within_file_duplicate_keys_total=int(per["duplicate_keys_within_file"].sum()),
        retained_rows_after_within_file_dedup=int(per["retained_dedup_variants"].sum()),
        cross_sample_union_of_retained_variants=len(union_variants),
        note="secondary only; the primary number is deliberately NOT de-duplicated"),
    mendel_error_aside_NOT_part_of_answer=dict(
        retained_calls_with_mendel_error_label=int(retained_mendel_error),
        breakdown=dict(mendel)),
    chip_gene_list=chips,
    trio_status=dict(
        raw_status_counts={str(k): int(v) for k, v in trio["Status"].value_counts().items()},
        stripped_status_counts={str(k).strip(): int(v)
                                for k, v in trio["Status"].value_counts().items()},
        trio_rows=len(trio), role_breakdown_from_workbook_headers=role_breakdown,
        trio_ids_without_workbook=sorted(trio_ids - workbook_ids),
        workbook_ids_without_trio_row=sorted(workbook_ids - trio_ids)),
)
per.to_csv("analysis/per_sample_summary.csv", index=False)
json.dump(out, open("analysis/chip_variant_count_results.json", "w"), indent=2, default=str)

cp, sv, ps, s = out["class_partition"], out["secondary_unique_variant_figures"], \
    out["per_sample_summary"], out["sensitivity"]
print("=" * 78)
print("PRIMARY ANSWER:", f"{primary:,}", "CHIP variant calls remain")
print("convention:", out["counting_unit"])
print("=" * 78)
print(f"\nclass partition over {cp['total_rows']:,} rows:")
print(f"  Reference (removed)         {cp['reference_removed']:>7,}")
print(f"  blank Zygosity (no call)    {cp['no_call_blank']:>7,}")
print(f"  Heterozygous (retained)     {cp['heterozygous']:>7,}")
print(f"  Homozygous Variant (ret.)   {cp['homozygous_variant']:>7,}")
print(f"  other Zygosity values       {cp['other_zygosity']:>7,}")
print(f"\n  check: {cp['total_rows']:,} - {cp['reference_removed']:,} - {cp['no_call_blank']:,}"
      f" = {cp['check_total_minus_ref_minus_blank']:,}")
print(f"  check: {cp['heterozygous']:,} + {cp['homozygous_variant']:,}"
      f" = {cp['check_het_plus_hom']:,}   partition_ok={cp['partition_ok']}")
print(f"\nSENSITIVITY: blanks as 'not Reference' -> {s['retained_if_blanks_counted_as_not_reference']:,}"
      f"  (ambiguity worth {s['ambiguity_width_rows']:,} rows)")
print(f"  removed: {s['removed_if_blanks_are_reference']:,} (blanks=Reference) vs"
      f" {s['removed_if_blanks_are_uncalled']:,} (blanks=uncalled)")
print(f"\nretained per file: min {ps['min']} ({ps['min_file']}), median {ps['median']:.1f},"
      f" max {ps['max']} ({ps['max_file']}), mean {ps['mean']}")
sa = out["standard_files_aggregate"]
print(f"standard 84 files: retained {sa['retained']:,}  (min {sa['min']}, median {sa['median']:.1f},"
      f" max {sa['max']}, no-call {sa['no_call_blank']})")
print("irregular 2 files:")
for r in out["irregular_files"]:
    print(f"  {r['file']}: rows {r['total_rows']}, Reference {r['reference']}, no-call {r['no_call_blank']},"
          f" RETAINED {r['retained']}")
print(f"\nSECONDARY (not the answer): dup keys within files {sv['within_file_duplicate_keys_total']},"
      f" row-wise dedup retained {sv['retained_rows_after_within_file_dedup']:,},"
      f" cross-sample union {sv['cross_sample_union_of_retained_variants']}")
ma = out["mendel_error_aside_NOT_part_of_answer"]
print("MENDEL aside (not part of answer):", ma["retained_calls_with_mendel_error_label"], ma["breakdown"])
print("\nrole breakdown from workbook headers:")
for k, v in role_breakdown.items():
    print(f"  {k:8s} files {v['files']:>3}  rows {v['total_rows']:>6,}  ref {v['reference']:>6,}"
          f"  no-call {v['no_call_blank']:>5,}  retained {v['retained']:>6,}")
print("\nCHIP gene list:", {k: chips[k] for k in ("gene_file_rows_no_header", "gene_file_unique",
      "gene_file_duplicates", "distinct_gene_names_in_workbooks",
      "workbook_genes_not_in_56_gene_list", "chip_flag_column_counts", "refilter_is_noop")})
print("trio raw Status:", dict(trio["Status"].value_counts()))
print("trio IDs without workbook:", out["trio_status"]["trio_ids_without_workbook"])
print("workbook IDs without trio row:", out["trio_status"]["workbook_ids_without_trio_row"][:12],
      f"(n={len(out['trio_status']['workbook_ids_without_trio_row'])})")
print("\nwrote analysis/per_sample_summary.csv, analysis/chip_variant_count_results.json")

# ============================ ADDENDUM: metadata-join validation (not applied)
# (i) Would a literal 56-symbol filter change anything? NOT applied to the answer;
#     measured only to document that In_CHIP==True is not the same as the gene file.
import re as _re
strict_dropped = Counter()
dropped_genes = Counter()
for f in files:
    p = os.path.join(VAR_DIR, f)
    sh = pd.ExcelFile(p).sheet_names[0]
    g = pd.read_excel(p, sheet_name=sh, header=[0, 1])
    g.columns = [c[1] for c in g.columns]
    zz = g["Zygosity"].astype("string").str.strip()
    for v in g.loc[zz.isin(NONREF), "Gene Names"].dropna().astype(str).str.strip():
        toks = {t.strip() for t in _re.split(r"[,;/]", v) if t.strip()}
        if not (toks & chip_lookup):
            strict_dropped["rows"] += 1
            dropped_genes[v] += 1
chips["hypothetical_strict_56_symbol_filter"] = dict(
    retained_rows_that_would_be_dropped=int(strict_dropped["rows"]),
    breakdown=dict(dropped_genes),
    resulting_count=int(primary - strict_dropped["rows"]),
    applied=False,
    reason="export In_CHIP list is broader than the 56-symbol file (MMAB/MMACHC/SF3B2 "
           "are absent from the gene file); researcher instructed not to re-filter")

# (ii) Trio join after normalising IDs: suffix strip + whitespace strip.
tmap = {str(s).strip(): str(s2).strip()
        for s, s2 in zip(trio["Sample ID"], trio["Status"])}
tid_norm = per["sample"].map(lambda s: re.sub(r"-(P\d*|PM|PF)$", "", str(s).strip()))
per["trio_status"] = tid_norm.map(tmap)
join = dict(
    workbooks=int(len(per)),
    matched_after_normalisation=int(per["trio_status"].notna().sum()),
    trio_rows_without_workbook=sorted(set(tmap) - set(tid_norm.dropna())),
    trailing_whitespace_trio_ids=int(sum(1 for s in trio["Sample ID"].astype(str)
                                         if s != s.strip())),
    trailing_whitespace_Status_values=sorted({repr(s) for s in trio["Status"]
                                              if str(s) != str(s).strip()}),
    role_vs_status_crosstab=pd.crosstab(per["role"], per["trio_status"]).to_dict(),
    role_status_bijection=bool(
        (pd.crosstab(per["role"], per["trio_status"]) > 0).sum().sum() == len(per["role"].unique())),
    label_note="workbook header role 'Proband' corresponds to trio Status 'Patient'; "
               "the two vocabularies differ but map 1:1",
    retained_by_trio_status=per.groupby("trio_status")["retained"].agg(
        ["count", "sum", "median"]).to_dict("index"),
)
out["trio_status"]["join_after_normalisation"] = join
out["chip_gene_list"] = chips
per.to_csv("analysis/per_sample_summary.csv", index=False)
json.dump(out, open("analysis/chip_variant_count_results.json", "w"), indent=2, default=str)

print("\n--- ADDENDUM ---")
print("hypothetical strict 56-symbol filter (NOT applied): would drop %d retained rows ->"
      " %d ; breakdown %s" % (strict_dropped["rows"], primary - strict_dropped["rows"],
                              dict(dropped_genes)))
print("trio join after normalisation: %d/%d workbooks matched; trio rows without workbook %s;"
      " trailing-whitespace Sample IDs: %d; Status values needing strip: %s"
      % (join["matched_after_normalisation"], join["workbooks"],
         join["trio_rows_without_workbook"], join["trailing_whitespace_trio_ids"],
         join["trailing_whitespace_Status_values"]))
print("workbook-header role <-> trio Status is a perfect bijection:",
      join["role_status_bijection"], "|", join["label_note"])
print("crosstab role x Status:", join["role_vs_status_crosstab"])
print("retained by trio Status:", join["retained_by_trio_status"])
