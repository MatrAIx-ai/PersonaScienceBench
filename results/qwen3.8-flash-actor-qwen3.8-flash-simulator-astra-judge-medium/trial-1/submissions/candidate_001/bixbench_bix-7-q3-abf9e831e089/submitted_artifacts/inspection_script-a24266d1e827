"""Inspection-only inventory of the CHIP capsule inputs (no final count)."""
import os, re, collections, json
import pandas as pd

DATA = "data"
DIR = os.path.join(DATA, "CHIP_DP10_GQ20_PASS")

# --- metadata files -------------------------------------------------------
genes = [str(x).strip() for x in
         pd.read_excel(os.path.join(DATA, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx"),
                       header=None)[0].dropna()]
trio = pd.read_excel(os.path.join(DATA, "230215_Trio_Status.xlsx"))

# --- per-workbook scan ----------------------------------------------------
files = sorted(os.listdir(DIR))
zyg = collections.Counter(); flags = collections.Counter()
per_file = []
for f in files:
    p = os.path.join(DIR, f)
    sh = pd.ExcelFile(p).sheet_names[0]
    sheet_n = int(re.search(r"(\d+)\)", sh).group(1))
    df = pd.read_excel(p, sheet_name=sh, header=[0, 1])
    l1 = [c[1] for c in df.columns]
    df.columns = l1
    layout = "irregular" if sheet_n in (704, 705) else "standard"
    z = df.iloc[:, 4]                     # sample-column 'Zygosity'
    blank_no_dp = int((z.isna() & df.iloc[:, 7].isna()).sum())
    blank_with_dp = int((z.isna() & df.iloc[:, 7].notna()).sum())
    for k, v in z.value_counts(dropna=False).items():
        zyg[(layout, str(k))] += v
    for c in (2, 3):                      # Flags: Primary / Incidental Findings
        for k, v in df.iloc[:, c].value_counts(dropna=False).items():
            flags[(l1[c], str(k))] += v
    per_file.append(dict(file=f, sheet=sh, sheet_variant_number=sheet_n, layout=layout,
                         rows=len(df), cols=df.shape[1],
                         het=int((z == "Heterozygous").sum()),
                         hom=int((z == "Homozygous Variant").sum()),
                         reference=int((z == "Reference").sum()),
                         blank=blank_no_dp + blank_with_dp,
                         blank_no_DP=blank_no_dp, blank_with_DP=blank_with_dp))

summ = dict(
    n_workbooks=len(files),
    layouts=collections.Counter(p["layout"] for p in per_file),
    irregular_files=[p["file"] for p in per_file if p["layout"] == "irregular"],
    total_rows=sum(p["rows"] for p in per_file),
    sheet_number_equals_rows=all(p["sheet_variant_number"] == p["rows"] for p in per_file),
    zygosity_by_layout={f"{k[0]}|{k[1]}": v for k, v in zyg.items()},
    flag_values={f"{k[0]}={k[1]}": v for k, v in flags.items()},
    chips={
        "rows_in_file": len(genes), "unique_genes": len(set(genes)),
        "duplicates": [g for g, n in collections.Counter(genes).items() if n > 1],
        "header_row_present": False,
        "first_row": genes[0],
        "row1_is_header": genes[0] in {"Gene", "Gene Symbol", "Symbol"},
    },
    trio=dict(rows=len(trio), columns=list(trio.columns),
              status_counts={str(k): int(v) for k, v in trio["Status"].value_counts().items()},
              status_values_raw=[repr(s) for s in trio["Status"].unique()],
              distinct_status_stripped=sorted({str(s).strip() for s in trio["Status"]})),
)
json.dump({"summary": summ, "per_file": per_file}, open("analysis/inspection_summary.json", "w"),
          indent=2, default=str)
print(json.dumps(summ, indent=2, default=str))
