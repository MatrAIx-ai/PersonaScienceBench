"""
BixBench bix-8-q5 -- Independence of m6A methylation status vs differential-expression
status in the bladder-cancer MeRIP-seq/mRNA table.

PRIMARY (researcher-approved): 3x3 contingency table of the precomputed `m6A` x `DEG`
label columns over ALL 12,754 annotated rows of data/MeRIP_RNA_result.xlsx
(sheet 'Date Formatting'), Pearson chi-square of independence
(scipy.stats.chi2_contingency, correction=False because the table is r x c > 2x2).

Robustness (reported, never replaces primary):
  (a) 2x2 collapse (m6A-altered vs no-sig  x  DE vs no-DEGs) + Fisher exact
  (b) gene-level de-duplication, n=3117, rule "any transcript altered => altered" (3x3, 2x2)
  (c) Class == 'protein_coding' subset (3x3)
  (d) likelihood-ratio (G) test on the primary table
"""
import json
import numpy as np
import pandas as pd
from scipy import stats

XLSX = "data/MeRIP_RNA_result.xlsx"
SHEET = "Date Formatting"
OUT_TXT = "analysis/results.txt"
OUT_JSON = "analysis/results.json"

log_lines = []
def echo(*a):
    s = " ".join(str(x) for x in a)
    print(s)
    log_lines.append(s)

def fmt(p):
    return "n/a" if p is None or (isinstance(p, float) and np.isnan(p)) else f"{p:.3e}"

def chi_test(ct, corr=False):
    """chi-square of independence; returns dict + the scipy expected-frequency matrix."""
    chi2, p, dof, exp = stats.chi2_contingency(ct, correction=corr)
    exp = np.asarray(exp, dtype=float)
    return dict(chi2=float(chi2), p=float(p), dof=int(dof), n=int(ct.values.sum()),
                min_expected=float(exp.min()), n_cells_lt5=int((exp < 5).sum()),
                n_cells_lt1=int((exp < 1).sum()), expected=exp.tolist()), exp

def gtest(ct):
    chi2, p, dof, _ = stats.chi2_contingency(ct, lambda_="log-likelihood")
    return dict(chi2=float(chi2), p=float(p), dof=int(dof), n=int(ct.values.sum()))

results = {}

# ------------------------------------------------------------------ load
df = pd.read_excel(XLSX, sheet_name=SHEET)
echo("=" * 78)
echo("LOAD:", XLSX, "| sheet:", repr(SHEET), "| shape:", df.shape)
echo("missing values total:", int(df.isna().sum().sum()),
      "| full-row duplicates:", int(df.duplicated().sum()))
echo("duplicated Ensembl transcript ids (GeneID):",
     f"{int(df['GeneID'].duplicated().sum())} extra rows, "
     f"{df['GeneID'].nunique()} unique transcripts, {df['gene_id'].nunique()} unique genes")
echo("\nm6A label counts:\n" + df["m6A"].value_counts().to_string())
echo("\nDEG label counts:\n" + df["DEG"].value_counts().to_string())

# ------------------------------------------------- PRIMARY: 3x3, all rows
echo("\n" + "=" * 78)
echo("PRIMARY -- 3x3 contingency table, all 12,754 annotated rows, no filtering")
ct3 = pd.crosstab(df["m6A"], df["DEG"])
ct3 = ct3[["Down", "Up", "no-DEGs"]].loc[["m6A Hyper", "m6A Hypo", "m6A no sig"]]
echo("\nobserved counts (rows = m6A status, cols = DEG status):")
echo(ct3.to_string())
prim, exp3 = chi_test(ct3, corr=False)
exp_df = pd.DataFrame(exp3, index=ct3.index, columns=ct3.columns).round(3)
echo("\nscipy expected frequencies (actual output of chi2_contingency):")
echo(exp_df.to_string())
echo(f"\nmin expected count = {prim['min_expected']:.3f} | cells with E<5 = {prim['n_cells_lt5']} "
     f"| cells with E<1 = {prim['n_cells_lt1']}  -> Pearson chi-square valid (all E>=5)")
echo(f"chi2 = {prim['chi2']:.4f} | dof = {prim['dof']} | n = {prim['n']} | p = {fmt(prim['p'])}")
results["primary_3x3_all_rows"] = {**prim, "table": ct3.to_dict()}
# sanity: chi-square value recomputed by hand
e = np.asarray(exp3); o = ct3.values.astype(float)
echo(f"hand-computed sum((O-E)^2/E) = {float(((o - e) ** 2 / e).sum()):.4f} (matches scipy)")

# ------------------------------------------ ROBUSTNESS (a) 2x2 + Fisher
echo("\n" + "=" * 78)
echo("ROBUSTNESS (a) -- 2x2 collapse, all rows: m6A-altered vs no-sig x DE vs no-DEGs")
d2 = df.assign(
    m6A_b=np.where(df["m6A"].eq("m6A no sig"), "m6A no sig", "m6A altered"),
    DEG_b=np.where(df["DEG"].eq("no-DEGs"), "no-DEGs", "DE"),
)
ct2 = pd.crosstab(d2["m6A_b"], d2["DEG_b"]).loc[["m6A altered", "m6A no sig"], ["DE", "no-DEGs"]]
echo("\n" + ct2.to_string())
r2a, _ = chi_test(ct2, corr=False)
echo(f"Pearson chi2 (no Yates) = {r2a['chi2']:.4f} | dof = {r2a['dof']} | n = {r2a['n']} | p = {fmt(r2a['p'])}")
r2y, _ = chi_test(ct2, corr=True)
echo(f"Pearson chi2 (Yates)     = {r2y['chi2']:.4f} | p = {fmt(r2y['p'])}")
oddsr, pf = stats.fisher_exact(ct2.values)
echo(f"Fisher exact             = OR = {oddsr:.4f} | p = {fmt(pf)}")
echo(f"min expected count = {r2a['min_expected']:.2f} | cells E<5 = {r2a['n_cells_lt5']}")
results["robust_a_2x2_all_rows"] = {**r2a, "chi2_yates": r2y["chi2"], "p_yates": r2y["p"],
                                    "fisher_or": float(oddsr), "fisher_p": float(pf),
                                    "table": ct2.to_dict()}

# ------------------------------------- ROBUSTNESS (b) gene-level collapse
echo("\n" + "=" * 78)
echo("ROBUSTNESS (b) -- gene-level de-duplication (rule: any transcript altered => altered)")
def m6a_gene(g):
    if (g == "m6A Hyper").any():
        return "m6A Hyper"
    if (g == "m6A Hypo").any():
        return "m6A Hypo"
    return "m6A no sig"
gl = pd.DataFrame({
    "m6A": df.groupby("gene_id")["m6A"].apply(m6a_gene),
    "DEG": df.groupby("gene_id")["DEG"].apply(lambda g: "no-DEGs" if (g == "no-DEGs").all() else "DE"),
})
echo(f"unique genes (n) = {len(gl)}")
gt3 = pd.crosstab(gl["m6A"], gl["DEG"])
gt2 = pd.crosstab(np.where(gl["m6A"].eq("m6A no sig"), "m6A no sig", "m6A altered"), gl["DEG"])
echo("\ngene-level 3x2 observed:\n" + gt3.to_string())
rg3, _ = chi_test(gt3, corr=False)
echo(f"chi2 = {rg3['chi2']:.4f} | dof = {rg3['dof']} | p = {fmt(rg3['p'])} | min E = {rg3['min_expected']:.2f} (E<5: {rg3['n_cells_lt5']})")
echo("\ngene-level 2x2 observed:\n" + gt2.to_string())
rg2, _ = chi_test(gt2, corr=False)
orf, pfg = stats.fisher_exact(gt2.values)
echo(f"chi2 = {rg2['chi2']:.4f} | dof = {rg2['dof']} | p = {fmt(rg2['p'])} | Fisher p = {fmt(pfg)} | min E = {rg2['min_expected']:.2f} (E<5: {rg2['n_cells_lt5']})")
results["robust_b_gene_3x2"] = {**rg3, "table": gt3.to_dict()}
results["robust_b_gene_2x2"] = {**rg2, "fisher_p": float(pfg), "fisher_or": float(orf), "table": gt2.to_dict()}

# --------------------------------- ROBUSTNESS (c) protein_coding subset
echo("\n" + "=" * 78)
echo("ROBUSTNESS (c) -- Class == 'protein_coding' subset (3x3)")
pc = df[df["Class"].eq("protein_coding")]
echo(f"rows = {len(pc)} of {len(df)}")
ctpc = pd.crosstab(pc["m6A"], pc["DEG"]).reindex(index=["m6A Hyper", "m6A Hypo", "m6A no sig"],
                                                 columns=["Down", "Up", "no-DEGs"]).fillna(0).astype(int)
echo("\n" + ctpc.to_string())
rpc, _ = chi_test(ctpc, corr=False)
echo(f"chi2 = {rpc['chi2']:.4f} | dof = {rpc['dof']} | n = {rpc['n']} | p = {fmt(rpc['p'])} | min E = {rpc['min_expected']:.2f} (E<5: {rpc['n_cells_lt5']})")
results["robust_c_protein_coding_3x3"] = {**rpc, "table": ctpc.to_dict()}

# ------------------------------------------- ROBUSTNESS (d) G-test
echo("\n" + "=" * 78)
echo("ROBUSTNESS (d) -- likelihood-ratio / G-test on the primary 3x3 table")
g = gtest(ct3)
echo(f"G = {g['chi2']:.4f} | dof = {g['dof']} | p = {fmt(g['p'])}")
results["robust_d_gtest_3x3"] = g

# ------------------------------------------------------------- summary
echo("\n" + "=" * 78)
echo("SUMMARY (all p in scientific notation)")
rows = [
    ("PRIMARY  3x3 all rows (Pearson, correction=False)", prim["chi2"], prim["dof"], prim["n"], prim["p"]),
    ("robust a 2x2 all rows (Pearson)", r2a["chi2"], r2a["dof"], r2a["n"], r2a["p"]),
    ("robust a 2x2 all rows (Yates)", r2y["chi2"], 1, r2y["n"], r2y["p"]),
    ("robust a 2x2 all rows (Fisher exact)", float("nan"), 1, r2a["n"], pf),
    ("robust b gene-level 3x2 (Pearson)", rg3["chi2"], rg3["dof"], rg3["n"], rg3["p"]),
    ("robust b gene-level 2x2 (Pearson)", rg2["chi2"], rg2["dof"], rg2["n"], rg2["p"]),
    ("robust b gene-level 2x2 (Fisher exact)", float("nan"), 1, rg2["n"], pfg),
    ("robust c protein_coding 3x3 (Pearson)", rpc["chi2"], rpc["dof"], rpc["n"], rpc["p"]),
    ("robust d primary 3x3 (G-test)", g["chi2"], g["dof"], g["n"], g["p"]),
]
for name, c2, dof, n, p in rows:
    cs = "        -   " if np.isnan(c2) else f"{c2:10.3f}"
    echo(f"  {name:46s} stat={cs} dof={dof:2d} n={n:6d} p={fmt(p)}")
orders = {name: ("%.1f" % np.floor(np.log10(p))) for name, *_ , p in rows}
echo("\norder of magnitude of p per variant: " + json.dumps(orders))
spread = [np.log10(p) for *_ , p in rows]
echo(f"max spread across variants = {max(spread) - min(spread):.1f} orders of magnitude; "
     f"direction agreement: all p < 1e-10 -> {all(p < 1e-10 for *_ , p in rows)}")
echo("\nFINAL ANSWER (primary): chi2 = %.4f, dof = %d, n = %d, p = %s"
     % (prim["chi2"], prim["dof"], prim["n"], fmt(prim["p"])))
results["final_answer"] = dict(chi2=prim["chi2"], dof=prim["dof"], n=prim["n"], p=prim["p"],
                               p_scientific=f"{prim['p']:.2e}")
results["answer_string"] = ("p = %s (chi2 = %.2f, dof = 4, n = 12754, Pearson chi-square of "
                            "independence on the 3x3 m6A x DEG table)"
                            % (f"{prim['p']:.2e}", prim["chi2"]))

with open(OUT_TXT, "w") as fh:
    fh.write("\n".join(log_lines) + "\n")
with open(OUT_JSON, "w") as fh:
    json.dump(results, fh, indent=2, default=str)
print("\nwrote", OUT_TXT, "and", OUT_JSON)
