"""Question: in which tissue do BAD RESPONDERS show the highest number of significantly
differentially expressed genes (log2FC > 0.5 AND baseMean > 10) compared to CONTROLS?

PRIMARY  : literal rule on the deposited DESeq blocks (NormCount cols 108-116 baseline blood,
           135-143 dentate gyrus, 162-170 final blood). In these three blocks baseMeanA=Control
           and baseMeanB=bad_responder, so log2FoldChange>0 == up in bad responders.
SECONDARY: independent DESeq-style recomputation (median-of-ratios size factors, NB moment
           dispersion + fitted trend, closed-form NB MLE group means, Wald test, BH), plus a
           scale-anchored variant reusing the deposited normalisation so baseMean sits on the
           same scale as the deposited blocks.
SENSITIVITY: low-mapping leave-out, extreme-value winsorisation, gene-wise dispersion,
           animal-blocked blood design. Never replaces the primary numbers.
"""
import sys, warnings, numpy as np, pandas as pd
warnings.filterwarnings("ignore")
sys.path.insert(0, "analysis")
import deseq_nb as D

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
TISSUES = ["baseline_blood", "dentate_gyrus", "final_blood"]
BLOCKS = {"baseline_blood": 108, "dentate_gyrus": 135, "final_blood": 162}   # A=Control, B=bad
RULE = "log2FoldChange > 0.5 AND baseMean > 10, counted as up in bad_responder vs Control"

nc = pd.read_pickle("results/normcount_raw.pkl")
meta = pd.read_csv("results/metadata.csv").sort_values("Index_DESeq").reset_index(drop=True)
sn = pd.read_excel(XLSX, sheet_name="NormCount", header=None, skiprows=3, nrows=1).iloc[0, 2:92].tolist()
idx = {s: i for i, s in enumerate(sn)}
cnt = nc[[f"c{j}" for j in range(3, 93)]].apply(pd.to_numeric, errors="coerce").to_numpy()
GENE = nc.c2.to_numpy()
sf_glob = meta["total read"].to_numpy(float) / cnt.sum(axis=0)
sf_glob = sf_glob / np.exp(np.log(sf_glob).mean())
RAW = np.rint(cnt * sf_glob[None, :])
np.save("results/raw_counts.npy", RAW); np.save("results/size_factors.npy", sf_glob)

def cols(tis, grp, drop=()):
    return [idx[c] for c in sn if c.startswith(f"{grp}_{tis}") and c not in drop]

def stated(bm, lfc):
    bm, lfc = np.asarray(bm, float), np.asarray(lfc, float)
    return np.isfinite(bm) & (bm > 10) & (lfc > 0.5)

def stated_finite(bm, lfc):
    bm, lfc = np.asarray(bm, float), np.asarray(lfc, float)
    return np.isfinite(bm) & np.isfinite(lfc) & (bm > 10) & (lfc > 0.5)

prim, dep, sec, sect = {}, {}, {}, {}
for tis in TISSUES:
    s = BLOCKS[tis]
    g = lambda k: pd.to_numeric(nc[f"c{s+k}"], errors="coerce").to_numpy(dtype=float)
    dep[tis] = dict(baseMean=g(0), A=g(1), B=g(2), lfc=g(4), p=g(5), padj=g(6),
                    labMax=nc[f"c{s+7}"].astype(str).to_numpy(), labMed=nc[f"c{s+8}"].astype(str).to_numpy())
    d0, sel = dep[tis], stated(g(0), g(4))
    prim[tis] = dict(n_up=int(sel.sum()), n_up_finite_only=int(stated_finite(d0["baseMean"], d0["lfc"]).sum()),
                     n_inf_lfc_counted=int((np.isposinf(d0["lfc"]) & (d0["baseMean"] > 10)).sum()),
                     n_up_padj005=int((sel & (d0["padj"] < 0.05)).sum()),
                     n_up_padj010=int((sel & (d0["padj"] < 0.10)).sum()),
                     n_dn=int(stated(d0["baseMean"], -d0["lfc"]).sum()), n_bm10=int((d0["baseMean"] > 10).sum()),
                     labU_Max=int((d0["labMax"] == "U").sum()), labU_Median=int((d0["labMed"] == "U").sum()))
    print(f"[PRIMARY   ] {tis:15s} UP={prim[tis]['n_up']:4d} DOWN={prim[tis]['n_dn']:4d} "
          f"(+padj<0.05 {prim[tis]['n_up_padj005']:4d}, +padj<0.10 {prim[tis]['n_up_padj010']:4d}, "
          f"finite-only {prim[tis]['n_up_finite_only']:4d}) | deposited U labels Max {prim[tis]['labU_Max']:4d} / Median {prim[tis]['labU_Median']:4d}")

for tis in TISSUES:
    c0, c1 = cols(tis, "Control"), cols(tis, "bad_responder")
    cc, grp = c0 + c1, np.array([0] * len(c0) + [1] * len(c1))
    mor = D.run(RAW[:, cc], grp)
    anc = D.run(RAW[:, cc], grp, sf=sf_glob[cc])
    gw = D.run(RAW[:, cc], grp, sf=sf_glob[cc], sharing="mle")
    sect[tis], d0 = anc, dep[tis]
    sel, selm = stated(anc["baseMean"], anc["log2FoldChange"]), stated(mor["baseMean"], mor["log2FoldChange"])
    m = (d0["baseMean"] > 1) & (anc["baseMean"] > 1)
    ratio = float(np.median(anc["baseMean"][m] / d0["baseMean"][m]))
    okl = np.isfinite(d0["lfc"]) & np.isfinite(anc["log2FoldChange"])
    sec[tis] = dict(n_up=int(sel.sum()), n_up_mor=int(selm.sum()),
                    n_up_padj005=int((sel & (anc["padj"] < 0.05)).sum()),
                    n_up_gene_wise_disp=int(stated(anc["baseMean"], gw["log2FoldChange"]).sum()),
                    n_dn=int(stated(anc["baseMean"], -anc["log2FoldChange"]).sum()),
                    bm_ratio_anchored=round(ratio, 4),
                    bm_ratio_mor=round(float(np.median(mor["baseMean"][m] / d0["baseMean"][m])), 4),
                    pearson_lfc=round(float(pd.Series(d0["lfc"][okl]).corr(pd.Series(anc["log2FoldChange"][okl]))), 4),
                    spearman_lfc=round(float(pd.Series(d0["lfc"][okl]).corr(pd.Series(anc["log2FoldChange"][okl]), method="spearman")), 4),
                    jaccard=round(float((sel & stated(d0["baseMean"], d0["lfc"])).sum() /
                                        max((sel | stated(d0["baseMean"], d0["lfc"])).sum(), 1)), 4),
                    attrib_depBM_recLFC=int(stated(d0["baseMean"], anc["log2FoldChange"]).sum()),
                    attrib_recBM_depLFC=int(stated(anc["baseMean"], d0["lfc"]).sum()))
    print(f"[SECONDARY ] {tis:15s} UP={sec[tis]['n_up']:4d} (anchored) / {sec[tis]['n_up_mor']:4d} (own size factors) "
          f"DOWN={sec[tis]['n_dn']:4d} (+padj<0.05 {sec[tis]['n_up_padj005']:4d}) ratio={ratio:.3f} "
          f"lfc r={sec[tis]['pearson_lfc']} rho={sec[tis]['spearman_lfc']} J={sec[tis]['jaccard']:.3f}")

conv = pd.DataFrame([dict(
    tissue=t,
    PRIMARY_deposited_lfc05_bm10=prim[t]["n_up"],
    recomputed_scaleanchored_lfc05_bm10=sec[t]["n_up"],
    recomputed_own_sizefactors_lfc05_bm10=sec[t]["n_up_mor"],
    recomputed_gene_wise_dispersion=sec[t]["n_up_gene_wise_disp"],
    primary_plus_padj005=prim[t]["n_up_padj005"], primary_plus_padj010=prim[t]["n_up_padj010"],
    recomputed_plus_padj005=sec[t]["n_up_padj005"], primary_finite_log2FC_only=prim[t]["n_up_finite_only"],
    deposited_DEG_label_U_MaxFilter=prim[t]["labU_Max"], deposited_DEG_label_U_MedianFilter=prim[t]["labU_Median"],
    PRIMARY_genes_down_in_bad=prim[t]["n_dn"], recomputed_genes_down_in_bad=sec[t]["n_dn"],
    baseMean_ratio_anchored_vs_deposited=sec[t]["bm_ratio_anchored"],
    baseMean_ratio_ownSF_vs_deposited=sec[t]["bm_ratio_mor"],
    pearson_r_log2FC=sec[t]["pearson_lfc"], spearman_rho_log2FC=sec[t]["spearman_lfc"],
    jaccard_up_gene_sets=sec[t]["jaccard"], attrib_depositedBM_recomputedLFC=sec[t]["attrib_depBM_recLFC"],
    attrib_recomputedBM_depositedLFC=sec[t]["attrib_recBM_depLFC"]) for t in TISSUES]).set_index("tissue")
print("\n=== CONVERGENCE: genes UP in bad_responder vs Control (positive log2FC) ===")
print(conv.to_string())
UP_COLS = [c for c in conv.columns if c.startswith(("PRIMARY_deposited", "recomputed_", "primary_", "deposited_DEG_label_U"))
           and "down" not in c]        # UP-regulated counts only; down counts are direction diagnostics
argmax = {c: int(conv[c].idxmax()) if False else conv[c].astype(int).idxmax() for c in UP_COLS}
PRIMARY_TISSUE = argmax["PRIMARY_deposited_lfc05_bm10"]
print("\nargmax per UP-gene estimate:")
for c in UP_COLS:
    print(f"  {c:44s} -> {argmax[c]:15s} {'ok' if argmax[c] == PRIMARY_TISSUE else '** DIFFERS **'}")
print(f"stability of the UP-gene ranking: {sum(argmax[c] == PRIMARY_TISSUE for c in UP_COLS)}/{len(UP_COLS)} -> {PRIMARY_TISSUE}")
print("(down-regulated counts are reported as a direction diagnostic, not as an answer to the question)")

sens = []
for tis in TISSUES:
    drop = set(meta.loc[(meta.Tissue == tis) & (meta["mapping rate"] < 80), "Code"])
    c0, c1 = cols(tis, "Control", drop), cols(tis, "bad_responder", drop)
    r = D.run(RAW[:, c0 + c1], np.array([0] * len(c0) + [1] * len(c1)), sf=sf_glob[c0 + c1])
    sens.append(dict(check=f"leave-out mapping-rate<80% ({tis})", dropped=";".join(sorted(drop)) or "none",
                     design=f"{len(c0)}v{len(c1)}", n_up_recomputed=int(stated(r["baseMean"], r["log2FoldChange"]).sum()),
                     reference_recomputed=sec[tis]["n_up"], reference_primary=prim[tis]["n_up"]))
med = np.where(cnt > 0, np.nanmedian(np.where(cnt > 0, cnt, np.nan), axis=1)[:, None], 1.0)
RAWw = np.rint(np.minimum(cnt, 100 * med) * sf_glob[None, :])
for tis in TISSUES:
    c0, c1 = cols(tis, "Control"), cols(tis, "bad_responder")
    r = D.run(RAWw[:, c0 + c1], np.array([0] * len(c0) + [1] * len(c1)), sf=sf_glob[c0 + c1])
    sens.append(dict(check=f"winsorise genes at 100x median, Alas2/Lars2 spikes ({tis})", dropped="capping only",
                     design=f"{len(c0)}v{len(c1)}", n_up_recomputed=int(stated(r["baseMean"], r["log2FoldChange"]).sum()),
                     reference_recomputed=sec[tis]["n_up"], reference_primary=prim[tis]["n_up"]))
b0 = [idx[f"Control_{t}{k}"] for t in ("baseline_blood", "final_blood") for k in range(1, 11)]
b1 = [idx[f"bad_responder_{t}{k}"] for t in ("baseline_blood", "final_blood") for k in range(1, 11)]
cc = b0 + b1
test = np.array([0] * len(b0) + [1] * len(b1)); final = np.array(([0] * 10 + [1] * 10) * 2)
animal = np.array(list(range(1, 11)) * 2 * 2)
X = np.column_stack([((animal == a) & (test == g)).astype(float) for a in range(1, 11) for g in (0, 1)] + [final, test * final])
sub = RAW[:, cc]; sfg = D.size_factors(sub)
ag, _ = D.nb_moments(sub, sfg, test); base = (sub / sfg[None, :]).mean(axis=1)
_, coef, se, p = D.glm_nb(sub, X, D.dispersion_trend(base, np.where(np.isfinite(ag), ag, 1.0)))
lfc_p = coef / np.log(2.0)
sens.append(dict(check="blood paired-by-animal: animal-blocked NB GLM (estimable effect = (final-baseline)x(bad-control))",
                 dropped="none", design="20v20 (20 animals x 2 timepoints)",
                 n_up_recomputed=int(np.nansum(np.isfinite(lfc_p) & (lfc_p > 0.5) & (base > 10))),
                 reference_recomputed=f"{sec['baseline_blood']['n_up']}/{sec['final_blood']['n_up']}",
                 reference_primary=f"{prim['baseline_blood']['n_up']}/{prim['final_blood']['n_up']}"))
print("\n=== SENSITIVITY (separate; does not replace primary) ===")
sdf = pd.DataFrame(sens); print(sdf.to_string(index=False))

out = conv.copy(); out["ANSWER_under_stated_rule"] = ""
out.loc[PRIMARY_TISSUE, "ANSWER_under_stated_rule"] = "MAXIMUM"
out.to_csv("results/deg_counts_by_tissue.csv")
pd.DataFrame([dict(estimate=k, argmax_tissue=v, agrees_with_primary=v == PRIMARY_TISSUE) for k, v in argmax.items()]
             ).to_csv("results/argmax_by_estimate.csv", index=False)
sdf.to_csv("results/sensitivity_checks.csv", index=False)
for tis in TISSUES:
    r = sect[tis]
    pd.DataFrame(dict(GeneID=GENE, baseMean=r["baseMean"], baseMeanA_Control=r["baseMeanA"],
                      baseMeanB_bad_responder=r["baseMeanB"], log2FoldChange=r["log2FoldChange"],
                      dispersion=r["dispersion"], pval=r["pval"], padj=r["padj"])
                 ).assign(up_in_bad_responder_stated_rule=lambda d: (d.log2FoldChange > 0.5) & (d.baseMean > 10)
                 ).to_csv(f"results/recomputed_{tis}_bad_vs_control.csv.gz", index=False, compression="gzip")
print(f"\nANSWER under the stated rule ({RULE}): {PRIMARY_TISSUE}")
print("primary counts: " + ", ".join(f"{t}={prim[t]['n_up']}" for t in TISSUES))
