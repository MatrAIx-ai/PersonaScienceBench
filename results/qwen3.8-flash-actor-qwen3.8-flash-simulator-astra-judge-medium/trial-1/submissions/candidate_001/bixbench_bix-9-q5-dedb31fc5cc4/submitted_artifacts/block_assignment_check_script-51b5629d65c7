"""Independent check of the assumption that blocks 2/5/8 are Control(A) vs bad_responder(B)
in the stated tissues: correlate each block's deposited log2FoldChange with the log ratio of
NormCount group means for every one of the 9 tissue x response groups. The correct (A,B) pair
must maximise the correlation with log2(mean_B - mean_A) and give a positive slope."""
import numpy as np, pandas as pd
nc = pd.read_pickle("results/normcount_raw.pkl")
sn = pd.read_excel("data/Data_deposition_RNAseq_Paroxetine_2017.xlsx", sheet_name="NormCount",
                   header=None, skiprows=3, nrows=1).iloc[0, 2:92].tolist()
cnt = nc[[f"c{j}" for j in range(3, 93)]].apply(pd.to_numeric, errors="coerce")
G = {f"{t}|{g}": cnt.loc[:, [c for c, s in zip(cnt.columns, sn) if s.startswith(f"{g}_{t}")]].mean(axis=1).to_numpy()
     for t in ("baseline_blood", "dentate_gyrus", "final_blood") for g in ("Control", "good_responder", "bad_responder")}
BLOCKS = {1: (99, "baseline_blood"), 2: (108, "baseline_blood"), 3: (117, "baseline_blood"),
          4: (126, "dentate_gyrus"), 5: (135, "dentate_gyrus"), 6: (144, "dentate_gyrus"),
          7: (153, "final_blood"), 8: (162, "final_blood"), 9: (171, "final_blood")}
rows = []
for ci, (s, tis) in BLOCKS.items():
    lfc = pd.to_numeric(nc[f"c{s+4}"], errors="coerce").to_numpy()
    bmA, bmB = pd.to_numeric(nc[f"c{s+1}"], errors="coerce").to_numpy(), pd.to_numeric(nc[f"c{s+2}"], errors="coerce").to_numpy()
    fin = np.isfinite(lfc) & (np.abs(lfc) < 50) & (bmA + bmB > 10)      # expressed genes, finite lfc
    scored = []
    for a in G:
        for b in G:
            if a == b: continue
            man = np.log2((G[b] + 1) / (G[a] + 1))
            r = float(np.corrcoef(lfc[fin], man[fin])[0, 1])
            scored.append((r, a, b))
    scored.sort(reverse=True)
    best = scored[0]
    rows.append(dict(block=ci, tissue_in_header=tis, n_used=int(fin.sum()),
                     best_A=best[1], best_B=best[2], r=round(best[0], 4), runner_up_r=round(scored[1][0], 4),
                     is_this_block_C_vs_bad=(best[1] == f"{tis}|Control" and best[2] == f"{tis}|bad_responder")))
df = pd.DataFrame(rows)
print(df.to_string(index=False))
print("\nblocks 2,5,8 all resolve to (A=Control, B=bad_responder) in their own tissue:",
      bool(df[df.block.isin([2, 5, 8])].is_this_block_C_vs_bad.all()))
df.to_csv("results/block_assignment_check.csv", index=False)
