"""Step 1 (inspection only): structure of Data_deposition_RNAseq_Paroxetine_2017.xlsx.
Prints worksheet layout, the per-sample metadata table, unique-value counts,
NormCount dimensions / identifier column / normalisation check, and decodes the
pre-computed DESeq comparison blocks embedded in NormCount.
No differential-expression conclusions are produced here."""
import openpyxl, pandas as pd, numpy as np

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
TISSUES = ["baseline_blood", "dentate_gyrus", "final_blood"]
GROUPS = ["Control", "good_responder", "bad_responder"]

wb = openpyxl.load_workbook(XLSX, read_only=True, data_only=True)
print("sheets:", wb.sheetnames)

# ---------- Mapping_statistics ----------
m = pd.read_excel(XLSX, sheet_name="Mapping_statistics", header=0)
meta = m[["Index", "Sample ID", "total read", "mapping rate", "Response", "Tissue", "Code",
          "DESeq", "Index_DESeq"]].copy()
meta["animal"] = meta["Sample ID"].str.extract(r"_02_\d+_(\d+)_").astype(int)
meta.to_csv("results/metadata.csv", index=False)
print("\n[Mapping_statistics] real header = row 1; data rows 2-91 ->", meta.shape)
print("Response counts:", meta.Response.value_counts().to_dict())
print("Tissue   counts:", meta.Tissue.value_counts().to_dict())
print("Code: unique =", meta.Code.nunique(), "duplicated =", int(meta.Code.duplicated().sum()))
print(pd.crosstab(meta.Response, meta.Tissue).to_string())
print("mapping rate range: %.1f - %.1f" % (meta["mapping rate"].min(), meta["mapping rate"].max()))
print("samples with mapping rate < 80%:")
print(meta.loc[meta["mapping rate"] < 80, ["Sample ID", "Response", "Tissue", "mapping rate"]]
      .to_string(index=False))
print("animals: unique per tissue =", meta.groupby("Tissue").animal.nunique().to_dict())
print("animals present in all 3 tissues:",
      len(set(meta[meta.Tissue == 'baseline_blood'].animal)
          & set(meta[meta.Tissue == 'dentate_gyrus'].animal)
          & set(meta[meta.Tissue == 'final_blood'].animal)))
print("compact group -> animals table:")
for t in TISSUES:
    for g in GROUPS:
        sub = meta[(meta.Tissue == t) & (meta.Response == g)].sort_values("Index_DESeq")
        print(f"  {t:14s} {g:14s} n={len(sub):2d} idxDESeq {int(sub.Index_DESeq.min())}-{int(sub.Index_DESeq.max())}"
              f" animals={sorted(sub.animal)}")

# ---------- NormCount ----------
ws = wb["NormCount"]
raw, hdr = [], None
for i, r in enumerate(ws.iter_rows(values_only=True), 1):
    if i == 3:
        row3 = r
    if i == 4:
        hdr = r
        continue
    if i >= 5:
        raw.append(r)
nc = pd.DataFrame(raw, columns=[f"c{j+1}" for j in range(len(hdr))])
nc.to_pickle("results/normcount_raw.pkl")
counts = nc[[f"c{j}" for j in range(3, 93)]].apply(pd.to_numeric, errors="coerce")
sample_names = list(hdr[2:92])
print("\n[NormCount] merged group headers on row 1 ('baseline blood' C3, 'dentate gyrus' C33,"
      " 'final blood' C63); sub-labels on row 3; REAL header row = row 4; data rows 5+")
print("genes (rows) x total columns:", nc.shape, "| gene id column = column B 'GeneID'",
      "| unique ids:", nc.c2.nunique(), "| missing:", int(nc.c2.isna().sum()))
print("sample columns = C..CN (3-92) = 90; extra annotation blocks = columns 93-188")
print("counts normalised (non-integer)?  non-integer cells =",
      int(((counts - counts.round()) != 0).values.sum()), "of", int(counts.size),
      "| range %.1f - %.3g" % (counts.min().min(), counts.max().max()))
print("column order identical to metadata Code order:",
      sample_names == meta.sort_values("Index_DESeq").Code.tolist())
print("cells > 1e6 (e.g. Alas2 outlier):", int((counts > 1e6).values.sum()))
print("Max/Median tissue summary == rowmax/rowmedian over the 30 samples of that tissue:",
      bool(np.allclose(pd.to_numeric(nc.c94).values, counts.iloc[:, 30:60].max(axis=1).values)))
blocks = {1: (99, "baseline_blood", "Control", "good_responder"),
          2: (108, "baseline_blood", "Control", "bad_responder"),
          3: (117, "baseline_blood", "bad_responder", "good_responder"),
          4: (126, "dentate_gyrus", "Control", "good_responder"),
          5: (135, "dentate_gyrus", "Control", "bad_responder"),
          6: (144, "dentate_gyrus", "bad_responder", "good_responder"),
          7: (153, "final_blood", "Control", "good_responder"),
          8: (162, "final_blood", "Control", "bad_responder"),
          9: (171, "final_blood", "bad_responder", "good_responder")}
print("\nAuthors' pre-computed DESeq blocks inside NormCount ('exclude outliers'):")
for ci, (s, t, a, b) in blocks.items():
    lfc = pd.to_numeric(nc[f"c{s+4}"], errors="coerce")
    print(f"  Comparison{ci} cols {s}-{s+8}: {t}, log2FC = log2({b}/{a}) | "
          f"labels 'Max' U/D = {(nc[f'c{s+7}']=='U').sum()}/{(nc[f'c{s+7}']=='D').sum()} | "
          f"'Median' U/D = {(nc[f'c{s+8}']=='U').sum()}/{(nc[f'c{s+8}']=='D').sum()}")
    if ci in (2, 5, 8):
        print(f"     -> bad-vs-Control block for {t} "
              f"(baseMean>10 rows: {int((pd.to_numeric(nc[f"c{s}"])>10).sum())}; "
              f"NA log2FC among those: {int(pd.to_numeric(nc[f"c{s+4}"], errors="coerce")[pd.to_numeric(nc[f"c{s}"])>10].isna().sum())})")
