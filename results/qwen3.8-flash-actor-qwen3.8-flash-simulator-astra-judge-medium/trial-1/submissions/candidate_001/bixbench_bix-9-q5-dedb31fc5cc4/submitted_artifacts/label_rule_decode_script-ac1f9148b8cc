"""Decode the deposited 'DEG' label columns (U/D) so the one divergent estimate in the
convergence table can be explained rather than just noted: which rule generated them?"""
import numpy as np, pandas as pd
nc = pd.read_pickle("results/normcount_raw.pkl")
TM = {"baseline_blood": "c93", "dentate_gyrus": "c94", "final_blood": "c95"}
TD = {"baseline_blood": "c96", "dentate_gyrus": "c97", "final_blood": "c98"}
rows = []
for tis, s in [("baseline_blood", 108), ("dentate_gyrus", 135), ("final_blood", 162)]:
    g = lambda k: pd.to_numeric(nc[f"c{s+k}"], errors="coerce").to_numpy(float)
    BM, B, LFC, PADJ = g(0), g(2), g(4), g(6)
    mx = pd.to_numeric(nc[TM[tis]], errors="coerce").to_numpy(float)
    md = pd.to_numeric(nc[TD[tis]], errors="coerce").to_numpy(float)
    labM, labD = (nc[f"c{s+7}"] == "U").to_numpy(), (nc[f"c{s+8}"] == "U").to_numpy()
    keep = np.isfinite(LFC)
    cands = {"stated rule (lfc>0.5 & baseMean>10)": (LFC > 0.5) & (BM > 10),
             "lfc>0.5 & padj<0.05 & tissue-Max>10": (LFC > 0.5) & (PADJ < 0.05) & (mx > 10),
             "lfc>0.5 & padj<0.05 & tissue-Median>10": (LFC > 0.5) & (PADJ < 0.05) & (md > 10)}
    for nm, pr in cands.items():
        pr = np.where(keep, pr, False)
        rows.append(dict(tissue=tis, candidate_rule=nm, n_called=int(pr.sum()),
                         n_label_Max=int(labM.sum()), agreement_with_Max_label=round(float((pr == labM).mean()), 4),
                         n_label_Median=int(labD.sum()), agreement_with_Median_label=round(float((pr == labD).mean()), 4)))
df = pd.DataFrame(rows)
print(df.to_string(index=False))
print("\n-> the two deposited 'DEG' columns are generated with an expression filter on the per-tissue "
      "Max (resp. Median) normalised count, NOT on baseMean>10; they are therefore a different rule "
      "from the question's and are not used as the answer.")
df.to_csv("results/deposited_label_rule_decode.csv", index=False)
