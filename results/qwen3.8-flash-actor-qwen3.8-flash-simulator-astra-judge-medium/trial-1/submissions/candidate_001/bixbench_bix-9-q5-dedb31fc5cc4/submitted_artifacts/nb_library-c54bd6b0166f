"""Minimal DESeq-style negative-binomial differential-expression test (pure numpy).
For the two-group design the NB MLE of the group means is closed form
(sum_i y_i / sum_i sf_i), so log2FC is exact DESeq semantics; dispersion is estimated
by the DESeq moment estimator with a fitted mean-dispersion trend (sharingMode='fitting')
and a gene-wise ('mle') variant for robustness; the group contrast is a Wald test with
Benjamini-Hochberg adjusted p-values.
"""
import numpy as np
from scipy.stats import norm

LN2 = np.log(2.0)

def size_factors(raw):
    """DESeq median-of-ratios size factors. raw: genes x samples (counts)."""
    with np.errstate(divide="ignore", invalid="ignore"):
        lg = np.log(np.where(raw > 0, raw, np.nan))
        ref = np.nanmean(lg, axis=1)
        ok = np.isfinite(ref)
        ratios = lg[ok] - ref[ok, None]
        sf = np.exp(np.nanmean(ratios, axis=0))
    sf = np.where(np.isfinite(sf) & (sf > 0), sf, 1.0)
    return sf / np.exp(np.mean(np.log(sf)))

def nb_moments(counts, sf, grp):
    """DESeq moment estimator of dispersion per gene (counts: raw counts, grp: 0/1 mask)."""
    mu = np.zeros_like(counts, dtype=float)
    for m in (grp == 0, grp == 1):
        tot_c, tot_s = counts[:, m].sum(axis=1), sf[m].sum()
        mu[:, m] = (tot_c / tot_s)[:, None] * sf[m][None, :]
    n = counts.shape[1]; ng = 2
    ssd = ((counts - mu) ** 2).sum(axis=1)
    num = ssd - mu.sum(axis=1)
    den = (mu ** 2).sum(axis=1)
    with np.errstate(divide="ignore", invalid="ignore"):
        a = num / den
    a = a * n / (n - ng)                       # moment degrees-of-freedom correction
    return np.clip(np.where(np.isfinite(a), a, np.nan), 1e-8, 10.0), mu

def dispersion_trend(base_mean, alpha, min_bm=1.0, window=201):
    """Fitted dispersion trend: rolling median of gene-wise alphas over baseMean (as in DESeq)."""
    order = np.argsort(base_mean)
    a, b = alpha[order], base_mean[order]
    use = np.isfinite(a) & (b >= min_bm)
    if use.sum() < 50:
        return np.full_like(base_mean, np.nanmedian(alpha))
    fa = pd_roll_median(a[use], window)
    fb = b[use]
    trend = np.interp(base_mean, fb, fa)
    trend = np.where(np.isfinite(trend) & (trend > 1e-8), trend, np.nanmedian(a[use]))
    out = np.empty_like(base_mean)
    out[:] = trend
    out[b.min() > base_mean] = np.median(fa[:max(3, len(fa) // 50)])   # low-expression flat part
    return out

def pd_roll_median(x, w):
    import pandas as pd
    return pd.Series(x).rolling(w, center=True, min_periods=10).median().to_numpy()

def wald(counts, sf, grp, alpha, minmu=1e-8):
    """Closed-form NB MLE group means (exact for the two-group log-link design) plus a
    Wald test for log2FC(group1/group0)."""
    G = counts.shape[0]
    mean = np.zeros((G, 2))
    for j, m in enumerate((grp == 0, grp == 1)):
        mean[:, j] = counts[:, m].sum(axis=1) / max(sf[m].sum(), 1e-12)
    with np.errstate(divide="ignore", invalid="ignore"):
        lfc = np.log2(np.where(mean[:, 1] > 0, mean[:, 1], np.nan) /
                      np.where(mean[:, 0] > 0, mean[:, 0], np.nan))
    base_mean = (counts / sf[None, :]).mean(axis=1)
    mu = np.where(grp[None, :] == 1, mean[:, 1][:, None], mean[:, 0][:, None]) * sf[None, :]
    with np.errstate(divide="ignore", invalid="ignore"):
        w = mu / (1.0 + alpha[:, None] * mu)                # NB IRLS weight for the log link
    w = np.where(np.isfinite(w) & (w > 0), w, 0.0)
    i00 = w.sum(axis=1); i01 = w[:, grp == 1].sum(axis=1); i11 = i01
    det = i00 * i11 - i01 ** 2
    p = np.full(G, np.nan); z = np.full(G, np.nan)
    valid = np.isfinite(lfc) & (base_mean > minmu) & np.isfinite(alpha) & (alpha > 0) & (det > 0)
    with np.errstate(divide="ignore", invalid="ignore"):
        var_b = i00 / det                                   # Var of the group-1 coefficient
        zz = np.zeros(G); zz[valid] = (lfc[valid] * LN2) / np.sqrt(var_b[valid])
    z[valid] = zz[valid]
    p[valid] = 2 * norm.sf(np.abs(zz[valid]))
    return dict(baseMean=base_mean, baseMeanA=mean[:, 0], baseMeanB=mean[:, 1],
                log2FoldChange=lfc, pval=p, z=z)


def bh(p):
    ok = np.isfinite(p)
    q = np.full(len(p), np.nan)
    pv = p[ok]; n = len(pv); o = np.argsort(pv)
    adj = pv[o] * n / np.arange(1, n + 1)
    adj = np.minimum.accumulate(adj[::-1])[::-1]
    full = np.empty(n); full[o] = np.clip(adj, 0, 1)
    q[ok] = full
    return q

def run(counts, grp, sharing="fitting", sf=None):
    """counts: genes x samples raw counts; grp: 0=control, 1=test. Returns result table.
    If sf is given it is used as-is (anchored normalisation, keeps the deposited baseMean
    scale); otherwise DESeq median-of-ratios size factors are estimated from `counts`."""
    if sf is None:
        sf = size_factors(counts)
    sf = np.asarray(sf, float)
    alpha_gw, _ = nb_moments(counts, sf, grp)
    base = (counts / sf[None, :]).mean(axis=1)
    trend = dispersion_trend(base, np.where(np.isfinite(alpha_gw), alpha_gw, 1.0))
    alpha = trend if sharing == "fitting" else np.fmax(alpha_gw, 1e-6)
    res = wald(counts, sf, grp, alpha)
    res["dispersion"] = alpha; res["dispersion_gene_wise"] = alpha_gw
    res["padj"] = bh(res["pval"])
    res["size_factors"] = sf
    return res


def glm_nb(counts, X, alpha, max_iter=60, tol=1e-9, ridge=1e-6):
    """Negative-binomial GLM by IRLS with a log link.
    counts: genes x n raw counts; X: n x p design matrix (no offsets needed);
    alpha: genes x 1 dispersion. Returns (beta, coef of LAST column, its SE, p-values).
    NB variance = mu + alpha*mu^2  ->  IRLS weight w = mu/(1+alpha*mu)."""
    import numpy as np
    from scipy.stats import norm as _norm
    G, n = counts.shape
    p = X.shape[1]
    Y = counts.astype(float)
    keep = Y.sum(axis=1) > 0
    idx = np.where(keep)[0]
    y = Y[idx]
    a = np.maximum(alpha[idx], 1e-8)[:, None]
    start = np.maximum(y.mean(axis=1, keepdims=True), 1e-3)
    b = np.tile(np.log(start), (1, p))
    b[:, 1:] = 0.0
    I = np.eye(p)
    for _ in range(max_iter):
        eta = np.clip(b @ X.T, -30, 30)
        mu = np.exp(eta)
        w = mu / (1.0 + a * mu)                       # genes x n
        z = eta + (y - mu) / np.maximum(mu, 1e-12)
        WX = w[:, :, None] * X[None, :, :]            # genes x n x p
        A = WX.transpose(0, 2, 1) @ X                 # genes x p x p
        A = A + ridge * I[None]
        rhs = WX.transpose(0, 2, 1) @ (z[:, :, None])  # genes x p x 1
        b_new = np.linalg.solve(A, rhs)[:, :, 0]
        if np.nanmax(np.abs(b_new - b)) < tol:
            b = b_new
            break
        b = b_new
    eta = np.clip(b @ X.T, -30, 30)
    mu = np.exp(eta)
    w = mu / (1.0 + a * mu)
    A = (w[:, :, None] * X[None]).transpose(0, 2, 1) @ X + ridge * I[None]
    cov = np.linalg.inv(A)
    coef = np.full(G, np.nan); se = np.full(G, np.nan); pv = np.full(G, np.nan)
    beta = np.zeros((G, p)); beta[idx] = b
    coef[idx] = b[:, -1]
    se[idx] = np.sqrt(np.maximum(cov[:, -1, -1], 0))
    with np.errstate(divide="ignore", invalid="ignore"):
        pv[idx] = 2 * _norm.sf(np.abs(coef[idx] / se[idx]))
    return beta, coef, se, pv
