#!/usr/bin/env bash
# Full pipeline for: "In which tissue do bad responders show the highest number of
# significantly DE genes (lfc>0.5, baseMean>10) compared to controls?"
# 1 inspection -> 2 cache raw counts -> 3 block-assignment check -> 4 label-rule decode
# -> 5 MAIN (primary deposited + independent recomputation + sensitivity) -> 6 stability jackknife
set -euo pipefail
python analysis/inspect_inputs.py > results/01_inspection.log
python analysis/reconstruct_counts.py > results/02_reconstruct.log
python analysis/verify_block_assignment.py > results/03_block_assignment.log
python analysis/decode_deposited_labels.py > results/04_label_decode.log
python analysis/deseq_bad_vs_control.py > results/05_main.log
python analysis/stability_jackknife.py > results/06_stability.log
echo "pipeline complete"
