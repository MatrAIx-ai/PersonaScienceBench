"""Quantify RANKING stability: leave-one-animal-out (the animal index k is shared across the
three tissues: Control_<tissue>k / bad_responder_<tissue>k are the same animal), recompute the
bad-vs-Control contrast per tissue and check whether dentate gyrus stays the maximum.
Also checks the lead of the winner over the runner-up, and a bootstrap over genes is not used
because the count is a deterministic function of the selected sample set."""
import sys, warnings, numpy as np, pandas as pd
warnings.filterwarnings("ignore"); sys.path.insert(0, "analysis")
import deseq_nb as D

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
TISSUES = ["baseline_blood", "dentate_gyrus", "final_blood"]
nc = pd.read_pickle("results/normcount_raw.pkl")
meta = pd.read_csv("results/metadata.csv").sort_values("Index_DESeq").reset_index(drop=True)
sn = pd.read_excel(XLSX, sheet_name="NormCount", header=None, skiprows=3, nrows=1).iloc[0, 2:92].tolist()
idx = {s: i for i, s in enumerate(sn)}
cnt = nc[[f"c{j}" for j in range(3, 93)]].apply(pd.to_numeric, errors="coerce").to_numpy()
sf = meta["total read"].to_numpy(float) / cnt.sum(axis=0); sf /= np.exp(np.log(sf).mean())
RAW = np.rint(cnt * sf[None, :])
dep = {t: (pd.to_numeric(nc[f"c{s}"], errors="coerce").to_numpy(float),
           pd.to_numeric(nc[f"c{s+4}"], errors="coerce").to_numpy(float))
       for t, s in zip(TISSUES, (108, 135, 162))}
prim = {t: int(((l > 0.5) & (b > 10) & np.isfinite(b)).sum()) for t, (b, l) in dep.items()}
print("primary (deposited, stated rule):", prim, "-> argmax", max(prim, key=prim.get))

rows = []
for k in [None] + list(range(1, 11)):
    counts = {}
    for t in TISSUES:
        keepK = [i for i in range(1, 11) if i != k]
        c0 = [idx[f"Control_{t}{i}"] for i in keepK]
        c1 = [idx[f"bad_responder_{t}{i}"] for i in keepK]
        r = D.run(RAW[:, c0 + c1], np.array([0] * len(c0) + [1] * len(c1)), sf=sf[c0 + c1])
        counts[t] = int((np.isfinite(r["baseMean"]) & (r["baseMean"] > 10) & (r["log2FoldChange"] > 0.5)).sum())
    arg = max(counts, key=counts.get)
    vals = sorted(counts.values(), reverse=True)
    rows.append(dict(dropped_animal=("none (full 10v10)" if k is None else k), **counts, argmax=arg,
                     winner_minus_runnerup=vals[0] - vals[1], ratio_winner_over_runnerup=round(vals[0] / max(vals[1], 1), 2)))
df = pd.DataFrame(rows)
print(df.to_string(index=False))
agree = int((df.argmax == "dentate_gyrus").sum())
print(f"\ndentate gyrus is the argmax in {agree}/{len(df)} sample-set perturbations "
      f"(leave-one-animal-out jackknife, independent recomputation)")
print("minimum winner-minus-runner-up lead across perturbations:", int(df.winner_minus_runnerup.min()),
      " minimum ratio:", df.ratio_winner_over_runnerup.min())
df.to_csv("results/stability_jackknife.csv", index=False)
