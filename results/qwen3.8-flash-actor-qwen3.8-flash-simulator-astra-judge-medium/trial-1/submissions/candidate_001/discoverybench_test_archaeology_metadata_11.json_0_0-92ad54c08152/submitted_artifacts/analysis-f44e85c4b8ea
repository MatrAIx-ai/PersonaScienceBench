def chart(col, name):
    sub = b[(b.BCE>=1200)&(b.BCE<=2200)].copy()
    lo,hi = min(b.F.min(),b.D.min()), max(b.F.max(),b.D.max())   # shared axis for both panels
    W = 60
    lines=[f"  {name}  (shared axis {lo:+.2f} .. {hi:+.2f} across BOTH panels; '|' = zero)"]
    zero = int(round((0-lo)/(hi-lo)*(W-1)))
    for _,r in sub.iterrows():
        v = r[col]; pos = int(round((v-lo)/(hi-lo)*(W-1)))
        row = [" "]*W; row[pos] = "*"
        row[zero] = "|" if row[zero]==" " else "+"
        mark = "  <== EVENT" if r.BCE==1700 else ""
        lines.append(f"  {int(r.BCE):>5} BCE [{r[col]:+5.2f}] " + "".join(row) + mark)
    return "\n".join(lines)
