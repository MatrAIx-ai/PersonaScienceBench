"""Pottery FORM collapse vs DECORATION increase: timing of simultaneous change.
Primary: 37-point 100-yr binned raw Z (PotteryForm/PotteryDecoration == ZKeform/Zkeverz).
Robustness: interpolated/rolling (resolution-invariance only). Window 4100-500 BCE."""
import numpy as np, pandas as pd
OUT = []
def say(*a):
    s = " ".join(str(x) for x in a); OUT.append(s); print(s)
pd.set_option("display.width", 200)

ts = pd.read_csv("data/time_series_data.csv", index_col=0)
cap = pd.read_csv("data/capital.csv", decimal=",")
pol = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")

say("="*78); say("0. DATA LOADED / GRIDS"); say("="*78)
say(f"time_series: {ts.shape} | CE {ts.CE.min()}..{ts.CE.max()} | annual steps {sorted(ts.CE.diff().dropna().unique())}")
say(f"capital    : {cap.shape} | BCE {cap.BCE.max()}..{cap.BCE.min()} | steps {sorted(cap.BCE.diff().dropna().unique())}")
say(f"pollen     : {pol.shape} | CE {pol.CE.min()}..{pol.CE.max()} | reverse-ordered")
say(f"calBP datum (calBP+CE): ts {sorted((ts.calBP+ts.CE).unique())}, pollen {sorted((pol.calBP+pol.CE).unique())}")
say(f"missing: Form {ts.PotteryForm.isna().sum()}, Decor {ts.PotteryDecoration.isna().sum()}, "
    f"Form_inter {ts.PotteryForm_inter.isna().sum()}, Decor_inter {ts.PotteryDecoration_inter.isna().sum()} of {len(ts)}")

b = ts.dropna(subset=["PotteryForm","PotteryDecoration"])[["CE","calBP","PotteryForm","PotteryDecoration"]].reset_index(drop=True)
b["BCE"] = -b.CE; b = b.rename(columns={"PotteryForm":"F","PotteryDecoration":"D"})
say(""); say("="*78); say(f"1. PRIMARY SERIES: 100-yr bins, 4100-500 BCE ({len(b)} bins)"); say("="*78)
cx = cap.set_index("BCE")[["ZKeform","Zkeverz"]]
j = b.set_index("BCE")[["F","D"]].join(cx, how="left")
say(f"cross-file vs capital.csv: max|F-ZKeform|={(j.F-j.ZKeform).abs().max():.3g}, max|D-Zkeverz|={(j.D-j.Zkeverz).abs().max():.3g}")
say(f"bins only in capital.csv: {sorted(set(cap.BCE)-set(b.BCE))}")
say(""); say(b[["BCE","calBP","F","D"]].to_string(index=False))
say(f"\nform : mean {b.F.mean():+.3f} sd {b.F.std():.3f} range [{b.F.min():+.2f},{b.F.max():+.2f}]")
say(f"decor: mean {b.D.mean():+.3f} sd {b.D.std():.3f} range [{b.D.min():+.2f},{b.D.max():+.2f}]")
post = b.loc[b.BCE<=1700]
say(f"form floor {b.F.min():+.2f} occurs {(b.F==b.F.min()).sum()}x total; "
    f"after 1700 BCE inclusive: n_bins={len(post)}, distinct form values={sorted(post.F.unique())} (n={post.F.nunique()}), "
    f"distinct decor values={sorted(post.D.unique())} (n={post.D.nunique()})")
say(f"strictly after 1700 BCE (<=1600): distinct form={sorted(b.loc[b.BCE<=1600,'F'].unique())}")

b["dF"]=b.F.diff(); b["dD"]=b.D.diff(); sF,sD=b.dF.std(),b.dD.std()
b["zF"]=b.dF/sF; b["zD"]=b.dD/sD; b["contrast"]=b.zD-b.zF
b["pF"]=b.F.rank(pct=True); b["pD"]=b.D.rank(pct=True)
b["below_mean_F"]=b.F<b.F.mean(); b["above_mean_D"]=b.D>b.D.mean()
say(""); say("="*78); say("2. FULL PER-BIN TRANSITION TABLE (36 transitions)"); say("="*78)
say(f"sd(Delta form)={sF:.4f}  sd(Delta decor)={sD:.4f}")
tt = b.iloc[1:][["BCE","F","dF","zF","D","dD","zD","contrast","pF","pD"]]
say(tt.round(3).to_string(index=False))
say("\n-- opposite-signed bins (form DOWN & decor UP) --")
say(tt[(tt.zF<0)&(tt.zD>0)].round(3).to_string(index=False))
say("\n-- same-signed large co-moving bins (NOT the asked event) --")
say(tt[((tt.zF<=-1)&(tt.zD<=-1))|((tt.zF>=1)&(tt.zD>=1))][["BCE","zF","zD"]].round(3).to_string(index=False))
# ---- 3. primary criterion -------------------------------------------------
def persist(vals, start_bce, n=3):
    i = b.index[b.BCE==start_bce][0]
    return i+n-1 < len(b) and bool(np.all(vals[i:i+n]))
pFv = b.below_mean_F.values; pDv = b.above_mean_D.values
b["collapse"] = (b.zF<=-1)&b.below_mean_F&np.array([persist(pFv,x) for x in b.BCE])
b["increase"] = (b.zD>=1)&b.above_mean_D&np.array([persist(pDv,x) for x in b.BCE])
b["event"] = b.collapse & b.increase
say(""); say("="*78); say("3. PRIMARY CRITERION: |Delta z|>=1 + level vs mean + persistence>=3 bins"); say("="*78)
say(f"BINS MEETING BOTH (simultaneous): {list(b.loc[b.event,'BCE'])}")
say(f"FORM COLLAPSE only : {list(b.loc[b.collapse&~b.increase,'BCE'])}")
say(f"DECOR INCREASE only: {list(b.loc[b.increase&~b.collapse,'BCE'])}")
if b.event.any():
    i = int(np.where(b.event.values)[0][0]); e = b.iloc[i]
    say(f"\nEVENT BIN: {int(e.BCE)} BCE (CE {int(e.CE)}, calBP {int(e.calBP)})")
    say(f"  form : {b.F.iloc[i-1]:+.2f} -> {e.F:+.2f}  Delta {e.dF:+.2f}  z {e.zF:+.2f}")
    say(f"  decor: {b.D.iloc[i-1]:+.2f} -> {e.D:+.2f}  Delta {e.dD:+.2f}  z {e.zD:+.2f}")
    j = min(i+2, len(b)-1)
    say(f"  persistence: form {int(b.BCE.iloc[i])}-{int(b.BCE.iloc[j])} BCE all below form mean "
        f"({b.F.mean():+.3f}); decor same bins all above decor mean ({b.D.mean():+.3f})")
    say("  CAVEAT: the sustained low form level sits exactly on the repeated floor value "
        f"{b.F.min():+.2f}; persistence confirms a SUSTAINED LOW LEVEL but cannot by itself separate a "
        f"genuine collapse from a Z-transform floor.")

# ---- 4. threshold sweep ---------------------------------------------------
say(""); say("="*78); say("4. THRESHOLD SWEEP"); say("="*78)
for thr in (0.75,1.0,1.5,2.0):
    cl = (b.zF<=-thr)&b.below_mean_F&np.array([persist(pFv,x) for x in b.BCE])
    inc= (b.zD>= thr)&b.above_mean_D&np.array([persist(pDv,x) for x in b.BCE])
    say(f"thr={thr:<5} full criterion -> {list(b.loc[cl&inc,'BCE'])!s:<12} "
        f"form-only -> {list(b.loc[cl,'BCE'])!s:<14} decor-only -> {list(b.loc[inc,'BCE'])!s:<14} "
        f"direction-only -> {list(b.loc[(b.zF<=-thr)&(b.zD>=thr),'BCE'])}")
say("\ncontrast |z_decor - z_form| ranking, top 6:")
say(b.reindex(b.contrast.abs().sort_values(ascending=False).index)[["BCE","zF","zD","contrast"]].head(6).round(3).to_string(index=False))

# ---- 5. variants ----------------------------------------------------------
say(""); say("="*78); say("5. VARIANTS: percentile-break, smoothing, alt baselines"); say("="*78)
say("(a) percentile-break variant -- TIE DIAGNOSTIC FIRST")
say(f"    form level {b.F.min():+.2f} is tied {int((b.F==b.F.min()).sum())} of {len(b)} bins and decor level +0.97 is tied "
    f"{int((b.D==0.97).sum())} of {len(b)}, so average-tie percentiles are compressed: at 1700 BCE "
    f"pF={b.pF[b.BCE==1700].iloc[0]:.3f} (not <=0.10) and pD={b.pD[b.BCE==1700].iloc[0]:.3f}.")
say(f"    -> strict P10/P75 + direction returns {list(b.loc[(b.pF<=0.10)&(b.pD>=0.75)&(b.dF<0)&(b.dD>0),'BCE'])}: EMPTY, "
    f"a mechanical artefact of the ties, NOT evidence against 1700 BCE.")
say(f"    tie-robust version 1, percentile break at P25/P75 + direction -> "
    f"{list(b.loc[(b.pF<=0.25)&(b.pD>=0.75)&(b.dF<0)&(b.dD>0),'BCE'])}")
say(f"    tie-robust version 2, dense-rank percentiles P10/P75 + direction -> "
    f"{list(b.loc[(b.F.rank(pct=True,method='dense')<=0.10)&(b.D.rank(pct=True,method='dense')>=0.75)&(b.dF<0)&(b.dD>0),'BCE'])}")
say(f"    tie-robust version 3, percentiles OF THE CHANGES (Delta form lowest 10% & Delta decor top 10%) -> "
    f"{list(b.loc[(b.dF.rank(pct=True)<=0.10)&(b.dD.rank(pct=True)>=0.90),'BCE'])}")
s2=b.copy(); s2["F2"]=b.F.rolling(2).mean(); s2["D2"]=b.D.rolling(2).mean()
s2["zF2"]=s2.F2.diff()/s2.F2.diff().std(); s2["zD2"]=s2.D2.diff()/s2.D2.diff().std(); s2["c2"]=s2.zD2-s2.zF2
say("\n(b) 2-bin-smoothed series, top 6 by |contrast| (label = later bin of the pair):")
say(s2.reindex(s2.c2.abs().sort_values(ascending=False).index)[["BCE","zF2","zD2","c2"]].head(6).round(3).to_string(index=False))
mF=b.F<b.F.median(); mD=b.D>b.D.median()
say(f"\n(c1) median-based levels instead of means -> {list(b.loc[(b.zF<=-1)&mF&(b.zD>=1)&mD,'BCE'])}")
madF=(b.dF-b.dF.median()).abs().median(); madD=(b.dD-b.dD.median()).abs().median()
zmF=(b.dF-b.dF.median())/(1.4826*madF); zmD=(b.dD-b.dD.median())/(1.4826*madD)
say(f"(c2) robust MAD-z of Deltas, |z|>=1 opposite signs -> {list(b.loc[(zmF<=-1)&(zmD>=1),'BCE'])} "
    f"(at 1700 BCE: zF={zmF[b.BCE==1700].iloc[0]:+.2f}, zD={zmD[b.BCE==1700].iloc[0]:+.2f})")
rzF=b.dF.rank(pct=True); rzD=b.dD.rank(pct=True)
say(f"(c3) rank-based (form Delta lowest 10% & decor Delta top 10%) -> {list(b.loc[(rzF<=0.10)&(rzD>=0.90),'BCE'])}")
trim=b[b.BCE<=4000].copy()
say(f"(c4) window trimmed to 4000-500 BCE (drops the two floor-start bins): opposite-signed |z|>=1 -> "
    f"{list(trim.loc[(trim.zF<=-1)&(trim.zD>=1),'BCE'])}; at 1700 BCE zF={trim.loc[trim.BCE==1700,'zF'].iloc[0]:+.2f}, "
    f"zD={trim.loc[trim.BCE==1700,'zD'].iloc[0]:+.2f}")
cx2=cap.sort_values("BCE",ascending=False).reset_index(drop=True)
say(f"(c5) capital-only bins 4300/4200 BCE: form {cx2.ZKeform[0]:+.2f}->{cx2.ZKeform[1]:+.2f} (Delta {cx2.ZKeform[1]-cx2.ZKeform[0]:+.2f}), "
    f"decor {cx2.Zkeverz[0]:+.2f}->{cx2.Zkeverz[1]:+.2f} (Delta {cx2.Zkeverz[1]-cx2.Zkeverz[0]:+.2f}) "
    f"-> same-signed rise, not a candidate; adding them does not create a competing event")
# 3-bin centred smoothing
s3=b.copy(); s3["F3"]=b.F.rolling(3,center=True).mean(); s3["D3"]=b.D.rolling(3,center=True).mean()
s3["zF3"]=s3.F3.diff()/s3.F3.diff().std(); s3["zD3"]=s3.D3.diff()/s3.D3.diff().std(); s3["c3"]=s3.zD3-s3.zF3
say("\n(b2) 3-bin centred smoothing, top 4 by |contrast|:")
say(s3.reindex(s3.c3.abs().sort_values(ascending=False).index)[["BCE","zF3","zD3","c3"]].head(4).round(3).to_string(index=False))
# ---- 6. resolution-invariance (derived annual series) ---------------------
say(""); say("="*78); say("6. RESOLUTION-INVARIANCE CHECK (derived *_inter series; confirmatory only)"); say("="*78)
a = ts[["CE","PotteryForm_inter","PotteryDecoration_inter"]].copy(); a["BCE"]=-a.CE
a["dF50"]=a.PotteryForm_inter.diff(50); a["dD50"]=a.PotteryDecoration_inter.diff(50)
sdF,sdD=a.dF50.std(),a.dD50.std()
say(f"50-yr change on interpolated series: sd(form)={sdF:.4f} sd(decor)={sdD:.4f}")
w=a[(a.BCE>=1500)&(a.BCE<=1900)].copy(); w["zF"]=w.dF50/sdF; w["zD"]=w.dD50/sdD
w=w.dropna(subset=["zF","zD"]).assign(c=lambda d:d.zD-d.zF)
say("top 3 annual points by |contrast| within 1900-1500 BCE:")
say(w.reindex(w.c.abs().sort_values(ascending=False).index)[["BCE","zF","zD","c"]].head(3).round(3).to_string(index=False))
wa=a.dropna(subset=["dF50","dD50"])
say(f"whole-window (4100-500 BCE) max-|contrast| year on interpolated series: "
    f"{int(wa.reindex(wa.c.abs().sort_values(ascending=False).index if 'c' in wa else (wa.dD50/sdD-wa.dF50/sdF).abs().sort_values(ascending=False).index).BCE.iloc[0])} BCE"
    if False else "")
wc=wa.assign(c=wa.dD50/sdD-wa.dF50/sdF)
say(f"whole-window max-|contrast| year on interpolated series: {int(wc.reindex(wc.c.abs().sort_values(ascending=False).index).BCE.iloc[0])} BCE "
    f"(range of top-100 |contrast| years: {int(wc.reindex(wc.c.abs().sort_values(ascending=False).index).BCE.iloc[0])}-"
    f"{int(wc.reindex(wc.c.abs().sort_values(ascending=False).index).BCE.iloc[99])} BCE)")
w2=a[(a.BCE>=1500)&(a.BCE<=1900)]
say(f"share of annual points in 1900-1500 BCE with form falling AND decor rising: "
    f"{((w2.dF50<0)&(w2.dD50>0)).mean():.3f} (n={len(w2)})")
say(f"interpolated form crosses below its own full-window mean at {int(a.loc[(a.BCE<=1800)&(a.PotteryForm_inter<a.PotteryForm_inter.mean()),'BCE'].max())} BCE")
say(f"interpolated decor crosses above its own full-window mean at {int(a.loc[(a.BCE<=1800)&(a.PotteryDecoration_inter>a.PotteryDecoration_inter.mean()),'BCE'].max())} BCE")
say("Both crossings occur in the same 100-yr interval -> identical to the binned result.")
say("NOTE: *_inter is a linear re-expansion of the same 37 bins (max|raw-inter|=0 at bins, constant slope within gaps); "
    "it adds no information and is reported only to show resolution-invariance.")

# ---- 7. event window values ----------------------------------------------
say(""); say("="*78); say("7. EVENT WINDOW VALUES 1900-1500 BCE, BIN BY BIN"); say("="*78)
say(b[(b.BCE>=1500)&(b.BCE<=1900)][["BCE","calBP","F","dF","zF","D","dD","zD"]].round(3).to_string(index=False))
i=int(b.index[b.BCE==1700][0])
pre_F,post_F=b.F.iloc[i-3:i].mean(),b.F.iloc[i:i+3].mean()
pre_D,post_D=b.D.iloc[i-3:i].mean(),b.D.iloc[i:i+3].mean()
def d(a_,b_):
    p=np.sqrt((a_.var()+b_.var())/2); return (b_.mean()-a_.mean())/p
say(f"\npre-event 3 bins (2000,1900,1800 BCE): form {pre_F:+.3f} | decor {pre_D:+.3f}")
say(f"post-event 3 bins (1700,1600,1500 BCE): form {post_F:+.3f} | decor {post_D:+.3f}")
say(f"level shift: form {post_F-pre_F:+.3f} Z | decor {post_D-pre_D:+.3f} Z")
say(f"pooled-sd effect sizes: form d={d(b.F.iloc[i-3:i],b.F.iloc[i:i+3]):+.2f} | decor d={d(b.D.iloc[i-3:i],b.D.iloc[i:i+3]):+.2f}")
say(f"direction agreement over the 36 transitions: corr(Delta form, Delta decor) = {b.dF.corr(b.dD):+.3f}; "
    f"corr(form, decor) levels = {b.F.corr(b.D):+.3f}")
say(f"post-1700 BCE form is constant at the floor (0 further change in 12 bins); decor rises again at 1000 BCE "
    f"({b.loc[b.BCE==1000,'D'].iloc[0]:+.2f}, Delta {b.loc[b.BCE==1000,'dD'].iloc[0]:+.2f}, z {b.loc[b.BCE==1000,'zD'].iloc[0]:+.2f}) "
    f"with form unchanged -> second, weaker decoration increase without a form collapse.")

# ---- 8. century conversion ------------------------------------------------
say(""); say("="*78); say("8. CENTURY CONVERSION"); say("="*78)
for y in (1800,1701,1700,1650,1601,1600): say(f"  {y} BCE -> century {(y-1)//100+1} BCE")
say("Bin labelled 1700 BCE spans 1700-1601 BCE (calBP 3650-3551) = 17th century BCE.")
say("The change is registered between the 1800 BCE and 1700 BCE bins, i.e. it unfolds during 1800-1700 BCE.")

# ---- 9. pollen covariate --------------------------------------------------
say(""); say("="*78); say("9. POLLEN OPENNESS COVARIATE (descriptive context)"); say("="*78)
pol=pol.sort_values("CE").reset_index(drop=True)
say(f"raw Belau_PC1: {pol.Belau_PC1.notna().sum()}/{len(pol)} years ({pol.Belau_PC1.isna().mean()*100:.1f}% missing); "
    f"raw Woserin_PC1: {pol.Woserin_PC1.notna().sum()}/{len(pol)}")
for lo,hi in ((1800,1600),):
    s=pol[(pol.CE>=-lo)&(pol.CE<=-hi)]
    rraw=pol.dropna(subset=["Belau_PC1"]).reset_index(drop=True); tin=ts[(ts.CE<=-hi)&(ts.CE>=-lo)]
    say(f"raw Belau_PC1 rows inside {lo}-{hi} BCE in the pollen file: {s.Belau_PC1.notna().sum()} "
        f"(nearest raw obs: {int(-rraw.CE.iloc[(-rraw.CE-1700).abs().idxmin()])} BCE; spacing ~19-20 yr, "
        f"none exactly on a bin boundary) -> bin-boundary values must come from *_inter")
    say(f"raw time_series 'pollen' obs inside {lo}-{hi} BCE: {tin.pollen.notna().sum()} "
        f"(values {np.round(tin.pollen.dropna().values,2)}; range {tin.pollen.min():+.2f}..{tin.pollen.max():+.2f} "
        f"-> noisy, no monotone shift at 1700 BCE)")
pw=pol[(pol.CE<=-1600)&(pol.CE>=-1800)]
tr=np.polyfit(pw.CE,pw.Belau_PC1_inter,1)[0]
say(f"Belau_PC1_inter 1800->1600 BCE: {pw.Belau_PC1_inter.iloc[0]:+.3f} -> {pw.Belau_PC1_inter.iloc[-1]:+.3f} "
    f"(range {pw.Belau_PC1_inter.min():+.3f}..{pw.Belau_PC1_inter.max():+.3f}); slope {tr:+.5f} per calendar year "
    f"({'RISING' if tr<0 else 'FALLING'} toward younger ages, since CE decreases with time)")
rows=[]
for y in (2000,1900,1800,1700,1600,1500):
    r=pol[pol.CE==-y]
    if len(r): r=r.iloc[0]; rows.append(dict(BCE=y,Belau_PC1_inter=r.Belau_PC1_inter,Woserin_PC1_inter=r.Woserin_PC1_inter,
        MEAN=r.MEAN,SMOOTH_100y=r.SMOOTH_MEAN_100y))
say("\npollen openness at the 100-yr bin marks:")
say(pd.DataFrame(rows).round(3).to_string(index=False))
tsp=ts.assign(BCE=-ts.CE); q=tsp[(tsp.BCE>=1500)&(tsp.BCE<=1900)]
say(f"\ntime_series pollen_inter 1900-1500 BCE: {q.pollen_inter.min():+.3f}..{q.pollen_inter.max():+.3f} (mean {q.pollen_inter.mean():+.3f}); "
    f"raw 'pollen' obs in window: {q.pollen.notna().sum()}")
for y in (2000,1800,1700,1600,1500):
    r=tsp[tsp.BCE==y].iloc[0]
    say(f"  {y} BCE: pollen_inter {r.pollen_inter:+.3f} | pollen_inter_100 {r.pollen_inter_100:+.3f} | pollen_grate_100 "
        f"{r.pollen_grate_100:+.6f} -> {'POSITIVE (rising openness)' if r.pollen_grate_100>0 else 'NEGATIVE (falling openness)'}")
segw = tsp[(tsp.BCE>=1500)&(tsp.BCE<=2000)]
say(f"event-window level of pollen_inter_100 (2000-1500 BCE): mean {segw.pollen_inter_100.mean():+.3f} vs full-window mean "
    f"{tsp.pollen_inter_100.mean():+.3f} (full-window P10/P90 = {np.percentile(tsp.pollen_inter_100,10):+.2f}/{np.percentile(tsp.pollen_inter_100,90):+.2f}) "
    f"-> openness is HIGH relative to the long run but the local trajectory 2000->1500 BCE is "
    f"{'DOWNWARD' if segw.pollen_inter_100.iloc[-1]<segw.pollen_inter_100.iloc[0] else 'UPWARD'} "
    f"({segw.pollen_inter_100.iloc[0]:+.3f} -> {segw.pollen_inter_100.iloc[-1]:+.3f})")
say(f"CONTEMPORANEITY VERDICT: the pottery transition at 1700 BCE is NOT marked by a directional shift in pollen "
    f"openness: pollen_grate_100 is negative at 1700/1600/1500 BCE and only briefly positive at 1800 BCE, and the "
    f"raw Belau values in 1800-1600 BCE oscillate (0.15-2.75) without a step. The openness record therefore does "
    f"NOT line up with the pottery event and will not be used to support a demographic explanation.")
say(f"long-run pollen_inter_100 4100 BCE -> 500 BCE: {tsp.pollen_inter_100.iloc[0]:+.3f} -> {tsp.pollen_inter_100.iloc[-1]:+.3f} "
    f"(full-window rise of {tsp.pollen_inter_100.iloc[-1]-tsp.pollen_inter_100.iloc[0]:+.3f}); "
    f"local minimum of pollen_inter_100 nearest the event: {int(tsp.loc[tsp.pollen_inter_100[(tsp.BCE>=1500)&(tsp.BCE<=1900)].idxmin(),'BCE'])} BCE")
bb=b.merge(tsp.groupby("BCE")[["pollen_inter_100","pollen_grate_100"]].mean(),on="BCE",how="left")
say(f"\ncontext (NOT causal): corr(Delta form, pollen_inter_100)={bb.dF.corr(bb.pollen_inter_100):+.3f}; "
    f"corr(Delta decor, pollen_inter_100)={bb.dD.corr(bb.pollen_inter_100):+.3f}; "
    f"corr(form,pollen_inter_100)={bb.F.corr(bb.pollen_inter_100):+.3f}; corr(decor,pollen_inter_100)={bb.D.corr(bb.pollen_inter_100):+.3f}")
say(f"sign(pollen_grate_100) at 1700 BCE = {np.sign(bb.loc[bb.BCE==1700,'pollen_grate_100'].iloc[0]):+.0f}")

say(""); say("="*78); say("10. ANSWER"); say("="*78)
say("Primary: 17th century BCE (bin 1700-1600 BCE; CE -1700..-1601; calBP ~3650-3551).")
say("Transition framing: registered between the 1800 BCE and 1700 BCE bins (1800-1700 BCE).")
