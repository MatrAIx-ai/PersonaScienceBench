import pandas as pd, numpy as np
START, END = 2000, 1100  # BCE inclusive

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
pollen = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
pollen.columns = [c.strip() for c in pollen.columns]
for c in pollen.columns:
    if not pd.api.types.is_numeric_dtype(pollen[c]):
        pollen[c] = pd.to_numeric(pollen[c].astype(str).str.replace(',','.'), errors='coerce')
cap = pd.read_csv('data/capital.csv')
zc = [c for c in cap.columns if c.startswith('Z')]
for c in zc:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',','.'), errors='coerce')

# annual window; align pollen on CE (pollen index = CE)
w = ts[(ts.CE >= -START) & (ts.CE <= -END)].copy().set_index('CE')
w = w.join(pollen[['MEAN','SMOOTH_MEAN_100y']], how='left')

# century bins labeled by start BCE: 1500 => 1500-1401 BCE ... 1200 => 1200-1101 BCE; 1100 => only 1100 BCE
def binlabel(bce):
    s = START
    while s-99 > bce: s -= 100
    return s
w['bin'] = (-w.index).map(binlabel)

prim = w.groupby('bin').agg(
    n=('g_all_mean','size'), g_mean=('g_all_mean','mean'),
    g_se=('g_all_std', lambda s: s.mean()/np.sqrt(len(s))),
    p_rate=('pollen_grate_100','mean'), kde_mean=('kde_all_mean','mean'),
    pol100=('pollen_inter_100','mean'), sm100=('SMOOTH_MEAN_100y','mean'))

lv = prim[['kde_mean','pol100','sm100']].sort_index(ascending=False)  # old -> young
chg = lv.diff().dropna(); chg.columns = ['kde_chg_into','pol100_chg_into','sm100_chg_into']

cw = cap[(cap.BCE>=END)&(cap.BCE<=START)].sort_values('BCE', ascending=False).set_index('BCE')
zchg = cw[zc].diff()
ztab = pd.DataFrame({'n_z_pos':(zchg>0).sum(axis=1),'z_mean_abschg':zchg.mean(axis=1)}).dropna()

tab = pd.concat([prim[['n','g_mean','g_se','p_rate']], chg, ztab], axis=1)
tab['rank_g']=tab.g_mean.rank(ascending=False); tab['rank_p']=tab.p_rate.rank(ascending=False)
tab['rank_avg']=(tab.rank_g+tab.rank_p)/2
pd.set_option('display.width',250)
print(tab.sort_values('rank_avg').round(5).to_string())

# sensitivity (a) rolling 100y
w2 = w.sort_index(ascending=False); vals = w2[['g_all_mean','pollen_grate_100']].values
mids,gs,ps = [],[],[]
for i in range(0,len(w2)-99,50):
    mids.append((-w2.index[i]+-w2.index[i+99])/2); gs.append(vals[i:i+100,0].mean()); ps.append(vals[i:i+100,1].mean())
roll = pd.DataFrame({'g':gs,'p':ps}, index=mids)
print(roll.g.nlargest(4).round(5).to_string()); print(roll.p.nlargest(4).round(5).to_string())
