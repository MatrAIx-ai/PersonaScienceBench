#!/usr/bin/env python3
"""
Pooled 100-year-bin PCA on 'forms of capital' (12 Z columns, capital.csv, 4300-500 BCE),
PC1 at 1100 BCE vs 1000-500 BCE (Younger Bronze Age).

Primary run : PCA = mean-centered SVD on the supplied z-values (capital.csv is already
              globally z-scored; two columns deviate slightly from unit variance).
Sensitivity : additionally re-standardize every column (ddof=0) before SVD.
Sign convention (fixed once): PC1 oriented so that the Copper&Gold loading
(ZCU_AU, largest |loading|) is POSITIVE. All scores/loadings below use this convention.
Pollen data is NOT used in the PCA (referenced once for context only).
"""
import numpy as np, pandas as pd

CAP = 'data/capital.csv'
FORMS = {  # study-context mapping
 'symbolic': ['ZAxtSchwert','ZDolch','Zhausgr'],
 'social'  : ['ZCU_AU','Zamber','ZMonument'],
 'cultural': ['ZKeform','Zkeverz'],
 'economic': ['ZHort','ZSichel','ZBeil','ZMW'],
}
Z = [c for f in FORMS.values() for c in f]

def run_pca(X, standardize):
    X = X.astype(float).copy()
    if standardize:
        X = (X - X.mean(0)) / X.std(0, ddof=0)
    mu = X.mean(0)
    U, S, Vt = np.linalg.svd(X - mu, full_matrices=False)
    scores = U * S
    load = Vt[0]                       # right singular vector, PC1
    if load[Z.index('ZCU_AU')] < 0:    # fixed orientation: ZCU_AU loading > 0
        scores, load = -scores, -load
    varexp = S**2 / (S**2).sum()
    return scores, load, varexp, mu

def report(name, X, bce, standardize):
    scores, load, varexp, mu = run_pca(X, standardize)
    pc1 = pd.Series(scores[:,0], index=bce)
    print(f"\n===== {name} (standardize={standardize}) =====")
    print(f"PC1 variance explained: {varexp[0]*100:.1f}%  (PC2 {varexp[1]*100:.1f}%, PC3 {varexp[2]*100:.1f}%)")
    yba = [1100,1000,900,800,700,600,500]
    print("\nPC1 scores, YBA window:")
    for y in yba: print(f"  {y:>4} BCE: {pc1[y]:+.3f}")
    s1100 = pc1[1100]; later = pc1[[y for y in yba if y<=1000]]
    sd_all = pc1.std(ddof=0); sd_yba = later.std(ddof=0)
    print(f"1100 BCE value            : {s1100:+.3f}")
    print(f"1000-500 BCE range        : [{later.min():+.3f}, {later.max():+.3f}]  mean {later.mean():+.3f}")
    print(f"gap vs mean(1000-500)     : {s1100-later.mean():+.3f}  = {(s1100-later.mean())/sd_all:.2f} SD(all39) / {(s1100-later.mean())/sd_yba:.2f} SD(YBA6)")
    print(f"gap vs max(1000-500)=1000 : {s1100-later.max():+.3f}  = {(s1100-later.max())/sd_all:.2f} SD(all39)")
    rank = int((pc1 < s1100).sum()) + 1
    print(f"rank of 1100 BCE among all {len(pc1)} bins (desc): {rank}  "
          f"(series max={pc1.max():+.3f} @ {pc1.idxmax()}, min={pc1.min():+.3f} @ {pc1.idxmin()}, "
          f"all-bin SD={sd_all:.3f})")
    print("\nPC1 loadings by capital form:")
    for form, cols in FORMS.items():
        print("  %-9s %s" % (form+",", ", ".join(f"{c}={load[Z.index(c)]:+.2f}" for c in cols)))
    # decompose the 1100 vs 1000-500 mean gap into per-variable contributions
    later_rows = [i for i,y in enumerate(bce) if 500<=y<=1000]
    i1100 = list(bce).index(1100)
    contrib = load * (X[i1100] - X[later_rows].mean(0))
    cs = pd.Series(contrib, index=Z).sort_values(ascending=False)
    print("\nContribution to gap PC1(1100)-mean PC1(1000-500) [loading x (value_1100 - mean_1000-500)]:")
    for c, v in cs.items(): print(f"  {c:<12} {v:+.3f}")
    print("  sum of contributions   :", f"{cs.sum():+.3f}", "(should equal gap vs mean)")
    byform = {f: cs[cols].sum() for f, cols in FORMS.items()}
    print("  by capital form        :", {f: round(v,2) for f,v in byform.items()})
    return pc1, load

cap = pd.read_csv(CAP, decimal=',')
assert cap.BCE.is_unique and set(cap.BCE) == set(range(500,4400,100))
bce = cap.BCE.values
X = cap[Z].values

pc1, load = report("PRIMARY pooled PCA over 39 bins (mean-centered only)", X, bce, False)
pc1s, _  = report("SENSITIVITY pooled PCA over 39 bins (re-standardized)", X, bce, True)
print("\nPrimary vs sensitivity PC1 (YBA):",
      {y: (round(pc1[y],2), round(pc1s[y],2)) for y in [1100,1000,900,800,700,600,500]})

# pollen context only (never enters the PCA)
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')
print("\nPollen openness context (Belau PC1, NOT in PCA):")
print("  CE range of Belau/Woserin pollen record:", pol.CE.min(), "to", pol.CE.max())
print("  time_series pollen_inter_100 at YBA bins:")
m = ts.set_index('CE')
print(m.loc[[-1100,-1000,-900,-800,-700,-600,-500], ['pollen_inter','pollen_inter_100']].round(2).to_string())
