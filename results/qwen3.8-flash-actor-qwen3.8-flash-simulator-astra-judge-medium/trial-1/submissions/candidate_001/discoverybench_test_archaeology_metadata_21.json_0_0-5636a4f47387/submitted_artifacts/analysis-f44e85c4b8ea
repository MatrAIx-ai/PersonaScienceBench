"""PCA of 12 capital forms in 100-year time slices (DiscoveryBench archaeology question).

Data: capital.csv, n=39 hundred-year slices (BCE 4300..500), 12 pre-z-scored
columns (no extra standardization; decimal-comma parsing). scikit-learn was
unavailable offline, so PCA = numpy.linalg.svd on the column-centered matrix,
which is mathematically identical to sklearn.decomposition.PCA.
Sign convention: per-PC loadings are flipped so their sum is positive.
Outputs: loadings/scores/evar CSVs + console diagnostics incl. sensitivities.
"""
import numpy as np, pandas as pd, itertools

cap = pd.read_csv('data/capital.csv', decimal=',')
Z = cap.drop(columns=['BCE','group','color'])
assert Z.shape == (39,12) and Z.notna().all().all()
sym = ['Zhausgr','ZDolch','ZAxtSchwert']

def pca(X, k=4):
    Xc = X.values - X.values.mean(axis=0)
    U, s, Vt = np.linalg.svd(Xc, full_matrices=False)
    evr = s**2/(s**2).sum()
    L = pd.DataFrame(Vt[:k].T, index=X.columns, columns=[f'PC{i+1}' for i in range(k)])
    S = pd.DataFrame(U[:,:k]*s[:k], columns=[f'PC{i+1}' for i in range(k)])
    flip = np.sign(L.sum(axis=0).values); flip[flip==0]=1
    return L*flip, S*flip, evr

L, S, evr = pca(Z)
print("MAIN n=39 explained variance ratios:", np.round(evr[:4],4), "| PC1+PC2 =", round(evr[:2].sum(),4))
t = L.copy(); t['rank|PC1|'] = t.PC1.abs().rank(ascending=False).astype(int)
t['rank|PC2|'] = t.PC2.abs().rank(ascending=False).astype(int)
print(t.round(3).sort_values('rank|PC1|').to_string())

res = pd.concat([cap[['BCE','group']].reset_index(drop=True), S], axis=1)
print("\nGroup mean PC1/PC2 scores:\n", res.groupby('group')[['PC1','PC2']].mean().round(2).to_string())
print("\nPC score spread: PC1 sd=%.2f range[%.2f,%.2f]; PC2 sd=%.2f range[%.2f,%.2f]" %
      (S.PC1.std(), S.PC1.min(), S.PC1.max(), S.PC2.std(), S.PC2.min(), S.PC2.max()))
for v in sym:
    tot=(L.loc[v]**2).sum()
    print(f"{v}: PC1={L.loc[v,'PC1']:+.3f} rank {int(t['rank|PC1|'][v])}/12, "
          f"PC2={L.loc[v,'PC2']:+.3f} rank {int(t['rank|PC2|'][v])}/12, "
          f"corr(v,PC1)={np.corrcoef(Z[v],S.PC1)[0,1]:+.3f}, corr(v,PC2)={np.corrcoef(Z[v],S.PC2)[0,1]:+.3f}")
for a,b in itertools.combinations(sym,2):
    v1,v2 = L.loc[a,['PC1','PC2']].values, L.loc[b,['PC1','PC2']].values
    print(f"angle {a}-{b} in PC1-PC2 plane: {np.degrees(np.arccos(v1@v2/np.linalg.norm(v1)/np.linalg.norm(v2))):.0f} deg")
print("\nTop PC2 slices:\n", res.nlargest(5,'PC2')[['BCE','group','PC1','PC2']].round(2).to_string(index=False))
print("Bottom PC2 slices:\n", res.nsmallest(5,'PC2')[['BCE','group','PC1','PC2']].round(2).to_string(index=False))
print("Top PC1 slices:\n", res.nlargest(5,'PC1')[['BCE','group','PC1','PC2']].round(2).to_string(index=False))

Z37 = cap[cap.BCE<=4100].drop(columns=['BCE','group','color'])
L37,_,e37 = pca(Z37)
print("\nSENS n=37: evr PC1,PC2 =", np.round(e37[:2],4), "; trio PC1:", {v: round(L37.loc[v,'PC1'],3) for v in sym},
      "; max|dPC1| =", round(float(np.abs(L37.PC1-L.PC1).max()),3))
Lx,_,ex = pca(Z.drop(columns=['ZSichel']))
cc = Z.columns.drop('ZSichel')
print("SENS drop ZSichel: evr =", np.round(ex[:2],4), "; PC1-loading corr vs main =",
      round(float(np.corrcoef(L.loc[cc,'PC1'],Lx.loc[cc,'PC1'])[0,1]),3))
Ls,_,es = pca((Z-Z.mean())/Z.std())
print("SENS re-standardized: evr =", np.round(es[:2],4), "; PC1-loading corr =",
      round(float(np.corrcoef(L.PC1,Ls.PC1)[0,1]),3))

res.round(4).to_csv('analysis/scores_main.csv', index=False)
L.round(4).to_csv('analysis/loadings_main.csv')
pd.Series(evr[:4], index=['PC1','PC2','PC3','PC4']).to_csv('analysis/evar_main.csv')
print("\nSaved: analysis/loadings_main.csv, analysis/scores_main.csv, analysis/evar_main.csv")
