"""3400-3000 BCE: monuments & axes vs symbolic capital (HatchetSword, Dagger, HouseSize).
Primary resolution: 5 raw 100-year bins from capital.csv (== time_series raw columns).
No inference from interpolated series (pseudo-replication guard)."""
import pandas as pd, numpy as np
from scipy import stats

FOCAL = ['MonumentCount','AxesCelts']
SYMB  = ['HatchetSword','Dagger','HouseSize']
CAPMAP = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
          'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot',
          'ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize','ZKeform':'PotteryForm',
          'Zkeverz':'PotteryDecoration'}
NUM = lambda s: pd.to_numeric(s.astype(str).str.strip().str.replace(',','.'), errors='coerce')

def load_cap():
    cap = pd.read_csv('data/capital.csv'); cap.columns=[c.strip() for c in cap.columns]
    for c in CAPMAP: cap[c] = NUM(cap[c])
    cap = cap.rename(columns=CAPMAP)
    cap['CE'] = -cap['BCE']
    return cap.set_index('CE')[list(CAPMAP.values())+['BCE','group']]

def slope100(x, y):
    """OLS slope in Z units per century, x = signed CE years (time forward)."""
    x = np.asarray(x, float); y = np.asarray(y, float)
    if np.nanstd(y) == 0 or len(y) < 3: return (0.0 if np.nanstd(y)==0 else np.nan, np.nan, np.nan, np.nan)
    r = stats.linregress(x, y)
    return r.slope*100.0, r.rvalue, r.pvalue, r.stderr*100.0

def direction(dz, thr=0.10):
    return 'rising' if dz > thr else ('falling' if dz < -thr else 'flat')

def pearson_ci(r, n):
    if n < 4 or abs(r) >= 1: return (np.nan, np.nan)
    z = np.arctanh(r); se = 1/np.sqrt(n-3)
    return tuple(np.tanh([z-1.959964*se, z+1.959964*se]))

def report(df, lbl):
    print(f"\n=== [{lbl}] levels per 100-yr bin (raw Z, capital.csv) ===")
    tab = df[FOCAL+SYMB].copy(); tab.index = [f"{int(-i)} BCE" for i in df.index]
    print(tab.round(3).to_string())
    print(f"\n=== [{lbl}] trend summary: n={len(df)} bins ===")
    rows=[]
    for s in FOCAL+SYMB:
        y = df[s].values; x = df.index.values.astype(float)
        dz = y[-1]-y[0]
        sl, rr, pp, slse = slope100(x, y)
        inc = int(np.sum(np.diff(y) > 0)); dec = int(np.sum(np.diff(y) < 0))
        rows.append(dict(series=s, start_Z=round(y[0],3), end_Z=round(y[-1],3),
                         min_Z=round(y.min(),3), max_Z=round(y.max(),3),
                         dZ_3400_to_3000=round(dz,3) if lbl=='WINDOW' else round(dz,3),
                         slope_per_century=round(sl,3), slope_stderr=round(slse,3),
                         ols_r=round(rr,3), ols_p=round(pp,4),
                         up_steps=inc, down_steps=dec, n_unique=int(len(np.unique(y))),
                         direction=direction(dz)))
    T = pd.DataFrame(rows); print(T.to_string(index=False))
    return T

def corrs(df, lbl):
    print(f"\n=== [{lbl}] descriptive correlation: focal vs symbolic (n={len(df)} bins) ===")
    n=len(df); out=[]
    for f in FOCAL:
        for s in SYMB:
            if df[s].nunique() < 2:
                dl = float((df[f]-df[s]).abs().mean()); rg=float(df[f].max()-df[f].min())
                out.append(dict(focal=f, symbolic=s, n=n, status='NO VARIANCE in window -> correlation undefined',
                                mean_abs_level_gap=round(dl,3)))
                continue
            r,p = stats.pearsonr(df[f], df[s]); rho,prho = stats.spearmanr(df[f], df[s])
            lo,hi = pearson_ci(r,n)
            r_crit = stats.t.ppf(0.975, n-2)/np.sqrt(stats.t.ppf(0.975,n-2)**2 + n-2)
            out.append(dict(focal=f, symbolic=s, n=n, pearson_r=round(r,3), pearson_p=round(p,4),
                            ci95_lo=round(lo,3), ci95_hi=round(hi,3), spearman_rho=round(rho,3),
                            spearman_p=round(prho,4), r_needed_p05=round(r_crit,3),
                            status='computed (descriptive, underpowered)'))
    C = pd.DataFrame(out); print(C.to_string(index=False))
    return C

def comovement(df):
    print("\n=== CO-MOVEMENT (primary evidence): bin-to-bin change signs, 4 transitions ===")
    D = df[FOCAL+SYMB].diff().dropna()
    D.index = [f"{int(-a)}->{int(-b)} BCE" for a,b in zip(df.index[:-1], df.index[1:])]
    print(D.round(3).to_string())
    rows=[]
    for f in FOCAL:
        for s in SYMB:
            a,b = D[f].values, D[s].values
            nz = (a!=0)&(b!=0)
            conc = int(np.sum(np.sign(a[nz])==np.sign(b[nz])))
            zero_partner = int(np.sum(b==0))
            try: dr = stats.pearsonr(a[nz], b[nz])[0] if nz.sum()>=3 else np.nan
            except Exception: dr = np.nan
            rows.append(dict(focal=f, symbolic=s, usable_transitions=int(nz.sum()),
                             sign_agreements=conc, sign_agreement_frac=round(conc/max(nz.sum(),1),2),
                             transitions_with_zero_in_symbolic=zero_partner,
                             corr_of_changes=round(dr,3) if nz.sum()>=3 else None))
    CM = pd.DataFrame(rows); print(CM.to_string(index=False))
    print("\n=== RANK ORDER OF TOTAL CHANGE (dZ, 3400->3000 BCE), largest rise first ===")
    dz = (df[FOCAL+SYMB].iloc[-1] - df[FOCAL+SYMB].iloc[0]).sort_values(ascending=False)
    print(dz.round(3).to_string())
    return D, CM, dz

def pollen_sidebar():
    print("\n=== POLLEN SIDEBAR (exploratory, NOT part of hypothesis; Belau-only) ===")
    ts = pd.read_csv('data/time_series_data.csv', index_col=0)
    w = ts[(ts.CE>=-3400)&(ts.CE<=-3000)].sort_values('CE')
    for col in ['pollen_inter','pollen_inter_100','pollen_detrend']:
        y=w[col].values; x=w.CE.values.astype(float)
        sl,rr,pp,_ = slope100(x,y)
        print(f"{col:18s} annual n={len(y):4d} start(3400BCE)={y[0]:7.3f} end(3000BCE)={y[-1]:7.3f} "
              f"dZ={y[-1]-y[0]:7.3f} min={y.min():7.3f} max={y.max():7.3f} slope/century={sl:8.4f} (raw-pollen pts in window={w.pollen.notna().sum()})")
    cap = load_cap(); cw = cap.loc[-3400:-3000]
    p100 = w.set_index('CE')['pollen_inter_100'].reindex(cw.index)
    p1   = w.set_index('CE')['pollen_inter'].reindex(cw.index)
    for name, p in [('pollen_inter',p1), ('pollen_inter_100',p100)]:
        for f in FOCAL:
            r,pr = stats.pearsonr(cw[f], p); rho,prho = stats.spearmanr(cw[f], p)
            print(f"  {name} vs {f:14s} n=5 pearson={r:6.3f} (p={pr:.3f}) spearman={rho:6.3f} (p={prho:.3f})")
    pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
    pol.columns=[c.strip() for c in pol.columns]
    for c in pol.columns: pol[c]=NUM(pol[c])
    pol = pol.drop_duplicates('CE').set_index('CE').sort_index(); pw = pol.loc[-3400:-3000]
    for col in ['Belau_PC1_inter','MEAN','SMOOTH_MEAN_100y']:
        sl,rr,pp,_ = slope100(pw.index.values.astype(float), pw[col].values)
        print(f"  [two-site option] {col:18s} start={pw[col].iloc[0]:7.3f} end={pw[col].iloc[-1]:7.3f} slope/century={sl:8.4f}")

def robustness(cap):
    print("\n=== ROBUSTNESS / WIDER WINDOWS (labelled; headline stays 3400-3000 BCE) ===")
    report(cap.loc[-3500:-2800], 'SENSITIVITY 3500-2800 BCE (n=8)')
    mn = cap[cap.group=='MN']
    print(f"\nall-MN bins: {sorted(-mn.index.astype(int), reverse=True)}")
    report(mn, 'SENSITIVITY all-MN')
    print("\n=== INTERPOLATION ROBUSTNESS (NOT independent; descriptive only) ===")
    ts = pd.read_csv('data/time_series_data.csv', index_col=0)
    w = ts[(ts.CE>=-3400)&(ts.CE<=-3000)].sort_values('CE')
    for s in FOCAL+SYMB:
        y=w[s+'_inter'].values; x=w.CE.values.astype(float)
        sl,_,_,_ = slope100(x,y)
        print(f"  {s:14s} annual-interp slope/century={sl:8.4f}  (5 real bins -> {len(y)} pseudo-points, no p-value used)")


def supplementary(cap, win):
    print("\n=== SUPPLEMENTARY: focal-focal relation and non-symbolic context (labelled exploratory) ===")
    r,p = stats.pearsonr(win['MonumentCount'], win['AxesCelts']); rho,prho = stats.spearmanr(win['MonumentCount'], win['AxesCelts'])
    lo,hi = pearson_ci(r,5)
    a,b = win['MonumentCount'].diff().dropna(), win['AxesCelts'].diff().dropna()
    nz=(a!=0)&(b!=0); conc=int(np.sum(np.sign(a[nz])==np.sign(b[nz])))
    print(f"MonumentCount vs AxesCelts: n=5 pearson r={r:.3f} (p={p:.3f}, 95% CI {lo:.3f}..{hi:.3f}) spearman={rho:.3f} (p={prho:.3f}); Delta-sign agreement {conc}/{int(nz.sum())} usable transitions")
    print("peak bins:", {s: f"{int(-win.index[np.argmax(win[s].values)])} BCE" for s in FOCAL+SYMB})
    print("level gap (focal minus symbolic), mean over window:")
    for f in FOCAL:
        print("  ", f, {s: round(float((win[f]-win[s]).mean()),3) for s in SYMB})
    ctx=['MonumentSize','Depot','Sickle','CopperGold','Amber','PotteryForm','PotteryDecoration']
    print("non-symbolic context dZ 3400->3000 (NOT symbolic capital):",
          {c: round(float(win_ctx[c].iloc[-1]-win_ctx[c].iloc[0]),3) for c in ctx})

def main():
    cap = load_cap()
    assert cap.loc[-3400:-3000, ['MonumentCount','AxesCelts','HatchetSword','Dagger','HouseSize']].notna().all().all()
    win = cap.loc[-3400:-3000]
    print("period labels in window:", cap.loc[-3400:-3000,'group'].tolist())
    T = report(win,'WINDOW 3400-3000 BCE')
    C = corrs(win,'WINDOW 3400-3000 BCE')
    D, CM, dz = comovement(win)
    global win_ctx
    win_ctx = cap.loc[-3400:-3000, ['MonumentSize','Depot','Sickle','CopperGold','Amber','PotteryForm','PotteryDecoration']]
    supplementary(cap, win)
    pollen_sidebar()
    robustness(cap)
    with pd.ExcelWriter('out/results.xlsx') as xl:
        T.to_excel(xl,sheet_name='window_trends'); C.to_excel(xl,sheet_name='correlations'); CM.to_excel(xl,sheet_name='comovement')
        D.to_excel(xl,sheet_name='bin_changes'); win[FOCAL+SYMB].to_excel(xl,sheet_name='window_levels')
    for nm,obj,idx in [('window_trends',T,False),('correlations',C,False),('comovement',CM,False),
                           ('bin_changes',D,True),('window_levels',win[FOCAL+SYMB],True)]:
        obj.to_csv(f'out/{nm}.csv',index=idx)
    print("\nwrote out/results.xlsx, out/window_trends.csv, out/correlations.csv")

main()
