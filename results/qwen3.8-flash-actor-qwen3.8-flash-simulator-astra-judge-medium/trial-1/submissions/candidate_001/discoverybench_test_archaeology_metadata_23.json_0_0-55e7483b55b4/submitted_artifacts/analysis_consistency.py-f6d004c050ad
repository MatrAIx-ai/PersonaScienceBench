import pandas as pd, numpy as np
ts=pd.read_csv('data/time_series_data.csv',index_col=0).set_index('CE')
cap=pd.read_csv('data/capital.csv'); cap.columns=[c.strip() for c in cap.columns]
for c in cap.columns[3:]: cap[c]=cap[c].astype(str).str.replace(',','.').astype(float)
m={'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
cap_ts=cap.set_index(-cap.BCE)
A=cap_ts[list(m.keys())]
B=ts[list(m.values())].rename(columns={v:k for k,v in m.items()}).reindex(cap_ts.index)
print("max abs diff cap vs TS raw:"); print(A.sub(B).abs().max().to_string())
w=ts.loc[-3400:-3000]
print("\nwindow rows:",len(w),"raw-Z present:",w['MonumentCount'].notna().sum())
print(list(w.index[w['MonumentCount'].notna()]))
print("window: which columns have any variation in raw cols:",{c:(w[c].dropna().nunique()) for c in ['MonumentCount','AxesCelts','HatchetSword','Dagger','HouseSize']})
pol=pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',index_col=0)
pol['CE']=pd.to_numeric(pol['CE'],errors='coerce')
pw=pol[(pol.CE>=-3400)&(pol.CE<=-3000)]
print("\npollen window rows:",len(pw),"Belau raw present:",pw.Belau_PC1.notna().sum(),"Woserin raw:",pw.Woserin_PC1.notna().sum())
j=ts[['pollen','pollen_inter','pollen_inter_100']].join(pol.drop_duplicates('CE').set_index('CE')[['Belau_PC1','Belau_PC1_inter','MEAN','SMOOTH_MEAN_100y']],how='inner')
print("join rows",len(j)); print(j.corr()['pollen_inter'].round(3).to_string())
