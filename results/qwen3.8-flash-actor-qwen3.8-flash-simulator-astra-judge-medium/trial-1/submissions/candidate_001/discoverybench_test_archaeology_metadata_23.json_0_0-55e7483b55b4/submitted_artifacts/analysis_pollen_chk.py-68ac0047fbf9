import pandas as pd, numpy as np
ts=pd.read_csv('data/time_series_data.csv',index_col=0).set_index('CE')
pol=pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',index_col=0)
pol.columns=[c.strip() for c in pol.columns]
for c in pol.columns:
    pol[c]=pd.to_numeric(pol[c].astype(str).str.replace(',','.'),errors='coerce')
pol=pol.drop_duplicates('CE').set_index('CE')
j=ts[['pollen','pollen_inter','pollen_inter_100','pollen_detrend']].join(pol[['Belau_PC1','Woserin_PC1','Belau_PC1_inter','Woserin_PC1_inter','MEAN','SMOOTH_MEAN_100y']],how='inner')
print("join rows",len(j))
print(j.corr()['pollen_inter'].round(3).to_string())
print("\nmax abs diff pollen_inter vs MEAN:",(j.pollen_inter-j.MEAN).abs().max()," vs SMOOTH100:",(j.pollen_inter-j.SMOOTH_MEAN_100y).abs().max())
w=pol.loc[pol.index[(pol.index>=-3400)&(pol.index<=-3000)]]
print("pollen file window rows",len(w),"Belau raw",w.Belau_PC1.notna().sum(),"Woserin raw",w.Woserin_PC1.notna().sum())
print("MEAN in window: min %.2f max %.2f ; slope sign via polyfit:"%(w.MEAN.min(),w.MEAN.max()), np.polyfit(w.index,w.MEAN,1)[0].round(5))
