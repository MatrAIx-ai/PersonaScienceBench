import pandas as pd, numpy as np
pd.set_option('display.width',200)
ts=pd.read_csv('data/time_series_data.csv',index_col=0)
cap=pd.read_csv('data/capital.csv')
pol=pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',index_col=0)
print("TS shape",ts.shape,"CE range",ts.CE.min(),ts.CE.max(),"calBP",ts.calBP.min(),ts.calBP.max())
print("CE step unique:",sorted(ts.CE.diff().dropna().unique())[:5],"dupes",ts.CE.duplicated().sum())
print("\nTS missing counts (total / in window CE -3400..-3000):")
w=ts[(ts.CE>=-3400)&(ts.CE<=-3000)]
print("window rows",len(w))
for c in ts.columns:
    print(f"  {c:24s} miss={ts[c].isna().sum():5d}  win_miss={w[c].isna().sum():4d}  win_min={w[c].min() if w[c].dtype!=object else '-'} win_max={w[c].max() if w[c].dtype!=object else '-'}")
print("\nCAP shape",cap.shape)
cap.columns=[c.strip() for c in cap.columns]
print(cap.BCE.tolist())
print(cap.group.unique(),cap.dtypes.to_dict())
print("cap missing:",cap.isna().sum().sum())
print("\nPOL shape",pol.shape,"CE range",pol.CE.min(),pol.CE.max(),"calBP",pol.calBP.min(),pol.calBP.max())
print(pol.isna().sum())
