"""
DiscoveryBench archaeology task: first century where Pottery Decoration rises
while Pottery Form falls.

Primary basis: the 37 genuine 100-year anchors in data/time_series_data.csv
(PotteryDecoration / PotteryForm are non-missing only at multiples of 100 CE).
The *_inter columns are exact linear interpolations of those anchors (verified)
and are used ONLY for confirmation (100-yr bin means + rolling OLS slopes).
data/capital.csv is used ONLY for cross-validation (values match exactly,
max abs diff 0.0) and cultural-period context -> never combined/pooled.
The pollen file is not used: the question concerns two pottery diversity series
and the pollen record covers a different window/variable.
"""
import numpy as np
import pandas as pd

pd.set_option("display.width", 220)
TS = "data/time_series_data.csv"
CAP = "data/capital.csv"
OUT = "analysis"

# ---------------------------------------------------------------- load + QC
ts = pd.read_csv(TS, index_col=0)
ce = ts["CE"]
qc = {
    "n_rows": len(ts),
    "n_cols": ts.shape[1],
    "CE_min": int(ce.min()),
    "CE_max": int(ce.max()),
    "CE_monotonic": bool(ce.is_monotonic_increasing),
    "unique_annual_steps": sorted(set(np.diff(ce.values))),
    "n_duplicate_CE": int(ce.duplicated().sum()),
    "n_gaps_gt_1yr": int((np.diff(ce.values) != 1).sum()),
}
missing = {c: int(ts[c].isna().sum()) for c in
           ["PotteryDecoration", "PotteryDecoration_inter",
            "PotteryForm", "PotteryForm_inter"]}

DEC, FORM = "PotteryDecoration", "PotteryForm"
anchors = ts[ts[DEC].notna()][["CE", DEC, FORM]].sort_values("CE").reset_index(drop=True)
qc["n_anchors"] = len(anchors)
qc["anchors_on_multiples_of_100"] = bool((anchors.CE % 100 == 0).all())

# interpolation identity check
interp_err = {}
for c in (DEC, FORM):
    a = ts[ts[c].notna()]
    lin = np.interp(ts["CE"], a["CE"], a[c])
    interp_err[c] = float(np.nanmax(np.abs(ts[c + "_inter"].values - lin)))

# cross-validate against capital.csv (source series; NOT pooled)
cap = pd.read_csv(CAP)
for c in cap.columns[3:]:
    cap[c] = cap[c].astype(str).str.replace(",", ".").astype(float)
cap["CE"] = -cap["BCE"]
x = anchors.merge(cap[["CE", "Zkeverz", "ZKeform", "group"]], on="CE",
                  how="left", indicator=True)
val = {
    "anchors_matched_in_capital": int((x["_merge"] == "both").sum()),
    "capital_rows_outside_ts_window": int((cap.CE < anchors.CE.min()).sum()),
    "max_abs_diff_Zkeverz_vs_PotteryDecoration":
        float((x[DEC] - x["Zkeverz"]).abs().max()),
    "max_abs_diff_ZKeform_vs_PotteryForm":
        float((x[FORM] - x["ZKeform"]).abs().max()),
}

# ------------------------------------------------- century change + z-scores
t = anchors.copy()
t["BCE"] = -t.CE
t["d_dec"] = t[DEC].diff()
t["d_form"] = t[FORM].diff()
t = t.dropna(subset=["d_dec", "d_form"]).reset_index(drop=True)   # 36 transitions
t = t.merge(cap[["CE", "group"]], on="CE", how="left")

EDGE_CE = -4000          # 4100->4000 BCE series-edge transition
t["is_edge_transition"] = t.CE == EDGE_CE

def zscore(s, mask):
    """z of each change against the distribution of changes in `mask` rows."""
    mu, sd = s[mask].mean(), s[mask].std(ddof=1)
    return (s - mu) / sd

t["z_dec_incl"], t["z_form_incl"] = zscore(t.d_dec, pd.Series(True, t.index)), \
                                    zscore(t.d_form, pd.Series(True, t.index))
inner = ~t.is_edge_transition
t["z_dec_excl"], t["z_form_excl"] = zscore(t.d_dec, inner), zscore(t.d_form, inner)

t["opposite"] = (t.d_dec > 0) & (t.d_form < 0)

# magnitude ranks (largest absolute change = rank 1)
t["rank_dec"] = t.d_dec.abs().rank(ascending=False, method="min").astype(int)
t["rank_form"] = t.d_form.abs().rank(ascending=False, method="min").astype(int)

# ------------------------------------------------------- threshold sensitivity
def first_qualifier(df, zcol_d=None, zcol_f=None, thr=None, topn=None):
    if topn is not None:
        cond = df.opposite & (df.rank_dec <= topn) & (df.rank_form <= topn)
    else:
        cond = df.opposite & (df[zcol_d] >= thr) & (df[zcol_f] <= -thr)
    q = df[cond]
    if len(q) == 0:
        return None, q
    return int(q.iloc[0].CE), q

variants = [("z>=1, edge included",  dict(zcol_d="z_dec_incl", zcol_f="z_form_incl", thr=1.0)),
            ("z>=2, edge included",  dict(zcol_d="z_dec_incl", zcol_f="z_form_incl", thr=2.0)),
            ("z>=3, edge included",  dict(zcol_d="z_dec_incl", zcol_f="z_form_incl", thr=3.0)),
            ("z>=1, edge excluded",  dict(zcol_d="z_dec_excl", zcol_f="z_form_excl", thr=1.0)),
            ("z>=2, edge excluded",  dict(zcol_d="z_dec_excl", zcol_f="z_form_excl", thr=2.0)),
            ("z>=3, edge excluded",  dict(zcol_d="z_dec_excl", zcol_f="z_form_excl", thr=3.0)),
            ("top-3 magnitude both", dict(topn=3)),
            ("top-5 magnitude both", dict(topn=5)),
            ("sign only (z>=0)",     dict(zcol_d="z_dec_incl", zcol_f="z_form_incl", thr=0.0))]

sens_rows = []
for name, kw in variants:
    first, q = first_qualifier(t, **kw)
    sens_rows.append({"variant": name,
                      "n_qualifying_transitions": len(q),
                      "earliest_CE": first,
                      "earliest_BCE_century_label": None if first is None else f"{abs(first)} BCE bin",
                      "all_qualifying_CE": None if first is None else list(map(int, q.CE)),
                      "answer_changed_vs_primary": None})
sens = pd.DataFrame(sens_rows)
sens["answer_changed_vs_primary"] = sens.earliest_CE != sens.earliest_CE.iloc[0]

# --------------------------------------------- confirmation view 1: bin means
b = (ts.assign(bin=np.floor(ts.CE / 100) * 100)
       .groupby("bin")
       .agg(dec=("PotteryDecoration_inter", "mean"),
            form=("PotteryForm_inter", "mean")))
b["d_dec"] = b.dec.diff(); b["d_form"] = b.form.diff()
b["opposite"] = (b.d_dec > 0) & (b.d_form < 0)
bin_q = b[b.opposite]

# ------------------------------- confirmation view 2: rolling OLS slope onset
s = ts.set_index("CE")[["PotteryDecoration_inter", "PotteryForm_inter"]].sort_index()
slope_rows = []
for w in (200, 300):
    xx = np.arange(w)
    sd = s.PotteryDecoration_inter.rolling(w).apply(lambda v: np.polyfit(xx, v, 1)[0])
    sf = s.PotteryForm_inter.rolling(w).apply(lambda v: np.polyfit(xx, v, 1)[0])
    kd, kf = sd.std(), sf.std()
    for k in (0.0, 0.25, 0.5):
        ok = ((sd > k * kd) & (sf < -k * kf)).fillna(False)
        yrs = pd.Series(s.index, index=s.index)[ok]
        if len(yrs) == 0:
            slope_rows.append({"window_yr": w, "thresh_x_sd_of_slope": k,
                               "n_rows": 0, "first_CE": None, "episode_CE_range": None}); continue
        grp = (yrs.diff().fillna(1) > 1).cumsum()
        eps = yrs.groupby(grp).agg(["first", "last"])
        mag = pd.DataFrame({"dec_slope": sd, "form_slope": sf}).loc[yrs.index]
        slope_rows.append({"window_yr": w, "thresh_x_sd_of_slope": k, "n_rows": int(ok.sum()),
                           "first_CE": int(yrs.iloc[0]),
                           "episode_CE_range": [int(eps.iloc[0]["first"]), int(eps.iloc[0]["last"])],
                           "n_episodes": len(eps),
                           "all_episode_starts": [int(v) for v in eps["first"]],
                           "earliest_episode_max_dec_slope": float(mag.dec_slope.abs().max()),
                           "peak_dec_slope_over_all_episodes": float(mag.dec_slope.max()),
                           "peak_form_slope_over_all_episodes": float(mag.form_slope.min())})
slopes = pd.DataFrame(slope_rows)

# --------------------------------------------------------------- dump results
t_out = t[["CE", "BCE", "group", DEC, FORM, "d_dec", "d_form",
           "z_dec_incl", "z_form_incl", "z_dec_excl", "z_form_excl",
           "opposite", "rank_dec", "rank_form"]]
t_out.to_csv(f"{OUT}/century_change_table.csv", index=False)
b.round(4).to_csv(f"{OUT}/bin_mean_table.csv")
slopes.to_csv(f"{OUT}/rolling_slope_onset.csv", index=False)

print("=== QC ==="); print(qc)
print("\n=== missing values ==="); print(missing)
print("\n=== interpolation identity (should be ~0) ==="); print(interp_err)
print("\n=== capital.csv cross-validation (not pooled) ==="); print(val)
print("\n=== change distribution ===")
print(f"d_dec mean {t.d_dec.mean():.3f} sd {t.d_dec.std():.3f} | "
      f"d_form mean {t.d_form.mean():.3f} sd {t.d_form.std():.3f}")

print("\n=== FULL century series dump (Decoration vs Form) ===")
print(t_out[["CE", "BCE", "group", DEC, FORM, "d_dec", "d_form",
             "z_dec_incl", "z_form_incl", "opposite", "rank_dec", "rank_form"]]
      .round(3).to_string(index=False))

print("\n=== transitions with Decoration UP & Form DOWN (sign only) ===")
print(t_out[t_out.opposite].round(3).to_string(index=False))

print("\n=== threshold sensitivity ===")
print(sens.to_string(index=False))

print("\n=== bin-mean confirmation (interpolated series, 100-yr means) ===")
print(b.round(3).to_string())
print("qualifying bins:", list(map(int, bin_q.index)))

print("\n=== rolling OLS slope onset confirmation ===")
print(slopes.to_string(index=False))

# ------------------------------------------------------------- ASCII figure
print("\n=== ASCII overlay: PotteryDecoration (*) vs PotteryForm (o), 4100-500 BCE ===")
lo, hi = -2.2, 2.2
W = 61
def row(label, pairs):
    line = [" "] * W
    for sym, v in pairs:
        i = int(round((v - lo) / (hi - lo) * (W - 1)))
        line[i] = "#" if line[i] not in " " else sym
    print(f"{label:>6} |" + "".join(line) + "|")
print("        +" + "-" * W + "+  (scale %.1f .. %.1f)" % (lo, hi))
for _, r in t.iterrows():
    row(f"{int(r.BCE)}", [("*", r[DEC]), ("o", r[FORM])])
zero = int(round((0 - lo) / (hi - lo) * (W - 1)))
print("        " + " " * (zero + 9) + "^ 0")

# ----------------------------------------------------------- final statement
first, q = first_qualifier(t, zcol_d="z_dec_incl", zcol_f="z_form_incl", thr=1.0)
prim = t[t.CE == first].iloc[0]
print("\n=== PRIMARY RESULT ===")
print(f"first qualifying transition -> anchor CE {first} (bin {first-100} to {first} CE, "
      f"i.e. {abs(first-100)}-{abs(first)} BCE)")
print(f"PotteryDecoration {t.loc[t.CE==first-100, DEC].iloc[0]} -> {prim[DEC]}  "
      f"(delta {prim.d_dec:+.2f}, z {prim.z_dec_incl:+.2f} incl edge / {prim.z_dec_excl:+.2f} excl edge)")
print(f"PotteryForm       {t.loc[t.CE==first-100, FORM].iloc[0]} -> {prim[FORM]}  "
      f"(delta {prim.d_form:+.2f}, z {prim.z_form_incl:+.2f} incl edge / {prim.z_form_excl:+.2f} excl edge)")
print(f"qualifying transitions total: {len(q)}; earlier qualifying: {int((q.CE < first).sum())}")
print("Form at/after the drop (1700-500 BCE), unique values:",
      sorted(anchors[anchors.CE >= -1700][FORM].unique().tolist()))
print("Decoration at/after 1700 BCE, unique values:",
      sorted(anchors[anchors.CE >= -1700][DEC].unique().tolist()))
