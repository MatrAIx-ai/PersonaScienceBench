"""How coupled are the two diversity series overall?  The single divergent
century is meaningful only against this background."""
import numpy as np, pandas as pd
t = pd.read_csv("analysis/century_change_table.csv")
n = len(t)
same = int(((np.sign(t.d_dec) == np.sign(t.d_form)) & (t.d_dec != 0)).sum())
dec_up_form_down = int(((t.d_dec > 0) & (t.d_form < 0)).sum())
dec_dn_form_up = int(((t.d_dec < 0) & (t.d_form > 0)).sum())
flat = int(((t.d_dec == 0) | (t.d_form == 0)).sum())
print(f"transitions: {n}")
print(f"  same direction (both move): {same}")
print(f"  dec up / form down        : {dec_up_form_down}   -> CE {int(t.loc[(t.d_dec>0)&(t.d_form<0),'CE'].iloc[0])}")
print(f"  dec down / form up        : {dec_dn_form_up}")
print(f"  at least one series flat  : {flat}")
print(f"  Pearson r(d_dec, d_form)  : {np.corrcoef(t.d_dec, t.d_form)[0,1]:.3f}")
print(f"  Spearman rho              : {pd.Series(t.d_dec).corr(pd.Series(t.d_form), method='spearman'):.3f}")
print(f"  Pearson r(levels)         : {np.corrcoef(t.PotteryDecoration, t.PotteryForm)[0,1]:.3f}")
print("\nLevel correlation before/after 1700 BCE:")
pre = t[t.CE < -1700]; post = t[t.CE >= -1700]
print(f"  before (22 transitions): r={np.corrcoef(pre.PotteryDecoration, pre.PotteryForm)[0,1]:.3f}")
print(f"  after  (14 transitions): r={np.corrcoef(post.PotteryDecoration, post.PotteryForm)[0,1]:.3f}")
