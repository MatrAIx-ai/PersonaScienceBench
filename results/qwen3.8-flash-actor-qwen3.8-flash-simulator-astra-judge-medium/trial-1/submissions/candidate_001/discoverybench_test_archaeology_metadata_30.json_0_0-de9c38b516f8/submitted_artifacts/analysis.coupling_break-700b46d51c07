"""Structural-break context for the answer.
Before the 1800-1700 BCE transition the two diversity series move almost in
lockstep (d_form ~= 1.30 * d_dec); the transition breaks that coupling.  This is
why the single opposite-trend century is not a random wiggle."""
import numpy as np, pandas as pd
t = pd.read_csv("analysis/century_change_table.csv")
pre, post = t[t.CE < -1700], t[t.CE >= -1700]
print(f"pre  (<= 1800 BCE anchors): n={len(pre)}  r(d_dec,d_form)={np.corrcoef(pre.d_dec, pre.d_form)[0,1]:.4f}  "
      f"sign agreement {int((np.sign(pre.d_dec)==np.sign(pre.d_form)).sum())}/{len(pre)}")
print(f"post (>= 1700 BCE anchors): n={len(post)} r(d_dec,d_form)={np.corrcoef(post.d_dec, post.d_form)[0,1]:.4f}")
sl = np.polyfit(pre.d_dec, pre.d_form, 1)
r = pre.d_form - np.polyval(sl, pre.d_dec)
br = t.loc[t.CE == -1700]
resid = float(br.d_form.iloc[0] - np.polyval(sl, br.d_dec.iloc[0]))
print(f"pre-transition coupling: d_form = {sl[0]:.3f}*d_dec + {sl[1]:.3f}, residual sd = {r.std(ddof=1):.4f}")
print(f"break century CE -1700: d_dec={br.d_dec.iloc[0]:+.2f}, d_form={br.d_form.iloc[0]:+.2f}, "
      f"residual={resid:+.2f} = {resid/r.std(ddof=1):.0f} pre-period residual sd")
print(f"level correlation r(PotteryDecoration, PotteryForm): all={np.corrcoef(t.PotteryDecoration, t.PotteryForm)[0,1]:.3f}, "
      f"pre={np.corrcoef(pre.PotteryDecoration, pre.PotteryForm)[0,1]:.3f}, post={np.corrcoef(post.PotteryDecoration, post.PotteryForm)[0,1]:.3f}")
