"""Why the zero-threshold rolling-slope check shows spurious early episodes
(e.g. CE -3254 / -3508): those windows have slopes orders of magnitude smaller
than the 1800-1700 BCE transition. Printed per-episode magnitudes."""
import numpy as np, pandas as pd
ts = pd.read_csv("data/time_series_data.csv", index_col=0)
s = ts.set_index("CE")[["PotteryDecoration_inter", "PotteryForm_inter"]].sort_index()
for w in (200, 300):
    x = np.arange(w)
    sd = s.PotteryDecoration_inter.rolling(w).apply(lambda v: np.polyfit(x, v, 1)[0])
    sf = s.PotteryForm_inter.rolling(w).apply(lambda v: np.polyfit(x, v, 1)[0])
    ok = ((sd > 0) & (sf < 0)).fillna(False)
    yrs = pd.Series(s.index, index=s.index)[ok]
    grp = (yrs.diff().fillna(1) > 1).cumsum()
    print(f"--- window {w} yr, sign-only criterion: {len(grp.unique())} episodes ---")
    for gid, g in yrs.groupby(grp):
        a, b = g.iloc[0], g.iloc[-1]
        print(f"  CE {a} .. {b}  n={len(g):4d}  max dec slope={sd.loc[g].max():.3e}/yr  "
              f"min form slope={sf.loc[g].min():.3e}/yr  "
              f"peak-to-peak ratio vs last episode: see below")
    # relative magnitude vs the 1800-1700 BCE transition window
    ref = sd[(s.index >= -1900) & (s.index <= -1600)].max()
    ref_f = sf[(s.index >= -1900) & (s.index <= -1600)].min()
    print(f"  reference (transition window 1900-1600 BCE): max dec slope={ref:.3e}/yr, min form slope={ref_f:.3e}/yr")
    for gid, g in yrs.groupby(grp):
        print(f"    episode CE {g.iloc[0]}: dec ratio={sd.loc[g].max()/ref:.3f}, "
              f"form ratio={sf.loc[g].min()/ref_f:.3f}")
