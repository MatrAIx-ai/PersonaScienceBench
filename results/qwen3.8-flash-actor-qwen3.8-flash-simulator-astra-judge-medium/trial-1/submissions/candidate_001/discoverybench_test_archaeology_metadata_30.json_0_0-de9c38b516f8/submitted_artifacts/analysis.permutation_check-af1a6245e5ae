"""Is the 1800-1700 BCE pairing (Decoration up + Form down, both extreme)
more extreme than chance?  Monte-Carlo: independently permute the 36 century
changes of each variable (breaks any coupling, keeps marginal distributions),
and ask how often some century reaches the observed z-pair severity.
Note the sign-only criterion is NOT rare on its own: with 36 transitions and
independent signs we expect ~9 opposite-sign centuries (dec up / form down
about ~1/4 of them), so the evidence is in the joint MAGNITUDE, not the sign."""
import numpy as np, pandas as pd
t = pd.read_csv("analysis/century_change_table.csv")
dd, ff = t.d_dec.values, t.d_form.values
zd = (dd - dd.mean()) / dd.std(ddof=1)
zf = (ff - ff.mean()) / ff.std(ddof=1)
n = len(dd)
obs_sign = int(((dd > 0) & (ff < 0)).sum())
exp_sign = ((dd > 0).mean()) * ((ff < 0).mean()) * n
severity_obs = np.minimum(zd, -zf).max()
rng = np.random.default_rng(20261022)
B = 200000
sev = np.empty(B)
for i in range(B):
    a = zd[rng.permutation(n)]; b = zf[rng.permutation(n)]
    sev[i] = np.minimum(a, -b).max()
print(f"n transitions              : {n}")
print(f"opposite-sign (dec up/form down) observed : {obs_sign}")
print(f"expected under independent signs          : {exp_sign:.1f}")
print(f"observed severity max_c min(z_dec_c, -z_form_c) = {severity_obs:.3f}")
print(f"  (i.e. the same century has z_dec=+{zd[(dd>0)&(ff<0)][0]:.2f} and z_form={zf[(dd>0)&(ff<0)][0]:.2f})")
p = (sev >= severity_obs).mean()
print(f"permutation p-value (2-sided joint severity) = {p:.5f}  ({int((sev>=severity_obs).sum())}/{B})")
print(f"permutation distribution of severity: median {np.median(sev):.3f}, 95th pct {np.quantile(sev,0.95):.3f}, max {sev.max():.3f}")
# also: how often does a permuted century have BOTH z_dec>=1.45-equivalent and z_form<=-1.87-equivalent
raw_sev = np.empty(B)
for i in range(B):
    a = dd[rng.permutation(n)]; b = ff[rng.permutation(n)]
    raw_sev[i] = np.minimum(a, -b).max()
k = (dd > 0) & (ff < 0)
obs_raw = min(dd[k][0], -ff[k][0])
print(f"raw-delta severity observed = {obs_raw:.2f}; permutation p = {(raw_sev >= obs_raw).mean():.5f}")
