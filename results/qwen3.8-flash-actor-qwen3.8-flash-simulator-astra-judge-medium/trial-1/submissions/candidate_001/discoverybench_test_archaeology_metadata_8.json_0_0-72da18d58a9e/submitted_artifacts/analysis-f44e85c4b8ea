"""
Final analysis: In which millennium did amber have the highest value, and in what time
interval did it peak?

Primary series : time_series_data.csv :: Amber_inter (annual Z-score, interpolated)
Anchor check   : time_series_data.csv :: Amber (100-yr anchors) and capital.csv :: Zamber
Millennia      : BCE-calendar bins (primary, ceil convention: 4th mil BCE = 4000-3001 BCE)
                 + floor convention + calBP bins, all reported (offsets made explicit)
Peak interval  : plateau of max value, rolling-mean centres (50-250y), sustained-high threshold
Context        : CopperGold_inter, MonumentCount_inter (social-capital cross-check, secondary)
                 pollen / pollen_inter_100 / pollen_grate_100 / kde_all_mean (descriptive only)
"""
import numpy as np, pandas as pd

pd.set_option('display.width', 220); pd.set_option('display.max_rows', 400)
TS, CAP, POL = ('data/time_series_data.csv', 'data/capital.csv',
                'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
ts  = pd.read_csv(TS, index_col=0)
cap = pd.read_csv(CAP, decimal=',')
pol = pd.read_csv(POL, index_col=0, decimal=',')

OUT = []
def say(*a):
    s = " ".join(str(x) for x in a)
    print(s); OUT.append(s)

say("="*90); say("0. DATA / ALIGNMENT SANITY")
say(f"time_series_data: {ts.shape}, CE {ts.CE.min()}..{ts.CE.max()}, calBP {ts.calBP.min()}..{ts.calBP.max()}, "
    f"annual & contiguous (missing yrs={len(set(range(int(ts.CE.min()),int(ts.CE.max())+1))-set(ts.CE.astype(int)))})")
say(f"capital: {cap.shape}, BCE {cap.BCE.min()}..{cap.BCE.max()} step {np.diff(sorted(cap.BCE.unique())).min()}")
say(f"pollen : {pol.shape}, CE {pol.CE.min()}..{pol.CE.max()}")
say(f"identity calBP + CE == 1950 for all rows: {bool(((ts.calBP+ts.CE)==1950).all())}")

# --- mapping / same-series check: CE = -BCE (sign flip, no year-0 correction) ---
pairs = [('Zamber','Amber'),('ZCU_AU','CopperGold'),('ZMonument','MonumentCount')]
for cb, tb in pairs:
    for off, lab in ((0,'CE=-BCE'), (1,'CE=-(BCE-1)')):
        ok = tot = 0
        for _, r in cap.iterrows():
            sub = ts.loc[ts.CE == -int(r.BCE)+off, tb]
            if len(sub):
                tot += 1
                ok += int(abs(float(sub.iloc[0]) - float(r[cb])) < 1e-9)
        say(f"  same-series test {cb:>10s} vs {tb:<15s} [{lab:>13s}]: exact matches {ok}/{tot}")
ov = ts[['CE','pollen']].merge(pol[['CE','Belau_PC1']], on='CE', how='inner').dropna()
say(f"  ts.pollen == Belau_PC1 identity on {np.isclose(ov.pollen, ov.Belau_PC1, atol=1e-9).sum()}/{len(ov)} overlapping rows")

say("="*90); say("1. COVERAGE OF AMBER COLUMNS")
for c in ['Amber','Amber_inter']:
    s = ts[c]; say(f"  {c:12s} n={len(s)} nonnull={s.notna().sum()} NaN={s.isna().sum()} "
                   f"({100*s.isna().mean():.1f}%) min={s.min():.2f} max={s.max():.2f} mean={s.mean():.3f}")
anch = ts.dropna(subset=['Amber'])
say(f"  raw Amber anchors at CE multiples of 100: {anch.CE.min():.0f}..{anch.CE.max():.0f} (n={len(anch)}); "
    f"capital Zamber anchors BCE 4300..500 (n={len(cap)}) -> BCE 4300,4200 lie outside ts range")
j = anch.set_index('CE').Amber.reindex(-cap.BCE.values)
say(f"  raw Amber vs capital Zamber at shared anchors: exact matches {int(np.isclose(j.values, cap.Zamber.values, atol=1e-9).sum())}/{j.notna().sum()} (rest NaN = outside ts range)")

# ---------------------------------------------------------------- millennia
say("="*90); say("2. MILLENNIUM TABLES  (primary = mean of Amber_inter)")
d = ts[['CE','calBP','Amber_inter','Amber','CopperGold_inter','MonumentCount_inter',
        'pollen','pollen_inter','pollen_inter_100','pollen_grate_100','kde_all_mean']].copy()
d['BCE'] = -d.CE
# BCE-calendar millennium: ceil -> bin k == [ (k-1)*1000+1 .. k*1000 ] BCE  (4 => 4000-3001 BCE)
d['mil_ceil']  = np.ceil(d.BCE/1000).astype(int)
d['mil_floor'] = np.floor(d.BCE/1000).astype(int)   # bin k == [k*1000 .. k*1000+999] BCE
d['mil_calBP'] = np.ceil(d.calBP/1000).astype(int)

ORD = ['ordinal','label_BCE','n_years','mean_Amber_inter','max_Amber_inter',
       'mean_Amber_anchor','mean_CopperGold','mean_MonumentCount']
def mil_table(col, kind):
    g = d.groupby(col)
    rows = []
    for k, sub in g:
        if kind == 'ceil':
            lo, hi = (k-1)*1000+1, k*1000
            lab = f"{lo}-{hi} BCE ({k}th mil BCE)" if k >= 1 else f"{hi} BCE or later"
        elif kind == 'floor':
            lo, hi = k*1000, k*1000+999
            lab = f"{lo}-{hi} BCE"
        else:
            lo, hi = (k-1)*1000+1, k*1000
            lab = f"calBP {lo}-{hi}"
        rows.append(dict(ordinal=k, label_BCE=lab, n_years=len(sub),
                         mean_Amber_inter=sub.Amber_inter.mean(), max_Amber_inter=sub.Amber_inter.max(),
                         mean_Amber_anchor=sub.Amber.mean(), mean_CopperGold=sub.CopperGold_inter.mean(),
                         mean_MonumentCount=sub.MonumentCount_inter.mean()))
    return pd.DataFrame(rows)[ORD].sort_values('mean_Amber_inter', ascending=False)

T_ceil, T_floor, T_calbp = mil_table('mil_ceil','ceil'), mil_table('mil_floor','floor'), mil_table('mil_calBP','calbp')
say("\n2a. BCE-calendar millennia, CEIL convention (PRIMARY; 4th mil BCE = 4000-3001 BCE), ranked:")
say(T_ceil.round(3).to_string(index=False))
say("\n2b. BCE-calendar millennia, FLOOR convention (bin k = k*1000..k*1000+999 BCE), ranked:")
say(T_floor.round(3).to_string(index=False))
say("\n2c. calBP-binned millennia (ceil(calBP/1000)), ranked -- NOTE: labels differ from BCE by the 1950-yr calBP offset:")
say(T_calbp.round(3).to_string(index=False))

# anchor-level (capital Zamber) cross-check, independent of ts
cap['mil_ceil'] = np.ceil(cap.BCE/1000).astype(int)
g = cap.groupby('mil_ceil').Zamber.agg(['count','mean','max']).reset_index()
g['label_BCE'] = [f"{(k-1)*1000+1}-{k*1000} BCE" for k in g.mil_ceil]
say("\n2d. Independent anchor cross-check from capital.csv (Zamber, 100-yr anchors, ceil bins):")
say(g[['mil_ceil','label_BCE','count','mean','max']].sort_values('mean', ascending=False).round(3).to_string(index=False))

# partial edge millennia, inclusion vs exclusion
full = T_ceil[T_ceil.n_years >= 900]
say("\n2e. Edge/partial bins: " + "; ".join(
    f"bin {int(r.ordinal)} [{r.label_BCE}] n_years={int(r.n_years)} mean={r.mean_Amber_inter:.3f}"
    for _, r in T_ceil[T_ceil.n_years < 900].iterrows()))
say("    ranking INCLUDING partials :", list(T_ceil.ordinal))
say("    ranking EXCLUDING partials :", list(full.ordinal))
say(f"    top bin both ways -> {'IDENTICAL' if T_ceil.iloc[0].ordinal==full.iloc[0].ordinal else 'DIFFERENT'}"
    f" (bin {int(T_ceil.iloc[0].ordinal)}); rank of bin 4 excluding partials = "
    f"{list(full.ordinal).index(int(T_ceil.iloc[0].ordinal))+1}")

# ---------------------------------------------------------------- peak
say("="*90); say("3. PEAK INTERVAL (no single point: the max is a flat plateau)")
mx = d.Amber_inter.max()
plateau = d.loc[np.isclose(d.Amber_inter, mx, atol=1e-9), 'CE']
p_lo, p_hi = int(plateau.min()), int(plateau.max())
say(f"3a. max Amber_inter = {mx:.2f}; plateau CE {p_lo}..{p_hi} ({p_hi-p_lo+1} yrs) = BCE {-p_lo}..{-p_hi}"
    f" = calBP {1950-p_lo}..{1950-p_hi} (calBP descending with CE)")
say("    plateau arises because capital/ts anchors BCE 3300,3200,3100,3000 all carry Zamber=1.54 "
    "-> single-bin max is ill-defined; resolution limit = +/-1 century (100-yr anchor grid)")
rows = []
for w in (50,100,150,200,250):
    rm = d.Amber_inter.rolling(w, center=True).mean(); i = int(rm.idxmax())
    in_pl = p_lo <= d.CE.loc[i] <= p_hi
    rows.append(dict(window_yrs=w, smoothed_max=rm.max(), centre_CE=int(d.CE.loc[i]),
                     centre_calBP=int(d.calBP.loc[i]),
                     window_CE=f"{int(d.CE.loc[max(0,i-w//2)])}..{int(d.CE.loc[min(len(d)-1,i+w//2)])}",
                     centre_inside_plateau=in_pl))
say("\n3b. rolling-mean (centered) peak centres:")
say(pd.DataFrame(rows).round(3).to_string(index=False))
for thr_name, thr in ((">=1.4 (max-0.14)", mx-0.14), (">=1.44 (max-0.1)", mx-0.1), (">=1.5", mx-0.04),
                      (">=1.0", 1.0), (">=90th pct", d.Amber_inter.quantile(.90))):
    m = d.Amber_inter >= thr
    runs = [(int(g.CE.min()), int(g.CE.max())) for _, g in d[m.values].groupby(
        (m.astype(int) != m.astype(int).shift()).cumsum()[m.values])]
    say(f"3c. sustained-high {thr_name:<18s} thr={thr:.3f}: n={int(m.sum())} yrs, runs {runs}")

# ---------------------------------------------------------------- context
say("="*90); say("4. SECONDARY CROSS-CHECKS (descriptive only, no causal claims)")
IN  = (d.CE >= -3500) & (d.CE <= -3000)          # peak-context window (covers plateau)
OUTm= ~IN
for a in ('CopperGold_inter', 'MonumentCount_inter', 'pollen_inter_100',
          'pollen', 'pollen_grate_100', 'kde_all_mean'):
    b = 'Amber_inter'
    r_in  = d.loc[IN, [a,b]].corr().iloc[0,1]
    r_out = d.loc[OUTm,[a,b]].corr().iloc[0,1]
    r_all = d[[a,b]].corr().iloc[0,1]
    flip = "   <-- SIGN/DIRECTION FLIPS vs full span" if (not np.isnan(r_in)) and np.sign(r_in) != np.sign(r_all) else ""
    say(f"  corr(Amber_inter, {a:<18s}) full={r_all:+.3f}  peak-window(-3500..-3000 CE)={r_in:+.3f}  outside={r_out:+.3f}{flip}")
say("\n  social-capital triad, mean Z by millennium (top-3 bins by Amber):")
say(T_ceil.head(3)[['label_BCE','mean_Amber_inter','mean_CopperGold','mean_MonumentCount']].round(3).to_string(index=False))
say(f"  in peak window: Amber_inter mean={d.loc[IN,'Amber_inter'].mean():.2f}, "
    f"CopperGold_inter mean={d.loc[IN,'CopperGold_inter'].mean():.2f}, "
    f"MonumentCount_inter mean={d.loc[IN,'MonumentCount_inter'].mean():.2f}  (full-span means: "
    f"{d.Amber_inter.mean():.2f} / {d.CopperGold_inter.mean():.2f} / {d.MonumentCount_inter.mean():.2f})")
say(f"  peak-window context: pollen_inter_100 mean={d.loc[IN,'pollen_inter_100'].mean():.2f} vs "
    f"overall {d.pollen_inter_100.mean():.2f}; kde_all_mean mean={1e4*d.loc[IN,'kde_all_mean'].mean():.3f}e-4 vs "
    f"overall {1e4*d.kde_all_mean.mean():.3f}e-4")
say(f"  rank of social-capital partners in the 4th-mil-BCE bin: Amber rank 1 of all bins; "
    f"CopperGold rank={list(T_ceil.mean_CopperGold.rank(ascending=False))[list(T_ceil.ordinal).index(4)]:.0f}, "
    f"MonumentCount rank={list(T_ceil.mean_MonumentCount.rank(ascending=False))[list(T_ceil.ordinal).index(4)]:.0f} "
    f"(of {len(T_ceil)} bins)")
say(f"  archaeological period labels (capital.csv 'group') covering BCE 4000-3000: "
    f"{sorted(cap.loc[cap.BCE.between(3000,4000),'group'].unique())} "
    f"(EN {int(cap.loc[cap.group=='EN','BCE'].min())}-{int(cap.loc[cap.group=='EN','BCE'].max())}, "
    f"MN {int(cap.loc[cap.group=='MN','BCE'].min())}-{int(cap.loc[cap.group=='MN','BCE'].max())} BCE)")

with open('analysis_output.txt','w') as f: f.write("\n".join(OUT)+"\n")
say("="*90); say("saved: analysis_output.txt")
