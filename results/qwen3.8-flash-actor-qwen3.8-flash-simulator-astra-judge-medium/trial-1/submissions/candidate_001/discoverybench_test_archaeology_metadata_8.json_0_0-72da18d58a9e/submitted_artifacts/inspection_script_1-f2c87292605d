import pandas as pd, numpy as np
pd.set_option('display.width',200)

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0, decimal=',')

print("=== SHAPES ===")
print("time_series_data:", ts.shape, list(ts.columns))
print("capital:", cap.shape, list(cap.columns))
print("pollen:", pol.shape, list(pol.columns))

print("\n=== TS time ranges ===")
print("CE min/max:", ts.CE.min(), ts.CE.max(), " calBP min/max:", ts.calBP.min(), ts.calBP.max())
print("rows:", len(ts), " unique CE:", ts.CE.nunique(), " CE step diffs:", sorted(ts.CE.diff().dropna().unique())[:5])
print("check calBP+CE == 1950 constant?:", (ts.calBP + ts.CE).unique()[:5], (ts.calBP+ts.CE).nunique())
print("CE gaps (missing years):")
full = range(int(ts.CE.min()), int(ts.CE.max())+1)
missing = sorted(set(full)-set(ts.CE.astype(int)))
print(" n missing:", len(missing), missing[:20])

print("\n=== POLLEN ranges ===")
print("calBP:", pol.calBP.min(), pol.calBP.max(), " CE:", pol.CE.min(), pol.CE.max(), "rows:", len(pol))
print("index vs CE equal?:", (pol.index.values == pol.CE.values).all())
full = range(int(pol.CE.min()), int(pol.CE.max())+1)
print("missing years:", len(set(full)-set(pol.CE.astype(int))))

print("\n=== CAPITAL ===")
print("BCE range:", cap.BCE.min(), cap.BCE.max(), "rows:", len(cap))
print("BCE unique sorted:", sorted(cap.BCE.unique()))
print("groups:", cap.group.value_counts().to_dict())
