import pandas as pd, numpy as np
pd.set_option('display.width',250); pd.set_option('display.max_rows',400)
ts = pd.read_csv('data/time_series_data.csv', index_col=0)

def blocks(ce_values):
    v = list(ce_values); out=[]; start=v[0]; prev=v[0]
    for x in v[1:]:
        if x != prev+1: out.append((start,prev)); start=x
        prev=x
    out.append((start,prev)); return out

print("=== AMBER columns coverage (time_series_data) ===")
for c in ['Amber','Amber_inter']:
    s = ts[c]
    print(f"{c}: n={len(s)} nonnull={s.notna().sum()} NaN={s.isna().sum()} ({100*s.isna().mean():.1f}%) min={s.min():.3f} max={s.max():.3f} mean={s.mean():.3f}")
    na = ts.loc[s.isna(),'CE'].astype(int).values
    if len(na): print("   NaN CE span:", na.min(), "->", na.max(), "blocks:", blocks(na))

print("\nAmber unique values:", ts.Amber.nunique(), " Amber_inter unique:", ts.Amber_inter.nunique())
print("Amber == Amber_inter at non-null Amber rows:", int((ts.Amber==ts.Amber_inter).sum()), "of", int(ts.Amber.notna().sum()))

print("\n=== Amber step structure: how long does Amber_inter stay constant? ===")
d = ts[['CE','Amber','Amber_inter']].copy()
ch = d.Amber_inter != d.Amber_inter.shift()
print("n changes in Amber_inter:", int(ch.sum()))
seg = d[ch].CE.values
print("change-point CEs (first 60):", seg[:60])

print("\n=== NaN counts all columns ===")
print(ts.isna().sum().to_string())

print("\n=== Amber raw non-null at which CEs (first 40 change points) ===")
chA = d.Amber != d.Amber.shift()
print("n changes in Amber (raw, NaN counted):", int(chA.sum()))
