import pandas as pd, numpy as np
pd.set_option('display.width',250); pd.set_option('display.max_rows',300)
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')

# BCE -> CE mapping test
pairs = [('Zamber','Amber'),('ZCU_AU','CopperGold'),('ZMonument','MonumentCount'),('ZMW','MonumentSize'),('Zkeverz','PotteryDecoration')]
print("=== mapping test: does capital row BCE=b match ts CE=-b (astronomical, year 0 = 1BCE/1CE continuous) ===")
for cb, tb in pairs:
    for off,lab in [(0,'CE=-BCE'),(1,'CE=-(BCE-1)')]:
        ok=0; tot=0
        for _,r in cap.iterrows():
            ce = -int(r.BCE)+off
            sub = ts[ts.CE==ce]
            if len(sub):
                tot+=1
                if abs(float(sub[tb].iloc[0]) - float(r[cb]))<1e-9 or (pd.isna(sub[tb].iloc[0]) and pd.isna(r[cb])): ok+=1
        print(f"  {cb:10s} vs {tb:18s} {lab:14s} match {ok}/{tot}")

print("\n=== capital Zamber full table ===")
print(cap[['BCE','group','Zamber','ZCU_AU','ZMonument']].to_string(index=False))
print("\nmax Zamber:", cap.Zamber.max(), "at BCE", cap.loc[cap.Zamber.idxmax(),'BCE'], "group", cap.loc[cap.Zamber.idxmax(),'group'])
print("NaN in capital:", cap.isna().sum().sum())
