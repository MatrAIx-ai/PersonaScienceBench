import pandas as pd, numpy as np
pd.set_option('display.width',250); pd.set_option('display.max_rows',400)
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0, decimal=',')

print("=== capital group/color map (is 'group' a capital-group or period label?) ===")
print(cap.groupby(['group','color']).size().to_string())
print("BCE span per group:"); print(cap.groupby('group').BCE.agg(['min','max','count']).to_string())

print("\n=== ts.pollen vs pollen file columns ===")
m = ts[['CE','pollen','pollen_inter','pollen_inter_100']].merge(pol[['CE','Belau_PC1','Belau_PC1_inter','MEAN','SMOOTH_MEAN_100y','Woserin_PC1']], on='CE', how='inner')
print("overlap rows:", len(m), "CE overlap:", m.CE.min(), m.CE.max())
for a in ['Belau_PC1','Belau_PC1_inter','MEAN','SMOOTH_MEAN_100y']:
    sub = m[['pollen',a]].dropna()
    subi = m[['pollen_inter',a]].dropna()
    print(f"  ts.pollen vs {a}: identical={np.isclose(sub.iloc[:,0],sub.iloc[:,1],atol=1e-9).mean() if len(sub) else 'n/a'!s:>8} corr(raw)={sub.corr().iloc[0,1] if len(sub)>3 else float('nan'):.3f} corr(inter)={subi.corr().iloc[0,1]:.3f}")

print("\n=== PRELIMINARY (not final): Amber peaks ===")
d = ts[['CE','calBP','Amber_inter','Amber','CopperGold_inter','MonumentCount_inter']].copy()
print("annual Amber_inter max:", d.Amber_inter.max(), "at CE", int(d.loc[d.Amber_inter.idxmax(),'CE']), "= calBP", int(d.loc[d.Amber_inter.idxmax(),'calBP']))
top = d.nlargest(10,'Amber_inter')[['CE','calBP','Amber_inter']]
print(top.to_string(index=False))
for w in [100,200]:
    rm = d.Amber_inter.rolling(w, center=True).mean()
    i = rm.idxmax()
    lo, hi = d.CE[max(0,i-w//2)], d.CE[min(len(d)-1,i+w//2)]
    print(f"rolling{w}: max={rm.max():.4f} center CE={int(d.CE.loc[i])} window CE {int(lo)}..{int(hi)}")

print("\n=== PRELIMINARY: mean Amber by millennium ===")
d['mil_calBP'] = np.ceil(d.calBP/1000).astype(int)          # calBP-based millennium index
d['milBCE'] = np.floor((-d.CE)/1000).astype(int)            # BCE millennium index: 4 => 4000-3001 BCE
def lab_bce(x):
    lo, hi = x*1000, x*1000+999
    return f"{lo}-{hi} BCE" if x>0 else f"1-999 BCE"
g = d.groupby('milBCE').agg(n=('Amber_inter','size'), amber_mean=('Amber_inter','mean'),
                            amber_mean_century_anchor=('Amber','mean'),
                            cu_mean=('CopperGold_inter','mean'), mon_mean=('MonumentCount_inter','mean'),
                            amber_max=('Amber_inter','max'))
g['label']= [lab_bce(i) for i in g.index]
print(g.round(3).to_string())
print("\ncapital Zamber by BCE millennium (century anchors only):")
cap['milBCE']=np.floor(cap.BCE/1000).astype(int)
print(cap.groupby('milBCE').Zamber.agg(['mean','max','count']).round(3).to_string())
