import pandas as pd, numpy as np
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
d = ts[['CE','calBP','Amber_inter','Amber','CopperGold_inter','MonumentCount_inter','pollen_inter_100','kde_all_mean']]
# plateau of max value
mx = d.Amber_inter.max()
mask = np.isclose(d.Amber_inter, mx, atol=1e-9)
ces = d.CE[mask].values
print("plateau at max=%.3f: CE %d..%d (%d yrs), calBP %d..%d" % (mx, ces.min(), ces.max(), len(ces), 1950-ces.min(), 1950-ces.max()))
# is Amber_inter linear between century anchors?
ch = (d.Amber_inter != d.Amber_inter.shift()).sum()
print("annual value changes in Amber_inter:", ch, "-> non-stepwise (interpolated) " )
# interval above thresholds (sustained-high)
for thr in [1.0, 1.2, 1.4]:
    m2 = d.Amber_inter >= thr
    if m2.sum():
        print(f">= {thr}: CE {d.CE[m2].min()}..{d.CE[m2].max()} ({m2.sum()} yrs)")
# 50-year smoothing peak too
for w in [50,150,250,500]:
    rm = d.Amber_inter.rolling(w, center=True).mean(); i=rm.idxmax()
    print(f"roll{w}: max={rm.max():.3f} center CE={int(d.CE.loc[i])}")
# alternative calBP-based millennium binning
d['mil_calBP']=np.ceil(d.calBP/1000).astype(int)
print("\nmean Amber by calBP-millennium (ceil(calBP/1000)):")
print(d.groupby('mil_calBP').Amber_inter.agg(['mean','max','size']).round(3).to_string())
# pollen context at amber peak
w = d[(d.CE<=-3000)&(d.CE>=-3500)]
print("\npollen_inter_100 mean in amber-peak window (-3500..-3000): %.2f ; overall %.2f" % (w.pollen_inter_100.mean(), d.pollen_inter_100.mean()))
print("kde_all_mean in window: %.5f ; overall %.5f" % (w.kde_all_mean.mean(), d.kde_all_mean.mean()))
print("corr Amber_inter vs pollen_inter_100: %.3f ; vs CopperGold %.3f ; vs MonumentCount %.3f" % (
  d.Amber_inter.corr(d.pollen_inter_100), d.Amber_inter.corr(d.CopperGold_inter), d.Amber_inter.corr(d.MonumentCount_inter)))
