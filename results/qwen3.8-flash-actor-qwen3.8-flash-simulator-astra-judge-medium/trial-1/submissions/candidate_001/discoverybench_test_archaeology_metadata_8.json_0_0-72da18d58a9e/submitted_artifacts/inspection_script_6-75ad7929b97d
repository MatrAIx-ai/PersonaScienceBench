import pandas as pd, numpy as np
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
d = ts[['CE','calBP','Amber_inter','Amber']].copy()
# contiguous runs above thresholds (raw-anchor based, cleaner)
cap = ts.dropna(subset=['Amber'])[['CE','Amber']]
print("century anchors present at CE:", sorted(cap.CE.astype(int))[:5], "...", sorted(cap.CE.astype(int))[-3:])
for thr in [0.0,1.0,1.4,1.5]:
    m = d.Amber_inter>=thr
    runs=[]; 
    if m.any():
        s=m.astype(int); g=(s!=s.shift()).cumsum(); 
        for _,grp in d[s==1].groupby(g[s==1]):
            runs.append((int(grp.CE.min()),int(grp.CE.max())))
    print(f"Amber_inter>={thr}: runs {runs}")
# rank of millennia
d['mil']=np.floor(-d.CE/1000).astype(int)
tab=d.groupby('mil').Amber_inter.agg(['mean','max']).sort_values('mean',ascending=False)
print("\nmillennium ranking by mean Amber_inter (floor(-CE/1000), i.e. 3 = 3000-3999 BCE-ish):")
print(tab.round(3).to_string())
d['mil2']=np.ceil(-d.CE/1000).astype(int)   # strict astronomical millennium: 4 = 3999..3000 BCE? -> label
tab2=d.groupby('mil2').Amber_inter.agg(['mean','max']).sort_values('mean',ascending=False)
print("\nalternative ceil binning (k = (k-1)*1000+1 .. k*1000 BCE):")
print(tab2.round(3).to_string())
