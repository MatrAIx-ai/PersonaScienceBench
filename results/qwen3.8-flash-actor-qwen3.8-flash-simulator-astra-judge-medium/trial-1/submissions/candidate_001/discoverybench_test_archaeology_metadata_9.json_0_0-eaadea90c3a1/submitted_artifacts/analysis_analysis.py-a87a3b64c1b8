#!/usr/bin/env python3
"""
MAIN ANALYSIS -- DiscoveryBench archaeology task
Question: in which century did SUMMED SOCIAL CAPITAL peak, and which individual
social-capital components (gold, monuments, ...) increase?

Inputs (staged public data):
  data/time_series_data.csv                                      -> analysis table: annual grid, 12 Z series + *_inter
  data/capital.csv                                               -> same raw century grid (German abbrevs) + period labels
  data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv -> demographic / land-use covariate

Verified preconditions (see analysis/inspection_phase.py, inspection_phase_output.txt):
  * capital.csv and the pollen file use COMMA decimals -> read with decimal=","
  * capital.csv BCE maps to time_series CE as CE = -BCE (12/12 exact value matches per row);
    its two leading rows (BCE 4300, 4200) duplicate the BCE 4100 row -> dropped
  * *_inter == raw exactly at the 37 century grid points and is LINEAR in between (no new information)
  * the Z columns are already standardised (SD ~ 1) for the 3 social components, so a plain
    equal-weight sum is dimensionally meaningful; Sickle (SD .55) / MonumentSize (SD .67) are exceptions
  * astronomical year numbering, no year 0; CONVENTIONAL BCE century bins:
    century n BCE = [n*100 .. n*100-99] BCE  ==  cent = floor(CE/100)*100
    (so bin -1400 = 1400-1301 BCE = 14th c. BCE; a source grid point labelled BCE 1400
     is the FIRST year of the 14th c. BCE -- this is the convention capital.csv's row labels use)
"""
import numpy as np, pandas as pd
pd.set_option("display.width", 230); pd.set_option("display.max_columns", 40)

SOCIAL   = ["CopperGold", "Amber", "MonumentCount"]
SYMBOLIC = ["HatchetSword", "Dagger", "HouseSize"]
CULTURAL = ["PotteryForm", "PotteryDecoration"]
ECONOMIC = ["Depot", "Sickle", "AxesCelts", "MonumentSize"]
ALL      = SOCIAL + SYMBOLIC + CULTURAL + ECONOMIC
GROUP_OF = {**{c: "social" for c in SOCIAL}, **{c: "symbolic" for c in SYMBOLIC},
            **{c: "cultural" for c in CULTURAL}, **{c: "economic" for c in ECONOMIC}}
LABEL = {"CopperGold": "Copper&Gold", "Amber": "Amber", "MonumentCount": "MonumentCount",
         "HatchetSword": "Hatchet&Sword", "Dagger": "Dagger", "HouseSize": "HouseSize",
         "PotteryForm": "PotteryForm", "PotteryDecoration": "PotteryDecoration",
         "Depot": "Depot", "Sickle": "Sickle", "AxesCelts": "Axes&Celts", "MonumentSize": "MonumentSize"}
CAP2TS  = {"ZAxtSchwert": "HatchetSword", "ZDolch": "Dagger", "Zhausgr": "HouseSize", "ZCU_AU": "CopperGold",
           "Zamber": "Amber", "ZMonument": "MonumentCount", "ZHort": "Depot", "ZSichel": "Sickle",
           "ZBeil": "AxesCelts", "ZMW": "MonumentSize", "ZKeform": "PotteryForm", "Zkeverz": "PotteryDecoration"}
CENT  = lambda ce: np.floor(np.asarray(ce, dtype=float) / 100.0) * 100.0      # conventional BCE bins
YR    = lambda c: f"{abs(int(c))}-{abs(int(c))-99} BCE"
ORD   = lambda n: f"{n}{'st' if n % 10 == 1 and n != 11 else 'nd' if n % 10 == 2 and n != 12 else 'rd' if n % 10 == 3 and n != 13 else 'th'}"
CENTN = lambda c: f"{ORD(abs(int(c)) // 100)} century BCE"

# ---------------------------------------------------------------- load + checks
ts  = pd.read_csv("data/time_series_data.csv")
cap = pd.read_csv("data/capital.csv", decimal=",").rename(columns=CAP2TS)
pol = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",", index_col=0)
raw_grid = ts[ts["Amber"].notna()].sort_values("CE").copy()
cap = cap[cap.BCE <= raw_grid.CE.abs().max()].copy(); cap["CE"] = -cap.BCE
chk = cap[["CE"] + ALL].merge(raw_grid[["CE"] + ALL], on="CE", suffixes=("_cap", "_ts"))
maxdev = max(float(np.abs(chk[f"{c}_cap"] - chk[f"{c}_ts"]).max()) for c in ALL)
maxdev_inter = float(np.abs(ts[ts.Amber.notna()][[c + "_inter" for c in ALL]].values -
                            ts[ts.Amber.notna()][ALL].values).max())

R = []
def say(*a):
    s = " ".join(str(x) for x in a); R.append(s); print(s)

say("=" * 96); say("0. PRECONDITIONS RE-VERIFIED IN THIS RUN")
say(f"  time_series : {ts.shape[0]} annual rows, CE {ts.CE.min()}..{ts.CE.max()}, step 1, no year 0 -> {len(np.unique(CENT(ts.CE)))} century bins")
say(f"  raw Z grid  : {len(raw_grid)} century points, CE {raw_grid.CE.min()}..{raw_grid.CE.max()} (step 100)")
say(f"  capital.csv : {len(chk)} usable rows; max |capital - time_series| over 12 series = {maxdev:.1e}"
    "  -> capital.csv is redundant with the raw grid (cross-validated)")
say(f"  _inter vs raw at the 37 grid points: max abs diff = {maxdev_inter:.1e} (interpolation adds no information)")
sd = raw_grid[ALL].std()
say("  raw Z SD (37 pts): " + ", ".join(f"{c}={sd[c]:.2f}" for c in ALL))
say("  -> SD~1 for all 3 social components => equal-weight sum is meaningful.")
say("  -> Sickle .55 / MonumentSize .67 are NOT SD~1 => cross-group MAGNITUDES are not comparable (see 4).")
say(f"  century convention: floor(CE/100)*100; bin {YR(-1400)} = {CENTN(-1400)}. NOTE: the last bin")
say(f"     {YR(-500)} holds only 1 annual value (record ends CE -500); first bin {YR(-4100)} is complete.")

# -------------------------------------------------- 1. summed social capital
d   = ts.set_index("CE").sort_index()
soc = d[[c + "_inter" for c in SOCIAL]].sum(axis=1).rename("SOCIAL")
cm  = soc.groupby(CENT(soc.index)).mean()
raw_sum = raw_grid.set_index("CE")[SOCIAL].sum(axis=1)
raw_cm  = raw_sum.groupby(CENT(raw_sum.index)).mean()
pk = float(cm.idxmax()); top = cm.sort_values(ascending=False).head(6)
gap = float(top.iloc[0] - top.iloc[1]); rng = float(cm.max() - cm.min())

say("\n" + "=" * 96)
say("1. SUMMED SOCIAL CAPITAL = CopperGold_inter + Amber_inter + MonumentCount_inter")
say("   Top-6 century bins (means of the annual interpolated series):")
for c, v in top.items(): say(f"      {YR(c):>15} ({CENTN(c)})  sum = {v:.3f}")
say(f"   HEADLINE PEAK CENTURY = {YR(pk)} = {CENTN(pk)}  (sum {cm.max():.3f})")
say(f"   top1-top2 gap = {gap:.3f} = {100*gap/cm.max():.1f}% of the peak value, {gap/cm.std(ddof=0):.2f} SD of the 37 century means"
    f"; exact ties at the max: {len(cm[cm >= cm.max()-1e-9])}")
say("   Century means 2000-900 BCE: " + "  ".join(f"{abs(int(c))//100}cBCE:{v:.2f}" for c, v in cm.loc[-2000:-900].items()))
tie = raw_cm[raw_cm >= raw_cm.max() - 1e-9]
say(f"   RAW 100-yr GRID (no interpolation): max {raw_cm.max():.3f} TIED across {[CENTN(c) for c in tie.index]}"
    f" = {[YR(c) for c in tie.index]}; top4 = " + "  ".join(f"{CENTN(c)}:{v:.3f}" for c, v in raw_cm.sort_values(ascending=False).head(4).items()))
say("   -> the source data are 100-yr bins, so the tie is a property of the DATA, not of the method;")
say("      the defensible statement is the plateau 1400-1200 BCE, centred on the 14th c. BCE.")
say("\n   SENSITIVITY -- peak century under alternative smoothing of the summed curve")
rows = []
for wl in (1, 100, 200, 300, 500):
    s = soc.rolling(wl, center=True, min_periods=1).mean().groupby(CENT(soc.index)).mean()
    t3 = s.sort_values(ascending=False).head(3)
    rows.append(dict(rule=f"centred rolling mean {wl:>3} yr", peak=CENTN(s.idxmax()), value=round(float(s.max()), 3),
                     runners_up="  ".join(f"{CENTN(c)}:{v:.2f}" for c, v in t3.iloc[1:].items())))
rows.append(dict(rule="raw 100-yr grid points", peak=f"{CENTN(raw_cm.idxmax())} (tied w/ 13th)",
                 value=round(float(raw_cm.max()), 3), runners_up="12th c.BCE:3.62  11th c.BCE:3.62"))
rows.append(dict(rule="raw grid, latest tie wins", peak=CENTN(float(tie.index.max())),
                 value=round(float(raw_cm.max()), 3), runners_up="14th c.BCE:4.24 (identical value)"))
sens = pd.DataFrame(rows); say(sens.to_string(index=False)); sens.to_csv("analysis/peak_sensitivity.csv", index=False)
say("   -> every rule falls in the 14th-12th c. BCE; light smoothing (<=100 yr) puts it in the 14th c. BCE,")
say("      heavy smoothing (>=200 yr) drags the label one century later. Single-century labels are convention-dependent.")

# --------------------------------------------------------- 2. components
cmi = d[[c + "_inter" for c in ALL]].groupby(CENT(d.index)).mean()
cmi.columns = [c[:-6] for c in cmi.columns]            # drop the _inter suffix
cmi.index.name = "century_bin_CE"
def bins(lo, hi):                                       # century bins with lo<=bin<=hi
    m = (cmi.index >= lo) & (cmi.index <= hi); return cmi[m]

cmi.round(4).to_csv("analysis/century_mean_Z_series.csv")
first, last = float(cmi.index.min()), float(cmi.index.max())
BASE = (-2500, -2200)   # 2500-2101 BCE  (pre-peak baseline)
PEAKW = (-1400, -1300)  # 1400-1201 BCE  (peak plateau)
base_w = bins(*BASE).mean(); peak_w = bins(*PEAKW).mean()
trough_c = float(cm.loc[:pk].idxmin())

say("\n" + "=" * 96)
say("2. INDIVIDUAL SOCIAL-CAPITAL COMPONENTS (century means of *_inter)")
say(f"   Contrast windows: (i) FULL SPAN {CENTN(first)} -> {CENTN(last)};"
    f" (ii) BASELINE->PEAK mean over {YR(-2500)}..{YR(-2200)} -> {CENTN(pk)} "
    f" (iii) TROUGH->PEAK {CENTN(trough_c)} -> {CENTN(pk)}")
rows = []
for c in SOCIAL:
    s = cmi[c]
    rows.append(dict(component=LABEL[c], own_peak_century=CENTN(s.idxmax()), peak_value=round(float(s.max()), 2),
        value_in_peak_century=round(float(s.loc[pk]), 2),
        full_span_delta=round(float(s.loc[last] - s.loc[first]), 2),
        baseline_to_peak_delta=round(float(peak_w[c] - base_w[c]), 2),
        trough_to_peak_delta=round(float(s.loc[pk] - s.loc[trough_c]), 2),
        rises_into_peak=bool(float(s.loc[pk]) > float(base_w[c])),
        peaks_exactly_in_peak_century=bool(float(s.idxmax()) == pk),
        pct_centuries_below_peak_value=round(100 * float((s < float(s.loc[pk])).mean()), 0),
        rank_of_peak_century_among_own_series=int((s > float(s.loc[pk])).sum() + 1)))
comp = pd.DataFrame(rows); say(comp.to_string(index=False)); comp.to_csv("analysis/component_summary.csv", index=False)

tot_bt = float(cm.loc[pk] - base_w.sum()); tot_tp = float(cm.loc[pk] - cm.loc[trough_c])
share = pd.DataFrame({"component": [LABEL[c] for c in SOCIAL],
    "baseline_to_peak": [round(float(peak_w[c] - base_w[c]), 2) for c in SOCIAL],
    "share_baseline_to_peak_pct": [round(100 * float(peak_w[c] - base_w[c]) / tot_bt, 1) for c in SOCIAL],
    "trough_to_peak": [round(float(cmi[c].loc[pk] - cmi[c].loc[trough_c]), 2) for c in SOCIAL],
    "share_trough_to_peak_pct": [round(100 * float(cmi[c].loc[pk] - cmi[c].loc[trough_c]) / tot_tp, 1) for c in SOCIAL]})
say("\n   Contribution to the SUMMED curve's rise into the peak:")
say(f"      total summed rise: baseline->peak = {tot_bt:.2f} Z ; trough({CENTN(trough_c)})->peak = {tot_tp:.2f} Z")
say(share.to_string(index=False)); share.to_csv("analysis/component_share_of_rise.csv", index=False)

# full-span direction is endpoint-sensitive -> test three definitions explicitly
raw_cmA = raw_grid.set_index("CE")
full = []
for c in SOCIAL:
    rawgrid = raw_cmA[c]
    d_raw   = float(rawgrid.loc[last] - rawgrid.loc[first])                       # grid endpoints
    d_bins  = float(cmi[c].loc[last] - cmi[c].loc[first])                         # annual-interp bin means
    d_trim  = float(cmi[c].iloc[-3:].mean() - cmi[c].iloc[:3].mean())             # first 3 vs last 3 bins
    full.append(dict(component=LABEL[c],
                     grid_endpoints=f"{d_raw:+.2f} ({'UP' if d_raw>0 else 'DOWN'})",
                     interp_bin_ends=f"{d_bins:+.2f} ({'UP' if d_bins>0 else 'DOWN'})",
                     first3_vs_last3=f"{d_trim:+.2f} ({'UP' if d_trim>0 else 'DOWN'})",
                     direction_robust=(np.sign([d_raw, d_bins, d_trim]).std() == 0)))
fs = pd.DataFrame(full); say("\n   FULL-SPAN DIRECTION ROBUSTNESS (three endpoint definitions):")
say(fs.to_string(index=False)); fs.to_csv("analysis/full_span_robustness.csv", index=False)
say("\n   Each component's own maximum, position in the peak century, and ROBUST full-span direction:")
for c, fr in zip(SOCIAL, full):
    v = cmi[c]; t3 = v.sort_values(ascending=False).head(3)
    dirn = ("UP" if v.loc[last] > v.loc[first] else "DOWN") if fr["direction_robust"] else \
           "not robust (sign flips with endpoint definition)"
    say(f"      {LABEL[c]:<14} own max = {CENTN(v.idxmax())} ({v.max():+.2f}); top3: "
        + "  ".join(f"{CENTN(k)}:{v_:+.2f}" for k, v_ in t3.items())
        + f" | value in peak century {v.loc[pk]:+.2f} (rank {int((v>v.loc[pk]).sum())+1}/37)"
        + f" | full span: {dirn}")
frag = [r["component"] for r in full if not r["direction_robust"]]
if frag:
    say(f"   -> FRAGILE for {frag}: the sign of the full-span change depends on the endpoint definition.")
    say("      We therefore do NOT claim a full-span direction for these components; the defensible")
    say("      statement about them is their OWN MAXIMUM century and their contribution to the peak.")
robust = {r["component"] for r in full if r["direction_robust"]}
up_f   = {r["component"] for r in full if r["direction_robust"]
          and float(cmi[[k for k, v in LABEL.items() if v == r["component"]][0]].loc[last])
             > float(cmi[[k for k, v in LABEL.items() if v == r["component"]][0]].loc[first])}
up_b   = {LABEL[c] for c in SOCIAL if float(peak_w[c]) > float(base_w[c])}
say("\n   DO THE TWO CONTRAST WINDOWS FLAG DIFFERENT COMPONENTS?")
say(f"   increasing over the FULL SPAN (robust): {sorted(up_f)}")
say(f"   increasing BASELINE->PEAK             : {sorted(up_b)}")
say(f"   -> by BOTH = {sorted(up_f & up_b)} ; ONLY full span = {sorted(up_f - up_b)} ;"
    " ONLY baseline->peak = " + str(sorted(up_b - up_f)))
for c in SOCIAL:
    if LABEL[c] in up_b and LABEL[c] not in up_f:
        say(f"   DIVERGENT: {LABEL[c]} rises +{float(peak_w[c]-base_w[c]):.2f} Z from the pre-peak baseline to the"
            f" peak window ({100*float(peak_w[c]-base_w[c])/tot_bt:.0f}% of the summed rise) but is one of the LOWEST"
            f" values in its own series there (rank {int((cmi[c]>cmi[c].loc[pk]).sum())+1}/37); its own maximum"
            f" ({cmi[c].max():+.2f}) sits in the {CENTN(cmi[c].idxmax())}, ~1900 yr earlier, and its full-span"
            " direction is not robust -> it is a BACKGROUND, not a driver of the peak")
# ------------------------------------------------------------- 3. pollen
pol["cent"] = CENT(pol.CE)
pc = pol.groupby("cent")[["MEAN", "SMOOTH_MEAN_100y"]].mean()
both = pd.concat([cm.rename("social"), pc["SMOOTH_MEAN_100y"].rename("openness")], axis=1).dropna()
say("\n" + "=" * 96)
say("3. POLLEN OPENNESS = DEMOGRAPHIC COVARIATE ONLY (never part of the sum)")
last_pol_bin = float(CENT(pol.CE.max()))
say(f"   COMPARISON WINDOW (must be stated): {YR(both.index.min())} .. {YR(both.index.max())}"
    f" = {len(both)} century bins. Pollen record ends CE {int(pol.CE.max())} -> last pollen-bearing bin"
    f" is {YR(last_pol_bin)}; archaeological record runs to CE {int(last)} ({YR(-500)})."
    f" The bins after {YR(last_pol_bin)} have NO pollen coverage and are excluded from every pollen statistic.")
r  = float(both.corr().iloc[0, 1]); rs = float(both.corr(method="spearman").iloc[0, 1])
r1 = float(np.corrcoef(np.diff(both.social.values), np.diff(both.openness.values))[0, 1])
say(f"   Over the shared window: Pearson r = {r:+.3f} | Spearman rho = {rs:+.3f} (n={len(both)} century bins)"
    f" | r of first differences = {r1:+.3f}")
lags = []                                              # r(lag)=corr(social[t], openness[t+lag])
for lg_i in range(-5, 6):                              # 1 bin = 100 yr
    m = pd.concat([both.social, both.openness.shift(-lg_i)], axis=1).dropna()
    if len(m) > 12: lags.append((100 * lg_i, float(m.corr().iloc[0, 1]), len(m)))
lgd = pd.DataFrame(lags, columns=["lag_yr_openness_follows", "r", "n"])
lgd.to_csv("analysis/pollen_cross_correlation.csv", index=False)
say("   lagged r (positive lag = openness FOLLOWS social capital): "
    + "  ".join(f"{int(l):+d}y:{v:+.2f}" for l, v, _ in lags))
say(f"   max |r| across lags = {lgd.r.abs().max():.2f} -> NO usable lead/lag signal; the century-resolved")
say("   series are essentially uncorrelated over the shared window, so no demographic-driving claim is made.")
say("   openness (SMOOTH_MEAN_100y) around the social peak: " + "  ".join(
    f"{CENTN(c)}:{both.openness.loc[c]:+.2f}" for c in [pk-200, pk-100, pk, pk+100, pk+200] if c in both.index))
say("   social capital in the same bins: " + "  ".join(
    f"{CENTN(c)}:{both.social.loc[c]:+.2f}" for c in [pk-200, pk-100, pk, pk+100, pk+200] if c in both.index))
om = float(both.openness.idxmax()); omn = float(both.openness.idxmin())
say(f"   openness own max in shared window = {CENTN(om)} ({both.openness.max():+.2f})"
    + ("  <- LAST century bin holding pollen data (truncation edge)" if om == float(both.index.max()) else ""))
say(f"   openness own min = {CENTN(omn)} ({both.openness.min():+.2f}); social capital there {both.social.loc[omn]:+.2f}")
rank_pk = int((both.openness > both.openness.loc[pk]).sum()) + 1
say(f"   in the SOCIAL PEAK century openness = {both.openness.loc[pk]:+.2f}, rank {rank_pk}/{len(both)} of that window")
say(f"   in the OPENNESS-MAX century social capital = {both.social.loc[om]:+.2f} vs its own peak {cm.max():+.2f}")
say("   TRUNCATION CAVEAT (stated once, governs all of section 3): the openness maximum lies on the edge")
say("   of the record, so it cannot be used to date a demographic maximum. All that is supportable is that")
say("   openness is mid-range in the social-capital peak century and that very high openness coincides with")
say("   LOW social capital late in the shared window.")
both.round(3).to_csv("analysis/social_vs_pollen_centuries.csv")

# --------------------------------------------- 4. other groups (context)
say("\n" + "=" * 96)
say("4. OTHER CAPITAL GROUPS -- CONTEXT ONLY (direction of change; MAGNITUDES NOT comparable)")
rows2 = []
for c in SYMBOLIC + CULTURAL + ECONOMIC:
    s = cmi[c]
    rows2.append(dict(group=GROUP_OF[c], component=LABEL[c], own_peak_century=CENTN(s.idxmax()),
        peak_value=round(float(s.max()), 2), value_in_peak_century=round(float(s.loc[pk]), 2),
        baseline_to_peak_delta=round(float(peak_w[c] - base_w[c]), 2),
        full_span_delta=round(float(s.loc[last] - s.loc[first]), 2),
        rises_into_peak=bool(float(s.loc[pk]) > float(base_w[c]))))
ctx = pd.DataFrame(rows2); say(ctx.to_string(index=False)); ctx.to_csv("analysis/other_groups_context.csv", index=False)
zs = pd.Series({c: float(raw_grid[c].std()) for c in ALL})
gs = {}
for nm, cols in [("social", SOCIAL), ("symbolic", SYMBOLIC), ("cultural", CULTURAL), ("economic", ECONOMIC)]:
    asis = cmi[cols].sum(axis=1); resc = (cmi[cols] / zs[cols]).sum(axis=1)
    gs[nm] = dict(peak_century_as_is=CENTN(asis.idxmax()), max_as_is=round(float(asis.max()), 2),
                  peak_century_restandardised=CENTN(resc.idxmax()), max_restandardised=round(float(resc.max()), 2),
                  n_components=len(cols))
gs = pd.DataFrame(gs).T; say("\n   Group sums as-is (scale-biased) vs re-standardised on the 37 raw points:")
say(gs.to_string()); gs.to_csv("analysis/group_sums_scale_check.csv")
say("   -> the SOCIAL group's peak century is unchanged by re-standardisation; economic/cultural peaks")
say("      differ, which is exactly why cross-group summed MAGNITUDES are not compared (Sickle SD .55,")
say("      MonumentSize SD .67 -> their sums are shrunk). Cross-group claims are restricted to DIRECTION.")
say("   Context: 'rises_into_peak' for the other 9 components = "
    + ", ".join(f"{r['component']}({'yes' if r['rises_into_peak'] else 'NO'})" for r in rows2))

say("\n" + "=" * 96)
say("5. RECONCILIATION WITH THE INDEPENDENT RAW-GRID PATH (analysis/verify_independent.py)")
say("   That script re-derives everything from capital.csv alone using raw grid values (no interpolation).")
say("   Agreement: same maximum value 4.238; same tied maxima (14th + 13th c. BCE); same own-maximum")
say("   centuries (Copper&Gold 12th, Amber 33rd, MonumentCount 27th); same rank of the peak century.")
for c in ["MonumentCount", "Amber"]:
    rawv = float(raw_grid[c].max()); binv = float(cmi[c].max())
    same = abs(rawv - binv) < 0.005
    say(f"   {LABEL[c]}: max on RAW GRID = {rawv:+.2f} at the {CENTN(raw_grid.set_index('CE')[c].idxmax())}"
        f" vs max of the CENTURY MEAN = {binv:+.2f} at the {CENTN(cmi[c].idxmax())}."
        + (" Identical." if same else
           " The raw grid concentrates a one-bin spike in a single year, so the century mean is lower;"
           " the century of the maximum is unchanged."))
say(f"   Amber full-span sign: raw grid endpoints give {float(raw_grid.set_index('CE')['Amber'].loc[last]-raw_grid.set_index('CE')['Amber'].loc[first]):+.2f} (UP)"
    f" while the interpolated bin means give {float(cmi['Amber'].loc[last]-cmi['Amber'].loc[first]):+.2f} (DOWN) and the"
    f" first3/last3 means {float(cmi['Amber'].iloc[-3:].mean()-cmi['Amber'].iloc[:3].mean()):+.2f}."
    " This is the fragility flagged in section 2; no full-span direction is claimed for Amber.")
say("   We report the CENTURY-MEAN (interpolated) statistic as primary because it does not let one")
say("   100-yr bin dominate a century, and the raw grid as the tie/plateau evidence.")

say("\n" + "=" * 96)
say("6. HEADLINE ANSWER AND WHAT IS / IS NOT SUPPORTED")
say(f"   HEADLINE: summed social capital peaks in the century bin {YR(pk)} = {CENTN(pk)}"
    f" (sum {cm.max():.3f} Z; next best {CENTN(float(top.index[1]))} {top.iloc[1]:.3f}).")
say(f"   RAW-GRID TIE: the uninterpolated 100-yr source grid gives an identical maximum"
    f" ({raw_cm.max():.3f}) in {[CENTN(c) for c in tie.index]}, i.e. {[YR(c) for c in tie.index]}.")
