# ================= insp_align.py =================
import pandas as pd, numpy as np
pd.set_option('display.width',250); pd.set_option('display.max_columns',60)
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv')

# which CE rows carry non-missing raw Z values?
raw_cols = [c for c in ts.columns if c in [x for x in ts.columns if not x.endswith('_inter') and x not in
            ('CE','calBP','kde_all_mean','kde_all_std','kde_all_detrend','g_all_mean','g_all_std','pollen','pollen_inter','pollen_detrend','pollen_inter_100','pollen_grate_100','Unnamed: 0')]]
print("raw Z cols:", raw_cols, len(raw_cols))
obs = ts[ts[raw_cols[0]].notna()]
print("n observed rows:", len(obs))
print("CE of observed rows:", obs.CE.tolist())
print("spacing:", np.unique(np.diff(obs.CE.values)))

# map capital columns -> ts raw columns
m = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'CopperGold',
     'Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts',
     'ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
cap2 = cap[list(m)].rename(columns=m)
tsobs = obs.set_index('CE')[raw_cols]
# for each capital row find best-matching CE row (exact match count)
print("\ncapital BCE -> best matching ts CE (exact value matches out of 12):")
for i,(bce,row) in enumerate(zip(cap.BCE, cap2.itertuples(index=False))):
    eq = (tsobs.values == np.asarray(row,dtype=float)).sum(axis=1)
    best = eq.max(); k = int(np.argmax(eq))
    print(f"  BCE={bce:5d}  -> CE={tsobs.index[k]:6d}  matches={best}/12   (implied CE=-BCE: {-bce}, in range={-bce in tsobs.index.values})")

# ================= insp_std.py =================
import pandas as pd, numpy as np
pd.set_option('display.width',250); pd.set_option('display.max_columns',60)
ts = pd.read_csv('data/time_series_data.csv')
comp = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount','Depot','Sickle',
        'AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
raw = ts[comp].dropna()
inter = ts[[c+'_inter' for c in comp]]
print("--- RAW Z values at the 37 century points ---")
print(pd.DataFrame({'raw_mean':raw.mean(),'raw_sd':raw.std(),'raw_min':raw.min(),'raw_max':raw.max(),
                    'inter_mean':inter.mean(),'inter_sd':inter.std()}).round(3).to_string())
print("\n--- correlation raw century points vs _inter at same centuries (should be 1.0 if same series) ---")
obs = ts[ts['Amber'].notna()]
print({c: round(np.corrcoef(obs[c], obs[c+'_inter'])[0,1],4) for c in comp})
print("\n--- do _inter == raw at century points? max abs diff ---")
print({c: float(np.nanmax(np.abs(obs[c]-obs[c+'_inter']))) for c in comp})
print("\n--- pairwise corr matrix of _inter (full 3601 yr) ---")
print(inter.corr().round(2).to_string())
print("\n--- is _inter piecewise-linear between century points? (check Amber on CE -500..-400)")
sub = ts[(ts.CE<=-400)&(ts.CE>=-500)][['CE','Amber','Amber_inter','CopperGold','CopperGold_inter']]
print(sub.iloc[::12].to_string(index=False))

# ================= insp_ovl.py =================
import pandas as pd, numpy as np
ts = pd.read_csv('data/time_series_data.csv')
po = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',', index_col=0)
print("ts  CE range:", ts.CE.min(), ts.CE.max())
print("po  CE range:", po.CE.min(), po.CE.max())
ov = max(ts.CE.min(),po.CE.min()), min(ts.CE.max(),po.CE.max())
print("overlap:", ov, "years:", ov[1]-ov[0]+1)
print("ts.pollen observed rows:", ts.pollen.notna().sum(), "CE range:", ts.loc[ts.pollen.notna(),'CE'].min(), ts.loc[ts.pollen.notna(),'CE'].max())
print("po Belau_PC1 observed:", po.Belau_PC1.notna().sum(), "CE range:", po.loc[po.Belau_PC1.notna(),'CE'].min(), po.loc[po.Belau_PC1.notna(),'CE'].max())
print("po Woserin_PC1 observed:", po.Woserin_PC1.notna().sum(), "CE range:", po.loc[po.Woserin_PC1.notna(),'CE'].min(), po.loc[po.Woserin_PC1.notna(),'CE'].max())
# does ts.pollen equal po.Belau_PC1 ?
j = ts[['CE','pollen','pollen_inter','pollen_inter_100']].merge(po.reset_index()[['CE','Belau_PC1','Belau_PC1_inter','MEAN','SMOOTH_MEAN_100y']], on='CE')
print("merged rows:", len(j))
print("corr ts.pollen vs po.Belau_PC1 (both obs):", j[['pollen','Belau_PC1']].corr().iloc[0,1].round(4), "n=",j[['pollen','Belau_PC1']].dropna().shape[0])
print("max|ts.pollen - po.Belau_PC1|:", (j.pollen-j.Belau_PC1).abs().max())
print("corr ts.pollen_inter vs po.Belau_PC1_inter:", j[['pollen_inter','Belau_PC1_inter']].corr().iloc[0,1].round(4))
print("max|ts.pollen_inter - po.Belau_PC1_inter|:", (j.pollen_inter-j.Belau_PC1_inter).abs().max())
print("corr ts.pollen_inter vs po.MEAN:", j[['pollen_inter','MEAN']].corr().iloc[0,1].round(4))
print("po MEAN missing in ts overlap after -702? pollen file ends", po.CE.max())
# sign: how does openness behave over time (century means of MEAN)
po2 = po.copy(); po2['cent'] = np.ceil(po2.CE/100)*100
print("\ncentury means of pollen MEAN (first/last few):")
cm = po2.groupby('cent').MEAN.mean().round(2)
print(cm.head(4).to_string()); print(cm.tail(6).to_string())
print("argmax century of MEAN:", cm.idxmax(), cm.max().round(2))

