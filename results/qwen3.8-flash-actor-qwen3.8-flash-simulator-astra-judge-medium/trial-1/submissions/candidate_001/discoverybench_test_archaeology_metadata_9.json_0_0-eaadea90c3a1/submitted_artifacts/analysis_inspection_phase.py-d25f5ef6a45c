# ================= insp_feas.py =================
import pandas as pd, numpy as np
ts = pd.read_csv('data/time_series_data.csv')
SOC = ['CopperGold','Amber','MonumentCount']
# century label: ceil(CE/100)*100  (e.g. -4050 -> -4000 = 41st c.BCE .. -4000)
ts['cent'] = np.ceil(ts.CE/100)*100
# edge behaviour of _inter
print("first rows CE, Amber, Amber_inter:"); print(ts[['CE','Amber','Amber_inter','CopperGold_inter']].head(3).to_string(index=False))
print("last rows:"); print(ts[['CE','Amber','Amber_inter','CopperGold_inter']].tail(3).to_string(index=False))
for lbl,cols in [('raw century points',SOC),('_inter century means',[c+'_inter' for c in SOC])]:
    g = ts.groupby('cent')[cols].mean()
    s = g.sum(axis=1)
    top = s.sort_values(ascending=False).head(4)
    print(f"\n[{lbl}] summed social capital: argmax century = {s.idxmax():.0f} (value {s.max():.3f}); top4:")
    print(top.round(3).to_string())
    print("  spread top1-top2 = %.3f ; n centuries=%d" % (s.max()-s.sort_values(ascending=False).iloc[1], len(s)))
# smoothed variant (100-yr centred rolling mean of _inter, then century means)
d = ts.set_index('CE').sort_index()
for w in (1,100,200,300):
    sm = d[[c+'_inter' for c in SOC]].rolling(w, center=True, min_periods=1).mean()
    sm['cent']=np.ceil(sm.index/100)*100
    s = sm.groupby('cent').mean().sum(axis=1)
    print(f"window={w:4d} -> peak century {s.idxmax():.0f}")
