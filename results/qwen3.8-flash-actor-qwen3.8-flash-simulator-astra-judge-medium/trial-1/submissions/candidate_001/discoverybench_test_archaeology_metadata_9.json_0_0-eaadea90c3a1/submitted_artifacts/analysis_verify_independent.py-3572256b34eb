#!/usr/bin/env python3
"""Independent re-derivation from capital.csv ONLY (different code path than the main script).
Century convention: century n BCE = BCE years [n*100 .. n*100-99]; capital.csv row 'BCE 1400'
is the FIRST year of the 14th c. BCE, so row BCE b belongs to century b//100."""
import pandas as pd, numpy as np
c = pd.read_csv("data/capital.csv", decimal=",").drop_duplicates(subset=None)
c = c[c.BCE <= 4100]                                   # drop the 2 padded rows (4300, 4200)
c["century"] = c.BCE // 100
for col, nm in [("ZCU_AU","Copper&Gold"), ("Zamber","Amber"), ("ZMonument","MonumentCount")]:
    c[nm] = c[col].astype(float)
c["SOCIAL"] = c[["Copper&Gold","Amber","MonumentCount"]].sum(axis=1)
s = c.set_index("century")["SOCIAL"].sort_values(ascending=False)
print("SOCIAL sum by century BCE (raw capital.csv), top 5:")
for k, v in s.head(5).items(): print(f"   {k}th c.BCE (BCE {k*100}-{k*100-99})  sum={v:.3f}")
print(f"\npeak century = {s.index[0]}th c.BCE ; tied maxima = {sorted(s[s>=s.iloc[0]-1e-9].index.tolist())}")
print("component own maxima:")
for nm in ["Copper&Gold","Amber","MonumentCount"]:
    v = c.set_index("century")[nm]
    print(f"   {nm:<13} own max {v.idxmax()}th c.BCE = {v.max():+.2f} | value in 14th c.BCE = {v.loc[14]:+.2f}"
          f" | rank of 14th c.BCE = {int((v>v.loc[14]).sum())+1}/37 | 25c.BCE baseline mean = "
          f"{v.loc[[25,24,23,22]].mean():+.2f} | 14-13c.BCE mean = {v.loc[[14,13]].mean():+.2f}")
print("\nfull-span (37th -> 5th c.BCE) change:")
for nm in ["Copper&Gold","Amber","MonumentCount"]:
    v = c.set_index("century")[nm]
    print(f"   {nm:<13} {v.loc[41]:+.2f} -> {v.loc[5]:+.2f}  ({'UP' if v.loc[5]>v.loc[41] else 'DOWN'})")
