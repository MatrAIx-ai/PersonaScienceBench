"""
Prevalence of gardening-introduced non-native plants by habitat type (Barcelona province).
Primary source : data/invaded_niche_pathways.csv (632 plots x 37 cols; one row = one plot)
Context only   : data/invasion_success_pathways.csv, data/temporal_trends_contingency_table.csv
Out of scope   : data/phylogenetic_tree.txt (no phylogenetic term in this question)

Prevalence definitions (kept strictly separate):
  A) PRIMARY   plot-level occupancy = plots in H with >=1 gardening-introduced species / all sampled plots in H
  B) SECONDARY occurrence share = sum(n.gard)/sum(n.total) in H (conditioned on colonisation)
     SECONDARYb same occupancy metric but with the denominator restricted to COLONISED plots only
Seed = 20261023, labelled on every permutation.
"""
import numpy as np, pandas as pd
from scipy import stats

SEED = 20261023
SPARSE_OCC, RICH = 5, 20

def wilson(k, n, alpha=0.05):
    if n == 0:
        return (np.nan, np.nan)
    z = stats.norm.ppf(1 - alpha / 2); p = k / n; d = 1 + z**2 / n
    c = (p + z**2 / (2 * n)) / d
    h = z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / d
    return (max(0.0, c - h), min(1.0, c + h))

def perm_test(labels, groups, nperm=10000, seed=SEED):
    """Monte-Carlo chi-square on the 2 x k table built from plot-level labels (0/1) and group index.
    Permutation unit = PLOT; the 0/1 labels are shuffled across all plots (exact marginal permutation)."""
    labels = np.asarray(labels); groups = np.asarray(groups)
    k = int(groups.max()) + 1
    tab = np.zeros((2, k))
    for j in range(k):
        m = groups == j
        tab[0, j] = (labels[m] == 0).sum(); tab[1, j] = (labels[m] == 1).sum()
    obs = stats.chi2_contingency(tab, correction=False)[0]
    g = np.random.default_rng(seed); null = np.empty(nperm); gidx = groups.copy()
    for b in range(nperm):
        s = g.permutation(labels)
        t = np.zeros((2, k))
        for j in range(k):
            blk = s[gidx == j]
            t[0, j] = (blk == 0).sum(); t[1, j] = (blk == 1).sum()
        null[b] = stats.chi2_contingency(t, correction=False)[0]
    return tab, obs, (1 + (null >= obs).sum()) / (1 + nperm), null.mean(), stats.chi2_contingency(tab, correction=False)[3]

niche = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
succ = pd.read_csv("data/invasion_success_pathways.csv")
temp = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
niche["gard_plot"] = (niche["n.gard"] > 0).astype(int)
niche["occ_plot"] = (niche["n.total"] > 0).astype(int)

rows = []
for h, g in niche.groupby("habitat"):
    plots, occ_plots = len(g), int(g.gard_plot.sum())
    lo, hi = wilson(occ_plots, plots)
    gard, tot = int(g["n.gard"].sum()), int(g["n.total"].sum())
    slo, shi = wilson(gard, tot) if tot else (np.nan, np.nan)
    col = g[g["n.total"] > 0]                      # colonised plots only
    col_occ = int(col["n.gard"].gt(0).sum())       # of those, how many carry a gardening species
    clo, chi = wilson(col_occ, len(col)) if len(col) else (np.nan, np.nan)
    cs = 100.0 * col_occ / len(col) if len(col) else np.nan
    rows.append(dict(habitat=h, plots=plots, occ_plots=occ_plots, occ_pct=100*occ_plots/plots,
                     occ_lo=100*lo, occ_hi=100*hi, n_gard=gard, n_unint=int(g["n.unint"].sum()),
                     n_agfo=int(g["n.agfo"].sum()), n_total=tot,
                     occ_share=100*(gard/tot if tot else np.nan), occ_share_lo=100*slo, occ_share_hi=100*shi,
                     colonised_plots=len(col), cond_occ_pct=cs, cond_lo=100*clo, cond_hi=100*chi,
                     med_elev=g.elevation.median(), sparse="YES" if tot <= SPARSE_OCC else "no"))
tab = pd.DataFrame(rows).sort_values("occ_pct", ascending=False).reset_index(drop=True)
tab.to_csv("out/habitat_prevalence_table.csv", index=False)

print("="*120)
print("A) PRIMARY - plot-level occupancy (>=1 gardening-introduced species), denominator = ALL sampled plots in habitat")
print(tab[["habitat","plots","occ_plots","occ_pct","occ_lo","occ_hi","med_elev","sparse"]].round(1).to_string(index=False))
print("\nB) SECONDARY - occurrence share sum(n.gard)/sum(n.total) [conditioned on colonisation] + occupancy restricted to colonised plots")
print(tab[["habitat","n_gard","n_unint","n_agfo","n_total","occ_share","occ_share_lo","occ_share_hi",
           "colonised_plots","cond_occ_pct","cond_lo","cond_hi","sparse"]].round(1).to_string(index=False))
rho, rho_p = stats.spearmanr(tab["occ_pct"], tab["occ_share"])
print("\nRank agreement A vs B (all 10 habitats): Spearman rho=%.2f (p=%.3f)" % (rho, rho_p))
print("  top-3 by A:", list(tab.habitat.head(3)))
print("  top-3 by B:", list(tab.sort_values('occ_share', ascending=False).habitat.head(3)))

# ---------------- FORMAL TEST: plot-level occupancy, 2 x 10 ----------------
print("\n" + "="*120)
hab_levels = sorted(niche.habitat.unique())
gidx = pd.Categorical(niche.habitat, categories=hab_levels).codes
tab2, obs_chi2, p_perm, nullm, exp2 = perm_test(niche.gard_plot.values, gidx, 10000, SEED)
dof = (tab2.shape[0]-1)*(tab2.shape[1]-1)
p_asym = stats.chi2.sf(obs_chi2, dof)
print("FORMAL TEST (primary): 2x10 plot-level occupancy table (Gardening-occupied vs not), unit = plot")
print("  habitat column order:", hab_levels)
print("  occupied:", dict(zip(hab_levels, tab2[1].astype(int))))
print("  chi2 = %.2f, dof = %d | asymptotic p = %.3g | MONTE-CARLO p (10,000 permutations, seed=%d) = %.4f (mean null chi2 %.2f)"
      % (obs_chi2, dof, p_asym, SEED, p_perm, nullm))
print("  expected counts <5 in %d/%d cells; min expected %.2f" % ((exp2 < 5).sum(), exp2.size, exp2.min()))
sr = (tab2 - exp2) / np.sqrt(exp2)
resid = pd.DataFrame(dict(habitat=hab_levels, plots=tab2.sum(0).astype(int), obs_gard_plots=tab2[1].astype(int),
                          exp_gard_plots=exp2[1].round(1), std_resid=sr[1].round(2),
                          occ_pct=(100*tab2[1]/tab2.sum(0)).round(1))).sort_values("std_resid")
print("\n  Plot-level standardised residuals for gardening-occupied plots (positive = more than expected under habitat homogeneity):")
print(resid.to_string(index=False))
resid.to_csv("out/plot_level_residuals.csv", index=False)

# ---------------- robustness checks ----------------
print("\n" + "="*120)
rich = [h for h in hab_levels if int(niche.loc[niche.habitat == h, "n.total"].sum()) >= RICH]
sub = niche[niche.habitat.isin(rich)]
gi_r = pd.Categorical(sub.habitat, categories=rich).codes
t2r, chir, ppr, nm_r, expr = perm_test(sub.gard_plot.values, gi_r, 10000, SEED)
pr_asym = stats.chi2.sf(chir, (t2r.shape[0]-1)*(t2r.shape[1]-1))
print("ROBUSTNESS 1 - restrict to habitats with >=%d occurrence records: %s" % (RICH, rich))
print("  chi2 = %.2f | asymptotic p = %.3g | MONTE-CARLO p (10,000, seed=%d) = %.4f | min expected %.2f"
      % (chir, pr_asym, SEED, ppr, expr.min()))
print("  occupancy pct in restricted set:", {h: round(float(100*sub[sub.habitat==h].gard_plot.mean()),1) for h in rich})
print("  direction same as full analysis? top habitat in both =",
      max(rich, key=lambda h: sub[sub.habitat==h].gard_plot.mean()) == max(hab_levels, key=lambda h: niche[niche.habitat==h].gard_plot.mean()))

sparse_hs = list(tab.loc[tab["sparse"] == "YES", "habitat"])
inf = niche[~niche.habitat.isin(sparse_hs)]
gi_i = pd.Categorical(inf.habitat, categories=sorted(inf.habitat.unique())).codes
t2i, chii, ppi, nm_i, expi = perm_test(inf.gard_plot.values, gi_i, 10000, SEED)
print("\nROBUSTNESS 2 - drop uninformative habitats for rate statements (%s): chi2=%.2f | MONTE-CARLO p (seed=%d) = %.4f"
      % (", ".join(sparse_hs), chii, SEED, ppi))

# ---------------- DESCRIPTIVE ONLY: 10x3 occurrence residuals ----------------
print("\n" + "="*120)
ct3 = niche.groupby("habitat")[["n.gard", "n.unint", "n.agfo"]].sum()
c3, p3, dof3, e3 = stats.chi2_contingency(ct3.values, correction=False)
r3 = (ct3.values - e3) / np.sqrt(e3)
print("DESCRIPTIVE ONLY (NON-INFERENTIAL - species recur across plots/habitats): 10x3 occurrence standardised residuals")
print("  nominal chi2 = %.2f, dof = %d, asymptotic p = %.3g ; expected<5 in %d/%d cells, min %.2f"
      % (c3, dof3, p3, int((e3 < 5).sum()), e3.size, e3.min()))
print(pd.DataFrame(r3.round(2), index=ct3.index, columns=ct3.columns).to_string())
pd.DataFrame(r3.round(2), index=ct3.index, columns=ct3.columns).to_csv("out/occurrence_residuals_descriptive.csv")

# ---------------- cheap sensitivity: effort rarefaction + elevation ----------------
print("\n" + "="*120)
kmin = int(niche.groupby("habitat").size().min())
print("SENSITIVITY 1 - equalise effort: rarefy every habitat to %d plots (the smallest habitat sample), 5,000 draws, seed=%d" % (kmin, SEED))
g = np.random.default_rng(SEED + 1)
idx = {h: np.flatnonzero((niche.habitat == h).values) for h in hab_levels}
draws = {h: [] for h in hab_levels}
for b in range(5000):
    for h, ii in idx.items():
        draws[h].append(niche.gard_plot.values[g.choice(ii, kmin, replace=False)].mean())
rar = pd.DataFrame({"rarefied_occ_pct": {h: 100*np.mean(v) for h, v in draws.items()},
                    "sd": {h: 100*np.std(v) for h, v in draws.items()}})
rar = rar.join(tab.set_index("habitat")[["occ_pct", "med_elev"]]).sort_values("rarefied_occ_pct", ascending=False).round(2)
print(rar.to_string())
print("  rank correlation raw vs rarefied occupancy: Spearman rho = %.3f" % stats.spearmanr(rar.occ_pct, rar.rarefied_occ_pct)[0])

print("\nSENSITIVITY 2 - is 'habitat' just elevation? plot-level gardening occupancy by elevation quartile (all 632 plots)")
niche["elev_q"] = pd.qcut(niche.elevation, 4, labels=["Q1 lowest", "Q2", "Q3", "Q4 highest"])
eq = niche.groupby("elev_q", observed=True).agg(plots=("gard_plot", "size"),
                                                occ_pct=("gard_plot", lambda s: 100*s.mean()),
                                                med_elev=("elevation", "median"))
print(eq.round(1).to_string())
rho_e, p_e = stats.spearmanr(niche.elevation, niche.gard_plot)
print("  Spearman(elevation, gardening-occupied plot) rho = %.3f (p = %.3g)" % (rho_e, p_e))
try:
    import statsmodels.formula.api as smf
    from scipy.stats import chi2 as chi2dist
    ok = [h for h in hab_levels if 0 < niche.loc[niche.habitat == h, "gard_plot"].sum() < int((niche.habitat == h).sum())]
    dl = niche[niche.habitat.isin(ok)].copy()
    dl["elev_km"] = dl.elevation / 1000.0
    m0 = smf.logit("gard_plot ~ 1", data=dl).fit(disp=0)
    mh = smf.logit("gard_plot ~ C(habitat)", data=dl).fit(disp=0)
    mel = smf.logit("gard_plot ~ elev_km", data=dl).fit(disp=0)
    rhe = smf.logit("gard_plot ~ C(habitat) + elev_km", data=dl).fit(disp=0)
    dv = lambda m: -2.0 * m.llf
    print("  Logistic (unit = plot; %d plots, %d habitats - Rock outcrops and Scrublands dropped: perfect separation):" % (len(dl), len(ok)))
    print("   habitat vs intercept-only : LRT p = %.3g | McFadden pseudo-R2 = %.3f"
          % (chi2dist.sf(dv(m0) - dv(mh), 9), mh.prsquared))
    print("   elevation(km) alone       : LRT p = %.3g | pseudo-R2 = %.3f | slope = %.2f logit/km (p = %.3g)"
          % (chi2dist.sf(dv(m0) - dv(mel), 1), mel.prsquared, mel.params["elev_km"], mel.pvalues["elev_km"]))
    print("   ADD elevation to habitat  : LRT p = %.3g | elevation slope = %.2f logit/km (p = %.3g)"
          % (chi2dist.sf(dv(mh) - dv(rhe), 1), rhe.params["elev_km"], rhe.pvalues["elev_km"]))
    names = [k for k in rhe.params.index if k.startswith("C(habitat)")]
    adj = pd.DataFrame({"habitat": [n.split("T.")[1].strip("]") for n in names],
                        "logit_vs_ref": rhe.params[names].values.round(2),
                        "p": rhe.pvalues[names].values.round(3)}).sort_values("logit_vs_ref", ascending=False)
    print("   habitat log-odds vs reference (%s) AFTER adjusting for elevation:" % hab_levels[0])
    print(adj.to_string(index=False))
    print("   => elevation alone explains much of the pattern; habitat keeps an independent effect (last LRT p small).")
except Exception as e2:
    print("  (statsmodels check skipped:", type(e2).__name__, e2, ")")

# ---------------- context (region-wide, not from the 632 plots) ----------------
print("\n" + "="*120)
print("CONTEXT (region-wide counts, NOT estimated from the 632 plots)")
print("Species table invasion_success_pathways.csv (%d rows / %d unique names; the 4 duplicated=TRUE rows are dual-pathway species kept as-is):"
      % (len(succ), succ.Scientific_name.nunique()))
print(succ.groupby("intro.pathway").agg(species_rows=("Scientific_name", "size"),
                                        unique_species=("Scientific_name", "nunique"),
                                        mean_habitat_range=("habitat.range", "mean"),
                                        median_habitat_range=("habitat.range", "median"),
                                        max_habitat_range=("habitat.range", "max")).round(2).to_string())
piv = temp.pivot(index="introduction.period", columns="pathway", values="n").reindex(
      ["Before 1500", "1501-1900", "1901-1984", "1985-2019"])
piv["gardening_share_%"] = (100*piv["Gardening"]/piv.sum(axis=1)).round(1)
print("\nTemporal rise of the gardening pathway (Catalonia; species per introduction period):")
print(piv.to_string())
print("\nWithin the 632 sampled plots: %d plots hold >=1 naturalised non-native (%.1f%%), %d hold >=1 gardening-introduced (%.1f%%); %d gardening / %d unintentional / %d agriforest = %d occurrence records total." % (niche.occ_plot.sum(), 100*niche.occ_plot.mean(), niche.gard_plot.sum(), 100*niche.gard_plot.mean(), niche["n.gard"].sum(), niche["n.unint"].sum(), niche["n.agfo"].sum(), niche["n.total"].sum()))
