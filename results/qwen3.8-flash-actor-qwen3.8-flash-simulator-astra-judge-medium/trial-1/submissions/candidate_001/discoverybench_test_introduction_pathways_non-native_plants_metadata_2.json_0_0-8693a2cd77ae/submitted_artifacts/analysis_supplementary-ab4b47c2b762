"""Supplementary contrasts + covariate context for the hypothesis (same seed, same data)."""
import numpy as np, pandas as pd
from scipy import stats
SEED = 20261023
d = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
d["gard_plot"] = (d["n.gard"] > 0).astype(int)

def wilson(k, n, a=.05):
    z = stats.norm.ppf(1-a/2); p = k/n; de = 1+z**2/n
    c = (p+z**2/(2*n))/de; h = z*np.sqrt(p*(1-p)/n+z**2/(4*n**2))/de
    return max(0, c-h), min(1, c+h)

HIGH = ["Wetlands", "Urban", "Coastal", "Riparian"]          # built-up / disturbed lowland habitats
LOW  = ["Coniferous forests", "Broad-leaved forests", "Meadows"]  # semi-natural upland habitats (informative only)
hi, lo = d[d.habitat.isin(HIGH)], d[d.habitat.isin(LOW)]
k1, n1, k0, n0 = hi.gard_plot.sum(), len(hi), lo.gard_plot.sum(), len(lo)
p1, p0 = k1/n1, k0/n0
se = np.sqrt(p1*(1-p1)/n1 + p0*(1-p0)/n0)
odds = (k1/(n1-k1))/((k0+0.0)/(n0-k0))
lse = np.sqrt(1/k1 + 1/(n1-k1) + 1/k0 + 1/(n0-k0))
t, pval = stats.fisher_exact([[k1, n1-k1], [k0, n0-k0]])
print("HEADLINE CONTRAST (unit = plot)")
print("  high-prevalence set %s" % HIGH)
print("    %d/%d plots occupied = %.1f%% (95%% CI %.1f-%.1f)" % (k1, n1, 100*p1, *[100*x for x in wilson(k1, n1)]))
print("  semi-natural set %s" % LOW)
print("    %d/%d plots occupied = %.1f%% (95%% CI %.1f-%.1f)" % (k0, n0, 100*p0, *[100*x for x in wilson(k0, n0)]))
print("  risk difference = %.1f pp (95%% CI %.1f to %.1f) | risk ratio = %.1fx | odds ratio = %.1f (95%% CI %.1f-%.1f)"
      % (100*(p1-p0), 100*((p1-p0)-1.96*se), 100*((p1-p0)+1.96*se), p1/p0, odds,
         np.exp(np.log(odds)-1.96*lse), np.exp(np.log(odds)+1.96*lse)))
print("  Fisher exact p = %.3g" % pval)
for h in ["Urban", "Wetlands"]:
    o = d[d.habitat == h]; r = d[d.habitat.isin(LOW)]
    print("    single-habitat check %s vs the three semi-natural habitats: %d/%d vs %d/%d, Fisher p = %.3g"
          % (h, o.gard_plot.sum(), len(o), r.gard_plot.sum(), len(r), stats.fisher_exact([[o.gard_plot.sum(), len(o)-o.gard_plot.sum()], [r.gard_plot.sum(), len(r)-r.gard_plot.sum()]])[1]))

print("\nWHAT ELSE DIFFERS? mean plot covariates, gardening-occupied vs not (all 632 plots)")
cols = ["elevation", "urban.2009.50m", "urban.2009.1000m", "cropland.2009.50m", "distance.road", "distance.stream",
        "annual.temperature", "annual.rainfall"]
print(d.groupby("gard_plot")[cols].mean().round(2).rename(index={0: "no gardening sp.", 1: ">=1 gardening sp."}).to_string())
for c in ["urban.2009.1000m", "distance.road", "elevation"]:
    r, p = stats.spearmanr(d[c], d.gard_plot)
    print("  Spearman(%-17s, gardening-occupied) rho = %+.3f (p = %.2g)" % (c, r, p))
print("\n  urban.2009.50m==0 in %d/%d plots (i.e. most plots have no urban cover within 50 m)" % ((d["urban.2009.50m"] == 0).sum(), len(d)))
print("  habitat vs urban cover association (mean urban.2009.1000m by habitat):")
print(d.groupby("habitat")["urban.2009.1000m"].mean().round(3).sort_values(ascending=False).to_string())
