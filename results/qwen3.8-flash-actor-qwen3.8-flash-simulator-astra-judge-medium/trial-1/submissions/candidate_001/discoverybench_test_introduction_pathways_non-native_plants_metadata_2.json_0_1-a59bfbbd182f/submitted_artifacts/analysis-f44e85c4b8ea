                             ('elevation', [-1, 200, 500, 3000], 'elevation (m)'),
                             ('n.total', [0, 1, 2, 20], 'plot invader richness')]:
    sub3['strata'] = pd.cut(sub3[strat_col], cuts, labels=False, include_lowest=True)
    tabs = []
    for _, g in sub3.groupby('strata', observed=True):
        a = int(g.loc[g.is_az == 1, 'n.gard'].sum()); b = int(g.loc[g.is_az == 1, ['n.unint', 'n.agfo']].sum().sum())
        c = int(g.loc[g.is_az == 0, 'n.gard'].sum()); d = int(g.loc[g.is_az == 0, ['n.unint', 'n.agfo']].sum().sum())
        if (a + b + c + d) > 0: tabs.append(np.array([[a, b], [c, d]]))
    st = sct.StratifiedTable([t for t in tabs if t.sum() > 0])
    P(f'  stratifying by {lab} ({len(tabs)} strata): MH OR(azonal vs urbanised, gardening vs other) = '
      f'{st.oddsratio_pooled:.2f} [{st.oddsratio_pooled_confint()[0]:.2f},'
      f'{st.oddsratio_pooled_confint()[1]:.2f}] p={st.test_null_odds().pvalue:.3g}; '
      f'homogeneity p={st.test_equal_odds().pvalue:.3g}')
P('  -> CMH keeps the azonal-vs-urbanised dominance contrast inside strata of similar urban cover / '
  'elevation / plot richness, so the style difference is not only a between-stratum artefact.')

rule('B2i. WATER / DISTURBANCE CONTEXT (the azonal axis) within the lowland plots')
