"""Main analysis: in what context does the gardening pathway show different prevalence
styles across habitat types? (plot-level pathway richness, Barcelona province)

Prevalence style = joint signature of FREQUENCY (occupancy, plot-weighted) x
DOMINANCE (gardening share of pathway-coded occurrences, occurrence-weighted),
plus INTENSITY (mean n.gard per occupied plot) and reliability (invaded-plot counts).
Habitat x pathway inference uses exact/permutation tests (no plain chi-square) and
Firth penalised logistic models (exploratory). Temporal table = background only.
Phylogenetic tree not used.
"""
import sys, numpy as np, pandas as pd
from scipy import stats
from statsmodels.stats.proportion import proportion_confint
sys.path.insert(0, '/workspace/analysis')
from firth import firth_logit

pd.set_option('display.width', 220)
D = '/workspace/data/'
df = pd.read_csv(D + 'invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv(D + 'invasion_success_pathways.csv')
tt = pd.read_csv(D + 'temporal_trends_contingency_table.csv', sep='\t')
G = ['n.gard', 'n.unint', 'n.agfo']
rng = np.random.default_rng(20261022)
OUT = []

def P(*a):
    s = ' '.join(str(x) for x in a); print(s); OUT.append(s)

def rule(t): P('\n' + '=' * 78 + '\n' + t + '\n' + '=' * 78)

rule('0. DESIGN & DATA')
GRP = {'Urban': 'Urbanised-cultivated', 'Croplands': 'Urbanised-cultivated',
       'Riparian': 'Azonal-semi-aquatic', 'Wetlands': 'Azonal-semi-aquatic',
       'Coastal': 'Azonal-semi-aquatic',
       'Broad-leaved forests': 'Terrestrial-natural', 'Coniferous forests': 'Terrestrial-natural',
       'Scrublands': 'Terrestrial-natural', 'Rock outcrops': 'Terrestrial-natural',
       'Meadows': 'Terrestrial-natural'}
df['hgroup'] = df['habitat'].map(GRP)
df['gard_any'] = (df['n.gard'] > 0).astype(int)
df['invaded'] = (df['n.total'] > 0).astype(int)
for c in ['urban.2009.50m', 'urban.2009.1000m', 'cropland.2009.1000m', 'elevation',
          'distance.road', 'progressive.1956.2009.50m']:
    df['z_' + c] = (df[c] - df[c].mean()) / df[c].std()
df['log_road'] = np.log1p(df['distance.road'])
df['z_log_road'] = (df.log_road - df.log_road.mean()) / df.log_road.std()
P(f'plots = {len(df)}; invaded plots (n.total>0) = {int(df.invaded.sum())}; '
  f'unique coords = {len(df[["longitude","latitude"]].drop_duplicates())}')
P('overall pathway-coded occurrences:', df[G].sum().to_dict(), 'total =', int(df['n.total'].sum()))
P(f'background (temporal table, NO habitat axis): gardening = '
  f'{int(tt.loc[tt.pathway=="Gardening","n"].sum())} / {int(tt.n.sum())} = '
  f'{tt.loc[tt.pathway=="Gardening","n"].sum()/tt.n.sum():.2f} of introduction records; '
  f'by period {tt.loc[tt.pathway=="Gardening","n"].tolist()}')

rule('A. PREVALENCE-STYLE TABLE (frequency x dominance x intensity, with reliability)')
OVERALL = df['n.gard'].sum() / df['n.total'].sum()
TOT_G, TOT_O = int(df['n.gard'].sum()), int(df['n.total'].sum())
MIN_OCC, FREQ, RARE, MIN_INV = 15, 0.20, 0.10, 15
rows = []
for h, g in df.groupby('habitat'):
    occ = g[G].sum(); tot = int(occ.sum()); nop = len(g); nip = int(g.invaded.sum())
    lo, hi = proportion_confint(int((g['n.gard'] > 0).sum()), nop, 0.05, 'wilson')
    # leave-one-out reference share, so a habitat is not compared with itself
    p0 = (TOT_G - int(occ['n.gard'])) / (TOT_O - tot) if tot < TOT_O else OVERALL
    bt = stats.binomtest(int(occ['n.gard']), tot, p0) if tot else None
    ng, nu = int(occ['n.gard']), int(occ['n.unint'])
    # within-habitat style test: is gardening outnumbered by unintentional in this habitat?
    bu = stats.binomtest(ng, ng + nu, 0.5, alternative='less') if (ng + nu) else None
    rows.append(dict(habitat=h, hgroup=GRP[h], n_plots=nop, n_invaded_plots=nip,
                     n_gard_occ=int(occ['n.gard']), n_unint_occ=int(occ['n.unint']),
                     n_agfo_occ=int(occ['n.agfo']), n_occ=tot,
                     occupancy=round((g['n.gard'] > 0).mean(), 3), occ_lo=round(lo, 3), occ_hi=round(hi, 3),
                     gard_share=round(occ['n.gard'] / tot, 3) if tot else np.nan,
                     unint_share=round(occ['n.unint'] / tot, 3) if tot else np.nan,
                     intensity_per_occupied_plot=round(g.loc[g['n.gard'] > 0, 'n.gard'].mean(), 2)
                     if (g['n.gard'] > 0).any() else np.nan,
                     p_vs_overall_share=None if bt is None else bt.pvalue, p0_ref=round(p0, 3),
                     gard_to_unint_ratio=None if (ng + nu) == 0 else round(ng / nu, 2) if nu else np.inf,
                     p_gard_lt_unint=None if bu is None else bu.pvalue,
                     mean_urban50m_2009=round(g['urban.2009.50m'].mean(), 3),
                     mean_elev_m=round(g['elevation'].mean(), 1),
                     mean_log1p_dist_road=round(np.log1p(g['distance.road']).mean(), 2),
                     mean_urban_progressive=round(g['progressive.1956.2009.50m'].mean(), 3)))
tab = pd.DataFrame(rows)
pv = [x for x in tab['p_vs_overall_share'] if x is not None]
from statsmodels.stats.multitest import multipletests
adj = multipletests(pv, method='holm')[1]
i = 0; col = []
for x in tab['p_vs_overall_share']:
    col.append(None if x is None else round(adj[i], 3)); i += x is not None
tab['p_holm_vs_share_LOO'] = col

def freq_lab(o):
    return 'frequent' if o >= FREQ else ('occasional' if o > RARE else 'rare')
def dom_lab(r):
    if not r['n_occ']: return 'no-records'
    sig_below = (r['p_holm_vs_share_LOO'] is not None and r['p_holm_vs_share_LOO'] < 0.05
                 and r['gard_share'] < r['p0_ref'])
    outnumbered = (r['p_gard_lt_unint'] is not None and r['p_gard_lt_unint'] < 0.05
                   and r['n_gard_occ'] < r['n_unint_occ'])
    if r['gard_share'] >= 0.5: return 'co-dominant/dominant'
    if sig_below or outnumbered: return 'subordinate-to-unintentional'
    return 'at-regional-average'
def style(r):
    if r['n_occ'] < MIN_OCC or r['n_invaded_plots'] < MIN_INV:
        return 'absent-or-undetermined (too few invaded plots)'
    f, d = freq_lab(r['occupancy']), dom_lab(r)
    if f == 'frequent' and d == 'co-dominant/dominant': return 'frequent-and-co-dominant'
    if f == 'frequent' and d == 'subordinate-to-unintentional': return 'frequent-but-subordinate'
    if f == 'frequent': return 'frequent-and-proportional'
    if f == 'rare' and d in ('co-dominant/dominant', 'at-regional-average'):
        return 'rare-but-exclusive (low-n caution)'
    if f == 'rare': return 'rare-and-subordinate'
    return 'occasional/' + d
tab['frequency_style'] = tab['occupancy'].apply(freq_lab)
tab['dominance_style'] = tab.apply(dom_lab, axis=1)
tab['style'] = tab.apply(style, axis=1)
tab['reliable'] = np.where((tab['n_occ'] >= MIN_OCC) & (tab['n_invaded_plots'] >= MIN_INV), 'yes', 'NO')
SHOW = ['habitat', 'hgroup', 'n_plots', 'n_invaded_plots', 'n_gard_occ', 'n_unint_occ', 'n_agfo_occ', 'n_occ',
        'occupancy', 'occ_lo', 'occ_hi', 'gard_share', 'unint_share', 'intensity_per_occupied_plot',
        'p_holm_vs_share_LOO', 'gard_to_unint_ratio', 'p_gard_lt_unint', 'style', 'reliable']
P(f'overall gardening share of pathway-coded occurrences = {OVERALL:.3f} '
  f'({TOT_G}/{TOT_O}); per-habitat tests use the LEAVE-ONE-OUT share as reference p0')
P(f'rules: frequent if occupancy >= {FREQ}; rare if occupancy <= {RARE}; co-dominant if '
  f'habitat share >= leave-one-out overall share (Holm-adjusted binomial test); reliable requires '
  f'n_occ >= {MIN_OCC} AND n_invaded_plots >= {MIN_INV}')
P(tab.sort_values('occupancy', ascending=False)[SHOW].to_string(index=False))
tab.to_csv('/workspace/analysis/habitat_prevalence_styles.csv', index=False)
P('\ncontext covariates per habitat (for the "context" part of the question):')
P(tab.sort_values('mean_urban50m_2009', ascending=False)[
    ['habitat', 'mean_urban50m_2009', 'mean_elev_m', 'mean_log1p_dist_road', 'mean_urban_progressive',
     'occupancy', 'gard_share', 'style']].to_string(index=False))

rule('A2. SAME HABITAT TABLE UNDER TWO WEIGHTINGS (so weighting cannot flip the story)')
w = df.groupby('habitat').agg(plots=('gard_any', 'size'), gard_plots=('gard_any', 'sum'),
                              invaded_plots=('invaded', 'sum'))
w['plotW_prevalence'] = (w.gard_plots / w.plots).round(3)
w['plotW_cond_invaded'] = (w.gard_plots / w.invaded_plots).round(3)
