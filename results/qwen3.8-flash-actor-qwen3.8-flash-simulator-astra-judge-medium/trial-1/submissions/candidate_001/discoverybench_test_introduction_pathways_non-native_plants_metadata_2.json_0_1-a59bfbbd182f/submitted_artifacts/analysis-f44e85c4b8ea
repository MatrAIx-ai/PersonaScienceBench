    tt = low.groupby(q, observed=True).agg(plots=('gard_any', 'size'), occ=('gard_any', 'mean'))
    r = stats.spearmanr(low[cv], low.gard_any)
    P(f'  lowland {cv}: occupancy by tertile {[round(x, 3) for x in tt.occ]} '
      f'(n={list(tt.plots)}), Spearman rho={r.statistic:+.3f} p={r.pvalue:.3g}')
for cv in ['distance.stream', 'distance.road']:
