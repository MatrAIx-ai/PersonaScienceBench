P(cmp.sort_values('rank_plotW').to_string())
sr = stats.spearmanr(cmp.plotW_prevalence, cmp.occW_gard_share)
P(f'Spearman rank agreement between the two weightings across 10 habitats: rho={sr.statistic:.3f} p={sr.pvalue:.3f}')
sr2 = stats.spearmanr(cmp.plotW_cond_invaded, cmp.occW_gard_share)
P(f'Spearman, conditioning on invaded plots only: rho={sr2.statistic:.3f} p={sr2.pvalue:.3f}')
P('rank_gap >> 0 : frequent relative to its dominance (subordinate style). '
  'rank_gap << 0 : dominant among very few records (exclusive/rare style).')

rule('B1a. HABITAT(10) x PATHWAY(3): permutation Fisher-Freeman-Halton (chi2 reported, never as a test)')
def ffh(table, B=20000, seed=1):
    obs = stats.chi2_contingency(table)[0]
    rr = np.random.default_rng(seed)
    row_ids = np.repeat(np.arange(table.shape[0]), table.sum(1))
    path_ids = np.repeat(np.arange(table.shape[1]), table.sum(0))
    ge = 0
    for _ in range(B):
        t = np.zeros_like(table)
        np.add.at(t, (row_ids, rr.permutation(path_ids)), 1)
        if stats.chi2_contingency(t)[0] >= obs - 1e-9: ge += 1
    return obs, (ge + 1) / (B + 1)
T10 = tab.set_index('habitat')[['n_gard_occ', 'n_unint_occ', 'n_agfo_occ']].values
chi2o, pffh = ffh(T10, 5000, seed=7)
c = stats.chi2_contingency(T10)
V = np.sqrt(c[0] / (T10.sum() * (min(T10.shape) - 1)))
P(f'10x3 table (rows=habitats):\n{T10}')
P(f'permutation Fisher-Freeman-Halton (B=5000, rows fixed): chi2_obs={chi2o:.2f} p={pffh:.4f}; '
  f'Cramer V={V:.3f}; df={(T10.shape[0]-1)*(T10.shape[1]-1)}')
P(f'expected counts <5 in {int((c[3] < 5).sum())}/{c[3].size} cells (min {c[3].min():.2f}) '
  '-> asymptotic chi2 would be invalid; the permutation p-value is what we report.')

rule('B1b. COLLAPSED OCCURRENCE-WEIGHTED CONTRASTS: Fisher exact, OR with 95% CI, Cramer V')
def or_ci(t):
    a, b, cc, d = t.ravel()
    orr, p = stats.fisher_exact(t)
    orr = max(orr, 1e-6)
    se = np.sqrt(1 / max(a, .5) + 1 / max(b, .5) + 1 / max(cc, .5) + 1 / max(d, .5))
    return orr, np.exp(np.log(orr) - 1.96 * se), np.exp(np.log(orr) + 1.96 * se), p
def two_by_two(t, name):
    P(f'{name}\n{t}')
    o_, lo, hi, p = or_ci(t)
    cv = np.sqrt(stats.chi2_contingency(t)[0] / (t.sum() * (min(t.shape) - 1)))
    P(f'   OR(gardening : other pathways) = {o_:.2f}  95% CI [{lo:.2f}, {hi:.2f}]  Fisher p={p:.3g}  CramerV={cv:.3f}')
def occ_tbl(mask):
    s = df.loc[mask, G].sum()
    return np.array([[int(s['n.gard']), int(s['n.unint'] + s['n.agfo'])]])
gs = df.groupby('hgroup')[G].sum()
gs['n_total'] = df.groupby('hgroup')['n.total'].sum()
P('occurrences by pre-specified habitat group:\n' + gs.to_string())
UC, AZ, TE = (df.hgroup == 'Urbanised-cultivated'), (df.hgroup == 'Azonal-semi-aquatic'), (df.hgroup == 'Terrestrial-natural')
two_by_two(np.vstack([occ_tbl(UC), occ_tbl(~UC)]),
           '(i) Urbanised-cultivated (Urban+Croplands) vs ALL other habitats | gardening vs other')
two_by_two(np.vstack([occ_tbl(AZ), occ_tbl(TE)]),
           '(ii) Azonal-semi-aquatic (Riparian+Wetlands+Coastal) vs Terrestrial-natural | gardening vs other')
two_by_two(np.vstack([occ_tbl(AZ), occ_tbl(UC)]),
           '(iii) Azonal-semi-aquatic vs Urbanised-cultivated | gardening vs other   <-- the style switch')
two_by_two(np.vstack([occ_tbl(AZ), occ_tbl(~AZ & ~UC)]),
           '(iv) Azonal-semi-aquatic vs terrestrial-natural EXCLUDING urbanised group')
T3 = np.array([[int(gs.loc[g, 'n.gard']), int(gs.loc[g, 'n.unint'] + gs.loc[g, 'n.agfo'])]
               for g in ['Urbanised-cultivated', 'Azonal-semi-aquatic', 'Terrestrial-natural']])
o3, p3 = ffh(T3, 20000, seed=11)
c3 = stats.chi2_contingency(T3)
P(f'(v) 3-group x pathway table\n{T3}\n   permutation FFH chi2={o3:.2f} p={p3:.4f} '
  f'CramerV={np.sqrt(c3[0]/T3.sum()):.3f}')

rule('B1c. PLOT-WEIGHTED (occupancy) COLLAPSED CONTRASTS: Fisher exact, OR, CI')
def plot_tbl(mask):
    g = df[mask]; k = int(g.gard_any.sum())
    return np.array([[k, int(len(g) - k)]])
for nm, m1, m2 in [('Urbanised-cultivated vs all other habitats', UC, ~UC),
                   ('Azonal-semi-aquatic vs Terrestrial-natural', AZ, TE),
                   ('Azonal-semi-aquatic vs Urbanised-cultivated', AZ, UC),
                   ('Urban habitat vs Wetlands+Coastal', df.habitat == 'Urban', df.habitat.isin(['Wetlands', 'Coastal'])),
                   ('Urban habitat vs Scrublands', df.habitat == 'Urban', df.habitat == 'Scrublands')]:
    two_by_two(np.vstack([plot_tbl(m1), plot_tbl(m2)]), nm + ' | plot has >=1 gardening species (occupancy)')

rule('B2. FIRTH PENALISED LOGISTIC - P(plot has >=1 gardening species)  [EXPLORATORY]')
H_LV = sorted(df['habitat'].unique()); HG_LV = sorted(df['hgroup'].unique())
def dmat(spec, ref_h='Urban', ref_hg='Urbanised-cultivated'):
    X = [np.ones(len(df))]; nm = ['(intercept)']
    for term in [t.strip() for t in spec.split('+')]:
        if term == '1': continue
        if term == 'habitat':
            for lv in [l for l in H_LV if l != ref_h]:
                X.append((df['habitat'] == lv).astype(float).values); nm.append(f'{lv} (vs Urban)')
        elif term == 'hgroup':
            for lv in [l for l in HG_LV if l != ref_hg]:
                X.append((df['hgroup'] == lv).astype(float).values); nm.append(f'{lv}')
        else:
            X.append(df[term].astype(float).values); nm.append(term)
    return np.column_stack(X), nm
CTX = ['z_urban.2009.50m', 'z_elevation', 'z_log_road']
CTX2 = ['z_urban.2009.1000m', 'z_elevation', 'z_log_road', 'z_progressive.1956.2009.50m']
P(f'n = {len(df)} plots; marginal P(gardening present) = {df.gard_any.mean():.3f} '
  f'({int(df.gard_any.sum())} plots). Firth penalisation used because habitat-level counts are sparse '
  '(quasi-separation: unpenalised MLE gives a singular Hessian).')
def fit(name, spec, data=None):
    d = df if data is None else data
    X = [np.ones(len(d))]; nm = ['(intercept)']
    for term in [t.strip() for t in spec.split('+')]:
        if term == '1': continue
        if term == 'habitat':
            for lv in [l for l in H_LV if l != 'Urban']:
                X.append((d['habitat'] == lv).astype(float).values); nm.append(f'{lv} (vs Urban)')
        elif term == 'hgroup':
            for lv in [l for l in HG_LV if l != 'Urbanised-cultivated']:
                X.append((d['hgroup'] == lv).astype(float).values); nm.append(f'{lv}')
        else:
            X.append(d[term].astype(float).values); nm.append(term)
    X = np.column_stack(X); y = d['gard_any'].values.astype(float)
    r = firth_logit(X, y)
    null = firth_logit(np.ones((len(d), 1)), y)['ll']
    P(f'\n--- {name}:  ~ {spec}    [k={X.shape[1]}, iters={r["iters"]}, converged={r["converged"]}, '
      f'penalised loglik={r["ll"]:.2f}, McFadden pseudo-R2={1 - r["ll"] / null:.3f}]')
    for a, b, se, z in zip(nm, r['beta'], r['se'], r['z']):
        pv = 2 * stats.norm.sf(abs(z))
        if a == '(intercept)':
            P(f'  {a:<34} OR={np.exp(b):.2f}  p={pv:.3g}')
        else:
            P(f'  {a:<34} OR={np.exp(b):5.2f} [{np.exp(b - 1.96 * se):.2f},{np.exp(b + 1.96 * se):.2f}]  p={pv:.3g}')
    r['names'] = nm
    return r
F = {}
F['g3'] = fit('M1 habitat group (3, ref=Urbanised-cultivated)', 'hgroup + 1')
F['ctx'] = fit('M2 context only (urban cover, elevation, distance to road)', ' + '.join(CTX) + ' + 1')
F['ctx2'] = fit('M3 context only, wider scale (+1000 m urban cover, land-cover change)', ' + '.join(CTX2) + ' + 1')
F['g3ctx'] = fit('M4 habitat group + context', 'hgroup + ' + ' + '.join(CTX) + ' + 1')
F['h10'] = fit('M5 habitat (10 levels, ref=Urban)', 'habitat + 1')
F['h10ctx'] = fit('M6 habitat (10) + context', 'habitat + ' + ' + '.join(CTX) + ' + 1')

rule('B2b. NESTED COMPARISONS - do habitat contrasts survive conditioning on context?')
def lr(a, b, na, nb, dfree):
    d = 2 * (b['ll'] - a['ll']); p = stats.chi2.sf(max(d, 0), dfree)
    keep = [n for n in b['names'] if n not in a['names']]
    P(f'  {na}  ->  {nb}:  dpenLL={b["ll"] - a["ll"]:.2f},  LR chi2={d:.2f}, df={dfree}, p={p:.4g}')
    P(f'     terms added: {keep}')
lr(F['ctx'], F['g3ctx'], 'context', 'context + habitat group', 2)
lr(F['g3'], F['g3ctx'], 'habitat group', 'habitat group + context', 3)
lr(F['ctx'], F['h10ctx'], 'context', 'context + habitat(10)', 9)
lr(F['h10'], F['h10ctx'], 'habitat(10)', 'habitat(10) + context', 3)
lr(F['ctx'], F['ctx2'], 'context(50 m urban + elev + road)', 'context(+1000 m urban + land-cover change)', 2)
P('  NOTE: likelihood-ratio tests on a *penalised* log-likelihood are approximate; treat as exploratory.')

rule('B2c. SECONDARY: conditional on a plot being invaded (n.total>0) - dominance side of the style')
sub = df[df.invaded == 1].copy()
P(f'invaded plots n={len(sub)}; P(gardening | invaded) = {sub.gard_any.mean():.3f}')
