c2 = fit('M8 invaded plots only: habitat group + context', 'hgroup + ' + ' + '.join(CTX) + ' + 1', data=sub)
lr(c1, c2, 'habitat group', 'habitat group + context', 3)

rule('B2d. CONTEXT GRADIENTS WITHOUT MODELS (occupancy of gardening by covariate tertile)')
