  f'{t_sh[1, 0]}/{t_sh[1].sum()} = {t_sh[1, 0]/t_sh[1].sum():.3f}  -> OR={o_:.2f} [{lo:.2f},{hi:.2f}] '
  f'Fisher p={pv:.3g}')
P('intensity per occupied plot: Urban '
  f"{df.loc[UCn & df.gard_any.astype(bool), 'n.gard'].mean():.2f} vs Wetlands+Coastal "
