  f'p={stats.f.sf((qb2.deviance - qb.deviance) / 2, 2, qb.df_resid):.3g}')

rule('B2h. DOES THE STYLE SWITCH HOLD WITHIN CONTEXT STRATA? (Cochran-Mantel-Haenszel)')
import statsmodels.stats.contingency_tables as sct
sub3 = df[(df.hgroup != 'Terrestrial-natural') & (df.invaded == 1)].copy()
sub3['is_az'] = (sub3.hgroup == 'Azonal-semi-aquatic').astype(int)
