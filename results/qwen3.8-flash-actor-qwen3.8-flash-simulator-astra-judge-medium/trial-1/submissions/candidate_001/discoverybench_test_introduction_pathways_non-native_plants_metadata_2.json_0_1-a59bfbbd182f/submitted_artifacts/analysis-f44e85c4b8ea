        o_, lo_, hi_, pv = or_ci(t_)
        P(f'    {k:12s} azonal gardening share {a["n.gard"]/max(a.sum(),1):.3f} ({int(a["n.gard"])}/{int(a.sum())})'
          f' | urbanised {b["n.gard"]/max(b.sum(),1):.3f} ({int(b["n.gard"])}/{int(b.sum())})'
          f' | OR={o_:.2f} [{lo_:.2f},{hi_:.2f}] p={pv:.3g} | invaded plots n={len(g)}')
