rule('B3. COUNT-SCALE CHECK: n.gard per plot (Poisson vs negative binomial)')
Xc, nm = dmat('hgroup + ' + ' + '.join(CTX))
try:
    pois = sm.GLM(df['n.gard'], Xc, family=sm.families.Poisson()).fit()
    P(f'Poisson: converged={pois.converged}, deviance/df={pois.deviance / pois.df_resid:.2f}, '
      f'Pearson dispersion={pois.pearson_chi2 / pois.df_resid:.2f}, AIC={pois.aic:.1f}')
    for a, b, se, p_ in zip(nm, pois.params, pois.bse, pois.pvalues):
        P(f'  {a:<32} IRR={np.exp(b):5.2f} [{np.exp(b - 1.96 * se):.2f},{np.exp(b + 1.96 * se):.2f}] p={p_:.3g}')
    try:
        nbm = sm.NegativeBinomial(df['n.gard'], Xc).fit(disp=0, maxiter=300)
        conv = nbm.mle_retvals.get('converged', 'n/a')
        P(f'NB2: converged={conv}, iters={nbm.mle_retvals.get("iterations", "n/a")}, AIC={nbm.aic:.1f}')
        for a, b, se, p_ in zip(nm, nbm.params[:len(nm)], nbm.bse[:len(nm)], nbm.pvalues[:len(nm)]):
            P(f'  {a:<32} IRR={np.exp(b):5.2f} [{np.exp(b - 1.96 * se):.2f},{np.exp(b + 1.96 * se):.2f}] p={p_:.3g}')
    except Exception as e:
        P(f'  NB2 would not fit cleanly ({type(e).__name__}: {e}) -> reported as not usable.')
    P(f'  zero structure: {int((df["n.gard"] == 0).sum())}/{len(df)} plots have n.gard = 0; Poisson '
      f'implied zero share = {float(np.mean(np.exp(-pois.fittedvalues))):.3f}. The count model is '
      'dominated by zeros (a zero-inflation/second-stage process is not identifiable here), so it is '
      'used only as a directional check on the frequency axis, not as a primary result.')
except Exception as e:
    P('  count model failed:', repr(e))

