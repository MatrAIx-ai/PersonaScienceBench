    sh = df.groupby(q, observed=True)['n.gard'].sum() / df.groupby(q, observed=True)['n.total'].sum()
    P(f'  all plots {cv}: gardening SHARE of invaders by tertile {[round(x, 3) for x in sh]}')

rule('B2j. THE PURE STYLE SWITCH: Urban vs Wetlands+Coastal (matched frequency, different dominance)')
UCn = df.habitat == 'Urban'; AZc = df.habitat.isin(['Wetlands', 'Coastal'])
for nm_, m1, m2 in [('occupancy (all plots)', UCn, AZc), ('occupancy among INVADED plots only', UCn & df.invaded.astype(bool), AZc & df.invaded.astype(bool))]:
    t1 = np.array([[int(df.loc[m1, 'gard_any'].sum()), int((~(m1 & df.gard_any.astype(bool))).sum() - (m2 & ~df.gard_any.astype(bool)).sum())]])
    a1, n1 = int(df.loc[m1, 'gard_any'].sum()), int(m1.sum()); a2, n2 = int(df.loc[m2, 'gard_any'].sum()), int(m2.sum())
    tab_ = np.array([[a1, n1 - a1], [a2, n2 - a2]])
