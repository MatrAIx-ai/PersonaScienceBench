"""Firth (1993) penalised logistic regression (canonical/binomial-logit form).

Penalised loglik :  l(b) + 0.5*log|I(b)| ,  l = sum[y log p + (1-y) log(1-p)]
Modified score   :  U*(b) = sum_i x_i [ y_i - p_i + (1-2 p_i) h_i / 2 ]
                   with w_i = p_i(1-p_i),  q_ii = x_i' I^-1 x_i,  h_i = w_i q_ii
Fisher info      :  I = X' W X          (used for Wald SEs)
Fisher scoring with step-halving on the penalised loglik for stability.
Validation cases are in the __main__ block.
"""
import numpy as np


def _pen_ll(X, y, b):
    eta = np.clip(X @ b, -700, 700)
    l = float(y @ eta - np.logaddexp(0, eta).sum())
    pr = 1.0 / (1.0 + np.exp(-eta))
    w = np.clip(pr * (1 - pr), 1e-300, None)
    sgn, ld = np.linalg.slogdet(X.T @ (w[:, None] * X))
    return l + 0.5 * ld if sgn > 0 else l


def firth_logit(X, y, maxit=500, tol=1e-11):
    X = np.asarray(X, float); y = np.asarray(y, float)
    b = np.zeros(X.shape[1]); ll = _pen_ll(X, y, b); it = 0; conv = False
    for it in range(1, maxit + 1):
        pr = 1.0 / (1.0 + np.exp(-np.clip(X @ b, -700, 700)))
        w = np.clip(pr * (1 - pr), 1e-12, None)
        I = X.T @ (w[:, None] * X)
        Iinv = np.linalg.pinv(I, rcond=1e-12)
        q = np.einsum('ij,jk,ik->i', X, Iinv, X)          # unweighted leverage
        h = w * q                                          # weighted leverage
        U = X.T @ (y - pr + (1 - 2 * pr) * h / 2)
        step = Iinv @ U
        f = 1.0
        for _ in range(60):                                 # step-halving
            nb = b + f * step
            nll = _pen_ll(X, y, nb)
            if nll >= ll - 1e-12:
                break
            f /= 2
        if not np.isfinite(nll):
            break
        rel = np.max(np.abs(f * step))
        b, ll = nb, nll
        if rel < tol:
            conv = True
            break
    pr = 1.0 / (1.0 + np.exp(-np.clip(X @ b, -700, 700)))
    w = np.clip(pr * (1 - pr), 1e-12, None)
    Iinv = np.linalg.pinv(X.T @ (w[:, None] * X), rcond=1e-12)
    se = np.sqrt(np.clip(np.diag(Iinv), 0, None))
    return dict(beta=b, se=se, ll=ll, iters=it, converged=conv,
                z=np.where(se > 0, b / np.where(se > 0, se, np.nan), np.nan))


if __name__ == '__main__':
    import statsmodels.api as sm
    from scipy.stats import binom
    # (1) intercept-only, 0/10 successes (complete separation) -> analytic p = 0.5/11
    X = np.ones((10, 1)); y = np.zeros(10)
    r = firth_logit(X, y)
    print('sep 0/10  : firth p =', round(1 / (1 + np.exp(-r['beta'][0])), 5),
          '| analytic 0.5/11 =', round(0.5 / 11, 5), '| converged', r['converged'])
    # (2) clean data: Firth should sit just shrunk toward 0 relative to MLE
    rng = np.random.default_rng(0); n = 400
    x1 = rng.normal(size=n); x2 = (rng.random(n) > 0.85).astype(float)
    X = np.column_stack([np.ones(n), x1, x2])
    y = ((-0.3 + 0.9 * x1 + 0.6 * x2 + rng.normal(size=n)) > 0).astype(float)
    r2 = firth_logit(X, y); m2 = sm.Logit(y, X).fit(disp=0)
    print('clean     : firth', np.round(r2['beta'], 4), 'MLE', np.round(m2.params, 4))
    print('clean SE  : firth', np.round(r2['se'], 4), 'MLE', np.round(m2.bse, 4))
    print('clean its :', r2['iters'], 'converged', r2['converged'])
    # (3) quasi-separated data: MLE unstable/absurd, Firth finite
    y3 = ((-0.5 + 1.0 * x1 + 6.0 * x2 + 0.5 * rng.normal(size=n)) > 0).astype(float)
    r3 = firth_logit(X, y3)
    try:
        m3 = sm.Logit(y3, X).fit(disp=0); mle = np.round(m3.params, 3)
    except Exception as e:
        mle = f'FAILED {type(e).__name__}'
    print('quasi-sep : firth', np.round(r3['beta'], 4), 'conv', r3['converged'], '| MLE', mle)
