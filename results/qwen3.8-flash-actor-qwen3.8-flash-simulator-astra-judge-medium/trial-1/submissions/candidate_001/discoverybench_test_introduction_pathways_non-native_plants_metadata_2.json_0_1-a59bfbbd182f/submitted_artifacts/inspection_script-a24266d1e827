"""Inspection pass only (no inferential analysis): schema, granularity, missingness,
duplicates, ranges, and feasibility checks for the question
'In what context does the gardening pathway show different prevalence styles
across habitat types?'"""
import re, pandas as pd

DATA = '/workspace/data/'

def load(name):
    with open(DATA + name) as fh:
        head = fh.readline()
    return pd.read_csv(DATA + name, sep='\t' if head.count('\t') > 1 else ',')

np_ = load('invaded_niche_pathways.csv')      # plot-level
sp  = load('invasion_success_pathways.csv')    # species-level
tt  = load('temporal_trends_contingency_table.csv')
tree = open(DATA + 'phylogenetic_tree.txt').read()

print('== granularities ==')
print('invaded_niche_pathways:', np_.shape, 'unique lon/lat:',
      np_[['longitude', 'latitude']].drop_duplicates().shape[0])
print('invasion_success_pathways:', sp.shape, 'unique Scientific_name:',
      sp['Scientific_name'].nunique(), 'duplicated==TRUE:', int(sp['duplicated'].sum()))
print('temporal table:', tt.shape, '| columns:', list(tt.columns),
      '| habitat column present:', any('habitat' in c for c in tt.columns))
print('tree tips ~', len(set(re.findall(r'([A-Za-z0-9_.\-]+):', tree))))

print('\n== habitat x pathway counts (plot-level, the only habitat x pathway source) ==')
CNT = ['n.gard', 'n.unint', 'n.agfo', 'n.total']
print('NA per count column:', np_[CNT].isna().sum().to_dict())
print('row-wise n.total == sum of three pathways:',
      bool((np_[CNT[:3]].sum(1) == np_['n.total']).all()))
print('fully duplicated rows:', int(np_.duplicated().sum()))
agg = np_.groupby('habitat')[CNT].sum()
agg['n_plots'] = np_.groupby('habitat').size()
agg['gard_share'] = agg['n.gard'] / agg['n.total']
agg['plots_with_gard'] = [int((g['n.gard'] > 0).sum()) for _, g in np_.groupby('habitat')]
agg['prop_plots_gard'] = agg['plots_with_gard'] / agg['n_plots']
print(agg.sort_values('gard_share', ascending=False).round(3).to_string())

print('\n== small-n / zero-inflation diagnostic ==')
z = np_.assign(zero=np_['n.total'] == 0).groupby('habitat')['zero'].agg(['sum', 'size', 'mean'])
print(z.rename(columns={'sum': 'plots_with_no_invaders', 'size': 'n_plots',
                        'mean': 'prop_empty'}).round(3).to_string())
print('n.gard value distribution:', np_['n.gard'].value_counts().sort_index().to_dict())

print('\n== species-level pathway summary (no habitat identity, only habitat.range) ==')
print(sp.groupby('intro.pathway').agg(n_species=('Scientific_name', 'size'),
                                      sum_invaded_plots=('number.of.invaded.plots', 'sum'),
                                      mean_habitat_range=('habitat.range', 'mean')).round(2).to_string())
print('pathway totals plot-level:', np_[CNT[:3]].sum().to_dict())

print('\n== covariate scale check (documented as %, actually 0-1 proportions) ==')
cov = [c for c in np_.columns if c.startswith(('cropland', 'urban', 'progressive', 'regressive', 'no.changes'))]
print(np_[cov].describe().T[['mean', 'min', 'max']].round(3).to_string())
print('\nmean urban.2009.50m by habitat:'); print(np_.groupby('habitat')['urban.2009.50m'].mean().round(3).sort_values(ascending=False).to_string())
