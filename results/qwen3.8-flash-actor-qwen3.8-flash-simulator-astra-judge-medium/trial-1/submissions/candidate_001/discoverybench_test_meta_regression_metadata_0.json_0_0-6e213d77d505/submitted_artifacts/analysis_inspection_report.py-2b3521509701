import pandas as pd, numpy as np
df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv', na_values=['NA',''])
df['d_fz']=df.fiso-df.fisr
df['abs_diff']=df.ro.abs()-df.rr.abs()
print("signed ro>rr:", (df.ro>df.rr).mean(), " |ro|>|rr|:", (df.abs_diff>0).mean())
print("sign(fiso)==sign(ro):", np.all(np.sign(df.fiso)==np.sign(df.ro)))
print("rr<0 rows by discipline:"); print(df[df.rr<0].groupby('discipline').size())
print("\nnr vs n.r: equal:",(df.nr==df['n.r']).sum()," |diff|>1:",((df.nr-df['n.r']).abs()>1).sum(),
      " corr:", round(df.nr.corr(df['n.r']),4))
print(df[['study','project.x','nr','n.r']].head(5).to_string())
# inverse-variance weights on diff
w = 1/(df.se_fiso**2+df.se_fisr**2)
for lab, g in [('ALL',df)]+[(f'{k}={n}',gg) for k in ['project.x','discipline'] for n,gg in df.groupby(k)]:
    ww = 1/(g.se_fiso**2+g.se_fisr**2); d=g.d_fz
    m=(ww*d).sum()/ww.sum(); se=np.sqrt(1/ww.sum())
    print(f"{lab:34s} n={len(g):3d} IV-mean diff={m:7.4f} (se {se:.4f}) 95%CI [{m-1.96*se:7.4f},{m+1.96*se:7.4f}]")
