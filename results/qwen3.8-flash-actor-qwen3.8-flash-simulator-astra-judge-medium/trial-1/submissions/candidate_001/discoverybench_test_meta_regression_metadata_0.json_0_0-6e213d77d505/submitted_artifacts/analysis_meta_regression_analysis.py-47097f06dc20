"""
Meta-regression of original vs replication effect sizes across replication projects.

QUESTION: For which domains do effect size estimates tend to be larger in original
          studies compared to replication studies?

LOCKED DECISIONS (agreed with researcher):
 1) PRIMARY SCALE = unweighted study-level tendency (mean/median d = fiso - fisr,
    paired t-test + Wilcoxon, % studies with ro > rr).
    Inverse-variance (IV) weighted pooled estimate is reported with EQUAL prominence
    as a sensitivity analysis (not downplayed).
 2) DOMAIN GRAIN: primary = discipline (Social, Cognitive, Economics); project
    (Psychology vs Experimental Economics) reported as compact secondary layer.
    Discipline is perfectly nested in project -> stated explicitly.
 3) relative_es used only as sensitivity (median / trimmed / |ro| > 0.2 subset).
    No hard exclusions from the primary analysis.

Data used as-is (verified: 86 rows, 1 row per study, 0 duplicates, 0 missing in the
effect columns). `n.r`, `aggregated`, `lab_id` unused; `pm_belief` and post-hoc power
columns are descriptive only, never predictors.
"""

from __future__ import annotations
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm

RNG = np.random.default_rng(20261022)
N_BOOT = 10_000
DATA = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
OUT_TABLE = "analysis/summary_table.csv"
OUT_LOG = "analysis/results_log.txt"

_log_lines: list[str] = []


def log(msg: str = "") -> None:
    print(msg)
    _log_lines.append(str(msg))


# ----------------------------------------------------------------------------- data
df = pd.read_csv(DATA, na_values=["NA", ""])
df = df.drop(columns=[c for c in ["aggregated", "lab_id"] if c in df.columns])

df["d_fz"] = df["fiso"] - df["fisr"]                       # primary: Fisher-z original - replication
df["se_d"] = np.sqrt(df["se_fiso"] ** 2 + df["se_fisr"] ** 2)
df["w"] = 1.0 / df["se_d"] ** 2                            # inverse-variance weight on the pair
df["d_r"] = df["ro"] - df["rr"]                            # sensitivity: correlation scale
df["orig_gt_repl"] = (df["ro"] > df["rr"]).astype(int)     # direction share (signed)
df["orig_gt_repl_abs"] = (df["ro"].abs() > df["rr"].abs()).astype(int)
df["tiny_n"] = df["no"] < 10                               # tiny original sample flag
df["small_ro"] = df["ro"].abs() < 0.2                      # unstable relative_es denominator flag
df["keep_trim"] = (~df["tiny_n"]) & (~df["small_ro"])      # trimmed sensitivity subset
df["domain"] = np.where(df["project.x"].eq("Experimental Economics"),
                        "Economics (=Experimental Economics project)", df["discipline"])

log("=" * 92)
log("DATA CHECK")
log("=" * 92)
log(f"rows={len(df)}  cols={df.shape[1]}  unique study={df['study'].nunique()}  "
    f"full-duplicate rows={df.duplicated().sum()}")
log("missing in effect columns: "
    f"{int(df[['ro','rr','fiso','fisr','se_fiso','se_fisr','relative_es','replicated']].isna().sum().sum())}")
log(f"project.x: {df['project.x'].value_counts().to_dict()}")
log(f"discipline: {df['discipline'].value_counts().to_dict()}")
log(f"project x discipline nested? -> {pd.crosstab(df['discipline'], df['project.x']).to_dict()}")
log("\npair SEs equal analytic 1/sqrt(n-3)?  "
    f"max|se_fiso-1/sqrt(no-3)|={np.abs(df.se_fiso - 1/np.sqrt(df['no']-3)).max():.2e}, "
    f"max|se_fisr-1/sqrt(nr-3)|={np.abs(df.se_fisr - 1/np.sqrt(df['nr']-3)).max():.2e}")


# --------------------------------------------------------------------- estimators
def ci_mean_t(x):
    n = len(x)
    m = x.mean()
    se = x.std(ddof=1) / np.sqrt(n)
    q = stats.t.ppf(0.975, n - 1)
    return m, m - q * se, m + q * se


def boot_mean_ci(x, n_boot=N_BOOT):
    idx = RNG.integers(0, len(x), size=(n_boot, len(x)))
    b = x[idx].mean(axis=1)
    return float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))


def iv_mean_ci(x, w):
    m = float(np.sum(w * x) / np.sum(w))
    se = float(np.sqrt(1.0 / np.sum(w)))
    return m, m - 1.96 * se, m + 1.96 * se


def wmean(x, w):
    return float(np.sum(w * x) / np.sum(w))


def clopper_pearson(k, n, a=0.05):
    lo = 0.0 if k == 0 else stats.beta.ppf(a / 2, k, n - k + 1)
    hi = 1.0 if k == n else stats.beta.ppf(1 - a / 2, k + 1, n - k)
    return float(lo), float(hi)


def summarise(g: pd.DataFrame, label: str, family: str) -> dict:
    d = g["d_fz"].to_numpy(float)
    w = g["w"].to_numpy(float)
    gt = g[g["keep_trim"]]
    dtr, wtr = gt["d_fz"].to_numpy(float), gt["w"].to_numpy(float)
    rel = g["relative_es"].to_numpy(float)
    lo, hi = boot_mean_ci(d) if len(d) > 1 else (np.nan, np.nan)
    iv_m, iv_lo, iv_hi = iv_mean_ci(d, w)
    k, n = int(g["orig_gt_repl"].sum()), len(g)
    c_lo, c_hi = clopper_pearson(k, n)
    tt = stats.ttest_rel(g["fiso"], g["fisr"]) if n > 1 else None
    try:
        wx = stats.wilcoxon(g["fiso"], g["fisr"], zero_method="wilcox")
        wp, wstat = float(wx.pvalue), float(wx.statistic)
    except ValueError:
        wp, wstat = np.nan, np.nan
    return dict(
        group=label, family=family, n=n,
        n_tiny_n=int(g["tiny_n"].sum()),
        n_tiny_n_in_ee=int((g["tiny_n"] & g["project.x"].eq("Experimental Economics")).sum()),
        n_small_ro=int(g["small_ro"].sum()),
        # ---- PRIMARY: unweighted study-level tendency
        mean_d_fz=d.mean(), mean_d_fz_lo95=ci_mean_t(d)[1], mean_d_fz_hi95=ci_mean_t(d)[2],
        boot_lo95=lo, boot_hi95=hi, median_d_fz=float(np.median(d)),
        paired_t=float(tt.statistic) if tt is not None else np.nan,
        paired_p=float(tt.pvalue) if tt is not None else np.nan,
        wilcoxon_stat=wstat, wilcoxon_p=wp,
        pct_ro_gt_rr=100.0 * k / n, pct_ro_gt_rr_lo95=100.0 * c_lo, pct_ro_gt_rr_hi95=100.0 * c_hi,
        pct_roabs_gt_replabs=100.0 * g["orig_gt_repl_abs"].mean(),
        mean_d_ro_rr=g["d_r"].mean(), median_d_ro_rr=float(g["d_r"].median()),
        # ---- SENSITIVITY: inverse-variance weighted pooled estimate (equally prominent)
        iv_d_fz=iv_m, iv_lo95=iv_lo, iv_hi95=iv_hi,
        # ---- SENSITIVITY: trimmed runs (drop no<10 and |ro|<0.2)
        n_trim=len(dtr),
        trim_mean_d_fz=dtr.mean() if len(dtr) else np.nan,
        trim_mean_lo95=ci_mean_t(dtr)[1] if len(dtr) > 1 else np.nan,
        trim_mean_hi95=ci_mean_t(dtr)[2] if len(dtr) > 1 else np.nan,
        trim_median_d_fz=float(np.median(dtr)) if len(dtr) else np.nan,
        trim_pct_ro_gt_rr=100.0 * gt["orig_gt_repl"].mean() if len(dtr) else np.nan,
        trim_iv_d_fz=iv_mean_ci(dtr, wtr)[0] if len(dtr) else np.nan,
        trim_iv_lo95=iv_mean_ci(dtr, wtr)[1] if len(dtr) > 1 else np.nan,
        trim_iv_hi95=iv_mean_ci(dtr, wtr)[2] if len(dtr) > 1 else np.nan,
        # ---- SENSITIVITY: shrinkage ratio relative_es = rr / ro (smaller = stronger shrinkage)
        median_relative_es=float(np.median(rel)),
        mean_relative_es=float(rel.mean()),
        median_relative_es_trim=float(np.median(gt["relative_es"])) if len(gt) else np.nan,
        median_relative_es_ro02=float(np.median(g.loc[g["ro"].abs() > 0.2, "relative_es"])),
        pct_relative_es_lt1=100.0 * float((rel < 1).mean()),
        replicated_rate=float(g["replicated"].mean()),
        mean_no=float(g["no"].mean()), mean_nr=float(g["nr"].mean()),
        mean_power_o=float(g["power.o"].mean()), mean_power_r=float(g["power.r"].mean()),
    )


rows = [summarise(df, "ALL STUDIES", "overall")]
for name, g in df.groupby("discipline", sort=True):
    rows.append(summarise(g, f"discipline={name}", "primary_discipline"))
for name, g in df.groupby("project.x", sort=True):
    rows.append(summarise(g, f"project={name}", "secondary_project"))

table = pd.DataFrame(rows)
table.to_csv(OUT_TABLE, index=False)

log("\n" + "=" * 92)
log("SUMMARY TABLE (PRIMARY = unweighted; IV pooled estimate shown with equal prominence)")
log("=" * 92)
show = table[["group", "n", "n_tiny_n", "n_tiny_n_in_ee", "mean_d_fz", "mean_d_fz_lo95", "mean_d_fz_hi95",
              "median_d_fz", "paired_p", "wilcoxon_p", "pct_ro_gt_rr",
              "iv_d_fz", "iv_lo95", "iv_hi95", "n_trim", "trim_mean_d_fz", "trim_iv_d_fz",
              "median_relative_es", "median_relative_es_ro02", "pct_relative_es_lt1",
              "replicated_rate"]].copy()
with pd.option_context("display.width", 260, "display.max_columns", 60,
                       "display.float_format", lambda v: f"{v:0.3f}"):
    log(show.to_string(index=False))

# --------------------------------------------------------- tiny-N composition check
log("\n" + "=" * 92)
log("TINY-N COMPOSITION: is the unweighted Economics gap driven by tiny original samples?")
log("=" * 92)
tiny = df[df["tiny_n"]][["study", "project.x", "discipline", "no", "nr", "ro", "rr", "d_fz", "relative_es"]]
log(f"tiny-N (no<10) studies: n={len(tiny)} -> by project {tiny['project.x'].value_counts().to_dict()}"
    f" ; by discipline {tiny['discipline'].value_counts().to_dict()}")
log(tiny.to_string(index=False))
ee = df[df["project.x"].eq("Experimental Economics")]
ee_trim = ee[ee["keep_trim"]]
log(f"\nEE full:    n={len(ee)} mean d_fz={ee.d_fz.mean():.4f} median={ee.d_fz.median():.4f} "
    f"IV={wmean(ee.d_fz.to_numpy(), ee.w.to_numpy()):.4f} %ro>rr={100*ee.orig_gt_repl.mean():.1f}")
log(f"EE trimmed: n={len(ee_trim)} mean d_fz={ee_trim.d_fz.mean():.4f} median={ee_trim.d_fz.median():.4f} "
    f"IV={wmean(ee_trim.d_fz.to_numpy(), ee_trim.w.to_numpy()):.4f} "
    f"%ro>rr={100*ee_trim.orig_gt_repl.mean():.1f} "
    f"paired p={stats.ttest_rel(ee_trim.fiso, ee_trim.fisr).pvalue:.4f}")
log("does the gap shrink as the samples get larger (regression-to-zero of the gap with precision)?")
for lab, g in df.groupby("discipline"):
    log(f"   {lab:10s} corr(d_fz, se_fisr)={g.d_fz.corr(g.se_fisr):+.3f}  corr(d_fz, no)={g.d_fz.corr(g['no']):+.3f}")
log(f"   EE alone   corr(d_fz, no)={ee.d_fz.corr(ee['no']):+.3f}  corr(d_fz, nr)={ee.d_fz.corr(ee['nr']):+.3f}")
ee_med = ee.assign(big=ee["nr"] >= ee["nr"].median())
for b, g in ee_med.groupby("big"):
    log(f"   EE {'large' if b else 'small'} replication-N (n={len(g)}): mean d_fz={g.d_fz.mean():.4f} "
        f"median={g.d_fz.median():.4f} %ro>rr={100*g.orig_gt_repl.mean():.1f}")

# --------------------------------------------- between-group tests + meta-regression
log("\n" + "=" * 92)
log("MULTIPLICITY: pre-registered family = 3 discipline paired tests + between-discipline meta-regression")
log("=" * 92)
prim = table[table["family"] == "primary_discipline"].copy()


def holm(pvals):
    order = np.argsort(pvals)
    m, adj, running = len(pvals), np.empty(len(pvals)), 0.0
    for rank, i in enumerate(order):
        running = max(running, (m - rank) * pvals[i])
        adj[i] = min(1.0, running)
    return adj


prim["paired_p_holm"] = holm(prim["paired_p"].tolist())
prim["wilcoxon_p_holm"] = holm(prim["wilcoxon_p"].tolist())
log("Holm-adjusted p across the 3 discipline tests:")
log(prim[["group", "n", "mean_d_fz", "paired_p", "paired_p_holm", "wilcoxon_p", "wilcoxon_p_holm"]]
    .to_string(index=False))

reg = df.copy()
reg["social"] = reg["discipline"].eq("Social").astype(int)
reg["cogn"] = reg["discipline"].eq("Cognitive").astype(int)
X = sm.add_constant(reg[["social", "cogn"]].astype(float))
wls = sm.WLS(reg["d_fz"], X, weights=reg["w"]).fit()
ciw = wls.conf_int()
log("\nIV-weighted meta-regression: d_fz ~ 1 + Social + Cognitive (ref = Economics; weights = 1/SE_pair^2)")
log(f"  intercept (Economics) = {wls.params['const']:.4f} [{ciw.loc['const',0]:.4f},{ciw.loc['const',1]:.4f}]"
    f"  p={wls.pvalues['const']:.4f}")
for term, nm in [("social", "Social - Economics"), ("cogn", "Cognitive - Economics")]:
    log(f"  {nm:22s} = {wls.params[term]:+.4f} [{ciw.loc[term,0]:+.4f},{ciw.loc[term,1]:+.4f}]"
        f"  p={wls.pvalues[term]:.4f}")
ft = wls.f_test(np.eye(3)[[1, 2]])
log(f"  joint Wald test for discipline (2 df): F={float(ft.fvalue):.2f}  p={float(ft.pvalue):.4f}")

ols = sm.OLS(reg["d_fz"], X).fit(cov_type="HC3")
cio = ols.conf_int()
log("\nUnweighted OLS (HC3) d_fz ~ Social + Cognitive  [same scale as the primary analysis]")
log(f"  intercept (Economics) = {ols.params['const']:.4f} p={ols.pvalues['const']:.4f}")
for term, nm in [("social", "Social - Economics"), ("cogn", "Cognitive - Economics")]:
    log(f"  {nm:22s} = {ols.params[term]:+.4f} [{cio.loc[term,0]:+.4f},{cio.loc[term,1]:+.4f}]"
        f"  p={ols.pvalues[term]:.4f}")

tr = reg[reg["keep_trim"]]
wls_tr = sm.WLS(tr["d_fz"], sm.add_constant(tr[["social", "cogn"]].astype(float)), weights=tr["w"]).fit()
log(f"\nTrimmed IV meta-regression (drop no<10 and |ro|<0.2; n={len(tr)}):")
log(f"  Economics intercept={wls_tr.params['const']:.4f} p={wls_tr.pvalues['const']:.4f} | "
    f"Social-Econ={wls_tr.params['social']:+.4f} p={wls_tr.pvalues['social']:.4f} | "
    f"Cognitive-Econ={wls_tr.params['cogn']:+.4f} p={wls_tr.pvalues['cogn']:.4f}")

# project-level (EXPLORATORY)
log("\nPROJECT-LEVEL (EXPLORATORY): d_fz ~ Experimental Economics")
Xp = sm.add_constant(df.assign(ee=df["project.x"].eq("Experimental Economics").astype(int))[["ee"]].astype(float))
wls_p = sm.WLS(df["d_fz"], Xp, weights=df["w"]).fit()
ols_p = sm.OLS(df["d_fz"], Xp).fit(cov_type="HC3")
log(f"  IV : Psych intercept={wls_p.params['const']:.4f} p={wls_p.pvalues['const']:.3g} ; "
    f"EE-Psych diff={wls_p.params['ee']:+.4f} p={wls_p.pvalues['ee']:.4f}")
log(f"  OLS: Psych intercept={ols_p.params['const']:.4f} ; "
    f"EE-Psych diff={ols_p.params['ee']:+.4f} p={ols_p.pvalues['ee']:.4f}")
mw = stats.mannwhitneyu(df.loc[df["project.x"].eq("Psychology"), "d_fz"],
                        df.loc[df["project.x"].eq("Experimental Economics"), "d_fz"])
log(f"  between-project Mann-Whitney U on unweighted d_fz: p={mw.pvalue:.4f}")

log("\n" + "=" * 92)
log("RELATIVE EFFECT SIZE (rr/ro) SENSITIVITY - smaller = stronger shrinkage of the replication")
log("=" * 92)
log(table[["group", "n", "median_relative_es", "median_relative_es_trim", "median_relative_es_ro02",
           "mean_relative_es", "pct_relative_es_lt1"]].to_string(index=False))
log(f"\nnegative relative_es (replication opposite sign): {int((df.relative_es < 0).sum())}/{len(df)} ; "
    f"relative_es > 1: {int((df.relative_es > 1).sum())}")

log("\n" + "=" * 92)
log("HEADLINE NUMBERS USED IN THE HYPOTHESIS")
log("=" * 92)
for _, r in table.iterrows():
    log(f"{r['group']:<40s} n={int(r['n']):3d} | unweighted mean d_fz={r['mean_d_fz']:.3f} "
        f"[{r['mean_d_fz_lo95']:.3f},{r['mean_d_fz_hi95']:.3f}] median={r['median_d_fz']:.3f} "
        f"| {r['pct_ro_gt_rr']:.1f}%[{r['pct_ro_gt_rr_lo95']:.1f},{r['pct_ro_gt_rr_hi95']:.1f}] ro>rr "
        f"| t p={r['paired_p']:.2e} W p={r['wilcoxon_p']:.2e} "
        f"| IV={r['iv_d_fz']:.3f}[{r['iv_lo95']:.3f},{r['iv_hi95']:.3f}] "
        f"| trimmed unw={r['trim_mean_d_fz']:.3f} trimmed IV={r['trim_iv_d_fz']:.3f} (n={int(r['n_trim'])}) "
        f"| med relES={r['median_relative_es']:.3f} (|ro|>.2: {r['median_relative_es_ro02']:.3f}) "
        f"| replicated={r['replicated_rate']:.3f}")

