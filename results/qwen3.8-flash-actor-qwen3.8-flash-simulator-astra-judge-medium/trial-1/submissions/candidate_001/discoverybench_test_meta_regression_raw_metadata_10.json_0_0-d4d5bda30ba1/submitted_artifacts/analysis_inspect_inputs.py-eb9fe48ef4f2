"""Stage-1 inspection only (no final proportion computed).
Profiles the two staged CSVs: unit of analysis, project codes, seniority coding,
replication-outcome integrity, duplicates/missing values, cross-file joinability.
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 250)

F1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
F2 = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'
s = pd.read_csv(F1); r = pd.read_csv(F2)
print("file1 (study-level meta-regression):", s.shape)
print("file2 (replication success):", r.shape)

# 1. unit of analysis
per = s.groupby('project').agg(rows=('id','size'), unique_ids=('id','nunique'),
        agg_true=('aggregated', lambda x:(x==True).sum()),
        agg_false=('aggregated', lambda x:(x==False).sum()),
        lab_id_present=('lab_id', lambda x:x.notna().sum()),
        drop_true=('drop', lambda x:(x==True).sum()))
print("\n[1] rows per project / aggregation structure\n", per)

# 2. project x discipline, outcome coverage
print("\n[2] project x discipline\n", pd.crosstab(s['project'], s['discipline']))
print("\n[2] project x replicated\n", pd.crosstab(s['project'], s['replicated'], dropna=False, margins=True))

# 3. seniority coding
print("\n[3] seniority.o levels\n", s['seniority.o'].value_counts(dropna=False))
print("\n[3] seniority.r levels\n", s['seniority.r'].value_counts(dropna=False))

# 4. Psychology subset (project == 'rpp')
rpp = s[s.project == 'rpp'].copy()
print("\n[4] rpp rows:", len(rpp), "| unique ids:", rpp.id.nunique(), "| missing seniority:",
      int(rpp[['seniority.o','seniority.r']].isna().sum().sum()), "| missing replicated:", int(rpp['replicated'].isna().sum()))
print(pd.crosstab(rpp['seniority.o'], rpp['seniority.r'], margins=True))

# 5. outcome integrity: replicate the 'replicated' flag definition
ok = rpp.dropna(subset=['replicated','p_value.r','effect_size.o','effect_size.r'])
rec = ((ok['p_value.r'] <= .05) & (np.sign(ok['effect_size.r']) == np.sign(ok['effect_size.o']))).astype(float)
print("\n[5] recomputed 'replicated' agreement:", (rec == ok['replicated']).mean(), "on n =", len(ok))

# 6. duplicate original studies within rpp (same original paper replicated by >1 team)
dup = rpp[rpp.duplicated('authors.o', keep=False)]
print("\n[6] duplicate original studies within rpp:", len(dup), "rows ->", dup.id.tolist())

# 7. file2: no seniority/author columns; project labels differ; joinability
print("\n[7] file2 columns:", list(r.columns))
print("[7] file2 project labels\n", r['project'].value_counts())
import re
def toks(x): return set(t.lower() for t in re.findall(r"[A-Za-z][A-Za-z\-']{2,}", str(x)))
psy = r[r.project == 'Psychology']; hi = 0
for st in psy['study']:
    a = toks(st)
    best = max(len(a & toks(x))/max(1,len(a)) for x in rpp['authors.o'])
    hi += best >= 0.99
print(f"[7] file2 'Psychology' rows: {len(psy)}; high-confidence author-string matches to file1 rpp: {hi}")
