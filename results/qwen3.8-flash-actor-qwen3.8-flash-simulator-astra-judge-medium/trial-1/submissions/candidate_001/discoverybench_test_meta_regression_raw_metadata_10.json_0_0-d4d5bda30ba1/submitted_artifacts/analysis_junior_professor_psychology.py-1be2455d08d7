"""
Question: What is the proportion of junior professors in replicated studies in Psychology?

Locked specification (approved by researcher):
  Frame        : file A (meta-regression study data) ONLY; project == 'rpp' == "Psychology".
  Denominator  : PRIMARY = rpp pairs with replicated == 1; CO-PRIMARY = all rpp attempted pairs (n=97).
  Numerator    : PRIMARY = seniority.r == 'Assistant Professor'; nested: J2 = {Assistant Professor, Assistant};
                 J3 = "below full Professor" = {Assistant Professor, Associate Professor, Assistant}.
  Seniority    : primary seniority.r; seniority.o reported explicitly (degenerate inside rpp).
  Unit         : original-study/replication PAIR (primary); unique-original-study variant reported.
  drop flag    : kept in primary; drop == False variant reported.
  ml1/ml3      : study-level figures use aggregated == True rows only.
File B is a non-authoritative coverage/outcome cross-check only (no seniority field).
"""
import re
import numpy as np
import pandas as pd
from scipy.stats import fisher_exact
from statsmodels.stats.proportion import proportion_confint

pd.set_option("display.width", 250)
pd.set_option("display.max_colwidth", 62)

F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
F2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"
OUT = "analysis/results"

s = pd.read_csv(F1)
b = pd.read_csv(F2)

JUNIORS = {
    "J1 junior professor (Assistant Professor)": ["Assistant Professor"],
    "J2 + Assistant": ["Assistant Professor", "Assistant"],
    "J3 below full Professor": ["Assistant Professor", "Associate Professor", "Assistant"],
}

def pct(n, d):
    return np.nan if d == 0 else 100.0 * n / d

def wilson(n, d):
    if d == 0:
        return (np.nan, np.nan)
    lo, hi = proportion_confint(n, d, alpha=0.05, method="wilson")
    return (100 * lo, 100 * hi)

dq = []
def check(name, ok, detail):
    dq.append((name, "PASS" if ok else "REVIEW", detail))

check("file A loaded", s.shape == (927, 57), f"shape={s.shape}")
check("file B loaded", b.shape[1] == 15, f"shape={b.shape}")
check("project codes are ml1/ml3/rpp/ee", set(s.project) == {"ml1", "ml3", "rpp", "ee"}, sorted(set(s.project)))

rpp = s[s.project == "rpp"].copy()
check("rpp is one row per pair (no lab rows)", int(rpp.lab_id.notna().sum()) == 0 and rpp.id.is_unique,
      f"rows={len(rpp)}, unique ids={rpp.id.nunique()}, lab_id present={int(rpp.lab_id.notna().sum())}")
check("seniority.r complete in rpp", int(rpp["seniority.r"].isna().sum()) == 0, f"missing={int(rpp['seniority.r'].isna().sum())}")
check("seniority.o complete in rpp", int(rpp["seniority.o"].isna().sum()) == 0, f"missing={int(rpp['seniority.o'].isna().sum())}")
check("replicated complete in rpp", int(rpp["replicated"].isna().sum()) == 0, f"missing={int(rpp['replicated'].isna().sum())}")
canon = {"Professor", "Associate Professor", "Assistant Professor", "Assistant", "Researcher"}
check("seniority strings clean (5 canonical levels)", set(s["seniority.r"].dropna().unique()) == canon and set(s["seniority.o"].dropna().unique()) == canon,
      f".r levels={sorted(canon)}")
comp = rpp.dropna(subset=["replicated", "p_value.r", "effect_size.o", "effect_size.r"])
rec = ((comp["p_value.r"] <= 0.05) & (np.sign(comp["effect_size.r"]) == np.sign(comp["effect_size.o"]))).astype(float)
check("replicated flag reproducible (p<=.05 & same sign)", bool((rec == comp["replicated"]).all()),
      f"agreement={(rec == comp['replicated']).mean():.3f} on n={len(comp)} of {len(rpp)}")
dup_authors = rpp[rpp.duplicated("authors.o", keep=False)].sort_values("authors.o")
check("duplicate original studies inside rpp identified", len(dup_authors) == 6, f"{len(dup_authors)} rows -> {sorted(dup_authors.id.tolist())}")
check("provider drop flag counted in rpp", int(rpp["drop"].sum()) == 7, f"drop==True: {int(rpp['drop'].sum())}")
check("ml1/ml3 lab rows excluded from study-level figures", True, "ml frames filtered on aggregated == True (ml1 16, ml3 10)")

rep1 = rpp[rpp.replicated == 1]
n_head = int(rep1["seniority.r"].eq("Assistant Professor").sum())
d_head = len(rep1)
lo, hi = wilson(n_head, d_head)
print("=" * 100)
print("HEADLINE (primary specification)")
print("  filter chain: file A -> project == 'rpp' (Psychology) -> replicated == 1 -> seniority.r == 'Assistant Professor'")
print(f"  n = {n_head} / {d_head} = {pct(n_head, d_head):.2f}%   Wilson 95% CI = [{lo:.1f}%, {hi:.1f}%]")
print("=" * 100)
print("\nMost senior author rank, rpp & replicated == 1 (n=35):")
tab = pd.DataFrame({"seniority.r (replication side)": rep1["seniority.r"].value_counts(),
                    "seniority.o (original side)": rep1["seniority.o"].value_counts()}).fillna(0).astype(int)
tab["pct seniority.r"] = (100 * tab["seniority.r (replication side)"] / d_head).round(1)
tab["pct seniority.o"] = (100 * tab["seniority.o (original side)"] / d_head).round(1)
print(tab.to_string())
o_jr = int(rep1["seniority.o"].isin(["Assistant Professor", "Assistant"]).sum())
o_below = int(rep1["seniority.o"].isin(["Assistant Professor", "Assistant", "Associate Professor"]).sum())
print(f"\nDEGENERACY CHECK -> seniority.o junior-professor share = {o_jr}/{d_head} = {pct(o_jr, d_head):.1f}% "
      f"(no junior-professorial lead author exists among rpp originals); 'below full Professor' = {o_below}/{d_head} = {pct(o_below, d_head):.1f}%")

rows = []
def add(scenario, field, jname, num, den):
    lo_, hi_ = wilson(num, den)
    rows.append(dict(scenario=scenario, seniority_field=field, junior_definition=jname,
                     numerator=int(num), denominator=int(den), percent=round(pct(num, den), 2),
                     ci95_low=round(lo_, 1), ci95_high=round(hi_, 1)))

for jname, jvals in JUNIORS.items():
    for field in ["seniority.r", "seniority.o"]:
        add("PRIMARY: rpp, replicated==1, pairs (drop kept)", field, jname, int(rep1[field].isin(jvals).sum()), len(rep1))
        add("co-primary: rpp, all attempted pairs", field, jname, int(rpp[field].isin(jvals).sum()), len(rpp))
        nonrep = rpp[rpp.replicated == 0]
        add("contrast: rpp, replicated==0", field, jname, int(nonrep[field].isin(jvals).sum()), len(nonrep))
        r1d, rad = rep1[~rep1["drop"]], rpp[~rpp["drop"]]
        add("rpp, replicated==1, drop==False only", field, jname, int(r1d[field].isin(jvals).sum()), len(r1d))
        add("rpp, all attempted, drop==False only", field, jname, int(rad[field].isin(jvals).sum()), len(rad))

rpp_sorted = rpp.assign(_num=rpp.id.str.extract(r"rpp\.(\d+)").astype(int)).sort_values("_num")
uni_pair = rpp_sorted.drop_duplicates("authors.o")
uni_rep = uni_pair[uni_pair.replicated == 1]
for jname, jvals in JUNIORS.items():
    for field in ["seniority.r", "seniority.o"]:
        add("unique-original-study variant: replicated==1", field, jname, int(uni_rep[field].isin(jvals).sum()), len(uni_rep))
        add("unique-original-study variant: all attempted", field, jname, int(uni_pair[field].isin(jvals).sum()), len(uni_pair))

psy_all = pd.concat([s[s.project == "rpp"], s[s.project.isin(["ml1", "ml3"]) & (s.aggregated == True)]], ignore_index=True)
psy_rep = psy_all[psy_all.replicated == 1]
for jname, jvals in JUNIORS.items():
    for field in ["seniority.r", "seniority.o"]:
        add("all psychology projects (rpp+ml1+ml3, aggregated==True only), replicated==1", field, jname,
            int(psy_rep[field].isin(jvals).sum()), len(psy_rep))
        add("all psychology projects (rpp+ml1+ml3, aggregated==True only), all attempted", field, jname,
            int(psy_all[field].isin(jvals).sum()), len(psy_all))

sens = pd.DataFrame(rows).sort_values(["scenario", "junior_definition", "seniority_field"]).reset_index(drop=True)
sens.to_csv(f"{OUT}/sensitivity_table.csv", index=False)
print("\n" + "=" * 100)
print("SENSITIVITY TABLE (full grid -> analysis/results/sensitivity_table.csv)")
print("=" * 100)
print(sens.to_string(index=False))

print("\n" + "=" * 100)
print("DRIVERS OF THE HEADLINE NUMBER")
print("=" * 100)
jr = rep1[rep1["seniority.r"] == "Assistant Professor"].copy()
cols = ["id", "title", "journal", "discipline", "seniority.o", "seniority.r", "p_value.r", "effect_size.r", "relative_es", "drop"]
print(jr[cols].to_string(index=False))
jr[cols].to_csv(f"{OUT}/headline_junior_pairs.csv", index=False)
print("\nby discipline of original:"); print(jr["discipline"].value_counts().to_string())
print("\nby journal of original:"); print(jr["journal"].value_counts().to_string())
print("\nlead rank of the ORIGINAL papers they replicated:"); print(jr["seniority.o"].value_counts().to_string())

print("\nEffect-size context: median relative_es (replication/original) for junior-led (AsstProf) successful replications = "
      f"{jr['relative_es'].median():.2f} vs {rep1[rep1['seniority.r'] != 'Assistant Professor'].relative_es.median():.2f} for the other successful replications")
print("None of the 10 junior-led successful replications carry drop == True (hence numerator is unchanged, denominator 35 -> 31, in the drop==False variant).")
print("\nBase-rate contrast (junior-led x replication success within rpp):")
ct = pd.crosstab(rpp["replicated"], rpp["seniority.r"].eq("Assistant Professor"))
print(ct.to_string())
n_jr0 = int(((rpp.replicated == 0) & rpp["seniority.r"].eq("Assistant Professor")).sum())
odd, pval = fisher_exact([[n_head, d_head - n_head], [n_jr0, int((rpp.replicated == 0).sum()) - n_jr0]])
print(f"Fisher exact: OR={odd:.2f}, p={pval:.3f} -> descriptive association only.")

mix = pd.DataFrame({"all attempted rpp (n=97)": rpp["seniority.r"].value_counts(),
                    "replicated==1 (n=35)": rep1["seniority.r"].value_counts()}).fillna(0).astype(int)
mix["share within replicated %"] = (100 * mix["replicated==1 (n=35)"] / mix["replicated==1 (n=35)"].sum()).round(1)
mix["share within attempted %"] = (100 * mix["all attempted rpp (n=97)"] / mix["all attempted rpp (n=97)"].sum()).round(1)
print("\nFull rank mix:\n" + mix.to_string())

print("\n" + "=" * 100)
print("FILE B CROSS-CHECK (non-authoritative; NO seniority/author field)")
print("=" * 100)
def toks(x):
    return set(t.lower() for t in re.findall(r"[A-Za-z][A-Za-z\-']{2,}", str(x)))
bpsy = b[b.project == "Psychology"].copy()
matches = []
for st in bpsy["study"]:
    a = toks(st)
    cov = {i: len(a & toks(x)) / max(1, len(a)) for i, x in rpp["authors.o"].items()}
    best = max(cov, key=cov.get)
    matches.append((st, rpp.loc[best, "id"], cov[best]))
mm = pd.DataFrame(matches, columns=["fileB_study", "rpp_id", "coverage"])
hi_conf = mm[mm.coverage >= 0.99]
print(f"file B 'Psychology' rows: {len(bpsy)} (unique labels {bpsy.study.nunique()}) vs {len(rpp)} rpp pairs")
print(f"high-confidence name matches: {hi_conf.rpp_id.nunique()} distinct rpp pairs; unmatched rpp pairs: "
      f"{len(set(rpp.id) - set(hi_conf.rpp_id))} -> UNDOCUMENTED COVERAGE GAP (not imputed)")
mrg = (hi_conf.drop_duplicates("rpp_id")
       .merge(rpp[["id", "replicated"]].rename(columns={"id": "rpp_id"}), on="rpp_id", how="left")
       .merge(bpsy[["study", "pr", "rr", "ro"]].rename(columns={"study": "fileB_study"}), on="fileB_study", how="left"))
mrg["b_success"] = ((mrg.pr <= 0.05) & (np.sign(mrg.rr) == np.sign(mrg.ro))).astype(float)
print(f"comparison rows: {len(mrg)} ({hi_conf.rpp_id.nunique()} distinct rpp pairs; file B repeats one study label, "
      "Bressan & Stranieri, twice)");
print(f"outcome agreement (file A replicated flag vs file B recomputed pr<=.05 & same sign): "
      f"{100*(mrg.b_success == mrg.replicated).mean():.1f}%")
mm.to_csv(f"{OUT}/fileB_crosscheck_matches.csv", index=False)
print("file B columns (no seniority):", list(b.columns))

print("\n" + "=" * 100)
print("DATA-QUALITY CHECKS")
print("=" * 100)
dqdf = pd.DataFrame(dq, columns=["check", "status", "detail"])
dqdf.to_csv(f"{OUT}/data_quality_checks.csv", index=False)
print(dqdf.to_string(index=False))
print("\nseniority levels in rpp - original side:", sorted(rpp["seniority.o"].unique()))
print("seniority levels in rpp - replication side:", sorted(rpp["seniority.r"].unique()))
print(f"rpp denominators: attempted={len(rpp)}, replicated==1={len(rep1)}, replicated==0={int((rpp.replicated==0).sum())}, unique originals={len(uni_pair)}")
