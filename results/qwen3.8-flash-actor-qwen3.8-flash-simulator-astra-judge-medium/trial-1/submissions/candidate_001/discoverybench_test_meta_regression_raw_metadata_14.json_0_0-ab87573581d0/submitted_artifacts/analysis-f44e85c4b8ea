"""FINAL ANALYSIS
Question: "In which domain did both original and replication studies primarily use
student subjects (original: 82.4%, replication: 80.9%)?"

Domain variable = `discipline` (Social / Cognitive / Economics) in
meta-regression_study_data_heterogeneity_in_replication_projects.csv.
Subject variables = `subjects.o` (original) and `subjects.r` (replication).

Two units of analysis are reported side by side:
  (i)  lab-level records  -> every one of the 927 rows (Many Labs studies were run in
       many labs, so a single original study can contribute up to 37 rows)
  (ii) unique original studies -> dedup by `id` (141 ids)

Replication-share tie rule at study level: the FIRST row of each `id` in file order.
Alternatives (majority lab, ANY lab used students, ALL labs used students) are reported.

Sensitivity (caveat only, not headline): rows with drop == True removed; rows with
aggregated == True removed; complete-case on the core meta-regression variables.

File 2 (meta-regression_replication_success_data_...) is EXCLUDED: it contains no
subjects field and its only identifier (`study`, initials+surname strings) matches just
20/143 rows of file 1 by first-author surname, so it cannot supply or check these shares.
"""
import pandas as pd

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
TARGET_O, TARGET_R = 82.4, 80.9
CORE = ["effect_size.o", "p_value.o", "n.o", "effect_size.r", "p_value.r", "n.r",
        "discipline", "subjects.o", "subjects.r", "project"]

df = pd.read_csv(STUDY)
out_lines = []


def log(*a):
    s = " ".join(str(x) for x in a)
    print(s)
    out_lines.append(s)


log("study file:", df.shape, "| unique original studies (id):", df["id"].nunique())
log("discipline levels:", df["discipline"].dropna().unique().tolist(),
    "| missing:", int(df["discipline"].isna().sum()))
log("subjects.o levels:", df["subjects.o"].value_counts(dropna=False).to_dict())
log("subjects.r levels:", df["subjects.r"].value_counts(dropna=False).to_dict())
log("")

# ---------------------------------------------------------------- unit (i) lab-level
lab = df.groupby("discipline").apply(lambda g: pd.Series({
    "n_records": len(g),
    "orig_students_n": int((g["subjects.o"] == "students").sum()),
    "orig_students_pct": (g["subjects.o"] == "students").mean() * 100,
    "repl_students_n": int((g["subjects.r"] == "students").sum()),
    "repl_students_pct": (g["subjects.r"] == "students").mean() * 100,
}), include_groups=False)

# ---------------------------------------------------------------- unit (ii) study level
first = df.drop_duplicates("id")                       # tie rule: first row per id
per_id = df.groupby("id").apply(lambda g: pd.Series({
    "discipline": g["discipline"].iloc[0],
    "subjects_o": g["subjects.o"].iloc[0],             # never varies within an id
    "repl_students_ANY": (g["subjects.r"] == "students").any(),
    "repl_students_ALL": (g["subjects.r"] == "students").all(),
    "repl_students_MAJ": (g["subjects.r"] == "students").mean() >= 0.5,
    "repl_students_FIRST": g["subjects.r"].iloc[0] == "students",
}), include_groups=False)


def study_table(rule_col):
    t = per_id.copy()
    t["is_student_r"] = t[rule_col]
    t["is_student_o"] = t["subjects_o"] == "students"
    return t.groupby("discipline").apply(lambda g: pd.Series({
        "n_studies": len(g),
        "orig_students_n": int(g["is_student_o"].sum()),
        "orig_students_pct": g["is_student_o"].mean() * 100,
        "repl_students_n": int(g["is_student_r"].sum()),
        "repl_students_pct": g["is_student_r"].mean() * 100,
    }), include_groups=False)


study = study_table("repl_students_FIRST")

log("== UNIT (i) LAB-LEVEL RECORDS (n = 927 rows)")
log(lab.round(2).to_string())
log("")
log("== UNIT (ii) UNIQUE ORIGINAL STUDIES (n = 141 ids; replication tie rule = first row per id)")
log(study.round(2).to_string())
log("")

# ------------------------------------------------------------- replication tie-rule check
varying = (df.groupby("id")["subjects.r"].nunique() > 1)
vid = varying[varying].index
log("ids where subjects.r varies across labs: %d (all project = ml1: %s)"
    % (len(vid), sorted(set(df.loc[df["id"].isin(vid), "project"]))))
for rule in ["repl_students_FIRST", "repl_students_MAJ", "repl_students_ANY", "repl_students_ALL"]:
    t = study_table(rule)
    log("  tie rule %-20s -> Social repl %.2f%% (%d/%d) | Cognitive %.2f%% | Economics %.2f%%"
        % (rule, t.loc["Social", "repl_students_pct"], t.loc["Social", "repl_students_n"],
           t.loc["Social", "n_studies"], t.loc["Cognitive", "repl_students_pct"],
           t.loc["Economics", "repl_students_pct"]))
log("  (all 16 varying ids are ml1 studies where 27/37 labs used students, so first =="
    " majority == any-lab; only the all-labs rule differs)")
log("")

# --------------------------------------------------------------------- candidate ranking
def pct(d, key):
    rows = []
    for name, g in d.groupby(key):
        o = (g["subjects.o"] == "students").mean() * 100
        r = (g["subjects.r"] == "students").mean() * 100
        rows.append({"grouping": key, "value": name, "n": len(g), "orig_pct": o, "repl_pct": r,
                     "abs_gap": abs(o - TARGET_O) + abs(r - TARGET_R)})
    return pd.DataFrame(rows).sort_values("abs_gap")


cand = pd.concat([pct(df, "discipline"), pct(df, "project"),
                  pct(df.drop_duplicates("id"), "discipline"), pct(df.drop_duplicates("id"), "project")])
log("== CANDIDATE RANKING vs quoted pair (%.1f%% / %.1f%%), smallest gap first" % (TARGET_O, TARGET_R))
log(cand.round(2).to_string(index=False))
log("")

# ------------------------------------------------------------------ sensitivity (caveat)
sens = []
for label, d in [("headline: all rows", df),
                 ("drop==True removed", df[df["drop"] == False]),
                 ("aggregated==True removed", df[df["aggregated"] != True]),
                 ("complete-case core", df.loc[df[CORE].notna().all(axis=1)])]:
    for unit, dd in [("lab rows", d), ("studies", d.drop_duplicates("id"))]:
        g = dd[dd["discipline"] == "Social"]
        sens.append({"filter": label, "unit": unit, "n": len(g),
                     "orig_pct": (g["subjects.o"] == "students").mean() * 100,
                     "repl_pct": (g["subjects.r"] == "students").mean() * 100})
sens = pd.DataFrame(sens)
log("== SENSITIVITY / CAVEAT (Social discipline only; headline figures are row 1 of each unit)")
log(sens.round(2).to_string(index=False))
log("")

# ------------------------------------------------------------------------- final numbers
so, sr = study.loc["Social", ["orig_students_pct", "repl_students_pct"]]
lo, lr = lab.loc["Social", ["orig_students_pct", "repl_students_pct"]]
log("== HEADLINE (study level, discipline == Social): %.1f%% original (%d/%d), %.1f%% replication (%d/%d)"
    % (so, study.loc["Social", "orig_students_n"], study.loc["Social", "n_studies"],
       sr, study.loc["Social", "repl_students_n"], study.loc["Social", "n_studies"]))
log("   residual gap vs quoted 82.4 / 80.9: %+.1f pts original, %+.1f pts replication"
    % (so - TARGET_O, sr - TARGET_R))
log("== ALTERNATIVE READING (lab-level rows, Social): %.1f%% original (%d/%d), %.1f%% replication (%d/%d)"
    % (lo, lab.loc["Social", "orig_students_n"], lab.loc["Social", "n_records"],
       lr, lab.loc["Social", "repl_students_n"], lab.loc["Social", "n_records"]))
log("   residual gap vs quoted: %+.1f pts original, %+.1f pts replication" % (lo - TARGET_O, lr - TARGET_R))
log("== RUNNER-UP groupings: %s" % cand.head(4)[["grouping", "value", "orig_pct", "repl_pct", "abs_gap"]]
    .round(2).to_dict("records"))

# ------------------------------------------------------------------------ deliverables
lab_out = lab.round(2); lab_out.columns = [c + "_lablevel" for c in lab_out.columns]
st_out = study.round(2); st_out.columns = [c + "_studylevel" for c in st_out.columns]
table = pd.concat([lab_out, st_out], axis=1)
table["orig_gap_lablevel"] = (table["orig_students_pct_lablevel"] - TARGET_O).round(2)
table["repl_gap_lablevel"] = (table["repl_students_pct_lablevel"] - TARGET_R).round(2)
table["orig_gap_studylevel"] = (table["orig_students_pct_studylevel"] - TARGET_O).round(2)
table["repl_gap_studylevel"] = (table["repl_students_pct_studylevel"] - TARGET_R).round(2)
table.to_csv("analysis/results_by_discipline.csv")
cand.round(2).to_csv("analysis/candidate_ranking.csv", index=False)
sens.round(2).to_csv("analysis/sensitivity_social.csv", index=False)
with open("analysis/analysis_log.txt", "w") as f:
    f.write("\n".join(out_lines) + "\n")
log("\nwrote analysis/results_by_discipline.csv, analysis/candidate_ranking.csv,"
    " analysis/sensitivity_social.csv, analysis/analysis_log.txt")
print("\n== results_by_discipline.csv ==")
print(table.to_string())
