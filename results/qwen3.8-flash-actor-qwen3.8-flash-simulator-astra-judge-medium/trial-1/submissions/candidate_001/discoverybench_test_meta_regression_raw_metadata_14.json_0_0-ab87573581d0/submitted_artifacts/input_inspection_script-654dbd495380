"""Input inspection for the 'student subjects by domain' question.

Computes, for each candidate 'domain' grouping variable, the share of rows whose
original studies used student subjects (subjects.o == 'students') and the share
whose replications did (subjects.r == 'students'), under several plausible
row-selection conventions.
"""
import re
import pandas as pd

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
SUCC = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(STUDY)
d2 = pd.read_csv(SUCC)
df["aggT"] = df["aggregated"] == True

print("study file:", df.shape, " unique ids:", df["id"].nunique())
print("success file:", d2.shape, " unique studies:", d2["study"].nunique())
print("has subjects cols in success file:", [c for c in d2.columns if "subj" in c])
print("success-file 'project' values:\n", d2["project"].value_counts(), "\n")

def table(d, key):
    return d.groupby(key).apply(
        lambda g: pd.Series(
            {
                "n_rows": len(g),
                "n_ids": g["id"].nunique(),
                "orig_students_n": int((g["subjects.o"] == "students").sum()),
                "orig_pct": round((g["subjects.o"] == "students").mean() * 100, 2),
                "repl_students_n": int((g["subjects.r"] == "students").sum()),
                "repl_pct": round((g["subjects.r"] == "students").mean() * 100, 2),
            }
        ),
        include_groups=False,
    )

sets = {
    "all rows": df,
    "drop==False": df[df["drop"] == False],
    "not aggregated": df[~df["aggT"]],
    "unique original studies (dedup by id)": df.drop_duplicates("id"),
    "unique studies & drop==False": df[df["drop"] == False].drop_duplicates("id"),
}
for name, d in sets.items():
    for key in ["discipline", "project"]:
        print("==", name, "| group by", key)
        print(table(d, key).to_string(), "\n")

print("OVERALL row-level: orig %.2f  repl %.2f"
      % ((df["subjects.o"] == "students").mean() * 100, (df["subjects.r"] == "students").mean() * 100))
u = df.drop_duplicates("id")
print("OVERALL study-level: orig %.2f  repl %.2f"
      % ((u["subjects.o"] == "students").mean() * 100, (u["subjects.r"] == "students").mean() * 100))

# identifier overlap between the two files (first-author surname)
def first_surname(a):
    a = str(a).split(" and ")[0].strip()
    return re.sub(r"[^a-z]", "", a.split(" ")[-1].lower()) if a else ""
u2 = u.assign(fs=u["authors.o"].map(first_surname))
m = d2.assign(fs=d2["study"].map(first_surname)).merge(
    u2[["id", "fs", "discipline", "project", "subjects.o", "subjects.r"]], on="fs", how="left", suffixes=("_s2", "_s1"))
print("\nsuccess-file rows whose first-author surname appears in study file:",
      int(m["id"].notna().sum()), "of", len(m))
print(m.groupby("project_s2")["id"].apply(lambda x: f"{x.notna().sum()}/{len(x)}").to_string())
