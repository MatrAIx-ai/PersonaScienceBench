import pandas as pd
pd.set_option('display.width', 200)

study = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
succ  = pd.read_csv('/workspace/data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')

print("=== FILE 1: study_data ===")
print("rows, cols:", study.shape)
print("\n-- project value counts (all rows) --")
print(study['project'].value_counts(dropna=False))

ee = study[study['project'] == 'ee']
print("\n-- ee rows:", len(ee))
print("-- ee unique ids:", ee['id'].nunique())
print("-- ee unique titles:", ee['title'].nunique())

# study identifier candidates in file 1: id, title (no 'study' col)
print("\n-- columns containing 'countr' or 'study' in file1 --")
print([c for c in study.columns if 'countr' in c.lower() or 'study' in c.lower()])

print("\n-- experiment_country.o ALL distinct values in FULL dataset (with counts) --")
print(study['experiment_country.o'].value_counts(dropna=False).to_string())

print("\n-- experiment_country.o distinct values within ee (raw spellings) --")
vc = ee['experiment_country.o'].value_counts(dropna=False)
print(vc.to_string())

print("\n-- experiment_country.r distinct values within ee --")
print(ee['experiment_country.r'].value_counts(dropna=False).to_string())

print("\n-- missingness --")
print("ee rows with NaN experiment_country.o:", ee['experiment_country.o'].isna().sum())
print("ee rows with blank/whitespace-only country.o:",
      ee['experiment_country.o'].dropna().astype(str).str.strip().eq('').sum())
blank_ee_countries = ee['experiment_country.o'].dropna().astype(str).str.strip().eq('').sum()
known = len(ee) - ee['experiment_country.o'].isna().sum() - blank_ee_countries
print("ee rows with a non-empty country.o:", known)

print("\n-- duplicates: rows per (id) / per (title) within ee --")
print("max rows per id:", ee.groupby('id').size().max(), "| distribution:")
print(ee.groupby('id').size().value_counts().to_string())
print("max rows per title:", ee.groupby('title').size().max(), "| distribution:")
print(ee.groupby('title').size().value_counts().to_string())
print("unique titles per id (should be 1):", ee.groupby('id')['title'].nunique().max())
print("unique ids per title:", ee.groupby('title')['id'].nunique().max())

# also authors.o + pub_year as original-study fingerprint
ee2 = ee.copy()
ee2['fp'] = ee2['title'].astype(str).str.lower().str.strip() + '|' + ee2['authors.o'].astype(str).str.lower().str.strip() + '|' + ee2['pub_year'].astype(str)
print("unique fingerprints (title+authors+year) in ee:", ee2['fp'].nunique())
print("unique titles among ee:", ee['title'].str.strip().str.lower().nunique())

print("\n-- within-ee: country.o consistency across rows of same title --")
g = ee.dropna(subset=['experiment_country.o']).groupby('title')['experiment_country.o'].nunique()
print("titles with >1 distinct country.o:", (g > 1).sum(), "of", len(g))

print("\n-- aggregated / drop columns for ee --")
for c in ['aggregated', 'drop']:
    if c in ee.columns:
        print(c, ee[c].value_counts(dropna=False).to_dict())

print("\n=== FILE 2: replication_success_data ===")
print("rows, cols:", succ.shape)
print("columns:", list(succ.columns))
print("country-like columns:", [c for c in succ.columns if 'countr' in c.lower()])
print("\n-- project value counts --")
print(succ['project'].value_counts(dropna=False))
print("\n-- ee rows in file2:", (succ['project'] == 'ee').sum())
ee_s = succ[succ['project'] == 'ee']
print("unique 'study' values in ee (file2):", ee_s['study'].nunique())
print("sample ee study ids:", ee_s['study'].head(30).tolist())
print("\n-- overlap of ee titles(file1) vs study(file2) (exact string match) --")
t1 = set(ee['title'].astype(str).str.strip().str.lower())
s2 = set(ee_s['study'].astype(str).str.strip().str.lower())
print("file1 ee unique titles:", len(t1), "file2 ee unique study:", len(s2), "exact intersections:", len(t1 & s2))
print("\n-- duplicated rows per study in file2 (ee) --")
print(ee_s.groupby('study').size().value_counts().to_string())
