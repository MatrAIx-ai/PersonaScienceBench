import pandas as pd
study = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
succ  = pd.read_csv('/workspace/data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')
ee = study[study['project']=='ee']
ee_s = succ[succ['project']=='Experimental Economics']

print("== file2 'Experimental Economics' study labels (n=%d, unique=%d) ==" % (len(ee_s), ee_s['study'].nunique()))
print(ee_s['study'].tolist())

print("\n== file1 ee: id, title, authors.o, pub_year, journal, country.o ==")
print(ee[['id','title','authors.o','pub_year','journal','experiment_country.o','drop','aggregated']].to_string(index=False))

# try fuzzy link: does any file2 study label appear inside file1 ee titles/authors?
print("\n== token-overlap check file2 label vs file1 ee title+authors ==")
for lab in ee_s['study'].astype(str):
    key = lab.lower()
    hits = ee[ee['title'].str.lower().str.contains(key.split()[0], na=False) | ee['authors.o'].astype(str).str.lower().str.contains(key.split()[0], na=False)]
    print(f"{lab!r:40s} -> {len(hits)} candidate rows in file1 ee")

# cross-project / global duplicate originals in file1
print("\n== global file1 duplicates by title ==")
dup = study['title'].str.strip().str.lower().value_counts()
print("titles appearing >1 times overall:", (dup>1).sum(), "| max repeats:", dup.max())
print(dup[dup>1].head(10).to_string())
print("\n-- do repeated titles cross projects? --")
rep_titles = dup[dup>1].index
sub = study[study['title'].str.strip().str.lower().isin(rep_titles)]
print(sub.groupby(sub['title'].str.strip().str.lower())['project'].nunique().value_counts().to_string())
print("\n-- country.o missing overall:", study['experiment_country.o'].isna().sum(), "of", len(study))
print("-- rows where drop==True overall:", int(study['drop'].sum()) if study['drop'].dtype!=object else study['drop'].value_counts().to_dict())
print("-- ee drop values:", ee['drop'].value_counts(dropna=False).to_dict())
print("\n-- ee: does 'same_country' or us_lab hint anything? --")
print(ee[['id','same_country','us_lab.o','experiment_language.o','subjects.o']].to_string(index=False))
