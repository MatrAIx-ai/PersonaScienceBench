"""
Main analysis: proportion of ORIGINAL studies in Experimental Economics (project == 'ee')
that were conducted in the United Kingdom.
Approved method:
  - unit of analysis = unique original paper, fingerprint = title + authors.o + pub_year
  - denominator = ALL ee unique original studies (no exclusions)
  - country = experiment_country.o ONLY (never .r / same_country / us_lab.o)
  - UK match = case- & whitespace-normalised membership in an explicit variant set
No meta-regression, no models, no external data.
"""
import re
import pandas as pd

F1 = '/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
F2 = '/workspace/data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

UK_CORE = {'united kingdom'}
UK_EXPANDED = {'united kingdom', 'uk', 'u.k.', 'great britain', 'britain', 'england',
               'united kingdom (great britain)', 'gb', 'wales', 'scotland', 'northern ireland'}

def norm(s):
    return re.sub(r'\s+', ' ', str(s)).strip().lower()

def fingerprint(df):
    return (df['title'].map(norm) + '|' + df['authors.o'].astype(str).map(norm)
            + '|' + df['pub_year'].astype(str))

def is_uk(series, variants):
    n = series.map(norm)
    return n.isin(variants)

study = pd.read_csv(F1)
succ = pd.read_csv(F2)

print('=' * 78)
print('STEP 0  file shapes:', study.shape, succ.shape)

# ---------- STEP 1  filter + unique original papers ----------
ee = study[study['project'] == 'ee'].copy()
ee['fp'] = fingerprint(ee)
print('\nSTEP 1  filter project=="ee"')
print('  ee rows (O/R pairs)              :', len(ee))
print('  unique fingerprints (orig papers):', ee['fp'].nunique())
print('  unique ids                       :', ee['id'].nunique())
print('  unique titles                    :', ee['title'].map(norm).nunique())

ee_u = ee.drop_duplicates(subset=['fp'], keep='first').copy()
print('  rows after dedup on fingerprint  :', len(ee_u), '  <- DENOMINATOR')
print('  rows removed by dedup            :', len(ee) - len(ee_u))

# ---------- STEP 2  country known-ness ----------
country = ee_u['experiment_country.o']
n_na = int(country.isna().sum())
n_blank = int(country.notna().map(lambda x: norm(x) in ('', 'nan', 'none')).sum())
known_mask = country.notna() & ~country.map(lambda x: norm(x) in ('', 'nan', 'none'))
n_known = int(known_mask.sum())
print('\nSTEP 2  experiment_country.o completeness on the 18 unique ee studies')
print('  missing (NaN) :', n_na, '| blank/whitespace-only :', n_blank)
print('  known-country denominator :', n_known, '(primary denominator = %d)  -> equality %s'
      % (len(ee_u), n_known == len(ee_u)))

# ---------- STEP 3  MAIN estimate ----------
uk_mask = is_uk(country, UK_EXPANDED)          # approved variant list (normalised)
num = int(uk_mask.sum())
den = len(ee_u)
print('\n' + '=' * 78)
print('STEP 3  MAIN RESULT (approved specification)')
print('  NUMERATOR   (UK original studies) : %d' % num)
print('  DENOMINATOR (ee unique orig studies): %d' % den)
print('  proportion  = %d/%d = %.6f  = %.4f%%   (~%.1f%%)' % (num, den, num / den, 100 * num / den, 100 * num / den))
print('  complement  = %d/%d = %.4f%% not-UK' % (den - num, den, 100 * (den - num) / den))
print('  one study  = %.4f percentage points' % (100 / den))

print('\n  UK study detail:')
cols = ['id', 'title', 'authors.o', 'pub_year', 'journal', 'experiment_country.o']
uk_rows = ee_u[uk_mask][cols]
for _, r in uk_rows.iterrows():
    print('   id=%s | %s | %s (%s) | journal=%s | recorded country=%r'
          % (r['id'], r['title'], r['authors.o'], r['pub_year'], r['journal'], r['experiment_country.o']))
print('  n UK rows listed:', len(uk_rows))

# ---------- STEP 4  country distribution ----------
print('\n' + '=' * 78)
print('STEP 4  country distribution of the %d unique ee original studies (experiment_country.o)' % den)
dist = ee_u['experiment_country.o'].fillna('(missing)').value_counts(dropna=False)
for k, v in dist.items():
    flag = '  <== UK' if norm(k) in UK_EXPANDED else ''
    print('  %-16s %2d  %6.2f%%%s' % (k, v, 100 * v / den, flag))
print('  %-16s %2d  %6.2f%%' % ('TOTAL', int(dist.sum()), 100 * dist.sum() / den))
print('  check: unique studies =', den, '| sum of counts =', int(dist.sum()),
      '| known-country denominator =', n_known, '=> identical:', int(dist.sum()) == den == n_known)

# ---------- STEP 5  sensitivity (computed, not assumed) ----------
print('\n' + '=' * 78)
print('STEP 5  SENSITIVITY  (all computed on real data)')

def prop(num, den):
    return 'nan' if den == 0 else '%d/%d = %.4f (%.2f%%)' % (num, den, num / den, 100 * num / den)

base_num, base_den = num, den
base = num / den
rows = []

# S0 baseline
rows.append(('S0 baseline (approved): unique studies, all ee, .o, expanded UK list',
             prop(base_num, base_den), '0.00 pp'))

# S1 rows instead of unique studies
uk_rows_all = int(is_uk(ee['experiment_country.o'], UK_EXPANDED).sum())
s1 = uk_rows_all / len(ee)
rows.append(('S1 unit = O/R rows (no dedup on fingerprint)',
             prop(uk_rows_all, len(ee)), '%+.2f pp' % (100 * (s1 - base))))

# S2 drop missing-country rows from denominator
s2num = int(is_uk(ee_u.loc[known_mask, 'experiment_country.o'], UK_EXPANDED).sum())
s2 = s2num / int(known_mask.sum())
rows.append(('S2 denominator = known-country only (%d rows)' % int(known_mask.sum()),
             prop(s2num, int(known_mask.sum())), '%+.2f pp' % (100 * (s2 - base))))

# S3 exclude drop == True
drop_true_ee = int((ee['drop'] == True).sum())
ee_nd = ee_u[~(ee_u['drop'] == True)]
s3num = int(is_uk(ee_nd['experiment_country.o'], UK_EXPANDED).sum())
s3 = s3num / len(ee_nd)
rows.append(('S3 exclude drop==True (drop==True rows in ee = %d)' % drop_true_ee,
             prop(s3num, len(ee_nd)), '%+.2f pp' % (100 * (s3 - base))))

# S4 narrow UK list ('United Kingdom' only)
s4num = int(is_uk(ee_u['experiment_country.o'], UK_CORE).sum())
s4 = s4num / den
rows.append(('S4 narrow UK list = {"united kingdom"} only',
             prop(s4num, den), '%+.2f pp' % (100 * (s4 - base))))

# S5 extra British variants beyond 'united kingdom' actually present?
extra_present = sorted({norm(v) for v in ee_u['experiment_country.o'].dropna()} & (UK_EXPANDED - UK_CORE))
rows.append(('S5 extra UK variants matched beyond "united kingdom": %s' % (extra_present if extra_present else 'NONE in data'),
             prop(s4num, den), '%+.2f pp' % (100 * (s4 - base))))

# REJECTED variant A: replication country
rn = int(is_uk(ee_u['experiment_country.r'], UK_EXPANDED).sum())
rows.append(('REJECTED-A: country := experiment_country.r (replication site) - NOT used',
             prop(rn, den), '%+.2f pp' % (100 * (rn / den - base))))

# REJECTED variant B: same_country flag
sc = pd.to_numeric(ee_u['same_country'], errors='coerce')
bn = int((sc == 1).sum())
rows.append(('REJECTED-B: proxy := same_country==1 (orig==replication country) - NOT used',
             prop(bn, den), '%+.2f pp' % (100 * (bn / den - base))))

for name, val, delta in rows:
    print('  %-78s %-28s %s' % (name, val, delta))
print('  NOTE: max absolute deviation among ACCEPTED variants S1-S5 = %.2f pp'
      % max(abs(100 * (x - base)) for x in [s1, s2, s3, s4]))

# ---------- STEP 6  file-2 cohort cross-check ----------
print('\n' + '=' * 78)
print('STEP 6  CROSS-CHECK vs file 2 (replication_success_data)')
s2df = succ[succ['project'] == 'Experimental Economics'].copy()
print('  file2 rows with project=="Experimental Economics" :', len(s2df),
      '| unique study labels:', s2df['study'].nunique())
print('  file1 rows with project=="ee"                     :', len(ee),
      '| unique original papers:', den)

def parse_label(lab):
    m = re.match(r'^(.*?)\s*\((.*?)\s*(\d{4})\)\s*$', str(lab))
    if not m:
        return None
    authors = m.group(1).strip()
    first = re.split(r'\s+(?:and|et al\.?)\s*', authors)[0].strip().lower()
    return first, m.group(3)

matches, mismatches = [], []
used = set()
for lab in s2df['study']:
    p = parse_label(lab)
    if p is None:
        mismatches.append((lab, 'unparsable label'))
        continue
    first_surname, year = p
    cand = ee_u[(ee_u['authors.o'].astype(str).str.lower().str.contains(re.escape(first_surname)))
                & (ee_u['pub_year'].astype(str) == year)]
    if len(cand) == 1:
        r = cand.iloc[0]
        used.add(r['id'])
        matches.append((lab, r['id'], norm(r['title'])[:52], norm(r['experiment_country.o'])))
    else:
        mismatches.append((lab, 'candidates=%d (%s)' % (len(cand), ','.join(cand['id']))))

for lab, rid, t, c in matches:
    print('   %-34s -> %-6s | %-52s | %s' % (lab, rid, t, c))
print('  bijection: file2 labels matched 1:1 = %d/%d | file1 ee studies claimed = %d/%d'
      % (len(matches), len(s2df), len(used), den))
print('  unmatched file1 ee ids:', sorted(set(ee_u['id']) - used) or 'NONE')
print('  MISMATCHES:', mismatches or 'NONE')
print('  file2 has country column? ->', [c for c in succ.columns if 'countr' in c.lower()] or 'NONE (country only in file 1)')

# UK studies corroborated by file2 labels
uk_ids = list(uk_rows['id'])
print('  UK study id(s) %s present in file2 mapping: %s'
      % (uk_ids, [lab for lab, rid, _, _ in matches if rid in uk_ids]))

# ---------- STEP 7  final numbers for the hypothesis ----------
print('\n' + '=' * 78)
print('STEP 7  FINAL NUMBERS')
print('  %d of %d unique original studies in Experimental Economics recorded United Kingdom'
      % (num, den))
print('  proportion = %.6f ; percent = %.4f%% ; 1 study = %.4f pp' % (base, 100 * base, 100 / den))
