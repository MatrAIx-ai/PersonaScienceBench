"""
Compute the proportion of Experimental Economics (project == "ee") ORIGINAL studies
conducted in a lab / in-person setting.
Primary definition (approved): lab setting == non-online original session, online.o == 0.
Descriptive only: no meta-regression, no effect-size modelling, no inference tests.
No `drop` filter applied (all ee rows are drop == False).
"""
import pandas as pd
pd.set_option('display.width', 220)

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
REPSU = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(STUDY)
ee = df[df['project'] == 'ee'].copy()

# --- unit of analysis check -------------------------------------------------
n_pairs = len(ee)
n_ids   = ee['id'].nunique()
n_titles = ee['title'].nunique()
print("== UNIT OF ANALYSIS ==")
print(f"ee rows (O/R pairs)          : {n_pairs}")
print(f"ee distinct ids              : {n_ids}")
print(f"ee distinct titles           : {n_titles}")
print(f"exact duplicate rows         : {ee.duplicated().sum()}")
print(f"per-study == per-pair        : {n_pairs == n_ids}")
DEN = n_ids
print(f"DENOMINATOR (distinct original studies) = {DEN}\n")

# --- missing data in the operative variable --------------------------------
print("== NA HANDLING (operative variable online.o) ==")
na = int(ee['online.o'].isna().sum())
print(f"NA in online.o: {na}  -> available denominator = {DEN - na} (unchanged, no exclusions needed)")
print(f"distinct online.o values in ee: {sorted(ee['online.o'].dropna().unique().tolist())}  (variance = {ee['online.o'].nunique()})\n")

# --- headline ---------------------------------------------------------------
num = int((ee['online.o'] == 0).sum())
print("== HEADLINE (primary definition: online.o == 0 == in-person/lab) ==")
print(f"numerator = {num}   denominator = {DEN}")
print(f"proportion = {num}/{DEN} = {num/DEN:.4f} = {100*num/DEN:.1f}%")
print("BOUNDARY (ceiling) VALUE: online.o is constant at 0 across all ee rows.\n")

# --- sensitivity ladder -----------------------------------------------------
defs = [
    ("S1 PRIMARY  lab = in-person/non-online  [online.o == 0]", (ee['online.o'] == 0)),
    ("S2          lab = in-person AND student pool  [online.o == 0 & subjects.o == 'students']",
     (ee['online.o'] == 0) & (ee['subjects.o'] == 'students')),
    ("S3          student subject pool only  [subjects.o == 'students']", (ee['subjects.o'] == 'students')),
    ("S4  SENSITIVITY (US-location flag, NOT lab indicator)  [us_lab.o == 1]", (ee['us_lab.o'] == 1)),
]
print("== SENSITIVITY LADDER ==")
for label, mask in defs:
    n = int(mask.sum())
    print(f"{label}\n    -> {n}/{DEN} = {n/DEN:.4f} = {100*n/DEN:.2f}%")

# the single row that moves the student-pool variants
nonstud = ee[ee['subjects.o'] != 'students']
print("\n== ROW THAT MOVES THE STUDENT-POOL VARIANTS TO 17/18 ==")
print(nonstud[['id', 'title', 'subjects.o', 'online.o', 'compensation.o',
               'us_lab.o', 'experiment_country.o']].to_string(index=False))
print(f"  subjects.o = {nonstud['subjects.o'].iloc[0]}; online.o = {nonstud['online.o'].iloc[0]} "
      f"(=> still an offline/in-person session); us_lab.o = {nonstud['us_lab.o'].iloc[0]}")

# --- descriptive block ------------------------------------------------------
print("\n== DESCRIPTIVE BLOCK: ee ORIGINAL STUDIES ==")
print(f"project coding        : 'ee' = Experimental Economics (replication project); "
      f"discipline values present: {sorted(ee['discipline'].unique().tolist())}")
print(f"n studies             : {DEN}")
print("\nsubjects.o mix:")
print(ee['subjects.o'].value_counts(dropna=False).to_string())
print("\ncompensation.o mix (corroborates paid in-person lab sessions):")
print(ee['compensation.o'].value_counts(dropna=False).to_string())
print("\nexperiment_country.o distribution (originals):")
print(ee['experiment_country.o'].value_counts(dropna=False).to_string())
print("\nreplication-side setting fields:")
print(ee['online.r'].value_counts(dropna=False).rename('online.r').to_string())
print(ee['same_online'].value_counts(dropna=False).rename('same_online').to_string())
print("  same_online == 1 for all 18: original and replication share the same (offline) modality.")
print("\nus_lab.o (US-location flag; collinear with experiment_country.o == 'United States'):")
print(ee['us_lab.o'].value_counts(dropna=False).to_string())
print("  US-country rows:", int((ee['experiment_country.o'] == 'United States').sum()),
      "| us_lab.o == 1 rows:", int((ee['us_lab.o'] == 1).sum()),
      "| exact agreement:", bool(((ee['experiment_country.o'] == 'United States') == (ee['us_lab.o'] == 1)).all()))
print("\nlab_id (dropped from analysis): non-NA in ee =", int(ee['lab_id'].notna().sum()), "of", DEN)
print("drop filter (not applied) values:", ee['drop'].unique().tolist(),
      "| aggregated values:", ee['aggregated'].unique().tolist())

# --- second dataset: one-line confirmation ----------------------------------
d2 = pd.read_csv(REPSU)
kw = [c for c in d2.columns if any(k in c.lower() for k in
      ['lab', 'online', 'subject', 'country', 'setting', 'compens', 'site', 'univ'])]
n_ee2 = int((d2['project'] == 'Experimental Economics').sum())
print("\n== SECOND DATASET (replication-success) : confirmation only ==")
print(f"columns = {list(d2.columns)}")
print(f"setting/lab-like columns found: {kw}  -> none, so it is NOT used in the analysis.")
print(f"Its 'Experimental Economics' row count ({n_ee2}) agrees with the {DEN} studies above (one sentence: same studies, no setting fields).")

# --- machine-readable summary ----------------------------------------------
import json
summary = {
    "primary_definition": "online.o == 0 (in-person / non-online original session)",
    "filter": "project == 'ee'",
    "denominator_studies": DEN,
    "denominator_pairs": n_pairs,
    "numerator_primary": num,
    "proportion_primary": num / DEN,
    "percent_primary": 100 * num / DEN,
    "online_o_constant_at_zero": bool(ee['online.o'].nunique() == 1 and (ee['online.o'] == 0).all()),
    "sensitivity": {lbl.split()[0]: [int(m.sum()), DEN] for lbl, m in defs},
}
with open("analysis/lab_setting_summary.json", "w") as f:
    json.dump(summary, f, indent=2)
print("\nWrote analysis/lab_setting_summary.json")
