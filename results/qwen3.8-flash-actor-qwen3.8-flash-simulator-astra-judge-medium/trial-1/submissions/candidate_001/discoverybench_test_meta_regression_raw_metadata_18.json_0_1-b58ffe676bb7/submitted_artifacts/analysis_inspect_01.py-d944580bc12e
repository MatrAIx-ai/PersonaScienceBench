import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 100)

S = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
R = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(S)
print("STEP 1 -- STUDY-LEVEL DATASET")
print("shape:", df.shape)
print("n columns:", len(df.columns))
print("columns:", list(df.columns))
asked = ['project','online.o','online.r','subjects.o','experiment_country.o','us_lab.o','lab_id']
print("\nPresence of asked columns:")
for c in asked:
    print(f"  {c:24s} present={c in df.columns}  dtype={df[c].dtype if c in df.columns else 'NA'}")

print("\nduplicate check on 'id':", df['id'].duplicated().sum(), "dup ids;",
      "full-row dups:", df.duplicated().sum())

print("\nproject value counts (all rows):")
print(df['project'].value_counts(dropna=False))

print("\ndtypes of project-based id prefixes (first token of id):")
print(df['id'].astype(str).str.extract(r'^([a-zA-Z0-9]+)\.')[0].value_counts(dropna=False))

print("\nSTEP 2 -- 'ee' SUBSET")
ee = df[df['project'] == 'ee'].copy()
print("rows (O/R pairs) with project=='ee':", len(ee))
print("unique id:", ee['id'].nunique(), " unique title:", ee['title'].nunique(),
      " unique authors.o:", ee['authors.o'].nunique())
print("full-row duplicates within ee:", ee.duplicated().sum())
print("duplicated ids within ee:", ee['id'].duplicated().sum())
# how many ee rows flagged drop / aggregated
for c in ['drop','aggregated']:
    if c in ee.columns:
        print(f"\nee[{c}] value counts:\n", ee[c].value_counts(dropna=False))
print("\nee id examples:", ee['id'].head(10).tolist(), "...", ee['id'].tail(5).tolist())

print("\nSTEP 3 -- COMPLETENESS OF SETTING-RELATED FIELDS (ee subset)")
fields = ['online.o','online.r','subjects.o','subjects.r','compensation.o','compensation.r',
          'us_lab.o','us_lab.r','lab_id','experiment_country.o','same_online','same_subjects']
rows=[]
for c in fields:
    if c not in ee.columns:
        rows.append((c, 'MISSING COLUMN', '', '', '')); continue
    s = ee[c]
    n_missing = int(s.isna().sum())
    vc = s.value_counts(dropna=False)
    rows.append((c, len(s), n_missing, round(100*n_missing/len(s),1), s.nunique(dropna=True)))
comp = pd.DataFrame(rows, columns=['field','n_rows','n_NA','pct_NA','n_distinct_nonNA'])
print(comp.to_string(index=False))

print("\nDistinct codings (full):")
for c in ['online.o','online.r','subjects.o','compensation.o','us_lab.o','us_lab.r','same_online','same_subjects']:
    if c in ee.columns:
        print(f"\n-- ee[{c}] --")
        print(ee[c].value_counts(dropna=False).to_string())
if 'lab_id' in ee.columns:
    print("\n-- ee['lab_id'] --  n distinct:", ee['lab_id'].nunique(dropna=True))
    print(ee['lab_id'].value_counts(dropna=False).head(30).to_string())

print("\nCROSSTAB online.o x subjects.o (ee):")
print(pd.crosstab(ee['online.o'], ee['subjects.o'], dropna=False, margins=True))
print("\nCROSSTAB online.o x us_lab.o (ee):")
print(pd.crosstab(ee['online.o'], ee['us_lab.o'], dropna=False, margins=True))
print("\nCROSSTAB subjects.o x us_lab.o (ee):")
print(pd.crosstab(ee['subjects.o'], ee['us_lab.o'], dropna=False, margins=True))
print("\nee experiment_country.o counts:")
print(ee['experiment_country.o'].value_counts(dropna=False).to_string())

# whole dataset for comparison
print("\nWhole-dataset completeness of key fields:")
for c in ['online.o','subjects.o','compensation.o','us_lab.o','lab_id']:
    print(f"  {c:16s} NA={df[c].isna().sum():4d} / {len(df)}  distinct={df[c].nunique(dropna=True)}")

print("\nSTEP 5 -- REPLICATION-SUCCESS DATASET")
d2 = pd.read_csv(R)
print("shape:", d2.shape)
print("columns:", list(d2.columns))
settingish = [c for c in d2.columns if any(k in c.lower() for k in
              ['lab','online','subject','country','setting','compens','site','univ'])]
print("setting/lab-like columns:", settingish)
print("project counts:\n", d2['project'].value_counts(dropna=False))
