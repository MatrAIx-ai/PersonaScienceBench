import pandas as pd, numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 60); pd.set_option('display.max_colwidth', 32)
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
print("unique ids overall:", df['id'].nunique(dropna=False), " rows:", len(df), " NA id:", df['id'].isna().sum())
print("\nrows per id distribution:")
print(df['id'].value_counts().value_counts().rename_axis('rows_per_id').to_frame('n_ids'))
print("\nExample id with many rows:")
top = df['id'].value_counts().index[0]
print("top id:", top, "count:", df['id'].value_counts().iloc[0])
cols = ['id','project','effect_type','effect_size.o','p_value.o','n.o','online.o','subjects.o','us_lab.o','lab_id','aggregated','drop','title']
print(df[df['id']==top][cols].head(8).to_string())
print("\nDo full-row duplicates exist per id? rows that are exact dups of another row:", df.duplicated().sum())
print("dups ignoring index for subset ['id','project','effect_size.o','effect_size.r']:",
      df.duplicated(subset=['id','project','effect_size.o','effect_size.r']).sum())
print("\n'aggregated' col overall:"); print(df['aggregated'].value_counts(dropna=False))
print("\n'drop' col overall:"); print(df['drop'].value_counts(dropna=False))
print("\nlab_id non-NA by project:")
print(df.groupby('project')['lab_id'].apply(lambda s: pd.Series({'n':len(s),'nonNA':s.notna().sum(),'distinct':s.nunique()})))
print("\nonline.o by project:"); print(pd.crosstab(df['project'], df['online.o'], dropna=False, margins=True))
print("\nus_lab.o by project:"); print(pd.crosstab(df['project'], df['us_lab.o'], dropna=False, margins=True))
print("\nsubjects.o by project:"); print(pd.crosstab(df['project'], df['subjects.o'], dropna=False, margins=True))

ee = df[df['project']=='ee']
print("\n===== FULL ee ROWS (setting-relevant) =====")
print(ee[['id','title','pub_year','discipline','experiment_country.o','experiment_language.o',
          'online.o','subjects.o','compensation.o','us_lab.o','lab_id','subjects.r','online.r','us_lab.r','n.o']].to_string())
print("\nee: counts of candidate 'lab' definitions")
print("  online.o==0            :", (ee['online.o']==0).sum(), "/", len(ee), "=", round((ee['online.o']==0).mean(),4))
print("  subjects.o=='students' :", (ee['subjects.o']=='students').sum(), "/", len(ee), "=", round((ee['subjects.o']=='students').mean(),4))
print("  subjects.o in students/community :", (ee['subjects.o'].isin(['students','community'])).sum(), "/", len(ee))
print("  us_lab.o==1            :", (ee['us_lab.o']==1).sum(), "/", len(ee), "=", round((ee['us_lab.o']==1).mean(),4))
print("  not-online AND students:", ((ee['online.o']==0)&(ee['subjects.o']=='students')).sum(), "/", len(ee))
