import numpy as np, pandas as pd
from scipy import stats
raw = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
raw["t_norm"]=raw.title.str.strip().str.lower().str.replace(r"\s+"," ",regex=True)
papers=raw.sort_values("id").groupby("t_norm",as_index=False).agg(project=("project","first"),length=("length","first"))
ee=papers.loc[papers.project=="ee","length"].values; rp=papers.loc[papers.project=="rpp","length"].values
ps=papers.loc[papers.project.isin(["ml1","ml3","rpp"]),"length"].values
for lab,(a,b) in {"ee vs rpp":(ee,rp),"ee vs psych_pooled":(ee,ps)}.items():
    w=stats.ttest_ind(a,b,equal_var=False); u=stats.mannwhitneyu(a,b,alternative="two-sided")
    hs=stats.mannwhitneyu(a,b,alternative="two-sided")
    diffs=np.subtract.outer(a,b).ravel(); hl=np.median(diffs)
    tt=stats.ttest_ind(a,b,equal_var=False)
    print(f"--- {lab} ---")
    print(f"  diff of means = {a.mean()-b.mean():.4f}   ratio of means = {a.mean()/b.mean():.3f}x")
    print(f"  Welch t={w.statistic:.4f} df={w.df:.3f} p={w.pvalue:.3e}")
    print(f"  Mann-Whitney U={u.statistic:.1f} (of max {len(a)*len(b)}) p={u.pvalue:.3e}")
    print(f"  Hodges-Lehmann shift (median of all pairwise ee-rpp diffs) = {hl:.2f} pages")
    print(f"  every ee paper shorter than the longest rpp paper? min ee={a.min()}, max rpp={b.max()}; "
          f"overlap: {np.sum(a[:,None] < b[None,:])}/{a.size*b.size} pairs where rpp > ee")
    tc=stats.t.interval(0.95,len(a)-1,loc=a.mean(),scale=stats.sem(a))
    print(f"  ee t-based 95% CI = [{tc[0]:.2f}, {tc[1]:.2f}]  (bootstrap CI was [24.83, 31.39])")
    tc2=stats.t.interval(0.95,len(b)-1,loc=b.mean(),scale=stats.sem(b))
    print(f"  {'rpp' if lab.endswith('rpp') else 'pooled'} t-based 95% CI = [{tc2[0]:.2f}, {tc2[1]:.2f}]")
print("\nrank-biserial / common-language effect size P(ee paper longer than psych paper) =",
      round(np.mean((ee[:,None] > rp[None,:]).astype(float)),4), "(rpp headline)")
print("pooled psych:", round(np.mean((ps[None,:] < ee[:,None]).astype(float)),4))
print("\nmedian gap:", np.median(ee), "vs", np.median(rp), "=", np.median(ee)-np.median(rp), "pages")
print("ee quartiles:", np.percentile(ee,[25,50,75]), " rpp quartiles:", np.percentile(rp,[25,50,75]))
print("\nsanity: n papers total =", len(papers), "| ee =",len(ee),"| rpp =",len(rp),"| pooled =",len(ps))
