"""FINAL ANALYSIS: average length of original papers, Experimental Economics (ee)
vs Psychology (rpp headline; ml1+ml3+rpp pooled as named alternative).

Approved decisions: (1) Psychology headline = rpp only, pooled ml1+ml3+rpp as named
alternative; (2) de-dup at original-paper level (135), id-level (141) as robustness;
(3) keep 1-3 page brief reports in headline, exclude<=3 / winsorised in sensitivity;
(4) headline uses all rows, drop==FALSE as robustness row.
Bootstrap: paper-level resampling, B=10000, seed=20261022, percentile CI.
"""
import numpy as np, pandas as pd
from scipy import stats

SEED, B = 20261022, 10000
P1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
key = ["title", "journal", "volume", "issue"]

raw = pd.read_csv(P1)                     # length parses to int64; no coercion needed
raw["drop_flag"] = raw["drop"].astype(str).str.upper().eq("TRUE")

# ---- original-paper identity (heuristic: normalised title + journal + vol + issue) ----
raw["t_norm"] = raw["title"].str.strip().str.lower().str.replace(r"\s+", " ", regex=True)
raw["j_norm"] = raw["journal"].str.strip().str.lower().str.replace(r"\s+", " ", regex=True)
raw["k_paper"] = (raw["t_norm"] + " || " + raw["j_norm"] + " || "
                  + raw["volume"].astype("string").fillna("NA") + " || "
                  + raw["issue"].astype("string").fillna("NA"))
assert raw["k_paper"].nunique() == raw.groupby(key, dropna=False).ngroups == 135
assert raw["t_norm"].nunique() == 135, "title-only key disagrees with paper key"
for c in ["length", "discipline", "project"]:
    assert (raw.groupby("k_paper")[c].nunique() == 1).all(), c + " varies within paper"
print("[check] 135 unique original papers; title-only key == title+journal+vol+issue key;")
print("[check] length / discipline / project constant within every paper group.")

papers = (raw.sort_values("id").groupby("k_paper", as_index=False)
             .agg(project=("project", "first"), discipline=("discipline", "first"),
                  title=("title", "first"), journal=("journal", "first"),
                  length=("length", "first"), n_rows=("id", "size")))
papers["psych_pooled"] = papers["project"].isin(["ml1", "ml3", "rpp"])
ids = (raw.sort_values("id").groupby("id", as_index=False)
          .agg(project=("project", "first"), length=("length", "first")))
assert len(papers) == 135 and len(ids) == 141
PSY = "Psychology pooled (ml1+ml3+rpp, alternative)"

def desc(x):
    x = np.asarray(x, float); q1, q3 = np.percentile(x, [25, 75])
    return dict(n=len(x), mean=x.mean(), median=np.median(x), SD=x.std(ddof=1),
                IQR=q3-q1, q1=q1, q3=q3, min=x.min(), max=x.max(),
                skew=stats.skew(x, bias=False))

def boot_mean_ci(x, B=B, seed=SEED):
    x = np.asarray(x, float); n = len(x)
    rng = np.random.default_rng(seed)
    idx = rng.integers(0, n, size=(B, n))
    reps = x[idx].mean(1)
    return dict(boot_mean=reps.mean(), boot_SE=reps.std(ddof=1),
                ci_lo=np.percentile(reps, 2.5), ci_hi=np.percentile(reps, 97.5),
                distinct=len(np.unique(np.round(reps, 6))),
                degenerate=int((idx.max(1) == idx.min(1)).sum()),
                lo_rep=reps.min(), hi_rep=reps.max())

def cohens_d(a, b):
    a = np.asarray(a, float); b = np.asarray(b, float); na, nb = len(a), len(b)
    sp = np.sqrt(((na-1)*a.var(ddof=1) + (nb-1)*b.var(ddof=1))/(na+nb-2))
    d = (a.mean()-b.mean())/sp
    g = d * (1 - 3/(4*(na+nb)-9))
    se = np.sqrt((na+nb)/(na*nb) + d**2/(2*(na+nb-2)))
    return d, g, (d-1.96*se, d+1.96*se)

def compare(a, b, na, nb):
    a = np.asarray(a, float); b = np.asarray(b, float)
    w = stats.ttest_ind(a, b, equal_var=False)
    u = stats.mannwhitneyu(a, b, alternative="two-sided")
    d, g, dci = cohens_d(a, b)
    rng = np.random.default_rng(SEED+1)
    ra = a[rng.integers(0, len(a), (B, len(a)))].mean(1)
    rb = b[rng.integers(0, len(b), (B, len(b)))].mean(1)
    dd = ra - rb
    return dict(contrast=f"{na} vs {nb}", diff_mean=a.mean()-b.mean(),
                diff_boot_ci=f"[{np.percentile(dd,2.5):.2f}, {np.percentile(dd,97.5):.2f}]",
                boot_p_two_sided=float((dd <= 0).mean()*2),
                welch_t=w.statistic, welch_df=w.df, welch_p=w.pvalue,
                MW_U=u.statistic, MW_p=u.pvalue,
                cohens_d=d, d_ci95=f"[{dci[0]:.2f}, {dci[1]:.2f}]", hedges_g=g)

ee = papers.loc[papers.project.eq("ee"), "length"].values
rp = papers.loc[papers.project.eq("rpp"), "length"].values
ps = papers.loc[papers.psych_pooled, "length"].values

def pvec(p):                       # paper-level length vector for project(s)
    p = p if isinstance(p, list) else [p]
    return papers.loc[papers.project.isin(p), "length"]

def line(lab, x):
    x = np.asarray(x, float); d = desc(x); b = boot_mean_ci(x)
    return dict(group=lab, **{k: d[k] for k in ["n","mean","median","SD","IQR","q1","q3","min","max","skew"]},
                boot_mean=b["boot_mean"], boot_SE=b["boot_SE"], ci_lo=b["ci_lo"], ci_hi=b["ci_hi"],
                distinct_boot_values=b["distinct"], boot_range=f"{b['lo_rep']:.2f}-{b['hi_rep']:.2f}",
                degenerate_reps=b["degenerate"])

print("\n" + "="*118)
print("TABLE 1  HEADLINE -- average page length of ORIGINAL papers (paper-level de-dup, all rows)")
print("="*118)
t1 = pd.DataFrame([line("Experimental Economics (project=ee)", ee),
                   line("Psychology, HEADLINE (project=rpp)", rp),
                   line(PSY, ps)])
cols = ["group","n","mean","median","SD","IQR","q1","q3","min","max","skew"]
print(t1[cols].round(3).to_string(index=False))
print("\nBootstrap 95%% CI on each mean (resample PAPERS with replacement, B=%d, seed=%d, percentile):" % (B, SEED))
print(t1[["group","n","mean","boot_mean","boot_SE","ci_lo","ci_hi","distinct_boot_values","boot_range","degenerate_reps"]].round(3).to_string(index=False))
print("\n[degeneracy check]")
for lab, x in [("ee n=18", ee), ("rpp n=%d" % len(rp), rp), ("pooled n=%d" % len(ps), ps)]:
    b = boot_mean_ci(np.asarray(x, float))
    print(f"  {lab}: replicates where all draws hit a single paper = {b['degenerate']}/{B}; "
          f"distinct replicate means = {b['distinct']}; replicate range {b['lo_rep']:.2f}-{b['hi_rep']:.2f}")

print("\nINFERENCE on the ee-vs-psychology gap:")
inf = pd.DataFrame([compare(ee, rp, "ee", "rpp(headline)"), compare(ee, ps, "ee", "psych_pooled(alt)")])
print(inf.round(4).to_string(index=False))

print("\n" + "="*118)
print("TABLE 2  FULL per-project breakdown + pooled-psychology alternative (auditable by hand)")
print("="*118)
t2 = pd.DataFrame([line("ee  Experimental Economics", pvec("ee")),
                   line("ml1 Many Labs 1", pvec("ml1")),
                   line("ml3 Many Labs 3", pvec("ml3")),
                   line("rpp Reproducibility Project: Psychology", pvec("rpp")),
                   line(PSY, ps)])
print(t2[["group","n","mean","median","SD","IQR","q1","q3","min","max","skew","ci_lo","ci_hi"]].round(3).to_string(index=False))
print("\nJournal mix of the ECONOMICS group (paper level):",
      dict(papers.loc[papers.project.eq("ee"),"journal"].value_counts()))
print("Journal mix of rpp (paper level):")
print(papers.loc[papers.project.eq("rpp"),"journal"].value_counts().to_string())
print("rpp brief-report share (length<=3): %d/%d = %.1f%%" % ((rp<=3).sum(), len(rp), 100*(rp<=3).mean()))

print("\n" + "="*118)
print("TABLE 3  'WRONG BUT DIAGNOSTIC' -- ROW-LEVEL NAIVE MEANS over the 927 original x replication-lab rows.")
print("           NOT the answer: rows are O/R-lab pairs, so multi-lab originals are counted many times.")
print("="*118)
nv = []
for lab, p in [("ee", ["ee"]), ("ml1", ["ml1"]), ("ml3", ["ml3"]), ("rpp", ["rpp"]),
               ("psych pooled (ml1+ml3+rpp)", ["ml1","ml3","rpp"])]:
    rr = raw.loc[raw.project.isin(p)]
    nv.append(dict(group=lab, rows=len(rr), unique_papers=rr.k_paper.nunique(),
                   naive_row_mean=rr.length.mean(), correct_paper_mean=pvec(p).mean(),
                   naive_minus_correct=rr.length.mean()-pvec(p).mean(),
                   ml1_share_of_rows=100*rr.project.eq("ml1").mean()))
print(pd.DataFrame(nv).round(3).to_string(index=False))
_psy_rows = int(raw.project.isin(["ml1","ml3","rpp"]).sum())
_ml1_rows = int(raw.project.eq("ml1").sum())
print("\nWeighting argument: rows give ml1 %d/%d = %.1f%% of pooled-psychology weight vs %.1f%% at paper level;"
      % (_ml1_rows, _psy_rows, 100*_ml1_rows/_psy_rows, 100*12/117))
print("   ml1 averages %.2f pages vs pooled %.2f, so the naive pooled row mean is dragged toward ml1."
      % (pvec("ml1").mean(), ps.mean()))

print("\n" + "="*118)
print("TABLE 4  SENSITIVITY / ROBUSTNESS (paper-level means; rows 1-3 are the headline figures)")
print("="*118)
pool = papers.length.values
def wins(x, lo=5, hi=95):
    x = np.asarray(x, float)
    return np.clip(x, np.percentile(pool, lo), np.percentile(pool, hi))
s = []
def add(lab, x, note=""):
    x = np.asarray(x, float)
    s.append(dict(variant=lab, n=len(x), mean=round(x.mean(),3), median=np.median(x),
                  SD=round(x.std(ddof=1),3), min=x.min(), max=x.max(), note=note))
add("HEADLINE ee (all 18 papers)", ee)
add("HEADLINE rpp (all 95 papers)", rp)
add("HEADLINE psych pooled (117 papers)", ps)
add("ee excluding length<=3", ee[ee>3], f"removes {int((ee<=3).sum())} papers")
add("rpp excluding length<=3", rp[rp>3], f"removes {int((rp<=3).sum())} brief reports")
add("psych pooled excluding length<=3", ps[ps>3], f"removes {int((ps<=3).sum())} brief reports")
add("ee winsorised at pooled p5/p95", wins(ee), f"pooled p5/p95 = {np.percentile(pool,5):.0f}/{np.percentile(pool,95):.0f}")
add("rpp winsorised at pooled p5/p95", wins(rp))
add("ee, id-level de-dup", ids.loc[ids.project.eq("ee"),"length"], f"{ids.project.eq('ee').sum()} ids")
add("rpp, id-level de-dup", ids.loc[ids.project.eq("rpp"),"length"], f"{ids.project.eq('rpp').sum()} ids")
add("psych pooled, id-level de-dup", ids.loc[ids.project.isin(['ml1','ml3','rpp']),"length"],
    f"{ids.project.isin(['ml1','ml3','rpp']).sum()} ids")
dF = raw.loc[~raw.drop_flag]
lmap = papers.set_index("k_paper")["length"]
add("ee, drop==FALSE rows only", dF.loc[dF.project.eq("ee"),"k_paper"].drop_duplicates().map(lmap).dropna().values)
add("rpp, drop==FALSE rows only", dF.loc[dF.project.eq("rpp"),"k_paper"].drop_duplicates().map(lmap).dropna().values)
add("psych pooled, drop==FALSE only (papers)", dF.loc[dF.project.isin(["ml1","ml3","rpp"]),"k_paper"].drop_duplicates().map(lmap).dropna().values)
print(pd.DataFrame(s).to_string(index=False))

print("\n[drop-column effect -- verified, not assumed]")
for p in ["ee","ml1","ml3","rpp"]:
    n_drop = int((raw.drop_flag & raw.project.eq(p)).sum())
    full = pvec(p); keep = dF.loc[dF.project.eq(p),"k_paper"].drop_duplicates().map(lmap).dropna()
    print(f"  {p:3s}: drop==TRUE rows={n_drop:3d} | papers(all)={len(full):3d} mean={full.mean():.4f} | "
          f"papers(drop==FALSE)={len(keep):3d} mean={keep.mean():.4f} | delta={keep.mean()-full.mean():+.4f}")
dropped = raw.loc[raw.drop_flag].groupby("project")["k_paper"].nunique().to_dict()
print(f"  distinct papers touched by drop==TRUE, by project: {dropped}")
ps_all, ps_keep = ps.mean(), dF.loc[dF.project.isin(["ml1","ml3","rpp"]),"k_paper"].drop_duplicates().map(lmap).dropna().mean()
print(f"  psychology pooled (headline definition-independent check): all={ps_all:.4f} drop==FALSE={ps_keep:.4f} delta={ps_keep-ps_all:+.4f}")
print(f"  economics check: ee delta = 0.0000 because ee has {int((raw.drop_flag & raw.project.eq('ee')).sum())} drop==TRUE rows")

print("\n[bootstrap reproducibility statement]")
print(f"  scheme: nonparametric bootstrap, resample the {len(ee)} / {len(rp)} ORIGINAL PAPERS with replacement "
      f"(paper = sampling unit, never the O/R row), percentile CI.")
print(f"  B = {B}, numpy default_rng seed = {SEED}; difference CI uses seed {SEED}+1.")

for nm, df in [("table1_headline", t1), ("table2_per_project", t2), ("table3_rowlevel_diagnostic", pd.DataFrame(nv)),
               ("table4_sensitivity", pd.DataFrame(s)), ("table5_inference", inf)]:
    df.to_csv(f"analysis/{nm}.csv", index=False)
papers.sort_values(["project","length"]).to_csv("analysis/paper_level_dataset.csv", index=False)
print("\nSaved: analysis/table{1..5}_*.csv and analysis/paper_level_dataset.csv (135-row de-duplicated dataset)")
print("\nHEADLINE SENTENCE: ee mean = %.2f pages (n=%d) vs rpp mean = %.2f pages (n=%d); difference %.2f pages."
      % (ee.mean(), len(ee), rp.mean(), len(rp), ee.mean()-rp.mean()))

print("\n[haywards hand-check]")
print("  ee page lengths sorted:", sorted(ee), " sum =", int(ee.sum()), " mean =", round(ee.sum()/len(ee),4))
print("  rpp sum =", int(rp.sum()), " n =", len(rp), " mean =", round(rp.sum()/len(rp),4))
