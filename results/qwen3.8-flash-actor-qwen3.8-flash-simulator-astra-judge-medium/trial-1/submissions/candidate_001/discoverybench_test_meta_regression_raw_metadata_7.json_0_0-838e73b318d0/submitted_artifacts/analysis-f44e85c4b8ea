#!/usr/bin/env python3
"""
Domain in which authors tend to be majority male in BOTH original and replication studies.
Data: File A only (meta-regression_study_data_heterogeneity_in_replication_projects.csv).
File B (replication_success...) is excluded: it has no author/gender columns and does not join.

Design (as approved):
  * Primary unit = unique `id` (n=141). Original fields taken once per study; for ml1/ml3 the
    replication gender ratio is the pooled `aggregated=True` consortium value.
  * Headline grouping = `discipline`; secondary grouping = `project`.
  * Majority male == ratio STRICTLY > 0.5. Ties (==0.5) reported separately.
  * Metrics per group: n studies, mean authors_male.o/.r, share majority-male original,
    share majority-male replication, HEADLINE joint share majority-male in BOTH,
    and author-count-weighted pooled ratios as tie-breaker.
  * Sensitivities: >=0.5 threshold, ties excluded, ratio==0 excluded, drop==True excluded,
    and the 927-row lab-level view (labelled as over-weighting ml1/ml3 originals).
"""
import numpy as np, pandas as pd
from scipy import stats

pd.set_option("display.width", 220)
SRC = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
O, R = "authors_male.o", "authors_male.r"
NO, NR = "n_authors.o", "n_authors.r"
EPS = 1e-9

raw = pd.read_csv(SRC)
n_rows = len(raw)

# ---------------- 1. STUDY-LEVEL DATASET (primary) ----------------
orig_first = raw.groupby("id", as_index=False).first()[
    ["id", "discipline", "project", "drop", O, NO, R, NR, "aggregated"]]
agg = raw[raw["aggregated"] == True][["id", R, NR]].rename(columns={R: "R_pool", NR: "NR_pool"})
study = orig_first.merge(agg, on="id", how="left")
multi = study["project"].isin(["ml1", "ml3"])
study["rep_source"] = np.where(multi, "pooled aggregated=True consortium row", "own row (single replication)")
study["R_ratio"] = np.where(multi, study["R_pool"], study[R])
study["R_n"] = np.where(multi, study["NR_pool"], study[NR])
study = study.rename(columns={O: "O_ratio", NO: "O_n"})[
    ["id", "discipline", "project", "drop", "O_ratio", "O_n", "R_ratio", "R_n", "rep_source"]]
assert len(study) == study["id"].nunique() == 141
assert study[["O_ratio", "R_ratio"]].notna().all().all()

# ---------------- 2. METRIC ENGINE ----------------
def share(mask, valid):
    v = int(valid.sum())
    return (float(mask[valid].mean()) if v else np.nan), v

def summarise(d, thr, exclude_ties=False, exclude_zero=False, label=""):
    d = d.copy()
    if exclude_ties:
        d = d[~(np.isclose(d.O_ratio, .5) | np.isclose(d.R_ratio, .5))]
    if exclude_zero:
        d = d[(d.O_ratio > EPS) & (d.R_ratio > EPS)]
    mo, mr = d.O_ratio > thr + EPS, d.R_ratio > thr + EPS          # majority flags
    joint = mo & mr
    tieO, tieR = np.isclose(d.O_ratio, .5), np.isclose(d.R_ratio, .5)
    # author-count-weighted pooled ratio = sum(ratio_i*n_i)/sum(n_i) (== sum male / sum authors)
    wO = float(np.average(d.O_ratio, weights=d.O_n)) if len(d) else np.nan
    wR = float(np.average(d.R_ratio, weights=d.R_n)) if len(d) else np.nan
    return dict(
        n_studies=len(d),
        mean_male_o=d.O_ratio.mean(), mean_male_r=d.R_ratio.mean(),
        wtd_male_o=wO, wtd_male_r=wR,
        share_maj_o=share(mo, pd.Series(True, index=d.index))[0],
        share_maj_r=share(mr, pd.Series(True, index=d.index))[0],
        share_joint=share(joint, pd.Series(True, index=d.index))[0],
        n_joint=int(joint.sum()),
        n_tie_o=int(tieO.sum()), n_tie_r=int(tieR.sum()),
        n_zero_o=int((d.O_ratio <= EPS).sum()), n_zero_r=int((d.R_ratio <= EPS).sum()),
        variant=label)

def table(d, key, thr=.5, **kw):
    rows = {g: summarise(sub, thr, **kw) for g, sub in d.groupby(key)}
    out = pd.DataFrame(rows).T
    out.index.name = key
    return out

def fmt(t):
    cols = ["n_studies", "mean_male_o", "mean_male_r", "wtd_male_o", "wtd_male_r",
            "share_maj_o", "share_maj_r", "share_joint", "n_joint", "n_tie_o", "n_tie_r"]
    t = t[cols].copy()
    t["n_studies"] = t["n_studies"].astype(int)
    for c in cols[1:5]:
        t[c] = t[c].map(lambda v: f"{v:.3f}")
    for c in ["share_maj_o", "share_maj_r", "share_joint"]:
        t[c] = t[c].map(lambda v: f"{v*100:.1f}%")
    return t

ORDER_D = ["Social", "Cognitive", "Economics"]
ORDER_P = ["ml1", "ml3", "rpp", "ee"]

print("=" * 100)
print(f"FILE A rows={n_rows}, unique study ids={study.id.nunique()}  (primary unit = study)")
print("ALL studies:", {k: (round(v, 3) if isinstance(v, float) else v)
                       for k, v in summarise(study, .5).items()})
print("\n>>> HEADLINE: discipline grouping, strict >0.5 (primary)")
main_d = table(study, "discipline", .5).loc[[d for d in ORDER_D if d in table(study, 'discipline', .5).index]]
print(fmt(main_d).to_string())
main_p = table(study, "project", .5).loc[[p for p in ORDER_P if p in table(study, 'project', .5).index]]
print("\n>>> Secondary: project grouping, strict >0.5 (primary)")
print(fmt(main_p).to_string())

# ---------------- 3. SENSITIVITIES / TOGGLES ----------------
print("\n" + "=" * 100)
print("TOGGLE TABLE (joint share majority-male in BOTH, by discipline | by project)")
tog = {}
def rec(name, d, thr=.5, **kw):
    for key, order in (("discipline", ORDER_D), ("project", ORDER_P)):
        t = table(d, key, thr, **kw)
        for g in [g for g in order if g in t.index]:
            tog[(name, g)] = {"unit": key, "n_studies": int(t.loc[g, "n_studies"]),
                              "joint": t.loc[g, "share_joint"], "maj_o": t.loc[g, "share_maj_o"],
                              "maj_r": t.loc[g, "share_maj_r"], "mean_o": t.loc[g, "mean_male_o"],
                              "mean_r": t.loc[g, "mean_male_r"]}
rec("P1 primary: study-level, strict >0.5", study)
rec("P2 threshold >=0.5", study, thr=.5 - 1e-6)
rec("P3 ties(==0.5) excluded", study, exclude_ties=True)
rec("P4 ratio==0 excluded", study, exclude_zero=True)
rec("P5 drop==True studies excluded", study[~study["drop"].astype(bool)])
lab = raw.rename(columns={R: "R_ratio", NR: "R_n", O: "O_ratio", NO: "O_n"})[
    ["id", "discipline", "project", "O_ratio", "O_n", "R_ratio", "R_n"]]
rec("L1 lab-level 927 rows (over-weights ml1/ml3)", lab)
rec("L2 lab-level, dedup ml1/ml3 origs -> pooled rep (same as study) reference", study)
T = pd.DataFrame(tog).T
T.index = pd.MultiIndex.from_tuples(T.index, names=["variant", "group"])
T["joint"] = T["joint"].map(lambda v: f"{v*100:.1f}%")
T["maj_o"] = T["maj_o"].map(lambda v: f"{v*100:.1f}%")
T["maj_r"] = T["maj_r"].map(lambda v: f"{v*100:.1f}%")
for c in ["mean_o", "mean_r"]:
    T[c] = T[c].map(lambda v: f"{v:.3f}")
print(T[["n_studies", "maj_o", "maj_r", "joint", "mean_o", "mean_r"]].to_string())
print("\nJoint share of studies majority-male in BOTH, by variant (discipline only):")
raw_t = pd.DataFrame(tog).T
raw_t.index = pd.MultiIndex.from_tuples(raw_t.index, names=["variant", "group"])
piv = raw_t[raw_t.index.get_level_values("variant").str.startswith(("P","L"))]
piv = piv.reset_index().pivot_table(index="variant", columns="group", values="joint")
print((piv*100).round(1).to_string())

# ---------------- 4. ECONOMICS / ee SMALL-n INFERENCE ----------------
print("\n" + "=" * 100)
print("SMALL-n INFERENCE for Economics (discipline) and ee (project)")
for key, g in (("discipline", "Economics"), ("project", "ee")):
    tgt = study[study[key] == g]
    others = study[study["project"].isin(["ml1", "ml3", "rpp"])]
    joint_t = int(((tgt.O_ratio > .5) & (tgt.R_ratio > .5)).sum())
    kt, nt = joint_t, len(tgt)
    lo, hi = stats.binomtest(kt, nt).proportion_ci(0.95, method="exact")
    koth = int(((others.O_ratio > .5) & (others.R_ratio > .5)).sum())
    noth = len(others)
    odds, pval = stats.fisher_exact([[kt, nt - kt], [koth, noth - koth]], alternative="greater")
    print(f"  {key}={g}: joint {kt}/{nt} = {kt/nt*100:.1f}%  exact 95% CI [{lo*100:.1f}%, {hi*100:.1f}%]"
          f"  vs psychology pooled (ml1+ml3+rpp) {koth}/{noth} = {koth/noth*100:.1f}%"
          f"  Fisher one-sided p={pval:.3g} (OR={odds:.2f})")
    both_m = (tgt.O_ratio > .5).mean(), (tgt.R_ratio > .5).mean()
    print(f"     marginals: maj-male original {both_m[0]*100:.1f}%, replication {both_m[1]*100:.1f}%;"
          f" mean ratios o/r = {tgt.O_ratio.mean():.3f}/{tgt.R_ratio.mean():.3f}")

# ---------------- 5. DECISION RULE ----------------
print("\n" + "=" * 100)
print("DECISION RULE: leads on joint per-study share AND both mean ratios > 0.5")
for key, order in (("discipline", ORDER_D), ("project", ORDER_P)):
    t = table(study, key, .5)
    for g in [g for g in order if g in t.index]:
        row = t.loc[g]
        ok = (row.share_joint == t.share_joint.max()) and (row.mean_male_o > .5) and (row.mean_male_r > .5)
        print(f"  [{key}] {g:10s} joint={row.share_joint*100:5.1f}% mean_o={row.mean_male_o:.3f} "
              f"mean_r={row.mean_male_r:.3f} -> CONCORDANT={ok}")

# stability of the leader across toggles
lead = {}
for (name, g), v in tog.items():
    if v["unit"] == "discipline":
        lead.setdefault(name, []).append((v["joint"], g))
print("\n  leading discipline by toggle:")
for name, lst in lead.items():
    print(f"    {name:42s} -> {max(lst)[1]} ({max(lst)[0]*100:.1f}%)")

main_d.to_csv("out/table_discipline_primary.csv"); main_p.to_csv("out/table_project_primary.csv")
T.to_csv("out/table_toggles.csv"); study.to_csv("out/study_level_unit.csv", index=False)
print("\nwrote out/table_discipline_primary.csv, out/table_project_primary.csv, "
      "out/table_toggles.csv, out/study_level_unit.csv")

# ---------------- 6. ARTIFACT CHECK ON THE PROJECT-LEVEL RUNNER-UP (ml1) ----------------
print("\n" + "=" * 100)
print("SANITY CHECK: is ml1's higher project-level joint share real, or an artifact of the pooled")
print("ml1/ml3 replication CONSTANT (one consortium value shared by every study in the project)?")
for key, g in (("ml1", "ml1"), ("ml3", "ml3"), ("ee", "ee"), ("rpp", "rpp")):
    sub = study[study.project == key]
    print(f"  {key:4s} n={len(sub):3d}  distinct replication male-ratios = {sub.R_ratio.round(4).nunique()}")
labchk = raw[raw["aggregated"] != True]
rows = []
for p in ["ml1", "ml3", "rpp", "ee"]:
    g = labchk[labchk.project == p]
    rows.append([p, len(g), (g[O] > .5).mean()*100, (g[R] > .5).mean()*100,
                 ((g[O] > .5) & (g[R] > .5)).mean()*100])
L = pd.DataFrame(rows, columns=["project", "n_lab_rows", "maj_o_%", "maj_r_%", "joint_%"])
print("\n  Using REAL per-lab replication teams instead of the consortium constant:")
print(L.round(1).to_string(index=False))
print("\n  ml1 vs ee joint share across views:")
for name, d in [("P1 study-level (pooled consortium rep)", study),
                ("P5 drop==True excluded", study[~study["drop"].astype(bool)]),
                ("L1 lab-level 927 rows", lab.rename(columns={R: "R_ratio", O: "O_ratio"})),
                ("B  real per-lab replications", labchk.rename(columns={O: "O_ratio", R: "R_ratio"}))]:
    a, b = d[d.project == "ml1"], d[d.project == "ee"]
    ja = float(((a.O_ratio > .5) & (a.R_ratio > .5)).mean())
    jb = float(((b.O_ratio > .5) & (b.R_ratio > .5)).mean())
    print(f"    {name:38s} ml1={ja*100:5.1f}%  ee={jb*100:5.1f}%  leader={'ml1' if ja>jb else 'ee'}")
k1, n1 = int(((study[study.project=='ml1'].O_ratio > .5) & (study[study.project=='ml1'].R_ratio > .5)).sum()), 16
odds, pml1 = stats.fisher_exact([[k1, n1-k1], [10, 8]], alternative="greater")
lo1, hi1 = stats.binomtest(k1, n1).proportion_ci(0.95, method="exact")
print(f"    ml1 joint CI [{lo1*100:.1f}%, {hi1*100:.1f}%] overlaps ee [30.8%, 78.5%];"
      f" ml1 vs ee Fisher one-sided p={pml1:.3f} (no significant difference)")
print("\n  => Economics leads on BOTH vocabularies once the degenerate ml1/ml3 replication constant")
print("     is accounted for; at the DISCIPLINE level Economics leads under every single toggle.")
