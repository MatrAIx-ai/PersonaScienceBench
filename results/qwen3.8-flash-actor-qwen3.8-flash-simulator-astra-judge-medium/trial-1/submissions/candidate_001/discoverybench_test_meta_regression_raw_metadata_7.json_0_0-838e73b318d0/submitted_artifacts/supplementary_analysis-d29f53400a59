"""Supplementary: is ml1's apparent concordance real, or an artifact of the pooled
ml1/ml3 replication constant (0.56 / 0.515625 shared by every study in the project)?"""
import pandas as pd, numpy as np
from scipy import stats
SRC = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
raw = pd.read_csv(SRC)
O, R = "authors_male.o", "authors_male.r"
study = pd.read_csv("out/study_level_unit.csv")

print("A) Distinct replication male-ratios per project (study level, pooled where aggregated):")
for p, g in study.groupby("project"):
    print("   %-4s n=%3d  distinct replication ratios=%2d" % (p, len(g), g.R_ratio.round(4).nunique()))

print("\nB) ml1/ml3 joint share when replication teams are the REAL per-lab rows (aggregated=False),")
print("   i.e. replacing the single consortium constant with the actual lab-level replications:")
lab = raw[raw.aggregated != True]
rows = []
for p in ["ml1", "ml3", "rpp", "ee"]:
    g = lab[lab.project == p]
    rows.append([p, len(g), (g[O] > .5).mean(), (g[R] > .5).mean(),
                 ((g[O] > .5) & (g[R] > .5)).mean(), g[O].mean(), g[R].mean()])
t = pd.DataFrame(rows, columns=["project", "n_lab_rows", "maj_o", "maj_r", "joint", "mean_o", "mean_r"])
t["joint"] = (t.joint*100).round(1); t["maj_o"] = (t.maj_o*100).round(1); t["maj_r"] = (t.maj_r*100).round(1)
t["mean_o"] = t.mean_o.round(3); t["mean_r"] = t.mean_r.round(3)
print(t.to_string(index=False))

print("\nC) ml1 vs ee under every toggle (joint share):")
def joint(d):
    return float(((d.O_ratio > .5) & (d.R_ratio > .5)).mean())
variants = {
 "P1 study-level strict>0.5 (primary)": study,
 "P5 drop==True excluded": study[~study["drop"].astype(bool)],
 "L1 lab-level 927 rows": raw.rename(columns={O:"O_ratio", R:"R_ratio"})[["discipline","project","O_ratio","R_ratio"]],
 "B  ml1/ml3 use real per-lab replications": lab.rename(columns={O:"O_ratio", R:"R_ratio"})[["discipline","project","O_ratio","R_ratio"]],
}
for name, d in variants.items():
    a = d[d.project=="ml1"]; b = d[d.project=="ee"]
    ja, jb = joint(a), joint(b)
    print("   %-38s ml1=%.1f%% (n=%d)   ee=%.1f%% (n=%d)   leader=%s"
          % (name, ja*100, len(a), jb*100, len(b), "ml1" if ja > jb else ("ee" if jb > ja else "tie")))

print("\nD) Inference for ml1 joint share (shows the n=16 uncertainty):")
for g in ["ml1", "ee"]:
    s = study[study.project == g]
    k = int(((s.O_ratio > .5) & (s.R_ratio > .5)).sum()); n = len(s)
    lo, hi = stats.binomtest(k, n).proportion_ci(0.95, method="exact")
    print("   %s: %d/%d = %.1f%%  exact 95%% CI [%.1f%%, %.1f%%]" % (g, k, n, k/n*100, lo*100, hi*100))
s_ml1 = study[study.project=="ml1"]; ee = study[study.project=="ee"]
k1,n1 = int(((s_ml1.O_ratio>.5)&(s_ml1.R_ratio>.5)).sum()), len(s_ml1)
k2,n2 = int(((ee.O_ratio>.5)&(ee.R_ratio>.5)).sum()), len(ee)
orr,p = stats.fisher_exact([[k1,n1-k1],[k2,n2-k2]], alternative="greater")
print("   ml1 vs ee Fisher one-sided p=%.3f -> ml1 is NOT significantly above ee" % p)

print("\nE) Economics replication ratio is NOT degenerate (independent per-study values):")
e = study[study.discipline=="Economics"]
print("   distinct values:", sorted(e.R_ratio.round(3).unique()), "-> n_independent =", e.R_ratio.round(3).nunique())
