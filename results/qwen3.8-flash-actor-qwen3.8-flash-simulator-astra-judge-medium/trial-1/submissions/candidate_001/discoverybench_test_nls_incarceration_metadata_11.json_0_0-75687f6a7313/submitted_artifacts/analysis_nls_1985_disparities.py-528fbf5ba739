"""
Disparities in median wealth in 1985 among the ever-incarcerated (NLSY79 extract).

Design (approved):
  - Primary population: ever_jailed == 1 (n=289). Never-incarcerated used ONLY as a reference column.
  - Cuts: overall, by race (3), by sex (2), race x sex (6 cells). Small cells shown, never dropped.
  - composite_wealth_1985 in raw nominal 1985 dollars. Zeros (no assets) and negatives (net debt)
    retained as substantive values; no de-duplication (no respondent ID available).
  - Every group reports n, q25, median, q75, p90, IQR, mean, asset-poverty share (wealth <= 0),
    and a percentile bootstrap 95% CI for the median (B=2000, fixed seed).
  - Interpretation rule: n>=30 headline; 20-29 "indicative, unstable"; n<30 reported transparently
    but excluded from race-specific female conclusions.
  - Robustness/trend only (nominal dollars, NOT deflated): same cut repeated for 1990 and 1996.
"""
import numpy as np, pandas as pd

SEED = 20261022
B = 2000
PATH = "data/nls_incarceration_processed.csv"
df = pd.read_csv(PATH)
df["race"] = df["race"].replace({"hipanic": "hispanic"})   # label typo in source file
WC = "composite_wealth_1985"
ever = df[df.ever_jailed == 1][WC].to_numpy(dtype=float)
never = df[df.ever_jailed == 0][WC].to_numpy(dtype=float)
print(f"rows={len(df)}  ever_jailed=1: n={len(ever)} ({100*len(ever)/len(df):.2f}%)  ever_jailed=0: n={len(never)}")

def boot_ci_median(x, B=B, seed=SEED):
    x = np.asarray(x, float)
    if len(x) < 2:
        return (np.nan, np.nan)
    rng = np.random.default_rng(seed)
    meds = np.median(rng.choice(x, size=(B, len(x)), replace=True), axis=1)
    return tuple(np.percentile(meds, [2.5, 97.5]))

def summarise(x, label, n_min_headline=30):
    x = np.asarray(x, float); n = len(x)
    lo, hi = boot_ci_median(x)
    med = np.median(x)
    flag = "HEADLINE" if n >= n_min_headline else ("indicative, unstable" if n >= 20 else "n<30: shown, not interpretable")
    return dict(group=label, n=n, q25=np.percentile(x, 25), median=med, q75=np.percentile(x, 75),
                p90=np.percentile(x, 90), iqr=np.percentile(x, 75) - np.percentile(x, 25),
                mean=x.mean(), min=x.min(), max=x.max(),
                pct_le0=100*np.mean(x <= 0), pct_eq0=100*np.mean(x == 0), pct_neg=100*np.mean(x < 0),
                pct_pos=100*np.mean(x > 0),
                ci_lo=lo, ci_hi=hi, median_is_zero_or_negative=bool(med <= 0), flag=flag)

def med_pos_only(x):
    x = np.asarray(x, float); p = x[x > 0]
    return (np.median(p) if len(p) else np.nan), len(p)

RACES = ["black", "hispanic", "white"]
rows = [summarise(ever, "EVER JAILED: all (n=289)")]
for r in RACES: rows.append(summarise(ever[ np.isin(df.loc[df.ever_jailed==1, "race"], r) ], f"  race = {r}"))
for s in ["male", "female"]: rows.append(summarise(ever[df.loc[df.ever_jailed==1, "sex"].to_numpy() == s], f"  sex = {s}"))
sub = df[df.ever_jailed == 1]
for r in RACES:
    for s in ["male", "female"]:
        rows.append(summarise(sub[(sub.race == r) & (sub.sex == s)][WC], f"  race x sex = {r} {s}"))
rows.append(summarise(never, "REFERENCE: never incarcerated (all)"))
for r in RACES:
    rows.append(summarise(df.loc[(df.ever_jailed==0)&(df.race==r), WC], f"  REF race = {r}"))
for s in ["male", "female"]:
    rows.append(summarise(df.loc[(df.ever_jailed==0)&(df.sex==s), WC], f"  REF sex = {s}"))
for r in RACES:
    for s in ["male", "female"]:
        rows.append(summarise(df.loc[(df.ever_jailed==0)&(df.race==r)&(df.sex==s), WC], f"  REF race x sex = {r} {s}"))
tab = pd.DataFrame(rows)

pd.set_option("display.width", 250, "display.max_columns", 40)
cols = ["group", "n", "q25", "median", "ci_lo", "ci_hi", "q75", "p90", "iqr", "mean",
        "pct_le0", "pct_eq0", "pct_neg", "pct_pos", "flag"]
out = tab[cols].copy()
for c in ["q25","median","ci_lo","ci_hi","q75","p90","iqr","mean"]:
    out[c] = out[c].map(lambda v: f"{v:,.0f}")
for c in ["pct_le0","pct_eq0","pct_neg","pct_pos"]:
    out[c] = out[c].map(lambda v: f"{v:.1f}%")
print("\n================ PRIMARY TABLE: composite_wealth_1985, 1985 nominal dollars ================")
print(out.to_string(index=False))
tab.to_csv("analysis/primary_table_1985.csv", index=False)

# ---- median restricted to strictly positive wealth (supplementary view) ----
print("\n--- supplementary: median among strictly positive wealth only (ever_jailed==1) ---")
for lbl, mask in [("all", np.ones(len(sub), bool))] + \
                 [(f"race={r}", (sub.race==r).to_numpy()) for r in RACES] + \
                 [(f"sex={s}", (sub.sex==s).to_numpy()) for s in ["male","female"]] + \
                 [(f"{r} {s}", ((sub.race==r)&(sub.sex==s)).to_numpy()) for r in RACES for s in ["male","female"]]:
    m, k = med_pos_only(sub[WC].to_numpy()[mask])
    print(f"  {lbl:<18} n>0={k:>4}  median_positive={m:,.0f}" if k else f"  {lbl:<18} n>0=0")

# ---- contrast vs never-incarcerated reference (reference column, difference + ratio where defined) ----
print("\n--- contrast vs never-incarcerated (same demographic cell); ratio only if both medians > 0 ---")
def ref_stats(r=None, s=None):
    m = (df.ever_jailed == 0)
    if r: m &= (df.race == r)
    if s: m &= (df.sex == s)
    return np.median(df.loc[m, WC]), np.percentile(df.loc[m, WC], 25), np.percentile(df.loc[m, WC], 75)
labels = [("all", None, None)] + [(f"race={r}", r, None) for r in RACES] + \
         [(f"sex={s}", None, s) for s in ["male","female"]] + \
         [(f"{r} {s}", r, s) for r in RACES for s in ["male","female"]]
for lbl, r, s in labels:
    if r and s: e = sub[(sub.race==r)&(sub.sex==s)][WC]
    elif r:     e = sub[sub.race==r][WC]
    elif s:     e = sub[sub.sex==s][WC]
    else:       e = sub[WC]
    em = np.median(e); rm, rq25, rq75 = ref_stats(r, s)
    ratio = f"{em/rm:.2f}x" if (em > 0 and rm > 0) else "undefined (a median <= 0)"
    print(f"  {lbl:<16} ever_med={em:>8,.0f}  ref_med={rm:>8,.0f}  diff={em-rm:>+10,.0f}  ratio={ratio}")

# ---- is the racial gap widest at the bottom or the top? (ever_jailed == 1) ----
print("\n--- quantile ladder within ever-incarcerated: black vs white (and hispanic) ---")
qs = [10, 25, 50, 75, 90]
print("  quantile: " + "".join(f"{q:>10}" for q in qs))
for r in RACES:
    v = np.percentile(sub[sub.race == r][WC], qs)
    print(f"  {r:<9}: " + "".join(f"{x:>10,.0f}" for x in v))
b_, h_, w_ = (np.percentile(sub[sub.race == r][WC], qs) for r in ["black", "hispanic", "white"])
print("  black-white diff: " + "".join(f"{x:>10,.0f}" for x in b_ - w_))
print("  black-white ratio(|.|): " + "".join(f"{x:>10}" for x in [ (abs(bb)/(ww if ww!=0 else np.nan)) for bb,ww in zip(b_,w_) ]))
print("  hispanic-white diff: " + "".join(f"{x:>10,.0f}" for x in h_ - w_))
print("  asset-poverty (<=0) share by race, ever_jailed==1:")
for r in RACES:
    x = sub[sub.race==r][WC]; print(f"    {r:<9} {100*np.mean(x<=0):5.1f}%   (n={len(x)})")

# ---- which cut explains more: race or sex, within ever-incarcerated ----
print("\n--- which cut is the larger source of variation (ever_jailed==1, n=289) ---")
from scipy import stats
y = sub[WC].to_numpy(float)
for var in ["race", "sex"]:
    g = [y[(sub[var] == k).to_numpy()] for k in sub[var].unique()]
    kw = stats.kruskal(*g)
    # rank-based pseudo-R2 (eta^2 on ranks) and median-spread across groups
    ranks = stats.rankdata(y)
    grp = sub[var].to_numpy()
    ss_between = sum(len(g[i]) * (stats.rankdata(y)[ (grp==sub[var].unique()[i]) ].mean() - (len(y)+1)/2)**2 for i in range(len(g)))
    eta2 = ss_between / ((len(y)**3 - len(y))/12)
    meds = [np.median(gi) for gi in g]
    print(f"  {var}: Kruskal-Wallis H={kw.statistic:.2f} p={kw.pvalue:.4g} | rank eta2={eta2:.3f} | "
          f"group medians={sorted(meds)} | max pairwise median diff={max(meds)-min(meds):,.0f}")
gm = [np.median(y[(sub.sex=='male').to_numpy()]), np.median(y[(sub.sex=='female').to_numpy()])]
print(f"  sex contrast (pooled): male median={gm[0]:,.0f} vs female median={gm[1]:,.0f} -> diff={gm[0]-gm[1]:+,.0f}")
mm = [np.median(sub[sub.race==r][WC]) for r in RACES]
print(f"  race contrast (all ever_jailed): black={mm[0]:,.0f} hispanic={mm[1]:,.0f} white={mm[2]:,.0f}")
mmale = [np.median(sub[(sub.race==r)&(sub.sex=='male')][WC]) for r in RACES]
print(f"  race contrast (MALES only): black={mmale[0]:,.0f} hispanic={mmale[1]:,.0f} white={mmale[2]:,.0f} | max-min={max(mmale)-min(mmale):,.0f}")
print("\n  male-only asset-poverty shares: " + ", ".join(
    f"{r} {100*np.mean(sub[(sub.race==r)&(sub.sex=='male')][WC]<=0):.1f}%" for r in RACES))
print("  male-only race pairwise MW-U p-values (median wealth):")
for i in range(3):
    for j in range(i+1, 3):
        a = sub[(sub.race==RACES[i])&(sub.sex=='male')][WC]; b = sub[(sub.race==RACES[j])&(sub.sex=='male')][WC]
        u = stats.mannwhitneyu(a, b, alternative="two-sided")
        print(f"    {RACES[i]} vs {RACES[j]}: U p={u.pvalue:.4g}")

# ---- robustness / trend: 1990 & 1996, NOMINAL dollars (not deflated) ----
print("\n--- ROBUSTNESS / TREND ONLY: nominal dollars, NOT inflation-adjusted (cross-year diffs mix real change + inflation) ---")
for year in [1990, 1996]:
    c = f"composite_wealth_{year}"
    s = sub[c].to_numpy(float)
    print(f"  {year}: all median={np.median(s):,.0f} | " +
          " | ".join(f"{r}={np.median(sub[sub.race==r][c]):,.0f}" for r in RACES) +
          " || never-jailed all median={:,.0f}".format(np.median(df.loc[df.ever_jailed==0, c])))
    print(f"        asset-poverty share ever={100*np.mean(s<=0):.1f}% vs never={100*np.mean(df.loc[df.ever_jailed==0,c]<=0):.1f}%")

# ---- data-quality footnotes ----
print("\n--- data-quality footnotes ---")
print(f"  exact duplicate rows retained: {df.duplicated().sum()} of {len(df)}")
print(f"  1985 values exactly zero: {(df[WC]==0).sum()} ({100*np.mean(df[WC]==0):.1f}%) ; negative: {(df[WC]<0).sum()}")
