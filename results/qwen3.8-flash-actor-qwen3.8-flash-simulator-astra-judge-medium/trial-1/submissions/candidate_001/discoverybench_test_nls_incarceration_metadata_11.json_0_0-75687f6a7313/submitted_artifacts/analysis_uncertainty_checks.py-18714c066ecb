"""Uncertainty checks supporting the primary table (ever_jailed==1, composite_wealth_1985)."""
import numpy as np, pandas as pd
from itertools import combinations
rng0 = np.random.default_rng(20261022)
df = pd.read_csv("data/nls_incarceration_processed.csv"); df["race"]=df["race"].replace({"hipanic":"hispanic"})
WC="composite_wealth_1985"; sub=df[df.ever_jailed==1]; B=4000
def ci_median(x,B=B,seed=1):
    r=np.random.default_rng(seed); x=np.asarray(x,float)
    return np.percentile(np.median(r.choice(x,(B,len(x))),axis=1),[2.5,97.5])
def ci_diff_medians(a,b,B=B,seed=2):   # a - b, paired bootstrap within each group
    ra,rb=np.random.default_rng(seed),np.random.default_rng(seed+1)
    a=np.asarray(a,float); b=np.asarray(b,float)
    d=np.median(ra.choice(a,(B,len(a))),axis=1)-np.median(rb.choice(b,(B,len(b))),axis=1)
    return np.percentile(d,[2.5,97.5])
def ci_prop(x,B=B,seed=3):
    r=np.random.default_rng(seed); x=np.asarray(x,float); p=(x<=0).astype(float)
    return 100*np.percentile(r.choice(p,(B,len(p))).mean(axis=1),[2.5,97.5])
def perm_p(a,b,B=20000,seed=4):        # two-sided permutation test on difference in medians
    a=np.asarray(a,float); b=np.asarray(b,float); obs=np.median(a)-np.median(b)
    r=np.random.default_rng(seed); pool=np.concatenate([a,b]); n=len(a)
    cnt=sum(abs(np.median(s[:n])-np.median(s[n:]))>=abs(obs)-1e-12 for s in (r.permutation(pool) for _ in range(B)))
    return (cnt+1)/(B+1)
print("Bootstrap 95% CIs (B=4000) — asset-poverty share (wealth <= 0), ever_jailed==1")
for lbl,x in [("all",sub[WC])]+[(r,sub[sub.race==r][WC]) for r in ["black","hispanic","white"]] + \
             [(s,sub[sub.sex==s][WC]) for s in ["male","female"]] + \
             [(f"{r} {s}",sub[(sub.race==r)&(sub.sex==s)][WC]) for r in ["black","hispanic","white"] for s in ["male","female"]]:
    lo,hi=ci_prop(x); print(f"  {lbl:<16} n={len(x):>4}  share<=0 = {100*np.mean(x<=0):5.1f}%  [{lo:5.1f}, {hi:5.1f}]")
print("\nSame for never-incarcerated reference (race):")
for r in ["black","hispanic","white"]:
    x=df.loc[(df.ever_jailed==0)&(df.race==r),WC]; lo,hi=ci_prop(x)
    print(f"  REF {r:<10} n={len(x):>5}  share<=0 = {100*np.mean(x<=0):5.1f}%  [{lo:5.1f}, {hi:5.1f}]")
print("\nMedian differences (bootstrap CI) and permutation p, ever_jailed==1:")
pairs=[("white","black"),("white","hispanic"),("black","hispanic")]
for a,b in pairs:
    xa=sub[sub.race==a][WC]; xb=sub[sub.race==b][WC]; lo,hi=ci_diff_medians(xa,xb)
    print(f"  {a} - {b}: {np.median(xa)-np.median(xb):+,.0f}  CI[{lo:+,.0f}, {hi:+,.0f}]  perm p={perm_p(xa,xb):.3f}")
lo,hi=ci_diff_medians(sub[sub.sex=='male'][WC],sub[sub.sex=='female'][WC])
print(f"  male - female: {np.median(sub[sub.sex=='male'][WC])-np.median(sub[sub.sex=='female'][WC]):+,.0f}  CI[{lo:+,.0f}, {hi:+,.0f}]  perm p={perm_p(sub[sub.sex=='male'][WC],sub[sub.sex=='female'][WC]):.3f}")
m=sub[sub.sex=='male']
for a,b in [("white","black"),("white","hispanic")]:
    xa=m[m.race==a][WC]; xb=m[m.race==b][WC]; lo,hi=ci_diff_medians(xa,xb)
    print(f"  MALES {a} - {b}: {np.median(xa)-np.median(xb):+,.0f}  CI[{lo:+,.0f}, {hi:+,.0f}]  perm p={perm_p(xa,xb):.3f}")
print("\nTop-end vs bottom-end (ever_jailed==1): share above thresholds")
for t in [0,1000,10000,50000,100000]:
    line=f"  P(wealth > {t:>7,}): "
    for r in ["black","hispanic","white"]:
        x=sub[sub.race==r][WC]; line+=f"{r}={100*np.mean(x>t):5.1f}%  "
    x=sub[sub.sex=='male'][WC]; y=sub[sub.sex=='female'][WC]
    print(line+f"| male={100*np.mean(x>t):5.1f}% female={100*np.mean(y>t):5.1f}%")
print("\nMean vs median divergence (right tail), ever_jailed==1:")
for lbl,x in [("black",sub[sub.race=='black'][WC]),("hispanic",sub[sub.race=='hispanic'][WC]),("white",sub[sub.race=='white'][WC])]:
    print(f"  {lbl:<9} median={np.median(x):7,.0f}  mean={x.mean():8,.0f}  p75={np.percentile(x,75):8,.0f}  p90={np.percentile(x,90):9,.0f}  max={x.max():10,.0f}")
