log("\nShare with wealth <= 0 (%), by incarceration status:")
log(bm.groupby("ever_jailed")[[W85, W90, W96]].apply(lambda g: (g <= 0).mean().mul(100).round(1), include_groups=False).to_string())
log("\nBASELINE SELECTION in 1985 (pre-window): jailed mean %.0f vs not-jailed %.0f (ratio %.2f); medians %.0f vs %.0f"
    % (bm[bm.ever_jailed == 1][W85].mean(), bm[bm.ever_jailed == 0][W85].mean(),
       bm[bm.ever_jailed == 1][W85].mean() / bm[bm.ever_jailed == 0][W85].mean(),
       bm[bm.ever_jailed == 1][W85].median(), bm[bm.ever_jailed == 0][W85].median()))
cut = bm[W85].sort_values().iloc[[len(bm)//3, 2*len(bm)//3]].tolist()
log("1985-wealth rank-tertile cutpoints (nominal $): %s   [T1 = bottom third, T3 = top third]" % [round(v) for v in cut])
log("Cell sizes: " + str(bm.groupby(["stratum", "ever_jailed"], observed=True).size().unstack(fill_value=0).to_dict()))

# ================================================================ 2 overall contrast
hr("2. OVERALL CONTRAST - BLACK MEN, EVER JAILED VS NOT (unadjusted, descriptive)")
ov = []
for oc, oname in [("delta_96_85", "CHANGE 96-85"), (W96, "LEVEL 1996"), ("no_pos_96", "P(wealth<=0 1996)")]:
    j = bm[bm.ever_jailed == 1][oc].values.astype(float); n = bm[bm.ever_jailed == 0][oc].values.astype(float)
    m = 100 if oc == "no_pos_96" else 1
    stt = np.mean
    b = boot_ci(j, n, stt)
    ov.append(dict(outcome=oname, jailed=j.mean()*m, notjailed=n.mean()*m, diff=(j.mean()-n.mean())*m,
                   ci_lo=b[0]*m, ci_hi=b[1]*m,
                   diff_median=(np.median(j)-np.median(n))*m, perm_p=perm_p(j, n, stt),
                   mw_p=st.mannwhitneyu(j, n, alternative="two-sided").pvalue))
ov = pd.DataFrame(ov)
log(fmt(ov, ["outcome", "jailed", "notjailed", "diff", "ci_lo", "ci_hi", "diff_median", "perm_p", "mw_p"], MONEYC))
pos = bm[bm[W85] > 0]
log("\nMedian growth ratio (1996 wealth / 1985 wealth) among those with 1985 wealth > 0: "
    "jailed %.2f (n=%d) vs not-jailed %.2f (n=%d)"
    % ((pos[pos.ever_jailed == 1][W96] / pos[pos.ever_jailed == 1][W85]).median(), int((pos.ever_jailed == 1).sum()),
       (pos[pos.ever_jailed == 0][W96] / pos[pos.ever_jailed == 0][W85]).median(), int((pos.ever_jailed == 0).sum())))
log("Share ever-jailed black men with zero 1996 wealth: %.1f%% vs %.1f%% not jailed"
    % ((bm[bm.ever_jailed == 1][W96] == 0).mean()*100, (bm[bm.ever_jailed == 0][W96] == 0).mean()*100))
log("Tail-robust overall contrasts (Hodges-Lehmann shift / probability that a jailed man is wealthier than a")
log("non-jailed man, PSO; 0.5 = no difference):")
for oc, lbl in [("delta_96_85", "CHANGE 96-85"), (W96, "LEVEL 1996")]:
    hl, hlc, ps, psc = hl_pso(bm[bm.ever_jailed == 1][oc].values, bm[bm.ever_jailed == 0][oc].values)
    log(f"    {lbl:12s} HL shift = {hl:>9,.0f} (95% CI {hlc[0]:,.0f} .. {hlc[1]:,.0f})   PSO = {ps:.3f} (95% CI {psc[0]:.3f} .. {psc[1]:.3f})")

# ================================================================ 3 stratified
hr("3. STRATIFIED CONTRASTS - BLACK MEN BY RANK TERTILE OF 1985 WEALTH (income proxy; T1 low -> T3 high)")
prim = cell_table(bm, "black men")
log(fmt(prim, [c for c in PCOLS if c in prim.columns], MONEYC))
prim.to_csv(f"{OUT}/table_stratified_black_men.csv", index=False)





hr("3b. TAIL-ROBUST VERSIONS OF THE STRATIFIED CONTRASTS (Hodges-Lehmann, probability of superiority, winsorised means)")
rb = robust_table(bm, "black men")
log(rb.round(3).to_string(index=False))
rb.to_csv(f"{OUT}/table_robust_black_men.csv", index=False)
log("\nRead: HL shift, PSO and the winsorised mean are the tail-robust signals; the raw mean difference is")
log("fragile because moving a single multi-hundred-thousand-dollar observation between small cells can flip it.")

# ================================================================ 4 effect modification
hr("4. EFFECT MODIFICATION - ever_jailed x BASELINE-WEALTH STRATUM (BLACK MEN)")
fam = {}
m_dol = smf.ols("delta_96_85 ~ C(stratum) + ever_jailed * C(stratum)", data=bm).fit(cov_type="HC3")
idol = [p for p in m_dol.params.index if ":" in p]
Fd = m_dol.f_test([f"{p} = 0" for p in idol])
log("DOLLAR scale, outcome = change in wealth 1985->1996 (HC3 robust):")
log(m_dol.summary().tables[1].as_text())
log("joint test jailed x stratum: F=%.2f  p=%.4f" % (float(np.squeeze(Fd.fvalue)), float(np.squeeze(Fd.pvalue))))
m_a96 = smf.ols("asinh96 ~ rank85 + ever_jailed * C(stratum)", data=bm).fit(cov_type="HC3")
Fas = m_a96.f_test([f"{p} = 0" for p in [q for q in m_a96.params.index if ":" in q]])
log("\nRELATIVE (asinh) scale, outcome = asinh(wealth_1996/1000), adjusted for rank of 1985 wealth (HC3):")
log(m_a96.summary().tables[1].as_text())
log("joint interaction test: F=%.2f  p=%.4f" % (float(np.squeeze(Fas.fvalue)), float(np.squeeze(Fas.pvalue))))
m_ad = smf.ols("asinh_d ~ rank85 + ever_jailed * C(stratum)", data=bm).fit(cov_type="HC3")
Fad = m_ad.f_test([f"{p} = 0" for p in [q for q in m_ad.params.index if ":" in q]])
log("asinh scale on CHANGE: joint interaction p=%.4f" % float(np.squeeze(Fad.pvalue)))
m_rk = smf.ols("rank96 ~ rank85 + ever_jailed", data=bm).fit(cov_type="HC3")
log("RANK scale (percentile rank of 1996 wealth ~ rank of 1985 wealth + ever_jailed): jailed coef = %.3f "
    "percentile points (95%% CI %.3f..%.3f), p=%.3g" % (m_rk.params["ever_jailed"],
    *m_rk.conf_int().loc["ever_jailed"], m_rk.pvalues["ever_jailed"]))
bm["s_score"] = bm["stratum"].map({"T1": 0.0, "T2": 1.0, "T3": 2.0}).astype(float)  # numeric, not categorical
m_tr = smf.ols("delta_96_85 ~ s_score * ever_jailed", data=bm).fit(cov_type="HC3")
m_tra = smf.ols("asinh96 ~ s_score * ever_jailed", data=bm).fit(cov_type="HC3")
log("\nLinear-in-stratum moderation, dollar change: jailed x score = %.0f (p=%.4f)"
    % (m_tr.params["s_score:ever_jailed"], m_tr.pvalues["s_score:ever_jailed"]))
log("Linear-in-stratum moderation, asinh level:   jailed x score = %.3f (p=%.4f)"
    % (m_tra.params["s_score:ever_jailed"], m_tra.pvalues["s_score:ever_jailed"]))
m_ct = smf.ols("delta_96_85 ~ rank85 + ever_jailed * rank85", data=bm).fit(cov_type="HC3")
log("Continuous moderation (change ~ rank85 + jailed x rank85): jailed at rank85=0: %.0f; jailed x rank85 = %.0f (p=%.4f)"
    % (m_ct.params["ever_jailed"], m_ct.params["ever_jailed:rank85"], m_ct.pvalues["ever_jailed:rank85"]))
log("Implied jailed gap at baseline rank 0.10 / 0.50 / 0.90: %.0f / %.0f / %.0f"
    % tuple(m_ct.params["ever_jailed"] + m_ct.params["ever_jailed:rank85"] * r for r in (0.1, 0.5, 0.9)))

# ================================================================ 5 binary outcome
hr("5. BINARY OUTCOME - P(no positive wealth in 1996) (well powered in small jailed cells)")
m_logit = smf.logit("no_pos_96 ~ ever_jailed * C(stratum)", data=bm).fit(disp=0)
log(m_logit.summary().tables[1].as_text())
m_lpm = smf.ols("no_pos_96 ~ ever_jailed + C(stratum)", data=bm).fit(cov_type="HC3")
log("LPM risk difference for ever_jailed (stratum-adjusted): %.1f pp (95%% CI %.1f..%.1f), p=%.3g"
    % (m_lpm.params["ever_jailed"]*100, *(m_lpm.conf_int().loc["ever_jailed"]*100), m_lpm.pvalues["ever_jailed"]))
m_lg2 = smf.logit("no_pos_96 ~ ever_jailed + rank85", data=bm).fit(disp=0)
