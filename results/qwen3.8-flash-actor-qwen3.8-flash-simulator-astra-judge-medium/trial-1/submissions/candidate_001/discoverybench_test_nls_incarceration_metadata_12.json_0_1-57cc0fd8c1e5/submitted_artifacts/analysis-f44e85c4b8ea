#!/usr/bin/env python3
"""
NLSY-79: Incarceration and wealth among Black respondents, stratified by baseline ("income") position.

Descriptive / associational analysis.
  primary sample   : Black men (n=1,465; 143 ever jailed 1985-1994)
  co-primary outcomes: (a) change in composite wealth 1985 -> 1996, (b) composite wealth level in 1996
  income proxy     : composite_wealth_1985 (NO income/earnings variable exists in the file),
                     rank-based tertiles (primary), quartiles (illustrative robustness only)
  contrast         : ever_jailed=1 vs 0 within baseline-wealth stratum; bootstrap + permutation inference
  effect modifier  : ever_jailed x baseline-wealth stratum, dollar scale and asinh/rank scale
  comparisons      : White men, Hispanic men, pooled Black respondents (labelled comparison groups)
  sensitivity      : deduplicated rows, quartile strata, 1990-wealth strata (demoted: inside jail
                     window), 1%/99% winsorised means, asinh coefficients per stratum
No causal claims: the file contains no covariates and the jailed group was already poorer in 1985.
"""
import numpy as np, pandas as pd, scipy.stats as st
import statsmodels.formula.api as smf

RNG = np.random.default_rng(20261022)
NB_BOOT, NB_PERM = 2000, 10000
DATA = "data/nls_incarceration_processed.csv"
OUT = "results"
W85, W90, W96 = "composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"
LOG = []

def log(*a):
    s = " ".join(str(x) for x in a); print(s); LOG.append(s)

def hr(t=""):
    log("\n" + "=" * 100)
    if t: log(t); log("=" * 100)

def prep(sub, k=3):
    d = sub.copy()
    d["delta_96_85"] = d[W96] - d[W85]
    d["no_pos_96"] = (d[W96] <= 0).astype(int)
    d["asinh96"] = np.arcsinh(d[W96] / 1000.0)
    d["asinh_d"] = np.arcsinh(d["delta_96_85"] / 1000.0)
    d["rank96"] = d[W96].rank(pct=True)
    d["rank85"] = d[W85].rank(pct=True)
    d["stratum"] = qstrata(d, W85, k)
    return d


def qstrata(d, col, k):
    """Rank-based quantile strata with a seeded random tie-break.
    35-40% of wealth values tie at <=0, so value-based qcut collapses cells; ranking with a
    fixed-seed random tie-break keeps cells balanced and reproducible."""
    jitter = np.random.default_rng(7).random(len(d))
    order = np.lexsort((jitter, np.asarray(d[col], float)))
    ranks = np.empty(len(d), int); ranks[order] = np.arange(1, len(d) + 1)
    lab = [f"T{i+1}" for i in range(k)] if k == 3 else [f"Q{i+1}" for i in range(k)]
    return pd.qcut(pd.Series(ranks, index=d.index), k, labels=lab)

def boot_ci(x, y, stat, B=NB_BOOT):
    x, y = np.asarray(x, float), np.asarray(y, float); out = np.empty(B)
    for b in range(B):
        out[b] = stat(RNG.choice(x, x.size, replace=True)) - stat(RNG.choice(y, y.size, replace=True))
    return np.percentile(out, [2.5, 97.5])

def perm_p(x, y, stat, B=NB_PERM):
    x, y = np.asarray(x, float), np.asarray(y, float)
    pool = np.concatenate([x, y]); k = x.size; n = pool.size
    obs = stat(x) - stat(y); cnt = 0
    for _ in range(B):
        idx = RNG.permutation(n)
        cnt += abs(stat(pool[idx[:k]]) - stat(pool[idx[k:]])) >= abs(obs) - 1e-12
    return (1 + cnt) / (1 + B)

def holm(ps):
    names = list(ps); order = np.argsort([ps[n] for n in names]); adj = {}; prev = 0.0; m = len(names)
    for r, i in enumerate(order):
        prev = max(prev, min(1.0, (m - r) * ps[names[i]])); adj[names[i]] = prev
    return adj

def cell_table(d, label=""):
    rows = []
    for s in sorted(d["stratum"].dropna().unique()):
        sub = d[d["stratum"] == s]
        j, n = sub[sub.ever_jailed == 1], sub[sub.ever_jailed == 0]
        for oc, oname in [("delta_96_85", "CHANGE 96-85"), (W96, "LEVEL 1996"), ("no_pos_96", "P(wealth<=0 1996)")]:
            xj, xn = j[oc].values.astype(float), n[oc].values.astype(float)
            r = dict(sample=label, stratum=s, outcome=oname, n_jailed=len(xj), n_not=len(xn),
                     jailed_mean=xj.mean(), not_mean=xn.mean(), diff_mean=xj.mean() - xn.mean(),
                     jailed_median=np.median(xj), not_median=np.median(xn),
                     diff_median=np.median(xj) - np.median(xn))
            if oc == "no_pos_96":
                r.update(jailed_mean=xj.mean()*100, not_mean=xn.mean()*100, diff_mean=(xj.mean()-xn.mean())*100,
                         jailed_median=np.nan, not_median=np.nan, diff_median=np.nan)
                bm = boot_ci(xj, xn, lambda a: a.mean()*100)
                r.update(ci_lo=bm[0], ci_hi=bm[1], perm_p=perm_p(xj, xn, lambda a: a.mean(), 2000), mw_p=np.nan)
            else:
                bm, bmed = boot_ci(xj, xn, np.mean), boot_ci(xj, xn, np.median)
                r.update(ci_lo=bm[0], ci_hi=bm[1], ci_lo_med=bmed[0], ci_hi_med=bmed[1],
                         perm_p_mean=perm_p(xj, xn, np.mean), perm_p_median=perm_p(xj, xn, np.median),
                         mw_p=st.mannwhitneyu(xj, xn, alternative="two-sided").pvalue)
            rows.append(r)
    return pd.DataFrame(rows)

def fmt(d, cols, money=()):
    d = d.copy()
    for c in d.columns:
        if c not in cols: continue
        if c.endswith("_p") or c.endswith("p"):
            d[c] = d[c].map(lambda v: "" if pd.isna(v) else f"{v:.4f}".rstrip("0").rstrip("."))
        elif c in money or c.startswith(("diff","jailed_mean","not_mean","jailed","notjailed","ci")):
            d[c] = d[c].map(lambda v: "" if pd.isna(v) else f"{v:,.1f}")
    return d[cols].to_string(index=False)

PCOLS = ["sample","stratum","outcome","n_jailed","n_not","jailed_mean","not_mean","diff_mean","ci_lo","ci_hi",
         "jailed_median","not_median","diff_median","ci_lo_med","ci_hi_med","perm_p_mean","perm_p_median","mw_p","perm_p"]
MONEYC = {"jailed_mean","not_mean","diff_mean","jailed_median","not_median","diff_median","ci_lo","ci_hi",
          "ci_lo_med","ci_hi_med","jailed","notjailed","diff","diff_median"}

def re_strata(d, col, k=3):
    d = d.copy()
    d["stratum"] = qstrata(d, col, k)
    return d

def hl_pso(x, y, B=500):
    """Hodges-Lehmann shift (median of all pairwise differences) and probability of superiority
    P(X>Y) + 0.5 P(X=Y), with bootstrap CIs. Both are tail-robust two-sample location summaries."""
    x, y = np.asarray(x, float), np.asarray(y, float)
    def hl(a, b): return np.median((a[:, None] - b[None, :]).ravel())
    def ps(a, b): return np.mean(a[:, None] > b[None, :]) + 0.5*np.mean(a[:, None] == b[None, :])
    hb = np.empty(B); pb = np.empty(B)
    for i in range(B):
        xb, yb = RNG.choice(x, x.size, True), RNG.choice(y, y.size, True)
        hb[i] = np.median((xb[:, None] - yb[None, :]).ravel())
        pb[i] = ps(xb, yb)
    return hl(x, y), np.percentile(hb, [2.5, 97.5]), ps(x, y), np.percentile(pb, [2.5, 97.5])

def robust_table(d, label, B=2000):
    """Tail-robust counterparts to the mean-difference tests: Hodges-Lehmann shift (median of pairwise
    differences), probability of superiority P(X>Y)+0.5P(X=Y), and a winsorised mean difference.
    Rationale: within strata the raw mean is dominated by a handful of multi-hundred-thousand-dollar
    observations, so label-reallocating them under a permutation null makes the mean test conservative."""
    rows = []
    lo85, hi85 = np.percentile(d[W85], [1, 99]); lo96, hi96 = np.percentile(d[W96], [1, 99])
    d = d.assign(dw85=d[W85].clip(lo85, hi85), dw96=d[W96].clip(lo96, hi96))
    d = d.assign(deltaw=d.dw96 - d.dw85)
    for s_ in sorted(d["stratum"].dropna().unique()):
        sub = d[d["stratum"] == s_]
        for oc, wcol, lbl in [("delta_96_85", "deltaw", "CHANGE 96-85"), (W96, "dw96", "LEVEL 1996")]:
            jg, ng = sub[sub.ever_jailed == 1], sub[sub.ever_jailed == 0]
            x, y = jg[oc].values.astype(float), ng[oc].values.astype(float)
            xw, yw = jg[wcol].values.astype(float), ng[wcol].values.astype(float)
            pairs = (x[:, None] - y[None, :]).ravel()
            hl = np.median(pairs) if pairs.size <= 400000 else np.median(RNG.choice(pairs, 400000))
            pso = (np.mean(x[:, None] > y[None, :]) + 0.5*np.mean(x[:, None] == y[None, :])) if x.size*y.size <= 400000 else np.nan
            # bootstrap CI for HL via resampling observations
            hb = np.empty(500)
            for b in range(500):
                xb, yb = RNG.choice(x, x.size, True), RNG.choice(y, y.size, True)
                hb[b] = np.median((xb[:, None] - yb[None, :]).ravel())
            pbb = np.empty(500)
            for b in range(500):
                xb, yb = RNG.choice(x, x.size, True), RNG.choice(y, y.size, True)
                pbb[b] = np.mean(xb[:, None] > yb[None, :]) + 0.5*np.mean(xb[:, None] == yb[None, :])
            wdiff = xw.mean() - yw.mean()
            rows.append(dict(sample=label, stratum=s_, outcome=lbl, n_jailed=len(x), n_not=len(y),
                             HL_shift=hl, HL_lo=np.percentile(hb, 2.5), HL_hi=np.percentile(hb, 97.5),
                             PSO=pso, PSO_lo=np.percentile(pbb, 2.5), PSO_hi=np.percentile(pbb, 97.5),
                             raw_mean_diff=x.mean()-y.mean(), wins_mean_diff=wdiff,
                             wins_perm_p=perm_p(xw, yw, np.mean, 4000),
                             max_not_y=ng[oc].max(), top_obs_share=ng[oc].max()/ng[oc].sum() if ng[oc].sum() > 0 else np.nan))
    return pd.DataFrame(rows)

