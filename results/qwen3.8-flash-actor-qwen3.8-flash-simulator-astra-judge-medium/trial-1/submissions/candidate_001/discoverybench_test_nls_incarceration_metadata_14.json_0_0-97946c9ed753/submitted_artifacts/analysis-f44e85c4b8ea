#!/usr/bin/env python3
"""
Consolidated analysis for:
  "Between which years did the largest increases in median wealth occur among black females?"

Data: data/nls_incarceration_processed.csv (NLSY79 cohort; race, sex, ever_jailed,
      composite_wealth_1985/1990/1996).

Pre-registered decisions (per approved plan):
  * Headline metric  : ABSOLUTE dollar change in the median, over the raw interval,
                       within race=='black' & sex=='female'.
  * Zero handling    : PRIMARY = zeros kept at face value exactly as the file encodes them.
                       SENSITIVITY = zeros->NA, positive-wealth-only, negatives->NA.
  * Interval length  : raw interval change is primary; per-year normalisation (5 vs 6 yrs)
                       reported for visibility.
  * ever_jailed      : descriptive stratification + never-jailed sensitivity ONLY (n=16 jailed).
  * Dropped by design: winsorised medians (no effect), survey weights, deflation (unavailable).
"""
import json
import numpy as np
import pandas as pd
from scipy import stats

DATA = "data/nls_incarceration_processed.csv"
W = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
YEARS = [1985, 1990, 1996]
INTERVALS = [(1985, 1990, 5), (1990, 1996, 6)]
OUTLIER_NOTE = ("winsorising at p1/p99 leaves every black/female median unchanged "
                "(medians are outlier-insensitive); not tabulated.")
LIMITS = [
    "No survey weights / PSU-stratum identifiers in the file: medians are unweighted and the "
    "bootstrap CIs are i.i.d. approximations, not design-based inference.",
    "Wealth is nominal; no deflator is supplied, so 1996 dollars are not real-terms comparable to 1985.",
    "The file has zero missing cells for a 3-wave survey, so zeros may mix genuine assetlessness with "
    "zero-filled nonresponse; construction rules for the composite are unavailable.",
    "No respondent ID column: 289 exact-duplicate rows within black/female are retained as distinct cases.",
]

def interval_table(d, label):
    """Difference of medians (primary) + within-person median difference + relative checks."""
    rows = []
    for a, b, yrs in INTERVALS:
        ca, cb = f"composite_wealth_{a}", f"composite_wealth_{b}"
        cc = d[[ca, cb]].dropna()
        ma, mb = cc[ca].median(), cc[cb].median()
        diff = cc[cb] - cc[ca]
        pos = cc[(cc[ca] > 0) & (cc[cb] > 0)]
        rows.append(dict(
            convention=label, interval=f"{a}\u2192{b}", n_pairs=len(cc),
            median_start=ma, median_end=mb, change_in_median=mb - ma,
            change_per_year=(mb - ma) / yrs,
            median_within_person_diff=diff.median(),
            pct_individuals_increasing=round((diff > 0).mean() * 100, 1),
            median_ratio_both_positive=round((pos[cb] / pos[ca]).median(), 2) if len(pos) else np.nan,
            n_both_positive=len(pos)))
    return rows

def bootstrap_dmedian(d, a, b, reps=2000, seed=0):
    rng = np.random.default_rng(seed)
    ca, cb = f"composite_wealth_{a}", f"composite_wealth_{b}"
    x, y = d[ca].to_numpy(float), d[cb].to_numpy(float)
    bs = [np.median(y[rng.integers(0, len(y), len(y))]) - np.median(x[rng.integers(0, len(x), len(x))])
          for _ in range(reps)]
    return np.percentile(bs, [2.5, 97.5])

def fmt(df, money_cols):
    out = df.copy()
    for c in out.columns:
        if c in money_cols:
            out[c] = out[c].map(lambda v: f"{v:,.0f}" if pd.notna(v) else "")
    return out

def usd(v):
    """Format a dollar amount, keeping a true minus sign for negatives."""
    return f"${v:,.0f}" if v >= 0 else f"\u2212${abs(v):,.0f}"


def main():
    df = pd.read_csv(DATA)
    print("=" * 96)
    print("STEP 0  PROFILE")
    print("=" * 96)
    print(f"rows={len(df):,}  cols={list(df.columns)}")
    print(f"race       : {df.race.value_counts().to_dict()}   (note the 'hipanic' spelling)")
    print(f"sex        : {df.sex.value_counts().to_dict()}")
    print(f"ever_jailed: {df.ever_jailed.value_counts().to_dict()}")
    print(f"missing cells per column: {df.isna().sum().to_dict()}  -> NO missing values at all")
    print(f"{'year':<6}{'min':>12}{'median':>12}{'mean':>12}{'max':>14}{'n_zero':>8}{'n_neg':>7}")
    for y, c in zip(YEARS, W):
        print(f"{y:<6}{df[c].min():>12,.0f}{df[c].median():>12,.0f}{df[c].mean():>12,.0f}"
              f"{df[c].max():>14,.0f}{(df[c]==0).sum():>8,}{(df[c]<0).sum():>7,}")
    print("values are raw nominal dollars: 81-90% are exact multiples of 100; negatives = net debt.")
    print("Available wealth years = {1985, 1990, 1996} -> candidate intervals: 1985\u21921990, 1990\u21921996.")

    bf = df[(df.race == "black") & (df.sex == "female")].copy()
    print("\n" + "=" * 96)
    print("STEP 1  BLACK/FEMALE SUBGROUP SIZE")
    print("=" * 96)
    print(f"n rows = {len(bf):,}")
    for c in W:
        print(f"  {c}: n_nonmissing={bf[c].notna().sum():,}  n_complete_all_3_years={len(bf[W].dropna()):,}")
    print(f"ever_jailed within black/female: {bf.ever_jailed.value_counts().to_dict()}")

    print("\n" + "=" * 96)
    print("STEP 2  PRIMARY TABLE (zeros at face value)   |   STEP 3  ZERO-HANDLING SENSITIVITY")
    print("=" * 96)
    primary = interval_table(bf[W], "PRIMARY: zeros kept as real $0")
    sens = (interval_table(bf[W].replace(0, np.nan), "SENS: zeros -> NA")
            + interval_table(bf[W].where(bf[W] > 0), "SENS: positive wealth only")
            + interval_table(bf[W].where(bf[W] >= 0), "SENS: negatives -> NA"))
    money = ["median_start", "median_end", "change_in_median", "change_per_year",
             "median_within_person_diff"]
    prim_tbl = fmt(pd.DataFrame(primary), money)
    sens_tbl = fmt(pd.DataFrame(sens), money)
    print("\n--- PRIMARY (headline basis) ---")
    print(prim_tbl.to_string(index=False))
    print("\n--- SENSITIVITY to zero/missing coding (ANSWER FLIPS) ---")
    print(sens_tbl.to_string(index=False))
    print(f"\n{OUTLIER_NOTE}")

    P = pd.DataFrame(primary); S = pd.DataFrame(sens)
    win_primary = P.loc[P.change_in_median.idxmax(), "interval"]
    best = {r.convention: (lambda t: t.loc[t.change_in_median.idxmax(), "interval"])(S[S.convention == r.convention])
            for r in S.itertuples()}
    print("\nInterval with LARGEST increase in median wealth among black females:")
    print(f"  PRIMARY (zeros at face value) -> {win_primary}")
    for lab in S.convention.unique():
        sub = S[S.convention == lab]
        print(f"  {lab:<32} -> {sub.loc[sub.change_in_median.idxmax(), 'interval']}")

    print("\nInference under the primary convention:")
    for a, b, _ in INTERVALS:
        ca, cb = f"composite_wealth_{a}", f"composite_wealth_{b}"
        d = bf[cb] - bf[ca]
        w, p = stats.wilcoxon(d)
        lo, hi = bootstrap_dmedian(bf, a, b)
        print(f"  {a}\u2192{b}: Wilcoxon p={p:.2e}; bootstrap 95% CI of \u0394-median = "
              f"[${lo:,.0f}, ${hi:,.0f}]; {(d > 0).mean() * 100:.1f}% of individuals increased")

    print("\n" + "=" * 96)
    print("STEP 4  ever_jailed STRATIFICATION (DESCRIPTIVE ONLY, jailed cell n=16) + never-jailed footnote")
    print("=" * 96)
    strat = []
    for ej, g in bf.groupby("ever_jailed"):
        strat += [dict(ever_jailed=ej, n_group=len(g), **r) for r in interval_table(g[W], "stratum")]
    cols = ["ever_jailed", "n_group", "interval", "median_start", "median_end", "change_in_median",
            "median_within_person_diff"]
    strat_tbl = fmt(pd.DataFrame(strat)[cols], ["median_start", "median_end", "change_in_median",
                                                "median_within_person_diff"])
    print(strat_tbl.to_string(index=False))
    nj_tbl = fmt(pd.DataFrame(interval_table(bf[bf.ever_jailed == 0][W], "never-jailed")), money)
    print("\nFootnote sensitivity - never-jailed black females only:")
    print(nj_tbl.to_string(index=False))
    print("-> same direction as the primary result; no incarceration claim is made (n=16 jailed).")

    print("\n" + "=" * 96)
    print("STEP 5  CONTEXT ONLY: medians by race x sex (change in median per interval)")
    print("=" * 96)
    ctx = []
    for (r, s), g in df.groupby(["race", "sex"]):
        for a, b, yrs in INTERVALS:
            ca, cb = f"composite_wealth_{a}", f"composite_wealth_{b}"
            cc = g[[ca, cb]].dropna()
            ctx.append(dict(race=r, sex=s, n=len(cc), interval=f"{a}\u2192{b}",
                            median_start=cc[ca].median(), median_end=cc[cb].median(),
                            change_in_median=cc[cb].median() - cc[ca].median()))
    ctx_tbl = fmt(pd.DataFrame(ctx), ["median_start", "median_end", "change_in_median"])
    print(ctx_tbl.to_string(index=False))
    print("(context only - the question asks about black females.)")

    p0, p1 = P.iloc[0], P.iloc[1]

    # --- paired bootstrap: is the 1985->1990 gain larger than the 1990->1996 gain? ---
    rng = np.random.default_rng(7)
    x85, x90, x96 = (bf[c].to_numpy(float) for c in W)
    n = len(bf); dd = []
    for _ in range(4000):
        i = rng.integers(0, n, n)
        dd.append((np.median(x90[i]) - np.median(x85[i])) - (np.median(x96[i]) - np.median(x90[i])))
    dd = np.array(dd)
    ci = np.percentile(dd, [2.5, 97.5]); pr = (dd > 0).mean()
    delta_delta = (p0.change_in_median - p1.change_in_median)
    print("\nPaired bootstrap of (\u0394-median 1985\u21921990) \u2212 (\u0394-median 1990\u21921996):")
    print(f"  point = {usd(delta_delta)}; 95% CI [{usd(ci[0])}, {usd(ci[1])}]; "
          f"P(1985\u21921990 larger) = {pr:.3f}")

    # black/female median as a share of the white/female median (context sentence)
    wfm = {y: df[(df.race == "white") & (df.sex == "female")][c].median() for y, c in zip(YEARS, W)}
    shm = {y: bf[c].median() / wfm[y] * 100 for y, c in zip(YEARS, W)}
    shr85, shr90, shr96 = shm[1985], shm[1990], shm[1996]

    zn = S[S.convention == "SENS: zeros -> NA"].set_index("interval")
    po = S[S.convention == "SENS: positive wealth only"].set_index("interval")
    z85, z96 = zn.loc["1985\u21921990"], zn.loc["1990\u21921996"]
    o85, o96 = po.loc["1985\u21921990"], po.loc["1990\u21921996"]
    nn = S[S.convention == "SENS: negatives -> NA"].set_index("interval")
    n85, n96 = nn.loc["1985\u21921990"], nn.loc["1990\u21921996"]
    wf = next(r for r in ctx if r["race"] == "white" and r["sex"] == "female" and r["interval"] == "1990\u21921996")
    wm = next(r for r in ctx if r["race"] == "white" and r["sex"] == "male" and r["interval"] == "1990\u21921996")
    nj_t = pd.DataFrame(interval_table(bf[bf.ever_jailed == 0][W], "nj")).set_index("interval")

    hyp = (
      f"Among black females, median wealth grew in both windows but the largest increase came between 1985 "
      f"and 1990: for the {len(bf):,} black women in the sample (complete on all three survey years) median "
      f"composite wealth rose from {usd(p0.median_start)} in 1985 to {usd(p0.median_end)} in 1990, a gain of "
      f"{usd(p0.change_in_median)} ({p0.median_end / p0.median_start:.1f}x; {usd(p0.change_per_year)}/year), "
      f"against {usd(p1.median_end)} by 1996, a further gain of only {usd(p1.change_in_median)} "
      f"({p1.median_end / p1.median_start:.1f}x; {usd(p1.change_per_year)}/year) - and this holds on the "
      f"assumption, taken from the supplied file itself, that the zeros in the wealth columns are genuine "
      f"zero-wealth values rather than missing data. That assumption is what pins the answer down: if those "
      f"zeros are instead read as zero-filled nonresponse (the file reports no missing values anywhere in "
      f"its {len(df):,} rows) and are set missing, the largest increase shifts to 1990\u21921996, with a "
      f"median gain of {usd(z96.change_in_median)} versus {usd(z85.change_in_median)} for 1985\u21921990 "
      f"({usd(o96.change_in_median)} versus {usd(o85.change_in_median)} among women holding positive wealth in "
      f"both years), while treating only the negative values as missing leaves the answer at 1985\u21921990 "
      f"({usd(n85.change_in_median)} versus {usd(n96.change_in_median)}). Under the primary coding every secondary measure agrees on 1985\u21921990: the median "
      f"within-person gain is {usd(p0.median_within_person_diff)} versus {usd(p1.median_within_person_diff)} "
      f"for 1990\u21921996, {p0.pct_individuals_increasing}% versus {p1.pct_individuals_increasing}% of "
      f"black women gained wealth, and the paired bootstrap of the difference between the two interval "
      f"gains is {usd(delta_delta)} (95% CI {usd(ci[0])} to {usd(ci[1])}; P(1985\u21921990 larger) = {pr:.2f}) - a bootstrap interval that straddles zero, so the defensible claim is only that both windows brought gains and the earlier brought the larger one, not that the two windows are cleanly separable. "
      f"Nor is this an artefact of window length: 1985\u21921990 spans 5 years against 6 for "
      f"1990\u21921996, so the per-year normalisation "
      f"({usd(p0.change_per_year)}/year versus {usd(p1.change_per_year)}/year) points the same way rather than "
      f"qualifying the result. Incarceration status does not drive it - among never-jailed black women the "
      f"gains are {usd(nj_t.loc['1985\u21921990', 'change_in_median'])} versus "
      f"{usd(nj_t.loc['1990\u21921996', 'change_in_median'])} - and the {int((bf.ever_jailed == 1).sum())} "
      f"ever-jailed black women, whose wealth is almost entirely $0, are reported descriptively only and "
      f"support no inferential claim. For context only: black females held the lowest median wealth of all six race x sex cells in every wave, and theirs kept climbing after 1990 even as "
      f"white women's median fell from {usd(wf["median_start"])} to "
      f"{usd(wf["median_end"])} and white men's from {usd(wm["median_start"])} to {usd(wm["median_end"])} over "
      f"1990\u21921996; their median reached {shr96:.0f}% of white women's by 1996 (from {shr85:.0f}% in 1985 and {shr90:.0f}% in 1990), so their fastest proportional gains came earliest, in 1985\u21921990, from "
      f"a near-zero base, while the level gap narrowed mainly before 1990 and then plateaued. Limitations: unweighted medians (no survey "
      f"weights supplied), nominal non-deflated dollars (no price index supplied), and no documented "
      f"construction rules for the five-component wealth composite."
    )
    workflow = (
      "One executed script, analysis_black_female_median_wealth.py, folding in the four inspection steps. "
      "(0) Profile: 12,013 rows x 6 cols; race {white 7099, black 3013, hipanic 1901}, sex {female 6164, "
      "male 5849}, ever_jailed {0: 11724, 1: 289}; zero missing cells in every column; wealth is raw "
      "nominal dollars (81-90% exact multiples of 100) with negatives (net debt), abundant zeros and "
      "million-dollar right-tail outliers; only the years 1985, 1990 and 1996 exist, so exactly two "
      "candidate intervals. (1) Subset race=='black' & sex=='female': n=1,548, complete on all three waves, "
      "so complete-case and pairwise-complete medians coincide (no attrition). (2) Primary table: absolute "
      "change in the median per interval with zeros kept at face value, plus per-year normalisation (5 vs 6 "
      "years), median within-person difference, share of individuals increasing, median ratio among "
      "both-positive pairs, Wilcoxon signed-rank tests and 2,000-draw bootstrap CIs for each change in the "
      "median, plus a 4,000-draw paired (same-respondent) bootstrap of the difference between the two "
      "interval gains to test the headline claim. (3) Pre-registered zero-handling sensitivity: zeros->NA, "
      "positive-wealth-only, negatives->NA (winsorising at p1/p99 was checked during inspection, changed no "
      "median, and is kept as a one-line note). (4) ever_jailed: descriptive stratified table plus a "
      "never-jailed sensitivity; no inferential claim is built on the n=16 jailed cell. (5) Cross race x sex "
      "medians printed strictly as context. No survey weights and no inflation adjustment were applied "
      "because neither is available in the supplied data."
    )
    payload = dict(hypothesis=hyp, workflow=workflow, executed_analysis=True,
                   primary_interval=win_primary,
                   primary_change_in_median=float(p0.change_in_median),
                   primary_medians={"1985": float(p0.median_start), "1990": float(p0.median_end),
                                    "1996": float(p1.median_end)},
                   per_year_change={"1985-1990": float(p0.change_per_year),
                                    "1990-1996": float(p1.change_per_year)},
                   difference_between_interval_gains={"estimate": float(delta_delta),
                                                      "ci95": [float(ci[0]), float(ci[1])],
                                                      "p_first_larger": float(pr)},
                   sensitivity_best_interval=dict(best, **{"PRIMARY (zeros at face value)": win_primary}),
                   n_black_female=int(len(bf)), limitations=LIMITS)
    with open("result_payload.json", "w") as fh:
        json.dump(payload, fh, indent=2)
    fmt(P, money).to_csv("table_primary.csv", index=False)
    fmt(S, money).to_csv("table_zero_sensitivity.csv", index=False)
    strat_tbl.to_csv("table_ever_jailed_descriptive.csv", index=False)
    ctx_tbl.to_csv("table_context_race_sex.csv", index=False)

    fav = sorted(k for k, v in best.items() if v == win_primary)
    unfav = sorted(k for k, v in best.items() if v != win_primary)
    print("\nLargest gain is " + win_primary + " under: PRIMARY" + (", " + ", ".join(fav) if fav else ""))
    print("Largest gain flips to the other interval under: " + (", ".join(unfav) if unfav else "none"))
    print("\n" + "=" * 96)
    print("HYPOTHESIS")
    print("=" * 96)
    print(hyp)
    print("\nwrote: result_payload.json, table_primary.csv, table_zero_sensitivity.csv, "
          "table_ever_jailed_descriptive.csv, table_context_race_sex.csv")

if __name__ == "__main__":
    main()
