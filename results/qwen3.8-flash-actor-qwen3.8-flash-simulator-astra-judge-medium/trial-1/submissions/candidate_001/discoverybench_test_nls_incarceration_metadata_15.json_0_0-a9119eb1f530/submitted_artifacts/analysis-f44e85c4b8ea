"""
Wealth inequality for white males vs white females, NLSY79 processed extract.
Question: what changed in wealth inequality for white males and white females between 1990 and 1996?

Conventions (per researcher sign-off):
  HEADLINE  ("pos"): positive-wealth-only. composite==0 treated as missing-by-convention
                     (non-response), negatives (debt) excluded. Basis for Gini, top shares,
                     quantile ratios.
  CO-PRIMARY ("zk"): zeros kept, negatives floored at 0 ("zeros-kept"). Non-reporters sit at
                     the bottom of the measured distribution.
  Means/SD/quantile LEVELS of raw composite are also reported on the all-rows raw scale
  (valid with negatives) for context.
Primary design: repeated cross-sections (row = respondent, no ID column).
Sensitivity: paired 1990 & 1996 both-positive subsample (within-respondent change).
ever_jailed: descriptive counts only. 1985: background only, excluded from headline.
"""
import numpy as np, pandas as pd

RNG = np.random.default_rng(20261023)
B = 1000
CSV = "data/nls_incarceration_processed.csv"
YEARS = ["1990", "1996"]
BG = ["1985"]
CELLS = {"white_male": ("white", "male"), "white_female": ("white", "female")}

df = pd.read_csv(CSV)
wcols = {y: "composite_wealth_" + y for y in YEARS + BG}


# ---------- statistics ----------
def gini(x):
    """Gini on a non-negative scale (Lorenz-curve form)."""
    x = np.sort(np.asarray(x, float))
    n = x.size
    if n == 0 or x.sum() <= 0:
        return np.nan
    c = np.cumsum(x)
    return (n + 1 - 2.0 * c.sum() / c[-1]) / n


def shares(x, top=0.10):
    x = np.sort(np.asarray(x, float))
    tot = x.sum()
    if tot <= 0:
        return np.nan, np.nan
    k10 = max(1, int(np.floor(len(x) * (1 - top))))
    k1 = max(1, int(np.floor(len(x) * 0.99)))
    return x[k10:].sum() / tot, x[k1:].sum() / tot


def q(x, p):
    return float(np.percentile(x, p))


def statblock(raw, conv):
    """raw = all values for a group-year; conv in {'pos','zk','raw'}"""
    raw = np.asarray(raw, float)
    n_all = raw.size
    n_pos = int((raw > 0).sum())
    n_zero = int((raw == 0).sum())
    n_neg = int((raw < 0).sum())
    if conv == "pos":
        x = raw[raw > 0]
    elif conv == "pneg0":
        x = np.clip(raw[raw != 0], 0, None)
    elif conv == "zk":
        x = np.clip(raw, 0, None)
    else:
        x = raw
    out = dict(n_all=n_all, n_positive=n_pos, share_zero=n_zero / n_all,
               share_negative=n_neg / n_all, basis_n=int(x.size))
    if conv in ("pos", "zk", "pneg0"):
        out["gini"] = gini(x)
        s10, s1 = shares(x)
        out["top10_share"], out["top1_share"] = s10, s1
        p50 = q(x, 50)
        out["p10"], out["p25"], out["p50"], out["p75"], out["p90"], out["p95"] = \
            [q(x, p) for p in (10, 25, 50, 75, 90, 95)]
        out["p90_p50"] = out["p90"] / p50 if p50 > 0 else np.nan
        out["p75_p25"] = out["p75"] / out["p25"] if out["p25"] > 0 else np.nan
        out["p90_p75"] = out["p90"] / out["p75"] if out["p75"] > 0 else np.nan
        p10 = out["p10"]
        out["p90_p10"] = out["p90"] / p10 if p10 > 0 else np.nan
        out["mean_median_ratio"] = x.mean() / p50 if p50 > 0 else np.nan
        out["sd"] = x.std(ddof=1)
        pos = x[x > 0]
        out["sd_log_positive"] = np.log(pos).std(ddof=1) if pos.size > 1 else np.nan
        out["mean"] = x.mean()
        out["median"] = p50
    else:  # raw scale context: means/SD/quantiles valid with negatives, no Gini/shares
        out["mean"] = x.mean(); out["median"] = q(x, 50); out["sd"] = x.std(ddof=1)
        out["p10"], out["p25"], out["p75"], out["p90"] = [q(x, p) for p in (10, 25, 75, 90)]
        for k in ("gini", "top10_share", "top1_share", "p90_p50", "p90_p75", "p75_p25",
                  "p90_p10", "mean_median_ratio", "p95", "sd_log_positive"):
            out[k] = np.nan
    return out


# ---------- group x year table ----------
rows = []
for cell, (r, s) in CELLS.items():
    sub = df[(df.race == r) & (df.sex == s)]
    for y in BG + YEARS:
        tag = "background_1985" if y in BG else "analysis"
        for conv in ("raw", "pos", "zk", "pneg0"):
            rows.append(dict(cell=cell, year=y, role=tag, convention=conv,
                             **statblock(sub[wcols[y]].values, conv)))
table = pd.DataFrame(rows)
table.to_csv("out/group_year_table.csv", index=False)

# ---------- bootstrap helpers ----------
def boot_cell(values, conv, fn, B=B):
    values = np.asarray(values, float)
    if conv == "pos":
        keep = values[values > 0]
    elif conv == "pneg0":
        keep = np.clip(values[values != 0], 0, None)
    else:
        keep = np.clip(values, 0, None)
    n = keep.size
    idx = RNG.integers(0, n, size=(B, n))
    return np.array([fn(keep[i]) for i in idx])


def f_gini(x):
    return gini(x)


def f_p90p50(x):
    p50 = np.percentile(x, 50)
    return np.percentile(x, 90) / p50 if p50 > 0 else np.nan


def f_p90p75(x):
    p75 = np.percentile(x, 75)
    return np.percentile(x, 90) / p75 if p75 > 0 else np.nan


def f_top10(x):
    return shares(x, 0.10)[0]


chg = []
for cell, (r, s) in CELLS.items():
    sub = df[(df.race == r) & (df.sex == s)]
    for conv in ("pos", "zk"):
        a = sub[wcols["1990"]].values
        b = sub[wcols["1996"]].values
        for nm, fn in (("gini", f_gini), ("p90_p50", f_p90p50), ("p90_p75", f_p90p75),
                       ("top10_share", f_top10)):
            v90, v96 = statblock(a, conv)[nm], statblock(b, conv)[nm]
            ba, bb = boot_cell(a, conv, fn), boot_cell(b, conv, fn)
            d = bb - ba
            ok = ~np.isnan(d)
            chg.append(dict(cell=cell, convention=conv, statistic=nm,
                            y1990=v90, y1996=v96, change=v96 - v90,
                            ci_lo=np.nanpercentile(d[ok], 2.5),
                            ci_hi=np.nanpercentile(d[ok], 97.5),
                            boot_n=int(ok.sum()),
                            sep=np.nanstd(d[ok]),
                            n90=int((a > 0).sum()) if conv == "pos" else a.size,
                            n96=int((b > 0).sum()) if conv == "pos" else b.size))
change = pd.DataFrame(chg)
change.to_csv("out/change_table_bootstrap.csv", index=False)

# ---------- difference-in-differences: (F 96-90) - (M 96-90) ----------
dd_rows = []
for conv in ("pos", "pneg0", "zk"):
    for nm, fn in (("gini", f_gini), ("p90_p50", f_p90p50), ("p90_p75", f_p90p75),
                   ("top10_share", f_top10)):
        cm = {y: df[(df.race == "white") & (df.sex == "male")][wcols[y]].values for y in YEARS}
        cf = {y: df[(df.race == "white") & (df.sex == "female")][wcols[y]].values for y in YEARS}
        dm = boot_cell(cm["1996"], conv, fn) - boot_cell(cm["1990"], conv, fn)
        dfem = boot_cell(cf["1996"], conv, fn) - boot_cell(cf["1990"], conv, fn)
        d = dfem - dm
        d = d[~np.isnan(d)]
        obs = (statblock(cf["1996"], conv)[nm] - statblock(cf["1990"], conv)[nm]) - \
              (statblock(cm["1996"], conv)[nm] - statblock(cm["1990"], conv)[nm])
        dd_rows.append(dict(statistic=nm, convention=conv, change_male=np.nanmean(dm),
                            change_female=np.nanmean(dfem), diff_in_diff=obs,
                            ci_lo=np.percentile(d, 2.5), ci_hi=np.percentile(d, 97.5),
                            p_two_sided_approx=2 * min((d <= 0).mean(), (d >= 0).mean())))
did = pd.DataFrame(dd_rows)
did.to_csv("out/diff_in_diff.csv", index=False)

# ---------- paired within-respondent sensitivity (both years positive) ----------
pair_rows = []
for cell, (r, s) in CELLS.items():
    sub = df[(df.race == r) & (df.sex == s)]
    m = (sub[wcols["1990"]] > 0) & (sub[wcols["1996"]] > 0)
    a, b = sub.loc[m, wcols["1990"]].values.astype(float), sub.loc[m, wcols["1996"]].values.astype(float)
    pr = dict(cell=cell, n_pair=int(m.sum()),
              gini90=gini(a), gini96=gini(b), gini_change=gini(b) - gini(a),
              p90p50_90=np.percentile(a, 90) / np.percentile(a, 50),
              p90p50_96=np.percentile(b, 90) / np.percentile(b, 50),
              top10_90=shares(a)[0], top10_96=shares(b)[0],
              median_ratio=np.median(b) / np.median(a),
              mean_log_change=np.mean(np.log(b) - np.log(a)),
              pct_wealth_increased=float(np.mean(b > a)),
              zero_flows=dict(z90_only_pos96=int(((sub[wcols["1990"]] == 0) & (sub[wcols["1996"]] > 0)).sum()),
                              pos90_z96=int(((sub[wcols["1990"]] > 0) & (sub[wcols["1996"]] == 0)).sum())))
    n = int(m.sum()); idx = RNG.integers(0, n, size=(B, n))
    bgini = np.array([gini(b[i]) - gini(a[i]) for i in idx])
    pr["gini_change_ci_lo"], pr["gini_change_ci_hi"] = np.nanpercentile(bgini, [2.5, 97.5])
    pair_rows.append(pr)
paired = pd.DataFrame(pair_rows)
paired.to_csv("out/paired_sensitivity.csv", index=False)

# ---------- descriptive: ever_jailed, missing-by-convention flows ----------
ej = df[df.race.isin(["white"])].groupby("sex").ever_jailed.agg(
        n="size", n_ever_jailed="sum").assign(share_ever_jailed=lambda d: d.n_ever_jailed / d.n)
ej.to_csv("out/ever_jailed_descriptives.csv")
counts = table[["cell", "year", "n_all", "n_positive", "share_zero", "share_negative"]] \
    .drop_duplicates().sort_values(["cell", "year"])
counts.to_csv("out/zero_missing_by_convention.csv", index=False)

# ---------- console report ----------
pd.set_option("display.width", 200, "display.max_columns", 40)
show = table[table.convention != "raw"][["cell", "year", "convention", "basis_n", "gini",
        "p90_p50", "p90_p75", "p75_p25", "p90_p10", "top10_share", "top1_share", "mean_median_ratio",
        "mean", "median", "p10", "p25", "p75", "p90", "p95", "sd", "sd_log_positive"]]
print("=== GROUP x YEAR (pos = headline, zk = co-primary sensitivity) ===")
print(show.to_string(index=False, float_format=lambda v: f"{v:,.3f}"))
print("\n=== RAW-SCALE CONTEXT (all rows, negatives allowed) ===")
print(table[table.convention == "raw"][["cell", "year", "n_all", "n_positive", "share_zero",
      "share_negative", "mean", "median", "sd", "p10", "p25", "p75", "p90"]].to_string(
      index=False, float_format=lambda v: f"{v:,.3f}"))
print("\n=== 1990->1996 CHANGE + BOOTSTRAP 95pct CI, B = " + str(B) + " ===")
print(change.to_string(index=False, float_format=lambda v: f"{v:,.4f}"))
print("\n=== DIFF-IN-DIFF (female change - male change) ===")
print(did.to_string(index=False, float_format=lambda v: f"{v:,.4f}"))
print("\n=== PAIRED 1990&1996-POSITIVE SENSITIVITY ===")
print(paired.T.to_string(float_format=lambda v: f"{v:,.4f}"))
print("\n=== ever_jailed (descriptive, white respondents) ===")
print(ej.to_string(float_format=lambda v: f"{v:,.4f}"))
print("\n=== 1985 BACKGROUND (pos convention) ===")
print(table[(table.year == "1985") & (table.convention == "pos")][
      ["cell", "basis_n", "gini", "p90_p50", "top10_share", "median"]].to_string(
      index=False, float_format=lambda v: f"{v:,.3f}"))


# ---------- compact markdown summary ----------
def fmt(v, d=3):
    return "n/a" if v is None or (isinstance(v, float) and np.isnan(v)) else f"{v:,.{d}f}"

lines = ["# Group x year (headline = pos, co-primary = zk, extra = pneg0)", ""]
cols = ["basis_n", "gini", "p90_p50", "p90_p75", "p75_p25", "p90_p10", "top10_share", "top1_share",
        "mean_median_ratio", "mean", "median", "p10", "p25", "p75", "p90", "p95", "sd",
        "sd_log_positive"]
for conv in ("pos", "zk", "pneg0"):
    sub = table[table.convention == conv]
    lines.append("## convention = " + conv)
    lines.append("| cell | year | " + " | ".join(cols) + " |")
    lines.append("|" + "---|" * (len(cols) + 2))
    for _, rr in sub.iterrows():
        lines.append("| " + rr.cell + " | " + rr.year + " | " +
                     " | ".join(fmt(rr[c], 4 if c in ("gini", "top10_share", "top1_share") else 3)
                                for c in cols) + " |")
    lines.append("")
with open("out/results_summary.md", "w") as fh:
    fh.write("\n".join(lines))
print("\nwrote out/results_summary.md")
