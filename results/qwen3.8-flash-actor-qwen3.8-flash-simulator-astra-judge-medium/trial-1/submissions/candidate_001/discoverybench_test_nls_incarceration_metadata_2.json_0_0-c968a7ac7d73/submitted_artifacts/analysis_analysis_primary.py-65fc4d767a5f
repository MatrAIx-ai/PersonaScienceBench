"""PRIMARY analysis: crude jailed vs non-jailed wealth comparison by year (1985/1990/1996).
Spec (researcher-approved): all 12,013 rows, zeros retained, unadjusted.
Decision rule: dual-track agreement
  (a) Welch t-test on signed-log asinh transform, one-sided (jailed < non-jailed), Holm-adj p < .05
  (b) Mann-Whitney U one-sided, Holm-adj p < .05
  (c) bootstrap (2000, stratified, percentile) 95% CI for difference in RAW MEANS, upper bound < 0
No data modification; exploratory results never override primary.
"""
import numpy as np, pandas as pd
from scipy import stats

rng = np.random.default_rng(20261025)
W = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
YEARS = {"composite_wealth_1985": 1985, "composite_wealth_1990": 1990, "composite_wealth_1996": 1996}

def asinh_w(x):                      # signed log: keeps zeros + negatives, monotone
    return np.sign(x) * np.log1p(np.abs(x))

def hedges_g(x, y):
    nx, ny = len(x), len(y)
    sp = np.sqrt(((nx-1)*x.var(ddof=1) + (ny-1)*y.var(ddof=1)) / (nx+ny-2))
    d = (x.mean() - y.mean()) / sp
    J = 1 - 3/(4*(nx+ny) - 9)
    return d*J

def cliffs_delta(x, y):
    # rank-biserial from MW U
    nx, ny = len(x), len(y)
    u = stats.mannwhitneyu(x, y, alternative="two-sided").statistic
    return 2*u/(nx*ny) - 1

def hodges_lehmann(x, y):
    d = (x[:, None] - y[None, :]).ravel()
    return float(np.median(d)) if d.size <= 4_000_000 else float(np.median(rng.choice(d, 4_000_000, replace=False)))

def boot_ci(x, y, stat=np.mean, B=2000, alpha=0.05):
    s = np.empty(B)
    for b in range(B):
        s[b] = stat(rng.choice(x, x.size, replace=True)) - stat(rng.choice(y, y.size, replace=True))
    return float(np.percentile(s, 100*alpha/2)), float(np.percentile(s, 100*(1-alpha/2))), s

def holm(pvals):
    """Holm step-down; returns adjusted p (monotone)."""
    names = list(pvals); p = np.array([pvals[n] for n in names])
    order = np.argsort(p); adj = np.empty(len(p)); running = 0.0; m = len(p)
    for rank, idx in enumerate(order):
        val = (m - rank) * p[idx]
        running = max(running, val)
        adj[idx] = min(1.0, running)
    return dict(zip(names, adj))

df = pd.read_csv("data/nls_incarceration_processed.csv")
assert len(df) == 12013 and not bool(df.isna().any().any())
rows = []
p_welch, p_mw, boot_mean = {}, {}, {}

for c in W:
    yr = YEARS[c]
    j1 = df.loc[df.ever_jailed == 1, c].to_numpy(float)
    j0 = df.loc[df.ever_jailed == 0, c].to_numpy(float)
    a1, a0 = asinh_w(j1), asinh_w(j0)

    t2 = stats.ttest_ind(a1, a0, equal_var=False)
    p_welch[yr] = float(t2.pvalue/2) if t2.statistic < 0 else 1.0 - t2.pvalue/2   # one-sided H1: jailed <
    u = stats.mannwhitneyu(a1, a0, alternative="less")
    p_mw[yr] = float(u.pvalue)
    lo, hi, dist = boot_ci(j1, j0, np.mean, B=2000)
    boot_mean[yr] = (lo, hi)
    mlo, mhi, _ = boot_ci(j1, j0, np.median, B=2000)

    rows.append(dict(
        year=yr, n_jailed=len(j1), n_nonjailed=len(j0),
        mean_jailed=j1.mean(), mean_nonjailed=j0.mean(), mean_ratio=j1.mean()/j0.mean(),
        median_jailed=float(np.median(j1)), median_nonjailed=float(np.median(j0)),
        mean_diff_dollars=j1.mean()-j0.mean(), mean_diff_boot_lo=lo, mean_diff_boot_hi=hi,
        boot_p_less=float((dist >= 0).mean()),
        median_diff_dollars=float(np.median(j1)-np.median(j0)),
        median_diff_boot_lo=mlo, median_diff_boot_hi=mhi,
        asinh_mean_jailed=a1.mean(), asinh_mean_nonjailed=a0.mean(), asinh_diff=a1.mean()-a0.mean(),
        welch_t=float(t2.statistic), welch_df=float(t2.df), p_welch_1sided=p_welch[yr],
        hedges_g_asinh=hedges_g(a1, a0), cliffs_delta=cliffs_delta(a1, a0),
        hodges_lehmann_asinh=hodges_lehmann(rng.choice(a1, min(len(a1),289)), a0),
        pct_below_overall_median=100*(j1 < np.median(df[c])).mean(),
        zero_pct_jailed=100*(j1 == 0).mean(), zero_pct_nonjailed=100*(j0 == 0).mean(),
    ))

res = pd.DataFrame(rows)
res["p_welch_holm"] = [holm(p_welch)[y] for y in res.year] if False else list(holm(p_welch).values())
res["p_mw_holm"]    = list(holm(p_mw).values())
res["welch_pass"]   = (res.p_welch_holm < 0.05) & (res.p_welch_1sided < 0.05)
res["mw_pass"]      = res.p_mw_holm < 0.05
res["boot_pass"]    = res.mean_diff_boot_hi < 0
res["direction_negative"] = res.mean_diff_dollars < 0
res["AGREE_all3"]   = res.welch_pass & res.mw_pass & res.boot_pass
res["split_decision"] = res.direction_negative & (~res.AGREE_all3)

pd.set_option("display.width", 250, "display.max_columns", 60)
res.to_csv("results_primary.csv", index=False)
print("=== PRIMARY: crude unadjusted, N=12,013, zeros retained ===")
cols = ["year","n_jailed","n_nonjailed","mean_jailed","mean_nonjailed","mean_ratio","median_jailed",
        "median_nonjailed","mean_diff_dollars","mean_diff_boot_lo","mean_diff_boot_hi",
        "asinh_diff","hedges_g_asinh","cliffs_delta","hodges_lehmann_asinh",
        "welch_t","welch_df","p_welch_1sided","p_welch_holm","p_mw_holm","boot_p_less",
        "welch_pass","mw_pass","boot_pass","AGREE_all3","split_decision"]
print(res[cols].to_string(index=False))
print("\nMedian-diff bootstrap CIs:")
print(res[["year","median_diff_dollars","median_diff_boot_lo","median_diff_boot_hi"]].to_string(index=False))
print("\nZero-share context:")
print(res[["year","zero_pct_jailed","zero_pct_nonjailed","pct_below_overall_median"]].to_string(index=False))
print("\nYEARS MEETING ALL THREE CRITERIA:", res.loc[res.AGREE_all3, "year"].tolist())
print("SPLIT-DECISION YEARS:", res.loc[res.split_decision, "year"].tolist())
