"""SENSITIVITY (lean, direction + conclusion-change only) + EXPLORATORY adjusted runs.
Sensitivities: dedupe / exclude-zeros / extensive-margin P(wealth>0) / winsorized 1-99 / positive-only log.
Exploratory (never overrides primary): OLS with sex+race, male-only, race-stratified.
"""
import numpy as np, pandas as pd, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats
rng = np.random.default_rng(7)
W = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
YRS = {1985:"composite_wealth_1985",1990:"composite_wealth_1990",1996:"composite_wealth_1996"}
sl = lambda x: np.sign(x)*np.log1p(np.abs(x))
def holm(p):
    ks=list(p); pv=np.array([p[k] for k in ks]); o=np.argsort(pv); a=np.empty(len(pv)); run=0
    for r,i in enumerate(o): run=max(run,(len(pv)-r)*pv[i]); a[i]=min(1,run)
    return dict(zip(ks,a))

def hedges_g(x,y):
    nx,ny=len(x),len(y)
    sp=np.sqrt(((nx-1)*x.var(ddof=1)+(ny-1)*y.var(ddof=1))/(nx+ny-2))
    return (x.mean()-y.mean())/sp*(1-3/(4*(nx+ny)-9))

def mw_less(a,b): return float(stats.mannwhitneyu(a,b,alternative="less").pvalue)
def welch_less(a,b):
    t=stats.ttest_ind(a,b,equal_var=False)
    return float(t.statistic), (float(t.pvalue/2) if t.statistic<0 else 1-float(t.pvalue/2))
def boot_hi(x,y,B=1500,stat=np.mean):
    s=np.array([stat(rng.choice(x,x.size,True))-stat(rng.choice(y,y.size,True)) for _ in range(B)])
    return float(np.percentile(s,97.5))

df = pd.read_csv("data/nls_incarceration_processed.csv")
frames=[]

def add(spec, yr, n1, n0, mean1, mean0, g, p_w, p_m, bhi, note=""):
    frames.append(dict(spec=spec, year=yr, n_jailed=n1, n_nonjailed=n0,
        mean_ratio=mean1/mean0 if mean0 else np.nan, mean_diff=mean1-mean0,
        hedges_g=g, p_welch_1s=p_w, p_mw_1s=p_m, boot_upper=bhi,
        direction_lower=(mean1-mean0)<0))

def run_spec(name, d, per_year_mask=None):
    """per_year_mask(c)->boolean Series applied WITHIN that year only (avoids triennial over-conditioning)."""
    pw, pm = {}, {}
    for yr,c in YRS.items():
        dd = d if per_year_mask is None else d.loc[per_year_mask(d,c)]
        j1=dd.loc[dd.ever_jailed==1,c].to_numpy(float); j0=dd.loc[dd.ever_jailed==0,c].to_numpy(float)
        a1,a0=sl(j1),sl(j0)
        t,pw_=welch_less(a1,a0); pm_=mw_less(a1,a0); pw[yr],pm[yr]=pw_,pm_
        g = hedges_g(a1, a0)
        bh=boot_hi(j1,j0)
        add(name,yr,len(j1),len(j0),j1.mean(),j0.mean(),g,pw_,pm_,bh)
    pw_h=holm(pw); pm_h=holm(pm)
    return pw_h, pm_h

# S1 dedupe exact duplicate rows
res_pw={}
pw,pm = run_spec("S1_dedupe_exact_duplicates", df.drop_duplicates())
# S2 exclude zeros WITHIN each year (treat 0 as possible non-response)
pw2,pm2 = run_spec("S2_exclude_zeros_within_year", df, per_year_mask=lambda d,c: d[c]!=0)
# S3 winsorize 1st/99th pct per year
d3 = df.copy()
for c in W:
    lo,hi = np.percentile(d3[c],[1,99]); d3[c]=d3[c].clip(lo,hi)
pw3,pm3 = run_spec("S3_winsorized_1_99", d3)
# S4 positive-only WITHIN each year (strictly positive wealth, log-scale valid)
pw4,pm4 = run_spec("S4_positive_only_within_year", df, per_year_mask=lambda d,c: d[c]>0)

sens = pd.DataFrame(frames)
# attach Holm p per spec
for spec,dic in [("S1_dedupe_exact_duplicates",None)]: pass
holms = {"S1_dedupe_exact_duplicates":(pw,pm),"S2_exclude_zeros_within_year":(pw2,pm2),
         "S3_winsorized_1_99":(pw3,pm3),"S4_positive_only_within_year":(pw4,pm4)}
sens["p_welch_holm"]=[holms[r.spec][0][r.year] for r in sens.itertuples()]
sens["p_mw_holm"]=[holms[r.spec][1][r.year] for r in sens.itertuples()]

# S5 extensive margin: P(wealth>0)
em=[]
for yr,c in YRS.items():
    tab=pd.crosstab(df.ever_jailed, df[c]>0)
    chi=stats.chi2_contingency(tab.values)
    p1=(df.loc[df.ever_jailed==1,c]>0).mean(); p0=(df.loc[df.ever_jailed==0,c]>0).mean()
    rr=p1/p0
    se=np.sqrt((1-p1)/(p1*tab.loc[1,True])+(1-p0)/(p0*tab.loc[0,True]))
    z=np.log(rr)/se
    em.append(dict(spec="S5_extensive_margin_P(wealth>0)",year=yr,share_positive_jailed=p1,
        share_positive_nonjailed=p0,risk_ratio=rr,chi2=chi.statistic,p_chi2=chi.pvalue,
        z_log_rr=z,p_log_rr_less=stats.norm.cdf(z),direction_lower=p1<p0))
em=pd.DataFrame(em)
out=pd.concat([sens,em],axis=0,ignore_index=True)
out.to_csv("results_sensitivity.csv",index=False)
pd.set_option("display.width",250,"display.max_columns",60)
print("=== SENSITIVITY SUMMARY (direction + conclusion change) ===")
print(sens[["spec","year","n_jailed","n_nonjailed","mean_ratio","mean_diff","hedges_g",
            "p_welch_1s","p_welch_holm","p_mw_holm","boot_upper","direction_lower"]].to_string(index=False))
print("\n=== S5 extensive margin ===")
print(em[["year","share_positive_jailed","share_positive_nonjailed","risk_ratio","p_chi2","p_log_rr_less","direction_lower"]].to_string(index=False))

# ---------------- EXPLORATORY ----------------
print("\n\n=== EXPLORATORY (does NOT override primary) ===")
ex=[]
for yr,c in YRS.items():
    d=df.copy(); d["y"]=sl(d[c]); d["wj"]=d.ever_jailed
    m=smf.ols("y ~ wj + C(sex) + C(race)", data=d).fit(cov_type="HC3")
    ci=m.conf_int().loc["wj"]
    ex.append(dict(model=f"E1_OLS_sex_race_{yr}", est=m.params["wj"], se=m.bse["wj"],
                   t=m.tvalues["wj"], p_one=m.pvalues["wj"]/2 if m.params["wj"]<0 else 1-m.pvalues["wj"]/2,
                   ci_lo=ci[0], ci_hi=1e9, extra="asinh outcome; HC3"))
    m2=smf.ols(f"{c} ~ wj + C(sex) + C(race)", data=d).fit(cov_type="HC3")
    ci2=m2.conf_int().loc["wj"]
    ex.append(dict(model=f"E1b_OLS_dollars_{yr}", est=m2.params["wj"], se=m2.bse["wj"],
                   t=m2.tvalues["wj"], p_one=m2.pvalues["wj"]/2 if m2.params["wj"]<0 else 1-m2.pvalues["wj"]/2,
                   ci_lo=ci2[0], ci_hi=ci2[1], extra="dollars outcome"))
    dm=d[d.sex=="male"]
    mm=smf.ols("y ~ wj", data=dm.assign(y=sl(dm[c]))).fit(cov_type="HC3")
    ex.append(dict(model=f"E2_male_only_{yr}", est=mm.params["wj"], se=mm.bse["wj"], t=mm.tvalues["wj"],
                   p_one=mm.pvalues["wj"]/2 if mm.params["wj"]<0 else 1-mm.pvalues["wj"]/2,
                   ci_lo=mm.conf_int().loc["wj"][0], ci_hi=1e9, extra=f"n_male_jailed={int((dm.ever_jailed==1).sum())}"))
    for r_ in ["white","black","hipanic"]:
        dr=d[d.race==r_]
        mr=smf.ols("y ~ wj", data=dr.assign(y=sl(dr[c]))).fit(cov_type="HC3")
        ex.append(dict(model=f"E3_race={r_}_{yr}", est=mr.params["wj"], se=mr.bse["wj"], t=mr.tvalues["wj"],
                       p_one=mr.pvalues["wj"]/2 if mr.params["wj"]<0 else 1-mr.pvalues["wj"]/2,
                       ci_lo=mr.conf_int().loc["wj"][0], ci_hi=1e9,
                       extra=f"n_jailed={int((dr.ever_jailed==1).sum())}"))
exd=pd.DataFrame(ex)
# Holm within each exploratory family
fam=[]
for prefix in ["E1_OLS_sex_race","E1b_OLS_dollars","E2_male_only","E3_race=white","E3_race=black","E3_race=hipanic"]:
    idx=exd.model.str.startswith(prefix)
    sub=dict(zip(exd.loc[idx,"model"], exd.loc[idx,"p_one"]))
    h=holm(sub)
    exd.loc[idx,"p_holm"]=[h[m_] for m_ in exd.loc[idx,"model"]]
exd["sig_holm"]=exd.p_holm<0.05
exd.to_csv("results_exploratory.csv",index=False)
print(exd[["model","est","se","t","p_one","p_holm","sig_holm","extra"]].round(4).to_string(index=False))
print("\nExploratory conclusion-change vs primary (any year/stratum NOT significant):")
print(exd.loc[~exd.sig_holm,["model","est","p_holm"]].round(4).to_string(index=False))
