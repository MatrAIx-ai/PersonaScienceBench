import pandas as pd, numpy as np
df = pd.read_csv("data/nls_incarceration_processed.csv")
print("shape:", df.shape)
print("\n--- dtypes ---")
print(df.dtypes)
print("\n--- head ---")
print(df.head())
print("\n--- missing per column ---")
print(df.isna().sum())
print("\n--- fully duplicated rows:", df.duplicated().sum())
print("\n--- race counts ---")
print(df["race"].value_counts(dropna=False))
print("\n--- sex counts ---")
print(df["sex"].value_counts(dropna=False))
print("\n--- ever_jailed counts ---")
print(df["ever_jailed"].value_counts(dropna=False))
print("ever_jailed unique:", sorted(df["ever_jailed"].dropna().unique()))
print("\n--- race x sex crosstab ---")
print(pd.crosstab(df["race"], df["sex"], margins=True))
print("\n--- race x ever_jailed crosstab ---")
print(pd.crosstab(df["race"], df["ever_jailed"], margins=True))
print("\n--- sex x ever_jailed crosstab ---")
print(pd.crosstab(df["sex"], df["ever_jailed"], margins=True))

wcols = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
print("\n=== wealth column diagnostics ===")
for c in wcols:
    s = df[c]
    print(f"\n[{c}] dtype={s.dtype}")
    print("  n_nonnull=%d  n_missing=%d (%.2f%%)" % (s.notna().sum(), s.isna().sum(), 100*s.isna().mean()))
    v = s.dropna()
    print("  min=%.1f  max=%.1f  mean=%.1f  median=%.1f  std=%.1f" % (v.min(), v.max(), v.mean(), v.median(), v.std()))
    print("  quantiles:", {q: round(float(v.quantile(q)),1) for q in [0.01,0.05,0.10,0.25,0.5,0.75,0.9,0.95,0.99]})
    print("  n_zero=%d (%.2f%%)  n_negative=%d (%.2f%%)  n_positive=%d (%.2f%%)" % (
        (v==0).sum(), 100*(v==0).mean(), (v<0).sum(), 100*(v<0).mean(), (v>0).sum(), 100*(v>0).mean()))
    print("  skewness=%.3f  kurtosis=%.3f" % (v.skew(), v.kurtosis()))
    print("  log1p skew=%.3f" % np.log1p(v.clip(lower=0)).skew())
    # outlier counts beyond 1.5 IQR fences
    q1,q3 = v.quantile(.25), v.quantile(.75); iqr=q3-q1
    print("  Tukey fences: lo=%.1f hi=%.1f ; n_below=%d n_above=%d" % (q1-1.5*iqr, q3+1.5*iqr, (v<q1-1.5*iqr).sum(), (v>q3+1.5*iqr).sum()))
    print("  top5 values:", sorted(v.tolist())[-5:])
    print("  bottom5 values:", sorted(v.tolist())[:5])
    # granularity
    print("  unique values: %d ; divisible by 100: %.1f%%" % (v.nunique(), 100*(v % 100 == 0).mean()))

print("\n=== raw mean/median wealth by ever_jailed ===")
t = df.groupby("ever_jailed")[wcols].agg(["count","mean","median"])
print(t.round(1))
print("\n--- wide format ---")
tab = pd.DataFrame({
 "mean_1985": df.groupby("ever_jailed")["composite_wealth_1985"].mean(),
 "median_1985": df.groupby("ever_jailed")["composite_wealth_1985"].median(),
 "mean_1990": df.groupby("ever_jailed")["composite_wealth_1990"].mean(),
 "median_1990": df.groupby("ever_jailed")["composite_wealth_1990"].median(),
 "mean_1996": df.groupby("ever_jailed")["composite_wealth_1996"].mean(),
 "median_1996": df.groupby("ever_jailed")["composite_wealth_1996"].median(),
}).round(1)
print(tab.T)
print("\nn per group:", df["ever_jailed"].value_counts().to_dict())
print("\n--- complete cases across all 3 wealth cols ---")
print(df[wcols].notna().all(axis=1).sum(), "of", len(df))
