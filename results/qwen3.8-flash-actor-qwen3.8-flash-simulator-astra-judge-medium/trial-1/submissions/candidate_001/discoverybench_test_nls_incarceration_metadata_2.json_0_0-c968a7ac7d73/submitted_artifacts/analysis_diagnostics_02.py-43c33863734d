import pandas as pd, numpy as np
df = pd.read_csv("data/nls_incarceration_processed.csv")
w = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]

print("=== zero-as-missing pattern checks (descriptive only) ===")
z = (df[w]==0).astype(int)
print("zero-rate by ever_jailed:")
print(df.assign(**{f"z_{c[-4:]}":(df[c]==0).astype(int) for c in w}).groupby("ever_jailed")[[f"z_{c[-4:]}" for c in w]].mean().round(3))
print("\nn with all three years == 0:", int(((df[w]==0).all(axis=1)).sum()))
print("n with all three years negative:", int(((df[w]<0).all(axis=1)).sum()))
print("\ncorrelation matrix (Spearman) across years:")
print(df[w].corr(method="spearman").round(3))
print("\nrows where 1985==0 & 1990==0 but 1996>0:", int(((df.w_1985 if False else df['composite_wealth_1985']==0) & (df['composite_wealth_1990']==0) & (df['composite_wealth_1996']>0)).sum()))

print("\n=== duplicate rows ===")
dupmask = df.duplicated(keep=False)
print("rows involved in exact duplicates:", int(dupmask.sum()), "; distinct duplicated tuples:", df[df.duplicated(keep='first')].shape[0])
print("dup rate within ever_jailed==1: %.2f%% ; within 0: %.2f%%" % (
    100*df[df.ever_jailed==1].duplicated().mean(), 100*df[df.ever_jailed==0].duplicated().mean()))
print("\nMost frequent duplicated tuples:")
print(df.value_counts().head(5))

print("\n=== wealth distribution: jailed vs non-jailed, per year (no tests) ===")
for c in w:
    g0 = df.loc[df.ever_jailed==0, c]; g1 = df.loc[df.ever_jailed==1, c]
    print(f"\n{c}")
    print("  jailed=1 : n=%d mean=%9.1f median=%8.1f p25=%8.1f p75=%9.1f p90=%10.1f zero%%=%.1f neg%%=%.1f" % (
        len(g1), g1.mean(), g1.median(), g1.quantile(.25), g1.quantile(.75), g1.quantile(.9), 100*(g1==0).mean(), 100*(g1<0).mean()))
    print("  jailed=0 : n=%d mean=%9.1f median=%8.1f p25=%8.1f p75=%9.1f p90=%10.1f zero%%=%.1f neg%%=%.1f" % (
        len(g0), g0.mean(), g0.median(), g0.quantile(.25), g0.quantile(.75), g0.quantile(.9), 100*(g0==0).mean(), 100*(g0<0).mean()))
    print("  ratio of means=%.2f ; diff of medians=%.1f ; share of jailed below overall median: %.1f%%" % (
        g1.mean()/g0.mean(), g1.median()-g0.median(), 100*(g1 < df[c].median()).mean()))

print("\n=== sex composition by ever_jailed (confounder check) ===")
print(pd.crosstab(df.ever_jailed, df.sex, normalize='index').round(3))
print("\n=== wealth by sex x ever_jailed (means, 1996) ===")
print(df.pivot_table(index='sex', columns='ever_jailed', values='composite_wealth_1996', aggfunc=['mean','median','count']).round(1))
print("\n=== within-male-only raw means by year ===")
m = df[df.sex=='male']
print(m.pivot_table(index='ever_jailed', values=w, aggfunc=['mean','median']).round(1))
