import numpy as np, pandas as pd
from scipy import stats
rng=np.random.default_rng(99)
df=pd.read_csv("data/nls_incarceration_processed.csv")
W=["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]

# --- bootstrap seed-stability check (primary CI robustness) ---
print("=== bootstrap CI seed stability (difference in means, $) ===")
for seed in (1,2,99):
    r=np.random.default_rng(seed); out=[]
    for c in W:
        j1=df.loc[df.ever_jailed==1,c].to_numpy(float); j0=df.loc[df.ever_jailed==0,c].to_numpy(float)
        s=np.array([r.choice(j1,j1.size,True).mean()-r.choice(j0,j0.size,True).mean() for _ in range(2000)])
        out.append(f"{c[-4:]}: [{np.percentile(s,2.5):.0f}, {np.percentile(s,97.5):.0f}]")
    print(" seed",seed," | ".join(out))

# --- interpretive magnitudes ---
print("\n=== practical-magnitude framing ===")
for c in W:
    j1=df.loc[df.ever_jailed==1,c].to_numpy(float); j0=df.loc[df.ever_jailed==0,c].to_numpy(float)
    print(f"{c}: jailed mean = {j1.mean():,.0f} vs {j0.mean():,.0f} -> {100*j1.mean()/j0.mean():.1f}% of non-jailed "
          f"({100*(1-j1.mean()/j0.mean()):.1f}% lower); median {np.median(j1):,.0f} vs {np.median(j0):,.0f}; "
          f"jailed in bottom sample decile: {100*(j1<=np.percentile(df[c],10)).mean():.1f}% vs "
          f"{100*(j0<=np.percentile(df[c],10)).mean():.1f}%")

# --- consolidated FINAL table ---
p=pd.read_csv("results_primary.csv"); s=pd.read_csv("results_sensitivity.csv")
fin=p[["year","n_jailed","n_nonjailed","mean_jailed","mean_nonjailed","mean_ratio","median_jailed","median_nonjailed",
       "mean_diff_dollars","mean_diff_boot_lo","mean_diff_boot_hi","p_welch_1sided","p_welch_holm","p_mw_holm",
       "hedges_g_asinh","cliffs_delta","welch_pass","mw_pass","boot_pass","AGREE_all3"]].copy()
for yr in (1985,1990,1996):
    for spec in ["S1_dedupe_exact_duplicates","S2_exclude_zeros_within_year","S3_winsorized_1_99","S4_positive_only_within_year"]:
        r=s[(s.year==yr)&(s.spec==spec)]
        fin.loc[fin.year==yr, f"consig_{spec[:2]}"] = bool(r.p_welch_holm.iloc[0]<0.05 and r.p_mw_holm.iloc[0]<0.05 and r.boot_upper.iloc[0]<0) if len(r) else None
    er=s[(s.year==yr)&(s.spec.str.startswith("S5"))]
    fin.loc[fin.year==yr,"consig_S5"]=bool(er.direction_lower.iloc[0] and er.p_log_rr_less.iloc[0]<0.05)
fin.to_csv("results_final_table.csv",index=False)
pd.set_option("display.width",250,"display.max_columns",60)
print("\n=== FINAL TABLE ===")
print(fin.round(4).to_string(index=False))
print("\nPrimary conclusion years:", fin.loc[fin.AGREE_all3,"year"].tolist())
print("All sensitivities confirm for every year:", bool(fin[[c for c in fin.columns if c.startswith('consig')]].all().all()))
