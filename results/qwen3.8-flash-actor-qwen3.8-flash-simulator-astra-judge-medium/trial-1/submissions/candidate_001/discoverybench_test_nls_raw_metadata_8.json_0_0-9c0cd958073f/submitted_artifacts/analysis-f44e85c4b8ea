#!/usr/bin/env python3
"""
NLSY79 (data/nls_raw.csv): median family net wealth of white (non-Hispanic, cohort 3)
vs black (cohort 1) and Hispanic (cohort 2) respondents, 1985 / 1990 / 1996.

Design decisions (approved by researcher):
  * Headline  = UNWEIGHTED complete-case medians per wave (blanks = non-response, dropped; no imputation).
  * Balanced-panel sensitivity (observed in all three waves) = main defence against 1996 attrition.
  * p99-winsorised medians = robustness only (source data already top-coded near p99).
  * Nominal-year dollars are primary; a labelled constant-1996-dollar sensitivity uses external CPI-U.
  * Composition decomposition is SECONDARY / lower confidence (blank -> 0 is an assumption; ownership
    rate reported beside each conditional mean; farm/business/other property descriptive only).
  * Family/spouse-unit net wealth (only wealth construct in the file). No causal/population claims.
Usage: python3 analysis/nls_wealth_analysis.py [csv] [out_dir]
"""
import os, sys
import numpy as np
import pandas as pd

RAW = sys.argv[1] if len(sys.argv) > 1 else "data/nls_raw.csv"
OUT = sys.argv[2] if len(sys.argv) > 2 else "results"

COHORTS = {1: "Black", 2: "Hispanic", 3: "White (non-Hispanic)"}
YEARS = [1985, 1990, 1996]
WEALTH_COLS = {1985: "Family net wealth, 1985",
               1990: "Family net wealth, 1990",
               1996: "Family net wealth, 1996 (key data point)"}
CPI = {1985: 107.6, 1990: 130.7, 1996: 156.9}   # external CPI-U, not verifiable in the data
BASE_YEAR = 1996
RNG = np.random.default_rng(20261022)
BOOT = 1000

COMPONENTS = {
    "Residential property": {1985: "Market value of residential property respondent/spouse own, 1985",
                             1990: "Market value of residential property respondent/spouse own, 1990",
                             1996: "Market value of residential property respondent/spouse own, 1996"},
    "Farm/business/other property": {1985: "Total market value of farm, business, and other property, 1985",
                                     1990: "Total market value of farm, business, and other property, 1990",
                                     1996: "Total market value of farm, business, and other property, 1996"},
    "Vehicles": {1985: "Market Value of vehicles respondent/spouse own, 1985",
                 1990: "Market Value of vehicles respondent/spouse own, 1990",
                 1996: "Market Value of vehicles respondent/spouse own, 96"},
    "Items over $500": {1985: "Total market value of items over $500, 1985",
                        1990: "Total market value of items over $500, 1990",
                        1996: "Total market value of items over $500, 1996"},
}

pd.set_option("display.width", 240)
pd.set_option("display.max_columns", 60)
pd.set_option("display.float_format", lambda v: f"{v:,.3f}")

LINES = []
def echo(*a):
    s = " ".join(str(x) for x in a)
    print(s); LINES.append(s); LINES.append("")

def load(path):
    """Read as strings; coerce numerics. Empty string is the ONLY missing code (verified)."""
    df = pd.read_csv(path, dtype=str, keep_default_na=False)
    df.columns = [c.strip() for c in df.columns]
    out = pd.DataFrame()
    out["id"] = pd.to_numeric(df[df.columns[0]].str.strip(), errors="coerce")
    out["cohort"] = pd.to_numeric(df["Racial/ethnic cohort, 1979"].str.strip(), errors="coerce")
    out["sample_id"] = pd.to_numeric(df["Sample ID, 1979 (interview)"].str.strip(), errors="coerce")
    for y, c in WEALTH_COLS.items():
        out[f"w{y}"] = pd.to_numeric(df[c].str.strip().replace("", np.nan), errors="coerce")
    for name, per_year in COMPONENTS.items():
        for y, c in per_year.items():
            out[f"c_{name}_{y}"] = pd.to_numeric(df[c].str.strip().replace("", np.nan), errors="coerce")
    return out

def wide(metric, values):
    """One-row series with (year, cohort) in the COLUMNS."""
    cols, row = [], []
    for y in YEARS:
        for c, lab in COHORTS.items():
            cols.append((y, lab)); row.append(values[(y, c)][metric])
    return pd.Series(row, index=pd.MultiIndex.from_tuples(cols, names=["year", "cohort"]), name=metric)

def stack(tbl):
    return pd.concat(tbl, axis=1).T

def cell_stats(s):
    s = s.dropna()
    if len(s) == 0:
        return {k: np.nan for k in ["n", "median", "boot_lo", "boot_hi", "mean", "p25", "p75", "p90", "share<=0"]}
    boots = np.median(RNG.choice(s.to_numpy(), size=(BOOT, len(s)), replace=True), axis=1)
    return {"n": len(s), "median": float(np.median(s)),
            "boot_lo": float(np.percentile(boots, 2.5)), "boot_hi": float(np.percentile(boots, 97.5)),
            "mean": float(s.mean()), "p25": float(np.percentile(s, 25)),
            "p75": float(np.percentile(s, 75)), "p90": float(np.percentile(s, 90)),
            "share<=0": float((s <= 0).mean())}

def ratios(med):
    r = {}
    for y in YEARS:
        for c in (1, 2):
            b = med[(y, c)]
            r[(y, c)] = {"ratio": (med[(y, 3)] / b) if (b and np.isfinite(b) and b > 0) else np.nan,
                         "gap": med[(y, 3)] - b}
    return r

def ratio_table(rr, tag=""):
    rows, idx = [], [("white:black", 1), ("white:hispanic", 2)]
    out = {}
    for lbl, c in idx:
        for y in YEARS:
            out[f"{lbl} {y}"] = rr[(y, c)]["ratio"]
    return pd.Series(out, name=tag)

def main():
    df = load(RAW)
    echo("=" * 110)
    echo("NLSY79 family net wealth by racial/ethnic cohort, 1985 / 1990 / 1996")
    echo(f"file={RAW}  rows={len(df)}")
    echo("OPERATIONALISATION: 'white' == Racial/ethnic cohort, 1979 == 3 (NON-BLACK NON-HISPANIC).")
    echo("Wealth measure = FAMILY net wealth of respondents (respondent/spouse unit): assets minus debts, as supplied.")
    echo("HEADLINE: unweighted complete-case medians per wave, nominal-year dollars, no imputation, no winsorising.")
    echo("=" * 110)

    # ---------------- TABLE 0: audit ----------------
    echo("--- TABLE 0. Coverage / value ranges of family net wealth ---")
    rows = []
    for y in YEARS:
        s_all = df[f"w{y}"]
        rows.append({"year": y, "cohort": "ALL respondents", "n_cohort": len(df), "n_valid": int(s_all.notna().sum()),
                     "pct_valid": 100 * float(s_all.notna().mean()), "min": s_all.min(), "max": s_all.max(),
                     "n_negative": int((s_all < 0).sum()), "n_zero": int((s_all == 0).sum())})
        for c, lab in COHORTS.items():
            s = df.loc[df.cohort == c, f"w{y}"]
            rows.append({"year": y, "cohort": lab, "n_cohort": int((df.cohort == c).sum()),
                         "n_valid": int(s.notna().sum()), "pct_valid": 100 * float(s.notna().mean()),
                         "min": s.min(), "max": s.max(), "n_negative": int((s < 0).sum()), "n_zero": int((s == 0).sum())})
    t0 = pd.DataFrame(rows).set_index(["year", "cohort"])
    echo(t0.to_string())
    echo("Missing = empty string only; no sentinel codes; all non-blank values numeric. Blanks treated as NON-RESPONSE and dropped.")
    echo("Maxima repeat across rows (1,054,132 x16 in 1985; 1,321,099 x84 in 1990; 1,232,183 x141 in 1996; 1996 max == p99)")
    echo("=> the supplied wealth variables are already top-coded near the 99th percentile.")

    # ---------------- TABLE 1: headline ----------------
    stats = {(y, c): cell_stats(df.loc[df.cohort == c, f"w{y}"]) for y in YEARS for c in COHORTS}
    med = {(y, c): stats[(y, c)]["median"] for y in YEARS for c in COHORTS}
    echo("--- TABLE 1. HEADLINE: median family net wealth, nominal-year $ (rows=statistic, columns=year x cohort) ---")
    t1 = stack([wide(m, stats) for m in ["n", "median", "boot_lo", "boot_hi", "mean", "p25", "p75", "p90", "share<=0"]])
    echo("boot_lo/boot_hi = bootstrap 95% CI of the median (1000 reps). share<=0 = share of wave respondents with zero or negative net wealth.")
    echo(t1.to_string())

    # ---------------- TABLE 2: ratios ----------------
    rr = ratios(med)
    t2 = pd.DataFrame({1985: {"white:black": rr[(1985, 1)]["ratio"], "white:hispanic": rr[(1985, 2)]["ratio"]},
                       1990: {"white:black": rr[(1990, 1)]["ratio"], "white:hispanic": rr[(1990, 2)]["ratio"]},
                       1996: {"white:black": rr[(1996, 1)]["ratio"], "white:hispanic": rr[(1996, 2)]["ratio"]}})
    t2.index.name = "ratio (white median / cohort median)"
    echo("--- TABLE 2. White:black and white:hispanic MEDIAN RATIOS (columns = year) ---")
    echo(t2.to_string())

    # ---------------- TABLE 2b: bootstrap CIs on ratios + TABLE 2c quantile ratios ----------------
    cells = {(y, c): df.loc[df.cohort == c, f"w{y}"].dropna().to_numpy() for y in YEARS for c in COHORTS}
    B = 2000
    rb = {(y, c): [] for y in YEARS for c in (1, 2)}
    qr_raw = {(y, c, q): [] for y in YEARS for c in (1, 2) for q in (50, 75, 90)}
    for _ in range(B):
        rs = {k: v[RNG.integers(0, len(v), len(v))] for k, v in cells.items()}
        for y in YEARS:
            wm = np.median(rs[(y, 3)])
            for c in (1, 2):
                bm = np.median(rs[(y, c)])
                rb[(y, c)].append(wm / bm if bm > 0 else np.nan)
                for q in (50, 75, 90):
                    bq = np.percentile(rs[(y, c)], q)
                    qr_raw[(y, c, q)].append(np.percentile(rs[(y, 3)], q) / bq if bq > 0 else np.nan)
    echo("--- TABLE 2b. Bootstrap 95% CIs for the median ratios (columns = year; 2000 resamples within cohort-wave cells) ---")
    echo(pd.DataFrame({y: {"white:black (mean) [95% CI]": f"{np.nanmean(rb[(y,1)]):.2f} [{np.nanpercentile(rb[(y,1)],2.5):.2f}, {np.nanpercentile(rb[(y,1)],97.5):.2f}]",
                           "white:hispanic (mean) [95% CI]": f"{np.nanmean(rb[(y,2)]):.2f} [{np.nanpercentile(rb[(y,2)],2.5):.2f}, {np.nanpercentile(rb[(y,2)],97.5):.2f}]"}
                       for y in YEARS}).to_string())
    echo("--- TABLE 2c. White / cohort ratio of the 50th, 75th and 90th percentiles (is the gap only at the median?) ---")
    t2c = pd.DataFrame({(y, q, "black" if c == 1 else "hispanic"):
                            (np.percentile(cells[(y, 3)], q) / np.percentile(cells[(y, c)], q)
                             if np.percentile(cells[(y, c)], q) > 0 else np.nan)
                        for y in YEARS for q in (50, 75, 90) for c in (1, 2)}, index=[0]).T
    t2c.columns = ["white / cohort ratio (point estimate)"]
    t2c.index = pd.MultiIndex.from_tuples(t2c.index, names=["year", "percentile", "cohort"])
    echo(t2c.to_string())
    echo("Read: ratios well above 1 at every percentile checked => the shortfall is distribution-wide,")
    echo("and is largest at/below the median, where zero-or-negative net wealth is common (see share<=0 in TABLE 1).")

    # ---------------- TABLE 3: absolute gaps ----------------
    t3 = pd.DataFrame({1985: {"white minus black ($)": med[(1985, 3)] - med[(1985, 1)],
                              "white minus hispanic ($)": med[(1985, 3)] - med[(1985, 2)]},
                       1990: {"white minus black ($)": med[(1990, 3)] - med[(1990, 1)],
                              "white minus hispanic ($)": med[(1990, 3)] - med[(1990, 2)]},
                       1996: {"white minus black ($)": med[(1996, 3)] - med[(1996, 1)],
                              "white minus hispanic ($)": med[(1996, 3)] - med[(1996, 2)]}})
    t3.index.name = "absolute gap, nominal $"
    echo("--- TABLE 3. ABSOLUTE dollar gaps (columns = year) ---")
    echo(t3.to_string())

    # ---------------- TABLE 4: balanced panel ----------------
    bal = df[df[["w1985", "w1990", "w1996"]].notna().all(axis=1)]
    bstats = {(y, c): cell_stats(bal.loc[bal.cohort == c, f"w{y}"]) for y in YEARS for c in COHORTS}
    bmed = {(y, c): bstats[(y, c)]["median"] for y in YEARS for c in COHORTS}
    brr = ratios(bmed)
    echo("--- TABLE 4. ROBUSTNESS 1 (primary defence vs 1996 attrition): balanced panel, wealth in ALL THREE waves ---")
    echo(f"balanced n={len(bal)} of {len(df)} ({100*len(bal)/len(df):.1f}%): "
         + ", ".join(f"{lab} n={int((bal.cohort==c).sum())}" for c, lab in COHORTS.items()))
    echo(stack([wide(m, bstats) for m in ["n", "median"]]).to_string())
    echo("Balanced-panel ratios (rows) by year (columns), with headline ratio in brackets:")
    echo(pd.DataFrame({y: {"white:black": f"{brr[(y,1)]['ratio']:.2f}  (headline {rr[(y,1)]['ratio']:.2f})",
                           "white:hispanic": f"{brr[(y,2)]['ratio']:.2f}  (headline {rr[(y,2)]['ratio']:.2f})"}
                       for y in YEARS}).to_string())
    echo("Absolute dollar gaps, balanced panel:")
    echo(pd.DataFrame({y: {"white minus black ($)": bmed[(y, 3)] - bmed[(y, 1)],
                           "white minus hispanic ($)": bmed[(y, 3)] - bmed[(y, 2)]} for y in YEARS}).to_string())

    # ---------------- TABLE 5: winsorised (robustness only) ----------------
    wstats, caps = {}, {}
    for y in YEARS:
        cap = float(np.percentile(df[f"w{y}"].dropna(), 99)); caps[y] = cap
        for c in COHORTS:
            wstats[(y, c)] = cell_stats(df.loc[df.cohort == c, f"w{y}"].clip(upper=cap))
    for y in YEARS:
        for c in COHORTS:
            wstats[(y, c)]["cap_p99"] = caps[y]
    wmed = {(y, c): wstats[(y, c)]["median"] for y in YEARS for c in COHORTS}
    wrr = ratios(wmed)
    echo("--- TABLE 5. ROBUSTNESS 2: medians after winsorising at pooled p99 per wave (ROBUSTNESS ONLY) ---")
    tw = stack([wide(m, wstats) for m in ["median", "cap_p99"]])
    echo(tw.to_string())
    echo("Winsorised ratios by year: " + ", ".join(
        f"{y}: W:B={wrr[(y,1)]['ratio']:.2f} W:H={wrr[(y,2)]['ratio']:.2f}" for y in YEARS))
    echo("(Source data are already top-coded near p99, so winsorising barely moves medians/ratios - hence not headline.)")

    # ---------------- TABLE 6: constant 1996 dollars ----------------
    rstats = {}
    for y in YEARS:
        f = CPI[BASE_YEAR] / CPI[y]
        for c in COHORTS:
            s = df.loc[df.cohort == c, f"w{y}"].dropna() * f
            rstats[(y, c)] = {"n": len(s), "median": float(np.median(s)), "cpi_index": CPI[y], "deflator_to_1996": f}
    rmed = {(y, c): rstats[(y, c)]["median"] for y in YEARS for c in COHORTS}
    rrr = ratios(rmed)
    echo("--- TABLE 6. SENSITIVITY: constant 1996 dollars (EXTERNAL CPI-U: 1985=107.6, 1990=130.7, 1996=156.9) ---")
    echo("CAVEAT: CPI values are an EXTERNAL input that cannot be verified inside the data file. Ratios within a wave")
    echo("are invariant to the deflator (it is common to all cohorts in a wave), so only cross-YEAR comparisons change.")
    echo(stack([wide(m, rstats) for m in ["n", "median", "deflator_to_1996"]]).to_string())
    echo("Real (1996$) ratios by year: " + ", ".join(
        f"{y}: W:B={rrr[(y,1)]['ratio']:.2f} W:H={rrr[(y,2)]['ratio']:.2f}" for y in YEARS))
    echo("Real absolute gaps (1996$):")
    echo(pd.DataFrame({y: {"white minus black ($)": rmed[(y, 3)] - rmed[(y, 1)],
                           "white minus hispanic ($)": rmed[(y, 3)] - rmed[(y, 2)]} for y in YEARS}).to_string())
    growth = pd.DataFrame([{"cohort": lab,
                            "median_1985_nom$": med[(1985, c)], "median_1996_nom$": med[(1996, c)],
                            "nominal_multiple_85_to_96": med[(1996, c)] / med[(1985, c)],
                            "median_1985_1996$": rmed[(1985, c)], "median_1996_1996$": rmed[(1996, c)],
                            "real_multiple_85_to_96": rmed[(1996, c)] / rmed[(1985, c)]}
                           for c, lab in COHORTS.items()]).set_index("cohort")
    echo("Growth in median family wealth 1985 -> 1996, nominal vs CPI-deflated (columns = metric, rows = cohort):")
    echo(growth.to_string())

    # ---------------- TABLE 7: composition decomposition (secondary) ----------------
    echo("--- TABLE 7. SECONDARY / LOWER CONFIDENCE: wealth-composition decomposition ---")
    echo("ASSUMPTION (not a finding): a BLANK composition value is read as 'respondent/spouse owned none of this asset' (= 0).")
    echo("Ownership rate = share of ALL respondents in the cohort-wave reporting a strictly positive value, so the reader can")
    echo("see exactly what the zero-fill is doing. Medians are of the ZERO-FILLED variable (population-level contribution).")
    rows = []
    for name in COMPONENTS:
        for y in YEARS:
            for c, lab in COHORTS.items():
                s = df.loc[df.cohort == c, f"c_{name}_{y}"]
                own = s.notna() & (s > 0)
                rows.append({"asset": name, "year": y, "cohort": lab,
                             "pct_reporting_any_value": 100 * float(s.notna().mean()),
                             "ownership_rate_%": 100 * float(own.mean()),
                             "median_$_zero_filled": float(s.fillna(0).median()),
                             "mean_$_zero_filled": float(s.fillna(0).mean()),
                             "mean_$_owners_only": float(s[own].mean()) if own.any() else np.nan,
                             "mean_$per_$1_of_net_wealth": (float(s.fillna(0).mean()) /
                                                            float(df.loc[df.cohort == c, f"w{y}"].mean()))})
    comp = pd.DataFrame(rows)
    piv = comp.pivot_table(index=["asset", "year"], columns="cohort",
                           values=["ownership_rate_%", "median_$_zero_filled", "mean_$_zero_filled", "mean_$_owners_only"])
    piv = piv.reorder_levels([1, 0], axis=1).sort_index(axis=1)
    echo(piv.to_string())
    echo("Cohort differences in mean zero-filled assets, 1985 and 1996 (share of the white-cohort mean):")
    for y in (1985, 1996):
        sub = comp[comp.year == y].pivot_table(index="asset", columns="cohort", values="mean_$_zero_filled")
        rel = sub.div(sub["White (non-Hispanic)"], axis=0)
        echo(f"  {y}: mean(zero-filled) as multiple of white-cohort mean")
        echo(rel.to_string())
    echo("NOTE: farm/business/other property is reported by only 4-6% of each cohort-wave -> DESCRIPTIVE ONLY,")
    echo("excluded from any headline or causal interpretation. Financial assets (stocks/IRA/savings) are NOT in the file,")
    echo("so the four components do not sum to net wealth (debts and financial assets are unobserved).")

    # ---------------- TABLE 8: sample-id descriptives (no exclusions) ----------------
    echo("--- TABLE 8. DESCRIPTIVE: Sample ID composition. NO respondents excluded on this basis anywhere. ---")
    sid = df.pivot_table(index="sample_id", columns="cohort", values="id", aggfunc="count", fill_value=0)
    sid.columns = [COHORTS[c] for c in sid.columns]
    sid["total"] = sid.sum(axis=1)
    echo(sid.to_string())
    echo("Sample ID codes are not interpreted (no codebook supplied, so any military/oversample reading would be a guess);")
    echo("the headline therefore uses the FULL sample. Because NLSY79 oversamples some groups, pooled all-respondent")
    echo("figures are NOT population-representative; within-cohort medians and cross-cohort ratios are what we interpret.")

    # ---------------- TABLE 9: attrition diagnostics ----------------
    echo("--- TABLE 9. ATTRITION DIAGNOSTICS: is the missingness in 1996 differential, and does it look wealth-related? ---")
    rows = []
    for c, lab in COHORTS.items():
        sub = df[df.cohort == c]
        rows.append({"cohort": lab, "n_1979": len(sub),
                     "pct_valid_1985": 100 * float(sub.w1985.notna().mean()),
                     "pct_valid_1990": 100 * float(sub.w1990.notna().mean()),
                     "pct_valid_1996": 100 * float(sub.w1996.notna().mean()),
                     "median_1985wealth_of_those_missing_96": float(sub.loc[sub.w1996.isna(), "w1985"].median()),
                     "median_1985wealth_OF_those_observed_96": float(sub.loc[sub.w1996.notna(), "w1985"].median()),
                     "pct_zero_or_negative_1996": 100 * float((sub.w1996 <= 0).sum() / sub.w1996.notna().sum())})
    t9 = pd.DataFrame(rows).set_index("cohort")
    echo(t9.to_string())
    echo("If dropouts were systematically poorer than stayers, complete-case medians overstate every cohort's level;")
    echo("the balanced-panel ratios in TABLE 4 are the guard against that for the COMPARISON (the substantive question).")

    # ---------------- verdict ----------------
    echo("=" * 110)
    echo("DIRECTION OF TRAVEL (headline, nominal $, complete case): does the RATIO move with the DOLLAR GAP?")
    verdict = []
    for lbl, key in [("white:black", 1), ("white:hispanic", 2)]:
        r = [rr[(y, key)]["ratio"] for y in YEARS]
        g = [med[(y, 3)] - med[(y, key)] for y in YEARS]
        d_r = "WIDENS" if r[2] > r[0] else ("NARROWS" if r[2] < r[0] else "FLAT")
        d_g = "WIDENS" if g[2] > g[0] else ("NARROWS" if g[2] < g[0] else "FLAT")
        line = (f"  {lbl:16s} ratio {r[0]:.1f} -> {r[1]:.1f} -> {r[2]:.1f}  [{d_r} 1985->1996]   "
                f"dollar gap ${g[0]:,.0f} -> ${g[1]:,.0f} -> ${g[2]:,.0f}  [{d_g}]")
        echo(line); verdict.append((lbl, r, g, d_r, d_g))
    echo("Real (CPI-adjusted) ratios by year for cross-check: " + ", ".join(
        f"{y}: W:B={rrr[(y,1)]['ratio']:.2f} W:H={rrr[(y,2)]['ratio']:.2f}" for y in YEARS))
    echo("Scope of these statements: in this cohort-sequential NLSY79 sample only; no causal interpretation.")
    echo("=" * 110)

    # ---------------- persist ----------------
    os.makedirs(OUT, exist_ok=True)
    t0.to_csv(f"{OUT}/t0_coverage_audit.csv")
    t1.to_csv(f"{OUT}/t1_headline_medians.csv")
    t2.to_csv(f"{OUT}/t2_median_ratios.csv")
    t3.to_csv(f"{OUT}/t3_absolute_gaps.csv")
    pd.DataFrame({y: {"white_black_ratio_boot_mean": np.nanmean(rb[(y, 1)]),
                      "white_black_ci_lo": np.nanpercentile(rb[(y, 1)], 2.5),
                      "white_black_ci_hi": np.nanpercentile(rb[(y, 1)], 97.5),
                      "white_hispanic_ratio_boot_mean": np.nanmean(rb[(y, 2)]),
                      "white_hispanic_ci_lo": np.nanpercentile(rb[(y, 2)], 2.5),
                      "white_hispanic_ci_hi": np.nanpercentile(rb[(y, 2)], 97.5)} for y in YEARS}).T.to_csv(f"{OUT}/t2b_ratio_bootstrap_ci.csv")
    t2c.to_csv(f"{OUT}/t2c_quantile_ratios.csv")
    stack([wide(m, bstats) for m in ["n", "median"]]).to_csv(f"{OUT}/t4_balanced_panel.csv")
    tw.to_csv(f"{OUT}/t5_winsorised_p99.csv")
    stack([wide(m, rstats) for m in ["n", "median", "deflator_to_1996"]]).to_csv(f"{OUT}/t6_constant_1996usd.csv")
    growth.to_csv(f"{OUT}/t6b_growth_nominal_vs_real.csv")
    comp.to_csv(f"{OUT}/t7_composition_long.csv", index=False)
    sid.to_csv(f"{OUT}/t8_sample_id_descriptive.csv")
    t9.to_csv(f"{OUT}/t9_attrition_diagnostics.csv")
    with open(f"{OUT}/full_output.txt", "w") as fh:
        fh.write("\n".join(LINES) + "\n")
    print(f"\n[written] tables -> {OUT}/")

if __name__ == "__main__":
    main()
