#!/usr/bin/env python3
"""
NLS / SES -> BA degree completion: staged model comparison.

Question: which variable's effect on BA DEGREE COMPLETED decreases from ~0.3636
to ~-0.2293 (and becomes insignificant) once BOTH race and academic
characteristics are included?

Pre-specified design (agreed at plan stage, before the sweep):
  Outcome  : BA DEGREE COMPLETED (binary 0/1)
  Estimator: logistic regression (logit), Wald inference. Rationale: only the
             log-odds scale can produce coefficients of magnitude ~0.36/-0.23;
             LPM coefficients are 0.01-0.03 (raw y) or 0.06-0.18 (z-scored y).
  Stages   : M0 candidate alone
             M1 + race
             M2 + academic characteristics
             M3 + race + academic characteristics   <-- HEADLINE full model
             M4 M3 + sex / family size              <-- sensitivity rows only
  Academic characteristics == ABILITY (ASVAB composite) + PERCENTILE IN CLASS,
             i.e. the only academic columns in the staged file. No curriculum and
             no separate test-score column exists; none is imputed or proxied.
  alpha = 0.05, two-sided.

The specification grid below is run as a DESCRIPTIVE SENSITIVITY analysis.
No specification is selected on the basis of the target values and no tuning is
performed to push a p-value across 0.05.

Outputs: analysis/coefficient_table.csv, analysis/candidate_comparison.csv,
         analysis/sensitivity_grid.csv, analysis/summary.txt
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm

warnings.filterwarnings("ignore")

DATA = "data/nls_ses_processed.csv"
TARGET_ALONE, TARGET_FULL = 0.3636, -0.2293
ALPHA = 0.05

pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 60)
LOG = []


def say(*a):
    s = " ".join(str(x) for x in a)
    print(s)
    LOG.append(s)


def fmt(d, cols, spec="{:+.4f}"):
    d = d.copy()
    for c in cols:
        d[c] = d[c].map(spec.format)
    return d


def fpct(d, cols):
    return fmt(d, cols, "{:.4g}")


# ---------------------------------------------------------------- 1. load/code
raw = pd.read_csv(DATA)
df = raw.drop(columns=[c for c in raw.columns if c.startswith("Unnamed")]).copy()
y = df["BA DEGREE COMPLETED"].astype(float)

S = "SES"
A = "ABILITY: COMPOSITE OF ASVAB SCORE"
P = "PERCENTILE IN CLASS"
F = "FAMILY SIZE OF SAMPLE"
zsc = lambda s: (s - s.mean()) / s.std()

df["ses_z"] = zsc(df[S])
df["ses_raw"] = df[S]
df["abil_z"] = zsc(df[A])
df["pct_z"] = zsc(df[P])
df["fam_z"] = zsc(df[F])
df["black"] = (df.SAMPLE_RACE == "Black").astype(float)
df["hisp"] = (df.SAMPLE_RACE == "Hispanic").astype(float)
df["white"] = (df.SAMPLE_RACE == "White").astype(float)
df["female"] = (df.SAMPLE_SEX == "Female").astype(float)
df["y"] = y.values

RACE = ["black", "hisp"]          # White = reference category
ACAD = ["abil_z", "pct_z"]        # academic characteristics (fixed definition)

say("=" * 78)
say("1. DATA")
say("=" * 78)
say(f"raw file shape                  : {raw.shape}")
say(f"analytic n                      : {len(df)}")
say(f"missing values, all columns     : {int(raw.isna().sum().sum())}")
say(f"outcome                         : {int(y.sum())} events / {len(df)} = {y.mean()*100:.2f}%  (stored dtype {raw['BA DEGREE COMPLETED'].dtype})")
say(f"SES coding                      : continuous, {df[S].nunique()} distinct values, mean {df[S].mean():.4f}, "
    f"sd {df[S].std():.4f}, range [{df[S].min():.3f}, {df[S].max():.3f}] -> NOT pre-categorised")
say(f"race                            : {dict(df.SAMPLE_RACE.value_counts())}")
say(f"sex                             : {dict(df.SAMPLE_SEX.value_counts())}")
say(f"academic columns available      : ['{A}', '{P}']  (no curriculum / separate test-score column)")
say(f"corr(SES,ability)={df[S].corr(df[A]):.3f}  corr(SES,percentile)={df[S].corr(df[P]):.3f}")


def fit_logit(cols, cov=None):
    X = sm.add_constant(df[cols])
    m = sm.Logit(df["y"], X)
    return m.fit(disp=0) if cov is None else m.fit(disp=0, cov_type=cov)


def coefrow(model, v, label):
    p = model.pvalues[v]
    return dict(model=label, var=v, n=int(model.nobs), events=int(df["y"].sum()),
                coef=model.params[v], se=model.bse[v], z=model.tvalues[v], p=p,
                sig_at_0p05="yes" if p < ALPHA else "no",
                odds_ratio=float(np.exp(model.params[v])),
                n_params=len(model.params),
                events_per_param=round(int(df["y"].sum()) / len(model.params), 1))


# ------------------------------------------- 2. HEADLINE staged models (SES z)
say("")
say("=" * 78)
say("2. HEADLINE STAGED MODELS -- candidate = SES (z-scored); outcome = BA degree completed")
say("=" * 78)

stages = {
    "M0  SES alone": ["ses_z"],
    "M1  SES + race": ["ses_z"] + RACE,
    "M2  SES + academic (ability+percentile)": ["ses_z"] + ACAD,
    "M3  SES + race + academic [HEADLINE FULL]": ["ses_z"] + RACE + ACAD,
    "M4a M3 + female (sensitivity)": ["ses_z"] + RACE + ACAD + ["female"],
    "M4b M3 + family size (sensitivity)": ["ses_z"] + RACE + ACAD + ["fam_z"],
    "M4c M3 + female + family size (sensitivity)": ["ses_z"] + RACE + ACAD + ["female", "fam_z"],
    "M3u same as M3 but unstandardised SES (per 1 raw SES unit)": RACE + ACAD + ["ses_raw"],
}
rows, models = [], {}
for lab, cols in stages.items():
    m = fit_logit(cols)
    models[lab] = m
    v = "ses_z" if "ses_z" in cols else "ses_raw"
    rows.append(coefrow(m, v, lab))
stage_tab = pd.DataFrame(rows)
d = fmt(stage_tab[["model", "n", "events", "coef", "se", "z", "p", "odds_ratio"]],
        ["coef", "se", "z", "odds_ratio"])
d = fpct(d, ["p"])
say(d.to_string(index=False))

m0 = models["M0  SES alone"]
m3 = models["M3  SES + race + academic [HEADLINE FULL]"]
say("")
say("Full coefficient set, HEADLINE model M3 (log-odds scale):")
for k, v in m3.params.items():
    say(f"    {k:10s} b={v:+.4f}  se={m3.bse[k]:.4f}  z={m3.tvalues[k]:+7.3f}  p={m3.pvalues[k]:.4g}  OR={np.exp(v):.3f}")
say(f"    M0: pseudo-R2={m0.prsquared:.4f} LLF={m0.llf:.2f} | M3: pseudo-R2={m3.prsquared:.4f} LLF={m3.llf:.2f}"
    f" | LR chi2(M0 vs M3, 4 df)={2*(m3.llf-m0.llf):.2f}")
b0, b3 = m0.params["ses_z"], m3.params["ses_z"]
say(f"Attenuation M0->M3: {b0:+.4f} -> {b3:+.4f}; change {b3-b0:+.4f} = "
    f"{100*(b3-b0)/abs(b0):.1f}% of the |M0| coefficient. Sign flipped; p {m0.pvalues['ses_z']:.3g} -> {m3.pvalues['ses_z']:.4g}")
say(f"Fraction of the M0 SES effect removed by race+academics: {100*(b0-b3)/b0:.1f}%")

# ------------------------------------------------- 3. effect-scale translation
say("")
say("=" * 78)
say(f"3. EFFECT-SCALE TRANSLATION for SES  (1 SD of SES = {df[S].std():.3f} raw units)")
say("=" * 78)
def ame_logit(m, var):
    """Average marginal effect of a continuous regressor in a logit model,
    with a delta-method standard error (analytic, avoids get_margeff API drift)."""
    X = np.asarray(m.model.exog)
    b = np.asarray(m.params.values, float)
    V = np.asarray(m.cov_params().values, float)
    names = list(m.params.index)
    j = names.index(var)
    eta = X @ b
    pr = 1.0 / (1.0 + np.exp(-eta))
    d = pr * (1 - pr) * b[j]                       # per-observation dP/db_j
    n = X.shape[0]
    grad = (X.T @ (pr * (1 - pr) * (1 - 2 * pr) * b[j])) / n
    grad[j] += np.mean(pr * (1 - pr))
    est = float(d.mean())
    se = float(np.sqrt(grad @ V @ grad))
    return est, se


for lab, m in [("M0 SES alone", m0), ("M3 race+academic", m3)]:
    b, se = m.params["ses_z"], m.bse["ses_z"]
    a, ase = ame_logit(m, "ses_z")
    zz = a / ase
    sm_me = m.get_margeff(at="overall", method="dydx")   # cross-check of the analytic AME
    pos = list(m.params.index).index("ses_z") - 1
    assert abs(sm_me.margeff[pos] - a) < 1e-6 and abs(sm_me.margeff_se[pos] - ase) < 1e-6, \
        f"AME mismatch: analytic {a:.6f} vs statsmodels {sm_me.margeff[pos]:.6f}"
    say(f"{lab:17s} b={b:+.4f} (se {se:.4f})  OR={np.exp(b):.3f} "
        f"[95% CI {np.exp(b-1.96*se):.3f}, {np.exp(b+1.96*se):.3f}]  "
        f"AME={a*100:+.3f} pct pts (se {ase*100:.3f}, z={zz:+.2f}, p={2*(1-__import__('scipy.stats',fromlist=['norm']).norm.cdf(abs(zz))):.4g})")

say("")
say("Predicted P(BA) for a White respondent at academic means, SES -1SD vs +1SD:")
for lab, m in [("M0", m0), ("M3", m3)]:
    dd = pd.DataFrame({"ses_z": [-1.0, 1.0]})
    for c in ["black", "hisp", "abil_z", "pct_z", "female", "fam_z"]:
        dd[c] = 0.0
    dd["white"] = 1.0
    cols = [c for c in m.params.index if c != "const"]
    p = np.asarray(m.predict(sm.add_constant(dd[cols], has_constant="add")))
    say(f"    {lab}: P(BA | SES=-1SD)={p[0]*100:.2f}%   P(BA | SES=+1SD)={p[1]*100:.2f}%   "
        f"difference={100*(p[1]-p[0]):+.2f} pct pts   ratio={p[1]/p[0]:.2f}x")

# ------------------------------------------- 4. all-candidate comparative table
say("")
say("=" * 78)
say("4. ALL-CANDIDATE COMPARISON: coefficient alone (M0) vs with race+academics (M3)")
say("=" * 78)
cands = {"SES (z)": "ses_z", "ABILITY ASVAB (z)": "abil_z", "PERCENTILE IN CLASS (z)": "pct_z",
         "FAMILY SIZE (z)": "fam_z", "SAMPLE_SEX=Female": "female",
         "SAMPLE_RACE=Black": "black", "SAMPLE_RACE=Hispanic": "hisp"}
comp = []
for name, v in cands.items():
    others = [c for c in RACE + ACAD if c != v]     # race + academics, minus the candidate itself
    ma, mf = fit_logit([v]), fit_logit([v] + others)
    ba, bf = ma.params[v], mf.params[v]
    comp.append(dict(candidate=name, var=v, controls_in_M3="race+academics (self-excluded)",
                     b_alone=ba, se_alone=ma.bse[v], p_alone=ma.pvalues[v],
                     sig_alone="yes" if ma.pvalues[v] < ALPHA else "no",
                     b_full=bf, se_full=mf.bse[v], p_full=mf.pvalues[v],
                     sig_full="yes" if mf.pvalues[v] < ALPHA else "no",
                     change=bf - ba,
                     sign_flip="YES" if np.sign(ba) != np.sign(bf) else "no",
                     pct_change_of_alone_mag=100 * (bf - ba) / abs(ba),
                     abs_err_vs_target=abs(ba - TARGET_ALONE) + abs(bf - TARGET_FULL)))
comp = pd.DataFrame(comp)
c = fmt(comp[["candidate", "b_alone", "se_alone", "p_alone", "sig_alone", "b_full", "se_full",
              "p_full", "sig_full", "change", "sign_flip", "pct_change_of_alone_mag",
              "abs_err_vs_target"]],
        ["b_alone", "se_alone", "b_full", "se_full", "change", "pct_change_of_alone_mag", "abs_err_vs_target"])
c = fpct(c, ["p_alone", "p_full"])
say(c.sort_values("abs_err_vs_target").to_string(index=False))
say("")
say("SES is the only candidate that DECREASES from a significant positive baseline (+0.35, p=1e-8)")
say("to a negative coefficient while staying within reach of the quoted 0.3636/-0.2293 pair")
say(f"(|error| = {comp.loc[comp['var']=='ses_z','abs_err_vs_target'].iloc[0]:.3f}; the next closest candidate is female at")
say(f" {comp.loc[comp['var']=='female','abs_err_vs_target'].iloc[0]:.3f}, which never attains significance).")
say("Ability, percentile and family size attenuate but retain sign and p << 0.05; female is")
say("non-significant at BOTH stages, so it cannot 'become' insignificant from a 0.36 base.")
say("QUALIFICATION (stated for accuracy): the Black dummy also flips sign (-0.8757 -> +0.1193),")
say("but it does so from a large NEGATIVE baseline, i.e. it INCREASES rather than 'decreases from")
say("0.3636', and the flip is a reference-category artefact -- adding the other race dummies")
say("re-centres what the dummy contrasts against, so its coefficient is not comparable across")
say("stages. The Black/Hispanic dummies are also the covariates being added, not confounded")
say("predictors of the kind the question asks about.")


# ---------------------------------- 5. descriptive sensitivity grid (no tuning)
say("")
say("=" * 78)
say("5. SENSITIVITY GRID for SES -- DESCRIPTIVE ONLY (not a specification search)")
say("=" * 78)
q = pd.qcut(df[S], 4, labels=False)
t = pd.qcut(df[S], 3, labels=False)
d4 = pd.get_dummies(q, prefix="q", drop_first=True).astype(float)
d3 = pd.get_dummies(t, prefix="t", drop_first=True).astype(float)
df = pd.concat([df, d4, d3], axis=1)
ses_codings = {"continuous z": ["ses_z"], "continuous raw": ["ses_raw"],
               "quartile dummies (ref Q1)": list(d4.columns),
               "tertile dummies (ref T1)": list(d3.columns)}
race_schemes = {"White ref": ["black", "hisp"], "Black ref": ["hisp", "white"],
                "Hispanic ref": ["black", "white"]}
acad_schemes = {"ability+percentile [fixed]": ["abil_z", "pct_z"],
                "ability only": ["abil_z"], "percentile only": ["pct_z"]}
extra_schemes = {"none": [], "female": ["female"], "family size": ["fam_z"],
                 "female+family size": ["female", "fam_z"]}
estimators = ["logit", "logit HC3", "probit", "OLS on raw y", "OLS on z-scored y"]
y_z = (df["y"] - df["y"].mean()) / df["y"].std()


def fit_any(kind, cols):
    X = sm.add_constant(df[cols])
    if kind == "logit":
        return sm.Logit(df.y, X).fit(disp=0)
    if kind == "logit HC3":
        return sm.Logit(df.y, X).fit(disp=0, cov_type="HC3")
    if kind == "probit":
        return sm.Probit(df.y, X).fit(disp=0)
    if kind == "OLS on raw y":
        return sm.OLS(df.y, X).fit()
    return sm.OLS(y_z, X).fit()


grid = []
for sc, scols in ses_codings.items():
    for rn, rc in race_schemes.items():
        for an, ac in acad_schemes.items():
            for xn, xx in extra_schemes.items():
                full = scols + rc + ac + xx
                for en in estimators:
                    rec = dict(ses_coding=sc, race_reference=rn, academic_set=an,
                               extra_covariates=xn, estimator=en,
                               n_academic_covariates_in_M3=len([a for a in ac]))
                    try:
                        a, f = fit_any(en, scols), fit_any(en, full)
                        if len(scols) == 1:
                            key = scols[0]
                            ba, pa, bf, pf = a.params[key], a.pvalues[key], f.params[key], f.pvalues[key]
                        else:                      # categorical SES: widest category + min p
                            ba = a.params[scols].max(); pa = a.pvalues[scols].min()
                            bf = f.params[scols].max(); pf = f.pvalues[scols].min()
                        rec.update(b_alone=ba, p_alone=pa, b_full=bf, p_full=pf, change=bf - ba,
                                   sign_flip="YES" if np.sign(ba) != np.sign(bf) else "no",
                                   insig_full="yes" if pf >= ALPHA else "no")
                    except Exception as exc:
                        rec.update(b_alone=np.nan, p_alone=np.nan, b_full=np.nan, p_full=np.nan,
                                   change=np.nan, sign_flip="error", insig_full="error")
                    grid.append(rec)
G = pd.DataFrame(grid)
G["abs_err_vs_target"] = (G.b_alone - TARGET_ALONE).abs() + (G.b_full - TARGET_FULL).abs()
ok = G.dropna(subset=["b_full"])
say(f"specifications estimated: {len(G)} ({len(ok)} converged): "
    f"4 SES codings x 3 race references x 3 academic sets x 4 extra-covariate sets x 5 estimators")
say("")
say("--- distribution of the FULL-model SES coefficient across all converged specifications ---")
say(ok.b_full.describe(percentiles=[.05, .10, .25, .5, .75, .90, .95]).map("{:+.4f}".format).to_string())
say("")
say("--- distribution of the FULL-model SES p-value ---")
say(ok.p_full.describe(percentiles=[.05, .10, .25, .5, .75, .90, .95]).map("{:.4g}".format).to_string())
say("")
neg = (ok.b_full < 0)
say(f"sign flip (positive alone -> negative full)                 : {int((ok.sign_flip=='YES').sum())} / {len(ok)}")
say(f"full-model p >= 0.05                                        : {int((ok.insig_full=='yes').sum())} / {len(ok)}")
say(f"full-model p >= 0.05 AND negative SES coefficient           : {int(((ok.insig_full=='yes') & neg).sum())} / {len(ok)}")
headmask = ((G.ses_coding == "continuous z") & (G.academic_set == "ability+percentile [fixed]")
            & (G.extra_covariates == "none"))
say(f"   ...of those, with LINEAR z SES + the fixed M3 definition (race+academics, no extras): "
    f"{int(((G.insig_full=='yes') & (G.b_full<0) & headmask).sum())} / {int(headmask.sum())}")
say(f"negative-full specifications with p in [0.01,0.05) (i.e. 'weakly significant, sign-flipped'): "
    f"{int(((ok.b_full<0) & (ok.p_full>=0.01) & (ok.p_full<0.05)).sum())}")
say("")
say("All specifications where the FULL-model SES coefficient is NEGATIVE and non-significant at alpha=0.05:")
sel = ok[(ok.insig_full == "yes") & neg].sort_values("abs_err_vs_target")
if len(sel):
    s = fmt(sel, ["b_alone", "b_full", "change", "abs_err_vs_target"])
    s = fpct(s, ["p_alone", "p_full"])
    say(s.to_string(index=False))
else:
    say("    (none)")
say("")
say("Ten specifications closest to the target pair (0.3636, -0.2293) -- transparency, NOT selection:")
t10 = ok.sort_values("abs_err_vs_target").head(10)
t = fmt(t10, ["b_alone", "b_full", "change", "abs_err_vs_target"])
t = fpct(t, ["p_alone", "p_full"])
say(t.to_string(index=False))
say("")
hl = G[headmask & (G.race_reference == "White ref") & (G.estimator == "logit")].iloc[0]
say(f"HEADLINE pre-specified specification (z SES, White ref, ability+percentile, no extras, logit):")
say(f"    b_alone={hl.b_alone:+.4f} (p={hl.p_alone:.3g})  ->  b_full={hl.b_full:+.4f} (p={hl.p_full:.4g}); "
    f"sign flip = {hl.sign_flip}; insignificant at 0.05 = {hl.insig_full}")
say("    => the sign flip and the large attenuation are robust across specifications, but the strict")
say("       'insignificant at alpha=0.05' criterion is NOT satisfied by the headline model.")

# ------------------------------------------------------- 6. precision / events
say("")
say("=" * 78)
say("6. PRECISION / EVENTS PER VARIABLE")
say("=" * 78)
ev = int(df["y"].sum())
for lab, m in models.items():
    k = len(m.params)
    key = "ses_z" if "ses_z" in m.params.index else "ses_raw"
    say(f"{lab:60s} k={k:2d}  events={ev}  EPV={ev/k:5.1f}  se(SES)={m.bse[key]:.4f}")
say(f"Minimum EPV across headline models = {ev/max(len(m.params) for m in models.values()):.1f} "
    f"(rule-of-thumb floor 10 -> satisfied; MLE converged, no separation),")
say(f"but precision is intrinsically limited: only {ev} of {len(df)} respondents ({y.mean()*100:.2f}%) completed a BA,")
say("so SES standard errors are large relative to the M0->M3 change and the sign flip, while robust,")
say("is estimated on a razor-thin event base.")

# --------------------------------------------------------------- 7. artefacts
stage_tab.to_csv("analysis/coefficient_table.csv", index=False)
comp.to_csv("analysis/candidate_comparison.csv", index=False)
G.to_csv("analysis/sensitivity_grid.csv", index=False)
say("")
say("written: analysis/coefficient_table.csv, analysis/candidate_comparison.csv, analysis/sensitivity_grid.csv")
with open("analysis/summary.txt", "w") as fh:
    fh.write("\n".join(LOG) + "\n")
print("\n[analysis/summary.txt written]")


# ------------------------------- 7. what drives the attenuation + bootstrap CI
say("")
say("=" * 78)
say("7. DECOMPOSITION OF THE M0 -> M3 ATTENUATION, COLLINEARITY, BOOTSTRAP")
say("=" * 78)
b0 = m0.params["ses_z"]
mr = models["M1  SES + race"]
ma = models["M2  SES + academic (ability+percentile)"]
say(f"SES log-odds coefficient: M0={b0:+.4f} | +race only={mr.params['ses_z']:+.4f} "
    f"| +academics only={ma.params['ses_z']:+.4f} | +both (M3)={b3:+.4f}")
say(f"  attenuation attributable to RACE alone      : {mr.params['ses_z']-b0:+.4f} "
    f"({100*(mr.params['ses_z']-b0)/abs(b0):.1f}% of |M0|)")
say(f"  attenuation attributable to ACADEMICS alone : {ma.params['ses_z']-b0:+.4f} "
    f"({100*(ma.params['ses_z']-b0)/abs(b0):.1f}% of |M0|)")
say(f"  extra attenuation from race x academics jointly (vs academics alone): {b3-ma.params['ses_z']:+.4f}")
say("  -> the sign flip is driven almost entirely by the academic characteristics; race alone")
say("     only halves the positive SES effect without changing its sign.")

# individual covariate drops from M3 (leave-one-covariate-out, descriptive)
say("")
say("Leave-one-covariate-out from M3 (how essential is each control for the flip):")
for drop in RACE + ACAD:
    cols = ["ses_z"] + [c for c in RACE + ACAD if c != drop]
    mm = fit_logit(cols)
    say(f"    M3 minus {drop:8s}: SES b={mm.params['ses_z']:+.4f} se={mm.bse['ses_z']:.4f} p={mm.pvalues['ses_z']:.4g}")

# collinearity among M3 regressors
say("")
say("Correlation among M3 regressors (|r| > 0.3 flagged) and VIF for ses_z:")
cm = df[["ses_z"] + RACE + ACAD].corr()
for i in cm.index:
    for j in cm.columns:
        if i < j and abs(cm.loc[i, j]) > 0.3:
            say(f"    corr({i},{j}) = {cm.loc[i,j]:+.3f}")
Xv = sm.add_constant(df[["ses_z"] + RACE + ACAD])
r2s = sm.OLS(df["ses_z"], Xv.drop(columns="ses_z")).fit().rsquared
say(f"    R2 of ses_z on the other M3 regressors = {r2s:.4f}  ->  VIF = {1/(1-r2s):.3f} "
    f"(no collinearity pathology; the flip is mediation-like, not numerical instability)")

# nonparametric bootstrap of the M0->M3 change and of b_full
say("")
rng = np.random.default_rng(20261025)
B = 400
ch, bfull, errs = [], [], {}
idx_all = np.arange(len(df))
for _ in range(B):
    ii = rng.choice(idx_all, size=len(df), replace=True)
    dsv = df.iloc[ii]
    if dsv["y"].sum() < 20:
        continue
    try:
        def fitb(cols):
            Xb = sm.add_constant(dsv[cols], has_constant="add")
            return sm.Logit(dsv["y"].values, Xb).fit(disp=0)
        a_, f_ = fitb(["ses_z"]), fitb(["ses_z"] + RACE + ACAD)
        ch.append(f_.params["ses_z"] - a_.params["ses_z"])
        bfull.append(f_.params["ses_z"])
    except Exception as exc:
        errs[type(exc).__name__] = errs.get(type(exc).__name__, 0) + 1
        continue
ch, bfull = np.array(ch), np.array(bfull)
assert len(ch) >= B * 0.8, f"bootstrap failed: only {len(ch)} replicates succeeded, errors={errs}"
say(f"bootstrap replicates used: {len(ch)} / {B} (case resampling, seed 20261025)")
say(f"  M3 SES coefficient  : mean {bfull.mean():+.4f}, 95% CI [{np.percentile(bfull,2.5):+.4f}, {np.percentile(bfull,97.5):+.4f}]"
    f"   P(b<0) = {(bfull<0).mean():.3f}")
say(f"  M0->M3 change       : mean {ch.mean():+.4f}, 95% CI [{np.percentile(ch,2.5):+.4f}, {np.percentile(ch,97.5):+.4f}]"
    f"   P(change<0) = {(ch<0).mean():.3f}")
say("  -> the negative sign of the M3 coefficient and the large negative shift are both stable under resampling.")
pd.DataFrame({"quantity": ["M3_ses_coef", "M0_to_M3_change"],
              "boot_mean": [bfull.mean(), ch.mean()],
              "ci_lo": [np.percentile(bfull, 2.5), np.percentile(ch, 2.5)],
              "ci_hi": [np.percentile(bfull, 97.5), np.percentile(ch, 97.5)],
              "n_boot": [len(bfull), len(ch)]}).to_csv("analysis/bootstrap.csv", index=False)
