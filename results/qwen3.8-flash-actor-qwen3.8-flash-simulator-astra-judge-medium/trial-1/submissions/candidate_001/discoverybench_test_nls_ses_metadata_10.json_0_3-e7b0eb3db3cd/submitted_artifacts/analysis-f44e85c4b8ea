"""FINAL consolidated deliverable.
Question: which variable's effect on BA DEGREE COMPLETED falls 0.5024 -> 0.0923 and becomes
insignificant once BOTH SES and academic characteristics are in the model?
Block structure (approved): academic block = {ABILITY, PERCENTILE IN CLASS}; SES is the
conditioning block, held OUT of the academic block. Both directions reported.
"""
import warnings
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings("ignore"); pd.set_option("display.width",260); pd.set_option("display.max_rows",400)

df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
y = df["BA DEGREE COMPLETED"].astype(int)
D = pd.DataFrame({"SES": df.SES.astype(float),
                  "ABILITY": df["ABILITY: COMPOSITE OF ASVAB SCORE"].astype(float),
                  "PERCENTILE": df["PERCENTILE IN CLASS"].astype(float),
                  "FAMSZ": df["FAMILY SIZE OF SAMPLE"].astype(float),
                  "BLACK": (df.SAMPLE_RACE=="Black").astype(float),
                  "HISPANIC": (df.SAMPLE_RACE=="Hispanic").astype(float),
                  "FEMALE": (df.SAMPLE_SEX=="Female").astype(float)})
D["ACADCOMP"] = ((D.ABILITY-D.ABILITY.mean())/D.ABILITY.std(ddof=1)
                 + (D.PERCENTILE-D.PERCENTILE.mean())/D.PERCENTILE.std(ddof=1))/2
DEMO=["BLACK","HISPANIC","FEMALE"]

def logit(terms, robust=False):
    X=sm.add_constant(D[terms],has_constant="add")
    r=sm.Logit(y,X).fit(disp=0,maxiter=400)
    if robust: r=sm.Logit(y,X).fit(disp=0,maxiter=400,cov_type="HC1")
    conv=r.mle_retvals.get("converged",True); m=np.nanmax(np.abs(r.bse.values))
    return r, ("ok" if conv and m<25 else f"PROBLEM conv={conv} maxSE={m:.3g}")

PAIRS=[
 ("SES block only  ->  SES + academic(PERCENTILE)",        ["SES"],                 ["SES","PERCENTILE"]),
 ("SES block only  ->  SES + academic(PERCENTILE+ABILITY)",["SES"],                 ["SES","PERCENTILE","ABILITY"]),
 ("SES block only  ->  SES + academic(composite)",         ["SES"],                 ["SES","ACADCOMP"]),
 ("SES+demographics -> + academic(PERCENTILE)",            ["SES","FEMALE"],        ["SES","PERCENTILE","FEMALE"]),
 ("SES+full demographics -> + academic(PERCENTILE)",       ["SES"]+DEMO,            ["SES","PERCENTILE"]+DEMO),
 ("SES+demographics+famsize -> + academic(PERCENTILE)",    ["SES"]+DEMO+["FAMSZ"],  ["SES","PERCENTILE"]+DEMO+["FAMSZ"]),
 ("academic(PERCENTILE) only -> + SES",                    ["PERCENTILE"],          ["SES","PERCENTILE"]),
 ("academic block only -> academic + SES",                 ["PERCENTILE","ABILITY"],["SES","PERCENTILE","ABILITY"]),
 ("background only (race/sex/famsize) -> + SES + academic",DEMO+["FAMSZ"],          DEMO+["FAMSZ","SES","PERCENTILE"]),
 ("background only -> + SES + academic(+ABILITY)",         DEMO+["FAMSZ"],          DEMO+["FAMSZ","SES","PERCENTILE","ABILITY"]),
]
rows=[]
for label,A,B in PAIRS:
    ra,fa=logit(A); rb,fb=logit(B); rbR,_=logit(B,robust=True)
    for t in A:
        a,b=ra.params[t],rb.params[t]
        rows.append(dict(specification=label, variable=t,
            coefA=a, seA=ra.bse[t], pA=ra.pvalues[t],
            coefB=b, seB=rb.bse[t], pB=rb.pvalues[t],
            coefB_HC1=b, seB_HC1=rbR.bse[t], pB_HC1=rbR.pvalues[t],
            pct_change_signed=100*(b-a)/abs(a),
            pct_drop_abs=100*(abs(a)-abs(b))/abs(a),
            sig_flip_sig_to_nonsig=bool(ra.pvalues[t]<.05 and rb.pvalues[t]>=.05),
            d_to_quoted_pair=abs(abs(a)-0.5024)+abs(abs(b)-0.0923),
            diagA=fa, diagB=fb))
T=pd.DataFrame(rows)
T.insert(0,"rank_by_d",T.d_to_quoted_pair.rank(method="min").astype(int))
cols=["rank_by_d","specification","variable","coefA","seA","pA","coefB","seB","pB","coefB_HC1","seB_HC1","pB_HC1","pct_drop_abs","pct_change_signed","sig_flip_sig_to_nonsig","d_to_quoted_pair","diagA","diagB"]
T=T[cols].sort_values("d_to_quoted_pair")
for c in ["coefA","seA","pA","coefB","seB","pB","coefB_HC1","seB_HC1","pB_HC1"]: T[c]=T[c].round(4)
for c in ["pct_drop_abs","pct_change_signed","d_to_quoted_pair"]: T[c]=T[c].round(2)
print("### FINAL CONSOLIDATED TABLE (logit, unstandardised / as-shipped scales, N=8773, 236 events) ###")
print(T.to_string(index=False))
T.to_csv("out/FINAL_consolidated.csv",index=False)

print("\n### DECISION RULE APPLIED ###")
print("criteria: |coefA| in [0.45,0.56] and |coefB| in [0.07,0.12] and pA<.05<=pB and both coefs same sign")
cand=T[(T.coefA.abs().between(0.45,0.56)) & (T.coefB.abs().between(0.07,0.12))
       & T.sig_flip_sig_to_nonsig & (np.sign(T.coefA)==np.sign(T.coefB))]
print(cand[["specification","variable","coefA","coefB","pA","pB"]].to_string(index=False))
print("\nvariables ever satisfying ALL criteria:", sorted(cand.variable.unique()))
print("variables with ANY single criterion (>=60% abs drop + flip):",
      sorted(T[(T.pct_drop_abs>=60)&T.sig_flip_sig_to_nonsig].variable.unique()))

print("\n### Effect of the winning specification expressed as odds ratios ###")
r,_=logit(["SES"]); r2,_=logit(["SES","PERCENTILE"])
for nm,mod in [("SES only",r),("SES + PERCENTILE",r2)]:
    print(f"  {nm}: SES beta={mod.params['SES']:.4f}  OR={np.exp(mod.params['SES']):.4f} "
          f"(95% CI {np.exp(mod.conf_int().loc['SES',0]):.3f}-{np.exp(mod.conf_int().loc['SES',1]):.3f})")
print(f"  pseudo-R2: SES only={r.prsquared:.4f}; SES+PERCENTILE={r2.prsquared:.4f}; "
      f"LLR p={r2.llr_pvalue:.3g}")
r3,_=logit(["SES","PERCENTILE","ABILITY"])
print(f"  with ABILITY too: SES beta={r3.params['SES']:.4f} p={r3.pvalues['SES']:.4f} "
      f"(sign reversal; r(PERCENTILE,ABILITY)=0.699)")
print("\n### multicollinearity of the academic block (why the 2-variable block over-adjusts) ###")
print(f"  corr(SES,ABILITY)={np.corrcoef(df.SES,df['ABILITY: COMPOSITE OF ASVAB SCORE'])[0,1]:.3f}  "
      f"corr(SES,PERCENTILE)={np.corrcoef(df.SES,df['PERCENTILE IN CLASS'])[0,1]:.3f}  "
      f"corr(ABILITY,PERCENTILE)={np.corrcoef(df['ABILITY: COMPOSITE OF ASVAB SCORE'],df['PERCENTILE IN CLASS'])[0,1]:.3f}")
