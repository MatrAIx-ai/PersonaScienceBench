"""Block-structured comparison (no cherry-picked subsets).
Blocks: DEMO={BLACK,HISPANIC,FEMALE}, FAM={FAMSIZE}, SES={SES}, ACAD={ABILITY,PCTRANK}.
'Before' model contains SES but NOT academic; 'after' model contains SES AND academic
(and optionally curriculum-proxy = academic composite). Track every variable's coefficient.
Also report per-term best-match distance over the whole 9,310-cell enumeration for context."""
import warnings, itertools
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings("ignore"); pd.set_option("display.width", 260); pd.set_option("display.max_rows", 400)

df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
y = df["BA DEGREE COMPLETED"].astype(int)
V = pd.DataFrame({"SES": df["SES"].astype(float),
                  "ABILITY": df["ABILITY: COMPOSITE OF ASVAB SCORE"].astype(float),
                  "PCTRANK": df["PERCENTILE IN CLASS"].astype(float),
                  "FAMSIZE": df["FAMILY SIZE OF SAMPLE"].astype(float),
                  "BLACK": (df.SAMPLE_RACE=="Black").astype(float),
                  "HISPANIC": (df.SAMPLE_RACE=="Hispanic").astype(float),
                  "FEMALE": (df.SAMPLE_SEX=="Female").astype(float)})
z = lambda s: (s-s.mean())/s.std(ddof=1)
V["ACADCOMP"] = (z(V.ABILITY)+z(V.PCTRANK))/2          # composite 'academic characteristics'
CONT = ["SES","ABILITY","PCTRANK","FAMSIZE","ACADCOMP"]

def fit(fam, yv, terms, D):
    X = sm.add_constant(D[list(terms)], has_constant="add")
    r = sm.Logit(yv, X).fit(disp=0, maxiter=400) if fam=="logit" else sm.OLS(yv, X).fit()
    flag=""
    if fam in ("logit","probit") and not r.mle_retvals.get("converged",True): flag="NONCONV"
    if not np.isfinite(np.nanmax(np.abs(r.bse.values))) or np.nanmax(np.abs(r.bse.values))>25: flag+=" SEP"
    return r, flag

DEMO=["BLACK","HISPANIC","FEMALE"]
for scale in ["raw","z"]:
    D = V.copy()
    if scale=="z":
        for c in CONT: D[c]=z(D[c])
    for fam in ["logit","ols"]:
        print(f"\n############ scaling={scale}  family={fam}  N={len(y)} events={int(y.sum())} ############")
        rows=[]
        for extra in [[], DEMO, DEMO+["FAMSIZE"], ["FAMSIZE"]]:
            tag = "+".join(extra) if extra else "(none)"
            A = ["SES"]+extra                       # SES block only
            for AC in [["PCTRANK"],["ABILITY"],["PCTRANK","ABILITY"],["ACADCOMP"]]:
                B = ["SES"]+AC+extra                # SES + academic
                ra,na = fit(fam,y,A,D); rb,nb = fit(fam,y,B,D)
                for t in A:
                    rows.append(dict(bg=tag, academic_added="+".join(AC), term=t,
                        coefA=ra.params[t], seA=ra.bse[t], pA=ra.pvalues[t],
                        coefB=rb.params[t], seB=rb.bse[t], pB=rb.pvalues[t],
                        shrink_pct=100*(abs(ra.params[t])-abs(rb.params[t]))/abs(ra.params[t]),
                        flip=(ra.pvalues[t]<.05 and rb.pvalues[t]>=.05), flag=na+nb))
        T=pd.DataFrame(rows)
        T["d_to_target"]=(T.coefA.abs()-0.5024).abs()+(T.coefB.abs()-0.0923).abs()
        print(T.sort_values("d_to_target").round(4).to_string(index=False))
        if scale=="z" and fam=="logit": T.to_csv("out/blockgrid_z_logit.csv",index=False)
        if scale=="raw" and fam=="logit": T.to_csv("out/blockgrid_raw_logit.csv",index=False)

print("\n\n############ multiplicity context: best-match distance per term over ALL 9,310 nested pairs ############")
R=pd.read_csv("out/enumeration_all.csv")
R["dmin"]=R[[f"d_{t}" for t in ["raw","z","minmax"]]].min(axis=1)
g=R.groupby("term").agg(best_d=("dmin","min"), n_cells=("dmin","size"),
                        n_under_0p05=("dmin",lambda s:(s<0.05).sum()),
                        n_shrink60_flip=("flip",lambda s:0)).round(4)
print(g.to_string())
print("\nCells with dmin<0.05 by term & family & scaling:")
sub=R[R.dmin<0.05].copy()
for tag in ["raw","z","minmax"]:
    sub[f"use_{tag}"]=np.where((sub[f"d_{tag}"]<0.05), tag, "")
print(sub.groupby(["term","family"]).size().to_string())
print("\nOf those, how many also show significance flip and >=60% shrink:")
print(sub[sub.flip & (sub.shrink>=60)].groupby(["term","family"]).size().to_string())
