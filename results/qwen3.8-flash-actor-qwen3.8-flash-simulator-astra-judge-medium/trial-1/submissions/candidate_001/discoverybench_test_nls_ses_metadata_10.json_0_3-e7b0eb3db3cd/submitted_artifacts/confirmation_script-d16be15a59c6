"""Confirm/can-falsify the SES-mediator identification.
(1) scaling-invariance proof: t-stats, p-values and %shrink do not depend on predictor scaling
(2) candidate x family x sample robustness of 'collapse >=60% + loss of significance'
(3) targeted search: which spec reproduces 0.5024 -> 0.0923 most closely (logit, raw scale)
"""
import warnings, itertools
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings("ignore"); pd.set_option("display.width",260); pd.set_option("display.max_rows",400)

df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
y_all = df["BA DEGREE COMPLETED"].astype(int)
V = pd.DataFrame({"SES": df.SES.astype(float),
                  "ABILITY": df["ABILITY: COMPOSITE OF ASVAB SCORE"].astype(float),
                  "PCTRANK": df["PERCENTILE IN CLASS"].astype(float),
                  "FAMSIZE": df["FAMILY SIZE OF SAMPLE"].astype(float),
                  "BLACK": (df.SAMPLE_RACE=="Black").astype(float),
                  "HISPANIC": (df.SAMPLE_RACE=="Hispanic").astype(float),
                  "FEMALE": (df.SAMPLE_SEX=="Female").astype(float)})
z = lambda s:(s-s.mean())/s.std(ddof=1)
V["ACADCOMP"]=(z(V.ABILITY)+z(V.PCTRANK))/2
CONT=["SES","ABILITY","PCTRANK","FAMSIZE","ACADCOMP"]

print("### (1) SCALING INVARIANCE CHECK (logit, model SES+PCTRANK) ###")
for scal in ["raw","z","minmax"]:
    D=V.copy()
    if scal=="z":
        for c in CONT: D[c]=z(D[c])
    if scal=="minmax":
        for c in CONT: D[c]=(D[c]-D[c].min())/(D[c].max()-D[c].min())
    r=sm.Logit(y_all, sm.add_constant(D[["SES","PCTRANK"]])).fit(disp=0)
    r0=sm.Logit(y_all, sm.add_constant(D[["SES"]])).fit(disp=0)
    print(f"  {scal:7s} SES: coef={r.params['SES']:.4f} t={r.params['SES']/r.bse['SES']:.4f} "
          f"p={r.pvalues['SES']:.5f} | alone={r0.params['SES']:.4f} "
          f"| shrink={100*(abs(r0.params['SES'])-abs(r.params['SES']))/abs(r0.params['SES']):.3f}%")

def fit(fam,yv,X):
    X=sm.add_constant(X,has_constant="add"); flag=""
    if fam=="logit": r=sm.Logit(yv,X).fit(disp=0,maxiter=400)
    elif fam=="probit": r=sm.Probit(yv,X).fit(disp=0,maxiter=400)
    else: r=sm.OLS(yv,X).fit()
    if fam!="ols":
        if not r.mle_retvals.get("converged",True): flag="NONCONV"
    m=np.nanmax(np.abs(r.bse.values))
    if not np.isfinite(m) or m>25: flag+=f"SEP(maxSE={m:.1g})"
    return r,flag

samples={"full":np.ones(len(V),bool),"white":(df.SAMPLE_RACE=="White").values,
         "black":(df.SAMPLE_RACE=="Black").values,"hispanic":(df.SAMPLE_RACE=="Hispanic").values,
         "female":(df.SAMPLE_SEX=="Female").values,"male":(df.SAMPLE_SEX=="Male").values}

print("\n### (2) CANDIDATE x FAMILY x SAMPLE: SES alone -> SES + academic block ###")
rows=[]
for sn,sub in samples.items():
    yv=y_all.loc[sub]; D=V.loc[sub]
    if yv.sum()<15: continue
    for fam in ["logit","probit","ols"]:
        for ac in [["PCTRANK"],["ABILITY"],["PCTRANK","ABILITY"],["ACADCOMP"]]:
            ra,fa=fit(fam,yv,D[["SES"]]); rb,fb=fit(fam,yv,D[["SES"]+ac])
            a,b=ra.params["SES"],rb.params["SES"]
            rows.append(dict(sample=sn,events=int(yv.sum()),family=fam,academic="+".join(ac),
                coefA=a,seA=ra.bse["SES"],pA=ra.pvalues["SES"],coefB=b,seB=rb.bse["SES"],pB=rb.pvalues["SES"],
                shrink=100*(abs(a)-abs(b))/abs(a), flip=bool(ra.pvalues["SES"]<.05<=rb.pvalues["SES"]),
                flag=(fa+fb)))
T=pd.DataFrame(rows); T["d"]=(T.coefA.abs()-.5024).abs()+(T.coefB.abs()-.0923).abs()
print(T.sort_values("d").round(4).to_string(index=False))
T.to_csv("out/ses_across_samples_families.csv",index=False)

print("\n### (3) HEAD-TO-HEAD: every term, logit raw, 'before'=model with no academic block, "
      "'after'=same model + PERCENTILE(+ABILITY), full sample ###")
rows=[]
blocks=[[],["FEMALE"],["FAMSIZE"],["BLACK","HISPANIC"],["BLACK","HISPANIC","FEMALE"],
        ["BLACK","HISPANIC","FEMALE","FAMSIZE"],["SES"],["SES","FEMALE"],["SES","FAMSIZE"],
        ["SES","BLACK","HISPANIC"],["SES","BLACK","HISPANIC","FEMALE"],
        ["SES","BLACK","HISPANIC","FEMALE","FAMSIZE"]]
D=V
for bl in blocks:
    if not bl: continue
    for ac in [["PCTRANK"],["PCTRANK","ABILITY"]]:
        ra,_=fit("logit",y_all,D[bl]); rb,_=fit("logit",y_all,D[bl+ac])
        for t in bl:
            a,b=ra.params[t],rb.params[t]
            rows.append(dict(before="+".join(bl),added="+".join(ac),term=t,coefA=a,pA=ra.pvalues[t],
                coefB=b,pB=rb.pvalues[t],shrink=100*(abs(a)-abs(b))/abs(a),
                flip=bool(ra.pvalues[t]<.05<=rb.pvalues[t]),
                d=abs(abs(a)-.5024)+abs(abs(b)-.0923)) )
H=pd.DataFrame(rows)
print(H.sort_values("d").head(25).round(4).to_string(index=False))
print("\nsummary by term over these 24 before/after comparisons:")
print(H.groupby("term").agg(n=("flip","size"),flips=("flip","sum"),
      med_shrink=("shrink","median"),min_d=("d","min")).round(3).to_string())
H.to_csv("out/headtohead_logit.csv",index=False)
