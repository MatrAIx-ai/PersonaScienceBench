"""Exhaustive nested-pair search. Fit every subset of the 7 predictors once (logit & OLS,
raw scale), then derive z- and 0-1-scale coefficients analytically (coef*s, se*s).
For every nested pair A subset-of B and every term tracked in both, record
(coefA, coefB, pA, pB). Rank by distance to the quoted pair (0.5024 -> 0.0923).
Multiplicity is reported: how many cells match purely by chance tolerance."""
import warnings, itertools
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings("ignore"); pd.set_option("display.width", 260); pd.set_option("display.max_rows", 300)

df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
y = df["BA DEGREE COMPLETED"].astype(int)
V = pd.DataFrame({"SES": df["SES"].astype(float),
                  "ABILITY": df["ABILITY: COMPOSITE OF ASVAB SCORE"].astype(float),
                  "PCTRANK": df["PERCENTILE IN CLASS"].astype(float),
                  "FAMSIZE": df["FAMILY SIZE OF SAMPLE"].astype(float),
                  "BLACK": (df.SAMPLE_RACE == "Black").astype(float),
                  "HISPANIC": (df.SAMPLE_RACE == "Hispanic").astype(float),
                  "FEMALE": (df.SAMPLE_SEX == "Female").astype(float)})
names = list(V.columns)
sd = V.std(ddof=1); rng = V.max() - V.min()

def fit_all(fam):
    res = {}
    for k in range(1, len(names) + 1):
        for sub in itertools.combinations(names, k):
            X = sm.add_constant(V[list(sub)], has_constant="add")
            try:
                r = sm.Logit(y, X).fit(disp=0, maxiter=400) if fam == "logit" else sm.OLS(y, X).fit()
            except Exception:
                continue
            if fam == "logit" and not r.mle_retvals.get("converged", True):
                continue
            if np.nanmax(np.abs(r.bse.values)) > 25:      # separation guard
                continue
            res[sub] = (r.params, r.bse, r.pvalues)
    return res

rows = []
for fam in ["logit", "ols"]:
    RES = fit_all(fam)
    for B, (pB_, sB, pBv) in RES.items():
        for rA in range(1, len(B) + 1):
            for A in itertools.combinations([t for t in B], rA):
                if A == B: continue
                if A not in RES: continue
                pA_, sA, pAv = RES[A]
                for t in A:
                    rec = dict(family=fam, modelA="+".join(A), modelB="+".join(B), term=t,
                               coefA=pA_[t], seA=sA[t], pA=pAv[t],
                               coefB=pB_[t], seB=sB[t], pB=pBv[t])
                    for tag, mult in [("z", 1/sd[t]), ("minmax", 1/rng[t]), ("raw", 1.0)]:
                        rec[f"{tag}_A"] = rec["coefA"]*mult; rec[f"{tag}_B"] = rec["coefB"]*mult
                    rows.append(rec)
R = pd.DataFrame(rows)
R["flip"] = (R.pA < .05) & (R.pB >= .05)
R["shrink"] = 100*(R.coefA.abs()-R.coefB.abs())/R.coefA.abs()
for tag in ["raw", "z", "minmax"]:
    R[f"d_{tag}"] = (R[f"{tag}_A"].abs()-0.5024).abs() + (R[f"{tag}_B"].abs()-0.0923).abs()
    R[f"dpos_{tag}"] = (R[f"{tag}_A"]-0.5024).abs() + (R[f"{tag}_B"]-0.0923).abs()
R["d_best"] = R[[f"d_{t}" for t in ["raw","z","minmax"]]].min(axis=1)
R.to_csv("out/enumeration_all.csv", index=False)
print(f"nested-pair cells evaluated: {len(R)}  (models fitted per family: see log)")

print("\n### 1) Cells whose |coef| pair is closest to (0.5024, 0.0923), ANY scaling ###")
c = R.sort_values("d_best").head(20)
print(c[["family","term","modelA","modelB","raw_A","raw_B","z_A","z_B","pA","pB","shrink","flip","d_best"]].round(4).to_string(index=False))

print("\n### 2) Same but requiring POSITIVE coefs matching signed 0.5024 -> 0.0923 ###")
c2 = R.assign(d=R[[f"dpos_{t}" for t in ["raw","z","minmax"]]].min(axis=1)).sort_values("d").head(20)
print(c2[["family","term","modelA","modelB","raw_A","raw_B","z_A","z_B","pA","pB","shrink","flip","d"]].round(4).to_string(index=False))

print("\n### 3) Cells satisfying the STRUCTURE (>=60% shrink + significance flip) ###")
S = R[(R.shrink >= 60) & R.flip]
print("count:", len(S), "of", len(R))
print(S.groupby(["family","term"]).size().to_string())

print("\n### 4) Frequency with which each term shows a flip when academic block (ABILITY+PCTRANK) is ADDED to a model containing it ###")
def has_acad(B): return ("ABILITY" in B) or ("PCTRANK" in B)
R["Aterms"] = R.modelA.str.split("+"); R["Bterms"] = R.modelB.str.split("+")
def adding_acad(row):
    return all(t in row.Aterms for t in ["ABILITY","PCTRANK"]) == False and all(t in row.Bterms for t in ["ABILITY","PCTRANK"])
def adding_both(row):
    return adding_acad(row) and ("SES" not in row.Aterms) and ("SES" in row.Bterms)
R["add_acad"] = R.apply(adding_acad, axis=1); R["add_both"] = R.apply(adding_both, axis=1)
sel = R[R.add_both & (R.term != "SES") & (R.term != "ABILITY") & (R.term != "PCTRANK")]
print("cells where BOTH SES and academic block enter, tracking non-SES/non-academic term:", len(sel))
print(sel.groupby(["family","term"]).agg(n=("flip","size"), flips=("flip","sum"),
      med_shrink=("shrink","median"), medA=("coefA","median"), medB=("coefB","median")).round(3).to_string())
selz = sel.copy()
for tag in ["raw","z"]:
    sub = selz[selz.term.isin(["SES"])]
sel_ses = R[R.add_acad & (R.term == "SES")]
print("\nSES coefficient when academic block enters (all models containing SES, not academic):", len(sel_ses))
print(sel_ses.groupby("family").agg(n=("flip","size"), flips=("flip","sum"),
      med_shrink=("shrink","median"), minA=("coefA","min"), maxA=("coefA","max"),
      minB=("coefB","min"), maxB=("coefB","max")).round(3).to_string())
