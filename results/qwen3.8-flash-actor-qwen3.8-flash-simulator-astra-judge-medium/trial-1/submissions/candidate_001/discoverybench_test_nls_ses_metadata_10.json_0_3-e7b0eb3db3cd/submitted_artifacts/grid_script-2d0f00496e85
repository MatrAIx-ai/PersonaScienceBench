"""
NLS: which variable's effect on BA DEGREE COMPLETED falls ~0.5024 -> ~0.0923 (and loses
significance) when BOTH SES and academic characteristics are in the model?

Design (as approved):
  * SES is held OUT of the academic block (question treats them as two separate things).
  * Both directions fitted explicitly:
      P1  academic block  ->  academic block + SES      (track academic coefficients)
      P2  SES alone       ->  SES + academic block      (track SES's own coefficient)
      P3  single X        ->  single X + SES            (per-candidate screen)
      P4  single X        ->  single X + academic block (per-candidate screen)
      P5  full model      (context only)
  * Families: logistic regression (logit coefficients) and OLS/LPM.
  * Scalings of continuous predictors: raw, z-standardised, min-max 0-1.
  * Categoricals: dummy coding, reference levels White (race) and Male (sex).
  * Covariate mode: none vs demographics (race+sex dummies) held fixed within a pair.
  * Convergence / separation diagnostics are recorded, never silently ignored.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm

pd.set_option("display.width", 250)
pd.set_option("display.max_rows", 500)
warnings.filterwarnings("ignore")

DATA = "data/nls_ses_processed.csv"
CONT = ["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS",
        "FAMILY SIZE OF SAMPLE"]
SHORT = {"SES": "SES",
         "ABILITY: COMPOSITE OF ASVAB SCORE": "ABILITY",
         "PERCENTILE IN CLASS": "PERCENTILE",
         "FAMILY SIZE OF SAMPLE": "FAMILYSIZE"}

df = pd.read_csv(DATA)
df = df.drop(columns=[c for c in df.columns if c.startswith("Unnamed")])
y = df["BA DEGREE COMPLETED"].astype(int)
print(f"N = {len(df)}, events = {int(y.sum())} ({y.mean():.4%}), non-events = {int((1-y).sum())}")

demo_all = pd.DataFrame(index=df.index)
demo_all["BLACK"] = (df["SAMPLE_RACE"] == "Black").astype(float)
demo_all["HISPANIC"] = (df["SAMPLE_RACE"] == "Hispanic").astype(float)   # ref = White
demo_all["FEMALE"] = (df["SAMPLE_SEX"] == "Female").astype(float)        # ref = Male
demo_vars = ["BLACK", "HISPANIC", "FEMALE"]

scal = {}
scal["raw"] = df[CONT].astype(float).copy()
scal["z"] = ((df[CONT] - df[CONT].mean()) / df[CONT].std(ddof=1)).copy()
scal["minmax"] = ((df[CONT] - df[CONT].min()) / (df[CONT].max() - df[CONT].min())).copy()

ACAD_CORE = ["ABILITY", "PERCENTILE"]
ACAD_PLUS = ["ABILITY", "PERCENTILE", "FAMILYSIZE"]

def frame(scaling):
    X = pd.DataFrame({SHORT[c]: scal[scaling][c] for c in CONT})
    return pd.concat([X, demo_all], axis=1)

def fit(fam, yv, Xm):
    note = ""
    X = sm.add_constant(Xm, has_constant="add")
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        if fam == "logit":
            try:
                res = sm.Logit(yv, X).fit(disp=0, maxiter=200, method="newton")
            except Exception as e:
                res = sm.Logit(yv, X).fit(disp=0, maxiter=500, method="bfgs")
                note = f"newton failed ({type(e).__name__}); bfgs used"
        else:
            res = sm.OLS(yv, X).fit()
        msgs = [str(x.message) for x in w]
    if fam == "logit":
        if not res.mle_retvals.get("converged", True):
            note += " NON-CONVERGED"
        bmax = np.nanmax(res.bse.values)
        if not np.isfinite(bmax) or bmax > 25:
            note += f" HUGE_SE(maxSE={bmax:.3g}) -> separation/degenerate"
    if msgs:
        note += " | " + "; ".join(sorted(set(msgs))[:2])
    return res, note.strip()

rows = []
def record(direction, pair, specA, specB, tracked, fam, scaling, cov, acaddef):
    D = frame(scaling)
    covset = [v for v in demo_vars if cov == "demo"]
    specA = list(dict.fromkeys(specA)); specB = list(dict.fromkeys(specB))
    if set(specA) == set(specB):          # nothing added -> pair is vacuous, skip
        return
    def build(terms):
        cols = list(dict.fromkeys(list(terms) + covset))   # no duplicated columns
        return D[cols]
    Xa, Xb = build(specA), build(specB)
    ra, na = fit(fam, y, Xa)
    rb, nb = fit(fam, y, Xb)
    for t in tracked:
        rows.append(dict(direction=direction, pair=pair, acaddef=acaddef, cov=cov,
                         family=fam, scaling=scaling, term=t,
                         coefA=ra.params[t], seA=ra.bse[t], pA=ra.pvalues[t],
                         coefB=rb.params[t], seB=rb.bse[t], pB=rb.pvalues[t],
                         noteA=na, noteB=nb))

for fam in ["logit", "ols"]:
    for scaling in ["raw", "z", "minmax"]:
        for cov in ["none", "demo"]:
            for acaddef, ACAD in [("core", ACAD_CORE), ("plus", ACAD_PLUS)]:
                record("academic->academic+SES", "P1", ACAD, ACAD + ["SES"],
                       ACAD, fam, scaling, cov, acaddef)
                record("SES->SES+academic", "P2", ["SES"], ["SES"] + ACAD,
                       ["SES"], fam, scaling, cov, acaddef)
                for x in ["ABILITY", "PERCENTILE", "FAMILYSIZE", "SES"] + demo_vars:
                    record("single->+SES", "P3", [x], [x, "SES"], [x],
                           fam, scaling, cov, acaddef)
                for x in ["SES", "FAMILYSIZE"] + demo_vars:
                    record("single->+academic", "P4", [x], [x] + ACAD, [x],
                           fam, scaling, cov, acaddef)

R = pd.DataFrame(rows)
for c in ["coefA", "seA", "pA", "coefB", "seB", "pB"]:
    R[c] = pd.to_numeric(R[c], errors="coerce")
R["absA"] = R.coefA.abs(); R["absB"] = R.coefB.abs()
R["pct_change"] = np.where(R.coefA != 0, 100 * (R.coefB - R.coefA) / R.coefA.abs(), np.nan)
R["abs_pct_drop"] = 100 * (R.absA - R.absB) / R.absA
R["flip"] = (R.pA < .05) & (R.pB >= .05)
R["d_target"] = (R.absA - 0.5024).abs() + (R.absB - 0.0923).abs()
R.to_csv("out/model_grid_all.csv", index=False)
print(f"\nfitted {len(R)} candidate x specification cells")

prim = R[(R.scaling == "z") & (R.acaddef == "core")].copy()
tbl = prim[["term", "family", "cov", "pair", "coefA", "seA", "pA",
            "coefB", "seB", "pB", "abs_pct_drop", "flip"]].copy()
for c in ["coefA", "seA", "coefB", "seB", "pA", "pB", "abs_pct_drop"]:
    tbl[c] = tbl[c].round(4)
tbl = tbl.sort_values(["family", "cov", "pair", "term"])
tbl.to_csv("out/consolidated_z.csv", index=False)
print("\n=== CONSOLIDATED TABLE (z-standardised predictors; logit and LPM) ===")
print(tbl.to_string(index=False))

print("\n=== TOP MATCHES TO |coef| 0.5024 -> 0.0923 ===")
top = R.sort_values("d_target").head(15)
print(top[["term", "family", "scaling", "cov", "pair", "absA", "coefA", "pA",
           "absB", "coefB", "pB", "abs_pct_drop", "flip", "d_target"]]
      .round(4).to_string(index=False))

print("\n=== ROBUSTNESS: abs % drop (P1 and P2) across family x scaling ===")
sub = R[R.pair.isin(["P1", "P2"])].copy()
print(sub.pivot_table(index=["pair", "term", "cov"], columns=["family", "scaling"],
                      values="abs_pct_drop").round(1).to_string())
print("\nflips (True/False), same layout:")
print(sub.pivot_table(index=["pair", "term", "cov"], columns=["family", "scaling"],
                      values="flip").to_string())
print("\nsign of coefA across the 6 family x scaling cells (each char one cell):")
print(sub.pivot_table(index=["pair", "term", "cov"], columns=["family"],
                      values="coefA",
                      aggfunc=lambda s: "".join("+" if v > 0 else "-" for v in s)).to_string())

print("\n=== P1/P2 ranking, logit + z + demographics + core academic block ===")
q = R[(R.pair.isin(["P1", "P2"])) & (R.family == "logit") & (R.scaling == "z")
      & (R.cov == "demo") & (R.acaddef == "core")]
print(q[["pair", "term", "coefA", "pA", "coefB", "pB", "abs_pct_drop"]]
      .sort_values(["pair", "coefA"], ascending=[True, False]).round(4).to_string(index=False))

print("\n=== FULL MODEL (all predictors, z) ===")
D = frame("z")[["SES"] + ACAD_CORE + demo_vars]
for fam in ["logit", "ols"]:
    res, note = fit(fam, y, D)
    print(f"\n-- {fam} {'(' + note + ')' if note else ''} --")
    print(pd.DataFrame({"coef": res.params.round(4), "se": res.bse.round(4),
                        "p": res.pvalues.round(4)}).to_string())
    if fam == "logit":
        print("pseudo-R2 =", round(res.prsquared, 4), "| LLF =", round(res.llf, 2),
              "| converged =", res.mle_retvals.get("converged"))

bad = R[(R.noteA != "") | (R.noteB != "")]
print(f"\ncells with convergence/separation notes: {len(bad)} / {len(R)}")
if len(bad):
    print(bad[["family", "scaling", "cov", "pair", "term", "noteA", "noteB"]].head(20).to_string(index=False))
