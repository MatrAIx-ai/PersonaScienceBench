"""Model hierarchy on BA DEGREE COMPLETED: which coefficient collapses when SES AND the
academic block both enter? Reports signed coefs, SEs, p, %change for every term in every
nested model, for logit, LPM and probit, on raw and z-scaled predictors."""
import warnings
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings("ignore"); pd.set_option("display.width", 260); pd.set_option("display.max_rows", 400)

df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
y = df["BA DEGREE COMPLETED"].astype(int)
V = pd.DataFrame({
    "SES": df["SES"].astype(float),
    "ABILITY": df["ABILITY: COMPOSITE OF ASVAB SCORE"].astype(float),
    "PCTRANK": df["PERCENTILE IN CLASS"].astype(float),
    "FAMSIZE": df["FAMILY SIZE OF SAMPLE"].astype(float),
    "BLACK": (df.SAMPLE_RACE == "Black").astype(float),
    "HISPANIC": (df.SAMPLE_RACE == "Hispanic").astype(float),
    "FEMALE": (df.SAMPLE_SEX == "Female").astype(float)})
CONT = ["SES", "ABILITY", "PCTRANK", "FAMSIZE"]
MODELS = {
 "M0 background only (race,sex,famsize)": ["BLACK","HISPANIC","FEMALE","FAMSIZE"],
 "M1 academic only (ABILITY,PCTRANK)":    ["ABILITY","PCTRANK"],
 "M2 SES only":                           ["SES"],
 "M3 background + SES":                   ["BLACK","HISPANIC","FEMALE","FAMSIZE","SES"],
 "M4 background + academic":              ["BLACK","HISPANIC","FEMALE","FAMSIZE","ABILITY","PCTRANK"],
 "M5 SES + academic":                     ["SES","ABILITY","PCTRANK"],
 "M6 everything (SES + academic + bg)":   ["SES","ABILITY","PCTRANK","BLACK","HISPANIC","FEMALE","FAMSIZE"],
 "M7 academic + SES (no bg)":             ["ABILITY","PCTRANK","SES"],
 "M8 academic only + race/sex":           ["ABILITY","PCTRANK","BLACK","HISPANIC","FEMALE"],
}
def fit(fam, X):
    X = sm.add_constant(X, has_constant="add")
    if fam == "logit":
        r = sm.Logit(y, X).fit(disp=0, maxiter=300)
    elif fam == "probit":
        r = sm.Probit(y, X).fit(disp=0, maxiter=300)
    else:
        r = sm.OLS(y, X).fit()
    conv = r.mle_retvals.get("converged", True) if fam in ("logit","probit") else True
    mx = np.nanmax(np.abs(r.bse.values))
    flag = "" if conv else " NONCONV"
    if not np.isfinite(mx) or mx > 25: flag += f" SEPA(maxSE={mx:.2g})"
    return r, flag

for scaling in ["raw", "z"]:
    D = V.copy()
    if scaling == "z":
        for c in CONT: D[c] = (D[c]-D[c].mean())/D[c].std(ddof=1)
    for fam in ["logit","ols","probit"]:
        out = {}
        flags = {}
        for mname, terms in MODELS.items():
            r, fl = fit(fam, D[terms]); flags[mname] = fl
            for t in terms: out[(mname, t)] = (r.params[t], r.bse[t], r.pvalues[t])
        T = pd.DataFrame(out).T
        T.index = pd.MultiIndex.from_tuples(T.index, names=["model","term"])
        T.columns = ["coef","se","p"]
        print(f"\n===== scaling={scaling}  family={fam}  (N={len(y)}, events={int(y.sum())}) =====")
        print(T.round(4).to_string())
        if scaling == "z" and fam == "logit":
            T.reset_index().to_csv("out/hierarchy_z_logit.csv", index=False)
        if scaling == "raw" and fam == "logit":
            T.reset_index().to_csv("out/hierarchy_raw_logit.csv", index=False)
print("\nconvergence/separation flags:")
for m,f in flags.items(): print(f"  {m}: {f or 'ok'}")
