"""Systematic nested-model scan: which tracked variable's coefficient falls ~0.5024 -> ~0.0923
and loses significance when BOTH SES and the academic block enter the model?
A = base spec containing neither SES nor academic vars (or only one of them);
B = A + academic block, A + SES, or A + academic block + SES.
Families: logit + OLS/LPM. Scalings: raw, z, minmax. Subsamples: full, White, Female, Male."""
import warnings, itertools
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings("ignore"); pd.set_option("display.width", 250); pd.set_option("display.max_rows", 400)

df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
CONT = ["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS", "FAMILY SIZE OF SAMPLE"]
SHORT = {c: c.split(":")[0].split(" OF ")[0].strip() for c in CONT}
SHORT["ABILITY: COMPOSITE OF ASVAB SCORE"] = "ABILITY"; SHORT["PERCENTILE IN CLASS"] = "PCTRANK"
SHORT["FAMILY SIZE OF SAMPLE"] = "FAMSIZE"; SHORT["SES"] = "SES"
S = pd.DataFrame({SHORT[c]: df[c].astype(float) for c in CONT})
S["BLACK"] = (df.SAMPLE_RACE == "Black").astype(float)
S["HISPANIC"] = (df.SAMPLE_RACE == "Hispanic").astype(float)
S["FEMALE"] = (df.SAMPLE_SEX == "Female").astype(float)
NONAC = ["FAMSIZE", "BLACK", "HISPANIC", "FEMALE"]
y_all = df["BA DEGREE COMPLETED"].astype(int)
ACAD = ["ABILITY", "PCTRANK"]
samples = {"full": np.ones(len(df), bool), "white": (df.SAMPLE_RACE == "White").values,
           "female": (df.SAMPLE_SEX == "Female").values, "male": (df.SAMPLE_SEX == "Male").values}

def scaled(scaling, sub):
    X = S.copy()
    if scaling == "z":
        for c in CONT: X[SHORT[c]] = (X[SHORT[c]] - X[SHORT[c]].mean()) / X[SHORT[c]].std(ddof=1)
    elif scaling == "minmax":
        for c in CONT: X[SHORT[c]] = (X[SHORT[c]] - X[SHORT[c]].min()) / (X[SHORT[c]].max() - X[SHORT[c]].min())
    return X.loc[sub]

def fit(fam, yv, Xm):
    X = sm.add_constant(Xm, has_constant="add"); note = ""
    try:
        res = sm.Logit(yv, X).fit(disp=0, maxiter=300) if fam == "logit" else sm.OLS(yv, X).fit()
    except Exception as e:
        return None, f"singular:{type(e).__name__}"
    if fam == "logit":
        if not res.mle_retvals.get("converged", True): note += "NONCONV "
        b = np.nanmax(np.abs(res.bse.values))
        if not np.isfinite(b) or b > 25: note += f"SEPA(maxSE={b:.2g})"
    return res, note

base_specs = [[], ["FEMALE"], ["FAMSIZE"], ["BLACK", "HISPANIC"], ["BLACK", "HISPANIC", "FEMALE"],
              ["BLACK", "HISPANIC", "FEMALE", "FAMSIZE"], ["FAMSIZE", "FEMALE"], ["SES"], ["SES", "FEMALE"],
              ["SES", "BLACK", "HISPANIC", "FEMALE"], ["SES", "FAMSIZE", "BLACK", "HISPANIC", "FEMALE"]]
add_specs = {"+ACAD": ACAD, "+SES": ["SES"], "+ACAD+SES": ACAD + ["SES"]}

rows = []
for sname, sub in samples.items():
    y = y_all.loc[sub]
    if y.sum() < 20: continue
    for fam in ["logit", "ols"]:
        for scaling in ["raw", "z", "minmax"]:
            X = scaled(scaling, sub)
            for base in base_specs:
                if base == [] and list(add_specs)[0] == []: continue
                resA, nA = fit(fam, y, X[base]) if base else (None, "emptyA")
                for aname, add in add_specs.items():
                    bterms = list(dict.fromkeys(base + [a for a in add if a not in [SHORT[c] for c in CONT[:1]] or aname != "+SES"]))
                    bterms = [t for t in dict.fromkeys(base + add) if not (aname == "+SES" and t == "SES" and "SES" in base)]
                    if list(dict.fromkeys(base + add)) == base: continue
                    resB, nB = fit(fam, y, X[list(dict.fromkeys(base + add))])
                    if resB is None: continue
                    for t in dict.fromkeys(base + ([add[0]] if False else [])):
                        pass
                    for t in dict.fromkeys(base):
                        if resA is None: continue
                        rows.append(dict(sample=sname, family=fam, scaling=scaling, base="+".join(base) or "(intercept)",
                                         added=aname, term=t,
                                         coefA=resA.params[t], seA=resA.bse[t], pA=resA.pvalues[t],
                                         coefB=resB.params[t], seB=resB.bse[t], pB=resB.pvalues[t],
                                         orA=np.exp(resA.params[t]) if fam == "logit" else np.nan,
                                         orB=np.exp(resB.params[t]) if fam == "logit" else np.nan,
                                         noteA=nA, noteB=nB))
                    if not base:  # track newly added vars against intercept-only A
                        for t in dict.fromkeys(add):
                            res0, n0 = fit(fam, y, X[[]].assign(const=1.0)[["const"]]) if False else (None, "")
R = pd.DataFrame(rows)
for c in ["coefA", "seA", "pA", "coefB", "seB", "pB", "orA", "orB"]:
    R[c] = pd.to_numeric(R[c], errors="coerce")
R["absA"], R["absB"] = R.coefA.abs(), R.coefB.abs()
R["abs_pct_drop"] = 100 * (R.absA - R.absB) / R.absA
R["flip"] = (R.pA < .05) & (R.pB >= .05)
R["d_coef"] = (R.absA - .5024).abs() + (R.absB - .0923).abs()
R["d_or"] = (R.orA - .5024).abs() + (R.orB - .0923).abs()
R.to_csv("out/scan_all.csv", index=False)
print("cells:", len(R))

print("\n### A) cells where the variable COLLAPSES >=70% AND loses significance (full sample, both families) ###")
sel = R[(R["sample"] == "full") & (R.abs_pct_drop >= 70) & R.flip]
print(sel.groupby(["term", "added"]).agg(n=("flip", "size"), min_drop=("abs_pct_drop", "min"),
      med_drop=("abs_pct_drop", "median")).to_string())
print("\nall such cells:")
print(sel[["family", "scaling", "base", "added", "term", "coefA", "pA", "coefB", "pB", "abs_pct_drop"]]
      .round(4).to_string(index=False))

print("\n### B) closest |coef| matches to 0.5024 -> 0.0923 (top 20, all cells) ###")
print(R.sort_values("d_coef").head(20)[["sample","family","scaling","base","added","term","coefA","pA","coefB","pB","abs_pct_drop","flip","d_coef"]].round(4).to_string(index=False))

print("\n### C) closest ODDS-RATIO matches to 0.5024 -> 0.0923 (top 12, logit only) ###")
print(R[R.family=="logit"].sort_values("d_or").head(12)[["sample","scaling","base","added","term","orA","pA","orB","pB","abs_pct_drop","flip","d_or"]].round(4).to_string(index=False))
