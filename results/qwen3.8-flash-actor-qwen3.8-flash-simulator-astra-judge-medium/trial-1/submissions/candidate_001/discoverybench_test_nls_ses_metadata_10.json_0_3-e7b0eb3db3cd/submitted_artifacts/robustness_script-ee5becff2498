"""Robustness of the IDENTITY (not the magnitude): headline spec
   A = SES (+demographics)  ->  B = A + academic characteristics (class percentile)
tracked for every candidate variable, across raw/z/min-max scaling, logit/LPM/probit,
and across sex/race subsamples. %drop and p-values are provably scaling-invariant."""
import warnings
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings("ignore"); pd.set_option("display.width",250); pd.set_option("display.max_rows",300)
df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
yall = df["BA DEGREE COMPLETED"].astype(int)
V = pd.DataFrame({"SES":df.SES.astype(float),
                  "ABILITY":df["ABILITY: COMPOSITE OF ASVAB SCORE"].astype(float),
                  "PERCENTILE":df["PERCENTILE IN CLASS"].astype(float),
                  "FAMSZ":df["FAMILY SIZE OF SAMPLE"].astype(float),
                  "BLACK":(df.SAMPLE_RACE=="Black").astype(float),
                  "HISPANIC":(df.SAMPLE_RACE=="Hispanic").astype(float),
                  "FEMALE":(df.SAMPLE_SEX=="Female").astype(float)})
CONT=["SES","ABILITY","PERCENTILE","FAMSZ"]
z=lambda s:(s-s.mean())/s.std(ddof=1)

def run(yv, D, fam, A, B):
    Xa=sm.add_constant(D[A],has_constant="add"); Xb=sm.add_constant(D[B],has_constant="add")
    f = (lambda X: sm.Logit(yv,X).fit(disp=0,maxiter=400)) if fam=="logit" else \
        (lambda X: sm.Probit(yv,X).fit(disp=0,maxiter=400)) if fam=="probit" else \
        (lambda X: sm.OLS(yv,X).fit())
    ra,rb=f(Xa),f(Xb)
    out=[]
    for t in A:
        a,b=ra.params[t],rb.params[t]
        out.append(dict(term=t,coefA=a,seA=ra.bse[t],pA=ra.pvalues[t],coefB=b,seB=rb.bse[t],pB=rb.pvalues[t],
            pct_drop=100*(abs(a)-abs(b))/abs(a), flip=bool(ra.pvalues[t]<.05<=rb.pvalues[t]),
            sign_preserved=bool(np.sign(a)==np.sign(b))))
    return out

samples={"full":np.ones(len(V),bool),"white":(df.SAMPLE_RACE=="White").values,
         "black":(df.SAMPLE_RACE=="Black").values,"hispanic":(df.SAMPLE_RACE=="Hispanic").values,
         "female":(df.SAMPLE_SEX=="Female").values,"male":(df.SAMPLE_SEX=="Male").values}
A=["SES","BLACK","HISPANIC","FEMALE"]; B=A+["PERCENTILE"]

print("### RANKING BY %DROP + FLIP: A=[SES,race,sex] -> B=A+PERCENTILE ; every family x scaling, full sample")
rows=[]
for fam in ["logit","ols","probit"]:
    for scaling in ["raw","z","minmax"]:
        D=V.copy()
        if scaling=="z":
            for c in CONT: D[c]=z(D[c])
        if scaling=="minmax":
            for c in CONT: D[c]=(D[c]-D[c].min())/(D[c].max()-D[c].min())
        for r in run(yall,D,fam,A,B):
            r.update(family=fam,scaling=scaling,sample="full"); rows.append(r)
R=pd.DataFrame(rows)
piv=R.pivot_table(index="term",columns=["family","scaling"],values="pct_drop").round(1)
print(piv.to_string())
print("\nflip (pA<.05<=pB):")
print(R.pivot_table(index="term",columns=["family","scaling"],values="flip").astype(int).to_string())
print("\nsign preserved:")
print(R.pivot_table(index="term",columns=["family","scaling"],values="sign_preserved").astype(int).to_string())
print("\nranking of |coefA| within each family (z scaling):")
print(R[R.scaling=='z'].pivot_table(index="term",columns="family",values="coefA").round(4).to_string())
R.to_csv("out/robust_ranking_full.csv",index=False)

print("\n### subsample replication (logit raw, same spec) ###")
rows=[]
for sn,sub in samples.items():
    yv=yall.loc[sub]; D=V.loc[sub]
    if yv.sum()<15: continue
    A2=[t for t in A if D[t].nunique()>1]          # drop within-sample constant dummies
    B2=A2+["PERCENTILE"]
    for r in run(yv,D,"logit",A2,B2): r.update(sample=sn,events=int(yv.sum()),family="logit",scaling="raw"); rows.append(r)
S=pd.DataFrame(rows)
print(S[["sample","events","term","coefA","pA","coefB","pB","pct_drop","flip","sign_preserved"]].round(4).to_string(index=False))
S.to_csv("out/robust_subsamples.csv",index=False)

print("\n### events-per-variable check for the headline models ###")
for nm,terms in [("SES only",["SES"]),("SES+PERCENTILE",["SES","PERCENTILE"]),
                 ("SES+demographics+PERCENTILE",A+["PERCENTILE"]),
                 ("full (SES+academic+demo+famsize)",A+["ABILITY","PERCENTILE","FAMSZ"])]:
    print(f"  {nm}: k={len(terms)} params(+const) EPV={236/(len(terms)+1):.1f}")
