"""
Effect modification of the SES -> BA-degree association by race (NLS, N=8773).
Primary: logistic M3 (BA ~ SES*race + sex + family size [partial] ; + ASVAB + class percentile [full]).
Pre-set fallback rule: if any race cell <10 events (main models) OR log-CI half-width > 2,
Firth penalized logistic becomes primary for those estimates.
"""
import numpy as np, pandas as pd, json
from scipy import stats

rng = np.random.default_rng(20261022)
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['female'] = (df['SAMPLE_SEX']=='Female').astype(float)
df['black']  = (df['SAMPLE_RACE']=='Black').astype(float)
df['hisp']   = (df['SAMPLE_RACE']=='Hispanic').astype(float)
df['ses_sd'] = df['SES']/df['SES'].std()
df['asvab'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['pct']   = df['PERCENTILE IN CLASS']
df['fam']   = df['FAMILY SIZE OF SAMPLE']
df['ses_sd:black'] = df['ses_sd']*df['black']
df['ses_sd:hisp']  = df['ses_sd']*df['hisp']

print('=== descriptives ===')
print(df.groupby('SAMPLE_RACE').agg(n=('BA','size'), events=('BA','sum'),
      rate=('BA','mean'), ses_mean=('SES','mean'), ses_sd=('SES','std')))
q = pd.qcut(df['SES'], 4, labels=['Q1','Q2','Q3','Q4'])
cell = df.groupby(['SAMPLE_RACE', q], observed=True)['BA'].agg(['size','sum'])
print(cell.rename(columns={'sum':'events'}))

def irls(X, y, firth=False, maxit=200, tol=1e-10):
    X = np.asarray(X, float); y = np.asarray(y, float)
    b = np.zeros(X.shape[1])
    for it in range(maxit):
        eta = X@b; pr = 1/(1+np.exp(-eta)); W = pr*(1-pr)
        XtWX = X.T@(X*W[:,None])
        try: XtWX_inv = np.linalg.inv(XtWX)
        except np.linalg.LinAlgError: XtWX_inv = np.linalg.pinv(XtWX)
        h = np.einsum('ij,jk,ik->i', X, XtWX_inv, X)*W
        U = X.T@(y-pr)
        if firth:
            U = U + 0.5*X.T@((h/W)*(y-pr))
        step = np.clip(XtWX_inv@U, -10, 10)
        b = b + step
        if np.max(np.abs(step)) < tol:
            return b, XtWX_inv, it+1
    return b, XtWX_inv, maxit

def fit(cols, data, firth=False):
    X = np.column_stack([np.ones(len(data))]+[data[c].values for c in cols]); y = data['BA'].values
    b, V, it = irls(X, y, firth=firth)
    se = np.sqrt(np.diag(V))
    names = ['const']+cols
    return pd.DataFrame({'beta':b,'se':se,'z':b/se,'p':2*stats.norm.sf(np.abs(b/se))}, index=names), V, names

def lrt(ll_small, ll_big, dfdiff):
    stat = 2*(ll_big-ll_small); return stat, stats.chi2.sf(stat, dfdiff)

def loglik(cols, data, b):
    X = np.column_stack([np.ones(len(data))]+[data[c].values for c in cols])
    eta = X@b; pr = np.clip(1/(1+np.exp(-eta)), 1e-12, 1-1e-12)
    return np.sum(data['BA'].values*np.log(pr)+(1-data['BA'].values)*np.log(1-pr))

def race_ses_or(res, V, names, prefix='ses_sd'):
    out = {}
    combos = {'White':{prefix:1}, 'Black':{prefix:1, f'{prefix}:black':1}, 'Hispanic':{prefix:1, f'{prefix}:hisp':1}}
    for r,cm in combos.items():
        c = np.zeros(len(names))
        for k,w in cm.items(): c[names.index(k)] = w
        est = c@res['beta'].values; se = np.sqrt(c@V@c)
        out[r] = dict(logOR=float(est), se=float(se), OR=float(np.exp(est)),
                      lo=float(np.exp(est-1.96*se)), hi=float(np.exp(est+1.96*se)),
                      p=float(2*stats.norm.sf(abs(est/se))))
    return out

results = {}
spec = {
 'M1_unadj':      ['ses_sd'],
 'M2_main':       ['ses_sd','black','hisp'],
 'M3p_partial':   ['ses_sd','black','hisp','female','fam'],
 'M3p_int':       ['ses_sd','black','hisp','female','fam','ses_sd:black','ses_sd:hisp'],
 'M3f_full':      ['ses_sd','black','hisp','female','fam','asvab','pct'],
 'M3f_int':       ['ses_sd','black','hisp','female','fam','asvab','pct','ses_sd:black','ses_sd:hisp'],
}
fits = {}
for name, cols in spec.items():
    res, V, names = fit(cols, df)
    ll = loglik(cols, df, res['beta'].values)
    fits[name] = dict(res=res, V=V, names=names, ll=ll)
    print(f'\n--- {name} (loglik={ll:.2f}) ---')
    print(res.assign(OR=np.exp(res.beta), lo=np.exp(res.beta-1.96*res.se), hi=np.exp(res.beta+1.96*res.se)).round(4))

print('\n=== interaction tests (LRT) ===')
for base, inter, nc in [('M3p_partial','M3p_int',2), ('M3f_full','M3f_int',2)]:
    s,p = lrt(fits[base]['ll'], fits[inter]['ll'], nc)
    print(f'{base} vs {inter}: LR chi2({nc})={s:.3f}, p={p:.4f}')

print('\n=== race-specific SES OR (per 1 SD SES) ===')
for nm in ['M3p_int','M3f_int']:
    ors = race_ses_or(fits[nm]['res'], fits[nm]['V'], fits[nm]['names'])
    results[nm] = ors
    print(f'-- {nm} --')
    for r,v in ors.items():
        print(f"{r:9s} OR={v['OR']:.3f} (95% CI {v['lo']:.3f}-{v['hi']:.3f}) p={v['p']:.4g}")

print('\n=== interaction contrasts vs White ===')
for nm in ['M3p_int','M3f_int']:
    res,V,names = fits[nm]['res'], fits[nm]['V'], fits[nm]['names']
    for t in ['ses_sd:black','ses_sd:hisp']:
        i = names.index(t); b=res['beta'].iloc[i]; se=res['se'].iloc[i]
        print(f'{nm:10s} {t:14s} ratio-OR={np.exp(b):.3f} (95% CI {np.exp(b-1.96*se):.3f}-{np.exp(b+1.96*se):.3f}) p={res["p"].iloc[i]:.4g}')

print('\n=== stratified fits: BA ~ ses_sd (unadjusted within race) ===')
for r,sub in df.groupby('SAMPLE_RACE'):
    res,V,names = fit(['ses_sd'], sub)
    b=res.loc['ses_sd']
    print(f'{r:9s} n={len(sub)} ev={int(sub.BA.sum())} OR={np.exp(b.beta):.3f} (95% CI {np.exp(b.beta-1.96*b.se):.3f}-{np.exp(b.beta+1.96*b.se):.3f}) p={b.p:.4g}')

print('\n=== Firth penalized logistic (interaction models) ===')
for inter in ['M3p_int','M3f_int']:
    res,V,names = fit(spec[inter], df, firth=True)
    print(f'-- Firth {inter} --')
    print(res.assign(OR=np.exp(res.beta), lo=np.exp(res.beta-1.96*res.se), hi=np.exp(res.beta+1.96*res.se)).loc[['ses_sd','ses_sd:black','ses_sd:hisp']].round(4))
    ors = race_ses_or(res, V, names)
    results['firth_'+inter] = ors
    for r,v in ors.items():
        print(f"  {r:9s} OR={v['OR']:.3f} (95% CI {v['lo']:.3f}-{v['hi']:.3f}) p={v['p']:.4g}")

print('\n=== bootstrap (B=500, case resampling) race-specific SES OR, full-adjusted interaction model ===')
B=500; keep=[]
cols = spec['M3f_int']
for b_i in range(B):
    idx = rng.integers(0, len(df), len(df))
    d = df.iloc[idx]
    if d['BA'].sum()<10 or d.groupby('SAMPLE_RACE')['BA'].sum().min()<5: continue
    try:
        r_,V_,n_ = fit(cols, d)
    except Exception: continue
    if not np.all(np.isfinite(r_['beta'])): continue
    keep.append((r_,V_,n_))
print(f'valid bootstrap fits: {len(keep)}/{B}')
boot_summary={}
for race,cm in [('White',{'ses_sd':1}),('Black',{'ses_sd':1,'ses_sd:black':1}),('Hispanic',{'ses_sd':1,'ses_sd:hisp':1})]:
    ests=[]
    for r_,V_,n_ in keep:
        c=np.zeros(len(n_))
        for k,w in cm.items(): c[n_.index(k)]=w
        ests.append(np.exp(c@r_['beta'].values))
    ests=np.array(ests)
    boot_summary[race]=[float(np.median(ests)), float(np.percentile(ests,2.5)), float(np.percentile(ests,97.5))]
    print(f'{race:9s} OR median={np.median(ests):.3f} boot95 CI=({np.percentile(ests,2.5):.3f}-{np.percentile(ests,97.5):.3f})')

print('\n=== VIF (full-adjusted interaction design; standard OLS-based VIF) ===')
vcols = spec['M3f_int']
Xd = np.column_stack([np.ones(len(df))]+[df[c].values for c in vcols])
vifs={}
for j,nm in enumerate(['const']+vcols):
    if nm=='const': continue
    yj = Xd[:,j]; Xo = np.delete(Xd, j, axis=1)
    beta, *_ = np.linalg.lstsq(Xo, yj, rcond=None)
    resid = yj - Xo@beta
    r2 = 1 - resid.var()/yj.var()
    vifs[nm] = float(1/(1-min(r2,0.999999)))
print({k:round(v,2) for k,v in vifs.items()})
# VIF among main covariates only (no interactions) for interpretability
maincols=['ses_sd','black','hisp','female','fam','asvab','pct']
Xm = np.column_stack([np.ones(len(df))]+[df[c].values for c in maincols])
vifs_main={}
for j,nm in enumerate(['const']+maincols):
    if nm=='const': continue
    yj = Xm[:,j]; Xo = np.delete(Xm, j, axis=1)
    beta, *_ = np.linalg.lstsq(Xo, yj, rcond=None)
    resid = yj - Xo@beta
    r2 = 1 - resid.var()/yj.var()
    vifs_main[nm] = float(1/(1-min(r2,0.999999)))
print('main-effects-only VIF:', {k:round(v,2) for k,v in vifs_main.items()})

print('\n=== separation checks (full model) ===')
res = fits['M3f_int']['res']
X = np.column_stack([np.ones(len(df))]+[df[c].values for c in spec['M3f_int']])
pr = 1/(1+np.exp(-X@res['beta'].values))
print(f'max |beta|={res.beta.abs().max():.3f}; fitted p range=({pr.min():.4f},{pr.max():.4f}); loglik={fits["M3f_int"]["ll"]:.2f}')
print(f'fitted p: mean among events={pr[df.BA==1].mean():.4f}, mean among non-events={pr[df.BA==0].mean():.4f}')
print(f'min fitted p among events={pr[df.BA==1].min():.4f}, max fitted p among non-events={pr[df.BA==0].max():.4f}')

print('\n=== robustness: SES quartiles x race, Firth logistic, full controls ===')
d2 = df.copy()
qs = pd.qcut(d2['SES'],4, labels=False)
for i,lab in enumerate(['q2','q3','q4'],start=1): d2[lab]= (qs>=i).astype(float)
for r,race in [('b','black'),('h','hisp')]:
    for lab in ['q2','q3','q4']: d2[lab+r]=d2[lab]*d2[race]
qcols=['q2','q3','q4','black','hisp','female','fam','asvab','pct','q2b','q3b','q4b','q2h','q3h','q4h']
qbase=['q2','q3','q4','black','hisp','female','fam','asvab','pct']
res,V,names = fit(qcols, d2, firth=True)
show=[c for c in qcols if c not in ('female','fam','asvab','pct')]
print(res.assign(OR=np.exp(res.beta), lo=np.exp(res.beta-1.96*res.se), hi=np.exp(res.beta+1.96*res.se)).loc[show].round(3))
res0,V0,n0 = fit(qbase, d2, firth=True)
def dev(cols, res_):
    Xb=np.column_stack([np.ones(len(d2))]+[d2[c].values for c in cols])
    p=1/(1+np.exp(-Xb@res_['beta'].values)); p=np.clip(p,1e-12,1)
    return -2*np.sum(d2.BA*np.log(p)+(1-d2.BA)*np.log(1-p))
dev_full=dev(qcols,res); dev0=dev(qbase,res0)
print(f'quartile model deviance: base={dev0:.2f}, with interactions={dev_full:.2f}, diff={dev0-dev_full:.2f} on 6 df (chi2 p={stats.chi2.sf(dev0-dev_full,6):.4f})')

results['bootstrap_full']=boot_summary
json.dump(results, open('out/race_specific_ORS.json','w'), indent=1)
print('\nsaved out/race_specific_ORS.json')
