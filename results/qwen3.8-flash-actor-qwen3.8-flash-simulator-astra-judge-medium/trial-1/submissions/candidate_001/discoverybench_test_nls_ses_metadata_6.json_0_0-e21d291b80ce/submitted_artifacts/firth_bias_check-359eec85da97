"""Cleaner bias check with FIXED truth, mimicking the top-quartile cell sizes of our data."""
import numpy as np, sys
sys.path.insert(0, "analysis")
from stats_lib import firth_logit, irls_logit
rng = np.random.default_rng(3)
n1, n2 = 264, 1745                      # Black / White counts in our top SES quartile
p1, p2 = 0.0303, 0.0367                 # observed rates there
true_lor = np.log(p1/(1-p1)) - np.log(p2/(1-p2))
X = np.column_stack([np.ones(n1+n2), np.r_[np.ones(n1), np.zeros(n2)]])
f, m, nz = [], [], 0
for _ in range(3000):
    k1, k2 = rng.binomial(n1, p1), rng.binomial(n2, p2)
    y = np.r_[np.ones(k1), np.zeros(n1-k1), np.ones(k2), np.zeros(n2-k2)]
    b, _ = firth_logit(X, y); f.append(b[1])
    if k1 > 0 and k2 > 0:
        m.append(np.log((k1/(n1-k1))/(k2/(n2-k2)))); nz += 1
    else:
        m.append(np.nan)
f, m = np.array(f), np.array(m)
print("true logOR = %.3f (OR=%.3f); usable (no zero cell) trials %d/3000" % (true_lor, np.exp(true_lor), nz))
print("MLE  (sample) logOR: mean %.3f  bias %+.3f  rmse %.3f" % (np.nanmean(m), np.nanmean(m)-true_lor, np.sqrt(np.nanmean((m-true_lor)**2))))
print("Firth           OR : mean %.3f  bias %+.3f  rmse %.3f  (Firth defined in every trial)" %
      (np.mean(np.exp(f)), np.mean(f)-true_lor, np.sqrt(np.mean((f-true_lor)**2))))
print("Firth defined in all trials incl. zero cells -> bias vs MLE-on-usable-trials is conservative here")
