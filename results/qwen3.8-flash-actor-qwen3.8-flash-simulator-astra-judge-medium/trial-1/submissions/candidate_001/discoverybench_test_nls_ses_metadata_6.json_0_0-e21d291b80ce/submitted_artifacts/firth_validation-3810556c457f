"""Validate the Firth (Jeffreys-penalized) logistic implementation:
   objective  l*(b) = sum[y*eta - log(1+exp(eta))] + 0.5*log|X'WX|,  W = diag(mu(1-mu))
   analytic gradient = X'(y-mu) + 0.5 * X'[ h * w * (1-2mu) ],  h = diag of hat matrix."""
import numpy as np, sys
sys.path.insert(0, "analysis")
from stats_lib import irls_logit
from scipy import optimize

def obj(beta, X, y):
    eta = np.clip(X@beta, -30, 30); mu = 1/(1+np.exp(-eta)); w = mu*(1-mu)
    I = X.T@(X*w[:, None]) + 1e-9*np.eye(X.shape[1])
    sgn, logdet = np.linalg.slogdet(I)
    h = np.einsum('ij,ij->i', X@np.linalg.inv(I), X)
    ll = np.sum(y*eta - np.logaddexp(0, eta)) + (0.5*logdet if sgn > 0 else 0.0)
    g = X.T@(y - mu) + X.T@(0.5*h*w*(1 - 2*mu))
    return -ll, -g.ravel()

def firth(X, y):
    b0 = np.zeros(X.shape[1])
    p = max(min(y.mean(), 1-1e-6), 1e-6); b0[0] = np.log(p/(1-p))
    r = optimize.minimize(obj, b0, args=(X, y), jac=True, method="L-BFGS-B")
    return r.x, r

def numgrad(beta, X, y, eps=1e-6):
    g = np.zeros(len(beta))
    for j in range(len(beta)):
        bp = beta.copy(); bm = beta.copy(); bp[j] += eps; bm[j] -= eps
        g[j] = (-obj(bp, X, y)[0] + obj(bm, X, y)[0])/(2*eps)
    return g

if __name__ == "__main__":
    rng = np.random.default_rng(5); n = 3000
    X = np.column_stack([np.ones(n), rng.normal(size=(n, 3))])
    for tag, lin in [("A ordinary", -4 + .8*X[:,1] + .3*X[:,2] - .2*X[:,3]),
                     ("B sparse",   -6 + 1.4*X[:,1] + .8*X[:,2] - .6*X[:,3]),
                     ("C x-separated", -6 + 2.5*np.abs(X[:,1])*np.sign(X[:,1]) + .2*X[:,2]),
                     ("D group+sep", -5.5 + 2.2*X[:,1] + 1.5*X[:,2])]:
        y = (rng.random(n) < 1/(1+np.exp(-lin))).astype(float)
        b, r = firth(X, y); m = irls_logit(X, y)
        ga, gn = -obj(b, X, y)[1], numgrad(b, X, y)
        print(f"{tag}: events={int(y.sum()):4d}  max|analytic grad|={np.abs(ga).max():.2e} "
              f"max|analytic-numeric grad|={np.abs(ga-gn).max():.2e}  converged={r.success}")
        print("    MLE  ", np.round(m, 4), "\n    FIRTH", np.round(b, 4))
        # shrinkage sanity: |Firth| <= |MLE| elementwise for the separated cases
        print("    shrink (Firth-MLE):", np.round(b-m, 4))
