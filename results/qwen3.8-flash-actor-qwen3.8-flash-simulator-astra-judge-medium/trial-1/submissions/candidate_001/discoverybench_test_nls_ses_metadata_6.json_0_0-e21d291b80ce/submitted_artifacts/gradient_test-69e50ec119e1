"""Is the SES-completion gradient really steeper for Black students? Two independent within-race
logit slopes (Black vs White samples are disjoint -> difference of slopes is a clean test),
plus the same test on the linear scale and the adjusted within-race SES slope."""
import sys, os, contextlib, numpy as np, pandas as pd
sys.path.insert(0, "analysis")
from stats_lib import irls_logit, predict, firth_logit
from scipy import stats
with open(os.devnull, "w") as f, contextlib.redirect_stdout(f):
    import run_analysis as ra
d, SD_SES = ra.d, ra.SD_SES

def slope(dd, adjust=False):
    cols = [np.ones(len(dd)), (dd.ses.to_numpy()-d.ses.mean())/SD_SES]
    if adjust: cols += [dd[c].to_numpy(float) for c in ra.COVS]
    X = np.column_stack(cols); y = dd.ba.to_numpy(float)
    b = irls_logit(X, y, ridge=1e-3)
    mu = predict(b, X); W = mu*(1-mu)
    V = np.linalg.inv(X.T @ (X*W[:, None]) + 1e-6*np.eye(X.shape[1]))
    return b[1], np.sqrt(V[1, 1])

print("== A. UNADJUSTED within-race logit slope of completion per 1 SD of SES ==")
sb = slope(d[d.black == 1]); sw = slope(d[d.white == 1]); sh = slope(d[d.hisp == 1])
for nm, s in [("Black", sb), ("White", sw), ("Hispanic", sh)]:
    print("  %-9s OR/SD = %.2f (95%% CI %.2f-%.2f)" % (nm, np.exp(s[0]), np.exp(s[0]-1.96*s[1]), np.exp(s[0]+1.96*s[1])))
diff = sb[0]-sw[0]; se = np.hypot(sb[1], sw[1])
print("  Black - White slope difference = %.3f (SE %.3f), z = %.2f, p = %.4f  [disjoint samples]"
      % (diff, se, diff/se, 2*(1-stats.norm.cdf(abs(diff/se)))))
print("  ratio of ORs per SD = %.2f" % np.exp(diff))
print("\n== B. SAME TEST, ADJUSTED for ASVAB, class percentile, sex, family size ==")
ab = slope(d[d.black == 1], adjust=True); aw = slope(d[d.white == 1], adjust=True)
diff_a = ab[0]-aw[0]; se_a = np.hypot(ab[1], aw[1])
print("  Black OR/SD %.2f (SE %.3f) | White OR/SD %.2f (SE %.3f) | difference %.3f (SE %.3f), z=%.2f, p=%.3f"
      % (np.exp(ab[0]), ab[1], np.exp(aw[0]), aw[1], diff_a, se_a, diff_a/se_a, 2*(1-stats.norm.cdf(abs(diff_a/se_a)))))
print("\n== C. LINEAR-SCALE gradient: completion rate by SES quartile (unadjusted, %)")
q = d.q.to_numpy()
t = pd.DataFrame({nm: [100*d.ba[(q == i) & (d[col] == 1)].mean() for i in range(4)]
                  for col, nm in [("black", "Black"), ("white", "White"), ("hisp", "Hispanic")]},
                 index=[f"Q{i+1}" for i in range(4)])
t.insert(0, "SES band", [f"[{lo:.2f}, {hi:.2f}]" for lo, hi in zip(ra.Q_EDGES[:-1], ra.Q_EDGES[1:])])
t["n_black"] = [int(((q == i) & (d.black == 1)).sum()) for i in range(4)]
t["ev_black"] = [int(d.ba[(q == i) & (d.black == 1)].sum()) for i in range(4)]
t["n_white"] = [int(((q == i) & (d.white == 1)).sum()) for i in range(4)]
t["ev_white"] = [int(d.ba[(q == i) & (d.white == 1)].sum()) for i in range(4)]
RC = ["Black", "White", "Hispanic"]
t.loc["Q4-Q1_pp"] = np.nan; t.loc["Q4/Q1_x"] = np.nan
t.loc["Q4-Q1_pp", RC] = t.loc["Q4", RC]-t.loc["Q1", RC]
t.loc["Q4/Q1_x", RC] = t.loc["Q4", RC]/t.loc["Q1", RC]
t.to_csv("analysis/results_rate_by_quartile.csv")
print("\n== C. completion rate by SES quartile (unadjusted, %) ==")
print(t.round(2).to_string())
print("\ncovariate profile by race (SD units; family size in persons):")
for col, nm in [("black", "Black"), ("white", "White"), ("hisp", "Hispanic")]:
    sub = d[d[col] == 1]
    raw = ra.df[ra.df[ra.RACE] == nm]
    print("  %-9s mean SES %+.3f | ASVAB %+.3f | class pct %+.3f | family size %.2f persons (raw) | completion %.2f%%"
          % (nm, sub.ses.mean(), sub.asvab_z.mean(), sub.pct_z.mean(),
             raw[ra.FAM].mean(), 100*sub.ba.mean()))
print("Black share within each SES quartile:", [round(100*(d.black[q == i].mean()), 1) for i in range(4)])
