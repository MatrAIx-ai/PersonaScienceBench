"""Independent verification of the headline estimates with statsmodels (different implementation)."""
import sys, os, contextlib, numpy as np, pandas as pd
sys.path.insert(0, "analysis")
import statsmodels.api as sm
with open(os.devnull, "w") as f, contextlib.redirect_stdout(f):
    import run_analysis as ra
from stats_lib import wilson, newcombe_rd_ci, rr_and_ci
d, Q = ra.d, ra.Q_EDGES
UP = f"Upper half (SES >= median {Q[2]:.2f})"; TQ = f"Top quartile (SES >= {Q[3]:.2f})"

# 1. unadjusted rates + intervals recomputed from raw csv
raw = pd.read_csv("data/nls_ses_processed.csv")
raw["ba"] = raw["BA DEGREE COMPLETED"].astype(int)
q = np.clip(np.searchsorted(Q[1:-1], raw["SES"].to_numpy(), side="right"), 0, 3)
for i in range(4):
    for rc in ["Black", "White"]:
        m = (q == i) & (raw["SAMPLE_RACE"] == rc).to_numpy()
        k, n = int(raw.ba[m].sum()), int(m.sum())
        print("Q%d %-6s %3d/%-4d = %.3f%%  Wilson [%.2f, %.2f]" % (i+1, rc, k, n, 100*k/n, *[100*x for x in wilson(k, n)]))
kb = int(raw.ba[(q == 3) & (raw.SAMPLE_RACE == "Black")].sum()); nb = int(((q == 3) & (raw.SAMPLE_RACE == "Black")).sum())
kw = int(raw.ba[(q == 3) & (raw.SAMPLE_RACE == "White")].sum()); nw = int(((q == 3) & (raw.SAMPLE_RACE == "White")).sum())
_rd = np.round(100*np.array(newcombe_rd_ci(kb, nb, kw, nw)), 3); _rr = np.round(np.array(rr_and_ci(kb, nb, kw, nw)), 3)
print("top-quartile RD %+0.3f pp CI %s | RR %.3f CI %.3f-%.3f" % (100*(kb/nb-kw/nw), _rd, _rr[0], _rr[1], _rr[2]))

# 2. main adjusted model with statsmodels
def sm_design(dd, covs):
    qq = dd.q.to_numpy(); b = dd.black.to_numpy(float)
    cols = {**{f"Q{i+1}": (qq == i).astype(float) for i in (1, 2, 3)}, "Black": b, "Hispanic": dd.hisp.to_numpy(float),
            **{f"Black:Q{i+1}": b*(qq == i) for i in (1, 2, 3)}, **{c: dd[c].to_numpy(float) for c in covs}}
    return pd.DataFrame(cols)
X = sm_design(d, ra.COVS); res = sm.GLM(d.ba.to_numpy(float), sm.add_constant(X), family=sm.families.Binomial()).fit()
b_mine, nm_ = ra.fit(d)
print("\nstatsmodels vs mine, max abs coef diff = %.2e (const %+.4f vs %+.4f)"
      % (np.abs(res.params.to_numpy()[1:]-b_mine[1:]).max(), res.params["const"], b_mine[0]))
print("Black OR by SES quartile (statsmodels):", {f"Q{i+1}": round(float(np.exp(res.params["Black"]+res.params.get(f"Black:Q{i+1}", 0.0))), 3) for i in range(4)})
print("Black:Q4 coef %.4f (se %.4f, p %.3f)" % (res.params["Black:Q4"], res.bse["Black:Q4"], res.pvalues["Black:Q4"]))
print("Black:Q3 coef %.4f (se %.4f) | Black:Q2 %.4f (se %.4f) | Black(Q1) %.4f (se %.4f)"
      % (res.params["Black:Q3"], res.bse["Black:Q3"], res.params["Black:Q2"], res.bse["Black:Q2"], res.params["Black"], res.bse["Black"]))

# 3. direct top-quartile / upper-half adjusted OR with statsmodels
for lab in [UP, TQ]:
    sub = d[ra.masks[lab]].reset_index(drop=True)
    Xs = pd.DataFrame({"Black": sub.black.to_numpy(float), "Hispanic": sub.hisp.to_numpy(float),
                       **{c: sub[c].to_numpy(float) for c in ra.COVS}})
    r2 = sm.GLM(sub.ba.to_numpy(float), sm.add_constant(Xs), family=sm.families.Binomial()).fit()
    ci = r2.conf_int().loc["Black"]
    print("%-34s direct adjusted OR %.3f (95%% CI %.3f-%.3f), p %.3f"
          % (lab, np.exp(r2.params["Black"]), np.exp(ci[0]), np.exp(ci[1]), r2.pvalues["Black"]))

# 4. g-computation cross-check for the pooled upper half using the statsmodels fit
X = sm.add_constant(X, has_constant="add")
Xp = X.copy()
Xp["Black"] = 1.0
for i in (1, 2, 3): Xp[f"Black:Q{i+1}"] = (d.q.to_numpy() == i)*1.0
Xp["Hispanic"] = 0.0
pb = 100*res.predict(Xp)[np.asarray(ra.masks[UP])].mean()
Xw = X.copy(); Xw["Black"] = 0.0
for i in (1, 2, 3): Xw[f"Black:Q{i+1}"] = 0.0
Xw["Hispanic"] = 0.0
pw = 100*res.predict(Xw)[np.asarray(ra.masks[UP])].mean()
print("statsmodels g-computation upper-half: Black %.3f%% vs White %.3f%% -> RD %+0.3f pp, RR %.3f"
      % (pb, pw, pb-pw, pb/pw))
