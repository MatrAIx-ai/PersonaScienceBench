"""
Inspection-only script (no final analysis) for nls_ses_processed.csv.
Produces: structure, coding of SAMPLE_RACE / SES / BA DEGREE COMPLETED,
missingness, and race x SES-stratum cross-tabs (counts, events, rates).
Run:  python analysis/inspect_nls_ses.py   > analysis/inspection_report.txt
"""
import pandas as pd, numpy as np

pd.set_option("display.width", 240); pd.set_option("display.max_columns", 60)
df = pd.read_csv("data/nls_ses_processed.csv")
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
RACE, SES, BA, ASVAB, PCT, FAM = ("SAMPLE_RACE", "SES", "BA DEGREE COMPLETED",
    "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS", "FAMILY SIZE OF SAMPLE")

print("== 1. STRUCTURE ==")
print("shape:", df.shape)
print("columns (exact):", [repr(c) for c in df.columns])
print("\ndtypes:\n", df.dtypes.to_string())
print("\nmissing per column:\n", df.isna().sum().to_string())
print("\nduplicated CASE ID:", df["CASE ID"].duplicated().sum())

print("\n== 2. CODING ==")
for c in [RACE, "SAMPLE_SEX", BA]:
    print(f"\n{c}: nunique={df[c].nunique()}\n", df[c].value_counts(dropna=False).to_string())
print("\nnumeric min/max/quantiles:")
print(df[[SES, ASVAB, PCT, FAM]].describe(percentiles=[.05,.25,.5,.75,.95]).T.round(4).to_string())
print("\nSES direction check (Pearson r with SES):")
print(df[[SES, ASVAB, PCT, FAM, "ba"]].corr()[SES].drop(SES).round(3).to_string())
print("\ncompletion by race:")
print(df.groupby(RACE).ba.agg(n="size", events="sum", rate="mean").round(4).to_string())

print("\n== 3. CROSS-TABS race x SES strata ==")
for name, strat, k in [("quintiles", pd.qcut, 5), ("quartiles", pd.qcut, 4), ("tertiles", pd.qcut, 3)]:
    s = strat(df[SES], k)
    edges = df[SES].quantile(np.linspace(0, 1, k + 1)).round(3).tolist()
    print(f"\n--- {name} (edges {edges}) ---")
    print("cell counts:\n", pd.crosstab(s, df[RACE], margins=True).to_string())
    print("BA events:\n", pd.crosstab(s, df[RACE], values=df.ba, aggfunc="sum").fillna(0).astype(int).to_string())
    r = 100 * df.pivot_table(index=s, columns=RACE, values="ba", aggfunc="mean")
    print("rate %:\n", r.round(2).to_string())
    print("Black-White (pp):\n", (r["Black"] - r["White"]).round(2).to_string())
    print("Black/White risk ratio:\n", (r["Black"] / r["White"]).round(2).to_string())

print("\n== 4. COMMON SUPPORT ==")
for g in ["Black", "White", "Hispanic"]:
    s = df.loc[df[RACE] == g, SES]
    print(g, "SES quantiles", s.quantile([0, .25, .5, .75, .9, 1]).round(2).tolist(),
          "| n>0.5:", int((s > 0.5).sum()), "| n>1.0:", int((s > 1.0).sum()))
