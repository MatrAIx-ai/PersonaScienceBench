# ---------- 6. Mantel-Haenszel: functional-form-free adjustment ----------
def mh_or(k_b, n_b, k_w, n_w):
    """Mantel-Haenszel OR per 2x2 stratum. Subscripts b=Black, w=White.
       A=events Black, B=non-events Black, C=events White, D=non-events White."""
    A = np.asarray(k_b, float); B = np.asarray(n_b, float) - A
    C = np.asarray(k_w, float); D = np.asarray(n_w, float) - C
    N = A+B+C+D
    R = np.nan_to_num(A*D/N); S = np.nan_to_num(B*C/N)
    use = (N > 0) & np.isfinite(R) & np.isfinite(S) & ((A+B) > 0) & ((C+D) > 0)
    or_mh = R[use].sum()/S[use].sum()
    P = (A+D)/N; Q = (B+C)/N
    var = (P*R).sum()/(2*R.sum()**2) + ((P*S).sum()+(Q*R).sum())/(2*R.sum()*S.sum()) + (Q*S).sum()/(2*S.sum()**2)
    se = np.sqrt(var)
    Ea = ((A+B)*(A+C)/N)[use]
    var_a = ((A+B)*(C+D)*(A+C)*(B+D)/(N**2*(N-1)))[use]
    chi = (abs(A[use].sum()-Ea.sum())-0.5)**2 / var_a.sum()
    return or_mh, np.exp(np.log(or_mh)-1.96*se), np.exp(np.log(or_mh)+1.96*se), 1-stats.chi2.cdf(chi, 1), int(use.sum())

def strat(strat_col, sel, ncat):
    m = np.asarray(sel); sub = d[m]
    g = pd.qcut(sub[strat_col], ncat, labels=False, duplicates="drop").to_numpy()
    k1 = np.array([sub.ba[(g == i) & (sub.black == 1)].sum() for i in np.unique(g)], float)
    n1 = np.array([(g == i) & (sub.black == 1).to_numpy() for i in np.unique(g)]).sum(1).astype(float)
    k0 = np.array([sub.ba[(g == i) & (sub.white == 1)].sum() for i in np.unique(g)], float)
    n0 = np.array([(g == i) & (sub.white == 1).to_numpy() for i in np.unique(g)]).sum(1).astype(float)
    return mh_or(k1, n1, k0, n0)

print("\n" + "=" * 112)
print("6. MANTEL-HAENSZEL adjusted Black-vs-White OR (no logistic form assumed; strata = quantiles of the adjusting variable)")
