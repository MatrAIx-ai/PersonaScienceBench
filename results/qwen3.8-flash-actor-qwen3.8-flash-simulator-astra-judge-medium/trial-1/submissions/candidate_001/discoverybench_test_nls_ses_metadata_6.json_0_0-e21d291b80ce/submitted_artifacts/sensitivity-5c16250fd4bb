# ---------- 7. relaxed slope assumption ----------
print("\n" + "=" * 112)
print("7. RELAXING EQUAL COVARIATE SLOPES: add Black x ASVAB (and Black x family size) to the main model")
def gcomp_extra(extra_terms, mask_key):
    q = d.q.to_numpy(); b = d.black.to_numpy(float)
    cols = [np.ones(len(d))] + [(q == i).astype(float) for i in (1, 2, 3)] + [b, d.hisp.to_numpy(float)] + \
           [(b*(q == i)).astype(float) for i in (1, 2, 3)] + [d[c].to_numpy(float) for c in ra.COVS] + \
           [b*d[t].to_numpy(float) for t in extra_terms]
    nm = ["const", "Q2", "Q3", "Q4", "Black", "Hispanic", "Black:Q2", "Black:Q3", "Black:Q4"] + list(ra.COVS) + \
         ["Black:"+t for t in extra_terms]
    X = np.column_stack(cols); bb = irls_logit(X, d.ba.to_numpy(float), ridge=1e-3)
    out = {}
    for lab in mask_key:
        sub = d[masks[lab]]
        def pr(bv):
            Xs = X[masks[lab]].copy()
            Xs[:, nm.index("Black")] = bv
            for i in (1, 2, 3): Xs[:, nm.index(f"Black:Q{i+1}")] = (sub.q.to_numpy() == i)*bv
            if "Hispanic" in nm: Xs[:, nm.index("Hispanic")] = 0.0
            for t in extra_terms: Xs[:, nm.index("Black:"+t)] = bv*sub[t].to_numpy(float)
            return 100*predict(bb, Xs).mean()
        out[lab] = (pr(1), pr(0), pr(1)-pr(0), pr(1)/pr(0))
    return out
for ex in [[], ["asvab_z"], ["asvab_z", "fam_z"], ["asvab_z", "pct_z", "female", "fam_z"]]:
    o = gcomp_extra(ex, [UP, TQ, BH])
    print("  + Black x %-32s upper-half %+0.2f pp (RR %.2f) | top-quartile %+0.2f pp (RR %.2f) | bottom-half %+0.2f pp (RR %.2f)"
          % (", ".join(ex) if ex else "(nothing)", o[UP][2], o[UP][3], o[TQ][2], o[TQ][3], o[BH][2], o[BH][3]))
