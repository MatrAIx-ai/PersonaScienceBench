# ---------- 1. curve ----------
def curve_design(ses_val, dd, black_val):
    z = (ses_val - d.ses.mean())/SD_SES; n = len(dd)
    X = np.column_stack([np.ones(n), np.full(n, z), np.full(n, black_val), np.full(n, z*black_val),
                         np.zeros(n)] + [dd[c].to_numpy(float) for c in ra.COVS])
    return X
def cfit(dd):
    bz = (dd.ses.to_numpy()-d.ses.mean())/SD_SES
    X = np.column_stack([np.ones(len(dd)), bz, dd.black.to_numpy(float), bz*dd.black.to_numpy(float),
                         dd.hisp.to_numpy(float)] + [dd[c].to_numpy(float) for c in ra.COVS])
    return irls_logit(X, dd.ba.to_numpy(float))
beta_c = cfit(d); grid = np.round(np.arange(-2.0, 2.01, 0.25), 2)
keys = (d.black.to_numpy()*2 + d.white.to_numpy())*4 + d.q.to_numpy()
cells = [np.flatnonzero(keys == k) for k in np.unique(keys)]
arr = {c: d[c].to_numpy() for c in ["ba", "black", "hisp", "white", "ses", "asvab_z", "pct_z", "female", "fam_z", "q"]}
boot = []
for _ in range(500):
    idx = np.concatenate([RNG.choice(c, c.size, True) for c in cells])
    bs = pd.DataFrame({k: v[idx] for k, v in arr.items()}); b_ = cfit(bs)
    boot.append([[100*predict(b_, curve_design(g, bs, 1)).mean(),
                  100*predict(b_, curve_design(g, bs, 0)).mean()] for g in grid])
boot = np.array(boot)
rows = []
for j, g in enumerate(grid):
    pb = 100*predict(beta_c, curve_design(g, d, 1)).mean(); pw = 100*predict(beta_c, curve_design(g, d, 0)).mean()
    rd_b = boot[:, j, 0] - boot[:, j, 1]
    rows.append(dict(SES=g, SES_z=(g-d.ses.mean())/SD_SES, pct_of_sample_at_or_below=100*(d.ses <= g).mean(),
                     adj_rate_Black=pb, adj_rate_White=pw, adj_RD_pp=pb-pw,
                     RD_boot_lo=np.percentile(rd_b, 2.5), RD_boot_hi=np.percentile(rd_b, 97.5),
                     adj_RR=pb/pw, boot_p_RD_le0=float((rd_b <= 0).mean())))
