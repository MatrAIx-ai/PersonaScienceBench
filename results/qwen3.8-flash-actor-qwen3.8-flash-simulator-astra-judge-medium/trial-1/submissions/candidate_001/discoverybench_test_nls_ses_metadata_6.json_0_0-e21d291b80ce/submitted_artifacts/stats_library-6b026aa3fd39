"""Small stats helpers: Wilson CI, Newcombe RD CI, Katz RR CI, IRLS logistic (MLE + Firth)."""
import numpy as np
from scipy import stats

# ---------- intervals ----------
def wilson(k, n, alpha=0.05):
    if n == 0: return (np.nan, np.nan)
    z = stats.norm.ppf(1 - alpha/2)
    p = k/n
    d = 1 + z*z/n
    c = (p + z*z/(2*n))/d
    h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n))/d
    return (max(0.0, c-h), min(1.0, c+h))

def newcombe_rd_ci(k1, n1, k2, n2, alpha=0.05):
    """Newcombe method 10 (hybrid score) CI for p1 - p2."""
    if n1 == 0 or n2 == 0: return (np.nan, np.nan)
    l1, u1 = wilson(k1, n1, alpha); l2, u2 = wilson(k2, n2, alpha)
    d = k1/n1 - k2/n2
    lo = d - np.sqrt((k1/n1 - l1)**2 + (u2 - k2/n2)**2)
    hi = d + np.sqrt((u1 - k1/n1)**2 + (k2/n2 - l2)**2)
    return (lo, hi)

def katz_rr_ci(k1, n1, k2, n2, alpha=0.05):
    """Katz log-method CI for RR = p1/p2 (0.5 continuity correction if a zero cell)."""
    if n1 == 0 or n2 == 0: return (np.nan, np.nan)
    a, b = k1, k2
    cc = 0.0
    if a == 0 or b == 0:
        a, b, cc = a + 0.5, b + 0.5, 0.5
        n1c, n2c = n1 + cc, n2 + cc
    else:
        n1c, n2c = n1, n2
    rr = (a/n1c)/(b/n2c)
    se = np.sqrt(1/a - 1/n1c + 1/b - 1/n2c)
    z = stats.norm.ppf(1 - alpha/2)
    return (rr*np.exp(-z*se), rr*np.exp(z*se)), rr

def rr_and_ci(k1, n1, k2, n2, alpha=0.05):
    lohi, rr = katz_rr_ci(k1, n1, k2, n2, alpha)
    return rr, lohi[0], lohi[1]

def fisher_p(k1, n1, k2, n2):
    tab = [[k1, n1-k1], [k2, n2-k2]]
    return stats.fisher_exact(tab)[1]

# ---------- logistic ----------
def design(df, terms):
    """terms: list of (name, callable(row)->value) -> returns (X matrix, names)."""
    cols, names = [], []
    for nm, f in terms:
        cols.append(np.asarray(f(df), dtype=float)); names.append(nm)
    return np.column_stack([np.ones(len(df))] + cols), ["const"] + names

def irls_logit(X, y, ridge=0.0, maxit=200, tol=1e-11, firth=False):
    n, p = X.shape
    beta = np.zeros(p)
    for it in range(maxit):
        eta = X @ beta
        eta = np.clip(eta, -30, 30)
        mu = 1/(1+np.exp(-eta))
        w = np.maximum(mu*(1-mu), 1e-10)
        if firth:                             # not used: use firth_logit() (see below)
            raise NotImplementedError("use firth_logit(X, y)")
        z = eta + (y - mu)/w                          # standard IRLS working response (no clipping)
        W = w.copy()
        XtWX = X.T @ (X * W[:, None]) + ridge*np.eye(p)
        Xty = X.T @ (W * z)
        try:
            new = np.linalg.solve(XtWX, Xty)
        except np.linalg.LinAlgError:
            ridge *= 10
            continue
        if not np.all(np.isfinite(new)):
            ridge *= 10; continue
        step = 1.0
        for _ in range(30):                          # step halving on penalized loglik
            b_try = beta + step*(new - beta)
            if _loglik(X, y, b_try, firth) >= _loglik(X, y, beta, firth) - 1e-8:
                break
            step /= 2
        diff = np.max(np.abs(b_try - beta))
        beta = b_try
        if diff < tol:
            break
    return beta

def _loglik(X, y, beta, firth):
    eta = np.clip(X @ beta, -30, 30)
    ll = np.sum(y*eta - np.log1p(np.exp(eta)))
    if firth:
        mu = 1/(1+np.exp(-eta)); w = np.maximum(mu*(1-mu), 1e-10)
        sign, logdet = np.linalg.slogdet(X.T @ (X*w[:, None]) + 1e-6*np.eye(X.shape[1]))
        ll += 0.5*logdet if sign > 0 else 0.0
    return ll

def predict(beta, X):
    return 1/(1+np.exp(-np.clip(X @ beta, -30, 30)))


def _firth_obj(beta, X, y):
    """Penalized (Firth / Jeffreys-prior) logistic log-likelihood and its gradient.
       l*(b) = sum[y*eta - log(1+exp(eta))] + 0.5*log|X'WX|,  W = diag(mu(1-mu))
       grad   = X'(y-mu) + 0.5 * X'[ h * w * (1-2mu) ],  h = diag(hat matrix).  (gradient verified
       numerically in analysis/firth_validate.py.)"""
    eta = np.clip(X @ beta, -30, 30); mu = 1/(1+np.exp(-eta)); w = mu*(1-mu)
    I = X.T @ (X*w[:, None]) + 1e-9*np.eye(X.shape[1])
    sgn, logdet = np.linalg.slogdet(I)
    h = np.einsum('ij,ij->i', X @ np.linalg.inv(I), X)
    ll = np.sum(y*eta - np.logaddexp(0, eta)) + (0.5*logdet if sgn > 0 else 0.0)
    g = X.T @ (y-mu) + X.T @ (0.5*h*w*(1-2*mu))
    return -ll, -g.ravel()

def firth_logit(X, y):
    from scipy import optimize
    b0 = np.zeros(X.shape[1]); p_ = min(max(float(np.mean(y)), 1e-6), 1-1e-6)
    b0[0] = np.log(p_/(1-p_))
    r = optimize.minimize(_firth_obj, b0, args=(X, np.asarray(y, float)), jac=True, method="L-BFGS-B")
    return r.x, r

def firth_info(X, beta):
    """Model-based covariance from the penalized fit (approximate; bootstrap preferred)."""
    eta = np.clip(X @ beta, -30, 30); mu = 1/(1+np.exp(-eta)); w = mu*(1-mu)
    return np.linalg.inv(X.T @ (X*w[:, None]) + 1e-9*np.eye(X.shape[1]))
