"""Consolidate the headline table (unadjusted vs adjusted, side by side) into one markdown/CSV."""
import pandas as pd, numpy as np
s = pd.read_csv("analysis/results_strata.csv")
cols = ["region", "n_black", "ev_black", "rate_black", "n_white", "ev_white", "rate_white",
        "RD_pp", "RD_lo", "RD_hi", "RR", "RR_lo", "RR_hi", "fisher_p",
        "adj_rate_black", "adj_rate_white", "adj_RD_pp", "adj_RR", "adj_RD_lo", "adj_RD_hi",
        "adj_RR_lo", "adj_RR_hi", "boot_p_RD_le0", "rate_hisp"]
out = s[cols].copy()
out.to_csv("analysis/headline_table.csv", index=False)
def fmt(r):
    return ("| %-36s | %4d/%-3d %5.2f%% | %5d/%-4d %5.2f%% | %+5.2f (%+.2f,%+.2f) | %4.2f (%.2f-%.2f) | %5.2f | %5.2f | %5.2f | %+5.2f | %4.2f | %.3f | %.2f%% |"
            % (r.region[:36], r.ev_black, r.n_black, r.rate_black, r.ev_white, r.n_white, r.rate_white,
               r.RD_pp, r.RD_lo, r.RD_hi, r.RR, r.RR_lo, r.RR_hi, r.fisher_p,
               r.adj_rate_black, r.adj_rate_white, r.adj_RD_pp, r.adj_RR, r.boot_p_RD_le0, r.rate_hisp))
hdr = ("| SES region | Black n/ev, rate | White n/ev, rate | unadj RD pp (CI) | unadj RR (CI) | Fisch p "
       "| adj Black | adj White | adj RD pp | adj RR | boot p(RD<=0) | Hispanic rate |")
sep = "|" + "---|"*12
print(hdr); print(sep)
for _, r in out.iterrows(): print(fmt(r))
print("\nBlack adjusted OR by SES quartile (from main model):",
      {f"Q{i+1}": round(float(np.exp([-0.0148, 0.5073, 0.5802, 0.7718][i])), 3) for i in range(4)})
