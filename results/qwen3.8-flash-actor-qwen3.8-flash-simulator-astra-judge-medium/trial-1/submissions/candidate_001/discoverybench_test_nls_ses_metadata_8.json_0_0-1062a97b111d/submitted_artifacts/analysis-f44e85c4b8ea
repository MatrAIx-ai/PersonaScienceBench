"""
FINAL CONSOLIDATED ANALYSIS
Question: "Between which two races is the factor of BA degree completion -0.9568
when compared to the other?"   (DiscoveryBench nls_ses, metadata_8)

Pipeline: clean -> plain-vanilla cases -> targeted specification grid (14 families,
~6.1k statistics) -> attainability / coincidence diagnostics -> identified pair.
Run:  python3 work/nls_ses_final.py
"""
import itertools, warnings; sys_hack=None
import numpy as np, pandas as pd
import statsmodels.api as sm, statsmodels.genmod.families as fam
warnings.filterwarnings("ignore")
pd.set_option("display.width",240); pd.set_option("display.max_columns",40)

TARGET, TOL_EXACT, TOL_NEAR = -0.9568, 5e-5, 1e-3
RACES=["Black","Hispanic","White"]; COVS=["SES","ABILITY","PERCENTILE","FAMSIZE","SEX"]

# ---------------------------------------------------------------- 1. CLEAN
df=pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
df["SAMPLE_RACE"]=df["SAMPLE_RACE"].str.strip()
df["BA"]=df["BA DEGREE COMPLETED"].astype(int)
df=df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE":"ABILITY",
                      "PERCENTILE IN CLASS":"PERCENTILE","FAMILY SIZE OF SAMPLE":"FAMSIZE"})
df["SEX"]=(df["SAMPLE_SEX"].str.strip().str.lower()=="male").astype(int)
print(f"[clean] N={len(df)}  unique CASE ID={df['CASE ID'].nunique()}  "
      f"missing={int(df.isna().sum().sum())}  BA rate={df.BA.mean():.6f}")
print("[clean] race x BA:\n"+df.groupby("SAMPLE_RACE").BA.agg(["size","sum","mean"]).to_string())

# ---------------------------------------------------------------- 2. MODELS
ROWS=[]
def add(pair,who,spec,est,k,b,ci=""):
    if b is None or not np.isfinite(b): return
    ROWS.append(dict(pair=pair,direction=who,spec=spec,estimator=est,n_cov=k,beta=float(b),
                     exp_beta=float(np.exp(b)),delta=float(b-TARGET),
                     abs_delta=abs(float(b)-TARGET),ci=ci))
def design(d,covs,ref):
    cat=pd.Categorical(d.SAMPLE_RACE,categories=[ref]+[r for r in RACES if r!=ref])
    Z=pd.get_dummies(cat,drop_first=True,dtype=float); Z.columns=[str(c) for c in Z.columns]
    for c in covs: Z[c]=d[c].astype(float)
    Z.insert(0,"Intercept",1.0); return Z,d.BA.values.astype(float)
def logit(d,covs,ref):
    Z,y=design(d,covs,ref); r=sm.GLM(y,Z,family=fam.Binomial()).fit(maxiter=500)
    return pd.Series(r.params,index=Z.columns),pd.Series(r.bse,index=Z.columns)
def record(d,covs,ref,spec,est="Logit"):
    p,se=logit(d,covs,ref); ts=[t for t in p.index if t in RACES]
    for t in ts:
        ci=f"({p[t]-1.96*se[t]:+.4f},{p[t]+1.96*se[t]:+.4f})"
        add(f"{t}/{ref}",f"{t} numerator (lower), {ref} reference",spec,est,len(covs),p[t],ci)
    if len(ts)==2:
        add(f"{ts[0]}/{ts[1]}",f"{ts[0]} vs {ts[1]} linear contrast",spec,est,len(covs),
            p[ts[0]]-p[ts[1]])

print("\n[plain-vanilla cases]")
PLAIN=[("(a) unadjusted 2x2 / race-only",[]),("(c) race + SES",["SES"]),
       ("(d) race + all 5 covariates",COVS),("(b) race + SEX",["SEX"]),
       ("race + ABILITY",["ABILITY"]),("race + PERCENTILE",["PERCENTILE"]),
       ("race + FAMSIZE",["FAMSIZE"])]
ct=pd.crosstab(df.SAMPLE_RACE,df.BA)
for a,b in itertools.combinations(RACES,2):
    n11,n10,n01,n00=(int(ct.loc[a,1]),int(ct.loc[a,0]),int(ct.loc[b,1]),int(ct.loc[b,0]))
    lor=np.log(n11*n00/(n01*n10)); se=np.sqrt(1/n11+1/n10+1/n01+1/n00)
    add(f"{a}/{b}",f"{a} numerator, {b} reference","(a) unadjusted 2x2","crude 2x2",0,lor,
        f"({lor-1.96*se:+.4f},{lor+1.96*se:+.4f})")
for spec,covs in PLAIN:
    for ref in RACES: record(df,covs,ref,spec)
for row in sorted([r for r in ROWS if r["spec"].startswith("(")],key=lambda r:r["abs_delta"])[:9]:
    print(f"  {row['pair']:<16} {row['spec']:<32} beta={row['beta']:+.6f} OR={row['exp_beta']:.4f} "
          f"|d|={row['abs_delta']:.6f}")

# ---- targeted grid (14 families) ----
D=df.copy()
for c in ["SES","ABILITY","PERCENTILE"]:
    D[c+"_d"]=(D[c]>D[c].median()).astype(float); D[c+"_q"]=pd.qcut(D[c],4,labels=False).astype(float)
    D["log"+c]=np.log(D[c].clip(lower=.5))
EXTRA=[c for c in D.columns if c not in df.columns]
LINKS={"probit":fam.Probit() if hasattr(fam,'Probit') else None}
import statsmodels.genmod.families.links as LK
def grid(d,covs,ref,spec,est,link=None):
    try:
        Z,y=design(d,covs,ref)
        if link is None: r=sm.GLM(y,Z,family=fam.Binomial()).fit(maxiter=500)
        else: r=sm.GLM(y,Z,family=fam.Binomial(link=link)).fit(maxiter=500)
    except Exception: return
    p=pd.Series(r.params,index=Z.columns); ts=[t for t in p.index if t in RACES]
    for t in ts: add(f"{t}/{ref}",f"{t} vs {ref}",spec,est,len(covs),p[t])
    if len(ts)==2: add(f"{ts[0]}/{ts[1]}",f"{ts[0]} vs {ts[1]} contrast",spec,est,len(covs),
                       p[ts[0]]-p[ts[1]])
base=[r for r in ROWS]
for k in range(len(COVS)+1):
    for covs in itertools.combinations(COVS,k):
        for ref in RACES:
            grid(df,list(covs),ref,"grid:"+(",".join(covs) or "none"),"Logit")
            grid(df,list(covs),ref,"probit:"+(",".join(covs) or "none"),"probit",LK.Probit())
            grid(df,list(covs),ref,"cloglog:"+(",".join(covs) or "none"),"cloglog",LK.CLogLog())
for k in (1,2):
    for covs in itertools.combinations(EXTRA,k):
        for ref in RACES: grid(D,list(covs),ref,"partial:"+",".join(covs),"Logit-coarse")
for ref in RACES:                                        # interactions
    for c in COVS:
        d2=df.copy()
        Z,y=design(d2,[c],ref); Z[f"{c}_xR"]=Z[[t for t in Z.columns if t in RACES][0]]*Z[c]
        try:
            r=sm.GLM(y,Z,family=fam.Binomial()).fit(maxiter=500); p=pd.Series(r.params,index=Z.columns)
            for t in [t for t in p.index if t in RACES]:
                add(f"{t}/{ref}",f"{t} vs {ref} at mean {c} (interaction model)",f"race*{c}",
                    "Logit-int",1,p[t])
        except Exception: pass
for a,b in itertools.combinations(RACES,2):              # subsamples & MH
    for fname,mask in {"all":np.ones(len(df),bool),"FAMSIZE<=4":(df.FAMSIZE<=4).values,
                       "female":(df.SEX==0).values,"male":(df.SEX==1).values,
                       "SES<0":(df.SES<0).values,"PERCENTILE>=50":(df.PERCENTILE>=50).values,
                       "IQR(FAMSIZE)":((df.FAMSIZE>=df.FAMSIZE.quantile(.25)-1.5*(df.FAMSIZE.quantile(.75)-df.FAMSIZE.quantile(.25)))&(df.FAMSIZE<=df.FAMSIZE.quantile(.75)+1.5*(df.FAMSIZE.quantile(.75)-df.FAMSIZE.quantile(.25)))).values}.items():
        s=df[mask&df.SAMPLE_RACE.isin([a,b])]
        if s.BA.sum()<2: continue
        c2=pd.crosstab(s.SAMPLE_RACE,s.BA).reindex(index=[a,b],columns=[0,1]).fillna(0)
        if min(c2.loc[a,1],c2.loc[b,1])<1: continue
        lor=np.log(c2.loc[a,1]*c2.loc[b,0]/(c2.loc[b,1]*c2.loc[a,0]))
        add(f"{a}/{b}",f"{a} vs {b} in {fname} subsample",f"subsample:{fname}","Logit-sub",0,lor)
    for sname in ["SEX","SES","ABILITY","PERCENTILE","FAMSIZE"]:
        st=(df.SEX.astype(str) if sname=="SEX" else
            (df.FAMSIZE.astype(int).clip(upper=6).astype(str) if sname=="FAMSIZE"
             else pd.qcut(df[sname],4,labels=False).astype(str)))
        s=df[df.SAMPLE_RACE.isin([a,b])].assign(S=st[df.SAMPLE_RACE.isin([a,b]).values]); num=den=0.0
        for _,g in s.groupby("S"):
            t=pd.crosstab(g.SAMPLE_RACE,g.BA).reindex(index=[a,b],columns=[0,1]).fillna(0).values
            n=t.sum()
            if n: num+=t[1,1]*t[0,0]/n; den+=t[1,0]*t[0,1]/n
        if den: add(f"{a}/{b}",f"{a} vs {b}, MH stratified by {sname}",f"MH:{sname}","MH",0,np.log(num/den))
for r_ in RACES:                                          # one race vs pooled others
    d=df.assign(Dv=(df.SAMPLE_RACE==r_).astype(float))
    Z=pd.DataFrame({"D":d.Dv}); Z.insert(0,"Intercept",1.0)
    res=sm.GLM(d.BA.values.astype(float),Z,family=fam.Binomial()).fit()
    add(f"{r_}/pooled(others)",f"{r_} vs pooled other races","pooled-other","Logit-pooled",0,
        res.params["D"])

m=pd.DataFrame(ROWS); m.to_csv("work/final_candidates.csv",index=False)
print(f"\n[grid] total candidate statistics: {len(m)}   exact<=5e-5: {int((m.abs_delta<=TOL_EXACT).sum())}"
      f"   <=1e-3: {int((m.abs_delta<=TOL_NEAR).sum())}   <=2e-3: {int((m.abs_delta<=2e-3).sum())}")
print("[grid] best 8 overall:")
print(m.sort_values("abs_delta")[["pair","spec","estimator","beta","delta"]].head(8)
      .to_string(index=False,formatters={"beta":"{:+.6f}".format,"delta":"{:+.6f}".format}))

# ---------------------------------------------------------------- 3. DECISION
print("\n[decision] required shift from the UNADJUSTED value to reach -0.9568")
crude={"Black/White":-1.005703,"Hispanic/White":-0.924136,"Black/Hispanic":-0.081567}
SE={"Black/White":0.204155,"Hispanic/White":0.242660,"Black/Hispanic":0.299323}
for k,c in crude.items():
    print(f"  {k:<15} crude={c:+.6f} -> shift {TARGET-c:+.6f} ({(TARGET-c)/SE[k]:+.2f} SE) : "
          f"{'ATTENUATION (what covariate adjustment does here)' if abs(TARGET)<abs(c) else 'AMPLIFICATION beyond crude (no covariate in this file does this)'}")
print("\n[decision] nested-adjustment span under standard logit (no interactions):")
std=m[m.estimator.isin(["crude 2x2","Logit"])]
for pr in crude:
    b=std[std.pair==pr].beta
    print(f"  {pr:<15} [{b.min():+.4f},{b.max():+.4f}]  contains -0.9568: {bool(b.min()<=TARGET<=b.max())}")
print("\n[headline] Black vs White:")
for spec in ["(a) unadjusted 2x2","(a) unadjusted 2x2 / race-only","(c) race + SES"]:
    q=m[(m.pair=="Black/White")&(m.spec==spec)]
    if len(q):
        r=q.iloc[0]
        print(f"  {spec:<34} logOR={r.beta:+.6f}  OR={r.exp_beta:.4f}  95%CI={r.ci}")
print(f"  TARGET -0.9568  ->  OR = exp(-0.9568) = {np.exp(TARGET):.4f}")
for sp in ["partial:logSES","partial:SES_d","race*SES"]:
    q=m[(m.pair=="Black/White")&(m.spec==sp)]
    if len(q): print(f"  light/partial SES adjustment ({sp:<12}) logOR={q.beta.iloc[0]:+.6f} "
                     f"OR={np.exp(q.beta.iloc[0]):.4f}")
print("\n[headline] Hispanic vs White (competitor):")
for spec in ["(a) unadjusted 2x2","(a) unadjusted 2x2 / race-only","(c) race + SES"]:
    q=m[(m.pair=="Hispanic/White")&(m.spec==spec)]
    if len(q):
        r=q.iloc[0]; print(f"  {spec:<34} logOR={r.beta:+.6f}  OR={r.exp_beta:.4f}  95%CI={r.ci}")
print("\n[headline] Black vs Hispanic (excluded):")
q=m[(m.pair=="Black/Hispanic")&(m.spec=="(a) unadjusted 2x2")]
print(f"  crude logOR={q.beta.iloc[0]:+.6f}; no standard spec gets within 0.70 of -0.9568")

# ------------------------------------------------ 4. COINCIDENCE CALIBRATION
rng=np.random.default_rng(7); b=m.beta.values
draws=rng.uniform(-1.15,-0.55,4000)
best=np.array([np.min(np.abs(b-d)) for d in draws])
obs=m.abs_delta.min()
print(f"\n[calibration] {len(b)} candidate statistics searched.")
print(f"  a RANDOM target in [-1.15,-0.55] reaches |delta|<={obs:.4f} with prob "
      f"{np.mean(best<=obs):.3f}  -> the best hit found is NOT strong evidence for a pair.")
print(f"  P(random target is matched exactly, |delta|<=5e-5) = {np.mean(best<=5e-5):.3f}")
print("  => pair identity must be argued structurally (attainability/adjustment direction),")
print("     not by digit matching.")

# ------------------------------------------------ 5. PARSIMONY-RANKED TABLE
EXOT={"Logit-int","Logit-sub","MH","probit","cloglog","Logit-coarse","Logit-pooled","numeric"}
m["exotic"]=m.estimator.isin(EXOT)
print("\n[parsimony] closest match per pair within increasing model complexity")
f2={"beta":"{:+.6f}".format,"abs_delta":"{:.6f}".format}
for tier,label in [(False,"PLAIN (crude / race-only / covariate-adjusted logit)"),
                   (True ,"all specs incl. interactions, subsamples, links, MH")]:
    q=m[m.exotic==tier] if tier else m[~m.exotic]
    print(f"  -- {label}")
    for pr in ["Black/White","Hispanic/White","Black/Hispanic"]:
        r=q[q.pair==pr]
        if not len(r): continue
        r=r.loc[r.abs_delta.idxmin()]
        print(f"     {pr:<15} beta={r.beta:+.6f} OR={np.exp(r.beta):.4f} |delta|={r.abs_delta:.6f} "
              f"[{r.spec} / {r.estimator}]")
print("\n[answer] identified pair = Black and White; Black is the numerator (lower completion),")
print("         White the reference. logOR -0.9568 -> OR = 0.384 (Black odds ~38% of White).")
print("         crude (this file) = -1.005703 (OR 0.3658); mild-SES-adjusted = -0.941.")
print("         Runner-up Hispanic vs White (-0.924136, OR 0.3969) cannot be excluded.")
