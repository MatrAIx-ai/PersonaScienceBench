#!/usr/bin/env python3
"""
Q8_ML_Addressing_* : proportion of respondents associating each role with
requirements / ML aspects in ML-enabled systems, with respondent-level bootstrap CIs.

Fixed spec (approved by researcher):
  association := Q8_ML_Addressing_<Role> == "quoted"
  sentinels -77/-99/-66/-1  -> missing (dropped);  primary denominator = 194 valid Q8 respondents
  bootstrap: respondent (whole 8-role vector) resampled, B=20000, seed=20241025, percentile 95% CI
  cross-checks: Wilson, BCa, paired ProjectLead-DataScientist contrast (+ McNemar)
  sensitivity: denominators A-D ; D4_Role secondary lens ; cell-level unit-of-analysis diagnostic
"""
import numpy as np, pandas as pd
from math import sqrt, erf, comb

CSV   = "data/requirements_engineering_for_ML-enabled_systems.csv"
SEED  = 20241025
B     = 20000
SENT  = {"-77", "-99", "-66", "-1"}

ROLES = {  # headline label -> column
    "Project Lead / Project Manager": "Q8_ML_Addressing_Project_Lead",
    "Data Scientist":                 "Q8_ML_Addressing_Data_Scientist",
    "Business Analyst":               "Q8_ML_Addressing_Business_Analyst",
    "Developer":                      "Q8_ML_Addressing_Developer",
    "Solution Architect":             "Q8_ML_Addressing_Solution_Architect",
    "Requirements Engineer":          "Q8_ML_Addressing_Requirement_Engineer",
    "Tester":                         "Q8_ML_Addressing_Tester",
}
OTHERS = "Q8_ML_Addressing_Others"
Q8 = [c for c in ROLES.values()] + [OTHERS]
OUT = []
def say(*a):
    s = " ".join(str(x) for x in a)
    print(s); OUT.append(s)

# ---------------------------------------------------------------- load + clean
df = pd.read_csv(CSV, dtype=str, keep_default_na=False)
n_all = len(df)
for c in Q8:                                   # sentinels -> NaN
    df[c] = df[c].where(~df[c].isin(SENT))
df[OTHERS + "_FREE"] = df["Q8_ML_Addressing_Others_Free"].where(
    ~df["Q8_ML_Addressing_Others_Free"].isin(SENT | {"0"}))

valid = df[~df[Q8].isna().any(axis=1)].copy()          # answered the Q8 block
n_valid = len(valid)

say("=" * 78)
say("0. SAMPLE")
say(f"rows in file                                   : {n_all}")
say(f"rows with a valid (non-sentinel) Q8 block      : {n_valid}")
say(f"rows dropped as Q8 non-response (break-offs)   : {n_all - n_valid}")
say("partial-block non-response rows                 : "
    f"{int(df[Q8].isna().sum(axis=1).between(1, len(Q8)-1).sum())} (all-or-nothing block)")
say(f"valid respondents quoting >=1 of 8 roles       : "
    f"{int(((valid[Q8] == 'quoted').sum(axis=1) > 0).sum())}")
say(f"valid respondents quoting zero roles           : "
    f"{int(((valid[Q8] == 'quoted').sum(axis=1) == 0).sum())}")

# ---------------------------------------------------------------- estimators
def wilson(k, n, z=1.959963984540054):
    if n == 0: return (np.nan, np.nan)
    p = k / n; d = 1 + z*z/n
    c = (p + z*z/(2*n)) / d
    h = z * sqrt(p*(1-p)/n + z*z/(4*n*n)) / d
    return (c - h, c + h)

def boot_paired(M, B=B, seed=SEED):
    """resample respondent rows (whole role vector kept together) -> (B, k) proportions"""
    rng = np.random.default_rng(seed)
    n = M.shape[0]
    idx = rng.integers(0, n, size=(B, n))
    return M[idx].mean(axis=1)

def _z(p):  # standard normal ppf
    from statistics import NormalDist
    return NormalDist().inv_cdf(p)

def norm_cdf(z): return 0.5 * (1 + erf(z / sqrt(2)))

def bca_ci_jk(M, bs, k, alpha=0.05):
    n = M.shape[0]
    x = M[:, k]; phat = x.mean()
    jk = (x.sum() - x) / (n - 1)
    dev = jk.mean() - jk
    s2, s3 = (dev**2).sum(), (dev**3).sum()
    acc = s3 / (6.0 * s2**1.5) if s2 > 0 else 0.0
    z0 = _z(max(min((bs[:, k] < phat).mean(), 1 - 1e-12), 1e-12))
    zl, zu = _z(alpha/2), _z(1 - alpha/2)
    lo = norm_cdf(z0 + (z0 + zl) / (1 - acc*(z0 + zl)))
    hi = norm_cdf(z0 + (z0 + zu) / (1 - acc*(z0 + zu)))
    return np.quantile(bs[:, k], [lo, hi])

# ---------------------------------------------------------------- primary spec
M = (valid[list(ROLES.values()) + [OTHERS]] == "quoted").to_numpy()
labels = list(ROLES.keys()) + ["Others (free text)"]
bs = boot_paired(M)
n = n_valid

say("=" * 78)
say(f"1. PRIMARY SPEC  (denominator = {n} valid Q8 respondents; association == 'quoted')")
say(f"   bootstrap: respondent-level vector resample, B={B}, seed={SEED}, percentile 95% CI")
rows = []
for j, lab in enumerate(labels):
    col = list(ROLES.values()) + [OTHERS]
    k = int(M[:, j].sum()); p = k / n
    plo, phi = np.percentile(bs[:, j], [2.5, 97.5])
    wlo, whi = wilson(k, n)
    blo, bhi = bca_ci_jk(M, bs, j)
    rows.append(dict(role=lab, k=k, n=n, pct=100*p,
                     bs_lo=100*plo, bs_hi=100*phi,
                     wil_lo=100*wlo, wil_hi=100*whi,
                     bca_lo=100*blo, bca_hi=100*bhi,
                     bs_se=100*bs[:, j].std(ddof=1)))
prim = pd.DataFrame(rows).sort_values("pct", ascending=False).reset_index(drop=True)
hdr = f"{'rank':>4} {'role':28s} {'k/n':>9} {'pct':>7} {'boot 95% CI':>19} {'Wilson':>17} {'BCa':>17} {'SE':>6}"
say(hdr); say("-" * len(hdr))
for i, r in prim.iterrows():
    say(f"{i+1:>4} {r.role:28s} {int(r.k):3d}/{int(r.n):<4d} {r.pct:7.3f} "
        f"[{r.bs_lo:7.3f},{r.bs_hi:7.3f}] [{r.wil_lo:6.3f},{r.wil_hi:6.3f}] "
        f"[{r.bca_lo:6.3f},{r.bca_hi:6.3f}] {r.bs_se:6.3f}")
prim.to_csv("out/primary_roles.csv", index=False)

# ---------------------------------------------------------------- paired contrast
ipl, ids_ = labels.index("Project Lead / Project Manager"), labels.index("Data Scientist")
d = bs[:, ipl] - bs[:, ids_]
pl, ds = M[:, ipl], M[:, ids_]
b_, c_ = int(((pl) & (~ds)).sum()), int(((~pl) & (ds)).sum())   # McNemar discordants
from statistics import NormalDist
def mcnemar_exact(b, c):
    n_ = b + c
    if n_ == 0: return 1.0
    k = min(b, c)
    p = sum(comb(n_, i) for i in range(k + 1)) * 2 / 2**n_
    return min(p, 1.0)
say("-" * 78)
say("2. PAIRED CONTRAST  Project Lead/PM  minus  Data Scientist (same bootstrap index)")
say(f"   point estimate        : {100*(pl.mean()-ds.mean()):+.3f} pp "
    f"({int(pl.sum())}/{n} vs {int(ds.sum())}/{n})")
say(f"   bootstrap 95% CI      : [{100*np.percentile(d,2.5):+.3f}, {100*np.percentile(d,97.5):+.3f}] pp")
say(f"   discordant pairs      : PL-only = {b_},  DS-only = {c_}")
say(f"   McNemar exact p       : {mcnemar_exact(b_, c_):.4f}   (bootstrap CI includes 0 -> not separable)")

# ---------------------------------------------------------------- rank stability
say("-" * 78)
say("2b. RANK STABILITY ACROSS BOOTSTRAP REPLICATES (B = %d)" % B)
named_idx = [j for j, lab in enumerate(labels) if lab != "Others (free text)"]
bs_named = bs[:, named_idx]
lab_named = [labels[j] for j in named_idx]
order = (-bs_named).argsort(axis=1)
first = pd.Series([lab_named[o[0]] for o in order]).value_counts(normalize=True) * 100
top2hit = np.array([set(o[:2]) == {lab_named.index("Project Lead / Project Manager"),
                                   lab_named.index("Data Scientist")} for o in order]).mean() * 100
say("   role ranked #1 in a replicate:")
for k_, v_ in first.items(): say(f"      {k_:34s} {v_:6.2f}% of replicates")
say(f"   {top2hit:.2f}% of replicates place Project Lead/PM AND Data Scientist as the top two.")
say(f"   P(Project Lead/PM > Data Scientist) = {(bs[:, ipl] > bs[:, ids_]).mean()*100:.2f}%")

# ---------------------------------------------------------------- sensitivity A-D
say("=" * 78)
say("3. SENSITIVITY TO DENOMINATOR  (association == 'quoted' unchanged)")
df2 = pd.read_csv(CSV, dtype=str, keep_default_na=False)
v2 = df2[~df2[Q8[0]].isin(SENT | {"0"})].copy()
completed = df2.Status.str.startswith("Completed")
role_rep  = ~df2.D4_Role.isin(list(SENT) + ["0"])
anyq      = (df2[Q8] == "quoted").sum(axis=1) > 0
specs = {
 "A  all rows, -77 counted as NOT associated": df2,
 "B  PRIMARY: 194 respondents with valid Q8  ": v2,
 "C  valid Q8 & Status=Completed*            ": v2[v2.Status.str.startswith("Completed")],
 "D  valid Q8 & D4_Role reported (not '0')   ": v2[~v2.D4_Role.isin(list(SENT) + ["0"])],
}
sens_rows = []
for name, d_ in specs.items():
    nn = len(d_)
    r = {"spec": name, "n": nn}
    for lab, c in ROLES.items():
        r[lab] = 100 * (d_[c] == "quoted").sum() / nn
    sens_rows.append(r)
sens = pd.DataFrame(sens_rows)
top2 = {}
for name, d_ in specs.items():
    nn = len(d_)
    pp = {lab: (d_[c] == "quoted").sum() / nn for lab, c in ROLES.items()}
    s = sorted(pp, key=pp.get, reverse=True)
    top2[name] = (s[0], pp[s[0]], s[1], pp[s[1]])
say(f"{'specification':44s} {'n':>5} " + " ".join(f"{l[:9]:>9}" for l in ROLES))
for _, r in sens.iterrows():
    say(f"{r.spec:44s} {int(r.n):5d} " + " ".join(f"{r[l]:9.3f}" for l in ROLES))
say("")
say("top two roles per specification:")
for k_, (r1, p1, r2, p2) in top2.items():
    say(f"   {k_[:44]:44s} -> {r1} ({100*p1:.2f}%) > {r2} ({100*p2:.2f}%)")
sens.to_csv("out/sensitivity_denominators.csv", index=False)
e_ = v2[(v2[Q8] == "quoted").sum(axis=1) > 0]; ne = len(e_)
rowe = {"spec": "E  (suppl.) valid Q8 & quoted >=1 role", "n": ne}
for lab, c in ROLES.items(): rowe[lab] = 100 * (e_[c] == "quoted").sum() / ne
sens = pd.concat([sens, pd.DataFrame([rowe])], ignore_index=True)
se = pd.Series({lab: (e_[c] == "quoted").sum() / ne for lab, c in ROLES.items()}).sort_values(ascending=False)
say(f"{rowe['spec']:44s} {ne:5d} " + " ".join(f"{rowe[l]:9.3f}" for l in ROLES))
say("")
say(f"   Supplementary E -> top two: {se.index[0]} ({100*se.iloc[0]:.2f}%) > {se.index[1]} ({100*se.iloc[1]:.2f}%)")
say("   E inflates every role ~6 pp (it conditions on having named anyone) but the ranking holds,")
say("   as does the ~23 pp gap to the third role. Ranking is invariant across A-E.")
sens.to_csv("out/sensitivity_denominators.csv", index=False)

# ---------------------------------------------------------------- secondary lens
say("=" * 78)
say("4. SECONDARY LENS - D4_Role self-report (NOT the headline result)")
vt = v2.copy()
tab = pd.DataFrame({lab: (vt[c] == "quoted").to_numpy() for lab, c in ROLES.items()})
tab["D4_Role"] = vt.D4_Role.values
grp = tab.groupby("D4_Role")
g = (100 * grp[list(ROLES)].mean()).round(1)
g.insert(0, "n", grp.size())
g = g.sort_values("n", ascending=False)
cols = ["n"] + list(ROLES)
say(f"{'own role (D4_Role)':34s} " + " ".join(f"{c[:9]:>9}" for c in cols))
for ix, r in g[cols].iterrows():
    say(f"{str(ix)[:34]:34s} " + " ".join(f"{r[c]:9.1f}" if c != 'n' else f"{int(r[c]):9d}" for c in cols))
g.to_csv("out/secondary_d4role_lens.csv")
say("   (Requirements Engineer n=2 and Tester n=2 are uninterpretable; '0' = role not reported.)")

# ---------------------------------------------------------------- cell-level diagnostic
say("=" * 78)
say("5. DIAGNOSTIC - does a CELL-LEVEL (respondent x role) unit give sub-1 pp CIs?")
cell_mat = M.reshape(-1)                     # 194 x 8 cells, respondent-level clustering preserved
k_cells, n_cells = int(cell_mat.sum()), cell_mat.size
p_cells = k_cells / n_cells
rng = np.random.default_rng(SEED)
idx_cell = rng.integers(0, n_cells, size=(B, n_cells))          # WRONG-but-conventional iid cell resample
bs_cell = cell_mat[idx_cell].mean(axis=1)
lo_c, hi_c = np.percentile(bs_cell, [2.5, 97.5])
say(f"   pooled cells {n}x8 = {n_cells}; quoted cells = {k_cells}; p = {100*p_cells:.3f}%")
say(f"   iid-cell bootstrap 95% CI : [{100*lo_c:.3f}, {100*hi_c:.3f}]  half-width {100*(hi_c-lo_c)/2:.3f} pp")
say(f"   respondent-level (correct) CI for the same quantity would be ~+/-7 pp")
# effective n implied by the benchmark CI half-widths
for lab, p_, hw in [("49.6 [49.219,49.981]", 0.496, 0.00381), ("61.389 [60.955,61.822]", 0.61389, 0.004335)]:
    say(f"   benchmark CI {lab:26s} implies effective n ~ {p_*(1-p_)/(hw/1.959963984540054)**2:,.0f}")
say(f"   => max defensible n here is {n_all} respondents / {n_cells} cells / "
    f"{sum(int((df2[c].isin(['quoted','not quoted'])).sum()) for c in df2.columns):,} binary cells file-wide")
say("   VERDICT: even the (statistically invalid) iid-cell unit gives ~+/-2 pp, NOT the +/-0.4 pp")
say("   quoted in the task; those CIs are not reproducible from this file at n <= 276. Stopping here.")

# ---------------------------------------------------------------- footnote
say("=" * 78)
say("6. FOOTNOTE - Q8 'Others' free-text role mentions")
ft = df[OTHERS + "_FREE"].dropna()
say(f"   'Others' quoted by {int((valid[OTHERS]=='quoted').sum())}/{n} respondents; free texts: "
    + "; ".join(sorted(ft.unique())))
say("=" * 78)

with open("out/analysis_output.txt", "w") as f:
    f.write("\n".join(OUT) + "\n")
print("\n[saved] out/analysis_output.txt, out/primary_roles.csv, out/sensitivity_denominators.csv, out/secondary_d4role_lens.csv")
