"""Q10 requirements-documentation formats: least-used ranking with respondent-level
bootstrap. Constraints per researcher:
  * sentinel (-77 whole-block skip) -> NaN, excluded from numerator AND denominator
  * respondent-level resampling, B=10000, seed=42, 95% percentile CI, Wilson sensitivity
  * ranking as a JOINT statistic per replicate -> P(format in two least used)
  * primary base = Q10-complete (n=194); secondary = documenters-only (n=146), both labelled
  * no tuning toward the reference 10.13% / 4.366% figures
"""
import pandas as pd, numpy as np

CSV   = 'data/requirements_engineering_for_ML-enabled_systems.csv'
PFX   = 'Q10_ML_Documentation_'
NAMED = ['Vision_Document','Requirements_Lists','Goal_Models','Use_Case_Models','Prototypes',
         'User_Stories','BDD_Scenarios','MLCanvas','Notebooks','Data_Models']
EXCL  = ['Not_Documented','Others']
NAMED_C, EXCL_C = [PFX+c for c in NAMED], [PFX+c for c in EXCL]
B, SEED = 10_000, 42

df = pd.read_csv(CSV, dtype=str)
Q    = NAMED_C + EXCL_C
skip = (df[Q] == '-77').all(axis=1)                       # whole-block non-response
base194 = df[~skip].reset_index(drop=True)
M194 = (base194[NAMED_C] == 'quoted')
doc_mask = M194.any(axis=1)
base146  = base194[doc_mask].reset_index(drop=True)

def wilson(k, n, z=1.959963985):
    if n == 0: return (np.nan, np.nan)
    p = k/n; d = 1 + z*z/n
    c = (p + z*z/(2*n))/d
    h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n))/d
    return (c-h, c+h)

def run(M, label):
    n = len(M)
    k = M.sum(axis=0).to_numpy()
    p = 100*k/n
    rng = np.random.default_rng(SEED)
    idx = rng.integers(0, n, size=(B, n))
    boot = 100*M.to_numpy()[idx].mean(axis=1)              # (B, 10) joint per replicate
    ci = np.percentile(boot, [2.5, 97.5], axis=0)
    order = np.argsort(np.argsort(boot, axis=1, kind='stable'), axis=1)  # ranks 0..9
    prob = (order < 2).mean(axis=0)*100                    # in two least used
    top2 = np.argsort(boot, axis=1)[:, :2]
    pair = pd.Series([tuple(sorted(r)) for r in top2]).value_counts()
    rows = []
    for j, c in enumerate(NAMED):
        lo, hi = ci[0, j], ci[1, j]
        wlo, whi = wilson(k[j], n)
        rows.append(dict(format=c, k=int(k[j]), N=n, pct=p[j],
                         boot_lo=lo, boot_hi=hi, wil_lo=100*wlo, wil_hi=100*whi,
                         P_in_bottom2=prob[j]))
    t = pd.DataFrame(rows).sort_values('pct').reset_index(drop=True)
    print(f'\n===== {label}  (N={n}, B={B}, seed={SEED}) =====')
    print(t.to_string(index=False, float_format=lambda v: f'{v:8.3f}'))
    print(f'  joint bottom-two pair frequency (top 3 of {len(pair)}):')
    for key, cnt in pair.head(3).items():
        print(f'     {" + ".join(NAMED[i] for i in key):32s} {100*cnt/B:6.2f}% of replicates')
    return t, pair

t194, pair194 = run(M194, 'PRIMARY  Q10-complete base')
t146, pair146 = run(base146[NAMED_C] == 'quoted',
                    'SECONDARY  documenters-only base (>=1 named format quoted)')

# ---- audit table: exclusions kept visible -----------------------------------
print('\n===== DENOMINATOR / EXCLUSION SENSITIVITY (no bootstrap, % selecting) =====')
rows=[]
for lab, d in [('all respondents', df), ('Q10-complete', base194),
               ('Q10-complete, Completed only', base194[base194.Status=='Completed (31)']),
               ('Q10-complete, Completed+after break', base194[base194.Status!='Suspended (22)']),
               ('documenters-only', base146)]:
    N=len(d); r={c:100*(d[PFX+c]=='quoted').sum()/N for c in NAMED+EXCL}
    bot=sorted(r.items(), key=lambda kv: kv[1])
    rows.append(dict(base=lab, N=N,
                     lowest=f'{bot[0][0]} ({bot[0][1]:.2f}%)',
                     second=f'{bot[1][0]} ({bot[1][1]:.2f}%)',
                     MLCanvas=r['MLCanvas'], BDD=r['BDD_Scenarios'],
                     NotDoc_in_set=r['Not_Documented'], Others_in_set=r['Others']))
print(pd.DataFrame(rows).to_string(index=False, float_format=lambda v: f'{v:7.3f}'))

# ---- reference-figure diagnostics (stated once, not tuned to) ---------------
print('\n===== REFERENCE FIGURES 10.13% / 4.366% : diagnostics (NOT fitted to) =====')
for p, lo, hi in [(10.13, 9.926, 10.333), (4.366, 4.231, 4.501)]:
    half=(hi-lo)/2; se=np.sqrt(p/100*(1-p/100)/194)*100
    nimp=(p/100)*(1-p/100)/((half/1.96)/100)**2
    print(f'  p={p:6.3f}%  quoted half-width={half:.3f}pp -> implied n={nimp:8,.0f}; '
          f'true binomial 95% half-width at n=194 = {1.96*se:.2f}pp')
print('  ratio of targets =', round(10.13/4.366, 4),
      '| no pair of observed counts in', sorted(int(x) for x in M194.sum()), 'has that ratio')


# ---- ADDENDUM 1: does the candidate pair change if excluded codes re-enter? ---
print("\n===== ADDENDUM 1  candidate pair: named-only set vs all-12 set =====")
for lab, d in [("Q10-complete", base194), ("documenters-only", base146)]:
    N = len(d)
    named = sorted(((100*(d[c]=="quoted").sum()/N, c.replace(PFX,"")) for c in NAMED_C))
    al12  = sorted(((100*(d[c]=="quoted").sum()/N, c.replace(PFX,"")) for c in Q))
    print(f"  {lab:18s} N={N:3d} | named-only bottom2: {named[0][1]} {named[0][0]:.2f}% + "
          f"{named[1][1]} {named[1][0]:.2f}%  |  all-12 bottom2: "
          f"{al12[0][1]} {al12[0][0]:.2f}% + {al12[1][1]} {al12[1][0]:.2f}%")

# ---- ADDENDUM 2: BDD small-count discreteness + seed stability ---------------
print("\n===== ADDENDUM 2  BDD_Scenarios discreteness and seed stability =====")
print(f"  k=4 of N=194: one-tick resolution = {100/194:.3f}pp; k=4 -> {4/194*100:.3f}%")
print("  possible BDD values near k=4:", [f"{100*j/194:.3f}" for j in (3,4,5)],
      "-> bootstrap CI is coarse/discrete; treat BDD rank-1 as qualitative")
for sd in (0, 7, 42, 2024):
    rng = np.random.default_rng(sd); n = len(M194)
    b = 100*M194.to_numpy()[rng.integers(0, n, size=(B, n))].mean(axis=1)
    bot = np.argsort(b, axis=1)[:, :2]
    frac = np.mean([set(r) == {NAMED.index("BDD_Scenarios"), NAMED.index("MLCanvas")} for r in bot])
    ci = np.percentile(b, [2.5, 97.5], axis=0)
    jB, jM = NAMED.index("BDD_Scenarios"), NAMED.index("MLCanvas")
    print(f"  seed={sd:5d} pair={100*frac:6.2f}%  BDD CI=[{ci[0,jB]:.3f},{ci[1,jB]:.3f}]"
          f"  MLCanvas CI=[{ci[0,jM]:.3f},{ci[1,jM]:.3f}]")

# ---- ADDENDUM 3: separation of the two leaders from rank 3 ------------------
print("\n===== ADDENDUM 3  gap to rank 3 (are the two leaders separated?) =====")
rng = np.random.default_rng(SEED); n = len(M194)
b = 100*M194.to_numpy()[rng.integers(0, n, size=(B, n))].mean(axis=1)
jB, jM, jG = (NAMED.index(c) for c in ("BDD_Scenarios", "MLCanvas", "Goal_Models"))
gap = b[:, jG].mean() - b[:, jM].mean()
print(f"  observed MLCanvas(7.73%) -> Goal/Vision(14.95%) gap = {gap:.3f}pp")
rank_M = (b < b[:, jM][:, None]).sum(axis=1)
print(f"  P(MLCanvas rank <= 2) = {100*np.mean(rank_M <= 1):.2f}%")
p_B = (b < b[:, jB][:, None]).sum(axis=1)
print(f"  P(BDD rank == 1)      = {100*np.mean(p_B == 0):.2f}%")
third = np.sort(b, axis=1)[:, 2]
is_G = np.isclose(third, b[:, jG])
print(f"  P(rank3 is Goal_Models or Vision_Document) = {100*np.mean(is_G | np.isclose(third, b[:, NAMED.index('Vision_Document')])):.2f}%")
print("\nDONE")
