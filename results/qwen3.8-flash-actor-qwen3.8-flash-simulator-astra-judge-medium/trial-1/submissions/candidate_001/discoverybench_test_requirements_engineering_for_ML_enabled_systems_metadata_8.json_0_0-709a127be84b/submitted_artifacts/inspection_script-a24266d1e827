"""Inspection pass: Q10_ML_Documentation_* requirements-documentation battery.
No inference here - only structure, coding scale, sentinel handling and
candidate denominators (pre-analysis diagnostics)."""
import pandas as pd, numpy as np

CSV = 'data/requirements_engineering_for_ML-enabled_systems.csv'
PFX = 'Q10_ML_Documentation_'
NAMED = ['Vision_Document','Requirements_Lists','Goal_Models','Use_Case_Models','Prototypes',
         'User_Stories','BDD_Scenarios','MLCanvas','Notebooks','Data_Models']
NON_FMT = ['Not_Documented','Others']
COLS = [PFX + c for c in NAMED + NON_FMT]

def load():
    df = pd.read_csv(CSV, dtype=str)          # keep '-77' etc. as strings, no coercion
    return df

def base_table(df, base, label):
    n = len(base)
    rows = [(c.replace(PFX, ''), int((base[c] == 'quoted').sum()), 100 * (base[c] == 'quoted').sum() / n)
            for c in COLS]
    out = pd.DataFrame(rows, columns=['format', 'quoted_n', 'pct']).sort_values('pct')
    out.insert(0, 'base', label); out.insert(1, 'N', n)
    return out

def main():
    df = load()
    print('respondents =', len(df), '| columns =', df.shape[1],
          '| unique ID =', df.ID.nunique(), '| dup ID =', int(df.ID.duplicated().sum()))

    # ---- coding scale -------------------------------------------------------
    vals = pd.unique(df[COLS].values.ravel())
    print('\nQ10 raw value set:', sorted(vals))
    print('sentinel -77 rows (whole-block non-response):',
          int((df[COLS] == '-77').all(axis=1).sum()))
    print('per-column -77 counts identical:',
          len({int((df[c] == '-77').sum()) for c in COLS}) == 1)

    valid = df[(df[COLS] != '-77').all(axis=1)]
    named_q = valid[[PFX + c for c in NAMED]] == 'quoted'
    docuers = valid[named_q.any(axis=1)]

    tabs = pd.concat([base_table(df, valid, 'Q10_valid'),
                      base_table(df, docuers, 'documenters_ge1_named'),
                      base_table(df, df, 'all_respondents')], ignore_index=True)
    print('\n', tabs.to_string(index=False))

    # ---- free-text Others placeholder codes ------------------------------
    free = df[PFX + 'Others_Free']
    print('\nOthers_Free placeholder counts:',
          free[free.isin(['-99', '-66', '-'])].value_counts().to_dict(),
          '| substantive free text:', int((~free.isin(['-99', '-66', '-'])).sum()))

    # ---- CI precision implied by the reported intervals -------------------
    for p, lo, hi in [(10.13, 9.926, 10.333), (4.366, 4.231, 4.501)]:
        half = (hi - lo) / 2
        se = np.sqrt(p / 100 * (1 - p / 100) / len(valid)) * 100
        print(f'target p={p}%  reported half-width={half:.3f}pp  '
              f'vs binomial SE at n={len(valid)} = {se:.3f}pp '
              f'(ratio {se/half/1.96:.1f}x -> CI looks like SE/sqrt(B), not percentile)')

if __name__ == '__main__':
    main()
