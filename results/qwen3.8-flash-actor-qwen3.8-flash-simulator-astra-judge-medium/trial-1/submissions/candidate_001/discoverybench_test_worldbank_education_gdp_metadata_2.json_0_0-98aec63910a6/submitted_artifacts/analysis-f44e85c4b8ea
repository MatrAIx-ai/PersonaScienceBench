def g_(spec, term):
    r = res[(res.spec == spec) & (res.term == term)]
    if not len(r): return (np.nan,) * 4 + (np.nan,)
    q = r.iloc[0]; return q.coef, q.se, q.ci_lo, q.ci_hi, q.p

