"""
Education expenditure vs per-capita income: Sub-Saharan Africa (SSF) vs Lower-middle-income (LMC).
Input : data/worldbank_education_gdp.csv  (2 group AGGREGATES x 6 series x 1975-2015, wide format)
Output: analysis/panel_long.csv, analysis/panel_wide.csv,
        analysis/results_summary.csv, analysis/diagnostics.csv

Design rulings honoured
  * Inference leads with DIFFERENCED / LAGGED specs; levels log-log kept only as trend-driven descriptive.
  * PRIMARY evidence = transmission channel education expenditure -> primary/secondary gross enrollment (1975-2015).
  * Matched-window 2011-2015 income slope reported alongside as the direct-but-underpowered answer (n=5 vs n=5).
  * No external data, no imputation of the 36 missing SSF GNI-per-capita years, no FE/GMM on N=2 units.
  * Every coefficient carries n, window, SE and 95% CI. Small-n models are flagged, not hidden.
  * Raw-unit AND within-group z-scored slopes reported; group contrast in interpretable form.
"""
import numpy as np, pandas as pd, statsmodels.api as sm

SRC = 'data/worldbank_education_gdp.csv'
OUT_LONG, OUT_WIDE = 'analysis/panel_long.csv', 'analysis/panel_wide.csv'
OUT_RES, OUT_DIAG  = 'analysis/results_summary.csv', 'analysis/diagnostics.csv'
SHORT = {'NY.GNP.PCAP.KD':'gnipc','NY.ADJ.AEDU.GN.ZS':'eduexp','NE.EXP.GNFS.KD.ZG':'exports',
         'SE.PRM.ENRR':'prim','SE.SEC.ENRR':'sec','SL.TLF.CACT.ZS':'lfpr'}
GRP = {'SSF':'Sub-Saharan Africa','LMC':'Lower middle income'}
MIN_DF = 8          # below this residual df -> model flagged DESCRIPTIVE ONLY
MIN_T  = 20         # HAC only used with at least this many time-series observations

# ------------------------------------------------------- 1. reshape wide -> long -> panel
raw = pd.read_csv(SRC)
year_cols = [c for c in raw.columns if '[YR' in c]
long = raw.melt(id_vars=['Country Group','Country Code','Series Name','Series Code'],
                value_vars=year_cols, var_name='YearLabel', value_name='value')
long['year']     = long['YearLabel'].str.extract(r'(\d{4})').astype(int)
long['value']    = pd.to_numeric(long['value'], errors='coerce')
long['variable'] = long['Series Code'].map(SHORT)
long['group_name'] = long['Country Code'].map(GRP)
long[['Country Group','Country Code','group_name','Series Name','Series Code',
      'variable','year','value']].to_csv(OUT_LONG, index=False)
wide = (long.pivot_table(index=['Country Code','group_name','year'], columns='variable',
                         values='value', aggfunc='first').reset_index()
            .sort_values(['Country Code','year']).reset_index(drop=True))
wide.to_csv(OUT_WIDE, index=False)

# ------------------------------------------------------- 2. estimation helpers
rows = []
def fit(spec, d, y, xcols, *, se='HAC', hac=4, group='', outcome='', window=None,
        role='inference', unit='', note=''):
    d = d.dropna(subset=[y] + xcols)
    n = len(d); k = len(xcols) + 1; dfres = n - k
    win = window or f"{int(d['year'].min())}-{int(d['year'].max())}"
    if dfres < 1:
        rows.append(dict(spec=spec, role=role, group=group, outcome=outcome or y, window=win,
                         term='NOT ESTIMABLE', coef=np.nan, se=np.nan, ci_lo=np.nan, ci_hi=np.nan,
                         p=np.nan, n=n, df_resid=dfres, r2=np.nan, dw=np.nan, se_type='n/a',
                         unit=unit, note=f'n={n} <= k={k}; nothing estimable'))
        return None
    status = 'estimated' if dfres >= MIN_DF else f'DESCRIPTIVE ONLY (df={dfres}<{MIN_DF})'
    X = sm.add_constant(d[xcols].astype(float))
    if se == 'HAC' and n >= MIN_T:
        m = sm.OLS(d[y].astype(float), X).fit(cov_type='HAC', cov_kwds={'maxlags': hac})
        se_type = f'Newey-West({hac})'
    else:
        m = sm.OLS(d[y].astype(float), X).fit()
        se_type = 'classical OLS (small-n)' + ('' if se == 'OLS' else ' [HAC skipped: n<%d]' % MIN_T)
    r = m.resid; dw = float(np.sum(np.diff(r)**2) / np.sum(r**2)) if n > 2 else np.nan
    # conservative alternative: if HAC SE is SMALLER than the classical OLS SE (possible when the
    # regressor has negatively autocorrelated differences), report the wider interval as the headline.
    mc = sm.OLS(d[y].astype(float), X).fit()
    ci = m.conf_int(); cic = mc.conf_int()
    for t in X.columns:
        use_cons = m.bse[t] < mc.bse[t] - 1e-12
        se_used = max(m.bse[t], mc.bse[t]); lo = min(ci.loc[t, 0], cic.loc[t, 0]); hi = max(ci.loc[t, 1], cic.loc[t, 1])
        rows.append(dict(spec=spec, role=role, group=group, outcome=outcome or y, window=win, term=t,
                         coef=m.params[t], se=se_used, ci_lo=lo, ci_hi=hi,
                         p=max(m.pvalues[t], mc.pvalues[t]), n=n, df_resid=dfres, r2=m.rsquared, dw=dw,
                         se_type=se_type + (' + classical fallback (wider used)' if use_cons else ''),
                         se_hac=m.bse[t], se_classical=mc.bse[t], unit=unit,
                         note=(note + '; ' if note else '') + status))
    return m

def detrend(x, y):
    """remove a separate linear time trend from each series, return residual correlation + n_eff."""
    m = pd.DataFrame({'x': x, 'y': y}).dropna()
    if len(m) < 5: return np.nan, len(m), np.nan
    T = np.arange(len(m)); T = T - T.mean()
    rx = m['x'] - (m['x'].mean() + (T * (T @ (m['x'] - m['x'].mean())) / (T @ T)))
    ry = m['y'] - (m['y'].mean() + (T * (T @ (m['y'] - m['y'].mean())) / (T @ T)))
    r = rx.corr(ry)
    a1 = (rx.corr(rx.shift(1)))
    ne = len(m) * (1 - a1) / (1 + a1) if a1 is not None and -1 < a1 < 1 else float(len(m))
    return r, len(m), float(max(ne, 3.0))

def fisher_ci(r, n, rho=0.0):
    """Pearson-r CI; with rho!=0 use Bartlett n_eff = n(1-rho)/(1+rho) to inflate for autocorrelation."""
    if np.isnan(r) or n < 4: return (np.nan, np.nan, float(n))
    ne = max(n * (1 - rho) / (1 + rho), 3.0) if -1 < rho < 1 else float(n)
    z = np.arctanh(np.clip(r, -0.999999, 0.999999)); s = 1 / np.sqrt(max(ne - 3, 1))
    return np.tanh(z - 1.96 * s), np.tanh(z + 1.96 * s), ne

G = {}
for g in ['LMC', 'SSF']:
    d = wide[wide['Country Code'] == g].copy().reset_index(drop=True)
    d['t'] = d['year'] - 1974
    d['lgni'] = np.log(d['gnipc']); d['d_lgni'] = d['lgni'].diff()
    for v in ['eduexp', 'prim', 'sec', 'exports', 'lfpr']: d['d_' + v] = d[v].diff()
    d['l_eduexp'] = np.log(d['eduexp'])
    for v in ['eduexp', 'prim', 'sec', 'exports', 'lfpr']: d[v + '_l1'] = d[v].shift(1)
    d['d_lgni_l1'] = d['d_lgni'].shift(1)
    for v in ['eduexp', 'd_eduexp', 'prim', 'sec', 'd_prim', 'd_sec', 'lgni', 'd_lgni']:
        s = d[v].std(ddof=1); d['z_' + v] = (d[v] - d[v].mean()) / s if s and s > 0 else np.nan
    G[g] = d
pool = pd.concat([G['LMC'], G['SSF']], ignore_index=True)
pool['gLMC'] = (pool['Country Code'] == 'LMC').astype(float)
for c in ['d_eduexp', 'eduexp_l1', 'z_d_eduexp', 'eduexp', 'z_eduexp']:
    pool[c + '_x_gLMC'] = pool[c] * pool['gLMC']
print('reshape ok', long.shape, wide.shape)

# ------------------------------------------- 3. DIAGNOSTICS: autocorrelation & spuriousness
diag = []
for g, d in G.items():
    for v in ['gnipc', 'eduexp', 'prim', 'sec', 'exports', 'lfpr']:
        ok = d[v].notna()
        diag.append(dict(table='autocorrelation', group=g, item=v, n=int(ok.sum()),
            first_year=int(d.loc[ok, 'year'].min()), last_year=int(d.loc[ok, 'year'].max()),
            acf1_levels=d[v].autocorr(1), acf1_first_diff=d[v].diff().autocorr(1),
            sd_levels=d[v].std(ddof=1), sd_first_diff=d[v].diff().std(ddof=1),
            mean_level=d[v].mean(), first_value=d.loc[ok, v].iloc[0], last_value=d.loc[ok, v].iloc[-1],
            total_change=d.loc[ok, v].iloc[-1] - d.loc[ok, v].iloc[0],
            change_per_pp_eduexp=np.nan, n_diff=int(d[v].diff().notna().sum()),
            r_levels=np.nan, r_firstdiff=np.nan, r_detrended=np.nan, n_detrended=np.nan,
            r_CI_lo=np.nan, r_CI_hi=np.nan, n_eff=np.nan))
for g in ['LMC', 'SSF']:
    d = G[g]
    for a, b in [('eduexp', 'gnipc'), ('eduexp', 'prim'), ('eduexp', 'sec'),
                 ('prim', 'gnipc'), ('sec', 'gnipc')]:
        lv = d[[a, b]].dropna(); df_ = pd.DataFrame({a: d[a].diff(), b: d[b].diff()}).dropna()
        rl = lv[a].corr(lv[b]) if len(lv) > 2 else np.nan
        rd = df_[a].corr(df_[b]) if len(df_) > 2 else np.nan
        rt, ntr, net = detrend(d[a], d[b])
        rho_t = 0.0 if np.isnan(net) else max(0.0, 1 - 3.0 / max(net, 3.0))
        lo, hi, ne = fisher_ci(rt if not np.isnan(rt) else rl, int(ntr) if ntr else len(lv), rho_t)
        diag.append(dict(table='correlation levels vs differenced', group=g, item=f'{a} vs {b}',
            n=len(lv), first_year=int(d.loc[lv.index, 'year'].min()) if len(lv) else np.nan,
            last_year=int(d.loc[lv.index, 'year'].max()) if len(lv) else np.nan,
            acf1_levels=d[b].autocorr(1), acf1_first_diff=d[b].diff().autocorr(1),
            sd_levels=np.nan, sd_first_diff=np.nan, mean_level=np.nan, first_value=np.nan,
            last_value=np.nan, total_change=np.nan, change_per_pp_eduexp=np.nan, n_diff=len(df_),
            r_levels=rl, r_firstdiff=rd, r_detrended=rt, n_detrended=ntr,
            r_CI_lo=lo, r_CI_hi=hi, n_eff=ne))

# ====== A. PRIMARY EVIDENCE: transmission channel eduexp -> gross enrollment (1975-2015)
LBL = {'d_prim': 'Δ primary GER (pp)', 'd_sec': 'Δ secondary GER (pp)',
       'prim': 'primary GER (%)', 'sec': 'secondary GER (%)'}
for g in ['LMC', 'SSF']:
    for y in ['d_prim', 'd_sec']:
        fit(f'A1 differenced {y} ~ Δeduexp [{g}]', G[g], y, ['d_eduexp'], group=g, outcome=LBL[y],
            role='PRIMARY inference', unit='pp GER per +1pp eduexp/GNI')
for y in ['d_prim', 'd_sec']:
    fit(f'A2 pooled differenced {y} ~ Δeduexp × LMC + trend', pool, y,
        ['d_eduexp', 'd_eduexp_x_gLMC', 'gLMC', 't'], group='pooled', outcome=LBL[y],
        role='PRIMARY inference: GROUP CONTRAST', unit='pp GER per +1pp eduexp/GNI',
        note='interaction term = LMC slope − SSF slope')
for g in ['LMC', 'SSF']:
    for y in ['prim', 'sec']:
        fit(f'A3 lagged levels {y} ~ eduexp(t−1) + trend [{g}]', G[g], y, ['eduexp_l1', 't'],
            group=g, outcome=LBL[y], role='descriptive (trend-driven levels)',
            unit='pp GER per +1pp eduexp/GNI')
for y, zy in [('d_prim', 'z_d_prim'), ('d_sec', 'z_d_sec')]:
    fit(f'A4 pooled z-differenced z(Δ{y[2:]}) ~ z(Δeduexp) × LMC', pool, zy,
        ['z_d_eduexp', 'z_d_eduexp_x_gLMC', 'gLMC'], group='pooled', outcome=f'z(Δ{y[2:]})',
        role='PRIMARY inference: STANDARDISED GROUP CONTRAST', unit='within-group SD per within-group SD',
        note='interaction term = LMC − SSF standardised slope')
    for g in ['LMC', 'SSF']:
        fit(f'A4b z-differenced z(Δ{y[2:]}) ~ z(Δeduexp) [{g}]', G[g], zy, ['z_d_eduexp'], group=g,
            outcome=f'z(Δ{y[2:]})', role='PRIMARY inference (standardised)', unit='SD per SD')
for g in ['LMC', 'SSF']:
    fit(f'A5 enrollment -> income growth [{g}]', G[g], 'd_lgni', ['prim_l1', 'sec_l1'], group=g,
        outcome='Δlog GNIpc', role='channel step 2 (LMC usable; SSF n tiny)',
        unit='log pts per +1pp GER (lagged)')
print('section A done')

# ====== B. THE LITERAL QUESTION: matched window 2011-2015 (only years where BOTH groups have income)
mw = pd.concat([G['LMC'], G['SSF']], ignore_index=True)
mw = mw[(mw['year'] >= 2011) & (mw['year'] <= 2015)].copy()
mw['gLMC'] = (mw['Country Code'] == 'LMC').astype(float)
mw['eduexp_x_gLMC'] = mw['eduexp'] * mw['gLMC']
mw['eduexp_l1_x_gLMC'] = mw['eduexp_l1'] * mw['gLMC']
for g in ['LMC', 'SSF']:                       # z-score WITHIN the 5-year window per group => slope == r
    m = mw['Country Code'] == g
    for v in ['lgni', 'eduexp']:
        mu, sd = mw.loc[m, v].mean(), mw.loc[m, v].std(ddof=1)
        mw.loc[m, 'wz_' + v] = (mw.loc[m, v] - mu) / sd
mw['wz_eduexp_x_gLMC'] = mw['wz_eduexp'] * mw['gLMC']
sd_win = {g: mw.loc[mw['Country Code'] == g, 'eduexp'].std(ddof=1) for g in ['LMC', 'SSF']}

for g in ['LMC', 'SSF']:
    fit('B1 matched-window log GNIpc ~ eduexp [group run]', mw[mw['Country Code'] == g], 'lgni', ['eduexp'],
        se='OLS', group=g,
        outcome='log GNIpc', window='2011-2015', role='DIRECT-LITERAL (underpowered)',
        unit='log pts per +1pp eduexp/GNI', note='5 co-trending aggregate points, no independent draws')
fit('B2 matched-window pooled log GNIpc ~ eduexp × LMC', mw, 'lgni',
    ['eduexp', 'eduexp_x_gLMC', 'gLMC'], se='OLS', group='pooled', outcome='log GNIpc',
    window='2011-2015', role='DIRECT-LITERAL: GROUP CONTRAST', unit='log pts per +1pp eduexp/GNI',
    note='interaction term = LMC slope − SSF slope')
fit('B3 matched-window within-window z: z(logGNIpc) ~ z(eduexp) × LMC', mw, 'wz_lgni',
    ['wz_eduexp', 'wz_eduexp_x_gLMC', 'gLMC'], se='OLS', group='pooled', outcome='z(log GNIpc) in-window',
    window='2011-2015', role='DIRECT-LITERAL: STANDARDISED', unit='window-SD per window-SD',
    note='slope == within-group Pearson r over 2011-2015')
fit('B4 matched-window growth ΔlogGNIpc ~ eduexp(t−1) × LMC', mw, 'd_lgni',
    ['eduexp_l1', 'eduexp_l1_x_gLMC', 'gLMC'], se='OLS', group='pooled', outcome='Δlog GNIpc',
    window='2012-2015', role='DIRECT-LITERAL (growth, very underpowered)',
    unit='log pts per +1pp lagged eduexp/GNI')
rB = {}
for g in ['LMC', 'SSF']:
    d = mw[mw['Country Code'] == g].dropna(subset=['lgni', 'eduexp'])
    r = d['lgni'].corr(d['eduexp']); rho = d['eduexp'].autocorr(1)
    rt, ntr, net = detrend(G[g]['lgni'], G[g]['eduexp'])
    lo, hi, ne = fisher_ci(r, len(d), min(max(rho, 0.0), 0.9))
    rB[g] = dict(r=r, n=len(d), rho=rho, lo=lo, hi=hi, ne=ne,
                 sd_eduexp=mw.loc[mw['Country Code'] == g, 'eduexp'].std(ddof=1))
    rows.append(dict(spec=f'B5 matched-window Pearson r(logGNIpc, eduexp) [{g}]',
        role='DIRECT-LITERAL: r with autocorrelation-inflated CI', group=g,
        outcome='log GNIpc vs eduexp', window='2011-2015', term='pearson r', coef=r, se=np.nan,
        ci_lo=lo, ci_hi=hi, p=np.nan, n=len(d), df_resid=len(d) - 2, r2=r**2, dw=np.nan,
        se_type=f'Fisher-z on n_eff={ne:.1f} (Bartlett, acf1={rho:+.2f})', unit='correlation',
        note='naive CI would treat 5 near-monotone aggregate points as independent draws'))

# ===== C. LMC GROWTH EQUATION (only long income series): with/without exports, ± LFPR, dynamic
dL = G['LMC']
fit('C1 LMC ΔlogGNI ~ eduexp(t−1) + trend  [NO exports]', dL, 'd_lgni', ['eduexp_l1', 't'], group='LMC',
    outcome='Δlog GNIpc', role='inference: no-export spec', unit='log pts growth per +1pp lagged eduexp/GNI')
fit('C2 LMC ΔlogGNI ~ eduexp(t−1) + exports(t−1) + trend  [WITH exports]', dL, 'd_lgni',
    ['eduexp_l1', 'exports_l1', 't'], group='LMC', outcome='Δlog GNIpc',
    role='inference: with-export spec', unit='log pts growth per +1pp lagged eduexp/GNI',
    note='exports is itself a growth rate -> possible over-control')
fit('C3 LMC ΔlogGNI ~ Δeduexp + trend  [contemporaneous differenced]', dL, 'd_lgni', ['d_eduexp', 't'],
    group='LMC', outcome='Δlog GNIpc', role='inference', unit='log pts per +1pp Δeduexp/GNI')
fit('C4 LMC ΔlogGNI ~ eduexp(t−1) + prim(t−1) + sec(t−1) + exports(t−1) + trend', dL, 'd_lgni',
    ['eduexp_l1', 'prim_l1', 'sec_l1', 'exports_l1', 't'], group='LMC', outcome='Δlog GNIpc',
    role='inference: full controls (enrollment = over-control for total effect)',
    unit='log pts growth per +1pp lagged eduexp/GNI')
fit('C5 LMC ΔlogGNI + LFPR  [1991-2015 sample]', dL, 'd_lgni',
    ['eduexp_l1', 'lfpr_l1', 'prim_l1', 'sec_l1', 'exports_l1', 't'], group='LMC', outcome='Δlog GNIpc',
    role='inference: LFPR spec (n shrinks)', unit='log pts growth per +1pp lagged eduexp/GNI')
fit('C6 dynamic LMC ΔlogGNI ~ ΔlogGNI(t−1) + eduexp(t−1) + exports(t−1) + trend', dL, 'd_lgni',
    ['d_lgni_l1', 'eduexp_l1', 'exports_l1', 't'], group='LMC', outcome='Δlog GNIpc',
    role='inference: dynamic AR(1)', unit='log pts growth per +1pp lagged eduexp/GNI')
fit('C7 SSF growth equation (income only 2011-2015)', G['SSF'], 'd_lgni', ['eduexp_l1', 't'], se='OLS',
    group='SSF', outcome='Δlog GNIpc', role='NOT USABLE FOR INFERENCE (shown for completeness)',
    unit='log pts per +1pp lagged eduexp/GNI', note='4 usable growth observations')
# C8: LMC long differences over non-overlapping 5-year windows (noise reduction / robustness)
w = G['LMC'].dropna(subset=['lgni', 'eduexp']).reset_index(drop=True)
rec = []
for i in range(1980, 2016, 5):
    cur = w[(w['year'] > i - 5) & (w['year'] <= i)]
    prev = w[(w['year'] > i - 10) & (w['year'] <= i - 5)]
    if len(cur) and len(prev):
        rec.append(dict(year=i, d5_lgni=cur['lgni'].iloc[-1] - cur['lgni'].iloc[0],
                        edu_prev=prev['eduexp'].mean(), d5_eduexp=cur['eduexp'].mean() - prev['eduexp'].mean()))
w8 = pd.DataFrame(rec); w8['t'] = w8['year'] / 5.0
fit('C8 LMC 5-year LONG differences: Δ5 logGNIpc ~ mean eduexp(prev 5y) + trend', w8, 'd5_lgni',
    ['edu_prev', 't'], se='OLS', group='LMC', outcome='5-yr Δlog GNIpc',
    role='robustness: long differences (only 8 windows -> descriptive)',
    unit='log pts per +1pp mean lagged eduexp/GNI', note='non-overlapping windows 1976-2015')

for g in ['LMC', 'SSF']:
    fit(f'D levels log-log elasticity (logGNIpc ~ log eduexp + trend) [{g}]', G[g], 'lgni',
        ['l_eduexp', 't'], group=g, outcome='log GNIpc',
        role='DESCRIPTIVE COLOUR ONLY — trend-driven levels, NOT the result', unit='elasticity (log-log)')
print('sections B-D done')

head = []
def H(k, v, extra=''):
    head.append(dict(quantity=k, value=v, detail=extra)); print(f'{k:64s} {v}')

# ---- F. window growth descriptives + SSA in-window differenced income correlation (n=4, descriptive)
for g, d in G.items():
    dd_ = d.dropna(subset=['lgni'])
    gr = np.exp((dd_['lgni'].iloc[-1] - dd_['lgni'].iloc[0]) / (dd_['year'].iloc[-1] - dd_['year'].iloc[0])) - 1
    rr = d[['d_lgni', 'd_eduexp']].dropna()
    rows.append(dict(spec=f'F mean annual GNIpc growth + ΔlogGNI vs Δeduexp corr [{g}]',
        role='DESCRIPTIVE context', group=g, outcome='Δlog GNIpc vs Δeduexp',
        window=f"{int(dd_['year'].min())}-{int(dd_['year'].max())}", term='corr(ΔlogGNIpc, Δeduexp)',
        coef=rr['d_lgni'].corr(rr['d_eduexp']), se=np.nan, ci_lo=np.nan, ci_hi=np.nan, p=np.nan,
        n=len(rr), df_resid=len(rr) - 2, r2=np.nan, dw=np.nan, se_type='n/a',
        unit=f'corr; mean annual GNIpc growth = {gr*100:.2f}%',
        note='descriptive only; SSA income exists for 2011-2015 only'))
H('mean annual GNIpc growth 2011-2015 LMC',
  round((G['LMC'].set_index('year').loc[2015, 'lgni'] - G['LMC'].set_index('year').loc[2011, 'lgni']) / 4 * 100, 2), '%/yr (log basis)')
H('mean annual GNIpc growth 2011-2015 SSF', round((G['SSF'].set_index("year").loc[2015, "lgni"] - G['SSF'].set_index("year").loc[2011, "lgni"]) / 4 * 100, 2), '%/yr (log basis)')
H('mean eduexp share of GNI 1975-2015', f'SSF {G["SSF"]["eduexp"].mean():.3f}% vs LMC {G["LMC"]["eduexp"].mean():.3f}%', 'SSA spends a larger share of GNI')
H('total change in eduexp share 1975->2015', f'SSF {G["SSF"]["eduexp"].iloc[-1]-G["SSF"]["eduexp"].iloc[0]:+.3f}pp vs LMC {G["LMC"]["eduexp"].iloc[-1]-G["LMC"]["eduexp"].iloc[0]:+.3f}pp', 'both fell; SSA by more')
H('total change primary GER 1975->2015', f'SSF {G["SSF"]["prim"].iloc[-1]-G["SSF"]["prim"].iloc[0]:+.1f}pp vs LMC {G["LMC"]["prim"].iloc[-1]-G["LMC"]["prim"].iloc[0]:+.1f}pp', 'SSA expanded enrolment more while its spending share fell')
H('total change secondary GER 1975->2015', f'SSF {G["SSF"]["sec"].iloc[-1]-G["SSF"]["sec"].iloc[0]:+.1f}pp vs LMC {G["LMC"]["sec"].iloc[-1]-G["LMC"]["sec"].iloc[0]:+.1f}pp', '')

# =============================== E. long-span / spending-vs-enrollment descriptives into diagnostics
for g, d in G.items():
    for v in ['prim', 'sec', 'eduexp']:
        s = d.dropna(subset=[v])
        if len(s) >= 2:
