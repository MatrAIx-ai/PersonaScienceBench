"""
Age and likelihood of dissaving (DISSAVED=1) - NLSY79 processed data.
Association analysis only (cross-sectional, single year 1989).

Design (agreed with researcher):
- Primary: deduplicated data (10,535 unique rows), INCOME/BMI as-is.
- Specs: (1) AGE only, (2) AGE + AGE_2, (3) full covariate set with AGE + AGE_2.
- HC1 robust SE. Wald + LRT tests for AGE_2.
- Sensitivity: full sample (12,686); winsorize INCOME/BMI at 1/99 pct; drop mean-imputed INCOME rows.
- Predicted P(DISSAVED) at age 24 vs 32, AME per year with 95% CI (delta method).
- Gender interaction check; descriptive disave/no-change/save breakdown by age group.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats

pd.set_option('display.width', 160)
df_raw = pd.read_csv('data/nls_bmi_processed.csv')
df_raw['MALE'] = (df_raw['GENDER'] == 'MALE').astype(int)

INCOME_MEAN_FULL = df_raw['INCOME'].mean()
df_raw['INCOME_IMP'] = np.isclose(df_raw['INCOME'], INCOME_MEAN_FULL)

df_dd = df_raw.drop_duplicates().reset_index(drop=True)   # primary
print(f"rows raw={len(df_raw)}  deduplicated={len(df_dd)}  dupes_removed={len(df_raw)-len(df_dd)}")

COVS = ['AGE', 'AGE_2', 'INCOME', 'MALE', 'BMI', 'BLACK', 'HISPANIC']

def fit_logit(d, xcols):
    X = sm.add_constant(d[xcols].astype(float))
    return sm.GLM(d['DISSAVED'].astype(float), X, family=sm.families.Binomial()).fit(cov_type='HC1')

def pseudo_r2(m, y):
    ll0 = sm.GLM(y, np.ones((len(y),1)), family=sm.families.Binomial()).fit().llf
    return 1 - m.llf/ll0

def summarize(m, label):
    tab = pd.DataFrame({'coef': m.params, 'se': m.bse, 'p': m.pvalues})
    tab['or'] = np.exp(m.params)
    tab['or_lo'] = np.exp(m.params - 1.96*m.bse)
    tab['or_hi'] = np.exp(m.params + 1.96*m.bse)
    y = m.model.endog
    print(f"\n=== {label} (n={int(m.nobs)}, pseudo-R2={pseudo_r2(m,y):.4f}) ===")
    print(tab.round(5).to_string())
    return tab

def predicted_and_ame(m, d, age_lo=24, age_hi=32):
    b = m.params; V = m.cov_params()
    X = m.model.exog_names
    idx = {n: i for i, n in enumerate(X)}
    cols = [c for c in X if c != 'const']
    def Xat(age):
        dd = d[COVS].astype(float).copy()
        dd['AGE'] = float(age)
        if 'AGE_2' in X: dd['AGE_2'] = float(age)**2
        Z = dd[cols].values
        return np.column_stack([np.ones(len(Z)), Z])
    plo = (1/(1+np.exp(-(Xat(age_lo) @ b.values)))).mean()
    phi = (1/(1+np.exp(-(Xat(age_hi) @ b.values)))).mean()
    cols2 = [c for c in X if c != 'const']
    Xb = np.column_stack([np.ones(len(d)), d[cols2].astype(float).values])
    age = d['AGE'].values.astype(float)
    def ame_of(beta):
        eta_ = Xb @ beta
        p_ = 1/(1+np.exp(-eta_))
        sl = beta[idx['AGE']] + (2*beta[idx['AGE_2']]*age if 'AGE_2' in X else 0)
        return np.mean(p_*(1-p_)*sl)
    h = 1e-5; grad = np.zeros(len(b))
    for j in range(len(b)):
        bp = b.values.copy(); bp[j] += h; bm = b.values.copy(); bm[j] -= h
        grad[j] = (ame_of(bp)-ame_of(bm))/(2*h)
    ame = ame_of(b.values)
    se = float(np.sqrt(grad @ V.values @ grad))
    return plo, phi, ame, se

def report_model(m, label, d):
    summarize(m, label)
    plo, phi, ame, se = predicted_and_ame(m, d)
    print(f"P(DISSAVED) at 24 = {plo:.4f} | at 32 = {phi:.4f} | diff = {phi-plo:+.4f}")
    print(f"AME per +1yr age = {ame:+.5f} (SE {se:.5f}, 95% CI [{ame-1.96*se:+.5f}, {ame+1.96*se:+.5f}], z={ame/se:.2f})")

print("\n" + "="*90 + "\nPRIMARY (deduplicated, INCOME/BMI as-is)\n" + "="*90)
fit_logit(df_dd, ['AGE'])  # ensure function works
report_model(fit_logit(df_dd, ['AGE']), 'S1: AGE only', df_dd)
m2 = fit_logit(df_dd, ['AGE','AGE_2']); report_model(m2, 'S2: AGE + AGE_2', df_dd)
m3 = fit_logit(df_dd, COVS); report_model(m3, 'S3: full covariates + AGE + AGE_2', df_dd)

print("\n--- AGE_2 tests (full-covariate model) ---")
print(f"Wald p(AGE_2) in S3 = {m3.pvalues['AGE_2']:.4f}")
m3r = fit_logit(df_dd, ['AGE','INCOME','MALE','BMI','BLACK','HISPANIC'])
lr = 2*(m3.llf - m3r.llf); p_lr = 1 - stats.chi2.cdf(lr, 1)
print(f"LRT S3 vs S3-without-AGE_2: chi2(1)={lr:.3f}, p={p_lr:.4f}")
m1 = fit_logit(df_dd, ['AGE'])
print(f"AIC: S1={m1.aic:.1f}  S2={m2.aic:.1f}  S3={m3.aic:.1f}")
summarize(m3r, 'S3-linear: full covariates + AGE only')
plo_l, phi_l, ame_l, se_l = predicted_and_ame(m3r, df_dd)
print(f"P at 24={plo_l:.4f}, at 32={phi_l:.4f}, AME/yr={ame_l:+.5f} (SE {se_l:.5f}, CI [{ame_l-1.96*se_l:+.5f},{ame_l+1.96*se_l:+.5f}])")

print("\n" + "="*90 + "\nSENSITIVITY 1: full sample (12,686 rows, duplicates kept)\n" + "="*90)
s_full = fit_logit(df_raw, COVS); summarize(s_full, 'S3 full-sample (dupes kept)')
plo, phi, ame, se = predicted_and_ame(s_full, df_raw)
print(f"AME/yr={ame:+.5f} (SE {se:.5f}, CI [{ame-1.96*se:+.5f},{ame+1.96*se:+.5f}]); AGE p={s_full.pvalues['AGE']:.4g}, AGE_2 p={s_full.pvalues['AGE_2']:.4g}")

print("\n" + "="*90 + "\nSENSITIVITY 2: winsorize INCOME & BMI at 1st/99th pct (dedup)\n" + "="*90)
dW = df_dd.copy()
for c in ['INCOME','BMI']:
    lo, hi = dW[c].quantile([0.01, 0.99])
    dW[c] = dW[c].clip(lo, hi)
s_w = fit_logit(dW, COVS); summarize(s_w, 'S3 winsorized')
plo, phi, ame, se = predicted_and_ame(s_w, dW)
print(f"AME/yr={ame:+.5f} (SE {se:.5f}, CI [{ame-1.96*se:+.5f},{ame+1.96*se:+.5f}]); AGE p={s_w.pvalues['AGE']:.4g}, AGE_2 p={s_w.pvalues['AGE_2']:.4g}")

print("\n" + "="*90 + "\nSENSITIVITY 3: drop mean-imputed INCOME rows (dedup)\n" + "="*90)
dI = df_dd[~df_dd['INCOME_IMP']].reset_index(drop=True)
print(f"n after dropping imputed rows = {len(dI)} (dropped {int(df_dd['INCOME_IMP'].sum())})")
s_i = fit_logit(dI, COVS); summarize(s_i, 'S3 excluding imputed-INCOME rows')
plo, phi, ame, se = predicted_and_ame(s_i, dI)
print(f"AME/yr={ame:+.5f} (SE {se:.5f}, CI [{ame-1.96*se:+.5f},{ame+1.96*se:+.5f}]); AGE p={s_i.pvalues['AGE']:.4g}, AGE_2 p={s_i.pvalues['AGE_2']:.4g}")

print("\n" + "="*90 + "\nGENDER interaction check (dedup: AGE + AGExMALE + covariates)\n" + "="*90)
dG = df_dd.copy(); dG['AGE_MALE'] = dG['AGE']*dG['MALE']
s_g = fit_logit(dG, ['AGE','AGE_MALE','INCOME','MALE','BMI','BLACK','HISPANIC'])
summarize(s_g, 'AGE x MALE interaction model')
lr_g = 2*(s_g.llf - m3r.llf); p_g = 1 - stats.chi2.cdf(lr_g, 1)
print(f"LRT AGE x MALE interaction: chi2(1)={lr_g:.3f}, p={p_g:.4f}")

print("\n" + "="*90 + "\nDESCRIPTIVE: savings outcome by age group (dedup)\n" + "="*90)
dD = df_dd.copy()
dD['outcome'] = np.select([dD.DISSAVED==1, dD.SAMESAVE==1], ['dissave','no_change_or_no_savings'], default='save_more')
dD['agegrp'] = pd.cut(dD['AGE'], [23.9,26,28,30,32], labels=['24-26','27-28','29-30','31-32'])
print(pd.crosstab(dD['agegrp'], dD['outcome'], normalize='index').round(4).to_string())
print(); print(pd.crosstab(dD['agegrp'], dD['outcome']).to_string())
print(); print(pd.crosstab([dD['agegrp'], dD['GENDER']], dD['outcome'], normalize='index').round(4).to_string())
