"""
planet_activity_sep: recover the latent summary of each case from obs_0 and predict the
component-A-only future values.
Per-case model (dt = t - reference_epoch_day, weights w = 1/obs_0_err):
    obs_0(t) = offset + b1 sin(2pi dt/P_B) + b2 cos(2pi dt/P_B)
                     + b3 sin(4pi dt/P_B) + b4 cos(4pi dt/P_B)
                     + a1 sin(2pi dt/P_A) + a2 cos(2pi dt/P_A)   [component A, optional]
Nested models compared per case
    M0    background, 2 harmonics, P_B free
    M0h3  background, 3 harmonics, P_B free        (shape-of-background alternative;
          identical in chi2 to "A pinned at P_B/2" because those columns duplicate)
    M1    M0 + component A with free P_A
    M1h3  background 3 harmonics + A free P_A
    M0K   background with K=1..6 harmonics (is the leftover power just background shape?)
Selection of the (P_A, P_B) optimum: the 2-D chi2 surface is multi-modal, so every
distinct local optimum is polished and then ranked by leave-one-segment-out CV across the
observing gaps (~65 d): periods fixed from the full fit, linear coefficients refit on 3/4
of the data.  The winner is the model with the best out-of-sample chi2 (a coherent
component must predict through the gaps; a window alias or a background-shape artefact
cannot).
component_a_present = 1 iff all of:
    dBIC(M1 - M0)   < -10          (A beats background-only)
    dBIC(M1 - M0h3) < -10          (A beats "one extra background harmonic")
    amplitude(A)    > 3 sigma_A    (scaled covariance)
    chi2/dof(M1)    < 1.5          (model is complete: nothing left in the residual)
    CV(M1)          < CV(M0) and CV(M1) < CV(M0h3)   (predicts across the data gaps)
Otherwise 0, with period/basis/future values written as 0.0.
Reports: chi2/dof of every nested model, amplitude of A and its sigma, dBICs,
bootstrap spread of P_A, segment phase scatter, phase uncertainty at the forecast epochs,
alias and Rayleigh separations, residual rms vs quoted errors.
"""
import json
import numpy as np
import pandas as pd
from scipy.optimize import least_squares
IN_DIR, OUT_DIR = "data", "."
DBIC, AMP_SIGMA, CHI2_DOF_MAX, N_BOOT = -10.0, 3.0, 1.5, 300
PB_LO, PB_HI, PA_LO, PA_HI = 6.0, 140.0, 3.0, 200.0
def basis(t, PB, PA=None, nh=2, ref=0.0):
    cols = [np.ones_like(t)]
    for k in range(1, nh + 1):
        ph = 2.0 * np.pi * k * (t - ref) / PB
        cols += [np.sin(ph), np.cos(ph)]
    if PA is not None:
        ph = 2.0 * np.pi * (t - ref) / PA
        cols += [np.sin(ph), np.cos(ph)]
    return np.column_stack(cols)
def wls(X, y, e):
    """Weighted LS by pseudoinverse-based lstsq (safe when columns become degenerate)."""
    Xs, ys = X / e[:, None], y / e
    b, *_ = np.linalg.lstsq(Xs, ys, rcond=None)
    return b, float(np.sum((ys - Xs @ b) ** 2))
def bic(chi2, k, n):
    return chi2 + k * np.log(n)
def grid2d(t, y, e, nh=2, nb=420, na=420, ref=0.0):
    """chi2 on a (P_B x P_A) grid; linear coefs eliminated in closed form."""
    PBg, PAg = np.geomspace(PB_LO, PB_HI, nb), np.geomspace(PA_LO, PA_HI, na)
    ys = y / e
    out = []
    for PB in PBg:
        B = basis(t, PB, None, nh, ref).T / e
        ph = 2.0 * np.pi * (t[None, :] - ref) / PAg[:, None]
        X = np.concatenate([np.repeat(B[None], len(PAg), 0),
                            np.stack([np.sin(ph) / e, np.cos(ph) / e], 1)], 1)
        G = np.einsum('akn,ajn->akj', X, X) + 1e-9 * np.eye(X.shape[1])
        c = np.einsum('akn,n->ak', X, ys)
        b = np.linalg.solve(G, c[:, :, None])[:, :, 0]
        chi = np.sum((ys[None, :] - np.einsum('akn,ak->an', X, b)) ** 2, 1)
        i = int(chi.argmin())
        out.append((float(chi[i]), float(PB), float(PAg[i])))
    out.sort()
    return out
def polish(t, y, e, PB, PA=None, nh=2, ref=0.0):
    def res(p):
        pb = float(np.exp(p[0]))
        pa = float(np.exp(p[1])) if PA is not None else None
        X = basis(t, pb, pa, nh, ref)
        b, _ = wls(X, y, e)
        return (y - X @ b) / e
    p0 = [np.log(PB)] + ([np.log(PA)] if PA is not None else [])
    lo = [np.log(PB_LO)] + ([np.log(PA_LO)] if PA is not None else [])
    hi = [np.log(PB_HI)] + ([np.log(PA_HI)] if PA is not None else [])
    best = None
    for st in (p0, [p + d for p, d in zip(p0, (0.03, -0.03) if len(p0) > 1 else (0.03,))]):
        try:
            r = least_squares(res, st, bounds=(lo, hi), xtol=1e-14, ftol=1e-14, max_nfev=800)
        except Exception:
            continue
        if best is None or r.cost < best.cost:
            best = r
    pb = float(np.exp(best.x[0]))
    pa = float(np.exp(best.x[1])) if PA is not None else None
    X = basis(t, pb, pa, nh, ref)
    b, chi = wls(X, y, e)
    return pb, pa, b, chi
def grid1d(t, y, e, nh=2, n=4000, ref=0.0):
    Pg = np.geomspace(PB_LO, PB_HI, n)
    chi = np.array([wls(basis(t, P, None, nh, ref), y, e)[1] for P in Pg])
    return polish(t, y, e, float(Pg[int(chi.argmin())]), None, nh, ref)
def distinct_optima(t, y, e, grid, T, keep=6, nh=2, ref=0.0):
    """Polish every grid optimum that is separated by >=1 Rayleigh width in both periods."""
    out = []
    for _, PB, PA in grid[:60000]:
        if any(min(abs(1 / PA - 1 / o["PA"]), abs(1 / PA - 1 / o["PA"])) < 1.0 / T
               and abs(1 / PB - 1 / o["PB"]) < 1.0 / T for o in out):
            continue
        pb, pa, b, chi = polish(t, y, e, PB, PA, nh, ref)
        if any(min(abs(1 / pa - 1 / o["PA"]), 1e9) < 0.5 / T and abs(1 / pb - 1 / o["PB"]) < 0.5 / T
               for o in out):
            continue
        out.append(dict(PB=pb, PA=pa, chi2=chi, b=b))
        if len(out) >= keep:
            break
    return out
def cv_segments(t, X, y, e, min_gap=10.0, min_train=12):
    """Leave-one-segment-out CV: periods fixed, linear coefficients refit on the rest."""
    segs = np.split(np.arange(len(t)), np.where(np.diff(t) > min_gap)[0] + 1)
    tot, nte = 0.0, 0
    for s in segs:
        m = np.ones(len(t), bool)
        m[s] = False
        if m.sum() < min_train:
            continue
        b, _ = wls(X[m], y[m], e[m])
        tot += float(np.sum(((y[s] - X[s] @ b) / e[s]) ** 2))
        nte += len(s)
    return tot, nte
def seg_phase(t, y, e, PB, PA, b, ref=0.0, min_n=8):
    segs = np.split(np.arange(len(t)), np.where(np.diff(t) > 10)[0] + 1)
    X = basis(t, PB, None, 2, ref)
    out = []
    for s in segs:
        if len(s) < min_n:
            continue
        r = y[s] - X[s] @ b[:5]
        ph = 2.0 * np.pi * (t[s] - ref) / PA
        Xa = np.column_stack([np.sin(ph), np.cos(ph)]) / e[s][:, None]
        bb = np.linalg.lstsq(Xa, r / e[s], rcond=None)[0]
        out.append(dict(t0=float(t[s].min()), t1=float(t[s].max()), n=int(len(s)),
                        amp=float(np.hypot(*bb)),
                        phase_at_ref=float((np.arctan2(bb[1], bb[0]) % (2 * np.pi)) / (2 * np.pi))))
    scat = float("nan")
    if len(out) >= 2:
        ang = 2 * np.pi * np.array([o["phase_at_ref"] for o in out])
        R = float(np.abs(np.mean(np.exp(1j * ang))))
        scat = float(np.sqrt(-2 * np.log(max(R, 1e-12)))) / (2 * np.pi)
    return out, scat
def fap_null(t, y, e, PB, nh=2, ref=0.0, nsim=400, na=300, seed=7):
    """Simulation FAP of the chi2 gain from adding A under the background-only null."""
    X0 = basis(t, PB, None, nh, ref)
    b0, chi0 = wls(X0, y, e)
    PA = np.geomspace(PA_LO, PA_HI, na)
    obs = chi0 - min(wls(basis(t, PB, p, nh, ref), y, e)[1] for p in PA)
    rng = np.random.default_rng(seed)
    null = []
    for _ in range(nsim):
        ys = X0 @ b0 + rng.normal(0.0, e)
        c0 = wls(X0, ys, e)[1]
        null.append(c0 - min(wls(basis(t, PB, p, nh, ref), ys, e)[1] for p in PA))
    null = np.array(null)
    return float(obs), float((np.sum(null >= obs) + 1) / (nsim + 1)), float(np.percentile(null, 95))
def analyse_case(t, y, e, ref=0.0, tgt_times=(), verbose=True):
    n, T = len(t), float(t.max() - t.min())
    ray = 1.0 / T
    R = {"case": None, "n": n, "span": T, "err_med": float(np.median(e))}
    R["bgK"] = {}
    for K in range(1, 7):
        pb, _, b, chi = grid1d(t, y, e, K, 3000, ref)
        R["bgK"][K] = dict(PB=pb, chi2=chi, k=1 + 2 * K + 1)
    PB0, _, b0, chi0 = R["bgK"][2]["PB"], None, None, None
    PB0, _, b0, chi0 = grid1d(t, y, e, 2, 4000, ref)
    PB03, _, b03, chi03 = grid1d(t, y, e, 3, 4000, ref)
    R["M0"] = dict(PB=PB0, chi2=chi0, k=6, b=b0)
    R["M0h3"] = dict(PB=PB03, chi2=chi03, k=8, b=b03)
    X0 = basis(t, PB0, None, 2, ref)
    R["M0"]["cv"], R["M0"]["cv_n"] = cv_segments(t, X0, y, e)
    R["M0h3"]["cv"], R["M0h3"]["cv_n"] = cv_segments(t, basis(t, PB03, None, 3, ref), y, e)
    cands = distinct_optima(t, y, e, grid2d(t, y, e, 2, 420, 420, ref), T, keep=6, ref=ref)
    for c in cands:
        X = basis(t, c["PB"], c["PA"], 2, ref)
        c["cv"], c["cv_n"] = cv_segments(t, X, y, e)
        c["ampA"] = float(np.hypot(c["b"][-2], c["b"][-1]))
        c["sepB"] = abs(1 / c["PA"] - 1 / c["PB"]) / ray
        c["sepH"] = abs(1 / c["PA"] - 2 / c["PB"]) / ray
        c["bic"] = bic(c["chi2"], 9, n)
    cands.sort(key=lambda c: c["cv"])
    R["cands"] = cands
    best = cands[0]
    PB1, PA1, b1, chi1 = best["PB"], best["PA"], best["b"], best["chi2"]
    pb13, pa13, b13, chi13 = polish(t, y, e, PB03, PA1, 3, ref)
    R["M1h3"] = dict(PB=pb13, PA=pa13, chi2=chi13, k=11)
    X1 = basis(t, PB1, PA1, 2, ref)
    dof1 = n - 9
    scale = max(1.0, chi1 / max(dof1, 1))
    cov = np.linalg.pinv((X1 / e[:, None]).T @ (X1 / e[:, None])) * scale
    ampA = float(np.hypot(b1[5], b1[6]))
    sig_amp = float(np.sqrt(max((b1[5] ** 2 * cov[5, 5] + b1[6] ** 2 * cov[6, 6]) / max(ampA ** 2, 1e-30), 0.0)))
    R["M1"] = dict(PB=PB1, PA=PA1, chi2=chi1, k=9, b=b1, cv=best["cv"], cv_n=best["cv_n"],
                   ampA=ampA, sig_amp=sig_amp, snr=ampA / sig_amp if sig_amp else float("inf"),
                   sepB=best["sepB"], sepH=best["sepH"], scale=scale)
    dB0 = bic(chi1, 9, n) - bic(chi0, 6, n)
    dB03 = bic(chi1, 9, n) - bic(chi03, 8, n)
    cv_ok = best["cv"] < R["M0"]["cv"] and best["cv"] < R["M0h3"]["cv"]
    cond = dict(bic_M0=dB0 < DBIC, bic_M0h3=dB03 < DBIC, amp=ampA > AMP_SIGMA * sig_amp,
                complete=(chi1 / dof1) < CHI2_DOF_MAX, cv=cv_ok)
    R.update(dBIC_M0=dB0, dBIC_M0h3=dB03, cond=cond, present=int(all(cond.values())),
             best_by_bic=min(cands, key=lambda c: c["bic"]) is best)
    if 0 < -dB03 < 25 or 2.0 < ampA / sig_amp < 5.0:
        R["fap"] = fap_null(t, y, e, PB0, 2, ref)
    gaps = np.diff(t)
    big = float(np.sort(gaps)[-1])
    R["max_gap"] = big
    R["aliases"] = []
    for s in (+1, -1):
        f = 1 / PA1 + s / big
        if f <= 0:
            continue
        pa_alias = 1.0 / f
        pb_a, pa_a, _, chi_a = polish(t, y, e, PB1, min(max(pa_alias, PA_LO + 1e-6), PA_HI - 1e-6), 2, ref)
        R["aliases"].append(dict(PA=round(float(pa_alias), 3), P_B=round(pb_a, 3),
                                 chi2=chi_a, dchi2_vs_best=chi_a - chi1))
    R["dBIC_M0_bestA"] = min(bic(c["chi2"], 9, n) for c in cands) - bic(chi0, 6, n)
    R["dBIC_M0h3_bestA"] = min(bic(c["chi2"], 9, n) for c in cands) - bic(chi03, 8, n)
    R["segs"], R["phase_scatter"] = seg_phase(t, y, e, PB1, PA1, b1, ref)
    model = X1 @ b1
    rng = np.random.default_rng(abs(hash((t[0], n))) % (2 ** 31))
    PA_s, PB_s = [], []
    for _ in range(N_BOOT):
        ysim = model + rng.normal(0.0, e)
        try:
            pb, pa, _, _ = polish(t, ysim, e, PB1, PA1, 2, ref)
            if pa and PA_LO < pa < PA_HI:
                PA_s.append(pa); PB_s.append(pb)
        except Exception:
            pass
    if len(PA_s) >= 20:
        PA_s = np.array(PA_s)
        R["boot"] = dict(n=len(PA_s), med=float(np.median(PA_s)), sd=float(np.std(PA_s)),
                         p16=float(np.percentile(PA_s, 16)), p84=float(np.percentile(PA_s, 84)))
        if len(tgt_times):
            std_df = float(np.std(1.0 / PA_s))
            R["boot"]["phase_sd_cycles"] = {float(tt): float(tt * std_df)
                                            for tt in (float(min(tgt_times)), float(max(tgt_times)))}
    R["helper"] = {}
    for ch in ("obs_1", "obs_2"):
        pass
    return R
def channel_ref(t, y, e, ref=0.0):
    """Independent 2-D period fit of a helper channel (consistency check only)."""
    g = grid2d(t, y, e, 2, 260, 260, ref)
    for _, PB, PA in g[:400]:
        pb, pa, b, chi = polish(t, y, e, PB, PA, 2, ref)
        return dict(PB=pb, PA=pa, chi2=chi, ampA=float(np.hypot(b[-2], b[-1])),
                    ampB1=float(np.hypot(b[1], b[2])))
    return {}
def main():
    meta = json.load(open(f"{IN_DIR}/input_0.json"))
    ref = float(meta["reference_epoch_day"])
    cases = list(meta["case_order"])
    obs = pd.read_csv(f"{IN_DIR}/input_1.csv", dtype={"case_id": str})
    raw = [l.strip() for l in open(f"{IN_DIR}/input_2.csv").read().splitlines() if l.strip()]
    hdr2, body = raw[0], raw[1:]
    tgt_rows = [(l.split(",", 1)[0], l.split(",", 1)[1]) for l in body]
    tgt = pd.DataFrame(tgt_rows, columns=["case_id", "time_day"])
    tgt["t"] = tgt["time_day"].astype(float)
    rows, reps = [], []
    for case in cases:
        g = obs[obs.case_id == case].sort_values("time_day")
        t = g.time_day.values.astype(float)
        y = g.obs_0.values.astype(float)
        e = g.obs_0_err.values.astype(float)
        tt = tgt.loc[tgt.case_id == case, "t"].values
        R = analyse_case(t, y, e, ref, tgt_times=tt)
        R["case"] = case
        PB = R["M1"]["PB"] if R["present"] else R["M0"]["PB"]
        PA = R["M1"]["PA"] if R["present"] else None
        X = basis(t, PB, PA, 2, ref)
        b, chi = wls(X, y, e)
        R["final"] = dict(PB=PB, PA=PA, b=b, chi2=chi, k=9 if R["present"] else 5,
                          rms=float(np.std(y - X @ b)))
        for ch in ("obs_1", "obs_2"):
            R.setdefault("helper", {})[ch] = channel_ref(t, g[ch].values.astype(float),
                                                         g[ch + "_err"].values.astype(float), ref)
        reps.append(R)
        rows.append({"case_id": case,
                     "component_a_present": int(R["present"]),
                     "component_a_period_day": float(PA) if R["present"] else 0.0,
                     "component_a_basis1_u0": float(b[5]) if R["present"] else 0.0,
                     "component_a_basis2_u0": float(b[6]) if R["present"] else 0.0,
                     "component_b_period_day": float(PB),
                     "component_b_basis1_u0": float(b[1]), "component_b_basis2_u0": float(b[2]),
                     "component_b_basis3_u0": float(b[3]), "component_b_basis4_u0": float(b[4]),
                     "offset_u0": float(b[0])})
    cols = ["case_id", "component_a_present", "component_a_period_day", "component_a_basis1_u0",
            "component_a_basis2_u0", "component_b_period_day", "component_b_basis1_u0",
            "component_b_basis2_u0", "component_b_basis3_u0", "component_b_basis4_u0", "offset_u0"]
    S = pd.DataFrame(rows, columns=cols)
    S["component_a_present"] = S["component_a_present"].astype(int)
    def fmt(row):
        out = [row["case_id"], str(int(row["component_a_present"]))]
        for k in cols[2:]:
            v = float(row[k])
            assert np.isfinite(v), (row["case_id"], k)
            if v == 0.0 and k in ("component_a_period_day", "component_a_basis1_u0",
                                  "component_a_basis2_u0"):
                out.append("0.0")
            else:
                out.append(f"{v:.12g}")
        return ",".join(out)
    with open(f"{OUT_DIR}/signal_summary.csv", "w") as f:
        f.write(",".join(cols) + "\n")
        for _, row in S.iterrows():
            f.write(fmt(row) + "\n")
    pv = {}
    for _, r in S.iterrows():
        if int(r.component_a_present) == 1:
            ph = 2 * np.pi * (tgt.loc[tgt.case_id == r.case_id, "t"].values - ref) / r.component_a_period_day
            v = r.component_a_basis1_u0 * np.sin(ph) + r.component_a_basis2_u0 * np.cos(ph)
        else:
            v = np.zeros(int((tgt.case_id == r.case_id).sum()))
        for td, vv in zip(tgt.loc[tgt.case_id == r.case_id, "time_day"].values, np.atleast_1d(v)):
            pv[(r.case_id, td)] = float(vv)
    with open(f"{OUT_DIR}/target_predictions.csv", "w") as f:
        f.write("case_id,time_day,component_a_value_u0\n")
        for cid, td in tgt_rows:
            v = pv[(cid, td)]
            f.write(f"{cid},{td},{('0.0' if v == 0.0 else format(v, '.12g'))}\n")
    for R in reps:
        n = R["n"]
        print("\n" + "=" * 100)
        print(f"{R['case']}   n={n}  baseline={R['span']:.1f} d  Rayleigh df=1/T={1/R['span']:.5f} /d  "
              f"max gap={R['max_gap']:.1f} d  median quoted err={R['err_med']:.3f}")
        print("  background-only, K harmonics (tests 'is the leftover power just background shape?'):")
        for K, d in R["bgK"].items():
            print(f"      K={K}: P_B={d['PB']:8.3f} chi2={d['chi2']:9.2f} chi2/dof={d['chi2']/(n-d['k']):6.3f} "
                  f"BIC={bic(d['chi2'],d['k'],n):9.2f}")
        print("  nested models:")
        for key, lab in [("M0", "bg 2h, P_B free      "), ("M0h3", "bg 3h, P_B free      "),
                         ("M1h3", "bg 3h + A free P_A ")]:
            d = R[key]
            print(f"      {lab} P_B={d['PB']:8.3f} chi2={d['chi2']:9.2f} chi2/dof={d['chi2']/(n-d['k']):6.3f} "
                  f"BIC={bic(d['chi2'],d['k'],n):9.2f}" + (f"  P_A={d['PA']:8.3f}" if 'PA' in d else ""))
        m = R["M1"]
        print(f"      bg 2h + A free P_A   P_B={m['PB']:8.3f} P_A={m['PA']:8.3f} chi2={m['chi2']:9.2f} "
              f"chi2/dof={m['chi2']/(n-9):6.3f} BIC={bic(m['chi2'],9,n):9.2f}  [selected]")
        print("      (b) A pinned to P_B/2 is rank-deficient: its columns duplicate the 1st harmonic "
              "-> equals bg 3h, so 'harmonic vs A' can only be settled out-of-sample")
        print("  candidate optima of the 2-D chi2 surface, ranked by leave-one-segment-out CV:")
        for c in R["cands"]:
            print(f"      P_B={c['PB']:8.3f} P_A={c['PA']:8.3f} chi2={c['chi2']:8.2f} "
                  f"CV={c['cv']:8.2f} ({c['cv']/max(c['cv_n'],1):5.2f}/pt) ampA={c['ampA']:6.2f} "
                  f"sep(P_A,P_B)={c['sepB']:5.2f}R sep(P_A,P_B/2)={c['sepH']:5.2f}R")
        print(f"      CV(no A)={R['M0']['cv']:8.2f} ({R['M0']['cv']/R['M0']['cv_n']:5.2f}/pt)   "
              f"CV(bg 3h)={R['M0h3']['cv']:8.2f} ({R['M0h3']['cv']/R['M0h3']['cv_n']:5.2f}/pt)")
        print(f"  component A: amp={m['ampA']:.3f} +/- {m['sig_amp']:.3f} (SNR={m['snr']:.1f}); "
              f"err scale factor={m['scale']:.2f}")
        print(f"  dBIC(M1-M0)={R['dBIC_M0']:9.1f}  dBIC(M1-M0h3)={R['dBIC_M0h3']:9.1f}  "
              f"Rayleigh separations {m['sepB']:.2f}R / {m['sepH']:.2f}R")
        print("  presence conditions " + " ".join(f"{k}={v}" for k, v in R["cond"].items())
              + f"  ->  component_a_present = {R['present']}")
        if "fap" in R:
            print(f"  simulation FAP of the A gain under background-only null: dchi2={R['fap'][0]:.2f} "
                  f"FAP={R['fap'][1]:.4f} (null 95th pct={R['fap'][2]:.2f})")
        print(f"  dBIC using the globally best A instead of the CV-selected one: "
              f"vs M0={R['dBIC_M0_bestA']:.1f}, vs M0h3={R['dBIC_M0h3_bestA']:.1f} (decision unchanged: "
              f"{(R['dBIC_M0_bestA'] < DBIC) == R['cond']['bic_M0']})")
        print(f"  gap aliases of P_A (1/(1/P_A +/- 1/{R['max_gap']:.0f}) d):")
        for a in R["aliases"]:
            print(f"      P_A={a['PA']:8.3f} -> P_B refit={a['P_B']:8.3f} chi2={a['chi2']:8.2f} "
                  f"(+{a['dchi2_vs_best']:.1f} vs chosen; rejected if dBIC={a['dchi2_vs_best']-0:+.1f}>10)")
        if "boot" in R:
            bt = R["boot"]
            print(f"  bootstrap P_A: n={bt['n']} med={bt['med']:.4f} sd={bt['sd']:.4f} "
                  f"p16/84=[{bt['p16']:.4f},{bt['p84']:.4f}]"
                  + (f"  phase sd (cyc) at forecast epochs: "
                     + ", ".join(f"{k:.0f}d:{v:.2f}" for k, v in bt.get("phase_sd_cycles", {}).items()) if bt.get("phase_sd_cycles") else ""))
        for s in R["segs"]:
            print(f"      segment [{s['t0']:6.1f},{s['t1']:6.1f}] n={s['n']:3d} ampA={s['amp']:6.2f} "
                  f"phase@ref={s['phase_at_ref']:.3f} cyc")
        print(f"      segment phase scatter = {R['phase_scatter']:.3f} cyc")
        print(f"  final fit: rms residual={R['final']['rms']:.3f} vs quoted err={R['err_med']:.3f}; "
              f"chi2/dof={R['final']['chi2']/(n-R['final']['k']):.3f}")
        for ch, h in R["helper"].items():
            print(f"  helper {ch} (check only): P_B={h['PB']:8.3f} P_A={h['PA']:8.3f} "
                  f"ampA={h['ampA']:6.2f} ampB1={h['ampB1']:6.2f} chi2/dof={h['chi2']/(n-9):6.2f}")
    print("\n" + "=" * 100)
    print(open("signal_summary.csv").read())
    lines = open("target_predictions.csv").read().splitlines()
    print("\n".join(lines[:6] + ["..."] + lines[-3:]))
    print(f"target rows={len(lines)-1} (input_2 rows={len(tgt_rows)})")
    return S
