# PRE-REGISTERED ONE-SHOT eps calibration. Exact production physics path.
# Rule: candidate eps in order [2.0, 1.5, 2.5]; per candidate, 3 probes at
# T_low=ladder[0], T_mid=ladder[2], T_top=ladder[5]; 20000 steps, save 250,
# seed 555+i, discard first 20% of frames; first candidate whose post-burn-in
# means bracket <Q>=0.5 (in T) is FROZEN and probing stops. If none bracket,
# freeze candidate whose linear-interp root is closest to ladder mid; warn.
import numpy as np, json, time
P=json.load(open('data/parameters.json'))
N=P['n_beads']; X0=np.load('data/target_coords.npy').astype(np.float64)
rc=P['contact_cutoff']; ms=P['min_seq_separation']; dt=P['dt_reduced']; fr=P['friction']
iu=np.triu_indices(N,1); sep=iu[1]-iu[0]
d0=np.linalg.norm(X0[iu[0]]-X0[iu[1]],axis=1)
mask=sep>=ms; cont=mask&(d0<=rc); nonc=mask&~cont
BOND=np.array([[i,i+1] for i in range(N-1)])
CONT=np.vstack([iu[0][cont],iu[1][cont]]).T          # lexicographic (i,j) order
NON=np.vstack([iu[0][nonc],iu[1][nonc]]).T
R0=np.linalg.norm(X0[BOND[:,0]]-X0[BOND[:,1]],axis=1)
RC0=np.linalg.norm(X0[CONT[:,0]]-X0[CONT[:,1]],axis=1)
K_S=10.0; SIG=float(R0.mean()); RREP=1.5*SIG; RCUT=2.0*RC0; EPS_REP=1.0; LAM=1.3
def forces(X,EPS):
    F=np.zeros_like(X)
    d=X[BOND[:,0]]-X[BOND[:,1]]; r=np.linalg.norm(d,axis=1)
    f=(-K_S*(r-R0)/r)[:,None]*d
    np.add.at(F,BOND[:,0],f); np.add.at(F,BOND[:,1],-f)
    d=X[CONT[:,0]]-X[CONT[:,1]]; r=np.linalg.norm(d,axis=1)
    act=r<RCUT; s=np.where(act,RC0/np.where(act,r,1.0),0.0)
    f=(EPS*(60.0*s**12-60.0*s**10)/np.where(act,r,1.0)**2)[:,None]*d
    np.add.at(F,CONT[:,0],f); np.add.at(F,CONT[:,1],-f)
    d=X[NON[:,0]]-X[NON[:,1]]; r=np.linalg.norm(d,axis=1)
    a=r<RREP
    if a.any():
        idx=NON[a]; dd=d[a]; rr=r[a]
        f=(EPS_REP*12.0*(SIG/rr)**12/rr**2)[:,None]*dd
        np.add.at(F,idx[:,0],f); np.add.at(F,idx[:,1],-f)
    return F
def Q(X):
    d=X[CONT[:,0]]-X[CONT[:,1]]; r=np.linalg.norm(d,axis=1)
    x=np.clip((r-RC0)/((LAM-1.0)*RC0),0.0,1.0)
    return float(np.mean(0.5*(1.0+np.cos(np.pi*x))))
def run(T,EPS,nsteps,seed,save=250):
    rng=np.random.default_rng(seed)
    c1=np.exp(-fr*dt); c2=np.sqrt(T*(1-c1*c1))
    X=X0.copy(); V=np.zeros_like(X); Qs=[]
    for s in range(nsteps+1):
        if s%save==0: Qs.append(Q(X))
        if s==nsteps: break
        V=V+0.5*dt*forces(X,EPS); X=X+V*dt
        V=c1*V+c2*rng.standard_normal(X.shape); V=V+0.5*dt*forces(X,EPS)
    Qs=np.array(Qs); return Qs[int(0.2*len(Qs)):].mean()
lad=P['temperature_list']; Ts=[lad[0],lad[2],lad[-1]]
results={}
frozen=None
for EPS in [2.0,1.5,2.5]:
    qs=[run(T,EPS,20000,555+i) for i,T in enumerate(Ts)]
    results[EPS]=qs
    print('eps=%.2f probes T_low=%.3f Q=%.4f | T_mid=%.3f Q=%.4f | T_top=%.3f Q=%.4f'%(
        EPS,Ts[0],qs[0],Ts[1],qs[1],Ts[2],qs[2]),flush=True)
    ok=qs[0]>0.5>qs[2]
    if ok:
        x=Ts; y=np.array(qs); root=None
        for j in range(2):
            if (y[j]-0.5)*(y[j+1]-0.5)<=0 and y[j]!=y[j+1]:
                root=x[j]+(0.5-y[j])*(x[j+1]-x[j])/(y[j+1]-y[j]); break
        frozen=EPS
        print('BRACKETED at eps=%.2f -> predicted T*=%.4f ; FREEZE, stop'%(EPS,root),flush=True)
        break
    else:
        print('not bracketed; trying next candidate',flush=True)
if frozen is None:
    # fallback: closest root to ladder mid
    mid=0.5*(lad[0]+lad[-1]); best=None
    for eps,qs in results.items():
        y=np.array(qs); root=None
        for j in range(len(Ts)-1):
            if (y[j]-0.5)*(y[j+1]-0.5)<=0 and y[j]!=y[j+1]:
                root=Ts[j]+(0.5-y[j])*(Ts[j+1]-Ts[j])/(y[j+1]-y[j]); break
        if root is None:
            k=int(np.argmin(np.abs(y-0.5)))
            if k==0: root=Ts[0]-(y[0]-0.5)*(Ts[1]-Ts[0])/(y[1]-y[0])
            else:   root=Ts[-1]+(0.5-y[-1])*(Ts[-1]-Ts[-2])/(y[-1]-y[-2])
        print('eps=%.2f extrapol root %.4f'%(eps,root))
        if best is None or abs(root-mid)<abs(best[1]-mid): best=(eps,root)
    frozen=best[0]
    print('NO BRACKET: froze eps=%.2f by closest-to-mid rule (warn in production)'%frozen)
json.dump({'probe_temperatures':Ts,'probe_meanQ':{str(k):v for k,v in results.items()},'frozen_eps':frozen},
          open('_calibration/calibration_results.json','w'),indent=1)
print('FROZEN EPS =',frozen)
