    ax2 = AX(px2, py2, pw, ph, 0, 1, 0, H50.max()*1.12)
    for k in range(K):
        xs = ax2.X(binmids); ys = ax2.Y(H50[k])
        for i in range(len(xs)-1): cv.line(xs[i], ys[i], xs[i+1], ys[i+1], PAL[k], 2)
        cv.text(px2+pw-125, py2+12+15*k, f'T={LAD[k]:.2f}', PAL[k], 1)
    panel_title(px2, py2, 'PANEL 2 Q HISTOGRAMS PER T (POST BURN-IN)')
    ax2.ticks(np.linspace(0, 1, 5), np.linspace(0, H50.max(), 4))
    cv.text(px2+pw//2-30, py2+ph+24, 'Q', BLACK, 2)
    # PANEL 3: response curve + Cv + T_star marker
    px3, py3 = 110, 680
    ax3 = AX(px3, py3, pw, ph, tmin-0.02, tmax+0.02, -0.03, 1.03)
    ss = np.linspace(tmin, tmax, 400)
    xs = ax3.X(ss); ys = ax3.Y(PchipInterpolator(LAD, meanQ)(ss))
    for i in range(len(xs)-1): cv.line(xs[i], ys[i], xs[i+1], ys[i+1], BLACK, 2)
    for k in range(K): cv.circle(ax3.X(LAD[k]), ax3.Y(meanQ[k]), 5, BLACK)
    y5 = float(ax3.Y(0.5))
    for xx in range(int(ax3.x), int(ax3.x+ax3.w), 8): cv.line(xx, y5, xx+4, y5, BLACK, 1)
    xt = float(ax3.X(Tstar))
    for yy in range(py3, py3+ph, 8): cv.line(xt, yy, xt, yy+4, RED, 2)
    cv.text(xt+6, py3+16, f'T*={Tstar:.3f}', RED, 2)
    xs2 = ax3.X(fine); yv = ax3.Y(cv_curve/cv_curve.max())
    for i in range(len(xs2)-1): cv.line(xs2[i], yv[i], xs2[i+1], yv[i+1], GREEN, 2)
    xpk = float(ax3.X(T_cvpeak))
    for yy in range(py3, py3+ph, 8): cv.line(xpk, yy, xpk, yy+4, GREEN, 1)
    cv.text(ax3.x+10, py3+ph-24, 'GREEN=CV RESCALED  DASH=T*  DOTS=CV PEAK', GREEN, 1)
    panel_title(px3, py3, 'PANEL 3 RESPONSE <Q>(T), CV, T* MARKER')
    ax3.ticks(np.linspace(tmin, tmax, 5), np.linspace(0, 1, 5))
    cv.text(px3+pw//2-30, py3+ph+24, 'T', BLACK, 2)
    cv.text(px3-100, py3+ph//2, '<Q>', BLACK, 2)
    # PANEL 4: F(Q) at T_star
    px4, py4 = 860, 680
    ax4 = AX(px4, py4, pw, ph, 0, 1, -0.05, max(F_prof.max()*1.15, 0.1)+0.05)
    xs = ax4.X(prof_centers); ys = ax4.Y(F_prof)
    for i in range(len(xs)-1): cv.line(xs[i], ys[i], xs[i+1], ys[i+1], BLUE, 2)
    for m in prim_modes:
        xm = float(ax4.X(m))
        for yy in range(py4, py4+ph, 8): cv.line(xm, yy, xm, yy+4, RED, 2)
        cv.text(min(xm+5, px4+pw-70), py4+6, f'MODE Q={m:.3f}', RED, 1)
    if saddle_q is not None:
        xsm = float(ax4.X(saddle_q))
        for yy in range(py4, py4+ph, 8): cv.line(xsm, yy, xsm, yy+4, BLACK, 1)
        cv.text(min(xsm+5, px4+pw-90), py4+20, f'SADDLE Q={saddle_q:.3f}', BLACK, 1)
    else:
        cv.text(px4+8, py4+ph-16, 'SADDLE: N/A (SINGLE MODE)', BLACK, 1)
    panel_title(px4, py4,
        f'PANEL 4 F(Q) AT T*={Tstar:.3f}  BARRIER={prim_bar:.2f} KT  MODES='+
        ','.join(f'{m:.2f}' for m in prim_modes))
    ax4.ticks(np.linspace(0, 1, 5), np.linspace(0, max(F_prof.max(), 0.1), 4))
    cv.text(px4+pw//2-30, py4+ph+24, 'Q', BLACK, 2)
    cv.text(px4-110, py4+ph//2, 'F(Q)/KT', BLACK, 2)
    cv.save('visualization.png')
    print('saved visualization.png (4 panels via pure-numpy raster fallback)')

