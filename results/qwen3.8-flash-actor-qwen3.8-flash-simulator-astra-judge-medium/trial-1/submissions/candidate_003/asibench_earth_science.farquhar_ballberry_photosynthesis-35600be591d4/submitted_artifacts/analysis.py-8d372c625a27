#!/usr/bin/env python3
"""
Leaf physiological response reconstruction:
CLM/Noah-MP-style Farquhar(C3)/Collatz(C4) + Ball-Berry coupled fixed point.

Six explicitly agreed conventions (researcher-approved; assumed readings of
the task's stated convention, not independently verified facts):

(1) TEST CASES ARE SOLVED FOR THE SUNLIT SIDE (par_sun_wm2 of the indexed
    row). test_cases.json does not state the leaf side and the
    case_convergence.csv schema has no room for two variants. The SHADE
    variant (par_shade_wm2) of every case is printed to stdout; if both
    solutions land on the same Ci the assumption is immaterial and this is
    stated explicitly.

(2) RESPIRATION SCALES WITH CAPACITY: Rd = 0.015 * Vcmax(T) * n_factor * btran,
    i.e. AFTER the n_factor*btran multiplication -- the same Vcmax_eff that
    enters Wc and We (the C4 Wj term has no capacity factor). Both readings
    (scaled / unscaled Rd) are printed for night rows.

(3) NIGHT = FULL DIFFUSION CHAIN with respiratory flux:
    A = -Rd, gs = b0 exactly (no clipping applied to the night gs),
    cs = ca - 1.37*rb*A_mol*P/cf, rs = cf/gs,
    Ci = cs - 1.65*rs*A_mol*P/cf.  "Ci = cs literally" is NOT used.
    There is no division by A anywhere.  Twilight rows carrying
    floating-point residue PAR (~2e-13 W/m2 from the sinusoidal forcing) are
    classified as night via PAR <= 1e-6 W/m2 and reported.  The gs/cs/Ci
    clamps (gs>=1e-6, cs>=1e-3, Ci>=1e-3) are pure zero-protection; their
    trigger counts are reported.

(4) CONVERGENCE: iterate until step |Ci_new - Ci| < 1e-6 Pa (max 200 iters,
    midpoint damping on sign reversal of the step), then VERIFY the residual:
    re-run the full cycle at the accepted Ci and require
    |Ci_eval - Ci| < 1e-4 Pa and |A_eval - A| < 1e-6.  Worst residuals over
    the 120 rows and 5 cases are printed.  n_iterations = iteration number on
    which the step criterion was met (else MAX_IT + stderr warning).
    Start-independence (all five ci_init values + the 0.8*ca row start land on
    the same Ci) is an explicit printed test.

(5) KEY/CONSTANT READINGS: bb_slope -> m, bb_intercept -> b0,
    Q10 (2.1, 1.2, 2.4) -> (Kc, Ko, Vcmax and Rd), Tleaf = Tair,
    APAR = 4.6*PAR with no extra absorptance factor, hard min() without
    curvature theta.  Vcmax(T) at 281.5 K is NOT clipped; btran is clipped to
    [0,1] only if out of range (it is not in these data).

(6) FIGURE: two stacked panels sharing the x-axis (time_hr 0-119):
    top = A_sun, A_shade (umol CO2 m-2 s-1); bottom = rs_sun, rs_shade (s/m);
    legend and units in axis labels; night hours lightly shaded so the
    day/night discontinuity is visible, not smoothed.  No case-start markers.
"""
import os
import sys
import json
import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:                       # fallback renderer uses PIL
    HAVE_MPL = False

R = 8.314            # J mol-1 K-1
GS_MIN = 1e-6        # mol m-2 s-1  zero-protection floor
CI_MIN = 1e-3        # Pa            zero-protection floor
CS_MIN = 1e-3        # Pa            zero-protection floor
NIGHT_PAR = 1e-6     # W m-2         PAR <= this counts as dark
TOL_STEP = 1e-6      # Pa            fixed-point step criterion
TOL_RES = 1e-4       # Pa            final residual criterion
TOL_A = 1e-6         # umol m-2 s-1  final residual criterion on A
MAX_IT = 200

clip_counts = {"gs": 0, "ci": 0, "cs": 0}
run_warnings = []

# ------------------------------------------------------------------ physics
def esat_bolton(T_K):
    """Bolton (1980) saturation vapour pressure over water [Pa].
    Water (not ice): whole forcing range 281.5-293.5 K is above 0 C."""
    T = T_K - 273.15
    return 611.2 * np.exp(17.67 * T / (T + 243.5))

def vcmax_T(vcmax25, T_K):
    """CLM/Noah-MP Q10 response with high-temperature inhibition.
    No low-temperature clipping (agreed item 5)."""
    Tc = T_K - 273.15
    hi = 1.0 + np.exp((-2.2e5 + 710.0 * (Tc + 273.16)) / (R * (Tc + 273.16)))
    return vcmax25 * 2.4 ** ((Tc - 25.0) / 10.0) / hi

class Leaf:
    """One leaf (sun or shade) in one forcing row: environment + capacity."""
    def __init__(self, par, row, p):
        T = float(row["t_air_K"]); P = float(row["p_atm_Pa"])
        self.T, self.P = T, P
        self.ca = float(row["co2_pa"]); self.o2 = float(row["o2_pa"])
        self.rb = float(row["rb_sm"])
        self.par = float(par)
        self.cf = P / (R * T)                    # links gs [mol] to rs [s/m]
        es = esat_bolton(T)
        self.h_s = min(max(1.0 - float(row["vpd_Pa"]) / es, 0.25), 1.0)
        bt = min(max(float(row["btran"]), 0.0), 1.0)
        Vc_raw = vcmax_T(p["vcmax25"], T)        # Vcmax(T) unscaled
        self.V_raw = Vc_raw
        self.V = Vc_raw * p["n_factor"] * bt     # Vcmax_eff (agreed item 2)
        self.Rd = 0.015 * self.V                 # scaled   (used everywhere)
        self.Rd_unscaled = 0.015 * Vc_raw        # unscaled (diagnostic only)
        dT = (T - 298.15) / 10.0
        self.Kc = 30.0 * 2.1 ** dT               # Q10 = 2.1
        self.Ko = 30000.0 * 1.2 ** dT            # Q10 = 1.2
        self.Gamma = 0.5 * (self.Kc / self.Ko) * self.o2   # unused for C4
        self.m = p["m"]; self.b0 = p["b0"]       # bb_slope, bb_intercept
        self.pathway = p["pathway"].upper()
        self.J = p["alpha_q"] * 4.6 * self.par   # APAR = 4.6*PAR, linear J
        self.night = self.par <= NIGHT_PAR       # agreed item 3

    def assim(self, Ci):
        """A [umol CO2 m-2 s-1] at Ci [Pa]; hard min(), no theta (item 5)."""
        Ci = max(Ci, 0.0)
        if self.night:                           # respiratory assimilation
            return -self.Rd
        if self.pathway == "C4":                 # Collatz land-surface form
            Wc = self.V
            Wj = self.J
            We = 4000.0 * self.V * Ci / self.P
        else:                                    # Farquhar C3
            Wc = self.V * (Ci - self.Gamma) / (Ci + self.Kc * (1.0 + self.o2 / self.Ko))
            Wj = self.J * (Ci - self.Gamma) / (4.0 * Ci + 8.0 * self.Gamma)
            We = 0.5 * self.V
        return min(Wc, Wj, We) - self.Rd

    def cycle(self, Ci):
        """One full coupled cycle at given Ci.  A in umol; A_mol = A*1e-6 in
        diffusion terms; cs, Ci in Pa; gs mol m-2 s-1; rs s m-1.
        There is no division by A anywhere (item 3)."""
        A = self.assim(Ci)
        A_mol = A * 1e-6
        cs = self.ca - 1.37 * self.rb * A_mol * self.P / self.cf
        if cs < CS_MIN:
            cs = CS_MIN; clip_counts["cs"] += 1
        if self.night:                           # night gs is exactly b0,
            gs = self.b0                         # unclipped (agreed item 3)
        else:
            gs = self.m * A_mol * self.h_s / cs * self.P + self.b0
            if gs < GS_MIN:                      # zero-protection only
                gs = GS_MIN; clip_counts["gs"] += 1
        rs = self.cf / gs
        Ci_new = cs - 1.65 * rs * A_mol * self.P / self.cf
        if Ci_new < CI_MIN:
            Ci_new = CI_MIN; clip_counts["ci"] += 1
        return {"A": A, "A_mol": A_mol, "cs": cs, "gs": gs, "rs": rs,
                "Ci_new": Ci_new}

    def solve(self, ci0):
        """Coupled fixed point from ci0.  Step criterion, damping, then
        residual verification (agreed item 4)."""
        if self.night:                           # closed form, no iteration
            out = self.cycle(self.ca)
            return dict(out, Ci=out["Ci_new"], n_iter=0, converged=True,
                        res_Ci=0.0, res_A=0.0)
        Ci = max(float(ci0), CI_MIN)
        prev_step = Ci_prev = None
        n_used, converged = MAX_IT, False
        for it in range(1, MAX_IT + 1):
            out = self.cycle(Ci)
            step = out["Ci_new"] - Ci
            if prev_step is not None and step * prev_step < 0.0:
                Ci_next = 0.5 * Ci + 0.5 * out["Ci_new"]   # midpoint damping
            else:
                Ci_next = out["Ci_new"]
            if abs(Ci_next - Ci) < TOL_STEP:
                Ci_prev = Ci
                Ci = Ci_next; n_used, converged = it, True
                break
            prev_step = step
            Ci = Ci_next
        if not converged:
            run_warnings.append(
                f"fixed point did not converge in {MAX_IT} iterations "
                f"(par={self.par:.3g} W/m2, T={self.T:.2f} K)")
        ev = self.cycle(Ci)                      # residual check on accepted Ci
        res_Ci = abs(ev["Ci_new"] - Ci)
        # small-step check on A: assimilation change across the final step
        res_A = 0.0 if Ci_prev is None else abs(self.assim(Ci) - self.assim(Ci_prev))
        return dict(ev, Ci=Ci, n_iter=n_used, converged=converged,
                    res_Ci=res_Ci, res_A=res_A)

# ------------------------------------------------------------------- figure
LAST_RENDERER = None

def build_figure(x, a_sun, a_shade, rs_sun, rs_shade, night_mask, path):
    """Two stacked panels sharing x: top A_sun/A_shade, bottom rs_sun/rs_shade,
    night hours shaded (agreed item 6).  matplotlib if available, else PIL,
    else a dependency-free PNG renderer with the same layout."""
    global LAST_RENDERER
    if HAVE_MPL:
        LAST_RENDERER = "matplotlib"
        fig, (ax1, ax2) = plt.subplots(2, 1, sharex=True, figsize=(11, 7))
        for ax in (ax1, ax2):
            for h, nm in zip(x, night_mask):
                if nm:
                    ax.axvspan(h - 0.5, h + 0.5, color="0.9", zorder=0)
        ax1.plot(x, a_sun, "-o", ms=3, label="A_sun")
        ax1.plot(x, a_shade, "-s", ms=3, label="A_shade")
        ax1.set_ylabel("Assimilation A [umol CO$_2$ m$^{-2}$ s$^{-1}$]")
        ax1.legend(); ax1.grid(alpha=0.3)
        ax2.plot(x, rs_sun, "-o", ms=3, label="rs_sun")
        ax2.plot(x, rs_shade, "-s", ms=3, label="rs_shade")
        ax2.set_xlabel("time_hr [h]")
        ax2.set_ylabel("Resistance rs [s m$^{-1}$]")
        ax2.legend(); ax2.grid(alpha=0.3)
        fig.suptitle("Coupled Farquhar/Collatz + Ball-Berry: diurnal "
                     "sun/shade responses (shaded bands = night)")
        fig.tight_layout()
        fig.savefig(path, dpi=150)
        plt.close(fig)
        return
    have_pil = False
    try:
        import PIL.Image                              # noqa: F401
        have_pil = True
    except Exception:
        try:                                          # system dist-packages
            sys.path.append("/usr/lib/python3/dist-packages")
            import PIL.Image                          # noqa: F401
            have_pil = True
        except Exception:
            have_pil = False
    if have_pil:
        LAST_RENDERER = "PIL"
        _plot_pil(x, a_sun, a_shade, rs_sun, rs_shade, night_mask, path)
    else:
        LAST_RENDERER = "built-in PNG (no matplotlib/PIL in this env)"
        _plot_raw(x, a_sun, a_shade, rs_sun, rs_shade, night_mask, path)

def _png_write(path, W, H, buf):
    import zlib, struct
    raw = b"".join(b"\x00" + bytes(buf[r * W * 3:(r + 1) * W * 3])
                   for r in range(H))
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9))
           + chunk(b"IEND", b""))
    open(path, "wb").write(png)

def _nice_ticks(vmin, vmax, n=6):
    import math
    if vmax <= vmin:
        vmax = vmin + 1.0
    raw = (vmax - vmin) / max(n - 1, 1)
    mag = 10.0 ** math.floor(math.log10(raw))
    step = 10.0 * mag
    for m in (1.0, 2.0, 2.5, 5.0, 10.0):
        if raw <= m * mag:
            step = m * mag
            break
    start = math.floor(vmin / step) * step
    stop = math.ceil(vmax / step) * step
    ticks, v = [], start
    while v <= stop + 0.5 * step:
        ticks.append(v); v += step
    return start, stop, ticks

