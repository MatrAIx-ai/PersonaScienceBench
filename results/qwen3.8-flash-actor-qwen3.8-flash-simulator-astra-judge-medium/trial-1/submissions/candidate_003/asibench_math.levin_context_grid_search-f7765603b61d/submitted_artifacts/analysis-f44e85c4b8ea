import json, math
from analysis import make_policy

tr = json.load(open("data/training_levels.json"))
pol = make_policy(tr)

def check(probs, legal, tag):
    assert isinstance(probs, dict), tag
    keys = set(probs.keys())
    assert keys == set(legal) | (keys - set(legal)) and set(legal) <= keys, (tag, keys, legal)
    vals = [probs[a] for a in legal]
    assert all(isinstance(v, float) and v >= 0 and math.isfinite(v) for v in vals), (tag, vals)
    s = sum(probs.values())
    assert abs(s - 1.0) < 1e-9, (tag, s)
    assert all(v > 0 for v in probs.values()), (tag, "zero mass")

# --- degenerate / adversarial states (fix #3) --------------------------------
cases = [
    ({}, ["U","D","L","R"]),
    ({"previous_action": None}, ["U","D"]),
    ({"legal_mask": {"U": "#", "D": "#"}}, ["R"]),                  # mask contradicts legal_actions
    ({"previous_action": "U", "history_tail": ["U","U"]}, ["L"]),   # single legal (only reverse? no: L), straight blocked
    ({"previous_action": "D", "history": [{"action":"D"},{"action":"D"}]}, ["U","L","R"]),  # forced turn, reverse legal
    ({"previous_action": "X", "history_tail": "UU"}, ["U","R"]),    # garbage field types
    ({"history": []}, ["D"]),
    ({"previous_action": "U"}, ["D"]),                               # ONLY reverse legal (dead end)
    (None, ["U","D","L","R"]),
]
for st, legal in cases:
    p = pol.action_probs({"id":"x"}, st, legal)
    check(p, legal, f"case {st} {legal}")
print("degenerate-state tests: PASS (%d cases; sums=1, nonneg, positive)" % len(cases))

# normalization independence of |legal_actions| (fix #2): straight mass stable
for legal in (["U"], ["U","L"], ["U","L","R"], ["U","D","L","R"]):
    p = pol.action_probs({}, {"previous_action":"U"}, legal)
    print("  |legal|=%d  P(straight)=%.4f  sum=%.6f  min=%.1e" % (len(legal), p["U"], sum(p.values()), min(p.values())))

# --- next-action accuracy on train, by category -------------------------------
MOV = {"U":(-1,0),"D":(1,0),"L":(0,-1),"R":(0,1)}
OPP = {"U":"D","D":"U","L":"R","R":"L"}
def legal(grid,r,c):
    R,C=len(grid),len(grid[0]); out=[]
    for a,(dr,dc) in MOV.items():
        nr,nc=r+dr,c+dc
        if 0<=nr<R and 0<=nc<C and grid[nr][nc]!="#": out.append(a)
    return out
cat = {"first":[0,0], "straight":[0,0], "turn_forced":[0,0], "turn_ambiguous":[0,0]}
for lv in tr["levels"]:
    g, s = lv["grid"], lv["solution"]; r,c = lv["start"]; hist=[]; prev=None
    for a in s:
        la = legal(g,r,c)
        p = pol.action_probs({"id":lv["id"]}, {"previous_action":prev,"history":hist[:],"legal_actions":la}, la)
        pred = max(la, key=lambda x:(p[x], -list("UDLR").index(x)))
        if prev is None: k="first"
        elif prev in la: k="straight"
        else:
            others=[x for x in la if x!=OPP[prev]]
            k = "turn_ambiguous" if len(others)>1 else "turn_forced"
        cat[k][0]+= (pred==a); cat[k][1]+=1
        hist.append(a); prev=a
        r+=MOV[a][0]; c+=MOV[a][1]
tot_n=sum(v[1] for v in cat.values()); tot_c=sum(v[0] for v in cat.values())
print("\nnext-action accuracy on training replay:")
for k,(ok,n) in cat.items(): print("  %-14s %5d/%5d = %.3f" % (k, ok, n, ok/n))
print("  %-14s %5d/%5d = %.3f" % ("OVERALL", tot_c, tot_n, tot_c/tot_n))
