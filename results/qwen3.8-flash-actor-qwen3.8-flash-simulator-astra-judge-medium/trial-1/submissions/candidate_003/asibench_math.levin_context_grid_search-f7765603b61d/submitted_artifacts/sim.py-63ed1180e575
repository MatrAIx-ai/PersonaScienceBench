"""Search simulation for analysis.py on the public levels, two regimes:
   A) priority best-first with priority = cumulative -sum(log P) (count pops as expansions)
   B) greedy argmax rollout (deterministic, no backtracking)
Grid is read ONLY by the simulator (the scorer's role); the policy gets local fields only."""
import json, heapq, math
from analysis import make_policy

MOV = {"U":(-1,0),"D":(1,0),"L":(0,-1),"R":(0,1)}
BUDGET = json.load(open("data/public_eval_levels.json")).get("budget", 95)

tr = json.load(open("data/training_levels.json"))
ev = json.load(open("data/public_eval_levels.json"))
pol = make_policy(tr)

def legal(g, r, c):
    R, C = len(g), len(g[0]); out = []
    for a, (dr, dc) in MOV.items():
        nr, nc = r+dr, c+dc
        if 0 <= nr < R and 0 <= nc < C and g[nr][nc] != "#":
            out.append(a)
    return out

def mk_state(r, c, prev, hist):
    la = legal(g_cur, r, c)
    run = 1
    for a in reversed(hist[:-1]):
        if a == hist[-1] if hist else False: run += 1
        else: break
    return {"cell": g_cur[r][c],
            "previous_action": prev,
            "history": list(hist), "history_tail": list(hist[-8:]),
            "run_length_bucket": min(run // 5, 5),
            "depth": len(hist), "depth_mod": len(hist) % 4, "depth_phase": len(hist) % 3,
            "legal_actions": la,
            "legal_mask": {a: (g_cur[r+MOV[a][0]][c+MOV[a][1]] if a in la else "#") for a in MOV}}

def best_first(lv):
    global g_cur
    g_cur = lv["grid"]; start = tuple(lv["start"]); goal = tuple(lv["goal"])
    # node: (neg_logp, tiebreak, r, c, prev, hist)
    h0 = []; prev0 = None
    p0 = pol.action_probs({"id": lv["id"]}, mk_state(*start, prev0, h0), legal(g_cur, *start))
    counter = 0
    heap = [(0.0, counter, start[0], start[1], None, ())]
    best = {}
    expansions = 0; branches = 0
    while heap:
        nlp, _, r, c, prev, hist = heapq.heappop(heap)
        key = (r, c)
        if key in best and best[key] <= nlp + 1e-12:
            continue
        best[key] = nlp
        expansions += 1
        st = mk_state(r, c, prev, list(hist))
        la = legal(g_cur, r, c)
        probs = pol.action_probs({"id": lv["id"]}, st, la)
        if max(probs.values()) < 0.9:
            branches += 1
        if (r, c) == goal:
            return expansions, branches, len(hist), nlp, "goal"
        if len(hist) >= lv["max_depth"]:
            continue
        for a in la:
            nr, nc = r+MOV[a][0], c+MOV[a][1]
            heapq.heappush(heap, (nlp - math.log(probs[a]), (counter := counter+1), nr, nc, a, hist+(a,)))
    return expansions, branches, None, None, "exhausted"

def greedy(lv):
    global g_cur
    g_cur = lv["grid"]; r, c = lv["start"]; goal = tuple(lv["goal"])
    hist = []; prev = None; branches = 0
    for step in range(lv["max_depth"]+1):
        if (r, c) == goal:
            return step, branches, "goal"
        la = legal(g_cur, r, c)
        st = mk_state(r, c, prev, hist)
        probs = pol.action_probs({"id": lv["id"]}, st, la)
        if max(probs.values()) < 0.9:
            branches += 1
        a = max(la, key=lambda x: (probs[x], -list("UDLR").index(x)))
        r += MOV[a][0]; c += MOV[a][1]; hist.append(a); prev = a
    return None, branches, "depth-exceeded"

print(f"budget = {BUDGET} (per-level assumption; see report)")
print(f"{'level':<12}{'maxD':>5} | {'BF exp':>7} {'BF br':>6} {'BF depth':>8} {'ok':>4} | {'gr steps':>8} {'gr br':>5} {'ok':>14}")
for lv in ev["levels"]:
    e, b, d, _, s1 = best_first(lv)
    gs, gb, s2 = greedy(lv)
    print(f"{lv['id']:<12}{lv['max_depth']:>5} | {e:>7} {b:>6} {str(d):>8} {s1:>4} | {str(gs):>8} {gb:>5} {s2:>14}")
