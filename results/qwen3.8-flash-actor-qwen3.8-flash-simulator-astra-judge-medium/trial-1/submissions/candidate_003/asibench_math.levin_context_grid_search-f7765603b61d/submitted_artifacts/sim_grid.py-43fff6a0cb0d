import json, heapq, math, random, statistics
from analysis import make_policy

MOV = {"U":(-1,0),"D":(1,0),"L":(0,-1),"R":(0,1)}
tr = json.load(open("data/training_levels.json"))
ev = json.load(open("data/public_eval_levels.json"))

def legal(g,r,c):
    R,C=len(g),len(g[0]); out=[]
    for a,(dr,dc) in MOV.items():
        nr,nc=r+dr,c+dc
        if 0<=nr<R and 0<=nc<C and g[nr][nc]!="#": out.append(a)
    return out

def bf(lv,pol):
    g=lv["grid"]; start=tuple(lv["start"]); goal=tuple(lv["goal"]); ctr=0
    heap=[(0.0,0,start[0],start[1],None,())]; best={}; exp=0
    while heap:
        nlp,_,r,c,prev,hist=heapq.heappop(heap)
        if (r,c) in best and best[(r,c)]<=nlp+1e-12: continue
        best[(r,c)]=nlp; exp+=1
        if (r,c)==goal: return exp, len(hist)
        if len(hist)>=lv["max_depth"]: continue
        la=legal(g,r,c)
        st={"previous_action":prev,"history":list(hist),"legal_actions":la}
        pr=pol.action_probs({"id":0},st,la)
        for a in la:
            ctr+=1
            heapq.heappush(heap,(nlp-math.log(pr[a]),ctr,r+MOV[a][0],c+MOV[a][1],a,hist+(a,)))
    return exp, None

random.seed(0)
train_sample = random.sample(tr["levels"], 60)
grids = [("public", lv) for lv in ev["levels"]] + [("train", lv) for lv in train_sample]
configs = [
    ("T=1.00 (calibrated)", 1.0),
    ("T=0.70", 0.7),
    ("T=0.50", 0.5),
    ("T=0.30", 0.3),
    ("T=0.15", 0.15),
]
print(f"{'config':<22}{'pub exp':<24}{'pub<=95':<9}{'train mean':<11}{'train med':<10}{'train<=95'}")
for name,T in configs:
    pol = make_policy(tr, {"turn_temperature": T})
    pub=[]; tre=[]
    for kind,lv in grids:
        e,d = bf(lv,pol)
        (pub if kind=="public" else tre).append(e)
    print(f"{name:<22}{str(pub):<24}{sum(e<=95 for e in pub)}{'':<6}{statistics.mean(tre):<11.1f}{statistics.median(tre):<10.0f}{sum(e<=95 for e in tre)}/60")
