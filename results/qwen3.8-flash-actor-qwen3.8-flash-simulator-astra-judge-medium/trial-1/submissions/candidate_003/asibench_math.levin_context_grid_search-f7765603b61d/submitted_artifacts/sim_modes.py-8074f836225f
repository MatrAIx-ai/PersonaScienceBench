import json, heapq, math, random
from analysis import make_policy
MOV={"U":(-1,0),"D":(1,0),"L":(0,-1),"R":(0,1)}
tr=json.load(open('data/training_levels.json')); ev=json.load(open('data/public_eval_levels.json'))
def legal(g,r,c):
    R,C=len(g),len(g[0]); out=[]
    for a,(dr,dc) in MOV.items():
        nr,nc=r+dr,c+dc
        if 0<=nr<R and 0<=nc<C and g[nr][nc]!="#": out.append(a)
    return out
def policy_dfs(lv,pol):
    g=lv["grid"]; goal=tuple(lv["goal"]); exp=0
    visited={tuple(lv["start"])}
    def rec(r,c,prev,hist):
        nonlocal exp
        exp+=1
        if (r,c)==goal: return True
        if len(hist)>=lv["max_depth"]: return False
        la=legal(g,r,c)
        pr=pol.action_probs({"id":0},{"previous_action":prev,"history":list(hist),"legal_actions":la},la)
        for a in sorted(la,key=lambda x:-pr[x]):
            nr,nc=r+MOV[a][0],c+MOV[a][1]
            if (nr,nc) in visited: continue
            visited.add((nr,nc))
            if rec(nr,nc,a,hist+(a,)): return True
        return False
    ok=rec(lv["start"][0],lv["start"][1],None,())
    return exp, ok
def beam(lv,pol,w=3):
    g=lv["grid"]; goal=tuple(lv["goal"]); exp=0
    beaml=[(0.0,tuple(lv["start"]),None,())]
    seen={tuple(lv["start"])}
    while beaml:
        beaml.sort(key=lambda x:x[0])
        nxt=[]
        for nlp,(r,c),prev,hist in beaml:
            exp+=1
            if (r,c)==goal: return exp, True
            if len(hist)>=lv["max_depth"]: continue
            la=legal(g,r,c)
            pr=pol.action_probs({"id":0},{"previous_action":prev,"history":list(hist),"legal_actions":la},la)
            for a in la:
                nr,nc=r+MOV[a][0],c+MOV[a][1]
                if (nr,nc) in seen: continue
                seen.add((nr,nc))
                nxt.append((nlp-math.log(pr[a]),(nr,nc),a,hist+(a,)))
        beaml=nxt[:w]
    return exp, False
pol=make_policy(tr)
print("policy-ordered DFS (backtracking, actions sorted by P):")
for lv in ev["levels"]:
    e,ok=policy_dfs(lv,pol); print(f"  {lv['id']}: expansions={e} ok={ok} budget95={'PASS' if ok and e<=95 else 'FAIL'}")
print("beam width 3:")
for lv in ev["levels"]:
    e,ok=beam(lv,pol,3); print(f"  {lv['id']}: expansions={e} ok={ok} budget95={'PASS' if ok and e<=95 else 'FAIL'}")
random.seed(1); samp=random.sample(tr['levels'],25)
dfs_exp=[policy_dfs(l,pol)[0] for l in samp]; bm_exp=[beam(l,pol,3)[0] for l in samp]
print("train sample(25): DFS mean exp %.1f max %d; beam3 mean %.1f max %d; <=95: DFS %d/25 beam %d/25"%(
 sum(dfs_exp)/25,max(dfs_exp),sum(bm_exp)/25,max(bm_exp),sum(e<=95 for e in dfs_exp),sum(e<=95 for e in bm_exp)))
