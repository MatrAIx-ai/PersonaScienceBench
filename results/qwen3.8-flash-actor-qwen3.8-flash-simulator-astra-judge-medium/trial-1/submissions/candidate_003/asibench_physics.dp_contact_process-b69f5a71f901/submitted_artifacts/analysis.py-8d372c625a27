#!/usr/bin/env python3
"""
xp1_5_system: asymmetric parity-modulated nearest-neighbor birth-death process
(1D lattice). Threshold + scaling analysis under the finite protocol in
./data/task_input.json.

Pre-registered (before computation) decision criteria, fixed at plan approval:
  rho_ss rule : mean of rho(t) over sweeps 751..1000 (last 25% of t_max),
                IDENTICAL for every lambda and every L. rho_ss=0 allowed.
  lambda_c(L) : linear interpolation of the LAST bracketed crossing of
                p_surv(lambda, t_max) with 0.5 inside the lambda grid. No
                extrapolation outside [1.71, 1.805]; if not bracketed ->
                recorded as "not bracketed", excluded from the mean.
  lambda_c_estimate : plain mean of bracketed per-L crossings (NO L->inf fit).
  rho-curve crossing : sign change of rho_ss(L_small)-rho_ss(L_large) on the
                lambda grid (secondary static signal).
  static_evidence_consistent = (L=32 shows intermediate survival regime: some
                lambda with 0.15 <= p_surv(t_max) <= 0.85) AND >= 2 sizes
                bracket lambda_c AND spread of bracketed lambda_c(L) <= 0.05.
  beta : log-log fit rho_ss(lambda, L=256) ~ (lambda - lambda_c)^beta over the
                three beta_fit_lambdas. Bootstrap CI over seeds with lambda_c
                resampled inside each replicate.
  tau_half(L) : first time mean p_surv(t) <= 0.5 (interpolated) at the scan
                lambda closest to lambda_c; needs a bracketed crossing.
  dynamic_scale_observed = tau_half defined for >= 3 sizes, monotone in L,
                log-log slope in [1.0, 2.2].
  collapse : at lambda nearest lambda_c, scaled axes rho(t)*t^theta vs t/L^z
                with theta = beta/nu_perp_ref, nu_perp_ref = 1.0968 (EXTERNAL
                DP reference, not a measurement). z scanned on [0.8, 3.0]
                step 0.02. collapse_success = >=3 sizes with live curves AND
                interior z optimum AND binned RMSE (rho units) <= 0.02 AND
                RMSE <= 0.5 * raw (unrescaled) RMSE.
  universality_supported = static_evidence_consistent AND beta CI covers 0.2765
                AND dynamic_scale_observed AND collapse_success AND z covers
                1.581 +- 0.3.
  conclusion = "consistent_with_directed_percolation" only if
                static_evidence_consistent AND universality_supported; else
                "inconclusive".
"""
import json
import os
import time

import numpy as np
import pandas as pd

T0 = time.time()
ROOT = os.path.dirname(os.path.abspath(__file__))
INP = os.path.join(ROOT, "data", "task_input.json")
RES = os.path.join(ROOT, "results")
os.makedirs(RES, exist_ok=True)


def log(msg):
    print(f"[{time.time() - T0:8.1f}s] {msg}", flush=True)


with open(INP, encoding="utf-8-sig") as fh:
    cfg = json.load(fh)
proto = cfg["protocol"]          # strict: the six fields live exactly here
pars = cfg["parameterization"]   # model kernel parameters live in this block

task_id = cfg["task_id"]
LAMBDAS = [float(v) for v in proto["lambda_scan"]]
BETA_LAMS = [float(v) for v in proto["beta_fit_lambdas"]]
SIZES = [int(v) for v in proto["system_sizes"]]
N_SEEDS = int(proto["n_seeds"])
T_MAX = int(proto["t_max"])
ROOT_SEED = int(proto["seed"])

DT = float(pars["dt"])
W_LEFT = float(pars["left_neighbor_weight"])
W_RIGHT = float(pars["right_neighbor_weight"])
PAR_EVEN = float(pars["site_parity_scale"]["even"])
PAR_ODD = float(pars["site_parity_scale"]["odd"])
assert pars["boundary_condition"] == "periodic"
assert pars["update_scheme"] == "random_sequential"
assert pars["initial_condition"] == "fully_active_for_each_trajectory"

WIN_LO = T_MAX - (T_MAX // 4)          # rho_ss window: sweeps 751..1000
NU_PERP_REF = 1.0968                   # EXTERNAL DP reference (literature)
DP_BETA_REF = 0.2765
DP_Z_REF = 1.5806

log(f"input: lambdas={LAMBDAS} sizes={SIZES} n_seeds={N_SEEDS} "
    f"t_max={T_MAX} seed={ROOT_SEED} dt={DT} w=({W_LEFT},{W_RIGHT}) "
    f"parity=({PAR_EVEN},{PAR_ODD})")


def run_size(L):
    """Batch all (lambda, seed) trajectories of one lattice size L.

    Batching is only over INDEPENDENT trajectories; inside a trajectory the
    update is strictly sequential random-sequential: L visits per sweep, each
    visit picks one site uniformly, active -> dies with prob DT, inactive ->
    born with prob min(1, lambda*DT*parity(i)*(W_LEFT*x[i-1]+W_RIGHT*x[i+1])),
    periodic boundaries. Repeated visits of one site within a sweep are
    allowed and processed sequentially (part of the kernel).
    """
    rng = np.random.default_rng([ROOT_SEED, L])
    nl = len(LAMBDAS)
    n = nl * N_SEEDS
    lam_dt = np.repeat(np.asarray(LAMBDAS) * DT, N_SEEDS)   # (n,)
    x = np.ones((n, L), dtype=np.int8)                      # fully active IC
    counts = np.full(n, L, dtype=np.int64)
    parity = np.where(np.arange(L) % 2 == 0, PAR_EVEN, PAR_ODD)
    rho_hist = np.zeros((T_MAX, n), dtype=np.float32)
    surv_hist = np.zeros((T_MAX, n), dtype=bool)
    for t in range(T_MAX):
        if counts.max() == 0:
            break  # fully absorbing; remaining rows stay zero
        sites = rng.integers(0, L, size=L)
        ru_d = rng.random((L, n))
        ru_b = rng.random((L, n))
        for v in range(L):
            i = int(sites[v])
            il = L - 1 if i == 0 else i - 1
            ir = 0 if i == L - 1 else i + 1
            act = x[:, i] == 1
            dm = act & (ru_d[v] < DT)
            rate = lam_dt * parity[i] * (W_LEFT * x[:, il] + W_RIGHT * x[:, ir])
            np.minimum(rate, 1.0, out=rate)
            b = (~act) & (ru_b[v] < rate)
            if dm.any():
                x[dm, i] = 0
                counts[dm] -= 1
            if b.any():
                x[b, i] = 1
                counts[b] += 1
        rho_hist[t] = counts / L
        surv_hist[t] = counts > 0
    shape = (T_MAX, nl, N_SEEDS)
    return rho_hist.reshape(shape), surv_hist.reshape(shape)


rho_all, surv_all = {}, {}
for L in SIZES:
    r, s = run_size(L)
    rho_all[L], surv_all[L] = r, s
    log(f"L={L:4d} done: mean p_surv(t_max) per lambda = "
        f"{np.round(s[-1].mean(axis=1), 3).tolist()}")

# ------------------------------------------------------------- quantities --
# rho_ss: window mean per trajectory, then mean over seeds (same rule all L)
rho_win_traj = {L: rho_all[L][WIN_LO:, :, :].mean(axis=0) for L in SIZES}  # (nl,ns)
rho_ss = {L: rho_win_traj[L].mean(axis=1) for L in SIZES}                   # (nl,)
p_surv_T = {L: surv_all[L][-1, :, :].mean(axis=1) for L in SIZES}           # (nl,)

for L in SIZES:
    log(f"L={L:4d} p_surv(t_max)={np.round(p_surv_T[L], 3).tolist()}")
    log(f"L={L:4d} rho_ss       ={np.round(rho_ss[L], 4).tolist()}")


def last_bracketed_crossing(p, thr=0.5):
    """Last crossing p[i] < thr <= p[i+1] inside the lambda grid; else None."""
    res = None
    for i in range(len(LAMBDAS) - 1):
        if p[i] < thr <= p[i + 1]:
            res = (LAMBDAS[i] + (thr - p[i]) * (LAMBDAS[i + 1] - LAMBDAS[i])
                   / (p[i + 1] - p[i]))
    return res


lam_c_by_L = {L: last_bracketed_crossing(p_surv_T[L]) for L in SIZES}
bracketed = {L: v for L, v in lam_c_by_L.items() if v is not None}
lam_c_est = float(np.mean(list(bracketed.values()))) if bracketed else None
log(f"lambda_c by size: { {k: (round(v,4) if v else v) for k,v in lam_c_by_L.items()} }"
    f"  -> estimate={lam_c_est}")

rho_cross = {}
pairs = [(a, b) for ia, a in enumerate(SIZES) for b in SIZES[ia + 1:]]
for a, b in pairs:
    d = rho_ss[a] - rho_ss[b]
    pts = []
    for i in range(len(LAMBDAS) - 1):
        if d[i] == 0 or d[i] * d[i + 1] < 0:
            if d[i] == d[i + 1]:
                continue
            frac = d[i] / (d[i] - d[i + 1])
            pts.append(float(LAMBDAS[i] + frac * (LAMBDAS[i + 1] - LAMBDAS[i])))
    rho_cross[f"{a}/{b}"] = pts if pts else None
log(f"rho-curve crossings: { {k: ([round(x,4) for x in v] if v else None) for k,v in rho_cross.items()} }")

L_MIN = SIZES[0]
intermediate = bool(np.any((p_surv_T[L_MIN] >= 0.15) & (p_surv_T[L_MIN] <= 0.85)))
log(f"intermediate regime at L={L_MIN}: {intermediate}")

# --------------------------------------------------------------- bootstrap -
rng_boot = np.random.default_rng([ROOT_SEED, 777])
B = 400
lam_c_boot, beta_boot = [], []
L_BETA = SIZES[-1]  # L=256: the (only) large size beta can rest on


def fit_beta(lam_use, y, lc):
    xs, ys = [], []
    for lam, rho in zip(lam_use, y):
        if lam > lc and rho > 0:
            xs.append(np.log(lam - lc))
            ys.append(np.log(rho))
    if len(xs) < 3:
        return None
    return float(np.polyfit(xs, ys, 1)[0])


def boot_replicate():
    lam_vals, rho_star = [], {}
    for L in SIZES:
        idx = rng_boot.integers(0, N_SEEDS, size=(len(LAMBDAS), N_SEEDS))
        p_arr = np.array([surv_all[L][-1, i, idx[i]].mean()
                          for i in range(len(LAMBDAS))])
        c = last_bracketed_crossing(p_arr)
        if c is not None:
            lam_vals.append(c)
        rho_star[L] = np.array([rho_win_traj[L][i, idx[i]].mean()
                                for i in range(len(LAMBDAS))])
    if len(lam_vals) < 2:
        return None, None
    lc = float(np.mean(lam_vals))
    b = fit_beta(BETA_LAMS, [rho_star[L_BETA][LAMBDAS.index(l)] for l in BETA_LAMS], lc)
    return lc, b


for _ in range(B):
    lc_s, b_s = boot_replicate()
    if lc_s is not None:
        lam_c_boot.append(lc_s)
        if b_s is not None and np.isfinite(b_s) and abs(b_s) < 50:
            beta_boot.append(b_s)

lam_c_boot = np.array(lam_c_boot)
beta_boot = np.array(beta_boot)
lam_ci = ((float(np.percentile(lam_c_boot, 2.5)), float(np.percentile(lam_c_boot, 97.5)))
          if len(lam_c_boot) >= 50 else (None, None))
# L=32-only bootstrap (the size whose threshold the budget can resolve at all)
rng32 = np.random.default_rng([ROOT_SEED, 778])
lam32_boot = []
for _ in range(B):
    idx = rng32.integers(0, N_SEEDS, size=(len(LAMBDAS), N_SEEDS))
    p_arr = np.array([surv_all[L_MIN][-1, i, idx[i]].mean()
                      for i in range(len(LAMBDAS))])
    c = last_bracketed_crossing(p_arr)
    if c is not None:
        lam32_boot.append(c)
lam32_boot = np.array(lam32_boot)
lam_ci_L32 = ((float(np.percentile(lam32_boot, 2.5)),
               float(np.percentile(lam32_boot, 97.5)))
              if len(lam32_boot) >= 50 else (None, None))
log(f"bootstrap valid={len(lam_c_boot)}/{B}; lambda_c CI={lam_ci}; "
    f"L32-only valid={len(lam32_boot)}/{B}, CI={lam_ci_L32}")

beta_est, beta_ci, beta_diag = None, (None, None), None
if lam_c_est is not None:
    beta_est = fit_beta(BETA_LAMS,
                        [rho_ss[L_BETA][LAMBDAS.index(l)] for l in BETA_LAMS],
                        lam_c_est)
    if beta_est is None:
        # fewer than 3 fit points above the estimated threshold: report raw values
        beta_diag = ("beta not identifiable: lambda_c_estimate="
                     f"{round(lam_c_est, 4)} leaves fewer than 3 of "
                     f"beta_fit_lambdas={BETA_LAMS} above threshold; raw "
                     f"rho_ss(L=256) at fit lambdas = "
                     f"{[round(float(rho_ss[L_BETA][LAMBDAS.index(l)]), 4) for l in BETA_LAMS]}"
                     " (flat to decreasing within 16-seed noise; no supercritical"
                     " density plateau is resolved in this window).")
    else:
        beta_ci = ((float(np.percentile(beta_boot, 2.5)),
                    float(np.percentile(beta_boot, 97.5)))
                   if len(beta_boot) >= 50 else (None, None))
        if beta_est <= 0:
            beta_diag = ("conditional beta from data is non-positive "
                         f"({round(beta_est, 3)}): rho_ss does not grow with "
                         "lambda at L=256 within noise -> no reliable positive"
                         " beta; CI not reported to avoid overclaiming.")
            beta_ci, beta_est = (None, None), None
log(f"beta estimate (L={L_BETA}) = {beta_est}; diag={beta_diag}")

# plateau diagnostic: relative change of mean rho(t) across the rho_ss window
plateau = {}
tt_w = np.arange(WIN_LO, T_MAX)
for L in SIZES:
    plateau[L] = {}
    for l in BETA_LAMS:
        k = LAMBDAS.index(l)
        m = rho_all[L][WIN_LO:, k, :].mean(axis=1)
        plateau[L][str(l)] = float(np.polyfit(tt_w, m, 1)[0] * len(tt_w)
                                   / max(m.mean(), 1e-12))
log(f"plateau diagnostics (relative window slope): "
    f"{ {str(k): {kk: round(vv,4) for kk,vv in v.items()} for k,v in plateau.items()} }")

# ------------------------------------------------------- dynamic quantities
lam_star = (min(LAMBDAS, key=lambda v: abs(v - lam_c_est))
            if lam_c_est is not None else None)

tau_half = {}
if lam_star is not None:
    k = LAMBDAS.index(lam_star)
    for L in SIZES:
        p = surv_all[L][:, k, :].mean(axis=1)
        th = None
        for t in range(1, T_MAX):
            if p[t] <= 0.5 < p[t - 1]:
                th = t - 1 + (p[t - 1] - 0.5) / (p[t - 1] - p[t])
                break
        tau_half[L] = th
log(f"tau_half at lambda*={lam_star}: { {str(k): (round(v,1) if v else v) for k,v in tau_half.items()} }")

tau_defined = {L: v for L, v in tau_half.items() if v is not None}
tau_slope, mono = None, False
if len(tau_defined) >= 3:
    ls = sorted(tau_defined)
    mono = all(tau_defined[ls[i]] < tau_defined[ls[i + 1]] for i in range(len(ls) - 1))
    tau_slope = float(np.polyfit(np.log(ls), np.log([tau_defined[L] for L in ls]), 1)[0])
dynamic_scale_observed = bool(len(tau_defined) >= 3 and mono and
                              tau_slope is not None and 1.0 <= tau_slope <= 2.2)
log(f"tau_half: defined={len(tau_defined)}, monotone={mono}, slope={tau_slope}"
    f" -> dynamic_scale_observed={dynamic_scale_observed}")

# ------------------------------------------------------------- data collapse
collapse_success = False
z_used, z_theta, rmse_sc, rmse_raw0, n_collapse = None, None, None, None, 0
if lam_star is not None and beta_est is not None and np.isfinite(beta_est):
    theta = float(beta_est) / NU_PERP_REF
    k = LAMBDAS.index(lam_star)
    tt = np.arange(10, T_MAX + 1, dtype=float)
    curves = {L: rho_all[L][9:, k, :].mean(axis=1) for L in SIZES}
    usable = {L: c for L, c in curves.items() if c.max() > 1e-6 and c[-1] > 1e-6}
    n_collapse = len(usable)

    def scaled_rmse(theta_v, z_v, nb=16):
        xs, ys, tags = [], [], []
        for L, c in usable.items():
            y = c * tt ** theta_v
            xq = tt / L ** z_v
            xs.append(xq); ys.append(y); tags.append(np.full(len(tt), L))
        if not xs:
            return None
        xs, ys, tags = np.concatenate(xs), np.concatenate(ys), np.concatenate(tags)
        edges = np.linspace(xs.min(), xs.max(), nb + 1)
        b = np.clip(np.digitize(xs, edges) - 1, 0, nb - 1)
        gsum, gcnt = np.zeros(nb), np.zeros(nb)
        np.add.at(gsum, b, ys); np.add.at(gcnt, b, 1)
        fbin = gsum / np.where(gcnt > 0, gcnt, np.nan)
        devs = []
        for L in usable:
            m = tags == L
            s1 = np.zeros(nb); c1 = np.zeros(nb); yb = np.zeros(nb)
            np.add.at(s1, b[m], xs[m]); np.add.at(c1, b[m], 1)
            np.add.at(yb, b[m], ys[m])
            with np.errstate(invalid="ignore", divide="ignore"):
                xb = s1 / np.where(c1 > 0, c1, np.nan)
                ybm = yb / np.where(c1 > 0, c1, np.nan)
                denom = (xb * L ** z_v) ** theta_v if theta_v != 0 else 1.0
                obsL = ybm / denom
                fL = fbin / denom
            d = (obsL - fL)[np.isfinite(obsL) & np.isfinite(fL) & (c1 > 0)]
            # scale-free comparison: also express residual vs local curve spread
            devs.append(d)
        if not devs:
            return None
        r = np.concatenate(devs)
        return float(np.sqrt(np.mean(r ** 2))) if len(r) else None

    raw_rmse = scaled_rmse(0.0, 0.0)
    best = (np.inf, None)
    for z_v in np.arange(0.8, 3.001, 0.02):
        rr = scaled_rmse(theta, float(z_v))
        if rr is not None and rr < best[0]:
            best = (rr, float(z_v))
    rmse_sc, z_used = best
    rmse_raw0 = raw_rmse
    interior = z_used is not None and 0.8 < z_used < 3.0
    collapse_success = bool(n_collapse >= 3 and interior and rmse_sc is not None
                            and rmse_sc <= 0.02 and raw_rmse is not None
                            and rmse_sc <= 0.5 * raw_rmse)
    z_theta = theta
log(f"collapse: sizes={n_collapse} theta={z_theta} z={z_used} rmse={rmse_sc} "
    f"raw={rmse_raw0} -> collapse_success={collapse_success}")

# ------------------------------------------------------------------ bools --
spread = (max(bracketed.values()) - min(bracketed.values())
          if len(bracketed) >= 2 else None)
static_ok = bool(intermediate and len(bracketed) >= 2
                 and spread is not None and spread <= 0.05)
beta_covers = bool(beta_ci[0] is not None and beta_ci[1] is not None
                   and beta_ci[0] <= DP_BETA_REF <= beta_ci[1])
z_covers = bool(z_used is not None and abs(z_used - DP_Z_REF) <= 0.3)
universality = bool(static_ok and beta_covers and dynamic_scale_observed
                    and collapse_success and z_covers)
conclusion = ("consistent_with_directed_percolation"
              if (static_ok and universality) else "inconclusive")
log(f"bools: static={static_ok} (spread={spread}, intermediate={intermediate}), "
    f"dyn={dynamic_scale_observed}, collapse={collapse_success}, "
    f"beta_covers={beta_covers}, z_covers={z_covers}, universality={universality}, "
    f"conclusion={conclusion}")

# delta_estimate: mean ABSOLUTE distance of the beta_fit_lambdas from the
# estimated threshold (unsigned; documented definition)
delta_est = (float(np.mean([abs(l - lam_c_est) for l in BETA_LAMS]))
             if lam_c_est is not None else None)

# ------------------------------------------------------------------- files -
summary = pd.DataFrame([{
    "task_id": task_id,
    "lambda_c_estimate": lam_c_est,
    "lambda_c_ci_low": lam_ci[0],
    "lambda_c_ci_high": lam_ci[1],
    "beta_estimate": beta_est,
    "beta_ci_low": beta_ci[0],
    "beta_ci_high": beta_ci[1],
    "delta_estimate": delta_est,
    "z_estimate": z_used if collapse_success else None,
    "n_seeds": N_SEEDS,
    "t_max": T_MAX,
    "collapse_success": collapse_success,
}])
summary.to_csv(os.path.join(RES, "dp_summary.csv"), index=False)

rows = []
for L in SIZES:
    for i, lam in enumerate(LAMBDAS):
        rows.append({"lambda": lam, "system_size": L,
                     "rho_ss": float(rho_ss[L][i]),
                     "survival_prob": float(p_surv_T[L][i]),
                     "n_runs": int(N_SEEDS)})
pd.DataFrame(rows, columns=["lambda", "system_size", "rho_ss",
                            "survival_prob", "n_runs"]) \
    .to_csv(os.path.join(RES, "dp_scan.csv"), index=False)

ts = []
for L in SIZES:
    for i, lam in enumerate(LAMBDAS):
        ts.append(pd.DataFrame({
            "lambda": lam, "system_size": L,
            "time": np.arange(1, T_MAX + 1),
            "rho": np.round(rho_all[L][:, i, :].mean(axis=1), 6),
            "survival_prob": np.round(surv_all[L][:, i, :].mean(axis=1), 4)}))
pd.concat(ts).to_csv(os.path.join(RES, "dp_timeseries.csv"), index=False)


def jnum(v):
    if v is None or isinstance(v, (int, str, bool)):
        return v
    if isinstance(v, np.generic):
        v = v.item()
    if isinstance(v, (np.floating, np.integer)):
        v = v.item()
    return None if isinstance(v, float) and not np.isfinite(v) else v


note = (
    "Weakly resolved dynamic window: t_max=1000 sweeps is shorter than the "
    "expected critical relaxation L^z (z~1.58) for L=128 (~2100) and L=256 "
    "(~6400). beta rests on the single large size L=256 and only three "
    "beta_fit_lambdas; systematic error in lambda_c transits directly into "
    "beta, and the rho_ss window (sweeps 751-1000) is not a guaranteed "
    f"plateau at L=256 (window relative slopes: {plateau.get(L_BETA)}). "
    "At t_max=1000 the p_surv=0.5 crossing is bracketed by the lambda grid "
    "only for L=32 (L>=64 survival is saturated high across the whole grid, "
    "so their effective crossings lie outside/below the grid at this time "
    "and finite-size drift of the effective crossing is strong; no L->inf "
    "extrapolation was attempted). "
    "nu_perp=1.0968 and DP beta=0.2765, z=1.581 are EXTERNAL literature "
    "references used only as comparison targets, not measurements. "
    "lambda_c CI caveat: the bootstrap CI of the mean-of-bracketed-crossings "
    "estimator can fall below the point estimate because in some replicates "
    "L>=64 also yields a (much lower) bracketed crossing; this reflects the "
    "strong finite-size drift, not a coding artifact. An L=32-only bootstrap "
    "CI is reported separately in evidence. "
    "lambda_c(L) crossings drift: "
    f"{ {str(k): (round(v,4) if v is not None else 'not bracketed') for k,v in lam_c_by_L.items()} }; "
    f"tau_half: { {str(k): jnum(v) for k,v in tau_half.items()} }. "
    "All decision criteria were fixed before computation (see method_summary)."
)
report = {
    "task_id": task_id,
    "model": ("1D asymmetric parity-modulated nearest-neighbor birth-death "
              "process: periodic BC, random-sequential updates (sweep = L "
              "random site visits), fully active initial condition, active "
              "site dies with p=dt=0.2 per visit, inactive site i born with "
              "p=min(1, lambda*dt*parity(i)*(1.0*left+0.85*right)), parity "
