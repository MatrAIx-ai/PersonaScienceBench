class Canvas:
    """Minimal RGB raster with lines, dots and a 5x7 bitmap font."""

    def __init__(self, w, h):
        self.buf = np.full((h, w, 3), 255, np.uint8)
        self.w, self.h = w, h

    def px(self, x, y, c):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.w and 0 <= y < self.h:
            self.buf[y, x] = c

    def line(self, x0, y0, x1, y1, c=(0, 0, 0), t=1):
        x0, y0, x1, y1 = float(x0), float(y0), float(x1), float(y1)
        n = int(max(abs(x1 - x0), abs(y1 - y0), 1))
        xs = np.linspace(x0, x1, n + 1)
        ys = np.linspace(y0, y1, n + 1)
        for x, y in zip(xs, ys):
            for dy in range(t):
                for dx in range(t):
                    self.px(x + dx, y + dy, c)

    def dot(self, x, y, c, r=2):
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                if dx * dx + dy * dy <= r * r:
                    self.px(x + dx, y + dy, c)

    def rect(self, x0, y0, x1, y1, c, alpha=1.0):
        x0, x1 = sorted((int(x0), int(x1))); y0, y1 = sorted((int(y0), int(y1)))
        x0, x1 = max(0, x0), min(self.w, x1); y0, y1 = max(0, y0), min(self.h, y1)
        if x1 > x0 and y1 > y0:
            reg = self.buf[y0:y1, x0:x1].astype(np.float32)
            self.buf[y0:y1, x0:x1] = np.clip(reg * (1 - alpha) + np.array(c) * alpha, 0, 255).astype(np.uint8)

    def text(self, x, y, s, c=(0, 0, 0), scale=2):
        cx = int(x)
        for ch in str(s).upper():
            g = _GLYPHS.get(ch, _GLYPHS[" "])
            for r, bits in enumerate(g):
                for col in range(5):
                    if bits & (1 << (4 - col)):
                        self.rect(cx + col * scale, int(y) + r * scale,
                                  cx + (col + 1) * scale, int(y) + (r + 1) * scale, c)
            cx += 6 * scale
        return cx

    def save_png(self, path):
        import struct, zlib
        raw = b"".join(b"\x00" + self.buf[i].tobytes() for i in range(self.h))
        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data
                    + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
        png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", self.w, self.h, 8, 2, 0, 0, 0))
               + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))
        with open(path, "wb") as fh:
            fh.write(png)


class MiniAx:
    """Simple data->pixel axes on a Canvas."""

    def __init__(self, cv, box, xlim, ylim, title="", xl="", yl=""):
        self.cv = cv
        self.x0, self.y0, self.x1, self.y1 = box
        self.xlim, self.ylim = xlim, ylim
        cv.rect(self.x0, self.y0, self.x1, self.y1, (245, 245, 245))
        cv.line(self.x0, self.y0, self.x1, self.y0, (0, 0, 0))
        cv.line(self.x1, self.y0, self.x1, self.y1, (0, 0, 0))
        cv.line(self.x1, self.y1, self.x0, self.y1, (0, 0, 0))
        cv.line(self.x0, self.y1, self.x0, self.y0, (0, 0, 0))
        cv.text(self.x0 + 4, self.y0 - 20, title, (0, 0, 0), 2)
        cv.text((self.x0 + self.x1) / 2 - 4 * len(xl), self.y1 + 26, xl, (0, 0, 0), 2)
        for k, v in enumerate(np.linspace(xlim[0], xlim[1], 5)):
            xx = self.X(v)
            cv.line(xx, self.y0, xx, self.y0 + 4, (90, 90, 90))
            cv.text(xx - 3 * len(f"{v:g}"), self.y0 + 6, f"{v:g}", (60, 60, 60), 1)
        for k, v in enumerate(np.linspace(ylim[0], ylim[1], 5)):
            yy = self.Y(v)
            cv.line(self.x1 - 4, yy, self.x1, yy, (90, 90, 90))
            cv.text(self.x0 - 8 - 6 * len(f"{v:.3g}"), yy - 4, f"{v:.3g}", (60, 60, 60), 1)
        if yl:
            self._vtext(self.x0 - 14 - 8 * len(yl), (self.y0 + self.y1) / 2, yl)

    def _vtext(self, x, y, s):
        for k, ch in enumerate(str(s).upper()):
            self.cv.text(x, y - 40 + k * 13, ch, (0, 0, 0), 2)

    def X(self, v):
        a, b = self.xlim
        return self.x0 + (np.asarray(v, float) - a) / (b - a) * (self.x1 - self.x0)

    def Y(self, v):
        a, b = self.ylim
        return self.y1 - (np.asarray(v, float) - a) / (b - a) * (self.y1 - self.y0)

    def plot(self, xs, ys, c, t=1):
        xs, ys = np.asarray(xs, float), np.asarray(ys, float)
        for i in range(len(xs) - 1):
            self.cv.line(self.X(xs[i]), self.Y(ys[i]), self.X(xs[i + 1]), self.Y(ys[i + 1]), c, t)

    def scat(self, xs, ys, c, r=2):
        for x, y in zip(self.X(xs), self.Y(ys)):
            self.cv.dot(x, y, c, r)

    def hline(self, v, c, dash=0):
        y = self.Y(v)
        if dash:
            for x in range(int(self.x0), int(self.x1), dash * 2):
                self.cv.line(x, y, min(x + dash, self.x1), y, c)
        else:
            self.cv.line(self.x0, y, self.x1, y, c)

    def vline(self, v, c, t=1):
        x = self.X(v)
        self.cv.line(x, self.y0, x, self.y1, c, t)

    def vband(self, v0, v1, c, alpha=0.18):
        self.cv.rect(self.X(v0), self.y0, self.X(v1), self.y1, c, alpha)

    def bars(self, xs, hs, w, c, base=0.0):
        for xv, hv in zip(xs, hs):
            self.cv.rect(self.X(xv - w / 2), self.Y(base), self.X(xv + w / 2), self.Y(hv), c, 0.75)

    def legend(self, entries, x=None, y=None):
        x = self.x0 + 10 if x is None else x
        y = self.y0 + 14 if y is None else y
        for k, (c, lab) in enumerate(entries):
            self.cv.rect(x, y + 14 * k, x + 14, y + 14 * k + 6, c)
            self.cv.text(x + 20, y + 14 * k, lab, (0, 0, 0), 1)



