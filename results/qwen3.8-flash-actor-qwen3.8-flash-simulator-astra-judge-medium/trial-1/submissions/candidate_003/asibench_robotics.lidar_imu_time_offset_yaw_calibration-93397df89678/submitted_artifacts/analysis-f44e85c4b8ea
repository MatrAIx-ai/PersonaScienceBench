#!/usr/bin/env python3
"""
Multi-Sensor Motion Record Audit: lidar <-> IMU-gyro joint calibration.

Model
-----
Gyro measurement model (convention, see CONVENTIONS below):
    omega_meas(t) = omega_true(t) + gyro_bias            [rad/s]
Lidar scan-match i is reported on the lidar clock over [t0_i, t1_i]; the true
angular displacement over that interval is obtained by integrating the
bias-corrected gyro on the *gyro* clock:
    dpsi_i(tau, b) = int_{t0_i + tau}^{t1_i + tau} (omega_meas(t) - b) dt

Yaw extrinsic: the displacement reported by scan matching is mapped into the
body frame by p_body = R(+yaw_extrinsic) * p_lidar.  The robot's motion
direction (non-holonomic forward axis) is the body x-axis, so the body
y-component of the measured step must vanish -> that lateral component is the
translation residual that constrains yaw_extrinsic.

CONVENTIONS (NOT defined by data/task_info.json -- fixed assumptions, also
written to metrics.json; a generator using the opposite sign convention would
differ only in sign, the magnitudes being the fitted quantities):
  (1) gyro_bias_rad_s   : measurement = truth + bias
  (2) time_offset_s     : t_gyro = t_lidar + time_offset  (integrate [t0+tau, t1+tau])
  (3) yaw_extrinsic_rad : p_body = R(+yaw_extrinsic) * p_lidar

Fitting uses ONLY rows with split == 'train'.  Held-out rows are used only for
diagnostic residuals and metrics.  Angular residuals are wrapped to [-pi, pi).
"""

import json
import numpy as np
import pandas as pd
from scipy.interpolate import CubicSpline
from scipy.optimize import least_squares
from scipy import stats

try:                      # preferred renderer if the runtime provides it
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:         # fallback pure-numpy PNG writer is used instead
    HAVE_MPL = False

RNG = np.random.default_rng(7)
DATA, OUT = "data", "."

imu = pd.read_csv(f"{DATA}/imu_gyro.csv")
lm = pd.read_csv(f"{DATA}/lidar_scan_matches.csv")
seg = pd.read_csv(f"{DATA}/segment_windows.csv")
task = json.load(open(f"{DATA}/task_info.json"))

t_imu = imu["imu_time_s"].to_numpy()
w_imu = imu["omega_z_rad_s"].to_numpy()
t0 = lm["t0_lidar_s"].to_numpy()
t1 = lm["t1_lidar_s"].to_numpy()
dx = lm["dx_lidar_m"].to_numpy().copy()   # writable copy (pandas returns read-only views)
dy = lm["dy_lidar_m"].to_numpy().copy()   # writable copy (pandas returns read-only views)
dyaw = lm["dyaw_lidar_rad"].to_numpy().copy()   # writable copy (pandas returns read-only views)
sig_t = lm["sigma_trans_m"].to_numpy()
sig_y = lm["sigma_yaw_rad"].to_numpy()
scan_id = lm["scan_id"].to_numpy()
split = lm["split"].to_numpy()
tr = split == "train"
ho = split == "heldout"
dt_scan = t1 - t0


def wrap_pi(a):
    """Wrap to [-pi, pi)."""
    return (a + np.pi) % (2.0 * np.pi) - np.pi


cs = CubicSpline(t_imu, w_imu, extrapolate=True)
CS = cs.antiderivative()


def yaw_increment(tau, bias, a, b_):
    return (CS(b_ + tau) - CS(a + tau)) - bias * (b_ - a)


def predict(theta, mask):
    bias, tau, ext = theta
    dpsi = yaw_increment(tau, bias, t0[mask], t1[mask])
    lat = -np.sin(ext) * dx[mask] + np.cos(ext) * dy[mask]   # body-y step (should be ~0)
    fwd = np.cos(ext) * dx[mask] + np.sin(ext) * dy[mask]    # body-x step
    return dpsi, lat, fwd


def residuals(theta, idx):
    bias, tau, ext = theta
    dpsi, lat, _ = predict(theta, idx)
    return np.concatenate([wrap_pi(dyaw[idx] - dpsi) / sig_y[idx], lat / sig_t[idx]])


def jac_fun(theta, idx):
    bias, tau, ext = theta
    idx = np.flatnonzero(idx) if isinstance(idx, np.ndarray) and idx.dtype == bool else idx
    d_dt = dt_scan[idx]
    dw = cs(t1[idx] + tau) - cs(t0[idx] + tau)
    n = len(idx)
    J_yaw = np.empty((n, 3))
    J_yaw[:, 0] = d_dt / sig_y[idx]          # d r_yaw / d bias
    J_yaw[:, 1] = -dw / sig_y[idx]           # d r_yaw / d tau
    J_yaw[:, 2] = 0.0
    J_lat = np.zeros((n, 3))
    J_lat[:, 2] = (-np.cos(ext) * dx[idx] - np.sin(ext) * dy[idx]) / sig_t[idx]
    return np.vstack([J_yaw, J_lat])


def fit(idx, x0, loss="linear", f_scale=1.0):
    return least_squares(residuals, x0, args=(idx,), jac=jac_fun, method="trf",
                         loss=loss, f_scale=f_scale, x_scale=[1e-2, 1e-2, 1e-2],
                         xtol=1e-15, ftol=1e-15, gtol=1e-15, max_nfev=400)


def profile_tau(tau, idx):
    """SSE at fixed tau with bias AND ext re-optimised (closed forms), i.e. a proper
    profile likelihood over tau (bias/tau collinearity handled by profiling, not prior)."""
    rr = dyaw[idx] - (CS(t1[idx] + tau) - CS(t0[idx] + tau))
    # closed-form weighted LS for the (linear) bias: b = sum(rr*dt/s^2) / sum(dt^2/s^2)
    wt = dt_scan[idx] / sig_y[idx] ** 2
    bias = float(np.sum(rr * wt) / np.sum(dt_scan[idx] ** 2 / sig_y[idx] ** 2))
    r_yaw = wrap_pi(rr - bias * dt_scan[idx]) / sig_y[idx]
    ext = float(0.5 * np.arctan2(2.0 * np.sum(dx[idx] * dy[idx]),
                                 np.sum(dx[idx] ** 2 - dy[idx] ** 2)))
    lat = (-np.sin(ext) * dx[idx] + np.cos(ext) * dy[idx]) / sig_t[idx]
    return float(np.sum(r_yaw ** 2) + np.sum(lat ** 2)), bias, ext


# ------------------------------------------------------------------- global tau profile
grid = np.arange(-0.10, 0.1001, 0.0005)
sse_grid = np.array([profile_tau(g, tr)[0] for g in grid])
tau0 = float(grid[int(np.argmin(sse_grid))])
_, b0, e0 = profile_tau(tau0, tr)

res_lin = fit(tr, np.array([b0, tau0, e0]), loss="linear")
res_s1 = fit(tr, res_lin.x.copy(), loss="soft_l1", f_scale=2.0)

theta_lin = res_lin.x
r_yaw_train = wrap_pi(dyaw[tr] - predict(theta_lin, tr)[0])
skew = float(stats.skew(r_yaw_train))
kurt = float(stats.kurtosis(r_yaw_train))
shapiro_p = float(stats.shapiro(r_yaw_train[:500]).pvalue)
n_large = int(np.sum(np.abs(r_yaw_train) > 3.0 * np.mean(sig_y[tr])))
use_soft_l1 = (abs(skew) > 1.0) or (kurt > 2.0) or (n_large > 0.01 * tr.sum())
final_loss = "soft_l1" if use_soft_l1 else "linear"
res = res_s1 if use_soft_l1 else res_lin
theta = res.x
bias_hat, tau_hat, ext_hat = [float(v) for v in theta]

# ------------------------------------------------------- covariance / collinearity
J = jac_fun(theta, np.flatnonzero(tr))
JTJ = J.T @ J
cov = np.linalg.inv(JTJ)
s2 = float(np.sum(res.fun ** 2) / (len(res.fun) - 3))
cov_scaled = cov * s2
sd = np.sqrt(np.diag(cov_scaled))
sd_unit = np.sqrt(np.diag(cov))
cond_JTJ = float(np.linalg.cond(JTJ))
corr_btau = float(cov[0, 1] / np.sqrt(cov[0, 0] * cov[1, 1]))
corr_bext = float(cov[0, 2] / np.sqrt(cov[0, 0] * cov[2, 2]))
corr_text = float(cov[1, 2] / np.sqrt(cov[1, 1] * cov[2, 2]))
regularized = False   # prior would only be used if cond(JtWJ) > 1e4

regularized_flag = regularized
if cond_JTJ > 1e4:     # zero-mean prior on (bias, tau, ext), recorded if ever triggered
    reg = np.eye(3) * 1e-6
    res = fit(tr, theta, loss=final_loss)
    theta = res.x
    bias_hat, tau_hat, ext_hat = [float(v) for v in theta]
    regularized_flag = True

# bootstrap over train rows -> yaw_extrinsic stability (lateral-slip check)
idx_tr = np.flatnonzero(tr)
boot = np.empty(500)
for k in range(500):
    rows = RNG.choice(idx_tr, size=len(idx_tr), replace=True)
    boot[k] = fit(rows, theta, loss="linear").x[2]
ext_boot_sd = float(np.std(boot))
ext_boot_med = float(np.median(boot))

# ------------------------------------------- profile likelihood for tau (b, ext re-fit)
sse_min = float(np.sum(res.fun ** 2))
tau_prof_grid = np.arange(tau_hat - 0.05, tau_hat + 0.0501, 0.0005)
tau_prof_sse = np.array([profile_tau(v, tr)[0] for v in tau_prof_grid])
inside = tau_prof_grid[tau_prof_sse <= sse_min + s2]
tau_ci_found = len(inside) > 0
tau_ci = [float(inside.min()), float(inside.max())] if tau_ci_found else \
         [float(tau_prof_grid[int(np.argmin(tau_prof_sse))])] * 2


# ---------------------------------------------------------------------------- outputs
pd.DataFrame({"gyro_bias_rad_s": [bias_hat], "time_offset_s": [tau_hat],
              "yaw_extrinsic_rad": [ext_hat]}).to_csv(f"{OUT}/calibration.csv", index=False)

# ------------------------------------------------------------------------ observability
pw = task["scoring"]["parameter_weights"]
wpar = np.array([pw["gyro_bias_rad_s"], pw["time_offset_s"], pw["yaw_extrinsic_rad"]])
mid_all = (t0 + t1) / 2.0
obs_raw, obs_sig, obs_rows, om_rng, dist = [], [], [], [], []
for r in seg.itertuples():
    m = tr & (mid_all >= r.t0_lidar_s) & (mid_all < r.t1_lidar_s)
    rows = np.flatnonzero(m)
    obs_rows.append(int(m.sum()))
    om_rng.append(float(np.ptp(np.interp(np.linspace(r.t0_lidar_s, r.t1_lidar_s, 500), t_imu, w_imu))))
    dist.append(float(np.sum(np.hypot(dx[rows], dy[rows]))))
    if m.sum() >= 4:
        Js = jac_fun(theta, rows)
        c = np.linalg.inv(Js.T @ Js) * s2
        prec = 1.0 / np.sqrt(np.diag(c))
        obs_sig.append([float(x) for x in np.sqrt(np.diag(c))])
    else:
        prec = np.zeros(3)
        obs_sig.append([float("nan")] * 3)
    obs_raw.append(float(np.dot(wpar, prec)))
obs_raw = np.array(obs_raw)
obs_norm = obs_raw / obs_raw.max()
pd.DataFrame({"segment_id": seg["segment_id"], "observability_score": obs_norm}).to_csv(
    f"{OUT}/observability.csv", index=False)

# ----------------------------------------------------------------- heldout residuals
# residual_trans_m: metric (metre) norm of the 2-D translation residual after applying the
# extrinsic rotation, r_2d = R(e)@[dx,dy] - [l_i, 0], with the forward step length l_i =
# |[dx,dy]| profiled out (the gyro carries no information about forward speed).
# The literally-rotated norm |R(e)@p| is rotation invariant (== |p|) and thus carries no
# calibration information; it is reported separately in metrics.json, not as the residual.
dpsi_h, lat_h, fwd_h = predict(theta, ho)
res_yaw_h = wrap_pi(dyaw[ho] - dpsi_h)
step_len = np.hypot(dx[ho], dy[ho])
r_fwd = fwd_h - step_len
res_trans_h = np.hypot(r_fwd, lat_h)
pd.DataFrame({"scan_id": scan_id[ho], "residual_yaw_rad": res_yaw_h,
              "residual_trans_m": res_trans_h}).sort_values("scan_id").to_csv(
    f"{OUT}/residuals.csv", index=False)

dpsi_t, lat_t, _ = predict(theta, tr)
res_yaw_t = wrap_pi(dyaw[tr] - dpsi_t)
chi2_held = float(np.mean(res_yaw_h ** 2 / sig_y[ho] ** 2) + np.mean(lat_h ** 2 / sig_t[ho] ** 2))

metrics = {
    "estimates": {
        "gyro_bias_rad_s": {"value": bias_hat, "sigma": float(sd[0])},
        "time_offset_s": {"value": tau_hat, "sigma": float(sd[1]), "profile_1sigma_interval_s": tau_ci, "profile_1sigma_found": bool(tau_ci_found)},
        "yaw_extrinsic_rad": {"value": ext_hat, "sigma": float(sd[2]),
                              "bootstrap_sigma_train": ext_boot_sd, "bootstrap_median": ext_boot_med},
    },
    "conventions": {
        "gyro_bias_rad_s": "measurement = truth + bias; residual = dyaw - (int(omega - bias) dt)",
        "time_offset_s": "t_gyro = t_lidar + time_offset; gyro integrated on [t0+tau, t1+tau]",
        "yaw_extrinsic_rad": "p_body = R(+yaw_extrinsic) * p_lidar; body x-axis = motion direction",
        "note": "task_info.json defines units but NOT sign conventions for time_offset_s / "
                "yaw_extrinsic_rad; these are fixed analysis assumptions, not facts from data.",
        "angle_wrap": "[-pi, pi)",
    },
    "fit": {
        "loss": final_loss,
        "soft_l1_selected": bool(use_soft_l1),
        "loss_choice_rule": "soft_l1 only if |skew|>1 or excess kurtosis>2 or >1% residuals beyond 3 sigma",
        "loss_candidates": {"linear_sse": float(np.sum(res_lin.fun ** 2)),
                            "theta_linear_heldout_yaw_sse": float(np.sum(
                                wrap_pi(dyaw[ho] - predict(res_lin.x, ho)[0]) ** 2 / sig_y[ho] ** 2)),
                            "soft_l1_cost": float(res_s1.cost),
                            "theta_linear": [float(x) for x in res_lin.x],
                            "theta_soft_l1": [float(x) for x in res_s1.x]},
        "train_yaw_residual_shape": {"skew": skew, "excess_kurtosis": kurt,
                                     "shapiro_p_first500": shapiro_p,
                                     "n_beyond_3sigma": n_large,
                                     "rms_rad": float(np.sqrt(np.mean(res_yaw_t ** 2)))},
        "global_grid_tau": {"step_s": 0.0005, "range_s": [-0.10, 0.10], "argmin_s": tau0},
        "n_train": int(tr.sum()), "n_heldout": int(ho.sum()),
        "n_residuals_fitted": int(2 * int(tr.sum())), "dof": int(2 * int(tr.sum()) - 3),
        "reduced_chi2_train": s2,
        "cond_JtWJ": cond_JTJ,
        "correlation_bias_time_offset": corr_btau,
        "correlation_bias_yaw_extrinsic": corr_bext,
        "correlation_time_offset_yaw_extrinsic": corr_text,
        "regularization_applied": bool(regularized_flag),
        "regularization_note": "no prior applied; prior would need cond(JtWJ) > 1e4 and be zero-mean",
    },
    "heldout_diagnostics": {
        "n_rows_written": int(ho.sum()),
        "rms_residual_yaw_rad": float(np.sqrt(np.mean(res_yaw_h ** 2))),
        "median_abs_residual_yaw_rad": float(np.median(np.abs(res_yaw_h))),
        "sigma_yaw_rad": float(np.mean(sig_y[ho])),
        "yaw_rms_over_sigma": float(np.sqrt(np.mean(res_yaw_h ** 2)) / float(np.mean(sig_y[ho]))),
        "rms_residual_trans_m": float(np.sqrt(np.mean(res_trans_h ** 2))),
        "median_abs_residual_trans_m": float(np.median(np.abs(res_trans_h))),
        "sigma_trans_m": float(np.mean(sig_t[ho])),
        "trans_rms_over_sigma": float(np.sqrt(np.mean(res_trans_h ** 2)) / float(np.mean(sig_t[ho]))),
        "normalized_chi2_per_obs_heldout": chi2_held,
        "rotation_invariant_norm_rms_m": float(np.sqrt(np.mean(step_len ** 2))),
        "rotation_invariant_norm_note": "|R(e)@[dx,dy]| is rotation invariant (== |[dx,dy]|); "
                                        "reported for completeness, not used as residual_trans_m.",
    },
    "observability": {
        "definition": "per window: JtWJ from the same sigma-weighted, train-only Jacobian; "
                      "precision_j = 1/sqrt(cov_jj); scalar = 0.25*p_bias + 0.4*p_tau + 0.35*p_ext, "
                      "normalised so max over the 9 windows = 1 (det not used, per review)",
        "normalized": {int(s): float(v) for s, v in zip(seg.segment_id, obs_norm)},
        "raw": {int(s): float(v) for s, v in zip(seg.segment_id, obs_raw)},
        "train_rows_per_segment": {int(s): int(n) for s, n in zip(seg.segment_id, obs_rows)},
        "per_segment_sigma": {int(s): v for s, v in zip(seg.segment_id, obs_sig)},
        "per_segment_sigma_order": ["gyro_bias_rad_s", "time_offset_s", "yaw_extrinsic_rad"],
        "omega_range_per_segment_rad_s": {int(s): float(v) for s, v in zip(seg.segment_id, om_rng)},
        "distance_per_segment_m": {int(s): float(v) for s, v in zip(seg.segment_id, dist)},
    },
    "data_profile": {
        "imu_rows": int(len(imu)), "imu_rate_hz": float(1.0 / np.mean(np.diff(t_imu))),
        "imu_span_s": [float(t_imu.min()), float(t_imu.max())],
        "imu_gyro_noise_rad_s_est": float(np.std(np.diff(w_imu, 2)) / np.sqrt(6)),
        "lidar_rows": int(len(lm)), "lidar_rate_hz": float(1.0 / np.mean(np.diff(t0))),
        "lidar_span_s": [float(t0.min()), float(t1.max())],
        "sigma_trans_m": float(np.mean(sig_t)), "sigma_yaw_rad": float(np.mean(sig_y)),
        "nan_counts": {"imu": int(imu.isna().sum().sum()), "lidar": int(lm.isna().sum().sum())},
        "split_counts": {"train": int(tr.sum()), "heldout": int(ho.sum())},
    },
}
json.dump(metrics, open(f"{OUT}/metrics.json", "w"), indent=2)



