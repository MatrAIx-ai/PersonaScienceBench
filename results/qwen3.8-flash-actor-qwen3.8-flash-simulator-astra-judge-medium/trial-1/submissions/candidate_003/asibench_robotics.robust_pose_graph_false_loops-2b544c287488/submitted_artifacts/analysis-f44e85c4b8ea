class MiniCanvas:
    """Tiny antialiased raster canvas (supersampled), pure numpy + zlib."""

    def __init__(self, w, h, ss=2):
        self.w, self.h, self.ss = w, h, ss
        self.buf = np.ones((h * ss, w * ss, 3), np.float32)

    def seg(self, x0, y0, x1, y1, color, lw=2.0):
        r = max(lw / 2.0, 0.4)
        ss, buf = self.ss, self.buf
        m = r + 2
        xa, xb = min(x0, x1) - m, max(x0, x1) + m
        ya, yb = min(y0, y1) - m, max(y0, y1) + m
        xi0, xi1 = max(int(xa), 0), min(int(xb) + 1, self.w)
        yi0, yi1 = max(int(ya), 0), min(int(yb) + 1, self.h)
        if xi0 >= xi1 or yi0 >= yi1:
            return
        yy, xx = np.mgrid[yi0 * ss:yi1 * ss, xi0 * ss:xi1 * ss]
        px = xx / ss - xi0 + 0.5 / ss
        py = yy / ss - yi0 + 0.5 / ss
        ax, ay = x0 - xi0, y0 - yi0
        vx, vy = x1 - x0, y1 - y0
        L2 = max(vx * vx + vy * vy, 1e-9)
        t = np.clip(((px - ax) * vx + (py - ay) * vy) / L2, 0.0, 1.0)
        d = np.hypot(px - ax - t * vx, py - ay - t * vy)
        cov = np.clip(r - d + 0.5 / ss, 0.0, 1.0)[..., None]
        reg = buf[yi0 * ss:yi1 * ss, xi0 * ss:xi1 * ss]
        reg *= 1.0 - cov
        reg += np.asarray(color, np.float32) * cov

    def polyline(self, xs, ys, color, lw=2.2, dash=None, s=1):
        """Dash: None solid, or (on_px, off_px). s = subsample scale."""
        xs = np.asarray(xs, float) * s
        ys = np.asarray(ys, float) * s
        if len(xs) < 2:
            return
        if dash is None:
            for k in range(len(xs) - 1):
                self.seg(xs[k], ys[k], xs[k + 1], ys[k + 1], color, lw)
            return
        on, off = dash
        period = on + off
        dacc = 0.0
        for k in range(len(xs) - 1):
            x0, y0, x1, y1 = xs[k], ys[k], xs[k + 1], ys[k + 1]
            L = np.hypot(x1 - x0, y1 - y0)
            if L < 1e-9:
                continue
            d0 = dacc % period
            u = 0.0
            while u < L:
                ph = (d0 + u) % period
                if ph < on:
                    v = min(L, u + (on - ph))
                    f0, f1 = u / L, v / L
                    self.seg(x0 + (x1 - x0) * f0, y0 + (y1 - y0) * f0,
                             x0 + (x1 - x0) * f1, y0 + (y1 - y0) * f1,
                             color, lw)
                    u = v
                else:
                    u += period - ph
            dacc += L

    def disc(self, x, y, r, color):
        self.seg(x, y, x + 1e-3, y, color, lw=2.0 * r)

    def marker(self, kind, x, y, size, color, lw=2.2):
        r = size / 2.0
        if kind == "o":
            self.disc(x, y, r, color)
        elif kind == "x":
            self.seg(x - r, y - r, x + r, y + r, color, lw)
            self.seg(x - r, y + r, x + r, y - r, color, lw)
        elif kind == "*":
            for a in (0.0, 60.0, 120.0, 90.0):
                ca, sa = np.cos(np.deg2rad(a)), np.sin(np.deg2rad(a))
                self.seg(x - r * ca, y - r * sa, x + r * ca, y + r * sa,
                         color, lw)
        elif kind == "s":
            self.polyline([x - r, x + r, x + r, x - r, x - r],
                          [y - r, y - r, y + r, y + r, y - r], color, lw)

    def rect_fill(self, x0, y0, x1, y1, color, alpha=1.0):
        ss = self.ss
        xi0, xi1 = max(int(min(x0, x1)), 0), min(int(max(x0, x1)), self.w)
        yi0, yi1 = max(int(min(y0, y1)), 0), min(int(max(y0, y1)), self.h)
        if xi0 >= xi1 or yi0 >= yi1:
            return
        reg = self.buf[yi0 * ss:yi1 * ss, xi0 * ss:xi1 * ss]
        reg *= 1.0 - alpha
        reg += np.asarray(color, np.float32) * alpha

    def text(self, x, y, s, color=(0, 0, 0), scale=2, halign="l"):
        s = str(s)
        wch = 6 * scale
        if halign == "c":
            x -= len(s) * wch / 2.0
        elif halign == "r":
            x -= len(s) * wch
        for k, ch in enumerate(s):
            g = GLYPHS.get(ch, GLYPHS.get("#"))
            if g is None:
                continue
            for r in range(7):
                row = g[r * 5:(r + 1) * 5]
                for c in range(5):
                    if row[c] == "#":
                        px = x + k * wch + c * scale
                        py = y + r * scale
                        self.rect_fill(px, py, px + scale, py + scale,
                                       color, 1.0)

    def save(self, path):
        ss = self.ss
        img = self.buf.reshape(self.h, ss, self.w, ss, 3).mean(axis=(1, 3))
        img8 = np.clip(img * 255.0 + 0.5, 0, 255).astype(np.uint8)
        raw = b"".join(b"\x00" + img8[i].tobytes() for i in range(self.h))

        def chunk(t, d):
            return (struct.pack(">I", len(d)) + t + d
                    + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF))

        ihdr = struct.pack(">IIBBBBB", self.w, self.h, 8, 2, 0, 0, 0)
        with open(path, "wb") as f:
            f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr)
                    + chunk(b"IDAT", zlib.compress(raw, 6))
                    + chunk(b"IEND", b""))


def nice_ticks(lo, hi, n=6):
    span = hi - lo
    if span <= 0:
        return [lo]
    step0 = span / n
    mag = 10.0 ** np.floor(np.log10(step0))
    for m in (1, 2, 2.5, 5, 10):
        if m * mag >= step0:
            step = m * mag
            break
    t0 = np.ceil(lo / step) * step
    return list(np.arange(t0, hi + 1e-12, step))


def fmt_tick(v):
    if abs(v) < 1e-12:
        v = 0.0
    return "%.4g" % v



