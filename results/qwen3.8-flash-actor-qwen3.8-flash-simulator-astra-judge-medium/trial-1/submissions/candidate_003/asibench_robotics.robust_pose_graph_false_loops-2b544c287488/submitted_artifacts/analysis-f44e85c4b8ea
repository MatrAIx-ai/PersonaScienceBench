            ly0, ly1 = np.log10(ylim[0]), np.log10(ylim[1])

            def Y(v):
                return y1 - (np.log10(max(v, 1e-12)) - ly0) / (ly1 - ly0) * (y1 - y0)
        else:
            ly0, ly1 = ylim

            def Y(v):
                return y1 - (v - ly0) / (ly1 - ly0) * (y1 - y0)

