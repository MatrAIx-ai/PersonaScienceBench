    pad = 1.0
    xlo, xhi = allx.min() - pad, allx.max() + pad
    ylo, yhi = ally.min() - pad, ally.max() + pad
    sc = min((rA[2] - rA[0]) / (xhi - xlo), (rA[3] - rA[1]) / (yhi - ylo))
    ox = rA[0] + ((rA[2] - rA[0]) - (xhi - xlo) * sc) / 2.0
    oy = rA[1] + ((rA[3] - rA[1]) - (yhi - ylo) * sc) / 2.0

    def XA(v):
        return ox + (v - xlo) * sc

    def YA(v):
        return rA[3] - (v - ylo) * sc

