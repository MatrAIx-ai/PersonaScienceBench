"""TASK008 BCG-CORONA: COVID-19 severity by patients_seen stratum, BCG vs Placebo.
Canonical inputs: CSV. Aggregation of AE to patient level. Tests: Pearson chi2 (all
expected>=5), Yates chi2 (min expected 1-5), Fisher exact (min expected <1 or zero cell).
Effect sizes: OR with 95% CI (Haldane-Anscombe +0.5 when zero cells), Cramer's V.
"""
import numpy as np, pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

pd.set_option('display.width', 250); pd.set_option('display.max_columns', 50)

dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')

# ---- patient-level flags from COVID-19 AE records -------------------------------
covid = ae[ae['AEPT'].astype(str).str.contains('COVID', case=False, na=False)].copy()
g = covid.groupby('USUBJID')
flags = pd.DataFrame({
    'any_covid':  True,
    'sev_aesev3': g['AESEV'].max() >= 3,
    'sev_aesev2': g['AESEV'].max() >= 2,
    'sev_aeser':  g['AESER'].apply(lambda s: (s == 'Yes').any()),
    'sev_hosp':   g['AESERCRIT'].apply(lambda s: (s == 'Hospitalization_prolongation').any()),
    'sev_fatal':  g['AEOUT'].apply(lambda s: (s == 'Fatal').any()),
    'n_covid_rec': g.size(),
    'n_nan_sev':   g['AESEV'].apply(lambda s: s.isna().sum()),
})
flags['sev_composite'] = (flags['sev_aesev3'] | flags['sev_aeser'] |
                          flags['sev_hosp'] | flags['sev_fatal'])
# variant: drop patients whose COVID records ALL have missing AESEV (NaN-excluded denominator)
flags['sev_evaluable'] = flags['n_nan_sev'] < flags['n_covid_rec']

df = dm.merge(flags, left_on='USUBJID', right_index=True, how='left')
for c in flags.columns:
    df[c] = df[c].fillna(False) if flags[c].dtype == bool else df[c].fillna(0)
df['sev_composite'] = df['sev_composite'].astype(bool)

STRATA = ['1-50', '51-100', '>100']

def effect_and_test(t):
    """t = 2x2 [[a,b],[c,d]] rows=BCG,Placebo cols=severe,non-severe."""
    a, b, c, d = t[0,0], t[0,1], t[1,0], t[1,1]
    exp = np.outer(t.sum(1), t.sum(0)) / t.sum()
    zero_cell = (t == 0).any()
    min_exp = exp.min()
    if zero_cell or min_exp < 1:
        test = 'Fisher exact'
        # Fisher works unless a whole row/col of the 2x2 is structurally empty
        if t.sum(0).min() == 0 or t.sum(1).min() == 0:
            return test, np.nan, np.nan, None, np.nan, exp
        p = fisher_exact(t)[1]
        ac, bc, cc, dc = (a+.5, b+.5, c+.5, d+.5) if min(t.ravel()) == 0 else (a, b, c, d)
        or_ = ac*dc/(bc*cc)
        lse = np.sqrt(1/ac + 1/bc + 1/cc + 1/dc)
        ci = (np.exp(np.log(or_)-1.96*lse), np.exp(np.log(or_)+1.96*lse))
        n = t.sum()
        v = np.sqrt(chi2_contingency(t, correction=False, lambda_='pearson')[0]/n)
        return test, p, or_, ci, v, exp
    else:
        if min_exp >= 5:
            test = 'Pearson chi2'; corr = False
        else:
            test = 'Yates chi2'; corr = True
        chi2, p, _, _ = chi2_contingency(t, correction=corr, lambda_='pearson')
        or_ = (a + .5)*(d + .5)/((b + .5)*(c + .5)) if zero_cell else (a*d)/(b*c) if b*c > 0 else np.inf
    n = t.sum(); r = t.sum(1); col = t.sum(0)
    # OR 95% CI (Haldane-Anscombe 0.5 if any zero cell)
    ac, bc, cc, dc = (a, b, c, d) if min(t.ravel()) > 0 else (a+.5, b+.5, c+.5, d+.5)
    lse = np.sqrt(1/ac + 1/bc + 1/cc + 1/dc)
    lo, hi = np.exp(np.log(or_) - 1.96*lse), np.exp(np.log(or_) + 1.96*lse)
    v = np.sqrt(chi2_contingency(t, correction=(test=='Yates chi2'), lambda_='pearson')[0]/n/min(2-1, 2-1))
    return test, p, or_, (lo, hi), v, exp

def run_table(sub, sev_col, denom_label):
    rows = []
    for s in STRATA:
        st = sub[sub['patients_seen'] == s]
        piv = pd.crosstab(st['TRTGRP'], st[sev_col]).reindex(
            index=['BCG', 'Placebo'], columns=[True, False], fill_value=0).values.astype(int)
        t = np.array([[piv[0,0], piv[0,1]], [piv[1,0], piv[1,1]]])  # cols: severe, non-severe
        test, p, orv, ci, v, exp = effect_and_test(t)
        rows.append(dict(stratum=s, denom=denom_label, BCG_sev=t[0,0], BCG_n=t[0].sum(),
                         Pla_sev=t[1,0], Pla_n=t[1].sum(),
                         table=f"BCG {t[0,0]}/{t[0].sum()} vs Pla {t[1,0]}/{t[1].sum()}",
                         test=test, p=p, OR=orv,
                         CI95=f"[{ci[0]:.2f}, {ci[1]:.2f}]" if ci is not None and np.isfinite(ci).all() else "n/a",
                         CramersV=v, min_exp=exp.min()))
    return pd.DataFrame(rows)

# ---- PRIMARY: denominator = COVID+ patients, severity = composite ---------------
cplus = df[df['any_covid']]
primary = run_table(cplus, 'sev_composite', 'COVID+ only')
secondary = run_table(df, 'sev_composite', 'all patients')

print("="*100)
print("PRIMARY: severe COVID (composite: AESEV>=3 | AESER=Yes | hosp/death crit | AEOUT=Fatal)")
print("         denominator = COVID-19-positive patients in stratum (any AEPT containing 'COVID')")
print("="*100)
print(primary.to_string(index=False, float_format=lambda x: f"{x:.4g}"))
print()
print("SECONDARY (robustness only): same outcome, denominator = ALL patients in stratum")
print(secondary.to_string(index=False, float_format=lambda x: f"{x:.4g}"))

# ---- full sensitivity grid -------------------------------------------------------
defs = {
    'composite (primary)': ('sev_composite', 'COVID+ only'),
    'composite/all-patients': ('sev_composite', 'all patients'),
    'AESEV>=3': ('sev_aesev3', 'COVID+ only'),
    'AESEV>=2': ('sev_aesev2', 'COVID+ only'),
    'AESER=Yes': ('sev_aeser', 'COVID+ only'),
    'AESERCRIT=hospitalization': ('sev_hosp', 'COVID+ only'),
    'AEOUT=Fatal': ('sev_fatal', 'COVID+ only'),
    'composite / AESEV-NaN-only pts excluded': ('sev_composite', 'COVID+ sev-evaluable'),
}
sens = []
for name, (col, den) in defs.items():
    sub = cplus if den == 'COVID+ only' else (df[df['sev_evaluable']] if 'evaluable' in den else df)
    r = run_table(sub, col, den); r.insert(0, 'definition', name); sens.append(r)
sens = pd.concat(sens, ignore_index=True)
print("\n" + "="*100)
print("FULL SENSITIVITY GRID (every definition x stratum; no cherry-picking)")
print("="*100)
print(sens.to_string(index=False, float_format=lambda x: f"{x:.4g}"))
print("\nsignificant cells (p<0.05) anywhere in grid:")
print(sens[sens['p'] < 0.05].to_string(index=False, float_format=lambda x: f"{x:.4g}"))
print("\nPrimary-definition significant cells:", (primary['p'] < 0.05).sum())
