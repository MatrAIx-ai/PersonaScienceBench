"""Exploratory ADDENDUM (not part of the pre-registered sensitivity grid):
other plausible 'severity-ish' outcomes, to see whether p<0.05 exists ANYWHERE.
"""
import numpy as np, pandas as pd
from scipy.stats import chi2_contingency, fisher_exact
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv'); ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
def ptest(t):
    exp=np.outer(t.sum(1),t.sum(0))/t.sum()
    if (t==0).any() or exp.min()<1:
        if t.sum(0).min()==0 or t.sum(1).min()==0: return 'Fisher', np.nan
        return 'Fisher', fisher_exact(t)[1]
    if exp.min()>=5: return 'Pearson', chi2_contingency(t,correction=False)[1]
    return 'Yates', chi2_contingency(t,correction=True)[1]
g=ae.groupby('USUBJID')
pat=pd.DataFrame({
 'sev_any_AE3': g['AESEV'].max()>=3,
 'ser_any_AE': g['AESER'].apply(lambda s:(s=='Yes').any()),
 'hosp_any': g['AESERCRIT'].apply(lambda s:(s=='Hospitalization_prolongation').any()),
 'death_any': g['AEOUT'].apply(lambda s:(s=='Fatal').any()),
})
covid=ae[ae['AEPT'].astype(str).str.contains('COVID',case=False,na=False)]
gc=covid.groupby('USUBJID')
pat['covid_worse_or_fatal']=gc['AEOUT'].apply(lambda s:s.isin(['Worse','Fatal']).any())
pat['covid_not_resolved']=gc['AEOUT'].apply(lambda s:s.isin(['Worse','Fatal','Unchanged','N_A']).any())
pat['any_covid']=True
d=dm.merge(pat,left_on='USUBJID',right_index=True,how='left').fillna(False)
rows=[]
for name in ['sev_any_AE3','ser_any_AE','hosp_any','death_any','covid_worse_or_fatal','covid_not_resolved','any_covid']:
    sub = d[d['any_covid']] if name.startswith('covid_') else d
    for s in ['1-50','51-100','>100']:
        st=sub[sub['patients_seen']==s]
        t=pd.crosstab(st['TRTGRP'],st[name]).reindex(index=['BCG','Placebo'],columns=[True,False],fill_value=0).values.astype(int)
        test,p=ptest(t)
        rows.append((name,s,f"BCG {t[0,0]}/{t[0].sum()} vs Pla {t[1,0]}/{t[1].sum()}",test,p))
r=pd.DataFrame(rows,columns=['outcome','pop','table','test','p'])
print(r.to_string(index=False,float_format=lambda x:f"{x:.4g}"))
print("\np<0.05 anywhere:"); print(r[r['p']<0.05].to_string(index=False))
