"""ADDITIONAL exploratory run (does NOT replace pre-reg primary):
k x 2 chi-square on native categorical severity forms (AESEV, AEOUT, AESER, AEHS)
within COVID-19 AEs, per patients_seen stratum, BCG vs Placebo.
Small-count check: Monte-Carlo permutation chi-square (fixed group sizes, B=20000),
serving as Fisher-Freeman-Halton-style exactness check for r x 2 tables.
"""
import numpy as np, pandas as pd
from scipy.stats import chi2_contingency
rng = np.random.default_rng(20261022)
STRATA = ['1-50','51-100','>100']
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv'); ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
covid = ae[ae['AEPT'].astype(str).str.contains('COVID', case=False, na=False)].copy()

def perm_p(tab, B=20000, obs=None):
    """Monte-Carlo chi-square permutation p: shuffle group labels keeping sizes."""
    tab = np.asarray(tab, float)
    if obs is None:
        obs = chi2_contingency(tab, correction=False)[0]
    n1 = int(tab[0].sum()); n = tab.sum(); tot = tab.sum(0)
    cats = np.repeat(np.arange(tab.shape[1]), tot.astype(int))  # outcome labels
    cnt = 0; stat = np.zeros(B)
    for i in range(B):
        lab = rng.permutation(len(cats)) < n1
        t = np.zeros_like(tab)
        for r_ in range(tab.shape[0]):
            pass
        # counts per (group, category)
        rows = np.array(lab)  # True=group1
        for r_, g in [(0, rows), (1, ~rows)]:
            vc = np.bincount(cats[g], minlength=tab.shape[1])
            t[r_] = vc
        exp = np.outer(t.sum(1), t.sum(0))/n
        with np.errstate(divide='ignore', invalid='ignore'):
            s = np.nansum(np.where(exp>0, (t-exp)**2/exp, 0))
        stat[i] = s
    return (np.sum(stat >= obs - 1e-12) + 1)/(B + 1)

def analyze(df_cat, name, cat_order):
    out = []
    for s in STRATA:
        st = df_cat[df_cat['patients_seen'] == s]
        tab = pd.crosstab(st['TRTGRP'], st['cat']).reindex(index=['BCG','Placebo'], columns=cat_order, fill_value=0)
        tab = tab.loc[:, tab.sum() > 0]          # drop structurally empty categories
        tab = tab.loc[tab.sum(1) > 0]            # drop empty arms
        M = tab.values.astype(float)
        exp = np.outer(M.sum(1), M.sum(0))/M.sum()
        min_exp = exp.min(); k = M.shape[1]; df_ = M.shape[0]-1 if M.shape[0]>1 else 1
        df_ = (M.shape[0]-1)*(k-1)
        if df_ < 1 or M.sum() == 0:
            out.append((name, s, str(list(tab.columns)), M.tolist(), min_exp, 'n/a', np.nan, np.nan)); continue
        chi2, p, dof, _ = chi2_contingency(M, correction=False)
        pp = perm_p(M, obs=chi2)
        out.append((name, s, str(list(tab.columns)), M.tolist(), round(min_exp,2),
                    f"Pearson chi2 df={dof}", p, pp))
    return out

rows = []
# ---- 1) AESEV patient-level (max per patient; 'NaN' = all COVID recs missing AESEV)
g = covid.groupby('USUBJID')
psev = g['AESEV'].max()
psev_all_nan = g['AESEV'].apply(lambda s: s.isna().all())
psev_lbl = psev.astype('Int64').astype(str).where(~psev_all_nan, 'NaN')
t1 = dm[dm['USUBJID'].isin(covid['USUBJID'])].assign(cat=dm['USUBJID'].map(psev_lbl))
rows += analyze(t1, 'AESEV pt-max (NaN cat kept)', ['1','2','3','4','NaN'])
# ---- 1b) AESEV record-level
t1b = covid.merge(dm[['USUBJID','patients_seen']], on='USUBJID')
t1b['cat'] = t1b['AESEV'].astype('Int64').astype(str).fillna('NaN')
rows += analyze(t1b, 'AESEV record-level (NaN cat kept)', ['1','2','3','4','NaN'])
# ---- 2) AEOUT patient-level worst; and AESER patient-level status
rank = {'Fatal':6,'Worse':5,'Unchanged':4,'Improved':3,'Resolved':2,'Resolved_':2,'N_A':1}
worst = g['AEOUT'].apply(lambda s: max(s.map(rank).dropna(), default=np.nan))
worst_lbl = worst.map({6:'Fatal',5:'Worse',4:'Unchanged',3:'Improved',2:'Resolved',1:'N_A'})
t2 = dm[dm['USUBJID'].isin(covid['USUBJID'])].assign(cat=dm['USUBJID'].map(worst_lbl).fillna('Unknown'))
rows += analyze(t2, 'AEOUT pt-worst', ['Fatal','Worse','Unchanged','Improved','Resolved','N_A','Unknown'])
ser = g['AESER'].apply(lambda s: 'Yes' if (s=='Yes').any() else ('No' if (s=='No').any() else 'Unknown'))
t3 = dm[dm['USUBJID'].isin(covid['USUBJID'])].assign(cat=dm['USUBJID'].map(ser))
rows += analyze(t3, 'AESER pt-status', ['Yes','No','Unknown'])
# ---- 3) AEHS patient-level max among COVID records (native ordinal)
mhs = g['AEHS'].max()
t4 = dm[dm['USUBJID'].isin(covid['USUBJID'])].assign(cat=dm['USUBJID'].map(mhs.astype('Int64').astype(str)).fillna('NaN'))
rows += analyze(t4, 'AEHS pt-max (0-7)', ['0','1','2','3','4','5','6','7','NaN'])
# 3b) AEHS>=4 binary (data-driven: >=4 captures all AESER=Yes-4, hosp cluster; exploratory dichotomy)
t5 = t4.copy(); t5['cat'] = np.where(pd.to_numeric(t5['cat'], errors='coerce')>=4, 'HS>=4', 'HS<4')
rows += analyze(t5, 'AEHS>=4 pt-max (binary, explor.)', ['HS>=4','HS<4'])

res = pd.DataFrame(rows, columns=['view','stratum','categories','table BCG/Pla','min_exp','test','p_pearson','p_perm20k'])
print(res.to_string(index=False, float_format=lambda x: f"{x:.4g}"))
print("\np<0.05 anywhere in additional run:")
print(res[(res['p_pearson']<0.05) | (res['p_perm20k']<0.05)].to_string(index=False, float_format=lambda x:f"{x:.4g}"))
