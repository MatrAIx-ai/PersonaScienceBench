"""
BixBench bix-14-q3  --  FINAL ANALYSIS
Question: after filtering out reference variant calls and variants located in intronic,
intergenic or UTR regions, how many non-reference EXONIC variants remain in CHIP genes
(Schenz et al. 2022 list) across the 86 samples?

Locked rules (researcher decisions 2026-10-22):
 1) Unit of count = SUM of calls over the 86 samples (cohort-unique = reference-only line).
 2) De-duplication ONLY within a file, on (Chr:Pos, Ref/Alt). Cross-sample dedup = auxiliary only.
 3) splice_region_variant is KEPT as exonic (drop list is a localization-term cut).
 4) Drop exactly: intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant,
    5_prime_UTR_premature_start_codon_gain_variant, upstream_gene_variant.
    True intergenic terms: 0 observed (report as such, not "filtered out").
 5) non-reference = Zygosity in {Heterozygous, Homozygous Variant}; blank Zygosity = no-call -> excluded.
 6) Gene filter = strict Schenz 56-symbol list (header=None; ABL1 kept), intersection with the
    comma-separated 'Gene Names' field. In_CHIP=True flag is NOT used (broader string list).
 7) Trio_Status not used in the calculation; note 86 files / 86 IDs / extra ID 533.

Reproducibility: VarSeq exports carry a truncated <dimension ref="A1"> record (84/86 files),
which makes naive pandas/openpyxl readers see a 1x1 sheet -> ws.reset_dimensions() is mandatory.
"""
import glob, re, zipfile, collections
import openpyxl, pandas as pd

VARSEQ_GLOB = "data/CHIP_DP10_GQ20_PASS/*.xlsx"
CHIP_XLSX   = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
TRIO_XLSX   = "data/230215_Trio_Status.xlsx"
OUT_TXT     = "work/final_report.txt"

DROP_TERMS = {"intron_variant",
              "3_prime_UTR_variant",
              "5_prime_UTR_variant",
              "5_prime_UTR_premature_start_codon_gain_variant",
              "upstream_gene_variant"}
INTERGENIC_TERMS = {"intergenic_region", "intergenic_variant"}
NONREF = {"Heterozygous", "Homozygous Variant"}
FIELDS = ["Chr:Pos", "Ref/Alt", "Zygosity", "Sequence Ontology (Combined)",
          "Effect (Combined)", "Gene Names", "Filter", "In_CHIP",
          "HGVS c. (Clinically Relevant)"]

log_lines = []
def P(*a):
    s = " ".join(str(x) for x in a)
    print(s); log_lines.append(s)

def read_varsheet(path):
    """2 header rows + broken <dimension>; return DataFrame keyed by row-2 field names."""
    wb = openpyxl.load_workbook(path, read_only=True)
    ws = wb[wb.sheetnames[0]]
    ws.reset_dimensions()                     # <- critical workaround
    it = ws.iter_rows(values_only=True)
    grp = next(it)
    hdr = tuple(next(it))[:33]
    rows = [tuple(r) + (None,) * (33 - len(r)) for r in it]
    sheet = wb.sheetnames[0]
    wb.close()
    idx = {}
    for i, name in enumerate(hdr):
        if name and name not in idx:          # 'Match' repeats 3x -> keep first
            idx[name] = i
    missing = [f for f in FIELDS if f not in idx]
    assert not missing, (path, missing)
    recs = [{f: r[idx[f]] for f in FIELDS} for r in rows]
    sample = [v for v in grp if v and "(" in str(v)][0]
    return sheet, sample, pd.DataFrame(recs), len(rows)

# ---------------------------------------------------------------- load + validate
files = sorted(glob.glob(VARSEQ_GLOB))
P("=" * 78); P("LOAD & VALIDATION"); P("=" * 78)
P("VarSeq files found:", len(files))
frames, hdrs, broken_dim = [], collections.Counter(), 0
for f in files:
    sheet, sample, d, n = read_varsheet(f)
    d["file"] = f.split("CHIP_")[-1]
    d["sample_col"] = sample
    d["sample_id"] = f.split("CHIP_")[-1][:-5]
    frames.append(d)
    hdrs[tuple(d.columns)] += 1
    z = zipfile.ZipFile(f)
    xs = sorted(n for n in z.namelist() if n.startswith("xl/worksheets/sheet"))
    xml = z.read(xs[0]).decode("utf8", "ignore")
    dim = re.findall(r'<dimension ref="([^"]*)"', xml)
    n_xml = len(re.findall(r"<row ", xml))
    assert n_xml - 2 == n, (f, n_xml, n)                      # no silent row loss
    if not dim or dim[0] == "A1":
        broken_dim += 1
df = pd.concat(frames, ignore_index=True)
P("files with truncated <dimension ref=\"A1\"> (need reset_dimensions):", broken_dim, "of", len(files))
P("distinct header rows across files (must be 1):", len(hdrs))
P("sample-title prefix == filename ID for all rows:",
    bool((df.sample_col.str.split(" (", regex=False).str[1].str[:-1] == df.sample_id).all()))
P("unique samples:", df.sample_id.nunique())
P("raw variant rows:", len(df))
# integrity guards against column drift
P("Chr:Pos malformed:", int((~df["Chr:Pos"].astype(str).str.match(r"^(\d+|X|Y|M):\d+$")).sum()))
hg = df["HGVS c. (Clinically Relevant)"].astype(str)
P("HGVS lacks ':c.':", int((~hg.str.contains(":c.", regex=False)).sum()))
P("Zygosity outside {Reference,Het,Hom,blank}:",
    int((~df.Zygosity.isin(list(NONREF) + ["Reference"]) & df.Zygosity.notna()).sum()))
P("Filter values:", dict(df["Filter"].value_counts()), "| In_CHIP values:", dict(df.In_CHIP.value_counts()))

# ---------------------------------------------------------------- CHIP gene list
chip = pd.read_excel(CHIP_XLSX, header=None)[0].astype(str).str.strip()
chipset = set(chip)
P("\n" + "=" * 78); P("CHIP GENE LIST (Schenz et al. 2022)"); P("=" * 78)
P("genes (header=None):", len(chipset), "| duplicates:",
    [k for k, v in collections.Counter(chip).items() if v > 1],
    "| first:", chip.iloc[0], "| last:", chip.iloc[-1])
def genes(cell):
    return {g.strip().upper() for g in str(cell).replace(";", ",").split(",") if g.strip()}
df["gene_set"] = df["Gene Names"].map(genes)
df["chip_gene"] = df.gene_set.map(lambda s: bool(s & chipset))
P("rows whose Gene Names contain no Schenz gene:", int((~df.chip_gene).sum()),
    "->", sorted({g for s in df.loc[~df.chip_gene, "gene_set"] for g in s}))
P("  (they carry In_CHIP=True because VarSeq used a broader Match String List: cblB/cblC/SF3b1)")

# ---------------------------------------------------------------- filters
base_df = df.drop_duplicates(subset=["file", "Chr:Pos", "Ref/Alt"], keep="first").copy()
raw_df = df
d = base_df
P("\n" + "=" * 78); P("FILTERS"); P("=" * 78)
_dupmask = df.duplicated(subset=["file", "Chr:Pos", "Ref/Alt"], keep="first")
P("after within-file de-dup on (file, Chr:Pos, Ref/Alt):", len(d),
  "(removed", int(_dupmask.sum()), "exact export duplicates)")
P("  removed duplicates are 100% intron_variant ->",
  dict(df.loc[_dupmask, "Sequence Ontology (Combined)"].value_counts()),
  "| zygosity:", dict(df.loc[_dupmask, "Zygosity"].fillna("<no-call>").value_counts()),
  "(hence this de-dup cannot change the exonic answer)")
n0 = len(d)
d_nocall = d.Zygosity.isna().sum()
step1 = d[d.Zygosity.isin(NONREF)]
P(f"1) drop reference calls (Zygosity=='Reference') and no-calls (blank): "
  f"{n0} -> {len(step1)}   [Reference={int((d.Zygosity=='Reference').sum())}, no-call={int(d_nocall)}]")
inter_obs = int(step1["Sequence Ontology (Combined)"].isin(INTERGENIC_TERMS).sum())
step2 = step1[~step1["Sequence Ontology (Combined)"].isin(DROP_TERMS)]
P("2) drop intronic / UTR / upstream / intergenic terms:", len(step1), "->", len(step2))
P("   true intergenic terms observed in data:", inter_obs, "(0 = not 'filtered out', simply absent)")
step3 = step2[step2.chip_gene]
P("3) restrict to Schenz CHIP genes:", len(step2), "->", len(step3))
ANSWER = len(step3)

# ---------------------------------------------------------------- main number + breakdowns
P("\n" + "=" * 78); P("RESULT"); P("=" * 78)
P(">>> non-reference EXONIC variants in CHIP genes, summed over the 86 samples:", ANSWER)
P("    (auxiliary, cross-sample unique variants:",
  step3.groupby(["Chr:Pos", "Ref/Alt"]).ngroups, ")")
P("\nPer-sample distribution of the kept calls: min/median/max =",
  step3.groupby("file").size().min(), int(step3.groupby("file").size().median()),
  step3.groupby("file").size().max(), "| samples with >=1:", step3.file.nunique())
P("\nBreakdown by Sequence Ontology term (kept rows):")
P(step3["Sequence Ontology (Combined)"].value_counts().to_string())
P("\nDropped at step 2 (non-reference calls removed by localization), by term:")
P(step1[step1["Sequence Ontology (Combined)"].isin(DROP_TERMS)]
   ["Sequence Ontology (Combined)"].value_counts().to_string())
P("\nTop 15 CHIP genes by kept calls (rows over samples / unique variants):")
tb = (step3.groupby("Gene Names").size().rename("calls")
        .to_frame().join(step3.groupby("Gene Names").apply(
            lambda x: x.groupby(["Chr:Pos", "Ref/Alt"]).ngroups, include_groups=False).rename("unique_variants"))
        .sort_values("calls", ascending=False))
P(tb.head(15).to_string())
step3.to_csv("work/kept_calls.csv", index=False)
(step3.groupby(["file", "sample_id", "sample_col"]).size().rename("kept_calls").reset_index()
   .to_csv("work/per_sample_counts.csv", index=False))
P("\nPer-sample kept-call table -> work/per_sample_counts.csv (86 rows, total =", int(step3.groupby("file").size().sum()), ")")

# ---------------------------------------------------------------- sensitivity matrix
P("\n" + "=" * 78); P("SENSITIVITY MATRIX"); P("=" * 78)
rows = []
for lbl, frame in [("dedup on (main)", base_df), ("dedup off", raw_df)]:
    keep_main    = ~frame["Sequence Ontology (Combined)"].isin(DROP_TERMS)
    keep_nosp    = ~frame["Sequence Ontology (Combined)"].isin(DROP_TERMS | {"splice_region_variant"})
    nr_main      = frame.Zygosity.isin(NONREF)
    nr_het       = frame.Zygosity.eq("Heterozygous")
    nr_plus_blank= frame.Zygosity.isin(NONREF) | frame.Zygosity.isna()
    gene_main    = frame.chip_gene
    gene_flag    = pd.Series([True] * len(frame), index=frame.index)   # export already In_CHIP=True
    for gl, gm in [("strict Schenz list (main)", gene_main), ("VarSeq In_CHIP flag", gene_flag)]:
        for el, km in [("splice IN (main)", keep_main), ("splice OUT", keep_nosp)]:
            for nl, nm in [("Het+Hom (main)", nr_main), ("Het only", nr_het), ("Het+Hom+no-call", nr_plus_blank)]:
                s = frame[gm.to_numpy() & km.to_numpy() & nm.to_numpy()]
                rows.append((lbl, gl, el, nl, len(s), s.groupby(["Chr:Pos", "Ref/Alt"]).ngroups))
sens = pd.DataFrame(rows, columns=["dedup", "gene rule", "splice_region", "non-ref rule",
                                   "SUM over 86 samples", "unique variants"])
P(sens.to_string(index=False))
sens.to_csv("work/final_sensitivity.csv", index=False)
P("\nDedup sensitivity on the main configuration: sum with dedup =", ANSWER, "vs without dedup =",
  sens.query("`dedup`=='dedup off' and `gene rule`=='strict Schenz list (main)' "
             "and `splice_region`=='splice IN (main)' and `non-ref rule`=='Het+Hom (main)'")["SUM over 86 samples"].iat[0])
delta = (sens.query("`dedup`=='dedup off' and `gene rule`=='strict Schenz list (main)' "
                    "and `splice_region`=='splice IN (main)' and `non-ref rule`=='Het+Hom (main)'")["SUM over 86 samples"].iat[0] - ANSWER)
P("within-file dedup shifts the answer by", delta, "calls ->", "negligible (<100)" if abs(delta) < 100 else "material")

# ---------------------------------------------------------------- trio note
t = pd.read_excel(TRIO_XLSX); t.columns = [c.strip() for c in t.columns]
t["id"] = t["Sample ID"].astype(str).str.strip()
ids = set(df.sample_id)
mapped = {i if i.startswith("SRR") else i.split("-")[0] for i in ids}
P("\n" + "=" * 78); P("SAMPLE / TRIO NOTE (metadata only, not used in the count)"); P("=" * 78)
P("VarSeq files:", len(files), "| unique sample IDs:", len(ids),
  "| all present in Trio_Status:", mapped <= set(t.id))
P("Trio_Status rows:", len(t), "| IDs without a VarSeq file:", sorted(set(t.id) - mapped),
  "| statuses:", dict(t.Status.astype(str).str.strip().value_counts()))
# ---------------------------------------------------------------- which fork matters
P("\n" + "=" * 78); P("WHICH FORK ACTUALLY MOVES THE ANSWER"); P("=" * 78)
m = sens.set_index(["dedup", "gene rule", "splice_region", "non-ref rule"])["SUM over 86 samples"]
main = ANSWER
for lbl, key in [
    ("within-file de-dup off", ("dedup off", "strict Schenz list (main)", "splice IN (main)", "Het+Hom (main)")),
    ("splice_region treated as intronic", ("dedup on (main)", "strict Schenz list (main)", "splice OUT", "Het+Hom (main)")),
    ("gene rule = VarSeq In_CHIP flag", ("dedup on (main)", "VarSeq In_CHIP flag", "splice IN (main)", "Het+Hom (main)")),
    ("counting no-calls as non-ref", ("dedup on (main)", "strict Schenz list (main)", "splice IN (main)", "Het+Hom+no-call")),
    ("Heterozygous only", ("dedup on (main)", "strict Schenz list (main)", "splice IN (main)", "Het only"))]:
    v = int(m[key]); P(f"  {lbl:36} -> {v:5d}  (delta {v - main:+d}, {100*(v-main)/main:+.1f}%)")
u = int(step3.groupby(["Chr:Pos", "Ref/Alt"]).ngroups)
P(f"  {"counting cohort-unique variants":36} -> {u:5d}  (delta {u - main:+d}, {100*(u-main)/main:.1f}%) <- the single biggest lever")
P("\nFINAL ANSWER:", ANSWER)
open(OUT_TXT, "w").write("\n".join(log_lines) + "\n")
print("\n[report written to", OUT_TXT + "]")
