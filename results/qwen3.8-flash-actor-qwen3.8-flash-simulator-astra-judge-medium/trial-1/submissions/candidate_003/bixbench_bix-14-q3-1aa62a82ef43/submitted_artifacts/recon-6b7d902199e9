"""BixBench bix-14-q3 RECONNAISSANCE ONLY (no final answer).
Inspects VarSeq exports, CHIP gene list, Trio status; produces raw (unfiltered-by-gene)
distributions needed to design the filtering pipeline."""
import glob, re, zipfile, collections, openpyxl, pandas as pd

VARSEQ = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
CHIP_X = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
TRIO_X = "data/230215_Trio_Status.xlsx"
OUT = open("work/recon_report.txt", "w")
def p(*a):
    s = " ".join(str(x) for x in a); print(s); OUT.write(s + "\n")

def read_varsheet(path):
    """VarSeq exports have a broken/absent <dimension> tag -> reset_dimensions(),
    2 header rows (row1 = annotation-group titles w/ merged blanks, row2 = field names)."""
    wb = openpyxl.load_workbook(path, read_only=True); ws = wb[wb.sheetnames[0]]
    ws.reset_dimensions(); it = ws.iter_rows(values_only=True)
    grp, hdr = next(it), tuple(next(it))[:33]
    rows = [tuple(r) + (None,) * (33 - len(r)) for r in it]
    sheet = wb.sheetnames[0]; wb.close()
    return sheet, grp, hdr, rows

p("=== 1) FILES / LAYOUT ===")
p("n VarSeq files:", len(VARSEQ))
hdrs, raw_rows, sheetnames = collections.Counter(), {}, collections.Counter()
recs, titles = [], {}
for f in VARSEQ:
    sheet, grp, hdr, rows = read_varsheet(f)
    hdrs[hdr] += 1; sheetnames[sheet] += 1; raw_rows[f] = rows
    sid = f.split("CHIP_")[-1][:-5]
    titles[sid] = [v for v in grp if v and "(" in str(v)][0]
    z = zipfile.ZipFile(f); xs = sorted(n for n in z.namelist() if n.startswith("xl/worksheets/sheet"))
    xml = z.read(xs[0]).decode("utf8", "ignore")
    n_xml = len(re.findall(r"<row ", xml)); dim = re.findall(r'<dimension ref="([^"]*)"', xml)
    assert n_xml - 2 == len(rows), (f, n_xml, len(rows))          # alignment/row-count validation
    idx = {n: i for i, n in enumerate(hdr)}
    for r in rows:
        recs.append((f.split("CHIP_")[-1], r[idx["Chr:Pos"]], r[idx["Ref/Alt"]], r[idx["Zygosity"]],
                     r[idx["Sequence Ontology (Combined)"]], r[idx["Effect (Combined)"]],
                     r[idx["Gene Names"]], r[idx["Exon Number (Clinically Relevant)"]],
                     r[idx["Filter"]], r[idx["In_CHIP"]], r[idx["Read Depths (DP)"]],
                     r[idx["Variant Allele Freq"]], r[idx["HGVS c. (Clinically Relevant)"]]))
p("distinct row2 header tuples across files:", len(hdrs), "| distinct sheets:", len(sheetnames))
p("all files 33 cols:", all(len(k) == 33 for k in hdrs), "| all row counts == raw <row>-2: OK")
p("files w/ broken dimension tag:", sum(1 for f in VARSEQ
    if re.findall(r'<dimension ref="([^"]*)"', zipfile.ZipFile(f).read(
        sorted(n for n in zipfile.ZipFile(f).namelist() if n.startswith("xl/worksheets/sheet"))[0]
        ).decode("utf8","ignore"))[0] != "A1:AG%d" % (raw_rows[f].__len__()+2)), "of 86")
p("sample-title prefixes:", dict(collections.Counter(t.split(" (")[0] for t in titles.values())))
p("title ID == filename ID for all 86:", all(t.split("(")[1][:-1] == k for k, t in titles.items()))
df = pd.DataFrame(recs, columns=["file","chrpos","refalt","zyg","so","effect","gene","exon",
                                 "filter","inchip","dp","vaf","hgvs"])

p("\n=== 2) COLUMN ROLES ===")
p("row2 field names:", list(hdrs.most_common(1)[0][0]))
p("localization field = 'Sequence Ontology (Combined)'; 'Effect (Combined)' is coarse:",
  sorted(df.effect.dropna().unique()))
p("'Flags' columns = Primary/Incidental Findings booleans only (no localization)")
p("gene field = 'Gene Names'; multi-gene cells:", int(df.gene.astype(str).str.contains(",").sum()),
  "rows; examples:", df[df.gene.astype(str).str.contains(",")].gene.unique()[:5].tolist())
p("no NM_/semicolon in Gene Names:", df.gene.astype(str).str.contains("NM_|;").sum() == 0)
p("Zygosity value counts:", df.zyg.value_counts(dropna=False).to_dict())
for lab, val in [("Reference", "Reference"), ("blank", None)]:
    s = df[df.zyg.isna()] if val is None else df[df.zyg == val]
    p(f"  {lab}: DP missing {int(s.dp.isna().sum())}/{len(s)}, VAF missing {int(s.vaf.isna().sum())}/{len(s)}")
    p("   e.g.", s[["file","chrpos","refalt","zyg","dp","vaf"]].head(3).values.tolist())
p("examples het/hom rows:", df[df.zyg.isin(['Heterozygous','Homozygous Variant'])]
    [["chrpos","refalt","zyg","dp","vaf"]].head(3).values.tolist())
p("Filter values:", dict(df["filter"].value_counts()), "| In_CHIP:", dict(df.inchip.value_counts()))

p("\n=== 3) CHIP GENE LIST ===")
g = pd.read_excel(CHIP_X, header=None)
p("shape (header=None):", g.shape, "-> n genes:", len(g), "first:", g.iloc[0,0], "last:", g.iloc[-1,0])
p("duplicates:", [k for k,v in collections.Counter(g[0]).items() if v > 1],
  "| non-symbol cells:", [x for x in g[0] if not str(x).replace("-","").isalnum()])
p("WARNING: default header=0 would silently drop ABL1 ->", pd.read_excel(CHIP_X).shape)
chip = set(g[0].astype(str).str.strip())
df["chip"] = df.gene.astype(str).str.split(",").map(lambda L: bool({x.strip() for x in L} & chip))
p("rows whose Gene Names contain no Schenz-list gene:", int((~df.chip).sum()))
p("  their genes:", sorted({x for c in df[~df.chip].gene for x in str(c).split(",")}))

p("\n=== 4) TRIO STATUS vs 86 FILES ===")
t = pd.read_excel(TRIO_X); t.columns = [c.strip() for c in t.columns]
t["id"] = t["Sample ID"].astype(str).str.strip()
p("rows:", len(t), "unique IDs:", t.id.nunique(), "| statuses:", dict(t.Status.astype(str).str.strip().value_counts()))
p("IDs/Status needing .strip():", sum(x != x.strip() for x in t["Sample ID"].astype(str)))
base = {k: (k if k.startswith("SRR") else k.split("-")[0]) for k in titles}
p("86 file IDs -> unique trio IDs:", len(set(base.values())), "| all present in trio:", set(base.values()) <= set(t.id))
p("trio IDs with NO VarSeq file:", sorted(set(t.id) - set(base.values())))
p("=> Trio_Status is metadata only (BLM/sex/age/cancer); the 86 count comes from the file set")

p("\n=== 5) RAW DUMP (no gene filter) ===")
p("total variant rows:", len(df), "| unique variants (chr:pos+ref/alt):", df.groupby(["chrpos","refalt"]).ngroups,
  "| per-file rows min/med/max:", df.groupby("file").size().min(),
  int(df.groupby("file").size().median()), df.groupby("file").size().max())
p("within-file exact duplicate (chrpos,refalt) rows:", int(len(df) - df.groupby(["file","chrpos","refalt"]).ngroups))
INTR={"intron_variant"}; UTR={"3_prime_UTR_variant","5_prime_UTR_variant","5_prime_UTR_premature_start_codon_gain_variant"}; UP={"upstream_gene_variant"}
df["loc"]=df.so.map(lambda s:"intronic" if s in INTR else "UTR" if s in UTR else "intergenic/upstream" if s in UP else "exonic")
p("\nSO term x Zygosity:\n", pd.crosstab(df.so, df.zyg.fillna("<blank>"), margins=True).to_string())
nr = df.zyg.isin(["Heterozygous","Homozygous Variant"])
p("\nloc x chip_match x Zygosity:\n", pd.crosstab([df["loc"], df.chip], df.zyg.fillna("<blank>"), margins=True).to_string())
for lab, s in [("In_CHIP=True as exported", df[nr]), ("Schenz gene-name match", df[nr & df.chip])]:
    p(f"\nNON-REFERENCE ({lab}):", s["loc"].value_counts().to_dict())
    p("   exonic per-sample-sum:", int((s["loc"]=="exonic").sum()),
      "| exonic unique variants:", s[s["loc"]=="exonic"].groupby(["chrpos","refalt"]).ngroups)
sp = df[nr & (df.so=="splice_region_variant")]
p("\nsplice_region non-ref rows:", len(sp), "| HGVS all intronic-flank:",
  int(sp.hgvs.astype(str).str.contains(r"[+-]\d").sum()), "of", len(sp))
p("upstream_gene_variant non-ref rows:", int((nr & (df.so=='upstream_gene_variant')).sum()))
OUT.close()
