"""
BixBench bix-16-q2: Skewness of gene expression (log2(TPM+1), batch-corrected)
across all cell lines in the DepMap-style capsule.

Inputs : data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
         (rows = 1,673 cell lines ACH-*, cols = 19,138 protein-coding genes)
Outputs: prints pooled & per-cell-line skewness/kurtosis, quantiles, robustness
         subsample check, and numerical-stability cross-checks.

Method notes
- Pooled statistic: Fisher-Pearson skewness via scipy.stats.skew(..., bias=True)
  on the flattened float64 array (all 32,017,874 values).
- Numerical stability: the flattened array is float64; additionally a two-pass
  computation is run (exact mean via pairwise np.sum, then second central
  moments m2, m3) and compared to the scipy value to rule out precision loss
  in the third-moment accumulation.
- Negative values (batch correction) are kept unclipped, per plan.
- CRISPRGeneEffect.csv and Model.csv are not used.
"""
import numpy as np
import pandas as pd
from scipy import stats

EXPR = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"

print("Loading expression matrix ...", flush=True)
df = pd.read_csv(EXPR, index_col=0)
vals = df.to_numpy(dtype=np.float64, copy=False)
assert vals.dtype == np.float64
n = vals.size
print(f"shape={vals.shape}  n_values={n:,}  dtype={vals.dtype}  "
      f"NaNs={int(np.isnan(vals).sum())}  infs={int(np.isinf(vals).sum())}")

flat = vals.ravel(order="C")           # 1-D float64 view/copy, 32,017,874 elems
assert flat.dtype == np.float64 and flat.size == n

# ---------- 1) Pooled distribution ----------
pooled_skew = stats.skew(flat, bias=True)          # Fisher-Pearson, g1
pooled_kurt = stats.kurtosis(flat, bias=True)      # excess kurtosis, g2
mean = float(np.mean(flat))
sd   = float(np.std(flat, ddof=0))
qs   = [0.01, 0.05, 0.25, 0.50, 0.75, 0.95, 0.99]
quants = np.quantile(flat, qs)

print("\n=== 1) Pooled over all cell lines x genes ===")
print(f"skewness (scipy.stats.skew, bias=True): {pooled_skew:.6f}")
print(f"excess kurtosis                        : {pooled_kurt:.6f}")
print(f"mean={mean:.4f}  median={np.median(flat):.4f}  sd={sd:.4f}  "
      f"min={flat.min():.4f}  max={flat.max():.4f}")
for q, v in zip(qs, quants):
    print(f"  q{int(q*100):02d} = {v:.4f}")
print(f"%% negative values = {100.0*(flat < 0).mean():.3f}%   "
      f"(kept unclipped; batch-correction artefacts, not raw-TPM scale)")

# ---------- numerical stability cross-check (two-pass) ----------
m = float(np.sum(flat, dtype=np.float64) / n)      # pairwise-sum mean
d = flat - m
m2 = float(np.sum(d*d, dtype=np.float64) / n)
m3 = float(np.sum(d*d*d, dtype=np.float64) / n)
g1_twopass = (m2 ** 1.5) and (m3 / (m2 ** 1.5))
print(f"\n[two-pass check] mean={m!r}  m2={m2!r}  m3={m3!r}")
print(f"[two-pass check] g1 = {g1_twopass:.6f}  |diff vs scipy| = "
      f"{abs(g1_twopass - pooled_skew):.3e}")
assert abs(g1_twopass - pooled_skew) < 1e-8, "precision mismatch!"

# ---------- 2/3) Per-cell-line skewness & excess kurtosis ----------
skew_lines = stats.skew(vals, axis=1, bias=True)   # one value per cell line
kurt_lines = stats.kurtosis(vals, axis=1, bias=True)
q1, q3 = np.percentile(skew_lines, [25, 75])
print("\n=== 2) Per-cell-line skewness across genes (n=1,673 lines) ===")
print(f"mean={skew_lines.mean():.4f}  median={np.median(skew_lines):.4f}  "
      f"min={skew_lines.min():.4f}  max={skew_lines.max():.4f}  "
      f"IQR=[{q1:.4f}, {q3:.4f}]")
print(f"percent of lines with positive skew = {100.0*(skew_lines>0).mean():.3f}%")
neg = np.where(skew_lines <= 0)[0]
if len(neg):
    ids = df.index[skew_lines <= 0]
    for lid, sv in zip(ids, skew_lines[skew_lines <= 0]):
        print(f"  non-positive-skew line: {lid}  skew={sv:.4f}")
else:
    print("  no cell line has negative or zero skewness (min > 0)")

print("\n=== 3) Excess kurtosis per cell line ===")
kq1, kq3 = np.percentile(kurt_lines, [25, 75])
print(f"mean={kurt_lines.mean():.4f}  median={np.median(kurt_lines):.4f}  "
      f"min={kurt_lines.min():.4f}  max={kurt_lines.max():.4f}  "
      f"IQR=[{kq1:.4f}, {kq3:.4f}]")
print(f"percent of lines with positive excess kurtosis = "
      f"{100.0*(kurt_lines>0).mean():.3f}%")

# ---------- 5) Robustness: deterministic 2M subsample ----------
rng = np.random.default_rng(42)
idx = rng.choice(n, size=2_000_000, replace=False)
sub = flat[idx]
sub_skew = stats.skew(sub, bias=True)
print("\n=== 5) Robustness: deterministic subsample (seed=42, 2,000,000 values) ===")
print(f"subsample skewness = {sub_skew:.6f}   "
      f"|full - sub| = {abs(pooled_skew - sub_skew):.6f}")

print("\nSUMMARY (3 s.f.): pooled skewness ≈ "
      f"{pooled_skew:.3g}, excess kurtosis ≈ {pooled_kurt:.3g}")
