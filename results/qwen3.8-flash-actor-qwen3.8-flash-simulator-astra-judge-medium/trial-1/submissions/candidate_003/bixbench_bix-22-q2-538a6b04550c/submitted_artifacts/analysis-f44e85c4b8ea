#!/usr/bin/env python3
"""
BixBench bix-22-q2
Question: Pearson correlation coefficient between gene length and mean expression
(across samples) for protein-coding genes in CD4 immune cells.

RESEARCHER RULINGS (fixed 2026-10-25, encoded as requirements below):
  R1. CD4 samples come from Sample_annotated_Zenodo.csv celltype == 'CD4' -> exactly 151 columns.
      Name-token matching is used ONLY as an assertion, never as the source of the sample set.
  R2. NO de-duplication of donors: all 151 samples, including both copies of L619 / L631 / A082.
      (148-donor variant is a SENSITIVITY row only, not the answer.)
  R3. NO depth-based sample exclusion: L367CD4 (1.93M) is KEPT. (drop-L367CD4 = sensitivity only.)
  R4. 'Length' is the only length-like field in GeneMetaInfo -> used as-is. Treated as an ASSUMPTION:
      the file does not reveal whether it is genomic span or exonic/transcript length.
      Write-up wording: "length as tabulated in GeneMetaInfo".
  R5. One row per gene is guaranteed (Geneid unique; matrix index == metadata index) -> inner join on
      gene id, no aggregation, NO silent dropna.
  R6. HEADLINE gene set = ALL protein-coding genes with a valid Length, n = 19,942.
      gene_biotype must equal 'protein_coding' EXACTLY; the 12 composite ';'-joined biotype strings are
      EXCLUDED here (they appear only in the 19,954 sensitivity variant). Zero-mean genes (1,518) are KEPT.

HEADLINE METHOD (unchanged, required):
  scipy.stats.pearsonr on (Length, arithmetic mean across the 151 CD4 columns), RAW scale,
  no log, no CPM/normalisation, no rank transform, pairwise-complete rows only.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats

DATA = "data"
OUT = "outputs"
R = {}   # results dict -> JSON artifact
log = []
def say(*a):
    s = " ".join(str(x) for x in a)
    log.append(s)
    print(s, flush=True)

# ---------------------------------------------------------------- load
meta = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv", index_col=0)
cnt  = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
ann  = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")
say(f"[load] matrix={cnt.shape} meta={meta.shape} ann={ann.shape}")
R["shapes"] = {"matrix": list(cnt.shape), "meta": list(meta.shape), "annotation": list(ann.shape)}

# ---------------------------------------------------------------- alignment asserts (R5)
assert meta.index.is_unique and cnt.index.is_unique
assert set(cnt.index) == set(meta.index)
assert set(cnt.columns) == set(ann["sample"])
R["alignment"] = {
    "matrix_index_equals_meta_index_same_order": bool((cnt.index == meta.index).all()),
    "matrix_columns_equal_annotation_keys": bool(set(cnt.columns) == set(ann["sample"])),
    "n_matrix_samples": int(cnt.shape[1]),
}

# ---------------------------------------------------------------- CD4 sample set (R1, R2, R3)
cd4 = ann.loc[ann["celltype"] == "CD4", "sample"].tolist()
assert len(cd4) == 151, f"expected 151 CD4 samples, got {len(cd4)}"
assert set(cd4) == {c for c in cnt.columns if "CD4" in c}, "annotation-vs-name-token CD4 sets differ"
cd4 = [c for c in cnt.columns if c in set(cd4)]      # keep matrix column order
cd4_idx = cnt[cd4]
say(f"[cd4] n samples = {len(cd4)}  (name-token assert passed; no donor de-dup; L367CD4 kept)")
R["cd4_n_samples"] = len(cd4)
R["cd4_samples"] = cd4

# ---------------------------------------------------------------- mean expression (raw scale)
mean_cd4 = cd4_idx.mean(axis=1).astype("float64")     # arithmetic mean, no normalisation / no log
assert mean_cd4.isna().sum() == 0
say(f"[mean] genes={mean_cd4.shape[0]} NaN={int(mean_cd4.isna().sum())} "
    f"min={mean_cd4.min():.6g} median={mean_cd4.median():.6g} max={mean_cd4.max():.6g}")

# ---------------------------------------------------------------- gene set (R6)
meta = meta.join(mean_cd4.rename("mean_CD4"))
pc = meta[meta["gene_biotype"] == "protein_coding"].copy()
say(f"[genes] exact 'protein_coding' = {len(pc)}")

length = pd.to_numeric(pc["Length"], errors="coerce")
complete = length.notna() & pc["mean_CD4"].notna()
n_dropped = int((~complete).sum())
say(f"[pairwise-complete] rows before={len(pc)} dropped={n_dropped} used={int(complete.sum())}")
R["headline_row_accounting"] = {
    "protein_coding_genes": int(len(pc)),
    "rows_dropped_nonfinite": n_dropped,
    "rows_used": int(complete.sum()),
}
x = length[complete].to_numpy(dtype="float64")
y = pc.loc[complete, "mean_CD4"].to_numpy(dtype="float64")

# ---------------------------------------------------------------- HEADLINE Pearson
r, p = stats.pearsonr(x, y)
finite = bool(np.isfinite(r) and np.isfinite(p))
say(f"[HEADLINE] Pearson r = {r:.10f}   p = {p:.6e}   n = {len(x)}   finite = {finite}")
assert finite, "pearsonr returned non-finite value"
assert len(x) == 19942
R["headline"] = {
    "variable_x": "Length (as tabulated in GeneMetaInfo)",
    "variable_y": "arithmetic mean of BatchCorrectedReadCounts across 151 CD4 samples (raw scale)",
    "gene_filter": "gene_biotype == 'protein_coding' (exact); zero-mean genes kept",
    "n_genes": int(len(x)),
    "pearson_r": float(r),
    "pearson_r_str": f"{r:.10f}",
    "p_value": float(p),
    "r_squared": float(r * r),
    "finite": finite,
    "n_rows_dropped_nonfinite": n_dropped,
    "nan_genes": int(pc["mean_CD4"].isna().sum() + length.isna().sum()),
    "n_genes_zero_mean_kept": int((pc["mean_CD4"] == 0).sum()),
}

# ---------------------------------------------------------------- per-gene artifact
pergene = pc.loc[complete, ["Geneid", "Chr", "Length", "gene_biotype", "mean_CD4"]].copy()
pergene.to_csv(f"{OUT}/per_gene_length_vs_mean_CD4.csv", index=False)
say(f"[artifact] per-gene table rows={len(pergene)} -> outputs/per_gene_length_vs_mean_CD4.csv")

# ---------------------------------------------------------------- SENSITIVITY (NOT the answer)
sens = []
def add(name, n, rx, px, note):
    sens.append({"variant": name, "n_genes_or_samples": n, "stat": rx, "p_value": px, "note": note})
    say(f"[sens] {name:<38} n={n:<7} value={rx:.10f}  p={px:.6e}  {note}")

# S1: drop zero-mean genes
m = y > 0
r1, p1 = stats.pearsonr(x[m], y[m]); add("drop zero-mean genes", int(m.sum()), r1, p1, "1518 zero-mean genes removed")
# S2: composite biotype strings that contain a 'protein_coding' token
pc2 = meta[meta["gene_biotype"].astype(str).str.contains("protein_coding", regex=False)].copy()
l2 = pd.to_numeric(pc2["Length"], errors="coerce"); c2 = l2.notna() & pc2["mean_CD4"].notna()
r2, p2 = stats.pearsonr(l2[c2].to_numpy(float), pc2.loc[c2, "mean_CD4"].to_numpy(float))
add("composite biotypes included", int(c2.sum()), r2, p2, "exact + 12 ';'-joined rows = 19954")
# S3: 148 de-duplicated CD4 donors (keep first sample per donor) - samples change, gene set same
donor = pd.Series([__import__("re").sub(r"_\d+$", "", s) for s in cd4], index=cd4)
dd = [s for i, s in enumerate(cd4) if list(donor.values).index(donor.values[i]) == i]
m3 = cnt[dd].mean(axis=1).astype("float64")
j3 = meta.join(m3.rename("m"))
pc3 = j3[j3["gene_biotype"] == "protein_coding"]
r3, p3 = stats.pearsonr(pd.to_numeric(pc3["Length"], errors="coerce").to_numpy(float),
                        pc3["m"].to_numpy(float))
add("148 de-duplicated CD4 samples", len(dd), r3, p3, "one sample per donor; gene set 19942")
# S4: drop L367CD4
cd4s = [c for c in cd4 if c != "L367CD4"]
m4 = cnt[cd4s].mean(axis=1).astype("float64")
pc4 = meta.join(m4.rename("m")); pc4 = pc4[pc4["gene_biotype"] == "protein_coding"]
r4, p4 = stats.pearsonr(pd.to_numeric(pc4["Length"], errors="coerce").to_numpy(float),
                        pc4["m"].to_numpy(float))
add("drop L367CD4 (lowest depth)", len(cd4s), r4, p4, "150 samples; gene set 19942")
# S5: log10(Length) vs log1p(mean)
r5, p5 = stats.pearsonr(np.log10(x), np.log1p(y)); add("log10(Length) vs log1p(mean)", len(x), r5, p5, "transformed scale")
# S6: Spearman (rank)
rs, ps = stats.spearmanr(x, y); add("Spearman (rank transform)", len(x), rs, ps, "rank-based, not Pearson")

pd.DataFrame(sens).to_csv(f"{OUT}/sensitivity_variants.csv", index=False)
R["sensitivity_NOT_the_answer"] = sens
R["answer"] = (f"Pearson r = {r:.4f} (r = {r:.10f}; p = {p:.3e}; n = {len(x)} protein-coding genes, "
               f"151 CD4 samples)")
say(f"[answer] {R['answer']}")

with open(f"{OUT}/results.json", "w") as f:
    json.dump(R, f, indent=2)
with open(f"{OUT}/run_log.txt", "w") as f:
    f.write("\n".join(log) + "\n")
say("[done] wrote outputs/results.json, outputs/sensitivity_variants.csv, outputs/run_log.txt")
