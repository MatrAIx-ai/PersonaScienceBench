#!/usr/bin/env python3
"""Independent cross-check of the headline r for bix-22-q2.
Deliberately avoids reusing the pandas matrix read: the count matrix is parsed with the stdlib
csv reader, per-gene sums over the 151 CD4 columns are accumulated by hand, and Pearson's r is
computed from the covariance/standard-deviation definition. Compared against scipy.stats.pearsonr
(headline) and numpy.corrcoef on the written per-gene artifact.
Fixed definitions (per researcher ruling): CD4 = annotation celltype=='CD4' (151 samples, no
de-duplication, no depth exclusion); gene set = exact 'protein_coding' (19,942), zero-mean kept."""
import csv, math
import numpy as np, pandas as pd
from scipy import stats

ann = pd.read_csv('data/Sample_annotated_Zenodo.csv')
meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)
cd4 = set(ann.loc[ann.celltype == 'CD4', 'sample']); assert len(cd4) == 151

S = {}; K = {}
with open('data/BatchCorrectedReadCounts_Zenodo.csv') as f:
    r = csv.reader(f); hdr = next(r)
    idx = [i for i, c in enumerate(hdr) if c in cd4]; assert len(idx) == 151
    for row in f and r:
        s = 0; k = 0
        for i in idx:
            v = row[i]
            if v != '':
                s += int(v); k += 1
        S[row[0]] = s; K[row[0]] = k

pc = meta.index[(meta.gene_biotype == 'protein_coding').to_numpy()].tolist()
xs = []; ys = []; skipped = 0
for g in pc:
    a = float(meta.at[g, 'Length'])
    if not (math.isfinite(a) and a > 0) or g not in S or K[g] != 151:
        skipped += 1; continue
    xs.append(a); ys.append(S[g] / 151.0)
n = len(xs); mx = sum(xs)/n; my = sum(ys)/n
sxy = sum((a-mx)*(b-my) for a, b in zip(xs, ys)); sxx = sum((a-mx)**2 for a in xs); syy = sum((b-my)**2 for b in ys)
r_manual = sxy / math.sqrt(sxx*syy)
r_scipy, p = stats.pearsonr(np.asarray(xs, float), np.asarray(ys, float))
art = pd.read_csv('outputs/per_gene_length_vs_mean_CD4.csv')
r_np = float(np.corrcoef(art['Length'].to_numpy(float), art['mean_CD4'].to_numpy(float))[0, 1])
lines = [
    f"protein_coding genes found          : {len(pc)}",
    f"rows used (pairwise-complete)       : {n}",
    f"rows skipped (non-finite/Incomplete): {skipped}",
    f"samples contributing per gene       : {min(K.values())}..{max(K.values())}",
    f"r manual (covariance definition)    : {r_manual:.12f}",
    f"r scipy.stats.pearsonr              : {r_scipy:.12f}  (p = {p:.6e})",
    f"r numpy.corrcoef on artifact        : {r_np:.12f}",
    f"max abs disagreement                : {max(abs(r_manual-r_scipy), abs(r_manual-r_np)):.3e}",
    f"all three finite                    : {all(map(math.isfinite, [r_manual, r_scipy, r_np]))}",
]
print("\n".join(lines))
assert abs(r_manual - r_scipy) < 1e-9 and abs(r_manual - r_np) < 1e-9
open('outputs/independent_check.txt', 'w').write("\n".join(lines) + "\n")
print("wrote outputs/independent_check.txt")
