#!/usr/bin/env python3
"""
BixBench bix-22-q4 (read-count capsule):
Pearson correlation between gene length and mean expression (across samples)
for protein-coding genes in CD14 immune cells.

Approved protocol:
- CD14 columns: regex ^...CD14(_\d+)?$ on count-matrix columns, cross-checked
  against Sample_annotated celltype == 'CD14' (sets verified identical).
- mean expression = arithmetic mean of given batch-corrected values AS-IS
  (raw-count scale; no filtering, no CPM, no log) across the 132 CD14 samples.
- protein-coding: exact gene_biotype == 'protein_coding' (n = 19,942).
  Sensitivity note only: str.contains('protein_coding') variant (+12 genes).
- Length used exactly as supplied (bp); both L631 CD14 replicates kept.
"""
import re
import numpy as np
import pandas as pd
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANN = "data/Sample_annotated_Zenodo.csv"

# ---- load ----
meta = pd.read_csv(META)
cnt = pd.read_csv(COUNTS, index_col=0)
ann = pd.read_csv(ANN)

# ---- CD14 sample selection (regex) + cross-check vs annotation ----
cd14_cols = [c for c in cnt.columns if re.search(r"CD14(_\d+)?$", c)]
cd14_ann = sorted(ann.loc[ann["celltype"] == "CD14", "sample"])
assert set(cd14_cols) == set(cd14_ann), "CD14 set mismatch regex vs annotation!"
n_samples = len(cd14_cols)
print(f"CD14 columns (regex): {n_samples} | annotated CD14: {len(cd14_ann)} | identical sets: True")

# ---- mean expression across CD14 samples, as-is ----
mean_expr = cnt[cd14_cols].mean(axis=1).rename("mean_expr")

# ---- protein-coding subset (exact label) ----
pc = meta.loc[meta["gene_biotype"] == "protein_coding", ["Geneid", "Length"]]
assert pc["Geneid"].duplicated().sum() == 0

df = pc.merge(mean_expr.rename("mean_expr"), left_on="Geneid", right_index=True, how="inner")
n_genes = len(df)
print(f"Protein-coding genes (exact): {len(pc)} | joined with expression: {n_genes}")

# ---- MAIN: Pearson r, untransformed ----
r_main, p_main = stats.pearsonr(df["Length"], df["mean_expr"])
# Fisher z 95% CI
z = np.arctanh(r_main); se = 1/np.sqrt(n_genes - 3)
ci = (np.tanh(z - 1.959963985*se), np.tanh(z + 1.959963985*se))
print("\n=== MAIN ANSWER ===")
print(f"Pearson r = {r_main:.6f}  (full precision: {r_main!r})")
print(f"n genes = {n_genes}, n samples = {n_samples}")
print(f"two-sided p = {p_main:.6e}   95% CI (Fisher z) = [{ci[0]:.6f}, {ci[1]:.6f}]")

# ---- transformation sanity notes (NOT the answer) ----
le = np.log1p(df["mean_expr"]); ll = np.log1p(df["Length"])
r_logx, p_logx = stats.pearsonr(df["Length"], le)
r_logboth, p_logboth = stats.pearsonr(ll, le)
print("\n=== Transformation sanity notes (not the answer) ===")
print(f"r(Length, log1p(mean_expr))       = {r_logx:.6f}  (p = {p_logx:.3e})")
print(f"r(log1p(Length), log1p(mean_expr))= {r_logboth:.6f}  (p = {p_logboth:.3e})")

# ---- sensitivity: contains('protein_coding') (12 extra compound-label genes) ----
pc2 = meta.loc[meta["gene_biotype"].str.contains("protein_coding"), ["Geneid", "Length"]]
df2 = pc2.merge(mean_expr.rename("mean_expr"), left_on="Geneid", right_index=True, how="inner")
r_c, p_c = stats.pearsonr(df2["Length"], df2["mean_expr"])
print(f"\nSensitivity contains('protein_coding'): n = {len(df2)}, r = {r_c:.6f} (p = {p_c:.3e})")

# ---- skew / leverage diagnostics ----
me = df["mean_expr"]
print("\n=== Skew diagnostics ===")
print(f"median(mean_expr) = {me.median():.4f} | max(mean_expr) = {me.max():.2f}")
print(f"genes with mean_expr == 0: {(me == 0).sum()} ({(me == 0).mean()*100:.3f}%)")
print(f"Length: median = {df['Length'].median():.0f}, max = {df['Length'].max()}")
top = df.nlargest(10, "mean_expr")[["Geneid", "Length", "mean_expr"]]
print("Top-10 expressed protein-coding genes:\n", top.to_string(index=False))
# leverage check: drop top-0.5% expressed genes and the top-0.5% longest
keep = df[(df["mean_expr"] < df["mean_expr"].quantile(0.995)) &
          (df["Length"] < df["Length"].quantile(0.995))]
r_trim, p_trim = stats.pearsonr(keep["Length"], keep["mean_expr"])
print(f"r after trimming top 0.5% on BOTH variables: r = {r_trim:.6f} (n = {len(keep)}, p = {p_trim:.3e})")
# Spearman as robustness reference
rho, p_rho = stats.spearmanr(df["Length"], df["mean_expr"])
print(f"Spearman rho (reference only) = {rho:.6f} (p = {p_rho:.3e})")
