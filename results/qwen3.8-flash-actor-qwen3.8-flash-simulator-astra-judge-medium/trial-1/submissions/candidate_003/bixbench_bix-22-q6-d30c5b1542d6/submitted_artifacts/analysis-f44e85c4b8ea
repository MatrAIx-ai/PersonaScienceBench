"""
bix-22-q6: Pearson correlation between gene length and gene expression,
protein-coding genes only.

Locked rulings:
  A. protein-coding = exact equality gene_biotype == "protein_coding"
  B. expression = arithmetic mean of batch-corrected read count across all samples, RAW scale
  C. zero-expression genes KEPT (no expression filtering)
  D. reported statistic = Pearson r on RAW Length vs RAW mean expression; p, n = context only
  E. all 723 samples, no subsetting; Sample_annotated_Zenodo.csv NOT used in the calculation
  F. Length (bp) used as-is, untransformed
  G. no dedup/aggregation step (duplicate gene IDs verified absent at inspection)

Reported value computed with scipy.stats.pearsonr (cross-checked against an
explicit covariance/std-division formula). pandas .corr() is not used for the
reported number.
"""
import numpy as np
import pandas as pd
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
BIOTYPE_LABEL = "protein_coding"

print("=" * 78)
print("STEP 0. load inputs")
print("=" * 78)
# index_col=0 consumes the redundant unnamed leading column (verified at inspection
# to be a byte-identical duplicate of Geneid); it is NOT used as the join key.
meta = pd.read_csv(META)
counts = pd.read_csv(COUNTS, index_col=0)
print(f"GeneMetaInfo           : {meta.shape[0]} rows x {meta.shape[1]} cols  cols={list(meta.columns)}")
print(f"BatchCorrectedReadCounts: {counts.shape[0]} genes x {counts.shape[1]} samples (samples in header)")
assert list(meta.columns)[0] == "Unnamed: 0"
assert (meta["Unnamed: 0"] == meta["Geneid"]).all(), "leading column differs from Geneid"
print("leading unnamed column == Geneid for every row: True (redundant, not used as join key)")
print(f"counts dtype set        : {set(map(str, counts.dtypes))}; NaNs={int(counts.isna().sum().sum())}; "
      f"negatives={int((counts.values < 0).sum())}")
print(f"sample count used       : {counts.shape[1]} (all samples; Sample_annotated_Zenodo.csv unused)")
print("NOTE: Sample_annotated_Zenodo.csv is cohort documentation only; samtype/batch/sex NOT touched.")

print()
print("=" * 78)
print("STEP 1. ORDER OF OPERATIONS: biotype filter applied BEFORE the join")
print("=" * 78)
n_all_meta = meta.shape[0]
pc_mask = meta["gene_biotype"] == BIOTYPE_LABEL          # exact, case-sensitive equality
n_after_filter = int(pc_mask.sum())
print(f"genes in GeneMetaInfo before filter        : {n_all_meta}")
print(f"genes after exact biotype == '{BIOTYPE_LABEL}': {n_after_filter}")
print(f"other biotypes dropped                     : {n_all_meta - n_after_filter}")
print(f"(19,942-vs-59,453 filter applied BEFORE the inner join, on the meta table alone)")
print("Sensitivity (A-alt, NOT headline): rows whose biotype STRING CONTAINS 'protein_coding' "
      f"= {int(meta['gene_biotype'].str.contains(BIOTYPE_LABEL).sum())} "
      f"(+{int(meta['gene_biotype'].str.contains(BIOTYPE_LABEL).sum()) - n_after_filter} mixed multi-transcript labels)")

print()
print("=" * 78)
print("STEP 2. ALIGNMENT: inner join on gene ID")
print("=" * 78)
meta_pc = meta.loc[pc_mask, ["Geneid", "Length"]].copy()
expr = counts.mean(axis=1)                                # raw arithmetic mean, all samples
expr.name = "mean_expression"
aligned = meta_pc.merge(expr.reset_index().rename(columns={"index": "Geneid"}),
                        on="Geneid", how="inner")
n_after_join = aligned.shape[0]
print(f"protein-coding genes (meta side)           : {n_after_filter}")
print(f"genes present in counts matrix (all)       : {counts.shape[0]}")
print(f"genes after INNER JOIN on Geneid           : {n_after_join}")
print(f"dropped by join                            : {n_after_filter - n_after_join}")
print(f"gene IDs in meta but not in counts         : {len(set(meta_pc['Geneid']) - set(counts.index))}")
print(f"duplicated Geneid rows in meta table       : {int(meta['Geneid'].duplicated().sum())} (no dedup step, ruling G)")
assert n_after_join == n_after_filter, "join lost protein-coding genes"

print()
print("=" * 78)
print("STEP 3. NaN AUDIT on the two vectors fed to pearsonr")
print("=" * 78)
length = aligned["Length"].to_numpy(dtype=float)
expression = aligned["mean_expression"].to_numpy(dtype=float)
nan_len = int(np.isnan(length).sum())
nan_expr = int(np.isnan(expression).sum())
print(f"NaN in Length vector            : {nan_len}")
print(f"NaN in mean-expression vector   : {nan_expr}")
print(f"non-finite entries (inf etc.)   : {int((~np.isfinite(length)).sum() + ~np.isfinite(expression)).__class__(int((~np.isfinite(length+expression)).sum()) - (nan_len + nan_expr)) if False else int((~np.isfinite(length + expression)).sum() - nan_len - nan_expr)}")
print(f"genes dropped due to NaN        : {n_after_join - int((np.isfinite(length) & np.isfinite(expression)).sum())} (expected 0)")
print(f"zeros retained in expression    : {int((expression == 0).sum())} (ruling C: kept, no filtering)")
assert nan_len == 0 and nan_expr == 0, "NaNs survived into pearsonr inputs"
assert np.isfinite(length).all() and np.isfinite(expression).all()
n_used = length.shape[0]
print(f"FINAL n fed to pearsonr         : {n_used}")

print()
print("=" * 78)
print("STEP 4. HEADLINE RESULT (ruling B/D/F: raw Length vs raw mean expression)")
print("=" * 78)
r, p = stats.pearsonr(length, expression)
# explicit cross-check: cov/std division (ddof=1 on both terms cancels)
r_manual = ((length - length.mean()) * (expression - expression.mean())).sum() / (
    np.sqrt(((length - length.mean()) ** 2).sum()) * np.sqrt(((expression - expression.mean()) ** 2).sum()))
print(f"HEADLINE  Pearson r = {r:.6f}")
print(f"          n = {n_used} protein-coding genes (side info)")
print(f"          p = {p:.6e}  (side info only, not part of the answer)")
print(f"          r**2 = {r**2:.6f}")
print(f"          manual cov/std cross-check r = {r_manual:.6f}  |diff| = {abs(r - r_manual):.3e}")
assert abs(r - r_manual) < 1e-12

print()
print("=" * 78)
print("STEP 5. SENSITIVITY / ROBUSTNESS BLOCK (labelled side info - NOT the headline)")
print("=" * 78)
median_expr = counts.loc[meta_pc["Geneid"]].median(axis=1).to_numpy(dtype=float)
sum_expr = counts.loc[meta_pc["Geneid"]].sum(axis=1).to_numpy(dtype=float)
log_mean = np.log2(expression + 1.0)
rho, p_rho = stats.spearmanr(length, expression)
r_log, p_log = stats.pearsonr(length, log_mean)
r_logboth, p_logboth = stats.pearsonr(np.log10(length), log_mean)
print(f"[B-alt] median across samples        : Pearson r = {stats.pearsonr(length, median_expr)[0]:.6f}  p = {stats.pearsonr(length, median_expr)[1]:.3e}")
print(f"[B-alt] row sum across samples       : Pearson r = {stats.pearsonr(length, sum_expr)[0]:.6f}  p = {stats.pearsonr(length, sum_expr)[1]:.3e}")
print(f"[B-alt] mean of log2(count+1)        : Pearson r = {stats.pearsonr(length, log_mean)[0]:.6f}  p = {stats.pearsonr(length, log_mean)[1]:.3e}")
print(f"[A-alt] biotype CONTAINS label       : Pearson r = ", end="")
pc_contains = meta["gene_biotype"].str.contains(BIOTYPE_LABEL)
al2 = meta.loc[pc_contains, ["Geneid", "Length"]].merge(
    expr.reset_index().rename(columns={"index": "Geneid"}), on="Geneid", how="inner")
r2, p2 = stats.pearsonr(al2["Length"].to_numpy(float), al2["mean_expression"].to_numpy(float))
print(f"{r2:.6f}  (n = {al2.shape[0]})  p = {p2:.3e}")
print(f"[C-alt] drop the {int((expression == 0).sum())} zero-mean genes : Pearson r = "
      f"{stats.pearsonr(length[expression > 0], expression[expression > 0])[0]:.6f}  "
      f"(n = {int((expression > 0).sum())})")
print(f"[D-rob] Spearman rho (raw ranks)     : rho = {rho:.6f}  p = {p_rho:.3e}")
print(f"[D-rob] Pearson on log2(mean+1) expr : r = {r_log:.6f}  p = {p_log:.3e}")
print(f"[D-rob] Pearson on log10(Length) & log2(mean+1) : r = {r_logboth:.6f}  p = {p_logboth:.3e}")
print()
print(f"ANSWER: Pearson r between gene length and gene expression, protein-coding genes "
      f"(n = {n_used}) = {r:.4f}")
