"""Schema / QC inspection only (no correlation computed here)."""
import pandas as pd

g = pd.read_csv("data/GeneMetaInfo_Zenodo.csv")
c = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
s = pd.read_csv("data/Sample_annotated_Zenodo.csv")

print("GeneMetaInfo shape", g.shape, "cols", list(g.columns))
print("leading col identical to Geneid:", (g["Unnamed: 0"] == g["Geneid"]).all())
print("dup Geneid:", g["Geneid"].duplicated().sum(), "| missing:", g.isna().sum().sum())
print("biotypes:", g["gene_biotype"].nunique(),
      "| exact 'protein_coding':", (g["gene_biotype"] == "protein_coding").sum(),
      "| contains 'protein_coding':", g["gene_biotype"].str.contains("protein_coding").sum())
print("ReadCounts shape (genes x samples):", c.shape, "index name:", c.index.name)
print("integral:", (c.values == c.values.round()).all(), "| negatives:", (c.values < 0).sum(),
      "| NaNs:", c.isna().sum().sum(), "dtype:", c.dtypes.unique())
print("gene sets -> meta-only:", len(set(g.Geneid) - set(c.index)),
      "counts-only:", len(set(c.index) - set(g.Geneid)),
      "same order:", list(g.Geneid) == list(c.index))
print("Sample_annot shape", s.shape, "| samples match columns:",
      set(s["sample"]) == set(c.columns))
