"""CBD vs DMSO in CRC cells: DE (DESeq2-equivalent, pure Python fallback) +
GO-BP enrichment (reduced curated annotation, labelled) + directional statistics.
Outputs tables under /workspace/results/."""
import sys, re, time
sys.path.insert(0, '/workspace')
import numpy as np, pandas as pd
from scipy.stats import fisher_exact, binomtest, hypergeom
from de_core import run_deseq, bh
from annotation_bp import ANNOT, MET_REGEX

OUT = '/workspace/results/'
counts = pd.read_csv('/workspace/data/counts_raw_unfiltered.csv', index_col=0)
lay = pd.read_csv('/workspace/data/sample_layout.csv')
lay['col'] = lay['SampleID'].str.replace('-', '_')
assert set(lay['col']) == set(counts.columns)
grp = lay.set_index('col')['Group']

def make_set(samples):
    X = None
    return X

def analyze(samples, design_fn, tag, min_count=5, min_samples=3):
    import os
    if os.path.exists(OUT + f'de_{tag}.csv') and os.path.exists(OUT + f'sizefactors_{tag}.csv'):
        res = pd.read_csv(OUT + f'de_{tag}.csv', index_col=0)
        sf = pd.read_csv(OUT + f'sizefactors_{tag}.csv', index_col=0).iloc[:,0]
        up = ((res.padj<0.05)&(res.lfc>0.5)).sum(); dn = ((res.padj<0.05)&(res.lfc<-0.5)).sum()
        print(f"[{tag}] (cached) tested={len(res)} up={up} down={dn} total_DE={up+dn}", flush=True)
        return res, sf
    C = counts[samples]
    keep = (C >= min_count).sum(axis=1) >= min_samples
    Cf = C[keep]
    X = design_fn(samples)
    t = time.time()
    res, sf = run_deseq(Cf, X)
    sig = (res.padj < 0.05) & (res.lfc.abs() > 0.5)
    up = res[(res.padj < 0.05) & (res.lfc > 0.5)]
    dn = res[(res.padj < 0.05) & (res.lfc < -0.5)]
    res_out = res.copy()
    res_out['sample_set'] = tag
    res_out.to_csv(OUT + f'de_{tag}.csv')
    sf.to_csv(OUT + f'sizefactors_{tag}.csv')
    print(f"[{tag}] n={len(samples)} tested={len(Cf)} up={len(up)} down={len(dn)} "
          f"total_DE={len(up)+len(dn)} runtime={time.time()-t:.0f}s", flush=True)
    return res, sf

# ---------- PRIMARY: ~starvation + CBD, samples {3,4,7,8} ----------
prim = [s for s in counts.columns if s.split('_')[0] in ('3','4','7','8')]
def d_primary(ss):
    starve = np.array([1 if s.split('_')[0] in ('4','8') else 0 for s in ss], float)
    cbd    = np.array([1 if s.split('_')[0] in ('7','8') else 0 for s in ss], float)
    return np.column_stack([np.ones(len(ss)), starve, cbd])
res_p, sf_p = analyze(prim, d_primary, 'primary')

# ---------- SENSITIVITY 3v3: CBD_IC50 vs DMSO ----------
s33 = [s for s in counts.columns if s.split('_')[0] in ('3','7')]
def d_2g(ss):
    cbd = np.array([1 if s.split('_')[0]=='7' else 0 for s in ss], float)
    return np.column_stack([np.ones(len(ss)), cbd])
res_s, sf_s = analyze(s33, d_2g, 'sens_3v3')

# ---------- SENSITIVITY without 3_1 ----------
prim_no = [s for s in prim if s != '3_1']
res_n, sf_n = analyze(prim_no, d_primary, 'sens_no3_1')
sf_with_no = sf_p.drop('3_1').div(sf_n).dropna()
print("[3_1 check] size factor of 3_1 = %.3f (median %.3f); |sf ratio change| in others: max %.3f"
      % (sf_p['3_1'], sf_p.median(), (sf_with_no-1).abs().max()), flush=True)

# ---------- mapping sanity: known CBD/AHR targets ----------
print("\n[mapping sanity] known CBD-induced CYPs (primary):")
for g, name in [('ENSG00000140465','CYP1A1'),('ENSG00000138061','CYP1B1'),('ENSG00000140479','CYP1A2')]:
    if g in res_p.index:
        r = res_p.loc[g]
        print(f"  {name} {g}: log2FC={r.lfc:+.2f} padj={r.padj:.2g}")

# ---------- enrichment ----------
universe = [g for g in res_p.index if any(g in v for v in ANNOT.values())]
print(f"\n[annotation] tested genes (primary) = {len(res_p)}; with >=1 BP term HERE = {len(universe)}")

def enrich(direction_mask, tag):
    sel = set(res_p.index[direction_mask]) & set(universe)
    rows = []
    U = set(universe); n = len(sel); N = len(U)
    for term, gs in ANNOT.items():
        K = len(set(gs) & U); k = len(set(gs) & sel)
        p = hypergeom.sf(k-1, N, K, n) if k > 0 else 1.0
        rows.append((term, K, k, p))
    df = pd.DataFrame(rows, columns=['term','n_bg','n_hit','p']).sort_values('p')
    df['padj'] = bh(df.p.values)
    df['metabolic'] = df.term.str.contains(MET_REGEX, case=False)
    df['direction'] = tag
    df.to_csv(OUT + f'enrich_{tag}.csv', index=False)
    sig = df[df.padj < 0.05]
    print(f"[enrich {tag}] n_genes={n} | sig terms (padj<0.05): {len(sig)} | "
          f"raw p<0.05: {(df.p<0.05).sum()}")
    for _, r in df.head(5).iterrows():
        print(f"   {r.term:<42s} K={r.n_bg:>3} k={r.n_hit:>3} p={r.p:.2g} padj={r.padj:.2g}")
    return df

up_mask = (res_p.padj < 0.05) & (res_p.lfc > 0.5)
dn_mask = (res_p.padj < 0.05) & (res_p.lfc < -0.5)
e_up = enrich(up_mask, 'up')
e_dn = enrich(dn_mask, 'down')

# ---------- four directional readouts ----------
print("\n===== DIRECTIONAL READOUTS (primary) =====")
NT = len(ANNOT)
su = set(e_up[e_up.padj < 0.05].term); sd = set(e_dn[e_dn.padj < 0.05].term)
su_raw = set(e_up[e_up.p < 0.05].term); sd_raw = set(e_dn[e_dn.p < 0.05].term)
tab = [[len(su), NT-len(su)], [len(sd), NT-len(sd)]]
or_, p1 = fisher_exact(tab)
tabr = [[len(su_raw), NT-len(su_raw)], [len(sd_raw), NT-len(sd_raw)]]
or_r, p1r = fisher_exact(tabr)
print(f"R1 enriched BP terms: UP={len(su)} DOWN={len(sd)} (padj<0.05, {NT} terms tested)"
      f" | Fisher OR={or_:.2f} p={p1:.3g}  [raw p<0.05: up={len(su_raw)} down={len(sd_raw)} OR={or_r:.2f} p={p1r:.3g}]")
msu = {t for t in su if re.search(MET_REGEX, t, re.I)}; msd = {t for t in sd if re.search(MET_REGEX, t, re.I)}
print(f"R2 metabolic-relevant enriched terms: UP={len(msu)} DOWN={len(msd)}"
      f" | raw: UP={len([t for t in su_raw if re.search(MET_REGEX,t,re.I)])} DOWN={len([t for t in sd_raw if re.search(MET_REGEX,t,re.I)])}")

met_genes = set().union(*[v for t, v in ANNOT.items() if re.search(MET_REGEX, t, re.I)]) & set(universe)
U = set(universe)
up_g = set(res_p.index[up_mask]) & U; dn_g = set(res_p.index[dn_mask]) & U
a, b_ = len(met_genes & up_g), len(up_g - met_genes)
c, d_ = len(met_genes & dn_g), len(dn_g - met_genes)
or2, p2 = fisher_exact([[a, b_], [c, d_]])
print(f"R3 metabolic-annotated genes in UP vs DOWN (within annotated universe {len(U)} genes): "
      f"UP {a}/{len(up_g)} DOWN {c}/{len(dn_g)} | Fisher OR={or2:.2f} p={p2:.3g}")

shared_terms = sorted({t for t in e_up.term if e_up.set_index('term').loc[t,'p']<0.1 or e_dn.set_index('term').loc[t,'p']<0.1})
rows = []
for t in sorted(set(e_up.term) | set(e_dn.term)):
    gs = [g for g in ANNOT[t] if g in res_p.index]
    lf = res_p.loc[gs, 'lfc']
    nup_de = int(((lf > 0.5) & (res_p.loc[gs,'padj'] < 0.05)).sum())
    ndn_de = int(((lf < -0.5) & (res_p.loc[gs,'padj'] < 0.05)).sum())
    bt = binomtest(nup_de, max(nup_de+ndn_de,1), 0.5).pvalue if nup_de+ndn_de>0 else np.nan
    rows.append(dict(term=t, metabolic=bool(re.search(MET_REGEX,t,re.I)), n=res_p.index.isin(gs).sum(),
        mean_lfc=lf.mean(), median_lfc=lf.median(),
        frac_lfc_pos=float((lf>0).mean()),
        up_sig=nup_de, dn_sig=ndn_de, binom_p=bt,
        p_up=e_up.set_index('term').loc[t,'p'], p_dn=e_dn.set_index('term').loc[t,'p']))
r4 = pd.DataFrame(rows).sort_values('mean_lfc')
r4.to_csv(OUT + 'per_term_direction_stats.csv', index=False)
print("R4 mean/median log2FC of member genes, per term (most-negative first):")
print(r4[['term','n','mean_lfc','median_lfc','frac_lfc_pos','up_sig','dn_sig','p_up','p_dn']].to_string(index=False,
      float_format=lambda x: f"{x:.3g}"))
pd.DataFrame([dict(readout='R1_terms_padj', up=len(su), down=len(sd), fisher_p=p1),
              dict(readout='R1_terms_raw', up=len(su_raw), down=len(sd_raw), fisher_p=p1r),
              dict(readout='R2_metab_terms', up=len(msu), down=len(msd), fisher_p=np.nan),
              dict(readout='R3_metab_genes', up=a, down=c, fisher_p=p2)],
             ).to_csv(OUT + 'directional_stats.csv', index=False)
