"""Pure-Python DESeq2-equivalent DE engine (documented fallback: no R/network).

Implements the DESeq2 algorithmic pipeline:
  - median-of-ratios size factors
  - per-gene NB GLM (log link) by IRLS with fixed dispersion
  - gene-wise dispersion MLE via grid + parabolic refinement of the
    Cox-Reid adjusted profile likelihood (warm-started IRLS)
  - fitted dispersion-mean trend (binned medians, monotone, log-linear interp)
  - MAP shrinkage toward trend with lognormal prior (sd = 0.25 on log scale)
  - Wald test on the last model coefficient; Benjamini-Hochberg FDR
"""
import numpy as np
import pandas as pd
from scipy.special import gammaln
from scipy.stats import norm

LOG2 = np.log(2.0)

def size_factors(counts: pd.DataFrame) -> pd.Series:
    C = counts.values.astype(float)
    allpos = (C > 0).all(axis=1)
    if allpos.sum() < 10:
        allpos = (C.sum(axis=1) > 0)
    lc = np.log(C[allpos])
    ref = lc.mean(axis=1)
    sf = np.exp(np.median(lc - ref[:, None], axis=0))
    sf = sf / np.exp(np.mean(np.log(sf)))
    return pd.Series(sf, index=counts.columns)

def nb_loglik(y, mu, alpha):
    inv = 1.0 / alpha          # r = 1/alpha; NB2: log p = lgamma(y+r)-lgamma(r)-lgamma(y+1)
    return np.sum(gammaln(y + inv) - gammaln(inv) - gammaln(y + 1)
                  - inv * np.log1p(alpha * mu)
                  + y * (np.log(alpha) + np.log(mu) - np.log1p(alpha * mu)))

def nb_irls(y, X, alpha, offset, b=None, maxit=40, tol=1e-7):
    p = X.shape[1]
    if b is None:
        b = np.zeros(p)
        b[0] = np.log(max(np.mean(y * np.exp(-offset)), 1e-3))
    for _ in range(maxit):
        eta = np.clip(X @ b + offset, -30, 30)
        mu = np.exp(eta)
        W = mu / (1.0 + alpha * mu)          # Fisher info weight (log link, NB2)
        z = (eta - offset) + (y - mu) / mu   # working response
        XtW = X.T * W
        try:
            step = np.linalg.solve(XtW @ X + 1e-10 * np.eye(p), XtW @ z) - b
        except np.linalg.LinAlgError:
            break
        np.clip(step, -2, 2, out=step)
        b = b + step
        if np.max(np.abs(step)) < tol:
            break
    eta = np.clip(X @ b + offset, -30, 30)
    mu = np.exp(eta)
    return b, mu

def cr_loglik(y, X, alpha, offset, b=None):
    """Cox-Reid adjusted profile loglik at alpha; returns (lcr, b, mu)."""
    b, mu = nb_irls(y, X, alpha, offset, b=b)
    W = mu * mu / (mu + alpha * mu * mu)
    sign, logdet = np.linalg.slogdet((X.T * W) @ X + 1e-10 * np.eye(X.shape[1]))
    return nb_loglik(y, mu, alpha) - 0.5 * logdet, b, mu

def _argmin_parab(la, val):
    i = int(np.argmin(val))
    x2 = la[i]
    if 0 < i < len(la) - 1:
        x1, xm, x3 = la[i-1], la[i], la[i+1]
        y1, y2, y3 = val[i-1], val[i], val[i+1]
        d = (y1 - 2*y2 + y3)
        if d > 0:
            off = 0.5 * (y1 - y3) / d * (xm - x1)
            if abs(off) < (xm - x1):
                return xm + off
    return x2

def disp_mle(y, X, offset):
    la = np.linspace(np.log(1e-5), np.log(8.0), 14)
    b = None; val = []
    for l in la:
        v, b, _ = cr_loglik(y, X, np.exp(l), offset, b=b)
        val.append(-v)
    return float(np.exp(_argmin_parab(la, val)))

def fit_trend(mean, disp, nbins=30, min_count=25):
    q = np.unique(np.quantile(mean, np.linspace(0, 1, nbins + 1)))
    idx = np.clip(np.searchsorted(q, mean, side='right') - 1, 0, len(q) - 2)
    cx, cy = [], []
    for b in range(len(q) - 1):
        m = idx == b
        if m.sum() >= min_count:
            cx.append(np.median(mean[m])); cy.append(np.median(disp[m]))
    cx = np.asarray(cx); cy = np.asarray(cy)
    if len(cx) == 0:
        c = np.median(disp)
        return lambda m: np.full_like(np.asarray(m, float), c)
    o = np.argsort(cx); cx, cy = cx[o], np.minimum.accumulate(cy[o][::-1])[::-1]
    lc, lcy = np.log(cx), np.log(cy)
    def pred(m):
        return np.exp(np.interp(np.log(np.clip(m, cx.min(), cx.max())), lc, lcy))
    return pred

def disp_map(y, X, offset, a_trend, prior_sd=0.25):
    la0 = np.log(a_trend)
    la = la0 + np.linspace(-2.5, 2.5, 13)
    b = None; val = []
    for l in la:
        v, b, _ = cr_loglik(y, X, np.exp(l), offset, b=b)
        val.append(-v + (l - la0) ** 2 / (2 * prior_sd ** 2))
    return float(np.exp(_argmin_parab(la, val)))

def bh(p):
    p = np.asarray(p, float); n = len(p)
    o = np.argsort(p)
    q = p[o] * n / (np.arange(n) + 1)
    q = np.minimum.accumulate(q[::-1])[::-1]
    out = np.empty(n); out[o] = np.clip(q, 0, 1)
    return out

def run_deseq(counts: pd.DataFrame, X: np.ndarray, prior_sd=0.25, min_mean=0.5, progress=True):
    """counts: genes x samples (filtered); X: design matrix (samples x p)."""
    sf = size_factors(counts)
    offset = np.log(sf.values)
    Y = counts.values.astype(float)
    G, n = Y.shape; p = X.shape[1]
    gm = np.exp(np.log(np.clip(Y / sf.values[None, :], 1e-6, None)).mean(axis=1))
    disp0 = np.empty(G); dispS = np.empty(G); B = np.empty((G, p)); SE = np.empty((G, p))
    for g in range(G):
        y = Y[g]
        disp0[g] = disp_mle(y, X, offset)
    use = (gm > min_mean) & np.isfinite(disp0) & (disp0 > 1e-9) & (disp0 < 20)
    trendf = fit_trend(gm[use], disp0[use], nbins=max(6, min(30, G // 300)), min_count=max(10, G // 400))
    trend = trendf(gm)
    for g in range(G):
        if gm[g] < min_mean or not np.isfinite(disp0[g]) or disp0[g] > 20:
            dispS[g] = trend[g]
        else:
            dispS[g] = disp_map(y=Y[g], X=X, offset=offset, a_trend=max(trend[g], 1e-8), prior_sd=prior_sd)
    for g in range(G):
        b, mu = nb_irls(Y[g], X, dispS[g], offset)
        W = mu * mu / (mu + dispS[g] * mu * mu)
        C = np.linalg.inv((X.T * W) @ X + 1e-10 * np.eye(p))
        B[g] = b; SE[g] = np.sqrt(np.diag(C))
    res = pd.DataFrame(B / LOG2, index=counts.index, columns=[f"lfc{i}" for i in range(p)])
    res["baseMean"] = gm
    res["lfc"] = res[f"lfc{p-1}"]
    res["se_lfc"] = SE[:, -1] / LOG2
    z = B[:, -1] / SE[:, -1]
    res["stat"] = z
    res["p"] = 2 * norm.sf(np.abs(z))
    res["padj"] = bh(res["p"].values)
    res["disp_mle"] = disp0; res["disp_trend"] = trend; res["disp_map"] = dispS
    return res, sf
