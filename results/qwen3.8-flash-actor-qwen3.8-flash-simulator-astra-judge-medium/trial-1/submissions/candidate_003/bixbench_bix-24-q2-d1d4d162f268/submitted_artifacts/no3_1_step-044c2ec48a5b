import sys; sys.path.insert(0,'/workspace')
import numpy as np, pandas as pd, time
from de_core import run_deseq
counts = pd.read_csv('/workspace/data/counts_raw_unfiltered.csv', index_col=0)
prim_no = [s for s in counts.columns if s.split('_')[0] in ('3','4','7','8') and s != '3_1']
C = counts[prim_no]
keep = (C >= 5).sum(axis=1) >= 3
Cf = C[keep]
starve = np.array([1 if s.split('_')[0] in ('4','8') else 0 for s in prim_no], float)
cbd    = np.array([1 if s.split('_')[0] in ('7','8') else 0 for s in prim_no], float)
X = np.column_stack([np.ones(len(prim_no)), starve, cbd])
t=time.time(); res, sf = run_deseq(Cf, X)
res.to_csv('/workspace/results/de_sens_no3_1.csv'); sf.to_csv('/workspace/results/sizefactors_sens_no3_1.csv')
up=((res.padj<0.05)&(res.lfc>0.5)).sum(); dn=((res.padj<0.05)&(res.lfc<-0.5)).sum()
print("no3_1: tested=%d up=%d down=%d (%.0fs)"%(len(res),up,dn,time.time()-t))
