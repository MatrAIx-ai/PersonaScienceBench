def run(label, d, cov="mh_count", dep="sev", cluster=None, flag=""):
    """PO cumulative-logit fit; convergence always cross-checked against the
    independent analytic-gradient MLE (max abs coefficient difference reported)."""
    if "ps_c" not in d.columns:
        d = centre(d)
    keep = [dep, "bcg", cov, "ps_c"] + ([cluster] if cluster else [])
    w = d[keep].dropna(subset=[dep]).copy()
    w[dep] = w[dep].astype(int)
    w = w.rename(columns={cov: "mh_count"})
    formula = f"{dep} ~ bcg + mh_count + ps_c + bcg:mh_count".replace("bcg:mh_count", "bcg:ps_c")
    Xc = w[["bcg", "mh_count", "ps_c"]].assign(bcg_ps=w.bcg * w.ps_c).values.astype(float)
    own = fit_po_own(Xc, w[dep].values, cluster=(w[cluster].values if cluster else None))
    if cluster is None:
        m, _ = fit_po(w, formula, dep=dep); ci = m.conf_int()
        b, se = m.params["bcg"], m.bse["bcg"]
        beta_sm = np.array([m.params[k] for k in ["bcg", "mh_count", "ps_c", "bcg:ps_c"]])
        bint, pint, conv = m.params["bcg:ps_c"], m.pvalues["bcg:ps_c"], bool(m.mle_retvals["converged"])
        pval, unit, note = m.pvalues["bcg"], "subject", flag
    else:
        b, se = own.beta[0], own.se[0]; beta_sm = own.beta
        bint, pint, conv = own.beta[3], np.nan, True
        pval = 2 * (1 - stats.norm.cdf(abs(b / se)))
        unit, note = "AE record", flag + "; cluster-robust SE by USUBJID"
    return dict(specification=label, unit=unit, n=len(w), OR_bcg=np.exp(b),
                lo=np.exp(b - 1.96 * se), hi=np.exp(b + 1.96 * se), p_bcg=pval,
                OR_int=np.exp(bint), p_int=pint, converged=conv,
                beta_diff_vs_indep_MLE=float(np.max(np.abs(beta_sm - own.beta))), note=note)

S = []
S.append(run("PRIMARY: all graded AEs, max AESEV, MH count = all positive items", d1, flag="headline"))
S.append(run("Outcome subset: exclude injection-site reactions (non-ISR)", subject_frame(NON_ISR), flag="robustness"))
S.append(run("Outcome subset: RTI category AEs only", subject_frame(RTI), flag="robustness"))
S.append(run("Outcome subset: COVID-19-coded AEs only", subject_frame(COV), flag="LOW POWER - product term not credible"))
g0 = centre(subject_frame(ae)); g0["sev0"] = g0.sev.fillna(0).astype(int)
S.append(run("209 ungraded subjects added as bottom category 0", g0, dep="sev0",
             flag="MAIN SENSITIVITY (grading artefact)"))
S.append(run("MH count restricted to chronic comorbidity items", d1, cov="mh_restr",
             flag="restricted MH rule"))
S.append(run("MH count = ongoing conditions only (MHONGO=='Yes')", d1, cov="mh_ongo",
             flag="MHONGO variant"))
S.append(run("expect_interact (binary) instead of patients_seen band",
             d1.assign(ps_c=d1.ei - d1.ei.mean()), flag="binary exposure proxy"))
m_main, _ = fit_po(d1, "sev ~ bcg + mh_count + ps_c"); cim = m_main.conf_int()
S.append(dict(specification="Main-effects model (product term dropped)", unit="subject", n=int(m_main.nobs),
              OR_bcg=np.exp(m_main.params["bcg"]), lo=np.exp(cim.loc["bcg", 0]),
              hi=np.exp(cim.loc["bcg", 1]), p_bcg=m_main.pvalues["bcg"], OR_int=np.nan, p_int=np.nan,
              converged=bool(m_main.mle_retvals["converged"]), beta_diff_vs_indep_MLE=np.nan,
              note="LR test vs primary below"))
S.append(run("Unit = one row per AE record (all graded AE rows)",
             ae.dropna(subset=["sev"]).merge(dm, on="USUBJID", suffixes=("", "_dm")),
             cluster="USUBJID", flag="AE-level"))
# implementation check: the naive statsmodels default (probit link) is NOT an odds ratio
mprob = OrderedModel.from_formula(FORM, d1, categories="ordered").fit(
    method="nm", maxiter=200000, maxfun=400000, xtol=1e-11, ftol=1e-11, disp=0)
ci = mprob.conf_int()
S.append(dict(specification="IMPLEMENTATION CHECK: statsmodels default probit link (exp(coef) is NOT an OR)",
              unit="subject", n=int(mprob.nobs), OR_bcg=np.exp(mprob.params["bcg"]),
              lo=np.exp(ci.loc["bcg", 0]), hi=np.exp(ci.loc["bcg", 1]), p_bcg=mprob.pvalues["bcg"],
              OR_int=np.exp(mprob.params["bcg:ps_c"]), p_int=mprob.pvalues["bcg:ps_c"],
              converged=mprob.mle_retvals["converged"], beta_diff_vs_indep_MLE=np.nan,
              note="do not report as an odds ratio; logit link is used for all headline numbers"))
sen = pd.DataFrame(S)
sen.round(4).to_csv(f"{OUT}/sensitivity_table.csv", index=False)
