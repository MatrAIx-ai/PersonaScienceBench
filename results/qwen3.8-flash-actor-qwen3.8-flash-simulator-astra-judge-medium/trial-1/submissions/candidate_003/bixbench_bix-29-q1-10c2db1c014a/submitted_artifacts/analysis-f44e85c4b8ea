         "converged", "beta_diff_vs_indep_MLE", "note"]].round(4).to_string(index=False))
say("max |coef difference| between statsmodels PO fit and independent analytic-gradient MLE "
    "across all subject-level rows = %.2e" % np.nanmax(sen.beta_diff_vs_indep_MLE.values))

# goodness of fit: observed vs model-predicted severity counts by arm
pd_exog = d1[["bcg", "mh_count", "ps_c"]].assign(**{"bcg:ps_c": d1.bcg * d1.ps_c})
pred = np.asarray(m1.predict(exog=pd_exog))
gof = pd.DataFrame(pred, columns=[f"sev{c}" for c in sorted(d1.sev.unique())])
gof["TRTGRP"] = d1.TRTGRP.values; gof["sev"] = d1.sev.values
