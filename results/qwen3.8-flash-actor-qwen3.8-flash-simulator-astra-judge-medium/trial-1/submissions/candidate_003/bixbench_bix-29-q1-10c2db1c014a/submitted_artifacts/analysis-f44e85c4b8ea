# ---------------------------------------------------------------- model fit
def centre(d):
    d = d.copy(); d["ps_c"] = d.ps_raw - d.ps_raw.mean()
    d["bcg_ps"] = d.bcg * d.ps_c
    return d

FORM = "sev ~ bcg + mh_count + ps_c + bcg:ps_c"
def fit_po(d, formula=FORM, dep="sev"):
    d = d.dropna(subset=[dep]).copy(); d[dep] = d[dep].astype(int)
    # NOTE: OrderedModel defaults to distr='normal' (probit!). The brief asks for a
    # cumulative-LOGIT / proportional-ODDS model, so distr="logit" is mandatory here;
    # exp(coef) is an odds ratio only under the logit link.
    m = OrderedModel.from_formula(formula, d, categories="ordered", distr="logit").fit(method="nm",
                                    maxiter=200000, maxfun=400000, xtol=1e-11, ftol=1e-11, disp=0)
    m2 = OrderedModel.from_formula(formula, d, categories="ordered", distr="logit").fit(
                                    method="newton", maxiter=200, tol=1e-12, disp=0)
    if m2.llf > m.llf + 1e-8:
        m = m2
    return m, d

def or_table(m, terms):
    ci = m.conf_int(); rows = []
    for t in terms:
        b, se = m.params[t], m.bse[t]
        rows.append(dict(term=t, beta=b, se=se, OR=np.exp(b),
                         lo=np.exp(ci.loc[t, 0]), hi=np.exp(ci.loc[t, 1]),
                         z=b / se, p=m.pvalues[t], OR_int=np.exp(b)))
    return pd.DataFrame(rows).drop(columns="OR_int")

# ------------------------------------------- own ordinal MLE (for robust SEs / GOM)
from scipy.optimize import minimize
from statsmodels.tools.numdiff import approx_fprime, approx_hess

def _pieces(theta, X, ycat, J):
    """Cumulative-logit (proportional-odds) pieces.
    Convention (matches statsmodels OrderedModel): P(Y<=j) = expit(alpha_j - X.beta),
    so a positive coefficient shifts subjects to HIGHER severity categories."""
    a, b = theta[:J], theta[J:]
    eta = X @ b
    F = np.column_stack([np.zeros(len(ycat)),
                         *[1 / (1 + np.exp(-(aj - eta))) for aj in a],
                         np.ones(len(ycat))])            # F[:,j] = P(Y<=j), j=0..J+1
    f = F * (1 - F)                                       # f[:,0] = f[:,J+1] = 0
    i = np.arange(len(ycat))
    p = np.clip(F[i, ycat] - F[i, ycat - 1], 1e-300, None)
    G = np.empty((len(ycat), J + X.shape[1]))
    for j in range(1, J + 1):
        G[:, j - 1] = f[i, j] * ((ycat == j).astype(float) - (ycat == j + 1).astype(float)) / p
    c = (f[i, ycat - 1] - f[i, ycat]) / p                 # d logL / d eta_i
    G[:, J:] = c[:, None] * X
    return p, G

def _num_hess(grad, th, eps=1e-5):
    """central-difference Hessian of the objective, from the analytic gradient."""
    k = len(th); H = np.empty((k, k)); gp = np.eye(k) * eps
    for i in range(k):
        H[:, i] = (grad(th + gp[i]) - grad(th - gp[i])) / (2 * eps)
    return (H + H.T) / 2

def fit_po_own(X, ycode, cluster=None):
    """Cumulative-logit PO MLE, analytic gradient; cluster-robust (sandwich) SEs
    if `cluster` given, model-based (outer product of Hessian) otherwise."""
    X = np.asarray(X, float); ycode = np.asarray(ycode, int); n, p = X.shape
    uniq = np.unique(ycode)                       # recode any integer coding to 1..K
    ycat = np.searchsorted(uniq, ycode) + 1
    J = len(uniq) - 1                             # number of cutpoints
    nll = lambda th: -np.log(_pieces(th, X, ycat, J)[0]).sum()
    grad = lambda th: -_pieces(th, X, ycat, J)[1].sum(0)
    prop = np.array([(ycat <= j).mean() for j in range(1, J + 1)])
    starts = [np.r_[np.log(np.arange(1, J + 1) / J), np.zeros(p)],
              np.r_[np.log(prop / (1 - prop)), np.zeros(p)],
              np.r_[np.log(prop / (1 - prop)), np.full(p, 0.1)]]
    sols = [minimize(nll, t0, jac=grad, method="BFGS", options=dict(gtol=1e-10, maxiter=5000)) for t0 in starts]
    sols.sort(key=lambda r: nll(r.x)); r = sols[0]
    th = r.x
    multi_start_agree = max(abs(nll(x.x) - nll(th)) for x in sols) < 1e-4
    A_inv = np.linalg.inv(_num_hess(grad, th))
    if cluster is None:
        V = A_inv
    else:
        G = _pieces(th, X, ycode, J)[1]
        Gdf = pd.DataFrame(G); Gdf["c"] = np.asarray(cluster)
        S = Gdf.groupby("c").sum().values
        V = A_inv @ (S.T @ S) @ A_inv
    se = np.sqrt(np.diag(V))
    o = type("O", (), {})()
    o.beta, o.se, o.llf, o.conv, o.alpha, o.V, o.nobs = th[J:], se[J:], -nll(th), bool(r.success and multi_start_agree), th[:J], V, n
    return o


def stacked_logit(d, kind, covs, cut_specific=()):
    """Stacked (Agresti AMM) ordinal fits: kind='cumulative' (proportional-odds form)
    or 'cratio' (continuation-ratio). cut_specific = covariates allowed to vary by cut."""
    y = d["sev"].astype(int); K = int(y.max()); rows = []
    for j in range(1, K):
        if kind == "cumulative":
            s = d.copy(); s["u"] = (y > j).astype(int)
        else:                                   # continuation ratio: condition on sev>=j
            s = d[y >= j].copy(); s["u"] = (y[y >= j] > j).astype(int)
        s["cut"] = j
        rows.append(s)
    S = pd.concat(rows, ignore_index=True)
    S["bcg_ps"] = S["bcg"] * S["ps_c"]
    cutd = pd.get_dummies(S["cut"], prefix="cut", drop_first=True).astype(float)
    base = S[covs].copy(); base["cut"] = S["cut"]
    X = pd.concat([cutd, base[covs]], axis=1)
    for c in cut_specific:
        for j in sorted(S["cut"].unique())[1:]:
            X[f"{c}_x_cut{j}"] = S[c] * (S["cut"] == j).astype(float)
    m = sm.Logit(S["u"].astype(int), sm.add_constant(X)).fit(disp=0, maxiter=500)
    return m, len(S)

