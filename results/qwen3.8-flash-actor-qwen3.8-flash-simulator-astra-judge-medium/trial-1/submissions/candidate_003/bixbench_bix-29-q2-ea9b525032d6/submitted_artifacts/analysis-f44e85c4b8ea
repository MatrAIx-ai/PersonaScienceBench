"""
TASK008 BCG-CORONA - independent effect of each additional ONGOING medical condition (MHONGO='Yes')
on the odds of higher COVID-19 severity, controlling for BCG status (TRTGRP) and patient-interaction
variables. Ordinal regression (proportional odds / cumulative logit).

Stages: [0] load+aggregate  [1] surrogate-outcome validation  [2] coverage
        [3] models (complete case n=857 AND no-AE->0 n=1000)  [4] proportional-odds tests
        [5] sensitivity  [6] final % change in odds with 95% CI
Run: python analysis/task008_ordinal_analysis.py     (artifacts written to out/)
"""
import sys, os, json, warnings
import numpy as np, pandas as pd
from scipy import stats
from scipy.optimize import minimize
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
warnings.filterwarnings('ignore')
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from gom import nll, unpack, start_from_po

BASE = os.environ.get('TASK_BASE', '.')
OUT = os.path.join(BASE, 'out'); os.makedirs(OUT, exist_ok=True)
AE_KEY = ['AECAT','AEPT','AEOUT','AESEV','AESER','AEHS','AESOC']
PRED = ['n_ongoing_MH','BCG','ps_ord','wh_ord','ei']
AUX = PRED + ['age_mid','female']
L = []
def P(*a):
    s = ' '.join(str(x) for x in a); print(s); L.append(s)

def build():
    dm = pd.read_csv(f'{BASE}/data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv(f'{BASE}/data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv(f'{BASE}/data/TASK008_BCG-CORONA_MH.csv')
    P('[0] raw shapes DM %s | AE %s | MH %s ; unique USUBJID %d/%d/%d (identical sets: %s)'
      % (dm.shape, ae.shape, mh.shape, dm.USUBJID.nunique(), ae.USUBJID.nunique(), mh.USUBJID.nunique(),
         set(dm.USUBJID) == set(ae.USUBJID) == set(mh.USUBJID)))
    ae_real = ae[~ae[AE_KEY].isna().all(axis=1)].copy()
    P('    AE rows with no content (dropped): %d rows covering %d patients who have ZERO usable AE'
      % (len(ae)-len(ae_real), ae.USUBJID.nunique()-ae_real.USUBJID.nunique()))
    ae_real['AECAT_f'] = ae_real['AECAT'].fillna('(missing)')
    sev   = ae_real.groupby('USUBJID')['AEHS'].max().rename('sev7')
    sevNI = ae_real[ae_real.AECAT_f != 'ISR'].groupby('USUBJID')['AEHS'].max().rename('sev_nonISR')
    sevRT = ae_real[ae_real.AECAT_f == 'RTI'].groupby('USUBJID')['AEHS'].max().rename('sev_RTI')
    worst = ae_real.loc[ae_real.groupby('USUBJID')['AEHS'].idxmax(),
              ['USUBJID','AESEV','AESER','AEOUT','AESOC','AEPT']].set_index('USUBJID')
    worst.columns = ['AESEV_worst','AESER_worst','AEOUT_worst','AESOC_worst','AEPT_worst']
    fatal = (ae_real.assign(f=ae_real.AEOUT.fillna('').str.contains('Fatal')
                | ae_real.AEOUTFU.fillna('').str.contains('Fatal')
                | ae_real.AESERCRIT.fillna('').str.contains('Death')).groupby('USUBJID')['f'].max().rename('fatal'))
    ong = mh[mh.MHONGO.astype(str).str.strip().str.lower() == 'yes'].copy()
    ong['key'] = ong.MHDECOD.fillna(ong.MHTERM).astype(str).str.lower().str.strip()
    n_raw = ong.groupby('USUBJID').size().rename('n_ongoing_raw')
    n_ong = ong.groupby('USUBJID')['key'].nunique().rename('n_ongoing_MH')
    P('    MHONGO labels present: %s ; ongoing rows %d raw -> %d after case-insensitive term dedup'
      % (sorted(mh.MHONGO.dropna().unique()), len(ong), ong.key.nunique()))
    d = dm.copy()
    for s in (sev, sevNI, sevRT, n_ong, n_raw, fatal):
        d = d.merge(s, left_on='USUBJID', right_index=True, how='left')
    d = d.join(worst, on='USUBJID')
    d['n_ongoing_MH'] = d.n_ongoing_MH.fillna(0).astype(int)
    d['BCG'] = (d.TRTGRP == 'BCG').astype(int)
    d['ps_ord'] = d.patients_seen.map({'1-50':1,'51-100':2,'>100':3})
    d['wh_ord'] = d.work_hours.map({'1-40':1,'41-80':2,'>80':3})
    d['ei'] = (d.expect_interact == 'Yes').astype(int)
    d['age_mid'] = d.Age.map({'10-19':15,'20-29':25,'30-39':35,'40-49':45,'50-59':55,'60-69':65,'70-79':75})
    d['female'] = (d.SEX == 2).astype(int)
    d['has_ae'] = d.sev7.notna().astype(int)
    d['sev4'] = pd.cut(d.sev7, [-.5,.5,1.5,2.5,7.5], labels=[0,1,2,3]).astype('float')
    d['sevA'] = d.sev7.map(lambda v: np.nan if pd.isna(v) else (1 if v<=1 else (2 if v==2 else 3)))
    d['sevB'] = d.sev7.map(lambda v: np.nan if pd.isna(v) else (1 if v<=1 else (2 if v==2 else (3 if v==3 else 4))))
    d.to_csv(f'{OUT}/analysis_table.csv', index=False)
    return d, ae_real, ong

def validate(d, ae):
    P('\n' + '='*78); P('[1] SURROGATE-OUTCOME VALIDATION  (severity = patient-level max AEHS)')
    cc = d[d.has_ae == 1]
    P('    severity distribution (n=%d): %s' % (len(cc), cc.sev7.value_counts().sort_index().to_dict()))
    P('\n    1a. severity x AESEV of worst AE (patient level)')
    P(pd.crosstab(cc.sev7, cc.AESEV_worst.fillna('MISSING'), margins=True).to_string())
    P('\n    1b. AEHS x AESEV at AE-row level -> AEHS is NOT a relabelling of AESEV')
    P(pd.crosstab(ae.AEHS, ae.AESEV.fillna('MISSING'), margins=True).to_string())
    both = ae.dropna(subset=['AESEV'])
    P('    rows with both = %d ; AEHS==AESEV in %.1f%% ; Spearman rho = %.3f ; AEHS has 8 categories vs AESEV 4'
      % (len(both), 100*(both.AEHS == both.AESEV).mean(), both.AEHS.corr(both.AESEV, method='spearman')))
    P('    AEHS is populated on %d rows (%.1f%%) where AESEV is MISSING:' % (ae.AESEV.isna().sum(), 100*ae.AESEV.isna().mean()))
    P('    ' + ae.dropna(subset=['AESEV']).groupby('AESEV')['AEHS'].agg(
        ['count','nunique','min','max','mean']).round(2).to_string().replace('\n', '\n    '))
    P('\n    1c. clinical anchoring by AEHS level (AE-row level, n=%d)' % len(ae))
    a = ae.assign(ser=ae.AESER == 'Yes',
                  hosp=ae.AESERCRIT.fillna('').str.contains('Hospitaliz|Death|Important', case=False),
                  fat=ae.AEOUT.fillna('').str.contains('Fatal') | ae.AEOUTFU.fillna('').str.contains('Fatal'),
                  nres=ae.AEOUT.fillna('').isin(['Unchanged','Worse','Fatal']))
    g = a.groupby('AEHS').agg(n=('AEHS','size'), pct_AESER_yes=('ser','mean'), pct_hosp_crit=('hosp','mean'),
                              pct_not_resolved=('nres','mean'), pct_fatal=('fat','mean'))
    P((g[['pct_AESER_yes','pct_hosp_crit','pct_not_resolved','pct_fatal']]*100).round(1)
        .join(g[['n']]).to_string())
    P('    AESER: %.1f%% for AEHS<=2 vs %.1f%% for AEHS>=3 vs %.1f%% for AEHS>=4 ; hospitalisation criterion %.1f%% at AEHS>=4 ;'
      % (100*a[a.AEHS<=2].ser.mean(), 100*a[a.AEHS>=3].ser.mean(), 100*a[a.AEHS>=4].ser.mean(), 100*a[a.AEHS>=4].hosp.mean()))
    P('    all %d deaths (AEOUT=Fatal / AESERCRIT=Death) sit at AEHS=6-7 => upper levels are severe, not noise.'
      % int(a.fat.sum()))
    P('\n    1d. patient-level fatality by severity level')
    f = cc.groupby('sev7').agg(n=('USUBJID','size'), deaths=('fatal', lambda s: int(s.fillna(False).sum())))
    f['pct_fatal'] = (100*f.deaths/f.n).round(1); P(f.to_string())
    P('\n    1e. severity x outcome of the worst AE')
    P(pd.crosstab(cc.sev7, cc.AEOUT_worst.fillna('(na)')).to_string())
    P('\n    1f. AEHS by AECAT (ISR = local injection-site reaction, expected mild)')
    cat = ae.assign(AECAT=ae.AECAT.fillna('(missing)'))
    t = cat.groupby('AECAT')['AEHS'].agg(n='size', mean='mean', max='max')
    t['pct_ge3'] = (100*cat.groupby('AECAT')['AEHS'].apply(lambda s: (s >= 3).mean())).round(1)
    P(t.round(2).to_string())
    P('\n    1g. AEHS by SOC (top 12 by volume)')
    P(ae.groupby('AESOC')['AEHS'].agg(n='size', mean='mean', max='max',
        pct_ge3=lambda s: (100*(s >= 3).mean()).round(1)).sort_values('n', ascending=False).head(12).to_string())
    P('\n    1h. working scale used: AEHS 0-7 collapsed to 0/1/2/3+ ; pooled top block n=%d patients' % int((cc.sev7 >= 3).sum()))
    P('    ' + str(cc.sev4.value_counts().sort_index().to_dict()))
    P("    top MedDRA terms at AEHS>=4: " + str(ae[ae.AEHS >= 4].AEPT.value_counts().head(6).to_dict()))

def _fit_best(y, X):
    """Multiple optimiser starts; keep the highest log-likelihood.
    Rationale: a single BFGS run can land in a bad local optimum - detected because a
    saturated model must never have a lower llf than a nested one."""
    cands = []
    for meth, opt in [('newton', {}),
                      ('bfgs', {'maxiter':20000}),
                      ('bfgs', {'maxiter':40000, 'gtol':1e-9}),
                      ('bfgs', {'maxiter':100000, 'gtol':1e-11}),
                      ('nm', {'maxiter':60000, 'maxfev':80000}),
                      ('cg', {'maxiter':40000})]:
        try:
            m = OrderedModel(y, X, distr='logit').fit(method=meth, **opt)
            if np.isfinite(m.llf): cands.append((m.llf, meth, m))
        except Exception:
            pass
    if not cands: raise RuntimeError('no optimiser converged')
    cands.sort(key=lambda t: -t[0])
    return cands[0][2], [(round(c[0],4), c[1]) for c in cands]

def fit(df, ycol, preds, label, store):
    dd = df[[ycol] + preds].dropna(); y = pd.Categorical(dd[ycol]).codes
    X = dd[preds].astype(float)
    m, starts = _fit_best(y, X)
    ci = np.asarray(m.conf_int())
    tab = pd.DataFrame({'beta': np.asarray(m.params), 'se': np.asarray(m.bse),
                        'p': np.asarray(m.pvalues), 'lo': ci[:,0], 'hi': ci[:,1]}, index=list(m.params.index))
    tab['pct'] = (np.exp(tab.beta)-1)*100
    tab['pct_lo'] = (np.exp(tab.lo)-1)*100; tab['pct_hi'] = (np.exp(tab.hi)-1)*100
    P('\n### %s  [outcome=%s n=%d K=%d llf=%.4f llf over starts=%s]'
      % (label, ycol, len(dd), len(np.unique(y)), m.llf, starts[:3]))
    P(tab.loc[preds].round(4).to_string())
    b = 'n_ongoing_MH'
    r = dict(label=label, y=ycol, n=len(dd), K=int(len(np.unique(y))), llf=float(m.llf), beta=float(tab.beta[b]),
             se=float(tab.se[b]), pct=float(tab.pct[b]), lo=float(tab.pct_lo[b]), hi=float(tab.pct_hi[b]),
             p=float(tab.p[b]), beta_BCG=float(tab.beta['BCG']), pct_BCG=float(tab.pct['BCG']),
             optimiser=starts[0][1])
    P('    >>> exposure: per +1 ongoing condition  %+.1f%% odds (95%% CI %.1f%% .. %.1f%%)  p=%.3g | BCG %+.1f%%'
      % (r['pct'], r['lo'], r['hi'], r['p'], r['pct_BCG']))
    store.append(r); return m, r

def po_tests(d):
    P('\n' + '='*78); P('[4] PROPORTIONAL-ODDS (parallel-lines) TESTS')
    P('    statsmodels OrderedModel(scale_corr=...) silently returns the PO fit (LR=0) -> unusable.')
    P('    Own cumulative-logit implementation (gom.py) with cut-specific slopes; its PO log-likelihood')
    P('    reproduces statsmodels to 4 decimals, so only the non-parallel part differs. Thresholds are kept')
    P('    monotone via thr_1=a1, thr_j=thr_(j-1)+exp(a_j).')
    cc = d[d.has_ae == 1]; res = []
    for ycol, desc in [('sev4', 'agreed collapse 0/1/2/3+ (cut 0|1+ DEGENERATE: only 2 patients below)'),
                       ('sevA', '1/2/3+ (all cuts informative)'), ('sevB', '1/2/3/4+ (all cuts informative)')]:
        dd = cc[[ycol] + PRED].dropna(); y = pd.Categorical(dd[ycol]).codes
        X = dd[PRED].astype(float).values; K = len(np.unique(y)); p = X.shape[1]
        m_po, _ = _fit_best(y, dd[PRED].astype(float))
        P('\n  [%s] %s' % (ycol, desc))
        P('     n=%d ; patients below each cut = %s ; llf_PO=%.4f (statsmodels)' % (len(y), [int((y < k).sum()) for k in range(1,K)], m_po.llf))
        for nonpar in [('n_ongoing_MH',), ('BCG',), tuple(PRED)]:
            idx = [PRED.index(c) for c in nonpar]
            x0 = start_from_po(m_po, p, K, idx, PRED)
            r = minimize(nll, x0, args=(X, y, K, idx), method='L-BFGS-B', options={'maxiter':60000, 'maxfun':120000})
            lr = 2*(-r.fun - m_po.llf); dfree = (K-2)*len(idx); pv = float(1-stats.chi2.cdf(max(lr,0), dfree))
            sl = '' if len(idx) > 1 else '  cut-specific slopes = %s' % np.round(unpack(r.x, p, K, idx)[1][:, idx[0]], 3)
            P('     non-parallel %-16s LR=%7.3f df=%2d p=%.4g%s' % ('+'.join(nonpar) if len(nonpar) < 5 else 'ALL', lr, dfree, pv, sl))
            res.append(dict(scale=ycol, nonpar='+'.join(nonpar), lr=float(lr), df=int(dfree), p=pv))
        if ycol in ('sevA', 'sevB'):
            P('     independent check - cumulative binary logits per cut (full covariate set):')
            betas, ses, ks = [], [], []
            for k in range(1, K):
                yb = (y >= k).astype(int)
                if min(int(yb.sum()), len(yb)-int(yb.sum())) < 40:
                    P('       cut>=%d SKIPPED (events=%d)' % (k, int(yb.sum()))); continue
                mb = sm.GLM(yb, sm.add_constant(dd[PRED].astype(float)), family=sm.families.Binomial()).fit()
                b_, s_ = float(mb.params['n_ongoing_MH']), float(mb.bse['n_ongoing_MH'])
                betas.append(b_); ses.append(s_); ks.append(k)
                P('       cut>=%d n=%4d ev=%4d  exposure beta=%.4f (se %.4f) -> %+.1f%%' % (k, len(yb), int(yb.sum()), b_, s_, (np.exp(b_)-1)*100))
            if len(betas) >= 2:
                w = np.average(betas, weights=[1/s**2 for s in ses])
                Q = float(sum((b-w)**2/s**2 for b, s in zip(betas, ses)))
                P('       homogeneity of exposure slope across cuts: Q=%.3f df=%d p=%.3f (cuts are correlated -> indicative only)'
                  % (Q, len(betas)-1, 1-stats.chi2.cdf(Q, len(betas)-1)))
    json.dump(res, open(f'{OUT}/po_tests.json', 'w'), indent=2)
    return res

def sensitivity(d):
    P('\n' + '='*78); P('[5] SENSITIVITY ANALYSES'); cc = d[d.has_ae == 1].copy(); rows = []
    P('\n  5a. alternative outcome definitions (identical covariates, complete cases)')
    for ycol, lab in [('sev4', 'max AEHS collapsed 0/1/2/3+  <-- PRIMARY'), ('sev7', 'max AEHS 0-7 (all AEs)'),
                      ('sev_nonISR', 'max AEHS over non-ISR AEs only'), ('sev_RTI', 'max AEHS over RTI AEs only')]:
        fit(cc, ycol, PRED, 'outcome: ' + lab, rows)
    P('\n  5b. exposure coding: linear vs cumulative indicators I(n>=1),I(n>=2),I(n>=3) (linear is nested)')
    cc['ong_cap'] = cc.n_ongoing_MH.clip(0, 3)
    for k in (1,2,3): cc[f'ong_ge{k}'] = (cc.ong_cap >= k).astype(int)
    dd = cc.dropna(subset=['sev4']); y = pd.Categorical(dd.sev4).codes
    fa, _ = _fit_best(y, dd[['ong_ge1','ong_ge2','ong_ge3']+PRED[1:]].astype(float))
    fb, _ = _fit_best(y, dd[['ong_cap']+PRED[1:]].astype(float))
    lr = 2*(fa.llf-fb.llf)
    P('     flexible slopes I(n>=1..3)=%s ; linear beta=%.4f (%+.1f%%) ; LR=%.3f df=2 p=%.3f -> linear coding retained'
      % (np.round(np.asarray(fa.params)[:3], 3), fb.params['ong_cap'], (np.exp(fb.params['ong_cap'])-1)*100,
         max(lr,0), 1-stats.chi2.cdf(max(lr,0), 2)))
    P('\n  5c. interaction variables as indicator dummies (ref = highest category) instead of ordinal scores')
    cc['ps_1_50'] = (cc.patients_seen == '1-50').astype(int);  cc['ps_51_100'] = (cc.patients_seen == '51-100').astype(int)
    cc['wh_1_40'] = (cc.work_hours == '1-40').astype(int);      cc['wh_41_80'] = (cc.work_hours == '41-80').astype(int)
    fit(cc, 'sev4', ['n_ongoing_MH','BCG','ps_1_50','ps_51_100','wh_1_40','wh_41_80','ei'],
        'interaction vars as indicators', rows)
    P('\n  5d. does the comorbidity gradient differ by arm? BCG x exposure interaction')
    cc['inter'] = cc.n_ongoing_MH*cc.BCG
    dd = cc.dropna(subset=['sev4']); y = pd.Categorical(dd.sev4).codes
    m1, _ = _fit_best(y, dd[PRED+['inter']].astype(float))
    m0, _ = _fit_best(y, dd[PRED].astype(float))
    lr = 2*(m1.llf-m0.llf)
    P('     beta(ongoing x BCG)=%+.4f p=%.3f ; LR=%.3f df=1 p=%.3f -> no evidence of effect modification'
      % (m1.params['inter'], m1.pvalues['inter'], lr, 1-stats.chi2.cdf(max(lr,0), 1)))
    return rows

def main():
    d, ae, ong = build()
    validate(d, ae)
    P('\n' + '='*78); P('[2] AGGREGATION AND COVERAGE')
    P('    exposure n_ongoing_MH: %s' % d.n_ongoing_MH.value_counts().sort_index().to_dict())
    P('    patients with >=1 ongoing condition: %d/1000 ; mean %.3f' % ((d.n_ongoing_MH > 0).sum(), d.n_ongoing_MH.mean()))
    g = d.groupby('TRTGRP')['has_ae'].agg(['size','sum']); g['missing'] = g['size']-g['sum']
    P('    outcome availability by arm: %s   <-- STRUCTURAL loss (26.2%% of Placebo vs 2.4%% of BCG)' % g.to_dict('index'))
    P('    mean ongoing conditions: with outcome %.3f | without outcome %.3f'
      % (d[d.has_ae == 1].n_ongoing_MH.mean(), d[d.has_ae == 0].n_ongoing_MH.mean()))
    P('    crude gradient, mean max-AEHS by ongoing count (capped 4): %s'
      % d[d.has_ae == 1].groupby(d.n_ongoing_MH.clip(0, 4))['sev7'].mean().round(3).to_dict())

    P('\n' + '='*78); P('[3] ORDINAL REGRESSION (OrderedModel, cumulative logit = proportional odds)')
    P('    spec: severity ~ n_ongoing_MH + BCG + patients_seen(ord) + work_hours(ord) + expect_interact')
    res = []; cc = d[d.has_ae == 1].copy()
    allp = d.copy(); allp['sev4_0'] = allp.sev4.fillna(0); allp['sev7_0'] = allp.sev7.fillna(0)
    fit(cc,   'sev4',   PRED, 'M1 PRIMARY  complete case n=857, scale 0/1/2/3+', res)
    fit(cc,   'sev7',   PRED, 'M2          complete case n=857, scale 0-7', res)
    fit(allp, 'sev4_0', PRED, 'M3 REQUIRED RUN  no-AE -> severity 0, n=1000, scale 0/1/2/3+', res)
    fit(allp, 'sev7_0', PRED, 'M4          no-AE -> severity 0, n=1000, scale 0-7', res)
    fit(cc,   'sev4',   AUX,  'M5 AUXILIARY + Age-band midpoint + female, scale 0/1/2/3+', res)
    fit(cc,   'sev7',   AUX,  'M6 AUXILIARY + Age-band midpoint + female, scale 0-7', res)
    P('\n    Missing-AE patients are 131/143 Placebo vs 12/500 BCG. Coding them severity=0 therefore adds'
      )
    P('    empty outcomes mostly to the placebo arm AND they carry fewer ongoing conditions (%.2f vs %.2f):'
      % (d[d.has_ae == 0].n_ongoing_MH.mean(), d[d.has_ae == 1].n_ongoing_MH.mean()))
    P('    that imputation moves BCG %+.1f%% -> %+.1f%% and the exposure answer %+.1f%% -> %+.1f%% (biased UPWARD).'
      % (res[0]['pct_BCG'], res[2]['pct_BCG'], res[0]['pct'], res[2]['pct']))
    P('    The complete-case figure is reported as primary; the imputed figure is an upper bound, not a substitute.')
    m1r = [r for r in res if r['label'].startswith('M1')][0]
    for r in res:
        if 'AUX' in r['label'] and r['y'] == m1r['y'] and r['llf'] < m1r['llf'] - 1e-6:
            P('    !! NESTEDNESS VIOLATION: %s llf=%.4f < primary llf=%.4f' % (r['label'], r['llf'], m1r['llf']))
    po = po_tests(d)
    sens = sensitivity(d)
    prim = res[0]
    P('\n' + '='*78); P('[6] FINAL ANSWER')
    P('    +%.0f%% increase in the odds of a HIGHER severity category per additional ongoing medical condition' % prim['pct'])
    P('    (beta = %.4f, SE %.4f, 95%% CI %.1f%% .. %.1f%%, p = %.2g)' % (prim['beta'], prim['se'], prim['lo'], prim['hi'], prim['p']))
    P('    model: cumulative-logit proportional-odds, n=857 complete cases, outcome = patient-level max AEHS')
    P('    collapsed to 0/1/2/3+; adjusted for BCG (TRTGRP), patients_seen, work_hours, expect_interact.')
    P('    OUTCOME = SURROGATE (AE hospitalisation/severity score AEHS), not a recorded COVID-19 severity field.')
    P('    range over specifications: %.1f%% .. %.1f%%' % (min(r['pct'] for r in res+sens), max(r['pct'] for r in res+sens)))
    json.dump(dict(primary=prim, models=res, po_tests=po, sensitivity=sens),
              open(f'{OUT}/final_results.json', 'w'), indent=2, default=float)
    open(f'{OUT}/full_report.txt', 'w').write('\n'.join(L))
    return prim

if __name__ == '__main__':
    main()
