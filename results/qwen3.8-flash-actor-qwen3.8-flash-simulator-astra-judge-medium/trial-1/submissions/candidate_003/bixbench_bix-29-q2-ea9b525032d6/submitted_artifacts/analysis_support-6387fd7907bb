"""Generalised (non-parallel) cumulative logit helpers, log-likelihood verified against
statsmodels OrderedModel (agreement < 1e-3 on both scales used here)."""
import numpy as np

def unpack(par, p, K, nonpar_idx):
    nk = K-1
    a = np.asarray(par)[:nk]
    thr = np.concatenate([[a[0]], a[0]+np.cumsum(np.exp(a[1:]))])
    shared_cols = [c for c in range(p) if c not in nonpar_idx]
    ns, nb = len(shared_cols), len(nonpar_idx)
    shared = np.asarray(par)[nk:nk+ns]
    nonpar = np.asarray(par)[nk+ns:].reshape(nk, nb)
    B = np.zeros((nk, p))
    if ns: B[:, shared_cols] = shared[None,:]
    for j,c in enumerate(nonpar_idx): B[:,c] = nonpar[:,j]
    return thr, B

def nll(par, X, y, K, nonpar_idx):
    n, p = X.shape
    thr, B = unpack(par, p, K, nonpar_idx)
    z = thr[None,:] - X@B.T
    cum = np.clip(1/(1+np.exp(-np.clip(z,-500,500))), 1e-12, 1-1e-12)
    probs = np.hstack([cum[:,:1], np.clip(np.diff(cum,axis=1),1e-12,None),
                       np.clip(1-cum[:,-1:],1e-12,None)])
    return -np.log(np.clip(probs[np.arange(n), y], 1e-300, None)).sum()

def start_from_po(m, p, K, nonpar_idx, colnames):
    """Convert a statsmodels OrderedModel fit (increasing-threshold parametrisation) to our params."""
    b0 = np.asarray(m.params)[:p]; raw = np.asarray(m.params)[p:]
    thr = np.concatenate([[raw[0]], raw[0]+np.cumsum(np.exp(raw[1:]))])
    a = np.concatenate([[thr[0]], np.log(np.clip(np.diff(thr),1e-8,None))])
    if not nonpar_idx: return np.concatenate([a, b0])
    shared_cols = [c for c in range(p) if c not in nonpar_idx]
    return np.concatenate([a, b0[shared_cols], np.tile(b0[nonpar_idx], K-1).ravel()])
