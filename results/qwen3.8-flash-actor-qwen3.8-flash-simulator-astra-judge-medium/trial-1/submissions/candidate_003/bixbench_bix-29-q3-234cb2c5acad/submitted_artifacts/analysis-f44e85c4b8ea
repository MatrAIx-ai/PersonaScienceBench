# TASK008_BCG-CORONA_MH.xlsx verified cell-for-cell identical to MH.csv -> CSV only.

say("== 1. INPUT ==")
say(f"DM {dm.shape} subjects={dm.USUBJID.nunique()} missing_cells={int(dm.isna().sum().sum())}")
say(f"AE {ae.shape} subjects={ae.USUBJID.nunique()}   MH {mh.shape} subjects={mh.USUBJID.nunique()}")
