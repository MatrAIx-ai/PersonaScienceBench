say(f"AE real records={len(ae_real)}; empty placeholder rows={int(ae.AEPT.isna().sum())}; "
    f"subjects with >=1 AE={ae_real.USUBJID.nunique()}")
say("AESEV counts:", ae_real.AESEV.value_counts(dropna=False).sort_index().to_dict())

