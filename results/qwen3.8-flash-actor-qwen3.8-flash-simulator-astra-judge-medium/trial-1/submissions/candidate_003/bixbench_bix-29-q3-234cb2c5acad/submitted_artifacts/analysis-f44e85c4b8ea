def mn_joint_wald(m, cols, term):
    """Joint Wald test for one term across all multinomial contrasts; auto-detects the
    covariance-parameter ordering and validates it against the reported SEs."""
    k, J = m.params.shape
    V = np.asarray(m.cov_params()); i = cols.index(term) + 1
    layouts = {"outcome_major": (V.reshape(J, k, J, k), lambda a, c: (a, i, c, i)),
               "var_major": (V.reshape(k, J, k, J), lambda a, c: (i, a, i, c))}
    for nm, (V4, ix) in layouts.items():
        dd = np.array([V4[ix(j, j)] for j in range(J)])
        if np.allclose(dd, m.bse[i, :] ** 2, rtol=1e-5, atol=1e-10):
            d = np.array([[V4[ix(a, c)] for c in range(J)] for a in range(J)])
            b = m.params[i, :]
            w = float(b @ np.linalg.solve(d, b))
            return nm, w, float(stats.chi2.sf(w, J))
    return "unknown", float("nan"), float("nan")

