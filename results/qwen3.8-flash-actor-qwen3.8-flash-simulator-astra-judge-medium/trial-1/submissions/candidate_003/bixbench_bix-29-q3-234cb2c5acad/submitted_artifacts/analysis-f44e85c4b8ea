med["pos"] = med.MHORRES.eq("2")          # code 1 = absent, 2 = present (no codebook shipped)
STRICT = {"Hypertension", "Diabetes Mellitus", "Asthma", "Chronic Obstructive Pulmonary Disease",
          "Other lung disease", "Cardiovascular disease", "Cerebrovascular disease",
          "Kidney disease", "Liver disease", "Cancer", "Organ or bone marrow transplantation",
          "Primary immunodeficiency", "Neutropenia or lymphopenia", "Tuberculosis",
          "chronic sinusitis"}
mh_broad = med.groupby("USUBJID").pos.any()
mh_strict = med[med.MHTERM.isin(STRICT)].groupby("USUBJID").pos.any()
say(f"\npriorMH broad prevalence={mh_broad.mean():.3f} ({int(mh_broad.sum())}/{len(mh_broad)}); "
    f"strict (no allergy/hay-fever)={mh_strict.reindex(mh_broad.index).fillna(False).mean():.3f}")

# ---------------------------------------------------------------- 3. OUTCOME
INF_PT = re.compile(r"COVID|CORONA|SARS", re.I)
pool = ae_real[ae_real.AECAT.eq("RTI") | ae_real.AEPT.str.contains(INF_PT, na=False)].copy()
pool["sev"] = pd.to_numeric(pool.AESEV, errors="coerce")
pool["hs"] = pd.to_numeric(pool.AEHS, errors="coerce")
c19 = ae_real[ae_real.AEPT.str.contains(INF_PT, na=False)].copy()
c19["sev"] = pd.to_numeric(c19.AESEV, errors="coerce")
c19["hs"] = pd.to_numeric(c19.AEHS, errors="coerce")
say("\n== 2. OUTCOME CONSTRUCTION ==")
say(f"infection-related AE records={len(pool)} subjects={pool.USUBJID.nunique()}; "
    f"AECAT mix={pool.AECAT.value_counts(dropna=False).to_dict()}; ISR records in pool="
    f"{int(pool.AECAT.eq('ISR').sum())}")
say(f"COVID/CORONA/SARS-coded AE records={len(c19)} subjects={c19.USUBJID.nunique()}")
say("pool rows with AESEV missing:", int(pool.sev.isna().sum()),
    "| of those AESER=Yes:", int(pool[pool.sev.isna()].AESER.eq('Yes').sum()))

def agg(df):
    return df.groupby("USUBJID").agg(maxsev=("sev", "max"), maxhs=("hs", "max"),
                                     anyser=("AESER", lambda s: s.eq("Yes").any()))

def severity(r, ser_any=False):
    if pd.isna(r["maxsev"]) and pd.isna(r["maxhs"]):
        return 0
    s, ser = r["maxsev"], r["anyser"]
    if ser_any and ser and pd.isna(s):
        return 3
    if pd.notna(s) and s >= 3: return 3
    if ser: return 3
    if pd.notna(s) and s == 2: return 2
    return 1

base = dm.set_index("USUBJID").copy()
base["bcg"] = base.TRTGRP.eq("BCG").astype(int)
base["prior_mh"] = base.index.map(mh_broad).fillna(False).astype(int)
base["prior_mh_strict"] = base.index.map(mh_strict.reindex(mh_broad.index).fillna(False)).astype(int)
base["sex"] = pd.to_numeric(base.SEX, errors="coerce")
base["age_ord"] = base.Age.map({"10-19": 1, "20-29": 2, "30-39": 3, "40-49": 4,
                                "50-59": 5, "60-69": 6, "70-79": 7})
a_inf, a_c19 = agg(pool), agg(c19)
base = base.join(a_inf.add_prefix("inf_"), how="left").join(a_c19.add_prefix("c19_"), how="left")
inf = a_inf.reindex(base.index); c19a = a_c19.reindex(base.index)
base["Y4"] = [severity(r) for _, r in inf.iterrows()]
base["Y4_sevfix"] = [severity(r, ser_any=True) for _, r in inf.iterrows()]
base["Y3"] = base.Y4.clip(upper=2)
base["Y_c19"] = [severity(r) for _, r in c19a.iterrows()]
base["Y3_c19"] = base.Y_c19.clip(upper=2)
hs = inf.maxhs
base["Y_aeHS"] = np.where(hs.isna(), 0, np.where(hs <= 2, 1, np.where(hs <= 4, 2, 3)))
say("\nDV distributions:")
for c in ["Y4", "Y3", "Y4_sevfix", "Y3_c19", "Y_c19", "Y_aeHS"]:
    say(f"  {c:10s}", base[c].value_counts().sort_index().to_dict())
say(f"  subjects reclassified by AESEV-missing/AESER sensitivity: {int((base.Y4 != base.Y4_sevfix).sum())}")
base.to_csv(Rp("subject_level_analytic_table.csv"))

cnt = base.groupby(["bcg", "prior_mh"]).Y4.value_counts().unstack(fill_value=0)
pct = (base.groupby(["bcg", "prior_mh"]).Y4.value_counts(normalize=True).mul(100).round(1)
       .unstack(fill_value=0))
lbl = [f"{'BCG' if b else 'Placebo'} / priorMH={'yes' if m else 'no'}" for b, m in cnt.index]
cnt.index = lbl; pct.index = lbl
cnt.to_csv(Rp("crosstab_2x4_counts.csv")); pct.to_csv(Rp("crosstab_2x4_proportions.csv"))
say("\n== 3. EXPLORATORY: 2x4 cross-tab of severity within BCG x priorMH ==")
say("counts:\n" + cnt.to_string()); say("within-cell %:\n" + pct.to_string())

# ---------------------------------------------------------------- 4. DESIGN
def design(d, mhvar="prior_mh", freq="patients_seen", expect=True, extra=()):
    X = pd.DataFrame(index=d.index)
    X["BCG"] = d.bcg.astype(float)
    X["priorMH"] = d[mhvar].astype(float)
    X["BCGxMH"] = d.bcg * d[mhvar]
    if freq == "patients_seen":
        X["patients_seen_51_100"] = d.patients_seen.eq("51-100").astype(float)
        X["patients_seen_gt100"] = d.patients_seen.eq(">100").astype(float)
    elif freq == "work_hours":
        X["work_hours_41_80"] = d.work_hours.eq("41-80").astype(float)
        X["work_hours_gt80"] = d.work_hours.eq(">80").astype(float)
    if expect:
        X["expect_interact_Yes"] = d.expect_interact.eq("Yes").astype(float)
    for e in extra:
        X[e] = d[e].astype(float)
    return X

def fit_po(y, X):
    m = OrderedModel(np.asarray(y), X, distr="logit")
    res, ok = None, False
    for meth in ("newton", "bfgs", "nm"):
        try:
            r = m.fit(method=meth, maxiter=2000, disp=0)
            conv = bool(r.mle_retvals.get("converged", True)) if isinstance(r.mle_retvals, dict) else True
            if conv and np.all(np.isfinite(r.params)) and np.all(np.isfinite(r.bse)):
                res, ok = r, True; break
        except Exception as e:
            last = str(e)
    if res is None:
        raise RuntimeError("OrderedModel failed to converge / non-finite SE")
    res.fit_method_ok = ok
    return res

def or_table(res, names):
    rows = []
    for nm in names:
        b, se = float(res.params[nm]), float(res.bse[nm])
        rows.append(dict(term=nm, beta=b, se=se, OR=np.exp(b), OR_lo95=np.exp(b - Z * se),
                         OR_hi95=np.exp(b + Z * se), p_wald=float(res.pvalues[nm])))
    return pd.DataFrame(rows)

def contrast(res, coefs, label):
    V = res.cov_params()
    b = float(sum(res.params[c] for c in coefs))
    v = float(sum(V.loc[i, j] for i in coefs for j in coefs))
    se = np.sqrt(v); zz = b / se
    return dict(contrast=label, beta=b, se=se, OR=np.exp(b), OR_lo95=np.exp(b - Z * se),
                OR_hi95=np.exp(b + Z * se), p_wald=float(2 * stats.norm.sf(abs(zz))))

def fit_and_report(y, X, X_red, label, bag):
    full, red = fit_po(y, X), fit_po(y, X_red)
    lr = 2 * (full.llf - red.llf); dfd = X.shape[1] - X_red.shape[1]
    lrp = float(stats.chi2.sf(lr, dfd))
    tab = or_table(full, list(X.columns)); tab.insert(0, "spec", label)
    sf = pd.DataFrame([
        contrast(full, ["BCG"], "simple effect BCG | priorMH=no"),
        contrast(full, ["BCG", "BCGxMH"], "simple effect BCG | priorMH=yes"),
        contrast(full, ["priorMH"], "simple effect priorMH | Placebo"),
        contrast(full, ["priorMH", "BCGxMH"], "simple effect priorMH | BCG"),
        contrast(full, ["BCGxMH"], "INTERACTION BCG x priorMH")])
    sf.insert(0, "spec", label)
    sf["lr_chi2_interaction"] = lr; sf["lr_df"] = dfd; sf["lr_p"] = lrp
    sf["llf_full"] = full.llf; sf["llf_reduced"] = red.llf; sf["n"] = int(full.nobs)
    sf["n_categories"] = int(len(set(np.asarray(y))))
    sf["max_or_se"] = float(max(full.bse[c] for c in X.columns))
    bag["models"].append(tab); bag["simple"].append(sf)
    say(f"\n--- {label}")
    say(f"    n={int(full.nobs)}  levels={sorted(set(np.asarray(y)))}  llf={full.llf:.3f}  "
        f"max SE over covariates={sf['max_or_se'].iloc[0]:.3f}")
    say(tab.drop(columns="spec").round(4).to_string(index=False))
    say(f"    LR test interaction: chi2={lr:.3f} df={dfd} p={lrp:.4g}")
    say(sf.drop(columns=["spec", "llf_full", "llf_reduced", "n_categories"]).round(4).to_string(index=False))
    return full

bag = {"models": [], "simple": []}
say("\n== 4. ORDINAL (PROPORTIONAL-ODDS) MODELS ==")
Xp = design(base); Xp_red = design(base).drop(columns="BCGxMH")
full_p = fit_and_report(base.Y4, Xp, Xp_red,
    "PRIMARY  Y4(none/mild/moderate/severe) ~ BCG + priorMH + BCGxMH + patients_seen + expect_interact", bag)

