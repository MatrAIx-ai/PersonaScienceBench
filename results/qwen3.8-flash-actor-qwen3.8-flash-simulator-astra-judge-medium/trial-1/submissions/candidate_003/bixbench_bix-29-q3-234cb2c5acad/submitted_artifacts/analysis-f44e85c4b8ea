#!/usr/bin/env python3
"""
BCG-CORONA (TASK008): interaction between BCG vaccination status and prior medical
history on COVID-19 severity -- ordinal (cumulative-logit / proportional-odds)
regression controlling for patient-interaction frequency.

Primary specification (approved with researcher):
  DV : 4-level ordinal built from AE (the only outcome source; DM carries no endpoint)
       0 = no infection-related AE
       1 = mild      (max AESEV = 1 among infection-related AEs)
       2 = moderate  (max AESEV = 2)
       3 = severe    (max AESEV >= 3 OR AESER = 'Yes')
       infection-related AE := AECAT == 'RTI' OR AEPT matches COVID|CORONA|SARS
  Model: cumulative logit / proportional odds (statsmodels OrderedModel, logit link)
       Severity ~ BCG + priorMH + BCG:priorMH + patients_seen (3 dummies) + expect_interact
  Inference on interaction: OR = exp(beta), 95% Wald CI, Wald p, LR test vs nested
  no-interaction model, simple effects of BCG within priorMH = 0 / 1.

Sign convention (verified on simulated data, beta recovered 0.999 for true 1.0):
  OrderedModel fits P(Y > j) = expit(x'beta - alpha_j)  =>  exp(beta) = odds ratio of
  being in a MORE severe category.

Outputs: console report, results/*.csv, results/report.md
"""
import os, re, warnings
import numpy as np
import pandas as pd
from scipy.optimize import minimize
from scipy.special import expit
from scipy import stats
import statsmodels.api as sm
from statsmodels.api import Logit, MNLogit
from statsmodels.miscmodels.ordinal_model import OrderedModel

warnings.filterwarnings("ignore")
