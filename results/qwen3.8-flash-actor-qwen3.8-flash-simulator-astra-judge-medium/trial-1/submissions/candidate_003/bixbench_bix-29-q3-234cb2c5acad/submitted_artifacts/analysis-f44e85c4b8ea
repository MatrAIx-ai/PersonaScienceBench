    ("S7  + sex + age covariates", "Y4", dict(extra=("sex", "age_ord")), dict(extra=("sex", "age_ord"))),
    ("S8  AESEV-missing & serious -> severe", "Y4_sevfix", dict(), dict()),
    ("S9  NO frequency adjustment (raw BCG x MH interaction)", "Y4", dict(freq="none", expect=False), dict(freq="none", expect=False)),
]
for lab, ycol, kw, kwr in specs:
    Xs = design(base, **kw)
    Xs = Xs[[c for c in Xs.columns if Xs[c].nunique(dropna=True) > 1]]
    Xr = Xs.drop(columns=[c for c in ["BCGxMH"] if c in Xs.columns])
    fit_and_report(base[ycol], Xs, Xr, lab, bag)

ALL_M = pd.concat(bag["models"], ignore_index=True)
ALL_S = pd.concat(bag["simple"], ignore_index=True)
ALL_M.to_csv(Rp("ordinal_model_ORs_all_specs.csv"), index=False)
ALL_S.to_csv(Rp("interaction_inference_all_specs.csv"), index=False)

# ---------------------------------------------------------------- 5. PO DIAGNOSTICS
say("\n== 5. PROPORTIONAL-ODDS DIAGNOSTICS (primary specification, Y4) ==")
y = base.Y4.values.astype(int); Xd = Xp.values.astype(float); cols = list(Xp.columns)
K = int(y.max()) + 1; T = K - 1

brant = []
for j in range(T):
    r = Logit((base.Y4 > j).astype(float), sm.add_constant(Xd)).fit(disp=0)
    for k, c in enumerate(["const"] + cols):
        pv, bv, zv = r.params.values, r.bse.values, r.pvalues.values
        brant.append(dict(threshold=f"Y>{j}", term=c, beta=float(pv[k]),
                          se=float(bv[k]), p=float(zv[k])))
BRANT = pd.DataFrame(brant); BRANT.to_csv(Rp("po_brant_threshold_specific_logits.csv"), index=False)
say("threshold-specific binary-logit coefficients (constant down a column => PO plausible):")
say(BRANT[BRANT.term != "const"].pivot(index="term", columns="threshold", values="beta").round(3).to_string())
say("... and |beta|/se per threshold:")
say(BRANT[BRANT.term != "const"].assign(z=lambda d: d.beta / d.se)
    .pivot(index="term", columns="threshold", values="z").round(2).to_string())

def cat_prob(LP, a, yv, T):
    P = np.clip(expit(LP - a[None, :]), 1e-12, 1 - 1e-12)
    Pc = np.column_stack([1 - P[:, 0]] + [P[:, j - 1] - P[:, j] for j in range(1, T)] + [P[:, -1]])
    return np.clip(Pc[np.arange(len(yv)), yv], 1e-300, None)

def nll_po(pr, X, yv, T):
    return -np.log(cat_prob(np.repeat((X @ pr[T:])[:, None], T, axis=1), pr[:T], yv, T)).sum()

def _grad(f, x, h=1e-5):
    g = np.zeros_like(x, dtype=float)
    for i in range(len(x)):
        xp = x.copy(); xm = x.copy(); xp[i] += h; xm[i] -= h
        g[i] = (f(xp) - f(xm)) / (2 * h)
    return g

def hessian_fd(f, x, h=1e-4):
    """Observed information (-2 log L Hessian) by central differences of the numeric gradient."""
    n = len(x); H = np.zeros((n, n))
    for j in range(n):
        xp = x.copy(); xm = x.copy(); xp[j] += h; xm[j] -= h
        H[:, j] = (_grad(f, xp, h) - _grad(f, xm, h)) / (2 * h)
    return (H + H.T) / 2

def fit_gologit(yv, X, cols, np_cols, free_cuts=None):
    """Generalised (partially proportional) cumulative logit.

    Every term keeps one proportional slope bp; terms listed in np_cols additionally get
    free_cuts cut-point-specific DEVIATIONS added to their slope at the FIRST free_cuts
    cumulative logits (the last cut is the reference).  The proportional-odds model is
    therefore properly NESTED (all deviations = 0) and each non-proportional term costs
    free_cuts extra df.  Default free_cuts = T-1, i.e. non-proportionality is tested only at
    the identifiable cuts, which matters here because the top cut of Y4 holds 24 events.
    """
    X = np.asarray(X, float); yv = np.asarray(yv, int)
    n, p = X.shape; T = int(yv.max())
    n_idx = [i for i, c in enumerate(cols) if c in np_cols]
    nb = len(n_idx)
    fc = (T - 1) if free_cuts is None else int(min(free_cuts, T - 1))
    def unpack(pr):
        a = pr[:T]; bp = pr[T:T + p]
        bn = np.zeros((nb, T))
        if nb and fc:
            bn[:, :fc] = pr[T + p:].reshape(nb, fc)          # bn[variable, cut]
        return a, bp, bn
    def nll(pr):
        a, bp, bn = unpack(pr)
        LP = np.repeat((X @ bp)[:, None], T, axis=1)
        for t in range(fc):
            LP[:, t] = LP[:, t] + X[:, n_idx] @ bn[:, t]
        return -np.log(cat_prob(LP, a, yv, T)).sum()
    p0 = np.r_[np.linspace(-1.5, 1.5, T), np.zeros(p), np.zeros(nb * fc)]
    r1 = minimize(nll, p0, method="L-BFGS-B", options=dict(maxiter=60000, maxfun=60000, ftol=1e-16, gtol=1e-14))
    r2 = minimize(nll, r1.x, method="BFGS", options=dict(maxiter=20000, gtol=1e-12))
    r = r2 if r2.fun <= r1.fun else r1
    for _ in range(3):                                        # full-memory BFGS polish (for SEs)
        r3 = minimize(nll, r.x, method="BFGS", options=dict(maxiter=20000, gtol=1e-13))
        if r3.fun <= r.fun + 1e-9 and hasattr(r3, "hess_inv"):
            r = r3
        if float(np.max(np.abs(_grad(nll, r.x)))) < 1e-5:
            break
    gnorm = float(np.max(np.abs(_grad(nll, r.x))))
    a, bp, bn = unpack(r.x)
    H = hessian_fd(nll, r.x)
    Hi = np.linalg.pinv(H)
    se = np.sqrt(np.clip(np.diag(Hi), 0, None))
    return dict(nll=float(r.fun), npar=len(r.x), gnorm=gnorm, ok=(gnorm < 1e-3), a=a, bp=bp, bn=bn,
                Hi=Hi, se=se, T=T, fc=fc, p=p, cols=list(cols), n_idx=n_idx,
                n_idx_names=[cols[i] for i in n_idx])

def golo_term_slopes(g):
    """Cut-specific slopes = common slope + deviation, with delta-method SEs."""
    T, fc, p, cols, Hi = g["T"], g["fc"], g["p"], g["cols"], g["Hi"]
    rows = []
    for m, c in enumerate(g["n_idx_names"]):
        i0 = T + cols.index(c)
        for t in range(T):
            idx = [i0] if t >= fc else [i0, T + p + m * fc + t]
            sgn = [1.0] if t >= fc else [1.0, 1.0]
            b = g["bp"][cols.index(c)] + (0.0 if t >= fc else g["bn"][m, t])
            v = sum(si * sj * Hi[i, j] for i, si in zip(idx, sgn) for j, sj in zip(idx, sgn))
            se = float(np.sqrt(max(v, 0)))
            rows.append(dict(term=c, threshold=f"Y>{t}", slope=b, se=se,
                             p=float(2 * stats.norm.sf(abs(b / se)) if se > 0 else 1.0)))
    return pd.DataFrame(rows)

def golo_joint_dev_test(g, term):
    """Wald test that all cut-specific deviations of `term` are 0 => that term is proportional."""
    T, fc, p = g["T"], g["fc"], g["p"]
    if term not in g["n_idx_names"] or fc == 0:
        return float("nan"), 0, float("nan")
    m = g["n_idx_names"].index(term)
    ix = [T + p + m * fc + t for t in range(fc)]
    b = np.array([g["bn"][m, t] for t in range(fc)])
    V = g["Hi"][np.ix_(ix, ix)]
    w = float(b @ np.linalg.solve(V, b))
    return w, fc, float(stats.chi2.sf(w, fc))

po_fit = minimize(nll_po, np.r_[np.linspace(-1.5, 1.5, T), np.zeros(len(cols))],
                  args=(Xd, y, T), method="BFGS", options=dict(maxiter=5000, gtol=1e-9))
po_nll = float(po_fit.fun)
po_gnorm = float(np.max(np.abs(_grad(lambda q: nll_po(q, Xd, y, T), po_fit.x))))
say(f"\ncontrol check - manual cumulative-logit MLE nll={po_nll:.4f} vs statsmodels -llf={-full_p.llf:.4f} "
    f"(match: {abs(po_nll + full_p.llf) < 0.05})")
rows = []
for npc in [["BCG"], ["priorMH"], ["BCGxMH"], ["BCG", "priorMH", "BCGxMH"],
            ["patients_seen_51_100", "patients_seen_gt100", "expect_interact_Yes"], list(cols)]:
    g = fit_gologit(y, Xd, cols, npc)
    lr = 2 * (po_nll - g["nll"]); dfd = g["npar"] - len(po_fit.x)
    rows.append(dict(non_proportional_terms="ALL_TERMS" if npc is cols else ",".join(npc),
                     lr_chi2=lr, df=dfd, p=float(stats.chi2.sf(max(lr, 0), dfd)),
                     nll_po=po_nll, nll_generalised=g["nll"], max_abs_gradient=g["gnorm"], converged=g["ok"]))
POT = pd.DataFrame(rows); POT.to_csv(Rp("po_lr_tests.csv"), index=False)
say("\nLR tests: proportional odds vs partially non-proportional (generalised) cumulative logit")
say(POT.round(4).to_string(index=False))
say("(each non-proportional term costs T-1 = 2 extra df; LR ~ 0 with df>0 means PO is not rejected)")

mn = MNLogit(y, sm.add_constant(Xd)).fit(disp=0, maxiter=800)
mn_rows = []
for j in range(mn.params.shape[1]):
    for k, c in enumerate(["const"] + cols):
        mn_rows.append(dict(outcome_vs_ref=f"Y={j+1}_vs_0", term=c, OR=float(np.exp(mn.params[k, j])),
                            se=float(mn.bse[k, j]), p=float(mn.pvalues[k, j])))
MN = pd.DataFrame(mn_rows); MN.to_csv(Rp("multinomial_logit_ORs.csv"), index=False)
