"""Independent re-derivation of the primary result: the analytic table is rebuilt from the raw
CSVs through a different code path (numeric parsing + groupby.agg instead of string comparisons),
and the primary model is estimated with a hand-written cumulative-logit MLE (scipy BFGS + numeric
observed information) instead of statsmodels OrderedModel."""
import numpy as np, pandas as pd
from scipy.optimize import minimize
from scipy.special import expit
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel

dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', keep_default_na=False, na_values=[''])
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', keep_default_na=False, na_values=[''])
ae = ae[ae.AEPT.notna()].copy()
ae["sev_n"] = pd.to_numeric(ae.AESEV, errors="coerce")
ae["ser_n"] = ae.AESER.str.upper().str.startswith("Y").fillna(False).astype(int)
pt = ae.AEPT.fillna("").str.upper()
inf = ae[(ae.AECAT == "RTI") | pt.str.contains("COVID") | pt.str.contains("CORONA") | pt.str.contains("SARS")]
g = inf.groupby("USUBJID").agg(maxsev=("sev_n", "max"), anyser=("ser_n", "max"), ninf=("sev_n", "size"))
mhpos = mh[mh.MHSCAT == "MEDICAL HISTORY"].assign(p=pd.to_numeric(mh.MHORRES, errors="coerce") == 2) \
          .groupby("USUBJID").p.max()
d = dm.set_index("USUBJID").join(g, how="left").join(mhpos.rename("mh"), how="left")
d["mh"] = d.mh.fillna(0).astype(int)
d[["maxsev", "anyser", "ninf"]] = d[["maxsev", "anyser", "ninf"]].fillna(0)
Y = np.where(d.ninf == 0, 0,
    np.where((d.maxsev >= 3) | (d.anyser == 1), 3,
    np.where(d.maxsev == 2, 2, 1)))
d["Y"] = Y
print("re-derived DV distribution:", pd.Series(Y).value_counts().sort_index().to_dict())
X = pd.DataFrame({"BCG": d.TRTGRP.eq("BCG").astype(float), "priorMH": d.mh.astype(float)})
X["BCGxMH"] = X.BCG * X.priorMH
X["ps51"] = d.patients_seen.eq("51-100").astype(float)
X["ps100"] = d.patients_seen.eq(">100").astype(float)
X["exp"] = d.expect_interact.eq("Yes").astype(float)
Xv, yv = X.values, d.Y.values.astype(int)
T, (n, p) = 3, Xv.shape
def nll(pr):
    a, b = pr[:T], pr[T:]
    P = np.clip(expit(np.repeat((Xv @ b)[:, None], T, axis=1) - a[None, :]), 1e-12, 1 - 1e-12)
    Pc = np.column_stack([1 - P[:, 0], P[:, 0] - P[:, 1], P[:, 1] - P[:, 2], P[:, -1]])
    return -np.log(np.clip(Pc[np.arange(n), yv], 1e-300, None)).sum()
r = minimize(nll, np.r_[np.linspace(-1, 1, T), np.zeros(p)], method="BFGS", options=dict(maxiter=20000, gtol=1e-13))
def grad(x, h=1e-5):
    return np.array([(nll(np.r_[x[:i], x[i] + h, x[i + 1:]]) - nll(np.r_[x[:i], x[i] - h, x[i + 1:]])) / (2 * h)
                     for i in range(len(x))])
H = np.zeros((len(r.x),) * 2)
for j in range(len(r.x)):
    xp = r.x.copy(); xm = r.x.copy(); xp[j] += 1e-4; xm[j] -= 1e-4
    H[:, j] = (grad(xp) - grad(xm)) / (2e-4)
se = np.sqrt(np.diag(np.linalg.pinv((H + H.T) / 2)))
i_int = T + 2
b = r.x[i_int]
print(f"hand-written MLE : beta={b:.5f} se={se[i_int]:.5f} OR={np.exp(b):.4f} "
      f"CI {np.exp(b - 1.96*se[i_int]):.4f}-{np.exp(b + 1.96*se[i_int]):.4f} "
      f"p={2*stats.norm.sf(abs(b/se[i_int])):.4f} nll={r.fun:.4f}")
m = OrderedModel(d.Y.values, X, distr="logit").fit(method="newton", disp=0)
print(f"statsmodels      : beta={m.params['BCGxMH']:.5f} se={m.bse['BCGxMH']:.5f} "
      f"OR={np.exp(m.params['BCGxMH']):.4f} p={m.pvalues['BCGxMH']:.4f} llf={m.llf:.4f}")
print(f"agreement: |d beta|={abs(b - m.params['BCGxMH']):.2e}  |d nll|={abs(r.fun + m.llf):.2e}")
