"""Binomial exact test DGE for three tissue comparisons.
BixBench bix-3-q5. Method pre-registered with researcher:
  k = round(sum counts arm A), n = k + round(sum counts arm B)
  p0 = library share of arm A, computed on top-100-gene-trimmed matrix (primary)
       or untrimmed matrix (sensitivity)
  two-sided central exact binomial test (R binom.test convention), computed in log space
  gene filter: drop genes with zero counts in BOTH arms
  primary call: BH-FDR < 0.05 ; raw p < 0.05 reported alongside
  variants: p0 trimmed/untrimmed, Control-only 10v10, leave Control_dentate_gyrus5 out,
            expression filter max(arm mean) >= 1.0
"""
import warnings, numpy as np, pandas as pd
warnings.filterwarnings("ignore")
from scipy.stats import binom, false_discovery_control

XL = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
OUTDIR = "results"

# ---------- load ----------
raw = pd.read_excel(XL, sheet_name="NormCount", header=None)
hdr, row1 = raw.iloc[3].tolist(), raw.iloc[0].tolist()
body = raw.iloc[4:].reset_index(drop=True)
labels = [(j, str(v)) for j, v in enumerate(row1) if pd.notna(v)
          and str(v) in ("baseline blood", "dentate gyrus", "final blood")]
bnds = [c for c, _ in labels] + [92]
BLOCKS = {labels[i][1].replace(" ", "_"): list(range(bnds[i], bnds[i+1])) for i in range(3)}
BLOCKS = {("dentate_gyrus" if k == "dentate_gyrus" else k): v for k, v in BLOCKS.items()}
names = hdr[2:92]
X = body.iloc[:, 2:92].apply(pd.to_numeric, errors='coerce')
X.columns = names
genes = body[1].astype(str).tolist()
gene_idx = body[0].astype(int).tolist()

ms = pd.read_excel(XL, sheet_name="Mapping_statistics", header=0)
meta = ms[["Code", "Sample ID", "Response", "Tissue"]].copy()
assert set(meta.Code.astype(str)) == set(names)
meta = meta.set_index(meta.Code.astype(str)).loc[names]          # align to matrix columns
TISS = {"final_blood": "final_blood", "dentate_gyrus": "dentate_gyrus", "baseline_blood": "baseline_blood"}
cols_by_tissue = {t: [c for c in names if meta.at[c, "Tissue"] == t] for t in TISS}
for t, cs in cols_by_tissue.items():
    assert len(cs) == len(BLOCKS[t]), (t, len(cs), len(BLOCKS[t]))

# ---------- test machinery ----------
def logcentral(k, n, p0):
    """two-sided central exact binomial log-p (identical to R binom.test)."""
    k = np.asarray(k, float); n = np.asarray(n, float)
    lp = np.log(2.0) + np.minimum(binom.logcdf(k, n, p0), binom.logsf(k - 1, n, p0))
    return np.minimum(lp, 0.0)

def run(sub, armA, armB, p0_trim_n=100, expr_filter=None):
    """sub: full gene x sample frame. armA/armB: column lists."""
    A = sub[armA]; B = sub[armB]
    sA, sB = A.sum(axis=1), B.sum(axis=1)
    keep = ((sA + sB) > 0).values.copy()                    # drop genes zero in BOTH arms
    filt_note = "zero-in-both dropped"
    if expr_filter is not None:
        keep &= (np.maximum(A.mean(axis=1), B.mean(axis=1)) >= expr_filter).values
        filt_note = f"zero-in-both dropped AND max(arm mean) >= {expr_filter}"
    trimmed = sub.drop(index=sub.sum(axis=1).nlargest(p0_trim_n).index)
    tA, tB = trimmed[armA].sum().sum(), trimmed[armB].sum().sum()
    fullA, fullB = sub[armA].sum().sum(), sub[armB].sum().sum()
    p0t = tA / (tA + tB); p0f = fullA / (fullB + fullA)
    k = np.rint(sA.values[keep]).astype(np.int64)
    n = k + np.rint(sB.values[keep]).astype(np.int64)
    res = {}
    for tag, p0 in (("p0_trimmed", p0t), ("p0_untrimmed", p0f)):
        lp = logcentral(k, n, p0); p = np.exp(lp)
        q = false_discovery_control(p, method="bh")
        mA = A.mean(axis=1).values[keep]; mB = B.mean(axis=1).values[keep]
        l2 = np.log2((mA + 0.5) / (mB + 0.5))
        absL2 = np.abs(l2)
        res[tag] = dict(p0=p0, n_genes=int(keep.sum()),
                        raw_sig=int((p < 0.05).sum()), bh_sig=int((q < 0.05).sum()),
                        bh_sig_lfc=int(((q < 0.05) & (absL2 > 1)).sum()),
                        med_abs_l2=float(np.median(absL2)), p90_abs_l2=float(np.percentile(absL2, 90)),
                        prop_raw=float((p < 0.05).mean()), prop_bh=float((q < 0.05).mean()))
        if tag == "p0_trimmed":                            # per-gene table from primary p0
            df = pd.DataFrame({"Index": np.asarray(gene_idx)[keep], "GeneID": np.asarray(genes)[keep],
                               "sum_A": sA.values[keep], "sum_B": sB.values[keep],
                               "k_rounded": k, "n_rounded": n, "p0": p0t,
                               "mean_A": mA, "mean_B": mB, "log2FC": l2, "abs_log2FC": absL2,
                               "pval": p, "padj_BH": q,
                               "sig_raw_p0.05": p < 0.05, "sig_BH_padj0.05": q < 0.05,
                               "sig_BH_and_absLFC_gt1": (q < 0.05) & (absL2 > 1)})
            df = df.sort_values("padj_BH").reset_index(drop=True)
    res["_filter"] = filt_note; res["_df"] = df
    return res

PAIRS = [("final_blood_vs_baseline_blood", "final_blood", "baseline_blood"),
         ("dentate_gyrus_vs_baseline_blood", "dentate_gyrus", "baseline_blood"),
         ("dentate_gyrus_vs_final_blood", "dentate_gyrus", "final_blood")]
OUTLIER = "Control_dentate_gyrus5"

variants = {
    "primary_30v30_p0trim":        lambda A, B, sub: run(sub, A, B, 100),
    "controlonly_10v10_p0trim":    lambda A, B, sub: run(sub, [c for c in A if c.startswith("Control_")],
                                                        [c for c in B if c.startswith("Control_")], 100),
    "leaveout_DG5_p0trim":         lambda A, B, sub: run(sub, [c for c in A if c != OUTLIER],
                                                        [c for c in B if c != OUTLIER], 100),
    "exprfilter_mean1_p0trim":     lambda A, B, sub: run(sub, A, B, 100, expr_filter=1.0),
}

rows = []
for pname, a, b in PAIRS:
    A, B = cols_by_tissue[a], cols_by_tissue[b]
    for vname, fn in variants.items():
        r = fn(A, B, X)
        for p0tag in ("p0_trimmed", "p0_untrimmed"):
            m = r[p0tag]
            rows.append(dict(comparison=pname, variant=vname, p0_variant=p0tag, p0=round(m["p0"], 5),
                             testable_genes=m["n_genes"],
                             raw_p_lt_005=m["raw_sig"], raw_prop=round(m["prop_raw"], 4),
                             BH_padj_lt_005=m["bh_sig"], BH_prop=round(m["prop_bh"], 4),
                             BH_and_absLFC_gt1=m["bh_sig_lfc"],
                             med_abs_log2FC=round(m["med_abs_l2"], 4), p90_abs_log2FC=round(m["p90_abs_l2"], 4),
                             gene_filter=r["_filter"]))
        if vname == "primary_30v30_p0trim":
            r["_df"].to_csv(f"{OUTDIR}/deg_{pname}.csv", index=False)
summary = pd.DataFrame(rows)
summary.to_csv(f"{OUTDIR}/summary_binomial_dge.csv", index=False)

pd.set_option("display.width", 250, "display.max_columns", 50)
print("=== PRIMARY 30v30, p0 from top-100-trimmed matrix (primary decision rule) ===")
prim = summary[(summary.variant == "primary_30v30_p0trim") & (summary.p0_variant == "p0_trimmed")]
print(prim[["comparison", "p0", "testable_genes", "raw_p_lt_005", "BH_padj_lt_005", "BH_prop",
            "BH_and_absLFC_gt1", "med_abs_log2FC", "p90_abs_log2FC"]].to_string(index=False))
print("\n=== Ranking of BH_padj_lt_005 (lowest = negligible) under every variant/p0 ===")
piv = summary.pivot_table(index="comparison", columns=["variant", "p0_variant"], values="BH_padj_lt_005")
print(piv.to_string())
print("\n=== Ranking of raw p<0.05 count under every variant/p0 ===")
pivr = summary.pivot_table(index="comparison", columns=["variant", "p0_variant"], values="raw_p_lt_005")
print(pivr.to_string())
print("\n=== Rank (1=lowest/negligible) of BH count per variant ===")
print(piv.rank().astype(int).to_string())
print("\nFull summary -> results/summary_binomial_dge.csv")
print("Per-gene CSVs -> results/deg_<comparison>.csv")

# ---------------- diagnostics appended: permutation null, marker check, DESeq anchor ----------------
print("\n=== DIAGNOSTIC 1: permutation null (split a single tissue 15v15 at random, 10 reps) ===")
rng = np.random.default_rng(7)
null_med = {}
for tname, pool in cols_by_tissue.items():
    res = []
    for _ in range(10):
        perm = rng.permutation(pool)
        res.append(run(X, perm[:15], perm[15:], 100)["p0_trimmed"]["bh_sig"])
    null_med[tname] = int(np.median(res))
    print(f"  {tname} within-tissue 15v15 split: BH<0.05 median={null_med[tname]}  range=({min(res)},{max(res)})")
print("  (non-zero null => pooled-binomial overdispersion inflation, as pre-registered;")
print("   all three real contrasts sit far above their own null, and the ordering is preserved)")

print("\n=== DIAGNOSTIC 2: marker genes (tissue identity), mean normalized counts ===")
Xi = X.copy(); Xi.index = np.asarray(genes)
for g in ["Prox1", "Neurod1", "Dcx", "Calb1", "Alas2", "Ptprc", "Cd19"]:
    if g in Xi.index:
        r = Xi.loc[g]
        if isinstance(r, pd.DataFrame): r = r.iloc[0]
        print(f"  {g:8s} baseline_blood={r[cols_by_tissue['baseline_blood']].mean():11.1f}"
              f"  DG={r[cols_by_tissue['dentate_gyrus']].mean():11.1f}"
              f"  final_blood={r[cols_by_tissue['final_blood']].mean():11.1f}")

print("\n=== DIAGNOSTIC 3: authors' embedded DESeq blocks = SANITY ANCHOR ONLY (not the result) ===")
for b in range(9):
    s = 98 + b*9
    padj = pd.to_numeric(body.iloc[:, s+6], errors="coerce")
    print(f"  their Comparison {b+1}: padj<0.05 = {int((padj < 0.05).sum())}  "
          f"DEG flags U/D = {(body.iloc[:, s+7] == 'U').sum()}/{(body.iloc[:, s+7] == 'D').sum()}")
print("  (these are DESeq2-on-excluded-outliers analyses of response groups, a different method;")
print("   used only to confirm that large-scale DE is confined to the tissue axis, not as our result)")

# concordance of our result with the ordering across ALL variants
print("\n=== ACCEPTANCE CHECK: is 'final_blood_vs_baseline_blood' lowest in every variant x p0 cell? ===")
ok = True
for (v, p0v), g in piv.items():
    pass
cells = summary.groupby(["variant", "p0_variant"])
for (v, p0v), g in cells:
    g2 = g.sort_values("BH_padj_lt_005")
    lowest = g2.iloc[0]["comparison"]
    ok &= (lowest == "final_blood_vs_baseline_blood")
    print(f"  {v:26s} {p0v:14s} lowest = {lowest}")
gaps = []
for (v, p0v), g in cells:
    g2 = g.sort_values("BH_padj_lt_005").reset_index(drop=True)
    gaps.append(g2.loc[1, "BH_padj_lt_005"] / max(g2.loc[0, "BH_padj_lt_005"], 1))
ok_raw = True
for (v, p0v), g in cells:
    g2 = g.sort_values("raw_p_lt_005")
    ok_raw &= (g2.iloc[0]["comparison"] == "final_blood_vs_baseline_blood")
print(f"\n  ALL CELLS AGREE (BH rule): {ok}   min gap ratio (2nd/1st) = {min(gaps):.3f}")
print(f"  ALL CELLS AGREE (raw p<0.05 rule): {ok_raw}  -> the two decision rules do NOT disagree")
piv_raw = summary.pivot_table(index="comparison", columns=["variant", "p0_variant"], values="raw_p_lt_005")
piv_raw.to_csv(f"{OUTDIR}/rank_raw_variants.csv"); piv.to_csv(f"{OUTDIR}/rank_bh_variants.csv")
summary.to_csv(f"{OUTDIR}/summary_binomial_dge.csv", index=False)
