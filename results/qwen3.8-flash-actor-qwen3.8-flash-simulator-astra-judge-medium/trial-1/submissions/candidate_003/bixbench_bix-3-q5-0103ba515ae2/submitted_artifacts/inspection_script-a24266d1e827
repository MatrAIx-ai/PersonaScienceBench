"""Inspection-only script (NO differential testing) for
data/Data_deposition_RNAseq_Paroxetine_2017.xlsx  -- BixBench bix-3-q5 plan stage."""
import pandas as pd, numpy as np, datetime, openpyxl, warnings
warnings.filterwarnings("ignore")
XL = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
OUT = []
def P(*a): OUT.append(" ".join(str(x) for x in a)); print(OUT[-1])

wb = openpyxl.load_workbook(XL, read_only=True)
P("sheets:", wb.sheetnames)
raw = pd.read_excel(XL, sheet_name="NormCount", header=None)
P("NormCount raw shape:", raw.shape)
hdr, row1 = raw.iloc[3].tolist(), raw.iloc[0].tolist()
P("header row = Excel row 4; row1 labels at cols:",
  [(j, v) for j, v in enumerate(row1) if pd.notna(v)][:3], "...")
labels = [(j, str(v)) for j, v in enumerate(row1) if pd.notna(v)]
tissue_lbl = [l for l in labels if l[1] in ("baseline blood", "dentate gyrus", "final blood")]
bounds = [c for c, _ in tissue_lbl] + [92]
BLOCKS = {tissue_lbl[i][1]: list(range(bounds[i], bounds[i + 1])) for i in range(3)}
P("tissue blocks (positional col idx):", {k: (v[0], v[-1], len(v)) for k, v in BLOCKS.items()})
P("true merged cell ranges in NormCount:",

  len(openpyxl.load_workbook(XL)["NormCount"].merged_cells.ranges))
names = hdr[2:92]
P("n sample cols:", len(names), "| cols 92+ are derived, first 3:", hdr[92:95], "| DESeq cmp blocks at:",
  [j for j, v in enumerate(row1) if isinstance(v, str) and v.startswith("DESeq,")])

body = raw.iloc[4:].reset_index(drop=True)
P("gene rows:", len(body), "| Index unique:", body[0].is_unique, "| GeneID unique:", body[1].is_unique)
dates = int(body[1].map(lambda x: isinstance(x, (datetime.datetime, datetime.date))).sum())
P("GeneID cells stored as dates (Excel autocorrect):", dates)

X = body.iloc[:, 2:92].apply(pd.to_numeric, errors='coerce'); X.columns = names
V = X.values.astype(float)
P("NaN in matrix:", int(np.isnan(V).sum()), "| negatives:", int((V < 0).sum()), "| zeros:", int((V == 0).sum()))
P("min %.2f max %.3e | on 0.01 grid: %s | integer-valued %.2f%% fractional %.2f%%" %
  (np.nanmin(V), np.nanmax(V), bool(np.allclose(np.round(V, 2), V)),
   100 * np.isclose(V, np.round(V)).mean(), 100 * (~np.isclose(V, np.round(V))).mean()))
P("all-zero genes:", int((X.sum(axis=1) == 0).sum()))

ms = pd.read_excel(XL, sheet_name="Mapping_statistics", header=0)
P("Mapping_statistics shape:", ms.shape)
P("columns:", list(ms.columns))
P("Tissue x Response:\n", pd.crosstab(ms.Tissue, ms.Response).to_string())
P("Code set == NormCount sample set:", set(ms.Code.astype(str)) == set(names),
  "| dup Codes:", int(ms.Code.duplicated().sum()))
grp = pd.DataFrame([(n, "baseline_blood" if "baseline_blood" in n else
                     "dentate_gyrus" if "dentate_gyrus" in n else "final_blood",
                     n.split("_blood")[0] if "blood" in n else n.split("_gyrus")[0]) for n in names],
                   columns=["code", "tissue", "response"])
P("NormCount col-name composition:\n", pd.crosstab(grp.tissue, grp.response).to_string())
for t, cols in BLOCKS.items():  # cross-check labels via sheet's own Max/Median cols
    Xb = X.iloc[:, [c - 2 for c in cols]]
    i = ["baseline blood", "dentate gyrus", "final blood"].index(t)
    mx = pd.to_numeric(body.iloc[:, 92 + i], errors='coerce')
    P(f"block {t}: matches sheet 'Max' col exactly:", bool(np.allclose(Xb.max(axis=1), mx)))
open("/workspace/analysis/inspection_report.txt", "w").write("\n".join(OUT))
