"""Step 1-2: schema inspection only (no final answer numbers reported).

Inputs:
  data/Proteomic_data .xlsx  -> sheet 'Tumor vs Normal'
  data/MeRIP_RNA_result.xlsx -> sheet 'Date Formatting'  (existence check only)
"""
import re
import pandas as pd

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)

PROT = "data/Proteomic_data .xlsx"
MERIP = "data/MeRIP_RNA_result.xlsx"

# ---------- 1. Proteomic data ----------
df = pd.read_excel(PROT, sheet_name="Tumor vs Normal")

print("=== SHEET: 'Tumor vs Normal' ===")
print("shape (rows, cols):", df.shape)
print("\n--- headers / dtypes / non-null / sample values ---")
info = pd.DataFrame({
    "dtype": df.dtypes.astype(str),
    "non_null": df.notna().sum(),
    "n_unique": df.nunique(dropna=True),
    "example": [df[c].dropna().iloc[0] if df[c].notna().any() else None for c in df.columns],
})
print(info)

print("\n--- head(5) ---")
print(df.head(5).to_string())

print("\n--- Normal / Tumor column character ---")
for c in ["Normal", "Tumor"]:
    s = pd.to_numeric(df[c], errors="coerce")
    print(f"{c}: dtype={df[c].dtype}, numeric-coerce non-null={s.notna().sum()}/{len(s)}, "
          f"min={s.min()}, median={s.median()}, max={s.max()}, "
          f"n_negative={(s < 0).sum()}, n_le_30={(s <= 30).sum()} "
          f"(<=30 would suggest log2 scale)")

print("\n--- internal consistency check: is Ratio == Tumor/Normal ? ---")
num_n = pd.to_numeric(df["Normal"], errors="coerce")
num_t = pd.to_numeric(df["Tumor"], errors="coerce")
ratio = pd.to_numeric(df["Ratio"], errors="coerce")
fc = pd.to_numeric(df["FC"], errors="coerce")
log2fc = pd.to_numeric(df["log2FC"], errors="coerce")
chk_ratio = (num_t / num_n - ratio).abs()
chk_log2 = (num_t / num_n - 2 ** log2fc).abs()
print("median |Tumor/Normal - Ratio| :", chk_ratio.median())
print("median |Tumor/Normal - 2**log2FC| :", chk_log2.median())

print("\n--- duplicate genes ---")
g = df["gene"].astype("string").str.strip()
print("n rows:", len(df), "| unique genes:", g.nunique(dropna=True),
      "| rows with duplicate gene label:", int(g.duplicated(keep=False).sum()))
dup_counts = g.value_counts()
print("top repeated gene labels:")
print(dup_counts[dup_counts > 1].head(15))

print("\n--- ENO1 exact / tolerant matching ---")
raw = df["gene"].astype("string")
print("exact 'ENO1' rows:", int((raw == "ENO1").sum()))
print("case-insensitive 'eno1' rows:", int((raw.str.lower() == "eno1").sum()))
print("stripped 'ENO1' rows:", int((raw.str.strip() == "ENO1").sum()))
contains = raw.str.contains("ENO", case=True, na=False)
cand = raw[contains].unique().tolist()
print("gene labels containing 'ENO':", sorted(cand))
alias_like = [x for x in cand if re.search(r"^ENO1(\d+|L\d+|P\d+)?$", str(x))]
print("alias-like (kept OUT of the answer):", sorted(alias_like))

eno = df[raw.str.strip().str.upper() == "ENO1"].copy()
print("\nENO1 candidate rows (gene/protein/gene_id/Normal/Tumor non-null flags):")
print(eno[["protein", "gene", "gene_id", "Normal", "Tumor"]]
      .assign(Normal_nonnull=eno["Normal"].notna(),
              Tumor_nonnull=eno["Tumor"].notna()).to_string())

print("\nAny NaN in Normal/Tumor across whole table:",
      int(pd.to_numeric(df['Normal'], errors='coerce').isna().sum()),
      int(pd.to_numeric(df['Tumor'], errors='coerce').isna().sum()))

# ---------- 2. MeRIP file: existence / relevance check only, no computation ----------
print("\n=== FILE: MeRIP_RNA_result.xlsx (header only, no analysis) ===")
mhead = pd.read_excel(MERIP, sheet_name="Date Formatting", nrows=3)
print("columns:", list(mhead.columns))
print("Is there a 'Normal'/proteomic-intensity-like column? ->",
      [c for c in mhead.columns if str(c).lower() in {"normal", "tumor"}] or "NO")
