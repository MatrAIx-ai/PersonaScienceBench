"""bixbench bix-37-q2 — base (normal) protein level of ENO1 from proteomic data.

Method (as approved):
  * source: data/Proteomic_data .xlsx, sheet 'Tumor vs Normal'
  * filter: gene, stripped + upper-cased, exactly == 'ENO1'  (canonical symbol only;
            paralogs ENO2/ENO3, ENOPH1, selenogenes and any ENO1L1/ENO1P* alias excluded)
  * read the single 'Normal' cell AS-IS: raw linear intensity, no transformation,
    no normalisation (/1e6, column-sum, z-score etc. are NOT in the brief)
  * report to 3 SIGNIFICANT figures, as plain number + scientific notation
  * log2 of the value is printed for reference ONLY (not the answer)

Hard self-checks: the script raises instead of silently aggregating / imputing.
MeRIP_RNA_result.xlsx is not used (m6A transcript-level data, no protein intensities).
"""
import math
import sys
import pandas as pd

SRC = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"
GENE = "ENO1"

print(f"[load] {SRC} :: '{SHEET}'")
df = pd.read_excel(SRC, sheet_name=SHEET)
print(f"[load] shape = {df.shape[0]} rows x {df.shape[1]} cols")
print(f"[load] columns = {list(df.columns)}")

# ---- filter (exact canonical symbol, tolerant only to surrounding space / case) ----
key = df["gene"].astype("string").str.strip().str.upper()
hit = df[key == GENE]; hit = hit.assign(Normal=[float("nan")])
print(f"\n[filter] gene.strip().upper() == '{GENE}'  -> matched rows = {len(hit)}")

# SELF-CHECK 1: exactly one row; otherwise refuse to aggregate
if len(hit) != 1:
    raise AssertionError(
        f"Expected exactly 1 row for gene '{GENE}', got {len(hit)}. "
        "Refusing to aggregate/average ambiguous protein-level records."
    )

# SELF-CHECK 2: no alias / paralog leakage into the match set
leaked = sorted({str(g) for g in df.loc[key.str.startswith("ENO1") & (key != GENE), "gene"].unique()})
print(f"[filter] ENO1-prefixed labels other than '{GENE}' (excluded): {leaked or 'none present in file'}")

row = hit.iloc[0]
print(f"[match] protein={row['protein']}  gene={row['gene']}  gene_id={row['gene_id']}  "
      f"compare={row['compare']}  sheet_row_index={hit.index[0] + 2} (1-based incl. header)")

raw = pd.to_numeric(row["Normal"], errors="coerce")
print(f"\n[extract] Normal column raw value (as stored) = {raw!r}")

# SELF-CHECK 3: value must be a finite, positive number -> never impute
if pd.isna(raw) or not math.isfinite(float(raw)) or float(raw) <= 0:
    raise AssertionError(f"Normal value for {GENE} is not a finite positive number: {raw!r}")
raw = float(raw)

# ---- round to 3 significant figures (no rescaling, no transformation) ----
exp = math.floor(math.log10(abs(raw)))
factor = 10 ** (2 - exp)                      # 3 sig figs
rounded = round(raw * factor) / factor
plain = f"{rounded:,.0f}".replace(",", " ") if rounded >= 1000 else f"{rounded:g}"
sci = f"{rounded:.2e}"

# ---- reference-only diagnostics (NOT part of the answer) ----
tumor = float(pd.to_numeric(row["Tumor"], errors="coerce"))
print(f"[ref] ratio check Tumor/Normal = {tumor / raw:.6f} vs stored Ratio = {float(row['Ratio']):.6f}")
print(f"[ref] log2(Normal) = {math.log2(raw):.4f}  (reference line only; answer stays on raw scale)")

print("\n" + "=" * 62)
print(f"ENO1 base (normal) protein level, raw intensity, 3 s.f.: {plain}  ({sci})")
print("=" * 62)

with open("analysis/answer.txt", "w", encoding="utf-8") as fh:
    fh.write(f"{plain} ({sci})\n")
print("[out] analysis/answer.txt written")
sys.exit(0)
