"""
BixBench bix-42-q2: skewness of the RNA expression distribution (COAD geneExp).
Headline: pooled gene-by-sample values, as supplied (no filtering, no transformation),
Fisher-Pearson adjusted skewness (scipy.stats.skew, bias=False).
Secondary: per-sample skew across genes; per-gene skew across samples (rows as-is,
duplicated symbols NOT merged). Sensitivities: primary tumors only (type 01, n=285);
drop all-zero genes; log2(x+1) diagnostic on the pooled values.
Buckets: |skew|<0.5 approx normal; 0.5-1 minimal/moderate; >1 highly skewed.
Input note: data/COAD__geneExp.xls is tab-delimited text despite the .xls extension.
"""
import numpy as np
import pandas as pd
from scipy.stats import skew

PATH = "data/COAD__geneExp.xls"

def bucket(s: float) -> str:
    a = abs(s)
    if a < 0.5:
        return "approximately normal"
    d = "right" if s > 0 else "left"
    return f"{'highly' if a > 1 else 'minimally/moderately'} {d}-skewed"

g = pd.read_csv(PATH, sep="\t", index_col=0)   # genes x samples
V = g.to_numpy(dtype=np.float64)
print(f"matrix shape (genes x samples): {V.shape}")

# ---------- Headline: pooled values, as-supplied ----------
x = V.ravel()
s_pool = skew(x, bias=False)
q = np.percentile(x, [1, 25, 50, 75, 99])
print("\n[HEADLINE] pooled all gene x sample values, as supplied")
print(f"  n            = {x.size}")
print(f"  skew (G1)    = {s_pool:.4f}   -> {bucket(s_pool)}")
print(f"  mean         = {x.mean():.4f}")
print(f"  median       = {np.median(x):.4f}")
print("  quantiles 1/25/50/75/99% = " + " / ".join(f"{v:.4f}" for v in q))
print(f"  min/max      = {x.min():.4f} / {x.max():.4f}")

# ---------- Secondary 1: per-sample skew (across genes), 328 samples ----------
with np.errstate(invalid="ignore"):
    s_by_sample = skew(V, axis=0, bias=False)
qs = np.nanpercentile(s_by_sample, [5, 50, 95])
print("\n[SECONDARY] per-sample skew across genes (n=328 samples)")
print(f"  median skew  = {qs[1]:.4f}  (5/50/95 pct = {qs[0]:.4f} / {qs[1]:.4f} / {qs[2]:.4f})")
print(f"  samples with skew > 1: {np.nanmean(s_by_sample > 1) * 100:.1f}%; "
      f"skew > 0: {np.nanmean(s_by_sample > 0) * 100:.1f}%")

# ---------- Secondary 2: per-gene skew (across samples), 20502 rows, dups kept ----------
with np.errstate(invalid="ignore"):
    s_by_gene = skew(V, axis=1, bias=False)
qg = np.nanpercentile(s_by_gene, [5, 50, 95])
n_nan = int(np.isnan(s_by_gene).sum())
print("\n[SECONDARY] per-gene skew across samples (n=20502 rows, duplicate symbols NOT merged)")
print(f"  NaN skews (constant rows): {n_nan}")
print(f"  median skew  = {qg[1]:.4f}  (5/50/95 pct = {qg[0]:.4f} / {qg[1]:.4f} / {qg[2]:.4f})")
print(f"  genes with skew > 1: {np.nanmean(s_by_gene > 1) * 100:.1f}%; "
      f"skew < -1: {np.nanmean(s_by_gene < -1) * 100:.1f}%")

# ---------- Sensitivity A: primary tumors only (barcode sample type 01) ----------
types = np.array([c.split("-")[3][:2] for c in g.columns])
tumor = V[:, types == "01"]
s_tumor = skew(tumor.ravel(), bias=False)
print(f"\n[SENS A] primary tumors only (type 01, n_samples={tumor.shape[1]}): "
      f"skew = {s_tumor:.4f} -> {bucket(s_tumor)}")

# ---------- Sensitivity B: drop all-zero genes ----------
nz = V[(V == 0).sum(axis=1) < V.shape[1]]
s_nz = skew(nz.ravel(), bias=False)
print(f"[SENS B] drop all-zero genes (dropped {V.shape[0] - nz.shape[0]}, kept {nz.shape[0]}): "
      f"skew = {s_nz:.4f} -> {bucket(s_nz)}")

# ---------- Sensitivity C: log2(x+1) diagnostic on pooled values ----------
s_log = skew(np.log2(x + 1.0), bias=False)
print(f"[SENS C] log2(x+1) pooled (diagnostic only): skew = {s_log:.4f} -> {bucket(s_log)}")
