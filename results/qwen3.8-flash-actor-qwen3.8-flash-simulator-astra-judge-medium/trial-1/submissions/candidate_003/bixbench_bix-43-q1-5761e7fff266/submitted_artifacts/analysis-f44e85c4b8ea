"""CBD+cisplatin vs DMSO -> gseapy GO_Biological_Process_2021 enrichment pipeline.
READY-TO-RUN end-to-end. Automatically uses the best available route:

DE route:   primary = pydeseq2 (as approved). If unavailable -> OFF-SPEC manual
            fallback: DESeq2-style median-of-ratios size factors + per-gene
            negative-binomial LRT (scipy.stats), common dispersion by method of
            moments. The fallback is clearly labelled in all outputs.
Enrichment: gseapy.enrichr + gseapy.prerank on GO_Biological_Process_2021.
            If gseapy/network unavailable -> gene lists and ranked table are
            written to analysis/ for one-command rerun elsewhere; NO substitute
            library is used and NO term is invented.
Outputs: analysis/de_results_combo_vs_dmso.csv, analysis/ranked_gene_list.csv,
         analysis/genes_{all_sig,up,down}.txt, analysis/enrichment_results.csv,
         analysis/summary.txt
"""
import os, sys, itertools
import numpy as np, pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

OUT = os.path.dirname(os.path.abspath(__file__))
COMBO, CTRL = "Cisplatin_IC50_CBD_IC50", "DMSO"
summary = []
def log(*a):
    print(*a); summary.append(" ".join(str(x) for x in a))

# ---------- 1. load ----------
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("data/sample_layout.csv")
mapping = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t").set_index("ENSG")["gene_name"]
cols = {g: [c.replace("-", "_") for c in layout.loc[layout.Group == g, "SampleID"]]
        for g in (COMBO, CTRL)}

# ---------- 2. filter ----------
keep = (counts.sum(axis=1) > 0)
sub_all = counts[keep]
six = cols[COMBO] + cols[CTRL]
keep2 = (sub_all[six] >= 3).sum(axis=1) >= 3
filt = sub_all[keep2]
log(f"[filter] total={len(counts)} -> nonzero={len(sub_all)} -> >=3counts_in_>=3of6={len(filt)}")

# ---------- 3. size factors (median-of-ratios) ----------
lg = np.log(filt[six].replace(0, np.nan))
ref = lg.mean(axis=1)
sf = np.exp((lg.sub(ref, axis=0)).median(axis=0))
norm = filt[six] / sf
log("[sizefactors]", {c: round(v, 3) for c, v in sf.items()})

# ---------- 4. DE ----------
use_pydeseq2 = False
try:
    import pydeseq2  # noqa
    use_pydeseq2 = True
except ImportError:
    pass
if use_pydeseq2:
    from pydeseq2.dds import DeseqDataSet
    from pydeseq2.ds import DeseqStats
    cd = filt[six].copy(); cd.columns = six
    met = pd.DataFrame({"Group": [COMBO]*3 + [CTRL]*3}, index=six)
    dds = DeseqDataSet(counts=cd, metadata=met, design="~Group", ref_level=["Group", CTRL])
    dds.deseq2()
    ds = DeseqStats(dds, contrast=["Group", COMBO, "DMSO"]); ds.summary()
    res = ds.results_df.rename(columns={"log2FoldChange": "log2FC"}).dropna(subset=["padj"])
    de_method = "pydeseq2"
else:
    OFF_SPEC = "OFF-SPEC manual NB fallback (pydeseq2 unavailable offline)"
    log(f"[DE] {OFF_SPEC}")
    de_method = "manual-NB-LRT (OFF-SPEC)"
    X = filt[six].values.astype(float)
    S = sf.values[None, :]                       # 1 x 6
    grp = np.array([1]*3 + [0]*3)               # 1 = combo
    mu0 = (X[:, 3:6].sum(1) / S[0, 3:6].sum())   # control mean (normalized scale)
    mu1 = (X[:, 0:3].sum(1) / S[0, 0:3].sum())
    mub = X.sum(1) / S.sum()
    # common dispersion (method of moments, positive-phi genes with mean>=5)
    xn = X / S
    mn = xn.mean(1); vn = xn.var(1, ddof=1)
    phi = (vn - mn) / np.maximum(mn**2, 1e-12)
    ok = gmean_ok = mn >= 5
    alpha = float(np.median(phi[ok & (phi > 0)]))
    alpha = max(alpha, 1e-4)
    log(f"[DE] common NB dispersion alpha = {alpha:.4f}")
    def nb_ll(mu):
        mu = np.maximum(mu, 1e-12)
        r = 1.0 / alpha
        return stats.nbinom.logpmf(X, r, r / (r + mu)).sum(1)
    ll_pool = nb_ll(np.repeat(mub[:, None], 6, 1))
    ll_grp = nb_ll(np.where(grp == 1, mu1[:, None], mu0[:, None]))
    lrt = np.maximum(2 * (ll_grp - ll_pool), 0.0)
    pval = stats.chi2.sf(lrt, df=1)
    lfc = np.log2(np.maximum(mu1, 1e-9) / np.maximum(mu0, 1e-9))
    padj = multipletests(pval, method="fdr_bh")[1]
    res = pd.DataFrame({"log2FC": lfc, "pvalue": pval, "padj": padj}, index=filt.index)
    res = res.sort_values("pvalue")
log(f"[DE] method={de_method}; genes tested={len(res)}")

# ---------- 5. symbols ----------
sym = mapping.reindex(res.index)
unmapped = int(sym.isna().sum())
res = res.assign(symbol=sym).dropna(subset=["symbol"])
res = res.reset_index().rename(columns={"index": "ensembl"})
expr_mean = filt.mean(1)
res["_mean"] = expr_mean.reindex(res.ensembl).values
n_dupes = int(res.symbol.duplicated().sum())
res = (res.sort_values("_mean", ascending=False).drop_duplicates("symbol")
          .drop(columns="_mean").set_index("symbol"))
log(f"[symbols] after mapping={len(res)}, dropped unmapped ENSG={unmapped}, dedup-collapsed={n_dupes}")

sig_all = res[(res.padj < 0.05)]
up = sig_all[sig_all.log2FC > 0]; down = sig_all[sig_all.log2FC < 0]
log(f"[DEGs] padj<0.05: all={len(sig_all)} up_in_combo={len(up)} down_in_combo={len(down)}")

res.to_csv(f"{OUT}/de_results_combo_vs_dmso.csv")
ranked = (np.sign(res.log2FC) * -np.log10(res.pvalue))
rk = pd.DataFrame({"Term": res.index, "score": ranked.values}).sort_values(
    "score", ascending=False, kind="mergesort")   # stable sort for ties
rk.to_csv(f"{OUT}/ranked_gene_list.csv", index=False)
for name, g in [("all_sig", sig_all), ("up", up), ("down", down)]:
    pd.Series(g.index).to_csv(f"{OUT}/genes_{name}.txt", index=False, header=False)

# ---------- 6. enrichment (hard requirement: gseapy + GO_Biological_Process_2021) ----------
LIB = "GO_Biological_Process_2021"
try:
    import gseapy
    grid, tops = [], {}
    for name, g in [("all_sig", sig_all), ("up", up), ("down", down)]:
        r = gseapy.enrichr(gene_list=list(g.index), gene_sets=LIB, organism="human",
                           outdir=None).results
        r = r.sort_values("Adjusted P-value")
        r.insert(0, "variant", f"enrichr:{name}")
        grid.append(r)
        tops[f"enrichr:{name}"] = (r.Term.iloc[0], r["Adjusted P-value"].iloc[0])
    pr = gseapy.prerank(rnk=rk, gene_sets=LIB, min_size=5, max_size=500,
                        permutations=999, threads=2, outdir=None).res2d
    pr = pr.sort_values("Adjusted P-value")
    pr.insert(0, "variant", "prerank:genomewide")
    grid.append(pr)
    tops["prerank:genomewide"] = (pr.Term.iloc[0], pr["Adjusted P-value"].iloc[0])
    allres = pd.concat(grid, ignore_index=True)
    allres.to_csv(f"{OUT}/enrichment_results.csv", index=False)
    log("[enrichment] top term per variant:")
    for k, (t, p) in tops.items():
        log(f"  {k:24s} -> {t}  (adjP={p:.3g})")
    final_term = tops.get("enrichr:up", (None, None))[0]
    log(f"[ANSWER] headline term (enrichr up-in-combo, min 'Adjusted P-value'): {final_term}")
except Exception as e:
    log(f"[enrichment] BLOCKED ({type(e).__name__}: {e}). No substitution performed.")
    log("[enrichment] rerun this exact script where gseapy+Enrichr are reachable; "
        "all inputs (ranked_gene_list.csv, genes_*.txt) are ready.")

open(f"{OUT}/summary.txt", "w").write("\n".join(summary) + "\n")
