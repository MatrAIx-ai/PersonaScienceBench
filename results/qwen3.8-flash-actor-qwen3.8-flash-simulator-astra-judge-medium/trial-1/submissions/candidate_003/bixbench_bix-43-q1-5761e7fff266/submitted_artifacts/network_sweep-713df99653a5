"""Focused sweep: DNS failure vs true connectivity loss, plus offline artifact hunt."""
import socket, json, urllib.request, ssl, os

def tcp_ping(ip, port=443, t=5):
    try:
        s = socket.create_connection((ip, port), t); s.close()
        return f"OPEN {ip}:{port}"
    except Exception as e:
        return f"FAIL  {ip}:{port} {type(e).__name__}: {e}"

print("== 1a. raw TCP pings (no DNS) ==")
for ip in ["147.102.113.10", "151.101.0.0", "146.75.0.0", "1.1.1.1", "8.8.8.8"]:
    print(tcp_ping(ip))

print("== 1b. DoH resolution over raw IP ==")
ctx = ssl.create_default_context()
class NoVerify(ssl.SSLContext): pass
ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
for resolver_ip, name in [("1.1.1.1","maayanlab.cloud"), ("8.8.8.8","maayanlab.cloud"),
                          ("1.1.1.1","pypi.org")]:
    url = f"https://{resolver_ip}/dns-query?name={name}&type=A"
    try:
        req = urllib.request.Request(url, headers={"accept": "application/dns-json",
                                                   "Host": "dns.google" if resolver_ip=="8.8.8.8" else "cloudflare-dns.com"})
        r = urllib.request.urlopen(req, timeout=8, context=ctx)
        body = json.load(r)
        ans = [a["data"] for a in body.get("Answer", [])]
        print(f"DoH {resolver_ip} {name} -> {body.get('Status')} {ans}")
    except Exception as e:
        print(f"DoH {resolver_ip} {name} -> FAIL {type(e).__name__}: {e}")

print("== 1c. proxy/mirror config files ==")
for p in ["/etc/environment", os.path.expanduser("~/.condarc"),
          os.path.expanduser("~/.pip/pip.conf"), "/etc/pip.conf",
          os.path.expanduser("~/.config/pip/pip.conf"), "/etc/resolv.conf"]:
    if os.path.exists(p):
        try:
            print(f"--- {p} ---"); print(open(p).read() or "(empty)")
        except Exception as e: print(p, "unreadable", e)
    else:
        print(f"{p}: absent")
