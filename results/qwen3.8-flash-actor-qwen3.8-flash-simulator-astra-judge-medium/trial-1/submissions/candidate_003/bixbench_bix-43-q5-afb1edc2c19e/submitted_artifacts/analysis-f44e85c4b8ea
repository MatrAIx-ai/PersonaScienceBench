"""
BixBench bix-43-q5 : CBD/cisplatin combination vs Untreated -> Reactome_2022 enrichment.
Approved design:
  - Contrast: group 9 Cisplatin_IC50_CBD_IC50 (9_1..9_3) vs group 1 Untreated (1_1..1_3)
  - DESeq2-style: median-of-ratios size factors, NB2 Wald test (gene-wise MLE dispersion)
  - Filters (literal): raw p<0.05, |log2FC|>0.5, baseMean>10 (baseMean = SF-normalized mean)
  - Query: ONE pooled up+down DEG symbol list; background = mapped expressed symbols (baseMean>10)
  - Enrichment: gseapy.enrich(gene_sets='Reactome_2022') ; fallback rules per researcher.
"""
import json, subprocess, sys, urllib.request
import numpy as np, pandas as pd
from scipy import stats
from scipy.special import gammaln

LOG = []
def log(*a):
    s = " ".join(str(x) for x in a); print(s); LOG.append(s)

# ---------- 1. load ----------
cnt = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
lay = pd.read_csv("data/sample_layout.csv")
mp  = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")
lay["col"] = lay.SampleID.str.replace("-", "_", regex=False)
g_of = dict(zip(lay.col, lay.Group))
assert set(g_of) == set(cnt.columns), "layout/counts sample mismatch"
group9 = [c for c in cnt.columns if g_of[c] == "Cisplatin_IC50_CBD_IC50"]
group1 = [c for c in cnt.columns if g_of[c] == "Untreated"]
group3 = [c for c in cnt.columns if g_of[c] == "DMSO"]
log("contrast:", group9, "vs", group1, "| secondary vs DMSO:", group3)

# ---------- 2. symbol collapse (sum per symbol) ----------
sym_map = dict(zip(mp.ENSG, mp.gene_name))
syms = cnt.index.to_series().map(sym_map)
log("ENSG unmapped to symbol:", int(syms.isna().sum()))
mapped = syms.notna().values
cnt_s = cnt[mapped].groupby(syms[mapped]).sum()
n_ensg_per_sym = syms.dropna().value_counts()
log("symbols after collapse:", cnt_s.shape[0])

# ---------- 3. size factors (median-of-ratios) ----------
X = cnt_s.values.astype(float)
ok = np.all(X > 0, axis=1)
logref = np.log(X[ok]).mean(axis=1)
sf = np.exp(np.median(np.log(X[ok]) - logref[:, None], axis=0))
log("size factors:", np.round(sf, 3))
baseMean = (X / sf).mean(axis=1)

# ---------- 4. NB2 Wald DE (vectorized IRLS + dispersion grid-MLE) ----------
def nb_de(cols_case, cols_ctrl):
    keep = baseMean > 10
    cols = list(cnt_s.columns)
    sel = np.array([c in (list(cols_case) + list(cols_ctrl)) for c in cols])
    y = X[np.ix_(keep, sel)]
    o = np.log(sf)[None, sel]
    x = np.array([c in list(cols_case) for c in np.array(cols)[sel]]).astype(float)
    Xd = np.stack([np.ones(len(x)), x], axis=1)
    B = np.linalg.lstsq(Xd, np.log(np.maximum(y, 1)).T, rcond=None)[0].T
    alpha = np.full(B.shape[0], 0.5)
    grid = np.array([1e-4, 1e-3, 3e-3, 1e-2, 3e-2, 0.1, 0.3, 1.0, 3.0, 10.0, 100.0])
    for _ in range(5):
        eta = np.clip(B[:, 0][:, None] + B[:, 1][:, None] * x + o, -30, 30)
        mu = np.maximum(np.exp(eta), 1e-10)
        w = mu / (1 + alpha[:, None] * mu)
        z = eta + (y - mu) / mu
        S11 = w.sum(1); S12 = (w * x).sum(1); S22 = (w * x * x).sum(1)
        zo = z - o
        T1 = (w * zo).sum(1); T2 = (w * zo * x).sum(1)
        det = np.where(np.abs(S11 * S22 - S12 ** 2) < 1e-12, 1e-12, S11 * S22 - S12 ** 2)
        B = np.stack([(S22 * T1 - S12 * T2) / det, (S11 * T2 - S12 * T1) / det], axis=1)
        eta = np.clip(B[:, 0][:, None] + B[:, 1][:, None] * x + o, -30, 30)
        mu = np.maximum(np.exp(eta), 1e-10)
        k = 1.0 / grid[:, None, None]
        ll = (gammaln(y[None] + k) - gammaln(y[None] + 1) - gammaln(k)
              + k * np.log(k / (k + mu[None])) + y[None] * np.log(mu[None] / (k + mu[None]))).sum(2)
        alpha = np.clip(grid[ll.argmax(0)], 1e-6, 200)
    eta = np.clip(B[:, 0][:, None] + B[:, 1][:, None] * x + o, -30, 30)
    mu = np.maximum(np.exp(eta), 1e-10)
    w = mu / (1 + alpha[:, None] * mu)
    S11 = w.sum(1); S12 = (w * x).sum(1); S22 = (w * x * x).sum(1)
    det = np.where(np.abs(S11 * S22 - S12 ** 2) < 1e-12, 1e-12, S11 * S22 - S12 ** 2)
    se = np.sqrt(S11 / det)
    p = 2 * stats.norm.sf(np.abs(B[:, 1] / np.maximum(se, 1e-12)))
    return B[:, 1] / np.log(2), p, alpha, keep

lfc, pval, disp, keep = nb_de(group9, group1)
from statsmodels.stats.multitest import multipletests
padj = multipletests(pval, method="fdr_bh")[1]
res = pd.DataFrame({"symbol": cnt_s.index[keep], "baseMean": baseMean[keep],
                    "log2FC": lfc, "p": pval, "padj": padj, "dispersion": disp})
deg = res[(res.p < 0.05) & (res.log2FC.abs() > 0.5)].sort_values("p").copy()
deg["direction"] = np.where(deg.log2FC > 0, "up", "down")
log(f"tested genes baseMean>10: {int(keep.sum())} of {len(baseMean)}")
log(f"DEGs: {len(deg)} up={(deg.direction=='up').sum()} down={(deg.direction=='down').sum()}")

deg["n_ensg_per_symbol"] = deg.symbol.map(n_ensg_per_sym)
n_coll = int((deg.n_ensg_per_symbol > 1).sum())
log(f"DEG symbols from multi-ENSG collisions: {n_coll} ({100*n_coll/max(len(deg),1):.1f}%)")
log("top collision classes among DEGs:",
    deg.loc[deg.n_ensg_per_symbol > 1, "symbol"].value_counts().head(8).to_dict())

lfc3, p3, _, _ = nb_de(group9, group3)
deg3 = int(((p3 < 0.05) & (np.abs(lfc3 / np.log(2)) > 0.5)).sum())
log(f"SECONDARY side note: DEGs group9 vs DMSO(group3), same thresholds: {deg3}")

res.sort_values("p").to_csv("output/de_all_genes_9v1.csv", index=False)
deg.to_csv("output/deg_9v1_untreated.csv", index=False)
bg = pd.Series(res.symbol.values)
log("background (mapped, expressed symbols) size:", len(bg))

# ---------- 5. enrichment ----------
ENRICH_CALL = (
"# PRIMARY (preferred) path — requires network to Enrichr:\n"
"import gseapy, pandas as pd\n"
"deg = pd.read_csv('output/deg_9v1_untreated.csv')\n"
"bg  = pd.read_csv('output/de_all_genes_9v1.csv').symbol\n"
"enr = gseapy.enrich(gene_list=list(deg.symbol), gene_sets='Reactome_2022',\n"
"                    organism='human', background=list(bg))\n"
"enr.results.sort_values(['Adjusted P-value','P-value'])\n")
mode, enr_table = None, None
try:
    subprocess.run([sys.executable, "-m", "pip", "install", "gseapy"],
                   check=True, capture_output=True, timeout=120)
    urllib.request.urlopen("https://maayanlab.cloud/Enrichr/datasetStatistics", timeout=15)
    import gseapy
    enr = gseapy.enrich(gene_list=list(deg.symbol), gene_sets="Reactome_2022",
                        organism="human", background=list(bg))
    enr_table = enr.results.sort_values(["Adjusted P-value", "P-value"]).copy()
    enr_table.to_csv("output/enrichment_Reactome2022.csv", index=False)
    mode = "primary (gseapy/Enrichr)"
except Exception as e:
    mode = "NONE-RUN"
    log(f"ENRICHMENT COULD NOT RUN: {type(e).__name__}: {str(e)[:200]}")
    open("output/gseapy_call.txt", "w").write(ENRICH_CALL)

import os
src = []
for root in ["/opt", "/usr/share", "/workspace", os.path.expanduser("~")]:
    for dp, dn, fn in os.walk(root):
        if dp.count(os.sep) - root.count(os.sep) > 3: dn[:] = []
        src += [os.path.join(dp, f) for f in fn if "eactome" in f or f.endswith(".gmt")]
log("local Reactome_2022 sources on disk:", src[:5])

with open("output/summary.json", "w") as f:
    json.dump({"mode": mode, "n_tested": int(keep.sum()), "n_deg": int(len(deg)),
               "up": int((deg.direction == "up").sum()), "down": int((deg.direction == "down").sum()),
               "deg_from_collisions": n_coll, "secondary_deg_vs_DMSO": deg3,
               "background": int(len(bg))}, f, indent=2)
open("output/run_log.txt", "w").write("\n".join(LOG))
if enr_table is not None:
    print(enr_table.head(10).to_string())
else:
    print("Enrichment not produced; see output/gseapy_call.txt and output/summary.json")
