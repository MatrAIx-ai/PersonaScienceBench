# PRIMARY (preferred) path — requires network to Enrichr:
import gseapy, pandas as pd
deg = pd.read_csv('output/deg_9v1_untreated.csv')
bg  = pd.read_csv('output/de_all_genes_9v1.csv').symbol
enr = gseapy.enrich(gene_list=list(deg.symbol), gene_sets='Reactome_2022',
                    organism='human', background=list(bg))
enr.results.sort_values(['Adjusted P-value','P-value'])
