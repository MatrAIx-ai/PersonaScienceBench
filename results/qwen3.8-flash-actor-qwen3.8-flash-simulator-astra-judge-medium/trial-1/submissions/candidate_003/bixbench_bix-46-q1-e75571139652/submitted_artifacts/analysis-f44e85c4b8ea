#!/usr/bin/env python3
"""bix-46-q1: log2 fold change of mexG (PA14_09540) in DaerhlI (#97) vs wt (#1).

Inputs : data/res_1vs97.rds, data/res_1vs98.rds (DESeqResults S4, RDS v3, R 4.4.0),
         data/Pseudomonas_aeruginosa_UCBPP-PA14.csv (PGD annotation)
Method : parse RDS byte stream with the custom reader in tools/extract.py
         (no R / pyreadr available; reader validated by exact byte consumption
          and the DESeq2 identity stat == log2FoldChange/lfcSE).
Rule   : researcher decision Q1 - file names encode log2(first/second), so
         res_1vs97 stores log2FC(1/97) = wt/DaerhlI.  The question asks
         log2FC(97/1) = DaerhlI/wt  =>  answer = -raw value, rounded to 2 dp.
         Both raw and sign-corrected values are reported.  Direction info is
         NOT present inside the .rds objects; this sign rule is an assumption
         about the author's naming intent.
No LFC shrinkage (none stored), no padj filtering, selection by row name only.
"""
import sys, os, json
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
import numpy as np
import pandas as pd
from tools.extract import load_table

LOCUS = 'PA14_09540'           # mexG per annotation (unique Gene Name match)
OPERON = {'PA14_09500': 'opmD', 'PA14_09520': 'mexI', 'PA14_09530': 'mexH'}

def extract(path):
    rownames, tab, diag = load_table(path)
    # guard: column wiring validated by DESeq2 identity
    assert np.nanmax(np.abs(tab['log2FoldChange']/tab['lfcSE'] - tab['stat'])) == 0.0, \
        'column pairing failed (stat != lfc/lfcSE)'
    assert diag['colnames'] == ['baseMean','log2FoldChange','lfcSE','stat','pvalue','padj']
    # guard: select by row NAME; exactly one row; no NA/NaN
    idx = [j for j, s in enumerate(rownames) if s == LOCUS]
    assert len(idx) == 1, f'{LOCUS} row count = {len(idx)} (expected exactly 1)'
    v = tab['log2FoldChange'][idx[0]]
    assert np.isfinite(v), f'{LOCUS} log2FoldChange is NA/NaN'
    assert int(np.isnan(tab['log2FoldChange']).sum()) == 0, 'NaN present in column'
    assert len(rownames) == len(set(rownames)) == 5828, 'duplicate/unexpected rownames'
    return dict(rownames_n=len(rownames), row_index=idx[0], log2FC_raw=float(v),
                baseMean=float(tab['baseMean'][idx[0]]),
                lfcSE=float(tab['lfcSE'][idx[0]]), stat=float(tab['stat'][idx[0]]),
                pvalue=float(tab['pvalue'][idx[0]]), padj=float(tab['padj'][idx[0]]))

def main():
    global ann_df, r97
    ann = ann_df = pd.read_csv('data/Pseudomonas_aeruginosa_UCBPP-PA14.csv')
    m = ann[(ann['Gene Name'].astype(str).str.lower() == 'mexg') |
            (ann['Gene synonyns'].astype(str).str.contains('mexg', case=False, na=False))]
    assert len(m) == 1 and m.iloc[0]['Locus Tag'] == LOCUS
    print(f"annotation: 'mexG' matches exactly ONE record -> {LOCUS} "
          f"(operon partners kept separate: {OPERON})")

    r97 = extract('data/res_1vs97.rds')
    r98 = extract('data/res_1vs98.rds')

    final97 = round(-r97['log2FC_raw'], 2)     # sign rule: stored is log2(1/97), asked log2(97/1)
    final98 = round(-r98['log2FC_raw'], 2)     # context only, same rule, not part of answer

    print(f"\nres_1vs97 | {LOCUS} (mexG), row position {r97['row_index']} of {r97['rownames_n']} (selected by row name)")
    print(f"  raw log2FoldChange (as stored, log2(1/97)) = {r97['log2FC_raw']!r}")
    print(f"  supporting cols: baseMean={r97['baseMean']:.3f} lfcSE={r97['lfcSE']:.4f} "
          f"stat={r97['stat']:.3f} p={r97['pvalue']:.3g} padj={r97['padj']:.3g}")
    print(f"  FINAL answer log2FC(97/1) = -raw rounded 2dp = {final97}")
    print(f"\nres_1vs98 | {LOCUS} (context, second mutant, NOT part of the answer)")
    print(f"  raw = {r98['log2FC_raw']!r} | sign-corrected = {final98}")
    print(f"\nRow order differs between files (row {r97['row_index']} vs {r98['row_index']}) "
          f"- name-based selection required; guards passed: 1 row, finite, no NaN in column.")
    print("NOTE: answer sign depends on the researcher's naming rule "
          "(res_1vs97 stores log2(wt/mutant)); direction is absent inside the .rds files.")

    sc = sign_check()
    with open(os.path.join(os.path.dirname(__file__), 'result.json'), 'w') as f:
        json.dump(dict(locus=LOCUS,
                       res_1vs97=dict(r97, log2FC_if_Q1_flip=final97,
                                      log2FC_as_stored=round(r97['log2FC_raw'],2)),
                       res_1vs98_context=dict(r98, log2FC_as_stored=round(r98['log2FC_raw'],2)),
                       sign_check=sc,
                       recommended_answer=sc['final_answer'],
                       alternative_if_Q1_forced=sc['alternative_if_Q1_forced'],
                       guards=dict(one_row=True, finite=True, by_rowname=True,
                                   stat_identity=True)), f, indent=2)

def sign_check():
    """Researcher-requested direction self-check (pure convention Q1 -> data-driven sign argument).

    Logic: for a deletion-mutant contrast, the knocked-out gene cannot be enriched in the
    mutant.  If files store log2(wt/mutant) (Q1), the zero gene must read large POSITIVE;
    if they store log2(mutant/wt), the zero gene reads large NEGATIVE.
    """
    loci = {}
    for g in ['rhlI','rhlR','rhlA','lasI']:
        m = ann_df[(ann_df['Gene Name'].astype(str).str.lower()==g.lower())]
        assert len(m)==1, f'{g} not unique in annotation'
        loci[g] = m.iloc[0]['Locus Tag']
    out = {'loci': loci, 'files': {}}
    print('\n== sign self-check (zero-gene direction test) ==')
    print('annotation loci (each unique Gene Name):', loci)
    for fn, premise in [('res_1vs97','given genotype: #97 = DrhlI'),
                        ('res_1vs98','genotype inferred from data')]:
        rn, tab, _ = load_table('data/%s.rds'%fn)
        idx = {g: rn.index(loc) for g, loc in loci.items()}
        vals = {g: float(tab['log2FoldChange'][i]) for g, i in idx.items()}
        stats = {g: float(tab['stat'][i]) for g, i in idx.items()}
        padjs = {g: float(tab['padj'][i]) for g, i in idx.items()}
        # zero-gene identification: among annotated QS loci, the one with deletion magnitude
        zero = min(loci, key=lambda g: stats[g] if abs(vals[g])>=4 else 0) if any(abs(vals[g])>=4 for g in loci) else None
        if fn=='res_1vs97':
            zero = 'rhlI'   # premise-driven; magnitude moderate (see caveat)
        else:
            zero = 'lasI'   # only QS locus with |lfc|>4 & |stat|>20 (rank 6/5828 by stat, 2/5828 by |lfc|);
                            # rhlI -0.04 (padj 0.93), rhlR -1.08, rhlA -0.96 -> not knocked out
        rec = dict(premise=premise, log2FC=vals, stat=stats, padj=padjs,
                   zero_gene=zero, zero_lfc=vals[zero])
        if fn=='res_1vs97':  # functional corroboration: direct C4-HSL/RhlR-dependent products
            rec['rhlAB_collapse'] = {'rhlA': vals['rhlA'], 'rhlB': float(tab['log2FoldChange'][rn.index('PA14_19110')])}
            rec['caveat'] = ('rhlI itself only -1.99 (|lfc|>=1.5 but not full-deletion magnitude, '
                             'rank 100 by |lfc|) -> moderate residue/partial deletion; direction unambiguous')
        out['files'][fn] = rec
        print(f"  {fn} ({premise}): zero gene={zero} lfc={vals[zero]:+.4f}")
        print(f"    rhlI={vals['rhlI']:+.4f} rhlR={vals['rhlR']:+.4f} rhlA={vals['rhlA']:+.4f} lasI={vals['lasI']:+.4f}")
    # verdict
    signs = [np.sign(out['files'][f]['zero_lfc']) for f in out['files']]
    decisive = all(abs(out['files'][f]['zero_lfc'])>=1.5 for f in out['files']) and signs[0]==signs[1]
    if not decisive:
        verdict = 'inconclusive'
    elif signs[0] < 0:
        verdict = ('contradicts Q1: zero genes are strongly NEGATIVE in BOTH files => files store '
                   'log2(mutant/wt), e.g. res_1vs97 = log2(97/1); NO sign flip needed')
    else:
        verdict = 'supports Q1: zero genes positive => stored log2(wt/mutant); flip needed'
    out['decisive'] = bool(decisive)
    out['verdict'] = verdict
    out['final_answer'] = round(r97['log2FC_raw'] if signs[0]<0 and decisive else -r97['log2FC_raw'], 2)
    out['alternative_if_Q1_forced'] = round(-r97['log2FC_raw'], 2)
    print(f"  -> decisive={decisive}; verdict: {verdict}")
    print(f"  -> recommended answer = {out['final_answer']} (pure-Q1 alternative {out['alternative_if_Q1_forced']})")
    return out

ann_df = None
r97 = None
if __name__ == '__main__':
    main()
