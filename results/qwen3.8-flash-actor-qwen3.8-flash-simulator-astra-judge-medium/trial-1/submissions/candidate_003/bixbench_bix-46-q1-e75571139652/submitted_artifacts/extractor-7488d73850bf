"""Robust extractor for these DESeqResults .rds files (uses tools.rds4 full parse
   + positional validation). Exposes: rownames, column names, 6 column vectors."""
import gzip, struct
import numpy as np

def find_rownames_and_columns(raw):
    """Scan RDS payload positionally:
       - rownames: first flag 0x00000010 (STRSXP) whose n>=1000 items parse as PA14_* strings
       - REAL columns: every flag 0x0000000e followed by n == len(rownames)
       - column names: STRSXP(n=6) appearing immediately after flag 0x000008ff (names attr)
       Returns dict."""
    i = 0
    n = len(raw)
    def u32(o): return struct.unpack_from('>I', raw, o)[0]
    def i32(o): return struct.unpack_from('>i', raw, o)[0]

    # --- rownames ---
    rownames = None; ro_off = None
    pos = 0
    while pos + 8 <= n:
        f = u32(pos)
        if f == 0x00000010:
            cnt = i32(pos+4)
            if cnt and 100 < cnt < 100000:
                # try to parse cnt strings of form flag0x00040009 + len + bytes
                ok = True; p = pos+8; out = []
                for _ in range(cnt):
                    if u32(p) != 0x00040009: ok = False; break
                    L = i32(p+4)
                    if not (0 < L < 100): ok = False; break
                    out.append(raw[p+8:p+8+L].decode()); p += 8+L
                if ok and all(s.startswith('PA14_') for s in out[:20]):
                    rownames = out; ro_off = pos; pos = p; continue
        pos += 4
    assert rownames is not None, 'rownames not found'

    # --- REAL columns (byte-granular; payload may be unaligned) ---
    cols = []
    marker = (0x0000000e).to_bytes(4,'big') + len(rownames).to_bytes(4,'big',signed=True)
    cpos = raw.find(marker)
    while cpos != -1:
        arr = np.frombuffer(raw, dtype='>f8', count=len(rownames), offset=cpos+8)
        cols.append((cpos, arr))
        cpos = raw.find(marker, cpos + 8 + 8*len(rownames))
    # --- column names attr (flag 0x000008ff -> STRSXP n=6) ---
    colnames = None
    EXPECT = {'baseMean','log2FoldChange','lfcSE','stat','pvalue','padj'}
    k = raw.find(b'\x00\x00\x08\xff')
    while k != -1:
        p = k+4
        if u32(p) == 0x00000010 and i32(p+4) == 6:
            ok=True; out=[]; q=p+8
            for _ in range(6):
                if u32(q)!=0x00040009: ok=False; break
                L=i32(q+4); out.append(raw[q+8:q+8+L].decode()); q+=8+L
            if ok and set(out)==EXPECT: colnames=out; break
        k = raw.find(b'\x00\x00\x08\xff', k+4)
    assert colnames is not None, 'column names attr not found'
    return dict(rownames=rownames, real_offsets=[c[0] for c in cols],
                columns=[c[1] for c in cols], colnames=colnames)

def load_table(path):
    raw = gzip.decompress(open(path,'rb').read())
    d = find_rownames_and_columns(raw)
    tab = {name: arr for name, arr in zip(d['colnames'], d['columns'])}
    return d['rownames'], tab, d
