"""RDS (RDSBinary.c) parser, rules deduced empirically:

flag semantics (BE int):
  t = f & 0xFF
  t==254 (0xfe): NIL / end-of-pairlist marker
  t==255 (0xff): reference to previously written SYM/CHARSXP, index=(f>>8)&0x3FF
  t==1  SYMSXP : next item is CHARSXP with the name
  t==9  CHARSXP: int len + bytes (flag often 0x00040009; bit18=encoding)
  t==10/11/13 INT/LGL: int n + n int32
  t==14 REAL  : int n + n doubles
  t==16 STRSXP: int n + n items
  t==19 VECSXP: int n + n items
  t==2  LISTSXP cell (0x402=with tag): [tag item][car item] ... until 0xfe
  t==25 S4    : pairlist of slots (same cell format)
flag bit 0x100/0x200 after payload: attribute pairlist (order TBD empirically)
"""
import gzip, struct

class Node:
    __slots__=('kind','val','attrs','tag')
    def __init__(s,k,v,a=None): s.kind=k; s.val=v; s.attrs=a or []
    def adict(s): return {t:v for t,v in s.attrs}
    def __repr__(s):
        if s.kind in ('CHAR','SYM'): return repr(s.val)
        if s.kind=='REAL': return f'REAL[{len(s.val)}]'
        if s.kind=='STR': return f'STR{tuple(str(x)[:12] for x in s.val[:4])}({len(s.val)})'
        if s.kind=='LIST': return f'LIST[{len(s.val)}]'
        if s.kind=='S4': return f'S4({ {t:str(v)[:30] for t,v in s.val} })'
        return f'{s.kind}[{str(s.val)[:60]}]'

class Parse(Exception): pass

class R:
    def __init__(s,buf,trace=0):
        s.b=buf; s.i=0; s.trace=trace; s.symtab=[]  # ordered unique SYM strings
    def u32(s):
        v=struct.unpack_from('>I',s.b,s.i)[0]; s.i+=4; return v
    def i32(s):
        v=struct.unpack_from('>i',s.b,s.i)[0]; s.i+=4; return v
    def take(s,n):
        v=s.b[s.i:s.i+n]; s.i+=n; return v
    def hdr(s):
        m=s.take(2); assert m==b'X\n',m
        fmt=s.u32(); wr=s.u32(); mn=s.u32(); enc=None
        if struct.unpack_from('>i',s.b,s.i)[0]==5 and s.b[s.i+4:s.i+9]==b'UTF-8':
            s.i+=4; enc=s.take(5).decode()
        return fmt,wr,mn,enc
    def cstr(s):   # CHARSXP payload: len+bytes
        n=s.i32()
        if n<0:
            n=-n
            if n==1: s.take(1); return ''
            s.take(1); return s.take(n-1).decode('utf-8','replace')
        return s.take(n).decode('utf-8','replace')
    def symref(s,f):
        idx=(f>>8)&0x3FF
        if idx>=len(s.symtab): raise Parse('symref %d > symtab %s'%(idx,s.symtab))
        return Node('SYM',s.symtab[idx])
    def item(s,d=0):
        off=s.i; f=s.u32()
        if s.trace: print('%6d %s f=%08x'%(off,'  '*d,f))
        t=f&0xFF
        if t==254: return Node('NIL',None)
        if t==255: return s.symref(f)
        if t==1:                      # SYMSXP: charsxp follows
            cf=s.u32()
            if (cf&0xFF)!=9: raise Parse('SYM without CHARSXP at %d flag %08x'%(s.i-4,cf))
            name=s.cstr()
            if name not in s.symtab: s.symtab.append(name)
            return Node('SYM',name)
        if t==9:  return Node('CHAR',s.cstr())
        if t in (10,11,13):
            n=s.i32(); return Node('INT',[s.i32() for _ in range(n)])
        if t==14:
            n=s.i32(); v=list(struct.unpack_from('>%dd'%n,s.b,s.i)); s.i+=8*n
            node=Node('REAL',v)
        elif t==16:
            n=s.i32(); node=Node('STR',[s.item(d+1) for _ in range(n)])
        elif t==19:
            n=s.i32(); node=Node('LIST',[s.item(d+1) for _ in range(n)])
        elif t==2:
            node=Node('PAIR',s.pairlist(d+1))
        elif t==25:
            node=Node('S4',s.pairlist(d+1))
        elif t==24:
            n=s.i32(); node=Node('RAW',s.take(n))
        else:
            raise Parse('type %d flag %08x at %d'%(t,f,s.i-4))
        if f&0x300:
            node.attrs=s.pairlist(d+1)
        return node
    def pairlist(s,d=0):
        out=[]
        while True:
            if s.i>=len(s.b): break              # EOF guard
            off=s.i; f=s.u32()
            if s.trace: print('%6d %s cell f=%08x'%(off,'  '*d,f))
            if f==0: break                       # plain NIL end
            if (f&0xFF)==254: break              # 0xfe end
            if f&0x400:                          # tagged cell: tag item then car item
                tag=s.item(d+2)
                tag=tag.val if hasattr(tag,'val') else tag
            else:
                tag=None
                s.i-=4
            car=s.item(d+2)
            out.append((tag,car))
        return out

def load(path,trace=0):
    r=R(gzip.decompress(open(path,'rb').read()),trace)
    h=r.hdr(); o=r.item()
    return r,o,h
