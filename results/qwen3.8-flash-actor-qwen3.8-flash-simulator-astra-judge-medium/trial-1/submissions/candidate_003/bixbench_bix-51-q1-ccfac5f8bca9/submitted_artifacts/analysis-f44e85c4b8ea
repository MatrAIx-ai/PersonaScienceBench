"""
BixBench bix-51-q1
Question: Using a logistic regression model and age as the only predictor, what is the
predicted probability of achieving efficacy PR with treatment in patients aged 65?

Fixed (agreed) design:
  * clean: drop trailing blank rows (no Efficacy / Sequence number) -> N = 80
  * Age -> pd.to_numeric(errors='coerce') (" " -> NaN); Efficacy .str.strip().str.upper()
  * target y = 1 if Efficacy == 'PR' else 0   (SD and PD pooled = "no response")
  * single predictor = RAW Age (no scaling), intercept required, formula: PR ~ Age
  * primary estimate: statsmodels Logit, MLE (Newton/IRLS), NO regularization
  * Groups is NOT a filter and NOT a predictor ("with treatment" = descriptive wording)
  * sensitivity only: L2 C=1 (sklearn-equivalent objective via scipy.optimize),
    subgroup Age>=65 sanity check, degenerate Groups=1 / Groups=2 fits
Out of scope by design: splines, AUC/ROC, cross-validation, adjustment for ECOG-PS / Child-Pugh.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy.optimize import minimize

pd.set_option("display.width", 160)
AGE_AT_RISK = 65.0

# ----------------------------------------------------------------------------- 1. load & clean
raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print("=" * 78)
print("1. LOAD & CLEAN")
print("=" * 78)
print(f"raw shape                     : {raw.shape}")
blank = raw["Efficacy"].isna() & raw["Sequence number"].isna()
print(f"trailing blank rows dropped   : {int(blank.sum())}")

df = raw[~blank].copy()
df["Efficacy"] = df["Efficacy"].str.strip().str.upper()          # scaffolding guard
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")            # " " -> NaN
df["y"] = (df["Efficacy"] == "PR").astype(int)                   # PR = 1, SD/PD = 0
df = df.dropna(subset=["Age", "Efficacy"]).reset_index(drop=True)

print(f"analytic N                    : {len(df)}")
print(f"Efficacy categories           : {df['Efficacy'].value_counts().to_dict()}")
print(f"target y (PR) rate            : {df['y'].mean():.4f}  ({df['y'].sum()}/{len(df)})")
print(f"Age (raw, numeric)            : min {df.Age.min():.0f}, max {df.Age.max():.0f}, "
      f"mean {df.Age.mean():.2f}, sd {df.Age.std():.2f}")
print(f"Age missing after coercion    : {int(df.Age.isna().sum())}")
print(f"Groups coding (NOT used)      : {df['Groups'].value_counts().to_dict()}")
print("\ncrosstab Groups x Efficacy (documented separation, not used in the model):")
print(pd.crosstab(df["Groups"], df["Efficacy"]))

# ------------------------------------------------------------------- 2. primary logistic model
print("\n" + "=" * 78)
print("2. PRIMARY MODEL - statsmodels Logit, MLE (Newton/IRLS), no penalty:  PR ~ Age")
print("=" * 78)
res = smf.logit("y ~ Age", data=df).fit(disp=0, method="newton", maxiter=200)
print(res.summary())
b0, b1 = res.params["Intercept"], res.params["Age"]
p1 = res.pvalues["Age"]
ci_b1 = res.conf_int().loc["Age"]
print(f"b0 (Intercept) = {b0:.6f}")
print(f"b1 (Age)       = {b1:.6f}   log-odds per year, 95% CI [{ci_b1.iloc[0]:.6f}, {ci_b1.iloc[1]:.6f}]")
print(f"p-value (b1)   = {p1:.6g}   |  OR per year = {np.exp(b1):.4f}")
print(f"converged      = {res.mle_retvals['converged']} | iterations = {res.mle_retvals['iterations']} "
      f"| llf = {res.llf:.4f} | pseudo-R2 = {res.prsquared:.4f} | N = {int(res.nobs)}")

# ------------------------------------------------------- 3. ANSWER: predicted probability at 65
print("\n" + "=" * 78)
print(f"3. ANSWER - predicted probability of PR at Age = {AGE_AT_RISK:.0f}")
print("=" * 78)
X65 = sm.add_constant(pd.DataFrame({"Age": [AGE_AT_RISK]}), has_constant="add")
pred = res.get_prediction(X65)                      # delta-method CI on the mean response
pf = pred.summary_frame(alpha=0.05)          # statsmodels >=0.14 names: predicted/ci_lower/ci_upper
def _col(frame, *names):
    for n in names:
        if n in frame.columns:
            return float(frame[n].iloc[0])
    raise KeyError(list(frame.columns))
p65 = _col(pf, "mean", "predicted")
lo, hi = _col(pf, "mean_ci_lower", "ci_lower"), _col(pf, "mean_ci_upper", "ci_upper")
manual = 1.0 / (1.0 + np.exp(-(b0 + b1 * AGE_AT_RISK)))
print(f"logit(65)      = b0 + b1*65 = {b0 + b1 * AGE_AT_RISK:.6f}")
print(f"p(65) by hand  = 1/(1+exp(-logit)) = {manual:.6f}")
print(f"p(65) predict  = {p65:.6f}   (raw)")
print(f"p(65) 95% CI   = [{lo:.6f}, {hi:.6f}]  (delta method)")
print(f"odds(65)       = {p65 / (1 - p65):.6f}")
print(f"\n>>> FINAL ANSWER: predicted probability of PR at age 65 = {round(p65, 3)} "
      f"(raw {p65:.6f}; 95% CI {lo:.3f}-{hi:.3f}; b0={b0:.4f}, b1={b1:.4f}, p={p1:.4g})")

# ---------------------------------------------------------- 4a. sensitivity: L2 penalty C = 1
print("\n" + "=" * 78)
print("4a. SENSITIVITY - L2 penalty, sklearn-equivalent objective (C=1), scipy.optimize")
print("=" * 78)
X = np.column_stack([np.ones(len(df)), df["Age"].to_numpy()])
yv = df["y"].to_numpy(float)
C = 1.0   # sklearn: minimize  C * sum(-loglik) + 0.5 * ||w||^2   (intercept penalized as well)

def obj(w, C=C):
    z = X @ w
    ll = np.sum(yv * z - np.logaddexp(0.0, z))          # log-likelihood
    return -C * ll + 0.5 * np.dot(w, w)

def grad(w, C=C):
    z = X @ w
    p = 1.0 / (1.0 + np.exp(-z))
    return -C * (X.T @ (yv - p)) + w

w = minimize(obj, np.zeros(2), jac=grad, method="L-BFGS-B").x
p65_l2 = 1.0 / (1.0 + np.exp(-(w[0] + w[1] * AGE_AT_RISK)))
print(f"L2(C=1): b0 = {w[0]:.6f}, b1 = {w[1]:.6f} -> p(65) = {p65_l2:.6f}")
print(f"shift vs unpenalized MLE: {p65_l2 - p65:+.6f} ({(p65_l2 - p65) / p65 * 100:+.2f} %)")

# ------------------------------------------- 4b. sanity check: same model on subgroup Age >= 65
print("\n" + "=" * 78)
print("4b. SENSITIVITY - same specification refit on subgroup Age >= 65 (sanity check)")
print("=" * 78)
sub = df[df["Age"] >= 65]
res_s = smf.logit("y ~ Age", data=sub).fit(disp=0)
pred_s = res_s.get_prediction(sm.add_constant(pd.DataFrame({"Age": [AGE_AT_RISK]}), has_constant="add"))
psf = pred_s.summary_frame(alpha=0.05)
ps = _col(psf, "mean", "predicted")
plo, phi = _col(psf, "mean_ci_lower", "ci_lower"), _col(psf, "mean_ci_upper", "ci_upper")
print(f"subgroup N = {len(sub)}, PR rate = {sub['y'].mean():.4f}")
print(f"b0 = {res_s.params['Intercept']:.4f}, b1 = {res_s.params['Age']:.4f}, "
      f"p(b1) = {res_s.pvalues['Age']:.4g}")
print(f"p(65 | Age>=65) = {ps:.6f}  95% CI [{plo:.3f}, {phi:.3f}]  -> rounded {round(ps, 3)}")

# --------------------------- 4c. what a literal "treatment" filter by Groups would give (degenerate)
print("\n" + "=" * 78)
print("4c. SENSITIVITY - literal 'treatment' filter by Groups (DEGENERATE, kept for transparency)")
print("=" * 78)
for g in (1.0, 2.0):
    try:  # one-line fit; y is constant within a group -> complete separation -> no finite MLE
        rg = smf.logit("y ~ Age", data=df[df["Groups"] == g]).fit(disp=0, maxiter=200)
        pg = float(1.0 / (1.0 + np.exp(-(rg.params["Intercept"] + rg.params["Age"] * AGE_AT_RISK))))
        print(f"Groups={g:g}: N={int(rg.nobs)}, PR={int(df[df.Groups == g]['y'].sum())}, "
              f"fitted p(65)={pg:.4f} (converged={rg.mle_retvals['converged']}) "
              f"DEGENERATE: y constant -> complete separation, coefficients diverge, "
              f"limiting p = {df[df.Groups == g]['y'].mean():.0f} for every age")
    except Exception as e:
        print(f"Groups={g:g}: fit failed -> {type(e).__name__}: {e} "
              f"| y is constant (all {'PR' if df[df.Groups == g]['y'].mean() == 1 else 'non-PR'}), "
              f"limiting p = {df[df.Groups == g]['y'].mean():.0f} for every age (DEGENERATE)")

# ------------------------------------------------------------------------- 5. caveats for report
print("\n" + "=" * 78)
print("5. CAVEATS")
print("=" * 78)
print("""* Groups and Efficacy are perfectly separated in the data (Group 1: 41/41 PR; Group 2: 0/39 PR,
  22 PD + 17 SD). Groups carries no textual label, so "which group is the treatment arm" is an
  ASSUMPTION, not a fact from the file. The model therefore does NOT filter on Groups and does not
  include it (per protocol: age is the only predictor).
* Consequence: the marginal age slope is confounded with / mixed up with the treatment-group effect
  (Group 1 mean age 54.9 vs Group 2 62.4). p(65) is a cohort-level PREDICTION, not a causal or
  treatment-specific effect of age.
* A literal single-group ("treatment arm") filter makes y constant -> complete separation -> the
  fitted probability degenerates to 1 (Groups=1) or 0 (Groups=2) at every age; such estimates are
  statistically uninformative, hence excluded from the answer (see 4c).
* Target is binarized by convention: PR = response, SD + PD = no response.
* Primary estimate is unpenalized MLE (canonical logistic regression). The sklearn default L2 (C=1)
  shrinks the coefficients and shifts p(65) slightly - reported as sensitivity only, not the answer.
* 41 trailing blank rows are formatting artifacts, not patients; one whitespace cell in Age -> NaN.
* No scaling of Age (raw years, prediction evaluated at 65), intercept included, no splines, no
  AUC/ROC, no cross-validation, no adjustment for ECOG-PS/Child-Pugh - all outside the fixed scope.""")
