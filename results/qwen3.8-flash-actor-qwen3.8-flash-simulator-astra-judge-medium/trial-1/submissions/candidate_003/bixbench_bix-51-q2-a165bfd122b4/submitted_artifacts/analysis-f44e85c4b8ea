#!/usr/bin/env python3
"""
AIC for the logistic regression using BMI as the SOLE predictor of treatment
response (efficacy PR).

Question (bix-51-q2): "What is the Akaike Information Criterion (AIC) for the
logistic regression model that uses BMI as the sole predictor of treatment
response (efficacy PR)?"

PRIMARY (approved) SPEC:
  * data          : data/data.xlsx, sheet 'Sheet1'
  * outcome       : y = 1 if Efficacy == 'PR' else 0   (SD and PD -> 0)
  * design matrix : [intercept, BMI]  -- BMI raw, untransformed, no other terms
  * rows          : complete cases on Efficacy and BMI  -> n = 80
  * library       : statsmodels GLM, Binomial family (default logit link)
  * AIC           : AIC = -2*logLik + 2k, k = # free parameters INCLUDING the
                    intercept = 2 (intercept + one BMI slope); binomial
                    dispersion is fixed at 1 and contributes nothing to k.

IMPORTANT / KEPT ON RECORD (do not fit):
  'Groups' is PERFECTLY collinear with the outcome in this dataset
  (Group 1 = 41/41 PR ; Group 2 = 22 PD + 17 SD, 0 PR).  Any model containing
  Groups would quasi/perfectly separate and drive the MLE to infinity.  It is
  excluded because the question demands BMI-only AND because it is statistically
  impossible to fit.  No covariate model (Age/Gender/etc.) is fitted either.

Only extra fit: intercept-only null, for context (null logLik / LR p-value).
"""

import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 100)

RULE = "=" * 78

# ---------------------------------------------------------------- load & audit
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")

print(RULE)
print("0. INPUT AUDIT (read-only)")
print(RULE)
print(f"raw shape: {df.shape[0]} rows x {df.shape[1]} cols")
print(f"Efficacy raw unique values : {sorted(df['Efficacy'].dropna().unique().tolist())}")
print(f"Efficacy value_counts      : {df['Efficacy'].value_counts(dropna=False).to_dict()}")
print(f"BMI dtype={df['BMI'].dtype}  min={df['BMI'].min()}  max={df['BMI'].max()}  "
      f"n_missing={df['BMI'].isna().sum()}  non-numeric/sentinel count="
      f"{int(((df['BMI'] <= 0) | (df['BMI'] >= 99)).sum())}")

n_missing_either = int((df["BMI"].isna() | df["Efficacy"].isna()).sum())
d = df[df["Efficacy"].notna() & df["BMI"].notna()].copy()
n = len(d)

# ------------------------------------------------------------------ coding
d["y"] = (d["Efficacy"] == "PR").astype(int)      # PRIMARY CODING (assumption A1)

print("\n" + RULE)
print("1. ANALYSIS SET")
print(RULE)
print(f"rows dropped (missing BMI or Efficacy; the 41 fully-blank padding rows) "
      f"= {n_missing_either}")
print(f"n used for the model                              = {n}")
print(f"outcome y = 1 if Efficacy=='PR' else 0 -> counts  : {d['y'].value_counts().to_dict()}")
print(f"events PR={int((d['y']==1).sum())}  non-events(SD+PD)={int((d['y']==0).sum())}  "
      f"observed PR rate={d['y'].mean():.4f}")
print(f"BMI in analysis set: mean={d['BMI'].mean():.4f} sd={d['BMI'].std():.4f} "
      f"min={d['BMI'].min()} max={d['BMI'].max()}")
print("design matrix columns: ['const'(intercept), 'BMI'] -- no other covariate is used")

# ------------------------------------------------------- PRIMARY MODEL (BMI only)
model = smf.glm(formula="y ~ BMI", data=d, family=sm.families.Binomial())
res = model.fit()          # IRLS

llf = float(res.llf)
k = int(res.df_model) + 1                    # slope(s) + intercept  -> 2
aic_hand = -2.0 * llf + 2.0 * k
aic_sm = float(res.aic)

print("\n" + RULE)
print("2. PRIMARY FIT  --  GLM logit:  y ~ BMI   (y = 1 if Efficacy=='PR' else 0)")
print(RULE)
print(res.summary())

print("\n--- parameter estimates (for downstream checkability) ---")
params, bse, pvals = res.params, res.bse, res.pvalues
print(f"intercept  beta={params['Intercept']:.6f}  se={bse['Intercept']:.6f}  "
      f"p={pvals['Intercept']:.6f}")
print(f"BMI        beta={params['BMI']:.6f}  se={bse['BMI']:.6f}  "
      f"p={pvals['BMI']:.6f}")
print(f"OR per 1 BMI unit = {np.exp(params['BMI']):.6f}")

# --------------------------------------------------------- convergence / sanity
print("\n" + RULE)
print("3. SANITY CHECKS -- is this a real interior MLE?")
print(RULE)
converged = bool(getattr(res, "converged", True))
print(f"IRLS converged flag                 : {converged}")
try:
    print(f"IRLS iterations                     : {int(res.fit_history['iteration'])}")
except Exception:
    print("IRLS iterations                     : (not exposed)")
mu = np.asarray(res.fittedvalues, dtype=float)
X = np.column_stack([np.ones(n), d["BMI"].values])
score_vec = X.T @ (d["y"].values - mu)          # binomial logit score = X'(y-mu)
print(f"score X'(y-mu) at optimum (should be ~0): {np.abs(score_vec).max():.3e}"
      f"  [{score_vec[0]:.3e}, {score_vec[1]:.3e}]")

print(f"fitted probabilities: n={mu.size}  min={mu.min():.6f}  max={mu.max():.6f}")
inside = bool((mu > 0).all() and (mu < 1).all())
print(f"all strictly inside (0,1) [no separation] : {inside}")
if not inside:
    print("*** WARNING: fitted probability at 0/1 -> boundary MLE, AIC unreliable ***")

print("\n--- predicted vs observed PR rate ---")
q = pd.qcut(d["BMI"], 4, duplicates="drop")
tab = d.groupby(q, observed=True).agg(n=("y", "size"), observed_PR=("y", "mean"),
                                      mean_fitted=("y", lambda s: np.nan))
tab["mean_fitted"] = d.assign(mu=mu).groupby(q, observed=True)["mu"].mean()
print(tab.round(4).to_string())
print(f"OVERALL  n={n}  observed PR rate={d['y'].mean():.4f}  "
      f"mean fitted={mu.mean():.4f}  (logit models match these exactly by "
      f"construction)")
ssr = float(np.sum((d['y'].values - mu) ** 2))
print(f"residual deviance={res.deviance:.4f}  null deviance={res.null_deviance:.4f}  "
      f"(McFadden pseudo-R2 reported in section 5)")

# ------------------------------------------------------------------- AIC report
print("\n" + RULE)
print("4. AIC = -2*logLik + 2k      (k counts the intercept)")
print(RULE)
print(f"logLik (maximised binomial log-likelihood) = {llf:.6f}")
print(f"k = df_model + 1 = {int(res.df_model)} + 1 = {k}   (intercept + BMI slope; "
      f"binomial dispersion fixed at 1)")
print(f"hand-computed  AIC = -2*({llf:.6f}) + 2*{k} = {aic_hand:.6f}")
print(f"statsmodels reported res.aic                  = {aic_sm:.6f}")
diff = abs(aic_hand - aic_sm)
print(f"|difference| = {diff:.3e}")
if diff > 1e-6:
    raise SystemExit("STOP: statsmodels aic != -2*llf+2k -> investigate before reporting.")
print("AGREEMENT CONFIRMED: statsmodels res.aic == -2*llf + 2k with k=2.")
print(f"\n>>> REPORTED AIC = {aic_hand:.3f}   (2-decimal form: {aic_hand:.2f}) <<<")
print(f"[derivable variant] slope-only k=1 would give {aic_hand - 2:.3f} "
      f"-- NOT the reported answer; k=2 including the intercept is used.")

# -------------------------------- independent cross-check (no statsmodels)
from scipy.optimize import minimize
Xc = np.column_stack([np.ones(n), d["BMI"].values])
yc = d["y"].values.astype(float)
def _nll(b):
    p = 1.0 / (1.0 + np.exp(-(Xc @ b)))
    return -np.sum(yc * np.log(p) + (1 - yc) * np.log(1 - p))
_r = minimize(_nll, [0.0, 0.0], method="BFGS", options={"gtol": 1e-12, "maxiter": 1000})
_llf_ind = -float(_r.fun)
print("\n" + RULE)
print("4b. INDEPENDENT CROSS-CHECK (hand-coded binomial NLL, scipy BFGS, no statsmodels)")
print(RULE)
print(f"independent beta = ({_r.x[0]:.6f}, {_r.x[1]:.6f})   "
      f"statsmodels = ({params['Intercept']:.6f}, {params['BMI']:.6f})")
print(f"independent logLik = {_llf_ind:.6f}   statsmodels logLik = {llf:.6f}   "
      f"|diff| = {abs(_llf_ind - llf):.2e}")
print(f"independent AIC(k=2) = {-2*_llf_ind + 4:.6f}  -> matches reported AIC: "
      f"{abs((-2*_llf_ind + 4) - aic_hand) < 1e-6}")

# --------------------------------------------------- null model (context only)
null = smf.glm(formula="y ~ 1", data=d, family=sm.families.Binomial()).fit()
lr_stat = 2.0 * (res.llf - null.llf)
lr_df = int(res.df_model - null.df_model)
from scipy import stats as st
lr_p = float(st.chi2.sf(lr_stat, lr_df))
print("\n" + RULE)
print("5. CONTEXT ONLY -- intercept-only null (not the answer)")
print(RULE)
print(f"null logLik={null.llf:.6f}   null k=1   null AIC={-2*null.llf + 2*1:.3f} "
      f"(statsmodels: {null.aic:.3f})")
print(f"likelihood-ratio chi2={lr_stat:.4f} on {lr_df} df, p={lr_p:.4f}")
print(f"AIC: null {null.aic:.3f}  ->  BMI model {aic_hand:.3f}   "
      f"(delta = {aic_hand - null.aic:.3f})")
print(f"McFadden pseudo-R2 = 1 - {res.llf:.4f}/{null.llf:.4f} = "
      f"{1 - res.llf/null.llf:.4f}")

# ------------------------------------ SENSITIVITY (not the reported answer)
print("\n" + RULE)
print("SENSITIVITY (NOT THE REPORTED ANSWER) -- alternative outcome codings")
print("The reported answer above uses the approved coding y = PR vs not-PR.")
print("These rows exist only to show how much the coding choice matters.")
print(RULE)
sens = [("primary: PR vs not-PR (SD+PD)", d, d["y"])]
alt_frames = {
    "alt: PR+SD (disease control) vs PD": d[d["Efficacy"].isin(["PR", "SD", "PD"])].assign(
        yy=lambda x: x["Efficacy"].isin(["PR", "SD"]).astype(int)),
    "alt: PR vs PD only (SD dropped)": d[d["Efficacy"].isin(["PR", "PD"])].assign(
        yy=lambda x: (x["Efficacy"] == "PR").astype(int)),
}
print(f"{'coding':42s} {'n':>4s} {'events':>7s} {'logLik':>10s} {'k':>2s} {'AIC':>9s}")
for name, fr, yy in sens:
    print(f"{name:42s} {len(fr):4d} {int(yy.sum()):7d} {llf:10.4f} {k:2d} {aic_hand:9.3f}   <-- REPORTED")
for name, fr in alt_frames.items():
    r = smf.glm(formula="yy ~ BMI", data=fr, family=sm.families.Binomial()).fit()
    print(f"{name:42s} {len(fr):4d} {int(fr['yy'].sum()):7d} {r.llf:10.4f} "
          f"{2:2d} {r.aic:9.3f}")

print("\nNOTE: no model containing 'Groups' was fitted (Group1=41/41 PR, "
      "Group2=0 PR -> perfect separation).")
print("NOTE: no covariate model (Age/Gender/etc.) was fitted -- question is BMI-only.")
print("\nDONE.")
