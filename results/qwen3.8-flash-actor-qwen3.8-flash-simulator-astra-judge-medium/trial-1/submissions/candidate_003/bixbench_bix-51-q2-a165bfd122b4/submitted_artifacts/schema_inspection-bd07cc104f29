import pandas as pd, numpy as np
pd.set_option('display.width',220)
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

print("=== BMI numeric describe (NaN-skipping) ===")
print(df['BMI'].describe().to_string())
print("min/max:", df['BMI'].min(), df['BMI'].max())
print("any <=0:", (df['BMI']<=0).sum(), "| any >=99:", (df['BMI']>=99).sum(), "| any ==999:", (df['BMI']==999).sum())
print("BMI missing:", df['BMI'].isna().sum(), "BMI non-missing:", df['BMI'].notna().sum())
print("BMI decimals check: all values are 1-dp? ->", np.allclose(df['BMI'].dropna()*10, np.round(df['BMI'].dropna()*10)))

print("\n=== Efficacy value_counts (dropna=False) ===")
print(df['Efficacy'].value_counts(dropna=False).to_string())
print("upper/strip variants?", sorted(set(str(x).strip().upper() for x in df['Efficacy'].dropna().unique())))

print("\n=== Missingness per column ===")
m = pd.DataFrame({'n_missing': df.isna().sum(), 'pct': (df.isna().mean()*100).round(1), 'n_unique': df.nunique()})
print(m.to_string())

print("\n=== Rows with missing BMI OR missing Efficacy ===")
mask = df['BMI'].isna() | df['Efficacy'].isna()
print("n_rows_missing_either:", mask.sum())
print("rows missing BMI but NOT Efficacy:", ((df['BMI'].isna()) & (df['Efficacy'].notna())).sum())
print("rows missing Efficacy but NOT BMI:", ((df['Efficacy'].isna()) & (df['BMI'].notna())).sum())
print("rows both missing:", ((df['Efficacy'].isna()) & (df['BMI'].isna())).sum())

print("\n=== Are the 41 missing rows a contiguous trailing block? indices of complete rows ===")
idx = df.index[(df['Efficacy'].notna()) & (df['BMI'].notna())].tolist()
print("complete-row indices:", idx[:5], "...", idx[-5:], "count:", len(idx))
print("blank-row indices:", df.index[mask].tolist()[:5], "...", df.index[mask].tolist()[-5:])

comp = df[(df['Efficacy'].notna()) & (df['BMI'].notna())]
print("\n=== n for AIC (complete cases on Efficacy+BMI) ===", len(comp))
print("\n=== Outcome crosstab on complete cases ===")
print(comp['Efficacy'].value_counts().to_string())
print("PR:", (comp['Efficacy']=='PR').sum(), " non-PR:", (comp['Efficacy']!='PR').sum())
print("PR+CR:", comp['Efficacy'].isin(['PR','CR']).sum(), " (CR present? 'CR' in uniques:", 'CR' in set(df['Efficacy'].dropna()), ")")

print("\n=== BMI by outcome group (complete cases) ===")
print(comp.groupby('Efficacy')['BMI'].describe().to_string())

print("\n=== Other columns' missingness WITHIN the 80 complete rows (would-be covariates) ===")
print(comp.drop(columns=['BMI','Efficacy']).isna().sum().to_string())

print("\n=== Groups / Sequence number within complete rows ===")
print(comp['Groups'].value_counts(dropna=False).to_string())
print("Sequence number min/max within complete rows:", comp['Sequence number'].min(), comp['Sequence number'].max())
