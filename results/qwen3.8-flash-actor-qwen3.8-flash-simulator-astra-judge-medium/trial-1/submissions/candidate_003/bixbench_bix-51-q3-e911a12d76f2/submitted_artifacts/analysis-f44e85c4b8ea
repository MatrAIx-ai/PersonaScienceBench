"""
Final analysis (bix-51-q3): p-value for AGE as a predictor of treatment response
(partial response, PR) in a combined logistic regression with BMI, Age, Gender.

APPROED DESIGN (agreed with researcher):
  * Input: data/data.xlsx, sheet "Sheet1".
  * Cleaning: drop unnamed/all-empty Excel columns; drop the 41 trailing all-empty
    rows (the only "missing" values; one of them holds Age=' ' -> Excel artifact,
    not a patient-level missing value). -> N = 80 complete cases, no imputation.
  * Outcome: y = 1 if Efficacy == 'PR' else 0  (PR vs SD+PD; CR absent in data).
  * Predictors (exactly three, as asked): BMI (continuous, kg/m^2),
    Age (continuous, YEARS, linear term only), Gender (single dummy,
    reference/baseline = Female, so Gender_Male = 1 for males).
  * Groups is DELIBERATELY EXCLUDED (see LIMITATION below).
  * Estimation: statsmodels Logit (MLE) -> Wald, two-sided p-value = FINAL ANSWER.
    Cross-check: statsmodels GLM with Binomial family. Agreement required < 1e-6,
    otherwise the script raises instead of picking a number.

LIMITATION (documented per request, item D):
  Groups is perfectly collinear with the outcome (Group 1 <=> Efficacy PR <=> y=1,
  Group 2 <=> PD/SD <=> y=0). Including it makes the likelihood unbounded
  (perfect separation / non-identified coefficients), so it must be dropped.
  Consequence for interpretation: the model estimates the Age/BMI/Gender
  associations WITHIN what is effectively a two-arm group comparison, so these
  predictors are not separable from the treatment scheme; the Age p-value is an
  association within this confounded sample, not a causal effect of age.

No ROC / calibration / stepwise / bootstrap: out of scope by agreement.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)
pd.set_option("display.float_format", lambda v: f"{v:.6g}")

PATH, SHEET = "data/data.xlsx", "Sheet1"
TOL = 1e-6

# ---------------------------------------------------------------- 1. load/clean
raw = pd.read_excel(PATH, sheet_name=SHEET)
n_raw = len(raw)
raw = raw.loc[:, ~raw.columns.astype(str).str.startswith("Unnamed")]
df = raw[raw["Efficacy"].notna()].copy()          # drop 41 trailing empty rows
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
for c in ["BMI", "Gender", "Efficacy"]:
    df[c] = pd.to_numeric(df[c], errors="coerce") if c in ("BMI",) else df[c]

print(f"raw rows = {n_raw}; rows kept (Efficacy non-null) = {len(df)}; "
      f"rows dropped as empty Excel tail = {n_raw - len(df)}")

vars_ = ["BMI", "Age", "Gender", "Efficacy"]
assert df[vars_].notna().all().all(), "unexpected missingness in model variables"
n = len(df)
print(f"complete cases on model variables: {n}/{n} -> N = {n}")

# ------------------------------------------------------- 2. encode outcome/dummies
levels = sorted(df["Efficacy"].unique())
print(f"Efficacy levels present = {levels}")
assert set(levels) <= {"CR", "PR", "SD", "PD"}, f"unexpected Efficacy codes: {levels}"
df["y"] = (df["Efficacy"] == "PR").astype(int)     # PR = responder
df["Gender_Male"] = (df["Gender"] == "Male").astype(float)   # baseline = Female

print("\noutcome coding: y=1 if Efficacy=='PR', else 0 (SD and PD both = 0); CR not present")
print("n responders (PR) =", int(df.y.sum()), " non-responders (SD+PD) =", int((1 - df.y).sum()))
print("Gender coding: Female -> 0 (baseline), Male -> 1 ;",
      "counts:", df.Gender.value_counts().to_dict())
print("Age in years, continuous linear term:",
      f"min={df.Age.min()}, max={df.Age.max()}, mean={df.Age.mean():.2f}, sd={df.Age.std():.2f}")
print("BMI:", f"min={df.BMI.min()}, max={df.BMI.max()}, mean={df.BMI.mean():.2f}, sd={df.BMI.std():.2f}")

# documented limitation: Groups perfectly collinear with y
gtab = pd.crosstab(df["Groups"], df["y"])
print("\nGroups x y (why Groups is EXCLUDED - perfect collinearity / separation):")
print(gtab)
assert (gtab.min(axis=1) == 0).all(), "Groups no longer perfectly collinear with y"
print("-> Groups excluded from the model (would be non-identified). See LIMITATION in docstring.")

# -------------------------------------------------------------- 3. fit Logit (MLE)
X = sm.add_constant(df[["BMI", "Age", "Gender_Male"]].astype(float), prepend=True)
logit = sm.Logit(df["y"].astype(float), X).fit(disp=0, maxiter=200)
print("\n=================== Logit (MLE) full output ===================")
print(logit.summary())
print(f"\nconverged = {logit.mle_retvals['converged']}, iterations = {logit.mle_retvals['iterations']}, "
      f"n = {int(logit.nobs)}, log-likelihood = {logit.llf:.6f}, "
      f"pseudo-R2 (McFadden) = {logit.prsquared:.6f}, "
      f"LR chi2 = {2 * (logit.llf - logit.llnull):.4f} (p = {logit.llr_pvalue:.6g})")
print("finite coefficients:", bool(np.isfinite(logit.params).all()),
      "| max |SE| =", f"{logit.bse.max():.4f}",
      "| no separation check: all |beta| < 25 ->", bool((logit.params.abs() < 25).all()))

# --------------------------------------------------- 4. cross-check with GLM Binomial
glm = sm.GLM(df["y"].astype(float), X, family=sm.families.Binomial()).fit()
diff = float(np.max(np.abs(np.asarray(logit.params) - np.asarray(glm.params))))
pdiff = float(np.max(np.abs(np.asarray(logit.pvalues) - np.asarray(glm.pvalues))))
print("\n=================== Logit vs GLM(Binomial) cross-check ===================")
print(pd.DataFrame({"Logit_coef": logit.params, "GLM_coef": glm.params,
                    "diff_coef": np.asarray(logit.params) - np.asarray(glm.params),
                    "Logit_p": logit.pvalues, "GLM_p": glm.pvalues,
                    "diff_p": np.asarray(logit.pvalues) - np.asarray(glm.pvalues)}))
print(f"max |coef diff| = {diff:.3e} ; max |p diff| = {pdiff:.3e} (tolerance {TOL:g})")
if not (diff < TOL and pdiff < TOL):
    raise SystemExit(f"ABORT: Logit and GLM disagree beyond {TOL:g}; report to researcher, do not cherry-pick.")
print("-> agreement within numerical tolerance: OK")

# ------------------------------------------------------------- 5. final answer: Age
b, se, z, p = (logit.params["Age"], logit.bse["Age"], logit.tvalues["Age"], logit.pvalues["Age"])
lo, hi = logit.conf_int().loc["Age"]
print("\n=================== ANSWER: Age (Wald, two-sided) ===================")
print(f"N = {n}; model: logit(P(PR)) = b0 + b_BMI*BMI + b_Age*Age + b_Male*Gender_Male")
print(f"Age: coef = {b:.10f}  SE = {se:.10f}  z = {z:.6f}  two-sided Wald p = {p:.10g}  "
      f"(p = {p:.3e})")
print(f"Age 95% CI: [{lo:.8f}, {hi:.8f}]  odds ratio = {np.exp(b):.6f} "
      f"(95% CI [{np.exp(lo):.6f}, {np.exp(hi):.6f}])")
print("\nFull coefficient table (Logit, Wald):")
tab = pd.DataFrame({"coef": logit.params, "std_err": logit.bse, "z": logit.tvalues,
                    "P>|z|": logit.pvalues, "CI_lo_95": logit.conf_int()[0],
                    "CI_hi_95": logit.conf_int()[1], "OR": np.exp(logit.params)})
print(tab.to_string(float_format=lambda v: f"{v:.6f}"))
print("\nGender_Male OR interpretation: odds of PR for males vs females (baseline), "
      "adjusted for BMI and Age.")
print("Groups excluded (perfectly collinear with outcome) - Age/BMI/Gender effects are not "
      "separable from the treatment group scheme.")

with open("model_results.txt", "w") as f:
    f.write(logit.summary().as_text())
    f.write("\n\nLogit vs GLM max|coef diff| = %.3e ; max|p diff| = %.3e\n" % (diff, pdiff))
    f.write("\nANSWER p_value_age = %.12g\n" % p)
