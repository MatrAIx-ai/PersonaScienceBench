"""Input-schema inspection for data/data.xlsx (Sheet1).

Purpose (plan stage only, no model fitting / no p-values):
  1. dtypes, shape, trailing empty/junk columns
  2. missingness, numeric-ness of Age/BMI, min/max
  3. category levels & counts for Efficacy / Groups / Gender
  4. cross-tab of Efficacy vs Groups, duplicate/blank-row checks
"""
import pandas as pd
import numpy as np

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)

PATH = "data/data.xlsx"
raw = pd.read_excel(PATH, sheet_name="Sheet1")

print("== raw shape ==", raw.shape)
print("\n== raw columns (index: name) ==")
for i, c in enumerate(raw.columns):
    print(f"  {i:>2}: {c!r}")

# trailing unnamed / all-empty columns
unnamed = [c for c in raw.columns if isinstance(c, str) and c.startswith("Unnamed")]
empty_cols = [c for c in raw.columns if raw[c].isna().all()]
print("\n== unnamed cols ==", unnamed)
print("== all-NaN cols ==", empty_cols)

df = raw.drop(columns=[c for c in raw.columns if str(c).startswith("Unnamed")])
print("\n== trimmed shape ==", df.shape)

print("\n== dtypes ==")
print(df.dtypes)

print("\n== head ==")
print(df.head())

print("\n== missingness (trimmed df) ==")
miss = df.isna().sum()
print(pd.DataFrame({"n_missing": miss, "pct_missing": (miss / len(df) * 100).round(1)}))

print("\n== rows fully NaN ==", int(df.isna().all(axis=1).sum()))
print("== duplicated rows (all cols) ==", int(df.duplicated().sum()))
print("== duplicated 'Sequence number' ==", int(df["Sequence number"].duplicated().sum()))
print("== Sequence number range ==", df["Sequence number"].min(), df["Sequence number"].max())

# numeric coercion checks
for col in ["Age", "BMI"]:
    s = df[col]
    coerced = pd.to_numeric(s, errors="coerce")
    print(f"\n== {col} ==  raw dtype={s.dtype}  n_nonnumeric_after_coerce="
          f"{int(coerced.isna().sum() - s.isna().sum())}")
    print("   min/max:", coerced.min(), coerced.max(), " mean/std:",
          round(float(coerced.mean()), 3), round(float(coerced.std()), 3))
    print("   n unique:", int(coerced.nunique()), " sorted extremes:",
          sorted(coerced.dropna().unique())[:5], "...", sorted(coerced.dropna().unique())[-5:])
    if int(coerced.isna().sum() - s.isna().sum()):
        bad = s[pd.isna(coerced) & s.notna()]
        print("   NON-NUMERIC VALUES:", bad.unique().tolist(), "row idx:", bad.index.tolist())

print("\n== categorical level counts ==")
for col in ["Efficacy", "Groups", "Gender", "Family history", "ECOG-PS",
            "Child-Pugh", "Chemotherapy experience", "HBV infection",
            "Toxic and side effect"]:
    vc = df[col].value_counts(dropna=False)
    print(f"\n-- {col} (n_unique={df[col].nunique(dropna=True)}, n_nan={int(df[col].isna().sum())}) --")
    print(vc.to_string())

print("\n== Efficacy x Groups crosstab ==")
print(pd.crosstab(df["Efficacy"], df["Groups"], dropna=False, margins=True))

print("\n== Gender x Efficacy crosstab ==")
print(pd.crosstab(df["Gender"], df["Efficacy"], dropna=False, margins=True))

# complete-case picture for the 4 model variables
model_vars = ["BMI", "Age", "Gender", "Efficacy"]
print("\n== complete cases on model vars ==", int(df[model_vars].dropna().shape[0]),
      "of", len(df))
print("rows missing any model var:", int(df[model_vars].isna().any(axis=1).sum()))
print(df.loc[df[model_vars].isna().any(axis=1), model_vars].to_string())
