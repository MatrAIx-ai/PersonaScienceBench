"""
Logistic regression: remission ~ Age + BMI + Gender
Question: change in log-odds of remission per +1 year of patient age.

Approved protocol:
  - remission = 1 if Efficacy == 'PR' else 0 (PD, SD -> 0)          [primary, A1]
  - statsmodels GLM Binomial (logit link),
    formula: remission ~ Age + BMI + C(Gender, Treatment("Female")) [Female = reference]
  - complete cases; cleanup: drop fully-blank rows, drop rows without Sequence
    number, Age -> to_numeric
  - cross-checks: sm.Logit (Newton) and manual design matrix + BFGS solver
  - sensitivity (context only): remission = PR+SD vs PD
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

warnings.simplefilter("error", category=Warning)  # any convergence/separation warning -> hard error

# ---------- 1. Reproducible cleanup ----------
raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print(f"raw rows in file: {len(raw)}")

df = raw.dropna(how="all").copy()
print(f"after dropping fully-blank rows: {len(df)}")

df = df[df["Sequence number"].notna()].copy()           # drops junk row (Age==' ')
df["Age"] = pd.to_numeric(df["Age"].astype(str).str.strip(), errors="coerce")
df = df.dropna(subset=["Age", "BMI", "Gender", "Efficacy"])  # complete-case
print(f"FINAL N used for fitting: {len(df)}")

df["remission"] = (df["Efficacy"] == "PR").astype(int)
print("outcome counts (remission=1 : 0):", df["remission"].sum(), ":", (1 - df["remission"]).sum())
print("Gender:", df["Gender"].value_counts().to_dict(),
      "| Age:", df["Age"].min(), "-", df["Age"].max(),
      "| BMI (assumed kg/m2):", df["BMI"].min(), "-", df["BMI"].max())

# ---------- 2. Primary model ----------
formula = 'remission ~ Age + BMI + C(Gender, Treatment("Female"))'
glm = smf.glm(formula=formula, data=df, family=sm.families.Binomial()).fit()

llnull = smf.glm("remission ~ 1", data=df, family=sm.families.Binomial()).fit().llf
print("\n=== Primary model: GLM Binomial (logit link) ===")
print(f"converged: {glm.converged} | IRLS iterations: {glm.fit_history['iteration']} | no warnings raised")
print(f"loglike: {glm.llf:.4f} | null loglike: {llnull:.4f} | AIC: {glm.aic:.4f} | deviance: {glm.deviance:.4f}")
print(f"McFadden pseudo-R2: {1 - glm.llf/llnull:.4f}")

ci = glm.conf_int()  # Wald CI (normal approximation) — stated explicitly
tab = pd.DataFrame({"beta": glm.params, "SE": glm.bse, "z": glm.tvalues,
                    "p": glm.pvalues, "ci95_lo": ci[0], "ci95_hi": ci[1]})
tab["OR=exp(beta)"] = np.exp(tab["beta"])
print("\nCoefficient table (Wald inference; reference: Gender=Female):")
print(tab.round(4).to_string())

b = glm.params["Age"]
print(f"\n>>> beta_Age (log-odds per +1 year) = {b:.3f}")
print(f">>> SE = {glm.bse['Age']:.3f} | p = {glm.pvalues['Age']:.4f} | "
      f"95% Wald CI = [{ci.loc['Age',0]:.3f}, {ci.loc['Age',1]:.3f}]")
print(f">>> OR per year = exp(beta) = {np.exp(b):.3f} "
      f"[{np.exp(ci.loc['Age',0]):.3f}, {np.exp(ci.loc['Age',1]):.3f}]")

# ---------- 3. Cross-checks (different implementations/solvers) ----------
logit = smf.logit(formula=formula, data=df).fit(disp=0)
d1 = np.abs(glm.params - logit.params).max()
print(f"\nCross-check GLM(IRLS) vs Logit(Newton): max |beta diff| = {d1:.2e} -> "
      f"coincide to <1e-6" if d1 < 1e-6 else "MISMATCH")

X = np.column_stack([np.ones(len(df)), df["Age"].astype(float), df["BMI"].astype(float),
                     (df["Gender"] == "Male").astype(float)])
bfgs = sm.Logit(df["remission"].values.astype(float), X).fit(
    method="bfgs", disp=0, maxiter=200, gtol=1e-8)
# map formula params (patsy order: Intercept, Gender, Age, BMI) to manual X order (const, Age, BMI, Male)
ordered = np.array([logit.params["Intercept"], logit.params["Age"], logit.params["BMI"],
                    logit.params['C(Gender, Treatment("Female"))[T.Male]']])
d2 = np.abs(ordered - bfgs.params).max()
print(f"Cross-check Logit(Newton) vs Logit(BFGS, manual design with Male dummy): "
      f"max |beta diff| = {d2:.2e} -> coincide to <1e-6" if d2 < 1e-6 else "MISMATCH")

# ---------- 4. Sensitivity to outcome dichotomization (A1; context only) ----------
df["rem_alt"] = df["Efficacy"].isin(["PR", "SD"]).astype(int)   # PR+SD vs PD
alt = smf.glm(formula='rem_alt ~ Age + BMI + C(Gender, Treatment("Female"))',
              data=df, family=sm.families.Binomial()).fit()
print("\n=== Sensitivity (NOT the answer): remission = PR+SD vs PD ===")
print(f"beta_Age = {alt.params['Age']:.3f} (SE {alt.bse['Age']:.3f}, p {alt.pvalues['Age']:.3f}); "
      f"events {df['rem_alt'].sum()}:{(1-df['rem_alt']).sum()} -> "
      f"{'same sign & order of magnitude as primary' if np.sign(alt.params['Age'])==np.sign(b) else 'SIGN FLIPS'}")
