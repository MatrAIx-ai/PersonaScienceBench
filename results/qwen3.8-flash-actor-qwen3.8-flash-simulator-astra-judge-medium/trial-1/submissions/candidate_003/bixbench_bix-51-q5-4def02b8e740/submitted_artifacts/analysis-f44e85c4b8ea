"""
bix-51-q5: p-value for BMI vs treatment response (logistic regression).

Design (approved by researcher):
  - Analysis set = Excel rows 2..81 (Sequence number 1..80). Rows 82..122 are
    blank/artefact rows and columns M..AJ are empty -> dropped before modelling.
  - Response y = 1 if Efficacy == 'PR' (responders; CR absent from data),
    y = 0 if Efficacy in {'SD','PD'} (non-responders).
    Direction note: the BMI p-value is invariant to which direction the binary
    response is coded; only the sign of beta flips.
  - Model A (HEADLINE): y ~ BMI, unadjusted, BMI raw kg/m^2 (no standardisation).
  - Model B (confirmatory): y ~ BMI + Age + Gender + Family history + ECOG-PS +
    Child-Pugh + Chemotherapy experience + HBV infection.
    'Groups' EXCLUDED: it is a deterministic function of the response
    (Group1 = all PR, Group2 = all SD/PD) -> perfect separation / duplicate of Y.
    'Toxic and side effect' EXCLUDED: post-treatment toxicity, not a baseline
    covariate (and 38/80 blanks).
  - Inference: Wald z, P>|z| from statsmodels GLM Binomial (summary() output) =
    headline p-value. Likelihood-ratio test (nested GLM with vs without BMI) as
    sensitivity.

No imputation is needed: within the 80 analysis rows there are no missing values
in the response, BMI, or any adjusted covariate.
"""

import numpy as np
import openpyxl
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

XLSX = "data/data.xlsx"

# ----------------------------------------------------------------- 1. load/clean
raw = pd.read_excel(XLSX, sheet_name="Sheet1")
print("=" * 78)
print("1. LOAD / CLEAN")
print("=" * 78)
print(f"raw pandas shape                : {raw.shape}")
blank = raw.index[raw.isna().all(axis=1)]
print(f"fully blank rows                : {len(blank)} (index {blank.min()}..{blank.max()})")

df = raw[pd.to_numeric(raw["Sequence number"], errors="coerce").notna()].copy()
df["Sequence number"] = df["Sequence number"].astype(int)
print(f"rows kept (Sequence number 1..N): n = {len(df)}, "
      f"seq {df['Sequence number'].min()}..{df['Sequence number'].max()}, "
      f"dups = {df['Sequence number'].duplicated().sum()}")

# numeric typing
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
df["BMI"] = pd.to_numeric(df["BMI"], errors="coerce")
df["Groups"] = df["Groups"].astype("Int64")

# response (direction fixed and documented)
lv = df["Efficacy"].astype("object").str.strip()
df["response"] = np.where(lv == "PR", 1, 0)
assert lv.isin(["PR", "SD", "PD"]).all(), lv.unique()
print("\nEfficacy levels :", lv.value_counts().to_dict())
print("response coding : PR -> 1 (responders, CR absent), SD/PD -> 0 "
      f"=> 1: {int(df.response.sum())}, 0: {int((1 - df.response).sum())}")

print("\nmissing values inside analysis set:")
print(df.isna().sum()[lambda s: s > 0].to_string() or "  none")

# --------------------------------------------------- 2. Groups vs response check
print("\n" + "=" * 78)
print("2. WHY 'Groups' IS EXCLUDED (Groups x Efficacy crosstab)")
print("=" * 78)
ct = pd.crosstab(df["Groups"], df["Efficacy"])
print(ct.to_string())
groups_is_response = (
    set(df.loc[df.Groups == 1, "response"]) == {1}
    and set(df.loc[df.Groups == 2, "response"]) == {0}
)
print(f"Groups is a deterministic duplicate of the response: {groups_is_response}"
      "  -> including it would give perfect separation, so it is not a covariate.")

print("\ncovariate x Group imbalance (adjusted model covariates):")
for c in ["Age", "Gender", "Family history", "ECOG-PS", "Child-Pugh",
          "Chemotherapy experience", "HBV infection", "BMI"]:
    if df[c].dtype.kind in "if":
        g = df.groupby("Groups", observed=True)[c].agg(["count", "mean", "std"]).round(2)
    else:
        g = pd.crosstab(df[c].astype("object"), df["Groups"])
    print(f"\n-- {c}\n{g.to_string()}")


# patsy cannot parse names with spaces inside C(); make safe identifiers
RENAME = {"Family history": "family_history", "ECOG-PS": "ecog_ps",
          "Child-Pugh": "child_pugh", "Chemotherapy experience": "chemo_exp",
          "HBV infection": "hbv_infection", "Toxic and side effect": "toxicity"}
df = df.rename(columns=RENAME)
print("\ncovariate renames for the formula interface:", RENAME)

# ------------------------------------------------------------------- 3. models
BASE = ("response ~ BMI")
ADJ = ("response ~ BMI + Age + C(Gender, Treatment(reference='Female'))"
       " + C(family_history, Treatment(reference='No'))"
       " + C(ecog_ps, Treatment(reference='0-1'))"
       " + C(child_pugh, Treatment(reference='A'))"
       " + C(chemo_exp, Treatment(reference='No'))"
       " + C(hbv_infection, Treatment(reference='No'))")

def fit(formula, data):
    return smf.glm(formula=formula, data=data,
                   family=sm.families.Binomial()).fit()

def drop_bmi(formula):
    """Formula with only the BMI main effect removed (for the nested LR test)."""
    rhs, terms = formula.split("~")[0].strip(), formula.split("~")[1].strip()
    terms = [t.strip() for t in terms.split("+")]
    assert sum(t == "BMI" for t in terms) == 1, terms
    kept = [t for t in terms if t != "BMI"]
    return rhs + " ~ " + (" + ".join(kept) if kept else "1")

def lr_p(full, reduced):
    """Likelihood-ratio test for the BMI term (1 df): reduced model = full minus BMI."""
    dev_drop = reduced.deviance - full.deviance
    return dev_drop, stats.chi2.sf(dev_drop, df=1)

def report(name, formula, data):
    print("\n" + "=" * 78)
    print(f"{name}  (n = {len(data)})")
    print("=" * 78)
    print("formula: " + " ".join(formula.split()))
    m = fit(formula, data)
    print(m.summary())

    b, se, p = m.params["BMI"], m.bse["BMI"], m.pvalues["BMI"]
    lo, hi = b - 1.959963984540054 * se, b + 1.959963984540054 * se
    null = smf.glm("response ~ 1", data=data,
                   family=sm.families.Binomial()).fit()      # for pseudo-R2
    red = fit(drop_bmi(formula), data)                        # nested: no BMI
    dv, plr = lr_p(m, red)
    # also report the omnibus (vs intercept-only) LR test for completeness
    dv_all, plr_all = lr_p(m, null)

    conv = np.isfinite(m.params.values).all() and np.isfinite(m.bse.values).all()
    info = {
        "model": name, "n": int(m.nobs), "k_params": int(m.df_model + 1),
        "events": int(data["response"].sum()), "non_events": int((1 - data["response"]).sum()),
        "beta_BMI": b, "se_BMI": se, "ci_lo": lo, "ci_hi": hi,
        "OR_BMI": np.exp(b), "OR_lo": np.exp(lo), "OR_hi": np.exp(hi),
        "z": m.tvalues["BMI"], "p_wald": p,
        "LR_stat": dv, "p_LR": plr, "LR_stat_omnibus": dv_all, "p_LR_omnibus": plr_all,
        "converged_OK": bool(m.converged and conv),
        "max_fitted": float(np.max(m.fittedvalues)),
        "min_fitted": float(np.min(m.fittedvalues)),
        "max_se": float(np.max(m.bse.values)),
        "EPV": float(data["response"].sum() / (m.df_model + 1)),
        "pseudo_R2_McFadden": float(1 - m.llf / null.llf),
        "aic": float(m.aic), "deviance": float(m.deviance),
    }
    print(f"\n--> BMI: beta={b:.6f}  SE={se:.6f}  95%CI=({lo:.4f},{hi:.4f})  "
          f"OR={np.exp(b):.4f} [{np.exp(lo):.4f},{np.exp(hi):.4f}]")
    print(f"--> Wald z={info['z']:.4f}  p={p:.6g}")
    print(f"--> LR test for BMI (nested, reduced = full minus BMI): "
          f"chi2(1)={dv:.4f}  p={plr:.6g}")
    print(f"--> (omnibus LR vs intercept-only: chi2({int(m.df_model)})={dv_all:.4f}  p={plr_all:.6g})")
    print(f"--> converged={m.converged}  all coefs/SE finite={conv}  "
          f"fitted probs in [{info['min_fitted']:.4f},{info['max_fitted']:.4f}]  "
          f"max SE={info['max_se']:.3f}  (no separation warning)")
    print(f"--> n={int(m.nobs)}, events={info['events']}, "
          f"EPV={info['EPV']:.2f}, McFadden R2={info['pseudo_R2_McFadden']:.4f}")
    return m, info

mA, iA = report("MODEL A (HEADLINE, unadjusted)", BASE, df)
mB, iB = report("MODEL B (confirmatory, adjusted; Groups excluded)", ADJ, df)

# ----------------------------------------------------------- 4. side-by-side
print("\n" + "=" * 78)
print("4. SIDE-BY-SIDE SUMMARY")
print("=" * 78)
cols = ["model", "n", "events", "k_params", "beta_BMI", "se_BMI", "OR_BMI",
        "ci_lo", "ci_hi", "z", "p_wald", "LR_stat", "p_LR", "LR_stat_omnibus",
        "p_LR_omnibus", "EPV", "converged_OK", "max_fitted", "min_fitted"]
tab = pd.DataFrame([iA, iB])[cols]
print(tab.to_string(index=False))
print(f"\nHEADLINE ANSWER: Wald p for BMI (unadjusted logistic regression, "
      f"response=PR vs SD/PD) = {iA['p_wald']:.4g}")
print(f"Adjusted (Model B, Groups excluded) Wald p for BMI = {iB['p_wald']:.4g}")
same_sign = np.sign(iA["beta_BMI"]) == np.sign(iB["beta_BMI"])
same_sig = (iA["p_wald"] < .05) == (iB["p_wald"] < .05)
print(f"Sign agreement: {same_sign}; 5%-significance agreement: {same_sig}; "
      f"Wald vs LR within model: A |p diff|={abs(iA['p_wald'] - iA['p_LR']):.4g}, "
      f"B |p diff|={abs(iB['p_wald'] - iB['p_LR']):.4g}")

# invariance of the p-value to response-coding direction (researcher's point 3)
flip = df.copy(); flip["response"] = 1 - flip["response"]
mF = fit(BASE, flip)
print(f"\nCoding-direction invariance check (y := 1-response): "
      f"beta {iA['beta_BMI']:.4f} -> {mF.params['BMI']:.4f}, "
      f"p {iA['p_wald']:.6g} -> {mF.pvalues['BMI']:.6g}")

# ------------------------------------------------- 5. independent cross-checks
print("\n" + "=" * 78)
print("5. INDEPENDENT CROSS-CHECKS")
print("=" * 78)

# (a) same model via Logit (Newton MLE) instead of GLM/IRLS
import statsmodels.formula.api as smf2
lg = smf2.logit(BASE, data=df).fit(disp=0)
print(f"(a) Logit/Newton vs GLM/IRLS: beta {lg.params['BMI']:.6f} (GLM {iA['beta_BMI']:.6f}), "
      f"z {lg.tvalues['BMI']:.4f} (GLM {iA['z']:.4f}), p {lg.pvalues['BMI']:.6g} "
      f"(GLM {iA['p_wald']:.6g})  -> agreement: "
      f"{np.isclose(lg.pvalues['BMI'], iA['p_wald'], rtol=1e-6)}")

# (b) row-count / value audit straight from the workbook (no pandas)
wb = openpyxl.load_workbook(XLSX, data_only=True)
ws = wb["Sheet1"]
hdr = {c.column: c.value for c in ws[1] if c.value is not None}
bmi_col = [k for k, v in hdr.items() if v == "BMI"][0]
eff_col = [k for k, v in hdr.items() if v == "Efficacy"][0]
seq_col = [k for k, v in hdr.items() if v == "Sequence number"][0]
pat = [(r[seq_col - 1].value, r[bmi_col - 1].value, r[eff_col - 1].value)
       for r in ws.iter_rows(min_row=2) if r[seq_col - 1].value is not None]
print(f"(b) workbook patient rows (Sequence number non-empty): {len(pat)}; "
      f"sum(BMI)={sum(p[1] for p in pat):.2f} vs pandas sum(BMI)={df['BMI'].sum():.2f}; "
      f"PR count={sum(1 for p in pat if p[2] == 'PR')} vs pandas {int(df['response'].sum())}")
print(f"    max used column index = {max(hdr)} (columns {max(hdr) + 1}..{ws.max_column} are empty headers)")

# (c) univariate sanity: two-sample t-test / AUC direction for BMI
from scipy import stats as st
t = st.ttest_ind(df.loc[df.response == 1, "BMI"], df.loc[df.response == 0, "BMI"],
                 equal_var=False)
auc = st.mannwhitneyu(df.loc[df.response == 1, "BMI"], df.loc[df.response == 0, "BMI"]).statistic \
      / (int(df.response.sum()) * int((1 - df.response).sum()))
print(f"(c) BMI mean responders {df.loc[df.response == 1, 'BMI'].mean():.2f} vs "
      f"non-responders {df.loc[df.response == 0, 'BMI'].mean():.2f}; "
      f"Welch t p={t.pvalue:.4g}; AUC={auc:.3f} (logistic model direction agrees: "
      f"beta>0 => higher BMI more likely PR)")

tab.to_csv("out/results_table.csv", index=False)
print("\nsaved: out/results_table.csv")
