"""bix-51-q8: unadjusted logistic regression of camrelizumab response on Age.

PRIMARY endpoint (approved): ORR coding -> response = 1 if Efficacy in {CR, PR}
else 0 (no CR rows exist, so PR=1 vs SD/PD=0; N=80, 41/39).
Specification (binding, unadjusted): logit P(response) = b0 + b1 * Age,
raw age in years, intercept included. No standardisation/covariates/splines.
DCR coding ({CR,PR,SD}=1) is run only as a clearly labelled SENSITIVITY.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import warnings

XL, SHEET = 'data/data.xlsx', 'Sheet1'


def load():
    raw = pd.read_excel(XL, SHEET)                 # 121x12: 40 blank rows + 1 junk row
    df = raw[~raw.isna().all(axis=1)].copy()       # drop fully blank rows
    df = df[df['Efficacy'].notna()].copy()         # drop stray whitespace-only row
    df['Efficacy'] = df['Efficacy'].astype(str).str.strip().str.upper()
    df['Age'] = pd.to_numeric(df['Age'].astype(str).str.strip(), errors='coerce')
    assert df['Age'].notna().all(), "unexpected missing Age"
    assert df['Sequence number'].duplicated().sum() == 0
    return df.reset_index(drop=True)


def fit(df, y, label):
    X = sm.add_constant(df['Age'].astype(float), has_constant='add')
    with warnings.catch_warnings(record=True) as caught:
        warnings.simplefilter('always')
        m = sm.Logit(y.astype(float), X).fit(disp=0, method='newton', maxiter=200)
        w = [str(x.message) for x in caught]
    ci = m.conf_int(alpha=0.05)
    tbl = pd.DataFrame({
        'coef': m.params, 'SE': m.bse, 'z': m.tvalues, 'p': m.pvalues,
        'ci95_low': ci[0], 'ci95_high': ci[1],
        'odds_ratio': np.exp(m.params),
    })
    print(f"\n================ {label} ================")
    print("n =", int(m.nobs), "| outcome counts:", dict(y.value_counts().sort_index()))
    print("converged =", bool(m.mle_retvals['converged']),
          "| iterations =", int(m.mle_retvals['iterations']),
          "| log-likelihood = %.6f" % m.llf,
          "| McFadden pseudo-R2 = %.4f" % m.prsquared)
    print("Logit warnings:", w if w else "none")
    print(tbl.round(6).to_string())
    p = m.predict(X)
    print("fitted probs: min=%.4f max=%.4f | min(yhat|y=0)=%.4f max(yhat|y=1)=%.4f"
          % (p.min(), p.max(), p[y == 0].max(), p[y == 1].min()))
    print("separation check: no fitted prob at 0/1 ->", bool((p > 0).all() and (p < 1).all()))
    g = sm.GLM(y.astype(float), X, family=sm.families.Binomial()).fit()
    print("GLM Binomial cross-check  b0=%.6f  b1=%.6f | max|coef diff| vs Logit=%.3e"
          % (g.params.iloc[0], g.params.iloc[1], float(np.abs(g.params - m.params).max())))
    return m, tbl


df = load()
print("analytic N =", len(df), "| Efficacy:", dict(df['Efficacy'].value_counts()))
print("Age: n=%d min=%.1f max=%.1f mean=%.2f sd=%.2f"
      % (df['Age'].notna().sum(), df['Age'].min(), df['Age'].max(), df['Age'].mean(), df['Age'].std()))

orr = df['Efficacy'].isin(['CR', 'PR']).astype(int)   # PRIMARY
dcr = df['Efficacy'].isin(['CR', 'PR', 'SD']).astype(int)  # SENSITIVITY

print("\nMean age by outcome group (ORR primary):")
print(df.assign(response=orr).groupby('response')['Age'].agg(['count', 'mean', 'std']).round(4).to_string())
print("mean age PR=%.4f | SD=%.4f | PD=%.4f" % tuple(
    df.loc[df['Efficacy'] == c, 'Age'].mean() for c in ['PR', 'SD', 'PD']))

m_orr, tbl_orr = fit(df, orr, 'PRIMARY: ORR (CR+PR=1) ~ Age, unadjusted')
m_dcr, tbl_dcr = fit(df, dcr, 'SENSITIVITY (NOT the answer): DCR (CR+PR+SD=1) ~ Age')

b1 = m_orr.params['Age']
print("\n---------------- ANSWER ----------------")
print("Age coefficient (log-odds per year, ORR coding): %.6f  (OR per year = %.6f)"
      % (b1, np.exp(b1)))
print("Intercept: %.6f" % m_orr.params['const'])
print("SE(b1)=%.6f  z=%.4f  p=%.6g  95%% CI=[%.6f, %.6f]  n=%d"
      % (m_orr.bse['Age'], m_orr.tvalues['Age'], m_orr.pvalues['Age'],
         m_orr.conf_int().loc['Age', 0], m_orr.conf_int().loc['Age', 1], int(m_orr.nobs)))
print("SENSITIVITY line -> DCR coding age coefficient = %.6f (OR=%.4f, p=%.4g)"
      % (m_dcr.params['Age'], np.exp(m_dcr.params['Age']), m_dcr.pvalues['Age']))
