"""Grounding pass for bix-51-q8: inspect data/data.xlsx (Sheet1) before modeling.
No model fitting here -- schema, encoding, and data-quality checks only."""
import pandas as pd, numpy as np

XL = 'data/data.xlsx'
raw = pd.read_excel(XL, 'Sheet1')
print('== raw shape ==', raw.shape)
print('\n== dtypes ==\n', raw.dtypes.to_string())

# structural junk: un-named trailing columns and fully blank rows
blank_cols = [c for c in raw.columns if str(c).startswith('Unnamed')]
allblank = raw.isna().all(axis=1)
print('\nblank trailing columns in DataFrame:', blank_cols)
print('fully blank rows kept by pandas:', int(allblank.sum()))
df = raw[~allblank].copy()
# a stray final row contains only a whitespace Age cell -> drop rows with no Efficacy
df = df[df['Efficacy'].notna()].copy()
print('analytic rows:', len(df), '| Sequence 1..', int(df['Sequence number'].max()),
      '| dup seq:', int(df['Sequence number'].duplicated().sum()),
      '| dup full rows:', int(df.duplicated().sum()))

# Efficacy encoding
eff = df['Efficacy'].astype(str).str.strip().str.upper()
print('\nEfficacy raw repr uniques:', sorted({repr(x) for x in raw['Efficacy'].dropna().unique()}))
print('\nEfficacy value counts:\n', eff.value_counts().to_string())
print('\nGroups x Efficacy:\n', pd.crosstab(df['Groups'], eff, margins=True).to_string())

# candidate codings
orr = eff.isin(['CR', 'PR'])                 # ORR: objective response
dcr = eff.isin(['CR', 'PR', 'SD'])           # DCR: disease control
print('\nORR coding (CR+PR=1):', dict(orr.value_counts()))
print('DCR coding (CR+PR+SD=1):', dict(dcr.value_counts()))

# Age hygiene
age_raw = df['Age']
print('\nAge cell python types:', {type(x).__name__ for x in age_raw})
age = pd.to_numeric(age_raw.astype(str).str.strip(), errors='coerce')
print('non-numeric/blank Age cells:', [repr(v) for v in age_raw[age.isna()]])
print('Age n=%d min=%.1f max=%.1f mean=%.2f sd=%.2f median=%.1f' %
      (age.notna().sum(), age.min(), age.max(), age.mean(), age.std(), age.median()))
print('implausible ages (<18 or >100):', age[(age < 18) | (age > 100)].tolist())
print('non-integer ages:', age[age % 1 != 0].tolist())
print('\nAge by Efficacy category:\n', df.assign(age=age).groupby(eff)['age'].agg(['count','mean','std','min','max']).round(2).to_string())
print('\nAge by candidate outcome (ORR):\n', df.assign(age=age).groupby(orr)['age'].agg(['count','mean','std']).round(2).to_string())
print('\nmissing counts (analytic rows):\n', df.isna().sum().to_string())
