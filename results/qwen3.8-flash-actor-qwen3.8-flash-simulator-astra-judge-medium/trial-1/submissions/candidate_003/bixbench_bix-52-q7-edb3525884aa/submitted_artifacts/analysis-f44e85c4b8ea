#!/usr/bin/env python3
"""
bix-52-q7: How many sites are removed when filtering sites that do not show
>90% or <10% methylation in Zebra Finch?

Reproducible from scratch. No joins with JD_* or *_Chromosome_Length files
(verified irrelevant to this filter step: zero Pos overlap with JD; length
tables identical and not needed here).

Headline reading (researcher-approved, recorded as an assumption, not a fact):
  - one row = one site measurement; "sites" = rows of the table;
  - keep rule: (MethylationPercentage > 90) | (MethylationPercentage < 10)  [strict];
  - removed = rows failing the keep rule (values in the 10-90 mid-range).
Sensitivity: inclusive bounds (>=90 / <=10) and site-level deduplicated counts.
"""
import pandas as pd

PATH = "data/ZF_AgeRelated_CpG_noMT_Final.csv"

zf = pd.read_csv(PATH, dtype={"Chromosome": str})
n_rows = len(zf)
n_sites = zf["Pos"].nunique()

mp = zf["MethylationPercentage"]
keep_strict = (mp > 90) | (mp < 10)
keep_incl = (mp >= 90) | (mp <= 10)

# ---------- sanity checks ----------
assert zf["Pos"].equals(zf["Chromosome"] + "_" + zf["StartPosition"].astype(str))
assert zf["MethylationPercentage"].between(0, 100).all(), "MP not on 0-100 scale"
assert (zf["Coverage"] == zf["CountMethylated"] + zf["CountNonMethylated"]).all()
assert zf["Coverage"].min() >= 1, "zero-coverage rows present"
assert zf.isna().sum().sum() == 0, "missing values present"
assert zf.duplicated(subset=["Pos", "Sample"]).sum() == 0

# ---------- counts table ----------
rows_removed_strict = int((~keep_strict).sum()); rows_kept_strict = int(keep_strict.sum())
rows_removed_incl = int((~keep_incl).sum());     rows_kept_incl = int(keep_incl.sum())

tmp = zf.assign(_ks=keep_strict, _ki=keep_incl)
site_keep = tmp.groupby("Pos").agg(_ks=("_ks", "any"), _ki=("_ki", "any"))
sites_removed_strict = int((~site_keep["_ks"]).sum()); sites_kept_strict = int(site_keep["_ks"].sum())
sites_removed_incl = int((~site_keep["_ki"]).sum());   sites_kept_incl = int(site_keep["_ki"].sum())

print("=" * 78)
print("FILTER COUNTS (ZF_AgeRelated_CpG_noMT_Final.csv)")
print("=" * 78)
tab = pd.DataFrame(
    [["ROW-LEVEL  strict (>90/<10)",   rows_removed_strict, rows_kept_strict, n_rows],
     ["ROW-LEVEL  inclusive (>=90/<=10)", rows_removed_incl, rows_kept_incl, n_rows],
     ["SITE-LEVEL strict (site kept if ANY obs extreme)", sites_removed_strict, sites_kept_strict, n_sites],
     ["SITE-LEVEL inclusive",          sites_removed_incl,  sites_kept_incl,  n_sites]],
    columns=["reading", "removed", "kept", "total"])
print(tab.to_string(index=False))

# ---------- self-audit: removed + kept == total ----------
print("\nSelf-audit (removed + kept == total):")
for name, rem, kept, tot in [
    ("rows/strict", rows_removed_strict, rows_kept_strict, n_rows),
    ("rows/inclusive", rows_removed_incl, rows_kept_incl, n_rows),
    ("sites/strict", sites_removed_strict, sites_kept_strict, n_sites),
    ("sites/inclusive", sites_removed_incl, sites_kept_incl, n_sites)]:
    print(f"  {name:16s}: {rem} + {kept} = {rem + kept}  (total {tot})  -> {'OK' if rem + kept == tot else 'FAIL'}")
    assert rem + kept == tot

# ---------- boundary rows (source of the strict-vs-inclusive gap) ----------
n_bound = int(((mp == 10) | (mp == 90)).sum())
print(f"\nRows exactly on a boundary (MP == 10 or MP == 90): {n_bound}")
print(f"  -> explains row gap {rows_removed_strict - rows_removed_incl} and "
      f"site gap {sites_removed_strict - sites_removed_incl}")

# ---------- coverage caveat: trivially 'extreme' low-coverage rows ----------
kept_df = zf[keep_strict]
low5 = kept_df["Coverage"] <= 5
low3 = kept_df["Coverage"] <= 3
print("\nCoverage caveat (kept rows, strict rule):")
print(f"  kept rows total:            {len(kept_df)}")
print(f"  kept rows with Coverage<=5: {int(low5.sum())}  ({100*low5.mean():.1f}%)")
print(f"  kept rows with Coverage<=3: {int(low3.sum())}  ({100*low3.mean():.1f}%)")

# sites whose ONLY extreme (kept) observations come from Coverage<=5 rows
site_ext = tmp[keep_strict].groupby("Pos").agg(
    n_ext=("Coverage", "size"),
    n_ext_lowcov=("Coverage", lambda c: int((c <= 5).sum())))
only_lowcov = site_ext[(site_ext["n_ext"] == site_ext["n_ext_lowcov"]) & (site_ext["n_ext"] > 0)]
print(f"  sites kept ONLY thanks to Coverage<=5 extreme rows: {len(only_lowcov)} "
      f"of {sites_kept_strict} kept sites")
# and note: low-coverage rows are removed, not kept, under the mid-range rule
mid_lowcov = int(((~keep_strict) & (zf['Coverage'] <= 5)).sum())
print(f"  (context) removed rows with Coverage<=5: {mid_lowcov}")

print("\nHEADLINE (row-level, strict): removed = "
      f"{rows_removed_strict}  (kept {rows_kept_strict} of {n_rows} rows)")
print(f"SITE-LEVEL sensitivity: removed = {sites_removed_strict} of {n_sites} unique positions")
