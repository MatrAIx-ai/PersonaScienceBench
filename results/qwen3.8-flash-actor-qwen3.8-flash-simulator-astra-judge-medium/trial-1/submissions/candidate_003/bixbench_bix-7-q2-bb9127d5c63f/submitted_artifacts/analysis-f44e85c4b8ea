"""bix-7-q2: Average number of CHIP variants per sample after filtering out
intronic, intergenic and UTR variants.

Rules (fixed by researcher, 2026-10-22):
1. Main filter is literal on the SO term:
   - term contains 'intron' (ci)     -> drop  (intron_variant)
   - term contains 'intergenic' (ci) -> drop  (no such term in data; branch never fires)
   - term contains 'utr' (ci)        -> drop  (3_prime_UTR_variant, 5_prime_UTR_variant,
                                              5_prime_UTR_premature_start_codon_gain_variant)
   Everything else KEPT, incl. splice_region_variant, synonymous_variant,
   missense_variant, frameshift_variant, inframe_insertion, inframe_deletion,
   upstream_gene_variant (formal-term rule; upstream is neither intronic nor
   intergenic nor UTR -> KEPT; effect of this decision: +3 variants total, ~+0.03).
2. Variant = row with Zygosity in {Heterozygous, Homozygous Variant}; 'Reference'
   and NaN are NOT variants.
3. Full-row duplicates dropped; with/without-dedup difference reported.
4. All 86 samples in the denominator; Trio_Status NOT used ('per sample').
"""
import glob
import re

import pandas as pd

FILES = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
assert len(FILES) == 86, len(FILES)

VARIANT_ZYGOSITY = {"Heterozygous", "Homozygous Variant"}


def so_is_dropped(term: str) -> bool:
    t = str(term).lower()
    return ("intron" in t) or ("intergenic" in t) or ("utr" in t)


rows = []
dedup_diff_total = 0
drop_category = {"intron": 0, "intergenic": 0, "utr": 0}
nonref_total = 0
check_problems = []

for f in FILES:
    df = pd.read_excel(f, header=[0, 1])
    file_nonref = 0
    file_drop = {"intron": 0, "intergenic": 0, "utr": 0}
    # structural checks: exactly one Zygosity column; filename sample id inside level-0 block
    zcols = [c for c in df.columns if c[1] == "Zygosity"]
    scol = [c for c in df.columns if c[1] == "Sequence Ontology (Combined)"][0]
    if len(zcols) != 1:
        check_problems.append((f, f"Zygosity columns = {len(zcols)}"))
    zc = zcols[0]
    sample = re.search(r"CHIP_(.+)\.xlsx$", f.split("/")[-1]).group(1)
    if sample not in str(zc[0]):
        check_problems.append((f, f"sample '{sample}' not in block '{zc[0]}'"))

    n_all = len(df)
    df_nd = df
    df = df.drop_duplicates()
    dedup_diff_total += n_all - len(df)

    for tag, d in (("nodedup", df_nd), ("dedup", df)):
        nonref = d[d[zc].isin(VARIANT_ZYGOSITY)]
        kept_mask = ~nonref[scol].astype(str).map(so_is_dropped)
        if tag == "dedup":
            file_nonref = len(nonref)
            for t in nonref[scol].astype(str):
                tl = t.lower()
                if "intron" in tl:
                    file_drop["intron"] += 1
                elif "intergenic" in tl:
                    file_drop["intergenic"] += 1
                elif "utr" in tl:
                    file_drop["utr"] += 1
            nonref_total += file_nonref
            for k in drop_category:
                drop_category[k] += file_drop[k]
            kept_d = int(kept_mask.sum())
        else:
            kept_nd = int(kept_mask.sum())

    rows.append({"sample": sample, "file": f.split("/")[-1], "n_rows": n_all,
                 "n_nonref": len(nonref), "n_kept": kept_d, "n_kept_nodedup": kept_nd})

per = pd.DataFrame(rows)
per.to_csv("analysis/per_sample_counts.csv", index=False)

total = int(per["n_kept"].sum())
total_nd = int(per["n_kept_nodedup"].sum())
print("=== STRUCTURAL CHECKS ===")
print("files:", len(FILES), "| problems (multi-Zygosity / name mismatch):",
      check_problems if check_problems else "NONE (all 86 OK)")

print("\n=== MAIN RESULT ===")
print(f"total CHIP variants kept: {total} (dedup) | {total_nd} (no dedup; dedup diff = {total_nd - total})")
print(f"AVERAGE per sample: {total/86:.2f}  (= {total}/86)   [no-dedup: {total_nd/86:.2f}]")

print("\n=== DISTRIBUTION OVER 86 SAMPLES (dedup) ===")
print(per["n_kept"].describe().round(3).to_string())
print("SD:", round(per["n_kept"].std(), 3))
print("min 3:\n" + per.nsmallest(3, "n_kept")[["sample", "n_kept"]].to_string(index=False))
print("max 3:\n" + per.nlargest(3, "n_kept")[["sample", "n_kept"]].to_string(index=False))

print("\n=== DROPPED BY FILTER CATEGORY (base = non-Reference rows, dedup) ===")
print(f"base non-Reference: {nonref_total}")
for k, v in drop_category.items():
    print(f"  dropped '{k}': {v}")
print(f"kept = {nonref_total} - {sum(drop_category.values())} = {nonref_total - sum(drop_category.values())}  (check == {total})")

print("\n=== SENSITIVITY (appendix; main answer is scenario MAIN) ===")
def scen(name, fn):
    s = 0
    for f in FILES:
        df = pd.read_excel(f, header=[0, 1]).drop_duplicates()
        z = [c for c in df.columns if c[1] == "Zygosity"][0]
        so = [c for c in df.columns if c[1] == "Sequence Ontology (Combined)"][0]
        nr = df[df[z].isin(VARIANT_ZYGOSITY)]
        s += int(fn(nr[so].astype(str)).sum())
    print(f"{name}: total={s}, mean={s/86:.2f}")

scen("MAIN  drop intron/intergenic/UTR substrings (keep upstream, splice)", main_rule := (lambda t: ~t.map(so_is_dropped)))
scen("ALT-1 additionally drop splice_region_variant                     ", lambda t: (~t.map(so_is_dropped)) & (t != "splice_region_variant"))
scen("ALT-2 keep 5'UTR premature-start (exact UTR terms only)           ", lambda t: ~t.isin(["intron_variant", "3_prime_UTR_variant", "5_prime_UTR_variant"]))
scen("ALT-3 additionally drop upstream_gene_variant                     ", lambda t: (~t.map(so_is_dropped)) & (t != "upstream_gene_variant"))
scen("ALT-4 strict protein-coding-only (DIFFERENT QUESTION, not a variant)", lambda t: t.isin(["missense_variant", "stop_gained", "frameshift_variant", "inframe_insertion", "inframe_deletion", "protein_altering_variant", "start_lost", "stop_lost"]))

print("\nNote: restricting denominator to probands/children only (via 230215_Trio_Status.xlsx)")
print("would change the number; question says 'per sample' -> all 86 files counted.")
