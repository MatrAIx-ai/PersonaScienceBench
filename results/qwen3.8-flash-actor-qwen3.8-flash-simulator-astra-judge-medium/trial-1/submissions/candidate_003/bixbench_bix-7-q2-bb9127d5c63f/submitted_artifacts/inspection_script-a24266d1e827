"""Inspection script for bix-7-q2: CHIP variants per sample.

Scans all files in data/CHIP_DP10_GQ20_PASS, reports:
- file count, per-file row counts, empty/header-only files
- columns (two-row header)
- Zygosity value counts (esp. 'Reference')
- Sequence Ontology (Combined) value counts incl. multi-term (pipe-separated) values
- duplicate rows
Also inspects the two auxiliary xlsx files.
"""
import glob
from collections import Counter

import pandas as pd

files = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
print("N files:", len(files))

zyg_counter = Counter()
so_counter = Counter()
rowcounts = {}
empty_files = []
dup_info = {}
multi_terms = Counter()
colsets = Counter()

for f in files:
    df = pd.read_excel(f, header=[0, 1])
    rowcounts[f] = len(df)
    if len(df) == 0:
        empty_files.append(f)
        continue
    colsets[tuple(df.columns)] += 1
    zyg = df[("Proband", "Zygosity")] if ("Proband", "Zygosity") in df.columns else None
    # zygosity column name varies (sample name in level 0) -> find by level-1 name
    zcol = None
    socol = None
    for c in df.columns:
        if c[1] == "Zygosity":
            zcol = c
        if c[1] == "Sequence Ontology (Combined)":
            socol = c
    zyg_counter.update(df[zcol].astype(str).value_counts().to_dict())
    so_series = df[socol].astype(str)
    so_counter.update(so_series.value_counts().to_dict())
    for v in so_series:
        for term in v.split("|"):
            multi_terms[term] += 1
    # full-row duplicates
    ndup = int(df.duplicated().sum())
    if ndup:
        dup_info[f] = ndup

print("\n--- row counts ---")
rc = pd.Series(rowcounts)
print(rc.describe())
print("min files:", rc.sort_values().head(8).to_dict())
print("empty/header-only files:", empty_files)
print("files with identical full-row duplicates:", dup_info)
print("distinct column layouts:", len(colsets))

print("\n--- Zygosity values ---")
for k, v in zyg_counter.most_common():
    print(f"{k!r}: {v}")

print("\n--- Sequence Ontology (Combined) exact values (top 40) ---")
for k, v in so_counter.most_common(40):
    print(f"{k!r}: {v}")
print("total distinct exact SO strings:", len(so_counter))

print("\n--- individual SO terms after splitting on '|' (top 60) ---")
for k, v in multi_terms.most_common(60):
    print(f"{k!r}: {v}")
print("total distinct single SO terms:", len(multi_terms))

npipe = {k: v for k, v in so_counter.items() if "|" in k}
print("\nmulti-SO (contains '|') distinct values:", len(npipe), "total rows:", sum(npipe.values()))
for k, v in sorted(npipe.items(), key=lambda x: -x[1])[:20]:
    print(f"{k!r}: {v}")

print("\n=== Auxiliary files ===")
for aux in ["data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx", "data/230215_Trio_Status.xlsx"]:
    print("\n#", aux)
    xl = pd.ExcelFile(aux)
    print("sheets:", xl.sheet_names)
    for s in xl.sheet_names:
        d = pd.read_excel(aux, sheet_name=s)
        print(f"sheet {s!r}: shape={d.shape}")
        print(d.head(8).to_string())
