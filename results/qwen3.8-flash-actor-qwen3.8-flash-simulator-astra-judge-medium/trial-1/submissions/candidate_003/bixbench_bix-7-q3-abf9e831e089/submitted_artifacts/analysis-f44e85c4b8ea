"""CHIP variant-call census: how many CHIP variants remain after removing reference calls.

Main metric (fixed by researcher): one row = one variant x sample CALL.
Reference call = Zygosity == "Reference"; empty Zygosity = no call at all (not an outcome).
Primary answer = number of non-empty ALTERNATIVE calls (Heterozygous + Homozygous Variant)
across all 86 sample files. Sensitivities reported separately.
No extra QC thresholds, no re-filtering by the Schenz gene list (In_CHIP already True).
"""
import glob, os, re
import pandas as pd

VARIANT_DIR = "data/CHIP_DP10_GQ20_PASS"
GENE_LIST = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
TRIO_LIST = "data/230215_Trio_Status.xlsx"
ALT_LABELS = ["heterozygous", "homozygous variant"]
ALLOWED = set(ALT_LABELS) | {"reference", ""}

def norm_zyg(v):
    if v is None or (isinstance(v, float) and pd.isna(v)):
        return ""
    return re.sub(r"\s+", " ", str(v)).strip().lower()

files = sorted(glob.glob(os.path.join(VARIANT_DIR, "*.xlsx")))
assert files, f"no inputs under {VARIANT_DIR}"

frames, audit = [], []
for f in files:
    sname = re.sub(r"^230209_Exome_GRCh38_CHIP_", "", os.path.basename(f)).replace(".xlsx", "")
    raw = pd.read_excel(f, sheet_name=0, header=None)
    grp_cell = raw.iat[0, 4]                       # grouping row, sample block header
    m = re.match(r"^\s*(\w+)\s*\((.+?)\)\s*$", str(grp_cell)) if isinstance(grp_cell, str) else None
    role_hdr, id_hdr = (m.group(1), m.group(2)) if m else ("", "")
    df = pd.read_excel(f, sheet_name=0, header=1)  # real column names on row 2
    df = df[["Chr:Pos", "Ref/Alt", "Gene Names", "Zygosity",
             "Read Depths (DP)", "Genotype Qualities (GQ)"]].copy()
    df["sample_file"] = sname
    df["Zy"] = df["Zygosity"].map(norm_zyg)
    frames.append(df)
    audit.append({"sample_file": sname, "id_from_header": id_hdr, "role_from_header": role_hdr,
                  "id_match": id_hdr == sname, "n_rows": len(df), "sheet": " ".join(
                      str(x) for x in pd.ExcelFile(f).sheet_names)})

A = pd.concat(frames, ignore_index=True)
ad = pd.DataFrame(audit)

print("=" * 78)
print("INPUTS: %d sample files (%s)" % (len(files), os.path.abspath(VARIANT_DIR)))
print("Total rows = variant x sample calls :", len(A))
print("\n[1] HEADER vs FILENAME sample-id cross-check")
print("    mismatches:", int((~ad.id_match).sum()),
      "->", ad.loc[~ad.id_match, ["sample_file", "id_from_header"]].to_dict("records"))
print("    roles in grouping row:", ad.role_from_header.value_counts().to_dict())

print("\n[2] Normalised Zygosity vocabulary (strip + lower)")
vocab = A["Zy"].value_counts(dropna=False)
print(vocab.to_string())
extra = sorted(set(A["Zy"]) - ALLOWED)
print("    unexpected values outside {reference, heterozygous, homozygous variant, ''}:", extra or "none")

is_ref = A.Zy.eq("reference")
is_alt = A.Zy.isin(ALT_LABELS)
is_no  = A.Zy.eq("")

print("\n[3] PER-FILE SUMMARY (rows / reference / het / hom / no-call)")
per = (A.assign(het=A.Zy.eq("heterozygous"), hom=A.Zy.eq("homozygous variant"),
                ref=is_ref, nocall=is_no)
         .groupby("sample_file", as_index=False)[["ref", "het", "hom", "nocall"]]
         .sum().sort_values("sample_file"))
per.insert(0, "rows", A.groupby("sample_file").size().reindex(per.sample_file).values)
pd.set_option("display.max_rows", 200, "display.width", 200)
print(per.to_string(index=False))
print("    TOTALS:", {c: int(per[c].sum()) for c in ["rows", "ref", "het", "hom", "nocall"]})

main = int(is_alt.sum())
print("\n" + "=" * 78)
print("PRIMARY ANSWER  (variant x sample CALLS kept after dropping reference calls)")
print("  Heterozygous        :", int(A.Zy.eq('heterozygous').sum()))
print("  Homozygous Variant  :", int(A.Zy.eq('homozygous variant').sum()))
print("  TOTAL ALT CALLS     :", main)
print("=" * 78)

print("\n[4] SENSITIVITIES")
naive = int((~is_ref).sum())
print("  (a) naive row-level df[Zygosity != 'Reference'] :", naive,
      "= alt calls %d + no-call %d  <- NaN/no-call rows leak in" % (main, int(is_no.sum())))
alt = A[is_alt]
print("  (b) unique variants with >=1 alt call: Chr:Pos = %d ; Chr:Pos+Ref/Alt = %d"
      % (alt["Chr:Pos"].nunique(), alt[["Chr:Pos", "Ref/Alt"]].drop_duplicates().shape[0]))
print("      (unique positions in whole table = %d ; reference-in-every-sample = %d)"
      % (A["Chr:Pos"].nunique(), A["Chr:Pos"].nunique() - alt["Chr:Pos"].nunique()))

ts = pd.read_excel(TRIO_LIST)
ts.columns = [str(c).strip() for c in ts.columns]
for c in ("Sample ID", "Status"):
    ts[c] = ts[c].astype(str).str.strip()
A["base_id"] = A["sample_file"].str.replace(r"-(P\d*|PM|PF|F|M)$", "", regex=True)
A = A.merge(ts[["Sample ID", "Status"]], left_on="base_id", right_on="Sample ID", how="left")
print("      Sample-ID mapping after strip(): files without trio record =",
      sorted(A.loc[A.Status.isna(), "sample_file"].unique().tolist()) or "none")
print("      Trio_Status IDs without a variant file =",
      sorted(set(ts["Sample ID"]) - set(A["base_id"])) or "none")
pb = A[A.Status.eq("Patient")]
print("      alt rows that share one (sample, Chr:Pos) = %d duplicate multi-allelic rows "
      "-> unique (sample, locus) alt pairs = %d"
      % (len(alt) - alt[["sample_file", "Chr:Pos"]].drop_duplicates().shape[0],
         alt[["sample_file", "Chr:Pos"]].drop_duplicates().shape[0]))
print("  (c) probands only (Trio Status == Patient, %d files): alt calls = %d ; unique Chr:Pos = %d"
      % (pb["sample_file"].nunique(), int(pb.Zy.isin(ALT_LABELS).sum()),
         pb.loc[pb.Zy.isin(ALT_LABELS), "Chr:Pos"].nunique()))

degen = ["380-P", "381-PM"]
for s in degen:
    sub = A[A.sample_file.eq(s)]
    print("      %s: rows=%d ref=%d het=%d hom=%d NO-CALL=%d (%.0f%% of rows)"
          % (s, len(sub), int(sub.Zy.eq('reference').sum()), int(sub.Zy.eq('heterozygous').sum()),
             int(sub.Zy.eq('homozygous variant').sum()), int(sub.Zy.eq('').sum()),
             100 * sub.Zy.eq('').mean()))
ex = A[~A.sample_file.isin(degen)]
print("  (d) excluding 380-P/381-PM: alt calls = %d (delta %d) ; unique Chr:Pos = %d"
      % (int(ex.Zy.isin(ALT_LABELS).sum()), main - int(ex.Zy.isin(ALT_LABELS).sum()),
         ex.loc[ex.Zy.isin(ALT_LABELS), "Chr:Pos"].nunique()))

genes = pd.read_excel(GENE_LIST, header=None)[0].dropna().astype(str).str.strip().tolist()
present = set()
for g in A["Gene Names"].dropna():
    present |= {x.strip() for x in re.split(r"[,/]", str(g)) if x.strip()}
print("\n[5] NOTE (no re-filtering applied): gene list n=%d ; symbols seen in files=%d ; "
      "in files but not in list=%s ; in list but not in files=%s"
      % (len(genes), len(present), sorted(present - set(genes)), sorted(set(genes) - present)))
print("    In_CHIP value counts:", pd.read_excel(files[0], sheet_name=0, header=1)["In_CHIP"]
      .value_counts(dropna=False).to_dict(), "(filter already applied upstream)")

per.to_csv("per_file_summary.csv", index=False)
print("\nper-file summary written to per_file_summary.csv")
