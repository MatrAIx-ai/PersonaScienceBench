"""bix-8-q5: statistical test of independence between m6A methylation status and
differential expression status (bladder cancer).

PRIMARY (the answer): Pearson chi-square, correction=False, on the collapsed 2x2
contingency table built from ALL 12754 rows of data/MeRIP_RNA_result.xlsx,
sheet "Date Formatting" (row-level unit of observation, no deduplication by GeneID).
Collapse: m6A {Hyper, Hypo} -> m6A_diff vs "m6A no sig";
          DEG {Up, Down}     -> DEG       vs "no-DEGs".
Everything else (Yates, Fisher, 3x3, 2x3, ENST-level, ENSG-level) is
SENSITIVITY, NOT THE ANSWER.
Run: python3 analysis/m6a_deg_independence.py
"""
import numpy as np
import pandas as pd
from scipy import stats

XLSX, SHEET = "data/MeRIP_RNA_result.xlsx", "Date Formatting"
df = pd.read_excel(XLSX, sheet_name=SHEET)

def sci3(p):  # 3-digit mantissa, lowercase 'e', e.g. 2.951e-72
    return f"{p:.3e}".replace("e-0", "e-").replace("e+", "e")

# ---------------------------------------------------------------- sanity asserts
assert len(df) == 12754, len(df)
assert df[["m6A", "DEG", "m6A_DEG"]].isna().sum().sum() == 0
assert set(df.m6A.unique()) == {"m6A Hyper", "m6A Hypo", "m6A no sig"}, df.m6A.unique()
assert set(df.DEG.unique()) == {"Up", "Down", "no-DEGs"}, df.DEG.unique()
# m6A_DEG is exactly reproducible from m6A + DEG -> used only as a self-check
assert ((df.m6A + " and " + df.DEG) == df.m6A_DEG).all()

vc_m6A, vc_DEG = df.m6A.value_counts(), df.DEG.value_counts()
assert int(vc_m6A["m6A no sig"]) == 11563 and int(vc_m6A["m6A Hyper"]) == 680 \
       and int(vc_m6A["m6A Hypo"]) == 511, vc_m6A.to_dict()
assert int(vc_DEG["no-DEGs"]) == 11791 and int(vc_DEG["Up"]) == 548 \
       and int(vc_DEG["Down"]) == 415, vc_DEG.to_dict()

m6 = pd.Series(np.where(df.m6A != "m6A no sig", "m6A_diff", "m6A_nosig"), name="m6A")
de = pd.Series(np.where(df.DEG != "no-DEGs", "DEG", "no-DEGs"), name="DEG")
tab = pd.crosstab(m6, de)

# ------------------------------------------------------------------- (1) PRIMARY
chi2, p, dof, exp = stats.chi2_contingency(tab, correction=False)
exp_tab = pd.DataFrame(exp, index=tab.index, columns=tab.columns)

print("=" * 78)
print("PRIMARY TEST (the answer) - Pearson chi-square, correction=False")
print("=" * 78)
print("source:", XLSX, "| sheet:", SHEET, "| unit of observation: table row")
print("n =", int(tab.values.sum()))
print("observed 2x2 contingency table:")
print(tab.to_string())
print("all 4 expected frequencies:")
print(exp_tab.to_string(float_format=lambda v: f"{v:.4f}"))
print(f"minimum expected frequency = {exp.min():.4f}")
print(f"cells with expected < 5 = {int((exp < 5).sum())} "
      f"(cells with expected < 1 = {int((exp < 1).sum())})")
print(f"test = Pearson chi-square (no continuity correction)")
print(f"chi2 = {chi2:.6f}   df = {dof}")
print(f"p (full precision) = {float(p):.17g}")
p = float(p)
print(f"p (answer, 3-digit mantissa) = {sci3(p)}")

# ------------------------------------------------------------- (2) arithmetic asserts
assert int(tab.values.sum()) == 12754
assert tab.loc["m6A_diff"].sum() + tab.loc["m6A_nosig"].sum() == 12754
assert tab.loc["m6A_diff"].sum() == 680 + 511 == 1191, tab.loc["m6A_diff"].tolist()
assert tab.loc["m6A_nosig"].sum() == 11563, tab.loc["m6A_nosig"].tolist()
assert tab["DEG"].sum() == 548 + 415 == 963, tab["DEG"].tolist()
assert tab["no-DEGs"].sum() == 11791, tab["no-DEGs"].tolist()
assert np.allclose(tab.values.sum(), np.asarray(exp).sum())
assert (tab.values.ravel() == np.array([246, 945, 717, 10846])).all(), tab.values.tolist()
# independent check: 3x3 marginals must reproduce the same collapsed 2x2
raw33 = pd.crosstab(df.m6A, df.DEG)
assert raw33.loc[["m6A Hyper", "m6A Hypo"], ["Up", "Down"]].values.sum() == 246
assert raw33.loc[["m6A no sig"], ["Up", "Down"]].values.sum() == 717
print("\n[asserts passed] cell sum = 12754; marginals 1191 / 11563 and 963 / 11791; "
      "collapsed table reproduced from the 3x3; m6A_DEG consistent for all 12754 rows")

# ------------------------------------------------------- (3) SENSITIVITY, NOT ANSWER
print("\n" + "=" * 78)
print("SENSITIVITY ANALYSES - NOT THE ANSWER")
print("=" * 78)

def line(name, t, correction=False, fisher=False):
    c, pv, d, e = stats.chi2_contingency(t, correction=correction)
    s = (f"{name}: n={int(t.values.sum())} shape={t.shape} "
         f"minE={e.min():.4f} cellsE<5={int((e < 5).sum())} "
         f"chi2={c:.6g} df={d} p={pv:.6g} [{sci3(pv)}]")
    if fisher:
        fo, fp = stats.fisher_exact(t)
        s += f" | Fisher OR={fo:.4f} p={fp:.6g} [{sci3(fp)}]"
    print(s)
    return t

tab_y = line("Yates continuity correction (log-only; NOT the answer)", tab,
             correction=True, fisher=True)
t33 = line("3x3 raw m6A x DEG", raw33)
t23 = line("2x3 collapsed m6A x raw DEG", pd.crosstab(m6, df.DEG))
print(t33.to_string())
print(t23.to_string())

def collapse_any(s):
    return "m6A_diff" if (s != "m6A no sig").any() else "m6A_nosig"
for key, label in [("GeneID", "ENST transcript/gene-level (any-diff collapse)"),
                   ("gene_id", "ENSG gene-level (any-diff collapse)")]:
    gl = df.groupby(key).agg(m6A=("m6A", collapse_any),
                             DEG=("DEG", lambda s: "DEG" if (s != "no-DEGs").any() else "no-DEGs"))
    t = line(label + " -> SENSITIVITY, not the answer", pd.crosstab(gl.m6A, gl.DEG), fisher=True)
    print(t.to_string())

# ----------------------------------------------------------- (4) proteomics: excluded
print("\nProteomic_data .xlsx (sheet 'Tumor vs Normal') NOT USED: it carries no m6A "
      "feature (no m6A column) and its Entrez gene_id keys overlap the MeRIP ENSG ids "
      "0/3850, so it cannot contribute to an m6A-vs-DEG independence test.")

print(f"\nFINAL ANSWER (from the PRIMARY block above only): p = {sci3(p)} "
      f"(full precision {p:.6e}; chi2={chi2:.6g}, df={dof}, n=12754, minE={exp.min():.2f})")
