"""Input inspection for bix-8-q5 (m6A vs DEG independence, bladder cancer).
Run: python3 analysis/inspect_inputs.py
Prints only structural facts (shape, labels, missingness, duplicates, cross-source
consistency, and the candidate contingency tables + minimum expected frequencies
needed to justify the choice of test). No final answer is chosen here.
"""
import pandas as pd, numpy as np
from scipy import stats

M = "data/MeRIP_RNA_result.xlsx"; SHEET = "Date Formatting"
P = "data/Proteomic_data .xlsx";   PSHEET = "Tumor vs Normal"

df = pd.read_excel(M, sheet_name=SHEET)
print("=" * 70); print("MeRIP sheet:", SHEET, "shape:", df.shape)
print("columns:", list(df.columns))
print("all-NaN rows:", int(df.isna().all(axis=1).sum()),
      "| rows with any NaN:", int(df.isna().any(axis=1).sum()))
for c in df.columns:
    s = df[c].astype("string")
    blank = int((s.str.strip().fillna("") == "").sum())
    print(f"  {c:12s} dtype={str(df[c].dtype):8s} null={int(df[c].isna().sum()):5d} "
          f"blank-after-strip={blank:5d} nunique={df[c].nunique()}")

for col in ["m6A", "DEG", "m6A_DEG"]:
    print(f"\n[{col}] value_counts(dropna=False):")
    print(df[col].value_counts(dropna=False).to_string())

print("\nGeneID: unique =", df.GeneID.nunique(), "of", len(df),
      "| extra rows from duplicated GeneID =", int(df.GeneID.duplicated().sum()))
g = df.groupby("GeneID")
print("GeneIDs with >1 distinct m6A label:", int(g.m6A.nunique().gt(1).sum()),
      "| with >1 distinct DEG label:", int(g.DEG.nunique().gt(1).sum()),
      "| with >1 distinct m_log2FC:", int(g.m_log2FC.nunique().gt(1).sum()))
print("ENSG (gene_id) unique:", df.gene_id.nunique())
lab = df.m6A + " and " + df.DEG
print("m6A_DEG reproduced from m6A+DEG for all rows:", bool((lab == df.m6A_DEG).all()))

print("\nraw 3x3 (m6A x DEG):")
print(pd.crosstab(df.m6A, df.DEG).to_string())

print("\n" + "=" * 70); print("Proteomic sheet:", PSHEET)
pr = pd.read_excel(P, sheet_name=PSHEET)
print("shape:", pr.shape, "| columns:", list(pr.columns))
print("has m6A column:", any("m6a" in str(c).lower() for c in pr.columns),
      "| is_sig counts:", pr.is_sig.value_counts(dropna=False).to_dict())
print("empty junk columns:", [c for c in pr.columns if pr[c].isna().all()])
print("ENSG-style ids present:", pr.gene_id.head(3).tolist(),
      "-> overlap with MeRIP ENSG n:", pr.gene_id.astype(str).isin(df.gene_id.astype(str)).sum())

print("\n" + "=" * 70); print("Candidate tables + expected-frequency check (test-choice justification)")
def rep(name, tab):
    chi2, p, dof, exp = stats.chi2_contingency(tab, correction=False)
    line = (f"{name}: shape={tab.shape} n={tab.values.sum()} minExpected={exp.min():.3f} "
            f"cellsExp<5={int((exp < 5).sum())} chi2={chi2:.6g} df={dof} p={p:.6g}")
    if tab.shape == (2, 2):
        fe = stats.fisher_exact(tab)
        line += f" | Fisher p={fe[1]:.6g} OR={fe[0]:.4f}"
    print(line)

m6 = np.where(df.m6A != "m6A no sig", "m6A_diff", "m6A_nosig")
de = np.where(df.DEG != "no-DEGs", "DEG", "no-DEG")
rep("A row-level 2x2", pd.crosstab(m6, de))
rep("B row-level 3x3", pd.crosstab(df.m6A, df.DEG))
rep("C 2x3 (m6A collapsed x DEG raw)", pd.crosstab(m6, df.DEG))
gl = df.groupby("GeneID").apply(lambda s: pd.Series(
    {"m6A": "m6A_diff" if (s.m6A != "m6A no sig").any() else "m6A_nosig",
     "DEG": "DEG" if (s.DEG != "no-DEGs").any() else "no-DEG"}), include_groups=False)
rep("D ENST-gene-level 2x2", pd.crosstab(gl.m6A, gl.DEG))
