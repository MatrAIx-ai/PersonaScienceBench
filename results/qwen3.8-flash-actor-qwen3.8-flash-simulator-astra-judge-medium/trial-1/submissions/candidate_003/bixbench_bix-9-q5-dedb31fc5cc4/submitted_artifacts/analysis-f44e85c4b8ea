# -*- coding: utf-8 -*-
"""
ФИНАЛЬНЫЙ АНАЛИЗ: в какой ткани у bad responders больше всего значимо
дифференциально-экспрессированных генов относительно контроля.

Критерий ответа (согласован с исследователем):
    padj < 0.05  И  log2FoldChange > 0.5  И  baseMean > 10
по выходам DESeq2 из листа `NormCount` файла data/Data_deposition_RNAseq_Paroxetine_2017.xlsx:
    Comparison 2 = baseline_blood  bad vs Control   Excel DD..DL  (0-based 107..115)
    Comparison 5 = dentate_gyrus   bad vs Control   Excel EE..EM  (134..142)
    Comparison 8 = final_blood     bad vs Control   Excel FF..FN  (161..169)
Знак log2FoldChange: положительный = выше у bad_responder (подтверждён в T2).
Вход: кэш work/normcount.npz (создан work/parse_fast.py); openpyxl не используется.
Выход: stdout + work/report_bad_vs_control.md
"""
import numpy as np, pandas as pd
from scipy import stats

NPZ, OUT = '/workspace/work/normcount.npz', '/workspace/work/report_bad_vs_control.md'
PADJ_T, LFC_T, BM_T = 0.05, 0.5, 10.0
FIELDS = ['baseMean', 'baseMeanA', 'baseMeanB', 'foldChange', 'log2FoldChange', 'pval', 'padj']
BLOCKS_BAD = {'baseline_blood': 107, 'dentate_gyrus': 134, 'final_blood': 161}
BLOCKS_ALL = {1: ('baseline_blood', 'Control vs good', 98), 2: ('baseline_blood', 'Control vs bad', 107),
              3: ('baseline_blood', 'good vs bad', 116), 4: ('dentate_gyrus', 'Control vs good', 125),
              5: ('dentate_gyrus', 'Control vs bad', 134), 6: ('dentate_gyrus', 'good vs bad', 143),
              7: ('final_blood', 'Control vs good', 152), 8: ('final_blood', 'Control vs bad', 161),
              9: ('final_blood', 'good vs bad', 170)}
_d = np.load(NPZ, allow_pickle=True)
M, GENE, OBJ = _d['M'], _d['gene'], _d['objdata'].item()
COUNTS = M[:, 2:92]
TISSUE = np.repeat(['baseline_blood', 'dentate_gyrus', 'final_blood'], 30)
GROUP = np.tile(['Control'] * 10 + ['good_responder'] * 10 + ['bad_responder'] * 10, 3)


def bh(p):
    """Процедура Бенджамини–Хохберга (монотонная)."""
    p = np.asarray(p, float); ok = np.isfinite(p); q = np.full(p.shape, np.nan)
    pv = p[ok]; o = np.argsort(pv); n = pv.size
    r = np.minimum.accumulate((pv[o] * n / np.arange(1, n + 1))[::-1])[::-1]
    q[np.where(ok)[0][o]] = np.clip(r, 0, 1); return q


def load_block(c0):
    """Числовые колонки DESeq-блока + статусы битых ячеек; починка #NAME? в log2FoldChange."""
    tab = {f: M[:, c0 + i].copy() for i, f in enumerate(FIELDS)}
    status = pd.Series({r: str(v) for r, v in OBJ.get(c0 + 4, {}).items()}).reindex(range(len(GENE)))
    lfc = tab['log2FoldChange'].copy()
    bad = status.eq('ERR:#NAME?').fillna(False).values
    fc, A, B = tab['foldChange'], tab['baseMeanA'], tab['baseMeanB']
    m1 = bad & np.isfinite(fc) & (fc > 0); lfc[m1] = np.log2(fc[m1])
    m2 = bad & ~m1 & np.isfinite(A) & np.isfinite(B) & (A > 0) & (B > 0); lfc[m2] = np.log2(A[m2] / B[m2])
    tab['lfc'] = lfc; tab['restored'] = m1 | m2
    tab['is_inf'] = status.eq('Inf').fillna(False).values
    tab['n_name'] = int(bad.sum()); tab['padj_na'] = np.isnan(tab['padj'])
    return tab


def mask(tab, mode):
    lfc, padj, bm = tab['lfc'], tab['padj'], tab['baseMean']
    base = np.isfinite(bm) & (bm > BM_T); sig = np.isfinite(padj) & (padj < PADJ_T)
    if mode == 'main': return base & (lfc > LFC_T) & sig
    if mode == 'abs': return base & (np.abs(lfc) > LFC_T) & sig
    if mode == 'down': return base & (lfc < -LFC_T) & sig
    if mode == 'nopadj': return base & (lfc > LFC_T)
    if mode == 'main_with_inf':
        l2 = lfc.copy(); l2[tab['is_inf']] = np.inf; return base & (l2 > LFC_T) & sig
    if mode == 'inf_reach': return base & sig & tab['is_inf']
    if mode == 'restored_pass': return base & (lfc > LFC_T) & sig & tab['restored']
    raise ValueError(mode)


TAB = {t: load_block(c) for t, c in BLOCKS_BAD.items()}

# ---------- T1: основной результат + чувствительность ----------
T1 = pd.DataFrame([{
    'Ткань': t,
    'Основной критерий (padj<0.05, lfc>0.5, baseMean>10)': int(mask(TAB[t], 'main').sum()),
    '|lfc|>0.5 (вкл. down)': int(mask(TAB[t], 'abs').sum()),
    'только down (lfc<-0.5)': int(mask(TAB[t], 'down').sum()),
    'без padj': int(mask(TAB[t], 'nopadj').sum()),
    'с Inf в lfc': int(mask(TAB[t], 'main_with_inf').sum()),
    'восстановлено #NAME? (строк)': TAB[t]['n_name'],
    'в т.ч. восстановленных прошло': int(mask(TAB[t], 'restored_pass').sum()),
    'Inf-строк всего': int(TAB[t]['is_inf'].sum()),
    'Inf, доживших до baseMean>10 и padj<0.05': int(mask(TAB[t], 'inf_reach').sum()),
    'базовый пул baseMean>10': int(np.nansum(TAB[t]['baseMean'] > BM_T)),
    'padj=NA (исключено авторами)': int(TAB[t]['padj_na'].sum()),
} for t in BLOCKS_BAD]).set_index('Ткань')

# ---------- T2: страховка по направлению знака ----------
ART = {'Lars2', 'Alas2', 'Malat1', 'Hbb-bs', 'Hbb-bt', 'Actb'}
rows2 = []
for t, c0 in BLOCKS_BAD.items():
    tab = TAB[t]
    ctrl = COUNTS[:, (TISSUE == t) & (GROUP == 'Control')].mean(1)
    badm = COUNTS[:, (TISSUE == t) & (GROUP == 'bad_responder')].mean(1)
    our = np.log2((badm + .5) / (ctrl + .5))
    sel = mask(tab, 'abs') & (np.abs(our) > 0.3)
    top = np.argsort(np.nan_to_num(tab['padj'], nan=9))[:10]
    rows2.append({'Ткань': t, 'генов padj<0.05 и |lfc|>0.5': int(mask(tab, 'abs').sum()),
                  'из них с однозначным направлением': int(sel.sum()),
                  'доля совпадения знака lfc с разницей средних': round(float(np.mean(
                      np.sign(tab['lfc'][sel]) == np.sign(our[sel]))), 3) if sel.sum() else np.nan,
                  'частотные/выбросные гены в топ-10 по padj': ', '.join(sorted(set(GENE[top]) & ART)) or 'нет'})
T2 = pd.DataFrame(rows2).set_index('Ткань')

# ---------- T3: независимая сверка ----------
def indep(tis, winsor):
    c = COUNTS[:, (TISSUE == tis) & (GROUP == 'Control')]
    b = COUNTS[:, (TISSUE == tis) & (GROUP == 'bad_responder')]
    X = np.hstack([c, b]); excl = np.zeros(X.shape[0], bool)
    if winsor:
        X = np.minimum(X, np.percentile(X, 99, axis=1)[:, None])
        excl = (X.max(1) / np.maximum(np.median(X, 1), 1e-9)) > 100
    c, b = X[:, :10], X[:, 10:]
    mean_all, mb, mc = X.mean(1), b.mean(1), c.mean(1)
    with np.errstate(divide='ignore', invalid='ignore'):
        lfc = np.log2(mb / mc)
    keep = (lfc > LFC_T) & (mean_all > BM_T) & ~excl
    lb, lc = np.log1p(b), np.log1p(c)
    _, pw = stats.ttest_ind(lb, lc, axis=1, equal_var=False)
    _, pm = stats.mannwhitneyu(lb, lc, axis=1, alternative='two-sided')
    v = lc.var(1, ddof=1) / 10 + lb.var(1, ddof=1) / 10
    pooled, d0 = np.nanmedian(v[mean_all > BM_T]), 5.0
    vs = 2 * (d0 * pooled + v * 17) / (d0 + 17)
    pmod = 2 * stats.t.sf(np.abs((mb - mc) / np.sqrt(np.maximum(vs, 1e-12))), df=d0 + 16)
    return dict(welch_p=int(np.nansum(keep & (np.nan_to_num(pw, nan=1) < .05))),
                welch_bh=int(np.nansum(keep & (bh(np.nan_to_num(pw, nan=1)) < .05))),
                mwu_p=int(np.nansum(keep & (np.nan_to_num(pm, nan=1) < .05))),
                mod_bh=int(np.nansum(keep & (bh(np.nan_to_num(pmod, nan=1)) < .05))),
                minq=float(np.nanmin(bh(np.nan_to_num(pw, nan=1)))), nexcl=int(excl.sum()))

VER = {(t, w): indep(t, w) for t in BLOCKS_BAD for w in (False, True)}
T3 = pd.DataFrame([{'Ткань': t, 'вариант': 'обрубка выбросов' if w else 'без обрубки',
                    'DESeq2 (авторские колонки)': int(mask(TAB[t], 'main').sum()),
                    'Welch p<0.05': VER[(t, w)]['welch_p'], 'Манна-Уитни p<0.05': VER[(t, w)]['mwu_p'],
                    'модерированный t + BH<0.05': VER[(t, w)]['mod_bh'],
                    'Welch + BH<0.05': VER[(t, w)]['welch_bh'],
                    'минимальный BH-q': round(VER[(t, w)]['minq'], 3),
                    'исключено как выброс': VER[(t, w)]['nexcl']}
                   for t in BLOCKS_BAD for w in (False, True)]).set_index(['Ткань', 'вариант'])


def ranking(s):
    return ' > '.join(s.sort_values(ascending=False).index)


rank_deseq = ranking(T1['Основной критерий (padj<0.05, lfc>0.5, baseMean>10)'])
rank_ind = {v: ranking(pd.Series({t: VER[(t, False)][v] for t in BLOCKS_BAD})) for v in ('welch_p', 'mwu_p', 'mod_bh')}
T4 = pd.DataFrame([{'№ сравнения': k, 'Ткань': t, 'Контраст': ctr,
                    'padj<0.05 всего': int(np.nansum(M[:, c + 6] < .05)),
                    'padj<0.05 и baseMean>10': int(np.nansum((M[:, c + 6] < .05) & (M[:, c] > BM_T))),
                    'lfc>0.5 и baseMean>10': int(np.nansum((M[:, c + 4] > LFC_T) & (M[:, c] > BM_T))),
                    'все три условия': int(np.nansum((M[:, c + 6] < .05) & (M[:, c + 4] > LFC_T) & (M[:, c] > BM_T)))}
                   for k, (t, ctr, c) in sorted(BLOCKS_ALL.items())]).set_index('№ сравнения')

order = T1['Основной критерий (padj<0.05, lfc>0.5, baseMean>10)'].sort_values(ascending=False)
lead, second, third = order.index[0], order.index[1], order.index[2]
gap = (order.iloc[0] / order.iloc[1] - 1) * 100
blood = int(T1.loc['baseline_blood'].iloc[0] + T1.loc['final_blood'].iloc[0])
L = ['# Ответ: число значимых DE-генов у bad responders против контроля по тканям', '',
     'Критерий ответа: `padj < 0.05` И `log2FoldChange > 0.5` И `baseMean > 10` по выходам DESeq2 из файла',
     '(Comparison 2 / 5 / 8 = bad_responder vs Control; положительный log2FoldChange = выше у bad responders).', '',
     '## T1. Основной результат и чувствительность порогов', T1.to_string(), '',
     '## T2. Страховка по направлению знака', T2.to_string(), '',
     '## T3. Независимая сверка по count-блоку (Welch / Манна-Уитни / модерированный t + BH)', T3.to_string(), '',
     f'- Ранжирование по DESeq2 (основной критерий): {rank_deseq}',
     f'- Ранжирование независимое, Welch p<0.05: {rank_ind["welch_p"]}',
     f'- Ранжирование независимое, Манна-Уитни p<0.05: {rank_ind["mwu_p"]}',
     f'- Ранжирование независимое, модерированный t + BH<0.05: {rank_ind["mod_bh"]}', '',
     '## T4. Контекст: все 9 DESeq-блоков файла', T4.to_string(), '', '## Итог',
     f'- **Ответ: {lead}** — {int(order.iloc[0])} генов.',
     f'- Второе место: {second} — {int(order.iloc[1])} генов; отрыв лидера {gap:+.0f}%. Третье: {third} — {int(order.iloc[2])} генов.',
     f'- Зубчатая извилина лидирует во всех вариантах: |lfc|>0.5 ({int(T1.loc["dentate_gyrus","|lfc|>0.5 (вкл. down)"])} против '
     f'{int(T1.loc["baseline_blood","|lfc|>0.5 (вкл. down)"])} и {int(T1.loc["final_blood","|lfc|>0.5 (вкл. down)"])}), '
     f'без padj ({int(T1.loc["dentate_gyrus","без padj"])} против {int(T1.loc["baseline_blood","без padj"])} и '
     f'{int(T1.loc["final_blood","без padj"])}), и во всех независимых тестах.',
     f'- Примечание (в вывод не входит): механическая сумма blood = baseline+final = {blood} против '
     f'{int(T1.loc["dentate_gyrus"].iloc[0])} в dentate_gyrus.', '',
     '## Ограничения и красный флаг',
     '- Красный флаг (на ответ не влияет): независимые тесты ставят final_blood ВЫШЕ baseline_blood на 2-3 местах, '
     'тогда как DESeq2 — наоборот. Первое место (dentate_gyrus) согласовано всеми методами с двукратным разрывом.',
     '- Наивный Welch с BH<0.05 даёт 0 генов во всех тканях (минимальный BH-q 0.10-0.97): 10 на 10 препонормированных '
     'округлённых значений без NB-оценки дисперсии и без авторских size factors, мощность несопоставима с DESeq2; '
     'поэтому для сверки использованы номинальные p и модерированная t-статистика.',
     '- Починка `#NAME?` (664/480/719 строк) не меняет ни один счётчик: у всех этих строк baseMean <= 10 '
     '(foldChange = 0, log2FC = -inf), фильтр по baseMean они не проходят.',
     '- Строки `Inf` в log2FoldChange исключены; до `baseMean>10 и padj<0.05` доживают 0/0/1 строк, '
     'поэтому колонка «с Inf в lfc» совпадает с основным критерием.',
     '- Базовый пул (baseMean>10): ' + ', '.join(f'{t} = {int(T1.loc[t, "базовый пул baseMean>10"])}' for t in BLOCKS_BAD) + '.',
     '- Расшифровка блоков Comparison N -> ткань/контраст восстановлена из данных (подписей в файле нет): '
     'ткань по корреляции log2(baseMean) со средним по ткани (r 0.998-0.999 против 0.64-0.66), контраст по '
     'корреляции Спирмена нашей Welch-t с -log10(pval) DESeq2 (rho 0.42-0.81, альтернативы заметно ниже).']
text = '\n'.join(L)
open(OUT, 'w').write(text)
print(text)
