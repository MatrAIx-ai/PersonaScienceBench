# Stream-parse xl/worksheets/sheet2.xml into a compact npz (numbers + sparse strings).
import zipfile, re, numpy as np, time
from xml.etree.ElementTree import iterparse
XL='/workspace/data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
NS='{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'
MAXROW=25406; NCOL=188
t0=time.time(); z=zipfile.ZipFile(XL)
sst=[]
with z.open('xl/sharedStrings.xml') as f:
    for ev,el in iterparse(f, events=('end',)):
        if el.tag==NS+'si':
            sst.append(''.join(t.text or '' for t in el.iter(NS+'t'))); el.clear()
print('sst', len(sst), f'{time.time()-t0:.0f}s', flush=True)
M=np.full((MAXROW-4,NCOL), np.nan, dtype=np.float64)
OBJ={}; HDR={1:{},2:{},3:{},4:{}}
idxcol=np.full(MAXROW-4, np.nan); genes=[None]*(MAXROW-4); rownums=[]
def cidx(ref):
    ci=0
    for ch in ref:
        if 'A'<=ch<='Z': ci=ci*26+(ord(ch)-64)
        else: break
    return ci-1
with z.open('xl/worksheets/sheet2.xml') as f:
    for ev,el in iterparse(f, events=('end',)):
        if el.tag!=NS+'row': continue
        rn=int(el.get('r'))
        dest=rn-5
        if rn>4: rownums.append(rn)
        for c in el.findall(NS+'c'):
            ref=c.get('r')
            if not ref: continue
            ci=cidx(ref); t=c.get('t'); v=c.find(NS+'v')
            if t=='inlineStr':
                isn=c.find(NS+'is'); val=''.join(x.text or '' for x in isn.iter(NS+'t')) if isn is not None else None
            elif v is None: continue
            elif t=='s': val=sst[int(v.text)]
            elif t=='e': val='ERR:'+(v.text or '')
            else:
                try: val=float(v.text)
                except (TypeError,ValueError): val=v.text
            if rn<=4: HDR[rn][ci]=val
            elif isinstance(val,float): M[dest,ci]=val
            else: OBJ.setdefault(ci,{})[dest]=val
            if rn==5:
                pass
            if rn>4 and ci==1: genes[dest]=val if isinstance(val,str) else str(val)
            if rn>4 and ci==0 and isinstance(val,float): idxcol[dest]=val
        el.clear()
G=len(rownums); M=M[:G]; idxcol=idxcol[:G]
np.savez('/workspace/work/normcount.npz', M=M, indexcol=idxcol[:G],
         gene=np.array(genes[:G],dtype=object), rownums=np.array(rownums),
         hdr1=np.array([HDR[1].get(c) for c in range(NCOL)],dtype=object),
         hdr2=np.array([HDR[2].get(c) for c in range(NCOL)],dtype=object),
         hdr3=np.array([HDR[3].get(c) for c in range(NCOL)],dtype=object),
         hdr4=np.array([HDR[4].get(c) for c in range(NCOL)],dtype=object),
         objcols=np.array(sorted(OBJ),dtype=object),
         objdata=np.array([OBJ],dtype=object), allow_pickle=True)
print('genes',G,'objcols',sorted(OBJ),f'{time.time()-t0:.0f}s',flush=True)
