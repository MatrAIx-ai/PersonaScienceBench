import numpy as np, collections
d=np.load('work/normcount.npz', allow_pickle=True)
M=d['M']; hdr1=d['hdr1']; hdr4=d['hdr4']; OBJ=d['objdata'].item(); gene=d['gene']
def L(i):
    s=''; i+=1
    while i: i,r=divmod(i-1,26); s=chr(65+r)+s
    return s
print('BLOCK MAP (Excel columns, sheet NormCount, data rows 5..25406):')
cur=None
for c in range(188):
    if hdr1[c] is not None:
        if cur: print(f'  {L(cur[1])}..{L(cur[2])}  (cols {cur[1]}-{cur[2]}, w={cur[2]-cur[1]+1})  {cur[0]}')
        cur=[str(hdr1[c]),c,c]
    elif cur: cur[2]=c
print(f'  {L(cur[1])}..{L(cur[2])}  (cols {cur[1]}-{cur[2]}, w={cur[2]-cur[1]+1})  {cur[0]}')
print('\nper-comparison column letters + coverage:')
for k in range(9):
    c0=98+9*k
    bm,bA,bB,fc,lfc,pv,pad=[M[:,c0+i] for i in range(7)]
    st_fc=collections.Counter(str(v) for v in OBJ.get(c0+3,{}).values())
    st_lfc=collections.Counter(str(v) for v in OBJ.get(c0+4,{}).values())
    deg_max=collections.Counter(str(v) for v in OBJ.get(c0+7,{}).values())
    deg_med=collections.Counter(str(v) for v in OBJ.get(c0+8,{}).values())
    print(f'  comp{k+1}: {L(c0)}..{L(c0+8)}  baseMean_num={np.isfinite(bm).sum():6d} padj_num={np.isfinite(pad).sum():6d} lfc_num={np.isfinite(lfc).sum():6d}')
    print(f'          foldChange strings={dict(st_fc)}  log2FC strings={dict(st_lfc)}')
    print(f'          DEG(Max)={dict(deg_max)}  DEG(Median)={dict(deg_med)}')
print('\nglobal: n_genes=%d ; rows where all 9 padj missing=%d'%(len(gene), int(sum(1 for i in range(len(gene)) if not any(np.isfinite(M[i,98+9*k+6]) for k in range(9))))))
