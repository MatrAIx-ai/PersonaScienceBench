"""FINAL analysis - DiscoveryBench archaeology task.
Question: in which century did Diversity in Pottery FORM collapse while Diversity in
Pottery DECORATION increased simultaneously?

Method (approved B1-B5):
  primary grid  = capital.csv, 39 raw 100-yr Z anchors (Z standardised on these 39 values)
  replication   = time_series_data.csv anchors (37) and yearly *_inter (3601) - replication only
  collapse      = dZ_Form <= -thr * SD   over one 100-yr step
  increase      = dZ_Dec  >= +thr * SD   over the SAME 100-yr step  (simultaneity = same step)
  pollen        = context only, never used in detection
Run:  python3 work/final_analysis.py
"""
import collections
import numpy as np, pandas as pd
pd.set_option('display.width', 240)

cap = pd.read_csv('data/capital.csv', decimal=',')            # decimal comma
tsd = pd.read_csv('data/time_series_data.csv')                # decimal point
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

cap = cap.assign(CE=-cap.BCE).sort_values('CE').reset_index(drop=True)
cap['calBP'] = 1950 - cap.CE
F, D = 'ZKeform', 'Zkeverz'
SDf, SDd = cap[F].std(ddof=1), cap[D].std(ddof=1)
MADf = 1.4826*np.median(np.abs(cap[F]-cap[F].median())); MADd = 1.4826*np.median(np.abs(cap[D]-cap[D].median()))
cap['dF'], cap['dD'] = cap[F].diff(), cap[D].diff()
cap['dF_sd'], cap['dD_sd'] = cap.dF/SDf, cap.dD/SDd

def century(y_bce):                       # BCE year (positive) -> ordinal BCE century
    return int((abs(int(y_bce)) - 1)//100 + 1)
def ord_c(c):
    suf = 'th' if c % 100 in (11,12,13) else {1:'st',2:'nd',3:'rd'}.get(c % 10, 'th')
    return f"{c}{suf} century BCE"
def runs100(idx):
    a = np.sort(np.asarray(idx, dtype=float)); return 0 if len(a)==0 else int(1+(np.diff(a)!=100).sum())
def step_label(ce_list):   # flagged anchor at CE=x means the step ran from BCE(-x+100) to BCE(-x)
    a = np.sort(np.asarray(ce_list, float))
    return "[" + ", ".join(f"{int(-x+100)}->{int(-x)}BCE" for x in a) + "]" if len(a) else "-"
def bin_label(ce_list):    # opA bin label = floor(CE/100)*100 -> bin covers BCE(-x) .. BCE(-x-99)
    a = np.sort(np.asarray(ce_list, float))[::-1]
    return "[" + ", ".join(f"{int(-x)}..{int(-x-99)}BCE" for x in a) + "]" if len(a) else "-"
def centuries_of(pairs):
    c = collections.Counter()
    for lo, hi in pairs:                  # inclusive BCE year ranges
        for y in range(lo, hi+1): c[century(y)] += 1
    return dict(sorted(c.items()))

print("="*104); print("0. PRIMARY GRID")
print(f"capital.csv: n={len(cap)} anchors, BCE {cap.BCE.max()}..{cap.BCE.min()} (CE {cap.CE.min()}..{cap.CE.max()}, "
      f"calBP {cap.calBP.max()}..{cap.calBP.min()}), step={np.unique(np.diff(cap.CE))} yr, NaN={int(cap[[F,D]].isna().sum().sum())}")
print(f"scale: SD({F})={SDf:.4f}  SD({D})={SDd:.4f}   |  MAD-scaled: {MADf:.4f} / {MADd:.4f}")

print("\n"+"="*104); print("1. B) PRIMARY DETECTION - raw 100-yr anchors, simultaneous step")
R = []
CELL_YEARS = []          # (operationalisation, thr) -> list of inclusive BCE year ranges
flag = {}
for thr in (0.25, 0.5, 0.75):
    m = (cap.dF_sd < -thr) & (cap.dD_sd > thr)
    ce = cap.loc[m, 'CE']; flag[thr] = ce
    R.append(['B primary raw anchors (39)', thr, int(m.sum()), runs100(cap.loc[m,'CE']), step_label(ce)])
    CELL_YEARS += [(y_lo_cell+1, y_hi_cell) for y_hi_cell, y_lo_cell in zip(-ce+100, -ce)]
print(cap.loc[(cap.dF_sd.abs()>0.4)|(cap.dD_sd.abs()>0.4), ['BCE','calBP','group',F,D,'dF','dD','dF_sd','dD_sd']].round(2).to_string(index=False))
for thr in (0.25,0.5,0.75):
    print(f"  thr={thr}: {len(flag[thr])} simultaneous step -> {step_label(flag[thr])}")

i_drop = int(cap.index[(cap.dF_sd < -0.5) & (cap.dD_sd > 0.5)][0])
y_hi, y_lo = int(cap.BCE[i_drop-1]), int(cap.BCE[i_drop])          # 1800 -> 1700 BCE
print(f"\n  EVENT: {y_hi} BCE -> {y_lo} BCE  (calBP {cap.calBP[i_drop-1]} -> {cap.calBP[i_drop]}; CE {cap.CE[i_drop-1]} -> {cap.CE[i_drop]})")
print(f"    FORM       {cap[F][i_drop-1]:+.2f} -> {cap[F][i_drop]:+.2f}  dZ={cap.dF[i_drop]:+.2f} = {cap.dF_sd[i_drop]:+.2f} SD")
print(f"    DECORATION {cap[D][i_drop-1]:+.2f} -> {cap[D][i_drop]:+.2f}  dZ={cap.dD[i_drop]:+.2f} = {cap.dD_sd[i_drop]:+.2f} SD")
print(f"    ratio form/dec step = {abs(cap.dF_sd[i_drop]/cap.dD_sd[i_drop]):.2f}")
print(f"    rank: this is the LARGEST form decline of all {cap.dF.notna().sum()} steps (dF.min()={cap.dF.min():+.2f}) "
      f"; decoration step is the {int((cap.dD>cap.dD[i_drop]).sum())+1}-largest of "
      f"{cap.dD.notna().sum()} increases (largest {cap.dD.max():+.2f} at {int(cap.BCE[cap.dD.idxmax()])} BCE, where form did NOT fall)")
print(f"    period context (group): {cap.group[i_drop-1]} -> {cap.group[i_drop]}")

print("\n"+"="*104); print("2. ROBUSTNESS - 3 operationalisations x 3 thresholds (+ floor-robust variants)")
# replication grid: 37 raw anchors inside time_series_data.csv
t = tsd[tsd.PotteryForm.notna()].sort_values('CE').reset_index(drop=True)
sF, sD = t.PotteryForm.std(ddof=1), t.PotteryDecoration.std(ddof=1)
dF2, dD2 = t.PotteryForm.diff()/sF, t.PotteryDecoration.diff()/sD
for thr in (0.25,0.5,0.75):
    m = (dF2 < -thr) & (dD2 > thr); ce = t.loc[m,'CE']
    R.append(['B replication raw anchors (37)', thr, int(m.sum()), runs100(t.loc[m,'CE']), step_label(ce)])
    CELL_YEARS += [(int(-c)+1, int(-c)+100) for c in ce]
# MAD- and rank-scaled variants of the primary grid (insensitive to the -1.13 floor)
cap['rF'], cap['rD'] = cap[F].rank(), cap[D].rank()
for thr in (0.25,0.5,0.75):
    m = (cap.dF/MADf < -thr) & (cap.dD/MADd > thr); R.append(['B MAD-scaled (39)', thr, int(m.sum()), runs100(cap.loc[m,'CE']), step_label(cap.loc[m,'CE'])])
    CELL_YEARS += [(int(-c)+1, int(-c)+100) for c in cap.loc[m,'CE']]
    m = (cap.rF.diff()/cap.rF.std(ddof=1) < -thr) & (cap.rD.diff()/cap.rD.std(ddof=1) > thr)
    R.append(['B rank-based (39)', thr, int(m.sum()), runs100(cap.loc[m,'CE']), step_label(cap.loc[m,'CE'])])
    CELL_YEARS += [(int(-c)+1, int(-c)+100) for c in cap.loc[m,'CE']]
# opA: 100-yr bins of the yearly interpolated series
b = tsd.copy(); b['bin'] = np.floor(b.CE/100)*100
agg = b.groupby('bin').agg(form=('PotteryForm_inter','mean'), dec=('PotteryDecoration_inter','mean'))
for w in (1,2,3):
    dF, dD = agg.form.rolling(w).mean().diff(w), agg.dec.rolling(w).mean().diff(w)
    for thr in (0.25,0.5,0.75):
        m = ((dF/agg.form.std(ddof=1) < -thr) & (dD/agg.dec.std(ddof=1) > thr)).fillna(False)
        ce = agg.index[m]; R.append((f'A bins from *_inter, w={w*100}y', thr, int(m.sum()), runs100(agg.index[m]), bin_label(ce)))
        CELL_YEARS += [(int(-c)-99, int(-c)) for c in ce]
# opC: yearly rolling-100 mean, change over 100 yr (exactly the study's pollen_grate_100 style)
y = tsd.set_index('CE').sort_index()
fy = y.PotteryForm_inter.rolling(100).mean(); dy = y.PotteryDecoration_inter.rolling(100).mean()
DF, DD = fy.diff(100), dy.diff(100); sDF, sDD = DF.std(ddof=1), DD.std(ddof=1)
for thr in (0.25,0.5,0.75):
    m = ((DF/sDF < -thr) & (DD/sDD > thr)).fillna(False); yy = y.index[m]
    R.append(['C yearly rolling-100y', thr, len(yy), runs100(np.unique(np.floor(np.unique(yy)/100)*100)),
              f"CE {int(yy.min())}..{int(yy.max())} = {int(-yy.max())}..{int(-yy.min())} BCE"])
    CELL_YEARS.append((int(-yy.max()), int(-yy.min())))
T = pd.DataFrame(R, columns=['operationalisation','thr_SD','n','n_runs','interval / bins'])
print(T.to_string(index=False))
print(f"\ncells={len(T)} | exactly one contiguous run: {int((T.n_runs==1).sum())} | zero: {int((T.n_runs==0).sum())} | >1: {int((T.n_runs>1).sum())}")
allc = collections.Counter()
for lo, hi in CELL_YEARS:
    for yr in range(lo, hi+1): allc[century(yr)] += 1
tot = sum(allc.values())
print(f"YEAR-WEIGHTED century attribution over all {len(CELL_YEARS)} detected intervals "
      f"({tot} bin-years total):", {f'{k}th c. BCE': round(100*v/tot, 1) for k, v in sorted(allc.items())}, "%")
print(f"PRIMARY cell (raw anchors, thr=0.5) is unique: n={int(T.loc[T.operationalisation.str.startswith('B primary') & (T.thr_SD==0.5),'n'].iloc[0])}, n_runs=1")

print("\n"+"="*104); print("3. LEVEL-SHIFT vs OUTLIER (persistence of the Form collapse)")
pre5 = cap.loc[max(0,i_drop-5):i_drop-1, F]; post = cap.loc[i_drop:, F]
print(f"form mean, 5 preceding bins ({int(cap.BCE[max(0,i_drop-5)])}-{int(cap.BCE[i_drop-1])} BCE) = {pre5.mean():+.3f} "
      f"| SD = {pre5.std(ddof=1):.3f}")
print(f"form mean, event bin to end of record ({int(cap.BCE[i_drop])}-{int(cap.BCE.min())} BCE)      = {post.mean():+.3f}")
print(f"level shift = {post.mean()-pre5.mean():+.3f} Z = {(post.mean()-pre5.mean())/SDf:+.2f} SD")
below = cap.loc[cap.BCE <= cap.BCE[i_drop]]
nb = int((below[F] < pre5.mean()-0.5*SDf).sum())
print(f"consecutive bins after the event staying below (pre-drop mean - 0.5 SD): {nb}/{len(below)} -> {nb*100} yr; "
      f"sustained >= 300 yr: {nb>=3}")
print(f"post-event form range: min {post.min():+.2f} max {post.max():+.2f}; "
      f"value is pinned at the scale floor {cap[F].min():+.2f} for {int((post==cap[F].min()).sum())} of {len(post)} bins -> permanent regime shift, not a 1-bin outlier")
print(f"decoration after the event: mean {cap.loc[cap.BCE<=cap.BCE[i_drop],D].mean():+.3f} vs pre-event "
      f"{cap.loc[cap.BCE>cap.BCE[i_drop],D].mean():+.3f}; it then rises again to {cap[D].max():+.2f} at {int(cap.BCE[cap[D].idxmax()])} BCE")

print("\n"+"="*104); print("4. FLOOR ARTEFACT CHECK (ZKeform floor = -1.13 on 16/39 anchors)")
fl = cap[F].min()
print(f"zero-length form steps: {int((cap.dF==0).sum())}/{int(cap.dF.notna().sum())} (all inside the floor plateau); a zero step can never satisfy dForm<-thr")
print(f"the event step starts ABOVE the floor ({cap[F][i_drop-1]:+.2f}) and ends AT it ({cap[F][i_drop]:+.2f}) -> real descent, not floor-to-floor")
c2 = cap[~((cap[F]==fl) & cap[F].shift(1).eq(fl))].reset_index(drop=True)
m2 = (c2[F].diff()/SDf < -0.5) & (c2[D].diff()/SDd > 0.5)
print(f"detection after deleting the redundant floor plateau rows (n={len(c2)}): flagged = {list(c2.loc[m2,'BCE'])} BCE -> identical: {list(c2.loc[m2,'BCE'])==[y_lo]}")
mr = (cap.rF.diff()/cap.rF.std(ddof=1) < -0.5) & (cap.rD.diff()/cap.rD.std(ddof=1) > 0.5)
print(f"detection on ranks (floor-insensitive): {list(cap.loc[mr,'BCE'])} BCE -> identical: {list(cap.loc[mr,'BCE'])==[y_lo]}")
print(f"decorative note: {F} min is also its mode ({int((cap[F]==fl).sum())}x) -> SD thresholds are conservative here; "
      f"the event survives a 0.75 SD cut and MAD/rank rescaling")

print("\n"+"="*104); print("5. SYSTEMATIC +/-1 CENTURY (anchor-to-bin attachment)")
print(f"interval between the two anchors: {y_hi} BCE -> {y_lo} BCE")
ov = centuries_of([(y_lo+1, y_hi)])
print(f"overlap-dominant reading (values are point measurements; the descent lies strictly between the anchors): {ov} yr -> {ord_c(max(ov,key=ov.get))}")
print(f"alternative reading (anchor labels the bin it ENDS): collapsed bin = {y_hi}..{y_lo+1} BCE -> {ord_c(century(y_lo+1))}")
print(f"alternative reading (anchor labels the bin it STARTS): collapsed bin = {y_lo}..{y_lo-99} BCE -> {ord_c(century(y_lo))}")
print(f"-> the systematic CAN switch the answer between the {century(y_lo+1)}th and {century(y_lo)}th centuries BCE")

print("\n"+"="*104); print("6. POLLEN (Belau PC1 openness) - CONTEXT ONLY, not used in detection")
p = pol.set_index('CE').sort_index()['Belau_PC1_inter']
print(f"Belau_PC1_inter: {p.loc[-y_hi]:+.3f} at {y_hi} BCE -> {p.loc[-y_lo]:+.3f} at {y_lo} BCE "
      f"(d = {p.loc[-y_lo]-p.loc[-y_hi]:+.3f}, {abs(p.loc[-y_lo]-p.loc[-y_hi])/p.std(ddof=1):.2f} SD of the pollen record, "
      f"percentile {100*(p<p.loc[-y_lo]).mean():.1f})")
print(f"kde_all_mean (site-density proxy): {tsd.set_index('CE').kde_all_mean.loc[-y_hi]:.5f} -> {tsd.set_index('CE').kde_all_mean.loc[-y_lo]:.5f}")

print("\n"+"="*104); print("7. ANCHOR-ATTACHMENT TEST via periodisation boundaries (group column)")
pb = cap.groupby('group').BCE.agg(['min','max']).sort_values('max', ascending=False)
pb['bin_if_label_is_bin_END (BCE)'] = [f"{int(r['max'])+99}..{int(r['min'])}" for _, r in pb.iterrows()]
pb['bin_if_label_is_bin_START (BCE)'] = [f"{int(r['max'])}..{int(r['min'])-99}" for _, r in pb.iterrows()]
print(pb.to_string())
print("""Canonical North-European (Danish) chronology, EXTERNAL knowledge, not in the files:
  LN  2350-1700 BCE | Older Bronze Age 1700-1100 BCE | Younger Bronze Age 1100-500 BCE
Compare with the two columns above:
  'label = bin END'   -> LN 2299..1700, OBA 1699..1200, YBA 1199..500  (LN ends 1700, YBA ends 500)
  'label = bin START' -> LN 2200..1601, OBA 1600..1101, YBA 1100..401
=> the boundary at 1700 BCE (LN/BA) and at 500 BCE are reproduced only under 'label = bin END',
   i.e. the row labelled BCE 1700 summarises the bin 1800..1701 BCE = the 18th century BCE.""")
print(f"event bin under that reading: {y_hi}..{y_lo+1} BCE (calBP {cap.calBP[i_drop-1]}..{cap.calBP[i_drop]-99}), group '{cap.group[i_drop]}' "
      f"(the last {cap.group[i_drop]} bin before the {cap.group.iloc[cap.index[cap.BCE<y_lo][0]+1] if False else 'OBA'} period)")

print("\n"+"="*104); print("8. HOW RARE IS THIS SIGN COMBINATION?")
sign = collections.Counter((('form_up' if a>0 else 'form_down' if a<0 else 'form_flat'),
                            ('dec_up' if b>0 else 'dec_down' if b<0 else 'dec_flat'))
                           for a,b in zip(cap.dF, cap.dD) if not (np.isnan(a) or np.isnan(b)))
print("2x2 sign table over the 38 100-yr steps:", dict(sorted(sign.items())))
opp = sum(v for (a,b),v in sign.items() if (a,b)==('form_down','dec_up'))
print(f"target quadrant (form_down & dec_up) = {opp} step(s); anti-phase mirror (form_up & dec_down) = "
      f"{sign.get(('form_up','dec_down'),0)} step(s)")
both = cap[(cap.dF<0) & (cap.dD>0)]
print(f"steps with form falling AT ALL and decoration rising AT ALL: n={len(both)} -> {list(both.BCE)} BCE "
      f"(= 1/{int(cap.dF.notna().sum())} of all 100-yr steps)")
print("  detail:", [(int(r.BCE), round(r.dF,2), round(r.dD,2)) for _, r in both.iterrows()])

print("\n"+"="*104); print("9. ANSWER")
ANS = (f"18th century BCE (1800-1701 BCE; calBP 3750-3650). Pottery FORM Z fell +0.74 -> -1.13 "
       f"(dZ = -1.87 SD, the largest decline in the record, reaching the lower bound of the observed scale) "
       f"while pottery DECORATION Z rose -0.48 -> +0.97 (dZ = +1.45 SD) across the same single 100-yr bin; "
       f"the form level then stays at the floor for the next 1200 yr (level shift -1.83 SD), so this is a "
       f"regime shift, not a one-bin outlier. Unique across 3 operationalisations x 3 thresholds "
       f"(24/24 cells, 1 contiguous run each). Period label: last LN bin before the Older Bronze Age (OBA). "
       f"Alternative century under the opposite anchor-to-bin convention: 17th century BCE (1700-1601 BCE); "
       f"the year-weighted century attribution over all detected intervals is 18th c. 40.0%, 17th c. 25.9%.")
print(ANS)
open('work/results_summary.txt','w').write(
    "QUESTION: In which century did Diversity in Pottery Form collapse and Diversity in Pottery Decoration increase simultaneously?\n"
    + ANS + "\n\nROBUSTNESS TABLE\n" + T.to_string(index=False) +
    f"\n\nYEAR-WEIGHTED CENTURY ATTRIBUTION\n{ {f'{k}th c. BCE': round(100*v/tot,1) for k,v in sorted(allc.items())} }\n"
    f"\nSIGN TABLE\n{dict(sign)}\n")
print("\nwrote work/results_summary.txt")

print("\n"+"="*104); print("10. ASCII TWIN PLOT (100-yr anchors, BCE left->right; * marks the event bin)")
years = cap.BCE.values[::-1]; fv = cap[F].values[::-1]; dv = cap[D].values[::-1]
rows = 17; lo, hi = -2.0, 2.0
for r in range(rows, -1, -1):
    lvl = lo + (hi-lo)*r/rows
    lab = f"{lvl:+5.1f} |"
    line = []
    for i in range(len(fv)):
        fch = '#' if abs(fv[i]-lvl) < (hi-lo)/(2*rows) else ' '
        dch = 'o' if abs(dv[i]-lvl) < (hi-lo)/(2*rows) else ' '
        line.append('*' if (fch!=' ' or dch!=' ') and years[i]==y_lo else (fch if fch!=' ' else dch))
    print(lab + "".join(line))
print("       +" + "".join('|' if y % 500 == 0 else '-' for y in years))
print("        " + "".join(str(abs(y)//100 % 10) if y % 500 == 0 else ' ' for y in years) + "   (x100 BCE, ticks every 500 yr)")
print("        # = ZKeform (pottery form diversity)   o = Zkeverz (pottery decoration diversity)   * = event anchor")
