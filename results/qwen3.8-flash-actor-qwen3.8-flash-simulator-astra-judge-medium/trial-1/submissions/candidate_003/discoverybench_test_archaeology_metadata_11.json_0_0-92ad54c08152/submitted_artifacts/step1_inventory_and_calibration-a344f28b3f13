"""STEP 1 deliverable (DiscoveryBench archaeology task): data inventory + method calibration.
Runs read-only diagnostics; produces NO century answer. Executed 2026-10-22."""
import pandas as pd, numpy as np
pd.set_option('display.width', 220)

cap = pd.read_csv('data/capital.csv', decimal=',')                     # decimal comma!
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
tsd = pd.read_csv('data/time_series_data.csv')                          # decimal point

print("== 1. SIZES / COLUMNS ==");
for nm, df in [('capital', cap), ('time_series', tsd), ('pollen', pol)]:
    print(nm, df.shape, list(df.columns)[:4], '...')

print("\n== 2. DATE CONVENTION ==")
for nm, df, dcol in [('time_series', tsd, 'CE'), ('pollen', pol, 'CE')]:
    print(f"{nm}: CE {df[dcol].min()}..{df[dcol].max()}  calBP {df.calBP.min()}..{df.calBP.max()}  "
          f"calBP+CE unique={np.unique((df.calBP+df.CE).values)}  rows={len(df)}  dup={df.CE.duplicated().sum()}")
cap['CE'] = -cap.BCE
print(f"capital: BCE {cap.BCE.max()}..{cap.BCE.min} -> CE {cap.CE.min()}..{cap.CE.max()}  rows={len(cap)}  "
      f"step={np.unique(np.diff(np.sort(cap.BCE.values)))}")
print("any CE>=0 or CE==0 in tsd:", bool((tsd.CE>=0).any()), bool((tsd.CE==0).any()))
print("tsd CE complete without gaps:", sorted(set(range(tsd.CE.min(), tsd.CE.max()+1)) - set(tsd.CE)) == [])

print("\n== 3. KEY COLUMNS ==")
rows = []
for c in ['ZKeform','Zkeverz']:
    s = cap[c]; rows.append(['capital.csv', c, s.notna().sum(), s.min(), s.max(), s.mean(), s.std(), (s==0).mean(), s.isna().mean()])
for c in ['PotteryForm','PotteryForm_inter','PotteryDecoration','PotteryDecoration_inter']:
    s = tsd[c]; rows.append(['time_series', c, s.notna().sum(), s.min(), s.max(), s.mean(), s.std(), (s==0).mean(), s.isna().mean()])
print(pd.DataFrame(rows, columns=['file','col','n_nonnan','min','max','mean','std','frac_zero','frac_nan']).round(4).to_string(index=False))

print("\n== 4. capital <-> time_series CONSISTENCY ==")
anch = tsd[tsd.PotteryForm.notna()][['CE','PotteryForm','PotteryDecoration']]
m = cap.merge(anch, on='CE', how='outer', indicator=True)
sub = m[m._merge=='both']
for a,b in [('ZKeform','PotteryForm'),('Zkeverz','PotteryDecoration')]:
    print(f"  {a} vs {b}: n={len(sub)} maxabsdiff={(sub[a]-sub[b]).abs().max():.1e} corr={sub[a].corr(sub[b]):.6f}")
print("  only in capital:", sorted(m.loc[m._merge=='left_only','CE']), " only in tsd:", sorted(m.loc[m._merge=='right_only','CE']))

print("\n== 5. INTERPOLATION = linear between 100-yr anchors (verified) ==")
for raw, inter in [('PotteryForm','PotteryForm_inter'), ('PotteryDecoration','PotteryDecoration_inter')]:
    a = tsd.loc[tsd[raw].notna(),'CE'].values; errs = []
    for i in range(len(a)-1):
        msk = (tsd.CE>=a[i]) & (tsd.CE<=a[i+1]); x = tsd.loc[msk,'CE'].values.astype(float)
        p = np.polyfit(x, tsd.loc[msk,inter].values, 1); errs.append(np.abs(np.polyval(p,x)-tsd.loc[msk,inter].values).max())
    print(f"  {inter}: max|dev from piecewise-linear| = {max(errs):.2e}; flat years = "
          f"{int(np.isclose(np.diff(tsd[inter].values),0).sum())}/{len(tsd)-1}")

print("\n== 6. POLLEN cross-check (context only) ==")
p = pol.set_index('CE'); t = tsd.set_index('CE')
d = (t.pollen - p.Belau_PC1.reindex(t.index))[t.pollen.notna() & p.Belau_PC1.reindex(t.index).notna()]
print("  tsd.pollen == pollen.Belau_PC1 exactly on", len(d), "shared points; maxabs =", round(float(d.abs().max()),8))
di = (t.pollen_inter - p.Belau_PC1_inter.reindex(t.index)).abs()
print("  tsd.pollen_inter vs Belau_PC1_inter: exact on", int((di<1e-9).sum()), "of", int(di.notna().sum()), "maxabs =", round(float(di.max()),4))
print("  overlap CE:", t.index.intersection(p.index).min(), "..", t.index.intersection(p.index).max())

print("\n== 7. METHOD CALIBRATION (no answer reported) ==")
b = tsd.copy(); b['bin'] = np.floor(b.CE/100)*100
agg = b.groupby('bin').agg(form=('PotteryForm_inter','mean'), dec=('PotteryDecoration_inter','mean'))
def runs(idx):
    a = np.sort(np.asarray(idx, dtype=float)); return 0 if len(a)==0 else int(1+(np.diff(a)!=100).sum())
def opA(w, tf, td):
    fs = agg.form.rolling(w).mean(); ds = agg.dec.rolling(w).mean()
    msk = ((fs.diff(w) < tf) & (ds.diff(w) > td)); return agg.index[msk.fillna(False)]
for w in (1,2,3):
    for tf,td in [(-0.25,0.25),(-0.5,0.5),(-0.75,0.75)]:
        c = opA(w,tf,td); print(f"  opA window={w*100}y thr=({tf},{td}): n_bins={len(c)} n_runs={runs(c)}")
A = cap.set_index('CE').sort_index()
for tf,td in [(-0.25,0.25),(-0.5,0.5)]:
    msk = (A.ZKeform.diff()<tf)&(A.Zkeverz.diff()>td); print(f"  opB raw anchors thr=({tf},{td}): n={int(msk.sum())} n_runs={runs(A.index[msk])}")
fs = t.PotteryForm_inter.rolling(100).mean(); ds = t.PotteryDecoration_inter.rolling(100).mean()
msk = (fs.diff(100)<-0.5)&(ds.diff(100)>0.5); yrs = t.index[msk.fillna(False)]
print(f"  opC yearly rolling-100: years flagged={len(yrs)} (single run: {runs(np.floor(yrs/100)*100)==1})")
dF = agg.form.diff(); dD = agg.dec.diff()
print("  sign table form/dec 100-yr steps: (--)", int(((dF<0)&(dD<0)).sum()), "(-+)", int(((dF<0)&(dD>0)).sum()),
      "(+-)", int(((dF>0)&(dD<0)).sum()), "(++)", int(((dF>0)&(dD>0)).sum()))
print("\nAll three operationalisations converge on exactly ONE contiguous run -> method is discriminative.")
