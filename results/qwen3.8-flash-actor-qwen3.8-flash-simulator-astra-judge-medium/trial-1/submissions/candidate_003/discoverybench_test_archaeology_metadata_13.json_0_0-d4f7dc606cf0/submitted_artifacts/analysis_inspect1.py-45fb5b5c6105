import pandas as pd, numpy as np
pd.set_option('display.width',200); pd.set_option('display.max_columns',50)

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
# capital uses comma decimals
for c in cap.columns[3:]:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',','.'), errors='coerce')

print("### time_series_data.csv")
print("shape", ts.shape, "| index name:", ts.index.name, ts.index.min(), ts.index.max())
print("CE range:", ts.CE.min(), ts.CE.max(), "| calBP range:", ts.calBP.min(), ts.calBP.max())
print("CE monotonic increasing:", ts.CE.is_monotonic_increasing, "| step sizes:", sorted(ts.CE.diff().dropna().unique())[:5])
print("check calBP == 1950 - CE :", ((1950 - ts.CE) == ts.calBP).all())
print("rows per 100y (last two digits of CE) sample:", ts.CE.abs()%100)
miss = ts.isna().sum()
print("missing counts:\n", miss[miss>0])
print("pct missing:\n", (miss/len(ts)*100).round(1).sort_values(ascending=False).head(25))
print(ts[['kde_all_mean','g_all_mean','g_all_std','pollen','pollen_inter','pollen_grate_100']].describe().T[['count','mean','std','min','max']])

print("\n### capital.csv")
print("shape", cap.shape)
print("BCE unique sorted:", sorted(cap.BCE.unique()))
print("step:", sorted(cap.BCE.unique())[-1]-sorted(cap.BCE.unique())[-2], "| groups:", cap.group.unique())
print("n rows per group:\n", cap.groupby('group', sort=False).size())
print("missing:\n", cap.isna().sum()[lambda s: s>0])
print("BCE order in file: monotonic decreasing:", cap.BCE.is_monotonic_decreasing)

print("\n### pollen csv")
print("shape", pol.shape, "| index name:", pol.index.name, "min/max:", pol.index.min(), pol.index.max())
print("calBP range:", pol.calBP.min(), pol.calBP.max(), "| CE range:", pol.CE.min(), pol.CE.max())
print("index == CE:", (pol.index==pol.CE).all(), "| calBP==1950-CE:", ((1950-pol.CE)==pol.calBP).all())
print("contiguous yearly (CE diff unique):", sorted(pol.CE.diff().dropna().abs().unique())[:5])
print("CE monotonic decreasing:", pol.CE.is_monotonic_decreasing)
m = pol.isna().sum(); print("missing:\n", m[lambda s: s>0])
print("pct missing raw PC1: Belau %.1f%% Woserin %.1f%%" % (pol.Belau_PC1.isna().mean()*100, pol.Woserin_PC1.isna().mean()*100))
