import pandas as pd, numpy as np
pd.set_option('display.width',220); pd.set_option('display.max_columns',60)
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',','.'), errors='coerce')

win = ts[(ts.CE>=-2000)&(ts.CE<=-1100)]
print("window rows:", len(win), "CE", win.CE.min(), win.CE.max())
print("missing in window:\n", win.isna().sum()[lambda s:s>0])
print("\nNaN structure of raw Z cols (which CE are non-null):")
for c in ['HatchetSword','Dagger','HouseSize','Sickle','PotteryForm','MonumentSize','Amber','Depot']:
    nn = ts.loc[ts[c].notna(),"CE"]
    print(f"  {c}: n={len(nn)} CE values={list(nn)[:60]}")
print("\npollen raw non-null CE:", sorted(ts.loc[ts.pollen.notna(),'CE'])[:10], "...", sorted(ts.loc[ts.pollen.notna(),'CE'])[-5:])

print("\n--- _inter continuity check in window (sample cols, every 25y) ---")
cols=['CE','kde_all_mean','g_all_mean','pollen_inter','pollen_inter_100','pollen_grate_100','HatchetSword_inter','HouseSize_inter','MonumentCount_inter','PotteryForm_inter','AxesCelts_inter']
print(win[cols].iloc[::100].to_string(index=False))

print("\n--- capital.csv in window (BCE 1100..2000) ---")
cw = cap[(cap.BCE>=1100)&(cap.BCE<=2000)].sort_values('BCE')
print(cw.to_string(index=False))
print("\nAre capital Z values constant within cultural group? (nunique per group)")
zc=[c for c in cap.columns if c.startswith('Z')]
print(cap.groupby('group',sort=False)[zc].nunique().to_string())
print("\nperiod->BCE span per group:\n", cap.groupby('group',sort=False).BCE.agg(['min','max','count']))

print("\n--- do ts *_inter match capital Z at the same century? ---")
mapping={'HatchetSword':'ZAxtSchwert','Dagger':'ZDolch','HouseSize':'Zhausgr','CopperGold':'ZCU_AU','Amber':'Zamber','MonumentCount':'ZMonument','Depot':'ZHort','Sickle':'ZSichel','AxesCelts':'ZBeil','MonumentSize':'ZMW','PotteryForm':'ZKeform','PotteryDecoration':'Zkeverz'}
rows=[]
for k,v in mapping.items():
    sub=ts[(ts.CE%100==0)&(ts.CE<=-500)&(ts.CE>=-4300)].copy()
    sub['BCE']=-sub.CE
    m=sub.merge(cap[['BCE',v]],on='BCE')
    exact=(m[k]==m[v]).mean(); interclose=(m[k+'_inter']==m[v]).mean()
    rows.append((k,v,len(m),round(exact,3),round(interclose,3), round(np.nanmax(np.abs(m[k+'_inter']-m[v])),4)))
print(pd.DataFrame(rows,columns=['ts_raw','cap_col','n','raw==cap','inter==cap','max|inter-cap|']).to_string(index=False))

print("\n--- g_all_mean semantics: compare to numerical derivative of kde_all_mean (per year) ---")
d=ts.kde_all_mean.diff()
print("corr(g_all_mean, diff(kde)) =", round(np.corrcoef(ts.g_all_mean, d.fillna(0))[0,1],4))
print("corr(g_all_mean, kde_diff/100) =", round(np.corrcoef(ts.g_all_mean, (d/ts.kde_all_mean).fillna(0))[0,1],4))
print("mean |g_all_mean| vs mean rel diff:", ts.g_all_mean.abs().mean(), (d/ts.kde_all_mean).abs().mean())
print("\ng_all_mean sign summary in window: mean %.5f  max %.5f at CE %d" % (win.g_all_mean.mean(), win.g_all_mean.max(), win.loc[win.g_all_mean.idxmax(),'CE']))

print("\n--- century binning view (capital as 100y bins): does ts window cover exactly? ---")
print("ts covers CE -4100..-500 -> BCE 500..4100 ; capital BCE 500..4300 (4200-4300 not in ts)")
print("pollen CE -4785..-702 -> covers window; window pollen NaN count:", win.pollen.isna().sum(), "of", len(win))
