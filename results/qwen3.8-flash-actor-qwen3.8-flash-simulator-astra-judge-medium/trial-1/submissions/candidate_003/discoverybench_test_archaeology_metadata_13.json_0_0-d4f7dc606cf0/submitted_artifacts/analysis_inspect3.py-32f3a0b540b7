import pandas as pd, numpy as np
pd.set_option('display.width',220); pd.set_option('display.max_columns',60)
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
for c in pol.columns:
    if str(pol[c].dtype) in ('object','str','string'):
        pol[c]=pd.to_numeric(pol[c].astype(str).str.replace(',','.'), errors='coerce')

# link ts.pollen to pollen csv
p = pol.set_index('CE')
common = ts.loc[ts.pollen.notna(),['CE','pollen']].copy()
common['MEAN']=p.MEAN.reindex(common.CE).values
common['Belau']=p.Belau_PC1.reindex(common.CE).values
common['Wos']=p.Woserin_PC1.reindex(common.CE).values
print("ts.pollen == pollen csv MEAN ?  frac exact:", np.isclose(common.pollen, common.MEAN, equal_nan=True).mean())
print("first rows:\n", common.head(3).to_string(index=False))
print("raw pollen spacing (years):", np.unique(np.diff(sorted(ts.loc[ts.pollen.notna(),'CE'])))[:10])
print("pollen raw n in window:", ts.loc[(ts.CE>=-2000)&(ts.CE<=-1100),'pollen'].notna().sum())

# grate convention
w = ts[(ts.CE>=-2100)&(ts.CE<=-1000)].copy()
w['lag100']=w.pollen_inter.shift(100)
w['manual_pct']=(w.pollen_inter-w.lag100)/w.lag100
print("\npollen_grate_100 vs (x_t - x_{t-100})/x_{t-100}: corr", np.corrcoef(w.pollen_grate_100.fillna(0), w.manual_pct.fillna(0))[0,1].round(4))
w['lag1']=w.pollen_inter.diff()
print("sign(grate) == sign(1y diff) frac:", (np.sign(w.pollen_grate_100)==np.sign(w.lag1)).mean().round(3))
print("grate range:", w.pollen_grate_100.min(), w.pollen_grate_100.max())

# feasibility probe (NOT the final analysis): century-level growth in window
ts['BCE']=-ts.CE
bin_edges=list(range(2000,1000,-100))
ts['cent']=(ts.BCE//100)*100
win=ts[(ts.BCE>=1100)&(ts.BCE<=2000)]
rows=[]
for c,g in win.groupby('cent'):
    rows.append(dict(century_BCE=f"{c-99}–{c}", mean_g_all=g.g_all_mean.mean(), max_g_all=g.g_all_mean.max(),
                     kde_start=g.kde_all_mean.iloc[0], kde_end=g.kde_all_mean.iloc[-1],
                     kde_rel_change=g.kde_all_mean.iloc[-1]/g.kde_all_mean.iloc[0]-1,
                     pollen_grate_100=g.pollen_grate_100.mean(),
                     n_raw_pollen=g.pollen.notna().sum()))
probe=pd.DataFrame(rows).sort_values('mean_g_all',ascending=False)
print("\nFEASIBILITY PROBE (century means of KDE growth rate, window 2000-1100 BCE):")
print(probe.to_string(index=False))
