import pandas as pd, numpy as np
pd.set_option('display.width',220)
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
for c in pol.columns:
    if str(pol[c].dtype) in ('object','str','string'):
        pol[c]=pd.to_numeric(pol[c].astype(str).str.replace(',','.'), errors='coerce')
p=pol.set_index('CE')
idx=ts.loc[ts.pollen.notna(),'CE']
cmp=pd.DataFrame({'CE':idx,'ts.pollen':ts.loc[ts.pollen.notna(),'pollen'].values})
for src in ['Belau_PC1','Woserin_PC1','MEAN','SMOOTH_MEAN_50y']:
    cmp[src]=p[src].reindex(cmp.CE).values
    print(f"ts.pollen vs {src}: exact-match frac = {np.isclose(cmp['ts.pollen'], cmp[src], equal_nan=True).mean():.3f}")
# pollen_inter provenance: compare at raw points
for src in ['Belau_PC1','MEAN']:
    v=p[src].reindex(cmp.CE).values
    iv=ts.loc[ts.pollen.notna(),'pollen_inter'].values
    print(f"pollen_inter at raw pts vs {src}: corr {np.corrcoef(v,iv)[0,1]:.4f}, meanabsdiff {np.nanmean(np.abs(v-iv)):.3f}")
# edge behaviour of pollen_inter (backfill/ffill)
print("\npollen_inter first 3 / last 3:", ts.pollen_inter.head(3).tolist(), ts.pollen_inter.tail(3).tolist())
print("pollen_inter n unique:", ts.pollen_inter.nunique(), "| std:", ts.pollen_inter.std().round(3))
print("first raw pollen CE:", ts.loc[ts.pollen.notna(),'CE'].min(), "last:", ts.loc[ts.pollen.notna(),'CE'].max())
# grate candidates
w=ts.dropna(subset=['pollen_grate_100']).copy()
cands={
 '100y_pct_of_inter': (w.pollen_inter/w.pollen_inter.shift(100)-1),
 '1y_pct_of_inter': (w.pollen_inter.pct_change()),
 '1y_pct_of_inter100': (w.pollen_inter_100/w.pollen_inter_100.shift(1)-1),
 '100y_pct_of_inter100': (w.pollen_inter_100/w.pollen_inter_100.shift(100)-1),
 '1y_pct_of_detrend': (w.pollen_detrend.pct_change()),
}
for k,v in cands.items():
    v=v.replace([np.inf,-np.inf],np.nan)
    m=w.pollen_grate_100.corr(v)
    print(f"grate_100 vs {k}: corr={m:.4f} maxabsdiff={np.nanmax(np.abs(w.pollen_grate_100-v)):.5f}")
# kde peak location (context for boundary artifacts)
i=ts.kde_all_mean.idxmax(); print("\nkde_all_mean peak at CE", ts.loc[i,'CE'], "value", ts.loc[i,'kde_all_mean'])
print("g_all_mean zero-crossings near window:")
w2=ts[(ts.CE>=-2100)&(ts.CE<=-1000)]
print(w2.loc[np.diff(np.sign(w2.g_all_mean.values))!=0,['CE','g_all_mean']].tail(12).to_string(index=False))
