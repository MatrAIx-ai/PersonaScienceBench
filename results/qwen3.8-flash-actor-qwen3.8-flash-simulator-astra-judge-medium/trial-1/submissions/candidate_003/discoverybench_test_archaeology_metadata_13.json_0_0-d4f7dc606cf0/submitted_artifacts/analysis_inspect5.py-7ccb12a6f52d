import pandas as pd, numpy as np
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
w=ts.dropna(subset=['pollen_grate_100'])
g=w.pollen_grate_100
cands={
 'g_all_mean': w.g_all_mean,
 'logdiff_inter_1y': np.log(w.pollen_inter/w.pollen_inter.shift(1)),
 'logdiff_inter100_1y': np.log(w.pollen_inter_100/w.pollen_inter_100.shift(1)),
 'diff_detrend_1y': w.pollen_detrend.diff(),
 'diff_inter_100y': w.pollen_inter.diff(100),
 'diff_inter100_100y': w.pollen_inter_100.diff(100),
 'diff_inter100_1y': w.pollen_inter_100.diff(),
}
for k,v in cands.items():
    v=v.replace([np.inf,-np.inf],np.nan)
    print(f"grate_100 vs {k}: corr={g.corr(v):+.4f}  signagree={np.sign(g).eq(np.sign(v)).mean():.3f}")
print("grate_100 describe:\n", g.describe())
print("n zero:", (g==0).sum(), "n unique:", g.nunique(), "first nonzero idx CE:", w.loc[g!=0,'CE'].head(3).tolist(), w.loc[g!=0,'CE'].tail(3).tolist())
z = np.sign(ts.g_all_mean.values[:-1]) != np.sign(ts.g_all_mean.values[1:])
ces = ts.loc[ts.index[:-1][z],'CE']
print("\ng_all_mean sign-change CEs (window +-2100..-1000):", ces[(ces>=-2100)&(ces<=-1000)].tolist())
print("\nkde local maxima in window:", ts.loc[(ts.CE>=-2000)&(ts.CE<=-1100)&(ts.kde_all_mean>ts.kde_all_mean.shift(1))&(ts.kde_all_mean<ts.kde_all_mean.shift(-1)),'CE'].tolist()[:5])
i=ts.loc[(ts.CE>=-2100)&(ts.CE<=-1000),'kde_all_mean'].idxmax(); print("kde peak in window at CE", ts.loc[i,'CE'])
i2=ts.loc[(ts.CE>=-2100)&(ts.CE<=-1000),'g_all_mean'].idxmax(); print("max g_all_mean in window at CE", ts.loc[i2,'CE'])
