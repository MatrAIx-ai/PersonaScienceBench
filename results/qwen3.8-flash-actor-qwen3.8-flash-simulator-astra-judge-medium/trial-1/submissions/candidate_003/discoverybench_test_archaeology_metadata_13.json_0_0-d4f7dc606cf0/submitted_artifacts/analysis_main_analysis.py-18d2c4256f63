"""
Main analysis: highest growth phase within 2000-1100 BCE.
Fixed conventions (stated once, used everywhere):
  C1 CE = -BCE ; calBP = 1950 - CE (no year 0).  Window = BCE 1100..2000.
  C2 Century label: "Nth c. BCE" = BCE years [N*100 .. N*100-99] inclusive, i.e.
     15th c. BCE = 1500-1401 BCE, 12th c. BCE = 1200-1101 BCE.
  C3 capital.csv rows are POINT SAMPLES at the labelled year; the change between
     row X and row X-100 is attributed to the century that *begins* at X
     (X=1500 -> change realised during the 15th c. BCE, 1500-1401).
  C4 pollen_grate_100 is metadata-mislabelled (it is the 1-yr diff of pollen_inter_100)
     -> recomputed proper 100-yr change; used only as corroboration.
"""
import pandas as pd, numpy as np
pd.set_option('display.width',250); pd.set_option('display.max_columns',80)
OUT='analysis/outputs/'

def num(s):
    return pd.to_numeric(s.astype(str).str.replace(',','.'), errors='coerce')

ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
for c in cap.columns[3:]: cap[c]=num(cap[c])
for c in pol.columns:
    if str(pol[c].dtype) in ('object','str','string'): pol[c]=num(pol[c])

Zmap = {'HatchetSword':'ZAxtSchwert','Dagger':'ZDolch','HouseSize':'Zhausgr','CopperGold':'ZCU_AU',
        'Amber':'Zamber','MonumentCount':'ZMonument','Depot':'ZHort','Sickle':'ZSichel',
        'AxesCelts':'ZBeil','MonumentSize':'ZMW','PotteryForm':'ZKeform','PotteryDecoration':'Zkeverz'}
CLASS = {'HatchetSword':'symbolic','Dagger':'symbolic','HouseSize':'symbolic',
         'CopperGold':'social','Amber':'social','MonumentCount':'social',
         'PotteryForm':'cultural','PotteryDecoration':'cultural',
         'Depot':'economic','Sickle':'economic','AxesCelts':'economic','MonumentSize':'economic'}

# ---------- C2 century binning ----------
ts['BCE'] = -ts.CE
def cent_ceil(b): return np.ceil(b/100).astype(int)      # 1500..1401 -> 15
def cent_shift(b): return np.ceil((b-50)/100).astype(int) # 50-yr shifted blocks (robustness)
ts['cent']  = cent_ceil(ts.BCE)
ts['cent_s']= cent_shift(ts.BCE)
ts['detrend_gr']= ts.kde_all_detrend.diff()   # computed on the full yearly series (no group-edge NaNs)
def lab(n):  return f"{n}th c. BCE ({n*100}-{n*100-99} BCE)"
def labs(n): return f"shift block {n*100-50}..{n*100-149} BCE"

# ---------- C4 pollen: exclude constant fill, recompute proper 100-yr change ----------
first_raw, last_raw = ts.loc[ts.pollen.notna(),'CE'].min(), ts.loc[ts.pollen.notna(),'CE'].max()
ts['pollen_valid'] = (ts.CE>=first_raw)&(ts.CE<=last_raw)
ts['poll_d100'] = ts.pollen_inter_100.diff(100)                     # absolute 100-yr change (PC1 units)
ts['poll_pct100'] = np.where(ts.pollen_inter_100.shift(100).abs()>0.5,
                             ts.pollen_inter_100/ts.pollen_inter_100.shift(100)-1, np.nan)  # % only where |base| meaningful
WIN_IN  = ts[(ts.BCE>=1100)&(ts.BCE<=2000)].copy()   # inclusive endpoints
WIN_EX  = ts[(ts.BCE>1100)&(ts.BCE<2000)].copy()     # strictly between -> full centuries only

print(f"[pollen] raw Belau points CE {first_raw}..{last_raw}; fill-artefact rows outside this range: "
      f"{int((~ts.pollen_valid).sum())}; inside window: {int((~WIN_IN.pollen_valid).sum())}")
print(f"[pollen] longest constant stretch of pollen_inter inside window: "
      f"{WIN_IN.pollen_inter.diff().eq(0).groupby(WIN_IN.pollen_inter.diff().ne(0).cumsum()).size().max()} yr")

# ---------- (2a/2b) per-century rate and level ----------
def century_table(df, key, labelfn):
    rows=[]
    for n,g in df.groupby(key):
        k0,k1 = g.kde_all_mean.iloc[0], g.kde_all_mean.iloc[-1]
        rows.append(dict(bin=n, label=labelfn(n), years=len(g),
            mean_g_all=g.g_all_mean.mean(), se_g=g.g_all_std.mean()/np.sqrt(len(g)),
            max_g_all=g.g_all_mean.max(),
            kde_start=k0, kde_end=k1, kde_rel_change=k1/k0-1,
            kde_log_change=np.log(k1/k0),
            yrs_pos=int((g.g_all_mean>0).sum()),
            mean_detrend_gr=g.detrend_gr.mean()))
    return pd.DataFrame(rows).sort_values('mean_g_all', ascending=False).reset_index(drop=True)

T_in  = century_table(WIN_IN,'cent',lab)
T_ex  = century_table(WIN_EX,'cent',lab)
T_sh  = century_table(WIN_IN,'cent_s',labs)
for T in (T_in,T_ex,T_sh):
    T['rank_rate']=T.mean_g_all.rank(ascending=False).astype(int)
    T['rank_level']=T.kde_rel_change.rank(ascending=False).astype(int)
    T['rank_detrend']=T.mean_detrend_gr.rank(ascending=False).astype('Int64')

# ---------- (2c) sustained positive-growth runs ----------
s=(ts.g_all_mean>0).astype(int); grp=(s!=s.shift()).cumsum()
runs=(ts[s==1].assign(run=grp[s==1]).groupby('run')
        .agg(start_CE=('CE','min'), end_CE=('CE','max'), yrs=('CE','size'),
             cum_log_growth=('g_all_mean','sum'), mean_g=('g_all_mean','mean'),
             max_g=('g_all_mean','max')).reset_index(drop=True))
runs=runs[runs.start_CE<=-1100].copy()
runs['start_BCE']=-runs.start_CE; runs['end_BCE']=-runs.end_CE
runs=runs[(runs.end_BCE<=2000)&(runs.start_BCE>=1100)]
runs['centuries_covered']=runs.apply(lambda r: f"{cent_ceil(pd.Series([r.end_BCE])).iloc[0]}th -> {cent_ceil(pd.Series([r.start_BCE])).iloc[0]}th c. BCE", axis=1)
runs['kde_level_change_%']=(np.exp(runs.cum_log_growth)-1)*100

# ---------- (4) multi-indicator consensus ----------
zc=list(Zmap.values()); cap['cent_from']=cap.BCE   # interval start (older)
capL = cap.sort_values('BCE',ascending=False).reset_index(drop=True)   # chronological: old -> new
rows=[]
for i in range(len(capL)-1):
    old,new = capL.iloc[i], capL.iloc[i+1]
    d={c: new[Zmap[c]]-old[Zmap[c]] for c in Zmap}
    n_from=int(old.BCE); n_to=int(new.BCE)
    if not (1100<=n_to<=2000 or 1100<=n_from<=2000): continue
    rows.append(dict(interval=f"{n_from}->{n_to} BCE", cent_label=f"{n_from//100}th c. BCE ({n_from}-{n_from-99} BCE)",
        cent=n_from//100, n_rising=sum(1 for v in d.values() if v>0), sum_dZ=sum(d.values()),
        mean_dZ=np.mean(list(d.values())), **{k:round(v,2) for k,v in d.items()},
        symbolic=round(sum(d[k] for k,v in CLASS.items() if CLASS[k]=='symbolic'),2),
        social=round(sum(d[k] for k,v in CLASS.items() if CLASS[k]=='social'),2),
        cultural=round(sum(d[k] for k,v in CLASS.items() if CLASS[k]=='cultural'),2),
        economic=round(sum(d[k] for k,v in CLASS.items() if CLASS[k]=='economic'),2)))
IND=pd.DataFrame(rows)
IND['rank']=IND.sum_dZ.rank(ascending=False).astype(int)

# ---------- (3) pollen per century (proper 100-yr change) ----------
pw=WIN_IN[WIN_IN.pollen_valid]
pol_tab=(pw.groupby('cent').agg(pollen_d100_mean=('poll_d100','mean'), pollen_pct100_mean=('poll_pct100','mean'),
        pollen_inter_100_end=('pollen_inter_100','last'), n_raw_pts=('pollen','count'),
        metadata_grate_100=('pollen_grate_100','mean')).reset_index())
pol_tab['label']=pol_tab.cent.map(lab)

# ---------- save ----------
T_in.to_csv(OUT+'T1_primary_century_table.csv',index=False)
T_ex.to_csv(OUT+'T2a_exclusive_edge_variant.csv',index=False)
T_sh.to_csv(OUT+'T2b_shifted_bin_robustness.csv',index=False)
runs.to_csv(OUT+'T3_sustained_positive_runs.csv',index=False)
IND.to_csv(OUT+'T4_indicator_consensus.csv',index=False)
pol_tab.to_csv(OUT+'T5_pollen_corroboration.csv',index=False)

print("\n===== T1 PRIMARY: century ranking, 2000-1100 BCE inclusive (rate = mean g_all_mean) =====")
print(T_in[['rank_rate','label','years','mean_g_all','se_g','max_g_all','kde_rel_change','rank_level','yrs_pos']].round(6).to_string(index=False))
print("\n===== T2a EXCLUSIVE edge (1100<BCE<2000, full centuries only) =====")
print(T_ex[['rank_rate','label','years','mean_g_all','kde_rel_change','rank_level','yrs_pos']].round(6).to_string(index=False))
print("\n----- edge-variant head-to-head for the two critical centuries (incl. vs excl. 1100/2000) -----")
cmp=T_in[['bin','label','years','mean_g_all','kde_rel_change']].rename(columns={'years':'n_incl'}).merge(T_ex[['bin','years','mean_g_all','kde_rel_change']].rename(columns={'years':'n_excl'}),on='bin',suffixes=('_incl','_excl'))
cmp['delta_mean_g']=cmp.mean_g_all_incl-cmp.mean_g_all_excl
print(cmp[cmp.bin.isin([11,12,13,14,20])].round(6).to_string(index=False))
print("\n===== T2b SHIFTED-BIN robustness (blocks offset 50 yr) =====")
print(T_sh[['rank_rate','label','mean_g_all','kde_rel_change','rank_level']].round(6).to_string(index=False))
print("\n===== T3 sustained positive g_all_mean runs inside window =====")
print(runs[['start_BCE','end_BCE','yrs','centuries_covered','mean_g','max_g','cum_log_growth','kde_level_change_%']].round(5).to_string(index=False))
print("\n===== T4 12-indicator delta-Z consensus by century (Z = standardised intensity) =====")
print(IND[['rank','cent_label','interval','n_rising','sum_dZ','mean_dZ','symbolic','social','cultural','economic']].to_string(index=False))
print("\n----- per-indicator deltas, top century and the counter-signal century -----")
top=IND.iloc[IND['rank'].values.argmin()]
print(IND.loc[IND['rank'].isin([1,2,3,IND['rank'].max()-1,IND['rank'].max()]),
    ['cent_label','interval','n_rising','sum_dZ']+list(Zmap)].to_string(index=False))
print("\n===== T5 pollen openness (Belau PC1) per century -- CORROBORATING ONLY =====")
print(pol_tab[['label','n_raw_pts','pollen_d100_mean','pollen_pct100_mean','metadata_grate_100']].round(5).to_string(index=False))
