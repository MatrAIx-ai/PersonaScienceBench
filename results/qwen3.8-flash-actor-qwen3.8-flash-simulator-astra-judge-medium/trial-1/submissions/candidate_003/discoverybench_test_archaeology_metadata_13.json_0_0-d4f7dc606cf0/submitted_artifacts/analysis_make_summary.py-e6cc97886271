import pandas as pd, os
OUT='analysis/outputs/'
pd.set_option('display.width',250)
def md(f,cols=None,r=None):
    d=pd.read_csv(OUT+f)
    if cols: d=d[cols]
    if r: d=d.round(r)
    return d.to_string(index=False)
P=[]
P.append("# Highest growth phase, 2000-1100 BCE\n\nFixed conventions: C1 CE=-BCE, calBP=1950-CE (no year 0). "
 "C2 'Nth c. BCE' = years [N*100 .. N*100-99] (15th c. = 1500-1401 BCE). "
 "C3 capital rows are point samples at the labelled year; a delta is attributed to the century BEGINNING at the older sample. "
 "C4 metadata pollen_grate_100 is NOT used as evidence (it is the 1-yr diff of pollen_inter_100); a proper 100-yr change was recomputed.\n")
P.append("## T1 PRIMARY ranked century table (rate = mean g_all_mean; window 2000-1100 BCE inclusive)\n"
 +md('T1_primary_century_table.csv',['rank_rate','label','years','mean_g_all','se_g','max_g_all','yrs_pos','kde_rel_change','rank_level','rank_detrend'],6))
P.append("## T2a edge variant: strictly between (1100 < BCE < 2000)\n"+md('T2a_exclusive_edge_variant.csv',['rank_rate','label','years','mean_g_all','yrs_pos','kde_rel_change','rank_level'],6))
P.append("## T2b shifted-bin robustness (100-yr blocks offset by 50 yr)\n"+md('T2b_shifted_bin_robustness.csv',['rank_rate','label','mean_g_all','kde_rel_change','rank_level'],6))
P.append("## T3 sustained positive-growth runs inside the window (PHASE EXTENT)\n"+md('T3_sustained_positive_runs.csv',['start_BCE','end_BCE','yrs','centuries_covered','mean_g','max_g','cum_log_growth','kde_level_change_%'],5))
P.append("## T4 12-indicator delta-Z consensus per century (Z = standardised intensity)\n"+md('T4_indicator_consensus.csv',['rank','cent_label','interval','n_rising','sum_dZ','mean_dZ','symbolic','social','cultural','economic']))
P.append("## T5 pollen openness, Belau PC1 (CORROBORATING ONLY; 5-6 raw pts/century)\n"+md('T5_pollen_corroboration.csv',['label','n_raw_pts','pollen_d100_mean','pollen_pct100_mean'],5))
P.append("## T6 moving-block bootstrap (4000 reps, 10-yr blocks) on century mean rate\n"+md('T6_bootstrap_uncertainty.csv',['label','mean','boot_lo','boot_hi','P_rank1','P_top2'],6))
P.append("## T7 AGREEMENT / DISAGREEMENT matrix (4 streams; +1 = growth in that stream)\n"+md('T7_agreement_matrix.csv',['label','s_rate','rank_rate','s_level','rank_level','s_ind','rank_ind','s_pollen','rank_pollen','n_positive_streams']))
P.append("## T8 sliding (bin-free) 100-yr windows, top 10 by mean rate\n"+md('T8_sliding_100yr_windows.csv').split('\n')[:11].__str__().replace('\\n','\n'))
P.append("## T9 attribution sensitivity of the indicator deltas\n"+md('T9_attribution_sensitivity.csv',['interval','sum_dZ','n_rising','attrib_C3_century','attrib_alt_century'],4))
P.append("## T10 pollen metadata-column sign check (why it is corroborating only)\n"+md('T10_pollen_column_signcheck.csv',['label','pollen_d100_mean','sign_recomputed','metadata_grate_100','sign_metadata_col','sign_disagree'],6))
open(OUT+'SUMMARY.md','w').write('\n\n'.join(P)+'\n')
print("wrote", OUT+'SUMMARY.md', os.path.getsize(OUT+'SUMMARY.md'), 'bytes')
print(sorted(os.listdir(OUT)))
