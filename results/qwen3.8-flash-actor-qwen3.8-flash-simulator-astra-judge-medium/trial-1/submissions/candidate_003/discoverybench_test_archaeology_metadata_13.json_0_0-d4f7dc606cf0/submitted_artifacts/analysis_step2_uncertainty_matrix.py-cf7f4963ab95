"""Uncertainty (moving-block bootstrap on annual rates) + four-stream agreement matrix."""
import pandas as pd, numpy as np
pd.set_option('display.width',250)
OUT='analysis/outputs/'
rng=np.random.default_rng(20261023)
T=pd.read_csv(OUT+'T1_primary_century_table.csv')
IND=pd.read_csv(OUT+'T4_indicator_consensus.csv')
POL=pd.read_csv(OUT+'T5_pollen_corroboration.csv')
ts=pd.read_csv('data/time_series_data.csv',index_col=0); ts['BCE']=-ts.CE
ts['cent']=np.ceil(ts.BCE/100).astype(int)
w=ts[(ts.BCE>=1100)&(ts.BCE<=2000)]

# ---- moving-block bootstrap of century mean growth rate (block=10 yr, autocorrelation preserved)
L=10; reps=4000; cents=sorted(T.bin); boots={c:[] for c in cents}
series={c:g.g_all_mean.values for c,g in w.groupby('cent')}
for _ in range(reps):
    for c in cents:
        x=series[c]; n=len(x); nb=int(np.ceil(n/L))
        starts=rng.integers(0,max(1,n-L),(nb,))
        samp=np.concatenate([x[s:s+L] for s in starts])[:n]
        boots[c].append(samp.mean())
B=pd.DataFrame({c:boots[c] for c in cents})
ci=pd.DataFrame({'bin':cents,
   'mean':[series[c].mean() for c in cents],
   'boot_lo':[np.percentile(B[c],2.5) for c in cents],
   'boot_hi':[np.percentile(B[c],97.5) for c in cents],
   'P_rank1':[0]*len(cents)})
best=B.idxmax(axis=1).value_counts(normalize=True)
ci['P_rank1']=[best.get(c,0) for c in cents]
ci['P_top2']=[np.mean((B.rank(axis=1,ascending=False)<=2)[c]) for c in cents]
ci['label']=ci.bin.map(lambda n:f"{n}th c. BCE ({n*100}-{n*100-99} BCE)")
ci=ci.sort_values('mean',ascending=False)
print("===== BOOTSTRAP (4000 moving-block reps, 10-yr blocks) on century mean g_all_mean =====")
print(ci[['label','mean','boot_lo','boot_hi','P_rank1','P_top2']].round(6).to_string(index=False))
ci.to_csv(OUT+'T6_bootstrap_uncertainty.csv',index=False)

# ---- four-stream agreement matrix ----
M=T[['bin','label','mean_g_all','kde_rel_change']].merge(
   IND[['cent','sum_dZ','n_rising','symbolic','social','cultural','economic']].rename(columns={'cent':'bin'}),on='bin',how='left').merge(
   POL[['cent','pollen_d100_mean']].rename(columns={'cent':'bin'}),on='bin',how='left').sort_values('bin',ascending=False)
def rk(s,asc=False): return s.rank(ascending=asc,method='min')
M['r_rate']=rk(M.mean_g_all); r=M.mean_g_all.rank(ascending=False)
M['s_rate']=np.sign(M.mean_g_all)
M['s_level']=np.sign(M.kde_rel_change)
M['s_ind']=np.sign(M.sum_dZ)
M['s_pollen']=np.sign(M.pollen_d100_mean)
M['n_positive_streams']=(M[['s_rate','s_level','s_ind','s_pollen']]>0).sum(axis=1)
M['n_negative_streams']=(M[['s_rate','s_level','s_ind','s_pollen']]<0).sum(axis=1)
M['rank_rate']=M.mean_g_all.rank(ascending=False).astype(int)
M['rank_level']=M.kde_rel_change.rank(ascending=False).astype(int)
M['rank_ind']=M.sum_dZ.rank(ascending=False).astype(int)
M['rank_pollen']=M.pollen_d100_mean.rank(ascending=False).astype(int)
print("\n===== AGREEMENT / DISAGREEMENT MATRIX (4 evidence streams; +1 = growth in that stream) =====")
print(M[['label','s_rate','rank_rate','s_level','rank_level','s_ind','rank_ind','s_pollen','rank_pollen','n_positive_streams']].to_string(index=False))
M.to_csv(OUT+'T7_agreement_matrix.csv',index=False)

# ---- rank correlation between streams ----
sub=M.dropna(subset=['sum_dZ','pollen_d100_mean'])
print("\nSpearman across the 10 window centuries:")
print(" rate vs level      :", round(sub.mean_g_all.corr(sub.kde_rel_change,method='spearman'),3))
print(" rate vs indicators :", round(sub.mean_g_all.corr(sub.sum_dZ,method='spearman'),3))
print(" rate vs pollen     :", round(sub.mean_g_all.corr(sub.pollen_d100_mean,method='spearman'),3))
print(" level vs indicators:", round(sub.kde_rel_change.corr(sub.sum_dZ,method='spearman'),3))
print(" indicators vs pollen:", round(sub.sum_dZ.corr(sub.pollen_d100_mean,method='spearman'),3))

# ---- where level and rate genuinely differ ----
print("\nLevel argument (NOT used for the phase): kde_all_mean max inside window at BCE",
      int(-w.loc[w.kde_all_mean.idxmax(),"CE"]),
      "| global max at BCE", int(-ts.loc[ts.kde_all_mean.idxmax(),'CE']))
print("Rate argument: g_all_mean max at BCE", int(-ts.loc[w.g_all_mean.idxmax(),'CE']),
      "; zero-crossings bounding the main run: 1653 BCE and 1299 BCE")
