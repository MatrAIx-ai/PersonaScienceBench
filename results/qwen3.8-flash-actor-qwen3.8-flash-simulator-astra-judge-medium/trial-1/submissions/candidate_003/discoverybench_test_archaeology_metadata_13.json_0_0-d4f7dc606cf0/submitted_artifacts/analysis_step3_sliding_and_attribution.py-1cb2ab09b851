"""Binning-free peak location (sliding 100-yr windows) + indicator attribution sensitivity."""
import pandas as pd, numpy as np
pd.set_option('display.width',250)
OUT='analysis/outputs/'
ts=pd.read_csv('data/time_series_data.csv',index_col=0); ts['BCE']=-ts.CE
cap=pd.read_csv('data/capital.csv')
zc=[c for c in cap.columns if c.startswith('Z')]
for c in zc: cap[c]=pd.to_numeric(cap[c].astype(str).str.replace(',','.'),errors='coerce')

# ---- sliding 100-yr windows, 1-yr step, window START year inside 2000..1100 BCE ----
w=ts.sort_values('BCE',ascending=False)          # chronological: old -> young
s=w.g_all_mean.rolling(100).mean()
res=pd.DataFrame({'start_BCE':w.BCE,'mean_g_100yr':s}).dropna()
res=res[(res.start_BCE<=2000)&(res.start_BCE>=1200)]     # window fully inside 2000-1100 BCE
res['end_BCE']=res.start_BCE-99
print("===== SLIDING 100-yr window (bin-free) : top 8 by mean g_all_mean =====")
print(res.nlargest(8,'mean_g_100yr').round(6).to_string(index=False))
b=res.loc[res.mean_g_100yr.idxmax()]
print(f"argmax window: {int(b.start_BCE)}-{int(b.end_BCE)} BCE  (mean {b.mean_g_100yr:.6f})")
print("native 15th c. BCE (1500-1401) mean: %.6f  | percentile of that value among all sliding windows: %.1f%%"
      % (w[(w.BCE<=1500)&(w.BCE>=1401)].g_all_mean.mean(),
         100*(res.mean_g_100yr < w[(w.BCE<=1500)&(w.BCE>=1401)].g_all_mean.mean()).mean()))
# sliding peak of LEVEL change
lev=(w.kde_all_mean.shift(-99)/w.kde_all_mean-1)
rl=pd.DataFrame({'start_BCE':w.BCE,'rel_change_100yr':lev}).dropna()
rl=rl[(rl.start_BCE<=2000)&(rl.start_BCE>=1200)]
print("\nTop 5 sliding windows by 100-yr RELATIVE LEVEL change (level argument, kept separate):")
print(rl.nlargest(5,'rel_change_100yr').round(4).to_string(index=False))
res.to_csv(OUT+'T8_sliding_100yr_windows.csv',index=False)

# ---- attribution sensitivity for the indicator deltas ----
cl=cap.sort_values('BCE',ascending=False).reset_index(drop=True)
rows=[]
for i in range(len(cl)-1):
    old,new=cl.iloc[i],cl.iloc[i+1]
    d=(new[zc]-old[zc]); 
    if not (1100<=new.BCE<=2000 or 1100<=old.BCE<=2000): continue
    rows.append(dict(interval=f"{int(old.BCE)}->{int(new.BCE)} BCE", sum_dZ=d.sum(), n_rising=int((d>0).sum()),
                     attrib_C3_century=int(old.BCE)//100, attrib_alt_century=int(old.BCE)//100-1))
A=pd.DataFrame(rows)
print("\n===== attribution sensitivity: convention C3 (change attributed to century BEGINNING at the older sample)")
print(A.sort_values('sum_dZ',ascending=False).head(4).to_string(index=False))
print("... vs alternative (attributed to the younger century): the top interval 1500->1400 BCE becomes '14th c. BCE'")
print("Tie-breaker: annual g_all_mean maximum is at 1443 BCE, which lies INSIDE 1500-1401 BCE -> supports C3.")
A.to_csv(OUT+'T9_attribution_sensitivity.csv',index=False)

# ---- what the mislabelled pollen column would have said vs the recomputed change ----
T=pd.read_csv(OUT+'T1_primary_century_table.csv'); P=pd.read_csv(OUT+'T5_pollen_corroboration.csv')
J=T[['bin','label','mean_g_all']].merge(P[['cent','pollen_d100_mean','metadata_grate_100']],left_on='bin',right_on='cent')
J['sign_recomputed']=np.sign(J.pollen_d100_mean).astype(int); J['sign_metadata_col']=np.sign(J.metadata_grate_100).astype(int)
J['sign_disagree']=J.sign_recomputed!=J.sign_metadata_col
print("\n===== pollen column check: metadata pollen_grate_100 vs recomputed proper 100-yr change =====")
print(J[['label','pollen_d100_mean','sign_recomputed','metadata_grate_100','sign_metadata_col','sign_disagree']].round(6).to_string(index=False))
print("centuries where the metadata column has the OPPOSITE sign: %d / %d" % (J.sign_disagree.sum(), len(J)))
J.to_csv(OUT+'T10_pollen_column_signcheck.csv',index=False)
