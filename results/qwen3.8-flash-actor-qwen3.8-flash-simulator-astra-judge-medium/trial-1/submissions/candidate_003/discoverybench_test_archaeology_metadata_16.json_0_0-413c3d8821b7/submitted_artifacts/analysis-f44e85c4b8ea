tab["pollen_smooth100_binmean"] = tab["BCE"].map(poll_bin)
ok = np.isfinite(tab["pollen_smooth100_binmean"].astype(float))
r = float(np.corrcoef(tab.loc[ok,"PC1"], tab.loc[ok,"pollen_smooth100_binmean"])[0,1])
print("\n=== POLLEN CONTEXT (Belau+Woserin SMOOTH_MEAN_100y, binned) ===")
print("corr(PC1, pollen) over bins with pollen data: %.3f (n=%d of 39; bins BCE<=700 have no pollen coverage)" % (r, ok.sum()))
for ph_,(a,b) in {"MN":(3400,3000),"SG":(2900,2300)}.items():
    m = (tab.BCE>=b)&(tab.BCE<=a)
    print(ph_, "pollen mean %.3f  min %.3f  max %.3f" % (tab.loc[m,"pollen_smooth100_binmean"].mean(),
          tab.loc[m,"pollen_smooth100_binmean"].min(), tab.loc[m,"pollen_smooth100_binmean"].max()))


# ---------- 3) PHASE DIFFERENCE TESTS ----------
from math import sqrt
mn = sc.loc[(sc.index>=3000)&(sc.index<=3400),"PC1"]; sg = sc.loc[(sc.index>=2300)&(sc.index<=2900),"PC1"]
t = (mn.mean()-sg.mean())/sqrt(mn.var(ddof=1)/len(mn)+sg.var(ddof=1)/len(sg))
dfw = (mn.var(ddof=1)/len(mn)+sg.var(ddof=1)/len(sg))**2/((mn.var(ddof=1)/len(mn))**2/(len(mn)-1)+(sg.var(ddof=1)/len(sg))**2/(len(sg)-1))
try:
    from scipy import stats as st
    tw, pw = st.ttest_ind(mn, sg, equal_var=False); welch_p = float(pw)
except Exception:
    from math import erf, sqrt as _s
    welch_p = float(2*(1-0.5*(1+erf(abs(t)/_s(2)))))  # normal approx fallback
print("welch_p=%.4f" % welch_p)
print("\nWelch t(MN vs SG) = %.3f  df=%.1f  | Cohen d (pooled) = %.3f" % (t, dfw,
      (mn.mean()-sg.mean())/sqrt(((len(mn)-1)*mn.var(ddof=1)+(len(sg)-1)*sg.var(ddof=1))/(len(mn)+len(sg)-2))))

# ---------- 4) SENSITIVITY ----------
rows=[]
def variant(name, X_, rule="sum"):
    sc_, L_, ev_ = pca_custom(X_, rule)
    ph = phase_table(sc_, 3400,3000, 2900,2300)
    rows.append(dict(variant=name, n_bins=len(X_), n_vars=X_.shape[1], ev_PC1=round(ev_[0],3),
                     MN_mean=round(ph["MN"]["mean"],3), SG_mean=round(ph["SG"]["mean"],3),
                     diff=round(ph["diff_MN_minus_SG_mean"],3),
                     diff_SD=round(ph["diff_in_SD_of_PC1_series"],3),
                     higher=("MN" if ph["MN"]["mean"]>ph["SG"]["mean"] else "SG"),
                     sign_same_as_main=np.sign(L_["PC1"].sum()) if rule=="sum" else np.sign(L_["PC1"]["ZCU_AU"] if hasattr(L_["PC1"],"ZCU_AU") else L_["PC1"].loc["ZCU_AU"])))
def pca_custom(df, rule="sum"):
    Xl = df.values.astype(float); Xl = (Xl-Xl.mean(0))/Xl.std(0, ddof=0)
    U,S,Vt = np.linalg.svd(Xl-Xl.mean(0), full_matrices=False)
    ev = S**2/(S**2).sum(); Ld = pd.DataFrame(Vt.T, index=df.columns, columns=[f"PC{i+1}" for i in range(Vt.shape[0])])
    Sco = pd.DataFrame(U*S, index=df.index, columns=Ld.columns)
    key = Ld["PC1"].sum() if rule=="sum" else Ld["PC1"].loc["ZCU_AU"]
    if key < 0: Ld["PC1"]*=-1; Sco["PC1"]*=-1
    return Sco, Ld, ev
variant("MAIN: 39 bins, 12 vars, rule=sum(loading)>0", X)
variant("37 bins (drop back-filled 4300/4200)", X.loc[X.index<=4100])
variant("Neolithic only 4300-2300 BCE", X.loc[X.index>=2300])
variant("Neolithic only 3400-2300 BCE", X.loc[(X.index>=2300)&(X.index<=3400)])
variant("11 vars (drop near-constant ZSichel)", X.drop(columns=["ZSichel"]))
variant("rule = ZCU_AU loading > 0", X, rule="zcu")
# exclusive phase boundaries
sc2, L2, ev2 = pca_custom(X)
phE = phase_table(sc2, 3400,3000, 2900,2300, inclusive=False)
rows.append(dict(variant="exclusive phase bounds (MN 3300-3100, SG 2800-2400), main PCA", n_bins=39, n_vars=12,
                 ev_PC1=round(ev2[0],3), MN_mean=round(phE["MN"]["mean"],3), SG_mean=round(phE["SG"]["mean"],3),
                 diff=round(phE["diff_MN_minus_SG_mean"],3), diff_SD=round(phE["diff_in_SD_of_PC1_series"],3),
                 higher=("MN" if phE["MN"]["mean"]>phE["SG"]["mean"] else "SG"), sign_same_as_main=1))
sens = pd.DataFrame(rows)
print("\n=== SENSITIVITY ===")
print(sens.to_string(index=False))

