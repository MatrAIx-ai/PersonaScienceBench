"""PCA on forms of capital in 100-year slices; PC1 profile of Middle Neolithic (MN,
3400-3000 BCE) and Younger Neolithic (SG, 2900-2300 BCE). Pollen kept as context only."""
import numpy as np, pandas as pd

DATA = "data/"
Z = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
     "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
GROUPS = {"symbolic": ["ZAxtSchwert","ZDolch","Zhausgr"],
          "social":   ["ZCU_AU","Zamber","ZMonument"],
          "cultural": ["ZKeform","Zkeverz"],
          "economic": ["ZHort","ZSichel","ZBeil","ZMW"]}
LABEL = {"ZAxtSchwert":"Hatchet&Swords","ZDolch":"Daggers","Zhausgr":"House Size",
         "ZCU_AU":"Copper&Gold","Zamber":"Amber","ZMonument":"Monument Count",
         "ZHort":"Depot","ZSichel":"Sickle","ZBeil":"Axes&Celts","ZMW":"Monument Size",
         "ZKeform":"Pottery Form","Zkeverz":"Pottery Decoration"}

def pca(df):
    """PCA on the correlation matrix of the already-Z-standardised columns (SVD)."""
    X = df.values.astype(float)
    X = (X - X.mean(0)) / X.std(0, ddof=0)          # correlation matrix
    U, S, Vt = np.linalg.svd(X - X.mean(0), full_matrices=False)
    ev = S**2 / (S**2).sum()
    L = pd.DataFrame(Vt.T, index=df.columns, columns=[f"PC{i+1}" for i in range(Vt.shape[0])])
    scores = pd.DataFrame(U * S, index=df.index, columns=L.columns)
    # orientation rule: make the sum of PC1 loadings positive
    if L["PC1"].sum() < 0:
        L["PC1"] *= -1; scores["PC1"] *= -1
    return scores, L, ev

def phase_table(scores, lo1, hi1, lo2, hi2, inclusive=True):
    sel = lambda a,b: ((scores.index<=a)&(scores.index>=b)) if inclusive else ((scores.index<a)&(scores.index>b))
    out = {}
    for name,(a,b) in {"MN":(lo1,hi1),"SG":(lo2,hi2)}.items():
        y = scores.loc[sel(a,b),"PC1"]; x = -y.index.astype(float)   # chronological order
        out[name] = dict(n=len(y), mean=y.mean(), median=y.median(), min=y.min(), max=y.max(),
                         sd_within=float(y.std(ddof=1)) if len(y)>1 else np.nan,
                         slope_per_century=np.polyfit(x, y.values, 1)[0]*100.0,
                         argmin_BCE=int(y.idxmin()), argmax_BCE=int(y.idxmax()))
    sd_series = scores["PC1"].std(ddof=0)
    out["diff_MN_minus_SG_mean"] = out["MN"]["mean"] - out["SG"]["mean"]
    out["diff_in_SD_of_PC1_series"] = out["diff_MN_minus_SG_mean"]/sd_series
    out["sd_PC1_series"] = sd_series
    return out

cap = pd.read_csv(DATA+"capital.csv", decimal=",", index_col=0)
cap = cap.set_index(pd.Index(cap.index, name="BCE"))
group = cap["group"]; X = cap[Z]

# ---------- 1) MAIN RUN ----------
sc, L, ev = pca(X)
tab = pd.DataFrame({"BCE": X.index, "CE": -X.index.values,
                    "group": group.values, "PC1": sc["PC1"].values, "PC2": sc["PC2"].values})
print("=== MAIN: 39 bins x 12 variables, correlation-matrix PCA ===")
print("explained variance PC1-5:", np.round(ev[:5],3))
print("PC1 loading sum:", round(L['PC1'].sum(),3))
cat = [next(g for g,cc in GROUPS.items() if c in cc) for c in L.index]
load = pd.DataFrame({"var":L.index,"capital_form":[LABEL[c] for c in L.index],"category":cat,
                     "PC1_loading":L["PC1"].round(3).values,"PC2_loading":L["PC2"].round(3).values})
print(load.sort_values("PC1_loading", ascending=False).to_string(index=False))
print("\nmean PC1 loading by capital category:")
print(load.groupby("category")["PC1_loading"].agg(["mean","sum"]).round(3).to_string())
print("\nPC1 scores by bin:")
print(tab.to_string(index=False, float_format=lambda v: f"{v:+.3f}"))
ph = phase_table(sc, 3400, 3000, 2900, 2300)
print("\n=== PHASE TABLE (main) ===")
for k,v in ph.items():
    print(k, {kk:(round(vv,4) if isinstance(vv,float) else vv) for kk,vv in v.items()} if isinstance(v,dict) else round(v,4))

# ---------- 2) POLLEN CONTEXT (separate) ----------
pol = pd.read_csv(DATA+"pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv",
                  decimal=",", index_col=0)
pol["BCE"] = -pol["CE"]
