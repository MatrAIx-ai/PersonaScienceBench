"""Inspection-only pass over the three inputs (no PCA, no results).
capital.csv and the pollen file use COMMA decimal separators -> decimal=','.
"""
import pandas as pd, numpy as np

cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv')

Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
     'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']

print('== shapes =='); print('capital', cap.shape, '| pollen', pol.shape, '| time_series', ts.shape)
print('\n== capital grid ==')
print('rows', len(cap), '| BCE', cap.BCE.max(), '->', cap.BCE.min(), '| unique step',
      sorted(cap.BCE.diff().dropna().unique()), '| dups', int(cap.BCE.duplicated().sum()),
      '| NaNs in BCE', int(cap.BCE.isna().sum()))
print('group labels:', cap.groupby('group',sort=False).BCE.agg(['min','max','count']).to_string())

print('\n== missingness / standardization (all 39 rows, 12 Z vars) ==')
print(pd.DataFrame({'n_nan':cap[Z].isna().sum(),'mean':cap[Z].mean().round(3),
                    'sd(ddof=1)':cap[Z].std().round(3),'min':cap[Z].min().round(2),
                    'max':cap[Z].max().round(2)}).to_string())
print('n distinct value-vectors in 12-D space:', cap[Z].drop_duplicates().shape[0], 'of 39')

print('\n== Younger Bronze Age window (group==YBA) ==')
yba = cap[cap.BCE.between(500,1100)]
print('rows with 500<=BCE<=1100:', len(yba), '| BCE values:', list(yba.BCE))
print('source group label for these rows:', sorted(cap.loc[cap.BCE.between(500,1100),'group'].unique()))
print(yba.set_index('BCE').round(3).to_string())
print('within-window sd (0 => constant, unusable in a per-slice PCA):')
print(yba[Z].std().round(3).to_string())

print('\n== cross-check capital.csv vs time_series_data.csv ==')
zt = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount','Depot',
      'Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
tt = ts[ts[zt].notna().all(axis=1)].assign(BCE=lambda d:-d.CE)
j  = cap.merge(tt, on='BCE')
print('matched rows', len(j), '| max abs diff over 12 vars:',
      round(max(np.nanmax(np.abs(j[a]-j[b])) for a,b in zip(Z,zt)), 8))
print('capital BCE not in time_series:', sorted(set(cap.BCE)-set(tt.BCE)))

print('\n== pollen coverage vs YBA bins ==')
print('pollen CE range:', pol.CE.max(), 'to', pol.CE.min(), '(CE negative = BCE)')
print('raw Belau_PC1 non-null:', int(pol.Belau_PC1.notna().sum()), 'of', len(pol),
      '| Belau_PC1_inter non-null:', int(pol.Belau_PC1_inter.notna().sum()))
for b in [1100,1000,900,800,700,600,500]:
    row = pol[(pol.CE==-b) | (pol.calBP==b+1950)]
    print(f'  {b:4d} BCE -> n_rows={len(row):2d}  Belau_PC1_inter='
          f'{row.Belau_PC1_inter.iloc[0] if len(row) else "MISSING"}')
