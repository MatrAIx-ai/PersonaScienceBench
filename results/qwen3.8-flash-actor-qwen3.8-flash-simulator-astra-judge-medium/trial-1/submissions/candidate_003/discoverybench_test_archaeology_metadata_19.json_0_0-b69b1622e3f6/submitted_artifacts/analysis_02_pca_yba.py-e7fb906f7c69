"""PCA on forms of capital (39 rows x 12 Z vars), YBA contrast 1100 BCE vs 1000-500 BCE.
Descriptive only; no significance testing (values are carried forward across bins).
"""
import pandas as pd, numpy as np

Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
     'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
FORMS = {'symbolic':['ZAxtSchwert','ZDolch','Zhausgr'],
         'social'  :['ZCU_AU','Zamber','ZMonument'],
         'cultural':['ZKeform','Zkeverz'],
         'economic':['ZHort','ZSichel','ZBeil','ZMW']}
NAME = dict(zip(Z,['Hatchet&Sword','Dagger','HouseSize','Copper&Gold','Amber','MonumentCount',
                   'Depot','Sickle','Axes/Celts','MonumentSize','PotteryForm','PotteryDecoration']))
YBA = [1100,1000,900,800,700,600,500]

cap = pd.read_csv('data/capital.csv', decimal=',')
X   = cap[Z].astype(float)
BCE = cap.BCE.values

def pca(Xdf):
    """Return loadings (unit norm), scores, explained variance ratio, raw SVD signs."""
    A = Xdf.values - Xdf.values.mean(0)
    U, S, Vt = np.linalg.svd(A, full_matrices=False)
    evr = S**2 / (S**2).sum()
    L   = Vt.T                                  # columns = PC directions
    raw_sign = np.sign(L.sum(0)); raw_sign[raw_sign==0]=1
    L_orient  = L * raw_sign                    # orient: positive sum of the 12 loadings
    scores_or = A @ L_orient
    return dict(L=L, L_orient=L_orient, raw_sign=raw_sign, scores=scores_or,
                evr=evr, mean=Xdf.values.mean(0))

def run(Xdf, tag):
    r = pca(Xdf)
    print('='*78); print(tag)
    print('explained variance ratio (PC1..PC5):', np.round(r['evr'][:5],4),
          '| PC1 %.2f%%  PC2 %.2f%%' % (100*r['evr'][0], 100*r['evr'][1]))
    print('\nPC1 loadings (oriented: positive loading sum) and raw SVD sign:')
    t = pd.DataFrame({'loading_oriented': r['L_orient'][:,0].round(4),
                      'raw_SVD_sign_of_this_PC': np.where(r['raw_sign'][0]>0,'+',' -'),
                      'loading_as_returned_by_SVD': (r['L'][:,0]).round(4)}, index=Z).loc[
                      lambda d: d['loading_oriented'].abs().sort_values(ascending=False).index]
    print(t.to_string())
    print('sum of oriented loadings = %.4f  (sum of raw SVD loadings = %.4f)'
          % (r['L_orient'][:,0].sum(), r['L'][:,0].sum()))
    sc = pd.Series(r['scores'][:,0], index=BCE)
    print('\nPC1 scores, YBA bins (oriented):')
    print(sc.loc[YBA].round(4).to_string())
    print('\n1100 BCE vs each later bin (oriented):')
    for b in YBA[1:]:
        d = sc[1100]-sc[b]
        contrib = pd.Series(r['L_orient'][:,0]*(Xdf.loc[1100 if False else BCE==1100].values[0]
                                                - Xdf.loc[BCE==b].values[0]), index=Z)
        contrib = contrib.sort_values(key=abs, ascending=False)
        forms = pd.Series({k: contrib[v].sum() for k,v in FORMS.items()})
        ysd = cap[cap.BCE.between(500,1100)][Z].std()
        print('  %4d BCE : diff = %+0.4f   (check sum of contribs = %+0.4f)'
              % (b, d, contrib.sum()))
        print('      top vars:', ', '.join(f'{NAME[v]} {c:+.3f}{"*" if ysd[v]<0.15 else ""}'
                                           for v,c in contrib.head(4).items()))
        print('      by form :', ', '.join(f'{k} {v:+.3f}' for k,v in forms.items()))
    return r, sc

# headline: Z as supplied
r1, sc1 = run(X, 'HEADLINE  (Z values as supplied; PCA on all 39 rows)')
# robustness: exact mean 0 / sd 1 over the 39 rows
Xz = (X - X.mean())/X.std(ddof=1)
r2, sc2 = run(Xz, 'ROBUSTNESS  (re-standardized to mean 0 / sd 1 over 39 rows)')

print('='*78)
print('SIGN / ORDERING ROBUSTNESS')
print('PC1 loading sum sign, headline = %+0.3f ; robustness = %+0.3f'
      % (r1['L'][:,0].sum()*r1['raw_sign'][0], r2['L'][:,0].sum()*r2['raw_sign'][0]))
print('raw (unoriented) SVD PC1 loading sums: headline %+0.3f, robustness %+0.3f'
      % (r1['L'][:,0].sum(), r2['L'][:,0].sum()))
print('cos angle between oriented PC1 loadings of the two runs: %.5f'
      % (r1['L_orient'][:,0] @ r2['L_orient'][:,0]))
d1 = pd.Series({b: sc1[1100]-sc1[b] for b in YBA[1:]})
d2 = pd.Series({b: sc2[1100]-sc2[b] for b in YBA[1:]})
cmp = pd.DataFrame({'diff_headline':d1.round(4),'sign_h':np.sign(d1).astype(int),
                    'diff_robust':d2.round(4),'sign_r':np.sign(d2).astype(int)})
cmp['sign_match'] = cmp.sign_h==cmp.sign_r
print(cmp.to_string())
print('ordering of later bins by PC1 score identical?',
      list(sc1.loc[YBA[1:]].sort_values().index)==list(sc2.loc[YBA[1:]].sort_values().index))
print('rank corr of scores across 7 bins: %.3f' % sc1.loc[YBA].corr(sc2.loc[YBA], method='spearman'))
print('loading-change driven by ZSichel sub-unit sd? largest |loading| diff: %s'
      % pd.Series(np.abs(r1['L_orient'][:,0]-r2['L_orient'][:,0]), index=Z).idxmax())
print(pd.Series(r1['L_orient'][:,0]-r2['L_orient'][:,0], index=Z).round(4).sort_values(key=abs,ascending=False).head(5).to_string())

print('='*78); print('WITHIN-YBA VARIABILITY OF DRIVERS (0 = carried forward, not a real change)')
print(cap[cap.BCE.between(500,1100)][Z].std().round(3).rename('sd_within_YBA').to_string())

print('='*78); print('POLLEN (interpretation only, 1100-800 only; Belau record starts 702 BCE)')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
rows=[]
for b in YBA:
    q = pol[pol.CE==-b]
    rows.append((b, sc1[b], q.Belau_PC1_inter.iloc[0] if len(q) else np.nan))
pp = pd.DataFrame(rows, columns=['BCE','PC1_capital','Belau_PC1_inter']).round(4)
print(pp.to_string(index=False))
print('n bins with pollen: %d of 7' % pp.Belau_PC1_inter.notna().sum())
print(pp[['PC1_capital','Belau_PC1_inter']].dropna().corr(method='pearson').round(3).to_string())
