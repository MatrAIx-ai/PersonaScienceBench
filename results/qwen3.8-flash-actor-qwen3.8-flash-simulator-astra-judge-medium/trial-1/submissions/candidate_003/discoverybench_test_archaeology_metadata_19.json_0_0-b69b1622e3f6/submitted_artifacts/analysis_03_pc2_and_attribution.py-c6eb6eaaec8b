import pandas as pd, numpy as np
Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort','ZSichel',
     'ZBeil','ZMW','ZKeform','Zkeverz']
FORMS = {'symbolic':['ZAxtSchwert','ZDolch','Zhausgr'],'social':['ZCU_AU','Zamber','ZMonument'],
         'cultural':['ZKeform','Zkeverz'],'economic':['ZHort','ZSichel','ZBeil','ZMW']}
YBA=[1100,1000,900,800,700,600,500]
cap=pd.read_csv('data/capital.csv',decimal=','); X=cap[Z].astype(float)
A=X.values-X.values.mean(0); U,S,Vt=np.linalg.svd(A,full_matrices=False)
L=Vt.T; L=L*np.sign(L.sum(0)); sc=A@L
sd=cap[cap.BCE.between(500,1100)][Z].std()
print('PC2 explained var %.2f%%; PC2 oriented loadings (positive sum):' % (100*(S**2/(S**2).sum())[1]))
print(pd.Series(L[:,1],index=Z).round(3).to_string())
print('\nPC2 scores YBA:'); print(pd.Series(sc[:,1],index=cap.BCE.values).loc[YBA].round(3).to_string())
print('\nPC1-PC2 ratio |score| per bin:'); s1=pd.Series(sc[:,0],index=cap.BCE.values).loc[YBA]; s2=pd.Series(sc[:,1],index=cap.BCE.values).loc[YBA]
print((s1/s2).round(2).to_string())
print('\nPC1 score as z of the whole 39-row PC1 distribution: 1100 -> %.2f sd; YBA mean %.2f sd'
      % ((s1[1100]-sc[:,0].mean())/sc[:,0].std(), (s1.mean()-sc[:,0].mean())/sc[:,0].std()))
print('rank of 1100 BCE PC1 score among all 39 bins: %d of 39 (1=highest)'
      % int((sc[:,0]>sc[list(cap.BCE).index(1100),0]).sum()+1))
print('\nFULL attribution: contribution = loading_v x (x_v,1100 - x_v,bin); * = sd within YBA < 0.15')
for b in YBA[1:]:
    c=pd.Series(L[:,0]*(X.loc[cap.BCE==1100,Z].values[0]-X.loc[cap.BCE==b,Z].values[0]),index=Z)
    tab=pd.DataFrame({'contrib':c.round(3),'sd_YBA':sd.round(3),
                      'const_flag':np.where(sd<0.15,'CONSTANT/near-const','')})
    tab['form']=[k for v in Z for k,v in FORMS.items() if v_ in v][0] if False else None
    tab['form']={**{z:'symbolic' for z in FORMS['symbolic']},**{z:'social' for z in FORMS['social']},
                 **{z:'cultural' for z in FORMS['cultural']},**{z:'economic' for z in FORMS['economic']}}
    print('\n--- 1100 vs %d (total %+0.3f) ---' % (b, c.sum()))
    print(tab.sort_values('contrib',key=abs,ascending=False).to_string())
