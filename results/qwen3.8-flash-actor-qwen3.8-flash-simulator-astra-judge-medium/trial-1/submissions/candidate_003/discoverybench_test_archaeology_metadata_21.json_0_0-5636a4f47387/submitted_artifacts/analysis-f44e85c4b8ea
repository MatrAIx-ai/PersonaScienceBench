#!/usr/bin/env python3
"""
PCA of forms of capital in 100-year time slices (39 centuries, 4300-500 BCE).

MAIN ANALYSIS (per approved plan):
  * features : all 12 capital forms, ONE PCA (capital.csv, 39 century rows, decimal=',')
  * method   : CORRELATION PCA (each column re-standardised to mean 0 / std 1, ddof=1)
  * reporting loadings: loading = corr(variable, PC score)   (eigenvector also tabulated)
  * variance %: eigenvalues with ddof=1
  * sign convention: PC1 flipped so that its loadings are positive for the majority of
    capital forms (PC1 = "general intensity / accumulation"); PC2 sign fixed by a neutral
    rule (loading of the variable with the largest |PC2 loading| is made positive).
SENSITIVITY (appendix, never mixed into the answer):
  * 37-row matrix (centuries shared with time_series_data.csv)
  * covariance PCA on the raw Z columns
  * symbolic trio only (diagnostic)
  * rolling 15-century windows (signs aligned to the global solution; NOT comparable otherwise)
No weighting of centuries, no pollen data, no extra PCA beyond the above.
"""
import numpy as np, pandas as pd

DATA = "data/capital.csv"
OUT  = "results"

SYM   = ["Zhausgr", "ZDolch", "ZAxtSchwert"]              # House Size, Daggers, Hatchets&Swords
SOC   = ["ZCU_AU", "Zamber", "ZMonument"]
CUL   = ["ZKeform", "Zkeverz"]
ECO   = ["ZHort", "ZSichel", "ZBeil", "ZMW"]
GROUP = {**{v: "symbolic" for v in SYM}, **{v: "social" for v in SOC},
         **{v: "cultural" for v in CUL}, **{v: "economic" for v in ECO}}
ALL12 = SYM + SOC + CUL + ECO
LABEL = {"ZAxtSchwert": "HatchetSword", "ZDolch": "Dagger", "Zhausgr": "HouseSize",
         "ZCU_AU": "CopperGold", "Zamber": "Amber", "ZMonument": "MonumentCount",
         "ZHort": "Depot", "ZSichel": "Sickle", "ZBeil": "AxesCelts",
         "ZMW": "MonumentSize", "ZKeform": "PotteryForm", "Zkeverz": "PotteryDecoration"}
PERIOD_ORDER = ["EN", "MN", "SG", "LN", "OBA", "YBA"]


def pca(Xdf, ddof=1, correlation=True):
    """PCA by SVD. Returns eigenvectors (columns), eigenvalues, scores."""
    X = Xdf.to_numpy(dtype=float)
    Xc = X - X.mean(axis=0)
    if correlation:
        sd = X.std(axis=0, ddof=ddof)
        sd[sd == 0] = np.nan                   # constant column inside a window
        Xc = Xc / sd
        Xc = np.nan_to_num(Xc)                 # zero out constant columns
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    ev = S ** 2 / (X.shape[0] - ddof)          # variances of the components
    scores = Xc @ Vt.T
    return Vt.T, ev, scores


def orient(evec, ev, scores, Xdf, n_pc=2):
    """Fix signs: PC1 positive for the majority of capital forms; PC2 by neutral max rule."""
    Z = (Xdf - Xdf.mean()) / Xdf.std(ddof=1)
    load = np.array([np.corrcoef(Z[c], scores[:, k])[0, 1]
                     for c in Z.columns for k in range(n_pc)]).reshape(len(Z.columns), n_pc)
    evec, scores, load = evec.copy(), scores.copy(), load.copy()
    rules = []
    for k in range(n_pc):
        if k == 0:                                   # PC1: majority of forms positive
            if load[:, 0].sum() < 0:
                s = -1
                rules.append("PC1 flipped: sum(loadings)<0 -> majority of forms positive")
            else:
                s = 1
                rules.append("PC1 already majority-positive (no flip)")
        else:                                        # PC2: neutral max-|loading| rule
            j = int(np.argmax(np.abs(load[:, k])))
            s = 1 if load[j, k] > 0 else -1
            rules.append(f"PC2 sign: made positive for max|loading| variable "
                         f"= {LABEL[Xdf.columns[j]]} ({Xdf.columns[j]})")
        if s < 0:
            evec[:, k] *= -1; scores[:, k] *= -1; load[:, k] *= -1
    return evec, scores, load, rules


def analyse(Xdf, name, ddof=1, correlation=True):
    evec, ev, scores = pca(Xdf, ddof=ddof, correlation=correlation)
    evec, scores, load, rules = orient(evec, ev, scores, Xdf)
    var = ev / ev.sum() * 100.0
    tab = pd.DataFrame({"group": [GROUP[c] for c in Xdf.columns],
                        "variable": [LABEL[c] for c in Xdf.columns]}, index=Xdf.columns)
    tab["eig_PC1"] = evec[:, 0]; tab["eig_PC2"] = evec[:, 1]
    tab["load_PC1"] = load[:, 0]; tab["load_PC2"] = load[:, 1]
    tab["abs_load_PC1"] = tab.load_PC1.abs(); tab["abs_load_PC2"] = tab.load_PC2.abs()
    tab["rank_abs_load_PC1"] = tab.abs_load_PC1.rank(ascending=False).astype(int)
    tab["rank_abs_load_PC2"] = tab.abs_load_PC2.rank(ascending=False).astype(int)
    tab["ratio_PC2_over_PC1"] = tab.abs_load_PC2 / tab.abs_load_PC1
    tab["communality_PC1PC2"] = tab.load_PC1 ** 2 + tab.load_PC2 ** 2
    tab_main = tab.sort_values("abs_load_PC1", ascending=False)
    sc = pd.DataFrame(scores[:, :2], index=Xdf.index, columns=["PC1", "PC2"])
    print(f"\n{'='*88}\n### {name}  ({Xdf.shape[0]} rows x {Xdf.shape[1]} cols, "
          f"{'correlation' if correlation else 'covariance'} PCA, ddof={ddof})")
    print("  variance %:  " + "  ".join(f"PC{i+1}={v:.1f}" for i, v in enumerate(var[:5]))
          + f"   | PC1+PC2={var[0]+var[1]:.1f}")
    for r in rules:
        print("  sign rule:", r)
    print(tab[["group", "variable", "load_PC1", "load_PC2", "eig_PC1", "eig_PC2",
               "rank_abs_load_PC1", "rank_abs_load_PC2", "ratio_PC2_over_PC1",
               "communality_PC1PC2"]].round(3).to_string())
    return tab_main, sc, var, evec


def angles(tab, feats):
    """Angular separation in the PC1-PC2 loading plane: how much PC2 pulls the trio apart."""
    v = {f: np.array([tab.loc[f, "load_PC1"], tab.loc[f, "load_PC2"]]) for f in feats}
    print("  PC1-PC2 plane angles (deg):")
    for i, a in enumerate(feats):
        for b in feats[i + 1:]:
            cos = v[a] @ v[b] / (np.linalg.norm(v[a]) * np.linalg.norm(v[b]))
            print(f"    {LABEL[a]:12s} vs {LABEL[b]:12s} {np.degrees(np.arccos(np.clip(cos,-1,1))):6.1f}")


def main():
    cap = pd.read_csv(DATA, decimal=",").set_index("BCE")
    X39 = cap[ALL12]
    tab, sc, var, evec = analyse(X39, "MAIN: all 12 capital forms, 39 centuries, correlation PCA")

    print("\n--- Symbolic capital in the main solution -------------------------------")
    print(tab.loc[SYM, ["group", "variable", "load_PC1", "rank_abs_load_PC1",
                        "load_PC2", "rank_abs_load_PC2", "eig_PC1", "eig_PC2"]].round(3).to_string())
    print(f"  mean |load_PC1| symbolic = {tab.loc[SYM,'abs_load_PC1'].mean():.3f} vs "
          f"non-symbolic = {tab.loc[[c for c in ALL12 if c not in SYM],'abs_load_PC1'].mean():.3f}")
    print(f"  PC2 sign pattern of trio: "
          + ", ".join(f"{LABEL[c]}={np.sign(tab.loc[c,'load_PC2']):+.0f}" for c in SYM))
    angles(tab, SYM)
    oth = [c for c in ALL12 if c not in SYM]
    print(f"  trio vs rest on PC2: mean sign of non-symbolic PC2 loadings = "
          f"{np.sign(tab.loc[oth,'load_PC2']).sum():+.0f}/9 "
          f"({'mostly same direction' if abs(np.sign(tab.loc[oth,'load_PC2']).sum())==9 else 'mixed'})")

    # (d) PC2 trajectory by archaeological period
    sc = sc.join(cap[["group"]])
    per = sc.groupby("group").agg(PC2_mean=("PC2", "mean"), PC2_std=("PC2", "std"),
                                  PC2_min=("PC2", "min"), PC2_max=("PC2", "max"),
                                  PC1_mean=("PC1", "mean"), n=("PC2", "size")).loc[PERIOD_ORDER]
    print("\n--- PC2 / PC1 scores by period (secondary material) ----------------------")
    print(per.round(3).to_string())
    print(f"  overall PC2 across 39 slices: sd={sc.PC2.std(ddof=1):.3f} "
          f"range=[{sc.PC2.min():.3f}, {sc.PC2.max():.3f}]; PC1 sd={sc.PC1.std(ddof=1):.3f}")

    tab.to_csv(f"{OUT}/loadings_main_39_corr.csv"); sc.to_csv(f"{OUT}/scores_main_39.csv")
    per.to_csv(f"{OUT}/pc2_by_period.csv")
    pd.DataFrame({"variance_pct": var[:6]}).to_csv(f"{OUT}/variance_main.csv")

    # robustness of the qualitative statements: leave-one-century-out jackknife
    print("\n--- Jackknife (leave one century out, 39 runs): stability of the statements --")
    rec = []
    for drop in X39.index:
        sub = X39.drop(index=drop)
        e2, ev2, s2 = pca(sub, ddof=1, correlation=True)
        e2, s2, l2, _ = orient(e2, ev2, s2, sub)
        v2 = ev2 / ev2.sum() * 100
        t2 = pd.DataFrame({"load_PC1": l2[:, 0], "load_PC2": l2[:, 1]}, index=X39.columns)
        rec.append({"dropped_BCE": drop, "varPC1": v2[0], "varPC2": v2[1],
                    **{f"P1_{c}": t2.loc[c, "load_PC1"] for c in SYM},
                    **{f"P2_{c}": t2.loc[c, "load_PC2"] for c in SYM},
                    "rank_P1_worst_of_trio": max(int((t2.load_PC1.abs() >= abs(t2.loc[c, "load_PC1"])).sum()) for c in SYM),
                    "rank_P2_best_of_trio": min(int((t2.load_PC2.abs() >= abs(t2.loc[c, "load_PC2"])).sum()) for c in SYM),
                    "HouseSize_P2_largest_of_trio": abs(t2.loc["Zhausgr", "load_PC2"]) > max(
                        abs(t2.loc["ZDolch", "load_PC2"]), abs(t2.loc["ZAxtSchwert", "load_PC2"])),
                    "trio_P2_same_sign": len({np.sign(t2.loc[c, "load_PC2"]) for c in SYM}) == 1,
                    "trio_P1_all_positive": all(t2.loc[c, "load_PC1"] > 0 for c in SYM)})
    J = pd.DataFrame(rec).set_index("dropped_BCE")
    J.to_csv(f"{OUT}/jackknife_leave_one_century.csv")
    print(J[["P1_Zhausgr", "P1_ZDolch", "P1_ZAxtSchwert", "P2_Zhausgr", "P2_ZDolch",
             "P2_ZAxtSchwert"]].agg(["mean", "std", "min", "max"]).round(3).to_string())
    print(f"  HouseSize has the largest |PC2 loading| of the trio in "
          f"{int(J.HouseSize_P2_largest_of_trio.sum())}/39 jackknife runs")
    print(f"  trio PC2 loadings share one sign in {int(J.trio_P2_same_sign.sum())}/39 runs; "
          f"trio PC1 all positive in {int(J.trio_P1_all_positive.sum())}/39 runs")
    print(f"  variance% over jackknife: PC1 {J.varPC1.min():.1f}-{J.varPC1.max():.1f}, "
          f"PC2 {J.varPC2.min():.1f}-{J.varPC2.max():.1f}")

    # do conclusions depend on reporting eigenvector instead of correlation loading?
    er1 = tab.eig_PC1.abs().rank(ascending=False).astype(int)
    er2 = tab.eig_PC2.abs().rank(ascending=False).astype(int)
    print("\n--- Eigenvector vs correlation-loading (ranks of |.|) for the trio ------------")
    print(pd.DataFrame({"rank_eigPC1": er1, "rank_loadPC1": tab.rank_abs_load_PC1,
                        "rank_eigPC2": er2, "rank_loadPC2": tab.rank_abs_load_PC2}).loc[SYM].to_string())
    print(f"  Spearman(eigenvector, loading) PC1={tab.eig_PC1.abs().corr(tab.abs_load_PC1, method='spearman'):.3f} "
          f"PC2={tab.eig_PC2.abs().corr(tab.abs_load_PC2, method='spearman'):.3f}")

    print("\n================= SENSITIVITY (appendix) ===================")
    t37 = pd.read_csv("data/time_series_data.csv", index_col=0).dropna(subset=["HouseSize"])
    keep = {int(-ce) for ce in t37.CE}                      # BCE of centuries present in both files
    assert len(keep) == 37 and 4300 not in keep and 4200 not in keep
    s37, _, v37, _ = analyse(X39.loc[X39.index.isin(keep)],
                             "S1: 37 centuries (drop 4300/4200 BCE), correlation PCA")
    print("  S1 vs MAIN (symbolic trio):")
    cmp = pd.concat({"main39": tab.loc[SYM, ["load_PC1", "load_PC2", "rank_abs_load_PC1",
                                             "rank_abs_load_PC2"]],
                     "sens37": s37.loc[SYM, ["load_PC1", "load_PC2", "rank_abs_load_PC1",
                                             "rank_abs_load_PC2"]]}, axis=1).round(3)
    print(cmp.to_string())
    print(f"  S1 variance% PC1/PC2 = {v37[0]:.1f}/{v37[1]:.1f} (main: {var[0]:.1f}/{var[1]:.1f})")
    analyse(X39, "S2: 39 centuries, COVARIANCE PCA on raw Z", correlation=False)
    s3, sc3, v3, _ = analyse(X39[SYM], "S3 (diagnostic): symbolic trio only, correlation PCA")
    print("  (diagnostic only - NOT the answer; PC1 here is an internal axis of the trio)")
    print("  trio-internal loadings:",
          {LABEL[c]: (round(s3.loc[c, "load_PC1"], 3), round(s3.loc[c, "load_PC2"], 3)) for c in SYM})
    var0 = analyse(X39, "S4: ddof=0 check", ddof=0)[2]
    print(f"  ddof=0 vs ddof=1 variance% PC1/PC2: {var0[0]:.2f}/{var0[1]:.2f} "
          f"vs {var[0]:.2f}/{var[1]:.2f}  (delta {var0[0]-var[0]:+.2f} / {var0[1]-var[1]:+.2f})")

    # rolling windows: sign-aligned to the global solution, NOT comparable across windows
    W, ST = 15, 1
    rows = []
    for i in range(0, len(X39) - W + 1, ST):
        win = X39.iloc[i:i + W]
        e2, ev2, s2 = pca(win, ddof=1, correlation=True)
        Z = (win - win.mean()) / win.std(ddof=1)
        ld = np.array([[np.corrcoef(Z[c], s2[:, k])[0, 1] for k in range(2)] for c in win.columns])
        gl = tab.loc[win.columns, ["load_PC1", "load_PC2"]].to_numpy()
        if np.trace(np.sign(ld.T @ gl)[:2]) < 0 or ld[:, 0] @ gl[:, 0] < 0:
            ld *= -1
        end = win.index[0]
        rows.append({"end_BCE": end, **{f"{LABEL[f]}_PC1": ld[ALL12.index(f), 0] for f in SYM},
                     **{f"{LABEL[f]}_PC2": ld[ALL12.index(f), 1] for f in SYM},
                     "varPC1": ev2[0] / ev2.sum() * 100, "varPC2": ev2[1] / ev2.sum() * 100})
    roll = pd.DataFrame(rows).set_index("end_BCE")
    roll.to_csv(f"{OUT}/rolling_15c_windows_signs_aligned.csv")
    print("\nS5: rolling 15-century windows (signs aligned to global solution; appendix only)")
    print(roll[[f"{LABEL[f]}_PC1" for f in SYM]].describe().loc[["mean", "std", "min", "max"]].round(3).to_string())
    print(roll[[f"{LABEL[f]}_PC2" for f in SYM]].describe().loc[["mean", "std", "min", "max"]].round(3).to_string())


if __name__ == "__main__":
    main()
