"""
Stage-1 INSPECTION ONLY (no analysis results, no hypothesis).
DiscoveryBench archaeology task: "Between 3400 BCE and 3000 BCE, how does the number
of monuments and axes change with elements of symbolic capital?"

Run:  python analysis/inspect_inputs.py
Outputs: shapes, dtypes, time coverage in CE/calBP/BCE, window membership,
         NaN structure, duplicate/grid checks, capital<->time_series column mapping proof,
         degenerate (zero-variance) variables inside the window.
"""
import numpy as np
import pandas as pd

TS = "data/time_series_data.csv"
CAP = "data/capital.csv"
POL = "data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv"
WIN_BCE = (3000, 3400)          # inclusive, BCE  (== CE -3400 .. -3000)

MAPPING = [  # capital.csv  ->  time_series_data.csv
    ("ZBeil", "AxesCelts", "Axes & Celts (stone/copper shaft-hole axes, ground-stone 'axes')"),
    ("ZMonument", "MonumentCount", "monument COUNT (megalitythic tomb count)"),
    ("ZMW", "MonumentSize", "monument SIZE (mean MEK size)"),
    ("ZAxtSchwert", "HatchetSword", "hatchets & swords"),
    ("ZDolch", "Dagger", "daggers"),
    ("Zhausgr", "HouseSize", "house size"),
    ("ZCU_AU", "CopperGold", "copper & gold"),
    ("Zamber", "Amber", "amber"),
    ("ZHort", "Depot", "hoards / depots"),
    ("ZSichel", "Sickle", "sickles"),
    ("ZKeform", "PotteryForm", "pottery form"),
    ("Zkeverz", "PotteryDecoration", "pottery decoration"),
]

# planned capital groups (analysis phase, after approval)
GROUPS = {
    "focus":       ["MonumentCount", "AxesCelts"],
    "symbolic":    ["HatchetSword", "Dagger", "HouseSize"],
    "economic":    ["Depot", "Sickle", "AxesCelts", "MonumentSize"],
    "cultural":    ["PotteryForm", "PotteryDecoration"],
    "social":      ["CopperGold", "Amber", "MonumentCount"],
    "controls":    ["pollen_inter", "pollen_inter_100", "pollen_grate_100",
                    "kde_all_mean", "g_all_mean"],
}


def load():
    ts = pd.read_csv(TS, index_col=0).set_index("CE")
    cap = pd.read_csv(CAP, decimal=",")             # comma decimal separator!
    pol = pd.read_csv(POL, index_col=0, decimal=",").set_index("CE")
    return ts, cap, pol


def sec(t):
    print("\n" + "=" * 78 + "\n" + t + "\n" + "=" * 78)


def main():
    ts, cap, pol = load()

    sec("1. SHAPES / DTYPES")
    for n, d in [("time_series_data", ts), ("capital", cap.reset_index(drop=True)), ("pollen", pol)]:
        print(f"{n:18s} rows={len(d):5d} cols={d.shape[1]:3d}  float={(d.dtypes == 'float64').sum()} int={(d.dtypes=='int64').sum()}")

    sec("2. TIME COVERAGE & SCALE CONSISTENCY")
    print(f"time_series : CE {ts.index.min()} .. {ts.index.max()}  | calBP {ts.calBP.min()} .. {ts.calBP.max()}"
          f"  | CE == 1950 - calBP : {bool((ts.index == 1950 - ts.calBP.values).all())}")
    print(f"            : annual grid, step(s)={sorted(set(np.diff(ts.index.values)))}, rows={len(ts)}, "
          f"duplicated CE={int(ts.index.duplicated().sum())}")
    print(f"            : BCE span = {-ts.index.max()} .. {-ts.index.min()} BCE")
    print(f"capital     : BCE {cap.BCE.min()} .. {cap.BCE.max()}  100-yr bins, step={sorted(set(np.diff(cap.BCE.values)))}, "
          f"rows={len(cap)}, duplicated BCE={int(cap.BCE.duplicated().sum())}")
    print(f"pollen      : CE {pol.index.min()} .. {pol.index.max()}  calBP {pol.calBP.min()} .. {pol.calBP.max()}, "
          f"annual, duplicated={int(pol.index.duplicated().sum())}")
    print("SIGN CONVENTION: capital.BCE>0  ->  CE = -BCE   (e.g. 3400 BCE = CE -3400);")
    print("                 calBP = 1950 - CE  ->  3400 BCE = calBP 5350, 3000 BCE = calBP 4950.")

    sec("3. WINDOW 3400-3000 BCE MEMBERSHIP")
    cap_w = cap[(cap.BCE >= WIN_BCE[0]) & (cap.BCE <= WIN_BCE[1])]
    ts_w = ts.loc[-WIN_BCE[1]:-WIN_BCE[0]]
    pol_w = pol.loc[[i for i in pol.index if -WIN_BCE[1] <= i <= -WIN_BCE[0]]]
    print(f"capital 100-yr bins in window : {len(cap_w)}  -> {sorted(cap_w.BCE.tolist(), reverse=True)}")
    print(f"time_series annual rows       : {len(ts_w)} (CE -3400..-3000 inclusive)")
    print(f"pollen annual rows            : {len(pol_w)}")
    print(f"period labels covered         : {cap_w.group.unique().tolist()}")
    print("raw Z values are observed once per century (1 non-NaN per 100-yr bin):")
    raw = [b for _, b, _ in MAPPING]
    tmp = ts_w[raw].copy(); tmp["bin"] = (-tmp.index // 100) * 100
    print(tmp.groupby("bin").count().T.to_string())

    sec("4. NaN STRUCTURE")
    zc = [c for c in ts.columns if c[0].isupper()]
    print(pd.DataFrame({"full_nan": ts[zc].isna().sum(), "window_nan": ts_w[zc].isna().sum()}).to_string())
    print("\n-> raw Z columns exist only on the 100-yr century grid; *_inter are gap-free (linear interp).")
    print("pollen file NaN in window:"); print(pol_w.isna().sum().to_string())

    sec("5. COLUMN MAPPING PROOF (capital vs time_series, joined on CE=-BCE)")
    c = cap.set_index(-cap.BCE)
    for a, b, lab in MAPPING:
        ce = [i for i in c.index if i in ts.index]
        d = c.loc[ce, a].values - ts.loc[ce, b].values
        print(f"{a:12s} -> {b:20s} n={len(d):3d} max|diff|={np.nanmax(np.abs(d)):.1e} exact={int((np.abs(d) < 1e-12).sum())}/{len(d)}  # {lab}")
    print("capital bins with no time_series row (outside -4100..-500):",
          [int(-i) for i in c.index if i not in ts.index], "BCE")

    sec("6. GRID AGREEMENT BETWEEN FILES")
    print("capital 100-yr bins are a subset of the annual time_series grid and carry exactly one raw Z each.")
    print("pollen grid overlaps window 100%:", len(pol_w), "of", len(ts_w), "years")

    sec("7. DEGENERACY / SIGNAL CHECK INSIDE WINDOW (needed before choosing estimators)")
    ic = [b + "_inter" for _, b, _ in MAPPING]
    print(pd.DataFrame({"full_std": ts[ic].std(), "window_std": ts_w[ic].std(),
                        "window_n_unique": ts_w[ic].nunique()}).round(3).to_string())
    print("\nHatchetSword, Dagger, Sickle, Amber, Depot are (near-)flat inside 3400-3000 BCE ->")
    print("correlations on those series are undefined/unstable; level contrasts must be used instead.")
    ov = [i for i in ts.index if i in pol.index]
    r = np.corrcoef(ts.pollen_inter.loc[ov], pol.Belau_PC1_inter.loc[ov])[0, 1]
    print(f"\ntime_series pollen identity: corr(pollen_inter, pollen-file Belau_PC1_inter) = {r:.4f} "
          f"(n={len(ov)}) -> time_series 'pollen' IS Belau PC1 openness")
    print("window pollen level (pollen_inter_100): mean %.2f, range %.2f..%.2f | full-range %.2f..%.2f"
          % (ts_w.pollen_inter_100.mean(), ts_w.pollen_inter_100.min(), ts_w.pollen_inter_100.max(),
             ts.pollen_inter_100.min(), ts.pollen_inter_100.max()))

    sec("8. PLANNED, NOT YET EXECUTED")
    for k, v in GROUPS.items():
        print(f"{k:10s}: {v}")
    print("\nNext (after approval): window slice -> *_inter series -> level correlations,")
    print("100-yr differences (growth), first-difference cross-correlations, ±lag robustness,")
    print("pollen/kde controls; report direction + sign + strength as the final 'relation'.")


if __name__ == "__main__":
    main()
