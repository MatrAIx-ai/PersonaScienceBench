"""
DISCOVERYBENCH archaeology analysis (executed).
Question: "Between 3400 BCE and 3000 BCE, how does the number of monuments and axes
change with elements of symbolic capital?"

Spec fixed with the researcher:
 * window inclusive [3400, 3000] BCE == CE [-3400, -3000]  -> 5 century bins (main spec)
 * half-open window + leave-one-bin-out = sensitivity only
 * capital taxonomy fixed: symbolic = HatchetSword, Dagger, HouseSize;
   social = CopperGold, Amber, MonumentCount; economic = Depot, Sickle, AxesCelts, MonumentSize;
   cultural = PotteryForm, PotteryDecoration
 * focus pair = (MonumentCount, AxesCelts); all reported numbers come from CENTURY values
   (effective n = 5); annual (401-pt) series are illustration only
 * demographic controls: Belau pollen openness (pollen_inter / pollen_inter_100 /
   pollen_grate_100) and KDE population proxies (kde_all_mean, g_all_mean)

Run: python analysis/run_analysis.py
"""
import numpy as np
import pandas as pd

pd.set_option("display.width", 200)

TS, CAP, POL = ("data/time_series_data.csv", "data/capital.csv",
                "data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv")
WIN = (3400, 3000)                     # BCE inclusive
PREV, NEXT = (3800, 3400), (3000, 2600)

SYMBOLIC = ["HatchetSword", "Dagger", "HouseSize"]
SOCIAL = ["CopperGold", "Amber", "MonumentCount"]
ECONOMIC = ["Depot", "Sickle", "AxesCelts", "MonumentSize"]
CULTURAL = ["PotteryForm", "PotteryDecoration"]
PAIR = ["MonumentCount", "AxesCelts"]
CTRL = ["pollen_inter", "pollen_inter_100", "pollen_grate_100", "kde_all_mean", "g_all_mean"]

MAP = {"AxesCelts": "ZBeil", "MonumentCount": "ZMonument", "MonumentSize": "ZMW",
       "HatchetSword": "ZAxtSchwert", "Dagger": "ZDolch", "HouseSize": "Zhausgr",
       "CopperGold": "ZCU_AU", "Amber": "Zamber", "Depot": "ZHort", "Sickle": "ZSichel",
       "PotteryForm": "ZKeform", "PotteryDecoration": "Zkeverz"}


def strength(r):
    if r is None or not np.isfinite(r):
        return "undefined (series constant in window)"
    a = abs(r)
    s = "strong" if a >= 0.6 else "moderate" if a >= 0.3 else "weak"
    return f"{s} ({'+' if r > 0 else '-'}, r={r:+.2f})"


def load():
    ts = pd.read_csv(TS, index_col=0).set_index("CE")
    cap = pd.read_csv(CAP, decimal=",").set_index("BCE")
    z = cap.rename(columns=MAP)[[MAP[k] for k in MAP]].rename(
        columns={MAP[k]: k for k in MAP}).sort_index()
    return ts, z


def win(df, a, b):                      # BCE window, inclusive; index is DESCENDING BCE
    lo, hi = min(a, b), max(a, b)
    return df.loc[(df.index >= lo) & (df.index <= hi)].sort_index(ascending=False)


def main():
    ts, Z = load()
    W = win(Z, *WIN)                    # chronological: 3400 -> 3000 BCE
    W.index.name = "BCE"

    print("=" * 90)
    print("T1. CENTURY VALUES, WINDOW 3400-3000 BCE (MN), n = 5 bins   [MAIN EVIDENCE]")
    print("=" * 90)
    print(W.round(3).to_string())

    print("\n" + "=" * 90)
    print("T2. LEVEL: window vs previous (3800-3400 BCE) and next (3000-2600 BCE) window means")
    print("=" * 90)
    lev = pd.DataFrame({"win": win(Z, *WIN).mean(),
                        "prev": win(Z, *PREV).mean(),
                        "next": win(Z, *NEXT).mean()})
    lev["d_prev"] = lev.win - lev.prev
    lev["d_next"] = lev.win - lev.next
    print(lev.round(2).to_string())

    print("\n" + "=" * 90)
    print("T3. GROWTH (dZ per 100 yr) inside window; flat/degenerate diagnostics")
    print("=" * 90)
    D = W.diff().iloc[1:]
    D.index = [f"{a}->{b}" for a, b in zip(W.index[:-1], W.index[1:])]
    D.index.name = "century step"
    print(D.round(2).to_string())
    rng = W.max() - W.min()
    diag = pd.DataFrame({"window_range": rng.round(3),
                         "n_unique": W.nunique(),
                         "peak_bin": W.idxmax(),
                         "trough_bin": W.idxmin()})
    print("\n"); print(diag.to_string())

    print("\n" + "=" * 90)
    print("T4. CO-MOVEMENT WITHIN WINDOW ON 5 CENTURY BINS (levels, Pearson / Spearman)")
    print("=" * 90)
    rows = []
    grp = {**{v: "symbolic" for v in SYMBOLIC}, **{v: "social" for v in SOCIAL},
           **{v: "economic" for v in ECONOMIC}, **{v: "cultural" for v in CULTURAL}}
    for v in [c for c in Z.columns]:
        r_mc = W["MonumentCount"].corr(W[v]); r_ax = W["AxesCelts"].corr(W[v])
        sp_mc = W["MonumentCount"].corr(W[v], method="spearman")
        rows.append({"var": v, "group": grp[v], "r_vs_MonumentCount": r_mc,
                     "r_vs_AxesCelts": r_ax, "sp_vs_MonumentCount": sp_mc,
                     "strength_vs_MC": strength(r_mc), "strength_vs_Axes": strength(r_ax)})
    T4 = pd.DataFrame(rows).set_index("var")
    print(T4.round(3).to_string())
    print("\nFOCUS PAIR MonumentCount~AxesCelts: Pearson r =",
          f"{W['MonumentCount'].corr(W['AxesCelts']):+.3f}", " Spearman rho =",
          f"{W['MonumentCount'].corr(W['AxesCelts'], method='spearman'):+.3f}",
          "->", strength(W['MonumentCount'].corr(W['AxesCelts'])))
    print("d100 (growth) correlation of the pair, n=4 steps:",
          f"{D['MonumentCount'].corr(D['AxesCelts']):+.3f}")

    print("\n" + "=" * 90)
    print("T5. LEVEL VS TEMPO decomposition for the pair vs each symbolic element")
    print("=" * 90)
    out = []
    for v in SYMBOLIC + CULTURAL + SOCIAL + ECONOMIC:
        lv = W[v].mean() - W[PAIR].mean().mean()   # crude level offset, in Z units
        d = D[v]
        corr_g = D[PAIR[0]].corr(d) if d.abs().sum() > 1e-9 and d.nunique() > 1 else np.nan
        corr_g2 = D[PAIR[1]].corr(d) if d.abs().sum() > 1e-9 and d.nunique() > 1 else np.nan
        out.append({"var": v, "group": grp[v],
                    "meanZ_window": W[v].mean(),
                    "meanZ_pair": W[PAIR].mean().mean(),
                    "dZ_range": d.abs().max() if d.abs().sum() > 0 else 0.0,
                    "r_growth_MC": corr_g, "r_growth_Axes": corr_g2,
                    "verdict": ("no co-variation within window (constant/near-flat)"
                                if (W[v].max() - W[v].min()) < 0.15 else "co-varying")})
    T5 = pd.DataFrame(out).set_index("var")
    print(T5.round(3).to_string())

    print("\n" + "=" * 90)
    print("T6. DEMOGRAPHIC / ENVIRONMENTAL CONTROLS (century means of annual series)")
    print("=" * 90)
    ts_bin = ts.copy()
    ts_bin["bin"] = (-ts_bin.index // 100) * 100          # BCE century label
    C = ts_bin.loc[-WIN[0]:-WIN[1]].groupby("bin")[CTRL].mean().sort_index(ascending=False)
    print(C.round(3).to_string())
    C.index.name = "BCE"
    print("\npair vs controls, 5 century bins (Pearson r):")
    rows = []
    for c in CTRL:
        rows.append({"control": c, "r_MonumentCount": W["MonumentCount"].corr(C[c]),
                     "r_AxesCelts": W["AxesCelts"].corr(C[c]),
                     "range_ctrl": C[c].max() - C[c].min()})
    print(pd.DataFrame(rows).round(3).to_string(index=False))

    print("\n--- partial correlation of the pair controlling one control at a time (n=5, df=2) ---")
    def resid(y, xs):
        X = np.column_stack([np.ones(len(x)) for x in xs] + list(xs))
        b, *_ = np.linalg.lstsq(X, y.values, rcond=None)
        return pd.Series(y.values - X @ b, index=y.index)
    base = W["MonumentCount"].corr(W["AxesCelts"])
    print(f"zero-order r(pair) = {base:+.3f}")
    for c in CTRL:
        rx, ry = resid(W["MonumentCount"], (C[c],)), resid(W["AxesCelts"], (C[c],))
        print(f"  partial r | {c:18s} = {rx.corr(ry):+.3f}")
    rx, ry = resid(W["MonumentCount"], (C["pollen_inter_100"], C["kde_all_mean"])), \
             resid(W["AxesCelts"], (C["pollen_inter_100"], C["kde_all_mean"]))
    print(f"  partial r | pollen_inter_100 + kde_all_mean = {rx.corr(ry):+.3f}")

    print("\npair vs symbolic elements, partial r controlling pollen_inter_100 + kde_all_mean:")
    for v in SYMBOLIC + CULTURAL + ["CopperGold", "Amber", "Depot", "Sickle", "MonumentSize"]:
        if (W[v].max() - W[v].min()) < 1e-9:
            print(f"  {v:18s}: undefined (constant)"); continue
        a = resid(W["MonumentCount"], (C["pollen_inter_100"], C["kde_all_mean"]))
        b = resid(W[v], (C["pollen_inter_100"], C["kde_all_mean"]))
        a2 = resid(W["AxesCelts"], (C["pollen_inter_100"], C["kde_all_mean"]))
        print(f"  {v:18s}: r(MC) raw {W['MonumentCount'].corr(W[v]):+.3f} -> partial {a.corr(b):+.3f} |"
              f" r(Axes) raw {W['AxesCelts'].corr(W[v]):+.3f} -> partial {a2.corr(b):+.3f}")

    print("\n" + "=" * 90)
    print("T7. SENSITIVITY ONLY (not for the answer text)")
    print("=" * 90)
    W2 = W.iloc[:-1]                                      # half-open: drop 3000 BCE bin
    print(f"half-open window (4 bins 3400-3100 BCE): r(pair) = {W2['MonumentCount'].corr(W2['AxesCelts']):+.3f}")
    print("leave-one-bin-out r(pair):")
    for b in W.index:
        t = W.drop(index=b)
        print(f"   drop {b} BCE: r = {t['MonumentCount'].corr(t['AxesCelts']):+.3f}")
    print("\nANNUAL (401 pts, interpolation-smoothed) ILLUSTRATION ONLY:")
    A = ts.loc[-WIN[0]:-WIN[1]]
    for v in SYMBOLIC + CULTURAL + PAIR:
        print(f"   annual r MC~{v:18s} = {A['MonumentCount_inter'].corr(A[v + '_inter']):+.3f}"
              f"   r Axes~{v:18s} = {A['AxesCelts_inter'].corr(A[v + '_inter']):+.3f}")
    extra(Z, ts, W)




def extra(Z, ts, W):
    print("\n" + "=" * 90)
    print("T8. TIMING / SYNCHRONY OF THE PAIR (peak, trough, lag-0 vs lag-k, n=5 bins)")
    print("=" * 90)
    print(pd.DataFrame({"peak_bin": W.idxmax(), "trough_bin": W.idxmin(),
                        "window_range": (W.max() - W.min()).round(2),
                        "window_mean": W.mean().round(2),
                        "peak_dev_from_mean": (W.loc[3200] - W.mean()).round(2)}).to_string())
    w = W.reset_index(drop=True)
    print("\nlag structure r(AxesCelts[t], MonumentCount[t+lag centuries]) on 5 bins:")
    for lag in (-1, 0, 1, 2):
        print(f"   lag {lag:+d} -> r = {w.AxesCelts.corr(w.MonumentCount.shift(lag)):+.3f}")
    print("\nfull-record control (n=37 century bins): r(Axes,MC) = "
          f"{Z.AxesCelts.corr(Z.MonumentCount):+.3f}; lag-0 is the maximum of the CCF "
          f"(lag -1: {Z.AxesCelts.corr(Z.MonumentCount.shift(-1)):+.2f}, "
          f"lag +1: {Z.AxesCelts.corr(Z.MonumentCount.shift(1)):+.2f})")

    print("\n" + "=" * 90)
    print("T9. AMPLITUDE: is a flat series 'no link' or 'flat level'? (full vs window range, Z)")
    print("=" * 90)
    print(pd.DataFrame({"full_range": (Z.max() - Z.min()).round(2),
                        "window_range": (W.max() - W.min()).round(2),
                        "pct_of_full_range": (100 * (W.max() - W.min()) / (Z.max() - Z.min())).round(0)}).to_string())

    print("\n" + "=" * 90)
    print("T10. SUMMARY VERDICT TABLE (the evidence behind the final hypothesis)")
    print("=" * 90)
    rows = []
    grp = {**{v: "symbolic" for v in SYMBOLIC}, **{v: "social" for v in SOCIAL},
           **{v: "economic" for v in ECONOMIC}, **{v: "cultural" for v in CULTURAL}}
    grp["MonumentCount"] = "social (focus)"; grp["AxesCelts"] = "economic (focus)"
    for v in [c for c in Z.columns if c not in PAIR]:
        rmc, rax = W["MonumentCount"].corr(W[v]), W["AxesCelts"].corr(W[v])
        rng = W[v].max() - W[v].min()
        flat = rng < 0.15
        verdict = (f"no co-variation within window; level = {W[v].mean():+.2f} Z "
                   f"(range {rng:.2f} Z, {100*rng/(Z[v].max()-Z[v].min()):.0f}% of full-record range)") if flat else (
                  f"co-varying: r(MC)={rmc:+.2f} ({'strong' if abs(rmc)>=.6 else 'moderate' if abs(rmc)>=.3 else 'weak'}), "
                  f"r(Axes)={rax:+.2f} ({'strong' if abs(rax)>=.6 else 'moderate' if abs(rax)>=.3 else 'weak'})")
        rows.append({"var": v, "group": grp[v], "verdict": verdict,
                     "peak": int(W[v].idxmax()), "trough": int(W[v].idxmin()),
                     "level_win_vs_prev": round(W[v].mean() - win(Z, *PREV)[v].mean(), 2),
                     "level_win_vs_next": round(W[v].mean() - win(Z, *NEXT)[v].mean(), 2)})
    rows.insert(0, {"var": "PAIR MonumentCount~AxesCelts", "group": "focus pair",
                    "verdict": f"strong positive co-movement r=+{W.MonumentCount.corr(W.AxesCelts):.2f}, "
                               f"lag-0 only; shared peak 3200 BCE, shared decline to 3000 BCE; "
                               f"growth r(d100)=+{W.MonumentCount.diff().dropna().corr(W.AxesCelts.diff().dropna()):.2f}",
                    "peak": 3200, "trough": 3400,
                    "level_win_vs_prev": round(W.MonumentCount.mean() - win(Z, *PREV).MonumentCount.mean(), 2),
                    "level_win_vs_next": round(W.MonumentCount.mean() - win(Z, *NEXT).MonumentCount.mean(), 2)})
    print(pd.DataFrame(rows).set_index("var").to_string())



if __name__ == "__main__":
    main()
