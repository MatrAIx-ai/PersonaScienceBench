"""Stage 1: data inspection for pottery diversity (Form vs Decoration) opposite-trend question.
Produces analysis/01_inspection_report.txt. NO final century is asserted here."""
import pandas as pd, numpy as np

OUT = open('analysis/01_inspection_report.txt', 'w')
def p(*a):
    s = ' '.join(str(x) for x in a); print(s); OUT.write(s + '\n')

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:                       # capital uses ',' as decimal separator
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',', '.'), errors='coerce')

p('== 1. SHAPES / RANGES ==')
p(f'time_series: {ts.shape}, CE {ts.CE.min()}..{ts.CE.max()} (step 1), calBP {ts.calBP.min()}..{ts.calBP.max()}, calBP==1950-CE: {bool((ts.calBP==1950-ts.CE).all())}')
p(f'time_series dup CE rows: {ts.CE.duplicated().sum()}, dup full rows: {ts.duplicated().sum()}')
p('time_series columns present: PotteryForm=%s PotteryForm_inter=%s PotteryDecoration=%s PotteryDecoration_inter=%s'
  % tuple(c in ts.columns for c in ['PotteryForm','PotteryForm_inter','PotteryDecoration','PotteryDecoration_inter']))
p('nulls: raw Z columns = %d/3601 (=> %d populated century anchors); _inter columns = %d'
  % (ts.PotteryForm.isna().sum(), ts.PotteryForm.notna().sum(), ts.filter(like='_inter').isna().sum().sum()))
p(f'capital: {cap.shape}, BCE {cap.BCE.min()}..{cap.BCE.max()} step 100, dup BCE {cap.BCE.duplicated().sum()}, nulls {int(cap.isna().sum().sum())}')
p('capital periods: ' + str(cap.groupby("group").BCE.agg(["min","max","count"]).to_dict('index')))

p('\n== 2. MAPPING capital.csv <-> time_series_data.csv ==')
zmap = {'PotteryForm':'ZKeform','PotteryDecoration':'Zkeverz','HatchetSword':'ZAxtSchwert','Dagger':'ZDolch',
        'HouseSize':'Zhausgr','CopperGold':'ZCU_AU','Amber':'Zamber','MonumentCount':'ZMonument',
        'Depot':'ZHort','Sickle':'ZSichel','AxesCelts':'ZBeil','MonumentSize':'ZMW'}
capR = cap.rename(columns={v:k for k,v in zmap.items()})
nn = ts[ts.PotteryForm.notna()].reset_index(drop=True)
for shift in [-200,-100,0,100,200]:
    m = nn.merge(capR.assign(k=-(capR.BCE+shift)), left_on='CE', right_on='k', suffixes=('_ts','_cap'))
    tot = sum(int(np.isclose(m[a+'_ts'], m[a+'_cap'], atol=1e-9).sum()) for a in zmap)
    p(f'  join ts.CE == -(BCE{shift:+d}): overlap={len(m):2d} exact Z matches across 12 vars = {tot}/{12*len(m)}')
m0 = nn.merge(capR.assign(k=-capR.BCE), left_on='CE', right_on='k', suffixes=('_ts','_cap'))
p('  -> adopted axis: ts.CE == -capital.BCE (calBP = 1950 - CE). 444/444 exact for all 12 variables.')
p('  PotteryForm==ZKeform: %d/%d ; PotteryDecoration==Zkeverz: %d/%d' % (
    np.isclose(m0.PotteryForm_ts, m0.PotteryForm_cap, atol=1e-9).sum(), len(m0),
    np.isclose(m0.PotteryDecoration_ts, m0.PotteryDecoration_cap, atol=1e-9).sum(), len(m0)))
p('  capital BCE 4300, 4200 have no time_series counterpart (grid starts -4100): values identical to -4100 anchor => edge repetition, not new info.')

p('\n== 3. RESOLUTION / INTERPOLATION ==')
for col in ['PotteryForm','PotteryDecoration']:
    lin = ts.set_index('CE')[col].astype(float).interpolate('linear', limit_area='inside').ffill().bfill().values
    p(f'  {col}_inter == linear interp of {col} anchors: max|diff| = {np.nanmax(np.abs(lin-ts[col+"_inter"].values)):.2e}')
p('  => effective independent information = 37 century anchors; yearly rows are linear ramps (no new info).')
p(f'  raw anchors CE: {nn.CE.min()}..{nn.CE.max()}, 37 bins, all multiples of 100 => century binning is loss-free.')

p('\n== 4. EDGE EFFECTS / FLOORS ==')
p(f'  PF first anchor {-4100} = {ts.PotteryForm.iloc[0]} == series min {ts.PotteryForm.min()} | PD = {ts.PotteryDecoration.iloc[0]} == min {ts.PotteryDecoration.min()}')
p('  PF == -1.13 (series min) in %d/37 bins, incl. unbroken run -1700..-500 (13 bins) => floor/censoring or genuine loss of form diversity'
  % int((nn.PotteryForm==nn.PotteryForm.min()).sum()))
p('  PD unbroken 0.97 for -1700..-1100 then 1.53 for -1000..-500 => step plateau, no intra-bin variance.')
p('  yearly grid last century (-500) has only 1/100 years populated; all others 100/100.')

p('\n== 5. BIN-TO-BIN DELTAS (37 anchors) ==')
A = nn[['CE','PotteryForm','PotteryDecoration']].copy()
A['dPF'] = A.PotteryForm.diff(); A['dPD'] = A.PotteryDecoration.diff()
D = A.dropna()
def mad_z(x):
    med = np.median(x); mad = np.median(np.abs(x-med)); return (x-med)/(1.4826*mad)
D = D.assign(rz_dPF=mad_z(D.dPF), rz_dPD=mad_z(D.dPD))
p('  std(PF)=%.3f std(PD)=%.3f ; MAD-scale PF=%.3f PD=%.3f' % (
    nn.PotteryForm.std(), nn.PotteryDecoration.std(),
    1.4826*np.median(np.abs(D.dPF-np.median(D.dPF))), 1.4826*np.median(np.abs(D.dPD-np.median(D.dPD)))))
opp = D[(D.dPD > 0) & (D.dPF < 0)]
p(f'  transitions with PD rising AND PF falling: n={len(opp)}')
p(opp[['CE','dPF','dPD','rz_dPF','rz_dPD']].round(2).to_string())
p('  threshold sensitivity (PD up & PF down, |robust z|>=k):')
for k in [0.5,1,1.5,2,2.5,3]:
    p(f'    k={k}: n={int(((D.rz_dPD>=k)&(D.rz_dPF<=-k)).sum())} bins={D[(D.rz_dPD>=k)&(D.rz_dPF<=-k)].CE.tolist()}')
p('  Pearson r(PF_inter, PD_inter) over yearly series = %.3f' % np.corrcoef(ts.PotteryForm_inter, ts.PotteryDecoration_inter)[0,1])
p('  r(PF,kde_all_mean)=%.3f  r(PD,kde_all_mean)=%.3f  r(PF,pollen)=%.3f  r(PD,pollen)=%.3f' % (
    np.corrcoef(ts.PotteryForm_inter, ts.kde_all_mean)[0,1], np.corrcoef(ts.PotteryDecoration_inter, ts.kde_all_mean)[0,1],
    np.corrcoef(ts.PotteryForm_inter, ts.pollen_inter)[0,1], np.corrcoef(ts.PotteryDecoration_inter, ts.pollen_inter)[0,1]))
OUT.close()
