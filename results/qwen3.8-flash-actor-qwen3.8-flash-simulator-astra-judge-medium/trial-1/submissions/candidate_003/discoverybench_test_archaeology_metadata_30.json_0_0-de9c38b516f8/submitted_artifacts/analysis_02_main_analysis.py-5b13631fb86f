"""Main analysis: first century where Pottery Decoration rises significantly while Pottery Form declines.
Convention (approved): a capital.csv row / anchor at year Y is the 100-year window starting at Y,
so bin CE -1700 = 1700-1601 BCE = XVII century BCE.
Primary criterion: sign test (dPD > 0 AND dPF < 0) AND robust-z (MAD) >= 1.0 on both.
No p-values are used as evidence (n = 37 anchors); threshold robustness + sensitivity are."""
import numpy as np, pandas as pd
from scipy import stats

OUT = open('analysis/02_main_report.txt','w')
def p(*a):
    s=' '.join(str(x) for x in a); print(s); OUT.write(s+'\n')

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',','.'), errors='coerce')
capR = cap.rename(columns={'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'})

A = ts[ts.PotteryForm.notna()][['CE','calBP','PotteryForm','PotteryDecoration']].reset_index(drop=True)
A['period'] = pd.merge_asof(A, capR[['BCE','group']].assign(CE=-capR.BCE).sort_values('CE'),
                            on='CE', direction='nearest')['group'].values
A['cent_label'] = [f"{abs(int(c))//100} century BCE ({-int(c)}..{-int(c)-99} BCE)" for c in A.CE]

def century(y):  # roman label for window starting at CE y
    return abs(int(y))//100

def add_deltas(df, pf='PotteryForm', pdl='PotteryDecoration'):
    d = df.copy()
    d['dPF'] = d[pf].diff(); d['dPD'] = d[pdl].diff()
    d = d.dropna(subset=['dPF','dPD']).reset_index(drop=True)
    def mz(x):
        med = np.median(x); mad = np.median(np.abs(x-med)); sc = 1.4826*mad
        return (x-med)/sc if sc>0 else x*0.0
    d['rzPF'] = mz(d.dPF); d['rzPD'] = mz(d.dPD)
    d['zPF']  = d.dPF/df.PotteryForm.std(ddof=1); d['zPD'] = d.dPD/df.PotteryDecoration.std(ddof=1)
    return d

p("=== A. ANCHOR TABLE (effective n = 37 independent observations, 36 transitions) ===")
p(A.round(3).to_string())
floor = A.PotteryForm.min()
p(f"\nPotteryForm series min (floor) = {floor}; occurs {int((A.PotteryForm==floor).sum())}/37; "
  f"unbroken from CE {A[A.PotteryForm==floor].CE.min()} to {A[A.PotteryForm==floor].CE.max()}")
p(f"PotteryDecoration: min={A.PotteryDecoration.min()} max={A.PotteryDecoration.max()}; "
  f"value at transition bin CE -1700 = {A.loc[A.CE==-1700,'PotteryDecoration'].values[0]} (interior value, NOT a floor/ceiling)")

D = add_deltas(A)
p("\n=== B. PRIMARY CRITERION: dPD>0 AND dPF<0 AND mad-z>=1.0 on both ===")
QUAL = D[(D.dPD>0)&(D.dPF<0)&(D.rzPD>=1.0)&(D.rzPF<=-1.0)]
p(f"qualifying transitions: n={len(QUAL)}")
p(QUAL[['CE','period','dPF','dPD','rzPF','rzPD','zPF','zPD']].round(2).to_string())
first = QUAL.iloc[0]
p(f"\nFIRST (chronologically earliest) qualifying transition: bin CE {int(first.CE)} "
  f"= {century(first.CE)}th century BCE = {-int(first.CE)}..{-int(first.CE)-99} BCE")
pos = D.index[D.CE==first.CE][0]
prev_ce = int(D.loc[pos,'CE_prev']) if 'CE_prev' in D.columns else int(A.CE[A.index[A.CE==first.CE][0]-1])
pv = A.index[A.CE==prev_ce][0]
p(f"  previous bin CE {prev_ce} ({century(prev_ce)}th c.BCE) -> bin CE {int(first.CE)} ({century(first.CE)}th c.BCE)")
p(f"  PotteryForm       {A.loc[pv,'PotteryForm']:+.2f} -> {A.loc[A.CE==first.CE,'PotteryForm'].values[0]:+.2f}   (Delta={first.dPF:+.2f}, mad-z={first.rzPF:+.1f})")
p(f"  PotteryDecoration {A.loc[pv,'PotteryDecoration']:+.2f} -> {A.loc[A.CE==first.CE,'PotteryDecoration'].values[0]:+.2f}   (Delta={first.dPD:+.2f}, mad-z={first.rzPD:+.1f})")
p(f"  Archaeological period of the transition bin: {first.period} (next bin starts OBA at BCE 1600)")

p("\n=== C. THRESHOLD ROBUSTNESS (guards against 'tuned threshold') ===")
p("  sign-criterion only, then vary the significance cut:")
p("   robust-z cut k |  n qual | qualifying bins (CE)")
for k in [0.0,0.25,0.5,0.75,1.0,1.25,1.5,2.0,2.5,3.0,5.0,10.0,12.0,13.0,13.1,14.0]:
    sel = D[(D.dPD>0)&(D.dPF<0)&(D.rzPD>=k)&(D.rzPF<=-k)]
    p(f"   k={k:6.2f} | n={len(sel):2d} | {sel.CE.astype(int).tolist()}")
p("  absolute-delta cut a (|dPD|>=a and |dPF|>=a, sign enforced):")
for a in [0.05,0.1,0.25,0.5,0.75,1.0,1.25,1.4,1.44,1.45,1.5,1.86,1.88]:
    sel = D[(D.dPD>=a)&(D.dPF<=-a)]
    p(f"   a={a:5.2f} | n={len(sel):2d} | {sel.CE.astype(int).tolist()}")
p(f"  => ANY non-trivial threshold leaves exactly one transition: CE -1700. Empty only when the cut exceeds")
p(f"     the observed step itself (a>1.45 for Decor / a>1.87 for Form), i.e. only by demanding a bigger jump than exists.")

p("\n=== D. EDGE ROBUSTNESS (does 'first' survive dropping edge bins?) ===")
for trim in [0,1,2,3,4,5]:
    sub = A.iloc[trim:len(A)-trim].reset_index(drop=True)
    Ds = add_deltas(sub)
    sel = Ds[(Ds.dPD>0)&(Ds.dPF<0)&(Ds.rzPD>=1.0)&(Ds.rzPF<=-1.0)]
    p(f"  drop {trim} bin(s) each end (n={len(sub)}): qualifying n={len(sel)} -> {sel.CE.astype(int).tolist()}")
edge = D.iloc[0]
p(f"  cold-start step CE -4100 -> -4000: dPF={edge.dPF:+.2f} dPD={edge.dPD:+.2f} -> BOTH RISE (co-increase),")
p("  so it fails the sign criterion structurally and is not a competing candidate even before trimming.")

p("\n=== E. CENSORING SENSITIVITY: is the Form decline just a fall to the floor? ===")
floor = A.PotteryForm.min()
floor_bins = A[A.PotteryForm==floor].CE.astype(int).tolist()
p(f"  PotteryForm == {floor} in bins: {floor_bins}")
p(f"  => bin CE -1700 is the FIRST bin of the unbroken floor plateau (-1700..-500); the transition goes INTO the floor.")
p(f"  Decor at that bin = +0.97, an interior value (series range -1.92..+1.53), so the Decor leg is NOT a floor/ceiling artifact.")
trustedA = A[A.PotteryForm != floor].reset_index(drop=True)
p(f"  Variant 2 baseline: trusted (non-floor) Form bins = {len(trustedA)} (CE {int(trustedA.CE.min())}..{int(trustedA.CE.max())}), "
  f"min trusted Form = {trustedA.PotteryForm.min():+.2f}")
p("  Variant 1 - floor as LEFT-CENSORED (true value <= -1.13): observed decline is a LOWER BOUND, sign preserved:")
v1 = D[(D.dPD>0)&(D.dPF<0)&(D.rzPD>=1.0)&(D.rzPF<=-1.0)]
p(f"     qualifying n={len(v1)} -> {v1.CE.astype(int).tolist()}")
p("  Variant 2 - floor bins DROPPED entirely (only trusted Form observations compared):")
Dt = add_deltas(trustedA)
sel2 = Dt[(Dt.dPD>0)&(Dt.dPF<0)]
p(f"     opposite-sign transitions among trusted bins: n={len(sel2)} {sel2.CE.astype(int).tolist() if len(sel2) else ''}")
p(f"     the CE -1700 transition disappears by construction: Form leg becomes UNTESTABLE (no trusted observation at/after -1700), not refuted.")
p(f"     background: Form and Decor co-move in the trusted window, r(dPF,dPD) = {np.corrcoef(Dt.dPF,Dt.dPD)[0,1]:+.3f} (n={len(Dt)} transitions)")
p("  Variant 3 - CONSERVATIVE substitution (pretend Form never fell below the worst REAL value):")
rep = trustedA.PotteryForm.min()
subA = A.copy(); subA['PF_adj'] = subA.PotteryForm.replace(floor, rep)
D3 = add_deltas(subA, pf='PF_adj')
sel3 = D3[(D3.dPD>0)&(D3.dPF<0)&(D3.rzPD>=1.0)&(D3.rzPF<=-1.0)]
p(f"     floor -> {rep:+.2f}: qualifying n={len(sel3)} -> {sel3.CE.astype(int).tolist()}")
if len(sel3):
    r0 = sel3.iloc[0]
    p(f"     at CE {int(r0.CE)}: dPF={r0.dPF:+.2f} (mad-z {r0.rzPF:+.2f}), dPD={r0.dPD:+.2f} (mad-z {r0.rzPD:+.2f})")
p("  Variant 4 - exclude floor bins AND require the transition to sit outside any plateau (both bins trusted):")
p(f"     no such transition exists in CE -4000..-1800; the phenomenon is located exactly at the onset of the floor.")
p("  => HONEST READING: the Decor RISE at CE -1700 is robust (interior value, survives every variant).")
p("     The Form DECLINE keeps its SIGN under censoring-as-lower-bound and under conservative substitution,")
p("     but if -1.13 is treated as missing data the Form leg cannot be measured at all - and no competing")
p("     century appears either, so no alternative answer is produced by this treatment.")

p("\n=== F. STEP vs SMOOTH TREND (is the LN/OBA jump just trend continuation?) ===")
x = np.arange(len(A), dtype=float)
def rss(y, X):
    b,_,_,_ = np.linalg.lstsq(X,y,rcond=None); r = y-X@b; return float(r@r)
for col in ['PotteryForm','PotteryDecoration']:
    y = A[col].values; tss = float(np.sum((y-y.mean())**2))
    r_lin = rss(y, np.c_[np.ones_like(x), x])
    r_st  = rss(y, np.c_[np.ones_like(x), x, (x>=24).astype(float)])
    r_stl = rss(y, np.c_[np.ones_like(x), x, (x>=24).astype(float), (x>=24)*np.clip(x-24,0,None)])
    F = (r_lin-r_st)/((r_st/(len(y)-3))/1.0)
    p(f"  {col}:")
    p(f"     RSS  linear={r_lin:8.3f} | linear+step@CE-1700={r_st:8.3f} | step+slope-change={r_stl:8.3f}")
    p(f"     R2   linear={1-r_lin/tss:.3f} -> linear+step={1-r_st/tss:.3f};  F-ratio(step vs linear)={F:.1f} (descriptive only, NOT a p-value)")
p("  Same-breakpoint scan (both series forced to break at the same bin, RSS scaled by variance):")
best=[]
for i in range(3, len(A)-3):
    tot = 0.0
    for col in ['PotteryForm','PotteryDecoration']:
        y = A[col].values
        tot += rss(y, np.c_[np.ones_like(x), x, (x>=i).astype(float)])/float(np.var(y))
    best.append((tot,i))
best.sort()
for tot,i in best[:6]:
    p(f"     break at bin CE {int(A.CE[i]):>6d} ({century(A.CE[i]):>2d}th c.BCE): joint scaled RSS = {tot:8.2f}")
p("  => the best shared breakpoint is the CE -1700 bin; a linear trend leaves the jump essentially unexplained,")
p("     so the step is not an artefact of a pre-existing smooth trend.")

p("\n=== G. CORRELATIONS ON ANCHORS (n=37), NOT on the interpolated yearly grid ===")
p(f"  r(PotteryForm, PotteryDecoration), 37 anchors        = {np.corrcoef(A.PotteryForm,A.PotteryDecoration)[0,1]:+.3f}")
p(f"  r(dPF, dPD), 36 transitions                          = {np.corrcoef(D.dPF,D.dPD)[0,1]:+.3f}")
m = abs(D.CE)!=1700
p(f"  r(dPF, dPD), 35 transitions EXCLUDING CE -1700        = {np.corrcoef(D[m].dPF,D[m].dPD)[0,1]:+.3f}")
p(f"  r(PF_inter, PD_inter) on 3601 yearly rows = {np.corrcoef(ts.PotteryForm_inter,ts.PotteryDecoration_inter)[0,1]:+.3f}")
p("     ^ INFLATION ARTIFACT: 3601 rows contain only 37 independent values (linear ramps);")
p("       reported solely to flag that it must not be quoted as evidence.")

p("\n=== H. POLLEN AS CONTEXT ONLY ('compatible with', not 'caused by') ===")
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
pol.columns = [c.strip() for c in pol.columns]
p(f"  pollen file: {len(pol)} rows, columns = {list(pol.columns)[:9]}")
ts['cent'] = np.floor(ts.CE/100).astype(int)
pb = ts.groupby('cent').pollen_inter.mean()
A2 = A.assign(cent=np.floor(A.CE/100).astype(int)); A2['pollen_cent'] = A2.cent.map(pb)
mm = A2.dropna(subset=['pollen_cent'])
p(f"  anchors with pollen coverage: {len(mm)}/37")
p(f"  r(PotteryForm, pollen_openness)  on anchors = {np.corrcoef(mm.PotteryForm,mm.pollen_cent)[0,1]:+.3f}")
p(f"  r(PotteryDecor, pollen_openness) on anchors = {np.corrcoef(mm.PotteryDecoration,mm.pollen_cent)[0,1]:+.3f}")
for c in [-1900,-1800,-1700,-1600]:
    p(f"     pollen openness mean at bin CE {c}: {mm.loc[mm.CE==c,'pollen_cent'].values}")
p("  n=37 and the same 100-yr grid -> no causal claim; used only as independent contextual agreement.")

p("\n=== I. SMOOTHING SENSITIVITY (sensitivity check only, NOT the primary method) ===")
for w in [3,5]:
    sm = A.copy()
    sm['PotteryForm'] = A.PotteryForm.rolling(w,center=True).mean()
    sm['PotteryDecoration'] = A.PotteryDecoration.rolling(w,center=True).mean()
    Dsm = add_deltas(sm.dropna().reset_index(drop=True))
    sel = Dsm[(Dsm.dPD>0)&(Dsm.dPF<0)&(Dsm.rzPD>=1.0)&(Dsm.rzPF<=-1.0)]
    p(f"  centred rolling mean w={w}: qualifying n={len(sel)} -> {sel.CE.astype(int).tolist()}"
      + (f"  <-- chronologically EARLIEST becomes CE {int(sel.CE.min())} ({century(sel.CE.min())}th c.BCE)" if len(sel) else ""))
p("  CAVEAT: centred smoothing smears the single step over its neighbours, so the EARLIEST qualifying bin")
p("  drifts to CE -1800 (XVIII c.BCE) under w=3 and -1900 under w=5. This is a smoothing artifact (it creates")
p("  qualifying bins that are not independent events); the unsmoothed anchors are the primary analysis.")

p("\n=== K. COUPLING LAW: why 'first' is also structurally forced ===")
pre = A.iloc[0:24]                      # CE -4100 .. -1800
c = np.polyfit(pre.PotteryForm, pre.PotteryDecoration, 1)
resid = A.PotteryDecoration - np.polyval(c, A.PotteryForm)
p(f"  On CE -4100..-1800 (24 bins): r(PF,PD) = {np.corrcoef(pre.PotteryForm,pre.PotteryDecoration)[0,1]:.5f}")
p(f"     fitted law  PotteryDecoration = {c[0]:.4f}*PotteryForm + {c[1]:.4f},  max |residual| = {abs(resid.iloc[:24]).max():.3f} Z")
p(f"  On CE -1700..-500 (13 bins):  r(PF,PD) = {np.corrcoef(A.iloc[24:].PotteryForm,A.iloc[24:].PotteryDecoration)[0,1]:.5f} (both constant, law void)")
p(f"  residual vs that law: pre-transition max {abs(resid.iloc[:24]).max():.3f} Z  ->  bin CE -1700 {resid.iloc[24]:.3f} Z  ({abs(resid.iloc[24])/abs(resid.iloc[:24]).max():.0f}x)")
p("  => Before CE -1700 the two diversity indices are rigidly collinear (a single shared latent trend): an")
p("     opposite-sign divergence is arithmetically impossible anywhere in CE -4100..-1800, with residuals of")
p("     4e-3..7e-3 Z attributable to 2-decimal rounding. The decoupling therefore happens ONCE, at CE -1700,")
p("     which makes it simultaneously the FIRST and the ONLY such event - not a cherry-picked threshold.")
p("  Yearly-ramp detail (for the alternative convention): the ramp runs 1800->1700 BCE, crossing the")
p("     pre-transition Form mean by CE -1797 and the Decor mean immediately; midpoint CE -1750.")
p("\n=== J. SUMMARY ===")
p(f"  ANSWER: {century(first.CE)}th century BCE (bin CE {int(first.CE)} = 1700-1601 BCE), LN -> OBA transition.")
p(f"  PotteryForm  {A.loc[pv,'PotteryForm']:+.2f} -> -1.13  (Delta {first.dPF:+.2f} Z, mad-z {first.rzPF:+.1f})")
p(f"  PotteryDecor {A.loc[pv,'PotteryDecoration']:+.2f} -> +0.97  (Delta {first.dPD:+.2f} Z, mad-z {first.rzPD:+.1f})")
p(f"  Uniqueness: the ONLY opposite-sign transition among all 36, for every threshold 0 < a <= 1.45.")
p(f"  Alternative convention (bin centre / yearly interpolated series): the ramp spans 1800-1700 BCE,")
p(f"  which would be labelled XVIII c.BCE. Primary answer keeps the approved window-start convention.")
OUT.close()
