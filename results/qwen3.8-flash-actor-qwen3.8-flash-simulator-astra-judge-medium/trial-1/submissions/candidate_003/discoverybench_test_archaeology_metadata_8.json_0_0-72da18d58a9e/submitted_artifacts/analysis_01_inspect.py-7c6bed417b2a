import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 60)

def load_comma(path, **kw):
    df = pd.read_csv(path, decimal=',', **kw)
    return df

cap = load_comma('data/capital.csv')
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',', index_col=0)

for name, df in [('capital.csv', cap), ('time_series_data.csv', ts), ('pollen_openness...csv', pol)]:
    print('='*100)
    print(name, 'shape =', df.shape)
    print('columns:', list(df.columns))
    info = pd.DataFrame({'n_nonnull': df.notna().sum(), 'pct_filled': (df.notna().mean()*100).round(1),
                         'dtype': df.dtypes.astype(str),
                         'min': df.min(numeric_only=True), 'max': df.max(numeric_only=True)})
    print(info.to_string())
