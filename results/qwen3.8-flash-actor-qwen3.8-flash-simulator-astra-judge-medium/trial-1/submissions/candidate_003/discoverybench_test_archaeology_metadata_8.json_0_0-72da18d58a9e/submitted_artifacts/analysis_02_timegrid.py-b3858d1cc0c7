import pandas as pd, numpy as np
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',', index_col=0)

print('--- capital.csv BCE ---')
print('n rows', len(cap), 'n unique BCE', cap.BCE.nunique())
print('BCE sorted desc?', cap.BCE.is_monotonic_decreasing, ' asc?', cap.BCE.is_monotonic_increasing)
print('dups:', sorted(cap.BCE[cap.BCE.duplicated()].tolist()))
b = np.sort(cap.BCE.values); print('diffs unique:', np.unique(np.diff(b)))
print('groups:', cap.group.tolist()[:5], cap.group.unique())
print(cap[['BCE','group','Zamber','ZCU_AU','ZMonument']].to_string())

print()
print('--- time_series grid ---')
print('CE monotonic', ts.CE.is_monotonic_increasing, 'dup', ts.CE.duplicated().sum(), 'min/max', ts.CE.min(), ts.CE.max())
print('CE diff unique:', np.unique(np.diff(ts.CE.values)))
print('calBP check 1950-CE equals calBP:', (1950 - ts.CE).equals(pd.Series(ts.calBP.values)), (1950-ts.CE.values - ts.calBP.values).tolist()[:5])
raw_idx = ts.index[ts.Amber.notna()]
print('rows with raw Amber:', len(raw_idx))
print('CE of raw Amber rows:', ts.loc[raw_idx,'CE'].tolist())
print('BCE equivalents:', (-ts.loc[raw_idx,'CE']).tolist())
print('diff of BCE:', np.unique(np.diff((-ts.loc[raw_idx,'CE']).values)))
# which raw cols share the same index
for c in ['HatchetSword','Dagger','Amber','MonumentCount','PotteryDecoration','pollen']:
    print(c, 'n=', ts[c].notna().sum(), 'first/last CE:', ts.loc[ts[c].notna(),'CE'].min(), ts.loc[ts[c].notna(),'CE'].max())

print()
print('--- pollen grid ---')
print('CE monotonic', pol.CE.is_monotonic_increasing, 'dup', pol.CE.duplicated().sum(), 'CE range', pol.CE.min(), pol.CE.max())
print('CE diff unique:', np.unique(np.diff(pol.CE.values)))
print('calBP = 1950-CE ?', np.allclose(1950 - pol.CE.values, pol.calBP.values))
for c in ['Belau_PC1','Woserin_PC1']:
    s = pol.loc[pol[c].notna(),'CE']
    print(c,'n',len(s),'range',s.min(),s.max(),'median gap',np.median(np.diff(np.sort(s.values))))
