import pandas as pd, numpy as np
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
ts['BCE'] = -ts.CE
raw = ts.dropna(subset=['Amber'])
m = raw.merge(cap, on='BCE', how='outer', indicator=True)
print('join rows:', len(m), 'counts:\n', m._merge.value_counts())
both = m[m._merge=='both']
print('n matched:', len(both), ' max |Amber - Zamber|:', np.nanmax(np.abs(both.Amber-both.Zamber)))
for a,b in [('HatchetSword','ZAxtSchwert'),('Dagger','ZDolch'),('HouseSize','Zhausgr'),('CopperGold','ZCU_AU'),
            ('Amber','Zamber'),('MonumentCount','ZMonument'),('Depot','ZHort'),('Sickle','ZSichel'),
            ('AxesCelts','ZBeil'),('MonumentSize','ZMW'),('PotteryForm','ZKeform'),('PotteryDecoration','Zkeverz')]:
    d = np.nanmax(np.abs(both[a]-both[b])); print(f'{a:20s} vs {b:12s} maxdiff={d}')
print('capital-only BCE:', sorted(m.loc[m._merge=='left_only','BCE'].tolist()))
print()
# interpolation character
a = ts.dropna(subset=['Amber'])[['CE','Amber']]
inter = ts[['CE','Amber_inter']]
chk = inter.merge(a, on='CE', how='left')
# check linearity between nodes: slope constant?
node_vals = a.Amber.values
seg = []
ce = ts.CE.values
for i in range(len(node_vals)-1):
    lo, hi = a.CE.values[i], a.CE.values[i+1]
    mask = (ce>=lo)&(ce<=hi)
    v = ts.Amber_inter.values[mask]
    pred = np.linspace(node_vals[i], node_vals[i+1], mask.sum())
    seg.append(np.abs(v-pred).max())
print('linear-interp residual max over segments:', np.nanmax(seg))
print('Amber_inter == Amber at nodes:', np.allclose(a.Amber, ts.set_index("CE").loc[a.CE,"Amber_inter"]))
print('Amber_inter n unique:', ts.Amber_inter.nunique(), 'raw n unique:', ts.Amber.nunique())
print()
print('Amber raw  : n=%d min=%.3f max=%.3f mean=%.3f sd=%.3f'%(ts.Amber.notna().sum(),ts.Amber.min(),ts.Amber.max(),ts.Amber.mean(),ts.Amber.std()))
print('Amber_inter: n=%d min=%.3f max=%.3f mean=%.3f sd=%.3f'%(ts.Amber_inter.notna().sum(),ts.Amber_inter.min(),ts.Amber_inter.max(),ts.Amber_inter.mean(),ts.Amber_inter.std()))
print('Zamber     : n=%d min=%.3f max=%.3f mean=%.3f sd=%.3f'%(cap.Zamber.notna().sum(),cap.Zamber.min(),cap.Zamber.max(),cap.Zamber.mean(),cap.Zamber.std()))
print('mean of Zamber (is it ~0 => standardized):', cap.Zamber.mean().round(4), ' sd:', cap.Zamber.std(ddof=0).round(4))
print('per-column mean/sd in capital (z-check):')
print(cap.drop(columns=['BCE','group','color']).agg(['mean','std','min','max']).T.round(3).to_string())
print()
print('--- ties for Zamber max ---')
print(cap.loc[cap.Zamber>=cap.Zamber.max()-1e-9, ['BCE','group','Zamber']].to_string())
print('top-10 Zamber rows:'); print(cap.nlargest(10,'Zamber')[['BCE','group','Zamber']].to_string())
print('rows sharing 1.46:', cap.loc[cap.Zamber.round(2)==1.46,'BCE'].tolist(), ' rows sharing 1.54:', cap.loc[cap.Zamber.round(2)==1.54,'BCE'].tolist())
print()
print('--- candidate other amber-ish columns ---')
print([c for c in list(ts.columns)+list(cap.columns)+list(pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv",decimal=",",index_col=0).columns) if 'amber' in c.lower() or 'bern' in c.lower()])
print('correlation of Amber raw with other raw Z cols (capital, n=39):')
print(cap.drop(columns=['BCE','group','color']).corr(numeric_only=True)['Zamber'].round(2).to_string())
