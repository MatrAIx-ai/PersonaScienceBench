import pandas as pd, numpy as np
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',', index_col=0)

# step / plateau structure of Zamber & relation to period groups
runs = (cap.Zamber != cap.Zamber.shift()).cumsum()
print('Zamber plateau runs (BCE range -> value):')
for _, g in cap.groupby(runs):
    print(f'  {g.BCE.max()}-{g.BCE.min()} BCE  Z={g.Zamber.iloc[0]:+.2f}  groups={sorted(g.group.unique())}')
print('\ngroup ranges (BCE):')
print(cap.groupby('group', sort=False).BCE.agg(['min','max','count']).to_string())

# overlap of time coverage
print('\ncoverage: capital BCE 500-4300 ; ts BCE 500-4100 (annual) ; pollen CE %d..%d (annual, desc) ; pollen raw n=%d'%(pol.CE.min(),pol.CE.max(),pol.Belau_PC1.notna().sum()))
print('overlap in BCE: capital vs ts -> 500..4100 ; pollen file starts at BCE 4785 (earlier than amber data by %d yr)'%(4785-4100))

# ts 'pollen' vs pollen-file Belau_PC1
ts['BCE']=-ts.CE
j = ts.merge(pol[['CE','Belau_PC1','Woserin_PC1','MEAN','SMOOTH_MEAN_100y']], on='CE', how='inner')
print('\nts-pollen vs Belau_PC1 overlap n=%d  maxdiff=%.3g'%(j.pollen.notna().sum(), (j.pollen-j.Belau_PC1).abs().max()))
print('corr(ts.pollen_inter, ts.pollen_inter_100)=%.3f  corr(pollen_inter, SMOOTH_MEAN_100y)=%.3f'%(
    j.pollen_inter.corr(j.BELAU if False else j.Belau_PC1), j.pollen_inter.corr(j.SMOOTH_MEAN_100y)))
print('corr(Amber_inter, pollen_inter)=%.3f ; corr(Amber_inter, pollen_inter_100)=%.3f ; corr(Amber_inter, kde_all_mean)=%.3f'%(
    ts.Amber_inter.corr(ts.pollen_inter), ts.Amber_inter.corr(ts.pollen_inter_100), ts.Amber_inter.corr(ts.kde_all_mean)))

# is kde_all_mean amber specific? correlation with each Z col
zc=[c for c in ts.columns if c.endswith('_inter')]
print('\ncorr(kde_all_mean, *_inter):')
print(ts[zc].corrwith(ts.kde_all_mean).round(2).to_string())
# millennium assignment sanity (astronomical BCE boundaries)
c = cap.copy(); c['mill_BCE'] = np.ceil(c.BCE/1000)
print('\nrows per astronomical BCE millennium in capital.csv:')
print(c.groupby('mill_BCE').agg(n=('BCE','size'), BCE_min=('BCE','min'), BCE_max=('BCE','max'),
                                z_mean=('Zamber','mean'), z_max=('Zamber','max')).round(3).to_string())
