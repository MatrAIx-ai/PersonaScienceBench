"""FINAL amber analysis. Primary series: capital.csv Zamber (39 x 100-yr bins, 4300-500 BCE).
Rules fixed by researcher: value = Zamber (more = higher), millennium = ceil(BCE/1000),
peak from RAW series (no smoothing); 300/500-yr smoothing on annual Amber_inter is CONTROL only.
"""
import pandas as pd, numpy as np, json
cap = pd.read_csv('data/capital.csv', decimal=',').sort_values('BCE').reset_index(drop=True)
ts  = pd.read_csv('data/time_series_data.csv', index_col=0); ts['BCE'] = -ts.CE
assert np.abs(ts.dropna(subset=['Amber']).merge(cap[['BCE','Zamber']], on='BCE')
              .eval('abs(Amber-Zamber)').max()) == 0.0            # tables identical on shared bins
z = cap.Zamber.values; mu, sd = z.mean(), z.std(ddof=1); thr = mu + sd
BCE = cap.BCE.values

# ---- 1. millennium table (rule: ceil(BCE/1000)) ----
cap['mill'] = np.ceil(cap.BCE/1000).astype(int)
mill = (cap.groupby('mill').agg(n_bins=('BCE','size'), BCE_from=('BCE','max'), BCE_to=('BCE','min'),
        mean_Z=('Zamber','mean'), max_Z=('Zamber','max'), min_Z=('Zamber','min'),
        sd_Z=('Zamber','std')).reset_index().sort_values('mean_Z', ascending=False))
mill['sd_Z'] = mill.sd_Z.fillna(0.0); mill['phases'] = [','.join(sorted(set(cap.loc[cap.mill==m,'group']))) for m in mill.mill]
mill = mill.round(3)
win_mean = int(mill.iloc[0].mill)
max_holders = sorted(mill.loc[np.isclose(mill.max_Z, mill.max_Z.max()), 'mill'].astype(int))
runner_up = int(mill.iloc[1].mill)
print('Zamber: n=%d mean=%.4f SD=%.4f min=%.2f max=%.2f | wide threshold mean+1SD=%.3f' % (len(z),mu,sd,z.min(),z.max(),thr))
print('\n=== MILLENNIA (astronomical BCE, ceil rule) ===')
print(mill[['mill','BCE_from','BCE_to','n_bins','phases','mean_Z','max_Z','min_Z','sd_Z']].to_string(index=False))
print('winner by MEAN = %d-th mill BCE (mean %.3f, max %.2f); next by mean = %d-th (mean %.3f, max %.2f)'
      % (win_mean, mill.iloc[0].mean_Z, mill.iloc[0].max_Z, runner_up, mill.iloc[1].mean_Z, mill.iloc[1].max_Z))
print('winner by MAX  = tied %s (all hold Z=%.2f)' % (max_holders, z.max()))

# ---- 2. boundary-bin robustness: reassign exact-millennium bin 3000 BCE to the 4th ----
alt = cap.mill.copy(); alt[cap.BCE % 1000 == 0] = cap.BCE//1000 + 1        # ... 4th = 4001-3000 BCE
am = cap.groupby(alt).Zamber.agg(['mean','max','size']).round(3)
print('\nBOUNDARY CHECK: bin 3000 BCE (Z=1.54) -> mill %d under ceil rule' % int(cap.loc[cap.BCE==3000,'mill'].iloc[0]))
print(am.rename_axis('mill_alt').to_string())
print('alt rule: winner by mean = %d-th, max holders = %s  (unchanged winner: %s)'
      % (int(am['mean'].idxmax()), sorted(alt[cap.Zamber==z.max()].unique().tolist()), int(am['mean'].idxmax())==win_mean))

# ---- 3. plateaus + intervals ----
runs = (cap.Zamber != cap.Zamber.shift()).cumsum()
pl = (cap.groupby(runs).agg(BCE_late=('BCE','min'), BCE_early=('BCE','max'), n_bins=('BCE','size'),
      Zamber=('Zamber','first'), phases=('group', lambda s: ','.join(sorted(set(s))))).reset_index(drop=True))
for c, k in [('CE_early','BCE_early'), ('CE_late','BCE_late')]: pl[c] = -pl[k]
pl['calBP_early'] = 1950 + pl.BCE_early; pl['calBP_late'] = 1950 + pl.BCE_late
pl['ge_mean_plus_1SD'] = pl.Zamber >= thr
pl = pl.sort_values('BCE_early', ascending=False).reset_index(drop=True)
print('\n=== PLATEAUS (connected runs of equal Zamber, early -> late) ===')
print(pl[['BCE_early','BCE_late','n_bins','Zamber','phases','CE_early','CE_late','calBP_early','calBP_late','ge_mean_plus_1SD']].to_string(index=False))

narrow_rows = pl[np.isclose(pl.Zamber, z.max())]
assert len(narrow_rows) == 1
N = narrow_rows.iloc[0]
# wide = maximal CONNECTED set of bins with Z >= threshold, computed on the bin grid (not on run order)
sel = cap.BCE[Zamber_ok := (cap.Zamber >= thr).values].values
order = np.sort(sel)[::-1]; segs, cur = [], [order[0]]
for b in order[1:]:
    if cur[-1] - b == 100: cur.append(b)
    else: segs.append(cur); cur = [b]
segs.append(cur)
W = max(segs, key=len)
W_early, W_late = max(W), min(W)
print('\nNARROW peak (bins exactly at global max Z=%.2f): %d-%d BCE  = CE %d..%d = calBP %d-%d  (%d bins)'
      % (z.max(), N.BCE_early, N.BCE_late, int(N.CE_early), int(N.CE_late), int(N.calBP_early), int(N.calBP_late), N.n_bins))
print('WIDE high band (connected bins Z>=mean+1SD=%.2f): %d-%d BCE = CE %d..%d = calBP %d-%d (%d bins, Z %.2f..%.2f)'
      % (thr, W_early, W_late, -W_early, -W_late, 1950+W_early, 1950+W_late, len(W), cap.loc[cap.BCE.isin(W),'Zamber'].min(), z.max()))
print('all >=threshold segments:', [(max(s), min(s), len(s)) for s in segs])
below = cap.loc[~cap.BCE.isin(W)]
print('level just below threshold: max Z outside wide band = %.2f at bin %d BCE (gap to threshold = %.2f)'
      % (below.Zamber.max(), int(below.loc[below.Zamber.idxmax(),'BCE']), thr - below.Zamber.max()))

# ---- 4. CONTROL: 300/500-yr centred smoothing on annual Amber_inter ----
a = ts.sort_values('CE').reset_index(drop=True)
ctrl = []
for w in (300, 500):
    s = a.Amber_inter.rolling(w, center=True, min_periods=w).mean()
    sub = a.assign(sm=s).dropna(subset=['sm'])
    top = sub.sm.max(); plateau = sub[np.isclose(sub.sm, top)]
    hi = sub[sub.sm >= sub.sm.mean() + sub.sm.std(ddof=1)].sort_values('CE').reset_index(drop=True)
    p = int(np.argmin(np.abs(hi.CE.values - plateau.CE.median())))
    l = p
    while l-1 >= 0 and hi.CE[l-1] == hi.CE[l]-1: l -= 1
    r = p
    while r+1 < len(hi) and hi.CE[r+1] == hi.CE[r]+1: r += 1
    seg = hi.iloc[l:r+1].copy(); wg = (seg.sm - (seg.sm.mean())).clip(lower=1e-12)
    com = float((seg.CE*wg).sum()/wg.sum())
    ctrl.append(dict(window_yr=w, smoothed_max=round(float(top),3),
                     argmax_plateau_BCE_from=int(-plateau.CE.min()), argmax_plateau_BCE_to=int(-plateau.CE.max()),
                     argmax_plateau_years=int(len(plateau)),
                     hi_band_BCE_from=int(-seg.CE.max()), hi_band_BCE_to=int(-seg.CE.min()),
                     centroid_BCE=int(round(-com)), centroid_in_narrow_peak=bool(W_late <= round(-com) <= W_early)))
    print('\nCONTROL %dyr: smoothed max %.3f attained on plateau %d-%d BCE (%d yrs, i.e. argmax position is window-set-bound);'
          ' band above mean+1SD %d-%d BCE; centroid %d BCE -> inside WIDE band? %s'
          % (w, top, -plateau.CE.min(), -plateau.CE.max(), len(plateau), -seg.CE.max(), -seg.CE.min(), -round(com),
             str(W_late <= round(-com) <= W_early)))

# ---- 5. pollen context (observation only) ----
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',', index_col=0)
inter = ts[['CE','Amber_inter','pollen_inter']].copy()
r_full = inter.Amber_inter.corr(inter.pollen_inter)
rawov  = ts.dropna(subset=['pollen'])
r_raw  = rawov.Amber_inter.corr(rawov.pollen)
d = inter.assign(ar=inter.Amber_inter.rolling(301, center=True, min_periods=301).mean(),
                   pr=inter.pollen_inter.rolling(301, center=True, min_periods=301).mean()).dropna()
r_sm = d.ar.corr(d.pr)
pwin = pol.loc[(pol.CE <= -N.BCE_late) & (pol.CE >= -N.BCE_early)]
print('\nPOLLEN: r(Amber_inter, pollen_inter)=%.3f over %d-%d BCE (interpolated pollen, 3601 yrs);'
      ' r on bins with RAW pollen only=%.3f (n=%d, %d-%d BCE); r of 301-yr smoothed raw=%.3f (n=%d)'
      % (r_full, int(-ts.dropna(subset=["pollen"]).CE.max()), int(-ts.CE.min()), r_raw, len(rawov),
         int(-rawov.CE.max()), int(-rawov.CE.min()), r_sm, len(d)))
print('  narrow-peak window Belau_PC1_inter: mean=%.2f (n=%d) vs full-record mean=%.2f (n=%d) -> window is NOT below record mean'
      % (pwin.Belau_PC1_inter.mean(), len(pwin), pol.Belau_PC1_inter.mean(), len(pol)))

mill.to_csv('analysis/millennium_table.csv', index=False)
pl.to_csv('analysis/plateaus_table.csv', index=False)
pd.DataFrame(ctrl).to_csv('analysis/smoothing_control.csv', index=False)
summary = dict(primary_series='capital.csv Zamber (39 bins, 100-yr, 4300-500 BCE)', mean=round(mu,4), sd=round(sd,4),
   threshold_mean_plus_1SD=round(thr,4), winner_mean=win_mean, winner_max_tied=max_holders,
   winner_mean_alt_boundary=int(am['mean'].idxmax()),
   narrow_peak_BCE=[int(N.BCE_early), int(N.BCE_late)], narrow_peak_calBP=[int(N.calBP_early), int(N.calBP_late)],
   narrow_peak_CE=[int(N.CE_early), int(N.CE_late)], narrow_Z=round(float(z.max()),2), narrow_n_bins=int(N.n_bins),
   wide_band_BCE=[W_early, W_late], wide_band_calBP=[1950+W_early, 1950+W_late], wide_band_CE=[-W_early,-W_late],
   wide_n_bins=len(W), mill_winner_mean=round(float(mill.iloc[0].mean_Z),3), mill_winner_max=round(float(mill.iloc[0].max_Z),2),
   mill_runner_mean=round(float(mill.iloc[1].mean_Z),3), mill_runner_max=round(float(mill.iloc[1].max_Z),2),
   mill_runner_name=runner_up, r_amber_pollen_interpolated=round(float(r_full),3),
   r_amber_pollen_rawbins=round(float(r_raw),3), peak_window_BelauPC1=round(float(pwin.Belau_PC1_inter.mean()),2),
   record_BelauPC1=round(float(pol.Belau_PC1_inter.mean()),2), smoothing_control=ctrl)
class E(json.JSONEncoder):
    def default(self, o):
        import numpy as _np
        if isinstance(o, (_np.integer,)): return int(o)
        if isinstance(o, (_np.floating,)): return float(o)
        if isinstance(o, (_np.bool_,)): return bool(o)
        return super().default(o)
json.dump(summary, open('analysis/peak_summary.json','w'), indent=1, cls=E)
print('\nwrote analysis/{millennium_table,plateaus_table,smoothing_control}.csv + peak_summary.json')
