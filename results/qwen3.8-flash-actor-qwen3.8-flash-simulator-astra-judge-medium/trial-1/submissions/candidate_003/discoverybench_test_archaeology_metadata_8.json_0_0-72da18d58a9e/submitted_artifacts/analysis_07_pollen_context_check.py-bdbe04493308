import pandas as pd, numpy as np
ts  = pd.read_csv('data/time_series_data.csv', index_col=0); ts['BCE']=-ts.CE
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',', index_col=0)
def stat(s): return f'n={len(s):5d} mean={s.mean():+.2f} median={s.median():+.2f} min={s.min():+.2f} max={s.max():+.2f}'
for nm, s in [('Belau_PC1_inter FULL record (4785-702 BCE)', pol.Belau_PC1_inter),
              ('Belau_PC1_inter within amber coverage 4300-500 BCE', pol.loc[pol.CE<=-500, 'Belau_PC1_inter']),
              ('Belau_PC1_inter NARROW peak 3300-3000 BCE', pol.loc[(pol.CE<=-3000)&(pol.CE>=-3300),'Belau_PC1_inter']),
              ('Belau_PC1_inter WIDE band 4000-3000 BCE', pol.loc[(pol.CE<=-3000)&(pol.CE>=-4000),'Belau_PC1_inter']),
              ('Belau_PC1_inter 4000-3400 BCE (level 1.46)', pol.loc[(pol.CE<=-3400)&(pol.CE>=-4000),'Belau_PC1_inter']),
              ('Belau_PC1_inter 3300-3000 BCE (level 1.54)', pol.loc[(pol.CE<=-3000)&(pol.CE>=-3300),'Belau_PC1_inter'])]:
    print(f'{nm:55s} {stat(s)}')
print()
# rank of the narrow-peak window mean among all 301-yr windows of the pollen record
p = pol.sort_values('CE').reset_index(drop=True)
rm = p.Belau_PC1_inter.rolling(301, center=True, min_periods=301).mean().dropna()
print('percentile of narrow-peak window mean among all 301-yr windows of Belau_PC1_inter: %.0f%%'
      % (100*(rm < pol.loc[(pol.CE<=-3000)&(pol.CE>=-3300),'Belau_PC1_inter'].mean()).mean()))
# does the negative r survive within the amber-covered span, and is it trend-driven?
a = ts.dropna(subset=['pollen'])
print('\ncorr(Amber_inter, pollen_inter) full ts span 4100-500 BCE: %.3f' % ts.Amber_inter.corr(ts.pollen_inter))
print('corr within 4000-3000 BCE only:                              %.3f'
      % ts.loc[(ts.CE<=-3000)&(ts.CE>=-4000), 'Amber_inter'].corr(ts.loc[(ts.CE<=-3000)&(ts.CE>=-4000),'pollen_inter']))
print('corr after removing linear trend of both series (4100-500):  %.3f'
      % (lambda x,y: np.corrcoef(x,y)[0,1])(
        ts.Amber_inter.values - np.polyval(np.polyfit(ts.CE.values, ts.Amber_inter.values,1), ts.CE.values),
        ts.pollen_inter.values - np.polyval(np.polyfit(ts.CE.values, ts.pollen_inter.values,1), ts.CE.values)))
