"""Gardening prevalence by habitat type - Barcelona province plot matrix.
Protocol (agreed): 10 habitat levels everywhere; conditional layer = n.gard/n.total on
plots with n.total>0 via binomial GLM; unconditional layer = share of ALL plots in habitat
with >=1 gardening species; permutation omnibus 5000; Holm pairwise only if sum n.total>=10.
"""
import numpy as np, pandas as pd, statsmodels.api as sm, statsmodels.formula.api as smf
from statsmodels.stats.proportion import proportion_confint
from statsmodels.stats.multitest import multipletests
from scipy import stats
import json, os

rng = np.random.default_rng(20261025)
OUT = 'outputs'; os.makedirs(OUT, exist_ok=True)
pd.set_option('display.width', 240, 'display.max_columns', 60)
log = []
def P(*a):
    s = ' '.join(str(x) for x in a); print(s); log.append(s)


import patsy
def fitb(df, rhs, scale=None):
    """Binomial GLM with 2-column endog cbind(n.gard, n.other); patsy lacks cbind()."""
    y = np.column_stack([df['n.gard'].to_numpy(float), df['n.other'].to_numpy(float)])
    X = patsy.dmatrix(rhs, data=df, return_type='dataframe')
    res = sm.GLM(y, X, family=sm.families.Binomial()).fit()
    if scale is not None:
        res = sm.GLM(y, X, family=sm.families.Binomial()).fit(scale=scale)
    return res

d = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv('data/invasion_success_pathways.csv')
tm = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
# reference level = Urban (largest denominator, n.total=151) so contrasts are estimable
REF = 'Urban'
d['habitat'] = pd.Categorical(d['habitat'], [REF] + sorted(h for h in d['habitat'].unique() if h != REF))
MIN_TOT, NPERM = 10, 5000

P("=== 0. unit checks ===")
P(f"plots={len(d)} habitats={d.habitat.nunique()} sum n.total={d['n.total'].sum()} sum n.gard={d['n.gard'].sum()}")
P(f"identity gard+unint+agfo==total holds {int((d['n.total']==d[['n.gard','n.unint','n.agfo']].sum(1)).sum())}/{len(d)} rows")
sub = d[d['n.total'] > 0].copy()
P(f"plots with n.total>0: {len(sub)} ({len(sub)/len(d):.1%}) = conditional denominator")

rows = []
for h, g in d.groupby('habitat', observed=True):
    tot, gard = g['n.total'].sum(), g['n.gard'].sum()
    lo, hi = proportion_confint(gard, tot, 0.05, method='wilson') if tot > 0 else (np.nan, np.nan)
    pl, npl = int((g['n.gard'] > 0).sum()), len(g)
    plo, phi = proportion_confint(pl, npl, 0.05, method='wilson')
    gg = g[g['n.total'] > 0]
    rows.append(dict(habitat=h, n_plots=npl, plots_with_any_nonnative=int((g['n.total']>0).sum()),
        sum_n_total=int(tot), sum_n_gard=int(gard),
        cond_prevalence=gard/tot if tot else np.nan, cond_CI_low=lo, cond_CI_high=hi,
        mean_plot_ratio=gg['n.gard'].div(gg['n.total']).mean() if len(gg) else np.nan,
        uncond_plots_with_gard=pl, uncond_prevalence=pl/npl, uncond_CI_low=plo, uncond_CI_high=phi,
        status='ok' if tot >= MIN_TOT else 'insufficient data, descriptive only'))
T1 = pd.DataFrame(rows).sort_values('cond_prevalence', ascending=False)
T1.to_csv(f'{OUT}/table1_descriptive_by_habitat.csv', index=False)
P("\n=== 1. TABLE 1 two-layer habitat prevalence ===")
P(T1.round(4).to_string(index=False))
rw_c = d['n.gard'].sum()/d['n.total'].sum(); rw_u = (d['n.gard']>0).mean()
P(f"REGION-WIDE conditional {d['n.gard'].sum()}/{d['n.total'].sum()}={rw_c:.3f} CI{np.round(proportion_confint(d['n.gard'].sum(),d['n.total'].sum(),0.05,'wilson'),3)}; unconditional {int((d['n.gard']>0).sum())}/{len(d)}={rw_u:.3f}")

sub['n.other'] = sub['n.total'] - sub['n.gard']
m = fitb(sub, 'C(habitat)')
ci = m.conf_int(); ci.columns = ['logit_CI_low','logit_CI_high']
T2 = pd.DataFrame({'coef_logit': m.params, 'SE': m.bse, 'z': m.tvalues, 'p': m.pvalues}).join(ci)
T2['OR'] = np.exp(T2.coef_logit); T2['OR_low']=np.exp(T2.logit_CI_low); T2['OR_high']=np.exp(T2.logit_CI_high)
cnt_h = sub.groupby('habitat', observed=True)[['n.gard','n.total']].sum()
notes = {'Intercept': 'reference = %s (largest denominator: n.total=%d)' % (REF, int(cnt_h.loc[REF,'n.total']))}
for term in T2.index:
    if not term.startswith('C(habitat)'): continue
    lvl = term[len('C(habitat)[T.'):-1]
    gg_, tt_ = int(cnt_h.loc[lvl,'n.gard']), int(cnt_h.loc[lvl,'n.total'])
    if gg_ in (0, tt_):
        notes[term] = 'SEPARATED (%d/%d): prevalence 0 or 1, log-odds estimate unstable -> descriptive only' % (gg_, tt_)
    else:
        notes[term] = '%d/%d records' % (gg_, tt_)
T2['note'] = [notes.get(i, '') for i in T2.index]
T2['separated'] = [str(notes.get(i,'')).startswith('SEPARATED') for i in T2.index]
T2.index.name = 'term'; T2.to_csv(f'{OUT}/table2_glm_coefficients.csv')
P("\n=== 2. TABLE 2 binomial GLM logit coefficients (habitat-only, main) ===")
P(T2.round(4).to_string())
dev_r, pear_r = m.deviance/m.df_resid, m.pearson_chi2/m.df_resid
P(f"dispersion: deviance/df={dev_r:.3f} pearson/df={pear_r:.3f} (dev={m.deviance:.2f}, df={int(m.df_resid)})")

m0 = fitb(sub, '1')
lrt = 2*(m.llf-m0.llf); df = int(m.df_model-m0.df_model); p_asym = stats.chi2.sf(lrt, df)
P(f"\n=== 3. OMNIBUS: asymptotic LRT chi2={lrt:.2f} df={df} p={p_asym:.3g}")
g_, o_ = sub['n.gard'].to_numpy(float), sub['n.other'].to_numpy(float)
lab = pd.factorize(sub['habitat'])[0]
def lr_stat(gg, oo, lb):
    tot = np.bincount(lb, gg+oo); suc = np.bincount(lb, gg)
    p = np.divide(suc, tot, out=np.zeros_like(suc), where=tot>0)
    with np.errstate(divide='ignore', invalid='ignore'):
        ll = np.nansum(np.where(suc>0, suc*np.log(p), 0) + np.where(tot-suc>0,(tot-suc)*np.log(1-p),0))
    T, G = tot.sum(), suc.sum(); pg = G/T
    return 2*(ll - (G*np.log(pg) + (T-G)*np.log(1-pg)))
obs = lr_stat(g_, o_, lab); P(f"closed-form LR={obs:.2f} (must equal GLM LRT {lrt:.2f})")
perm = np.array([lr_stat(g_, o_, rng.permutation(lab)) for _ in range(NPERM)])
p_perm = (1 + (perm >= obs).sum())/(NPERM+1)
P(f"permutation omnibus ({NPERM} shuffles): mean={perm.mean():.2f} p95={np.percentile(perm,95):.2f} -> p={p_perm:.3g}")

elig = [h for h in T1.habitat if T1.set_index('habitat').loc[h,'sum_n_total'] >= MIN_TOT]
excl = [h for h in T1.habitat if h not in elig]
P(f"\n=== 4. pairwise: eligible(sum n.total>={MIN_TOT})={elig} excluded={excl}")
cnt = sub.groupby('habitat', observed=True)[['n.gard','n.other']].sum().loc[elig]
rec = []
for i in range(len(elig)):
    for j in range(i+1, len(elig)):
        a, b = elig[i], elig[j]
        tab = np.array([[cnt.loc[a,'n.gard'], cnt.loc[a,'n.other']],[cnt.loc[b,'n.gard'], cnt.loc[b,'n.other']]], float)
        orr, pf = stats.fisher_exact(tab)
        v = tab.copy(); v[v == 0] = 0.5
        se = np.sqrt((1/v[:,0] + 1/v[:,1]).sum())
        rec.append(dict(habitat_A=a, habitat_B=b, p_A=tab[0,0]/tab[0].sum(), p_B=tab[1,0]/tab[1].sum(),
                        OR_AvsB=orr, OR_low=np.exp(np.log(max(orr,1e-12))-1.96*se),
                        OR_high=np.exp(np.log(max(orr,1e-12))+1.96*se), p_fisher=pf))
PW = pd.DataFrame(rec); PW['p_holm'] = multipletests(PW.p_fisher, method='holm')[1]
PW['significant_after_Holm'] = PW.p_holm < 0.05
PW = PW.sort_values('p_holm'); PW.to_csv(f'{OUT}/table3_pairwise_holm.csv', index=False)
P(PW.round(4).to_string(index=False))
P(f"pairs={len(PW)} raw p<0.05: {int((PW.p_fisher<0.05).sum())} Holm-sig: {int(PW.significant_after_Holm.sum())}")

P("\n=== 5. SENSITIVITY ===")
sens = []
d['any_gard'] = (d['n.gard'] > 0).astype(int); d['one_minus'] = 1 - d['any_gard']
mp = fitb(d.assign(**{'n.gard': d['any_gard'], 'n.other': d['one_minus']}), 'C(habitat)')
mp0 = fitb(d.assign(**{'n.gard': d['any_gard'], 'n.other': d['one_minus']}), '1')
lntp = 2*(mp.llf-mp0.llf); pntp = stats.chi2.sf(lntp, 9)
pres = d.groupby('habitat', observed=True)['any_gard'].agg(['mean','size'])
P(f"5a presence response (all {len(d)} plots, unconditional layer): LRT={lntp:.2f} df=9 p={pntp:.3g}")
sens.append(dict(model='presence_all_plots(unconditional)', statistic='LRT df9', value=lntp, p=pntp,
                 top=pres['mean'].idxmax(), top_value=pres['mean'].max(),
                 spread=f"{pres['mean'].min():.3f}-{pres['mean'].max():.3f}", spread_units='share of plots'))
sens.append(dict(model='conditional_count_MAIN', statistic='LRT df9', value=lrt, p=p_asym,
                 top=T1.habitat.iloc[0], top_value=T1.cond_prevalence.iloc[0],
                 spread=f"{T1.cond_prevalence[T1.status=='ok'].min():.3f}-{T1.cond_prevalence[T1.status=='ok'].max():.3f}",
                 spread_units='share of records (eligible only)'))
mq = fitb(sub, 'C(habitat)', scale='X2')
P(f"5b quasi-binomial: pearson scale={mq.scale:.3f}; max habitat-SE inflation vs binomial={(mq.bse/m.bse).max():.2f}x")
sens.append(dict(model='quasi_binomial', statistic='pearson dispersion scale', value=mq.scale, p=np.nan,
                 top=np.nan, top_value=np.nan,
                 spread=f"max SE ratio {(mq.bse/m.bse).max():.2f}x", spread_units='ratio vs main'))
coll = {'Broad-leaved forests':'SemiNatural','Coniferous forests':'SemiNatural','Scrublands':'SemiNatural',
        'Rock outcrops':'SemiNatural','Meadows':'SemiNatural','Urban':'Urban','Riparian':'Riparian',
        'Croplands':'Croplands','Wetlands':'Wetlands','Coastal':'Coastal'}
sub2 = sub.copy(); sub2['hab_group'] = sub2['habitat'].map(coll)
mc = fitb(sub2, 'C(hab_group)')
mc0 = fitb(sub2, '1')
lrtc = 2*(mc.llf-mc0.llf); lrtc_p = stats.chi2.sf(lrtc, 4)
cg = sub2.groupby('hab_group', observed=True).apply(lambda x: x['n.gard'].sum()/x['n.total'].sum(), include_groups=False)
P(f"5c collapsed 5 levels: LRT={lrtc:.2f} p={lrtc_p:.3g}; prevalence:"); P(cg.round(3).to_string())
sens.append(dict(model='collapsed_semiNatural(5 levels)', statistic='LRT df4', value=lrtc, p=lrtc_p,
                 top=cg.idxmax(), top_value=cg.max(), spread=f"{cg.min():.3f}-{cg.max():.3f}", spread_units='share of records'))
sub = sub.assign(log_road=np.log(sub['distance.road']))
COV = {'urban.2009.1000m':'cov_x','urban.2009.50m':'cov_x','cropland.2009.1000m':'cov_x'}
sub = sub.rename(columns={k:'cov_x' for k in COV}) if False else sub
for cv in ['urban.2009.1000m','urban.2009.50m','cropland.2009.1000m']:
    s2 = sub.rename(columns={cv: 'cov_x'})
    mm = fitb(s2, 'C(habitat) + elevation + log_road + cov_x')
    mmb = fitb(s2, 'elevation + log_road + cov_x')
    l_m = 2*(mm.llf-mmb.llf); p_m = stats.chi2.sf(l_m, 9)
    base_or = np.exp(m.params).drop('Intercept')
    hidx = [i for i in mm.params.index if i.startswith('C(habitat)')]
    adj_or = np.exp(mm.params[hidx])
    common = adj_or.index.intersection(base_or.index)
    moved = float(np.nanmax(np.abs(np.log(adj_or[common].values/base_or[common].values))))
    se_r = float(np.nanmax((mm.bse[hidx].values/m.bse[hidx].values)))
    P(f"5d adjusted[{cv}]: habitat LRT={l_m:.2f} df9 p={p_m:.3g}; max |log OR shift|={moved:.2f}; max SE ratio={se_r:.2f}")
    sens.append(dict(model=f'adjusted habitat+elev+logroad+{cv}(robustness only)', statistic='habitat LRT df9',
                     value=l_m, p=p_m, top=np.nan, top_value=np.nan,
                     spread=f"max logOR shift {moved:.2f}; max SE ratio {se_r:.2f}", spread_units='vs main model'))
SENS = pd.DataFrame(sens); SENS.to_csv(f'{OUT}/table4_sensitivity.csv', index=False)
P("\nTABLE 4:\n" + SENS.round(4).to_string(index=False))

gp = sp[sp['intro.pathway'] == 'Gardening'].sort_values('number.of.invaded.plots', ascending=False)
tg = int(gp['number.of.invaded.plots'].sum()); t3 = int(gp['number.of.invaded.plots'].head(3).sum())
P(f"\n=== 6. dominant species (species table = magnitude order only) === gardening species={len(gp)} records={tg} top3={t3} ({t3/tg:.1%})")
P(gp[['Scientific_name','number.of.invaded.plots','habitat.range']].head(6).to_string(index=False))
ap = sp.sort_values('number.of.invaded.plots', ascending=False)
t3a, ta = int(ap['number.of.invaded.plots'].head(3).sum()), int(sp['number.of.invaded.plots'].sum())
P(f"top3 of ALL pathway records: {t3a}/{ta} = {t3a/ta:.1%}; species in 1 plot only: {int((sp['number.of.invaded.plots']==1).sum())}/{len(sp)}")
P(ap[['Scientific_name','intro.pathway','number.of.invaded.plots']].head(5).to_string(index=False))

piv = tm.pivot_table(index='introduction.period', columns='pathway', values='n', aggfunc='sum')
order = ['Before 1500','1501-1900','1901-1984','1985-2019']; piv = piv.loc[order]
TC = piv.copy(); TC['total'] = piv.sum(1); TC['gardening_share'] = piv['Gardening']/TC['total']
cl = [proportion_confint(int(piv.loc[o,'Gardening']), int(TC.loc[o,'total']), 0.05,'wilson') for o in order]
TC['CI_low'] = [a for a,_ in cl]; TC['CI_high'] = [b for _,b in cl]
TC.to_csv(f'{OUT}/table5_temporal_context.csv')
P("\n=== 7. TABLE 5 temporal context (background, not the answer) ===\n" + TC.round(4).to_string())

L = ["Conditional gardening prevalence by habitat (pooled share of records, Wilson 95% CI)",
     f"region-wide = {rw_c:.3f}   (n records = {int(d['n.total'].sum())}; 441/632 plots had 0 non-native records and carry no information here)", ""]
W = 58
L.append("  habitat                   share  CI                      0                  50                 100")
for _, r in T1.iterrows():
    if r['sum_n_total'] == 0: continue
    ch = ['-']*W
    for k in range(int(round(r['cond_CI_low']*W)), max(int(round(r['cond_CI_high']*W)), int(round(r['cond_CI_low']*W))+1)):
        ch[k] = '-'
    ch[min(int(round(r['cond_prevalence']*W)), W-1)] = '*'
    flg = '' if r['status'] == 'ok' else '  <- insufficient data, descriptive only'
    L.append(f"  {r['habitat'][:24]:<24} {r['cond_prevalence']*100:5.1f}%  [{r['cond_CI_low']*100:4.1f},{r['cond_CI_high']*100:5.1f}]  |{''.join(ch)}|  n={int(r['sum_n_total']):<4}{flg}")
L.append("  (* = point estimate, - = Wilson CI, scale 0-100%)")
fig = '\n'.join(L) + "\n"
open(f'{OUT}/figure1_forest_ascii.txt','w').write(fig)
P("\n=== 8. ASCII FOREST ===\n" + fig)

json.dump(dict(lrt=float(lrt), df_omnibus=df, p_asym=float(p_asym), perm_p=float(p_perm), obs_lr=float(obs),
    perm_mean=float(perm.mean()), perm_p95=float(np.percentile(perm,95)), dev_over_df=float(dev_r),
    pearson_over_df=float(pear_r), quasi_scale=float(mq.scale), n_cond_plots=len(sub), n_plots=len(d),
    region_cond=float(rw_c), region_uncond=float(rw_u), eligible=elig, excluded=excl,
    top3_gardening_share=float(t3/tg), top_species=gp['Scientific_name'].head(3).tolist(),
    n_pairs=len(PW), n_sig_holm=int(PW.significant_after_Holm.sum()),
    sig_pairs=PW.loc[PW.significant_after_Holm, ['habitat_A','habitat_B','p_holm']].to_dict('records'),
    presence_lrt=float(lntp), presence_p=float(pntp), collapsed_lrt=float(lrtc), collapsed_p=float(lrtc_p)),
    open(f'{OUT}/summary.json','w'), indent=2)
open('work/analysis_log.txt','w').write('\n'.join(log))
P("\nDONE")
