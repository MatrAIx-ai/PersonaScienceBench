import pandas as pd, numpy as np, re
pd.set_option('display.width',220,'display.max_columns',60)
d = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
s = pd.read_csv('data/invasion_success_pathways.csv')

print("### unit of observation check")
print("rows:", len(d), "| unique lon/lat:", len(d[['longitude','latitude']].drop_duplicates()))
print("sum n.total (plot matrix):", int(d["n.total"].sum()), "| sum n.gard:", int(d["n.gard"].sum()),
      "| sum n.unint:", int(d["n.unint"].sum()), "| sum n.agfo:", int(d["n.agfo"].sum()))
print("overall region-wide gardening share of records:", round(d["n.gard"].sum()/d["n.total"].sum(),4))
print("plots with n.total==0:", int((d["n.total"]==0).sum()), f"({(d["n.total"]==0).mean():.1%})")
print("plots with n.total>0:", int((d["n.total"]>0).sum()))
print("plots with n.gard>0:", int((d["n.gard"]>0).sum()))

print("\n### per-habitat denominators (FEASIBILITY ONLY)")
g = d.groupby('habitat').agg(plots=('n.total','size'), sum_total=('n.total','sum'),
      plots_any=('n.total', lambda x:(x>0).sum()), plots_gard=('n.gard', lambda x:(x>0).sum()),
      max_total=('n.total','max'))
g['pct_plots_invaded']=(100*g.plots_any/g.plots).round(1)
print(g.to_string())
print("\nhabitats with total gardening records <5:", int((d.groupby('habitat')["n.gard"].sum()<5).sum()),
      "| ==0:", int((d.groupby('habitat')["n.gard"].sum()==0).sum()))
print("min..max habitat-level gardening count:", int(d.groupby('habitat')["n.gard"].sum().min()), "..", int(d.groupby('habitat')["n.gard"].sum().max()))
print("min..max habitat-level n.total:", int(d.groupby('habitat')["n.total"].sum().min()), "..", int(d.groupby('habitat')["n.total"].sum().max()))
print("habitat-level n.total==0? ", (d.groupby('habitat')["n.total"].sum()==0).sum())

print("\n### species-table cross-check")
print("rows:", len(s), "unique Scientific_name:", s.Scientific_name.nunique(), "duplicated==True rows:")
print(s.loc[s['duplicated'], ['Scientific_name','intro.pathway','number.of.invaded.plots','habitat.range']].to_string())
u = s[~s['duplicated']]
print("sum invaded plots (all rows):", s['number.of.invaded.plots'].sum(), "| non-duplicated only:", u['number.of.invaded.plots'].sum())
print("species with habitat.range>1 (i.e. occurs in several of the 10 habitat types):", int((s['habitat.range']>1).sum()), "/", len(s))
print("any column that maps species to specific habitat?", [c for c in s.columns if re.search('habitat|plot', c)])
print("pathway labels identical to plot-table concept? temporal labels:",
      sorted(pd.read_csv('data/temporal_trends_contingency_table.csv',sep='\t')['pathway'].unique()))
print("species-table pathway labels:", sorted(s['intro.pathway'].unique()))
print("\nsum n.total in plot matrix vs sum invaded plots -> differ by:", int(d["n.total"].sum())-int(s['number.of.invaded.plots'].sum()))

print("\n### tree")
raw=open('data/phylogenetic_tree.txt').read().strip()
tips = re.findall(r'([A-Za-z0-9_]+_[A-Za-z0-9_]+)(?=[:,)])', raw)
print("tip count:", len(tips), "unique:", len(set(tips)))
lab = set(s['phylo.tip.label'])
print("phylo.tip.label unique:", len(lab), "| in tree:", len(lab & set(tips)), "| missing from tree:", len(lab - set(tips)), list(lab-set(tips))[:5])
print("tree tips not in species table:", list(set(tips)-lab)[:5])
print("tree is ultrametric-ish, no habitat trait attached: any 'habitat' string in tree file:", 'abitat' in raw)

print("\n### covariate collinearity (for pruning)")
cc = ['elevation','annual.temperature','annual.rainfall','annual.radiation','distance.road','distance.stream',
      'urban.2009.50m','urban.2009.500m','urban.2009.1000m','cropland.2009.50m','cropland.2009.500m','cropland.2009.1000m',
      'urban.1956.1000m','urban.1993.1000m','cropland.1956.1000m','cropland.1993.1000m']
cm = d[cc].corr(method='spearman')
print(cm.round(2).to_string())
print("\nwithin-habitat sd of urban.2009.1000m by habitat:")
print(d.groupby('habitat')['urban.2009.1000m'].agg(['mean','std','min','max']).round(3).to_string())
print("\nelevation by habitat (confounder check):")
print(d.groupby('habitat')['elevation'].agg(['mean','median','min','max']).round(1).to_string())
print("\nlog(distance.road) by habitat:")
print(d.groupby('habitat')['distance.road'].median().round(1).to_string())
