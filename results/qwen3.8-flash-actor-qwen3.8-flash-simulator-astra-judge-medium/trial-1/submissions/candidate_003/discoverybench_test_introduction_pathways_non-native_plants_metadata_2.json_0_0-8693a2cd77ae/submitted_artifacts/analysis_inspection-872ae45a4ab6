import pandas as pd, numpy as np
pd.set_option('display.width', 200, 'display.max_columns', 60)

print("="*80); print("A) invaded_niche_pathways.csv")
d = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
print("shape:", d.shape)
print("n columns:", len(d.columns))
print("columns:", list(d.columns))
print("\ndtypes value_counts:\n", d.dtypes.value_counts())
print("\ndtypes per col:")
print(d.dtypes.to_string())
cnt = d['habitat'].value_counts(dropna=False)
print("\nunique habitat n =", d['habitat'].nunique(dropna=True), " NA habitat =", int(d['habitat'].isna().sum()))
print(cnt.to_string())
print("\nhabitat labels repr:")
for v in sorted(d['habitat'].dropna().unique()):
    print(repr(v))
cols = ['n.gard','n.unint','n.agfo','n.total']
print("\n--- counts columns ---")
print(d[cols].describe().T.to_string())
print("NA counts:\n", d[cols].isna().sum().to_string())
print("dtypes:\n", d[cols].dtypes.to_string())
print("zeros:\n", (d[cols]==0).sum().to_string())
print("negatives:\n", (d[cols]<0).sum().to_string())
print("non-integer values (float w/ frac):", {c: int(((d[c]%1)!=0).sum()) for c in cols if pd.api.types.is_float_dtype(d[c])} if True else None)
s = d[['n.gard','n.unint','n.agfo']].sum(axis=1, min_count=3)
diff = d['n.total'] - s
print("\nn.total - (gard+unint+agfo): value_counts:")
print(diff.value_counts(dropna=False).sort_index().to_string())
bad = d.loc[diff.fillna(-999)!=0, ['habitat',*cols]]
bad['diff'] = diff[diff.fillna(-999)!=0]
print("\nrows where sum != n.total:", len(bad))
print(bad.head(30).to_string())
if len(bad):
    print("habitat distribution of mismatched rows:")
    print(bad['habitat'].value_counts().to_string())
print("\nrows where sum != total AND any component NA:", int((d[['n.gard','n.unint','n.agfo','n.total']].isna().any(axis=1)).sum()))
print("rows with any NA in the 4 count cols:", int(d[cols].isna().any(axis=1).sum()))
print("n.total == 0 rows:", int((d['n.total']==0).sum()))
print("\nduplicated full rows:", int(d.duplicated().sum()))
print("duplicated habitat values (expected, plot-level):", int(d['habitat'].duplicated().sum()))
print("unique (habitat, longitude, latitude) rows:", len(d.drop_duplicates(['habitat','longitude','latitude'])), "of", len(d))
print("duplicated habitat+lon+lat:", int(d.duplicated(['habitat','longitude','latitude']).sum()))
print("\nexample rows (counts + key covariates):")
key = ['habitat','n.gard','n.unint','n.agfo','n.total','elevation','urban.2009.50m','urban.2009.1000m','cropland.2009.1000m','distance.road','annual.temperature','annual.rainfall']
print(d[key].head(10).to_string())
print("\n--- covariate NA / ranges (all numeric cols) ---")
num = d.select_dtypes(include=[np.number])
summ = pd.DataFrame({'n':num.count(),'NA':num.isna().sum(),'min':num.min(),'max':num.max(),'mean':num.mean()})
print(summ.to_string())
nonnum = d.select_dtypes(exclude=[np.number])
print("\nnon-numeric cols:", list(nonnum.columns))
for c in nonnum.columns:
    print(c, "| unique:", d[c].nunique(dropna=True), "| NA:", int(d[c].isna().sum()), "| top:", d[c].value_counts(dropna=False).head(4).to_dict())
print("\nzeros among land-cover covariates:", int((num.filter(regex='urban|cropland')==0).sum().sum()))
print("file size bytes:", __import__('os').path.getsize('data/invaded_niche_pathways.csv'))

print("="*80); print("B) invasion_success_pathways.csv")
s2 = pd.read_csv('data/invasion_success_pathways.csv')
print("shape:", s2.shape, "cols:", list(s2.columns))
print("\ndtypes:\n", s2.dtypes.to_string())
print("\nintro.pathway unique (repr) + counts + share:")
vc = s2['intro.pathway'].value_counts(dropna=False)
print(pd.DataFrame({'n':vc,'share':(vc/len(s2)).round(4)}).to_string())
for v in s2['intro.pathway'].dropna().unique(): print(repr(v))
print("\nNA per column (top):")
print(s2.isna().sum()[s2.isna().sum()>0].to_string())
print("\nhabitat.range describe:\n", s2['habitat.range'].describe().to_string())
print("habitat.range value_counts:\n", s2['habitat.range'].value_counts(dropna=False).sort_index().to_string())
print("\ngardening vs others habitat.range:")
print(s2.groupby('intro.pathway', dropna=False)['habitat.range'].agg(['count','mean','median','min','max']).round(3).to_string())
print("\nseed-bank columns present?", [c for c in s2.columns if 'habitat' in c.lower()])
print("columns mentioning plot:", [c for c in s2.columns if 'plot' in c.lower()])
print("\nexample rows:")
print(s2[['Scientific_name','family','intro.pathway','number.of.invaded.plots','habitat.range','invaded.niche.breadth','mrt','duplicated','phylo.tip.label']].head(8).to_string())
print("\nduplicated col value_counts:", s2['duplicated'].value_counts(dropna=False).to_dict())
print("duplicated Scientific_name:", int(s2['Scientific_name'].duplicated().sum()))
print("phylo.tip.label NA:", int(s2['phylo.tip.label'].isna().sum()))
print("number.of.invaded.plots range:", s2['number.of.invaded.plots'].min(), s2['number.of.invaded.plots'].max(), "sum:", s2['number.of.invaded.plots'].sum())
# does habitat.range ever exceed 10?
print("habitat.range > 10:", int((s2['habitat.range']>10).sum()))

print("="*80); print("C) temporal_trends_contingency_table.csv")
t = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
print("shape:", t.shape, "cols:", list(t.columns))
print(t.to_string())
print("\ndtypes:\n", t.dtypes.to_string())
print("\nperiods:", list(t['introduction.period'].unique()))
print("pathways:", [repr(x) for x in t['pathway'].unique()])
piv = t.pivot_table(index='introduction.period', columns='pathway', values='n', aggfunc='sum')
print("\npivot:\n", piv.to_string())
print("\nrow shares:\n", (piv.T/piv.sum(axis=1)).T.round(4).to_string())
print("\ntotals per period:\n", t.groupby('introduction.period')['n'].sum().to_string())
print("grand total n:", t['n'].sum())

print("="*80); print("D) phylogenetic_tree.txt")
raw = open('data/phylogenetic_tree.txt').read()
print("chars:", len(raw), "lines:", raw.count('\n')+1)
print("first 300:", raw[:300].replace('\n','\\n'))
import re
tips = re.findall(r'[A-Za-z_]+_[A-Za-z_]+', raw)
print("apparent tip-like tokens:", len(tips), "unique:", len(set(tips)))
print("sample tips:", sorted(set(tips))[:10])
