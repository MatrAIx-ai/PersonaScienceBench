import numpy as np, pandas as pd, json
from scipy import stats
d=pd.read_csv('data/invaded_niche_pathways.csv',sep='\t')
sub=d[d['n.total']>0]
def pooled(df):
    c=df.groupby('habitat',observed=True)[['n.gard','n.total']].sum()
    return {h:(int(c.loc[h,'n.gard']),int(c.loc[h,'n.total'])) for h in c.index}
out=[]
for a,b in [('Wetlands','Croplands'),('Coastal','Croplands'),('Wetlands','Urban'),('Coastal','Urban'),('Riparian','Croplands')]:
    arr=[]
    for drop in sub.index:
        c=pooled(sub.drop(index=drop))
        if a in c and b in c:
            orr,pf=stats.fisher_exact([[c[a][0],c[a][1]-c[a][0]],[c[b][0],c[b][1]-c[b][0]]])
            arr.append((orr,pf))
    arr=np.array(arr)
    out.append({'contrast': f"{a} vs {b}", 'n_jackknife': len(arr), 'OR_min': arr[:,0].min(),
                'OR_median': float(np.median(arr[:,0])), 'OR_max': arr[:,0].max(), 'max_p': arr[:,1].max(),
                'all_p_lt_005': bool((arr[:,1] < 0.05).all())})
J=pd.DataFrame(out); J.to_csv('outputs/table8_jackknife_drop1plot.csv',index=False)
print(J.round(4).to_string(index=False))
