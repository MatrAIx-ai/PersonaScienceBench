"""Supplementary: pathway composition per habitat, unconditional-layer pairwise (Holm),
permutation omnibus for the unconditional layer, plot-level jackknife of key contrasts."""
import numpy as np, pandas as pd, statsmodels.api as sm, patsy
from statsmodels.stats.multitest import multipletests
from scipy import stats
import json
rng = np.random.default_rng(7)
OUT='outputs'
d = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
REF='Urban'; d['habitat']=pd.Categorical(d['habitat'],[REF]+sorted(h for h in d['habitat'].unique() if h!=REF))

print("=== pathway composition per habitat (shares of records) ===")
comp = d.groupby('habitat', observed=True)[['n.gard','n.unint','n.agfo','n.total']].sum()
comp['share_gard']=(comp['n.gard']/comp['n.total']).round(3)
comp['share_unint']=(comp['n.unint']/comp['n.total']).round(3)
comp['share_agfo']=(comp['n.agfo']/comp['n.total']).round(3)
comp['dominant_pathway']=['Gardening' if comp['n.gard'][i]>=max(comp['n.unint'][i],comp['n.agfo'][i]) else ('Unintentional' if comp['n.unint'][i]>=comp['n.agfo'][i] else 'AgriForest') for i in comp.index]
comp = comp.sort_values('share_gard', ascending=False)
print(comp.to_string()); comp.to_csv(f'{OUT}/table6_pathway_composition.csv')

def wilson(k,n,a=0.05):
    from statsmodels.stats.proportion import proportion_confint
    return proportion_confint(k,n,a,'wilson')

print("\n=== unconditional layer: pairwise Fisher + Holm (all 10 habitats; n_plots 29-106) ===")
tab = d.groupby('habitat', observed=True).apply(lambda x: pd.Series({'k':(x['n.gard']>0).sum(),'n':len(x)}), include_groups=False)
hs=list(tab.index); rec=[]
for i in range(len(hs)):
    for j in range(i+1,len(hs)):
        a,b=hs[i],hs[j]
        t=np.array([[tab.loc[a,'k'],tab.loc[a,'n']-tab.loc[a,'k']],[tab.loc[b,'k'],tab.loc[b,'n']-tab.loc[b,'k']]])
        orr,pf=stats.fisher_exact(t)
        rec.append(dict(habitat_A=a,habitat_B=b,p_A=t[0,0]/t[0].sum(),p_B=t[1,0]/t[1].sum(),OR_AvsB=orr,p_fisher=pf))
PW=pd.DataFrame(rec); PW['p_holm']=multipletests(PW.p_fisher,method='holm')[1]
PW['sig_holm_0.05']=PW.p_holm<0.05; PW=PW.sort_values('p_holm')
PW.to_csv(f'{OUT}/table7_uncond_pairwise_holm.csv',index=False)
print(PW.head(14).round(4).to_string(index=False))
print(f"pairs={len(PW)} raw p<0.05={int((PW.p_fisher<0.05).sum())} Holm-sig={int(PW['sig_holm_0.05'].sum())}")

print("\n=== permutation omnibus, unconditional layer (any_gard ~ habitat, all plots) ===")
y=(d['n.gard']>0).to_numpy(float); lab=pd.factorize(d['habitat'])[0]
def lr(y,lab):
    tot=np.bincount(lab); suc=np.bincount(lab,y); p=suc/tot
    with np.errstate(divide='ignore',invalid='ignore'):
        ll=np.nansum(np.where(suc>0,suc*np.log(p),0)+np.where(tot-suc>0,(tot-suc)*np.log(1-p),0))
    T,G=tot.sum(),suc.sum(); pg=G/T
    return 2*(ll-(G*np.log(pg)+(T-G)*np.log(1-pg)))
obs=lr(y,lab); perm=np.array([lr(y,rng.permutation(lab)) for _ in range(5000)])
p_perm=(1+(perm>=obs).sum())/5001
print(f"LR={obs:.2f} perm mean={perm.mean():.2f} p95={np.percentile(perm,95):.2f} perm p={p_perm:.3g}")

print("\n=== jackknife over plots (drop-one) for conditional layer key contrasts ===")
sub=d[d['n.total']>0].copy()
def pooled(df):
    c=df.groupby('habitat',observed=True)[['n.gard','n.total']].sum()
    return {h:(c.loc[h,'n.gard'],c.loc[h,'n.total']) for h in c.index}
pairs=[('Wetlands','Croplands'),('Coastal','Croplands'),('Wetlands','Urban')]
base=pooled(sub)
for a,b in pairs:
    stats_list=[]
    for drop in sub.index:
        p=sub.drop(index=drop); c=pooled(p)
        if a in c and b in c:
            orr,pf=stats.fisher_exact([[c[a][0],c[a][1]-c[a][0]],[c[b][0],c[b][1]-c[b][0]]])
            stats_list.append((orr,pf))
    sl=np.array(stats_list)
    print(f"{a} vs {b}: n_jk={len(sl)} OR range {sl[:,0].min():.2f}-{sl[:,0].max():.2f} (base OR {stats.fisher_exact([[base[a][0],base[a][1]-base[a][0]],[base[b][0],base[b][1]-base[b][0]]])[0]:.2f}) ; max jk p={sl[:,1].max():.4f} -> all sig: {bool((sl[:,1]<0.05).all())}")
    # per-contrast detail superseded by table8_jackknife_drop1plot.csv
if False: json.dump(dict(pair=f"{a}|{b}", or_min=float(sl[:,0].min()), or_max=float(sl[:,0].max()), max_p=float(sl[:,1].max()), all_sig=bool((sl[:,1]<0.05).all())), open(f'{OUT}/jackknife_{a}_vs_{b}".json'.replace('"',''),'w'))

s=json.load(open(f'{OUT}/summary.json'))
s.update(uncond_perm_LR=float(obs), uncond_perm_p=float(p_perm),
    uncond_pairs=int(len(PW)), uncond_sig_holm=int(PW['sig_holm_0.05'].sum()))
json.dump(s, open(f'{OUT}/summary.json','w'), indent=2)
print("\nsummary.json updated")
