"""
Approved design: context of gardening-pathway prevalence across habitat types.
Data: data/invaded_niche_pathways.csv (TSV), light cross-check vs invasion_success_pathways.csv.
Pre-declared rules (fixed before looking at test results):
  R1. AgriForest -> collapsed into pathway column 'Other' (23 occurrences).
  R2. Habitats with row total (sum n.total) < 5 species occurrences = 'descriptive only',
      excluded from contingency test.
  R3. Zero-count plots (n.total==0) are NOT deleted from the dataset; they simply carry
      no pathway information and therefore contribute 0 occurrences to the test.
  R4. Monte-Carlo p (10,000 permutations, pathway labels shuffled within fixed habitat
      row totals) is the reported p; asymptotic chi2 shown for reference only.
  R5. Context covariates: elevation + urban.2009.500m only (500 m = intermediate buffer;
      50 m is zero-inflated at plot scale, 1000 m mixes regional landscape).
      Cropland + climate: single sensitivity correlation line. Habitat-level correlations
      (n=10 or n=8) are DESCRIPTIVE/CONTEXTUAL, not inference.
"""
import numpy as np, pandas as pd
from scipy.stats import chi2_contingency, spearmanr

rng = np.random.default_rng(42)
n = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
s = pd.read_csv('data/invasion_success_pathways.csv')

print("=== CROSS-CHECK pathway labels ===")
print("niche cols n.gard/n.unint/n.agfo vs success-file levels:",
      sorted(s['intro.pathway'].unique()), "| identity n.gard+n.unint+n.agfo==n.total all rows:",
      bool((n[['n.gard','n.unint','n.agfo']].sum(axis=1)==n['n.total']).all()))
print("species pool (81 rows):", s['intro.pathway'].value_counts().to_dict(),
      "-> gardening share of pool = %.1f%%" % (100*(s['intro.pathway']=='Gardening').mean()))

# ---------- habitat x pathway occurrence table ----------
habs = sorted(n['habitat'].unique())
tab = n.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum()
tab['total'] = tab.sum(axis=1)
tab['share_gard'] = (tab['n.gard']/tab['total']).round(3)
tab['share_unint'] = (tab['n.unint']/tab['total']).round(3)
tab['share_agfo'] = (tab['n.agfo']/tab['total']).round(3)
print("\n=== FULL habitat x pathway counts AND shares (all 10 habitats) ===")
print(tab)
zero_plots = int((n['n.total']==0).sum())
print("Zero-count plots: %d of %d rows kept in dataset, contribute 0 occurrences." % (zero_plots,len(n)))

excl = tab.index[tab['total'] < 5].tolist()
print("R2: descriptive-only habitats (row total < 5): %s -> excluded from test" % excl)
keep = [h for h in habs if h not in excl]

M = tab.loc[keep, ['n.gard','n.unint','n.agfo']].rename(columns={'n.agfo':'n.other'}).values
row_tot = M.sum(axis=1); col_tot = M.sum(axis=0); N = M.sum()
chi2, p_asym, dof, exp = chi2_contingency(M)
V = np.sqrt(chi2 / (N * (min(M.shape)-1)))
# Monte-Carlo: shuffle pathway labels within fixed margins
labels = np.repeat(np.arange(M.shape[1]), col_tot)
obs = chi2; ge = 0; B = 10000
for b in range(B):
    L = rng.permutation(labels); sim = np.zeros_like(M); i = 0
    for r,rt in enumerate(row_tot):
        cnt = np.bincount(L[i:i+rt], minlength=M.shape[1]); sim[r] = cnt; i += rt
    if chi2_contingency(sim)[0] >= obs: ge += 1
p_mc = (ge+1)/(B+1)
print("\n=== MAIN TEST: habitat(%d) x pathway(3: Gardening/Unintentional/Other) ===" % len(keep))
print("kept habitats:", keep)
print("N occurrences = %d | chi2 = %.3f | df = %d | asymptotic p = %.3g | min expected cell = %.2f (<5 -> MC)" % (N, chi2, dof, p_asym, exp.min()))
print("Monte-Carlo p (%d perms, fixed margins) = %.4f | Cramer's V = %.3f" % (B, p_mc, V))

# ---------- secondary contrast ----------
print("\n=== SECONDARY CONTRAST: gardening vs unintentional share per habitat ===")
c = tab[['share_gard','share_unint','total']].copy()
c['contrast_gard_minus_unint'] = (c['share_gard']-c['share_unint']).round(3)
c['style'] = np.where(c['contrast_gard_minus_unint']>0.1,'gardening-leaning',
              np.where(c['contrast_gard_minus_unint']<-0.1,'unintentional-leaning','mixed'))
print(c.sort_values('contrast_gard_minus_unint', ascending=False))

# ---------- covariates: elevation + urban.2009.500m ----------
cov = n.groupby('habitat').agg(el=('elevation','median'), ur500=('urban.2009.500m','mean'),
                               ur50=('urban.2009.50m','mean'), crp=('cropland.2009.1000m','mean'),
                               temp=('annual.temperature','mean'))
cov['share_gard']=tab['share_gard']
print("\n=== CONTEXT covariates per habitat ===")
print(cov.round(3))
for lab,sub in [('n=10 habitats', cov), ('n=8 tested habitats', cov.loc[keep])]:
    r1,p1 = spearmanr(sub['share_gard'], sub['el']); r2,p2 = spearmanr(sub['share_gard'], sub['ur500'])
    print("Spearman (DESCRIPTIVE, %s): gard_share~elevation rho=%.2f p=%.3f | gard_share~urban500m rho=%.2f p=%.3f" % (lab,r1,p1,r2,p2))
r3,p3 = spearmanr(cov['share_gard'], cov['crp']); r4,p4 = spearmanr(cov['share_gard'], cov['temp'])
print("Sensitivity line: gard_share~cropland1000m rho=%.2f p=%.2f ; gard_share~annual.temp rho=%.2f p=%.2f (descriptive)" % (r3,p3,r4,p4))
# temporal framing (one line)
t = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
ts = t.pivot(index='introduction.period', columns='pathway', values='n')
fr = (ts['Gardening']/ts.sum(axis=1)).round(2)
print("Temporal framing: gardening share of introductions rose %s" % fr.to_dict())
