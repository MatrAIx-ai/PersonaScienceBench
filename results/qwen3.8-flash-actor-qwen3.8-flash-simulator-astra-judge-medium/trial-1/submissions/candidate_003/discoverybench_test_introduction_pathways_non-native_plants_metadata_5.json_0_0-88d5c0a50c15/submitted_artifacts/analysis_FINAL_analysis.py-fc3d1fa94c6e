"""
FINAL ANALYSIS  —  "In what scenario did urban land use promote a specific type of plant invasion?"

Design (agreed with researcher):
  SPINE  : plot-level compositional binomial  n.gard | n.gard + n.unint  (holds invaded richness constant)
  COMPANION: plot-level NB2 on n.total, n.gard, n.unint (n.agfo descriptive only)
  EXPOSURE: honest AICc sweep over 9 urban year x buffer terms + 6 delta-urban terms
  ROBUSTNESS: full vs excl-Urban-habitat; stratified permutation; quasi-binomial; bootstrap;
              collinearity; Moran's I; species-level pathway contrasts + phylogenetic check
Nothing here is conditional on a plot x species matrix, because none exists in the data.
"""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from statsmodels.discrete.count_model import NegativeBinomialP
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, load_species, URBAN_TERMS, design
pd.set_option("display.width", 260); pd.set_option("display.max_columns", 40)

n = add_deltas(load_plot()); sp = load_species()
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
def Y(d): return np.column_stack([d["n.gard"].values.astype(float), d["n.unint"].values.astype(float)])
def T(d): return (d["n.gard"]+d["n.unint"]).values > 0
OUT = []

print("="*100); print("A. COMPOSITIONAL SPINE — all 15 candidate exposures, full sample, covariate set A")
print("="*100)
rec=[]
for UT in URBAN_TERMS:
    cov = COV5+[f"cropland.2009.{UT.split('.')[-1]}"]; t=T(n)
    X = design(n, UT, cov); m = sm.GLM(Y(n)[t], X.values[t], family=Binomial()).fit()
    phi = m.pearson_chi2/m.df_resid; b=m.params[1]; se=m.bse[1]*np.sqrt(max(phi,1))
    k=X.shape[1]; a=-2*m.llf+2*k+2*k*(k+1)/(t.sum()-k-1)
    rec.append(dict(exposure=UT, sd=n[UT].std(), beta=b, quasi_se=se, OR_per_SD=np.exp(b*n[UT].std()),
                    p=2*st.t.sf(abs(b/se), m.df_resid), AICc=a))
R=pd.DataFrame(rec); R["dAICc"]=R.AICc-R.AICc.min(); print(R.sort_values("AICc").round(4).to_string(index=False))

print("\n"+"="*100); print("B. HEADLINE: the winning exposure, both samples, all adjustments")
print("="*100)
UT="delta_urban_1993_2009.500m"
for lab, sub, cov in [
    ("full, urban only",              n,                          []),
    ("full, + geography/climate/cropland (set A)", n,             COV5+["cropland.2009.500m"]),
    ("full, + habitat strata",        n,                          COV5+["cropland.2009.500m","habitat"]),
    ("EXCL Urban habitat, set A",     n[n.habitat!="Urban"],      COV5+["cropland.2009.500m"]),
    ("EXCL Urban habitat, habitat strata", n[n.habitat!="Urban"], COV5+["cropland.2009.500m","habitat"])]:
    t=T(sub); X=design(sub,UT,cov); m=sm.GLM(Y(sub)[t],X.values[t],family=Binomial()).fit()
    phi=m.pearson_chi2/m.df_resid; b=m.params[1]; se=m.bse[1]*np.sqrt(max(phi,1))
    p=2*st.t.sf(abs(b/se), m.df_resid)
    print(f"  {lab:42s} n={int(t.sum()):3d} beta={b:+.3f} quasi_se={se:.3f} p={p:.4f} "
          f"OR/10pp={np.exp(0.1*b):.3f} [{np.exp(0.1*(b-1.96*se)):.3f},{np.exp(0.1*(b+1.96*se)):.3f}]")
    OUT.append(dict(layer="composition", spec=lab, exposure=UT, beta=b, se=se, p=p,
                    OR10=np.exp(0.1*b), lo=np.exp(0.1*(b-1.96*se)), hi=np.exp(0.1*(b+1.96*se))))
print("  (same, for the LEVEL term urban.2009.500m, which does NOT survive the Urban-habitat drop)")
for lab, sub in [("full, set A", n), ("EXCL Urban habitat, set A", n[n.habitat!="Urban"])]:
    t=T(sub); cov=COV5+["cropland.2009.500m"]; m=sm.GLM(Y(sub)[t],design(sub,"urban.2009.500m",cov).values[t],family=Binomial()).fit()
    phi=m.pearson_chi2/m.df_resid; b=m.params[1]; se=m.bse[1]*np.sqrt(max(phi,1))
    print(f"  {lab:42s} n={int(t.sum()):3d} beta={b:+.3f} quasi_se={se:.3f} "
          f"p={2*st.t.sf(abs(b/se),m.df_resid):.4f} OR/10pp={np.exp(0.1*b):.3f}")

print("\n"+"="*100); print("C. COMPANION RICHNESS MODELS (NB2; Poisson rejected, dispersion 2.13, DJ z=19.7)")
print("="*100)
for pw in ["n.total","n.unint","n.gard","n.agfo"]:
    for lab, d in [("full", n), ("excl Urban habitat", n[n.habitat!="Urban"])]:
        m=NegativeBinomialP(d[pw].values.astype(float), design(d,UT,COV5).values, p=2).fit(method="newton",maxiter=400,disp=False)
        b,se=m.params[1],m.bse[1]
        print(f"  NB2 {pw:8s} [{lab:18s}] beta={b:+.3f} se={se:.3f} p={m.pvalues[1]:.4f} "
              f"IRR/10pp={np.exp(0.1*b):.3f} [{np.exp(0.1*(b-1.96*se)):.3f},{np.exp(0.1*(b+1.96*se)):.3f}]")
        OUT.append(dict(layer=f"NB2 {pw} {lab}", exposure=UT, beta=b, se=se, p=m.pvalues[1],
                        OR10=np.exp(0.1*b), lo=np.exp(0.1*(b-1.96*se)), hi=np.exp(0.1*(b+1.96*se))))

print("\n"+"="*100); print("D. RAW MAGNITUDES (observed, no model) — for the hypothesis sentence")
print("="*100)
b2 = pd.cut(n[UT], [-1,-.001,.001,.05,1.0], labels=["shrunk","stable","0-5pp gain",">5pp gain"])
g = n.groupby(b2, observed=True).agg(plots=("habitat","size"), gard=("n.gard","sum"),
        unint=("n.unint","sum"), agfo=("n.agfo","sum"))
g["records_per_plot"]=(g.gard+g.unint+g.agfo)/g.plots
g["unint_share_%"]=100*g.unint/(g.gard+g.unint)
g["gard_share_%"]=100*g.gard/(g.gard+g.unint)
print(g.round(3).to_string())

print("\n"+"="*100); print("E. SPECIES-LEVEL CORROBORATION (cannot be conditioned on plots)")
print("="*100)
spp = sp.copy(); gu = spp[spp["intro.pathway"].isin(["Gardening","Unintentional"])].reset_index(drop=True)
lab = gu["intro.pathway"].values; rng=np.random.default_rng(11)
for var in ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range","invaded.niche.breadth","native.niche.breadth","height"]:
    x=gu[var].values.astype(float); obs=x[lab=="Unintentional"].mean()-x[lab=="Gardening"].mean()
    null=np.array([ (lambda p: x[p=="Unintentional"].mean()-x[p=="Gardening"].mean())(rng.permutation(lab)) for _ in range(20000)])
    print(f"  {var:24s} Unint-Gard = {obs:+.3f}  perm p = {2*min((null<=obs).mean(),(null>=obs).mean()):.4f}")
for nm_, flag in [("woody Shrub/tree","Shrub/tree"),("Annual forb","Annual fg")]:
    bt=(gu["growth.form"]==flag).astype(int).values
    ct=np.array([[bt[lab=="Unintentional"].sum(),(lab=="Unintentional").sum()-bt[lab=="Unintentional"].sum()],
                 [bt[lab=="Gardening"].sum(),(lab=="Gardening").sum()-bt[lab=="Gardening"].sum()]])
    print(f"  {nm_:24s} Unint {ct[0,0]}/{ct[0].sum()} vs Gard {ct[1,0]}/{ct[1].sum()}  Fisher p={st.fisher_exact(ct)[1]:.2e} OR={st.fisher_exact(ct)[0]:.2f}")
print("  median height: Unintentional %.2f m vs Gardening %.2f m" % (
    gu.loc[lab=="Unintentional","height"].median(), gu.loc[lab=="Gardening","height"].median()))
pd.DataFrame(OUT).to_csv("analysis/FINAL_results_table.csv", index=False)
print("\nsaved analysis/FINAL_results_table.csv")
