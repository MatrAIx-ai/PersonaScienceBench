"""Shared loading / design-matrix helpers for the urban x pathway analysis."""
import numpy as np, pandas as pd

def load_plot():
    n = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
    n["log_road"] = np.log10(n["distance.road"].clip(lower=1))
    n["log_stream"] = np.log10(n["distance.stream"].clip(lower=1))
    return n

def load_species():
    s = pd.read_csv("data/invasion_success_pathways.csv")
    s["duplicated"] = s["duplicated"].astype(bool)
    return s

URBAN_TERMS = {}
for yr in (1956, 1993, 2009):
    for b in ("50m", "500m", "1000m"):
        URBAN_TERMS[f"urban.{yr}.{b}"] = f"urban {yr} @{b}"
for end, start in (("2009", "1956"), ("2009", "1993")):
    for b in ("50m", "500m", "1000m"):
        URBAN_TERMS[f"delta_urban_{start}_{end}.{b}"] = f"delta urban {start}->{end} @{b}"

def add_deltas(n):
    for end, start in (("2009", "1956"), ("2009", "1993")):
        for b in ("50m", "500m", "1000m"):
            n[f"delta_urban_{start}_{end}.{b}"] = n[f"urban.{end}.{b}"] - n[f"urban.{start}.{b}"]
    return n

def covariates(n, buffer, setname="A"):
    """Pre-specified covariate sets (independent of the urban term chosen)."""
    base = {
        "A": ["elevation", "annual.temperature", "annual.rainfall", "log_road", "log_stream",
              f"cropland.2009.{buffer}"],
        "B": ["elevation", "annual.rainfall", "log_road"],           # parsimonious, low-VIF
        "C": [],                                                     # urban only
        "D": ["elevation", "annual.temperature", "annual.rainfall", "log_road", "log_stream",
              f"cropland.2009.{buffer}", "habitat"],                 # + habitat strata
    }[setname]
    return base

def design(n, urban_term, cov_terms, intercept=True):
    import patsy
    cols = [urban_term] + cov_terms
    parts = ["1"] if intercept else []
    frames = []
    X = pd.DataFrame(index=n.index)
    X["Intercept"] = 1.0 if intercept else np.nan
    for c in cols:
        if c == "habitat":
            d = pd.get_dummies(n["habitat"], prefix="hab", drop_first=True).astype(float)
            for k in d.columns: X[k] = d[k].values
        else:
            X[c] = n[c].astype(float).values
    if not intercept: X = X.drop(columns=["Intercept"])
    return X
