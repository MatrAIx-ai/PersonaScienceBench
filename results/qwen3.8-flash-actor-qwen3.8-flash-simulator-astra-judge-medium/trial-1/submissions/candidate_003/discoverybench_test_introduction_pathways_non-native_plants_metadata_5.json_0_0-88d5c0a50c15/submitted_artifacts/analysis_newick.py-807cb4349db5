"""Minimal recursive-descent Newick parser (no Biopython / ete3 available here).

Handles internal-node labels (Open Tree of Life style: 'mrcaott...', 'Pentapetalae',
and a stray file-name label), branch lengths, and polytomies.
"""
import re

class Node:
    __slots__ = ("children", "name", "length", "parent")
    def __init__(s):
        s.children = []; s.name = None; s.length = None; s.parent = None

class _P:
    def __init__(self, s):
        self.s = s.strip(); self.i = 0
    def peek(self):
        return self.s[self.i] if self.i < len(self.s) else ""
    def node(self, parent=None):
        n = Node(); n.parent = parent
        if self.peek() == "(":
            self.i += 1
            while True:
                n.children.append(self.node(n))
                if self.peek() == ",":
                    self.i += 1; continue
                break
            assert self.peek() == ")", f"expected ')' at {self.i}"
            self.i += 1
        # label
        m = re.match(r"[^(),:;\s]+", self.s[self.i:])
        if m:
            n.name = m.group(0); self.i += m.end()
        if self.peek() == ":":
            self.i += 1
            m = re.match(r"[+-]?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?", self.s[self.i:])
            assert m, f"bad branch length at {self.i}: {self.s[self.i:self.i+20]}"
            n.length = float(m.group(0)); self.i += m.end()
        return n

def parse(newick):
    p = _P(newick)
    root = p.node()
    rest = p.s[p.i:].strip()
    assert rest in ("", ";"), f"trailing characters: {rest[:40]!r}"
    return root

def walk(n):
    yield n
    for c in n.children:
        yield from walk(c)

def tips(n):
    return [x for x in walk(n) if not x.children]

def root_to_tip(n, acc=0.0, out=None):
    if out is None: out = []
    a = acc + (n.length or 0.0)
    if not n.children: out.append((n.name, a))
    for c in n.children: root_to_tip(c, a, out)
    return out

def _anc(root, name):
    tm = {t.name: t for t in tips(root)}
    n, chain = tm[name], []
    while n is not None:
        chain.append(n); n = n.parent
    return chain

def cophenetic(root, a, b):
    ca, cb = _anc(root, a), _anc(root, b)
    sa = set(map(id, ca))
    lca = next(x for x in cb if id(x) in sa)
    d = 0.0
    for chain in (ca, cb):
        for nd in chain:
            if nd is lca: break
            d += nd.length or 0.0
    return d

def clade(root, name):
    """all tip labels descending from the MRCA of tip `name` (excluding singletons)."""
    n = _anc(root, name)[-2] if len(_anc(root, name)) > 1 else None
    return {t.name for t in tips(n)} if n else set()
