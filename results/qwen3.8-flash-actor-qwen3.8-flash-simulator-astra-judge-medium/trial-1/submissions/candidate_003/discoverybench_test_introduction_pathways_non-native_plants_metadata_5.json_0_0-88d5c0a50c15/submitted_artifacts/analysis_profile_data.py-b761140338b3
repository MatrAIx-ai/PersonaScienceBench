"""
Exploratory profiling (inventory / answerability / data-quality audit only).
No models are fitted in this script.

Delimiters differ per file:
  - invaded_niche_pathways.csv          : TAB, quoted
  - temporal_trends_contingency_table.csv: TAB, quoted
  - invasion_success_pathways.csv        : COMMA
"""
import re, json
import pandas as pd
import numpy as np

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 60)
D = "data/"

def hdr(t):
    print("\n" + "=" * 78)
    print(t)
    print("=" * 78)

# ---------------------------------------------------------------- load
niche = pd.read_csv(D + "invaded_niche_pathways.csv", sep="\t")
succ  = pd.read_csv(D + "invasion_success_pathways.csv")
cont  = pd.read_csv(D + "temporal_trends_contingency_table.csv", sep="\t")
tree_txt = open(D + "phylogenetic_tree.txt").read().strip()

hdr("1. SHAPES / DTYPES")
for name, df in [("invaded_niche_pathways", niche),
                 ("invasion_success_pathways", succ),
                 ("temporal_trends_contingency", cont)]:
    print(f"\n--- {name}: {df.shape[0]} rows x {df.shape[1]} cols")
    print(df.dtypes.to_string())

hdr("2. NA COUNTS (all columns)")
for name, df in [("invaded_niche_pathways", niche),
                 ("invasion_success_pathways", succ),
                 ("temporal_trends_contingency", cont)]:
    na = df.isna().sum()
    print(f"\n--- {name}: total NA = {int(na.sum())}")
    print(na[na > 0].to_string() if na.sum() else "  (no NAs)")

hdr("3. invaded_niche_pathways: is there a species identifier?")
print("columns:", list(niche.columns))
print("any column containing 'spec'/'taxon'/'name'/'sp.':",
      [c for c in niche.columns if re.search("spec|taxon|name|sps", c, re.I)])
print("row index unique? ", niche.index.is_unique, " n rows:", len(niche))
print("habitat n unique:", niche["habitat"].nunique())
print(niche["habitat"].value_counts().to_string())
print("\nn.total describe:"); print(niche["n.total"].describe().to_string())
print("n.total value counts:"); print(niche["n.total"].value_counts().sort_index().to_string())
print("\nrow identity check: are any two rows fully identical?", niche.duplicated().any(),
      " ->", int(niche.duplicated().sum()))
print("duplicate (habitat,elev,lon,lat) combos:",
      int(niche.duplicated(subset=["habitat","elevation","longitude","latitude"]).sum()))

hdr("4. niche pathway-count bookkeeping: n.gard+n.unint+n.agfo == n.total ?")
s3 = niche[["n.gard","n.unint","n.agfo"]].sum(axis=1)
eq = (s3 == niche["n.total"])
print("rows where sum of 3 == n.total:", int(eq.sum()), "/", len(niche))
print("rows where NOT equal:", int((~eq).sum()))
if (~eq).any():
    print(niche.loc[~eq, ["n.gard","n.unint","n.agfo","n.total","habitat"]].head(20).to_string())
print("\ncolumn sums: gard=%d unint=%d agfo=%d total=%d  (3-pathway sum=%d)"
      % (niche["n.gard"].sum(), niche["n.unint"].sum(), niche["n.agfo"].sum(),
         niche["n.total"].sum(), s3.sum()))
print("max per column: gard=%d unint=%d agfo=%d total=%d"
      % (niche["n.gard"].max(), niche["n.unint"].max(), niche["n.agfo"].max(), niche["n.total"].max()))

hdr("5. urban / cropland / change-category columns")
land = [c for c in niche.columns if re.search(r"^(urban|cropland)\.", c)]
chg  = [c for c in niche.columns if re.search(r"(progressive|regressive|no\.changes)", c)]
print("land-cover columns (%d):" % len(land), land)
print("change columns (%d):" % len(chg), chg)
print("\ndescribe land cover (%):"); print(niche[land].describe().T.round(3).to_string())
print("\nchange columns: unique values / dtype")
for c in chg:
    u = niche[c].unique()
    print(f"  {c}: dtype={niche[c].dtype}, n_unique={len(u)}, min={np.nanmin(niche[c])}, max={np.nanmax(niche[c])}, sum={niche[c].sum():.3f}")
# do the 3 change categories partition rows (binary indicators)?
for period, buf in [("1956.2009","50m"), ("1993.2009","50m")]:
    trio = [f"progressive.{period}.{buf}", f"regressive.{period}.{buf}", f"no.changes.{period}.{buf}"]
    v = niche[trio]
    is_bin = v.isin([0,1]).all().all()
    rowsum = v.sum(axis=1)
    print(f"{period} {buf}: all-binary={is_bin}, row-sum value counts: {rowsum.value_counts().sort_index().to_dict()}")

hdr("6. collinearity across year x buffer within urban (Pearson r)")
urb = [c for c in niche.columns if c.startswith("urban.")]
print(niche[urb].corr().round(3).to_string())
print("\ncropland corr:")
cro = [c for c in niche.columns if c.startswith("cropland.")]
print(niche[cro].corr().round(3).to_string())
print("\ncorr of urban.2009.* with covariates (elev, dist, climate):")
cov = ["elevation","distance.stream","distance.road","annual.temperature","annual.rainfall","annual.radiation","longitude","latitude"]
print(niche[urb + cov].corr().loc[urb, cov].round(3).to_string())

hdr("7. invasion_success_pathways: species-level audit")
print("rows:", len(succ), " unique Scientific_name:", succ["Scientific_name"].nunique(),
      " unique phylo.tip.label:", succ["phylo.tip.label"].nunique())
print("fully identical rows (all 19 cols):", int(succ.drop_duplicates().pipe(lambda d: len(succ)-len(d))))
print("rows whose Scientific_name appears >1x:", int(succ["Scientific_name"].duplicated(keep=False).sum()))
print("\nduplicated flag:"); print(succ["duplicated"].value_counts(dropna=False).to_string())
print("n species with duplicated==TRUE:", int((succ["duplicated"]=="TRUE").sum())
      if succ["duplicated"].dtype==object else int(succ["duplicated"].sum()))
print("dup flag dtype:", succ["duplicated"].dtype, " unique:", succ["duplicated"].unique())
print("\ngenus.relative / species.relative non-NA:")
for c in ["genus.relative","species.relative"]:
    print(f"  {c}: non-NA={int(succ[c].notna().sum())}, NA={int(succ[c].isna().sum())} ({100*succ[c].isna().mean():.1f}%), dtype={succ[c].dtype}")
print("\ncategorical columns:")
for c in ["intro.pathway","growth.form","dispersal","vegetative","family"]:
    print(f"\n  {c} (n_unique={succ[c].nunique()}, NA={int(succ[c].isna().sum())}):")
    print("   ", succ[c].value_counts(dropna=False).to_dict())
print("\nnumeric outcomes describe:")
num = ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range",
       "invaded.niche.breadth","native.niche.breadth","mrt","height"]
print(succ[num].describe().T.round(3).to_string())
print("\nNA in outcomes:", {c:int(succ[c].isna().sum()) for c in num})

hdr("8. phylogenetic tree: tips vs species table")
tipnames = re.findall(r"[A-Za-z_][A-Za-z0-9_.\-]*|'[^']+'", tree_txt.split(";")[0])
# robust: split on separators
body = tree_txt.rstrip(";")
tips = set(re.split(r"[(),:0-9.eE\-+]+", body))
tips = {t for t in tips if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.\-]*", t)}
print("n tips (unique labels):", len(tips))
print("example tips:", sorted(tips)[:5])
sp_labels = set(succ["phylo.tip.label"].dropna())
sci = set(succ["Scientific_name"].dropna())
sci_binom = {s.split(" L.")[0] for s in sci}
genus_binom = {f"{g}_{s}" for g, s in zip(succ.genus, succ.species)}
print("\nphylo.tip.label in tree:", len(sp_labels & tips), "/", len(sp_labels))
print("phylo.tip.label NOT in tree:", sorted(sp_labels - tips)[:20])
print("tree tips NOT in phylo.tip.label:", sorted(tips - sp_labels)[:20])
# does phylo.tip.label equal genus_species?
ok = (succ.genus.astype(str) + "_" + succ.species.astype(str)) == succ["phylo.tip.label"].astype(str)
print("\nphylo.tip.label == genus+'_'+species:", int(ok.sum()), "/", len(succ))
# does it equal Scientific_name with spaces->underscore, dropping author?
import re as _re
sci_norm = succ["Scientific_name"].astype(str).str.replace(r"\s+.*$", "", regex=True)
# build 2-word binomial from Scientific_name
sci_two = succ["Scientific_name"].astype(str).str.extract(r"^([A-Z][a-z]+ [a-z][a-z]+)")[0]
cand = sci_two.str.replace(" ", "_")
print("phylo.tip.label == first-two-tokens(Scientific_name):",
      int((cand == succ["phylo.tip.label"]).sum()), "/", len(succ))
print("mismatches:")
mm = succ.loc[cand != succ["phylo.tip.label"], ["Scientific_name","phylo.tip.label"]]
print(mm.head(20).to_string() if len(mm) else "  none")

hdr("9. temporal contingency table")
print(cont.to_string(index=False))
print("\ntotal n =", cont.n.sum())
piv = cont.pivot(index="introduction.period", columns="pathway", values="n")
print("\n", piv.to_string())
print("\nrow totals:", piv.sum(axis=1).to_dict())
print("col totals:", piv.sum(axis=0).to_dict())
print("col share within period (%):")
print((piv.div(piv.sum(axis=1), axis=0) * 100).round(1).to_string())

hdr("10. can species table and plot table be linked at all?")
print("success table unit: one row per", "species" if succ["Scientific_name"].is_unique else "NOT unique species")
print("niche table unit: one row per", "plot (habitat + coords) ->",
      f"{len(niche)} rows, {niche.habitat.nunique()} habitats, lon/lat unique={niche[['longitude','latitude']].drop_duplicates().shape[0]}")
print("shared columns between the two tables:", sorted(set(succ.columns) & set(niche.columns)))
print("pathway label vocabularies:")
print("  success intro.pathway:", sorted(succ["intro.pathway"].dropna().unique()))
print("  niche pathway cols   :", [c for c in niche.columns if c.startswith('n.')])
print("\nsuccess-table pathway counts (for comparison with niche-table sums):")
print(succ["intro.pathway"].value_counts(dropna=False).to_string())
print("niche-table pathway sums:", {c: int(niche[c].sum()) for c in ["n.gard","n.unint","n.agfo","n.total"]})
