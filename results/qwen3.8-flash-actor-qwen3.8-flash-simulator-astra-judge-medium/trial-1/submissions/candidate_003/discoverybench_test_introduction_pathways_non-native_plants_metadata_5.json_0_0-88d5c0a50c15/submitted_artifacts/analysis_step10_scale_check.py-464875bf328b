"""STEP 10 - put every candidate on a common per-SD scale (so AICc ranking is not a scaling
artefact), single-df crop interaction for the level term, and mrt-adjusted species contrasts."""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, load_species, URBAN_TERMS, design
pd.set_option("display.width", 250)
n = add_deltas(load_plot())
Y = np.column_stack([n["n.gard"].values.astype(float), n["n.unint"].values.astype(float)])
t = ((n["n.gard"]+n["n.unint"]) > 0).values
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]

print("=== 10.1 every candidate expressed per SD of itself (same units -> comparable effects) ===")
rows=[]
for UT in URBAN_TERMS:
    cov = COV5+[f"cropland.2009.{UT.split('.')[-1]}"]
    X = design(n, UT, cov); nm=list(X.columns)
    m = sm.GLM(Y[t], X.values[t], family=Binomial()).fit()
    i = nm.index(UT); b, se = m.params[i], m.bse[i]; sd = n[UT].std()
    a = -2*m.llf+2*X.shape[1]+2*X.shape[1]*(X.shape[1]+1)/(t.sum()-X.shape[1]-1)
    rows.append(dict(term=UT, sd=sd, beta=b, OR_per_SD=np.exp(b*sd),
                     lo=np.exp((b-1.96*se)*sd), hi=np.exp((b+1.96*se)*sd), p=m.pvalues[i], AICc=a))
S = pd.DataFrame(rows).sort_values("AICc"); S["dAICc"]=S.AICc-S.AICc.min()
print(S.round(4).to_string(index=False))
S.to_csv("analysis/step10_per_sd.csv", index=False)

print("\n=== 10.2 single-df Croplands interaction for the LEVEL term too ===")
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    n["isc"] = (n.habitat=="Croplands").astype(float)
    base = design(n, UT, COV5+["cropland.2009.500m"])
    full = pd.concat([base, (n.isc*n[UT]).rename("cxu")], axis=1)
    m0 = sm.GLM(Y[t], base.values[t], family=Binomial()).fit()
    m1 = sm.GLM(Y[t], full.values[t], family=Binomial()).fit()
    lr = 2*(m1.llf-m0.llf); phi=m1.pearson_chi2/m1.df_resid; nmf=list(full.columns)
    print(f"  {UT:28s} cropXurban LRT={lr:.2f}/1df p={st.chi2.sf(lr,1):.3f}; "
          f"non-crop slope={m1.params[nmf.index(UT)]:+.3f} "
          f"(quasi p={2*st.t.sf(abs(m1.params[nmf.index(UT)])/(m1.bse[nmf.index(UT)]*np.sqrt(max(phi,1))), m1.df_resid):.4f}), "
          f"cropland slope={m1.params[nmf.index(UT)]+m1.params[nmf.index('cxu')]:+.3f}")

print("\n=== 10.3 species-level contrasts adjusted for mean residence time ===")
s = load_species(); s["dnb"]=s["invaded.niche.breadth"]-s["native.niche.breadth"]
gu = s[s["intro.pathway"].isin(["Gardening","Unintentional"])].reset_index(drop=True)
X = np.column_stack([np.ones(len(gu)), (gu["intro.pathway"]=="Unintentional").astype(float),
                     np.log(gu["mrt"])])
for var in ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range",
            "invaded.niche.breadth","native.niche.breadth"]:
    y = np.log1p(gu[var].values.astype(float))
    b = np.linalg.lstsq(X, y, rcond=None)[0]; r = y-X@b
    se = np.sqrt(np.diag(np.linalg.inv(X.T@X))*(r**2).sum()/(len(y)-3))
    print(f"  {var:24s} beta(Unint|log mrt) = {b[1]:+.3f} (se {se[1]:.3f}, p={2*st.t.sf(abs(b[1]/se[1]),len(y)-3):.4f})")

print("\n=== 10.4 growth-form / dispersal profile of each pathway (species table, counts) ===")
print(pd.crosstab(s["intro.pathway"], s["growth.form"], margins=True).to_string())
print(pd.crosstab(s["intro.pathway"], s["dispersal"], margins=True).to_string())
print("\nmedian height by pathway:"); print(s.groupby("intro.pathway")["height"].median().to_string())
