"""STEP 11 - final checks: unintentional-only model without Urban habitat, correlation of the
exposure with the collinear covariates, and a phylogenetic permutation (phylo-ANOVA) for the
key species-level contrast."""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.discrete.count_model import NegativeBinomialP
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, load_species, design
from newick import parse, tips
pd.set_option("display.width", 250)
n = add_deltas(load_plot()); s = load_species()
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
UT = "delta_urban_1993_2009.500m"

print("=== 11.1 pathway-specific NB2 with the exposure, without Urban-habitat plots ===")
for pw in ["n.total","n.unint","n.gard","n.agfo"]:
    for lab, d in [("full", n), ("excl Urban habitat", n[n.habitat!="Urban"])]:
        X = design(d, UT, COV5).values; y = d[pw].values.astype(float)
        m = NegativeBinomialP(y, X, p=2).fit(method="newton", maxiter=400, disp=False)
        b, se = m.params[1], m.bse[1]
        print(f"  {pw:8s} [{lab:18s}] beta={b:+.3f} se={se:.3f} p={m.pvalues[1]:.4f} "
              f"IRR/10pp={np.exp(0.1*b):.3f} [{np.exp(0.1*(b-1.96*se)):.3f},{np.exp(0.1*(b+1.96*se)):.3f}]")

print("\n=== 11.2 is the exposure just a proxy for the collinear covariates? ===")
for c in COV5+["cropland.2009.500m","urban.2009.500m"]:
    print(f"  r({UT}, {c:20s}) = {np.corrcoef(n[UT], n[c])[0,1]:+.3f}")

print("\n=== 11.3 phylo-ANOVA (phylodynamic permutation) for species-level contrasts ===")
root = parse(open("data/phylogenetic_tree.txt").read()); T = {t.name:t for t in tips(root)}
def path_ids(name):
    out=[]; node=T[name]
    while node is not None: out.append(id(node)); node=node.parent
    return out[::-1]
P = {k: path_ids(k) for k in T}
def tipset(node):
    out=[]
    stack=[node]
    while stack:
        x=stack.pop()
        if not x.children: out.append(x.name)
        else: stack.extend(x.children)
    return out
node_by_id={}
def reg(x):
    node_by_id[id(x)]=x
    for c in x.children: reg(c)
reg(root)
# independent clades: walk down, whenever a split keeps >=5 tips take the child clade
def indep_clades(node, minsize=5):
    ts = tipset(node)
    if len(ts) < minsize: return [ts]
    kids = [c for c in node.children if len(tipset(c)) >= minsize]
    if len(kids) >= 2:
        out = []
        for c in kids: out += indep_clades(c, minsize)
        return out
    return [ts]
clades = indep_clades(root, 5)
sizes = sorted(len(c) for c in clades)
print(f"  {len(clades)} phylogenetically independent clades (sizes {sizes[:3]}..{sizes[-3:]}, "
      f"total {sum(sizes)} tips)")
lab = s.sort_values("phylo.tip.label")["intro.pathway"].values
gu_mask = np.isin(lab, ["Gardening","Unintentional"])
vals = {}
for var in ["number.of.invaded.plots","invaded.niche.breadth","native.niche.breadth","height","habitat.range"]:
    vals[var] = np.log1p(s.sort_values("phylo.tip.label")[var].values.astype(float))
order = np.argsort(s["phylo.tip.label"].values)
lab_sorted = s["intro.pathway"].values[order]
rng = np.random.default_rng(5)
tipindex = {t: i for i, t in enumerate(sorted(T))}
for var in vals:
    y = vals[var]
    l = lab_sorted
    m = np.isin(l, ["Gardening","Unintentional"])
    obs = y[m & (l=="Unintentional")].mean() - y[m & (l=="Gardening")].mean()
    null = []
    for _ in range(2000):
        newl = l.copy()
        for cl in clades:
            idx = np.array([tipindex[t] for t in cl])
            idx = idx[np.isin(l[idx], ["Gardening","Unintentional"])]
            if len(idx) < 2: continue
            cur = l[idx].copy(); rng.shuffle(cur); newl[idx] = cur
        mm = np.isin(newl, ["Gardening","Unintentional"])
        null.append(y[mm & (newl=="Unintentional")].mean() - y[mm & (newl=="Gardening")].mean())
    null=np.array(null)
    p = 2*min((null<=obs).mean(),(null>=obs).mean())
    print(f"  {var:24s} observed diff(log1p) = {obs:+.3f}; within-clade permutation p = {p:.4f} "
          f"(null sd {null.std():.3f})  -> {'SURVIVES phylogeny' if p<0.05 else 'not robust to phylogeny'}")
