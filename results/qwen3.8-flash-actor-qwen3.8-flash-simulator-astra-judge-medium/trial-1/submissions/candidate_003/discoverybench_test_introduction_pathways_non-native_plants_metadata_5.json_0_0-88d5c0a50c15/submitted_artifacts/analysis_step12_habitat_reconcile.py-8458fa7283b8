"""STEP 12 - reconcile the contradictory habitat-specific slopes (joint interaction vs separate fits)."""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250)
n = add_deltas(load_plot())
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
GOOD = ["Coastal","Croplands","Riparian","Urban","Wetlands"]
rows=[]
print("slope on log-odds a record is Gardening (per +1.0 urban fraction), by habitat")
print(f"{'habitat':12s} {'plots*':>6s} {'gard':>5s} {'unint':>6s} | {'marginal(no cov)':>16s} {'+cov shared?':>12s} {'own-data cov':>13s}")
for h in GOOD+["Broad-leaved forests","Coniferous forests","Meadows","Scrublands","Rock outcrops"]:
    d = n[n.habitat==h]; t = (d["n.gard"]+d["n.unint"]).values>0
    Y = np.column_stack([d["n.gard"].values[t].astype(float), d["n.unint"].values[t].astype(float)])
    for UT in ["urban.2009.500m"]:
        try:
            m0 = sm.GLM(Y, design(d, UT, []).values[t], family=Binomial()).fit()
            s0 = f"{m0.params[1]:+.2f}({m0.pvalues[1]:.3f})"
        except Exception: s0 = "fail"
        # separate fit, covariates estimated on that habitat only (only if enough plots)
        if t.sum() >= 15:
            try:
                m2 = sm.GLM(Y, design(d, UT, ["elevation","annual.temperature","log_road"]).values[t],
                            family=Binomial()).fit()
                s2 = f"{m2.params[1]:+.2f}({m2.pvalues[1]:.3f})"
            except Exception: s2 = "fail"
        else: s2 = "n/a (n<15)"
        print(f"{h:12s} {int(t.sum()):6d} {int(d['n.gard'].sum()):5d} {int(d['n.unint'].sum()):6d} | "
              f"{s0:>16s} {'':12s} {s2:>13s}")
print("*invaded plots.  Marginal = urban only; own-data cov = elev+temp+road within the habitat.\n")

print("=== pooled joint interaction with 4 extra df (step 7 style) vs single df (step 9 style) ===")
t_all = (n["n.gard"]+n["n.unint"]).values>0
Y_all = np.column_stack([n["n.gard"].values.astype(float), n["n.unint"].values.astype(float)])
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    for lab, sub in [("all habitats", n), ("5 informative habitats", n[n.habitat.isin(GOOD)])]:
        t = (sub["n.gard"]+sub["n.unint"]).values>0
        Y = np.column_stack([sub["n.gard"].values.astype(float), sub["n.unint"].values.astype(float)])
        hab = sorted(sub.habitat.unique()); ref = hab[0]
        base = pd.concat([design(sub, UT, COV5+["cropland.2009.500m"]),
                          pd.DataFrame({f"h[{x}]": (sub.habitat==x).astype(float) for x in hab[1:]}, index=sub.index)], axis=1)
        inter = pd.DataFrame({f"x[{x}]": (sub.habitat==x).astype(float).values*sub[UT].values for x in hab[1:]}, index=sub.index)
        m0 = sm.GLM(Y[t], base.values[t], family=Binomial()).fit(maxiter=400)
        m1 = sm.GLM(Y[t], pd.concat([base,inter],axis=1).values[t], family=Binomial()).fit(maxiter=400)
        lr = 2*(m1.llf-m0.llf); df = inter.shape[1]
        # is the design rank-deficient / are slopes implausible?
        big = max(abs(m1.params[base.shape[1]+j]) for j in range(df)) if df else 0
        print(f"  {UT:26s} [{lab:22s}] LRT={lr:5.2f}/{df}df p={st.chi2.sf(lr,df):.4f}  "
              f"max |interaction slope| = {big:.1f} {'<- implausible, unstable' if big>10 else ''}")

print("\n=== simplest honest question: does the sign hold habitat by habitat (own-data, marginal)? ===")
signs=[]
for h in GOOD:
    d = n[n.habitat==h]; t=(d["n.gard"]+d["n.unint"]).values>0
    Y = np.column_stack([d["n.gard"].values[t].astype(float), d["n.unint"].values[t].astype(float)])
    for UT in ["delta_urban_1993_2009.500m"]:
        m = sm.GLM(Y, design(d, UT, []).values[t], family=Binomial()).fit()
        signs.append((h, int(t.sum()), round(m.params[1],2), round(m.pvalues[1],3)))
print("  ", signs)
