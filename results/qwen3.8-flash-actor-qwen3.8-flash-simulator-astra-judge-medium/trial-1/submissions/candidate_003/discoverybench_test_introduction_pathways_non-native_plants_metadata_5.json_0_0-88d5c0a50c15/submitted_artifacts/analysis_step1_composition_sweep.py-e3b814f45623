"""STEP 1 - the spine: does urban cover shift the pathway COMPOSITION within a plot?
Response: binomial(n.gard | n.gard + n.unint) -> holds invaded richness constant.
Honest AICc sweep over all 9 year x buffer urban terms + 6 delta-urban candidates,
under pre-specified covariate sets. No term is pre-picked.

Zero-trial plots: 442/632 plots have n.gard + n.unint == 0. A binomial term with 0
trials contributes EXACTLY 0 to the log-likelihood, so dropping them is an identity,
not an approximation - PROVED below by maximising the all-632-plot likelihood directly.
"""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from scipy.optimize import minimize
from statsmodels.genmod.families import Binomial
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, URBAN_TERMS, design

pd.set_option("display.width", 250); pd.set_option("display.max_columns", 40)
n = add_deltas(load_plot())
succ = n["n.gard"].values.astype(float); fail = n["n.unint"].values.astype(float)
trials = succ + fail; keep = trials > 0

def all_nll(beta, X):
    eta = X @ beta; mu = 1/(1+np.exp(-eta))
    ll = succ*np.clip(eta, -700, 700) + (succ+fail)*np.log1p(np.exp(-np.abs(eta))) \
         - np.where(fail > 0, fail*np.log1p(np.exp(np.abs(eta)*np.sign(eta))), 0.0)
    # exact binomial loglik per row, zero-trial rows contribute 0 by construction
    eta_s = np.clip(eta, -700, 700)
    ll = succ*eta_s - trials*np.logaddexp(0, eta_s)
    return -ll.sum()

Xall = design(n, "urban.2009.500m", [])
r = minimize(all_nll, np.zeros(Xall.shape[1]), args=(Xall.values,), method="BFGS")
sub = sm.GLM(np.column_stack([succ[keep], fail[keep]]), design(n, "urban.2009.500m", []).values[keep],
             family=Binomial()).fit()
print(f"ZERO-TRIAL EQUIVALENCE CHECK  logLik(all 632 plots, zero-trial rows included) = {-r.fun:.6f}")
print(f"                              logLik({int(keep.sum())} plots with trials>0)      = {sub.llf:.6f}"
      f"   -> identical: {abs(-r.fun - sub.llf) < 1e-6}")

def aicc(ll, k, nn): return -2*ll + 2*k + 2*k*(k+1)/(nn-k-1)

COV = lambda buf: {"A": ["elevation","annual.temperature","annual.rainfall","log_road","log_stream",
                         f"cropland.2009.{buf}"],
                   "B": ["elevation","annual.rainfall","log_road"],
                   "C": [],
                   "D": ["elevation","annual.temperature","annual.rainfall","log_road","log_stream",
                         f"cropland.2009.{buf}","habitat"]}

def sweep(sub_n, label):
    idx = sub_n.index
    su, fa, tr = succ[idx], fail[idx], trials[idx]
    kmask = tr > 0; nn = int(kmask.sum())
    rows = []
    for uterm, lab in URBAN_TERMS.items():
        buf = uterm.split(".")[-1]
        for covset, cl in COV(buf).items():
            X = design(sub_n, uterm, cl).values[kmask]
            m = sm.GLM(np.column_stack([su[kmask], fa[kmask]]), X, family=Binomial()).fit()
            k = X.shape[1]
            b, se, p = m.params[1], m.bse[1], m.pvalues[1]
            rows.append(dict(sample=label, urban_term=uterm, covset=covset, n=nn, k=k,
                             AICc=aicc(m.llf, k, nn), beta=b, se=se, z=b/se, p=p,
                             OR_per_10pct=np.exp(0.1*b), OR_lo=np.exp(0.1*(b-1.96*se)),
                             OR_hi=np.exp(0.1*(b+1.96*se)), llf=m.llf))
    S = pd.DataFrame(rows); S["dAICc"] = S.groupby("covset").AICc.transform(lambda x: x - x.min())
    return S

allS = pd.concat([sweep(n, "full_632"),
                  sweep(n[n.habitat != "Urban"], "noUrbanHabitat_567")], ignore_index=True)
allS.to_csv("analysis/step1_sweep_composition.csv", index=False)

for label in ("full_632", "noUrbanHabitat_567"):
    for cs in ("A", "C", "D", "B"):
        sub = allS[(allS.sample_ if False else allS["sample"]==label) & (allS.covset==cs)].sort_values("AICc")
        print(f"\n===== {label} | covariate set {cs} | n(plots with trials>0)={sub.n.iloc[0]} =====")
        print(sub[["urban_term","k","AICc","dAICc","beta","se","z","p","OR_per_10pct","OR_lo","OR_hi"]]
              .round(4).to_string(index=False))
