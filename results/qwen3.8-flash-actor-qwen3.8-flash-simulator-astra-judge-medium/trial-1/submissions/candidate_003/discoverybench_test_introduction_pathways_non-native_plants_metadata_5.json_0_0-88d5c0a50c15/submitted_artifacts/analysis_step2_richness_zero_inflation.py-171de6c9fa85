"""STEP 2 - companion model + the zero-inflation decision.
(a) rigorous proof that the 442 zero-trial plots cannot distort the compositional binomial;
(b) n.total: Poisson vs NB2 (dispersion test) vs hurdle, same linear predictors.
"""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from scipy.optimize import minimize
from statsmodels.genmod.families import Binomial, Poisson, NegativeBinomial
from statsmodels.discrete.count_model import ZeroInflatedPoisson, NegativeBinomialP
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design

pd.set_option("display.width", 250)
n = add_deltas(load_plot())
succ = n["n.gard"].values.astype(float); fail = n["n.unint"].values.astype(float)
trials = succ + fail; keep = trials > 0

def my_ll(beta, X, s=None, t=None):
    s = succ if s is None else s; t = trials if t is None else t
    eta = np.clip(X @ beta, -700, 700)
    return float((s*eta - t*np.logaddexp(0.0, eta)).sum())   # 0-trial rows -> 0 exactly

UT = "delta_urban_1993_2009.500m"
Xall = design(n, UT, []).values
m_sub = sm.GLM(np.column_stack([succ[keep], fail[keep]]), Xall[keep], family=Binomial()).fit()
b = m_sub.params
ll_all  = my_ll(b, Xall)
ll_keep = my_ll(b, Xall[keep], succ[keep], trials[keep])
print("=== (a) ZERO-TRIAL EQUIVALENCE (same beta, my exact binomial loglik) ===")
print(f"  logLik over all 632 plots      = {ll_all:.10f}")
print(f"  logLik over 190 trials>0 plots = {ll_keep:.10f}")
print(f"  difference = {abs(ll_all-ll_keep):.2e}  -> dropping the 442 zero plots is an EXACT identity")
print(f"  (statsmodels reports llf={m_sub.llf:.4f}; difference {m_sub.llf-ll_keep:.4f} = sum log C(n_i,y_i),")
print(f"   a constant that is identical for every candidate model -> no effect on AICc ranking or betas)")
# also: n.gard+n.unint==0 for all 441 n.total==0 plots?
print(f"  all {int((n['n.total']==0).sum())} zero-richness plots are also zero-trial plots: "
      f"{bool((trials[n['n.total'].values==0]==0).all())}")
# and the 1 plot with only AgriForest
print(f"  plots with n.total>0 but trials==0 (AgriForest-only): {int(((trials==0)&(n['n.total']>0)).sum())}")

print("\n=== (b) n.total RICHNESS MODELS: Poisson vs NB2 vs hurdle ===")
CAND = ["urban.2009.500m", "urban.2009.1000m", "delta_urban_1993_2009.500m",
        "delta_urban_1956_2009.500m", "urban.2009.50m"]
COV = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
def aicc(ll, k, nn=632): return -2*ll + 2*k + 2*k*(k+1)/(nn-k-1)
res = []
for ut in CAND:
    X = design(n, ut, COV).values
    y = n["n.total"].values.astype(float)
    mp = sm.GLM(y, X, family=Poisson()).fit()
    pear = (y - mp.fittedvalues)/np.sqrt(mp.fittedvalues)
    disp = (pear**2).sum()/(len(y)-X.shape[1])
    # Breusch-Pagan/Cameron-Johnson style test of equidispersion
    from scipy import stats
    DJ = (pear**2 - 1).sum()/np.sqrt(2*len(y))
    import warnings; warnings.filterwarnings("ignore")
    mnb = NegativeBinomialP(y, X, p=2).fit(method="newton", maxiter=200, disp=False)  # NB2
    # hurdle: binomial presence part + truncated-count part on y>0
    pres = sm.GLM((y>0).astype(float), X, family=Binomial()).fit()
    pos = y > 0
    mpos = NegativeBinomialP(y[pos], X[pos], p=2).fit(method="newton", maxiter=200, disp=False)
    hurdle_ll = pres.llf + mpos.llf   # non-constant-adjusted; used only for the urban coefficient
    res.append(dict(urban_term=ut, model="Poisson", k=X.shape[1], AICc=aicc(mp.llf, X.shape[1]),
                    beta=mp.params[1], se=mp.bse[1], p=mp.pvalues[1],
                    IRR_per_10pct=np.exp(0.1*mp.params[1]), extra=disp, DJ_z=DJ, DJ_p=2*(1-stats.norm.cdf(abs(DJ)))))
    res.append(dict(urban_term=ut, model="NB2", k=X.shape[1]+1, AICc=aicc(mnb.llf, X.shape[1]+1),
                    beta=mnb.params[1], se=mnb.bse[1], p=mnb.pvalues[1],
                    IRR_per_10pct=np.exp(0.1*mnb.params[1]), extra=mnb.params[-1], DJ_z=np.nan, DJ_p=np.nan))
    res.append(dict(urban_term=ut, model="hurdle_count_part", k=pres.df_model+mpos.df_model+2,
                    AICc=np.nan, beta=mpos.params[1], se=mpos.bse[1], p=mpos.pvalues[1],
                    IRR_per_10pct=np.exp(0.1*mpos.params[1]), extra=np.nan, DJ_z=np.nan, DJ_p=np.nan))
    res.append(dict(urban_term=ut, model="hurdle_presence_part", k=pres.df_model+1, AICc=np.nan,
                    beta=pres.params[1], se=pres.bse[1], p=pres.pvalues[1],
                    IRR_per_10pct=np.exp(0.1*pres.params[1]), extra=np.nan, DJ_z=np.nan, DJ_p=np.nan))
R = pd.DataFrame(res)
print(R.round(4).to_string(index=False))
R.to_csv("analysis/step2_richness_models.csv", index=False)
print("\nzero-inflation summary: Poisson Pearson/X2 dispersion ratio and Cameron-Johnson DJ test are")
print("printed per candidate; NB2 alpha is the estimated overdispersion k (var = mu + k*mu^2).")
