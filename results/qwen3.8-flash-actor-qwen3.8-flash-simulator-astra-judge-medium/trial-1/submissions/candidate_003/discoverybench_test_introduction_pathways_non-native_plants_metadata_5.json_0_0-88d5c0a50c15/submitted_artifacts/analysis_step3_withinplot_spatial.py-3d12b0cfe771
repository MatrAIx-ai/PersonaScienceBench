"""STEP 3
(a) plot-conditional (matched) multinomial-Poisson model: pathway x urban interaction with a
    fixed effect for every invaded plot -> removes ALL between-plot confounding.
(b) quasi-binomial dispersion check on the compositional model.
(c) habitat x urban interaction diagnostic.
(d) Moran's I on residuals (magnitude, not just presence).
(e) collinearity sensitivity: drop elevation / temperature, and residualise urban on them.
"""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial, Poisson
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250)
n = add_deltas(load_plot())
n["pid"] = np.arange(len(n))

print("=== (a) PLOT-CONDITIONAL PATHWAY MODEL (matched design) ===")

print("  NOTE (design truth): urban is a PLOT-level variable. In the binomial model")
print("  n.gard | n.gard+n.unint ~ Binomial(p(plot covariates)) we already condition on the")
print("  plot's total invaded richness, but urban is CONSTANT within a plot, so it carries no")
print("  within-plot information and a plot-fixed-effect/matched model is degenerate by")
print("  construction (a stratum containing both pathway records contributes exactly 0 to a")
print("  conditional likelihood). Between-plot confounding must therefore be handled by")
print("  ADJUSTMENT and by STRATIFIED PERMUTATION, not by matching. Implemented below.")

print("\n  stratified exact-ish permutation test: shuffle urban WITHIN habitat x elevation blocks")
inv_idx = np.where((n["n.gard"]+n["n.unint"]).values > 0)[0]
n["elev_blk"] = pd.qcut(n.elevation, 3, labels=False)
blocks = (n.habitat.astype(str) + "|e" + n.elev_blk.astype(str)).values
def strat_perm_test(UT, cov, nperm=2000, seed=1):
    X = design(n, UT, cov).values[inv_idx]
    y = np.column_stack([n["n.gard"].values[inv_idx].astype(float),
                         n["n.unint"].values[inv_idx].astype(float)])
    m = sm.GLM(y, X, family=Binomial()).fit()
    t_obs = m.params[1]
    rng = np.random.default_rng(seed)
    col = n[UT].values.copy()
    null = np.empty(nperm)
    for b_i in range(nperm):
        for blk in np.unique(blocks[inv_idx]):
            ix = np.where(blocks[inv_idx] == blk)[0]
            col[ix] = np.asarray(rng.permutation(n[UT].values[inv_idx][ix]))
        nX = X.copy(); nX[:, 1] = col[inv_idx]
        null[b_i] = sm.GLM(y, nX, family=Binomial()).fit().params[1]
    p_two = 2*min((null <= t_obs).mean(), (null >= t_obs).mean())
    return t_obs, p_two, np.percentile(null, [2.5, 97.5])
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    t, p, ci = strat_perm_test(UT, COV5 + [f"cropland.2009.{UT.split('.')[-1]}"])
    print(f"  {UT:26s} beta={t:+.3f}; permutation null mean 2.5-97.5% = [{ci[0]:+.3f},{ci[1]:+.3f}]; "
          f"two-sided stratified permutation p = {p:.4f}")
print("  (blocks: 10 habitats x elevation tertiles, so urban is only exchanged among plots of the")
print("   same habitat type and similar elevation -> the effect is NOT habitat- or elevation-driven"
      " if p stays small)")

print("\n=== (b) OVERDISPERSION of the compositional binomial (n.gard | n.gard+n.unint) ===")
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    cov = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream",
           f"cropland.2009.{UT.split('.')[-1]}"]
    tr = (n["n.gard"]+n["n.unint"]).values > 0
    X = design(n, UT, cov).values[tr]
    y = np.column_stack([n["n.gard"].values[tr].astype(float), n["n.unint"].values[tr].astype(float)])
    m = sm.GLM(y, X, family=Binomial()).fit()
    phi = m.pearson_chi2/m.df_resid
    z, p = m.params[1]/(m.bse[1]*np.sqrt(max(phi,1))), m.pvalues[1]
    print(f"  {UT:28s} Pearson chi2/df = {phi:.3f} -> {'quasi-binomial inflation needed (x%.2f)'%phi if phi>1.05 else 'no inflation needed'}; "
          f"naive p={m.pvalues[1]:.4f}, quasi-binomial p={p:.4f}")

print("\n=== (c) habitat x urban INTERACTION (diagnostic) ===")
from scipy import stats as st
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    tr = (n["n.gard"]+n["n.unint"]).values > 0
    base = design(n, UT, ["elevation","annual.temperature","annual.rainfall","log_road","log_stream",
                          f"cropland.2009.{UT.split('.')[-1]}","habitat"])
    u = n[UT].values
    inter = pd.DataFrame({f"hab_X_urban:{h}": (n.habitat==h).astype(float).values*u
                          for h in sorted(n.habitat.unique())[1:]}, index=n.index)
    full = pd.concat([base, inter], axis=1)
    m0 = sm.GLM(np.column_stack([n["n.gard"].values[tr].astype(float), n["n.unint"].values[tr].astype(float)]),
                base.values[tr], family=Binomial()).fit()
    m1 = sm.GLM(np.column_stack([n["n.gard"].values[tr].astype(float), n["n.unint"].values[tr].astype(float)]),
                full.values[tr], family=Binomial()).fit()
    lr = 2*(m1.llf-m0.llf); df = full.shape[1]-base.shape[1]
    print(f"  {UT:28s} LRT habitat:urban deviance diff = {lr:.2f} on {df} df, p={st.chi2.sf(lr,df):.3f} "
          f"(urban main effect in interaction model: beta={m1.params[1]:+.3f}, p={m1.pvalues[1]:.3f})")

print("\n=== (d) MORAN'S I on residuals ===")
def moran(e, xy, k=5):
    d = np.sqrt(((xy[:,None,:]-xy[None,:,:])**2).sum(-1))
    np.fill_diagonal(d, np.inf)
    W = np.zeros_like(d)
    for i in range(len(xy)): W[i, np.argsort(d[i])[:k]] = 1.0
    e = e - e.mean(); den = (e**2).sum()
    I = (len(e)/W.sum()) * (e @ W.T @ e)/den
    # permutation null
    rng = np.random.default_rng(0); null = []
    for _ in range(999):
        s = rng.permutation(e); null.append((len(s)/W.sum())*(s @ W.T @ s)/den)
    null = np.array(null)
    return I, (I > null).mean(), null.mean(), null.std()
cov_main = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream","cropland.2009.500m"]
tr = (n["n.gard"]+n["n.unint"]).values > 0
Xb = design(n, "urban.2009.500m", cov_main)
mb = sm.GLM(np.column_stack([n["n.gard"].values[tr].astype(float), n["n.unint"].values[tr].astype(float)]),
            Xb.values[tr], family=Binomial()).fit()
xy = n[["longitude","latitude"]].values.astype(float)
I,pv,emu,esd = moran(mb.resid_response, xy[tr])
print(f"  composition model (n.gard|gard+unint, {tr.sum()} invaded plots): Moran I = {I:+.4f} "
      f"(perm p={pv:.4f}; null mean {emu:+.4f} sd {esd:.4f}) -> {abs(I-emu)/esd:.2f} sd from null")
mp = sm.GLM(n["n.total"].values.astype(float), design(n,"urban.2009.500m",
            ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]).values,
            family=Poisson()).fit()
I,pv,emu,esd = moran(mp.resid_response, xy)
print(f"  n.total Poisson model, all 632 plots:              Moran I = {I:+.4f} "
      f"(perm p={pv:.4f}; null mean {emu:+.4f} sd {esd:.4f}) -> {abs(I-emu)/esd:.2f} sd from null")

print("\n=== (e) COLLINEARITY SENSITIVITY of the compositional effect ===")
variants = {
 "A full (elev+temp+rain+road+stream+cropland)": ["elevation","annual.temperature","annual.rainfall","log_road","log_stream","cropland.2009.500m"],
 "no elevation":            ["annual.temperature","annual.rainfall","log_road","log_stream","cropland.2009.500m"],
 "no temperature":          ["elevation","annual.rainfall","log_road","log_stream","cropland.2009.500m"],
 "no elev & no temp":       ["annual.rainfall","log_road","log_stream","cropland.2009.500m"],
 "none (urban only)":       [],
 "habitat strata only":     ["habitat"],
}
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    print(f" -- {UT}")
    for lab, cov in variants.items():
        X = design(n, UT, cov)
        m = sm.GLM(np.column_stack([n["n.gard"].values[tr].astype(float), n["n.unint"].values[tr].astype(float)]),
                   X.values[tr], family=Binomial()).fit()
        b, se = m.params[1], m.bse[1]
        print(f"     {lab:44s} beta={b:+.3f} se={se:.3f} p={m.pvalues[1]:.4f} OR/10%={np.exp(0.1*b):.3f} "
              f"[{np.exp(0.1*(b-1.96*se)):.3f},{np.exp(0.1*(b+1.96*se)):.3f}]")
