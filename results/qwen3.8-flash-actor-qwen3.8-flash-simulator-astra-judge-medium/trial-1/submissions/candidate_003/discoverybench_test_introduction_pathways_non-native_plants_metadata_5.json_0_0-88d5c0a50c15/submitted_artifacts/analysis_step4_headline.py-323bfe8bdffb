"""STEP 4 - headline table: full sample vs no-Urban-habitat, stratified permutation with the
loop bug fixed, habitat-specific effects with their supporting counts."""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial, Poisson
from statsmodels.discrete.count_model import NegativeBinomialP
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250); pd.set_option("display.max_columns", 30)
n = add_deltas(load_plot())
n["elev_blk"] = pd.qcut(n.elevation, 3, labels=False)
n["blocks"] = n.habitat.astype(str) + "|e" + n.elev_blk.astype(str)
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
HEAD = ["urban.2009.500m", "delta_urban_1993_2009.500m"]

def binom_fit(sub, UT, cov):
    tr = (sub["n.gard"]+sub["n.unint"]).values > 0
    X = design(sub, UT, cov).values[tr]
    y = np.column_stack([sub["n.gard"].values[tr].astype(float), sub["n.unint"].values[tr].astype(float)])
    m = sm.GLM(y, X, family=Binomial()).fit()
    phi = m.pearson_chi2/m.df_resid
    return m, phi, int(tr.sum()), y, X

def strat_perm(sub, UT, cov, nperm=999, seed=7):
    tr = (sub["n.gard"]+sub["n.unint"]).values > 0
    X = design(sub, UT, cov).values[tr]
    y = np.column_stack([sub["n.gard"].values[tr].astype(float), sub["n.unint"].values[tr].astype(float)])
    t_obs = sm.GLM(y, X, family=Binomial()).fit().params[1]
    blocks = sub["blocks"].values[tr]; orig = sub[UT].values[tr]
    rng = np.random.default_rng(seed); null = np.empty(nperm)
    for i in range(nperm):
        col = orig.copy()                      # <-- reset every replicate (bug fixed)
        for blk in np.unique(blocks):
            ix = np.where(blocks == blk)[0]
            col[ix] = rng.permutation(col[ix])
        nX = X.copy(); nX[:, 1] = col
        null[i] = sm.GLM(y, nX, family=Binomial()).fit().params[1]
    p = 2*min((null <= t_obs).mean(), (null >= t_obs).mean())
    return t_obs, p, np.percentile(null, [2.5, 97.5]), null

samples = {"full (n=632 plots; 190 with records)": n,
           "excl. Urban habitat (n=567; 136 with records)": n[n.habitat != "Urban"]}
rows = []
print("=== HEADLINE: compositional binomial  n.gard | n.gard + n.unint ===")
for sname, sub in samples.items():
    print(f"\n--- {sname} ---")
    for UT in HEAD:
        cov = COV5 + [f"cropland.2009.{UT.split('.')[-1]}"]
        m, phi, nn, y, X = binom_fit(sub, UT, cov)
        b, se = m.params[1], m.bse[1]
        qse = se*np.sqrt(max(phi, 1))
        t, p, ci, null = strat_perm(sub, UT, cov)
        print(f"  {UT:26s} n={nn:3d} beta={b:+.3f} se={se:.3f} (quasi se={qse:.3f}, phi={phi:.2f})")
        print(f"        OR gardening per +10% urban = {np.exp(0.1*b):.3f} [{np.exp(0.1*(b-1.96*se)):.3f},"
              f" {np.exp(0.1*(b+1.96*se)):.3f}]  Wald p={m.pvalues[1]:.4f}"
              f" | stratified permutation p={p:.4f} (null 95% [{ci[0]:+.3f},{ci[1]:+.3f}], sd={null.std():.3f})")
        rows.append(dict(sample=sname, urban_term=UT, n_plots_with_records=nn, beta=b, se=se, phi=phi,
                         OR10=np.exp(0.1*b), ORlo=np.exp(0.1*(b-1.96*se)), ORhi=np.exp(0.1*(b+1.96*se)),
                         p_wald=m.pvalues[1], p_perm=p, perm_lo=ci[0], perm_hi=ci[1]))
    # companion richness model, NB2
    for UT in HEAD:
        X = design(sub, UT, COV5).values; y = sub["n.total"].values.astype(float)
        mnb = NegativeBinomialP(y, X, p=2).fit(method="newton", maxiter=300, disp=False)
        b, se = mnb.params[1], mnb.bse[1]
        print(f"  [NB2 n.total] {UT:24s} beta={b:+.3f} se={se:.3f} p={mnb.pvalues[1]:.4f} "
              f"IRR/+10%={np.exp(0.1*b):.3f} [{np.exp(0.1*(b-1.96*se)):.3f},{np.exp(0.1*(b+1.96*se)):.3f}]"
              f"  alpha={mnb.params[-1]:.2f}")
        rows.append(dict(sample=sname, urban_term="[NB2 n.total] "+UT, n_plots_with_records=len(sub),
                         beta=b, se=se, phi=np.nan, OR10=np.exp(0.1*b), ORlo=np.exp(0.1*(b-1.96*se)),
                         ORhi=np.exp(0.1*(b+1.96*se)), p_wald=mnb.pvalues[1], p_perm=np.nan))
    # pathway-specific NB2
    for pw in ["n.gard","n.unint","n.agfo"]:
        X = design(sub, "urban.2009.500m", COV5).values; y = sub[pw].values.astype(float)
        mnb = NegativeBinomialP(y, X, p=2).fit(method="newton", maxiter=300, disp=False)
        print(f"  [NB2 {pw}] beta={mnb.params[1]:+.3f} se={mnb.bse[1]:.3f} p={mnb.pvalues[1]:.4f} "
              f"IRR/+10%={np.exp(0.1*mnb.params[1]):.3f}")
pd.DataFrame(rows).to_csv("analysis/step4_headline.csv", index=False)

print("\n=== habitat-specific compositional effect (with the counts that support each) ===")
print("    est = log-odds of a record being Gardening (vs Unintentional) per +10% urban.2009.500m")
out = []
for h in sorted(n.habitat.unique()):
    s = n[(n.habitat == h) & ((n["n.gard"]+n["n.unint"]) > 0)]
    ng, nu = int(s["n.gard"].sum()), int(s["n.unint"].sum())
    if len(s) < 5 or ng == 0 or nu == 0:
        out.append(dict(habitat=h, plots=len(s), gard=ng, unint=nu, est=np.nan, note="not estimable")); continue
    X = design(s, "urban.2009.500m", []).values
    y = np.column_stack([s["n.gard"].values.astype(float), s["n.unint"].values.astype(float)])
    m = sm.GLM(y, X, family=Binomial()).fit()
    out.append(dict(habitat=h, plots=len(s), gard=ng, unint=nu, est=m.params[1], se=m.bse[1],
                    p=m.pvalues[1], note=""))
O = pd.DataFrame(out); print(O.round(3).to_string(index=False))
O.to_csv("analysis/step4_habitat_specific.csv", index=False)
