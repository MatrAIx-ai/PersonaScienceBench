"""STEP 5 - is delta_urban_1993_2009.500m real or an artefact of a few plots?"""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250)
n = add_deltas(load_plot())
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
UT = "delta_urban_1993_2009.500m"
tr_all = (n["n.gard"]+n["n.unint"]).values > 0

print("=== 5.1 distribution of the delta terms (is there enough contrast?) ===")
for c in [c for c in n.columns if c.startswith("delta_urban")]:
    v = n[c]
    print(f"  {c:30s} sd={v.std():.3f}  min={v.min():+.2f} max={v.max():+.2f} "
          f"p99={np.percentile(v,99):+.2f}  |delta|>0.05: {int((v.abs()>0.05).sum())} plots, "
          f">+0.05: {int((v>0.05).sum())}, <-0.05: {int((v<-0.05).sum())}")
print(f"  r(urban.2009.500m, delta_urban_1993_2009.500m) = {np.corrcoef(n['urban.2009.500m'], n[UT])[0,1]:+.3f}")

print("\n=== 5.2 is it EXPANSION per se, or just today's urban cover? (both terms together) ===")
for cov_set in (["urban.2009.500m"], []):
    cov = COV5 + ["cropland.2009.500m"] + cov_set
    X = design(n, UT, cov); nm = list(X.columns)
    m = sm.GLM(np.column_stack([n["n.gard"].values[tr_all].astype(float), n["n.unint"].values[tr_all].astype(float)]),
               X.values[tr_all], family=Binomial()).fit()
    i1, i2 = nm.index(UT), (nm.index("urban.2009.500m") if cov_set else None)
    print(f"  covariates {'+ urban.2009.500m' if cov_set else '(no current-urban term)'}:"
          f"  delta beta={m.params[i1]:+.3f} se={m.bse[i1]:.3f} p={m.pvalues[i1]:.4f}", end="")
    if i2: print(f" | current urban.2009.500m beta={m.params[i2]:+.3f} se={m.bse[i2]:.3f} p={m.pvalues[i2]:.4f}"
                 f" (VIF pair r={np.corrcoef(X[UT],X['urban.2009.500m'])[0,1]:+.2f})")
    else: print()

print("\n=== 5.3 recency: 1956->2009 vs 1993->2009 expansion, same buffer ===")
for a, b in [("1956","2009"), ("1993","2009")]:
    u = f"delta_urban_{a}_{b}.500m"
    X = design(n, u, COV5+["cropland.2009.500m"])
    m = sm.GLM(np.column_stack([n["n.gard"].values[tr_all].astype(float), n["n.unint"].values[tr_all].astype(float)]),
               X.values[tr_all], family=Binomial()).fit()
    print(f"  {u:30s} beta={m.params[1]:+.3f} se={m.bse[1]:.3f} p={m.pvalues[1]:.4f} "
          f"OR/10%={np.exp(0.1*m.params[1]):.3f}")
X = design(n, f"delta_urban_1993_2009.500m", COV5+["cropland.2009.500m", f"delta_urban_1956_2009.500m"])
nm = list(X.columns)
m = sm.GLM(np.column_stack([n["n.gard"].values[tr_all].astype(float), n["n.unint"].values[tr_all].astype(float)]),
           X.values[tr_all], family=Binomial()).fit()
print(f"  BOTH deltas together: r={np.corrcoef(n['delta_urban_1993_2009.500m'],n['delta_urban_1956_2009.500m'])[0,1]:+.2f}; "
      f"93->09 beta={m.params[nm.index('delta_urban_1993_2009.500m')]:+.3f} (p={m.pvalues[nm.index('delta_urban_1993_2009.500m')]:.4f}), "
      f"56->09 beta={m.params[nm.index('delta_urban_1956_2009.500m')]:+.3f} (p={m.pvalues[nm.index('delta_urban_1956_2009.500m')]:.4f})")

print("\n=== 5.4 rescale / binarise: effect per +25% and for a binary expansion indicator ===")
for scale, lab in [(0.25, "per +25%"), (1.0, "per +100%")]:
    print(f"  OR {lab}: {np.exp(scale*-2.771):.3f}")
n["exp25"] = (n[UT] > 0.025).astype(float)
for lab, var in [("expansion >2.5pp (1993->2009,500m)", "exp25")]:
    sub = n[n.habitat != "Urban"]
    for nm_, d in [("full", n), ("excl Urban habitat", sub)]:
        X = design(d, var, COV5+["cropland.2009.500m"])
        t = (d["n.gard"]+d["n.unint"]).values > 0
        m = sm.GLM(np.column_stack([d["n.gard"].values[t].astype(float), d["n.unint"].values[t].astype(float)]),
                   X.values[t], family=Binomial()).fit()
        print(f"  {lab} [{nm_}]: beta={m.params[1]:+.3f} se={m.bse[1]:.3f} p={m.pvalues[1]:.4f} "
              f"OR={np.exp(m.params[1]):.3f} [{np.exp(m.params[1]-1.96*m.bse[1]):.3f},{np.exp(m.params[1]+1.96*m.bse[1]):.3f}]"
              f"  (n expanded={int(d[var].sum())}/{len(d)})")

print("\n=== 5.5 influence: leave-one-plot-out range of the delta coefficient ===")
Xall = design(n, UT, COV5+["cropland.2009.500m"]).values[tr_all]
Yall = np.column_stack([n["n.gard"].values[tr_all].astype(float), n["n.unint"].values[tr_all].astype(float)])
b_full = sm.GLM(Yall, Xall, family=Binomial()).fit().params[1]
Xs = pd.Series(n[UT].values[tr_all]); ys = pd.Series(Yall[:,0]); ns = pd.Series(Yall.sum(1))
lb = []
for i in range(Xall.shape[0]):
    keep = np.ones(Xall.shape[0], bool); keep[i] = False
    lb.append(sm.GLM(Yall[keep], Xall[keep], family=Binomial()).fit(maxiter=200).params[1])
lb = np.array(lb)
inf = np.abs(lb-b_full)/np.abs(b_full)
print(f"  full beta={b_full:+.3f}; LOO beta range [{lb.min():+.3f},{lb.max():+.3f}]; "
      f"max single-plot influence {100*inf.max():.1f}%; median {100*np.median(inf):.2f}%")
top = np.argsort(-inf)[:5]
print("  most influential plots (delta, gard, unint+gard):",
      [(round(float(Xs.iloc[i]),2), int(ys.iloc[i]), int(ns.iloc[i])) for i in top])

print("\n=== 5.6 habitat x urban interaction, EFFECT-CENTRED so the main term = mean effect ===")
for UT_ in ["urban.2009.500m", UT]:
    habs = sorted(n.habitat.unique())
    base = design(n, UT_, COV5+["cropland.2009.500m"])
    u = n[UT_].values
    inter = pd.DataFrame({f"hX_{h}": (n.habitat==h).astype(float).values*u for h in habs}, index=n.index)
    inter = inter - inter.mean()               # centred: main term = average habitat effect
    full = pd.concat([base, inter], axis=1)
    Y = np.column_stack([n["n.gard"].values.astype(float), n["n.unint"].values.astype(float)])
    t = tr_all
    m0 = sm.GLM(Y[t], base.values[t], family=Binomial()).fit()
    m1 = sm.GLM(Y[t], full.values[t], family=Binomial()).fit(maxiter=200)
    from scipy import stats as st
    df = full.shape[1]-base.shape[1]; lr = 2*(m1.llf-m0.llf)
    print(f"  {UT_:26s} mean effect (centred model) beta={m1.params[1]:+.3f} se={m1.bse[1]:.3f} "
          f"p={m1.pvalues[1]:.4f} | interaction LRT {lr:.2f}/{df}df p={st.chi2.sf(lr,df):.3f}")
    dev = {h: m1.params[list(full.columns).index(f'hX_{h}')]-m1.params[1] for h in habs}
    print("     habitat deviations from mean effect:", {k: round(v,2) for k,v in dev.items()})
