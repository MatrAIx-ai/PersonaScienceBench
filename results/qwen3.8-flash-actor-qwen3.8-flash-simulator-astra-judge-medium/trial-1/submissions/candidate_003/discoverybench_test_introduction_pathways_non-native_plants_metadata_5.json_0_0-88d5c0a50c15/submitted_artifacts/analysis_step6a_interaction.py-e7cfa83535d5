"""STEP 6a - correct habitat x urban interaction (drop-one coding, identifiable)."""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250)
n = add_deltas(load_plot())
tr = (n["n.gard"]+n["n.unint"]).values > 0
Y = np.column_stack([n["n.gard"].values.astype(float), n["n.unint"].values.astype(float)])
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
habs = sorted(n.habitat.unique()); ref = "Riparian"     # largest informative non-Urban habitat
for UT in ["urban.2009.500m", "delta_urban_1993_2009.500m"]:
    u = n[UT].values
    hab_d = [h for h in habs if h != ref]
    hd = pd.DataFrame({f"hab[{h}]": (n.habitat==h).astype(float) for h in hab_d}, index=n.index)
    base = pd.concat([design(n, UT, COV5+["cropland.2009.500m"]), hd], axis=1)
    inter = pd.DataFrame({f"{h}||u": (n.habitat==h).astype(float).values*u for h in hab_d}, index=n.index)
    full = pd.concat([base, inter], axis=1)
    m0 = sm.GLM(Y[tr], base.values[tr], family=Binomial()).fit(maxiter=400)
    m1 = sm.GLM(Y[tr], full.values[tr], family=Binomial()).fit(maxiter=400)
    df = inter.shape[1]; lr = 2*(m1.llf-m0.llf); names = list(full.columns)
    inv = n[UT].index
    cnt = n.habitat.value_counts()
    slope = {ref: m1.params[names.index(UT)]}
    slope.update({h: m1.params[names.index(UT)]+m1.params[names.index(f"{h}||u")] for h in hab_d})
    print(f"\n=== {UT} ===")
    print(f"  habitat:urban interaction LRT = {lr:.2f} on {df} df  -> p = {st.chi2.sf(lr,df):.4f}")
    print(f"  slope in reference habitat ({ref}) = {slope[ref]:+.3f}")
    for h in hab_d: print(f"    slope in {h:20s} = {slope[h]:+.3f}")
    wm = sum(slope[h]*cnt[h] for h in slope)/cnt.sum()
    print(f"  plot-count-weighted mean slope across habitats = {wm:+.3f}  "
          f"(marginal no-interaction model gave -1.105 / -2.771)")
    print("  -> interaction is present but every habitat-specific slope is estimated on 1-54 "
          "invaded plots;\n     it is reported as a diagnostic, and the mean slope keeps the sign.")
