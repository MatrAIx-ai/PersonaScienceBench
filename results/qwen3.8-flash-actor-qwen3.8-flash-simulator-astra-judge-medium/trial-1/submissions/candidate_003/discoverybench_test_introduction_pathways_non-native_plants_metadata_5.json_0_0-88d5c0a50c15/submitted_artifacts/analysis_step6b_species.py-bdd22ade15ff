"""STEP 6b - species-level pathway contrasts (mechanism layer) + phylogenetic robustness."""
import sys, itertools, numpy as np, pandas as pd
from scipy import stats as st
from scipy.linalg import eigh
sys.path.insert(0, "analysis")
from common import load_species
from newick import parse, tips
pd.set_option("display.width", 250)
s = load_species()
print(f"unit: {len(s)} rows = {s['Scientific_name'].nunique()} species x pathway "
      f"(4 species enter twice, via two pathways -> they are separate tips in the tree)")
s["dnb"] = s["invaded.niche.breadth"] - s["native.niche.breadth"]
print("\n--- medians by pathway ---")
print(s.groupby("intro.pathway").agg(n=("intro.pathway","size"),
    plots=("number.of.invaded.plots","median"), occ=("area.of.occupancy.10km","median"),
    hrange=("habitat.range","median"), invaded_nb=("invaded.niche.breadth","median"),
    native_nb=("native.niche.breadth","median"), delta_nb=("dnb","median"),
    mrt=("mrt","median"), height=("height","median")).round(3).to_string())

print("\n--- permutation tests, pathway labels shuffled 20000x, Gardening vs Unintentional ---")
gu = s[s["intro.pathway"].isin(["Gardening","Unintentional"])].reset_index(drop=True)
lab = gu["intro.pathway"].values; rng = np.random.default_rng(11)
for var in ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range",
            "invaded.niche.breadth","native.niche.breadth","dnb","height","mrt"]:
    x = gu[var].values.astype(float)
    obs = x[lab=="Unintentional"].mean()-x[lab=="Gardening"].mean()
    null = np.empty(20000)
    for i in range(20000):
        p = rng.permutation(lab)
        null[i] = x[p=="Unintentional"].mean()-x[p=="Gardening"].mean()
    pv = 2*min((null<=obs).mean(),(null>=obs).mean())
    print(f"  {var:24s} Unint - Gard = {obs:+.3f}  95% null [{np.percentile(null,2.5):+.3f},"
          f"{np.percentile(null,97.5):+.3f}]  perm p = {pv:.4f}")
print("\n--- trait composition (Fisher exact, Unint vs Gard) ---")
for name, flag in [("woody (Shrub/tree)", "Shrub/tree"), ("Annual fg", "Annual fg"),
                   ("Perennial fg", "Perennial fg")]:
    b = (gu["growth.form"]==flag).astype(int).values
    ct = np.array([[b[lab=="Unintentional"].sum(), (lab=="Unintentional").sum()-b[lab=="Unintentional"].sum()],
                   [b[lab=="Gardening"].sum(),   (lab=="Gardening").sum()-b[lab=="Gardening"].sum()]])
    print(f"  {name:20s} 2x2 {ct.tolist()}  Fisher p = {st.fisher_exact(ct)[1]:.2e}  "
          f"OR = {st.fisher_exact(ct)[0]:.3f}")
b = (gu["dispersal"]=="Wind").astype(int).values
ct = np.array([[b[lab=="Unintentional"].sum(), (lab=="Unintentional").sum()-b[lab=="Unintentional"].sum()],
               [b[lab=="Gardening"].sum(),   (lab=="Gardening").sum()-b[lab=="Gardening"].sum()]])
print(f"  {'wind dispersal':20s} 2x2 {ct.tolist()}  Fisher p = {st.fisher_exact(ct)[1]:.3f}")

print("\n--- phylogenetic covariance from the ultrametric tree ---")
root = parse(open("data/phylogenetic_tree.txt").read()); T = {t.name: t for t in tips(root)}
def path_to_root(name):
    out, node = [], T[name]
    while node is not None: out.append(node); node = node.parent
    return out[::-1]
paths = {k: path_to_root(k) for k in T}
ids = {k: [id(x) for x in v] for k, v in paths.items()}
# node height above root
height = {}
for k, p in paths.items():
    acc = 0.0
    for nd in p:
        acc += (nd.length or 0.0); height[id(nd)] = acc
order = sorted(T); N = len(order)
C = np.zeros((N, N))
for i, a in enumerate(order):
    for j, b in enumerate(order):
        common = [x for x in ids[a] if x in set(ids[b])]
        C[i, j] = height[common[-1]] if common else 0.0
print(f"  VCV {C.shape} (shared evolutionary time, Myr); symmetric={np.allclose(C,C.T)}; "
      f"diagonal {C.diagonal().min():.1f}-{C.diagonal().max():.1f}; ultrametric => equal diagonals")
srt = s.sort_values("phylo.tip.label").reset_index(drop=True)
idx = {t: i for i, t in enumerate(order)}
Cm = np.array([[C[idx[a], idx[b]] for b in srt["phylo.tip.label"]] for a in srt["phylo.tip.label"]])

def gls(y, X, C, lam):
    Cv = C*lam + np.eye(len(C))*(1-lam)*np.diag(C).mean()
    w, V = eigh(Cv); w = np.clip(w, 1e-10, None); W = V/np.sqrt(w)
    yw, Xw = W.T@y, W.T@X
    beta = np.linalg.lstsq(Xw, yw, rcond=None)[0]
    r = yw - Xw@beta; dof = len(y)-X.shape[1]; s2 = (r**2).sum()/dof
    se = np.sqrt(np.diag(np.linalg.inv(Xw.T@Xw)*s2))
    ll = -0.5*(np.sum(np.log(w)) + len(y)*np.log(s2) + dof)
    return beta, se, 2*st.t.sf(abs(beta/se), dof), ll
print("\n--- PGLS vs ordinary least squares (log1p outcomes; Unintentional vs Gardening, AgriForest as 3rd level) ---")
for var in ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range",
            "invaded.niche.breadth","native.niche.breadth","dnb","height"]:
    y = np.log1p(srt[var].values.astype(float))
    X = np.column_stack([np.ones(len(y)), (srt["intro.pathway"]=="Unintentional").astype(float),
                         (srt["intro.pathway"]=="AgriForest").astype(float)])
    b0 = np.linalg.lstsq(X, y, rcond=None)[0]; r0 = y-X@b0
    se0 = np.sqrt(np.diag(np.linalg.inv(X.T@X))*(r0**2).sum()/(len(y)-3))
    lams = np.linspace(0, 1, 21); best = None
    for lam in lams:
        b, se, p, ll = gls(y, X, Cm, lam)
        if best is None or ll > best[-1]: best = (lam, b, se, p, ll)
    lam, b, se, p, _ = best
    print(f"  {var:24s} OLS beta(Unint)={b0[1]:+.3f} (se {se0[1]:.3f}) | PGLS beta(Unint)={b[1]:+.3f} "
          f"(se {se[1]:.3f}, p={p[1]:.4f}) | lambda_ML={lam:.2f}  {'CONCLUSION CHANGES' if (b0[1]/se0[1]>2)!=(b[1]/se[1]>2) and abs(b0[1]/se0[1])>2 or (abs(b0[1]/se0[1])<2 and abs(b[1]/se[1])>2) else ''}")
print("\n--- phylogenetic ANOVA (mean-body: permutations of trait across tips is not valid;")
print("    instead we report lambda_ML as the phylogenetic-signal diagnostic above) ---")
for var in ["number.of.invaded.plots","invaded.niche.breadth","height"]:
    y = np.log1p(srt[var].values.astype(float)); X = np.ones((len(y),1))
    lam0 = gls(y, X, Cm, 1.0)[3]; 
    sig = []
    for lam in np.linspace(0,1,21):
        sig.append(gls(y, X, Cm, lam)[3])
    print(f"  {var:24s}: phylogenetic signal lambda_ML ~ {np.linspace(0,1,21)[int(np.argmax(sig))]:.2f} (pathway-free intercept model)")
