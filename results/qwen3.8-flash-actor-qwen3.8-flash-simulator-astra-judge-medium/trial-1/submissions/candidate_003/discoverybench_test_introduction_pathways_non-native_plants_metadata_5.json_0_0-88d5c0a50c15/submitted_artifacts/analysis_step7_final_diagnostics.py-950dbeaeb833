"""STEP 7 - interpretable interaction (informative habitats only), predicted shares,
AgriForest descriptives, and the documented-change-category cross-check."""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250); pd.set_option("display.max_columns", 30)
n = add_deltas(load_plot())
Y = lambda d: np.column_stack([d["n.gard"].values.astype(float), d["n.unint"].values.astype(float)])
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
inv = (n["n.gard"]+n["n.unint"]) > 0

print("=== 7.1 which habitats can carry an interaction at all? ===")
g = n[inv].groupby("habitat").agg(plots=("habitat","size"), gard=("n.gard","sum"), unint=("n.unint","sum"))
g["both_present"] = n[inv].groupby("habitat").apply(lambda d: ((d["n.gard"]>0)&(d["n.unint"]>0)).sum(), include_groups=False)
print(g.to_string())
GOOD = [h for h in g.index if g.loc[h,"both_present"] >= 8]
print(f"  habitats with >=8 plots containing BOTH pathways -> {GOOD} "
      f"({int(g.loc[GOOD,'plots'].sum())} of {int(g.plots.sum())} invaded plots)")

print("\n=== 7.2 interaction restricted to those habitats ===")
for UT in ["urban.2009.500m", "delta_urban_1993_2009.500m"]:
    sub = n[n.habitat.isin(GOOD)].copy()
    t = (sub["n.gard"]+sub["n.unint"]).values > 0
    ref = GOOD[0]
    hd = pd.DataFrame({f"hab[{h}]": (sub.habitat==h).astype(float) for h in GOOD[1:]}, index=sub.index)
    base = pd.concat([design(sub, UT, COV5+["cropland.2009.500m"]), hd], axis=1)
    inter = pd.DataFrame({f"{h}||u": (sub.habitat==h).astype(float).values*sub[UT].values for h in GOOD[1:]}, index=sub.index)
    full = pd.concat([base, inter], axis=1)
    m0 = sm.GLM(Y(sub)[t], base.values[t], family=Binomial()).fit(maxiter=400)
    m1 = sm.GLM(Y(sub)[t], full.values[t], family=Binomial()).fit(maxiter=400)
    lr = 2*(m1.llf-m0.llf); df = inter.shape[1]; nm = list(full.columns)
    sl = {ref: m1.params[nm.index(UT)]}
    sl.update({h: m1.params[nm.index(UT)]+m1.params[nm.index(f"{h}||u")] for h in GOOD[1:]})
    print(f"\n  {UT}: restricted to {GOOD}")
    print(f"    interaction LRT = {lr:.2f} on {df} df, p = {st.chi2.sf(lr,df):.4f}")
    for h, v in sl.items(): print(f"      slope {h:12s} = {v:+.3f}  (gardening log-odds per +1 urban fraction)")
    print(f"    pooled no-interaction slope on this subset = "
          f"{sm.GLM(Y(sub)[t], base.values[t], family=Binomial()).fit().params[1]:+.3f}")

print("\n=== 7.3 predicted gardening share of invaded records (adjusted model, set A) ===")
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    cov = COV5+[f"cropland.2009.{UT.split('.')[-1]}"]
    t = inv.values
    m = sm.GLM(Y(n)[t], design(n, UT, cov).values[t], family=Binomial()).fit()
    b = m.params[1]
    grid = np.percentile(n[UT], [10,25,50,75,90,99])
    # marginal predicted share holding covariates at their means, urban at grid values
    Xm = design(n, UT, cov); mean_row = Xm.mean()
    print(f"\n  {UT}: 10/25/50/75/90/99th pct = {np.round(grid,3)}")
    out = []
    for q, g_ in zip([10,25,50,75,90,99], grid):
        x = mean_row.copy(); x[UT] = g_
        p = 1/(1+np.exp(-(x.values@m.params)))
        out.append(f"p{q}({g_:.2f})={100*p:.1f}%")
    print("    predicted P(a record is Gardening) = " + "  ".join(out))

print("\n=== 7.4 AgriForest: descriptive only (23 records / 21 plots) ===")
n["urban_bin"] = pd.cut(n["urban.2009.500m"], [-.001,0,.05,.2,.5,1.0],
                        labels=["0","0-5%","5-20%","20-50%",">50%"])
desc = n.groupby("urban_bin", observed=True).agg(plots=("habitat","size"), gard=("n.gard","sum"),
        unint=("n.unint","sum"), agfo=("n.agfo","sum"), total=("n.total","sum"))
desc["gard_share_%"] = (100*desc.gard/(desc.gard+desc.unint)).round(1)
desc["unint_share_%"] = (100*desc.unint/(desc.gard+desc.unint)).round(1)
print(desc.to_string())
print("\n  same table excluding Urban-habitat plots:")
d2 = n[n.habitat!="Urban"].groupby("urban_bin", observed=True).agg(plots=("habitat","size"),
        gard=("n.gard","sum"), unint=("n.unint","sum"), agfo=("n.agfo","sum"))
d2["gard_share_%"] = (100*d2.gard/(d2.gard+d2.unint)).round(1)
print(d2.to_string())

print("\n=== 7.5 descriptive cross-check of the DOCUMENTED change categories (NOT modelled) ===")
for w in ["1956.2009","1993.2009"]:
    n["cat"] = n[[f"progressive.{w}.50m", f"regressive.{w}.50m", f"no.changes.{w}.50m"]].idxmax(axis=1)
    tab = n[n.cat!="no.changes.50m"].groupby("cat").agg(plots=("cat","size"), gard=("n.gard","sum"),
            unint=("n.unint","sum"), mean_delta_urban_50m=("delta_urban_1956_2009.50m","mean"))
    tab["unint_share_%"] = (100*tab.unint/(tab.gard+tab.unint)).round(1)
    print(f"  window {w}:"); print(tab.round(3).to_string())
    print("    CAVEAT: 'regressive' plots have the HIGHEST mean delta-urban, i.e. the label is")
    print("    inconsistent with the data (flag 8); these categories were never entered in a model.")
