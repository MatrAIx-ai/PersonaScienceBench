"""STEP 8 - consolidated results table for the write-up (quasi-binomial SEs, pathway-specific
NB2 with the delta term, and the estimable habitat slopes)."""
import sys, json, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from statsmodels.discrete.count_model import NegativeBinomialP
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250)
n = add_deltas(load_plot())
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
inv = ((n["n.gard"]+n["n.unint"]) > 0).values
R = []
def qb(UT, cov, sub=n, label=""):
    t = (sub["n.gard"]+sub["n.unint"]).values > 0
    X = design(sub, UT, cov).values[t]
    y = np.column_stack([sub["n.gard"].values[t].astype(float), sub["n.unint"].values[t].astype(float)])
    m = sm.GLM(y, X, family=Binomial()).fit()
    phi = m.pearson_chi2/m.df_resid
    b = m.params[1]; se = m.bse[1]*np.sqrt(max(phi,1.0)); dof = m.df_resid
    p = 2*st.t.sf(abs(b/se), dof)
    return dict(model="binomial " + label, urban_term=UT, n_obs=int(t.sum()), beta=b, se=se, phi=phi,
                p=p, OR10=np.exp(0.1*b), ORlo=np.exp(0.1*(b-1.96*se)), ORhi=np.exp(0.1*(b+1.96*se)))
for UT in ["urban.2009.500m","delta_urban_1993_2009.500m"]:
    R.append(qb(UT, COV5+[f"cropland.2009.{UT.split('.')[-1]}"], n, "FULL n=632"))
    R.append(qb(UT, COV5+[f"cropland.2009.{UT.split('.')[-1]}"], n[n.habitat!="Urban"], "excl-Urban n=567"))
    R.append(qb(UT, [], n, "FULL, urban only"))
    R.append(qb(UT, ["habitat"], n, "FULL, habitat-strata adj"))
    # pathway-specific NB2
    for pw in ["n.total","n.gard","n.unint","n.agfo"]:
        X = design(n, UT, COV5).values; y = n[pw].values.astype(float)
        m = NegativeBinomialP(y, X, p=2).fit(method="newton", maxiter=400, disp=False)
        b, se = m.params[1], m.bse[1]
        R.append(dict(model=f"NB2 {pw}", urban_term=UT, n_obs=len(n), beta=b, se=se, phi=m.params[-1],
                      p=m.pvalues[1], OR10=np.exp(0.1*b), ORlo=np.exp(0.1*(b-1.96*se)), ORhi=np.exp(0.1*(b+1.96*se))))
T = pd.DataFrame(R)
print(T.round(4).to_string(index=False))
T.to_csv("analysis/step8_consolidated.csv", index=False)

print("\n=== observed pathway composition by urban.2009.500m (raw, for the write-up) ===")
b_ = pd.cut(n["urban.2009.500m"], [-.001,.001,.05,.20,1.0], labels=["0%","0-5%","5-20%",">20%"])
g = n.groupby(b_, observed=True).agg(plots=("habitat","size"), gard=("n.gard","sum"),
        unint=("n.unint","sum"), agfo=("n.agfo","sum"))
g["total_records"] = g.gard+g.unint+g.agfo
g["unint_%_of_records"] = (100*g.unint/(g.gard+g.unint)).round(1)
g["gard_%_of_records"] = (100*g.gard/(g.gard+g.unint)).round(1)
g["records_per_plot"] = (g.total_records/g.plots).round(3)
print(g.to_string())
print("\n=== same by delta_urban_1993_2009.500m (expansion) ===")
b2 = pd.cut(n["delta_urban_1993_2009.500m"], [-1,-.001,.001,.05,1.0], labels=["shrunk","stable","0-5pp",">5pp"])
g2 = n.groupby(b2, observed=True).agg(plots=("habitat","size"), gard=("n.gard","sum"), unint=("n.unint","sum"),
                                      agfo=("n.agfo","sum"))
g2["unint_%_of_records"] = (100*g2.unint/(g2.gard+g2.unint)).round(1)
g2["records_per_plot"] = ((g2.gard+g2.unint+g2.agfo)/g2.plots).round(3)
print(g2.to_string())
