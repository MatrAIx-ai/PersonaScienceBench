"""STEP 9 - (a) single-df habitat-context interaction (cropland vs rest),
(b) VIF in the FINAL model, (c) is the effect specific to URBAN change or any land-cover change?
(d) nonparametric bootstrap CI for the headline coefficient."""
import sys, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from statsmodels.stats.outliers_influence import variance_inflation_factor
from scipy import stats as st
sys.path.insert(0, "analysis")
from common import load_plot, add_deltas, design
pd.set_option("display.width", 250)
n = add_deltas(load_plot())
for e, s_ in (("2009","1993"),):
    for b in ("500m",):
        n[f"delta_cropland_{s_}_{e}.{b}"] = n[f"cropland.{e}.{b}"]-n[f"cropland.{s_}.{b}"]
COV5 = ["elevation","annual.temperature","annual.rainfall","log_road","log_stream"]
Y = np.column_stack([n["n.gard"].values.astype(float), n["n.unint"].values.astype(float)])
t = ((n["n.gard"]+n["n.unint"]) > 0).values
UT = "delta_urban_1993_2009.500m"

print("=== (a) habitat context as ONE df: cropland vs all other habitats ===")
n["is_crop_hab"] = (n.habitat=="Croplands").astype(float)
base = design(n, UT, COV5+["cropland.2009.500m"])
full = pd.concat([base, (n.is_crop_hab*n[UT]).rename("cropXdelta")], axis=1)
m0 = sm.GLM(Y[t], base.values[t], family=Binomial()).fit()
m1 = sm.GLM(Y[t], full.values[t], family=Binomial()).fit()
lr = 2*(m1.llf-m0.llf); nm = list(full.columns)
phi = m1.pearson_chi2/m1.df_resid
print(f"  interaction LRT = {lr:.2f} on 1 df, p = {st.chi2.sf(lr,1):.4f}")
print(f"  slope in non-cropland plots = {m1.params[nm.index(UT)]:+.3f} (se {m1.bse[nm.index(UT)]:.3f})")
print(f"  slope in Croplands habitat  = {m1.params[nm.index(UT)]+m1.params[nm.index('cropXdelta')]:+.3f}")
print(f"  main effect (non-crop) quasi-se = {m1.bse[nm.index(UT)]*np.sqrt(max(phi,1)):.3f}, "
      f"p = {2*st.t.sf(abs(m1.params[nm.index(UT)])/(m1.bse[nm.index(UT)]*np.sqrt(max(phi,1))), m1.df_resid):.4f}")

print("\n=== (b) VIF in the FINAL compositional model ===")
X = design(n, UT, COV5+["cropland.2009.500m"]).values[t]
names = list(design(n, UT, COV5+["cropland.2009.500m"]).columns)
Xs = (X - X.mean(0))/np.where(X.std(0)>0, X.std(0), 1)
for nm_, v in zip(names, [variance_inflation_factor(Xs, i) for i in range(X.shape[1])]):
    print(f"    {nm_:32s} VIF = {v:6.2f}")

print("\n=== (c) specificity: urban change vs cropland change (both entered) ===")
for extra in [[], ["delta_cropland_1993_2009.500m"], ["cropland.2009.500m"],
              ["delta_cropland_1993_2009.500m","delta_urban_1993_2009.1000m"]]:
    cov = COV5+extra
    Xd = design(n, UT, cov); nmz = list(Xd.columns)
    m = sm.GLM(Y[t], Xd.values[t], family=Binomial()).fit()
    txt = "  ".join(f"{c}={m.params[i]:+.3f}(p={m.pvalues[i]:.3f})" for i,c in enumerate(nmz)
                    if c.startswith("delta") or c=="cropland.2009.500m")
    print(f"  with {str(extra):55s}: {txt}")

print("\n=== (d) nonparametric bootstrap (1000 plot resamples, cov set A) ===")
rng = np.random.default_rng(3); X0 = design(n, UT, COV5+["cropland.2009.500m"]).values
boot = []
for i in range(1000):
    idx = rng.integers(0, len(n), len(n))
    nb = n.iloc[idx]
    tt = ((nb["n.gard"]+nb["n.unint"]) > 0).values
    if tt.sum() < 30: continue
    try:
        m = sm.GLM(Y[idx][tt], X0[idx][tt], family=Binomial()).fit(maxiter=200)
        boot.append(m.params[1])
    except Exception: pass
boot = np.array(boot)
print(f"  delta beta = -2.771; bootstrap median {np.median(boot):+.3f}, "
      f"95% percentile CI [{np.percentile(boot,2.5):+.3f}, {np.percentile(boot,97.5):+.3f}], "
      f"P(beta<0) = {(boot<0).mean():.3f}, n_boot={len(boot)}")
print(f"  implied OR per +10pp urban expansion: {np.exp(0.1*np.median(boot)):.3f} "
      f"[{np.exp(0.1*np.percentile(boot,2.5)):.3f}, {np.exp(0.1*np.percentile(boot,97.5)):.3f}]")
for pw, lab in [("n.unint","NB2 n.unint"), ("n.gard","NB2 n.gard")]:
    from statsmodels.discrete.count_model import NegativeBinomialP
    Xp = design(n, UT, COV5).values; y = n[pw].values.astype(float); bb=[]
    for i in range(600):
        idx = rng.integers(0, len(n), len(n))
        try:
            m = NegativeBinomialP(y[idx], Xp[idx], p=2).fit(method="newton", maxiter=200, disp=False)
            bb.append(m.params[1])
        except Exception: pass
    bb=np.array(bb)
    print(f"  {lab}: beta={np.median(bb):+.3f} boot 95% CI [{np.percentile(bb,2.5):+.3f},{np.percentile(bb,97.5):+.3f}]"
          f"  IRR/10pp={np.exp(0.1*np.median(bb)):.3f} [{np.exp(0.1*np.percentile(bb,2.5)):.3f},{np.exp(0.1*np.percentile(bb,97.5)):.3f}]")
