def to_long(df):
    rows=[]
    for p in PATH:
        t=df[[c for c in KEEP if c in df.columns]+["n.total"]].copy()
        t["pathway"]=p; t["count"]=df[COL[p]].values; rows.append(t)
    L=pd.concat(rows,ignore_index=True)
    L["pathway"]=pd.Categorical(L["pathway"],categories=PATH)
    L["offset"]=np.log(L["n.total"]); return L

def prep(df,col):
    d=df.copy(); d[URB]=d[col]*10.0; return d      # 1 unit = 10 percentage points cover

def fit_mp(df,rhs,family="quasi"):
    L=to_long(df); form="count ~ "+rhs
    if family=="nb":
        best=None
        for a in (0.25,0.5,1.0,2.0,4.0):
            r=smf.glm(form,L,family=sm.families.NegativeBinomial(alpha=a),offset=L["offset"]).fit()
            if best is None or r.llf>best[0]: best=(r.llf,a,r)
        return best[2],best[1]
    m=smf.glm(form,L,family=sm.families.Poisson(),offset=L["offset"])
    return m.fit(scale="X2") if family=="quasi" else m.fit(cov_type="HC1")

def slope_table(res,pred,ref="Unintentional"):
    """pathway-specific slope of `pred` + 95% CI via explicit contrast vectors."""
    names=list(res.params.index); k=len(names); V=res.cov_params().values
    p_i=names.index(pred)
    import re as _re
    inter={}
    for n in names:
        m=_re.fullmatch(r"C\(pathway\)\[T\.(.+)\]:"+_re.escape(pred), n)
        if m: inter[m.group(1)]=names.index(n)
    rows=[]
    for p in [ref]+[q for q in PATH if q!=ref]:
        v=np.zeros(k); v[p_i]=1
        if p!=ref: v[inter[p]]=1
        b=float(v@res.params.values); se=float(np.sqrt(v@V@v))
        rows.append({"pathway":p,"beta":b,"se":se,"lo":b-1.96*se,"hi":b+1.96*se,
                     "p":2*norm.cdf(-abs(b/se))})
    t=pd.DataFrame(rows).set_index("pathway")
    R=np.zeros((len(inter),k))
    for j,(p,i) in enumerate(sorted(inter.items())): R[j,i]=1
    f=res.f_test(R); return t,float(f.fvalue),float(f.pvalue)

def pred_shares(res,df,grid):
    acc={}
    for g in grid:
        dd=df.copy(); dd[URB]=g
        L=to_long(dd); L["pr"]=np.asarray(res.predict(L))
        s=L.groupby("pathway")["pr"].sum(); acc[g]=(s/s.sum()).to_dict()
    return pd.DataFrame(acc).T

def wilson(k,n,z=1.96):
    p=k/n; d=1+z*z/n; c=(p+z*z/(2*n))/d; h=z*np.sqrt(p*(1-p)/n+z*z/(4*n*n))/d
    return c-h,c+h
