def pF(groups,strata=None,nperm=999,seed=7):
    rg=np.random.default_rng(seed); g=np.asarray(groups)
    def stat(gg):
        a=len(np.unique(gg)); N=len(gg); ssw=0.0
        for lev in np.unique(gg):
            i=np.where(gg==lev)[0]
            if len(i)>1: ssw+=D2[np.ix_(i,i)].sum()/(2*len(i))
        sst=D2.sum()/N
        return ((sst-ssw)/(a-1))/(ssw/(N-a)) if N>a and ssw>0 else np.nan
    obs=stat(g); cnt=0
