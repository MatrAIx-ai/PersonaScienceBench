import re as _re
def parse_newick(txt):
    toks=[m.group(0).strip() for m in _re.finditer(r"[(),;:]|[^(),;:]+", txt)]
    pos=[0]
    def node():
        name=None; bl=None; kids=[]
        if toks[pos[0]]=="(":
            pos[0]+=1
            kids.append(node())
            while toks[pos[0]]==",":
                pos[0]+=1; kids.append(node())
            assert toks[pos[0]]==")"; pos[0]+=1
        while pos[0]<len(toks) and toks[pos[0]]=="" : pos[0]+=1
        if pos[0]<len(toks) and toks[pos[0]] not in ("(",")",",",";",":"):
            name=toks[pos[0]]; pos[0]+=1
        if pos[0]<len(toks) and toks[pos[0]]==":":
            pos[0]+=1; bl=float(toks[pos[0]]); pos[0]+=1
        return {"name":name,"bl":bl,"kids":kids}
    root=node(); return root

try:
    root=parse_newick(open(D+"phylogenetic_tree.txt").read().strip())
    parent={}; edge={}; tips=[]
    def walk(nd,par):
        parent[id(nd)]=par
        if nd["kids"]:
            for k in nd["kids"]: walk(k,nd)
        else: tips.append(nd)
    walk(root,None)
    idx={id(t):j for j,t in enumerate(tips)}
    tipname={id(t):(t["name"] or "") for t in tips}
    dep={}
    def depth(nd):
        if id(nd) in dep: return dep[id(nd)]
        p=parent[id(nd)]
        dep[id(nd)]=(0.0 if p is None else depth(p)+(nd["bl"] or 0.0))
        return dep[id(nd)]
    anc={id(t):set() for t in tips}
    for t in tips:
        p=parent[id(t)]
        while p is not None: anc[id(t)].add(id(p)); p=parent[id(p)]
    n=len(tips); L=np.zeros((n,n))
    for a in range(n):
        for b in range(a+1,n):
            ta,tb=tips[a],tips[b]
            # patristic = depth(a)+depth(b)-2*depth(mrca); compute mrca by ancestor walk
            pa=parent[id(ta)]; common=0.0
            da=depth(ta); db=depth(tb)
            # walk up from ta, find deepest node that is ancestor of tb
            cur=ta; md=-1
            while cur is not None:
                if cur is root or id(cur) in anc[id(tb)]:
                    md=depth(cur); break
                cur=parent[id(cur)]
            L[a,b]=L[b,a]=da+db-2*max(md,0.0)
    names=np.array([tipname[id(t)] for t in tips])
    spd=sp[~sp["duplicated"]].reset_index(drop=True)
    keep=[i for i,nm in enumerate(names) if nm in set(spd["phylo.tip.label"])]
    print(f"  tree parsed: tips={n} (branch lengths present on {sum(1 for t in tips if t['bl'])}/{n}); "
          f"species used after de-duplication={len(keep)} of {len(names)}")
    lab=spd.set_index("phylo.tip.label")["intro.pathway"]
    y=np.array([lab[names[i]] for i in keep])
    Dk=L[np.ix_(keep,keep)]**2
    N=len(keep)
    def pf(gg,D2=Dk):
        a=len(np.unique(gg)); ssw=0.0
        for lev in np.unique(gg):
            j=np.where(gg==lev)[0]
            if len(j)>1: ssw+=D2[np.ix_(j,j)].sum()/(2*len(j))
        sst=D2.sum()/N
        return ((sst-ssw)/(a-1))/(ssw/(N-a)) if ssw>0 else np.nan
    obs=pf(y); rg=np.random.default_rng(11)
    cnt=sum(1 for _ in range(999) if pf(y[rg.permutation(N)])>=obs-1e-12)
    say(f"  phylogenetic clustering of intro.pathway (77 species, patristic PERMANOVA): "
        f"pseudo-F={obs:.2f} permutation p={(cnt+1)/1000:.3f}")
    say(f"  pathway sizes used: "+str(pd.Series(y).value_counts().to_dict()))
    say("  INTERPRETATION: this only says whether pathway is phylogenetically conservative;")
    say("  it says NOTHING about urban land use and is not used in the answer.")
