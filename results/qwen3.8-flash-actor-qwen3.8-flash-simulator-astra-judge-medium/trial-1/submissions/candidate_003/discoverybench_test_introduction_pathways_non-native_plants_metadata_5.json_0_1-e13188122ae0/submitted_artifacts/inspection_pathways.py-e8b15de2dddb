"""Stage-1 inspection only (no inferential analysis of the research question)."""
import re
import numpy as np, pandas as pd

D = "/workspace/data/"
ct = pd.read_csv(D+"temporal_trends_contingency_table.csv", sep="\t")
sp = pd.read_csv(D+"invasion_success_pathways.csv")
pl = pd.read_csv(D+"invaded_niche_pathways.csv", sep="\t")
print("contingency", ct.shape, "| success", sp.shape, "| niche", pl.shape)

piv = ct.pivot(index="introduction.period", columns="pathway", values="n")
print(piv.to_string(), "\n", (piv.div(piv.sum(1), 0)).round(3).to_string())

print("pathway counts:\n", sp["intro.pathway"].value_counts().to_string())
print("duplicated:\n", sp["duplicated"].value_counts().to_string())
print("species after dedup:", (~sp["duplicated"]).sum())
print("cols in success with landscape info:",
      [c for c in sp.columns if any(k in c.lower() for k in ("urban", "crop", "buffer", "elevation", "distance", "latitude"))])

print("niche NA:", int(pl["n.total"].isna().sum().sum()), "| plots:", len(pl),
      "| unique lon/lat:", pl[["longitude", "latitude"]].drop_duplicates().shape[0])
print("plots with n.total>0:", int((pl["n.total"] > 0).sum()),
      "| n.gard>0:", int((pl["n.gard"] > 0).sum()),
      "| n.unint>0:", int((pl["n.unint"] > 0).sum()),
      "| n.agfo>0:", int((pl["n.agfo"] > 0).sum()))
print("sum pathway == n.total:", ((pl["n.gard"]+pl["n.unint"]+pl["n.agfo"]) == pl["n.total"]).mean())
ub = [c for c in pl.columns if c.startswith("urban")]
print("urban zero fraction:\n", (pl[ub] == 0).mean().round(3).to_string())

s = open(D+"phylogenetic_tree.txt").read().strip()
tips, bls = [], []
for m in re.finditer(r"([^(),:]*):([0-9.eE+-]+)", s):
    st = m.start(1); prev = s[st-1] if st else ""
    if prev != ")" and m.group(1).strip():
        tips.append(m.group(1).strip())
    bls.append(float(m.group(2)))
lab = set(sp["phylo.tip.label"])
print("tree tips:", len(tips), "| matched:", len(lab & set(tips)),
      "| data-not-tree:", sorted(lab - set(tips)), "| tree-not-data:", sorted(set(tips) - lab))
print("branch lengths:", len(bls), "min", min(bls), "max", max(bls), "all>0:", all(b > 0 for b in bls))

chg = ["progressive.1956.2009.50m", "regressive.1956.2009.50m", "no.changes.1956.2009.50m"]
du = pl["urban.2009.50m"] - pl["urban.1956.50m"]
bu = pd.cut(du, [-1.1, -.05, .05, 1.1], labels=["urban_dec", "urban_stable", "urban_inc"])
print("change cols x urban trend (mean):\n", pl.groupby(bu, observed=True)[chg].mean().round(3).to_string())
