def contrast_table(model, note):
    """Manual contrast vectors: group means are Cognitive=b0, Social=b0+b1, Economics=b0+b2."""
    p = list(model.params.index)
    iS = p.index([c for c in p if c.endswith("[T.Social]")][0])
    iE = p.index([c for c in p if c.endswith("[T.Economics]")][0])
    R = {"Cognitive - Social": (iS, -1.0, 0.0), "Cognitive - Economics": (iE, -1.0, 0.0),
         "Social - Economics": (None, 1.0, -1.0)}
    rows_raw, rows = [], []
    for h, (idx, cs, ce) in R.items():
        r = np.zeros(len(p))
        if idx is not None:
            r[idx] = cs
        else:
            r[iS] = cs; r[iE] = ce
        t = model.t_test(r)
        rows_raw.append((h, float(np.ravel(t.effect)[0]), float(np.ravel(t.sd)[0]), float(t.pvalue)))
    raw = np.array([x[3] for x in rows_raw])
    adj = np.empty_like(raw); run = 0.0
    for rank, i in enumerate(np.argsort(raw)):
        run = max(run, min(1.0, (len(raw) - rank) * raw[i])); adj[i] = run
    for i, (h, est, se, pv) in enumerate(rows_raw):
        rows.append({"model": note, "contrast": h, "diff": f"{est:.3f}", "se": f"{se:.3f}",
                     "95%CI": f"[{est-1.96*se:.3f}, {est+1.96*se:.3f}]",
                     "p raw": f"{pv:.4f}", "p Holm": f"{adj[i]:.4f}"})
    return pd.DataFrame(rows)

