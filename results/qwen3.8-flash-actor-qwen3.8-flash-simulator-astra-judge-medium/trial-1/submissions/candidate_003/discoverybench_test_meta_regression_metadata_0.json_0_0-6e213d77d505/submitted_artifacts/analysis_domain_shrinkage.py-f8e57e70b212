def boot_median_diff(a, b, stat=np.median):
    a = np.asarray(a, float); b = np.asarray(b, float)
    ia = rng.integers(0, len(a), size=(NBOOT, len(a))); ib = rng.integers(0, len(b), size=(NBOOT, len(b)))
    s = stat(a[ia], axis=1) - stat(b[ib], axis=1)
    return np.percentile(s, [2.5, 97.5])
