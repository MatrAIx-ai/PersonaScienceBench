          "| mean |rr|/|ro|:", {d: round(float(v), 3) for d, v in g.rel_es_abs.mean().items()})
    names = list(g.groups.keys())
    for a, b in [(x, y) for i, x in enumerate(names) for y in names[i + 1:]]:
        u1 = stats.mannwhitneyu(sub.loc[sub.domain == a, "d_fisher"], sub.loc[sub.domain == b, "d_fisher"])
        u2 = stats.mannwhitneyu(sub.loc[sub.domain == a, "rel_es_abs"], sub.loc[sub.domain == b, "rel_es_abs"])
        print(f"      MW {a:9s} vs {b:9s}: d_fisher p={u1.pvalue:.3f} | |rr|/|ro| p={u2.pvalue:.4f}")

print("\nTABLE F4. Consistency of the two readings (absolute vs relative), compact summary")
summ = df.groupby("domain", observed=True).agg(n=("d_fisher", "size"), mean_d=("d_fisher", "mean"),
        median_d=("d_fisher", "median"), share_d_gt0=("d_gt0", "mean"), median_ret=("rel_es_abs", "median"),
        mean_ret=("rel_es_abs", "mean"), weighted_d=("d_fisher", lambda s: float(np.average(s, weights=df.w_prec[s.index]))),
        replicated=("replicated", "mean"))
summ["rank_by_mean_d"] = summ.mean_d.rank(ascending=False).astype(int)
summ["rank_by_median_d"] = summ.median_d.rank(ascending=False).astype(int)
summ["rank_by_retention"] = summ.median_ret.rank().astype(int)  # 1 = strongest shrinkage
print(summ.round(3).to_string())

print("\nTABLE F5. Elasticity model sensitivity to near-zero |rr| (log model is sensitive there)")
for lbl, sub in [("all 86", df), ("rr>0 only", df[df.rr > 0]), ("|rr|>=0.02", df[df.rr.abs() >= 0.02]),
                 ("ro>=0.30", df[df.ro >= 0.30])]:
    mm = smf.ols("np.log(np.abs(rr)) ~ np.log(ro) + C(domain, Treatment('Cognitive'))", data=sub).fit()
    co = {k.split("[T.")[-1].strip("]"): round(float(v), 3) for k, v in mm.params.items() if "[T." in k}
    pv = {k.split("[T.")[-1].strip("]"): round(float(v), 4) for k, v in mm.pvalues.items() if "[T." in k}
    print(f"  {lbl:10s} n={len(sub):2d} R2={mm.rsquared:.3f} slope_log_ro={float(mm.params['np.log(ro)']):.3f} domain_coefs={co} p={pv}")
print("\n  Compact cross-check: median |rr|/|ro| among sign-preserving pairs (rr>0):",
      df[df.rr > 0].groupby("domain", observed=True).rel_es_abs.median().round(3).to_dict(),
      f"Kruskal p={stats.kruskal(*[g.rel_es_abs.values for _, g in df[df.rr > 0].groupby('domain', observed=True)]).pvalue:.4f}")
