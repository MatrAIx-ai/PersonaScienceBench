"""Domain-level original-vs-replication effect-size shrinkage.

Main metric: unweighted paired Fisher-z difference d = fiso - fisr ("typical study").
Sensitivity layer (mandatory): precision-weighted WLS w = 1/(se_fiso^2 + se_fisr^2).
Relative metrics reported in parallel, never substituted for d.
Tables only (matplotlib unavailable).
"""
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.formula.api as smf

pd.set_option("display.width", 240)
pd.set_option("display.max_columns", 50)
SEED, NBOOT = 20261022, 10_000
PATH = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
DOMAINS = ["Cognitive", "Social", "Economics"]

df = pd.read_csv(PATH)
df["d_fisher"] = df.fiso - df.fisr
df["d_corr"] = df.ro - df.rr
df["abs_d_fisher"] = df.fiso.abs() - df.fisr.abs()
df["rel_es"] = df.rr / df.ro                 # recomputed (published column has 1 sign error)
df["rel_es_abs"] = df.rr.abs() / df.ro.abs()
df["w_prec"] = 1.0 / (df.se_fiso**2 + df.se_fisr**2)
df["log_no"], df["log_nr"] = np.log(df["no"]), np.log(df["nr"])
df["shrank_abs"] = (df.rel_es_abs < 1).astype(int)
df["d_gt0"] = (df.fiso > df.fisr).astype(int)
df["domain"] = pd.Categorical(df.discipline, categories=DOMAINS)
rng = np.random.default_rng(SEED)

def _mean_axis(a, axis=1):
    return a.mean(axis=axis)

def boot_ci(x, stat=np.mean, n=NBOOT):
    x = np.asarray(x, float); x = x[~np.isnan(x)]
    idx = rng.integers(0, len(x), size=(n, len(x)))
    s = stat(x[idx], axis=1)
    return np.percentile(s, 2.5), np.percentile(s, 97.5)
def mean_ci(x):
    lo, hi = boot_ci(x, np.mean); return f"{np.nanmean(x):.3f} [{lo:.3f}, {hi:.3f}]"
def med_ci(x):
    lo, hi = boot_ci(x, np.median); return f"{np.nanmedian(x):.3f} [{lo:.3f}, {hi:.3f}]"
def share_ci(x):
    x = np.asarray(x, float); lo, hi = boot_ci(x, _mean_axis)
    return f"{np.nanmean(x):.3f} [{lo:.3f}, {hi:.3f}]"

def domain_table(data, label):
    rows = []
    for dom, g in data.groupby("domain", observed=True):
        d = g.d_fisher.values
        w2 = stats.wilcoxon(d, alternative="two-sided")
        w1 = stats.wilcoxon(d, alternative="greater", zero_method="wilcox")
        rows.append({"cut": label, "domain": dom, "n": len(g),
            "mean d_fisher [95%CI]": mean_ci(d), "median d_fisher [95%CI]": med_ci(d),
            "Wilcoxon p 2-sided": f"{w2.pvalue:.2e}", "Wilcoxon p d>0": f"{w1.pvalue:.2e}",
            "share d>0 [95%CI]": share_ci(g.d_gt0),
            "mean d_corr [95%CI]": mean_ci(g.d_corr.values), "median d_corr": f"{g.d_corr.median():.3f}",
            "median rr/ro [95%CI]": med_ci(g.rel_es.values),
            "median |rr|/|ro| [95%CI]": med_ci(g.rel_es_abs.values),
            "share |rr|/|ro|<1 [95%CI]": share_ci(g.shrank_abs),
            "share rr same sign": f"{(np.sign(g.rr)==np.sign(g.ro)).mean():.3f}",
            "replicated rate": f"{g.replicated.mean():.3f}",
            "mean ro": f"{g.ro.mean():.3f}", "mean rr": f"{g.rr.mean():.3f}",
            "median no": f"{g['no'].median():.0f}", "median nr": f"{g['nr'].median():.0f}"})
    return pd.DataFrame(rows)

