def holm(pairs):
    names = list(pairs); raw = np.array([pairs[k] for k in names], float)
    adj = np.empty_like(raw); run = 0.0
    for rank, i in enumerate(np.argsort(raw)):
        run = max(run, min(1.0, (len(raw) - rank) * raw[i])); adj[i] = run
    return {names[i]: (raw[i], adj[i]) for i in range(len(names))}

for y, nm in [("d_fisher", "d_fisher"), ("rel_es_abs", "|rr|/|ro|")]:
    pairs = {}
    for a, b in [("Cognitive", "Social"), ("Cognitive", "Economics"), ("Social", "Economics")]:
        u = stats.mannwhitneyu(df.loc[df.domain == a, y], df.loc[df.domain == b, y], alternative="two-sided")
        pairs[f"{a} vs {b}"] = (u.pvalue, float(u.statistic))
    adj = holm({k: v[0] for k, v in pairs.items()})
    print(f"\n  Mann-Whitney on {nm}:")
    for k in pairs:
        print(f"    {k:26s} p raw={adj[k][0]:.4f} p Holm={adj[k][1]:.4f} U={pairs[k][1]:.1f} "
