"""
DIAGNOSIS (no final proportions): heterogeneity-in-replication-projects data.
Q (to be answered later): proportion of junior professors in replicated studies in Psychology.
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 220); pd.set_option('display.max_columns', 100); pd.set_option('display.max_colwidth', 90)

S = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
R = pd.read_csv('data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')

print("#"*30, "1) LOAD / SHAPES", "#"*30)
print("study data shape:", S.shape, "| success data shape:", R.shape)
print("\nstudy dtypes:\n", S.dtypes.to_string())
print("\nfirst 3 rows (subset):\n", S[['id','title','pub_year','project','replicated','seniority.o','seniority.r']].head(3).to_string())
print("\nsuccess first rows:\n", R.head(3).to_string())
print("\nrows per project (study data):\n", S['project'].value_counts(dropna=False).to_string())
print("\nreplicated by project (n / k(replicated==1) / rate):\n",
      S.groupby('project')['replicated'].agg(n='size', k=lambda x:(x==1).sum(), nan=lambda x:x.isna().sum(), rate=lambda x:(x==1).mean()).to_string())
print("\nproject labels in success data:\n", R['project'].value_counts().to_string())
print("=> 'Psychology' in success file vs 'rpp' in study file; project code doc: ml1/ml3/rpp/ee. rpp discipline split:")
print(pd.crosstab(S.project, S.discipline).to_string())

print("\n"+"#"*30, "2) SENIORITY VALUES", "#"*30)
for c in ['seniority.o','seniority.r']:
    vc = S[c].value_counts(dropna=False)
    print(f"\n{c} (all 927 rows, incl NaN):\n{vc.to_string()}")
    v = S[c].dropna()
    print(f"  whitespace-padded: {(v!=v.str.strip()).sum()} | case variants vs Title: {(v!=v.str.title()).sum()} | raw uniques: {sorted(v.unique())}")
rpp = S[S.project=='rpp'].copy(); r1 = rpp[rpp.replicated==1].copy()
print(f"\nrpp rows={len(rpp)}; missing seniority.o={rpp['seniority.o'].isna().sum()}, seniority.r={rpp['seniority.r'].isna().sum()}")
print(f"rpp & replicated==1 rows={len(r1)}; missing seniority.o={r1['seniority.o'].isna().sum()}, seniority.r={r1['seniority.r'].isna().sum()}")
print("\nseniority.o | rpp:\n", rpp['seniority.o'].value_counts(dropna=False).to_string())
print("\nseniority.r | rpp:\n", rpp['seniority.r'].value_counts(dropna=False).to_string())
print("\nseniority.o | rpp & replicated==1:\n", r1['seniority.o'].value_counts(dropna=False).to_string())
print("\nseniority.r | rpp & replicated==1:\n", r1['seniority.r'].value_counts(dropna=False).to_string())

print("\n-- seniority.r semantics check (json says 'original paper' -> suspected copy-paste bug) --")
both = S.dropna(subset=['seniority.o','seniority.r'])
print("P(seniority.o == seniority.r) overall:", round((both['seniority.o']==both['seniority.r']).mean(),3))
print("crosstab o x r:\n", pd.crosstab(both['seniority.o'], both['seniority.r']).to_string())
t = rpp.dropna(subset=['seniority.r'])
print("\nrpp: means of author-citation vars grouped by seniority.r:\n",
      t.groupby('seniority.r')[['author_citations_avg.r','author_citations_max.r','n_authors.r','author_citations_avg.o','author_citations_max.o']].mean().round(1).to_string())
print("\nsample rpp rows where o != r (author names are ORIGINALs; seniority.r varies against r-side citations):\n",
      t.loc[t['seniority.o']!=t['seniority.r'], ['id','authors.o','seniority.o','seniority.r','author_citations_max.o','author_citations_max.r']].head(5).to_string())

print("\n"+"#"*30, "3) JOIN KEYS", "#"*30)
print("success columns:", list(R.columns), "-> no id/authors/full-title fields.")
print("R duplicated (study,project):", R.duplicated(['study','project']).sum(), "(one 'P Bressan, D Stranieri' pair with two nr values)")
rpsy = R[R.project=='Psychology'].copy()
def o_sn(a): return set(p.strip().split()[-1].lower() for p in str(a).split(' and ') if p.strip())
def s_sn(a): return set(t.strip().split()[-1].lower() for t in str(a).split(',') if t.strip())
rpp2 = rpp.copy(); rpp2['so']=rpp2['authors.o'].map(o_sn); rpsy['ss']=rpsy['study'].map(s_sn)
n_c = [ (rpp2.so.map(lambda s: bool(s & ss))).sum() for ss in rpsy.ss ]
print(f"surname-overlap join: {sum(np.array(n_c)>=1)}/{len(rpsy)} rows have >=1 candidate; {sum(np.array(n_c)>1)} rows are AMBIGUOUS (co-author overlap), avg {np.mean(n_c):.2f} candidates.")
# effect-size fingerprint join (exact values shared across files)
rpp2['key']=list(zip(rpp2['effect_size.o'].round(5), rpp2['effect_size.r'].round(5)))
rpsy['key']=list(zip(rpsy['ro'].round(5), rpsy['rr'].round(5)))
valid = rpp2.dropna(subset=['effect_size.o','effect_size.r'])
print(f"rpp rows with NaN ES pair (must be excluded from key-join): {len(rpp2)-len(valid)} (rpp.59, rpp.69 -> fake NaN-key duplicates)")
m = rpsy.merge(valid[['id','key','replicated','seniority.o','seniority.r']], on='key', how='left', indicator=True)
print(f"ES-fingerprint join: matched {int((m._merge=='both').sum())}/{len(rpsy)} success rows; unique rpp ids matched: {m.loc[m._merge=='both','id'].nunique()}")
print("unmatched success rows:", m.loc[m._merge=='left_only','study'].tolist())
print("hanging study-side rpp rows: 97 - matched (success file covers only a subset of the 97 rpp studies)")
b = m[m._merge=='both'].copy()
b['rule'] = ((b['pr']<=0.05) & (np.sign(b['rr'])==np.sign(b['ro']))).astype(int)
print("sanity: replicated == (pr<=.05 & same sign) on matched rows:", round((b['replicated']==b['rule']).mean(),3))

print("\n"+"#"*30, "4) DISTRIBUTIONS FOR PLANNED VARIANTS (counts only)","#"*30)
base = r1  # rpp & replicated==1, n=35
for col in ['seniority.o','seniority.r']:
    print(f"\nfocal set = rpp & replicated==1 (n={len(base)}), column={col}:\n", base[col].value_counts(dropna=False).to_string())
print("\n('Assistant'/'Assistant Professor'/'Associate Professor' counts visible above; proportions deliberately NOT computed here.)")
