"""
FINAL ANALYSIS (approved scope):
Q: Proportion of junior professors in replicated studies in Psychology (RPP).
Primary: study file, project=='rpp', replicated==1, column seniority.r,
junior def B = {Assistant Professor, Assistant}. Success file only for cross-validation denominator (ii).
"""
import pandas as pd, numpy as np
from scipy.stats import beta
pd.set_option('display.width', 220); pd.set_option('display.max_colwidth', 60)

S = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
R = pd.read_csv('data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')
rpp = S[S.project=='rpp'].copy()
focal = rpp[rpp.replicated==1].copy()          # n=35
print(f"fact: project=='rpp' rows={len(rpp)}; focal rpp&replicated==1 rows={len(focal)}")
print(f"missing seniority.r: focal={focal['seniority.r'].isna().sum()}/{len(focal)} (=0), all rpp={rpp['seniority.r'].isna().sum()}/{len(rpp)}")
assert focal['seniority.r'].notna().all() and rpp['seniority.r'].notna().all()

# ---- distributions side by side ----
dist = pd.concat({
    'rpp all (97)': rpp['seniority.r'].value_counts(),
    'rpp replicated==1 (35)': focal['seniority.r'].value_counts()}, axis=1).fillna(0).astype(int)
order = ['Professor','Associate Professor','Assistant Professor','Assistant','Researcher']
dist = dist.reindex(order)
dist[('share %','rpp all (97)')] = (100*dist['rpp all (97)']/97).round(1)
dist[('share %','rpp replicated==1 (35)')] = (100*dist['rpp replicated==1 (35)']/35).round(1)
print("\nDistribution seniority.r:\n", dist.to_string())

# ---- Clopper-Pearson ----
def cp(k, n, a=0.05):
    lo = 0.0 if k==0 else beta.ppf(a/2, k, n-k+1)
    hi = 1.0 if k==n else beta.ppf(1-a/2, k+1, n-k)
    return lo, hi

DEFS = {'A: {Assistant Professor}': {'Assistant Professor'},
        'B: {Assistant, Assistant Professor}': {'Assistant','Assistant Professor'},
        'C: {+ Associate Professor}': {'Assistant','Assistant Professor','Associate Professor'}}

# ---- matched denominator (ii): cross-validation via success file ----
rpsy = R[R.project=='Psychology'].copy()
rppk = rpp.copy()
rppk['key'] = list(zip(rppk['effect_size.o'].round(5), rppk['effect_size.r'].round(5)))
rpsy['key'] = list(zip(rpsy['ro'].round(5), rpsy['rr'].round(5)))
valid = rppk.dropna(subset=['effect_size.o','effect_size.r'])
m = rpsy.merge(valid[['id','key']], on='key', how='inner')
matched_ids = set(m['id'])
# fuzzy fallback for unmatched rows: surname check + |ES| proximity (sign-tolerant)
def o_sn(a): return set(p.strip().split()[-1].lower() for p in str(a).split(' and ') if p.strip())
def s_sn(a): return set(t.strip().split()[-1].lower() for t in str(a).split(',') if t.strip())
un = rpsy[~rpsy.study.index.isin(m.index if False else [])] # placeholder
un = rpsy.loc[~rpsy['id'].notna()] if 'id' in rpsy else rpsy[~rpsy.study.isin(rpsy.loc[rpsy['key'].isin(set(m['key'])),'study'])]
fuzzy_log = []
for _,row in un.iterrows():
    ss = s_sn(row['study']); cand = rpp[rpp['authors.o'].map(lambda a: bool(o_sn(a) & ss))].copy()
    if cand.empty: fuzzy_log.append((row['study'],'no surname candidate','')); continue
    d = np.hypot(cand['effect_size.o'].abs()-abs(row['ro']), cand['effect_size.r'].abs()-abs(row['rr']))
    i = d.idxmin()
    if d[i] < 0.02: matched_ids.add(cand.loc[i,'id']); fuzzy_log.append((row['study'], cand.loc[i,'id'], round(d[i],4)))
    else: fuzzy_log.append((row['study'],'NOT matched', round(d[i],4)))
print("\nFuzzy fallback for", len(un), "unmatched success rows:")
for f in fuzzy_log: print("  ", f)
matched = rpp[rpp.id.isin(matched_ids)].copy()
matched1 = matched[matched.replicated==1].copy()
print(f"\nDenominator (ii): matched rpp rows={len(matched)} (of 97), of which replicated==1: n={len(matched1)}")

# ---- denominators ----
DEN = {'D1 primary: rpp & replicated==1 (study file)': focal,
       'D2 xval: matched rpp & replicated==1': matched1,
       'D3 other reading: all rpp studies (97)': rpp}

rows = []
for dname, dd in DEN.items():
    for kname, cat in DEFS.items():
        k = dd['seniority.r'].isin(cat).sum(); n = len(dd)
        lo, hi = cp(int(k), n)
        rows.append(dict(denominator=dname, n=n, definition=kname, k=int(k),
                         pct=round(100*k/n,1), ci_lo=round(100*lo,1), ci_hi=round(100*hi,1),
                         missing_seniority=int(dd['seniority.r'].isna().sum())))
# drop==False sensitivity (D1 only, def B) and seniority.o sensitivity
f_nd = focal[~focal['drop']]
n_drop_in_focal = len(focal)-len(focal[~focal['drop']])
for kname, cat in DEFS.items():
    k=f_nd['seniority.r'].isin(cat).sum(); n=len(f_nd); lo,hi=cp(int(k),n)
    rows.append(dict(denominator='D1b: D1 & drop==False', n=n, definition=kname, k=int(k),
                     pct=round(100*k/n,1), ci_lo=round(100*lo,1), ci_hi=round(100*hi,1), missing_seniority=0))
for dname, dd in [('D1 primary', focal), ('D3 all rpp', rpp)]:
    for kname, cat in DEFS.items():
        k = dd['seniority.o'].isin(cat).sum(); n=len(dd); lo,hi=cp(int(k),n)
        rows.append(dict(denominator=f'seniority.o (ORIGINAL authors) — {dname}', n=n, definition=kname, k=int(k),
                         pct=round(100*k/n,1), ci_lo=round(100*lo,1), ci_hi=round(100*hi,1), missing_seniority=int(dd['seniority.o'].isna().sum())))
sens = pd.DataFrame(rows)
sens.to_csv('analysis/sensitivity_table.csv', index=False)
print(f"\ndrop==True rows in rpp: {int(rpp['drop'].sum())}; of which inside replicated==1 (focal): {n_drop_in_focal}")
print("\nSENSITIVITY MATRIX (%):")
pt = sens.pivot(index='definition', columns='denominator', values='pct')
print(pt.to_string())
print("\nFull table:\n", sens.to_string(index=False))

# ---- primary answer ----
k = int(focal['seniority.r'].isin({'Assistant','Assistant Professor'}).sum()); n=len(focal)
lo, hi = cp(k,n)
print(f"\n*** PRIMARY: B on D1: {k}/{n} = {100*k/n:.1f}%  95% CI [{100*lo:.1f}%, {100*hi:.1f}%] ***")
print("focal seniority.o assistant-rank count (artefact check):", int(focal['seniority.o'].isin({'Assistant','Assistant Professor'}).sum()))
