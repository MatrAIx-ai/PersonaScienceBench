import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 50)
S = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
R = pd.read_csv('/workspace/data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')
print("=== SHAPES ===")
print("study_data:", S.shape, "| replication_success_data:", R.shape)
print("\n=== study_data columns ===")
print(list(S.columns))
print("\n=== replication_success_data columns ===")
print(list(R.columns))
cols = ['discipline','project','subjects.o','subjects.r','same_subjects','drop','aggregated',
        'effect_type','online.o','online.r','compensation.o','compensation.r','replicated','lab_id','id']
print("\n=== DTYPES + MISSING (study_data) ===")
rows=[]
for c in cols:
    if c in S.columns:
        rows.append({'col':c,'dtype':str(S[c].dtype),'n_missing':int(S[c].isna().sum()),
                     'pct_missing':round(100*S[c].isna().mean(),2),'n_unique':int(S[c].nunique(dropna=True))})
print(pd.DataFrame(rows).to_string(index=False))
print("\nmissing in other study_data cols (nonzero only):")
m = S.isna().sum(); print(m[m>0].to_string())
print("\n=== missing in replication_success_data ===")
mr = R.isna().sum(); print(mr[mr>0].to_string() if mr.sum()>0 else "none")
print("\n=== RAW VALUE COUNTS subjects.o / subjects.r (no cleaning) ===")
for c in ['subjects.o','subjects.r']:
    vc = S[c].value_counts(dropna=False)
    print(f"\n-- {c} (n={len(S)}) --")
    print(pd.DataFrame({'n':vc,'pct':(100*vc/len(S)).round(2)}).to_string())
print("\n=== exact-string audit (repr) ===")
for c in ['subjects.o','subjects.r','discipline','project','drop','aggregated','effect_type',
          'compensation.o','compensation.r','online.o','online.r','same_subjects']:
    vals = sorted({repr(v) for v in S[c].dropna().unique()})
    print(f"{c}: {vals}")
print("\n=== cross-tab subjects.o x subjects.r (dropna=F) ===")
print(pd.crosstab(S['subjects.o'],S['subjects.r'],dropna=False,margins=True).to_string())
print("\n=== same_subjects vs manual comparison ===")
S['_man'] = np.where(S['subjects.o'].isna()|S['subjects.r'].isna(), np.nan, (S['subjects.o']==S['subjects.r']).astype(float))
print(pd.crosstab(S['same_subjects'],S['_man'],dropna=False).to_string())
print("\ndrop x aggregated crosstab:")
print(pd.crosstab(S['drop'].astype(str),S['aggregated'].astype(str),dropna=False).to_string())
print("\nproject x discipline counts:")
print(pd.crosstab(S['project'],S['discipline'],dropna=False,margins=True).to_string())
print("\nid unique?", S['id'].is_unique, "| dup ids:", int(S['id'].duplicated().sum()))
