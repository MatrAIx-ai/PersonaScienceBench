import pandas as pd, numpy as np, itertools
pd.set_option('display.width',250); pd.set_option('display.max_rows',300)
S = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
S['is_study'] = S['aggregated'].isna() | (S['aggregated']==True)
TO, TR = 82.4, 80.9
cats = ['discipline','project','effect_type','online.o','online.r','compensation.o','compensation.r','same_subjects','lab_id']
units = {'ALL_ROWS':lambda d:d, 'ALL_noDrop':lambda d:d[~d['drop']],
         'STUDY':lambda d:d[d['is_study']], 'STUDY_noDrop':lambda d:d[d['is_study']&~d['drop']]}

def pct(s):
    known = s.notna()
    if known.sum()==0: return np.nan,0,0
    return 100*(s[known]=='students').mean(), int((s[known]=='students').sum()), int(known.sum())

rows=[]
for uname,uf in units.items():
    base = uf(S)
    # groupings: none, single cat, pair cat
    groupings=[[]]+[[c] for c in cats]+[list(p) for p in itertools.combinations(cats,2)]
    for keys in groupings:
        if not keys:
            groups=[((), base)]
        else:
            groups=[(k,g) for k,g in base.groupby(keys, dropna=False) if len(g)>=5]
        for k,g in groups:
            for den in ['known','all']:
                if den=='all':
                    o = 100*(g['subjects.o']=='students').mean(); r=100*(g['subjects.r']=='students').mean()
                    on,en = int((g['subjects.o']=='students').sum()), len(g); rn,er = int((g['subjects.r']=='students').sum()), len(g)
                else:
                    o,on,en = pct(g['subjects.o']); r,rn,er = pct(g['subjects.r'])
                rows.append({'unit':uname,'filter':' & '.join(f"{c}={v}" for c,v in zip(keys,k)) or 'ALL DATASET',
                             'den':den,'n':len(g),'o':round(o,2),'o_frac':f"{on}/{en}",'r':round(r,2),'r_frac':f"{rn}/{er}",
                             'abs_err':round(abs(o-TO)+abs(r-TR),2), 'max_err':round(max(abs(o-TO),abs(r-TR)),2)})
T = pd.DataFrame(rows).sort_values('abs_err')
print("TOP 25 candidates by |o-82.4|+|r-80.9|")
print(T.head(25).to_string(index=False))
print("\nTOP 12 requiring BOTH close (max_err <= 2.0):")
print(T[T.max_err<=2.0].head(12).to_string(index=False))
print("\nBest per level-of-aggregation (discipline / project / whole / disc x project):")
for lvl,mask in [('whole',T['filter']=='ALL DATASET'),
                 ('discipline',T['filter'].str.match(r'^discipline=')&~T['filter'].str.contains(' &')),
                 ('project',T['filter'].str.match(r'^project=')&~T['filter'].str.contains(' &')),
                 ('disc x proj',T['filter'].str.contains('discipline=.* & project=|project=.* & discipline='))]:
    sub=T[mask]
    print(f"\n-- {lvl} --"); print(sub.head(5).to_string(index=False))
T.to_csv('/workspace/analysis/candidates.csv', index=False)
print("\nsaved:", len(T), "candidate rows -> analysis/candidates.csv")
