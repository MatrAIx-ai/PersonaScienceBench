import pandas as pd, numpy as np, itertools
pd.set_option('display.width',250); pd.set_option('display.max_rows',120)
S = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
S['is_study'] = S['aggregated'].isna() | (S['aggregated']==True)
S['psych'] = np.where(S['discipline']!='Economics','psychology(non-econ)','economics')
TO,TR=82.4,80.9
cats=['discipline','project','effect_type','online.o','online.r','compensation.o','compensation.r',
      'same_subjects','same_country','same_language','us_lab.o','us_lab.r','replicated','psych','drop','aggregated']
rows=[]
for uname,base in [('STUDY',S[S['is_study']]),('ALL_ROWS',S),('STUDY_noDrop',S[S['is_study']&~S['drop']]),('ALL_noDrop',S[~S['drop']])]:
    for k in range(0,4):
        for keys in itertools.combinations(cats,k):
            if len(set(keys))<k: continue
            groups=[((),base)] if k==0 else list(base.groupby(list(keys),dropna=False))
            for kk,g in groups:
                if len(g)<20: continue
                o=100*(g['subjects.o']=='students').mean(); r=100*(g['subjects.r']=='students').mean()
                rows.append({'unit':uname,'keys':','.join(keys) or '-','filter':', '.join(f"{c}={v}" for c,v in zip(keys,kk)) or 'ALL',
                             'n':len(g),'o':round(o,2),'r':round(r,2),'err':round(abs(o-TO)+abs(r-TR),2)})
T=pd.DataFrame(rows).drop_duplicates(subset=['unit','filter','n','o','r']).sort_values('err')
print("total combos evaluated:",len(T))
print("\nNear-exact matches (both within 0.3 pp):")
m=T[(abs(T.o-TO)<=0.3)&(abs(T.r-TR)<=0.3)]
print(m.to_string(index=False) if len(m) else "NONE")
print("\nTOP 20 overall:")
print(T.head(20).to_string(index=False))
print("\nBest containing 'discipline=' filter:")
print(T[T['filter'].str.contains('discipline=')].head(10).to_string(index=False))
