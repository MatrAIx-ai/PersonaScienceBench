import pandas as pd, numpy as np, re
pd.set_option('display.width',240); pd.set_option('display.max_rows',100)
S = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
R = pd.read_csv('/workspace/data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')
S['is_study']=S['aggregated'].isna()|(S['aggregated']==True)
st = S[S['is_study']].copy()
def surnames(a):
    if not isinstance(a,str): return []
    out=[]
    for part in a.split(' and '):
        toks=[t for t in re.split(r'[^A-Za-z\'-]+', part.strip()) if t]
        # surname = last token unless it's a suffix/particle
        if toks: out.append(toks[-1].lower())
    return out
st['sur'] = st['authors.o'].apply(surnames)
st['pub_year']=pd.to_numeric(st['pub_year'], errors='coerce')
R['sl']=R['study'].str.lower()
rows=[]
for _,r in st.iterrows():
    hits = R[R['sl'].apply(lambda s: any(su in s for su in r['sur']))] if r['sur'] else R.iloc[0:0]
    # restrict by year if present in R string
    if len(hits)>1:
        h2 = hits[hits['sl'].str.contains(str(int(r['pub_year'])), regex=False, na=False)]
        if len(h2)>=1: hits=h2
    if len(hits)==1:
        rows.append({'id':r['id'],'project':r['project'],'domain':hits.iloc[0]['project'],'study':hits.iloc[0]['study'],
                     'subjects.o':r['subjects.o'],'subjects.r':r['subjects.r'],'n.o':r['n.o'],'n.r':r['n.r'],
                     'no':hits.iloc[0]['no'],'nr':hits.iloc[0]['nr']})
    elif len(hits)>1:
        rows.append({'id':r['id'],'project':r['project'],'domain':'AMBIG:'+str(list(hits['project'])),'study':None})
J = pd.DataFrame(rows)
print("S study-level ids:",len(st),"| matched uniquely:",int(J['domain'].notna().sum()-(J['domain'].astype(str).str.startswith('AMBIG').sum())),
      "| ambiguous:",int(J['domain'].astype(str).str.startswith('AMBIG').sum()),"| unmatched:",int(J['domain'].isna().sum()))
Jm = J[J['domain'].notna() & ~J['domain'].astype(str).str.startswith('AMBIG')].copy()
print("\nS project x R domain crosstab (matched):")
print(pd.crosstab(Jm['project'],Jm['domain'],margins=True).to_string())
print("\nsample-size agreement (n.o vs no, n.r vs nr):")
print("n.o==no:", int((Jm['n.o']==Jm['no']).sum()), "/", len(Jm), "| n.r==nr:", int((Jm['n.r']==Jm['nr']).sum()), "/", len(Jm))
Jm['o_st']=(Jm['subjects.o']=='students'); Jm['r_st']=(Jm['subjects.r']=='students')
tab = Jm.groupby('domain').apply(lambda g: pd.Series({'n_pairs':len(g),
      'o_students':int(g['o_st'].sum()),'o_%':100*g['o_st'].mean(),'o_den_known':int(g['subjects.o'].notna().sum()),
      'r_students':int(g['r_st'].sum()),'r_%':100*g['r_st'].mean()}), include_groups=False).round(2)
print("\n=== students shares by R DOMAIN (matched pairs only) ===")
print(tab.to_string())
print("\nunmatched/ambiguous ids:"); print(J[J['domain'].isna()|J['domain'].astype(str).str.startswith('AMBIG')][['id','project','domain']].to_string(index=False))
J.to_csv('/workspace/analysis/join_attempt.csv', index=False)
