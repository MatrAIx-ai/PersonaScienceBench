import pandas as pd, numpy as np
pd.set_option('display.width',240)
S = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
R = pd.read_csv('/workspace/data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')
S['is_study']=S['aggregated'].isna()|(S['aggregated']==True)
st = S[S['is_study']].reset_index(drop=True)
print("S:",len(st),"R:",len(R))
# feature distributions to see comparability
print("\nquantiles n.o vs no:", np.nanpercentile(st['n.o'],[10,50,90]).round(0), np.nanpercentile(R['no'],[10,50,90]).round(0))
print("quantiles n.r vs nr:", np.nanpercentile(st['n.r'],[10,50,90]).round(0), np.nanpercentile(R['nr'],[10,50,90]).round(0))
print("exact overlap n.r∩nr:", len(set(st['n.r'].dropna()) & set(R['nr'].dropna())), "of", st['n.r'].nunique())
print("exact overlap n.o∩no:", len(set(st['n.o'].dropna()) & set(R['no'].dropna())), "of", st['n.o'].nunique())
print("exact overlap p_value.r∩pr:", len(set(st['p_value.r'].round(3).dropna()) & set(R['pr'].round(3).dropna())))
# cost matrix on (n.r, pr) only where both defined
A = st[['id','project','n.o','n.r','p_value.o','p_value.r']].copy()
best=[]
Rv = R.copy()
for _,s in A.iterrows():
    c = np.zeros(len(Rv))
    ok = True
    if pd.notna(s['n.r']) and pd.notna(s['p_value.r']):
        score = (np.abs(np.log(Rv['nr'].values - s['n.r'])+1e-9)<np.log(1.02)).astype(float) + \
                (np.abs(Rv['pr'].values - s['p_value.r'])<1e-3).astype(float)
        idx = np.where(score>=1.98)[0]
        if len(idx)==1: best.append((s['id'],s['project'],Rv.iloc[idx[0]]['project'],Rv.iloc[idx[0]]['study'],'strong'))
        elif len(idx)>1: best.append((s['id'],s['project'],'AMBIG',None,'weak'))
        else:
            idx2 = np.where(score>=1.0)[0]
            best.append((s['id'],s['project'],'NO_MATCH' if len(idx2)==0 else 'PARTIAL:'+str(list(Rv.iloc[idx2]['project'])),None,'partial'))
    else:
        best.append((s['id'],s['project'],'NO_FEATURES',None,''))
B = pd.DataFrame(best, columns=['id','project','domain','study','strength'])
print("\njoin strength counts:"); print(B['strength'].value_counts().to_string())
print("\nproject x domain for STRONG matches:")
Bs=B[B['strength']=='strong']
print(pd.crosstab(Bs['project'],Bs['domain'],margins=True).to_string())
print("\nstrong matches:",len(Bs))
