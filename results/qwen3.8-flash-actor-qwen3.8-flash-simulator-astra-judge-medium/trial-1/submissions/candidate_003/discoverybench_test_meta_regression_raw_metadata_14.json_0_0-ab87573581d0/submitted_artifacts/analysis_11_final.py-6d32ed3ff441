"""FINAL: student-subject shares by domain in Camerer-style replication meta-regression data.
Steps: unit reconstruction -> share computation -> domain ranking vs target (82.4, 80.9)
       -> sensitivity -> hypothesis-support tables. No new cleaning, no join to table 2."""
import pandas as pd, numpy as np
pd.set_option('display.width',240); pd.set_option('display.max_rows',200)
TO, TR = 82.4, 80.9
S = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
S['is_study'] = S['aggregated'].isna() | (S['aggregated']==True)   # one row per O/R pair
PAIRS = S[S['is_study']].copy()
assert len(PAIRS)==PAIRS['id'].nunique()==141

def shares(g, known=False):
    o_s, r_s = g['subjects.o']=='students', g['subjects.r']=='students'
    ko, kr = g['subjects.o'].notna(), g['subjects.r'].notna()
    if known:
        on,en = int(o_s[ko].sum()), int(ko.sum()); rn,er = int(r_s[kr].sum()), int(kr.sum())
    else:
        on,en = int(o_s.sum()), len(g); rn,er = int(r_s.sum()), len(g)
    o = 100*on/en; r = 100*rn/er
    return pd.Series({'n_pairs':en,'o_students_n':on,'o_students_pct':round(o,2),
                      'r_students_n':rn,'r_students_pct':round(r,2),
                      'o_frac':f"{on}/{en}",'r_frac':f"{rn}/{er}",
                      'abs_err_original':round(abs(o-TO),2),'abs_err_replication':round(abs(r-TR),2),
                      'max_abs_err':round(max(abs(o-TO),abs(r-TR)),2)})

# ---------- (2) HEADLINE: domain = discipline, unit = O/R pair, drop INCLUDED ----------
H = PAIRS.groupby('discipline').apply(shares, include_groups=False).reset_index()
H = H.sort_values('max_abs_err')
H.to_csv('/workspace/analysis/final_headline_discipline.csv', index=False)
print("=== HEADLINE: students share by domain (discipline), unit = O/R pair (n=141), drop included ===")
print("    target: original 82.4%, replication 80.9%")
print(H.to_string(index=False))

# ---------- (4) SENSITIVITY ----------
rows=[]
def add(label, df, known=False, unit='O/R pair'):
    r = shares(df, known); r.name=label; rows.append(r)
add('HEADLINE discipline=Social (pair, drop in)',  PAIRS[PAIRS['discipline']=='Social'])
add('Social, known-subject denominator',            PAIRS[PAIRS['discipline']=='Social'], known=True)
add('Social, drop excluded',                        S[(S['is_study'])&~S['drop']&(S['discipline']=='Social')])
add('discipline=Social, row-level (labs, n=668)',    S[S['discipline']=='Social'], unit='row')
add('discipline=Social, row-level, known denom',     S[S['discipline']=='Social'], known=True, unit='row')
add('discipline=Cognitive (pair)',                   PAIRS[PAIRS['discipline']=='Cognitive'])
add('discipline=Economics (pair)',                   PAIRS[PAIRS['discipline']=='Economics'])
add('psychology = Social+Cognitive (pair)',          PAIRS[PAIRS['discipline']!='Economics'])
add('Economics only (pair)',                         PAIRS[PAIRS['discipline']=='Economics'])
add('whole dataset (pair)',                          PAIRS)
add('whole dataset (row-level, n=927)',              S, unit='row')
for p in ['rpp','ml1','ml3','ee']:
    add(f'project={p} (pair)',                       PAIRS[PAIRS['project']==p])
add('project=rpp, drop excluded (pair)',             S[(S['is_study'])&~S['drop']&(S['project']=='rpp')])
SEN = pd.DataFrame(rows).reset_index().rename(columns={'index':'scenario'})
SEN['unit'] = ['O/R pair']*len(SEN)
SEN.loc[SEN['scenario'].str.contains('row-level'),'unit']='raw row'
SEN.to_csv('/workspace/analysis/final_sensitivity.csv', index=False)
print("\n=== SENSITIVITY: same shares under different unit / filter / denominator ===")
print(SEN[['scenario','unit','n_pairs','o_frac','o_students_pct','r_frac','r_students_pct','max_abs_err']].to_string(index=False))

# ---------- (7a) Economics == ee ----------
print("\n=== (a) is 'discipline=Economics' identical to 'project=ee'? ===")
print(pd.crosstab(PAIRS['discipline'], PAIRS['project']).to_string())
e1 = PAIRS[PAIRS['discipline']=='Economics']; e2 = PAIRS[PAIRS['project']=='ee']
print("identical row sets:", set(e1['id'])==set(e2['id']), "| n =", len(e1), len(e2))
print(shares(e1).to_string())

# ---------- (7b) Social O-students by project ----------
print("\n=== (b) Social: students counts split by project (unit = O/R pair) ===")
sosc = PAIRS[PAIRS['discipline']=='Social']
B = sosc.groupby('project').apply(lambda g: pd.Series({
    'n_pairs':len(g),'o_students_n':int((g['subjects.o']=='students').sum()),
    'o_pct':round(100*(g['subjects.o']=='students').mean(),2),
    'r_students_n':int((g['subjects.r']=='students').sum()),
    'r_pct':round(100*(g['subjects.r']=='students').mean(),2)}), include_groups=False)
print(B.to_string())
print("totals:", int((sosc['subjects.o']=='students').sum()), "/", len(sosc),
      "| R:", int((sosc['subjects.r']=='students').sum()), "/", len(sosc))
print("\nSocial subjects.o composition:", sosc['subjects.o'].value_counts(dropna=False).to_dict())
print("Social subjects.r composition:", sosc['subjects.r'].value_counts(dropna=False).to_dict())
