#!/usr/bin/env python3
"""
Question: What proportion of original studies in Experimental Economics
(project == "ee") were conducted in the United Kingdom?

Unit of analysis: unique ORIGINAL study (original-study key), NOT the O/R pair
and NOT the multi-lab-inflated row count.
Field: experiment_country.o (original experiment country) -- strictly.
Denominator: all ee original studies (18). No weighting.
"""
import math
import re
import pandas as pd

S_PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
R_PATH = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"
UK = "United Kingdom"

s = pd.read_csv(S_PATH)
r = pd.read_csv(R_PATH)

print("=" * 78)
print("STEP 0  Input integrity")
print("=" * 78)
print(f"study_data            : {s.shape[0]} rows x {s.shape[1]} cols")
print(f"replication_success   : {r.shape[0]} rows x {r.shape[1]} cols")
for c in ["id", "title", "project", "experiment_country.o"]:
    assert c in s.columns, c
    print(f"  column present in study_data: {c:22s} non-null={s[c].notna().sum()}")
print(f"country columns in replication_success: "
      f"{[c for c in r.columns if 'coun' in c.lower()] or 'NONE'}")

print()
print("=" * 78)
print("STEP 1  Subpopulation project == 'ee'")
print("=" * 78)
print("project distribution (all rows):")
print(s["project"].value_counts().to_string())
ee_rows = s[s["project"] == "ee"].copy()
print(f"\nee rows = {len(ee_rows)}")

# --- unit of analysis: deduplicate to unique ORIGINAL studies -------------
# Three candidate keys for 'the original study'; all must agree for ee.
keys = {"id": ["id"], "title": ["title"], "title+authors.o": ["title", "authors.o"]}
for name, ks in keys.items():
    n = ee_rows[ks].drop_duplicates().shape[0]
    print(f"  unique by {name:16s} = {n}")
ee = ee_rows.drop_duplicates(subset=["id"])   # 18 -> 18, no-op for ee, explicit by design
print(f"\nunit of analysis (unique original studies, by id) = {len(ee)}")
print("NOTE: ee has no multi-lab inflation (18 rows / 18 ids), aggregated is all-NaN,")
print("      and drop==False for all ee rows:",
      (ee_rows["drop"] == False).all(), "| aggregated non-null:", ee_rows["aggregated"].notna().sum())

print()
print("=" * 78)
print("STEP 2  Missingness and country spellings")
print("=" * 78)
co = ee["experiment_country.o"]
print(f"missing experiment_country.o within ee : {co.isna().sum()} of {len(ee)}")
print(f"missing experiment_country.o all rows  : {s['experiment_country.o'].isna().sum()} of {len(s)}"
      f"  (rows: {s.loc[s['experiment_country.o'].isna(),'id'].tolist()})")
print("\nee experiment_country.o verbatim distribution:")
print(co.value_counts(dropna=False).to_string())
print("\nunique ee country strings via repr (spelling / whitespace check):")
for v in sorted(co.dropna().unique(), key=str):
    print("   ", repr(v))
pat = re.compile(r"\bUK\b|Britain|England|Great Britain|Kingdom", re.I)
alt = sorted({v for v in s["experiment_country.o"].dropna().unique() if pat.search(str(v))})
print(f"UK-like spellings anywhere in study_data: {alt}")

print()
print("=" * 78)
print("STEP 3  Headline estimate")
print("=" * 78)
num_exact = int(co.astype(str).str.strip().eq(UK).sum())
num_fuzzy = int(co.astype(str).str.contains(pat, regex=True).sum())
den_all = len(ee)
den_complete = int(co.notna().sum())
assert num_exact == num_fuzzy, "fuzzy match disagrees -> unseen spelling variant"
share = num_exact / den_all
print(f"numerator   (experiment_country.o == 'United Kingdom') = {num_exact}")
print(f"denominator (all ee original studies)                  = {den_all}")
print(f"complete-case denominator (non-null country)           = {den_complete}  -> identical: {den_all == den_complete}")
print(f"\nSHARE = {num_exact}/{den_all} = {share:.6f} = {100*share:.2f}%  (~1 in {1/share:.0f})")
print(f"UK original study: "
      f"{ee.loc[co.astype(str).str.strip().eq(UK), ['id','title','experiment_country.r']].to_dict('records')}")

print()
print("=" * 78)
print("STEP 4  Stability diagnostics (reported as caveats, NOT in the answer)")
print("=" * 78)
z = 1.959964
n, p = den_all, share
d = 1 + z * z / n
c = (p + z * z / (2 * n)) / d
h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
print(f"Wilson 95% CI: [{100*(c-h):.2f}%, {100*(c+h):.2f}%]  -> estimate unstable at N={n}")
print(f"+/-1 study  = +/- {100/den_all:.2f} pp  (i.e. 0/18 = 0.0% .. 2/18 = {100*2/18:.1f}%)")

print()
print("Geographic context of the ee originals (experiment_country.o):")
ctx = co.value_counts()
for k, v in ctx.items():
    print(f"   {k:16s} {v:2d}  ({100*v/den_all:5.2f}%)  {'#'*v}")
print(f"US dominance: {ctx.get('United States',0)}/{den_all} = "
      f"{100*ctx.get('United States',0)/den_all:.1f}%; UK is a single case.")

print()
print("=" * 78)
print("STEP 5  Deliberately rejected definitions (traps) -- documented, not used")
print("=" * 78)
cr = ee["experiment_country.r"].astype(str).str.strip()
traps = [
    ("used experiment_country.r instead of .o",
     int(cr.eq(UK).sum()), den_all, "ee.13 and ee.14: original was in the US, replication in the UK"),
    ("pooled all projects (927 rows) instead of ee",
     int(s["experiment_country.o"].astype(str).str.strip().eq(UK).sum()), len(s),
     "answers a different question (all replication projects)"),
    ("pooled all projects at original-study level (unique ids)",
     int(s.drop_duplicates('id')["experiment_country.o"].astype(str).str.strip().eq(UK).sum()),
     s["id"].nunique(), "still not restricted to Experimental Economics"),
]
for name, nu, de, why in traps:
    print(f"  {name:52s} -> {nu}/{de} = {100*nu/de:5.2f}%   REJECTED: {why}")

print()
print("=" * 78)
print("STEP 6  Independent cross-check with replication_success (verification only)")
print("=" * 78)
ree = r[r["project"] == "Experimental Economics"]
print(f"replication_success Experimental Economics rows = {len(ree)}, "
      f"unique study labels = {ree['study'].nunique()}")
print(f"study_data ee original studies = {den_all}  -> consistent: {len(ree) == den_all}")
print("no country column exists in replication_success, so it cannot inform the numerator.")

print()
print("=" * 78)
print("FINAL")
print("=" * 78)
print(f"{num_exact}/{den_all} = {100*share:.2f}% of Experimental Economics original studies "
      f"were conducted in the United Kingdom (experiment_country.o).")
