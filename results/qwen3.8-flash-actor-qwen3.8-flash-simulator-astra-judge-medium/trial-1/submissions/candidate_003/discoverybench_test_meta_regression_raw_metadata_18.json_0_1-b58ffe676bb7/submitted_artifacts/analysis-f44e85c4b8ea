"""
Share of Experimental Economics (ee) ORIGINAL studies conducted in a lab setting.

Unit of analysis : one unique ORIGINAL ee study == one row == one O/R pair
                   (verified in recon: 18 rows = 18 unique `id` = 18 unique `title`, 0 dup O/R pairs)
Numerator marker : `online.o` == 0  ("original experiment NOT conducted online")
Denominator      : ee studies with non-missing key marker `online.o` (no NA in ee -> denominator = 18)

Definitions (full CSV column names, as stored):
  PRIMARY   LAB_DEF_1 : `online.o` == 0
  SENSITIVITY LAB_DEF_2 : `online.o` == 0 AND `subjects.o` in {'students','community'}
  SENSITIVITY LAB_DEF_3 : `us_lab.o` == 1   <-- US-lab share, NOT lab share (geography proxy)
Reporting-only (different question, never pooled into one denominator): replication side `online.r`, `us_lab.r`.

File 2 (meta-regression_replication_success_...csv) is NOT used: it has zero setting columns
(only `study`,`project` non-numeric; effect sizes / SEs / p-values / n / `pm_belief`).

Outputs: work/out/lab_share_summary.csv, work/out/marker_convergence.csv,
         work/out/crosstabs.csv, work/out/replication_side.csv, work/out/lab_share_results.json
Run: python3 work/lab_share_analysis.py
"""
import json
import os
import pandas as pd

STUDY_CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
OUT = "work/out"
os.makedirs(OUT, exist_ok=True)

df = pd.read_csv(STUDY_CSV, keep_default_na=False, na_values=["NA", ""])
ee_all = df[df["project"].astype(str).str.strip().str.lower() == "ee"].copy()

# ---- denominator: ee studies with a known value of the key marker `online.o` ----
den = ee_all.dropna(subset=["online.o"]).copy()

# ---- definitions ----
den["LAB_DEF_1_online_o_eq_0"] = den["online.o"].eq(0)
den["LAB_DEF_2_offline_and_subjects_pool"] = den["online.o"].eq(0) & den["subjects.o"].isin(["students", "community"])
den["LAB_DEF_3_us_lab_o_eq_1"] = den["us_lab.o"].eq(1)
den["LAB_DEF_1b_drop_community_subjects_o"] = den["online.o"].eq(0) & den["subjects.o"].eq("students")

DEFS = [
    ("LAB_DEF_1_online_o_eq_0", "PRIMARY", "online.o == 0"),
    ("LAB_DEF_2_offline_and_subjects_pool", "sensitivity",
     "online.o == 0 AND subjects.o in {'students','community'}"),
    ("LAB_DEF_3_us_lab_o_eq_1", "sensitivity (NOT lab share: US-lab geography proxy)", "us_lab.o == 1"),
    ("LAB_DEF_1b_drop_community_subjects_o", "sensitivity (PRIMARY minus subjects.o=='community')",
     "online.o == 0 AND subjects.o == 'students'"),
]
summary = pd.DataFrame([
    {"definition": n, "role": r, "rule": u,
     "n_numerator": int(den[n].sum()), "n_denominator": int(len(den)),
     "share": round(float(den[n].mean()), 4),
     "fraction": f"{int(den[n].sum())}/{len(den)}"}
    for n, r, u in DEFS
])

# ---- marker convergence: four independent markers on the ee subsample ----
mk = pd.DataFrame({
    "marker": ["M1 online.o == 0 (not online)",
               "M2 subjects.o in {'students','community'} (no 'online'/'anyone')",
               "M3 compensation.o == 'cash' (on-site show-up pay, not online credit panel)",
               "M4 experiment_country.o not missing (physical location recorded)"],
    "column": ["online.o", "subjects.o", "compensation.o", "experiment_country.o"],
})
mk["n_studies_satisfied"] = [
    int(den["online.o"].eq(0).sum()),
    int(den["subjects.o"].isin(["students", "community"]).sum()),
    int(den["compensation.o"].eq("cash").sum()),
    int(den["experiment_country.o"].notna().sum()),
]
mk["n_denominator"] = len(den)
mk["share_of_denominator"] = (mk["n_studies_satisfied"] / len(den)).round(4)
same_set = (den["online.o"].eq(0)
            & den["subjects.o"].isin(["students", "community"])
            & den["compensation.o"].eq("cash")
            & den["experiment_country.o"].notna())
mk["identical_study_set_as_PRIMARY"] = [bool(set(den.loc[den["online.o"].eq(0), "id"])
                                            == set(den.loc[same_set, "id"]))] * 3 + \
                                       [bool(set(den.loc[den["experiment_country.o"].notna(), "id"])
                                             == set(den.loc[den["online.o"].eq(0), "id"]))]
mk["all_four_joint_n"] = [int(same_set.sum())] * 4

# ---- crosstabs vs PRIMARY ----
p = den["LAB_DEF_1_online_o_eq_0"]
LBL = {True: "LAB_DEF_1_true", False: "LAB_DEF_1_false"}
ct1 = pd.crosstab(p, den["subjects.o"], margins=True, margins_name="ALL").rename(index=LBL)
ct2 = pd.crosstab(p, den["us_lab.o"], margins=True, margins_name="ALL").rename(index=LBL)
ct1.to_csv(f"{OUT}/crosstab_primary_x_subjects_o.csv"); ct2.to_csv(f"{OUT}/crosstab_primary_x_us_lab_o.csv")

# ---- replication side: transparency only, separate denominator, different question ----
rep = pd.DataFrame([
    {"measure": "online.r == 0 (replication not online)", "n": int((den["online.r"] == 0).sum()),
     "n_denominator": int(den["online.r"].notna().sum())},
    {"measure": "us_lab.r == 1 (replication lab in US)", "n": int((den["us_lab.r"] == 1).sum()),
     "n_denominator": int(len(den))},
    {"measure": "subjects.r == 'students'", "n": int((den["subjects.r"] == "students").sum()),
     "n_denominator": int(len(den))},
])

# ---- integrity checks ----
checks = {
    "file1_shape": list(df.shape),
    "project_value_counts_file1": df["project"].value_counts().to_dict(),
    "literal_Experimental_Economics_rows_in_file1": int((df["project"].astype(str).str.strip() == "Experimental Economics").sum()),
    "ee_rows": int(len(ee_all)), "ee_unique_id": int(ee_all["id"].nunique()),
    "ee_unique_title": int(ee_all["title"].nunique()),
    "ee_duplicated_id": int(ee_all["id"].duplicated().sum()),
    "na_online_o_in_ee": int(ee_all["online.o"].isna().sum()),
    "rows_dropped_from_ee_due_to_NA_online_o": int(len(ee_all) - len(den)),
    "online_o_value_counts_ee": {str(k): int(v) for k, v in ee_all["online.o"].value_counts(dropna=False).items()},
    "lab_id_missing_in_ee": int(ee_all["lab_id"].isna().sum()),
    "community_study_id": den.loc[den["subjects.o"].eq("community"), "id"].tolist(),
    "file2_used": False,
    "file2_setting_columns": [],
}

summary.to_csv(f"{OUT}/lab_share_summary.csv", index=False)
mk.to_csv(f"{OUT}/marker_convergence.csv", index=False)
rep.to_csv(f"{OUT}/replication_side.csv", index=False)
def tidy(ct, table):
    L = ct.rename_axis(index="LAB_DEF_1_state", columns=None).reset_index()
    L = L.melt(id_vars="LAB_DEF_1_state", var_name="level", value_name="n")
    L["table"] = table
    return L[["table", "LAB_DEF_1_state", "level", "n"]]
tidy_ct = pd.concat([tidy(ct1, "LAB_DEF_1_online_o_eq_0 x subjects.o"),
                     tidy(ct2, "LAB_DEF_1_online_o_eq_0 x us_lab.o")], ignore_index=True)
tidy_ct.to_csv(f"{OUT}/crosstabs.csv", index=False)
with open(f"{OUT}/lab_share_results.json", "w") as f:
    json.dump({"integrity_checks": checks,
               "definitions": [{"name": n, "role": r, "rule": u} for n, r, u in DEFS],
               "summary": summary.to_dict(orient="records"),
               "marker_convergence": mk.to_dict(orient="records"),
               "replication_side_transparency_only": rep.to_dict(orient="records"),
               "crosstab_primary_x_subjects_o": ct1.to_dict(),
               "crosstab_primary_x_us_lab_o": ct2.to_dict(),
               "crosstabs_tidy": tidy_ct.to_dict(orient="records")}, f, indent=2, default=str)

pd.set_option("display.width", 220)
print("DENOMINATOR:", len(den), " (ee studies with non-missing online.o)\n")
print(summary.to_string(index=False))
print("\nMARKER CONVERGENCE\n", mk.to_string(index=False))
print("\nCROSSTAB primary x subjects.o\n", ct1.to_string())
print("\nCROSSTAB primary x us_lab.o\n", ct2.to_string())
print("\nREPLICATION SIDE (transparency only)\n", rep.to_string(index=False))
print("\nCHECKS:", json.dumps(checks, indent=2, default=str))
