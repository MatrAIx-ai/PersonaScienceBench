"""
Skeleton: share of Experimental Economics (ee) ORIGINAL studies run in a lab setting.
Primary unit: one row == one unique O/R pair == one original ee study (verified: 18/18/18).
Run:  python3 work/lab_share_skeleton.py            # diagnostics only (no ratio)
      python3 work/lab_share_skeleton.py --report   # ratios + crosstab (only after plan approval)
"""
import argparse
import pandas as pd

STUDY_CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"

# --- operational definitions of "lab setting" (ORIGINAL study side, .o columns) ---
DEF_MAIN   = lambda d: d["online.o"].eq(0)                                 # not online => in-person/lab
DEF_STRICT = lambda d: d["online.o"].eq(0) & d["subjects.o"].isin(["students", "community"])
DEF_USLAB  = lambda d: d["us_lab.o"].eq(1)                                 # narrow: US lab only
DEFS = {"main_not_online": DEF_MAIN, "strict_offline_subjects": DEF_STRICT, "narrow_us_lab": DEF_USLAB}
NA_MARKERS = ["online.o", "subjects.o", "us_lab.o"]                        # rows dropped if key marker NA


def load():
    df = pd.read_csv(STUDY_CSV, keep_default_na=False, na_values=["NA", ""])
    return df[df["project"].astype(str).str.strip().str.lower() == "ee"].copy()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--report", action="store_true", help="compute ratios (gated until plan approval)")
    a = ap.parse_args()
    ee = load()
    print("ee rows / unique id / unique title:", len(ee), ee["id"].nunique(), ee["title"].nunique())
    print("NA in key markers:", {c: int(ee[c].isna().sum()) for c in NA_MARKERS})
    print("constant columns in ee:", [c for c in ["online.o", "online.r", "compensation.o", "subjects.r"]
                                      if ee[c].nunique(dropna=True) <= 1])
    if not a.report:
        print("\n[diagnostics only] pass --report for ratios/crosstab."); return

    den = ee.dropna(subset=["online.o"])                                   # denominator: ee studies w/ known online flag
    rows = []
    for name, f in DEFS.items():
        num = den[f(den)]
        rows.append({"definition": name, "n_lab": len(num), "n_den": len(den), "share": len(num) / len(den)})
    print("\n", pd.DataFrame(rows).to_string(index=False))
    print("\ncrosstab (main def x subjects.o):\n", pd.crosstab(DEF_MAIN(den), den["subjects.o"]))
    print("\ncrosstab (main def x us_lab.o):\n", pd.crosstab(DEF_MAIN(den), den["us_lab.o"]))


if __name__ == "__main__":
    main()
