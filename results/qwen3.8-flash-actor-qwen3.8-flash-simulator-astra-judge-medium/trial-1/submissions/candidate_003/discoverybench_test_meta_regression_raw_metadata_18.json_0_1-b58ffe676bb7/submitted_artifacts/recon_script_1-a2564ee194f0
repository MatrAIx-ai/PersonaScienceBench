import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 100)

P1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
P2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(P1, keep_default_na=False, na_values=["NA", ""])
print("=== FILE 1 shape:", df.shape)
print(df.dtypes.to_string())

print("\n--- project value counts (raw strings) ---")
print(df["project"].value_counts(dropna=False).to_string())
print("unique project count:", df["project"].nunique(dropna=False))
print("unique project values:", sorted(map(str, df["project"].unique())))

mask_ee = df["project"].astype(str).str.strip().str.lower().isin(["ee", "experimental economics"])
print("\nee-like rows (ee or 'experimental economics'):", int(mask_ee.sum()))
print("rows exactly 'Experimental Economics':", int((df["project"].astype(str).str.strip()=="Experimental Economics").sum()))

print("\nid: nunique=", df["id"].nunique(), " n=", len(df), " dup ids:", df["id"].duplicated().sum())
print("title: nunique=", df["title"].nunique(), " dup titles:", df["title"].duplicated().sum())
dupO = df.duplicated(subset=["title"]).sum()
print("duplicated (title) rows:", dupO)
# id duplication detail
print(df["id"].value_counts().head(8).to_string())

cols = ["online.o","online.r","subjects.o","subjects.r","us_lab.o","us_lab.r",
        "compensation.o","compensation.r","experiment_country.o","experiment_country.r","lab_id",
        "same_online","same_subjects","aggregated","drop","discipline"]
print("\n\n########## WHOLE FILE: missingness / nunique for setting markers ##########")
for c in cols:
    if c not in df.columns: 
        print(f"{c:24s} MISSING COLUMN"); continue
    s = df[c]
    print(f"{c:24s} dtype={str(s.dtype):9s} nunique={s.nunique(dropna=True):5d} NA={s.isna().sum():5d} ({s.isna().mean():.3%})")

ee = df[mask_ee].copy()
print("\n\n########## EE SUBSET shape:", ee.shape, "##########")
print("discipline in ee:", ee["discipline"].value_counts(dropna=False).to_dict())
for c in cols:
    if c not in ee.columns: continue
    s = ee[c]
    print(f"\n=== {c} | dtype={s.dtype} | NA={s.isna().sum()} ({s.isna().mean():.1%}) | nunique={s.nunique(dropna=True)}")
    vc = s.value_counts(dropna=False)
    print(vc.head(20).to_string())
    if len(vc) > 20: print(f"... ({len(vc)} distinct values total)")
