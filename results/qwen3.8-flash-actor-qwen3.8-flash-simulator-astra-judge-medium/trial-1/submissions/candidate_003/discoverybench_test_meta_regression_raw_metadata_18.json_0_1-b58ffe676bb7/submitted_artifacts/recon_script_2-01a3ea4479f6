import pandas as pd, numpy as np
pd.set_option('display.width', 260); pd.set_option('display.max_columns', 60); pd.set_option('display.max_colwidth', 45)
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv", keep_default_na=False, na_values=["NA",""])
ee = df[df["project"]=="ee"].copy()
print("ee rows:", len(ee))
print("ee unique id:", ee["id"].nunique(), "| ee unique title:", ee["title"].nunique())
