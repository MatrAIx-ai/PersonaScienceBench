print("\n--- ee id / title / O-R setting columns ---")
print(ee[["id","title","pub_year","journal","effect_type","n.o","n.r","experiment_country.o","experiment_language.o",
          "online.o","subjects.o","compensation.o","us_lab.o","same_online","same_subjects","drop","aggregated","lab_id"]].to_string(index=False))

# are the ee rows identical duplicates of the same O/R pair, or unique?
key = ["title","authors.o","pub_year","effect_size.o","p_value.o","effect_size.r","p_value.r"]
print("\nfully duplicated ee rows on", key, ":", ee.duplicated(subset=key).sum())

# does id prefix numbering imply 18 distinct original studies?
print("\nsorted ee ids:", sorted(ee["id"].tolist()))

# how many rows per id overall (to explain the 927 vs 141)
print("\nrows per id by project:")
print(df.groupby("project")["id"].agg(rows="size", uniq_ids="nunique"))

# aggregated / drop semantics
print("\naggregated x project:\n", pd.crosstab(df["project"], df["aggregated"].astype("object"), dropna=False))
print("\ndrop x project:\n", pd.crosstab(df["project"], df["drop"]))

# whole-file: online.o distribution & NA rows in non-ee projects
print("\nwhole file online.o:\n", df["online.o"].value_counts(dropna=False))
print("\nrow(s) with online.o NA:")
print(df[df["online.o"].isna()][["id","project","title","online.o","subjects.o","us_lab.o"]].to_string(index=False))

print("\nsubjects.o overall:\n", df["subjects.o"].value_counts(dropna=False))
print("\nsubjects.r overall:\n", df["subjects.r"].value_counts(dropna=False))
print("\ncrosstab online.o x subjects.o (whole file):")
print(pd.crosstab(df["online.o"].fillna(-1), df["subjects.o"]))

