import pandas as pd
pd.set_option('display.width',240); pd.set_option('display.max_colwidth',55)
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv", keep_default_na=False, na_values=["NA",""])
r  = pd.read_csv("data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv", keep_default_na=False, na_values=["NA",""])
ee = df[df.project=="ee"].copy()
ee2 = r[r.project=="Experimental Economics"].copy()
print("file2 'Experimental Economics' rows:", len(ee2))
print(ee2[["study","no","nr","po","pr","pm_belief"]].to_string(index=False))
ee["last1"] = ee["authors.o"].str.split(" and ").str[0].str.split().str[-1].str.lower()
ee2["last2"] = ee2["study"].str.extract(r"([A-Za-z\-]+)")[0].str.lower()
m = ee2.merge(ee[["id","last1","title"]], left_on="last2", right_on="last1", how="left")
print("\njoin coverage file2-ee -> file1-ee by first-author surname:", m["id"].notna().sum(), "/", len(ee2))
print("\nAny column in file2 that could encode setting? dtypes summary:")
print(r.dtypes.to_string())
print("\nNon-numeric distinct values:")
for c in ["study","project"]:
    print(c, r[c].nunique())
print("\n### file1 ee: does the row set change if we filter drop==False / aggregated?")
print("ee drop value counts:", ee["drop"].value_counts(dropna=False).to_dict())
print("ee lab_id NA:", ee["lab_id"].isna().sum(), "| aggregated NA:", ee["aggregated"].isna().sum())
print("\n### Denominator sanity: ee rows / unique id / unique title / unique (title+effect_type):")
print(len(ee), ee.id.nunique(), ee.title.nunique(), ee.duplicated(['title','effect_type']).sum())
print("\n### Marker cross-tab within ee (online.o x subjects.o x us_lab.o):")
print(ee.groupby(["online.o","subjects.o","us_lab.o"], dropna=False).size().to_string())
print("\n### compensation.o x us_lab.o:")
print(pd.crosstab(ee["compensation.o"], ee["us_lab.o"]))
