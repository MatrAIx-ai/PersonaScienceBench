#!/usr/bin/env python3
"""
Average length (pages) of ORIGINAL papers: Experimental Economics (ee) vs Psychology (rpp).

Unit of analysis (primary): unique original article = (title, authors.o, pub_year).
Data: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv  (has `length`)
      data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv
      -> used ONLY for external cross-check of the project label mapping (no joins, no length).

Metric of length = number of PAGES of the original paper (`length` column), not words/print length.
Only projects 'ee' and 'rpp' are used; ml1/ml3 (Many Labs, Social/Cognitive) are excluded.
"""
import numpy as np
import pandas as pd
from scipy import stats

RNG = np.random.default_rng(20261025)
F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
F2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

log_lines = []
def log(*a):
    s = " ".join(str(x) for x in a)
    print(s)
    log_lines.append(s)

# ---------------------------------------------------------------- load + filter
df = pd.read_csv(F1)
log("F1 shape:", df.shape, "| length dtype:", df.length.dtype,
    "| NaN:", int(df.length.isna().sum()), "| zeros:", int((df.length == 0).sum()),
    "| negative:", int((df.length < 0).sum()))

sub = df[df.project.isin(["ee", "rpp"])].copy()
log("rows with project in {ee, rpp}:", len(sub), "->", sub.project.value_counts().to_dict())
log("discipline x project (ee/rpp):\n",
    pd.crosstab(sub.discipline, sub.project).to_string())

# PRIMARY unit: unique original article
KEY = ["title", "authors.o", "pub_year"]
orig = (sub.drop_duplicates(subset=["project"] + KEY)[["project", "id", "length"]]
            .reset_index(drop=True))
log("unique originals: ee =", int((orig.project == "ee").sum()),
    "| rpp =", int((orig.project == "rpp").sum()),
    "| (dropped duplicate O/R rows for same original: rpp",
    int((sub.project == "rpp").sum() - (orig.project == "rpp").sum()), ")")

# ---------------------------------------------------------------- descriptives
def desc(x):
    x = np.asarray(x, dtype=float)
    n = len(x)
    mean = x.mean()
    sd = x.std(ddof=1)
    se = sd / np.sqrt(n)
    tcrit = stats.t.ppf(0.975, n - 1)
    return dict(n=n, mean=mean, sd=sd, se=se,
                ci_lo=mean - tcrit * se, ci_hi=mean + tcrit * se,
                median=np.median(x), q1=np.percentile(x, 25), q3=np.percentile(x, 75),
                min=x.min(), max=x.max())

def boot_ci(x, m=10_000):
    x = np.asarray(x, dtype=float)
    idx = RNG.integers(0, len(x), size=(m, len(x)))
    means = x[idx].mean(axis=1)
    return np.percentile(means, [2.5, 97.5])

res = {}
for p, label in [("ee", "Experimental Economics"), ("rpp", "Psychology (RPP)")]:
    x = orig.loc[orig.project == p, "length"].values
    d = desc(x)
    d["boot_lo"], d["boot_hi"] = boot_ci(x)
    res[p] = d
    log(f"\n=== {label} (project={p}) ===")
    log(f"  n(unique originals) = {d['n']}")
    log(f"  mean = {d['mean']:.2f} pages  (SD = {d['sd']:.2f}, SE = {d['se']:.2f})")
    log(f"  95% CI mean (t)      = [{d['ci_lo']:.2f}, {d['ci_hi']:.2f}]")
    log(f"  95% CI mean (boot)   = [{d['boot_lo']:.2f}, {d['boot_hi']:.2f}]")
    log(f"  median = {d['median']:.1f}, IQR = [{d['q1']:.1f}, {d['q3']:.1f}], range = [{d['min']:.0f}, {d['max']:.0f}]")

# ---------------------------------------------------------------- difference
e = orig.loc[orig.project == "ee", "length"].values
r = orig.loc[orig.project == "rpp", "length"].values
t, pval = stats.ttest_ind(e, r, equal_var=False)
d_mean = e.mean() - r.mean()
se_w = np.sqrt(e.var(ddof=1) / len(e) + r.var(ddof=1) / len(r))
df_w = se_w**4 / ((e.var(ddof=1)/len(e))**2/(len(e)-1) + (r.var(ddof=1)/len(r))**2/(len(r)-1))
tc = stats.t.ppf(0.975, df_w)
# bootstrap CI for the difference of means
bd = (RNG.choice(e, size=(10_000, len(e)), replace=True).mean(axis=1)
      - RNG.choice(r, size=(10_000, len(r)), replace=True).mean(axis=1))
log("\n=== difference ee - rpp (Welch) ===")
log(f"  diff = {d_mean:.2f} pages | 95% CI (Welch, df={df_w:.1f}) = "
    f"[{d_mean - tc*se_w:.2f}, {d_mean + tc*se_w:.2f}] | p = {pval:.3g}")
log(f"  95% CI (bootstrap diff) = [{np.percentile(bd,2.5):.2f}, {np.percentile(bd,97.5):.2f}]")
log(f"  ratio ee/rpp = {e.mean()/r.mean():.2f}x  |  ratio of medians = "
    f"{np.median(e)/np.median(r):.2f}x")

# ---------------------------------------------------------------- sensitivity
log("\n=== sensitivity ===")
# (1) leave out the single suspicious length=1 record (rpp.53)
r_no1 = r[r > 1]
log(f"(1) rpp mean excluding length=1 (rpp.53): n={len(r_no1)}, mean={r_no1.mean():.2f} "
    f"(vs {r.mean():.2f} incl.) -> ratio becomes {e.mean()/r_no1.mean():.2f}x")
# (2) row-level (all O/R rows) instead of unique originals
for p in ["ee", "rpp"]:
    x = sub.loc[sub.project == p, "length"].values
    log(f"(2) row-level (O/R pairs) {p}: n={len(x)}, mean={x.mean():.2f}, median={np.median(x):.1f}")
x_e_rows = sub.loc[sub.project == "ee", "length"].values
x_r_rows = sub.loc[sub.project == "rpp", "length"].values
log(f"(2) row-level diff = {x_e_rows.mean()-x_r_rows.mean():.2f}, ratio = "
    f"{x_e_rows.mean()/x_r_rows.mean():.2f}x")
# (3) restrict to length > 2
for p in ["ee", "rpp"]:
    x = orig.loc[(orig.project == p) & (orig.length > 2), "length"].values
    log(f"(3) length>2 only {p}: n={len(x)}, mean={x.mean():.2f}")
xe3 = orig.loc[(orig.project == "ee") & (orig.length > 2), "length"].values
xr3 = orig.loc[(orig.project == "rpp") & (orig.length > 2), "length"].values
log(f"(3) length>2 diff = {xe3.mean()-xr3.mean():.2f}, ratio = {xe3.mean()/xr3.mean():.2f}x")

# ---------------------------------------------------------------- external cross-check (heuristic)
f2 = pd.read_csv(F2)
log("\n=== external cross-check with replication-success file (labels only; no joins) ===")
log("F2 project counts:", f2.project.value_counts().to_dict())
log("F2 has 'length' column?", "length" in f2.columns, "| F2 columns:", list(f2.columns))
log("heuristic label mapping check: ee n=%d <-> 'Experimental Economics' n=%d ; rpp n=%d(rows)/%d(unique originals) <-> 'Psychology' n=%d"
    % (int((sub.project == 'ee').sum()), int((f2.project == 'Experimental Economics').sum()),
       int((sub.project == 'rpp').sum()), int((orig.project == 'rpp').sum()),
       int((f2.project == 'Psychology').sum())))

with open("out/analysis_log.txt", "w") as fh:
    fh.write("\n".join(log_lines) + "\n")
