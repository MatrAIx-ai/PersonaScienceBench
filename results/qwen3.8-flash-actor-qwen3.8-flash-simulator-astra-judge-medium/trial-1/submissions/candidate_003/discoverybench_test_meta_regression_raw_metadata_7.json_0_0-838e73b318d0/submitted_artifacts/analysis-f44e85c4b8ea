"""
MAIN ANALYSIS (descriptive only) -- question:
"In which domain do the majority of authors tend to be male for both original and replication studies?"

Approved design:
  * headline domain taxonomy = DISCIPLINE (Social / Cognitive / Economics);
    project (ml1/ml3/rpp/ee) is a mandatory parallel cut + discipline x project crosstab.
  * metrics per domain and per side (original 'o', replication 'r'):
      1) pooled author-level male share  = sum(authors_male * n_authors) / sum(n_authors)   [PRIMARY]
      2) share of studies with male majority (ratio > 0.5)
      3) unweighted mean of study-level ratios
      4) unweighted median of study-level ratios
      + n_ties (ratio == 0.5), verdict = pooled share > 0.5 on BOTH sides
  * three units of analysis:
      (a) unit-level: one row per id, aggregated row for ml1/ml3  (PRIMARY)
      (b) raw 927 rows (naive, multi-lab inflated; ml1/ml3 pooled 0.56 replicated 37/22x -> CONTAMINATED)
      (c) unit-level excluding rows with drop == True              (sensitivity)
  * no modelling, no outcome (replicated / relative_es) analysis, no name-based gender inference.
  * file 2 (meta-regression_replication_success_data...) is NOT used: it has no author-gender
    column and no join key to file 1.
"""
import numpy as np, pandas as pd

pd.set_option("display.width", 240)
CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
TOL = 1e-9
R, O = "authors_male.r", "authors_male.o"
NR, NO = "n_authors.r", "n_authors.o"

raw = pd.read_csv(CSV)

# ---------- unit (a): one row per id, aggregated row preferred ----------
def unitize(d):
    rows = []
    for _id, g in d.groupby("id", sort=False):
        agg = g[g["aggregated"] == True]
        rows.append((agg if len(agg) else g).iloc[0])
    return pd.DataFrame(rows).reset_index(drop=True)

unit = unitize(raw)
unit_drop = unit[unit["drop"] != True].reset_index(drop=True)   # (c)
variants = {
    "a_unit_per_id_primary": (unit, "one row per id (aggregated row for ml1/ml3) - PRIMARY"),
    "b_raw_927_rows": (raw, "all 927 rows - NAIVE/CONTAMINATED: ml1/ml3 consortium ratio 0.56|0.5156 copied 37/22x per lab row"),
    "c_unit_excl_drop": (unit_drop, "one row per id, rows with drop==True removed - sensitivity"),
}
TAX = {"discipline": ["Social", "Cognitive", "Economics"], "project": ["ml1", "ml3", "rpp", "ee"]}


def domain_table(d, key, levels):
    recs = []
    for dom in levels:
        s = d[d[key] == dom]
        rec = {"domain": dom, "n_pairs": len(s)}
        # pooled author-level share (PRIMARY)
        for tag, (rat, n) in {"original": (O, NO), "replication": (R, NR)}.items():
            num, den = (s[rat] * s[n]).sum(), s[n].sum()
            rec[f"male_share_{tag}"] = num / den if den else np.nan
            rec[f"male_authors_{tag}"], rec[f"total_authors_{tag}"] = round(num, 3), int(den)
            maj = s[rat] > 0.5 + TOL
            rec[f"share_studies_majority_male_{tag}"] = maj.mean()
            rec[f"n_studies_majority_male_{tag}"] = int(maj.sum())
            rec[f"mean_{tag}"] = s[rat].mean()
            rec[f"median_{tag}"] = s[rat].median()
            rec[f"n_ties_{tag}"] = int((np.abs(s[rat] - 0.5) < TOL).sum())
        rec["verdict_both_gt_0.5"] = bool(rec["male_share_original"] > 0.5 and rec["male_share_replication"] > 0.5)
        rec["verdict_by_share_of_studies"] = bool(rec["share_studies_majority_male_original"] > 0.5
                                                  and rec["share_studies_majority_male_replication"] > 0.5)
        recs.append(rec)
    return pd.DataFrame(recs)


def fmt(t):
    v = t.copy()
    for c in v.columns:
        if v[c].dtype == float:
            v[c] = v[c].round(4)
    return v


HEAD = ["domain", "n_pairs", "male_share_original", "male_share_replication",
        "share_studies_majority_male_o", "share_studies_majority_male_r",
        "mean_o", "mean_r", "median_o", "median_r", "n_ties_o", "n_ties_r", "verdict_both>0.5"]


def rename_for_display(t):
    return t.rename(columns={
        "share_studies_majority_male_original": "share_studies_majority_male_o",
        "share_studies_majority_male_replication": "share_studies_majority_male_r",
        "mean_original": "mean_o", "mean_replication": "mean_r",
        "median_original": "median_o", "median_replication": "median_r",
        "n_ties_original": "n_ties_o", "n_ties_replication": "n_ties_r",
        "verdict_both_gt_0.5": "verdict_both>0.5"})


report, csv_paths = [], []
for vname, (d, vdesc) in variants.items():
    report.append("=" * 110)
    report.append(f"UNIT VARIANT [{vname}]: {vdesc}   | rows={len(d)}, ids={d['id'].nunique()}")
    for key, levels in TAX.items():
        t = domain_table(d, key, levels)
        t.to_csv(f"table_{vname}_{key}.csv", index=False); csv_paths.append(f"table_{vname}_{key}.csv")
        disp = rename_for_display(t)[HEAD + ["verdict_by_share_of_studies"]]
        report.append(f"\n-- taxonomy: {key} --")
        report.append(fmt(disp).to_string(index=False))
    # crosstab discipline x project: counts + pooled shares per cell
    report.append("\n-- crosstab discipline x project --")
    cells = []
    for disc in TAX["discipline"]:
        for prj in TAX["project"]:
            s = d[(d.discipline == disc) & (d.project == prj)]
            if not len(s):
                continue
            cells.append({"discipline": disc, "project": prj, "n_pairs": len(s),
                          "male_share_original": (s[O] * s[NO]).sum() / s[NO].sum(),
                          "male_share_replication": (s[R] * s[NR]).sum() / s[NR].sum(),
                          "share_studies_maj_o": (s[O] > 0.5 + TOL).mean(),
                          "share_studies_maj_r": (s[R] > 0.5 + TOL).mean(),
                          "distinct_replication_ratios": s[R].nunique()})
    ct = pd.DataFrame(cells)
    report.append(fmt(ct).to_string(index=False))
    ct.to_csv(f"crosstab_{vname}.csv", index=False); csv_paths.append(f"crosstab_{vname}.csv")
    # distinct replication ratios inside each domain (consortium warning)
    report.append("\n-- distinct authors_male.r values inside each discipline (consortium concentration) --")
    dd = d.groupby("discipline").agg(n_pairs=("id", "size"), distinct_ratios_r=(R, "nunique"),
                                     top_ratio_r_count=(R, lambda s: s.value_counts().max()),
                                     distinct_ratios_o=(O, "nunique"))
    report.append(dd.to_string())
    report.append("distinct ratio values per discipline -> " +
                  str({k: sorted(round(x, 6) for x in g[R].unique()) for k, g in d.groupby('discipline')}))

# supplementary diagnostic: replication side of ml1/ml3 counted ONCE per project (de-concentrated)
report.append("=" * 110)
report.append("SUPPLEMENTARY (not a required variant): pooled replication share with each ml1/ml3 "
              "consortium team counted once per project instead of once per study")
sup_rows = []
for disc in TAX["discipline"]:
    s = unit[unit.discipline == disc]
    o_num, o_den = (s[O] * s[NO]).sum(), s[NO].sum()
    teams = s[s.project.isin(["ml1", "ml3"])].drop_duplicates("project")
    other = s[~s.project.isin(["ml1", "ml3"])]
    r_num = (teams[R] * teams[NR]).sum() + (other[R] * other[NR]).sum()
    r_den = teams[NR].sum() + other[NR].sum()
    sup_rows.append({"discipline": disc, "n_pairs": len(s),
                     "male_share_original": o_num / o_den,
                     "male_share_replication_consortium_once": r_num / r_den})
sup = pd.DataFrame(sup_rows)
report.append(fmt(sup).to_string(index=False))
sup.to_csv("supplementary_consortium_once.csv", index=False); csv_paths.append("supplementary_consortium_once.csv")

# per-study detail for the winning/losing domains (audit trail)
report.append("=" * 110)
report.append("PER-STUDY DETAIL (unit-level a) - economics/ee block")
ee = unit[unit.discipline == "Economics"][["id", "project", "discipline", NO, O, NR, R, "pub_year"]]
report.append(ee.to_string(index=False))
ee.to_csv("detail_economics_unit.csv", index=False); csv_paths.append("detail_economics_unit.csv")

txt = "\n".join(report)
open("results_report.txt", "w").write(txt)
print(txt)
print("\nCSV artifacts:", csv_paths)
