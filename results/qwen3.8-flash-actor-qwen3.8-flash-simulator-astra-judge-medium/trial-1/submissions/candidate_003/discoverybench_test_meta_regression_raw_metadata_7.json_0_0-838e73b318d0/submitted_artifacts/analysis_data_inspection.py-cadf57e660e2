"""
STEP 1 (INSPECTION ONLY) -- gender-composition question.
Question under study (not answered here): "In which domain do the majority of authors
tend to be male for both original and replication studies?"

This script only inspects the two supplied CSVs: shape, required columns, types/ranges of
authors_male.o / authors_male.r, categorical 'domain' candidates, duplicates, missingness
in the (original, replication) gender pair, and the structure of the second file.
No answer / domain verdict is computed.
"""
import pandas as pd, numpy as np

pd.set_option("display.width", 220)
P_MAIN = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
P_ALT  = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df, df2 = pd.read_csv(P_MAIN), pd.read_csv(P_ALT)
print("#" * 30, "FILE 1: study_data", "#" * 30)
print("shape:", df.shape)

required = ["id","title","authors.o","pub_year","discipline","project","n_authors.o","n_authors.r",
            "authors_male.o","authors_male.r","replicated","relative_es"]
print("\n-- required columns present? --")
for c in required:
    print(f"   {c:18s} {c in df.columns}   dtype={df[c].dtype if c in df.columns else '-'}")
for c in ["authors.r", "authors_male.r"]:
    print(f"   {c:18s} present={c in df.columns}")

print("\n-- authors_male.o / authors_male.r --")
for c in ["authors_male.o", "authors_male.r"]:
    s = df[c]
    print(f"\n   {c}: dtype={s.dtype} min={s.min()} max={s.max()} median={s.median()} mean={s.mean():.4f}")
    print(f"     missing={int(s.isna().sum())}  outside[0,1]={int(((s<0)|(s>1)).sum())}  exactly 0.5={int((s==0.5).sum())}")
    print(f"     n_distinct={s.nunique()} values={sorted(round(v,6) for v in s.unique())}")
    print("     value_counts:", s.value_counts().sort_index().round(0).to_dict())
# recover integer male counts (ratio * n_authors) -> integrality check
for c, n in [("authors_male.o","n_authors.o"), ("authors_male.r","n_authors.r")]:
    k = df[c] * df[n]
    print(f"   integrality of {c}*{n}: non-integral rows = {int((np.abs(k-np.round(k))>1e-6).sum())}")

print("\n-- categorical domain candidates --")
for c in ["discipline","project"]:
    print(f"\n   {c}: nunique={df[c].nunique()} missing={int(df[c].isna().sum())}")
    print(df[c].value_counts(dropna=False).to_string())
print("\n   crosstab discipline x project (row counts):")
print(pd.crosstab(df["discipline"], df["project"], dropna=False).to_string())

print("\n-- duplicates --")
print("   rows:", len(df), " unique id:", df["id"].nunique())
vc = df["id"].value_counts()
print("   ids with >1 row:", int((vc>1).sum()), " rows involved:", int(vc[vc>1].sum()))
print("   rows-per-id distribution:", vc.value_counts().sort_index().to_dict())
print("   fully duplicated rows:", int(df.duplicated().sum()))
g = df.groupby("id").agg(n=("id","size"), n_title=("title","nunique"), n_disc=("discipline","nunique"),
                         n_mo=("authors_male.o","nunique"), n_mr=("authors_male.r","nunique"),
                         n_lab=("lab_id","nunique"), n_agg=("aggregated", lambda s: int((s==True).sum())))
print("   ids with >1 distinct title/discipline/authors_male.o:",
      int((g.n_title>1).sum()), int((g.n_disc>1).sum()), int((g.n_mo>1).sum()))
print("   ids where authors_male.r varies across rows:", int((g.n_mr>1).sum()))
print("   ids with exactly one aggregated=True row:", int((g.n_agg==1).sum()), "/", int((g.n>1).sum()), "multi-row ids")
k3 = ["title","authors.o","pub_year"]
vc2 = df.groupby(k3, dropna=False).size()
print("   duplicate O/R pairs by title+authors.o+pub_year: groups>1 =", int((vc2>1).sum()),
      "| rows in those groups =", int(vc2[vc2>1].sum()), "| distinct original studies =", len(vc2))
print("   (note) 'drop' flag:", df["drop"].value_counts(dropna=False).to_dict())
print("   (note) aggregated flag:", df["aggregated"].value_counts(dropna=False).to_dict())

print("\n-- missingness in the gender pair --")
mo, mr = df["authors_male.o"].notna(), df["authors_male.r"].notna()
print("   both present:", int((mo&mr).sum()), "| o only:", int((mo&~mr).sum()),
      "| r only:", int((~mo&mr).sum()), "| neither:", int((~mo&~mr).sum()))
print("   other columns with missing values (top 10):",
      df.isna().sum().sort_values(ascending=False).head(10).to_dict())

print("\n-- unit-of-analysis preview: one row per id (aggregated row when present) --")
def pick(gg):
    a = gg[gg["aggregated"] == True]
    return (a if len(a) else gg).iloc[[0]]
study = pd.concat([pick(gg) for _, gg in df.groupby("id", sort=False)], ignore_index=True)
print("   study-level rows:", len(study))
print("   per project:\n" + study["project"].value_counts().to_string())
print("   per discipline:\n" + study["discipline"].value_counts().to_string())
print("   discipline x project:\n" + pd.crosstab(study["discipline"], study["project"]).to_string())
print("   distinct authors_male.r values within project (study level):",
      study.groupby("project")["authors_male.r"].nunique().to_dict())

print("\n" + "#" * 30, "FILE 2: replication_success_data", "#" * 30)
print("shape:", df2.shape)
print("columns:", list(df2.columns))
print("author/gender-related columns:", [c for c in df2.columns
      if any(t in c.lower() for t in ["male","female","gender","sex","author","n_auth"])])
print("project values:\n" + df2["project"].value_counts(dropna=False).to_string())
print("join keys vs file 1 -- exact overlap with title:", len(set(df2.study) & set(df.title)),
      "| with authors.o:", len(set(df2.study) & set(df["authors.o"].astype(str))))
print("\nNo answer is produced by this script (inspection stage).")
