"""Consolidates the run into final markdown tables + the hypothesis string (descriptive only)."""
import pandas as pd

def md(df):
    cols=list(df.columns)
    lines=["| "+" | ".join(str(c) for c in cols)+" |","|"+"|".join(["---"]*len(cols))+"|"]
    for _,r in df.iterrows():
        lines.append("| "+" | ".join("" if pd.isna(r[c]) else (f"{r[c]:.4f}" if isinstance(r[c],float) and not isinstance(r[c],bool) else str(r[c])) for c in cols)+" |")
    return "\n".join(lines)

HEAD = ["domain","n_pairs","male_share_original","male_share_replication",
        "share_studies_majority_male_o","share_studies_majority_male_r",
        "mean_o","mean_r","median_o","median_r","n_ties_o","n_ties_r",
        "verdict_both>0.5","verdict_by_share_of_studies"]
VAR = {"a_unit_per_id_primary":"(a) unit-level, one row per id, aggregated row for ml1/ml3 — PRIMARY (n=141)",
       "b_raw_927_rows":"(b) all 927 rows — NAIVE/CONTAMINATED: ml1/ml3 consortium ratio copied into 37/22 lab rows",
       "c_unit_excl_drop":"(c) unit-level, drop==True rows excluded — sensitivity (n=131)"}
L=[]
L.append("# Final tables — 'In which domain do the majority of authors tend to be male for both original and replication studies?'\n")
L.append("Unit of analysis = one original–replication pair (id). Male share is taken from the supplied "
         "`authors_male.o/.r` ratios × `n_authors.o/.r`; no name-based gender inference, no modelling, "
         "no use of `replicated`/`relative_es`.\n")
L.append("PRIMARY metric = pooled author-level male share = Σ(ratio·n_authors)/Σ(n_authors) within a domain; "
         "threshold strictly > 0.5 on BOTH sides; ratio == 0.5 counted as a tie (no majority).\n")
for v,desc in VAR.items():
    L.append(f"\n## {desc}\n")
    for tax in ["discipline","project"]:
        t=pd.read_csv(f"table_{v}_{tax}.csv")
        d=t.rename(columns={"share_studies_majority_male_original":"share_studies_majority_male_o",
                            "share_studies_majority_male_replication":"share_studies_majority_male_r",
                            "mean_original":"mean_o","mean_replication":"mean_r",
                            "median_original":"median_o","median_replication":"median_r",
                            "n_ties_original":"n_ties_o","n_ties_replication":"n_ties_r",
                            "verdict_both_gt_0.5":"verdict_both>0.5"})[HEAD]
        for c in d.columns:
            if d[c].dtype==float: d[c]=d[c].round(4)
        L.append(f"### taxonomy: {tax}\n\n{md(d)}\n")
    ct=pd.read_csv(f"crosstab_{v}.csv")
    for c in ct.columns:
        if ct[c].dtype==float: ct[c]=ct[c].round(4)
    L.append(f"### crosstab discipline × project ({v})\n\n{md(ct)}\n")
sup=pd.read_csv("supplementary_consortium_once.csv")
for c in sup.columns:
    if sup[c].dtype==float: sup[c]=sup[c].round(4)
L.append("\n## Supplementary diagnostic: replication side with each ml1/ml3 consortium team counted ONCE per project\n")
L.append(md(sup)+"\n")
open("final_domain_tables.md","w").write("\n".join(L))
print("\n".join(L)[:3000])
print("\n...[full file: final_domain_tables.md]")
