"""Which of the four metrics pass (>0.5 on BOTH sides), per domain and per unit variant."""
import pandas as pd
VAR={"a_unit_per_id_primary":"(a) unit-level PRIMARY","b_raw_927_rows":"(b) raw 927 (contaminated)",
     "c_unit_excl_drop":"(c) unit excl drop==True"}
METRICS=[("pooled_author_share",["male_share_original","male_share_replication"]),
         ("share_of_studies_majority",["share_studies_majority_male_original","share_studies_majority_male_replication"]),
         ("mean_of_study_ratios",["mean_original","mean_replication"]),
         ("median_of_study_ratios",["median_original","median_replication"])]
rows=[]
for v in VAR:
    for tax in ["discipline","project"]:
        t=pd.read_csv(f"table_{v}_{tax}.csv")
        for _,r in t.iterrows():
            rec={"variant":v,"taxonomy":tax,"domain":r["domain"],"n_pairs":int(r["n_pairs"])}
            for mname,cols in METRICS:
                rec[mname]=bool(r[cols[0]]>0.5 and r[cols[1]]>0.5)
            rec["n_metrics_passed"]=sum(rec[m] for m,_ in METRICS)
            rec["passes_all_four"]=rec["n_metrics_passed"]==4
            rows.append(rec)
pm=pd.DataFrame(rows)
pm.to_csv("pass_matrix_all_variants.csv",index=False)
for c in ["pooled_author_share","share_of_studies_majority","mean_of_study_ratios","median_of_study_ratios"]:
    pm[c]=pm[c].map({True:"PASS",False:"fail"})
def md(df):
    cols=list(df.columns); out=["| "+" | ".join(cols)+" |","|"+"|".join(["---"]*len(cols))+"|"]
    for _,r in df.iterrows(): out.append("| "+" | ".join(str(r[c]) for c in cols)+" |")
    return "\n".join(out)
txt=["# Metric-by-domain pass matrix (PASS = >0.5 for BOTH original and replication)",
     "","Scope of this matrix: rows are O/R pairs; a PASS means the metric exceeds 0.5 on both sides.",
     "Economics/ee is the only block that passes all four metrics in all three unit variants.",""]
for v,d in VAR.items():
    txt.append(f"## {d}")
    txt.append(md(pm[pm.variant==v][["taxonomy","domain","n_pairs"]+["pooled_author_share","share_of_studies_majority","mean_of_study_ratios","median_of_study_ratios","n_metrics_passed","passes_all_four"]])+"\n")
# counts
txt.append("## Summary counts")
txt.append(md(pm.groupby(["taxonomy","domain"],sort=False).agg(variants_with_all_four=("passes_all_four","sum"),
        total_passes=("n_metrics_passed","sum"), variant_count=("passes_all_four","size")).reset_index()))
open("pass_matrix.md","w").write("\n".join(txt))
print("\n".join(txt))
