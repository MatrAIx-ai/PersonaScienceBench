"""Independent re-computation of the headline numbers from integer author counts."""
import pandas as pd, numpy as np
raw = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
rows=[]
for _id,g in raw.groupby("id",sort=False):
    a=g[g["aggregated"]==True]; rows.append((a if len(a) else g).iloc[0])
u=pd.DataFrame(rows)
u["male_o"]=(u["authors_male.o"]*u["n_authors.o"]).round()
print("unit rows:", len(u), "| non-integral male_o:", int((np.abs(u['authors_male.o']*u['n_authors.o']-u['male_o'])>1e-9).sum()))
for disc in ["Economics","Social","Cognitive"]:
    s=u[u.discipline==disc]
    mo,no=int(s.male_o.sum()), int(s["n_authors.o"].sum())
    mr,nr=(s["authors_male.r"]*s["n_authors.r"]).sum(), int(s["n_authors.r"].sum())
    print(f"{disc:10s} n={len(s):3d} | original: {mo}/{no} = {mo/no:.4f} | replication: {mr:.3f}/{nr} = {mr/nr:.4f}"
          f" | studies maj-o {int((s['authors_male.o']>0.5).sum())}/{len(s)}"
          f" maj-r {int((s['authors_male.r']>0.5).sum())}/{len(s)}"
          f" ties-o {int((s['authors_male.o']==0.5).sum())} ties-r {int((s['authors_male.r']==0.5).sum())}")
ee=u[u.discipline=="Economics"]
print("\nEconomics manual detail (male_o/male_r):")
print(ee[["id","n_authors.o","male_o","n_authors.r","authors_male.r"]].assign(
      male_r=lambda d:(d["authors_male.r"]*d["n_authors.r"])).to_string(index=False))
print("sum n_authors.o", ee["n_authors.o"].sum(), "sum male_o", ee.male_o.sum(),
      "| sum n_authors.r", ee["n_authors.r"].sum(), "sum male_r", (ee["authors_male.r"]*ee["n_authors.r"]).sum())
# margin-to-0.5 for every discipline, unit-level
print("\nmargin of pooled replication share over 0.5 (unit-level):")
for disc in ["Economics","Social","Cognitive"]:
    s=u[u.discipline==disc]; sh=(s["authors_male.r"]*s["n_authors.r"]).sum()/s["n_authors.r"].sum()
    print(f"  {disc:10s} {sh:.4f}  margin {sh-0.5:+.4f}")
