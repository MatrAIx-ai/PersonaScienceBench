#!/usr/bin/env python3
"""
Demographic disparities in median wealth in 1985 among ever-incarcerated NLSY79 respondents.

Design (agreed with researcher):
  * Outcome: composite_wealth_1985 (nominal 1985 $, signed; zeros/negatives retained).
  * Exposure: ever_jailed == 1 (codebook: jailed 1985-1994) -> PROSPECTIVE association,
    not a causal effect on 1985 wealth.
  * Primary lens: within-race within-sex incarcerated-vs-not.
  * Race comparisons inside the incarcerated group at MATCHED SEX.
  * Estimation: median + stratified percentile bootstrap (B=10,000; gaps recomputed per
    replicate), Mann-Whitney + Cliff's delta, mean-vs-median split, zero-floor / top-1%
    winsorised sensitivity, de-duplication sensitivity, 1990/1996 secondary context.
Run: python3 analysis/wealth_disparity_analysis.py
"""
import numpy as np
import pandas as pd
from scipy.stats import mannwhitneyu

pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 50)

RNG = np.random.default_rng(20261023)
B = 10_000
OUT = "analysis/outputs"
RAW = "data/nls_incarceration_processed.csv"
W = "composite_wealth_1985"

# 'hipanic' is the raw (misspelled) label in the file; kept internally, mapped for display only
DISPLAY = {"hipanic": "Hispanic", "black": "Black", "white": "White",
           "male": "men", "female": "women"}
def disp(x):
    return DISPLAY.get(x, x)

RACES = ["black", "hipanic", "white"]
SEXES = ["male", "female"]

df = pd.read_csv(RAW)
n_rows_raw = len(df)

log = []
def say(*a):
    s = " ".join(str(x) for x in a)
    print(s)
    log.append(s)

def cell_stats(v):
    v = np.asarray(v, float)
    return dict(n=v.size, median=np.median(v), mean=v.mean(),
                p25=np.percentile(v, 25), p75=np.percentile(v, 75),
                share_zero=100 * np.mean(v == 0), share_neg=100 * np.mean(v < 0))

def boot_median(v, B=B, rng=RNG):
    v = np.asarray(v, float)
    if v.size < 2:
        return (np.nan, np.nan), np.array([np.nan])
    idx = rng.integers(0, v.size, size=(B, v.size))
    meds = np.median(v[idx], axis=1)
    return tuple(np.percentile(meds, [2.5, 97.5])), meds

def boot_gap(a, b, B=B, rng=RNG):
    """Resample both strata jointly per replicate; return gap distribution + CI."""
    a = np.asarray(a, float); b = np.asarray(b, float)
    ga = np.median(a[rng.integers(0, a.size, size=(B, a.size))], axis=1)
    gb = np.median(b[rng.integers(0, b.size, size=(B, b.size))], axis=1)
    gap = ga - gb
    return dict(gap_obs=np.median(a) - np.median(b),
                gap_boot_med=np.median(gap),
                lo=np.percentile(gap, 2.5), hi=np.percentile(gap, 97.5)), gap

def mwu(a, b):
    u = mannwhitneyu(a, b, alternative="two-sided")
    return u.pvalue, 2 * u.statistic / (len(a) * len(b)) - 1

say("=" * 96)
say("0. INPUT INTEGRITY")
say("=" * 96)
say(f"rows={n_rows_raw}  cols={list(df.columns)}  nulls={int(df.isna().sum().sum())}")
say(f"ever_jailed==1: n={int(df.ever_jailed.sum())} ({100*df.ever_jailed.mean():.2f}% of sample)")
say(f"race labels: {sorted(df.race.unique())}  <- 'hipanic' is the raw misspelling of Hispanic"
    f" (3 categories, not 4)")
say(f"exact duplicate rows: {int(df.duplicated().sum())} (retained for headline numbers)")

say("")
say("=" * 96)
say("1. CELL TABLE (1985 wealth): median [bootstrap 95% CI], n, share-zero, share-negative")
say("=" * 96)
rows = []
for ej in (1, 0):
    f = df[df.ever_jailed == ej]
    cells = [(("ALL", "ALL"), f[W].values)]
    cells += [((r, "ALL"), f[f.race == r][W].values) for r in RACES]
    cells += [((("ALL"), s), f[f.sex == s][W].values) for s in SEXES]
    cells += [((r, s), f[(f.race == r) & (f.sex == s)][W].values)
              for r in RACES for s in SEXES]
    for (r, s), v in cells:
        if v.size == 0:
            continue
        st = cell_stats(v); ci, _ = boot_median(v)
        flag = ""
        if ej == 1 and v.size < 20:
            flag = "THIN n<20" + ("; median pinned at 0" if st["share_zero"] > 70 else "")
        rows.append(dict(ever_jailed=ej, race=("ALL" if r == "ALL" else disp(r)),
                         sex=("ALL" if s == "ALL" else disp(s)),
                         n=st["n"], median=st["median"], ci_lo=ci[0], ci_hi=ci[1],
                         share_zero=st["share_zero"], share_neg=st["share_neg"],
                         mean=st["mean"], p25=st["p25"], p75=st["p75"], flag=flag))
cells_t = pd.DataFrame(rows)
cells_t.to_csv(f"{OUT}/table1_cell_medians_1985.csv", index=False)
fmt = lambda x: f"{x:,.1f}"
cols = ["race", "sex", "n", "median", "ci_lo", "ci_hi", "share_zero", "share_neg",
        "mean", "p25", "p75", "flag"]
say("\n--- ever_jailed == 1 (INCARCERATED GROUP) ---")
say(cells_t[cells_t.ever_jailed == 1][cols].to_string(index=False, float_format=fmt))
say("\n--- ever_jailed == 0 (reference, matched cells) ---")
say(cells_t[cells_t.ever_jailed == 0][cols].to_string(index=False, float_format=fmt))

say("")
say("=" * 96)
say("2. GAP TABLE (1985): incarcerated vs NOT incarcerated, WITHIN stratum")
say("   (bootstrap CI recomputed on both strata in every replicate; MWU p + Cliff's delta)")
say("=" * 96)
strata = [("ALL", "ALL"), ("ALL", "male")] + [(r, "male") for r in RACES] + \
         [("ALL", "female")] + [(r, "female") for r in RACES]
rows = []
for r, s in strata:
    m = (df.race == r) if r != "ALL" else np.ones(len(df), bool)
    n = (df.sex == s) if s != "ALL" else np.ones(len(df), bool)
    a = df[(df.ever_jailed == 1) & m & n][W].values
    b = df[(df.ever_jailed == 0) & m & n][W].values
    g, gap = boot_gap(a, b)
    p, d = mwu(a, b)
    role = ("DESCRIPTIVE (sex-confounded)" if (r == "ALL" and s == "ALL") else
            "PRIMARY" if s == "male" and r != "ALL" else
            "DESCRIPTIVE (sex-pooled)" if r == "ALL" else
            "DESCRIPTIVE n<20" if len(a) < 20 else "PRIMARY")
    rows.append(dict(stratum=("ALL" if r == "ALL" else disp(r)) + " / " +
                          ("ALL" if s == "ALL" else disp(s)),
                     n_jailed=len(a), n_not=len(b),
                     med_jailed=np.median(a), med_not=np.median(b),
                     dollar_gap=g["gap_obs"], gap_lo=g["lo"], gap_hi=g["hi"],
                     ratio=(np.nan if np.median(b) == 0 else np.median(a) / np.median(b)),
                     MWU_p=p, cliffs_delta=d,
                     pct_repl_jailed_lower=100 * float(np.mean(gap < 0)), role=role))
gaps = pd.DataFrame(rows)
gaps.to_csv(f"{OUT}/table2_within_stratum_gaps_1985.csv", index=False)
say(gaps.to_string(index=False, float_format=lambda x: f"{x:,.4g}"))

say("")
say("=" * 96)
say("2b. RATIO bootstrap CIs (jailed median / not-jailed median) where denominator > 0")
say("=" * 96)
rows = []
for r, s in strata:
    m = (df.race == r) if r != "ALL" else np.ones(len(df), bool)
    n = (df.sex == s) if s != "ALL" else np.ones(len(df), bool)
    a = df[(df.ever_jailed == 1) & m & n][W].values
    b = df[(df.ever_jailed == 0) & m & n][W].values
    ga = np.median(a[RNG.integers(0, a.size, size=(B, a.size))], axis=1)
    gb = np.median(b[RNG.integers(0, b.size, size=(B, b.size))], axis=1)
    ok = gb != 0
    rt = ga[ok] / gb[ok]
    rows.append(dict(stratum=("ALL" if r == "ALL" else disp(r)) + " / " +
                          ("ALL" if s == "ALL" else disp(s)),
                     ratio_obs=(np.nan if np.median(b) == 0 else np.median(a) / np.median(b)),
                     ratio_lo=np.percentile(rt, 2.5), ratio_hi=np.percentile(rt, 97.5),
                     pct_rep_denom_nonzero=100 * ok.mean()))
ratios = pd.DataFrame(rows)
ratios.to_csv(f"{OUT}/table2b_ratio_bootstrap.csv", index=False)
say(ratios.to_string(index=False, float_format=lambda x: f"{x:,.4g}"))

say("")
say("=" * 96)
say("3. WITHIN THE INCARCERATED GROUP: race at MATCHED SEX + pooled sex contrast")
say("=" * 96)
J = df[df.ever_jailed == 1]
rows = []
for s in SEXES:
    for a_r, b_r in [("black", "white"), ("hipanic", "white"), ("black", "hipanic")]:
        va = J[(J.race == a_r) & (J.sex == s)][W].values
        vb = J[(J.race == b_r) & (J.sex == s)][W].values
        g, gap = boot_gap(va, vb)
        p, d = mwu(va, vb)
        rows.append(dict(comparison=f"jailed {disp(a_r)} {disp(s)}  vs  jailed {disp(b_r)} {disp(s)}",
                         n_a=va.size, n_b=vb.size, med_a=np.median(va), med_b=np.median(vb),
                         gap_a_minus_b=g["gap_obs"], gap_lo=g["lo"], gap_hi=g["hi"],
                         MWU_p=p, cliffs_delta=d,
                         pct_repl_a_higher=100 * float(np.mean(gap > 0)),
                         flag=("PRIMARY" if va.size >= 20 and vb.size >= 20 else "THIN n<20")))
va = J[J.sex == "female"][W].values
vb = J[J.sex == "male"][W].values
g, gap = boot_gap(va, vb)
p, d = mwu(va, vb)
rows.append(dict(comparison="jailed WOMEN pooled  vs  jailed MEN pooled",
                 n_a=va.size, n_b=vb.size, med_a=np.median(va), med_b=np.median(vb),
                 gap_a_minus_b=g["gap_obs"], gap_lo=g["lo"], gap_hi=g["hi"],
                 MWU_p=p, cliffs_delta=d, pct_repl_a_higher=100 * float(np.mean(gap > 0)),
                 flag="POOLED SEX CONTRAST"))
within = pd.DataFrame(rows)
within.to_csv(f"{OUT}/table3_within_incarcerated.csv", index=False)
say(within.to_string(index=False, float_format=lambda x: f"{x:,.4g}"))

say("")
say("=" * 96)
say("4. ROBUSTNESS A: mean-vs-median split (is the gap tail-driven?)")
say("=" * 96)
labels = [("ALL jailed", df.ever_jailed == 1), ("ALL not jailed", df.ever_jailed == 0)]
for r in RACES:
    for ej, tag in [(1, "jailed"), (0, "not-jailed")]:
        labels.append((f"{tag} {disp(r)} men",
                       (df.ever_jailed == ej) & (df.race == r) & (df.sex == "male")))
for lbl, s in labels:
    v = df[s][W].values
    say(f"  {lbl:22s} n={v.size:6d}  median={np.median(v):10,.0f}  mean={v.mean():10,.0f}"
        f"  p25={np.percentile(v,25):9,.0f}  p75={np.percentile(v,75):10,.0f}"
        f"  zero={100*np.mean(v==0):5.1f}%")

say("")
say("=" * 96)
say("5. ROBUSTNESS B: zero-floor (negatives->0) and top-1% winsorised medians, men")
say("=" * 96)
cut = np.percentile(df[W], 99)
df["_floor"] = df[W].clip(lower=0)
df["_win"] = df[W].clip(upper=cut)
say(f"  top-1% winsorisation cut = {cut:,.0f}")
MEAS = {W: "as recorded", "_floor": "zero-floor", "_win": "top-1% winsorised"}
rows = []
for r in RACES:
    for col in [W, "_floor", "_win"]:
        a = df[(df.ever_jailed == 1) & (df.race == r) & (df.sex == "male")][col].values
        b = df[(df.ever_jailed == 0) & (df.race == r) & (df.sex == "male")][col].values
        g, gap = boot_gap(a, b)
        rows.append(dict(race=disp(r), measure=MEAS[col], med_jailed=np.median(a),
                         med_not=np.median(b), gap=g["gap_obs"], gap_lo=g["lo"], gap_hi=g["hi"],
                         sign_pct_repl_neg=100 * float(np.mean(gap < 0))))
sens = pd.DataFrame(rows)
sens.to_csv(f"{OUT}/table4_transform_sensitivity_men.csv", index=False)
say(sens.to_string(index=False, float_format=lambda x: f"{x:,.0f}"))

say("")
say("=" * 96)
say("6. ROBUSTNESS C: de-duplication sensitivity")
say("=" * 96)
dd = df.drop_duplicates()
say(f"  rows dropped: {n_rows_raw - len(dd)} of {n_rows_raw} "
    f"({100*(n_rows_raw-len(dd))/n_rows_raw:.1f}%)")
say(f"  ever_jailed==1 dropped: {int(df.ever_jailed.sum()) - int(dd.ever_jailed.sum())} "
    f"(289 -> {int(dd.ever_jailed.sum())})")
rows = []
for r in RACES:
    for name, frame in [("headline (dupes kept)", df), ("de-duplicated", dd)]:
        a = frame[(frame.ever_jailed == 1) & (frame.race == r) & (frame.sex == "male")][W].values
        b = frame[(frame.ever_jailed == 0) & (frame.race == r) & (frame.sex == "male")][W].values
        g, gap = boot_gap(a, b)
        rows.append(dict(race=disp(r), frame=name, n_jailed=a.size, n_not=b.size,
                         med_jailed=np.median(a), med_not=np.median(b),
                         gap=g["gap_obs"], gap_lo=g["lo"], gap_hi=g["hi"],
                         pct_repl_jailed_lower=100 * float(np.mean(gap < 0))))
ddt = pd.DataFrame(rows)
ddt.to_csv(f"{OUT}/table5_dedup_sensitivity_men.csv", index=False)
say(ddt.to_string(index=False, float_format=lambda x: f"{x:,.0f}"))
flips = [disp(r) for r in RACES
         if len(set(np.sign(ddt[ddt.race == disp(r)].gap.fillna(0)).tolist())) > 1]
say(f"  DIRECTION FLIPS after de-dup: {flips if flips else 'NONE'}")
# also dedup effect on within-incarcerated race contrasts (men)
for a_r, b_r in [("black", "white"), ("hipanic", "white"), ("black", "hipanic")]:
    h = [np.median(f[(f.ever_jailed == 1) & (f.race == a_r) & (f.sex == "male")][W]) -
         np.median(f[(f.ever_jailed == 1) & (f.race == b_r) & (f.sex == "male")][W])
         for f in (df, dd)]
    say(f"  within-jailed men {disp(a_r)}-{disp(b_r)} gap: headline {h[0]:,.0f} "
        f"-> dedup {h[1]:,.0f} | flip: {np.sign(h[0]) != np.sign(h[1]) and 0 not in h}")

say("")
say("=" * 96)
say("7. SECONDARY CONTEXT (not carrying the claim): 1985 -> 1990 -> 1996, jailed men")
say("=" * 96)
rows = []
for yr in ["1985", "1990", "1996"]:
    col = f"composite_wealth_{yr}"
    for r in RACES:
        a = df[(df.ever_jailed == 1) & (df.race == r) & (df.sex == "male")][col].values
        b = df[(df.ever_jailed == 0) & (df.race == r) & (df.sex == "male")][col].values
        rows.append(dict(year=yr, race=disp(r), med_jailed=np.median(a), med_not=np.median(b),
                         gap=np.median(a) - np.median(b),
                         ratio=(np.nan if np.median(b) == 0 else np.median(a) / np.median(b)),
                         zero_jailed=100 * np.mean(a == 0), zero_not=100 * np.mean(b == 0)))
yrt = pd.DataFrame(rows)
yrt.to_csv(f"{OUT}/table6_year_trend_men.csv", index=False)
say(yrt.to_string(index=False, float_format=lambda x: f"{x:,.3g}"))
say("")
for yr in ["1985", "1990", "1996"]:
    col = f"composite_wealth_{yr}"
    a = df[df.ever_jailed == 1][col].values; b = df[df.ever_jailed == 0][col].values
    say(f"  ALL jailed vs ALL not jailed {yr}: {np.median(a):10,.0f} vs {np.median(b):10,.0f}"
        f"  (gap {np.median(a)-np.median(b):10,.0f})")

say("")
say("=" * 96)
say("8. HEADLINE FACTS FOR THE HYPOTHESIS")
say("=" * 96)
for r in RACES:
    a = df[(df.ever_jailed == 1) & (df.race == r) & (df.sex == "male")][W].values
    b = df[(df.ever_jailed == 0) & (df.race == r) & (df.sex == "male")][W].values
    say(f"  {disp(r):9s} MEN  jailed median {np.median(a):9,.0f} vs not-jailed {np.median(b):9,.0f}"
        f"  | jailed n={a.size:3d} zero {100*np.mean(a==0):5.1f}% "
        f"| not zero {100*np.mean(b==0):5.1f}%")
for r in RACES:
    a = df[(df.ever_jailed == 1) & (df.race == r) & (df.sex == "female")][W].values
    b = df[(df.ever_jailed == 0) & (df.race == r) & (df.sex == "female")][W].values
    say(f"  {disp(r):9s} WOMEN jailed median {np.median(a):9,.0f} (n={a.size:2d}, "
        f"{100*np.mean(a==0):5.1f}% exactly zero) vs not-jailed {np.median(b):9,.0f} "
        f"(n={b.size}) [THIN]")
say(f"  POOLED jailed women {np.median(va):,.0f} (n={va.size}, {100*np.mean(va==0):.1f}% zero)"
    f" vs pooled jailed men {np.median(vb):,.0f} (n={vb.size}, {100*np.mean(vb==0):.1f}% zero)")
say(f"  ALL jailed {np.median(df[df.ever_jailed==1][W]):,.0f} vs ALL not jailed "
    f"{np.median(df[df.ever_jailed==0][W]):,.0f}")


say("")
say("=" * 96)
say("9. IS THE SHIFT BOTTOM-ONLY OR DISTRIBUTION-WIDE? quantile gaps, jailed vs not (men)")
say("=" * 96)
QS=[25,50,75,90]
rows=[]
for r in RACES:
    a=df[(df.ever_jailed==1)&(df.race==r)&(df.sex=="male")][W].values
    b=df[(df.ever_jailed==0)&(df.race==r)&(df.sex=="male")][W].values
    d=dict(race=disp(r))
    for q in QS:
        d[f"p{q}_jailed"]=np.percentile(a,q); d[f"p{q}_not"]=np.percentile(b,q)
    for q in QS:
        d[f"gap_p{q}"]=np.percentile(a,q)-np.percentile(b,q)
    rows.append(d)
q=pd.DataFrame(rows)
q.to_csv(f"{OUT}/table7_quantile_gaps_men.csv", index=False)
say(q[["race"]+[f"gap_p{x}" for x in QS]].to_string(index=False,float_format=lambda x:f"{x:,.0f}"))
say("")
say("  distribution-wide check ALL jailed vs ALL not jailed:")
a=df[df.ever_jailed==1][W].values; b=df[df.ever_jailed==0][W].values
for q_ in QS:
    say(f"    p{q_}: {np.percentile(a,q_):9,.0f} vs {np.percentile(b,q_):9,.0f} "
        f"(gap {np.percentile(a,q_)-np.percentile(b,q_):9,.0f})")
say(f"    mean/median ratio: jailed {np.mean(a)/max(np.median(a),1):.1f}x vs not {np.mean(b)/max(np.median(b),1):.1f}x")

with open(f"{OUT}/run_log.txt","w") as fh:
    fh.write("\n".join(log)+"\n")
print("\n[done] tables + run_log written to", OUT)
