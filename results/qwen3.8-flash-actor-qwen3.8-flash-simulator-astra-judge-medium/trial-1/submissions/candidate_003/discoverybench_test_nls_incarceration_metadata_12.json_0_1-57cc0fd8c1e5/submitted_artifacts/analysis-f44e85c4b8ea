"""
FINAL v2: jail history (1985-1994) x baseline (1985) asset position -> wealth 1996, black respondents.
'income level' is UNMEASURED in this file; pre-window asset position is the proxy. Unweighted sample
statistics; associational language only. Corrected permutation tests (statistics centred on their null).
"""
import numpy as np, pandas as pd
from scipy import stats
rng = np.random.default_rng(31337)
W85,W90,W96 = "composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"
STR = ["S1 none(<=0)","S2 low-pos(1-5k)","S3 high(>5k)"]
SL = lambda x: np.arcsinh(np.asarray(x,float)/1000.)

def ps(j,n):      # P(not > jailed)+.5P(tie); null 0.5
    j,n = np.asarray(j,float),np.asarray(n,float)
    return ((n[None,:]>j[:,None]).sum()+.5*(n[None,:]==j[:,None]).sum())/(len(j)*len(n))
# --- statistics, each with its null value; tests use |stat - null| >= |obs - null|
STATS = {
 "gap_med"      : (lambda a,b: np.median(a)-np.median(b), 0.),
 "gap_mean"     : (lambda a,b: a.mean()-b.mean(), 0.),
 "log_ratio_mean": (lambda a,b: np.log(a.mean()/b.mean()) if b.mean()>0 and a.mean()>0 else np.nan, 0.),
 "log_ratio_p75": (lambda a,b: np.log(np.percentile(a,75)/np.percentile(b,75)) if np.percentile(b,75)>0 and np.percentile(a,75)>0 else np.nan, 0.),
 "ps_minus_half": (lambda a,b: ps(a,b)-0.5, 0.),
 "gap_share_pos": (lambda a,b: (a>0).mean()-(b>0).mean(), 0.),
 "d_loglike"    : (lambda a,b: SL(a).mean()-SL(b).mean(), 0.),
}
def perm_p(x,y,name,n=10000):
    f,null = STATS[name]; obs = f(x,y)
    if not np.isfinite(obs): return np.nan
    z=np.concatenate([x,y]); k=len(x); c=0
    for _ in range(n):
        p=rng.permutation(z); v=f(p[:k],p[k:])
        if np.isfinite(v) and abs(v-null) >= abs(obs-null)-1e-12: c+=1
    return (c+1)/(n+1)
def boot(x,y,f,B=4000):
    x,y=np.asarray(x,float),np.asarray(y,float); v=np.array([f(rng.choice(x,len(x),True),rng.choice(y,len(y),True)) for _ in range(B)])
    v=v[np.isfinite(v)]; return np.percentile(v,[2.5,97.5])

def analyse(d, tag):
    j=d.loc[d.ever_jailed==1]; n=d.loc[d.ever_jailed==0]
    j96,n96=j[W96].values,n[W96].values; j85,n85=j[W85].values,n[W85].values
    r=dict(group=tag,n_j=len(j),n_n=len(n))
    for lab,(f,_) in STATS.items():
        r[lab]=f(j96,n96)
        lo,hi=boot(j96,n96,f); r[lab+"_lo"],r[lab+"_hi"]=lo,hi
        r["p_"+lab]=perm_p(j96,n96,lab,5000)
    r["med96_j"],r["med96_n"]=np.median(j96),np.median(n96)
    r["mean96_j"],r["mean96_n"]=j96.mean(),n96.mean()
    r["share_pos_j"],r["share_pos_n"]=(j96>0).mean(),(n96>0).mean()
    r["med96_pos_j"]=np.median(j96[j96>0]) if (j96>0).any() else np.nan
    r["med96_pos_n"]=np.median(n96[n96>0]) if (n96>0).any() else np.nan
    r["log_ratio_med_pos"]=np.log(r["med96_pos_j"]/r["med96_pos_n"]) if r["med96_pos_n"]>0 and r["med96_pos_j"]>0 else np.nan
    # baseline imbalance inside stratum
    for lab in ["gap_med","log_ratio_mean","d_loglike"]:
        f,_=STATS[lab]; r["B85_"+lab]=f(j85,n85); r["B85_p_"+lab]=perm_p(j85,n85,lab,4000)
    # SECONDARY change-based (ratio-to-baseline: common inflation cancels in the ratio)
    jp,np_=j85>0,n85>0
    if jp.sum()>=5:
        A=np.vstack([j85[jp],j96[jp]]).T; Bv=np.vstack([n85[np_],n96[np_]]).T
        rr=lambda M: np.median(M[:,1]/M[:,0])
        r["ratio96_85_j"],r["ratio96_85_n"]=rr(A),rr(Bv)
        r["log_ratio_of_ratios"]=np.log(rr(A)/rr(Bv)) if rr(Bv)>0 else np.nan
        v=[]
        for _ in range(3000):
            a=rr(A[rng.integers(0,len(A),len(A))]); b=rr(Bv[rng.integers(0,len(Bv),len(Bv))])
            if b>0 and a>0: v.append(np.log(a/b))
        if v: r["lrr_lo"],r["lrr_hi"]=np.percentile(v,[2.5,97.5])
        # permutation p for log ratio-of-ratios on paired (base,end) rows
        obs=r["log_ratio_of_ratios"]; pool=np.vstack([A,Bv]); k=len(A); c=0; N=4000
        for _ in range(N):
            p=pool[rng.permutation(len(pool))]; a=rr(p[:k]); b=rr(p[k:])
            if b>0 and a>0 and abs(np.log(a/b))>=abs(obs)-1e-12: c+=1
        r["p_ratio_of_ratios"]=(c+1)/(N+1)
    r["med_chg_j"]=np.median(j96-j85); r["med_chg_n"]=np.median(n96-n85)
    r["gap_med_chg"]=r["med_chg_j"]-r["med_chg_n"]
    lo,hi=boot(j96-j85,n96-n85,lambda a,b: np.median(a)-np.median(b)); r["gap_med_chg_lo"],r["gap_med_chg_hi"]=lo,hi
    for y,c in [(85,W85),(90,W90),(96,W96)]:
        r[f"m{y}_j"],r[f"m{y}_n"]=np.median(j[c]),np.median(n[c])
    return r

df=pd.read_csv("data/nls_incarceration_processed.csv"); b=df[df.race=="black"]
rows=[]
for ver,sub in [("AS-IS",b),("DEDUP",b.drop_duplicates())]:
    for sex in ["male","female"]:
        s=sub[sub.sex==sex].copy(); s["stratum"]=pd.cut(s[W85],[-np.inf,0,5000,np.inf],labels=STR,include_lowest=False)
        for lvl in STR:
            d=s[s.stratum==lvl]
            if (d.ever_jailed==1).sum()>=5: rows.append(analyse(d,f"{ver}|{sex}|{lvl}"))
            else: rows.append(dict(group=f"{ver}|{sex}|{lvl}",n_j=int((d.ever_jailed==1).sum()),n_n=int((d.ever_jailed==0).sum()),note="jailed n<5: descriptive only, excluded from inference"))
        rows.append(analyse(s,f"{ver}|{sex}|ALL"))
res=pd.DataFrame(rows); res.to_csv("results_v2.csv",index=False)
pd.set_option("display.width",320); pd.set_option("display.max_columns",90)
def show(p,cols):
    o=res[res.group.str.contains(p,regex=False)]
    print(f"\n### {p} ###")
    print(o[[c for c in cols if c in o.columns]].to_string(index=False,float_format=lambda v:f"{v:,.4g}"))
show("male",["group","n_j","n_n","gap_med","gap_med_lo","gap_med_hi","p_gap_med","mean96_j","mean96_n","gap_mean","gap_mean_lo","gap_mean_hi","p_gap_mean","log_ratio_mean","log_ratio_mean_lo","log_ratio_mean_hi","p_log_ratio_mean"])
show("male",["group","n_j","n_n","med96_pos_j","med96_pos_n","log_ratio_med_pos","log_ratio_p75","log_ratio_p75_lo","log_ratio_p75_hi","p_log_ratio_p75","ps_minus_half","ps_minus_half_lo","ps_minus_half_hi","p_ps_minus_half","share_pos_j","share_pos_n","gap_share_pos","gap_share_pos_lo","gap_share_pos_hi","p_gap_share_pos"])
show("male",["group","n_j","n_n","B85_gap_med","B85_log_ratio_mean","B85_p_log_ratio_mean","B85_d_loglike","B85_p_d_loglike","d_loglike","d_loglike_lo","d_loglike_hi","p_d_loglike"])
show("male",["group","n_j","n_n","m85_j","m90_j","m96_j","m85_n","m90_n","m96_n","med_chg_j","med_chg_n","gap_med_chg","gap_med_chg_lo","gap_med_chg_hi","ratio96_85_j","ratio96_85_n","log_ratio_of_ratios","lrr_lo","lrr_hi","p_ratio_of_ratios"])
show("female",["group","n_j","n_n","med96_j","med96_n","gap_med","gap_mean","log_ratio_mean","ps_minus_half","share_pos_j","share_pos_n","d_loglike","p_d_loglike","gap_med_chg","note"])
# ---- FORMAL CROSS-STRATUM TREND / HETEROGENEITY (permutation within stratum) ----
print("\n=== CROSS-STRATUM TREND in the jailed/not gap (black males; permuted WITHIN stratum) ===")
for ver,sub in [("AS-IS",b),("DEDUP",b.drop_duplicates())]:
    s=sub[sub.sex=="male"].copy(); s["stratum"]=pd.cut(s[W85],[-np.inf,0,5000,np.inf],labels=STR,include_lowest=False)
    cells=[(s[(s.stratum==l)&(s.ever_jailed==1)][W96].values, s[(s.stratum==l)&(s.ever_jailed==0)][W96].values) for l in STR]
    sc=np.arange(1,4.)
    for name in ["gap_mean","log_ratio_mean","ps_minus_half","gap_share_pos","d_loglike","gap_med"]:
        f,null=STATS[name]; obs=np.array([f(a,bb) for a,bb in cells])
        sl_obs=np.polyfit(sc,obs,1)[0]; het_obs=obs.std()
        pool=[np.concatenate([a,bb]) for a,bb in cells]; k=[len(a) for a,bb in cells]
        cs=ch=0; NP=4000
        for _ in range(NP):
            sh=[]
            for arr,kk in zip(pool,k):
                p=rng.permutation(arr); sh.append((p[:kk],p[kk:]))
            v=np.array([f(a,bb) for a,bb in sh])
            if abs(np.polyfit(sc,v,1)[0])>=abs(sl_obs)-1e-12: cs+=1
            if v.std()>=het_obs-1e-12: ch+=1
        print(f"{ver:6s} {name:15s} gaps={np.round(obs,3)} slope/stratum={sl_obs:,.4g} p_trend={(cs+1)/(NP+1):.3f} p_heterogeneity={(ch+1)/(NP+1):.3f}")
