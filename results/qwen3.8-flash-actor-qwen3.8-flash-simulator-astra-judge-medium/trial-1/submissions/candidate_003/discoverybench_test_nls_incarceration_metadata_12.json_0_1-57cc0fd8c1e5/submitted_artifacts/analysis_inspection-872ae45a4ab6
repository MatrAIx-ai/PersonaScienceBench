import pandas as pd, numpy as np
df = pd.read_csv("data/nls_incarceration_processed.csv")
w = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
print("--- overall: zero / negative shares & rounding structure ---")
for c in w:
    s=df[c]
    print(f"{c}: %==0 {100*(s==0).mean():.1f}  %<0 {100*(s<0).mean():.1f}  %div by 1000 {100*(s%1000==0).mean():.1f}  n_unique {s.nunique()}")
print("\n--- jail rate by race x sex (%) and cell sizes ---")
t = df.pivot_table(index="race", columns="sex", values="ever_jailed", aggfunc=["mean","sum","count"])
print((t).round(3).to_string())
print("\n--- duplicated rows detail ---")
d = df[df.duplicated(keep=False)]
print("rows involved in exact dup sets:", len(d), " distinct dup patterns:", d.drop_duplicates().shape[0])
print(d.sort_values(list(df.columns)).head(6).to_string())
print("dup rows by ever_jailed:", df[df.duplicated(keep=False)].ever_jailed.value_counts().to_dict())
print("\n--- black never-jailed wealth 1985 quantiles (for candidate stratifier cutpoints) ---")
b=df[df.race=="black"]
for yr in [1985,1990]:
    q=b.composite_wealth_1985 if yr==1985 else b.composite_wealth_1990
    print(yr, {p: round(q.quantile(p/100)) for p in [10,20,25,33,40,50,60,67,75,80,90]})
print("\nzero share in 1985 among black:", round(100*(b.composite_wealth_1985==0).mean(),1), "%")
