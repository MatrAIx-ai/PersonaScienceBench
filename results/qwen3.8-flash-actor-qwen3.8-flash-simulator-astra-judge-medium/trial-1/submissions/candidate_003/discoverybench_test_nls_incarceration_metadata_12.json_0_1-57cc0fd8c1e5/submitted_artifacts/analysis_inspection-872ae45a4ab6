import pandas as pd, numpy as np
df = pd.read_csv("data/nls_incarceration_processed.csv")
print("--- largest duplicate patterns ---")
m = df.groupby(list(df.columns), dropna=False).size().sort_values(ascending=False)
print(m.head(8).to_string())
print("\nrows with all three wealth == 0:", ((df.composite_wealth_1985==0)&(df.composite_wealth_1990==0)&(df.composite_wealth_1996==0)).sum())

b=df[df.race=="black"].copy()
print("\n=== binary pre-window asset position (black, by sex) ===")
b["has_asset_85"]=(b.composite_wealth_1985>0).astype(int)
print(pd.crosstab([b.sex,b.has_asset_85], b.ever_jailed, margins=True).to_string())
print("\nmedian 1996 wealth by sex x has_asset_85 x jail (black):")
print(b.pivot_table(index=["sex","has_asset_85"],columns="ever_jailed",values="composite_wealth_1996",aggfunc=["median","mean","count"]).round(0).to_string())

print("\n=== black MALES: 3 strata defined above/below zero (informative cut) ===")
bm=b[b.sex=="male"].copy()
pos = bm.composite_wealth_1985[bm.composite_wealth_1985>0]
print("among black males with >0 in 1985 (n=%d): median=%d, p66(overall-rank cut)=%.0f"%(len(pos),pos.median(),bm.composite_wealth_1985.quantile(2/3)))
def lab(s):
    if s<=0: return "1_none(<=0)"
    if s<=5000: return "2_low_positive(1-5k)"
    return "3_high(>5k)"
bm["stratum"]=bm.composite_wealth_1985.apply(lab)
print(pd.crosstab(bm.stratum,bm.ever_jailed,margins=True).to_string())
bm["chg"]=bm.composite_wealth_1996-bm.composite_wealth_1985
print("\nmedian 1996 wealth:")
print(bm.pivot_table(index="stratum",columns="ever_jailed",values="composite_wealth_1996",aggfunc="median").round(0).to_string())
print("\nmean 1996 wealth:")
print(bm.pivot_table(index="stratum",columns="ever_jailed",values="composite_wealth_1996",aggfunc="mean").round(0).to_string())
print("\nmedian change 85->96:")
print(bm.pivot_table(index="stratum",columns="ever_jailed",values="chg",aggfunc="median").round(0).to_string())
print("\nmean change 85->96:")
print(bm.pivot_table(index="stratum",columns="ever_jailed",values="chg",aggfunc="mean").round(0).to_string())
print("\npct with 1996 wealth <=0 :")
print(bm.assign(neg=bm.composite_wealth_1996<=0).pivot_table(index="stratum",columns="ever_jailed",values="neg",aggfunc="mean").round(3).to_string())
