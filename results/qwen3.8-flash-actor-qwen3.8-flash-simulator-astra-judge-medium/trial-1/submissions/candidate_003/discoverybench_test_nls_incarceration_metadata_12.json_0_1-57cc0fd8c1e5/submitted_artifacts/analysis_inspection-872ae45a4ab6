    lab=pd.qcut(b.composite_wealth_1985,3,labels=["low","mid","high"])
    print(lab.value_counts(dropna=False).to_string())
except Exception as e:
    print("qcut failed:", e)
print("\n--- terciles via rank-based (random ties) ---")
r = b.composite_wealth_1985.rank(method="first")
lab = pd.cut(r,3,labels=["low","mid","high"])
print(lab.value_counts().to_string())
print(pd.crosstab(lab, b.ever_jailed).to_string())
print(b.groupby(lab, observed=True)[w].median().round(0).to_string())
