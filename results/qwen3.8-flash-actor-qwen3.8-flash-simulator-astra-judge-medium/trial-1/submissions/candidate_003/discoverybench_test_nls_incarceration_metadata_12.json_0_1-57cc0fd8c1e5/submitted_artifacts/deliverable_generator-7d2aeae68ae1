        d85=f("B85_d_loglike"); p85=f("B85_p_d_loglike"); d96=f("d_loglike")
        verdict = "no detectable (p>0.2)" if (p85 is not None and p85>0.2) else "residual imbalance remains"
        L.append("| {s} | {v} | {mj:,.0f} / {mn:,.0f} | {d85:+.3f} | {p85:.2f} | {verdict} | {d96:+.3f} | {net:+.3f} |".format(
            s=s_,v=ver,mj=f("m85_j"),mn=f("m85_n"),d85=d85,p85=p85,verdict=verdict,d96=d96,net=d96-d85))
L.append("\nStratifying on 1985 assets removes the baseline gap: unstratified black males start at d_asinh85 = -0.279 (p=0.066); within every stratum |d_asinh85| <= 0.14 and all p >= 0.30. But strata are wide (S3 spans $5k to $2.4M) and 1985 wealth itself may be pre-affected for men jailed in 1985, so residual confounding by unmeasured ability/family background is NOT ruled out.\n")
L.append("\n## TABLE 3 — SECONDARY: change 1985→1996 (NOMINAL $) and ratio-to-baseline (common inflation cancels)\n")
L.append("| Stratum | ver | median 85→96 J | median 85→96 N | **gap in change** [95% CI] | median(96/85) J | median(96/85) N | **log ratio-of-ratios** [95% CI], perm p |")
L.append("|---|---|---|---|---|---|---|---|")
for s in STR:
    for ver in ["AS-IS","DEDUP"]:
        f=lambda c,v=ver: g(s,v,c)
        if f("gap_med_chg") is None: continue
        lrr=f("log_ratio_of_ratios"); lrr_s = "— (jailed base>0 n=0)" if (f("n_j") and f("m85_j")==0) else (
            f"**{lrr:.2f}** [{f('lrr_lo'):.2f}, {f('lrr_hi'):.2f}], p={f('p_ratio_of_ratios'):.3f}" if lrr is not None and np.isfinite(lrr) else "jailed median 96/85 = 0 → −inf")
        L.append("| {s} | {v} | {cj:,.0f} | {cn:,.0f} | **{gc:,.0f}** [{gl:,.0f}, {gh:,.0f}] | {rj} | {rn} | {lrr_s} |".format(
