      ("DEDUP","gap_mean"):("-33,597 / -26,640 / -86,174","-2.63e4","0.280","0.349"),
      ("AS-IS","log_ratio_mean"):("-1.289 / -1.196 / -1.811","-0.261","0.458","0.571"),
