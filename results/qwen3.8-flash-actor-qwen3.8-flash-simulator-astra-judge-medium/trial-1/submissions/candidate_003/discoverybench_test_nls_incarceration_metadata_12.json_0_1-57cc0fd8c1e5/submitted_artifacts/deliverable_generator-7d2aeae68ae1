import numpy as np, pandas as pd
v2 = pd.read_csv("results_v2.csv")
male = v2[v2.group.str.contains("male", regex=False)].copy()
male["stratum"] = male.group.str.split("|").str[2]
def g(s, ver, col):
    r = male[(male.group.str.startswith(ver)) & (male.stratum == s)]
    return r[col].iloc[0] if len(r) and col in r.columns and pd.notna(r[col].iloc[0]) else None
STR = ["S1 none(<=0)","S2 low-pos(1-5k)","S3 high(>5k)","ALL"]
def fmt(x, kind):
    if x is None or (isinstance(x,float) and not np.isfinite(x)): return "—"
    if kind=="$": return f"{x:,.0f}"
    if kind=="3": return f"{x:.3f}"
    if kind=="p": return f"{x:.3f}" if x>=0.001 else "<0.001"
    return str(x)
L=[]
L.append("# Stratified results — black respondents, NLSY79 file (unweighted sample statistics)\n")
L.append("`ever_jailed` = jailed 1985–1994. **`income level` is NOT measured in this file**; strata = pre-window (1985) asset position, used as its proxy. Association, not causation.\n")
L.append("## TABLE 1 — PRIMARY: 1996 wealth, jailed vs never-jailed, within baseline stratum\n")
L.append("### black MALES (inference population)\n")
L.append("| Stratum (1985 assets) | n_jailed / n_not | median96 J / N | **ABS gap (median)** [95% CI] | mean96 J / N | **ABS gap (mean)** | **REL gap: ratio of means** [95% CI] | **REL gap: log ratio of means** | PS−0.5 (rank gap) [95% CI] | share>0 J / N (pp gap) |")
L.append("|---|---|---|---|---|---|---|---|---|---|")
for ver in ["AS-IS","DEDUP"]:
    for s in STR:
        f=lambda c,v=ver: g(s,v,c)
        gm=f("gap_med"); ci=f"({f('gap_med_lo'):,.0f}, {f('gap_med_hi'):,.0f})" if gm is not None else "—"
        L.append("| {s} **{v}** | {nj} / {nn} | {mj} / {mn} | **{gm}** {ci} | {aj} / {an} | {ga} | **{rr}** {rrci} | {lr} [{lrl:.2f}, {lrh:.2f}] | {ps} [{psl:.3f}, {psh:.3f}] | {sj:.0%} / {sn:.0%} ({gp:+.0%}) |".format(
            s=s, v=ver, nj=int(f("n_j")), nn=int(f("n_n")),
            mj=f"{f('m96_j'):,.0f}", mn=f"{f('m96_n'):,.0f}", gm=f"{gm:,.0f}", ci=ci,
            aj=f"{f('mean96_j'):,.0f}", an=f"{f('mean96_n'):,.0f}", ga=f"{f('gap_mean'):,.0f}",
            rr=f"{np.exp(f('log_ratio_mean')):.3f}", rrci=f"[{np.exp(f('log_ratio_mean_lo')):.3f}, {np.exp(f('log_ratio_mean_hi')):.3f}]",
            lr=f"{f('log_ratio_mean'):.2f}", lrl=f("log_ratio_mean_lo"), lrh=f("log_ratio_mean_hi"),
            ps=f"{f('ps_minus_half'):+.3f}", psl=f("ps_minus_half_lo"), psh=f("ps_minus_half_hi"),
            sj=f("share_pos_j"), sn=f("share_pos_n"), gp=f("gap_share_pos")))
L.append("\nPS = P(never-jailed wealth > jailed wealth) − 0.5; 0 = no gap, >0 = jailed lower. Strata jailed counts <5 excluded (black females S2/S3).\n")
L.append("### black FEMALES — descriptive only (16 jailed as-is / 11 dedup; S2 n=2, S3 n=1)\n")
L.append("| Group | n_jailed | median96 J / N | gap (mean) | ratio of means | PS−0.5 | share>0 J / N |")
L.append("|---|---|---|---|---|---|---|")
for grp in ["AS-IS|female|S1 none(<=0)","AS-IS|female|ALL","DEDUP|female|S1 none(<=0)","DEDUP|female|ALL"]:
    r=v2[v2.group==grp]
    if not len(r) or pd.isna(r.iloc[0].get("gap_med",np.nan)): continue
    r=r.iloc[0]
    L.append("| {g} | {nj} | {mj:,.0f} / {mn:,.0f} | {ga:,.0f} | {rr:.3f} | {ps:+.3f} | {sj:.0%} / {sn:.0%} |".format(
        g=grp, nj=int(r.n_j), mj=r.m96_j, mn=r.m96_n, ga=r.gap_mean,
        rr=np.exp(r.log_ratio_mean) if np.isfinite(r.log_ratio_mean) else np.nan,
        ps=r.ps_minus_half, sj=r.share_pos_j, sn=r.share_pos_n))
L.append("\n## TABLE 2 — BASELINE IMBALANCE INSIDE each stratum (is the low start being counted twice?)\n")
L.append("| Stratum | ver | median 1985 J / N | baseline log-gap (asinh diff) | perm p | residual 1985 imbalance? | 1996 log-gap | gap change 85→96 (log) |")
L.append("|---|---|---|---|---|---|---|---|")
for s_ in STR:
    for ver in ["AS-IS","DEDUP"]:
        f=lambda c,v=ver: g(s_,v,c)
