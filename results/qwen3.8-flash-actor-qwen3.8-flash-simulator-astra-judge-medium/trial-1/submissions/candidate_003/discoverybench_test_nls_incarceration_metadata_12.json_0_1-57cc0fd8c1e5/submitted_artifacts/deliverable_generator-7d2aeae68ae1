            rn=("—" if pd.isna(f("ratio96_85_n")) else f"{f('ratio96_85_n'):.3f}"), lrr_s=lrr_s))
L.append("\n## TABLE 4 — TERTIARY: 1990 trajectory (descriptive ONLY — 1990 is INSIDE the 1985–1994 jail window)\n")
L.append("| Stratum | ver | jailed 85 / 90 / 96 medians | never-jailed 85 / 90 / 96 medians |")
L.append("|---|---|---|---|")
for s in STR:
    for ver in ["AS-IS","DEDUP"]:
        f=lambda c,v=ver: g(s,v,c)
        if f("m90_j") is None: continue
        L.append("| {s} | {v} | {a:,.0f} / {b:,.0f} / {c:,.0f} | {d:,.0f} / {e:,.0f} / {f_:,.0f} |".format(
            s=s,v=ver,a=f("m85_j"),b=f("m90_j"),c=f("m96_j"),d=f("m85_n"),e=f("m90_n"),f_=f("m96_n")))
L.append("\n## TABLE 5 — ACROSS-STRATUM TREND in the gap (black males; labels permuted WITHIN stratum)\n")
L.append("| Measure of gap | as-is gaps S1→S2→S3 | slope/stratum | p_trend | p_heterogeneity | dedup gaps | slope | p_trend | p_het |")
L.append("|---|---|---|---|---|---|---|---|---|")
