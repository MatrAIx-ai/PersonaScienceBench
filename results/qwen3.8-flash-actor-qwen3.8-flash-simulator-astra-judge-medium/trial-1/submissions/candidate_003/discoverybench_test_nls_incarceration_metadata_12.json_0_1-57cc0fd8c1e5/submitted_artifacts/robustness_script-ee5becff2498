"""Robustness: (1) finer strata; (2) mean-reversion direction check; (3) is the growing ABSOLUTE
gap mechanical under a constant proportional gap?; (4) alternative jail-window-aligned outcome."""
import numpy as np, pandas as pd
rng=np.random.default_rng(999)
df=pd.read_csv("data/nls_incarceration_processed.csv"); b=df[df.race=="black"]
W85,W90,W96="composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"
SL=lambda x: np.arcsinh(np.asarray(x,float)/1000.)

print("=== (1) FINER STRATA, black males, as-is: cutpoints from the data ===")
s=b[b.sex=="male"].copy()
cuts=[(( -np.inf,0),"W0: <=0"),((0,2000),"W1: 1-2k"),((2000,6000),"W2: 2-6k"),((6000,15000),"W3: 6-15k"),((15000,np.inf),"W4: >15k")]
for (lo,hi),nm in cuts:
    d=s[(s[W85]>lo)&(s[W85]<=hi)]
    j=d[d.ever_jailed==1][W96]; n=d[d.ever_jailed==0][W96]
    if len(j)<5: print(f"  {nm:10s} n_j={len(j):3d} n_n={len(n):4d}  TOO SMALL"); continue
    print(f"  {nm:10s} n_j={len(j):3d} n_n={len(n):4d} | med96 {j.median():>8,.0f} / {n.median():>9,.0f} gap={j.median()-n.median():>9,.0f} | mean {j.mean():>8,.0f} / {n.mean():>9,.0f} ratio={j.mean()/n.mean():.3f} | d_asinh={SL(j).mean()-SL(n).mean():+.3f}")
print("\n=== (2) MEAN REVERSION: within S2/S3, does the jailed group's LOWER baseline push its change down? ===")
s2=b[b.sex=="male"].copy(); s2["t"]=pd.cut(s2[W85],[-np.inf,0,5000,np.inf],labels=["S1","S2","S3"],include_lowest=False)
for t in ["S2","S3"]:
    for gv in [0,1]:
        d=s2[(s2.t==t)&(s2.ever_jailed==gv)&(s2[W85]>0)]
        q=pd.qcut(d[W85],2,labels=["lower half","upper half"],duplicates="drop")
        ch=(d[W96]-d[W85])
        print(f"  {t} jailed={gv}: change by within-stratum 1985 half: "+" | ".join(f"{k}: {ch[q==k].median():,.0f} (n={int((q==k).sum())})" for k in q.cat.categories))
print("\n=== (3) Is 'absolute gap grows, ratio shrinks' mechanical? Simulate constant PROPORTIONAL gap ===")
for scale,lab in [(27000,"S3-like scale (never-jailed mean 27k)"),(100000,"S3 observed scale (103k)")]:
    sim=np.abs(rng.lognormal(0,1.1,60000))*scale
    for prop in [0.3]:
        j=sim*rng.lognormal(np.log(prop),0.6,len(sim))
        print(f"  {lab}: constant ratio={prop} -> ratio_of_means={j.mean()/sim.mean():.3f}, abs_gap={j.mean()-sim.mean():,.0f}")
print("  => under a CONSTANT proportional gap the absolute gap MUST grow with level; a shrinking ratio is")
print("     the mechanical companion of a growing dollar gap, not independent evidence.")
print("\n=== (4) Jail-window-aligned alternative: 1990->1996 (post-window) change, black males ===")
s2=b[b.sex=="male"].copy(); s2["t"]=pd.cut(s2[W85],[-np.inf,0,5000,np.inf],labels=["S1","S2","S3"],include_lowest=False)
for t in ["S1","S2","S3"]:
    d=s2[s2.t==t]; j=d[d.ever_jailed==1]; n=d[d.ever_jailed==0]
    if len(j)<5: continue
    cj=(j[W96]-j[W90]); cn=(n[W96]-n[W90])
    print(f"  {t}: median chg 90->96 jailed={cj.median():>9,.0f} never={cn.median():>9,.0f} gap={cj.median()-cn.median():>9,.0f}")
print("\n=== (5) Is the whole black-male result driven by the all-zero duplicated cell? ===")
for lab,sub in [("as-is",b),("dedup",b.drop_duplicates()),("as-is minus all-zero-wealth rows",b[~b[[W85,W90,W96]].eq(0).all(axis=1)])]:
    s3=sub[sub.sex=="male"]
    j=s3[s3.ever_jailed==1]; n=s3[s3.ever_jailed==0]
    print(f"  {lab:36s} n_j={len(j):3d} ratio_of_means_1996={j[W96].mean()/n[W96].mean():.3f} d_asinh={SL(j[W96]).mean()-SL(n[W96]).mean():+.3f} share>0 {100*(j[W96]>0).mean():.1f}% vs {100*(n[W96]>0).mean():.1f}%")
