"""Inspection-only pass over data/nls_incarceration_processed.csv.
No medians / no answer computation -- structure, labels, counts, missingness only."""
import csv, re
import pandas as pd

CSV = 'data/nls_incarceration_processed.csv'
with open(CSV) as f:
    header = next(csv.reader(f))
df = pd.read_csv(CSV)
W = [c for c in df.columns if 'wealth' in c.lower()]

print("=== 1. STRUCTURE ===")
print("rows x cols :", df.shape)
print("columns     :", list(df.columns))
print("raw header fields:", len(header))
print("wealth-like columns:", W)
print("year-like columns  :", [c for c in header if re.search(r'(19|20)\d\d', c)])
print("other/extra columns:", [c for c in header if c not in W + ['race', 'sex', 'ever_jailed']])
print("dtypes:"); print(df.dtypes.to_string())

print("\n=== 2. DISTINCT VALUES (repr shows case/whitespace) ===")
for c in ['race', 'sex', 'ever_jailed']:
    print(f"[{c}] distinct={df[c].nunique(dropna=False)} nulls={df[c].isna().sum()}")
    for v, ct in df[c].value_counts(dropna=False).items():
        print("    ", repr(v), "->", ct)

print("\n=== 3. GROUP COUNTS (race x sex, plus jail) ===")
print(pd.crosstab(df['race'], df['sex'], margins=True, margins_name='TOTAL').to_string())
print()
print(df.groupby(['race', 'sex'])['ever_jailed']
        .agg(n='count', n_jailed='sum', pct_jailed=lambda s: round(100 * s.mean(), 2)).to_string())

print("\n=== 4. MISSINGNESS / RANGE of wealth columns ===")
for c in W:
    s = df[c]
    blank = None
    print(f"{c}: non_null={s.notna().sum()} null={s.isna().sum()} min={s.min()} max={s.max()} "
          f"n_neg={(s < 0).sum()} n_zero={(s == 0).sum()} n_pos={(s > 0).sum()}")
print("rows with any wealth missing :", int(df[W].isna().any(axis=1).sum()))
print("rows with all 3 wealth present:", int(df[W].notna().all(axis=1).sum()))

print("\n=== 5. COMPLETE-CASE COUNTS BY GROUP ===")
rows = []
for (r, sx), g in df.groupby(['race', 'sex']):
    rows.append(dict(race=r, sex=sx, n=len(g),
                     **{f"n_{c[-4:]}": int(g[c].notna().sum()) for c in W},
                     n_all_years=int(g[W].notna().all(axis=1).sum())))
print(pd.DataFrame(rows).to_string(index=False))

print("\n=== 6. BLACK FEMALE FOCUS ===")
bf = df[(df.race == 'black') & (df.sex == 'female')]
print("n =", len(bf), f"({100 * len(bf) / len(df):.1f}% of file); all 3 years present =",
      int(bf[W].notna().all(axis=1).sum()))
for c in W:
    s = bf[c]
    print(f"  {c}: min={s.min()} max={s.max()} neg={(s < 0).sum()} ({100 * (s < 0).mean():.1f}%) "
          f"zero={(s == 0).sum()} ({100 * (s == 0).mean():.1f}%) pos={(s > 0).sum()} ({100 * (s > 0).mean():.1f}%)")
print("  BF all-three-zero rows:", int((bf[W] == 0).all(axis=1).sum()))
print("  BF ever_jailed:", bf.ever_jailed.value_counts().to_dict())

print("\n=== 7. DATA-QUALITY FLAGS ===")
print("fully duplicated rows (extra copies):", int(df.duplicated().sum()))
dups = df[df.duplicated(keep=False)]
print("rows in duplicate blocks:", len(dups), "| distinct patterns:", dups.drop_duplicates().shape[0],
      "| of which all-wealth-zero:", int((dups[W] == 0).all(axis=1).sum()))
print("\nzero share per group/year (possible missing-as-zero recode):")
for (r, sx), g in df.groupby(['race', 'sex']):
    print(f"  {r:8s} {sx:7s} n={len(g):5d} " +
          "  ".join(f"{c[-4:]}={100 * (g[c] == 0).mean():5.1f}%" for c in W))
print("\n(NO medians or year-increase estimates computed -- inspection only.)")
