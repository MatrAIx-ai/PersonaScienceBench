"""Median wealth among BLACK FEMALES (NLSY79 processed file) - answer computation.

Rulings implemented:
 (a) PRIMARY criterion = ABSOLUTE $ change in median; % change reported as support only.
 (b) PRIMARY branch keeps zeros as real zero wealth; sensitivity branches: zeros->NaN, positive-only.
     If the winning interval flips across branches, that is reported explicitly.
 (c) pooled black+female (n=1548); ever_jailed stratification reported as one line only (n=16).
 No deduplication in primary branch. No inflation adjustment, no weights (absent from file).
"""
import numpy as np
import pandas as pd

CSV = 'data/nls_incarceration_processed.csv'
YEARS = [1985, 1990, 1996]
W = [f'composite_wealth_{y}' for y in YEARS]
INTERVALS = [(1985, 1990), (1990, 1996)]
RNG_SEED = 20261023

df = pd.read_csv(CSV)
bf = df[(df['race'] == 'black') & (df['sex'] == 'female')].copy()
N = len(bf)

# ---------- diagnostics: zero / negative mass by year (black female) ----------
print("=" * 78)
print(f"SLICE: race=='black' & sex=='female'   n = {N}  (of {len(df)} rows in file)")
print("=" * 78)
print("n per year (complete-case == all-available, so that choice is moot):")
print("   " + "  ".join(f"{y}: {int(bf[c].notna().sum())}" for y, c in zip(YEARS, W)))
print("   rows with all three years present:", int(bf[W].notna().all(axis=1).sum()))

diag = pd.DataFrame({
    'year': YEARS,
    'n_nonmissing': [int(bf[c].notna().sum()) for c in W],
    'n_negative': [int((bf[c] < 0).sum()) for c in W],
    'n_zero': [int((bf[c] == 0).sum()) for c in W],
    'pct_zero': [round(100 * (bf[c] == 0).mean(), 1) for c in W],
    'n_positive': [int((bf[c] > 0).sum()) for c in W],
    'min': [int(bf[c].min()) for c in W],
    'max': [int(bf[c].max()) for c in W],
})
print("\nBlack-female distribution diagnostics by year:")
print(diag.to_string(index=False))
print("\nblack-female respondents with 0 wealth in ALL three years:",
      int((bf[W] == 0).all(axis=1).sum()))
recs = []
for (r, sx), g in df.groupby(['race', 'sex']):
    rec = {'race': r, 'sex': sx, 'n': len(g)}
    for y, c in zip(YEARS, W):
        rec[f'pct_zero_{y}'] = round(100 * (g[c] == 0).mean(), 1)
    recs.append(rec)
zdiag = pd.DataFrame(recs)
print("\nZero share (%) per group x year - context for whether zeros are technical misses:")
print(zdiag.to_string())

# where does the primary-branch median sit relative to the zero block?
print("\nPosition of the median relative to the zero/negative block (primary branch):")
for y, c in zip(YEARS, W):
    sh = 100 * (bf[c] <= 0).mean()
    print(f"  {y}: share of respondents at or below $0 = {sh:.1f}%  "
          f"-> the 50th percentile sits {'inside/at the edge of' if sh > 45 else 'above'} the zero block"
          f" (median=${bf[c].median():,.0f})")

# ---------- branch definitions ----------
def branch_raw(d):
    return d[W].astype(float)

def branch_zeros_nan(d):
    z = d[W].astype(float).copy()
    z = z.replace(0.0, np.nan)
    return z

def branch_positive(d):
    p = d[W].astype(float).copy()
    p = p.where(p > 0)
    return p

BRANCHES = [
    ('PRIMARY: zeros kept as real 0 wealth (no dedup)', branch_raw),
    ('SENS-1: zeros -> NaN (treated as technical missing)', branch_zeros_nan),
    ('SENS-2: positive wealth only', branch_positive),
]

def summarise(mat, label):
    """medians, deltas, sign; returns (rows, table)"""
    med = {y: float(mat[f'composite_wealth_{y}'].median()) for y in YEARS}
    nmed = {y: int(mat[f'composite_wealth_{y}'].notna().sum()) for y in YEARS}
    rows = []
    for a, b in INTERVALS:
        d_abs = med[b] - med[a]
        d_pct = (d_abs / med[a] * 100) if med[a] != 0 else np.nan
        rows.append(dict(
            branch=label, interval=f'{a}-{b}',
            median_a=round(med[a], 1), median_b=round(med[b], 1),
            delta_usd=round(d_abs, 1),
            delta_pct=(round(d_pct, 1) if np.isfinite(d_pct) else None),
            pct_meaningful=('yes' if (np.isfinite(d_pct) and abs(med[a]) > 1000)
                            else 'NO (base median ~0)'),
            direction=('increase' if d_abs > 0 else ('decrease' if d_abs < 0 else 'flat')),
        ))
    return med, nmed, rows

all_med, all_rows = {}, []
for label, fn in BRANCHES:
    mat = fn(bf)
    med, nmed, rows = summarise(mat, label)
    all_med[label] = med
    all_rows += rows
    print("\n" + "-" * 78)
    print(label)
    print(f"  medians: " + "  ".join(f"{y}=${med[y]:,.0f} (n={nmed[y]})" for y in YEARS))

res = pd.DataFrame(all_rows)
print("\n" + "=" * 78)
print("BOTH INTERVALS, ALL BRANCHES")
print("=" * 78)
print(res.to_string(index=False))

# margin between the two deltas + winner per branch
print("\nMargin between the two absolute deltas (|delta_1985_1990| vs |delta_1990_1996|):")
winners = {}
for label, _ in BRANCHES:
    sub = res[res.branch == label].set_index('interval')
    d1 = sub.loc['1985-1990', 'delta_usd']
    d2 = sub.loc['1990-1996', 'delta_usd']
    w = '1985-1990' if d1 > d2 else '1990-1996'
    winners[label] = w
    print(f"  {label}\n     d1=${d1:,.0f}  d2=${d2:,.0f}  |d1-d2|=${abs(d1-d2):,.0f}"
          f"  winner={w}  both_positive={(d1 > 0) and (d2 > 0)}")
print("\nWinner identical across all three branches:",
      len(set(winners.values())) == 1, "->", winners)

# ---------- ONE bootstrap run: rank stability of which interval wins ----------
mat = branch_raw(bf).to_numpy()
rng = np.random.default_rng(RNG_SEED)
wins = {'1985-1990': 0, '1990-1996': 0, 'tie': 0}
B = 2000
for _ in range(B):
    idx = rng.integers(0, N, N)
    m = np.nanmedian(mat[idx], axis=0)
    d1, d2 = m[1] - m[0], m[2] - m[1]
    if d1 > d2:
        wins['1985-1990'] += 1
    elif d2 > d1:
        wins['1990-1996'] += 1
    else:
        wins['tie'] += 1
print(f"\nBootstrap (B={B}, seed={RNG_SEED}, primary branch, resampling the {N} respondents):")
print("  P(interval has the larger increase):",
      {k: f"{100*v/B:.1f}%" for k, v in wins.items()})

# ---------- ever_jailed one-liner ----------
j1 = bf[bf['ever_jailed'] == 1]
print(f"\never_jailed==1 subgroup: n={len(j1)} -> medians " +
      " ".join(f"{y}=${j1[c].median():,.0f}" for y, c in zip(YEARS, W)) +
      "  | not interpretable at n=16; not used for the answer.")

# persist tables
res.to_csv('analysis/results_table.csv', index=False)
diag.to_csv('analysis/black_female_distribution_by_year.csv', index=False)
print("\nSaved: analysis/results_table.csv, analysis/black_female_distribution_by_year.csv")
