import pandas as pd, numpy as np
d = pd.read_csv("data/nls_incarceration_processed.csv")
print("No ID-like column present. Columns:", list(d.columns))
print("Extra columns vs datasets.json:", set(d.columns) - {"race","sex","ever_jailed","composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"})
print("Missing from datasets.json list:", {"race","sex","ever_jailed","composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"} - set(d.columns))

# row ordering -> suggests one row per person?
blk = (d[["race","sex"]] != d[["race","sex"]].shift()).any(axis=1).cumsum()
print("\nnumber of contiguous (race,sex) blocks:", blk.nunique(), "(high => sorted by row/person, not grouped)")
print("first/last rows of first 3 blocks:")
print(d.groupby(blk, sort=True).head(1).head(3).to_string())

print("\n=== heaping / granularity ===")
for c in ["composite_wealth_1990","composite_wealth_1996"]:
    s=d[c][d[c]>0]
    print(c, "| %div by 100:", round(100*(s%100==0).mean(),1), "| by 500:", round(100*(s%500==0).mean(),1),
          "| by 1000:", round(100*(s%1000==0).mean(),1), "| by 5000:", round(100*(s%5000==0).mean(),1),
          "| GCD of positives:", np.gcd.reduce(s.astype('int64').values))
print("\nsentinel-like small counts of huge values:")
print(d.composite_wealth_1996.value_counts().head(3).to_string())

print("\n=== ever_jailed cell sizes in white groups (power check) ===")
w=d[(d.race=="white")]
print(pd.crosstab(w.sex, w.ever_jailed, margins=True).to_string())
print("\nwhite jailed 1996 wealth medians:")
print(w.groupby(["sex","ever_jailed"]).composite_wealth_1996.agg(['size','median','mean']).round(0).to_string())
print("\nnon-jailed-only zero share by year (white):")
nj=w[w.ever_jailed==0]
print({c: round(100*(nj[c]==0).mean(),1) for c in ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]})

print("\n=== 1985->1990->1996 zero share, white male / white female ===")
for s in ["male","female"]:
    sub=w[w.sex==s]
    print(s, {c: dict(zero=round(100*(sub[c]==0).mean(),1), neg=round(100*(sub[c]<0).mean(),1), med=float(sub[c].median())) for c in ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]})
