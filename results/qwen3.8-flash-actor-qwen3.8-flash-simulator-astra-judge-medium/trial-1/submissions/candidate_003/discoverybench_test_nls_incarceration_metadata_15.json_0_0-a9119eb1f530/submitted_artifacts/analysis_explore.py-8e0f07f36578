import pandas as pd, numpy as np
pd.set_option("display.width", 200); pd.set_option("display.max_columns", 50)

df = pd.read_csv("/workspace/data/nls_incarceration_processed.csv", dtype=str, keep_default_na=False)
print("SHAPE:", df.shape)
print("COLUMNS:", list(df.columns))

print("\n=== RAW distinct race (repr) ===")
print(df["race"].value_counts(dropna=False).to_string())
print("\n=== RAW distinct sex (repr) ===")
print(df["sex"].value_counts(dropna=False).to_string())
print("\n=== RAW distinct ever_jailed (repr) ===")
print(df["ever_jailed"].value_counts(dropna=False).to_string())

print("\n=== whitespace / case anomalies in race, sex ===")
for c in ["race","sex","ever_jailed"]:
    vals = df[c].unique()
    odd = [v for v in vals if v != v.strip() or (v.lower() not in {"white","black","hispanic","male","female","0","1",""})]
    print(c, "-> odd values:", sorted(odd))

print("\n=== empty-string / NA-like tokens in wealth cols ===")
wcols = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
for c in wcols:
    raw = df[c]
    na_like = raw.str.strip().isin(["", "NA", "N/A", "na", "nan", "NaN", "NULL", "null", "-", "."]).sum()
    print(f"{c}: empty/NA-like tokens = {na_like}")
    nonnum = raw[(raw.str.strip() != "") & (~raw.str.strip().str.match(r"^-?\d+(\.\d+)?([eE][-+]?\d+)?$"))]
    print(f"   non-numeric-looking values: {nonnum.unique()[:10]} (n={len(nonnum)})")
