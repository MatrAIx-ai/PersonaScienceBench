import pandas as pd, numpy as np
pd.set_option("display.width", 250); pd.set_option("display.max_columns", 60)
d = pd.read_csv("data/nls_incarceration_processed.csv")
d["race_clean"]=d["race"].str.strip().str.lower().replace({"hipanic":"hispanic"})
W=["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]

print("=== race_clean x sex sizes ===")
print(pd.crosstab(d.race_clean, d.sex, margins=True).to_string())
print("\n=== ever_jailed==1 share by group ===")
print((d.groupby(["race_clean","sex"]).ever_jailed.agg(['size','sum','mean'])
       .rename(columns={'size':'n','sum':'n_jailed','mean':'pct_jailed'}).assign(pct_jailed=lambda x:100*x.pct_jailed).round(2)).to_string())

print("\n=== ALL-ZERO rows (all 3 waves zero) ===")
z=(d[W]==0).all(axis=1)
print("n all-zero rows:", z.sum(), "| pct:", round(100*z.mean(),2))
print("duplicated rows that are all-zero:", d[z].duplicated().sum(), "of", d.duplicated().sum(), "total dups")
dups = d[d.duplicated(keep=False)]
print("dup-structure: among duplicated rows, all-zero share:", round(100*(dups[W]==0).all(axis=1).mean(),2),"%")

print("\n=== ZERO-BURDEN: rows with wealth>0 in 1990 but ==0 in 1996 (possible nonresponse-coded-as-0) ===")
for g,sub in [("white",d[d.race_clean=="white"]),("ALL",d)]:
    back = ((sub.composite_wealth_1990>0)&(sub.composite_wealth_1996==0)).sum()
    lost = ((sub.composite_wealth_1990==0)&(sub.composite_wealth_1996>0)).sum()
    print(f"{g}: pos1990->zero1996 = {back} ({round(100*back/len(sub),1)}%); zero1990->pos1996 = {lost} ({round(100*lost/len(sub),1)}%)")

print("\n=== per-group summaries for white male / white female ===")
def summ(sub,label):
    r=[]
    for c in ["composite_wealth_1990","composite_wealth_1996"]:
        s=sub[c]
        r.append(dict(group=label,col=c,n=len(s),mean=s.mean(),med=s.median(),
            p10=s.quantile(.1),q1=s.quantile(.25),q3=s.quantile(.75),p90=s.quantile(.9),p99=s.quantile(.99),
            max=s.max(),pct_neg=100*(s<0).mean(),pct_zero=100*(s==0).mean(),pct_pos=100*(s>0).mean(),
            skew=s.skew(),max_over_p90=s.max()/max(s.quantile(.9),1)))
    return pd.DataFrame(r)
tabs=[summ(d[(d.race_clean=="white")&(d.sex=="male")],"white_male"),
      summ(d[(d.race_clean=="white")&(d.sex=="female")],"white_female")]
print(pd.concat(tabs).round(1).to_string(index=False))

print("\n=== positive-only distributions (log-relevant) ===")
for lbl,sub in [("white_male",d[(d.race_clean=="white")&(d.sex=="male")]),("white_female",d[(d.race_clean=="white")&(d.sex=="female")])]:
    for c in ["composite_wealth_1990","composite_wealth_1996"]:
        p=sub[sub[c]>0][c]
        print(f"{lbl} {c}: n_pos={len(p)} min={p.min()} p25={p.quantile(.25):.0f} med={p.median():.0f} p75={p.quantile(.75):.0f} p90={p.quantile(.9):.0f} max={p.max()} log_sd={np.log(p).std():.2f} skew={p.skew():.1f}")
