"""FINAL: wealth inequality 1990 vs 1996, white males vs white females.
Main = two cross-sectional slices per group per year (no pooling across years).
Layers: A_raw (zero=true zero, MAIN) | C_positive (strictly positive, REQUIRED COMPANION)
        B_1996zeros_as_nonresponse (SENSITIVITY BOUND ONLY)
Robustness: deduplicated sample, p99-trimmed sample (heaping check).
Diagnostics (explanatory only, not the estimate): individual transitions.
Control: ever_jailed split (does the change survive never-jailed subsample?).
"""
import numpy as np, pandas as pd, itertools, json, os
RNG = np.random.default_rng(20261025); R = 2000
OUT = "analysis/out"; os.makedirs(OUT, exist_ok=True)
pd.set_option("display.width", 250); pd.set_option("display.max_columns", 40)

d = pd.read_csv("data/nls_incarceration_processed.csv")
d["race_clean"] = d["race"].str.strip().str.lower().replace({"hipanic": "hispanic"})
W90, W96 = "composite_wealth_1990", "composite_wealth_1996"
KEEPRAW = None

def stats(x):
    x = np.sort(np.asarray(x, float)); n = len(x)
    s = {"n": n}
    if n == 0: return s
    q = lambda p: float(np.quantile(x, p))
    med = q(.5); s.update(mean=x.mean(), median=med, sd=x.std(ddof=1),
                          p10=q(.10), p25=q(.25), p75=q(.75), p90=q(.90), p99=q(.99), mx=float(x[-1]))
    def rat(a, b): return a/b if b > 0 else np.nan
    s["p90_p10"] = rat(s["p90"], s["p10"]); s["p90_p25"] = rat(s["p90"], s["p25"])
    s["p90_p50"] = rat(s["p90"], med);     s["p50_p25"] = rat(med, s["p25"])
    s["p75_p25"] = rat(s["p75"], s["p25"]); s["p99_p50"] = rat(s["p99"], med)
    s.update(gap_p90_p50=s["p90"]-med, gap_p90_p25=s["p90"]-s["p25"], gap_p75_p25=s["p75"]-s["p25"])
    cut = np.array_split(np.arange(n), 5); tot = x.sum()
    if tot > 0:
        s["sh_top20"] = x[cut[4]].sum()/tot; s["sh_bot20"] = x[cut[0]].sum()/tot
        s["sh_top10"] = x[int(.9*n):].sum()/tot; s["sh_top5"] = x[int(.95*n):].sum()/tot
        s["r_top20_bot20"] = rat(x[cut[4]].sum(), x[cut[0]].sum())
        s["abs_mean_top20"] = x[cut[4]].mean(); s["abs_mean_bot20"] = x[cut[0]].mean()
        s["abs_gap_q5_q1"] = x[cut[4]].mean() - x[cut[0]].mean()
    s["sh_neg"] = float((x < 0).mean()); s["sh_zero"] = float((x == 0).mean())
    s["sh_nonpos"] = float((x <= 0).mean()); s["sh_pos"] = float((x > 0).mean())
    shift = -x[0] + 1.0 if x[0] < 0 else 0.0
    y = x + shift
    if y.sum() > 0 and n > 1:
        i = np.arange(1, n+1)
        s["gini_shifted"] = float((2*(i*y).sum())/(n*y.sum()) - (n+1)/n); s["gini_shift_used"] = shift
        s["min_raw"] = float(x[0])
    return s

STATS = ["mean","median","p10","p25","p75","p90","p99","mx","sd",
         "p90_p10","p90_p25","p90_p50","p50_p25","p75_p25","p99_p50",
         "gap_p90_p50","gap_p90_p25","gap_p75_p25",
         "sh_top20","sh_bot20","sh_top10","sh_top5","r_top20_bot20","abs_gap_q5_q1","abs_mean_top20","abs_mean_bot20",
         "sh_neg","sh_zero","sh_nonpos","sh_pos","gini_shifted"]

LA = lambda sub, yr: sub[yr].to_numpy(float)
LC = lambda sub, yr: (v := sub[yr].to_numpy(float))[v > 0]
LB = lambda sub, yr: (v := sub[yr].to_numpy(float))[(v != 0) if yr == W96 else (v >= 0)]

def samples(df, la):
    g = {}
    for sex, lab in (("male","WM"),("female","WF")):
        sub = df[(df.race_clean=="white") & (df.sex==sex)]
        g[(lab,1990)] = la(sub, W90); g[(lab,1996)] = la(sub, W96)
    return g

def point_tbl(smp):
    rows = []
    for (lab,yr), v in smp.items():
        st = stats(v)
        for k in STATS:
            if k in st: rows.append(dict(group=lab, year=yr, stat=k, value=st[k]))
    return pd.DataFrame(rows)

def boot(smp, R=R):
    keys = [("WM",1990),("WM",1996),("WF",1990),("WF",1996)]
    D = {(lab,k): np.empty(R) for lab in ("WM","WF") for k in STATS}
    L = {(yr,k): np.empty(R) for yr in (1990,1996) for k in STATS}
    for r in range(R):
        st = {kk: stats(smp[kk][RNG.integers(0, len(smp[kk]), len(smp[kk]))]) for kk in keys}
        for lab in ("WM","WF"):
            for k in STATS:
                a, b = st[(lab,1996)].get(k), st[(lab,1990)].get(k)
                D[(lab,k)][r] = (a-b) if (a is not None and b is not None) else np.nan
        for yr in (1990,1996):
            for k in STATS:
                a, b = st[("WF",yr)].get(k), st[("WM",yr)].get(k)
                L[(yr,k)][r] = (a-b) if (a is not None and b is not None) else np.nan
    return D, L

def pci(a):
    a = np.asarray(a, float); a = a[np.isfinite(a)]
    if len(a) < 50: return (np.nan, np.nan, np.nan, len(a))
    return (float(np.percentile(a,2.5)), float(np.percentile(a,97.5)), float(np.mean(a)), len(a))

white = d[d.race_clean=="white"]
main_tbl, boot_tbl, level_tbl = [], [], []
SMP = {}
for name, la in (("A_raw",LA), ("C_positive",LC), ("B_bound",LB)):
    smp = samples(white, la); SMP[name] = smp
    pt = point_tbl(smp); pt["layer"] = name
    piv = pt.pivot_table(index="stat", columns=["group","year"], values="value").reindex(STATS)
    piv.to_csv(f"{OUT}/points_{name}.csv")
    print(f"\n===== POINT ESTIMATES | layer {name} | n:", {f"{k[0]}/{k[1]}": len(v) for k,v in smp.items()})
    print(piv.round(2).to_string())
    if name == "B_bound": continue
    D, L = boot(smp)
    for k in STATS:
        p = {(lab,yr): pt.query("group==@lab and year==@yr and stat==@k").value.iloc[0]
             if len(pt.query("group==@lab and year==@yr and stat==@k")) else np.nan
             for lab in ("WM","WF") for yr in (1990,1996)}
        row = dict(layer=name, stat=k)
        for lab in ("WM","WF"):
            v90, v96 = p[(lab,1990)], p[(lab,1996)]
            lo, hi, bmean, nre = pci(D[(lab,k)])
            row.update(**{f"{lab}_1990": v90, f"{lab}_1996": v96, f"{lab}_delta_point": v96-v90,
                          f"{lab}_d_lo": lo, f"{lab}_d_hi": hi, f"{lab}_d_bootmean": bmean})
        dd = D[("WF",k)] - D[("WM",k)]
        lo, hi, bmean, nre = pci(dd)
        row.update(dDiD_point=(p[("WF",1996)]-p[("WF",1990)]) - (p[("WM",1996)]-p[("WM",1990)]),
                   dDiD_lo=lo, dDiD_hi=hi, dDiD_bootmean=bmean)
        boot_tbl.append(row)
    for k in STATS:
        row = dict(layer=name, stat=k)
        for yr in (1990,1996):
            lo, hi, bm, _ = pci(L[(yr,k)])
            row.update(**{f"FminusM_{yr}": L[(yr,k)].mean(), f"FmM_{yr}_lo": lo, f"FmM_{yr}_hi": hi})
        level_tbl.append(row)

B = pd.DataFrame(boot_tbl); B.to_csv(f"{OUT}/main_bootstrap.csv", index=False)
LV = pd.DataFrame(level_tbl); LV.to_csv(f"{OUT}/sex_level_gaps.csv", index=False)

print("\n\n################ MAIN TABLE: delta with 95% bootstrap CI (R=2000) ################")
for lay in ("A_raw","C_positive"):
    S = B[B.layer==lay]
    print(f"\n--- layer {lay} ---")
    print(S[["stat","WM_1990","WM_1996","WM_delta_point","WM_d_lo","WM_d_hi",
             "WF_1990","WF_1996","WF_delta_point","WF_d_lo","WF_d_hi"]].round(3).to_string(index=False))
    print(f"\n--- layer {lay}: DiD (Δfemale - Δmale) with 95% CI ---")
    print(S[["stat","dDiD_point","dDiD_lo","dDiD_hi","dDiD_bootmean"]].round(3).to_string(index=False))

print("\n\n################ SEX LEVEL GAPS (F - M), 95% CI ################")
for lay in ("A_raw","C_positive"):
    print(f"\n--- layer {lay} ---")
    print(LV[LV.layer==lay].round(3).to_string(index=False))
