import pandas as pd, numpy as np
pd.set_option("display.width", 240); pd.set_option("display.max_columns", 60)
d = pd.read_csv("data/nls_incarceration_processed.csv")
W = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
print("dtypes:\n", d.dtypes, "\n")
print("NaN counts (default parsing):", d.isna().sum().to_dict())
print("Fully duplicated rows:", d.duplicated().sum())
print("Duplicated on (race,sex,ever_jailed)+3 wealth:", d.duplicated(subset=["race","sex","ever_jailed"]+W).sum())

print("\n=== OVERALL distribution (all 12013) ===")
rows=[]
for c in W:
    s=d[c]
    rows.append(dict(col=c, n=len(s), min=s.min(), p1=s.quantile(.01), p10=s.quantile(.10),
        q1=s.quantile(.25), med=s.median(), mean=s.mean(), q3=s.quantile(.75),
        p90=s.quantile(.90), p99=s.quantile(.99), max=s.max(),
        sd=s.std(), skew=float(s.skew()), kurt=float(s.kurt()),
        n_neg=(s<0).sum(), pct_neg=100*(s<0).mean(), n_zero=(s==0).sum(), pct_zero=100*(s==0).mean(),
        n_pos=(s>0).sum(), pct_pos=100*(s>0).mean(),
        n_unique=s.nunique(), iqr=s.quantile(.75)-s.quantile(.25)))
print(pd.DataFrame(rows).round(1).T.to_string())

print("\n=== 'shelf' check: most common values at the TOP (1996) ===")
for c in W:
    top = d[c].value_counts().head(0)
    hi = d[c][d[c]>=d[c].quantile(.99)]
    print(c, "| #>=p99:", len(hi), "| distinct values >= p99:", hi.nunique(), "| top freq values overall:")
    print(d[c].value_counts().head(8).to_string())
    print("  round-number share (mod 10000==0):", round(100*(d[c] % 10000 == 0).mean(),2), "% ; mod 1000==0:", round(100*(d[c] % 1000 == 0).mean(),2),"%")
    print()

print("=== extreme tails 1990 / 1996 ===")
for c in ["composite_wealth_1990","composite_wealth_1996"]:
    print(c, "top10:", sorted(d[c].nlargest(10).tolist()))
    print(c, "bot10:", sorted(d[c].nsmallest(10).tolist()))
