"""(1) Robustness of the DIRECTION to heaping: dedup sample, p99-trimmed sample.
(2) Diagnostic layer: what actually moved the distribution (individual transitions).
(3) ever_jailed control: does the change survive the never-jailed subsample?
"""
import numpy as np, pandas as pd, os
RNG = np.random.default_rng(7); R = 2000
OUT="analysis/out"; pd.set_option("display.width",250); pd.set_option("display.max_columns",40)
d = pd.read_csv("data/nls_incarceration_processed.csv")
d["race_clean"]=d["race"].str.strip().str.lower().replace({"hipanic":"hispanic"})
W90,W96="composite_wealth_1990","composite_wealth_1996"
KEY=["median","p90","p25","p75","p90_p50","p90_p25","p75_p25","p99_p50","sh_top20","sh_top10","gap_p90_p50","sh_zero"]

def stats(x):
    x=np.sort(np.asarray(x,float)); n=len(x); s={"n":n}
    if n<5: return s
    q=lambda p: float(np.quantile(x,p)); med=q(.5)
    r=lambda a,b: a/b if b>0 else np.nan
    s.update(median=med,p25=q(.25),p75=q(.75),p90=q(.90),p99=q(.99),mean=x.mean(),
             p90_p50=r(q(.9),med),p90_p25=r(q(.9),q(.25)),p75_p25=r(q(.75),q(.25)),
             p99_p50=r(q(.99),med),gap_p90_p50=q(.9)-med,sh_zero=float((x==0).mean()))
    tot=x.sum()
    if tot>0:
        c=np.array_split(np.arange(n),5)
        s["sh_top20"]=x[c[4]].sum()/tot; s["sh_top10"]=x[int(.9*n):].sum()/tot
    return s

def series(df, mask_fn, la):
    out={}
    for sex,lab in (("male","WM"),("female","WF")):
        sub=df[(df.race_clean=="white")&(df.sex==sex)]
        if mask_fn is not None: sub=sub[mask_fn(sub)]
        for yr,c in ((1990,W90),(1996,W96)):
            v=la(sub,c); out[(lab,yr)]=stats(v)
    return out

LA=lambda s,c: s[c].to_numpy(float)
LC=lambda s,c: (v:=s[c].to_numpy(float))[v>0]

def direction_table(title, out, ratio_keys=("p90_p50","p90_p25","p75_p25")):
    rows=[]
    for lab in ("WM","WF"):
        for k in KEY:
            a=out[(lab,1990)].get(k,np.nan); b=out[(lab,1996)].get(k,np.nan)
            rows.append(dict(sample=title,group=lab,stat=k,y1990=a,y1996=b,delta=b-a,dir=("up" if b>a else "down" if b<a else "flat")))
    T=pd.DataFrame(rows); T.to_csv(f"{OUT}/dir_{title}.csv",index=False)
    print(f"\n=== DIRECTION | {title} ===")
    print(T.pivot_table(index=["stat","group"],columns="y1990" if False else ["stat","group"],values="delta").round(3).to_string() if False else T.round(3).to_string(index=False))
    return T

white=d[d.race_clean=="white"]
print("############ (1) ROBUSTNESS TO HEAPING / TRUNCATION ############")
base=series(white,None,LA); direction_table("A_main",base)
dd=d.drop_duplicates(keep="first"); ddw=dd[dd.race_clean=="white"]
print(f"\n[dedup note] white rows {len(white)} -> {len(ddw)}")
zall=((d[[W90,W96]]==0).all(axis=1))
ndrop=int(d.duplicated().sum()); nz=int(d[zall].duplicated().sum())
print(f"[dedup note] dropped {ndrop} duplicate rows; {nz} of them ({100*nz/ndrop:.1f}%) were all-zero rows -> dedup mechanically removes mostly ZERO rows, so layer A under dedup is NOT comparable; interpret dedup mainly for layer C")
direction_table("A_dedup",series(ddw,None,LA))
direction_table("C_dedup",series(ddw,None,LC))

# p99-trimmed (winsorize within group-year at p99, computed on layer A)
tw=white.copy()
for c in (W90,W96): tw[c]=tw[c].astype(float)
for sex in ("male","female"):
    m=tw.race_clean=="white" if False else (tw.race_clean=="white")&(tw.sex==sex)
    for c in (W90,W96):
        cap=tw.loc[m,c].quantile(.99); tw.loc[m,c]=tw.loc[m,c].clip(upper=cap)
direction_table("A_p99wins",series(tw,None,LA))
direction_table("C_p99wins",series(tw,None,LC))
direction_table("C_main",series(white,None,LC))
direction_table("C_nonzero_dedup",series(ddw,None,LC))

print("\n\n############ (2) DIAGNOSTIC: individual transitions (explanatory only) ############")
for sex,lab in (("male","WM"),("female","WF")):
    s=white[white.sex==sex]; a=s[W90].to_numpy(float); b=s[W96].to_numpy(float)
    n=len(s)
    tr=dict(group=lab,n=n,
      pos_to_zero=int(((a>0)&(b==0)).sum()), pos_to_zero_pct=100*((a>0)&(b==0)).mean(),
      zero_to_pos=int(((a==0)&(b>0)).sum()), stayed_zero=int(((a==0)&(b==0)).sum()),
      pos_to_pos=int(((a>0)&(b>0)).sum()),
      med_of_pos_to_zero_1990=float(np.median(a[(a>0)&(b==0)])),
      median_1990_posboth=float(np.median(a[(a>0)&(b>0)])), median_1996_posboth=float(np.median(b[(a>0)&(b>0)])),
      mean_pct_chg_posboth=float(100*np.mean((b[(a>0)&(b>0)]-a[(a>0)&(b>0)])/a[(a>0)&(b>0)])),
      median_pct_chg_posboth=float(100*np.median((b[(a>0)&(b>0)]-a[(a>0)&(b>0)])/a[(a>0)&(b>0)])),
      p90_posboth_1990=float(np.quantile(a[(a>0)&(b>0)],.9)), p90_posboth_1996=float(np.quantile(b[(a>0)&(b>0)],.9)))
    # decile mobility on pooled ranks within group
    r90=pd.Series(a).rank(pct=True).to_numpy(); r96=pd.Series(b).rank(pct=True).to_numpy()
    d90=np.clip((r90*10).astype(int),0,9); d96=np.clip((r96*10).astype(int),0,9)
    tr["decile_persistence"]=float((d90==d96).mean()); tr["moved_ge3_deciles"]=float((abs(d96-d90)>=3).mean())
    tr["spearman_rank_corr"]=float(pd.Series(a).corr(pd.Series(b),method="spearman"))
    # contribution: zeros vs top
    tr["top1pct_share_1990"]=float(a[a>=np.quantile(a,.99)].sum()/a.sum()); tr["top1pct_share_1996"]=float(b[b>=np.quantile(b,.99)].sum()/b.sum())
    num = {k: (float(v) if isinstance(v,(int,float,np.integer,np.floating)) and k!="n" else v) for k,v in tr.items()}
    print("  n =", num["n"]); print(pd.Series({k:float(v) for k,v in num.items() if k not in ("n","group")}).round(3).to_string()); print()
    pd.DataFrame([tr]).to_csv(f"{OUT}/diag_{lab}.csv",index=False)

print("\n############ (3) ever_jailed CONTROL (secondary, association only) ############")
rows=[]
for sex,lab in (("male","WM"),("female","WF")):
    for j in (0,1):
        s=white[(white.sex==sex)&(white.ever_jailed==j)]
        for yr,c,lay,lf in ((1990,W90,"A",LA),(1996,W96,"A",LA),(1990,W90,"C",LC),(1996,W96,"C",LC)):
            st=lf(s,c); st=stats(st)
            rows.append(dict(group=lab,ever_jailed=j,n_obs=len(s),layer=lay,year=yr,n_eff=st.get("n"),
                             median=st.get("median"),p90=st.get("p90"),p90_p50=st.get("p90_p50"),
                             p90_p25=st.get("p90_p25"),p75_p25=st.get("p75_p25"),sh_zero=st.get("sh_zero"),
                             sh_top20=st.get("sh_top20"),mean=st.get("mean")))
J=pd.DataFrame(rows); J.to_csv(f"{OUT}/jail_control.csv",index=False)
print(J.round(3).to_string(index=False))
print("\n--- jail: within-group DELTA (1996-1990) by layer ---")
piv=J.pivot_table(index=["group","ever_jailed","layer"],columns="year",values=["median","p90","p90_p50","p90_p25","p75_p25","sh_zero","sh_top20"])
print(piv.round(3).to_string())
