import pandas as pd, numpy as np
from scipy import stats

rng = np.random.default_rng(42)
W = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
YEARS = {'composite_wealth_1985':1985,'composite_wealth_1990':1990,'composite_wealth_1996':1996}
B = 10000

def cliffs_delta(x, y):
    nx, ny = len(x), len(y)
    u, _ = stats.mannwhitneyu(x, y, alternative='two-sided')
    return 2*u/(nx*ny) - 1

def wins(a, b, lo=0.01, hi=0.99):
    l, h = np.quantile(np.concatenate([a,b]),[lo,hi])
    return np.clip(a,l,h), np.clip(b,l,h)

def boot(x, y, stat, B=10000, chunk=1000):
    out = np.empty(B); i = 0
    while i < B:
        m = min(chunk, B-i)
        ix = rng.integers(0, len(x), size=(m, len(x)))
        iy = rng.integers(0, len(y), size=(m, len(y)))
        xb, yb = x[ix], y[iy]
        if stat == 'mean':
            out[i:i+m] = xb.mean(1) - yb.mean(1)
        else:
            out[i:i+m] = np.median(xb,1) - np.median(yb,1)
        i += m
    return np.percentile(out, [2.5, 97.5])

def fmt(ci): return f"[{ci[0]:,.0f}, {ci[1]:,.0f}]"

def run(df, label):
    rows = []
    for c in W:
        g1 = df.loc[df.ever_jailed==1, c].to_numpy(float)
        g0 = df.loc[df.ever_jailed==0, c].to_numpy(float)
        n1, n0 = len(g1), len(g0)
        u, p_l = stats.mannwhitneyu(g1, g0, alternative='less')
        cd = cliffs_delta(g1, g0); rb = u/(n1*n0) - 1
        t_raw, p_raw = stats.ttest_ind(g1, g0, equal_var=False)
        g1w, g0w = wins(g1, g0)
        t_w, p_w = stats.ttest_ind(g1w, g0w, equal_var=False)
        med_diff = np.median(g1) - np.median(g0)
        hl = float(np.median(np.subtract.outer(g1, rng.choice(g0, size=2000, replace=False))))
        ci_med = boot(g1, g0, 'median'); ci_mean = boot(g1, g0, 'mean'); ci_meanw = boot(g1w, g0w, 'mean')
        rows.append(dict(spec=label, year=YEARS[c], n1=n1, n0=n0,
            mean_j=g1.mean(), mean_nj=g0.mean(), med_j=np.median(g1), med_nj=np.median(g0),
            mean_diff=g1.mean()-g0.mean(), mean_diff_ci=fmt(ci_mean),
            mean_diff_w=g1w.mean()-g0w.mean(), mean_diffw_ci=fmt(ci_meanw),
            median_diff=med_diff, hl_shift=hl, median_diff_ci=fmt(ci_med),
            mwu_p=p_l, welch_raw=p_raw, welch_wins=p_w, cliffs=cd, rank_bis=rb))
    return pd.DataFrame(rows)

df = pd.read_csv('data/nls_incarceration_processed.csv')
res = pd.concat([run(df,'main'), run(df.drop_duplicates(),'dedup')])
pd.set_option('display.width', 260); pd.set_option('display.max_columns', 60)
for r in res.itertuples():
    print(f"\n[{r.spec}] {r.year}: n1={r.n1} n0={r.n0}")
    print(f"  jailed  mean={r.mean_j:,.0f} med={r.med_j:,.0f} | no-jail mean={r.mean_nj:,.0f} med={r.med_nj:,.0f}")
    print(f"  mean_diff(jailed-nojail)={r.mean_diff:,.0f} CI={r.mean_diff_ci} | winsorized={r.mean_diff_w:,.0f} CI={r.mean_diffw_ci}")
    print(f"  median_diff={r.median_diff:,.0f} HL_shift={r.hl_shift:,.0f} CI={r.median_diff_ci}")
    print(f"  MWU p(1<0)={r.mwu_p:.3g} | Welch raw p={r.welch_raw:.3g} | Welch wins p={r.welch_wins:.3g} | Cliff d={r.cliffs:.3f} | RB={r.rank_bis:.3f}")

sh = df.groupby(['race','sex'])['ever_jailed'].agg(jailed='sum', n='count')
sh['share_%'] = (100*sh.jailed/sh.n).round(2)
print("\nJail share by race x sex:\n", sh)
print("\nBy race %:\n", (100*df.groupby('race')['ever_jailed'].mean()).round(2).to_dict())
print("By sex %:\n", (100*df.groupby('sex')['ever_jailed'].mean()).round(2).to_dict())
res.to_csv('results_table.csv', index=False)
print("\nsaved results_table.csv")
