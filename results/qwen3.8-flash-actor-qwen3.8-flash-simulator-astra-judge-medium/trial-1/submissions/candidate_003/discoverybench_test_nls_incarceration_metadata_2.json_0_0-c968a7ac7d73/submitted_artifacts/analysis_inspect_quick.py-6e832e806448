import pandas as pd, numpy as np
df = pd.read_csv('data/nls_incarceration_processed.csv')
print("shape:", df.shape)
print("\ndtypes:\n", df.dtypes)
print("\nmissing:\n", df.isna().sum())
print("\never_jailed value counts:\n", df['ever_jailed'].value_counts(dropna=False))
print("\nrace:", df['race'].value_counts(dropna=False).to_dict())
print("sex:", df['sex'].value_counts(dropna=False).to_dict())
wcols = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
print("\nOverall wealth distributions:")
print(df[wcols].describe(percentiles=[.01,.05,.25,.5,.75,.95,.99]).T)
print("\nBy ever_jailed group:")
print(df.groupby('ever_jailed')[wcols].agg(['count','mean','median','std','min','max']).T)
# duplicates / negative values notes
print("\nfull duplicate rows:", df.duplicated().sum())
print("n ever_jailed==1:", int((df.ever_jailed==1).sum()), "| n ==0:", int((df.ever_jailed==0).sum()))
print("share jailed %:", 100*df.ever_jailed.mean())
