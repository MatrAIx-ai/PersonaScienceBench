import pandas as pd, numpy as np
from scipy import stats
df = pd.read_csv('data/nls_incarceration_processed.csv')
wcols = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
g0 = df[df.ever_jailed==0]; g1 = df[df.ever_jailed==1]
for c in wcols:
    q = lambda s: s.quantile([.25,.5,.75]).values
    print(c, "| jailed=0 quartiles:", q(g0[c]), "| jailed=1 quartiles:", q(g1[c]))
    u, p = stats.mannwhitneyu(g1[c], g0[c], alternative='less')
    t, pt = stats.ttest_ind(g1[c], g0[c], equal_var=False)
    print(f"   preview MWU p(1<0)={p:.3g}  Welch t p={pt:.3g}")
# skew
print("\nskew:", {c: round(float(stats.skew(df[c])),2) for c in wcols})
print("zero-share by group:")
print(df.groupby('ever_jailed')[wcols].apply(lambda d: (d==0).mean()))
