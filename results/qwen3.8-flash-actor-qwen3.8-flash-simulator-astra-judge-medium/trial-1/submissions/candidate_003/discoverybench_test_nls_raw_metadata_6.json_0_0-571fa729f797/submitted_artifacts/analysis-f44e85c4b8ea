P('=' * 100)
def run_models(d, tag):
    dm = d[(d.black == 1) | d.is_nbh].copy()
    dm['lvl'] = pd.Categorical(dm.level.astype(str), categories=sorted(dm.level.unique()), ordered=True)
    P(f'--- {tag}: n={len(dm)} (BLACK {int(dm.black.sum())}, NBBH {int(len(dm)-dm.black.sum())})')
    try:
        lg = smf.logit('college ~ C(lvl, Treatment("L1")) * black', data=dm).fit(method='bfgs', maxiter=3000, disp=0)
        P(lg.summary2().tables[1].round(4).to_string())
        names = list(lg.params.index)
        terms = [n for n in names if ':black' in n or n.startswith('black:')]
        if terms:
            Rm = np.zeros((len(terms), len(names)))
            for i, nm in enumerate(terms): Rm[i, names.index(nm)] = 1.0
            w = lg.wald_test(Rm, scalar=True)
            P(f'joint Wald test, interaction terms {terms}: chi2={w.statistic:.2f}, df={len(terms)}, p={w.pvalue:.4f}')
        pr = pd.DataFrame({'p': lg.predict(dm).values, 'black': dm.black.values, 'lvl': dm.lvl.astype(str).values})
        P('logit-predicted probability by cell:'); P(pr.pivot_table(index='lvl', columns='black', values='p', aggfunc='mean').round(4).to_string())
    except Exception as e:
        P(f'logit failed (separation/singularity): {type(e).__name__}: {e}')
    dm['ses_z'] = (dm.ses - dm.ses.mean())/dm.ses.std(ddof=0)
    lpm = smf.ols('college ~ black*ses_z', data=dm).fit(cov_type='HC1')
    P('LPM college ~ black*ses_z (HC1 robust):'); P(lpm.summary2().tables[1].round(4).to_string())
    ci = lpm.conf_int()
    P(f'gap at mean SES = {100*lpm.params["black"]:.2f} pp (95% CI {100*ci.loc["black",0]:.2f}..{100*ci.loc["black",1]:.2f}); '
      f'slope of gap per +1 SD SES = {100*lpm.params["black:ses_z"]:.2f} pp '
      f'(CI {100*ci.loc["black:ses_z",0]:.2f}..{100*ci.loc["black:ses_z",1]:.2f}), p={lpm.pvalues["black:ses_z"]:.4f}')
    lg2 = smf.logit('college ~ black*ses_z', data=dm).fit(disp=0)
    cil = lg2.conf_int()
    P(f'LOGIT (relative scale) black:ses_z -> OR={np.exp(lg2.params["black:ses_z"]):.3f} per +1SD SES '
      f'({np.exp(cil.loc["black:ses_z",0]):.3f}-{np.exp(cil.loc["black:ses_z",1]):.3f}), p={lg2.pvalues["black:ses_z"]:.4g}; '
      f'black main OR={np.exp(lg2.params["black"]):.3f} at mean SES')
    sub = dm[dm.asvab_wk.notna()]
    lp = smf.ols('college ~ C(lvl, Treatment("L1"))*black + male + asvab_wk', data=sub).fit(cov_type='HC1')
    P(f'LPM +male +ASVAB (n={int(lp.nobs)}) NET Black effect within each level (t_test):')
    for lev in ['black'] + [f'black + C(lvl, Treatment("L1"))[T.{l}]:black' for l in ['L2','L3'] if len(dm.lvl.unique()) > 1]:
        tt = lp.t_test(lev)
        P(f'   {lev:<52} = {100*float(np.ravel(tt.effect)[0]):+.2f} pp '
          f'(CI {100*float(np.ravel(tt.conf_int())[0]):+.2f}..{100*float(np.ravel(tt.conf_int())[1]):+.2f}, p={float(np.ravel(tt.pvalue)[0]):.4f})')
    la = smf.ols('college ~ black*ses_z + male + asvab_wk', data=sub.assign(ses_z=(sub.ses-sub.ses.mean())/sub.ses.std(ddof=0))).fit(cov_type='HC1')
    cia = la.conf_int()
    P(f'   ADJUSTED trend: gap at mean SES = {100*la.params["black"]:+.2f} pp '
      f'(CI {100*cia.loc["black",0]:+.2f}..{100*cia.loc["black",1]:+.2f}); slope per +1SD SES = '
      f'{100*la.params["black:ses_z"]:+.2f} pp (CI {100*cia.loc["black:ses_z",0]:+.2f}..{100*cia.loc["black:ses_z",1]:+.2f}, '
      f'p={la.pvalues["black:ses_z"]:.3g})')
    P(f'   ASVAB coverage of the modelled sample: {100*len(sub)/len(dm):.1f}% (n={len(sub)} of {len(dm)}); unadjusted counterpart for the same '
      f'subset: slope = {100*smf.ols("college ~ black*ses_z", data=sub.assign(ses_z=(sub.ses-sub.ses.mean())/sub.ses.std(ddof=0))).fit(cov_type="HC1").params["black:ses_z"]:+.2f} pp')
    return dm, lpm
