Z = 1.959963985
def wilson(a, n, z=Z):
    if n == 0: return (np.nan, np.nan, np.nan)
    p = a/n; d = 1 + z*z/n
    c = (p + z*z/(2*n))/d; h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n))/d
    return p, max(0., c-h), min(1., c+h)
def newcombe_diff(a1, n1, a2, n2, z=Z):
    if n1 == 0 or n2 == 0: return (np.nan,)*3
    p1,l1,u1 = wilson(a1,n1,z); p2,l2,u2 = wilson(a2,n2,z)
    d = p1-p2
    return d, d-np.sqrt((p1-l1)**2+(u2-p2)**2), d+np.sqrt((u1-p1)**2+(p2-l2)**2)
def rr_ci(a1, n1, a2, n2, z=Z):
    if n1 == 0 or n2 == 0: return (np.nan, np.nan, np.nan, np.nan)
    a,b,cc,dd = a1, a2, n1-a1, n2-a2; corr = 0.
    if a == 0 or b == 0 or cc == 0 or dd == 0:
        a,b,cc,dd = a+.5, b+.5, cc+.5, dd+.5; corr = .5
    rr = (a/(a+cc))/(b/(b+dd))
    se = np.sqrt(1/a - 1/(a+cc) + 1/b - 1/(b+dd))
    return rr, rr*np.exp(-z*se), rr*np.exp(z*se), corr
def power_2prop(p1, n1, p2, n2, alpha=.05):
    if n1 == 0 or n2 == 0: return np.nan
    p = (p1*n1+p2*n2)/(n1+n2)
    se0 = np.sqrt(p*(1-p)*(1/n1+1/n2)); se1 = np.sqrt(p1*(1-p1)/n1 + p2*(1-p2)/n2)
    return stats.norm.cdf((abs(p1-p2)-stats.norm.ppf(1-alpha/2)*se0)/se1) if se1 > 0 else np.nan
def mde_2prop(p2, n1, n2, power=.80, alpha=.05):
    p = max(min(p2, .999), .001)
    return np.sqrt(p*(1-p)*(1/n1+1/n2))*(stats.norm.ppf(1-alpha/2)+stats.norm.ppf(power))

