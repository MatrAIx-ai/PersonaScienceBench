INC = 'Total net family income, previous calendar year, 1979'
df['mom_gr'] = df[MOM].clip(upper=16); df['dad_gr'] = df[DAD].clip(upper=16)
df['inc_pc'] = np.log1p(df[INC].clip(lower=0)/df['Family size, 1979'].clip(lower=1))
COMPS4 = ['white_occ', 'mom_gr', 'dad_gr', 'inc_pc']; COMPS3 = ['mom_gr', 'dad_gr', 'inc_pc']
def make_index(d, comps):
    z = d[comps].apply(lambda s: (s-s.mean())/s.std(ddof=0))
    return z.mean(axis=1, skipna=True), z.notna().sum(axis=1)
def build(mask=None, thresh=500, comps=COMPS4, min_avail=3, nlevels=3):
    d = df if mask is None else df[mask(df)].copy()
    d = d.copy()
    d['white_occ'] = (d['occ'] < thresh).astype(float).where(d['occ'].notna())
    idx, nav = make_index(d, comps); d['ses'] = idx.where(nav >= min_avail)
    d = d[d.ses.notna()].copy()
    labs = ['L1','L2','L3'][:nlevels] if nlevels == 3 else ['L1','L2','L3','L4']
    d['level'] = pd.qcut(d.ses.rank(method='first'), nlevels, labels=labs)
    return d
def gap_table(d, ycol, cmp_col='is_nbh', label=''):
    rows = []
    for lev in list(d['level'].unique())+['POOLED']:
        sub = d if lev == 'POOLED' else d[d.level == lev]
        b = sub[sub.black == 1]; c = sub[sub[cmp_col]]
        ab, nb = int(b[ycol].sum()), len(b); ac, nc = int(c[ycol].sum()), len(c)
        pb,l1,u1 = wilson(ab,nb); pc,l2,u2 = wilson(ac,nc)
        dd,dl,dh = newcombe_diff(ab,nb,ac,nc); r = rr_ci(ab,nb,ac,nc)
        fl = []
        if nb < 100 or nc < 100: fl.append('n<100')
        if ab < 10 or ac < 10: fl.append('events<10')
        h = sub[sub.hispanic == 1]
        rows.append(dict(spec=label, level=lev, n_black=nb, ev_black=ab, pct_black=100*pb,
                         ci_black=f'[{100*l1:.1f},{100*u1:.1f}]', n_cmp=nc, ev_cmp=ac, pct_cmp=100*pc,
                         ci_cmp=f'[{100*l2:.1f},{100*u2:.1f}]', diff_pp=100*dd, diff_lo=100*dl, diff_hi=100*dh,
                         RR=r[0], RR_lo=r[1], RR_hi=r[2], cc_y_or_n='yes' if r[3] else '',
                         hisp_n=len(h), hisp_pct=100*h[ycol].mean() if len(h) else np.nan, flag=','.join(fl)))
    return pd.DataFrame(rows)
