"""Stage 1 (INSPECTION ONLY, no results): nls_raw.csv audit for the
'BA completion advantage for Black students across SES levels' question."""
import json
import numpy as np, pandas as pd

PATH = 'data/nls_raw.csv'
df = pd.read_csv(PATH)
r0 = df['Racial/ethnic cohort, 1979']
race = r0.map({1: 'BLACK', 2: 'HISPANIC', 3: 'NON-BLACK NON-HISPANIC'})
OCC = 'Occupation of adult male in household at age 14, 1979'
MOM = "Highest grade completed by respondent's mother, 1979"
DAD = "Highest grade completed by respondent's father, 1979"
INC79 = 'Total net family income, previous calendar year, 1979'
RL = {1: 'BLACK', 2: 'HISP', 3: 'NON-BBH'}
RES = [c for c in df.columns if c.startswith('Type of residence')]
NEEDED = ['Racial/ethnic cohort, 1979', 'Sex of respondent, 1979', OCC, MOM, DAD,
          'Highest grade completed, 1979', INC79, 'Family size, 1979',
          'Family net wealth, 1985', 'Family net wealth, 1990',
          'Family net wealth, 1996 (key data point)',
          'ASVAB - Word Knowledge Z Score (rounded), 1981'] + RES

out = []
p = out.append
p(f'shape = {df.shape}')
p('\n--- ALL RAW COLUMN NAMES (file) ---')
for i, c in enumerate(df.columns):
    p(f'{i:3d} {c!r}   missing={df[c].isna().mean():6.1%}')

p('\n--- (1) IS THERE A BA / DEGREE VARIABLE? ---')
kw = ['degree', 'diploma', 'ged', 'bachelor', 'ba completion', 'college', 'major',
      'ses', 'socioeconomic', 'poverty', 'needs', 'status']
hits = [c for c in df.columns if any(k in c.lower() for k in kw)]
p('columns whose NAME matches degree/BA/college/SES/poverty keywords: ' + str(hits))
tok = ['DEGREE', 'B.A', 'BACHELOR', 'GED', 'DIPLOMA']
cell_hits = sorted({(c, v) for c in df.columns for v in df[c].dropna().astype(str).unique().tolist()[:400]
                    if any(t in str(v).upper() for t in tok)})
p('cell VALUES anywhere matching those tokens: ' + str(cell_hits[:20]))
task = json.load(open('task.json'))
ds = json.loads(task['documents']['datasets.json'])
ds_cols = [c['name'] for c in ds['datasets'][0]['columns']['raw']]
p(f'datasheet n_cols={len(ds_cols)} vs file n_cols={len(df.columns)}; '
  f'datasheet-only={sorted(set(ds_cols) - set(df.columns))}; file-only={sorted(set(df.columns) - set(ds_cols))}')
g = df['Highest grade completed, 1979']
p(f'only education outcome = "Highest grade completed, 1979": max={g.max():.0f}, '
  f'n(grade>=16)={int((g >= 16).sum())}, n(grade>=12)={int((g >= 12).sum())}  <-- 1979 baseline only')
dorm = (df[RES] == 3).any(axis=1)
p(f'proxy candidate: ever residence==3 (DORM/FRATERNITY/SORORITY), any wave 1981-96: '
  f'n={int(dorm.sum())} ({dorm.mean():.2%})')
p('per-wave count of residence==3: ' + str({c[-4:]: int((df[c] == 3).sum()) for c in RES}))

p('\n--- (2) IS THERE A READY-MADE SES VARIABLE? ---')
p('no ses/poverty/needs column (see keyword scan). Closest raw inputs: '
  'parental grades, parental occupation code, family net income 1979/1985/1989, '
  'family net wealth 1985/1990/1996, family size 1979.')

p('\n--- (3) RACE / SEX DISTRIBUTION ---')
p(pd.crosstab(race, df['Sex of respondent, 1979'], margins=True).to_string())
p('race missing = ' + str(int(r0.isna().sum())))
p('Sample-ID x race (all Black/Hispanic respondents sit in oversample IDs):')
p(pd.crosstab(df['Sample ID, 1979 (interview)'], race).to_string())

p('\n--- (4) MISSINGNESS OF NEEDED COLUMNS, OVERALL AND BY RACE (%) ---')
rows = []
for c in NEEDED:
    row = {'column': c[:58], 'ALL': round(100 * df[c].isna().mean(), 1)}
    for a in [1, 2, 3]:
        row[RL[a]] = round(100 * df[c][r0 == a].isna().mean(), 1)
    rows.append(row)
p(pd.DataFrame(rows).to_string(index=False))

p('\n--- (5) OCCUPATION AT 14: VALUE STRUCTURE ---')
p(f'dtype={df[OCC].dtype}, n_unique={df[OCC].nunique()}, range=({df[OCC].min():.0f},{df[OCC].max():.0f}), '
  f'missing={df[OCC].isna().mean():.1%}  -> NUMERIC census-style occupation codes, NO text labels in file')
d = df[df[OCC].notna()].copy(); d['century'] = (d[OCC] // 100).astype(int)
emp = d.groupby('century').agg(n=(OCC, 'size'), mom_grades=(MOM, 'mean'), dad_grades=(DAD, 'mean'),
                               med_inc79=(INC79, 'median'),
                               asvab_wk=('ASVAB - Word Knowledge Z Score (rounded), 1981', 'mean'))
p('empirical SES gradient by 100-code block (validates monotone status ordering):')
p(emp.round(2).to_string())
p('top-15 most frequent codes: ' + str(df[OCC].value_counts().head(15).to_dict()))

p('\n--- (6) DATA-QUALITY FLAGS ---')
p("'Highest grade completed, 1979' contains code 95 (n=%d) = sentinel" % int((g == 95).sum()))
p("parental grades take values 19-20 (mother n=%d, father n=%d) -> implausible years, top-coded/flag"
  % (int((df[MOM] >= 19).sum()), int((df[DAD] >= 19).sum())))
p(f"income 1979 max={df[INC79].max():.0f} (top-code), wealth 1985 negative values n={int((df['Family net wealth, 1985'] < 0).sum())}")
p("ASVAB columns labelled 'Z Score' but range 165-825 (standard-score metric, mislabelled)")
p("'Family net wealth/income 1985-1996' describe the RESPONDENT's own household (age 20-37), i.e. post-enrolment/adult outcomes, not family of origin.")

p('\n--- (7) FEASIBILITY SIZES ONLY (not results): SES tertiles from origin variables ---')
comp = pd.DataFrame({'mom': df[MOM], 'dad': df[DAD],
                     'pc_inc79': np.log1p((df[INC79].clip(lower=0) / df['Family size, 1979'].clip(lower=1))),
                     'occ_white': (df[OCC] < 500).astype(float).where(df[OCC].notna())})
z = (comp - comp.mean()) / comp.std(); score = z.mean(axis=1, skipna=True)
avail = comp.notna().sum(axis=1); keep = avail >= 3
tert = pd.qcut(score.rank(method='first'), 3, labels=['low', 'mid', 'high'])
p('component correlations:\n' + comp.corr().round(3).to_string())
p('cell sizes: \n' + pd.crosstab(race[keep], tert[keep]).to_string())
p('ever-dorm rate by tertile x race (PROXY feasibility check only):\n' +
  pd.DataFrame({'t': tert, 'r': race, 'd': dorm})[keep.values].pivot_table(index='t', columns='r', values='d', aggfunc=['mean', 'size']).round(3).to_string())

txt = '\n'.join(str(x) for x in out)
open('analysis/inspection_output.txt', 'w').write(txt)
print(txt)
