#!/usr/bin/env python3
"""
NLSY79 family net wealth: median by racial/ethnic cohort, 1985 / 1990 / 1996.
Primary spec : per-wave (all observed cases in each wave), zeros & negatives kept
Sensitivity  : balanced panel, positive-only, winsorized 1/99
Money series : nominal USD and constant 1996 USD (external CPI-U constants -> ASSUMPTION)
"""
import numpy as np, pandas as pd, os

DATA, OUT, SEED, B = 'data/nls_raw.csv', 'outputs', 20261022, 1000
os.makedirs(OUT, exist_ok=True)

WEALTH = {1985: 'Family net wealth, 1985',
          1990: 'Family net wealth, 1990',
          1996: 'Family net wealth, 1996 (key data point)'}
COH   = 'Racial/ethnic cohort, 1979'
LBL   = {1: 'BLACK', 2: 'HISPANIC', 3: 'WHITE (non-black non-Hispanic)'}
YEARS = [1985, 1990, 1996]

# ASSUMPTION: external CPI-U annual averages (1982-84=100); no deflator exists in the data.
CPI  = {1985: 107.6, 1990: 130.7, 1996: 156.9}
DEFL = {y: CPI[1996] / CPI[y] for y in YEARS}

log = []
def say(*a):
    s = ' '.join(str(x) for x in a); print(s); log.append(s)

df = pd.read_csv(DATA)
df['cohort'] = df[COH].map(LBL)
say(f"rows={len(df)} cols={df.shape[1]} cohort-missing={int(df[COH].isna().sum())}")
say("CPI-U deflate-to-1996 factors (ASSUMPTION, external):", {y: round(DEFL[y], 4) for y in YEARS})

raw  = {y: pd.to_numeric(df[WEALTH[y]], errors='coerce') for y in YEARS}
real = {y: raw[y] * DEFL[y] for y in YEARS}

rng = np.random.default_rng(SEED)
def boot_indices(n, b): return rng.integers(0, n, size=(b, n))

def med_ci(x, b=B):
    x = np.asarray(x, float); x = x[~np.isnan(x)]
    if x.size == 0: return (np.nan, np.nan, np.nan, 0)
    m = np.median(x)
    if x.size == 1: return m, m, m, 1
    reps = np.median(x[boot_indices(x.size, b)], axis=1)
    lo, hi = np.percentile(reps, [2.5, 97.5])
    return m, lo, hi, x.size

def gap_ci(a, bb, b=B):
    a = np.asarray(a, float); a = a[~np.isnan(a)]
    bb = np.asarray(bb, float); bb = bb[~np.isnan(bb)]
    keys = ['diff','diff_lo','diff_hi','ratio','ratio_lo','ratio_hi','ratio_resolvable']
    if a.size == 0 or bb.size == 0: return {k: np.nan for k in keys}
    ia, ib = boot_indices(a.size, b), boot_indices(bb.size, b)
    ra, rb = np.median(a[ia], axis=1), np.median(bb[ib], axis=1)
    m = np.median(a) - np.median(bb)
    dlo, dhi = np.percentile(ra - rb, [2.5, 97.5])
    md = np.median(bb)
    _, d_lo_ci, d_hi_ci, _ = med_ci(bb, b)
    near_zero = (abs(md) < 0.10 * max(np.percentile(np.abs(rb), 75), 1.0)) or (d_lo_ci <= 0 <= d_hi_ci)
    with np.errstate(divide='ignore', invalid='ignore'):
        rr = ra / rb; rr = rr[np.isfinite(rr)]
        r = np.median(a) / md if md != 0 else np.nan
    unstable = near_zero or rr.size < 50 or (np.percentile(rr, 2.5) > 0 and
               np.percentile(rr, 97.5) / np.percentile(rr, 2.5) > 25)
    if unstable:
        rlo = rhi = np.nan; resolvable = False
    else:
        rlo, rhi = np.percentile(rr, [2.5, 97.5]); resolvable = True
    return dict(diff=m, diff_lo=dlo, diff_hi=dhi, ratio=r, ratio_lo=rlo, ratio_hi=rhi,
                ratio_resolvable=resolvable)

# ------------------------------------------------------ 1. attrition / item non-response
att = []
for y in YEARS:
    obs = raw[y].notna()
    for code in (1, 2, 3):
        m = df['cohort'] == LBL[code]
        n, k = int(m.sum()), int((m & obs).sum())
        att.append(dict(year=y, cohort=LBL[code], n_sample=n, n_observed=k, n_missing_wealth=n-k,
                        pct_observed=round(100*k/n, 1), pct_missing_wealth=round(100*(n-k)/n, 1)))
att_df = pd.DataFrame(att).sort_values(['year', 'cohort'])
att_df.to_csv(f'{OUT}/attrition_missing_by_cohort_year.csv', index=False)
say("\n=== ATTRITION / ITEM NON-RESPONSE ON WEALTH (% of cohort with observed wealth) ===")
say(att_df.pivot(index='cohort', columns='year', values='pct_observed').rename(
    columns=lambda c: f'pct_obs_{c}').to_string())
say("attrition vs 1985 base (pct of 1985-observed still observed):")
piv = att_df.pivot(index='cohort', columns='year', values='n_observed')
say((100 * piv.div(piv[1985], axis=0)).round(1).to_string())

# ------------------------------------------------------ 2. per-wave median matrix
def medians_matrix(ser, tag):
    rows = []
    for y in YEARS:
        v = ser[y]
        for code in (1, 2, 3):
            x = v[(df['cohort'] == LBL[code]).values]
            m, lo, hi, n = med_ci(x)
            xd = x.dropna()
            rows.append(dict(basis=tag, year=y, cohort=LBL[code], n=n,
                             median=round(m, 0), ci_lo=round(lo, 0), ci_hi=round(hi, 0),
                             mean=round(float(xd.mean()), 0),
                             share_wealth_le_0=round(float((xd <= 0).mean()), 4)))
    return pd.DataFrame(rows)

med_nom, med_real = medians_matrix(raw, 'nominal'), medians_matrix(real, 'constant_1996')
med = pd.concat([med_nom, med_real], ignore_index=True)
med.to_csv(f'{OUT}/wealth_medians_by_cohort_year.csv', index=False)
for tag, t in (('nominal USD', med_nom), ('constant 1996 USD', med_real)):
    say(f"\n=== PER-WAVE MEDIAN FAMILY NET WEALTH [{tag}] ===")
    say(t.pivot(index='cohort', columns='year', values='median').astype(int).rename(
        columns=lambda c: f'median_{c}').to_string())
    say("n observed:")
    say(t.pivot(index='cohort', columns='year', values='n').rename(
        columns=lambda c: f'n_{c}').to_string())
    say("95% bootstrap CI (1000 reps):")
    say(t.assign(ci=t.apply(lambda r: f"[{int(r.ci_lo):,} ; {int(r.ci_hi):,}]", axis=1))
           .pivot(index='cohort', columns='year', values='ci').to_string())

# ------------------------------------------------------ 3. gaps (abs + ratio) per wave
def gaps(ser, tag):
    rows = []
    for y in YEARS:
        obs = ser[y].notna().values
        v = ser[y][obs]
        coh_obs = (df['cohort'].values)[obs]
        w = v[coh_obs == LBL[3]]
        for code, nm in ((1, 'WHITE_vs_BLACK'), (2, 'WHITE_vs_HISPANIC')):
            o = v[coh_obs == LBL[code]]
            g = gap_ci(w, o)
            sw, so = float((w.dropna() <= 0).mean()), float((o.dropna() <= 0).mean())
            rows.append(dict(year=y, contrast=nm,
                median_white=round(np.median(w), 0), median_other=round(np.median(o), 0),
                delta_abs=round(g['diff'], 0), delta_lo=round(g['diff_lo'], 0), delta_hi=round(g['diff_hi'], 0),
                ratio=round(g['ratio'], 2) if np.isfinite(g['ratio']) else np.nan,
                ratio_lo=round(g['ratio_lo'], 2) if np.isfinite(g['ratio_lo']) else np.nan,
                ratio_hi=round(g['ratio_hi'], 2) if np.isfinite(g['ratio_hi']) else np.nan,
                ratio_resolvable=g['ratio_resolvable'],
                share_le0_white=round(sw, 4), share_le0_other=round(so, 4),
                share_le0_diff_pp=round(100*(sw-so), 1)))
    return pd.DataFrame(rows)

gaps_df = pd.concat([gaps(raw, 'nominal').assign(basis='nominal'),
                     gaps(real, 'constant_1996').assign(basis='constant_1996')], ignore_index=True)
for tag in ('nominal', 'constant_1996'):
    say(f"\n=== WHITE-vs-MINORITY GAPS [{tag}] ===")
    say(gaps_df[gaps_df.basis == tag][['year','contrast','median_white','median_other','delta_abs',
        'delta_lo','delta_hi','ratio','ratio_lo','ratio_hi','ratio_resolvable',
        'share_le0_white','share_le0_other','share_le0_diff_pp']].to_string(index=False))

# ------------------------------------------------------ 4. dynamics between waves
def dyn_cohort(ser, tag):
    rows = []
    for code in (1, 2, 3):
        mb = {y: float(np.median(ser[y][(df['cohort'] == LBL[code]).values].dropna())) for y in YEARS}
        for a, b_ in ((1985, 1990), (1990, 1996), (1985, 1996)):
            rows.append(dict(basis=tag, cohort=LBL[code], window=f'{a}->{b_}',
                             median_from=round(mb[a], 0), median_to=round(mb[b_], 0),
                             change_abs=round(mb[b_]-mb[a], 0),
                             change_pct=round(100*(mb[b_]/mb[a]-1), 1) if mb[a] else np.nan))
    return pd.DataFrame(rows)

dyn = pd.concat([dyn_cohort(raw, 'nominal'), dyn_cohort(real, 'constant_1996')], ignore_index=True)

def dyn_gap(tag):
    g = gaps_df[gaps_df.basis == tag].set_index(['contrast', 'year'])
    rows = []
    for nm in ('WHITE_vs_BLACK', 'WHITE_vs_HISPANIC'):
        for a, b_ in ((1985, 1990), (1990, 1996), (1985, 1996)):
            d0, d1 = g.loc[(nm, a), 'delta_abs'], g.loc[(nm, b_), 'delta_abs']
            r0, r1 = g.loc[(nm, a), 'ratio'], g.loc[(nm, b_), 'ratio']
            rows.append(dict(basis=tag, contrast=nm, window=f'{a}->{b_}',
                             delta_from=d0, delta_to=d1, delta_change=round(d1-d0, 0),
                             ratio_from=r0, ratio_to=r1,
                             ratio_change_pp=round(100*(r1-r0), 1) if np.isfinite(r0) and np.isfinite(r1) else np.nan,
                             ratio_change_x=round(r1/r0, 3) if np.isfinite(r0) and np.isfinite(r1) and r0 else np.nan))
    return pd.DataFrame(rows)

gapdyn = pd.concat([dyn_gap('nominal'), dyn_gap('constant_1996')], ignore_index=True)
gaps_df.to_csv(f'{OUT}/gaps_abs_and_ratio.csv', index=False)
dyn.to_csv(f'{OUT}/dynamics_cohort_medians.csv', index=False)
gapdyn.to_csv(f'{OUT}/dynamics_gaps.csv', index=False)
say("\n=== COHORT MEDIAN DYNAMICS (per-wave) ===")
say(dyn.to_string(index=False))
say("\n=== GAP DYNAMICS (white-minus-minority) ===")
say(gapdyn.to_string(index=False))

# ------------------------------------------------------ 5. balanced-panel sensitivity
pm = (raw[1985].notna() & raw[1990].notna() & raw[1996].notna()).values
say(f"\n=== BALANCED PANEL (all 3 waves observed) n={int(pm.sum())} {df.loc[pm,'cohort'].value_counts().to_dict()}")
p_rows = []
for y in YEARS:
    for code in (1, 2, 3):
        sel = (df['cohort'] == LBL[code]).values & pm
        m, lo, hi, n = med_ci(real[y][sel])
        p_rows.append(dict(year=y, cohort=LBL[code], n=n,
                           median_nom=round(float(np.median(raw[y][sel].dropna())), 0),
                           median_real=round(m, 0), ci_lo=round(lo, 0), ci_hi=round(hi, 0)))
panel = pd.DataFrame(p_rows)
panel.to_csv(f'{OUT}/sensitivity_balanced_panel.csv', index=False)
say("panel medians [constant 1996 USD]:")
say(panel.pivot(index='cohort', columns='year', values='median_real').astype(int).to_string())
say("panel medians [nominal USD]:")
say(panel.pivot(index='cohort', columns='year', values='median_nom').astype(int).to_string())

cmp_rows = []
for y in YEARS:
    for code, nm in ((1, 'WHITE_vs_BLACK'), (2, 'WHITE_vs_HISPANIC')):
        c3, cc = (df['cohort'] == LBL[3]).values, (df['cohort'] == LBL[code]).values
        w,  o   = raw[y][c3].dropna(),  raw[y][cc].dropna()
        wp, op  = raw[y][c3 & pm].dropna(), raw[y][cc & pm].dropna()
        wr, orr = real[y][c3].dropna(), real[y][cc].dropna()
        wrp, orp= real[y][c3 & pm].dropna(), real[y][cc & pm].dropna()
        cmp_rows.append(dict(year=y, contrast=nm,
            ratio_perwave_nom=round(np.median(w)/np.median(o), 2), ratio_panel_nom=round(np.median(wp)/np.median(op), 2),
            delta_perwave_nom=round(np.median(w)-np.median(o), 0), delta_panel_nom=round(np.median(wp)-np.median(op), 0),
            ratio_perwave_real=round(np.median(wr)/np.median(orr), 2), ratio_panel_real=round(np.median(wrp)/np.median(orp), 2),
            delta_perwave_real=round(np.median(wr)-np.median(orr), 0), delta_panel_real=round(np.median(wrp)-np.median(orp), 0),
            white_med_perwave=round(np.median(wr), 0), white_med_stayers=round(np.median(wrp), 0),
            other_med_perwave=round(np.median(orr), 0), other_med_stayers=round(np.median(orp), 0)))
cmp_df = pd.DataFrame(cmp_rows); cmp_df.to_csv(f'{OUT}/perwave_vs_panel_comparison.csv', index=False)
say("\n=== PER-WAVE vs BALANCED PANEL (ratio & Δ) ===")
say(cmp_df.to_string(index=False))

w85 = real[1985][pm].reset_index(drop=True); w96 = real[1996][pm].reset_index(drop=True)
coh_p = df.loc[pm, 'cohort'].reset_index(drop=True)
say("\nstayers: within-person median change 85->96 (1996 USD), and mobility across the 0 line:")
for code in (1, 2, 3):
    m = (coh_p == LBL[code]).values
    say(f"  {LBL[code]:32s} n={int(m.sum()):5d} med_change={np.median(w96[m]-w85[m]):>10,.0f} "
        f"pct_pos_to_le0={100*np.mean((w96[m]<=0)&(w85[m]>0)):5.1f}%  pct_le0_to_pos={100*np.mean((w96[m]>0)&(w85[m]<=0)):5.1f}%")

# ------------------------------------------------------ 6. sensitivity summary (one table)
sens, rvar = [], []
for y in YEARS:
    for code in (1, 2, 3):
        x = real[y][(df['cohort'] == LBL[code]).values].dropna()
        lo, hi = np.percentile(x, [1, 99])
        sens.append(dict(basis='constant_1996', year=y, cohort=LBL[code], n=len(x),
                         median_base=round(np.median(x), 0),
                         median_positive_only=round(np.median(x[x > 0]), 0), n_positive=int((x > 0).sum()),
                         mean_base=round(float(x.mean()), 0), mean_winsor1_99=round(float(x.clip(lo, hi).mean()), 0),
                         median_winsor1_99=round(np.median(x.clip(lo, hi)), 0),
                         share_le_0=round(float((x <= 0).mean()), 4), share_lt_0=round(float((x < 0).mean()), 4),
                         n_at_sample_max=int((raw[y][(df['cohort'] == LBL[code]).values].dropna() ==
                                              raw[y][(df['cohort'] == LBL[code]).values].dropna().max()).sum()),
                         sample_max_nominal=float(raw[y][(df['cohort'] == LBL[code]).values].dropna().max())))
    for kind in ('base', 'positive_only', 'winsor1_99'):
        for cmt, nm in ((1, 'WHITE_vs_BLACK'), (2, 'WHITE_vs_HISPANIC')):
            w = real[y][(df['cohort'] == LBL[3]).values].dropna()
            o = real[y][(df['cohort'] == LBL[cmt]).values].dropna()
            if kind == 'positive_only': w, o = w[w > 0], o[o > 0]
            if kind == 'winsor1_99':  # median invariant -> this variant is reported on MEANS
                l, h = np.percentile(pd.concat([w, o]), [1, 99]); w, o = w.clip(l, h), o.clip(l, h)
            f = np.mean if kind == 'winsor1_99' else np.median
            rvar.append(dict(basis='constant_1996', year=y, variant=kind + ('_of_means' if kind == 'winsor1_99' else '_of_medians'),
                             contrast=nm, stat_white=round(float(f(w)), 0), stat_other=round(float(f(o)), 0),
                             delta=round(float(f(w) - f(o)), 0),
                             ratio=round(float(f(w)) / float(f(o)), 2) if float(f(o)) else np.nan))
sens_df, rvar_df = pd.DataFrame(sens), pd.DataFrame(rvar)
pd.concat([sens_df, rvar_df], axis=0, ignore_index=True).to_csv(f'{OUT}/sensitivity_variants.csv', index=False)
say("\n=== SENSITIVITY (constant 1996 USD): base / positive-only / winsor 1-99 / share<=0 ===")
say(sens_df.pivot(index='cohort', columns='year',
    values=['median_base', 'median_positive_only', 'median_winsor1_99',
           'mean_base', 'mean_winsor1_99', 'share_le_0']).to_string())
say('NOTE: the median is invariant to 1/99 winsorisation (monotone tail clipping); the top-code effect shows up in the MEAN columns.')
say("--- white/minority ratio under variants ---")
say(rvar_df.pivot(index=['year', 'contrast'], columns='variant', values='ratio').to_string())
say("--- same, absolute Δ (1996 USD) ---")
say(rvar_df.pivot(index=['year', 'contrast'], columns='variant', values='delta').to_string())

with open(f'{OUT}/run_log.txt', 'w') as f: f.write('\n'.join(log) + '\n')
say("core tables written; plotting step follows")


# ------------------------------------------------------ 7. charts (pure-SVG; matplotlib not installed offline)
def line_chart(path, series, title, ylab, ticks_years=YEARS, figsize=(760, 500), note=''):
    W, H = figsize; ml, mr, mt, mb = 92, 24, 54, 62
    pw, ph = W - ml - mr, H - mt - mb
    vals = [x for _n, _c, pts in series for _y, x, lo, hi in pts if x == x and lo == lo]
    ymin, ymax = min(vals + [0]), max(vals)
    pad = 0.08 * (ymax - ymin or 1); ymin, ymax = ymin - pad, ymax + pad * 2
    X = lambda y: ml + pw * (YEARS.index(y) / (len(YEARS) - 1))
    Y = lambda v: mt + ph * (1 - (v - ymin) / (ymax - ymin))
    s = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="Helvetica,Arial" font-size="12">',
         f'<rect width="{W}" height="{H}" fill="white"/>',
         f'<text x="{W/2}" y="22" text-anchor="middle" font-size="14" font-weight="bold">{title}</text>']
    for k in range(6):
        v = ymin + (ymax - ymin) * k / 5; yy = Y(v)
        s.append(f'<line x1="{ml}" y1="{yy:.1f}" x2="{W-mr}" y2="{yy:.1f}" stroke="#dddddd"/>')
        s.append(f'<text x="{ml-8}" y="{yy+4:.1f}" text-anchor="end" fill="#444">{v:,.0f}</text>')
    s.append(f'<line x1="{ml}" y1="{Y(0):.1f}" x2="{W-mr}" y2="{Y(0):.1f}" stroke="#888" stroke-dasharray="4 3"/>')
    for y in ticks_years:
        s.append(f'<line x1="{X(y):.1f}" y1="{mt}" x2="{X(y):.1f}" y2="{mt+ph}" stroke="#eeeeee"/>')
        s.append(f'<text x="{X(y):.1f}" y="{mt+ph+18}" text-anchor="middle" fill="#333">{y}</text>')
    for name, col, pts in series:
        ys = [p for p, *_ in pts]
        s.append('<polyline fill="none" stroke="%s" stroke-width="2.5" points="%s"/>' %
                 (col, ' '.join(f'{X(y):.1f},{Y(v):.1f}' for y, v, *_ in pts)))
        for y, v, lo, hi in pts:
            if lo == lo:
                s.append(f'<line x1="{X(y):.1f}" y1="{Y(lo):.1f}" x2="{X(y):.1f}" y2="{Y(hi):.1f}" stroke="{col}" stroke-width="1.2" opacity="0.65"/>')
            s.append(f'<circle cx="{X(y):.1f}" cy="{Y(v):.1f}" r="4.5" fill="{col}"/>')
            s.append(f'<text x="{X(y):.1f}" y="{Y(v)-10:.1f}" text-anchor="middle" fill="{col}" font-size="10">{v:,.0f}</text>')
    ly = mt + 14
    for name, col, pts in series:
        s.append(f'<rect x="{ml+10}" y="{ly-9}" width="11" height="11" fill="{col}"/>')
        s.append(f'<text x="{ml+27}" y="{ly}" fill="#222">{name}</text>'); ly += 17
    s.append(f'<text x="16" y="{mt+ph/2}" transform="rotate(-90 16 {mt+ph/2})" text-anchor="middle" fill="#222">{ylab}</text>')
    if note: s.append(f'<text x="{ml}" y="{H-12}" fill="#666" font-size="10">{note}</text>')
    s.append('</svg>')
    open(path, 'w').write('\n'.join(s))

COL = {LBL[1]: '#c0392b', LBL[2]: '#e67e22', LBL[3]: '#2c3e50'}
for tag, t, unit in (('nominal', med_nom, 'nominal USD'), ('constant_1996', med_real, 'constant 1996 USD')):
    sr = [(c, COL[c], [(int(r['year']), float(r['median']), float(r['ci_lo']), float(r['ci_hi']))
                       for _, r in t[t.cohort == c].sort_values('year').iterrows()])
          for c in (LBL[3], LBL[1], LBL[2])]
    line_chart(f'{OUT}/median_wealth_by_cohort_{tag}.svg', sr,
               f'NLSY79 median family net wealth by cohort ({unit}, per-wave, unweighted)',
               f'Median family net wealth ({unit})',
               note='Whiskers = 95% bootstrap CI (1000 reps). Zeros/negatives retained.')

def two_line(path, pairs, title, ylab, note=''):
    W, H = 760, 500; ml, mr, mt, mb = 92, 30, 54, 62; pw, ph = W-ml-mr, H-mt-mb
    vals = [v for _n, _c, ys, _d in pairs for _i, v in ys]
    ymin, ymax = 0, max(vals) * 1.18
    X = lambda i: ml + pw * i / (len(YEARS) - 1)
    Y = lambda v: mt + ph * (1 - (v - ymin) / (ymax - ymin))
    s = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="Helvetica,Arial" font-size="12">',
         f'<rect width="{W}" height="{H}" fill="white"/>',
         f'<text x="{W/2}" y="22" text-anchor="middle" font-size="14" font-weight="bold">{title}</text>']
    for k in range(6):
        v = ymin + (ymax - ymin) * k / 5; yy = Y(v)
        s.append(f'<line x1="{ml}" y1="{yy:.1f}" x2="{W-mr}" y2="{yy:.1f}" stroke="#dddddd"/>')
        s.append(f'<text x="{ml-8}" y="{yy+4:.1f}" text-anchor="end" fill="#444">{v:,.0f}</text>')
    for i, y in enumerate(YEARS):
        s.append(f'<text x="{X(i):.1f}" y="{mt+ph+18}" text-anchor="middle" fill="#333">{y}</text>')
    ly = mt + 14
    for nm, col, ys, dash in pairs:
        s.append('<polyline fill="none" stroke="%s" stroke-width="2.5" %s points="%s"/>' %
                 (col, f'stroke-dasharray="{dash}"' if dash else '',
                  ' '.join(f'{X(i):.1f},{Y(v):.1f}' for i, (_, v) in enumerate(ys))))
        for i, (_, v) in enumerate(ys):
            s.append(f'<circle cx="{X(i):.1f}" cy="{Y(v):.1f}" r="4" fill="{col}"/>')
            s.append(f'<text x="{X(i):.1f}" y="{Y(v)-9:.1f}" text-anchor="middle" fill="{col}" font-size="10">{v:,.2f}</text>')
        s.append(f'<rect x="{ml+10}" y="{ly-9}" width="11" height="11" fill="{col}"/>')
        s.append(f'<text x="{ml+27}" y="{ly}" fill="#222">{nm}</text>'); ly += 17
    s.append(f'<text x="16" y="{mt+ph/2}" transform="rotate(-90 16 {mt+ph/2})" text-anchor="middle" fill="#222">{ylab}</text>')
    if note: s.append(f'<text x="{ml}" y="{H-12}" fill="#666" font-size="10">{note}</text>')
    s.append('</svg>')
    open(path, 'w').write('\n'.join(s))

