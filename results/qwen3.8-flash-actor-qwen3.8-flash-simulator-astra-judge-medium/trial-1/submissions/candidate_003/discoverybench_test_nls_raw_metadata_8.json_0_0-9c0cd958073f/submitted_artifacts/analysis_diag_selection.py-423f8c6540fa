import pandas as pd, numpy as np
df=pd.read_csv('data/nls_raw.csv'); C='Racial/ethnic cohort, 1979'
L={1:'BLACK',2:'HISPANIC',3:'WHITE'}; df['coh']=df[C].map(L)
W={1985:'Family net wealth, 1985',1990:'Family net wealth, 1990',1996:'Family net wealth, 1996 (key data point)'}
r={y:pd.to_numeric(df[W[y]],errors='coerce') for y in W}
D={1985:156.9/107.6,1990:156.9/130.7,1996:1.0}
pm=(r[1985].notna()&r[1990].notna()&r[1996].notna()).values
print("1996 wealth (1996 USD): stayers (panel) vs per-wave-only-not-stayers vs all per-wave")
for code in (1,2,3):
    c=(df['coh']==L[code]).values
    allv=(r[1996]*D[1996])[c].dropna()
    st=(r[1996]*D[1996])[c&pm].dropna()
    ns=(r[1996]*D[1996])[c&~pm].dropna()
    print(f" {L[code]:9s} per-wave med={np.median(allv):9,.0f} (n={len(allv)})  stayers={np.median(st):9,.0f} (n={len(st)})  non-stayers={np.median(ns):9,.0f} (n={len(ns)})")
print("\n1996 observed whites split by 1985 wealth availability:")
c3=(df['coh']==L[3]).values & r[1996].notna().values
g1=r[1996][c3 & r[1985].notna().values]*D[1996]; g2=r[1996][c3 & r[1985].isna().values]*D[1996]
print(f"  also observed 1985: med={np.median(g1):,.0f} n={len(g1)} | only 1996: med={np.median(g2):,.0f} n={len(g2)}")
print("\npanel-implied ratio 1996: %.2f ; per-wave ratio 1996: %.2f"%(
  np.median((r[1996]*D[1996])[(df['coh']==L[3]).values&pm].dropna())/np.median((r[1996]*D[1996])[(df['coh']==L[1]).values&pm].dropna()),
  np.median((r[1996]*D[1996])[(df['coh']==L[3]).values].dropna())/np.median((r[1996]*D[1996])[(df['coh']==L[1]).values].dropna())))
# per-wave white ratio if whites had cohort-specific observation weights equal to their 1985 share (cohort-size reweighting sanity)
print("\nage check: mean age-in-1979 of white 1996-observed vs black 1996-observed")
for code in (1,2,3):
    m=(df['coh']==L[code]).values & r[1996].notna().values
    print(f"  {L[code]:9s} mean age1979={df.loc[m,'Age of respondent, 1979'].mean():.2f}")
# ratio robustness: trimmed (drop top/bottom 1%) medians
print("\n5%-trimmed medians 1996 USD:")
for code in (1,2,3):
    x=(r[1996]*D[1996])[(df['coh']==L[code]).values].dropna()
    lo,hi=np.percentile(x,[5,95]); print(f"  {L[code]:9s} trimmed median={np.median(x[(x>=lo)&(x<=hi)]):9,.0f}")
