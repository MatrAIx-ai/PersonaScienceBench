import pandas as pd
O='outputs'
med=pd.read_csv(f'{O}/wealth_medians_by_cohort_year.csv'); g=pd.read_csv(f'{O}/gaps_abs_and_ratio.csv')
att=pd.read_csv(f'{O}/attrition_missing_by_cohort_year.csv'); cmpf=pd.read_csv(f'{O}/perwave_vs_panel_comparison.csv')
sel=pd.read_csv(f'{O}/selection_direction_1996.csv'); sens=pd.read_csv(f'{O}/sensitivity_variants.csv')
dg=pd.read_csv(f'{O}/dynamics_gaps.csv'); dc=pd.read_csv(f'{O}/dynamics_cohort_medians.csv')
L=[]
def w(*a): L.append(' '.join(str(x) for x in a))
w("# NLSY79 family net wealth by racial/ethnic cohort, 1985 / 1990 / 1996 — findings\n")
w("**Spec:** per-wave (all observed cases per wave), unweighted; zeros and negatives retained in the primary estimate.")
w("**Money series:** nominal USD and constant 1996 USD (CPI-U annual means 107.6 / 130.7 / 156.9, 1982-84=100 — external ASSUMPTION, no deflator in data).\n")
w("## 1. Median family net wealth (constant 1996 USD, 95% bootstrap CI, n)")
for yr in (1985,1990,1996):
    t=med[(med.basis=='constant_1996')&(med.year==yr)]
    parts=[f"{r.cohort.split(' ')[0]}: ${r['median']:,.0f} [{r['ci_lo']:,.0f}–{r['ci_hi']:,.0f}] (n={r.n})" for _,r in t.iterrows()]
    w(f"- {yr}: " + " | ".join(parts))
w("\nNominal USD medians:")
for yr in (1985,1990,1996):
    t=med[(med.basis=='nominal')&(med.year==yr)]
    w(f"- {yr}: " + " | ".join(f"{r.cohort.split(' ')[0]} ${r['median']:,.0f}" for _,r in t.iterrows()))
w("\n## 2. White-minus-minority gap: absolute Δ and ratio (both money series)")
for b in ('nominal','constant_1996'):
    w(f"**{b}**")
    for _,r in g[g.basis==b].iterrows():
        w(f"- {int(r.year)} {r.contrast}: Δ = ${r.delta_abs:,.0f} [{r.delta_lo:,.0f}–{r.delta_hi:,.0f}]; ratio = {r.ratio:.2f} [{r.ratio_lo:.2f}–{r.ratio_hi:.2f}]; share wealth ≤0: white {100*r.share_le0_white:.1f}% vs other {100*r.share_le0_other:.1f}% ({r.share_le0_diff_pp:+.1f} pp)")
w("\nRatios are invariant to within-year deflation, so ratio values are identical in the two series; only Δ$ differ.")
w("\n## 3. Dynamics between waves")
for b in ('nominal','constant_1996'):
    w(f"**{b}**")
    for _,r in dg[dg.basis==b].iterrows():
        w(f"- {r.contrast} {r.window}: Δ {r.delta_from:,.0f} → {r.delta_to:,.0f} (change {r.delta_change:+,.0f}); ratio {r.ratio_from:.2f} → {r.ratio_to:.2f} (×{r.ratio_change_x:.2f})")
w("\nCohort median growth (constant 1996 USD), 1985→1996: white +734.7%, black +320.0%, Hispanic +251.5% "
  "(nominal: white +1117.1%, black +512.5%, Hispanic +412.5%).")
w("\n## 4. Attrition / item non-response on the wealth variable (% of cohort with observed wealth)")
for yr in (1985,1990,1996):
    t=att[att.year==yr]
    w(f"- {yr}: " + " | ".join(f"{r.cohort.split(' ')[0]} {r.pct_observed:.1f}% (n={r.n_observed}/{r.n_sample})" for _,r in t.iterrows()))
w("Retained share of the 1985 wealth-observed base by 1996: black 80.5%, Hispanic 80.3%, white 61.6%.")
w("\n## 5. Per-wave vs balanced panel (selection check)")
w("Constant-1996-USD ratios:")
for _,r in cmpf.iterrows():
    w(f"- {int(r.year)} {r.contrast}: per-wave {r.ratio_perwave_real:.2f} (Δ ${r.delta_perwave_real:,.0f}) vs panel {r.ratio_panel_real:.2f} (Δ ${r.delta_panel_real:,.0f})")
w("\n1996 medians by retention group (constant 1996 USD):")
for _,r in sel.iterrows():
    w(f"- {r.cohort}: per-wave ${r.med_1996_perwave:,.0f} | full-panel stayers ${r.med_1996_stayers_all3waves:,.0f} | 1996-observed but not full panel ${r.med_1996_not_full_panel:,.0f}")
w("\n## 6. Sensitivity (constant 1996 USD)")
piv=sens.dropna(subset=['median_base']).pivot(index='cohort',columns='year',values=['median_base','median_positive_only','mean_base','mean_winsor1_99','share_le_0'])
w(piv.to_string())
w("\nRatio under variants (medians unless noted):")
rv=sens.dropna(subset=['ratio']).pivot_table(index=['year','contrast'],columns='variant',values='ratio')
w(rv.to_string())
w("\nMedian is invariant to 1/99 winsorisation (monotone tail clipping); the suspected top-coding (84 obs at $1,321,099 in 1990; 141 at $1,232,183 in 1996) moves means, not medians.")

w("\n## 7. Direction of the selection bias (explicit)")
w("- Observed-wealth rates diverge most in 1996 (white 47.4% vs black 68.3%, Hispanic 66.6%); of the 1985 wealth-observed base, 61.6% of whites vs 80.5% blacks / 80.3% Hispanics are still observed in 1996. If whites who drop out of the wealth module were the poorer ones, the surviving 1996 white sample would be upward-selected and the per-wave 1996 white/black ratio would be INFLATED.")
w("- The data do not support that direction: white 1996 medians are flat across retention groups (" +
  f"${sel[sel.cohort.str.startswith('WHITE')].med_1996_perwave.iloc[0]:,.0f} per-wave, " +
  f"${sel[sel.cohort.str.startswith('WHITE')].med_1996_stayers_all3waves.iloc[0]:,.0f} full-panel stayers, " +
  f"${sel[sel.cohort.str.startswith('WHITE')].med_1996_not_full_panel.iloc[0]:,.0f} observed-1996-only), " +
  "while black and Hispanic respondents answering the 1996 wealth module WITHOUT a complete triple are richer than full-panel stayers "
  f"(${sel[sel.cohort=='BLACK'].med_1996_not_full_panel.iloc[0]:,.0f} vs ${sel[sel.cohort=='BLACK'].med_1996_stayers_all3waves.iloc[0]:,.0f}; "
  f"${sel[sel.cohort=='HISPANIC'].med_1996_not_full_panel.iloc[0]:,.0f} vs ${sel[sel.cohort=='HISPANIC'].med_1996_stayers_all3waves.iloc[0]:,.0f}).")
w("- Conclusion: composition effects in 1996, if anything, UNDERSTATE rather than overstate the white-vs-minority ratio "
  "(panel 1996 ratios 4.69 white/black, 17.75 white/Hispanic vs per-wave 4.35 and 16.62). The per-wave widening is not an artefact of differential attrition, "
  "but per-wave years remain partly different respondents.")
w("\n## 8. Robustness of the ratio scale")
w("- The white/Hispanic ratio is NOT scale-robust: the Hispanic median sits one reporting-rounding step above zero ($729 in 1985, $1,921 in 1990, $2,562 in 1996; 34-42% of Hispanic families hold net wealth <= 0). "
  "Restricting to strictly positive wealth cuts the white/Hispanic ratio from 7.00 to 2.24 (1985) and from 16.62 to 5.17 (1996), while the dollar gap is stable "
  "($4,375 -> $4,520 in 1985; $40,038 -> $43,000 in 1996). For this contrast the delta-$ and the <=0 share difference are the load-bearing statistics.")
w("- The white/black ratio is less scale-sensitive (2.19 -> 1.59 positive-only in 1985; 4.35 -> 2.69 in 1996), same caveat applies.")
w("- Suspected top-coding (84 obs at $1,321,099 in 1990; 141 at $1,232,183 in 1996 — an interpretation, not a documented fact) moves means, not medians: "
  "two-sided 1/99 winsorisation changes the 1996 mean from $114,352 to $114,784 for whites and $45,080 to $40,630 for blacks, while medians are unchanged "
  "(a median is invariant to monotone tail clipping); 5%-trimmed medians are also unchanged ($42,600 / $9,800 / $2,500).")
w("\n## 9. Within-person check (balanced panel, constant 1996 USD, 1985->1996)")
w("- median within-person change: white +$29,984 (n=2932), black +$5,910 (n=1084), Hispanic +$1,100 (n=1723).")
w("- share moving from positive to <=0 wealth: white 6.7%, black 11.3%, Hispanic 13.8%; reverse direction (<=0 -> positive): white 13.8%, black 18.7%, Hispanic 22.9%.")
open(f'{O}/FINDINGS.md','w').write('\n'.join(L)+'\n')
print('FINDINGS.md written')
