import pandas as pd, numpy as np, re
df = pd.read_csv('data/nls_raw.csv')
print("SHAPE:", df.shape)
coh = [c for c in df.columns if 'Racial/ethnic cohort' in c]
w = [c for c in df.columns if 'Family net wealth' in c]
print("COHORT COL:", coh)
print("WEALTH COLS:", w)
print("dtypes:", {c: str(df[c].dtype) for c in coh+w})
for c in w:
    s = df[c]
    print("\n===", c)
    print(" n_missing:", s.isna().sum(), " pct_missing: %.2f%%" % (100*s.isna().mean()))
    if s.dtype == object:
        vals = pd.to_numeric(s, errors='coerce')
        print(" unparsable non-null strings:", (s.notna() & vals.isna()).sum())
        print(" examples raw:", s.dropna().unique()[:8])
    else:
        vals = pd.to_numeric(s, errors='coerce')
    v = vals.dropna()
    print(" min/median/max:", v.min(), v.median(), v.max())
    print(" n_zeros:", (v==0).sum(), " pct_of_nonmissing: %.2f%%" % (100*(v==0).mean()))
    print(" n_negative:", (v<0).sum(), " pct: %.2f%%" % (100*(v<0).mean()))
    top = v.value_counts().head(8)
    print(" most frequent values:\n", top.to_string())
    for sent in [99999, 999999, -9, -99, -1, 99998, 9999999]:
        n=(v==sent).sum()
        if n: print("  sentinel?", sent, n)
    print(" quantiles:", np.round(np.percentile(v,[1,5,25,50,75,95,99]),1))
print("\n=== COHORT")
print(df[coh[0]].value_counts(dropna=False).to_string())
print("unique:", df[coh[0]].unique())
print("\n=== respondents with >=1 non-missing wealth")
mask = df[w].apply(pd.to_numeric, errors='coerce').notna().any(axis=1)
print("n_any:", int(mask.sum()), "of", len(df))
sub = df[mask]
print(sub[coh[0]].value_counts(dropna=False).to_string())
print("\n=== pattern of missingness across 3 years (counts of non-missing combos)")
M = df[w].apply(pd.to_numeric, errors='coerce').notna()
M.columns=['85','90','96']
print(M.groupby(['85','90','96']).size().to_string())
print("\ncohort x year non-missing:")
for c in w:
    x = pd.to_numeric(df[c], errors='coerce')
    print(c, df.loc[x.notna(), coh[0]].value_counts(dropna=False).to_dict())
print("\ncohort of complete-case (all 3 years):")
print(df[M.all(axis=1)][coh[0]].value_counts(dropna=False).to_string())
