import pandas as pd, numpy as np
df = pd.read_csv('data/nls_raw.csv')
w = ['Family net wealth, 1985','Family net wealth, 1990','Family net wealth, 1996 (key data point)']
coh='Racial/ethnic cohort, 1979'
for c in w:
    s=df[c].dropna()
    mx=s.max()
    print(c, "max=",mx,"count_at_max=",(s==mx).sum(), "count >= 0.99*max:", (s>=0.99*mx).sum())
    # small magnitude suspicious values
    for v in [-9,-99,-999,-9999,-1,-88888,-77777,9,99]:
        n=(s==v).sum()
        if n: print("   ", v, n)
    print("   n_distinct:", s.nunique(), " n > 1e6:", (s>1e6).sum(), " n>=1.2e6:", (s>=1.2e6).sum())
# check whether other asset columns share the same cap values
print("\nasset cols at cap:")
for c in df.columns:
    if 'Market value' in c or 'Total market value' in c:
        s=df[c].dropna()
        if len(s): print("  ", c, "max", s.max(), "n_at_max", (s==s.max()).sum())
# component-sum consistency check for 1985
comp1985=['Market value of residential property respondent/spouse own, 1985','Total market value of farm, business, and other property, 1985','Market Value of vehicles respondent/spouse own, 1985','Total market value of items over $500, 1985']
sub=df[comp1985+['Family net wealth, 1985']].dropna()
print("\n1985 rows with all comps:", len(sub))
print("corr sum(components) vs net wealth:", sub[comp1985].sum(axis=1).corr(sub['Family net wealth, 1985']))
print("share where |sum comps - net| < 1:", ((sub[comp1985].sum(axis=1)-sub['Family net wealth, 1985']).abs()<1).mean())
# duplicates / id sanity
print("\nID dup:", df['ID# (range 1-12686) 1979'].duplicated().sum())
# cohort label mapping counts + missing
print("cohort missing:", df[coh].isna().sum())
# attrition rates by cohort per year
for c in w:
    x=pd.to_numeric(df[c],errors='coerce').notna()
    g=df.assign(obs=x).groupby(coh)['obs'].agg(['sum','size'])
    g['rate']=(g['sum']/g['size']*100).round(1)
    print("\n",c); print(g.to_string())
