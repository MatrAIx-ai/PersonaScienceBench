"""Stage 1 - DATA INSPECTION ONLY. No nested model fitting (that is Stage 2).
Run: python3 analysis/01_inspect.py
"""
import pandas as pd, numpy as np

pd.set_option("display.width", 220); pd.set_option("display.max_columns", 60)
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
Y = "BA DEGREE COMPLETED"
NUM = ["FAMILY SIZE OF SAMPLE", "ABILITY: COMPOSITE OF ASVAB SCORE",
       "PERCENTILE IN CLASS", "SES"]
MODEL_VARS = [Y, "SAMPLE_RACE", "SAMPLE_SEX"] + NUM

print("=" * 72, "\n1. SHAPE:", df.shape, " (rows x cols, excl. unnamed index)")
print("Columns exactly as in file:", list(df.columns))

print("\n2. TYPES / MISSING / CARDINALITY")
print(pd.DataFrame({"dtype": df.dtypes.astype(str), "n_missing": df.isna().sum(),
                    "pct_missing": (df.isna().mean() * 100).round(3),
                    "n_unique": df.nunique(dropna=True)}).to_string())

print("\n3. TARGET", Y, "- dtype:", df[Y].dtype)
vc = df[Y].value_counts(dropna=False)
print(pd.DataFrame({"n": vc, "pct": (vc / len(df) * 100).round(3)}).to_string())
print("share(=1):", round(df[Y].mean(), 5))

print("\n4. CATEGORICALS")
for c in ["SAMPLE_RACE", "SAMPLE_SEX"]:
    vc = df[c].value_counts(dropna=False)
    print(f"  {c}: " + " | ".join(f"{k}={v} ({v/len(df)*100:.2f}%)" for k, v in vc.items()))
print(pd.crosstab(df.SAMPLE_RACE, df.SAMPLE_SEX).to_string())
print("  BA rate by race:", df.groupby("SAMPLE_RACE")[Y].mean().round(4).to_dict())
print("  BA rate by sex :", df.groupby("SAMPLE_SEX")[Y].mean().round(4).to_dict())

print("\n5. NUMERIC SUMMARY + OUTLIERS")
d = df[NUM].apply(pd.to_numeric, errors="coerce")
iqr = d.quantile(.75) - d.quantile(.25)
summ = pd.DataFrame({"count": d.count(), "mean": d.mean(), "sd": d.std(), "min": d.min(),
                     "q25": d.quantile(.25), "median": d.median(), "q75": d.quantile(.75),
                     "max": d.max(), "skew": d.skew(),
                     "n_out_iqr1.5": ((d < d.quantile(.25) - 1.5*iqr) | (d > d.quantile(.75) + 1.5*iqr)).sum(),
                     "n_out_iqr3.0": ((d < d.quantile(.25) - 3.0*iqr) | (d > d.quantile(.75) + 3.0*iqr)).sum()})
print(summ.round(4).to_string())

print("\n6. CODED-MISSING SENTINEL SCAN (999 / 9999 / -1 / -9 / ...)")
hits = []
for c in df.columns:
    s = df[c]
    if pd.api.types.is_numeric_dtype(s):
        for code in [999, 9999, 99999, -1, -9, -99, 88888, 77777]:
            n = int((s == code).sum())
            if n:
                hits.append((c, code, n))
print("  hits:", hits if hits else "NONE in analytic variables "
      "(the two 999/9999 matches occur only in CASE ID, i.e. legitimate IDs)")
print("  SES values <= -1 : n=%d  (SES is a z-standardised composite, mean=%.4f sd=%.4f -> real, not a code)"
      % ((df['SES'] <= -1).sum(), df['SES'].mean(), df['SES'].std()))
print("  ABILITY values >= 999 : n=%d of %d (ASVAB composite scale ~1000-3100 -> real, not a code)"
      % ((df['ABILITY: COMPOSITE OF ASVAB SCORE'] >= 999).sum(), len(df)))

print("\n7. USABLE OBSERVATIONS")
print("  rows total:", len(df), "| complete on all model vars:", df[MODEL_VARS].dropna().shape[0],
      "| duplicate CASE ID:", int(df['CASE ID'].duplicated().sum()))
print("  -> n = 8773 usable, no listwise deletion needed")

print("\n8. COLLINEARITY CONTEXT (pearson r among predictors)")
print(d.corr().round(3).to_string())

print("\n9. SCALE PLAUSIBILITY PROBE (why 0.3636 cannot be a raw OLS prob coef)")
import statsmodels.api as sm
y = df[Y].astype(float)
print("  base rate P(BA=1) =", round(y.mean(), 4),
      "-> max |slope| for a 0/1 predictor in a linear probability model is <= ~", round(y.mean(), 4))
z = lambda s: (s - s.mean()) / s.std()
probe = {"SEX(F=1)": (df.SAMPLE_SEX == "Female").astype(float),
         "BLACK(1)": (df.SAMPLE_RACE == "Black").astype(float),
         "FAMSIZE": df["FAMILY SIZE OF SAMPLE"],
         "ABILITY_raw": df["ABILITY: COMPOSITE OF ASVAB SCORE"], "ABILITY_z": z(df["ABILITY: COMPOSITE OF ASVAB SCORE"]),
         "PCTILE_raw": df["PERCENTILE IN CLASS"], "PCTILE_z": z(df["PERCENTILE IN CLASS"]),
         "SES_raw": df["SES"], "SES_z": z(df["SES"])}
rows = []
for k, x in probe.items():
    X = sm.add_constant(x.values)
    rows.append({"var": k, "univ_LPM_slope": round(sm.OLS(y.values, X).fit().params[1], 4),
                 "univ_logit_b": round(sm.Logit(y.values, X).fit(disp=0).params[1], 4)})
print(pd.DataFrame(rows).to_string(index=False))
print("  -> raw-probability OLS is ruled out; logit / standardised-beta scales are plausible.")
