"""Stage 2 - FULL NESTED SPECIFICATION GRID (approved plan).
Design frozen BEFORE estimation:
  race block      = {BLACK, HISP}      (White = reference)
  academic block  = {ABILITY, PERCENTILE IN CLASS}   (curriculum absent from file -> not used)
  demo            = {SEX_F}
  M1  = X ; M1b = X + SEX ; M2 = X + race ; M3 = X + academic ; M4 = X + race + academic
Scales: 'z' (continuous z-scored) PRIMARY ; 'raw' parallel column.
Estimators: logit MLE (primary), Firth penalised logit (rare-event robustness),
            OLS/LPM (falsification of the raw-probability scale).
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option("display.width", 250); pd.set_option("display.max_columns", 80)

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
y = df["BA DEGREE COMPLETED"].astype(float).values

def z(s): return (s - s.mean()) / s.std(ddof=1)

RAW = pd.DataFrame({
    "SES": df["SES"], "SEX_F": (df.SAMPLE_SEX == "Female").astype(float),
    "FAMSIZE": df["FAMILY SIZE OF SAMPLE"],
    "ABILITY": df["ABILITY: COMPOSITE OF ASVAB SCORE"],
    "PCTILE": df["PERCENTILE IN CLASS"],
    "BLACK": (df.SAMPLE_RACE == "Black").astype(float),
    "HISP": (df.SAMPLE_RACE == "Hispanic").astype(float)})
D = {"raw": RAW.copy(), "z": RAW.copy()}
for c in ["SES", "FAMSIZE", "ABILITY", "PCTILE"]:
    D["z"][c] = z(RAW[c])

RACE = ["BLACK", "HISP"]; ACAD = ["ABILITY", "PCTILE"]; DEMO = ["SEX_F"]
CANDS = ["SES", "SEX_F", "FAMSIZE", "ABILITY", "PCTILE", "BLACK", "HISP"]
BIN = {"SEX_F", "BLACK", "HISP"}

def spec(x, m):
    """Return RHS variable list for candidate x under model m (x always first).
    NOTE: lists are copied - in-place += on an aliased module-level block list
    silently corrupted earlier versions of this grid (bug fixed)."""
    if m == "M1":
        rhs = []
    elif m == "M1b":
        rhs = [] if x == "SEX_F" else list(DEMO)
    elif m == "M2":
        rhs = list(DEMO) if x in RACE else list(RACE)
    elif m == "M3":
        rhs = [] if x in ACAD else list(ACAD)
    elif m == "M4":
        rhs = ([v for v in RACE if v != x] if x in RACE else list(RACE))
        rhs = rhs + ([v for v in ACAD if v != x] if x not in ACAD else [])
        if x != "SEX_F":
            rhs = rhs + list(DEMO)
    return [x] + [v for v in rhs if v != x]


for _c in CANDS:
    for _m in ["M1", "M1b", "M2", "M3", "M4"]:
        assert _c in spec(_c, _m) and len(set(spec(_c, _m))) == len(spec(_c, _m)), (_c, _m, spec(_c, _m))
assert RACE == ["BLACK", "HISP"] and ACAD == ["ABILITY", "PCTILE"] and DEMO == ["SEX_F"]

def fit_logit(y, X):
    res = sm.Logit(y, X).fit(disp=0, maxiter=200, method="newton")
    return res

def firth_logit(y, X, maxiter=100, tol=1e-9):
    X_ = np.asarray(X, float); n, k = X_.shape; b = np.zeros(k)
    for _ in range(maxiter):
        eta = X_ @ b; p = 1/(1+np.exp(-eta)); W = np.maximum(p*(1-p), 1e-12)
        I = X_.T @ (X_ * W[:, None])
        Iinv = np.linalg.pinv(I)
        h = np.einsum("ij,jk,ik->i", X_, Iinv, X_) * W
        U = X_.T @ (y - p - 0.5*h)
        step = Iinv @ U
        if np.max(np.abs(step)) < tol: break
        b = b + np.clip(step, -5, 5)
    return pd.Series(b), np.sqrt(np.diag(Iinv)), int(_+1)

rows = []
for scale in ["z", "raw"]:
    data = D[scale]
    for x in CANDS:
        for m in ["M1", "M1b", "M2", "M3", "M4"]:
            rhs = spec(x, m)
            X = sm.add_constant(data[rhs].values)
            try: lg = fit_logit(y, X)
            except Exception as e: continue
            b, se = lg.params[1], lg.bse[1]
            fb, fse, nit = firth_logit(y, X)
            ols = sm.OLS(y, X).fit()
            rows.append(dict(scale=scale, cand=x, model=m, k=len(rhs),
                unit="binary" if x in BIN else scale,
                beta=round(b,4), se=round(se,4), zstat=round(b/se,3),
                p=stats.norm.sf(abs(b/se))*4 if False else round(stats.norm.sf(abs(b/se))*2,5),
                ci_lo=round(b-1.96*se,4), ci_hi=round(b+1.96*se,4),
                OR=round(np.exp(b),4), sig05=bool(abs(b/se) > 1.96),
                firth_beta=round(float(fb[1]),4), firth_se=round(float(fse[1]),4),
                firth_p=round(float(2*stats.norm.sf(abs(fb[1]/fse[1]))),5),
                lpm_beta=round(ols.params[1],5), lpm_p=round(ols.pvalues[1],5),
                converged=bool(lg.mle_retvals["converged"]),
                llf=round(lg.llf,3)))
R = pd.DataFrame(rows)
R.to_csv("analysis/grid_results.csv", index=False)

print("n =", len(y), " events =", int(y.sum()), " base rate =", round(y.mean(),5))
print("\n" + "="*140)
print("PRIMARY SCALE: z-scored continuous predictors, logit MLE  (beta = log-odds per 1 SD)")
for scale in ["z", "raw"]:
    print("\n" + "#"*130); print("SCALE =", scale)
    sub = R[R.scale == scale]
    for x in CANDS:
        t = sub[sub.cand == x].set_index("model")[
            ["beta","se","p","ci_lo","ci_hi","OR","sig05","firth_beta","firth_p","lpm_beta"]]
        print(f"\n--- candidate {x} ---"); print(t.to_string())

print("\n" + "="*140 + "\nTARGET SEARCH: |beta-0.3636| and |beta+0.2293| within a candidate's ladder")
T1, T2 = 0.3636, -0.2293
best = []
for (sc, c), g in R.groupby(["scale","cand"]):
    d1 = (g.beta - T1).abs(); d2 = (g.beta - T2).abs()
    best.append({"scale":sc,"cand":c,
        "model_at_0.3636":g.loc[d1.idxmin(),"model"], "dist_pos":round(d1.min(),4),
        "model_at_-0.2293":g.loc[d2.idxmin(),"model"], "dist_neg":round(d2.min(),4),
        "sum_dist":round(d1.min()+d2.min(),4),
        "sign_flip_across_ladder":bool(g.beta.min() < 0 < g.beta.max())})
B = pd.DataFrame(best).sort_values("sum_dist")
print(B.to_string(index=False))
