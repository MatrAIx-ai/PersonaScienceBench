"""Stage 3 - SES deep dive: block decomposition, collinearity/VIF, suppression, Firth."""
import numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor
from scipy import stats
pd.set_option("display.width",250); pd.set_option("display.max_columns",80)

df=pd.read_csv("data/nls_ses_processed.csv",index_col=0)
y=df["BA DEGREE COMPLETED"].astype(float).values
z=lambda s:(s-s.mean())/s.std(ddof=1)
V=pd.DataFrame({"SES":z(df.SES),"ABILITY":z(df["ABILITY: COMPOSITE OF ASVAB SCORE"]),
  "PCTILE":z(df["PERCENTILE IN CLASS"]),"SEX_F":(df.SAMPLE_SEX=="Female").astype(float),
  "BLACK":(df.SAMPLE_RACE=="Black").astype(float),"HISP":(df.SAMPLE_RACE=="Hispanic").astype(float),
  "FAMSIZE":z(df["FAMILY SIZE OF SAMPLE"])})
Vraw=V.copy()
Vraw["SES"]=df.SES; Vraw["ABILITY"]=df["ABILITY: COMPOSITE OF ASVAB SCORE"]
Vraw["PCTILE"]=df["PERCENTILE IN CLASS"]; Vraw["FAMSIZE"]=df["FAMILY SIZE OF SAMPLE"]

def L(cols,data=V):
    X=sm.add_constant(data[list(cols)].values); r=sm.Logit(y,X).fit(disp=0,maxiter=200)
    i=list(cols).index("SES")+1
    return dict(beta=round(r.params[i],4),se=round(r.bse[i],4),p=round(r.pvalues[i],5),
        ci_lo=round(r.params[i]-1.96*r.bse[i],4),ci_hi=round(r.params[i]+1.96*r.bse[i],4),
        OR=round(np.exp(r.params[i]),3),zst=round(r.params[i]/r.bse[i],2),
        sig_05=bool(r.pvalues[i]<0.05),sig_01=bool(r.pvalues[i]<0.01))

print("A. BLOCK DECOMPOSITION - coefficient on SES as covariate blocks are added (z-scale, logit)")
path=[("M1  SES",["SES"]),("M1b +SEX",["SES","SEX_F"]),
      ("M2  +race",["SES","BLACK","HISP"]),("M2b +SEX+race",["SES","SEX_F","BLACK","HISP"]),
      ("M3  +academic",["SES","ABILITY","PCTILE"]),
      ("M3b +SEX+academic",["SES","SEX_F","ABILITY","PCTILE"]),
      ("M4  +race+academic",["SES","BLACK","HISP","ABILITY","PCTILE"]),
      ("M4b +SEX+race+academic",["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE"]),
      ("M5  M4b+FAMSIZE",["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE","FAMSIZE"])]
print(pd.DataFrame([{"spec":k,**L(c)} for k,c in path]).to_string(index=False))

print("\nB. WHICH COVARIATE KILLS IT - add academic covariates one at a time (z-scale)")
step=[("SES only",["SES"]),("+SEX",["SES","SEX_F"]),("+BLACK only",["SES","BLACK"]),
      ("+HISP only",["SES","HISP"]),("+race both",["SES","BLACK","HISP"]),
      ("+ABILITY only",["SES","ABILITY"]),("+PCTILE only",["SES","PCTILE"]),
      ("+ABILITY+PCTILE",["SES","ABILITY","PCTILE"]),
      ("+race+ABILITY",["SES","BLACK","HISP","ABILITY"]),
      ("+race+PCTILE",["SES","BLACK","HISP","PCTILE"]),
      ("+race+ABILITY+PCTILE (M4)",["SES","BLACK","HISP","ABILITY","PCTILE"]),
      ("+SEX+race+ABILITY+PCTILE (M4b)",["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE"])]
print(pd.DataFrame([{"spec":k,**L(c)} for k,c in step]).to_string(index=False))

print("\nC. COEFFICIENTS OF THE FULL MODEL M4b (all covariates, z-scale)")
cols=["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE"]
X=sm.add_constant(V[cols].values); r=sm.Logit(y,X).fit(disp=0)
print(pd.DataFrame({"var":["_const"]+cols,"beta":np.round(r.params,4),"se":np.round(r.bse,4),
  "z":np.round(r.params/r.bse,2),"p":np.round(r.pvalues,6),"OR":np.round(np.exp(r.params),3),
  "ci_lo":np.round(r.conf_int()[:,0],4),"ci_hi":np.round(r.conf_int()[:,1],4)}).to_string(index=False))
print("  pseudo-R2:",round(r.prsquared,4)," LLF:",round(r.llf,2)," n:",len(y)," events:",int(y.sum()))

print("\nD. VIF in the full model (SES focus)")
Xd=V[cols].values
vif=[variance_inflation_factor(Xd,i) for i in range(len(cols))]
print(pd.DataFrame({"var":cols,"VIF":np.round(vif,3)}).to_string(index=False))
print("  condition number (no const, z-vars):",round(np.linalg.cond(V[cols].values),2))
print("  SES correlations:",V.corr()["SES"].round(3).to_dict())

print("\nE. RAW-SCALE MIRROR (same ladder, unscaled continuous predictors)")
rpath=[("M1",["SES"]),("M3 +academic",["SES","ABILITY","PCTILE"]),
       ("M4 +race+academic",["SES","BLACK","HISP","ABILITY","PCTILE"]),
       ("M4b +SEX",["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE"])]
print(pd.DataFrame([{"spec":k,**L(c,Vraw)} for k,c in rpath]).to_string(index=False))

print("\nF. FIRTH PENALISED LOGIT (rare-event robustness) on key specs")
def firth(cols,data=V):
    X_=np.asarray(sm.add_constant(data[list(cols)].values),float); n,k=X_.shape; b=np.zeros(k)
    for _ in range(200):
        p=1/(1+np.exp(-X_@b)); W=np.maximum(p*(1-p),1e-12)
        Iinv=np.linalg.pinv(X_.T@(X_*W[:,None])); h=np.einsum("ij,jk,ik->i",X_,Iinv,X_)*W
        st=Iinv@(X_.T@(y-p-0.5*h))
        if np.max(np.abs(st))<1e-10: break
        b+=np.clip(st,-5,5)
    se=np.sqrt(np.diag(Iinv)); i=list(cols).index("SES")+1
    return dict(beta=round(b[i],4),se=round(se[i],4),p=round(2*stats.norm.sf(abs(b[i]/se[i])),5),
                sig_05=bool(b[i]/se[i]>1.96 or b[i]/se[i]<-1.96))
FS=[("M1",["SES"]),("M2 +race",["SES","BLACK","HISP"]),("M3 +academic",["SES","ABILITY","PCTILE"]),
    ("M4 +race+academic",["SES","BLACK","HISP","ABILITY","PCTILE"]),
    ("M4b +SEX",["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE"])]
print(pd.DataFrame([dict(spec=k, **firth(c)) for k, c in FS]).to_string(index=False))

print("\nG. SUBSAMPLE / SE-INFLATION PROBES: where does SES beta ~ -0.23 become insignificant?")
probes=[]
for nm,mask in [("all n=8773",np.ones(len(y),bool)),
                ("White only",(df.SAMPLE_RACE=="White").values),
                ("exclude FAMSIZE>8",((df["FAMILY SIZE OF SAMPLE"]<=8)).values)]:
    yy=y[mask]; Xs=sm.add_constant(V.loc[mask,["SES","BLACK","HISP","ABILITY","PCTILE"]][
        [c for c in ["SES","BLACK","HISP","ABILITY","PCTILE"] if c in ("SES","ABILITY","PCTILE") or (c=="BLACK" and nm!="White only") or (c=="HISP" and nm!="White only")]].values)
    rr=sm.Logit(yy,Xs).fit(disp=0)
    probes.append({"spec":nm,"n":int(mask.sum()),"events":int(yy.sum()),
                   "beta_SES":round(rr.params[1],4),"se":round(rr.bse[1],4),
                   "p":round(rr.pvalues[1],5),"se_needed_for_notsig":round(abs(rr.params[1])/1.96,4)})
print(pd.DataFrame(probes).to_string(index=False))
