"""Stage 4 - exhaustive covariate-subset search for the SES coefficient, both scales.
Purpose: check honestly whether BOTH anchors (+0.3636, -0.2293) can be reproduced
by the SAME nested ladder, without cherry-picking.
"""
import numpy as np, pandas as pd, itertools, statsmodels.api as sm
from scipy import stats
pd.set_option("display.width",250)
df=pd.read_csv("data/nls_ses_processed.csv",index_col=0)
y=df["BA DEGREE COMPLETED"].astype(float).values
z=lambda s:(s-s.mean())/s.std(ddof=1)
base=pd.DataFrame({"SEX_F":(df.SAMPLE_SEX=="Female").astype(float),
 "BLACK":(df.SAMPLE_RACE=="Black").astype(float),"HISP":(df.SAMPLE_RACE=="Hispanic").astype(float),
 "FAMSIZE":df["FAMILY SIZE OF SAMPLE"],"ABILITY":df["ABILITY: COMPOSITE OF ASVAB SCORE"],
 "PCTILE":df["PERCENTILE IN CLASS"],"SES":df["SES"]})
Z=base.copy()
for c in ["FAMSIZE","ABILITY","PCTILE","SES"]: Z[c]=z(base[c])
COV=["SEX_F","BLACK","HISP","FAMSIZE","ABILITY","PCTILE"]
rows=[]
for sc,data in [("z",Z),("raw",base)]:
    for r in range(0,len(COV)+1):
        for comb in itertools.combinations(COV,r):
            X=sm.add_constant(data[["SES"]+list(comb)].values)
            try: m=sm.Logit(y,X).fit(disp=0,maxiter=300)
            except Exception: continue
            b,se=m.params[1],m.bse[1]
            rows.append({"scale":sc,"covariates":"+".join(comb) if comb else "(none)",
                "k":len(comb),"beta":round(b,4),"se":round(se,4),
                "p":round(2*stats.norm.sf(abs(b/se)),5),
                "sig_05":bool(2*stats.norm.sf(abs(b/se))<0.05),
                "sig_01":bool(2*stats.norm.sf(abs(b/se))<0.01)})
S=pd.DataFrame(rows)
S.to_csv("analysis/ses_subset_grid.csv",index=False)
print("fits =",len(S))
for tgt in [0.3636,-0.2293]:
    S["dist"]=(S.beta-tgt).abs()
    print(f"\n### specs whose SES beta is closest to {tgt} (top 8 of {len(S)}):")
    print(S.nsmallest(8,"dist")[["scale","covariates","beta","se","p","sig_05","sig_01","dist"]].to_string(index=False))

print("\n### Nested-ladder check (fixed blocks, no cherry-picking)")
lad={}
for sc,data in [("z",Z),("raw",base)]:
    for nm,cols in [("M1 (SES only)",[]),("M1b +SEX",["SEX_F"]),("M2 +race",["BLACK","HISP"]),
                    ("M3 +academic",["ABILITY","PCTILE"]),
                    ("M4 +race+academic",["BLACK","HISP","ABILITY","PCTILE"]),
                    ("M4b +SEX+race+academic",["SEX_F","BLACK","HISP","ABILITY","PCTILE"]),
                    ("M5 +everything",COV)]:
        X=sm.add_constant(data[["SES"]+cols].values); m=sm.Logit(y,X).fit(disp=0)
        b,se=m.params[1],m.bse[1]; p=2*stats.norm.sf(abs(b/se))
        lad[(sc,nm)]={"beta":round(b,4),"se":round(se,4),"p":round(p,5),
                      "d_0.3636":round(abs(b-0.3636),4),"d_-0.2293":round(abs(b+0.2293),4)}
L=pd.DataFrame.from_dict(lad, orient="index")
L.index.names=["scale","spec"]
print(L.to_string())

print("\n### Significance thresholds: is the drop 'to insignificant' or 'to marginal'?")
for sc in ["raw","z"]:
    a=L.loc[(sc,"M1 (SES only)")]; b=L.loc[(sc,"M4 +race+academic")]
    print(f"  {sc}: M1 b={a['beta']} p={a['p']}  ->  M4 b={b['beta']} p={b['p']}"
          f"   |  sig@5%:{b['p']<0.05} sig@10%:{b['p']<0.10} | 100*(1-p):{100*(1-b['p']):.1f}% CI")

print("\n### Standardised-beta translation of the same two models (for the 'standardized beta' reading)")
sd_y=y.std(ddof=1)
for sc in ["z","raw"]:
    for nm,cols in [("M1 (SES only)",[]),("M4 +race+academic",["BLACK","HISP","ABILITY","PCTILE"])]:
        cols2=cols if sc=="z" else cols
        data=Z if sc=="z" else base
        X=sm.add_constant(data[["SES"]+cols2].values)
        o=sm.OLS(y,X).fit(); l=sm.Logit(y,X).fit(disp=0)
        sd_x=data["SES"].std(ddof=1)
        print(f"  {sc} {nm}: logit_b={l.params[1]:.4f} | OLS_prob_b={o.params[1]:.5f} "
              f"| OLS std_beta={o.params[1]*sd_x/sd_y:.4f} | logit_b_per_2SD={l.params[1] if sc=='z' else l.params[1]*sd_x:.4f}")

print("\n### PAIR SEARCH with a free scale multiplier (tests the 'standardized beta' reading)")
print("   For every ordered pair (A,B) of fitted specs and multiplier m = 0.3636/b_A,")
print("   how close is m*b_B to -0.2293? A single m must serve BOTH anchors.")
recs=[]
for sc,dat in [("raw",base),("z",Z)]:
    for r in range(len(COV)+1):
        for comb in itertools.combinations(COV,r):
            X=sm.add_constant(dat[["SES"]+list(comb)].values)
            mm=sm.Logit(y,X).fit(disp=0,maxiter=300)
            recs.append({"scale":sc,"cov":"+".join(comb) or "(none)","b":mm.params[1],"se":mm.bse[1]})
Rec=pd.DataFrame(recs)
T1,T2=0.3636,-0.2293
out=[]
for sc in ["raw","z"]:
    sub=Rec[Rec.scale==sc].to_dict("records")
    for a in sub:
        if a["b"]<=1e-6: continue
        mfac=T1/a["b"]
        for c in sub:
            setA=set(a["cov"].split("+")) if a["cov"]!="(none)" else set()
            setC=set(c["cov"].split("+")) if c["cov"]!="(none)" else set()
            out.append({"scale":sc,"specA":a["cov"],"betaA":round(a["b"],4),
                        "specB":c["cov"],"betaB":round(c["b"],4),
                        "multiplier":round(mfac,4),"m_times_betaB":round(c["b"]*mfac,4),
                        "joint_err":round(abs(a["b"]*mfac-T1)+abs(c["b"]*mfac-T2),4),
                        "B_adds_academic":bool({"ABILITY","PCTILE"} <= setC and not {"ABILITY","PCTILE"} <= setA),
                        "B_nests_A":bool(setA <= setC)})
P=pd.DataFrame(out)
print("  total ordered pairs tested:",len(P))
print("\n  best pairs where B adds the academic block and B nests A (i.e. genuine M1->M4 style drop):")
Q=P[(P.B_nests_A)&(P.B_adds_academic)]
print(Q.nsmallest(8,"joint_err").to_string(index=False))
print("\n  best pairs ignoring any structural constraint:")
print(P.nsmallest(6,"joint_err").to_string(index=False))
print("\n  interpretation check: multiplier=1.0 means the RAW log-odds scale already fits both anchors")
print(P[(P.multiplier.between(0.99,1.01))].nsmallest(6,"joint_err").to_string(index=False))
