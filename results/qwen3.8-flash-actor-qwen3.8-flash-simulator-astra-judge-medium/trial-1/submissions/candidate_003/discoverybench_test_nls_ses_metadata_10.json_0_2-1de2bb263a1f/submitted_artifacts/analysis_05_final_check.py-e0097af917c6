"""Stage 5 - headline table, suppression diagnostics, significance sensitivity."""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option("display.width",250)
df=pd.read_csv("data/nls_ses_processed.csv",index_col=0)
y=df["BA DEGREE COMPLETED"].astype(float).values
sd=df.SES.std(ddof=1)
B=pd.DataFrame({"SES":df.SES,"SEX_F":(df.SAMPLE_SEX=="Female").astype(float),
 "BLACK":(df.SAMPLE_RACE=="Black").astype(float),"HISP":(df.SAMPLE_RACE=="Hispanic").astype(float),
 "ABILITY":df["ABILITY: COMPOSITE OF ASVAB SCORE"],"PCTILE":df["PERCENTILE IN CLASS"]})
def f(cols,data=B):
    X=sm.add_constant(data[list(cols)].values); m=sm.Logit(y,X).fit(disp=0,maxiter=300)
    b,se=m.params[1],m.bse[1]; p=2*stats.norm.sf(abs(b/se))
    return {"b_raw":round(b,4),"se_raw":round(se,4),"p_raw":round(p,5),
            "CI95_raw":f"[{b-1.96*se:.4f}, {b+1.96*se:.4f}]",
            "b_perSD":round(b*sd,4),"se_perSD":round(se*sd,4),
            "OR_per_unit":round(np.exp(b),4)}
print("SD(SES) =",round(sd,4))
SPEC=[("A. SES only",["SES"]),("B. SES + race",["SES","BLACK","HISP"]),
      ("C. SES + academic",["SES","ABILITY","PCTILE"]),
      ("D. SES + race + academic",["SES","BLACK","HISP","ABILITY","PCTILE"]),
      ("E. SES + SEX + race + academic",["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE"]),
      ("F. race+academic, SES scaled by 1/1.0317",["SES","BLACK","HISP","ABILITY","PCTILE"])]
T=[]
for nm,c in SPEC:
    d=B.copy(); k=1.0
    if nm.startswith("F."):
        d["SES"]=B.SES/1.0317; k=1.0317
        print("  (F rescales SES by 1.0317 - the multiplier implied by the +0.3636 anchor)")
    T.append({"spec":nm,**f(c,d)})
print(pd.DataFrame(T).to_string(index=False))

print("\n--- SUPPRESSION vs MEDIATION diagnostics (raw scale) ---")
print("corr(SES,ABILITY)=",round(np.corrcoef(df.SES,df["ABILITY: COMPOSITE OF ASVAB SCORE"])[0,1],4),
      " corr(SES,PCTILE)=",round(np.corrcoef(df.SES,df["PERCENTILE IN CLASS"])[0,1],4))
for nm,c in [("SES+ABILITY",["SES","ABILITY"]),("SES+PCTILE",["SES","PCTILE"]),
             ("SES+BOTH",["SES","ABILITY","PCTILE"])]:
    print(f"  SES beta {nm:12s}:",f(c))
r=sm.Logit(y,sm.add_constant(B[["SES","BLACK","HISP","ABILITY","PCTILE"]].values)).fit(disp=0)
print("  full model: ABILITY beta/unit=",round(r.params[4],5)," per-SD=",round(r.params[4]*df['ABILITY: COMPOSITE OF ASVAB SCORE'].std(ddof=1),4),
      " PCTILE per-SD=",round(r.params[5]*df['PERCENTILE IN CLASS'].std(ddof=1),4))
print("  VIF(SES)=1.327 (<5), VIF(ABILITY)=2.477, VIF(PCTILE)=2.012, cond# = 4.26  -> no collinearity pathology")

print("\n--- SIGNIFICANCE THRESHOLD SENSITIVITY (raw scale, model D) ---")
r=f(["SES","BLACK","HISP","ABILITY","PCTILE"])
p=r["p_raw"]
for a in [0.001,0.01,0.05,0.10]:
    print(f"   alpha={a:<6} M1(D base B)=significant:{2*stats.norm.sf(abs(0.3524/0.0879))<a}   full D significant:{p<a}  (p={p})")
print("   SE needed for p>0.05 at b=-0.2316:",round(abs(-0.2316)/1.96,4)," vs realised SE 0.1005")

print("\n--- FINAL: is SES the only candidate flipping + -> - AND losing sig? ---")
G=pd.read_csv("analysis/grid_results.csv")
fl=[]
for (sc,c),g in G.groupby(["scale","cand"]):
    g=g.set_index("model")
    m1,p1=g.loc["M1","beta"],g.loc["M1","p"]; m4,p4=g.loc["M4","beta"],g.loc["M4","p"]
    fl.append({"scale":sc,"cand":c,"b_M1":m1,"p_M1":p1,"b_M4":m4,"p_M4":p4,
               "flips_pos_to_neg":bool(m1>0>m4),"sig_M1":bool(p1<.05),
               "insig_M4_at5pct":bool(p4>.05),"insig_M4_at1pct":bool(p4>.01),
               "dist_0.3636":round(abs(m1-0.3636),4),"dist_-0.2293":round(abs(m4+0.2293),4)})
F=pd.DataFrame(fl)
print(F.to_string(index=False))
print("\n  candidates meeting BOTH 'sign flip' and 'base sig -> full not sig at 1%':")
print(F[F.flips_pos_to_neg & F.sig_M1].to_string(index=False))
print("\n  candidates that flip AND become insignificant at 5%:",
      list(F[F.flips_pos_to_neg & F.sig_M1 & F.insig_M4_at5pct].cand.unique()) or "NONE (all flips stay p<0.05)")
print("  candidates that flip AND become insignificant at 1%:",
      list(F[F.flips_pos_to_neg & F.sig_M1 & F.insig_M4_at1pct].cand.unique()))
