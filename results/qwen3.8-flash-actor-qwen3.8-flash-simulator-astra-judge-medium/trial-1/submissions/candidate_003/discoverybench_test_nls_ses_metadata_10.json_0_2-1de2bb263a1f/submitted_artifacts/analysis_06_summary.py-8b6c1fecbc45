"""Stage 6 - consolidated results table + final hypothesis (reads nothing new; re-fits
the frozen ladder for a self-contained, reproducible headline table)."""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
df=pd.read_csv("data/nls_ses_processed.csv",index_col=0)
y=df["BA DEGREE COMPLETED"].astype(float).values; sd=df.SES.std(ddof=1)
B=pd.DataFrame({"SES":df.SES,"SEX_F":(df.SAMPLE_SEX=="Female").astype(float),
 "BLACK":(df.SAMPLE_RACE=="Black").astype(float),"HISP":(df.SAMPLE_RACE=="Hispanic").astype(float),
 "ABILITY":df["ABILITY: COMPOSITE OF ASVAB SCORE"],"PCTILE":df["PERCENTILE IN CLASS"]})
L=[("M1","SES only",["SES"]),("M2","+race",["SES","BLACK","HISP"]),
   ("M3","+academic only",["SES","ABILITY","PCTILE"]),
   ("M4","+race AND academic",["SES","BLACK","HISP","ABILITY","PCTILE"]),
   ("M4b","+SEX+race+academic",["SES","SEX_F","BLACK","HISP","ABILITY","PCTILE"])]
r=[]
for k,nm,c in L:
    m=sm.Logit(y,sm.add_constant(B[c].values)).fit(disp=0,maxiter=300)
    b,se,p=m.params[1],m.bse[1],m.pvalues[1]
    r.append({"model":k,"added_block":nm,"beta_raw(SES unit)":round(b,4),"SE":round(se,4),
      "p":round(p,5),"95% CI":f"[{b-1.96*se:.3f}, {b+1.96*se:.3f}]",
      "beta_per_SD":round(b*sd,4),"OR":round(np.exp(b),3),
      "sig@1%":bool(p<.01),"sig@5%":bool(p<.05)})
T=pd.DataFrame(r); T.to_csv("analysis/headline_table.csv",index=False)
print(T.to_string(index=False))
print("\nDelta beta_raw M1->M2 (race block)      =",round(T.beta_raw_.iloc[1]-T.iloc[0,2],4) if False else round(T.iloc[1,2]-T.iloc[0,2],4))
print("Delta beta_raw M1->M3 (academic block)   =",round(T.iloc[2,2]-T.iloc[0,2],4))
print("Delta beta_raw M1->M4 (both blocks)      =",round(T.iloc[3,2]-T.iloc[0,2],4))
print("\nAnswer: SES  |  scale: logit log-odds, SES in native units")
print("Anchor check: |beta(M2)-0.3636| =",round(abs(T.iloc[1,2]-0.3636),4),
      "  |beta(M4)-(-0.2293)| =",round(abs(T.iloc[3,2]+0.2293),4))
