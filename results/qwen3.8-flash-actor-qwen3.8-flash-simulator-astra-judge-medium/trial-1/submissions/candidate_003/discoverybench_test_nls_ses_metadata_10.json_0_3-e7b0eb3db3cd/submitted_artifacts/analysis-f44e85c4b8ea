"""
FINAL ANALYSIS -- NLS SES / BA degree completion: coefficient-instability (mediation) check.
Question: which variable's effect on BA DEGREE COMPLETED falls from ~0.5024 to ~0.0923 and
loses significance once SES AND academic characteristics are jointly included?

Approved design:
  focal set FIXED: Female, Black, Hispanic, FAMILY SIZE, SES (reverse check).
  M0 focal only | M1 +SES | M2 +ACADEMIC | M3 +SES+ACADEMIC(+family-size control)
  ACADEMIC = z(ABILITY: COMPOSITE OF ASVAB SCORE) + z(PERCENTILE IN CLASS)
  PRIMARY: logistic regression, raw/unstandardised predictors; LPM/probit/standardised = checks.
  Firth penalised logistic on fully adjusted model only. No imputation/interactions.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 40)

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y  = df['BA DEGREE COMPLETED'].astype(int).to_numpy()
zz = lambda v: (np.asarray(v, float) - np.mean(v)) / np.std(v)
R, S = df.SAMPLE_RACE.values, df.SAMPLE_SEX.values
V = {'Female':(S=='Female').astype(float), 'Male':(S=='Male').astype(float),
     'Black':(R=='Black').astype(float), 'Hispanic':(R=='Hispanic').astype(float),
     'White':(R=='White').astype(float), 'NonWhite':(R!='White').astype(float),
     'RaceOrd_B0H1W2': np.where(R=='Black',0.,np.where(R=='Hispanic',1.,2.)),
     'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float), 'SES':df['SES'].to_numpy(float),
     'ABILITY_z':zz(df['ABILITY: COMPOSITE OF ASVAB SCORE']), 'PERCENT_z':zz(df['PERCENTILE IN CLASS']),
     'ABILITY':df['ABILITY: COMPOSITE OF ASVAB SCORE'].to_numpy(float),
     'PERCENT':df['PERCENTILE IN CLASS'].to_numpy(float)}
nm = lambda s: ['const']+list(s)
def Xm(s, sc='raw'): return sm.add_constant(np.column_stack([zz(V[c]) if sc=='std' else V[c] for c in s]), prepend=True)
def fit(s, fam='logit', sc='raw'):
    A = Xm(s, sc)
    if fam=='logit':  return sm.Logit(y, A).fit(disp=0, maxiter=300)
    if fam=='probit': return sm.Probit(y, A).fit(disp=0, maxiter=300)
    return sm.OLS(y, A).fit(cov_type='HC3')
def coef(r, s, f):
    i = nm(s).index(f); b, se = r.params[i], r.bse[i]
    p = 2*stats.norm.sf(abs(b/se))
    return b, se, b/se, p, b-1.96*se, b+1.96*se, p < 0.05

ACAD = ['ABILITY_z','PERCENT_z']
FOCAL_MAIN = ['Female','Black','Hispanic','FAMSZ','SES']
FAMOF = {'Female':[], 'Black':[], 'Hispanic':[], 'FAMSZ':[], 'SES':[]}   # sex/race/famsz: own controls
def spec(f, m, fam_in_acad=False):
    own  = [f]
    ses  = [] if f=='SES' else ['SES']
    acad = list(ACAD)
    fam  = [] if f=='FAMSZ' else ['FAMSZ']
    if m=='M0': return own
    if m=='M1': return own+ses+(fam if ses else [])
    if m=='M2': return own+acad+fam
    if m=='M3': return own+ses+acad+fam
    if m=='M3n':return own+ses+acad                       # no family-size control
    if m=='M3a':return own+ses+['ABILITY_z','PERCENT_z','FAMSZ_z'] if False else own+ses+acad+['FAMSZ']
    if m=='M2_ab':  return own+ses+['ABILITY_z']+fam      # academic block entered ONE AT A TIME
    if m=='M2_pc':  return own+ses+['PERCENT_z']+fam
MS = ['M0','M1','M2','M3','M3n','M2_ab','M2_pc']
LBL = {'M0':'M0 focal only','M1':'M1 +SES','M2':'M2 +ACADEMIC','M3':'M3 +SES+ACADEMIC(+famsz)',
       'M3n':'M3n +SES+ACADEMIC (no famsz)','M2_ab':'+SES+ABILITY only','M2_pc':'+SES+PERCENT only'}

# ------------------------------------------------- one stability table (constraint 1)
rows=[]
for f in FOCAL_MAIN:
    for m in MS:
        s=spec(f,m)
        for fam,sc,tag in [('logit','raw','logit_raw(PRIMARY)'),('logit','std','logit_std'),
                           ('probit','raw','probit_raw'),('lpm','raw','LPM_raw')]:
            try: r=fit(s,fam,sc)
            except Exception: continue
            b,se,zs,p,lo,hi,sig = coef(r,s,f)
            rows.append(dict(focal=f, model=LBL[m], spec=tag, beta=b, se=se, z=zs, p=p,
                             ci95_lo=lo, ci95_hi=hi, significant=sig, n_terms=len(s)))
T=pd.DataFrame(rows)
T.to_csv('output/stability_table.csv', index=False)
prim=T[T.spec=='logit_raw(PRIMARY)']
print('################ STABILITY TABLE -- PRIMARY: LOGIT, raw predictors ################')
for f in FOCAL_MAIN:
    print(f'\n### focal = {f}')
    print(prim[prim.focal==f].drop(columns=['focal','spec','n_terms']).round(4).to_string(index=False))

piv=prim.pivot(index='focal',columns='model',values='beta'); sg=prim.pivot(index='focal',columns='model',values='p')
order=[LBL[m] for m in ['M0','M1','M2','M3']]
SH=pd.DataFrame({'b_M0':piv[order[0]],'b_+SES':piv[order[1]],'b_+ACAD':piv[order[2]],'b_+BOTH':piv[order[3]],
                 'p_M0':sg[order[0]],'p_+BOTH':sg[order[3]]})
SH['pct_change']=100*(SH['b_+BOTH']-SH['b_M0'])/SH['b_M0'].abs()
SH['shrink_ratio_M3/M0']=SH['b_+BOTH']/SH['b_M0']
SH['sig_M0']=SH.p_M0<0.05; SH['sig_BOTH']=SH['p_+BOTH']<0.05
SH.to_csv('output/shrinkage_logit_raw.csv')
print('\n################ SHRINKAGE SUMMARY (logit raw) ################')
print(SH.round(4).to_string())

# ---------------- SAMPLE_RACE as a single contrast / ordinal: coding robustness (same variable)
print('\n################ SAMPLE_RACE coding robustness (one variable, several codings; logit raw) ################')
rr=[]
for f in ['Black','Hispanic','White','NonWhite','RaceOrd_B0H1W2']:
    other=[c for c in ['Black','Hispanic'] if c!=f]
    for m in ['M0','M1','M2','M3','M3n','M2_ab','M2_pc']:
        s=[f]+ ([] if f in ('White','NonWhite','RaceOrd_B0H1W2') else [])
        ses=[]; acad=[]; fam=[]
        if m in ('M1','M3','M3n','M2_ab','M2_pc'): ses=['SES']
        if m in ('M2','M3','M3n'): acad=ACAD
        if m in ('M2_ab',): acad=['ABILITY_z']
        if m in ('M2_pc',): acad=['PERCENT_z']
        if m in ('M2','M3'): fam=['FAMSZ']
        s=s+ses+[c for c in acad if c!=f]+fam
        r=fit(s); b,se,_,p,lo,hi,sig=coef(r,s,f)
        rr.append(dict(coding=f, model=LBL[m], beta=b, se=se, p=p, sig=sig))
RR=pd.DataFrame(rr); RR.to_csv('output/race_coding_robustness.csv', index=False)
print(RR.pivot(index='coding',columns='model',values='beta').round(4).to_string())
print('\n(p-values)'); print(RR.pivot(index='coding',columns='model',values='p').round(4).to_string())

# ------------------------------------------ VIF, LR block tests, Firth, AME
NULLLL=-2*sm.Logit(y,np.ones((len(y),1))).fit(disp=0).llf
def vif(spec):
    Z=np.column_stack([V[c] for c in spec]); Z=(Z-Z.mean(0))/Z.std(0); out={}
    for i,c in enumerate(spec):
        o=[j for j in range(len(spec)) if j!=i]
        A=sm.add_constant(Z[:,o]); bb,*_=np.linalg.lstsq(A,Z[:,i],rcond=None)
        r2=1-((Z[:,i]-A@bb)**2).sum()/((Z[:,i]-Z[:,i].mean())**2).sum(); out[c]=round(1/(1-r2),3)
    return out
FULL=['Female','Black','Hispanic','SES','ABILITY_z','PERCENT_z','FAMSZ']
print('\n################ Diagnostics ################')
print('VIF fully adjusted:', vif(FULL))
print('VIF academic pair:', vif(['ABILITY_z','PERCENT_z']))
print('corr(ABILITY_z,PERCENT_z)=%.3f ; r(Ability,BA)=%.3f ; r(Percent,BA)=%.3f'%(
    np.corrcoef(V['ABILITY_z'],V['PERCENT_z'])[0,1],
    np.corrcoef(V['ABILITY_z'],y)[0,1], np.corrcoef(V['PERCENT_z'],y)[0,1]))
def LR(a,b): return -2*(fit(a).llf-fit(b).llf)
print('joint block tests in FULL model (LR):')
for n,blk in [('SAMPLE_SEX',['Female']),('SAMPLE_RACE',['Black','Hispanic']),('SES',['SES']),
              ('ACADEMIC',ACAD),('FAMILY SIZE',['FAMSZ'])]:
    c=LR([x for x in FULL if x not in blk],FULL)
    print(f'   {n:12s} chi2={c:8.2f} df={len(blk)} p={stats.chi2.sf(c,len(blk)):.4f}')
rnull=sm.Logit(y,np.ones((len(y),1))).fit(disp=0)
c0=-2*(rnull.llf-fit(['Black','Hispanic']).llf)
print('race 2-df LR vs NULL (unadjusted): chi2=%.2f p=%.3e'%(c0,stats.chi2.sf(c0,2)))
def firth(spec, maxit=100):
    """Firth (1993) penalised logistic: damped Newton on the penalised score."""
    A=Xm(spec); b=np.asarray(fit(spec).params,float)
    def pen_score(bb):
        e=np.clip(A@bb,-30,30); p=1/(1+np.exp(-e)); w=p*(1-p)
        I=A.T@(A*w[:,None]); Ii=np.linalg.pinv(I)
        h=np.clip(np.einsum('ij,jk,ik->i',A,Ii,A),0,0.999)
        return A.T@(y-p-0.5*h*(1-2*p)), Ii
    for _ in range(maxit):
        U,Ii=pen_score(b); step=Ii@U; lam=1.0; n0=np.linalg.norm(U)
        for _ in range(30):
            nb=b+lam*step
            if np.linalg.norm(pen_score(nb)[0])<n0: break
            lam/=2
        b=b+lam*step
        if np.max(np.abs(lam*step))<1e-11: break
    e=np.clip(A@b,-30,30); p=1/(1+np.exp(-e)); w=p*(1-p)
    se=np.sqrt(np.diag(np.linalg.pinv(A.T@(A*w[:,None])))); return b,se

rb,rs=firth(FULL); r0=fit(FULL); n0=nm(FULL)
print('\nFirth penalised logit, FULLY ADJUSTED model only (event-sparsity check, 236 events):')
for i,c in enumerate(FULL):
    j=n0.index(c)
    print(f'   {c:10s} MLE {r0.params[j]:+.4f} (p={2*stats.norm.sf(abs(r0.params[j]/r0.bse[j])):.4f})'
          f'  Firth {rb[i+1]:+.4f} (p={2*stats.norm.sf(abs(rb[i+1]/rs[i+1])):.4f})'
          f'  |diff|={abs(r0.params[j]-rb[i+1]):.2e}')
m=fit(FULL); base=m.predict(Xm(FULL))
print('\nAverage marginal effects (fully adjusted, logit raw):')
for c in FULL:
    j=nm(FULL).index(c); A=Xm(FULL).copy(); A[:,j]+=1
    print(f'   {c:10s} AME={np.mean(m.predict(A)-base):+.4f}')
print('\nSE stability: is the loss of significance point-estimate change or SE inflation (sparsity)?')
for f,s0,s3 in [('Black',['Black'],['Black','SES']+ACAD+['FAMSZ']),
                ('Hispanic',['Hispanic'],['Hispanic','SES']+ACAD+['FAMSZ']),
                ('Female',['Female'],['Female','SES']+ACAD+['FAMSZ']),
                ('FAMSZ',['FAMSZ'],['FAMSZ','SES']+ACAD)]:
    r0,r3=fit(s0),fit(s3); i0,i3=nm(s0).index(f),nm(s3).index(f)
    print(f'   {f:9s} beta {r0.params[i0]:+.4f}(SE {r0.bse[i0]:.4f}) -> {r3.params[i3]:+.4f}(SE {r3.bse[i3]:.4f})'
          f'  | dSE={100*(r3.bse[i3]/r0.bse[i0]-1):+.1f}%  dBeta={r3.params[i3]-r0.params[i0]:+.4f}')
print('\nSame collapse under the comparability checks (logit / probit / LPM-HC3), race + sex:')
for f in ['Black','Hispanic','Female']:
    line=[f'{f:9s}']
    for fam,sc,tag in [('logit','raw','logit'),('probit','raw','probit'),('lpm','raw','LPM')]:
        r0=fit([f],fam,sc); r3=fit([f,'SES']+ACAD+(['FAMSZ'] if f!='FAMSZ' else []),fam,sc)
        i0,i3=nm([f]).index(f),nm([f,'SES']+ACAD+(['FAMSZ'] if f!='FAMSZ' else [])).index(f)
        line.append(f'{tag}: {r0.params[i0]:+.4f}(p={2*stats.norm.sf(abs(r0.params[i0]/r0.bse[i0])):.4f}) -> '
                    f'{r3.params[i3]:+.4f}(p={2*stats.norm.sf(abs(r3.params[i3]/r3.bse[i3])):.4f})')
    print('   '+' | '.join(line))
print('\nMcFadden pseudo-R2: null=%.4f  race-only=%.4f  full=%.4f'%(1-(-NULLLL/2)/(-NULLLL/2) if False else 0,
      1-fit(['Black','Hispanic']).llf/(-NULLLL/2), 1-m.llf/(-NULLLL/2)))
print('\nevents=%d; by race=%s; by sex=%s'%(y.sum(),
    df.groupby('SAMPLE_RACE')['BA DEGREE COMPLETED'].sum().to_dict(),
    df.groupby('SAMPLE_SEX')['BA DEGREE COMPLETED'].sum().to_dict()))
