import numpy as np, pandas as pd
def md(df, floatfmt='.4f'):
    d=df.copy()
    for c in d.columns:
        if pd.api.types.is_float_dtype(d[c]): d[c]=d[c].map(lambda v: format(v,floatfmt) if pd.notna(v) else '')
        else: d[c]=d[c].astype(str)
    head='| '+' | '.join(map(str,d.columns))+' |'
    sep='|'+'|'.join(['---']*len(d.columns))+'|'
    rows=['| '+' | '.join(r)+' |' for r in d.values.tolist()]
    return '\n'.join([head,sep]+rows)+'\n'
prim=pd.read_csv('output/stability_table.csv'); prim=prim[prim.spec=='logit_raw(PRIMARY)']
order=['M0 focal only','M1 +SES','M2 +ACADEMIC','M3 +SES+ACADEMIC(+famsz)','M3n +SES+ACADEMIC (no famsz)',
       '+SES+ABILITY only','+SES+PERCENT only']
lab=[('Focal = SAMPLE_SEX (Female, ref Male)','Female'),('Focal = SAMPLE_RACE: Black vs White','Black'),
     ('Focal = SAMPLE_RACE: Hispanic vs White','Hispanic'),('Focal = FAMILY SIZE OF SAMPLE','FAMSZ'),
     ('Focal = SES (reverse-direction check)','SES')]
out=['# Coefficient-stability table — PRIMARY: logistic regression, RAW predictors',
     '',
     'Outcome BA DEGREE COMPLETED (236/8773 = 2.69%). ACADEMIC block = z(ABILITY: COMPOSITE OF ASVAB SCORE) + z(PERCENTILE IN CLASS).',
     'Reference categories White / Male. M3 adds family size as a social-background control; M3n omits it.',
     'The last two rows per block enter the academic variables ONE AT A TIME (collinearity check).','']
for k,f in lab:
    t=prim[prim.focal==f].set_index('model').loc[order].reset_index()[['model','beta','se','z','p','ci95_lo','ci95_hi','significant']]
    out += [f'## {k}','',md(t),'']
out += ['## Shrinkage summary (logit raw)','',md(pd.read_csv('output/shrinkage_logit_raw.csv')),'']
bd=pd.read_csv('output/block_decomposition.csv')
out += ['## Block decomposition: which block makes each coefficient collapse (logit raw, beta)','',
        md(bd.pivot(index='focal',columns='model',values='beta').reset_index()),'',
        '### p-values for the same grid','',md(bd.pivot(index='focal',columns='model',values='p').reset_index()),'']
am=pd.read_csv('output/attenuation_match.csv'); am=am[am.p_M0<0.05].sort_values('err_ratio')
out += ['## Scale-free match to the reported 0.5024 -> 0.0923 (target |beta_adj/beta_M0| = 0.1837)','',
        md(am.head(14).reset_index(drop=True)),'']
rc=pd.read_csv('output/race_coding_robustness.csv')
out += ['## SAMPLE_RACE coding/reference robustness (logit raw)','',
        md(rc.pivot(index='coding',columns='model',values='beta').reset_index()),'',
        '### p-values','',md(rc.pivot(index='coding',columns='model',values='p').reset_index()),'']
open('output/STABILITY_TABLE.md','w').write('\n'.join(out))
print('\n'.join(out[:40]))
print('\n[written] output/STABILITY_TABLE.md')
