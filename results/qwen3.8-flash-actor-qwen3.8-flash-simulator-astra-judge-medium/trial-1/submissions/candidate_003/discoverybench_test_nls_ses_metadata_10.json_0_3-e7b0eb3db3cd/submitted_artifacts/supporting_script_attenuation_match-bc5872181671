import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option('display.width',250); pd.set_option('display.max_columns',40)
df=pd.read_csv('data/nls_ses_processed.csv',index_col=0)
y=df['BA DEGREE COMPLETED'].astype(int).to_numpy(); zz=lambda v:(np.asarray(v,float)-np.mean(v))/np.std(v)
R=df.SAMPLE_RACE.values
V={'Female':np.asarray(df.SAMPLE_SEX=='Female',float),'Black':np.asarray(R=='Black',float),
   'Hispanic':np.asarray(R=='Hispanic',float),'White':np.asarray(R=='White',float),
   'NonWhite':np.asarray(R!='White',float),'RaceOrd':np.where(R=='Black',0.,np.where(R=='Hispanic',1.,2.)),
   'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float),'SES':df['SES'].to_numpy(float),
   'ABILITY_z':zz(df['ABILITY: COMPOSITE OF ASVAB SCORE']),'PERCENT_z':zz(df['PERCENTILE IN CLASS'])}
nm=lambda s:['const']+list(s)
def X(s,std=False): return sm.add_constant(np.column_stack([zz(V[c]) if std else V[c] for c in s]),prepend=True)
def lg(s,std=False): return sm.Logit(y,X(s,std)).fit(disp=0,maxiter=300)
def cf(r,s,f):
    i=nm(s).index(f); return r.params[i],r.bse[i],2*stats.norm.sf(abs(r.params[i]/r.bse[i]))
TARGET=0.0923/0.5024
rows=[]
for f in ['Black','Hispanic','White','NonWhite','RaceOrd','Female','FAMSZ','SES']:
    for std in [False,True]:
        r0=lg([f],std); b0,s0,p0=cf(r0,[f],f)
        for lab,add in [('SES only',['SES']),('ACADEMIC only',['ABILITY_z','PERCENT_z']),
                        ('SES+ACADEMIC',['SES','ABILITY_z','PERCENT_z']),
                        ('SES+ACADEMIC+FAMSZ',['SES','ABILITY_z','PERCENT_z','FAMSZ'])]:
            s=[f]+[c for c in add if c!=f]
            if f=='SES' and 'SES' in add: s=[f]+[c for c in add if c!='SES']
            r3=lg(s,std); b3,s3,p3=cf(r3,s,f)
            rows.append(dict(focal=f,scale='std' if std else 'raw',model=lab,
                b_M0=b0,p_M0=p0,b_adj=b3,p_adj=p3,ratio=b3/b0,abs_ratio=abs(b3/b0),
                pct_attenuated=100*(1-abs(b3/b0)),OR_M0=np.exp(b0),OR_adj=np.exp(b3),
                err_ratio=abs(abs(b3/b0)-TARGET)))
A=pd.DataFrame(rows); A.to_csv('output/attenuation_match.csv',index=False)
print(f'=== SCALE-FREE MATCH: target attenuation ratio |b_adj/b_M0| = {TARGET:.4f} (0.0923/0.5024) ===')
print(A[A.p_M0<0.05].sort_values('err_ratio').round(4).to_string(index=False))
print('\n=== WHICH BLOCK DOES THE WORK? (raw logit, % attenuation of focal coefficient) ===')
for f in ['White','NonWhite','Black','Hispanic','Female','FAMSZ','SES']:
    b0=cf(lg([f]),[f],f)[0]
    line=f'{f:9s} b_M0={b0:+.4f} '
    for lab,add in [('+SES',['SES']),('+ACAD',['ABILITY_z','PERCENT_z']),
                    ('+SES+ACAD',['SES','ABILITY_z','PERCENT_z'])]:
        s=[f]+[c for c in add if c!=f]
        if f=='SES': s=[f]+[c for c in add if c!='SES']
        r=lg(s); b,se,p=cf(r,s,f)
        line+=f'| {lab}: {b:+.4f} (p={p:.3f}, att={100*(1-abs(b/b0)):+.0f}%) '
    print(line)
print('\n=== OR interpretation for the race gap (raw logit) ===')
for f in ['White','Black','Hispanic']:
    b0,s0,p0=cf(lg([f]),[f],f); s=[f,'SES','ABILITY_z','PERCENT_z']
    b3,s3,p3=cf(lg(s),s,f)
    print(f'  {f:9s} unadjusted OR={np.exp(b0):.3f} [CI {np.exp(b0-1.96*s0):.3f},{np.exp(b0+1.96*s0):.3f}] p={p0:.2e}'
          f'  ->  adjusted OR={np.exp(b3):.3f} [CI {np.exp(b3-1.96*s3):.3f},{np.exp(b3+1.96*s3):.3f}] p={p3:.3f}')
print('\n=== % BA completion by race & by ability/rank tertile (descriptive mechanism) ===')
df['AB_T']=pd.qcut(df['ABILITY: COMPOSITE OF ASVAB SCORE'],3,labels=['low','mid','high'])
df['PC_T']=pd.qcut(df['PERCENTILE IN CLASS'],3,labels=['low','mid','high'])
print(df.pivot_table(index='SAMPLE_RACE',columns='AB_T',values='BA DEGREE COMPLETED',aggfunc='mean').round(4).to_string())
print(df.pivot_table(index='SAMPLE_RACE',columns='PC_T',values='BA DEGREE COMPLETED',aggfunc='mean').round(4).to_string())
print(df.pivot_table(index='SAMPLE_RACE',columns='AB_T',values='CASE ID',aggfunc='size').to_string())
