import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option('display.width',250)
df=pd.read_csv('data/nls_ses_processed.csv',index_col=0)
y=df['BA DEGREE COMPLETED'].astype(int).to_numpy(); zz=lambda v:(np.asarray(v,float)-np.mean(v))/np.std(v)
R=df.SAMPLE_RACE.values
V={'Female':np.asarray(df.SAMPLE_SEX=='Female',float),'Black':np.asarray(R=='Black',float),
   'Hispanic':np.asarray(R=='Hispanic',float),'White':np.asarray(R=='White',float),
   'NonWhite':np.asarray(R!='White',float),
   'RaceOrd':np.where(R=='Black',0.,np.where(R=='Hispanic',1.,2.)),
   'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float),'SES':df['SES'].to_numpy(float),
   'ABILITY_z':zz(df['ABILITY: COMPOSITE OF ASVAB SCORE']),'PERCENT_z':zz(df['PERCENTILE IN CLASS'])}
nm=lambda s:['const']+list(s)
def X(s,std=False): return sm.add_constant(np.column_stack([zz(V[c]) if std else V[c] for c in s]),prepend=True)
def lg(s,std=False): return sm.Logit(y,X(s,std)).fit(disp=0,maxiter=300)
def cf(r,s,f):
    i=nm(s).index(f); b,se=r.params[i],r.bse[i]; return b,se,2*stats.norm.sf(abs(b/se))
NULL=-2*sm.Logit(y,np.ones((len(y),1))).fit(disp=0).llf
ACAD=['ABILITY_z','PERCENT_z']
LADDER=[('M0 focal only',[]),('+SES',['SES']),('+ACADEMIC',ACAD),('+SES+ACADEMIC',['SES']+ACAD),
        ('+FAMSZ only',['FAMSZ']),('+SES+FAMSZ',['SES','FAMSZ']),('+ACAD+FAMSZ',ACAD+['FAMSZ']),
        ('+SES+ACADEMIC+FAMSZ',['SES']+ACAD+['FAMSZ'])]
out=[]
for f in ['NonWhite','White','Black','Hispanic','RaceOrd','Female','FAMSZ','SES']:
    own=[c for c in [f] ]
    for lab,add in LADDER:
        s=own+[c for c in add if c!=f]
        r=lg(s); b,se,p=cf(r,s,f)
        out.append(dict(focal=f,model=lab,beta=b,se=se,p=p,sig=p<0.05,
                        pseudoR2=1-r.llf/(-NULL/2)))
L=pd.DataFrame(out); L.to_csv('output/block_decomposition.csv',index=False)
print('=== BLOCK DECOMPOSITION: where does each coefficient collapse? (logit, raw) ===')
print(L.pivot(index='focal',columns='model',values='beta').round(4).to_string())
print('\n(p-values)'); print(L.pivot(index='focal',columns='model',values='p').round(4).to_string())
print('\n=== standardised-predictor logit, same ladder (secondary scaling column) ===')
out2=[]
for f in ['NonWhite','White','Black','Hispanic','RaceOrd','Female','FAMSZ','SES']:
    for lab,add in LADDER:
        s=[f]+[c for c in add if c!=f]; r=lg(s,std=True); b,se,p=cf(r,s,f)
        out2.append(dict(focal=f,model=lab,beta=b,p=p))
L2=pd.DataFrame(out2); L2.to_csv('output/block_decomposition_stdlogit.csv',index=False)
print(L2.pivot(index='focal',columns='model',values='beta').round(4).to_string())
print('\n(p-values)'); print(L2.pivot(index='focal',columns='model',values='p').round(4).to_string())
print('\n=== LR chi2 for each block, nested additions from focal-only base (race contrast = NonWhite) ===')
base=['NonWhite']; prev=-2*lg(base).llf
for lab,add in [('+SES',['SES']),('+ACAD',ACAD),('+FAMSZ',['FAMSZ'])]:
    cur=-2*lg(base+add).llf; print(f'  {lab:10s} LR chi2={prev-cur:8.2f} df={len(add)} p={stats.chi2.sf(prev-cur,len(add)):.2e}')
full=base+['SES']+ACAD+['FAMSZ']; cur=-2*lg(full).llf
print(f'  ALL THREE   LR chi2={prev-cur:8.2f} df=4 p={stats.chi2.sf(prev-cur,4):.2e}')
print('\n=== null-model / joint race test ===')
r0=sm.Logit(y,np.ones((len(y),1))).fit(disp=0); rr=lg(['Black','Hispanic'])
c=-2*(r0.llf-rr.llf); print(f'  race 2-df LR vs null: chi2={c:.2f} p={stats.chi2.sf(c,2):.3e}')
rfull=['Female','Black','Hispanic','SES']+ACAD+['FAMSZ']; rN=lg([c for c in rfull if c not in ['Black','Hispanic']])
c2=-2*(rN.llf-lg(rfull).llf); print(f'  race 2-df LR in full model: chi2={c2:.2f} p={stats.chi2.sf(c2,2):.4f}')
print('\n=== SES & covariate means by race (why the gap closes) ===')
print(df.groupby('SAMPLE_RACE')[['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE','BA DEGREE COMPLETED']].mean().round(3).to_string())
