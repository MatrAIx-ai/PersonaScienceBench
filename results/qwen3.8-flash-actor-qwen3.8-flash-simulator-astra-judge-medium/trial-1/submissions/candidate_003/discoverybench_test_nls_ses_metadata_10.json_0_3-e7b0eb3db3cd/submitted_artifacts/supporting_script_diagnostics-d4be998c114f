# ---------- 2. VIF + collinearity in fully adjusted model ----------
def vif(spec):
    Z=np.column_stack([V[c] for c in spec]); Z=(Z-Z.mean(0))/Z.std(0)
    out={}
    for i,c in enumerate(spec):
        others=[j for j in range(len(spec)) if j!=i]
        b,res_,_,_=np.linalg.lstsq(sm.add_constant(Z[:,others]),Z[:,i],rcond=None)
        r2=1-((Z[:,i]-sm.add_constant(Z[:,others])@b)**2).sum()/((Z[:,i]-Z[:,i].mean())**2).sum()
        out[c]=1/(1-r2)
    return out
full=['Female','Black','Hispanic','SES','ABILITY_z','PERCENT_z','FAMSZ']
print('\n=== VIF, fully adjusted logit ==='); print({k:round(v,3) for k,v in vif(full).items()})
print('=== VIF, academic block only ==='); print({k:round(v,3) for k,v in vif(['ABILITY_z','PERCENT_z']).items()})
