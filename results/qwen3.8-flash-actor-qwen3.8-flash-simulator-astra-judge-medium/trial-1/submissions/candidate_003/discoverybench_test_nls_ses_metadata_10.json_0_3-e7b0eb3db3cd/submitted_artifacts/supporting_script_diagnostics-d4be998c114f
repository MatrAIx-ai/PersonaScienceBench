df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y  = df['BA DEGREE COMPLETED'].astype(int).to_numpy()
z  = lambda v: (np.asarray(v,float)-np.mean(v))/np.std(v)
V = {'Female':(df.SAMPLE_SEX=='Female').astype(float).to_numpy(),
     'Male':(df.SAMPLE_SEX=='Male').astype(float).to_numpy(),
     'Black':(df.SAMPLE_RACE=='Black').astype(float).to_numpy(),
     'Hispanic':(df.SAMPLE_RACE=='Hispanic').astype(float).to_numpy(),
     'White':(df.SAMPLE_RACE=='White').astype(float).to_numpy(),
     'NonWhite':(df.SAMPLE_RACE!='White').astype(float).to_numpy(),
     'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float),
     'SES':df['SES'].to_numpy(float),
     'ABILITY_z':z(df['ABILITY: COMPOSITE OF ASVAB SCORE']),
     'PERCENT_z':z(df['PERCENTILE IN CLASS']),
     'ABILITY':df['ABILITY: COMPOSITE OF ASVAB SCORE'].to_numpy(float),
     'PERCENT':df['PERCENTILE IN CLASS'].to_numpy(float)}
def X(spec): return sm.add_constant(np.column_stack([V[c] for c in spec]), prepend=True)
def nm(spec): return ['const']+list(spec)
def lg(spec): return sm.Logit(y, X(spec)).fit(disp=0, maxiter=300)

# ---------- 1. does ANY focal/spec/family reproduce (~0.5024, ~0.0923)? ----------
ACAD=['ABILITY_z','PERCENT_z']; FAM=['FAMSZ']
enc={'Female':['Female'],'Male':['Male'],'Black':['Black'],'Hispanic':['Hispanic'],
     'White_vs_Hisp':['White'],
     'NonWhite':['NonWhite'],'FAMSZ':['FAMSZ'],'SES':['SES'],'ABILITY':['ABILITY_z'],'PERCENT':['PERCENT_z']}
res=[]
for name,foc in enc.items():
    f0=foc[0]
    for tag,ac in [('acad_z',ACAD),('acad_raw',['ABILITY','PERCENT']),('acad_ability_only',['ABILITY_z']),
                   ('acad_percent_only',['PERCENT_z']),('no_acad',[])]:
        for famc in [FAM,[]]:
            m0=foc
            m3=[f0]+(['SES'] if f0!='SES' else [])+[c for c in ac if c not in foc]+([] if f0=='FAMSZ' else [c for c in famc if c not in foc])
            try: r0,r3=lg(m0),lg(m3)
            except Exception as e: continue
            n0,n3=nm(m0),nm(m3)
            b0=r0.params[n0.index(f0)]
            b3=r3.params[n3.index(f0)]; s3=r3.bse[n3.index(f0)]
            p3=2*stats.norm.sf(abs(b3/s3))
            res.append(dict(focal=f0,acad=tag,famsize_ctrl=bool(famc),b_M0=b0,b_M3=b3,se_M3=s3,p_M3=p3,
                            err=abs(b0-0.5024)+abs(b3-0.0923)))
srch=pd.DataFrame(res).sort_values('err')
