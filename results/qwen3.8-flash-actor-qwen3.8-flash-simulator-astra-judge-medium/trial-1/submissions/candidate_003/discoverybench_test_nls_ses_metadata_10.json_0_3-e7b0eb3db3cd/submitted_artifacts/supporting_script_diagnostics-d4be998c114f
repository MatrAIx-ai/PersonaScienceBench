# ---------- 5. Firth penalised logistic (fully adjusted models only) ----------
def firth(spec, tol=1e-9, maxit=100):
    Xm=X(spec); k=Xm.shape[1]; b=np.zeros(k); b[0]=np.log(y.mean()/(1-y.mean()))
    for _ in range(maxit):
        eta=Xm@b; p=1/(1+np.exp(-eta)); W=p*(1-p)
        I=Xm.T@(Xm*W[:,None]); Ii=np.linalg.inv(I); h=(Xm@Ii*Xm).sum(1)
        U=Xm.T@(y-p-0.5*h*(1-2*p))          # Firth-adjusted score
        step=Ii@U; b=b+step
        if np.max(np.abs(step))<tol: break
    se=np.sqrt(np.diag(Ii)); return b,se,p,W
