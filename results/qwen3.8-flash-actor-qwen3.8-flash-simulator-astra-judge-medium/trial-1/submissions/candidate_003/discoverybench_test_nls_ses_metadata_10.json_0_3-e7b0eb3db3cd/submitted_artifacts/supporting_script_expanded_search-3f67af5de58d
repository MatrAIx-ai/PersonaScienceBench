import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option('display.width',260); pd.set_option('display.max_columns',40)
df=pd.read_csv('data/nls_ses_processed.csv',index_col=0)
y=df['BA DEGREE COMPLETED'].astype(int).to_numpy()
zz=lambda v:(np.asarray(v,float)-np.mean(v))/np.std(v)
R=df.SAMPLE_RACE.values
V={'Female':(df.SAMPLE_SEX=='Female').astype(float),
   'Male':(df.SAMPLE_SEX=='Male').astype(float).to_numpy(),
   'Black':(R=='Black').astype(float),'Hispanic':(R=='Hispanic').astype(float),
   'White':(R=='White').astype(float),'NonWhite':(R!='White').astype(float),
   'RaceOrd_B0H1W2':np.where(R=='Black',0.,np.where(R=='Hispanic',1.,2.)),
   'RaceOrd_W0H1B2':np.where(R=='White',0.,np.where(R=='Hispanic',1.,2.)),
   'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float),'FAMSZ_rev':13-df['FAMILY SIZE OF SAMPLE'].to_numpy(float),
   'SES':df['SES'].to_numpy(float),'ABILITY_z':zz(df['ABILITY: COMPOSITE OF ASVAB SCORE']),
   'PERCENT_z':zz(df['PERCENTILE IN CLASS']),'ABILITY':df['ABILITY: COMPOSITE OF ASVAB SCORE'].to_numpy(float),
   'PERCENT':df['PERCENTILE IN CLASS'].to_numpy(float)}
nm=lambda s:['const']+list(s)
def X(s,sc): 
    cols=[zz(V[c]) if sc=='std' else V[c] for c in s]; return sm.add_constant(np.column_stack(cols),prepend=True)
def fit(s,fam='logit',sc='raw'):
    Xm=X(s,sc)
    return (sm.Logit(y,Xm) if fam=='logit' else sm.Probit(y,Xm) if fam=='probit' else sm.OLS(y,Xm)).fit(disp=0,maxiter=300) if fam!='lpm' else sm.OLS(y,Xm).fit(cov_type='HC3')

FOCALS=['Female','Male','Black','Hispanic','White','NonWhite','RaceOrd_B0H1W2','RaceOrd_W0H1B2','FAMSZ','FAMSZ_rev','SES']
BACK=['Female','Black','Hispanic']
ACADS={'z':['ABILITY_z','PERCENT_z'],'raw':['ABILITY','PERCENT'],'pct_only':['PERCENT_z'],'ab_only':['ABILITY_z'],'none':[]}
rows=[]
for f in FOCALS:
    for base_name,base in [('none',[]),('background',BACK),('background+famsz',BACK+['FAMSZ'])]:
        base=[c for c in base if c not in (f,) and not (f in ('Black','Hispanic','White','NonWhite','RaceOrd_B0H1W2','RaceOrd_W0H1B2') and c in ('Black','Hispanic','White')) and not (f in('Female','Male') and c=='Female') and not (f=='FAMSZ' and c=='FAMSZ')]
        for an,ac in ACADS.items():
            for famsz in ([],['FAMSZ']):
                for fam in ['logit','probit','lpm']:
                    for sc in ['raw','std']:
                        m0=[f]+base; m3=[f]+base+([] if f=='SES' else ['SES'])+[c for c in ac if c!=f]+([] if f=='FAMSZ' else famsz)
                        if len(set(m3))<len(m3): continue
                        try: r0,r3=fit(m0,fam,sc),fit(m3,fam,sc)
                        except Exception: continue
                        n0,n3=nm(m0),nm(m3); b0=r0.params[n0.index(f)]; b3=r3.params[n3.index(f)]
                        p3=2*stats.norm.sf(abs(b3/r3.bse[n3.index(f)]))
                        rows.append(dict(focal=f,base=base_name,acad=an,famctl=bool(famsz),fam=fam,scale=sc,
                                         b_M0=b0,b_M3=b3,p_M3=p3,err=abs(b0-0.5024)+abs(b3-0.0923)))
S=pd.DataFrame(rows)
S.to_csv('output/target_search_all.csv',index=False)
print('searched combinations:',len(S))
print('\n=== TOP 20 closest to (0.5024 -> 0.0923) ===')
print(S.sort_values('err').head(20).round(4).to_string(index=False))
print('\n=== best match among SIGNIFICANT->INSIGNIFICANT only (p_M0<.05 required separately below) ===')
# also record p_M0
rows2=[]
for _,r in S.iterrows(): pass
print(S[(S.p_M3>0.05)].sort_values('err').head(10).round(4).to_string(index=False))

# --- race / sex / famsize block tests: significant unadjusted -> adjusted? ---
print('\n=== BLOCK tests (logit): joint significance of each block, unadjusted vs fully adjusted ===')
def lr(a,b):  # nested a subset of b
    return -2*(fit(a).llf-fit(b).llf)
FULL=BACK+['SES','ABILITY_z','PERCENT_z','FAMSZ']
for name,block in [('SAMPLE_SEX',['Female']),('SAMPLE_RACE',['Black','Hispanic']),
                   ('SES',['SES']),('ACADEMIC',['ABILITY_z','PERCENT_z']),('FAMSZ',['FAMSZ'])]:
    red=[c for c in FULL if c not in block]
    chi=lr(red,FULL); dfree=len(block)
    print(f'  {name:11s} in full model: LR chi2={chi:7.2f} df={dfree} p={stats.chi2.sf(chi,dfree):.4f}')
for name,block in [('SAMPLE_SEX',['Female']),('SAMPLE_RACE',['Black','Hispanic']),('SES',['SES']),('FAMSZ',['FAMSZ'])]:
    red=[c for c in block[1:]]  # nested
    chi=lr([block[0]]+red,[block[0]]); dfree=len(red)
print('\n--- marginal effects, fully adjusted model (AME) ---')
m=fit(FULL); p1=m.predict(X(FULL)); 
for c in ['Female','Black','Hispanic','SES','FAMSZ']:
    Xm=X(FULL); j=nm(FULL).index(c)+0
    A=Xm.copy(); A[:,j]=A[:,j]+1
    print(f'  {c:9s} AME={np.mean(m.predict(A)-p1):+.4f}')
for c in ['ABILITY_z','PERCENT_z']:
    Xm=X(FULL); j=nm(FULL).index(c); A=Xm.copy(); A[:,j]=A[:,j]+1
    print(f'  {c:9s} AME={np.mean(m.predict(A)-p1):+.4f}')
