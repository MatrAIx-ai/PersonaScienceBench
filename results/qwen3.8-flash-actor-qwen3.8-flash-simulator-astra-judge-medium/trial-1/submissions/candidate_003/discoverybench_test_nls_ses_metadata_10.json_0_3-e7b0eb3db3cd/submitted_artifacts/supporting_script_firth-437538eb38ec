import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option('display.width',250); pd.set_option('display.max_columns',40)
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y  = df['BA DEGREE COMPLETED'].astype(int).to_numpy()
zz = lambda v: (np.asarray(v,float)-np.mean(v))/np.std(v)
V = {'Female':(df.SAMPLE_SEX=='Female').astype(float).to_numpy(),
     'Black':(df.SAMPLE_RACE=='Black').astype(float).to_numpy(),
     'Hispanic':(df.SAMPLE_RACE=='Hispanic').astype(float).to_numpy(),
     'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float),
     'SES':df['SES'].to_numpy(float),
     'ABILITY_z':zz(df['ABILITY: COMPOSITE OF ASVAB SCORE']),
     'PERCENT_z':zz(df['PERCENTILE IN CLASS'])}
nm=lambda s:['const']+list(s)
def X(s): return sm.add_constant(np.column_stack([V[c] for c in s]),prepend=True)
def lg(s): return sm.Logit(y,X(s)).fit(disp=0,maxiter=300)
def tab(specs,label):
    print(f'\n=== {label} (logit, raw) ===')
    keys=sorted({c for s in specs.values() for c in s})
    out={}
    for k,s in specs.items():
        r=lg(s); n=nm(s)
        out[k]={c:(r.params[n.index(c)],2*stats.norm.sf(abs(r.params[n.index(c)]/r.bse[n.index(c)]))) for c in s}
    rows=[]
    for c in keys:
        d={'term':c}
        for k in specs:
            d[k]=(f"{out[k][c][0]:+.4f} (p={out[k][c][1]:.3f})" if c in out[k] else '--')
        rows.append(d)
    print(pd.DataFrame(rows).to_string(index=False))

DEMO=['Female','Black','Hispanic','FAMSZ']
tab({'A_background':DEMO,'B_+SES':DEMO+['SES'],'C_+acad':DEMO+['ABILITY_z','PERCENT_z'],
     'D_full':DEMO+['SES','ABILITY_z','PERCENT_z']},'STEPWISE LADDER: background -> +SES -> +acad')

# Firth penalised logistic with damping + pinv, MLE start
def firth(spec,maxit=200):
    Xm=X(spec); k=Xm.shape[1]
    b=np.asarray(lg(spec).params,float).copy()
    for it in range(maxit):
        eta=np.clip(Xm@b,-30,30); p=1/(1+np.exp(-eta)); w=p*(1-p)
        I=Xm.T@(Xm*w[:,None])
        try: Ii=np.linalg.pinv(I)
        except Exception: break
        h=np.einsum('ij,jk,ik->i',Xm,Ii,Xm)
        h=np.clip(h,0,0.999)
        U=Xm.T@(y-p-0.5*h*(1-2*p))
        step=Ii@U
        lam=1.0
        for _ in range(30):                      # damped Newton
            nb=b+lam*step
            e2=np.clip(Xm@nb,-30,30); p2=1/(1+np.exp(-e2)); w2=p2*(1-p2)
            I2=Xm.T@(Xm*w2[:,None]); h2=np.clip(np.einsum('ij,jk,ik->i',Xm,np.linalg.pinv(I2),Xm),0,0.999)
            if np.linalg.norm(Xm.T@(y-p2-0.5*h2*(1-2*p2)))<np.linalg.norm(U): break
            lam/=2
        b=b+lam*step
        if np.max(np.abs(lam*step))<1e-10: break
    e=np.clip(Xm@b,-30,30); p=1/(1+np.exp(-e)); w=p*(1-p)
    I=Xm.T@(Xm*w[:,None]); se=np.sqrt(np.diag(np.linalg.pinv(I)))
    return b,se,it
print('\n=== FIRTH penalised logistic, FULLY ADJUSTED model only (event-sparsity check) ===')
print('(Black: %d events, Hispanic: %d, Female: %d -> rule-of-ten violated for race cells)'%(
 int(y[V['Black']>0].sum()), int(y[V['Hispanic']>0].sum()), int(y[V['Female']>0].sum())))
print(f'{"term":9s} {"MLE b":>8s} {"MLE se":>8s} {"MLE p":>7s} | {"Firth b":>8s} {"Firth se":>8s} {"Firth p":>7s}  iters')
full=['Female','Black','Hispanic','SES','ABILITY_z','PERCENT_z','FAMSZ']
r=lg(full); n=nm(full)
b,se,it=firth(full)
for i,c in enumerate(full):
    pm=2*stats.norm.sf(abs(r.params[n.index(c)]/r.bse[n.index(c)])); pf=2*stats.norm.sf(abs(b[i+1]/se[i+1]))
    print(f'{c:9s} {r.params[n.index(c)]:8.4f} {r.bse[n.index(c)]:8.4f} {pm:7.4f} | {b[i+1]:8.4f} {se[i+1]:8.4f} {pf:7.4f}  {it}')

# SES reverse-direction check under Firth too
full2=['Female','Black','Hispanic','ABILITY_z','PERCENT_z','FAMSZ','SES']
r2=lg(full2); n2=nm(full2); b2,se2,it2=firth(full2)
print('\nSES reverse check (SES last): MLE %.4f (p=%.4f) | Firth %.4f (p=%.4f)'%(
    r2.params[n2.index('SES')],2*stats.norm.sf(abs(r2.params[n2.index('SES')]/r2.bse[n2.index('SES')])),
    b2[-1],2*stats.norm.sf(abs(b2[-1]/se2[-1]))))
print('\nevents=%d  EPV(7 params)=%.1f  events by race=%s  by sex=%s'%(y.sum(),y.sum()/7,
   df.groupby('SAMPLE_RACE')['BA DEGREE COMPLETED'].sum().to_dict(),
   df.groupby('SAMPLE_SEX')['BA DEGREE COMPLETED'].sum().to_dict()))
