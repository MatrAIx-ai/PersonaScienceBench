import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option('display.width',260)
df=pd.read_csv('data/nls_ses_processed.csv',index_col=0)
y=df['BA DEGREE COMPLETED'].astype(int).to_numpy(); zz=lambda v:(np.asarray(v,float)-np.mean(v))/np.std(v)
R=df.SAMPLE_RACE.values
V={'Female':np.asarray(df.SAMPLE_SEX=='Female',float),'Black':np.asarray(R=='Black',float),
   'Hispanic':np.asarray(R=='Hispanic',float),'White':np.asarray(R=='White',float),
   'NonWhite':np.asarray(R!='White',float),'RaceOrd':np.where(R=='Black',0.,np.where(R=='Hispanic',1.,2.)),
   'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float),'SES':df['SES'].to_numpy(float),
   'ABILITY_z':zz(df['ABILITY: COMPOSITE OF ASVAB SCORE']),'PERCENT_z':zz(df['PERCENTILE IN CLASS'])}
nm=lambda s:['const']+list(s)
def X(s,std): return sm.add_constant(np.column_stack([zz(V[c]) if std else V[c] for c in s]),prepend=True)
def lg(s,std=False): return sm.Logit(y,X(s,std)).fit(disp=0,maxiter=300)
def cf(r,s,f):
    i=nm(s).index(f); return r.params[i],r.bse[i],2*stats.norm.sf(abs(r.params[i]/r.bse[i]))
ADJ=['SES','ABILITY_z','PERCENT_z']          # literal model in the question
rows=[]
for f in ['White','NonWhite','Black','Hispanic','RaceOrd','Female','FAMSZ','SES']:
    for std in [False,True]:
        b0,s0,p0=cf(lg([f],std),[f],f)
        s=[f]+[c for c in ADJ if c!=f]
        b3,s3,p3=cf(lg(s,std),s,f)
        rows.append(dict(focal=f,scale='standardised' if std else 'raw',
            b_unadj=b0,p_unadj=p0,b_fully_adj=b3,se_adj=s3,p_fully_adj=p3,
            pct_atten=100*(1-abs(b3/b0)),ratio=abs(b3/b0),
            err_pair=abs(b0-0.5024)+abs(b3-0.0923),
            err_pair_signed=abs(abs(b0)-0.5024)+abs(abs(b3)-0.0923)))
F=pd.DataFrame(rows); F.to_csv('output/focused_match.csv',index=False)
print('=== FOCUSED: fully adjusted = focal + SES + ABILITY_z + PERCENT_z (literal question model) ===')
print(F.sort_values('err_pair_signed').round(4).to_string(index=False))
print('\n=== Attribution: which block kills it? raw logit; target attenuation = %.1f%% ==='%(100*(1-0.0923/0.5024)))
for f in ['White','Black','Hispanic','Female','FAMSZ','SES']:
    b0=cf(lg([f]),[f],f)[0]; line=f'{f:9s} {b0:+.4f} '
    for lab,add in [('SES',['SES']),('ACAD',['ABILITY_z','PERCENT_z']),('SES+ACAD',ADJ)]:
        s=[f]+[c for c in add if c!=f]; b,se,p=cf(lg(s),s,f)
        line+=f'| {lab}: {b:+.4f} p={p:.3f} att={100*(1-abs(b/b0)):+6.1f}% '
    print(line)
print('\n=== 95% CI check for the culprit (White vs non-White, raw logit) ===')
for s,lab in [(['White'],'unadjusted'),(['White','SES'],'+SES'),(['White','ABILITY_z','PERCENT_z'],'+ACADEMIC'),
              (['White','SES','ABILITY_z','PERCENT_z'],'+SES+ACADEMIC')]:
    b,se,p=cf(lg(s),s,'White')
    print(f'  {lab:15s} beta={b:+.4f}  95% CI [{b-1.96*se:+.4f},{b+1.96*se:+.4f}]  OR={np.exp(b):.3f}  p={p:.4g}')
