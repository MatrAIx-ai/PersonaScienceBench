"""
NLS SES / BA-degree coefficient-instability (mediation) analysis.

Question: which variable's effect on BA DEGREE COMPLETED falls from ~0.5024 to
~0.0923 (and loses significance) once SES AND academic characteristics are
jointly included?

Design (as approved by the researcher):
  * Focal set FIXED: Female, Black, Hispanic, FAMILY SIZE, SES (reverse check).
  * Nested models per focal:
      M0 focal only
      M1 focal + SES        (SES entering alone)
      M2 focal + ACADEMIC   (academic block entering alone)
      M3 focal + SES + ACADEMIC (+ FAMILY SIZE background control)  <- fully adjusted
      M3n focal + SES + ACADEMIC  (no family-size control; sensitivity)
      M3a focal + SES + ACADEMIC* (family size treated as part of academic block; sensitivity)
      M2x focal + SES + one academic variable at a time (collinearity check)
  * ACADEMIC = z(ABILITY: COMPOSITE OF ASVAB SCORE) + z(PERCENTILE IN CLASS).
  * Primary model family: LOGIT on raw/unstandardised predictors.
    Secondary: standardised-predictor logit (raw and all-standardised), probit, LPM.
  * Firth penalised logit on the fully adjusted model only (event-sparsity check).
  * Dummies: reference = White (Black, Hispanic) and Male (Female).
No missing data, so no imputation. No interactions, no moderated mediation.
"""
import numpy as np, pandas as pd, itertools, json
import statsmodels.api as sm
from scipy import stats, optimize

RAW = 'data/nls_ses_processed.csv'
OUT = 'output'
ALPHA = 0.05

# ---------------------------------------------------------------- data prep ---
df = pd.read_csv(RAW, index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int).to_numpy()

d = pd.DataFrame(index=df.index)
d['Female']   = (df['SAMPLE_SEX'].values == 'Female').astype(float)   # ref = Male
d['Black']    = (df['SAMPLE_RACE'].values == 'Black').astype(float)   # ref = White
d['Hispanic'] = (df['SAMPLE_RACE'].values == 'Hispanic').astype(float)
d['White']    = (df['SAMPLE_RACE'].values == 'White').astype(float)
d['Male']     = (df['SAMPLE_SEX'].values == 'Male').astype(float)

def z(v):
    v = np.asarray(v, float); return (v - v.mean()) / v.std(ddof=0)

raw = {'SES': df['SES'].to_numpy(float),
       'ABILITY': df['ABILITY: COMPOSITE OF ASVAB SCORE'].to_numpy(float),
       'PERCENT': df['PERCENTILE IN CLASS'].to_numpy(float),
       'FAMSZ': df['FAMILY SIZE OF SAMPLE'].to_numpy(float)}
zs  = {k + '_z': z(v) for k, v in raw.items()}
CONT = {**raw, **zs}
VAR = {**{k: d[k].to_numpy(float) for k in d.columns}, **CONT}

ACAD   = ['ABILITY_z', 'PERCENT_z']      # approved academic block
SESb   = ['SES']
FAM    = ['FAMSZ']
FOCAL  = ['Female', 'Black', 'Hispanic', 'FAMSZ', 'SES']

def cols(spec, scale):
    """scale: 'raw' -> continuous unstandardised; 'std' -> continuous z-scored."""
    out = []
    for c in spec:
        out.append((c[:-2] if c.endswith('_z') else c) if scale == 'raw' and not c.endswith('_z') else c)
    return out

def design(spec, scale):
    """Design matrix; continuous vars z-scored when scale='std'. With scale='all'
    dummies are standardised too (fully standardised-beta variant)."""
    Xs = []
    for c in spec:
        if scale == 'raw':
            Xs.append(VAR[c])
        elif scale == 'std':
            Xs.append(z(VAR[c]) if c in CONT or c in ('ABILITY','PERCENT','SES','FAMSZ') else VAR[c])
        else:  # 'all'
            Xs.append(z(VAR[c]))
    X = np.column_stack(Xs)
    return sm.add_constant(X, prepend=True), ['const'] + list(spec)

# ------------------------------------------------------------------- fitters ---
def fit(kind, spec, scale='raw'):
    X, names = design(spec, scale)
    if kind == 'logit':
        r = sm.Logit(y, X).fit(disp=0, maxiter=200)
    elif kind == 'probit':
        r = sm.Probit(y, X).fit(disp=0, maxiter=200)
    elif kind == 'lpm':
        r = sm.OLS(y, X).fit(cov_type='HC3')
    else:
        raise ValueError(kind)
    return r, names

def row(r, names, focal):
    i = names.index(focal)
    b, se = r.params[i], r.bse[i]
    zst = b / se
    p = 2 * stats.norm.sf(abs(zst))
    lo, hi = b - 1.96 * se, b + 1.96 * se
    return dict(beta=b, se=se, z=zst, p=p, ci_lo=lo, ci_hi=hi, sig=bool(p < ALPHA))

# ------------------------------------------------------- model specifications ---
def specs_for(focal):
    fam_ctrl = [] if focal == 'FAMSZ' else FAM
    sesb = [] if focal == 'SES' else SESb
    acad = [a for a in ACAD]
    return {
        'M0_focal_only':                 [focal],
        'M1_plus_SES':                   [focal] + sesb + (fam_ctrl if sesb else []),
        'M2_plus_academic':              [focal] + acad + fam_ctrl,
        'M3_plus_SES_and_academic':      [focal] + sesb + acad + fam_ctrl,
        'M3n_no_famsz_control':          [focal] + sesb + acad,
        'M3a_academic_with_famsz':       [focal] + sesb + ['ABILITY_z', 'PERCENT_z', 'FAMSZ_z'],
        'M2x_plus_SES_and_ability_only': [focal] + sesb + ['ABILITY_z'] + fam_ctrl,
        'M2x_plus_SES_and_percent_only': [focal] + sesb + ['PERCENT_z'] + fam_ctrl,
    }

rows = []
for focal in FOCAL:
    for mname, spec in specs_for(focal).items():
        for kind, scale, tag in [('logit','raw','logit_raw'), ('logit','std','logit_std'),
                                 ('logit','all','logit_allstd'), ('probit','raw','probit_raw'),
                                 ('lpm','raw','LPM_raw'), ('lpm','std','LPM_std')]:
            r, names = fit(kind, spec, scale)
            rr = row(r, names, focal)
            rr.update(focal=focal, model=mname, spec=tag, n_obs=int(len(y)),
                      n_params=len(names), llf=float(getattr(r, 'llf', np.nan)),
                      terms='|'.join(names[1:]))
            rows.append(rr)
tab = pd.DataFrame(rows)[['focal','model','spec','beta','se','z','p','ci_lo','ci_hi','sig',
                          'n_params','llf','terms']]
tab.to_csv(f'{OUT}/coefficient_grid.csv', index=False)

# shrinkage table on the PRIMARY specification (logit, raw predictors)
prim = tab[(tab.spec == 'logit_raw') &
           tab.model.isin(['M0_focal_only','M1_plus_SES','M2_plus_academic','M3_plus_SES_and_academic'])]
piv = prim.pivot(index='focal', columns='model', values='beta')
sig = prim.pivot(index='focal', columns='model', values='sig')
shr = pd.DataFrame({
    'b_M0': piv['M0_focal_only'], 'b_M1_SES': piv['M1_plus_SES'],
    'b_M2_acad': piv['M2_plus_academic'], 'b_M3_both': piv['M3_plus_SES_and_academic'],
    'ratio_M3/M0': piv['M3_plus_SES_and_academic'] / piv['M0_focal_only'],
    'pct_abs_change_M3': 100*(piv['M3_plus_SES_and_academic'] - piv['M0_focal_only'])/piv['M0_focal_only'].abs(),
    'sig_M0': sig['M0_focal_only'], 'sig_M3': sig['M3_plus_SES_and_academic']})
shr['att'] = np.where(shr['sig_M3'], 'still significant',
             np.where(~shr['sig_M0'], 'never significant (M0 ns)',
             np.where((~shr['sig_M0'])==False,
                      np.where(piv['M1_plus_SES'].abs() < 1e-12, 'SES focal (n/a)', ''), '')))
shr.to_csv(f'{OUT}/shrinkage_logit_raw.csv')

pd.set_option('display.width', 250); pd.set_option('display.max_columns', 30)
print('=' * 110); print('PRIMARY: LOGIT, raw predictors  (beta / p)')
for f in FOCAL:
    s = prim[prim.focal == f].set_index('model')
    print(f'\n--- focal = {f} ---')
    print(s[['beta','se','z','p','ci_lo','ci_hi','sig','terms']].round(4).to_string())
print('\n=== SHRINKAGE SUMMARY (logit raw) ==='); print(shr.round(4).to_string())
print('\n=== fully-standardised-beta logit variant (beta) ===')
allstd = tab[tab.spec=='logit_allstd'].pivot(index='focal',columns='model',values='beta')
print(allstd.round(4).to_string())
print('\n=== cross-specification unadjusted (M0) vs fully adjusted (M3) betas ===')
w = tab[tab.model.isin(['M0_focal_only','M3_plus_SES_and_academic'])].pivot_table(
        index=['focal','spec'], columns='model', values='beta')
w['shrink_ratio'] = w['M3_plus_SES_and_academic']/w['M0_focal_only']
print(w.round(4).to_string())
