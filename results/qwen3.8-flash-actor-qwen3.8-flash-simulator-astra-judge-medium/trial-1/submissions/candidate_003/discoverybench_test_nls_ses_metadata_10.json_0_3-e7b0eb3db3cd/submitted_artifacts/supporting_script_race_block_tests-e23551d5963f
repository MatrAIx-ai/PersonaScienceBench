import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
df=pd.read_csv('data/nls_ses_processed.csv',index_col=0)
y=df['BA DEGREE COMPLETED'].astype(int).to_numpy(); zz=lambda v:(np.asarray(v,float)-np.mean(v))/np.std(v)
R=df.SAMPLE_RACE.values
V={'Female':np.asarray(df.SAMPLE_SEX=='Female',float),'Black':np.asarray(R=='Black',float),
   'Hispanic':np.asarray(R=='Hispanic',float),'FAMSZ':df['FAMILY SIZE OF SAMPLE'].to_numpy(float),
   'SES':df['SES'].to_numpy(float),'ABILITY_z':zz(df['ABILITY: COMPOSITE OF ASVAB SCORE']),
   'PERCENT_z':zz(df['PERCENTILE IN CLASS'])}
NULL=-2*sm.Logit(y,np.ones((len(y),1))).fit(disp=0).llf
def ll(s): return sm.Logit(y,sm.add_constant(np.column_stack([V[c] for c in s]),prepend=True)).fit(disp=0,maxiter=300).llf
RACE=['Black','Hispanic']
print('=== 2-df SAMPLE_RACE block: LR test across nested specifications (reference-category free) ===')
specs=[('race only (unadjusted M0)',RACE,[]),
       ('race + SES',RACE,['SES']),
       ('race + SES + FAMILY SIZE (approved M1)',RACE,['SES','FAMSZ']),
       ('race + ABILITY only',RACE,['ABILITY_z']),
       ('race + PERCENTILE only',RACE,['PERCENT_z']),
       ('race + ACADEMIC (both, = question model)',RACE,['SES','ABILITY_z','PERCENT_z']),
       ('race + ABILITY + SES',RACE,['SES','ABILITY_z']),
       ('race + PERCENTILE + SES',RACE,['SES','PERCENT_z']),
       ('race + SES + ACADEMIC + FAMSZ (approved M3)',RACE,['SES','ABILITY_z','PERCENT_z','FAMSZ'])]
rows=[]
for lab,blk,add in specs:
    red=[c for c in add if c not in blk]
    chi=-2*(ll(red)-ll(blk+red)) if red else NULL+2*ll(blk)
    p=stats.chi2.sf(chi,2)
    rows.append(dict(specification=lab,LR_chi2=chi,df=2,p=p,
                     verdict='SIGNIFICANT' if p<0.05 else 'not significant'))
    print(f'  {lab:42s} LR chi2(2)={chi:8.2f}  p={p:.3e}  -> {rows[-1]["verdict"]}')
pd.DataFrame(rows).to_csv('output/race_block_tests.csv',index=False)
print('\n=== SAMPLE_SEX 1-df block across the same sequence ===')
for lab,add in [('sex only (unadjusted)',[]),('sex + SES',['SES']),('sex + ACADEMIC',['ABILITY_z','PERCENT_z']),
                ('sex + SES + ACADEMIC',['SES','ABILITY_z','PERCENT_z']),
                ('sex + SES + ACADEMIC + FAMSZ',['SES','ABILITY_z','PERCENT_z','FAMSZ'])]:
    red=[c for c in add if c!='Female']
    chi=-2*(ll(red)-ll(['Female']+red)) if red else NULL+2*ll(['Female'])
    print(f'  {lab:32s} LR chi2(1)={chi:7.2f}  p={stats.chi2.sf(chi,1):.4f}')
print('\n=== mean of mediators by race (why academic rank absorbs the gap) ===')
print(df.groupby('SAMPLE_RACE')[['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS',
      'FAMILY SIZE OF SAMPLE','BA DEGREE COMPLETED']].agg(['mean','size']).round(3).to_string())
