import pandas as pd, numpy as np
pd.set_option('display.width', 200)

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
print("SHAPE:", df.shape)
print("\nCOLUMNS / DTYPES:\n", df.dtypes)
print("\n--- missing values per column ---")
miss = df.isna().sum()
print(pd.DataFrame({'n_missing': miss, 'pct_missing': (miss/len(df)*100).round(2)}))
print("total rows with any missing:", int(df.isna().any(axis=1).sum()))

print("\n--- one row per respondent? ---")
print("n rows:", len(df), "| unique CASE ID:", df['CASE ID'].nunique())
print("duplicate CASE ID rows:", int(df['CASE ID'].duplicated().sum()))

print("\n--- SAMPLE_RACE ---")
print(df['SAMPLE_RACE'].value_counts(dropna=False))
print((df['SAMPLE_RACE'].value_counts(dropna=False)/len(df)*100).round(2))
print("\n--- SAMPLE_SEX ---")
print(df['SAMPLE_SEX'].value_counts(dropna=False))
print((df['SAMPLE_SEX'].value_counts(dropna=False)/len(df)*100).round(2))
print("\n--- BA DEGREE COMPLETED (raw values as stored) ---")
print(df['BA DEGREE COMPLETED'].value_counts(dropna=False))
print("\n--- race x sex counts ---")
print(pd.crosstab(df['SAMPLE_RACE'], df['SAMPLE_SEX'], dropna=False, margins=True))

num = ['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE','BA DEGREE COMPLETED']
print("\n--- numeric summaries ---")
print(df[num].describe(percentiles=[.01,.05,.25,.5,.75,.95,.99]).T)
print("\nmin/max check:")
print(df[num].min())
print(df[num].max())
print("\nPERCENTILE IN CLASS: values outside [0,100]:", int(((df['PERCENTILE IN CLASS']<0)|(df['PERCENTILE IN CLASS']>100)).sum()))

print("\n--- missing by race (rows with any missing) ---")
print(df.assign(miss=df.isna().any(axis=1)).groupby('SAMPLE_RACE', dropna=False)['miss'].agg(['size','sum']))

print("\n--- BA DEGREE COMPLETED raw cross-tab: race x BA (counts) ---")
print(pd.crosstab(df['SAMPLE_RACE'], df['BA DEGREE COMPLETED'], dropna=False, margins=True))
print("\nrow % (completion rate per race, raw incl. missing denominator):")
print((pd.crosstab(df['SAMPLE_RACE'], df['BA DEGREE COMPLETED'], dropna=False, normalize='index')*100).round(2))
print("\n--- SES by race (raw) ---")
print(df.groupby('SAMPLE_RACE')['SES'].describe().round(3))
print("\n--- ABILITY by race (raw) ---")
print(df.groupby('SAMPLE_RACE')['ABILITY: COMPOSITE OF ASVAB SCORE'].describe().round(1))
print("\n--- PERCENTILE IN CLASS by race (raw) ---")
print(df.groupby('SAMPLE_RACE')['PERCENTILE IN CLASS'].describe().round(2))
print("\n--- sex x BA counts ---")
print(pd.crosstab(df['SAMPLE_SEX'], df['BA DEGREE COMPLETED'], dropna=False, margins=True))

print("\n--- correlations among numeric complete cases ---")
print(df[['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE']].corr().round(3))

print("\n--- exact duplicate rows (all columns):", int(df.duplicated().sum()))
