import pandas as pd, numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 50)
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
num=['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE']
d = df[num].describe(percentiles=[.05,.25,.5,.75,.95]).T
d['skew']=df[num].skew().round(3); d['kurtosis']=df[num].kurtosis().round(3)
print("=== FULL describe ==="); print(d.round(3))
print("\n=== SES: standardized? mean/sd overall ===")
print(df['SES'].mean().round(6), df['SES'].std().round(6))
print("=== ABILITY overall mean/sd ===", df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean().round(2), df['ABILITY: COMPOSITE OF ASVAB SCORE'].std().round(2))
print("=== PERCENTILE overall mean/sd ===", df['PERCENTILE IN CLASS'].mean().round(2), df['PERCENTILE IN CLASS'].std().round(2))
print("\n=== FULL correlation matrix ===")
print(df[num].corr().round(3))
print("\n=== SES overlap across race: quantiles ===")
print(df.groupby('SAMPLE_RACE')['SES'].quantile([0,.1,.25,.5,.75,.9,1]).unstack().round(3))
print("\n=== SES quartile (global) x race : completion counts + rate (DESCRIPTIVE ONLY) ===")
df['ses_q']=pd.qcut(df['SES'],4,labels=['Q1_low','Q2','Q3','Q4_high'])
ct=pd.crosstab([df['SAMPLE_RACE'],df['ses_q']],df['BA DEGREE COMPLETED'])
ct['n']=ct.sum(1); ct['pct_true']=(ct[True]/ct['n']*100).round(2)
print(ct)
print("\n=== events per race & EPV budget (236 total events) ===")
ev=df.groupby('SAMPLE_RACE')['BA DEGREE COMPLETED'].sum()
print(ev, "| total events:", int(df['BA DEGREE COMPLETED'].sum()))
print("\n=== ABILITY in units of 100 / sd; SES sd ===")
print("1 sd SES =", df['SES'].std().round(3), "| 1 sd ABILITY =", df['ABILITY: COMPOSITE OF ASVAB SCORE'].std().round(1), "| 1 sd PCT =", df['PERCENTILE IN CLASS'].std().round(2))
print("\n=== SES vs ability/pct collinearity: within-race correlations ===")
print(df.groupby('SAMPLE_RACE')[['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']].corr().round(3))
print("\n=== VIF-style check: R^2 of SES ~ ability+pct (OLS, diagnostic only) ===")
import statsmodels.api as sm
X=sm.add_constant(df[['ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']])
print("R2:", round(sm.OLS(df['SES'],X).fit().rsquared,4))
X2=sm.add_constant(df[['ABILITY: COMPOSITE OF ASVAB SCORE']])
print("R2 of PCT ~ ability:", round(sm.OLS(df['PERCENTILE IN CLASS'],X2).fit().rsquared,4))
print("R2 of ABILITY ~ pct:", round(sm.OLS(df['ABILITY: COMPOSITE OF ASVAB SCORE'],sm.add_constant(df['PERCENTILE IN CLASS'])).fit().rsquared,4))
