import pandas as pd, numpy as np
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
print("exact zeros: SES", (df.SES==0).sum(), "| PCT", (df['PERCENTILE IN CLASS']==0).sum(), "| ABILITY", (df['ABILITY: COMPOSITE OF ASVAB SCORE']==0).sum())
print("values >=99 in PCT:", (df['PERCENTILE IN CLASS']>=99).sum(), "| values <=1 in PCT:", (df['PERCENTILE IN CLASS']<=1).sum())
print("ABILITY multiples of 10:", (df['ABILITY: COMPOSITE OF ASVAB SCORE']%10==0).mean().round(3))
print("\ncompletion rate overall: %.3f%%" % (df['BA DEGREE COMPLETED'].mean()*100))
print("\nability/pct by sex (raw means):")
print(df.groupby('SAMPLE_SEX')[['ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','SES']].mean().round(2))
print("\nrace x SES-tertile counts (cell sizes only, for power planning):")
print(pd.crosstab(df.SAMPLE_RACE, pd.qcut(df.SES,3,labels=['low','mid','high'])))
print("\ncases with SES>1.5 & non-White (thin cells check):")
sub=df[(df.SES>1.5)]
print(sub.SAMPLE_RACE.value_counts(), "| of which BA:", int(sub['BA DEGREE COMPLETED'].sum()))
print("\nn rows in top SES decile by race:")
print(df.groupby(df.SAMPLE_RACE).apply(lambda g: int((g.SES>=df.SES.quantile(.9)).sum()), include_groups=False))
