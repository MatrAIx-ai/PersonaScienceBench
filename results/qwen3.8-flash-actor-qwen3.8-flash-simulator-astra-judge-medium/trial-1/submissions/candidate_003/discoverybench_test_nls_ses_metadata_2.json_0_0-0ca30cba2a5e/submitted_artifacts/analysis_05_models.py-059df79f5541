"""M0-M4 fits, interaction LRT/Wald+Holm, functional-form LRTs (quadratic + RCS), VIFs, relevel, pairwise."""
import numpy as np, pandas as pd, sys, json
sys.path.insert(0,'/workspace/analysis')
from lib_fit import logit_newton, firth_fit, rcs_basis, holm
from scipy import stats
from statsmodels.stats.outliers_influence import variance_inflation_factor
import statsmodels.api as sm
pd.set_option('display.width',230); pd.set_option('display.max_columns',40)
OUT='/workspace/results/'
df=pd.read_csv('/workspace/data/nls_ses_processed.csv',index_col=0)
df['y']=df['BA DEGREE COMPLETED'].astype(int)
sd=lambda s: s.std(ddof=0)
df['zses']=(df.SES-df.SES.mean())/sd(df.SES)
df['zab']=(df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/sd(df['ABILITY: COMPOSITE OF ASVAB SCORE'])
df['zpct']=(df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/sd(df['PERCENTILE IN CLASS'])
df['male']=(df.SAMPLE_SEX=='Male').astype(int)
for r in ['Black','Hispanic']: df['r_'+r.lower()]=(df.SAMPLE_RACE==r).astype(float)
N=len(df); EV=int(df.y.sum()); y=df.y.values.astype(float)
print(f"N={N}  events={EV} ({EV/N*100:.2f}%)   SDs used: SES={sd(df.SES):.6f} ABILITY={sd(df['ABILITY: COMPOSITE OF ASVAB SCORE']):.4f} PCT={sd(df['PERCENTILE IN CLASS']):.4f}")
print("\nobserved z(SES) range by race:\n", df.groupby('SAMPLE_RACE')['zses'].agg(['min','max','count']).round(3).to_string())

z=df.zses.values; blk=df.r_black.values; his=df.r_hispanic.values; ml=df.male.values.astype(float); one=np.ones(N)
def fit(name, cols):
    names=list(cols); X=np.column_stack([cols[c] for c in names])
    r=logit_newton(X,y)
    t=pd.DataFrame({'model':name,'term':names,'beta':r['beta'],'se':r['se']})
    t['z']=t.beta/t.se; t['p']=2*stats.norm.sf(np.abs(t.z)); t['OR']=np.exp(t.beta)
    t['OR_lo95']=np.exp(t.beta-1.96*t.se); t['OR_hi95']=np.exp(t.beta+1.96*t.se)
    t['df_model']=len(names)-1; t['loglik']=r['ll']; t['convergence']=r['status']
    return dict(name=name,res=r,X=X,names=names,ll=r['ll'],k=len(names),table=t)
M={}
M['M0_unadjusted']=fit('M0_unadjusted',{'const':one,'zses':z,'Black':blk,'Hispanic':his})
M['M1a_main_race_SES_sex']=fit('M1a_main_race_SES_sex',{'const':one,'zses':z,'Black':blk,'Hispanic':his,'male':ml})
M['M1b_SES_sex_only']=fit('M1b_SES_sex_only',{'const':one,'zses':z,'male':ml})
M['M2_PRIMARY']=fit('M2_PRIMARY',{'const':one,'zses':z,'Black':blk,'Hispanic':his,'zses_x_Black':z*blk,'zses_x_Hispanic':z*his,'male':ml})
M['M3_sens_ability_percentile']=fit('M3_sens_ability_percentile',{'const':one,'zses':z,'Black':blk,'Hispanic':his,'zses_x_Black':z*blk,'zses_x_Hispanic':z*his,'zab':df.zab.values,'zpct':df.zpct.values,'male':ml})
M['M3a_sens_ability_only']=fit('M3a_sens_ability_only',{'const':one,'zses':z,'Black':blk,'Hispanic':his,'zses_x_Black':z*blk,'zses_x_Hispanic':z*his,'zab':df.zab.values,'male':ml})
M['M3b_sens_percentile_only']=fit('M3b_sens_percentile_only',{'const':one,'zses':z,'Black':blk,'Hispanic':his,'zses_x_Black':z*blk,'zses_x_Hispanic':z*his,'zpct':df.zpct.values,'male':ml})
for k,v in M.items():
    print(f"\n=== {k}   logLik={v['ll']:.4f}  params={v['k']}  conv={v['res']['status']}")
    print(v['table'][['term','beta','se','z','p','OR','OR_lo95','OR_hi95']].round(4).to_string(index=False))

# ---------- functional form (nested in / extending M2) ----------
z2=z**2
M['FF1_quad_shared']=fit('FF1_quad_shared',{'const':one,'zses':z,'Black':blk,'Hispanic':his,'zses_x_Black':z*blk,'zses_x_Hispanic':z*his,'z2':z2,'male':ml})
M['FF2_quad_by_race']=fit('FF2_quad_by_race',{'const':one,'zses':z,'Black':blk,'Hispanic':his,'zses_x_Black':z*blk,'zses_x_Hispanic':z*his,'z2':z2,'z2_x_Black':z2*blk,'z2_x_Hispanic':z2*his,'male':ml})
KNOTS=np.percentile(z,[5,35,65,95]); B=rcs_basis(z,KNOTS); print(f"\nRCS knots on z(SES): {np.round(KNOTS,4)}")
bc={'const':one,'Black':blk,'Hispanic':his,'male':ml}
rcols={f'sp{i+1}':B[:,i] for i in range(B.shape[1])}
M['FF3_rcs_by_race']=fit('FF3_rcs_by_race',{**bc,**rcols,**{f'sp{i+1}_x_Black':B[:,i]*blk for i in range(3)},**{f'sp{i+1}_x_Hispanic':B[:,i]*his for i in range(3)}})
M['FF5_rcs_no_interaction']=fit('FF5_rcs_no_interaction',{**bc,**rcols})
M['FF6_rcs_linear_plus_2nonlin_shared']=fit('FF6_rcs_linear_plus_2nonlin_shared',{**bc,**rcols,'zses_x_Black':z*blk,'zses_x_Hispanic':z*his})
def lrt(a,b):
    d=2*(M[b]['ll']-M[a]['ll']); k=M[b]['k']-M[a]['k']; return d,k,(stats.chi2.sf(d,k) if k>0 else np.nan)
rows=[dict(test=t, restricted=a, full=b) for t,a,b in [
 ('race x z(SES) interaction BLOCK (headline test)','M1a_main_race_SES_sex','M2_PRIMARY'),
 ('race main effects','M1b_SES_sex_only','M1a_main_race_SES_sex'),
 ('add ability+percentile (mediator adjustment)','M2_PRIMARY','M3_sens_ability_percentile'),
 ('FUNCTIONAL FORM: shared z(SES)^2','M2_PRIMARY','FF1_quad_shared'),
 ('FUNCTIONAL FORM: z(SES)^2 x race','M2_PRIMARY','FF2_quad_by_race'),
 ('FUNCTIONAL FORM: RCS(4 knots) x race vs linear x race','M2_PRIMARY','FF3_rcs_by_race'),
 ('FUNCTIONAL FORM: shared RCS nonlinearity given linear x race','M2_PRIMARY','FF6_rcs_linear_plus_2nonlin_shared'),
 ('MODIFICATION under flexible shape: linear+RCSxrace vs RCSxrace','FF6_rcs_linear_plus_2nonlin_shared','FF3_rcs_by_race'),
]]
tests=pd.DataFrame([dict(r, chi2=lrt(r['restricted'],r['full'])[0], df=lrt(r['restricted'],r['full'])[1], p=lrt(r['restricted'],r['full'])[2]) for r in rows])
tests['verdict']=np.where(tests.p<0.05,'REJECT linearity/nil at 5%','not rejected at 5%')
print("\n=== LIKELIHOOD-RATIO TESTS ===\n",tests.round(4).to_string(index=False))
for k in ['FF1_quad_shared','FF2_quad_by_race','FF3_rcs_by_race']:
    print(f"\n--- {k} nonlinear terms ---")
    print(M[k]['table'].query("term.str.contains('z2|sp')",engine='python')[['term','beta','se','z','p']].round(4).to_string(index=False))

# ---------- Wald + Holm on the two interaction terms in M2 ----------
t2=M['M2_PRIMARY']['table']
inter=t2[t2.term.isin(['zses_x_Black','zses_x_Hispanic'])].copy(); inter['p_holm']=holm(inter.p.values)
print("\n=== Wald tests for interaction terms in M2 (Holm over 2 contrasts) ===\n",inter[['term','beta','se','z','p','p_holm','OR','OR_lo95','OR_hi95']].round(4).to_string(index=False))

# ---------- race-specific SES slopes + pairwise contrasts (delta method) ----------
b=M['M2_PRIMARY']['res']['beta']; V=M['M2_PRIMARY']['res']['cov']; nm=M['M2_PRIMARY']['names']
def sv(race):
    v=np.zeros(len(nm)); v[nm.index('zses')]=1
    if race!='White': v[nm.index('zses_x_'+race)]=1
    return v
sl=pd.DataFrame([{'group':r,'slope_logodds_perSD':sv(r)@b,'se':np.sqrt(sv(r)@V@sv(r))} for r in ['White','Black','Hispanic']])
sl['z']=sl.slope_logodds_perSD/sl.se; sl['p']=2*stats.norm.sf(abs(sl.z)); sl['OR_perSD']=np.exp(sl.slope_logodds_perSD)
sl['OR_lo95']=np.exp(sl.slope_logodds_perSD-1.96*sl.se); sl['OR_hi95']=np.exp(sl.slope_logodds_perSD+1.96*sl.se)
print("\n=== M2 race-specific SES slope (log-odds per 1 SD SES) ===\n",sl.round(4).to_string(index=False))
pr=[]
for a,c in [('Black','White'),('Hispanic','White'),('Hispanic','Black')]:
    v=sv(a)-sv(c); d=v@b; s=np.sqrt(v@V@v)
    pr.append(dict(contrast=f"{a} vs {c}",diff_logodps_perSD=d,se=s,ratio_of_ORs=np.exp(d),lo=np.exp(d-1.96*s),hi=np.exp(d+1.96*s),z=d/s,p=2*stats.norm.sf(abs(d/s))))
pr=pd.DataFrame(pr); pr['p_holm']=holm(pr.p.values)
print("\n=== Pairwise interaction contrasts (reference-choice invariant) ===\n",pr.round(4).to_string(index=False))

# ---------- relevelled runs ----------
for ref in ['Black','Hispanic']:
    others=[r for r in ['White','Black','Hispanic'] if r!=ref]
    dd={r:(df.SAMPLE_RACE==r).astype(float).values for r in others}
    mm=fit(f'M2_ref_{ref}',{'const':one,'zses':z,**{('d_'+r):dd[r] for r in others},**{f'zses_x_{r}':z*dd[r] for r in others},'male':ml})
    print(f"\n=== M2 relevelled, reference = {ref} ===\n", mm['table'][['term','beta','se','z','p','OR','OR_lo95','OR_hi95']].round(4).to_string(index=False))
    M[mm['name']]=mm

# ---------- M4 race-stratified (MLE) ----------
print("\n=== M4 race-stratified logistic: y ~ z(SES) + male (MLE) ===")
strows=[]
for r in ['White','Black','Hispanic']:
    g=df[df.SAMPLE_RACE==r]; X=np.column_stack([np.ones(len(g)),g.zses.values,g.male.values.astype(float)]); yy=g.y.values.astype(float)
    rr=logit_newton(X,yy)
    strows.append(dict(group=r,n=len(g),events=int(yy.sum()),term='zses',beta=rr['beta'][1],se=rr['se'][1],
                       OR=np.exp(rr['beta'][1]),lo=np.exp(rr['beta'][1]-1.96*rr['se'][1]),hi=np.exp(rr['beta'][1]+1.96*rr['se'][1]),
                       p=2*stats.norm.sf(abs(rr['beta'][1]/rr['se'][1])),convergence=rr['status']))
    print(f"  {r:8s} n={len(g):5d} ev={int(yy.sum()):3d} beta={rr['beta'][1]: .4f} se={rr['se'][1]:.4f} OR={np.exp(rr['beta'][1]):.3f} [{np.exp(rr['beta'][1]-1.96*rr['se'][1]):.3f},{np.exp(rr['beta'][1]+1.96*rr['se'][1]):.3f}] conv={rr['status']}")
strat=pd.DataFrame(strows)

# ---------- VIFs + Poisson supplementary ----------
def viftab(model):
    Xd=M[model]['X']; keep=[i for i,c in enumerate(M[model]['names']) if c!='const']
    A=Xd[:,keep]
    return pd.DataFrame({'model':model,'term':[M[model]['names'][i] for i in keep],'VIF':[variance_inflation_factor(A,i) for i in range(A.shape[1])]})
vifs=pd.concat([viftab('M2_PRIMARY'),viftab('M3_sens_ability_percentile')])
print("\n=== VIFs (within-model, outcome not used) ===\n",vifs.round(3).to_string(index=False))
print("\n=== predictor correlations (outcome not involved) ===\n",df[['zses','zab','zpct','male']].corr().round(3).to_string())
po=sm.GLM(y,M['M2_PRIMARY']['X'],family=sm.families.Poisson()).fit(cov_type='HC1')
pp=pd.DataFrame({'term':M['M2_PRIMARY']['names'],'rate_ratio_perSD':np.exp(po.params),'lo':np.exp(po.cov_params()[:0].index.map(lambda i:0)) if False else np.nan})
ci=po.conf_int(); pp['lo']=np.exp(ci[:,0]); pp['hi']=np.exp(ci[:,1]); pp['p']=po.pvalues
print("\n=== SUPPLEMENTARY Poisson GLM (robust SE): multiplicative modification on a rate-ratio scale ===\n",pp.round(4).to_string(index=False))

pd.concat([M[k]['table'] for k in M]).to_csv(OUT+'coefficients_all_models.csv',index=False)
tests.to_csv(OUT+'lrt_tests.csv',index=False); inter.to_csv(OUT+'wald_interaction_M2.csv',index=False)
sl.to_csv(OUT+'race_specific_slopes_M2.csv',index=False); pr.to_csv(OUT+'pairwise_contrasts_M2.csv',index=False)
strat.to_csv(OUT+'race_stratified_MLE.csv',index=False); vifs.to_csv(OUT+'vif.csv',index=False); pp.to_csv(OUT+'poisson_supplementary.csv',index=False)
json.dump(dict(cols=M['M2_PRIMARY']['names'],n=N,events=EV,ses_sd=float(sd(df.SES)),abil_sd=float(sd(df['ABILITY: COMPOSITE OF ASVAB SCORE'])),
               pct_sd=float(sd(df['PERCENTILE IN CLASS'])),ses_mean=float(df.SES.mean()),abil_mean=float(df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()),
               pct_mean=float(df['PERCENTILE IN CLASS'].mean()),knots=list(map(float,KNOTS))),open(OUT+'meta.json','w'),indent=1)
print("\n[ok] saved to /workspace/results/")
