"""Race-specific marginal effect of SES on the predicted-probability scale (g-computation),
case-bootstrap CIs, additive-scale difference-in-RD, Firth penalized sensitivity, empirical bins."""
import numpy as np, pandas as pd, sys, json
sys.path.insert(0,'/workspace/analysis'); from lib_fit import logit_newton, firth_fit
from scipy import stats
pd.set_option('display.width',240); pd.set_option('display.max_columns',40)
OUT='/workspace/results/'
df=pd.read_csv('/workspace/data/nls_ses_processed.csv',index_col=0)
df['y']=df['BA DEGREE COMPLETED'].astype(int)
sd=lambda s:s.std(ddof=0)
df['zses']=(df.SES-df.SES.mean())/sd(df.SES); df['male']=(df.SAMPLE_SEX=='Male').astype(float)
for r in ['Black','Hispanic']: df['r_'+r.lower()]=(df.SAMPLE_RACE==r).astype(float)
y=df.y.values.astype(float); male=df.male.values; N=len(df)
expit=lambda e:1/(1+np.exp(-e))
def design(z,black,hisp,malev):
    z=np.atleast_1d(np.asarray(z,float)); n=len(z)
    b=np.full(n,black) if np.isscalar(black) else black; h=np.full(n,hisp) if np.isscalar(hisp) else hisp
    return np.column_stack([np.ones(n),z,b,h,z*b,z*h,malev])
DES=['const','zses','Black','Hispanic','zses_x_Black','zses_x_Hispanic','male']
X=design(df.zses.values,df.r_black.values,df.r_hispanic.values,male)
mle=logit_newton(X,y); B0=mle['beta']; V0=mle['cov']
RACES={'White':(0.,0.),'Black':(1.,0.),'Hispanic':(0.,1.)}

def pred_curves(betas, race, zs):
    """g-computed mean P(BA) over the observed sample, for each beta row x each z level.
    Race is set to the group's value for everyone; sex is kept at its observed sample values."""
    bk,hp=RACES[race]; out=np.empty((len(betas),len(zs)))
    for j,s in enumerate(zs):
        Xd=design(np.full(N,s),bk,hp,male)          # N x 7
        out[:,j]=(expit(Xd@np.asarray(betas).T).mean(axis=0))
    return out

LEVELS=np.array([-2.0,-1.5,-1.0,-0.5,0.0,0.5,1.0,1.5,2.0])
def quantities(beta):
    bk,hp=None,None; d={}
    for race in RACES:
        p=pred_curves([beta],race,[-0.5,0.5,-1.0,1.0,0.0])[0]
        d['P_'+race]=p[4]; d['Pm05_'+race]=p[0]; d['Pp05_'+race]=p[1]; d['Pm1_'+race]=p[2]; d['Pp1_'+race]=p[3]
        d['RD_'+race]=p[1]-p[0]; d['RR_'+race]=p[1]/p[0]
        d['RDwide_'+race]=p[3]-p[2]; d['RRwide_'+race]=p[3]/p[2]
    for a,b in [('Black','White'),('Hispanic','White'),('Hispanic','Black')]:
        d[f'diffRD_{a}v{b}']=d['RD_'+a]-d['RD_'+b]; d[f'ratioRD_{a}v{b}']=d['RD_'+a]/d['RD_'+b]
        d[f'ratioRR_{a}v{b}']=d['RR_'+a]/d['RR_'+b]
    d['ORperSD_White']=np.exp(beta[1]); d['ORperSD_Black']=np.exp(beta[1]+beta[4]); d['ORperSD_Hispanic']=np.exp(beta[1]+beta[5])
    return d
point=quantities(B0)

# -------- case bootstrap (store betas) --------
rng=np.random.default_rng(20261023); BREQ=2000; betas=[]; failed=0
for _ in range(BREQ):
    idx=rng.integers(0,N,N); yb=y[idx]
    if yb.sum()<20: failed+=1; continue
    r=logit_newton(X[idx],yb,maxit=60)
    if (not np.all(np.isfinite(r['beta']))) or np.max(np.abs(r['beta']))>30: failed+=1; continue
    betas.append(r['beta'])
betas=np.array(betas); print(f"bootstrap requested={BREQ} used={len(betas)} discarded={failed}")
QU=pd.DataFrame([quantities(b) for b in betas])
def row(k, desc, null=None):
    lo,hi=np.nanpercentile(QU[k],[2.5,97.5]); v=point[k]
    p=np.nan
    if null is not None:
        pv=2*min((QU[k]<=null).mean(),(QU[k]>=null).mean()); p=min(1.0,max(pv,1.0/len(QU)))
    return dict(quantity=k,description=desc,estimate=v,boot_mean=QU[k].mean(),boot_se=QU[k].std(ddof=1),
                ci95_lo=lo,ci95_hi=hi,boot_p_vs_null=p)
rows=[row('P_'+r,'predicted P(BA) at mean SES',None) for r in RACES]
rows+=[row('Pm05_'+r,'P(BA) at SES=-0.5SD',None) for r in RACES]+[row('Pp05_'+r,'P(BA) at SES=+0.5SD',None) for r in RACES]
rows+=[row('RD_'+r,'RD: P(+0.5SD)-P(-0.5SD)',0) for r in RACES]
rows+=[row('RR_'+r,'RR: P(+0.5SD)/P(-0.5SD)',1) for r in RACES]
rows+=[row('RDwide_'+r,'RD: P(+1SD)-P(-1SD)',0) for r in RACES]
rows+=[row('RRwide_'+r,'RR: P(+1SD)/P(-1SD)',1) for r in RACES]
for a,b in [('Black','White'),('Hispanic','White'),('Hispanic','Black')]:
    rows+=[row(f'diffRD_{a}v{b}',f'DIFF-IN-RD (additive modification): RD_{a}-RD_{b}',0),
           row(f'ratioRD_{a}v{b}',f'ratio of RDs {a}/{b}',1), row(f'ratioRR_{a}v{b}',f'ratio of RRs {a}/{b}',1)]
for r in RACES: rows.append(row('ORperSD_'+r,f'M2 adjusted OR per 1 SD SES, {r}',1))
marg=pd.DataFrame(rows)
print("\n=== M2 RACE-SPECIFIC MARGINAL EFFECT OF SES (predicted-probability scale, g-computation) ===")
print(marg[marg.quantity.str.match(r'^(P_|Pm05_|Pp05_|RD_|RR_|RDwide_|RRwide_)')].round(6).to_string(index=False))
print("\n=== ADDITIVE-SCALE MODIFICATION (difference-in-RD / ratios) and per-SD ORs ===")
print(marg[marg.quantity.str.match(r'^(diffRD|ratioRD|ratioRR|ORperSD)')].round(6).to_string(index=False))

# -------- predicted-probability grid + 95% bands, clipped to each race's observed range --------
grid=pd.concat([pd.DataFrame(dict(race=r, z_ses=np.round(np.arange(df.loc[df.SAMPLE_RACE==r,'zses'].min(),
          df.loc[df.SAMPLE_RACE==r,'zses'].max(),0.1),2))) for r in RACES],ignore_index=True)
pts=[]
for r in RACES:
    g=grid.loc[grid.race==r,'z_ses'].values
    pc=pred_curves(betas,r,g); pe=pred_curves([B0],r,g)[0]
    lo,hi=np.nanpercentile(pc,[2.5,97.5],axis=0)
    d=pd.DataFrame(dict(race=r,z_ses=g,P_hat=pe,band_lo=lo,band_hi=hi))
    d['raw_SES']=d.z_ses*0.7423404+(-0.0090488)
    d['n_within_0.2SD']= [int(((df.SAMPLE_RACE==r)&(np.abs(df.zses-s)<0.2)).sum()) for s in d.z_ses]
    d['events_within_0.2SD']=[int(df.loc[(df.SAMPLE_RACE==r)&(np.abs(df.zses-s)<0.2),'y'].sum()) for s in d.z_ses]
    q2,q98=df.loc[df.SAMPLE_RACE==r,'zses'].quantile([.02,.98]); d['in_central_96pct_of_race']=d.z_ses.between(q2,q98)
    pts.append(d)
cur=pd.concat(pts,ignore_index=True); cur.to_csv(OUT+'predicted_prob_grid.csv',index=False)
print("\n=== predicted P(BA) at fixed SES points per race (clipped to observed range) ===")
fp=[]
for r in RACES:
    lo_r,hi_r=float(df.loc[df.SAMPLE_RACE==r,'zses'].min()),float(df.loc[df.SAMPLE_RACE==r,'zses'].max())
    q2,q98=df.loc[df.SAMPLE_RACE==r,'zses'].quantile([.02,.98])
    for s in [-1.5,-1.0,-0.5,0.0,0.5,1.0,1.5,2.0]:
        pe=float(pred_curves([B0],r,[s])[0][0]); pc=pred_curves(betas,r,[s])
        lo,hi=np.nanpercentile(pc,[2.5,97.5],axis=0)
        win=np.abs(df.zses-s)<0.2; m=(df.SAMPLE_RACE==r)&win
        fp.append({'race':r,'z_ses':s,'P_hat':pe,'ci_lo':float(lo[0]),'ci_hi':float(hi[0]),
                   'in_observed_range':bool(lo_r<=s<=hi_r),'in_race_central_96pct':bool(q2<=s<=q98),
                   'n_within_0.2SD':int(m.sum()),'events_within_0.2SD':int(df.loc[m,'y'].sum())})
fp=pd.DataFrame(fp); print(fp.round(6).to_string(index=False)); fp.to_csv(OUT+'predicted_prob_fixed_points.csv',index=False)
print("\nNOTE: race-specific observed z(SES) ranges ->", {r:(round(float(df.loc[df.SAMPLE_RACE==r,'zses'].min()),2),round(float(df.loc[df.SAMPLE_RACE==r,'zses'].max()),2)) for r in RACES})

# -------- empirical (model-free) rates within race by within-race SES quintile --------
emp=[]
for r in RACES:
    g=df[df.SAMPLE_RACE==r].copy(); g['q']=pd.qcut(g.zses,5,labels=[1,2,3,4,5])
    for q,gg in g.groupby('q',observed=True):
        k=gg.y.sum(); n=len(gg); ph=k/n; se=np.sqrt(ph*(1-ph)/n)
        emp.append(dict(race=r,within_race_SES_quintile=int(q),n=n,events=int(k),rate=ph,ci_lo=max(0,ph-1.96*se),ci_hi=ph+1.96*se,
                        mean_z_ses=gg.zses.mean()))
emp=pd.DataFrame(emp); print("\n=== MODEL-FREE completion rates by within-race SES quintile ===\n",emp.round(4).to_string(index=False))
emp.to_csv(OUT+'empirical_rates_by_race_quintile.csv',index=False)

# -------- FIRTH penalized sensitivity (raw MLE shown alongside) --------
def tab(beta,se,names,tag,extra=None):
    return pd.DataFrame(dict(model=tag,term=names,beta=beta,se=se,OR=np.exp(beta),
                             lo=np.exp(beta-1.96*se),hi=np.exp(beta+1.96*se),**({'note':extra} if extra else {})))
fr=logit_newton(X,y); ff=firth_fit(X,y)
sv={r:np.array([0,1,0,0,1,0,0][:7] if r=='Black' else ([0,1,0,0,0,1,0] if r=='Hispanic' else [0,1,0,0,0,0,0]),dtype=float) for r in RACES}
fi=[]
fi.append(tab(fr['beta'],fr['se'],DES,'M2_MLE')); fi.append(tab(ff['beta'],ff['se'],DES,'M2_Firth'))
for r,(bk,hp) in RACES.items():
    g=df[df.SAMPLE_RACE==r]; Xs=np.column_stack([np.ones(len(g)),g.zses.values,g.male.values]); ys=g.y.values.astype(float)
    m=logit_newton(Xs,ys); f2=firth_fit(Xs,ys)
    fi.append(tab(m['beta'],m['se'],['const','zses','male'],f'M4_{r}_MLE',f'n={len(g)} ev={int(ys.sum())}'))
    fi.append(tab(f2['beta'],f2['se'],['const','zses','male'],f'M4_{r}_FIRTH',f'n={len(g)} ev={int(ys.sum())}'))
dfi=pd.concat(fi,ignore_index=True)
print("\n=== FIRTH penalized vs raw MLE (M2 joint model and race-stratified models) ===")
print(dfi[dfi.term.str.contains('zses')].round(4).to_string(index=False))
dfi.to_csv(OUT+'firth_sensitivity.csv',index=False)
# Firth-based race-specific ORs and diff-in-RD
bkv=lambda r: RACES[r][0]; hpv=lambda r: RACES[r][1]
frow=[]
for r in RACES:
    for tag,bet,cov in [('M2_MLE',fr['beta'],fr['cov']),('M2_Firth',ff['beta'],ff['cov'])]:
        v=sv[r]; s=float(np.sqrt(v@cov@v)); sl=float(v@bet)
        frow.append(dict(model=tag,race=r,OR_per_SD=np.exp(sl),lo=np.exp(sl-1.96*s),hi=np.exp(sl+1.96*s)))
    frow.append(dict(model='M4_MLE',race=r,OR_per_SD=np.exp(logit_newton(np.column_stack([np.ones((df.SAMPLE_RACE==r).sum()),df.loc[df.SAMPLE_RACE==r,'zses'],df.loc[df.SAMPLE_RACE==r,'male']]),df.loc[df.SAMPLE_RACE==r,'y'].values.astype(float))['beta'][1])))
    frow.append(dict(model='M4_FIRTH',race=r,OR_per_SD=np.exp(firth_fit(np.column_stack([np.ones((df.SAMPLE_RACE==r).sum()),df.loc[df.SAMPLE_RACE==r,'zses'],df.loc[df.SAMPLE_RACE==r,'male']]),df.loc[df.SAMPLE_RACE==r,'y'].values.astype(float))['beta'][1])))
fz=pd.DataFrame(frow); print("\n=== race-specific OR per 1 SD SES across estimators ===\n",fz.round(4).to_string(index=False))
fz.to_csv(OUT+'OR_per_SD_by_estimator.csv',index=False)
# Firth diff-in-RD (rare-event robustness on the probability scale)
def qf(bet):
    d={}
    for r in RACES:
        p=pred_curves([bet],r,[-0.5,0.5])[0]; d['RD_'+r]=p[1]-p[0]; d['RR_'+r]=p[1]/p[0]
    for a,b in [('Black','White'),('Hispanic','White')]:
        d[f'diffRD_{a}v{b}']=d['RD_'+a]-d['RD_'+b]
    return d
cmp=pd.DataFrame([dict(estimator='MLE_bootstrap_mean',**{k:QU[k].mean() for k in ['RD_White','RD_Black','RD_Hispanic','RR_White','RR_Black','RR_Hispanic','diffRD_BlackvWhite','diffRD_HispanicvWhite']}),
                  dict(estimator='MLE_point',**{k:point[k] for k in ['RD_White','RD_Black','RD_Hispanic','RR_White','RR_Black','RR_Hispanic','diffRD_BlackvWhite','diffRD_HispanicvWhite']}),
                  dict(estimator='Firth_joint_M2',**qf(ff['beta']))])
print("\n=== probability-scale modification: MLE vs Firth side by side ===\n",cmp.round(6).to_string(index=False))
cmp.to_csv(OUT+'mle_vs_firth_probabilities.csv',index=False)
marg['interpretation_note']=np.where(marg.quantity.str.startswith('ratioRD'),'UNSTABLE: denominator (RD_White) near zero -> heavy-tailed bootstrap; use difference-in-RD instead','')
marg.to_csv(OUT+'marginal_effects_probability_scale.csv',index=False)
np.save(OUT+'boot_betas.npy',betas); json.dump({'boot_used':int(len(betas)),'boot_failed':int(failed)},open(OUT+'boot_meta.json','w'))
print("\n[ok] saved.")
