"""Hand-built SVG figure: predicted P(BA) vs SES by race (M2), clipped to each race's
observed SES range, with bootstrap bands, model-free quintile points and thin-cell annotation."""
import numpy as np, pandas as pd, sys, json
sys.path.insert(0,'/workspace/analysis'); from lib_fit import logit_newton
OUT='/workspace/results/'
df=pd.read_csv('/workspace/data/nls_ses_processed.csv',index_col=0); df['y']=df['BA DEGREE COMPLETED'].astype(int)
df['zses']=(df.SES-df.SES.mean())/df.SES.std(ddof=0); df['male']=(df.SAMPLE_SEX=='Male').astype(float)
for r in ['Black','Hispanic']: df['r_'+r.lower()]=(df.SAMPLE_RACE==r).astype(float)
betas=np.load(OUT+'boot_betas.npy'); B0=logit_newton(np.column_stack([np.ones(len(df)),df.zses,df.r_black,df.r_hispanic,df.zses*df.r_black,df.zses*df.r_hispanic,df.male]),df.y.values.astype(float))['beta']
expit=lambda e:1/(1+np.exp(-e)); male=df.male.values; N=len(df)
RACES={'White':(0.,0.,'#1f77b4'),'Black':(1.,0.,'#d62728'),'Hispanic':(0.,1.,'#2ca02c')}
def P(b,race,z):
    bk,hp=RACES[race][:2]; X=np.column_stack([np.ones(N),np.full(N,z),np.full(N,bk),np.full(N,hp),np.full(N,z*bk),np.full(N,z*hp),male])
    return np.mean(expit(X@b))
emp=pd.read_csv(OUT+'empirical_rates_by_race_quintile.csv')
XMIN,XMAX=-3.6,3.8; YMAX=0.075
W,H,L,Rm,T,Bm=980,560,90,210,70,120
px=lambda x:L+(x-XMIN)/(XMAX-XMIN)*(W-L-Rm)
py=lambda v:H-Bm-(v/YMAX)*(H-Bm-T)
s=[f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="Helvetica,Arial,sans-serif">',
   f'<rect width="{W}" height="{H}" fill="white"/>',
   f'<text x="{L}" y="26" font-size="17" font-weight="bold">Predicted probability of BA completion vs SES, by race (model M2, total-effect interaction model)</text>',
   f'<text x="{L}" y="46" font-size="12" fill="#444">Solid = within that race\'s central 96% SES range; dotted = within observed range but sparse; shaded = 95% case-bootstrap band; points = model-free rates by within-race SES quintile. N=8,773; events=236.</text>']
# axes + grid
for v in np.arange(0,YMAX+1e-9,0.01):
    s.append(f'<line x1="{px(XMIN)}" y1="{py(v):.1f}" x2="{px(XMAX)}" y2="{py(v):.1f}" stroke="#e8e8e8"/>')
    s.append(f'<text x="{L-8}" y="{py(v)+4:.1f}" font-size="11" text-anchor="end">{v*100:.0f}%</text>')
for x in np.arange(-3,4,0.5):
    s.append(f'<line x1="{px(x):.1f}" y1="{py(0):.1f}" x2="{px(x):.1f}" y2="{py(YMAX):.1f}" stroke="#f2f2f2"/>')
    s.append(f'<line x1="{px(x):.1f}" y1="{py(0):.1f}" x2="{px(x):.1f}" y2="{py(0)+5:.1f}" stroke="#333"/>')
    s.append(f'<text x="{px(x):.1f}" y="{py(0)+18:.1f}" font-size="11" text-anchor="middle">{x:.1f}</text>')
s.append(f'<line x1="{px(XMIN)}" y1="{py(0):.1f}" x2="{px(XMAX)}" y2="{py(0):.1f}" stroke="#333"/>')
s.append(f'<line x1="{px(XMIN)}" y1="{py(0):.1f}" x2="{px(XMIN)}" y2="{py(YMAX):.1f}" stroke="#333"/>')
s.append(f'<text x="{(L+W-Rm)/2:.0f}" y="{H-Bm+42}" font-size="13" text-anchor="middle">SES (z-scored; 1 unit = 0.742 raw SES units)</text>')
s.append(f'<text x="24" y="{(T+H-Bm)/2:.0f}" font-size="13" text-anchor="middle" transform="rotate(-90 24,{(T+H-Bm)/2:.0f})">Predicted P(BA completed)</text>')
legend=[]
for race,(bk,hp,col) in RACES.items():
    z=df.loc[df.SAMPLE_RACE==race,'zses']; lo,hi=float(z.min()),float(z.max()); c2,c98=float(z.quantile(.02)),float(z.quantile(.98))
    gr=np.arange(np.ceil(lo*10)/10, hi, 0.05)
    pe=np.array([P(B0,race,t) for t in gr]); pc=np.array([[P(b,race,t) for t in gr] for b in betas])
    bl=np.percentile(pc,2.5,axis=0); bh=np.percentile(pc,97.5,axis=0)
    band=' '.join(f"{px(t):.1f},{py(min(v,YMAX)):.1f}" for t,v in zip(gr,bh))+' '+' '.join(f"{px(t):.1f},{py(min(v,YMAX)):.1f}" for t,v in zip(gr[::-1],bl[::-1]))
    s.append(f'<polygon points="{band}" fill="{col}" opacity="0.15"/>')
    for mask,dash in [(gr<=c2,'4,3'),((gr>c2)&(gr<c98),'none'),(gr>=c98,'4,3')]:
        pts=[(t,v) for t,v in zip(gr,pe) if mask[np.argmin(np.abs(gr-t))] and v<=YMAX]
        if pts: s.append(f'<polyline points="{" ".join(f"{px(t):.1f},{py(v):.1f}" for t,v in pts)}" fill="none" stroke="{col}" stroke-width="{2.6 if dash=="none" else 1.6}" stroke-dasharray="{dash}"/>')
    top=min(YMAX, max(pe[np.where((gr>=c2)&(gr<=c98))[0]]) if ((gr>=c2)&(gr<=c98)).any() else 0)
    s.append(f'<line x1="{px(c2):.1f}" y1="{py(top)-0:.1f}" x2="{px(c98):.1f}" y2="{py(top)-0:.1f}" stroke="{col}" stroke-width="0" />')
    # model-free points
    e=emp[emp.race==race]
    for _,r0 in e.iterrows():
        cx,cy=px(r0.mean_z_ses),py(min(r0.rate,YMAX))
        s.append(f'<line x1="{cx:.1f}" y1="{py(min(r0.ci_hi,YMAX)):.1f}" x2="{cx:.1f}" y2="{py(r0.ci_lo):.1f}" stroke="{col}" stroke-width="1"/>')
        s.append(f'<circle cx="{cx:.1f}" cy="{cy:.1f}" r="4.2" fill="white" stroke="{col}" stroke-width="2"/>')
    # observed range rug
    for xv,lab in [(lo,'min'),(hi,'max')]:
        s.append(f'<line x1="{px(xv):.1f}" y1="{py(0)-6:.1f}" x2="{px(xv):.1f}" y2="{py(0)+2:.1f}" stroke="{col}" stroke-width="1.6" stroke-dasharray="2,2"/>')
    legend.append((race,col,lo,hi,c2,c98))
    s.append(f'<rect x="{W-Rm+10}" y="{T+len(legend)*0+ [0,26,52][len(legend)-1]}" width="14" height="14" fill="{col}"/>')
    s.append(f'<text x="{W-Rm+30}" y="{T+[0,26,52][len(legend)-1]+12}" font-size="12">{race}</text>')
    s.append(f'<text x="{W-Rm+30}" y="{T+[0,26,52][len(legend)-1]+27}" font-size="10" fill="#555">obs. z range [{lo:.2f}, {hi:.2f}]</text>')
    s.append(f'<text x="{W-Rm+30}" y="{T+[0,26,52][len(legend)-1]+40}" font-size="10" fill="#555">central 96% [{c2:.2f}, {c98:.2f}]</text>')
# thin-cell annotation table
ann=['local n (and completers) within +/-0.2 SD of SES:','']
for t in [1.5,2.0,2.5,3.0]:
    line=f"z={t:+.1f}: "
    for race in RACES:
        m=(df.SAMPLE_RACE==race)&(np.abs(df.zses-t)<0.2)
        line+=f"{race} {int(m.sum())} ({int(df.loc[m,'y'].sum())})  "
    ann.append(line)
for i,a in enumerate(ann):
    s.append(f'<text x="{L}" y="{H-Bm+62+i*14}" font-size="10.5" fill="#333">{a}</text>')
s.append(f'<text x="{L}" y="{H-Bm+62+len(ann)*14+4}" font-size="10.5" fill="#a33">Sparse region: above z=+1.5 there are only 34 Black and 26 Hispanic respondents within +/-0.2 SD; the dotted tails are model-based, not data-dense.</text>')
s.append('</svg>')
open(OUT+'figure_predicted_prob_by_race.svg','w').write('\n'.join(s))
print("wrote", OUT+'figure_predicted_prob_by_race.svg')
# ASCII companion table for the report
tab=[]
for race in RACES:
    row={'race':race}
    for t in [-1.5,-1.0,-0.5,0.0,0.5,1.0,1.5,2.0]:
        row[f'z={t:+.1f}']=f"{P(B0,race,t)*100:.2f}%"
    tab.append(row)
print(pd.DataFrame(tab).to_string(index=False))
