"""M3/M3a/M3b race-specific effects (direct-effect-flavoured sensitivity) + final report assembly."""
import numpy as np, pandas as pd, sys, json
sys.path.insert(0,'/workspace/analysis'); from lib_fit import logit_newton
OUT='/workspace/results/'; pd.set_option('display.width',240); pd.set_option('display.max_columns',40)
df=pd.read_csv('/workspace/data/nls_ses_processed.csv',index_col=0); df['y']=df['BA DEGREE COMPLETED'].astype(int)
sd=lambda s:s.std(ddof=0)
df['zses']=(df.SES-df.SES.mean())/sd(df.SES); df['male']=(df.SAMPLE_SEX=='Male').astype(float)
df['zab']=(df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/sd(df['ABILITY: COMPOSITE OF ASVAB SCORE'])
df['zpct']=(df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/sd(df['PERCENTILE IN CLASS'])
for r in ['Black','Hispanic']: df['r_'+r.lower()]=(df.SAMPLE_RACE==r).astype(float)
y=df.y.values.astype(float); N=len(df); expit=lambda e:1/(1+np.exp(-e))
MODS={'M2_PRIMARY':            ['const','zses','Black','Hispanic','zses_x_Black','zses_x_Hispanic','male'],
      'M3_sens_ability_percentile':['const','zses','Black','Hispanic','zses_x_Black','zses_x_Hispanic','zab','zpct','male'],
      'M3a_sens_ability_only': ['const','zses','Black','Hispanic','zses_x_Black','zses_x_Hispanic','zab','male'],
      'M3b_sens_percentile_only':['const','zses','Black','Hispanic','zses_x_Black','zses_x_Hispanic','zpct','male']}
def X_for(names, zab=None, zpct=None):
    z=df.zses.values; b=df.r_black.values; h=df.r_hispanic.values; m=df.male.values
    pool={'const':np.ones(N),'zses':z,'Black':b,'Hispanic':h,'zses_x_Black':z*b,'zses_x_Hispanic':z*h,
          'male':m,'zab':df.zab.values,'zpct':df.zpct.values}
    return np.column_stack([pool[c] for c in names])
def gc(b,names,race,z, cov_vals):
    i={c:k for k,c in enumerate(names)}
    col=np.zeros(len(names)); col[i['const']]=1; 
    def build(zv,black,hisp):
        M=np.zeros((N,len(names)))
        M[:,i['const']]=1; M[:,i['zses']]=zv; M[:,i['Black']]=black; M[:,i['Hispanic']]=hisp
        M[:,i['zses_x_Black']]=zv*black; M[:,i['zses_x_Hispanic']]=zv*hisp; M[:,i['male']]=df.male.values
        if 'zab' in i: M[:,i['zab']]=df.zab.values
        if 'zpct' in i: M[:,i['zpct']]=df.zpct.values
        return M
    return float(np.mean(expit(build(z,*race)@b))), build
rows=[]
for mod,names in MODS.items():
    X=X_for(names); r=logit_newton(X,y); b=r['beta']; V=r['cov']; i={c:k for k,c in enumerate(names)}
    def build(zv,black,hisp):
        M=np.zeros((N,len(names)))
        M[:,i['const']]=1; M[:,i['zses']]=zv; M[:,i['Black']]=black; M[:,i['Hispanic']]=hisp
        M[:,i['zses_x_Black']]=zv*black; M[:,i['zses_x_Hispanic']]=zv*hisp; M[:,i['male']]=df.male.values
        if 'zab' in i: M[:,i['zab']]=df.zab.values
        if 'zpct' in i: M[:,i['zpct']]=df.zpct.values
        return M
    GR={'White':(0.,0.),'Black':(1.,0.),'Hispanic':(0.,1.)}
    for race,(bk,hp) in GR.items():
        v=np.zeros(len(names)); v[i['zses']]=1
        if race!='White': v[i['zses_x_'+race]]=1
        s=float(v@b); se=float(np.sqrt(v@V@v))
        Xm=build(-0.5,bk,hp); Xp=build(0.5,bk,hp); X1=build(1.0,bk,hp); X_1=build(-1.0,bk,hp); X0=build(0.,bk,hp)
        pm=np.mean(expit(Xm@b)); pp=np.mean(expit(Xp@b)); p1=np.mean(expit(X1@b)); pm1=np.mean(expit(X_1@b)); p0=np.mean(expit(X0@b))
        # delta-method SEs for RD via numerical gradient wrt beta
        def f(bb): return np.mean(expit(Xp@bb))-np.mean(expit(Xm@bb))
        g=np.zeros(len(names)); 
        for k in range(len(names)):
            e=np.zeros(len(names)); e[k]=1e-5; g[k]=(f(b+e)-f(b-e))/2e-5
        rd_se=float(np.sqrt(g@V@g))
        rows.append(dict(model=mod,race=race,OR_per_SD=np.exp(s),OR_lo=np.exp(s-1.96*se),OR_hi=np.exp(s+1.96*se),
                         slope_logodds_perSD=s,slope_se=se,p=2*__import__('scipy.stats',fromlist=['x']).norm.sf(abs(s/se)),
                         P_at_meanSES=p0,RD_p05_m05=pp-pm,RD_se=rd_se,RD_lo=pp-pm-1.96*rd_se,RD_hi=pp-pm+1.96*rd_se,
                         RR_p05_m05=pp/pm,RDwide_p1_m1=p1-pm1,RRwide_p1_m1=p1/pm1))
rs=pd.DataFrame(rows)
print("=== RACE-SPECIFIC SES EFFECTS UNDER EVERY MODEL (M2 primary; M3* condition on ability/percentile = direct-effect-flavoured) ===")
print(rs.round(4).to_string(index=False))
rs.to_csv(OUT+'race_specific_effects_all_models.csv',index=False)
piv=rs.pivot(index='race',columns='model',values='OR_per_SD')
print("\n=== ratio-of-ORs (interaction magnitude) is preserved when mediators are added ===")
for a,bc in [('Black','White'),('Hispanic','White')]:
    line={m:round(float(rs[(rs.race==a)&(rs.model==m)].OR_per_SD.iloc[0]/rs[(rs.race==bc)&(rs.model==m)].OR_per_SD.iloc[0]),3) for m in MODS}
    print(f"  OR({a})/OR({bc}) per race:",line)
print("\n=== within-White SES OR per SD across models (the part that collapses on mediator adjustment) ===")
print({m:round(float(rs[(rs.race=='White')&(rs.model==m)].OR_per_SD.iloc[0]),3) for m in MODS})
