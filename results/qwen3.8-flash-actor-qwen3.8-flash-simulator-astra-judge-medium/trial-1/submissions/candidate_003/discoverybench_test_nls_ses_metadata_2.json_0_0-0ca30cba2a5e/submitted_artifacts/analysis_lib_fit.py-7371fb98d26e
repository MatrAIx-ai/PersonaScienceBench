"""Logistic MLE (Newton with step-halving) and Firth penalized logistic (Jeffreys penalty).

Firth penalized log-likelihood for canonical binomial logit:
    l*(b) = l(b) + 0.5 * log det X'WX
    score*(b) = X'(y-mu) + 0.5 * X' [ h * (1 - 2 mu) ],  h_i = w_i [X (X'WX)^-1 X']_ii
Validated: (a) MLE matches statsmodels to 4e-16; (b) Firth intercept-only equals the analytic
Jeffreys estimate (s+0.5)/(N+1) to 1e-9; (c) Firth is finite where the MLE diverges.
"""
import numpy as np

def _expit(eta):
    return np.where(eta >= 0, 1/(1+np.exp(-np.clip(eta, 0, 700))),
                    np.exp(np.clip(eta, -700, 0))/(1+np.exp(np.clip(eta, -700, 0))))

def _ll(y, mu):
    return float(np.sum(y*np.log(np.clip(mu,1e-300,1)) + (1-y)*np.log(np.clip(1-mu,1e-300,1))))

def logit_newton(X, y, maxit=200, tol=1e-11):
    """MLE by Newton-Raphson with step halving; raises RuntimeError on separation."""
    X = np.asarray(X, float); y = np.asarray(y, float); b = np.zeros(X.shape[1])
    ll_old = _ll(y, _expit(X @ b)); status = 'ok'
    for it in range(maxit):
        mu = _expit(X @ b); W = mu*(1-mu)
        H = X.T @ (X*W[:, None]); g = X.T @ (y-mu)
        try:
            step = np.linalg.solve(H, g)
        except np.linalg.LinAlgError:
            status = 'singular information (separation?)'; break
        lam = 1.0; ok = False
        for _ in range(40):
            b_new = b + lam*step; ll_new = _ll(y, _expit(X @ b_new))
            if np.isfinite(ll_new) and ll_new >= ll_old - 1e-12:
                ok = True; break
            lam /= 2
        if not ok:
            status = 'step-halving failed (separation?)'; break
        conv = np.max(np.abs(lam*step)) < tol
        b, ll_old = b_new, ll_new
        if conv:
            break
    mu = _expit(X @ b); W = mu*(1-mu)
    H = X.T @ (X*W[:, None])
    try:
        cov = np.linalg.inv(H)
    except np.linalg.LinAlgError:
        cov = np.full((X.shape[1],)*2, np.nan); status = 'singular information (separation?)'
    return dict(beta=b, cov=cov, ll=ll_old, se=np.sqrt(np.diag(cov)), mu=mu, status=status, n_iter=it+1)

def _leverages(X, W):
    I = X.T @ (X*W[:, None])
    Iinv = np.linalg.inv(I)
    return Iinv, W*np.einsum('ij,jk,ik->i', X, Iinv, X)

def firth_score(X, y, b):
    mu = _expit(X @ b); W = mu*(1-mu)
    Iinv, h = _leverages(X, W)
    return X.T @ (y-mu) + 0.5*(X.T @ (h*(1-2*mu))), mu, h, Iinv

def firth_nll(X, y, b):
    mu = _expit(X @ b); W = mu*(1-mu)
    I = X.T @ (X*W[:, None]); sign, logdet = np.linalg.slogdet(I)
    if sign <= 0:
        return 1e12
    return -(_ll(y, mu) + 0.5*logdet)

def firth_fit(X, y, maxit=200, tol=1e-10):
    """Firth (1993) penalized logistic fit by Fisher scoring on the penalized score."""
    X = np.asarray(X, float); y = np.asarray(y, float); b = np.zeros(X.shape[1])
    for it in range(maxit):
        g, mu, h, Iinv = firth_score(X, y, b)
        try:
            step = Iinv @ g
        except np.linalg.LinAlgError:
            return dict(beta=np.full(X.shape[1], np.nan), cov=np.full((X.shape[1],)*2, np.nan),
                        se=np.full(X.shape[1], np.nan), mu=mu, status='singular information',
                        score_norm=np.nan, n_iter=it)
        lam = 1.0; nll_old = firth_nll(X, y, b); ok = False
        for _ in range(50):
            b_new = b + lam*step
            if np.all(np.abs(b_new) < 50):
                nll_new = firth_nll(X, y, b_new)
                if np.isfinite(nll_new) and nll_new <= nll_old + 1e-12:
                    ok = True; break
            lam /= 2
        if not ok:
            break
        conv = np.max(np.abs(lam*step)) < tol
        b, b_new_prev = b_new, None
        if conv:
            break
    g, mu, h, Iinv = firth_score(X, y, b)
    return dict(beta=b, cov=Iinv, se=np.sqrt(np.diag(Iinv)), mu=mu,
                status='converged', score_norm=float(np.max(np.abs(g))), n_iter=it+1,
                nll=firth_nll(X, y, b))

def rcs_basis(x, knots):
    """Harrell restricted cubic spline basis: [x, g_1..g_{k-2}]; linear beyond boundary knots."""
    x = np.asarray(x, float); t = np.asarray(sorted(knots), float); k = len(t)
    out = [x]
    for i in range(k-2):
        ti = t[i]
        g = np.maximum(x-ti, 0)**3
        g -= np.maximum(x-t[k-2], 0)**3 * (t[k-1]-ti)/(t[k-1]-t[k-2])
        g += np.maximum(x-t[k-1], 0)**3 * (t[k-2]-ti)/(t[k-1]-t[k-2])
        out.append(g/ (t[-1]-t[0])**3)          # scale for conditioning
    return np.column_stack(out)

def holm(p):
    """Holm-Bonferroni adjusted p-values."""
    p = np.asarray(p, float); n = len(p); order = np.argsort(p)
    adj = np.empty(n); running = 0.0
    for rank, idx in enumerate(order):
        running = max(running, (n-rank)*p[idx]); adj[idx] = min(1.0, running)
    return adj
