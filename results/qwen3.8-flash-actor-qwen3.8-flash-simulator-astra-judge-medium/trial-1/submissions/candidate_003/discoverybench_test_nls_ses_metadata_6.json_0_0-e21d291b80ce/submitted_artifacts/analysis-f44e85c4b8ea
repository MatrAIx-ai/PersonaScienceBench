"""
NLS: At what SES levels is the Black-vs-others BA-completion gap most favourable
to Black students?  (all three framings of "advantage", pre-registered bins)

Primary comparator : Black vs non-Black (White + Hispanic)
Sensitivity        : Black vs White (printed in full)
Primary bins       : pooled SES quintiles, edges from the POOLED distribution
Inferential check  : Firth (1993) penalized logistic (28 Black events total)
Outputs            : /workspace/analysis/out/*.csv  + printed report
"""
import numpy as np, pandas as pd
from scipy import stats
from statsmodels.stats.proportion import proportion_confint, confint_proportions_2indep
import statsmodels.api as sm
import sys
