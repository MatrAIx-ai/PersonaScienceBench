# ---------------------------------------------------------------- framing (ii): gradient
print('\n' + '=' * 100)
print('FRAMING (ii): steepness of the SES gradient in BA rate, within race')
grad = []
for lab, col in [('Black', 'Black'), ('Others', 'Others'), ('White', 'White'), ('Hispanic', None)]:
    s = df if col is None else df[df[col] == 1]
    if lab == 'Hispanic':
        s = df[df.SAMPLE_RACE == 'Hispanic']
    m = firth_logit(sm.add_constant(s[['SESz']].values), s.BA.values)
    orv, lo, hi = np.exp(m['beta'][1]), np.exp(m['beta'][1]-1.645*m['se'][1]), np.exp(m['beta'][1]+1.645*m['se'][1])
    q = s.groupby('q5', observed=True).BA.agg(['size', 'sum'])
    q5, q1 = q['sum'].iloc[-1]/q['size'].iloc[-1], q['sum'].iloc[0]/q['size'].iloc[0]
    grad.append(dict(group=lab, n=len(s), k=int(s.BA.sum()),
                     rate_pct=round(100*s.BA.mean(), 2),
                     OR_per_SD=round(orv, 2), OR_lo=round(lo, 2), OR_hi=round(hi, 2),
                     Q1_pct=round(100*q1, 2), Q5_pct=round(100*q5, 2),
                     Q5_over_Q1=round(q5/q1, 1) if q1 > 0 else np.inf,
                     abs_slope_pp_per_SD=round(100*(q5-q1)/ (QE[-1]-QE[0]), 2)))
G = pd.DataFrame(grad); G.to_csv(f'{OUT}/framing2_gradient.csv', index=False)
