# interaction Black x SESz (Firth), unadjusted and adjusted
def fit(cols, d, note):
    X = sm.add_constant(d[cols].values.astype(float)); m = firth_logit(X, d.BA.values)
    out = []
    for j, c in enumerate(['const'] + cols):
        out.append(dict(model=note, term=c, beta=round(m['beta'][j], 4), se=round(m['se'][j], 4),
                        OR=round(np.exp(m['beta'][j]), 3),
                        OR_lo90=round(np.exp(m['beta'][j]-1.645*m['se'][j]), 3),
                        OR_hi90=round(np.exp(m['beta'][j]+1.645*m['se'][j]), 3),
                        z=round(m['beta'][j]/m['se'][j], 2) if m['se'][j] > 0 else np.nan,
                        p=round(2*(1-stats.norm.cdf(abs(m['beta'][j]/m['se'][j]))), 4) if m['se'][j] > 0 else np.nan))
    return pd.DataFrame(out), m

print('\n' + '=' * 100)
print('INFERENTIAL CHECKS — Firth penalized logistic (primary), events: '
      f"total {df.BA.sum()}, Black {df[df.Black==1].BA.sum()}")
tabs, mods = [], {}
for note, cols, d in [
    ('A_unadj_black', ['Black'], df),
    ('B_unadj_black_ses', ['Black', 'SESz'], df),
    ('C_unadj_interaction', ['Black', 'SESz', 'Black_SESz'], df.assign(Black_SESz=df.Black*df.SESz)),
    ('D_adj_black', ['Black', 'ASVABz', 'RANKz', 'Female', 'SESz'], df),
    ('E_adj_interaction', ['Black', 'ASVABz', 'RANKz', 'Female', 'SESz', 'Black_SESz'],
     df.assign(Black_SESz=df.Black*df.SESz)),
    ('F_unadj_black_excl_bottom_SES', ['Black', 'SESz'], df[df.SESz > -1.0]),
]:
    t, m = fit(cols, d, note); tabs.append(t); mods[note] = m
    print(f'-- {note}: n={m["n"]} events={m["k_events"]} iters={m["iters"]} converged={m["converged"]}')
M = pd.concat(tabs, ignore_index=True); M.to_csv(f'{OUT}/models_firth.csv', index=False)
print(M.to_string(index=False))

# LRT: Black x quintile dummies (Firth penalized ll, df=4), unadjusted and adjusted
def design(d):
    X = pd.DataFrame(index=d.index)
    X['Black'] = d.Black.astype(float)
    for q in ['Q2', 'Q3', 'Q4', 'Q5']:
        X['q_' + q] = (d.q5 == q).astype(float)
        X['Bx' + q] = X['Black'] * X['q_' + q]
    X['ASVABz'] = d.ASVABz; X['RANKz'] = d.RANKz; X['Female'] = d.Female; X['SESz'] = d.SESz
    X['BA'] = d.BA
    return X

DX = design(df)

def lrt(cols_small, cols_big, d, name, dfree):
    _, m0 = fit(cols_small, d, name + '|null')
    _, m1 = fit(cols_big, d, name + '|alt')
    lr = 2 * (m1['penalized_ll'] - m0['penalized_ll'])
    p = 1 - stats.chi2.cdf(max(lr, 0), dfree)
    print(f'{name}: penalized LRT chi2={lr:.2f} df={dfree} p={p:.4f}  (logLik null={m0["penalized_ll"]:.2f} alt={m1["penalized_ll"]:.2f})')
    return dict(test=name, chi2=round(lr, 2), df=dfree, p=round(p, 4))

print('\n' + '=' * 100)
print('LRT for Black x SES heterogeneity (Firth penalized log-likelihoods; approximate)')
L = [lrt(['Black', 'q_Q2', 'q_Q3', 'q_Q4', 'q_Q5'],
         ['Black', 'q_Q2', 'q_Q3', 'q_Q4', 'q_Q5', 'BxQ2', 'BxQ3', 'BxQ4', 'BxQ5'], DX,
         'LRT_black_x_quintile_unadjusted', 4),
     lrt(['Black', 'ASVABz', 'RANKz', 'Female', 'SESz'],
         ['Black', 'ASVABz', 'RANKz', 'Female', 'SESz', 'BxQ2', 'BxQ3', 'BxQ4', 'BxQ5'], DX,
         'LRT_black_x_quintile_adjusted', 4),
     lrt(['Black', 'SESz'], ['Black', 'SESz', 'Black_SESz'],
         df.assign(Black_SESz=df.Black * df.SESz), 'LRT_black_x_SESlinear_unadjusted', 1),
     lrt(['Black', 'ASVABz', 'RANKz', 'Female', 'SESz'],
         ['Black', 'ASVABz', 'RANKz', 'Female', 'SESz', 'Black_SESz'],
         df.assign(Black_SESz=df.Black * df.SESz), 'LRT_black_x_SESlinear_adjusted', 1)]
pd.DataFrame(L).to_csv(f'{OUT}/lrt.csv', index=False)

# ---- crossover SES where Black-vs-others log-odds = 0, with bootstrap 90% CI
SES_SD, SES_MU = df.SES.std(), df.SES.mean()
def crossover(d):
    out = {}
    for nm, cols, dd in [('unadjusted', ['Black', 'SESz', 'Black_SESz'], d.assign(Black_SESz=d.Black * d.SESz)),
                         ('adjusted', ['Black', 'ASVABz', 'RANKz', 'Female', 'SESz', 'Black_SESz'],
                          d.assign(Black_SESz=d.Black * d.SESz))]:
        m = firth_logit(sm.add_constant(dd[cols].values.astype(float)), d.BA.values)
        b0, b1 = m['beta'][1], m['beta'][-1]
        out[nm] = dict(b_black=b0, b_int=b1, z_star=-b0 / b1 if b1 != 0 else np.nan,
                       ses_star=SES_MU + (-b0 / b1) * SES_SD if b1 != 0 else np.nan)
    return out

pt = crossover(df)
rng = np.random.default_rng(20261023)
boot = {k: [] for k in pt}
for i in range(600):
    d = df.iloc[rng.integers(0, len(df), len(df))]
    try:
        c = crossover(d)
        for k in boot:
            if np.isfinite(c[k]['ses_star']):
                boot[k].append(c[k]['ses_star'])
    except Exception:
        pass
print('\n' + '=' * 100)
print('CROSSOVER SES (Black-vs-others log-odds ratio = 1, i.e. parity point), 600 bootstrap reps')
crow = []
for k in pt:
    bs = np.array(boot[k]); lo, hi = np.percentile(bs, [5, 95])
    pct_above = 100 * (df.SES > pt[k]['ses_star']).mean()
    nb = int((df.SES > pt[k]['ses_star']).sum()); nbb = int(((df.SES > pt[k]['ses_star']) & (df.Black == 1)).sum())
    print(f'{k:11s} beta_black={pt[k]["b_black"]:+.3f} beta_int={pt[k]["b_int"]:+.3f} '
          f'-> parity at SES = {pt[k]["ses_star"]:+.3f} (SESz={pt[k]["z_star"]:+.2f}), '
          f'boot 90% CI [{lo:+.2f}, {hi:+.2f}] | above parity point: {pct_above:.1f}% of sample '
          f'({nb} respondents, {nbb} Black)')
    crow.append(dict(model=k, beta_black=round(pt[k]['b_black'], 3), beta_int=round(pt[k]['b_int'], 3),
                     ses_at_parity=round(pt[k]['ses_star'], 3), boot_lo90=round(lo, 3), boot_hi90=round(hi, 3),
                     pct_sample_above=round(pct_above, 1), n_above=nb, n_black_above=nbb))
pd.DataFrame(crow).to_csv(f'{OUT}/crossover.csv', index=False)

# ---- g-computation: adjusted predicted BA rate per quintile, Black vs others (model E)
COEF = dict(zip(['const', 'Black', 'ASVABz', 'RANKz', 'Female', 'SESz', 'Black_SESz'],
                firth_logit(sm.add_constant(df.assign(Black_SESz=df.Black * df.SESz)
                              [['Black', 'ASVABz', 'RANKz', 'Female', 'SESz', 'Black_SESz']]
                              .values.astype(float)), df.BA.values)['beta']))
print('\n' + '=' * 100)
print('ADJUSTED (g-computed) predicted BA rate by quintile: ASVAB/class rank/sex held at the BIN mean '
      '(so Black vs others are compared at like preparation)')
gc = []
for covmode in ['bin_mean', 'overall_mean']:
    for q in ['Q1', 'Q2', 'Q3', 'Q4', 'Q5']:
        d = df[df.q5 == q]
        a_ = d.ASVABz.mean() if covmode == 'bin_mean' else df.ASVABz.mean()
        r_ = d.RANKz.mean() if covmode == 'bin_mean' else df.RANKz.mean()
        f_ = d.Female.mean() if covmode == 'bin_mean' else df.Female.mean()
        row = dict(covariates=covmode, bin=q, mean_SES=round(float(d.SES.mean()), 3), n=len(d))
        for lab, bl in [('Black', 1), ('Others', 0)]:
            eta = (COEF['const'] + COEF['Black'] * bl + COEF['ASVABz'] * a_ + COEF['RANKz'] * r_
                   + COEF['Female'] * f_ + COEF['SESz'] * d.SESz.values + COEF['Black_SESz'] * bl * d.SESz.values)
            row[f'{lab}_adj_pct'] = round(100 * float((1 / (1 + np.exp(-eta))).mean()), 2)
            row[f'{lab}_obs_pct'] = round(100 * float(d.loc[d.Black == bl, 'BA'].mean()), 2)
        row['adj_gap_pp'] = round(row['Black_adj_pct'] - row['Others_adj_pct'], 2)
        row['adj_ratio'] = round(row['Black_adj_pct'] / row['Others_adj_pct'], 3) if row['Others_adj_pct'] else np.nan
        gc.append(row)
GC = pd.DataFrame(gc); GC.to_csv(f'{OUT}/gcomp_adjusted_rates.csv', index=False)
