df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['Black'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['White'] = (df['SAMPLE_RACE'] == 'White').astype(int)
df['Others'] = (df['SAMPLE_RACE'] != 'Black').astype(int)
df['Female'] = (df['SAMPLE_SEX'] == 'Female').astype(int)
for c, n in [('ASVAB', 'ABILITY: COMPOSITE OF ASVAB SCORE'), ('RANK', 'PERCENTILE IN CLASS')]:
    df[c] = df[n]
    df[c + 'z'] = (df[c] - df[c].mean()) / df[c].std()
df['SESz'] = (df['SES'] - df['SES'].mean()) / df['SES'].std()   # SD=0.742382 -> unit-SD scale

# ---------------------------------------------------------------- binning
QE = np.quantile(df['SES'], [0, .2, .4, .6, .8, 1.0])
TE = np.quantile(df['SES'], [0, 1/3, 2/3, 1.0])
FE = [-np.inf, -1.5, -1, -.5, 0, .5, 1, 1.5, np.inf]
df['q5'] = pd.cut(df['SES'], bins=np.r_[QE[:1]-1e-9, QE[1:]],
                  labels=['Q1', 'Q2', 'Q3', 'Q4', 'Q5'], ordered=True)
df['t3'] = pd.cut(df['SES'], bins=np.r_[TE[:1]-1e-9, TE[1:]],
                  labels=['T1', 'T2', 'T3'], ordered=True)
df['b05'] = pd.cut(df['SES'], bins=FE,
                   labels=['<-1.5', '-1.5:-1', '-1:-0.5', '-0.5:0', '0:0.5', '0.5:1', '1:1.5', '>1.5'],
                   ordered=True)
df['qr5'] = df.groupby('SAMPLE_RACE')['SES'].transform(
    lambda s: pd.qcut(s, 5, labels=['Q1', 'Q2', 'Q3', 'Q4', 'Q5']))

print('=' * 100)
print('POOLED SES QUINTILE EDGES (primary):', np.round(QE, 4))
print('POOLED SES TERCILE EDGES           :', np.round(TE, 4))
print('overall BA rate %.3f%% (n=%d, k=%d)' % (100*df.BA.mean(), len(df), df.BA.sum()))

# ---------------------------------------------------------------- bin x group tables
def bin_table(bincol, groups, labels, title):
    rows = []
    for b in df[bincol].cat.categories:
        sub = df[df[bincol] == b]
        g = {}
        for lab, col in zip(labels, groups):
            s = sub[sub[col] == 1]
            n, k = len(s), int(s.BA.sum())
            lo, hi = proportion_confint(k, n, alpha=0.10, method='wilson') if n else (np.nan,)*2
            g[lab] = dict(n=n, k=k, pct=100*k/n if n else np.nan,
                          lo=100*lo, hi=100*hi)
        r = dict(bin=str(b), ses_lo=round(sub.SES.min(), 3), ses_hi=round(sub.SES.max(), 3))
        for lab in labels:
            for kk, vv in g[lab].items():
                r[f'{lab}_{kk}'] = round(vv, 3) if isinstance(vv, float) else vv
        a, c = g[labels[0]], g[labels[1]]
        # absolute gap (Black - comparator, pp) and risk ratio (Katz log CI, Haldane if 0)
        r['gap_pp'] = round(a['pct'] - c['pct'], 3)
        if a['n'] and c['n']:
            dl, dh = confint_proportions_2indep(a['k'], a['n'], c['k'], c['n'],
                                                method='newcomb', alpha=0.10)
            r['gap_lo90'] = round(100 * dl, 3); r['gap_hi90'] = round(100 * dh, 3)
            # equivalence-style bound: smallest absolute difference the bin can RULE OUT
            r['max_unexcluded_abs_gap_pp'] = round(max(abs(100 * dl), abs(100 * dh)), 2)
        else:
            r['gap_lo90'] = r['gap_hi90'] = r['max_unexcluded_abs_gap_pp'] = np.nan
        if a['k'] == 0 or c['k'] == 0:
            rr = np.nan; rrci = (np.nan, np.nan)
        else:
            rr = a['k']/a['n'] / (c['k']/c['n'])
            se = np.sqrt(1/a['k'] - 1/a['n'] + 1/c['k'] - 1/c['n'])
            rrci = (rr*np.exp(-1.645*se), rr*np.exp(1.645*se))
        r['ratio'] = round(rr, 3); r['ratio_lo'] = round(rrci[0], 3); r['ratio_hi'] = round(rrci[1], 3)
        # Fisher exact test of Black vs comparator within bin
        tab = [[a['k'], a['n']-a['k']], [c['k'], c['n']-c['k']]]
        r['fisher_p'] = round(stats.fisher_exact(tab)[1], 4)
        r['fisher_p_1s'] = round(stats.fisher_exact(tab, alternative='greater')[1], 4)
        # per-bin precision: MDE (pp) at 80% power, two-sided alpha=.05, baseline=comparator rate
        p0 = c['k']/c['n'] if c['n'] else np.nan
        z = 1.96 + 0.8416
        s0 = np.sqrt(p0*(1-p0)*(1/a['n'] + 1/c['n'])) if c['n'] else np.nan
        r['mde_pp'] = round(100*z*s0, 2)
        r['ci_width_pp'] = round(g[labels[0]]['hi'] - g[labels[0]]['lo'], 2)
        r['exp_events_if_parity'] = round(a['n']*p0, 2)
        rows.append(r)
    t = pd.DataFrame(rows)
    t.to_csv(f'{OUT}/table_{bincol}_{"_vs_".join(labels)}.csv', index=False)
    print('\n' + '=' * 100); print(title); print(t.to_string(index=False))
    return t

t5o = bin_table('q5', ['Black', 'Others'], ['Black', 'Others'],
