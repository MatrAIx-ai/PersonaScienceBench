#!/usr/bin/env bash
# Reproducible pipeline: data/nls_ses_processed.csv -> analysis/out/*
set -euo pipefail
cd "$(dirname "$0")/.."
python analysis/run_analysis.py   > analysis/out/report.txt 2>&1   # bins, Firth models, LRT, crossover, g-comp, power
python analysis/robustness.py     > analysis/out/robustness.txt 2>&1 # spec + LOO influence
python analysis/quadratic_check.py> analysis/out/quadratic.txt 2>&1  # curvature / monotonicity
python analysis/nested_tests.py   > analysis/out/nested.txt 2>&1     # nested MLE LRTs + bootstrap
python analysis/make_figure.py
python analysis/make_report.py    > analysis/out/_report_build.log 2>&1
echo "OK -> analysis/out/SUMMARY.md, HYPOTHESIS.md, fig_quintiles.svg"
