"""Dependency-free SVG figure: completion rate by pooled SES quintile, Black vs comparators."""
import pandas as pd
OUT='/workspace/analysis/out'
o=pd.read_csv(f'{OUT}/table_q5_Black_vs_Others.csv'); w=pd.read_csv(f'{OUT}/table_q5_Black_vs_White.csv')
W,H,L,R,T,B=920,470,70,20,54,70; pw,ph=W-L-R,H-T-B
ymax=4.5
X=lambda i: L+pw*(i+0.5)/5
Y=lambda v: T+ph*(1-v/ymax)
s=[f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="Helvetica,Arial" font-size="12">',
   f'<rect width="{W}" height="{H}" fill="white"/>',
   f'<text x="{W/2}" y="22" text-anchor="middle" font-size="15" font-weight="bold">BA completion by pooled SES quintile: Black vs non-Black vs White (NLS, n=8773)</text>',
   f'<text x="{W/2}" y="40" text-anchor="middle" fill="#555">bars = observed %; labels give n / events; error bars = Wilson 90% CI</text>']
for v in range(0,5):
    s.append(f'<line x1="{L}" y1="{Y(v)}" x2="{L+pw}" y2="{Y(v)}" stroke="#e5e5e5"/>')
    s.append(f'<text x="{L-8}" y="{Y(v)+4}" text-anchor="end">{v}%</text>')
s.append(f'<line x1="{L}" y1="{T}" x2="{L}" y2="{T+ph}" stroke="#333"/><line x1="{L}" y1="{T+ph}" x2="{L+pw}" y2="{T+ph}" stroke="#333"/>')
s.append(f'<text transform="translate(18,{T+ph/2}) rotate(-90)" text-anchor="middle">share completing a BA</text>')
grp=[('Black','Black_pct','Black_lo','Black_hi','Black_n','Black_k','#1f4e79'),
     ('Others_pct','Others_pct','Others_lo','Others_hi','Others_n','Others_k','#e08214'),
     ('White','White_pct','White_lo','White_hi','White_n','White_k','#7fbf7b')]
bw=pw/5*0.26
for i,row in o.iterrows():
    for j,(lab,pc,lo,hi,nc,kc,col) in enumerate(grp):
        src = w.iloc[i] if lab=='White' else row
        v=src[pc]; x=X(i)+(j-1)*bw-bw/2
        s.append(f'<rect x="{x:.1f}" y="{Y(v):.1f}" width="{bw-3:.1f}" height="{T+ph-Y(v):.1f}" fill="{col}"/>')
        err=max(0.02,(src[hi]-src[lo])/2)
        s.append(f'<line x1="{x+(bw-3)/2:.1f}" y1="{Y(max(0,v-err)):.1f}" x2="{x+(bw-3)/2:.1f}" y2="{Y(min(ymax,v+err)):.1f}" stroke="#333" stroke-width="0.9"/>')
        s.append(f'<text x="{x+(bw-3)/2:.1f}" y="{Y(min(ymax,v+err))-4:.1f}" text-anchor="middle" font-size="9">{v:.2f}</text>')
        s.append(f'<text x="{x+(bw-3)/2:.1f}" y="{Y(min(ymax,v+err))-14:.1f}" text-anchor="middle" font-size="8" fill="#666">n={int(src[nc])},k={int(src[kc])}</text>')
    s.append(f'<text x="{X(i):.0f}" y="{T+ph+18}" text-anchor="middle" font-weight="bold">{row.bin}</text>')
    s.append(f'<text x="{X(i):.0f}" y="{T+ph+32}" text-anchor="middle" font-size="9" fill="#555">SES {row.ses_lo:.2f} to {row.ses_hi:.2f}</text>')
    s.append(f'<text x="{X(i):.0f}" y="{T+ph+45}" text-anchor="middle" font-size="9" fill="#a33">gap {row.gap_pp:+.2f} pp</text>')
lx=L+8; ly=T+8
for k,(lab,pc,lo,hi,nc,kc,col) in enumerate(grp):
    nm={'Black':'Black','Others_pct':'non-Black (White+Hispanic)','White':'White'}[lab]
    s.append(f'<rect x="{lx}" y="{ly+k*16}" width="11" height="11" fill="{col}"/><text x="{lx+16}" y="{ly+k*16+10}">{nm}</text>')
s.append(f'<text x="{W/2}" y="{H-8}" text-anchor="middle" font-size="11" fill="#444">Gap is near-parity ONLY in Q5 (SES &gt;= 0.543): 3.45% vs 3.54% (ratio 0.97, Fisher p=1.0); Black SES gradient is ~1.6x steeper per SD (p=0.009)</text>')
s.append('</svg>')
open(f'{OUT}/fig_quintiles.svg','w').write('\n'.join(s))
print('wrote fig_quintiles.svg')
