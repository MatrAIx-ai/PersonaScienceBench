"""Firth (1993) penalized logistic regression: exact penalized-score IRLS.

Implemented here because no firthlogist/logistf package is available in this
environment. Penalized log-likelihood = l(beta) + 0.5*log|V(beta)|, where V is
the Fisher information. For the canonical (logit) link the penalized score is

    U*_j = sum_i x_ij [ (y_i - p_i) + (0.5 - p_i) * w_i * h_ii ],
    w_i  = p_i(1-p_i),  h_ii = [X V^-1 X']_ii  (hat-like diagonal)

and the update is beta <- beta + V^-1 U* (Heinze 2002).
"""
import numpy as np


def firth_logit(X, y, max_iter=500, tol=1e-9):
    X = np.asarray(X, float)
    y = np.asarray(y, float)
    n, p = X.shape
    beta = np.zeros(p)
    for it in range(max_iter):
        eta = X @ beta
        eta = np.clip(eta, -35, 35)
        prob = 1.0 / (1.0 + np.exp(-eta))
        w = prob * (1.0 - prob)
        V = X.T @ (X * w[:, None])
        Vinv = np.linalg.pinv(V)
        H = (X @ Vinv) * X            # rowwise x_i' V^-1 X
        h = H.sum(axis=1)             # h_ii
        u = X.T @ ((y - prob) + (0.5 - prob) * w * h)
        step = Vinv @ u
        # step-halving for stability with sparse cells
        lam, ok = 1.0, False
        for _ in range(40):
            cand = beta + lam * step
            if np.all(np.isfinite(X @ cand)) and np.linalg.cond(V) < 1e12:
                ok = True
                break
            lam /= 2.0
        if not ok:
            break
        beta = cand
        if np.max(np.abs(lam * step)) < tol:
            break
    eta = np.clip(X @ beta, -35, 35)
    prob = 1.0 / (1.0 + np.exp(-eta))
    w = prob * (1.0 - prob)
    V = X.T @ (X * w[:, None])
    Vinv = np.linalg.pinv(V)
    se = np.sqrt(np.clip(np.diag(Vinv), 0, None))
    # penalized log-likelihood (loglik + 0.5 log|V|) for approximate LRTs
    eps = 1e-300
    ll = float(np.sum(y * np.log(np.clip(prob, eps, 1)) +
                      (1 - y) * np.log(np.clip(1 - prob, eps, 1))))
    sign, logdet = np.linalg.slogdet(V)
    pll = ll + 0.5 * logdet
    return dict(beta=beta, se=se, ll=ll, penalized_ll=pll,
                converged=bool(np.max(np.abs(lam * step)) < tol) if p else True,
                iters=it + 1, n=n, k_events=int(y.sum()))
