"""Properly nested tests (unpenalized MLE loglik for LRTs) + bootstrap CIs for every bin gap."""
import numpy as np, pandas as pd, statsmodels.api as sm, sys
from scipy import stats
sys.path.insert(0,'/workspace/analysis'); from firth import firth_logit
OUT='/workspace/analysis/out'
df=pd.read_csv(f'{OUT}/analysis_frame.csv')
df['ASVABz']=(df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['RANKz']=(df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/df['PERCENTILE IN CLASS'].std()
df['Black']=(df.SAMPLE_RACE=='Black').astype(int); df['Female']=(df.SAMPLE_SEX=='Female').astype(int)
df['SESz']=(df.SES-df.SES.mean())/df.SES.std(); df['SESq']=df.SESz**2; df['BA']=df.BA.astype(int)
df['Bx']=df.Black*df.SESz; df['Bxq']=df.Black*df.SESq
for q in ['Q2','Q3','Q4','Q5']: df['q'+q]=(df.q5==q).astype(float); df['B'+q]=df.Black*df['q'+q]

def mle(cols,d):
    X=sm.add_constant(d[cols].values.astype(float))
    r=sm.Logit(d.BA.values,X).fit(disp=0,maxiter=200)
    return r
def lrt(c0,c1,d,name,dfree):
    r0,r1=mle(c0,d),mle(c1,d); lr=2*(r1.llf-r0.llf); p=1-stats.chi2.cdf(max(lr,0),dfree)
    print(f'{name:58s} chi2={lr:7.2f} df={dfree} p={p:.4f}')
    return dict(test=name,chi2=round(lr,2),df=dfree,p=round(p,4),method='MLE LRT')

print('='*100); print('NESTED MLE LIKELIHOOD-RATIO TESTS (unpenalized; Firth used for estimates)')
res=[]
res.append(lrt(['Black','SESz'],['Black','SESz','Bx'],df,'Heterogeneity: Black x SESz (linear, unadjusted)',1))
res.append(lrt(['Black','SESz','SESq'],['Black','SESz','SESq','Bx'],df,'Black x SESz holding SES curvature fixed (unadj)',1))
res.append(lrt(['Black','SESz','SESq','Bx'],['Black','SESz','SESq','Bx','Bxq'],df,'ADDITIONAL curvature of interaction (Bxq | Bx)',1))
res.append(lrt(['Black','SESz','SESq'],['Black','SESz','SESq','Bx','Bxq'],df,'Joint race-interaction test (Bx+Bxq | main effects)',2))
res.append(lrt(['Black','qQ2','qQ3','qQ4','qQ5'],['Black','qQ2','qQ3','qQ4','qQ5','BQ2','BQ3','BQ4','BQ5'],df,'Black x quintile dummies (unadjusted)',4))
A=['ASVABz','RANKz','Female']
res.append(lrt(['Black']+A+['SESz'],['Black']+A+['SESz','Bx'],df,'Black x SESz adjusted for preparation+sex',1))
res.append(lrt(A+['SESz'],['Black']+A+['SESz','Bx'],df,'Black main+interaction jointly (adjusted model)',2))
res.append(lrt(['Black','qQ2','qQ3','qQ4','qQ5','ASVABz','RANKz','Female'],
               ['Black','qQ2','qQ3','qQ4','qQ5','ASVABz','RANKz','Female','BQ2','BQ3','BQ4','BQ5'],df,'Black x quintile dummies adjusted',4))
pd.DataFrame(res).to_csv(f'{OUT}/nested_lrt.csv',index=False)

print('\n'+'='*100); print('SLOPE COMPARISON (ratio-of-ORs), from within-race Firth fits')
for g,lab in [(1,'Black'),(0,'non-Black')]:
    s=df[df.Black==g]; m=firth_logit(sm.add_constant(s[['SESz']].values),s.BA.values)
    print(f'  {lab:10s} OR per SD = {np.exp(m["beta"][1]):.2f} (90% CI {np.exp(m["beta"][1]-1.645*m["se"][1]):.2f}-{np.exp(m["beta"][1]+1.645*m["se"][1]):.2f})')

print('\n'+'='*100); print('BOOTSTRAP (2000 reps, seed 7) CIs for the per-bin Black-vs-others gap and ratio')
rng=np.random.default_rng(7); QS=['Q1','Q2','Q3','Q4','Q5']
gaps={q:[] for q in QS}; rats={q:[] for q in QS}; topgap=[]
idx_by_q={q:np.flatnonzero((df.q5==q).values) for q in QS}
allidx=np.arange(len(df))
for b in range(2000):
    samp=rng.integers(0,len(df),len(df)); d=df.iloc[samp]
    for q in QS:
        s=d[d.q5==q]; bb=s[s.Black==1]; oo=s[s.Black==0]
        if len(bb) and len(oo):
            gaps[q].append(100*(bb.BA.mean()-oo.BA.mean()))
            rats[q].append(np.nan if oo.BA.sum()==0 else (bb.BA.mean()/oo.BA.mean()))
    s=d[d.SES>=0.543]; bb=s[s.Black==1]; oo=s[s.Black==0]
    if len(bb) and len(oo): topgap.append(100*(bb.BA.mean()-oo.BA.mean()))
rows=[]
for q in QS:
    g=np.array(gaps[q]); r=np.array(rats[q],dtype=float); r=r[np.isfinite(r)]
    rows.append(dict(bin=q,point_gap_pp=round(np.mean(g),2),boot90_gap=f'[{np.percentile(g,5):+.2f},{np.percentile(g,95):+.2f}]',
                     pct_reps_gap_positive=round(100*np.mean(g>0),1),
                     median_ratio=round(np.median(r),2),boot90_ratio=f'[{np.percentile(r,5):.2f},{np.percentile(r,95):.2f}]',
                     pct_reps_ratio_gt1=round(100*np.mean(r>1),1)))
Bt=pd.DataFrame(rows); Bt.to_csv(f'{OUT}/bootstrap_bins.csv',index=False); print(Bt.to_string(index=False))
tg=np.array(topgap)
print(f'\nTop-quintile (SES>=0.543) Black-minus-others gap: boot mean {tg.mean():+.2f} pp, 90% CI '
      f'[{np.percentile(tg,5):+.2f},{np.percentile(tg,95):+.2f}], P(gap>0)={np.mean(tg>0):.2f} -> parity, not advantage')
