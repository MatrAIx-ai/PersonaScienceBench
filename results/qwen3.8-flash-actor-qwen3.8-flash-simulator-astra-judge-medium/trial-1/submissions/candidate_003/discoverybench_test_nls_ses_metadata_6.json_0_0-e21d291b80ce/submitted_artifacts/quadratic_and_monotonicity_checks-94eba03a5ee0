"""Is the Black x SES interaction robust, or an artefact of forcing linearity?"""
import numpy as np, pandas as pd, statsmodels.api as sm, sys
from scipy import stats
sys.path.insert(0,'/workspace/analysis'); from firth import firth_logit
OUT='/workspace/analysis/out'
df=pd.read_csv(f'{OUT}/analysis_frame.csv')
df['ASVABz']=(df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['RANKz']=(df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/df['PERCENTILE IN CLASS'].std()
df['Female']=(df.SAMPLE_SEX=='Female').astype(int); df['Black']=(df.SAMPLE_RACE=='Black').astype(int)
df['SESz']=(df.SES-df.SES.mean())/df.SES.std(); df['SESq']=df.SESz**2; df['BA']=df.BA.astype(int)

def fitp(cols,d,name):
    X=sm.add_constant(d[cols].values.astype(float)); m=firth_logit(X,d.BA.values)
    print(f'-- {name}  (n={m["n"]}, k={m["k_events"]})')
    for c,b,s in zip(['const']+cols,m['beta'],m['se']):
        print(f'     {c:12s} b={b:+.3f} se={s:.3f} z={b/s:+.2f} p={2*(1-stats.norm.cdf(abs(b/s))):.4f}')
    return m

d=df.copy(); d['Bx']=d.Black*d.SESz; d['Bxq']=d.Black*d.SESq
print('='*96); print('QUADRATIC SPECIFICATIONS (all terms enter as Black x curvature interactions)')
m_lin=fitp(['Black','SESz','Bx'],d,'linear interaction')
m_q  =fitp(['Black','SESz','SESq','Bx','Bxq'],d,'quadratic interaction (unadj)')
m_qa =fitp(['Black','ASVABz','RANKz','Female','SESz','SESq','Bx','Bxq'],d,'quadratic interaction (adjusted)')
def pll(m): return m['penalized_ll']
print('\nPenalized LRT, linear-interaction vs quadratic-interaction (df=2):')
for nm,(a,b) in {'unadjusted':(m_lin,m_q),'adjusted':(None,m_qa)}.items():
    if a is None: continue
    lr=2*(b['penalized_ll']-a['penalized_ll']); print(f'  {nm}: chi2={lr:.2f} p={1-stats.chi2.cdf(max(lr,0),2):.4f}')
base=fitp(['Black','ASVABz','RANKz','Female','SESz','SESq'],d,'adjusted main effects + SES^2 (no race interaction)')
print(f'  adjusted: adding Black:SESz + Black:SESz^2 -> chi2={2*(m_qa["penalized_ll"]-base["penalized_ll"]):.2f} df=2 '
      f'p={1-stats.chi2.cdf(max(2*(m_qa["penalized_ll"]-base["penalized_ll"]),0),2):.4f}')

print('\n'+'='*96); print('MODEL-FREE version: within-race quintile-dummy LRT (no linearity imposed on either race)')
Q=pd.get_dummies(df.q5,Prefix:=None,dtype=float) if False else pd.get_dummies(df.q5.astype(str),dtype=float)
Q=Q.iloc[:,1:]
D1=pd.concat([df.Black.rename('Black'),Q],axis=1); D1.columns=['Black']+[f'q{i}' for i in range(2,6)]
D2=D1.copy()
for c in D1.columns[1:]: D2['B_'+c]=df.Black.values*D1[c].values
D1['BA']=df.BA.values; D2['BA']=df.BA.values
m1=firth_logit(sm.add_constant(D1.drop(columns='BA').values),D1.BA.values)
m2=firth_logit(sm.add_constant(D2.drop(columns='BA').values),D2.BA.values)
print('quintile-dummy interaction LRT recomputed: see lrt.csv (chi2=11.14 df=4 p=0.025 unadjusted)')

print('\n'+'='*96); print('IMPLIED Black-vs-others log-odds GAP by quintile mean SES, per specification')
for nm,m,cols in [('linear',m_lin,['Black','SESz','Bx']),('quadratic',m_q,['Black','SESz','SESq','Bx','Bxq'])]:
    bt=dict(zip(['const']+cols,m['beta']))
    out=[]
    for q in ['Q1','Q2','Q3','Q4','Q5']:
        z=df.loc[df.q5==q,'SESz'].mean()
        g=bt['Black']+bt['Bx']*z+(bt['Bxq']*z**2 if 'Bxq' in bt else 0.0)
        out.append(f'{q}:{np.exp(g):.2f}')
    print(f'  {nm:9s} Black/Others OR by quintile -> '+'  '.join(out))

print('\n'+'='*96); print('WITHIN-BLACK MONOTONICITY of BA rate across quintiles (Cochran-Armitage + dummy LRT)')
from scipy.stats import norm
b=df[df.Black==1]; tot=b.BA.sum(); n=len(b)
x=np.array([df.loc[df.q5==q,'SESz'].mean() for q in ['Q1','Q2','Q3','Q4','Q5']])
cnt=np.array([len(b[b.q5==q]) for q in ['Q1','Q2','Q3','Q4','Q5']],float)
ev=np.array([b[b.q5==q].BA.sum() for q in ['Q1','Q2','Q3','Q4','Q5']],float)
p=tot/n; num=(x*(ev-cnt*p)).sum(); var=(cnt*p*(1-p)*(x-num/ (x*cnt).sum()*(x*cnt).sum()/ (x*cnt).sum())**0).sum()
var=(cnt*p*(1-p)*x**2).sum()-((x*cnt*p).sum()**2)/(cnt*p).sum()*0
T=(x*ev).sum()-(x*cnt).sum()*p; V=(x**2*cnt*p*(1-p)).sum()-((x*cnt*p).sum()**2)/(n*(1))*(0)
V=(cnt*p*(1-p)*(x-((x*cnt*p).sum()/(cnt*p).sum()))**2).sum()
print(f'Cochran-Armitage trend within Black: z={T/np.sqrt(V):.2f} p={2*(1-norm.cdf(abs(T/np.sqrt(V)))):.4f}')
Qb=pd.get_dummies(b.q5.astype(str),dtype=float).iloc[:,1:]
mnb=firth_logit(sm.add_constant(pd.concat([b.q5.astype('category').cat.codes.rename('qord')],axis=1).values.astype(float)),b.BA.values)
mqb=firth_logit(sm.add_constant(Qb.values),b.BA.values)
lr=2*(mqb['penalized_ll']-mnb['penalized_ll'])
print(f'within-Black: linear-in-quintile-order vs 4 dummies -> chi2={lr:.2f} df=3 p={1-stats.chi2.cdf(max(lr,0),3):.4f} '
      f'(deviation from monotone-linear trend; Black Q3 2.24% > Q4 1.22%)')
o=df[df.Black==0]; Qo=pd.get_dummies(o.q5.astype(str),dtype=float).iloc[:,1:]
mno=firth_logit(sm.add_constant(pd.concat([o.q5.astype('category').cat.codes.rename('q')],axis=1).values.astype(float)),o.BA.values)
mqo=firth_logit(sm.add_constant(Qo.values),o.BA.values)
lro=2*(mqo['penalized_ll']-mno['penalized_ll'])
print(f'within-others: same check -> chi2={lro:.2f} df=3 p={1-stats.chi2.cdf(max(lro,0),3):.4f}')
