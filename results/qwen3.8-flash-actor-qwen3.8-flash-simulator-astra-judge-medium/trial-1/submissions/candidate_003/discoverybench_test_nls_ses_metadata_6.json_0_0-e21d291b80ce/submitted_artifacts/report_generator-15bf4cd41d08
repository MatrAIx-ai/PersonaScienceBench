"""Assemble the deliverable summary + SVG figure from the analysis outputs."""
import numpy as np, pandas as pd
OUT='/workspace/analysis/out'
t5o=pd.read_csv(f'{OUT}/table_q5_Black_vs_Others.csv'); t5w=pd.read_csv(f'{OUT}/table_q5_Black_vs_White.csv')
def md(t):
    t = t.copy()
    for c in t.columns:
        if pd.api.types.is_float_dtype(t[c]):
            t[c] = t[c].map(lambda v: '' if pd.isna(v) else (f'{v:.3g}'))
    hdr = '| ' + ' | '.join(map(str, t.columns)) + ' |'
    sep = '|' + '|'.join(['---'] * len(t.columns)) + '|'
    body = '\n'.join('| ' + ' | '.join(map(str, r)) + ' |' for r in t.itertuples(index=False))
    return '\n'.join([hdr, sep, body])

G=pd.read_csv(f'{OUT}/framing2_gradient.csv'); ADJ=pd.read_csv(f'{OUT}/framing3_within_bin_adjusted.csv')
M=pd.read_csv(f'{OUT}/models_firth.csv'); X=pd.read_csv(f'{OUT}/crossover.csv'); L=pd.read_csv(f'{OUT}/lrt.csv')
TH=pd.read_csv(f'{OUT}/threshold_appendix.csv')

lines=[]; A=lines.append
A('# NLS SES x race: where is the Black-vs-others BA-completion gap most favourable to Black students?\n')
A('Data: data/nls_ses_processed.csv (n=8773, 0 missing, BA rate 2.69%, 236 events / 28 among Black).\n')
A('## 1. Unadjusted completion rates by POOLED SES QUINTILE (edges -2.445 | -0.588 | -0.237 | 0.106 | 0.543 | 2.718)\n')
for t,lab in [(t5o,'Black vs non-Black (White+Hispanic) [PRIMARY]'),(t5w,'Black vs White [full comparator]')]:
    A(f'### {lab}'); A(t[['bin','Black_n','Black_k','Black_pct','Black_lo','Black_hi','gap_pp','ratio','ratio_lo','ratio_hi','fisher_p']].pipe(md)); A('')
A('Read: Black completion is BELOW the comparator in every quintile. The gap is smallest/near-parity ONLY in Q5 '
  f"(SES >= 0.54): {t5o.Black_pct.iloc[-1]:.2f}% vs {t5o.Others_pct.iloc[-1]:.2f}%, ratio {t5o.ratio.iloc[-1]:.2f}, Fisher p=1.0.")
A(f"Q1 also looks 'narrow' in pp terms ({t5o.gap_pp.iloc[0]:.2f} pp) but that is a floor effect: {t5o.Black_pct.iloc[0]:.2f}% vs {t5o.Others_pct.iloc[0]:.2f}% "
  f"(ratio {t5o.ratio.iloc[0]:.2f}) on 1 Black event. Equivalence bounds (Newcombe 90% CI) never exclude |gap| up to ~2.8 pp, "
  'so "parity" in Q5 means "within about 3 pp", not "equal".\n')
A('## 2. Framing (ii): SES gradient steepness (the robust result)\n')
A(G.pipe(md)); A('')
A('Black OR per 1 SD of SES = 2.09 (90% CI 1.58-2.76) vs 1.30 (1.17-1.45) for non-Black and 1.18 (1.04-1.33) for White; '
  'Q5/Q1 rate ratio 18x (Black) vs 4x (non-Black) vs 2.8x (White).')
A('Black x SES interaction (Firth): OR=%.2f (90%% CI %.2f-%.2f), p=%.3f unadjusted; OR=%.2f, p=%.3f adjusted for ASVAB+class rank+sex.'
  % (float(M.query("model=='C_unadj_interaction' and term=='Black_SESz'").OR.iloc[0]),
     float(M.query("model=='C_unadj_interaction' and term=='Black_SESz'").OR_lo90.iloc[0]),
     float(M.query("model=='C_unadj_interaction' and term=='Black_SESz'").OR_hi90.iloc[0]),
     float(M.query("model=='C_unadj_interaction' and term=='Black_SESz'").p.iloc[0]),
     float(M.query("model=='E_adj_interaction' and term=='Black_SESz'").OR.iloc[0]),
     float(M.query("model=='E_adj_interaction' and term=='Black_SESz'").p.iloc[0])))
A('LRTs: '+', '.join(f"{r.test} chi2={r.chi2} df={r.df} p={r.p}" for r in L.itertuples())+'.\n')
A('## 3. Framing (iii): conditional on academic preparation (ASVAB + class rank + sex)\n')
A(M[M.model.isin(['A_unadj_black','D_adj_black','E_adj_interaction'])].pipe(md)); A('')
A(ADJ.pipe(md)); A('')
A('Adjustment flips the sign of the Black coefficient: OR 0.42 (0.30-0.59) unadjusted -> 1.19 (0.83-1.70) adjusted (n.s.), '
  'and within Q5 the adjusted Black OR = 2.14 (90% CI 1.07-4.29, p=0.071). The divergence is itself a finding: the raw '
  'shortfall is largely carried by measured preparation, and a residual Black advantage appears in the upper half of the SES range.')
A('Model-implied parity (log-odds ratio = 1) point: '+', '.join(
  f"{r.model}: SES={r.ses_at_parity:+.2f} (boot 90% CI {r.boot_lo90:+.2f} to {r.boot_hi90:+.2f}; {r.pct_sample_above}% of sample above it, {r.n_black_above} Black)"
  for r in X.itertuples())+'\n')
A('## 4. Per-bin precision (sparsity, made explicit)\n')
A(t5o[['bin','Black_n','Black_k','exp_events_if_parity','ci_width_pp','mde_pp','max_unexcluded_abs_gap_pp','fisher_p']].pipe(md)); A('')
A('Q5: 203 Black respondents, 7 events, expected 7.19 under parity, Black 90% CI 4.4 pp wide, MDE 3.9 pp. '
  'No bin supports a claim of Black rate > comparator rate.\n')
A('## 5. Descriptive appendix (NOT inferential)\n')
A(TH.pipe(md)); A('')
A('Black rates are numerically above the comparator only at SES >= 1.0 (5.41% vs 5.23%, n=74 Black, 4 events) and '
  'SES >= 1.5 (8.57% vs 6.06%, n=35 Black, 3 events) - too sparse to interpret; the 0.5-unit-band table shows the same '
  'non-monotone noise (band 1:1.5 ratio 0.55 between two bands with ratios 1.12 and 1.41).\n')
A('## 6. Comparator robustness\n')
A(pd.read_csv(f'{OUT}/comparator_robustness.csv').pipe(md)); A('')
A('Pooling Hispanic with White does not drive the interaction (Black-vs-White-only interaction OR 1.77, p=0.002).\n')
A('## 7. Monotonicity caveat\n')
A('The narrowing is NOT a smooth dose-response: Spearman rho between quintile order and the gap = 0.30 (p=0.62); '
  'the gap is widest in Q2 and Q4 (-2.7 to -2.9 pp) and Q3 (2.24%) sits above Q4 (1.22%). The "advantage/convergence" '
  'signal is concentrated in the single top quintile, i.e. it rests on 203 Black respondents and 7 events.\n')
open(f'{OUT}/SUMMARY.md','w').write('\n'.join(lines))
print('\n'.join(lines)[:3000])

# ---- appended sections: nested tests, robustness, bootstrap, hypothesis
extra=[]; E=extra.append
E('\n## 8. Nested likelihood-ratio tests (MLE loglik; Firth used for point estimates)\n')
E(pd.read_csv(f'{OUT}/nested_lrt.csv').pipe(md)); E('')
E('The interaction is LINEAR in SES: adding Black:SES^2 on top of Black:SES gives chi2=0.01, p=0.91. '
  'But the fully model-free Black x quintile-dummy version is only suggestive (p=0.12 unadjusted, p=0.07 adjusted) - '
  'the 4-df test loses power to the sparse cells, so the linear-interaction p~0.015 is the best-powered statement, not a robustness-free one.')
E('\n## 9. Specification + influence robustness of the interaction\n')
E(pd.read_csv(f'{OUT}/spec_robustness.csv').drop(columns=['parity_SES'],errors='ignore').pipe(md)); E('')
E('Leave-one-Black-respondent-out (2113 refits): interaction beta ranges 0.395-0.517, never changes sign. '
  'The Q5 near-parity is however fragile at the individual level: dropping ANY one of the 7 Black completions in Q5 '
  'moves the gap from -0.10 pp to -0.57 pp (6/202 = 2.97% vs 3.54%).')
E('\n## 10. Bootstrap (2000 reps) per-bin gap and ratio\n')
E(pd.read_csv(f'{OUT}/bootstrap_bins.csv').pipe(md)); E('')
E('Only Q5 has a bootstrap P(gap>0) near a coin flip (45.8%); Q2 and Q4 are negative in ~100% of replicates. '
  'Top-quintile gap bootstrap 90% CI [-2.20, +2.37] pp = parity within +-2.4 pp, NOT an advantage.')
E('\n## 11. Positivity / support for the preparation-adjusted framing\n')
E('Within Q5, mean ASVAB is 1945 for Black vs 2219 for others and mean class rank 50.3 vs 59.6, and no Black respondent '
  'sits above the comparator maximum in any quintile - so the adjusted contrast is identified but compares Black students '
  'to comparatively better-prepared peers. ASVAB and class rank are plausibly MEDIATORS of a SES->completion path, so the '
  'adjusted Black coefficient is a conditional-on-preparation contrast, not a causal effect.')
E('\n## 12. FINAL HYPOTHESIS\n')
E(open('/workspace/analysis/out/HYPOTHESIS.md').read())
open(f'{OUT}/SUMMARY.md','a').write('\n'.join(extra))
print('\nSUMMARY.md finalised')
