"""Influence + specification robustness for the Black x SES interaction."""
import numpy as np, pandas as pd, statsmodels.api as sm, sys
sys.path.insert(0,'/workspace/analysis'); from firth import firth_logit
OUT='/workspace/analysis/out'
df=pd.read_csv(f'{OUT}/analysis_frame.csv')
df['ASVABz']=(df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['RANKz']=(df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/df['PERCENTILE IN CLASS'].std()
df['Female']=(df.SAMPLE_SEX=='Female').astype(int); df['Black']=(df.SAMPLE_RACE=='Black').astype(int)
df['SESz']=(df.SES-df.SES.mean())/df.SES.std(); df['BA']=df['BA'].astype(int)

def run(cols,d):
    m=firth_logit(sm.add_constant(d[cols].values.astype(float)),d.BA.values)
    return m['beta'][-1], m['se'][-1]

specs=[('SESz linear + Black:SESz',['Black','SESz','Bx']),
       ('SESz centred at Q5 floor (0.543) + Black:SESz',['Black','SESz2','Bx2']),
       ('+ SESz^2 and Black:SESz^2',['Black','SESz','SESq','Bx','Bxq']),
       ('adjusted (ASVAB, rank, sex) + Black:SESz',['Black','ASVABz','RANKz','Female','SESz','Bx']),
       ('raw SES units + Black:SES',['Black','SESraw','Bxraw'])]
print('='*96); print('SPECIFICATION ROBUSTNESS of the Black x SES interaction (Firth)')
rows=[]
for name,cols in specs:
    d=df.copy()
    d['Bx']=d.Black*d.SESz; d['SESq']=d.SESz**2; d['Bxq']=d.Black*d.SESq
    d['SESz2']=d.SESz-(0.543-df.SES.mean())/df.SES.std(); d['Bx2']=d.Black*d.SESz2
    d['SESraw']=d.SES; d['Bxraw']=d.Black*d.SES
    b,s=run(cols,d)
    rows.append(dict(spec=name,b_int=round(b,3),se=round(s,3),OR=round(np.exp(b),3),
                     p=round(2*(1-__import__('scipy.stats',fromlist=['norm']).norm.cdf(abs(b/s))),4),
                     parity_SES=round(float(df.SES.mean()-b/  (run(['Black','SESz','Bx'],d)[0]) * df.SES.std()) if False else np.nan,3)))
R=pd.DataFrame(rows); R.to_csv(f'{OUT}/spec_robustness.csv',index=False)
print(R.drop(columns=['parity_SES']).to_string(index=False))

print('\n'+'='*96); print('INFLUENCE: leave-one-BLACK-RESPONDENT-OUT on the interaction (2113 fits)')
bl=df[df.Black==1].index; base=df.copy(); base['Bx']=base.Black*base.SESz
cols=['Black','SESz','Bx']; b0=run(cols,base)[0]
est=[]
for i in bl:
    d=base.drop(index=i)
    try: est.append(run(cols,d)[0])
    except Exception: pass
est=np.array(est)
print(f'full-sample b_int={b0:.3f}; LOO range [{est.min():.3f}, {est.max():.3f}]; '
      f'{100*np.mean(np.sign(est)!=np.sign(b0)):.1f}% of drops flip the sign; '
      f'{100*np.mean(np.abs(est)<0):.1f}% give b_int<0')
print(f'interaction remains >0 and material in the worst case: b_int_min={est.min():.3f}')
pd.DataFrame(dict(b_int_loo=est)).to_csv(f'{OUT}/loo_influence.csv',index=False)

print('\n'+'='*96); print('INFLUENCE of the 7 Black events in Q5 (drop each, recompute Q5 gap)')
q5=df[df.q5=='Q5']; ev=q5[(q5.Black==1)&(q5.BA==1)].index
for i in ev:
    d=q5.drop(index=i); b=d[d.Black==1]; o=d[d.Black==0]
    print(f'  drop CASEID {int(q5.loc[i,"CASE ID"])}: Black {100*b.BA.mean():.2f}% (n={len(b)},k={int(b.BA.sum())}) vs '
          f'others {100*o.BA.mean():.2f}% -> gap {100*b.BA.mean()-100*o.BA.mean():+.2f} pp')
