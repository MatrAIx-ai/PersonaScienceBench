"""
NLS SES: marginal (unadjusted) log-odds ratios of BA DEGREE COMPLETED between races.
Specification fixed by the researcher:
  metric = marginal log-odds ratio, reference White, contrast "race X minus White";
  model  = logit with SAMPLE_RACE only (no covariates) for the primary number;
  pair   = the pair with the smallest |logOR - (-0.9568)|.
Sensitivity models (SES / full control block) are reported but are NOT the answer.
"""
import itertools
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

TARGET = -0.9568
CSV = "data/nls_ses_processed.csv"
RACES = ["White", "Black", "Hispanic"]

# ---------------------------------------------------------------- load
df = pd.read_csv(CSV, index_col=0)          # drop unnamed index column "Unnamed: 0"
df["BA"] = df["BA DEGREE COMPLETED"].astype(bool).astype(int)   # True/False -> 1/0 explicitly

print("=== 0. DATA PROFILE ===")
print("rows, cols:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes.to_string())
print("missing per column:\n", df.isna().sum().to_string())
print("SAMPLE_RACE values:", df["SAMPLE_RACE"].unique().tolist())
print("SAMPLE_SEX values:", df["SAMPLE_SEX"].unique().tolist())
print("race x sex:\n", pd.crosstab(df["SAMPLE_RACE"], df["SAMPLE_SEX"]).to_string())

# --------------------------------------------------- 1. proportions by race
tab = df.groupby("SAMPLE_RACE")["BA"].agg(n="count", k="sum")
tab["prop"] = tab["k"] / tab["n"]
tab["se_logit"] = np.sqrt(1 / tab["k"] + 1 / (tab["n"] - tab["k"]))
tab["logit_p"] = np.log(tab["k"] / (tab["n"] - tab["k"]))
tab = tab.loc[RACES]
print("\n=== 1. BA DEGREE COMPLETED rate by SAMPLE_RACE ===")
print(tab.round(6).to_string())

# --------------------------------------- 2. pairwise marginal log-odds ratios + CI
def logor_ci(ga, gb):
    """logOR = logit(pA) - logit(pB); Woolf (Katz) CI."""
    a, na = ga["BA"].sum(), len(ga)
    b, nb = gb["BA"].sum(), len(gb)
    lor = np.log(a / (na - a)) - np.log(b / (nb - b))
    se = np.sqrt(1 / a + 1 / (na - a) + 1 / b + 1 / (nb - b))
    z_stat = (a / na - b / nb) / np.sqrt(
        (a + b) / (na + nb) * (1 - (a + b) / (na + nb)) * (1 / na + 1 / nb))
    return lor, se, np.exp(lor), 1.96 * se, z_stat

rows = []
for A, B in itertools.permutations(RACES, 2):
    lor, se, orr, hw, z = logor_ci(df[df.SAMPLE_RACE == A], df[df.SAMPLE_RACE == B])
    rows.append(dict(contrast=f"{A} vs {B} (ref {B})", logOR=lor, se=se,
                     odds_ratio=orr, lo95=lor - hw, hi95=lor + hw,
                     two_prop_z=z, delta_vs_target=lor - TARGET,
                     abs_delta=abs(lor - TARGET)))
pairwise = pd.DataFrame(rows).sort_values("abs_delta")
print("\n=== 2. Pairwise MARGINAL log-odds ratios (A - B), 95% CI (Woolf) ===")
print(pairwise.round(4).to_string(index=False))

# ------------------------------- 3. same thing as logit with SAMPLE_RACE only
X = pd.get_dummies(df[["SAMPLE_RACE"]], drop_first=True).astype(float)  # ref = Black (alphabetical)
X.insert(1, "SAMPLE_RACE_White_vs_Black", X.pop("SAMPLE_RACE_White"))
logit_race = sm.Logit(df["BA"], sm.add_constant(X)).fit(disp=0)
print("\n=== 3. Logit BA ~ SAMPLE_RACE only (no covariates) ===")
print(logit_race.summary2().tables[1].round(4).to_string())
print("(ref inside statsmodels dummies is Black; converting to White-reference "
      "coefficients: Black-vs-White = %.4f, Hispanic-vs-White = %.4f)"
      % (-logit_race.params["SAMPLE_RACE_White_vs_Black"],
         logit_race.params["SAMPLE_RACE_Hispanic"] - logit_race.params["SAMPLE_RACE_White_vs_Black"]))

# --------------------------- 3a. continuity-corrected logOR, all pairs, same correction
print("\n=== 3a. Haldane/0.5 continuity-corrected logOR, applied to all three pairs at once ===")
for corr in (0.5, 0.25, 0.1):
    out = []
    for A, B in itertools.permutations(RACES, 2):
        ga, gb = df[df.SAMPLE_RACE == A], df[df.SAMPLE_RACE == B]
        a, na = ga["BA"].sum(), len(ga)
        b, nb = gb["BA"].sum(), len(gb)
        lor = np.log(((a + corr) / (na - a + corr)) / ((b + corr) / (nb - b + corr)))
        out.append(f"{A}-{B}={lor:.4f} (d={lor-TARGET:+.4f})")
    print(f"  corr={corr}: " + "; ".join(out))

# --------------------------- 3b. two dummies in ONE model, rounded values compared
print("\n=== 3b. Single model, two race dummies, White as reference ===")
X2 = pd.DataFrame({"Black": (df.SAMPLE_RACE == "Black").astype(float),
                   "Hispanic": (df.SAMPLE_RACE == "Hispanic").astype(float)})
m2 = sm.Logit(df["BA"], sm.add_constant(X2)).fit(disp=0)
for k, v in m2.params.items():
    if k != "const":
        print(f"  {k:9s} coef={v:.6f}  round4={round(v,4)}  CI=[{m2.conf_int().loc[k,0]:.4f}, {m2.conf_int().loc[k,1]:.4f}]  |delta|={abs(v-TARGET):.4f}")
print("  Black/Hispanic (within-model, Wald linear combination): %.4f"
      % (m2.params["Black"] - m2.params["Hispanic"]))

# --------------------------- 3c. one-race-pair subset logOR / logit
print("\n=== 3c. Pair-only subsets (drop third race), marginal logOR and logit ===")
for A, B in itertools.combinations(RACES, 2):
    sub = df[df.SAMPLE_RACE.isin([A, B])]
    gA, gB = sub[sub.SAMPLE_RACE == A], sub[sub.SAMPLE_RACE == B]
    a, na = gA["BA"].sum(), len(gA); b, nb = gB["BA"].sum(), len(gB)
    lor = np.log(a / (na - a)) - np.log(b / (nb - b))
    Xs = pd.DataFrame({A: (sub.SAMPLE_RACE == A).astype(float)})
    lc = sm.Logit(sub["BA"], sm.add_constant(Xs)).fit(disp=0).params[A]
    print(f"  subset{{{A},{B}}}: logOR({A}-{B})={lor:.4f} logit={lc:.4f} |delta(logOR)|={abs(lor-TARGET):.4f}")

# ---------------------------------------------- 4. sensitivity: adjusted models (NOT the answer)
print("\n=== 4. SENSITIVITY ONLY (not the answer): adjusted logit coefficients, White ref ===")
cont = ["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS", "FAMILY SIZE OF SAMPLE"]
for ctrls, label in [([], "race only (primary)"), (["SES"], "+SES"),
                     (["SES", "SAMPLE_SEX"], "+SES+SEX"), (cont, "+ALL controls")]:
    Xi = pd.DataFrame({"Black": (df.SAMPLE_RACE == "Black").astype(float),
                       "Hispanic": (df.SAMPLE_RACE == "Hispanic").astype(float)})
    for c in ctrls:
        Xi[c] = df[c].map({"Male": 1.0, "Female": 0.0}).astype(float) if c == "SAMPLE_SEX" else df[c].astype(float)
    mi = sm.Logit(df["BA"], sm.add_constant(Xi)).fit(disp=0)
    print("  %-20s Black=%+.4f  Hispanic=%+.4f" % (label, mi.params["Black"], mi.params["Hispanic"]))

# ---------------------------------------------- 5. exact-match audit
print("\n=== 5. EXACT-MATCH AUDIT vs %.4f (tolerance +/-0.0005) ===" % TARGET)
cands = [("marginal logOR %s" % r.contrast, r.logOR) for r in pairwise.itertuples()]
cands += [("logit-only-race %s" % k, v) for k, v in m2.params.items() if k != "const"]
hits = [(n, v) for n, v in cands if abs(v - TARGET) <= 0.0005]
print("  candidates audited:", len(cands))
print("  exact matches within +/-0.0005:", hits if hits else "NONE")
best = pairwise.iloc[0]
print("\n=== 6. PRE-REGISTERED DECISION ===")
print("  closest pair by |logOR - (%.4f)|: %s  logOR=%.4f  |delta|=%.4f"
      % (TARGET, best.contrast, best.logOR, best.abs_delta))
runner = pairwise.iloc[1]
print("  runner-up: %s  logOR=%.4f  |delta|=%.4f" % (runner.contrast, runner.logOR, runner.abs_delta))

# --------- 7. auxiliary (NOT a race pair, reported only for audit transparency)
p1 = df.loc[df.SAMPLE_RACE != "White", "BA"].mean()
p0 = df.loc[df.SAMPLE_RACE == "White", "BA"].mean()
pooled = np.log(p1 / (1 - p1)) - np.log(p0 / (1 - p0))
print("  [aux] pooled non-White (Black+Hispanic) vs White logOR = %.4f  |delta|=%.4f  "
      "-> not a pair of two races, therefore not eligible" % (pooled, abs(pooled - TARGET)))
mean_of_two = (-1.005703 - 0.924136) / 2
print("  [aux] arithmetic mean of the two White-referenced logORs = %.4f  |delta|=%.4f"
      % (mean_of_two, abs(mean_of_two - TARGET)))
