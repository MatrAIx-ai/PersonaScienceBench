"""
Main run: which roles are most associated with requirements activity in ML-enabled systems.

Reading (fixed): "association with requirements" == role is QUOTED as a role that addresses
requirements-related ML activity in the respondent's organisation, i.e. Q8_ML_Addressing_<role>
== 'quoted'. It is the ONLY role-by-requirements variable in the file.
D14_ML_Purpose_Association = association-RULE-LEARNING (an ML purpose), not used for the answer.

Preprocessing (approved):
  * sentinel codes -99 / -77 / -66 and D4_Role == '0' -> NA (never in numerator or denominator)
  * 82 rows with '-77' in ALL 8 Q8 columns -> did not see the question block -> out of denominator
  * 21 respondents quoting zero roles stay in the base (conservative)
  * Q8 denormalised to an 8-column 0/1 matrix (multi-select, one row per respondent)
  * D4_Role_Others stays one 'Others' category in the main run; keyword mapping only as an
    explicitly arbitrary sensitivity analysis.

Statistics: bootstrap B=10000, seed=42, respondent-level resampling with replacement;
percentile 2.5/97.5 CI + BCa CI + bootstrap SE + normal CI (CI width is not a method artefact).

Nothing is tuned to reproduce the 49.6% / 61.389% quoted in the question.
"""
import json
from math import erf, sqrt
from statistics import NormalDist
import numpy as np
import pandas as pd

PATH = 'data/requirements_engineering_for_ML-enabled_systems.csv'
B, SEED = 10_000, 42

ROLES = {
    'Project Lead / Project Manager': 'Q8_ML_Addressing_Project_Lead',
    'Business Analyst':               'Q8_ML_Addressing_Business_Analyst',
    'Requirements Engineer':          'Q8_ML_Addressing_Requirement_Engineer',
    'Solution Architect':             'Q8_ML_Addressing_Solution_Architect',
    'Data Scientist':                 'Q8_ML_Addressing_Data_Scientist',
    'Developer':                      'Q8_ML_Addressing_Developer',
    'Test Manager / Tester':          'Q8_ML_Addressing_Tester',
    'Others (free-text role)':        'Q8_ML_Addressing_Others',
}
OWN_ROLE = {
    'Project Lead / Project Manager': 'Project Lead / Project Manager',
    'Business Analyst':               'Business Analyst',
    'Requirements Engineer':          'Requirements Engineer',
    'Solution Architect':             'Solution Architect',
    'Data Scientist':                 'Data Scientist',
    'Developer':                      'Developer',
    'Test Manager / Tester':          'Test Manager / Tester',
    'Others (free-text role)':        'Other, which one?',
}
COLS = list(ROLES.values())
COMPLETED = ['Completed (31)', 'Completed after break (32)']

# --------------------------------------------------------------- load + audit
df = pd.read_csv(PATH, dtype=str, keep_default_na=False, na_values=[])
n_rows = len(df)
sentinels = {c: int(df[c].astype(str).str.strip().isin(['-99', '-77', '-66']).sum())
             for c in df.columns
             if df[c].astype(str).str.strip().isin(['-99', '-77', '-66']).any()}

q8_block_missing = df[COLS].eq('-77').all(axis=1)
q8_partial_77 = df[COLS].eq('-77').any(axis=1) & ~q8_block_missing
base_valid = ~q8_block_missing
zero_quoted = base_valid & ~df[COLS].eq('quoted').any(axis=1)
role_unanswered = df['D4_Role'].eq('0')

audit = {
    'rows': n_rows, 'columns': int(df.shape[1]),
    'unique_ID': int(df['ID'].nunique()), 'duplicate_ID_rows': int(df['ID'].duplicated().sum()),
    'columns_100pct_nonempty': int(sum(1 for c in df.columns if df[c].astype(str).str.strip().ne('').all())),
    'status_counts': df['Status'].value_counts().to_dict(),
    'D4_Role_counts': df['D4_Role'].value_counts().to_dict(),
    'D4_Role_Others_non_sentinel': int((~df['D4_Role_Others'].eq('-99')).sum()),
    'Q8_value_domain': sorted(set(pd.unique(df[COLS].values.ravel()))),
    'rows_minus77_in_all_8_Q8': int(q8_block_missing.sum()),
    'rows_minus77_in_some_but_not_all_Q8': int(q8_partial_77.sum()),
    'Q8_valid_base': int(base_valid.sum()),
    'Q8_valid_quoting_zero_roles': int(zero_quoted.sum()),
    'total_quotations_in_valid_base': int(df.loc[base_valid, COLS].eq('quoted').to_numpy().sum()),
    'D4_Role_0_treated_as_NA': int(role_unanswered.sum()),
    'D4_Role_0_completed_only': int((role_unanswered & df['Status'].isin(COMPLETED)).sum()),
    'n_columns_with_sentinel_codes': len(sentinels),
    'sentinel_code_columns_sample': dict(list(sentinels.items())[:15]),
    'D14_ML_Purpose_Association_counts': df['D14_ML_Purpose_Association'].value_counts().to_dict(),
    'bootstrap': {'B': B, 'seed': SEED, 'unit': 'respondent row, with replacement',
                  'CIs': 'percentile 2.5/97.5, BCa, bootstrap SE, normal'},
}

# --------------------------------------------------------------- stats helpers
ND = NormalDist()
def ncdf(x):
    return ND.cdf(x)
def qnorm(q):
    return ND.inv_cdf(min(max(q, 1e-12), 1 - 1e-12))

def boot_stats(y):
    n = len(y)
    if n == 0:
        return dict(n=0, k=0, pct=np.nan, se=np.nan, pct_lo=np.nan, pct_hi=np.nan,
                    bca_lo=np.nan, bca_hi=np.nan, norm_lo=np.nan, norm_hi=np.nan)
    rng = np.random.default_rng(SEED)
    bs = y[rng.integers(0, n, size=(B, n))].mean(axis=1)
    p, se = y.mean(), bs.std(ddof=1)
    lo, hi = np.percentile(bs, [2.5, 97.5])
    frac = float((bs < p).mean())
    frac = min(max(frac, 1e-12), 1 - 1e-12)
    z0 = qnorm(frac)
    jack = (y.sum() - y) / (n - 1) if n > 1 else np.array([p])
    d = jack.mean() - jack
    den = 6.0 * float((d ** 2).sum()) ** 1.5
    a = float((d ** 3).sum()) / den if den else 0.0
    def adj_level(alpha):
        """BCa adjusted bootstrap level: Phi(z0 + z_alpha / (1 - a*(z0 + z_alpha)))."""
        za = qnorm(alpha)
        den2 = 1 - a * (z0 + za)
        return ncdf(z0 + za / den2) if den2 else np.nan
    la, ha = adj_level(0.025), adj_level(0.975)
    bca_lo = 100 * np.percentile(bs, 100 * la)
    bca_hi = 100 * np.percentile(bs, 100 * ha)
    return dict(n=n, k=int(y.sum()), pct=100 * p, se=100 * se,
                pct_lo=100 * lo, pct_hi=100 * hi,
                bca_lo=bca_lo, bca_hi=bca_hi,
                norm_lo=100 * (p - 1.96 * se), norm_hi=100 * (p + 1.96 * se))

# --------------------------------------------------------------- bases & metrics
bases = {
    'B1_all276_no_exclusion(-77 treated as not quoted)': pd.Series(True, index=df.index),
    'B2_MAIN_q8_valid_194': base_valid,
    'B3_valid194_and_completed_188': base_valid & df['Status'].isin(COMPLETED),
    'B4_valid194_and_at_least_one_quoted_173': base_valid & df[COLS].eq('quoted').any(axis=1),
}
def M1(mask, col, role):
    m = mask.to_numpy()
    return df[col].eq('quoted').to_numpy()[m].astype(float), int(m.sum())
def M2(mask, col, role):
    m = (df['D4_Role'].eq(OWN_ROLE[role]) & mask).to_numpy()
    if m.sum() == 0:
        return np.array([], dtype=float), 0
    return df[col].eq('quoted').to_numpy()[m].astype(float), int(m.sum())

rows = []
for role, col in ROLES.items():
    y, _ = M1(base_valid, col, role)
    st = boot_stats(y)
    rows.append(dict(role=role, q8_column=col, k=st['k'], n=st['n'], pct=round(st['pct'], 3),
                     boot_se=round(st['se'], 3), ci95_lo=round(st['pct_lo'], 3), ci95_hi=round(st['pct_hi'], 3),
                     bca_lo=round(st['bca_lo'], 3), bca_hi=round(st['bca_hi'], 3),
                     normal_lo=round(st['norm_lo'], 3), normal_hi=round(st['norm_hi'], 3)))
main_tab = pd.DataFrame(rows).sort_values('pct', ascending=False).reset_index(drop=True)
main_tab.insert(0, 'rank', main_tab.index + 1)
main_tab['ci95_formatted'] = [f"{p:.3f}% [{lo:.3f}, {hi:.3f}]" for p, lo, hi in
                             zip(main_tab.pct, main_tab.ci95_lo, main_tab.ci95_hi)]

sens = []
for bn, bm in bases.items():
    for role, col in ROLES.items():
        for mn, fn in [('M1_quoted_share', M1), ('M2_self_attribution', M2)]:
            y, n = fn(bm, col, role)
            st = boot_stats(y)
            sens.append(dict(base=bn, metric=mn, role=role, k=st['k'], n=n, pct=round(st['pct'], 3),
                             boot_se=round(st['se'], 3), ci95_lo=round(st['pct_lo'], 3), ci95_hi=round(st['pct_hi'], 3)))
sens_tab = pd.DataFrame(sens)

tops = []
for (bn, mn), g in sens_tab.dropna(subset=['pct']).groupby(['base', 'metric']):
    g = g.sort_values('pct', ascending=False)
    tops.append(dict(base=bn, metric=mn,
                     rank1=f"{g.iloc[0]['role']} ({g.iloc[0]['pct']:.3f}%)",
                     rank2=f"{g.iloc[1]['role']} ({g.iloc[1]['pct']:.3f}%)" if len(g) > 1 else 'unknown',
                     rank3=f"{g.iloc[2]['role']} ({g.iloc[2]['pct']:.3f}%)" if len(g) > 2 else 'unknown',
                     gap_rank2_minus_rank3=round(float(g.iloc[1]['pct'] - g.iloc[2]['pct']), 3) if len(g) > 2 else np.nan))
top_tab = pd.DataFrame(tops)

PATS = [('Data Scientist', r'data scien|machine learning|ml engineer|research scientist|researcher|data analyst|data engineer'),
        ('Project Lead / Project Manager', r'manager|lead|director|ceo|cto|head|owner|partner|consultant'),
        ('Solution Architect', r'architect'),
        ('Developer', r'develop|software|programmer|engineer'),
        ('Business Analyst', r'business|analyst|specialist|coordinator|fpa')]
oth = df['D4_Role_Others'].str.lower()
mapped = pd.Series('unknown', index=df.index)
for label, pat in PATS:
    hit = oth.str.contains(pat, regex=True, na=False) & oth.ne('-99')
    mapped[hit & mapped.eq('unknown')] = label
map_tab = mapped[~mapped.eq('unknown')].value_counts().rename('n_respondents').to_frame()
map_tab.index.name = 'arbitrary_keyword_role'
map_tab.attrs['note'] = 'ARBITRARY keyword mapping; not used for the answer'

d14 = df[df['D14_ML_Purpose_Association'].isin(['quoted', 'not quoted'])]
d14_tab = (d14.assign(q=d14['D14_ML_Purpose_Association'].eq('quoted'))
           .groupby('D4_Role')['q'].agg(n='size', quoted='sum').reset_index())
d14_tab['pct'] = (100 * d14_tab.quoted / d14_tab.n).round(3)
d14_overall = dict(n=int(len(d14)), quoted=int(d14['D14_ML_Purpose_Association'].eq('quoted').sum()),
                   pct=round(100 * d14['D14_ML_Purpose_Association'].eq('quoted').mean(), 3))

hw1 = (49.981 - 49.219) / 2 / 100
hw2 = (61.822 - 60.955) / 2 / 100
feas = dict(target_p1=49.6, target_p1_ci=[49.219, 49.981], target_p1_halfwidth_pp=round(hw1 * 100, 3),
            n_required_for_p1=int(round(0.25 / (hw1 / 1.96) ** 2)),
            target_p2=61.389, target_p2_ci=[60.955, 61.822], target_p2_halfwidth_pp=round(hw2 * 100, 3),
            n_required_for_p2=int(round(0.61389 * 0.38611 / (hw2 / 1.96) ** 2)),
            actual_n_main_base=int(base_valid.sum()), actual_rows=n_rows,
            integer_numerators_for_p1={'n194': round(0.496 * 194, 2), 'n188': round(0.496 * 188, 2), 'n276': round(0.496 * 276, 2)},
            integer_numerators_for_p2={'n194': round(0.61389 * 194, 2), 'n188': round(0.61389 * 188, 2), 'n276': round(0.61389 * 276, 2)},
            conclusion='quoted CIs imply n~48k-66k vs 276 rows -> the quoted numbers/CIs are not from this file')

main_tab.to_csv('analysis/main_table_Q8_valid194_M1.csv', index=False)
sens_tab.to_csv('analysis/sensitivity_4bases_x_2metrics.csv', index=False)
top_tab.to_csv('analysis/sensitivity_top_ranks_summary.csv', index=False)
map_tab.to_csv('analysis/sensitivity_arbitrary_others_mapping.csv')
d14_tab.to_csv('analysis/d14_association_rule_learning_by_role_NOT_the_answer.csv', index=False)
audit['feasibility_of_quoted_numbers'] = feas
audit['main_table_top2'] = main_tab.head(2)[['role', 'k', 'n', 'pct', 'ci95_lo', 'ci95_hi']].to_dict('records')
with open('analysis/audit_and_diagnostics.json', 'w') as f:
    json.dump(audit, f, indent=2, default=str)

pd.set_option('display.width', 250); pd.set_option('display.max_columns', 40)
print("=== MAIN: base B2 n=194, metric M1 ===")
print(main_tab[['rank','role','k','n','pct','boot_se','ci95_lo','ci95_hi','bca_lo','bca_hi','normal_lo','normal_hi']].to_string(index=False))
print("\n=== TOP ranks across 4 bases x 2 metrics ===")
print(top_tab.to_string(index=False))
print("\n=== M1 percentages pivot (base x role) ===")
print(sens_tab[sens_tab.metric=='M1_quoted_share'].pivot(index='role', columns='base', values='pct').round(2).to_string())
print("\n=== D14 association-rule learning (NOT the answer) overall:", d14_overall)
print(d14_tab.to_string(index=False))
print("\n=== feasibility of quoted numbers ===")
print(json.dumps(feas, indent=2))
print("\n=== arbitrary Others mapping (sensitivity only) ===")
print(map_tab.to_string())

# --------------------------------------------------------------- paired bootstrap: is the top-2 real?
sub = df.loc[base_valid, COLS]
Y = sub.eq('quoted').to_numpy().astype(float)
n = len(Y)
rng = np.random.default_rng(SEED)
idx = rng.integers(0, n, size=(B, n))
BY = Y[idx].mean(axis=1) * 100                       # B x 8
names = list(ROLES.keys())
i_pl, i_ds, i_ba = names.index('Project Lead / Project Manager'), names.index('Data Scientist'), names.index('Business Analyst')

def contrast(i, j):
    d = BY[:, i] - BY[:, j]
    obs = Y[:, i].mean() * 100 - Y[:, j].mean() * 100
    p_two = 2 * min((d <= 0).mean(), (d >= 0).mean())
    return dict(pair=f"{names[i]} vs {names[j]}", diff_pp=round(obs, 3),
                ci_lo=round(float(np.percentile(d, 2.5)), 3), ci_hi=round(float(np.percentile(d, 97.5)), 3),
                boot_se=round(float(d.std(ddof=1)), 3), p_two_sided_bootstrap=round(float(max(p_two, 1.0 / B)), 4))

contrasts = pd.DataFrame([contrast(i_pl, i_ds), contrast(i_ds, i_ba), contrast(i_pl, i_ba)])
contrasts.to_csv('analysis/paired_bootstrap_contrasts.csv', index=False)
print("\n=== paired bootstrap contrasts (base n=194, same resamples) ===")
print(contrasts.to_string(index=False))
audit['paired_contrasts'] = contrasts.to_dict('records')
with open('analysis/audit_and_diagnostics.json', 'w') as f:
    json.dump(audit, f, indent=2, default=str)
