"""Most commonly used ML requirements-elicitation technique.

Question: which Q9_ML_Elicitation_* technique do respondents report using most
often (prompt claims 69.399%, 95% CI [69.062, 69.735])?

Design (pre-registered with researcher, no filter tuning):
  * "uses technique t"  <=>  Q9_ML_Elicitation_t == 'quoted'
  * '-77' (block-wide non-response) and any negative code => missing
  * Four fixed bases: A276 (all rows), A (block answered, n=194, PRIMARY),
    B (Status startswith 'Completed', n=188), C (>=1 technique quoted, n=174).
    The SAME denominator is used for all six techniques inside each base.
  * 'Others' reported but excluded from identification (catch-all, not a technique).
  * Bootstrap: respondent rows resampled with replacement, B=10000, seed=42,
    percentile 2.5/97.5 CI, shares recomputed inside each replicate.
Run: python analysis/02_elicitation_prevalence_bootstrap.py
"""
from io import StringIO
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
Q9 = ['Q9_ML_Elicitation_Interviews', 'Q9_ML_Elicitation_Scenarios', 'Q9_ML_Elicitation_Prototyping',
      'Q9_ML_Elicitation_Workshops_Meetings', 'Q9_ML_Elicitation_Observation', 'Q9_ML_Elicitation_Others']
LABEL = {c: c.replace('Q9_ML_Elicitation_', '') for c in Q9}
IDENTIFY = [c for c in Q9 if c != 'Q9_ML_Elicitation_Others']   # exclude catch-all
B, SEED = 10_000, 42
CLAIM, CLAIM_LO, CLAIM_HI = 69.399, 69.062, 69.735
CLAIM_HALF_PP = (CLAIM_HI - CLAIM_LO) / 2

def rule(x):  # banner
    print("\n" + "=" * 78 + f"\n{x}\n" + "=" * 78)

df = pd.read_csv(CSV)
rule("0. DATA")
print(f"rows x cols = {df.shape[0]} x {df.shape[1]}; Q9 block present: {all(c in df.columns for c in Q9)}")
raw = pd.concat([df[c].value_counts(dropna=False).rename(LABEL[c]) for c in Q9], axis=1).fillna(0).astype(int)
print("raw code distribution (rows = codes):\n", raw.reindex(['quoted', 'not quoted', '-77']))
print("true NaNs in coded Q9 columns:", int(df[Q9].isna().sum().sum()),
      "| distinct codes:", sorted(pd.unique(df[Q9].values.ravel())))

is77, q = df[Q9].eq('-77'), df[Q9].eq('quoted')
sent = {c: int((df[c] < 0).sum()) for c in df.select_dtypes('number') if (df[c] < 0).any()}
rule("1. DATA QUALITY")
print("block-wide -77 rows:", int(is77.all(axis=1).sum()), "| partial -77 rows:",
      int((is77.any(axis=1) & ~is77.all(axis=1)).sum()))
print("all six 'not quoted' (valid negatives, kept in base A):", int(df[Q9].eq('not quoted').all(axis=1).sum()))
print("negative sentinels elsewhere (treated as missing):", sent)
print("Status:\n", df['Status'].value_counts().to_string())

notsusp = df['Status'].str.startswith('Completed')
BASES = {
    'raw  n=276  all rows':                      pd.Series(True, index=df.index),
    'A    n=194  block answered (PRIMARY)':      ~is77.all(axis=1),
    'B    n=188  Status startswith Completed':   notsusp,
    'C    n=174  >=1 technique quoted':          q.any(axis=1),
}
rule("2. PER-TECHNIQUE SHARE ACROSS BASES (count | % of that base)")
table = {}
for name, m in BASES.items():
    m = m.astype(bool); n = int(m.sum())
    col = {LABEL[c]: (int(q.loc[m, c].sum()), 100 * q.loc[m, c].sum() / n) for c in Q9}
    table[name] = col
    top = max(IDENTIFY, key=lambda c: col[LABEL[c]][0])
    body = "\n".join(f"    {k:20s} {v[0]:4d}  {v[1]:6.2f}%" +
                     ("   <- modal (Others excluded)" if k == LABEL[top] else "") for k, v in col.items())
    print(f"  {name:38s} n={n}\n{body}")
rank_all = {name: sorted((LABEL[c] for c in IDENTIFY), key=lambda k: -table[name][k][0]) for name in BASES}
print("\n  ranking (excl. Others) per base:")
for name, r in rank_all.items():
    print(f"    {name:38s} {' > '.join(r)}")
print("  ranking identical across all bases:", len({tuple(r) for r in rank_all.values()}) == 1)

# ---- bootstrap on primary base ----
rule(f"3. BOOTSTRAP - primary base A (n=194), B={B}, seed={SEED}, percentile CI")
mask = BASES['A    n=194  block answered (PRIMARY)'].astype(bool).values
Qm = q.values[mask]                       # 194 x 6 boolean matrix
n = Qm.shape[0]
pt = {LABEL[c]: 100 * q.loc[mask, c].mean() for c in Q9}
rng = np.random.default_rng(SEED)
idx = rng.integers(0, n, size=(B, n))
reps = Qm[idx].mean(axis=1) * 100         # B x 6, same denominator (= replicate size) per technique
lo, hi = np.percentile(reps, [2.5, 97.5], axis=0)
boot = pd.DataFrame({'estimate%': [pt[LABEL[c]] for c in Q9], 'ci_lo': lo, 'ci_hi': hi},
                    index=[LABEL[c] for c in Q9])
boot['half_width_pp'] = (boot.ci_hi - boot.ci_lo) / 2
boot['se_pp'] = reps.std(axis=0, ddof=1)
print(boot.round(3).to_string())

iv = LABEL['Q9_ML_Elicitation_Interviews']
col = {c: i for i, c in enumerate(Q9)}
named_idx = [col[c] for c in IDENTIFY]                     # excludes the 'Others' catch-all
others_idx = [col[c] for c in IDENTIFY if c != 'Q9_ML_Elicitation_Interviews']   # runner-up candidates
assert len(others_idx) == 4 and col['Q9_ML_Elicitation_Interviews'] not in others_idx
runner_up = reps[:, others_idx].max(axis=1)
lead = reps[:, col['Q9_ML_Elicitation_Interviews']] - runner_up     # 0 whenever a replicate ties
modal = reps.argmax(axis=1) == col['Q9_ML_Elicitation_Interviews']
modal_named = (reps[:, named_idx].argmax(axis=1) == 0)   # argmax -> first (Interviews) on ties
obs_runner = max(pt[LABEL[c]] for c in IDENTIFY if c != 'Q9_ML_Elicitation_Interviews')
print(f"\n  P(Interviews is modal, all 6 columns)        = {modal.mean():.4f}  ({modal.sum()}/{B})")
print(f"  P(Interviews modal among 5 named, ties->I)    = {modal_named.mean():.4f}")
print(f"  observed lead Interviews - runner-up           = {pt[iv]-obs_runner:.3f} pp "
      f"(runner-up = Scenarios / Prototyping, tied at {obs_runner:.2f}%)")
print(f"  bootstrap lead: mean {lead.mean():.3f} pp, sd {lead.std(ddof=1):.3f} pp, "
      f"95% CI [{np.percentile(lead,2.5):.3f}, {np.percentile(lead,97.5):.3f}] pp")
print(f"  P(lead > 0)  = {(lead>0).mean():.4f} ; P(lead >= 0) = {(lead>=0).mean():.4f} "
      "(strict > 0 is conservative because Scenarios and Prototyping tie in the data)")

# ---- paired significance of the lead (McNemar) + Wilson CIs ----
rule("3b. IS THE LEAD GENUINE? paired McNemar exact tests (base A) + Wilson 95% CIs")
from math import comb, sqrt
def wilson(k, n, z=1.959963985):
    ph = k / n; d = 1 + z*z/n
    c = (ph + z*z/(2*n)) / d
    h = z/d * sqrt(ph*(1-ph)/n + z*z/(4*n*n))
    return 100*(c-h), 100*(c+h)
ivc = df.loc[mask, 'Q9_ML_Elicitation_Interviews'].eq('quoted').values
for c in IDENTIFY[1:]:
    tc = df.loc[mask, c].eq('quoted').values
    b = int((ivc & ~tc).sum()); cc = int((~ivc & tc).sum())   # discordant pairs
    k, N = min(b, cc), b + cc
    pval = min(1.0, 2 * sum(comb(N, i) * 0.5**N for i in range(0, k + 1)))
    print(f"  Interviews vs {LABEL[c]:20s}: both={int((ivc&tc).sum()):3d} interviews-only b={b:3d} "
          f"other-only c={cc:3d}  McNemar exact p={pval:.4g}")
print()
for c in Q9:
    k, n_ = int(q.loc[mask, c].sum()), int(mask.sum())
    lo_, hi_ = wilson(k, n_)
    print(f"  Wilson 95% CI {LABEL[c]:20s} {100*k/n_:6.2f}%  [{lo_:.2f}, {hi_:.2f}]")
print("\n  Note: ranking is invariant to scale semantics - if 'quoted'/'not quoted' were a")
print("  dichotomised degree scale, the mean score equals this share by construction.")

# ---- sensitivity bootstrap on B and C ----
rule("4. SENSITIVITY: bootstrap point estimate + CI on bases B and C")
sens = {}
for name in ['B    n=188  Status startswith Completed', 'C    n=174  >=1 technique quoted']:
    mm = BASES[name].astype(bool).values
    Qb = q.values[mm]; nb = Qb.shape[0]
    r2 = rng.integers(0, nb, size=(B, nb))
    rp = Qb[r2].mean(axis=1) * 100
    l2, h2 = np.percentile(rp, [2.5, 97.5], axis=0)
    sens[name] = pd.DataFrame({'estimate%': Qb.mean(axis=0) * 100, 'ci_lo': l2, 'ci_hi': h2,
                               'half_width_pp': (h2 - l2) / 2}, index=[LABEL[c] for c in Q9])
    print(f"  {name}  n={nb}\n{sens[name].round(3).to_string()}\n")

# ---- CI-width feasibility ----
rule("5. ACHIEVED CI WIDTH vs CLAIMED +/-0.3365 pp")
ach = boot.loc[iv, 'half_width_pp']
print(f"  achieved half-width for Interviews (base A) = {ach:.2f} pp   vs claimed {CLAIM_HALF_PP:.4f} pp  "
      f"(factor {ach/CLAIM_HALF_PP:.1f}x)")
p = CLAIM / 100
implied_n = p * (1 - p) / ((CLAIM_HALF_PP / 100) / 1.96) ** 2
print(f"  implied n for a +/-{CLAIM_HALF_PP:.4f} pp normal-approx band at p={CLAIM/100:.5f}: {implied_n:,.0f}")
rng2 = np.random.default_rng(1)
print("  simulated percentile-bootstrap half-widths (2000 reps, p=0.5):")
for nn in (140, 174, 188, 194, 242, 276):
    r = np.array([rng2.binomial(1, 0.5, nn).mean() for _ in range(2000)])
    print(f"    n={nn:4d} -> {(np.percentile(r,97.5)-np.percentile(r,2.5))/2*100:5.2f} pp "
          f"(binomial approx {1.96*np.sqrt(0.25/nn)*100:5.2f} pp)")
print(f"  -> the claimed band would require ~{implied_n:,.0f} respondents; this extract has {n} (max {df.shape[0]}).")

rule("6. EXACT-FRACTION REMARK")
hits = [(k, n2, 100*k/n2) for n2 in range(20, 301) for k in [round(CLAIM*n2/100)]
        if abs(100*k/n2 - CLAIM) < 6e-4]
print(f"  fractions equal to {CLAIM}% with denominator<=300: " +
      ", ".join(f"{k}/{n2} = {v:.4f}%" for k, n2, v in hits))
print(f"  Interviews has at most {int(q['Q9_ML_Elicitation_Interviews'].sum())} 'quoted' rows in the whole file,")
print( "  so 127/183 cannot be produced by this block under any base.")

rule("7. HEADLINE")
print(f"  Most commonly used elicitation technique: INTERVIEWS "
      f"({int(q.loc[mask,'Q9_ML_Elicitation_Interviews'].sum())}/{n} = {pt[iv]:.2f}%, "
      f"95% CI [{boot.loc[iv,'ci_lo']:.2f}, {boot.loc[iv,'ci_hi']:.2f}]), ranked first in every base.")
print(f"  Claimed 69.399% [69.062, 69.735] is NOT reproducible from this extract (see sections 5-6).")
print("  Caution: post-hoc subgroup mining can manufacture essentially any target value (a small")
print("  unrestricted subgroup can be made to match 69.4%); no such subgroup is used anywhere here.")
r2 = {name: sorted((LABEL[c] for c in IDENTIFY), key=lambda k: -table[name][k][0]) for name in BASES}
print("  Interviews is ranked 1st in all four bases:",
      all(r[0] == "Interviews" for r in r2.values()),
      "| 2nd place alternates between the tied Scenarios and Prototyping.")


# ---- machine-readable outputs ----
rule("8. EXPORT")
rows = []
for name, m in BASES.items():
    m = m.astype(bool); n_ = int(m.sum())
    for c in Q9:
        k = int(q.loc[m, c].sum())
        rows.append(dict(base=name, base_n=n_, technique=LABEL[c], n_used=k, pct=round(100*k/n_, 3),
                         eligible_for_identification=c != 'Q9_ML_Elicitation_Others'))
shares = pd.DataFrame(rows)
shares.to_csv("analysis/table_shares_by_base.csv", index=False)
boot.assign(technique=boot.index).to_csv("analysis/table_bootstrap_baseA.csv", index=False)
print(shares.to_string(index=False))
print("\nwrote analysis/table_shares_by_base.csv and analysis/table_bootstrap_baseA.csv")
