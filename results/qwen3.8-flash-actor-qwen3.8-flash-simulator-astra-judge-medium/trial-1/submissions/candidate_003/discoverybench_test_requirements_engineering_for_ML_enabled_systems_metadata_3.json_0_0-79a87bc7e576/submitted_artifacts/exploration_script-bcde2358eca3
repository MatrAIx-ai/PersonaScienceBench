"""Exploratory inspection (PLAN STAGE ONLY - no final estimates produced).

Purpose: establish the raw encoding of the Q9_ML_Elicitation_* block, data-quality
issues, and the set of candidate denominators for a prevalence estimate.
"""
import pandas as pd, numpy as np

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
Q9 = ['Q9_ML_Elicitation_Interviews', 'Q9_ML_Elicitation_Scenarios', 'Q9_ML_Elicitation_Prototyping',
      'Q9_ML_Elicitation_Workshops_Meetings', 'Q9_ML_Elicitation_Observation', 'Q9_ML_Elicitation_Others']

df = pd.read_csv(CSV)
print("shape:", df.shape)
print("Q9 block present:", all(c in df.columns for c in Q9))

print("\n== raw value distributions (Q9) ==")
for c in Q9:
    print(c, dict(df[c].value_counts(dropna=False)))
print("missing values in coded Q9 columns:", int(df[Q9].isna().sum().sum()))
print("distinct raw codes:", sorted(pd.unique(df[Q9].values.ravel())))

print("\n== sentinel / negative codes ==")
for c in df.select_dtypes('number').columns:
    neg = int((df[c] < 0).sum())
    if neg:
        print(f"  {c}: {neg} negative rows, codes={sorted(set(df.loc[df[c]<0, c]))}")
for c in [x for x in df.columns if df[x].dtype == object or str(df[x].dtype).startswith('str')]:
    n77 = int((df[c] == '-77').sum()); n99 = int((df[c] == '-99').sum()); n66 = int((df[c] == '-66').sum())
    if n77 or n99 or n66:
        print(f"  {c}: -77={n77} -99={n99} -66={n66}")

print("\n== Status ==")
print(df['Status'].value_counts(dropna=False).to_string())

print("\n== Q9 block non-response structure ==")
is77, q = df[Q9].eq('-77'), df[Q9].eq('quoted')
print("rows with entire block == -77:", int(is77.all(axis=1).sum()))
print("rows with partial -77:", int((is77.any(axis=1) & ~is77.all(axis=1)).sum()))
print("rows with >=1 'quoted':", int(q.any(axis=1).sum()))
print("rows all 'not quoted':", int(df[Q9].eq('not quoted').all(axis=1).sum()))
print(pd.crosstab(df['Status'], [is77.all(axis=1), q.any(axis=1)]).to_string())

print("\n== candidate prevalence bases ==")
notsusp = df['Status'].str.startswith('Completed')
bases = {
    'all rows': pd.Series(True, index=df.index),
    'block answered (no -77)': ~is77.all(axis=1),
    'Completed* status': notsusp,
    'block answered & Completed*': (~is77.all(axis=1)) & notsusp,
    '>=1 technique quoted': q.any(axis=1),
}
for name, m in bases.items():
    m = m.astype(bool); n = int(m.sum())
    sh = {c.replace('Q9_ML_Elicitation_', ''): round(100 * int(q.loc[m, c].sum()) / n, 3) for c in Q9}
    print(f"{name:28s} n={n:4d} top={max(sh, key=sh.get)}({max(sh.values())}%) {sh}")

print("\n== feasibility of reported CI half-width 0.3365 pp ==")
p = 0.69399
print("implied n for normal-approx half-width 0.3365pp:", round(p * (1 - p) / (0.003365 / 1.96) ** 2))
for n in (140, 174, 188, 194, 276):
    print(f"  n={n}: binomial half-width ~{1.96*np.sqrt(p*(1-p)/n)*100:.2f} pp")
