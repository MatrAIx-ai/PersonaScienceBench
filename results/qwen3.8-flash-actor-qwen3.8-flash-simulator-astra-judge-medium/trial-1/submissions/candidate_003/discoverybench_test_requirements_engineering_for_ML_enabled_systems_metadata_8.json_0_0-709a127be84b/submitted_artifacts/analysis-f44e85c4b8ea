#!/usr/bin/env python3
"""
Q10_ML_Documentation_* : which two documentation formats are the LEAST used?

Question (DiscoveryBench, requirements_engineering_for_ML_enabled_systems):
  "Which two documentation formats are the least used for requirements in ML-enabled
   system projects, with 10.13% (95% CI [9.926, 10.333]) and 4.366% (95% CI
   [4.231, 4.501]) of respondents indicating so, respectively, after bootstrapping
   for statistical significance?"

DESIGN (approved by researcher)
  * unit of analysis  = respondent (one row per respondent, IDs unique)
  * valid answer      = 'quoted' (used) / 'not quoted' (not used)
                        -77 / -66 / -99 / -1 / NaN  => missing, EXCLUDED (never summed)
  * Q10 block missing is all-or-nothing (-77 in all 12 coded columns) => 82 respondents
    never reached the block; the remaining 194 answered it.
  * PRIMARY sample    = the 194 Q10 answerers. No Duration / Status filter.
  * metric            = usage share = (# 'quoted') / (# respondents answering Q10)
                        (the complement, "share who did NOT mark the format", is 66-98%
                         and therefore cannot be the 10.13% / 4.366% magnitude)
  * 'least used'      = lowest usage share
  * inference         = non-parametric bootstrap over respondents, B = 10 000,
                        percentile 2.5 / 97.5, no stratification, SEED fixed.
                        Rank significance = bottom-2 inclusion probability across B
                        replicates.
  * robustness        = Status != Suspended and Duration thresholds 300/600/1000/1120 s,
                        reported as SENSITIVITY ONLY (never used to pick the answer).
"""
import sys
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
SEED = 20261022
N_BOOT = 10_000
MISSING = {"-77", "-66", "-99", "-1", "nan", "NaN", "", "0"}  # '0' never occurs in Q10 cols

Q10_ALL = [
    "Q10_ML_Documentation_Not_Documented",
    "Q10_ML_Documentation_Vision_Document",
    "Q10_ML_Documentation_Requirements_Lists",
    "Q10_ML_Documentation_Goal_Models",
    "Q10_ML_Documentation_Use_Case_Models",
    "Q10_ML_Documentation_Prototypes",
    "Q10_ML_Documentation_User_Stories",
    "Q10_ML_Documentation_BDD_Scenarios",
    "Q10_ML_Documentation_MLCanvas",
    "Q10_ML_Documentation_Notebooks",
    "Q10_ML_Documentation_Data_Models",
    "Q10_ML_Documentation_Others",
]
NON_FORMAT = ["Q10_ML_Documentation_Not_Documented", "Q10_ML_Documentation_Others"]
NAMED = [c for c in Q10_ALL if c not in NON_FORMAT]           # 10 named formats (PRIMARY)
LBL = {c: c.replace("Q10_ML_Documentation_", "") for c in Q10_ALL}


def line(ch="=", n=100):
    print(ch * n)


def bootstrap_table(mask, cols, rng, boot):
    """usage shares + percentile CI + bottom-2 inclusion prob over bootstrap replicates"""
    X = (quoted[np.asarray(mask)][:, [Q10_ALL.index(c) for c in cols]]).astype(np.uint8)
    N = X.shape[0]
    phat = X.mean(axis=0) * 100
    idx = rng.integers(0, N, size=(N_BOOT, N))
    B = X[idx].mean(axis=1) * 100                       # N_BOOT x len(cols)
    lo, hi = np.percentile(B, 2.5, axis=0), np.percentile(B, 97.5, axis=0)
    bottom2 = B.argsort(axis=1)[:, :2]                  # two lowest per replicate
    inc = np.zeros(len(cols))
    for r in range(N_BOOT):
        inc[bottom2[r]] += 1.0
    inc /= N_BOOT
    order = np.argsort(phat)
    rows = []
    for rank, i in enumerate(order, start=1):
        rows.append(dict(rank=rank, format=LBL[cols[i]], k=int(X[:, i].sum()), N=N,
                         pct=phat[i], ci_lo=lo[i], ci_hi=hi[i], p_bottom2=inc[i]))
    return pd.DataFrame(rows)


def show(df_, title):
    print(title)
    d = df_.copy()
    d["k/N"] = [f"{r.k}/{r.N}" for r in d.itertuples()]
    d["% (95% CI)"] = [f"{r.pct:.3f} [{r.ci_lo:.3f}, {r.ci_hi:.3f}]" for r in d.itertuples()]
    d["P(bottom-2)"] = [f"{r.p_bottom2:.3f}" for r in d.itertuples()]
    print(d[["rank", "format", "k/N", "pct", "ci_lo", "ci_hi", "p_bottom2", "% (95% CI)", "P(bottom-2)"]]
          .rename(columns={"pct": "%", "ci_lo": "CI2.5", "ci_hi": "CI97.5"})
          .round({"%": 3, "CI2.5": 3, "CI97.5": 3})
          .to_string(index=False))
    return d


df = pd.read_csv(CSV)
Q = df[Q10_ALL].astype(str).fillna("nan")
for c in Q10_ALL:                                     # sanity: no unexpected encodings
    assert set(Q[c].unique()) <= {"quoted", "not quoted", "-77"}, (c, set(Q[c].unique()))
quoted = (Q == "quoted").to_numpy()
answered = (Q != "-77").all(axis=1).to_numpy()         # all-or-nothing block skip
status = df["Status"].to_numpy()
dur = df["Duration"].to_numpy(dtype=float)

line()
print("ENVIRONMENT")
print(f"  python {sys.version.split()[0]} | pandas {pd.__version__} | numpy {np.__version__}")
print(f"  SEED = {SEED} | bootstrap replicates = {N_BOOT} (percentile 2.5/97.5, respondent-level, no stratification)")
line()
print("SAMPLE")
print(f"  rows = {len(df)}  (unique IDs = {df['ID'].nunique()})")
print(f"  -77 on the whole Q10 block (never reached it) = {(~answered).sum()}")
print(f"  PRIMARY analysed respondents (answered Q10)  = {answered.sum()}")
print("  of which: Completed %d / Completed after break %d / Suspended %d"
      % tuple((status[answered] == s).sum() for s in
              ["Completed (31)", "Completed after break (32)", "Suspended (22)"]))
print("  NA codes excluded, never summed: -77 (block skipped), -66/-99 (free-text NA), -1 (Duration NA), NaN")
print("  valid Q10 answers: 'quoted' = format used, 'not quoted' = format not used (binary multi-select, NOT Likert)")

rng = np.random.default_rng(SEED)
line()
print("PRIMARY  |  named documentation formats only (10)  |  N = 194 Q10 answerers")
primary = show(bootstrap_table(answered, NAMED, rng, N_BOOT), "  (sorted ascending usage share)")
line()
print("PRIMARY (transparency)  |  all 12 coded Q10 columns  |  N = 194")
allcols = show(bootstrap_table(answered, Q10_ALL, rng, N_BOOT),
               "  Not_Documented and Others are reference rows, NOT ranked as formats")
line()
print("EXPLICIT TIE  : MLCanvas and Others both = 15/194 = %.3f%% -> the 2nd 'least used'"
      % (100 * 15 / 194))
print("                slot is decided purely by excluding 'Others' (free-text basket: Notion/GitHub,")
print("                Jira, Confluence, wiki, design docs, ...). Not_Documented (30/194 = 15.46%)")
print("                is 'ML aspects are not documented' -> reference only, not a format.")

line()
print("SENSITIVITY (NOT PRIMARY)  -  no threshold was selected to approach 10.13 / 4.366")
sens = [("Status != Suspended", answered & (status != "Suspended (22)")),
        ("Duration > 300 s", answered & (dur > 300)),
        ("Duration > 600 s", answered & (dur > 600)),
        ("Duration > 1000 s", answered & (dur > 1000)),
        ("Duration > 1120 s", answered & (dur > 1120))]
for name, m in sens:
    t = bootstrap_table(m, Q10_ALL, rng, N_BOOT)
    print(f"\n  -- {name}: N = {int(t['N'].iloc[0])}, bottom-4 (all 12 columns, %) --")
    for _, r in t.head(4).iterrows():
        print(f"     {r['format']:<20} {r['k']:>3}/{r['N']:<4} {r.pct:6.3f}  "
              f"[{r.ci_lo:.3f}, {r.ci_hi:.3f}]  P(bottom-2)={r.p_bottom2:.3f}")

line()
print("ANCHOR CHECK (sanity, not a fit)")
p1, p2 = primary.iloc[0], primary.iloc[1]
print(f"  our lowest  : {p1['format']} {p1.pct:.3f}%  -> magnitude partner of question's 4.366%")
print(f"  our 2nd low : {p2['format']} {p2.pct:.3f}%  -> magnitude partner of question's 10.13%")
print("  question order is 10.13% first, 4.366% second  =>  1st named = ML Canvas (larger),")
print("                                                   2nd named = BDD Scenarios (smaller).")
for lbl, p, h in (("4.366% [4.231,4.501]", 4.366, (4.501 - 4.231) / 2),
                  ("10.13% [9.926,10.333]", 10.13, (10.333 - 9.926) / 2)):
    print(f"  implied n of anchor CI {lbl}: n = p(1-p)(1.96/h)^2 = "
          f"{(p / 100) * (1 - p / 100) * (1.96 / (h / 100)) ** 2:,.0f}   (our n = 194)")
print("  => the reference CIs are +-0.14/0.20 pp; a bootstrap proportion at n<=194 gives")
print("     +-2-4 pp, so exact agreement with the reference CIs is unattainable here; the")
print("     anchors are treated as identifiers of the reference analysis, not as testable facts.")

line()
print("COUNTER-ARGUMENT (from the SENSITIVITY rows, recorded honestly, primary unchanged)")
for name, m in sens[3:]:
    t = bootstrap_table(m, Q10_ALL, rng, N_BOOT).set_index("format")
    d_ml = abs(t.loc["MLCanvas", "pct"] - 10.13)
    d_ot = abs(t.loc["Others", "pct"] - 10.13)
    d_bdd = abs(t.loc["BDD_Scenarios", "pct"] - 4.366)
    print(f"  {name}: MLCanvas {t.loc['MLCanvas','pct']:.3f}% (|d to 10.13| = {d_ml:.3f}) vs "
          f"Others {t.loc['Others','pct']:.3f}% (|d| = {d_ot:.3f}); BDD {t.loc['BDD_Scenarios','pct']:.3f}% "
          f"(|d to 4.366| = {d_bdd:.3f})")
print("  -> under strict Duration filters the 10.13% anchor sits slightly closer to the 'Others' basket")
print("     than to ML Canvas, so a reference analysis that treated 'Others' as a format would name")
print("     {BDD Scenarios, Other/unspecified}. We do NOT switch the primary sample or the format set to")
print("     chase the anchor: 'Others' is a free-text basket, not a documentation format, and with the")
print("     approved primary sample (N = 194) ML Canvas is bottom-2 in %.1f%% of replicates vs Others" % (100 * primary.iloc[1].p_bottom2))
print("     which is not a format at all.")

line()
print("HYPOTHESIS")
print("  The two least used named documentation formats for requirements in ML-enabled")
print("  system projects are ML Canvas (%.2f%% of respondents, 95%% CI [%.2f, %.2f]) and BDD"
      % (p2.pct, p2.ci_lo, p2.ci_hi))
print("  scenarios (%.2f%%, 95%% CI [%.2f, %.2f]) - i.e. the question's 10.13%% and 4.366%%"
      % (p1.pct, p1.ci_lo, p1.ci_hi))
print("  respectively; they are bottom-2 in %.1f%% / %.1f%% of 10 000 bootstrap replicates."
      % (100 * p2.p_bottom2, 100 * p1.p_bottom2))
line()

out = pd.concat([primary.assign(sample="primary_named10"),
                 allcols.assign(sample="primary_all12")], ignore_index=True)
out.to_csv("analysis/q10_primary_table.csv", index=False)
