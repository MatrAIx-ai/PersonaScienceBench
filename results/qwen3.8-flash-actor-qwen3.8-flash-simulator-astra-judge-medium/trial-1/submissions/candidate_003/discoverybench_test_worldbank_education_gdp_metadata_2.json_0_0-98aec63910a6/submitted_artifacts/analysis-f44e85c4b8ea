"""Education expenditure vs per-capita income: SSA vs LMC (World Bank WDI extract).
Design pre-registered with researcher: differencing-first; LMC carries income leg;
enrollment channel carries cross-group comparison; SSA income descriptive only."""
import numpy as np, pandas as pd, statsmodels.api as sm
pd.set_option('display.width',240); pd.set_option('display.max_columns',40)
RAW='data/worldbank_education_gdp.csv'
SHORT={'NY.GNP.PCAP.KD':'gni_pc','NY.ADJ.AEDU.GN.ZS':'edu_sav','SE.PRM.ENRR':'prim',
       'SE.SEC.ENRR':'sec','NE.EXP.GNFS.KD.ZG':'expg','SL.TLF.CACT.ZS':'lfpr'}
def load():
    raw=pd.read_csv(RAW,dtype=str)
    yc=[c for c in raw.columns if '[YR' in c]
    yrs=[int(c.split('[YR')[1].rstrip(']')) for c in yc]
    def p(s):
        s=str(s).strip()
        try: return float(s)
        except: return np.nan
    V=raw[yc].map(p).set_axis(yrs,axis=1)
    long=(raw[['Country Code','Series Code']].join(V)
          .melt(id_vars=['Country Code','Series Code'],var_name='year',value_name='v')
          .assign(series=lambda d:d['Series Code'].map(SHORT),year=lambda d:d['year'].astype(int)))
    return long.pivot_table(index=['Country Code','year'],columns='series',values='v').reset_index()
def grp(df,g): return df[df['Country Code']==g].set_index('year').drop(columns='Country Code').sort_index()
ROWS=[]
def reg(m,tag,grp_,win,T,trans,controls,keys,pv=True):
    ci=m.conf_int()
    for k in keys:
        if k not in m.params.index: continue
        ROWS.append(dict(model=tag,group=grp_,window=win,T=int(T),transformation=trans,controls=controls,
            term=k,coef=m.params[k],se=m.bse[k],ci_lo=ci.loc[k,0],ci_hi=ci.loc[k,1],
            p=(m.pvalues[k] if pv else np.nan)))
def ols(y,X,tag,grp_,win,trans,controls,keys,nw=4,pv=True):
    d=pd.concat([y.rename('y'),X],axis=1).dropna()
    m=sm.OLS(d['y'],sm.add_constant(d.drop(columns='y'))).fit(cov_type='HAC',cov_kwds={'maxlags':nw})
    reg(m,tag,grp_,win,len(d),trans,controls,keys,pv); return m,d
def detrend(s):
    d=s.dropna(); r=sm.OLS(d.values,sm.add_constant(np.arange(len(d)))).fit().resid
    return pd.Series(r,index=d.index)
def push(model,grp_,win,T,trans,controls,term,val,pv=np.nan):
    ROWS.append(dict(model=model,group=grp_,window=win,T=int(T),transformation=trans,controls=controls,
        term=term,coef=val,se=np.nan,ci_lo=np.nan,ci_hi=np.nan,p=pv))
def dcor(a,b,term,grp_,win,trans,model='detrended_partial_corr'):
    d=pd.concat([a.rename('a'),b.rename('b')],axis=1).dropna()
    if len(d)<4: return None
    push(model,grp_,win,len(d),trans,'linear time trend removed from each series separately',term,
         np.corrcoef(d['a'],d['b'])[0,1]); return np.corrcoef(d['a'],d['b'])[0,1],len(d)

df=load(); L,S=grp(df,'LMC'),grp(df,'SSF')
print("="*100+"\nA. SAMPLE MATRIX (non-missing obs per series per group)\n"+"="*100)
print(df.groupby('Country Code')[list(SHORT.values())].apply(lambda d:pd.Series({c:d[c].notna().sum() for c in SHORT.values()})).to_string())

print("\n"+"="*100+"\nB. LMC INCOME LEG (levels non-stationary: ADF p=1.00, AR1=0.998)\n"+"="*100)
lL=np.log(L[['gni_pc','edu_sav','prim','sec']])
m_lvl,d_lvl=ols(lL['gni_pc'],lL[['edu_sav','prim','sec']],'B1_level_elasticity_LMC','LMC','1975-2015',
  'log levels [NOT INTERPRETABLE - spurious: ADF p=1.00, AR1=0.998]','log prim, log sec',['edu_sav'])
print("B1 LEVEL (labelled non-interpretable): eps_edu = %+.3f  [%.3f, %.3f]  p=%.3f  T=%d"%(
 m_lvl.params['edu_sav'],*m_lvl.conf_int().loc['edu_sav'],m_lvl.pvalues['edu_sav'],len(d_lvl)))

dd=pd.DataFrame(index=L.index)
for v in ['gni_pc','edu_sav','prim','sec']: dd['d_'+v]=np.log(L[v]).diff()
for k in (1,2,3): dd[f'd_edu_lag{k}']=dd['d_edu_sav'].shift(k)
dd['trend']=np.arange(len(dd))-(len(dd)-1)/2
m_d,d_d=ols(dd['d_gni_pc'],dd[['d_edu_lag1','d_edu_lag2','d_edu_lag3','d_prim','d_sec','trend']],
  'B2_logdiff_primary_LMC','LMC','1976-2015','first difference of logs',
  'D log prim, D log sec, linear trend; Newey-West 4 lags',
  ['d_edu_lag1','d_edu_lag2','d_edu_lag3'])
for k in ['d_edu_lag1','d_edu_lag2','d_edu_lag3']:
    print("B2 PRIMARY %-11s = %+.4f [%+.4f, %+.4f] p=%.3f"%(k,m_d.params[k],*m_d.conf_int().loc[k],m_d.pvalues[k]))
print("B2 T=%d  R2=%.3f"%(len(d_d),m_d.rsquared))
cum=float(m_d.params[['d_edu_lag1','d_edu_lag2','d_edu_lag3']].sum())
pp=float(1/np.mean(np.exp(dd['d_edu_sav'].dropna()*0+np.log(L['edu_sav']).mean())))  # placeholder
logit_scale=1/L['edu_sav'].mean()          # dlog(edu) for a +1pp change in a ~3.5%% share
push('B3_cumulative_1to3_LMC','LMC','1976-2015',len(d_d),'sum of lag1-3 coefs (elasticity) x dlog for +1pp','as B2',
     'cum_pct_income_chg_per_+1pp_edu_sav',100*cum*logit_scale)
push('B3b_cumulative_elasticity_LMC','LMC','1976-2015',len(d_d),'sum of lag1-3 coefs (log-log elasticity)','as B2',
     'cum_elasticity',cum)
# CI for the cumulative linear combination via contrast test
R=np.zeros(len(m_d.params)); names=list(m_d.params.index)
for k in ['d_edu_lag1','d_edu_lag2','d_edu_lag3']: R[names.index(k)]=1.0
ct=m_d.t_test(R)
push('B3c_cumulative_CI_LMC','LMC','1976-2015',len(d_d),'contrast: sum of lag1-3 coefs','as B2','cum_elasticity',
     float(ct.effect[0]),float(ct.pvalue))
_sd=np.asarray(ct.sd).ravel(); _ci=np.asarray(ct.conf_int()).ravel()
ROWS[-1]['se']=float(_sd[0]); ROWS[-1]['ci_lo']=float(_ci[0]); ROWS[-1]['ci_hi']=float(_ci[1])
_e=np.asarray(ct.effect).ravel()
print("B3c cumulative contrast = %+.4f [%+.4f, %+.4f] p=%.3f"%(_e[0],_ci[0],_ci[1],float(np.asarray(ct.pvalue).ravel()[0])))
print("B3 cumulative elasticity lag1-3 = %+.4f ; scaled to a +1pp rise in a ~3.5%% savings share ~ %+.2f%% income growth over 3y"%(cum,100*cum*logit_scale))

rev=pd.DataFrame({'d_gni_lag1':dd['d_gni_pc'].shift(1)})
m_rev,_=ols(dd['d_edu_sav'],rev,'B4_reverse_causality_LMC','LMC','1976-2015',
  'first difference of logs','none; lagged income shock -> change in savings share',['d_gni_lag1'])
print("B4 REVERSE causality: D-log gni(t-1) -> D-log edu(t) = %+.3f [%+.3f, %+.3f] p=%.3f"%(
 m_rev.params['d_gni_lag1'],*m_rev.conf_int().loc['d_gni_lag1'],m_rev.pvalues['d_gni_lag1']))

lr=np.log(L[['gni_pc','edu_sav','prim','sec']]); lr['lfpr']=L['lfpr']; lr['expg']=L['expg']
m_r,d_r=ols(lr['gni_pc'].diff(),lr[['edu_sav','prim','sec','lfpr','expg']].diff(),
  'B5_restricted_T25_LMC','LMC','1991-2015','first difference of logs',
  'D lfpr, D expg, D prim, D sec (restricted robustness variant)',
  ['edu_sav','lfpr','expg'])
print("B5 RESTRICTED T=25 (1991-2015, adds LFPR+exports): D edu = %+.3f [%+.3f, %+.3f] p=%.3f"%(
 m_r.params['edu_sav'],*m_r.conf_int().loc['edu_sav'],m_r.pvalues['edu_sav']))

print("\n"+"="*100+"\nC. EDUCATION SAVINGS -> ENROLLMENT (both groups T=41) - LOAD-BEARING LEG\n"+"="*100)
for g,D in [('LMC',L),('SSF',S)]:
    le=pd.DataFrame(index=D.index); le['log_edu']=np.log(D['edu_sav'])
    le['edu_lag1']=le['log_edu'].shift(1); le['trend']=np.arange(len(le))-(len(le)-1)/2
    for o_ in ['prim','sec']:
        m1,d1=ols(D[o_],le[['log_edu','trend']],f'C1_level_{o_}_{g}',g,'1975-2015',
            'level (GER pts) on log savings share, contemporaneous','linear time trend; NW(4)',['log_edu'])
        m2,d2=ols(D[o_].diff(),pd.concat([le['edu_lag1'].diff().rename('d_edu_lag1'),le['trend'].rename('trend')],axis=1),
            f'C2_diff_{o_}_{g}',g,'1976-2015','first difference (GER pts/yr) on lagged D log savings',
            'linear time trend; NW(4)',['d_edu_lag1'])
        print(f"  {g} {o_:4s} LEVEL  log_edu = {m1.params['log_edu']:+8.2f} pp [{m1.conf_int().loc['log_edu',0]:+8.2f},{m1.conf_int().loc['log_edu',1]:+8.2f}] p={m1.pvalues['log_edu']:.4f} T={len(d1)}")
        sc=1/D['edu_sav'].mean()
        push(f'C2s_diff_scaled_{o_}_{g}',g,'1976-2015',len(d2),'first difference, rescaled to +1pp of savings share',
             'linear time trend; NW(4)','d_edu_lag1_pp',m2.params['d_edu_lag1']*sc)
        ROWS[-1]['ci_lo']=m2.conf_int().loc['d_edu_lag1',0]*sc; ROWS[-1]['ci_hi']=m2.conf_int().loc['d_edu_lag1',1]*sc
        ROWS[-1]['p']=m2.pvalues['d_edu_lag1']
        print(f"  {g} {o_:4s} DIFF   lag1    = {m2.params['d_edu_lag1']:+8.2f}    [{m2.conf_int().loc['d_edu_lag1',0]:+8.2f},{m2.conf_int().loc['d_edu_lag1',1]:+8.2f}] p={m2.pvalues['d_edu_lag1']:.4f} T={len(d2)}"
              f"  | per +1pp share: {m2.params['d_edu_lag1']*sc:+.2f} pp GER")

print("\n  Chow-style pooled group x savings interaction (common window 1991-2015):")
Lc=df[df['Country Code']=='LMC'].set_index('year').sort_index().assign(ssa=0.0)
Sc=df[df['Country Code']=='SSF'].set_index('year').sort_index().assign(ssa=1.0)
P=pd.concat([Lc,Sc])
P['log_edu']=np.log(P['edu_sav']); P['edu_x_ssa']=P['log_edu']*P['ssa']
P['trend']=P.groupby('Country Code').cumcount()+1.0
for o_ in ['prim','sec']:
    m3,d3=ols(P[o_],P[['log_edu','edu_x_ssa','ssa','trend']],f'C3_pooled_{o_}','LMC+SSF','1991-2015',
        'level, group x log-savings interaction','SSA dummy, linear trend; NW(4)',['log_edu','edu_x_ssa','ssa'])
    print(f"   {o_}: base log_edu = {m3.params['log_edu']:+.2f} (p={m3.pvalues['log_edu']:.4f}) | SSF interaction = {m3.params['edu_x_ssa']:+.2f} (p={m3.pvalues['edu_x_ssa']:.4f}) | SSA dummy = {m3.params['ssa']:+.2f} | T={len(d3)}")

print("\n"+"="*100+"\nD. SHARE-vs-BASE ARTIFACT: raw level vs linear-detrended vs differenced\n"+"="*100)
for g,D in [('LMC',L),('SSF',S)]:
    w=f"{int(D['gni_pc'].dropna().index.min())}-{int(D['gni_pc'].dropna().index.max())}"
    a,b=np.log(D['gni_pc']),np.log(D['edu_sav'])
    d0=pd.concat([a,b],axis=1).dropna()
    push('D1_raw_level_corr',g,w,len(d0),'log levels, no detrending','none','corr(log gni_pc, log edu_sav)',
         np.corrcoef(d0.iloc[:,0],d0.iloc[:,1])[0,1])
    dcor(detrend(a),detrend(b),'corr(log gni_pc, log edu_sav)',g,w,'linear-detrended log levels')
    dl=pd.concat([a.diff(),b.diff()],axis=1).dropna()
    dcorr=float(np.corrcoef(dl.iloc[:,0],dl.iloc[:,1])[0,1])
    push('D3_diff_corr',g,f"{int(dl.index.min())}-{int(dl.index.max())}",len(dl),'first difference of logs','none',
         'corr(Dlog gni_pc, Dlog edu_sav)',dcorr)
    dt = dcor(detrend(a),detrend(b),'corr(log gni_pc, log edu_sav)_dupcheck',g,w,'linear-detrended log levels')
    print(f"  {g} corr(log gni_pc, log edu_sav):  RAW {d0.corr().iloc[0,1]:+.3f} (T={len(d0)})"
          f"  ->  DETRENDED {dt[0]:+.3f} (T={dt[1]})  ->  DIFFERENCED {dcorr:+.3f} (T={len(dl)})")
print("\n  Enrollment channel, same three transformations (fully observed 1975-2015 both groups):")
for g,D in [('LMC',L),('SSF',S)]:
    e=detrend(np.log(D['edu_sav']))
    for lab,col in [('prim','prim'),('sec','sec')]:
        r1=dcor(e,detrend(D[col]),f'corr(detrend log edu, {lab})',g,'1975-2015','linear-detrended')
        dl=pd.concat([np.log(D['edu_sav']).diff(),D[col].diff()],axis=1).dropna()
        push('D3_diff_corr_enroll',g,'1976-2015',len(dl),'first differences','none',f'corr(Dlog edu, D{lab})',
             np.corrcoef(dl.iloc[:,0],dl.iloc[:,1])[0,1])
        rawr=pd.concat([np.log(D['edu_sav']),D[col]],axis=1).corr().iloc[0,1]
        print(f"  {g} edu->{lab:4s}: RAW {rawr:+.3f} | DETRENDED {r1[0]:+.3f} | DIFFERENCED {ROWS[-1]['coef']:+.3f} (T={len(dl)})")

print("\n"+"="*100+"\nE. SSA INCOME LEG: DESCRIPTIVE ONLY - no p-values (n=5 levels, n=4 changes)\n"+"="*100)
sd=S[['gni_pc','edu_sav','prim','sec','expg']].dropna(subset=['gni_pc'])
print(sd.round(2).to_string())
ssa_chg=(sd['gni_pc'].iloc[-1]/sd['gni_pc'].iloc[0]-1)*100
lmc_chg=(L['gni_pc'].loc[2015]/L['gni_pc'].loc[2011]-1)*100
push('E1_descriptive_pct_change','SSF','2011-2015',5,'level -> % change over 4 years',
     'none; NO p-value: 5 levels / 4 changes cannot support inference','pct_chg_gni_pc',ssa_chg)
push('E1_descriptive_pct_change','LMC','2011-2015',5,'level -> % change over 4 years',
     'same window, for comparability','pct_chg_gni_pc',lmc_chg)
print(f"\n  SSA GNI pc 2011->2015: {sd['gni_pc'].iloc[0]:.1f} -> {sd['gni_pc'].iloc[-1]:.1f} = {ssa_chg:+.2f}% (n=5 levels / n=4 changes)")
print(f"  LMC GNI pc 2011->2015: {L['gni_pc'].loc[2011]:.1f} -> {L['gni_pc'].loc[2015]:.1f} = {lmc_chg:+.2f}% (same window)")

print("\n  Timing asymmetry: savings share peaked 1995 while enrollment kept rising")
for g,D in [('LMC',L),('SSF',S)]:
    pk=int(D['edu_sav'].idxmax())
    pre,post=D.loc[1975:pk],D.loc[pk+1:2015]
    print(f"  {g}: edu_sav peak {D['edu_sav'].max():.2f}% in {pk}; 1975 {D['edu_sav'].iloc[0]:.2f} -> 2015 {D['edu_sav'].iloc[-1]:.2f}"
          f"  | post-peak change {D['edu_sav'].loc[pk+1:2015].iloc[-1]-D['edu_sav'].max():+.2f} pp")
    for lab in ['prim','sec']:
        for wname,seg in [(f'1975-{pk} (pre-peak)',pre),('post-peak-2015',post)]:
            sl=np.polyfit(seg.index,seg[lab],1)[0]
            push('E3_subperiod_slope',g,wname,len(seg),'OLS slope, GER points per year','none',f'slope_{lab}',sl)
        a1=np.polyfit(pre.index,pre[lab],1)[0]; a2=np.polyfit(post.index,post[lab],1)[0]
        print(f"     {g} {lab}: slope {a1:+.2f} pp/yr pre-peak (T={len(pre)})  vs  {a2:+.2f} pp/yr post-peak (T={len(post)})")

print("\n  Correlation of savings share with enrollment measured POST-PEAK only (removes the 1975-1995 rise):")
for g,D in [('LMC',L),('SSF',S)]:
    pk=int(D['edu_sav'].idxmax()); seg=D.loc[pk+1:2015]
    for lab in ['prim','sec']:
        r=np.corrcoef(np.log(seg['edu_sav']),seg[lab])[0,1]
        push('E4_postpeak_corr',g,f'{pk+1}-2015',len(seg),'log savings share vs GER level','none',f'corr(log edu, {lab})',r)
    print(f"   {g} post-peak corr(log edu, prim)={np.corrcoef(np.log(seg['edu_sav']),seg['prim'])[0,1]:+.3f}"
          f"  corr(log edu, sec)={np.corrcoef(np.log(seg['edu_sav']),seg['sec'])[0,1]:+.3f}  T={len(seg)}")


print("\n"+"="*100+"\nF. BREAKING THE SHARED DENOMINATOR: implied per-capita education-savings flow\n"+"="*100)
for g,D in [('LMC',L),('SSF',S)]:
    z=np.log(D['edu_sav']*D['gni_pc']); y=np.log(D['gni_pc'])
    d=pd.concat([y.rename('y'),z.rename('z')],axis=1).dropna()
    w=f"{int(d.index.min())}-{int(d.index.max())}"
    c_raw=float(np.corrcoef(d['y'],d['z'])[0,1]); c_dt=float(np.corrcoef(detrend(d['y']),detrend(d['z']))[0,1])
    dif=d.diff().dropna(); c_df=float(np.corrcoef(dif.iloc[:,0],dif.iloc[:,1])[0,1])
    push('F1_flow_corr',g,w,len(d),'log of (share x GNIpc) vs log GNIpc, raw','none','corr(log flow, log gni_pc)',c_raw)
    push('F1_flow_corr',g,w,len(d),'linear-detrended','linear trend removed from each series',
         'corr(log flow, log gni_pc)',c_dt)
    push('F1_flow_corr',g,f"{int(dif.index.min())}-{int(dif.index.max())}",len(dif),'first difference of logs','none',
         'corr(Dlog flow, Dlog gni_pc)',c_df)
    share_raw=float(np.corrcoef(np.log(D['gni_pc']),np.log(D['edu_sav']), )[0:2][0][1])
    if len(d)>=12:
        dd=pd.DataFrame({'dy':d['y'].diff(),'z_lag1':d['z'].diff().shift(1),'z_lag2':d['z'].diff().shift(2),
                         'trend':np.arange(len(d))}).dropna()
        mf,ddf=ols(dd['dy'],dd[['z_lag1','z_lag2','trend']],f'F2_flow_diff_{g}',g,'1976-2015',
            'first difference of logs of (share x GNIpc)','linear trend; NW(4)',['z_lag1','z_lag2'])
        print(f"  {g} per-capita FLOW vs income: RAW {c_raw:+.3f} | DETRENDED {c_dt:+.3f} | DIFFERENCED {c_df:+.3f}"
              f"   [share-based comparator from section D: RAW {share_raw:+.3f}]")
        print(f"  {g} DIFF Dlog gni ~ Dlog flow(t-1): {mf.params['z_lag1']:+.3f} [{mf.conf_int().loc['z_lag1',0]:+.3f},{mf.conf_int().loc['z_lag1',1]:+.3f}] p={mf.pvalues['z_lag1']:.3f} T={len(ddf)}")
    else:
        fl=(D['edu_sav']*D['gni_pc']).dropna()
        print(f"  {g} flow levels only (n={len(fl)}): {fl.iloc[0]:.0f} -> {fl.iloc[-1]:.0f} = {(fl.iloc[-1]/fl.iloc[0]-1)*100:+.2f}%  NO estimate, NO p-value")
        push('F3_flow_descriptive_pct_change',g,w,len(fl),'level -> % change','none; insufficient observations','pct_chg_flow_per_capita',
             float((fl.iloc[-1]/fl.iloc[0]-1)*100))

res=pd.DataFrame(ROWS)
res=res[res['term']!='corr(log gni_pc, log edu_sav)_dupcheck']
order=['B1_level_elasticity_LMC','B2_logdiff_primary_LMC','B3_cumulative_1to3_LMC','B4_reverse_causality_LMC',
 'B5_restricted_T25_LMC','D1_raw_level_corr','detrended_partial_corr','D3_diff_corr','D3_diff_corr_enroll',
 'C1_level_prim_LMC','C1_level_prim_SSF','C2_diff_prim_LMC','C2_diff_prim_SSF',
 'C1_level_sec_LMC','C1_level_sec_SSF','C2_diff_sec_LMC','C2_diff_sec_SSF','C3_pooled_prim','C3_pooled_sec',
 'E1_descriptive_pct_change','E3_subperiod_slope','E4_postpeak_corr']
res['_o']=res['model'].map({m:i for i,m in enumerate(order)}).fillna(99)
res=res.sort_values(['_o','group','term']).drop(columns='_o')
for c in ['coef','se','ci_lo','ci_hi','p']: res[c]=res[c].astype(float).round(4)
res.to_csv('out/results_master.csv',index=False)
print("\n"+"="*100+f"\nMASTER TABLE ({len(res)} rows) -> out/results_master.csv\n"+"="*100)
print(res[['model','group','window','T','term','coef','ci_lo','ci_hi','p']].to_string(index=False))
