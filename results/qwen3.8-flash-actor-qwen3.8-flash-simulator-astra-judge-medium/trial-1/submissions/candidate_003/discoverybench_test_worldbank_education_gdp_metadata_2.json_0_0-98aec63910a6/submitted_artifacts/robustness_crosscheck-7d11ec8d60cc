"""F. Breaking the shared-denominator link: implied per-capita education-savings flow.
edu_sav is a ratio to GNI, so income appears in the denominator of the regressor.
Multiplying the share by GNI per capita yields an absolute per-capita flow with no
shared denominator with the outcome. Computable for LMC 1975-2015, SSA 2011-2015 only."""
import numpy as np, pandas as pd, statsmodels.api as sm
exec(open('analysis.py').read().split("df=load();")[0])
df=load(); L,S=grp(df,'LMC'),grp(df,'SSF')
OUT=[]
for g,D in [('LMC',L),('SSF',S)]:
    z=np.log(D['edu_sav']*D['gni_pc']); y=np.log(D['gni_pc'])
    d=pd.concat([y.rename('y'),z.rename('z')],axis=1).dropna()
    print(f"\n--- {g}: implied per-capita education savings (share x GNIpc), T={len(d)} [{d.index.min()}-{d.index.max()}] ---")
    if len(d)>=8:
        raw=np.corrcoef(d['y'],d['z'])[0,0+1] if False else np.corrcoef(d['y'],d['z'])[0,1]
        dt=pd.DataFrame({'y':detrend(d['y']).values,'z':detrend(d['z']).values},index=d.index)
        dif=d.diff().dropna()
        print(f"  RAW log-level corr = {raw:+.3f} | DETRENDED = {np.corrcoef(dt.y,dt.z)[0,1]:+.3f} | DIFFERENCED = {np.corrcoef(dif.y,dif.z)[0,1]:+.3f} (T={len(dif)})")
        dd=pd.DataFrame({'dy':d['y'].diff(),'z_lag1':d['z'].diff().shift(1),'z_lag2':d['z'].diff().shift(2),
                         'trend':np.arange(len(d))})
        dd=dd.dropna()
        m=sm.OLS(dd['dy'],sm.add_constant(dd[['z_lag1','z_lag2','trend']])).fit(cov_type='HAC',cov_kwds={'maxlags':4})
        for k in ['z_lag1','z_lag2']:
            print(f"  DIFF gni ~ {k}: {m.params[k]:+.3f} [{m.conf_int().loc[k,0]:+.3f},{m.conf_int().loc[k,1]:+.3f}] p={m.pvalues[k]:.3f}  T={len(dd)}")
        OUT.append((g,'diff_elasticity_per_capita_flow',m))
    else:
        print("  T too small for any estimate -> descriptive only (levels below)")
        print(pd.concat([D['edu_sav'],D['gni_pc'],(D['edu_sav']*D['gni_pc']).rename('flow_pc')],axis=1).dropna().round(2).to_string())
print("\n--- SSA per-capita flow, 2011-2015 (levels only, n=5) ---")
sd=pd.DataFrame({'share':S['edu_sav'],'gni_pc':S['gni_pc'],'flow_per_capita':S['edu_sav']*S['gni_pc']}).dropna()
print(sd.round(2).to_string())
print("  flow 2011->2015: %.1f -> %.1f = %+.2f%%"%(sd.flow_per_capita.iloc[0],sd.flow_per_capita.iloc[-1],
      (sd.flow_per_capita.iloc[-1]/sd.flow_per_capita.iloc[0]-1)*100))
sl=pd.DataFrame({'share':L['edu_sav'],'gni_pc':L['gni_pc'],'flow_per_capita':L['edu_sav']*L['gni_pc']}).dropna()
print("--- LMC same window 2011-2015 ---")
print(sl.loc[2011:2015].round(2).to_string())
print("  LMC flow 2011->2015: %+.2f%%"%((sl.flow_per_capita.loc[2015]/sl.flow_per_capita.loc[2011]-1)*100))
print("\n  Full-sample per-capita flow growth 1975->2015 (LMC): %+.1f%%"%((sl.flow_per_capita.loc[2015]/sl.flow_per_capita.loc[1975]-1)*100))
