import pandas as pd, numpy as np
from statsmodels.tsa.stattools import adfuller
w=pd.read_csv('out/panel_long_series_in_cols.csv')
for g in ['LMC','SSF']:
    d=w[w['Country Code']==g].set_index('year').drop(columns='Country Code')
    print(f"--- {g} ADF (maxlag=2, autolag None) ---")
    for c in ['gni_pc','edu_sav','prim','sec','expg']:
        s=d[c].dropna()
        for lab,x in [('level',s),('logdiff',np.log(s).diff().dropna() if (s>0).all() else s.diff().dropna())]:
            try:
                st,p=adfuller(x,maxlag=2,autolag=None)[0:2]
                print(f"  {c:8s} {lab:7s} T={len(x):2d} ADF={st:7.3f} p={p:.3f}")
            except Exception as e: print(f"  {c:8s} {lab} skip {e}")
# mechanical denominator check: corr between log edu and log gni in diff space (LMC)
d=w[w['Country Code']=='LMC'].set_index('year').drop(columns='Country Code')
dl=np.log(d).diff().dropna(subset=['gni_pc','edu_sav'])
print("\nLMC diff-space corr(dlog gni, dlog edu) T=%d: %+.3f"%(len(dl),np.corrcoef(dl['gni_pc'],dl['edu_sav'])[0,1]))
print("LMC lag-1 corr(dlog gni_t, dlog edu_{t-1}) = %+.3f"%np.corrcoef(dl['gni_pc'].values[1:],dl['edu_sav'].values[:-1])[0,1])
print("LMC lag-1 corr(dlog edu_t, dlog gni_{t-1}) = %+.3f"%np.corrcoef(dl['edu_sav'].values[1:],dl['gni_pc'].values[:-1])[0,1])
print("LMC corr(dlog gni, dprim)=%+.3f  corr(dlog gni,dsec)=%+.3f corr(dlog gni,expg)=%+.3f"%(
 np.corrcoef(*np.log(d[['gni_pc','prim']]).diff().dropna().T), np.corrcoef(*np.log(d[['gni_pc','sec']]).diff().dropna().T),
 np.corrcoef(d['gni_pc'].pct_change().dropna(), d['expg'].reindex(d['gni_pc'].pct_change().dropna().index))[0,1]))
