import pandas as pd, numpy as np
pd.set_option('display.width', 260); pd.set_option('display.max_columns', 60)

raw = pd.read_csv('data/worldbank_education_gdp.csv', dtype=str)
print("RAW SHAPE:", raw.shape)
yearcols = [c for c in raw.columns if '[YR' in c]
meta = [c for c in raw.columns if c not in yearcols]
years = [int(c.split('[YR')[1].rstrip(']')) for c in yearcols]
print("n_meta =", len(meta), "| n_yearcols =", len(yearcols), "| years:", years[0], "->", years[-1])
print("META cols:", meta)
print("Groups:", raw['Country Code'].unique().tolist(), "|", raw['Country Group'].unique().tolist())
print("rows per group:", raw.groupby('Country Code').size().to_dict())
print("\nSERIES present:")
print(raw.groupby(['Series Code','Series Name']).size().to_string())

def parse(s):
    if s is None: return np.nan
    s=str(s).strip()
    if s in {'','.','..','NA','nan','NaN'}: return np.nan
    try: return float(s)
    except: return np.nan

Y = raw[yearcols].applymap(parse) if hasattr(raw,'applymap') else raw[yearcols].map(parse)
df = pd.concat([raw[meta], Y.set_axis(years, axis=1)], axis=1)
print("\nodd raw cells (non-numeric sentinels):",
      sorted({v for v in raw[yearcols].values.ravel().tolist() if v is not None and parse(v)!=parse(v)}))

rows=[]
for _,r in df.iterrows():
    vals = r[years].astype(float).values
    ok = ~np.isnan(vals); idx=np.where(ok)[0]
    rows.append(dict(grp=r['Country Code'], code=r['Series Code'],
        n_pop=int(ok.sum()), n_null=int((~ok).sum()), pct_null=round(100*(~ok).mean(),1),
        first=(years[idx.min()] if ok.any() else None), last=(years[idx.max()] if ok.any() else None),
        contiguous=bool((idx==np.arange(idx.min(),idx.max()+1)).all()) if ok.any() else False,
        minv=round(float(np.nanmin(vals)),2) if ok.any() else None,
        maxv=round(float(np.nanmax(vals)),2) if ok.any() else None,
        mean=round(float(np.nanmean(vals)),2) if ok.any() else None))
tab=pd.DataFrame(rows).sort_values(['code','grp'])
print("\n=== COVERAGE / NULL TABLE (each series has 41 year cells) ===")
print(tab.to_string(index=False))
print("\nn_populated pivot:\n", tab.pivot(index='code',columns='grp',values='n_pop'))
print("\npct_null pivot:\n", tab.pivot(index='code',columns='grp',values='pct_null'))

print("\n=== MISSING YEARS PER CELL ===")
for _,r in df.iterrows():
    v=r[years].astype(float).values
    miss=[y for y,x in zip(years,v) if np.isnan(x)]
    print(f"{r['Country Code']:4s} {r['Series Code']:22s} miss={len(miss):2d} {miss}")

codes=set(raw['Series Code'])
print("\nSE.XPD.TOTL.GD.ZS (% of total GOVT exp) present?", 'SE.XPD.TOTL.GD.ZS' in codes)
print("GDP-named series:", sorted({(c,n) for c,n in zip(raw['Series Code'],raw['Series Name']) if 'GDP' in str(n).upper()}))
print("Income pc series:", sorted({(c,n) for c,n in zip(raw['Series Code'],raw['Series Name']) if c.startswith('NY.')}))
print("All 6 codes:", sorted(codes))
