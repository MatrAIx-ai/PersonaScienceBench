import pandas as pd, numpy as np
pd.set_option('display.width',250)
raw=pd.read_csv('data/worldbank_education_gdp.csv',dtype=str)
yc=[c for c in raw.columns if '[YR' in c]; years=[int(c.split('[YR')[1].rstrip(']')) for c in yc]
def p(s):
    s=str(s).strip()
    try: return float(s)
    except: return np.nan
W=raw[yc].map(p).set_axis(years,axis=1)
key={'NY.GNP.PCAP.KD':'gni_pc','NY.ADJ.AEDU.GN.ZS':'edu_sav','SE.PRM.ENRR':'prim','SE.SEC.ENRR':'sec','NE.EXP.GNFS.KD.ZG':'expg','SL.TLF.CACT.ZS':'lfpr'}
long=(raw[['Country Code','Series Code']].join(W).melt(id_vars=['Country Code','Series Code'],
        var_name='year',value_name='v').assign(series=lambda d:d['Series Code'].map(key), year=lambda d:d['year'].astype(int)))
wide=long.pivot_table(index=['Country Code','year'],columns='series',values='v').reset_index().sort_values(['Country Code','year'])
wide.to_csv('out/panel_long_series_in_cols.csv',index=False)
print("TIDY FRAME shape:",wide.shape)
print(wide.groupby('Country Code').apply(lambda d:d.notna().sum().to_dict(),include_groups=False))

short={'NY.GNP.PCAP.KD':'gni','NY.ADJ.AEDU.GN.ZS':'edu','SE.PRM.ENRR':'prim','SE.SEC.ENRR':'sec','NE.EXP.GNFS.KD.ZG':'expg','SL.TLF.CACT.ZS':'lfpr'}
for g,d in long.groupby('Country Code'):
    w=d.pivot_table(index='year',columns='series',values='v')
    print(f"\n===== {g}: AR(1) persistence of LEVELS + window T with complete data =====")
    for c in w.columns:
        s=w[c].dropna()
        if len(s)>3:
            r=np.corrcoef(s.values[:-1],s.values[1:])[0,1]
            print(f"  {c:8s} T={len(s):2d} [{s.index.min()}-{s.index.max()}] AR1={r:.3f}")
    # max complete-case windows
    cc=w.dropna()
    print("  complete-case rows (all 6 series):",len(cc), (f"{cc.index.min()}-{cc.index.max()}" if len(cc) else ""))
    for k in [2,3,4]:
        sub=w.dropna(thresh=len(w.columns)-k)
        print(f"   allowed {k} missing -> rows={len(sub)}", f"{sub.index.min()}-{sub.index.max()}" if len(sub) else "")

print("\n===== OVERLAP WINDOW for gni & edu (both groups) =====")
for g in ['SSF','LMC']:
    w=wide[wide['Country Code']==g].set_index('year').drop(columns='Country Code')
    ov=w[['gni_pc','edu_sav']].dropna()
    print(f"{g}: gni&edu common T={len(ov)} {ov.index.min() if len(ov) else '-'}-{ov.index.max() if len(ov) else '-'}")
    ov2=w[['gni_pc','edu_sav','prim','sec']].dropna(); print(f"   +enrollment T={len(ov2)}")
    print(w.loc[ov.index].round(2).to_string() if len(ov) else "")

print("\n===== LEVELS SNAPSHOT: last 5 yrs & 1975 vs 2015 =====")
for g in ['LMC','SSF']:
    w=wide[wide['Country Code']==g].set_index('year').drop(columns='Country Code')
    print(g); print(w.loc[2011:2015].round(2).to_string())
    print("  1975:",w.loc[1975].round(2).dropna().to_dict())

# descriptive corr on the only SSA-common window and on LMC full/91-15
print("\n===== FEASIBILITY corr (descriptive only, no models) =====")
for g,cols in [('LMC',['1975-2015','1991-2015','2011-2015']),('SSF',['2011-2015'])]:
    w=wide[wide['Country Code']==g].set_index('year').drop(columns='Country Code')
    for wdw in cols:
        a,b=[int(x) for x in wdw.split('-')]
        s=w.loc[a:b,['gni_pc','edu_sav']]
        if s.dropna().shape[0]>2:
            print(f"  {g} {wdw}: T={s.dropna().shape[0]} corr(log gni, log edu)={np.corrcoef(np.log(s.dropna()['gni_pc']),np.log(s.dropna()['edu_sav']))[0,1]:.3f}")
# edu vs enrollment (fully observed both groups) - informative channel available for SSA
print("\n  edu vs enrollment corr (full 1975-2015):")
for g in ['LMC','SSF']:
    w=wide[wide['Country Code']==g].set_index('year').drop(columns='Country Code')
    for c in ['prim','sec','lfpr','expg']:
        s=w[['edu_sav',c]].dropna()
        print(f"   {g} edu~{c:6s} T={len(s):2d} corr={np.corrcoef(s['edu_sav'],s[c])[0,1]:+.3f}")
