"""Consolidate output/results.json into output/SUMMARY.md."""
import json, math
R = json.load(open("output/results.json"))

def T(block, term, key="coef"):
    for r in R[block]["_tests"].items():
        pass
    for r in block:
        if isinstance(r, dict) and r.get("term") == term:
            return r[key]
    raise KeyError(term)

def g(spec_block, term, key="coef"):
    for r in spec_block:
        if r["term"] == term:
            return r[key]
    raise KeyError(term)

L = []; A = L.append
s = R["samples"]
A("# NLSY79 1989 cross-section: age and dissaving (DISSAVED) - consolidated results\n")
A("## Samples\n")
A("| sample | n | P(DISSAVED=1) |\n|---|---|---|")
A(f"| as-delivered file (PRIMARY) | {s['full_n']:,} | {s['full_rate']:.4f} |")
A(f"| clean, curator-fill rows excluded (CO-PRIMARY) | {s['clean_n']:,} | {s['clean_rate']:.4f} |")
A(f"| deduplicated (sensitivity) | {s['dedup_n']:,} | {s['dedup_rate']:.4f} |")
A(f"| curator-filled rows only | {s['imputed_n']:,} | {s['imputed_rate']:.4f} |")
A(f"\nCorr(AGE,DISSAVED): full {s['corr_age_dissave_full']}, clean {s['corr_age_dissave_clean']}. "
  f"Exact duplicate rows {s['dup_rows']}. INCOME mean-fill {s['income_mean_fill']:.6f} (n={s['income_fill_n']}); "
  f"BMI mean-fill {s['bmi_mean_fill']:.6f} (n={s['bmi_fill_n']}); either fill n={s['either_fill_n']}. "
  f"INCOME top-code {s['income_topcode']} (n={s['income_topcode_n']}); INCOME==0 (n={s['income_zero_n']}).\n")

A("## Logistic models (AGE_c = AGE - 28)\n")
A("| sample | model | AGE_c (p) | AGE_c2 (p) | OR/yr at age 28 | joint-age LR p |\n|---|---|---|---|---|---|")
for tag, lbl in [("full_file", "as-delivered"), ("clean_nonimputed", "clean")]:
    q, bp, t = R[tag]["A_age_quad"], R[tag]["B_primary"], R[tag]["_tests"]
    A(f"| {lbl} | age + age2 | {g(q,'AGE_c'):+.4f} ({g(q,'AGE_c','p'):.4f}) | {g(q,'AGE_c2'):+.4f} ({g(q,'AGE_c2','p'):.4f}) | "
      f"{math.exp(g(q,'AGE_c')):.3f} | - |")
    A(f"| {lbl} | + GENDER, BLACK, HISPANIC, log(1+INCOME), INCOME==0 | {g(bp,'AGE_c'):+.4f} ({g(bp,'AGE_c','p'):.4f}) | "
      f"{g(bp,'AGE_c2'):+.4f} ({g(bp,'AGE_c2','p'):.4f}) | {math.exp(g(bp,'AGE_c')):.3f} | {t['lr_joint_age_primary'][2]} |")
A(f"\nTurning point of unadjusted quadratic: as-delivered {R['full_file']['_tests']['turning_point']} "
  f"[boot 95% CI {R['full_file']['_tests']['boot_ci']}] (support 24-32, CI overlaps only at 24-26.8); "
  f"clean {R['clean_nonimputed']['_tests']['turning_point']} "
  f"[boot 95% CI {R['clean_nonimputed']['_tests']['boot_ci']}] (uninformative).\n")

A("## Specification tests (LR)\n")
f, c = R["full_file"]["_tests"], R["clean_nonimputed"]["_tests"]
A("| test | as-delivered | clean |\n|---|---|---|")
A(f"| quadratic vs linear age | chi2={f['lr_quad_vs_lin'][0]}, df=1, p={f['lr_quad_vs_lin'][2]} | chi2={c['lr_quad_vs_lin'][0]}, df=1, p={c['lr_quad_vs_lin'][2]} |")
A(f"| saturated age dummies vs quadratic | chi2={f['lr_sat_vs_quad'][0]}, df=6, p={f['lr_sat_vs_quad'][2]} | chi2={c['lr_sat_vs_quad'][0]}, df=6, p={c['lr_sat_vs_quad'][2]} |")
A(f"| age x was_imputed interaction (linear) | chi2={R['gradient_diff']['lr_lin_interaction'][0]}, df=1, p={R['gradient_diff']['lr_lin_interaction'][2]} | (same test, full sample) |")

A("\n## Age-specific marginal effects (adjusted quadratic logit, delta-method 95% CI)\n")
A("| age | AME full | 95% CI | pred P full | AME clean | 95% CI | pred P clean |\n|---|---|---|---|---|---|---|")
for a, b in zip(f["ame_tab"], c["ame_tab"]):
    A(f"| {a['age']} | {a['ame']:+.4f} | [{a['lo']:+.4f}, {a['hi']:+.4f}] | {a['pred_rate']:.4f} | {b['ame']:+.4f} | [{b['lo']:+.4f}, {b['hi']:+.4f}] | {b['pred_rate']:.4f} |")

A("\n## Dissaving rate by age group (Wilson 95% CI)\n")
bt = {(r["sample"], r["group"]): r for r in R["bins"]}
A("| group | as-delivered | clean | curator-filled only |\n|---|---|---|---|")
for grp in ["24-26", "27-28", "29-32"]:
    def cell(k):
        r = bt.get((k, grp))
        return "-" if not r else f"{r['rate']:.4f} [{r['lo']:.3f},{r['hi']:.3f}] n={r['n']}"
    A(f"| {grp} | {cell('full')} | {cell('clean')} | {cell('imputed_only')} |")
A("\nExact-age rates: see output/tab_dissave_by_age.csv\n")

A("## Savings composition by age group (DISSAVED=0 pools 'same' + 'saved more')\n")
A("| sample | group | n | dissave | same/no-savings | saved more |\n|---|---|---|---|---|---|")
for r in R["composition_by_age"]:
    A(f"| {r['sample']} | {r['group']} | {int(r['n']):,} | {r['dissave']:.4f} | {r['same']:.4f} | {r['savemore']:.4f} |")

A("\n## Mechanism: the gradient lives entirely in the curator-filled rows\n")
gd = R["gradient_diff"]
A(f"- LR interaction (age x was_imputed), linear: chi2={gd['lr_lin_interaction'][0]}, df=1, p={gd['lr_lin_interaction'][2]}; "
  f"with quadratic interaction: chi2={gd['lr_quad_interaction'][0]}, df=2, p={gd['lr_quad_interaction'][2]}")
im = {r["term"]: r for r in gd["interaction_model"]}
A(f"- Interaction model: age slope among non-imputed rows = {im['AGE_c']['coef']:+.4f} (p={im['AGE_c']['p']:.3f}); "
  f"ADDITIONAL slope inside filled rows = {im['impx1']['coef']:+.4f} (p={im['impx1']['p']:.2g}); extra quadratic = {im['impx2']['coef']:+.4f} (p={im['impx2']['p']:.3f})")
ss = R["stratum_slopes"]
A(f"- Separate stratum fits: filled-rows-only OR/yr = {ss['imputed_only'][1]:.3f} ({ss['imputed_only'][2]:.3f}-{ss['imputed_only'][3]:.3f}, p={ss['imputed_only'][4]}); "
  f"clean-rows-only OR/yr = {ss['clean_only'][1]:.3f} ({ss['clean_only'][2]:.3f}-{ss['clean_only'][3]:.3f}, p={ss['clean_only'][4]})")
wim = {r["term"]: r for r in R["was_imputed_model"]}
A(f"- was_imputed indicator model: OR = {wim['was_imputed']['OR']:.3f} (p={wim['was_imputed']['p']:.2g}), AME = {R['was_imputed_pred']['ame_imputed']:.4f}; "
  f"age terms shrink to AGE_c={wim['AGE_c']['coef']:+.4f} (p={wim['AGE_c']['p']:.4f}), AGE_c2={wim['AGE_c2']['coef']:+.4f} (p={wim['AGE_c2']['p']:.3f})")
A(f"- Imputed share by age: {R['imputed_share_by_age']}")
A(f"- Imputed share by outcome: {R['imputed_share_by_dissaved']}  (0.39 among DISSAVED=0 vs 0.17 among DISSAVED=1)")

A("\n## Other covariates\n")
A(f"- Income, clean adjusted: OR per 1 log-unit = {c['income_OR']:.3f} (95% CI {c['income_OR_ci'][0]}-{c['income_OR_ci'][1]}), p={c['income_p']}, AME={c['income_ame_per_log']:.4f}/log-unit")
A(f"- Income, as-delivered adjusted: OR = {f['income_OR']:.3f} (95% CI {f['income_OR_ci'][0]}-{f['income_OR_ci'][1]}) - attenuated because 31% of rows sit exactly on the fill value")
bp = {r["term"]: r for r in R["clean_nonimputed"]["B_primary"]}
for t_, lbl in [("MALE","male"),("BLACK","black"),("HISPANIC","hispanic"),("INC0","INCOME==0")]:
    A(f"- {lbl} (clean adj): OR = {math.exp(bp[t_]['coef']):.3f} (p={bp[t_]['p']:.3g})")
bm = {r["term"]: r for r in R["bmi_check"]}
A(f"- BMI covariate check (as-delivered): OR per BMI unit = {math.exp(bm['BMI']['coef']):.4f} (p={bm['BMI']['p']:.3f}); age terms essentially unchanged (AGE_c p={bm['AGE_c']['p']:.5f})")
A(f"- Income-quartile robustness: as-delivered AGE_c={f['income_quart_spec_age_c']:+.4f}, AGE_c2={f['income_quart_spec_age_c2']:+.4f}; "
  f"clean AGE_c={c['income_quart_spec_age_c']:+.4f}, AGE_c2={c['income_quart_spec_age_c2']:+.4f}")
dd = {r["term"]: r for r in R["dedup_model"]}
A(f"- Deduplicated sensitivity (n={s['dedup_n']:,}): AGE_c={dd['AGE_c']['coef']:+.4f} (p={dd['AGE_c']['p']:.3f}), AGE_c2={dd['AGE_c2']['coef']:+.4f} (p={dd['AGE_c2']['p']:.3f}) -> gradient disappears, confirming duplicates ARE the fill artifact")

A("\n## Effect-size framing (adjusted predicted probabilities)\n")
for k, lbl in [("full_quad","as-delivered"),("clean_quad","clean"),("imputed_quad","curator-filled only")]:
    v = R["spans"][k]
    A(f"- {lbl}: P(dissave) age 24 -> 32 = {v['age24']:.4f} -> {v['age32']:.4f} ({v['delta_age']:+.4f}); "
      f"P at income p10 -> p90 (age 28) = {v['inc_p10']:.4f} -> {v['inc_p90']:.4f} ({v['delta_inc']:+.4f})")

A("\n## Multinomial sensitivity (base = same / no savings)\n")
A("| sample | contrast | AGE_c (p) | AGE_c2 (p) | log income (p) |\n|---|---|---|---|---|")
for tag, lbl in [("multinom_full_file","as-delivered"),("multinom_clean_nonimputed","clean")]:
    for ct in ["dissave_vs_same","savemore_vs_same"]:
        d = {r["term"]: r for r in R[tag][ct]}
        A(f"| {lbl} | {ct} | {d['AGE_c']['coef']:+.4f} ({d['AGE_c']['p']:.3f}) | {d['AGE_c2']['coef']:+.4f} ({d['AGE_c2']['p']:.3f}) | {d['LOGINC']['coef']:+.4f} ({d['LOGINC']['p']:.2g}) |")

txt = "\n".join(L) + "\n"
open("output/SUMMARY.md", "w").write(txt)
print(txt)
