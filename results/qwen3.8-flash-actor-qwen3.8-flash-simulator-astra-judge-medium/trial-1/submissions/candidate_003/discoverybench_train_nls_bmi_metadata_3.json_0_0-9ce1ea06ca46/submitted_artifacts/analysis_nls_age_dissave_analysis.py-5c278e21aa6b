"""
NLSY79 1989 cross-section: does age influence the likelihood of dissaving
(DISSAVED = 1 if withdrew more from savings than deposited)?

Researcher rulings implemented:
  primary    = as-delivered file (n=12,686, no dedup)
  co-primary = clean subset excluding curator mean-imputed rows (n~8,430)
  third      = was_imputed indicator model (differential-missingness mechanism)
Age form: logit in AGE_c = AGE-28 and AGE_c^2; LR tests vs linear and vs saturated
exact-age dummies; turning point with bootstrap CI; age-specific AMEs (delta method).
BMI excluded from primary spec (covariate check only). Income: log1p + INCOME==0
indicator primary, quartile dummies as robustness, no winsorizing.
"""
import json
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

import os

os.makedirs("output", exist_ok=True)
RNG = np.random.default_rng(20261025)
OUT = {}

def w(x, n=4):
    return None if x is None else round(float(x), n)

def wilson(k, n, z=1.96):
    if n == 0:
        return (np.nan, np.nan)
    p = k / n
    d = 1 + z * z / n
    c = p + z * z / (2 * n)
    m = z * np.sqrt(p * (1 - p) / n + z * z / (4 * n * n))
    return ((c - m) / d, (c + m) / d)

df = pd.read_csv("data/nls_bmi_processed.csv")
MI, MB = df.INCOME.mean(), df.BMI.mean()
inc_imp = np.isclose(df.INCOME, MI, atol=1e-9)
bmi_imp = np.isclose(df.BMI, MB, atol=1e-9)
df["was_imputed"] = (inc_imp | bmi_imp).astype(int)
df["MALE"] = (df.GENDER == "MALE").astype(int)
df["INC0"] = (df.INCOME == 0).astype(int)
df["LOGINC"] = np.log1p(df.INCOME.clip(lower=0))
df["AGE_c"] = df.AGE - 28.0
df["AGE_c2"] = df.AGE_c ** 2
df["IQ"] = pd.qcut(df.INCOME.where(df.INCOME > 0), 4, labels=False,
                   duplicates="drop").fillna(-1).astype(int)
df["OUT3"] = np.where(df.DISSAVED == 1, 1, np.where(df.SAMESAVE == 1, 0, 2))

df["impx1"] = df.AGE_c * df.was_imputed
df["impx2"] = df.AGE_c2 * df.was_imputed
CLEAN = df[df.was_imputed == 0].copy()
DEDUP = df.drop_duplicates().copy()

print("=" * 78)
print("SAMPLES: full n=%d (%.4f) | clean n=%d (%.4f) | dedup n=%d (%.4f) | imputed-only n=%d (%.4f)"
      % (len(df), df.DISSAVED.mean(), len(CLEAN), CLEAN.DISSAVED.mean(),
         len(DEDUP), DEDUP.DISSAVED.mean(), int(df.was_imputed.sum()),
         df.loc[df.was_imputed == 1, "DISSAVED"].mean()))
OUT["samples"] = {
    "full_n": len(df), "full_rate": w(df.DISSAVED.mean()),
    "clean_n": len(CLEAN), "clean_rate": w(CLEAN.DISSAVED.mean()),
    "dedup_n": len(DEDUP), "dedup_rate": w(DEDUP.DISSAVED.mean()),
    "imputed_n": int(df.was_imputed.sum()),
    "imputed_rate": w(df.loc[df.was_imputed == 1, "DISSAVED"].mean()),
    "income_mean_fill": float(MI), "income_fill_n": int(inc_imp.sum()),
    "bmi_mean_fill": float(MB), "bmi_fill_n": int(bmi_imp.sum()),
    "either_fill_n": int(df.was_imputed.sum()),
    "dup_rows": int(df.duplicated().sum()),
    "income_topcode": w(df.INCOME.max(), 6),
    "income_topcode_n": int((df.INCOME == df.INCOME.max()).sum()),
    "income_zero_n": int((df.INCOME == 0).sum()),
    "corr_age_dissave_full": w(df[["AGE", "DISSAVED"]].corr().iloc[0, 1]),
    "corr_age_dissave_clean": w(CLEAN[["AGE", "DISSAVED"]].corr().iloc[0, 1]),
}

print("\n" + "=" * 78 + "\nB. DISSAVING RATE BY AGE\n" + "=" * 78)
rows = []
for label, d in [("full", df), ("clean", CLEAN), ("imputed_only", df[df.was_imputed == 1])]:
    for a, g in d.groupby("AGE"):
        lo, hi = wilson(g.DISSAVED.sum(), len(g))
        rows.append(dict(sample=label, age=int(a), n=len(g), rate=g.DISSAVED.mean(), lo=lo, hi=hi))
by_age = pd.DataFrame(rows)
print(by_age.assign(**{c: by_age[c].round(4) for c in ["rate", "lo", "hi"]}).to_string(index=False))
by_age.to_csv("output/tab_dissave_by_age.csv", index=False)

bins, labs = [23, 27, 29, 32], ["24-26", "27-28", "29-32"]
brows = []
for label, d in [("full", df), ("clean", CLEAN), ("dedup", DEDUP), ("imputed_only", df[df.was_imputed == 1])]:
    t = d.assign(g=pd.cut(d.AGE, bins, labels=labs)).groupby("g", observed=True).DISSAVED
    for g, s in t:
        lo, hi = wilson(s.sum(), len(s))
        brows.append(dict(sample=label, group=g, n=len(s), rate=s.mean(), lo=lo, hi=hi))
bin_tab = pd.DataFrame(brows)
print("\nBinned (Wilson 95% CI):")
print(bin_tab.assign(**{c: bin_tab[c].round(4) for c in ["rate", "lo", "hi"]}).to_string(index=False))
bin_tab.to_csv("output/tab_dissave_by_agegroup.csv", index=False)
OUT["bins"] = bin_tab.round(4).to_dict("records")

mech = df.groupby("AGE").was_imputed.agg(["size", "mean"]).round(4)
print("\nDifferential missingness: imputed share by age\n", mech.to_string())
mech_o = df.groupby("DISSAVED").was_imputed.agg(["size", "mean"]).round(4)
print("imputed share by DISSAVED\n", mech_o.to_string())
OUT["imputed_share_by_age"] = {int(k): w(v) for k, v in df.groupby("AGE").was_imputed.mean().items()}
OUT["imputed_share_by_dissaved"] = {int(k): w(v) for k, v in df.groupby("DISSAVED").was_imputed.mean().items()}

SPECS = {
    "A_age_quad": "DISSAVED ~ AGE_c + AGE_c2",
    "A_age_lin": "DISSAVED ~ AGE_c",
    "B_primary": "DISSAVED ~ AGE_c + AGE_c2 + MALE + BLACK + HISPANIC + LOGINC + INC0",
    "C_income_quartiles": "DISSAVED ~ AGE_c + AGE_c2 + MALE + BLACK + HISPANIC + C(IQ) + INC0",
    "A_age_saturated": "DISSAVED ~ C(AGE)",
}

def fit(d, f):
    return smf.glm(f, data=d, family=sm.families.Binomial()).fit()

def lr(m_small, m_big):
    st = 2 * (m_big.llf - m_small.llf)
    dfree = int(m_big.df_model - m_small.df_model)
    return st, dfree, float(stats.chi2.sf(st, max(dfree, 1)))

def boot_turning(d, f, B=400):
    tps = []
    n = len(d)
    for _ in range(B):
        s = d.iloc[RNG.integers(0, n, n)]
        try:
            r = smf.glm(f, data=s, family=sm.families.Binomial()).fit()
            b1, b2 = r.params["AGE_c"], r.params["AGE_c2"]
            if abs(b2) > 1e-8:
                tps.append(28.0 - b1 / (2 * b2))
        except Exception:
            continue
    tps = np.array(tps)
    return (float(np.percentile(tps, 2.5)), float(np.percentile(tps, 97.5))), len(tps)

def age_ames(r, d, ages):
    names = list(r.params.index)
    b = r.params.values
    V = np.asarray(r.cov_params())
    Xfull = np.asarray(r.model.exog, dtype=float)
    out = []
    for a in ages:
        Xs = Xfull.copy()
        Xs[:, names.index("AGE_c")] = a - 28.0
        Xs[:, names.index("AGE_c2")] = (a - 28.0) ** 2
        i1, i2 = names.index("AGE_c"), names.index("AGE_c2")
        def ame_fn(bb):
            # dP/dage = p(1-p) * (b1 + 2*b2*(age-28)); averaged over the sample
            eta_der = bb[i1] + 2.0 * bb[i2] * (a - 28.0)
            pp = 1 / (1 + np.exp(-Xs @ bb))
            return float(np.mean(pp * (1 - pp) * eta_der))
        me = ame_fn(b)
        h = 1e-5
        grad = np.array([(ame_fn(b + h * np.eye(len(b))[i]) - ame_fn(b - h * np.eye(len(b))[i])) / (2 * h)
                         for i in range(len(b))])
        se = float(np.sqrt(max(grad @ V @ grad, 0.0)))
        pbar = float(np.mean(1 / (1 + np.exp(-Xs @ b))))
        out.append(dict(age=a, ame=me, se=se, lo=me - 1.96 * se, hi=me + 1.96 * se, pred_rate=pbar))
    return pd.DataFrame(out)

def model_block(tag, d):
    print("\n" + "=" * 78)
    print("MODELS [%s]  n=%d  base rate=%.4f" % (tag, len(d), d.DISSAVED.mean()))
    print("=" * 78)
    res, fits = {}, {}
    for sname, f in SPECS.items():
        r = fit(d, f)
        fits[sname] = r
        co = pd.DataFrame({"coef": r.params, "se": r.bse, "p": r.pvalues, "OR": np.exp(r.params)})
        ci = r.conf_int()
        co["lo"], co["hi"] = ci[0], ci[1]
        print("\n--- %s : %s" % (sname, f))
        print(co.round(4).to_string())
        print("  loglik=%.2f" % r.llf)
        res[sname] = co.round(5)
    t_lin, d1, p1 = lr(fits["A_age_lin"], fits["A_age_quad"])
    t_sat, d2, p2 = lr(fits["A_age_quad"], fits["A_age_saturated"])
    print("\nLR quadratic-vs-linear: chi2=%.3f df=%d p=%.4f" % (t_lin, d1, p1))
    print("LR saturated-vs-quadratic: chi2=%.3f df=%d p=%.4f" % (t_sat, d2, p2))
    b1 = fits["A_age_quad"].params["AGE_c"]; b2 = fits["A_age_quad"].params["AGE_c2"]
    tp = 28.0 - b1 / (2 * b2)
    (tp_lo, tp_hi), nb = boot_turning(d, SPECS["A_age_quad"])
    inside = bool(24 <= tp <= 32)
    overlap = bool(tp_lo <= 32 and tp_hi >= 24)
    print("Turning point (quad unadjusted) = %.2f; boot 95%% CI (%.2f, %.2f) B=%d; point inside 24-32: %s; CI overlaps 24-32: %s"
          % (tp, tp_lo, tp_hi, nb, inside, overlap))
    r = fits["B_primary"]
    ame_tab = age_ames(r, d, list(range(24, 33)))
    print("\nAge-specific AMEs (primary spec B, delta-method 95%% CI):")
    print(ame_tab.round(4).to_string(index=False))
    # LR test of joint age significance in primary spec
    t_age, dA, pA = lr(fit(d, "DISSAVED ~ MALE + BLACK + HISPANIC + LOGINC + INC0"), r)
    print("LR joint age terms in primary spec: chi2=%.3f df=%d p=%.4f" % (t_age, dA, pA))
    inc_lo, inc_hi = r.conf_int().loc["LOGINC"].values
    print("Income: OR per 1 log-unit = %.3f (95%% CI %.3f-%.3f) p=%.3g"
          % (np.exp(r.params["LOGINC"]), np.exp(inc_lo), np.exp(inc_hi), r.pvalues["LOGINC"]))
    # proper income AME by finite difference
    Xs = np.asarray(r.model.exog, dtype=float).copy()
    j = list(r.params.index).index("LOGINC")
    h = 0.01
    base = 1 / (1 + np.exp(-Xs @ r.params.values))
    p_hi = 1 / (1 + np.exp(-((Xs + np.eye(Xs.shape[1])[j] * h) @ r.params.values)))
    p_lo = 1 / (1 + np.exp(-((Xs - np.eye(Xs.shape[1])[j] * h) @ r.params.values)))
    inc_ame = float(np.mean((p_hi - p_lo) / (2 * h)))
    print("Income AME (recomputed, dP per 1 log unit) = %.4f" % inc_ame)
    res["_tests"] = dict(lr_quad_vs_lin=[w(t_lin, 3), d1, w(p1, 5)],
                         lr_sat_vs_quad=[w(t_sat, 3), d2, w(p2, 5)],
                         lr_joint_age_primary=[w(t_age, 3), dA, w(pA, 5)],
                         turning_point=w(tp, 2), boot_ci=[w(tp_lo, 2), w(tp_hi, 2)],
                         B=nb, tp_point_inside_support=inside, tp_ci_overlaps_support=overlap,
                         ame_tab=ame_tab.round(4).to_dict("records"),
                         income_OR=w(float(np.exp(r.params["LOGINC"]))),
                         income_OR_ci=[w(float(np.exp(inc_lo))), w(float(np.exp(inc_hi)))],
                         income_p=w(float(r.pvalues["LOGINC"]), 6),
                         income_ame_per_log=w(inc_ame),
                         income_quart_spec_age_c=w(fits["C_income_quartiles"].params["AGE_c"]),
                         income_quart_spec_age_c2=w(fits["C_income_quartiles"].params["AGE_c2"]))
    OUT[tag] = {k: (v.round(5).reset_index().rename(columns={"index": "term"}).to_dict("records")
                    if isinstance(v, pd.DataFrame) else v) for k, v in res.items()}
    return res

model_block("full_file", df)
model_block("clean_nonimputed", CLEAN)

print("\n" + "=" * 78 + "\nC. was_imputed INDICATOR MODEL (full file: mechanism)\n" + "=" * 78)
r_imp = fit(df, SPECS["B_primary"] + " + was_imputed")
co = pd.DataFrame({"coef": r_imp.params, "se": r_imp.bse, "p": r_imp.pvalues, "OR": np.exp(r_imp.params)})
print(co.round(4).to_string())
p0 = float(np.mean(1 / (1 + np.exp(-(np.asarray(r_imp.model.exog, dtype=float)
             - np.eye(len(r_imp.params))[list(r_imp.params.index).index("was_imputed")] * 1) @ r_imp.params.values))))
p1 = float(np.mean(1 / (1 + np.exp(-(np.asarray(r_imp.model.exog, dtype=float)) @ r_imp.params.values))))
print("Predicted dissaving rate with was_imputed=0 for all: %.4f ; observed file mean: %.4f" % (p0, df.DISSAVED.mean()))
print("AME of was_imputed (holding all else at observed) = %.4f" % (p1 - p0))
OUT["was_imputed_model"] = co.round(5).reset_index().rename(columns={"index": "term"}).to_dict("records")
OUT["was_imputed_pred"] = dict(all_nonimputed=w(p0), observed=w(df.DISSAVED.mean()), ame_imputed=w(p1 - p0),
                               p_value=w(float(r_imp.pvalues["was_imputed"]), 8))

print("\n" + "=" * 78 + "\nD. DEDUP SENSITIVITY (n=%d)" % len(DEDUP) + "\n" + "=" * 78)
r_dd = fit(DEDUP, SPECS["B_primary"])
print(pd.DataFrame({"coef": r_dd.params, "se": r_dd.bse, "p": r_dd.pvalues, "OR": np.exp(r_dd.params)}).round(4).to_string())
tp_dd = 28.0 - r_dd.params["AGE_c"] / (2 * r_dd.params["AGE_c2"])
print("dedup turning point = %.2f" % tp_dd)
OUT["dedup_model"] = pd.DataFrame({"coef": r_dd.params, "se": r_dd.bse, "p": r_dd.pvalues}).round(5).reset_index().rename(columns={"index": "term"}).to_dict("records")
OUT["dedup_turning_point"] = w(tp_dd, 2)

print("\n" + "=" * 78 + "\nE. BMI COVARIATE CHECK (not in primary)" + "\n" + "=" * 78)
r_bmi = fit(df, SPECS["B_primary"] + " + BMI")
print(pd.DataFrame({"coef": r_bmi.params, "se": r_bmi.bse, "p": r_bmi.pvalues}).round(5).to_string())
print("Age terms with BMI added: AGE_c=%.5f (p=%.3f), AGE_c2=%.5f (p=%.3f)"
      % (r_bmi.params["AGE_c"], r_bmi.pvalues["AGE_c"], r_bmi.params["AGE_c2"], r_bmi.pvalues["AGE_c2"]))
OUT["bmi_check"] = pd.DataFrame({"coef": r_bmi.params, "se": r_bmi.bse, "p": r_bmi.pvalues}).round(5).reset_index().rename(columns={"index": "term"}).to_dict("records")

print("\n" + "=" * 78 + "\nF. MULTINOMIAL SENSITIVITY (base = same/no-savings; 1=dissave, 2=saved more)" + "\n" + "=" * 78)
for tag, d in [("full_file", df), ("clean_nonimputed", CLEAN)]:
    dd = d[d.OUT3.isin([0, 1, 2])]
    mn = smf.mnlogit("OUT3 ~ AGE_c + AGE_c2 + MALE + BLACK + HISPANIC + LOGINC + INC0", data=dd).fit(disp=0)
    for lbl, pos in [("dissave_vs_same", 0), ("savemore_vs_same", 1)]:
        tab = pd.DataFrame({"coef": mn.params.iloc[:, pos].values, "se": mn.bse.iloc[:, pos].values,
                            "p": mn.pvalues.iloc[:, pos].values, "OR": np.exp(mn.params.iloc[:, pos].values)},
                           index=mn.params.iloc[:, pos].index)
        print("\n[%s | %s] n=%d" % (tag, lbl, len(dd)))
        print(tab.round(4).to_string())
        OUT.setdefault("multinom_" + tag, {})[lbl] = tab.round(5).reset_index().rename(columns={"index": "term"}).to_dict("records")
    OUT.setdefault("multinom_" + tag, {})["n"] = len(dd)
    print("category shares:", dd.OUT3.value_counts(normalize=True).round(4).to_dict())
    OUT.setdefault("multinom_" + tag, {})["shares"] = {int(k): w(v) for k, v in dd.OUT3.value_counts(normalize=True).items()}

with open("output/results.json", "w") as fh:
    json.dump(OUT, fh, indent=1, default=str)
print("\nDONE. Wrote output/results.json, output/tab_dissave_by_age.csv, output/tab_dissave_by_agegroup.csv")

print("\n" + "=" * 78 + "\nG. SAVINGS-COMPOSITION BY AGE (mechanical driver of pooled DISSAVED=0)\n" + "=" * 78)
comp = []
for tag, d in [("full_file", df), ("clean_nonimputed", CLEAN)]:
    g = d.assign(grp=pd.cut(d.AGE, [23, 27, 29, 32], labels=["24-26", "27-28", "29-32"])).groupby("grp", observed=True)
    t = g.apply(lambda x: pd.Series({"n": len(x), "dissave": x.DISSAVED.mean(),
                                     "same": x.SAMESAVE.mean(),
                                     "savemore": ((x.DISSAVED == 0) & (x.SAMESAVE == 0)).mean()}),
                include_groups=False)
    t.insert(0, "sample", tag)
    print(t.round(4).to_string())
    comp += t.round(4).reset_index().rename(columns={"grp": "group", "index": "group"}).to_dict("records")
OUT["composition_by_age"] = comp

print("\n" + "=" * 78 + "\nH. FORMAL TEST: DOES THE AGE GRADIENT DIFFER BY IMPUTATION STATUS?")
print("   (tested INSIDE the full sample via age x was_imputed interactions; the full and")
print("    clean subsets overlap, so an independent-samples Wald test would be invalid)")
pool = df.copy()
base_f = "DISSAVED ~ AGE_c + AGE_c2 + was_imputed + MALE + BLACK + HISPANIC + LOGINC + INC0"
main = fit(pool, base_f)
inter = fit(pool, base_f + " + impx1 + impx2")
inter2 = fit(pool, base_f + " + impx1")
st1, df1, pv1 = lr(main, inter)
st2, df2, pv2 = lr(main, inter2)
print("LR full quadratic interaction (impx1+impx2) vs main effects: chi2=%.3f df=%d p=%.3g" % (st1, df1, pv1))
print("LR linear interaction   (impx1 only)       vs main effects: chi2=%.3f df=%d p=%.3g" % (st2, df2, pv2))
print(pd.DataFrame({"coef": inter.params, "se": inter.bse, "p": inter.pvalues, "OR": np.exp(inter.params)}).round(4).to_string())
# within-group linear age slopes from a saturated-by-group fit
bygrp = fit(pool, "DISSAVED ~ (AGE_c + MALE + BLACK + HISPANIC + LOGINC + INC0) * was_imputed")
print("\nslope of age within non-imputed rows: %.4f (OR %.4f, p=%.3g)"
      % (bygrp.params["AGE_c"], np.exp(bygrp.params["AGE_c"]), bygrp.pvalues["AGE_c"]))
ix = [c for c in bygrp.params.index if "AGE_c:" in c or ":AGE_c" in c]
print("interaction term(s):", {c: (round(bygrp.params[c], 4), round(bygrp.pvalues[c], 4)) for c in ix})
lin_full = fit(df, "DISSAVED ~ AGE_c + MALE + BLACK + HISPANIC + LOGINC + INC0")
lin_clean = fit(CLEAN, "DISSAVED ~ AGE_c + MALE + BLACK + HISPANIC + LOGINC + INC0")
def per_year(r):
    b, se = r.params["AGE_c"], r.bse["AGE_c"]
    return np.exp(b), np.exp(b - 1.96 * se), np.exp(b + 1.96 * se), r.pvalues["AGE_c"]
pf, cf, cfu, pff = per_year(lin_full); pc, cc, ccu, pcc = per_year(lin_clean)
print("\nAdjusted OR per year of age (descriptive, separate fits): FULL %.3f (%.3f-%.3f, p=%.2g) | CLEAN %.3f (%.3f-%.3f, p=%.2g)"
      % (pf, cf, cfu, pff, pc, cc, ccu, pcc))
OUT["gradient_diff"] = dict(
    lr_quad_interaction=[w(st1, 3), df1, w(pv1, 8)],
    lr_lin_interaction=[w(st2, 3), df2, w(pv2, 8)],
    interaction_model=pd.DataFrame({"coef": inter.params, "se": inter.bse, "p": inter.pvalues}).round(5).reset_index().rename(columns={"index": "term"}).to_dict("records"),
    per_year_OR_full_descriptive=[w(pf, 4), w(cf, 4), w(cfu, 4), w(pff, 8)],
    per_year_OR_clean_descriptive=[w(pc, 4), w(cc, 4), w(ccu, 4), w(pcc, 8)])

print("\nI. LINEAR-AGE ADJUSTED MODEL (primary per-year summary)")
print(pd.DataFrame({"coef": lin_full.params, "se": lin_full.bse, "p": lin_full.pvalues,
                    "OR": np.exp(lin_full.params)}).round(4).to_string())
OUT["linear_adjusted_full"] = pd.DataFrame({"coef": lin_full.params, "se": lin_full.bse, "p": lin_full.pvalues,
    "OR": np.exp(lin_full.params)}).round(5).reset_index().rename(columns={"index": "term"}).to_dict("records")

with open("output/results.json", "w") as fh:
    json.dump(OUT, fh, indent=1, default=str)
print("\nDONE (incl. sections G-I).")

print("\n" + "=" * 78 + "\nJ. SLOPES BY IMPUTATION STRATUM + EFFECT-SIZE FRAMING\n" + "=" * 78)
imp_only = fit(df[df.was_imputed == 1], "DISSAVED ~ AGE_c + MALE + BLACK + HISPANIC")
b, se = imp_only.params["AGE_c"], imp_only.bse["AGE_c"]
print("Imputed-rows-only adjusted age slope = %.4f  OR/yr %.4f (%.4f-%.4f) p=%.3g"
      % (b, np.exp(b), np.exp(b - 1.96 * se), np.exp(b + 1.96 * se), imp_only.pvalues["AGE_c"]))
