def rate_span(tag, d, spec):
    r = fit(d, spec)
    pr = {}
    for a in [24, 32]:
        X = np.asarray(r.model.exog, dtype=float).copy()
        nm = list(r.params.index)
        X[:, nm.index("AGE_c")] = a - 28.0
        if "AGE_c2" in nm:
            X[:, nm.index("AGE_c2")] = (a - 28.0) ** 2
        pr[a] = float(np.mean(1 / (1 + np.exp(-X @ r.params.values))))
    # income contrast: p10 vs p90 of positive income, age fixed at 28
    lo_i, hi_i = np.log1p(np.percentile(d.INCOME[d.INCOME > 0], 10)), np.log1p(np.percentile(d.INCOME[d.INCOME > 0], 90))
    pri = {}
    for lbl, val in [("p10", lo_i), ("p90", hi_i)]:
        X = np.asarray(r.model.exog, dtype=float).copy()
        nm = list(r.params.index)
        if "LOGINC" in nm:
            X[:, nm.index("LOGINC")] = val
            X[:, nm.index("AGE_c")] = 0.0
            if "AGE_c2" in nm:
                X[:, nm.index("AGE_c2")] = 0.0
        pri[lbl] = float(np.mean(1 / (1 + np.exp(-X @ r.params.values))))
    print("[%s | %s] predicted P(dissave) age 24 -> 32: %.4f -> %.4f  (delta %+.4f)" % (tag, spec.split("~")[1][:22], pr[24], pr[32], pr[32] - pr[24]))
    print("      predicted P at income p10 -> p90 (age 28): %.4f -> %.4f  (delta %+.4f)" % (pri["p10"], pri["p90"], pri["p90"] - pri["p10"]))
    return dict(age24=w(pr[24]), age32=w(pr[32]), delta_age=w(pr[32] - pr[24]),
                inc_p10=w(pri["p10"]), inc_p90=w(pri["p90"]), delta_inc=w(pri["p90"] - pri["p10"]))

OUT["spans"] = {
    "full_quad": rate_span("full", df, "B_primary", ) if False else rate_span("full", df, SPECS["B_primary"]),
    "clean_quad": rate_span("clean", CLEAN, SPECS["B_primary"]),
    "imputed_quad": rate_span("imputed", df[df.was_imputed == 1], "DISSAVED ~ AGE_c + AGE_c2 + MALE + BLACK + HISPANIC"),
}
