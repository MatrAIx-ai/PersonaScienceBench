"""Which single control absorbs the raw exposure gradient? Fixed sample, leave-one-in."""
import numpy as np, pandas as pd, statsmodels.api as sm
D=pd.read_csv('analysis/analysis_dataset.csv')
DUM=['e_no_change','e_took_out','e_no_savings']
NEED=['dbmi']+DUM+['bmi89','age89','male','race_black','race_hisp','ever_jail','convicted','convicted_miss',
 'sentenced','sentenced_miss','mom_ed','dad_ed','asvab_z','asvab_code','wealth85_asinh','wealth85_top','income89','income89_top']
F=D.dropna(subset=NEED).copy(); B0=['bmi89']
def est(ctrl):
    d=F[['dbmi']+DUM+['e_dich']+B0+ctrl+['ID']].dropna()
    m=sm.OLS(d.dbmi,sm.add_constant(d[DUM+B0+ctrl])).fit(cov_type='cluster',cov_kwds={'groups':d.ID})
    md=sm.OLS(d.dbmi,sm.add_constant(d[['e_dich']+B0+ctrl])).fit(cov_type='cluster',cov_kwds={'groups':d.ID})
    return m,md
print('Single-control attribution (fixed n=4986, baseline bmi89 always in):')
print('%-28s %9s %9s %9s | %-9s %8s | %-9s %8s'%('added to baseline','no_chg','took_out','no_save','e_dich','p','F(3)','pF'))
for lab,ctrl in [('none (baseline only)',[]),('+ male',['male']),('+ race (2 dummies)',['race_black','race_hisp']),
                 ('+ age89',['age89']),('+ wealth85',['wealth85_asinh','wealth85_top']),
                 ('+ income89',['income89','income89_top']),('+ jail/convicted/sent',['ever_jail','convicted','convicted_miss','sentenced','sentenced_miss']),
                 ('+ parent edu',['mom_ed','dad_ed']),('+ ASVAB z',['asvab_z','asvab_code']),
                 ('ALL (spec d)',['male','race_black','race_hisp','age89','wealth85_asinh','wealth85_top','income89','income89_top','mom_ed','dad_ed','asvab_z','asvab_code','ever_jail','convicted','convicted_miss','sentenced','sentenced_miss'])]:
    m,md=est(ctrl); ft=m.f_test(np.eye(len(m.params))[[list(m.params.index).index(v) for v in DUM]])
    print('%-28s %+9.4f %+9.4f %+9.4f | %+9.4f %8.4f | %9.2f p%.3f'%(lab,m.params['e_no_change'],m.params['e_took_out'],m.params['e_no_savings'],md.params['e_dich'],md.pvalues['e_dich'],float(ft.fvalue),float(ft.pvalue)))

print('\nExposure-vs-confounder check: does wealth85 predict exposure? (multinomial-style, OLS on ordinal)')
for tgt in ['e_ord','e_dich']:
    dd=F.dropna(subset=[tgt])
    mm=sm.OLS(dd[tgt],sm.add_constant(dd[['wealth85_asinh','income89','asvab_z','mom_ed','dad_ed','male','age89','race_black','race_hisp']])).fit(cov_type='cluster',cov_kwds={'groups':dd.ID})
    print('  %s ~ SES: wealth85=%+.4f(p%.4f) income89=%+.4f(p%.4f) asvab=%+.4f(p%.4f) mom_ed=%+.4f(p%.4f)'%(
      tgt,mm.params['wealth85_asinh'],mm.pvalues['wealth85_asinh'],mm.params['income89'],mm.pvalues['income89'],
      mm.params['asvab_z'],mm.pvalues['asvab_z'],mm.params['mom_ed'],mm.pvalues['mom_ed']))
print('\nBaseline-difference check (the mechanical source of the raw gradient):')
g=D.dropna(subset=['bmi89','sav_cat']).groupby('sav_cat')['bmi89'].agg(['mean','size']).round(3)
g.index=['cat1 put in','cat2 took out','cat3 no change','cat4 no savings']
print(g.to_string())
g2=D.dropna(subset=['bmi92','sav_cat']).groupby('sav_cat')['bmi92'].agg(['mean','size']).round(3)
g2.index=g.index; print(g2.to_string())
print('\nsex composition of exposure groups (share male):')
print(D.dropna(subset=['sav_cat']).groupby('sav_cat')['male'].mean().round(3).to_string())
