"""
Build the cleaned analytic dataset from data/nls_raw.csv.
Cleaning rules agreed with researcher:
  height 1981 = FEET*100+INCHES -> decode; weight in POUNDS; BMI = 703*lb/in^2
  height 1985 primary, carry forward to 1989/1992; fall back to decoded 1981
  weight plausibility 70-500 lb; BMI window [13,70]
  topcodes: winsorize at p99 + keep indicator, NEVER delete
  ASVAB are stand-scores (~476/100) -> re-standardise to z; 555/666 -> NaN + indicator
  sparse criminal items -> 0-fill + missing indicator
Writes: analysis/analysis_dataset.csv
"""
import numpy as np, pandas as pd
CSV='data/nls_raw.csv'
ID='ID# (range 1-12686) 1979'
H81='Height of respondent, 1981'; H85='Height of respondent, 1985'
W81='Weight of respondent, 1981'; W89='Weight of respondent, 1989'; W92='Weight of respondent, 1992'
SV='Was more money put into or taken out of R/spouse savings since last interview, 1989'
W85c='Family net wealth, 1985'; W90c='Family net wealth, 1990'; W96c='Family net wealth, 1996 (key data point)'
IN89='Total net family income, previous calendar year, 1989'
ME="Highest grade completed by respondent's mother, 1979"
FE="Highest grade completed by respondent's father, 1979"
TOPCODE={'Total net family income, previous calendar year, 1979':75001,
         'Total net family income, previous calendar year, 1985':100001,
         IN89:1057448, W85c:1054132, W90c:1321099, W96c:1232183}
d=pd.read_csv(CSV)
out=pd.DataFrame({'ID':d[ID]})

# ---------- exposure: savings-ordinal, recoded by hypothesised impatience ----------
sv=d[SV]
out['sav_cat']=sv
out['e_no_change']=(sv==3).astype(float)
out['e_took_out'] =(sv==2).astype(float)
out['e_no_savings']=(sv==4).astype(float)
out.loc[sv.isna(),['e_no_change','e_took_out','e_no_savings']]=np.nan
# ordinal 0-3 (reference put-more-in -> 0, no change ->1, took out ->2, no savings ->3) ; reported for reference only
out['e_ord']=pd.Series(np.nan,index=d.index)
out.loc[sv==1,'e_ord']=0.0; out.loc[sv==3,'e_ord']=1.0
out.loc[sv==2,'e_ord']=2.0; out.loc[sv==4,'e_ord']=3.0
# primary dichotomy: high impatience = took out OR no savings  vs  low = put in OR no change
out['e_dich']=np.where(sv.isna(),np.nan,np.isin(sv,[2,4]).astype(float))
# strict dichotomy: drop 'no change' (cat 3)
out['e_dich_strict']=np.where(sv.isna(),np.nan,np.where(sv==2,2.0,np.where(sv==4,1.0,np.where(sv==1,0.0,np.nan))))
out['exp_missing']=sv.isna().astype(float)

# ---------- anthropometrics ----------
h81=12*(d[H81]//100)+(d[H81]%100)          # decode feet*100+inches -> inches
h85=d[H85]
h_pri=h85.fillna(h81)                       # 1985 primary, carry forward / 1981 fallback
out['h81_decoded']=h81; out['h_used']=h_pri
out['h_src_1985']=h85.notna().astype(float)
def wt(s):
    s=s.where(s.between(70,500))            # implausible / 996-type codes -> NaN
    return s
out['w81']=wt(d[W81]); out['w89']=wt(d[W89]); out['w92']=wt(d[W92])
out['bmi81']=np.where(out['w81'].notna()&h81.notna(),703*out['w81']/h81**2,np.nan)
out['bmi89']=np.where(out['w89'].notna()&h_pri.notna(),703*out['w89']/h_pri**2,np.nan)
out['bmi92']=np.where(out['w92'].notna()&h_pri.notna(),703*out['w92']/h_pri**2,np.nan)
for c in ['bmi81','bmi89','bmi92']: out[c]=out[c].where(out[c].between(13,70))
out['dbmi']=out.bmi92-out.bmi89
out['bmi92_missing']=out.bmi92.isna().astype(float)
out['n_waves']=out[['bmi81','bmi89','bmi92']].notna().sum(axis=1)
out['bmi_pmean']=out[['bmi81','bmi89','bmi92']].mean(axis=1,skipna=True)

# ---------- demographics / background ----------
out['age89']=d['Age of respondent at interview date, 1989']
out['age79']=d['Age of respondent, 1979']
out['male']=(d['Sex of respondent, 1979']==1).astype(float)
r=d['Racial/ethnic cohort, 1979']
out['race_black']=(r==1).astype(float); out['race_hisp']=(r==2).astype(float)  # ref = non-black non-hisp
out['mom_ed']=d[ME]; out['dad_ed']=d[FE]
out['mom_ed_miss']=out['mom_ed'].isna().astype(float); out['dad_ed_miss']=out['dad_ed'].isna().astype(float)

# ---------- ASVAB: stand-scores -> z ; 555/666 -> NaN + indicator ----------
A=[c for c in d.columns if 'ASVAB' in c]
z=[]; codes=np.zeros(len(d),bool)
for c in A:
    s=d[c].where(~d[c].isin([555,666]))
    codes|=d[c].isin([555,666]).values
    z.append((s-s.mean())/s.std())
out['asvab_z']=pd.concat(z,axis=1).mean(axis=1,skipna=True)
out['asvab_code']=codes.astype(float)
out['asvab_miss']=out['asvab_z'].isna().astype(float)

# ---------- wealth / income : winsorise at p99 + topcode indicator ----------
def clean_money(col, kind):
    s=d[col].astype(float).copy()
    tc=(s==TOPCODE[col]).astype(float)
    ok=s[s!=TOPCODE[col]]
    hi,lo=ok.quantile(.99),ok.quantile(.01)
    s=s.clip(lower=lo,upper=hi)
    ind=tc.astype(float)
    if kind=='asinh': v=np.arcsinh(s)          # wealth can be negative
    else: v=np.log1p(s.clip(lower=0))
    return pd.DataFrame({f'{kind}_{col[-6:-3] if False else col.split(", ")[-1]}':v,
                         'x':ind},index=d.index).rename(columns={'x':None})
w85=clean_money(W85c,'asinh'); inc89=clean_money(IN89,'lin')
out['wealth85_asinh']=w85.iloc[:,0]; out['wealth85_top']=w85.iloc[:,1]
out['income89']=d[IN89].where(d[IN89]!=TOPCODE[IN89])
q=out['income89'].quantile([.01,.99]); out['income89']=out['income89'].clip(q[.01],q[.99])
out['income89_top']=(d[IN89]==TOPCODE[IN89]).astype(float)
out['wealth96_asinh']=np.arcsinh(d[W96c].where(d[W96c]!=TOPCODE[W96c]))
out['dw wealth']=out['wealth96_asinh']-out['wealth85_asinh']   # for exposure proxy B (sensitivity)

# ---------- criminal / residence controls ----------
out['convicted_raw']=d['Ever convicted of an illegal act in adult court before 1980']
out['sent_raw']=d['Ever been sentenced in any correctional institution before 1980']
out['convicted']=out['convicted_raw'].fillna(0); out['convicted_miss']=out['convicted_raw'].isna().astype(float)
out['sentenced']=out['sent_raw'].fillna(0);      out['sentenced_miss']=out['sent_raw'].isna().astype(float)
RES=[c for c in d.columns if c.startswith('Type of residence')]
out['ever_jail']=d[RES].eq(5).any(axis=1).astype(float)
out['res_never_obs']=d[RES].isna().all(axis=1).astype(float)
# household-type urbanicity proxy in 1989: 11 = own dwelling unit ; 17/18/19 = parental
r89=d['Type of residence respondent is living in, 1989']
out['hh_own_dwelling']=(r89==11).astype(float); out['hh_parental']=r89.isin([17,18,19]).astype(float)
out['hh_1989_missing']=r89.isna().astype(float)

out.to_csv('analysis/analysis_dataset.csv',index=False)
print('wrote analysis/analysis_dataset.csv  rows=%d cols=%d'%(out.shape[0],out.shape[1]))
print('non-missing: exp=%d bmi89=%d bmi92=%d dbmi=%d wealth85=%d income89=%d asvab=%d'%(
  out.e_dich.notna().sum(),out.bmi89.notna().sum(),out.bmi92.notna().sum(),out.dbmi.notna().sum(),
  out.wealth85_asinh.notna().sum(),out.income89.notna().sum(),out.asvab_z.notna().sum()))
print('exposure dist (analytic rows):'); print(out.e_dich.value_counts(dropna=False).to_string())
print('\nbmi92 missing by exposure:'); print(out.groupby('sav_cat',dropna=False)['bmi92_missing'].mean().round(4).to_string())
print('\nkey sample: dbmi & exposure non-missing =',int((out.dbmi.notna()&out.e_dich.notna()).sum()))
