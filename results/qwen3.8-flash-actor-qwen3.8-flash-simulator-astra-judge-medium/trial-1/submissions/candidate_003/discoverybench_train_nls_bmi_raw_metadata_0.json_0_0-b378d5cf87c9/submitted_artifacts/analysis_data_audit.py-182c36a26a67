"""
NLSY79 raw-data audit for: "Does increased time preference lead to higher BMI?"
READ-ONLY exploration. No modelling executed here.
Run:  python3 analysis/data_audit.py
"""
import json, collections
import pandas as pd, numpy as np

CSV='data/nls_raw.csv'
ID='ID# (range 1-12686) 1979'
H81='Height of respondent, 1981'; H85='Height of respondent, 1985'
W81='Weight of respondent, 1981'; W89='Weight of respondent, 1989'; W92='Weight of respondent, 1992'
SV='Was more money put into or taken out of R/spouse savings since last interview, 1989'
PUT='Net amount respondent/spouse put into savings since last interview, 1989'
TOOK='Net amount respondent/spouse took out of savings since last interview, 1989'
W85c='Family net wealth, 1985'; W90c='Family net wealth, 1990'; W96c='Family net wealth, 1996 (key data point)'
ME="Highest grade completed by respondent's mother, 1979"
FE="Highest grade completed by respondent's father, 1979"
def hr(t): print('\n'+'='*78+f'\n{t}\n'+'='*78)

df=pd.read_csv(CSV)
ASVAB=[c for c in df.columns if 'ASVAB' in c]
RES=[c for c in df.columns if c.startswith('Type of residence')]

hr('1. SHAPE / DTYPES / RECONCILIATION vs datasets.json')
print('rows=%d cols=%d ; unique IDs=%d (min %d max %d)'%(df.shape[0],df.shape[1],df[ID].nunique(),df[ID].min(),df[ID].max()))
print('dtypes:',dict(df.dtypes.value_counts()))
spec=json.load(open('task.json'))['documents']['datasets.json']
spec=json.loads(spec) if isinstance(spec,str) else spec
declared=[c['name'] for c in spec['datasets'][0]['columns']['raw']]
print('declared=%d ; names match=%s ; ORDER identical=%s'%(len(declared),set(declared)==set(df.columns),list(df.columns)==declared))
print('declared-but-missing:',[c for c in declared if c not in set(df.columns)])
print('undeclared-in-file:',[c for c in df.columns if c not in set(declared)])
for y in ['1981','1985','1989','1990','1992','1996']:
    print('  %s: weight=%-5s height=%-5s age=%-5s residence=%-5s'%(y,
      any(f'Weight of respondent, {y}'==c for c in df.columns), any(f'Height of respondent, {y}'==c for c in df.columns),
      any('Age of respondent' in c and c.endswith(y) for c in df.columns),
      any(f'Type of residence respondent is living in, {y}'==c for c in df.columns)))
print('  income 1990/1996 columns present?',any('Total net family income' in c and ('1990' in c or '1996' in c) for c in df.columns))

hr('2. MISSINGNESS (% non-missing)')
for grp,cols in [('height/weight',[H81,H85,W81,W89,W92]),
                 ('savings 1989',[SV,PUT,TOOK]),
                 ('wealth/income',[W85c,W90c,W96c,'Total net family income, previous calendar year, 1979',
                                   'Total net family income, previous calendar year, 1985','Total net family income, previous calendar year, 1989']),
                 ('ASVAB / class rank',ASVAB+['Rank in class last year attended at this school, 1981',
                                              'Number of students in class last year attended at this school, 1981']),
                 ('background / criminal',[ME,FE,'Highest grade completed, 1979',
                                           'Ever convicted of an illegal act in adult court before 1980',
                                           'Ever been sentenced in any correctional institution before 1980'])]:
    print('-- '+grp)
    for c in cols: print('   %5.1f%%  n=%6d  %s'%(100*df[c].notna().mean(),df[c].notna().sum(),c))
print('-- residence (NO 1979, NO 1995 in file)')
for c in RES: print('   %5.1f%%  n=%6d  %s'%(100*df[c].notna().mean(),df[c].notna().sum(),c.split(', ')[-1]))

hr('3. UNIT CHECK height/weight + SENTINELS')
frac=df[H81]%100
print('%s raw range %.0f-%.0f ; frac part values=%s ; feet part=%s'%(H81,df[H81].min(),df[H81].max(),
      sorted(set(frac.dropna().astype(int))),sorted(set((df[H81]//100).dropna().astype(int)))))
h81i=12*(df[H81]//100)+(df[H81]%100)
print('-> H81 is FEET*100+INCHES. Decoded inches mean=%.2f sd=%.2f (M %.2f / F %.2f)'%(h81i.mean(),h81i.std(),
      h81i[df['Sex of respondent, 1979']==1].mean(),h81i[df['Sex of respondent, 1979']==2].mean()))
both=pd.DataFrame({'h81i':h81i,'h85':df[H85]}).dropna()
print('   corr(h81_decoded,h85)=%.4f ; median diff=%.1f in ; %.1f%% within 2 in'%(both.h81i.corr(both.h85),
      (both.h81i-both.h85).median(),100*np.mean(abs(both.h81i-both.h85)<=2)))
for c in [H85,W81,W89,W92]:
    s=df[c].dropna()
    print('%s: n=%d min=%.0f p50=%.0f p99=%.0f max=%.0f'%(c,len(s),s.min(),s.median(),s.quantile(.99),s.max()))
    hits={int(k):int(v) for k,v in s.value_counts().items() if int(k) in (95,98,99,996,999,9999)}
    if hits: print('     code-like values present:',hits)
print('\nBMI assuming weight=POUNDS (703*lb/in^2):')
for y,w,h in [(1981,W81,h81i),(1989,W89,df[H85]),(1992,W92,df[H85])]:
    b=(703*df[w]/h**2).dropna()
    print('   %d: n=%d mean=%.2f sd=%.2f p50=%.2f p99=%.2f <18.5=%.3f >=30=%.3f'%(y,len(b),b.mean(),b.std(),b.median(),b.quantile(.99),np.mean(b<18.5),np.mean(b>=30)))
print('BMI if weight were KG (dictionary claim): p50 1981=%.1f 1989=%.1f -> impossible, dictionary is wrong'%(
      (df[W81]/(h81i*.0254)**2).median(),(df[W89]/(df[H85]*.0254)**2).median()))
print('\nTopcodes/extremes (money):')
for c in ['Total net family income, previous calendar year, 1979','Total net family income, previous calendar year, 1985',
          'Total net family income, previous calendar year, 1989',W85c,W90c,W96c,PUT,TOOK]:
    vc=df[c].value_counts().head(2)
    print('   %-70s max=%11.0f nuniq=%4d top: %s'%(c[:70],df[c].max(),df[c].nunique(),', '.join(f'{k:g}x{v}' for k,v in vc.items())))
print('\nASVAB columns are NOT z-scores (dictionary lie):')
for c in ASVAB:
    s=df[c].dropna(); print('   %-46s n=%6d min=%.0f p50=%.0f max=%.0f mean=%.1f sd=%.1f'%(c[:46],len(s),s.min(),s.median(),s.max(),s.mean(),s.std()))
print('   555/666 codes sit INSIDE plausible range -> not separable:',{c[7:20]:int(df[c].isin([555,666]).sum()) for c in ASVAB})
print('   parent-edu 0 = "never attended" (mother %d father %d), max=20 -> not a missing code'%(int((df[ME]==0).sum()),int((df[FE]==0).sum())))

hr('4. TIME-PREFERENCE AVAILABILITY SCAN')
kw=['discount','delay','time prefer','patien','impatien','plan to','expect','locus','risk','future']
print('columns matching time-preference keywords:',[c for c in df.columns if any(k in c.lower() for k in kw)] or 'NONE')
print('savings cat 1989:',dict(df[SV].value_counts(dropna=False).sort_index()))
print(df.groupby(SV,dropna=False).agg(n=(ID,'size'),n_put=(PUT,lambda x:x.notna().sum()),
      n_took=(TOOK,lambda x:x.notna().sum()),med_put=(PUT,'median'),med_took=(TOOK,'median')).to_string())
print('   both amounts filled at once = %d -> amounts are mutually exclusive by design'%int((df[PUT].notna()&df[TOOK].notna()).sum()))
codes=collections.Counter()
for c in RES: codes.update(df[c].dropna().astype(int).tolist())
ever=set(df.loc[df[RES].eq(5).any(axis=1),ID])
print('   residence code 5 (JAIL): obs=%d unique=%d (%.2f%%)'%(codes[5],len(ever),100*len(ever)/len(df)))
print('   convicted non-missing=%.1f%% sentenced=%.1f%% -> too sparse except as indicator'%(
  100*df['Ever convicted of an illegal act in adult court before 1980'].notna().mean(),
  100*df['Ever been sentenced in any correctional institution before 1980'].notna().mean()))

hr('5. BMI PANEL AVAILABILITY / ATTRITION')
bmi=pd.DataFrame({'bmi81':703*df[W81]/h81i**2,'bmi89':703*df[W89]/df[H85]**2,'bmi92':703*df[W92]/df[H85]**2})
bmi=bmi.where((bmi>=13)&(bmi<=70))
for c in bmi: print('   %s: n=%6d (%.1f%%)'%(c,bmi[c].notna().sum(),100*bmi[c].notna().mean()))
print('   bmi89&92=%d ; all three=%d'%(bmi[['bmi89','bmi92']].notna().all(axis=1).sum(),bmi.notna().all(axis=1).sum()))
base=df.join(bmi)
acc=['bmi89','bmi92']
for k,v in [('core outcome (bmi89,bmi92)',None),('+ exposure savings cat',[SV]),('+ sex/age89/race',
    ['Sex of respondent, 1979','Age of respondent at interview date, 1989','Racial/ethnic cohort, 1979']),
    ('+ wealth 85/90/96',[W85c,W90c,W96c]),('+ parent edu + ASVAB',[ME,FE]+ASVAB),
    ('+ income 85/89',['Total net family income, previous calendar year, 1985','Total net family income, previous calendar year, 1989'])]:
    if v: acc=acc+v
    n=base[acc].notna().all(axis=1).sum(); print('   complete-case %-26s n=%6d (%.1f%%)'%(k,n,100*n/len(base)))
m=base.bmi92.isna()
print('\n   1992 attrition: missing vs present')
print('     bmi81 mean %.2f vs %.2f'%(base.loc[m,'bmi81'].mean(),base.loc[~m,'bmi81'].mean()))
print('     female share %.3f vs %.3f'%((base.loc[m,'Sex of respondent, 1979']==2).mean(),(base.loc[~m,'Sex of respondent, 1979']==2).mean()))
print('     savings-cat MISSING share %.3f vs %.3f  <- attrition clusters with non-response'%(base.loc[m,SV].isna().mean(),base.loc[~m,SV].isna().mean()))
print('     wealth85 median %.0f vs %.0f'%(base.loc[m,W85c].median(),base.loc[~m,W85c].median()))

hr('6. DESCRIPTIVE GRADIENTS ONLY (no model, no inference)')
d=base[base[SV].notna()&base.bmi89.notna()&base.bmi92.notna()].copy(); d['dBMI']=d.bmi92-d.bmi89
lab={1:'1 put more in',2:'2 took more out',3:'3 no change',4:'4 no savings'}
print('n=%d'%len(d))
print(d.assign(cat=d[SV].map(lab)).groupby('cat').agg(n=('dBMI','size'),bmi89=('bmi89','mean'),bmi92=('bmi92','mean'),dBMI=('dBMI','mean'),sd=('dBMI','std')).round(3).to_string())
print('\nmean dBMI by sex x savings:')
print(d.assign(cat=d[SV].map(lab)).pivot_table(index='cat',columns=d['Sex of respondent, 1979'].map({1:'M',2:'F'}),values='dBMI',aggfunc='mean').round(3).to_string())
dd=base[base[W85c].notna()&base[W96c].notna()&base.bmi89.notna()&base.bmi92.notna()].copy()
dd['q']=pd.qcut(dd[W96c]-dd[W85c],4,labels=['Q1 lowest','Q2','Q3','Q4 highest']); dd['dBMI']=dd.bmi92-dd.bmi89
print('\nBMI by net-wealth-growth 85->96 quartile (n=%d):'%len(dd))
print(dd.groupby('q',observed=True).agg(n=('dBMI','size'),bmi89=('bmi89','mean'),bmi92=('bmi92','mean'),dBMI=('dBMI','mean')).round(3).to_string())
j=df[RES].eq(5).any(axis=1).values
print('\never-institution n=%d: bmi89 %.2f vs %.2f ; bmi92 %.2f vs %.2f'%(j.sum(),base.loc[j,'bmi89'].mean(),base.loc[~j,'bmi89'].mean(),base.loc[j,'bmi92'].mean(),base.loc[~j,'bmi92'].mean()))
print('\nperson-level BMI persistence: r81-89=%.3f r89-92=%.3f'%(bmi.bmi81.corr(bmi.bmi89),bmi.bmi89.corr(bmi.bmi92)))
