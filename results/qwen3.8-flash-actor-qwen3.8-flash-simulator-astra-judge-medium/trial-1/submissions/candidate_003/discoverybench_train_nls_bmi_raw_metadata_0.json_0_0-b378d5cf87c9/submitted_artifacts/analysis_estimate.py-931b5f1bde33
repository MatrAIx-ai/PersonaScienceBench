"""Main estimation. Outcome = BMI 89->92 change; exposure = savings behaviour 1989.
All models: baseline bmi89 + age89 + ever_jail + convicted/sentenced(with missing ind.) present.
SE: cluster by ID (1 obs per ID -> numerically equals HC robust)."""
import numpy as np, pandas as pd, statsmodels.api as sm
D=pd.read_csv('analysis/analysis_dataset.csv')
IDN='ID'
def run(df,y,xl,name,keep=True):
    d=df[[y]+xl+[IDN]].dropna()
    X=sm.add_constant(d[xl],has_constant='add')
    m=sm.OLS(d[y],X).fit(cov_type='cluster',cov_kwds={'groups':d[IDN]})
    r=[]
    for v in xl:
        r.append(dict(model=name,n=int(m.nobs),var=v,coef=m.params[v],se=m.bse[v],
                      t=m.tvalues[v],p=m.pvalues[v],
                      lo=m.conf_int().loc[v,0],hi=m.conf_int().loc[v,1]))
    return pd.DataFrame(r),m

# ---- control sets (cumulative ladder) ----
BASE=['bmi89','age89','male','race_black','race_hisp','ever_jail','convicted','convicted_miss','sentenced','sentenced_miss']
L1=[]                                        # (a) age+sex+race already in BASE
L2=['mom_ed','dad_ed','mom_ed_miss','dad_ed_miss','asvab_z','asvab_miss','asvab_code']   # (b)
L3=['wealth85_asinh','wealth85_top']         # (c)
L4=['income89','income89_top']               # (d)
LADS={'a: demog only':BASE+L1,'b: +parent edu+ASVAB':BASE+L2,
      'c: +wealth85 (MAIN)':BASE+L2+L3,'d: +income89 (sens)':BASE+L2+L3+L4}
DUM=['e_no_change','e_took_out','e_no_savings']   # ref = put more in
EXPS={'exposure: 3 dummies (ref=put in)':DUM,
      'exposure: dichotomy high-vs-low':['e_dich'],
      'exposure: ordinal 0-3 (convenience)':['e_ord'],
      'exposure: strict dichotomy (drop no-change)':['e_dich_strict']}

rows=[];models={}
for en,exl in EXPS.items():
    for ln,xl in LADS.items():
        t,m=run(D,'dbmi',exl+xl,f'{en} | {ln}')
        rows.append(t); models[f'{en}|{ln}']=m
R=pd.concat(rows)
def show(mask,en):
    t=R[R.model.str.startswith(en)]
    print('\n'+'-'*104+f'\n{en}\n'+'-'*104)
    print('%-34s %6s %10s %8s %7s %7s  %s'%('specification','n','coef','SE','t','p','95% CI'))
    for ln in LADS:
        s=t[t.model.str.endswith(ln)]
        for _,rr in s.iterrows():
            if rr['var'] in (EXPS[en] if isinstance(EXPS[en],list) else [EXPS[en]]):
                star='*' if rr.p<0.05 else ''
                print('%-34s %6d %10.4f %8.4f %7.2f %7.4f%s [%+.3f,%+.3f]'%(
                    ln,rr.n,rr.coef,rr.se,rr.t,rr.p,star,rr.lo,rr.hi))
for en in EXPS: show(None,en)
R.to_csv('analysis/results_ladder.csv',index=False)
print('\n\n=== joint F-test: 3 savings dummies jointly = 0 (MAIN spec c) ===')
m=models['exposure: 3 dummies (ref=put in)|c: +wealth85 (MAIN)']
names=list(m.params.index)
Rm=np.eye(len(names))[[names.index(v) for v in DUM]]
print(m.f_test(Rm).summary())
print('R2 main=%.4f  adjR2=%.4f'%(m.rsquared,m.rsquared_adj))
