"""Consolidated final run: writes every table cited in the hypothesis to analysis/FINAL_REPORT.txt"""
import numpy as np, pandas as pd, statsmodels.api as sm, sys, io
D=pd.read_csv('analysis/analysis_dataset.csv')
DUM=['e_no_change','e_took_out','e_no_savings']
B0=['bmi89','ever_jail','convicted','convicted_miss','sentenced','sentenced_miss']
DEMOG=['age89','male','race_black','race_hisp']
SES=['mom_ed','dad_ed','asvab_z','asvab_code']
W=['wealth85_asinh','wealth85_top']; INC=['income89','income89_top']
def F(cols): return D.dropna(subset=list(dict.fromkeys(['dbmi']+DUM+['e_dich','ID']+cols))).copy()
def O(d,y,xl):
    xl=list(dict.fromkeys(xl))
    dd=d[[y]+xl+['ID']].dropna()
    xl=[v for v in xl if dd[v].std()>0]
    return sm.OLS(dd[y],sm.add_constant(dd[xl])).fit(cov_type='cluster',cov_kwds={'groups':dd.ID})
out=io.StringIO(); P=lambda *a: print(*a,file=out)
sd=D.dropna(subset=['dbmi']).dbmi.std()
P('NLSY79 — DOES INCREASED TIME PREFERENCE LEAD TO HIGHER BMI?  FINAL ESTIMATION OUTPUT')
P('outcome = ΔBMI(1989→1992); exposure = savings behaviour 1989; SE clustered on ID; sd(ΔBMI)=%.3f\n',sd)
P('== LADDER 1: complete-case (n changes as controls enter) ==')
for lab,ctrl in [('a age+sex+race',DEMOG),('b +parent edu+ASVAB',DEMOG+SES),
                 ('c +wealth85 = MAIN',DEMOG+SES+W),('d +income89 (sensitivity)',DEMOG+SES+W+INC)]:
    d=F(B0+ctrl); m=O(d,'dbmi',DUM+B0+ctrl); md=O(d,'dbmi',['e_dich']+B0+ctrl)
    ft=m.f_test(np.eye(len(m.params))[[list(m.params.index).index(v) for v in DUM]])
    P(' %-26s n=%5d | no_change %+0.4f(%.4f) no_change_p=%.3f | took_out %+0.4f(%.4f) p=%.3f | no_savings %+0.4f(%.4f) p=%.3f | e_dich %+0.4f(%.4f) p=%.3f | F(3)=%.2f p=%.3f'%(
      lab,m.nobs,m.params['e_no_change'],m.bse['e_no_change'],m.pvalues['e_no_change'],
      m.params['e_took_out'],m.bse['e_took_out'],m.pvalues['e_took_out'],
      m.params['e_no_savings'],m.bse['e_no_savings'],m.pvalues['e_no_savings'],
      md.params['e_dich'],md.bse['e_dich'],md.pvalues['e_dich'],float(ft.fvalue),float(ft.pvalue)))
P('\n== LADDER 2: FIXED sample n=4986 (movement is due to controls, not sample) ==')
Ff=F(B0+DEMOG+SES+W+INC)
for lab,ctrl in [('0 raw (baseline bmi89 only)',[]),('a +age+sex+race',DEMOG),('b +parent edu+ASVAB',DEMOG+SES),
                 ('c +wealth85',DEMOG+SES+W),('d +income89',DEMOG+SES+W+INC)]:
    m=O(Ff,'dbmi',DUM+B0+ctrl); md=O(Ff,'dbmi',['e_dich']+B0+ctrl)
    P(' %-28s n=%5d | %+0.4f / %+0.4f / %+0.4f (no_chg/took/no_sav) | e_dich %+0.4f (SE %.4f) p=%.3f'%(
      lab,m.nobs,m.params['e_no_change'],m.params['e_took_out'],m.params['e_no_savings'],
      md.params['e_dich'],md.bse['e_dich'],md.pvalues['e_dich']))
P('\n== SINGLE-CONTROL ATTRIBUTION (fixed n=4986) : which control absorbs the gradient ==')
for lab,ctrl in [('none',['bmi89']),('+ male',B0[:1]+['male']),('+ race',B0[:1]+['race_black','race_hisp']),
                 ('+ age89',B0[:1]+['age89']),('+ wealth85',B0[:1]+W),('+ income89',B0[:1]+INC),
                 ('+ ASVAB',B0[:1]+['asvab_z','asvab_code']),('+ parent edu',B0[:1]+['mom_ed','dad_ed'])]:
    m=O(Ff,'dbmi',DUM+ctrl); md=O(Ff,'dbmi',['e_dich']+ctrl)
    P('  %-14s e_dich = %+0.4f (SE %.4f) p=%.4f'%(lab,md.params['e_dich'],md.bse['e_dich'],md.pvalues['e_dich']))
P('\n== SEX (interaction + stratified, MAIN varset) ==')
di=D.copy()
for v in DUM: di[v+'_m']=di[v]*di.male
di['e_dich_m']=di.e_dich*di.male
m=O(di,'dbmi',DUM+[v+'_m' for v in DUM]+B0+DEMOG+SES+W)
ft=m.f_test(np.eye(len(m.params))[[list(m.params.index).index(v+'_m') for v in DUM]])
P('  joint Wald on 3 sex-interactions: F=%.3f p=%.4f  (=> interaction NOT significant)'%(float(ft.fvalue),float(ft.pvalue)))
md=O(di,'dbmi',['e_dich','e_dich_m','male']+B0+DEMOG+SES+W)
P('  e_dich=%+.4f(SE%.4f) e_dich x male=%+.4f(SE%.4f) p=%.4f'%(md.params['e_dich'],md.bse['e_dich'],md.params['e_dich_m'],md.bse['e_dich_m'],md.pvalues['e_dich_m']))
for sex,lab in [(1.0,'MALE'),(0.0,'FEMALE')]:
    s=D[D.male==sex]; ms=O(s,'dbmi',DUM+B0+[v for v in DEMOG if v!="male"]+SES+W); mds=O(s,'dbmi',['e_dich']+B0+[v for v in DEMOG if v!="male"]+SES+W)
    P('  %s n=%4d: no_change %+0.4f(%.4f p%.3f) took_out %+0.4f(%.4f p%.3f) no_savings %+0.4f(%.4f p%.3f) | e_dich %+0.4f(%.4f p%.3f)'%(
      lab,ms.nobs,ms.params['e_no_change'],ms.bse['e_no_change'],ms.pvalues['e_no_change'],
      ms.params['e_took_out'],ms.bse['e_took_out'],ms.pvalues['e_took_out'],
      ms.params['e_no_savings'],ms.bse['e_no_savings'],ms.pvalues['e_no_savings'],
      mds.params['e_dich'],mds.bse['e_dich'],mds.pvalues['e_dich']))
P('\n== RACE x EXPOSURE (because race absorbs most of the raw gradient) ==')
for rc,nm in [('race_black','BLACK'),('race_hisp','HISPANIC')]:
    d=D.dropna(subset=['dbmi']+DUM+['bmi89','age89','male',rc,'wealth85_asinh','ID']).copy()
    for v in DUM: d[v+'_x']=d[v]*d[rc]
    mm=O(d,'dbmi',DUM+[v+'_x' for v in DUM]+['bmi89','age89','male',rc,'wealth85_asinh'])
    ft=mm.f_test(np.eye(len(mm.params))[[list(mm.params.index).index(f'{v}_x') for v in DUM]])
    P('  %s: joint F on interactions=%.2f p=%.3f'%(nm,float(ft.fvalue),float(ft.pvalue)))
d0=F(B0+DEMOG+SES+W); d0=d0[(d0.race_black==0)&(d0.race_hisp==0)]
m0=O(d0,'dbmi',DUM+B0+DEMOG+SES+W)
P('  ref race group only (n=%d): %+0.4f / %+0.4f / %+0.4f'%(m0.nobs,m0.params['e_no_change'],m0.params['e_took_out'],m0.params['e_no_savings']))
P('\n== SECONDARY / ROBUSTNESS ==')
P('  person-mean BMI (>=2 waves, MAIN varset): see results_mi_robust.txt §4')
P('  within-person FE: exposure time-invariant -> demeaned to exactly 0, unidentified (see §5)')
P('  MI(m=5) on covariates only: e_no_change +0.1555(SE .0803 p=.053), took_out +0.0286, no_savings +0.0696 — still flat')
P('\n== SELECTION ==')
obs=D[D.sav_cat.notna()]
ms=O(obs,'bmi92_missing',DUM+['bmi81','male','age89','race_black','race_hisp','wealth85_asinh'])
P('  P(ΔBMI unobserved) ~ exposure: no_change %+0.4f(p%.3f) took_out %+0.4f(p%.3f) NO_SAVINGS %+0.4f(p%.4f)'%(
  ms.params['e_no_change'],ms.pvalues['e_no_change'],ms.params['e_took_out'],ms.pvalues['e_took_out'],
  ms.params['e_no_savings'],ms.pvalues['e_no_savings']))
att=[D[D.sav_cat==k]['bmi92_missing'].mean() for k in [1,2,3,4]]
P('  raw 1992 attrition rate: put-in %.3f took-out %.3f no-change %.3f NO SAVINGS %.3f'%(att[0],att[1],att[2],att[3]))
P('  exposure-missing rate: bmi92 observed %.3f vs bmi92 missing %.3f (joint wave non-response; not BMI-predicted)'%(
  D[D.bmi92.notna()].exp_missing.mean(), D[D.bmi92.isna()].exp_missing.mean()))
txt=out.getvalue(); open('analysis/FINAL_REPORT.txt','w').write(txt); print(txt)
