"""Full coefficient table for MAIN spec (every control's sign/size) + standardisation."""
import numpy as np, pandas as pd, statsmodels.api as sm
D=pd.read_csv('analysis/analysis_dataset.csv')
DUM=['e_no_change','e_took_out','e_no_savings']
BASE=['bmi89','age89','male','race_black','race_hisp','ever_jail','convicted','convicted_miss',
      'sentenced','sentenced_miss','mom_ed','dad_ed','mom_ed_miss','dad_ed_miss',
      'asvab_z','asvab_miss','asvab_code','wealth85_asinh','wealth85_top']
d=D[['dbmi']+DUM+BASE+['ID']].dropna()
CTRL=[v for v in BASE if d[v].std()>0]
DROP=[v for v in BASE if d[v].std()==0]
print('zero-variance controls dropped in MAIN sample:',DROP)
X=sm.add_constant(d[DUM+CTRL])
m=sm.OLS(d.dbmi,X).fit(cov_type='cluster',cov_kwds={'groups':d.ID})
sd=D.dbmi.std()
print('MAIN SPEC: OLS  dbmi ~ exposure(3 dummies, ref = "put more money in") + controls')
print('n=%d  R2=%.4f  sd(dbmi)=%.3f  -> coef/sd = %s'%(m.nobs,m.rsquared,sd,'standardised effect'))
print('%-18s %10s %8s %7s %8s %10s %s'%('variable','coef','SE','t','p','coef/SD','direction'))
for v in list(m.params.index):
    c,p=m.params[v],m.pvalues[v]
    dirn='(intercept)' if v=='const' else ('higher -> more BMI gain' if c>0 else 'higher -> less BMI gain')
    print('%-18s %+10.4f %8.4f %7.2f %8.4f %10.4f %s'%(v,c,m.bse[v],m.tvalues[v],p,c/sd,dirn))
m.summary().as_text(); 
with open('analysis/results_main_spec_full.txt','w') as f:
    f.write(m.summary().as_text())
# main spec with dichotomy, and unadjusted
d2=D[['dbmi','e_dich']+BASE+['ID']].dropna(); X2=sm.add_constant(d2[['e_dich']+BASE])
m2=sm.OLS(d2.dbmi,X2).fit(cov_type='cluster',cov_kwds={'groups':d2.ID})
print('\nMAIN SPEC dichotomy: e_dich=%+.4f (SE %.4f) p=%.4f n=%d  coef/SD=%.4f'%(
  m2.params.e_dich,m2.bse.e_dich,m2.pvalues.e_dich,m2.nobs,m2.params.e_dich/sd))
mu,_=None,None
d3=D[['dbmi','e_dich','ID']].dropna(); m3=sm.OLS(d3.dbmi,sm.add_constant(d3[['e_dich']])).fit(cov_type='cluster',cov_kwds={'groups':d3.ID})
print('NO-CONTROL dichotomy: e_dich=%+.4f (SE %.4f) p=%.4f n=%d'%(m3.params.e_dich,m3.bse.e_dich,m3.pvalues.e_dich,m3.nobs))
d4=D[['dbmi']+DUM+['ID']].dropna(); m4=sm.OLS(d4.dbmi,sm.add_constant(d4[DUM])).fit(cov_type='cluster',cov_kwds={'groups':d4.ID})
print('NO-CONTROL dummies:',' | '.join('%s=%+.4f(SE %.4f,p=%.3f)'%(v,m4.params[v],m4.bse[v],m4.pvalues[v]) for v in DUM))
# minimum detectable / power context
print('\npower context: observed 95%% CI half-width on largest dummy in MAIN = %.3f BMI units = %.3f SD'%(
  float(m.conf_int().iloc[list(m.params.index).index('e_no_change'),1]-m.params['e_no_change']), float(m.conf_int().iloc[list(m.params.index).index('e_no_change'),1]-m.params['e_no_change'])/sd))
print('smallest effect rule-out at 95%%: |coef| > %.3f (%.3f SD) for e_no_change'%(
  float(m.conf_int().iloc[list(m.params.index).index('e_no_change'),1]),float(m.conf_int().iloc[list(m.params.index).index('e_no_change'),1])/sd))
