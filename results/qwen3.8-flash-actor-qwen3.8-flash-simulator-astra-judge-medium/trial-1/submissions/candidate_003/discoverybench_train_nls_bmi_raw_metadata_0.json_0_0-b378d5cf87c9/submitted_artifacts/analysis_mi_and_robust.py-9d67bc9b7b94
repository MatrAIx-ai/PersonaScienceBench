"""MICE (m=5, covariates ONLY - never exposure/outcome), proxy-B sensitivity,
person-mean secondary outcome, FE as one sensitivity line, cleaned selection check."""
import numpy as np, pandas as pd, statsmodels.api as sm
rng=np.random.default_rng(20261025)
D=pd.read_csv('analysis/analysis_dataset.csv')
DUM=['e_no_change','e_took_out','e_no_savings']
BASE=['bmi89','age89','male','race_black','race_hisp','ever_jail','convicted','convicted_miss',
      'sentenced','sentenced_miss','mom_ed','dad_ed','mom_ed_miss','dad_ed_miss',
      'asvab_z','asvab_miss','asvab_code','wealth85_asinh','wealth85_top']
def fit(df,y,xl):
    d=df[[y]+xl+['ID']].dropna(); X=sm.add_constant(d[xl])
    return sm.OLS(d[y],X).fit(cov_type='cluster',cov_kwds={'groups':d['ID']}),d

print('='*96+'\n0. SCALE: what does a coefficient mean in SD units\n'+'='*96)
sub=D[D.dbmi.notna()&D.e_dich.notna()]
print('sd(dbmi)=%.4f  mean dbmi=%.4f  mean bmi89=%.3f mean bmi92=%.3f'%(sub.dbmi.std(),sub.dbmi.mean(),sub.bmi89.mean(),sub.bmi92.mean()))

print('\n'+'='*96+'\n1. CLEANED SELECTION CHECK: restrict to respondents WITH exposure observed\n'+'='*96)
obs=D[D.sav_cat.notna()]
m,_=fit(obs,'bmi92_missing',DUM+['bmi81','male','age89','race_black','race_hisp','wealth85_asinh'])
print('n=%d   P(bmi92 missing) on exposure dummies (ref = put more in)'%m.nobs)
for v in DUM+['bmi81','male','wealth85_asinh']:
    print('   %-16s %+.4f (SE %.4f) p=%.4f'%(v,m.params[v],m.bse[v],m.pvalues[v]))
print('   raw bmi92-missing rate by savings cat:')
print(D.groupby('sav_cat',dropna=False)['bmi92_missing'].agg(['mean','size']).round(4).to_string())
print('   joint F on exposure:', end=' ')
ft=m.f_test(np.eye(len(m.params))[[list(m.params.index).index(v) for v in DUM]]); print('F=%.3f p=%.4f'%(float(ft.fvalue),float(ft.pvalue)))

print('\n'+'='*96+'\n2. MICE m=5 on COVARIATES ONLY (never exposure / never outcome)\n'+'='*96)
IMP=['mom_ed','dad_ed','asvab_z','wealth85_asinh','income89']
KEY=['ID','dbmi','e_dich']+DUM+BASE+IMP
W=D[[c for c in dict.fromkeys(KEY) if c in D.columns]].copy()
miss={c:W[c].isna().values for c in IMP}
print('imputed columns and their missing rates:',{c:round(float(W[c].isna().mean()),4) for c in IMP})
def regress_impute(tbl,cols,iters=6):
    T=tbl.copy()
    for c in cols:
        mu=T[c].mean(); T[c]=T[c].fillna(mu)
    for it in range(iters):
        for c in cols:
            others=[o for o in cols if o!=c]+['dbmi','e_dich']+[v for v in BASE if v in T.columns]
            others=[o for o in dict.fromkeys(others) if o in T.columns]
            obs_m=~miss[c]; y=T.loc[obs_m,c]; X=sm.add_constant(T.loc[obs_m,others],has_constant='add')
            try:
                mm=sm.OLS(y,X[sm.add_constant(T.loc[obs_m,others],has_constant='add').columns]).fit()
                Xf=sm.add_constant(T.loc[~obs_m,others],has_constant='add')
                sigma=np.sqrt(mm.mse_resid)
                T.loc[~obs_m,c]=mm.predict(Xf)+rng.normal(0,sigma,int((~obs_m).sum()))
            except Exception as e: pass
    return T
ests=[];vs=[];ns=[]
for imp_i in range(5):
    Ti=regress_impute(W,IMP)
    mm,_=fit(Ti,'dbmi',DUM+BASE)
    ests.append(np.array([mm.params[v] for v in DUM])); vs.append(np.array([mm.bse[v]**2 for v in DUM])); ns.append(mm.nobs)
E=np.array(ests); V=np.array(vs)
Qbar=E.mean(0); Wbar=V.mean(0); B=E.var(ddof=1,axis=0)
Tv=Wbar+(1+1/5)*B; SE=np.sqrt(Tv)
Bn=np.where(B<=0,1e-12,B); dfree=(5-1)*(1+Wbar/((1+1/5)*Bn))**2
from scipy import stats
print('\nRubin-pooled, MI(m=5), MAIN spec (exposure dummies, ref=put in), n=%.0f'%np.mean(ns))
for j,v in enumerate(DUM):
    p=2*(1-stats.t.cdf(abs(Qbar[j]/SE[j]),dfree[j]))
    print('   %-14s coef=%+.4f  SE=%.4f  t=%.2f  p=%.4f  95%%CI[%+.3f,%+.3f]'%(
        v,Qbar[j],SE[j],Qbar[j]/SE[j],p,Qbar[j]-2.02*SE[j],Qbar[j]+2.02*SE[j]))
md,_=fit(regress_impute(W,IMP),'dbmi',['e_dich']+BASE)
print('   (single-run complete-case comparison, main spec, dummies):')
mc,_=fit(D,'dbmi',DUM+BASE)
for v in DUM: print('     %-14s CC %+.4f (SE %.4f) -> MI %+.4f (SE %.4f)'%(v,mc.params[v],mc.bse[v],Qbar[DUM.index(v)],SE[DUM.index(v)]))

print('\n'+'='*96+'\n3. EXPOSURE PROXY B (sensitivity): composite impatience = savings ordinal + low wealth growth\n'+'='*96)
Bb=D.dropna(subset=['e_ord','dw wealth','dbmi']).copy()
Bb['zgrowth']=(Bb['dw wealth']-Bb['dw wealth'].mean())/Bb['dw wealth'].std()
Bb['impB']=(Bb.e_ord-Bb.e_ord.mean())/Bb.e_ord.std() + (-Bb.zgrowth)
Bb['impB']=(Bb.impB-Bb.impB.mean())/Bb.impB.std()
print('n=%d  corr(e_ord, -wealth growth)=%.3f  sd(impB)=%.3f'%(len(Bb),Bb.e_ord.corr(-Bb['dw wealth']),Bb.impB.std()))
CTRL=[v for v in BASE if v not in ('wealth85_asinh','wealth85_top')]
mb1,_=fit(Bb,'dbmi',['impB']+BASE); mb2,_=fit(Bb,'dbmi',['impB']+CTRL)
print('   B on dbmi, full controls incl wealth85:      coef=%+.4f SE=%.4f p=%.4f n=%d'%(mb1.params.impB,mb1.bse.impB,mb1.pvalues.impB,mb1.nobs))
print('   B on dbmi, controls WITHOUT wealth terms:    coef=%+.4f SE=%.4f p=%.4f n=%d'%(mb2.params.impB,mb2.bse.impB,mb2.pvalues.impB,mb2.nobs))
print('   -> raw association without wealth control is what a naive "index" reading would report')

print('\n'+'='*96+'\n4. SECONDARY OUTCOME: person-mean BMI over observed waves (>=2 waves)\n'+'='*96)
P=D[D.n_waves>=2].copy()
for ln,xl in [('a demog',['age89','male','race_black','race_hisp']),
              ('c MAIN (+edu,ASVAB,wealth85)',BASE)]:
    mp,_=fit(P,'bmi_pmean',DUM+[v for v in xl if v not in DUM])
    print(' spec %-32s n=%d'%(ln,mp.nobs), ' | '.join('%s=%+.4f(SE %.4f,p=%.3f)'%(v,mp.params[v],mp.bse[v],mp.pvalues[v]) for v in DUM))
md2,_=fit(P,'bmi_pmean',['e_dich']+BASE)
print(' %-37s n=%d  e_dich=%+.4f (SE %.4f, p=%.4f)'%('c MAIN dichotomy',md2.nobs,md2.params.e_dich,md2.bse.e_dich,md2.pvalues.e_dich))

print('\n'+'='*96+'\n5. FE (one sensitivity line, expected near-unidentified)\n'+'='*96)
L=[]
for wv,b in [(81,'bmi81'),(89,'bmi89'),(92,'bmi92')]:
    t=pd.DataFrame({'ID':D.ID.values,'wave':wv,'bmi':D[b].values})
    t=t.dropna().copy()
    for v in DUM+['e_dich']: t[v]=D.loc[t.index,v].values
    L.append(t)
L=pd.concat(L,ignore_index=True)
L=L.dropna(subset=DUM).copy()   # FE needs exposure observed (time-invariant covariate)
Ls=L.groupby('ID').filter(lambda g:len(g)>=2).copy()
Lw=Ls.copy()
for c in ['bmi']+DUM: Lw[c]=Lw[c]-Lw.groupby('ID')[c].transform('mean')
Lw=Lw.dropna()
mfe=sm.OLS(Lw.bmi,sm.add_constant(Lw[DUM])).fit(cov_type='cluster',cov_kwds={'groups':Lw.ID})
print(' within-person (3-wave) FE: exposure is time-invariant -> demeaned, identification is fragile')
for v in DUM: print('   %-14s coef=%+.4f SE=%.4f p=%.4f'%(v,mfe.params[v],mfe.bse[v],mfe.pvalues[v]))
print('   n=%d obs, %d persons; R2(within)=%.5f'%(mfe.nobs,Ls.ID.nunique(),mfe.rsquared))
print('   NOTE: within-person demeaning removes ALL of the exposure variation; coefficients above')
print('   are identified only through unbalanced-wave composition, not from within-person change.')
