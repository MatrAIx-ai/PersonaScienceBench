#!/usr/bin/env bash
# Full pipeline for: "Does increased time preference lead to higher BMI?" (NLSY79)
set -e
python3 analysis/data_audit.py       >  analysis/data_audit_output.txt   # read-only audit / dictionary reconciliation
python3 analysis/build_dataset.py                                       # cleaning + unit fixes -> analysis_dataset.csv
python3 analysis/estimate.py         >  analysis/results_ladder.txt      # complete-case control ladder, 4 exposure codings
python3 analysis/sex_and_checks.py   >  analysis/results_sex.txt          # sex interaction/strata + selection checks
python3 analysis/mi_and_robust.py    >  analysis/results_mi_robust.txt    # MI(m=5), proxy B, person-mean, FE
python3 analysis/full_tables.py      >  analysis/results_main_spec.txt    # full coefficient table, MAIN spec
python3 analysis/same_sample_ladder.py > analysis/results_same_sample.txt # fixed-sample ladder
python3 analysis/attribution.py      >  analysis/results_attribution.txt  # which control absorbs the gradient
python3 analysis/final_run.py                                             # consolidated -> analysis/FINAL_REPORT.txt
python3 analysis/selection_and_raw.py > analysis/selection_and_raw.txt    # selection detail + raw associations + CI bounds
echo "pipeline OK"
