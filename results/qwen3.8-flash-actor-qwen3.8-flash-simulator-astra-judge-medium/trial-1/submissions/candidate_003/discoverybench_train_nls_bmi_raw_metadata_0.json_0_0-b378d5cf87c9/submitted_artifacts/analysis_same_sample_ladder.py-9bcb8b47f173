"""Is the a->c collapse driven by CONTROLS or by the SAMPLE changing? Ladder on FIXED sample."""
import numpy as np, pandas as pd, statsmodels.api as sm
D=pd.read_csv('analysis/analysis_dataset.csv')
DUM=['e_no_change','e_took_out','e_no_savings']
NEED=['dbmi']+DUM+['bmi89','age89','male','race_black','race_hisp','ever_jail','convicted','convicted_miss',
 'sentenced','sentenced_miss','mom_ed','dad_ed','asvab_z','asvab_code','wealth85_asinh','wealth85_top','income89','income89_top']
F=D.dropna(subset=NEED).copy()
print('FIXED sample (all vars incl income89 observed): n=%d'%len(F))
print('  exposure dist:',dict(F.sav_cat.value_counts().sort_index()))
SETS=[('0 no controls (raw)',[]),
      ('a age+sex+race',['age89','male','race_black','race_hisp']),
      ('b +parent edu+ASVAB',['age89','male','race_black','race_hisp','mom_ed','dad_ed','asvab_z','asvab_code']),
      ('c +wealth85  [MAIN varset]',None),
      ('d +income89',['age89','male','race_black','race_hisp','mom_ed','dad_ed','asvab_z','asvab_code','wealth85_asinh','wealth85_top','income89','income89_top'])]
B0=['bmi89','ever_jail','convicted','convicted_miss','sentenced','sentenced_miss']
rows=[]
for lab,xl in SETS:
    ctrl=B0+(['age89','male','race_black','race_hisp','mom_ed','dad_ed','asvab_z','asvab_code','wealth85_asinh','wealth85_top'] if xl is None else xl)
    d=F[['dbmi']+DUM+['e_dich']+ctrl+['ID']].dropna()
    X=sm.add_constant(d[DUM+ctrl]); m=sm.OLS(d.dbmi,X).fit(cov_type='cluster',cov_kwds={'groups':d.ID})
    Xd=sm.add_constant(d[['e_dich']+ctrl]); md=sm.OLS(d.dbmi,Xd).fit(cov_type='cluster',cov_kwds={'groups':d.ID})
    rows.append(dict(spec=lab,n=int(m.nobs),
      no_change=m.params['e_no_change'],se_nc=m.bse['e_no_change'],p_nc=m.pvalues['e_no_change'],
      took_out=m.params['e_took_out'],se_to=m.bse['e_took_out'],p_to=m.pvalues['e_took_out'],
      no_savings=m.params['e_no_savings'],se_ns=m.bse['e_no_savings'],p_ns=m.pvalues['e_no_savings'],
      dich=md.params['e_dich'],se_d=md.bse['e_dich'],p_d=md.pvalues['e_dich'],
      jointF=float(m.f_test(np.eye(len(m.params))[[list(m.params.index).index(v) for v in DUM]]).fvalue),
      pF=float(m.f_test(np.eye(len(m.params))[[list(m.params.index).index(v) for v in DUM]]).pvalue)))
T=pd.DataFrame(rows); T.to_csv('analysis/results_same_sample_ladder.csv',index=False)
print('\nSAME-SAMPLE LADDER (n fixed at %d) — outcome = BMI change 89->92'%len(F))
print('%-24s %5s | %-26s | %-26s | %-26s | %-18s | F(3) p'%('spec','n','e_no_change','e_took_out','e_no_savings','e_dich'))
for _,r in T.iterrows():
    print('%-24s %5d | %+.4f(%7.4f,p%.3f) | %+.4f(%7.4f,p%.3f) | %+.4f(%7.4f,p%.3f) | %+.4f(SE%.4f p%.3f) | %.2f p%.3f'%(
      r.spec,r.n,r.no_change,r.se_nc,r.p_nc,r.took_out,r.se_to,r.p_to,r.no_savings,r.se_ns,r.p_ns,r.dich,r.se_d,r.p_d,r.jointF,r.pF))
print('\nCOMPARE: unrestricted complete-case ladder had n=8434 (a) -> 6048 (c);')
print('here n is CONSTANT, so any coefficient movement is due to controls, not sample.')
