import pandas as pd, numpy as np, statsmodels.api as sm
D=pd.read_csv('analysis/analysis_dataset.csv')
print('=== EXPOSURE-MISSINGNESS structure (the 45.6% vs 2.6%) ===')
print('P(exposure missing | bmi92 present) = %.4f ; P(exposure missing | bmi92 missing) = %.4f'%(
 D[D.bmi92.notna()].exp_missing.mean(), D[D.bmi92.isna()].exp_missing.mean()))
print('P(bmi92 missing | exposure present) = %.4f ; | exposure missing = %.4f'%(
 D[D.sav_cat.notna()].bmi92_missing.mean(), D[D.sav_cat.isna()].bmi92_missing.mean()))
d=D.dropna(subset=['bmi81','bmi89','male','age89'])
m=sm.OLS(d.exp_missing,sm.add_constant(d[['bmi81','bmi89','male','age89']])).fit(cov_type='cluster',cov_kwds={'groups':d.ID})
print('   exposure_missing ~ baseline BMI + demog (n=%d): '%m.nobs+' ; '.join('%s=%+.5f(p%.3f)'%(v,m.params[v],m.pvalues[v]) for v in ['bmi81','bmi89','male','age89']))
print('   -> exposure-missingness is NOT predicted by BMI or demography: it is joint wave non-response')
print('\n=== RAW (unadjusted) exposure-vs-outcome, complete cases ===')
DUM=['e_no_change','e_took_out','e_no_savings']
for y in ['dbmi','bmi92','bmi89']:
    dd=D.dropna(subset=[y]+DUM); mm=sm.OLS(dd[y],sm.add_constant(dd[DUM])).fit(cov_type='cluster',cov_kwds={'groups':dd.ID})
    print(' %-6s ~ exposure only (n=%5d): '%(y,mm.nobs)+' | '.join('%s=%+.4f(SE%.4f p%.3f)'%(v,mm.params[v],mm.bse[v],mm.pvalues[v]) for v in DUM))
print('\n=== poverty confounding of the "no savings" category ===')
print(D.groupby('sav_cat').agg(n=('ID','size'),med_inc89=('income89','median'),asvab=('asvab_z','mean'),
  male=('male','mean'),med_bmi89=('bmi89','median')).round(3).to_string())
D['no_wealth']=D.wealth85_asinh<=0
print(' share wealth85<=0 by cat:',D.groupby('sav_cat')['no_wealth'].mean().round(3).to_dict())
print('\n=== effect-size ceiling (95% CI, MAIN spec) ===')
CTRL=['bmi89','age89','male','race_black','race_hisp','mom_ed','dad_ed','asvab_z','asvab_code','wealth85_asinh','wealth85_top']
d=D.dropna(subset=['dbmi']+DUM+CTRL)
m=sm.OLS(d.dbmi,sm.add_constant(d[DUM+CTRL])).fit(cov_type='cluster',cov_kwds={'groups':d.ID})
sd=D.dbmi.std(); ci=m.conf_int()
for v in DUM:
    i=list(m.params.index).index(v); lo,hi=float(ci.iloc[i,0]),float(ci.iloc[i,1])
    print('  %-13s coef=%+.4f SE=%.4f 95%%CI[%+.4f,%+.4f] = [%+.3f,%+.3f] SD'%(v,m.params[v],m.bse[v],lo,hi,lo/sd,hi/sd))
print('  sd(deltaBMI)=%.4f  n=%d  R2=%.4f'%(sd,m.nobs,m.rsquared))
