"""Sex interaction / sex-stratified estimates, selection checks, proxy-B sensitivity,
person-mean secondary outcome, FE as one sensitivity line."""
import numpy as np, pandas as pd, statsmodels.api as sm
D=pd.read_csv('analysis/analysis_dataset.csv')
DUM=['e_no_change','e_took_out','e_no_savings']
BASE=['bmi89','age89','race_black','race_hisp','ever_jail','convicted','convicted_miss','sentenced','sentenced_miss',
      'mom_ed','dad_ed','mom_ed_miss','dad_ed_miss','asvab_z','asvab_miss','asvab_code','wealth85_asinh','wealth85_top']
def fit(df,y,xl,cov='cluster'):
    d=df[[y]+xl+['ID']].dropna(); X=sm.add_constant(d[xl])
    kw={'groups':d['ID']} if cov=='cluster' else {}
    return sm.OLS(d[y],X,).fit(cov_type='cluster' if cov=='cluster' else 'HC1',cov_kwds=kw),d

print('='*100+'\nA. SEX x EXPOSURE INTERACTION  (MAIN spec: +wealth85; male=1)\n'+'='*100)
di=D.copy()
for v in DUM: di[v+'_m']=di[v]*di.male
m,_=fit(di,'dbmi',DUM+[v+'_m' for v in DUM]+BASE+['male'])
print('%-24s %9s %8s %7s %7s'%('term','coef','SE','t','p'))
for v in DUM+['male']:
    print('%-24s %9.4f %8.4f %7.2f %7.4f'%(v,m.params[v],m.bse[v],m.tvalues[v],m.pvalues[v]))
for v in DUM:
    print('%-24s %9.4f %8.4f %7.2f %7.4f  <-- interaction'%(v+'_m',m.params[v+'_m'],m.bse[v+'_m'],m.tvalues[v+'_m'],m.pvalues[v+'_m']))
names=list(m.params.index)
Rm=np.eye(len(names))[[names.index(v+'_m') for v in DUM]]
ft=m.f_test(Rm); print('\njoint Wald F (3 interactions = 0): F=%.3f p=%.4f'%(float(ft.fvalue),float(ft.pvalue)))
print('dichotomy interaction:')
dd=D.copy(); dd['e_m']=dd.e_dich*dd.male
m2,_=fit(dd,'dbmi',['e_dich','e_m','male']+BASE)
print('  e_dich=%.4f (SE %.4f) ; e_dich x male=%.4f (SE %.4f) p=%.4f'%(
  m2.params['e_dich'],m2.bse['e_dich'],m2.params['e_m'],m2.bse['e_m'],m2.pvalues['e_m']))

print('\n'+'='*100+'\nB. SEX-STRATIFIED LADDER (same 4 specs, M and F separately)\n'+'='*100)
L1=[];L2=['mom_ed','dad_ed','mom_ed_miss','dad_ed_miss','asvab_z','asvab_miss','asvab_code']
L3=['wealth85_asinh','wealth85_top'];L4=['income89','income89_top']
LADS={'a demog':BASE[:5]+L1,'b +edu+ASVAB':BASE[:5]+L2,'c +wealth85 MAIN':BASE+L3,'d +income89':BASE+L3+L4}
rows=[]
for sex,lab in [(1,'MALE'),(2,'FEMALE')]:
    sub=D[D.male==(sex==1)]
    for ln,xl in LADS.items():
        mm,dat=fit(sub,'dbmi',DUM+[v for v in xl if v!='male'])
        for v in DUM:
            rows.append(dict(sex=lab,spec=ln,var=v,n=int(mm.nobs),coef=mm.params[v],se=mm.bse[v],p=mm.pvalues[v]))
        md,_=fit(sub,'dbmi',['e_dich']+[v for v in xl if v!='male'])
        rows.append(dict(sex=lab,spec=ln,var='e_dich',n=int(md.nobs),coef=md.params['e_dich'],se=md.bse['e_dich'],p=md.pvalues['e_dich']))
S=pd.DataFrame(rows); S.to_csv('analysis/results_sexstrat.csv',index=False)
for lab in ['MALE','FEMALE']:
    print('\n--- %s (ref=put in; e_dich = took-out/no-savings vs put-in/no-change) ---'%lab)
    print('%-18s %-14s %6s %9s %8s %7s'%('spec','term','n','coef','SE','p'))
    tt=S[S.sex==lab]
    for ln in LADS:
        for v in DUM+['e_dich']:
            r=tt[(tt['spec']==ln)&(tt['var']==v)].iloc[0]
            print('%-18s %-14s %6d %9.4f %8.4f %7.4f%s'%(ln,v,r.n,r.coef,r.se,r.p,'*' if r.p<.05 else ''))

print('\n'+'='*100+'\nC. SELECTION CHECKS (linear-probability, cluster SE)\n'+'='*100)
sc=D.copy()
for v in DUM: sc[v]=sc[v].fillna(0.0)   # missing exposure -> all dummies 0 in the missing-indicator model
m3,_=fit(D,'bmi92_missing',DUM+['bmi81','male','age89','race_black','race_hisp','wealth85_asinh'])
print('\nC1. P(bmi92 MISSING) ~ exposure + bmi81 + demog + wealth85   (n=%d)'%m3.nobs)
for v in DUM+['bmi81','male','wealth85_asinh']:
    print('   %-16s coef=%+.4f SE=%.4f p=%.4f'%(v,m3.params[v],m3.bse[v],m3.pvalues[v]))
m4,_=fit(sc,'exp_missing',['bmi81','bmi89','male','age89','race_black','race_hisp','wealth85_asinh','ever_jail'])
print('\nC2. P(SAVINGS-CAT MISSING) ~ baseline BMI + demog + wealth85 (n=%d)'%m4.nobs)
for v in ['bmi81','bmi89','male','age89','wealth85_asinh','ever_jail']:
    print('   %-16s coef=%+.4f SE=%.4f p=%.4f'%(v,m4.params[v],m4.bse[v],m4.pvalues[v]))
print('   raw exposure-missing rate: bmi92 present %.3f | bmi92 missing %.3f'%(
   D.loc[D.bmi92.notna(),'exp_missing'].mean(),D.loc[D.bmi92.isna(),'exp_missing'].mean()))
m5,_=fit(D,'exp_missing',['bmi81','male','age89'])
ft5=m5.f_test(np.eye(len(m5.params))[[list(m5.params.index).index(v) for v in ['bmi81','male','age89']]]); print('   exposure-missing ~ bmi81+male+age89 : joint F=%.3f p=%.4f'%(float(ft5.fvalue),float(ft5.pvalue)))
