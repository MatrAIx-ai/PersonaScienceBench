#!/usr/bin/env python3
"""
planet_activity_v005 -- recover the latent summary of each case from obs_0 and
predict the future component-A-only values.

Model (obs_0 only, weights w = 1/obs_0_err**2, theta measured from
reference_epoch_day t0 = 0.0 taken from input_0.json):

    y(t) = c0 + b1 sin(thB) + b2 cos(thB) + b3 sin(2 thB) + b4 cos(2 thB)
              + a1 sin(thA) + a2 cos(thA),      thX = 2 pi (t - t0)/P_X

* 7 linear coefficients are the profiled weighted least-squares solution given
  (P_A, P_B); the 2 periods come from a GLOBAL coupled 2-D grid search
  (partial periodogram: B basis projected out by QR) followed by Nelder-Mead
  refinement seeded from the 6 most distinct coarse local minima.
* component_a_present = 1 iff FAP <= 0.01.  FAP is calibrated by a parametric
  bootstrap under H0 (B-only): statistic = max Delta chi2 over the A-period grid
  with P_B frozen at its B-only best (conservative: joint re-optimisation of
  P_B is not credited to the alternative).
* If component_a_present = 0 the reported summary is the H0 (B-only) model and
  P_A / a1 / a2 / future A predictions are written as 0.0.
* Uncertainties: local parametric bootstrap (refinement confined to a +-8 %
  window around the optimum, so that optimiser mode-hopping between distinct
  aliases does not inflate the quoted 1-sigma).  The mode-hopping fraction
  itself is reported separately as a multi-modality diagnostic.
"""
import json
import numpy as np
import pandas as pd
from scipy.optimize import minimize

RNG = np.random.default_rng(20260422)
N_FAP = 500          # H0 (B-only) replicates for the FAP
N_BOOT = 300         # local parametric bootstrap for the quoted errors
FAP_LEVEL = 0.01
BOOT_WIN = 0.08      # +-8 % period window for the local bootstrap refinement
PB_MIN, PB_MAX, PB_N = 5.0, 150.0, 1200
PA_MIN, PA_MAX, PA_N = 1.5, 300.0, 2000
DET_MIN, DET_MAX, DET_N = 0.5, 400.0, 3000    # presence-test grid (edge hygiene)

# ------------------------------------------------------------- model pieces --
def X_B(t, PB):
    f = 2*np.pi/PB
    return np.column_stack([np.ones_like(t), np.sin(f*t), np.cos(f*t),
                            np.sin(2*f*t), np.cos(2*f*t)])

def X_A(t, PA):
    g = 2*np.pi/PA
    return np.column_stack([np.sin(g*t), np.cos(g*t)])

def lin_fit(X, y, w):
    b, *_ = np.linalg.lstsq(X*w[:, None], y*w, rcond=None)
    r = y - X@b
    return b, float(np.sum((w*r)**2))

def chi2_B(t, y, w, PB):
    return lin_fit(X_B(t, PB), y, w)[1]

def chi2_J(t, y, w, PB, PA):
    return lin_fit(np.hstack([X_B(t, PB), X_A(t, PA)]), y, w)[1]

def _obj(logp, t, y, w, ctr, win):
    PB, PA = np.exp(logp)
    if not (0.5 < PB < 1e4 and 0.2 < PA < 1e4):
        return 1e18
    if win is not None and (abs(PB/ctr[0]-1) > win or abs(PA/ctr[1]-1) > win):
        return 1e18
    return chi2_J(t, y, w, PB, PA)

def refine_joint(t, y, w, PB0, PA0, ctr=None, win=None):
    r = minimize(_obj, np.log([PB0, PA0]), args=(t, y, w, ctr, win),
                 method='Nelder-Mead',
                 options=dict(xatol=1e-9, fatol=1e-10, maxiter=3000, maxfev=3000))
    PB, PA = np.exp(r.x)
    return chi2_J(t, y, w, PB, PA), PB, PA

def refine_B(t, y, w, PB0, win=0.01, passes=2):
    PB = PB0
    for i in range(passes):
        half = win*(0.5**i)
        fine = np.linspace(PB*(1-half), PB*(1+half), 401)
        PB = fine[int(np.argmin([chi2_B(t, y, w, p) for p in fine]))]
    return chi2_B(t, y, w, PB), PB

def scan_2d(t, y, w, PBg, PAg):
    """chi2 of the joint model on the (P_B, P_A) grid (partial periodogram)."""
    ph = 2*np.pi/PAg
    S0 = np.sin(t[:, None]*ph[None, :])
    C0 = np.cos(t[:, None]*ph[None, :])
    grid = np.empty((len(PBg), len(PAg)))
    for i, PB in enumerate(PBg):
        Q, _ = np.linalg.qr(X_B(t, PB)*w[:, None])
        r = y*w - Q@(Q.T@(y*w))
        r2 = float(r@r)
        S = S0*w[:, None]; C = C0*w[:, None]
        Sp = S - Q@(Q.T@S); Cp = C - Q@(Q.T@C)
        a = np.einsum('ij,ij->j', Sp, Sp); b = np.einsum('ij,ij->j', Cp, Cp)
        c = np.einsum('ij,ij->j', Sp, Cp)
        Ys = Sp.T@r; Yc = Cp.T@r
        D = a*b - c**2
        ok = D > 1e-10
        grid[i] = r2 - np.where(ok, (b*Ys**2 + a*Yc**2 - 2*c*Ys*Yc)
                                / np.where(ok, D, 1.0), 0.0)
    return grid

def distinct_local_minima(grid, PBg, PAg, k=6, sep=0.12):
    out = []
    for flat in np.argsort(grid.ravel()):
        i, j = np.unravel_index(flat, grid.shape)
        pb, pa = PBg[i], PAg[j]
        if all(abs(np.log(pb/s[0])) > sep or abs(np.log(pa/s[1])) > sep for s in out):
            out.append((pb, pa, grid[i, j]))
        if len(out) >= k:
            break
    return out

def dedupe(cands, sep=0.02):
    """keep only the best refined fit of each distinct (P_B,P_A) basin"""
    keep = []
    for ch, pb, pa in sorted(cands, key=lambda z: z[0]):
        same = any(abs(np.log(pb/k[1])) <= sep and abs(np.log(pa/k[2])) <= sep
                   for k in keep)
        if not same:
            keep.append((ch, pb, pa))
    return keep

def max_delta_chi2(t, y, w, PB, PAgrid):
    """Delta chi2 maximised over the A grid, P_B frozen -> presence statistic."""
    Q, _ = np.linalg.qr(X_B(t, PB)*w[:, None])
    r = y*w - Q@(Q.T@(y*w))
    ph = 2*np.pi/PAgrid
    S = np.sin(t[:, None]*ph[None, :])*w[:, None]
    C = np.cos(t[:, None]*ph[None, :])*w[:, None]
    a = (S*S).sum(0); b = (C*C).sum(0); c = (S*C).sum(0)
    Ys = S.T@r; Yc = C.T@r
    D = a*b - c**2
    ok = D > 1e-10
    red = np.where(ok, (b*Ys**2 + a*Yc**2 - 2*c*Ys*Yc)/np.where(ok, D, 1.0), -np.inf)
    k = int(np.nanargmax(red))
    return float(red[k]), float(PAgrid[k])
def max_delta_chi2(t, y, w, PB, PAgrid):
    """Presence statistic: Delta chi2 maximised over the A grid (P_B frozen),
    together with the period and the A amplitude of the best-fitting trial."""
    Q, _ = np.linalg.qr(X_B(t, PB)*w[:, None])
    r = y*w - Q@(Q.T@(y*w))
    ph = 2*np.pi/PAgrid
    S = np.sin(t[:, None]*ph[None, :])*w[:, None]
    C = np.cos(t[:, None]*ph[None, :])*w[:, None]
    a = (S*S).sum(0); b = (C*C).sum(0); c = (S*C).sum(0)
    Ys = S.T@r; Yc = C.T@r
    D = a*b - c**2
    ok = D > 1e-10
    red = np.where(ok, (b*Ys**2 + a*Yc**2 - 2*c*Ys*Yc)/np.where(ok, D, 1.0), -np.inf)
    k = int(np.nanargmax(red))
    PA = float(PAgrid[k])
    bq, _ = lin_fit(np.hstack([X_B(t, PB), X_A(t, PA)]), y, w)
    return float(red[k]), PA, float(np.hypot(bq[5], bq[6]))

# ---------------------------------------------------------------- load ------
meta = json.load(open('data/input_0.json'))
T0 = float(meta['reference_epoch_day'])
assert T0 == 0.0, 'the design folds t0 = reference_epoch_day; abort if != 0'
cases = list(meta['case_order'])
ch = meta['primary_channel']
d1 = pd.read_csv('data/input_1.csv')
d2 = pd.read_csv('data/input_2.csv', dtype={'case_id': str, 'time_day': str})

PBg = np.exp(np.linspace(np.log(PB_MIN), np.log(PB_MAX), PB_N))
PAg = np.exp(np.linspace(np.log(PA_MIN), np.log(PA_MAX), PA_N))
Pd = np.exp(np.linspace(np.log(DET_MIN), np.log(DET_MAX), DET_N))
PBg_c = PBg[::3]

rows, report = [], []
for c in cases:
    g = d1[d1.case_id == c].sort_values('time_day')
    t = g.time_day.values.astype(float); y = g[ch].values.astype(float)
    w = 1.0/g[ch+'_err'].values.astype(float); n = len(t)

    # H0 reference model (fundamental + first harmonic + offset)
    chiB_grid = np.array([chi2_B(t, y, w, p) for p in PBg])
    chiB0, PB0 = refine_B(t, y, w, PBg[int(np.argmin(chiB_grid))])
    bB0, chiB0 = lin_fit(X_B(t, PB0), y, w)
    dofB = n - 5

    # global coupled 2-D search, refined from the 6 distinct coarse minima
    grid = scan_2d(t, y, w, PBg, PAg)
    seeds = distinct_local_minima(grid, PBg, PAg, k=6)
    cands = dedupe([refine_joint(t, y, w, pb, pa) for pb, pa, _ in seeds])
    (chiJ, PB, PA), runner = cands[0], cands[1]
    dofJ = n - 7

    # significance of A (FAP calibrated under H0 = B-only)
    dchi2, PA_peak, amp_peak = max_delta_chi2(t, y, w, PB0, Pd)
    model_B = X_B(t, PB0)@bB0
    null_stat = np.empty(N_FAP); null_amp = np.empty(N_FAP)
    for k in range(N_FAP):
        ys = model_B + RNG.normal(0.0, 1.0/w)
        cg = np.array([chi2_B(t, ys, w, p) for p in PBg_c])
        _, PBn = refine_B(t, ys, w, PBg_c[int(np.argmin(cg))])
        null_stat[k], _, null_amp[k] = max_delta_chi2(t, ys, w, PBn, Pd)
    fap = float(np.sum(null_stat >= dchi2) + 1.0)/(N_FAP + 1.0)
    present = int(fap <= FAP_LEVEL)

    # reported model: joint if A present, otherwise the H0 (B-only) model
    if present:
        Xfin = np.hstack([X_B(t, PB), X_A(t, PA)])
        coef, chi_fin = lin_fit(Xfin, y, w)
        PB_out, PA_out, a1, a2 = PB, PA, coef[5], coef[6]
        names = ['off', 'sB', 'cB', 'sB2', 'cB2', 'sA', 'cA']
        dof_fin = dofJ
    else:
        Xfin = X_B(t, PB_out := PB0)
        coef, chi_fin = lin_fit(Xfin, y, w)
        PA_out = a1 = a2 = 0.0
        names = ['off', 'sB', 'cB', 'sB2', 'cB2']
        dof_fin = dofB

    # local parametric bootstrap (windowed refinement) + mode-hopping diagnostic
    model_fin = Xfin@coef
    tt = d2[d2.case_id == c].time_day.values.astype(float)
    bsC = np.full((N_BOOT, len(coef)), np.nan); bsP = np.full((N_BOOT, 2), np.nan)
    pred_loc = np.full((N_BOOT, len(tt)), np.nan)
    hop = 0
    for k in range(N_BOOT):
        ys = model_fin + RNG.normal(0.0, 1.0/w)
        if present:
            _, PBs, PAs = refine_joint(t, ys, w, PB, PA, ctr=(PB, PA), win=BOOT_WIN)
            bc, _ = lin_fit(np.hstack([X_B(t, PBs), X_A(t, PAs)]), ys, w)
            bsP[k] = (PBs, PAs); bsC[k] = bc
            th = 2*np.pi*tt/PAs
            pred_loc[k] = bc[5]*np.sin(th) + bc[6]*np.cos(th)
            chg, PBg2, PAgen = refine_joint(t, ys, w, PB, PA)
            if (PBg2/PB-1 > 0.02 or PAgen/PA-1 > 0.02) and chg < _obj(
                    np.log([PBs, PAs]), t, ys, w, (PB, PA), BOOT_WIN) - 1e-6:
                hop += 1
        else:
            _, PBs = refine_B(t, ys, w, PB0, win=BOOT_WIN, passes=3)
            bsP[k, 0] = PBs
            bsC[k] = lin_fit(X_B(t, PBs), ys, w)[0]
    def nansd(A, axis=0):
        ok = np.isfinite(A)
        return np.array([float(np.std(A[:, j][ok[:, j]])) if ok[:, j].sum() > 2 else float('nan')
                         for j in range(A.shape[1])])
    sd = nansd(bsC); sdP = nansd(bsP)
    pred_sd = nansd(pred_loc) if present else np.zeros(len(tt))

    rows.append(dict(case_id=c, component_a_present=present,
                     component_a_period_day=PA_out,
                     component_a_basis1_u0=a1, component_a_basis2_u0=a2,
                     component_b_period_day=PB_out,
                     component_b_basis1_u0=coef[1], component_b_basis2_u0=coef[2],
                     component_b_basis3_u0=coef[3], component_b_basis4_u0=coef[4],
                     offset_u0=coef[0]))
    report.append(dict(case=c, n=n, T=float(t.max()-t.min()), PB_out=PB_out,
                       PA_out=PA_out, sdPB=float(sdP[0]), sdPA=float(sdP[1]),
                       chi2dof_B=chiB0/dofB, chi2dof_fin=chi_fin/dof_fin,
                       PB0=PB0, dchi2=dchi2, PA_peak=PA_peak, amp_peak=amp_peak,
                       null_med=float(np.median(null_stat)),
                       null_p95=float(np.percentile(null_stat, 95)),
                       null_amp_med=float(np.median(null_amp)),
                       null_amp_p95=float(np.percentile(null_amp, 95)),
                       fap=fap, present=present, hop=hop,
                       coef=dict(zip(names, [float(v) for v in coef])),
                       coef_sd=dict(zip(names, [float(v) for v in sd])),
                       ampA=float(np.hypot(a1, a2)),
                       ampB1=float(np.hypot(coef[1], coef[2])),
                       ampB2=float(np.hypot(coef[3], coef[4])),
                       off=float(coef[0]),
                       rrms=float(np.sqrt(np.mean((y-model_fin)**2))/np.mean(1/w)),
                       dfreq=float(abs(1/PA_out - 1/PB_out)) if present else float('nan'),
                       pred_sd=[float(v) for v in pred_sd],
                       best=(chiJ/dofJ, PB, PA), runner=(runner[0]/dofJ, runner[1], runner[2]),
                       others=[(round(cc/dofJ, 3), pp, qq) for cc, pp, qq in cands[2:]],
                       n_cand=len(cands)))

# ------------------------------------------------------------------ write ---
cols_s = ['case_id', 'component_a_present', 'component_a_period_day',
          'component_a_basis1_u0', 'component_a_basis2_u0',
          'component_b_period_day', 'component_b_basis1_u0',
          'component_b_basis2_u0', 'component_b_basis3_u0',
          'component_b_basis4_u0', 'offset_u0']
S = pd.DataFrame(rows)[cols_s]

def fmt(v):
    """full-precision scalars; integer flags as 0/1; exact zeros as 0.0"""
    if isinstance(v, (int, np.integer)):
        return '%d' % v
    v = float(v)
    return '0.0' if v == 0.0 else '%.17g' % v

with open('signal_summary.csv', 'w') as fh:
    fh.write(','.join(cols_s) + '\n')
    for _, r in S.iterrows():
        fh.write(','.join([str(r['case_id'])] + [fmt(r[k]) for k in cols_s[1:]]) + '\n')

Sm = S.set_index('case_id')
lines = ['case_id,time_day,component_a_value_u0']
for c, ts_str in zip(d2.case_id.values, d2.time_day.values):
    ts = float(ts_str); r = Sm.loc[c]
    PA_i = float(r.component_a_period_day)
    v = 0.0 if int(r.component_a_present) == 0 else float(
        r.component_a_basis1_u0*np.sin(2*np.pi*(ts - T0)/PA_i) +
        r.component_a_basis2_u0*np.cos(2*np.pi*(ts - T0)/PA_i))
    lines.append('%s,%s,%s' % (c, ts_str, fmt(v)))
open('target_predictions.csv', 'w').write('\n'.join(lines) + '\n')

# ----------------------------------- summary <-> target consistency contract --
S_chk = pd.read_csv('signal_summary.csv')
T_chk = pd.read_csv('target_predictions.csv', dtype={'case_id': str, 'time_day': str})
assert list(S_chk.columns) == cols_s and len(S_chk) == 4 == len(cases)
assert list(S_chk.case_id) == cases
assert list(T_chk.columns) == ['case_id', 'time_day', 'component_a_value_u0']
assert len(T_chk) == len(d2)
assert (T_chk.case_id.values == d2.case_id.values).all()
assert (T_chk.time_day.values == d2.time_day.values).all()
assert set(np.unique(S_chk.component_a_present)) <= {0, 1}
assert np.isfinite(S_chk[cols_s[2:]].to_numpy(dtype=float)).all()
assert np.isfinite(T_chk.component_a_value_u0.to_numpy(dtype=float)).all()
Sm2 = S_chk.set_index('case_id')
recalc = np.empty(len(T_chk))
for i, (c, ts) in enumerate(zip(T_chk.case_id.values,
                                T_chk.time_day.values.astype(float))):
    r = Sm2.loc[c]
    PA_i = float(r.component_a_period_day)
    recalc[i] = 0.0 if int(r.component_a_present) == 0 else float(
        r.component_a_basis1_u0*np.sin(2*np.pi*(ts - T0)/PA_i) +
        r.component_a_basis2_u0*np.cos(2*np.pi*(ts - T0)/PA_i))
max_diff = float(np.max(np.abs(recalc - T_chk.component_a_value_u0.to_numpy())))
assert max_diff <= 1e-9, max_diff
for _, r in S_chk.iterrows():
    if int(r.component_a_present) == 0:
        assert (r.component_a_period_day == 0.0 and r.component_a_basis1_u0 == 0.0
                and r.component_a_basis2_u0 == 0.0)
        assert (T_chk[T_chk.case_id == r.case_id].component_a_value_u0 == 0.0).all()

# ------------------------------------------------------------------ report ---
print('t0 = reference_epoch_day = %g | channel = %s | weights = 1/obs_0_err^2' % (T0, ch))
print('search: P_B [%.1f,%.1f]x%d  x  P_A [%.1f,%.1f]x%d ; presence grid P_A [%.2f,%.1f]x%d'
      % (PB_MIN, PB_MAX, PB_N, PA_MIN, PA_MAX, PA_N, DET_MIN, DET_MAX, DET_N))
print('rule: component_a_present = 1  iff  FAP <= %.2f  (%d H0 B-only replicates)'
      % (FAP_LEVEL, N_FAP))
print('errors: %d-replicate local parametric bootstrap (periods within +/-%.0f%%)\n'
      % (N_BOOT, 100*BOOT_WIN))
for R in report:
    print('=== %s (n=%d, baseline=%.1f d)' % (R['case'], R['n'], R['T']))
    print('  chi2/dof  B-only=%.3f   reported model=%.3f   resid rms / mean obs_0_err=%.3f'
          % (R['chi2dof_B'], R['chi2dof_fin'], R['rrms']))
    print('  P_B = %.5f +/- %.5f      P_A = %.5f +/- %.5f      |1/P_A - 1/P_B| = %.5f  (1/T = %.5f)'
          % (R['PB_out'], R['sdPB'], R['PA_out'], R['sdPA'], R['dfreq'], 1.0/R['T']))
    print('  amplitudes: A=%.3f  B_fund=%.3f  B_harm=%.3f  offset=%.3f'
          % (R['ampA'], R['ampB1'], R['ampB2'], R['off']))
    print('  coefficients +/- bootstrap sd:')
    print('     ' + '   '.join('%s=%+.4f+/-%.4f' % (k, R['coef'][k], R['coef_sd'][k])
                               for k in R['coef']))
    print('  A presence: max Dchi2 = %.2f at P_A,peak = %.3f d, ampA = %.3f'
          % (R['dchi2'], R['PA_peak'], R['amp_peak']))
    print('     H0 null: Dchi2 med %.1f / p95 %.1f ; ampA med %.2f / p95 %.2f  ->  FAP = %.4f  ->  present = %d'
          % (R['null_med'], R['null_p95'], R['null_amp_med'], R['null_amp_p95'],
             R['fap'], R['present']))
    print('  distinct refined optima (chi2/dof, P_B, P_A): %s'
          % [('%.3f' % a, round(b, 4), round(cc, 4)) for a, b, cc in
             [(R['best'][0], R['best'][1], R['best'][2]),
              (R['runner'][0], R['runner'][1], R['runner'][2])] + R['others']])
    print('     winner margin: runner-up/best chi2/dof = %.2f ; Delta chi2 = %.1f'
          % (R['runner'][0]/max(R['best'][0], 1e-12),
             (R['runner'][0]-R['best'][0])*(R['n']-7)))
    if R['present']:
        print('  local-bootstrap A-prediction sd: first %.2f  last %.2f  max %.2f u0'
              ' ; multi-modal (mode-hopping) replicates: %d/%d'
              % (R['pred_sd'][0], R['pred_sd'][-1], max(R['pred_sd']), R['hop'], N_BOOT))
    else:
        print('  A fields written as 0.0 (report model is the B-only fit above)')
    print()

print('--- presence statistic vs lower grid edge (P_B frozen at B-only best; same H0 nulls) ---')
for R, c in zip(report, cases):
    g = d1[d1.case_id == c].sort_values('time_day')
    t = g.time_day.values.astype(float); y = g['obs_0'].values.astype(float)
    w = 1.0/g['obs_0_err'].values.astype(float)
    out = []
    for lo in (0.5, 1.0, 1.5, 2.0, 3.0, 5.0):
        Plo = np.exp(np.linspace(np.log(lo), np.log(DET_MAX), DET_N))
        dc, pk, _ = max_delta_chi2(t, y, w, R['PB0'], Plo)
        out.append('lo=%.1f: %.1f@%.2fd' % (lo, dc, pk))
    print('  %s | H0 p95 = %.1f | %s' % (c, R['null_p95'], '  '.join(out)))

print('\nsummary <-> target consistency: max |target - recomputed from signal_summary| = %.3e (assert ok)'
      % max_diff)
print('rows: signal_summary = %d ; target_predictions = %d (input_2 rows = %d)'
      % (len(S_chk), len(T_chk), len(d2)))
print()
print(S_chk.to_string(index=False))
