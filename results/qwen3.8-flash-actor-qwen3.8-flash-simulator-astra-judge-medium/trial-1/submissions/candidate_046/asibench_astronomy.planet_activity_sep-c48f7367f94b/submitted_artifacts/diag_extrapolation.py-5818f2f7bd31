#!/usr/bin/env python3
"""Out-of-sample control for the recovered summary.

Fit each model on the FIRST 60 % of every case's baseline and predict the held-out
last 40 % of obs_0.  This probes exactly the risk that matters for
target_predictions.csv (extrapolation to ~2.5 x the baseline): does the recovered
component A improve out-of-sample prediction, or is it overfitting?
Metrics are residual rms normalised by obs_0_err (1.0 = noise level).
"""
import sys
import numpy as np, pandas as pd
FRAC = float(sys.argv[1]) if len(sys.argv) > 1 else 0.6
from scipy.optimize import minimize

d1 = pd.read_csv('data/input_1.csv')

def X_B(t, P):
    f = 2*np.pi/P
    return np.column_stack([np.ones_like(t), np.sin(f*t), np.cos(f*t),
                            np.sin(2*f*t), np.cos(2*f*t)])

def X_A(t, P):
    g = 2*np.pi/P
    return np.column_stack([np.sin(g*t), np.cos(g*t)])

def lf(X, y, w):
    b, *_ = np.linalg.lstsq(X*w[:, None], y*w, rcond=None)
    r = y - X@b
    return b, float(np.sum((w*r)**2))

def cB(t, y, w, P):  return lf(X_B(t, P), y, w)[1]
def cJ(t, y, w, PB, PA): return lf(np.hstack([X_B(t, PB), X_A(t, PA)]), y, w)[1]

def fit_B(t, y, w):
    Pg = np.exp(np.linspace(np.log(5), np.log(150), 800))
    c = np.array([cB(t, y, w, p) for p in Pg]); p0 = Pg[int(np.argmin(c))]
    fine = np.linspace(p0*0.99, p0*1.01, 801)
    c = np.array([cB(t, y, w, p) for p in fine]); p = fine[int(np.argmin(c))]
    return cB(t, y, w, p), p

def fit_J(t, y, w):
    PBg = np.exp(np.linspace(np.log(5), np.log(150), 400))
    PAg = np.exp(np.linspace(np.log(1.5), np.log(300), 800))
    ph = 2*np.pi/PAg
    S0 = np.sin(t[:, None]*ph[None, :]); C0 = np.cos(t[:, None]*ph[None, :])
    grid = np.empty((len(PBg), len(PAg)))
    for i, PB in enumerate(PBg):
        Q, _ = np.linalg.qr(X_B(t, PB)*w[:, None])
        r = y*w - Q@(Q.T@(y*w)); r2 = float(r@r)
        S = S0*w[:, None]; C = C0*w[:, None]
        Sp = S - Q@(Q.T@S); Cp = C - Q@(Q.T@C)
        a = (Sp*Sp).sum(0); b = (Cp*Cp).sum(0); cc = (Sp*Cp).sum(0)
        Ys = Sp.T@r; Yc = Cp.T@r; D = a*b - cc**2
        ok = D > 1e-10
        grid[i] = r2 - np.where(ok, (b*Ys**2 + a*Yc**2 - 2*cc*Ys*Yc)/np.where(ok, D, 1.), 0.)
    seeds, order = [], np.argsort(grid.ravel())
    for fl in order:
        i, j = np.unravel_index(fl, grid.shape); pb, pa = PBg[i], PAg[j]
        if all(abs(np.log(pb/s[0])) > .12 or abs(np.log(pa/s[1])) > .12 for s in seeds):
            seeds.append((pb, pa))
        if len(seeds) >= 4: break
    obj = lambda lp: cJ(t, y, w, *np.exp(lp)) if np.all(np.exp(lp) > 0.3) else 1e18
    best = (1e18, 0, 0)
    for pb, pa in seeds:
        r = minimize(obj, np.log([pb, pa]), method='Nelder-Mead',
                     options=dict(xatol=1e-9, fatol=1e-10, maxfev=3000))
        PB, PA = np.exp(r.x)
        if r.fun < best[0]: best = (r.fun, PB, PA)
    return best

print('%-9s %5s %5s | %-22s | %-22s | %-22s | %s' %
      ('case', 'ntr', 'nte', 'const rms/err', 'B-only rms/err', 'B+A rms/err', 'periods (train vs all)'))
for c, g in d1.groupby('case_id', sort=True):
    t = g.time_day.values.astype(float); y = g.obs_0.values.astype(float)
    w = 1.0/g.obs_0_err.values.astype(float)
    tsp = t.min() + FRAC*(t.max()-t.min())
    tr, te = t < tsp, t >= tsp
    # models fitted on TRAIN only
    c0 = lf(np.ones((tr.sum(), 1)), y[tr], w[tr])
    chiB, PB = fit_B(t[tr], y[tr], w[tr])
    chiJ, PBj, PAj = fit_J(t[tr], y[tr], w[tr])
    bB = lf(X_B(t[tr], PB), y[tr], w[tr])[0]
    bJ = lf(np.hstack([X_B(t[tr], PBj), X_A(t[tr], PAj)]), y[tr], w[tr])[0]
    # out-of-sample normalised rms on the held-out points
    r_const = y[te] - np.ones((te.sum(), 1))@c0[0]
    r_B = y[te] - X_B(t[te], PB)@bB
    r_J = y[te] - np.hstack([X_B(t[te], PBj), X_A(t[te], PAj)])@bJ
    f = lambda r: float(np.sqrt(np.mean((r*w[te])**2)))
    # same fit on ALL data, for period stability
    chiA_all, PA_all = None, None
    chiJ_all, PB_all, PA_all = fit_J(t, y, w)
    print('%-9s %5d %5d | %-22.3f | %-22.3f | %-22.3f | P_B %.3f/%.3f  P_A %.3f/%.3f' %
          (c, tr.sum(), te.sum(), f(r_const), f(r_B), f(r_J), PB, PB_all, PAj, PA_all))
