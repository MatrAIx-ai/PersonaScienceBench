#!/usr/bin/env python3
"""Independent contract check: reads ONLY the two output CSVs plus the inputs."""
import json, numpy as np, pandas as pd
COLS = ['case_id','component_a_present','component_a_period_day','component_a_basis1_u0',
        'component_a_basis2_u0','component_b_period_day','component_b_basis1_u0',
        'component_b_basis2_u0','component_b_basis3_u0','component_b_basis4_u0','offset_u0']
meta = json.load(open('data/input_0.json')); t0 = float(meta['reference_epoch_day'])
cases = meta['case_order']
S = pd.read_csv('signal_summary.csv', dtype={'case_id': str})
T = pd.read_csv('target_predictions.csv', dtype={'case_id': str, 'time_day': str})
raw_t = pd.read_csv('data/input_2.csv', dtype={'case_id': str, 'time_day': str})
d1 = pd.read_csv('data/input_1.csv', dtype={'case_id': str})
txt = {f: open(f).read() for f in ['signal_summary.csv','target_predictions.csv']}
chk = []
chk.append(('summary header exact', list(S.columns) == COLS))
chk.append(('summary has exactly 4 rows', len(S) == 4 == meta['n_cases']))
chk.append(('case_id order/values == input_0.case_order', list(S.case_id) == cases))
chk.append(('flag in {0,1}', set(S.component_a_present.unique()) <= {0,1}))
chk.append(('no NaN/inf in summary', np.isfinite(S[COLS[1:]].to_numpy(float)).all()))
chk.append(('target header exact', list(T.columns) == ['case_id','time_day','component_a_value_u0']))
chk.append(('one row per input_2 row, same order/values',
            len(T) == len(raw_t) and (T.case_id.values == raw_t.case_id.values).all()
            and (T.time_day.values == raw_t.time_day.values).all()))
chk.append(('no NaN/inf in target', np.isfinite(T.component_a_value_u0.to_numpy(float)).all()))
num = __import__('re').compile(r'^-?\d+(\.\d+)?([eE][-+]?\d+)?$')
bad_cells = []
for f, ncol in [('signal_summary.csv', 11), ('target_predictions.csv', 3)]:
    for line in txt[f].splitlines()[1:]:          # data rows only, header excluded
        cells = line.split(',')
        for cell in cells[1:] if f.startswith('signal') else cells[2:]:
            if not num.match(cell):
                bad_cells.append((f, cell))
chk.append(('every numeric cell is a plain float scalar (bad: %s)' % bad_cells[:3], not bad_cells))
chk.append(('no index column / extra commas',
            all(len(l.split(',')) == len(COLS) for l in txt['signal_summary.csv'].split() if l)
            and all(len(l.split(',')) == 3 for l in txt['target_predictions.csv'].split() if l)))
bad_abs = [r.case_id for _, r in S.iterrows() if int(r.component_a_present) == 0 and (
    r.component_a_period_day != 0.0 or r.component_a_basis1_u0 != 0.0 or r.component_a_basis2_u0 != 0.0
    or (T[(T.case_id == r.case_id).values].component_a_value_u0 != 0.0).any())]
chk.append(('absent => all A fields and predictions == 0.0', not bad_abs))
# A-only prediction must be exactly the summary's sinusoid (no offset, no B)
Sm = S.set_index('case_id'); tt = T.time_day.values.astype(float); err = 0.0
for i, c in enumerate(T.case_id.values):
    r = Sm.loc[c]; PA = float(r.component_a_period_day)
    v = 0.0 if int(r.component_a_present) == 0 else float(
        r.component_a_basis1_u0*np.sin(2*np.pi*(tt[i]-t0)/PA) +
        r.component_a_basis2_u0*np.cos(2*np.pi*(tt[i]-t0)/PA))
    err = max(err, abs(v - float(T.component_a_value_u0.iloc[i])))
chk.append(('summary -> target consistency (max diff %.2e <= 1e-9)' % err, err <= 1e-9))
# |prediction| never exceeds the summary amplitude
for _, r in S.iterrows():
    if int(r.component_a_present):
        a = T[(T.case_id == r.case_id).values].component_a_value_u0.to_numpy(float)
        chk.append(('  %s |A| <= sqrt(b1^2+b2^2) = %.3f' % (r.case_id, np.hypot(r.component_a_basis1_u0, r.component_a_basis2_u0)),
                    np.abs(a).max() <= np.hypot(r.component_a_basis1_u0, r.component_a_basis2_u0) + 1e-12))
# the summary must actually describe obs_0 (reconstruction chi2/dof)
for _, r in S.iterrows():
    g = d1[d1.case_id == r.case_id]; t = g.time_day.values.astype(float)
    y = g.obs_0.values.astype(float); e = g.obs_0_err.values.astype(float)
    fB = 2*np.pi/float(r.component_b_period_day)
    mod = (float(r.offset_u0) + float(r.component_b_basis1_u0)*np.sin(fB*t) +
           float(r.component_b_basis2_u0)*np.cos(fB*t) +
           float(r.component_b_basis3_u0)*np.sin(2*fB*t) +
           float(r.component_b_basis4_u0)*np.cos(2*fB*t))
    if int(r.component_a_present):
        fA = 2*np.pi/float(r.component_a_period_day)
        mod += float(r.component_a_basis1_u0)*np.sin(fA*t) + float(r.component_a_basis2_u0)*np.cos(fA*t)
    k = 7 if int(r.component_a_present) else 5
    chk.append(('  %s summary reproduces obs_0: chi2/dof = %.3f' % (r.case_id, np.mean(((y-mod)/e)**2)*len(t)/(len(t)-k)),
                0.5 < np.mean(((y-mod)/e)**2)*len(t)/(len(t)-k) < 1.6))
for name, ok in chk:
    print(('PASS  ' if ok else 'FAIL  ') + name)
print('\n%d/%d checks passed' % (sum(o for _, o in chk), len(chk)))
