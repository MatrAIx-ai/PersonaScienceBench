def _png_write(path, rgb):
    import struct, zlib
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    hdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", hdr)
                 + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))

class _Canvas:
    def __init__(self, w, h):
        self.px = np.full((h, w, 3), 255, np.uint8)
        self.h, self.w = h, w
    def dot(self, x, y, c, r=0):
        x, y = int(round(x)), int(round(y))
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                if dx * dx + dy * dy <= r * r + r:
                    xx, yy = x + dx, y + dy
                    if 0 <= xx < self.w and 0 <= yy < self.h:
                        self.px[yy, xx] = c
    def line(self, x0, y0, x1, y1, c, r=0):
        n = int(max(abs(x1 - x0), abs(y1 - y0), 1)) * 2
        for t in np.linspace(0, 1, n + 1):
            self.dot(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, c, r)
    def rect(self, x0, y0, x1, y1, c, w=1):
        self.line(x0, y0, x1, y0, c, w - 1); self.line(x0, y1, x1, y1, c, w - 1)
        self.line(x0, y0, x0, y1, c, w - 1); self.line(x1, y0, x1, y1, c, w - 1)
    def text(self, x, y, s, c=(0, 0, 0), sc=2):
        cx = x
        for ch in s.upper():
            g = _GLYPHS.get(ch, _GLYPHS[" "])
            for gy in range(7):
                for gx in range(5):
                    if g[gy][gx] == "1":
                        self.rect(cx + gx * sc, y + gy * sc,
                                  cx + gx * sc + sc - 1, y + gy * sc + sc - 1, c)
            cx += 6 * sc

def _panel(cv, box, xlim, ylim, title):
    x0, y0, x1, y1 = box                      # y0=top,y1=bottom (px)
    sx = lambda v: x0 + (v - xlim[0]) / (xlim[1] - xlim[0]) * (x1 - x0)
    sy = lambda v: y1 - (v - ylim[0]) / (ylim[1] - ylim[0]) * (y1 - y0)
    cv.rect(x0, y0, x1, y1, (0, 0, 0))
    for f in np.linspace(0, 1, 5):            # gridlines + ticks
        gx = int(x0 + f * (x1 - x0)); gy = int(y0 + f * (y1 - y0))
        cv.line(gx, y1, gx, y1 - 6, (0, 0, 0)); cv.line(x0, gy, x0 + 6, gy, (0, 0, 0))
        vx = xlim[0] + f * (xlim[1] - xlim[0]); vy = ylim[1] - f * (ylim[1] - ylim[0])
        cv.text(gx - 12, y1 + 4, f"{vx:.3g}"[:6], (0, 0, 0), 1)
        cv.text(max(x0 - 42, 2), gy - 4, f"{vy:.4g}"[:7], (0, 0, 0), 1)
    cv.text(x0 + 4, y0 - 16, title[:90], (0, 0, 0), 2)
    return sx, sy

def _curve(cv, sx, sy, x, y, c, w=2):
    for i in range(len(x) - 1):
        cv.line(sx(x[i]), sy(y[i]), sx(x[i + 1]), sy(y[i + 1]), c, w)

def _pts(cv, sx, sy, x, y, ex, c):
    for i in range(len(x)):
        px, py = sx(x[i]), sy(y[i])
        cv.dot(px, py, c, 3)
        if ex is not None and np.isfinite(ex[i]):
            cv.line(px, sy(y[i] - ex[i]), px, sy(y[i] + ex[i]), c, 1)

