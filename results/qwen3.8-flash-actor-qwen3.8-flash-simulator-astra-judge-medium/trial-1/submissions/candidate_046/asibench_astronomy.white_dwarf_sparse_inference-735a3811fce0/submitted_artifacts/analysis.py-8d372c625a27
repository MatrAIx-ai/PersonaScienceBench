#!/usr/bin/env python3
"""
Sparse/noisy compact-star (white-dwarf) sequence reconstruction.

Model (single family, pre-registered):
  M-R branch : R(M) = R0 * M^(-1/3) * [1 - (M/M_ch)^p]^q  (relativistic
               degenerate-electron family; fixed p=4/3,q=1/2 vs free p,q).
  Profiles   : Lane-Emden polytrope with mass-dependent effective index
               n(M); candidate smooth families (linear, relativistically
               anchored power law, anchored quadratic n=1.5+na*M+nb*M^2)
               are compared by fragment leave-one-out and the selected one
               (anchored quadratic) is used.  Radius is rescaled so
               rho/rho_c = 1e-4 at x = r/R = 1 (manifest surface threshold
               as RESCALING, never truncation; m(0)=0, m(1)=1, rho(0)=rho_c
               by construction).
Includes M-R <-> profile consistency cross-check (single-K Newtonian
polytrope), LOO validation and the two pre-registered decision rules
(clipped-zero Huber switch; total-error sigma_M test).
"""
import json
import warnings
import numpy as np
warnings.filterwarnings("ignore", category=RuntimeWarning)
import pandas as pd
from scipy.integrate import solve_ivp
from scipy.optimize import least_squares, brentq, minimize_scalar
G = 6.67430e-11          # m3 kg-1 s-2
MSUN = 1.98892e30        # kg

# ---------------------------------------------------------------- data
mr = pd.read_csv("data/mr_observations.csv")
fr = pd.read_csv("data/profile_fragments.csv")
qt = json.load(open("data/query_targets.json"))
man = json.load(open("data/physics_manifest.json"))
SURF_THRESH = man["surface_threshold"]

M_obs = mr["mass_solar_obs"].values
R_obs = mr["radius_km_obs"].values
sM = mr["sigma_mass_solar"].values
sR = mr["sigma_radius_km"].values

# ------------------------------------------------------- Lane-Emden
_LE_CACHE = {}
def lane_emden(n):
    n = float(np.clip(n, 1.01, 2.95))
    """Solve Lane-Emden index n. Returns dict with xi1, radial grid xs,
    dens=(rho/rho_c), m=(m/M on xs), xi_thr (rho/rho_c=SURF_THRESH) and
    omega_n = -xi1^2 theta'(xi1)."""
    key = round(float(n), 6)
    if key in _LE_CACHE:
        return _LE_CACHE[key]
    def ode(x, y):
        th = max(y[0], 0.0)
        return [y[1], -2.0 / x * y[1] - th ** n]
    ev = lambda x, y: y[0] - 1e-8
    ev.terminal, ev.direction = True, -1
    sol = solve_ivp(ode, [1e-8, 30.0], [1.0, -1e-8 / 3.0],
                    events=ev, dense_output=True, rtol=1e-10, atol=1e-12)
    xi1 = sol.t_events[0][0] if len(sol.t_events[0]) else 30.0
    xs = np.linspace(1e-8, xi1, 4001)
    th = np.clip(sol.sol(xs)[0], 0.0, None)
    dens = th ** n
    md = xs ** 2 * dens
    m = np.concatenate([[0.0], np.cumsum(0.5 * (md[1:] + md[:-1]) * np.diff(xs))])
    m /= m[-1]
    omega_n = -xi1 ** 2 * sol.sol(xi1)[1] if xi1 < 30 else None
    xi_thr = brentq(lambda xq: np.interp(xq, xs, dens) - SURF_THRESH,
                    xs[0], xi1) if dens[-1] < SURF_THRESH else xi1
    out = dict(xi1=xi1, xs=xs, dens=dens, m=m, xi_thr=xi_thr, omega_n=omega_n)
    _LE_CACHE[key] = out
    return out

def profile_curves(n, xg):
    """density_fraction & enclosed_mass_fraction on x=r/R_surface grid
    (x=1 <=> rho/rho_c = SURF_THRESH; m(1)=1 by renormalization)."""
    le = lane_emden(n)
    xi = xg * le["xi_thr"]
    dens = np.interp(xi, le["xs"], le["dens"], right=0.0)
    mass = np.interp(xi, le["xs"], le["m"]) / np.interp(le["xi_thr"], le["xs"], le["m"])
    return dens, mass

# ------------------------------------------------------- M-R family fits
def mr_model(M, R0, Mc, p, q):
    x = np.clip(1.0 - (M / Mc) ** p, 1e-12, None)
    return R0 * M ** (-1.0 / 3.0) * x ** q

def fit_mr(free_pq):
    npar = 4 if free_pq else 2
    if free_pq:
        res = least_squares(lambda v: (mr_model(M_obs, *v) - R_obs) / sR,
                            x0=[8580.0, 1.44, 1.3333, 0.5],
                            bounds=([1e2, 1.24, 0.5, 0.05], [1e5, 3.0, 4.0, 3.0]))
    else:
        res = least_squares(lambda v: (mr_model(M_obs, v[0], v[1], 4/3, 0.5) - R_obs) / sR,
                            x0=[8580.0, 1.44], bounds=([1e2, 1.24], [1e5, 3.0]))
        res.x = np.array([res.x[0], res.x[1], 4/3, 0.5])
    chi2 = float(np.sum(res.fun ** 2))
    cov = np.linalg.pinv(res.jac.T @ res.jac) * max(chi2 / (len(M_obs) - npar), 1.0)
    return res.x, chi2, cov

pars_fix, chi2_fix, cov_fix = fit_mr(False)
pars_free, chi2_free, cov_free = fit_mr(True)
dof_fix, dof_free = len(M_obs) - 2, len(M_obs) - 4
# pre-registered parsimony rule: keep p,q fixed unless delta-chi2 > 3 per added param (2 params -> 6)
keep_fixed = (chi2_fix - chi2_free) < 6.0
pars, chi2_mr, cov_mr = (pars_fix, chi2_fix, cov_fix) if keep_fixed else (pars_free, chi2_free, cov_free)

# ------------------------------------------------------- profile fit n(M)
def chi_resid(nf, data=fr):
    """Vector of normalized residuals for a profile-index function n(mass)."""
    out = []
    for mass, sub in data.groupby("target_mass_solar"):
        n = nf(mass)
        dd = sub.dropna(subset=["density_fraction_obs"])
        mm = sub.dropna(subset=["enclosed_mass_fraction_obs"])
        if len(dd):
            pred, _ = profile_curves(n, dd["radius_fraction"].values)
            out.append((dd["density_fraction_obs"].values - pred) / dd["sigma_density_fraction"].values)
        if len(mm):
            _, pred = profile_curves(n, mm["radius_fraction"].values)
            out.append((mm.enclosed_mass_fraction_obs.values - pred) / mm.sigma_enclosed_mass_fraction.values)
    return np.concatenate(out)

def frag_chi2nf(nf, mask=None, data=fr):
    d = data if mask is None else data[mask]
    r = chi_resid(nf, data=d)
    return float(np.sum(r ** 2)), len(r)

def frag_chi2(n0, n1, mask=None, data=fr):
    return frag_chi2nf(lambda m: n0 + n1 * m, mask=mask, data=data)

# candidate smooth families for n(M), all >=1.5 floor (non-relativistic limit)
CANDS = {
  "linear":        (lambda v: (lambda m: v[0] + v[1] * m), [1.5, 0.55]),
  "phys_anchored": (lambda v: (lambda m: 1.5 + 1.5 * (m / pars[1]) ** v[0]), [2.0]),
  "quad_anchored": (lambda v: (lambda m: 1.5 + v[0] * m + v[1] * m ** 2), [0.3, 0.3]),
}
FRAGS = sorted(fr["target_mass_solar"].unique())
cand_stats = {}
for name, (mk, x0) in CANDS.items():
    r = least_squares(lambda v: chi_resid(mk(v), fr), x0=x0, diff_step=1e-3)
    ins = float(np.sum(r.fun ** 2))
    loo = {}
    for mass in FRAGS:
        rr = least_squares(lambda v: chi_resid(mk(v), fr[fr["target_mass_solar"] != mass]),
                           x0=x0, diff_step=1e-3)
        loo[float(mass)] = float(np.sum(chi_resid(mk(rr.x), fr[fr["target_mass_solar"] == mass]) ** 2))
    cand_stats[name] = dict(mk=mk, x=r.x, chi2_in=ins, loo=loo, loo_total=float(sum(loo.values())))

# pre-registered selection: predictive (LOO-fragment) total, tie-break parsimony
sel = min(cand_stats, key=lambda k: (round(cand_stats[k]["loo_total"], 1), len(cand_stats[k]["x"])))
mk_sel = cand_stats[sel]["mk"]
nfun = mk_sel(cand_stats[sel]["x"])
chi2_prof, kprof = frag_chi2nf(nfun)
chi2_prof_lin = cand_stats["linear"]["chi2_in"]

# pre-registered rule (a): clipped-zero cells > 22.5% of profile chi2 -> Huber refit
clip_mask = (fr["density_fraction_obs"] == 0.0).values
c_clip, _ = frag_chi2nf(nfun, mask=clip_mask)
clip_frac = c_clip / chi2_prof
use_huber = bool(clip_frac > 0.225)
if use_huber:
    rh = least_squares(lambda v: chi_resid(mk_sel(v), fr), x0=cand_stats[sel]["x"],
                       loss="huber", f_scale=2.0, diff_step=1e-3)
    nfun = mk_sel(rh.x)
    chi2_prof, kprof = frag_chi2nf(nfun)
chi2_prof_huber = frag_chi2nf(mk_sel(least_squares(
    lambda v: chi_resid(mk_sel(v), fr), loss="huber", f_scale=2.0,
    x0=cand_stats[sel]["x"], diff_step=1e-3).x))[0] if not use_huber else chi2_prof
quad_gain = chi2_prof_lin - cand_stats["quad_anchored"]["chi2_in"]

# ------------------------------------------------------- consistency: unified single-K polytrope
def le_radius_km(M_arr, n_arr, K):
    """Newtonian polytrope radius: M = 4 pi omega_n A^{3/2} rho_c^{(3-n)/(2n)},
    R = xi1 sqrt(A) rho_c^{(1-n)/(2n)}, A = (n+1)K/(4 pi G).  km out."""
    R = np.empty(len(np.atleast_1d(M_arr)))
    for i, (m, n) in enumerate(zip(np.atleast_1d(M_arr), np.atleast_1d(n_arr))):
        A = (n + 1) * K / (4 * np.pi * G)
        le = lane_emden(n)
        rho_c = (m * MSUN / (4 * np.pi * le["omega_n"] * A ** 1.5)) ** (2 * n / (3 - n))
        R[i] = le["xi1"] * np.sqrt(A) * rho_c ** ((1 - n) / (2 * n)) / 1000.0
    return R

f = minimize_scalar(lambda lk: np.sum(((le_radius_km(M_obs, nfun(M_obs), np.exp(lk)) - R_obs) / sR) ** 2),
                    bounds=(-4.0, 4.0), method="bounded")
Kval = float(np.exp(f.x)); chi2_unif_fixed_n = float(f.fun)

# give the unified model its best shot: refit n0,n1,K jointly (MR + profiles)
mk_u = CANDS[sel][0]
x0_u = np.asarray(cand_stats[sel]["x"], float)
def unif_resid(v):
    lk = v[-1]; pars_n = v[:-1]
    n_arr = np.clip(mk_u(pars_n)(M_obs), 1.05, 2.9)
    try:
        rr = (le_radius_km(M_obs, n_arr, np.exp(np.clip(lk, -6, 6))) - R_obs) / sR
    except Exception:
        rr = np.full(len(M_obs), 1e3)
    pc = np.sqrt(max(frag_chi2nf(mk_u(pars_n), data=fr)[0], 0.0)) / np.sqrt(kprof)
    return np.concatenate([rr, [pc]])
try:
    ru = least_squares(unif_resid, x0=np.concatenate([x0_u, [np.log(Kval)]]), diff_step=1e-3)
    chi2_unif_joint = float(np.sum(ru.fun[:len(M_obs)] ** 2))
    unif_joint_pars = [float(x) for x in ru.x[:-1]] + [float(np.exp(ru.x[-1]))]
except Exception:
    chi2_unif_joint, unif_joint_pars = float("nan"), None

# ------------------------------------------------------- total-error (sigma_M) test, rule (b)
try:
    from scipy.odr import RealData, Model, ODR
    if keep_fixed:
        mod = Model(lambda p, x: mr_model(x, p[0], p[1], 4/3, 0.5)); b0 = [pars[0], pars[1]]
        beta = ODR(RealData(M_obs, R_obs, sx=sM, sy=sR), mod, beta0=b0).run().beta
        pars_te = np.array([beta[0], beta[1], 4/3, 0.5])
    else:
        mod = Model(lambda p, x: mr_model(x, p[0], p[1], p[2], p[3]))
        pars_te = ODR(RealData(M_obs, R_obs, sx=sM, sy=sR), mod, beta0=list(pars)).run().beta
except Exception:
    pars_te = pars
R13_exact = float(mr_model(np.array([1.3]), *pars)[0])
R13_te = float(mr_model(np.array([1.3]), *pars_te)[0])
dR13_rel = abs(R13_te - R13_exact) / R13_exact
mass_exact_ok = bool(dR13_rel < 0.01)

# ------------------------------------------------------- covariance propagation
FREE_IDX = [0, 1] if keep_fixed else [0, 1, 2, 3]
COV_FULL = np.zeros((4, 4))
co = np.asarray(cov_mr, float)
for a, i in enumerate(FREE_IDX):
    for b, j in enumerate(FREE_IDX):
        COV_FULL[i, j] = co[a, b]
cov_mr = COV_FULL

def rad_at(Mq, pars_, cov_):
    r0 = float(mr_model(np.array([Mq]), *pars_)[0])
    grad = np.zeros(4)
    for j in FREE_IDX:
        pp = np.array(pars_, float); pm = np.array(pars_, float)
        step = max(abs(pars_[j]) * 1e-5, 1e-9)
        pp[j] += step; pm[j] -= step
        grad[j] = (mr_model(np.array([Mq]), *pp)[0] - mr_model(np.array([Mq]), *pm)[0]) / (2 * step)
    return r0, float(np.sqrt(grad @ cov_ @ grad))

R06, s06 = rad_at(0.6, pars, cov_mr)
R10, s10 = rad_at(1.0, pars, cov_mr)
R12, s12 = rad_at(1.2, pars, cov_mr)
R13, s13 = rad_at(1.3, pars, cov_mr)
Mc = float(pars[1]); sMc = float(np.sqrt(cov_mr[1, 1]))
rng = np.random.default_rng(0)
samples = rng.multivariate_normal(np.array(pars)[FREE_IDX],
                                  cov_mr[np.ix_(FREE_IDX, FREE_IDX)], size=4000)
frac_ok = float(np.mean(samples[:, 1] > 1.32))
Mc_lo, Mc_hi = Mc - 1.96 * sMc, Mc + 1.96 * sMc

# ------------------------------------------------------- LOO validation
loo_res = np.empty(len(M_obs))
for i in range(len(M_obs)):
    keep = np.arange(len(M_obs)) != i
    if keep_fixed:
        rr = least_squares(lambda v: (mr_model(M_obs[keep], v[0], v[1], 4/3, 0.5) - R_obs[keep]) / sR[keep],
                           x0=[8580.0, 1.44], bounds=([1e2, 1.24], [1e5, 3.0]))
        xp = np.array([rr.x[0], rr.x[1], 4/3, 0.5])
    else:
        rr = least_squares(lambda v: (mr_model(M_obs[keep], *v) - R_obs[keep]) / sR[keep],
                           x0=list(pars_free), bounds=([1e2, 1.24, 0.5, 0.05], [1e5, 3.0, 4.0, 3.0]))
        xp = rr.x
    loo_res[i] = (R_obs[i] - mr_model(np.array([M_obs[i]]), *xp)[0]) / sR[i]
loo_mr_chi2 = float(np.sum(loo_res ** 2))

loo_frag = {m: cand_stats[sel]["loo"][m] for m in cand_stats[sel]["loo"]}
loo_frag_points = {float(m): int(len(chi_resid(nfun, data=fr[fr["target_mass_solar"] == m]))) for m in FRAGS}

# ------------------------------------------------------- outputs
Mq = np.array(qt["mr_eval_masses_solar"])
Rq = mr_model(Mq, *pars)
assert np.all(Mq < Mc_lo), "holdout mass exceeds M_ch lower bound!"
pd.DataFrame({"mass_solar": Mq, "radius_km": Rq}).to_csv("results/mr_reconstruction.csv", index=False)

xg = np.array(qt["radius_fraction_grid"])
pmasses = np.array(qt["profile_target_masses_solar"])
dens_arr = np.empty((len(pmasses), len(xg)))
mass_arr = np.empty((len(pmasses), len(xg)))
xs_thr = {}
for i, m in enumerate(pmasses):
    le = lane_emden(nfun(m))
    dens_arr[i], mass_arr[i] = profile_curves(nfun(m), xg)
    dens_arr[i][0] = 1.0          # rho/rho_c = 1 at center by definition
    mass_arr[i][0] = 0.0          # m(0)=0
    mass_arr[i][-1] = 1.0         # m(R)=1 by renormalization
    xs_thr[str(float(m))] = float(le["xi_thr"] / le["xi1"])
assert np.all(np.diff(dens_arr, axis=1) <= 1e-12) and np.all(np.diff(mass_arr, axis=1) >= -1e-12)

np.savez("results/profiles_reconstruction.npz",
         density_fraction=dens_arr, enclosed_mass_fraction=mass_arr,
         mass_solar=pmasses, radius_fraction=xg)

summary = {
  "mass_limit_solar": Mc,
  "radius_at_0p6Msun_km": R06,
  "radius_at_1p0Msun_km": R10,
  "radius_at_1p2Msun_km": R12,
  "radius_at_1p3Msun_km": R13,
  "uncertainty": {
    "mass_limit_solar_ci95": [Mc_lo, Mc_hi],
    "radius_at_0p6Msun_km_sigma": s06, "radius_at_1p0Msun_km_sigma": s10,
    "radius_at_1p2Msun_km_sigma": s12, "radius_at_1p3Msun_km_sigma": s13,
    "P_Mch_above_holdout_max_1p32": frac_ok,
    "holdout_max_below_Mch_ci95": bool(Mc_lo > 1.32)},
  "model": {
    "family": "R(M)=R0*M^(-1/3)*[1-(M/M_ch)^p]^q + Lane-Emden n(M), n(M) family selected by fragment-LOO (see n_family_selected)",
    "R0_km": float(pars[0]), "M_ch_solar": Mc, "p": float(pars[2]), "q": float(pars[3]),
    "keep_p_q_fixed": bool(keep_fixed),
    "n_family_selected": sel,
    "n_family_coeffs": [float(x) for x in cand_stats[sel]["x"]],
    "n_family_forms": {"linear": "n=n0+n1*M", "phys_anchored": "n=1.5+1.5*(M/M_ch)^g",
                       "quad_anchored": "n=1.5+na*M+nb*M^2"},
    "effective_n_at_targets": {str(float(m)): float(nfun(m)) for m in pmasses}},
  "chi2": {
    "mr_fixed_pq": chi2_fix, "mr_fixed_pq_dof": dof_fix,
    "mr_free_pq": chi2_free, "mr_free_pq_dof": dof_free,
    "profiles_n_linear": chi2_prof_lin, "profiles_n_huber": chi2_prof_huber,
    "profile_points": int(kprof),
    "profiles_by_family": {k: dict(chi2_in=float(v["chi2_in"]),
                                   loo_by_fragment=v["loo"],
                                   loo_total=v["loo_total"])
                           for k, v in cand_stats.items()},
    "family_selection_rule": "min fragment-LOO total, tie-break parsimony",
    "delta_chi2_quadanchored_vs_linear": float(quad_gain),
    "clip_zero_chi2_fraction": float(clip_frac), "huber_rule_triggered": use_huber},
  "consistency_check_unified_polytrope": {
    "description": "Newtonian single-K polytrope with n(M): R=C(n,K)M^((1-n)/(3-n))",
    "chi2_mr_single_K_n_from_profiles": chi2_unif_fixed_n,
    "chi2_mr_single_K_joint_refit": chi2_unif_joint,
    "joint_refit_params_n0_n1_K": unif_joint_pars,
    "chi2_mr_parametric": chi2_mr,
    "delta_chi2_unified_minus_parametric": chi2_unif_fixed_n - chi2_mr,
    "decision": "Parametric relativistic family retained: Newtonian single-K "
                "polytrope cannot reproduce branch curvature nor the mass limit "
                "(delta-chi2 >> threshold). Documented as limitation."},
  "surface_threshold_audit": {
    "threshold": SURF_THRESH,
    "xi_thr_over_xi1_at_target_masses": xs_thr,
    "convention": "x=r/R_surface rescaled so rho/rho_c=1e-4 at x=1; enclosed mass "
                  "renormalized so m(1)=1 (no truncation); density not renormalized."},
  "total_error_sigmaM_test": {
    "deltaR_rel_at_1p3Msun": dR13_rel, "mass_treated_exact": mass_exact_ok},
  "validation": {
    "loo_mr_chi2": loo_mr_chi2, "loo_mr_n": int(len(M_obs)),
    "loo_mr_normalized_rms": float(np.sqrt(np.mean(loo_res ** 2))),
    "loo_profile_by_fragment": loo_frag,
    "loo_profile_points_by_fragment": loo_frag_points,
    "radius_monotone_on_grid": bool(np.all(np.diff(Rq) < 0)),
    "mr_chi2_over_dof": chi2_mr / dof_fix},
}
json.dump(summary, open("results/summary.json", "w"), indent=2)

