def plot_mpl(path):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(1, 3, figsize=(16.5, 5.2))
    ax[0].errorbar(M_obs, R_obs, yerr=sR, fmt="ko", ms=5, label="observations")
    Mg = np.linspace(0.22, min(Mc_hi, 1.55), 400)
    ax[0].plot(Mg, mr_model(Mg, *pars), "b-", lw=2,
               label=f"fit R0={pars[0]:.0f} km, M_ch={Mc:.3f}")
    ax[0].axvline(Mc, color="r", ls="--", label="M_ch (mass limit)")
    ax[0].axvline(1.32, color="gray", ls=":", label="holdout max 1.32")
    ax[0].plot(Mq, Rq, "g.", ms=7, label="reconstruction grid")
    ax[0].set_xlabel("M [M$_\\odot$]"); ax[0].set_ylabel("R [km]"); ax[0].set_ylim(0, 14500)
    ax[0].set_title(f"M-R branch  $\\chi^2$/dof={chi2_mr/dof_fix:.2f}  "
                    f"LOO rms={np.sqrt(np.mean(loo_res**2)):.2f}$\\sigma$")
    ax[0].legend(fontsize=8)
    cols = ["#1b58b4", "#d62728", "#1f9646"]
    for i, m in enumerate(pmasses):
        ax[1].plot(xg, dens_arr[i], color=cols[i], lw=2, label=f"model M={m} (n={float(nfun(m)):.2f})")
        ax[2].plot(xg, mass_arr[i], color=cols[i], lw=2, label=f"model M={m}")
    for mass in [0.36, 0.84, 1.16]:
        sub = fr[fr["target_mass_solar"] == mass]
        dd = sub.dropna(subset=["density_fraction_obs"])
        mm = sub.dropna(subset=["enclosed_mass_fraction_obs"])
        i = {0.36: 0, 0.84: 1, 1.16: 2}[mass]
        ax[1].errorbar(dd["radius_fraction"], dd["density_fraction_obs"],
                       yerr=dd["sigma_density_fraction"], fmt="s", color=cols[i], ms=5,
                       label=f"data M={mass}")
        ax[2].errorbar(mm["radius_fraction"], mm["enclosed_mass_fraction_obs"],
                       yerr=mm["sigma_enclosed_mass_fraction"], fmt="s", color=cols[i], ms=5)
    for a, t in zip([ax[1], ax[2]],
                    [f"density profiles  $\\chi^2$={chi2_prof:.1f} / {kprof} pts",
                     "enclosed-mass profiles"]):
        a.set_xlabel("r/R [surface at $\\rho/\\rho_c=10^{-4}$]"); a.set_ylim(-0.05, 1.05)
        a.legend(fontsize=8); a.set_title(t)
    ax[2].axhline(1.0, color="gray", lw=0.6, ls=":")
    plt.tight_layout(); plt.savefig(path, dpi=150); plt.close(fig)

