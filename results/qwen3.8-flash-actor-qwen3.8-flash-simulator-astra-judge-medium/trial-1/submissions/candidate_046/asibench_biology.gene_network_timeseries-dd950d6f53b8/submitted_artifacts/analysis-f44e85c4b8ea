#!/usr/bin/env python3
"""
Directed gene-regulatory network inference from (5,50,25) time-courses + (16,25) perturbation steady states.

CONVENTION: inferred_network[i, j] = strength of gene j's influence on gene i  ([target, source]).
  -> in-degree  of gene i = row sum of the nonzero topology
  -> out-degree of gene i = column sum of the nonzero topology
  -> all regressions are formulated as  target_i ~ predictors_j, so coefficient rows are targets.

Three independent approaches + fusion:
  A) Time-course dynamic regression (directed, temporal direction):
     A1 lasso on d x_i/dt ~ x(t) (SG-smoothed finite differences, transient window, stacked replicates)
     A2 ridge discrete propagator x(t+1) ~ x(t), Phi = (A-I)/dt
  B) Perturbation steady-state deconvolution (directed but indirect; linear response):
     D = SS - baseline ~ P @ M with sparse amplitudes P (targets) and signature matrix M (=-J^-1 columns);
     J estimates: ridge inverse of M, and row-wise sparse solve D @ J_i = -p_i.
  C) Undirected baseline: sparse partial correlation (graphical-model neighborhood selection,
     graphical-lasso family, own coordinate-descent implementation); topological support only.

Fusion: edge support requires Method A (temporal direction arbiter) + at least one of B/C;
weights = 0.5/0.3/0.2 blend of normalized scores; density target 10-15% (hard guard 5-40%);
signs taken on the FINAL thresholded topology (vote A vs B where both support; sign 0 if comparable
magnitudes disagree). network_metrics.json is computed from the exact written topology.

Only numpy/scipy required (sklearn/matplotlib are absent in this environment).
"""
import json
import numpy as np
from pathlib import Path
from scipy.signal import savgol_filter

HERE = Path(__file__).resolve().parent
DATA = HERE / "data"
OUT = HERE

DT = 0.612245
TMAX = 16
LAM_A1 = 0.5
LAM_C = 0.10
LAM_M = LAM_P = LAM_JROW = 0.5
LAM_JINV = 0.05
N_BOOT_A, N_BOOT_B = 40, 24
K_A, K_B, K_C = 150, 120, 150
DENS_LO, DENS_HI = 0.05, 0.40
SEED = 7

def lasso_cd(X, y, lam, iters=800, tol=1e-10):
    """min .5||y-Xw||^2 + lam||w||_1 by cyclic coordinate descent."""
    n, p = X.shape
    w = np.zeros(p)
    col2 = (X * X).sum(0) + 1e-12
    r = y - X @ w
    for _ in range(iters):
        mx = 0.0
        for j in range(p):
            wj = w[j]
            rho = X[:, j] @ r + col2[j] * wj
            w[j] = np.sign(rho) * max(abs(rho) - lam, 0.0) / col2[j]
            d = w[j] - wj
            if d:
                r -= X[:, j] * d
                mx = max(mx, abs(d))
        if mx < tol:
            break
    return w

def ridge_fit(X, y, lam):
    return np.linalg.solve(X.T @ X + lam * np.eye(X.shape[1]), X.T @ y)

def top_mask(M, K):
    off = np.array(M, float, copy=True)
    np.fill_diagonal(off, -np.inf)
    idx = np.argsort(-off.ravel())[:K]
    m = np.zeros(M.size, bool)
    m[idx] = True
    return m.reshape(M.shape)

def norm_off(M):
    M = np.array(M, float, copy=True)
    np.fill_diagonal(M, 0.0)
    return M / max(np.abs(M).max(), 1e-12)

def pagerank(Bin, d=0.85, iters=500):
    """Authority-like PageRank on regulator->target flow: node j scores high when the genes it
    regulates are themselves important (power iteration on the transposed binary adjacency)."""
    A = Bin.T.copy()
    n = A.shape[0]
    out = A.sum(1)
    P = np.where(out[:, None] > 0, A / np.maximum(out[:, None], 1), 1.0 / n)
    r = np.full(n, 1.0 / n)
    for _ in range(iters):
        r2 = (1 - d) / n + d * (P.T @ r)
        if np.abs(r2 - r).max() < 1e-12:
            r = r2
            break
        r = r2
    return r

ts = np.load(DATA / "expression_timeseries.npy")
ss = np.load(DATA / "perturbation_steady_states.npy")
S, T, G = ts.shape
base = ss[0].copy()
D = ss - base
N = ss.shape[0]

plateau = ts[:, 25:, :]
d2 = plateau[:, 2:, :] - 2 * plateau[:, 1:-1, :] + plateau[:, :-2, :]
sig_ts = np.maximum(d2.std(axis=(0, 1)) / np.sqrt(6.0), 1e-3)
SIG = float(np.median(sig_ts))

# ============================== METHOD A
xs = savgol_filter(ts, 5, 2, axis=1)
P_all = xs[:, :TMAX - 1, :].reshape(-1, G)
Y_all = (xs[:, 1:TMAX, :] - xs[:, :TMAX - 1, :]).reshape(-1, G) / DT
mu, sd = P_all.mean(0), P_all.std(0) + 1e-12
muY, sdY = Y_all.mean(0), Y_all.std(0) + 1e-12
grp = np.repeat(np.arange(S), TMAX - 1)
Pz, Yz = (P_all - mu) / sd, (Y_all - muY) / sdY

def fit_A1(Pz_, Yz_):
    W = np.zeros((G, G))
    for g in range(G):
        W[g] = lasso_cd(Pz_, Yz_[:, g], LAM_A1)
    np.fill_diagonal(W, 0.0)
    return W

WA1 = fit_A1(Pz, Yz)
J_A1 = WA1 * sdY[:, None] / sd[None, :]

Xn = (xs[:, 1:TMAX, :] - mu).reshape(-1, G)
sdN = Xn.std(0) + 1e-12
Mprop = np.zeros((G, G))
for g in range(G):
    Mprop[g] = ridge_fit(Pz, Xn[:, g] / sdN[g], 1.0)     # standardized both sides, ridge lam=1
Phi = (Mprop * sdN[:, None] / sd[None, :] - np.eye(G)) / DT   # A[i,j]=coef*sdN_i/sd_j ; Phi=(A-I)/dt
np.fill_diagonal(Phi, 0.0)

sA = 0.5 * (norm_off(np.abs(J_A1)) + norm_off(np.abs(Phi)))
rng = np.random.default_rng(SEED)
stabA = np.zeros((G, G))
for b in range(N_BOOT_A):
    sel = rng.integers(0, S, S)
    x = xs[sel]
    P = x[:, :TMAX - 1, :].reshape(-1, G)
    Y = (x[:, 1:TMAX, :] - x[:, :TMAX - 1, :]).reshape(-1, G) / DT
    stabA += top_mask(np.abs(fit_A1((P - mu) / sd, (Y - muY) / sdY)), 100)
stabA /= N_BOOT_A
scoreA = sA * (0.5 + 0.5 * stabA)

r2_gene = np.zeros((S, G))
seg = {"early_t0_7": [0.0, 0.0], "mid_t8_15": [0.0, 0.0], "late_t16_49_extrap": [0.0, 0.0]}
for s in range(S):
    tr, te = grp != s, grp == s
    tt = np.tile(np.arange(TMAX - 1), S)[te]
    ws = {g: lasso_cd(Pz[tr], Yz[tr, g], LAM_A1) for g in range(G)}
    for g in range(G):
        pred, yy = Pz[te] @ ws[g], Yz[te, g]
        r2_gene[s, g] = 1 - ((yy - pred) ** 2).sum() / max(((yy - yy.mean()) ** 2).sum(), 1e-12)
        for label, m in (("early_t0_7", tt < 8), ("mid_t8_15", tt >= 8)):
            seg[label][0] += ((yy[m] - pred[m]) ** 2).sum()
            seg[label][1] += ((yy[m] - yy[m].mean()) ** 2).sum() + 1e-12
    # plateau check (t>=TMAX): d x/dt is pure measurement noise there, so predictive R2 is
    # meaningless; report instead the fraction of plateau variance explained around the mean (=0 signal).
    xhs = savgol_filter(ts[s], 5, 2)
    Ye = (xhs[TMAX:T, :] - xhs[TMAX - 1:T - 1, :]) / DT
    for g in range(G):
        yy = Ye[:, g]
        seg["late_t16_49_extrap"][0] += ((yy - yy.mean()) ** 2).sum()          # = total variance (noise floor)
        seg["late_t16_49_extrap"][1] += ((yy - yy.mean()) ** 2).sum() + 1e-12  # -> R2 ~ 0 by construction
A_r2_mean = float(r2_gene.mean())
A_seg_r2 = {k: float(1 - v[0] / v[1]) for k, v in seg.items()}
A_r2_gene = {int(g): float(r2_gene[:, g].mean()) for g in range(G)}

# ============================== METHOD B
def fit_M(Pm, Dm, lam=LAM_M):
    Mt = np.zeros((G, G))   # Mt[k,i] = response of gene i to unit perturbation of gene k
    act = np.where(np.abs(Pm).sum(0) > 0)[0]
    if len(act) == 0:
        return Mt
    for i in range(G):
        Mt[act, i] = lasso_cd(Pm[:, act], Dm[:, i], lam)
    return Mt

def est_P(Mt, row, lam=LAM_P, kmax=6):
    w = lasso_cd(Mt.T, row, lam)
    idx = np.argsort(-np.abs(w))[:kmax]
    keep = [j for j in idx if abs(w[j]) > 1e-6]
    p = np.zeros(G)
    if keep:
        p[keep] = np.linalg.lstsq(Mt.T[:, keep], row, rcond=None)[0]
    return p

def deconvolve(P_init, Dm, iters=4):
    P = P_init.copy()
    Mt = fit_M(P, Dm)
    for _ in range(iters):
        for r in range(1, Dm.shape[0]):
            if np.abs(Dm[r]).max() > 3 * SIG:
                P[r] = est_P(Mt, Dm[r])
        Mt = fit_M(P, Dm)
    return P, Mt

def heuristic_P(Dm, bas):
    P = np.zeros((Dm.shape[0], G))
    for r in range(1, Dm.shape[0]):
        final = bas + Dm[r]
        for k in range(G):
            if bas[k] > 0.3 and abs(final[k]) < 0.08 * bas[k]:
                P[r, k] = -bas[k]
            elif bas[k] > 0.05 and Dm[r, k] > 1.0 and final[k] > 2.5 * bas[k]:
                P[r, k] = Dm[r, k]
    return P

P_init = heuristic_P(D, base)
P_fin, Mt = deconvolve(P_init, D)
M = Mt.T
J_B1 = -np.linalg.solve(M.T @ M + LAM_JINV * np.eye(G), M.T)
np.fill_diagonal(J_B1, 0.0)
J_B2 = np.zeros((G, G))
for i in range(G):
    J_B2[i] = lasso_cd(D, -P_fin[:, i], LAM_JROW)
np.fill_diagonal(J_B2, 0.0)
sB = 0.5 * (norm_off(np.abs(J_B1)) + norm_off(np.abs(J_B2)))
JB_ens = np.sign(J_B1) * sB

stabB = np.zeros((G, G))
conds = list(range(1, N))
for b in range(N_BOOT_B):
    idx = list(rng.choice(conds, size=len(conds), replace=True))
    Dm = np.zeros_like(D)
    Dm[1:] = D[idx]
    Pb, Mtb = deconvolve(heuristic_P(Dm, base), Dm, iters=2)
    Mb = Mtb.T
    Jb = -np.linalg.solve(Mb.T @ Mb + LAM_JINV * np.eye(G), Mb.T)
    Jb2 = np.zeros((G, G))
    for i in range(G):
        Jb2[i] = lasso_cd(Dm, -Pb[:, i], LAM_JROW)
    stabB += top_mask(0.5 * (norm_off(np.abs(Jb)) + norm_off(np.abs(Jb2))), 100)
stabB /= N_BOOT_B
scoreB = sB * (0.5 + 0.5 * stabB)

loco_r2 = {}
for r in range(1, N):
    Dm = D.copy()
    Dm[r] = 0.0
    Pm, Mtm = deconvolve(heuristic_P(Dm, base), Dm, iters=2)
    p_hat = est_P(Mtm, D[r], lam=0.5)   # only accessible info: fit <=6 sparse amplitudes of held-out condition
    pred = p_hat @ Mtm
    yy = D[r]
    loco_r2[r] = float(1 - ((yy - pred) ** 2).sum() / max(float(((yy - yy.mean()) ** 2).sum()), 1e-12))
B_loco_mean = float(np.mean(list(loco_r2.values())))
target_summary = {int(r): [int(k) for k in np.where(np.abs(P_fin[r]) > 1.0)[0]] for r in range(1, N)}
print("method B done; LOCO R2 =", round(B_loco_mean, 3))

# ============================== METHOD C
twin = 20
xd = savgol_filter(ts, 7, 2, axis=1) - base
samp = xd[:, :twin, :].reshape(-1, G)
samp = samp / (samp.std(0) + 1e-12)
Cmat = np.corrcoef(samp.T)
BETA = np.zeros((G, G))
for j in range(G):
    idx = [k for k in range(G) if k != j]
    BETA[j, idx] = lasso_cd(Cmat[np.ix_(idx, idx)], Cmat[j, idx], LAM_C)
sC_raw = (np.abs(BETA) + np.abs(BETA).T) / 2.0
np.fill_diagonal(sC_raw, 0.0)
sC = norm_off(sC_raw)

r2_cond = []
for j in range(G):
    idx = [k for k in range(G) if k != j]
    Xf = xd[:, :twin, :].reshape(-1, G)[:, idx]
    Xf = Xf / (Xf.std(0) + 1e-12)
    yv = xd[:, :twin, j].reshape(-1)
    yv = yv / (yv.std() + 1e-12)
    gv = np.repeat(np.arange(S), twin)
    num = den = 0.0
    for s in range(S):
        tr, te = gv != s, gv == s
        b = lasso_cd(Xf[tr], yv[tr], LAM_C)
        num += ((yv[te] - Xf[te] @ b) ** 2).sum()
        den += ((yv[te] - yv[te].mean()) ** 2).sum() + 1e-12
    r2_cond.append(1 - num / den)
C_r2_mean = float(np.mean(r2_cond))
print("method C done; nodewise heldout R2 =", round(C_r2_mean, 3))

# ============================== FUSION
mA = top_mask(scoreA, K_A)
mB = top_mask(scoreB, K_B)
mC = top_mask(sC, K_C)
cand = mA & (mB | mC)                       # direction arbiter = A; support from >= 2 methods
fused = 0.5 * sA + 0.3 * sB + 0.2 * sC
fused_masked = np.where(cand, fused, -np.inf)
np.fill_diagonal(fused_masked, -np.inf)
n_c = int(cand.sum())
assert n_c >= 30, "fusion support too sparse"
K_final = min(n_c, 90)                       # target 60-90 edges (~10-15%)
order = np.argsort(-fused_masked.ravel())
sel = np.zeros(G * G, bool)
sel[order[:K_final]] = True
W = sel.reshape(G, G)

Wmat = np.where(W, fused, 0.0)
Wmat = Wmat / max(Wmat.max(), 1e-12)
sign_mat = np.zeros((G, G))
n_disagree_zero = n_disagree_dom = 0
for i, j in zip(*np.where(W)):
    sa = np.sign(J_A1[i, j]) if J_A1[i, j] != 0 else np.sign(Phi[i, j])
    sb = np.sign(JB_ens[i, j])
    if mB[i, j] and sa != 0 and sb != 0:
        if sa == sb:
            sign_mat[i, j] = sa
        else:
            a_, b_ = sA[i, j], sB[i, j]
            if 0.5 <= a_ / max(b_, 1e-12) <= 2.0:
                sign_mat[i, j] = 0.0             # comparable magnitudes: uncertain sign
                Wmat[i, j] *= 0.5
                n_disagree_zero += 1
            else:
                sign_mat[i, j] = sa if a_ > b_ else sb
                Wmat[i, j] *= 0.85
                n_disagree_dom += 1
    else:
        sign_mat[i, j] = sa                       # temporal evidence alone
np.fill_diagonal(Wmat, 0.0)
sign_mat = np.where(Wmat != 0, sign_mat, 0.0)

# ============================== HUBS & METRICS
out_strength = Wmat.sum(axis=0)                   # source gene j -> column sum
in_strength = Wmat.sum(axis=1)                    # target gene i -> row sum
Bin = (Wmat != 0).astype(float)
pr = pagerank(Bin)
hub_by_out = [int(x) for x in np.argsort(-out_strength)[:2]]
hub_by_pr = [int(x) for x in np.argsort(-pr)[:2]]

offdiag_nz = int((Wmat != 0).sum())
density = offdiag_nz / float(G * (G - 1))
assert DENS_LO <= density <= DENS_HI, f"density {density} out of bounds"
deg_in, deg_out = Bin.sum(1), Bin.sum(0)
metrics = {
    "n_genes": G,
    "n_edges": offdiag_nz,
    "density": density,
    "density_definition": "nonzero off-diagonal / (25*24); diagonal exactly 0",
    "mean_in_degree": float(deg_in.mean()), "max_in_degree": int(deg_in.max()),
    "mean_out_degree": float(deg_out.mean()), "max_out_degree": int(deg_out.max()),
    "mean_in_strength": float(in_strength.mean()), "max_in_strength": float(in_strength.max()),
    "mean_out_strength": float(out_strength.mean()), "max_out_strength": float(out_strength.max()),
    "top_out_degree_genes": [int(x) for x in np.argsort(-deg_out)[:5]],
    "top_in_degree_genes": [int(x) for x in np.argsort(-deg_in)[:5]],
    "convention": "[target, source]: in-degree = row sum, out-degree = column sum; "
                  "computed from the exact written nonzero topology of inferred_network.npy",
}

# ============================== SYNTHETIC CALIBRATION (internal evidence)
def synthetic_calibration():
    """Precision/sign sanity check on simulated systems with matched characteristics
    (same shapes/noise/sampling; linear and Hill-nonlinear modes)."""
    def run(seed, hill):
        r = np.random.default_rng(seed)
        Wt = np.zeros((G, G))
        for i in range(G):
            for _ in range(3):
                j = int(r.integers(G))
                if j != i:
                    Wt[i, j] = r.choice([-1, 1]) * r.uniform(0.1, 0.5)
        Kg = np.exp(r.uniform(np.log(0.5), np.log(15), G))
        xst = np.exp(r.uniform(np.log(0.5), np.log(15), G))
        dg = np.random.default_rng(seed + 99).uniform(0.18, 0.33, G)
        while np.max(np.real(np.linalg.eigvals(Wt - np.diag(dg)))) > -0.05:
            dg *= 1.05
        def sense(x):
            a = x[None, :] / (x[None, :] + Kg[None, :])
            return np.where(Wt > 0, a, 1 - a)
        if hill:
            b = dg * xst - (Wt * sense(xst)).sum(1)
            f = lambda x: (Wt * sense(x)).sum(1) + b - dg * x
        else:
            b = dg * xst - Wt @ xst
            f = lambda x: Wt @ x + b - dg * x
        tsx = np.zeros((S, T, G))
        for s in range(S):
            x = xst * r.uniform(0.15, 0.35, G)
            traj = [x.copy()]
            for _ in range(T - 1):
                x = np.clip(x + DT * f(x), 0, None)
                traj.append(x.copy())
            tsx[s] = traj
        tsx += r.normal(0, SIG, tsx.shape)
        ssx = np.zeros((16, G))
        ssx[0] = xst + r.normal(0, SIG, G)
        for ci in range(15):
            x = xst.copy()
            mods = []
            for _ in range([1, 1, 2, 2, 3][ci % 5]):
                k = int(r.integers(G))
                mods.append((k, "ko", None) if r.random() < 0.7 else (k, "oe", float(xst[k] * r.uniform(2, 8))))
            for _ in range(3000):
                x = np.clip(x + 0.05 * f(x), 0, None)
                for k, kind, val in mods:
                    x[k] = 0.0 if kind == "ko" else val
            ssx[ci + 1] = x + r.normal(0, SIG, G)
        xss = savgol_filter(tsx, 5, 2, axis=1)
        Pp = xss[:, :TMAX - 1, :].reshape(-1, G)
        Yy = (xss[:, 1:TMAX, :] - xss[:, :TMAX - 1, :]).reshape(-1, G) / DT
        m_, s_ = Pp.mean(0), Pp.std(0) + 1e-12
        my_, sy_ = Yy.mean(0), Yy.std(0) + 1e-12
        Wa = fit_A1((Pp - m_) / s_, (Yy - my_) / sy_)
        Dx = ssx - ssx[0]
        Pi = np.zeros((16, G))
        for rr in range(1, 16):
            fin = ssx[0] + Dx[rr]
            for k in range(G):
                if ssx[0][k] > 0.3 and abs(fin[k]) < 0.08 * ssx[0][k]:
                    Pi[rr, k] = -ssx[0][k]
                elif ssx[0][k] > 0.05 and Dx[rr, k] > 1.0 and fin[k] > 2.5 * ssx[0][k]:
                    Pi[rr, k] = Dx[rr, k]
        Pf, Mtf = deconvolve(Pi, Dx, iters=2)
        Mx = Mtf.T
        J1 = -np.linalg.solve(Mx.T @ Mx + LAM_JINV * np.eye(G), Mx.T)
        np.fill_diagonal(J1, 0.0)
        J2 = np.zeros((G, G))
        for i in range(G):
            J2[i] = lasso_cd(Dx, -Pf[:, i], LAM_JROW)
        eps = 1e-6
        Jl = np.zeros((G, G))
        f0 = f(xst)
        for j in range(G):
            xp = xst.copy()
            xp[j] += eps
            Jl[:, j] = (f(xp) - f0) / eps
        tm = np.abs(Jl) > 1e-9
        np.fill_diagonal(tm, False)
        tsign = np.sign(Jl)
        def prec(M):
            m = top_mask(np.abs(M), 90)
            return float(tm[m].mean()), float((np.sign(M)[m] == tsign[m]).mean())
        pA, sAq = prec(Wa)
        pB, sBq = prec(J1)
        return {"mode": "hill" if hill else "linear",
                "A_top90_precision": round(pA, 2), "A_top90_sign_acc": round(sAq, 2),
                "B_top90_precision": round(pB, 2), "B_top90_sign_acc": round(sBq, 2)}
    try:
        return [run(SEED, False), run(SEED, True)]
    except Exception as e:
        return [{"error": str(e)}]

calib = synthetic_calibration()
print("calibration:", calib)

# ============================== WRITE ARTIFACTS
Wfinal = np.ascontiguousarray(Wmat, dtype=np.float64)
Sfinal = np.ascontiguousarray(sign_mat, dtype=np.float64)
assert Wfinal.shape == (25, 25) and Sfinal.shape == (25, 25)
assert np.isfinite(Wfinal).all() and np.isfinite(Sfinal).all()
assert np.all(np.diag(Wfinal) == 0.0) and np.all(np.diag(Sfinal) == 0.0)
assert set(np.unique(Sfinal)) <= {-1.0, 0.0, 1.0}
assert not np.any((Wfinal == 0) & (Sfinal != 0))

np.save(OUT / "inferred_network.npy", Wfinal)
np.save(OUT / "edge_sign_predictions.npy", Sfinal)

n_pos = int((Sfinal == 1).sum())
n_neg = int((Sfinal == -1).sum())
n_unk = int(((Sfinal == 0) & (Wfinal != 0)).sum())
with open(OUT / "hub_genes.json", "w") as fh:
    json.dump({"hub_genes": hub_by_out,
               "criterion": "out-strength = column sums of |inferred_network| on the final topology "
                            "([target,source]: out-degree/strength of regulator j = sum_i W[i,j]); "
                            "PageRank (authority flow) as robustness check",
               "out_strength_top5": {int(i): round(float(out_strength[i]), 4) for i in np.argsort(-out_strength)[:5]},
