#!/usr/bin/env python3
"""Single-cell RNA-seq integrated analysis (NumPy/SciPy only).

Pipeline (approved plan):
  QC -> library-size normalisation + log1p -> HVG selection -> PCA (SVD) denoising
  -> symmetric k-NN graph (cKDTree + scipy.sparse) -> spectral clustering (k=4,
  normalised-Laplacian eigenvectors + own Lloyd k-means) -> pseudotime (double-sweep
  root + weighted graph geodesics, canonical sign rule) -> DE marker ranking
  -> directed TFxTF GRN scores (bootstrap multivariate ridge magnitude +
  LiNGAM-style global causal order + pseudotime lead-lag asymmetric orientation).

Outputs: clusters.npy, pseudotime.npy, de_genes.json, grn_scores.npy,
method_choices.json.  Deterministic: fixed seed everywhere.
"""
import json
import os
import time
import numpy as np
from scipy.sparse import csr_matrix, identity
from scipy.spatial import cKDTree
from scipy.sparse.csgraph import connected_components, shortest_path

SEED = 0
RNG = np.random.default_rng(SEED)
HERE = os.path.dirname(os.path.abspath(__file__))
# work dir = the directory that actually contains data/ (cwd first, then script dir)
BASE = os.getcwd() if os.path.isdir(os.path.join(os.getcwd(), "data")) else HERE
OUT = BASE
DATA = os.path.join(BASE, "data")
DIAG = {}


def log(msg):
