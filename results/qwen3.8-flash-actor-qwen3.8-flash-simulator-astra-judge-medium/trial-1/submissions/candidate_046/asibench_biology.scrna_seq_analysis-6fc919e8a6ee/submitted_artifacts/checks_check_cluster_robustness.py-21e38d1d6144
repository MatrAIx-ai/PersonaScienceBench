# hyper-parameter sensitivity of the clustering
def spec(A,k,knn,seed=0):
    N=A.shape[0]; t=cKDTree(A); d,i=t.query(A,k=knn+1); d,i=d[:,1:],i[:,1:]
    s2=float(np.median(d**2)) or 1.0
    W=csr_matrix((np.exp(-(d.ravel()**2)/(2*s2)),(np.repeat(np.arange(N),knn),i.ravel())),shape=(N,N))
    W=W.maximum(W.T); deg=np.asarray(W.sum(1)).ravel()
    dinv=1/np.sqrt(np.maximum(deg,1e-12)); D=csr_matrix((dinv,(np.arange(N),np.arange(N))))
    Lap=(csr_matrix((N,N))-D@W@D).toarray(); Lap=(Lap+Lap.T)/2
    _,v=np.linalg.eigh(Lap); Y=v[:,:k]; Y/=np.maximum(np.linalg.norm(Y,axis=1,keepdims=True),1e-12)
    rng=np.random.default_rng(seed); best=None
    for _ in range(10):
        c0=np.empty((k,Y.shape[1])); c0[0]=Y[rng.integers(N)]
        for c in range(1,k):
            d2=((Y[:,None,:]-c0[None,:c,:])**2).sum(-1).min(1)
            c0[c]=Y[rng.choice(N,p=d2/max(d2.sum(),1e-12))]
        lab=np.zeros(N,int)
        for _ in range(300):
            nl=((Y[:,None,:]-c0[None,:,:])**2).sum(-1).argmin(1)
            if np.array_equal(nl,lab): break
            lab=nl
            for c in range(k):
                m=lab==c
                if m.any(): c0[c]=Y[m].mean(0)
        it=float(((Y-c0[lab])**2).sum())
        if best is None or it<best[0]: best=(it,lab.copy())
    return best[1]
def ari(a,b):
    a=np.asarray(a);b=np.asarray(b);N=len(a)
    M=np.zeros((a.max()+1,b.max()+1),int)
    for x,y in zip(a,b): M[x,y]+=1
    C2=lambda v: float((np.asarray(v)*(np.asarray(v)-1)/2).sum()); n2=N*(N-1)/2
    ai,bj=M.sum(1),M.sum(0); mij=float((M*(M-1)/2).sum())
    ex=C2(ai)*C2(bj)/n2; den=(C2(ai)+C2(bj))/2-ex
    return float((mij-ex)/den) if abs(den)>1e-12 else 1.0
