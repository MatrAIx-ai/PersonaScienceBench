# ---------------------------------------------------------------------------
# Geometry helpers (pure python/numpy; no OpenMM)
# ---------------------------------------------------------------------------
def wrap180(a):
    return (np.asarray(a, float) + 180.0) % 360.0 - 180.0


def dihedral_deg(p0, p1, p2, p3):
    b0 = np.asarray(p0, float) - np.asarray(p1, float)
    b1 = np.asarray(p2, float) - np.asarray(p1, float)
    b2 = np.asarray(p3, float) - np.asarray(p2, float)
    b1 = b1 / np.linalg.norm(b1)
    v = b0 - np.dot(b0, b1) * b1
    w = b2 - np.dot(b2, b1) * b1
    return float(np.degrees(np.arctan2(np.dot(np.cross(b1, v), w), np.dot(v, w))))


def rotate_about_axis(points, origin, axis, angle_rad):
    """Rodrigues rotation of (N,3) array about axis through origin."""
    p = np.asarray(points, float) - np.asarray(origin, float)
    k = np.asarray(axis, float)
    k = k / np.linalg.norm(k)
    c, s = math.cos(angle_rad), math.sin(angle_rad)
    kp = np.cross(k, p)
    d = np.dot(p, k)[:, None] * k
    rot = p * c + kp * s + d * 1.0 - d * c
    return rot + np.asarray(origin, float)


# ---------------------------------------------------------------------------
# Periodic bias grid (pure numpy): single source of truth for the bias
# ---------------------------------------------------------------------------
class BiasGrid:
    """Periodic 2D grid, node j <-> angle -180 + j*dg degrees, both dims."""

    def __init__(self, n=BIAS_N, dg=BIAS_DG):
        self.n, self.dg = n, dg
        self.data = np.zeros((n, n), dtype=np.float64)
        idx = np.arange(n)
        off = idx - idx[:, None]                      # node offsets (cells)
        off = off - n * np.round(off / n)             # minimal image
        self._kern = np.exp(-0.5 * (off * dg / SIGMA_DEG) ** 2)  # amp 1 at 0

    def _node(self, a):
        return int(round((float(a) + 180.0) / self.dg)) % self.n

    def deposit(self, s, h):
        """Add h * G(phi-phi_k)G(psi-psi_k); unit amplitude at placed node."""
        kx = self._kern[self._node(s[0])]
        ky = self._kern[self._node(s[1])]
        self.data += h * np.outer(ky, kx)

    def at(self, s):
        """Bilinear interpolation at s=(phi,psi) deg (periodic)."""
        n, dg = self.n, self.dg
        f = (np.asarray(s, float) + 180.0) / dg
        i = np.floor(f).astype(int)
        w = f - i
        i0, i1 = i % n, (i + 1) % n
        d = self.data
        return float(
            (1 - w[1]) * ((1 - w[0]) * d[i0[1], i0[0]] + w[0] * d[i0[1], i1[0]])
            + w[1] * ((1 - w[0]) * d[i1[1], i0[0]] + w[0] * d[i1[1], i1[0]]))

    def flattened_omm(self):
        """Flatten for OpenMM Discrete2DFunction: periodic dims map CV values
        modulo 2*pi onto [0, 360) deg, i.e. OpenMM node j <-> angle j*dg."""
        half = self.n // 2
        return np.roll(np.roll(self.data, half, axis=0),
                       half, axis=1).ravel(order="C")

    def copy(self):
        g = BiasGrid(self.n, self.dg)
        g.data = self.data.copy()
        return g


def evaluate_on_fes_grid(grid):
    """Bilinear resample of the periodic BiasGrid onto the 72x72
    cell-centered grid. Returns fes[i,j], i=phi cell, j=psi cell."""
    f = (CELL_CENTERS + 180.0) / grid.dg
    i0 = np.floor(f).astype(int) % grid.n
    i1 = (i0 + 1) % grid.n
    w = f - np.floor(f)
    d = grid.data
    # rows = psi (index i), cols = phi (index j) -> transpose at the end
    out = ((1 - w[:, None]) * ((1 - w[None, :]) * d[i0[:, None], i0[None, :]] +
                               w[None, :] * d[i0[:, None], i1[None, :]]) +
           w[:, None] * ((1 - w[None, :]) * d[i1[:, None], i0[None, :]] +
                         w[None, :] * d[i1[:, None], i1[None, :]]))
    return out.T


def reconstruct_fes(dep_s, dep_h):
    """F(s) = -lambda/(lambda-1) * sum_k h_k G(s-s_k) on the 72x72 grid,
    kJ/mol, global minimum shifted to exactly 0.0, negatives clipped."""
    g = BiasGrid()
    for s, h in zip(dep_s, dep_h):
        g.deposit(s, h)
    F = -(BIAS_FACTOR / (BIAS_FACTOR - 1.0)) * evaluate_on_fes_grid(g)
    F -= F.min()
    F[F < 0.0] = 0.0
    return np.ascontiguousarray(F, dtype=np.float64), g


def visit_counts(traj_s):
    """72x72 histogram of recorded CV visits (phi cell, psi cell)."""
    idx = np.floor((np.asarray(traj_s, float) + 180.0) / CELL).astype(int)
    idx %= N_CELLS
    h = np.zeros((N_CELLS, N_CELLS), dtype=np.int64)
    np.add.at(h, (idx[:, 0], idx[:, 1]), 1)
    return h


# ---------------------------------------------------------------------------
# Minima detection (periodic-aware)
# ---------------------------------------------------------------------------
def _path_saddle(Fsm, a, b, nsteps=101):
    """Max of Fsm along the shortest periodic geodesic between CV points."""
    dphi = wrap180(np.asarray(b[0]) - np.asarray(a[0]))
    dpsi = wrap180(np.asarray(b[1]) - np.asarray(a[1]))
    ts = np.linspace(0.0, 1.0, nsteps)
    xs = ((wrap180(a[0] + ts * dphi) + 180.0) // CELL).astype(int) % N_CELLS
    ys = ((wrap180(a[1] + ts * dpsi) + 180.0) // CELL).astype(int) % N_CELLS
    return float(np.max(Fsm[xs, ys]))


def _periodic_sep_deg(a, b):
    return math.hypot(float(wrap180(a[0] - b[0])), float(wrap180(a[1] - b[1])))


def classify_region(phi, psi):
    p, y = float(wrap180(phi)), float(wrap180(psi))
    if -150 <= p <= -20 and -120 <= y <= 10:
        return "alpha_R"
    if -180 <= p <= -30 and (90 <= y <= 180 or -180 <= y <= -150):
        return "beta"
    if 0 <= p <= 130 and -40 <= y <= 100:
        return "alpha_L"
    if p > 0 and y < -40:
        return "bridge_down"
    return "state"


def find_minima(F, counts, dep_s):
    """Local minima of the periodic FES: 5-deg smoothing, 3x3 minimum filter
    with wrap, merge closer than MIN_SEP_DEG or with connecting saddle below
    BARRIER_FUSE_KJ, require deposition count >= MIN_VISIT_COUNT."""
    from scipy import ndimage
    Fsm = ndimage.gaussian_filter(F, sigma=SMOOTH_SIGMA_CELLS, mode="wrap")
    mn = ndimage.minimum_filter(Fsm, size=3, mode="wrap")
    cand = np.argwhere(Fsm <= mn + 1e-12)
    cands = sorted(((float(Fsm[i, j]), int(i), int(j)) for i, j in cand))

    kept = []  # entries: [Fval, i, j, (phi,psi)]
    gmin_cell = tuple(np.unravel_index(F.argmin(), F.shape))
    # the global-minimum basin is ALWAYS reported (dG = 0.0 by definition)
    kept.append([float(Fsm[gmin_cell]), gmin_cell[0], gmin_cell[1],
                 (float(CELL_CENTERS[gmin_cell[0]]),
                  float(CELL_CENTERS[gmin_cell[1]]))])
    for fv, i, j in cands:
        c = (float(CELL_CENTERS[i]), float(CELL_CENTERS[j]))
        if (i, j) != gmin_cell and counts[i, j] == 0:
            continue
        merged = False
        for k in range(len(kept)):
            kv, ki, kj, kc = kept[k]
            sep = _periodic_sep_deg(c, kc)
            if sep < MIN_SEP_DEG:
                merged = True                      # keep first (lowest) one
                break
            if sep < 3.0 * MIN_SEP_DEG:
                saddle = _path_saddle(Fsm, c, kc)
                if saddle - max(fv, kv) < BARRIER_FUSE_KJ:
                    if fv < kv:
                        kept[k] = [fv, i, j, c]
                    merged = True
                    break
        if not merged:
            kept.append([fv, i, j, c])
        if len(kept) > 300:
            break

    dep = np.asarray(dep_s, float)
    final = []
    for fv, i, j, c in kept:
        d = np.hypot(wrap180(dep[:, 0] - c[0]), wrap180(dep[:, 1] - c[1]))
        cnt = int((d <= VISIT_RADIUS_DEG).sum())
        if cnt >= MIN_VISIT_COUNT or (i, j) == gmin_cell:
            final.append({"phi": c[0], "psi": c[1], "cell": (i, j),
                          "count": cnt})
    for m in final:
        m["dG"] = float(F[m["cell"]])
    final.sort(key=lambda m: m["dG"])
    final = final[:MAX_MINIMA]

    used = set()
    for m in final:
        base = classify_region(m["phi"], m["psi"])
        name, k = base, 2
        while name in used:
            name, k = f"{base}{k}", k + 1
        used.add(name)
        m["name"] = name
    return final


