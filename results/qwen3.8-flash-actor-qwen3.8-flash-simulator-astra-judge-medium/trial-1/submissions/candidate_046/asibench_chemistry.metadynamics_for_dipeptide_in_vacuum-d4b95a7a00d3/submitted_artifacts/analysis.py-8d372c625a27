on both CVs, deposition every {DEPOSIT_PS} ps, Langevin 1/ps, NoCutoff,
ff14SB (amber14-all.xml), vacuum. The initial structure in the PDB is an
idealized planar build with the peptide bond in the CIS (omega = 0) geometry;
for production the NME fragment was rotated about the C-N bond to trans
(omega = 180) and minimized; omega is left unbiased during the simulation.
The FES was reconstructed by this script from the recorded deposition history
as F(s) = -[lambda/(lambda-1)] V(s, t_end) with V = sum_k h_k G(s - s_k);
no built-in free-energy retrieval or internal bias arrays were used.
{extra}"""


def _viridis_lut(n=256):
    pts = [(0.267, 0.005, 0.329), (0.283, 0.141, 0.458),
           (0.254, 0.265, 0.530), (0.207, 0.372, 0.553),
           (0.164, 0.471, 0.558), (0.128, 0.567, 0.551),
           (0.212, 0.729, 0.474), (0.741, 0.873, 0.150),
           (0.993, 0.906, 0.144)]
    lut = []
    for k in range(n):
        t = k / (n - 1.0) * (len(pts) - 1)
        i = min(int(t), len(pts) - 2)
        f = t - i
        lut.append(tuple(int(255 * (pts[i][c] + f * (pts[i + 1][c]
                                                      - pts[i][c])))
                         for c in range(3)))
    return lut


def _png_fallback(F, path, synthetic, minima=None):
    """Pure-python PNG heatmap (used only when matplotlib is missing):
    heatmap + 45-deg gridlines + vertical colorbar with ticks + red '+'
    markers at the reported minima. When synthetic, a solid red banner
    across the top flags the figure as a SELF-TEST placeholder."""
    import struct
    import zlib
    F = np.asarray(F, float)
    lo, hi = float(F.min()), float(F.max())
    norm = (F - lo) / ((hi - lo) or 1.0)
    lut = _viridis_lut()
    scale = 8
    plot = N_CELLS * scale                      # 576 px
    ml, mt, mr, mb = 48, 48, 128, 48
    w, h = ml + plot + mr, mt + plot + mb
    img = [[(240, 240, 240)] * w for _ in range(h)]
    red = (220, 20, 20)
    black = (30, 30, 30)

    # heatmap: x = phi (cols), y = psi (rows, origin lower)
    for py in range(plot):
        j = N_CELLS - 1 - py // scale
        rep = np.repeat(norm[:, j], scale)          # 72 -> 576 pixels
        cols = [lut[min(255, max(0, int(v * 255.0 + 0.5)))] for v in rep]
        img[mt + py][ml:ml + plot] = cols
    # gridlines every 45 deg
    for t in range(0, 361, 45):
        g = ml + int(round(t / 360.0 * plot))
        gy = mt + int(round((1.0 - t / 360.0) * plot))
        for q in range(plot):
            if g < w:
                img[mt + q][g] = (70, 70, 70)
            if gy < h:
                img[gy][ml + q] = (70, 70, 70)
    # frame
    for q in range(plot + 1):
        for x, y in ((ml + q, mt), (ml + q, mt + plot),
                     (ml, mt + q), (ml + plot, mt + q)):
            if x < w and y < h:
                img[y][x] = black
    # axis tick marks every 45 deg (no text available without matplotlib)
    for t in range(0, 361, 45):
        gx = ml + int(round(t / 360.0 * plot))
        gy = mt + int(round((1.0 - t / 360.0) * plot))
        for d in range(1, 7):
            if gx < w and mt + plot + d < h:
                img[mt + plot + d][gx] = black
            if gy < h and ml - d >= 0:
                img[gy][ml - d] = black
    # vertical colorbar (bottom = global min 0.0, top = max F), kJ/mol
    cbx0, cbx1 = ml + plot + 28, ml + plot + 56
    for y in range(plot):
        t = 1.0 - y / (plot - 1.0)
        c = lut[min(255, int(t * 255.0 + 0.5))]
        for x in range(cbx0, min(cbx1 + 1, w)):
            img[mt + y][x] = c
    for y in range(plot + 1):
        if mt + y < h:
            for x in (cbx0, cbx1):
                if x < w:
                    img[mt + y][x] = black
    for x in range(cbx0, cbx1 + 1):
        if mt <= h - 1 and cbx0 < w:
            img[mt][x] = black
            img[mt + plot][x] = black
    for frac in (0.0, 0.5, 1.0):
        yy = mt + int(round((1.0 - frac) * plot))
        for x in range(cbx1 + 1, min(cbx1 + 9, w)):
            if yy < h:
                img[yy][x] = black
    # minimum markers: red + of arm 8 px, width 2
    for m in (minima or []):
        cx = ml + int(round((m["phi"] + 180.0) / 360.0 * plot))
        cy = mt + int(round((1.0 - (m["psi"] + 180.0) / 360.0) * plot))
        for d in range(-9, 10):
            for e in (0, 1):
                if 0 <= cy + d < h and 0 <= cx + e < w:
                    img[cy + d][cx + e] = red
                if 0 <= cy + e < h and 0 <= cx + d < w:
                    img[cy + e][cx + d] = red
    # synthetic self-test banner
    if synthetic:
        for y in range(10, 20):
            for x in range(w):
                img[y][x] = red

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    raw = b"".join(b"\x00" + bytes(v for px in row for v in px) for row in img)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)
    return "fallback"


def write_fes_png(F, minima, path, synthetic):
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        fig, ax = plt.subplots(figsize=(6.4, 5.8))
        im = ax.imshow(F.T, origin="lower", extent=[-180, 180, -180, 180],
                       cmap="viridis", aspect="auto")
        for m in minima:
            ax.plot(m["phi"], m["psi"], "r+", ms=12, mew=2)
            ax.annotate(m["name"], (m["phi"], m["psi"]), color="red",
                        xytext=(6, 6), textcoords="offset points", fontsize=8)
        ax.set_xlabel("phi (degrees)")
        ax.set_ylabel("psi (degrees)")
        ax.set_xticks(range(-180, 181, 45))
        ax.set_yticks(range(-180, 181, 45))
        cbar = fig.colorbar(im, ax=ax)
        cbar.set_label("F (kJ/mol)")
        title = "Ace-Cys-Nme FES (phi, psi), 300 K, vacuum"
        if synthetic:
            title += " -- SYNTHETIC SELF-TEST (not a simulation)"
        ax.set_title(title, fontsize=9)
        fig.tight_layout()
        fig.savefig(path, dpi=200)
        plt.close(fig)
        return "matplotlib"
    except ImportError:
        return _png_fallback(F, path, synthetic, minima)


def write_all_outputs(F, minima, out_dir=OUT_DIR, synthetic=True, extra=""):
    os.makedirs(out_dir, exist_ok=True)
    write_fes_npy(F, os.path.join(out_dir, "fes_2d.npy"))
    write_minima_csv(minima, os.path.join(out_dir, "minima.csv"))
    with open(os.path.join(out_dir, "cv_definition.txt"), "w") as fh:
        fh.write(cv_text(synthetic, extra))
    engine = write_fes_png(F, minima, os.path.join(out_dir, "fes_plot.png"),
                           synthetic)
    return engine


def verify_outputs(out_dir=OUT_DIR):
    """Hard format checks demanded by the task contract."""
    rep = []
    F = np.load(os.path.join(out_dir, "fes_2d.npy"))
    assert F.shape == (72, 72), F.shape
    assert F.dtype == np.float64, F.dtype
    assert F.min() == 0.0, F.min()
    assert F.min() >= 0.0
    assert np.all(np.isfinite(F))
    rep.append(f"fes_2d.npy: shape {F.shape}, dtype {F.dtype}, "
               f"min {F.min()}, max {F.max():.2f} kJ/mol")
    with open(os.path.join(out_dir, "minima.csv")) as fh:
        rows = list(csv.reader(fh))
    assert rows[0] == ["name", "cv1", "cv2", "delta_g_kj_mol"], rows[0]
    assert 1 <= len(rows) - 1 <= MAX_MINIMA, len(rows)
    dg = [float(r[3]) for r in rows[1:]]
    assert dg == sorted(dg), dg
    for r in rows[1:]:
        for v in (float(r[1]), float(r[2])):
            assert -180.0 <= v < 180.0, v
    rep.append(f"minima.csv: {len(rows)-1} rows, dG ascending {dg}")
    with open(os.path.join(out_dir, "cv_definition.txt")) as fh:
        txt = fh.read()
    assert "phi" in txt and "psi" in txt and "periodic" in txt
    with open(os.path.join(out_dir, "fes_plot.png"), "rb") as fh:
        magic = fh.read(8)
    assert magic == b"\x89PNG\r\n\x1a\n", magic
    rep.append("fes_plot.png: valid PNG magic")
    return rep


# ---------------------------------------------------------------------------
# OpenMM production path (requires openmm>=8.0; NOT exercised by --selftest)
# ---------------------------------------------------------------------------
def require_openmm():
    try:
        import openmm
        from openmm import app, Platform, CustomCVForce, Discrete2DFunction
        return openmm, app
    except ImportError as exc:
        sys.exit("ERROR: openmm is required for production "
                 f"(`python analysis.py`); not importable here ({exc}). "
                 "Use `python analysis.py --selftest` to validate the "
                 "numerical pipeline with synthetic data.")


def pick_platform(openmm):
    names = [Platform.getPlatform(i).getName()
             for i in range(Platform.getNumPlatforms())]
    for pref in ("Reference", "CPU", "OpenCL"):
        if pref in names:
            return Platform.getPlatformByName(pref), names
    sys.exit("ERROR: no usable OpenMM platform; available: " + str(names))


def atom_index(pdb, resname, atomname):
    for i, atom in enumerate(pdb.topology.atoms()):
        if atom.residue.name == resname and atom.name == atomname:
            return i
    raise KeyError(f"{resname}.{atomname} not found")


def run_production(args):
    openmm, app = require_openmm()
    from openmm import (CustomCVForce, Discrete2DFunction, LangevinIntegrator,
                        unit)
    log_lines = []

    def log(msg):
        print(msg, flush=True)
        log_lines.append(msg)

    pdb = app.PDBFile(PDB_PATH)
    ff = app.ForceField("amber14-all.xml")           # ff14SB
    platform, names = pick_platform(openmm)
    log(f"OpenMM {openmm.version.version}; platforms={names}; "
        f"using {platform.getName()}")

    idx = {"phi": [atom_index(pdb, "ACE", "C"), atom_index(pdb, "CYS", "N"),
                   atom_index(pdb, "CYS", "CA"), atom_index(pdb, "CYS", "C")],
           "psi": [atom_index(pdb, "CYS", "N"), atom_index(pdb, "CYS", "CA"),
                   atom_index(pdb, "CYS", "C"), atom_index(pdb, "NME", "N")]}
    log(f"CV atom indices: phi={idx['phi']} psi={idx['psi']}")

    pos = np.array(pdb.positions.value_in_unit(unit.nanometer))

    # ---- omega cis -> trans preparation (documented, deterministic) ----
    iC, iN = idx["psi"][2], idx["psi"][3]
    nme = [a.index for a in pdb.topology.atoms()
           if a.residue.name == "NME"]
    omega0 = dihedral_deg(pos[idx["psi"][0]], pos[idx["psi"][2]],
                          pos[iC], pos[iN])
    if abs(abs(omega0) - 180.0) > 10.0:
        pos[nme] = rotate_about_axis(pos[nme], pos[iC], pos[iN] - pos[iC],
                                     math.radians(wrap180(180.0 - omega0)))
    log(f"omega initial {omega0:.1f} deg -> rotated NME fragment")

    def make_system(hmr):
        system = ff.createSystem(pdb.topology, nonbondedMethod=app.NoCutoff,
                                 constraints=None, rigidWater=False)
        if hmr:
            masses = np.array([
                float(getattr(system.getParticleMass(i), "_value",
                              system.getParticleMass(i)))
                for i in range(system.getNumParticles())])
            bonds = {}
            for f in range(system.getNumForces()):
                force = system.getForce(f)
                if force.__class__.__name__ == "HarmonicBondForce":
                    for b in range(force.getNumBonds()):
                        p1, p2 = force.getBondParameters(b)[:2]
                        bonds.setdefault(p1, []).append(p2)
                        bonds.setdefault(p2, []).append(p1)
            for i, m in enumerate(masses):
                if m < 1.7 and bonds.get(i):
                    j = bonds[i][0]
                    if masses[j] - (HMR_H_MASS - 1.0) > 8.0:
                        masses[i] = HMR_H_MASS
                        masses[j] -= HMR_H_MASS - 1.0
            for i, m in enumerate(masses):
                system.setParticleMass(i, m)
        cvf = CustomCVForce("V(phi,psi)")
        cvf.addCollectiveVariable("phi", openmm.Torsion(*idx["phi"]))
        cvf.addCollectiveVariable("psi", openmm.Torsion(*idx["psi"]))
        cvf.addTabulatedFunction(
            "V", Discrete2DFunction(BIAS_N, BIAS_N, [True, True],
                                    [0.0] * (BIAS_N * BIAS_N)))
        system.addForce(cvf)
        return system, system.getNumForces() - 1

    def make_context(hmr, dt_fs):
        system, cv_index = make_system(hmr)
        integrator = LangevinIntegrator(T_KELVIN * unit.kelvin,
                                        COLLISION_PS / unit.picosecond,
                                        dt_fs * unit.femtoseconds)
        ctx = app.Context(system, integrator, platform)
        return ctx, integrator, cv_index

    hmr = False
    dt = TIMESTEP_FS
    ctx, integrator, cv_index = make_context(hmr, dt)

    def set_grid(grid):
        ctx.setFunctionParameters(cv_index, "V", grid.flattened_omm().tolist())

    def cv_now():
        p = ctx.getState(getPositions=True).positions. \
            value_in_unit(unit.nanometer)
        return np.array([dihedral_deg(*[p[a] for a in idx["phi"]]),
                         dihedral_deg(*[p[a] for a in idx["psi"]])])

    def geom_now():
        p = ctx.getState(getPositions=True).positions. \
            value_in_unit(unit.nanometer)
        om = dihedral_deg(p[idx["psi"][0]], p[idx["psi"][2]], p[iC],
                          p[idx["psi"][3]])
        return dihedral_deg(*[p[a] for a in idx["phi"]]), \
            dihedral_deg(*[p[a] for a in idx["psi"]]), om

    # bias-mapping smoke test: known analytic V must reproduce at CV point
    grid = BiasGrid()
    nodes = -180.0 + BIAS_DG * np.arange(BIAS_N)
    grid.data = np.cos(np.radians(nodes))[None, :] + \
        np.cos(np.radians(nodes))[:, None]
    zero = BiasGrid()
    ctx.setPositions(pos * unit.nanometer)
    app.LocalEnergyMinimizer.minimize(ctx, maxIterations=2000)
    e_ref = ctx.getState(getEnergy=True).getPotentialEnergy(). \
        value_in_unit(unit.kilojoule_per_mole)
    set_grid(grid)
    e_test = ctx.getState(getEnergy=True).getPotentialEnergy(). \
        value_in_unit(unit.kilojoule_per_mole)
    phi_c, psi_c, om_c = geom_now()
    expected = math.cos(math.radians(phi_c)) + math.cos(math.radians(psi_c))
    err = abs((e_test - e_ref) - expected)
    set_grid(zero)
    if err > 0.05:
        sys.exit("ERROR: bias mapping smoke test failed "
                 f"(OpenMM gave {e_test - e_ref:.3f}, expected "
                 f"{expected:.3f} kJ/mol at phi={phi_c:.1f}, "
                 f"psi={psi_c:.1f}). CustomCVForce tabulated-function "
                 "convention differs from assumption; aborting to avoid "
                 "silently wrong results.")
    log(f"bias-mapping smoke test OK (err={err:.4f} kJ/mol); "
        f"prepared geometry: phi={phi_c:.1f} psi={psi_c:.1f} omega={om_c:.1f}")
    if abs(abs(om_c) - 180.0) > 10.0:
        log("WARNING: omega not near trans after minimization")

    # equilibration (no bias)
    integrator.setTemperature(T_KELVIN * unit.kelvin)
    integrator.step(int(EQUIL_PS * 1000 / dt))
    phi0, psi0, om0 = geom_now()
    log(f"after {EQUIL_PS:.0f} ps equilibration: phi={phi0:.1f} "
        f"psi={psi0:.1f} omega={om0:.1f}")

    # speed probe: 20 ps with the production integrator
    t0 = time.time()
    integrator.step(int(20.0 * 1000 / dt))
    ps_per_s = 20.0 / (time.time() - t0)
    est_s = PRODUCTION_NS * 1000.0 / ps_per_s
    log(f"speed probe: {ps_per_s:.3f} ps/s -> {PRODUCTION_NS:.0f} ns would "
        f"take {est_s/3600:.2f} h")
    if est_s > WALL_BUDGET_S:
        log("Switching to hydrogen mass repartitioning + "
            f"{TIMESTEP_FS_HMR} fs from the START of production "
            "(documented; slightly accelerates fast motions).")
        hmr, dt = True, TIMESTEP_FS_HMR
        pos_old = ctx.getState(getPositions=True).positions. \
            value_in_unit(unit.nanometer)
        del ctx
        ctx, integrator, cv_index = make_context(hmr, dt)
        ctx.setPositions(np.array(pos_old) * unit.nanometer)
        set_grid(zero)
        grid = zero.copy()
        app.LocalEnergyMinimizer.minimize(ctx, maxIterations=500)
        integrator.step(int(20.0 * 1000 / dt))
        integrator.step(0)

    # ---- production loop: this script IS the metadynamics engine ----
    os.makedirs(WORK_DIR, exist_ok=True)
    dep_t, dep_s, dep_h, rec_t, rec_s = [], [], [], [], []
    rec_steps = max(1, int(round(RECORD_PS * 1000 / dt)))
    dep_every = int(round(DEPOSIT_PS / RECORD_PS))
    snap_every = int(round(SNAPSHOT_EVERY_NS * 1000.0 / DEPOSIT_PS))
    target_deposits = int(PRODUCTION_NS * 1000.0 / DEPOSIT_PS)
    max_deposits = int(MAX_PRODUCTION_NS * 1000.0 / DEPOSIT_PS)
    grid = zero.copy()
    set_grid(grid)
    t0 = time.time()
    converged_at = None
    prev_F = None
    snapshot_F = []
    k = 0
    while k < min(target_deposits, max_deposits):
        integrator.step(rec_steps)
        s = cv_now()
        rec_t.append((k + 1) * RECORD_PS)
        rec_s.append(s)
        if (k + 1) % dep_every == 0:
            v_at = grid.at(s)
            h = H0 * math.exp(-v_at / (KB * DELTA_T))
            grid.deposit(s, h)
            dep_t.append((k + 1) * RECORD_PS)
            dep_s.append(s)
            dep_h.append(h)
            nd = len(dep_t)
            set_grid(grid)
            if nd % snap_every == 0:
                Fk, _ = reconstruct_fes(dep_s, dep_h)
                cntk = visit_counts(rec_s)
                mask = cntk >= 20
                if prev_F is not None and mask.sum() > 0:
                    dF = float(np.max(np.abs(Fk - prev_F)[mask]))
                    log(f"[{nd*DEPOSIT_PS/1000:.1f} ns] snapshot dF_max="
                        f"{dF:.2f} kJ/mol (visited cells), "
                        f"wall {time.time()-t0:.0f}s")
                    snapshot_F.append((nd * DEPOSIT_PS / 1000.0, dF))
                    if dF < CONVERGENCE_KJ and nd * DEPOSIT_PS >= 20000.0:
                        converged_at = nd * DEPOSIT_PS / 1000.0
                        log(f"convergence criterion met at "
                            f"{converged_at:.1f} ns; stopping early")
                        break
                else:
                    snapshot_F.append((nd * DEPOSIT_PS / 1000.0, None))
                prev_F = Fk
        k += 1
    set_grid(grid)  # guarantee final deployed bias matches recorded history
    total_ns = len(dep_t) * DEPOSIT_PS / 1000.0
    assert total_ns <= HARD_LIMIT_NS
    log(f"production done: {len(dep_t)} deposits over {total_ns:.2f} ns "
        f"({time.time()-t0:.0f} s wall), hmr={hmr}, dt={dt} fs")

    np.savez_compressed(os.path.join(WORK_DIR, "depositions.npz"),
                        t_ps=np.array(dep_t), s=np.array(dep_s),
                        h=np.array(dep_h))
    np.savez_compressed(os.path.join(WORK_DIR, "cv_traj.npz"),
                        t_ps=np.array(rec_t), s=np.array(rec_s))
    with open(os.path.join(WORK_DIR, "run_log.txt"), "w") as fh:
        fh.write("\n".join(log_lines) + "\n")

    F, _ = reconstruct_fes(dep_s, dep_h)
    counts = visit_counts(rec_s)
    minima = find_minima(F, counts, dep_s)
    extra = (f"\nRun diagnostics: {len(dep_t)} Gaussian deposits, "
             f"{total_ns:.2f} ns production, platform {platform.getName()}, "
             f"timestep {dt} fs (hmr={hmr}), omega during run stayed near "
             f"{om0:.0f} deg, last-snapshot dF series: "
             + "; ".join(f"{ns:.0f}ns:{'' if d is None else f'{d:.2f}'}"
                         for ns, d in snapshot_F) + ".")
    engine = write_all_outputs(F, minima, synthetic=False, extra=extra)
    for line in verify_outputs():
        log(line)
    with open(os.path.join(WORK_DIR, "run_log.txt"), "w") as fh:
        fh.write("\n".join(log_lines) + "\n")
    log(f"artifacts written to {OUT_DIR}/ (png engine: {engine})")



