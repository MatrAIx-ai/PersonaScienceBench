def run_envcheck(write=True):
    """Battery proving openmm availability across ALL interpreters, env
    managers, offline caches, system packages and loader cache. Writes
    work/env_verification.txt so the limitation is auditable, not asserted."""
    import glob
    import shutil
    import subprocess

    def run(cmd, timeout=60):
        try:
            r = subprocess.run(cmd, shell=True, capture_output=True,
                               text=True, timeout=timeout)
            out = (r.stdout + r.stderr).strip()
        except Exception as exc:                      # noqa: BLE001
            out = f"<error {exc}>"
        return out or "<empty>"

    L = ["Environment verification battery (openmm / matplotlib)",
         f"utc: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
         f"cwd: {os.getcwd()}  argv: {sys.argv[:1]}"]
    ok = False
    L.append("== (a) interpreters ==")
    cands = set()
    for pat in ("/usr/bin/python*", "/usr/local/bin/python*",
                "/opt/*/bin/python*", "/usr/bin/python3*"):
        cands.update(p for p in glob.glob(pat)
                     if os.access(p, os.X_OK) and not p.endswith("-config")
                     and "easy-install" not in p)
    for name in ("python", "python3"):
        p = shutil.which(name)
        if p:
            cands.add(p)
    for c in sorted(cands):
        out = run(f"'{c}' -c \"import openmm,"
                  " matplotlib; print('OPENMM_OK', openmm.version.version)"
                  '\" 2>&1 | tail -1')
        if "OPENMM_OK" in out:
            ok = True
        L.append(f"{c} -> {out[:200]}")
    L.append("== (b) env managers / venv dirs ==")
    for m in ("conda", "mamba", "micromamba", "uv", "virtualenv", "poetry"):
        L.append(f"{m}: {shutil.which(m) or 'absent'}")
    L.append("dirs: " + run("ls -d ~/.venv* /opt/conda ~/.virtualenvs "
                            "~/.local/share/virtualenvs /opt/*/envs 2>/dev/null"
                            " || echo none"))
    L.append("== (c) offline caches / wheels ==")
    L.append("cache dirs: " + run("ls -d ~/.cache/pip /var/cache/pip /wheels"
                                  " /opt/wheels /tmp/cache 2>/dev/null"
                                  " || echo none"))
    L.append("openmm artifacts: " + run(
        "find ~/.cache /var/cache /wheels /opt/wheels /tmp "
        "\\( -iname '*openmm*' -o -iname '*.whl' \\) 2>/dev/null"
        " | grep -i openmm | head -20 || true"))
    L.append("== (d) system packages ==")
    L.append(run("dpkg -l 2>/dev/null | grep -i openmm; rpm -qa 2>/dev/null"
                 " | grep -i openmm; apt list --installed 2>/dev/null"
                 " | grep -i openmm; true") if True else "")
    L.append("== (e) loader + site-packages ==")
    L.append("ldconfig: " + run("ldconfig -p 2>/dev/null"
                                " | grep -i openmm || echo none"))
    import site as _site
    L.append("site-packages(this interp): " + str(_site.getsitepackages()))
    L.append("offline pip install attempt (--no-index): " + run(
        "pip install --no-index --find-links /wheels --find-links /opt/wheels"
        " --find-links ~/.cache/pip openmm 2>&1 | tail -1"))
    verdict = ("OPENMM_AVAILABLE: run `python analysis.py` for production"
               if ok else
               "OPENMM_NOT_FOUND_ANYWHERE: real MD is impossible in this "
               "sandbox; artifacts under results/ are synthetic self-test "
               "placeholders until the script is run in the declared "
               "openmm>=8.0 environment")
    L.append("VERDICT: " + verdict)
    text = "\n".join(L) + "\n"
    if write:
        os.makedirs(WORK_DIR, exist_ok=True)
        with open(os.path.join(WORK_DIR, "env_verification.txt"), "w") as fh:
            fh.write(text)
        # equivalent of run_log.txt for the no-OpenMM situation:
        with open(os.path.join(WORK_DIR, "run_log.txt"), "a") as fh:
            fh.write(text + "\n")
    print(text)
    return ok


# ---------------------------------------------------------------------------
# Synthetic self-test: full pipeline (WTM engine + reconstruction + minima
# + artifacts) validated WITHOUT OpenMM against a known toy FES.
# ---------------------------------------------------------------------------
def toy_fes_grid():
    P, Y = np.meshgrid(CELL_CENTERS, CELL_CENTERS, indexing="ij")
    basins = [(-63.0, -42.0, 0.0), (-118.0, 142.0, 4.5),
              (-75.0, 148.0, 6.5), (63.0, 38.0, 9.0)]
    U = np.zeros_like(P)
    for bphi, bpsi, dep in basins:
        dphi = wrap180(P - bphi)
        dpsi = wrap180(Y - bpsi)
        U -= dep * np.exp(-0.5 * ((dphi / 25.0) ** 2 + (dpsi / 25.0) ** 2))
    U -= 1.2 * np.exp(-0.5 * ((wrap180(P - 60.0) / 60.0) ** 2
                              + (wrap180(Y + 120.0) / 60.0) ** 2))
    return U


def synth_wtm_history(n_dep=60000, seed=7):
    """Simulate a well-tempered metadynamics deposition history over the toy
    FES using THIS script's own engine (heights from its own V, periodic
    kernels). CV dynamics approximated by Metropolis sampling of exp(-(F+V)/kT)
    in the slow-CV limit."""
    rng = np.random.default_rng(seed)
    Ftoy = toy_fes_grid()

    def ftoy(s):
        i = int((wrap180(s[0]) + 180.0) // CELL) % N_CELLS
        j = int((wrap180(s[1]) + 180.0) // CELL) % N_CELLS
        return Ftoy[i, j]

    grid = BiasGrid()
    s = np.array([-63.0, -42.0])
    dep_t, dep_s, dep_h, rec_s = [], [], [], []
    beta = 1.0 / KBT
    for k in range(n_dep):
        for _ in range(8):  # MCMC relaxation on F + V
            prop = wrap180(s + rng.normal(0, 12.0, 2))
            p_old = -(ftoy(s) + grid.at(s)) * beta
            p_new = -(ftoy(prop) + grid.at(prop)) * beta
            if math.log(rng.random()) < p_new - p_old:
                s = prop
            rec_s.append(np.array(s))
        v_at = grid.at(s)
        h = H0 * math.exp(-v_at / (KB * DELTA_T))
        grid.deposit(s, h)
        dep_t.append((k + 1) * DEPOSIT_PS)
        dep_s.append(np.array(s))
        dep_h.append(h)
    return np.array(dep_t), np.array(dep_s), np.array(dep_h), np.array(rec_s)


def run_selftest(args):
    run_envcheck()
    t0 = time.time()
    dep_t, dep_s, dep_h, rec_s = synth_wtm_history(n_dep=args.selftest_deposits)
    F, _ = reconstruct_fes(dep_s, dep_h)
    Ftoy = toy_fes_grid()
    Ftoy = Ftoy - Ftoy.min()
    counts = visit_counts(rec_s)
    mask = counts >= 20
    diff = (F - Ftoy)[mask]
    med = float(np.median(diff))
    mad = float(np.max(np.abs(diff - med)))
    minima = find_minima(F, counts, dep_s)
    print(f"recon vs toy FES over visited cells ({mask.sum()} cells): "
          f"median offset {med:.2f}, max |dev| {mad:.2f} kJ/mol")
    for m in minima:
        i = int((m['phi'] + 180.0) // CELL) % N_CELLS
        j = int((m['psi'] + 180.0) // CELL) % N_CELLS
        print(f"  minimum {m['name']:>10s} phi={m['phi']:7.1f} "
              f"psi={m['psi']:7.1f} dG={m['dG']:6.2f} kJ/mol "
              f"(toy {Ftoy[i, j]:6.2f}) deposits={m['count']}")
    # consistency between first-half and second-half reconstruction trends
    half = len(dep_h) // 2
    F2, _ = reconstruct_fes(dep_s[half:], dep_h[half:])
    assert F2.shape == (72, 72)
    engine = write_all_outputs(F, minima, synthetic=True,
                               extra=f"\nSelf-test: {len(dep_h)} synthetic "
                               f"deposits, max deviation from known toy FES "
                               f"{mad:.2f} kJ/mol over visited cells.")
    lines = verify_outputs()
    for line in lines:
        print("VERIFY:", line)
    print(f"png engine: {engine}; selftest wall {time.time()-t0:.1f} s")
    assert mad < 4.0, "reconstruction deviates too much from toy FES"
    assert minima[0]["dG"] == 0.0
    print("SELFTEST PASSED (synthetic data; NOT production results)")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[1])
    ap.add_argument("--selftest", action="store_true",
                    help="validate pipeline with synthetic data (no OpenMM)")
    ap.add_argument("--envcheck", action="store_true",
                    help="only run the auditable environment verification")
    ap.add_argument("--selftest-deposits", type=int, default=60000)
    args = ap.parse_args()
    if args.envcheck:
        run_envcheck()
        return
    if args.selftest:
        run_selftest(args)
    else:
        run_production(args)


if __name__ == "__main__":
    main()
