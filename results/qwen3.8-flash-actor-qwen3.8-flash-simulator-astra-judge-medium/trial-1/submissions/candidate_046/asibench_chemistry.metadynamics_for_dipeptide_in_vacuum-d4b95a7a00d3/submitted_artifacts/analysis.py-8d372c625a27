def write_fes_npy(F, path):
    assert F.shape == (N_CELLS, N_CELLS) and F.dtype == np.float64
    assert F.min() == 0.0 and F.min() >= 0.0
    np.save(path, F)


def write_minima_csv(minima, path):
    with open(path, "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["name", "cv1", "cv2", "delta_g_kj_mol"])
        for m in minima:
            w.writerow([m["name"], f"{m['phi']:.1f}", f"{m['psi']:.1f}",
                        f"{m['dG']:.4f}"])


