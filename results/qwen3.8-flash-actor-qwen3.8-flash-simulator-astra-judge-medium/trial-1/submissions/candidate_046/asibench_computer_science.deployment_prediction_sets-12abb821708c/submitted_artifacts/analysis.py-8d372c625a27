def axes(cv, x0, y0, x1, y1, xlim, ylim, title, xlab, ylab, xticks=5, yticks=5):
    cv.line(x0, y0, x0, y1, BLACK); cv.line(x0, y1, x1, y1, BLACK)
    cv.line(x1, y0, x1, y1, GRAY); cv.line(x0, y0, x1, y0, GRAY)
    cv.text(x0, 10, title, BLACK, 2)
    for i in range(xticks+1):
        t = xlim[0]+(xlim[1]-xlim[0])*i/xticks
        X = x0+(x1-x0)*i/xticks
        cv.line(X, y1, X, y1+4, BLACK)
        s = f"{t:.4g}"
        cv.text(X-6*len(s)//2, y1+7, s, BLACK, 1)
    for i in range(yticks+1):
        t = ylim[0]+(ylim[1]-ylim[0])*i/yticks
        Y = y1-(y1-y0)*i/yticks
        cv.line(x0-4, Y, x0, Y, BLACK)
        cv.text(2, Y-4, f"{t:.3g}", BLACK, 1)
    cv.text((x0+x1)//2-6*len(xlab), y1+22, xlab, BLACK, 1)
    # vertical y label: stack chars
    for i, ch in enumerate(str(ylab).upper()):
        cv.text(x0-24, y0+2+ i*11, ch, BLACK, 1)
    return lambda v,lo,hi,a,b: a+(b-a)*(v-lo)/(hi-lo)

def xy(cv, X, Y, xlim, ylim, x0, y0, x1, y1):
    return (x0+(x1-x0)*(X-xlim[0])/(xlim[1]-xlim[0]),
            y1-(y1-y0)*(Y-ylim[0])/(ylim[1]-ylim[0]))

def dotted(cv, xa, ya, xb, yb, c):
    n=int(max(abs(xb-xa),abs(yb-ya))); 
    for t in np.linspace(0,1,n):
        if int(t*10)%2==0: cv.px(xa+(xb-xa)*t, ya+(yb-ya)*t, c)

# ---------------------------------------------------------------- data
def load():
    cf=pd.read_csv('data/calibration_features.csv'); cl=pd.read_csv('data/calibration_labels.csv')
    cs=pd.read_csv('data/calibration_scores.csv'); df=pd.read_csv('data/deployment_features.csv')
    ds=pd.read_csv('data/deployment_scores.csv')
    for a,b in ((cf,cs),(cf,cl),(df,ds)):
        assert (a.record_id.values==b.record_id.values).all()
    spec=json.load(open('data/risk_spec.json')); meta=json.load(open('data/metadata.json'))
    labels=meta['label_columns']; costs=np.array([spec['label_costs'][l] for l in labels])
    return cf,cl,cs,df,ds,spec,meta,labels,costs

def cluster(Xc, Xd, k):
    X=np.vstack([Xc,Xd]); Xs=(X-X.mean(0))/X.std(0)
    agree=[]
    labs={}
    full={}
    for s in range(3):
        _,lab=kmeans2(Xs,k,minit='++',seed=SEED+s,iter=100)
        full[s]=lab; labs[s]=lab[:len(Xc)]
    for s in (1,2):
        a,b=labs[0],labs[s]; M=np.zeros((k,k),int)
        for i in range(k):
            for j in range(k): M[i,j]=int(((a==i)&(b==j)).sum())
        r,c=linear_sum_assignment(-M); agree.append(M[r,c].sum()/len(a))
    return labs[0], full[0][len(Xc):], float(np.mean(agree))

# ------------------------------------------------- set policies (per group)
def cps_sizes(S, q):
    order=np.argsort(-S,1); cum=np.cumsum(np.take_along_axis(S,order,1),1)
    gt=cum>q
    return np.where(gt.any(1), gt.argmax(1)+1, S.shape[1]), order

def eval_cps(S, y, w, q):
    s,_=cps_sizes(S,q)
    ranks=np.argsort(np.argsort(-S,1),1)[np.arange(len(y)),y]
    miss=ranks>=s
    return float((w*miss).sum()/len(y)), float(s.mean()), s

def fit_cps(S, y, w, budget):
    ranks=np.argsort(np.argsort(-S,1),1)[np.arange(len(y)),y]
    order=np.argsort(-S,1); cum=np.cumsum(np.take_along_axis(S,order,1),1)
    qs=np.unique(np.round(np.quantile(cum[:, :S.shape[1]-1], np.linspace(0.02,0.999,100)),8))
    best=None
    for q in qs:
        gt=cum>q; s=np.where(gt.any(1), gt.argmax(1)+1, S.shape[1])
        miss=ranks>=s
        risk=(w*miss).sum()/len(y); size=s.mean()
        if risk<=budget and (best is None or size<best[1]): best=(q,size,risk)
    return qs[0] if best is None else best[0]

LEVELS=np.array([0.0,0.002,0.005,0.01,0.02,0.035,0.05,0.075,0.1,0.13,0.17,0.22,0.3,0.4,0.55,0.75])
def fit_greedy(S, y, w, budget):
    n,L=S.shape
    tau=np.zeros(L); risk=0.0
    inc=np.ones((n,L),bool)
    cur_risk=np.zeros(n)  # per-record weighted miss
    wmiss=np.zeros(n)
    while True:
        bestmv=None
        for j in range(L):
            if tau[j]>=LEVELS[-1]: continue
            nxt=LEVELS[np.where(LEVELS>tau[j])[0][0]]
            drop=inc[:,j]&(S[:,j]<nxt)
            newmiss=drop&(y==j)
            radd=(w*newmiss).sum()/n
            dsz=drop.sum()/n
            if dsz<=0: continue
            score=dsz/(radd+1e-12)
            if risk+radd<=budget+1e-12 and (bestmv is None or score>bestmv[0]):
                bestmv=(score,j,nxt,radd,dsz)
        if bestmv is None: break
        _,j,nxt,radd,dsz=bestmv
        inc[:,j] = inc[:,j] & (S[:,j]>=nxt)
        tau[j]=nxt; risk+=radd
    return tau

def eval_thresh(S, y, w, tau):
    inc=S>=tau[None,:]
    inc[np.arange(len(y)), S.argmax(1)]=True  # hard non-empty: argmax forced
    miss=~inc[np.arange(len(y)),y]
    return (w*miss).sum()/len(y), inc.sum(1).mean(), inc.sum(1)

def folds(n, k, rng):
    idx=rng.permutation(n); return [idx[i::k] for i in range(k)]

def oof_curve(S,y,w,var,budgets,seed=0):
    n=len(y); rng=np.random.default_rng(seed); fs=folds(n,KFOLD,rng)
    trs=[np.setdiff1d(np.arange(n),te) for te in fs]
    out=[]
    for b in budgets:
        if var=='g': fits=[fit_greedy(S[tr],y[tr],w[tr],b) for tr in trs]
        else: fits=[fit_cps(S[tr],y[tr],w[tr],b) for tr in trs]
        rs=[];sz=[]
        for fi,te in enumerate(fs):
            if var=='g': r,s,_=eval_thresh(S[te],y[te],w[te],fits[fi])
            else: r,s,_=eval_cps(S[te],y[te],w[te],fits[fi])
            rs.append(r); sz.append(s)
        out.append((b,float(np.mean(rs)),float(np.mean(sz)),float(np.std(rs))))
    return np.array(out)

def boot_ub(x, n_boot=2000, rng=None):
    rng=rng or np.random.default_rng(SEED)
    idx=rng.integers(0,len(x),(n_boot,len(x)))
    m=x[idx].mean(1)
    return np.quantile(m,1-ALPHA)

# ================================================================= main
def main():
    global TARGET
    cf,cl,cs,df,ds,spec,meta,labels,costs = load()
    TARGET=spec['target_risk']
    L=len(labels); lmap={l:i for i,l in enumerate(labels)}
    y=cl.true_label.map(lmap).values
    w=costs[y]
    F=meta['feature_columns']
    Sc=cs[labels].values; Sd=ds[labels].values
    Xc=cf[F].values; Xd=df[F].values
    os.makedirs('results', exist_ok=True)
    print(f"n_cal={len(y)} n_dep={len(Sd)} K={spec['target_risk']=} delta={spec['delta']=}")

    # ---- clustering with k selection: stability >=0.95, min group n_cal>=KMIN_CAL
    kcand={}
    for k in (3,4,5):
        lc,ld,st=cluster(Xc,Xd,k)
        nmin=int(np.bincount(lc,minlength=k).min())
        ok= (st>=0.95) and (nmin>=KMIN_CAL)
        kcand[k]=dict(lc=lc,ld=ld,st=st,nmin=nmin,ok=ok)
        print(f"k={k} stability={st:.4f} min_n_cal={nmin} ok={ok}")
    KSEL = 4 if kcand[4]['ok'] else max((k for k in (4,3,5) if kcand[k]['ok']))
    print(f"selected k={KSEL} (seed={SEED}; ids g0..g{KSEL-1})")

    lc,ld=kcand[KSEL]['lc'],kcand[KSEL]['ld']
    pi_dep=np.bincount(ld,minlength=KSEL)/len(ld)
    pi_cal=np.bincount(lc,minlength=KSEL)/len(lc)
    BUD=np.round(np.arange(2,29)*0.01,2)

    def run_pipeline(lc_,ld_,variant,pi_eff):
        K=lc_.max()+1
        curves=np.zeros((K,len(BUD),2))
        for g in range(K):
            m=lc_==g
            cur=oof_curve(Sc[m],y[m],w[m],variant,BUD)
            curves[g]=np.stack([cur[:,1],cur[:,2]],1)
        # Lagrangian allocation with deployment weights: MIN size s.t. risk<=target
        best=None
        for lam in np.logspace(-0.7,3,80):
            rows=[]; gr=0.0; gs=0.0
            for g in range(K):
                obj=curves[g,:,1]+lam*curves[g,:,0]
                i=int(np.argmin(obj)); rows.append(i)
                gr+=pi_eff[g]*curves[g,i,0]; gs+=pi_eff[g]*curves[g,i,1]
            if gr<=TARGET and (best is None or gs<best[2]):
                best=(rows,gr,gs)
        assert best is not None, 'risk target infeasible on budget grid'
        rows,gr,gs=list(best[0]),best[1],best[2]
        # coordinate descent on per-group curve index
        for _ in range(10):
            improved=False
            for g in range(K):
                ci=rows[g]; br,bs,bi=gr,gs,ci
                for i in range(len(BUD)):
                    if i==ci: continue
                    nr=gr-curves[g,ci,0]+curves[g,i,0]
                    ns=gs-curves[g,ci,1]+curves[g,i,1]
                    if nr<=TARGET and ns<bs-1e-9:
                        br,bs,bi=nr,ns,i
                if bi!=ci:
                    gr,gs,rows[g]=br,bs,bi; improved=True
            if not improved: break
        assert gs<=9.0001
        bud=[BUD[i] for i in rows]
        return curves,bud,gr,gs

    res={}
    for variant in ('c','g'):
        curves,bud,gr,gs=run_pipeline(lc,ld,variant,pi_dep)
        res[variant]=dict(curves=curves,bud=bud,gr=gr,gs=gs)
        print(f"variant {'CPS' if variant=='c' else 'GREEDY-THRESH'}: allocated budgets {bud} "
              f"OOF global risk {gr:.4f} OOF mean size {gs:.3f}")

    # ---- choose winner: require greedy to beat CPS by >=1.5% relative size, else CPS
    sc,sg=res['c']['gs'],res['g']['gs']
    winner='g' if (sg < sc*0.985 and res['g']['gr']<=TARGET) else 'c'
    print(f"winner={'CPS' if winner=='c' else 'GREEDY-THRESH'} "
          f"(oof sizes c={sc:.3f} g={sg:.3f}; rule: greedy wins only if >=1.5% smaller)")

    # ---- OOF miss vectors + bootstrap UB at chosen budgets; shrink until sum pi_dep*UB<=target
    def oof_miss(S_,y_,w_,variant,b,seed=1):
        n=len(y_); rng=np.random.default_rng(seed); fs=folds(n,KFOLD,rng)
        miss=np.zeros(n)
        for te in fs:
            tr=np.setdiff1d(np.arange(n),te)
            if variant=='g':
                tau=fit_greedy(S_[tr],y_[tr],w_[tr],b)
                inc=S_[te]>=tau[None,:]; inc[np.arange(len(te)),S_[te].argmax(1)]=True
                miss[te]=~inc[np.arange(len(te)),y_[te]]
            else:
                q=fit_cps(S_[tr],y_[tr],w_[tr],b)
                s,_=cps_sizes(S_[te],q)
                ranks=np.argsort(np.argsort(-S_[te],1),1)[np.arange(len(te)),y_[te]]
                miss[te]=ranks>=s
        return w_*miss  # per-record weighted loss

    K=KSEL
    ub=np.zeros(K); emp=np.zeros(K); oof_size=np.zeros(K); oofv={}
    # per-stratum conservative shrink: 95% bootstrap UB of OOF risk <= TARGET
    shrink=np.ones(K)
    for g in range(K):
        m=lc==g
        for it in range(14):
            rngb=np.random.default_rng(7)
            z=oof_miss(Sc[m],y[m],w[m],winner,res[winner]['bud'][g]*shrink[g])
            emp[g]=z.mean(); ub[g]=boot_ub(z,2000,rngb)
            if ub[g]<=TARGET or shrink[g]<=0.15: break
            shrink[g]*=0.85
    budgets=[res[winner]['bud'][g]*shrink[g] for g in range(K)]
    print(f"per-stratum shrink {np.round(shrink,3)}; final budgets {np.round(budgets,4)}")
    print("per-stratum OOF risk / 95% UB:",
          np.round(emp,4), np.round(ub,4))
    transferred=float((pi_dep*emp).sum()); ub_global=float((pi_dep*ub).sum())
    # combined bootstrap UB over groups (independent resampling per group)
    rngc=np.random.default_rng(11); B=4000; comb=np.zeros(B)
    for g in range(K):
        m=lc==g; z=oof_miss(Sc[m],y[m],w[m],winner,budgets[g])
        oofv[g]=z
        idx=rngc.integers(0,len(z),(B,len(z))); comb+=pi_dep[g]*z[idx].mean(1)
    ub_comb=float(np.quantile(comb,1-ALPHA))
    print(f"transferred dep risk={transferred:.4f} sumPiUB={ub_global:.4f} "
          f"combined bootstrap UB={ub_comb:.4f} (target {TARGET})")

    # ---- final policy fit on full calibration strata; deployment sets
    final_param={}; final_tau={}; set_sizes=np.zeros(len(Sd),int); strat_dep=np.zeros(len(Sd),int)
    rows_pp=[]
    for g in range(K):
        m=lc==g
        if winner=='g':
            tau=fit_greedy(Sc[m],y[m],w[m],budgets[g])
            final_tau[g]=tau
            for j in range(L):
                eff=float(tau[j]); always_incl=True
                rows_pp.append(dict(proxy_stratum=f'g{g}',label=labels[j],
                    n_calibration=int(m.sum()),n_calibration_label=int((y[m]==j).sum()),
                    threshold=round(eff,4),
                    group_empirical_weighted_miss_risk=round(emp[g],4),
                    group_upper_confidence_risk=round(ub[g],4),
                    group_expected_set_size=round(float(eval_thresh(Sc[m],y[m],w[m],tau)[1]),3),
                    calibration_target_risk=round(budgets[g],4),target_risk=TARGET))
        else:
            q=fit_cps(Sc[m],y[m],w[m],budgets[g])
            s_c,_=cps_sizes(Sc[m],q)
            order=np.argsort(-Sc[m],1); ranks=np.argsort(order,axis=1)
            for j in range(L):
                excl=ranks[:,j]>=s_c
                eff=float(Sc[m][excl,j].max()) if excl.any() else 0.0
                rows_pp.append(dict(proxy_stratum=f'g{g}',label=labels[j],
                    n_calibration=int(m.sum()),n_calibration_label=int((y[m]==j).sum()),
                    threshold=round(eff,4),
                    group_empirical_weighted_miss_risk=round(emp[g],4),
                    group_upper_confidence_risk=round(ub[g],4),
                    group_expected_set_size=round(float(s_c.mean()),3),
                    calibration_target_risk=round(budgets[g],4),target_risk=TARGET))
            final_param[g]=q
    # deployment sets (score-descending label order)
    dep_sets=[]
    for i in range(len(Sd)):
        g=int(ld[i]); S_=Sd[i]
        if winner=='g':
            inc=S_>=final_tau[g]
        else:
            s_q,_=cps_sizes(S_[None,:],final_param[g]); s_i=int(s_q[0])
            inc=np.zeros(L,bool); inc[np.argsort(-S_)[:s_i]]=True
        inc[S_.argmax()]=True  # hard non-empty guarantee
        order=np.argsort(-S_)
        dep_sets.append([labels[j] for j in order if inc[j]])
        set_sizes[i]=int(inc.sum()); strat_dep[i]=g
    assert all(len(s)>=1 for s in dep_sets)
    print(f"deployment sets: min={min(len(s) for s in dep_sets)} "
          f"mean={np.mean([len(s) for s in dep_sets]):.3f} "
          f"p90={int(np.quantile([len(s) for s in dep_sets],0.9))} (trivial=9, global-CPS~4.47)")

    # global (unstratified) CPS baseline, OOF
    curG=oof_curve(Sc,y,w,'c',BUD)
    okG=curG[curG[:,1]<=TARGET]
    gsize=okG[-1,2] if len(okG) else 9.0
    print(f"global unstratified CPS baseline: OOF risk<=target at mean size {gsize:.3f}")

    # ---- k sensitivity with chosen variant
    for k in (3,4,5):
        pik=np.bincount(kcand[k]['ld'],minlength=k)/len(kcand[k]['ld'])
        c2,b2,r2,s2=run_pipeline(kcand[k]['lc'],kcand[k]['ld'],'c',pik)
        print(f"sensitivity k={k} (CPS): OOF global risk {r2:.4f} mean size {s2:.3f}")

    # ---------------------------------------------------------- write CSVs
    pd.DataFrame({'record_id':ds.record_id,
        'prediction_set':[' '.join(s) for s in dep_sets]}
        ).to_csv('results/prediction_sets.csv',index=False)
    pd.DataFrame(rows_pp).to_csv('results/policy_parameters.csv',index=False)
    pd.DataFrame({'record_id':ds.record_id,'set_size':set_sizes,
        'proxy_stratum':[f'g{g}' for g in strat_dep]}
        ).to_csv('results/set_size_summary.csv',index=False)

    dep_mean=[set_sizes[strat_dep==g].mean() for g in range(K)]
    dep_p90=[int(np.quantile(set_sizes[strat_dep==g],0.9)) for g in range(K)]
    aud=[dict(scope='overall',stratum_id='all',n_records=len(Sd),
              empirical_risk=round(transferred,4),
              mean_set_size=round(float(set_sizes.mean()),3),
              p90_set_size=int(np.quantile(set_sizes,0.9)),target_risk=TARGET,
              risk_violation=round(max(0.0,ub_comb-TARGET),4))]
    for g in range(K):
        aud.append(dict(scope='proxy_stratum',stratum_id=f'g{g}',
            n_records=int((strat_dep==g).sum()),empirical_risk=round(emp[g],4),
            mean_set_size=round(float(dep_mean[g]),3),p90_set_size=dep_p90[g],
            target_risk=TARGET,risk_violation=round(max(0.0,ub[g]-TARGET),4)))
    pd.DataFrame(aud).to_csv('results/audit_summary.csv',index=False)
    part=[dict(r, risk_margin=round(TARGET-r['empirical_risk'],4)) for r in aud[1:]]
    pd.DataFrame(part).to_csv('results/partition_diagnostics.csv',index=False)

    eps=0.01
    dd=[]
    for g in range(K):
        fc=pi_cal[g]; fd=pi_dep[g]
        dd.append(dict(proxy_stratum=f'g{g}',calibration_fraction=round(fc,4),
            deployment_fraction=round(fd,4),
            density_ratio_estimate=round((fd+eps)/(fc+eps),4),
            absolute_fraction_shift=round(abs(fd-fc),4)))
    pd.DataFrame(dd).to_csv('results/distribution_diagnostics.csv',index=False)

    cd=[]
    edges=np.linspace(0,1,6)
    for g in range(K):
        m=lc==g
        top=Sc[m].max(1); ts=np.array([Sc[m][i,y[m][i]] for i in range(m.sum())])
        for b in range(5):
            sel=(top>=edges[b])&((top<edges[b+1])|((b==4)&(top<=1.0)))
            cd.append(dict(proxy_stratum=f'g{g}',bin_id=f'b{b}',
                score_left=round(edges[b],2),score_right=round(edges[b+1],2),
                n_records=int(sel.sum()),
                mean_true_label_score=round(float(ts[sel].mean()),4) if sel.any() else float('nan')))
    pd.DataFrame(cd).to_csv('results/calibration_diagnostics.csv',index=False)

    ca=[dict(scope='overall',stratum_id='all',empirical_risk=round(transferred,4),
             target_risk=TARGET,risk_violation=round(max(0.0,ub_comb-TARGET),4),
             violates=bool(ub_comb>TARGET))]
    for g in range(K):
        ca.append(dict(scope='proxy_stratum',stratum_id=f'g{g}',
            empirical_risk=round(emp[g],4),target_risk=TARGET,
            risk_violation=round(max(0.0,ub[g]-TARGET),4),violates=bool(ub[g]>TARGET)))
    pd.DataFrame(ca).to_csv('results/constraint_audit.csv',index=False)
    assert all(set_sizes>=1), 'empty prediction set found'
    print("non-empty check: all",len(set_sizes),"deployment sets have >=1 label: PASS")
    return dict(winner=winner,emp=emp,ub=ub,pi_dep=pi_dep,oofv=oofv,res=res,
                transferred=transferred,ub_comb=ub_comb,set_sizes=set_sizes,gcurve=curG,
                strat_dep=strat_dep,K=K,gsize=gsize,dep_sets=dep_sets,
                dep_mean=dep_mean,dep_p90=dep_p90)

def make_figures(O):
    K=O['K']; res=O['res']; winner=O['winner']
    # --- fig 1: set-size tradeoff (OOF risk vs mean size per stratum + global)
    cv=Canvas(760,520)
    x0,y0,x1,y1=90,60,700,430
    xlim=[0.8,9.0]; ylim=[0.0,0.32]
    axes(cv,x0,y0,x1,y1,xlim,ylim,
         'SET SIZE TRADEOFF: OOF WEIGHTED RISK VS MEAN SET SIZE',
         'MEAN SET SIZE','RISK',5,8)
    _yt=y1-(y1-y0)*TARGET/ylim[1]
    dotted(cv,x0,_yt,x1,_yt,RED)
    cv.text(x1-150,y1-(y1-y0)*TARGET/ylim[1]-12,'TARGET RISK 0.1084',RED,1)
    curves=res[winner]['curves']
    allpts=[]
    for g in range(K):
        c=res[winner]['curves'][g]
        pts=sorted(zip(c[:,1],c[:,0]))
        allpts+=pts
        col=COLORS[g%len(COLORS)]
        for (s,r) in pts:
            X,Y=xy(cv,s,r,xlim,ylim,x0,y0,x1,y1)
            cv.rect(X-2,Y-2,X+2,Y+2,col)
    ptsG=sorted(zip(O['gcurve'][:,2],O['gcurve'][:,1]))
    for (s,r) in ptsG:
        X,Y=xy(cv,s,r,xlim,ylim,x0,y0,x1,y1); cv.px(X,Y,BLACK); cv.px(X+1,Y,BLACK)
    lx,ly=x0+20,y0+12
    for g in range(K):
        cv.rect(lx,ly,lx+9,ly+9,COLORS[g%len(COLORS)])
        cv.text(lx+14,ly,f"G{G_LABELS[g] if False else 'STRATUM G'+str(g)}",BLACK,1); ly+=14
    cv.rect(lx,ly,lx+9,ly+9,BLACK); cv.text(lx+14,ly,'GLOBAL (NO STRATA)',BLACK,1)
    cv.text(x0,y1+40,'POINTS: OOF POLICY SWEEP (BUDGET GRID). WINNER VARIANT: '
          +('LABEL-THRESHOLD GREEDY' if winner=='g' else 'CPS STRATUM THRESHOLD'),BLACK,1)
    cv.save('results/set_size_tradeoff.png')

    # --- fig 2: partition audit (risk + 95% UB vs target per stratum)
    cv=Canvas(760,520)
    x0,y0,x1,y1=90,60,700,430
    emp,ub,O_dep=O['emp'],O['ub'],O['pi_dep']
    ymax=max(0.2,max(ub)*1.25)
    axes(cv,x0,y0,x1,y1,(0,K),(0,ymax),
         'PARTITION AUDIT: TRANSFERRED RISK + 95% UB PER STRATUM',
         'RECOVERED STRATUM','WEIGHTED MISS RISK',K,8)
    dotted(cv,x0,y1-(y1-y0)*TARGET/ymax,x1,y1-(y1-y0)*TARGET/ymax,RED)
    cv.text(x1-150,y1-(y1-y0)*TARGET/ymax-12,'TARGET RISK 0.1084',RED,1)
    for g in range(K):
        cx_=x0+(x1-x0)*(g+0.5)/K
        bw=(x1-x0)/K*0.4
        _,Ye=xy(cv,0,emp[g],(0,K),(0,ymax),x0,y0,x1,y1)
        _,Yu=xy(cv,0,ub[g],(0,K),(0,ymax),x0,y0,x1,y1)
        _,Y0=xy(cv,0,0,(0,K),(0,ymax),x0,y0,x1,y1)
        cv.rect(cx_-bw,Ye,cx_+bw,Y0,COLORS[g%len(COLORS)])
        cv.line(cx_,Ye,cx_,Yu,BLACK,2)
        cv.line(cx_-8,Yu,cx_+8,Yu,BLACK,2)
        cv.text(cx_-30,Yu-14,f"UB {ub[g]:.3f}",BLACK,1)
        cv.text(cx_-30,Ye+6,f"R {emp[g]:.3f}",BLACK,1)
        cv.text(cx_-24,Y1TXT if False else y1+7,f"G{g}",BLACK,2)
    cv.text(x0,y1+24,'BARS=TRANSFERRED OOF RISK (DEPLOYMENT-WEIGHTED AUDIT); '
            'WHISKER=95% BOOTSTRAP UB',BLACK,1)
    cv.text(x0,y1+40,'OVERALL TRANSFERRED %.4f | COMBINED UB %.4f | TARGET %.4f'%
            (O['transferred'],O['ub_comb'],TARGET),BLACK,1)
    cv.save('results/partition_audit.png')

    # --- fig 3: score diagnostics: mean true-label score by top-score bin, per stratum
    import pandas as _pd
    dfc=_pd.read_csv('results/calibration_diagnostics.csv')
    cv=Canvas(760,520)
    x0,y0,x1,y1=90,60,700,430
    axes(cv,x0,y0,x1,y1,(0,5),(0,1.0),
         'SCORE DIAGNOSTICS (CALIBRATION): MEAN TRUE-LABEL SCORE',
         'TOP-1 SCORE BIN','MEAN TRUE-LABEL SCORE',5,10)
    groups=dfc.proxy_stratum.unique()
    for gi,gname in enumerate(sorted(groups)):
        sub=dfc[dfc.proxy_stratum==gname].reset_index(drop=True)
        col=COLORS[gi%len(COLORS)]
        for b in range(len(sub)):
            v=sub.mean_true_label_score[b]
            if _pd.isna(v): continue
            cx_=x0+(x1-x0)*(b+0.5+(gi-1.5)*0.2)/5
            bw=(x1-x0)/5*0.16
            _,Y0=xy(cv,0,0,(0,5),(0,1.0),x0,y0,x1,y1)
            _,Yv=xy(cv,0,v,(0,5),(0,1.0),x0,y0,x1,y1)
            cv.rect(cx_-bw,Yv,cx_+bw,Y0,col)
    lx,ly=x0+20,y0+12
    for gi,gname in enumerate(sorted(groups)):
        cv.rect(lx,ly,lx+9,ly+9,COLORS[gi%len(COLORS)])
        cv.text(lx+14,ly,f"STRATUM {gname}",BLACK,1); ly+=14
    cv.text(x0,y1+24,'BINS: TOP-1 PREDICTED SCORE (0.2 WIDTH). Y: MEAN CLASSIFIER SCORE',BLACK,1)
    cv.text(x0,y1+40,'OF THE TRUE LABEL, CALIBRATION ONLY (DEPLOYMENT LABELS UNOBSERVABLE)',BLACK,1)
    cv.save('results/score_diagnostics.png')
    print('figures written')
