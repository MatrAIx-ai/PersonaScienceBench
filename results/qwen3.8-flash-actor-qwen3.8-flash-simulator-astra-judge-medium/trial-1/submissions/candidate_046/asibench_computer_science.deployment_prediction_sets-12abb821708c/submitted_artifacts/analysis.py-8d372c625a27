class Canvas:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.buf = np.full((h, w, 3), 255, np.uint8)
    def px(self, x, y, c):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.w and 0 <= y < self.h:
            self.buf[y, x] = c
    def line(self, x0, y0, x1, y1, c, width=1):
        x0, y0, x1, y1 = map(float, (x0, y0, x1, y1))
        n = int(max(abs(x1-x0), abs(y1-y0))) + 1
        for t in np.linspace(0, 1, n):
            x, y = x0+(x1-x0)*t, y0+(y1-y0)*t
            for dx in range(width):
                for dy in range(width):
                    self.px(x+dx, y+dy, c)
    def rect(self, x0, y0, x1, y1, c):
        x0, x1 = sorted((int(x0), int(x1))); y0, y1 = sorted((int(y0), int(y1)))
        self.buf[y0:y1+1, x0:x1+1] = c
    def text(self, x, y, s, c=(0,0,0), scale=2):
        s = str(s).upper(); cx = x
        for ch in s:
            m = FONT.get(ch, FONT[' '])
            for i in range(5):
                col = int(m[i*2:i*2+2], 16)
                for r in range(8):
                    if col >> r & 1:
                        self.rect(cx+i*scale, y+r*scale, cx+i*scale+scale-1,
                                  y+r*scale+scale-1, c)
            cx += 6*scale
    def save(self, path):
        raw = b''.join(b'\x00' + self.buf[y].tobytes() for y in range(self.h))
        def chunk(t, d):
            return struct.pack('>I', len(d)) + t + d + struct.pack(
                '>I', zlib.crc32(t + d) & 0xffffffff)
        png = (b'\x89PNG\r\n\x1a\n' +
               chunk(b'IHDR', struct.pack('>IIBBBBB', self.w, self.h, 8, 2, 0, 0, 0)) +
               chunk(b'IDAT', zlib.compress(raw, 9)) + chunk(b'IEND', b''))
        open(path, 'wb').write(png)

