#!/usr/bin/env python3
"""Config tuning: (T, eps, flip_mode) -> surrogate expansions on holdout.
Selection: solve-rate 100% first, then minimize mean+max expansions.
Model/weights untouched: trained once on train split, config varies only."""
import json, math, random, heapq
import analysis
from analysis import ACTIONS, DELTA, Policy, _is_open

TR = json.load(open("data/training_levels.json"))
rng = random.Random(0)
ids = [lv["id"] for lv in TR["levels"]]; rng.shuffle(ids)
hold_ids = set(ids[:52])
train_lv = [lv for lv in TR["levels"] if lv["id"] not in hold_ids]
hold_lv  = [lv for lv in TR["levels"] if lv["id"] in hold_ids]
base = analysis.make_policy({"levels": train_lv})   # weights fixed here

def surprise_search(lv, p, metafn, budget=5000):
    g = lv["grid"]; start = tuple(lv["start"]); goal = tuple(lv["goal"])
    open_ = [(0.0, 0, start, None, ())]
    seen = {(start, None): 0.0}; ctr = 0; exp = 0
    while open_:
        cost, _, pos, prev, hist = heapq.heappop(open_)
        if pos == goal: return True, exp
        exp += 1
        if exp > budget: return False, exp
        r, c = pos
        nb = {d: g[r+DELTA[d][0]][c+DELTA[d][1]] for d in ACTIONS}
        legal = [d for d in ACTIONS if _is_open(nb[d])]
        st = {"cell": g[r][c], "neighbors": nb, "previous_action": prev,
              "history": list(hist), "depth": len(hist), "legal_actions": legal}
        pr = p.action_probs(metafn(lv), st, legal)
        for a in legal:
            np_ = (r+DELTA[a][0], c+DELTA[a][1])
            nc = cost - math.log(max(pr[a], 1e-6)); key = (np_, a)
            if key not in seen or nc < seen[key] - 1e-12:
                seen[key] = nc; ctr += 1
                heapq.heappush(open_, (nc, ctr, np_, a, hist + (a,)))
    return False, exp

def pref_dfs(lv, p, metafn, budget=5000):
    g = lv["grid"]; exp = 0; seen = set()
    stack = [(tuple(lv["start"]), None, ())]
    while stack:
        (r, c), prev, hist = stack.pop()
        if ((r, c), prev) in seen: continue
        seen.add(((r, c), prev))
        if (r, c) == tuple(lv["goal"]): return True, exp
        exp += 1
        if exp > budget: return False, exp
        nb = {d: g[r+DELTA[d][0]][c+DELTA[d][1]] for d in ACTIONS}
        legal = [d for d in ACTIONS if _is_open(nb[d])]
        st = {"cell": g[r][c], "neighbors": nb, "previous_action": prev,
              "history": list(hist), "depth": len(hist), "legal_actions": legal}
        pr = p.action_probs(metafn(lv), st, legal)
        for a in sorted(legal, key=lambda a: -pr[a]):
            stack.append(((r+DELTA[a][0], c+DELTA[a][1]), a, hist + (a,)))
    return False, exp

def greedy(lv, p, metafn):
    g = lv["grid"]; r, c = lv["start"]; goal = tuple(lv["goal"])
    prev = None; hist = []; steps = 0
    while steps < 4 * lv["max_depth"]:
        nb = {d: g[r+DELTA[d][0]][c+DELTA[d][1]] for d in ACTIONS}
        legal = [d for d in ACTIONS if _is_open(nb[d])]
        st = {"cell": g[r][c], "neighbors": nb, "previous_action": prev,
              "history": list(hist), "depth": steps, "legal_actions": legal}
        pr = p.action_probs(metafn(lv), st, legal)
        a = max(pr, key=pr.get)
        r += DELTA[a][0]; c += DELTA[a][1]; hist.append(a); prev = a; steps += 1
        if (r, c) == goal: return True, steps
    return False, steps

META_START = lambda lv: {"id": lv["id"], "start": lv["start"]}
META_STRICT = lambda lv: {"id": lv["id"]}

def stats(res):
    found = sum(f for f, _ in res); ex = sorted(e for f, e in res if f)
    n = max(len(ex), 1)
    return found, sum(ex)/n, ex[len(ex)//2] if ex else -1, ex[-1] if ex else -1

rows = []
print(f"{'T':>5} {'eps':>5} {'flip':>15} | bf-start: fnd mean med max | "
      f"bf-strict: fnd mean med max | DFS mean max", flush=True)
for T in (0.15, 0.25, 0.35, 0.5):
    for eps in (0.0, 0.02, 0.05):
        for fm in ("current_revisit", "sticky_revisit"):
            p = Policy(base.weights, dict(base.config))
            p.config.update({"temperature": T, "eps_floor": eps, "flip_mode": fm})
            bs = stats([surprise_search(lv, p, META_START) for lv in hold_lv])
            bt = stats([surprise_search(lv, p, META_STRICT) for lv in hold_lv])
            df = stats([pref_dfs(lv, p, META_START) for lv in hold_lv])
            rows.append((T, eps, fm, bs, bt, df))
            print(f"{T:>5} {eps:>5} {fm:>15} | {bs[0]:>3}/52 {bs[1]:6.1f} {bs[2]:4} {bs[3]:4} | "
                  f"{bt[0]:>3}/52 {bt[1]:6.1f} {bt[2]:4} {bt[3]:4} | {df[1]:7.1f} {df[3]:5}", flush=True)

ok = [r for r in rows if r[3][0] == 52 and r[4][0] == 52]
ok.sort(key=lambda r: r[3][1] + r[3][3])
print("\nTop-5 by mean+max (best-first with start; solve-rate 52/52 required):")
for r in ok[:5]:
    print(f"  T={r[0]} eps={r[1]} flip={r[2]}: bf mean={r[3][1]:.1f} med={r[3][2]} "
          f"max={r[3][3]} | DFS mean={r[5][1]:.1f} max={r[5][3]}")
w = ok[0]
print(f"\nWINNER: T={w[0]} eps={w[1]} flip_mode={w[2]}")
p = Policy(base.weights, dict(base.config))
p.config.update({"temperature": w[0], "eps_floor": w[1], "flip_mode": w[2]})
gr = stats([greedy(lv, p, META_START) for lv in hold_lv])
print(f"winner greedy(start): {gr[0]}/52 (mean steps {gr[1]:.1f})")
