#!/usr/bin/env python3
"""Validation harness for analysis.py (train-split fit, level-holdout eval).

Public eval levels are used ONLY as smoke tests (never trained on).
"""
import json, math, random, time
import analysis
from analysis import ACTIONS, DELTA, LEFT_OF, RIGHT_OF, OPP, _is_open

TR = json.load(open("data/training_levels.json"))
EV = json.load(open("data/public_eval_levels.json"))

rng = random.Random(0)
ids = [lv["id"] for lv in TR["levels"]]
rng.shuffle(ids)
hold_ids = set(ids[: max(1, len(ids) // 5)])          # ~52 held-out levels
train_lv = [lv for lv in TR["levels"] if lv["id"] not in hold_ids]
hold_lv = [lv for lv in TR["levels"] if lv["id"] in hold_ids]
print(f"split: train={len(train_lv)} holdout={len(hold_lv)} "
      f"(public eval levels never used for training)")

t0 = time.time()
pol = analysis.make_policy({"levels": train_lv})
print(f"make_policy(train split) took {time.time()-t0:.2f}s")

# ---------------------------------------------------------------- weight audit
CORE = ("bias", "straight", "reverse", "relleft", "relright")
print("\n== weight audit ==")
for n in CORE:
    print(f"  {n:<12}", {a: round(pol.weights[n][a], 3) for a in ACTIONS})
for n in sorted(set(pol.weights) - set(CORE)):
    mx = max(abs(v) for v in pol.weights[n].values())
    print(f"  extra {n:<14} max|w|={mx:.4f}")

# ------------------------------------------------------- teacher-forced states
def states_for(lv):
    g, sol = lv["grid"], lv["solution"]
    r, c = lv["start"]; prev = None; hist = []
    out = []
    for a in sol:
        nb = {d: g[r + DELTA[d][0]][c + DELTA[d][1]] for d in ACTIONS}
        legal = [d for d in ACTIONS if _is_open(nb[d])]
        st = {"cell": g[r][c], "neighbors": nb, "previous_action": prev,
              "history": list(hist), "depth": len(hist), "legal_mask":
              {d: _is_open(nb[d]) for d in ACTIONS}, "legal_actions": legal}
        out.append((st, legal, a))
        hist.append(a); prev = a
        r += DELTA[a][0]; c += DELTA[a][1]
    return out

def nll(probs, gold):
    return -math.log(max(probs.get(gold, 1e-12), 1e-12))

hold_states = [s for lv in hold_lv for s in states_for(lv)]
print(f"\n== holdout teacher-forced steps: {len(hold_states)} ==")

# -------------------------------------------------- temperature / eps tuning
print("\n== (temperature, eps_floor) grid on holdout NLL ==")
best = None
base = analysis.make_policy({"levels": train_lv})
def policy_with(T, eps, **kw):
    p = analysis.Policy(base.weights, dict(base.config))
    p.config.update({"temperature": T, "eps_floor": eps, **kw})
    return p
for T in (0.15, 0.25, 0.35, 0.5, 0.7, 1.0):
    for eps in (0.0, 0.02, 0.05):
        p2 = policy_with(T, eps)
        tot = acc = 0.0
        for st, legal, gold in hold_states:
            pr = p2.action_probs({"id": "x"}, st, legal)
            tot += nll(pr, gold)
            acc += (max(pr, key=pr.get) == gold)
        n = len(hold_states)
        print(f"  T={T:<4} eps={eps:<5} NLL={tot/n:.4f} top1={acc/n:.4f}")
        if best is None or tot/n < best[0]:
            best = (tot/n, T, eps)
print("best (NLL,T,eps):", best)

# final policy at default config for remaining metrics
T_FIN, E_FIN = base.config['temperature'], base.config['eps_floor']  # expansion-selected defaults
pol = analysis.make_policy({"levels": train_lv},
                           {"temperature": T_FIN, "eps_floor": E_FIN})

# top-1 accuracy with final config (anti-loop ON, strict level w/o start)
_c = 0
for i, (st, legal, gold) in enumerate(hold_states):
    pr = pol.action_probs({"id": hold_lv[min(i, len(hold_lv)-1)]["id"]}, st, legal)
    _c += (max(pr, key=pr.get) == gold)
acc = _c / len(hold_states)
print(f"\ntop-1 accuracy (final config, strict level meta): {acc:.4f}")

# breakdown by regime
reg = {"first": [0, 0], "straight": [0, 0], "forced_turn": [0, 0], "free_turn": [0, 0]}
for lv in hold_lv:
    for st, legal, gold in states_for(lv):
        prev = st["previous_action"]
        if prev is None:
            k = "first"
        elif prev in legal:
            k = "straight"
        elif len([a for a in (LEFT_OF[prev], RIGHT_OF[prev]) if a in legal]) == 2:
            k = "free_turn"
        else:
            k = "forced_turn"
        pr = pol.action_probs({"id": lv["id"]}, st, legal)
        reg[k][0] += (max(pr, key=pr.get) == gold); reg[k][1] += 1
for k, (c, n) in reg.items():
    print(f"  regime {k:<11} acc={c/max(n,1):.4f} n={n}")

# ------------------------------------------------------- probability regimes
print("\n== probability profiles (final config) ==")
def profile(st, legal, level):
    return {a: round(p, 3) for a, p in pol.action_probs(level, st, legal).items()}
for want in ("straight", "forced_turn", "free_turn"):
    for lv in hold_lv:
        found = False
        for st, legal, gold in states_for(lv):
            prev = st["previous_action"]
            if prev is None: continue
            k = ("straight" if prev in legal else
                 "free_turn" if all(a in legal for a in (LEFT_OF[prev], RIGHT_OF[prev]))
                 else "forced_turn")
            if k == want:
                print(f"  {want:<11} prev={prev} legal={legal} -> {profile(st, legal, {'id': lv['id']})}")
                found = True; break
        if found: break

# ------------------------------------------------------------ greedy rollouts
def rollout(lv, level_meta, p):
    g = lv["grid"]; r, c = lv["start"]; goal = tuple(lv["goal"])
    prev = None; hist = []; steps = 0
    cap = 4 * lv["max_depth"]
    while steps < cap:
        nb = {d: g[r + DELTA[d][0]][c + DELTA[d][1]] for d in ACTIONS}
        legal = [d for d in ACTIONS if _is_open(nb[d])]
        st = {"cell": g[r][c], "neighbors": nb, "previous_action": prev,
              "history": list(hist), "depth": steps, "legal_actions": legal}
        pr = p.action_probs(level_meta, st, legal)
        a = max(pr, key=pr.get)
        r += DELTA[a][0]; c += DELTA[a][1]
        hist.append(a); prev = a; steps += 1
        if (r, c) == goal:
            return steps, True
    return steps, False

print("\n== greedy rollouts on holdout levels (argmax policy) ==")
for name, metafn, p in [
    ("strict (no start in level, anti-loop inactive)",
     lambda lv: {"id": lv["id"], "max_depth": lv["max_depth"]}, policy_with(T_FIN, E_FIN)),
    ("level exposes start (anti-loop active)",
     lambda lv: {"id": lv["id"], "start": lv["start"]}, policy_with(T_FIN, E_FIN)),
    ("anti-loop disabled even with start (ablation)",
     lambda lv: {"id": lv["id"], "start": lv["start"]}, policy_with(T_FIN, E_FIN, anti_loop=False)),
]:
    res = [rollout(lv, metafn(lv), p) for lv in hold_lv]
    succ = sum(ok for _, ok in res)
    lens = [s for s, ok in res if ok]
    sol_len = [len(lv["solution"]) for lv, (s, ok) in zip(hold_lv, res) if ok]
    print(f"  {name}: solved {succ}/{len(hold_lv)}  "
          f"mean steps={sum(lens)/max(len(lens),1):.1f} "
          f"(mean trained sol len={sum(sol_len)/max(len(sol_len),1):.1f}) "
          f"max steps={max(lens) if lens else '-'}")

# ----------------------------------------------------- public eval smoke test
print("\n== public eval smoke test (NOT trained on) ==")
p_ev = analysis.make_policy(TR)   # full training set for the smoke policy
for lv in EV["levels"]:
    for meta in ({"id": lv["id"]}, {"id": lv["id"], "start": lv["start"]}):
        s, ok = rollout(lv, meta, p_ev)
        print(f"  {lv['id']} start_in_level={'start' in meta}: "
              f"solved={ok} steps={s} budget={EV['budget']} max_depth={lv['max_depth']}")


# ------------------- probability-guided best-first (surprise) search ---------
import heapq
def guided_search(lv, level_meta, p, budget=2000):
    """Scorer-like stand-in: best-first over states (pos, prev) with
    cumulative surprise cost sum(-log p). Returns (found, expansions)."""
    g = lv["grid"]; start = tuple(lv["start"]); goal = tuple(lv["goal"])
    def nbr_chars(r, c):
        return {d: g[r + DELTA[d][0]][c + DELTA[d][1]] for d in ACTIONS}
    # node: (cost, tie, pos, prev, history, path)
    h0 = 0.0
    counter = 0
    open_ = [(0.0, 0, start, None, ())]
    seen = {(start, None): 0.0}
    expansions = 0
    while open_:
        cost, _, pos, prev, hist = heapq.heappop(open_)
        if (pos, prev) in seen and cost > seen[(pos, prev)] + 1e-12:
            continue
        if pos == goal:
            return True, expansions
        expansions += 1
        if expansions > budget:
            return False, expansions
        r, c = pos
        nb = nbr_chars(r, c)
        legal = [d for d in ACTIONS if _is_open(nb[d])]
        st = {"cell": g[r][c], "neighbors": nb, "previous_action": prev,
              "history": list(hist), "depth": len(hist),
              "legal_actions": legal}
        pr = p.action_probs(level_meta, st, legal)
        for a in legal:
            np_ = (r + DELTA[a][0], c + DELTA[a][1])
            ncost = cost - math.log(max(pr[a], 1e-6))
            key = (np_, a)
            if key not in seen or ncost < seen[key] - 1e-12:
                seen[key] = ncost
                counter += 1
                heapq.heappush(open_, (ncost, counter, np_, a, hist + (a,)))
    return False, expansions

print("\n== probability-guided best-first (surprise) search, holdout ==")
for name, metafn in [
    ("strict (level meta w/o start)", lambda lv: {"id": lv["id"]}),
    ("level exposes start (anti-loop)", lambda lv: {"id": lv["id"], "start": lv["start"]}),
]:
    res = [guided_search(lv, metafn(lv), pol, budget=5000) for lv in hold_lv]
    found = sum(f for f, _ in res)
    ex = [e for f, e in res if f]
    le = [len(lv["solution"]) for lv, (f, _) in zip(hold_lv, res) if f]
    print(f"  {name}: found {found}/{len(hold_lv)}  "
          f"mean expansions={sum(ex)/max(len(ex),1):.1f} "
          f"median={sorted(ex)[len(ex)//2] if ex else '-'} "
          f"max={max(ex) if ex else '-'}  (mean sol len={sum(le)/max(len(le),1):.1f})")
print("  public eval (smoke, surprise search):")
for lv in EV["levels"]:
    for meta in ({"id": lv["id"]}, {"id": lv["id"], "start": lv["start"]}):
        f_, e_ = guided_search(lv, meta, p_ev, budget=5000)
        print(f"    {lv['id']} start_in_level={'start' in meta}: found={f_} expansions={e_}")



# ---------------- policy-preference DFS (second search surrogate) ------------
def pref_dfs(lv, level_meta, p, budget=5000):
    """DFS exploring children in decreasing policy probability, with
    (pos, prev) transposition table. Returns (found, expansions)."""
    g = lv["grid"]; start = tuple(lv["start"]); goal = tuple(lv["goal"])
    expansions = 0
    seen = set()
    def expand(pos, prev, hist):
        nonlocal expansions
        stack = [(pos, prev, hist)]
        while stack:
            pos, prev, hist = stack.pop()
            key = (pos, prev)
            if key in seen:
                continue
            seen.add(key)
            if pos == goal:
                return True, expansions
            expansions += 1
            if expansions > budget:
                return False, expansions
            r, c = pos
            nb = {d: g[r + DELTA[d][0]][c + DELTA[d][1]] for d in ACTIONS}
            legal = [d for d in ACTIONS if _is_open(nb[d])]
            st = {"cell": g[r][c], "neighbors": nb, "previous_action": prev,
                  "history": list(hist), "depth": len(hist),
                  "legal_actions": legal}
            pr = p.action_probs(level_meta, st, legal)
            kids = sorted(legal, key=lambda a: -pr[a])
            for a in kids:
                stack.append(((r + DELTA[a][0], c + DELTA[a][1]), a,
                              hist + (a,)))
        return False, expansions
    return expand(start, None, ())

print("\n== policy-preference DFS surrogate ==")
for name, metafn in [
    ("strict (no start)", lambda lv: {"id": lv["id"]}),
    ("start in level (anti-loop)", lambda lv: {"id": lv["id"], "start": lv["start"]}),
]:
    res = [pref_dfs(lv, metafn(lv), pol) for lv in hold_lv]
    found = sum(f for f, _ in res); ex = sorted(e for f, e in res if f)
    print(f"  holdout {name}: found {found}/{len(hold_lv)} mean exp="
          f"{sum(ex)/max(len(ex),1):.1f} median={ex[len(ex)//2] if ex else '-'} "
          f"max={ex[-1] if ex else '-'}")
    res = [pref_dfs(lv, metafn(lv), p_ev) for lv in EV["levels"]]
    print("    public:", [(lv['id'], f_, e_) for lv, (f_, e_) in zip(EV['levels'], res)])


# ------------------------------------------------------------- robustness
print("\n== robustness / malformed-input tests ==")
def check(name, fn):
    try:
        out = fn()
        assert out is not None and abs(sum(out.values()) - 1) < 1e-6
        assert all(v >= 0 for v in out.values())
        print(f"  OK   {name}: { {k: round(v,3) for k,v in out.items()} }")
    except Exception as e:
        print(f"  FAIL {name}: {type(e).__name__}: {e}")

nb = {"U": "#", "D": "a", "L": "b", "R": "#"}
