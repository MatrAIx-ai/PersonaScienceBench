      lambda: pol.action_probs({}, {"neighbors": nb, "history": ["R","R","D"],
              "legal_mask": lm_dict, "legal_actions": ["D","L"]}, ["D","L"]))
check("legal_mask as list",
      lambda: pol.action_probs({}, {"neighbors": nb, "previous_action": "D",
              "legal_mask": [False, True, True, False],
              "history": ["D"]}, None))
check("legal_mask as dict, no legal_actions arg",
      lambda: pol.action_probs({}, {"neighbors": nb, "previous_action": "D",
              "legal_mask": lm_dict, "history": ["D"]}, None))
check("empty history, no prev",
      lambda: pol.action_probs({}, {"neighbors": nb, "history": []}, ["U","D","L","R"]))
check("no fields at all",
      lambda: pol.action_probs({}, {}, None))
check("history with non-action junk + str history",
