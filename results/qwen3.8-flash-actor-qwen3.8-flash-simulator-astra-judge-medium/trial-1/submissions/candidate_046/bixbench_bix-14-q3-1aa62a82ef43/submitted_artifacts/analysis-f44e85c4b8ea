#!/usr/bin/env python3
"""
CHIP non-reference exonic variant count across the 86 sample workbooks.

Fixed rules (researcher decisions):
 1. PANEL  : Schenz et al. 2022 list, 56 genes, xlsx read with header=None;
             exact token match on Gene Names after re.split(r'[,;]') + strip.
             In_CHIP / Match.1 columns are NOT used.
 2. UNIT   : sample x variant, deduplicated on (sample, Chr:Pos, Ref/Alt).
             Secondary metric: globally unique variants.
 3. NON-REF: Zygosity in {Heterozygous, Homozygous Variant}. Empty Zygosity
             (no called genotype) is excluded; VAF is not used.
 4. EXONIC : exclusion list -> drop {intron_variant, 3_prime_UTR_variant,
             5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant,
             upstream_gene_variant}; keep everything else incl. splice_region_variant.
             Sensitivity: additionally drop splice_region_variant.
Quality filters (DP>=10, GQ>=20, PASS) are already applied upstream and verified.
"""
import os, re
import pandas as pd

DATA   = 'data/CHIP_DP10_GQ20_PASS'
PANEL  = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
TRIO   = 'data/230215_Trio_Status.xlsx'
NONREF = {'Heterozygous', 'Homozygous Variant'}
DROP_SO = {'intron_variant', '3_prime_UTR_variant', '5_prime_UTR_variant',
           '5_prime_UTR_premature_start_codon_gain_variant', 'upstream_gene_variant'}

# ---------- panel ----------
panel = {str(g).strip() for g in pd.read_excel(PANEL, header=None)[0] if str(g).strip()}

# ---------- load books ----------
frames = []
for f in sorted(os.listdir(DATA)):
    if not f.endswith('.xlsx'):
        continue
    df = pd.read_excel(os.path.join(DATA, f), sheet_name=0, header=1).dropna(how='all')
    df['sample'] = f.replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
    frames.append(df)
A = pd.concat(frames, ignore_index=True)
A['key'] = A['Chr:Pos'].astype(str) + '|' + A['Ref/Alt'].astype(str)
A['so']  = A['Sequence Ontology (Combined)'].astype(str).str.strip()

tokens = lambda v: [t.strip() for t in re.split(r'[,;]', str(v))]
A['panel_hit'] = A['Gene Names'].apply(lambda v: any(t in panel for t in tokens(v)))
A['nonref']    = A['Zygosity'].astype(str).isin(NONREF)

# ---------- sanity of pre-applied QC ----------
dp = pd.to_numeric(A['Read Depths (DP)'], errors='coerce')
gq = pd.to_numeric(A['Genotype Qualities (GQ)'], errors='coerce')

# ---------- funnel ----------
s1 = A
s2 = A[A['nonref']]
s3 = s2[s2['panel_hit']]
s4 = s3[~s3['so'].isin(DROP_SO)]
primary      = s4.drop_duplicates(['sample', 'key'])
s4_sens      = s3[~s3['so'].isin(DROP_SO | {'splice_region_variant'})]
sens         = s4_sens.drop_duplicates(['sample', 'key'])

print('=' * 78)
print('SANITY CHECKS')
print(f'  books (samples) loaded            : {A['sample'].nunique()}')
print(f'  unique sample ids                 : {A["sample"].nunique()}')
print(f'  columns per book (raw)                : {len([c for c in A.columns if c not in ("sample","key","so","panel_hit","nonref")])} (header row = row 2; identical in all 86)')
print(f'  panel genes used                      : {len(panel)}')
print(f'  Filter values                     : {A["Filter"].astype(str).value_counts().to_dict()}')
print(f'  DP min / max                      : {dp.min():.0f} / {dp.max():.0f}   (DP>=10 pre-applied)')
print(f'  GQ min / max                      : {gq.min():.0f} / {gq.max():.0f}   (GQ>=20 pre-applied)')
print(f'  In_CHIP values                    : {A["In_CHIP"].astype(str).value_counts().to_dict()}  (not used)')
t = pd.read_excel(TRIO)
t['Sample ID'] = t['Sample ID'].astype(str).str.strip()
print(f'  Trio Status rows                  : {len(t)} ; sample ids missing a book: '
      f'{sorted(set(t["Sample ID"]) - {s.split("-")[0] for s in A["sample"] if not s.startswith("SRR")} - set(A["sample"]))}')

print('=' * 78)
print('FUNNEL')
rows = [
    ('all rows in 86 books', len(s1)),
    ('non-reference (Zygosity het/hom-alt)', len(s2)),
    ('  + panel (Schenz 56, exact token)', len(s3)),
    ('  + region (drop intron/UTR/upstream)', len(s4)),
    ('  + dedup (sample, Chr:Pos, Ref/Alt)  = PRIMARY', len(primary)),
]
for lab, n in rows:
    print(f'  {lab:<52s}{n:>7d}')
dupA = int(s1.duplicated(['sample','key']).sum())
dup2 = int(s2.duplicated(['sample','key']).sum())
dup3 = int(s3.duplicated(['sample','key']).sum())
dup4 = len(s4) - len(primary)
print(f'  intra-sample duplicate rows (sample,Chr:Pos,Ref/Alt): raw {dupA} | nonref {dup2} | nonref+panel {dup3} | surviving to region step {dup4} (removed by dedup)')
print(f'  secondary: globally unique variants (primary set): {primary['key'].nunique()}')
print(f'  sensitivity: excluding splice_region_variant      : {len(sens)}  (delta {len(sens)-len(primary):+d}; '
      f'unique variants {sens['key'].nunique()})')

print('=' * 78)
print('DISCARDED BY REGION  (non-reference & panel rows, by Sequence Ontology)')
disc = s3[s3['so'].isin(DROP_SO)]
tab = pd.crosstab(s3['so'], s3.index.isin(s4.index), rownames=['sequence_ontology'],
                  colnames=['kept'])
tab.columns = ['dropped', 'kept'] if list(tab.columns) == [False, True] else tab.columns
tab = pd.DataFrame({'dropped': disc['so'].value_counts(),
                    'kept': s4['so'].value_counts()}).fillna(0).astype(int)
tab['is_exonic'] = [n not in DROP_SO for n in tab.index]
print(tab.sort_values('dropped', ascending=False).to_string())
print(f'  total dropped by region: {int(tab.dropped.sum())}')

print('=' * 78)
print('PER-SAMPLE TABLE (86 rows)')
per = pd.DataFrame({
    'rows':        s1.groupby('sample').size(),
    'nonref':      s2.groupby('sample').size(),
    'nonref_panel':s3.groupby('sample').size(),
    'exonic':      primary.groupby('sample').size(),
}).fillna(0).astype(int)
per['empty_genotype_rows'] = A[A['Zygosity'].isna()].groupby('sample').size().reindex(per.index).fillna(0).astype(int)
per.index.name = 'sample'
print(per.to_string())
print('-' * 78)
print(f'  samples with >=1 exonic variant : {int((per.exonic > 0).sum())} / {len(per)}')
print(f'  sum of per-sample exonic        : {int(per.exonic.sum())}  (== PRIMARY {len(primary)})')
print(f'  rows lost to empty Zygosity     : {int(per.empty_genotype_rows.sum())} '
      f'(380-P {int(per.loc["380-P","empty_genotype_rows"])}, 381-PM {int(per.loc["381-PM","empty_genotype_rows"])})')
per.to_csv('per_sample_table.csv')

# ---------- independent cross-check (openpyxl raw read, no pandas concat) ----------
def cross_check():
    from openpyxl import load_workbook
    prim, sens2, nraw = set(), set(), 0
    for f in sorted(os.listdir(DATA)):
        if not f.endswith('.xlsx'):
            continue
        wb = load_workbook(os.path.join(DATA, f), read_only=True)
        ws = wb[wb.sheetnames[0]]
        ws.reset_dimensions()
        rows = list(ws.values)
        hdr = [str(x).strip() if x is not None else '' for x in rows[1]]
        W = len(hdr)
        i = {c: hdr.index(c) for c in ('Zygosity', 'Gene Names',
                                       'Sequence Ontology (Combined)', 'Chr:Pos', 'Ref/Alt')}
        samp = f.replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
        for r in rows[2:]:
            r = tuple(r) + (None,) * (W - len(r))
            if r[i['Chr:Pos']] is None:
                continue
            nraw += 1
            if r[i['Zygosity']] not in NONREF:
                continue
            if not any(t.strip() in panel for t in re.split(r'[,;]', str(r[i['Gene Names']] or ''))):
                continue
            so = str(r[i['Sequence Ontology (Combined)']]).strip()
            if so in DROP_SO:
                continue
            prim.add((samp, r[i['Chr:Pos']], r[i['Ref/Alt']]))
            if so != 'splice_region_variant':
                sens2.add((samp, r[i['Chr:Pos']], r[i['Ref/Alt']]))
    return nraw, len(prim), len(sens2)

nraw2, prim2, sens2b = cross_check()
print('=' * 78)
print('INDEPENDENT CROSS-CHECK (openpyxl raw read, different code path)')
print(f'  raw rows {nraw2} (expect {len(A)}) | primary {prim2} (expect {len(primary)}) | '
      f'sensitivity {sens2b} (expect {len(sens)})')
assert (nraw2, prim2, sens2b) == (len(A), len(primary), len(sens)), 'cross-check mismatch'
print('  -> agrees')

print('=' * 78)
print(f'ANSWER: {len(primary)}')
