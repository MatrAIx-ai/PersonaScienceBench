"""
bix-16-q2: Skewness of the gene expression (log2(TPM+1), batch-corrected)
distribution across all cell lines in the DepMap capsule.

Primary metric : scipy.stats.skew(bias=False) of the 19,138 genes WITHIN each
                 cell line (row-wise, n=19,138), aggregated across 1,673 lines.
Variants       : bias=True row-wise; pooled skew of all ~32M values;
                 per-gene skew across cell lines (control);
                 sensitivity: exclude non-expressed genes (median <= 0).
Assumptions    : matrix is batch-corrected (min=-2.62, 11.1% negatives, 0 exact
                 zeros) -> lower bound at 0 of raw log2(TPM+1) no longer applies,
                 sign is NOT assumed a priori. CRISPRGeneEffect.csv not used.
"""
import json, time
import numpy as np
import pandas as pd
from scipy import stats

T0 = time.time()
EXPR = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"

expr = pd.read_csv(EXPR, index_col=0)
V = expr.to_numpy(dtype=np.float64, copy=False)
n_lines, n_genes = V.shape
assert n_lines == 1673 and n_genes == 19138
assert np.isnan(V).sum() == 0, "unexpected NaNs"

# ---------- 1) Primary: per-cell-line skew (genes within each row) ----------
skew_line_unadj = stats.skew(V, axis=1, bias=True)     # g1
skew_line_adj   = stats.skew(V, axis=1, bias=False)    # G1 (primary; == pandas .skew)

def summarize(x):
    return {
        "mean": float(np.mean(x)), "sd": float(np.std(x, ddof=1)),
        "min": float(np.min(x)), "p05": float(np.percentile(x, 5)),
        "median": float(np.median(x)), "p95": float(np.percentile(x, 95)),
        "max": float(np.max(x)),
        "pct_positive_skew": float(np.mean(x > 0) * 100),
    }

res_line_adj = summarize(skew_line_adj)
res_line_unadj = summarize(skew_line_unadj)

# ---------- 2) Pooled skew over all cells (~32M values) ----------
skew_pooled_unadj = float(stats.skew(V.ravel(), bias=True))
skew_pooled_adj = float(stats.skew(V.ravel(), bias=False))

# ---------- 3) Control: per-gene skew across cell lines (n=1673 per gene) ----
skew_gene = stats.skew(V, axis=0, bias=False)
res_gene = summarize(skew_gene)

# ---------- 4) Sensitivity: drop non-expressed genes (median <= 0) ----------
gene_median = np.median(V, axis=0)
keep = gene_median > 0
V_f = V[:, keep]
skew_line_filtered = stats.skew(V_f, axis=1, bias=False)
res_line_filtered = summarize(skew_line_filtered)

# ---------- 5) Shape descriptors of a typical cell line (robustness) ---------
frac_le0 = float(np.mean(V <= 0))
frac_le1 = float(np.mean(V <= 1))
med_line = np.median(V, axis=1)
mean_line = V.mean(axis=1)
p99_line = np.percentile(V, 99, axis=1)
q1, q2, q3 = np.percentile(V, [25, 50, 75], axis=1)
with np.errstate(invalid="ignore", divide="ignore"):
    bowley_line = ((q3 - q2) - (q2 - q1)) / (q3 - q1)
bowley_mean = float(np.nanmean(bowley_line))
bowley_median = float(np.nanmedian(bowley_line))

# ---------- 6) Global sanity (batch-correction assumptions) -------------------
assumptions = {
    "matrix_is_batch_corrected": True,
    "global_min": float(np.min(V)),
    "global_max": float(np.max(V)),
    "pct_negative_values": float(np.mean(V < 0) * 100),
    "n_exact_zeros": int((V == 0).sum()),
    "note_zero_bound": ("Raw log2(TPM+1) is bounded at 0 with a pile-up of "
        "non-expressed genes, which usually pushes skew positive; after batch "
        "correction that bound no longer holds (min=-2.62, 11.1% negatives, "
        "0 exact zeros), so the sign of skew was NOT assumed a priori."),
    "crispr_gene_effect_used": False,
    "crispr_note": "CRISPRGeneEffect.csv (1178 lines x 17916 genes, different gene set) is irrelevant to this RNA-only question and was not used.",
    "nan_cells": 0, "no_gene_filter_in_primary": True,
    "primary_formula": "scipy.stats.skew(bias=False) (== pandas .skew); bias=True reported as variant; difference < 0.001 at n=19138",
}

out = {
    "question": "Skewness of gene expression (log2(TPM+1) batch-corrected) distribution across all cell lines",
    "shape": {"n_cell_lines": n_lines, "n_genes": n_genes},
    "primary_per_cell_line_skew_biasFalse": res_line_adj,
    "per_cell_line_skew_biasTrue_variant": res_line_unadj,
    "pooled_all_cells_skew": {"biasFalse": skew_pooled_adj, "biasTrue": skew_pooled_unadj},
    "control_per_gene_skew_biasFalse": res_gene,
    "sensitivity_drop_medianLE0_genes": {
        "genes_kept": int(keep.sum()), "genes_dropped": int((~keep).sum()),
        "per_cell_line_skew_biasFalse": res_line_filtered},
    "shape_of_typical_cell_line": {
        "pct_values_le_0": frac_le0 * 100, "pct_values_le_1": frac_le1 * 100,
        "median_of_line_medians": float(np.median(med_line)),
        "median_of_line_means": float(np.median(mean_line)),
        "median_line_mean_minus_median": float(np.median(mean_line - med_line)),
        "median_p99_minus_median": float(np.median(p99_line - med_line)),
        "bowley_skew_mean": bowley_mean, "bowley_skew_median": bowley_median},
    "assumptions": assumptions,
    "runtime_seconds": round(time.time() - T0, 1),
}

# ---------- 7) Figure: histogram + KDE of per-line skew (pure-python SVG) ----
def svg_hist(values, gene_vals, path, title):
    """Histogram + KDE of `values`, plus inset stats text. Pure python SVG."""
    W, H, ML, MB, MT, MR = 900, 420, 60, 50, 40, 20
    def panel(vals, x0, w, color, title_txt):
        lo, hi = min(vals.min(), 0) , max(vals.max(), 0)
        n_bins = 60
        counts, edges = np.histogram(vals, bins=n_bins, range=(lo, hi), density=True)
        centers = (edges[:-1] + edges[1:]) / 2
        kx = np.linspace(lo, hi, 400)
        kde = stats.gaussian_kde(vals)(kx)
        ymax = max(counts.max(), kde.max()) * 1.10
        def X(v): return x0 + (v - lo) / (hi - lo) * w
        def Y(v): return H - MB - v / ymax * (H - MB - MT)
        parts = [f'<text x="{x0}" y="24" font-size="14" font-family="sans-serif">{title_txt}</text>']
        for c, l, r in zip(counts, edges[:-1], edges[1:]):
            parts.append(f'<rect x="{X(l):.1f}" y="{Y(c):.1f}" width="{max(X(r)-X(l)-0.5,0.5):.1f}" height="{H-MB-Y(c):.1f}" fill="{color}" opacity="0.65"/>')
        pts = " ".join(f"{X(a):.1f},{Y(b):.1f}" for a, b in zip(kx, kde))
        parts.append(f'<polyline points="{pts}" fill="none" stroke="darkred" stroke-width="2"/>')
        parts.append(f'<line x1="{X(0):.1f}" y1="{MT}" x2="{X(0):.1f}" y2="{H-MB}" stroke="black" stroke-dasharray="3,3"/>')
        m = float(np.mean(vals)); md = float(np.median(vals))
        parts.append(f'<line x1="{X(m):.1f}" y1="{MT}" x2="{X(m):.1f}" y2="{H-MB}" stroke="green" stroke-dasharray="6,3" stroke-width="1.5"/>')
        parts.append(f'<text x="{X(m)+4:.1f}" y="{MT+14}" font-size="11" fill="green">mean={m:.3f}</text>')
        parts.append(f'<line x1="{X(md):.1f}" y1="{MT}" x2="{X(md):.1f}" y2="{H-MB}" stroke="orange" stroke-dasharray="6,3" stroke-width="1.5"/>')
        parts.append(f'<text x="{X(md)+4:.1f}" y="{MT+30}" font-size="11" fill="darkorange">median={md:.3f}</text>')
        for t in np.linspace(np.ceil(lo*5)/5, np.floor(hi*5)/5, int(np.floor(hi*5)-np.ceil(lo*5))+1):
            parts.append(f'<line x1="{X(t):.1f}" y1="{H-MB}" x2="{X(t):.1f}" y2="{H-MB+5}" stroke="black"/><text x="{X(t):.1f}" y="{H-MB+18}" font-size="10" text-anchor="middle">{t:.1f}</text>')
        parts.append(f'<line x1="{x0}" y1="{H-MB}" x2="{x0+w}" y2="{H-MB}" stroke="black"/>')
        return parts
    s = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}"><rect width="{W}" height="{H}" fill="white"/>']
    s += panel(values, ML, 380, "steelblue", "Per-cell-line skewness (n=1,673 lines)")
    s += panel(gene_vals, 520, 350, "seagreen", "Control: per-gene skewness")
    s.append(f'<text x="{W/2}" y="{H-8}" font-size="12" text-anchor="middle" font-family="sans-serif">{title}</text></svg>')
    open(path, "w").write("\n".join(s))

svg_hist(skew_line_adj, skew_gene, "analysis/skewness_summary.svg",
         "Left: histogram+KDE of per-cell-line skew (bias=False). Right: per-gene control. Dotted line = 0.")

with open("analysis/skewness_results.json", "w") as f:
    json.dump(out, f, indent=1)

print(json.dumps(out, indent=1))
print("saved: analysis/skewness_results.json, analysis/skewness_summary.png")
