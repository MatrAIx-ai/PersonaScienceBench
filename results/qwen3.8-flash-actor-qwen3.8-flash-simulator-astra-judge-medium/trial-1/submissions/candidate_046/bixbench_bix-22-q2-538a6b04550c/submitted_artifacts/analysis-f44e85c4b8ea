import pandas as pd
import numpy as np
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANN = "data/Sample_annotated_Zenodo.csv"

# 1) inputs
meta = pd.read_csv(META, index_col=0)
ann = pd.read_csv(ANN)
all_samples = list(pd.read_csv(COUNTS, nrows=0).columns[1:])

# 2) CD4 samples: annotation-driven (verified identical to name-contains-CD4)
cd4 = ann.loc[ann["celltype"] == "CD4", "sample"].tolist()
name_based = [c for c in all_samples if "CD4" in c]
assert set(cd4) == set(name_based), "CD4 criteria disagree"
cd4 = [c for c in all_samples if c in set(cd4)]  # keep matrix order
n_samples = len(cd4)

# 3) counts subset
cnt = pd.read_csv(COUNTS, index_col=0, usecols=[0] + [all_samples.index(s) + 1 for s in cd4])
assert cnt.index.equals(meta.index)
assert cnt.notna().all().all()

# 4) protein-coding genes
pc_mask = (meta["gene_biotype"] == "protein_coding").values
length = meta.loc[pc_mask, "Length"].astype(float).values
genes_pc = meta.index[pc_mask]
n_pc = int(pc_mask.sum())

# 5) mean expression per gene (raw batch-corrected counts) and CPM
sub = cnt.loc[genes_pc]
mean_raw = sub.mean(axis=1).values
lib = cnt.sum(axis=0).values.astype(float)
cpm = (sub / lib).values * 1e6
mean_cpm = cpm.mean(axis=1)
nonzero = mean_raw != 0

def pear(a, b):
    r, p = stats.pearsonr(a, b)
    return float(r), float(p)

r_main, p_main = pear(length, mean_raw)
rho_main, _ = stats.spearmanr(length, mean_raw)
rows = []
rows.append(("MAIN   raw counts, Length raw, all PC genes", n_pc, n_samples, r_main, p_main, rho_main))
rows.append(("sens   CPM mean, Length raw, all PC genes", n_pc, n_samples, *pear(length, mean_cpm), stats.spearmanr(length, mean_cpm)[0]))
rows.append(("sens   raw counts, log10(Length) vs log1p(mean)", n_pc, n_samples, *pear(np.log10(length), np.log1p(mean_raw)), stats.spearmanr(length, mean_raw)[0]))
rows.append(("sens   CPM mean, log10(Length) vs log1p(mean)", n_pc, n_samples, *pear(np.log10(length), np.log1p(mean_cpm)), stats.spearmanr(length, mean_cpm)[0]))
rows.append(("sens   raw counts, drop mean==0", int(nonzero.sum()), n_samples, *pear(length[nonzero], mean_raw[nonzero]), stats.spearmanr(length[nonzero], mean_raw[nonzero])[0]))
rows.append(("sens   CPM mean, drop mean==0", int(nonzero.sum()), n_samples, *pear(length[nonzero], mean_cpm[nonzero]), stats.spearmanr(length[nonzero], mean_cpm[nonzero])[0]))

tbl = pd.DataFrame(rows, columns=["variant", "n_genes", "n_samples", "pearson_r", "p_value", "spearman_rho"])
print("=== MAIN RESULT ===")
print("Pearson r =", r_main)
print("p-value   =", p_main)
print("parameters: n_genes =", n_pc, "(protein_coding, incl.", int((~nonzero).sum()), "with mean==0),",
      "n_samples =", n_samples, "(all CD4: _1/_2 and PB_CD4, all samtype/batch), scale = untransformed")
print()
print("library sizes across CD4 samples: median", int(np.median(lib)), "min", int(lib.min()), "max", int(lib.max()), "CV", round(float(lib.std() / lib.mean()), 3))
print("mean_raw: zeros", int((~nonzero).sum()), "of", n_pc)
print()
print("=== SENSITIVITY TABLE ===")
print(tbl.to_string(index=False, formatters={"pearson_r": "{:.6f}".format, "spearman_rho": "{:.6f}".format, "p_value": lambda v: format(v, ".3e")}))
tbl.to_csv("results/sensitivity_table.csv", index=False)
with open("results/main_answer.txt", "w") as f:
    f.write("pearson_r={0:.6f}\np_value={1:.3e}\nn_genes={2}\nn_samples={3}\nscale=untransformed raw batch-corrected counts\n".format(r_main, p_main, n_pc, n_samples))
print("\nMAIN_R_ONELINER", round(r_main, 6))
