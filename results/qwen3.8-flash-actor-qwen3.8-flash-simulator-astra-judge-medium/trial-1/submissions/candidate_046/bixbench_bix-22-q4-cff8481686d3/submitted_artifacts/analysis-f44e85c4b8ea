"""
FINAL ANALYSIS (bix-22-q4)
Pearson r between gene length and mean expression (across CD14 samples) for protein-coding genes.

Approved protocol (main/primary result):
  * counts = BatchCorrectedReadCounts_Zenodo.csv AS-IS (raw batch-corrected counts, no transform)
  * genes  = gene_biotype == 'protein_coding' (19,942)
  * samples= columns whose name is in Sample_annotated_Zenodo.csv where celltype=='CD14' (132);
             replicates (_1/_2) kept as separate columns; no filtering by batch/sex/samtype/chromosome
  * mean_expr = arithmetic mean across the 132 CD14 columns (untransformed)
  * x = Length as-is; genes with mean_expr == 0 are KEPT
  * correlation = scipy.stats.pearsonr
Alignment is done by GENE INDEX label (reindex), not by row position, even though row order also matches.
Sensitivity variants (a)(b)(c) are reported separately and do NOT replace the primary answer.
"""
import numpy as np
import pandas as pd
from scipy import stats

META = 'data/GeneMetaInfo_Zenodo.csv'
CNT  = 'data/BatchCorrectedReadCounts_Zenodo.csv'
ANN  = 'data/Sample_annotated_Zenodo.csv'

# ---------- load ----------
meta = pd.read_csv(META, index_col=0)
ann  = pd.read_csv(ANN)
with open(CNT) as fh:
    all_cols = fh.readline().rstrip('\n').split(',')[1:]

# ---------- CD14 sample selection via Sample_annotated celltype ----------
cd14_samples = ann.loc[ann['celltype'] == 'CD14', 'sample'].tolist()
assert len(cd14_samples) == len(set(cd14_samples))
missing = sorted(set(cd14_samples) - set(all_cols))
assert not missing, f"CD14 samples missing from count matrix: {missing[:5]}"
cd14_cols = [c for c in all_cols if c in set(cd14_samples)]   # keep file order
print(f"CD14 samples selected via celltype=='CD14': {len(cd14_cols)}")
print(f"  contains-'CD14' columns for cross-check: {sum('CD14' in c for c in all_cols)}"
      f" | identical sets: {set(cd14_cols) == {c for c in all_cols if 'CD14' in c}}")
print(f"  replicates kept separate (cols with '_' suffix): {sum('_' in c for c in cd14_cols)}")

# ---------- load only CD14 columns ----------
keep = set(cd14_cols) | {'Unnamed: 0'}
cnt = pd.read_csv(CNT, usecols=lambda c: c in keep, index_col=0)
print(f"count matrix (CD14 subset): {cnt.shape}")

# ---------- protein-coding genes ----------
pc_ids = meta.index[meta['gene_biotype'].to_numpy() == 'protein_coding']
print(f"protein_coding genes in metadata: {len(pc_ids)}")

# ---------- ALIGN BY GENE INDEX LABEL (not positional) ----------
cnt_pc = cnt.reindex(pc_ids)                       # label-based alignment
assert not cnt_pc.index.duplicated().any()
assert int(cnt_pc.isna().to_numpy().sum()) == 0, "NaN introduced by reindex -> gene name mismatch"
lengths = meta['Length'].reindex(pc_ids).to_numpy(dtype=np.float64)
expr    = cnt_pc.to_numpy(dtype=np.float64)
mean_expr = expr.mean(axis=1)

n_dup_ids = int(pc_ids.duplicated().sum())
print(f"aligned genes: {expr.shape[0]} | duplicate gene ids: {n_dup_ids}"
      f" | Length NaN: {int(np.isnan(lengths).sum())} | Length<=0: {int((lengths <= 0).sum())}")

# ---------- PRIMARY RESULT ----------
finite = np.isfinite(lengths) & np.isfinite(mean_expr)
print(f"\ngenes with finite (Length, mean_expr): {int(finite.sum())} of {len(pc_ids)}"
      f" | dropped for non-finite: {int((~finite).sum())}")
r, p = stats.pearsonr(lengths[finite], mean_expr[finite])
print("=" * 66)
print("PRIMARY ANSWER (mean==0 genes KEPT, untransformed counts)")
print(f"  Pearson r = {r:.6f}   (r^2 = {r**2:.6f})")
print(f"  p-value   = {p:.3e}")
print(f"  n genes   = {int(finite.sum())}")
print(f"  mean_expr: mean = {mean_expr.mean():.4f} | median = {np.median(mean_expr):.4f}"
      f" | min = {mean_expr.min():.4f} | max = {mean_expr.max():.1f}")
print(f"  Length   : mean = {lengths.mean():.1f} | median = {np.median(lengths):.1f}")
print("=" * 66)

# ---------- SENSITIVITY (annex only) ----------
nz = finite & (mean_expr > 0)
print("\nSENSITIVITY (annex; does NOT replace the primary answer)")
print(f"(a) exclude mean==0            : n={int(nz.sum()):5d}  r={stats.pearsonr(lengths[nz], mean_expr[nz])[0]: .6f}"
      f"  p={stats.pearsonr(lengths[nz], mean_expr[nz])[1]:.2e}")
lg = np.log1p(mean_expr)
print(f"(b) log1p(mean) incl. zeros    : n={int(finite.sum()):5d}  r={stats.pearsonr(lengths[finite], lg[finite])[0]: .6f}"
      f"  p={stats.pearsonr(lengths[finite], lg[finite])[1]: .2e}")
print(f"(c) log1p(mean) excl. zeros    : n={int(nz.sum()):5d}  r={stats.pearsonr(lengths[nz], lg[nz])[0]: .6f}"
      f"  p={stats.pearsonr(lengths[nz], lg[nz])[1]: .2e}")
print(f"    zeros among protein_coding : {int((finite & (mean_expr == 0)).sum())}"
      f" ({100*(finite & (mean_expr == 0)).sum()/finite.sum():.1f}%)")

# ---------- machine-readable result ----------
pd.DataFrame([
    dict(view='primary_mean_eq0_kept', n=int(finite.sum()), r=r, p=p,
         mean_expr_mean=mean_expr.mean(), mean_expr_median=float(np.median(mean_expr))),
    dict(view='sens_a_excl_zeros', n=int(nz.sum()), r=stats.pearsonr(lengths[nz], mean_expr[nz])[0],
         p=stats.pearsonr(lengths[nz], mean_expr[nz])[1], mean_expr_mean=float(mean_expr[nz].mean()),
         mean_expr_median=float(np.median(mean_expr[nz]))),
    dict(view='sens_b_log1p_incl_zeros', n=int(finite.sum()), r=stats.pearsonr(lengths[finite], lg[finite])[0],
         p=stats.pearsonr(lengths[finite], lg[finite])[1], mean_expr_mean=float(mean_expr.mean()),
         mean_expr_median=float(np.median(mean_expr))),
    dict(view='sens_c_log1p_excl_zeros', n=int(nz.sum()), r=stats.pearsonr(lengths[nz], lg[nz])[0],
         p=stats.pearsonr(lengths[nz], lg[nz])[1], mean_expr_mean=float(mean_expr[nz].mean()),
         mean_expr_median=float(np.median(mean_expr[nz]))),
]).to_csv('result_cd14_length_vs_expression.csv', index=False)
print("\nwrote result_cd14_length_vs_expression.csv")
print(f"\nFINAL ANSWER r = {r:.4f}")
