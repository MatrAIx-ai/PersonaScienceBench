"""INSPECTION ONLY (no final analysis): summarize structure of the three capsule inputs
for question bix-22-q4 (Pearson r between gene length and mean CD14 expression)."""
import pandas as pd, numpy as np

META='data/GeneMetaInfo_Zenodo.csv'; CNT='data/BatchCorrectedReadCounts_Zenodo.csv'; ANN='data/Sample_annotated_Zenodo.csv'
meta = pd.read_csv(META, index_col=0)
ann  = pd.read_csv(ANN)
with open(CNT) as f: cols = f.readline().rstrip('\n').split(',')[1:]

print("SIZES  meta:", meta.shape, "| annot:", ann.shape, "| counts: (%d genes x %d samples)" % (59453, len(cols)))
print("META cols:", list(meta.columns), "| dtypes:", dict(meta.dtypes.astype(str)))
print("ANN cols:", list(ann.columns))
print("Length: NaN=%d  <=0=%d  min=%d max=%d" % (meta.Length.isna().sum(), (meta.Length<=0).sum(), meta.Length.min(), meta.Length.max()))
print("Geneid: dup=%d  equals index=%s  | counts-genes == meta-genes: %s"
      % (meta.Geneid.duplicated().sum(), bool((meta.Geneid==meta.index).all()), len(cols)==723 and 59453==meta.shape[0]))
print("biotypes: n=%d, NaN=%d, protein_coding=%d" % (meta.gene_biotype.nunique(), meta.gene_biotype.isna().sum(),
      int((meta.gene_biotype=='protein_coding').sum())))
print("top biotypes:", meta.gene_biotype.value_counts().head(8).to_dict())

cd14_cont = [c for c in cols if 'CD14' in c]
cd14_end  = [c for c in cols if c.endswith('CD14')]
ann_cd14  = ann.loc[ann.celltype=='CD14','sample'].tolist()
print("\nCD14 columns (contains 'CD14'): %d | endswith 'CD14': %d | suffixed variants: %d"
      % (len(cd14_cont), len(cd14_end), len([c for c in cd14_cont if '_' in c])))
print("  suffixed examples:", [c for c in cd14_cont if '_' in c][:6])
print("annot celltype counts:", ann.celltype.value_counts().to_dict())
print("CD14 by annot celltype label: %d (unique %d)" % (len(ann_cd14), len(set(ann_cd14))))
print("exact-name agreement: cols&annot=%d | cols-only=%s | annot-only=%s"
      % (len(set(cd14_cont)&set(ann_cd14)), sorted(set(cd14_cont)-set(ann_cd14)), sorted(set(ann_cd14)-set(cd14_cont))))
print("all count cols in annot:", set(cols)==set(ann['sample']))
sub = ann[ann.celltype=='CD14']
print("CD14 batch:", sub.batch.value_counts().to_dict(), "| sex:", sub.sex.value_counts().to_dict(),
      "| samtype:", sub.samtype.value_counts().to_dict())

keep = set(cd14_cont) | {'Unnamed: 0'}
mat = pd.read_csv(CNT, usecols=lambda c: c in keep, index_col=0)
print("\nCD14 matrix:", mat.shape, "dtypes:", set(map(str, mat.dtypes)), "NaN=%d neg=%d" % (mat.isna().sum().sum(), (mat<0).sum().sum()))
print("row order identical to meta:", mat.index.equals(meta.index))
pc = (meta.gene_biotype.to_numpy()=='protein_coding')
mn = mat.to_numpy(dtype=np.float64)[pc].mean(axis=1)
L  = meta.Length.to_numpy(dtype=np.float64)[pc]
print("protein_coding analysed: %d | mean==0: %d (%.1f%%) | mean NaN: %d | Length NaN: %d"
      % (pc.sum(), int((mn==0).sum()), 100*(mn==0).mean(), int(np.isnan(mn).sum()), int(np.isnan(L).sum())))
print("(diagnostic only, NOT the reported answer) r_all_genes incl zeros =",
      round(float(np.corrcoef(L, mn)[0,1]), 6))
