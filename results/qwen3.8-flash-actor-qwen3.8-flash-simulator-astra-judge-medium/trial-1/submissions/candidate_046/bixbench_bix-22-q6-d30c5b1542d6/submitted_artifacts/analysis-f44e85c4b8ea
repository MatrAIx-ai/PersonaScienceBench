#!/usr/bin/env python3
"""BixBench bix-22-q6: Pearson correlation between gene length and gene
expression, protein-coding genes only.

PRIMARY (approved): r = pearsonr(Length, mean_raw_counts_over_723_samples)
on genes with gene_biotype == "protein_coding" (exact label match), n = 19942.
No normalisation, no log, no chromosome/batch/celltype/sex filtering, all-zero
genes kept. Sensitivity panel reported separately (never as a substitute).
"""
import json
import numpy as np
import pandas as pd
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANN = "data/Sample_annotated_Zenodo.csv"
LABEL = "protein_coding"

# ---------- load ----------
meta = pd.read_csv(META, index_col=0)
counts = pd.read_csv(COUNTS, index_col=0)
ann = pd.read_csv(ANN)

print(f"meta shape            : {meta.shape}")
print(f"counts shape (g x s)  : {counts.shape}")
print(f"annotation shape      : {ann.shape}")

# ---------- integrity checks (hard stops) ----------
assert counts.index.is_unique and meta.index.is_unique
n_samples = counts.shape[1]
assert n_samples == 723, f"expected 723 sample columns, got {n_samples}"
assert n_samples == len(ann), "sample count mismatch vs annotation"
assert set(counts.columns) == set(ann["sample"]), "sample names != annotation"
assert np.isin(meta.index, counts.index).all(), "meta genes missing from counts"

# real join on the identifier (not positional reliance)
expr_mean = counts.mean(axis=1, skipna=True)          # raw arithmetic mean
cpm = counts / counts.sum(axis=0) * 1e6               # per-sample CPM
expr_cpm = cpm.mean(axis=1, skipna=True)

df = meta.join(expr_mean.rename("mean_counts"), how="inner") \
          .join(expr_cpm.rename("mean_cpm"), how="inner")
assert len(df) == len(meta) == 59453, f"join lost genes: {len(df)}"
print(f"joined rows (no gene lost): {len(df)}   samples used: {n_samples}")
print(f"NA in mean_counts: {df.mean_counts.isna().sum()}, "
      f"NA in Length: {df.Length.isna().sum()}")

lib = counts.sum(axis=0)
print(f"library sizes: min={lib.min():,.0f} median={lib.median():,.0f} "
      f"max={lib.max():,.0f}")

# ---------- subsets ----------
pc = df[df.gene_biotype == LABEL]                                  # n = 19942
pc_multi = df[df.gene_biotype.astype(str).str.contains(LABEL)]     # n = 19954
pc_nonzero = pc[pc.mean_counts > 0]

print(f"protein_coding (exact)     : n = {len(pc)}")
print(f"protein_coding (contains)  : n = {len(pc_multi)}")
print(f"protein_coding all-zero    : n = {(pc.mean_counts == 0).sum()}")

# ---------- statistics ----------
def pear(a, b):
    r, p = stats.pearsonr(np.asarray(a, float), np.asarray(b, float))
    assert np.isfinite(r) and abs(r) <= 1.0, f"invalid r: {r}"
    return r, p, len(a)

def spear(a, b):
    r, p = stats.spearmanr(np.asarray(a, float), np.asarray(b, float))
    return r, p, len(a)

r, p, n = pear(pc.Length, pc.mean_counts)            # <-- PRIMARY
print("\n" + "=" * 66)
print(f"PRIMARY  Pearson r(Length, mean raw counts), protein-coding")
print(f"         r = {r:.4f}   (r = {r:.6f})")
print(f"         n = {n} genes, p = {p:.3e}")
print("=" * 66)

sens = []
sens.append(("PRIMARY: Pearson, Length vs mean raw counts", *pear(pc.Length, pc.mean_counts)))
sens.append(("(a) Pearson, Length vs log1p(mean counts)", *pear(pc.Length, np.log1p(pc.mean_counts))))
sens.append(("(b) Spearman, Length vs mean counts", *spear(pc.Length, pc.mean_counts)))
sens.append(("(c) Pearson, Length vs mean per-sample CPM", *pear(pc.Length, pc.mean_cpm)))
sens.append(("(d) Pearson, excl. 645 all-zero genes", *pear(pc_nonzero.Length, pc_nonzero.mean_counts)))
sens.append(("(e) Pearson, incl. 12 multi-label genes", *pear(pc_multi.Length, pc_multi.mean_counts)))

tab = pd.DataFrame(sens, columns=["variant", "r", "p", "n"])
tab["r"] = tab["r"].round(4)
tab["p"] = tab["p"].map(lambda x: f"{x:.2e}")
print("\nSensitivity panel\n" + tab.to_string(index=False))

raw_r = tab.loc[0, "r"]; cpm_r = tab.loc[tab.variant.str.startswith("(c)"), "r"].iloc[0]
same_3rd = abs(raw_r - cpm_r) < 5e-4
print(f"\nCPM invariance: raw r = {raw_r:.4f} vs CPM r = {cpm_r:.4f} "
      f"-> |diff| = {abs(raw_r - cpm_r):.4f} -> same to 3rd decimal: "
      f"{abs(round(raw_r,3) - round(cpm_r,3)) < 1e-3}")

# what drives it: contribution of the largest genes / most expressed
rho_len = pc.Length.rank(pct=True); rho_exp = pc.mean_counts.rank(pct=True)
top = pc.assign(r2=(rho_len - rho_exp) ** 2).nlargest(0, "Length")
long_genes = pc[pc.Length >= pc.Length.quantile(0.99)]
print(f"\nTop-1% longest genes (n={len(long_genes)}): mean counts median = "
      f"{long_genes.mean_counts.median():.2f} vs rest = "
      f"{pc[pc.Length < pc.Length.quantile(0.99)].mean_counts.median():.2f}")
q = pd.qcut(pc.Length, 5, labels=["Q1 shortest", "Q2", "Q3", "Q4", "Q5 longest"])
print("median mean counts by Length quintile:")
print(pc.groupby(q, observed=True).mean_counts.agg(["median", "mean", "size"]).round(2).to_string())

ans = {
    "answer": f"{r:.4f}",
    "r": r, "p": p, "n_genes": int(n), "n_samples": int(n_samples),
    "subset": "gene_biotype == 'protein_coding' (exact)",
    "expression_definition": "arithmetic mean of raw batch-corrected counts across all 723 samples",
    "sensitivity": {row.variant: {"r": float(row.r), "n": int(row.n)} for row in tab.itertuples()},
}
with open("out/results.json", "w") as fh:
    json.dump(ans, fh, indent=2)
tab.to_csv("out/sensitivity_panel.csv", index=False)
print("\nsaved: out/results.json, out/sensitivity_panel.csv")
