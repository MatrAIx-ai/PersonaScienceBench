"""Over-representation analysis (hypergeometric, right-tail) + BH, replicating
clusterProfiler::enrichKEGG semantics for organism='paer'.
Inputs : --map  gene<TAB>pathway TSV (genes like PA14_xxxxx or pae:PA14_xxxxx;
                pathways paXXXXX or path:paXXXXX)  <-- the one pending input
         --names pathway<TAB>definition TSV (optional)
         --down-csv ... one or two DOWN gene lists (column 'gene')
         --labels ... labels for those CSVs
Universe variants:
  dataset_mapped : genes of the dataset that have >=1 KEGG pathway   (PRIMARY)
  kegg_all       : all genes present in the paer mapping
Significance: padj (BH) <= 0.05. Common pathways = intersection of pathway IDs.
"""
import argparse, csv, json, os
from collections import defaultdict
from scipy.stats import hypergeom
from statsmodels.stats.multitest import multipletests

def read_map(path):
    pw2genes = defaultdict(set)
    with open(path) as fh:
        for row in csv.reader(fh, delimiter='\t'):
            if not row or row[0].startswith('#'): continue
            g, p = row[0].strip(), row[1].strip()
            if g.startswith('pae:'): g = g[4:]
            if p.startswith('path:'): p = p[5:]
            pw2genes[p].add(g)
    return pw2genes

def read_names(path):
    d = {}
    if path:
        with open(path) as fh:
            for row in csv.reader(fh, delimiter='\t'):
                if len(row) >= 2: d[row[0].strip()] = row[1].strip()
    return d

def read_genes(path):
    with open(path) as fh:
        return [r['gene'].strip() for r in csv.DictReader(fh)]

def ora(genes_query, pw2genes, universe):
    universe = set(universe)
    q = set(genes_query) & universe
    N = len(universe)
    rows = []
    for pw, gset in sorted(pw2genes.items()):
        K = len(gset & universe)
        if K == 0: continue
        k = len(q & gset)
        p = hypergeom.sf(k - 1, N, K, len(q))
        rows.append([pw, k, N, K, len(q), p, ','.join(sorted(q & gset))])
    padj = multipletests([r[5] for r in rows], method='fdr_bh')[1] if rows else []
    for r, a in zip(rows, padj): r.append(a)
    return rows  # pw,k,N,K,n,p,geneIDs,padj

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--map', required=True)
    ap.add_argument('--names')
    ap.add_argument('--full-csv', nargs='+', required=True, help='full results CSVs (define dataset universe)')
    ap.add_argument('--down-csv', nargs='+', required=True)
    ap.add_argument('--labels', nargs='+', required=True)
    ap.add_argument('--outdir', default='data/results')
    a = ap.parse_args()
    os.makedirs(a.outdir, exist_ok=True)

    pw2genes = read_map(a.map)
    names = read_names(a.names)
    dataset_genes = set()
    for fc in a.full_csv:
        with open(fc) as fh: dataset_genes |= {r['gene'] for r in csv.DictReader(fh)}
    kegg_all = {g for s in pw2genes.values() for g in s}
    universes = {'dataset_mapped': dataset_genes & kegg_all, 'kegg_all': kegg_all}
    print(f'universes: dataset_mapped={len(universes["dataset_mapped"])} kegg_all={len(kegg_all)} (dataset={len(dataset_genes)})')

    sig, tables = {}, {}
    for uname, univ in universes.items():
        for lab, dcsv in zip(a.labels, a.down_csv):
            rows = ora(read_genes(dcsv), pw2genes, univ)
            sig[(uname, lab)] = {r[0] for r in rows if r[7] <= 0.05}
            out = f'{a.outdir}/enriched_{lab}_{uname}.csv'
            with open(out, 'w', newline='') as fh:
                w = csv.writer(fh)
                w.writerow(['pathway', 'name', 'k', 'N', 'K', 'n', 'pvalue', 'padj', 'geneID'])
                for r in sorted(rows, key=lambda x: x[5]):
                    w.writerow([r[0], names.get(r[0], ''), r[1], r[2], r[3], r[4], f'{r[5]:.6g}', f'{r[7]:.6g}', r[6]])
            tables[(uname, lab)] = out
            print(f'{lab} [{uname}]: tested={len(rows)} sig(padj<=0.05)={len(sig[(uname, lab)])} -> {out}')

    print('\n--- COMMON pathways (padj<=0.05 in BOTH conditions) ---')
    summary = {}
    for uname in universes:
        common = sorted(sig[(uname, a.labels[0])] & sig[(uname, a.labels[1])])
        summary[uname] = common
        print(f'[{uname}] n_common={len(common)}: {common}')
    changed = set(summary['dataset_mapped']) != set(summary['kegg_all'])
    print(f'universe-sensitivity: count changes between variants: {changed}')
    primary = summary['dataset_mapped']
    print(f'\nANSWER (primary, universe=dataset_mapped): {len(primary)} common pathways {primary}')
    json.dump({'common': {'primary_dataset_mapped': primary, 'kegg_all': summary['kegg_all']},
               'n_sig': {f'{u}|{l}': len(s) for (u, l), s in sig.items()}},
              open(f'{a.outdir}/summary.json', 'w'), indent=2)

main()
