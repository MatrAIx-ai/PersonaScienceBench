"""Export DESeqResults RDS files to CSV + significantly DOWN-regulated gene lists.
DOWN := log2FoldChange <= -1.5 AND padj <= 0.05"""
import csv, os, sys
sys.path.insert(0, os.path.dirname(__file__))
from rds_extract import load_deseqresults, is_na_real, COLS

FILES = {'GluFevsGluFePlus': 'data/res_GluFevsGluFePlus.rds',
         'SuccvsGluFePlus':  'data/res_SuccvsGluFePlus.rds'}
os.makedirs('data/derived', exist_ok=True)
for cond, path in FILES.items():
    ids, d = load_deseqresults(path)
    with open(f'data/derived/{cond}_full.csv', 'w', newline='') as fh:
        w = csv.writer(fh); w.writerow(['gene'] + COLS)
        for i, g in enumerate(ids):
            w.writerow([g] + ['NA' if is_na_real(d[c][i]) else repr(d[c][i]) for c in COLS])
    down = [(g, d['log2FoldChange'][i], d['padj'][i])
            for i, g in enumerate(ids)
            if not is_na_real(d['padj'][i]) and d['log2FoldChange'][i] <= -1.5 and d['padj'][i] <= 0.05]
    with open(f'data/derived/down_{cond}.csv', 'w', newline='') as fh:
        w = csv.writer(fh); w.writerow(['gene', 'log2FoldChange', 'padj'])
        for g, l, p in sorted(down, key=lambda x: x[1]): w.writerow([g, l, p])
    print(f'{cond}: {len(ids)} genes total -> {len(down)} DOWN genes (log2FC<=-1.5 & padj<=0.05)')
