"""Fetch current KEGG paer gene->pathway mapping + pathway names from KEGG REST.
Run when network is available. Writes data/kegg/ and a provenance manifest."""
import json, os, urllib.request, datetime

BASE = 'https://rest.kegg.jp'
OUT = 'data/kegg'
os.makedirs(OUT, exist_ok=True)

def get(url):
    with urllib.request.urlopen(url, timeout=60) as r:
        return r.read().decode()

link = get(f'{BASE}/link/paer/pathway')          # 'pae:PA14_xxxxx\tpath:paXXXXX' per line
names = get(f'{BASE}/list/pathway/paer')          # 'paXXXXX\tDefinition [MODULE...]'
open(f'{OUT}/paer_link_pathway.tsv', 'w').write(link)
open(f'{OUT}/paer_pathway_names.tsv', 'w').write(names)
json.dump({'source': f'{BASE}/link/paer/pathway + /list/pathway/paer',
           'retrieved_utc': datetime.datetime.now(datetime.UTC).isoformat()},
          open(f'{OUT}/manifest.json', 'w'), indent=2)
print('saved', len(link.splitlines()), 'gene-pathway links;',
      len(names.splitlines()), 'pathway names.')
