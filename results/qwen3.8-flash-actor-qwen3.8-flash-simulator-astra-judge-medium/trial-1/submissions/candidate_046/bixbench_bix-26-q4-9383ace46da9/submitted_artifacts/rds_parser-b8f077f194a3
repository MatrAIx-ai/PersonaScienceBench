"""Extract DESeq2 DESeqResults tables from RDS without R (pure-Python XDR parse).
Verified format: gzip + RDSX header; STRSXP=int32(16)+count+elements; REALSXP=int32(14)+count+doubles;
string element = b'\x00\x04\x00\x09' + int32 len + bytes."""
import gzip, struct, re

COLS = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']

def load_deseqresults(path):
    raw = gzip.decompress(open(path, 'rb').read())
    assert raw[0] == 0x58 and b'UTF-8' in raw[:40], 'unexpected RDS header'
    assert b'DESeqResults' in raw, 'not a DESeqResults object'
    # column names STRSXP right before the S4 class-name string at file end
    i = raw.rfind(b'baseMean'); pos = i - 8; names = []
    while raw[pos:pos+4] == b'\x00\x04\x00\x09':
        ln = struct.unpack('>i', raw[pos+4:pos+8])[0]
        names.append(raw[pos+8:pos+8+ln].decode()); pos += 8 + ln
    assert names == COLS, f'unexpected column names: {names}'
    # rownames STRSXP
    p = raw.index(b'rownames') + 8
    assert raw[p:p+4] == b'\x00\x00\x00\x10'
    n = struct.unpack('>i', raw[p+4:p+8])[0]; pos = p + 8; ids = []
    for _ in range(n):
        assert raw[pos:pos+4] == b'\x00\x04\x00\x09'
        ln = struct.unpack('>i', raw[pos+4:pos+8])[0]
        ids.append(raw[pos+8:pos+8+ln].decode()); pos += 8 + ln
    # six REALSXP columns, serialized in data.frame (== names) order
    vecs = []
    for m in re.finditer(re.escape(b'\x00\x00\x00\x0e'), raw):
        q = m.end()
        if q + 4 <= len(raw):
            cnt = struct.unpack('>i', raw[q:q+4])[0]
            if 100 < cnt < 100000 and q + 4 + 8*cnt <= len(raw):
                vecs.append(struct.unpack('>%dd' % cnt, raw[q+4:q+4+8*cnt]))
    assert len(vecs) == 6 and all(len(v) == n for v in vecs)
    return ids, dict(zip(COLS, vecs))

def is_na_real(v):
    return struct.pack('>d', v) == b'\x7f\xf0\x00\x00\x00\x00\x00\x01'
