#!/usr/bin/env python3
"""
BCG-CORONA (bix-29-q1)
Question: odds ratio of BCG vaccination on COVID-19 severity, controlling for prior medical
history count and patients-interaction frequency and their interaction, from an ordinal
regression model.

Specification approved by the researcher:
  * population : participants with >=1 documented SARS-CoV-2/COVID adverse event (n=197)
  * exposure   : bcg = 1 if randomised TRTGRP == 'BCG' else 0 (ITT)
  * outcome    : within-participant MAXIMUM AEHS (0-7 clinical severity score of the AE);
                 mandatory sensitivity: collapsed 4 levels (0 / 1 / 2-4 / 5-7). If the raw
                 0-7 fit is unstable (disordered cutpoints / inflated SE) the collapsed
                 model supplies the headline number.
  * covariates : mh_count = # MEDICAL-HISTORY checklist terms with MHORRES=='2'
                 (1=No, 2=Yes; questionnaire items excluded; missing = absent)
                 pat_int  = patients_seen recoded 1-50->1, 51-100->2, >100->3
                 interaction bcg x pat_int, pat_int centred at 2 so beta_bcg is the BCG
                 effect at pat_int=2 (simple effects at pat_int 1/2/3 also reported)
  * model      : ordered logit (proportional odds), statsmodels OrderedModel, cross-checked
                 against an independent hand-written MLE of the same likelihood.
  * statistic  : OR = exp(beta_bcg) = odds of a MORE severe category (BCG vs placebo),
                 95% Wald CI + bootstrap percentile CI.
Run: python3 analysis_bcg_covid_severity.py   -> results/FINAL_REPORT.txt, results/all_results.json
"""
import json, os, warnings
import numpy as np, pandas as pd
from scipy import stats, optimize
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
warnings.filterwarnings('ignore')
os.makedirs('results', exist_ok=True)
R = {}

# =========================== 1. BUILD ======================================
DM = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', dtype=str)
AE = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', dtype=str)
MH = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', dtype=str)
MHX = pd.read_excel('data/TASK008_BCG-CORONA_MH.xlsx', dtype=str)
aud = {}
aud['MH_xlsx_cells_differing_from_csv'] = int((MH.astype(object).where(pd.notna(MH), None).values
    != MHX.astype(object).where(pd.notna(MHX), None).values).sum())
blank = AE.drop(columns=['STUDYID','TRTGRP','USUBJID']).isna().all(axis=1)
aud['AE_rows_raw'], aud['AE_all_blank_rows_dropped'] = len(AE), int(blank.sum())
AE = AE[~blank].copy()
aud['AE_event_rows_kept'], aud['AE_participants_with_events'] = len(AE), int(AE.USUBJID.nunique())

dm = DM[['USUBJID','TRTGRP','patients_seen','expect_interact']].copy()
dm['bcg']     = (dm.TRTGRP == 'BCG').astype(int)
dm['pat_int'] = dm.patients_seen.map({'1-50':1,'51-100':2,'>100':3}).astype(int)
dm['expect']  = (dm.expect_interact == 'Yes').astype(int)

chk = MH[(MH.MHSCAT=='MEDICAL HISTORY') & MH.MHTERM.notna()].copy()
aud['MH_checklist_rows']             = len(chk)
aud['MH_checklist_duplicated_pairs'] = int(chk.duplicated(['USUBJID','MHTERM']).sum())
aud['MH_checklist_missing_MHORRES']  = int(chk.MHORRES.isna().sum())   # treated as absent
chk['present'] = (chk.MHORRES == '2').astype(int)
mh_count = chk.groupby('USUBJID').present.sum().rename('mh_count')
mh_noRTI = chk[chk.MHTERM!='Current respiratory tract infection'].groupby('USUBJID').present.sum().rename('mh_count_noRTI')

covid = AE[AE.AEPT.fillna('').str.contains('COVID|SARS-CoV-2', case=False, regex=True)].copy()
covid['AEHS_num'] = pd.to_numeric(covid.AEHS, errors='coerce')
aud['COVID_AE_rows'] = len(covid)
aud['COVID_AE_terms'] = covid.AEPT.value_counts().to_dict()
aud['COVID_max_AEHS_missing'] = int(covid.AEHS_num.isna().sum())
sev = covid.groupby('USUBJID').AEHS_num.max().rename('sev')

full = (dm.merge(mh_count, on='USUBJID', how='left').merge(mh_noRTI, on='USUBJID', how='left')
          .merge(sev, on='USUBJID', how='left'))
full['mh_count'] = full.mh_count.fillna(0).astype(int)
full['mh_count_noRTI'] = full.mh_count_noRTI.fillna(0).astype(int)
full['covid_infection'] = full.sev.notna().astype(int)
full['sev4'] = pd.cut(full.sev, [-0.1,0.5,1.5,4.5,7.0], labels=[0,1,2,3]).astype('float')
an = full[full.covid_infection==1].copy().reset_index(drop=True); an['sev'] = an.sev.astype(int); an['sev4'] = an.sev4.astype(int)
an['pat_c'] = an.pat_int - 2
an['bcg_x_pat'] = an.bcg*an.pat_c
an['mh_c'] = an.mh_count - an.mh_count.mean()
an['bcg_x_mh'] = an.bcg*an.mh_c
an['bcg_x_expect'] = an.bcg*(an.expect - an.expect.mean())
an['pat_int2'] = (an.pat_int>=2).astype(int); an['pat_int3'] = (an.pat_int==3).astype(int)
aud['n_full_cohort'] = len(full); aud['n_analysed'] = len(an)
R['data_audit'] = aud
an.to_csv('results/analysis_dataset.csv', index=False)
full.to_csv('results/full_cohort_dataset.csv', index=False)

# =========================== 2. MODELLING ==================================
# statsmodels 0.14.6 returns OrderedModel params with COVARIATES FIRST and CUTPOINTS LAST
# (cutpoint labels look like '0/1'), so extraction is done by label, never by position.
# Sign convention (verified on simulated data): positive coefficient = higher odds of a
# MORE severe category.
def fit_ordinal(endog, exog, label):
    endog = pd.Series(np.asarray(endog)).astype(int).reset_index(drop=True)
    exog = exog.reset_index(drop=True)
    m = OrderedModel(endog, exog.astype(float), distr='logit')
    r = m.fit(method='newton', maxiter=5000, maxiter_line_search=1000, disp=False)
    if not (r.mle_retvals.get('converged', True) and np.all(np.isfinite(r.bse))):
        r = m.fit(method='bfgs', maxiter=5000, disp=False)
    cov = [c for c in r.params.index if '/' not in c]; cut = [c for c in r.params.index if '/' in c]
    b, s = r.params[cov].values, r.bse[cov].values; z = b/s
    tab = pd.DataFrame({'coef':b,'SE':s,'OR':np.exp(b),'lo95':np.exp(b-1.96*s),
                        'hi95':np.exp(b+1.96*s),'z':z,'p':2*stats.norm.sf(abs(z))}, index=cov)
    cuts = r.params[cut].values
    diag = {'model':label,'n':int(len(endog)),'outcome_levels':int(endog.nunique()),
            'converged':bool(r.mle_retvals.get('converged',True)),'llf':round(float(r.llf),3),
            'AIC':round(float(r.aic),2),'max_covariate_SE':round(float(s.max()),3),
            'cutpoints':[round(float(x),3) for x in cuts],
            'cutpoints_strictly_increasing':bool(np.all(np.diff(cuts)>0))}
    return r, tab.round(4), diag

def nll_scale(endog, exog, cutvar=None):
    """Cumulative-logit (ordered logit) neg-log-likelihood; if cutvar is given, that
    variable's effect is allowed to vary by cut (partially proportional odds)."""
    endog = pd.Series(np.asarray(endog)).astype(int).values
    lv = sorted(pd.unique(endog)); K = len(lv)-1
    exog = exog.reset_index(drop=True)
    X = exog.astype(float).values; n,p = X.shape; cols = list(exog.columns)
    yidx = np.searchsorted(lv, endog)
    j = cols.index(cutvar) if cutvar else None
    base = [i for i in range(p) if i != j] if cutvar else list(range(p))
    def f(par):
        th = np.sort(par[:K])
        if cutvar is None:
            z = th[None,:] - (X@par[K:])[:,None]
        else:
            z = th[None,:] - (X[:,base]@par[K+K:])[:,None] - np.outer(X[:,j], par[K:K+K])
        P = np.clip(1/(1+np.exp(-np.clip(z,-50,50))), 1e-12, 1-1e-12)
        lo = np.hstack([np.zeros((n,1)),P]); hi = np.hstack([P,np.ones((n,1))])
        return -np.log(np.clip(hi-lo,1e-300,None)[np.arange(n), yidx]).sum()
    return f, K, p

def start_values(endog, exog, cutvar=None):
    f,K,p = nll_scale(endog, exog, cutvar)
    x0 = np.r_[np.linspace(-2,2,K), np.zeros(p)] if cutvar is None \
         else np.r_[np.linspace(-2,2,K), np.zeros(K), np.zeros(p-1)]
    o = optimize.minimize(f, x0, method='Powell',
                          options={'maxiter':400000,'maxfev':800000,'xtol':1e-9,'ftol':1e-11})
    return optimize.minimize(f, o.x, method='BFGS', options={'maxiter':5000}), f

def own_mle(endog, exog):     # independent verification of the statsmodels fit
    o, f = start_values(endog, exog, None)
    K = pd.Series(np.asarray(endog)).astype(int).nunique()-1
    H = np.zeros((len(o.x),)*2); h = 1e-4
    for i in range(len(o.x)):
        for j in range(len(o.x)):
            e1 = np.zeros(len(o.x)); e2 = np.zeros(len(o.x)); e1[i]=h; e2[j]=h
            H[i,j] = (f(o.x+e1+e2)-f(o.x+e1-e2)-f(o.x-e1+e2)+f(o.x-e1-e2))/(4*h*h)
    sd = np.sqrt(np.diag(np.linalg.pinv(H)))
    return {'llf':round(-float(o.fun),4),'beta':dict(zip(exog.columns,np.round(o.x[K:],4))),
            'SE':dict(zip(exog.columns,np.round(sd[K:],4)))}

def bootstrap_BCG(endog, exog, B=800, seed=7):     # percentile CI for the BCG OR
    rng = np.random.default_rng(seed)
    endog = pd.Series(np.asarray(endog)).astype(int); lv = sorted(pd.unique(endog)); K = len(lv)-1
    o0,_ = start_values(endog, exog, None); x0 = o0.x
    X = exog.astype(float).values; e = endog.values; y = np.searchsorted(lv, e); n = len(e)
    out = []
    for _ in range(B):
        sub = rng.choice(n, size=n, replace=True)
        if len(np.unique(e[sub])) < len(lv): continue
        Xs, ys = X[sub], y[sub]
        def floc(par):
            z = np.sort(par[:K])[None,:] - (Xs@par[K:])[:,None]
            P = np.clip(1/(1+np.exp(-np.clip(z,-50,50))),1e-12,1-1e-12)
            lo = np.hstack([np.zeros((n,1)),P]); hi = np.hstack([P,np.ones((n,1))])
            return -np.log(np.clip(hi-lo,1e-300,None)[np.arange(n), ys]).sum()
        oo = optimize.minimize(floc, x0, method='BFGS', options={'maxiter':3000})
        if np.all(np.isfinite(oo.x)): out.append(oo.x[K])
    out = np.array(out)
    return {'B_effective':int(len(out)),'OR_bootstrap_median':round(float(np.exp(np.median(out))),3),
            'CI95_bootstrap':[round(float(np.exp(np.percentile(out,2.5))),3),
                              round(float(np.exp(np.percentile(out,97.5))),3)]}

T       = ['bcg','mh_count','pat_int','bcg_x_pat']
T_NOINT = ['bcg','mh_count','pat_int']
specs = [('PRIMARY_raw0-7_bcg_x_pat_int',           'sev',  T),
         ('HEADLINE_collapsed_0_1_2-4_5-7_bcg_x_pat_int','sev4', T),
         ('raw0-7_no_interaction',                  'sev',  T_NOINT),
         ('collapsed_no_interaction',               'sev4', T_NOINT),
         ('raw0-7_bcg_x_mh_count',                  'sev',  ['bcg','mh_count','pat_int','bcg_x_mh']),
         ('collapsed_bcg_x_mh_count',               'sev4', ['bcg','mh_count','pat_int','bcg_x_mh']),
         ('collapsed_sens_expect_interact',         'sev4', ['bcg','mh_count','expect','bcg_x_expect']),
         ('collapsed_sens_mh_count_excl_CurrentRTI','sev4', ['bcg','mh_count_noRTI','pat_int','bcg_x_pat']),
         ('collapsed_sens_pat_int_as_dummies',      'sev4', ['bcg','mh_count','pat_int2','pat_int3','bcg_x_pat']),
         ('crude_collapsed_BCG_only',               'sev4', ['bcg']),
         ('crude_raw0-7_BCG_only',                  'sev',  ['bcg'])]
models, diags = {}, []
for lab,yv,tt in specs:
    r,t,d = fit_ordinal(an[yv], an[tt], lab); models[lab] = t; diags.append(d)
diag = pd.DataFrame(diags); R['model_diagnostics'] = diag
R['crosscheck_own_MLE'] = {'collapsed_headline': own_mle(an.sev4, an[T]), 'raw_primary': own_mle(an.sev, an[T])}
raw_ok = bool(diag.loc[diag.model.str.startswith('PRIMARY'),'cutpoints_strictly_increasing'].iloc[0])
col_ok = bool(diag.loc[diag.model.str.startswith('HEADLINE'),'cutpoints_strictly_increasing'].iloc[0])
R['headline_choice'] = {'raw_cutpoints_ordered': raw_ok, 'collapsed_cutpoints_ordered': col_ok,
  'rule':'raw 0-7 is primary unless cutpoints are disordered / SEs inflated; then the collapsed 4-level model gives the headline',
  'headline_model':'collapsed 0|1|2-4|5-7' if not raw_ok else 'raw 0-7'}

def simple_effects(yv):
    r,_,_ = fit_ordinal(an[yv], an[T], 'se'); V = r.cov_params().loc[T,T].values; rows=[]
    for pv in (1,2,3):
        c = np.array([1,0,pv-2,pv-2], float)
        b = float(c @ r.params[T].values); se = float(np.sqrt(c @ V @ c))
        rows.append({'pat_int':pv,'n_in_stratum':int((an.pat_int==pv).sum()),'coef':round(b,4),'SE':round(se,4),
                     'OR':round(np.exp(b),3),'lo95':round(np.exp(b-1.96*se),3),
                     'hi95':round(np.exp(b+1.96*se),3),'p':round(float(2*stats.norm.sf(abs(b/se))),4)})
    return pd.DataFrame(rows).set_index('pat_int')
R['simple_effects_BCG_collapsed'] = simple_effects('sev4')
R['simple_effects_BCG_raw']       = simple_effects('sev')

def lrt_interaction(yv):
    r1,_,_ = fit_ordinal(an[yv], an[T], 'i'); r0,_,_ = fit_ordinal(an[yv], an[T_NOINT], 'n')
    LR = 2*(r1.llf-r0.llf)
    return {'llf_with':round(float(r1.llf),3),'llf_without':round(float(r0.llf),3),
            'LR_chisq':round(float(LR),3),'df':1,'p':round(float(stats.chi2.sf(max(LR,0),1)),4)}
R['LRT_interaction'] = {'raw 0-7': lrt_interaction('sev'), 'collapsed 4-level': lrt_interaction('sev4')}

def ppo_test(yv, cutvar='bcg'):     # proportional-odds LR test
    o0,_ = start_values(an[yv], an[T], None); o1,_ = start_values(an[yv], an[T], cutvar)
    K = int(pd.Series(an[yv]).astype(int).nunique())-1; dfree = K-1
    LR = 2*(-o1.fun + o0.fun)
    return {'ll_proportional_odds':round(-float(o0.fun),3),
            'll_partially_proportional_odds':round(-float(o1.fun),3),
            'LR_chisq':round(float(LR),3),'df':int(dfree),
            'p':round(float(stats.chi2.sf(max(LR,0),dfree)),4),
            'cut_specific_BCG_effect':[round(float(x),3) for x in o1.x[K:K+K]]}
R['proportional_odds_LRtest'] = {'raw 0-7': ppo_test('sev'), 'collapsed 4-level': ppo_test('sev4')}

def per_cut(yv):     # cumulative logits, stable model without interaction, one GLM per cut
    y = an[yv].astype(int); rows={}
    for k in sorted(pd.unique(y))[1:]:
        yy = (y>=k).astype(int)
        g = sm.GLM(yy, sm.add_constant(an[T_NOINT].astype(float)), family=sm.families.Binomial()).fit()
        b,se = float(g.params['bcg']), float(g.bse['bcg'])
        rows[f'severity>={k}'] = {'n_events':int(yy.sum()),'bcg_OR':round(np.exp(b),3),
            'lo95':round(float(np.exp(b-1.96*se)),3),'hi95':round(float(np.exp(b+1.96*se)),3),
            'p':round(float(g.pvalues['bcg']),3),'separation_flag':bool(se>5)}
    return rows
R['per_cut_cumulative_logits'] = {'collapsed 4-level': per_cut('sev4'), 'raw 0-7': per_cut('sev')}

alts = {'0|1|2-4|5-7 (HEADLINE)':[-0.1,0.5,1.5,4.5,7], '0-1|2-3|4-7':[-0.1,1.5,3.5,7],
        '0-1|2-7 (sev>=2)':[-0.1,1.5,7], '0|1-2|3-7':[-0.1,0.5,2.5,7]}
rows=[]
for nm,ed in alts.items():
    y = pd.cut(an.sev, ed, labels=range(len(ed)-1)).astype(int)
    _,t,d = fit_ordinal(y, an[T], nm)
    rows.append({'scale':nm,'cutpoints_ordered':d['cutpoints_strictly_increasing'],'bcg_OR':t.loc['bcg','OR'],
                 'bcg_lo95':t.loc['bcg','lo95'],'bcg_hi95':t.loc['bcg','hi95'],'bcg_p':t.loc['bcg','p'],
                 'mh_OR':t.loc['mh_count','OR'],'pat_OR':t.loc['pat_int','OR'],'int_OR':t.loc['bcg_x_pat','OR']})
R['alternative_collapses'] = pd.DataFrame(rows)
R['bootstrap_headline_BCG'] = bootstrap_BCG(an.sev4, an[T])

R['descriptives'] = {
  'outcome_by_arm_raw': pd.crosstab(an.sev, an.TRTGRP).to_dict(),
  'outcome_by_arm_collapsed': pd.crosstab(an.sev4, an.TRTGRP).to_dict(),
  'mean_sev4_by_arm': an.groupby('TRTGRP').sev4.mean().round(3).to_dict(),
  'covariate_means_by_arm': an.groupby('TRTGRP')[['mh_count','pat_int','expect','sev']].mean().round(3).to_dict(),
  'pat_int_distribution_analysed': an.pat_int.value_counts().sort_index().to_dict(),
  'mh_count_distribution_analysed': an.mh_count.value_counts().sort_index().to_dict()}
tb = pd.crosstab(full.TRTGRP, full.covid_infection)
chi2,pv,dfree,_ = stats.chi2_contingency(tb.values)
R['selection_check_conditioning_on_documented_infection'] = {
  'arm_x_documented_infection': {k:{kk:int(vv) for kk,vv in v.items()} for k,v in tb.to_dict().items()},
  'infection_rate_BCG': round(float(tb.loc['BCG',1]/tb.loc['BCG'].sum()),4),
  'infection_rate_Placebo': round(float(tb.loc['Placebo',1]/tb.loc['Placebo'].sum()),4),
  'infection_OR_BCG_vs_Placebo': round(float((tb.loc['BCG',1]/tb.loc['BCG',0])/(tb.loc['Placebo',1]/tb.loc['Placebo',0])),3),
  'chi2': round(float(chi2),3), 'df': int(dfree), 'p': round(float(pv),4)}

# =========================== 3. REPORT =====================================
HEAD = 'HEADLINE_collapsed_0_1_2-4_5-7_bcg_x_pat_int'
hl = models[HEAD]; bs = R['bootstrap_headline_BCG']; b = hl.loc['bcg']
lines = []
A = lines.append
A("BCG-CORONA (bix-29-q1): ordinal regression of SARS-CoV-2 severity (max AEHS) on BCG")
A("n full cohort = %d | n analysed (>=1 documented SARS-CoV-2 AE) = %d" % (aud['n_full_cohort'], aud['n_analysed']))
A("\n--- data audit ---\n"+json.dumps(aud, indent=1, default=str))
A("\n--- descriptives ---\n"+json.dumps(R['descriptives'], indent=1, default=str))
A("\n--- model diagnostics ---\n"+diag.to_string())
A("\n--- headline choice ---\n"+json.dumps(R['headline_choice'], indent=1))
for lab,t in models.items(): A("\n=== "+lab+" ===\n"+t.to_string())
A("\n--- simple effects of BCG by patients-interaction level (collapsed) ---\n"+R['simple_effects_BCG_collapsed'].to_string())
A("\n--- simple effects of BCG by patients-interaction level (raw 0-7) ---\n"+R['simple_effects_BCG_raw'].to_string())
A("\n--- LRT for interaction ---\n"+json.dumps(R['LRT_interaction'], indent=1))
A("\n--- proportional-odds LR test ---\n"+json.dumps(R['proportional_odds_LRtest'], indent=1))
A("\n--- per-cut cumulative logits (adjusted, no interaction) ---\n"+json.dumps(R['per_cut_cumulative_logits'], indent=1))
A("\n--- alternative collapses ---\n"+R['alternative_collapses'].to_string())
A("\n--- bootstrap (headline BCG OR) ---\n"+json.dumps(bs, indent=1))
A("\n--- selection check: conditioning on documented infection ---\n"+json.dumps(R['selection_check_conditioning_on_documented_infection'], indent=1))
A("\n--- own-MLE cross-check of the two main fits ---\n"+json.dumps(R['crosscheck_own_MLE'], indent=1))
A("\n\nANSWER  BCG vs placebo, ordinal (proportional-odds) model, adjusted for mh_count, "
  "patients-interaction frequency and bcg:pat_int")
A("  headline model : %s" % R['headline_choice']['headline_model'])
A("  OR(BCG) at patients-interaction = 2 : %.2f  (95%% Wald CI %.2f-%.2f, p=%.3f; bootstrap 95%% CI %s)"
  % (b['OR'], b['lo95'], b['hi95'], b['p'], json.dumps(bs['CI95_bootstrap'])))
for k in ['mh_count','pat_int','bcg_x_pat']:
    r_ = hl.loc[k]; A("  OR(%-9s) %.3f (%.3f-%.3f) p=%.3f" % (k, r_['OR'], r_['lo95'], r_['hi95'], r_['p']))
A("  raw 0-7 primary model OR(BCG) at pat_int=2: %.2f (%.2f-%.2f) p=%.3f"
  % tuple(models['PRIMARY_raw0-7_bcg_x_pat_int'].loc['bcg'][['OR','lo95','hi95','p']]))
A("  no-interaction models OR(BCG): raw %.2f | collapsed %.2f"
  % (models['raw0-7_no_interaction'].loc['bcg','OR'], models['collapsed_no_interaction'].loc['bcg','OR']))
txt = "\n".join(lines)
open('results/FINAL_REPORT.txt','w').write(txt+"\n")
with open('results/all_results.json','w') as f: json.dump(R, f, indent=2, default=str)
for lab,t in models.items():
    t.to_csv('results/model_%s.csv' % lab.replace(' ','_').replace(':','_').replace('|','_').replace('/','_'))
print(txt)
