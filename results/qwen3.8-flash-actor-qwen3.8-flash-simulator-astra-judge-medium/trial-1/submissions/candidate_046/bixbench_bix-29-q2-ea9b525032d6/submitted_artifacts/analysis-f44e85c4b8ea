print("\nCI width of headline effect (pp):", round(pct(hp.hi95)-pct(hp.lo95), 1))

# ---------------- descriptives + markdown report ----------------
desc = (dm.groupby("sev6").agg(n=("USUBJID", "size"), mean_ongoing=("n_ongoing", "mean"),
                              pct_any_ongoing=("n_ongoing", lambda s: 100*(s > 0).mean()),
                              pct_BCG=("BCG", lambda s: 100*s.mean())).round(3))
byc = (dm.groupby("n_ongoing").agg(n=("USUBJID", "size"), mean_sev=("sev_raw", "mean"),
                                  pct_sev_ge3=("sev_raw", lambda s: 100*(s >= 3).mean())).round(3))
cum_pct = pd.DataFrame([dict(cut=f"sev>={k}", n_event=int(v),
                             slope_cum_logit=float(cum6.loc[cum6.cut == k, "b_n_ongoing"].iloc[0]),
                             pct_increase_odds=round(pct(np.exp(cum6.loc[cum6.cut == k, "b_n_ongoing"].iloc[0])), 1))
                        for k, v in cum6.set_index("cut").n_event.items()])
desc.to_csv(f"{OUT}/descriptives_by_severity.csv"); byc.to_csv(f"{OUT}/descriptives_by_nconditions.csv")
cum_pct.to_csv(f"{OUT}/effect_by_cut.csv", index=False)

