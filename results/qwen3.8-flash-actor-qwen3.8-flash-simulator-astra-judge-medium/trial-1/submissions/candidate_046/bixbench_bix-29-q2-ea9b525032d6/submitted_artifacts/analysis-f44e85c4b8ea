"""
TASK008 BCG-CORONA  --  bixbench bix-29-q2
Question: independent effect of each additional ongoing medical condition (MHONGO) on the odds of
higher COVID-19 severity, controlling for BCG vaccination status and patient-interaction variables,
by ordinal regression. Reported as % increase in odds = (exp(beta)-1)*100.

Researcher-approved specification (fixed a priori):
  outcome   : max AEHS (0-7) per USUBJID over clinical AEs (AECAT in {RTI, Other}); ISR excluded;
              AESEV discarded; patients with no clinical AE = severity 0 (n = 1000).
              PRIMARY coding = 6 collapsed levels (0,1,2,3,4,5+); raw 0-7 run side by side.
  predictor : count of ongoing conditions = # rows with MHSCAT=='MEDICAL HISTORY' & MHONGO=='Yes'
              per USUBJID; MHONGO missing/No -> not ongoing; patients with none -> 0.
  adjustment: exactly TRTGRP (BCG=1 vs Placebo=0) + patients_seen + work_hours + expect_interact.
  estimator : proportional-odds (cumulative logit) ordinal regression, statsmodels OrderedModel
              (equivalent to MASS::polr / ordinal::clm; no R in this environment).
  extras    : PO diagnostics (cumulative-logit slope per cut, Brant-type Wald chi2, generalized-PO
              alternative + LRT), count truncated at 4, per-condition secondary model with Holm,
              robustness model (+Age/SEX/RACE/education), descriptive model on COVID-named AEs.
"""
import json, os, re, warnings
import numpy as np, pandas as pd
import statsmodels.api as sm
from scipy import stats, optimize
from statsmodels.miscmodels.ordinal_model import OrderedModel
from statsmodels.stats.multitest import multipletests
warnings.filterwarnings("ignore")

OUT = "out"; os.makedirs(OUT, exist_ok=True)
pd.set_option("display.width", 240)
def pct(o): return 100.0 * (o - 1.0)
def mdt(df):
    d = df.reset_index(drop=True)
    head = "| " + " | ".join(map(str, d.columns)) + " |"
    sep = "|" + "|".join(["---"]*len(d.columns)) + "|"
    body = "\n".join("| " + " | ".join("" if pd.isna(v) else str(v) for v in row) + " |"
                      for row in d.itertuples(index=False))
    return "\n".join([head, sep, body])

dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv", dtype=str, low_memory=False)
ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv", dtype=str, low_memory=False)
assert len(dm) == dm.USUBJID.nunique() == 1000

ae["hs"] = pd.to_numeric(ae.AEHS, errors="coerce")
clin = ae[ae.AECAT.isin(["RTI", "Other"])].copy()      # ISR excluded; 143 all-empty rows dropped
dm["sev_raw"] = dm.USUBJID.map(clin.groupby("USUBJID").hs.max()).fillna(0).astype(int)
dm["no_clin_ae"] = ~dm.USUBJID.isin(clin.USUBJID)
dm["sev6"] = np.where(dm.sev_raw >= 5, 5, dm.sev_raw)  # primary 6-level coding
dm["sev_rti"] = dm.USUBJID.map(ae[ae.AECAT == "RTI"].groupby("USUBJID").hs.max()).fillna(0).astype(int)
covid = clin[clin.AEPT.str.contains("COVID", case=False, na=False)]
dm["sev_covid"] = dm.USUBJID.map(covid.groupby("USUBJID").hs.max()).fillna(0).astype(int)
dm["covid_case"] = dm.USUBJID.isin(covid.USUBJID)

md = mh[(mh.MHSCAT == "MEDICAL HISTORY") & (mh.MHONGO == "Yes")].copy()
dm["n_ongoing"] = dm.USUBJID.map(md.groupby("USUBJID").size()).fillna(0).astype(int)
dm["n_ongoing_trunc4"] = np.minimum(dm.n_ongoing, 4)
dm["BCG"] = (dm.TRTGRP == "BCG").astype(int)
md["cond"] = np.where(md.MHTERM.str.startswith("Other:"),
                      md.MHDECOD.fillna(md.MHTERM.str.replace("Other:", "", regex=False)).str.upper().str.strip(),
                      md.MHTERM.str.strip())
freq = md.groupby(["USUBJID", "cond"]).size().reset_index()
keep = sorted(freq.cond.value_counts()[lambda s: s >= 20].index)
dum = freq[freq.cond.isin(keep)].assign(v=1).pivot_table(index="USUBJID", columns="cond", values="v", fill_value=0)
lab = {("cond_" + re.sub(r"[^0-9A-Za-z]+", "_", c).strip("_")): c for c in dum.columns}
dum.columns = list(lab)
dm = dm.merge(dum, left_on="USUBJID", right_index=True, how="left")
dm[list(lab)] = dm[list(lab)].fillna(0).astype(int)
dm["other_ongoing"] = dm.USUBJID.isin(md[md.MHTERM.str.startswith("Other:")].USUBJID).astype(int)

ADJ = ("C(patients_seen, Treatment(reference='1-50')) + "
       "C(work_hours, Treatment(reference='1-40')) + "
       "C(expect_interact, Treatment(reference='No'))")
F_COUNT = f"Y ~ n_ongoing + BCG + {ADJ}"
F_TRUNC = f"Y ~ n_ongoing_trunc4 + BCG + {ADJ}"
F_COND = "Y ~ " + " + ".join(lab) + " + other_ongoing + BCG + " + ADJ
F_ROB = f"Y ~ n_ongoing + BCG + C(SEX) + C(Age) + C(RACE) + C(education) + {ADJ}"
rows = []
def fit(df, formula, yname, tag):
    d = df.copy(); d["Y"] = d[yname].astype(int)
    r = OrderedModel.from_formula(formula, d, distr="logit").fit(method="bfgs", maxiter=2000, disp=0)
    ci = r.conf_int()
    for nm in r.params.index:
        if nm.startswith("threshold"):
            continue
        rows.append(dict(model=tag, term=nm, beta=r.params[nm], se=r.bse[nm], OR=np.exp(r.params[nm]),
                         lo95=np.exp(ci.loc[nm, 0]), hi95=np.exp(ci.loc[nm, 1]),
                         pct_incr_odds=pct(np.exp(r.params[nm])), p=r.pvalues[nm],
                         n=int(r.nobs), n_levels=int(d.Y.nunique()), loglik=r.llf,
                         converged=bool(r.mle_retvals["converged"])))
    return r, d

prim, dprim = fit(dm, F_COUNT, "sev6", "PRIMARY | count | sev6 (0,1,2,3,4,5+) | n=1000")
raw, draw = fit(dm, F_COUNT, "sev_raw", "SENS-1 | count | sev raw 0-7 | n=1000")
fit(dm, F_TRUNC, "sev6", "SENS-2 | count truncated at >=4 | sev6")
fit(dm[~dm.no_clin_ae], F_COUNT, "sev6", "SENS-3 | patients with a clinical AE only (n=752)")
fit(dm, F_COUNT, "sev_rti", "SENS-4 | outcome = max AEHS among RTI AEs only")
fit(dm[dm.covid_case], F_COUNT, "sev_covid", "DESCR-5 | 194 patients with a COVID-named AE (descriptive)")
fit(dm, F_ROB, "sev6", "ROBUST-6 | + Age, SEX, RACE, education | sev6")
fit(dm, f"Y ~ n_ongoing + {ADJ}", "sev6", "CHECK | no BCG in adjustment | sev6")
fit(dm, f"Y ~ n_ongoing * BCG + {ADJ}", "sev6", "CHECK | n_ongoing x BCG interaction | sev6")
dm["sev3"] = (dm.sev_raw >= 3).astype(int); dm["sev4"] = np.minimum(dm.sev_raw, 3)
fit(dm, F_COUNT, "sev3", "SENS-7 | dichotomised outcome (sev>=3) | ordinal(2 levels)=logistic")
fit(dm, F_COUNT, "sev4", "SENS-8 | 4-level outcome (0,1,2,3+) | sev4")
sec, dsec = fit(dm, F_COND, "sev6", "SECONDARY | per-condition (>=20) + other_ongoing | sev6")
tab = pd.DataFrame(rows)
mask_sec = (tab.model.str.startswith("SECONDARY") &
            ~tab.term.str.contains("/|BCG|patients_seen|work_hours|expect_interact"))
tab["p_holm"] = np.nan
tab.loc[mask_sec, "p_holm"] = multipletests(tab.loc[mask_sec, "p"].values, alpha=0.05, method="holm")[1]

# ---------------- proportional-odds diagnostics ----------------
def design(res):
    X = np.asarray(res.model.exog, float)
    return pd.DataFrame(X, columns=list(res.model.exog_names[:X.shape[1]]))

def cumulative_logits(res, y, label):
    """separate binary logistic regressions for each cumulative split P(Y >= k) (Brant-type test)"""
    Xd = design(res); out = []
    y = np.asarray(y, float); cols = list(Xd.columns)
    Xd = sm.add_constant(Xd.values)
    for k in sorted(int(v) for v in np.unique(y) if v > 0):
        yk = (y >= k).astype(float); rec = dict(model=label, cut=k, n_event=int(yk.sum()))
        try:                                        # sparse cuts can be non-identifiable
            r = sm.Logit(yk, Xd).fit(method="bfgs", disp=0, maxiter=5000)
            ok = np.all(np.isfinite(r.bse)) and r.mle_retvals["converged"]
        except Exception:
            ok = False
        for c in cols:
            rec[f"b_{c}"] = r.params[1 + cols.index(c)] if ok else np.nan
            rec[f"se_{c}"] = r.bse[1 + cols.index(c)] if ok else np.nan
        out.append(rec)
    return pd.DataFrame(out)

def brant(cum, label, terms):
    out = []
    for t in terms:
        b = cum[f"b_{t}"].values; s = cum[f"se_{t}"].values
        ok = np.isfinite(s) & (s < 10)                     # drop numerically unstable / sparse cuts
        if ok.sum() < 2:
            out.append(dict(model=label, term=t, chi2=np.nan, df=0, p=np.nan, cuts_used=0,
                            cuts_dropped=",".join(map(str, cum.cut[~ok])))); continue
        bb, ss = b[ok], s[ok]; w = 1 / ss**2
        chi2 = float((w * (bb - (w*bb).sum()/w.sum())**2).sum()); df = int(ok.sum()) - 1
        out.append(dict(model=label, term=t, chi2=chi2, df=df, p=float(stats.chi2.sf(chi2, df)),
                        cuts_used=int(ok.sum()),
                        cuts_dropped=",".join(map(str, cum.cut[~ok]))))
    return pd.DataFrame(out)

def partial_po(Xdf, y, zname):
    """Generalized ordered logit (partial proportional odds): the slope of `zname` is allowed to
    deviate from the common slope at every cut beyond the first (gamma_1 fixed at 0).
    Params: [a_1, log increments (K-1), gammas (K-1), slopes b (same order as Xdf)]."""
    y = np.asarray(y, int); K = int(y.max())
    Xm = Xdf.copy()
    if "Intercept" in Xm.columns:
        Xm = Xm.drop(columns="Intercept")
    z = Xm[zname].values.astype(float)
    Xv = Xm.values.astype(float)   # no extra intercept: the K thresholds a_k play that role
    def unpack(th):
        a = np.r_[th[0], th[0] - np.cumsum(np.exp(th[1:K]))]   # P(Y>=k) must decrease with k
        return a, np.r_[0.0, th[K:2*K-1]], th[2*K-1:]
    def nll(th):
        a, gam, b = unpack(th)
        Fk = 1/(1 + np.exp(-(a[:, None] + (Xv @ b)[None, :] + gam[:, None]*z[None, :])))
        if np.any(Fk[1:] - Fk[:-1] > 1e-9):
            return 1e10
        F = np.column_stack([np.ones(len(y)), Fk.T, np.zeros(len(y))])
        pr = F[np.arange(len(y)), y] - F[np.arange(len(y)), y+1]
        if np.any(pr <= 0) or not np.all(np.isfinite(pr)):
            return 1e10
        return -np.log(pr).sum()
    po = OrderedModel(y, Xdf, distr="logit").fit(method="bfgs", maxiter=2000, disp=0)
    p0 = Xv.shape[1]                                   # statsmodels orders params: slopes, thresholds
    slopes0 = np.asarray(po.params, float)[:p0]
    thr = np.asarray(po.params, float)[p0:p0+K]
    start = np.r_[-thr[0], np.log(np.maximum(np.diff(thr), 1e-3)), np.zeros(K-1), slopes0]
    r = optimize.minimize(nll, start, method="Nelder-Mead",
                          options=dict(maxiter=200000, maxfev=200000, xatol=1e-7, fatol=1e-7))
    r = optimize.minimize(nll, r.x, method="Powell", options=dict(maxiter=100000, maxfev=200000))
    a, gam, b = unpack(r.x)
    llr = 2*(-r.fun - po.llf); df = K-1
    return dict(converged=bool(r.success), nll=r.fun, ll_po=po.llf, ll_partialPO=-r.fun, LR=llr, df=df,
                p_LR=float(stats.chi2.sf(max(llr, 0), df)),
                z_slope_PO=float(slopes0[list(Xdf.drop(columns=["Intercept"], errors="ignore").columns).index(zname)]),
                z_dev_by_cut=";".join(f"cut{k+1}>{k+1}:{g:+.3f}" for k, g in enumerate(gam)))

# ---------------- run diagnostics ----------------
TERMS = ["n_ongoing", "BCG"]
cum6 = cumulative_logits(prim, dprim.sev6, "PRIMARY sev6")
cum8 = cumulative_logits(raw, draw.sev_raw, "SENS-1 sev 0-7")
brant_tab = pd.concat([brant(cum6, "PRIMARY sev6", TERMS), brant(cum8, "SENS-1 sev 0-7", TERMS)],
                      ignore_index=True)
gpo6 = partial_po(design(prim), dprim.sev6.values, "n_ongoing"); gpo6["model"] = "PRIMARY sev6"
gpo8 = partial_po(design(raw), draw.sev_raw.values, "n_ongoing"); gpo8["model"] = "SENS-1 sev 0-7"
gpo_tab = pd.DataFrame([gpo6, gpo8])

Xd = design(prim)
def _vif(df):
    o = {}
    for c in df.columns:
        Xo = sm.add_constant(df.drop(columns=[c]).values.astype(float))
        r = sm.OLS(df[c].values.astype(float), Xo).fit()
        o[c] = 1.0/max(1e-12, 1-r.rsquared)
    return pd.Series(o, name="VIF")
vif = _vif(Xd)
disp = dict(mean=float(dm.n_ongoing.mean()), var=float(dm.n_ongoing.var(ddof=1)),
            var_over_mean=float(dm.n_ongoing.var(ddof=1)/dm.n_ongoing.mean()),
            n_zero=int((dm.n_ongoing == 0).sum()), n_ge4=int((dm.n_ongoing >= 4).sum()),
            max=int(dm.n_ongoing.max()))

hp = tab[(tab.model.str.startswith("PRIMARY")) & (tab.term == "n_ongoing")].iloc[0]
hr = tab[(tab.model.str.startswith("SENS-1")) & (tab.term == "n_ongoing")].iloc[0]
move = abs(hp.pct_incr_odds - hr.pct_incr_odds)
head = dict(headline_pct_increase_in_odds=round(float(hp.pct_incr_odds), 1),
            OR=round(float(hp.OR), 4), beta=round(float(hp.beta), 4), se=round(float(hp.se), 4),
            CI95_pct="[%.1f%%, %.1f%%]" % (pct(hp.lo95), pct(hp.hi95)),
            CI95_OR="[%.3f, %.3f]" % (hp.lo95, hp.hi95), p=float(hp.p), n=int(hp.n),
            raw_0_7_pct=round(float(hr.pct_incr_odds), 1), shift_pp=round(float(move), 1),
            shift_gt_10pp=bool(move > 10),
            PO_test_n_ongoing_p_primary=float(brant_tab[(brant_tab.model == "PRIMARY sev6") &
                                                        (brant_tab.term == "n_ongoing")].p.iloc[0]),
            partialPO_LR_p_primary=float(gpo6["p_LR"]), partialPO_LR=round(float(gpo6["LR"]), 2),
            count_truncated_at_4_pct=round(float(tab[(tab.model.str.startswith("SENS-2")) &
                                                          (tab.term == "n_ongoing_trunc4")].pct_incr_odds.iloc[0]), 1))
tab.to_csv(f"{OUT}/model_coefficients.csv", index=False)
brant_tab.to_csv(f"{OUT}/proportional_odds_brant.csv", index=False)
pd.concat([cum6, cum8]).to_csv(f"{OUT}/cumulative_logit_slopes_by_cut.csv", index=False)
gpo_tab.to_csv(f"{OUT}/partial_proportional_odds.csv", index=False)
vif.to_csv(f"{OUT}/vif_primary.csv")
with open(f"{OUT}/headline.json", "w") as fh: json.dump(head, fh, indent=2)

print("== BUILD ==")
print("n =", len(dm), "| no clinical AE (severity 0):", int(dm.no_clin_ae.sum()))
print("sev6   :", dm.sev6.value_counts().sort_index().to_dict())
print("sev_raw:", dm.sev_raw.value_counts().sort_index().to_dict())
print("n_ongoing:", dm.n_ongoing.value_counts().sort_index().to_dict())
print("dispersion:", disp)
print("conditions kept (>=20):", list(lab.values()), "| other_ongoing n =", int(dm.other_ongoing.sum()))
print("\n== HEADLINE =="); print(json.dumps(head, indent=2))
print("\n== PRIMARY MODEL (all coefficients) ==")
print(tab[tab.model.str.startswith("PRIMARY")][["term","beta","se","OR","lo95","hi95","pct_incr_odds","p"]]
      .round(4).to_string(index=False))
print("\n== n_ongoing ACROSS MODELS ==")
print(tab[tab.term.str.contains("n_ongoing")][["model","OR","lo95","hi95","pct_incr_odds","p","n","n_levels","converged"]]
      .round(3).to_string(index=False))
print("\n== SECONDARY per-condition (Holm-adjusted) ==")
tt = tab[mask_sec].copy(); tt["condition"] = tt.term.map(lab).fillna(tt.term)
print(tt[["condition","OR","lo95","hi95","pct_incr_odds","p","p_holm"]].sort_values("OR", ascending=False).round(4).to_string(index=False))
print("\n== CUMULATIVE-LOGIT slopes by cut ==")
print(pd.concat([cum6, cum8])[["model","cut","n_event","b_n_ongoing","se_n_ongoing","b_BCG"]].round(4).to_string(index=False))
