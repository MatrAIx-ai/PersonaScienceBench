print("\n== VIF (primary design) =="); print(vif.round(3).to_string())
itx = tab[(tab.model.str.contains("interaction")) & (tab.term == "n_ongoing:BCG")]
print("\n== BCG interaction / no-BCG check ==")
print(tab[tab.model.str.startswith("CHECK")][["model","term","OR","pct_incr_odds","p"]].round(4).to_string(index=False))
