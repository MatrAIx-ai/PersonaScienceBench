log(f"n={int(rP.nobs)}  categorias={int(len(np.unique(prim[y_primary])))}  colapso_3_4={coll}  "
    f"llf={rP.llf:.3f}  AIC={rP.aic:.2f}  converged={rP.mle_retvals.get('converged')}")
log(rP.summary().as_text())

tabP = or_table(rP)
log("\nOdds ratios (Wald 95 % IC) del modelo primario:")
log(tabP[["OR", "OR_lo", "OR_hi", "p"]].round(4).to_string())

I = tabP.loc["bcg_x_mh"]
span = float(np.log10(I.OR_hi / I.OR_lo))
cross = I.OR_lo < 1 < I.OR_hi
log(f"\n>>> INTERACCION BCG x MH: OR = {I.OR:.3f}  IC95 % [{I.OR_lo:.3f}, {I.OR_hi:.3f}]  p = {I.p:.3f}")
log(f"    IC cruza 1: {cross}; amplitud log10(hi/lo) = {span:.2f} ordenes de magnitud -> "
