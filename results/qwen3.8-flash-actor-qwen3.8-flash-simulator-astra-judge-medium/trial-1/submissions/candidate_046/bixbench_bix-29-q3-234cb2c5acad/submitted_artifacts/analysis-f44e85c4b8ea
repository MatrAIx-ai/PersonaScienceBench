def add(tag, fr, yname, preds=None, headline=False, note=""):
    s = build(fr)
    try:
        r = fit_ordinal(s, yname, preds=preds)
        note2 = ""
        if not stable(r):
            if preds is None and s[yname].nunique() > 3:
                s = s.assign(sev_c=np.where(s[yname] >= 3, 2, s[yname]))
                r = fit_ordinal(s, "sev_c")
                note2 = "; se colapso 3+4 para lograr convergencia"
                if not stable(r):
                    note2 += "; AUN ASI INESTABLE"
            else:
                note2 = "; INESTABLE (no converge o SE explosivo)"
        b, V = "bcg_x_mh", r.cov_params()
        se, e = float(np.sqrt(V.loc[b, b])), float(r.params[b])
        rows.append(dict(model=tag, n=int(r.nobs), OR=np.exp(e), lo=np.exp(e - 1.96 * se),
                         hi=np.exp(e + 1.96 * se), p=float(r.pvalues[b]), headline=headline,
                         note=(note + note2).strip("; ")))
    except Exception as exc:
        rows.append(dict(model=tag, n=len(s), OR=np.nan, lo=np.nan, hi=np.nan, p=np.nan,
                         headline=headline, note=f"ERROR {type(exc).__name__}: {exc}"))


