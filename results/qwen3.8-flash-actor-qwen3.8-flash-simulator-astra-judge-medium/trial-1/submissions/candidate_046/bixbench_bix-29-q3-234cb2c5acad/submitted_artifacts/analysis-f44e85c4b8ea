def aehs_to_grade(h):
    """Mapeo declarado AEHS(0-7) -> escala AESEV(1-4) para el marco n=194."""
    if pd.isna(h):
        return np.nan
    h = int(round(h))
    return 1 if h <= 1 else (4 if h >= 4 else h)


