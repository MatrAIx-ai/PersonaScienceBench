               if pt["p"] >= 0.05 else
               "AVISO: se rechaza proporcionalidad (p<0.05); el OR unico es un promedio entre umbrales"))
log("\n  (b) OR de la interaccion por umbral acumulativo (logit binario k vs >k) - comprobacion dirigida:")
log("  " + pt["by_threshold"].round(3).to_string(index=False).replace("\n", "\n  "))
if "Q" in pt:
    log(f"  Heterogeneidad entre umbrales: Q={pt['Q']:.2f} gl={pt['Q_df']} p={pt['Q_p']:.3f} "
        f"(aproximada: los logs acumulativos estan correlacionados positivamente => Q conservadora)")
    if pt["Q_p"] < 0.05:
        log("  AVISO: el OR de interaccion varia entre umbrales; el OR unico es un promedio.")
else:
    log(f"  ADVERTENCIA (datos escasos): solo {pt['estimable']} de {pt['J']-1} umbrales acumulativos es "
