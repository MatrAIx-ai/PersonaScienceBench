# --------------------------------------------------------------- modelado
PRED = ["bcg", "mh_prev", "bcg_x_mh", "patients_seen_o", "age_mid", "female"]


def build(fr):
    s = fr.copy()
    s["bcg_x_mh"] = s.bcg * s.mh_prev
    return s


def fit_ordinal(s, yname, collapse=False, preds=None):
    preds = preds or PRED
    y = s[yname].astype(float).values
    y = y - np.nanmin(y)
    if collapse:
        y = np.where(y >= 2, 2, y)          # niveles ya desplazados: colapsa 3+4
    r = OrderedModel(y, s[preds].astype(float), disp=False).fit(method="bfgs", maxiter=3000,
                                                                maxcor=40, gtol=1e-6)
    return r


def stable(r):
    conv = bool(r.mle_retvals.get("converged", False)) if hasattr(r, "mle_retvals") else False
    return conv and np.isfinite(r.bse).all() and (r.bse < 25).all()


def slope_names(r):
    return [p for p in r.params.index if not re.match(r"^\d+/\d+$", p)]


def or_table(r):
    b, V = r.params, r.cov_params()
    rows = []
    for nm in slope_names(r):
        se = float(np.sqrt(V.loc[nm, nm]))
        e = float(b[nm])
        rows.append((nm, np.exp(e), np.exp(e - 1.96 * se), np.exp(e + 1.96 * se), float(r.pvalues[nm]), e, se))
    return pd.DataFrame(rows, columns=["term", "OR", "OR_lo", "OR_hi", "p", "beta", "se"]).set_index("term")


def contrast(r, cvec, name):
    names = slope_names(r)
    b = r.params[names]
    c = pd.Series(0.0, index=names)
    c.update(cvec)
    e = float(c @ b)
    se = float(np.sqrt(c.values @ r.cov_params().loc[names, names].values @ c.values))
    z = e / se
    return dict(name=name, OR=np.exp(e), lo=np.exp(e - 1.96 * se), hi=np.exp(e + 1.96 * se),
                p=float(2 * (1 - 0.5 * (1 + math.erf(abs(z) / math.sqrt(2))))))


def prop_test(s, yname):
    """Diagnostico de odds proporcionales.
    (a) LR ordinal vs logit multinomial (BFGS, por que newton falla con matriz
        singular: 3 contrastes x 6 predictores = 18 parametros con n pequeno).
    (b) OR de la interaccion en cada logit acumulativo (umbral k vs >k):
        heterogeneidad del OR entre umbrales (test Q aproximado de Cochran)."""
    y = s[yname].astype(float).values
    y = y - y.min()
    X = s[PRED].astype(float)
    lev = np.unique(y)
    J = len(lev)
    ll_o = fit_ordinal(s, yname).llf
    try:
        mn = sm.MNLogit(y, X.values).fit(method="bfgs", maxiter=5000, maxfun=8000, disp=0, gtol=1e-4)
        lr = 2 * (mn.llf - ll_o)
        df = (J - 1) * len(PRED)
        p = float(stats.chi2.sf(max(lr, 0.0), df))
    except Exception as exc:
        lr, df, p = np.nan, (J - 1) * len(PRED), np.nan
        log(f"  [AVISO] logit multinomial no ajustable ({type(exc).__name__}); LR no disponible")
    out = dict(ll_o=ll_o, ll_m=(ll_o + lr / 2) if np.isfinite(lr) else np.nan, LR=lr, df=df, p=p, J=J)

    # (b) modelo por umbral
    rows = []
    for k in lev[1:]:
        yb = (y >= k).astype(int)
        if yb.sum() < 4 or (1 - yb).sum() < 4:
            rows.append((int(k), np.nan, np.nan, np.nan, int(yb.sum())))
            continue
        try:
            lg = sm.Logit(yb, sm.add_constant(X.values)).fit(method="newton", maxiter=200, disp=0)
            j = list(["const"] + PRED).index("bcg_x_mh")
            b_, se_ = lg.params[j], lg.bse[j]
            rows.append((int(k), float(np.exp(b_)), float(np.exp(b_ - 1.96 * se_)),
                         float(np.exp(b_ + 1.96 * se_)), int(yb.sum())))
        except Exception:
            lg = sm.GLM(yb, sm.add_constant(X.values), family=sm.families.Binomial()).fit(maxiter=300)
            j = list(["const"] + PRED).index("bcg_x_mh")
            b_, se_ = lg.params[j], lg.bse[j]
            rows.append((int(k), float(np.exp(b_)), float(np.exp(b_ - 1.96 * se_)),
                         float(np.exp(b_ + 1.96 * se_)), int(yb.sum())))
    out["by_threshold"] = pd.DataFrame(rows, columns=["umbral_ge", "OR_inter", "lo", "hi", "n_eventos"])
    tb = out["by_threshold"]
    tb["estimable"] = (tb["n_eventos"] >= 20) & np.isfinite(tb["lo"]) & np.isfinite(tb["hi"]) & (tb["lo"] > 0)
    out["estimable"] = int(tb["estimable"].sum())
    ok = tb[tb.estimable].reset_index(drop=True)
    if len(ok) >= 2:
        se_l = ((np.log(ok["OR_inter"]) - np.log(ok["lo"])) / 1.96) ** 2
        w = 1.0 / se_l
        mbar = np.sum(w * np.log(ok["OR_inter"])) / np.sum(w)
        Q = float(np.sum(w * (np.log(ok["OR_inter"]) - mbar) ** 2))
        out["Q"] = Q
        out["Q_df"] = len(ok) - 1
        out["Q_p"] = float(stats.chi2.sf(Q, out["Q_df"]))
    return out


