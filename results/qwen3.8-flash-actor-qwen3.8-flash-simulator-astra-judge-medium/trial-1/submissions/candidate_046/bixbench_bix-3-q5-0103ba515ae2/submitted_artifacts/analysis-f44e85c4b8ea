#!/usr/bin/env python3
"""
BixBench bix-3-q5 - Differential expression by EXACT BINOMIAL TEST on three
paired tissue comparisons of the Paroxetine 2017 RNA-seq deposition.

Approved design (researcher sign-off):
  PRIMARY (A): per-gene exact binomial (sign test) on the DIRECTION of the paired
               change across 30 animals, p0=0.5, two-sided, ties discarded.
  SENSITIVITY (B): per-gene exact binomial on pooled normalized counts, expected
               proportion from global library-scale factor.
  Threshold: raw p<0.05 (literal "5% threshold"); BH-FDR reported as a check only.
  Pre-registered decision rule: comparison with FEWEST significant genes =
  "negligible effects"; ratio vs the other two reported. No outlier exclusion.

canary GUID bixbench:5c36:062a66b0-6ed1-4559-85c7-1ba7440f05c3
"""
import json, os, time
import numpy as np
import pandas as pd
from scipy.stats import binomtest

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
OUT = "results"; os.makedirs(OUT, exist_ok=True)
CACHE = os.path.join(OUT, "normcount_cache.npz")
TISSUES = ["baseline_blood", "dentate_gyrus", "final_blood"]
CONTRASTS = [
    ("Final blood vs Baseline blood",   "baseline_blood", "final_blood"),
    ("Dentate gyrus vs Baseline blood", "baseline_blood", "dentate_gyrus"),
    ("Dentate gyrus vs Final blood",    "final_blood",    "dentate_gyrus"),
]
EXPR_FRAC, LFC_CUT, P_CUT = 0.80, 1.0, 0.05
t0 = time.time(); log = []
def say(*a):
    s = " ".join(str(x) for x in a); print(s, flush=True); log.append(s)

def bh(p):
    p = np.asarray(p, float); n = p.size
    o = np.argsort(p, kind="mergesort"); ps = p[o]
    q = ps * n / np.arange(1, n + 1)
    q = np.minimum.accumulate(q[::-1])[::-1]
    out = np.empty(n); out[o] = np.clip(q, 0, 1); return out

ms = pd.read_excel(XLSX, sheet_name="Mapping_statistics")
if os.path.exists(CACHE):
    z = np.load(CACHE, allow_pickle=True)
    genes, Xmat, cols = z["genes"], z["X"], list(z["cols"])
    say(f"[cache] loaded NormCount matrix {Xmat.shape}")
else:
    hdr = pd.read_excel(XLSX, sheet_name="NormCount", header=None, nrows=4)
    df = pd.read_excel(XLSX, sheet_name="NormCount", header=None, skiprows=4)
    genes = df[1].astype(str).to_numpy(); cols = hdr.iloc[3, 2:92].tolist()
    Xmat = df.iloc[:, 2:92].to_numpy(dtype=float)
    np.savez_compressed(CACHE, genes=genes, X=Xmat, cols=np.array(cols))
    say(f"[load] NormCount: {Xmat.shape[0]} genes x {Xmat.shape[1]} samples ({time.time()-t0:.1f}s)")

X = pd.DataFrame(Xmat, index=genes, columns=cols)
meta = ms.set_index("Code")[["Sample ID", "Response", "Tissue"]].copy()
meta["animal"] = meta["Sample ID"].str.split("_").str[-2]
assert list(meta.index) == cols
chk = meta.groupby("animal").agg(n=("Tissue","size"), nt=("Tissue","nunique"), nr=("Response","nunique"))
say(f"[design] animals={len(chk)} | all 3 tissues & 1 response: "
    f"{bool(((chk.n==3)&(chk.nt==3)&(chk.nr==1)).all())} | tissue x response cells="
    f"{pd.crosstab(meta.Tissue, meta.Response).values.ravel().tolist()}")

say("[data] normalized (non-integer) counts; no ERCC spike-ins (Ercc1-8 are endogenous "
    "DNA-repair genes); 0 duplicate genes; no outlier exclusion applied "
    "(direction test is robust by construction)")

# ------------------------------------------------- TEST A (primary): sign test
rows, per_gene = [], {}
for name, A, B in CONTRASTS:
    a = meta[meta.Tissue == A].sort_values("animal"); b = meta[meta.Tissue == B].sort_values("animal")
    assert (a["animal"].to_numpy() == b["animal"].to_numpy()).all(), "pairing failed"
    Xa = X[a.index].to_numpy(); Xb = X[b.index].to_numpy()
    keep = ((Xa > 0).mean(1) >= EXPR_FRAC) & ((Xb > 0).mean(1) >= EXPR_FRAC)
    d = np.log2((Xb[keep] + 0.5) / (Xa[keep] + 0.5))
    up = (d > 0).sum(1); dn = (d < 0).sum(1); tie = (d == 0).sum(1)
    med = np.median(d, axis=1)
    t1 = time.time()
    p = np.array([binomtest(int(u), int(u+m), 0.5).pvalue if (u+m) > 0 else 1.0
                  for u, m in zip(up, dn)])
    say(f"[A] {name}: expressed genes={int(keep.sum())} | informative n/gene="
        f"{int(np.median(up+dn))} | median ties={np.median(tie):.0f} | {time.time()-t1:.1f}s")
    padj = bh(p)
    rows.append(dict(comparison=name, A_reference=A, B_test=B, n_animals=30,
        genes_tested=int(keep.sum()), n_up_sig=int(((p<P_CUT)&(up>dn)).sum()),
        n_dn_sig=int(((p<P_CUT)&(dn>up)).sum()), n_sig_raw=int((p<P_CUT).sum()),
        pct_sig_raw=round(100.0*(p<P_CUT).mean(),2), n_sig_fdr=int((padj<P_CUT).sum()),
        pct_sig_fdr=round(100.0*(padj<P_CUT).mean(),2), median_p=round(float(np.median(p)),4),
        q25_p=round(float(np.percentile(p,25)),6),
        n_medLFC_ge1=int((np.abs(med)>=LFC_CUT).sum()), n_medLFC_ge2=int((np.abs(med)>=2).sum()),
        n_sig_and_LFC1=int(((p<P_CUT)&(np.abs(med)>=LFC_CUT)).sum()),
        mean_abs_medLFC=round(float(np.abs(med).mean()),3)))
    per_gene[name] = pd.DataFrame(dict(gene=genes[keep], up=up, dn=dn, ties=tie,
                                       median_log2FC=np.round(med,4), p=p, padj=padj))
A_df = pd.DataFrame(rows)

# ------------------------------- TEST B (sensitivity): pooled-count binomial
rowsB = []
for name, A, B in CONTRASTS:
    ca = meta.index[meta.Tissue == A].tolist(); cb = meta.index[meta.Tissue == B].tolist()
    Sa = X[ca].sum(axis=1).to_numpy(); Sb = X[cb].sum(axis=1).to_numpy()
    la = X[ca].sum().mean(); lb = X[cb].sum().mean(); p0 = la/(la+lb)
    tot = Sa + Sb
    ok = np.round(tot) >= 1  # need integer n>=1 for the exact binomial
    k = np.round(Sb[ok]).astype(np.int64); n = np.round(tot[ok]).astype(np.int64)
    t1 = time.time()
    pb = np.array([binomtest(int(kk), int(nn), float(p0)).pvalue for kk, nn in zip(k, n)])
    fb = bh(pb)
    rowsB.append(dict(comparison=name, p0_expected=round(float(p0),5),
        lib_scale_A=round(la), lib_scale_B=round(lb), genes_tested=int(ok.sum()),
        n_sig_raw=int((pb<P_CUT).sum()), pct_sig_raw=round(100.0*(pb<P_CUT).mean(),2),
        n_sig_fdr=int((fb<P_CUT).sum()), pct_sig_fdr=round(100.0*(fb<P_CUT).mean(),2),
        median_p=float(np.median(pb))))
    say(f"[B] {name}: genes={int(ok.sum())} p0={p0:.4f} | {time.time()-t1:.1f}s")
B_df = pd.DataFrame(rowsB)

# ------------------- SECONDARY: Final vs Baseline split by Response (n=10)
rowsS = []
for resp in ["Control", "good_responder", "bad_responder"]:
    a = meta[(meta.Tissue=="baseline_blood")&(meta.Response==resp)].sort_values("animal")
    b = meta[(meta.Tissue=="final_blood")&(meta.Response==resp)].sort_values("animal")
    Xa = X[a.index].to_numpy(); Xb = X[b.index].to_numpy()
    keep = ((Xa>0).mean(1)>=EXPR_FRAC)&((Xb>0).mean(1)>=EXPR_FRAC)
    d = np.log2((Xb[keep]+0.5)/(Xa[keep]+0.5)); up=(d>0).sum(1); dn=(d<0).sum(1)
    p = np.array([binomtest(int(u),int(u+m),0.5).pvalue if (u+m)>0 else 1.0 for u,m in zip(up,dn)])
    rowsS.append(dict(Response=resp, n_animals=len(a), genes_tested=int(keep.sum()),
        n_sig_raw=int((p<P_CUT).sum()), pct_sig_raw=round(100.0*(p<P_CUT).mean(),2),
        median_p=round(float(np.median(p)),4), n_sig_fdr=int((bh(p)<P_CUT).sum())))
S_df = pd.DataFrame(rowsS)

# ------- CROSS-CHECK with the deposition's own DESeq blocks (NOT the answer)
hdr = pd.read_excel(XLSX, sheet_name="NormCount", header=None, nrows=4)
whole = pd.read_excel(XLSX, sheet_name="NormCount", header=None, skiprows=4,
                      usecols=list(range(92, 188)))
prof = {}
for t in TISSUES:
    for r in ["all","Control","good_responder","bad_responder"]:
        cs = meta.index[(meta.Tissue==t)&((r=="all")|(meta.Response==r))].tolist()
        prof[f"{t}|{r}"] = np.log2(X[cs].mean(1).to_numpy()+1)
P = pd.DataFrame(prof, index=genes)
Lp = np.log2(X.mean(1).to_numpy()+1)

def best_match(vec):
    v = np.log2(np.asarray(vec, float)+1); out, bv = None, -2.0
    for kk in P.columns:
        w = P[kk].to_numpy(); m = np.isfinite(v)&np.isfinite(w)&(w>0)
        if m.sum() < 2000: continue
        rho = np.corrcoef(v[m], w[m])[0,1]
        if rho > bv: bv, out = rho, kk
    return out, round(bv,3)

cross = []
for i, c in enumerate(range(98, 171, 9), 1):
    sub = whole.iloc[:, c-92:c-92+9].copy(); sub.columns = hdr.iloc[3, c:c+9].tolist()
    pa = pd.to_numeric(sub["pval"], errors="coerce")
    lg = pd.to_numeric(sub["log2FoldChange"], errors="coerce")
    mA, rA = best_match(pd.to_numeric(sub["baseMeanA"], errors="coerce"))
    mB, rB = best_match(pd.to_numeric(sub["baseMeanB"], errors="coerce"))
    cross.append(dict(block=f"Comparison{i}", n_pval=int(pa.notna().sum()),
        n_p_lt_005=int((pa<0.05).sum()),
        n_padj_lt_005=int((pd.to_numeric(sub["padj"], errors="coerce")<0.05).sum()),
        DEG_flag_U=int((whole.iloc[:, 87+(i-1)]=="U").sum()),
        DEG_flag_D=int((whole.iloc[:, 87+(i-1)]=="D").sum()),
        median_abs_lfc=round(float(np.nanmedian(np.abs(lg))),3),
        inferredA=mA, r_A=rA, inferredB=mB, r_B=rB))
C_df = pd.DataFrame(cross)

# ------------------------------------------------------------------- outputs
A_df.to_csv(f"{OUT}/A_primary_sign_binomial.csv", index=False)
B_df.to_csv(f"{OUT}/B_sensitivity_pooled_counts.csv", index=False)
S_df.to_csv(f"{OUT}/C_secondary_by_response.csv", index=False)
C_df.to_csv(f"{OUT}/D_deposition_deseq_crosscheck.csv", index=False)
for name, d in per_gene.items():
    key = name.replace(" vs ", "__vs__").replace(" ", "_")
    d.to_csv(f"{OUT}/pergene_{key}.csv.gz", index=False, compression="gzip")

say("\n===== TEST A (PRIMARY): exact binomial on paired direction, p0=0.5, two-sided, ties dropped =====")
say(A_df.to_string(index=False))
say("\n===== TEST B (SENSITIVITY): exact binomial on pooled normalized counts, p0=library scale =====")
say(B_df.to_string(index=False))
say("\n===== SECONDARY: Final vs Baseline by Response =====")
say(S_df.to_string(index=False))
say("\n===== CROSS-CHECK: deposition DESeq blocks (context only, NOT the answer) =====")
say(C_df.to_string(index=False))

sig = A_df.set_index("comparison")["n_sig_raw"].sort_values()
say("\nPre-registered rule: fewest significant genes = 'negligible effects'.")
say(f"ranking(A raw p<0.05): {list(sig.items())}")
r2 = sig.iloc[1]/max(int(sig.iloc[0]),1); r3 = sig.iloc[2]/max(int(sig.iloc[0]),1)
say(f"ratio 2nd/min = {r2:.2f}x ; 3rd/min = {r3:.2f}x")
sigB = B_df.set_index("comparison")["n_sig_raw"].sort_values()
say(f"ranking(B raw p<0.05): {list(sigB.items())}")
say(f"A and B agree on the minimum: {sig.index[0] == sigB.index[0]}")
fdr_rank = A_df.set_index("comparison")["n_sig_fdr"].sort_values()
say(f"ranking(A BH-FDR<0.05): {list(fdr_rank.items())}")
say(f"FDR ranking equals raw ranking: {list(fdr_rank.index)==list(sig.index)}")
say(f"\nTOTAL TIME {time.time()-t0:.1f}s")

with open(f"{OUT}/run_log.txt","w") as fh: fh.write("\n".join(log)+"\n")
json.dump({"A": A_df.to_dict("records"), "B": B_df.to_dict("records"),
           "S": S_df.to_dict("records"), "cross": C_df.to_dict("records"),
           "winner_A": sig.index[0], "winner_B": sigB.index[0],
           "ratio_2nd_over_min": round(r2,2), "ratio_3rd_over_min": round(r3,2),
           "fdr_rank_same": bool(list(fdr_rank.index)==list(sig.index))},
          open(f"{OUT}/summary.json","w"), indent=1, default=str)
