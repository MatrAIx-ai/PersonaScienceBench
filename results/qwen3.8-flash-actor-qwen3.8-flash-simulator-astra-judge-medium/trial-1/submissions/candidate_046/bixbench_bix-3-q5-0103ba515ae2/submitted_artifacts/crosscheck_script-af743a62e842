#!/usr/bin/env python3
"""Identify what the deposition's 9 precomputed DESeq 'Comparison N' blocks actually
compare, and quantify effect-size separation between the three tissue contrasts.
canary GUID bixbench:5c36:062a66b0-6ed1-4559-85c7-1ba7440f05c3"""
import numpy as np, pandas as pd, itertools, json
XLSX="data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"; OUT="results"
z=np.load(f"{OUT}/normcount_cache.npz", allow_pickle=True)
genes=list(z["genes"]); X=pd.DataFrame(z["X"], index=genes, columns=list(z["cols"]))
ms=pd.read_excel(XLSX, sheet_name="Mapping_statistics").set_index("Code")
ms["animal"]=ms["Sample ID"].str.split("_").str[-2]
hdr=pd.read_excel(XLSX, sheet_name="NormCount", header=None, nrows=4)
w=pd.read_excel(XLSX, sheet_name="NormCount", header=None, skiprows=4, usecols=range(92,188))

TISS=["baseline_blood","dentate_gyrus","final_blood"]; RESP=["Control","good_responder","bad_responder"]
mean={ (t,r): X[ms.index[(ms.Tissue==t)&(ms.Response==r)]].mean(axis=1).to_numpy()
       for t in TISS for r in RESP }
cand=[(t,r1,r2) for t in TISS for r1,r2 in itertools.permutations(RESP,2)]
cand+= [(t1,t2,None) for (t1,t2) in itertools.combinations(TISS,2)]   # tissue-level contrasts
rows=[]
for i,c in enumerate(range(98,171,9),1):
    sub=w.iloc[:,c-92:c-92+9].copy(); sub.columns=hdr.iloc[3,c:c+9].tolist()
    lg=pd.to_numeric(sub["log2FoldChange"],errors="coerce").to_numpy()
    ok=np.isfinite(lg)
    best=[]
    for cu in cand:
        if cu[2] is None:
            v=np.log2((mean[(cu[1],"all")] if False else X[ms.index[ms.Tissue==cu[1]]].mean(axis=1).to_numpy())+0.5)-\
              np.log2(X[ms.index[ms.Tissue==cu[0]]].mean(axis=1).to_numpy()+0.5)
            lbl=f"TISSUE {cu[1]} vs {cu[0]}"
        else:
            t,r1,r2=cu
            v=np.log2(mean[(t,r2)]+0.5)-np.log2(mean[(t,r1)]+0.5)
            lbl=f"{t}: {r2} vs {r1}"
        rr=np.corrcoef(lg[ok],v[ok])[0,1]
        sgn=(np.sign(lg[ok])==np.sign(v[ok])).mean()
        best.append((rr,sgn,lbl))
    best.sort(reverse=True)
    top=best[0]
    tis=[b for b in best if b[2].startswith("TISSUE")]
    rows.append(dict(block=f"Comparison{i}", n_p_lt_005=int((pd.to_numeric(sub["pval"],errors="coerce")<0.05).sum()),
                     best_match=top[2], pearson_r=round(top[0],3), sign_agree=round(top[1],3),
                     best_tissue_contrast=max(tis)[2], r_tissue_contrast=round(max(tis)[0],3)))
C=pd.DataFrame(rows)
print(C.to_string(index=False))
C.to_csv(f"{OUT}/E_block_identification.csv", index=False)

# effect-size separation for the 3 tissue contrasts (test A output)
CON=[("Final blood vs Baseline blood","baseline_blood","final_blood"),
     ("Dentate gyrus vs Baseline blood","baseline_blood","dentate_gyrus"),
     ("Dentate gyrus vs Final blood","final_blood","dentate_gyrus")]
rows=[]
for name,A,B in CON:
    key=f"{OUT}/pergene_{name.replace(' vs ','__vs__').replace(' ','_')}.csv.gz"
    d=pd.read_csv(key)
    rows.append(dict(comparison=name, genes=len(d),
        sig_p05=int((d.p<0.05).sum()), pct=round(100*(d.p<0.05).mean(),1),
        sig_and_lfc1=int(((d.p<0.05)&(d.median_log2FC.abs()>=1)).sum()),
        pct_lfc1=round(100*((d.p<0.05)&(d.median_log2FC.abs()>=1)).mean(),1),
        med_abs_lfc=round(d.median_log2FC.abs().median(),3),
        q90_abs_lfc=round(d.median_log2FC.abs().quantile(.9),3),
        med_min_p_across=round(d.p.min(),3)))
T=pd.DataFrame(rows)
print("\n", T.to_string(index=False))
base=T.set_index("comparison")
m=base.loc["Final blood vs Baseline blood"]
print("\nSEPARATION ratios (others / Final-vs-Baseline):")
for k in ["sig_p05","sig_and_lfc1","med_abs_lfc","q90_abs_lfc"]:
    print(f"  {k}: DGvsBase={base.loc['Dentate gyrus vs Baseline blood',k]/max(m[k],1e-12):.2f}x  "
          f"DGvsFinal={base.loc['Dentate gyrus vs Final blood',k]/max(m[k],1e-12):.2f}x")
T.to_csv(f"{OUT}/F_effectsize_separation.csv", index=False)
