#!/usr/bin/env python3
"""Robustness of the ranking for the three paired tissue contrasts under different
expression filters and p-value thresholds (same exact binomial sign test).
canary GUID bixbench:5c36:062a66b0-6ed1-4559-85c7-1ba7440f05c3"""
import numpy as np, pandas as pd
from scipy.stats import binomtest
XLSX="data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"; OUT="results"
z=np.load(f"{OUT}/normcount_cache.npz",allow_pickle=True)
X=pd.DataFrame(z["X"],index=list(z["genes"]),columns=list(z["cols"]))
ms=pd.read_excel(XLSX,sheet_name="Mapping_statistics").set_index("Code")
ms["animal"]=ms["Sample ID"].str.split("_").str[-2]
CON=[("Final vs Baseline blood","baseline_blood","final_blood"),
     ("DG vs Baseline blood","baseline_blood","dentate_gyrus"),
     ("DG vs Final blood","final_blood","dentate_gyrus")]
FILT={"any>0 in both (min expr)":None, ">=80% (main)":0.80, ">=100%":1.00, "median>=5 both":"med5"}
rows=[]
for fname,f in FILT.items():
    for name,A,B in CON:
        a=ms[ms.Tissue==A].sort_values("animal"); b=ms[ms.Tissue==B].sort_values("animal")
        Xa=X[a.index].to_numpy(); Xb=X[b.index].to_numpy()
        if f is None: keep=(Xa>0).any(1)&(Xb>0).any(1)
        elif f=="med5": keep=(np.median(Xa,axis=1)>=5)&(np.median(Xb,axis=1)>=5)
        else: keep=((Xa>0).mean(1)>=f)&((Xb>0).mean(1)>=f)
        d=np.log2((Xb[keep]+0.5)/(Xa[keep]+0.5)); up=(d>0).sum(1); dn=(d<0).sum(1)
        p=np.array([binomtest(int(u),int(u+m),0.5).pvalue if (u+m)>0 else 1.0 for u,m in zip(up,dn)])
        rows.append(dict(filter=fname, comparison=name, genes=int(keep.sum()),
            sig_p05=int((p<0.05).sum()), pct_p05=round(100*(p<0.05).mean(),1),
            sig_p001=int((p<0.001).sum()), pct_p001=round(100*(p<0.001).mean(),1),
            median_p=round(float(np.median(p)),5)))
R=pd.DataFrame(rows)
print(R.to_string(index=False))
R.to_csv(f"{OUT}/G_robustness_filters.csv",index=False)
print("\nminimum per filter:")
for f,g in R.groupby("filter"):
    s=g.set_index("comparison").sig_p05.sort_values()
    r2=s.iloc[1]/max(int(s.iloc[0]),1)
    print(f"  {f:26s} -> {s.index[0]:24s} ({int(s.iloc[0])} sig, ratio to 2nd = {r2:.2f}x)")
