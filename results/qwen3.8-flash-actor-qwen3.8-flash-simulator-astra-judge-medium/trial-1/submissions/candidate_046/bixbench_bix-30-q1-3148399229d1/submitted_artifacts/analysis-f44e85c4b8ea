#!/usr/bin/env python3
"""
bix-30-q1: % of miRNAs with significant differential expression (patient vs control)
before multiple-testing correction.
Data: data/pone.0150501.s002.xls (genuine BIFF8/OLE2; no xlrd & no network available,
so a minimal read-only OLE2+BIFF8 parser is included).

Primary test : Student two-sample t-test (equal_var=True), two-sided, on raw Ct values.
Sensitivity  : Welch (equal_var=False); Mann-Whitney U (context only).
Answer       : (# miRNAs with raw p < 0.05, Student) / 175 * 100, 1 decimal.
BH-FDR 0.05 survivor count: CONTEXT ONLY, not the answer.

Deterministic analysis; environment recorded at runtime.
Run: python analysis/mirna_de_analysis.py
"""
import struct, sys, csv, platform
import numpy as np
from scipy import __version__ as scipy_version
from scipy import stats
from statsmodels.stats.multitest import multipletests

XLS = 'data/pone.0150501.s002.xls'

print("# run: python analysis/mirna_de_analysis.py")
print(f"# python={platform.python_version()} numpy={np.__version__} scipy={scipy_version}")
print(f"# file: {XLS}")

# ---------------------------------------------------------------- OLE2 reader
def ole_streams(path):
    data = open(path, 'rb').read()
    assert data[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1', 'not an OLE2/CFB file'
    ssz = 1 << struct.unpack_from('<H', data, 30)[0]
    mini_sz = 1 << struct.unpack_from('<H', data, 32)[0]
    num_fat = struct.unpack_from('<I', data, 44)[0]
    dir_start = struct.unpack_from('<I', data, 48)[0]
    mini_cutoff = struct.unpack_from('<I', data, 56)[0]
    mini_fat_start = struct.unpack_from('<I', data, 60)[0]
    num_mini_fat = struct.unpack_from('<I', data, 64)[0]
    sector = lambda sid: data[512 + sid*ssz: 512 + (sid+1)*ssz]
    fat = []
    for sid in [struct.unpack_from('<I', data, 76+4*i)[0] for i in range(109)][:num_fat]:
        if sid < 0xFFFFFFFA:
            fat += list(struct.unpack('<%dI' % (ssz//4), sector(sid)))
    def chain(start):
        out, s, seen = [], start, set()
        while s < 0xFFFFFFFA and s < len(fat) and s not in seen:
            seen.add(s); out.append(s); s = fat[s]
        return out
    dir_raw = b''.join(sector(s) for s in chain(dir_start))
    ents = []
    for i in range(0, len(dir_raw), 128):
        e = dir_raw[i:i+128]
        nlen = struct.unpack_from('<H', e, 64)[0]
        name = e[:max(0, nlen-2)].decode('utf-16-le', 'replace') if nlen >= 2 else ''
        ents.append((name, e[66], struct.unpack_from('<I', e, 116)[0],
                     struct.unpack_from('<I', e, 120)[0]))
    root = next(e for e in ents if e[1] == 5)
    ministream = b''.join(sector(s) for s in chain(root[2]))
    mfat = (list(struct.unpack('<%dI' % (len(b''.join(sector(s) for s in chain(mini_fat_start)))/4),
                  b''.join(sector(s) for s in chain(mini_fat_start)))) if num_mini_fat else [])
    streams = {}
    for name, etype, start, size in ents:
        if etype != 2:
            continue
        if size >= mini_cutoff:
            streams[name] = b''.join(sector(s) for s in chain(start))[:size]
        else:
            out, s = b'', start
            while s < 0xFFFFFFFA and s < len(mfat):
                out += ministream[s*mini_sz:(s+1)*mini_sz]; s = mfat[s]
            streams[name] = out[:size]
    return streams

# ------------------------------------------------- minimal BIFF8 sheet reader
def read_first_sheet(wb):
    recs, pos = [], 0
    while pos + 4 <= len(wb):
        rec, ln = struct.unpack_from('<HH', wb, pos)
        recs.append((rec, wb[pos+4:pos+4+ln])); pos += 4 + ln
    sst = []
    for i, (r, b) in enumerate(recs):
        if r == 0x00FC:  # SST
            unique = struct.unpack_from('<I', b, 4)[0]
            bufs = [b[8:]]
            j = i + 1
            while j < len(recs) and recs[j][0] == 0x003C:
                bufs.append(recs[j][1]); j += 1
            bi = off = 0
            def read(n):
                nonlocal bi, off
                out = b''
                while n > 0:
                    cur = bufs[bi]; avail = len(cur) - off
                    if avail >= n:
                        out += cur[off:off+n]; off += n; n = 0
                    else:
                        out += cur[off:]; n -= avail; bi += 1; off = 0
                return out
            for _ in range(unique):
                cch = struct.unpack('<H', read(2))[0]
                grbit = read(1)[0]
                rich, ext, fHigh = grbit & 0x08, grbit & 0x04, grbit & 0x01
                run_c = struct.unpack('<H', read(2))[0] if rich else 0
                ext_sz = struct.unpack('<I', read(4))[0] if ext else 0
                s = read(cch*2).decode('utf-16-le', 'replace') if fHigh else read(cch).decode('latin-1')
                if run_c: read(run_c*4)
                if ext_sz: read(ext_sz)
                sst.append(s)
            break
    start = next(i for i, (r, b) in enumerate(recs)
                 if r == 0x0809 and len(b) >= 4 and struct.unpack_from('<H', b, 2)[0] == 0x0010)
    end = next(i for i, (r, b) in enumerate(recs) if r == 0x000A and i > start)
    def rk_val(rk):
        if rk & 0x02:
            v = rk >> 2
            if v & (1 << 29): v -= (1 << 30)
            v = float(v)
        else:
            v = struct.unpack('<d', b'\x00'*4 + struct.pack('<I', rk & 0xFFFFFFFC))[0]
        return v / 100.0 if rk & 0x01 else v
    cells = {}
    for r, b in recs[start:end]:
        if r == 0x0203:      # NUMBER
            row, col, _, val = struct.unpack_from('<HHHd', b, 0); cells[(row, col)] = val
        elif r == 0x00FD:    # LABELSST
            row, col, _, isst = struct.unpack_from('<HHHI', b, 0)
            cells[(row, col)] = sst[isst] if isst < len(sst) else '#SST?'
        elif r == 0x027E:    # RK
            row, col, _, rk = struct.unpack_from('<HHHI', b, 0); cells[(row, col)] = rk_val(rk)
        elif r == 0x00BD:    # MULRK
            row, c0 = struct.unpack_from('<HH', b, 0)
            c1 = struct.unpack_from('<H', b, len(b)-2)[0]
            o = 4
            for col in range(c0, c1+1):
                _, rk = struct.unpack_from('<HI', b, o); o += 6
                cells[(row, col)] = rk_val(rk)
        elif r == 0x0204:    # LABEL
            row, col = struct.unpack_from('<HH', b, 0)
            cch = struct.unpack_from('<H', b, 6)[0]
            cells[(row, col)] = b[9:9+cch*(2 if b[8] else 1)].decode('utf-16-le' if b[8] else 'latin-1', 'replace')
    maxr = max(r for r, _ in cells); maxc = max(c for _, c in cells)
    return [[cells.get((r, c), '') for c in range(maxc+1)] for r in range(maxr+1)]

# ----------------------------------------------------------------- load table
streams = ole_streams(XLS)
wb = streams.get('Workbook') or streams.get('Book')
assert wb is not None, 'Workbook stream not found'
grid = read_first_sheet(wb)

title  = grid[0][0]
samples = grid[1][1:]
mirna_rows = grid[2:]
print(f"# title: {title!r}")
print(f"# samples: {samples}")

pat_idx = [j for j, s in enumerate(samples) if s.startswith('P_')]
ctl_idx = [j for j, s in enumerate(samples) if s.startswith('C_')]
print(f"# patients ({len(pat_idx)}): {[samples[j] for j in pat_idx]}")
print(f"# controls ({len(ctl_idx)}): {[samples[j] for j in ctl_idx]}")

# -------------------------------------------------------- integrity assertions
def die(msg):
    print(f"INTEGRITY FAILURE: {msg}"); sys.exit(1)

if len(mirna_rows) != 175: die(f'expected 175 miRNA rows, got {len(mirna_rows)}')
if len(samples) != 20: die(f'expected 20 sample columns, got {len(samples)}')
if len(pat_idx) != 10 or len(ctl_idx) != 10: die('group sizes != 10/10')
names = [r[0] for r in mirna_rows]
if len(set(names)) != 175: die('duplicate miRNA names')
if any(not str(n).startswith('hsa-') for n in names): die('non-miRNA row label found')

num_cells, nan_cells = 0, 0
matrix = np.full((175, 20), np.nan)
for i, r in enumerate(mirna_rows):
    for j in range(20):
        v = r[1+j]
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            matrix[i, j] = float(v); num_cells += 1
        elif isinstance(v, str) and v.upper() in ('NAN', '#ERR', '#VALUE!', '#NUM!', '#N/A'):
            nan_cells += 1
        elif v == '' or v is None:
            die(f'empty cell at {names[i]} / {samples[j]}')
        else:
            die(f'unparseable cell {v!r} at {names[i]} / {samples[j]}')
# NOTE: true invariant is 3478 numeric + 22 literal 'NAN' = 3500 = 175x20 complete grid.
# (An earlier exploratory count reported '3500 numeric' because float('NAN') parses to
#  NaN in Python; corrected here.) Grid must be fully accounted for.
if num_cells != 3478: die(f'expected 3478 numeric cells, got {num_cells}')
if nan_cells != 22: die(f'expected 22 NAN cells, got {nan_cells}')
if num_cells + nan_cells != 3500: die('numeric+NAN != 3500 (=175x20)')
for i in range(175):
    if (~np.isnan(matrix[i, pat_idx])).sum() < 2: die(f'{names[i]}: patient group n<2')
    if (~np.isnan(matrix[i, ctl_idx])).sum() < 2: die(f'{names[i]}: control group n<2')
print(f"# INTEGRITY OK: 175 rows x 20 cols complete grid; numeric=3478, NAN={nan_cells}, total=3500; per-group n>=2 for all miRNAs")
if float(np.nanmin(matrix)) < 5 or float(np.nanmax(matrix)) > 45:
    die('Ct outside plausible qPCR range 5-45')
print(f"# Ct range: {np.nanmin(matrix):.3f} .. {np.nanmax(matrix):.3f}")

# --------------------------------------------------------------------- tests
P = matrix[:, pat_idx]; C = matrix[:, ctl_idx]
complete_case = ~(np.isnan(P).any(1) | np.isnan(C).any(1))
res = []
for i, n in enumerate(names):
    pv, cv = P[i][~np.isnan(P[i])], C[i][~np.isnan(C[i])]
    res.append(dict(name=n, mean_p=pv.mean(), mean_c=cv.mean(), n_p=len(pv), n_c=len(cv),
                    p_student=stats.ttest_ind(pv, cv, equal_var=True).pvalue,
                    p_welch=stats.ttest_ind(pv, cv, equal_var=False).pvalue,
                    p_mw=stats.mannwhitneyu(pv, cv, alternative='two-sided').pvalue,
                    complete=bool(complete_case[i])))

n_sig_s = sum(r['p_student'] < 0.05 for r in res)
n_sig_w = sum(r['p_welch'] < 0.05 for r in res)
n_sig_mw = sum(r['p_mw'] < 0.05 for r in res)

print("\n" + "="*78)
print("PRIMARY (Student, equal_var=True, two-sided, raw Ct, alpha=0.05 UNADJUSTED)")
print(f"  significant / total = {n_sig_s} / 175  ->  {n_sig_s/175*100:.1f}%")
print("SENSITIVITY (Welch, equal_var=False):")
print(f"  significant / total = {n_sig_w} / 175  ->  {n_sig_w/175*100:.1f}%")
print(f"  counts coincide (Welch == Student): {n_sig_s == n_sig_w}")
print(f"Mann-Whitney U (context only): {n_sig_mw} / 175 -> {n_sig_mw/175*100:.1f}%")

ps = np.array([r['p_student'] for r in res])
rej, _, _, _ = multipletests(ps, alpha=0.05, method='fdr_bh')
n_bh = int(rej.sum())
print(f"\nCONTEXT (NOT the answer): survivors to BH-FDR 0.05 = {n_bh} ({n_bh/175*100:.1f}%)")

cc = [r for r in res if r['complete']]
n_nan_rows = sum(not r['complete'] for r in res)
n_sig_cc = sum(r['p_student'] < 0.05 for r in cc)
sig_names = {r['name'] for r in res if r['p_student'] < 0.05}
sig_in_nan_rows = sorted(n for n in sig_names if not next(r for r in res if r['name']==n)['complete'])
print("\nDENOMINATOR SENSITIVITY (primary Student p-values):")
print(f"  (A) all listed miRNAs        : {n_sig_s} / 175 = {n_sig_s/175*100:.1f}%   <-- MAIN ANSWER")
print(f"  (B) drop {n_nan_rows} rows w/ any NAN   : {n_sig_cc} / {175-n_nan_rows} = {n_sig_cc/(175-n_nan_rows)*100:.1f}%")
print(f"      (significant miRNAs located in dropped NAN rows: {sig_in_nan_rows or 'none'})")

print("\nSIGNIFICANT miRNAs (Student p<0.05), sorted by p  [raw p, no correction]")
print(f"{'miRNA':<16} {'meanCt_P':>9} {'meanCt_C':>9} {'dCt(P-C)':>9} {'n_P':>4} {'n_C':>4} {'p_Student':>11} {'p_Welch':>11} {'p_MW':>10} {'BH':>4}")
for r in sorted((r for r in res if r['p_student'] < 0.05), key=lambda x: x['p_student']):
    bh = 'yes' if rej[names.index(r['name'])] else 'no'
    print(f"{r['name']:<16} {r['mean_p']:>9.3f} {r['mean_c']:>9.3f} {r['mean_p']-r['mean_c']:>9.3f} "
          f"{r['n_p']:>4} {r['n_c']:>4} {r['p_student']:>11.3e} {r['p_welch']:>11.3e} {r['p_mw']:>10.3e} {bh:>4}")
print(f"\np_min = {ps.min():.3e}  ({names[int(ps.argmin())]})")
print(f"\nANSWER: {n_sig_s}/175 = {n_sig_s/175*100:.1f}% (Student two-sided, raw p<0.05, no multiple-testing correction)")

with open('analysis/results_full.csv', 'w', newline='') as f:
    w = csv.DictWriter(f, fieldnames=list(res[0].keys()))
    w.writeheader(); w.writerows(res)
print("# full per-miRNA p-values written to analysis/results_full.csv")
