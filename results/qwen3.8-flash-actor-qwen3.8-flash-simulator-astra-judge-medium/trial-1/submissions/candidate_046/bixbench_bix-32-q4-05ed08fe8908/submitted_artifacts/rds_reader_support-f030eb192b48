"""Minimal pure-Python reader for RDS (R serialized) files.

Implements the R serialization format (R-data / serial.c) for the subset used by
DESeq2 ResultsDataFrames saved with saveRDS: NILVALUE, SYMSXP, LISTSXP, CLOSXP,
ENVSXP, CHARSXP, LGLSXP, INTSXP, REALSXP, STRSXP, VECSXP, RAWSXP, plus object
attributes, factor levels and the reference stack (refs 256-511 = base env /
base namespace / empty env).
"""
import gzip, zlib, struct

SYPS = {0: "NILVALUE", 1: "SYMSXP", 2: "LISTSXP", 3: "CLOSXP", 4: "ENVSXP",
        5: "PROMSXP", 6: "LANGSXP", 7: "SPECIALSXP", 8: "BUILTINSXP",
        9: "CHARSXP", 10: "LGLSXP", 11: "INTSXP", 12: "REALSXP",
        13: "CMPLXSXP", 14: "STRSXP", 15: "DOTSXP", 16: "ANYSXP",
        17: "VECSXP", 18: "EXPRSXP", 19: "BCODESXP", 20: "EXTPTRSXP",
        21: "WEAKREFSXP", 22: "RAWSXP"}

BASE_ENV, BASE_NS, EMPTY_ENV = "<baseenv>", "<basenamespace>", "<emptyenv>"


class RAtomic:
    def __init__(self, kind, values, attrs=None, is_factor=False):
        self.kind, self.values, self.attrs = kind, values, (attrs or {})
        self.is_factor = is_factor
        self.labels = None
        if is_factor:
            lv = self.attrs.get("levels") or []
            self.labels = [lv[i - 1] if i and 0 < i <= len(lv) else None
                           for i in self.values]
    def __len__(self):
        return len(self.values)
    def __repr__(self):
        v = self.labels if self.is_factor else self.values
        return f"RAtomic({self.kind}, n={len(self.values)}, factor={self.is_factor}, attrs={list(self.attrs)}, head={v[:4]})"


class RVector:
    """A generic list / data.frame (VECSXP) with attributes."""
    def __init__(self, values, attrs=None, names=None):
        self.values, self.attrs = values, (attrs or {})
        self.names = names
    def __len__(self):
        return len(self.values)
    def __repr__(self):
        return f"RVector(n={len(self.values)}, attrs={list(self.attrs)})"


class Opaque:
    def __init__(self, kind, extra=None):
        self.kind, self.extra = kind, extra
    def __repr__(self):
        return f"<{self.kind}>"


class RReader:
    def __init__(self, buf):
        self.b, self.i = buf, 0
        self.stack = [None] * 256 + [BASE_ENV, BASE_NS, EMPTY_ENV]

    # --- low level -------------------------------------------------------
    def raw(self, n):
        d = self.b[self.i:self.i + n]
        self.i += n
        assert len(d) == n, "unexpected EOF at offset %d" % self.i
        return d
    def int32(self):
        return struct.unpack(">i", self.raw(4))[0]
    def string(self):
        n = self.int32()
        return None if n == -1 else self.raw(n).decode("utf-8", "replace")

    # --- object reading --------------------------------------------------
    def read_obj(self):
        f = self.int32()
        has_attr = (f >> 9) & 1
        levels = (f >> 12) & 7
        t = (f >> 16) & 511
        ref = f & 255
        if ref != 255:
            return self.stack[ref]
        if t == 0:
            out = None
            self.stack.append(out)          # NILVALUE also pushed per serial.c
        else:
            out = self.read_type(t, levels)
        if has_attr:
            out = self.read_attributes(out)
            self.stack[-1] = out            # re-register post-attr (serial.c)
        return out

    def read_type(self, t, levels):
        if t in (1, 9):                     # SYMSXP / CHARSXP -> string
            s = self.string()
            self.stack.append(s)
            return s
        if t == 2:                          # LISTSXP
            self.stack.append(None)
            out = self.read_pairlist()
            self.stack[-1] = out
            return out
        if t == 4:                          # ENVSXP
            self.int32()
            env = [self.read_obj() for _ in range(2)]
            self.stack.append(Opaque("ENVSXP", env))
            return self.stack[-1]
        if t == 3:                          # CLOSXP
            self.stack.append(Opaque("CLOSXP"))
            return self.stack[-1]
        if t == 5:                          # PROMSXP
            self.int32()
            vals = [self.read_obj() for _ in range(3)]
            self.stack.append(Opaque("PROMSXP", vals))
            return self.stack[-1]
        if t in (6, 7, 8, 15, 16, 19, 20, 21):
            self.stack.append(Opaque(SYPS[t]))
            return self.stack[-1]
        if t in (10, 11):                   # LGL / INT
            n = self.int32()
            v = list(struct.unpack(">%di" % n, self.raw(4 * n))) if n else []
            self.stack.append(None)
            out = RAtomic(SYPS[t], v, is_factor=bool(levels))
            self.stack[-1] = out
            return out
        if t == 12:                         # REAL
            n = self.int32()
            v = list(struct.unpack(">%dd" % n, self.raw(8 * n))) if n else []
            self.stack.append(None)
            out = RAtomic("REALSXP", v, is_factor=bool(levels))
            self.stack[-1] = out
            return out
        if t == 13:                         # CMPLX
            n = self.int32()
            v = struct.unpack(">%dd" % (2 * n), self.raw(16 * n)) if n else []
            self.stack.append(Opaque("CMPLXSXP", v))
            return self.stack[-1]
        if t == 14:                         # STRSXP
            n = self.int32()
            self.stack.append(None)
            vals = []
            for _ in range(n):
                s = self.string()
                vals.append(s)
                self.stack.append(s)
            out = RAtomic("STRSXP", vals, is_factor=bool(levels))
            self.stack[-1] = out
            return out
        if t in (17, 18):                   # VECSXP / EXPRSXP
            n = self.int32()
            self.stack.append(None)
            vals = [self.read_obj() for _ in range(n)]
            out = RVector(vals)
            self.stack[-1] = out
            return out
        if t == 22:                         # RAWSXP
            n = self.int32()
            self.raw(n)
            self.stack.append(Opaque("RAWSXP"))
            return self.stack[-1]
        raise AssertionError("unhandled type %s (%d)" % (SYPS.get(t, "?"), t))

    def read_pairlist(self):
        """Read a pairlist (no tags) -> list of objects; stops at NIL."""
        out = []
        while True:
            f = self.int32()
            if f == 0:                      # NIL -> end of pairlist
                break
            ref = f & 255
            if ref != 255:                  # terminated by a reference (baseenv)
                out.append(self.stack[ref])
                break
            assert ((f >> 16) & 511) == 2, "expected LISTSXP cell, got %d" % ((f >> 16) & 511)
            out.append(self.read_obj())
        return out

    def read_pairlist_named(self):
        """Read a tagged pairlist (attributes) -> dict."""
        d = {}
        while True:
            f = self.int32()
            if f == 0:
                break
            ref = f & 255
            if ref != 255:
                d.setdefault("<ref%d>" % ref, self.stack[ref])
                break
            assert ((f >> 16) & 511) == 2, "expected tagged LISTSXP cell"
            tf = self.int32()
            tt = (tf >> 16) & 511
            trec = tf & 255
            if tt == 0:
                tag = None
            elif trec != 255:
                tag = self.stack[trec]
            else:
                assert tt == 1, "unexpected tag type %d" % tt
                tag = self.string()
                self.stack.append(tag)
            d[tag] = self.read_obj()
        return d

    def read_attributes(self, obj):
        attrs = self.read_pairlist_named()
        names = attrs.get("names")
        if isinstance(obj, RAtomic):
            obj.attrs = attrs
            return obj
        if isinstance(obj, RVector):
            obj.attrs = attrs
            if isinstance(names, RAtomic):
                obj.names = names.labels if names.is_factor else names.values
            return obj
        return RVector([obj], attrs)


def load_rds(path):
    data = open(path, "rb").read()
    if data[:2] == b"\x1f\x8b":
        data = gzip.decompress(data)
    elif data[:3] == b"BZh":
        data = zlib.decompressobj(-15).decompress(data[3:])
    assert data[:2] == b"X\n", data[:2]
    fmt = struct.unpack(">i", data[2:6])[0]
    assert fmt in (2, 3), fmt
    return RReader(data[6:]).read_obj()


def data_frame(obj):
    """(rownames, {col_name: RAtomic}) from an R data.frame object."""
    assert isinstance(obj, RVector), type(obj)
    cols = dict(zip(obj.names, obj.values))
    rn = obj.attrs.get("row.names")
    if isinstance(rn, RAtomic):
        rn = rn.labels if rn.is_factor else rn.values
    return rn, cols
