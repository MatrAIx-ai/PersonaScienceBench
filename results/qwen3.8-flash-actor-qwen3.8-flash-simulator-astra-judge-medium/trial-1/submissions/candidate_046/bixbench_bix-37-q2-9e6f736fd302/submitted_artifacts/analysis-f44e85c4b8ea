#!/usr/bin/env python3
"""
BixBench bix-37-q2
Question: "What is the base protein levels of ENO1 in normal samples according to
the proteomic data? Round your answer to 3 significant figures."

Approved method (researcher-approved plan):
  - Read sheet "Tumor vs Normal" of data/Proteomic_data .xlsx (header row 1).
  - Drop the empty junk columns 列1 / 列2.
  - Filter gene.str.strip().str.upper() == "ENO1", corroborated by
    protein accession P06733 and Entrez gene_id "2023".
  - Take the `Normal` column DIRECTLY: it is a single pre-computed, LINEAR
    (non-log) intensity summary for the Normal group (verified: Ratio ~= Tumor/Normal
    and log2(Tumor/Normal) ~= log2FC, i.e. contrast direction is Tumor/Normal, so the
    basal side is `Normal`).
  - Do NOT reconstruct from Ratio/FC/log2FC (those are rounded to 2 decimals in the file).
  - MeRIP_RNA_result.xlsx is EXCLUDED from the calculation: it holds m6A/meRIP-seq and
    RNA log2FC metrics only (no protein intensity columns). Declared in traceability.
  - Round to 3 significant figures; report scientific notation + decimal equivalent.
"""
import math
import numpy as np
import pandas as pd

SRC = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"

def sig3(x: float) -> float:
    """Round to 3 significant figures."""
    if x == 0:
        return 0.0
    return round(x, -int(math.floor(math.log10(abs(x)))) + 2)

def main() -> None:
    df = pd.read_excel(SRC, sheet_name=SHEET)
    n_raw = df.shape
    df = df.drop(columns=[c for c in ("列1", "列2") if c in df.columns])
    print(f"[schema] raw shape={n_raw}; after dropping empty 列1/列2 -> {df.shape}")
    print(f"[schema] columns = {list(df.columns)}")
    print(f"[schema] Normal dtype = {df['Normal'].dtype}; NaN in Normal = {df['Normal'].isna().sum()}")
    print(f"[scale ] Normal min={df['Normal'].min():.6g} median={df['Normal'].median():.6g} "
          f"max={df['Normal'].max():.6g}  -> LINEAR intensity scale (not log)")

    # --- (a)+(b) locate ENO1 --------------------------------------------------
    key = df["gene"].astype(str).str.strip().str.upper()
    eno = df[key == "ENO1"].copy()
    print(f"\n[locate] rows with gene==ENO1 (stripped/upper): {len(eno)}")
    print(f"[locate] unique ENO1 rows: {len(eno) == 1}")
    print("[locate] corroboration -> protein accession P06733 rows: "
          f"{int((df['protein'].astype(str).str.strip() == 'P06733').sum())} "
          f"(duplicated P06733 accessions = "
          f"{int((df['protein'].astype(str).str.strip() == 'P06733').sum()) - 1})")
    print(f"[locate] corroboration -> gene_id == '2023' (Entrez ENO1) rows: "
          f"{int((df['gene_id'].astype(str).str.strip() == '2023').sum())}")
    print(f"[locate] duplicates: duplicated gene symbols -> ENO1 count = {int((key == 'ENO1').sum())}; "
          f"duplicated 'protein' values in whole file = {int(df['protein'].duplicated().sum())}")
    assert len(eno) == 1, "expected exactly one ENO1 row"
    assert int((df["protein"].astype(str).str.strip() == "P06733").sum()) == 1

    row = eno.iloc[0]
    print("\n[evidence a] ENO1 row:")
    print(row[["protein", "Description", "gene", "gene_id", "Normal", "Tumor",
               "Ratio", "FC", "log2FC", "p.value", "adj.Pval", "is_sig", "compare"]].to_string())
    print(f"[evidence a] raw Normal (full precision) = {row['Normal']!r}")

    # --- (c) coherence check: contrast direction Tumor/Normal ----------------
    normal_val = float(row["Normal"])
    tumor_val = float(row["Tumor"])
    recon = normal_val * (2 ** float(row["log2FC"]))
    print("\n[evidence c] coherence checks")
    print(f"  Tumor/Normal            = {tumor_val / normal_val:.6f}   (file Ratio/FC = {row['Ratio']}, {row['FC']})")
    print(f"  log2(Tumor/Normal)      = {math.log2(tumor_val / normal_val):.6f}   (file log2FC = {row['log2FC']})")
    print(f"  Normal * 2**log2FC      = {recon:.6g}   vs Tumor = {tumor_val:.6g} "
          f"(rel. diff = {abs(recon - tumor_val) / tumor_val:.3%} <- file log2FC rounded to 2 decimals)")

    # whole-file confirmation that Normal is linear, not log, and is Tumor's counterpart
    ratio_calc = df["Tumor"] / df["Normal"]
    print(f"  whole file: corr(Tumor/Normal, Ratio) = {np.corrcoef(ratio_calc, df['Ratio'])[0, 1]:.12f}")
    print(f"  whole file: max |log2FC - log2(Tumor/Normal)| = "
          f"{(df['log2FC'] - np.log2(ratio_calc)).abs().max():.4f} (rounding-level)")

    # --- (d) rounding to 3 significant figures -------------------------------
    s3 = sig3(normal_val)
    exp = int(math.floor(math.log10(abs(normal_val))))
    mant = normal_val / (10 ** exp)
    sci = f"{mant:.2f}e{exp}"
    dec = f"{s3:,.0f}"
    print("\n[evidence d] rounding to 3 significant figures")
    print(f"  raw                 = {normal_val:.10f}")
    print(f"  mantissa/exponent   = {mant:.10f} x 10^{exp}")
    print(f"  sig3 (numeric)      = {s3}")
    print(f"  scientific (3 s.f.) = {sci}")
    print(f"  decimal equivalent  = {dec}")

    print("\n[traceability] MeRIP_RNA_result.xlsx EXCLUDED: m6A/meRIP-seq + RNA log2FC metrics only"
          " (columns GeneID, m_log2FC, m_pvalue, g_log2FC, g_pvalue, m6A, DEG, m6A_DEG, gene_id,"
          " gene_name, Annotation, Class); no protein intensity (Normal/Tumor) columns.")
    print("[assumptions] units are arbitrary file-internal linear intensity; `Normal` is an"
          " unverifiable per-group summary statistic (no per-sample matrix in the file); no unit"
          " conversion or n reported.")

    print(f"\nFINAL ANSWER: {sci} (decimal equivalent: {dec})")

if __name__ == "__main__":
    main()
