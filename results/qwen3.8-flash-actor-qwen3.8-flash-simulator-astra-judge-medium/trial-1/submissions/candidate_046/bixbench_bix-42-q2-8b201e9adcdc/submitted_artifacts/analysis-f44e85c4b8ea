"""
analysis_rna_skewness.py
Question: What is the skewness of the distribution of RNA expression data
(highly/minimally right or left skewed, or approximately normal)?

Main answer: Fisher-Pearson skewness g1 (bias-corrected) over ALL values of
data/COAD__geneExp.xls pooled (genes x samples), linear scale as supplied,
zeros retained, no gene filtering.

Robustness diagnostics: per-sample and per-gene skew distributions, global
mean vs median / quartiles, and a log2(x+1) sensitivity note (NOT the answer).
"""
import numpy as np
import pandas as pd
from scipy.stats import skew

SRC = "data/COAD__geneExp.xls"  # actually TSV despite .xls extension

def classify(g1: float) -> str:
    """Explicit thresholds:
       |g1| <  0.5 -> approximately normal (minimally skewed)
       0.5 <= |g1| < 1 -> minimally/moderately skewed
       |g1| >= 1 -> highly skewed
       sign: >0 right, <0 left."""
    direction = "right-skewed" if g1 > 0 else ("left-skewed" if g1 < 0 else "symmetric")
    a = abs(g1)
    if a < 0.5:
        intensity = "approximately normal (minimally)"
    elif a < 1.0:
        intensity = "minimally/moderately"
    else:
        intensity = "highly"
    return f"{intensity} {direction}"

def main():
    # --- Load (TSV despite .xls extension) ---
    df = pd.read_csv(SRC, sep="\t", low_memory=False)
    genes = df["GeneSymbol"].to_numpy()
    mat = df.drop(columns=["GeneSymbol"])
    vals = mat.to_numpy(dtype=np.float64)  # raises if any non-numeric -> reported explicitly

    n_genes, n_samples = vals.shape
    n_vals = vals.size
    n_nan = int(np.isnan(vals).sum())
    n_zeros = int((vals == 0).sum())
    n_neg = int((vals < 0).sum())
    n_dup_genes = int(len(genes) - pd.Series(genes).nunique())

    print(f"Matrix shape: {n_genes} genes x {n_samples} samples")
    print(f"Total values pooled: {n_vals:,}")
    print(f"NaN values: {n_nan}")
    print(f"Zeros: {n_zeros:,} ({100*n_zeros/n_vals:.2f}%)")
    print(f"Negatives: {n_neg}")
    print(f"Duplicate gene symbols: {n_dup_genes}")

    # --- MAIN ANSWER: pooled g1 (bias-corrected Fisher-Pearson) ---
    g1_pooled = float(skew(vals.ravel(), bias=False))
    # cross-check with pandas
    g1_pandas = float(pd.Series(vals.ravel()).skew())  # pandas uses bias-corrected too
    print("\n=== MAIN ANSWER (pooled, linear scale, zeros kept) ===")
    print(f"g1 (scipy, bias-corrected) = {g1_pooled:.4f}")
    print(f"g1 (pandas .skew cross-check) = {g1_pandas:.4f}")
    print(f"Classification: {classify(g1_pooled)}")

    # --- Descriptive evidence ---
    print("\n=== Descriptive stats (pooled) ===")
    q = np.percentile(vals, [25, 50, 75])
    print(f"mean = {vals.mean():.2f}  median = {q[1]:.2f}  std = {vals.std():.4f}")
    print(f"Q1 = {q[0]:.2f}  Q3 = {q[2]:.2f}  min = {vals.min():.2f}  max = {vals.max():.2f}")
    print(f"mean/median ratio = {vals.mean()/q[1]:.2f}")

    # --- Robustness: per-sample and per-gene skewness ---
    gs = skew(vals, axis=0, bias=False)   # per sample (column)
    gg = skew(vals, axis=1, bias=False)   # per gene (row)
    def summarize(name, arr):
        arr = arr[~np.isnan(arr)]  # NaN for constant rows (zero variance); reported separately
        print(f"{name}: median = {np.median(arr):.3f}, IQR = [{np.percentile(arr,25):.3f}, {np.percentile(arr,75):.3f}], "
              f"range = [{np.nanmin(arr):.3f}, {np.nanmax(arr):.3f}], "
              f"frac >= 1 (highly right) = {np.mean(arr >= 1):.2%}")
    print("\n=== Robustness diagnostics (secondary) ===")
    summarize("Per-sample skewness (axis=0)", gs)
    print(f"Per-gene rows with zero variance (skew undefined/NaN): {int(np.isnan(gg).sum())}")
    summarize("Per-gene skewness (axis=1)", gg)

    # --- Sensitivity: log2(x+1) -- NOT the answer ---
    g1_log = float(skew(np.log2(vals + 1.0).ravel(), bias=False))
    print(f"\n[Sensitivity, NOT the answer] g1 on log2(x+1) = {g1_log:.4f} -> {classify(g1_log)}")

if __name__ == "__main__":
    main()
