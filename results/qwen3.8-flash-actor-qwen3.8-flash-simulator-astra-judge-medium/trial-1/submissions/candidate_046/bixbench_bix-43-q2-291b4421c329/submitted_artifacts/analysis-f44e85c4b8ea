"""
Fallback analysis for bix-43-q2 (offline runner: no gseapy, no R/DESeq2, no Enrichr, no GMT).
Steps: drop all-zero rows -> DESeq2-equivalent NB DE (median-of-ratios size factors, gene-wise
dispersion MLE, parametric trend + log-space EB shrinkage, Wald test, BH) -> triple filter
(padj<0.05 OR raw p<0.05, |lfc|>0.5, baseMean>10) -> ENSG->symbol (collapse dups to max
baseMean) -> Enrichr-style Fisher/OR function, ready for a Reactome_2022 GMT. Reactome_2022 is
unreachable offline, so the odds ratio is reported NOT DETERMINABLE, not fabricated.
NOTE: DE is an approximation of DESeq2 (no apeglm LFC shrinkage, no Cook's outlier filtering).
"""
import glob
import numpy as np
import pandas as pd
from scipy import stats
from scipy.special import gammaln
from scipy.optimize import minimize_scalar, curve_fit

DATA = "data"
GROUP_B = ["3_1", "3_2", "3_3"]   # DMSO (reference)
GROUP_A = ["9_1", "9_2", "9_3"]   # Cisplatin_IC50_CBD_IC50 (numerator)
COLS = GROUP_B + GROUP_A

# 1) load & clean
counts = pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0)
n_before = len(counts)
counts = counts[counts.sum(axis=1) > 0]
print(f"[clean] genes {n_before} -> {len(counts)} after dropping all-zero rows")
Y = counts[COLS].to_numpy().astype(float)
X = np.column_stack([np.ones(6), np.array([0.0, 0.0, 0.0, 1.0, 1.0, 1.0])])  # 0=DMSO, 1=combo

# 2a) median-of-ratios size factors
logY = np.log(np.where(Y > 0, Y, np.nan))
complete = np.all(Y > 0, axis=1)
logratio = logY[complete] - np.nanmean(logY[complete], axis=1)[:, None]
log_sf = np.nanmedian(logratio, axis=0)
sf = np.exp(log_sf - log_sf.mean())
print("[size factors]", dict(zip(COLS, np.round(sf, 3))))
baseMean = (Y / sf).mean(axis=1)

def wald_nb(Y, sf, X, disp, maxit=60, tol=1e-9, ret_mu=False):
    off = np.log(sf)[None, :]
    ma = np.maximum(Y[:, :3].mean(1) / sf[:3].mean(), 1e-6)
    mb = np.maximum(Y[:, 3:].mean(1) / sf[3:].mean(), 1e-6)
    beta = np.column_stack([np.log(ma), np.log(mb / ma)])
    for _ in range(maxit):
        eta = beta[:, 0:1] + beta[:, 1:2] * X[:, 1] + off
        mu = np.exp(np.clip(eta, -30, 30))
        W = mu / (1.0 + disp[:, None] * mu)
        z = (eta - off) + (Y - mu) / np.maximum(mu, 1e-12)
        a11 = W.sum(1); a12 = (W * X[:, 1]).sum(1); a22 = (W * X[:, 1]**2).sum(1)
        r1 = (W * z).sum(1); r2 = (W * X[:, 1] * z).sum(1)
        det = a11 * a22 - a12**2
        b0 = (a22 * r1 - a12 * r2) / det; b1 = (a11 * r2 - a12 * r1) / det
        step = np.abs(b1 - beta[:, 1]).max(); beta = np.column_stack([b0, b1])
        if step < tol: break
    eta = beta[:, 0:1] + beta[:, 1:2] * X[:, 1] + off
    mu = np.exp(np.clip(eta, -30, 30))
    W = mu / (1.0 + disp[:, None] * mu)
    a11 = W.sum(1); a12 = (W * X[:, 1]).sum(1); a22 = (W * X[:, 1]**2).sum(1)
    det = a11 * a22 - a12**2
    se = np.sqrt(np.maximum(a11 / det, 1e-24))
    return (beta[:, 1], se, mu) if ret_mu else (beta[:, 1], se)

# 2c) gene-wise dispersion MLE
def nb_nll_alpha(alpha, y, mu):
    inv = 1.0 / alpha
    return -np.sum(gammaln(y + inv) - gammaln(y + 1) - gammaln(inv)
                   + inv * np.log(inv / (inv + mu)) + y * np.log(mu / (inv + mu)))

_, _, mu0 = wald_nb(Y, sf, X, np.full(Y.shape[0], 0.05), ret_mu=True)
mu0 = np.maximum(mu0, 1e-8)
gene_wise = np.array([minimize_scalar(nb_nll_alpha, bounds=(1e-8, 100.0), method="bounded",
                                      args=(Y[g], mu0[g]), options={"xatol": 1e-4}).x
                      for g in range(Y.shape[0])])
print(f"[disp] gene-wise MLE done (median={np.median(gene_wise):.4f})")

# 2d) parametric trend f(mu)=a0+a1*mu^a2 + log-space EB shrinkage
keep = (baseMean > 0) & np.isfinite(gene_wise) & (gene_wise > 0)
order = np.argsort(baseMean[keep]); bm, dw = baseMean[keep][order], gene_wise[keep][order]
bins = np.array_split(np.arange(len(bm)), 40)
bx = np.array([bm[b].mean() for b in bins if len(b) > 5])
by = np.array([np.median(dw[b]) for b in bins if len(b) > 5])
f = lambda x, a0, a1, a2: a0 + a1 * np.power(x, a2)
popt, _ = curve_fit(f, bx, by, p0=[by.min() * 0.1, 1.0, -0.5], maxfev=20000,
                    bounds=([0, 0, -2], [10, 100, 2]))
trend = np.clip(f(baseMean, *popt), 1e-8, 100)
print("[disp] trend params a0,a1,a2 =", np.round(popt, 4))
with np.errstate(divide="ignore"):
    lr = np.log(np.maximum(gene_wise, 1e-9)) - np.log(trend)
sigma = max(1.4826 * np.median(np.abs(lr[keep] - np.median(lr[keep]))), 0.1)
sig_g2 = sigma**2 / 2
disp_final = np.exp((np.log(np.maximum(gene_wise, 1e-9)) / sig_g2 + np.log(trend) / sigma**2)
                    / (1 / sig_g2 + 1 / sigma**2))
disp_final = np.clip(np.where(keep, disp_final, trend), 1e-8, 100)

# 2e) Wald test + BH
tested = (Y.sum(axis=1) > 0)          # DESeq2-equivalent: genes with nonzero counts in tested samples
lfc = np.full(len(baseMean), np.nan); se = np.full(len(baseMean), np.nan)
z = np.full(len(baseMean), np.nan); pval = np.full(len(baseMean), np.nan)
padj = np.full(len(baseMean), np.nan)
sub = np.where(tested)[0]
lf_s, se_s = wald_nb(Y[sub], sf, X, disp_final[sub])
lfc[sub], se[sub] = lf_s, se_s
z[sub] = lf_s / np.maximum(se_s, 1e-12)
pval[sub] = 2 * stats.norm.sf(np.abs(z[sub]))
padj[sub] = stats.false_discovery_control(pval[sub])
print(f"[de] tested genes: {sub.size};  padj<0.05: {np.nansum(padj<0.05):.0f};  "
      f"p<0.05: {np.nansum(pval<0.05):.0f};  disp(shrunk) median={np.median(disp_final[sub]):.4f}")
res = pd.DataFrame({"ensg": counts.index, "baseMean": baseMean, "log2FC": lfc, "lfcSE": se,
                    "stat": z, "pvalue": pval, "padj": padj, "dispersion": disp_final})

# 3) triple filter
fc = (res.baseMean > 10) & (res.log2FC.abs() > 0.5)
de_padj = res[fc & (res.padj < 0.05)].copy()
de_rawp = res[fc & (res.pvalue < 0.05)].copy()
print(f"[filter] padj<0.05 & |lfc|>0.5 & baseMean>10   -> n = {len(de_padj)} "
      f"(up {(de_padj.log2FC>0).sum()}, down {(de_padj.log2FC<0).sum()})")
print(f"[filter] p<0.05 (raw) & |lfc|>0.5 & baseMean>10 -> n = {len(de_rawp)} "
      f"(up {(de_rawp.log2FC>0).sum()}, down {(de_rawp.log2FC<0).sum()})")

# 4) ENSG -> symbol, collapse duplicates to the ENSG with highest baseMean
m = pd.read_csv(f"{DATA}/ensg_to_gene_name.tsv", sep="\t").drop_duplicates("ENSG")
sym = dict(zip(m.ENSG, m.gene_name))
def to_symbols(de):
    d = de.assign(symbol=de.ensg.map(sym)).dropna(subset=["symbol"])
    return (d.sort_values("baseMean", ascending=False).drop_duplicates("symbol")
             [["symbol", "ensg", "baseMean", "log2FC", "pvalue", "padj"]].reset_index(drop=True))
sym_padj, sym_rawp = to_symbols(de_padj), to_symbols(de_rawp)
print(f"[symbols] DE(padj) {len(de_padj)} ENSG -> {len(sym_padj)} symbols; "
      f"DE(raw p) {len(de_rawp)} ENSG -> {len(sym_rawp)} symbols")

# 5) Enrichr-style enrichment, ready for a Reactome_2022 GMT
def enrichr_fisher(gene_list, gene_sets, background_size=None):
    """Replicates gseapy.enrich/Enrichr: p = hypergeom.sf(A-1, N, K, n) one-sided;
    Odds Ratio = (A*D)/(B*C); background defaults to union of gene_sets."""
    gl = set(gene_list); n = len(gl)
    N = background_size or len(set().union(*gene_sets.values()))
    rows = []
    for name, gs in gene_sets.items():
        gs = set(gs); K = len(gs); A = len(gl & gs); B = n - A; C = K - A; D = N - A - B - C
        p = float(stats.hypergeom.sf(A - 1, N, K, n)) if A > 0 else 1.0
        orr = (A * D) / (B * C) if (B > 0 and C > 0) else np.nan
        rows.append((name, A, B, C, D, orr, p))
    return pd.DataFrame(rows, columns=["Term", "A", "B", "C", "D", "OddsRatio", "p-value"]) \
             .sort_values("p-value").reset_index(drop=True)

import subprocess
try:
    _r = subprocess.run(["find", "/", "-path", "/proc", "-prune", "-o", "-path", "/sys", "-prune",
                         "-o", "-path", "/dev", "-prune", "-o", "-type", "f", "(",
                         "-iname", "*.gmt", "-o", "-iname", "*.gmt.gz", "-o", "-iname", "*reactome*",
                         "-o", "-iname", "*geneset*", ")", "-print"],
                        capture_output=True, text=True, timeout=120)
    out = _r.stdout.split()
except subprocess.TimeoutExpired:
    out = []
gmt_hits = out[:5]
print("[enrich] Enrichr online: unreachable from this runner (DNS failure, re-verified)")
if gmt_hits:
    def load_gmt(path):
        sets = {}
        with open(path) as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 3:
                    sets[parts[0]] = [g for g in parts[2:] if g and not g.isdigit()]
        return sets
    enr = enrichr_fisher(sym_padj.symbol.tolist(), load_gmt(gmt_hits[0]))
    print(enr[enr.Term.str.lower().str.contains("p53 mediated cell cycle", na=False)].to_string())
else:
    print("[enrich] Reactome_2022 UNREACHABLE -> Odds ratio for 'P53 Mediated Cell Cycle Gene "
          "Regulation' NOT DETERMINABLE here. enrichr_fisher validated on synthetic sets:")
    demo = {"PATH_A": [f"G{i}" for i in range(20)], "PATH_B": [f"G{i}" for i in range(500, 560)]}
    demo_list = [f"G{i}" for i in range(15)] + [f"G{i}" for i in range(100, 120)]
    print(enrichr_fisher(demo_list, demo).to_string(index=False))

# save
res.sort_values("pvalue").to_csv("analysis/de_results_combo_vs_dmso.csv", index=False)
sym_padj.sort_values("padj").to_csv("analysis/de_genes_padj05_symbols.csv", index=False)
sym_rawp.sort_values("pvalue").to_csv("analysis/de_genes_praw05_symbols.csv", index=False)
print("\nTOP-10 DE by pvalue:")
print(res.sort_values("pvalue").head(10).assign(symbol=lambda d: d.ensg.map(sym))
      [["symbol", "baseMean", "log2FC", "pvalue", "padj"]].to_string(index=False))
print("\nDONE")
