#!/usr/bin/env python3
"""
bix-43-q5 -- Primary mechanism enriched in the CBD/cisplatin COMBINATION treatment.

Design (fixed by researcher):
  headline  : Cisplatin_IC50_CBD_IC50 (9_1,9_2,9_3) vs DMSO (3_1,3_2,3_3)   [3v3]
  sensitivity: comb vs Untreated ; comb vs Cisplatin_IC50 ; comb vs CBD_IC50
  DE filter : baseMean > 10 AND |log2FC| > 0.5 AND nominal Wald p < 0.05 (BH padj reported)
  DE list   : pooled up+down
  enrich    : hypergeometric over-representation + BH == gseapy/Enrichr-equivalent ORA,
              library Reactome_2022 (gene symbols) supplied as a GMT.

TOOLING NOTE (documented in results/blocker_evidence.txt):
  gseapy, pydeseq2 and R/DESeq2 are NOT installed and the runner has NO network egress.
  -> DESeq2-equivalent implemented in numpy/scipy: median-of-ratios size factors, NB2
     dispersion MLE + trended empirical-Bayes shrinkage, NB Wald test, BH.
  -> Enrichr ORA implemented as the mathematically equivalent hypergeometric test
     (scipy.stats.hypergeom) + Benjamini-Hochberg: a gseapy-EQUIVALENT reimplementation,
     NOT gseapy itself.
  -> The enrichment step runs only if a Reactome_2022 GMT is reachable; otherwise it is
     recorded as NOT RUN. No hand-built or substituted gene-set library.
"""
import json, os, glob
import numpy as np
import pandas as pd
from scipy import stats
from scipy.special import gammaln
from scipy.optimize import curve_fit
from statsmodels.stats.multitest import multipletests

WS      = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA    = os.path.join(WS, "data")
RESULTS = os.path.join(WS, "results")
COMB, DMSO, UNT = "Cisplatin_IC50_CBD_IC50", "DMSO", "Untreated"
CIS, CBD = "Cisplatin_IC50", "CBD_IC50"
LOG = []
def log(*a):
    s = " ".join(str(x) for x in a); print(s); LOG.append(s)


def load_inputs():
    cnt  = pd.read_csv(os.path.join(DATA, "counts_raw_unfiltered.csv"), index_col=0)
    lay  = pd.read_csv(os.path.join(DATA, "sample_layout.csv"))
    map_ = pd.read_csv(os.path.join(DATA, "ensg_to_gene_name.tsv"), sep="\t")
    # real symbol only: rows where gene_name == ENSG carry no symbol (37,671 of 86,369)
    map_["symbol"] = map_.gene_name.where(map_.gene_name != map_.ENSG)
    sym = map_.drop_duplicates("ENSG").set_index("ENSG").symbol.reindex(cnt.index)
    # multi-ENSG -> same symbol: keep the ENSG with the highest mean normalised count
    grp = lay.set_index(lay.SampleID.str.replace("-", "_", regex=False)).Group
    cols = [c for c in cnt.columns if c in grp.index]
    assert set(cols) == set(cnt.columns), "sample layout does not cover all count columns"
    return cnt[cols], grp[cols], sym


def size_factors(cnt):
    """DESeq2 median-of-ratios, estimated on ALL 30 samples (global normalisation)."""
    ok = (cnt > 0).all(axis=1).values
    logc = np.log(cnt.values[ok])
    sf = np.exp(np.median(logc - logc.mean(axis=1)[:, None], axis=0))
    return pd.Series(sf / np.exp(np.mean(np.log(sf))), index=cnt.columns)


def _nb2_ll(y, mu, alpha):
    """NB2 log-likelihood; y,mu (G,n); alpha (G,A) -> (G,A)."""
    a = alpha[..., None]
    lm1 = np.log1p(a * mu[:, None, :])
    t = (gammaln(y[:, None, :] + 1.0 / a) - gammaln(1.0 / a)
         - gammaln(y + 1.0)[:, None, :]
         - lm1 / a + y[:, None, :] * (np.log(np.clip(a, 1e-300, None) * mu[:, None, :]) - lm1))
    return t.sum(axis=-1)


def dispersion_mle(y, mu, base_mean):
    """Gene-wise NB2 dispersion MLE (grid + curvature). Reported for transparency only:
    the calibrated Wald test uses the trended MoM dispersion (see dispersion_trend)."""
    G = y.shape[0]
    grid = np.concatenate([np.logspace(-5, 1.5, 80), [10.0, 25.0]])
    ll = np.empty((G, grid.size))
    step = 3000
    for i in range(0, G, step):
        j = min(step, G - i)
        ll[i:i + j] = _nb2_ll(y[i:i + j], mu[i:i + j], np.repeat(grid[None, :], j, 0))
    best = np.nanargmax(np.where(np.isfinite(ll), ll, -np.inf), axis=1)
    return grid[best].astype(float)


def dispersion_trend(norm_ctrl, norm_trt, base_mean, n_bins=30):
    """Trended NB2 dispersion by the method of moments, fitted as a0 + a1/baseMean.

    Per group: alpha = (Var - mu) / mu^2 (unbiased sample variance), the two groups are
    AVERAGED per gene, binned in log2(baseMean) taking the bin MEAN of values clipped to
    <=1, and the DESeq2-style parametric curve is fitted to the bin means.

    WHY mean and not median: a permutation null (40 random 3v3 relabellings of the same 6
    libraries, see results/calibration_permutation.csv) shows a median-based trend is badly
    anti-conservative (mean fraction of p<0.05 = 0.31) whereas the mean-based trend gives
    0.06 ~ the nominal 0.05.  Gene-wise MAP shrinkage was therefore NOT used: with n=3 per
    group the MLE is far too noisy, and the trended dispersion is the calibrated choice
    (this is edgeR's 'trended dispersion' behaviour rather than DESeq2's MAP).
    """
    def mom(c):
        mu = c.mean(axis=1); v = c.var(ddof=1, axis=1)
        return np.clip((v - mu) / np.maximum(mu, 1e-9) ** 2, 1e-6, 20.0)
    a = (mom(norm_trt) + mom(norm_ctrl)) / 2.0
    keep = np.isfinite(a) & (base_mean > 5)
    if keep.sum() < 500:
        return np.full(base_mean.shape, float(np.nanmedian(a[keep])) if keep.any() else 0.05), "flat dispersion (too few genes)"
    x = np.log2(np.clip(base_mean[keep], 1e-3, None)); yv = np.clip(a[keep], 1e-6, 1.0)
    qs = np.quantile(x, np.linspace(0, 1, n_bins + 1)); qs[0] -= 1e-9; qs[-1] += 1e-9
    b = np.clip(np.digitize(x, qs[1:-1]), 0, n_bins - 1)
    cx, cy, cw = [], [], []
    for j in range(n_bins):
        m = b == j
        if m.sum() >= 100:
            cx.append(np.median(x[m])); cy.append(np.mean(yv[m])); cw.append(int(m.sum()))
    if len(cx) < 5:
        return np.full(base_mean.shape, float(np.median(yv))), "flat dispersion (too few bins)"
    cx, cy, cw = np.array(cx), np.array(cy), np.array(cw, float)
    f = lambda xx, a0, a1_: a0 + a1_ / 2.0 ** xx
    popt, _ = curve_fit(f, cx, cy, sigma=1.0 / np.sqrt(cw),
                        p0=[np.median(cy), np.median(cy * 2 ** cx)], maxfev=40000,
                        bounds=([1e-7, 1e-7], [10.0, 1e6]))
    a_t = np.clip(f(np.log2(np.clip(base_mean, 1e-3, None)), *popt), 1e-6, 10.0)
    note = "trend a0=%.3g a1=%.3g bins=%d medianDisp=%.4f (MoM mean-based, permutation-calibrated)" % (
        popt[0], popt[1], len(cx), float(np.median(a_t)))
    return a_t, note


def permutation_calibration(norm, base_mean, sf_sub, n_perm=40, seed=7):
    """Type-I-error check: randomise the 3v3 labels over the same 6 libraries."""
    n = norm.shape[1]; h = n // 2
    rng = np.random.default_rng(seed); out = []
    for _ in range(n_perm):
        pm = rng.permutation(n); it = np.zeros(n, bool); it[pm[:h]] = True
        a, _ = dispersion_trend(norm[:, ~it], norm[:, it], base_mean)
        lp, lfc, _ = wald_from_q(norm[:, it].mean(1), norm[:, ~it].mean(1), a, sf_sub, it)
        out.append(((lp < 0.05).mean(), int(((lp < 0.05) & (abs(lfc) > 0.5) & (base_mean > 10)).sum())))
    o = np.array(out)
    return dict(n_perm=n_perm, mean_frac_p_lt_05=float(o[:, 0].mean()),
                de_median=float(np.median(o[:, 1])), de_q95=float(np.quantile(o[:, 1], 0.95)),
                de_max=int(o[:, 1].max()))


def wald_from_q(q_t, q_c, a, sf_sub, it):
    """Wald test on log2 fold change given group means of normalised counts."""
    mu = (np.where(it, q_t[:, None], 0.0) + np.where(~it, q_c[:, None], 0.0)) * sf_sub[None, :]
    w = mu / (1.0 + np.clip(a, 1e-9, None)[:, None] * mu)
    wt, wc = w[:, it].sum(axis=1), w[:, ~it].sum(axis=1)
    vb = 1.0 / np.where(wt > 0, wt, np.nan) + 1.0 / np.where(wc > 0, wc, np.nan)
    ok = (q_t > 0) & (q_c > 0) & np.isfinite(vb) & (vb > 0)
    lfc = np.log(np.clip(q_t, 1e-12, None) / np.clip(q_c, 1e-12, None)) / np.log(2.0)
    z = np.where(ok, (np.log(q_t) - np.log(q_c)) / np.sqrt(np.where(ok, vb, 1.0)), np.nan)
    p = np.where(ok, 2 * stats.norm.sf(np.abs(np.where(ok, z, 0.0))), 1.0)
    return p, lfc, vb


def bh(p):
    p = np.asarray(p, float); out = np.ones(p.size)
    m = np.isfinite(p) & (p > 0)
    if m.any(): out[m] = multipletests(p[m], method="fdr_bh")[1]
    return out


def wald_nb(counts, sf, grp_col, tested, trt, ctrl):
    """Trended-dispersion NB2 Wald test with library-size offsets (mu_ij = s_j * q_group)."""
    K = counts[tested].values.astype(float)
    svals = sf.reindex(counts.columns).values
    gvals = grp_col.reindex(counts.columns).values
    in_c = np.isin(gvals, [trt, ctrl])
    Kc, sc = K[:, in_c], svals[in_c]
    it = (gvals[in_c] == trt); ic = (gvals[in_c] == ctrl)
    nrm = Kc / sc[None, :]
    q_t = nrm[:, it].mean(axis=1); q_c = nrm[:, ic].mean(axis=1)
    base = nrm.mean(axis=1)
    mu = (np.where(it, q_t[:, None], 0.0) + np.where(ic, q_c[:, None], 0.0)) * sc[None, :]
    a_mle = dispersion_mle(Kc, mu, base)
    a_hat, note = dispersion_trend(nrm[:, ic], nrm[:, it], base)
    p, lfc, vb = wald_from_q(q_t, q_c, a_hat, sc, it)
    res = pd.DataFrame({"baseMean": base, "mean_norm_ctrl": q_c, "mean_norm_trt": q_t,
                        "log2FC": lfc, "dispersion": a_hat, "dispersion_mle": a_mle,
                        "stat_z": np.where(np.isfinite(vb) & (vb > 0),
                                           (np.log(np.clip(q_t, 1e-12, None) / np.clip(q_c, 1e-12, None))) / np.sqrt(np.where(np.isfinite(vb) & (vb > 0), vb, 1)), np.nan),
                        "pvalue": p}, index=counts.index[tested])
    res["pvalue"] = np.where(np.isfinite(p), p, np.nan)
    res["padj"] = bh(res.pvalue.values)
    return res, note


def collapse_symbols(res):
    """gene_symbol column + multi-ENSG->same symbol resolved by highest baseMean."""
    res = res.copy()
    res["gene_symbol"] = SYM.reindex(res.index)
    keep = res.groupby("gene_symbol").baseMean.idxmax()
    res["symbol_kept"] = res.index.isin(keep.dropna().values)      # True for the retained ENSG
    res["direction"] = np.where(res.log2FC > 0, "up", np.where(res.log2FC < 0, "down", "flat"))
    return res


def run_contrast(counts, sf, universe_mask, trt, ctrl, tag):
    keep = universe_mask & (counts.sum(axis=1) >= 5)
    res, note = wald_nb(counts, sf, GRP, keep, trt, ctrl)
    res = collapse_symbols(res)
    de = (res.pvalue < 0.05) & (res.log2FC.abs() > 0.5) & (res.baseMean > 10) & res.symbol_kept
    res["DE_p0.05_lfc0.5_bm10"] = de
    res.sort_values("pvalue").to_csv(os.path.join(RESULTS, f"de_table__{tag}.csv"))
    d = res[de]
    s = dict(contrast=f"{trt} vs {ctrl}", tested_genes=int(len(res)), DE_total=int(len(d)),
             DE_up=int((d.log2FC > 0).sum()), DE_down=int((d.log2FC < 0).sum()),
             DE_symbols=int(d.gene_symbol.nunique()),
             DE_padj_variant=int(((res.padj < .05) & (res.log2FC.abs() > .5) &
                                 (res.baseMean > 10) & res.symbol_kept).sum()),
             trend_fit=note)
    cols = ["gene_symbol", "log2FC", "baseMean", "mean_norm_ctrl", "mean_norm_trt",
            "dispersion", "stat_z", "pvalue", "padj", "direction"]
    d.sort_values("pvalue")[cols].to_csv(os.path.join(RESULTS, f"de_significant__{tag}.csv"))
    log(f"[DE] {s['contrast']}: tested={s['tested_genes']}  DE={s['DE_total']} "
        f"(up={s['DE_up']}, down={s['DE_down']})  unique_symbols={s['DE_symbols']}  "
        f"padj<0.05-variant={s['DE_padj_variant']}")
    log(f"     dispersion trend: {note}")
    return res, d, s


def find_gmt():
    c = [os.environ["REACTOME_GMT"]] if os.environ.get("REACTOME_GMT") else []
    for pat in ("*.gmt", "*.gmt.gz"):
        c += glob.glob(os.path.join(WS, pat)) + glob.glob(os.path.join(DATA, pat))
    good = [x for x in c if os.path.isfile(x)]
    for x in good:
        if "reactome" in os.path.basename(x).lower(): return x
    return good[0] if good else None


def load_gmt(path):
    import gzip
    op = gzip.open if path.endswith(".gz") else open
    sets = {}
    with op(path, "rt") as fh:
        for line in fh:
            f = line.rstrip("\n").split("\t")
            if len(f) < 3: continue
            genes = f[2:] if f[1].startswith("http") or f[1] == "" else f[1:]
            sets[f[0]] = {g.strip().upper() for g in genes if g.strip()}
    return sets


def ora(de_symbols, universe, sets, tag):
    de = {s.upper() for s in de_symbols if isinstance(s, str)} & universe
    N, n = len(universe), len(de); rows = []
    for name, gs in sets.items():
        Gs = gs & universe
        if len(Gs) < 5: continue
        k = len(de & Gs)
        rows.append(dict(term=name, term_size_in_universe=len(Gs), overlap=k,
                         overlap_ratio=k / len(Gs), fold_enrichment=(k / len(Gs)) / (n / N),
                         p_value=stats.hypergeom.sf(k - 1, N, len(Gs), n),
                         genes_hit=";".join(sorted(de & Gs))))
    t = pd.DataFrame(rows)
    if t.empty: return t
    t["adjusted_p_value"] = bh(t.p_value.values)
    t = t.sort_values(["p_value", "adjusted_p_value"]).reset_index(drop=True)
    t["Gene.%"] = (100 * t.overlap / t.term_size_in_universe).round(2)
    t.to_csv(os.path.join(RESULTS, f"enrichment_reactome2022__{tag}.csv"), index=False)
    log(f"[ORA] terms tested={len(t)}  universe={N}  DE input={n}")
    log(t.head(10)[["term", "overlap", "term_size_in_universe", "p_value",
                    "adjusted_p_value", "Gene.%"]].to_string(index=False))
    return t


if __name__ == "__main__":
    os.makedirs(RESULTS, exist_ok=True)
    counts, GRP, SYM = load_inputs()
    globals()["SYM"], globals()["GRP"] = SYM, GRP
    universe_mask = (counts.mean(axis=1) > 10) & SYM.notna()      # expressed + real symbol
    sf = size_factors(counts)
    log("[load] counts=%s groups=%d" % (str(counts.shape), GRP.nunique()))
    log("[load] universe (rowMean>10 & real symbol) = %d genes" % int(universe_mask.sum()))
    log("[SF] median-of-ratios size factors: " + ", ".join(f"{k}={v:.3f}" for k, v in sf.items()))

    summ = {"headline": {}, "sensitivity": {}}
    # ---- type-I-error calibration of the DE test (40 random 3v3 relabellings) ----
    idx6 = np.where(np.isin(GRP.reindex(counts.columns).values, [COMB, DMSO]))[0]
    s6 = sf.reindex(counts.columns).values[idx6]
    N6 = counts.values[universe_mask.values][:, idx6] / s6[None, :]   # same gene set as the DE test
    b6 = N6.mean(1)
    l6 = GRP.reindex(counts.columns).values[idx6]
    perm = permutation_calibration(N6, b6, s6)
    it6 = l6 == COMB
    real_p, real_lfc, _ = wald_from_q(N6[:, it6].mean(1), N6[:, ~it6].mean(1),
                                      dispersion_trend(N6[:, ~it6], N6[:, it6], b6)[0], s6, it6)
    log("[calib] permutation null: mean frac(p<0.05)=%.3f (target 0.05) ; DE-call median=%.0f q95=%.0f max=%d ; "
        "real-contrast frac(p<0.05)=%.3f" % (perm["mean_frac_p_lt_05"], perm["de_median"],
                                             perm["de_q95"], perm["de_max"], float(np.nanmean(real_p < 0.05))))
    summ["calibration"] = perm
    pd.DataFrame([dict(**perm, real_frac_p_lt_05=float(np.nanmean(real_p < 0.05)))]).to_csv(
        os.path.join(RESULTS, "calibration_permutation.csv"), index=False)

    res, d, s = run_contrast(counts, sf, universe_mask, COMB, DMSO, "comb_vs_DMSO")
    summ["headline"] = s
    cols = ["gene_symbol", "log2FC", "baseMean", "pvalue", "padj", "direction"]
    res[cols].sort_values("pvalue").head(30).to_csv(
        os.path.join(RESULTS, "top30_de_genes_comb_vs_DMSO.csv"), index=False)
    log("[top30 by p, comb vs DMSO]\n" +
        res[cols].sort_values("pvalue").head(30).to_string())

    # diagnostic only: up / down separately (NOT the answer; the brief asks for pooled)
    diag = pd.DataFrame([dict(contrast="comb_vs_DMSO", DE_pooled=len(d),
                              DE_up=int((d.log2FC > 0).sum()), DE_down=int((d.log2FC < 0).sum()),
                              DE_padj_lt_0p05=int((d.padj < 0.05).sum()),
                              median_abs_log2FC_up=float(d[d.log2FC > 0].log2FC.median()),
                              median_abs_log2FC_down=float(d[d.log2FC < 0].log2FC.median()),
                              permutation_null_DE_median=perm["de_median"],
                              permutation_null_DE_q95=perm["de_q95"])])
    diag.to_csv(os.path.join(RESULTS, "direction_diagnostic_comb_vs_DMSO.csv"), index=False)
    log("[diag] " + " | ".join(f"{k}={v}" for k, v in diag.iloc[0].items()))

    for trt, ctrl, tag in [(COMB, UNT, "comb_vs_Untreated"), (COMB, CIS, "comb_vs_Cisplatin"),
                           (COMB, CBD, "comb_vs_CBD")]:
        _, _, ss = run_contrast(counts, sf, universe_mask, trt, ctrl, tag)
        summ["sensitivity"][tag] = ss

    de_sym = sorted(set(d.gene_symbol.dropna()))
    univ_sym = sorted(set(SYM[universe_mask].dropna()))
    open(os.path.join(RESULTS, "de_gene_symbols_comb_vs_DMSO.txt"), "w").write("\n".join(de_sym) + "\n")
    open(os.path.join(RESULTS, "universe_symbols.txt"), "w").write("\n".join(univ_sym) + "\n")
    for nm, sel in [("up", d[d.log2FC > 0]), ("down", d[d.log2FC < 0])]:
        open(os.path.join(RESULTS, f"de_gene_symbols_comb_vs_DMSO_{nm}.txt"), "w").write(
            "\n".join(sorted(set(sel.gene_symbol.dropna()))) + "\n")
    log("[out] DE input symbols = %d ; universe symbols = %d" % (len(de_sym), len(univ_sym)))

    gmt = find_gmt()
    if gmt:
        log("[ORA] GMT found: " + gmt)
        sets = load_gmt(gmt)
        log("[ORA] library terms = %d" % len(sets))
        t = ora(de_sym, set(univ_sym), sets, "comb_vs_DMSO")
        for nm in ("up", "down"):     # direction-separated ORA, diagnostic only
            ora(sorted(set(d[d.log2FC.gt(0) if nm == "up" else d.log2FC.lt(0)].gene_symbol.dropna())),
                set(univ_sym), sets, f"comb_vs_DMSO_{nm}")
        summ["enrichment"] = dict(status="RUN", gmt=os.path.basename(gmt),
                                  terms_tested=int(len(t)),
                                  top_term=(t.term.iloc[0] if len(t) else None),
                                  top_p=float(t.p_value.iloc[0]) if len(t) else None,
                                  top_padj=float(t.adjusted_p_value.iloc[0]) if len(t) else None)
    else:
        summ["enrichment"] = dict(
            status="NOT RUN - Reactome_2022 library unreachable in this runner",
            reason=("gseapy not installed; no network egress (DNS 'Temporary failure in name "
                    "resolution' AND raw TCP to 8.8.8.8:53 / 1.1.1.1:443 / pypi:443 -> errno 101 "
                    "Network is unreachable); no GMT / gene-set / Reactome content anywhere on the "
                    "filesystem (grep -ril reactome found only task.json)"),
            method_ready=("scipy.stats.hypergeom.sf over-representation + BH "
                          "(gseapy.enrichr / Enrichr-equivalent reimplementation)"),
            input_de_symbols=len(de_sym), universe_symbols=len(univ_sym),
            rerun_command="REACTOME_GMT=/path/to/Reactome_2022.symbols.gmt "
                          "python3 analysis/de_enrichment_pipeline.py")
        log("[ORA] NOT RUN - no Reactome_2022 GMT present. Substituting another collection or a "
            "hand-built library would fabricate the gene sets, so enrichment is left unexecuted.")

    summ["inputs"] = dict(counts_shape=list(counts.shape),
                          universe_genes=int(universe_mask.sum()),
                          de_symbols=len(de_sym), universe_symbols=len(univ_sym))
    json.dump(summ, open(os.path.join(RESULTS, "summary.json"), "w"), indent=2)
    open(os.path.join(RESULTS, "run_log.txt"), "w").write("\n".join(LOG) + "\n")
    print("\n[done] ->", RESULTS)
