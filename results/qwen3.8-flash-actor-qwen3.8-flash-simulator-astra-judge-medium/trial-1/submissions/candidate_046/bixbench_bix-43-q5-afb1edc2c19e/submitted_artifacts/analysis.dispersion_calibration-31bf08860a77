"""Calibration check: which dispersion trend gives a type-I-error-correct Wald test?
Runs the real pipeline engine on real labels and on 40 label permutations."""
import numpy as np, pandas as pd, importlib.util, sys
from scipy import stats
from scipy.optimize import curve_fit
spec = importlib.util.spec_from_file_location("pl", "analysis/de_enrichment_pipeline.py")
pl = importlib.util.module_from_spec(spec); spec.loader.exec_module(pl)
counts, GRP, SYM = pl.load_inputs()
univ = (counts.mean(axis=1) > 10) & SYM.notna()
K = counts.values[univ].astype(float); names = np.asarray(counts.index[univ])
cols = np.array(counts.columns)
idx6 = np.where(np.isin(GRP.reindex(cols).values, ["DMSO", "Cisplatin_IC50_CBD_IC50"]))[0]
sf6 = pl.size_factors(counts).reindex(cols).values[idx6]
lab6 = GRP.reindex(cols).values[idx6]
N = K[:, idx6] / sf6
base = N.mean(1)

def mom_alpha(mu, cnt):
    v = cnt.var(ddof=1, axis=1)
    return np.clip((v - mu) / np.maximum(mu, 1e-9) ** 2, 1e-6, 20.0)

def trend(kind):
    """Return per-gene dispersion (trend only, no shrinkage)."""
    it = lab6 == "Cisplatin_IC50_CBD_IC50"; ic = ~it
    a1 = mom_alpha(N[:, it].mean(1), N[:, it]); a2 = mom_alpha(N[:, ic].mean(1), N[:, ic])
    a = np.where(kind == "mean", (a1 + a2) / 2, np.minimum(a1, a2))
    keep = np.isfinite(a) & (base > 5)
    x = np.log2(np.clip(base[keep], 1e-3, None)); yv = np.clip(a[keep], 1e-6, 20)
    nb = 30; qs = np.quantile(x, np.linspace(0, 1, nb + 1)); qs[0] -= 1e-9; qs[-1] += 1e-9
    b = np.clip(np.digitize(x, qs[1:-1]), 0, nb - 1)
    cx, cy, cw = [], [], []
    for j in range(nb):
        m = b == j
        if m.sum() >= 100:
            cx.append(np.median(x[m]))
            cy.append(np.mean(np.clip(yv[m], 1e-6, 1)) if kind == "mean" else np.median(yv[m]))
            cw.append(int(m.sum()))
    cx, cy, cw = np.array(cx), np.array(cy), np.array(cw, float)
    f = lambda xx, a0, a1_: a0 + a1_ / 2.0 ** xx
    p, _ = curve_fit(f, cx, cy, sigma=1 / np.sqrt(cw), p0=[np.median(cy), np.median(cy * 2 ** cx)],
                     maxfev=40000, bounds=([1e-7, 1e-7], [10, 1e6]))
    return np.clip(f(np.log2(np.clip(base, 1e-3, None)), *p), 1e-6, 10), p

def wald(perm_lab, a_disp):
    it = perm_lab == "T"; ic = ~it
    q_t = N[:, it].mean(1); q_c = N[:, ic].mean(1)
    mu = (np.where(it, q_t[:, None], 0.0) + np.where(ic, q_c[:, None], 0.0)) * sf6
    w = mu / (1.0 + a_disp[:, None] * mu)
    vb = 1 / np.where(w[:, it].sum(1) > 0, w[:, it].sum(1), np.nan) + 1 / np.where(w[:, ic].sum(1) > 0, w[:, ic].sum(1), np.nan)
    ok = (q_t > 0) & (q_c > 0) & np.isfinite(vb)
    lfc = np.log2(np.clip(q_t, 1e-12, None) / np.clip(q_c, 1e-12, None))
    z = np.where(ok, (np.log(q_t) - np.log(q_c)) / np.sqrt(np.where(ok, vb, 1)), 0)
    p = np.where(ok, 2 * stats.norm.sf(np.abs(z)), 1.0)
    return lfc, p, np.where(ok, vb, np.nan)

rng = np.random.default_rng(7)
TRT = "Cisplatin_IC50_CBD_IC50"
lab_bin = np.where(lab6 == TRT, "T", "C")
for kind in ["median", "mean"]:
    a, pt_ = trend(kind)
    lfc, p, vb = wald(lab_bin, a)
    obs = int(((p < .05) & (abs(lfc) > .5) & (base > 10)).sum())
    perms, permde = [], []
    for k in range(40):
        pm = rng.permutation(len(idx6)); lab_p = np.where(np.isin(np.arange(len(idx6)), pm[:3]), "T", "C")
        lf2, p2, _ = wald(lab_p, a)
        perms.append((p2 < .05).mean()); permde.append(int(((p2 < .05) & (abs(lf2) > .5) & (base > 10)).sum()))
    print(f"trend[{kind}] a0={pt_[0]:.2e} a1={pt_[1]:.2e} medianDisp={np.median(a):.4f}")
    print(f"   REAL   : frac p<0.05 = {(p<0.05).mean():.3f} | lambdaGC = {np.median(p)/0.4549:.3f} | DE(filter) = {obs}")
    print(f"   PERM(40): mean frac p<0.05 = {np.mean(perms):.3f} (want ~0.05) | DE median = {np.median(permde):.0f} q95 = {np.quantile(permde,.95):.0f} max = {max(permde)}")
