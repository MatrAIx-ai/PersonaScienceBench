#!/usr/bin/env python3
"""Unit test of the gseapy-equivalent ORA code path.

Uses a SYNTHETIC gene-set file in /tmp (letters, not real pathways) purely to verify that
load_gmt + ora execute and reproduce the closed-form hypergeometric tail and BH
adjustment.  It is NOT a biological result and must never be reported as one.
"""
import importlib.util, os, sys, numpy as np, pandas as pd
from scipy import stats
from scipy.special import gammaln
spec = importlib.util.spec_from_file_location("pl", os.path.join(os.path.dirname(__file__),
                                                                "de_enrichment_pipeline.py"))
pl = importlib.util.module_from_spec(spec); spec.loader.exec_module(pl)
pl.RESULTS = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'selftest')  # keep synthetic output out of results/

# --- synthetic universe / DE set / gene sets -------------------------------------------
uni = [f"G{i:04d}" for i in range(1000)]
de  = [f"G{i:04d}" for i in range(0, 100)]                     # 100 DE genes, no bias
set_enriched = de[:40] + [f"G{i:04d}" for i in range(500, 540)]   # 40 DE + 40 non-DE  -> enriched
set_neutral  = [f"G{i:04d}" for i in range(200, 300)]             # overlaps DE by chance only
set_small    = de[:10] + [f"G{i:04d}" for i in range(600, 610)]   # size 10 (below the n>=5 filter? size 20 in uni)
gmt = os.path.join(os.path.dirname(os.path.abspath(__file__)), "selftest", "synthetic.gmt")
rows = [("SET_ENRICHED", set_enriched, "https://example.org/x"),
        ("SET_NEUTRAL", set_neutral, "https://example.org/y"),
        ("SET_DESC_URL", set_enriched[:20] + set_neutral[:10], "https://example.org/z")]
with open(gmt, "w") as fh:
    for nm, gs, url in rows:                       # Enrichr layout: name<TAB>URL<TAB>genes
        fh.write(nm + "\t" + url + "\t" + "\t".join(gs) + "\n")
    fh.write("SET_NO_DESC\t" + "\t".join(set_small) + "\n")   # plain GMT: name<TAB>genes

sets = pl.load_gmt(gmt)
print("parsed terms:", sorted(sets), "| sizes:", {k: len(v) for k, v in sorted(sets.items())})
assert sets["SET_ENRICHED"] == {g.upper() for g in set_enriched}, "GMT gene parsing wrong"

t = pl.ora(de, set(uni), sets, "selftest").set_index("term")

# --- independent closed-form check of the hypergeometric p-values ----------------------
N, n = len(uni), len(set(de) & set(uni))
ok = True
for term in ["SET_ENRICHED", "SET_NEUTRAL"]:
    Gs = len(sets[term]); k = len(set(de) & sets[term])
    exact = float(stats.hypergeom.sf(k - 1, N, Gs, n))
    # brute-force sum of the pmf tail, computed independently
    def logC(a, b):
        return gammaln(a + 1) - gammaln(b + 1) - gammaln(a - b + 1)
    tail = float(sum(np.exp(logC(Gs, j) + logC(N - Gs, n - j) - logC(N, n))
                     for j in range(k, min(Gs, n) + 1)))
    same = abs(t.loc[term, "p_value"] - exact) < 1e-12 and abs(t.loc[term, "p_value"] - tail) < 1e-9
    ok &= same
    print(f"{term:13s} N={N} G={Gs} n={n} k={k}  p_pipeline={t.loc[term,'p_value']:.6g} "
          f"p_closedform={exact:.6g} p_bruteforce_tail={tail:.6g}  match={same}")
print("\ntable:\n" + t[["term_size_in_universe", "overlap", "fold_enrichment", "p_value",
                      "adjusted_p_value", "Gene.%"]].to_string())
# BH sanity: 4 tests -> smallest adjusted p = p*4/1 capped at 1
manual_bh = min(t.p_value.min() * 4, 1.0)
print(f"\nBH check: min adjusted = {t.adjusted_p_value.min():.6g} expected {manual_bh:.6g} "
      f"match={abs(t.adjusted_p_value.min()-manual_bh)<1e-12}")
print("gene-set-size filter applied (<5 genes in universe dropped):",
      "SET_SMALL absent" if "SET_SMALL" not in t.index else "present")
print("\nORA code path VERIFIED" if ok else "\nORA code path FAILED")
sys.exit(0 if ok else 1)
