#!/usr/bin/env python3
"""Diagnostic snapshot of the combination-vs-DMSO DE table using HAND-CURATED marker
panels.  This is NOT an enrichment analysis and must not be reported as one: the panels
are my own gene lists, not a Reactome_2022 gene set.  Purpose: let the DE table be read
while the real Reactome_2022 ORA is blocked."""
import os, pandas as pd
WS = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
COL = "DE_p0.05_lfc0.5_bm10"
PANELS = {
 "AhR/xenobiotic": ["CYP1A1","AHRR","TIPARP","NQO1","ALDH3A1","ALDH1A3","CYP1B1","SLC7A11","AKR1C1"],
 "p53/DNA-damage": ["CDKN1A","GDF15","MDM2","TP53I3","ZMAT3","FAS","SESN1","BTG2","RPS27L","TP53INP1","TNFRSF10B","TRIAP1"],
 "glycolysis/HIF": ["HK2","PGK1","ENO2","ALDOC","PFKFB4","SLC2A1","PDK1","LDHA","BNIP3","P4HA1","VEGFA","PLOD2","ANGPTL4","GPI"],
 "AP-1/immediate-early": ["FOS","FOSB","JUN","JUNB","EGR1","ATF3","DUSP1","NR4A1","NR4A3","IER2"],
 "ECM/adhesion": ["THBS1","CCN1","CCN2","SEMA7A","KRT7","KRT80","COL17A1","SULF2","ITGB4","LAMA3","FN1","SERPINE1"],
 "ER-stress/UPR": ["DDIT3","XBP1","ATF4","HSPA5","HERPUD1","TRIB3","CHAC1","EIF4EBP1"],
 "cell-cycle": ["MKI67","CCNB1","CDK1","PLK1","TOP2A","BIRC5","E2F1","RRM2","TYMS","PCNA","MCM2","AURKB"],
 "cholesterol/SREBP": ["HMGCR","HMGCS1","SQLE","INSIG1","LDLR","FDFT1","MVD","IDI1","SCD","FASN","SREBF1"],
 "autophagy/lysosome": ["MAP1LC3B","SQSTM1","LAMP1","CTSD","ATG3","WIPI1","GABARAPL1","TFEB"],
}
t = pd.read_csv(os.path.join(WS, "results", "de_table__comb_vs_DMSO.csv"), index_col=0)
t = t.drop_duplicates("gene_symbol").set_index("gene_symbol")
rows = []
for panel, genes in PANELS.items():
    sub = t.reindex([g for g in dict.fromkeys(genes) if g in t.index])
    de = sub[COL].fillna(False).astype(bool)
    rows.append(dict(panel=panel, genes_in_table=len(sub), DE=int(de.sum()),
                     DE_up=int((de & (sub.log2FC > 0)).sum()), DE_down=int((de & (sub.log2FC < 0)).sum()),
                     median_log2FC=round(float(sub.log2FC.median()), 3),
                     detail=", ".join(f"{g}{'*' if bool(d) else ''}({l:+.2f})"
                                      for g, l, d in zip(sub.index, sub.log2FC, de))))
out = pd.DataFrame(rows)
out.to_csv(os.path.join(WS, "results", "de_signature_panels_DIAGNOSTIC.csv"), index=False)
print("DIAGNOSTIC ONLY -- hand-curated panels, not a Reactome_2022 gene set")
print(out[["panel", "genes_in_table", "DE", "DE_up", "DE_down", "median_log2FC"]].to_string(index=False))
