#!/usr/bin/env python3
"""
bixbench bix-46-q1
Question: log2 fold change (2 decimals) for mexG expression in
          Delta-rhlI (strain #97) compared to wt (strain #1).

Approved approach (Route A): take the pre-computed DESeq2 log2FoldChange
stored in data/res_1vs97.rds, orientation "Strain 97 vs 1" (= mutant / wt),
no sign flip; match mexG by Locus Tag from the PA14 PGD annotation table.

No R / no internet in this runtime -> minimal reader for the RDS binary
format (gzip'd, serialization v3, big-endian "XDR"-style records).
The reader is validated by internal DESeq2 invariants (printed below).
"""
import gzip, struct, re, csv, os
import numpy as np
import pandas as pd

DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir, "data")
RDS_97 = os.path.join(DATA, "res_1vs97.rds")
RDS_98 = os.path.join(DATA, "res_1vs98.rds")
CSV_ANN = os.path.join(DATA, "Pseudomonas_aeruginosa_UCBPP-PA14.csv")
OUT_CSV = os.path.join(os.path.dirname(os.path.abspath(__file__)), "mexg_row_checks.csv")

TYPE_CHARSXP, TYPE_STRSXP, TYPE_REALSXP = 9, 16, 14
COLS = ["baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]


# ---------------------------------------------------------------- RDS reading
def rds_bytes(path):
    raw = open(path, "rb").read()
    b = gzip.decompress(raw) if raw[:2] == b"\x1f\x8b" else raw
    assert b[:2] == b"X\n", "not an RDS stream"
    ser_ver, r_ver = struct.unpack_from(">II", b, 2)
    return b, ser_ver, "R %d.%d.%d" % ((r_ver >> 16) & 0xFF, (r_ver >> 8) & 0xFF, r_ver & 0xFF)


def read_strsxp(b, pos, n):
    """Read n CHARSXP elements starting at pos; returns (strings, new_pos)."""
    out = []
    for _ in range(n):
        hdr, = struct.unpack_from(">I", b, pos); pos += 4
        if (hdr & 0xFF) != TYPE_CHARSXP:
            raise ValueError("expected CHARSXP at %d (hdr=0x%08x)" % (pos - 4, hdr))
        ln, = struct.unpack_from(">i", b, pos); pos += 4
        if not (0 <= ln < 256):
            raise ValueError("implausible CHARSXP length %d" % ln)
        out.append(b[pos:pos + ln].decode("utf-8")); pos += ln
    return out, pos


def read_rds_table(path):
    """Return (rownames, {column_name: np.array}, description_strings)."""
    b, ser_ver, rver = rds_bytes(path)

    # --- numeric columns: REALSXP (type 14) header + length + 8*len doubles
    cand = []
    for m in re.finditer(re.escape(b"\x00\x00\x00\x0e"), b):
        s = m.start()
        ln, = struct.unpack_from(">i", b, s + 4)
        if 1000 < ln < 100000 and s + 8 + 8 * ln <= len(b):
            nxt = struct.unpack_from(">I", b, s + 8 + 8 * ln)[0]  # next record header
            if nxt >> 24 in (0x00, 0x01, 0x02, 0x04, 0x09, 0x0e, 0x10, 0x13):
                cand.append((s, ln))
    lens = pd.Series([c[1] for c in cand]).value_counts()
    nrows = int(lens.index[0])
    blocks = [s for s, ln in cand if ln == nrows]
    assert len(blocks) == len(COLS), "found %d REALSXP blocks of len %d (expected %d)" % (
        len(blocks), nrows, len(COLS))
    cols = {}
    for name, s in zip(COLS, blocks):
        cols[name] = np.frombuffer(b, dtype=">f8", count=nrows, offset=s + 8).astype(float)

    # --- row names: STRSXP (type 16) header + length == nrows, all locus tags
    starts = []
    for m in re.finditer(re.escape(b"\x00\x00\x00\x10" + struct.pack(">i", nrows)), b):
        try:
            names, _ = read_strsxp(b, m.start() + 8, nrows)
        except Exception:
            continue
        if all(re.fullmatch(r"PA14_\d{5}", x) for x in names):
            starts.append((m.start(), names))
    assert len(starts) == 1, "expected exactly one row-name STRSXP, got %d" % len(starts)
    rownames = starts[0][1]
    assert len(set(rownames)) == nrows, "duplicated row names"

    # --- embedded DESeqResults column descriptions (contrast orientation)
    descs = [d.decode() for d in re.findall(rb"[ -~]{20,}", b) if b"vs" in d or b"samples" in d or b"p-value" in d]
    return rownames, cols, descs, ser_ver, rver, len(b)


# ---------------------------------------------------------------- validation
def invariants(cols):
    bm, l2, se, st, p, padj = (cols[c] for c in COLS)
    checks = {
        "n_rows": len(bm),
        "max_abs_stat_minus_log2fc_over_lfcSE": float(np.nanmax(np.abs(st - l2 / se))),
        "min_baseMean": float(np.nanmin(bm)),
        "min_padj_minus_pvalue": float(np.nanmin(padj - p)),
        "padj_monotonic_nondecending": bool(np.all(np.diff(padj[~np.isnan(padj)]) >= -1e-15)),
        "pvalue_in_0_1": bool(np.nanmin(p) >= 0 and np.nanmax(p) <= 1),
        "n_NaN_in_columns": int(sum(int(np.isnan(cols[c]).sum()) for c in COLS)),
    }
    ok = (checks["max_abs_stat_minus_log2fc_over_lfcSE"] < 1e-9
          and checks["min_baseMean"] > 0
          and checks["min_padj_minus_pvalue"] >= -1e-15
          and checks["padj_monotonic_nondecending"] and checks["pvalue_in_0_1"])
    return ok, checks


# ------------------------------------------------------------------ main
def main():
    print("=" * 78)
    print("1) Annotation table -> mexG locus tag")
    ann = pd.read_csv(CSV_ANN, low_memory=False)
    print("   shape:", ann.shape)
    gname = ann["Gene Name"].astype(str).str.strip().str.lower()
    hits = ann[gname == "mexg"]
    syn = ann.apply(lambda r: r.astype(str).str.contains("mexg", case=False, na=False).any(), axis=1)
    print("   exact Gene Name == 'mexG':", len(hits),
          "| rows mentioning 'mexg' anywhere:", int(syn.sum()))
    assert len(hits) == 1 and int(syn.sum()) == 1, "ambiguous mexG annotation"
    locus = hits.iloc[0]["Locus Tag"]
    print("   -> Locus Tag:", locus, "| PGD Gene ID:", hits.iloc[0]["PGD Gene ID"],
          "| Feature Type:", hits.iloc[0]["Feature Type"])

    print("=" * 78)
    print("2) Reading DESeqResults object (minimal RDS reader, no R available)")
    rownames, cols, descs, ser_ver, rver, nb = read_rds_table(RDS_97)
    print("   %s: RDS serialization v%d, written by %s, %d bytes (uncompressed), %d genes"
          % (os.path.basename(RDS_97), ser_ver, rver, nb, len(rownames)))
    print("   columns:", COLS)

    print("-" * 78)
    print("3) AUTO-VERIFICATION: embedded contrast description (sign orientation)")
    lfc_desc = [d for d in descs if "log2 fold change" in d]
    for d in lfc_desc:
        print('   "%s"' % d.strip())
    assert any("Strain 97 vs 1" in d for d in lfc_desc), \
        "contrast is not 'Strain 97 vs 1'; orientation must be re-checked"
    assert not any("Strain 1 vs 97" in d for d in lfc_desc), "object is in inverted orientation"
    print("   => stored log2FC is already 97 vs 1 = Delta-rhlI / wt  ->  SIGN NOT FLIPPED")

    print("-" * 78)
    print("4) Parser validation via DESeq2 internal invariants")
    ok, checks = invariants(cols)
    for k, v in checks.items():
        print("   %-38s %s" % (k, v))
    assert ok, "invariants failed -> column/row alignment not trustworthy"

    print("-" * 78)
    print("5) mexG row (row name == %s)" % locus)
    i = rownames.index(locus)
    row = {c: cols[c][i] for c in COLS}
    print("   row index (padj-sorted):", i)
    for c in COLS:
        print("   %-15s %s" % (c, repr(row[c])))
    print("   top-5 genes by padj:", rownames[:5])

    print("-" * 78)
    print("6) Specificity control (res_1vs98.rds, NOT used in the answer)")
    try:
        rn98, c98, d98, *_ = read_rds_table(RDS_98)
        j = rn98.index(locus)
        bm_match = float(np.nanmax(np.abs(
            dict(zip(rn98, c98["baseMean"]))[locus] - dict(zip(rownames, cols["baseMean"]))[locus])))
        print("   max|baseMean(97vs1) - baseMean(98vs1)| for matched genes:",
              float(np.nanmax([abs(dict(zip(rn98, c98['baseMean']))[g] -
                                   dict(zip(rownames, cols['baseMean']))[g]) for g in rownames])))
        print("   mexG in 98 vs 1: log2FoldChange = %r , padj = %r"
              % (c98["log2FoldChange"][j], c98["padj"][j]))
        print("   -> mexG is specifically changed in Delta-rhlI, not in strain #98")
    except Exception as e:  # control only; never blocks the answer
        print("   control skipped:", e)

    print("-" * 78)
    print("7) Intermediate evidence CSV ->", os.path.basename(OUT_CSV))
    with open(OUT_CSV, "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["section", "key", "value"])
        w.writerow(["mexG_row", "locus_tag", locus])
        for c in COLS:
            w.writerow(["mexG_row", c, format(float(row[c]), ".17g")])
        for k, v in checks.items():
            w.writerow(["parser_check", k, v])
        for d in lfc_desc:
            w.writerow(["contrast_orientation", "description", d.strip()])
        w.writerow(["answer", "log2FoldChange_rounded_2dp", "%.2f" % row["log2FoldChange"]])

    final = round(row["log2FoldChange"], 2)
    print("=" * 78)
    print("%.2f" % final)


if __name__ == "__main__":
    main()
