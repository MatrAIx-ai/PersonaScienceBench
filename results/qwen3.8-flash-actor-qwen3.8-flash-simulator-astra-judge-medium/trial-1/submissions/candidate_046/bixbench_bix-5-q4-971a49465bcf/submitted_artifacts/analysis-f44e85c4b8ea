# NOTE: no GO/Reactank/KEGG resource exists in this capsule or runner (verified by
# filesystem search: no *.gmt/*.obo/*.gaf/gene2go, 0 hits for GO:0008150, no network).
# We therefore run a hypergeometric enrichment against the ONLY gene-set-like
# annotations available locally:
#   (i)  HGNC "Approved name" tokens (unigram+bigram) -> interpretable family/process labels
#   (ii) gene-symbol prefix families (KRT*, COL*, SLC*, ZNF* ...)
#   (iii) cytogenetic locus (HGNC "Chromosome" band, band-level)
# and we declare explicitly that this is NOT a GO:BP analysis.
from scipy.stats import hypergeom

def term_sets(ann_bg):
    sets = {}
    stop = {"protein","proteins","gene","mrna","rna","putative","like","similar","homolog","homologous",
            "human","pseudogene","noncoding","non","coding","small","large","subunit","alpha","beta","gamma",
            "delta","chain","factor","region","type","isoform","member","family","cell","of","and","the","a"}
    names = ann_bg["Approved name"].dropna().astype(str).str.lower().str.replace(r"[^a-z0-9\- ]", " ", regex=True)
    for tok_pos, ngram in ((1, 1), (2, 2)):
        toks = {}
        for bg, nm in names.items():
            w = [x for x in nm.split() if len(x) > 2]
            if ngram == 2:
                w = [f"{a} {b}" for a, b in zip(w, w[1:])]
            for t in w:
                if t in stop or (ngram == 1 and t in {"zinc","finger","domain","repeat","unit","light","heavy"}):
                    continue
                toks.setdefault(t, []).append(bg)
        for t, gs in toks.items():
            sets[f"NAME:{t}"] = set(gs)
    fam = {}
    for bg, sym in ann_bg["symbol"].dropna().items():
        m = re.match(r"^([A-Z]{2,6})", str(sym))
        if m and len(str(sym)) > len(m.group(1)):
            fam.setdefault("FAM:" + m.group(1), set()).add(bg)
    sets.update({k: v for k, v in fam.items() if len(v) >= 3})
    loc = {}
    for bg, cb in ann_bg["Chromosome"].dropna().items():
        m = re.match(r"^(\d+|X|Y)([pq]\d+)", str(cb))
        if m:
            loc.setdefault(f"LOCUS:{m.group(1)}{m.group(2)}", set()).add(bg)
    sets.update(loc)
    return sets

def enrich(genes, sets, universe, label, size_filter=(10, 500)):
    U = set(universe); N = len(U)
    genes = set(genes) & U
    rows = []
    for name, gs in sets.items():
        gs &= U
        K = len(gs)
        if K < 2:
            continue
        k = len(gs & genes)
        if k == 0:
            continue
        p = float(hypergeom.sf(k - 1, N, K, len(genes)))
        rows.append(dict(term=name, n_term=K, n_hit=k, n_query=len(genes), pvalue=p,
                         fold=(k / len(genes)) / (K / N)))
    r = pd.DataFrame(rows)
    if len(r) == 0:
        return r
    r["FDR"] = bh(r.pvalue.values)
    r = r.sort_values("pvalue")
    r.to_csv(f"{R}/enrich_{label}_unfiltered.csv", index=False)
    keep = r[(r.n_term >= size_filter[0]) & (r.n_term <= size_filter[1])] if size_filter else r
    return r, keep

