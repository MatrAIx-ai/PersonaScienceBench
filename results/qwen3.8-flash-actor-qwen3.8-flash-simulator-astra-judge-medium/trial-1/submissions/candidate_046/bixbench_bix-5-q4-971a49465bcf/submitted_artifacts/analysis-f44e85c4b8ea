# --- (2) umbrella -> most specific term supported by the SAME genes
def specificity(full, term):
    row = full[full.term == term].iloc[0]
    genes_hit = None
    U = set(bg); q = row.n_query
    genes_hit = gsets[term] & U
    sub = full[(full.n_hit == row.n_hit) & (full.pvalue <= row.pvalue * 1.0001)]
    cand = []
    for _, r in sub.iterrows():
        s = gsets[r.term] & U
        if s <= genes_hit and len(s) < len(genes_hit):
            cand.append((r.term, len(s), r.pvalue, r.FDR))
    cand.sort(key=lambda x: (x[1], x[2]))
    return genes_hit, cand

for key in ("PRIMARY_intersection_UP", "SENS_union_UP"):
