def keep_filter(counts, cpm=1.0, n_min=7):
    c = counts.div(counts.sum(axis=0), axis=1) * 1e6
    return counts.index[(c >= cpm).sum(axis=1) >= n_min]

def tmm_factors(counts, lt=0.03, st=0.05):
    y = counts.values.astype(float); lib = y.sum(0)
    rel = (y / lib) / np.exp(np.log(y / lib + 1e-12).mean(1, keepdims=True))
    ref = int(np.argmin(np.median(np.abs(np.log2(rel + 1e-12)), axis=0)))
    f = np.ones(y.shape[1])
    for j in range(y.shape[1]):
        if j == ref: continue
        a, b = y[:, ref], y[:, j]; ok = (a > 0) & (b > 0)
        A = 0.5 * np.log2((a[ok] / lib[ref]) * (b[ok] / lib[j]))
        M = np.log2((b[ok] / lib[j]) / (a[ok] / lib[ref]))
        w = 1.0 / (lib[ref] / a[ok] + lib[j] / b[ok])
        Mlo, Mhi = np.quantile(M, [lt, 1 - lt]); Alo, Ahi = np.quantile(A, [st, 1 - st])
        k = (M >= Mlo) & (M <= Mhi) & (A >= Alo) & (A <= Ahi)
        f[j] = 2 ** (np.sum(w[k] * M[k]) / np.sum(w[k]))
    f = f / np.exp(np.log(f).mean())
    # composition adjustment (edgeR f75-style, sample-wise)
    q75 = np.quantile(y / lib, 0.75, axis=0)
    adj = np.exp(np.log(q75).mean() - np.log(q75)); adj /= np.exp(np.log(adj).mean())
    eff = lib * f * adj                      # effective library sizes (edgeR scale)
    eff = eff * (np.exp(np.log(lib).mean()) / np.exp(np.log(eff).mean()))
    return pd.Series(eff, index=counts.columns), pd.Series(f, index=counts.columns)

def mor_factors(counts):
    lc = np.log(counts.replace(0, np.nan).values)
    ok = (counts > 0).all(1).values
    ref = np.nanmean(lc[ok], axis=1, keepdims=True)
    sf = np.exp(np.median(lc[ok] - ref, axis=0)); sf = sf / np.exp(np.log(sf).mean())
    eff = sf * counts.sum(0).values          # DESeq2-like size factors on library-size scale
    eff = eff * (np.exp(np.log(counts.sum(0).values).mean()) / np.exp(np.log(eff).mean()))
    return pd.Series(eff, index=counts.columns)

# ------------------------------------------------------------- NB GLM
def nb_glm(X, Y, phi, iters=100, tol=1e-9):
    """Vectorised NB GLM (log link), fixed per-gene dispersion. Y: n x G."""
    n, p = X.shape; G = Y.shape[1]
    B = np.zeros((p, G)); B[0] = np.log(np.maximum(Y.sum(0) / n, 0.1))
    for _ in range(iters):
        eta = np.clip(X @ B, -30, 30); mu = np.exp(eta)
        w = mu**2 / (mu + phi[None, :] * mu**2)
        z = eta + (Y - mu) / mu
        A = np.einsum("ig,ip,iq->gpq", w, X, X) + np.eye(p) * 1e-9
        b = np.einsum("ig,ip->gp", w * z, X)
        Bn = np.linalg.solve(A, b[:, :, None])[:, :, 0].T
        if np.nanmax(np.abs(Bn - B)) < tol:
            B = Bn; break
        B = Bn
    eta = np.clip(X @ B, -30, 30); mu = np.exp(eta)
    w = mu**2 / (mu + phi[None, :] * mu**2)
    A = np.einsum("ig,ip,iq->gpq", w, X, X) + np.eye(p) * 1e-9
    return B, np.linalg.inv(A), mu

def estimate_disp(X, Y, nbin=40):
    n, p = X.shape; G = Y.shape[1]
    phi = np.full(G, 0.05)
    for _ in range(4):
        B, cov, mu = nb_glm(X, Y, phi)
        num = (((Y - mu)**2 - mu) / np.maximum(mu**2, 1e-8)).sum(0)
        phi_g = np.clip(num / (n - p), 1e-4, 20)
        m = mu.mean(0); order = np.argsort(m)
        tm, tb = [], []
        for bi in np.array_split(order, nbin):
            if len(bi): tm.append(np.median(m[bi])); tb.append(np.median(np.log(phi_g[bi])))
        tm, tb = np.array(tm), np.array(tb)
        trend = np.exp(np.interp(np.log(m), np.log(tm), tb))
        var = np.var(np.log(phi_g) - np.log(trend))
        sd_prior = np.sqrt(max(var - 2.0 / (n - p), 0.04**2))
        w = (1 / (2 / (n - p))) / (1 / (2 / (n - p)) + 1 / sd_prior**2)
        new = np.clip(np.exp(w * np.log(phi_g) + (1 - w) * np.log(trend)), 1e-4, 20)
        if np.nanmax(np.abs(np.log(new / phi))) < 1e-3: phi = new; break
        phi = new
    return phi

def de_nb(counts_eff, design):
    X = design.values.astype(float); Y = counts_eff.T.values.astype(float)
    phi = estimate_disp(X, Y)
    B, cov, mu = nb_glm(X, Y, phi)
    c = X.shape[1] - 1
    se = np.sqrt(np.maximum(cov[:, c, c], 1e-12))
    t = B[c] / se; dfres = X.shape[0] - X.shape[1]
    return pd.DataFrame({"log2FC": B[c], "SE": se, "logCPM": np.log2(np.maximum(mu.mean(0), 1e-6)),
                         "disp": phi, "stat": t, "pvalue": 2 * stats.t.sf(np.abs(t), df=dfres)}, index=counts_eff.index)

def de_limma(logcpm, design):
    """limma-style OLS + empirical-Bayes variance moderation (method-of-moments d0,v0)."""
    from scipy.special import polygamma
    X = design.values.astype(float); Y = logcpm.T.values.astype(float)
    XtXi = np.linalg.inv(X.T @ X); B = XtXi @ X.T @ Y
    r = Y - X @ B; dfres = X.shape[0] - X.shape[1]
    s2 = np.maximum((r**2).sum(0) / dfres, 1e-10)
    ly = np.log(s2); v = max(np.var(ly), 1e-6)
    f = lambda x: float(polygamma(1, x)) - v          # var(log s2p)=psi1(d'/2)
    lo, hi = 1e-3, 1e3
    for _ in range(200):
        mid = 0.5 * (lo + hi)
        if f(mid) > 0: lo = mid
        else: hi = mid
    dprime = 2.0 * 0.5 * (lo + hi); d0 = float(np.clip(dprime - dfres, 0.05, 30))
    logv0 = ly.mean() - float(polygamma(0, dprime / 2)) - np.log(2.0) + np.log(dprime)
    v0 = float(np.exp(logv0))
    s2p = (d0 * v0 + dfres * s2) / (d0 + dfres)
    c = X.shape[1] - 1; se = np.sqrt(s2p * XtXi[c, c]); t = B[c] / se
    df = dfres + d0
    return pd.DataFrame({"log2FC": B[c], "SE": se, "stat": t, "pvalue": 2 * stats.t.sf(np.abs(t), df)}, index=logcpm.index), dict(d0=float(d0), v0=v0)

def bh(p):
    p = np.asarray(p, float); o = np.argsort(p); r = np.empty(len(p))
    q = p[o] * len(p) / np.arange(1, len(p) + 1)
    r[o] = np.minimum.accumulate(q[::-1])[::-1]
    return np.minimum(r, 1)

# --------------------------------------------------------------- RUN
def build(sample_list, biotypes):
    c0 = cnt_all[sample_list]          # cnt_all holds all 16 sequenced samples
    k = keep_filter(c0)
    if biotypes is not None:
        k = k[ann["gene_type"].reindex(k).isin(biotypes).values]
    return c0.loc[k]

def norm_pair(sub):
    eff_tmm, f_tmm = tmm_factors(sub)
    return eff_tmm, mor_factors(sub)

def scaled(sub, eff):
    """Normalised counts on the original count scale (edgeR/DESeq2 convention)."""
    return sub * (eff.mean() / eff).values

def de_set(sub, meta, use_sex, eff_tmm, eff_mor):
    d_full = pd.DataFrame({"intercept": 1.0, "sex_M": (meta["sex"] == "M").astype(float).values,
                           "condition_disease": (meta["condition"] == "disease").astype(float).values}, index=meta.index)
    Xd = d_full if use_sex else d_full[["intercept", "condition_disease"]]
    res = {"NB_TMM": de_nb(scaled(sub, eff_tmm), Xd), "NB_MOR": de_nb(scaled(sub, eff_mor), Xd)}
    lc = np.log2(scaled(sub, eff_tmm) + 0.5)
    lm, par = de_limma(lc, Xd); lm["logCPM"] = lc.mean(1).values; lm["disp"] = np.nan
    res["logCPM_eBayes"] = lm
    for t in res.values():
        t["FDR"] = bh(t["pvalue"].values)
    return res, par

