#!/usr/bin/env python3
"""
BixBench bix-51-q2
AIC for a logistic regression using BMI as the SOLE predictor of treatment
response (efficacy PR).

Fixed decisions (approved by researcher):
  * outcome : response = 1 if Efficacy == 'PR' else 0 ({'SD','PD'} -> 0)
  * sample  : rows with Efficacy notna & BMI notna  (expect n = 80)
  * model   : logit, BMI raw/continuous, no scaling, no other predictors
  * AIC     : -2*logLik + 2*k  with k = 2 (intercept + BMI slope)
  * engine  : statsmodels GLM(Binomial)  (sklearn unavailable / no AIC)
No additional models or predictor comparisons are fitted.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

XLSX = "data/data.xlsx"

# ---------------------------------------------------------------- load/clean
raw = pd.read_excel(XLSX, sheet_name="Sheet1")

# Drop the 24 trailing header-less/empty Excel columns automatically by name.
df = raw[["Efficacy", "BMI"]].copy()

# Cleaning rule (documented): keep rows with an efficacy label and numeric BMI.
# This removes the 41 blank rows at the bottom and the phantom row holding a
# single " " in the Age column (Excel row 122).
before = len(df)
df = df[df["Efficacy"].notna() & df["BMI"].notna()].copy()
df["BMI"] = pd.to_numeric(df["BMI"], errors="coerce")
df = df[df["BMI"].notna()]

n = len(df)
print("=" * 70)
print("LOGISTIC REGRESSION: response (PR) ~ BMI   [statsmodels GLM Binomial]")
print("=" * 70)
print(f"raw rows read                 : {before}")
print(f"rows dropped (blank/phantom)  : {before - n}")
print(f"n analysed                    : {n}")

# ------------------------------------------------------------- outcome coding
y = (df["Efficacy"].astype(str).str.strip() == "PR").astype(int)
print("\nEfficacy level counts:", df["Efficacy"].value_counts().to_dict())
print("outcome coding: PR -> 1 ; SD/PD -> 0")
print(f"events (y=1, PR)              : {int(y.sum())}")
print(f"non-events (y=0, SD+PD)       : {int((y == 0).sum())}")
print(f"missing BMI                   : {int(df['BMI'].isna().sum())} / {n} "
      f"(nothing to impute; complete-case filter)")
print(f"BMI range                     : {df['BMI'].min()} .. {df['BMI'].max()}")

# ------------------------------------------------------------------- fit model
X = sm.add_constant(df["BMI"].to_numpy(float), has_constant="add")
model = sm.GLM(y.to_numpy(float), X, family=sm.families.Binomial())
res = model.fit()

llf = float(res.llf)
aic_sm = float(res.aic)
aic_manual = -2.0 * llf + 2 * 2          # k = 2 : intercept + BMI slope
k = int(res.df_model + 1)

coef_bmi = float(res.params[1])
se_bmi = float(res.bse[1])
p_bmi = float(res.pvalues[1])

print("\n--- coefficients -----------------------------------------------")
print(f"Intercept  beta = {res.params[0]: .6f}   SE = {res.bse[0]:.6f}   "
      f"p = {res.pvalues[0]:.6f}")
print(f"BMI        beta = {coef_bmi: .6f}   SE = {se_bmi:.6f}   p = {p_bmi:.6f}")
print(f"odds ratio BMI  = {np.exp(coef_bmi):.6f}")

print("\n--- fit statistics ---------------------------------------------")
print(f"log-Likelihood                : {llf:.6f}")
print(f"Deviance (-2*logL)            : {float(res.deviance):.6f}")
print(f"Null deviance                 : {float(res.null_deviance):.6f}")
llnull = -float(res.null_deviance) / 2.0
print(f"Null log-Likelihood             : {llnull:.6f}")
print(f"McFadden pseudo-R2 (manual)     : {1.0 - llf / llnull:.6f}")
print(f"k (parameters incl. intercept): {k}")

print("\n--- AIC ---------------------------------------------------------")
print(f"statsmodels  res.aic          : {aic_sm:.6f}")
print(f"manual  -2*logL + 2*k (k=2)   : {aic_manual:.6f}")
print(f"absolute difference           : {abs(aic_sm - aic_manual):.3e}")
assert abs(aic_sm - aic_manual) < 1e-8, "res.aic disagrees with manual formula"

print("\n" + "=" * 70)
print(f"***  AIC  =  {aic_sm:.2f}   (unrounded: {aic_sm})  ***")
print("=" * 70)
