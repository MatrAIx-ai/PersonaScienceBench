"""
bix-51-q3: Logistic regression of treatment response (PR) on Age + BMI + Gender.

Outcome definition (confirmed with researcher):
    y = 1 if Efficacy == 'PR' (partial response)
    y = 0 for SD union PD (non-responders). SD is NOT excluded.
Model: logit(P[PR]) ~ Age + BMI + Gender (Female=1, Male=0);
no interactions, no additional adjustment (Groups deliberately excluded).
Inference: statsmodels Logit (MLE), two-sided Wald p-values; GLM(Binomial) cross-check.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

print("pandas", pd.__version__, "| numpy", np.__version__,
      "| statsmodels", sm.__version__)

# --- Load & clean -----------------------------------------------------------
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print(f"\nRaw rows read from Sheet1: {len(df)}")
df = df[df["Sequence number"].notna()].copy()   # drop blank rows + stray-space row 122
n = len(df)
print(f"Effective sample after cleaning (Sequence number notna): n = {n}")
assert n == 80, "expected n=80"
assert df[["Age", "BMI", "Gender", "Efficacy"]].notna().all().all(), "unexpected missingness"

# --- Outcome & coding -------------------------------------------------------
df["Age"] = pd.to_numeric(df["Age"])
df["y"] = (df["Efficacy"].str.strip() == "PR").astype(int)   # PR = 1, SD+PD = 0
df["Gender_F"] = (df["Gender"].str.strip() == "Female").astype(int)  # Female=1, Male=0
print("\nOutcome counts (y=1 PR | y=0 SD+PD):")
print(df["y"].value_counts().to_string())
print("Efficacy x y:")
print(pd.crosstab(df["Efficacy"], df["y"]).to_string())

# NOTE (single commented sensitivity line, not part of deliverable):
# alt: excluding SD (y=1 PR vs y=0 PD only) was considered and rejected per researcher instruction.

# --- Diagnostics: correlation + VIF -----------------------------------------
X = df[["Age", "BMI", "Gender_F"]].astype(float)
print("\nPredictor correlation matrix:")
print(X.corr().round(4).to_string())
Xv = sm.add_constant(X)
vif = pd.Series(
    [variance_inflation_factor(Xv.values, i) for i in range(1, Xv.shape[1])],
    index=X.columns, name="VIF")
print("\nVIF (with intercept):")
print(vif.round(4).to_string())

# --- Model 1: Logit (MLE, Newton) -------------------------------------------
Xm = sm.add_constant(X)
logit_res = sm.Logit(df["y"].astype(float), Xm).fit(disp=0)
print("\n==================== Logit summary ====================")
print(logit_res.summary())
print("Converged:", logit_res.mle_retvals["converged"],
      "| iterations:", logit_res.mle_retvals["iterations"],
      "| -2 logL:", round(logit_res.llf, 6))

# --- Model 2: GLM Binomial cross-check --------------------------------------
glm_res = sm.GLM(df["y"].astype(float), Xm, family=sm.families.Binomial()).fit()
print("\n==================== GLM Binomial cross-check ====================")
print(glm_res.summary())

# --- Age result extraction ---------------------------------------------------
row = logit_res.params.index.get_loc("Age")
coef, se, z, p = (logit_res.params["Age"], logit_res.bse["Age"],
                  logit_res.tvalues["Age"], logit_res.pvalues["Age"])
p_glm = glm_res.pvalues["Age"]
print("\n---------------- RESULT: Age ----------------")
print(f"n effective = {n} (41 PR vs 39 non-PR)")
print(f"coef(Age)   = {coef:.6f}")
print(f"se(Age)     = {se:.6f}")
print(f"Wald z      = {z:.6f}")
print(f"p(Age) Logit= {p:.6g}  (4 dp: {p:.4f})")
print(f"p(Age) GLM  = {p_glm:.6g}")
print("Logit vs GLM agreement:",
      np.allclose(logit_res.params, glm_res.params, atol=1e-6) and np.allclose(p, p_glm, atol=1e-6))
