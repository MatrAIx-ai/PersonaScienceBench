"""
BixBench bix-51-q4: Change in log-odds of remission per year of age.
Logistic regression: remission (PR=1 vs SD/PD=0) ~ Age + BMI + Gender(Female=0/Male=1).
Data: data/data.xlsx (Sheet1). Ghost rows dropped via Sequence number notna.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# 1) Load and clean
raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
df = raw[raw["Sequence number"].notna()].copy()
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
df["BMI"] = pd.to_numeric(df["BMI"], errors="coerce")

# 2) Outcome dichotomisation (approved assumption): PR = remission = 1; SD/PD = 0
df["remission"] = (df["Efficacy"].str.strip() == "PR").astype(int)
df["Male"] = (df["Gender"].str.strip() == "Male").astype(int)  # Female=0, Male=1

assert df[["Age", "BMI", "remission", "Male"]].notna().all().all()

X = sm.add_constant(df[["Age", "BMI", "Male"]].astype(float))
y = df["remission"].astype(float)

print(f"n = {len(df)}; outcome: remission(PR)=1 -> {int(y.sum())}, SD/PD=0 -> {int((1-y).sum())}")
print(df[["Age", "BMI"]].describe().loc[["min", "mean", "max"]].to_string())

# 3) Fit Logit (MLE, unpenalised) with Newton
res = sm.Logit(y, X).fit(disp=0, method="newton", maxiter=100)
print(res.summary())

ci = res.conf_int(alpha=0.05)
table = pd.DataFrame({
    "coef": res.params,
    "SE": res.bse,
    "CI_low": ci[0],
    "CI_high": ci[1],
    "OR": np.exp(res.params),
})
print("\nCoefficient table (log-odds scale; OR = exp(coef)):")
print(table.round(4).to_string())

age_coef = res.params["Age"]
print(f"\n>>> Age coef (log-odds per year, adj. BMI & Gender): {age_coef:.3f}")
print(f">>> Age OR per year: {np.exp(age_coef):.3f} "
      f"(95% CI {np.exp(ci.loc['Age',0]):.3f}-{np.exp(ci.loc['Age',1]):.3f})")
print(f">>> p-value Age: {res.pvalues['Age']:.4f}")

# 4) Fit diagnostics
print(f"\nConverged: {res.mle_retvals['converged']}; iterations: {res.mle_retvals['iterations']}")
print(f"Log-likelihood: {res.llf:.3f}; LLNull: {res.llnull:.3f}; "
      f"Pseudo R2 (McFadden): {res.prsquared:.4f}")
print(f"AIC: {res.aic:.2f}; BIC: {res.bic:.2f}")
print(f"Max |coef|: {res.params.abs().max():.3f} (no perfect separation expected)")
ct = pd.crosstab(df["remission"], df["Male"])
print("Outcome x Gender cell counts (min cell):\n", ct.to_string(), "\nmin cell:", ct.values.min())
