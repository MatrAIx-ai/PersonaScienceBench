"""
bix-51-q5  --  Is BMI associated with treatment response? Logistic regression.

Work specification confirmed by the researcher:
  * Clean: keep only rows with non-null 'Sequence number' (N=80); drop the 24
    headerless columns and the phantom row. No imputation.
  * Outcome (primary): response = 1 if Efficacy == 'PR' else 0 (SD or PD). No CR in data.
  * Primary model: bivariate logistic regression response ~ BMI (BMI continuous),
    MLE (statsmodels Logit). Reported p-value = Wald z-test on the BMI coefficient,
    UNADJUSTED model.
  * 'Groups' excluded entirely (perfectly confounded with the outcome).
  * Robustness only: LRT, score/LM test, covariate-adjusted model, BMI linearity,
    alternative outcome PR+SD vs PD. Hosmer-Lemeshow optional.
No value is fabricated: auxiliary statistics that fail to converge are reported as failures.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

PATH = "data/data.xlsx"
OUT = []
def say(*a):
    line = " ".join(str(x) for x in a)
    OUT.append(line)
    print(line)


def lr_test(big, small):
    """Likelihood-ratio test, computed manually (this statsmodels build has no compare_lr_test)."""
    stat = 2.0 * (big.llf - small.llf)
    dfree = float(big.df_model - small.df_model)
    return stat, dfree, float(stats.chi2.sf(stat, dfree))


def score_test_null(y, X, k_test=1):
    """Classical LM/score test for adding predictor(s), evaluated at the null (intercept-only) fit."""
    p0 = np.full(len(y), float(np.mean(y)))
    U = X.T @ (y - p0)
    W = p0 * (1 - p0)
    I = X.T @ (X * W[:, None])
    stat = float(U @ np.linalg.solve(I, U))
    return stat, k_test, float(stats.chi2.sf(stat, k_test))


# ---------------------------------------------------------------- 1. load / clean
raw = pd.read_excel(PATH)
say("RAW shape:", raw.shape)
df = raw.loc[:, [c for c in raw.columns if not (isinstance(c, str) and str(c).startswith("Unnamed"))]]
n_headerless = raw.shape[1] - df.shape[1]
df = df[df["Sequence number"].notna()].copy()          # drops empty + phantom row
say(f"worksheet has 36 columns / 24 with empty header (openpyxl); pandas returns only the 12 populated "
    f"columns -> headerless columns dropped={n_headerless} (pandas already trims fully-empty columns). "
    f"empty/phantom rows dropped: {raw.shape[0]-len(df)}")
say("CLEAN shape:", df.shape, "| missing per column:", dict(df.isna().sum()))

df["response"] = df["Efficacy"].astype(str).str.strip().eq("PR").astype(int)
df["response_alt"] = df["Efficacy"].astype(str).str.strip().isin(["PR", "SD"]).astype(int)
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
df["BMI"] = pd.to_numeric(df["BMI"], errors="coerce")
rec = {"Family history": {"Yes": 1, "No": 0}, "Chemotherapy experience": {"Yes": 1, "No": 0},
       "HBV infection": {"Yes": 1, "No": 0}, "Gender": {"Male": 1, "Female": 0},
       "Child-Pugh": {"A": 0, "B": 1}, "ECOG-PS": {"0-1": 0, "2": 1}}
for c, m in rec.items():
    df[c] = df[c].astype(str).str.strip().map(m)

COV = ["Age", "Gender", "ECOG-PS", "Child-Pugh", "Chemotherapy experience",
       "HBV infection", "Family history"]
model_df = df[["response", "response_alt", "BMI"] + COV].dropna()
say("modelling rows (complete on BMI/outcome/covariates):", model_df.shape[0])

# ------------------------------------------------- 2. confounding check on Groups
ct = pd.crosstab(df["Efficacy"], df["Groups"])
say("\nEfficacy x Groups (why 'Groups' is excluded):\n", ct.to_string())
ct2 = pd.crosstab(df["response"], df["Groups"])
say("response x Groups:\n", ct2.to_string())
pure = bool((ct2.values.max(axis=0) == ct2.values.sum(axis=0)).all())
say("Groups perfectly predicts the binary response (each Group is one response class):", pure)
say("-> Including 'Groups' would separate the outcome perfectly; it is therefore excluded from every model.")

# ------------------------------------------------------------- 3. descriptive
say("\nn =", len(model_df), "| responders (PR) =", int(model_df.response.sum()),
    "| non-responders (SD/PD) =", int((1-model_df.response).sum()))
say(model_df.groupby("response")["BMI"].agg(["count", "mean", "std", "min", "max"]).round(3).to_string())
ov = (model_df.loc[model_df.response == 1, "BMI"].min() <= model_df.loc[model_df.response == 0, "BMI"].max()
      and model_df.loc[model_df.response == 0, "BMI"].min() <= model_df.loc[model_df.response == 1, "BMI"].max())
say("BMI ranges overlap between groups (no complete separation by predictor):", ov)

# --------------------------------------------------- 4. PRIMARY model: crude BMI
X = sm.add_constant(model_df[["BMI"]].to_numpy(float), has_constant="add")
y = model_df["response"].to_numpy(int)
res = sm.Logit(y, X).fit(disp=0, method="newton", maxiter=200)
b_bmi, se_bmi, p_wald = res.params[1], res.bse[1], res.pvalues[1]
lo, hi = res.conf_int()[1]
say("\n--- PRIMARY (unadjusted) logistic regression: response ~ BMI ---")
say(res.summary().as_text())
say(f"converged={res.mle_retvals['converged']}  iterations={res.mle_retvals['iterations']}  "
    f"n={int(res.nobs)}  llf={res.llf:.4f}  llnull={res.llnull:.4f}  "
    f"pseudo_R2_LN={res.prsquared:.4f}  AIC={res.aic:.3f}")
say(f"BMI: beta={b_bmi:.6f}  SE={se_bmi:.6f}  z={res.tvalues[1]:.4f}  Wald p={p_wald:.6g}")
say(f"OR={np.exp(b_bmi):.4f}  95% CI [{np.exp(lo):.4f}, {np.exp(hi):.4f}]")
fp = res.predict(X)
say(f"separation diagnostics: fitted probs min={fp.min():.4f} max={fp.max():.4f} "
    f"(strictly inside (0,1) = {bool(((fp>0)&(fp<1)).all())}); max|beta|={np.abs(res.params).max():.3f} "
    f"-> finite SE and non-extreme coefficients = {bool(np.isfinite(res.bse).all() and np.abs(res.params).max()<10)}")
say("min fitted prob among y=1:", round(fp[y==1].min(),4), "| max fitted prob among y=0:", round(fp[y==0].max(),4))

# ------------------------------------------------- 5. robustness: LRT and score
null = sm.Logit(y, np.ones((len(y), 1))).fit(disp=0, method="newton", maxiter=200)
lr_stat_lrt, df_lrt, lrt_p = lr_test(res, null)
lrt_stat = lr_stat_lrt
say("\n--- Robustness tests on the same crude model ---")
say(f"LRT: chi2={lrt_stat:.4f} df=1 p={lrt_p:.6g}")
try:
    lm, df_lm, lm_p = score_test_null(y.astype(float), X, k_test=1)
    say(f"Score/LM test (at null fit): chi2={lm:.4f} df=1 p={lm_p:.6g}")
    try:
        lm_api, lm_p_api, _, _ = res.compare_lm_test(null, estimated_params=1)
        say(f"Score/LM cross-check via statsmodels compare_lm_test: chi2={lm_api:.4f} p={lm_p_api:.6g}")
    except Exception as e2:
        say(f"statsmodels compare_lm_test unavailable here ({type(e2).__name__}); manual value above is used")
except Exception as e:                                             # pragma: no cover
    lm, lm_p = np.nan, np.nan
    say("Score/LM test FAILED:", type(e).__name__, e)
say(f"Likelihood ratio / Wald / score comparison: Wald={p_wald:.6g}  LRT={lrt_p:.6g}  Score={lm_p:.6g}")
say(f"max relative spread among the three p-values: "
    f"{(max(p_wald, lrt_p, lm_p) - min(p_wald, lrt_p, lm_p))/min(p_wald, lrt_p, lm_p)*100:.1f}%")

# Firth-style flag: check for monotone likelihood / weak predication
say("events per estimated parameter (min arm / 2 params):",
    f"{min(int(y.sum()), int((1-y).sum()))/2:.1f}")

# cross-check of the crude model with GLM(Binomial) - should reproduce Wald p exactly
glm = sm.GLM(y, X, family=sm.families.Binomial()).fit()
say(f"cross-check GLM(Binomial, logit): beta={glm.params[1]:.6f} SE={glm.bse[1]:.6f} Wald p={glm.pvalues[1]:.6g} "
    f"-> identical to MLE Logit: {bool(np.allclose(glm.params, res.params) and np.allclose(glm.pvalues, res.pvalues))}")
# likelihood-ratio (profile-based) p-value for BMI: nested LRT, more reliable than Wald at n=80
say(f"reference (non-Wald) p for BMI = LRT p = {lrt_p:.6g}; profile-likelihood-based inference is preferred "
    f"in moderate samples, but the reported answer follows the agreed spec (Wald).")

# ------------------------------------------- 6. BMI linearity (tertiles / spline)
try:
    tert = pd.qcut(model_df["BMI"], 3, labels=False, duplicates="drop")
    D = pd.get_dummies(tert, prefix="T", drop_first=True).astype(float)
    Xt = sm.add_constant(pd.concat([D], axis=1).to_numpy(float))
    res_t = sm.Logit(y, Xt).fit(disp=0, method="newton", maxiter=200)
    st = 2.0 * (res_t.llf - res.llf)
    df_pt = 1.0
    pt = float(stats.chi2.sf(st, df_pt))
    say("NOTE: linear vs tertile models are not strictly nested; this comparison is indicative only. "
        "The nested quadratic test below is the formal linearity check.")
    Xq = np.column_stack([np.ones(len(y)), model_df.BMI.to_numpy(float), model_df.BMI.to_numpy(float)**2])
    res_q = sm.Logit(y, Xq).fit(disp=0, method="newton", maxiter=300)
    sq = 2.0 * (res_q.llf - res.llf)
    pq = float(stats.chi2.sf(sq, 1))
    say(f"NESTED linearity test (add BMI^2): chi2={sq:.4f} df=1 p={pq:.6g} "
        f"({'no evidence of non-linearity' if pq > .05 else 'non-linearity suggested'})")
    quad_p = pq
    say("\n--- Linearity of BMI ---")
    say("tertile cut points:", [round(v, 2) for v in np.quantile(model_df.BMI, [1/3, 2/3])],
        "| n per tertile:", pd.Series(tert).value_counts().sort_index().tolist())
    say("response rates by tertile:", model_df.groupby(tert)["response"].mean().round(3).tolist())
    say(f"tertile-coded vs linear BMI: LRT chi2={st:.4f} df=1 p={pt:.6g} "
        f"({'no material non-linearity' if pt > .05 else 'non-linearity suggested'})")
except Exception as e:
    pt = np.nan; quad_p = np.nan; say("tertile/quadratic linearity check FAILED:", type(e).__name__, e)
try:
    import patsy
    dm_sp = patsy.dmatrix("cr(BMI, df=3) - 1", data=model_df, return_type="dataframe")
    dm_sp = sm.add_constant(dm_sp.astype(float))
    res_s = sm.Logit(y, dm_sp.to_numpy(float)).fit(disp=0, method="newton", maxiter=300)
    ss = 2.0 * (res_s.llf - res.llf)
    df_ps = float(res_s.df_model - res.df_model)
    ps = float(stats.chi2.sf(ss, df_ps))
    say(f"restricted cubic spline (df=3) vs linear BMI: LRT chi2={ss:.4f} df={df_ps:.0f} p={ps:.6g}")
    sp_p = ps
except Exception as e:
    sp_p = np.nan; say("spline linearity check FAILED (reported as failure, not substituted):", type(e).__name__, e)

# --------------------------------------------- 7. Hosmer-Lemeshow (optional)
try:
    g = 10
    grp = pd.qcut(pd.Series(fp), q=min(g, len(np.unique(fp))), labels=False, duplicates="drop")
    tab = pd.DataFrame({"y": y, "p": fp, "g": grp}).groupby("g").agg(o=("y", "sum"), e=("p", "sum"), n=("y", "size"))
    hl = float((((tab.o - tab.e) ** 2) / (tab.e * (1 - tab.e / tab.n))).sum())
    dfree = max(len(tab) - 2, 1)
    hl_p = float(stats.chi2.sf(hl, dfree))
    say("\n--- Hosmer-Lemeshow (optional) ---")
    say(f"groups={len(tab)} HL chi2={hl:.4f} df={dfree} p={hl_p:.6g} "
        f"({'no evidence of miscalibration' if hl_p > .05 else 'possible miscalibration'})")
except Exception as e:
    hl_p = np.nan; say("Hosmer-Lemeshow FAILED:", type(e).__name__, e)

# ---------------------------------- 8. sensitivity A: covariate-adjusted (no Groups)
say("\n--- Sensitivity (explicitly NOT the answer): covariate-adjusted, Groups excluded ---")
Xa = pd.concat([model_df[["BMI"]].astype(float), model_df[COV].astype(float)], axis=1)
Xa = sm.add_constant(Xa)
try:
    resa = sm.Logit(y, Xa.to_numpy(float)).fit(disp=0, method="newton", maxiter=300)
    names = list(Xa.columns)
    ia = names.index("BMI")
    loa, hia = resa.conf_int()[ia]
    say(f"adjusted BMI: beta={resa.params[ia]:.5f} SE={resa.bse[ia]:.5f} "
        f"z={resa.tvalues[ia]:.4f} p={resa.pvalues[ia]:.6g} OR={np.exp(resa.params[ia]):.4f} "
        f"95% CI [{np.exp(loa):.4f}, {np.exp(hia):.4f}]  converged={resa.mle_retvals['converged']} n={int(resa.nobs)}")
    adj_p = float(resa.pvalues[ia])
    say("adjusted model coefficients:\n", pd.DataFrame({"beta": resa.params, "p": resa.pvalues},
                                                       index=names).round(4).to_string())
except Exception as e:
    adj_p = np.nan; say("adjusted model FAILED (reported, not substituted):", type(e).__name__, e)

# ------------------------- 9. sensitivity B: alternative outcome PR+SD vs PD; BMI tertiles
say("\n--- Sensitivity (explicitly NOT the answer): alternative outcome PR+SD vs PD ---")
try:
    ya = model_df["response_alt"].to_numpy(int)
    resb = sm.Logit(ya, X).fit(disp=0, method="newton", maxiter=200)
    say(f"PR+SD vs PD (events {int(ya.sum())}/{len(ya)-int(ya.sum())}): BMI beta={resb.params[1]:.5f} "
        f"p={resb.pvalues[1]:.6g} OR={np.exp(resb.params[1]):.4f}")
    alt_p = float(resb.pvalues[1])
except Exception as e:
    alt_p = np.nan; say("alternative-outcome model FAILED:", type(e).__name__, e)
try:
    say("\n--- Sensitivity: BMI as tertile categories, crude model ---")
    say(res_t.summary().as_text())
except Exception:
    pass


# ---------------------- 10. independent re-implementation (scipy BFGS, no statsmodels) ----
from scipy.optimize import minimize, brentq
def _nll(beta):
    z = X @ beta
    return -float(np.sum(y * z - np.logaddexp(0, z)))
r_ind = minimize(_nll, [0.0, 0.0], method="BFGS", options=dict(gtol=1e-12, maxiter=5000))
Xc = X / np.array([1.0, model_df.BMI.std()])   # keep intercept-free conditioning simple; use raw X for info
p_ind = 1/(1+np.exp(-(X @ r_ind.x)))
I_ind = X.T @ (X * (p_ind*(1-p_ind))[:, None])
se_ind = float(np.sqrt(np.linalg.inv(I_ind)[1, 1]))
z_ind = r_ind.x[1]/se_ind
say("\n--- Independent re-implementation check (scipy BFGS + observed information) ---")
say(f"beta={r_ind.x[1]:.6f} SE={se_ind:.6f} z={z_ind:.4f} Wald p={2*stats.norm.sf(abs(z_ind)):.8g} "
    f"-> matches statsmodels: {bool(abs(r_ind.x[1]-b_bmi) < 1e-5 and abs(2*stats.norm.sf(abs(z_ind))-p_wald) < 1e-5)}")
llf_hat = -_nll(r_ind.x); crit = stats.chi2.ppf(0.95, 1)
def _prof(b):
    def f(a0):
        z = a0[0] + b*xv
        return -float(np.sum(y*z - np.logaddexp(0, z)))
    rr = minimize(f, [-3.6], method="BFGS", options=dict(gtol=1e-12, maxiter=2000))
    return -rr.fun
xv = model_df["BMI"].to_numpy(float)
try:
    plo = brentq(lambda b: 2*(llf_hat - _prof(b)) - crit, r_ind.x[1]-1.5, r_ind.x[1]-1e-6)
    phi = brentq(lambda b: 2*(llf_hat - _prof(b)) - crit, r_ind.x[1]+1e-6, r_ind.x[1]+1.5)
    say(f"profile-likelihood OR CI = [{np.exp(plo):.4f}, {np.exp(phi):.4f}]  (Wald OR CI = [{np.exp(lo):.4f}, {np.exp(hi):.4f}])")
except Exception as e:
    say("profile-likelihood CI computation FAILED (reported, not substituted):", type(e).__name__, e)
tt = stats.ttest_ind(xv[model_df.response == 1], xv[model_df.response == 0], equal_var=False)
say(f"sanity check, Welch t-test on raw BMI: t={tt.statistic:.4f} p={tt.pvalue:.6g} "
    f"(same direction/scale of evidence as the logistic p={p_wald:.6g})")

# --------------------------------------------------------------- 11. FINAL ANSWER
say("\n" + "="*78)
say("FINAL ANSWER")
say(f"Question: p-value for H0 'BMI is not associated with treatment response' (logistic regression).")
say(f"Outcome definition: response = 1 if Efficacy=='PR' (n=41), 0 if SD/PD (n=39); no CR present.")
say(f"Model: UNADJUSTED bivariate logistic regression, response ~ BMI (continuous), MLE, N=80.")
say(f"Groups excluded (perfectly confounded with the outcome: Group1=100% PR, Group2=100% SD/PD).")
say(f"ANSWER  -> Wald p-value for BMI = {p_wald:.6g}  (~{p_wald:.4f})")
say(f"support: beta={b_bmi:.5f}, SE={se_bmi:.5f}, z={res.tvalues[1]:.3f}, OR={np.exp(b_bmi):.4f} "
    f"(95% CI {np.exp(lo):.4f}-{np.exp(hi):.4f}); LRT p={lrt_p:.6g}; Score p={lm_p:.6g}")
say(f"robustness: adjusted p={adj_p if isinstance(adj_p,float) else 'FAILED'}; "
    f"PR+SD-vs-PD p={alt_p if isinstance(alt_p,float) else 'FAILED'}; "
    f"linearity quadratic(nested) p={quad_p if isinstance(quad_p,float) else 'FAILED'}; "
    f"tertile p={pt if isinstance(pt,float) else 'FAILED'}; spline p={sp_p if isinstance(sp_p,float) else 'FAILED'}; "
    f"HL p={hl_p if isinstance(hl_p,float) else 'FAILED'}")
say(f"alpha=0.05 decision: {'REJECT H0 (BMI associated with response)' if p_wald < 0.05 else 'FAIL TO REJECT H0 (no evidence of association)'}")
say("="*78)

with open("analysis/logit_bmi_response.log", "w") as fh:
    fh.write("\n".join(OUT) + "\n")
