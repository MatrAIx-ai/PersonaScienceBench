"""Input inspection for bix-51-q5 (data/data.xlsx). Inspection only - no model fitted."""
import openpyxl, pandas as pd, numpy as np

PATH = "data/data.xlsx"

raw = openpyxl.load_workbook(PATH).active
hdr = [c.value for c in raw[1]]
print("sheet:", raw.title, "dims:", raw.dimensions)
print("header cells:", hdr)
print("headerless columns:", sum(h is None for h in hdr))

df = pd.read_excel(PATH)
print("\nraw shape:", df.shape)
print("raw missing:\n", df.isna().sum().to_string())

# drop headerless columns and fully/blank-empty rows
df = df.loc[:, [c for c in df.columns if not (isinstance(c, str) and c.startswith("Unnamed"))]]
df = df[df["Sequence number"].notna()].copy()
print("\nclean shape:", df.shape)
print("clean missing:\n", df.isna().sum().to_string())
print("Efficacy:\n", df["Efficacy"].value_counts().to_string())
print("Groups:\n", df["Groups"].value_counts().to_string())
print("Efficacy x Groups:\n", pd.crosstab(df["Efficacy"], df["Groups"]).to_string())
resp = df["Efficacy"].eq("PR").astype(int)
print("\nresponder counts:", resp.value_counts().to_dict())
print("BMI describe:\n", df["BMI"].describe().to_string(), "\nn unique:", df["BMI"].nunique())
print("BMI by responder:\n", df.groupby(resp)["BMI"].agg(["count", "mean", "std", "min", "max"]).to_string())
for c in ["Age", "Family history", "ECOG-PS", "Child-Pugh", "Chemotherapy experience", "HBV infection", "Gender", "Toxic and side effect"]:
    print(f"{c}: missing={df[c].isna().sum()} levels={sorted(df[c].dropna().astype(str).unique())[:12]}")
print("age numeric coercible:", int(pd.to_numeric(df["Age"], errors="coerce").isna().sum()), "failures")
print("duplicate rows (excl Sequence number):", int(df.drop(columns=["Sequence number"]).duplicated().sum()))
