"""
bix-51-q8 -- Simple logistic regression: camrelizumab response ~ age.
Fixed specification (approved by researcher):
  Y  = 1 if Efficacy in {CR, PR} (response), 0 if Efficacy in {SD, PD}   (CR clause kept although no CR occurs)
  X  = Age, raw years, linear on the logit, unstandardised -> coefficient = change in log-odds per +1 year
  n  = 80 complete rows (40 blank template rows + 1 artefact row with Age=" " excluded, declared below)
  Model = statsmodels Logit with intercept. No multivariable models.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

pd.set_option("display.width", 220); pd.set_option("display.max_columns", 60)

df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
n_raw = len(df)
blank = df.isna().all(axis=1)
df = df.loc[~blank].copy()

df["age_num"] = pd.to_numeric(df["Age"], errors="coerce")
df["eff"] = df["Efficacy"].astype("string").str.strip()
RESPOND = ["CR", "PR"]; NONRESPOND = ["SD", "PD"]

usable = df["age_num"].notna() & df["eff"].isin(RESPOND + NONRESPOND)
excluded = df.loc[~usable, ["Sequence number", "Groups", "Efficacy", "Age"]]
d = df.loc[usable].copy()
d["resp"] = d["eff"].isin(RESPOND).astype(int)

print(f"rows read (excl. header)              : {n_raw}")
print(f"blank template rows dropped           : {int(blank.sum())}")
print(f"other excluded rows (unusable Age/Y)  : {len(excluded)}")
print(excluded.to_string() if len(excluded) else "  (none)")
print(f"rows excluded in total                : {n_raw - len(d)}")
print(f"n used in the model                   : {len(d)}")
print(f"outcome prevalence (resp=1 CR/PR)     : {int(d.resp.sum())}/{len(d)} = {d.resp.mean():.4f}")
print("Efficacy categories kept              :", d.eff.value_counts().to_dict())

# Groups/ECOG-PS are a 1:1 re-encoding of the response, so they are excluded as regressors (perfect separation).
print("\nGroups x response crosstab (why Groups is NOT a regressor):")
print(pd.crosstab(d["Groups"], d["resp"]).to_string())

# separation / overlap diagnostics
print("\nAge by outcome category:")
print(d.groupby("resp")["age_num"].agg(["count", "mean", "std", "min", "max"]).to_string())
print("Age deciles x outcome (overlap check -> no cell pattern implying separation):")
print(pd.crosstab(pd.qcut(d["age_num"], 5, duplicates="drop"), d["resp"]).to_string())
print("age range responders     :", d.loc[d.resp == 1, "age_num"].min(), "-", d.loc[d.resp == 1, "age_num"].max())
print("age range non-responders :", d.loc[d.resp == 0, "age_num"].min(), "-", d.loc[d.resp == 0, "age_num"].max())
ct = pd.crosstab(d["age_num"], d["resp"])
print("distinct ages present:", int(ct.shape[0]), "| ages with both outcome classes:",
      int(((ct > 0).sum(axis=1) == 2).sum()), "| ages with a single class (sparse singles, not separation):",
      int(((ct > 0).sum(axis=1) == 1).sum()))
print("separation would need a threshold with no overlap; both classes span the whole range -> no complete separation")

# ---------------- main model: Logit, formula with intercept ----------------
res = smf.logit("resp ~ age_num", data=d).fit(disp=0)
print("\n" + "=" * 78 + "\nMAIN MODEL  statsmodels Logit:  resp ~ age_num  (intercept included)\n" + "=" * 78)
print(res.summary())

b = res.params["age_num"]; se = res.bse["age_num"]
lo, hi = res.conf_int().loc["age_num"]
print("\n--- coefficient of INTEREST (per 1 additional year of age, untransformed) ---")
print(f"beta_age (log-odds) = {b:.6f}  (~ {b:.4f})")
print(f"std error           = {se:.6f}")
print(f"z (Wald)            = {res.tvalues['age_num']:.4f}")
print(f"p (Wald, 2-sided)   = {res.pvalues['age_num']:.6g}")
print(f"95% CI (log-odds)   = [{lo:.6f}, {hi:.6f}]")
print(f"OR = exp(beta)      = {np.exp(b):.6f}   95% CI OR = [{np.exp(lo):.6f}, {np.exp(hi):.6f}]")
print(f"intercept           = {res.params['Intercept']:.6f}")
print("\n--- fit health ---")
print(f"n obs               = {int(res.nobs)}   converged = {res.mle_retvals['converged']}   "
      f"iterations = {res.mle_retvals['iterations']}   method = {res.mle_retvals.get('method', 'newton')}\n"
      f"max |score| at optimum        = {np.abs(np.c_[np.ones(len(d)), d.age_num.values].T @ (d.resp.values - res.predict(d).values)).max():.3e} (should be ~0)")
print(f"log-likelihood      = {res.llf:.6f}   null log-lik = {res.llnull:.6f}")
print(f"deviance (-2*loglik)= {-2 * res.llf:.6f}   null deviance = {-2 * res.llnull:.6f}")
print(f"LR chi2             = {res.llr:.6f} (p = {res.llr_pvalue:.6g})")
print(f"Pseudo R2 (McFadden)= {res.prsquared:.6f}")
print("fitted prob range   :", f"{res.predict(d).min():.4f} - {res.predict(d).max():.4f}")
print("separation flag     : no perfect separation (MLE finite, converged, moderate |beta|/SE)")

# ---------------- robustness 1: outcome taken from Groups ----------------
r_g = smf.logit("g ~ age_num", data=d.assign(g=(d["Groups"] == 1).astype(int))).fit(disp=0)
# ---------------- robustness 2: GLM Binomial --------------------------------
r_glm = smf.glm("resp ~ age_num", data=d, family=sm.families.Binomial()).fit()

print("\n" + "=" * 78 + "\nROBUSTNESS CHECKS\n" + "=" * 78)
print(f"1) Y := (Groups == 1)            beta_age = {r_g.params['age_num']:.10f}  SE = {r_g.bse['age_num']:.10f}  p = {r_g.pvalues['age_num']:.6g}")
print(f"2) GLM(Binomial), same Y         beta_age = {r_glm.params['age_num']:.10f}  SE = {r_glm.bse['age_num']:.10f}  p = {r_glm.pvalues['age_num']:.6g}")
print(f"max |diff| across the three routes = {max(abs(r_g.params['age_num'] - b), abs(r_glm.params['age_num'] - b)):.3e}")
print("identical Y vectors (Efficacy-derived vs Groups):",
      bool(((d['resp'] == 1) == (d['Groups'] == 1)).all()))
print("\n--- plain-language interpretation (derived, no extra model) ---")
print(f"OR per 10 additional years = exp(10*beta) = {np.exp(10 * b):.4f} "
      f"(95% CI [{np.exp(10 * lo):.4f}, {np.exp(10 * hi):.4f}])")
print(f"odds ratio 65y vs 55y     = exp(-10*beta) = {np.exp(-10 * b):.4f} (older vs younger reference)")
print(f"predicted P(response) at 50y = {1 / (1 + np.exp(-(res.params['Intercept'] + b * 50))):.3f}; "
      f"at 70y = {1 / (1 + np.exp(-(res.params['Intercept'] + b * 70))):.3f}")

print("\nANSWER: coefficient estimate for age =", f"{b:.4f}", "log-odds per year (OR =", f"{np.exp(b):.4f})")
