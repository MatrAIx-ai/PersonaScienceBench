"""
Reconnaissance script for bix-51-q8 (data/data.xlsx, sheet 'Sheet1').
Purpose: profile the inputs WITHOUT fitting any model.
Outputs: a printed audit trail (saved to analysis/01_inspection_output.txt).
"""
import pandas as pd, numpy as np

XLSX = "data/data.xlsx"
pd.set_option("display.width", 220); pd.set_option("display.max_columns", 60)

raw = pd.read_excel(XLSX, sheet_name="Sheet1", header=None)
print("raw sheet shape (incl. header row):", raw.shape)

df = pd.read_excel(XLSX, sheet_name="Sheet1")
print("pandas shape with header:", df.shape)
print("columns:", list(df.columns))
print("fully-empty (all-NaN) rows:", int(df.isna().all(axis=1).sum()))

d = df.dropna(how="all").copy()
print("rows after dropping all-NaN rows:", len(d))

# any non-null values in trailing columns (M..AJ) seen in the xlsx dimension?
import openpyxl
ws = openpyxl.load_workbook(XLSX, data_only=True)["Sheet1"]
stray = [(r, c, repr(ws.cell(r, c).value))
         for r in range(1, ws.max_row + 1) for c in range(13, ws.max_column + 1)
         if ws.cell(r, c).value not in (None, "", " ")]
print("declared xlsx max_col =", ws.max_column, "| non-empty cells beyond col L:", len(stray))

print("\n=== Efficacy ===")
print("dtype:", df["Efficacy"].dtype, "| non-null:", int(df["Efficacy"].notna().sum()))
print(df["Efficacy"].value_counts(dropna=False).to_string())
known = {"CR", "PR", "SD", "PD"}
unexp = sorted(set(df["Efficacy"].dropna().astype(str).str.strip()) - known)
print("categories outside {CR,PR,SD,PD}:", unexp)

print("\n=== Groups ===")
print("dtype:", df["Groups"].dtype, "| non-null:", int(df["Groups"].notna().sum()))
print(df["Groups"].value_counts(dropna=False).to_string())
print("crosstab Groups x Efficacy:")
print(pd.crosstab(d["Groups"], d["Efficacy"]).to_string())

print("\n=== Age ===")
print("dtype:", df["Age"].dtype, "| non-null:", int(df["Age"].notna().sum()))
print("python types present:", sorted({type(v).__name__ for v in df["Age"].dropna()}))
print("non-numeric (string) Age cells:",
      [repr(v) for v in df["Age"].dropna() if not isinstance(v, (int, float, np.integer, np.floating))])
age = pd.to_numeric(df["Age"], errors="coerce")
print("numeric Age: n =", int(age.notna().sum()))
print(age.describe().to_string())
for s in (0, 999, 9999, -1):
    print(f"  sentinel {s}: {int((age == s).sum())}")

# rows that survive the completeness screen for a model on Age x Efficacy
d["age_num"] = pd.to_numeric(d["Age"], errors="coerce")
d["eff"] = d["Efficacy"].astype("string").str.strip()
valid = d[d["age_num"].notna() & d["eff"].isin(list(known))]
print("\n=== rows usable for Age x response model ===")
print("n =", len(valid), "| responders (CR/PR) =", int(valid["eff"].isin(["CR", "PR"]).sum()),
      "| non-responders (SD/PD) =", int(valid["eff"].isin(["SD", "PD"]).sum()))
print("dropped rows (non-null somewhere but unusable):")
print(d[~d.index.isin(valid.index)].dropna(axis=1, how="all").to_string())

print("\nage by response group (descriptive only, NO model fitted):")
print(valid.assign(resp=valid["eff"].isin(["CR", "PR"]).map({True: "R", False: "NR"}))
        .groupby("resp")["age_num"].agg(["count", "mean", "std", "min", "max"]).to_string())

# perfect-separation check for the other covariates vs response
print("\nother covariates vs response (descriptive):")
for c in ["Gender", "HBV infection", "Child-Pugh", "ECOG-PS", "Family history", "Chemotherapy experience"]:
    tab = pd.crosstab(valid[c], valid["eff"].isin(["CR", "PR"]))
    mono = bool(((tab == 0).any(axis=1)).any())
    print(f"  {c}: cells with zero counts -> possible perfect separation: {mono}")
print("\nNO model was fitted by this script (reconnaissance only).")
