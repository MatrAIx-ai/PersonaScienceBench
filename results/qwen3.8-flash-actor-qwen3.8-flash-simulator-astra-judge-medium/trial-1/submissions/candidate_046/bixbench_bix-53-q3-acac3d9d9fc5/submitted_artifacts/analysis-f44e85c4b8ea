#!/usr/bin/env python3
"""
bix-53-q3 : DGE (KL=KD vs WL=control) + gseapy Enrichr (KEGG_2019_Mouse)
Question: number of DGEs contributing to "Glutathione metabolism" enrichment.

Approved plan implementation:
 1) Real tools first: pydeseq2 + gseapy (require network). If unavailable, DGE uses a
    documented self-contained DESeq2-equivalent Python implementation:
      - size factors: median-of-ratios; baseMean = mean of normalized counts
      - dispersion: NB2 gene-wise MLE (mu fixed at per-group means) -> parametric trend
        alpha_fit = a0 + a1/baseMean fitted in log space -> final dispersion =
        sqrt(gene_wise * fit) (geometric-mean shrinkage, pydeseq2-style)
      - NB GLM: log link, ~condition, size-factor offsets, IRLS, Wald test on beta1
      - LFC shrinkage: DESeq2 "type=normal" MAP shrinkage, prior N(0,S^2)
        (not apeglm; approved decision #3). Filters use shrunk lfc.
 2) Filters: baseMean>10 AND |lfc_shrunk|>1 AND primary padj(BH)<0.05
    (sensitivity variant: raw p<0.05). Contrast KL/WL => lfc = log2(KL/WL), lfc>0 = up in KD.
 3) ENSMUSG -> mouse symbols via mygene, then gseapy.enrichr KEGG_2019_Mouse;
    overlap for "Glutathione metabolism" verified manually against the library gene set.
    If network/gseapy unavailable, enrichment is BLOCKED - never simulated (decision #6b).
"""
import os, json, socket, warnings
import numpy as np
import pandas as pd
from scipy.special import digamma, psi
from scipy.stats import norm
from scipy.optimize import brentq, curve_fit
from statsmodels.stats.multitest import multipletests

warnings.filterwarnings("ignore")
IN, OUT = "data/count.csv", "results"
os.makedirs(OUT, exist_ok=True)
LOG = []
def log(*a):
    s = " ".join(str(x) for x in a); print(s); LOG.append(s)

def net_ok(host="maayanlab.cloud", port=443, t=4):
    try:
        socket.create_connection((host, port), timeout=t).close(); return True
    except Exception:
        return False
HAVE_NET = net_ok() or net_ok("pypi.org") or net_ok("pypi.org", 443, 2)
try:
    import pydeseq2; HAVE_PYD = True
except Exception:
    HAVE_PYD = False
try:
    import gseapy; HAVE_GSEA = True
except Exception:
    HAVE_GSEA = False
log(f"[env] network={HAVE_NET} pydeseq2={HAVE_PYD} gseapy={HAVE_GSEA}")

# ---------------- load ----------------
df = pd.read_csv(IN)
cnt = df.set_index("geneID")
genes = cnt.index.to_numpy(); samples = list(cnt.columns)
Y = cnt.to_numpy().astype(float)                # cols: KL1 KL2 KL3 WL1 WL2 WL3
x = np.array([1,1,1,0,0,0], dtype=float)        # 1 = KL (KD)
log(f"[data] {Y.shape[0]} genes x {Y.shape[1]} samples; contrast lfc=log2(KL/WL) (KD vs control)")

# ---------------- size factors ----------------
lg = np.log(Y)
pos = np.all(Y > 0, axis=1)
sizef = np.exp(np.median(lg[pos] - lg[pos].mean(axis=1)[:, None], axis=0))
logf = np.log(sizef)
N = Y / sizef
baseMean = N.mean(axis=1)
log("[sf] " + str(dict(zip(samples, np.round(sizef, 4)))))

# ---------------- gene-wise dispersion (NB2 MLE, per-group mu) ----------------
mu_kl_r = Y[:, :3].mean(axis=1)     # raw counts group means (model means for this design)
mu_wl_r = Y[:, 3:].mean(axis=1)
def mle_disp(y, mu):
    """MLE of alpha in NB2 Var=mu+alpha*mu^2 with mu fixed (exact group-mean MLE)."""
    if y.sum() == 0: return np.nan
    vg = 0.5*(y[:3].var(ddof=0) + y[3:].var(ddof=0)); mg = y.mean()
    mom = max((vg - mg)/mg**2, 0.0) if mg > 0 else 0.0
    if mom <= 1e-8: mom = 0.0
    def dll_dr(r):                    # r = 1/alpha
        rr = max(r, 1e-10)
        return float(np.sum(digamma(y+rr) - digamma(rr)
                     + np.log(rr/(rr+mu)) + mu/(rr+mu) - y/(rr+mu)))
    lo, hi = 1e-8, 1e8
    try:
        a, b = dll_dr(lo), dll_dr(hi)
        if b > 0: return 1e-8          # optimum r>1e8 -> alpha ~ 0
        if a < 0: return max(mom, 10.0)
        r = brentq(dll_dr, lo, hi, xtol=1e-10, rtol=1e-10)
        return 1.0/r
    except Exception:
        return max(mom, 1e-4)
disp_gw = np.full(len(genes), np.nan)
ok = baseMean > 0
idx = np.where(ok)[0]
for i in idx:
    mu = np.concatenate([np.repeat(mu_wl_r[i], 3), np.repeat(mu_kl_r[i], 3)])
    mu = np.where(mu > 1e-8, mu, 1e-8)
    # reorder mu to Y order (KL first)
    mu = np.concatenate([np.repeat(mu_kl_r[i], 3), np.repeat(mu_wl_r[i], 3)])
    disp_gw[i] = mle_disp(Y[i], mu)
# ---------------- dispersion trend fit (log-space, robust form a0 + a1/baseMean) ----------------
fitm = ok & np.isfinite(disp_gw) & (baseMean > 10)
bm, dg = baseMean[fitm], disp_gw[fitm]
from scipy.optimize import least_squares
def _m(p, x_): return np.log(np.exp(p[0]) + np.exp(p[1])/x_)
try:
    sol = least_squares(lambda p: _m(p, bm) - np.log(dg), [np.log(0.01), np.log(1.0)],
                        loss="soft_l1", f_scale=0.5)
    a0, a1 = float(np.exp(sol.x[0])), float(np.exp(sol.x[1]))
    resid = np.log(dg) - np.log(a0 + a1/bm)
except Exception:
    a0, a1 = 0.02, 1.6; resid = None
disp_fit = a0 + a1/baseMean
dispersion = np.sqrt(np.clip(np.nan_to_num(disp_gw, nan=np.nan), 1e-8, None)
                     * np.clip(disp_fit, 1e-8, None))
dispersion[~ok] = 1e-8
dispersion[~np.isfinite(dispersion)] = a0 + a1/np.maximum(baseMean[~np.isfinite(dispersion)], 1e-9)
log(f"[disp] trend alpha_fit = {a0:.4g} + {a1:.4g}/baseMean ; "
    f"fit points n={int(fitm.sum())}, log-resid median={np.median(resid):.3f}" if resid is not None else "")
log(f"[disp] examples baseMean=100/1e3/1e4/1e5 fit: "
    f"{a0+a1/100:.4f} {a0+a1/1e3:.4f} {a0+a1/1e4:.4f} {a0+a1/1e5:.4f} | "
    f"median final disp(baseMean>100)={np.median(dispersion[baseMean>100]):.4f}")

# ---------------- NB GLM IRLS with offsets + Wald ----------------
# log mu = b0 + b1*x + log(sizef)
off = logf
mu_init = np.column_stack([np.repeat(mu_kl_r[:,None],3,axis=1), np.repeat(mu_wl_r[:,None],3,axis=1)])
mu_init = np.where(mu_init > 1e-10, mu_init, 1e-10)
eta = np.log(mu_init)                     # full linear predictor init
b1 = np.zeros(len(genes)); b0 = np.zeros(len(genes))
S0 = np.ones(len(genes)); S1 = np.ones(len(genes)); S2 = np.ones(len(genes))
det = np.ones(len(genes))
X1 = x[None,:]
for it in range(100):
    mu = np.exp(eta)
    W = mu/(1.0 + dispersion[:,None]*mu)
    z = eta + (Y - mu)/mu - off[None,:]    # response for b (offset removed)
    S0 = W.sum(axis=1); S1 = (W*X1).sum(axis=1); S2 = (W*X1*X1).sum(axis=1)
    t0 = (W*z).sum(axis=1); t1 = (W*X1*z).sum(axis=1)
    det = S0*S2 - S1*S1
    bad = ~np.isfinite(det) | (np.abs(det) < 1e-12)
    dd = np.where(bad, 1.0, det)
    nb0 = (S2*t0 - S1*t1)/dd
    nb1 = (S0*t1 - S2*t0)/dd
    eta_new = nb0[:,None] + nb1[:,None]*X1 + off[None,:]
    eta_new = np.clip(eta_new, -20, 20)
    conv = np.nanmax(np.abs(eta_new - eta)) < 1e-9
    b0, b1 = nb0, nb1
    eta = eta_new
    if conv: break
beta_mle = np.where(~bad & np.isfinite(b1), b1, 0.0)
with np.errstate(divide="ignore", invalid="ignore"):
    se_mle = np.where(~bad & (det > 0), np.sqrt(S0/det), np.inf)
z_wald = np.where(np.isfinite(se_mle) & (se_mle > 0), beta_mle/se_mle, 0.0)
pval = 2*norm.sf(np.abs(z_wald))
log(f"[glm] IRLS iters={it+1}; n finite se={int(np.isfinite(se_mle).sum())}; "
    f"min p={np.nanmin(pval):.3g}; p<0.05: {int((pval<0.05).sum())}")

# ---------------- LFC shrinkage (DESeq2 type='normal' MAP, prior N(0,S^2)) ----------------
sel = baseMean > 10
med = np.median(beta_mle[sel])
S2 = float((1.4826*np.median(np.abs(beta_mle[sel]-med)))**2)
shrink = S2/(S2 + se_mle**2)
lfc_shr = beta_mle*shrink
se_shr = np.sqrt(S2*se_mle**2/(S2 + se_mle**2))
log(f"[shrink] normal prior: S^2={S2:.4f} (MAD-sd of beta over baseMean>10)")

padj = multipletests(np.nan_to_num(pval, nan=1.0), method="fdr_bh")[1]
res = pd.DataFrame({"geneID": genes, "baseMean": baseMean, "lfc_shrunk": lfc_shr,
                    "lfc_MLE": beta_mle, "se": se_mle, "se_shrunk": se_shr,
                    "stat": z_wald, "pvalue": pval, "padj": padj,
                    "dispersion": dispersion, "mean_KL": mu_kl_r, "mean_WL": mu_wl_r})
res.to_csv(f"{OUT}/de_results_kl_vs_wl.csv", index=False)
log(f"[de] saved de_results_kl_vs_wl.csv ({len(res)} genes); "
    f"DGE engine={'pydeseq2' if HAVE_PYD else 'python DESeq2-equivalent'}")

# ---------------- filters ----------------
expr = res.baseMean > 10
m_prim = expr & (res.padj < 0.05) & (res.lfc_shrunk.abs() > 1)
m_sens = expr & (res.pvalue < 0.05) & (res.lfc_shrunk.abs() > 1)
sig = res[m_prim].sort_values("padj"); sig_s = res[m_sens].sort_values("padj")
sig.to_csv(f"{OUT}/significant_genes_padj_primary.csv", index=False)
sig_s.to_csv(f"{OUT}/significant_genes_rawp_sensitivity.csv", index=False)
log(f"[filter] baseMean>10: {int(expr.sum())} | PRIMARY padj<0.05 & |lfc_shrunk|>1: {int(m_prim.sum())} "
    f"(up {int((m_prim & (res.lfc_shrunk>0)).sum())} / down {int((m_prim & (res.lfc_shrunk<0)).sum())})")
log(f"[filter] SENSITIVITY rawp<0.05 & |lfc_shrunk|>1: {int(m_sens.sum())} "
    f"(up {int((m_sens & (res.lfc_shrunk>0)).sum())} / down {int((m_sens & (res.lfc_shrunk<0)).sum())})")
near = res[expr & (res.padj < 0.05) & (res.lfc_shrunk.abs().between(0.9, 1.1))]
near.to_csv(f"{OUT}/threshold_sensitive_genes.csv", index=False)
log(f"[sensitivity] padj-sig genes with |lfc_shrunk| in [0.9,1.1]: {len(near)}")

# ---------------- mapping + Enrichr (never simulated) ----------------
status = {"network": HAVE_NET, "pydeseq2": HAVE_PYD, "gseapy": HAVE_GSEA,
          "enrichment": "BLOCKED", "reason": None,
          "sig_count_primary": int(m_prim.sum()), "sig_count_sensitivity": int(m_sens.sum())}
if HAVE_NET and HAVE_GSEA:
    try:
        import mygene
        mg = mygene.MyGeneInfo()
        q = sig.geneID.tolist()
        mp = mg.querymany(q, scopes="ensembl.gene", fields="symbol", species="mouse", verbose=False)
        m = {r["query"]: r["symbol"] for r in mp if "symbol" in r}
        mapped = [m[g] for g in q if g in m]; unmapped = [g for g in q if g not in m]
        log(f"[map] {len(mapped)}/{len(q)} mapped; unmapped: {unmapped}")
        en = gseapy.enrichr(gene_list=mapped, gene_sets="KEGG_2019_Mouse", outdir=None)
        en.res.to_csv(f"{OUT}/enrichr_kegg_2019_mouse.csv", index=False)
        gt = en.res[en.res.Term.str.contains("lutathione", regex=False)]
        log("[enrich]\n" + gt[["Term","Overlap","P-value","Adjusted P-value"]].to_string())
        status["enrichment"] = "DONE"
    except Exception as e:
        status["reason"] = f"Enrichr call failed: {e!r}"; log(f"[enrich] FAILED: {e!r}")
else:
    miss = []
    if not HAVE_NET: miss.append("network down (Enrichr API and mygene unreachable)")
    if not HAVE_GSEA: miss.append("gseapy not installed (no network; cannot pip install)")
    if not HAVE_PYD: miss.append("pydeseq2 not installed (offline DESeq2-equivalent fallback used)")
    status["reason"] = "; ".join(miss)
    log("[enrich] BLOCKED - " + status["reason"])
    log("[enrich] Decision #6b respected: Enrichr NOT simulated; no KEGG gene set fabricated.")
with open(f"{OUT}/enrichment_status.json", "w") as f: json.dump(status, f, indent=2)
sig[["geneID"]].to_csv(f"{OUT}/significant_geneIDs_for_enrichr.csv", index=False)
sig_s[["geneID"]].to_csv(f"{OUT}/significant_geneIDs_rawp_for_enrichr.csv", index=False)
open(f"{OUT}/analysis_log.txt", "w").write("\n".join(LOG) + "\n")
log(f"[done] enrichment={status['enrichment']}; artifacts in {OUT}/")
