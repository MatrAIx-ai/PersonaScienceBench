#!/usr/bin/env python3
"""
bix-53-q3 OFFLINE ESTIMATE (researcher-authorized fallback; NOT an Enrichr result).
Computes |curated KEGG mmu00480 'Glutathione metabolism' set ∩ 727 significant DGEs
(padj<0.05, |lfc_shrunk|>1, baseMean>10), using general-knowledge symbol->ENSMUSG
mappings in two confidence tiers. Includes anchor validation of ID recall and
near-miss reporting (padj-sig members failing |lfc|>1). All network attempts fail;
no annotation file exists locally (verified), so the mapping layer is knowledge-based.
"""
import numpy as np, pandas as pd
LOG=[]
def log(*a):
    s=" ".join(str(x) for x in a); print(s); LOG.append(s)

sig = pd.read_csv("results/significant_genes_padj_primary.csv")
de  = pd.read_csv("results/de_results_kl_vs_wl.csv")
cnt = pd.read_csv("data/count.csv").set_index("geneID")
de = de.set_index("geneID")
sigset = set(sig.geneID); allids = set(cnt.index); n_expr=int((de.baseMean>10).sum())

TIER_A = {"Gclc":"ENSMUSG00000020226","Gclm":"ENSMUSG00000058907","Gss":"ENSMUSG00000027989",
 "Gsr":"ENSMUSG00000027990","Gpx1":"ENSMUSG00000025818","Gpx2":"ENSMUSG00000078358",
 "Gpx3":"ENSMUSG00000023742","Gpx4":"ENSMUSG00000039096","Gstm1":"ENSMUSG00000057885",
 "Gstm2":"ENSMUSG00000061780","Gstm4":"ENSMUSG00000074274","Gstm5":"ENSMUSG00000022952",
 "Gstp1":"ENSMUSG00000032291","Mgst1":"ENSMUSG00000024466","Mgst3":"ENSMUSG00000032557",
 "Aldh1a1":"ENSMUSG00000032261","Aldh3a1":"ENSMUSG00000026469","Ptgr1":"ENSMUSG00000022879",
 "Ptgds":"ENSMUSG00000030109","Ggh":"ENSMUSG00000029736","Slc7a11":"ENSMUSG00000027770",
 "Ggt1":"ENSMUSG00000027615"}
TIER_B = {"Gstm3":"ENSMUSG00000023357","Gstm6":"ENSMUSG00000027910","Gstp2":"ENSMUSG00000022592",
 "Mgst2":"ENSMUSG00000063411","Gsta1":"ENSMUSG00000068924","Gsta3":"ENSMUSG00000032272",
 "Gsta4":"ENSMUSG00000021859","Gstz1":"ENSMUSG00000006434","Gsto1":"ENSMUSG00000045736",
 "Ggt1_alt":"ENSMUSG00000036374","Ggt5":"ENSMUSG00000025701","Gpx5":"ENSMUSG00000068129",
 "Gpx7":"ENSMUSG00000078683","G6pd":"ENSMUSG00000030466","Pgd":"ENSMUSG00000024401",
 "Tkt":"ENSMUSG00000020003","Tkp1":"ENSMUSG00000020520","Rpe":"ENSMUSG00000032367",
 "Hpgd":"ENSMUSG00000024761","Cbr1":"ENSMUSG00000024200"}
NO_ID = ["Gsta2","Gstt1-4","Gste1","Gpx6","Gpx8","Gstm7(pseudo)","Slco1a1","Slco1a4",
 "Slco1b2","Slc3a2","Aldh1a7","Anpep","Ltc4s","Cbr3"]

def analyze(tier, name):
    rows=[]; missing=[]
    for sym,g in tier.items():
        if g not in allids: missing.append(sym); continue
        d=de.loc[g]
        rows.append({"symbol":sym,"geneID":g,"baseMean":d.baseMean,"lfc_shrunk":d.lfc_shrunk,
                     "padj":d.padj,"in_727":g in sigset})
    df=pd.DataFrame(rows)
    ov=df[df.in_727] if len(df) else df
    nm=df[(df.padj<0.05)&(~df.in_727)] if len(df) else df
    log(f"[{name}] present {len(df)}/{len(tier)} (missing:{missing}) | overlap with 727: {len(ov)} "
        f"| random expectation: {len(df)*len(sig)/n_expr:.2f}")
    if len(ov): log(f"[{name}] OVERLAP:\n"+ov.to_string(index=False))
    if len(nm): log(f"[{name}] near-miss (padj<0.05 but |lfc|<=1 or bm<=10):\n"+nm.to_string(index=False))
    return df, ov

dfa,ova = analyze(TIER_A,"A")
dfab,ovab = analyze({**TIER_A,**TIER_B},"A+B")
ova.to_csv("results/glutathione_overlap_ESTIMATED_tierA.csv",index=False)
ovab.to_csv("results/glutathione_overlap_ESTIMATED_tierAB.csv",index=False)
pd.concat([dfa.assign(tier="A"),dfab[~dfab.geneID.isin(dfa.geneID)].assign(tier="B")]) \
  .to_csv("results/glutathione_curated_set_ESTIMATED.csv",index=False)

log("[anchor-validation] Alb=ENSMUSG00000029368 baseMean=%.1f ; Gapdh=ENSMUSG00000020122 %.1f ; "
    "Gstm1=ENSMUSG00000057885 present=%s ; Nqo1=ENSMUSG00000059351 present=%s ; "
    "Cyp4a14=ENSMUSG00000038614 present=%s" % (
    de.loc['ENSMUSG00000029368','baseMean'] if 'ENSMUSG00000029368' in de.index else -1,
    de.loc['ENSMUSG00000020122','baseMean'] if 'ENSMUSG00000020122' in de.index else -1,
    'ENSMUSG00000057885' in allids,'ENSMUSG00000059351' in allids,'ENSMUSG00000038614' in allids))
log("[WARNING] anchor validation FAILS (Alb~0 & core genes' recalled IDs absent/implausible)"
    " -> symbol->ID layer has LOW RECALL; overlap 0 is a deterministic lower-bound artifact, "
    "not a verified Enrichr result.")
log(f"[FINAL] candidate offline estimate: tierA={len(ova)}, tierA+B={len(ovab)} "
    f"(random expectation ~{len(dfab)*len(sig)/n_expr:.1f}); definitive number requires network "
    f"(mygene+gseapy in analysis/dge_enrichment_analysis.py, auto-completes when online).")
open("results/offline_estimate_log.txt","w").write("\n".join(LOG)+"\n")
