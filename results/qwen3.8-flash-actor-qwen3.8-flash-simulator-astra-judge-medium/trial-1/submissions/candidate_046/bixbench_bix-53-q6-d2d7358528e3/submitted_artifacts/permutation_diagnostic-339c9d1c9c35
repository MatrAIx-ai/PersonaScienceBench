#!/usr/bin/env python3
"""Diagnostic: permutation calibration for the FALLBACK NB-GLM backend (mirrors the
estimation code in ube2m_kegg_gsea.py exactly). Re-runs the same DE estimation with
12 random 3-vs-3 relabelings and compares #{p<0.05 | baseMean>10} to the observed
value. Null ~5% => calibrated (observed excess = real signal); otherwise the fallback
underestimates dispersion (documented limitation)."""
import numpy as np, pandas as pd
from scipy import stats, optimize
from scipy.special import gammaln
rng = np.random.default_rng(42)
cnt = pd.read_csv("/workspace/data/count.csv")
Y = cnt[["KL1","KL2","KL3","WL1","WL2","WL3"]].to_numpy(float); n = 6
gm = np.nanmean(np.where(Y > 0, np.log(Y), np.nan), 1)
logY = np.where(Y > 0, np.log(Y), np.nan)
sf = np.exp(np.nanmedian(logY[np.isfinite(gm)] - gm[np.isfinite(gm), None], 0))
sf = np.where(np.isfinite(sf) & (sf > 0), sf, 1.0)
sc = sf[3:].mean() / sf; logsf = np.log(sc)
baseMean = (Y * sc[None, :]).mean(1)
mb = baseMean > 10
idx0 = np.flatnonzero(Y.sum(1) > 0)

def de_once(x):
    n1, n0 = int(x.sum()), int(6 - x.sum())
    sum1 = Y[:, x == 1].sum(1); sum0 = Y[:, x == 0].sum(1)
    sc1, sc0 = sc[x == 1].sum(), sc[x == 0].sum()
    mu1 = (sum1 + 0.5) / sc1; mu0v = (sum0 + 0.5) / sc0
    mu0 = np.repeat(mu0v[:, None], 6, 1); mu0[:, x == 1] = mu1[:, None]
    A00 = mu0.sum(1); A11 = mu0[:, x == 1].sum(1)
    det = np.maximum(A00 * A11 - A11 ** 2, 1e-12)
    hj = np.zeros_like(mu0); hj[:, x == 0] = (A11 / det)[:, None]
    hj[:, x == 1] = ((A00 - A11) / det)[:, None]; hj = np.clip(hj, 0, .999)
    num = ((Y - mu0) ** 2 - mu0).sum(1); den = ((1 - hj) * mu0 ** 2).sum(1)
    ag = np.clip(np.nan_to_num(num / np.where(den > 0, den, np.nan), nan=.05, posinf=10), 1e-8, 10)
    mbar = mu0.mean(1); e = mbar > 1e-6
    c, *_ = np.linalg.lstsq(np.column_stack([np.ones(int(e.sum())), 1 / np.maximum(mbar[e], 1e-6)]),
                            np.log(ag[e]), rcond=None)
    at = np.clip(np.exp(c[0] + c[1] / np.maximum(mbar, 1e-6)), 1e-8, 10)
    dv = np.log(ag[e]) - np.log(at[e]); pv = max(np.var(dv) - np.pi ** 2 / 6, .25)
    w = np.clip(pv / (pv + 1 / 4), 0, 1)
    a_ = np.clip(np.exp(w * np.log(ag) + (1 - w) * np.log(at)), 1e-8, 10)
    p = np.ones(len(Y))
    b0i = np.log(np.maximum(mu0v, 1e-6)) - logsf[x == 0].mean()
    b1i = np.nan_to_num(np.clip(np.log(np.maximum(mu1, 1e-6)) - np.log(np.maximum(mu0v, 1e-6)), -5, 5))
    for i in idx0:
        k = Y[i]; al = a_[i]; r = 1 / al
        def fg(bb, k=k, r=r):
            eta = np.clip(bb[0] + bb[1] * x + logsf, -30, 30); mu = np.exp(eta)
            f = -np.sum(k * eta + gammaln(k + r) - gammaln(r) - gammaln(k + 1)
                        + k * np.log(r) - (k + r) * np.log(mu + r))
            d = (k + r) / (mu + r) * mu - k
            return f, np.array([d.sum(), (d * x).sum()])
        ri = optimize.minimize(fg, [b0i[i], b1i[i]], jac=True, method="L-BFGS-B",
                               options=dict(maxiter=300, ftol=1e-13, gtol=1e-10))
        mu = np.exp(np.clip(ri.x[0] + ri.x[1] * x + logsf, -30, 30)); W = mu / (1 + al * mu)
        s1 = W[x == 1].sum(); s0 = W.sum(); dt = max(s0 * s1 - s1 ** 2, 1e-12)
        se = np.sqrt(s0 / dt) / np.log(2)
        p[i] = 2 * stats.norm.sf(abs((ri.x[1] / np.log(2)) / se)) if se > 0 else 1.0
    return p

obs = de_once(np.array([1, 1, 1, 0, 0, 0], float))
fo = float((obs[mb] < .05).mean())
print("observed frac p<0.05 (baseMean>10): %.3f" % fo)
fr = []
for t in range(12):
    x = np.zeros(6, bool); x[rng.permutation(6)[:3]] = True
    pp = de_once(x.astype(float))
    fr.append(float((pp[mb] < .05).mean()))
    print("perm %2d: %.3f" % (t, fr[-1]), flush=True)
print("permutation null: mean=%.3f sd=%.3f" % (np.mean(fr), np.std(fr)))
print("=> calibration:", "OK" if np.mean(fr) < .10 else "INFLATED")
np.save("/workspace/analysis/perm_pvals.npy", obs)
