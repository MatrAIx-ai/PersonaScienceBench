"""CHIP variants per sample after removing intronic/intergenic/UTR annotations.
Rules fixed by researcher (2026-10-23):
 R1 carried = Zygosity in {Heterozygous, Homozygous Variant} (labels stripped first)
 R2 exclude SO: intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant,
                5_prime_UTR_premature_start_codon_gain_variant
 R3 keep upstream_gene_variant in the headline number (sensitivity: excluded)
 R4 dedupe by (Chr:Pos, Ref/Alt) inside each sample; report multi-allelic positions
 R5 denominator = 86 workbooks; secondary: 29 probands, samples with >=1 variant
"""
import pandas as pd, numpy as np, glob, re, warnings, collections
warnings.filterwarnings('ignore')

CARRY = {'Heterozygous', 'Homozygous Variant'}
EXCLUDE = {'intron_variant', '3_prime_UTR_variant', '5_prime_UTR_variant',
           '5_prime_UTR_premature_start_codon_gain_variant'}

def load(f):
    df = pd.read_excel(f, header=[0, 1])
    col = {}
    for blk, sub in df.columns:
        col.setdefault(str(sub).strip(), (blk, str(sub).strip()))
    sb = [b for b, s in df.columns if str(b).split(' (')[0] in ('Proband','Child','Mother','Father')]
    assert len(set(sb)) == 1, f'{f}: {len(set(sb))} sample blocks'
    blk = sb[0]
    def g(sub):
        blk_, key = col[sub]
        return df[blk_] if False else df[[c for c in df.columns if (c[0]==blk_ and str(c[1]).strip()==key)][0]]
    out = pd.DataFrame({
        'chrpos': g('Chr:Pos').astype(str).str.strip(),
        'refalt': g('Ref/Alt').astype(str).str.strip(),
        'zyg':    df[[c for c in df.columns if c[0]==blk and str(c[1]).strip()=='Zygosity'][0]]
                    .astype('string').str.strip(),
        'so':     g('Sequence Ontology (Combined)').astype('string').str.strip(),
    })
    out['sample_block'] = blk
    return out

def count(df, exclude, zyg_set, dedupe=True):
    m = df['zyg'].isin(zyg_set) & df['so'].notna() & ~df['so'].isin(exclude) & df['so'].ne('<NA>')
    sel = df.loc[m, ['chrpos', 'refalt']]
    return sel.drop_duplicates().shape[0] if dedupe else sel.shape[0]

files = sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx'))
assert len(files) == 86, len(files)

rows, term_het, term_hom, audit = [], collections.Counter(), collections.Counter(), collections.Counter()
multi = 0
multi_ex = []
for f in files:
    d = load(f)
    sid = f.split('_')[-1].replace('.xlsx', '')
    audit['rows'] += len(d)
    audit['het'] += int((d['zyg'] == 'Heterozygous').sum())
    audit['hom'] += int((d['zyg'] == 'Homozygous Variant').sum())
    audit['ref'] += int((d['zyg'] == 'Reference').sum())
    audit['blank'] += int(d['zyg'].isna().sum() | (d['zyg'] == '').sum())
    carried = d[d['zyg'].isin(CARRY)]
    pos = carried.groupby('chrpos')['refalt'].nunique()
    mm = int((pos > 1).sum())
    multi += mm
    if mm and len(multi_ex) < 8:
        multi_ex.append((sid, pos[pos > 1].head(3).to_dict()))
    kept = carried[carried['so'].notna() & ~carried['so'].isin(EXCLUDE)]
    kded = kept.drop_duplicates(['chrpos', 'refalt'])
    for t in kded['so']:
        z = 'Het' if t in set() else None
    for _, r in kded.iterrows():
        (term_het if r['zyg'] == 'Heterozygous' else term_hom)[r['so']] += 1
    rows.append(dict(
        sample_id=sid, sample_block=d['sample_block'].iloc[0], rows_in_file=len(d),
        n_variants=count(d, EXCLUDE, CARRY),
        n_het=int((kded['zyg'] == 'Heterozygous').sum()),
        n_hom=int((kded['zyg'] == 'Homozygous Variant').sum()),
        n_no_dedup=count(d, EXCLUDE, CARRY, dedupe=False),
        n_excl_upstream=count(d, EXCLUDE | {'upstream_gene_variant'}, CARRY),
        n_excl_splice=count(d, EXCLUDE | {'splice_region_variant'}, CARRY),
        n_with_reference=count(d, EXCLUDE, CARRY | {'Reference'}),
    ))

T = pd.DataFrame(rows).sort_values('sample_id').reset_index(drop=True)

# proband mapping (clean spaces/tabs in Trio_Status)
ts = pd.read_excel('data/230215_Trio_Status.xlsx')
ts.columns = [str(c).strip() for c in ts.columns]
ts['Sample ID'] = ts['Sample ID'].astype(str).str.strip()
ts['Status'] = ts['Status'].astype(str).str.strip()
prob_ids = set(ts.loc[ts['Status'].isin(['Patient', 'Child']), 'Sample ID'])
T['is_proband'] = T['sample_id'].str.split('-').str[0].isin(prob_ids)
T['status'] = T['sample_id'].map(
    dict(zip(ts['Sample ID'], ts['Status']))).where(
    T['sample_id'].str.split('-').str[0].isin(set(ts['Sample ID'])))
T.to_csv('analysis/chip_variants_per_sample.csv', index=False)

n = T['n_variants']
print('=== AUDIT vs scan totals (expect rows 57258, het 7303, hom 4593, ref 44211, blank 1151) ===')
print(dict(audit))
print('\n=== HEADLINE: mean of filtered CHIP variants per sample over 86 workbooks ===')
print('mean   = %.4f  (%s / 86)' % (n.mean(), int(n.sum())))
print('median = %s   min = %d   max = %d   sd(sample,n-1) = %.4f' % (n.median(), n.min(), n.max(), n.std(ddof=1)))
print('total variants = %d ; samples with >=1 = %d ; zero-variant samples = %d'
      % (n.sum(), int((n >= 1).sum()), int((n == 0).sum())))
print('\n=== SECONDARY denominators ===')
print('29 probands (Patient+Child): n=%d mean=%.4f  sum=%d' % (T.is_proband.sum(), n[T.is_proband].mean(), n[T.is_proband].sum()))
print('samples with >=1 filtered variant: n=%d mean=%.4f' % ((n>=1).sum(), n[n>=1].mean()))
print('multi-allelic positions (same Chr:Pos, >=2 Ref/Alt) inside a sample, CARRIED rows: %d' % multi)
print('  examples:', multi_ex[:5])
allpos = []
print('\n=== SENSITIVITY (means over 86) ===')
for lab, c in [('headline (upstream+splice kept, deduped)', 'n_variants'),
               ('upstream_gene_variant excluded', 'n_excl_upstream'),
               ('splice_region_variant excluded', 'n_excl_splice'),
               ('Reference counted as carried', 'n_with_reference'),
               ('no deduplication', 'n_no_dedup')]:
    v = T[c]
    print('%-45s mean=%8.4f median=%6.1f min=%3d max=%4d total=%6d' % (lab, v.mean(), v.median(), v.min(), v.max(), v.sum()))
print('\n=== KEPT SO TERMS among counted rows (deduped) ===')
tot = {t: term_het[t] + term_hom[t] for t in set(term_het) | set(term_hom)}
for t in sorted(tot, key=lambda x: -tot[x]):
    print('%-24s Het=%5d Hom=%5d total=%5d' % (t, term_het[t], term_hom[t], tot[t]))
print('%-24s Het=%5d Hom=%5d total=%5d' % ('TOTAL', sum(term_het.values()), sum(term_hom.values()), sum(tot.values())))
print('\nreconciliation: sum of per-sample n_variants = %d == term total %d' % (n.sum(), sum(tot.values())))
pd.DataFrame([{'term':t,'Het':term_het[t],'Hom':term_hom[t],'total':tot[t]} for t in sorted(tot,key=lambda x:-tot[x])]).to_csv('analysis/kept_terms_breakdown.csv',index=False)
sens = pd.DataFrame([{'scenario':l,'mean_86':T[c].mean(),'median':T[c].median(),'min':int(T[c].min()),'max':int(T[c].max()),'total':int(T[c].sum())} for l,c in
   [('headline',  'n_variants'),('excl_upstream','n_excl_upstream'),('excl_splice_region','n_excl_splice'),
    ('reference_counted','n_with_reference'),('no_dedup','n_no_dedup')]])
sens.to_csv('analysis/sensitivity.csv', index=False)
print('\nper-sample table head:'); print(T.head(8).to_string())
