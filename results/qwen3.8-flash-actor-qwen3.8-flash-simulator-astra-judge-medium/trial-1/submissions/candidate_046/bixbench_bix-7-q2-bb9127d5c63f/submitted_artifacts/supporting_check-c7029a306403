import pandas as pd, glob, warnings, collections
warnings.filterwarnings('ignore')
# ---- fix status mapping + duplicate diagnostics (carried vs reference) ----
T = pd.read_csv('analysis/chip_variants_per_sample.csv')
ts = pd.read_excel('data/230215_Trio_Status.xlsx')
ts.columns=[str(c).strip() for c in ts.columns]
ts['Sample ID']=ts['Sample ID'].astype(str).str.strip(); ts['Status']=ts['Status'].astype(str).str.strip()
mp=dict(zip(ts['Sample ID'], ts['Status']))
T['numeric_id']=T['sample_id'].str.split('-').str[0]
T['status']=T['numeric_id'].map(mp)
print('status mapping: mapped %d/%d ; unmapped ->'%(T.status.notna().sum(), len(T)), T.loc[T.status.isna(),'sample_id'].tolist())
print('status counts:', T.status.value_counts(dropna=False).to_dict())
print('is_proband recomputed:', int(T.is_proband.sum()), ' == status in Patient/Child:', int(T.status.isin(['Patient','Child']).sum()))

dupz=collections.Counter(); dup_carried=0; multi_all=0; multi_ex=[]
CARRY={'Heterozygous','Homozygous Variant'}
EX={'intron_variant','3_prime_UTR_variant','5_prime_UTR_variant','5_prime_UTR_premature_start_codon_gain_variant'}
for f in sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx')):
    df=pd.read_excel(f, header=[0,1])
    blk=[b for b,s in df.columns if str(b).split(' (')[0] in ('Proband','Child','Mother','Father')][0]
    def c(sub, b=None):
        bb=b if b else 'Variant Info'
        return df[[x for x in df.columns if x[0]==bb and str(x[1]).strip()==sub][0]]
    z=df[[x for x in df.columns if x[0]==blk and str(x[1]).strip()=='Zygosity'][0]].astype('string').str.strip()
    so=df[[x for x in df.columns if str(x[1]).strip()=='Sequence Ontology (Combined)'][0]].astype('string').str.strip()
    key=list(zip(c('Chr:Pos').astype(str).str.strip(), c('Ref/Alt').astype(str).str.strip()))
    d=pd.DataFrame({'key':key,'z':z,'so':so}); dupz.update(d[d.duplicated('key',keep=False)]['z'].fillna('BLANK'))
    car=d[d['z'].isin(CARRY)]
    dup_carried += int(car.duplicated('key').sum())
    pos=d.groupby('key')['key'].size()
    p2=d.drop_duplicates('key').groupby(d.drop_duplicates('key')['key'].str.split(':').str[0]).size()
    # multi-allelic: same Chr:Pos with >1 distinct Ref/Alt (all rows, and carried rows)
    ka=pd.DataFrame({'pos':[k.split(':')[0]+':'+k.split(':')[1] for k in d['key']],'kr':d['key']}).drop_duplicates()
    multi_all += int((ka.groupby('pos').size()>1).sum())
    kc=ka[ka['kr'].isin(set(car['key']))]
    if int((kc.groupby('pos').size()>1).sum()): multi_ex.append(f)
print('\nduplicate (Chr:Pos,Ref/Alt) rows by Zygosity:', dict(dupz), '-> total', sum(dupz.values()))
print('duplicates INSIDE carried rows:', dup_carried, '(explains dedup == no-dedup)')
print('multi-allelic Chr:Pos (distinct Ref/Alt) over ALL rows/86 samples:', multi_all, '| inside carried:', 0 if not multi_ex else multi_ex)
print()
print(T[['sample_id','sample_block','status','is_proband','rows_in_file','n_variants','n_het','n_hom']].head(6).to_string())
T.to_csv('analysis/chip_variants_per_sample.csv', index=False)
n=T['n_variants']
print('\nFINAL: mean=%.4f median=%s min=%d max=%d sd=%.4f total=%d n=%d' % (n.mean(), n.median(), n.min(), n.max(), n.std(ddof=1), n.sum(), len(n)))
print('probands mean=%.4f (n=%d)' % (n[T.is_proband].mean(), T.is_proband.sum()))
print('by status:', T.groupby('status')['n_variants'].agg(['count','mean']).round(3).to_dict('index'))
