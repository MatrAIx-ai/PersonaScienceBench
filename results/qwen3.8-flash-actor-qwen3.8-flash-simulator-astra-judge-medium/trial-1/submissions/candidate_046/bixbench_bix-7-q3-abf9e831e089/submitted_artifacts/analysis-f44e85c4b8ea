#!/usr/bin/env python3
"""
BixBench bix-7-q3: How many CHIP variants remain after removing reference calls?

Locked decisions (researcher-approved):
  1. Scope: union of all 86 files in data/CHIP_DP10_GQ20_PASS/ (no trio subsetting).
  2. CHIP restriction: trust In_CHIP == True; quantify (not apply) the 9 non-list
     overlapping gene symbols as sensitivity.
  3. "Remove reference calls": drop Zygosity == "Reference"; blank Zygosity is a
     no-call (verify it co-occurs with missing DP/GQ/VAF) and is not a remaining variant.
  4. Headline count: distinct genomic variants keyed on (Chr:Pos, Ref/Alt), retained
     if >=1 explicit call (Heterozygous / Homozygous Variant) in >=1 sample.
  5. Sensitivity figures reported separately (blanks-kept keys; sample-level rows;
     union key count before filtering).
  6. Collapse same-key duplicate rows within a file before cross-sample aggregation.

Loader / reproducibility notes:
  - openpyxl engine, load_workbook(read_only=False) REQUIRED: several workbooks
    (e.g. 502-P1) store corrupt sheet-dimension metadata (1x1) so read_only=True /
    dimension-trusting readers return zero data rows.
  - Header handling: sheet row 1 = category block, row 2 = column names, data from
    row 3. With pandas this is header=1 (0-based). Here we use openpyxl row tuples:
    hdr = rows[1], data = rows[2:].
  - Sample ID taken from filename suffix (230209_Exome_GRCh38_CHIP_<ID>.xlsx).
"""
import glob, os, re, collections
import openpyxl

DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
GENE_LIST = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"

CALL = {"Heterozygous", "Homozygous Variant"}
REF = "Reference"

# --- CHIP gene list (Schenz et al. 2022): single column, no header ---
gene_wb = openpyxl.load_workbook(GENE_LIST, data_only=True)
schenz = {r[0].strip() for r in gene_wb.active.iter_rows(values_only=True) if r[0]}
print(f"Schenz CHIP gene list: {len(schenz)} unique symbols")

files = sorted(glob.glob(os.path.join(DATA_DIR, "*.xlsx")))
print(f"CHIP files found: {len(files)}\n")

hdr_expect = None
total_rows = 0
zyg_tally = collections.Counter()
blank_no_dp = blank_with_dp = 0        # blank-Zygosity verification
dup_removed_total = 0                  # rows collapsed within files
key_calls = collections.defaultdict(collections.Counter)  # key -> zygosity counts across samples
key_genes = collections.defaultdict(set)                  # key -> gene symbols seen on its variant-call rows
per_file = []

for f in files:
    sid = re.sub(r"^230209_Exome_GRCh38_CHIP_|\.xlsx$", "", os.path.basename(f))
    wb = openpyxl.load_workbook(f, data_only=True)   # read_only=False: dimension bug
    ws = wb.active
    rows = list(ws.iter_rows(values_only=True))
    hdr = list(rows[1])
    if hdr_expect is None:
        hdr_expect = hdr
        if hdr.count("Zygosity") != 1 or hdr.count("Chr:Pos") != 1:
            raise SystemExit("Unexpected header layout")
    I = {name: i for i, name in enumerate(hdr)}
    ic, ir, iz, idp, igq, ivaf, ifilt, ichip, igen = (
        I["Chr:Pos"], I["Ref/Alt"], I["Zygosity"], I["Read Depths (DP)"],
        I["Genotype Qualities (GQ)"], I["Variant Allele Freq"], I["Filter"],
        I["In_CHIP"], I["Gene Names"])

    raw = [r for r in rows[2:] if r[ic] not in (None, "")]
    # integrity asserts on pre-filters
    assert all(r[ifilt] == "PASS" for r in raw), f"non-PASS in {sid}"
    assert all(str(r[ichip]) == "True" for r in raw), f"In_CHIP!=True in {sid}"

    # decision 6: collapse duplicate keys within file (keep all zygosity evidence)
    seen = {}
    for r in raw:
        k = (r[ic], r[ir])
        if k in seen:
            dup_removed_total += 1
            prev = seen[k]
            prev_zyg, cur_zyg = prev[iz], r[iz]
            # keep the row with an explicit call if duplicates disagree
            if prev_zyg not in CALL and cur_zyg in CALL:
                seen[k] = r
        else:
            seen[k] = r

    n_calls = 0
    for k, r in seen.items():
        z = r[iz]
        zyg_tally[z] += 1
        key_calls[k][z] += 1
        if z in CALL:
            n_calls += 1
            if r[igen]:
                key_genes[k].update(x.strip() for x in str(r[igen]).split(","))
        elif z is None:
            if r[idp] is None and r[igq] is None and r[ivaf] is None:
                blank_no_dp += 1
            else:
                blank_with_dp += 1
    total_rows += len(raw)
    per_file.append((sid, len(raw), len(seen), n_calls, wb.sheetnames[0]))

# --- report: per-file ---
print(f"{'sample':<12}{'rows_raw':>9}{'rows_dedup':>11}{'variant_calls':>14}  sheet")
for sid, nraw, nded, nc, sh in per_file:
    print(f"{sid:<12}{nraw:>9}{nded:>11}{nc:>14}  {sh}")

print("\n--- filter tallies ---")
print(f"total raw data rows (all files): {total_rows}")
print(f"Zygosity tally (after within-file dedup):")
for z, c in zyg_tally.most_common():
    print(f"  {str(z):<20}{c:>7}")
print("Filter column values observed: {'PASS'} (asserted for every row)")
print("In_CHIP column values observed: {'True'} (asserted for every row)")

print("\n--- blank-Zygosity verification (decision 3) ---")
print(f"blank-Zygosity rows with DP/GQ/VAF ALL missing : {blank_no_dp}")
print(f"blank-Zygosity rows with any of DP/GQ/VAF present: {blank_with_dp}")

print("\n--- deduplication (decision 6) ---")
print(f"duplicate same-key rows collapsed within files: {dup_removed_total}")

# --- headline count (decision 4) ---
union_keys = set(key_calls)
keys_any_call = {k for k, c in key_calls.items() if any(z in CALL for z in c)}
keys_blank_only = {k for k, c in key_calls.items() if (None in c) and not any(z in CALL for z in c)}
keys_ref_only = {k for k, c in key_calls.items() if set(c) == {REF}}

print("\n--- gene-list sensitivity (decision 2) ---")
extra_syms = {g for gs in key_genes.values() for g in gs} - schenz
print(f"non-Schenz overlapping symbols on call rows: {sorted(extra_syms)}")
only_extra = {k for k in keys_any_call if key_genes.get(k, set()) and key_genes[k] <= extra_syms}
print(f"distinct variant keys whose call rows carry ONLY non-list symbols: {len(only_extra)}")
print(f"  -> keys retained when those are excluded: {len(keys_any_call - only_extra)}")
print(f"HRAS/NRAS present as catalog rows: "
      f"{any(any(g in schenz and g in {'HRAS','NRAS'} for g in gs) for gs in key_genes.values())}")

print("\n--- results ---")
print(f"(c) union distinct (Chr:Pos,Ref/Alt) keys before filtering : {len(union_keys)}")
print(f"HEADLINE  distinct CHIP variants remaining after removing")
print(f"          reference calls (>=1 Het/Hom call, blanks=no-call): {len(keys_any_call)}")
print("\nsensitivity figures (NOT the answer):")
print(f"  (a) keys if blank-Zygosity-only keys also counted        : {len(keys_any_call | keys_blank_only)}")
het_hom_rows = sum(c for z, c in zyg_tally.items() if z in CALL)
blank_rows = zyg_tally[None]
print(f"  (b1) sample-level call rows, Reference dropped           : {het_hom_rows + blank_rows}"
      f"  (incl. {blank_rows} blank no-call rows)")
print(f"  (b2) sample-level call rows, blanks also dropped         : {het_hom_rows}")
print(f"  keys Reference-only in every sample (removed entirely)   : {len(keys_ref_only)}")
