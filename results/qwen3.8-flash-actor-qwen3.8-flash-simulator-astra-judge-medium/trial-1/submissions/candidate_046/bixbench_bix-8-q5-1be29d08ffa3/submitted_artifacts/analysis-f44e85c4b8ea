"""BixBench bix-8-q5: independence of m6A methylation status vs differential
expression status (bladder cancer MeRIP-seq/mRNA capsule).
Primary: Pearson chi-square on collapsed 2x2 (row-level, N=12,754).
Robustness: (a) Fisher exact 2x2, (b) Pearson 3x3, (c) ENST-collapsed 2x2 Pearson.
Marginal test only; no covariates, no multiple-testing correction. Proteomics excluded.
"""
import pandas as pd
from scipy import stats
import numpy as np

df = pd.read_excel('data/MeRIP_RNA_result.xlsx', sheet_name='Date Formatting')
print("Rows x cols:", df.shape)

# sanity: no NA in labels
assert df[['m6A','DEG']].isna().sum().sum() == 0

# ---- Primary: collapsed 2x2 at row level ----
m6a_bin = np.where(df['m6A'].isin(['m6A Hyper','m6A Hypo']), 'm6A_alt', 'm6A_no_sig')
deg_bin = np.where(df['DEG'].isin(['Up','Down']), 'DEG', 'no_DEG')
ct2 = pd.crosstab(pd.Series(m6a_bin, name='m6A_status'), pd.Series(deg_bin, name='DEG_status'))
ct2 = ct2.reindex(index=['m6A_alt','m6A_no_sig'], columns=['DEG','no_DEG'])
print("\nPrimary 2x2 (rows as in file):\n", ct2.to_string())

# verify against plan counts
expected_plan = {'m6A_alt': {'DEG': 246, 'no_DEG': 945}, 'm6A_no_sig': {'DEG': 717, 'no_DEG': 10846}}
assert (ct2.loc['m6A_alt','DEG'], ct2.loc['m6A_alt','no_DEG'],
        ct2.loc['m6A_no_sig','DEG'], ct2.loc['m6A_no_sig','no_DEG']) == (246, 945, 717, 10846), \
    f"DISCREPANCY vs plan counts: {ct2.values.tolist()}"
print("Counts match plan (246/945/717/10846): OK")

chi2, p, dof, exp = stats.chi2_contingency(ct2.values, correction=False)
print(f"\n[Pearson 2x2] chi2={chi2:.4f}, dof={dof}, N={ct2.values.sum()}, p={p:.2e}")
print("Expected counts:\n", np.round(exp, 2), "\nmin expected =", exp.min())

# ---- (a) Fisher exact on same 2x2 ----
oddsr, p_f = stats.fisher_exact(ct2.values)
print(f"[Fisher 2x2 ] OR={oddsr:.3f}, p={p_f:.2e}")

# ---- (b) Pearson 3x3 full ----
ct3 = pd.crosstab(df['m6A'], df['DEG'])
chi2_3, p3, dof3, exp3 = stats.chi2_contingency(ct3.values, correction=False)
print("\n3x3 table:\n", ct3.to_string())
print(f"[Pearson 3x3] chi2={chi2_3:.4f}, dof={dof3}, N={ct3.values.sum()}, p={p3:.2e}, min expected={exp3.min():.2f}")

# ---- (c) ENST-level collapse: any event => event ----
enst = df.assign(m6a_ev=df['m6A'].isin(['m6A Hyper','m6A Hypo']),
                 deg_ev=df['DEG'].isin(['Up','Down'])).groupby('GeneID').agg(
                     m6a_ev=('m6a_ev','any'), deg_ev=('deg_ev','any'))
print("\nUnique ENST units:", len(enst))
ct_enst = pd.crosstab(np.where(enst.m6a_ev,'m6A_alt','m6A_no_sig'),
                      np.where(enst.deg_ev,'DEG','no_DEG'))
ct_enst = ct_enst.reindex(index=['m6A_alt','m6A_no_sig'], columns=['DEG','no_DEG']).fillna(0).astype(int)
print("ENST 2x2:\n", ct_enst.to_string())
chi2_e, pe, dofe, expe = stats.chi2_contingency(ct_enst.values, correction=False)
print(f"[Pearson ENST] chi2={chi2_e:.4f}, dof={dofe}, N={ct_enst.values.sum()}, p={pe:.2e}, min expected={expe.min():.2f}")

# ---- decision consistency ----
alpha = 0.05
results = {'Pearson 2x2 (primary)': p, 'Fisher 2x2': p_f, 'Pearson 3x3': p3, 'Pearson ENST 2x2': pe}
print("\n=== SUMMARY (alpha=0.05) ===")
for k, v in results.items():
    print(f"{k:24s} p={v:.2e} -> {'reject independence' if v < alpha else 'do not reject'}")
print("\nFINAL ANSWER (primary Pearson 2x2): p = %.2e" % p)
