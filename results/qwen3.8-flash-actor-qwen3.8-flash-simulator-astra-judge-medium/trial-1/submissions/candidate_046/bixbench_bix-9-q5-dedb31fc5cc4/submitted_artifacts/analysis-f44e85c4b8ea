#!/usr/bin/env python3
"""
BixBench bix-9-q5 : In which tissue do bad responders show the highest number of
significantly differentially expressed genes (|lfc|>0.5, baseMean>10, padj<0.05) vs controls?

Primary  : DESeq2 result blocks already embedded in the workbook (sheet NormCount).
ReplicA  : limma-style moderated t-test on log2(NormCount+1) with BH-FDR (pure Python).
ReplicB  : NB2 GLM (vectorised IRLS) on pseudo-counts (time-boxed, non-blocking).
No threshold was tuned to obtain a preferred result.
"""
import time, json, csv
import numpy as np
import openpyxl
from scipy import stats
from scipy.special import polygamma
from statsmodels.stats.multitest import multipletests

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
OUT_CSV = "work/deg_counts_by_tissue.csv"
OUT_JSON = "work/deg_report.json"
T0 = time.time()
def log(*a): print("[%6.1fs]" % (time.time() - T0), *a, flush=True)

log("reading workbook ...")
wb = openpyxl.load_workbook(XLSX, read_only=True, data_only=True)
ws = wb["NormCount"]
rows = list(ws.iter_rows(min_row=4, values_only=True))      # sheet row 4 = real column names
hdr, data = rows[0], rows[1:]
def f(v):
    try: return float(v)
    except Exception: return np.nan
genes = np.array([r[1] for r in data], dtype=object)
SAMPLE_COLS = list(range(2, 92))                            # 0-based cols of the 90 samples
samples = [hdr[i] for i in SAMPLE_COLS]
M = np.array([[f(r[i]) for i in SAMPLE_COLS] for r in data], dtype=np.float64)
log("NormCount matrix: %d genes x %d samples (continuous normalised counts)" % M.shape)

GROUPS = ["Control", "good_responder", "bad_responder"]
TISSUES = ["baseline_blood", "dentate_gyrus", "final_blood"]
cell_idx = {(g, t): [j for j, s in enumerate(samples) if s.startswith(g + "_" + t)]
            for t in TISSUES for g in GROUPS}
assert all(len(v) == 10 for v in cell_idx.values()), "unbalanced design"
gmean = {k: M[:, v].mean(axis=1) for k, v in cell_idx.items()}

FIELDS = ["baseMean", "baseMeanA", "baseMeanB", "foldChange", "log2FoldChange", "pval", "padj"]
blocks = {}
for k in range(9):
    c = 98 + 9 * k
    arr = np.array([[f(r[c + i]) for i in range(7)] for r in data], dtype=np.float64)
    b = dict(zip(FIELDS, arr.T))
    b["DEG_max"] = np.array([str(r[c + 7]) for r in data])
    b["DEG_median"] = np.array([str(r[c + 8]) for r in data])
    blocks[k + 1] = b
log("extracted %d embedded DESeq2 comparison blocks (sheet cols 99-179)" % len(blocks))
BAD_VS_CTRL = {"baseline_blood": 2, "dentate_gyrus": 5, "final_blood": 8}

log("verifying block <-> (tissue, contrast) assignment ...")
verif = {}
for k, b in blocks.items():
    keep = np.isfinite(b["log2FoldChange"]) & (b["baseMean"] > 10)
    cand = []
    for t in TISSUES:
        for a in GROUPS:
            for bb in GROUPS:
                if a == bb: continue
                pred = np.log2((gmean[(bb, t)] + 1) / (gmean[(a, t)] + 1))
                m = keep & np.isfinite(pred)
                rho = stats.spearmanr(b["log2FoldChange"][m], pred[m]).statistic
                conc = float(np.mean(np.sign(b["log2FoldChange"][m]) == np.sign(pred[m])))
                cand.append((rho, conc, t, a, bb))
    cand.sort(reverse=True)
    verif[k] = cand
for k in sorted(verif):
    rho, conc, t, a, bb = verif[k][0]; s = verif[k][1]
    log("  comp %d -> %s : %s vs %s (rho=%.3f signconc=%.3f) | runner-up rho=%.3f (%s %s vs %s)"
        % (k, t, a, bb, rho, conc, s[0], s[2], s[3], s[4]))

log("directional check on comp 5 (dentate_gyrus): is baseMeanA ~ Control and baseMeanB ~ bad_responder?")
b5 = blocks[5]; A, B = b5["baseMeanA"], b5["baseMeanB"]
C = gmean[("Control", "dentate_gyrus")]; Bd = gmean[("bad_responder", "dentate_gyrus")]
mask = (b5["baseMean"] > 10) & np.isfinite(b5["log2FoldChange"]) & (np.abs(b5["log2FoldChange"]) > 0.5) \
       & np.isfinite(A) & np.isfinite(B) & (A > 0) & (B > 0)
obs_lfc = b5["log2FoldChange"][mask]
data_lfc_bad_up = np.log2((Bd[mask] + 1) / (C[mask] + 1))
conc_AB = float(np.mean(np.sign(obs_lfc) == np.sign(data_lfc_bad_up)))
mA = float(np.median(np.log2(A[mask] / (C[mask] + 1))))
mB = float(np.median(np.log2(B[mask] / (Bd[mask] + 1))))
mA_sw = float(np.median(np.log2(A[mask] / (Bd[mask] + 1))))
mB_sw = float(np.median(np.log2(B[mask] / (C[mask] + 1))))
d5 = dict(n_genes_tested=int(mask.sum()),
          rho_A_vs_ControlDG=float(stats.spearmanr(A[mask], C[mask]).statistic),
          rho_B_vs_ControlDG=float(stats.spearmanr(B[mask], C[mask]).statistic),
          rho_A_vs_badDG=float(stats.spearmanr(A[mask], Bd[mask]).statistic),
          rho_B_vs_badDG=float(stats.spearmanr(B[mask], Bd[mask]).statistic),
          sign_conc_log2B_over_A_vs_bad_over_ctrl=conc_AB,
          scale_const_if_A_Ctrl_B_bad=[round(mA, 3), round(mB, 3), round(abs(mA - mB), 3)],
          scale_const_if_A_bad_B_Ctrl=[round(mA_sw, 3), round(mB_sw, 3), round(abs(mA_sw - mB_sw), 3)])
log("  comp5: %s" % json.dumps(d5))
assert conc_AB > 0.9, "comp5 A/B direction not confirmed"

scale = {}
for t, k in BAD_VS_CTRL.items():
    b = blocks[k]
    m = (b["baseMean"] > 10) & np.isfinite(b["baseMean"])
    mm = 0.5 * gmean[("Control", t)][m] + 0.5 * gmean[("bad_responder", t)][m]
    scale[t] = round(float(2 ** np.median(np.log2(b["baseMean"][m] / (mm + 1)))), 3)
log("baseMean scale offset vs NormCount group means (per tissue, not corrected): %s" % scale)

def count(b, lfc_cut=0.5, padj_cut=0.05, bm_cut=10.0, mode="abs"):
    lfc, bm, padj = b["log2FoldChange"], b["baseMean"], b["padj"]
    ok = np.isfinite(lfc) & np.isfinite(padj) & (bm > bm_cut) & (padj < padj_cut)
    up = ok & (lfc > lfc_cut); dn = ok & (lfc < -lfc_cut)
    if mode == "abs": return int(up.sum() + dn.sum()), int(up.sum()), int(dn.sum())
    return int(up.sum()), int(up.sum()), 0

log("MAIN criterion: |log2FoldChange|>0.5 AND baseMean>10 AND padj<0.05 (bad_responder vs Control)")
main_rows = []
for t in TISSUES:
    k = BAD_VS_CTRL[t]; b = blocks[k]
    tot, up, dn = count(b); up_lit, _, _ = count(b, mode="up")
    main_rows.append(dict(tissue=t, comparison=k,
        sheet_columns="cols %d-%d (baseMean, baseMeanA, baseMeanB, foldChange, log2FoldChange, pval, padj, DEG_Max, DEG_Median)"
                      % (98 + 9 * (k - 1) + 1, 98 + 9 * (k - 1) + 9),
        DEG_total=tot, DEG_up=up, DEG_down=dn, DEG_up_literal_only=up_lit,
        book_DEG_flag_U=int((b["DEG_median"] == "U").sum()),
        book_DEG_flag_D=int((b["DEG_median"] == "D").sum()),
        n_genes_padj_lt_005_any_lfc=int(np.nansum(np.isfinite(b["padj"]) & (b["padj"] < 0.05)))))
main_rows.sort(key=lambda r: -r["DEG_total"])
for r in main_rows:
    log("  %-15s comp%d DEG=%4d (up=%4d, down=%4d; literal up-only=%4d) [book DEG flags U=%d D=%d, padj<.05 any lfc=%d]"
        % (r["tissue"], r["comparison"], r["DEG_total"], r["DEG_up"], r["DEG_down"],
           r["DEG_up_literal_only"], r["book_DEG_flag_U"], r["book_DEG_flag_D"], r["n_genes_padj_lt_005_any_lfc"]))

log("sensitivity grid ...")
variants = [("baseMean>10 only (no lfc, no padj)", 0.0, 1.01, "abs", 10),
            ("|lfc|>0.5 & baseMean>10 (no padj)", 0.5, 1.01, "abs", 10),
            ("lfc>0.5 & baseMean>10 (LITERAL up only, no padj)", 0.5, 1.01, "up", 10),
            ("|lfc|>0.5 & baseMean>10 & padj<0.10", 0.5, 0.10, "abs", 10),
            ("|lfc|>0.5 & baseMean>10 & padj<0.05  [PRIMARY]", 0.5, 0.05, "abs", 10),
            ("lfc>0.5 & baseMean>10 & padj<0.05 (LITERAL up only)", 0.5, 0.05, "up", 10),
            ("|lfc|>0.5 & baseMean>10 & padj<0.01", 0.5, 0.01, "abs", 10),
            ("|lfc|>0.585 (1.5-fold) & baseMean>10 & padj<0.05", 0.585, 0.05, "abs", 10),
            ("padj<0.05 only (no lfc / no baseMean filter)", 0.0, 0.05, "abs", 0)]
sens = []
for name, L, P, mode, BM in variants:
    vals = {}
    for t in TISSUES:
        b = blocks[BAD_VS_CTRL[t]]
        lfc, bm, padj = b["log2FoldChange"], b["baseMean"], b["padj"]
        ok = np.isfinite(lfc) & np.isfinite(padj) & (bm > BM) & (padj < P)
        vals[t] = int((ok & (lfc > L)).sum()) if mode == "up" else int((ok & (np.abs(lfc) > L)).sum())
    w = max(vals, key=vals.get); sens.append(dict(criterion=name, **vals, winner=w))
    log("  %-52s bl=%5d dg=%5d fb=%5d -> %s" % (name, vals["baseline_blood"], vals["dentate_gyrus"], vals["final_blood"], w))

# ---------------------------------------------------------------------------
# REPLICAS (corroborate the tissue RANKING only; they cannot reproduce DESeq2
# counts because raw counts, DESeq2 dispersion shrinkage over the 90-sample run
# and the authors' outlier exclusion are not available here).
# ---------------------------------------------------------------------------
log("REPLICA A: limma-style moderated t on log2(NormCount+1), BH-FDR")
def squeeze(s2, sel):
    """Prior (d0, s0^2) for the residual variance, method of moments on log s^2
    over expressed genes:  var(log s^2) ~ trigamma(d0/2)."""
    ls = np.log(s2[sel]); s0sq = float(np.exp(np.median(ls)))
    q1, q3 = np.percentile(ls, [25, 75]); vrob = ((q3 - q1) / 1.349) ** 2
    out = []
    for v in (float(np.var(ls, ddof=1)), vrob):
        lo, hi = 1e-3, 1e6
        for _ in range(150):
            mid = np.sqrt(lo * hi)
            if polygamma(1, mid / 2) > v: lo = mid
            else: hi = mid
        out.append(2 * np.sqrt(lo * hi))
    return s0sq, out[1]
repA = {}
for t in TISSUES:
    iC = np.array(cell_idx[("Control", t)]); iB = np.array(cell_idx[("bad_responder", t)])
    cc = np.concatenate([iC, iB]); bm = M[:, cc].mean(1)
    Xl = np.log2(M[:, cc] + 1.0)
    m1, m2 = Xl[:, :10].mean(1), Xl[:, 10:].mean(1); coef = m2 - m1
    rss = ((Xl[:, :10] - m1[:, None]) ** 2).sum(1) + ((Xl[:, 10:] - m2[:, None]) ** 2).sum(1)
    s2 = np.maximum(rss / 18.0, 1e-12)
    s0sq, d0 = squeeze(s2, (bm > 10) & (s2 > 1e-6))
    s2p = (d0 * s0sq + 18.0 * s2) / (d0 + 18.0)
    p = 2 * stats.t.sf(np.abs(coef / np.sqrt(s2p * 0.2)), d0 + 18.0)
    padj = np.ones_like(p); okf = np.isfinite(p); padj[okf] = multipletests(p[okf], method="fdr_bh")[1]
    cand = (bm > 10) & (np.abs(coef) > 0.5)
    repA[t] = dict(DEG_FDR05=int((cand & (padj < 0.05)).sum()), up_FDR05=int((cand & (padj < 0.05) & (coef > 0)).sum()),
                   down_FDR05=int((cand & (padj < 0.05) & (coef < 0)).sum()),
                   DEG_p01=int((cand & (p < 0.01)).sum()), up_p01=int((cand & (p < 0.01) & (coef > 0)).sum()),
                   down_p01=int((cand & (p < 0.01) & (coef < 0)).sum()),
                   DEG_p001=int((cand & (p < 0.001)).sum()), df_prior=round(float(d0), 1),
                   s0=round(float(np.sqrt(s0sq)), 3))
    log("  %-15s FDR<0.05: %3d (up %3d/down %3d) | p<0.01: %4d (up %4d/down %3d) | p<0.001: %4d  [d0=%.1f s0=%.2f]"
        % (t, repA[t]["DEG_FDR05"], repA[t]["up_FDR05"], repA[t]["down_FDR05"], repA[t]["DEG_p01"],
           repA[t]["up_p01"], repA[t]["down_p01"], repA[t]["DEG_p001"], repA[t]["df_prior"], repA[t]["s0"]))
rankA = " > ".join(sorted(repA, key=lambda x: -repA[x]["DEG_p01"]))
log("  replica A ranking (p<0.01 cut; FDR<0.05 is underpowered here): %s" % rankA)

log("REPLICA B: NB2 GLM, log link, closed-form group MLE + common dispersion (fast, no IRLS)")
repB = {}
try:
    import pandas as pd
    ms = pd.read_excel(XLSX, sheet_name="Mapping_statistics")
    c2lib = dict(zip(ms["Code"].values, (ms["total read"] * ms["mapping rate"] / 100.0).values))
    for t in TISSUES:
        cc = np.concatenate([np.array(cell_idx[("Control", t)]), np.array(cell_idx[("bad_responder", t)])])
        sf = np.array([c2lib[samples[j]] for j in cc], dtype=float); sf /= sf.mean()
        Y = np.rint(np.nan_to_num(M[:, cc], nan=0.0) * sf[None, :])
        Y = Y[Y.max(1) > 0]; off = np.log(sf)[None, :]
        mu0 = Y.mean(1) + 0.5
        phi = float(np.median(np.maximum(((Y - mu0[:, None]) ** 2 / mu0[:, None]).mean(1) - 1.0 / mu0[:, None], 1e-4)))
        sy1, sy2 = Y[:, :10].sum(1), Y[:, 10:].sum(1)
        se1, se2 = np.exp(off[:, :10]).sum(1), np.exp(off[:, 10:]).sum(1)
        b1 = np.log(np.maximum(sy1, 0.5) / se1); b2 = np.log(np.maximum(sy2, 0.5) / se2)
        muA = np.exp(b1[:, None] + off[:, :10]); muB = np.exp(b2[:, None] + off[:, 10:])
        vA = (muA + phi * muA ** 2).sum(1) / np.maximum(muA.sum(1), 1e-9) ** 2
        vB = (muB + phi * muB ** 2).sum(1) / np.maximum(muB.sum(1), 1e-9) ** 2
        z = (b2 - b1) / np.sqrt(np.maximum(vA + vB, 1e-18))
        p = 2 * stats.norm.sf(np.abs(np.nan_to_num(z)))
        padj = multipletests(p, method="fdr_bh")[1]
        lfc, bm = b2 - b1, Y.mean(1)
        cand = (bm > 10) & (np.abs(lfc) > 0.5)
        repB[t] = dict(DEG_FDR05=int((cand & (padj < 0.05)).sum()), up_FDR05=int((cand & (padj < 0.05) & (lfc > 0)).sum()),
                       down_FDR05=int((cand & (padj < 0.05) & (lfc < 0)).sum()), DEG_p01=int((cand & (p < 0.01)).sum()),
                       common_dispersion=round(phi, 3), n_genes=int(Y.shape[0]))
        log("  %-15s FDR<0.05: %3d (up %3d/down %3d) | p<0.01: %4d   [phi=%.2f, %d genes]"
            % (t, repB[t]["DEG_FDR05"], repB[t]["up_FDR05"], repB[t]["down_FDR05"], repB[t]["DEG_p01"],
               repB[t]["common_dispersion"], repB[t]["n_genes"]))
    rankB = " > ".join(sorted(repB, key=lambda x: -repB[x]["DEG_p01"]))
    log("  replica B ranking (p<0.01 cut): %s" % rankB)
except Exception as exc:
    log("  replica B SKIPPED (non-blocking): %r" % exc)

# internal-consistency density from the book's own pvalues (extra corroboration)
dens = {}
for t in TISSUES:
    b = blocks[BAD_VS_CTRL[t]]
    m = (b["baseMean"] > 10) & np.isfinite(b["pval"])
    dens[t] = dict(n_expressed=int(m.sum()), frac_p_lt_001=round(float(np.mean(b["pval"][m] < 0.01)), 4))
log("book p-value density among baseMean>10: %s" % dens)

with open(OUT_CSV, "w", newline="") as fh:
    w = csv.DictWriter(fh, fieldnames=list(main_rows[0].keys())); w.writeheader(); [w.writerow(r) for r in main_rows]
json.dump(dict(primary_criterion="|log2FoldChange|>0.5 & baseMean>10 & padj<0.05", main=main_rows,
               sensitivity=sens, replicaA_limma_like=repA, replicaB_nb2_glm=repB, book_pval_density=dens,
               comp5_direction_check=d5,
               block_assignment_top1={str(k): [verif[k][0][2], verif[k][0][3], verif[k][0][4],
                                               round(float(verif[k][0][0]), 3)] for k in verif},
               baseMean_scale_offset_vs_normcount=scale),
          open(OUT_JSON, "w"), indent=1, default=str)
log("wrote %s and %s" % (OUT_CSV, OUT_JSON))
log("ANSWER: %s (DEG=%d) > %s (%d) > %s (%d)"
    % (main_rows[0]["tissue"], main_rows[0]["DEG_total"], main_rows[1]["tissue"],
       main_rows[1]["DEG_total"], main_rows[2]["tissue"], main_rows[2]["DEG_total"]))
