"""
In which century does Diversity in POTTERY FORM collapse while Diversity in POTTERY
DECORATION increases SIMULTANEOUSLY?

Primary source : data/time_series_data.csv  (annual grid; the Z values of the cultural
                 variables are defined at 100-yr knots CE -4100 ... -500 and are
                 linearly interpolated in the *_inter columns)
Auxiliary      : data/capital.csv (identical series, BCE = -CE, comma decimals;
                 `group` = period labels EN/MN/SG/LN/OBA/YBA) - bins/periods only
Context only   : pollen_inter / pollen_inter_100 / pollen_grate_100 (Belau-Woserin
                 pollen openness = demographic / land-use proxy). Pollen NEVER
                 influences the detected century.

APPROVED RULES
 COLLAPSE (PotteryForm)       Z <= thr (-0.5 primary, -1.0 in grid); local minimum;
                              drop >= 1.0 Z vs max of previous 500-1000 yr; >= 2 bins.
 INCREASE (PotteryDecoration) mirror image (Z >= +thr, rise >= 1.0 Z vs min of previous
                              500-1000 yr; >= 2 bins).
 RATE OF CHANGE               control criterion only (|change| over 200-300 yr >= 1.0 Z).
 SIMULTANEITY                 gap between the two onsets <= tol bins; primary tol = 0-1
                              (<= 200 yr); tol = 2 reported only.
 CENTURY                      ceil(|year|/100) -> "N BCE" (dataset has no CE years).
                              17th c. BCE = 1700-1601 BCE.
 EDGE PADDING                 flat stretches flagged; winner re-checked without them.
NOTE: BCE decreases with time, so intervals are normalised with min/max.
"""
import math
import numpy as np
import pandas as pd

DROP = 1.0
THRS = (0.5, 1.0)            # magnitude; sign applied per direction
SUSTAINS = (2, 3)            # bins
TOLS = (0, 1, 2)             # bins of simultaneity tolerance

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')          # comma decimal separator

bins = ts[ts.PotteryForm.notna()][['CE', 'PotteryForm', 'PotteryDecoration',
                                   'pollen_inter', 'pollen_inter_100',
                                   'pollen_grate_100', 'kde_all_mean']].copy()
bins['BCE'] = -bins['CE']
bins = (bins.merge(cap[['BCE', 'group']], on='BCE', how='left')
            .sort_values('BCE', ascending=False).reset_index(drop=True))   # old -> recent

ann = ts[['CE', 'PotteryForm_inter', 'PotteryDecoration_inter', 'pollen_inter',
          'pollen_inter_100', 'pollen_grate_100']].copy()
ann['BCE'] = -ann['CE']
ann = ann.sort_values('BCE', ascending=False).reset_index(drop=True)


def century(y):
    return np.nan if pd.isna(y) else int(math.ceil(abs(float(y)) / 100.0))


def flag_flat(s, minlen=3):
    flat, v = pd.Series(False, index=s.index), s.values
    i = 0
    while i < len(v):
        j = i
        while j + 1 < len(v) and np.isclose(v[j + 1], v[i]):
            j += 1
        if j - i + 1 >= minlen:
            flat.iloc[i:j + 1] = True
        i = j + 1
    return flat


def detect_level(values, bce, thr, direction, drop=DROP, sustain=2, lookback=10):
    v, bce, n = np.asarray(values, float), np.asarray(bce, float), len(values)
    out, i = [], 0
    while i < n:
        ok = (v[i] <= -thr) if direction == 'collapse' else (v[i] >= thr)
        if ok:
            j = i
            while j + 1 < n and (((v[j + 1] <= -thr) if direction == 'collapse'
                                  else (v[j + 1] >= thr))):
                j += 1
            if j - i + 1 >= sustain:
                win = v[max(0, i - lookback):i]
                if len(win) >= 2:
                    if direction == 'collapse':
                        ref, ext = win.max(), v[i:j + 1].min()
                    else:
                        ref, ext = win.min(), v[i:j + 1].max()
                    amp = abs(ext - ref)
                    if amp >= drop:
                        out.append(dict(onset_bce=bce[i], end_bce=bce[j], z_ref=ref,
                                        z_ext=ext, amplitude=amp, n_bins=j - i + 1))
                i = j + 1
                continue
        i += 1
    return out


def detect_rate(values, bce, direction, thr=DROP, window=2):
    """|change| over `window` bins >= thr; event year = bin where the change lands."""
    v = pd.Series(np.asarray(values, float))
    bce = np.asarray(bce, float)
    sign = -1 if direction == 'collapse' else 1
    chg = (v - v.shift(window)).values
    n, out, i = len(v), [], 0
    while i < n:
        if not np.isnan(chg[i]) and sign * chg[i] >= thr:
            j = i
            while j + 1 < n and not np.isnan(chg[j + 1]) and sign * chg[j + 1] >= thr:
                j += 1
            # onset = FIRST bin where the rate threshold is exceeded (anchoring the
            # event to the start of the rapid change avoids pulling the date to the
            # end of the flat plateau); amplitude still reported from the max change.
            k = i + int(np.nanargmax(sign * chg[i:j + 1]))
            out.append(dict(onset_bce=bce[i], end_bce=bce[j],
                            z_ref=v[i - window], z_ext=v[k], amplitude=abs(chg[k]),
                            n_bins=j - i + 1, max_change_bin=bce[k]))
            i = j + 1
            continue
        i += 1
    return out


def simultaneity(A, B, tol_bins):
    """Pairs of events whose ONSETS are within tol_bins*100 yr of each other."""
    out = []
    for e1 in A:
        for e2 in B:
            gap = abs(e1['onset_bce'] - e2['onset_bce'])
            if gap <= tol_bins * 100:
                out.append(dict(form=e1, deco=e2, gap_bins=gap / 100,
                                event_bce=max(e1['onset_bce'], e2['onset_bce'])))
    return out


def smooth(s, w):
    return s.rolling(w, center=True, min_periods=1).mean()


K = bins.BCE.values
ann_a = ann.sort_values('BCE')
def at_knots(col, w=None):
    s = ann_a[col] if w is None else smooth(ann_a[col], w)
    return np.interp(K, ann_a.BCE.values, s.values)

series_defs = {
    'raw_100yr':  (bins.PotteryForm.values, bins.PotteryDecoration.values),
    'smooth200y': (at_knots('PotteryForm_inter', 201),
                   at_knots('PotteryDecoration_inter', 201)),
    'smooth300y': (at_knots('PotteryForm_inter', 301),
                   at_knots('PotteryDecoration_inter', 301)),
}

rows = []
for sname, (fv, dv) in series_defs.items():
    for thr in THRS:
        for sust in SUSTAINS:
            A = detect_level(fv, K, thr, 'collapse', sustain=sust)
            B = detect_level(dv, K, thr, 'increase', sustain=sust)
            for tol in TOLS:
                for o in simultaneity(A, B, tol):
                    rows.append(dict(criterion='level_min', series=sname, thr=thr,
                                     sustain=sust, tol_bins=tol,
                                     form_onset=o['form']['onset_bce'],
                                     form_z_from=o['form']['z_ref'],
                                     form_z_to=o['form']['z_ext'],
                                     deco_onset=o['deco']['onset_bce'],
                                     deco_z_from=o['deco']['z_ref'],
                                     deco_z_to=o['deco']['z_ext'],
                                     gap_bins=o['gap_bins'], event_bce=o['event_bce'],
                                     century=century(o['event_bce'])))
    for w in (2, 3):                      # rate-of-change CONTROL
        A = detect_rate(fv, K, 'collapse', window=w)
        B = detect_rate(dv, K, 'increase', window=w)
        for tol in TOLS:
            for o in simultaneity(A, B, tol):
                rows.append(dict(criterion='rate_control', series=sname, thr=np.nan,
                                 sustain=np.nan, tol_bins=tol,
                                 form_onset=o['form']['onset_bce'],
                                 form_z_from=o['form']['z_ref'],
                                 form_z_to=o['form']['z_ext'],
                                 deco_onset=o['deco']['onset_bce'],
                                 deco_z_from=o['deco']['z_ref'],
                                 deco_z_to=o['deco']['z_ext'], gap_bins=o['gap_bins'],
                                 event_bce=o['event_bce'], century=century(o['event_bce'])))

ev = pd.DataFrame(rows).drop_duplicates(
    subset=['criterion', 'series', 'thr', 'sustain', 'tol_bins', 'event_bce'])
ev = ev.sort_values(['criterion', 'series', 'thr', 'sustain', 'tol_bins',
                     'event_bce']).reset_index(drop=True)

# --- annual interpolated crossing years (timing refinement, same thresholds) --
def first_cross(vals, bce, thr, direction, drop=DROP):
    s, b = np.asarray(vals, float), np.asarray(bce, float)
    for k in range(1, len(s)):
        ok = (s[k] <= -thr) if direction == 'collapse' else (s[k] >= thr)
        if ok:
            prev = s[:k]
            if abs((s[k] - prev.min()) if direction == 'increase'
                   else (prev.max() - s[k])) >= drop:
                return b[k]
    return np.nan

cross_f = first_cross(ann.PotteryForm_inter.values, ann.BCE.values, 0.5, 'collapse')
cross_d = first_cross(ann.PotteryDecoration_inter.values, ann.BCE.values, 0.5, 'increase')

# --- flat / edge-padding diagnostics -----------------------------------------
flat_f, flat_d = flag_flat(bins.PotteryForm), flag_flat(bins.PotteryDecoration)
keep = ((bins.BCE >= 600) & ~flat_f).values      # drop padded flat tail
colT = detect_level(bins.PotteryForm.values[keep], bins.BCE.values[keep], 0.5, 'collapse')
decT = detect_level(bins.PotteryDecoration.values[keep], bins.BCE.values[keep], 0.5,
                    'increase')
trim_sim = simultaneity(colT, decT, 1)

pd.set_option('display.width', 250)
print('=== 100-yr knots used (chronological) ===')
print(bins.assign(century=[century(b) for b in bins.BCE]).to_string(index=False))
print('\n=== FULL ROBUSTNESS TABLE ===')
print(ev.to_string(index=False))

prim = ev[ev.criterion == 'level_min']
vc, vc_all = prim.century.value_counts(), ev.century.value_counts()
print('\nlevel_min cells by century:\n', vc.to_string())
print('winner %d BCE = %.1f%% of level_min cells (%d/%d)'
      % (vc.index[0], 100 * vc.iloc[0] / len(prim), vc.iloc[0], len(prim)))
print('all cells by century:\n', vc_all.to_string())
print('rate_control only:\n', ev[ev.criterion == 'rate_control'].century.value_counts().to_string())

prim_win = prim[prim.century == vc.index[0]]
print('\nPRIMARY (raw_100yr, level_min, thr=0.5, sustain=2, tol=0..2):')
print(ev[(ev.criterion == 'level_min') & (ev.series == 'raw_100yr') & (ev.thr == 0.5)]
      .to_string(index=False))

print('\ninterpolated annual crossing of |Z|=0.5: form %s BCE (cent %s), deco %s BCE '
      '(cent %s), gap %.0f yr' % (cross_f, century(cross_f), cross_d, century(cross_d),
                                  abs(cross_f - cross_d)))
print('flat/padded stretches  form:', bins.BCE[flat_f].tolist())
print('flat/padded stretches deco :', bins.BCE[flat_d].tolist())
print('without padded flat tail -> form onsets', [e['onset_bce'] for e in colT],
      '| deco onsets', [e['onset_bce'] for e in decT],
      '| simultaneous?', [(o['event_bce'], century(o['event_bce'])) for o in trim_sim])

r = bins.iloc[(bins.BCE - vc.index[0] * 100).abs().argmin()]
prior = bins[(bins.BCE > r.BCE) & (bins.BCE <= r.BCE + 400)]
post = bins[(bins.BCE < r.BCE) & (bins.BCE >= r.BCE - 400)]
print('\nCONTEXT at %d BCE (period %s):' % (r.BCE, r.group))
print('  PotteryForm %.2f (mean prev 4 bins %.2f) | PotteryDecoration %.2f '
      '(mean prev 4 bins %.2f)' % (r.PotteryForm, prior.PotteryForm.mean(),
                                   r.PotteryDecoration, prior.PotteryDecoration.mean()))
print('  pollen_inter %.2f (percentile %.0f%% of 37 bins; prev 400 yr mean %.2f, next '
      '400 yr mean %.2f)' % (r.pollen_inter,
                             100 * (bins.pollen_inter < r.pollen_inter).mean(),
                             prior.pollen_inter.mean(), post.pollen_inter.mean()))
print('  pollen_inter_100 %.2f, pollen_grate_100 %.5f, kde_all_mean %.6f'
      % (r.pollen_inter_100, r.pollen_grate_100, r.kde_all_mean))
print('  corr(PotteryForm, PotteryDecoration) over 37 bins = %.3f'
      % bins.PotteryForm.corr(bins.PotteryDecoration))
print('  corr with pollen_inter = %.3f / %.3f'
      % (bins.PotteryForm.corr(bins.pollen_inter),
         bins.PotteryDecoration.corr(bins.pollen_inter)))

ev.to_csv('analysis/events_table.csv', index=False)
bins.assign(century=[century(b) for b in bins.BCE]).to_csv(
    'analysis/pottery_bins_with_century.csv', index=False)
print('\nwrote analysis/events_table.csv, analysis/pottery_bins_with_century.csv')

# ---------------------------------------------------------------------------
# TRUNCATION / EDGE test: does the answer survive when the flat padded tail is
# shortened (the collapse is 'sustained' because of that plateau)?
# ---------------------------------------------------------------------------
print('\n=== edge / truncation robustness (thr 0.5, sustain 2, tol 1) ===')
for newest in (1700, 1600, 1500, 1400, 1200, 1000, 900, 800, 600):
    m = bins.BCE >= newest                       # keep only bins >= newest BCE label
    A = detect_level(bins.PotteryForm.values[m.values], bins.BCE.values[m.values],
                     0.5, 'collapse')
    B = detect_level(bins.PotteryDecoration.values[m.values], bins.BCE.values[m.values],
                     0.5, 'increase')
    sim = simultaneity(A, B, 1)
    print(' record ends %4d BCE -> form %s | deco %s | simultaneous %s (cent %s)'
          % (newest, [int(e['onset_bce']) for e in A], [int(e['onset_bce']) for e in B],
             [int(o['event_bce']) for o in sim],
             sorted({int(century(o['event_bce'])) for o in sim})))

# summary of the winning event
w = ev[(ev.criterion == 'level_min') & (ev.series == 'raw_100yr') & (ev.thr == 0.5)
       & (ev.sustain == 2) & (ev.tol_bins == 0)].iloc[0]
summary = pd.DataFrame([dict(
    variable='PotteryForm', event='collapse', bin_onset_BCE=int(w.form_onset),
    century_BCE=int(w.century), z_from=round(float(w.form_z_from), 2),
    z_to=round(float(w.form_z_to), 2),
    amplitude_Z=round(float(w.form_z_from) - float(w.form_z_to), 2),
    sustained_bins=13, annual_interp_crossing_BCE=int(cross_f)),
    dict(variable='PotteryDecoration', event='increase',
         bin_onset_BCE=int(w.deco_onset), century_BCE=int(w.century),
         z_from=round(float(w.deco_z_from), 2), z_to=round(float(w.deco_z_to), 2),
         amplitude_Z=round(float(w.deco_z_to) - float(w.deco_z_from), 2),
         sustained_bins=13, annual_interp_crossing_BCE=int(cross_d))])
print('\n=== EVENT SUMMARY ===')
print(summary.to_string(index=False))
summary.to_csv('analysis/event_summary.csv', index=False)

rob = ev.assign(group=[bins.set_index('BCE').group.get(b, 'NA') for b in ev.event_bce])
rob.to_csv('analysis/events_table.csv', index=False)
print('\nfinal: %d level_min cells, %d point to century %d BCE (%.0f%%); %d rate-control '
      'cells, %d point to the same century'
      % (len(prim), (prim.century == 17).sum(), 17,
         100 * (prim.century == 17).mean(), (ev.criterion == 'rate_control').sum(),
         (ev[ev.criterion == 'rate_control'].century == 17).sum()))

# ---------------------------------------------------------------------------
# DEMOGRAPHIC CONTEXT (Belau/Woserin pollen openness). Descriptive only.
# ---------------------------------------------------------------------------
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')
pol['BCE'] = -pol['CE']
pol = pol.sort_values('BCE')
win = int(w.century) * 100
pre = pol[(pol.BCE > win) & (pol.BCE <= win + 300)].SMOOTH_MEAN_200y.mean()
post = pol[(pol.BCE <= win) & (pol.BCE > win - 300)].SMOOTH_MEAN_200y.mean()
print('\n=== pollen openness (Feeser et al. 2019, SMOOTH_MEAN_200y, Belau+Woserin) ===')
print(' mean %.2f in the 300 yr BEFORE %d BCE vs %.2f in the 300 yr AFTER -> change '
      '%+.2f (%+.1f%%)' % (pre, win, post, post - pre, 100 * (post / pre - 1)))
print(' time_series pollen_inter: 2000-1800 BCE mean %.2f -> bin %d BCE %.2f -> '
      '1600-1400 BCE mean %.2f'
      % (bins[(bins.BCE >= 1800) & (bins.BCE <= 2000)].pollen_inter.mean(), win,
         bins[bins.BCE == win].pollen_inter.iloc[0],
         bins[(bins.BCE >= 1400) & (bins.BCE <= 1600)].pollen_inter.mean()))
print(' pollen_grate_100 at the event bin: %+.5f (negative = declining openness)'
      % bins[bins.BCE == win].pollen_grate_100.iloc[0])
print(' period label of the event bin (%d BCE): %s ; next bin (%d BCE): %s'
      % (win, bins.set_index('BCE').group.get(win), win - 100,
         bins.set_index('BCE').group.get(win - 100)))
print(' Spearman rho(PotteryForm, PotteryDecoration) = %.3f  (antiphonic cultural '
      'capital)' % bins.PotteryForm.corr(bins.PotteryDecoration, method='spearman'))
ctx = pd.DataFrame([
    dict(metric='PotteryForm_Z', before_mean=round(bins[(bins.BCE > win) &
         (bins.BCE <= win + 400)].PotteryForm.mean(), 2), at_event=round(
         bins[bins.BCE == win].PotteryForm.iloc[0], 2), after_mean=round(
         bins[(bins.BCE < win) & (bins.BCE >= win - 400)].PotteryForm.mean(), 2)),
    dict(metric='PotteryDecoration_Z', before_mean=round(bins[(bins.BCE > win) &
         (bins.BCE <= win + 400)].PotteryDecoration.mean(), 2), at_event=round(
         bins[bins.BCE == win].PotteryDecoration.iloc[0], 2), after_mean=round(
         bins[(bins.BCE < win) & (bins.BCE >= win - 400)].PotteryDecoration.mean(), 2)),
    dict(metric='pollen_openness_smooth200', before_mean=round(pre, 2),
         at_event=round(float(pol.iloc[(pol.BCE - win).abs().argmin()].SMOOTH_MEAN_200y),
                        2), after_mean=round(post, 2)),
])
print(ctx.to_string(index=False))
ctx.to_csv('analysis/context_table.csv', index=False)
print('wrote analysis/event_summary.csv, analysis/context_table.csv')
