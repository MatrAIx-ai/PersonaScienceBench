import pandas as pd, numpy as np

ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')

# ---- Window & century bins (aligned to capital.csv grid; bin BCE=X covers X..X-99 CE) ----
w = ts[(ts.CE <= -1100) & (ts.CE >= -2000)].copy()          # inclusive both ends: 901 years
# bin = next century boundary above |CE| ; e.g. CE=-2000..-1901 -> bin 2000 ; CE=-1100 -> bin 1100
w['bin'] = np.where(w.CE == -1100, 1100, np.ceil(-w.CE/100)*100)
w['bin'] = w['bin'].clip(upper=2000)
w.loc[w.CE==-2000,'bin'] = 2000
centuries = [2000,1900,1800,1700,1600,1500,1400,1300,1200]   # 9 full centuries (2000-1901 .. 1200-1101)

agg = w.groupby('bin').agg(pollen_grate_100=('pollen_grate_100','mean'),
                           g_all_mean=('g_all_mean','mean'),
                           n=('CE','size')).reindex(centuries+[1100])

# ---- Capital category indices (researcher-documented grouping) ----
cats = {
 'Symbolic': ['ZAxtSchwert','ZDolch','Zhausgr'],
 'Social':   ['ZCU_AU','Zamber','ZMonument'],
 'Cultural': ['ZKeform','Zkeverz'],
 'Economic': ['ZHort','ZSichel','ZBeil','ZMW'],
}
cap = cap.set_index('BCE')
for k,v in cats.items(): cap[k] = cap[v].mean(axis=1)
cap['AllCapital'] = cap[list(sum(cats.values(),[]))].mean(axis=1)

# Delta into century X = Z(X) - Z(X+100) (moving forward in time)
need = list(range(2100,1000,-100))          # 2100 .. 1100
rows = []
for x in centuries:
    r = {'bin': x}
    for k in list(cats)+['AllCapital']:
        r['d_'+k] = cap.loc[x,k] - cap.loc[x+100,k]
    rows.append(r)
dl = pd.DataFrame(rows).set_index('bin')

tab = agg.join(dl).round(6)
tab.insert(0,'n_years',agg['n'])
print("=== Century table (bin BCE=X covers X .. X-99 BCE; bin 1100 = endpoint year -1100 only) ===")
print(tab.to_string())

def ranks(col, asc=False):
    s = tab.loc[centuries, col].rank(ascending=asc, method='min').astype(int)
    return s
for c in ['pollen_grate_100','g_all_mean'] + ['d_'+k for k in list(cats)+['AllCapital']]:
    tab['rk_'+c] = ranks(c)
print("\n=== Ranks within 9 centuries (1 = highest growth) ===")
print(tab[[c for c in tab.columns if c.startswith('rk_')]].to_string())

# ---- Sensitivity: SMOOTH_MEAN_100y-derived pct change from raw pollen file ----
p = pol.copy(); p['CEi'] = p.index
pw = p[(p.CE>=-2000)&(p.CE<=-1100)].copy()
pw['pct'] = pw.SMOOTH_MEAN_100y.pct_change()
pw['bin'] = np.where(pw.CE==-1100,1100,np.ceil(-pw.CE/100)*100)
sens = pw.groupby('bin')['pct'].mean().reindex(centuries)
print("\n=== Sensitivity: century means of SMOOTH_MEAN_100y pct-change (raw pollen file) ===")
print(sens.round(6).to_string())
print("Top3 by this metric:", list(sens.sort_values(ascending=False).index[:3]))
print("Top3 by pollen_grate_100:", list(tab.loc[centuries,'pollen_grate_100'].sort_values(ascending=False).index[:3]))

# ---- Contiguous phase detection on primary signal ----
s = tab.loc[centuries,'pollen_grate_100']
thr = s.mean()
above = s > thr
print("\nBins above window mean of pollen_grate_100:", list(above[above].index))
# best contiguous run by summed value
best=None
for i in range(len(centuries)):
    for j in range(i+1,len(centuries)):
        run=centuries[i:j+1]; val=s.loc[run].sum()/len(run)
        if best is None or val>best[1]: best=(run,val)
print("Best mean-value contiguous run:", best[0], round(best[1],6))
tab.to_csv('analysis/century_table.csv')
