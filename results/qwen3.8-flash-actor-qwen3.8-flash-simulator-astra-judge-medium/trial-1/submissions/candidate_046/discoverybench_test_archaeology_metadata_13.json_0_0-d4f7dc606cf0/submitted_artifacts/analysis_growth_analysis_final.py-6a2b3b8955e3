"""Growth analysis: highest-growth centuries 2000-1100 BCE (DiscoveryBench archaeology task).
Primary signal : pollen_grate_100 (study-defined % change of 100y-smoothed Belau openness score)
Corroborating  : g_all_mean (KDE growth rate), century-on-century delta of 4 documented capital categories
Sensitivity    : SMOOTH_MEAN_100y-derived change from the raw pollen file (time-ascending; artifact-flagged)
"""
import pandas as pd, numpy as np

ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',').set_index('BCE')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')

# Window inclusive 2000-1100 BCE; bin BCE=X covers X..X-99 BCE (capital.csv grid).
# Endpoint year CE=-1100 assigned to its own '1100' bin (excluded from 9-century ranking).
w = ts[(ts.CE <= -1100) & (ts.CE >= -2000)].copy()
w['bin'] = np.where(w.CE == -1100, 1100, np.ceil(-w.CE/100)*100)
centuries = [2000,1900,1800,1700,1600,1500,1400,1300,1200]

agg = (w.groupby('bin')
        .agg(pollen_grate_100=('pollen_grate_100','mean'),
             g_all_mean=('g_all_mean','mean'))
        .reindex(centuries))

cats = {'Symbolic':['ZAxtSchwert','ZDolch','Zhausgr'],
        'Social'  :['ZCU_AU','Zamber','ZMonument'],
        'Cultural':['ZKeform','Zkeverz'],
        'Economic':['ZHort','ZSichel','ZBeil','ZMW']}
for k,v in cats.items(): cap[k] = cap[v].mean(axis=1)
cap['AllCapital'] = cap[list(sum(cats.values(),[]))].mean(axis=1)
# Delta into century X (forward in time) = Z(X) - Z(X+100)
dl = pd.DataFrame({k: [cap.loc[x,k]-cap.loc[x+100,k] for x in centuries]
                   for k in list(cats)+['AllCapital']}, index=pd.Index(centuries,name='bin'))

tab = agg.join(dl).round(6)
rcols = []
for c in tab.columns:
    tab['rk_'+c] = tab[c].rank(ascending=False, method='min').astype(int); rcols.append('rk_'+c)
print("=== Century means/deltas, ranks (1 = highest) — 9 centuries, 2000-1101 BCE ===")
print(tab.to_string())

# Contiguous phase on primary signal (max mean-value run)
s = tab['pollen_grate_100']
best = max(((centuries[i:j+1], s.iloc[i:j+1].mean())
            for i in range(9) for j in range(i,9)), key=lambda t: t[1])
print("\nHighest contiguous phase (primary signal):",
      [f"{a}-{a-99} BCE" for a in best[0]], " mean =", round(best[1],6))

# Sensitivity: raw-pollen SMOOTH_MEAN_100y, time-ascending pct change (+ abs level change).
p = pol.sort_index(); p = p[(p.index >= -2000) & (p.index <= -1100)].copy()
p['pct']  = p.SMOOTH_MEAN_100y.pct_change()
p['dl']   = p.SMOOTH_MEAN_100y.diff()
p['bin']  = np.where(p.index == -1100, 1100, np.ceil(-p.index/100)*100)
sens = p.groupby('bin')[['pct','dl']].mean().reindex(centuries).round(6)
sens['note'] = np.where(sens.index==1600, 'pct inflated: level crosses 0 ~1522-1518 BCE', '')
print("\n=== Sensitivity (SMOOTH_MEAN_100y-derived) ===")
print(sens.to_string())
print("Top3 abs-level-change:", list(sens['dl'].sort_values(ascending=False).index[:3]))
tab.to_csv('analysis/century_table_final.csv')
