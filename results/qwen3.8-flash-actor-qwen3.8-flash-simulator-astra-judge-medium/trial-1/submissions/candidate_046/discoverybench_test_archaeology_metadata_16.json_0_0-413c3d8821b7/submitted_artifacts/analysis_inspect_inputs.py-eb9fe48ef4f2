"""Inspection of the three supplied data sheets (no PCA, no figures)."""
import pandas as pd, numpy as np

TS = 'data/time_series_data.csv'
CAP = 'data/capital.csv'
POL = 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'

Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
     'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
Z2TS = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
        'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount',
        'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize',
        'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}

cap = pd.read_csv(CAP, decimal=',')
ts  = pd.read_csv(TS)
pol = pd.read_csv(POL, decimal=',')

print('== capital.csv ==', cap.shape)
print(cap[['group','color']].astype(str).agg(lambda s: sorted(s.unique())).to_dict())
print(cap.groupby('group').BCE.agg(['min','max','count']).to_string())
print('BCE step(s):', np.unique(np.diff(sorted(cap.BCE))))
print('NaN:', int(cap[Z].isna().sum().sum()))
print(pd.DataFrame({'mean': cap[Z].mean(), 'std': cap[Z].std(ddof=0)}).round(4).to_string())

print('\n== time_series_data.csv ==', ts.shape)
print('CE', ts.CE.min(), ts.CE.max(), '| calBP', ts.calBP.min(), ts.calBP.max(),
      '| step', np.unique(np.diff(ts.CE)), '| calBP == 1950-CE:', bool((ts.calBP == 1950 - ts.CE).all()))
print(ts.isna().sum().to_string())

print('\n== pollen file ==', pol.shape, list(pol.columns))
print('CE', pol.CE.min(), pol.CE.max(), '| calBP', pol.calBP.min(), pol.calBP.max(),
      '| step', np.unique(np.diff(pol.CE)))
print(pol.isna().sum().to_string())

cap_ts = cap[cap.BCE <= 4100].set_index('BCE')
tsi = ts.set_index('CE')
print('\nmax |capital - ts raw at century anchors| per variable:')
print({z: float(np.nanmax(np.abs(cap_ts[z].values - tsi.loc[[-int(b) for b in cap_ts.index], Z2TS[z]].values))) for z in Z})

print('\n== windows ==')
for a, b in [(3400, 3000), (2900, 2300)]:
    w  = ts[(ts.CE >= -a) & (ts.CE <= -b)]
    pw = pol[(pol.CE >= -a) & (pol.CE <= -b)]
    print(f'{a}-{b} BCE: capital slices={len(cap[(cap.BCE<=a)&(cap.BCE>=b)])}, '
          f'ts annual rows={len(w)}, ts raw Z anchors={int(w.Amber.notna().sum())}, '
          f'pollen rows={len(pw)}, Belau raw={int(pw.Belau_PC1.notna().sum())}, '
          f'Woserin raw={int(pw.Woserin_PC1.notna().sum())}, '
          f'pollen MEAN mean={pw.MEAN.mean():.3f} ({pw.MEAN.min():.2f}..{pw.MEAN.max():.2f})')
