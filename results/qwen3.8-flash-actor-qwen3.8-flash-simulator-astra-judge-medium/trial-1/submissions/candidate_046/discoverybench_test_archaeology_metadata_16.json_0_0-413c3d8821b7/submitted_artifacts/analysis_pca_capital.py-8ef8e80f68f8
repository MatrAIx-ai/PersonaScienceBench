    svg()
print('tables: pc1_loadings.csv, pc1_scores_by_slice.csv, period_summary.csv, loading_x_z_contributions.csv')

print('\n========== PC2 CONTEXT + MARKDOWN REPORT ==========')
load2 = pd.Series(evec[:, 1], index=Z)
contrib2 = pd.DataFrame(load2.values * X, index=bce, columns=Z)
for name, (a, b) in PERIODS.items():
    m = (bce <= a) & (bce >= b)
    print('%s PC2 contributions (sum = PC2 mean %+0.3f): %s'
          % (name, contrib2[m].mean().sum(),
             dict(zip(contrib2[m].mean().sort_values().index[:3], contrib2[m].mean().sort_values().round(3)[:3]))
             , ))
    print('    top-3 UP:', list(contrib2[m].mean().sort_values().tail(3).round(3).items()))

def md(df, index=True):
    d = df.reset_index() if index else df
    cols = [str(c) for c in d.columns]
    def fmt(v):
        return ('%.4g' % v) if isinstance(v, (int, float, np.floating, np.integer)) else str(v)
    lines = ['| ' + ' | '.join(cols) + ' |', '|' + '|'.join(['---'] * len(cols)) + '|']
    for _, r in d.iterrows():
        lines.append('| ' + ' | '.join(fmt(v) for v in r.tolist()) + ' |')
    return '\n'.join(lines) + '\n'

with open('analysis/results_tables.md', 'w') as fh:
    fh.write('# Capital PCA (100-year slices) - result tables\n\n')
    fh.write('Primary: covariance-PCA on the 39x12 matrix of `capital.csv` Z-values as supplied '
             '(already z-standardised per variable).\n')
    fh.write('Declared sign convention: every PC oriented so that the SUM OF ITS LOADINGS IS POSITIVE.\n\n')
    fh.write('## Variance explained\n')
    fh.write(pd.DataFrame({'primary_39': 100*varexp[:4], 'corrPCA': 100*vc[:4],
                           'rows_37': 100*v37[:4]}).round(2).pipe(md, index=True) + '\n')
    fh.write('Kaiser (lambda>1): %d components (39 rows), %d (37 rows); cum >=60%% at PC%d.\n\n'
             % (int((ev > 1).sum()), int((e37 > 1).sum()), int(np.argmax(varexp.cumsum() >= .60)+1)))
    fh.write('## PC1 loadings (declared sign), with capital group\n')
    fh.write(md(L.round(4)) + '\n')
    fh.write('sum(loadings) = %+.3f; %d positive vs %d negative.\n\n' % (load.sum(), (load > 0).sum(), (load < 0).sum()))
    fh.write('## PC1 score per secular slice (target periods flagged)\n')
    fh.write(md(out.round(3), index=False) + '\n')
    fh.write('## Period summaries (all variants)\n')
    fh.write(pd.concat([period_table(scores.PC1.values, bce, 'primary_39'),
                        period_table(sc.PC1.values, bce, 'corrPCA'),
