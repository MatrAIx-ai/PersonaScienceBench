"""PCA of the forms of capital in 100-year time slices, and characterisation of PC1
for the Middle Neolithic (3400-3000 BCE) and the Younger Neolithic (2900-2300 BCE).

Primary route: covariance-PCA on the 39x12 matrix of the capital.csv Z-values as
supplied (already z-standardised per variable); no per-bin rescaling, no re-scaling.
Robustness: correlation-PCA, 37 unique rows, drop boundary slices, drop ZSichel, and
an alternative 100-yr binning built as the mean of the annual interpolated series.
DECLARED SIGN CONVENTION: every PC is oriented so that the SUM OF ITS LOADINGS IS
POSITIVE, i.e. the majority/dominant block of variables defines the + direction.
"""
import numpy as np, pandas as pd

TS, CAP = 'data/time_series_data.csv', 'data/capital.csv'
POL = 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'
Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort',
     'ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
GRP = {'ZAxtSchwert':'symbolic','ZDolch':'symbolic','Zhausgr':'symbolic',
       'ZCU_AU':'social','Zamber':'social','ZMonument':'social',
       'ZKeform':'cultural','Zkeverz':'cultural',
       'ZHort':'economic','ZSichel':'economic','ZBeil':'economic','ZMW':'economic'}
Z2TS = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'CopperGold',
        'Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle',
        'ZBeil':'AxesCelts','ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
PERIODS = {'MN_3400-3000 BCE': (3400, 3000), 'YNeol_2900-2300 BCE': (2900, 2300)}


def pca(X, cols):
    Xc = X - X.mean(axis=0)
    ev, evec = np.linalg.eigh(np.cov(Xc, rowvar=False, ddof=1))
    o = np.argsort(ev)[::-1]
    ev, evec = ev[o], evec[:, o]
    for i in range(evec.shape[1]):                      # declared sign convention
        if evec[:, i].sum() < 0:
            evec[:, i] *= -1
    load = pd.Series(evec[:, 0], index=cols)
    scores = pd.DataFrame(Xc @ evec, columns=['PC%d' % (i+1) for i in range(len(ev))])
    varexp = pd.Series(ev / ev.sum(), index=['PC%d' % (i+1) for i in range(len(ev))])
    return load, scores, varexp, ev, evec


def align(l_, s_, ref_s):
    if np.corrcoef(s_, ref_s)[0, 1] < 0:
        return -np.asarray(l_), -np.asarray(s_)
    return np.asarray(l_), np.asarray(s_)


def period_table(s, b, label):
    v = np.asarray(s); rows = []
    for name, (a, bb) in PERIODS.items():
        m = (b <= a) & (b >= bb); x = v[m]
        rows.append(dict(set=label, period=name, n=int(m.sum()), mean=x.mean(), sd=x.std(ddof=0),
                         vmin=x.min(), vmax=x.max(), slice_min=int(b[m][x.argmin()]),
                         slice_max=int(b[m][x.argmax()]),
                         pct_slices_below=100.0*(v < x.mean()).mean()))
    return pd.DataFrame(rows)


cap = pd.read_csv(CAP, decimal=',')
bce = cap.BCE.values.astype(int)
X = cap[Z].values.astype(float)
ts = pd.read_csv(TS)
pol = pd.read_csv(POL, decimal=',')

print('========== PRIMARY: covariance-PCA, 39x12 Z as supplied ==========')
load, scores, varexp, ev, evec = pca(X, Z)
print('eigenvalues:', np.round(ev[:5], 4), '| Kaiser (lambda>1):', int((ev > 1).sum()),
      '| cum >=60%% reached at PC%d' % int(np.argmax(varexp.cumsum() >= .60) + 1))
print('variance explained:', (100*varexp[:5]).round(2).to_dict())
L = pd.DataFrame({'loading': load, 'abs': load.abs(),
                  'capital_group': [GRP[c] for c in Z]}).sort_values('loading', ascending=False)
print('\nPC1 loadings, descending (sign convention: sum of loadings > 0):')
print(L.round(4).to_string())
print('sum(loadings) = %+.3f | %d positive / %d negative | max |loading|: %s (%.3f) | max negative: %s (%.3f)'
      % (load.sum(), (load > 0).sum(), (load < 0).sum(), load.abs().idxmax(), load.abs().max(),
         load.idxmin(), load.min()))
print('\nPC2 loadings, descending (var %.2f%%):' % (100*varexp.iloc[1]))
print(pd.Series(evec[:, 1], index=Z).sort_values(ascending=False).round(3).to_string())
scores['BCE'] = bce; scores['group'] = cap.group.values
print('\nPC1/PC2 score per secular slice:')
print(scores[['BCE','group','PC1','PC2']].round(3).to_string(index=False))
print('\nPERIOD SUMMARY (primary):')
print(period_table(scores.PC1.values, bce, 'primary_39').round(4).to_string(index=False))

print('\n--- loading x z contribution to the mean period score ---')
contrib = pd.DataFrame(load.values * X, index=bce, columns=Z)
for name, (a, b) in PERIODS.items():
    m = (bce <= a) & (bce >= b)
    c = contrib[m].mean().sort_values()
    print('\n%s | sum of contributions = %+.4f (= mean PC1 score)' % (name, c.sum()))
    print(c.round(4).to_string())
    print('  top-3 DOWN:', list(c.head(3).round(3).items()))
    print('  top-3 UP  :', list(c.tail(3).round(3).items()))
    print('  sum of contributions per capital group:',
          {g: round(float(contrib[m][[k for k in Z if GRP[k] == g]].mean().sum()), 3)
           for g in ['symbolic', 'social', 'cultural', 'economic']})

print('\n========== ROBUSTNESS ==========')
m37 = bce <= 4100
l37, s37, v37, e37, _ = pca(X[m37], Z)
l37a, s37a = align(l37.values, s37.PC1.values, scores.PC1.values[m37])
print('37 unique rows (drop back-cast 4300/4200; PC1+PC2 = %.2f%%): varPC1 %.2f%% varPC2 %.2f%% | Kaiser %d | '
      'corr(PC1 loadings, primary) %.4f | extra sign flip needed: %s'
      % (100*(v37.iloc[0]+v37.iloc[1]), 100*v37.iloc[0], 100*v37.iloc[1], int((e37 > 1).sum()),
         np.corrcoef(l37a, load.values)[0, 1],
         np.corrcoef(s37.PC1.values, scores.PC1.values[m37])[0, 1] < 0))
print(period_table(s37a, bce[m37], '37_rows').round(4).to_string(index=False))
print('37-row PC1 loadings:', dict(zip(Z, np.round(l37a, 3))))

Zst = X / X.std(axis=0, ddof=1)
lc, sc, vc, ec, _ = pca(Zst, Z)
print('\ncorrelation-PCA (extra global re-scaling): varPC1 %.2f%% PC2 %.2f%% | corr(loadings) %.4f | '
      'corr(scores) %.4f | variable most changed: %s'
      % (100*vc.iloc[0], 100*vc.iloc[1], np.corrcoef(lc.values, load.values)[0, 1],
         np.corrcoef(sc.PC1.values, scores.PC1.values)[0, 1], (lc-load).abs().idxmax()))
print(period_table(sc.PC1.values, bce, 'corrPCA').round(4).to_string(index=False))

mnb = ~np.isin(bce, [3000, 2900])
lb, sb, vb, eb, _ = pca(X[mnb], Z)
_, sb1 = align(lb.values, sb.PC1.values, scores.PC1.values[mnb])
print('\ndrop boundary slices 3000 & 2900 BCE: varPC1 %.2f%% | corr(loadings) %.4f | corr(scores) %.4f'
      % (100*vb.iloc[0], np.corrcoef(lb.values, load.values)[0, 1],
         np.corrcoef(sb1, scores.PC1.values[mnb])[0, 1]))
for name, (a, b) in PERIODS.items():
    mm = mnb & (bce <= a) & (bce >= b)
    now = sb1[np.isin(bce[mnb], bce[mm])].mean()
    print('   %s (%d slices kept): same slices primary PCA %+.4f | re-estimated PCA %+.4f (diff %+.4f) '
          '| full-period primary %+.4f'
          % (name, mm.sum(), scores.PC1.values[mm].mean(), now, now - scores.PC1.values[mm].mean(),
             scores.PC1.values[(bce <= a) & (bce >= b)].mean()))
mnK = mnb & (bce <= 3400) & (bce >= 3000); sgK = mnb & (bce <= 2900) & (bce >= 2300)
print('   MN - YNeol gap: primary (same slices) %+.4f -> re-estimated %+.4f'
      % (scores.PC1.values[mnK].mean() - scores.PC1.values[sgK].mean(),
         sb1[np.isin(bce[mnb], bce[mnK])].mean() - sb1[np.isin(bce[mnb], bce[sgK])].mean()))

cols = [c for c in Z if c != 'ZSichel']
ln, sn, vn, en, _ = pca(X[:, [Z.index(c) for c in cols]], cols)
print('\ndrop ZSichel: varPC1 %.2f%% | corr(loadings) %.4f | corr(scores) %.4f'
      % (100*vn.iloc[0], np.corrcoef(ln.values, load[cols].values)[0, 1],
         np.corrcoef(sn.PC1.values, scores.PC1.values)[0, 1]))

print('\n========== ALTERNATIVE 100-YR BINS: mean of annual *_inter ==========')
inter = pd.DataFrame({z: ts[Z2TS[z] + '_inter'].values for z in Z}, index=ts.CE.values)
slices = bce[(bce <= 4100) & (bce >= 600)]        # slices with a complete 100-year window
Xp = X[np.isin(bce, slices)]
for nm, (lo_bce, hi_bce) in {'[c-99, c] (researcher spec)': (slices-99, slices),
                             '[c, c+99] (mirror window)'  : (slices, slices+99)}.items():
    B, nyr = [], []
    for lo, hi in zip(lo_bce, hi_bce):
        w = inter[(inter.index >= -hi) & (inter.index <= -lo)]
        B.append(w.mean().values); nyr.append(len(w))
    B = np.array(B)
    lb2, sb2, vb2, eb2, _ = pca(B, Z)
    l2a, s2a = align(lb2.values, sb2.PC1.values, scores.PC1.values[np.isin(bce, slices)])
    print('\nroute %s | n=%d slices | years per window: min %d, max %d '
          '(windows truncated at the 4100/500 BCE ends of the annual grid) | mean |binmean - anchor| '
          '= %.4f (max %.3f)'
          % (nm, len(slices), min(nyr), max(nyr), np.abs(B-Xp).mean(), np.abs(B-Xp).max()))
    print('  varPC1 %.2f%% | corr(loadings, primary) %.4f | corr(PC1 scores, primary) %.4f'
          % (100*vb2.iloc[0], np.corrcoef(l2a, load.values)[0, 1],
             np.corrcoef(s2a, scores.PC1.values[np.isin(bce, slices)])[0, 1]))
    for name, (a, b) in PERIODS.items():
        mm = np.isin(slices, np.arange(b, a+1, 100))
        pm = scores.PC1.values[np.isin(bce, slices)][mm].mean()
        print('    %s: primary %+.4f | route %+.4f (diff %+.4f) | min slice %d, max slice %d | trajectory %s'
              % (name, pm, s2a[mm].mean(), s2a[mm].mean()-pm, slices[mm][s2a[mm].argmin()],
                 slices[mm][s2a[mm].argmax()], [round(float(v), 2) for v in s2a[mm]]))

print('\n========== POLLEN (qualitative / correlational; NOT part of the PCA) ==========')
pbin = pol.assign(bin=np.ceil(-pol.CE/100)*100).groupby('bin').agg(
    Belau_inter=('Belau_PC1_inter', 'mean'), MEAN=('MEAN', 'mean'), S100=('SMOOTH_MEAN_100y', 'mean'))
pp = pd.DataFrame({'BCE': bce, 'PC1_capital': scores.PC1.values}).join(pbin, on='BCE', how='left')
for col in ['Belau_inter', 'MEAN', 'S100']:
    d = pp[['PC1_capital', col]].dropna()
    print('all slices: r(PC1_capital, %s) = %+.3f | Spearman rho = %+.3f (n=%d)'
          % (col, d.PC1_capital.corr(d[col]), d.PC1_capital.corr(d[col], method='spearman'), len(d)))
for name, (a, b) in PERIODS.items():
    w = pp[(pp.BCE <= a) & (pp.BCE >= b)]
    wr = pol[(pol.CE >= -a) & (pol.CE <= -b)]
    print('%s: capital PC1 %+0.3f | pollen MEAN %+0.3f | SMOOTH100 %+0.3f | raw samples in window n=%d'
          % (name, w.PC1_capital.mean(), w.MEAN.mean(), w.S100.mean(), int(wr.Belau_PC1.notna().sum())))
    print('   per-slice pollen MEAN:', dict(zip(w.BCE, w.MEAN.round(2))))
    print('   per-slice capital PC1:', dict(zip(w.BCE, w.PC1_capital.round(2))))
    print('   within-window r(PC1, MEAN) = %+.3f (n=%d bins -> not interpretable)'
          % (w.PC1_capital.corr(w.MEAN), len(w)))
pw = pol[(pol.CE >= -3400) & (pol.CE <= -2300)]
gaps = sorted(set(np.abs(np.diff(pw.CE[pw.Belau_PC1.notna()].values))))
print('resolution caveat: 3400-2300 BCE pollen = %d raw samples with gaps %s yr (irregular ~20 yr) vs '
      'fixed 100-yr capital slices; Belau_PC1 is a PCA of pollen percentages, capital PC1 a PCA of '
      'z-scored find counts -> different proxies, different units, NOT a common axis'
      % (int(pw.Belau_PC1.notna().sum()), gaps))

print('\n========== TREND / DISCRIMINATION DIAGNOSTICS ==========')
print('corr(PC1 score, calendar time) = %+.3f -> PC1 also carries a long-term (Bronze Age) trend'
      % np.corrcoef(scores.PC1.values, -bce)[0, 1])
mn = scores[(scores.BCE >= 3000) & (scores.BCE <= 3400)]
sg = scores[(scores.BCE >= 2300) & (scores.BCE <= 2900)]
print('series mean %+0.3f | MN %+0.3f (sd %0.3f) | YNeol %+0.3f (sd %0.3f) | MN - YNeol %+0.3f'
      % (scores.PC1.mean(), mn.PC1.mean(), mn.PC1.std(ddof=0), sg.PC1.mean(), sg.PC1.std(ddof=0),
         mn.PC1.mean() - sg.PC1.mean()))
print('MN slices (BCE, PC1):', list(zip(mn.BCE, mn.PC1.round(3).values)))
print('YNeol slices (BCE, PC1):', list(zip(sg.BCE, sg.PC1.round(3).values)))
print('PC2 means: MN %+0.3f | YNeol %+0.3f | series %+0.3f' % (mn.PC2.mean(), sg.PC2.mean(), scores.PC2.mean()))
try:
    from scipy import stats
    t, p = stats.ttest_ind(mn.PC1, sg.PC1, equal_var=False)[:2]
    u, pu = stats.mannwhitneyu(mn.PC1, sg.PC1, alternative='two-sided')
    print('Welch t-test MN vs YNeol PC1: t = %+.3f, p = %.3f | Mann-Whitney U = %.1f, p = %.3f' % (t, p, u, pu))
    for g in ['symbolic', 'social', 'cultural', 'economic']:
        gc = [k for k in Z if GRP[k] == g]
        print('   group mean z: %-9s MN %+0.3f | YNeol %+0.3f'
              % (g, X[(bce >= 3000) & (bce <= 3400)][:, [Z.index(k) for k in gc]].mean(),
                 X[(bce >= 2300) & (bce <= 2900)][:, [Z.index(k) for k in gc]].mean()))
except Exception as e:
    print('scipy unavailable:', e)

print('\n========== EXPORT ==========')
L.round(4).to_csv('analysis/pc1_loadings.csv')
out = scores[['BCE', 'group', 'PC1', 'PC2']].copy()
out['period'] = np.where((out.BCE >= 3000) & (out.BCE <= 3400), 'MN',
                  np.where((out.BCE >= 2300) & (out.BCE <= 2900), 'YNeol_SG', ''))
out.round(4).to_csv('analysis/pc1_scores_by_slice.csv', index=False)
pd.concat([period_table(scores.PC1.values, bce, 'primary_39'),
           period_table(sc.PC1.values, bce, 'corrPCA'),
           period_table(s37a, bce[m37], '37_rows')]).round(4).to_csv('analysis/period_summary.csv', index=False)
pd.DataFrame(contrib, index=pd.Index(contrib.index, name='BCE')).round(4).to_csv(
    'analysis/loading_x_z_contributions.csv')
def svg():   # pure-python fallback (no matplotlib in this environment)
    W, H, ml, mr, mt, mb = 780, 310, 60, 15, 22, 42
    ys = scores.PC1.values
    b0, b1 = 4400, 400                      # BCE axis, reversed (4400 left, 400 right)
    y0, y1 = ys.min() - .3, ys.max() + .3
    sx = lambda b: ml + (b0 - b) / (b0 - b1) * (W - ml - mr)
    sy = lambda v: mt + (y1 - v) / (y1 - y0) * (H - mt - mb)
    P = ['<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" font-family="sans-serif">' % (W, H),
         '<rect width="%d" height="%d" fill="white"/>' % (W, H)]
    for a, b, col, lab in [(3400, 3000, '#ffb366', 'Middle Neolithic 3400-3000 BCE'),
                           (2900, 2300, '#7ec8a0', 'Younger Neolithic 2900-2300 BCE')]:
        P.append('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" fill="%s" opacity="0.45"/>'
                 % (sx(a), mt, sx(b) - sx(a), H - mt - mb, col))
        P.append('<text x="%.1f" y="%.1f" font-size="10">%s</text>' % (sx(a) + 4, mt + 12, lab))
    for gv in [0, 1, 2, 3, 4, -1, -2, -3]:
        P.append('<line x1="%.1f" y1="%.1f" x2="%.1f" y2="%.1f" stroke="%s" stroke-width="%s"/>'
                 % (ml, sy(gv), W - mr, sy(gv), '#444' if gv == 0 else '#e8e8e8', '1.2' if gv == 0 else '1'))
        P.append('<text x="%.1f" y="%.1f" font-size="10" text-anchor="end">%d</text>' % (ml - 5, sy(gv) + 3, gv))
    for t in range(4000, 499, -1000):
        P.append('<text x="%.1f" y="%d" font-size="10" text-anchor="middle">%d BCE</text>' % (sx(t), H - mb + 15, t))
    for a, b in PERIODS.values():
        m = (bce <= a) & (bce >= b)
        P.append('<line x1="%.1f" y1="%.1f" x2="%.1f" y2="%.1f" stroke="black" stroke-width="2.5"/>'
                 % (sx(a), sy(ys[m].mean()), sx(b), sy(ys[m].mean())))
    P.append('<polyline fill="none" stroke="#1f4e79" stroke-width="1.6" points="'
             + ' '.join('%.1f,%.1f' % (sx(b), sy(y)) for b, y in zip(bce, ys)) + '"/>')
    for b, y in zip(bce, ys):
        hl = (3000 <= b <= 3400) or (2300 <= b <= 2900)
        P.append('<circle cx="%.1f" cy="%.1f" r="%s" fill="%s"/>'
                 % (sx(b), sy(y), '3.4' if hl else '2.4', '#c00000' if hl else '#1f4e79'))
    P.append('<text x="%d" y="%d" font-size="11" text-anchor="middle">100-year slices (red = Middle / Younger Neolithic); black bars = period mean PC1</text>'
             % (W // 2, H - 6))
    P.append('<text x="14" y="%d" font-size="11" transform="rotate(-90 14 %d)">capital PC1 (declared sign)</text>'
             % (H // 2, H // 2))
    P.append('</svg>')
    open('analysis/pc1_by_slice.svg', 'w').write('\n'.join(P))
    print('figure: analysis/pc1_by_slice.svg (pure-python SVG fallback, one figure, both periods shaded)')


try:
    import matplotlib; matplotlib.use('Agg'); import matplotlib.pyplot as plt
    fig, ax = plt.subplots(figsize=(8, 3.2))
