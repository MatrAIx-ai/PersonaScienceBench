"""
PCA on forms of capital (12 Z variables) in 100-year time slices.
Question: how does PC1 at 1100 BCE (start of Younger Bronze Age) differ from
the subsequent horizons 1000-500 BCE?

Conventions agreed with researcher:
 - base PCA: all 39 slices, correlation matrix (columns standardised)
 - deterministic sign: variable with largest |loading| on PC1 gets a positive loading
 - sensitivity: YBA-only PCA excluding zero-variance columns (ZSichel, ZKeform)
 - outlier check: PC1(1100) recomputed dropping ZHort and ZCU_AU
"""
import numpy as np, pandas as pd

DATA = "/workspace/data/capital.csv"
GROUPS = {
    "symbolic":  ["ZAxtSchwert", "ZDolch", "Zhausgr"],
    "social":    ["ZCU_AU", "Zamber", "ZMonument"],
    "cultural":  ["ZKeform", "keverz_placeholder"],
    "economic":  ["ZHort", "ZSichel", "ZBeil", "ZMW"],
}
GROUPS["cultural"] = ["ZKeform", "Zkeverz"]
ZCOLS = [c for g in GROUPS.values() for c in g]

def load():
    df = pd.read_csv(DATA, decimal=",")
    assert sorted(df[ZCOLS].columns.tolist()) == sorted(ZCOLS)
    return df

def pca(mat):
    """Correlation-matrix PCA. mat: DataFrame (rows=slices, cols=variables)."""
    X = mat.astype(float)
    Z = (X - X.mean()) / X.std(ddof=1)          # correlation basis
    Z = Z.fillna(0.0)                            # guard zero-variance columns
    U, S, Vt = np.linalg.svd(Z.values, full_matrices=False)
    names = [f"PC{i+1}" for i in range(len(S))]
    ev = S**2 / (len(Z) - 1)
    evr = pd.Series(ev / ev.sum(), index=names)
    pcs = pd.DataFrame(U * S, index=mat.index, columns=names)
    load = pd.DataFrame(Vt[:len(S)].T, index=mat.columns, columns=pcs.columns)
    # deterministic sign: anchor = largest |loading| on PC1 -> positive
    anchor = None
    for pc in load.columns:
        a = load[pc].abs().idxmax()
        if pc == "PC1":
            anchor = a
        if load.loc[anchor, pc] < 0:
            load[pc] *= -1
            pcs[pc] *= -1
    return pcs, load, evr, anchor

df = load()
full = df.set_index("BCE")[ZCOLS]

# ---------- main PCA: all 39 slices ----------
pcs, load, evr, anchor = pca(full)
YBA = [1100, 1000, 900, 800, 700, 600, 500]
p1 = pcs["PC1"]

gmap = {v: g for g, vs in GROUPS.items() for v in vs}
load_out = load[["PC1", "PC2"]].copy()
load_out["capital_group"] = pd.Series(gmap)
load_out = load_out.sort_values(["capital_group", "PC1"])
load_out["PC1_pct_var_of_loading_sq"] = (load["PC1"]**2 * evr["PC1"] * 100)

# ---------- (d) comparison metrics ----------
base = p1.loc[[b for b in YBA if b != 1100]]          # 1000-500, n = 6
pc1_1100 = float(p1.loc[1100])
mu, sd = float(base.mean()), float(base.std(ddof=1))
rows = []
for b in YBA:
    rows.append({
        "BCE": b,
        "PC1": float(p1.loc[b]),
        "delta_vs_1100": float(p1.loc[b]) - pc1_1100,
        "delta_1100_minus_slice": pc1_1100 - float(p1.loc[b]),
        "z_vs_1000_500": (float(p1.loc[b]) - mu) / sd,
        "outside_2sd_of_1000_500": abs((float(p1.loc[b]) - mu) / sd) > 2,
    })
tab = pd.DataFrame(rows)
z1100 = (pc1_1100 - mu) / sd
jump = pc1_1100 - float(p1.loc[1000])
var_all = float(p1.loc[YBA].var(ddof=1))
var_rest = float(base.var(ddof=1))
var_lost_pct = 100 * (var_all - var_rest) / var_all
pct_above = float((base < pc1_1100).mean() * 100)

# ---------- (e) outlier robustness: drop ZHort & ZCU_AU ----------
def pc1_without(dropped, align=True):
    """PCA without `dropped`; PC1 sign aligned to the main 12-variable PC1 so that
    the comparison is not an artefact of the arbitrary eigenvector sign."""
    sub = full.drop(columns=dropped)
    p, l, e, a = pca(sub)
    x = p.loc[YBA, "PC1"]
    full_pc1 = p["PC1"].copy(); r = np.corrcoef(full_pc1.values, p1.values)[0, 1]
    if align and r < 0:
        x = -x; full_pc1 = -full_pc1; l = l.copy(); l["PC1"] = -l["PC1"]; r = -r
    b = x.loc[[i for i in YBA if i != 1100]]
    return x, l, a, (float(x.loc[1100]) - b.mean()) / b.std(ddof=1), full_pc1, r

rob = []
for dropped in ([], ["ZHort"], ["ZCU_AU"], ["ZHort", "ZCU_AU"]):
    x, l, a, z, fpc1, r = pc1_without(dropped)
    b = x.loc[[i for i in YBA if i != 1100]]
    rob.append({
        "dropped": "+".join(dropped) if dropped else "none (all 12 vars)",
        "anchor_variable_PC1": a,
        "PC1_1100": float(x.loc[1100]),
        "mean_PC1_1000_500": float(b.mean()),
        "sd_PC1_1000_500": float(b.std(ddof=1)),
        "delta_1100_minus_mean": float(x.loc[1100]) - float(b.mean()),
        "z_1100_vs_1000_500": float(z),
        "abs_z": abs(float(z)),
        "jump_1100_to_1000": float(x.loc[1100] - x.loc[1000]),
        "rank_of_1100_highest_in_YBA": int((x > x.loc[1100]).sum() + 1),
        "is_extreme_slice_in_YBA": bool(x.loc[1100] == x.max() or x.loc[1100] == x.min()),
        "correlation_with_main_PC1_39slices": float(r),
    })
rob = pd.DataFrame(rob)

# sign-free robustness: mean of the raw Z values per slice (no PCA at all)
meanZ = full.loc[YBA].mean(axis=1)
meanZ8 = full.loc[YBA, [c for c in ZCOLS if c not in ("ZHort", "ZCU_AU")]].mean(axis=1)
bz, bz8 = meanZ.loc[1000:500] if False else meanZ.drop(1100), meanZ8.drop(1100)
meanz_tab = pd.DataFrame({
    "BCE": YBA,
    "meanZ_all12": meanZ.values,
    "z_meanZ_all12": [(meanZ[b] - bz.mean()) / bz.std(ddof=1) for b in YBA],
    "meanZ_excl_Hort_CuAu": meanZ8.values,
    "z_meanZ_excl_Hort_CuAu": [(meanZ8[b] - bz8.mean()) / bz8.std(ddof=1) for b in YBA],
})

# ---------- (a) sensitivity: YBA-only PCA ----------
yba_mat = full.loc[YBA]
zero_var = [c for c in ZCOLS if yba_mat[c].std(ddof=1) == 0]
pcs_y, load_y, evr_y, anchor_y = pca(yba_mat.drop(columns=zero_var))
py = pcs_y["PC1"]
by = py.loc[[i for i in YBA if i != 1100]]
sens = {
    "excluded_zero_variance": zero_var,
    "anchor": anchor_y,
    "PC1_1100": float(py.loc[1100]),
    "mean_PC1_1000_500": float(by.mean()),
    "sd_PC1_1000_500": float(by.std(ddof=1)),
    "z_1100_vs_1000_500": float((float(py.loc[1100]) - by.mean()) / by.std(ddof=1)),
    "rank_of_1100": int((py > py.loc[1100]).sum() + 1),
    "evr_PC1": float(evr_y["PC1"]), "evr_PC2": float(evr_y["PC2"]),
    "pc1_table": {int(b): float(py.loc[b]) for b in YBA},
    "spearman_sign_vs_main": float(np.sign(np.corrcoef(np.argsort(np.argsort(p1.loc[YBA].values)),
                                                       np.argsort(np.argsort(py.loc[YBA].values)))[0, 1])),
}

# ---------- (f) pollen context, 1100-700 BCE only ----------
pol = pd.read_csv("/workspace/data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")
pol = pol.dropna(subset=["Belau_PC1_inter"])
pol["BCE"] = -pol["CE"]
cov_min, cov_max = pol.BCE.min(), pol.BCE.max()
bins = {}
for b in [1100, 1000, 900, 800, 700, 600, 500]:
    s_ = pol[(pol.BCE > b - 100) & (pol.BCE <= b)]["Belau_PC1_inter"]
    bins[b] = (float(s_.mean()) if len(s_) else np.nan, len(s_))
pollen_tab = pd.DataFrame({"BCE": list(bins),
                           "Belau_PC1_inter_100y_mean": [v[0] for v in bins.values()],
                           "n_years_covered": [v[1] for v in bins.values()]})
tab.to_csv("/workspace/results/pc1_by_slice.csv", index=False)
load_out.to_csv("/workspace/results/pc1_loadings.csv")
rob.to_csv("/workspace/results/robustness_dropped_variables.csv", index=False)
meanz_tab.to_csv("/workspace/results/robustness_meanZ.csv", index=False)
pollen_tab.to_csv("/workspace/results/pollen_context_1100_700BCE.csv", index=False)
pcs.loc[YBA, ["PC1", "PC2"]].to_csv("/workspace/results/pc1_pc2_yba.csv")

# ---------- report ----------
print("=== PCA basis: 39 slices (4300-500 BCE), correlation matrix ===")
print(f"variance explained: PC1 = {evr['PC1']*100:.2f}%  PC2 = {evr['PC2']*100:.2f}%  "
      f"PC1+PC2 = {(evr['PC1']+evr['PC2'])*100:.2f}%")
print(f"ANCHOR variable (largest |PC1 loading|, forced positive): {anchor} "
      f"(loading {load.loc[anchor,'PC1']:+.3f}); second largest: "
      f"{load['PC1'].abs().sort_values(ascending=False).index[1]} = {load['PC1'].abs().sort_values(ascending=False).iloc[1]:.3f}")
print("\n--- PC1 / PC2 loadings by capital group ---")
print(load_out.round(3).to_string())
print("\n--- group mean loading on PC1 ---")
print(load_out.groupby("capital_group")["PC1"].agg(["mean", "min", "max"]).round(3).to_string())
print("\n--- PC1 per YBA slice: BCE | PC1 | delta_vs_1100 | z_vs_1000_500 ---")
print(tab.round(3).to_string(index=False))
print(f"\nPC1(1100) = {pc1_1100:.3f}")
print(f"mean(1000-500) = {mu:.3f}  sd = {sd:.3f}  min = {base.min():.3f}  max = {base.max():.3f}")
print(f"delta 1100 - mean(1000-500) = {pc1_1100-mu:+.3f} PC1 units")
print(f"z(1100) vs 1000-500 = {z1100:+.2f}   outside +/-2 SD: {abs(z1100) > 2}")
print(f"jump 1100 -> 1000 BCE = {jump:+.3f}")
print(f"PC1 variance within YBA = {var_all:.3f}; excluding 1100 = {var_rest:.3f}; "
      f"variance lost by dropping 1100 = {var_lost_pct:.1f}%")
print(f"share of 1000-500 slices below PC1(1100): {pct_above:.0f}%")
print("\n--- (e) robustness: PC1(1100) with variables dropped ---")
print(rob.round(3).to_string(index=False))
print("\n--- (a) sensitivity: PCA on the 7 YBA slices only ---")
for k, v in sens.items():
    print(f"  {k}: {v}")
print("\n--- (f) pollen context (Belau_PC1_inter, 100-year means) ---")
print(pollen_tab.round(3).to_string(index=False))
print(f"pollen Belau_PC1_inter covers BCE {cov_max} .. {cov_min} -> slices with <100 yr coverage are not interpretable")
print("\n--- sign-free check: mean of raw Z values per YBA slice ---")
print(meanz_tab.round(3).to_string(index=False))

# ---------- extra: which variables drive the 1100 gap + full-series context ----------
gap = full.loc[1100] - full.loc[1000:500].mean()
contrib = (gap * load["PC1"]).sort_values(ascending=False)
contrib_tab = pd.DataFrame({
    "variable": contrib.index, "capital_group": [gmap[v] for v in contrib.index],
    "Z_1100": [float(full.loc[1100, v]) for v in contrib.index],
    "meanZ_1000_500": [float(full.loc[1000:500, v].mean()) for v in contrib.index],
    "gap": [float(gap[v]) for v in contrib.index],
    "PC1_loading": [float(load.loc[v, "PC1"]) for v in contrib.index],
    "contribution_to_PC1_gap": [float(contrib[v]) for v in contrib.index],
})
contrib_tab.to_csv("/workspace/results/gap_contributions.csv", index=False)

ser = p1.copy()
z_all = (float(ser.loc[1100]) - float(ser.drop(1100).mean())) / float(ser.drop(1100).std(ddof=1))
ctx = {
    "PC1_full_series_mean_sd": (float(ser.mean()), float(ser.std(ddof=1))),
    "PC1_1100_percentile_of_39": float((ser <= ser.loc[1100]).mean() * 100),
    "PC1_1100_z_vs_other_38": float(z_all),
    "max_slice_of_full_PC1": int(ser.idxmax()), "max_value": float(ser.max()),
    "OBA_mean(1700-1300)": float(ser.loc[1700:1300].mean()),
    "PC2_YBA_range": (float(pcs.loc[YBA, "PC2"].min()), float(pcs.loc[YBA, "PC2"].max())),
    "PC2_1100": float(pcs.loc[1100, "PC2"]), "PC2_mean_1000_500": float(pcs.loc[1000:500, "PC2"].mean()),
}
print("\n--- variables driving the 1100 BCE gap (loading x Z-gap, sums to PC1 gap) ---")
print(contrib_tab.round(3).to_string(index=False))
print("sum of contributions =", round(float(contrib_tab.contribution_to_PC1_gap.sum()), 3),
      " vs observed PC1 gap =", round(pc1_1100 - mu, 3))
print("\n--- PC1 in full 39-slice context ---")
for k, v in ctx.items():
    print(f"  {k}: {v}")
