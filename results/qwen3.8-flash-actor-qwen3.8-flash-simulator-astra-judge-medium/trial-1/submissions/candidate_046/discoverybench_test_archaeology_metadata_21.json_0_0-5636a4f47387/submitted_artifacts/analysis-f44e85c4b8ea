"""
PCA of forms of capital in 100-year time slices (Central European Neolithic/Bronze Age).

Question answered: how are the symbolic-capital components (House Size, Daggers,
Hatchets/Swords) characterised on PC1 (loading sign/magnitude relative to the other
forms of capital) and how are they distributed on PC2?

Main analysis (approved):
  - primary input  : data/capital.csv, 39 bins of 100 years (4300-500 BCE), 12 capital
                     variables, group/colour dropped.
  - standardisation: re-standardised (z-score) within the 39x12 matrix (correlation PCA)
  - decomposition  : SVD of the standardised matrix (numpy; sklearn not available)
  - sensitivity    : (S1) 37 real bins (4100-500 BCE, no back-fill),
                     (S2) no re-standardisation (as-supplied Z values),
                     (S3) yearly *_inter columns of time_series_data.csv averaged per bin.
Outputs: tables of loadings, explained variance, correlations, scores -> results/
"""
import numpy as np
import pandas as pd

CAP_VARS = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument',
            'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']
LABEL = {'ZAxtSchwert': 'Hatchets & Swords (symbolic)', 'ZDolch': 'Daggers (symbolic)',
         'Zhausgr': 'House Size (symbolic)', 'ZCU_AU': 'Copper & Gold (social)',
         'Zamber': 'Amber (social)', 'ZMonument': 'Monument Count (social)',
         'ZKeform': 'Pottery Form (cultural)', 'Zkeverz': 'Pottery Decoration (cultural)',
         'ZHort': 'Depot (economic)', 'ZSichel': 'Sickle (economic)',
         'ZBeil': 'Axes & Celts (economic)', 'ZMW': 'Monument Size (economic)'}
SYMBOLIC = ['Zhausgr', 'ZDolch', 'ZAxtSchwert']

TS_VARS = {'ZAxtSchwert': 'HatchetSword', 'ZDolch': 'Dagger', 'Zhausgr': 'HouseSize',
           'ZCU_AU': 'CopperGold', 'Zamber': 'Amber', 'ZMonument': 'MonumentCount',
           'ZHort': 'Depot', 'ZSichel': 'Sickle', 'ZBeil': 'AxesCelts', 'ZMW': 'MonumentSize',
           'ZKeform': 'PotteryForm', 'Zkeverz': 'PotteryDecoration'}


def pca(X: pd.DataFrame, n_pc: int = 4, standardise: bool = True):
    """PCA by SVD. standardise=True -> correlation PCA (z-score inside the matrix);
    standardise=False -> covariance PCA on the as-supplied values. Returns loadings,
    eigenvalues, scores, %variance."""
    Xc = X - X.mean(axis=0)
    if standardise:
        sd = Xc.std(axis=0, ddof=1).replace(0, np.nan)
        assert not sd.isna().any(), f"zero-variance column(s): {list(sd[sd.isna()].index)}"
        Xc = Xc / sd
    U, S, Vt = np.linalg.svd(Xc.to_numpy(), full_matrices=False)
    eig = S ** 2 / (len(X) - 1)
    pct = eig / eig.sum() * 100
    load = pd.DataFrame(Vt[:n_pc].T, index=X.columns, columns=[f'PC{i+1}' for i in range(n_pc)])
    scores = pd.DataFrame(U[:, :n_pc] * S[:n_pc], index=X.index, columns=load.columns)
    return load, eig, pct, scores


def orient(load, scores, ref=None):
    """Neutral deterministic sign convention, applied component by component: flip each
    axis so that its largest-|loading| variable is positive (standard practice; does not
    privilege any of the three symbolic variables)."""
    flips = np.array([np.sign(load[c].loc[load[c].abs().idxmax()]) for c in load.columns])
    flips = np.where(flips == 0, 1.0, flips)          # one sign per component
    return load * flips, scores * flips               # broadcast across columns


def run(name, X, ref=None, standardise=True):
    load, eig, pct, scores = pca(X, standardise=standardise)
    load, scores = orient(load, scores, ref)
    out = load.copy()
    out.insert(0, 'variable', [LABEL[v] for v in out.index])
    out['abs_PC1'] = out['PC1'].abs()
    print(f'\n{"="*86}\n{name}:  n={X.shape[0]} bins, p={X.shape[1]} variables')
    print('Eigenvalues   :', np.round(eig, 3))
    print('% variance    :', np.round(pct, 2), '| cumulative:', np.round(np.cumsum(pct), 2))
    print('Kaiser (eig>1):', int((eig > 1).sum()), 'components')
    print(out.sort_values('abs_PC1', ascending=False).drop(columns='abs_PC1')
             .rename(columns={'PC1': 'loading_PC1', 'PC2': 'loading_PC2',
                              'PC3': 'loading_PC3', 'PC4': 'loading_PC4'}).to_string())
    return load, eig, pct, scores


def report_symbolic(load, pct, tag=''):
    print(f'\n--- Symbolic trio on PC1/PC2 {tag} ---')
    rank = load['PC1'].abs().rank(ascending=False).astype(int)
    rank_pc2 = load['PC2'].abs().rank(ascending=False).astype(int)
    for v in SYMBOLIC:
        print(f'  {LABEL[v]:32s} PC1={load.loc[v,"PC1"]:+.3f} (rank {rank[v]}/12 by |PC1|)'
              f'   PC2={load.loc[v,"PC2"]:+.3f} (rank {rank_pc2[v]}/12 by |PC2|)')
    print('  PC1 range: min %s %+.3f | max %s %+.3f' % (load.PC1.idxmin(), load.PC1.min(),
                                                        load.PC1.idxmax(), load.PC1.max()))
    print('  PC2 range: min %s %+.3f | max %s %+.3f' % (load.PC2.idxmin(), load.PC2.min(),
                                                        load.PC2.idxmax(), load.PC2.max()))
    # cosine similarity in the PC1-PC2 loading plane (angular clustering)
    P = load[['PC1', 'PC2']].to_numpy()
    N = P / np.linalg.norm(P, axis=1, keepdims=True)
    cos = pd.DataFrame(N @ N.T, index=load.index, columns=load.index)
    print('  pairwise cosine (PC1-PC2 plane) among symbolic:',
          {f'{a[:7]}/{b[:7]}': round(float(cos.loc[a, b]), 3)
           for i, a in enumerate(SYMBOLIC) for b in SYMBOLIC[i+1:]})
    return rank, rank_pc2, cos


