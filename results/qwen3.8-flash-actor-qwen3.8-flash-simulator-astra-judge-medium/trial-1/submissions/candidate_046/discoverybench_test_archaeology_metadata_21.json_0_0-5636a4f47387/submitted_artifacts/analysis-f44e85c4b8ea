def align(ref_load, load):
    """Align the arbitrary axis signs of a variant to the main solution (flip a component
    when its loading vector correlates negatively with the main one). Sign of a PCA axis is
    arbitrary, so this is required before comparing variants."""
    L = load.copy()
    for pc in L.columns:
        if np.corrcoef(ref_load[pc], L[pc])[0, 1] < 0:
            L[pc] = -L[pc]
    return L

