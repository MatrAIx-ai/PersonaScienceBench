# bootstrap of bins for the three symbolic PC1/PC2 loadings (only if instability suspected)
rng = np.random.default_rng(11)
A = ((X39 - X39.mean()) / X39.std(ddof=1)).to_numpy()
boot = []
for _ in range(2000):
    idx = rng.integers(0, A.shape[0], A.shape[0])
    B = A[idx]
    B = (B - B.mean(0)) / B.std(0, ddof=1)
    _, sv, vt = np.linalg.svd(B, full_matrices=False)
    v1, v2 = vt[0], vt[1]
    if v1[np.argmax(np.abs(vt[0] @ np.ones(len(vt[0]))))] < 0:
        pass
    if v1[list(CAP_VARS).index('ZCU_AU')] < 0:
        v1 = -v1
    if v2[list(CAP_VARS).index('ZBeil')] < 0:
        v2 = -v2
    boot.append(np.r_[v1, v2])
boot = np.array(boot)
pos = {v: CAP_VARS.index(v) for v in SYMBOLIC}
print('\n  ROW BOOTSTRAP (2000 resamples of bins) - 95% percentile CIs, main specification:')
for v in SYMBOLIC:
    j = pos[v]
    lo1, hi1 = np.percentile(boot[:, j], [2.5, 97.5])
    lo2, hi2 = np.percentile(boot[:, 12 + j], [2.5, 97.5])
    print(f'    {LABEL[v]:32s} PC1 {L39.loc[v,"PC1"]:+.3f} [{lo1:+.3f}, {hi1:+.3f}]'
          f'  (0 excluded: {lo1 > 0 or hi1 < 0})   PC2 {L39.loc[v,"PC2"]:+.3f} '
          f'[{lo2:+.3f}, {hi2:+.3f}]  (0 excluded: {lo2 > 0 or hi2 < 0})')
pd.DataFrame(boot, columns=[f'{c}_{v}' for c in ['PC1', 'PC2'] for v in CAP_VARS]).to_csv(
