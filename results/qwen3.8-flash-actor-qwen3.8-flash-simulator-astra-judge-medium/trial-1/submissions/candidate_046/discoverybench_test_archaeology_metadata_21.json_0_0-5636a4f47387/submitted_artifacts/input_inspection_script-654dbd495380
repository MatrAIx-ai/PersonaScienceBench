"""Inspection-only script (no PCA). Reproducible record of the input audit.
Usage: python3 notes/inspect_inputs.py
Reads the three CSVs with decimal=","; reports shapes, dtypes, temporal ranges,
missingness per column, verifies capital.csv equals the secular cut of
time_series_data.csv, and identifies the pollen series used there.
"""
import pandas as pd, numpy as np

pairs = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'CopperGold',
         'Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle',
         'ZBeil':'AxesCelts','ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}

c = pd.read_csv('data/capital.csv', decimal=',')
t = pd.read_csv('data/time_series_data.csv')
p = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

print("== capital.csv ==", c.shape)
print(c.isna().sum().to_string())
print("BCE range:", c.BCE.min(), "->", c.BCE.max(), "| n bins:", c.BCE.nunique(),
      "| step:", np.unique(np.diff(np.sort(c.BCE))))
print(c[list(pairs)].describe().T.to_string())

print("\n== time_series_data.csv ==", t.shape)
print(t.isna().sum().to_string())
print("CE:", t.CE.min(), t.CE.max(), "| calBP:", t.calBP.min(), t.calBP.max(), "| annual step:", np.unique(np.diff(t.CE)))
print("years with raw capital values:", t.CE[t.HatchetSword.notna()].tolist())

tr = t[t[list(pairs.values())].notna().all(axis=1)].copy(); tr['BCE'] = -tr.CE
m = c.merge(tr, on='BCE', how='outer', indicator=True)
print("\nmerge capital vs secular rows:", m._merge.value_counts().to_dict())
b = m[m._merge == 'both']
print("max |capital - time_series raw|:", {k: float(np.nanmax(np.abs(b[k]-b[v]))) for k, v in pairs.items()})
t['bin'] = (100*np.ceil(-t.CE/100)).astype(int)
g = t.groupby('bin')[[v+'_inter' for v in pairs.values()]].mean()
common = c.BCE[c.BCE.isin(g.index)]
print("r(capital, 100y mean of *_inter) on", len(common), "bins:",
      {k: round(float(np.corrcoef(c.set_index('BCE').loc[common, k], g[v+'_inter'].reindex(common))[0, 1]), 3)
       for k, v in pairs.items()})

print("\n== pollen csv ==", p.shape)
print(p.isna().sum().to_string())
print("CE:", p.CE.min(), p.CE.max(), "| calBP:", p.calBP.min(), p.calBP.max())
mg = t.merge(p, on='CE')
s = mg[mg.pollen.notna()]
print("r(time_series.pollen, Belau_PC1) n=%d:" % len(s), float(np.corrcoef(s.pollen, s.Belau_PC1)[0, 1]))
print("r(time_series.pollen_inter, Belau_PC1_inter):", float(np.corrcoef(mg.pollen_inter, mg.Belau_PC1_inter)[0, 1]))
print("r(time_series.pollen_inter, Woserin_PC1_inter):", float(np.corrcoef(mg.pollen_inter, mg.Woserin_PC1_inter)[0, 1]))
