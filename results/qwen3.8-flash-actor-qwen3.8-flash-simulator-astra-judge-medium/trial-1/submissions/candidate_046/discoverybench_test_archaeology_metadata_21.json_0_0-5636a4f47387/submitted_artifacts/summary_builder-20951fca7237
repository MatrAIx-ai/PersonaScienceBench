"""Builds results/summary.md from the artefacts written by results/pca_capital.py.
Run: python3 results/pca_capital.py && python3 results/make_summary.py
"""
import pandas as pd, numpy as np
L = pd.read_csv('results/loadings_main_with_communalities.csv', index_col=0)
E = pd.read_csv('results/explained_variance_main.csv', index_col=0)
A = pd.read_csv('results/loading_stability_aligned.csv', index_col=0)
S = pd.read_csv('results/scores_main_39bins.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',').set_index('BCE')
C = pd.read_csv('results/correlation_matrix_main.csv', index_col=0)
cos = pd.read_csv('results/cosine_similarity_PC1PC2_loadingplane.csv', index_col=0)
b = pd.read_csv('results/bootstrap_loadings.csv')
SYM = [('Zhausgr', 'House Size'), ('ZDolch', 'Daggers'), ('ZAxtSchwert', 'Hatchets & Swords')]
NONSYM = [c for c in C.columns if c not in [v for v, _ in SYM]]
lines = []
w = lines.append
w("# PCA of forms of capital in 100-year slices — results\n")
w("**Main specification:** `capital.csv`, 39 bins of 100 years (4300–500 BCE) x 12 capital variables "
  "(group/colour dropped), re-standardised (z-score) inside the matrix, SVD = correlation PCA. "
  "Axis signs set so the largest-|loading| variable of each component is positive.\n")
w("## Explained variance\n```\n" + E.round(3).to_string() + "\n```\n"
  "Kaiser (eigenvalue > 1): 4 components. PC1 30.3%, PC2 19.5%, cumulative 49.8%.\n")
w("## Loadings, main solution (sorted by PC1)\n```\n" + L.sort_values('PC1', ascending=False)[
  ['label', 'dimension', 'PC1', 'PC2', 'PC3', 'PC4', 'rank_absPC1', 'rank_absPC2',
   'communality_PC1_2']].round(3).to_string() + "\n```\n")
w("## The three symbolic components\n")
w("| variable | loading PC1 | rank by abs PC1 | loading PC2 | rank by abs PC2 | r with PC1 score | r with PC2 score |")
w("|---|---|---|---|---|---|---|")
for v, name in SYM:
    w("| %s | %+.3f | %d/12 | %+.3f | %d/12 | %+.2f | %+.2f |" % (name, L.loc[v, 'PC1'], L.loc[v, 'rank_absPC1'],
      L.loc[v, 'PC2'], L.loc[v, 'rank_absPC2'], np.corrcoef(S.PC1, cap[v])[0, 1], np.corrcoef(S.PC2, cap[v])[0, 1]))
w("\nCosine similarity in the PC1–PC2 loading plane: Daggers/Hatchets&Swords = %.3f; House/Daggers = %.3f; "
  "House/Hatchets&Swords = %.3f.\n" % (cos.loc['ZDolch', 'ZAxtSchwert'], cos.loc['Zhausgr', 'ZDolch'],
                                        cos.loc['Zhausgr', 'ZAxtSchwert']))
w("Symbolic–symbolic correlations: House–Daggers r=%.2f, Daggers–Hatchets r=%.2f, House–Hatchets r=%.2f.\n"
  % (C.loc['Zhausgr', 'ZDolch'], C.loc['ZDolch', 'ZAxtSchwert'], C.loc['Zhausgr', 'ZAxtSchwert']))
w("Mean correlation with the 9 non-symbolic variables: House %+.3f, Daggers %+.3f, Hatchets&Swords %+.3f; "
  "strongest single partner for House and Daggers is Copper & Gold (r=%.2f and %.2f).\n"
  % (C.loc['Zhausgr', NONSYM].mean(), C.loc['ZDolch', NONSYM].mean(), C.loc['ZAxtSchwert', NONSYM].mean(),
     C.loc['Zhausgr', 'ZCU_AU'], C.loc['ZDolch', 'ZCU_AU']))
w("## Stability of the trio across specifications (axis signs aligned to the main solution)\n")
w("| variable | main 39 bins | S1 37 real bins | S2 not re-standardised | S3 yearly *_inter averaged |")
w("|---|---|---|---|---|")
for v, name in SYM:
    w("| %s | %+.3f / %+.3f | %+.3f / %+.3f | %+.3f / %+.3f | %+.3f / %+.3f |" % (name,
      L.loc[v, 'PC1'], L.loc[v, 'PC2'], A.loc[v, 's1_37bins|PC1'], A.loc[v, 's1_37bins|PC2'],
      A.loc[v, 's2_no_restd|PC1'], A.loc[v, 's2_no_restd|PC2'], A.loc[v, 's3_inter100|PC1'], A.loc[v, 's3_inter100|PC2']))
w("\nCorrelation of the full 12-variable loading vectors with the main solution — PC1: S1 0.996, S2 0.995, "
  "S3 0.989 (PC2: 0.770, 0.991, 0.658). Without aligning the arbitrary axis signs these appear as −0.99: "
  "a sign artefact, not instability.\n")
w("## Mean PC1/PC2 scores per period\n```\n" + S.assign(group=cap.loc[S.index, 'group']).groupby('group')[
  ['PC1', 'PC2']].mean().round(2).to_string() + "\n```\n"
  "r(PC1 score, year in BCE) = %+.2f (PC1 rises towards the Bronze Age); r(PC2 score, year in BCE) = %+.2f.\n"
  % (np.corrcoef(S.PC1, S.index)[0, 1], np.corrcoef(S.PC2, S.index)[0, 1]))
w("## Bootstrap of bins (2000 resamples), 95% percentile CIs\n")
for v, name in SYM:
    w("- %s: PC1 %+.3f [%+.3f, %+.3f]; PC2 %+.3f [%+.3f, %+.3f]" % (name, L.loc[v, 'PC1'],
      np.percentile(b[f'PC1_{v}'], 2.5), np.percentile(b[f'PC1_{v}'], 97.5), L.loc[v, 'PC2'],
      np.percentile(b[f'PC2_{v}'], 2.5), np.percentile(b[f'PC2_{v}'], 97.5)))
w("\n## Variance of each symbolic series captured by the axes (communality)\n")
for v, name in SYM:
    w("- %s: PC1+PC2 = %.2f; PC1–PC4 = %.2f" % (name, L.loc[v, 'communality_PC1_2'], L.loc[v, 'communality_PC1_4']))
open('results/summary.md', 'w').write("\n".join(lines) + "\n")
print("\n".join(lines[:12]))
print("summary.md written")
