#!/usr/bin/env python3
"""
Q: Between 3400 BCE and 3000 BCE, how does the number of monuments and axes
change with elements of symbolic capital?

Capital framework supplied by the researcher (NOT derived from the data):
  SYMBOLIC = HatchetSword (ZAxtSchwert), Dagger (ZDolch), HouseSize (Zhausgr)
  SOCIAL   = CopperGold (ZCU_AU), Amber (Zamber), MonumentCount (ZMonument)
  CULTURAL = PotteryForm (ZKeform), PotteryDecoration (Zkeverz)
  ECONOMIC = Depot (ZHort), Sickle (ZSichel), AxesCelts (ZBeil), MonumentSize (ZMW)

Outcomes: MonumentCount (social), AxesCelts (economic).
Predictors of interest: the 3 SYMBOLIC elements + equal-weight mean-Z composite
(weights arbitrary, declared).

All Z columns are STANDARDIZED values, not raw counts. The window 3400-3000 BCE
(inclusive) contains 5 hundred-year epochs => n = 5 independent epochs.
Descriptive analysis only: p-values are never interpreted.
"""
import json
import numpy as np
import pandas as pd
from scipy.stats import pearsonr, spearmanr

DATA, OUT = "data", "out"

CATEGORIES = {
    "symbolic": ["HatchetSword", "Dagger", "HouseSize"],
    "social":   ["CopperGold", "Amber", "MonumentCount"],
    "cultural": ["PotteryForm", "PotteryDecoration"],
    "economic": ["Depot", "Sickle", "AxesCelts", "MonumentSize"],
}
GERMAN = {"HatchetSword": "ZAxtSchwert", "Dagger": "ZDolch", "HouseSize": "Zhausgr",
          "CopperGold": "ZCU_AU", "Amber": "Zamber", "MonumentCount": "ZMonument",
          "PotteryForm": "ZKeform", "PotteryDecoration": "Zkeverz",
          "Depot": "ZHort", "Sickle": "ZSichel", "AxesCelts": "ZBeil",
          "MonumentSize": "ZMW"}
OUTCOMES = ["MonumentCount", "AxesCelts"]
ALLVARS = [v for vs in CATEGORIES.values() for v in vs]


def category_of(v):
    for cat, vs in CATEGORIES.items():
        if v in vs:
            return cat
    if v.endswith("_composite"):
        return v.replace("_composite", "") + " (composite)"
    return "pollen/demography"


def corr(x, y):
    """Pearson r + Spearman rho with n. p-values ignored (n <= 11)."""
    x, y = np.asarray(x, float), np.asarray(y, float)
    m = ~(np.isnan(x) | np.isnan(y))
    x, y = x[m], y[m]
    n = int(m.sum())
    if n < 3 or np.std(x) == 0 or np.std(y) == 0:
        return dict(n=n, pearson=None, spearman=None)
    return dict(n=n, pearson=float(pearsonr(x, y)[0]), spearman=float(spearmanr(x, y)[0]))


def sign(v):
    if v is None or (isinstance(v, float) and np.isnan(v)):
        return "na"
    return "+" if v > 0 else ("-" if v < 0 else "0")


def corr_table(ep, outcome, predictors, window):
    rows = []
    for p in predictors:
        lv = corr(ep[outcome], ep[p])
        chrono = ep.sort_index(ascending=False)   # larger BCE = older
        d = chrono[[outcome, p]].diff().dropna()  # delta = later - earlier
        df = (corr(d[outcome], d[p]) if len(d) >= 3
              else dict(n=len(d), pearson=None, spearman=None))
        rows.append(dict(window=window, outcome=outcome, category=category_of(p),
                         predictor=p, german=GERMAN.get(p, ""),
                         n_levels=lv["n"], pearson_levels=lv["pearson"],
                         spearman_levels=lv["spearman"], n_diff=df["n"],
                         pearson_diff=df["pearson"], spearman_diff=df["spearman"],
                         sign_levels=sign(lv["pearson"]), sign_diff=sign(df["pearson"])))
    return pd.DataFrame(rows)


def load():
    ts = pd.read_csv(f"{DATA}/time_series_data.csv", index_col=0).sort_values("CE")
    cap = pd.read_csv(f"{DATA}/capital.csv", decimal=",").sort_values("BCE")
    pol = pd.read_csv(f"{DATA}/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv",
                      index_col=0, decimal=",").sort_values("CE").rename(
                          columns={"SMOOTH_MEAN_100y": "openness_smooth100"})

    # QC: capital.csv must equal the raw 100-yr anchors of ts (BCE = -CE)
    ts_ix, mism = ts.set_index("CE"), []
    for en in ALLVARS:
        for bce, v in zip(cap.BCE, cap[GERMAN[en]]):
            if -bce in ts_ix.index and not np.isclose(ts_ix.at[-bce, en], v, atol=1e-12):
                mism.append((GERMAN[en], int(bce)))
    qc = dict(capital_vs_timeseries_mismatches=len(mism),
              rows_compared=int(cap.BCE.le(4100).sum()),
              n_capital_rows=int(len(cap)), n_epochs=int(ts.MonumentCount.notna().sum()))

    # Epoch table = the raw 100-yr anchors. The annual *_inter columns are linear
    # interpolations of these anchors and are NOT independent observations.
    ep = ts.loc[ts.MonumentCount.notna(), ["CE", "calBP"] + ALLVARS].copy()
    ep["BCE"] = -ep.CE
    ep = ep.set_index("BCE").sort_index()   # ascending label; chronological = BCE descending
    ep["period"] = cap.set_index("BCE").group.reindex(ep.index).values

    # Pollen / demography at epoch resolution.
    # openness = Belau_PC1: higher -> more human clearance -> higher population.
    # growth   = pollen_grate_100: authors' % change of the 100-yr smoothed openness.
    # Bin (BCE-100, BCE] mapped to CE slice [ce-99, ce].
    pg = ts.groupby("CE")[["pollen_inter_100", "pollen_grate_100",
                           "kde_all_mean", "g_all_mean"]].mean()
    raw_belau = pol.groupby("CE")["Belau_PC1"].mean()
    rows = []
    for bce in ep.index:
        ce, win = -bce, slice(-bce - 99, -bce)
        rows.append(dict(
            BCE=bce,
            openness_smooth100=pol.openness_smooth100.asof(ce),
            openness_binmean=pol.openness_smooth100.loc[win].mean(),
            openness_raw_binmean=raw_belau.loc[win].mean(),
            openness_grate100_binmean=pg.pollen_grate_100.loc[win].mean(),
            openness_inter100_binmean=pg.pollen_inter_100.loc[win].mean(),
            kde_pop_binmean=pg.kde_all_mean.loc[win].mean(),
            kde_g_binmean=pg.g_all_mean.loc[win].mean()))
    return ts, cap, pol, ep.join(pd.DataFrame(rows).set_index("BCE")), qc


def add_composites(e):
    out = e.copy()
    for c, vs in CATEGORIES.items():
        out[f"{c}_composite"] = out[vs].mean(axis=1)
    return out


def crosscorr(ep, lag_range=(-200, -100, 0, 100, 200)):
    """Rows are chronological (oldest first). shift(k) puts the value of an OLDER
    epoch on a younger row, so lag > 0 means openness LEADS the outcome by lag years
    (openness measured lag years BEFORE the archaeological epoch)."""
    # chronological order: larger BCE first (older -> younger)
    s = ep[OUTCOMES + ["openness_binmean", "openness_grate100_binmean",
                       "kde_pop_binmean"]].sort_index(ascending=False)
    out = {}
    for outc in OUTCOMES:
        for pv in ["openness_binmean", "openness_grate100_binmean", "kde_pop_binmean"]:
            for lag in lag_range:
                k = abs(lag) // 100
                y = s[pv].shift(k) if lag >= 0 else s[pv].shift(-k)   # lag>0: openness leads
                out[f"{outc}~{pv}|lag{lag:+d}"] = corr(s[outc].values, y.values)
    return out


def loo_sign(ep5, predictors):
    """Leave-one-epoch-out stability: how fragile is the n=5 sign?"""
    out = {}
    for outc in OUTCOMES:
        for p in predictors:
            vals = [sign(corr(ep5.drop(idx)[outc], ep5.drop(idx)[p])["pearson"])
                    for idx in ep5.index]
            vals = [v for v in vals if v != "na"]
            out[f"{outc}~{p}"] = dict(n=len(vals), plus=vals.count("+"),
                                      minus=vals.count("-"),
                                      sign_stable=len(set(vals)) == 1)
    return out


WINDOWS = {"main_3400_3000_inclusive": (3000, 3400),
           "sens_4int_open_border": (3100, 3400),
           "sens_3800_2800": (2800, 3800)}
POLL = ["openness_smooth100", "openness_binmean", "openness_raw_binmean",
        "openness_grate100_binmean", "kde_pop_binmean"]


def main():
    ts, cap, pol, ep, qc = load()
    res = dict(qc=qc, framework=CATEGORIES,
               units="Z-values = standardized values, NOT raw counts; "
                     "openness = Belau_PC1 PCA score (higher = more clearance)",
               window_definition="3400-3000 BCE inclusive, 100-yr epochs, n=5")

    pred_sym = CATEGORIES["symbolic"] + ["symbolic_composite"]
    pred_all = pred_sym + [v for c in ("social", "cultural", "economic")
                           for v in CATEGORIES[c]] + ["social_composite",
                                                      "cultural_composite",
                                                      "economic_composite"] + POLL

    for wname, (lo, hi) in WINDOWS.items():
        e = add_composites(ep.loc[lo:hi].sort_index())
        res.setdefault("epochs", {})[wname] = dict(
            n=int(len(e)), bce=[int(b) for b in sorted(e.index, reverse=True)])
        for outc in OUTCOMES:
            for tag, preds in (("symbolic", pred_sym), ("all", pred_all)):
                t = corr_table(e, outc, preds, wname)
                res.setdefault("correlations", {})[f"{outc}|{tag}|{wname}"] = \
                    json.loads(t.to_json(orient="records"))

    # ---- 1. epoch table (main window) ------------------------------------
    # chronological display: 3400 BCE first
    e5 = add_composites(ep.loc[3000:3400]).sort_index(ascending=False)
    cols = (["period"] + CATEGORIES["symbolic"] + ["symbolic_composite"] +
            OUTCOMES + [v for v in ALLVARS if v not in OUTCOMES + CATEGORIES["symbolic"]] +
            ["openness_smooth100", "openness_binmean", "openness_raw_binmean",
             "openness_grate100_binmean", "kde_pop_binmean"])
    e5[cols].round(3).to_csv(f"{OUT}/tab1_epochs_3400_3000.csv")

    # ---- 2/3. correlation matrices on the 5 main epochs ------------------
    v5 = ALLVARS + ["symbolic_composite", "social_composite", "cultural_composite",
                    "economic_composite"] + POLL
    e5[v5].corr("pearson").round(3).to_csv(f"{OUT}/tab_pearson_5epochs.csv")
    e5[v5].corr("spearman").round(3).to_csv(f"{OUT}/tab_spearman_5epochs.csv")

    # ---- 4. sub-period means inside MN -----------------------------------
    keys = CATEGORIES["symbolic"] + ["symbolic_composite"] + OUTCOMES + \
           ["openness_smooth100", "openness_binmean"]
    epc = add_composites(ep)
    early, late = epc.loc[3200:3400], epc.loc[3000:3200]   # 3200 BCE shared border
    sub = pd.DataFrame({"mean_early_3400_3200": early[keys].mean(),
                        "mean_late_3200_3000": late[keys].mean()})
    sub["delta_late_minus_early"] = sub.mean_late_3200_3000 - sub.mean_early_3400_3200
    sub.round(3).to_csv(f"{OUT}/tab3_subperiod_means.csv")
    res["subperiod_means"] = json.loads(sub.round(4).to_json(orient="index"))
    res["subperiod_note"] = ("3200 BCE is the shared border epoch of both sub-periods "
                             "(n=3 each, not independent)")

    # ---- 4b. variability diagnostics: is the symbolic set even informative?
    diag = []
    for v in ALLVARS + ["symbolic_composite", "openness_smooth100",
                        "openness_binmean", "openness_grate100_binmean"]:
        x = e5[v].astype(float)
        diag.append(dict(variable=v, category=("pollen/demography" if category_of(v)
                                               == "pollen/demography" else category_of(v)),
                         min=round(float(x.min()), 4), max=round(float(x.max()), 4),
                         range=round(float(x.max() - x.min()), 4),
                         sd=round(float(x.std(ddof=1)), 4),
                         n_distinct=int(x.round(6).nunique()),
                         informative=bool(x.std(ddof=1) > 1e-9)))
    diag = pd.DataFrame(diag)
    diag.to_csv(f"{OUT}/tab_variability_diagnostics.csv", index=False)
    res["variability_diagnostics"] = json.loads(diag.to_json(orient="records"))

    # openness / KDE trajectory with enough precision (kde values are ~1e-4)
    traj = e5[["openness_smooth100", "openness_binmean", "openness_raw_binmean",
               "openness_grate100_binmean", "kde_pop_binmean", "kde_g_binmean"]].copy()
    traj["kde_pop_binmean"] = traj.kde_pop_binmean.map("{:.4e}".format)
    traj["kde_g_binmean"] = traj.kde_g_binmean.map("{:+.4f}".format)
    traj.to_csv(f"{OUT}/tab_openness_trajectory.csv")

    # ---- 4d. within-window temporal trend of every variable (chronological)
    tt = []
    for v in ALLVARS + ["symbolic_composite", "openness_smooth100", "openness_binmean"]:
        c = corr(-e5.index.values.astype(float), e5[v])   # -BCE = increasing time
        tt.append(dict(variable=v, category=category_of(v),
                       first=e5[v].iloc[0], peak_BCE=int(e5[v].idxmax()),
                       last=e5[v].iloc[-1],
                       trend_rho=None if c["spearman"] is None else round(c["spearman"], 3),
                       trend_r=None if c["pearson"] is None else round(c["pearson"], 3),
                       constant=bool(float(e5[v].astype(float).std(ddof=1)) < 1e-9),
                       direction=sign(c["spearman"])))
    tt = pd.DataFrame(tt).round(3)
    tt.to_csv(f"{OUT}/tab4_within_window_trends.csv", index=False)
    res["within_window_trends"] = json.loads(tt.to_json(orient="records"))

    # ---- 4e. disjoint sub-period variant (3200 excluded from both)
    dsub = pd.DataFrame({
        "mean_3400_3300": epc.loc[3300:3400][keys].mean(),
        "mean_3100_3000": epc.loc[3000:3100][keys].mean()})
    dsub["delta"] = dsub.mean_3100_3000 - dsub.mean_3400_3300
    dsub.round(3).to_csv(f"{OUT}/tab3b_subperiod_means_disjoint.csv")
    res["subperiod_means_disjoint"] = json.loads(dsub.round(4).to_json(orient="index"))

    # ---- 5. cross-correlation with openness ------------------------------
    res["crosscorr_openness"] = {k: v for k, v in crosscorr(ep.loc[3000:3400]).items()}

    # ---- 6. leave-one-out sign stability ---------------------------------
    res["loo_sign_stability"] = loo_sign(
        add_composites(ep.loc[3000:3400]), CATEGORIES["symbolic"] + ["symbolic_composite"] +
        ["openness_binmean", "openness_grate100_binmean", "Depot",
         "economic_composite", "Amber", "PotteryForm", "MonumentSize"])

    # ---- 7. headline numbers actually used to write the hypothesis ---------
    def g(outc, pred, key="pearson_levels"):
        rows = res["correlations"][f"{outc}|all|main_3400_3000_inclusive"]
        return next(r[key] for r in rows if r["predictor"] == pred)

    hl = dict(
        symbolic_zero_variance_in_window=[v for v in CATEGORIES["symbolic"]
                                          if float(e5[v].std(ddof=1)) < 1e-9],
        symbolic_near_flat_range={v: round(float(e5[v].max() - e5[v].min()), 4)
                                  for v in CATEGORIES["symbolic"]},
        outcome=OUTCOMES,
        MonumentCount=dict(
            HouseSize_r=round(g("MonumentCount", "HouseSize"), 3),
            HouseSize_rho=round(g("MonumentCount", "HouseSize", "spearman_levels"), 3),
            symbolic_composite_r=round(g("MonumentCount", "symbolic_composite"), 3),
            Depot_r=round(g("MonumentCount", "Depot"), 3),
            economic_composite_r=round(g("MonumentCount", "economic_composite"), 3),
            openness_binmean_r=round(g("MonumentCount", "openness_binmean"), 3),
            peak_BCE=int(e5.MonumentCount.idxmax())),
        AxesCelts=dict(
            HouseSize_r=round(g("AxesCelts", "HouseSize"), 3),
            HouseSize_rho=round(g("AxesCelts", "HouseSize", "spearman_levels"), 3),
            symbolic_composite_r=round(g("AxesCelts", "symbolic_composite"), 3),
            Depot_r=round(g("AxesCelts", "Depot"), 3),
            MonumentCount_r=round(g("AxesCelts", "MonumentCount"), 3),
            openness_binmean_r=round(g("AxesCelts", "openness_binmean"), 3),
            peak_BCE=int(e5.AxesCelts.idxmax())),
        confounding=dict(
            HouseSize_vs_openness_r=round(float(
                pearsonr(e5.HouseSize, e5.openness_binmean)[0]), 3),
            HouseSize_vs_openness_rho=round(float(
                spearmanr(e5.HouseSize, e5.openness_binmean)[0]), 3),
            openness_trend="monotonic decline 3400->3000 BCE "
                           f"({e5.openness_binmean.iloc[0]:.2f} -> "
                           f"{e5.openness_binmean.iloc[-1]:.2f})"),
        lag_note="lag correlations at +/-200 yrs have n=3: descriptive only",
        subperiod_shared={k: [round(sub.loc[k].mean_early_3400_3200, 3),
                              round(sub.loc[k].mean_late_3200_3000, 3)]
                          for k in ["symbolic_composite", "MonumentCount",
                                    "AxesCelts", "openness_binmean"]},
    )
    res["headline"] = hl

    with open(f"{OUT}/results_summary.json", "w") as fh:
        json.dump(res, fh, indent=1)

    pd.set_option("display.width", 220)
    print("QC:", qc)
    print("\n=== 1. Epochs 3400-3000 BCE (Z-values, n=5, period=%s) ===" %
          ",".join(sorted(set(e5.period))))
    print(e5[cols].round(3).to_string())
    for outc in OUTCOMES:
        d = pd.DataFrame(res["correlations"][f"{outc}|all|main_3400_3000_inclusive"])
        print(f"\n=== 2/3. {outc} ({category_of(outc)}) vs everything, n="
              f"{d.n_levels.iloc[0]} levels / {d.n_diff.iloc[0]} diffs ===")
        print(d[["category", "predictor", "pearson_levels", "spearman_levels",
                 "pearson_diff", "spearman_diff", "sign_levels", "sign_diff"]]
              .round(3).to_string(index=False))
    print("\n=== 4. Sub-period means (3200 shared) ===")
    print(sub.round(3).to_string())
    print("\n=== 4b. Variability diagnostics inside 3400-3000 BCE (n=5) ===")
    print(diag.to_string(index=False))
    print("\n=== 4c. Openness / population-proxy trajectory ===")
    print(traj.to_string())
    print("\n=== 4d. Within-window trend (Spearman vs time; + = increasing 3400->3000) ===")
    print(tt.to_string(index=False))
    print("\n=== 4e. Disjoint sub-periods (3400-3300 vs 3100-3000, 3200 dropped) ===")
    print(dsub.round(3).to_string())
    print("\n=== 5. Openness cross-correlation (lags in years) ===")
    for k, v in res["crosscorr_openness"].items():
        r = None if v["pearson"] is None else round(v["pearson"], 3)
        rho = None if v["spearman"] is None else round(v["spearman"], 3)
        print(f"  {k:56s} n={v['n']} r={r} rho={rho}")
    print("\n=== Sensitivity: n=11 (3800-2800) and n=4 (open border) ===")
    for outc in OUTCOMES:
        for wname in ["sens_3800_2800", "sens_4int_open_border"]:
            d = pd.DataFrame(res["correlations"][f"{outc}|symbolic|{wname}"])
            print(f"\n-- {outc} | {wname} (n={d.n_levels.iloc[0]}) --")
            print(d[["predictor", "pearson_levels", "spearman_levels",
                     "pearson_diff", "sign_levels"]].round(3).to_string(index=False))
    print("\n=== 7. HEADLINE ===")
    print(json.dumps(hl, indent=1))
    print("\n=== Leave-one-epoch-out sign stability (main window) ===")
    for k, v in res["loo_sign_stability"].items():
        print(f"  {k:44s} stable={v['sign_stable']} (+{v['plus']}/-{v['minus']})")


if __name__ == "__main__":
    main()
