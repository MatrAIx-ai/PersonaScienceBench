"""
Divergent growth trends of Diversity in Pottery Form vs Diversity in Pottery Decoration.
DiscoveryBench episode: identify the century where Decoration increases SIGNIFICANTLY
while Form DECLINES, for the FIRST time in chronological order.

Approved protocol:
  - Authorized series: PotteryForm_inter / PotteryDecoration_inter (raw used as anchor validation)
  - 100-year bins; bin labelled by its target anchor year (e.g. 1700 BCE bin = 17th c. BCE)
  - "Significant": |dZ| >= 0.5  AND  |dZ| >= P75 of the historical |dZ| distribution of that series
  - "Increasing/declining": strict sign requirement (dD > 0, dF < 0)
  - "For the first time": full chronological scan -4100 -> -500 CE
"""
import numpy as np
import pandas as pd

pd.set_option("display.width", 220)

TS = "data/time_series_data.csv"
CAP = "data/capital.csv"

FORM, FORM_I = "PotteryForm", "PotteryForm_inter"
DEC,  DEC_I  = "PotteryDecoration", "PotteryDecoration_inter"

ABS_THR = 0.5   # absolute |dZ| threshold in standardised Z units
Q_THR   = 75    # percentile of the series' own historical |dZ| distribution

df = pd.read_csv(TS, index_col=0)

print("=" * 78)
print("1) DATA STRUCTURE")
print("=" * 78)
print(f"rows={len(df)}  cols={df.shape[1]}")
print(f"CE range: {df.CE.min()} .. {df.CE.max()}   calBP range: {df.calBP.min()} .. {df.calBP.max()}")
print(f"calBP == 1950 - CE for all rows: {bool(np.allclose(df.calBP, 1950 - df.CE))}")
print(f"annual grid (all CE diffs == 1): {bool((df.CE.diff().dropna() == 1).all())}")
for c in [FORM, FORM_I, DEC, DEC_I]:
    print(f"  {c:24s} non-null={df[c].notna().sum():5d} null={df[c].isna().sum():5d} "
          f"min={df[c].min():.2f} max={df[c].max():.2f}")

anchors = df[df[FORM].notna()].copy()
print(f"\nraw anchors: n={len(anchors)}, spacing years={np.diff(anchors.CE).min()}-{np.diff(anchors.CE).max()}, "
      f"all at century starts: {bool((anchors.CE % 100 == 0).all())}")
print("interpolated == raw at anchors (Form): "
      f"{bool(np.allclose(df.loc[anchors.index, FORM_I], anchors[FORM]))}, "
      f"Decoration: {bool(np.allclose(df.loc[anchors.index, DEC_I], anchors[DEC]))}")

# cross-validation vs capital.csv (source table, comma decimals, BCE positive)
cap = pd.read_csv(CAP)
cap.columns = [c.strip() for c in cap.columns]
for c in ["ZKeform", "Zkeverz"]:
    cap[c] = cap[c].astype(str).str.replace(",", ".").astype(float)
cap["CE"] = -cap["BCE"]
xv = anchors[["CE", FORM, DEC]].merge(cap[["CE", "ZKeform", "Zkeverz"]], on="CE", how="inner")
print(f"capital.csv cross-validation: {len(xv)} common anchors, "
      f"Form match={int(np.isclose(xv[FORM], xv.ZKeform).sum())}, "
      f"Decoration match={int(np.isclose(xv[DEC], xv.Zkeverz).sum())}")

print()
print("=" * 78)
print("2) BINS AND CHANGE DETECTION (authorized = _inter, 100-year bins)")
print("=" * 78)
# Authorized interpolated series sampled at the 100-year bin anchors.
b = df[[ "CE", FORM_I, DEC_I]].copy()
b["bin_century"] = b.CE          # anchor year (CE, negative = BCE)
bin_series = b[b.CE.isin(anchors.CE)].reset_index(drop=True)

# Within a bin, the linear interpolation makes net change == local slope == growth rate.
# Demonstrate the equivalence explicitly.
sub = df[(df.CE >= -1800) & (df.CE <= -1700)].copy()
sub["g"] = sub[DEC_I].pct_change() * 100  # per-century growth rate proxy
slope_inter = np.polyfit(sub.CE, sub[DEC_I], 1)[0] * 100      # per-century slope
net_change  = sub[DEC_I].iloc[-1] - sub[DEC_I].iloc[0]
print(f"Equivalence check on interpolation (1800->1700 BCE bin, Decoration): "
      f"net change={net_change:+.4f}  OLS per-century slope={slope_inter:+.4f}  -> identical: "
      f"{bool(np.isclose(net_change, slope_inter, atol=1e-9))}")

t = bin_series.copy()
t["BCE"] = -t.CE
t["dF"] = t[FORM_I].diff()
t["dD"] = t[DEC_I].diff()

# Reference distributions (historical |dZ| of the series itself)
dF_all = t.dF.dropna()
dD_all = t.dD.dropna()
p75_F = np.percentile(np.abs(dF_all), Q_THR)
p75_D = np.percentile(np.abs(dD_all), Q_THR)
med_F = np.percentile(np.abs(dF_all), 50)
med_D = np.percentile(np.abs(dD_all), 50)
print(f"\nHistorical |dZ| distribution over {len(dF_all)} bin-to-bin transitions:")
print(f"  Pottery Form      : median={med_F:.3f}  P75={p75_F:.3f}  max={np.abs(dF_all).max():.3f}")
print(f"  Pottery Decoration: median={med_D:.3f}  P75={p75_D:.3f}  max={np.abs(dD_all).max():.3f}")
print(f"  Threshold rule applied: |dZ| >= {ABS_THR} AND |dZ| >= P{Q_THR} "
      f"(Form: >= {max(ABS_THR, p75_F):.3f}; Decoration: >= {max(ABS_THR, p75_D):.3f})")

t["D_sig_up"]  = (t.dD > 0) & (t.dD.abs() >= ABS_THR) & (t.dD.abs() >= p75_D)
t["F_decline"] = (t.dF < 0)
t["F_sig_dn"]  = (t.dF < 0) & (t.dF.abs() >= ABS_THR) & (t.dF.abs() >= p75_F)
t["divergent_target"] = t.D_sig_up & t.F_decline
t["pctile_dD"] = [ (np.abs(dD_all) < abs(v)).mean() * 100 if not np.isnan(v) else np.nan for v in t.dD ]
t["pctile_dF"] = [ (np.abs(dF_all) < abs(v)).mean() * 100 if not np.isnan(v) else np.nan for v in t.dF ]

print()
print("=" * 78)
print("3) FULL CHRONOLOGICAL SCAN  (-4100 CE -> -500 CE)")
print("=" * 78)
cols = ["BCE", FORM_I, DEC_I, "dF", "dD", "D_sig_up", "F_decline", "divergent_target"]
print(t[cols].round(3).to_string(index=False))

print()
print("All discordant transitions (D up & F not up, OR F down & D not down):")
disc = t[((t.dD > 0) & (t.dF <= 0)) | ((t.dF < 0) & (t.dD <= 0))]
for _, r in disc.iterrows():
    print(f"  {int(r.BCE):>5d} BCE : dD={r.dD:+.2f} (P{r.pctile_dD:4.1f} of |dD|) D_sig_up={r.D_sig_up}; "
          f"dF={r.dF:+.2f} (P{r.pctile_dF:4.1f} of |dF|) F_decline={r.F_decline}; "
          f">>> TARGET={r.divergent_target}")

hits = t[t.divergent_target]
print(f"\nBins satisfying 'Decoration significantly up AND Form declining': "
      f"{[str(int(x)) + ' BCE' for x in hits.BCE]}")
first = hits.iloc[0]
print(f"FIRST (earliest in chronological order): {int(first.BCE)} BCE bin "
      f"(= {int(first.BCE)//100}th century BCE, c. {int(first.BCE)}-{int(first.BCE)-99} BCE)")
print(f"  dD = {first.dD:+.2f} (>= {max(ABS_THR,p75_D):.3f}; percentile {first.pctile_dD:.1f}) -> Decoration SIG. INCREASE")
print(f"  dF = {first.dF:+.2f} (>= {max(ABS_THR,p75_F):.3f}; percentile {first.pctile_dF:.1f}) -> Form DECLINE")
print(f"  Form {bin_series.loc[first.name-1, FORM_I]:+.2f} -> {first[FORM_I]:+.2f}; "
      f"Decoration {bin_series.loc[first.name-1, DEC_I]:+.2f} -> {first[DEC_I]:+.2f}")

# Strictest variant (also require significant Form decline)
hits_strict = t[t.D_sig_up & t.F_sig_dn]
print(f"Strictest variant (both changes significant): "
      f"{[str(int(x)) + ' BCE' for x in hits_strict.BCE]}  -> same first bin: "
      f"{int(hits_strict.iloc[0].BCE) == int(first.BCE)}")

# Sensitivity to threshold
print("\nSensitivity of the first-hit bin to the absolute threshold:")
for thr in [0.0, 0.1, 0.25, 0.5, 1.0, 1.4]:
    h = t[(t.dD > 0) & (t.dD.abs() >= thr) & (t.dF < 0)]
    print(f"  |dZ| >= {thr:>4.2f} -> first bin: "
          f"{str(int(h.iloc[0].BCE)) + ' BCE' if len(h) else 'none'}")

print()
print("=" * 78)
print("4) NARRATIVE SUPPORT (descriptive, non-causal)")
print("=" * 78)
cm = df[[FORM_I, DEC_I, "pollen_inter"]].corr()
print(f"Pearson r (interpolated, full span): Form vs Decoration = {cm.loc[FORM_I, DEC_I]:+.2f}; "
      f"Decoration vs pollen openness = {cm.loc[DEC_I, 'pollen_inter']:+.2f}; "
      f"Form vs pollen = {cm.loc[FORM_I, 'pollen_inter']:+.2f}")

print("\nLate plateaus (aggregation artefacts, NOT behavioural evidence):")
plateau = t[(t.dF == 0) & (t.dD == 0)]
print(f"  bins with zero change in both series: n={len(plateau)} "
      f"({int(plateau.BCE.min())}-{int(plateau.BCE.max())} BCE), "
      f"raw values constant Form=-1.13 / Decoration 0.97 then 1.53")
print(f"  distinct raw Form values 1700-500 BCE: {sorted(set(anchors.loc[anchors.CE >= -1700, FORM]))}; "
      f"Decoration: {sorted(set(anchors.loc[anchors.CE >= -1700, DEC]))}")

out = "pottery_divergence_table.csv"
t[["BCE", FORM_I, DEC_I, "dF", "dD", "pctile_dF", "pctile_dD",
   "D_sig_up", "F_decline", "F_sig_dn", "divergent_target"]].round(4).to_csv(out, index=False)
print(f"\nWrote {out}")
