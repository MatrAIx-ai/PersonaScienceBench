"""
Amber peak analysis: in which millennium was amber's (standardized) archaeological
value highest, and in what time interval did it peak?

Primary series  : raw century-bin Z values ('Amber' in time_series_data.csv,
                  identical to 'Zamber' in capital.csv) -> 37 bins, 4100-500 BCE.
Sensitivity set : capital.csv full table (39 bins, adds 4300 & 4200 BCE).
Control         : 'Amber_inter' (linear interpolation of the same 37 anchors) must
                  reproduce the same argmax.

DECLARED LIMITATION: the Z values are standardized indices of archaeological
visibility / find intensity, NOT direct economic value. Reading them as "value"
is an explicit proxy inference, not an established fact.
"""
import numpy as np
import pandas as pd

OUT = "outputs"

# ---------------------------------------------------------------- load + merge
ts = pd.read_csv("data/time_series_data.csv")
cap = pd.read_csv("data/capital.csv", decimal=",")

print("== VALIDACION DE INSUMOS ==")
print(f"time_series_data.csv: {ts.shape}, CE {ts.CE.min()}..{ts.CE.max()}, "
      f"calBP {ts.calBP.min()}..{ts.calBP.max()}, CE+calBP==1950: {((ts.CE+ts.calBP)==1950).all()}")
print(f"capital.csv        : {cap.shape}, BCE {cap.BCE.min()}..{cap.BCE.max()}, "
      f"Zamber no-null {cap.Zamber.notna().sum()}/{len(cap)}")

raw = ts[ts.Amber.notna()][["CE", "calBP", "Amber"]].copy()
raw["BCE"] = -raw.CE
chk = cap[["BCE", "group", "Zamber"]].merge(raw, on="BCE", how="outer", indicator=True)
print(f"merge capital<->time_series: coincidentes={int((chk._merge=='both').sum())}, "
      f"max|Zamber-Amber|={np.nanmax(np.abs(chk.Zamber-chk.Amber)):.6f}, "
      f"solo capital={sorted(chk.loc[chk._merge=='left_only','BCE'].tolist())}")

# ------------------------------------------------- series: bins seculares crudos
prim = raw.sort_values("BCE", ascending=False).reset_index(drop=True)
sens = cap.sort_values("BCE", ascending=False)[["BCE", "group", "Zamber"]].rename(
    columns={"Zamber": "Z"}).reset_index(drop=True)
prim["Z"] = prim["Amber"]
prim = prim.merge(cap[["BCE", "group"]], on="BCE", how="left")

# calendar convention (declared): a bin labelled b BCE covers b .. b-99 BCE and
# belongs to millennium floor((b-1)/1000)+1 BCE  ->  4000-3001 BCE = IV mil. BCE
def millennium_bce(b):
    return int((b - 1) // 1000) + 1

ROM = {1:"I",2:"II",3:"III",4:"IV",5:"V"}
for df in (prim, sens):
    df["millennium_BCE"] = df.BCE.map(millennium_bce)
    df["mil_label"] = "mil " + df.millennium_BCE.map(ROM) + " BCE"
    # bin interval covered (older -> younger edge)
    df["bin_from_BCE"] = df.BCE
    df["bin_to_BCE"] = df.BCE - 99
    df["calBP_from"] = 1950 + df.BCE          # older edge
    df["calBP_to"] = 1950 + df.BCE - 99       # younger edge

# ------------------------------------------------------- Z por milenio (media/y max)
def per_millennium(df):
    g = df.groupby(["millennium_BCE", "mil_label"])["Z"].agg(
        n_bins="count", mean_Z="mean", max_Z="max", min_Z="min")
    return g.round(3).reset_index()

mill_prim, mill_sens = per_millennium(prim), per_millennium(sens)
print("\n== Z POR MILENIO (serie primaria, 37 bins 4100-500 BCE) ==")
print(mill_prim.to_string(index=False))
print("\n== Z POR MILENIO (sensibilidad, 39 bins capital.csv, +4300/+4200 BCE) ==")
print(mill_sens.to_string(index=False))

best_mean = mill_prim.loc[mill_prim.mean_Z.idxmax()]
max_tied  = mill_prim[np.isclose(mill_prim.max_Z, mill_prim.max_Z.max())]
sens_mean = mill_sens.loc[mill_sens.mean_Z.idxmax()]
sens_max_tied = mill_sens[np.isclose(mill_sens.max_Z, mill_sens.max_Z.max())]
print(f"\nmilenio por MEDIA   (primaria): {best_mean.mil_label}  mean_Z={best_mean.mean_Z}")
print("milenio(s) por MAXIMO (primaria): " + ", ".join(max_tied.mil_label) +
      f"  (Z max = {max_tied.max_Z.iloc[0]}) -> EMPATE en la frontera IV/III: "
      "los bins 3300/3200/3100 BCE son IV mil. BCE y el bin 3000 BCE es III mil. BCE "
      "por la convencion declarada")
print(f"sensibilidad (39 bins): media->{sens_mean.mil_label} (mean_Z={sens_mean.mean_Z}), "
      f"max->{', '.join(sens_max_tied.mil_label)} (empate de frontera, igual que primaria)")

# ------------------------------------------------------- argmax + mesetas umbral
z = prim.Z.values
zmax = z.max()
tied = prim[np.isclose(prim.Z, zmax)]
print("\n== ARGMAX (bins seculares con Z == max) ==")
print(tied[["BCE","bin_from_BCE","bin_to_BCE","calBP_from","calBP_to","group","Z"]].to_string(index=False))
print(f"Z_max = {zmax}; primer bin del argmax = {int(tied.BCE.max())} BCE; "
      f"run contigua de empates: {int(tied.BCE.max())}-{int(tied.BCE.min())} BCE "
      f"(contigua: {len(tied)==(tied.BCE.max()-tied.BCE.min())//100+1})")

med, q1, q3 = np.median(z), np.percentile(z,25), np.percentile(z,75)
thresholds = {
    "0.9*max":       0.9 * zmax,
    "mean+1sd":      z.mean() + z.std(ddof=1),
    "median+IQR":    med + (q3 - q1),
    "median+0.5*IQR (suplente)": med + 0.5 * (q3 - q1),
}
print(f"\nestadisticos n={len(z)}: mean={z.mean():.3f} sd={z.std(ddof=1):.3f} "
      f"median={med:.3f} IQR={q3-q1:.3f} max={zmax}")

def longest_run_above(df, thr):
    """longest contiguous run of century bins with Z >= thr (contiguous in BCE)."""
    sel = df[df.Z >= thr].sort_values("BCE", ascending=False).reset_index(drop=True)
    if sel.empty:
        return None, 0, 0
    sel["run"] = (sel.BCE.diff() != -100).cumsum()
    sizes = sel.groupby("run").size()
    rid = sizes.idxmax()
    best = sel[sel.run == rid]
    return best, len(sel), sel.run.nunique()

rows = []
for name, thr in thresholds.items():
    best, n_sel, n_runs = longest_run_above(prim, thr)
    if best is None:
        rows.append(dict(threshold=name, thr_value=round(thr, 3), n_bins_above_thr=0,
                         n_contiguous_runs=0, n_bins_in_peak_run=0,
                         peak_from_BCE=np.nan, peak_to_BCE=np.nan, width_years=0,
                         peak_from_calBP=np.nan, peak_to_calBP=np.nan,
                         groups="-", millennia="-", mean_Z_in_run=np.nan,
                         note="umbral por encima de Z_max -> sin excedencia"))
        continue
    bf, bt = int(best.BCE.iloc[0]), int(best.BCE.iloc[-1])
    rows.append(dict(threshold=name, thr_value=round(thr, 3), n_bins_above_thr=n_sel,
                     n_contiguous_runs=n_runs, n_bins_in_peak_run=len(best),
                     peak_from_BCE=bf, peak_to_BCE=bt, width_years=(bf - bt) + 100,
                     peak_from_calBP=1950 + bf, peak_to_calBP=1950 + bt - 99,
                     groups="+".join(sorted(set(best.group))),
                     millennia="+".join(sorted(set(best.mil_label))),
                     mean_Z_in_run=round(float(best.Z.mean()), 3), note=""))

peak_tbl = pd.DataFrame(rows)
print("\n== VENTANAS DE PICO (rachas contiguas sobre umbral) ==")
print(peak_tbl.to_string(index=False))

# ----------------------------------------------------- control: Amber_inter anual
inter = ts[["CE","calBP","Amber_inter"]].copy()
inter["BCE"] = -inter.CE
i_anchors = inter.loc[np.isclose(inter.Amber_inter, zmax)]
print("\n== CONTROL Amber_inter (rejilla anual interpolada) ==")
print(f"max(Amber_inter)={inter.Amber_inter.max():.4f} vs max(Amber)={zmax}; "
      f"primer ano en alcanzar el max: {int(i_anchors.BCE.max())} BCE "
      f"(misma meseta: {int(i_anchors.BCE.max())}-{int(i_anchors.BCE.min())} BCE)")
binmax = inter.assign(bin=inter.BCE//100*100).groupby("bin").Amber_inter.max()
print(f"argmax por siglo sobre Amber_inter coincide con el de los bins crudos: "
      f"{np.isclose(binmax.max(), zmax).all()} ")

# -------------------------------------- chequeo de confuso: intensidad global kde
kde = ts.dropna(subset=["Amber"])[["CE","kde_all_mean"]].assign(BCE=lambda d: -d.CE)
kde = kde.merge(prim[["BCE","Z"]], on="BCE")
in_run = kde[kde.BCE.between(peak_tbl.peak_to_BCE[0], peak_tbl.peak_from_BCE[0])]
print("\n== CHEQUEO DE CONFUSO (kde_all_mean = intensidad general del registro) ==")
print(f"corr(Pearson, 37 bins) Amber vs kde_all_mean = {np.corrcoef(kde.Z, kde.kde_all_mean)[0,1]:.3f}; "
      f"percentil medio del kde en la meseta de pico = "
      f"{(kde.kde_all_mean < in_run.kde_all_mean.mean()).mean()*100:.0f}")

# ---------------------------------------------------------------- cultural EN/MN
print("\n== MARCO CULTURAL (grupos de capital.csv) ==")
print(cap.groupby("group").BCE.agg(["min","max","count"]).to_string())
print("\nmeseta de pico por grupo:")
run_tbl = prim[(prim.BCE<=peak_tbl.peak_from_BCE[0]) & (prim.BCE>=peak_tbl.peak_to_BCE[0])]
print(run_tbl.groupby("group").Z.agg(["count","mean","max"]).round(3).to_string())

# ---------------------------------------------------------------------- guardar
prim.to_csv(f"{OUT}/amber_century_bins.csv", index=False)
mill_prim.to_csv(f"{OUT}/amber_by_millennium_primary.csv", index=False)
mill_sens.to_csv(f"{OUT}/amber_by_millennium_sensitivity39.csv", index=False)
peak_tbl.to_csv(f"{OUT}/amber_peak_windows.csv", index=False)
print(f"\nTablas guardadas en {OUT}/")

# ---------- diagnostico adicional: z-score del kde general por milenio ----------
kdm = ts[["CE", "kde_all_mean"]].assign(BCE=lambda d: -d.CE)
kdm["kde_z"] = (kdm.kde_all_mean - kdm.kde_all_mean.mean()) / kdm.kde_all_mean.std(ddof=1)
kdm["millennium_BCE"] = kdm.BCE.map(millennium_bce)
kdm = kdm.dropna(subset=["kde_z"])
amber_z = prim.groupby("millennium_BCE").Z.mean()
kde_z = kdm.groupby("millennium_BCE").kde_z.mean()
cmp_tbl = pd.DataFrame({"amber_mean_Z": amber_z, "kde_mean_Z": kde_z.round(3),
                        "amber_minus_kde": (amber_z - kde_z).round(3)}).round(3)
cmp_tbl.index.name = "millennium_BCE"
print("\n== AMBAR vs INTENSIDAD GENERAL DEL REGISTRO (ambos en Z) por milenio ==")
print(cmp_tbl.to_string())
cmp_tbl.to_csv(f"{OUT}/amber_vs_kde_by_millennium.csv")

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(1, 2, figsize=(13, 4.5))
    ax[0].plot(prim.BCE, prim.Z, "o-", color="darkgoldenrod", label="Amber (Z, bins de 100 anos)")
    ax[0].plot(-ts.CE, ts.Amber_inter, "-", lw=.8, color="grey", alpha=.7, label="Amber_inter (interp.)")
    thr = thresholds["0.9*max"]
    ax[0].axhline(thr, ls="--", color="crimson", label=f"umbral 0.9*max = {thr:.2f}")
    ax[0].axvspan(4000, 3000, color="gold", alpha=.18, label="meseta de pico 4000-3000 BCE")
    ax[0].axvline(3500, ls=":", color="k", label="frontera EN/MN (~3500/3400 BCE)")
    ax[0].invert_xaxis(); ax[0].set_xlabel("BCE"); ax[0].set_ylabel("Z")
    ax[0].set_title("Amber: Z por bin secular (n=37)"); ax[0].legend(fontsize=7)
    cmp_tbl[["amber_mean_Z", "kde_mean_Z"]].plot(marker="o", ax=ax[1])
    ax[1].invert_xaxis(); ax[1].set_xlabel("milenio BCE"); ax[1].set_ylabel("Z medio")
    ax[1].set_title("Ambar vs intensidad general del registro (kde)")
    fig.tight_layout(); fig.savefig(f"{OUT}/amber_peak.png", dpi=140)
    print(f"figura guardada en {OUT}/amber_peak.png")
except Exception as e:      # la figura es opcional, no bloquea el resultado
    print("figura omitida:", e)
