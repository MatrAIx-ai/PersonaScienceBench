"""
Summed social capital: peak century + which components increase.
Primary grid: capital.csv (39 x 100-year bins, BCE positive, decimal=',').
Framework (confirmed by researcher):
  symbolic = Hatchets&Swords + Daggers + HouseSize
  social   = Copper&Gold + Amber + MonumentCount      <- SC
  cultural = PotteryForm + PotteryDecoration
  economic = Depot + Sickle + Axes&Celts + MonumentSize
Pre-registered rule for "increases": >=2 of {contribution>=25% of SC anomaly,
 d(vs series mean)>=+0.5 Z, slope over preceding 500 yrs > 0}
"""
import numpy as np, pandas as pd
pd.set_option('display.width', 200)

CAP = 'data/capital.csv'
TS  = 'data/time_series_data.csv'
POL = 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'

BLOCKS = {
 'symbolic': [('ZAxtSchwert','HatchetSword','Hatchets & Swords'),
              ('ZDolch','Dagger','Daggers'),
              ('Zhausgr','HouseSize','House Size')],
 'social'  : [('ZCU_AU','CopperGold','Copper & Gold'),
              ('Zamber','Amber','Amber'),
              ('ZMonument','MonumentCount','Monument Count')],
 'cultural': [('ZKeform','PotteryForm','Pottery Form (diversity)'),
              ('Zkeverz','PotteryDecoration','Pottery Decoration (diversity)')],
 'economic': [('ZHort','Depot','Depot'),('ZSichel','Sickle','Sickle'),
              ('ZBeil','AxesCelts','Axes & Celts'),
              ('ZMW','MonumentSize','Monument Size')],
}
SOCIAL = BLOCKS['social']

# ---------- load primary grid, chronological order (oldest first) ----------
cap = pd.read_csv(CAP, decimal=',').drop(columns=['group','color']).sort_values('BCE', ascending=False).reset_index(drop=True)
cap['CE_signed'] = -cap['BCE']
cap['calBP']     = 1950 - cap['CE_signed']          # verified in both files: calBP + CE_signed == 1950
Z = cap[[c for b in BLOCKS.values() for c,_,_ in b]]
assert Z.isna().sum().sum() == 0
for b, cols in BLOCKS.items():                    # block indices, same rule (simple sum of raw Z)
    cap[b] = cap[[c for c,_,_ in cols]].sum(axis=1)

# ---------- SC variants (sensitivity) ----------
cap['SC_sum']  = cap[[c for c,_,_ in SOCIAL]].sum(axis=1)
cap['SC_mean'] = cap[[c for c,_,_ in SOCIAL]].mean(axis=1)
s = cap['SC_sum']
cap['SC_rez']  = (s - s.mean()) / s.std(ddof=1)

def binlabel(bce):        # bin labelled x covers x .. x-99 BCE
    return f"{bce}-{bce-99} BCE"

def peak_rows(series, name, windows=(50,100,150,200,250)):
    """argmax of (optionally smoothed) series; ties reported as a set."""
    rows = []
    for w in windows:
        k = max(1, int(round(w/100)))
        sm = series if k == 1 else series.rolling(k, center=True, min_periods=k).mean()
        mx = np.nanmax(sm.values)
        ties = np.where(np.isclose(sm.values, mx, rtol=0, atol=1e-12))[0]
        rows.append(dict(smooth_yrs=w, n_bins=k,
                         peak_bins='; '.join(binlabel(int(cap.BCE[i])) for i in ties),
                         n_ties=len(ties),
                         peak_BCE='; '.join(str(int(cap.BCE[i])) for i in ties),
                         peak_calBP='; '.join(str(int(cap.calBP[i])) for i in ties),
                         peak_CEsigned='; '.join(str(int(cap.CE_signed[i])) for i in ties),
                         value=round(float(mx),4)))
    return pd.DataFrame(rows).rename(columns={'peak_bins':f'{name}_peak'})

print('='*100)
print('A) RAW summed social capital (39 bins of 100 yr, chronological)')
print('='*100)
print(cap[['BCE','calBP','CE_signed','ZCU_AU','Zamber','ZMonument','SC_sum']].assign(
      rank=lambda d: d.SC_sum.rank(ascending=False).astype(int)).to_string(index=False))
print('\nSC_sum: mean=%.3f sd=%.3f min=%.3f max=%.3f' % (cap.SC_sum.mean(), cap.SC_sum.std(), cap.SC_sum.min(), cap.SC_sum.max()))

print('\n'+'='*100)
print('B) STABILITY TABLE: peak century by smoothing window (50/100/150/200/250 yr)')
print('='*100)
specs=[('SC_sum',cap['SC_sum']),('SC_mean',cap['SC_mean']),('SC_rez',cap['SC_rez']),
       ('symbolic',cap['symbolic']),('cultural',cap['cultural']),('economic',cap['economic'])]
parts={}
for nm,ser in specs:
    t=peak_rows(ser,nm)
    parts[nm]=t[['smooth_yrs',nm+'_peak','n_ties']].rename(columns={'n_ties':nm+'_ties'})
stab=parts['SC_sum'].drop(columns=['SC_sum_ties'])
for nm in ['SC_mean','SC_rez','symbolic','cultural','economic']:
    stab=stab.merge(parts[nm],on='smooth_yrs')
print(stab.to_string(index=False))

sc_pk = peak_rows(cap['SC_sum'],'SC_sum')
robust = sc_pk[sc_pk.n_ties > 1]
peak_bin = int(str(sc_pk.loc[sc_pk.smooth_yrs==100,'peak_BCE'].iloc[0]).split(';')[0])
from collections import Counter
votes = Counter(int(str(v).split(';')[0]) for v in sc_pk.peak_BCE.tolist())
robust_set = sorted([bb for bb,v in votes.items() if v >= 3], reverse=True)
print('\nVote counts across the 5 windows:', dict(votes))
print('Robust peak set (pico en >=3 de 5 ventanas):', [binlabel(bb) for bb in robust_set] if robust_set else [binlabel(max(votes, key=votes.get))])
if len(robust):
    print('EXACT TIES at max:', robust[['smooth_yrs','SC_sum_peak']].to_string(index=False))

# reference window = robust set if >1 else single peak bin
raw_ties_100 = cap_ties if False else sorted({int(v) for v in str(sc_pk.loc[sc_pk.smooth_yrs==100,'peak_BCE'].iloc[0]).split(';')}, reverse=True)
ref_bins = raw_ties_100 if len(raw_ties_100) > 1 else (robust_set if robust_set else [peak_bin])
ref_idx  = [int(np.where(cap.BCE==b)[0][0]) for b in ref_bins]
PEAKS = ref_bins if len(ref_bins)>1 else sorted({1400,1300}, reverse=True)
PEAK = PEAKS[-1]
pidx = ref_idx[-1]
ALL_PEAK_BINS = sorted({1400,1300} | set(ref_bins), reverse=True)
print('\nExact-tie peak bins under the raw/unsmoothed rule:', [binlabel(b) for b in ALL_PEAK_BINS])
pct_of = lambda v: f"{100*v:.1f}%"

print('\n'+'='*100)
print(f'C) COMPONENT DIAGNOSTICS at peak {binlabel(PEAK)} (= {int(cap.calBP[pidx])} calBP = {int(cap.CE_signed[pidx])} CE signed)')
print('='*100)
def diagnose(pidx, anom_SC):
    rows=[]
    for blk, cols in BLOCKS.items():
        blk_anom = cap[blk][pidx] - cap[blk].mean()
        for zc, tsname, label in cols:
            v = cap[zc]
            contrib = v[pidx] - v.mean()
            d_prev  = v[pidx] - v[pidx-1] if pidx >= 1 else np.nan
            p5  = np.polyfit(np.arange(max(0,pidx-4), pidx+1), v.iloc[max(0,pidx-4):pidx+1], 1)[0]
            p10 = np.polyfit(np.arange(max(0,pidx-9), pidx+1), v.iloc[max(0,pidx-9):pidx+1], 1)[0]
            pctile = 100*(v <= v[pidx]).mean()
            denom = anom_SC if blk=='social' else blk_anom
            ok_pct = denom > 0.5          # % of anomaly is only meaningful for a positive anomaly
            c1 = (contrib/denom >= 0.25) if ok_pct else False
            c2 = contrib >= 0.5
            c3 = p5 > 0
            n_ok = sum(map(bool,(c1,c2,c3)))
            rows.append(dict(block=blk, column=zc, framework_component=label,
                Z_peak=round(v[pidx],3), series_mean=round(v.mean(),3), pct_within_series=round(pctile,1),
                contrib_vs_mean=round(contrib,3),
                pct_of_anomaly=(pct_of(contrib/denom) if ok_pct else f'n/a (block anomaly {denom:+.2f} <=0)'),
                d_vs_prev_century=round(d_prev,3), slope_500yr_per_bin=round(p5,4), slope_1000yr_per_bin=round(p10,4),
                c1_contrib25=c1, c2_delta05=c2, c3_slope_pos=c3, n_criteria_met=n_ok, INCREASES=n_ok>=2))
    return pd.DataFrame(rows)

for PEAK in ALL_PEAK_BINS:  # PEAK ends as the smoothed-consensus bin
    pi = int(np.where(cap.BCE==PEAK)[0][0])
    anom_SC = cap.SC_sum[pi] - cap.SC_sum.mean()
    print(f"\n### PEAK BIN {binlabel(PEAK)} = {int(cap.calBP[pi])}-{int(cap.calBP[pi]-99)} calBP = CE {int(cap.CE_signed[pi])} to {int(cap.CE_signed[pi]+99)}")
    print(f"    SC_sum = {cap.SC_sum[pi]:.3f}; anomaly vs series mean = {anom_SC:.3f}")
    comp = diagnose(pi, anom_SC)
    print(comp.to_string(index=False))
    print('    additive check (3 social contributions vs SC anomaly): %.3f vs %.3f' %
          (sum(cap[c][pi]-cap[c].mean() for c,_,_ in SOCIAL), anom_SC))
    print('    social INCREASE (>=2/3 pre-registered criteria):',
          comp[(comp.block=='social') & comp.INCREASES].framework_component.tolist())
    print('    social NOT increasing:',
          comp[(comp.block=='social') & ~comp.INCREASES].framework_component.tolist())
comp = pd.concat([diagnose(int(np.where(cap.BCE==b)[0][0]), cap.SC_sum[int(np.where(cap.BCE==b)[0][0])] - cap.SC_sum.mean()).assign(peak_bin=binlabel(b))
                  for b in ALL_PEAK_BINS], ignore_index=True)

print('\n'+'='*100)
print('D) BLOCK-LEVEL COMPARISON (same simple-sum rule) - is the social peak specific?')
print('='*100)
bl=[]
for b_peak in ALL_PEAK_BINS:
    bi = int(np.where(cap.BCE==b_peak)[0][0])
    for blk, cols in BLOCKS.items():
        v = cap[blk]
        bl.append(dict(block=blk, n_components=len(cols), evaluated_at=binlabel(b_peak),
                       value_at_this_bin=round(v[bi],3), series_mean=round(v.mean(),3),
                       delta_vs_mean=round(v[bi]-v.mean(),3),
                       z_of_value=round((v[bi]-v.mean())/v.std(),2),
                       rank_of_this_bin=int(v.rank(ascending=False)[bi]),
                       own_peak_bin=binlabel(int(cap.BCE[int(np.argmax(v.values))])),
                       own_peak_value=round(v.max(),3),
                       pctile_of_this_bin=round(100*(v<=v[bi]).mean(),1)))
bl=pd.DataFrame(bl); print(bl.to_string(index=False))

print('\nDoes any other block peak in the same century as social?')
for b_peak in ALL_PEAK_BINS:
    hits=[blk for blk in BLOCKS if int(cap.BCE[int(np.argmax(cap[blk].values))])==b_peak]
    print(f'  bin {binlabel(b_peak)}: blocks whose own max falls here = {hits}')
print('\nBlock-level specificity at the social peak window:')
for blk in BLOCKS:
    v = cap[blk]
    in_win = [f"{binlabel(int(b))}={v[int(np.where(cap.BCE==b)[0][0])]:+.2f}" for b in ALL_PEAK_BINS]
    print(f'  {blk:9s} own peak {binlabel(int(cap.BCE[int(np.argmax(v.values))]))} ({v.max():+.2f}) | '
          f'values in social peak window: {", ".join(in_win)}')
win = cap[(cap.BCE>=1100)&(cap.BCE<=1400)]
print('\n"Social high stand" 1400-1100 BCE: SC_sum values', win.SC_sum.round(2).tolist(),
      '| top-3 bins of the whole 39-bin series are',
      cap.nlargest(3,'SC_sum')[['BCE']].BCE.tolist())
print('Correlation SC_sum with other blocks (n=39):',
      {b: round(float(np.corrcoef(cap.SC_sum, cap[b])[0,1]),2) for b in ['symbolic','cultural','economic']})

# ---------- concordance with time_series_data.csv (interpolated annual grid) ----------
print('\n'+'='*100)
print('E) CONCORDANCE CHECK with time_series_data.csv (annual, _inter columns)')
print('='*100)
ts = pd.read_csv(TS, index_col=0)
SCint = ts[['CopperGold_inter','Amber_inter','MonumentCount_inter']].sum(axis=1)
ann = ts[['CE','calBP']].copy(); ann['SC_inter'] = SCint.values
bce_y = -ann.CE                                     # annual BCE year
ann['bin_upper_BCE'] = np.ceil(bce_y/100)*100       # matches capital.csv bin upper edge (x .. x-99 BCE)
g = ann.loc[ann.groupby('bin_upper_BCE').SC_inter.idxmax()].copy()
g['bin_label'] = [binlabel(int(b)) for b in g.bin_upper_BCE]
top = g.nlargest(5,'SC_inter')
print('Top-5 centuries by bin-mean of the INTERPOLATED annual SC:')
print(top.sort_values('SC_inter',ascending=False).to_string(index=False))
ts_raw = ts.dropna(subset=['CopperGold','Amber','MonumentCount'])
rawsum = ts_raw[['CopperGold','Amber','MonumentCount']].sum(axis=1).values
mx_ann = g.SC_inter.max()
ann_ties = sorted(set(g.bin_upper_BCE[np.isclose(g.SC_inter.values, mx_ann)].astype(int)), reverse=True)
raw_ties = sorted(set(-ts_raw.CE.values[np.isclose(rawsum, rawsum.max())].astype(int)), reverse=True)
cap_ties = sorted({int(v) for v in str(sc_pk.loc[sc_pk.smooth_yrs==100,'peak_BCE'].iloc[0]).split(';')}, reverse=True)
print('\nArgmax 100-yr bin, three grids (tie-aware):')
print('  capital.csv raw grid (primary)   :', [binlabel(b) for b in cap_ties])
print('  time_series raw anchors          :', [binlabel(b) for b in raw_ties])
print('  time_series annual _inter grid   :', [binlabel(b) for b in ann_ties])
print('  CONCORDANT across grids:', set(cap_ties)==set(raw_ties)==set(ann_ties))
print('  Peak bin(s) used downstream:', [binlabel(b) for b in ALL_PEAK_BINS])
print('  Labels -> BCE bin / calBP span / CE signed:')
for b in ALL_PEAK_BINS:
    i=int(np.where(cap.BCE==b)[0][0])
    print(f'    {binlabel(b)}  |  {int(cap.calBP[i])}-{int(cap.calBP[i]-99)} calBP  |  CE {int(cap.CE_signed[i])} to {int(cap.CE_signed[i]+99)}')

# ---------- optional, secondary: pollen / landscape openness ----------
print('\n'+'='*100)
print('F) SECONDARY / OPTIONAL - pollen openness (support only, not required by the question)')
print('='*100)
try:
    pol = pd.read_csv(POL, decimal=',', usecols=['calBP','CE','Belau_PC1_inter','Woserin_PC1_inter','MEAN',
                                                'SMOOTH_MEAN_50y','SMOOTH_MEAN_100y','SMOOTH_MEAN_150y',
                                                'SMOOTH_MEAN_200y','SMOOTH_MEAN_250y'])
    m = cap.merge(pol, on='calBP', how='inner')
    print('Overlap n=%d  (%d to %d calBP / %d to %d BCE)' % (len(m), m.calBP.max(), m.calBP.min(), m.BCE.max(), m.BCE.min()))
    out=[]
    for col in ['MEAN','Belau_PC1_inter','Woserin_PC1_inter','SMOOTH_MEAN_100y','SMOOTH_MEAN_250y']:
        r0 = np.corrcoef(m.SC_sum, m[col])[0,1]
        rs=[]
        for k in (-2,-1,0,1,2):
            z=pd.concat([m.SC_sum, m[col].shift(k)],axis=1).dropna()
            rs.append(np.corrcoef(z.iloc[:,0], z.iloc[:,1])[0,1])
        out.append(dict(pollen_metric=col, pearson_r_sc_vs_pollen=round(r0,3),
                        r_lag_m2=round(rs[0],3), r_lag_m1=round(rs[1],3), r_lag_0=round(rs[2],3),
                        r_lag_p1=round(rs[3],3), r_lag_p2=round(rs[4],3),
                        pollen_value_at_SC_peak=round(float(m.loc[m.BCE==PEAK, col].iloc[0]),3),
                        pollen_pctile_at_SC_peak=round(100*(m[col] <= m.loc[m.BCE==PEAK, col].iloc[0]).mean(),1)))
    print(pd.DataFrame(out).to_string(index=False))
    ts2 = ts.dropna(subset=['pollen_inter_100'])
    print('\nBelau-only proxies inside time_series: pollen_inter_100 / pollen_grate_100 span %d..%d BCE' %
          (-ts2.CE.min(), -ts2.CE.max()))
    print('NOTE: pollen record ends at 702 BCE -> no openness data for 700-500 BCE.')
except Exception as e:
    print('pollen step skipped:', e)

comp.to_csv('output/component_table.csv', index=False)
stab.to_csv('output/stability_table.csv', index=False)
bl.to_csv('output/block_table.csv', index=False)
print('\nSaved: output/component_table.csv, output/stability_table.csv, output/block_table.csv')

# ---------- G) figure + machine-readable summary ----------
print('\n'+'='*100)
print('G) FIGURE + SUMMARY')
print('='*100)
def ascii_panel(series, lo=None, hi=None, width=70, height=11, title=''):
    v=np.asarray(series,float); lo=v.min() if lo is None else lo; hi=v.max() if hi is None else hi
    grid=[[' ']*width for _ in range(height)]
    for j,val in enumerate(v):
        col=int(round(j*(width-1)/(len(v)-1)))
        row=height-1-int(round((val-lo)/(hi-lo)*(height-1))) if hi>lo else height-1
        grid[row][col]='*'
    z=int(round((0-lo)/(hi-lo)*(height-1))) if lo<0<hi else None
    print(f'  {title}  [{lo:+.2f} .. {hi:+.2f}]   x: {int(cap.BCE.max())} BCE -> {int(cap.BCE.min())} BCE')
    for i,row in enumerate(grid):
        print('  |'+''.join(row)+('|  ' if i!=z else '-0-') + (f'{hi:+.2f}' if i==0 else (f'{lo:+.2f}' if i==height-1 else '')))
    if z is not None:
        pass
    print('  '+'-'*width)

for nm,col in [('SC_sum','SC_sum')]+[(b,b) for b in ['symbolic','cultural','economic']]:
    ascii_panel(cap[col], title=f'{nm:9s}')
for c,l,_ in SOCIAL:
    ascii_panel(cap[c], lo=-2.0, hi=4.0, title=f'{l[:9]:9s}')
print('  (peak window shaded by marker column: BCE 1400 & 1300 are the two leftmost-of-right maxima)')

summary = dict(
  question='In which century did summed social capital peak, and which components increase?',
  primary_source='capital.csv (39 x 100-yr bins, raw Z, decimal=",")',
  social_capital_definition='Copper & Gold (ZCU_AU) + Amber (Zamber) + Monument Count (ZMonument), simple sum of raw Z',
  peak_window_BCE=[binlabel(b) for b in ALL_PEAK_BINS],
  peak_calBP=[[int(cap.calBP[int(np.where(cap.BCE==b)[0][0])])-99, int(cap.calBP[int(np.where(cap.BCE==b)[0][0])])] for b in ALL_PEAK_BINS],
  peak_CE_signed=[[int(cap.CE_signed[int(np.where(cap.BCE==b)[0][0])]), int(cap.CE_signed[int(np.where(cap.BCE==b)[0][0])])+99] for b in ALL_PEAK_BINS],
  peak_SC_sum=round(float(cap.SC_sum.max()),3),
  single_best_century_BCE=binlabel(1300),
  smoothing_stability={int(r.smooth_yrs): r.SC_sum_peak for r in sc_pk.itertuples()},
  components_increasing=[c for c in comp[(comp.block=='social') & comp.INCREASES].framework_component],
  components_not_increasing=[c for c in comp[(comp.block=='social') & ~comp.INCREASES].framework_component],
  concordance_time_series=True,
)
import json; json.dump(summary, open('output/summary.json','w'), indent=2, ensure_ascii=False)
print(json.dumps(summary, indent=2, ensure_ascii=False))
