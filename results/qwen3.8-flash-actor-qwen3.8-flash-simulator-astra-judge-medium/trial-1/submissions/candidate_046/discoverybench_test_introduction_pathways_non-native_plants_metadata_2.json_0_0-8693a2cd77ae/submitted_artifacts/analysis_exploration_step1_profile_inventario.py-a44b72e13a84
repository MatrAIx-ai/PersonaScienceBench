import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 50)

isp = pd.read_csv('data/invasion_success_pathways.csv')
inp = pd.read_csv('data/invaded_niche_pathways.csv')

print("### invasion_success_pathways.csv  shape:", isp.shape)
print(isp.dtypes.to_string())
print("\n-- missing per column --")
print(pd.DataFrame({'n_missing': isp.isna().sum(), 'pct': (100*isp.isna().mean()).round(1)}).to_string())
print("\n-- duplicated column value counts --")
print(isp['duplicated'].value_counts(dropna=False).to_string())
print("\n-- exact duplicate rows (all cols):", isp.duplicated().sum())
print("-- duplicate Scientific_name rows:", isp['Scientific_name'].duplicated().sum(),
      " unique names:", isp['Scientific_name'].nunique())
print("\n-- intro.pathway value counts --")
print(isp['intro.pathway'].value_counts(dropna=False).to_string())
print("\n-- family n unique:", isp['family'].nunique(), "| growth.form:"); print(isp['growth.form'].value_counts(dropna=False).to_string())
print("\n-- phylo.tip.label: n_unique", isp['phylo.tip.label'].nunique(), "missing", isp['phylo.tip.label'].isna().sum())
tree = open('data/phylogenetic_tree.txt').read()
import re
tips = set(re.findall(r'([A-Za-z0-9_.]+):[0-9.]+', tree))
tips = {t for t in tips if not t.startswith('mrcaott')}
lab = set(isp['phylo.tip.label'].dropna())
print("-- tree tips parsed:", len(tips), "| labels in table:", len(lab))
print("-- labels not in tree:", sorted(lab-tips)[:10], "count", len(lab-tips))
print("-- tree tips not in table:", sorted(tips-lab)[:10], "count", len(tips-lab))

print("\n\n### invaded_niche_pathways.csv  shape:", inp.shape)
print(inp.dtypes.to_string())
print("\n-- missing per column --")
m = pd.DataFrame({'n_missing': inp.isna().sum(), 'pct': (100*inp.isna().mean()).round(1)})
print(m[m.n_missing>0].to_string() if m.n_missing.sum()>0 else "no missing values in any column")
print("\n-- exact duplicate rows:", inp.duplicated().sum())
print("\n-- habitat value counts (n categories = %d) --" % inp['habitat'].nunique())
print(inp['habitat'].value_counts(dropna=False).to_string())
