import pandas as pd, numpy as np, re
pd.set_option('display.width', 220); pd.set_option('display.max_columns', 60)
inp = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
print("shape:", inp.shape)
print("no-missing:", inp.isna().sum().sum() == 0, "| exact dup rows:", inp.duplicated().sum())
print("\n-- dtypes (non-numeric cols) --")
print(inp.select_dtypes(exclude=[np.number]).dtypes.to_string())
print("\n-- habitat value counts (n categories = %d) --" % inp['habitat'].nunique())
print(inp['habitat'].value_counts(dropna=False).to_string())
print("\n-- counts panel summary --")
print(inp[['n.gard','n.unint','n.agfo','n.total']].describe().round(2).to_string())
print("\nn.total == 0 rows:", (inp['n.total']==0).sum(), "| n.total < 3:", (inp['n.total']<3).sum())
print("n.gard==0 rows:", (inp['n.gard']==0).sum())
chk = inp['n.gard']+inp['n.unint']+inp['n.agfo'] - inp['n.total']
print("rows where gard+unint+agfo != n.total:", (chk!=0).sum(), "| max abs diff:", chk.abs().max())
print("\n-- per habitat: plots, sums, crude gardening proportion --")
g = inp.groupby('habitat').agg(plots=('habitat','size'), n_gard=('n.gard','sum'), n_unint=('n.unint','sum'),
    n_agfo=('n.agfo','sum'), n_total=('n.total','sum'),
    min_tot=('n.total','min'), max_tot=('n.total','max'), mean_tot=('n.total','mean'),
    zero_tot=('n.total', lambda s:(s==0).sum()))
g['prop_gard'] = (g.n_gard/g.n_total).round(3)
g['mean_prop_gard_plot'] = inp.assign(p=inp.n.gard/inp.n.total).groupby('habitat').p.mean().round(3)
print(g.sort_values('prop_gard', ascending=False).round(2).to_string())
print("\n-- overall --", "sum n.total:", inp.n.total.sum(), "sum n.gard:", inp.n.gard.sum(),
      "overall prop:", round(inp.n.gard.sum()/inp.n.total.sum(),3))
print("\n-- spatial/effort covariate ranges --")
print(inp[['elevation','latitude','longitude','distance.road','distance.stream','annual.temperature','annual.rainfall']].describe().round(2).to_string())
print("\n-- landscape change cols: unique values --")
for c in ['progressive.1956.2009.50m','no.changes.1956.2009.50m']:
    print(c, inp[c].unique()[:6], "dtype", inp[c].dtype)
print("\n-- habitat x elevation sanity (mean elev by habitat) --")
print(inp.groupby('habitat').elevation.mean().round(0).sort_values().to_string())
