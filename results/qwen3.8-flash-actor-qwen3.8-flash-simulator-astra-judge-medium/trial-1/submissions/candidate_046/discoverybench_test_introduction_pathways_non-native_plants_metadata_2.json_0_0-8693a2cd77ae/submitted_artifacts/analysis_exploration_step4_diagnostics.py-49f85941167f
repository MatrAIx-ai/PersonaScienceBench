import pandas as pd, numpy as np
pd.set_option('display.width', 240); pd.set_option('display.max_columns', 60)
inp = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
g = inp.groupby('habitat').agg(
    plots=('habitat','size'), n_gard=('n.gard','sum'), n_unint=('n.unint','sum'),
    n_agfo=('n.agfo','sum'), n_total=('n.total','sum'),
    zero_tot=('n.total', lambda s:(s==0).sum()),
    plots_with_gard=('n.gard', lambda s:(s>0).sum()),
    max_tot=('n.total','max'), mean_tot=('n.total','mean'))
g['pooled_prop_gard'] = (g.n_gard/g.n_total).round(3)
g['pct_plots_zero'] = (100*g.zero_tot/g.plots).round(1)
g['mean_tot'] = g.mean_tot.round(2)
g = g.drop(columns='mean_tot')
print(g.sort_values('pooled_prop_gard', ascending=False).to_string())
print("\nTOTALS plots=%d  n.gard=%d n.unint=%d n.agfo=%d n.total=%d  pooled prop gard=%.3f" %
      (len(inp), inp['n.gard'].sum(), inp['n.unint'].sum(), inp['n.agfo'].sum(), inp['n.total'].sum(),
       inp['n.gard'].sum()/inp['n.total'].sum()))
print("\n-- distribution of n.total among NON-ZERO plots --")
nz = inp[inp['n.total']>0]
print(nz['n.total'].value_counts().sort_index().to_string())
print("non-zero plots:", len(nz), "of", len(inp))
print("\n-- among non-zero plots, per habitat --")
h = nz.groupby('habitat').agg(nonzero_plots=('habitat','size'), n_gard=('n.gard','sum'), n_total=('n.total','sum'))
h['pooled_prop_gard']=(h.n_gard/h.n_total).round(3)
print(h.sort_values('pooled_prop_gard', ascending=False).to_string())
print("\n-- 2x2 style check: contingency habitat x pathway (pooled counts) --")
mat = inp.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum()
print(mat.to_string())
from scipy.stats import chi2_contingency
chi2,p,dof,exp = chi2_contingency(mat.values)
print("chi2=%.2f df=%d p=%.3g  min expected=%.2f  frac cells exp<5=%.2f" % (chi2,dof,p,exp.min(),(exp<5).mean()))
print("\n-- spatial covariates by habitat (effort/confounding check) --")
print(inp.groupby('habitat')[['elevation','latitude','longitude','distance.road','annual.temperature','urban.2009.50m']].mean().round(2).to_string())
