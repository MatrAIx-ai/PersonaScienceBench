import re, pandas as pd
raw = open('data/phylogenetic_tree.txt').read().strip()
isp = pd.read_csv('data/invasion_success_pathways.csv')
# tips = label followed by ':' that are NOT preceded by ')' after stripping internal labels
s = re.sub(r'\)([A-Za-z0-9_.\-]*):', r'):', raw)     # blank internal node labels
tips = re.findall(r'[,(:]([A-Za-z0-9_.\-]+):', s)
tips = [t for t in tips if t]
print("parsed tips:", len(tips), "unique:", len(set(tips)))
lab = list(isp['phylo.tip.label'])
print("table phylo labels unique:", len(set(lab)))
print("labels NOT in tree:", sorted(set(lab)-set(tips)))
print("tree tips NOT in table:", sorted(set(tips)-set(lab)))
print("\nDuplicated-name rows:")
d = isp.loc[isp['Scientific_name'].duplicated(keep=False),
     ['Scientific_name','family','intro.pathway','number.of.invaded.plots','duplicated','phylo.tip.label']]
print(d.sort_values('Scientific_name').to_string(index=False))
print("\nduplicated==True rows:")
print(isp.loc[isp['duplicated'], ['Scientific_name','intro.pathway','phylo.tip.label','number.of.invaded.plots']].to_string(index=False))
print("\n-- pathway x growth.form (species table) --")
print(pd.crosstab(isp['intro.pathway'], isp['growth.form']).to_string())
print("\n-- species-table traits by pathway --")
print(isp.groupby('intro.pathway')[['number.of.invaded.plots','area.of.occupancy.10km','habitat.range','invaded.niche.breadth','mrt','height']].median().round(2).to_string())
print("\n-- match: species in invasion_success vs total species implied by niche table --")
print("unique species in invasion_success (dedup):", isp.loc[~isp['duplicated'],'Scientific_name'].nunique(), "of", len(isp))
print("\n-- temporal trends: gardening share per period --")
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
piv = tt.pivot(index='introduction.period', columns='pathway', values='n')
piv['total']=piv.sum(1); piv['gard_share']=(piv['Gardening']/piv['total']).round(3)
print(piv.to_string())
from scipy.stats import chi2_contingency
c=tt.pivot(index='introduction.period',columns='pathway',values='n').values
print("period x pathway chi2=%.1f p=%.3g" % chi2_contingency(c)[:2])
