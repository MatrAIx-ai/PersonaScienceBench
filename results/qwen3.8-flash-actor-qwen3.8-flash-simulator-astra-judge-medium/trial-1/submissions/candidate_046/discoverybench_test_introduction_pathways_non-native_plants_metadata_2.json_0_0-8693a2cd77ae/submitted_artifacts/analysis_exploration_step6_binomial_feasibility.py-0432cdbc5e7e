import pandas as pd, numpy as np, statsmodels.api as sm, statsmodels.formula.api as smf
inp = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
nz = inp[inp['n.total']>0].copy()
y = np.column_stack([nz['n.gard'], nz['n.total']-nz['n.gard']])
X = pd.get_dummies(nz['habitat'], drop_first=False).astype(float)
mod = sm.GLM(y, X, family=sm.families.Binomial()).fit()
disp = mod.pearson_chi2/mod.df_resid
print("binomial: deviance=%.1f df=%d  residual deviance/df=%.2f  Pearson/df=%.2f" %
      (mod.deviance, mod.df_resid, mod.deviance/mod.df_resid, disp))
print("logLik=%.2f  converged=%s" % (mod.llf, mod.converged))
# quasibinomial p-values for habitat effect vs intercept-only
m0 = sm.GLM(y, np.ones((len(nz),1)), family=sm.families.Binomial()).fit()
from scipy.stats import chi2
LR = 2*(mod.llf-m0.llf); p = chi2.sf(LR, X.shape[1]-1)
print("LR habitat vs intercept: chi2=%.2f df=%d p=%.3g | F(quasibin)=%.2f" %
      (LR, X.shape[1]-1, p, (LR/(X.shape[1]-1))/(disp if disp>1 else 1)))
print("\nfitted prevalence per habitat (binomial):")
fit = pd.Series(mod.params, index=X.columns).sort_values(ascending=False)
print((100*fit).round(1).to_string())
# beta-binomial feasibility: check per-habitat variance vs binomial expectation among non-zero plots
print("\nspecies-per-plot denominator distribution among non-zero plots:")
print(nz['n.total'].value_counts().sort_index().to_string())
