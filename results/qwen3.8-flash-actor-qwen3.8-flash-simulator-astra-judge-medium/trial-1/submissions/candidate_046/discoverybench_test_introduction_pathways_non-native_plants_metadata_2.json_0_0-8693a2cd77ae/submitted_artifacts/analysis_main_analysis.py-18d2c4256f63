def morans_I(res, x, y, k=5, B=4999):
    """Moran's I on k-NN weights with permutation p-value."""
    from scipy.spatial import cKDTree
    t = cKDTree(np.column_stack([x, y])); n = len(x)
    _, idx = t.query(np.column_stack([x, y]), k=k+1)
    rows, cols, vals = [], [], []
    for i in range(n):
        js = idx[i, 1:]
        rows += [i]*len(js); cols += list(js); vals += [1/len(js)]*len(js)
    from scipy.sparse import coo_matrix
    W = coo_matrix((vals, (rows, cols)), shape=(n, n))
    s0 = W.sum(); z = res - res.mean(); zz = z @ z
    def stat(zz_, z_):
        return (n/s0) * (z_ @ (W @ z_)) / zz_
    obs = stat(zz, z)
    null = np.array([stat(zz, rng.permutation(z)) for _ in range(B)])
    return obs, (np.sum(np.abs(null) >= abs(obs))+1)/(B+1)

