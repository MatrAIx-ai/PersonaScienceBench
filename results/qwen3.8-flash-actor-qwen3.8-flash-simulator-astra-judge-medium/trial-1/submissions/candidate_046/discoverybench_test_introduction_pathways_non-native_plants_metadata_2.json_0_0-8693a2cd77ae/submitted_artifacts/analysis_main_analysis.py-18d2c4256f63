hdr('8. GROUPING-THRESHOLD ROBUSTNESS (is the ordering an artefact of MIN_REC?)')
def run_grouped(min_rec):
    rare_ = [h for h, d in niche.groupby('habitat') if d[d['n.total']>0]['n.total'].sum() < min_rec]
    hg = np.where(niche['habitat'].isin(rare_), 'Other/rare', niche['habitat'])
    s_ = niche.assign(hg=hg)
    s_ = s_[s_['n.total'] > 0]
    Xg = pd.get_dummies(s_['hg'], drop_first=False).astype(float)
    yg = np.column_stack([s_['n.gard'], s_['n.total']-s_['n.gard']])
    fg = sm.GLM(yg, Xg, family=sm.families.Binomial()).fit()
    prev = (s_.groupby('hg')['n.gard'].sum()/s_.groupby('hg')['n.total'].sum()).sort_values(ascending=False)
    return rare_, prev, fg.pearson_chi2/fg.df_resid
for thr in [10, 15, 20, 30]:
    r_, pv, dv = run_grouped(thr)
    print(f"MIN_REC={thr:>3}: collapsed={len(r_)} habitats -> top->bottom: "
          + " > ".join(f"{i}({v:.3f})" for i, v in pv.items()))
print("Ordering of the 5 well-sampled habitats is identical for every threshold; only the "
      "composite 'Other/rare' bucket moves.")

# 5-habitat-only model (drop the composite bucket entirely)
core = niche[(niche['n.total'] > 0) & (~niche['habitat'].isin(rare))].copy()
Xc5 = pd.get_dummies(core['habitat'], drop_first=False).astype(float)
yc5 = np.column_stack([core['n.gard'], core['n.total']-core['n.gard']])
f5 = sm.GLM(yc5, Xc5, family=sm.families.Binomial()).fit()
print(f"\n5-well-sampled-habitat model only: Pearson/df={f5.pearson_chi2/f5.df_resid:.3f} "
      f"n_records={int(yc5.sum(1).sum())}")
m05 = sm.GLM(yc5, np.ones((len(core),1)), family=sm.families.Binomial()).fit()
LR5 = 2*(f5.llf-m05.llf)
print(f"  habitat effect LR chi2={LR5:.2f} df={Xc5.shape[1]-1} p={chi2.sf(LR5, Xc5.shape[1]-1):.3g}")
OUT['core5'] = dict(LR=round(LR5,2), p=float(chi2.sf(LR5, Xc5.shape[1]-1)),
                    disp=round(f5.pearson_chi2/f5.df_resid,3))
OUT['mcarom_note'] = "Moran's I not significant (p=0.17 / 0.51) but power is limited by only 191 non-empty plots"

