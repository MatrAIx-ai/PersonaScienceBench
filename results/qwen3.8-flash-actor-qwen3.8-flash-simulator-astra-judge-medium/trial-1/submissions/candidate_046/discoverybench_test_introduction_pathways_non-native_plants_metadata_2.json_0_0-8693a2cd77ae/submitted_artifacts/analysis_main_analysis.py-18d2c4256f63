# ---------------------------------------------------------------- Wilson CI
def wilson(k, n, z=1.959964):
    """Wilson score interval for a binomial proportion."""
    if n == 0: return (np.nan, np.nan)
    p = k / n; d = 1 + z*z/n
    c = (p + z*z/(2*n)) / d
    h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n)) / d
    return (max(0.0, c-h), min(1.0, c+h))

def boot_ci(k, n, plots_g, plots_t, B=20000):
    """Plot-level cluster bootstrap CI of the pooled ratio (resample plots)."""
    out = np.empty(B)
    gp, tp = np.asarray(plots_g), np.asarray(plots_t)
    for b in range(B):
        i = rng.integers(0, len(gp), len(gp))
        out[b] = gp[i].sum()/tp[i].sum() if tp[i].sum() else np.nan
    return np.nanpercentile(out, [2.5, 97.5])

