def mc_chi2(mat, B=20000, rng=rng):
    """Conditional Monte-Carlo test of habitat x pathway independence.
    Row totals (species records per habitat) are held FIXED; pathway labels are
    redrawn as Multinomial(n_i, p_col) with p_col the pooled pathway shares.
    This is the exact analogue of Fisher-Freeman-Halton and, unlike the
    asymptotic chi2, is valid with the 57% of cells having expected count < 5."""
    from scipy.stats import chi2_contingency
    from numpy.random import Generator
    mat = np.asarray(mat, dtype=int)
    obs = chi2_contingency(mat, correction=False)[0]
    row_tot = mat.sum(1)
    p_col = mat.sum(0) / mat.sum()
    null = np.empty(B)
    for b in range(B):
        sim = np.array([rng.multinomial(int(nt), p_col) for nt in row_tot], dtype=float)
        null[b] = chi2_contingency(sim, correction=False)[0]
    p = (np.sum(null >= obs) + 1) / (B + 1)
    return obs, p, null

