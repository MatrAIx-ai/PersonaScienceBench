import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 100)
p = "/workspace/data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(p, na_values=["NA", "", " ", "NaN"], keep_default_na=True)
print("SHAPE:", df.shape)
print("\nN_COLUMNS:", df.shape[1])
print("\nCOLUMNS:")
for i, c in enumerate(df.columns, 1):
    print(f"  {i:2d}. {c} [{df[c].dtype}]")

key = ["study","project.x","project.y","discipline","journal","ro","rr","fiso","fisr",
       "se_fiso","se_fisr","relative_es","replicated","no","nr","n.r","po","pr","pm_belief"]
print("\n=== KEY COLUMNS: missing / non-missing / dtype ===")
rows=[]
for c in key:
    if c in df.columns:
        s=df[c]
        rows.append((c, str(s.dtype), int(s.isna().sum()), int(s.notna().sum()),
                     round(100*s.isna().sum()/len(df),1)))
print(pd.DataFrame(rows, columns=["column","dtype","n_missing","n_present","pct_missing"]).to_string(index=False))

print("\n=== UNIQUE LEVELS ===")
for c in ["project.x","project.y","discipline","journal"]:
    if c in df.columns:
        vc = df[c].value_counts(dropna=False)
        print(f"\n-- {c}: {df[c].nunique(dropna=True)} unique (NaN={int(df[c].isna().sum())})")
        print(vc.to_string())

print("\n=== project.x vs project.y crosstab ===")
print(pd.crosstab(df["project.x"], df["project.y"], dropna=False).to_string())

print("\n=== project x discipline crosstab ===")
print(pd.crosstab(df["project.x"], df["discipline"], dropna=False).to_string())
print("\n=== project.y x discipline crosstab ===")
print(pd.crosstab(df["project.y"], df["discipline"], dropna=False).to_string())

print("\n=== study duplicates ===")
dups = df[df.duplicated("study", keep=False)].sort_values("study")
print("n duplicated study rows:", len(dups), "| n unique duplicated ids:", dups['study'].nunique())
if len(dups): print(dups[["study","project.x","project.y","discipline","journal","ro","rr"]].to_string(index=False))

print("\n=== full-row duplicates ===", int(df.duplicated().sum()))
print("=== duplicates on study+project ===", int(df.duplicated(['study','project.x']).sum()))

print("\n=== rows where discipline is missing: which project? ===")
sub = df[df["discipline"].isna()]
print("count:", len(sub))
if len(sub): print(sub[["study","project.x","project.y","journal","discipline"]].head(30).to_string(index=False))

print("\n=== journal missing by project ===")
print(df.assign(miss_j=df["journal"].isna()).groupby(["project.x"], dropna=False)["miss_j"].agg(['sum','size']).to_string())

print("\n=== ro/rr/fiso/fisr/relative_es summary ===")
print(df[["ro","rr","fiso","fisr","se_fiso","se_fisr","relative_es","no","nr"]].describe().T.to_string())

print("\n=== sign / scale sanity checks ===")
ok = df[["ro","rr","fiso","fisr"]].notna().all(axis=1)
print("rows with all 4 effect cols present:", int(ok.sum()))
print("max |fiso - arctanh(ro)| :", float(np.nanmax(np.abs(df.loc[ok,'fiso'] - np.arctanh(df.loc[ok,'ro'])))))
print("max |fisr - arctanh(rr)| :", float(np.nanmax(np.abs(df.loc[ok,'fisr'] - np.arctanh(df.loc[ok,'rr'])))))
rel = df["relative_es"]
print("relative_es present:", int(rel.notna().sum()), "min/median/max:", rel.min(), rel.median(), rel.max())
recalc = df["rr"]/df["ro"]
both = rel.notna() & recalc.notna()
print("max |relative_es - rr/ro| (sign-preserving rr/ro):", float(np.nanmax(np.abs(rel[both]-recalc[both]))))
print("rows where |relative_es - rr/ro| > 1e-6:", int((np.abs(rel[both]-recalc[both])>1e-6).sum()))
print("\nrows with |ro| < 0.05:", int((df['ro'].abs()<0.05).sum()), " | |ro|<0.1:", int((df['ro'].abs()<0.1).sum()))
print("rows with ro==0:", int((df['ro']==0).sum()))
print("rows with sign(ro)!=sign(rr):", int(((df['ro']*df['rr'])<0).sum()))
