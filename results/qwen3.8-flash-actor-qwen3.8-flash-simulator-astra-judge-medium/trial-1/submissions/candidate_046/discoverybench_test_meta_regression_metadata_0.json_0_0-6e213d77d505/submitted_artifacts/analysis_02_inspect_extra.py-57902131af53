import pandas as pd, numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 60)
p="/workspace/data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
df=pd.read_csv(p, na_values=["NA",""," "])

print("=== ALL COLUMNS missingness (only cols with >=1 missing) ===")
m=df.isna().sum(); m=m[m>0].sort_values(ascending=False)
print(m.to_string())

print("\n=== odd relative_es rows ===")
rec=df['rr']/df['ro']
diff=(df['relative_es']-rec).abs()
odd=df.assign(recalc=rec, diff=diff)[diff>1e-6].sort_values('diff',ascending=False)
print(odd[['study','project.x','discipline','ro','rr','relative_es','recalc','diff']].to_string(index=False))

print("\n=== nr vs n.r (both claim replication N) ===")
print("identical:", int((df['nr']==df['n.r']).sum()), "of", len(df))
print("n.r missing:", int(df['n.r'].isna().sum()))
print(df[['study','project.x','no','nr','n.r']].head(6).to_string(index=False))
d=df[df['nr']!=df['n.r']]
print("rows differing:", len(d))
print(d[['study','project.x','no','nr','n.r']].head(10).to_string(index=False))

print("\n=== journal x discipline ===")
print(pd.crosstab(df['journal'], df['discipline']).to_string())

print("\n=== pub_year range / aggregated / lab_id ===")
print("pub_year:", df['pub_year'].min(), "-", df['pub_year'].max())
print("aggregated non-missing:", int(df['aggregated'].notna().sum()), "| lab_id non-missing:", int(df['lab_id'].notna().sum()))
print("pm_belief available by project:\n", df.assign(has_pm=df['pm_belief'].notna()).groupby('project.x')['has_pm'].agg(['sum','size']).to_string())
print("endprice available by project:\n", df.assign(has_ep=df['endprice'].notna()).groupby('project.x')['has_ep'].agg(['sum','size']).to_string())

print("\n=== naive descriptives by project (NOT final analysis) ===")
g=df.groupby('project.x')
tab=pd.DataFrame({
 'n':g.size(),
 'mean_ro':g['ro'].mean(),'mean_rr':g['rr'].mean(),
 'mean_ro_minus_absrr':(g.apply(lambda s: (s['ro']-s['rr'].abs()).mean())),
 'mean_fiso_minus_fisr':g.apply(lambda s:(s['fiso']-s['fisr']).mean()),
 'median_fiso_minus_fisr':g.apply(lambda s:(s['fiso']-s['fisr']).median()),
 'frac_ro_gt_rr':g.apply(lambda s:(s['ro']>s['rr']).mean()),
 'frac_ro_gt_absrr':g.apply(lambda s:(s['ro']>s['rr'].abs()).mean()),
 'mean_relative_es':g['relative_es'].mean(),
 'frac_replicated':g['replicated'].mean(),
})
print(tab.round(3).to_string())

print("\n=== naive descriptives by discipline ===")
g=df.groupby('discipline')
tab=pd.DataFrame({
 'n':g.size(),
 'mean_ro':g['ro'].mean(),'mean_rr':g['rr'].mean(),
 'mean_ro_minus_absrr':g.apply(lambda s:(s['ro']-s['rr'].abs()).mean()),
 'mean_fiso_minus_fisr':g.apply(lambda s:(s['fiso']-s['fisr']).mean()),
 'frac_ro_gt_absrr':g.apply(lambda s:(s['ro']>s['rr'].abs()).mean()),
 'mean_relative_es':g['relative_es'].mean(),
 'frac_replicated':g['replicated'].mean(),
})
print(tab.round(3).to_string())

print("\n=== count ro>rr vs ro>|rr| (sign issue) ===")
print("ro > rr :", int((df['ro']>df['rr']).sum()), "/", len(df))
print("ro > |rr|:", int((df['ro']>df['rr'].abs()).sum()), "/", len(df))
print("\nrelative_es vs rr/ro sign convention check:")
print("corr(relative_es, rr/ro):", float(np.corrcoef(df['relative_es'], rec)[0,1]))
print("n where relative_es<0 :", int((df['relative_es']<0).sum()), "| n where rr<0:", int((df['rr']<0).sum()))
