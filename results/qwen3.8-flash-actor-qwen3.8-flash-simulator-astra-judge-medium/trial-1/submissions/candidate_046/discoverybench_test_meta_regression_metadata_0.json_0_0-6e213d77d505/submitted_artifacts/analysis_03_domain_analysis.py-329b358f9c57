"""
Domain analysis: ¿en qué dominios los efectos originales son MÁS grandes que las replicaciones?
Dataset: data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv (86 estudios, join 1:1 asumido)
Primaria: d_fisher = fiso - fisr (SE pareada = sqrt(se_fiso^2+se_fisr^2)) + frecuencia ro>rr
Co-primaria (mismo peso): ratio = rr/ro recalculado (mediana/IQR, recortado, rangos)
Dominios: nivel A project.x ; nivel B discipline (Economics = mismas 18 filas que ee, reportado una vez)
"""
import hashlib
import numpy as np, pandas as pd
from scipy import stats

RNG = np.random.default_rng(20261022)
B = 2000
CSV = "/workspace/data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
OUT_MD = "/workspace/analysis/results_summary.md"
OUT_CSV = "/workspace/analysis/results_domain_table.csv"

df = pd.read_csv(CSV, na_values=["NA", "", " "])
assert df["study"].is_unique and len(df) == 86

df["d_fisher"] = df["fiso"] - df["fisr"]
df["var_d"]    = df["se_fiso"]**2 + df["se_fisr"]**2
df["d_corr"]   = df["ro"] - df["rr"]
df["ratio"]    = df["rr"] / df["ro"]      # recalculado (corrige el signo de "B Eitam")
df["ratio_orig"] = df["relative_es"]
df["ro_gt_rr"] = (df["ro"] > df["rr"]).astype(int)
df["sign_match"] = (np.sign(df["ro"]) == np.sign(df["rr"])).astype(int)
assert (df["ro"] > 0).all()

md = []
def emit(s=""):
    print(s); md.append(s)

def ci_mean(x, conf=0.95):
    x = np.asarray(x, float); x = x[~np.isnan(x)]
    n = len(x); m = x.mean(); se = x.std(ddof=1)/np.sqrt(n)
    t = stats.t.ppf(0.5+conf/2, n-1)
    return m, m-t*se, m+t*se, se

def _rng_for(tag, *arrs):
    """semilla determinista segun datos+metrica -> ICs reproducibles y estables
    (la fila Economics da exactamente lo mismo en el nivel A y en el nivel B)"""
    h = hashlib.sha256(tag.encode())
    for a in arrs:
        a = np.asarray(a, float); h.update(a.tobytes())
    return np.random.default_rng(int.from_bytes(h.digest()[:8], "little"))

def boot_stat(x, fn=np.mean, B=B, conf=0.95):
    x = np.asarray(x, float); x = x[~np.isnan(x)]
    r = _rng_for("bs:"+fn.__name__, x)
    b = fn(r.choice(x, size=(B, len(x)), replace=True), axis=1)
    return fn(x), *np.percentile(b, [100*(1-conf)/2, 100*(1+conf)/2])

def boot_diff(x, y, fn=np.mean, B=B, conf=0.95):
    x = np.asarray(x, float); y = np.asarray(y, float)
    r = _rng_for("bd:"+fn.__name__, x, y)
    bx = fn(r.choice(x, size=(B, len(x)), replace=True), axis=1)
    by = fn(r.choice(y, size=(B, len(y)), replace=True), axis=1)
    d = bx - by
    return fn(x)-fn(y), *np.percentile(d, [100*(1-conf)/2, 100*(1+conf)/2])

def dl_re(y, v):
    y = np.asarray(y, float); v = np.asarray(v, float)
    w = 1/v; mfe = (w*y).sum()/w.sum()
    Qw = (w*(y-mfe)**2).sum(); k = len(y); dfree = max(k-1, 1)
    C = w.sum() - (w**2).sum()/w.sum()
    tau2 = max(0.0, (Qw-dfree)/C)
    wr = 1/(v+tau2); mp = (wr*y).sum()/wr.sum()
    return mp, np.sqrt(1/wr.sum()), tau2, Qw, dfree, k

def hl(d):
    d = np.asarray(d, float); return np.median((d[:, None]+d[None, :]).ravel()/2)

def perm_p(groups, statfn, B=B):
    obs = statfn(groups); pooled = np.concatenate(groups); sizes = [len(g) for g in groups]; cnt = 0
    for _ in range(B):
        p = RNG.permutation(pooled); i = 0; newg = []
        for s in sizes: newg.append(p[i:i+s]); i += s
        if statfn(newg) >= obs-1e-12: cnt += 1
    return obs, (cnt+1)/(B+1)

def F_oneway(g): return stats.f_oneway(*g).statistic

PSY = df["project.x"].eq("Psychology"); EE = df["project.x"].eq("Experimental Economics")
COG = df["discipline"].eq("Cognitive"); SOC = df["discipline"].eq("Social"); ECO = df["discipline"].eq("Economics")
assert (EE == ECO).all()
DOMAINS = [("A", "Psychology (project)", PSY), ("A", "Experimental Economics (project)", EE),
           ("B", "Cognitive (discipline)", COG), ("B", "Social (discipline)", SOC),
           ("B", "Economics (discipline; mismas filas que ee)", EE)]

# ---------------- TABLA 1: descriptivos por dominio ----------------
rows = []
for lvl, name, mask in DOMAINS:
    s = df[mask]
    m, lo, hi, se = ci_mean(s["d_fisher"])
    mro, mro_lo, mro_hi, _ = ci_mean(s["ro"]); mrr, mrr_lo, mrr_hi, _ = ci_mean(s["rr"])
    mdc, mdc_lo, mdc_hi, _ = ci_mean(s["d_corr"])
    med_ratio, r_lo, r_hi = boot_stat(s["ratio"], np.median)
    med_df, df_lo, df_hi = boot_stat(s["d_fisher"], np.median)
    q1, q3 = np.percentile(s["ratio"], [25, 75])
    rme, rme_lo, rme_hi, _ = ci_mean(s["ratio"])
    rep_, rese, tau2, Qw, dfw, k = dl_re(s["d_fisher"], s["var_d"])
    w = stats.wilcoxon(s["fiso"], s["fisr"], alternative="two-sided")
    wtot = (1/s["var_d"]).sum(); typ = 1/((1/s["var_d"]).sum())  # var típica p'ra I2
    I2 = max(0, (Qw-dfw)/Qw)*100
    rows.append(dict(level=lvl, domain=name, n=len(s),
        d_fisher_mean=m, d_fisher_lo=lo, d_fisher_hi=hi, d_fisher_se=se,
        d_fisher_median=med_df, d_fisher_med_lo=df_lo, d_fisher_med_hi=df_hi, d_fisher_HL=hl(s["d_fisher"].values),
        ro_mean=mro, ro_lo=mro_lo, ro_hi=mro_hi, ro_median=s["ro"].median(),
        rr_mean=mrr, rr_lo=mrr_lo, rr_hi=mrr_hi, rr_median=s["rr"].median(),
        d_corr_mean=mdc, d_corr_lo=mdc_lo, d_corr_hi=mdc_hi, d_corr_median=s["d_corr"].median(),
        ratio_median=med_ratio, ratio_med_lo=r_lo, ratio_med_hi=r_hi, ratio_q1=q1, ratio_q3=q3,
        ratio_mean=rme, ratio_mean_lo=rme_lo, ratio_mean_hi=rme_hi, ratio_trim10=stats.trim_mean(s["ratio"], 0.1),
        pct_ratio_lt1=100*(s["ratio"] < 1).mean(), pct_ratio_le0=100*(s["ratio"] <= 0).mean(),
        pct_ro_gt_rr=100*s["ro_gt_rr"].mean(), pct_sign_match=100*s["sign_match"].mean(),
        pct_replicated=100*s["replicated"].mean(),
        re_pooled=rep_, re_se=rese, re_lo=rep_-1.96*rese, re_hi=rep_+1.96*rese, tau2=tau2,
        Q_within=Qw, df_within=dfw, I2=I2, wilcoxon_p=w.pvalue, mean_pub_year=s["pub_year"].mean()))
res = pd.DataFrame(rows)

f = lambda x, d=3: "NA" if pd.isna(x) else f"{x:.{d}f}"
emit("## TABLA 1 — Descriptivos por dominio (d_fisher = fiso−fisr primaria; ratio = rr/ro co-primaria)")
emit("\n| dominio | n | d_fisher media [IC95] | d_fisher mediana | ro media (med) | rr media (med) | ro−rr media [IC95] | ratio med [IC95 boot] | ratio IQR | ratio recort.10% | ratio media [IC95] | %ro>rr | %ratio<1 | %ratio≤0 | %signo igual | %replicated | p Wilcoxon |")
emit("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
for _, r in res.iterrows():
    emit(f"| {r['domain']} | {r['n']} | {f(r['d_fisher_mean'])} [{f(r['d_fisher_lo'])}, {f(r['d_fisher_hi'])}] | {f(r['d_fisher_median'])} | "
         f"{f(r['ro_mean'])} ({f(r['ro_median'])}) | {f(r['rr_mean'])} ({f(r['rr_median'])}) | {f(r['d_corr_mean'])} [{f(r['d_corr_lo'])}, {f(r['d_corr_hi'])}] | "
         f"{f(r['ratio_median'])} [{f(r['ratio_med_lo'])}, {f(r['ratio_med_hi'])}] | [{f(r['ratio_q1'])}, {f(r['ratio_q3'])}] | {f(r['ratio_trim10'])} | {f(r['ratio_mean'])} [{f(r['ratio_mean_lo'])}, {f(r['ratio_mean_hi'])}] | "
         f"{r['pct_ro_gt_rr']:.1f} | {r['pct_ratio_lt1']:.1f} | {r['pct_ratio_le0']:.1f} | {r['pct_sign_match']:.1f} | {r['pct_replicated']:.1f} | {r['wilcoxon_p']:.2g} |")
emit("\n**IC de media** = t de Student sobre diferencias pareadas (n−1 gl); **IC de mediana** = bootstrap percentil B=2000 (semilla 20261022).")

emit("\n## TABLA 2 — Meta-análisis intra-dominio (DerSimonian-Laird) de d_fisher, pesos 1/(se_fiso²+se_fisr²)")
emit("\n| dominio | k | pooled RE [IC95] | tau² | Q_within (df) | I² |")
emit("|---|---|---|---|---|---|")
for _, r in res.iterrows():
    emit(f"| {r['domain']} | {r['n']} | {f(r['re_pooled'])} [{f(r['re_lo'])}, {f(r['re_hi'])}] | {f(r['tau2'])} | {r['Q_within']:.1f} ({r['df_within']}) | {r['I2']:.0f}% |")

# ---------------- CONTRASTES ENTRE PARES ----------------
emit("\n## CONTRASTES POR PARES (caída original−replicación)")
pairs = [("Cognitive", "Social"), ("Cognitive", "Economics"), ("Social", "Economics"), ("Psychology", "Economics")]
MASK = {"Cognitive": COG, "Social": SOC, "Economics": EE, "Psychology": PSY}
emit("\n| comparación | Δ media d_fisher [IC95 boot] | Welch p | Δ RE pooled (z, p) | Δ mediana ratio [IC95 boot] | Δ media ratio [IC95 boot] | MW p ratio | MW p d_fisher |")
emit("|---|---|---|---|---|---|---|---|")
cmp_rows = []
for a, b in pairs:
    X, Y = df[MASK[a]], df[MASK[b]]
    dm, dlo, dhi = boot_diff(X["d_fisher"].values, Y["d_fisher"].values, np.mean)
    tt = stats.ttest_ind(X["d_fisher"], Y["d_fisher"], equal_var=False)
    m1, s1, *_ = dl_re(X["d_fisher"], X["var_d"]); m2, s2, *_ = dl_re(Y["d_fisher"], Y["var_d"])
    dd = m1-m2; sed = np.hypot(s1, s2); z = dd/sed; pz = 2*stats.norm.sf(abs(z))
    dmed, mlo, mhi = boot_diff(X["ratio"].values, Y["ratio"].values, np.median)
    dme, melo, mehi = boot_diff(X["ratio"].values, Y["ratio"].values, np.mean)
    mwr = stats.mannwhitneyu(X["ratio"], Y["ratio"], alternative="two-sided")
    mwd = stats.mannwhitneyu(X["d_fisher"], Y["d_fisher"], alternative="two-sided")
    cmp_rows.append(dict(pair=f"{a} vs {b}", d_mean_diff=dm, d_lo=dlo, d_hi=dhi, welch_p=tt.pvalue,
        re_diff=dd, re_se=sed, re_z=z, re_p=pz, ratio_med_diff=dmed, rmed_lo=mlo, rmed_hi=mhi,
        ratio_mean_diff=dme, rmean_lo=melo, rmean_hi=mehi, mw_ratio_p=mwr.pvalue, mw_dfisher_p=mwd.pvalue))
    emit(f"| {a} vs {b} | {f(dm)} [{f(dlo)}, {f(dhi)}] | {tt.pvalue:.3f} | {f(dd)} (z={z:.2f}, p={pz:.3f}) | "
         f"{f(dmed)} [{f(mlo)}, {f(mhi)}] | {f(dme)} [{f(melo)}, {f(mehi)}] | {mwr.pvalue:.3f} | {mwd.pvalue:.3f} |")
pd.DataFrame(cmp_rows).to_csv("/workspace/analysis/results_pairwise.csv", index=False)

# ---------------- Q ENTRE DOMINIOS ----------------
emit("\n## CONTRASTE FORMAL ENTRE DOMINIOS (¿la caída NO es igual entre dominios?)")
def between_Q(masks):
    est = []; var = []
    for m in masks:
        e, s, *_ = dl_re(df[m]["d_fisher"], df[m]["var_d"]); est.append(e); var.append(s**2)
    est = np.array(est); var = np.array(var); w = 1/var
    grand = (w*est).sum()/w.sum(); Qb = (w*(est-grand)**2).sum(); dfb = len(est)-1
    return est, var, Qb, dfb, stats.chi2.sf(Qb, dfb)

for names, masks, tag in [(["Psychology", "Experimental Economics"], [PSY, EE], "NIVEL A (project)"),
                          (["Cognitive", "Social", "Economics"], [COG, SOC, EE], "NIVEL B (discipline)")]:
    est, var, Qb, dfb, p = between_Q(masks)
    emit(f"\n### {tag}")
    emit("- pooled RE d_fisher: " + " | ".join(f"{n} = {e:.3f} ± {np.sqrt(v):.3f}" for n, e, v in zip(names, est, var)))
    emit(f"- **Q_between = {Qb:.2f} (df = {dfb}), p = {p:.4f}**")
    for lab, col in [("d_fisher", "d_fisher"), ("ratio rr/ro", "ratio")]:
        obs, pp = perm_p([df[m][col].values for m in masks], F_oneway)
        kw = stats.kruskal(*[df[m][col].values for m in masks])
        emit(f"  - {lab}: permutación B={B} sobre F ANOVA: F = {obs:.3f}, p_perm = {pp:.4f} | Kruskal-Wallis H = {kw.statistic:.2f}, p = {kw.pvalue:.4f}")
    tab = np.array([[df[m]["ro_gt_rr"].sum(), m.sum()-df[m]["ro_gt_rr"].sum()] for m in masks])
    chi = stats.chi2_contingency(tab)
    emit("  - %ro>rr: " + " | ".join(f"{n} = {100*t[0]/t.sum():.1f}% ({t[0]}/{t.sum()})" for n, t in zip(names, tab)) +
         f" | chi2 = {chi.statistic:.2f}, p = {chi.pvalue:.4f}")
    tab2 = np.array([[df[m]["sign_match"].sum(), m.sum()-df[m]["sign_match"].sum()] for m in masks])
    chi2b = stats.chi2_contingency(tab2)
    emit("  - %signo igual: " + " | ".join(f"{n} = {100*t[0]/t.sum():.1f}%" for n, t in zip(names, tab2)) +
         f" | chi2 = {chi2b.statistic:.2f}, p = {chi2b.pvalue:.4f} (celdas pequeñas: usar como indicativo)")

m, lo, hi, se = ci_mean(df["d_fisher"])
gmed, glo, ghi = boot_stat(df["ratio"], np.median)
emit(f"\n## GLOBAL (86 estudios, 2 proyectos)\nd_fisher media = {m:.3f} [IC95 {lo:.3f}, {hi:.3f}] (SE pareada {se:.3f}); "
     f"ro media {df['ro'].mean():.3f} vs rr media {df['rr'].mean():.3f}; mediana ratio = {gmed:.3f} [{glo:.3f}, {ghi:.3f}]; "
     f"%ro>rr = {100*df['ro_gt_rr'].mean():.1f}; %signo igual = {100*df['sign_match'].mean():.1f}; %replicated = {100*df['replicated'].mean():.1f}")

