"""Chequeos de apoyo para la hipótesis (robustez del hallazgo en escala relativa)."""
import numpy as np, pandas as pd
from scipy import stats
rng = np.random.default_rng(7)
df = pd.read_csv("/workspace/data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv", na_values=["NA",""," "])
df["d_fisher"] = df["fiso"]-df["fisr"]; df["ratio"] = df["rr"]/df["ro"]
G = {"Cognitive": df.discipline.eq("Cognitive"), "Social": df.discipline.eq("Social"),
     "Economics": df.discipline.eq("Economics"), "Psychology": df["project.x"].eq("Psychology")}
print("== A) ratio rr/ro restringido a rr>0 (sin inversiones de signo): ¿se mantiene Cognitive > Social? ==")
for k, m in G.items():
    s = df[m & df.rr.gt(0)]
    b = np.median(rng.choice(s.ratio.values, size=(2000, len(s)), replace=True), axis=1)
    print(f"  {k}: n={len(s)} (de {int(m.sum())}), mediana ratio={s.ratio.median():.3f} IC95[{np.percentile(b,2.5):.3f},{np.percentile(b,97.5):.3f}]"
          f", media ro={s.ro.mean():.3f}, media rr={s.rr.mean():.3f}")
a, b = df[G["Cognitive"] & df.rr.gt(0)].ratio, df[G["Social"] & df.rr.gt(0)].ratio
print(f"  Mann-Whitney Cognitive vs Social (solo rr>0): p={stats.mannwhitneyu(a,b).pvalue:.3f}; diff medianas={a.median()-b.median():.3f}")

print("\n== B) ¿la inversión de ranking se debe a la escala base de ro? ==")
print("  ro media/mediana: " + "; ".join(f"{k}={df[m].ro.mean():.3f}/{df[m].ro.median():.3f}" for k, m in G.items()))
print("  correlación entre ro y d_fisher por dominio:")
for k, m in G.items():
    r, p = stats.pearsonr(df[m].ro, df[m]["d_fisher"]); rs, ps = stats.spearmanr(df[m].ro, df[m]["d_fisher"])
    print(f"    {k}: Pearson r={r:.3f} (p={p:.3f}), Spearman rho={rs:.3f} (p={ps:.3f})")
print("  correlación entre ro y ratio por dominio:")
for k, m in G.items():
    rs, ps = stats.spearmanr(df[m].ro, df[m].ratio)
    print(f"    {k}: Spearman rho={rs:.3f} (p={ps:.3f})")

print("\n== C) consistencia individual: ¿cuántos estudios caen > 2 SE al replicar? ==")
for k, m in G.items():
    s = df[m]; z = (df.loc[m,"fiso"]-df.loc[m,"fisr"])/np.sqrt(df.loc[m,"se_fiso"]**2+df.loc[m,"se_fisr"]**2)
    print(f"  {k}: % con (fiso-fisr) > 1.96*SE = {100*(z>1.96).mean():.1f}% ({int((z>1.96).sum())}/{len(s)});"
          f" % con d_fisher>0 = {100*(s.d_fisher>0).mean():.1f}%; % fisr<fisro con p<.05 ambos = "
          f"{100*((s.d_fisher>0)&(df.loc[m,'po']<=.05)&(df.loc[m,'pr']<=.05)).mean():.1f}")

print("\n== D) inversión de signo por dominio (rr<0 dado ro>0) ==")
for k, m in G.items():
    print(f"  {k}: {int((df.loc[m,'rr']<0).sum())}/{int(m.sum())} = {100*(df.loc[m,'rr']<0).mean():.1f}%")

print("\n== E) resumen de ranking por escala ==")
tab = pd.DataFrame({k: {"d_fisher_mean": df[m].d_fisher.mean(), "d_fisher_median": df[m].d_fisher.median(),
                        "ratio_median": df[m].ratio.median(), "ratio_trim10": stats.trim_mean(df[m].ratio, 0.1),
                        "pct_ro_gt_rr": 100*(df.loc[m,'ro'] > df.loc[m,'rr']).mean()} for k, m in G.items()}).T
print(tab.round(3).to_string())
print("\nRanking (1 = original mucho mayor que réplica):")
for col, asc in [("d_fisher_mean", False), ("ratio_median", True), ("pct_ro_gt_rr", False)]:
    print(f"  por {col}: " + " > ".join(tab[col].sort_values(ascending=asc).index) if asc is False
          else f"  por {col}: " + " < ".join(tab[col].sort_values(ascending=asc).index))
