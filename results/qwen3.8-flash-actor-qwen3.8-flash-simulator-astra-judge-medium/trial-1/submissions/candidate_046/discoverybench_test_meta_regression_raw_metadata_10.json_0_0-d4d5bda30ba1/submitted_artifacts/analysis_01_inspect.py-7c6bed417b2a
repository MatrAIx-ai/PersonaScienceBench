import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 100)

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
SUCC  = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(STUDY, dtype={'volume':str,'issue':str})
su = pd.read_csv(SUCC)

print("="*80); print("STUDY DATA"); print("="*80)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("\ndtypes/value_counts for key cols:")
for c in ['project','discipline','journal','replicated','aggregated','drop','seniority.o','seniority.r','lab_id','title','id']:
    if c not in df.columns: print(f"  -- missing col {c}"); continue
    s = df[c]
    nun = s.nunique(dropna=True)
    nmiss = s.isna().sum()
    print(f"\n--- {c}: nunique={nun} missing={nmiss} ({100*nmiss/len(df):.2f}%)")
    if nun <= 25:
        vc = s.value_counts(dropna=False)
        print(vc.to_string())
    else:
        print("  top 10:"); print(s.value_counts(dropna=False).head(10).to_string())
