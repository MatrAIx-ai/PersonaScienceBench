import pandas as pd, numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 100)
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv", dtype={'volume':str,'issue':str})

print("### rpp subset ###")
r = df[df.project=='rpp']
print("rows:", len(r), "| unique id:", r.id.nunique(), "| unique title:", r.title.nunique(),
      "| lab_id non-null:", r.lab_id.notna().sum(), "| aggregated:", r.aggregated.value_counts(dropna=False).to_dict(),
      "| drop:", r['drop'].value_counts(dropna=False).to_dict())
print("\nreplicated in rpp:", r.replicated.value_counts(dropna=False).to_dict())
print("discipline in rpp:", r.discipline.value_counts(dropna=False).to_dict())
print("\nseniority.o in rpp:\n", r['seniority.o'].value_counts(dropna=False).to_string())
print("\nseniority.r in rpp:\n", r['seniority.r'].value_counts(dropna=False).to_string())

print("\n### duplicates in rpp ###")
print("full-row dups:", r.duplicated().sum())
print("dup on id:", r.id.duplicated().sum())
sub = r[['id','title','authors.o','pub_year','journal','seniority.o','seniority.r','replicated','effect_size.o','p_value.o','n.r','lab_id','aggregated','drop']]
dup_ids = sub[sub.duplicated('id', keep=False)].sort_values('id')
print("rpp rows with repeated id:", len(dup_ids), "over", dup_ids.id.nunique(), "ids")
print(dup_ids.to_string())
