import pandas as pd, numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 100)
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv", dtype={'volume':str,'issue':str})
su = pd.read_csv("data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv")

print("### SUCCESS CSV ###  shape:", su.shape, "cols:", list(su.columns))
print("\nproject:\n", su.project.value_counts(dropna=False).to_string())
print("\nmissing counts:\n", su.isna().sum().to_string())
print("\ndup study names overall:", su.study.duplicated().sum())
psy = su[su.project=='Psychology']
print("\nPsychology rows:", len(psy), "| unique study:", psy.study.nunique(), "| dup study:", psy.study.duplicated().sum())
print("dup study names in Psychology:")
print(psy[psy.study.duplicated(keep=False)].sort_values('study')[['study','project','ro','rr','po','pr','no','nr']].to_string())

print("\n### drop / aggregated by project (study CSV) ###")
print(pd.crosstab([df.project, df['drop']], df.aggregated.fillna('NA'), dropna=False).to_string())

print("\n### rpp drop==True rows ###")
cols=['id','title','pub_year','journal','replicated','p_value.r','effect_size.r','n.r','seniority.o','seniority.r','aggregated','drop']
print(df[(df.project=='rpp') & (df['drop'])][cols].to_string())

print("\n### aggregated==True rows by project ###")
print(df[df.aggregated==True].groupby('project').size().to_string())
print(df[df.aggregated==True][['id','title','project','lab_id','drop','replicated']].head(30).to_string())

print("\n### ml1/ml3 structure ###")
for p in ['ml1','ml3']:
    s=df[df.project==p]
    print(p, "rows", len(s), "ids", s.id.nunique(), "labs", s.lab_id.nunique(), "aggregated", s.aggregated.value_counts(dropna=False).to_dict(), "drop", s['drop'].value_counts().to_dict())
