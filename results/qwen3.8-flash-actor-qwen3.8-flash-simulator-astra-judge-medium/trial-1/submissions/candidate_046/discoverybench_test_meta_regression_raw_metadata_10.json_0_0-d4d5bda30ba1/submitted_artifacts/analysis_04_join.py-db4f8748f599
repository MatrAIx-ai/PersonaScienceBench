def norm(s):
    s = str(s).lower(); s = re.sub(r'[^a-z ]',' ', s)
    return [t for t in s.split() if len(t) > 2]

def heuristic_join(pool, queries):
    q = queries.reset_index(drop=True).copy()
    out=[]
    surn = [norm(a) for a in pool['authors.o']]
    ids = pool['id'].tolist()
    for _,row in q.iterrows():
        toks = set(norm(row['study'])); best=None; sc=0
        for sid,sn in zip(ids,surn):
            inter = len(toks & set(sn))
            if inter>sc: best,sc=sid,inter
        out.append((best,sc))
    q[['match_id','shared_surnames']] = pd.DataFrame(out, index=q.index)
    return q

psy = heuristic_join(r, su[su['project']=='Psychology'])
print("\n### success 'Psychology' (n=%d) -> study CSV rpp (n=%d) via surname heuristic ###" % (len(psy), len(r)))
