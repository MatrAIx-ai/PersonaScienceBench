import pandas as pd, numpy as np
pd.set_option('display.width', 250)
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv", dtype={'volume':str,'issue':str})
su = pd.read_csv("data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv")
r = df[df['project']=='rpp'].copy()

print("### unmatched success-Psychology names: do they exist in rpp authors.o? ###")
for name in ['Eastwick','Finkel','Ranganath','Nosek']:
    hit = r[r['authors.o'].str.contains(name, na=False)]['id'].tolist()
    print(f"  {name}: rpp ids containing -> {hit}")
print("success Social Sciences study names (first 8):", su[su['project']=='Social Sciences']['study'].tolist()[:8])
print("success Experimental Philosophy names (first 8):", su[su['project']=='Experimental Philosophy']['study'].tolist()[:8])
print("rpp ids not found in success Psychology sample: 97 - 71 =", 97-71)

print("\n### junior definitions grid (dry-run preview, not submitted) ###")
DEFS = {
 'D1: Assistant Professor only': ['Assistant Professor'],
 'D2: AsstProf + Assistant': ['Assistant Professor','Assistant'],
 'D3: AsstProf + Assistant + Researcher': ['Assistant Professor','Assistant','Researcher'],
 'D4: everything below Associate Professor (D3)': ['Assistant Professor','Assistant','Researcher'],
}
FILT = {
 'F0 all rpp rows (n=97)': r,
 'F1 rpp & drop==False (n=%d)' % (r['drop']==False).sum(): r[~r['drop']],
 'F2 rpp & replicated==1 (n=%d)' % int((r['replicated']==1).sum()): r[r['replicated']==1],
 'F3 rpp & drop==False & replicated==1 (n=%d)' % int(((r['replicated']==1)&(~r['drop'])).sum()): r[(r['replicated']==1)&(~r['drop'])],
}
rows=[]
for fn, sub in FILT.items():
    for dn, cats in DEFS.items():
        for col in ['seniority.o','seniority.r']:
            k = int(sub[col].isin(cats).sum()); n = len(sub)
            rows.append([fn, dn, col, k, n, round(100*k/n,1)])
grid = pd.DataFrame(rows, columns=['filter','junior_def','seniority_col','junior_n','denom','pct'])
for col in ['seniority.o','seniority.r']:
    print("\n--- using", col, "---")
    print(grid[grid.seniority_col==col].drop(columns='seniority_col').pivot_table(index=['filter','junior_def'], values=['junior_n','denom','pct']).to_string())

print("\n### combined 'most senior across O&R line' check: cross-tab seniority.o x seniority.r (rpp) ###")
print(pd.crosstab(r['seniority.o'], r['seniority.r']).to_string())
