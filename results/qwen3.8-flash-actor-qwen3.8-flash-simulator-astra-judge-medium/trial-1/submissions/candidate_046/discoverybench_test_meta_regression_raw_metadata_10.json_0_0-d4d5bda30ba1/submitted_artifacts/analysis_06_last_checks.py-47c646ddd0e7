import pandas as pd, numpy as np, re
pd.set_option('display.width',250)
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv", dtype={'volume':str,'issue':str})
su = pd.read_csv("data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv")
r = df[df['project']=='rpp'].copy()
print("search 'Eastwick' anywhere in study CSV:", df.apply(lambda c: c.astype(str).str.contains('Eastwick', case=False, na=False)).any().sum(), "columns")
print("search 'Ranganath' anywhere:", df.apply(lambda c: c.astype(str).str.contains('Ranganath', case=False, na=False)).any().sum())
print("unique authors.o samples in rpp (first 3):", r['authors.o'].head(3).tolist())

# does success-Psychology correspond to non-dropped rpp rows?
def norm(s):
    s=str(s).lower(); s=re.sub(r'[^a-z ]',' ',s); return set(t for t in s.split() if len(t)>2)
surn=[norm(a) for a in r['authors.o']]; ids=r['id'].tolist()
psy=su[su['project']=='Psychology']
matched=[]
for _,row in psy.iterrows():
    toks=norm(row['study']); best=None; sc=0
    for sid,sn in zip(ids,surn):
        i=len(toks&sn)
        if i>sc: best,sc=sid,i
    matched.append(best if sc>=1 else None)
mt = pd.Series(matched, index=psy.index)
sub = r.set_index('id')
matched_drop = sub.loc[mt.dropna().tolist(),'drop']
print("\nof the 71 success-Psychology matched rpp rows, drop==True:", int(matched_drop.sum()), "| drop==False:", int((~matched_drop).sum()))
print("rpp rows NOT represented in success sample: n=%d, of which drop==True: %d" % (97-len(mt.dropna()), int(sub.loc[[i for i in sub.index if i not in set(mt.dropna())],'drop'].sum())))
# agreement of replication p-values
mg = psy.assign(match_id=mt.values).dropna(subset=['match_id']).merge(r[['id','p_value.r','effect_size.r']], left_on='match_id', right_on='id')
print("\nreplication p-value agreement (success pr vs study p_value.r): median abs diff = %.4f, exact = %d/%d" % (
  float((mg['pr']-mg['p_value.r']).abs().median()), int(((mg['pr']-mg['p_value.r']).abs()<1e-6).sum()), len(mg)))
print("sign agreement of rr vs effect_size.r:", int((np.sign(mg['rr'])==np.sign(mg['effect_size.r'])).sum()), "of", mg['effect_size.r'].notna().sum())
