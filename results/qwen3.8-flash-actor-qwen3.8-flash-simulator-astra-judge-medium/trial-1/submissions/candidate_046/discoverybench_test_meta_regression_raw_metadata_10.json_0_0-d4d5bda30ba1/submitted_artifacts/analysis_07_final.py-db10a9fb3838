"""
FINAL ANALYSIS
Q: What is the proportion of junior professors in replicated studies in Psychology?
Data: File A (study data) only; File B used as confirmatory cross-check only.
Approved decisions: (a) primary = all 97 rpp O/R pairs, (b) seniority.r primary line,
(c) junior = D2 {Assistant Professor, Assistant}, (d) keep drop==True in primary.
"""
import pandas as pd, numpy as np, math, json, os
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 100)

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
SUCC  = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"
OUT   = "analysis"; os.makedirs(OUT, exist_ok=True)

df = pd.read_csv(STUDY, dtype={'volume': str, 'issue': str})
su = pd.read_csv(SUCC)

# ---------- population ----------
# 'Psychology' replication project = project == 'rpp'. One row = one O/R pair.
# aggregated==True rows (study-level roll-ups, exist only for ml1/ml3) are excluded globally
# to avoid double counting; rpp rows all have aggregated = NaN, so this is a no-op for rpp.
df_nb = df[df['aggregated'].fillna(False) != True]
rpp = df_nb[df_nb['project'] == 'rpp'].copy()
assert rpp['id'].is_unique

JUNIOR = {
    'D1  Assistant Professor only':                    ['Assistant Professor'],
    'D2  Assistant Professor + Assistant (HEADLINE)':  ['Assistant Professor', 'Assistant'],
    'D3  + Researcher (below Associate Professor)':    ['Assistant Professor', 'Assistant', 'Researcher'],
}
FILTERS = {
    'F0  all rpp O/R pairs (PRIMARY)': rpp,
    'F1  drop == False':               rpp[~rpp['drop']],
    'F2  replicated == 1':             rpp[rpp['replicated'] == 1],
    'F3  drop == False & replicated==1': rpp[(rpp['replicated'] == 1) & (~rpp['drop'])],
    'F4  dedupe repeated titles':      rpp.drop_duplicates('title'),
}
COLS = ['seniority.r (PRIMARY)', 'seniority.o (parallel)']

def wilson(k, n, z=1.959963984540054):
    if n == 0: return (float('nan'), float('nan'))
    p = k / n
    d = 1 + z*z/n
    c = (p + z*z/(2*n)) / d
    h = z*math.sqrt(p*(1-p)/n + z*z/(4*n*n)) / d
    return (c - h, c + h)

rows = []
for fname, sub in FILTERS.items():
    n = len(sub)
    for dname, cats in JUNIOR.items():
        for label, col in zip(COLS, ['seniority.r', 'seniority.o']):
            k = int(sub[col].isin(cats).sum())
            lo, hi = wilson(k, n)
            rows.append(dict(filter=fname, junior_def=dname, seniority_line=label,
                             junior_k=k, denom_N=n, pct=round(100*k/n, 1),
                             wilson_lo=round(100*lo, 1), wilson_hi=round(100*hi, 1),
                             k_over_N=f"{k}/{n}"))
grid = pd.DataFrame(rows)
grid.to_csv(f"{OUT}/sensitivity_grid.csv", index=False)

# ---------- headline numbers ----------
N = len(rpp)
head = {}
for dname, cats in JUNIOR.items():
    k = int(rpp['seniority.r'].isin(cats).sum())
    lo, hi = wilson(k, N)
    head[dname] = (k, N, 100*k/N, 100*lo, 100*hi)
H = head['D2  Assistant Professor + Assistant (HEADLINE)']

print("="*98)
print("PRIMARY POPULATION: project == 'rpp' (Psychology replication project)")
print("="*98)
print(f"File A shape: {df.shape}; rows after excluding aggregated roll-ups: {len(df_nb)}; rpp rows: {N}")
print(f"unique ids: {rpp['id'].nunique()} | unique titles: {rpp['title'].nunique()} | "
      f"lab_id non-null: {rpp['lab_id'].notna().sum()} | aggregated non-null: {rpp['aggregated'].notna().sum()}")
print(f"usable seniority: seniority.r {rpp['seniority.r'].notna().sum()}/{N} | "
      f"seniority.o {rpp['seniority.o'].notna().sum()}/{N}   (0 missing -> denominator = {N})")
print(f"replicated in rpp: {rpp['replicated'].value_counts(dropna=False).to_dict()} | "
      f"drop==True: {int(rpp['drop'].sum())} | discipline: {rpp['discipline'].value_counts().to_dict()}")
print("\nHEADLINE (D2 junior on seniority.r): %d/%d = %.1f%%  [Wilson 95%% CI %.1f%% - %.1f%%]" % (H[0], H[1], H[2], H[3], H[4]))

print("\n" + "="*98); print("SENIORITY DISTRIBUTIONS INSIDE rpp (all 97)"); print("="*98)
dist = pd.DataFrame({'seniority.r': rpp['seniority.r'].value_counts(),
                     'seniority.o': rpp['seniority.o'].value_counts()}).fillna(0).astype(int)
order = ['Professor','Associate Professor','Assistant Professor','Assistant','Researcher']
print(dist.reindex(order).to_string())
print("\nrows where seniority.r != seniority.o: %d/%d (empirical basis for reading seniority.r as the replication-side lead)"
      % (int((rpp['seniority.r'] != rpp['seniority.o']).sum()), N))

print("\n" + "="*98); print("CROSSTAB seniority.o (rows) x seniority.r (cols), rpp n=%d" % N); print("="*98)
print(pd.crosstab(rpp['seniority.o'], rpp['seniority.r']).reindex(index=order, columns=order).fillna(0).astype(int).to_string())

print("\n" + "="*98); print("SENIORITY OF THE JUNIOR-LEAD ROWS (D2, seniority.r) BY REPLICATION OUTCOME"); print("="*98)
j = rpp[rpp['seniority.r'].isin(JUNIOR['D2  Assistant Professor + Assistant (HEADLINE)'])]
print("junior-lead studies: %d/%d = %.1f%% | replication success among them: %d/%d = %.1f%%"
      % (len(j), N, 100*len(j)/N, int((j['replicated']==1).sum()), len(j), 100*(j['replicated']==1).mean()))
nc = rpp[~rpp['seniority.r'].isin(JUNIOR['D2  Assistant Professor + Assistant (HEADLINE)'])]
print("senior-lead studies:  %d/%d | replication success among them: %d/%d = %.1f%%"
      % (len(nc), N, int((nc['replicated']==1).sum()), len(nc), 100*(nc['replicated']==1).mean()))

print("\n" + "="*98); print("FULL SENSITIVITY GRID (k/N and % everywhere)"); print("="*98)
for line in COLS:
    g = grid[grid['seniority_line'] == line]
    print(f"\n--- seniority line: {line} ---")
    print(g.pivot_table(index='junior_def', columns='filter', values='k_over_N', aggfunc='first', sort=False).to_string())
    print(g.pivot_table(index='junior_def', columns='filter', values='pct', aggfunc='first', sort=False).map(lambda v: f"{v:.1f}%").to_string())

# ---------- integrity checks requested ----------
print("\n" + "="*98); print("ARITHMETIC CHECKS"); print("="*98)
f2 = FILTERS['F2  replicated == 1']; n2 = len(f2)
for dname, cats in JUNIOR.items():
    k = int(f2['seniority.r'].isin(cats).sum())
    pct = round(100*k/n2, 1)
    ok = (float(k).is_integer() and 0 <= k <= n2 and abs(pct - 100*k/n2) < 0.05 and k == round(pct*n2/100))
    lo2, hi2 = wilson(k, n2)
    print(f"F2 (n={n2}) {dname[:2]}: {k}/{n2} = {pct}%  Wilson[{100*lo2:.1f}%, {100*hi2:.1f}%]  count<->pct coherent: {ok}")
tot = {d: int(rpp['seniority.r'].isin(c).sum()) for d, c in JUNIOR.items()}
assert tot['D1  Assistant Professor only'] == 23 and tot['D2  Assistant Professor + Assistant (HEADLINE)'] == 38 \
       and tot['D3  + Researcher (below Associate Professor)'] == 54
assert (rpp['seniority.r'].isin(order)).all(), "unexpected seniority.r category"
print("check: category counts sum to N ->", dist['seniority.r'].sum() == N and dist['seniority.o'].sum() == N)
print("check: D1 subset D2 subset D3 ->", tot['D1  Assistant Professor only'] <= tot['D2  Assistant Professor + Assistant (HEADLINE)'] <= tot['D3  + Researcher (below Associate Professor)'])

# ---------- confirmatory File B cross-check ----------
import re
def tok(s):
    return set(t for t in re.sub(r'[^a-z ]', ' ', str(s).lower()).split() if len(t) > 2)
psy = su[su['project'] == 'Psychology']
surn = [tok(a) for a in rpp['authors.o']]; ids = rpp['id'].tolist(); hits = 0
for _, row in psy.iterrows():
    t = tok(row['study'])
    if max((len(t & s) for s in surn), default=0) >= 1: hits += 1
print(f"\nFile B confirmatory check: {hits}/{len(psy)} 'Psychology' rows surname-match rpp "
      f"(File B carries no seniority field -> not used in the numerator/denominator).")

json.dump(dict(N=N, headline_junior_k=H[0], headline_pct=round(H[2], 1),
               wilson_ci=[round(H[3], 1), round(H[4], 1)],
               D1_k=tot['D1  Assistant Professor only'], D3_k=tot['D3  + Researcher (below Associate Professor)'],
               seniority_r_counts=dist['seniority.r'].reindex(order).to_dict(),
               seniority_o_counts=dist['seniority.o'].reindex(order).to_dict(),
               F2_n=n2, F2_D2_k=int(f2['seniority.r'].isin(JUNIOR['D2  Assistant Professor + Assistant (HEADLINE)']).sum()),
               F2_D3_k=int(f2['seniority.r'].isin(JUNIOR['D3  + Researcher (below Associate Professor)']).sum()),
               success_junior=[int((j['replicated']==1).sum()), len(j)],
               success_senior=[int((nc['replicated']==1).sum()), len(nc)]),
          open(f"{OUT}/headline_numbers.json", "w"), indent=2)
print("\nwrote analysis/sensitivity_grid.csv and analysis/headline_numbers.json")
