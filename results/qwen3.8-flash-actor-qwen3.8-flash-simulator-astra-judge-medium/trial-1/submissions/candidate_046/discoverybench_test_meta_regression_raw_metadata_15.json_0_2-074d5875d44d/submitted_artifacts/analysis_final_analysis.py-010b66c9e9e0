"""FINAL ANALYSIS
Question: What proportion of original studies in Experimental Economics were conducted in the United Kingdom?

Fixed definitions (approved by researcher):
  * Denominator: original studies with project == "ee", ONE ROW PER ORIGINAL STUDY, N = 18, no exclusions.
    Reported both unfiltered and restricted to non-missing experiment_country.o.
  * Numerator: STRICT United Kingdom criterion -> experiment_country.o == "United Kingdom"
    after whitespace/case normalisation. English-speaking originals (incl. Australia) do NOT count.
  * Unit of analysis: the ORIGINAL study.
  * The second CSV is NOT used in the computation (it has no country column); its only role was the
    1:1 validation of the 18 EERP originals.
"""
import math, re, pandas as pd
pd.set_option('display.width', 250); pd.set_option('display.max_rows', 300)

S = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
R = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

# ---------- 1. load & define population -------------------------------------
s = pd.read_csv(S)
ee = s[s['project'] == 'ee'].copy()

# normalisation + strict UK criterion
def norm_country(x):
    if pd.isna(x):
        return None
    return re.sub(r'\s+', ' ', str(x)).strip().lower().rstrip('.')

UK_SET = {'united kingdom', 'uk', 'u.k', 'great britain', 'britain', 'england', 'scotland', 'wales'}
ee['country_norm'] = ee['experiment_country.o'].apply(norm_country)
ee['is_uk'] = ee['country_norm'].isin(UK_SET)

N_all = len(ee)
known = ee[ee['country_norm'].notna()]
N_known = len(known)
k_uk = int(ee['is_uk'].sum())

print("=" * 78)
print("INTEGRITY CHECKS")
print("=" * 78)
print(f"study_data shape                         : {s.shape}")
print(f"rows with project == 'ee'                : {N_all}")
print(f"unique original ids / titles / authors.o : {ee['id'].nunique()} / {ee['title'].nunique()} / {ee['authors.o'].nunique()}")
print(f"fully duplicated rows within ee          : {int(ee.duplicated().sum())}")
print(f"drop == True within ee                   : {int((ee['drop'] == True).sum())}")
print(f"aggregated not-null within ee            : {int(ee['aggregated'].notna().sum())}")
print(f"lab_id not-null within ee (multi-lab)    : {int(ee['lab_id'].notna().sum())}")
print(f"missing experiment_country.o within ee   : {int(ee['experiment_country.o'].isna().sum())}")
print(f"-> one row per ORIGINAL study, no exclusions needed; N_all = {N_all}, N_country_known = {N_known} "
      f"(identical because ee has 0 missing countries)")
print(f"consistency us_lab.o == 1  : {int((ee['us_lab.o'] == 1).sum())}  vs  country == 'United States': "
      f"{int((ee['country_norm'] == 'united states').sum())}")
print("raw country values present in ee         :", sorted(ee['experiment_country.o'].dropna().unique().tolist()))
print("normalised values mapped to UK           :", sorted(set(ee.loc[ee['is_uk'], 'experiment_country.o'])))
print("multi-country / compound cells in ee     :",
      int(ee['experiment_country.o'].astype('object').fillna('').str.contains(r'[,;/]| and ', case=False).sum()))

# ---------- 2. cross-file validation (NOT used in the computation) ----------
r = pd.read_csv(R)
ree = r[r['project'] == 'Experimental Economics']
def first_surname(a):     # 'Steffen Huck and ...' -> 'huck'
    return str(a).split(' and ')[0].strip().split()[-1].strip(',.').lower()
def study_surname(x):     # 'Huck et al. (AER 2011)' -> 'huck' ; 'de Clippel et al. (AER 2014)' -> 'clippel'
    x = re.sub(r'\(.*?\)', '', str(x))
    x = x.split(',')[0].split(' and ')[0].split(' et al')[0].strip().lower()
    return x.split()[-1]                                   # keeps 'de Clippel' -> 'clippel'
A, B = sorted(map(first_surname, ee['authors.o'])), sorted(map(study_surname, ree['study']))
print(f"\nsecond CSV shape                         : {r.shape}; country-like columns: {[c for c in r.columns if 'countr' in c.lower()]}")
print(f"second CSV 'Experimental Economics' rows : {len(ree)}")
print(f"1:1 first-author-surname mapping          : {'EXACT 18/18' if A == B else (set(A) ^ set(B))}")
print("INTEGRITY NOTE: earlier apparent mismatches were string-normalisation artefacts only --")
print("  'de Clippel et al.' vs authors.o 'Geoffroy De Clippel' (particle 'de'/'De'), and a previous")
print("  blind .replace('de','') that corrupted 'Fudenberg' -> 'funberg'. With surname() = last token")
print("  after stripping the '(journal year)' tag, all 18 originals match 1:1; there is NO real discrepancy.")

# ---------- 3. main estimate + Wilson CI -----------------------------------
def wilson(k, n, conf=0.95):
    if n == 0:
        return (float('nan'), float('nan'))
    z = 1.959963984540054
    p, d = k / n, 1 + z * z / n
    c = p + z * z / (2 * n)
    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n))
    return ((c - h) / d, (c + h) / d)

lo, hi = wilson(k_uk, N_all)
print("\n" + "=" * 78); print("MAIN RESULT (strict United Kingdom)"); print("=" * 78)
print(f"numerator   (UK originals)              : {k_uk}")
print(f"denominator (all ee originals)          : {N_all}   -> {k_uk}/{N_all} = {k_uk/N_all*100:.2f}%")
print(f"denominator (country non-missing)       : {N_known} -> {int(known['is_uk'].sum())}/{N_known} = "
      f"{known['is_uk'].mean()*100:.2f}%")
print(f"95% Wilson CI (on {k_uk}/{N_all})         : [{lo*100:.2f}%, {hi*100:.2f}%]")
print("NOTE: with n = 18 a single study moves the estimate by 5.56 points; the interval is extremely")
print("      wide and reflects small-sample uncertainty, NOT real precision.")

print("\nSensitivity (context only, NOT the answer): originals whose language was English = "
      f"{int((ee['experiment_language.o'] == 'English').sum())}/{N_all} = "
      f"{(ee['experiment_language.o'] == 'English').mean()*100:.2f}% "
      "(includes US/Australian studies; the UK question is answered by country, not language).")

# ---------- 4. context tables ----------------------------------------------
tab = (ee['experiment_country.o'].fillna('(missing)')
         .value_counts(dropna=False).rename_axis('country').reset_index(name='n_originals'))
tab['pct_of_all_18'] = (tab['n_originals'] / N_all * 100).round(2)
tab['pct_of_country_known'] = (known['experiment_country.o'].value_counts().reindex(tab['country']).fillna(0)
                               .values / N_known * 100).round(2)
print("\nCOUNTRY TABLE -- ee original studies\n" + tab.to_string(index=False))

print("\nBY ORIGINAL LANGUAGE\n" + ee.groupby('experiment_language.o')
        .agg(n_originals=('id', 'size'), UK=('is_uk', 'sum'), pct_UK=('is_uk', lambda x: round(x.mean()*100, 2))).to_string())

print("\nBY JOURNAL x YEAR (original studies)\n" + pd.crosstab([ee['journal'], ee['pub_year']], 'n', margins=True).to_string())

print("\nEVIDENCE -- the single UK original\n" + ee.loc[ee['is_uk'],
      ['id', 'authors.o', 'pub_year', 'journal', 'experiment_country.o', 'experiment_language.o',
       'n.o', 'subjects.o', 'compensation.o', 'replicated', 'relative_es']].to_string(index=False))

print("\nALL 18 ee ORIGINALS (audit trail)")
print(ee.sort_values('id', key=lambda c: c.str.split('.').str[1].astype(int))[
      ['id', 'experiment_country.o', 'is_uk', 'journal', 'pub_year', 'n.o', 'experiment_language.o']].to_string(index=False))

HYP = (f"Among the original studies of the Experimental Economics replication project (project == 'ee') "
       f"in this dataset, {k_uk} of {N_all} ({k_uk/N_all*100:.2f}%, 95% Wilson CI {lo*100:.2f}%-{hi*100:.2f}%) "
       f"were conducted in the United Kingdom: the single case is Huck, Seltzer and Wallace (AER 2011), "
       f"id ee.13, n = 120, which was not replicated. The same proportion holds whether or not rows with a "
       f"missing original country are excluded ({k_uk}/{N_known} = {k_uk/N_known*100:.2f}%), because no ee row "
       f"has a missing country. The field is dominated by the United States (11/18 = 61.11%), followed by "
       f"Germany and Switzerland (2 each) and by Australia and Austria (1 each), so being conducted in the UK "
       f"was rare in this sample -- and it is not implied by language, since 13/18 originals used English yet "
       f"only one was in the UK. Scope limit: these files contain only the {N_all} originals of the Experimental "
       f"Economics project available here (16 in the American Economic Review, 2 in the Quarterly Journal of "
       f"Economics), one row per original study with a single replication each. Any additional originals that a "
       f"broader published catalogue of this replication project may contain are simply absent from these files, "
       f"so this proportion is a property of these {N_all} sampled originals and is not an estimate of the full "
       f"catalogue, about which these data support no claim.")
print("\nHYPOTHESIS\n" + HYP)
open('analysis/answer.txt', 'w').write(HYP + "\n")
