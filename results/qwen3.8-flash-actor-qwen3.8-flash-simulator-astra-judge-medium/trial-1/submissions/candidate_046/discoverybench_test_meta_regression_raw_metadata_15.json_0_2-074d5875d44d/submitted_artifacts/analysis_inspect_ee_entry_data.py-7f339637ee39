"""Step 1 (inspection only): verify entry data for the question
'What proportion of original studies in Experimental Economics were conducted in the UK?'
No final analysis is run here -- structure/quality checks only."""
import re, pandas as pd
pd.set_option('display.width', 250); pd.set_option('display.max_rows', 300)

S = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
R = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'
s, r = pd.read_csv(S), pd.read_csv(R)
print(f"[shapes] study_data={s.shape}  replication_success={r.shape}")
print("\n[project counts study_data]\n" + s['project'].value_counts(dropna=False).to_string())
print("\n[project counts success_data]\n" + r['project'].value_counts(dropna=False).to_string())

ee = s[s['project'] == 'ee'].copy()
print(f"\n[ee] rows={len(ee)}  unique id={ee['id'].nunique()}  unique title={ee['title'].nunique()} "
      f" unique authors.o={ee['authors.o'].nunique()}  dup rows(any col)={ee.duplicated().sum()}")
print("[ee] missing per .o column: " +
      str({c: int(ee[c].isna().sum()) for c in
           ['experiment_country.o','pub_year','journal','n.o','subjects.o','compensation.o','experiment_language.o']}))
print("\n[ee experiment_country.o value counts incl NaN]\n" + ee['experiment_country.o'].value_counts(dropna=False).to_string())
uk = re.compile(r'(\buk\b|u\.k\.?|united kingdom|great britain|england|scotland|wales|britain)', re.I)
allc = s['experiment_country.o'].astype('object').fillna('')
print("\n[UK name variants anywhere] " + str(allc[allc.apply(lambda x: bool(uk.search(str(x))))].unique().tolist()))
comp = allc.str.contains(r'[,;/]| and ', case=False, na=False)
print("[compound/multi-country cells anywhere] " + str(int(comp.sum())))
print("\n[ee journals]\n" + ee['journal'].value_counts(dropna=False).to_string())
print("\n[journal search across dataset] Economic Policy="
      f"{s['journal'].astype('object').str.contains('Economic Policy',case=False,na=False).sum()} "
      f"Experimental Economics={s['journal'].astype('object').str.contains('Experimental Economics',case=False,na=False).sum()}")
print("\n[ee exclusions] drop==True: %d | aggregated notnull: %d | lab_id notnull: %d"
      % ((ee['drop'] == True).sum(), ee['aggregated'].notna().sum(), ee['lab_id'].notna().sum()))
print("[dataset-wide exclusions by project] drop=%s aggregated=%s"
      % (s[s['drop']==True]['project'].value_counts().to_dict(), s[s['aggregated'].notna()]['project'].value_counts().to_dict()))
print("[missing experiment_country.o row(s)] " + s[s['experiment_country.o'].isna()][['id','project']].values.tolist().__repr__())
print("\n[ee consistency] us_lab.o==1: %d vs country=='United States': %d"
      % ((ee['us_lab.o']==1).sum(), (ee['experiment_country.o']=='United States').sum()))
tab = ee['experiment_country.o'].value_counts(dropna=False).rename_axis('country').reset_index(name='n_originals')
tab['pct_of_18'] = (tab['n_originals']/len(ee)*100).round(2)
print("\n[ee country table]\n" + tab.to_string(index=False))
print("\n[UK original(s)]\n" + ee[ee['experiment_country.o']=='United Kingdom'][
      ['id','authors.o','pub_year','journal','n.o','replicated']].to_string(index=False))

# cross-file check: does the second file add anything for this question?
ree = r[r['project'] == 'Experimental Economics']
def surname(a): return str(a).split(' and ')[0].split()[-1].strip(',.').lower().replace('de','').strip()
def surname2(x): return re.sub(r'\(.*?\)','',str(x)).split(',')[0].split(' and ')[0].split(' et al')[0].strip().lower().replace('de ','')
print("\n[cross-file] EERP rows=%d | country columns in second file: %s"
      % (len(ree), [c for c in r.columns if 'countr' in c.lower()]))
A, B = sorted(map(surname, ee['authors.o'])), sorted(map(surname2, ree['study']))
print("[cross-file] 1:1 original mapping by first-author surname: %s (%d vs %d); diff ee=%s diff eerp=%s"
      % (set(A) == set(B), len(A), len(B), set(A)-set(B), set(B)-set(A)))
