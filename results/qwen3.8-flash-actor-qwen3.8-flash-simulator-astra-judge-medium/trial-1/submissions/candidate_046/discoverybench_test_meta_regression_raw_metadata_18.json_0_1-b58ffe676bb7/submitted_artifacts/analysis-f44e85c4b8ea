#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Pregunta: What proportion of studies in Experimental Economics were conducted in a lab setting?

Alcance: los 18 estudios ORIGINALES del proyecto "ee" (Experimental Economics Replication
Project, AER/QJE) en meta-regression_study_data_heterogeneity_in_replication_projects.csv.

No existe una columna explicita "lab" para el estudio original -> la proporcion es una
APROXIMACION POR PROXY (Definiciones D1..D4 sobre las columnas del lado original *.o).

Reproducible: pandas + numpy + scipy, sin red.  Salida en ./outputs/
"""
import json
import re
import unicodedata
from pathlib import Path

import numpy as np
import pandas as pd
from scipy import stats

DATA = Path("data")
OUT = Path("outputs")
OUT.mkdir(exist_ok=True)
F_STUDY = DATA / "meta-regression_study_data_heterogeneity_in_replication_projects.csv"
F_REPL = DATA / "meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

LAB_SUBJECTS = {"students", "community"}          # pool reclutable en laboratorio
NONLAB_OR_UNCLS = {"online", "anyone", "mixed"}   # no clasificable como lab

# ---------------------------------------------------------------- helpers
def wilson_ci(x, n, conf=0.95):
    p = x / n
    z = stats.norm.ppf(1 - (1 - conf) / 2)
    d = 1 + z**2 / n
    c = (p + z**2 / (2 * n)) / d
    h = z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / d
    return max(0.0, c - h), min(1.0, c + h)

def clopper_pearson(x, n, conf=0.95):
    a = 1 - conf
    lo = 0.0 if x == 0 else stats.beta.ppf(a / 2, x, n - x + 1)
    hi = 1.0 if x == n else stats.beta.ppf(1 - a / 2, x + 1, n - x)
    return lo, hi

def one_sided_lower(x, n, conf=0.95):
    """Limite inferior unilateral: P(x=n | p=LB) = alpha  ->  LB = alpha^(1/n)."""
    return (1 - conf) ** (1 / n) if x == n else np.nan

def norm(s):
    s = unicodedata.normalize("NFKD", str(s)).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9 ]+", " ", s.lower())

PARTICLES = {"de", "van", "von", "der", "den", "del", "da", "di", "la", "el", "du", "ten", "ter"}
def surname_from_file1(authors_o):
    """Primer apellido del primer autor, ignorando particulas ('Geoffroy De Clippel' -> clippel)."""
    first = str(authors_o).split(" and ")[0]
    toks = [t for t in norm(first).split() if t]
    if len(toks) >= 2 and toks[-2] in PARTICLES:
        return toks[-2] + " " + toks[-1]
    return toks[-1] if toks else ""

def surname_from_file2(study):
    """'de Clippel et al. (AER 2014)' -> 'de clippel';  'Abeler et al. (AER 2011)' -> 'abeler'."""
    head = str(study).split("(")[0]
    head = re.sub(r"\bet al\.?", " ", head, flags=re.I)
    toks = [t for t in norm(head).split() if t and t not in {"and"}]
    out = []
    for t in toks[:2]:
        out.append(t)
        if t not in PARTICLES:
            break
    return " ".join(out)

JOURNAL_ABBR = {"aer": "the american economic review", "qje": "the quarterly journal of economics"}

# ---------------------------------------------------------------- 1. carga y poblacion
df = pd.read_csv(F_STUDY)
df2 = pd.read_csv(F_REPL)

log = {}
log["shape_study_file"] = list(df.shape)
log["shape_success_file"] = list(df2.shape)
log["project_counts_all_rows"] = df["project"].value_counts(dropna=False).to_dict()
log["rows_total"] = int(len(df))
log["unique_ids_total"] = int(df["id"].nunique())
log["duplicate_id_rows_total"] = int(df["id"].duplicated().sum())

ee = df[df["project"] == "ee"].copy()
log["ee_rows"] = int(len(ee))
log["ee_unique_ids"] = int(ee["id"].nunique())
log["ee_duplicate_id_rows"] = int(ee["id"].duplicated().sum())

# Unidad "estudio unico": titulo normalizado + primer apellido
ee["study_key"] = (ee["title"].map(norm).str.replace(r"\s+", " ", regex=True).str.strip()
                   + " || " + ee["authors.o"].map(surname_from_file1))
log["ee_unique_study_keys"] = int(ee["study_key"].nunique())
log["ee_unique_titles"] = int(ee["title"].nunique())

# Efecto de la columna drop (ambas cifras, por transparencia)
log["ee_drop_true"] = int(ee["drop"].sum())
ee_kept = ee[~ee["drop"].astype(bool)].copy()
log["ee_rows_after_drop_filter"] = int(len(ee_kept))

# ---------------------------------------------------------------- 2. clasificacion lab (proxy)
def classify(row):
    onl, sub = row["online.o"], row["subjects.o"]
    if pd.isna(onl) or pd.isna(sub) or str(sub).strip().lower() in NONLAB_OR_UNCLS or onl == 1:
        return "unclassifiable"
    if onl == 0 and str(sub).strip().lower() in LAB_SUBJECTS:
        return "lab"
    return "not_lab"

ee_kept["lab_class"] = ee_kept.apply(classify, axis=1)
freq = pd.crosstab(ee_kept["subjects.o"], ee_kept["online.o"], margins=True, margins_name="TOTAL")

# ---------------------------------------------------------------- 3. definiciones D1..D4
defs = {
    "D1 primaria: online.o==0 AND subjects.o in {students,community}":
        (ee_kept["online.o"] == 0) & ee_kept["subjects.o"].isin(LAB_SUBJECTS),
    "D2 laxa: online.o==0":
        ee_kept["online.o"] == 0,
    "D3 estricta: online.o==0 AND subjects.o=='students'":
        (ee_kept["online.o"] == 0) & (ee_kept["subjects.o"] == "students"),
    "D4 corroboracion (lado replicacion): online.r==0 AND subjects.r in {students,community}":
        (ee_kept["online.r"] == 0) & ee_kept["subjects.r"].isin(LAB_SUBJECTS),
}

# "no clasificable" se define EN LA FASE DE INSUMOS (independiente de la definicion usada):
# online.o o subjects.o ausentes, online.o == 1, o subjects.o en {online, anyone, mixed}.
unc_mask = ee_kept["lab_class"].eq("unclassifiable")
log["ee_unclassifiable_rows"] = int(unc_mask.sum())

rows = []
for name, m in defs.items():
    n = int(len(ee_kept))
    num = int(m.sum())
    uncls = int(unc_mask.sum())          # identico para todas las definiciones
    notlab = n - num - uncls
    wil = wilson_ci(num, n); cp = clopper_pearson(num, n); osl = one_sided_lower(num, n)
    rows.append(dict(definition=name, numerator=num, denominator=n, proportion=num / n,
                     certainly_lab=num, not_lab=notlab, unclassifiable=uncls,
                     LB_excl_unclassifiable=num / n,
                     UB_incl_unclassifiable=(num + uncls) / n,
                     wilson_low=wil[0], wilson_high=wil[1],
                     cp_low=cp[0], cp_high=cp[1], one_sided_95_low=osl))
sens = pd.DataFrame(rows)

# ---------------------------------------------------------------- 4. desglose descriptivo us_lab.o
us = ee_kept["us_lab.o"].value_counts().rename_axis("us_lab.o").reset_index(name="n")
us["lectura"] = us["us_lab.o"].map({1: "lab en EE. UU.", 0: "lab fuera de EE. UU. (NO 'no-lab')"})

# ---------------------------------------------------------------- 5. join con archivo 2 (control de procedimiento)
e2 = df2[df2["project"] == "Experimental Economics"].copy()
ee_kept["j_key"] = ee_kept["authors.o"].map(surname_from_file1) + "|" + ee_kept["pub_year"].astype(str)
e2["j_key"] = e2["study"].map(surname_from_file2) + "|" + e2["study"].astype(str).str.extract(r"(\d{4})")[0]
ee_kept["j_jr"] = ee_kept["journal"].map(norm).str.strip()
e2["j_abbr"] = e2["study"].str.extract(r"\(([A-Za-z]+)\s*\d{4}\)")[0].str.lower().map(JOURNAL_ABBR)
j = ee_kept.merge(e2[["study", "j_key", "j_abbr", "no", "nr"]], on="j_key", how="outer", indicator=True)
j["journal_ok"] = j["j_jr"].eq(j["j_abbr"])
matched = int((j["_merge"] == "both").sum())
resid = j.loc[j["_merge"] != "both", ["id", "title", "study", "_merge"]]
log["join_matched"] = matched
log["join_target"] = 18
log["join_residual_rows"] = int(len(resid))
log["join_journal_conflicts"] = int((j["journal_ok"] == False).sum())
log["join_n_o_discrepancies"] = int((j["no"].astype(float) != j["n.o"].astype(float)).sum())
# nota: 'no' del archivo 2 no coincide con n.o -> no se usa para validar n

# ---------------------------------------------------------------- 6. salidas
freq.to_csv(OUT / "freq_subjects_x_online_ee.csv")
sens.to_csv(OUT / "sensitivity_definitions_ee.csv", index=False)
us.to_csv(OUT / "us_lab_breakdown_ee.csv", index=False)
j.to_csv(OUT / "join_control_file2_ee.csv", index=False)
resid.to_csv(OUT / "join_residuals_ee.csv", index=False)
ee_kept[["id", "title", "authors.o", "pub_year", "online.o", "subjects.o", "online.r", "subjects.r",
         "us_lab.o", "experiment_country.o", "drop", "lab_class"]].to_csv(OUT / "ee_rows_classified.csv", index=False)

prim = sens.iloc[0]
HYP = (
    "HIPOTESIS (aproximacion por proxy, no una medicion directa): entre los 18 estudios originales "
    "del proyecto de replicacion de Economia Experimental (EERP; 16 AER, 2 QJE, 2011-2014) contenidos en "
    "meta-regression_study_data_heterogeneity_in_replication_projects.csv, {p:.1f}% ({n}/{d}) fueron "
    "conducidos en un entorno de laboratorio, definido operacionalmente como {defn} "
    "(ninguna columna 'lab' describe el setting del estudio original: lab_id y aggregated estan ausentes "
    "en el 100% de las filas ee). IC 95% Wilson [{wl:.3f}, {wh:.3f}]; Clopper-Pearson exacto [{cl:.3f}, {ch:.3f}]; "
    "con p=1 en el borde el intervalo es esencialmente unilateral (limite inferior unilateral 95% = 0.05^(1/18) = "
    "{osl:.3f}). El conjunto 'no clasificable' esta vacio (0/18: no hay valores online/anyone/mixed ni nulos), de modo "
    "que el limite inferior y el superior de la proporcion coinciden ({lb:.3f}-{ub:.3f}); la sensibilidad es identica "
    "bajo las definiciones D2 (online.o==0: {n2}/{d}), D4 (lado replicacion: {n4}/{d}) y casi identica bajo la "
    "definicion estricta D3 (solo estudiantes: {n3}/{d}). Excluir las filas con drop=True no cambia la cifra (0 de 18 "
    "marcadas). Salvedades: n=18 (IC ancho), unidad = par O/R por fila (coincidente con 18 estudios unicos por titulo+primer "
    "apellido), y el alcance son exclusivamente estos 18 estudios originales de EERP, no la literatura general de "
    "Economia Experimental. Contexto descriptivo: {us1}/18 tenian laboratorio en EE. UU. y {us0}/18 fuera de EE. UU. "
    "(us_lab.o distingue pais del laboratorio, no laboratorio vs no laboratorio)."
).format(p=100 * prim["proportion"], n=int(prim["numerator"]), d=int(prim["denominator"]),
         defn="experimento no online (online.o == 0) y sujetos 'students' o 'community'",
         wl=prim["wilson_low"], wh=prim["wilson_high"], cl=prim["cp_low"], ch=prim["cp_high"],
         osl=prim["one_sided_95_low"], lb=prim["LB_excl_unclassifiable"], ub=prim["UB_incl_unclassifiable"],
         n2=int(sens.iloc[1]["numerator"]), n3=int(sens.iloc[2]["numerator"]), n4=int(sens.iloc[3]["numerator"]),
         us1=int(us.loc[us["us_lab.o"] == 1, "n"].iloc[0]), us0=int(us.loc[us["us_lab.o"] == 0, "n"].iloc[0]))
(OUT / "hypothesis.txt").write_text(HYP, encoding="utf-8")

HYP_EN = (
    "HYPOTHESIS (proxy-based approximation, not a direct measurement): among the 18 original studies of the "
    "Experimental Economics Replication Project (EERP; 16 AER, 2 QJE, 2011-2014) contained in "
    "meta-regression_study_data_heterogeneity_in_replication_projects.csv, {p:.1f}% ({n}/{d}) were conducted in a lab "
    "setting, operationally defined as a non-online experiment (online.o == 0) with 'students' or 'community' subjects; "
    "no column describes the original study's setting directly (lab_id and aggregated are missing in 100% of ee rows). "
    "95% CI Wilson [{wl:.3f}, {wh:.3f}]; exact Clopper-Pearson [{cl:.3f}, {ch:.3f}]; at the p=1 boundary the interval is "
    "effectively one-sided (one-sided 95% lower bound = 0.05^(1/18) = {osl:.3f}). The 'unclassifiable' set is empty "
    "(0/18: no online/anyone/mixed values and no nulls), so the lower and upper bounds of the proportion coincide "
    "({lb:.3f}-{ub:.3f}); results are identical under D2 (online.o==0: {n2}/{d}) and D4 (replication side: {n4}/{d}) and "
    "nearly identical under the strict D3 (students only: {n3}/{d}). Excluding drop=True rows does not change the figure "
    "(0 of 18 flagged). Caveats: n=18 (wide CI), unit = one O/R pair per row (equal to 18 unique studies by title + first "
    "surname), and the scope is only these 18 EERP original studies, not the general Experimental Economics literature. "
    "Descriptive context: {us1}/18 ran in a US lab and {us0}/18 in a non-US lab (us_lab.o encodes the lab's country, not "
    "lab vs non-lab)."
).format(p=100 * prim["proportion"], n=int(prim["numerator"]), d=int(prim["denominator"]),
         wl=prim["wilson_low"], wh=prim["wilson_high"], cl=prim["cp_low"], ch=prim["cp_high"],
         osl=prim["one_sided_95_low"], lb=prim["LB_excl_unclassifiable"], ub=prim["UB_incl_unclassifiable"],
         n2=int(sens.iloc[1]["numerator"]), n3=int(sens.iloc[2]["numerator"]), n4=int(sens.iloc[3]["numerator"]),
         us1=int(us.loc[us["us_lab.o"] == 1, "n"].iloc[0]), us0=int(us.loc[us["us_lab.o"] == 0, "n"].iloc[0]))
(OUT / "hypothesis_en.txt").write_text(HYP_EN, encoding="utf-8")

# ---------------------------------------------------------------- 7. reporte por consola
pd.set_option("display.width", 250); pd.set_option("display.max_columns", 50)
print("== POBLACION ==");  print(json.dumps(log, indent=1, default=str))
print("\n== TABLA DE FRECUENCIAS subjects.o x online.o (ee, tras filtro drop) =="); print(freq.to_string())
print("\n== TABLA DE SENSIBILIDAD (D1-D4) ==")
print(sens[["definition", "numerator", "denominator", "proportion", "certainly_lab", "not_lab",
            "unclassifiable", "LB_excl_unclassifiable", "UB_incl_unclassifiable",
            "wilson_low", "wilson_high", "cp_low", "cp_high", "one_sided_95_low"]].to_string(index=False))
print("\n== DESGLOSE us_lab.o (descriptivo: lab en EE. UU. vs fuera; NO lab/no-lab) =="); print(us.to_string(index=False))
print("\n== CLASIFICACION D1 por estudio ==")
print(ee_kept[["id", "title", "online.o", "subjects.o", "online.r", "subjects.r", "us_lab.o", "lab_class"]].to_string(index=False))
print("\n== HIPOTESIS =="); print(HYP)
