"""
Average length (pages) of ORIGINAL papers: Experimental Economics (ee) vs Psychology (rpp).
Data: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
Approach approved by researcher:
  - unit of analysis = study (dedup by `id`), NOT the lab-level row
  - main figures: ee (n=18) and rpp (n=97), no `drop` filter
  - alternative definitions of "Psychology" reported but flagged as alternatives
  - no join with the replication_success CSV (no length column, different study set)
"""
import numpy as np, pandas as pd

RNG = np.random.default_rng(20261022)
B = 2000
CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(CSV)
print(f"[raw] shape = {df.shape}")

# ---------- integrity checks ----------
assert df["length"].notna().all()
assert (df["length"] > 0).all()
assert df.groupby("id")["length"].nunique().max() == 1          # length constant within study
assert df["length"].dtype.kind in "iu"                          # integer, no text/ranges

# ---------- dedup to study level ----------
study = df.drop_duplicates("id").copy()
print(f"[study level] unique ids = {len(study)}")
print(study["project"].value_counts().to_string())

def stats(s):
    s = np.asarray(s, dtype=float)
    return dict(n=len(s), mean=s.mean(), median=np.median(s), sd=s.std(ddof=1),
                min=s.min(), max=s.max())

def boot_ci(a, b=None, stat="mean", B=B, alpha=0.05):
    a = np.asarray(a, float)
    n = len(a)
    if stat == "mean":
        f = lambda x: x.mean()
    elif stat == "diff":
        f = lambda x, y: x.mean() - y.mean()
    elif stat == "ratio":
        f = lambda x, y: x.mean() / y.mean()
    if b is None:
        reps = np.array([f(a[RNG.integers(0, n, n)]) for _ in range(B)])
    else:
        m = len(b)
        reps = np.array([f(a[RNG.integers(0, n, n)], b[RNG.integers(0, m, m)]) for _ in range(B)])
    return np.percentile(reps, [100*alpha/2, 100*(1-alpha/2)])

# ---------- MAIN TABLE ----------
ee   = study.loc[study.project == "ee", "length"].values
rpp  = study.loc[study.project == "rpp", "length"].values
mls  = study.loc[study.project.isin(["ml1", "ml3"]), "length"].values
soco = study.loc[study.discipline.isin(["Social", "Cognitive"]), "length"].values

rows = []
for label, v, kind in [("Experimental Economics (project == 'ee')", ee, "MAIN"),
                       ("Psychology (project == 'rpp')", rpp, "MAIN"),
                       ("Psychology alt A (rpp+ml1+ml3)", np.r_[rpp, mls], "alternative"),
                       ("Psychology alt B (discipline Social+Cognitive)", soco, "alternative")]:
    st = stats(v)
    lo, hi = boot_ci(v)
    rows.append(dict(grouping=label, role=kind, n=st["n"], mean=round(st["mean"], 2),
                     boot_mean_CI95=f"[{lo:.2f}, {hi:.2f}]", median=st["median"],
                     sd=round(st["sd"], 2), minmax=f"{int(st['min'])}-{int(st['max'])}"))
main_tab = pd.DataFrame(rows)

# ---------- comparison ee vs rpp ----------
dlo, dhi = boot_ci(ee, rpp, "diff")
rlo, rhi = boot_ci(ee, rpp, "ratio")
cmp_tab = pd.DataFrame([
    dict(quantity="mean ee - mean rpp (pages)",
         value=round(ee.mean() - rpp.mean(), 2), boot_CI95=f"[{dlo:.2f}, {dhi:.2f}]"),
    dict(quantity="mean ee / mean rpp (ratio)",
         value=round(ee.mean() / rpp.mean(), 2), boot_CI95=f"[{rlo:.2f}, {rhi:.2f}]"),
])
# how many bootstrap replicates of the difference are > 0 (two-sided bootstrap p)
reps = np.array([ee[RNG.integers(0, len(ee), len(ee))].mean() - rpp[RNG.integers(0, len(rpp), len(rpp))].mean()
                 for _ in range(B)])
p_boot = 2 * min((reps <= 0).mean(), (reps >= 0).mean())

# ---------- sensitivity controls ----------
sens = []
def add(name, v, note=""):
    st = stats(v)
    sens.append(dict(control=name, n=st["n"], mean=round(st["mean"], 2),
                     median=st["median"], note=note))

add("ee - main (dedup, no drop filter)", ee)
add("rpp - main (dedup, no drop filter)", rpp)
add("rpp - excluding drop == True", study.loc[(study.project == "rpp") & (study["drop"] == False), "length"].values,
    "7 studies flagged drop")
add("ee - excluding drop == True", study.loc[(study.project == "ee") & (study["drop"] == False), "length"].values)
add("rpp - row-wise, NO dedup (927 rows)", df.loc[df.project == "rpp", "length"].values)
add("ee - row-wise, NO dedup (927 rows)", df.loc[df.project == "ee", "length"].values)
def trimmed(v, frac=0.05):
    v = np.sort(np.asarray(v, float)); k = int(round(frac * len(v)))
    return v[k:len(v) - k] if k > 0 else v
add("rpp - trimmed mean (5% each tail)", trimmed(rpp), "k=%d each tail, not main estimate" % int(round(.05*len(rpp))))
add("rpp - winsorized at p95", np.clip(rpp, None, np.quantile(rpp, .95)))
add("ee - trimmed mean (5% each tail)", trimmed(ee), "k=%d each tail, not main estimate" % int(round(.05*len(ee))))
add("ee - winsorized at p95", np.clip(ee, None, np.quantile(ee, .95)))
add("rpp - excluding papers of 1-3 pages", rpp[rpp > 3], "8 short papers removed; main figure keeps them")
add("ee - excluding papers of 1-3 pages", ee[ee > 3], "none qualify (ee min = 16 pp)")
sens_tab = pd.DataFrame(sens)

# short papers (1-3 pages) kept in main figures, quantified for discussion
tot = study.groupby("project")["id"].size().rename("n_studies")
short = (study.assign(is_short=study.length <= 3).groupby("project")["is_short"].sum().rename("n_short_1to3p")
         .to_frame().join(tot))
short["pct_short"] = (100 * short.n_short_1to3p / short.n_studies).round(1)
overlap = ((rpp >= ee.min()) & (rpp <= ee.max())).sum()

# ---------- parametric / nonparametric cross-checks on the same contrast ----------
from scipy import stats as sps
welch = sps.ttest_ind(ee, rpp, equal_var=False)
mwu   = sps.mannwhitneyu(ee, rpp, alternative="two-sided")
prob_ee_gt_rpp = mwu.statistic / (len(ee) * len(rpp))

# ---------- print ----------
pd.set_option("display.width", 220); pd.set_option("display.max_colwidth", 60)
print("\n=== MAIN TABLE (study level, dedup by id) ===");            print(main_tab.to_string(index=False))
print("\n=== ee vs rpp COMPARISON (bootstrap, B=%d) ===" % B);      print(cmp_tab.to_string(index=False))
print(f"bootstrap two-sided p for difference > 0: {p_boot:.4f}")
print("\n=== SENSITIVITY CONTROLS ===");                             print(sens_tab.to_string(index=False))
print("\n=== papers of 1-3 pages (kept in main estimate) ===");      print(short.to_string())
print(f"\nrpp papers inside the ee range [{int(ee.min())}-{int(ee.max())}]: {overlap} of {len(rpp)}"
      f" | ee papers below rpp median: {(ee < np.median(rpp)).sum()}")
print("ee lengths:", sorted(int(x) for x in ee))
print("\n=== second CSV (not usable for length) ===")
d2 = pd.read_csv("data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv")
print("shape", d2.shape, "| length-like cols:", [c for c in d2.columns if "len" in c or "page" in c])
print(d2["project"].value_counts().to_string())

print("\n=== cross-checks on ee vs rpp ===")
print(f"Welch t = {welch.statistic:.3f}, df = {welch.df:.1f}, p = {welch.pvalue:.2e}")
print(f"Mann-Whitney U = {mwu.statistic:.1f}, p = {mwu.pvalue:.2e}; P(length_ee > length_rpp) = {prob_ee_gt_rpp:.3f}")

main_tab.to_csv("analysis/table_main_length_by_field.csv", index=False)
cmp_tab.to_csv("analysis/table_comparison_ee_vs_rpp.csv", index=False)
sens_tab.to_csv("analysis/table_sensitivity_controls.csv", index=False)
