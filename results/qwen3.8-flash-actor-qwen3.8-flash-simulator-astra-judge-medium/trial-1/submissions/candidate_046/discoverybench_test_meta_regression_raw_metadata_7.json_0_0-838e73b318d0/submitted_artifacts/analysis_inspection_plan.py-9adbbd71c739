"""Inspection-only script (no final hypothesis).
Produces structural diagnostics for the male-author-majority question."""
import pandas as pd, numpy as np
pd.set_option('display.width', 220)

P1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
P2 = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(P1)
df2 = pd.read_csv(P2)
df['agg'] = df['aggregated'].astype('boolean').fillna(False)
df['drop_b'] = df['drop'].astype('boolean')

out = {}
out['shape_file1'] = df.shape
out['shape_file2'] = df2.shape
out['key_cols_present'] = {c: c in df.columns for c in
    ['authors.o','authors_male.o','authors_male.r','discipline','project','aggregated','drop','n_authors.o','n_authors.r','lab_id']}
out['missing_pct_authors_male'] = {c: round(df[c].isna().mean()*100, 2) for c in ['authors_male.o','authors_male.r']}
out['ratio_summary'] = {c: {'min': df[c].min(), 'max': df[c].max(), 'mean': round(df[c].mean(),3),
                            'median': round(df[c].median(),3), 'n_eq1': int((df[c]==1).sum()),
                            'n_gt0.5': int((df[c]>0.5).sum()), 'n_eq0.5': int((df[c]==0.5).sum()),
                            'n_eq0': int((df[c]==0).sum()), 'n_unique': int(df[c].nunique())}
                        for c in ['authors_male.o','authors_male.r']}
out['discipline_rows'] = df['discipline'].value_counts().to_dict()
out['project_rows'] = df['project'].value_counts().to_dict()
out['discipline_x_project_rows'] = pd.crosstab(df['project'], df['discipline']).to_dict()

# one row per O/R pair: aggregated row for Many Labs, single row otherwise
mask_use = (~df['agg']) & (~df['id'].isin(df.loc[df['agg'],'id']))
pairs = pd.concat([df[mask_use], df[df['agg']]]).sort_values('id')
out['n_pairs'] = len(pairs); out['n_unique_ids'] = int(pairs['id'].nunique())
out['pairs_by_project'] = pairs['project'].value_counts().to_dict()
out['pairs_by_discipline'] = pairs['discipline'].value_counts().to_dict()
out['pairs_drop_true'] = int(pairs['drop_b'].sum())
out['rows_excluded_as_labrows'] = int(len(df)-len(pairs))
print("== structural diagnostics ==")
for k, v in out.items():
    print(f"{k}: {v}")
print("\n== file2 (no gender vars) ==")
print("cols:", list(df2.columns))
print("projects:", df2['project'].value_counts().to_dict())
pairs.to_csv('analysis/pairs_view.csv', index=False)
print("\nwrote analysis/pairs_view.csv rows:", len(pairs))
