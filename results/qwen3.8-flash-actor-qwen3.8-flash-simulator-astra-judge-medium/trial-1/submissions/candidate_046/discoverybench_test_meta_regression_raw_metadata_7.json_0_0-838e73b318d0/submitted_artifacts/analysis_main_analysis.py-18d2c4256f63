"""Domain-level analysis of male author majority in original AND replication studies.

Unit (primary): one row per O/R pair (id, n=141); aggregated row for Many Labs (ml1/ml3),
single row for rpp/ee. Primary majority rule: authors_male ratio > 0.5 (strict).
Author gender in authors_male.* is NAME-INFERRED binary gender supplied by the dataset
authors; it is not self-reported.
"""
import numpy as np, pandas as pd
from scipy import stats

pd.set_option('display.width', 240)
P1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
P2 = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k / n
    d = 1 + z**2/n
    c = (p + z**2/(2*n)) / d
    h = z*np.sqrt(p*(1-p)/n + z**2/(4*n**2)) / d
    return (max(0.0, c-h), min(1.0, c+h))

df = pd.read_csv(P1)
df['agg'] = df['aggregated'].astype('boolean').fillna(False)
df['drop_b'] = df['drop'].astype('boolean')
for c in ['authors_male.o', 'authors_male.r']:
    df[c+'_males'] = (df[c]*df[c.replace('authors_male','n_authors')].fillna(0)).round().astype(int)
    df[c+'_nauth'] = df[c.replace('authors_male', 'n_authors')]

# ---------- primary pair view ----------
use = (~df['agg']) & (~df['id'].isin(df.loc[df['agg'], 'id']))
pairs = pd.concat([df[use], df[df['agg']]]).sort_values('id').reset_index(drop=True)
assert len(pairs) == pairs['id'].nunique() == 141

def flags(d, thr):
    op = (d['authors_male.o'] > thr) if thr == 'gt' else (d['authors_male.o'] >= thr_val)
    rp = (d['authors_male.r'] > thr) if thr == 'gt' else (d['authors_male.r'] >= thr_val)
    return op.astype(bool), rp.astype(bool)

def domain_table(d, group, thr='gt', thr_val=0.5):
    thr_val = 0.5
    o = (d['authors_male.o'] > 0.5) if thr == 'gt' else (d['authors_male.o'] >= thr_val)
    r = (d['authors_male.r'] > 0.5) if thr == 'gt' else (d['authors_male.r'] >= thr_val)
    d = d.assign(maj_o=o, maj_r=r, both=o & r)
    rows = []
    for dom, g in d.groupby(group, sort=True):
        n = len(g)
        ko, kr, kb = int(g.maj_o.sum()), int(g.maj_r.sum()), int(g.both.sum())
        cio, cir, cib = wilson(ko, n), wilson(kr, n), wilson(kb, n)
        wo = g['authors_male.o_males'].sum()/g['authors_male.o_nauth'].sum()
        wr = g['authors_male.r_males'].sum()/g['authors_male.r_nauth'].sum()
        rows.append(dict(domain=dom, n_pairs=n,
            prop_maj_O=ko/n, O_CI=f"[{cio[0]:.2f},{cio[1]:.2f}]",
            prop_maj_R=kr/n, R_CI=f"[{cir[0]:.2f},{cir[1]:.2f}]",
            prop_BOTH=kb/n, BOTH_CI=f"[{cib[0]:.2f},{cib[1]:.2f}]", k_BOTH=kb,
            mean_O=g['authors_male.o'].mean(), median_O=g['authors_male.o'].median(),
            mean_R=g['authors_male.r'].mean(), median_R=g['authors_male.r'].median(),
            wmean_O=wo, wmean_R=wr,
            ties_O=int((g['authors_male.o'] == 0.5).sum()), ties_R=int((g['authors_male.r'] == 0.5).sum())))
    return pd.DataFrame(rows)

def fmt(t):
    o = t.copy()
    for c in ['prop_maj_O','prop_maj_R','prop_BOTH','mean_O','median_O','mean_R','median_R','wmean_O','wmean_R']:
        o[c] = o[c].map(lambda v: f"{v:.3f}")
    return o.to_string(index=False)

# ---------- Fisher: BOTH vs rest ----------
def fisher_both(d, group):
    d = d.assign(both=(d['authors_male.o'] > 0.5) & (d['authors_male.r'] > 0.5))
    out = []
    for dom in sorted(d[group].unique()):
        a = int((d[group].eq(dom) & d.both).sum()); b = int((d[group].eq(dom) & ~d.both).sum())
        c = int((~d[group].eq(dom) & d.both).sum()); e = int((~d[group].eq(dom) & ~d.both).sum())
        orr, p2 = stats.fisher_exact([[a, b], [c, e]])
        _, p1 = stats.fisher_exact([[a, b], [c, e]], alternative='greater')
        out.append(dict(domain=dom, both=a, not_both=b, rest_both=c, rest_not=e, OR=orr, p_two=p2, p_greater=p1))
    return pd.DataFrame(out)

def winner(t, asc=False):
    return t.loc[t['prop_BOTH'].idxmax(), 'domain']

specs = {}
specs['A_primary_discipline_gt'] = dict(data=pairs, group='discipline', thr='gt')
specs['B_primary_discipline_ge'] = dict(data=pairs, group='discipline', thr='ge')
specs['C_primary_project_gt'] = dict(data=pairs, group='project', thr='gt')
specs['D_discipline_gt_dropFalse'] = dict(data=pairs[~pairs['drop_b']], group='discipline', thr='gt')
specs['E_discipline_ge_dropFalse'] = dict(data=pairs[~pairs['drop_b']], group='discipline', thr='ge')
specs['F_allrows927_discipline_gt'] = dict(data=df, group='discipline', thr='gt')
lab = pd.concat([df[~df['agg']], ])  # 786 rows: ee/rpp single + ml1/ml3 per-lab
specs['G_lablevel_discipline_gt'] = dict(data=lab, group='discipline', thr='gt')
specs['H_lablevel_discipline_ge'] = dict(data=lab, group='discipline', thr='ge')

print("="*110)
print("PRIMARY — unit = O/R pair (n=141), majority rule ratio > 0.5")
print("="*110)
prim = domain_table(pairs, 'discipline')
print(fmt(prim))
print("\nWinner (max prop_BOTH):", winner(prim))
print("\n-- Fisher exact: BOTH vs rest of domains --")
print(fisher_both(pairs, 'discipline').to_string(index=False))
print("\n-- Pairwise Fisher on BOTH between domains --")
d = pairs.assign(both=(pairs['authors_male.o']>0.5)&(pairs['authors_male.r']>0.5))
doms = sorted(d['discipline'].unique())
for i in range(len(doms)):
    for j in range(i+1, len(doms)):
        a1,n1 = d[d.discipline==doms[i]].both.sum(), (d.discipline==doms[i]).sum()
        a2,n2 = d[d.discipline==doms[j]].both.sum(), (d.discipline==doms[j]).sum()
        orr,p = stats.fisher_exact([[a1,n1-a1],[a2,n2-a2]])
        print(f"  {doms[i]} vs {doms[j]}: {a1}/{n1} vs {a2}/{n2} OR={orr:.2f} p={p:.3f}")

print("\n" + "="*110)
print("SECONDARY VIEW — domain = project (same primary rules)")
print("="*110)
proj = domain_table(pairs, 'project')
print(fmt(proj)); print("Winner:", winner(proj))
print(fisher_both(pairs,'project').to_string(index=False))

print("\n" + "="*110)
print("SENSITIVITY GRID")
print("="*110)
grid = []
for name, s in specs.items():
    t = domain_table(s['data'], s['group'], thr=s['thr'])
    grid.append(dict(spec=name, n_obs=len(s['data']), winner=winner(t),
        detail="; ".join(f"{r.domain}: {r.prop_BOTH:.3f}" for r in t.itertuples())))
print(pd.DataFrame(grid).to_string(index=False))

print("\n-- full tables per spec --")
for name, s in specs.items():
    print(f"\n### {name}")
    print(fmt(domain_table(s['data'], s['group'], thr=s['thr'])))

# reconstructed absolute counts
print("\n" + "="*110)
print("Reconstructed absolute male-author counts (primary pairs view, discipline)")
print("="*110)
rec = pairs.groupby('discipline').agg(pairs=('id','size'),
      male_authors_O=('authors_male.o_males','sum'), total_authors_O=('authors_male.o_nauth','sum'),
      male_authors_R=('authors_male.r_males','sum'), total_authors_R=('authors_male.r_nauth','sum'))
rec['share_O']=(rec.male_authors_O/rec.total_authors_O).round(3); rec['share_R']=(rec.male_authors_R/rec.total_authors_R).round(3)
print(rec.to_string())

# context: file 2 coverage only
df2 = pd.read_csv(P2)
print("\nContext (file B, out of scope for the calculation):", df2.shape,
      "| projects:", df2['project'].value_counts().to_dict(),
      "| gender columns:", [c for c in df2.columns if 'male' in c.lower() or 'auth' in c.lower()])

prim.to_csv('analysis/primary_by_discipline.csv', index=False)
proj.to_csv('analysis/primary_by_project.csv', index=False)
pd.DataFrame(grid).to_csv('analysis/sensitivity_grid.csv', index=False)
pairs.to_csv('analysis/pairs_view.csv', index=False)
print("\nwrote analysis/primary_by_discipline.csv, primary_by_project.csv, sensitivity_grid.csv, pairs_view.csv")

