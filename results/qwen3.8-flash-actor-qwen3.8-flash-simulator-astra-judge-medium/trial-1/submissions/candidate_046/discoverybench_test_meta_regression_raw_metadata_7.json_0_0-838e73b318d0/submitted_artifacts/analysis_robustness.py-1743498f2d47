import numpy as np, pandas as pd, sys
sys.path.insert(0,'analysis')
from main_analysis import pairs, domain_table, fmt, winner, wilson
pd.set_option('display.width',240)
print("\n### leave ml1+ml3 out (drop the two Many Labs projects entirely)")
sub = pairs[~pairs['project'].isin(['ml1','ml3'])]
t = domain_table(sub,'discipline'); print(fmt(t)); print("winner:",winner(t))
print("n pairs:", len(sub))
print("\n### rpp only (each study = 1 independent replication team)")
t2 = domain_table(pairs[pairs.project=='rpp'],'discipline'); print(fmt(t2))
print("\n### cluster bootstrap over projects of (Economics prop_BOTH - rest prop_BOTH), pairs view")
rng = np.random.default_rng(7)
p = pairs.assign(both=((pairs['authors_male.o']>0.5)&(pairs['authors_male.r']>0.5)))
proj = p['project'].unique()
obs = None
def diff(d):
    e=d[d.discipline=='Economics'].both; r=d[d.discipline!='Economics'].both
    return e.mean()-r.mean()
obs = diff(p)
groups = {k: v[['discipline','both']].reset_index(drop=True) for k,v in p.groupby('project')}
boot=[]
for _ in range(4000):
    take = rng.choice(proj, size=len(proj), replace=True)
    d = pd.concat([groups[k] for k in take], ignore_index=True)
    boot.append(diff(d))
boot=np.array(boot)
print(f"observed diff = {obs:.3f} | cluster-bootstrap 95% CI = [{np.percentile(boot,2.5):.3f}, {np.percentile(boot,97.5):.3f}] | P(diff<=0) = {(boot<=0).mean():.3f}")
print("\n### Economics pairs detail (n=18)")
cols=['id','project','lab_id','n_authors.o','authors_male.o','authors_male.r','n_authors.r']
print(pairs[pairs.discipline=='Economics'][cols].to_string(index=False))
