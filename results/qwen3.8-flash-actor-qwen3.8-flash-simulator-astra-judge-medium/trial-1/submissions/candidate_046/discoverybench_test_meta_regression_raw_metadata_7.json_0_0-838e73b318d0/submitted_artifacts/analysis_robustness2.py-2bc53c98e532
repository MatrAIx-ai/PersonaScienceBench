import numpy as np, pandas as pd, sys
sys.path.insert(0,'analysis')
from main_analysis import pairs
p = pairs.assign(both=((pairs['authors_male.o']>0.5)&(pairs['authors_male.r']>0.5)))
def diff(d):
    e = d[d.discipline=='Economics'].both; r = d[d.discipline!='Economics'].both
    if len(e)==0 or len(r)==0: return np.nan
    return e.mean()-r.mean()
groups = {k: v[['discipline','both']].reset_index(drop=True) for k,v in p.groupby('project')}
# 1) project-cluster bootstrap (only 4 clusters -> coarse); condition on Economics present
rng = np.random.default_rng(7); proj=list(groups); boot=[]
while len(boot) < 4000:
    take = rng.choice(proj, size=len(proj), replace=True)
    v = diff(pd.concat([groups[k] for k in take], ignore_index=True))
    if not np.isnan(v): boot.append(v)
boot=np.array(boot)
print(f"project-cluster bootstrap (n_clusters=4, Economics always present since single cluster 'ee'):")
print(f"  observed diff Econ-vs-rest = {diff(p):.3f}  95% CI [{np.percentile(boot,2.5):.3f},{np.percentile(boot,97.5):.3f}]  P(diff<=0)={(boot<=0).mean():.3f}")
# 2) iid pair bootstrap (ignores ml1/ml3 clustering) 
b2=[]
vals=p[['discipline','both']].values
for _ in range(10000):
    s=p.iloc[rng.integers(0,len(p),len(p))]
    b2.append(diff(s))
b2=np.array(b2)
print(f"iid pair bootstrap: 95% CI [{np.percentile(b2,2.5):.3f},{np.percentile(b2,97.5):.3f}]  P(diff<=0)={(b2<=0).mean():.3f}")
# 3) sensitivity of ml1/ml3 replication flag: what if 0.516/0.56 treated as 'not clearly male-majority' (thr 0.55)?
for thr in [0.5,0.55,0.6]:
    o=(p['authors_male.o']>thr)&(p['authors_male.r']>thr)
    t=pd.DataFrame({'discipline':p.discipline,'both':o}).groupby('discipline').both.agg(['size','sum','mean'])
    print(f"thr={thr}: "+", ".join(f"{i}={r['mean']:.3f}({int(r['sum'])}/{int(r['size'])})" for i,r in t.iterrows()), "| winner:", t['mean'].idxmax())
