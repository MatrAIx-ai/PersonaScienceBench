"""
DiscoveryBench / nls_incarceration (metadata_11) -- main analysis.
Question: demographic disparities in median wealth in 1985 among ever-incarcerated (ever_jailed==1).
Produces the tables reported in the result handoff.
"""
import numpy as np, pandas as pd
from scipy import stats

RNG = np.random.default_rng(20261022)
NBOOT = 5000
VAR = "composite_wealth_1985"
df = pd.read_csv("data/nls_incarceration_processed.csv")
df["race"] = df["race"].astype(str)

# global winsorization caps (same truncation scale for every group -> comparable)
lo_g, hi_g = np.percentile(df[VAR], [1, 99])

def med(x): return float(np.median(x))

def boot_med_ci(x, nboot=NBOOT, alpha=0.05):
    x = np.asarray(x, dtype=float)
    if len(x) < 2: return (np.nan, np.nan)
    idx = RNG.integers(0, len(x), size=(nboot, len(x)))
    m = np.median(x[idx], axis=1)
    return tuple(np.percentile(m, [100*alpha/2, 100*(1-alpha/2)]))

def boot_diff_med_ci(a, b, nboot=NBOOT, alpha=0.05):
    """CI for median(a) - median(b), independent resampling within groups."""
    a = np.asarray(a, float); b = np.asarray(b, float)
    if len(a) < 2 or len(b) < 2: return (np.nan, np.nan)
    ia = RNG.integers(0, len(a), size=(nboot, len(a)))
    ib = RNG.integers(0, len(b), size=(nboot, len(b)))
    d = np.median(a[ia], axis=1) - np.median(b[ib], axis=1)
    return tuple(np.percentile(d, [100*alpha/2, 100*(1-alpha/2)]))

def wins_mean_global(x):
    return float(np.clip(np.asarray(x, float), lo_g, hi_g).mean())

def wins_mean_within(x):
    if len(x) < 3: return np.nan
    l, h = np.percentile(x, [1, 99]); return float(np.clip(np.asarray(x, float), l, h).mean())

def summarize(g, label):
    x = np.asarray(g, float); n = len(x)
    lo, hi = boot_med_ci(x)
    return dict(group=label, n=n, flag_small_n="*" if n < 20 else "",
                median=med(x), median_ci_lo=lo, median_ci_hi=hi,
                q1=float(np.percentile(x, 25)), q3=float(np.percentile(x, 75)),
                pct_le0=100*float((x <= 0).mean()),
                mean_wins_global=wins_mean_global(x), mean_wins_within=wins_mean_within(x),
                mean_raw=float(x.mean()), minv=float(x.min()), maxv=float(x.max()))

ej = df[df.ever_jailed == 1].copy()
non = df[df.ever_jailed == 0]
rows = [summarize(ej[VAR], "ALL ever_jailed==1")]
for r in ["white", "black", "hipanic"]:
    rows.append(summarize(ej.loc[ej.race == r, VAR], f"race={r}"))
for s in ["male", "female"]:
    rows.append(summarize(ej.loc[ej.sex == s, VAR], f"sex={s}"))
for (r, s), g in ej.groupby(["race", "sex"]):
    rows.append(summarize(g[VAR], f"race={r} x sex={s}"))
main = pd.DataFrame(rows)
main["median_ci95"] = [f"[{a:,.0f}, {b:,.0f}]" for a, b in zip(main.median_ci_lo, main.median_ci_hi)]

# ---- differences vs reference (white x male) for the crosses ----
ref = ej[(ej.race == "white") & (ej.sex == "male")][VAR]
crows = []
for (r, s), g in sorted(ej.groupby(["race", "sex"]), key=lambda kv: (kv[0][0] != "white", kv[0][1] != "male")):
    x = g[VAR].values
    dlo, dhi = boot_diff_med_ci(x, ref)
    crows.append(dict(cell=f"{r} x {s}", n=len(x), median=med(x),
                      diff_vs_whitemale=med(x) - med(ref),
                      diff_ci_lo=dlo, diff_ci_hi=dhi,
                      pct_le0=100*float((x <= 0).mean()),
                      pct_le0_diff_vs_whitemale=100*float((x <= 0).mean()) - 100*float((ref <= 0).mean()),
                      ratio_vs_whitemale=(med(x)/med(ref)) if med(ref) > 0 else np.nan,
                      flag_small_n="*" if len(x) < 20 else "",
                      note="REFERENCE" if (r, s) == ("white", "male") else ""))
cross = pd.DataFrame(crows)

# ---- full pairwise matrices for the MARGINS (race; sex) ----
def pairwise(series_groups, ref=None):
    keys = list(series_groups)
    out = []
    for i in range(len(keys)):
        for j in range(len(keys)):
            if i == j: continue
            a, b = keys[i], keys[j]
            xa, xb = series_groups[a], series_groups[b]
            dlo, dhi = boot_diff_med_ci(xa, xb)
            p = stats.mannwhitneyu(xa, xb, alternative="two-sided")[1] if min(len(xa), len(xb)) >= 3 else np.nan
            out.append(dict(A=a, B=b, nA=len(xa), nB=len(xb), medA=med(xa), medB=med(xb),
                            diff_A_minus_B=med(xa)-med(xb), diff_ci_lo=dlo, diff_ci_hi=dhi,
                            ratio_A_over_B=(med(xa)/med(xb)) if med(xb) > 0 else np.nan,
                            pct_le0_A=100*float((xa <= 0).mean()), pct_le0_B=100*float((xb <= 0).mean()),
                            mw_p=p, ref_flag="yes" if (ref and b == ref) else ""))
    return pd.DataFrame(out)

race_grp = {r: ej.loc[ej.race == r, VAR].values for r in ["white", "black", "hipanic"]}
sex_grp = {s: ej.loc[ej.sex == s, VAR].values for s in ["male", "female"]}
pair_race, pair_sex = pairwise(race_grp), pairwise(sex_grp)

# ---- which axis explains more of the spread in medians ----
def spread(d):  # max-min of medians
    v = {k: med(x) for k, x in d.items()}; return max(v.values()) - min(v.values()), v
race_spread, race_meds = spread(race_grp)
sex_spread, sex_meds = spread(sex_grp)
cross_meds = {f"{r}|{s}": med(g[VAR].values) for (r, s), g in ej.groupby(["race", "sex"])}
male_race_gaps = [med(ej[(ej.race == r) & (ej.sex == "male")][VAR]) - med(ej[(ej.race == "white") & (ej.sex == "male")][VAR])
                  for r in ["black", "hipanic"]]
fem_race_gaps = [med(ej[(ej.race == r) & (ej.sex == "female")][VAR]) - med(ej[(ej.race == "white") & (ej.sex == "female")][VAR])
                 for r in ["black", "hipanic"]]
sex_gap_within = {r: med(ej[(ej.race == r) & (ej.sex == "male")][VAR]) - med(ej[(ej.race == r) & (ej.sex == "female")][VAR])
                  for r in ["white", "black", "hipanic"]}
kw_race = stats.kruskal(*[race_grp[r] for r in race_grp])
kw_sex = stats.kruskal(*[sex_grp[s] for s in sex_grp])
male_pair = stats.mannwhitneyu(ej[(ej.race=="black")&(ej.sex=="male")][VAR], ref, alternative="two-sided")
male_his_pair = stats.mannwhitneyu(ej[(ej.race=="hipanic")&(ej.sex=="male")][VAR], ref, alternative="two-sided")

# eta-style ranking on ranks (non-parametric, ties kept): variance of ranks explained
ej["rk"] = stats.rankdata(ej[VAR])
tot = ej["rk"].var(ddof=1) * (len(ej)-1)
def ssf(col):
    ss = sum(len(g)*(g["rk"].mean()-ej["rk"].mean())**2 for _, g in ej.groupby(col))
    return ss/tot
eta_race, eta_sex = ssf("race"), ssf("sex")
ei = ej.copy(); ei["rs"] = ei.race + "|" + ei.sex
eta_cross = sum(len(g)*(g["rk"].mean()-ei["rk"].mean())**2 for _, g in ei.groupby("rs"))/(ei["rk"].var(ddof=1)*(len(ei)-1))

# ---- context: never incarcerated & full sample ----
ctx = pd.DataFrame([
    dict(group="ever_jailed==1", n=len(ej), median=med(ej[VAR]), pct_le0=100*float((ej[VAR] <= 0).mean()),
         q1=np.percentile(ej[VAR],25), q3=np.percentile(ej[VAR],75)),
    dict(group="ever_jailed==0", n=len(non), median=med(non[VAR]), pct_le0=100*float((non[VAR] <= 0).mean()),
         q1=np.percentile(non[VAR],25), q3=np.percentile(non[VAR],75)),
    dict(group="males, ever_jailed==1", n=int(((ej.sex=="male").sum())), median=med(ej[ej.sex=="male"][VAR]),
         pct_le0=100*float((ej[ej.sex=="male"][VAR] <= 0).mean()), q1=np.nan, q3=np.nan),
    dict(group="males, ever_jailed==0", n=int(((non.sex=="male").sum())), median=med(non[non.sex=="male"][VAR]),
         pct_le0=100*float((non[non.sex=="male"][VAR] <= 0).mean()), q1=np.nan, q3=np.nan),
    dict(group="black-males ej=1", n=len(ej[(ej.race=="black")&(ej.sex=="male")]), median=med(ej[(ej.race=="black")&(ej.sex=="male")][VAR]),
         pct_le0=100*float((ej[(ej.race=="black")&(ej.sex=="male")][VAR] <= 0).mean()), q1=np.nan, q3=np.nan),
    dict(group="black-males ej=0", n=len(non[(non.race=="black")&(non.sex=="male")]), median=med(non[(non.race=="black")&(non.sex=="male")][VAR]),
         pct_le0=100*float((non[(non.race=="black")&(non.sex=="male")][VAR] <= 0).mean()), q1=np.nan, q3=np.nan),
    dict(group="white-males ej=0", n=len(non[(non.race=="white")&(non.sex=="male")]), median=med(non[(non.race=="white")&(non.sex=="male")][VAR]),
         pct_le0=100*float((non[(non.race=="white")&(non.sex=="male")][VAR] <= 0).mean()), q1=np.nan, q3=np.nan),
])

# ---- sensitivity: $100 granularity (jitter), duplicates, later years ----
jit = []
for _ in range(2000):
    j = ej[VAR].values + RNG.uniform(-50, 50, len(ej))
    jit.append(np.median(j))
sens = dict(
    median_point=med(ej[VAR]), jitter_median_mean=float(np.mean(jit)),
    jitter_median_p2_5=float(np.percentile(jit, 2.5)), jitter_median_p97_5=float(np.percentile(jit, 97.5)),
    n_exact_dupes=int(df.duplicated().sum()),
    median_dedup=float(pd.DataFrame({VAR: ej[VAR]}).drop_duplicates()[VAR].median()),
    n_dedup_ej=int(pd.DataFrame({VAR: ej[VAR]}).drop_duplicates().shape[0]),
    pct_mult100=float((df[VAR] % 100 == 0).mean()), n_unique_1985=int(df[VAR].nunique()),
    ej_median_1990=med(ej.composite_wealth_1990), ej_median_1996=med(ej.composite_wealth_1996),
    nonej_median_1990=med(non.composite_wealth_1990), nonej_median_1996=med(non.composite_wealth_1996),
    ej_ratio_1990_to_nonej=None,
)
sens["ej_minus_nonej_1985"] = med(ej[VAR]) - med(non[VAR])
sens["ej_minus_nonej_1990"] = med(ej.composite_wealth_1990) - med(non.composite_wealth_1990)
sens["ej_minus_nonej_1996"] = med(ej.composite_wealth_1996) - med(non.composite_wealth_1996)
sens["ej_minus_nonej_1996_blackmale_vs_whitemale"] = (
    med(ej[(ej.race=="black")&(ej.sex=="male")].composite_wealth_1996) -
    med(ej[(ej.race=="white")&(ej.sex=="male")].composite_wealth_1996))

fmt = lambda d: d.to_csv(index=False)
main_out = main[["group","n","flag_small_n","median","median_ci95","q1","q3","pct_le0",
                 "mean_wins_global","mean_wins_within","mean_raw","minv","maxv"]]
main_out.to_csv("out/table_main.csv", index=False)
cross.to_csv("out/table_race_sex_vs_whitemale.csv", index=False)
pair_race.to_csv("out/pairwise_race.csv", index=False)
pair_sex.to_csv("out/pairwise_sex.csv", index=False)
ctx.to_csv("out/context_vs_neverincarcerated.csv", index=False)
pd.DataFrame([sens]).T.to_csv("out/sensitivity.csv")
diag = dict(winsor_caps=[float(lo_g), float(hi_g)], race_medians=race_meds, sex_medians=sex_meds,
            cross_medians=cross_meds, race_spread=race_spread, sex_spread=sex_spread,
            blackmale_vs_whitemale_gap=male_race_gaps[0], hispanicmale_vs_whitemale_gap=male_race_gaps[1],
            blackfemale_vs_whitefemale_gap=fem_race_gaps[0], hispanicfemale_vs_whitefemale_gap=fem_race_gaps[1],
            sex_gap_within_race=sex_gap_within,
            kruskal_race=[kw_race.statistic, kw_race.pvalue], kruskal_sex=[kw_sex.statistic, kw_sex.pvalue],
            mw_blackmale_vs_whitemale_p=male_pair.pvalue, mw_hispnicmale_vs_whitemale_p=male_his_pair.pvalue,
            rank_eta2_race=eta_race, rank_eta2_sex=eta_sex, rank_eta2_raceXsex=eta_cross, n_ej=len(ej))
import json; open("out/diagnostics.json","w").write(json.dumps(diag, indent=2, default=str))
pd.set_option("display.width", 250, "display.max_columns", 50)
print(main_out.to_string(index=False)); print()
print(cross.to_string(index=False)); print()
print(pair_race.round(3).to_string(index=False)); print()
print(pair_sex.round(3).to_string(index=False)); print()
print(ctx.round(2).to_string(index=False)); print()
print(json.dumps(sens, indent=2, default=str)); print()
print(json.dumps(diag, indent=2, default=str))
