"""Extra diagnostics: distribution-wide (not only median) comparisons, pp differences for %<=0,
and axis-ranking that is robust to the tiny female cells."""
import numpy as np, pandas as pd, json
from scipy import stats
RNG = np.random.default_rng(7)
V = "composite_wealth_1985"
df = pd.read_csv("data/nls_incarceration_processed.csv")
ej = df[df.ever_jailed == 1]

def ci(f, a, b, nb=5000):
    d = np.empty(nb)
    for k in range(nb):
        ia = RNG.integers(0, len(a), len(a)); ib = RNG.integers(0, len(b), len(b))
        d[k] = f(a[ia]) - f(b[ib])
    return np.percentile(d, [2.5, 97.5])

def prob_sup(a, b):  # P(X>Y)+0.5P(X=Y) : distribution-wide effect size, robust to ties
    a = np.asarray(a, float)[:, None]; b = np.asarray(b, float)[None, :]
    return float((a > b).mean() + 0.5 * (a == b).mean())

m = lambda x: float(np.median(x))
res = {}
refm = ej[(ej.race == "white") & (ej.sex == "male")][V].values
bm = ej[(ej.race == "black") & (ej.sex == "male")][V].values
hm = ej[(ej.race == "hipanic") & (ej.sex == "male")][V].values
nonm = np.concatenate([bm, hm])                     # non-white males pooled (n=195)
refr = ej[ej.race == "white"][V].values
nonr = ej[ej.race != "white"][V].values             # non-white pooled (n=220)
mal = ej[ej.sex == "male"][V].values; fem = ej[ej.sex == "female"][V].values

def pp(x): return 100*float((np.asarray(x) <= 0).mean())
for name, a, b in [("white-male vs black-male", refm, bm), ("white-male vs hipanic-male", refm, hm),
                   ("white-male vs nonwhite-male(pooled)", refm, nonm),
                   ("white vs nonwhite (all ej, pooled)", refr, nonr),
                   ("male vs female (all ej)", mal, fem)]:
    lo, hi = ci(lambda z: 100*float((z <= 0).mean()), a, b)
    mlo, mhi = ci(m, a, b)
    res[name] = dict(nA=len(a), nB=len(b), medA=m(a), medB=m(b), diff_med=m(a)-m(b),
                     diff_med_ci=[round(mlo), round(mhi)], pct_le0A=round(pp(a), 1), pct_le0B=round(pp(b), 1),
                     diff_pp=round(pp(a)-pp(b), 1), diff_pp_ci=[round(lo, 1), round(hi, 1)],
                     prob_sup_A_over_B=round(prob_sup(a, b), 3),
                     mw_p=float(stats.mannwhitneyu(a, b, alternative="two-sided").pvalue),
                     meanA_wins=round(float(np.clip(a, *np.percentile(df[V], [1, 99])).mean()), 0),
                     meanB_wins=round(float(np.clip(b, *np.percentile(df[V], [1, 99])).mean()), 0))

# axis ranking robust to tiny female cells
res["kruskal_race_within_males"] = list(map(float, stats.kruskal(*[ej[(ej.race == r) & (ej.sex == "male")][V] for r in ["white","black","hipanic"]])))
res["kruskal_race_pooled_nonwhite_vs_white_males"] = list(map(float, stats.kruskal(refm, nonm)))
res["race_spread_of_medians_margins"] = m(refr) - min(m(ej[ej.race == r][V]) for r in ["black","hipanic"])
res["sex_spread_of_medians_margins"] = m(mal) - m(fem)
res["race_spread_within_males"] = m(refm) - min(m(bm), m(hm))
res["sex_spread_within_race"] = {r: round(m(ej[(ej.race==r)&(ej.sex=="male")][V]) - m(ej[(ej.race==r)&(ej.sex=="female")][V]))
                                 for r in ["white","black","hipanic"]}
res["n_fem_cells"] = {r: int(((ej.race==r)&(ej.sex=="female")).sum()) for r in ["white","black","hipanic"]}
res["share_le0_by_cell"] = {f"{r}|{s}": round(pp(g[V]),1) for (r,s), g in ej.groupby(["race","sex"])}
res["median_by_cell"] = {f"{r}|{s}": m(g[V]) for (r,s), g in ej.groupby(["race","sex"])}
res["q3_by_cell"] = {f"{r}|{s}": float(np.percentile(g[V],75)) for (r,s), g in ej.groupby(["race","sex"])}
res["share_wealth_ge_25k_by_cell"] = {f"{r}|{s}": round(100*float((g[V]>=25000).mean()),1) for (r,s), g in ej.groupby(["race","sex"])}
json.dump(res, open("out/extra_diagnostics.json","w"), indent=2, default=str)
print(json.dumps(res, indent=2, default=str))
