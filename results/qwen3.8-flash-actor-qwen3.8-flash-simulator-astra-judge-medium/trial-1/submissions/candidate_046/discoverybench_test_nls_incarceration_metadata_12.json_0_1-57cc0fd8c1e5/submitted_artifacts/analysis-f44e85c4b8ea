def match_within_caliper_mean(d, strat_col="s_level", caliper=CALIPER):
    """Robust alternative: average ALL controls within caliper (no single-point dominance)."""
    rows = []
    for lv, sub in d.groupby(strat_col, observed=True):
        tr, ct = sub[sub.ever_jailed == 1], sub[sub.ever_jailed == 0]
        cw = ct.w1985.to_numpy()
        for i, t in tr.iterrows():
            sel = ct[np.abs(cw - t.w1985) <= caliper]
            if not len(sel):
                continue
            rows.append(dict(stratum=str(lv), treated_id=i, n_ctl_used=len(sel), tw85=t.w1985,
                             cw85=sel.w1985.mean(), t_d=t.d85_96, c_d=sel.d85_96.mean(),
                             t_drank=t.drank85_96, c_drank=sel.drank85_96.mean()))
    return pd.DataFrame(rows)

