"""
NLSY-79: Incarceration and wealth trajectories among Black respondents, by prior economic position.
Question: How does incarceration affect the wealth of black individuals based on their income levels?

Design (approved):
 - No income variable exists in the file -> 'income level' is OPERATIONALIZED as prior wealth
   (composite_wealth_1985). Declared explicitly.
 - Principal sample: race == 'black' & sex == 'male'.
 - Two stratifications: (a) qcut tertiles, (b) substantive <=0 / (0,5000] / >5000.
 - Outcomes: levels (mean+median) 1985/1990/1996, change 85->96, DiD (jailed - not jailed) with
   bootstrap CIs, plus rank-based and signed-log robust versions.
 - 1:1 nearest-neighbour MATCHING on composite_wealth_1985 (caliper $2,000, with replacement).
   DiD before vs after matching measures selection bias.
 - Sensitivity: exclude 0/0/0 rows; deduplicate; positive-wealth only; full black cohort; women.
 - Association, not causation.
"""
import numpy as np
import pandas as pd

CSV = "data/nls_incarceration_processed.csv"
YEARS = [1985, 1990, 1996]
WC = {y: f"composite_wealth_{y}" for y in YEARS}
B_BOOT = 2000
RNG = np.random.default_rng(20261022)
CALIPER = 2000.0
LEVELS = ["low", "mid", "high"]

df = pd.read_csv(CSV)
for y in YEARS:
    df[f"w{y}"] = df[WC[y]].astype(float)
df["d85_90"] = df.w1990 - df.w1985
df["d85_96"] = df.w1996 - df.w1985
df["slog85_96"] = (np.sign(df.w1996) * np.log1p(np.abs(df.w1996) / 1000.0)
                   - np.sign(df.w1985) * np.log1p(np.abs(df.w1985) / 1000.0))
df["allzero"] = (df[[f"w{y}" for y in YEARS]] == 0).all(axis=1)


def prep(d):
    d = d.copy()
    for y in YEARS:
        d[f"rank{y}"] = d[f"w{y}"].rank(pct=True)
    d["drank85_96"] = d["rank1996"] - d["rank1985"]
    d["q_tercile"] = pd.qcut(d.w1985, 3, labels=LEVELS, duplicates="drop")
    d["s_level"] = pd.cut(d.w1985, [-np.inf, 0, 5000, np.inf], labels=LEVELS)
    return d


def boot_diff(a, b, stat=np.mean, B=B_BOOT):
    a = np.asarray(a, float); b = np.asarray(b, float)
    a = a[~np.isnan(a)]; b = b[~np.isnan(b)]
    if len(a) < 2 or len(b) < 2:
        return np.nan, (np.nan, np.nan)
    sa = stat(a[RNG.integers(0, len(a), (B, len(a)))], axis=1)
    sb = stat(b[RNG.integers(0, len(b), (B, len(b)))], axis=1)
    dif = sa - sb
    return float(stat(a) - stat(b)), (float(np.nanpercentile(dif, 2.5)), float(np.nanpercentile(dif, 97.5)))


def smd(a, b):
    a = np.asarray(a, float); b = np.asarray(b, float)
    s = np.sqrt((a.var(ddof=1) + b.var(ddof=1)) / 2)
    return float((a.mean() - b.mean()) / s) if s > 0 else np.nan


def match_1to1(d, strat_col=None, caliper=CALIPER):
    out = []
    parts = list(d.groupby(strat_col, observed=True)) if strat_col else [("all", d)]
    for k, sub in parts:
        tr, ct = sub[sub.ever_jailed == 1], sub[sub.ever_jailed == 0]
        cw = ct.w1985.to_numpy()
        for i, t in tr.iterrows():
            if not len(ct):
                continue
            dist = np.abs(cw - t.w1985)
            j = int(np.argmin(dist))
            if dist[j] <= caliper:
                c = ct.iloc[j]
                out.append(dict(stratum=str(k), treated_id=i, control_id=c.name, tw85=t.w1985,
                                cw85=c.w1985, t_d=t.d85_96, c_d=c.d85_96,
                                t_drank=t.drank85_96, c_drank=c.drank85_96))
    return pd.DataFrame(out)


def level_table(d, strat_col):
    rows = []
    for lv in LEVELS:
        s = d[d[strat_col] == lv]
        t, c = s[s.ever_jailed == 1], s[s.ever_jailed == 0]
        r = {"level": lv, "nT": len(t), "nC": len(c)}
        for y in YEARS:
            r[f"m{y}T"] = t[f"w{y}"].mean(); r[f"m{y}C"] = c[f"w{y}"].mean()
            r[f"M{y}T"] = t[f"w{y}"].median(); r[f"M{y}C"] = c[f"w{y}"].median()
        r["dT"] = t.d85_96.mean(); r["dC"] = c.d85_96.mean()
        r["DiD"], ci = boot_diff(t.d85_96, c.d85_96); r["lo"], r["hi"] = ci
        r["DiDmed"], mci = boot_diff(t.d85_96, c.d85_96, np.median); r["loM"], r["hiM"] = mci
        r["DiDrank"], rci = boot_diff(t.drank85_96, c.drank85_96); r["loR"], r["hiR"] = rci
        r["DiDslog"], _ = boot_diff(t.slog85_96, c.slog85_96)
        r["pre_gap85"] = t.w1985.mean() - c.w1985.mean()
        r["gap96"] = t.w1996.mean() - c.w1996.mean()
        rows.append(r)
    return pd.DataFrame(rows)


def gradient_ci(d, strat_col, B=B_BOOT):
    cells = {(lv, g): d[(d[strat_col] == lv) & (d.ever_jailed == g)].d85_96.to_numpy()
             for lv in LEVELS for g in (0, 1)}
    if any(len(v) < 2 for v in cells.values()):
        return np.nan, (np.nan, np.nan)
    gs = []
    for _ in range(B):
        m = {k: v[RNG.integers(0, len(v), len(v))].mean() for k, v in cells.items()}
        gs.append((m[("high", 1)] - m[("high", 0)]) - (m[("low", 1)] - m[("low", 0)]))
    gs = np.array(gs)
    obs = (cells[("high", 1)].mean() - cells[("high", 0)].mean()
           - cells[("low", 1)].mean() + cells[("low", 0)].mean())
    return float(obs), (float(np.percentile(gs, 2.5)), float(np.percentile(gs, 97.5)))


def matched_did(mp, by=True):
    rows = []
    keys = list(mp.groupby("stratum", observed=True)) if by else [("all", mp)]
    for k, v in keys:
        o, ci = boot_diff(v.t_d, v.c_d)
        r, rc = boot_diff(v.t_drank, v.c_drank)
        rows.append(dict(stratum=k, n_pairs=len(v), mDiD=o, lo=ci[0], hi=ci[1],
                         mDiDrank=r, rlo=rc[0], rhi=rc[1], tw85=v.tw85.mean(),
                         cw85=v.cw85.mean(), max_imb=np.abs(v.tw85 - v.cw85).max()))
    return pd.DataFrame(rows)


def f0(v):
    return f"{v:,.0f}"


def show(tab, cols):
    with pd.option_context("display.width", 260, "display.max_columns", 80, "display.float_format",
                           lambda v: f0(v) if abs(v) >= 1 else f"{v:.3f}"):
        print(tab[cols].to_string(index=False))


def _key_int(txt):
    return sum((i + 1) * ord(c) for i, c in enumerate(txt)) % (2 ** 31)


def reseed(txt):
    global RNG
    RNG = np.random.default_rng(_key_int(txt))


def report(tag, d, label):
    print("=" * 120)
    print(f"### {tag} :: {label}   n={len(d)}  treated={int(d.ever_jailed.sum())}")
    print("=" * 120)
    for sc in ["q_tercile", "s_level"]:
        reseed(f"{tag}|{sc}|{len(d)}|{int(d.ever_jailed.sum())}")
        tab = level_table(d, sc)
        print(f"\n-- {sc} -- LEVELS & CHANGE & DiD")
        show(tab, ["level", "nT", "nC"] + [f"{p}{y}{g}" for y in YEARS for p in ("m", "M") for g in ("T", "C")]
             + ["dT", "dC", "DiD", "lo", "hi"])
        print(f"-- {sc} -- ROBUST / SELECTION")
        show(tab, ["level", "nT", "DiDmed", "loM", "hiM", "DiDrank", "loR", "hiR", "DiDslog",
                   "pre_gap85", "gap96"])
        g, gci = gradient_ci(d, sc)
        print(f"GRADIENT (DiD_high - DiD_low) = {g:,.0f}  95% CI [{gci[0]:,.0f}, {gci[1]:,.0f}]")
    print()

