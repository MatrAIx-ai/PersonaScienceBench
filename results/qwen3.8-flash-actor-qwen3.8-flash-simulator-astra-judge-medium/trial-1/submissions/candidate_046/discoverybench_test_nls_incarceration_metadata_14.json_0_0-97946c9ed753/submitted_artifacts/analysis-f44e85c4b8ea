#!/usr/bin/env python3
"""
Question: "Between which years did the largest increases in median wealth occur
among black females?"

Data: data/nls_incarceration_processed.csv (NLSY 1979 cohort extract).
Primary rule agreed with researcher:
  - pooled subgroup race=='black' & sex=='female' (NOT stratified by ever_jailed)
  - primary criterion = absolute increase in the median; supported by per-year
    (annualized) increase; percent change is qualitative support only
  - zeros are observed zero wealth (no NaN in file); all 1,548 rows used in all
    three waves (paired by construction)
  - all amounts are NOMINAL (not deflation-adjusted) dollars
"""
import pandas as pd

pd.set_option("display.width", 160)
pd.set_option("display.max_columns", 50)

PATH = "data/nls_incarceration_processed.csv"
W = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
YEARS = [1985, 1990, 1996]
SPANS = {1985: 5, 1990: 6}  # 1985->1990 spans 5 years; 1990->1996 spans 6 years

df = pd.read_csv(PATH)
print("=" * 78)
print("1) DATA CHECK")
print("=" * 78)
print("rows, cols:", df.shape)
print("columns:", list(df.columns))
print("race levels:", sorted(df["race"].unique()), "| counts:\n", df["race"].value_counts().to_string())
print("sex levels:", sorted(df["sex"].unique()), "| ever_jailed:", sorted(df["ever_jailed"].unique()))
print("missing values per column:\n", df.isna().sum().to_string())
print("negative-wealth rows per year:", {c: int((df[c] < 0).sum()) for c in W})
print("zero-wealth rows per year:", {c: int((df[c] == 0).sum()) for c in W})
print("wealth columns present (only these three years exist):", W)


def increments(sub: pd.DataFrame, label: str) -> pd.DataFrame:
    """Medians + absolute / per-year / percent increases for the two intervals."""
    med = sub[W].median()
    rows = []
    for a, b in [(1985, 1990), (1990, 1996)]:
        ma, mb = med[f"composite_wealth_{a}"], med[f"composite_wealth_{b}"]
        rows.append({
            "interval": f"{a}->{b}",
            "years_spanned": SPANS[a],
            "median_start": ma,
            "median_end": mb,
            "abs_increase": mb - ma,
            "per_year_increase": (mb - ma) / SPANS[a],
            "pct_change": (mb / ma - 1.0) * 100.0 if ma != 0 else float("nan"),
        })
    out = pd.DataFrame(rows)
    n = len(sub)
    print(f"\n--- {label} (n = {n}) ---")
    print("medians:", {y: float(med[f'composite_wealth_{y}']) for y in YEARS})
    print(out.to_string(index=False, float_format=lambda v: f"{v:,.2f}"))
    return out


print("\n" + "=" * 78)
print("2) PRIMARY ANALYSIS - pooled black females (no incarceration stratification)")
print("=" * 78)
bf = df[(df["race"] == "black") & (df["sex"] == "female")]
print("complete cases in all three waves:", int(bf[W].notna().all(axis=1).sum()))
primary = increments(bf, "PRIMARY: race=='black' & sex=='female', all rows")

print("\n" + "=" * 78)
print("3) SENSITIVITY ANALYSES")
print("=" * 78)
s_nozero = increments(bf[(bf[W] != 0).all(axis=1)], "S1: drop rows with a zero in ANY wave (negatives may remain)")
s_neg_row = increments(bf[(bf[W] >= 0).all(axis=1)], "S2: drop rows with a negative in ANY wave (zeros may remain)")
s_pos_only = increments(bf[(bf[W] > 0).all(axis=1)], "S2b: strictly positive in ALL waves (paired panel)")
# per-wave trimming of negatives (keeps more rows)
bf_neg = bf.copy()
for c in W:
    bf_neg.loc[bf_neg[c] < 0, c] = float("nan")
print("\n--- S3: negatives set to NaN per wave (medians over non-missing of each wave) ---")
med_s3 = bf_neg[W].median()
print("medians:", {y: float(med_s3[f'composite_wealth_{y}']) for y in YEARS})
print("non-missing per wave:", bf_neg[W].notna().sum().to_dict())
r = []
for a, b in [(1985, 1990), (1990, 1996)]:
    ma, mb = med_s3[f"composite_wealth_{a}"], med_s3[f"composite_wealth_{b}"]
    r.append({"interval": f"{a}->{b}", "abs_increase": mb - ma,
              "per_year_increase": (mb - ma) / SPANS[a],
              "pct_change": (mb / ma - 1.0) * 100.0 if ma != 0 else float("nan")})
print(pd.DataFrame(r).to_string(index=False, float_format=lambda v: f"{v:,.2f}"))

print("\n--- S4: means instead of medians (shows outlier leverage) ---")
mn = bf[W].mean()
print("means:", {y: round(float(mn[f'composite_wealth_{y}']), 2) for y in YEARS})
print("abs increase 1985->1990:", round(mn['composite_wealth_1990'] - mn['composite_wealth_1985'], 2),
      "| 1990->1996:", round(mn['composite_wealth_1996'] - mn['composite_wealth_1990'], 2))

print("\n--- S5: CONTEXT ONLY - ever_jailed breakdown (1,548 black females) ---")
ctx = bf.groupby("ever_jailed")[W].median().rename(index={0: "never_jailed", 1: "ever_jailed"})
print(ctx.to_string(float_format=lambda v: f"{v:,.2f}"))
print("cell sizes:", bf["ever_jailed"].value_counts().to_dict())
print("NOTE: this file has no residence / place-of-incarceration variable, so")
print("      nothing about residence can be assessed here.")

print("\n--- S6: comparison groups (context) ---")
for rc in ["black", "white", "hipanic"]:
    for sx in ["female", "male"]:
        s = df[(df["race"] == rc) & (df["sex"] == sx)]
        m = s[W].median()
        print(f"{rc:8s} {sx:6s} n={len(s):5d} medians 85/90/96 = "
              f"{m[W[0]]:>10,.2f} {m[W[1]]:>12,.2f} {m[W[2]]:>12,.2f} | "
              f"abs 85-90 = {m[W[1]]-m[W[0]]:>11,.2f} | abs 90-96 = {m[W[2]]-m[W[1]]:>11,.2f}")

print("\n" + "=" * 78)
print("4) VERDICT (primary criterion = absolute increase in median)")
print("=" * 78)
a8590 = primary.loc[0, "abs_increase"]
a9096 = primary.loc[1, "abs_increase"]
p8590 = primary.loc[0, "per_year_increase"]
p9096 = primary.loc[1, "per_year_increase"]
winner = "1985->1990" if a8590 > a9096 else "1990->1996"
print(f"abs:   1985->1990 = ${a8590:,.2f}  vs  1990->1996 = ${a9096:,.2f}  -> winner: {winner}")
print(f"per-year: 1985->1990 = ${p8590:,.2f}/yr vs 1990->1996 = ${p9096:,.2f}/yr -> winner: "
      f"{'1985->1990' if p8590 > p9096 else '1990->1996'}")
print(f"pct (fragile, base 1985 ~= $175): {primary.loc[0,'pct_change']:,.1f}% vs {primary.loc[1,'pct_change']:,.1f}%")
print("\nSensitivity winner (abs criterion): "
      f"S1 no-zeros -> {'1985->1990' if s_nozero.loc[0,'abs_increase'] > s_nozero.loc[1,'abs_increase'] else '1990->1996'}; "
      f"S2b strictly-positive -> {'1985->1990' if s_pos_only.loc[0,'abs_increase'] > s_pos_only.loc[1,'abs_increase'] else '1990->1996'}; "
      f"S2 no-negatives -> {'1985->1990' if s_neg_row.loc[0,'abs_increase'] > s_neg_row.loc[1,'abs_increase'] else '1990->1996'}; "
      f"S3 per-wave NaN -> {'1985->1990' if r[0]['abs_increase'] > r[1]['abs_increase'] else '1990->1996'}; "
      f"S4 means -> {'1985->1990' if (mn[W[1]]-mn[W[0]]) > (mn[W[2]]-mn[W[1]]) else '1990->1996'}")
print("\nAll dollar figures are NOMINAL (not inflation-adjusted).")

print("\n" + "=" * 78)
print("5) PRIMARY RESULT TABLE (markdown, for the write-up)")
print("=" * 78)
med = bf[W].median()
tbl = pd.DataFrame({
    "year": [str(y) for y in YEARS],
    "n_black_female_str": [f"{len(bf)}"] * 3,
    "median_wealth_nominal_usd": [med[c] for c in W],
    "share_zero": [round(float((bf[c] == 0).mean()) * 100, 1) for c in W],
    "share_negative": [round(float((bf[c] < 0).mean()) * 100, 1) for c in W],
})
def md(frame):
    cols = list(frame.columns)
    def fmt(v):
        if isinstance(v, float):
            return f"{v:,.2f}".rstrip("0").rstrip(".") if abs(v) < 1e15 else f"{v:g}"
        return str(v)
    lines = ["| " + " | ".join(cols) + " |", "|" + "|".join(["---"] * len(cols)) + "|"]
    for _, row in frame.iterrows():
        lines.append("| " + " | ".join(fmt(row[c]) for c in cols) + " |")
    return "\n".join(lines)


print(md(tbl))
print()
prim = primary.copy()
prim["pct_change"] = prim["pct_change"].round(1)
prim["per_year_increase"] = prim["per_year_increase"].round(1)
print()
print(md(prim))
