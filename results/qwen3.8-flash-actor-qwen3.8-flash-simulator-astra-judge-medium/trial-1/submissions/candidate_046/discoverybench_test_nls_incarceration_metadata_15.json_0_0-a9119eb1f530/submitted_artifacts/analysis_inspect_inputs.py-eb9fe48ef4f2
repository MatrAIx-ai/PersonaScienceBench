import pandas as pd, numpy as np
pd.set_option("display.width", 200)
df = pd.read_csv("data/nls_incarceration_processed.csv")
print("SHAPE:", df.shape)
print("\nDTYPES:\n", df.dtypes)
print("\nMISSING PER COLUMN:\n", df.isna().sum())
print("\nrace uniques:", df["race"].dropna().unique().tolist())
print("sex uniques:", df["sex"].dropna().unique().tolist())
print("ever_jailed uniques:", df["ever_jailed"].dropna().unique().tolist(), "missing:", df["ever_jailed"].isna().sum())
print("\nrace x sex counts:\n", pd.crosstab(df["race"], df["sex"], dropna=False))
print("\never_jailed mean by race x sex (NA excluded):\n",
      df.groupby(["race","sex"], dropna=False)["ever_jailed"].agg(["mean","count","sum"]))
print("\nPROP ever_jailed white male / white female:")
for s in ["male","female"]:
    sub = df[(df.race=="white") & (df.sex==s)]
    print(f"  white {s}: n={len(sub)}  n_ever_jailed={int(sub.ever_jailed.sum())}  prop={sub.ever_jailed.mean():.4f}  na={sub.ever_jailed.isna().sum()}")

cols = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
qs = [0.10,0.25,0.50,0.75,0.90]
for c in ["composite_wealth_1990","composite_wealth_1996"]:
    s = df[c]
    print(f"\n=== {c} (ALL) ===")
    print("non-null:", s.notna().sum(), " null:", s.isna().sum())
    print(s.describe(percentiles=qs).to_string())
    print("min/max:", s.min(), s.max())
    print("zeros:", int((s==0).sum()), " negatives:", int((s<0).sum()), ">0:", int((s>0).sum()))
    print("==1000 mult?", int((s % 1000 == 0).sum()), " value counts of top10:\n", s.value_counts().head(10).to_string())

print("\n=== by group (white male / white female) ===")
for s in ["male","female"]:
    sub = df[(df.race=="white") & (df.sex==s)]
    for c in ["composite_wealth_1990","composite_wealth_1996"]:
        v = sub[c]
        print(f"white {s} {c}: n_nonnull={v.notna().sum()} n_null={v.isna().sum()} mean={v.mean():.1f} "
              f"p10={v.quantile(.1):.1f} p25={v.quantile(.25):.1f} p50={v.median():.1f} p75={v.quantile(.75):.1f} "
              f"p90={v.quantile(.9):.1f} min={v.min():.1f} max={v.max():.1f} zeros={(v==0).sum()} neg={(v<0).sum()}")

# sentinel hunt
print("\n=== SENTINEL HUNT ===")
big = {c: int((df[c] >= 99000).sum()) for c in cols}
print("count >= 99000:", big)
for c in cols:
    vals = np.sort(df[c].dropna().unique())
    print(c, "top-12 distinct:", vals[-12:].tolist())
    print(c, "bottom-12 distinct:", vals[:12].tolist())
print("\nvalues in {99999,999999,9999,-9999,-1,7777,8888,55555} per col:")
for c in cols:
    print(" ", c, {v: int((df[c]==v).sum()) for v in [99999,999999,9999,-9999,-1,7777,8888,55555,999]})

# panel / co-missingness
print("\n=== PANEL STRUCTURE ===")
print("duplicate full rows:", int(df.duplicated().sum()))
key = df.groupby(["race","sex","ever_jailed"]).size()
print("no ID column present; columns =", list(df.columns))
m90, m96 = df["composite_wealth_1990"].isna(), df["composite_wealth_1996"].isna()
m85 = df["composite_wealth_1985"].isna()
print("both 90&96 present:", int((~m90 & ~m96).sum()))
print("90 only:", int((~m90 & m96).sum()), "96 only:", int((m90 & ~m96).sum()), "neither:", int((m90 & m96).sum()))
print("85&90&96 all present:", int((~m85 & ~m90 & ~m96).sum()))
print("\nco-missing by group (white):")
for s in ["male","female"]:
    sub = df[(df.race=="white") & (df.sex==s)]
    a, b = sub["composite_wealth_1990"].isna(), sub["composite_wealth_1996"].isna()
    print(f"  white {s}: n={len(sub)} both={int((~a&~b).sum())} 90only={int((~a&b).sum())} 96only={int((a&~b).sum())} neither={int((a&b).sum())}")
print("\nmissingness vs ever_jailed (both years present rate):")
both = (~m90 & ~m96)
print(df.groupby("ever_jailed", dropna=False).apply(lambda g: pd.Series({"n":len(g),"both_present":both.loc[g.index].sum(),"rate":both.loc[g.index].mean()}), include_groups=False).to_string())
print("\nzero-in both years (rows with 90==0 and 96==0):", int(((df.composite_wealth_1990==0)&(df.composite_wealth_1996==0)).sum()))
print("exact duplicated wealth pairs 90/96:", int(df.duplicated(subset=["composite_wealth_1990","composite_wealth_1996"]).sum()))
