import pandas as pd, numpy as np
df = pd.read_csv("data/nls_incarceration_processed.csv")
cols=["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
print("rows:", len(df), " any-missing per col:", df.isna().sum().to_dict())
print("\nshare zero / negative by group x year")
rows=[]
for (r,s),g in df.groupby(["race","sex"]):
    for c in cols:
        v=g[c]
        rows.append([r,s,c,len(g),(v==0).mean(),(v<0).mean(),(v>0).mean(),
                     v[v>0].median() if (v>0).any() else np.nan])
print(pd.DataFrame(rows,columns=["race","sex","var","n","p_zero","p_neg","p_pos","median_if_pos"]).to_string(index=False))
z = (df[cols]==0).sum(axis=1)
print("\nnumber of zero-years per row (0..3):\n", z.value_counts().sort_index().to_string())
print("all three years zero:", int((z==3).sum()), " share:", (z==3).mean().round(4))
print("negative in any year:", int((df[cols]<0).any(axis=1).sum()))
print("rows with 1985>0 but 1990==0:", int(((df.composite_wealth_1985>0)&(df.composite_wealth_1990==0)).sum()))
print("rows with 1990>0 but 1996==0:", int(((df.composite_wealth_1990>0)&(df.composite_wealth_1996==0)).sum()))
print("rows with 1990==0 and 1996>0:", int(((df.composite_wealth_1990==0)&(df.composite_wealth_1996>0)).sum()))
# rounding / topcode evidence
for c in cols:
    v=df[c][df[c]!=0]
    print(f"\n{c}: nonzero n={len(v)}; %multiple of 100 = {(v%100==0).mean():.3f}; %mult1000={(v%1000==0).mean():.3f}; %mult5000={(v%5000==0).mean():.3f}")
    print("  top-5 most common nonzero values:\n", v.value_counts().head(5).to_string())
    print("  #values >1e6:", int((v>1e6).sum()), " >2e6:", int((v>2e6).sum()))
# duplicate structure
dup_all = df.duplicated(keep=False)
print("\nrows involved in exact duplication:", int(dup_all.sum()))
print("dup rate among white male:", df[df.race.eq('white')&df.sex.eq('male')].duplicated().mean().round(3),
      " white female:", df[df.race.eq('white')&df.sex.eq('female')].duplicated().mean().round(3))
# do duplicated rows all have zeros?
d = df[df.duplicated(keep=False)]
print("duplicated rows share with any zero:", (d[cols]==0).any(axis=1).mean().round(3))
# quick crude inequality numbers just to verify computability (not final)
def gini(x):
    x=np.sort(np.asarray(x,float)); n=len(x); c=np.cumsum(x)
    return (n+1-2*(c.sum()/c[-1])*0) if c[-1]==0 else (2*np.sum(np.arange(1,n+1)*x)/(n*c[-1])-(n+1)/n)
for s in ["male","female"]:
    sub=df[df.race.eq('white')&df.sex.eq(s)]
    for c in ["composite_wealth_1990","composite_wealth_1996"]:
        v=sub[c]
        pos=v[v>0]
        print(f"white {s} {c}: P90/P10={v.quantile(.9)/max(v.quantile(.1),1):.1f} (p10={v.quantile(.1):.0f}) "
              f"P90/P50={v.quantile(.9)/max(v.quantile(.5),1):.2f} CV={v.std()/v.mean():.2f} "
              f"share_top1%={v.nlargest(max(1,int(.01*len(v)))).sum()/v[v>0].sum():.3f} "
              f"P90pos/P10pos={pos.quantile(.9)/pos.quantile(.1):.2f}")
