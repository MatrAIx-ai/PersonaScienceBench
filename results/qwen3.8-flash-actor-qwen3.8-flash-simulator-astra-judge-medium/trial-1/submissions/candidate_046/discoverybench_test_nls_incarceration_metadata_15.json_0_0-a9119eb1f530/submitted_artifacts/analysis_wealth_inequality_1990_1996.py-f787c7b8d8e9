    say(f"  {r} {s}: P90/P50 {a['p90_p50']:.2f} -> {b['p90_p50']:.2f}; Gini {a['gini']:.3f} -> {b['gini']:.3f}; "
        f"n {a['n']} -> {b['n']}")

# ============ ADDENDUM: selection diagnostics + dispersion index valid with negatives
say("\n### ADDENDUM 1: who drops out of the owner distribution between 1990 and 1996 (B-sample selection)")
sel_rows = []
for g, gd in w.groupby("grp"):
    own90 = gd[C90].gt(0) & ~gd.allzero
    drop = own90 & gd[C96].le(0)
    stay = own90 & gd[C96].gt(0)
    sel_rows.append(dict(group=g, n_owners_1990=int(own90.sum()),
                         n_dropped_to_0_or_neg_1996=int(drop.sum()), pct_dropped=100 * drop.sum() / own90.sum(),
                         W1990_med_dropped=gd[C90][drop].median(), W1990_med_stayed=gd[C90][stay].median(),
                         ever_jailed_pct_dropped=100 * gd.ever_jailed[drop].mean(),
                         ever_jailed_pct_stayed=100 * gd.ever_jailed[stay].mean(),
                         W1996_med_of_dropped=gd[C96][drop].median(),
                         share_dropped_W1990_below_group_median=100 * (gd[C90][drop] < gd[C90][own90].median()).mean()))
SEL = pd.DataFrame(sel_rows)
say(SEL.round(2).to_string(index=False))
SEL.round(3).to_csv("analysis/selection_diagnostics.csv", index=False)

say("\n### ADDENDUM 2: mean-absolute-difference dispersion (log-scale-free; computable with zeros/negatives)")
def madisp(x):
    x = np.asarray(x, float)
    return np.abs(x[:, None] - x[None, :]).mean() / (2 * x.mean()) if x.mean() != 0 else np.nan
mi = []
for g, gd in w.groupby("grp"):
    for y, c in [(Y0, C90), (Y1, C96)]:
        vA = gd[c].to_numpy(); vB = gd[c][gd[c].gt(0) & ~gd.allzero].to_numpy()
        mi.append(dict(group=g, year=y, MAD_over_mean_A=madisp(vA), MAD_over_mean_B=madisp(vB)))
MI = pd.DataFrame(mi)
say(MI.round(3).to_string(index=False))
MI.round(4).to_csv("analysis/dispersion_index.csv", index=False)
say("Note: with negatives the Gini formula used is a normalised mean-difference ratio, NOT bounded in [0,1]; "
    "it is reported for sample A only descriptively and is not used in the conclusion.")

say("\n### ADDENDUM 3: sensitivity of the primary conclusion to the 1990-owner non-response rate (imputation)")
say("Re-impute W1996=0 (previous owners) by their 1990 rank-preserving value (persist, no change) and recompute B:")
imp_rows = []
for g, gd in w.groupby("grp"):
    v = gd[C96].to_numpy().copy(); own90 = (gd[C90] > 0) & ~gd.allzero
    v2 = v.copy(); v2[(v <= 0) & own90.to_numpy()] = gd[C90].to_numpy()[(v <= 0) & own90.to_numpy()]
    for lbl, arr in [("B_observed", v[v > 0]), ("B_persistence_imputed", v2[v2 > 0])]:
        m = metrics(arr)
        imp_rows.append(dict(group=g, sample=lbl, year=1996, n=m["n"], p90_p10=m["p90_p10"],
                             p90_p50=m["p90_p50"], gini=m["gini"], cv=m["cv"]))
    m90 = metrics(gd[C90][(gd[C90] > 0) & ~gd.allzero])
    imp_rows.append(dict(group=g, sample="B_observed", year=1990, n=m90["n"], p90_p10=m90["p90_p10"],
                         p90_p50=m90["p90_p50"], gini=m90["gini"], cv=m90["cv"]))
IMP = pd.DataFrame(imp_rows)
say(IMP.round(3).to_string(index=False))
IMP.round(3).to_csv("analysis/imputation_sensitivity.csv", index=False)

say("\n### ADDENDUM 4: median wealth in 1996 among 1990 owners who stayed, by 1990 decile vs the dropped group")
for g, gd in w.groupby("grp"):
    own90 = gd[C90].gt(0) & ~gd.allzero
    sub = gd[own90].copy(); sub["dec"] = pd.qcut(sub[C90].rank(method="first"), 5, labels=False) + 1
    for d_, gg in sub.groupby("dec"):
        dz = gg[C96].le(0)
        say(f"  {g} quintile{int(d_)} of W1990: n={len(gg)}, dropped-to-0/neg={100*dz.mean():.1f}%, "
            f"median W1996 among stayers={gg[C96][~dz].median():,.0f}")

