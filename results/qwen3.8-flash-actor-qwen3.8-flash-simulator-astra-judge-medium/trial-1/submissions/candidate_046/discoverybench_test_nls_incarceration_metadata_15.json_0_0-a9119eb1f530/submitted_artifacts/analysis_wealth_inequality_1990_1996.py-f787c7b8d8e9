"""
Wealth inequality for WHITE males vs females, 1990 -> 1996 (NLSY79 processed extract).
Samples: A as-reported | B wealth>0 per year (PRIMARY) | BP strict panel (positive both years)
         | C zero-as-missing only where non-response evidence exists.
All-zero block = 0 in 1985, 1990 and 1996 (near-duplicate placeholder block).
No sampling weights available -> unweighted throughout.
"""
import numpy as np, pandas as pd
from scipy import stats

RNG = np.random.default_rng(20261022)
Y0, Y1 = 1990, 1996
C85, C90, C96 = "composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"

df = pd.read_csv("data/nls_incarceration_processed.csv")
df["allzero"] = (df[[C85, C90, C96]] == 0).all(axis=1)
w = df[df.race.eq("white")].copy()
w["grp"] = np.where(w.sex.eq("male"), "white_male", "white_female")

log = []
def say(*a):
    s = " ".join(str(x) for x in a); log.append(s); print(s)

say("### SAMPLE CONSTRUCTION (white subsample)")
say(f"white rows total: {len(w)} (male {int(w.grp.eq('white_male').sum())}, female {int(w.grp.eq('white_female').sum())})")
say(f"all-zero block in white: {int(w.allzero.sum())} (male {int((w.allzero & w.grp.eq('white_male')).sum())}, "
    f"female {int((w.allzero & w.grp.eq('white_female')).sum())}); duplicated all-zero rows: {int(w[w.allzero].duplicated().sum())}")
say(f"all-zero share by sex: male {w[w.grp.eq('white_male')].allzero.mean():.4f}, female {w[w.grp.eq('white_female')].allzero.mean():.4f}")
say(f"all-zero ever_jailed mean {w[w.allzero].ever_jailed.mean():.4f} vs rest {w[~w.allzero].ever_jailed.mean():.4f}")

rows = []
for g, gd in w.groupby("grp"):
    for y, c in [(Y0, C90), (Y1, C96)]:
        sets = {
            "A_asreported": gd[c],
            "B_positive": gd[c][gd[c].gt(0) & ~gd.allzero],
            "Bstrict_panel": gd[c][gd[C90].gt(0) & gd[C96].gt(0) & ~gd.allzero],
            "C_zero_as_missing": gd[c][~(gd.allzero | ((gd[C96] == 0) & (gd[C90] > 0)))],
            "B_excl_ever_jailed": gd[c][gd[c].gt(0) & ~gd.allzero & gd.ever_jailed.eq(0)],
        }
        for nm, v in sets.items():
            rows.append([g, y, nm, len(v), len(v) / len(gd)])
sizedf = pd.DataFrame(rows, columns=["group", "year", "sample", "n", "share_kept"])
say("\n### N BY GROUP x YEAR x SAMPLE (share of white group kept)")
say(sizedf.pivot_table(index=["group", "sample"], columns="year", values="n", aggfunc="first").to_string())
say(sizedf.pivot_table(index=["group", "sample"], columns="year", values="share_kept", aggfunc="first").round(3).to_string())

def gini(x):
    x = np.sort(np.asarray(x, float)); n = len(x)
    if n == 0 or x.sum() <= 0: return np.nan
    return (2 * np.sum(np.arange(1, n + 1) * x)) / (n * x.sum()) - (n + 1) / n

def metrics(v, wins=None):
    v = np.asarray(v, float); v = v[~np.isnan(v)]
    if wins is not None: v = np.clip(v, None, np.quantile(v, wins))
    m = dict(n=len(v), mean=v.mean(), p10=np.quantile(v, .10), p25=np.quantile(v, .25), median=np.median(v),
             p75=np.quantile(v, .75), p90=np.quantile(v, .90), p95=np.quantile(v, .95), sd=v.std(ddof=1))
    m["cv"] = m["sd"] / m["mean"] if m["mean"] != 0 else np.nan
    r = lambda a, b: a / b if b > 0 else np.nan
    m["p90_p10"] = r(m["p90"], m["p10"]); m["p75_p25"] = r(m["p75"], m["p25"])
    m["p90_p50"] = r(m["p90"], m["median"]); m["p95_p50"] = r(m["p95"], m["median"])
    m["gini"] = gini(v); m["share_top10"] = v[v >= np.quantile(v, .90)].sum() / v.sum()
    m["pct_le0"] = float((v <= 0).mean())
    return m

rec = []
for g, gd in w.groupby("grp"):
    for y, c in [(Y0, C90), (Y1, C96)]:
        base = gd[c][gd[c].gt(0) & ~gd.allzero]
        sets = {"A_asreported": gd[c], "B_positive": base,
                "Bstrict_panel": gd[c][gd[C90].gt(0) & gd[C96].gt(0) & ~gd.allzero],
                "C_zero_as_missing": gd[c][~(gd.allzero | ((gd[C96] == 0) & (gd[C90] > 0)))],
                "B_winsor_p99": base,
                "B_excl_ever_jailed": gd[c][gd[c].gt(0) & ~gd.allzero & gd.ever_jailed.eq(0)]}
        for nm, v in sets.items():
            rec.append(dict(group=g, year=y, sample=nm, **metrics(v, wins=.99 if nm == "B_winsor_p99" else None)))
M = pd.DataFrame(rec)
keep = ["group", "year", "sample", "n", "p10", "p25", "median", "p75", "p90", "p95",
        "p90_p10", "p75_p25", "p90_p50", "p95_p50", "cv", "gini", "share_top10", "pct_le0", "mean"]
say("\n### MAIN TABLE: metrics x group x year x sample")
for g in ["white_male", "white_female"]:
    say(f"\n-- {g} --"); say(M[M.group.eq(g)][keep].round(3).to_string(index=False))

def ch(g, s, col):
    a = M.query("group==@g and sample==@s and year==@Y1")[col].iloc[0]
    b = M.query("group==@g and sample==@s and year==@Y0")[col].iloc[0]
    return b, a, a - b, (a / b - 1) if b == b and b else np.nan
chg = []
for s in list(M["sample"].unique()):
    for g in ["white_male", "white_female"]:
        row = dict(sample=s, group=g)
        for col in ["p90_p10", "p75_p25", "p90_p50", "p95_p50", "cv", "gini", "share_top10", "pct_le0", "median", "p90"]:
            b, a, d, p = ch(g, s, col); row[col + "_90"] = b; row[col + "_96"] = a; row[col + "_diff"] = d
            row[col + "_chg%"] = 100 * p if p == p else np.nan
        chg.append(row)
CH = pd.DataFrame(chg)
say("\n### CHANGE 1996 vs 1990 (diff and % change of each statistic)")
say(CH[["sample", "group", "p90_p10_90", "p90_p10_96", "p90_p10_diff", "p75_p25_90", "p75_p25_96",
        "p90_p50_90", "p90_p50_96", "p90_p50_diff", "p95_p50_90", "p95_p50_96", "cv_90", "cv_96",
        "gini_90", "gini_96", "gini_diff", "share_top10_90", "share_top10_96", "pct_le0_90", "pct_le0_96",
        "median_chg%", "p90_chg%"]].round(3).to_string(index=False))
M.round(3).to_csv("analysis/metrics_group_year_sample.csv", index=False)
CH.round(4).to_csv("analysis/change_table.csv", index=False)

# ------------------------------------------------- bootstrap CI (key ratios)
say("\n### BOOTSTRAP (1000 reps, percentile CI) on A and B key statistics")
boot_rows = []
for g, gd in w.groupby("grp"):
    for y, c in [(Y0, C90), (Y1, C96)]:
        for nm, v in [("B_positive", gd[c][gd[c].gt(0) & ~gd.allzero].to_numpy()),
                      ("A_asreported", gd[c].to_numpy())]:
            idx = RNG.integers(0, len(v), size=(1000, len(v))); bs = v[idx]
            order = np.sort(bs, axis=1); n = bs.shape[1]
            g9 = (2 * np.sum(np.arange(1, n + 1) * order, axis=1) / (n * np.cumsum(order, axis=1)[:, -1]) - (n + 1) / n)
            q90 = np.quantile(bs, .90, axis=1); q50 = np.median(bs, axis=1); q10 = np.quantile(bs, .10, axis=1)
            for k, arr in [("p90_p50", q90 / np.where(q50 > 0, q50, np.nan)),
                           ("p90_p10", q90 / np.where(q10 > 0, q10, np.nan)),
                           ("gini", g9)]:
                a_ = arr[np.isfinite(arr)]
                if a_.size == 0:      # e.g. P90/P10 in A where P10 = 0 in every resample
                    boot_rows.append(dict(group=g, year=y, sample=nm, metric=k, n=len(v),
                                          boot_mean=np.nan, lo=np.nan, hi=np.nan))
                    continue
                boot_rows.append(dict(group=g, year=y, sample=nm, metric=k, n=len(v), boot_mean=a_.mean(),
                                      lo=np.quantile(a_, .025), hi=np.quantile(a_, .975)))
BT = pd.DataFrame(boot_rows)
say(BT.round(3).to_string(index=False))
# CI on the CHANGE
say("\nChange CIs (1996 - 1990), independent bootstrap draws per year:")
chg_ci = []
for g, gd in w.groupby("grp"):
    draws = {}
    for y, c in [(Y0, C90), (Y1, C96)]:
        for nm, v in [("B_positive", gd[c][gd[c].gt(0) & ~gd.allzero].to_numpy()), ("A_asreported", gd[c].to_numpy())]:
            idx = RNG.integers(0, len(v), size=(1000, len(v))); bs = v[idx]
            order = np.sort(bs, axis=1); n = bs.shape[1]
            draws[(y, nm, "gini")] = (2 * np.sum(np.arange(1, n + 1) * order, axis=1) /
                                      (n * np.cumsum(order, axis=1)[:, -1]) - (n + 1) / n)
            q90 = np.quantile(bs, .90, axis=1); q50 = np.median(bs, axis=1); q10 = np.quantile(bs, .10, axis=1)
            draws[(y, nm, "p90_p50")] = q90 / np.where(q50 > 0, q50, np.nan)
            draws[(y, nm, "p90_p10")] = q90 / np.where(q10 > 0, q10, np.nan)
    for nm in ["A_asreported", "B_positive"]:
        for k in ["p90_p50", "p90_p10", "gini"]:
            d = draws[(Y1, nm, k)] - draws[(Y0, nm, k)]; d = d[np.isfinite(d)]
            if d.size == 0:
                chg_ci.append(dict(group=g, sample=nm, metric=k, diff_mean=np.nan, lo95=np.nan,
                                   hi95=np.nan, pct_reps_diff_gt0=np.nan)); continue
            chg_ci.append(dict(group=g, sample=nm, metric=k, diff_mean=d.mean(),
                               lo95=np.quantile(d, .025), hi95=np.quantile(d, .975),
                               pct_reps_diff_gt0=100 * (d > 0).mean()))
CHCI = pd.DataFrame(chg_ci)
say(CHCI.round(3).to_string(index=False))
BT.round(3).to_csv("analysis/bootstrap_ci.csv", index=False)
CHCI.round(3).to_csv("analysis/bootstrap_change_ci.csv", index=False)

# --------------------- decomposition: mass-at-zero vs owner-distribution
say("\n### DECOMPOSITION of A-based changes into mass-at-zero reweighting vs owner-distribution change")
say("Mapping: a full-distribution percentile p corresponds to owner percentile q=(p-share(<=0))/(1-share(<=0)).")
dec_rows = []
for g, gd in w.groupby("grp"):
    s0, own = {}, {}
    for y, c in [(Y0, C90), (Y1, C96)]:
        s0[y] = float((gd[c] <= 0).mean()); own[y] = np.sort(gd[c][gd[c].gt(0)].to_numpy())
    qq = lambda y, p: (p - s0[y]) / (1 - s0[y])
    val = lambda y, q_: float(np.quantile(own[y], q_)) if 0 < q_ < 1 else np.nan
    for p, lbl in [(0.50, "P50"), (0.75, "P75"), (0.90, "P90")]:
        a0, a1 = qq(Y0, p), qq(Y1, p)
        tot = np.log(val(Y1, a1)) - np.log(val(Y0, a0))
        mass = .5 * ((np.log(val(Y0, a1)) - np.log(val(Y0, a0))) + (np.log(val(Y1, a1)) - np.log(val(Y1, a0))))
        dec_rows.append(dict(group=g, stat=lbl, share_le0_90=s0[Y0], share_le0_96=s0[Y1],
                             owner_pctile_90=100 * a0, owner_pctile_96=100 * a1, total_dlog=tot,
                             mass_at_zero_component=mass, owner_dist_component=tot - mass))
    a, b = qq(Y0, .90), qq(Y0, .50); c_, d_ = qq(Y1, .90), qq(Y1, .50)
    tot = (np.log(val(Y1, c_)) - np.log(val(Y1, d_))) - (np.log(val(Y0, a)) - np.log(val(Y0, b)))
    m0 = (np.log(val(Y0, c_)) - np.log(val(Y0, d_))) - (np.log(val(Y0, a)) - np.log(val(Y0, b)))
    m1 = (np.log(val(Y1, c_)) - np.log(val(Y1, d_))) - (np.log(val(Y1, a)) - np.log(val(Y1, b)))
    mass = .5 * (m0 + m1)
    dec_rows.append(dict(group=g, stat="P90/P50 (log)", share_le0_90=s0[Y0], share_le0_96=s0[Y1],
                         owner_pctile_90=np.nan, owner_pctile_96=np.nan, total_dlog=tot,
                         mass_at_zero_component=mass, owner_dist_component=tot - mass))
DEC = pd.DataFrame(dec_rows)
say(DEC.round(3).to_string(index=False))
DEC.round(4).to_csv("analysis/decomposition_mass_at_zero.csv", index=False)

# ---------------- quantile-conditional dynamics: homogenization vs divergence
say("\n### QUANTILE-CONDITIONAL DYNAMICS: delta wealth by decile of W1990 (strict panel, positive both years)")
dyn_rows = []
for g, gd in w.groupby("grp"):
    p = gd[gd[C90].gt(0) & gd[C96].gt(0) & ~gd.allzero].copy()
    p["d"] = p[C96] - p[C90]; p["lg"] = np.log(p[C96]) - np.log(p[C90])
    p["dec"] = pd.qcut(p[C90].rank(method="first"), 10, labels=False) + 1
    for d_, gg in p.groupby("dec"):
        dyn_rows.append(dict(group=g, decile_of_W1990=int(d_), n=len(gg), W90_med=gg[C90].median(),
                             W96_med=gg[C96].median(), delta_med=gg.d.median(), delta_mean=gg.d.mean(),
                             pct_chg_med_pctile=100 * (gg[C96].median() / gg[C90].median() - 1),
                             median_log_growth=gg.lg.median(), pct_declining=100 * (gg.d < 0).mean(),
                             mean_W96_share_of_total=gg[C96].sum() / p[C96].sum()))
DY = pd.DataFrame(dyn_rows)
for g in ["white_male", "white_female"]:
    say(f"\n-- {g} --"); say(DY[DY.group.eq(g)].round(2).to_string(index=False))
DY.round(3).to_csv("analysis/quantile_dynamics.csv", index=False)
say("\nConvergence diagnostics (strict panel; owners in both years):")
conv_rows = []
for g, gd in w.groupby("grp"):
    p = gd[gd[C90].gt(0) & gd[C96].gt(0) & ~gd.allzero].copy()
    rk = stats.rankdata(p[C90].to_numpy()) / len(p)
    lg = np.log(p[C96].to_numpy()) - np.log(p[C90].to_numpy())
    d = (p[C96] - p[C90]).to_numpy()
    s1 = stats.linregress(rk, lg); s2 = stats.linregress(rk, d)
    row = dict(group=g, n=len(p), slope_loggrowth_on_rank=s1.slope, se=s1.stderr, pval=s1.pvalue,
               spearman_W90_W96=stats.spearmanr(p[C90], p[C96]).statistic,
               slope_dollar_on_rank=s2.slope, pct_declining=100 * (d < 0).mean(),
               ratio_loggrowth_d8_10_over_d1_3=(DY.query("group==@g and decile_of_W1990>=8").median_log_growth.mean() /
                                         DY.query("group==@g and decile_of_W1990<=3").median_log_growth.mean()))
    conv_rows.append(row)
CONV = pd.DataFrame(conv_rows)
say(CONV.round(3).to_string(index=False))
CONV.round(4).to_csv("analysis/convergence_diagnostics.csv", index=False)

# -------------------------------------------- secondary: male-female gap
say("\n### SECONDARY: male-female gap within whites (levels and change)")
gap = []
for s in ["A_asreported", "B_positive", "Bstrict_panel", "C_zero_as_missing"]:
    for y in (Y0, Y1):
        m = M.query("group=='white_male' and sample==@s and year==@y").iloc[0]
        f = M.query("group=='white_female' and sample==@s and year==@y").iloc[0]
        gap.append(dict(sample=s, year=y, med_M=m["median"], med_F=f["median"], M_over_F_med=m["median"] / f["median"],
                        p75_M=m.p75, p75_F=f.p75, M_over_F_p75=m.p75 / f.p75,
                        p90_M=m.p90, p90_F=f.p90, M_over_F_p90=m.p90 / f.p90,
                        mean_M=m["mean"], mean_F=f["mean"], M_over_F_mean=m["mean"] / f["mean"],
                        p90p50_M=m.p90_p50, p90p50_F=f.p90_p50, gini_M=m.gini, gini_F=f.gini))
GAP = pd.DataFrame(gap)
say(GAP.round(3).to_string(index=False))
for s in ["A_asreported", "B_positive", "Bstrict_panel", "C_zero_as_missing"]:
    a = GAP.query("sample==@s and year==@Y0").iloc[0]; b = GAP.query("sample==@s and year==@Y1").iloc[0]
    say(f"  {s}: M/F median {a.M_over_F_med:.3f} -> {b.M_over_F_med:.3f} "
        f"({'gap NARROWED' if b.M_over_F_med < a.M_over_F_med else 'gap WIDENED'}); "
        f"M/F p75 {a.M_over_F_p75:.3f} -> {b.M_over_F_p75:.3f}; M/F p90 {a.M_over_F_p90:.3f} -> {b.M_over_F_p90:.3f}; "
        f"M/F mean {a.M_over_F_mean:.3f} -> {b.M_over_F_mean:.3f}")
GAP.round(3).to_csv("analysis/gender_gap.csv", index=False)

# ------------------------------------- ever_jailed descriptives (low power)
say("\n### ever_jailed descriptive (LOW POWER: white male n_jailed=57, white female n_jailed=12)")
ej = []
for g, gd in w.groupby("grp"):
    for j in [0, 1]:
        sub = gd[gd.ever_jailed.eq(j)]
        for y, c in [(Y0, C90), (Y1, C96)]:
            mA = metrics(sub[c]); mB = metrics(sub[c][sub[c].gt(0) & ~sub.allzero])
            ej.append(dict(group=g, ever_jailed=j, year=y, n=len(sub), pct_le0_A=mA["pct_le0"],
                           median_A=mA["median"], n_B=mB["n"], median_B=mB["median"], p90_B=mB["p90"],
                           p90_p50_B=mB["p90_p50"], gini_B=mB["gini"]))
EJ = pd.DataFrame(ej)
say(EJ.round(3).to_string(index=False))
EJ.round(3).to_csv("analysis/ever_jailed_descriptives.csv", index=False)

# ---------------------- gender-gap regression check (descriptive, NOT causal)
say("\n### CHECK (descriptive, not causal identification): log wealth ~ female*post96 + ever_jailed, whites, wealth>0")
import statsmodels.formula.api as smf
lg_rows = []
for y, c in [(Y0, C90), (Y1, C96)]:
    t = w[["sex", "ever_jailed", "allzero", c]].rename(columns={c: "wthr"}).copy(); t["year"] = y
    lg_rows.append(t)
long = pd.concat(lg_rows)
long = long[(long.wthr > 0) & (~long.allzero)].copy()
long["female"] = long.sex.eq("female").astype(int); long["post96"] = long.year.eq(1996).astype(int)
long["lwealth"] = np.log(long.wthr)
fit = smf.ols("lwealth ~ female * post96 + ever_jailed", data=long).fit(cov_type="HC1")
say(f"n={int(fit.nobs)}; R2={fit.rsquared:.4f}")
say(fit.summary().tables[1].as_text())
say("Interpretation: female=level gap 1990; female:post96=change in the gap 1990->1996 (descriptive; "
    "unbalanced composition across years, no age/education controls, no weights).")

# ------------------------------------------- contextual one-liners other races
say("\n### CONTEXT (one line each): B_positive P90/P50 and Gini, other race groups")
for (r, s), gd in df[df.race.ne("white")].groupby(["race", "sex"]):
