"""
NLSY79: wealth by incarceration status (ever_jailed), per year (1985, 1990, 1996).
Approved plan: nominal $ (no deflation); primary crude per-year comparison
(Welch t-test + Mann-Whitney); effect sizes (median diff, Hodges-Lehmann shift w/ bootstrap CI);
sensitivity (drop negatives, winsorize 1/99, median-based); secondary OLS ~ ever_jailed + race + sex
(HC1 robust SE); male-only robustness. Criterion "significantly lower": Welch p<0.05 AND negative
mean difference, corroborated by Mann-Whitney in same direction; ties broken with robust/median stats.
Available-case per year (no NaN in data anyway). Duplicates kept; 'hipanic' label left as-is.
"""
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.formula.api as smf

rng = np.random.default_rng(42)
df = pd.read_csv("data/nls_incarceration_processed.csv")
YEARS = ["1985", "1990", "1996"]
WCOL = {y: f"composite_wealth_{y}" for y in YEARS}

def hl_shift_ci(x, y, B=4000, alpha=0.05):
    """Hodges-Lehmann shift (median of pairwise x-y diffs) with bootstrap percentile CI."""
    shift = np.median((x[:, None] - y[None, :]).ravel())
    boots = np.empty(B)
    nx, ny = len(x), len(y)
    for b in range(B):
        xb = rng.choice(x, nx, replace=True); yb = rng.choice(y, ny, replace=True)
        # subsample pairwise to keep cost sane for large n
        xs = rng.choice(xb, min(nx, 800), replace=True)
        ys = rng.choice(yb, min(ny, 800), replace=True)
        boots[b] = np.median((xs[:, None] - ys[None, :]).ravel())
    lo, hi = np.percentile(boots, [100*alpha/2, 100*(1-alpha/2)])
    return shift, lo, hi

def winsorize(s, p=0.01):
    lo, hi = np.percentile(s, [100*p, 100*(1-p)])
    return s.clip(lo, hi)

rows = []
for y in YEARS:
    col = WCOL[y]
    d = df[[col, "ever_jailed", "race", "sex"]].dropna(subset=[col])  # available-case per year
    g1 = d.loc[d.ever_jailed == 1, col].to_numpy(float)
    g0 = d.loc[d.ever_jailed == 0, col].to_numpy(float)
    welch_t, welch_p = stats.ttest_ind(g1, g0, equal_var=False)
    mw_u, mw_p = stats.mannwhitneyu(g1, g0, alternative="two-sided")
    hl, hl_lo, hl_hi = hl_shift_ci(g1, g0)
    row = dict(year=y, n_jailed=len(g1), n_nojail=len(g0),
               mean1=g1.mean(), mean0=g0.mean(), diff_means=g1.mean()-g0.mean(),
               med1=np.median(g1), med0=np.median(g0), diff_medians=np.median(g1)-np.median(g0),
               sd1=g1.std(ddof=1), sd0=g0.std(ddof=1),
               welch_t=welch_t, welch_p=welch_p, mw_U=mw_u, mw_p=mw_p,
               hl_shift=hl, hl_lo=hl_lo, hl_hi=hl_hi)
    row["direction_means"] = "lower" if row["diff_means"] < 0 else "higher"
    row["direction_mw"] = "lower" if row["hl_shift"] < 0 else "higher"
    row["significant_lower"] = bool(welch_p < 0.05 and row["diff_means"] < 0 and row["hl_shift"] < 0)
    row["mean_median_discrepancy"] = (np.sign(row["diff_means"]) != np.sign(row["hl_shift"]))
    rows.append(row)
prim = pd.DataFrame(rows)

# ---- sensitivities ----
sens = []
for y in YEARS:
    col = WCOL[y]
    for tag, transform in [("drop_neg", lambda s: s[s >= 0]),
                           ("winsor_1_99", lambda s: winsorize(s))]:
        d = transform(df[col].astype(float))
        g1 = d[df.ever_jailed == 1].to_numpy(float); g0 = d[df.ever_jailed == 0].to_numpy(float)
        t, p = stats.ttest_ind(g1, g0, equal_var=False)
        _, mp = stats.mannwhitneyu(g1, g0, alternative="two-sided")
        hl, lo, hi = hl_shift_ci(g1, g0, B=2000)
        sens.append(dict(sens=tag, year=y, n1=len(g1), n0=len(g0),
                         diff_means=g1.mean()-g0.mean(), diff_medians=np.median(g1)-np.median(g0),
                         welch_p=p, mw_p=mp, hl_shift=hl, hl_lo=lo, hl_hi=hi,
                         sign_means=np.sign(g1.mean()-g0.mean()), sign_hl=np.sign(hl)))
sens = pd.DataFrame(sens)

# ---- secondary adjusted OLS (HC1) ----
ols_rows = []
for y in YEARS:
    d = df.copy()
    d["wealth"] = d[WCOL[y]]
    m = smf.ols("wealth ~ ever_jailed + C(race) + C(sex)", data=d).fit(cov_type="HC1")
    ci = m.conf_int().loc["ever_jailed"]
    ols_rows.append(dict(model="all_adjusted", year=y, coef=m.params["ever_jailed"],
                         p=m.pvalues["ever_jailed"], ci_lo=ci[0], ci_hi=ci[1], n=int(m.nobs)))
    dm = d[d.sex == "male"]
    mm = smf.ols("wealth ~ ever_jailed + C(race)", data=dm).fit(cov_type="HC1")
    cim = mm.conf_int().loc["ever_jailed"]
    ols_rows.append(dict(model="male_only_adjusted", year=y, coef=mm.params["ever_jailed"],
                         p=mm.pvalues["ever_jailed"], ci_lo=cim[0], ci_hi=cim[1], n=int(mm.nobs)))
    # male-only crude Welch
    g1 = dm.loc[dm.ever_jailed==1, "wealth"].to_numpy(float)
    g0 = dm.loc[dm.ever_jailed==0, "wealth"].to_numpy(float)
    t, p = stats.ttest_ind(g1, g0, equal_var=False)
    _, mp = stats.mannwhitneyu(g1, g0, alternative="two-sided")
    ols_rows.append(dict(model=f"male_only_crude(year {y})", year=y, coef=g1.mean()-g0.mean(),
                         p=p, ci_lo=np.nan, ci_hi=np.nan, n=len(g1)+len(g0)))
ols = pd.DataFrame(ols_rows)

pd.set_option("display.width", 220, "display.max_columns", 50, "display.float_format", lambda v: f"{v:,.4g}")
print("=== PRIMARY: descriptivos + tests por año ==="); print(prim.T)
print("\n=== SENSIBILIDADES ==="); print(sens)
print("\n=== SECUNDARIO: OLS ajustado + solo hombres ==="); print(ols)
prim.to_csv("results_primary.csv", index=False); sens.to_csv("results_sensitivities.csv", index=False); ols.to_csv("results_adjusted.csv", index=False)

# medians by group/year table for reporting
tab = df.groupby("ever_jailed").apply(lambda g: pd.Series({
    f"median_{y}_jailed" if False else y: np.nan for y in YEARS}), include_groups=False)
medians = pd.DataFrame({y: [df.loc[df.ever_jailed==1, WCOL[y]].median(), df.loc[df.ever_jailed==0, WCOL[y]].median(),
                             df.loc[df.ever_jailed==1, WCOL[y]].mean(), df.loc[df.ever_jailed==0, WCOL[y]].mean()]
                        for y in YEARS}, index=["median_jailed","median_nojail","mean_jailed","mean_nojail"])
print("\n=== Tabla medios/medianas por grupo y año ==="); print(medians)
