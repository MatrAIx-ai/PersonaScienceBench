"""Stage 1 (PLAN): structural inspection of data/nls_raw.csv -- no results estimation.

Checks: columns/dtypes, racial-ethnic cohort coding, wealth columns availability,
missingness by cohort/year, topcode (cap) signatures, sentinel codes, duplicates.
Run: python3 analysis/inspect_nls_raw.py
"""
import pandas as pd, numpy as np

PATH = "data/nls_raw.csv"
RC = "Racial/ethnic cohort, 1979"
WEALTH = {1985: "Family net wealth, 1985",
          1990: "Family net wealth, 1990",
          1996: "Family net wealth, 1996 (key data point)"}
COHORT = {1: "BLACK", 2: "HISPANIC", 3: "NON-BLACK NON-HISPANIC"}

df = pd.read_csv(PATH)
print("shape:", df.shape)
print("\n-- columns searched for explicit race flags (white/black/hispanic) --")
hits = [c for c in df.columns if any(k in c.lower() for k in ("white", "black", "hispanic", "race", "ethnic", "weight", "wgt", "cpi", "inflation"))]
print(hits if hits else "NONE: only 'Racial/ethnic cohort, 1979' encodes race/ethnicity; no weight/CPI columns")

print("\n-- racial/ethnic cohort coding --")
print(df[RC].value_counts(dropna=False).to_dict(), COHORT)
print("\n-- sample id x cohort --")
print(pd.crosstab(df["Sample ID, 1979 (interview)"], df[RC]))

print("\n-- wealth columns: availability, missingness, caps --")
for y, c in WEALTH.items():
    s = df[c]
    print(f"\n{y}: n_obs={int(s.notna().sum())} missing={int(s.isna().sum())} ({100*s.isna().mean():.1f}%) "
          f"negative={int((s<0).sum())} zeros={int((s==0).sum())} "
          f"min={s.min():.0f} max={s.max():.0f} n_at_max={int((s==s.max()).sum())}")
    tab = df.groupby(RC).apply(lambda g: pd.Series({"n": int(g[c].notna().sum()),
                                                    "miss_pct": round(100*g[c].isna().mean(), 1)}), include_groups=False)
    print(tab.rename_axis("cohort_code").T)

print("\n-- sentinel code scan --")
for c in WEALTH.values():
    s = df[c]
    sent = {v: int((s == v).sum()) for v in (-9999, -8888, -7777, 99999, 999999, 9999999) if (s == v).sum() > 0}
    print(c, sent or "no sentinel-like codes")

print("\n-- duplicates / integrity --")
print("duplicate IDs:", int(df[df.columns[0]].duplicated().sum()))
