"""Median family net wealth by race/ethnicity cohort, NLSY79 (1985, 1990, 1996).

Question: how does the median wealth of white individuals compare with that of
black and Hispanic individuals from 1985 onwards?

Design decisions (agreed with researcher):
  * group derived from `Racial/ethnic cohort, 1979`: 1=BLACK, 2=HISPANIC,
    3=NON-BLACK NON-HISPANIC (used as a PROXY for "white"; it is not a strict
    non-Hispanic white measure).
  * estimator = median (robust to topcoding/skew); means / Winsorised means only
    as a short robustness note.
  * primary comparison = WITHIN-YEAR ratios (inflation-insensitive) + absolute
    differences in levels; secondary = mediles deflated to 1996 dollars with
    hardcoded CPI-U deflators (CPI NOT taken from the dataset).
  * no imputation of wealth: complete cases per cell; N and missing rate reported
    next to every median.
  * full sample in the main analysis; excluding parental-household residents
    (residence codes 17/18/19) is a reported sensitivity, together with a
    balanced-panel check on respondents observed in all three waves.
Run: python3 analysis/wealth_gap_analysis.py
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(20261025)
N_BOOT = 2000
PATH = "data/nls_raw.csv"
RC = "Racial/ethnic cohort, 1979"
RESID = {y: f"Type of residence respondent is living in, {y}" for y in (1985, 1990, 1996)}
WEALTH = {1985: "Family net wealth, 1985",
          1990: "Family net wealth, 1990",
          1996: "Family net wealth, 1996 (key data point)"}
GROUPS = {3: "white (non-black non-Hispanic proxy)", 1: "black", 2: "hispanic"}
SHORT = {3: "white_proxy", 1: "black", 2: "hispanic"}
PARENTAL = [17, 18, 19]
# CPI-U annual averages (1982-84=100), BLS; HARDCODED, not present in the dataset.
CPI = {1985: 107.6, 1990: 130.7, 1996: 156.9}
BASE = 1996


def boot_cell(x, n_boot=N_BOOT):
    """Percentile bootstrap of the median within one cell -> (point, lo, hi)."""
    x = np.asarray(x, dtype=float)
    point = np.median(x)
    idx = RNG.integers(0, x.size, size=(n_boot, x.size))
    meds = np.median(x[idx], axis=1)
    return point, np.percentile(meds, 2.5), np.percentile(meds, 97.5)


def main():
    df = pd.read_csv(PATH)
    idc = df.columns[0]
    cohort_tot = df[RC].value_counts()

    long = pd.concat(
        [pd.DataFrame({"id": df[idc], "cohort": df[RC],
                       "year": y, "wealth": df[c],
                       "parental": df[RESID[y]].isin(PARENTAL)})
         for y, c in WEALTH.items()], ignore_index=True)
    long["group"] = long["cohort"].map(SHORT)

    # ---------- main table: group x year ----------
    rows = []
    for y in (1985, 1990, 1996):
        sub = long[long.year == y]
        for code, gname in ((3, "white_proxy"), (1, "black"), (2, "hispanic")):
            vals = sub.loc[sub.group == gname, "wealth"].dropna().values
            med, lo, hi = boot_cell(vals)
            tot = int(cohort_tot[code])
            rows.append(dict(year=y, group=gname, group_label=GROUPS[code],
                             n_cohort=tot, n_obs=len(vals),
                             missing_n=tot - len(vals),
                             missing_pct=round(100 * (1 - len(vals) / tot), 1),
                             median=med, median_lo95=lo, median_hi95=hi,
                             median_1996usd=med * CPI[BASE] / CPI[y],
                             median_1996usd_lo95=lo * CPI[BASE] / CPI[y],
                             median_1996usd_hi95=hi * CPI[BASE] / CPI[y],
                             mean=vals.mean(), q25=np.percentile(vals, 25),
                             q75=np.percentile(vals, 75),
                             pct_negative=round(100 * (vals < 0).mean(), 1),
                             pct_zero=round(100 * (vals == 0).mean(), 1)))
    tab = pd.DataFrame(rows)

    # ---------- contrasts (bootstrap resamples cells jointly) ----------
    # rebuild per-cell values for joint resampling
    cells = {(y, g): long[(long.year == y) & (long.group == g)]["wealth"].dropna().values
             for y in (1985, 1990, 1996) for g in ("white_proxy", "black", "hispanic")}
    con = []
    for y in (1985, 1990, 1996):
        w = cells[(y, "white_proxy")]
        for other in ("black", "hispanic"):
            o = cells[(y, other)]
            point_r = np.median(w) / np.median(o)
            point_d = np.median(w) - np.median(o)
            iw = RNG.integers(0, w.size, size=(N_BOOT, w.size))
            io = RNG.integers(0, o.size, size=(N_BOOT, o.size))
            mw = np.median(w[iw], axis=1)
            mo = np.median(o[io], axis=1)
            rr = mw / mo
            dd = mw - mo
            con.append(dict(year=y, contrast=f"white_proxy vs {other}",
                            ratio=point_r, ratio_lo95=np.percentile(rr, 2.5),
                            ratio_hi95=np.percentile(rr, 97.5),
                            ratio_1996usd=point_r,  # ratio is inflation-invariant
                            diff_usd=point_d, diff_lo95=np.percentile(dd, 2.5),
                            diff_hi95=np.percentile(dd, 97.5),
                            diff_1996usd=point_d * CPI[BASE] / CPI[y],
                            diff_1996usd_lo95=np.percentile(dd, 2.5) * CPI[BASE] / CPI[y],
                            diff_1996usd_hi95=np.percentile(dd, 97.5) * CPI[BASE] / CPI[y]))
    cont = pd.DataFrame(con)

    # ---------- robustness ----------
    rob = []
    # (a) excluding respondents living in a parental household
    for y in (1985, 1990, 1996):
        sub = long[(long.year == y) & (~long.parental)]
        m = {g: np.median(sub.loc[sub.group == g, "wealth"].dropna())
             for g in ("white_proxy", "black", "hispanic")}
        rob.append(dict(robustness="excl. parental household (resid 17/18/19)", year=y,
                        white=m["white_proxy"], black=m["black"], hispanic=m["hispanic"],
                        ratio_wb=m["white_proxy"] / m["black"],
                        ratio_wh=m["white_proxy"] / m["hispanic"],
                        n_obs=int(sub["wealth"].notna().sum())))
    # (b) balanced panel: respondents with non-missing wealth in all three waves
    ok = (long.dropna(subset=["wealth"]).groupby("id")["year"].nunique() == 3)
    ids = ok[ok].index
    bal = long[long.id.isin(ids)]
    for y in (1985, 1990, 1996):
        sub = bal[bal.year == y]
        m = {g: np.median(sub.loc[sub.group == g, "wealth"].dropna())
             for g in ("white_proxy", "black", "hispanic")}
        rob.append(dict(robustness=f"balanced panel (n_ids={len(ids)})", year=y,
                        white=m["white_proxy"], black=m["black"], hispanic=m["hispanic"],
                        ratio_wb=m["white_proxy"] / m["black"],
                        ratio_wh=m["white_proxy"] / m["hispanic"],
                        n_obs=int(sub["wealth"].notna().sum())))
    # (c) Winsorised means at p99 (topcoded tails) - brief note only
    for y in (1985, 1990, 1996):
        sub = long[long.year == y]
        m = {}
        for g in ("white_proxy", "black", "hispanic"):
            v = sub.loc[sub.group == g, "wealth"].dropna().values
            m[g] = np.clip(v, None, np.percentile(v, 99)).mean()
        rob.append(dict(robustness="mean, winsorised at p99", year=y,
                        white=m["white_proxy"], black=m["black"], hispanic=m["hispanic"],
                        ratio_wb=m["white_proxy"] / m["black"],
                        ratio_wh=m["white_proxy"] / m["hispanic"],
                        n_obs=int(sub["wealth"].notna().sum())))
    # (d) raw means
    for y in (1985, 1990, 1996):
        sub = long[long.year == y]
        m = {g: sub.loc[sub.group == g, "wealth"].dropna().mean()
             for g in ("white_proxy", "black", "hispanic")}
        rob.append(dict(robustness="arithmetic mean (no winsorising)", year=y,
                        white=m["white_proxy"], black=m["black"], hispanic=m["hispanic"],
                        ratio_wb=m["white_proxy"] / m["black"],
                        ratio_wh=m["white_proxy"] / m["hispanic"],
                        n_obs=int(sub["wealth"].notna().sum())))
    robt = pd.DataFrame(rob)

    with pd.option_context("display.width", 220, "display.max_columns", 50):
        print("=== CPI-U deflators used (hardcoded, BLS; NOT from dataset) ===")
        print(CPI, "-> base year", BASE, "\n")
        print("=== MAIN: median family net wealth by group x year ===")
        print(tab.round(0).to_string(index=False), "\n")
        print("=== CONTRASTS: within-year ratio and absolute difference ===")
        print(cont.round(3).to_string(index=False), "\n")
        print("=== ROBUSTNESS ===")
        print(robt.round(0).to_string(index=False), "\n")
        print("=== trend of ratios (core comparison) ===")
        for other in ("black", "hispanic"):
            s = cont[cont.contrast == f"white_proxy vs {other}"].set_index("year")["ratio"]
            print(f"  white_proxy vs {other}: " +
                  "  ".join(f"{y}: {r:.2f}x" for y, r in s.items()))

    tab.to_csv("outputs/table_group_year_medians.csv", index=False)
    cont.to_csv("outputs/table_contrasts.csv", index=False)
    robt.to_csv("outputs/table_robustness.csv", index=False)
    long.to_csv("outputs/analysis_long.csv", index=False)
    print("\nwrote outputs/table_group_year_medians.csv, outputs/table_contrasts.csv,"
          " outputs/table_robustness.csv, outputs/analysis_long.csv")


if __name__ == "__main__":
    main()


# ------------------------------------------------------------------ appended:
# supplementary diagnostics (component prevalence + respondent-level cluster
# bootstrap for the cross-year change in the ratio) -- run via --diagnostics
def diagnostics():
    df = pd.read_csv(PATH)
    df["g"] = df[RC].map(SHORT)
    print("\n=== SUPPLEMENT 1: share (%%) of respondents with non-missing wealth")
    print("    reporting >0 in each wealth component (components are blank for")
    print("    non-owners, so prevalence is computed over wealth respondents) ===")
    for y in (1985, 1990, 1996):
        cols = [c for c in df.columns if (("property" in c.lower() or "vehicles" in c.lower()
                                           or "items over" in c.lower()) and str(y) in c)]
        rows = {}
        for code, g in SHORT.items():
            sub = df[(df.g == g) & df[WEALTH[y]].notna()]
            rows[g] = {c[:52]: round(100 * (sub[c] > 0).sum() / len(sub), 1) for c in cols}
        print(f"\n{y}:"); print(pd.DataFrame(rows).T.to_string())

    print("\n=== SUPPLEMENT 2: respondent-level (cluster) bootstrap of the ratios ===")
    print("    (whole panel of each respondent resampled -> respects within-person")
    print("     correlation across waves, unlike cell-wise bootstrap)")
    rng = np.random.default_rng(7)
    mat = df[[WEALTH[y] for y in (1985, 1990, 1996)]].values
    idxs = {g: np.where(df["g"].values == g)[0] for g in SHORT.values()}
    out = []
    for g in ("black", "hispanic"):
        R = np.full((N_BOOT, 3), np.nan)
        for b in range(N_BOOT):
            iw = rng.choice(idxs["white_proxy"], idxs["white_proxy"].size)
            io = rng.choice(idxs[g], idxs[g].size)
            for k in range(3):
                a = mat[iw, k]; a = a[~np.isnan(a)]
                o = mat[io, k]; o = o[~np.isnan(o)]
                R[b, k] = np.median(a) / np.median(o)
        pt = [np.median(mat[idxs["white_proxy"], k][~np.isnan(mat[idxs["white_proxy"], k])]) /
              np.median(mat[idxs[g], k][~np.isnan(mat[idxs[g], k])]) for k in range(3)]
        chg = R[:, 2] / R[:, 0]
        for k, y in enumerate((1985, 1990, 1996)):
            out.append(dict(contrast=f"white_proxy vs {g}", year=y, ratio=pt[k],
                            cluster_lo95=np.percentile(R[:, k], 2.5),
                            cluster_hi95=np.percentile(R[:, k], 97.5)))
        out.append(dict(contrast=f"white_proxy vs {g}", year="1996/1985 ratio-of-ratios",
                        ratio=pt[2] / pt[0], cluster_lo95=np.percentile(chg, 2.5),
                        cluster_hi95=np.percentile(chg, 97.5)))
        print(f"  {g}: ratios {np.round(pt,2)}; widened 1985->1996 in "
              f"{100*np.mean(chg>1):.1f}% of bootstrap draws")
    d = pd.DataFrame(out)
    print("\n" + d.round(3).to_string(index=False))
    d.to_csv("outputs/table_cluster_bootstrap_ratios.csv", index=False)
    print("wrote outputs/table_cluster_bootstrap_ratios.csv")


if __name__ == "__main__":
    import sys
    if "--diagnostics" in sys.argv:
        diagnostics()
    else:
        main()
