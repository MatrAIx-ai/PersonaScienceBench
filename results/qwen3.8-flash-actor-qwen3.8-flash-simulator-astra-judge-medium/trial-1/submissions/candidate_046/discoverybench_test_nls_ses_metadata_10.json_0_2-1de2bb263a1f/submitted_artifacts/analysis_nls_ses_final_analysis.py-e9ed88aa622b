"""
Definitive analysis for DiscoveryBench nls_ses (metadata_10).
Question: which variable's effect on BA degree completion decreases from ~0.3636 to
~-0.2293 (becoming insignificant) when both race and academic characteristics are
included?

Design (approved): logit (raw coefficients, log-odds), DV = BA DEGREE COMPLETED (0/1),
race dummies with White as reference.
  Model A: BA ~ SES + race                    (no academic characteristics)
  Model B: BA ~ SES + race + PERCENTILE + ASVAB (academic characteristics together)
Plus: bounded variant scan (single nonwhite dummy, z-scored percentile, ASVAB scaling,
optional female/family-size controls), classic + robust SE, VIF diagnostics, and a
pattern check for every other candidate variable.
"""
import warnings
import numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor
warnings.filterwarnings("ignore")

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
y = df["BA DEGREE COMPLETED"].astype(int)
d = pd.DataFrame(index=df.index)
d["black"]    = (df.SAMPLE_RACE == "Black").astype(int)
d["hispanic"] = (df.SAMPLE_RACE == "Hispanic").astype(int)
d["nonwhite"] = (df.SAMPLE_RACE != "White").astype(int)
d["female"]   = (df.SAMPLE_SEX == "Female").astype(int)
d["pct"]      = df["PERCENTILE IN CLASS"]
d["pct_z"]    = (df["PERCENTILE IN CLASS"] - df["PERCENTILE IN CLASS"].mean()) / df["PERCENTILE IN CLASS"].std()
d["asvab"]    = df["ABILITY: COMPOSITE OF ASVAB SCORE"] / 1000.0
d["asvab_raw"]= df["ABILITY: COMPOSITE OF ASVAB SCORE"]
d["ses"]      = df["SES"]
d["fam"]      = df["FAMILY SIZE OF SAMPLE"]

def fit(cols, kind="logit"):
    X = sm.add_constant(d[cols])
    m = sm.Logit(y, X).fit(disp=0) if kind == "logit" else sm.OLS(y, X).fit()
    return m

def fit_robust(cols):
    X = sm.add_constant(d[cols])
    return sm.Logit(y, X).fit(disp=0, cov_type="HC1")

def table(m, cols, cols_full=None):
    mr = fit_robust(cols_full or cols)
    rows = [dict(var=c, coef=round(m.params[c],4), se_classic=round(m.bse[c],4),
                 p_classic=round(m.pvalues[c],4), se_robustHC1=round(mr.bse[c],4),
                 p_robustHC1=round(mr.pvalues[c],4)) for c in cols]
    return pd.DataFrame(rows)

RACE2 = ["black", "hispanic"]; ACAD = ["pct", "asvab"]

print("=== HEADLINE: logit, White reference, academic characteristics entered together ===")
mA = fit(["ses"] + RACE2)
mB = fit(["ses"] + RACE2 + ACAD)
print("\nModel A: BA ~ SES + black + hispanic")
print(table(mA, ["ses"] + RACE2, ["ses"] + RACE2).to_string(index=False))
print("\nModel B: BA ~ SES + black + hispanic + percentile + ASVAB(/1000)")
print(table(mB, ["ses"] + RACE2 + ACAD, ["ses"] + RACE2 + ACAD).to_string(index=False))
print(f"\nSES delta (B-A): {mB.params['ses']-mA.params['ses']:.4f}")

for extra, lbl in [("pct", "percentile only"), ("asvab", "ASVAB only")]:
    m = fit(["ses"] + RACE2 + [extra])
    print(f"Model B-{lbl}: SES coef={m.params['ses']:.4f} p_classic={m.pvalues['ses']:.4f} "
          f"p_robust={fit_robust(['ses'] + RACE2 + [extra]).pvalues['ses']:.4f}")

print("\n=== VIF (Model B regressors) ===")
XB = sm.add_constant(d[["ses"] + RACE2 + ACAD])
vif = pd.DataFrame({"var": XB.columns,
    "VIF": [round(variance_inflation_factor(XB.values, i),2) for i in range(XB.shape[1])]}).iloc[1:]
print(vif.to_string(index=False))
print("\nCorrelations (Model B regressors):")
print(d[["ses"] + RACE2 + ACAD].corr().round(3).to_string())

print("\n=== Bounded variant scan (A: race+SES vs B: race+SES+academics) ===")
rows = []
variants = [
    ("2 dummies, pct raw, asvab/1000 (baseline)", RACE2, ["pct", "asvab"], []),
    ("1 nonwhite dummy, pct raw, asvab/1000", ["nonwhite"], ["pct", "asvab"], []),
    ("2 dummies, pct Z-scored, asvab/1000", RACE2, ["pct_z", "asvab"], []),
    ("2 dummies, pct raw, asvab raw", RACE2, ["pct", "asvab_raw"], []),
    ("2 dummies + female control", RACE2, ["pct", "asvab"], ["female"]),
    ("2 dummies + family size control", RACE2, ["pct", "asvab"], ["fam"]),
    ("2 dummies + female + family size", RACE2, ["pct", "asvab"], ["female", "fam"]),
    ("nonwhite + female + fam", ["nonwhite"], ["pct", "asvab"], ["female", "fam"]),
]
for lbl, race, acad, ctrl in variants:
    a = fit(["ses"] + race + ctrl)
    b = fit(["ses"] + race + acad + ctrl)
    br = fit_robust(["ses"] + race + acad + ctrl)
    gap = abs(a.params["ses"]-0.3636) + abs(b.params["ses"]+0.2293)
    rows.append(dict(variant=lbl, A_ses=round(a.params["ses"],4), A_p=round(a.pvalues["ses"],5),
                     B_ses=round(b.params["ses"],4), B_p_classic=round(b.pvalues["ses"],4),
                     B_p_robust=round(br.pvalues["ses"],4), target_gap=round(gap,4)))
scan = pd.DataFrame(rows).sort_values("target_gap")
print(scan.to_string(index=False))
best = scan.iloc[0]
print(f"\nClosest variant to (0.3636, -0.2293): {best['variant']} -> "
      f"A={best['A_ses']}, B={best['B_ses']} (gap={best['target_gap']})")

print("\n=== Pattern check: any OTHER variable with +0.36 -> -0.23 ? ===")
for v in ["black", "hispanic", "nonwhite", "female", "fam", "pct", "asvab", "pct_z"]:
    if v == "pct_z": continue
    raceA = [c for c in RACE2 if c != v] or ["nonwhite"]
    others_acad = [c for c in ["pct", "asvab"] if c != v]
    a = fit([v] + raceA)
    b = fit([v] + raceA + others_acad)
    match = (abs(a.params[v]-0.3636) < 0.10 and abs(b.params[v]+0.2293) < 0.10)
    print(f"{v:9s} A={a.params[v]:+.4f} (p={a.pvalues[v]:.4f})  B={b.params[v]:+.4f} "
          f"(p={b.pvalues[v]:.4f})  matches: {match}")

print("\n=== LPM sanity check (why logit is required) ===")
for cols, lbl in [(["ses"]+RACE2,"A"), (["ses"]+RACE2+ACAD,"B")]:
    m = fit(cols, "ols")
    print(f"LPM {lbl}: SES coef={m.params['ses']:+.4f} p={m.pvalues['ses']:.4f} "
          f"(targets +0.3636/-0.2293 unreachable in LPM)")
