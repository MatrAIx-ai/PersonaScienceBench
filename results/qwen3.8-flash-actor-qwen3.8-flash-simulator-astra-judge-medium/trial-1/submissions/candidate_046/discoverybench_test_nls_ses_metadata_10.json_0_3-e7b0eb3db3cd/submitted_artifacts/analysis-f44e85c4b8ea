import numpy as np, pandas as pd
import statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['AB'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PCT'] = df['PERCENTILE IN CLASS']
df['SES'] = df['SES']
df['FAM'] = df['FAMILY SIZE OF SAMPLE']

# Dummy coding: race ref = White, sex dummy Female (also Male for completeness)
d = pd.get_dummies(df['SAMPLE_RACE'], prefix='R', drop_first=False).astype(float)
df['Black'] = d.get('R_Black', 0.0)
df['Hispanic'] = d.get('R_Hispanic', 0.0)
df['Female'] = (df['SAMPLE_SEX'] == 'Female').astype(float)
df['Male'] = (df['SAMPLE_SEX'] == 'Male').astype(float)

# To report ALL contrasts with SEs, fit each candidate as its own model spec:
# Model A: BA ~ candidate
# Model B: BA ~ candidate + SES
# Model C: BA ~ candidate + SES + AB + PCT  (main spec, academic characteristics)
# Model C+fam: BA ~ candidate + SES + AB + PCT + FAM (variant)
# Also full-spec joint model (all dummies together) for reference.

cands = ['Black', 'Hispanic', 'Female', 'Male']
ACAD = ['SES', 'AB', 'PCT']

def fit(y, Xcols, family):
    X = sm.add_constant(df[Xcols].astype(float))
    m = family(y, X).fit(disp=0, maxiter=200)
    return m

logit = sm.Logit; probit = sm.Probit
rows = []
for fname, fam in [('logit', logit), ('probit', probit)]:
    for spec_name, xcols in [
        ('A_base', None), ('B_ses', ['SES']), ('C_acad', ACAD), ('C_acad_fam', ACAD + ['FAM'])]:
        for c in cands:
            cols = [c] + (xcols if xcols else [])
            m = fit(df['BA'], cols, fam)
            rows.append(dict(model=fname, spec=spec_name, cand=c,
                             coef=m.params[c], se=m.bse[c], p=m.pvalues[c]))
res = pd.DataFrame(rows)
pd.set_option('display.float_format', lambda v: f'{v:.4f}')

print("=== Per-candidate models (candidate entered alone as background var) ===")
for fname in ['logit', 'probit']:
    print(f"\n--- {fname} ---")
    piv = res[res.model==fname]
    for spec in ['A_base','B_ses','C_acad','C_acad_fam']:
        sub = piv[piv.spec==spec][['cand','coef','se','p']]
        print(f"\nSpec {spec}:\n", sub.to_string(index=False))

# Matching criterion: A coef within +-0.01 of 0.5024, C coef within +-0.01 of 0.0923, p_C>0.05
print("\n=== MATCH CHECK (|A-0.5024|<=0.01 and |C-0.0923|<=0.01 and p_C>0.05) ===")
for fname in ['logit','probit']:
    for spec in ['C_acad','C_acad_fam']:
        a = res[(res.model==fname)&(res.spec=='A_base')].set_index('cand')
        c = res[(res.model==fname)&(res.spec==spec)].set_index('cand')
        for cand in cands:
            okA = abs(a.loc[cand,'coef']-0.5024)<=0.01
            okC = abs(c.loc[cand,'coef']-0.0923)<=0.01
            okp = c.loc[cand,'p']>0.05
            print(f"{fname:6s} {spec:11s} {cand:8s} A={a.loc[cand,'coef']:.4f} C={c.loc[cand,'coef']:.4f} pC={c.loc[cand,'p']:.4f} matchA={okA} matchC={okC} p>0.05={okp} MATCH={okA and okC and okp}")

# Joint full model with all race+sex dummies for reference
for fname, fam in [('logit', logit), ('probit', probit)]:
    m = fit(df['BA'], ['Black','Hispanic','Female'] + ACAD, fam)
    print(f"\nJoint {fname} (Black+Hispanic+Female + SES+AB+PCT):")
    print(pd.DataFrame({'coef':m.params,'se':m.bse,'p':m.pvalues}).round(4).to_string())
    m0 = fit(df['BA'], ['Black','Hispanic','Female'], fam)
    print(f"Joint {fname} A (background only):")
    print(pd.DataFrame({'coef':m0.params,'se':m0.bse,'p':m0.pvalues}).round(4).to_string())

res.to_csv('analysis/model_results.csv', index=False)
print("\nSaved analysis/model_results.csv")
