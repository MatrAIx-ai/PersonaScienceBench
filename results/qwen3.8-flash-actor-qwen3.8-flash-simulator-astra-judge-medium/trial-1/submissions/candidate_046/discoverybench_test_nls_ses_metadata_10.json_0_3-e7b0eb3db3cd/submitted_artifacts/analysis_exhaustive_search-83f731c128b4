import numpy as np, pandas as pd, statsmodels.api as sm, itertools

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['AB'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']/1000.
df['PCT'] = df['PERCENTILE IN CLASS']
df['SES'] = df['SES']; df['FAM'] = df['FAMILY SIZE OF SAMPLE']
df['Black'] = (df['SAMPLE_RACE']=='Black').astype(float)
df['Hispanic'] = (df['SAMPLE_RACE']=='Hispanic').astype(float)
df['White'] = (df['SAMPLE_RACE']=='White').astype(float)
df['Female'] = (df['SAMPLE_SEX']=='Female').astype(float)
df['Male'] = (df['SAMPLE_SEX']=='Male').astype(float)
df['ABz'] = ((df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/df['ABILITY: COMPOSITE OF ASVAB SCORE'].std())
df['PCTz'] = (df['PCT']-df['PCT'].mean())/df['PCT'].std()

others = ['SES','AB','PCT','FAM','Black','Hispanic','Female','ABz','PCTz']
cands = ['Black','Hispanic','White','Female','Male','SES','FAM','AB','PCT']

rows=[]
for fname, fam in [('logit',sm.Logit),('probit',sm.Probit)]:
    for c in cands:
        ctrl = [o for o in others if o!=c and not (c in ('Male',) and o=='Female') ]
        for r in range(0, len(ctrl)+1):
            for comb in itertools.combinations(ctrl, r):
                cols=[c]+list(comb)
                try:
                    m=fam(df['BA'], sm.add_constant(df[cols].astype(float))).fit(disp=0, maxiter=200)
                except Exception:
                    continue
                rows.append((fname,c,'+'.join(comb) if comb else '(none)',m.params[c],m.bse[c],m.pvalues[c]))
res=pd.DataFrame(rows, columns=['model','cand','controls','coef','se','p'])

tgtA, tgtC, tol = 0.5024, 0.0923, 0.01
print("Coefs near 0.5024 (±0.02):")
print(res[(res.coef-tgtA).abs()<0.02].to_string(index=False))
print("\nCoefs near 0.0923 (±0.02):")
print(res[(res.coef-tgtC).abs()<0.02].to_string(index=False))

print("\nPairs same cand&model: A-like spec and C-like spec (C includes SES and at least one of AB/PCT/ABz/PCTz), pC>0.05:")
for (mo,c), g in res.groupby(['model','cand']):
    As=g[(g.coef-tgtA).abs()<=tol]; Cs=g[((g.coef-tgtC).abs()<=tol)&(g.p>0.05)]
    for _,a in As.iterrows():
        for _,cc in Cs.iterrows():
            ctrlC=cc.controls.split('+')
            if 'SES' in ctrlC and any(x in ctrlC for x in ['AB','PCT','ABz','PCTz']):
                print(mo, c, '| A-spec:',a.controls,a.coef.round(4),'| C-spec:',cc.controls, cc.coef.round(4), 'pC=',round(cc.p,4))
res.to_csv('analysis/search_all_specs.csv', index=False)
