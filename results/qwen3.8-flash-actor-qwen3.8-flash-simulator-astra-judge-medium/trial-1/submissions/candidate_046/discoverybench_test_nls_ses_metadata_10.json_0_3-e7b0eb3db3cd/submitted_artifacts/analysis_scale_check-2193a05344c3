import numpy as np, pandas as pd, statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['AB'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']/1000.
df['PCT'] = df['PERCENTILE IN CLASS']; df['SES'] = df['SES']
df['Black'] = (df['SAMPLE_RACE']=='Black').astype(float)
df['Hisp'] = (df['SAMPLE_RACE']=='Hispanic').astype(float)
df['White'] = (df['SAMPLE_RACE']=='White').astype(float)
df['Minority'] = (df['SAMPLE_RACE']!='White').astype(float)
df['NonBlack'] = (df['SAMPLE_RACE']!='Black').astype(float)

specs = {'A_bruto(race only)': ['BLACK','HISP'], 'B_+SES': ['BLACK','HISP','SES'],
         'C_+SES+acad': ['BLACK','HISP','SES','AB','PCT']}
def build(cols):
    return [c.replace('BLACK','Black').replace('HISP','Hisp') for c in cols]

rows=[]
for name, cols in specs.items():
    X = sm.add_constant(df[build(cols)].astype(float))
    # LPM
    ols = sm.OLS(df['BA'], X).fit()
    # logit + AMEs
    logit = sm.Logit(df['BA'], X).fit(disp=0, maxiter=300)
    ame = {}
    for var in ['Black','Hisp','White','Minority','NonBlack']:
        if var in X.columns:
            d = logit.get_margeff(dummies=False)  # marginal effects at means
            ame[var] = ('MEM', d.margeff[X.columns.get_loc(var)-1], d.margeff_se[X.columns.get_loc(var)-1], d.pvalues[X.columns.get_loc(var)-1])
    for var in ['Black','Hisp']:
        rows.append(dict(stage=name, scale='LPM', var=var, coef=ols.params[var], se=ols.bse[var], p=ols.pvalues[var]))
        rows.append(dict(stage=name, scale='logit coef', var=var, coef=logit.params[var], se=logit.bse[var], p=logit.pvalues[var]))
        if var in ame: rows.append(dict(stage=name, scale='logit MEM', var=var, coef=ame[var][1], se=ame[var][2], p=ame[var][3]))
    # AME (average marginal effects, dx/dy)
    mg = logit.get_margeff(at='overall', dummy=True)
    for var in ['Black','Hisp']:
        j = list(X.columns).index(var)
        rows.append(dict(stage=name, scale='logit AME', var=var, coef=mg.margeff[j-1], se=mg.margeff_se[j-1], p=mg.pvalues[j-1]))

# Minority / White codings in same stages (race as single dummy)
for var in ['Minority','White','NonBlack']:
    for name, base in [('A_bruto',['VAR']), ('B_+SES',['VAR','SES']), ('C_+SES+acad',['VAR','SES','AB','PCT'])]:
        cols=[var if b=='VAR' else b for b in base]
        X = sm.add_constant(df[cols].astype(float))
        ols = sm.OLS(df['BA'], X).fit()
        lg = sm.Logit(df['BA'], X).fit(disp=0, maxiter=300)
        mg = lg.get_margeff(at='overall', dummy=True)
        j = cols.index(var)
        rows.append(dict(stage=name+f' [{var}]', scale='LPM', var=var, coef=ols.params[var], se=ols.bse[var], p=ols.pvalues[var]))
        rows.append(dict(stage=name+f' [{var}]', scale='logit coef', var=var, coef=lg.params[var], se=lg.bse[var], p=lg.pvalues[var]))
        rows.append(dict(stage=name+f' [{var}]', scale='logit AME', var=var, coef=mg.margeff[j-1], se=mg.margeff_se[j-1], p=mg.pvalues[j-1]))

out = pd.DataFrame(rows)
pd.set_option('display.float_format', lambda v: f'{v: .4f}')
print(out.to_string(index=False))
out.to_csv('analysis/scale_check.csv', index=False)
print("\nAny value within |Δ|<0.01 of +0.5024?")
hit = out[(out.coef-0.5024).abs()<0.01]
print(hit.to_string(index=False) if len(hit) else "NONE")
