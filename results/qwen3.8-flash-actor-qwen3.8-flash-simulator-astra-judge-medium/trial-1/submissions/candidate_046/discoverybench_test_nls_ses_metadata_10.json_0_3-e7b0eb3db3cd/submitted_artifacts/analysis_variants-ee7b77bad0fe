import numpy as np, pandas as pd, statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['AB'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PCT'] = df['PERCENTILE IN CLASS']
df['SES'] = df['SES']; df['FAM'] = df['FAMILY SIZE OF SAMPLE']
df['White'] = (df['SAMPLE_RACE']=='White').astype(float)
df['Minority'] = (df['SAMPLE_RACE']!='White').astype(float)
df['Female'] = (df['SAMPLE_SEX']=='Female').astype(float)
df['ABz'] = (df['AB']-df['AB'].mean())/df['AB'].std()
df['PCTp'] = df['PCT']/100
df['PCTz'] = (df['PCT']-df['PCT'].mean())/df['PCT'].std()

def fit(fam, cols):
    X = sm.add_constant(df[cols].astype(float))
    return fam(df['BA'], X).fit(disp=0, maxiter=300)

def show(tag, m, key):
    print(f"{tag:38s} {key:8s} coef={m.params[key]: .4f} se={m.bse[key]:.4f} p={m.pvalues[key]:.4f}")

tests = [
    ('White',        ['White'],              ['SES','AB','PCT']),
    ('Minority',     ['Minority'],           ['SES','AB','PCT']),
    ('SES alone',    ['SES'],                ['AB','PCT']),            # X=SES, academic controls
    ('FAM',          ['FAM'],                ['SES','AB','PCT']),
    ('White_std',    ['White'],              ['SES','ABz','PCTz']),
    ('SES_stdacad',  ['SES'],                ['ABz','PCTz']),
    ('SES_acadfam',  ['SES'],                ['AB','PCT','FAM']),
]
for fname, fam in [('logit', sm.Logit), ('probit', sm.Probit)]:
    print(f"\n===== {fname} =====")
    for tag, base, ctrl in tests:
        key = base[0]
        mA = fit(fam, base)
        mC = fit(fam, base + ctrl)
        show(f"[{tag}] A: ~{key}", mA, key)
        show(f"[{tag}] C: +{'+'.join(ctrl)}", mC, key)
        # also intermediate: base+SES for White/Minority
        if key in ('White','Minority'):
            mB = fit(fam, base+['SES']); show(f"[{tag}] B: +SES", mB, key)
