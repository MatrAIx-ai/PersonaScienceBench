"""NLS: does the SES -> BA-completion relation vary by race?
Headline M_total (no academic adjustment); M_adjusted / M_adjusted_ability_only
as mechanism. Interaction SES(1SD linear) x RACE (ref=White). MLE + Firth side
by side; bootstrap (1000 reps, Firth per replicate) CIs for race-specific
OR/SD and g-computation P(BA) differences p10->p90. Mandatory linearity
sensitivity with SES quartile dummies x race. Spearman direction check and
FAMILY SIZE==1 exclusion sensitivity.
"""
import numpy as np, pandas as pd
from scipy import stats
rng = np.random.default_rng(20261025)
pd.set_option('display.width', 240); pd.set_option('display.max_columns', 60)
BA_REPS = 1000

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['y'] = df['BA DEGREE COMPLETED'].astype(int)
def z(c): return (df[c]-df[c].mean())/df[c].std(ddof=1)
df['ses_z'] = z('SES')
df['ab_z'] = z('ABILITY: COMPOSITE OF ASVAB SCORE')
df['pc_z'] = z('PERCENTILE IN CLASS')
df['blk'] = (df.SAMPLE_RACE=='Black').astype(float)
df['hsp'] = (df.SAMPLE_RACE=='Hispanic').astype(float)
df['female'] = (df.SAMPLE_SEX=='Female').astype(float)
df['fam'] = df['FAMILY SIZE OF SAMPLE']
RACES = ['White','Black','Hispanic']

def irls(X, y, maxit=60, tol=1e-10, firth=False):
    n, p = X.shape; b = np.zeros(p); it = 0
    for it in range(maxit):
        eta = np.clip(X@b, -35, 35); pr = 1/(1+np.exp(-eta))
        W = np.clip(pr*(1-pr), 1e-12, None)
        V = X.T @ (X*W[:,None])
        try: Vinv = np.linalg.inv(V)
        except np.linalg.LinAlgError: Vinv = np.linalg.pinv(V)
        def score(bb):
            e = np.clip(X@bb, -35, 35); p2 = 1/(1+np.exp(-e)); w2 = np.clip(p2*(1-p2),1e-12,None)
            u = X.T@(y-p2)
            if firth:
                V2 = X.T@(X*w2[:,None])
                try: V2i = np.linalg.inv(V2)
                except np.linalg.LinAlgError: V2i = np.linalg.pinv(V2)
                h = np.einsum('ij,jk,ik->i', X, V2i, X)
                u = u + 0.5*(X.T@(w2*(1-2*p2)*h))
            return u
        U = score(b); step = Vinv@U; t = 1.0
        cur = np.linalg.norm(U)
        for _ in range(25 if firth else 0):
            Un = score(b+t*step)
            if np.linalg.norm(Un) < cur: break
            t /= 2
        b = b + t*step
        if np.max(np.abs(t*step)) < tol: break
    eta = np.clip(X@b, -35, 35); pr = 1/(1+np.exp(-eta))
    W = np.clip(pr*(1-pr), 1e-12, None); V = X.T@(X*W[:,None])
    try: cov = np.linalg.inv(V)
    except np.linalg.LinAlgError: cov = np.linalg.pinv(V)
    ll = float(np.sum(y*np.log(np.clip(pr,1e-300,1)) + (1-y)*np.log(np.clip(1-pr,1e-300,1))))
    return dict(beta=b, cov=cov, ll=ll)

def design(d, main, inter=False):
    cols = ['const'] + main
    Xc = [np.ones(len(d))] + [d[c].values.astype(float) for c in main]
    if inter:
        Xc += [(d.ses_z*d.blk).values, (d.ses_z*d.hsp).values]; cols += ['i_blk','i_hsp']
    return np.column_stack(Xc), cols

def fit_pair(d, main, inter):
    X, cols = design(d, main, inter); y = d['y'].values.astype(float)
    return X, cols, y, irls(X, y), irls(X, y, firth=True)

BASE = ['blk','hsp','female','fam']
models = {
 'M0_total':  fit_pair(df, BASE+['ses_z'], False),
 'M1_total':  fit_pair(df, BASE+['ses_z'], True),
 'M0_adj':    fit_pair(df, BASE+['ses_z','ab_z','pc_z'], False),
 'M1_adj':    fit_pair(df, BASE+['ses_z','ab_z','pc_z'], True),
 'M0_adjA':   fit_pair(df, BASE+['ses_z','ab_z'], False),
 'M1_adjA':   fit_pair(df, BASE+['ses_z','ab_z'], True),
}

print('='*100); print('0) SPEARMAN (direction check: expect SES~ABILITY>0, SES~PERCENTILE>0)'); print('='*100)
vars_ = ['ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE','y']
rows = {}
for lab, sub in [('overall',df)] + [(r,df[df.SAMPLE_RACE==r]) for r in RACES]:
    rows[lab] = {v[:20]: sub[['SES',v]].corr('spearman').iloc[0,1] for v in vars_}
print(pd.DataFrame(rows).round(3).to_string())

print(); print('='*100); print('1) COEFFICIENTS (log-odds): MLE vs FIRTH'); print('='*100)
for k,(X,cols,y,m,f) in models.items():
    sem, sef = np.sqrt(np.diag(m['cov'])), np.sqrt(np.diag(f['cov']))
    tab = pd.DataFrame({'MLE':m['beta'],'seMLE':sem,'Firth':f['beta'],'seFirth':sef}, index=cols)
    print(f'\n--- {k} (events={int(y.sum())}, k={X.shape[1]}, ll_MLE={m["ll"]:.2f}) ---')
    print(tab.round(4).to_string())
    mx = np.max(np.abs(m['beta']))
    print(f'  max|coef|MLE={mx:.3f} ' + ('-> NO separation/blow-up detected' if mx<8 else '*** MLE EXPLODED: separation suspected; trust Firth ***'))

print(); print('='*100); print('2) LR TESTS for SES x RACE interaction (chi2, df=2)'); print('='*100)
for pair, lab in [('M1_total','Total (headline)'), ('M1_adj','Adjusted (mechanism)'), ('M1_adjA','Ability-only')]:
    k0 = 'M0' + pair[2:]
    s = 2*(models[pair][3]['ll'] - models[k0][3]['ll'])
    sf = 2*(models[pair][4]['ll'] - models[k0][4]['ll'])  # approx: unpenalized ll at Firth optima
    print(f'  {lab:20s} MLE: chi2={s:7.3f} p={stats.chi2.sf(max(s,0),2):.4f}   Firth(approx): chi2={sf:7.3f} p={stats.chi2.sf(max(sf,0),2):.4f}')

# ---------- 3) race-specific OR/SD + g-computation marginals, bootstrap ----------
def race_slope_vec(cols, r):
    v = np.zeros(len(cols)); v[cols.index('ses_z')] = 1
    ic = 'i_blk' if r=='Black' else 'i_hsp' if r=='Hispanic' else None
    if ic is not None and ic in cols: v[cols.index(ic)] = 1
    return v

def gmarg(X, cols, b, dsub, qlo, qhi):
    """g-computation within one race subset: mean pred at qhi minus qlo."""
    Xlo, Xhi = X.copy(), X.copy()
    j = cols.index('ses_z'); Xlo[:,j]=qlo; Xhi[:,j]=qhi
    for ic, rc in [('i_blk','blk'),('i_hsp','hsp')]:
        if ic in cols:
            Xlo[:,cols.index(ic)] = qlo*X[:,cols.index(rc)]
            Xhi[:,cols.index(ic)] = qhi*X[:,cols.index(rc)]
    plo = 1/(1+np.exp(-np.clip(Xlo@b,-35,35))); phi = 1/(1+np.exp(-np.clip(Xhi@b,-35,35)))
    return plo.mean(), phi.mean()

masks = {r: (df.SAMPLE_RACE==r).values for r in RACES}
q10 = {r: float(np.quantile(df.loc[df.SAMPLE_RACE==r,'ses_z'],.10)) for r in RACES}
q90 = {r: float(np.quantile(df.loc[df.SAMPLE_RACE==r,'ses_z'],.90)) for r in RACES}

def marg_table(k, which):
    X, cols, y, m, f = models[k]; b = m['beta'] if which=='MLE' else f['beta']
    out = {}
    for r in RACES:
        lo, hi = gmarg(X[masks[r]], cols, b, None, q10[r], q90[r])
        out[r] = (lo*100, hi*100, (hi-lo)*100)
    return out

def bootstrap_model(k, reps=BA_REPS, seed=12345):
    X, cols, y, m, f = models[k]; n = X.shape[0]
    loc = np.random.default_rng(seed)
    OR = np.full((reps,3), np.nan); MG = np.full((reps,3), np.nan); CT = np.full((reps,3), np.nan)
    for t in range(reps):
        bi = loc.integers(0, n, n)
        if y[bi].sum() < 10: continue
        try: mb = irls(X[bi], y[bi], firth=False, maxit=25, tol=1e-8)
        except Exception: continue
        b = mb['beta']
        slopes = {r: b[cols.index('ses_z')] + (b[cols.index('i_blk')] if r=='Black' else b[cols.index('i_hsp')] if r=='Hispanic' else 0) for r in RACES}
        for j,r in enumerate(RACES):
            OR[t,j] = np.exp(slopes[r])
            msk = masks[bi] if False else None
        msk_all = masks_r[bi] if 'masks_r' in dir() else None
        for j,r in enumerate(RACES):
            m = masks_arr[j][bi]
            if m.sum()<20: continue
            q1b = np.quantile(df['ses_z'].values[bi][m], .10); q9b = np.quantile(df['ses_z'].values[bi][m], .90)
            lo, hi = gmarg(X[bi][m], cols, b, None, q1b, q9b)
            MG[t,j] = hi-lo
        CT[t,0]=OR[t,0]/OR[t,1]; CT[t,1]=OR[t,0]/OR[t,2]; CT[t,2]=OR[t,1]/OR[t,2]
    return OR, MG, CT
masks_arr = np.array([masks[r] for r in RACES])
masks_r = masks_arr

for k, lab in [('M1_total','TOTAL (headline, no academic adjustment)'),
               ('M1_adj','ADJUSTED (+ABILITY +PERCENTILE)'),
               ('M1_adjA','ABILITY-ONLY')]:
    X, cols, y, m, f = models[k]; b, cov = m['beta'], m['cov']
    print(); print('='*100); print(f'3{["total","adj","adjA"].index(k[3:]) if False else ""}) {lab}: OR per 1 SD of SES within race'); print('='*100)
    ORb, MGb, CTb = bootstrap_model(k)
    for j,r in enumerate(RACES):
        v = race_slope_vec(cols, r); est = float(v@b); se = float(np.sqrt(v@cov@v))
        vF = est + 0  # firth point:
        bF = f['beta']; estF = float(v@bF)
        bci = np.nanpercentile(ORb[:,j],[2.5,97.5])
        print(f'  {r:9s} MLE OR={np.exp(est):.3f} delta95[{np.exp(est-1.96*se):.2f},{np.exp(est+1.96*se):.2f}] | Firth OR={np.exp(estF):.3f} | boot95(OR,MLE-reps,n={BA_REPS})[{bci[0]:.2f},{bci[1]:.2f}]')
    print('  Pairwise OR-ratio contrasts:')
    for (ra,rb,c) in [('White','Black',0),('White','Hispanic',1),('Black','Hispanic',2)]:
        vd = race_slope_vec(cols,ra)-race_slope_vec(cols,rb)
        est = vd@b; se = float(np.sqrt(vd@cov@vd)); p = 2*stats.norm.sf(abs(est/se))
        estF = vd@f['beta']
        bci = np.nanpercentile(CTb[:,c],[2.5,97.5])
        print(f'    {ra} vs {rb:9s} OR-ratio MLE={np.exp(est):.3f} delta95[{np.exp(est-1.96*se):.2f},{np.exp(est+1.96*se):.2f}] p={p:.4f} | Firth={np.exp(estF):.3f} | boot95[{bci[0]:.2f},{bci[1]:.2f}]')
    print('  Marginal scale — g-computation predicted P(BA) at within-race p10 -> p90 of SES:')
    for which in ['MLE','Firth']:
        mt = marg_table(k, which)
        print(f'    [{which:5s}] ' + ' | '.join(f'{r}: {mt[r][0]:.2f}%→{mt[r][1]:.2f}% (Δ={mt[r][2]:+.2f}pp)' for r in RACES))
    mm = np.nanpercentile(MGb,[2.5,97.5],axis=0)
    print(f'    [boot95 of dpp, MLE replicates n={BA_REPS}] ' + ', '.join(f'{RACES[j]}: [{mm[0,j]*100:.2f},{mm[1,j]*100:.2f}]' for j in range(3)))

# ---------- 4) mandatory linearity sensitivity: SES quartile dummies x race ----------
print(); print('='*100); print('4) LINEARITY SENSITIVITY: SES in quartiles (global qcut) x RACE - total scale'); print('='*100)
