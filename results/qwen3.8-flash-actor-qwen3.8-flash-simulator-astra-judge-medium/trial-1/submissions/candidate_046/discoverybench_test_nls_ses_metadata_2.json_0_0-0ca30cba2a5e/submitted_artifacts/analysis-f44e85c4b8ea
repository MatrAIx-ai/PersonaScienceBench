print(f'  non-nested comparison (info criteria): linear-int k={models["M1_total"][0].shape[1]} ll={models["M1_total"][3]["ll"]:.2f} AIC={-2*models["M1_total"][3]["ll"]+2*models["M1_total"][0].shape[1]:.1f} | quartile-int k={Xq1.shape[1]} ll={mq1["ll"]:.2f} AIC={-2*mq1["ll"]+2*Xq1.shape[1]:.1f}')

