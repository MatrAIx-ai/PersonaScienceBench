Q = ['q1','q2','q3']
def design_q(d, inter):
    cols = ['const']+BASE+Q
    Xc = [np.ones(len(d))]+[d[c].values for c in BASE+Q]
    if inter:
        for qc in Q:
            Xc += [(d[qc]*d.blk).values, (d[qc]*d.hsp).values]; cols += [f'{qc}xblk', f'{qc}xhsp']
    return np.column_stack(Xc), cols
Xq0, cq0 = design_q(df, False); Xq1, cq1 = design_q(df, True); yq = df['y'].values.astype(float)
mq0, fq0 = irls(Xq0,yq), irls(Xq0,yq,firth=True)
mq1, fq1 = irls(Xq1,yq), irls(Xq1,yq,firth=True)
sM = 2*(mq1['ll']-mq0['ll']); sF = 2*(fq1['ll']-fq0['ll'])
print(f'  Quartile-interaction (6 df): MLE LR chi2={sM:.3f} p={stats.chi2.sf(max(sM,0),6):.4f} | Firth(approx) chi2={sF:.3f} p={stats.chi2.sf(max(sF,0),6):.4f}')
bq = fq1['beta']
rowsp = {}
for r in RACES:
    msk = masks[r]; vals=[]
    for qq in [0,1,2,3]:
        Xr = Xq1[msk].copy()
        for j,c in enumerate(cq1):
            if c in Q: Xr[:,j] = 1.0*(qq==int(c[1]))
            if c.endswith('xblk'): Xr[:,j] = 1.0*(qq==int(c[1]))*Xq1[msk][:, cq1.index('blk')]
            if c.endswith('xhsp'): Xr[:,j] = 1.0*(qq==int(c[1]))*Xq1[msk][:, cq1.index('hsp')]
        p = 1/(1+np.exp(-np.clip(Xr@bq,-35,35))); vals.append(round(p.mean()*100,2))
    rowsp[r]=vals
print('  Firth-adjusted predicted P(BA)% by race x SES quartile:')
print(pd.DataFrame(rowsp, index=['Q1','Q2','Q3','Q4']).T.to_string())
# nested check: add quartile MAIN EFFECTS to M1_total (linear x race) -> 3 df
Xn = np.column_stack([models['M1_total'][0], df[['q1','q2','q3']].values])
mn = irls(Xn, yq); fn = irls(Xn, yq, firth=True)
