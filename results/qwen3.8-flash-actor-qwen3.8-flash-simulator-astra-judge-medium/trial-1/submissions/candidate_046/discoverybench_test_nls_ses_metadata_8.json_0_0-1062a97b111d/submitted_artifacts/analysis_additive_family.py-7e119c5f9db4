#!/usr/bin/env python3
"""Additive (pre-registered) family: which pair can produce -0.9568?
All subsets of {ses, ability, pct, famsize, female}, logit, full sample, ref=White.
NOTE: covariate rescaling cannot change race coefficients, so z-scoring is irrelevant here.
Also: interaction main effects and alternative links, reported separately.
"""
import itertools, numpy as np, pandas as pd, patsy, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings("ignore")
TARGET = -0.9568
raw = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
df = raw.rename(columns={"BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses",
  "ABILITY: COMPOSITE OF ASVAB SCORE":"ability","PERCENTILE IN CLASS":"pct",
  "SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize","CASE ID":"caseid"})
df["ba"]=df.ba.astype(bool).astype(int); df["female"]=(df.sex=="Female").astype(int)
R = "C(race, Treatment(reference='White'))"
COVS=["ses","ability","pct","famsize","female"]
rows=[]
for k in range(len(COVS)+1):
    for cv in itertools.combinations(COVS,k):
        rhs=R+(" + "+" + ".join(cv) if cv else "")
        X=patsy.dmatrix(rhs,df,return_type="dataframe")
        try: r=sm.Logit(df.ba,X).fit(disp=0,method="newton",maxiter=300)
        except Exception: continue
        lab=" + ".join(cv) if cv else "(intercept only)"
        for t in [t for t in r.params.index if "race" in t]:
            rows.append(dict(model=lab,pair=t.split("T.")[1].rstrip("]"),coef=r.params[t],
                             SE=r.bse[t],diff=abs(r.params[t]-TARGET)))
ad=pd.DataFrame(rows).sort_values("diff")
print("ADDITIVE FAMILY (full sample, logit, ref=White):",len(ad),"coefficients in",ad.model.nunique(),"models")
print("\nClosest ADDITIVE coefficients to",TARGET)
t=ad.head(8).copy()
for c in ["coef","SE","diff"]: t[c]=t[c].map(lambda v:f"{v:+.4f}")
print(t.to_string(index=False))
print("\nPer-pair, additive family:")
for pr,g in ad.groupby("pair"):
    i=g["diff"].idxmin()
    print(f"  {pr:16s} range [{g.coef.min():+.4f},{g.coef.max():+.4f}]  best {ad.loc[i,'coef']:+.4f} "
          f"(|d|={ad.loc[i,'diff']:.4f}) model=[{ad.loc[i,'model']}]  min|d| for pair={g['diff'].min():.4f}")
print("\nAdditive hits within tolerance:", {tol:int((ad['diff']<=tol).sum()) for tol in [0.002,0.01,0.02,0.05,0.1]})
ad.to_csv("analysis/additive_family.csv",index=False)

# --- interaction main effect (Black/Hispanic at mean of the interacted covariate) ---
print("\n"+"="*95)
print("Interaction models race x Covariate: MAIN EFFECT = contrast at covariate = 0 (raw covs: SES mean ~ -0.009 -> ~mean)")
for c in ["ses","ability","pct","famsize","female"]:
    X=patsy.dmatrix(f"{R} + {c} + {R}:{c}",df,return_type="dataframe")
    try: r=sm.Logit(df.ba,X).fit(disp=0,method="bfgs",maxiter=1000)
    except Exception as e: print(f"  race:{c} fit failed: {e}"); continue
    out=[]
    for t in [t for t in r.params.index if "race" in t and ":" not in t]:
        out.append(f"{t.split('T.')[1].rstrip(']')}={r.params[t]:+.4f}(SE {r.bse[t]:.3f}, |d|={abs(r.params[t]-TARGET):.4f})")
    print(f"  race:{c:<8s} "+" | ".join(out))

# --- alternative links on the two White contrasts ---
print("\n"+"="*95)
print("Alternative links (full sample, unadjusted): coefficient scale differs")
for linkname,fam in [("logit (log-odds)",sm.families.Binomial()),
                     ("log (log relative risk)",sm.families.Poisson()),
                     ("cloglog",sm.families.Binomial(sm.families.links.cloglog()))]:
    X=patsy.dmatrix(R,df,return_type="dataframe")
    r=sm.GLM(df.ba,X,family=fam).fit(maxiter=500)
    parts = []
    for t in r.params.index:
        if "race" in t:
            lvl = t.split("T.")[1].replace("]", "")
            parts.append(f"{lvl}={r.params[t]:+.4f} (|d|={abs(r.params[t]-TARGET):.4f})")
    print(f"  {linkname:26s} " + "  ".join(parts))
