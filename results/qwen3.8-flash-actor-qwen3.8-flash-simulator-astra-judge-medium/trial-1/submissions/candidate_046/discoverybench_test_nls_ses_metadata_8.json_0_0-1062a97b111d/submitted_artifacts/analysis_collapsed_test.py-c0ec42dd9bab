#!/usr/bin/env python3
"""Test the collapsed 'non-White vs White' contrast: -0.9568 sits almost exactly at
the midpoint of the two separate crude log-ORs (-1.0057, -0.9241 -> mean -0.9649),
which is where a POOLED non-White vs White coefficient must land."""
import numpy as np, pandas as pd, patsy, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings("ignore")
T=-0.9568
d=pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"]).rename(columns={
 "BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses","ABILITY: COMPOSITE OF ASVAB SCORE":"ability",
 "PERCENTILE IN CLASS":"pct","SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize","CASE ID":"caseid"})
d["ba"]=d.ba.astype(bool).astype(int)
d["nonwhite"]=(d.race!="White").astype(int)
d["female"]=(d.sex=="Female").astype(int)
print("collapsed group: non-White n=%d k=%d p=%.5f | White n=%d k=%d p=%.5f"%(
  d.nonwhite.sum(), d.loc[d.nonwhite==1,'ba'].sum(), d.loc[d.nonwhite==1,'ba'].mean(),
  (1-d.nonwhite).sum(), d.loc[d.nonwhite==0,'ba'].sum(), d.loc[d.nonwhite==0,'ba'].mean()))
print("midpoint of the two separate crude log-ORs = %.4f"%( (-1.00570-0.92414)/2 ))
for lab,covs in [("unadjusted",[]),("+ses",["ses"]),("+pct",["pct"]),("+ability",["ability"]),
                 ("+ses+pct",["ses","pct"]),("+ses+ability+pct",["ses","ability","pct"]),
                 ("+ses+pct+female",["ses","pct","female"])]:
    X=patsy.dmatrix("nonwhite"+(" + "+" + ".join(covs) if covs else ""),d,return_type="dataframe")
    r=sm.Logit(d.ba,X).fit(disp=0)
    c=r.params["nonwhite"]; se=r.bse["nonwhite"]
    print(f"  non-White vs White {lab:<19s} coef={c:+.4f} SE={se:.4f} z={c/se:+.2f} "
          f"OR={np.exp(c):.3f} IC95%(OR)=[{np.exp(c-1.96*se):.3f},{np.exp(c+1.96*se):.3f}] |d to {T}|={abs(c-T):.4f}")
# per-race collapsed-within subsets: Black-only vs White, Hispanic-only vs White already done.
# Wald test of equality of the two crude log-ORs (is a pooled coefficient justified?)
X=patsy.dmatrix("C(race, Treatment(reference='White'))",d,return_type="dataframe")
r=sm.Logit(d.ba,X).fit(disp=0)
w=r.t_test("C(race, Treatment(reference='White'))[T.Black] - C(race, Treatment(reference='White'))[T.Hispanic]")
eff=float(np.ravel(w.effect)[0]); sd=float(np.ravel(w.sd)[0]); zz=eff/sd
print("\nWald test Black-coef == Hispanic-coef (unadjusted): coef=%.4f SE=%.4f z=%.3f p=%.3f" % (eff, sd, zz, 2*stats.norm.sf(abs(zz))))
print("-> the two gaps are statistically indistinguishable, so a single pooled non-White factor is defensible;")
print("   the target lies INSIDE both 95%% CIs and inside the pooled CI.")
