#!/usr/bin/env python3
"""Decision analysis: which pair can LEGITIMATELY own the coefficient -0.9568?
(1) sign-robustness in the additive family (covariate SETS only, no arbitrary centering)
(2) chance rate of a +-0.005 'exact hit' per pair across the transform space
(3) L2 shrinkage test: a penalised logit can only move coefficients TOWARD 0,
    so a target between 0 and a crude coefficient is reachable, one beyond it is not.
"""
import itertools, numpy as np, pandas as pd, patsy, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings("ignore")
T=-0.9568
d=pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"]).rename(columns={
 "BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses","ABILITY: COMPOSITE OF ASVAB SCORE":"ability",
 "PERCENTILE IN CLASS":"pct","SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize","CASE ID":"caseid"})
d["ba"]=d.ba.astype(bool).astype(int); d["female"]=(d.sex=="Female").astype(int)
R="C(race, Treatment(reference='White'))"

# (1) sign / significance robustness over additive covariate subsets
COVS=["ses","ability","pct","famsize","female"]
rec=[]
for k in range(len(COVS)+1):
    for cv in itertools.combinations(COVS,k):
        rhs=R+(" + "+" + ".join(cv) if cv else "")
        X=patsy.dmatrix(rhs,d,return_type="dataframe")
        try: r=sm.Logit(d.ba,X).fit(disp=0,method="newton",maxiter=400)
        except Exception: continue
        for t in r.params.index:
            if "race" in t:
                lvl=t.split("T.")[1].replace("]","")
                z=r.params[t]/r.bse[t]
                rec.append(dict(pair=lvl,coef=r.params[t],z=z,neg=r.params[t]<0,
                                sig_neg=(r.params[t]<0 and abs(z)>1.96 and abs(z)==abs(z)),
                                p=2*stats.norm.sf(abs(z)),covs=",".join(cv) or "none",
                                diff=abs(r.params[t]-T)))
ad=pd.DataFrame(rec)
print("="*100); print("(1) ADDITIVE FAMILY robustness  (n models = %d)"%ad.covs.nunique())
for pr,g in ad.groupby("pair"):
    sig_neg=((g.coef<0)&(g.p<0.05)).mean(); sig_pos=((g.coef>0)&(g.p<0.05)).mean()
    print(f"  {pr:16s} n={len(g):3d} share coef<0: {(g.coef<0).mean():.2f}  share sig&negative: {sig_neg:.2f}  "
          f"share sig&POSITIVE: {sig_pos:.2f}  coef range [{g.coef.min():+.3f},{g.coef.max():+.3f}]")
    if pr!="Black vs Hispanic".split(" vs ")[0]: pass
print("  -> Black flips to POSITIVE (sometimes significantly) once ABILITY enters; check:")
for cv in ["none","ability","ses,ability","ability,pct","ses,ability,pct"]:
    g=ad[(ad.covs==cv)]
    print("     covs=%-18s "%cv+"  ".join(f"{row.pair}={row.coef:+.3f}(p={row.p:.3f})" for row in g.itertuples()))

# (2) chance rate of near-exact hits, from the transform scan already computed
tr=pd.read_csv("analysis/transform_scan.csv")
print("\n"+"="*100); print("(2) NEAR-EXACT HIT RATE in legitimate-transform space (1146 coefficients)")
for pr,g in tr.groupby("pair"):
    for tol in [0.005,0.02]:
        n=(g["diff"]<=tol).sum()
        print(f"  {pr:20s} |d|<={tol}: {n}/{len(g)} = {n/len(g):.4f}")
print("  best per pair:")
for pr,g in tr.groupby("pair"):
    i=g["diff"].idxmin(); print(f"    {pr:20s} {g.loc[i,'coef']:+.4f} |d|={g.loc[i,'diff']:.4f} covs=[{g.loc[i,'covs']}]")

# (3) L2 shrinkage test: does a penalised logit map a crude coef onto -0.9568?
print("\n"+"="*100); print("(3) L2-penalised logit (ridge). Shrinkage can only reduce |coef|.")
X=patsy.dmatrix(R,d,return_type="dataframe")
un=sm.Logit(d.ba,X).fit(disp=0)
print("  unpenalised: Black=%+.4f Hispanic=%+.4f"%(un.params[R+"[T.Black]"],un.params[R+"[T.Hispanic]"]))
for alpha in [0.05,0.1,0.25,0.5,1.0,2.0,5.0]:
    rr=sm.Logit(d.ba,X).fit_regularized(alpha=alpha,L1_wt=0.0,disp=0,maxiter=800)
    b=rr.params[R+"[T.Black]"]; h=rr.params[R+"[T.Hispanic]"]
    print(f"  alpha={alpha:<5} Black={b:+.4f} (|d|={abs(b-T):.4f})   Hispanic={h:+.4f} (|d|={abs(h-T):.4f})")
print("  NOTE: ridge shrinks BOTH toward 0. Target -0.9568 is *inside* |Black|=1.006 (reachable)")
print("        and *outside* |Hispanic|=0.924 (unreachable by shrinkage alone).")

# (4) how far is the target from each crude contrast, in SE units?
print("\n"+"="*100); print("(4) target inside whose 95% CI / how many SEs away (canonical unadjusted model)")
for lvl in ["Black","Hispanic"]:
    t=R+f"[T.{lvl}]"; c=un.params[t]; se=un.bse[t]
    print(f"  {lvl:9s} coef={c:+.4f} SE={se:.4f}  95%CI=[{c-1.96*se:+.4f},{c+1.96*se:+.4f}]  "
          f"target inside CI: {c-1.96*se<=T<=c+1.96*se}   |T-coef|/SE={abs(T-c)/se:.3f}")
