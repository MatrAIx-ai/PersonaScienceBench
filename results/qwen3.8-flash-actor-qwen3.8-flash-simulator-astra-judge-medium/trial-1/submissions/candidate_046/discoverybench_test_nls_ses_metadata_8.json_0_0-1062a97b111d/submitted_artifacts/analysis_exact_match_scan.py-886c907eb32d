#!/usr/bin/env python3
"""Exact-match scan (4 decimals) for -0.9568 in crude log-ORs and stratified fits.
Rationale: coefficient of a race dummy is INVARIANT to linear rescaling of other
covariates, so an exact 4-dp match can only come from a different row set,
covariate SET, interaction structure or link — not from standardization."""
import itertools, numpy as np, pandas as pd, patsy, statsmodels.api as sm
import warnings; warnings.filterwarnings("ignore")
T = -0.9568
raw = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
df = raw.rename(columns={"BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses",
  "ABILITY: COMPOSITE OF ASVAB SCORE":"ability","PERCENTILE IN CLASS":"pct",
  "SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize","CASE ID":"caseid"})
df["ba"]=df.ba.astype(bool).astype(int)

def crude_logor(sub,a,b):
    t=sub.groupby("race").ba.agg(n="size",k="sum"); t["p"]=t.k/t.n
    if a not in t.index or b not in t.index or t.loc[a,"k"]==0 or t.loc[b,"k"]==0: return np.nan,0,0
    pa,pb=t.loc[a,"p"],t.loc[b,"p"]
    return np.log((pa/(1-pa))/(pb/(1-pb))), int(t.loc[a,"n"]), int(t.loc[b,"n"])

print("=== CRUDE log-ORs in every natural stratum (target %.4f) ===" % T)
strata = {}
for sx in ["Female","Male"]: strata[f"sex={sx}"]=df[df.sex==sx]
for rc in ["Black","White","Hispanic"]: strata[f"race!={rc}"]=df[df.race!=rc]
med = {"ses>0":df[df.ses>0],"ses<0":df[df.ses<0],"pct>=50":df[df.pct>=50],"pct<50":df[df.pct<50],
       "ability>=med":df[df.ability>=df.ability.median()],"ability<med":df[df.ability<df.ability.median()],
       "famsize<=4":df[df.famsize<=4],"famsize>4":df[df.famsize>4]}
strata.update(med)
hits=[]
for name,sub in [("ALL",df)]+list(strata.items()):
    for a,b in [("Black","White"),("Hispanic","White"),("Black","Hispanic")]:
        lo,na,nb=crude_logor(sub,a,b)
        if np.isnan(lo): continue
        d=abs(lo-T); flag=" <=== |d|<0.005" if d<0.005 else ""
        print(f"  {name:14s} {a:>8s} vs {b:<9s} logOR={lo:+.4f} OR={np.exp(lo):.3f} (n {na}/{nb}) |d|={d:.4f}{flag}")
        hits.append((name,f"{a} vs {b}",lo,d))

print("\n=== Adjusted fits, all strata x all covariate subsets (logit, ref=White) ===")
COVS=["ses","ability","pct","famsize"]
best=[]; nfit=0
for name,sub in [("ALL",df)]+list(strata.items()):
    races=sorted(sub.race.unique())
    if len(races)<2: continue
    ref="White" if "White" in races else races[-1]
    R=f"C(race, Treatment(reference='{ref}'))"
    for k in range(len(COVS)+1):
        for cv in itertools.combinations(COVS,k):
            rhs=R+(" + "+" + ".join(cv) if cv else "")
            try:
                X=patsy.dmatrix(rhs,sub,return_type="dataframe")
                r=sm.Logit(sub.ba,X).fit(disp=0,method="newton",maxiter=400)
                if not r.mle_retvals["converged"]: raise RuntimeError
            except Exception: continue
            nfit+=1
            for t in r.params.index:
                if "race" in t:
                    lvl=t.split("T.")[1].replace("]","")
                    d=abs(r.params[t]-T)
                    best.append((d,name,f"{lvl} vs {ref}","["+( ",".join(cv) or "none")+"]",r.params[t],r.bse[t]))
best.sort()
print(f"fits completed: {nfit}; race coefficients scanned: {len(best)}")
print("\nTop 12 by absolute distance to %.4f:" % T)
for d,name,pair,m,coef,se in best[:12]:
    print(f"  |d|={d:.5f}  {pair:20s} coef={coef:+.5f} SE={se:.4f}  stratum={name:12s} covs={m}")
for tol in [0.00005,0.0005,0.005]:
    print(f"  exact-ish hits |d|<={tol}: {sum(1 for b in best if b[0]<=tol)}")
pd.DataFrame(best,columns=["abs_diff","stratum","pair","covs","coef","SE"]).to_csv("analysis/exact_match_scan.csv",index=False)
