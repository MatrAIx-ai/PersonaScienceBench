#!/usr/bin/env python3
"""Pre-declared tie-break: which pair wins ACROSS specification families?
Each family is scored by its minimum |coef - (-0.9568)| over Black vs White and
Hispanic vs White. Families are defined a priori (post-hoc strata reported separately
and given NO decision weight, because a coefficient in an arbitrary stratum is not a
reproducible estimate)."""
import pandas as pd
T=-0.9568
fams={
 "pre-registered battery (M1-M7)":            "analysis/race_contrasts_table.csv",
 "additive covariate subsets (32 models)":    "analysis/additive_family.csv",
 "legitimate transforms/polynomials (573)":   "analysis/transform_scan.csv",
 "two-race subsets (96 models)":              "analysis/tworace_scan.csv",
 "Firth penalised (rare outcome)":            "analysis/firth_results.csv",
}
print(f"MINIMUM |coef - ({T})| BY SPECIFICATION FAMILY\n")
wins={"Black":0,"Hispanic":0}
print(f"  {'family':<40s}{'Black vs White':>18s}{'Hispanic vs White':>20s}   winner")
for name,path in fams.items():
    df=pd.read_csv(path)
    pc="pair" if "pair" in df.columns else "pair"
    out={}
    for lvl in ["Black","Hispanic"]:
        g=df[df[pc].str.contains(lvl)]["diff" if "diff" in df.columns else "abs_diff_to_target"]
        out[lvl]=g.min()
    w=min(out,key=out.get); wins[w]+=1
    print(f"  {name:<40s}{out['Black']:>18.4f}{out['Hispanic']:>20.4f}   {w}")
print(f"\n  FAMILY WINS: Black vs White = {wins['Black']} , Hispanic vs White = {wins['Hispanic']}")
print("\n  NOT given decision weight (post-hoc, not reproducible estimates):")
ex=pd.read_csv("analysis/exact_match_scan.csv")
for lvl in ["Black vs White","Hispanic vs White"]:
    g=ex[ex.pair==lvl].nsmallest(1,"abs_diff")
    r=g.iloc[0]
    print(f"    {lvl:18s} best {r.coef:+.4f} (|d|={r.abs_diff:.4f}) in stratum={r.stratum} covs={r.covs}"
          f"   <- arbitrary stratum/subset")
print("\n  Sign robustness (pre-registered battery, 8 specs):")
b=pd.read_csv("analysis/race_contrasts_table.csv")
for lvl in ["Black vs White","Hispanic vs White"]:
    g=b[b.pair==lvl]
    print(f"    {lvl:18s} negative in {int((g.coef<0).sum())}/8 specs; "
          f"significantly POSITIVE in {int(((g.coef>0)&(g.p<0.05)).sum())}/8")
