#!/usr/bin/env python3
"""CONSOLIDATED ANSWER: which two races does the BA-completion factor -0.9568 belong to?
Reference FIXED to White with C(race, Treatment(reference='White')) (drop_first would pick
'Black' alphabetically and flip signs). Reports the pre-registered battery in full and
the discrimination between the two surviving pairs."""
import itertools, numpy as np, pandas as pd, patsy, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings("ignore")
T=-0.9568
d=pd.read_csv("data/nls_ses_processed.csv").rename(columns={
 "BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses","ABILITY: COMPOSITE OF ASVAB SCORE":"ability",
 "PERCENTILE IN CLASS":"pct","SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize"})
d["ba"]=d.ba.astype(bool).astype(int); d["female"]=(d.sex=="Female").astype(int); d["ses2"]=d.ses**2
R="C(race, Treatment(reference='White'))"
B,H=R+"[T.Black]",R+"[T.Hispanic]"
PAIRS=[("Black vs White",B),("Hispanic vs White",H),("Black vs Hispanic",f"{B} - {H}")]
SPECS={"M1 unadjusted":[], "M2 +SES":["ses"], "M3 +ABILITY":["ability"], "M4 +PERCENTILE":["pct"],
       "M5 +SES+ABILITY+PERCENTILE":["ses","ability","pct"],
       "M6a M5+SEX":["ses","ability","pct","sex"], "M6b M5+FAMILYSIZE":["ses","ability","pct","famsize"],
       "M7 M5+SEX+FAMILYSIZE":["ses","ability","pct","sex","famsize"]}
rows=[]
for lab,cv in SPECS.items():
    X=patsy.dmatrix(R+(" + "+" + ".join(cv) if cv else ""),d,return_type="dataframe")
    r=sm.Logit(d.ba,X).fit(disp=0,method="newton",maxiter=400)
    for pl,term in PAIRS:
        t=r.t_test(term); est=float(np.ravel(t.effect)[0]); se=float(np.ravel(t.sd)[0])
        z=est/se
        rows.append(dict(specification=lab,contrast=pl,reference_declared="White",coef=est,SE=se,z=z,
            p_value=2*stats.norm.sf(abs(z)),ci_lo=est-1.96*se,ci_hi=est+1.96*se,OR=np.exp(est),
            OR_ci_lo=np.exp(est-1.96*se),OR_ci_hi=np.exp(est+1.96*se),
            converged=bool(r.mle_retvals["converged"]),abs_diff_to__0_9568=abs(est-T)))
tab=pd.DataFrame(rows); tab.to_csv("analysis/FINAL_table.csv",index=False)
pd.set_option("display.width",250)
s=tab.copy()
for c in ["coef","SE","z","ci_lo","ci_hi","abs_diff_to__0_9568"]: s[c]=s[c].map(lambda v:f"{v:+.4f}")
for c in ["OR","OR_ci_lo","OR_ci_hi"]: s[c]=s[c].map(lambda v:f"{v:.3f}")
s["p_value"]=s.p_value.map(lambda v:f"{v:.3g}")
print("FULL TABLE - 3 contrasts x 8 pre-registered specs, reference = White (declared per row)")
print(s.to_string(index=False))
print("\nRanking by |coef - (-0.9568)| (pre-registered battery only):")
print(tab.sort_values("abs_diff_to__0_9568").head(4)[["specification","contrast","coef","abs_diff_to__0_9568"]].to_string(index=False))
print("\nWald equality of the two White contrasts (unadjusted): Black == Hispanic ?")
X=patsy.dmatrix(R,d,return_type="dataframe"); r=sm.Logit(d.ba,X).fit(disp=0)
w=r.t_test(f"{B} - {H}"); eff=float(np.ravel(w.effect)[0]); sd=float(np.ravel(w.sd)[0])
print(f"  difference={eff:+.4f} SE={sd:.4f} z={eff/sd:+.3f} p={2*stats.norm.sf(abs(eff/sd)):.3f}  -> the two gaps are indistinguishable")
print(f"\nTarget -0.9568 = e^(-0.9568) = {np.exp(T):.4f} odds ratio; crude ORs: Black/White=0.366, Hispanic/White=0.397")
for pl,c,se in [("Black vs White",-1.00570,0.20415),("Hispanic vs White",-0.92414,0.24266)]:
    print(f"  {pl:18s} |target-coef|/SE = {abs(T-c)/se:.3f}  (target inside 95%% CI: {c-1.96*se<=T<=c+1.96*se})")
