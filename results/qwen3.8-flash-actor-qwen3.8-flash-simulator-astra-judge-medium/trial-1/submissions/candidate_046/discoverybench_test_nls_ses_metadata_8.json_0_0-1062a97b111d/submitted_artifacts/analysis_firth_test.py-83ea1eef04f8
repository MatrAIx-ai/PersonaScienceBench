#!/usr/bin/env python3
"""Firth (1993) penalized-likelihood logistic regression: the standard remedy for the
RARE OUTCOME here (2.69%, only 19-28 events per non-White group) and quasi-separation,
which the researcher flagged as a risk. Firth changes the POINT ESTIMATE (it reduces
small-sample bias, shrinking toward 0), so it is one of the few legitimate choices able
to move a crude -1.0057 onto -0.9568.

Modified score for the canonical logit link (Firth 1993):
   U*_i = sum_j x_ji (y_j - p_j) + 0.5 sum_j h_j w_j (1 - 2 p_j) x_ji
   w_j = p_j(1-p_j),  h_j = x_j' (X'WX)^{-1} x_j
   Newton:  b <- b + (X'WX)^{-1} U*
Validation: for the saturated 3-race model Firth ~= MLE (bias is negligible with n=8773).
"""
import numpy as np, pandas as pd, patsy, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings("ignore")
T=-0.9568
d=pd.read_csv("data/nls_ses_processed.csv").rename(columns={
 "BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses","ABILITY: COMPOSITE OF ASVAB SCORE":"ability",
 "PERCENTILE IN CLASS":"pct","SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize"})
d["female"]=(d.sex=="Female").astype(int); d["ses2"]=d.ses**2
y=d.ba.astype(bool).astype(int).values.astype(float)
R="C(race, Treatment(reference='White'))"

def firth(X,y,maxit=300,tol=1e-11):
    X=np.asarray(X,float); b=np.zeros(X.shape[1])
    for it in range(maxit):
        p=1/(1+np.exp(-X@b)); w=np.clip(p*(1-p),1e-12,None)
        Ii=np.linalg.pinv(X.T@(X*w[:,None]))
        h=np.einsum('ij,jk,ik->i',X,Ii,X)*w
        U=X.T@(y-p)+0.5*(X.T@(h*w*(1-2*p)))
        step=Ii@U; b=b+step
        if np.max(np.abs(step))<tol: break
    p=1/(1+np.exp(-X@b)); w=np.clip(p*(1-p),1e-12,None)
    Ii=np.linalg.pinv(X.T@(X*w[:,None])); h=np.einsum('ij,jk,ik->i',X,Ii,X)*w
    A=np.linalg.pinv(X.T@(X*(w/(1-h)**2)[:,None]))
    V=A@(X.T@(X*(w*(1-h))[:,None]))@A
    return b,np.sqrt(np.abs(np.diag(V))),it

SETS={"none":[],"ses":["ses"],"pct":["pct"],"ability":["ability"],"female":["female"],
      "ses+pct":["ses","pct"],"ses+ability+pct":["ses","ability","pct"],"ses2":["ses2"],
      "pct+female":["pct","female"],"famsize":["famsize"]}
print("Firth penalized logit (ref=White).  TARGET = %.4f"%T)
print(f"  {'spec':<18s}{'Black':>10s}{'|d|':>8s}   {'Hispanic':>10s}{'|d|':>8s}    MLE in brackets")
rows=[]
for lab,cv in SETS.items():
    X=patsy.dmatrix(R+(" + "+" + ".join(cv) if cv else ""),d,return_type="dataframe")
    b,se,it=firth(X.values,y); names=list(X.columns)
    mle=sm.Logit(y,X).fit(disp=0); line=f"  {lab:<18s}"
    for lvl in ["Black","Hispanic"]:
        i=[j for j,n in enumerate(names) if f"[T.{lvl}]" in n][0]
        c=b[i]; rows.append(dict(spec=lab,pair=lvl,coef=c,SE=se[i],diff=abs(c-T),OR=float(np.exp(c)),
                                 mle=float(mle.params.iloc[i])))
        line+=f"{c:+10.4f}{abs(c-T):8.4f}   [{float(mle.params.iloc[i]):+.4f}]  "
    print(line)
f=pd.DataFrame(rows); f.to_csv("analysis/firth_results.csv",index=False)
print("\n  per-pair best Firth fit:")
for pr,g in f.groupby("pair"):
    i=g["diff"].idxmin()
    print(f"    {pr:9s} {f.loc[i,'coef']:+.4f} (|d|={f.loc[i,'diff']:.4f}) spec=[{f.loc[i,'spec']}]")
print("  hits: |d|<=0.005 ->",int((f['diff']<=0.005).sum()),"|d|<=0.02 ->",int((f['diff']<=0.02).sum()))
print("  Firth vs MLE max |difference| = %.5f -> the outcome is NOT separated; bias reduction is negligible,"%np.abs(f.coef-f.mle).max())
print("  so -0.9568 cannot be a Firth estimate of either crude contrast.")
