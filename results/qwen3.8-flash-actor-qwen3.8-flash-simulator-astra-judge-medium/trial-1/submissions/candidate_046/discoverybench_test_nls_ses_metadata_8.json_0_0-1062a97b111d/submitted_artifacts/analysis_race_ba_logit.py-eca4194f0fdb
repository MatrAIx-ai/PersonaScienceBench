#!/usr/bin/env python3
"""
Question: Between which two races is the factor of BA degree completion -0.9568?
Design: logit of BA DEGREE COMPLETED (1/0) on SAMPLE_RACE with the reference FIXED
as White via C(SAMPLE_RACE, Treatment(reference='White')) (NOT drop_first, which
would pick 'Black' alphabetically and flip signs), plus covariate-adjusted
specifications. Every specification reports all THREE pairwise contrasts with
coef/SE/z/p/CI95/OR so the sign never depends on coding convention.
"""
import numpy as np, pandas as pd, statsmodels.api as sm, patsy
from scipy import stats
import warnings; warnings.filterwarnings("ignore")

TARGET = -0.9568
TOL_STRICT, TOL_PRIMARY, TOL_ACCEPT = 0.002, 0.010, 0.050

raw = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
MAP = {"BA DEGREE COMPLETED": "ba", "SAMPLE_RACE": "race", "SES": "ses",
       "ABILITY: COMPOSITE OF ASVAB SCORE": "ability", "PERCENTILE IN CLASS": "pct",
       "SAMPLE_SEX": "sex", "FAMILY SIZE OF SAMPLE": "famsize", "CASE ID": "caseid"}
df = raw.rename(columns=MAP)
df["ba"] = df["ba"].astype(bool).astype(int)

print("=" * 108)
print(f"N={len(df)}  events BA=1: {df.ba.sum()} ({df.ba.mean():.4%})  NaN total: {int(df.isna().sum().sum())}  "
      f"race levels: {sorted(df.race.unique())}")

# ---- 1. crude / saturated sanity check -------------------------------------
tab = df.groupby("race").ba.agg(n="size", k="sum").assign(p=lambda d: d.k / d.n)
print("\n--- Crude rates (used as sanity check on recoding) ---")
print(tab.assign(pct=lambda d: (100 * d.p).round(3)))
crude = {}
for a, b in [("Black", "White"), ("Hispanic", "White"), ("Black", "Hispanic")]:
    pa, pb = tab.loc[a, "p"], tab.loc[b, "p"]
    lo = np.log((pa / (1 - pa)) / (pb / (1 - pb)))
    se = np.sqrt(1/tab.loc[a,"k"] + 1/(tab.loc[a,"n"]-tab.loc[a,"k"])
               + 1/tab.loc[b,"k"] + 1/(tab.loc[b,"n"]-tab.loc[b,"k"]))
    z = lo / se; p = 2 * stats.norm.sf(abs(z))
    crude[f"{a} vs {b}"] = (lo, se)
    print(f"  crude logOR {a:>8s} vs {b:<8s}: {lo:+.4f} SE={se:.4f} z={z:+.3f} p={p:.4g} "
          f"OR={np.exp(lo):.3f} IC95%(OR)=[{np.exp(lo-1.96*se):.3f},{np.exp(lo+1.96*se):.3f}] "
          f"|d to {TARGET}|={abs(lo-TARGET):.4f}")

# ---- 2. model battery ------------------------------------------------------
R = "C(race, Treatment(reference='White'))"
SPECS = {
    "M1 unadjusted":               R,
    "M2 +SES":                     f"{R} + ses",
    "M3 +ABILITY":                 f"{R} + ability",
    "M4 +PERCENTILE":              f"{R} + pct",
    "M5 +SES+ABILITY+PERCENTILE":  f"{R} + ses + ability + pct",
    "M6a M5+SEX":                  f"{R} + ses + ability + pct + sex",
    "M6b M5+FAMILY_SIZE":          f"{R} + ses + ability + pct + famsize",
    "M7 M5+SEX+FAMILY_SIZE":       f"{R} + ses + ability + pct + sex + famsize",
}
B, H = f"{R}[T.Black]", f"{R}[T.Hispanic]"
PAIRS = [("Black vs White", B), ("Hispanic vs White", H), ("Black vs Hispanic", f"{B} - {H}")]

def fit(rhs):
    f = sm.Logit(df.ba, patsy.dmatrix(rhs, df, return_type="dataframe"), missing="drop")
    try:
        r = f.fit(disp=0, method="newton", maxiter=200)
        if not r.mle_retvals["converged"]:
            raise RuntimeError("newton not converged")
    except Exception as e:
        try:
            r = f.fit(disp=0, method="bfgs", maxiter=1000, gtol=1e-5)
            print(f"  [!] fallback bfgs used ({type(e).__name__}: {e})")
        except Exception as e2:
            print(f"  [!!] fit failed: {e2}"); raise
    return r

rows, models = [], {}
for name, rhs in SPECS.items():
    r = fit(rhs); models[name] = r
    conv = bool(r.mle_retvals["converged"])
    for plabel, term in PAIRS:
        t = r.t_test(term)
        est = float(np.ravel(t.effect)[0]); se = float(np.ravel(t.sd)[0])
        zz = est / se; pp = 2 * stats.norm.sf(abs(zz))
        lo_, hi_ = est + np.array([-1.96, 1.96]) * se
        rows.append(dict(spec=name, pair=plabel, ref_declared="White", coef=est, SE=se, z=zz, p=pp,
                         ci_lo=lo_, ci_hi=hi_, OR=np.exp(est), OR_lo=np.exp(lo_), OR_hi=np.exp(hi_),
                         abs_diff_to_target=abs(est - TARGET), converged=conv,
                         n=r.nobs, maxSE=r.bse.abs().max(), pseudoR2=r.prsquared))
res = pd.DataFrame(rows)
res.to_csv("analysis/race_contrasts_table.csv", index=False)

def show(d, cols=None):
    d = d.copy()
    for c in ["coef","SE","z","ci_lo","ci_hi","abs_diff_to_target"]: c in d and d[c].map(lambda v: f"{v:+.4f}")
    disp = d.copy()
    for c in ["coef","SE","z","ci_lo","ci_hi","abs_diff_to_target"]:
        if c in disp: disp[c] = disp[c].map(lambda v: f"{v:+.4f}")
    for c in ["p"]:
        if c in disp: disp[c] = disp[c].map(lambda v: f"{v:.4g}")
    for c in ["OR","OR_lo","OR_hi","pseudoR2","maxSE"]:
        if c in disp: disp[c] = disp[c].map(lambda v: f"{v:.4f}")
    print(disp[cols or disp.columns.tolist()].to_string(index=False))

print("\n" + "=" * 108)
print("FULL TABLE - all 3 race contrasts x 8 specifications (reference declared per row = White)")
show(res[["spec","pair","ref_declared","coef","SE","z","p","ci_lo","ci_hi","OR","OR_lo","OR_hi","abs_diff_to_target"]])

# ---- 3. matching against -0.9568 ------------------------------------------
print("\n" + "=" * 108)
print(f"TARGET {TARGET} - ranked matches (race coefficients/contrasts only)")
m = res.sort_values("abs_diff_to_target")
show(m[["spec","pair","coef","SE","z","p","OR","abs_diff_to_target"]].head(12))
for lab, tol in [("STRICT <=0.002", TOL_STRICT), ("PRIMARY <=0.010", TOL_PRIMARY), ("ACCEPT <=0.050", TOL_ACCEPT)]:
    d = m[m.abs_diff_to_target <= tol]
    print(f"\n{lab}: {len(d)} hit(s)")
    if len(d): show(d[["spec","pair","coef","abs_diff_to_target"]])

# ---- 4. robustness ---------------------------------------------------------
print("\n" + "=" * 108)
print("ROBUSTNESS across all 8 specifications")
for plabel, _ in PAIRS:
    s = res[res.pair == plabel]
    same = bool((np.sign(s.coef) == np.sign(s.coef.iloc[0])).all())
    i = s.abs_diff_to_target.idxmin()
    print(f"  {plabel:19s} coef range [{s.coef.min():+.4f},{s.coef.max():+.4f}] same-sign-everywhere={same} "
          f"all p<.05={(s.p<.05).all()} max p={s.p.max():.3g} min|z|={s.z.abs().min():.2f}")
    print(f"      closest spec: {res.loc[i,'spec']} = {res.loc[i,'coef']:+.4f} (|d|={res.loc[i,'abs_diff_to_target']:.4f})")

# ---- 5. diagnostics --------------------------------------------------------
print("\n" + "=" * 108)
print("DIAGNOSTICS (convergence / weak identification; min events per race = %d)" % tab.k.min())
for name, r in models.items():
    print(f"  {name:30s} converged={str(bool(r.mle_retvals['converged'])):>5s} max|SE|={r.bse.abs().max():7.3f} "
          f"pseudoR2={r.prsquared:.4f} n={int(r.nobs)}")
print("  NOTE: Black vs Hispanic rests on 28 vs 19 events -> extremely wide CIs, not a candidate.")

# ---- 6. coding control -----------------------------------------------------
print("\n" + "=" * 108)
print("CODING CONTROL (same contrasts must reappear under other references)")
for ref in ["White", "Hispanic", "Black"]:
    r = fit(f"C(race, Treatment(reference='{ref}'))")
    print(f"  ref={ref:9s} " + "  ".join(f"{k.split('T.')[1]}={v:+.4f}" for k, v in r.params.items() if "race" in k))

# ---- 7. crude-vs-saturated sanity check ------------------------------------
print("\n" + "=" * 108)
print("SANITY CHECK M1 (saturated: must reproduce crude log-ORs)")
m1 = models["M1 unadjusted"]
for k, lab in [(f"{R}[T.Black]", "Black vs White"), (f"{R}[T.Hispanic]", "Hispanic vs White")]:
    print(f"  {lab:18s} M1 coef={m1.params[k]:+.4f} vs crude={crude[lab][0]:+.4f} "
          f"diff={abs(m1.params[k]-crude[lab][0]):.2e}")

best = m.iloc[0]
print("\n" + "=" * 108)
print(f"BEST MATCH -> spec='{best.spec}' pair='{best.pair}' coef={best.coef:+.4f} "
      f"|diff to target|={best.abs_diff_to_target:.4f} OR={best.OR:.3f} p={best.p:.4g}")
