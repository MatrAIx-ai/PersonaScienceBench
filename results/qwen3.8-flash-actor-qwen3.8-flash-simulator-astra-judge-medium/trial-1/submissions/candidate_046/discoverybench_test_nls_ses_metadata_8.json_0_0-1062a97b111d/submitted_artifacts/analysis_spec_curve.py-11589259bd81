#!/usr/bin/env python3
"""Specification-curve search: can ANY plausible race coefficient equal -0.9568?

Grid: subsamples {ALL, FEMALE, MALE, BLACK+WHITE, HISP+WHITE, BLACK+HISP}
  x all subsets of covariates {ses, ability, pct, sex, famsize} (raw and z-scored)
  x race x {sex, ses, ability, pct} interaction models
  x link functions {logit, log (log-RR), cloglog}
  x penalised logistic (sklearn L2, C in {1, 10}) on standardized design
Reference is FIXED to White whenever White is present (never alphabetical drop_first).
"""
import itertools, numpy as np, pandas as pd, patsy, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings("ignore")

TARGET = -0.9568
raw = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
df = raw.rename(columns={"BA DEGREE COMPLETED": "ba", "SAMPLE_RACE": "race", "SES": "ses",
    "ABILITY: COMPOSITE OF ASVAB SCORE": "ability", "PERCENTILE IN CLASS": "pct",
    "SAMPLE_SEX": "sex", "FAMILY SIZE OF SAMPLE": "famsize", "CASE ID": "caseid"})
df["ba"] = df.ba.astype(bool).astype(int)
df["female"] = (df.sex == "Female").astype(int)
for c in ["ses", "ability", "pct", "famsize"]:
    df["z_" + c] = (df[c] - df[c].mean()) / df[c].std()
df["z_pct_log"] = np.log(df.pct.clip(lower=1)); df["z_pct_log"] -= df.z_pct_log.mean()
COVS = ["ses", "ability", "pct", "famsize"]
rows = []

def rec(spec, pair, est, se, n, link):
    rows.append(dict(spec=spec, pair=pair, coef=float(est), SE=float(se),
                     z=float(est / se) if se else np.nan,
                     p=float(2 * stats.norm.sf(abs(est / se))) if se else np.nan,
                     OR=float(np.exp(est)), diff=abs(float(est) - TARGET), n=n, link=link))

def ref_of(sub):
    rc = sorted(sub.race.unique())
    return "White" if "White" in rc else rc[-1]

def run_set(sub, tag):
    ref = ref_of(sub); R = f"C(race, Treatment(reference='{ref}'))"
    for k in range(len(COVS) + 1):
        for covs in itertools.combinations(COVS, k):
            for sc in [False, True]:
                cv = [("z_" + c) if sc else c for c in covs]
                rhs = R + (" + " + " + ".join(cv) if cv else "")
                X = patsy.dmatrix(rhs, sub, return_type="dataframe")
                try:
                    r = sm.Logit(sub.ba, X).fit(disp=0, method="newton", maxiter=300)
                    if not r.mle_retvals["converged"]:
                        r = sm.Logit(sub.ba, X).fit(disp=0, method="bfgs", maxiter=2000, gtol=1e-6)
                except Exception:
                    continue
                name = f"{tag} | {linkname('logit')} | {','.join(cv) or 'none'}{'+z' if sc else ''}"
                ts = [t for t in r.params.index if "race" in t]
                for t in ts:
                    rec(name, t.split("T.")[1].rstrip("]") + f" vs {ref}", r.params[t], r.bse[t], len(sub), "logit")
                if len(ts) == 2:
                    a = [t for t in ts if "Black" in t][0]; b = [t for t in ts if "Hispanic" in t][0]
                    tt = r.t_test(f"{a} - {b}")
                    rec(name, "Black vs Hispanic", np.ravel(tt.effect)[0], np.ravel(tt.sd)[0], len(sub), "logit")
    # interactions race x covariate
    for c in ["female", "ses", "ability", "pct"]:
        for sc in [False, True]:
            cc = ("z_" + c) if (sc and c in COVS) else c
            rhs = f"{R} + {cc} + C(race, Treatment(reference='{ref}')):{cc}"
            try:
                X = patsy.dmatrix(rhs, sub, return_type="dataframe")
                r = sm.Logit(sub.ba, X).fit(disp=0, method="bfgs", maxiter=1000)
            except Exception:
                continue
            for t in [t for t in r.params.index if "race" in t and ":" not in t]:
                rec(f"{tag} | race:{cc} interaction", t.split("T.")[1].rstrip("]") + f" vs {ref}",
                    r.params[t], r.bse[t], len(sub), "logit")
    # alternative links (unadjusted + adjusted), coefficients = log-RR / cloglog
    for link in ["log", "cloglog"]:
        for cv in [[], ["ses"], ["pct"], ["ability"], ["ses", "pct"]]:
            X = patsy.dmatrix(R + (" + " + " + ".join(cv) if cv else ""), sub, return_type="dataframe")
            try:
                fam = {"log": sm.families.Poisson(), "cloglog": sm.families.Binomial(sm.families.links.cloglog())}[link]
                r = sm.GLM(sub.ba, X, family=fam).fit(maxiter=500)
            except Exception:
                continue
            for t in [t for t in r.params.index if "race" in t]:
                rec(f"{tag} | link={link} | {','.join(cv) or 'none'}",
                    t.split("T.")[1].rstrip("]") + f" vs {ref}", r.params[t], r.bse[t], len(sub), link)
    # L2-penalised logit (statsmodels fit_regularized) on standardized design
    for alpha in [0.5, 2.0, 10.0]:
        rhs = R + " + z_ses + z_ability + z_pct"
        X = patsy.dmatrix(rhs, sub, return_type="dataframe")
        try:
            rr = sm.Logit(sub.ba, X).fit_regularized(alpha=alpha, L1_wt=0.0, disp=0, maxiter=500)
        except Exception:
            continue
        for t2 in [t2 for t2 in rr.params.index if "race" in t2]:
            rec(f"{tag} | L2-penalised alpha={alpha}",
                t2.split("T.")[1].rstrip("]") + f" vs {ref}", rr.params[t2], np.nan, len(sub), "logit-L2")

def linkname(l): return l
for tag, sub in {"ALL": df, "FEMALE": df[df.sex == "Female"], "MALE": df[df.sex == "Male"],
                 "BLACK+WHITE": df[df.race.isin(["Black", "White"])],
                 "HISP+WHITE": df[df.race.isin(["Hispanic", "White"])],
                 "BLACK+HISP": df[df.race.isin(["Black", "Hispanic"])]}.items():
    run_set(sub, tag)

res = pd.DataFrame(rows).drop_duplicates(subset=["spec", "pair"]).sort_values("diff").reset_index(drop=True)
res.to_csv("analysis/spec_curve.csv", index=False)
print(f"specifications fitted: {res.spec.nunique()}   race coefficients scanned: {len(res)}")
print(f"\nTARGET = {TARGET}: 18 closest race coefficients out of {len(res)}")
t = res.head(18).copy()
for c in ["coef", "SE", "z", "diff"]: t[c] = t[c].map(lambda v: f"{v:+.4f}")
t["p"] = t.p.map(lambda v: f"{v:.3g}")
print(t[["spec", "pair", "coef", "SE", "z", "p", "OR", "diff", "n"]].to_string(index=False))
print()
for tol in [0.0005, 0.002, 0.010, 0.020, 0.050, 0.10]:
    print(f"  hits |coef-({TARGET})| <= {tol:<6}: {(res['diff'] <= tol).sum()}")
print("\nPer-pair summary over the whole specification curve:")
for pr, g in res.groupby("pair"):
    i = g["diff"].idxmin()
    print(f"  {pr:24s} n={len(g):4d} coef range [{g.coef.min():+.4f},{g.coef.max():+.4f}] "
          f"share<0={(g.coef<0).mean():.2f} share p<.05={(g.p<.05).mean():.2f} "
          f"| best {res.loc[i,'coef']:+.4f} (|d|={res.loc[i,'diff']:.4f}) in [{res.loc[i,'spec']}]")
