#!/usr/bin/env python3
"""Scan legitimate specification space where the race coefficient genuinely moves:
covariate transformations / binning / polynomials (NO race interactions, because a
race-interaction MAIN EFFECT depends on arbitrary centering and can manufacture any
value -> not evidence). Exact 4-dp match would be decisive."""
import itertools, numpy as np, pandas as pd, patsy, statsmodels.api as sm
import warnings; warnings.filterwarnings("ignore")
T=-0.9568
raw=pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
d=raw.rename(columns={"BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses",
  "ABILITY: COMPOSITE OF ASVAB SCORE":"ability","PERCENTILE IN CLASS":"pct",
  "SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize","CASE ID":"caseid"})
d["ba"]=d.ba.astype(bool).astype(int)
d["female"]=(d.sex=="Female").astype(int)
d["ab_z"]=(d.ability-d.ability.mean())/d.ability.std()
d["ab10"]=d.ability/10; d["ab100"]=d.ability/100
d["pct100"]=d.pct/100; d["log_pct"]=np.log(d.pct.clip(lower=1))
d["pct50"]=(d.pct>=50).astype(int)
d["ab_q"]=pd.qcut(d.ability,4,labels=["Q1","Q2","Q3","Q4"]).astype(str)
d["ses2"]=d.ses**2; d["pct2"]=d.pct**2; d["ab2"]=d.ab_z**2
d["fam_b"]=pd.cut(d.famsize,[0,3,4,5,20],labels=["lt4","4","5","gt5"]).astype(str)
terms=["ses","ses2","pct","pct2","pct100","log_pct","pct50","ab_z","ab2","ab10","ab100",
       "C(ab_q)","female","C(fam_b)","famsize"]
R="C(race, Treatment(reference='White'))"
rows=[]
for k in range(0,4):
    for cv in itertools.combinations(terms,k):
        rhs=R+(" + "+" + ".join(cv) if cv else "")
        try:
            X=patsy.dmatrix(rhs,d,return_type="dataframe")
            r=sm.Logit(d.ba,X).fit(disp=0,method="newton",maxiter=500)
            if not r.mle_retvals["converged"]:
                r=sm.Logit(d.ba,X).fit(disp=0,method="bfgs",maxiter=2000,gtol=1e-7)
                if not r.mle_retvals["converged"]: continue
        except Exception: continue
        for t in r.params.index:
            if "race" in t:
                lvl=t.split("T.")[1].replace("]","")
                rows.append(dict(covs=" + ".join(cv) or "(none)",pair=lvl+" vs White",
                                 coef=float(r.params[t]),SE=float(r.bse[t]),
                                 diff=abs(float(r.params[t])-T),maxSE=float(r.bse.abs().max())))
res=pd.DataFrame(rows).drop_duplicates(subset=["covs","pair"]).sort_values("diff")
res.to_csv("analysis/transform_scan.csv",index=False)
print(f"models fitted: {res.covs.nunique()}   race coefficients scanned: {len(res)}")
t=res.head(14).copy()
for c in ["coef","SE","diff"]: t[c]=t[c].map(lambda v:f"{v:+.5f}")
print(t[["covs","pair","coef","SE","diff","maxSE"]].to_string(index=False))
print()
for tol in [0.00005,0.0005,0.005,0.02]:
    n=(res["diff"]<=tol).sum(); print(f"  |d|<={tol}: {n}  pairs: {sorted(res.loc[res['diff']<=tol,'pair'].unique())}")
print("\nPer-pair closest in this legitimate-transform space:")
for pr,g in res.groupby("pair"):
    i=g["diff"].idxmin()
    print(f"  {pr:20s} best {res.loc[i,'coef']:+.4f} |d|={res.loc[i,'diff']:.4f} covs=[{res.loc[i,'covs']}]")
