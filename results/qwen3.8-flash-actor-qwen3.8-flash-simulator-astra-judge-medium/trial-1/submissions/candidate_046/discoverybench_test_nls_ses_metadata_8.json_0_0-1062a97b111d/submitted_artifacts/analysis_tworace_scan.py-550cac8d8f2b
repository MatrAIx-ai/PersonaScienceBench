#!/usr/bin/env python3
"""Two-race subsets (question says 'compared to the OTHER' -> singular).
Dropping the third race changes the retained races' coefficients when covariates
are present, so this is a genuinely different specification space."""
import itertools, numpy as np, pandas as pd, patsy, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings("ignore")
T=-0.9568
d=pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"]).rename(columns={
 "BA DEGREE COMPLETED":"ba","SAMPLE_RACE":"race","SES":"ses","ABILITY: COMPOSITE OF ASVAB SCORE":"ability",
 "PERCENTILE IN CLASS":"pct","SAMPLE_SEX":"sex","FAMILY SIZE OF SAMPLE":"famsize","CASE ID":"caseid"})
d["ba"]=d.ba.astype(bool).astype(int); d["female"]=(d.sex=="Female").astype(int)
COVS=["ses","ability","pct","famsize","female"]
rows=[]
for pair in [("Black","White"),("Hispanic","White"),("Black","Hispanic")]:
    sub=d[d.race.isin(pair)].copy(); ref="White" if "White" in pair else pair[1]
    R=f"C(race, Treatment(reference='{ref}'))"
    for k in range(len(COVS)+1):
        for cv in itertools.combinations(COVS,k):
            rhs=R+(" + "+" + ".join(cv) if cv else "")
            try:
                X=patsy.dmatrix(rhs,sub,return_type="dataframe")
                r=sm.Logit(sub.ba,X).fit(disp=0,method="newton",maxiter=400)
                if not r.mle_retvals["converged"]: raise RuntimeError
            except Exception: continue
            for t in r.params.index:
                if "race" in t:
                    lvl=t.split("T.")[1].replace("]","")
                    z=r.params[t]/r.bse[t]
                    rows.append(dict(pair=f"{lvl} vs {ref}",covs=",".join(cv) or "none",n=len(sub),
                                     coef=float(r.params[t]),SE=float(r.bse[t]),z=z,
                                     p=2*stats.norm.sf(abs(z)),diff=abs(float(r.params[t])-T)))
res=pd.DataFrame(rows).sort_values("diff")
res.to_csv("analysis/tworace_scan.csv",index=False)
print(f"two-race models fitted: {len(res)}")
print("\nAll BLACK vs WHITE coefficients (sorted by distance to %.4f):"%T)
b=res[res.pair=="Black vs White"].sort_values("diff").head(6)
for r_ in b.itertuples(): print(f"  covs={r_.covs:<28s} coef={r_.coef:+.4f} SE={r_.SE:.4f} |d|={r_.diff:.4f}")
print("\nAll HISPANIC vs WHITE coefficients (sorted by distance):")
h=res[res.pair=="Hispanic vs White"].sort_values("diff").head(6)
for r_ in h.itertuples(): print(f"  covs={r_.covs:<28s} coef={r_.coef:+.4f} SE={r_.SE:.4f} |d|={r_.diff:.4f}")
print("\nBLACK vs HISPANIC best:")
bh=res[res.pair=="Black vs Hispanic"].sort_values("diff").head(3)
for r_ in bh.itertuples(): print(f"  covs={r_.covs:<28s} coef={r_.coef:+.4f} |d|={r_.diff:.4f}")
print("\nExact/near-exact hits overall:", {tol:int((res['diff']<=tol).sum()) for tol in [0.0005,0.005,0.01,0.02]})
