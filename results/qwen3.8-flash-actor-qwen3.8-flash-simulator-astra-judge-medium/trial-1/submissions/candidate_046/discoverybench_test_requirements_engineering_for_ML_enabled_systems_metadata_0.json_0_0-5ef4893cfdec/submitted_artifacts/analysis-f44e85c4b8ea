"""
Roles associated with requirements in ML-enabled systems (Q8 block).
Main metric (Option A): p_r = share of respondents who answered `quoted` in
Q8_ML_Addressing_<role>, denominator = respondents who answered the Q8 block.
Bootstrap: respondent-level resampling with replacement, B=10000, seed=42, percentile CI 2.5/97.5.
"""
import json, re
import numpy as np
import pandas as pd

DATA = "data/requirements_engineering_for_ML-enabled_systems.csv"
B, SEED = 10_000, 42

CANON = {  # ranking label -> Q8 column
    "Project Lead / Project Manager": "Q8_ML_Addressing_Project_Lead",
    "Business Analyst":               "Q8_ML_Addressing_Business_Analyst",
    "Requirements Engineer":          "Q8_ML_Addressing_Requirement_Engineer",
    "Solution Architect":             "Q8_ML_Addressing_Solution_Architect",
    "Data Scientist":                 "Q8_ML_Addressing_Data_Scientist",
    "Developer":                      "Q8_ML_Addressing_Developer",
    "Tester":                         "Q8_ML_Addressing_Tester",
}
Q8_ALL = list(CANON.values()) + ["Q8_ML_Addressing_Others"]
LOG = {}

df = pd.read_csv(DATA, dtype=str)
LOG["rows"] = len(df); LOG["columns"] = df.shape[1]

# ---------- (e) cleaning: sentinel -> NA, with per-rule exclusion counts ----------
CAT_LABEL_CODED = ["D4_Role", "D11_Agile_Development", "D12_ML_Project_Context_Others"] + \
                  [c for c in df.columns if c.startswith("Q1_ML_Life_Cycle_Importance_")] + \
                  [c for c in df.columns if c.startswith("Q2_ML_Life_Cycle_Difficulty_")] + \
                  [c for c in df.columns if c.startswith("Q6_") or c.startswith("Q7_")]
NUM_COLS = ["D5_Software_Experience", "D6_ML_Experience", "D7_Total_ML_Projects",
            "D8_ML_Production", "D9_ML_ML_Project_Team_Size", "D9_ML_Project_Team_Size"] + \
           [c for c in df.columns if c.startswith("Q3_")]

excl = {}
for c in df.columns:
    s = df[c]
    m_neg = s.isin(["-77", "-66", "-99"])
    excl[c] = {"neg_sentinel_NA": int(m_neg.sum())}
    df.loc[m_neg, c] = pd.NA
# "0" as NA only in label-coded categoricals (keep genuine 0 in numeric D5-D8 / Q3)
zero_as_na = 0
for c in CAT_LABEL_CODED:
    if c in df.columns:
        m = df[c].astype(str).str.strip().eq("0")
        zero_as_na += int(m.sum()); df.loc[m, c] = pd.NA
excl["_TOTAL"] = {
    "neg_sentinel_cells_NA": int(sum(v["neg_sentinel_NA"] for k, v in excl.items() if k != "_TOTAL")),
    "zero_labelcoded_cells_NA": int(zero_as_na),
    "dont_know_cells_in_Q1_Q2": int(df[[c for c in df.columns
        if c.startswith(("Q1_ML_Life_Cycle", "Q2_ML_Life_Cycle"))]].eq("I don't know").sum().sum()),
}
LOG["cleaning_exclusions"] = excl["_TOTAL"]
LOG["status_counts"] = df["Status"].value_counts(dropna=False).to_dict()

q8_raw = pd.read_csv(DATA, dtype=str)[Q8_ALL]           # pristine copy for mask logic
answered_block = q8_raw.notna().all(axis=1) & ~q8_raw.isin(["-77", "-66", "-99"]).any(axis=1)
LOG["q8_block"] = {"answered": int(answered_block.sum()),
                   "not_answered": int((~answered_block).sum()),
                   "not_answered_by_status": df.loc[~answered_block, "Status"].value_counts(dropna=False).to_dict(),
                   "per_item_valid": {c: int((~q8_raw[c].isin(["-77", "-66", "-99"]) & q8_raw[c].notna()).sum()) for c in Q8_ALL},
                   "dont_know_in_q8": int(q8_raw.isin(["I don't know", "I dont know"]).sum().sum())}

Q = (df[Q8_ALL] == "quoted").astype(int)                 # NA rows excluded per item
Q_valid = Q[answered_block.values]                        # main analysis frame (N=194)

def boot_p_ci(frame, cols, B=B, seed=SEED):
    """percentile bootstrap CI, resampling respondents; returns DataFrame + replicate matrix"""
    rng = np.random.default_rng(seed)
    n = len(frame); vals = frame[cols].to_numpy()
    idx = rng.integers(0, n, size=(B, n))
    reps = vals[idx].mean(axis=1) * 100                  # (B, k)
    return reps

def summarize(frame, cols, labels):
    reps = boot_p_ci(frame, cols)
    out = []
    for j, lab in enumerate(labels):
        p = 100 * frame[cols[j]].mean()
        lo, hi = np.percentile(reps[:, j], [2.5, 97.5])
        out.append({"role": lab, "n_denominator": len(frame), "n_quoted": int(frame[cols[j]].sum()),
                    "pct": round(p, 3), "ci_low": round(lo, 3), "ci_high": round(hi, 3)})
    return pd.DataFrame(out).sort_values("pct", ascending=False).reset_index(drop=True)

# ---------- (a)+(b) MAIN ----------
main_labels, main_cols = list(CANON.keys()), list(CANON.values())
Qm = Q_valid[main_cols]
main_tbl = summarize(Qm, main_cols, main_labels)

# paired contrast PL vs DS (same respondents)
rng = np.random.default_rng(SEED)
n = len(Qm); idx = rng.integers(0, n, size=(B, n))
pl = Qm[CANON["Project Lead / Project Manager"]].to_numpy()
ds = Qm[CANON["Data Scientist"]].to_numpy()
diff = (pl[idx] - ds[idx]).mean(axis=1) * 100
paired = {"label": "Project Lead minus Data Scientist (pp)",
          "point_pct": round(100 * (pl.mean() - ds.mean()), 3),
          "ci_low": round(float(np.percentile(diff, 2.5)), 3),
          "ci_high": round(float(np.percentile(diff, 97.5)), 3),
          "bootstrap_prob_PL_gt_DS": round(float((diff > 0).mean()), 4),
          "bootstrap_two_sided_p_of_tie_or_reverse": round(float(2 * min((diff > 0).mean(), (diff < 0).mean())), 4)}

# ---------- (c) SENSITIVITY ----------
sens = {}

# S1: completed-only (Status filtered)
mask_comp = answered_block.values & df["Status"].str.startswith("Completed", na=False).values
S1 = summarize(Q_valid.loc[mask_comp[answered_block.values], main_cols], main_cols, main_labels)
sens["S1_completed_only"] = {"N": int(mask_comp.sum()), "table": S1}

# S2: pessimistic denominator N=276 (-77 -> not quoted)
Qp = (pd.read_csv(DATA, dtype=str)[Q8_ALL] == "quoted").astype(int)   # -77/-99 treated as 0 = not quoted
S2 = summarize(Qp[main_cols], main_cols, main_labels)
sens["S2_pessimistic_N276"] = {"N": len(Qp), "table": S2}

# S3: hybrid C = quoted OR self-reported that role (D4_Role_Others regex-mapped)
SELF = {"Project Lead / Project Manager": "Project Lead / Project Manager",
        "Business Analyst": "Business Analyst", "Requirements Engineer": "Requirements Engineer",
        "Solution Architect": "Solution Architect", "Data Scientist": "Data Scientist",
        "Developer": "Developer", "Tester": "Test Manager / Tester"}
RULES = [("Data Scientist", r"data scientist|data science|machine learning engineer|ml engineer|computer vision|data analyst|data engineer|research scientist|reserach scientist"),
         ("Developer", r"developer|software engineer"),
         ("Project Lead / Project Manager", r"director|lead|manager|ceo|cto|founder|coordinator"),
         ("Requirements Engineer", r"requirement|business analyst"),
         ("Solution Architect", r"architect")]
def map_role(r, o):
    if isinstance(r, str) and r in SELF: return SELF[r]
    if isinstance(r, str) and r == "Other, which one?":
        t = (o or "").lower()
        for k, rx in RULES:
            if re.search(rx, t): return k
    return None
role_m = [map_role(r, o) for r, o in zip(q8_raw.index.map(lambda i: df.loc[i, "D4_Role"]),
                                         q8_raw.index.map(lambda i: df.loc[i, "D4_Role_Others"]))]
role_m = pd.Series(role_m, index=df.index)
unmapped = int((df["D4_Role"] == "Other, which one?").sum() - role_m[df["D4_Role"] == "Other, which one?"].notna().sum())
LOG["role_mapping"] = {"others_free_text": int((df["D4_Role"] == "Other, which one?").sum()),
                       "unmapped_after_regex": unmapped,
                       "role_known_among_q8_valid": int(role_m[answered_block].notna().sum())}
H = Q_valid.copy()
for lab, col in CANON.items():
    H[lab] = ((Q_valid[col] == 1) | (role_m[answered_block.values].eq(lab).values)).astype(int)
S3 = summarize(H[main_labels], main_labels, main_labels)
sens["S3_hybrid_quoted_or_selfrole"] = {"N": len(H), "table": S3}

# S4: Q1 Problem Understanding (importance of Requirements) - qualitative corroboration
q1c = "Q1_ML_Life_Cycle_Importance_Problem_Understanding"
q1 = df[q1c].dropna()
q1 = q1[q1 != "I don't know"]
high = q1.isin(["High Relevance", "Extremely Relevant"])
r1 = np.random.default_rng(SEED); q1v = high.to_numpy()
ridx = r1.integers(0, len(q1v), size=(B, len(q1v)))
b1 = q1v[ridx].mean(axis=1) * 100
sens["S4_Q1_problem_understanding"] = {
    "levels": df[q1c].value_counts(dropna=False).to_dict(),
    "n_valid_excl_dont_know": int(len(q1)),
    "pct_high_or_extremely_relevant": round(100 * high.mean(), 3),
    "ci_low": round(float(np.percentile(b1, 2.5)), 3), "ci_high": round(float(np.percentile(b1, 97.5)), 3)}

# ---------- top-2 stability across scenarios ----------
def top2(t): return list(t.head(2)["role"])
stab = {"MAIN": top2(main_tbl)}
for k, v in sens.items():
    stab[k] = top2(v["table"]) if "table" in v else "n/a (corroborative)"
LOG["top2_by_scenario"] = stab
LOG["main_table"] = main_tbl.to_dict("records")
LOG["paired_PL_vs_DS"] = paired
LOG["sensitivity"] = {k: (v["table"].to_dict("records") if "table" in v else v) for k, v in sens.items()}

with open("analysis/results.json", "w") as f:
    json.dump(LOG, f, indent=2, default=str)
with open("analysis/main_table.csv", "w") as f: main_tbl.to_csv(f, index=False)
sens_frames = [v["table"].assign(scenario=k) for k, v in sens.items() if isinstance(v, dict) and "table" in v]
sens_all = pd.concat(sens_frames)[["scenario", "role", "n_denominator", "n_quoted", "pct", "ci_low", "ci_high"]]
with open("analysis/sensitivity_tables.csv", "w") as f2:
    sens_all.to_csv(f2, index=False)

pd.set_option("display.width", 200)
print("=== MAIN (denominator = respondents answering Q8 block) ==="); print(main_tbl.to_string(index=False))
print("\n=== PAIRED PL - DS ==="); print(json.dumps(paired, indent=2))
for k, v in sens.items():
    print(f"\n=== {k} (N={v.get('N','')}) ===")
    print(v["table"].to_string(index=False) if "table" in v else json.dumps(v, indent=2, default=str))
print("\n=== TOP-2 BY SCENARIO ==="); print(json.dumps(stab, indent=2))
print("\n=== LOG ==="); print(json.dumps({k: v for k, v in LOG.items()
      if k in ("rows","columns","q8_block","cleaning_exclusions","role_mapping")}, indent=2, default=str))
