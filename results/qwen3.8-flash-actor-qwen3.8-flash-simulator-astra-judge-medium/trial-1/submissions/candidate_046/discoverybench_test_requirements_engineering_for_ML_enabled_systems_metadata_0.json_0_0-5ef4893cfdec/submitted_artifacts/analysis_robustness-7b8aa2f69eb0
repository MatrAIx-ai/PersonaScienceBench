"""Robustness of the PL vs DS ordering + formal record of the cited-figures discrepancy."""
import json
import numpy as np, pandas as pd
from scipy import stats

DATA = "data/requirements_engineering_for_ML-enabled_systems.csv"
B, SEED = 10_000, 42
PL, DS = "Q8_ML_Addressing_Project_Lead", "Q8_ML_Addressing_Data_Scientist"
df = pd.read_csv(DATA, dtype=str)
ok = ~df[PL].isin(["-77", "-66", "-99"]).fillna(False) & df[PL].notna()
sub = df[ok]
pl = (sub[PL] == "quoted").to_numpy().astype(int); ds = (sub[DS] == "quoted").to_numpy().astype(int)

# exact McNemar on paired binary responses
b_ = int(((pl == 1) & (ds == 0)).sum()); c_ = int(((pl == 0) & (ds == 1)).sum())
p_mcn = stats.binomtest(min(b_, c_), b_ + c_, 0.5).pvalue
n = len(sub)
res = {"n": n, "PL_only": b_, "DS_only": c_, "both": int(((pl == 1) & (ds == 1)).sum()),
       "neither": int(((pl == 0) & (ds == 0)).sum()),
       "mcnemar_exact_p": round(float(p_mcn), 4),
       "PL_pct": round(100 * pl.mean(), 3), "DS_pct": round(100 * ds.mean(), 3)}

# seed stability of bootstrap ordering (B=10000)
rows = []
for seed in [42, 1, 7, 2024, 31337]:
    rng = np.random.default_rng(seed)
    idx = rng.integers(0, n, size=(B, n))
    d = (pl[idx] - ds[idx]).mean(axis=1) * 100
    rows.append({"seed": seed, "diff_pp_point": round(100 * (pl.mean() - ds.mean()), 3),
                 "ci_low": round(float(np.percentile(d, 2.5)), 3), "ci_high": round(float(np.percentile(d, 97.5)), 3),
                 "prob_PL_gt_DS": round(float((d > 0).mean()), 4)})
res["seed_stability"] = rows
# how often does the bootstrap ranking place DS above PL / does any other role enter top-2?
rng = np.random.default_rng(SEED)
cols = ["Q8_ML_Addressing_Project_Lead", "Q8_ML_Addressing_Data_Scientist", "Q8_ML_Addressing_Business_Analyst",
        "Q8_ML_Addressing_Developer", "Q8_ML_Addressing_Solution_Architect", "Q8_ML_Addressing_Requirement_Engineer",
        "Q8_ML_Addressing_Tester"]
V = (sub[cols] == "quoted").to_numpy()
idx = rng.integers(0, n, size=(B, n)); reps = V[idx].mean(axis=1) * 100
order = np.argsort(-reps, axis=1)
res["bootstrap_share_top2_set_is_PL_and_DS"] = round(float(
    (np.sort(order[:, :2], axis=1) == np.array([[0, 1]])).all(axis=1).mean()), 4)
res["bootstrap_share_DS_ranked_first"] = round(float((order[:, 0] == 1).mean()), 4)
res["bootstrap_share_PL_ranked_first"] = round(float((order[:, 0] == 0).mean()), 4)
res["bootstrap_share_BA_in_top2"] = round(float((order[:, :2] == 2).any(axis=1).mean()), 4)

# (d) formal discrepancy record: why 49.6% / 61.389% with +/-0.4pp cannot come from this export
def plausible_n(p, halfwidth):
    se = halfwidth / 1.96
    return int(round(p * (1 - p) / se ** 2))
res["discrepancy"] = {
    "cited": {"p1": 49.6, "ci1": [49.219, 49.981], "p2": 61.389, "ci2": [60.955, 61.822]},
    "implied_effective_n_for_CI_halfwidth_0.4pp": {
        "at_p_0.496": plausible_n(0.496, 0.381 / 100), "at_p_0.614": plausible_n(0.61389, 0.4335 / 100)},
    "observed_n": {"total_rows": int(len(df)), "answered_Q8_block": int(n)},
    "exact_fraction_feasibility": {
        "49.6%_needs": "k/N in {62/125, 124/250, 186/375,...} (N multiple of 125)",
        "61.389%_needs": "k/N in {221/360, 380/619, 442/720,...}; no N<=276 solution",
        "closest_with_N=194": {"49.6": "96/194=49.485 or 97/194=50.000", "61.389": "119/194=61.340 or 120/194=61.856"}},
    "closest_candidates_found": {
        "Data Scientist (main)": round(100 * ds.mean(), 3),
        "Data Scientist (completed-only)": 49.468,
        "Project Lead with D4_Role_Others mapped (hybrid)": 60.309,
        "Business_Analyst or Data_Scientist union": 63.402},
    "hypothesis": "cited figures likely come from a different/extended export (larger N) or a mis-scaled CI; not reproducible from this file"}
with open("analysis/robustness.json", "w") as f: json.dump(res, f, indent=2)
print(json.dumps(res, indent=2))
