import pandas as pd, re, collections, json
df = pd.read_csv("data/requirements_engineering_for_ML-enabled_systems.csv", dtype=str)
oth = df.loc[df['D4_Role'] == 'Other, which one?', 'D4_Role_Others'].fillna('').str.strip()
RULES = [("Data Scientist", r"data scientist|data science|machine learning engineer|ml engineer|computer vision|data analyst|data engineer|research scientist|reserach scientist"),
         ("Developer", r"developer|software engineer"),
         ("Project Lead / Project Manager", r"director|lead|manager|ceo|cto|founder|coordinator"),
         ("Requirements Engineer", r"requirement|business analyst"),
         ("Solution Architect", r"architect")]
ACAD = r"professor|lecturer|research|student|phd|teacher|bolsista|assistant"
cnt = collections.Counter(); unm = []
for t in oth:
    hit = next((k for k, rx in RULES if re.search(rx, t.lower())), None)
    cnt[hit or 'UNMAPPED'] += 1
    if hit is None:
        unm.append(('academic-ish' if re.search(ACAD, t.lower()) else 'other', t))
print(pd.Series(cnt).sort_values(ascending=False).to_string())
print('total:', len(oth), 'mapped:', len(oth) - cnt['UNMAPPED'], 'unmapped:', cnt['UNMAPPED'])
print('unmapped academic-ish:', sum(1 for k, _ in unm if k == 'academic-ish'), ' other:', sum(1 for k, _ in unm if k == 'other'))
dontknow = df[[c for c in df.columns if c.startswith(('Q1_ML_Life_Cycle', 'Q2_ML_Life_Cycle'))]].eq("I don't know").sum().sum()
print('D4_Role missing (0/-99):', int(df['D4_Role'].isin(['0', '-99']).sum()))
print("I don't know cells in Q1+Q2:", int(dontknow))
json.dump({'counts': dict(cnt), 'n_others': int(len(oth))}, open('analysis/others_mapping.json', 'w'), indent=2)
