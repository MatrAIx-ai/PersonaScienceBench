"""
Q9 - Requirements elicitation techniques for ML-enabled systems.
Goal: identify the most commonly used elicitation technique (prevalence = share of
respondents whose answer is the affirmative category 'quoted'), with a percentile
bootstrap CI (row-level resampling, B=10000, seed=42), plus significance evidence
(bootstrap share of replicates where the winner stays first, and CI of the gap vs 2nd).

Coding conventions verified in the raw file (see INSPECCION in README):
  'quoted'      = technique used / mentioned  (only affirmative category available;
                  Q9 has NO frequency Likert scale in this file)
  'not quoted'  = technique not used
  '-77'         = respondent skipped the whole Q9 block (identical 82 rows in all 6 items)
  '-99' / '-66' = NA codes inside free-text *_Free columns
"""
import json
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
OUT = "analysis/outputs"
SEED, B, B_CHECK = 42, 10_000, 100_000

NAMED = ["Q9_ML_Elicitation_Interviews", "Q9_ML_Elicitation_Scenarios",
         "Q9_ML_Elicitation_Prototyping", "Q9_ML_Elicitation_Workshops_Meetings",
         "Q9_ML_Elicitation_Observation"]
OTHERS = "Q9_ML_Elicitation_Others"
ALL6 = NAMED + [OTHERS]
LABEL = {c: c.replace("Q9_ML_Elicitation_", "") for c in ALL6}

df = pd.read_csv(CSV, dtype=str)
assert df.shape == (276, 202), df.shape
assert df["ID"].nunique() == 276

# ---------------- descriptive table -------------------------------------------
rows = []
for c in ALL6:
    s = df[c]
    q, nq, na = int((s == "quoted").sum()), int((s == "not quoted").sum()), int((s == "-77").sum())
    assert q + nq + na == 276 and s.notna().all()
    rows.append(dict(technique=LABEL[c], column=c, quoted=q, not_quoted=nq, skipped_m77=na,
                     valid=q + nq, pct_valid=100 * q / (q + nq), pct_all276=100 * q / 276))
desc = pd.DataFrame(rows).sort_values("pct_valid", ascending=False).reset_index(drop=True)
desc["rank"] = range(1, len(desc) + 1)
desc.round(4).to_csv(f"{OUT}/q9_descriptive_table.csv", index=False)

# block-skip check: -77 rows identical across all 6 items
m77 = df[ALL6].eq("-77")
block_skip_identical = bool(m77.all(axis=1).sum() == m77.any(axis=1).sum() == 82)

# free-text Others (reported, never merged into named techniques)
free = df[OTHERS].eq("quoted")
others_free = df.loc[free, "Q9_ML_Elicitation_Others_Free"].fillna("<NaN>").tolist()
assert len(others_free) == 11

# ---------------- primary analysis: valid respondents (n=194) ------------------
valid = df[NAMED[0]].ne("-77")
n_valid = int(valid.sum())
M = df.loc[valid, NAMED].eq("quoted").to_numpy()          # respondents x techniques
p_hat = M.mean(axis=0)
order = np.argsort(-p_hat, kind="stable")
win = int(order[0]); second = int(order[1])
pct = 100 * p_hat

# sensitivities: 276 (skip = not used) and 170 (uses >=1 named technique)
M276 = df[NAMED].eq("quoted").to_numpy()
n170 = int(M276.any(axis=1).sum())
sens = pd.DataFrame({
    "technique": [LABEL[c] for c in NAMED],
    "pct_valid194": 100 * M.mean(axis=0),
    "pct_all276": 100 * M276.mean(axis=0),
    "pct_users170": 100 * M276.sum(axis=0) / n170,
})
sens["rank_valid194"] = sens.pct_valid194.rank(ascending=False, method="min").astype(int)
sens["rank_all276"] = sens.pct_all276.rank(ascending=False, method="min").astype(int)
sens["rank_users170"] = sens.pct_users170.rank(ascending=False, method="min").astype(int)
winners = [sens.loc[sens[c] == 1, "technique"].iloc[0]
           for c in ("rank_valid194", "rank_all276", "rank_users170")]
ranking_invariant = bool(winners[0] == winners[1] == winners[2] == LABEL[NAMED[win]])
sens.round(4).to_csv(f"{OUT}/q9_sensitivity_denominators.csv", index=False)

# ---------------- bootstrap -----------------------------------------------------
def boot(mat, B, seed):
    n = mat.shape[0]
    rng = np.random.default_rng(seed)
    out = np.empty((B, mat.shape[1]))
    done = 0
    while done < B:                                    # chunked for memory safety
        b = min(2000, B - done)
        idx = rng.integers(0, n, size=(b, n))
        out[done:done + b] = mat[idx].mean(axis=1)
        done += b
    return out

def pctile_ci(x):
    return float(np.percentile(x, 2.5)), float(np.percentile(x, 97.5))

boot100 = 100 * boot(M, B, SEED)
ci = np.array([pctile_ci(boot100[:, j]) for j in range(len(NAMED))])
rank_tab = pd.DataFrame({
    "technique": [LABEL[c] for c in NAMED],
    "k_quoted": M.sum(axis=0),
    "n_valid": n_valid,
    "pct": pct, "ci_lo": ci[:, 0], "ci_hi": ci[:, 1],
    "boot_se_pp": boot100.std(axis=0, ddof=1),
}).sort_values("pct", ascending=False).reset_index(drop=True)
rank_tab["ci_width_pp"] = rank_tab.ci_hi - rank_tab.ci_lo
rank_tab["rank"] = range(1, len(rank_tab) + 1)

# significance evidence: winner stays first / gap vs next-best in each replicate
others = [j for j in range(len(NAMED)) if j != win]
gap = boot100[:, win] - boot100[:, others].max(axis=1)
p_int = boot100[:, win]
p_second_best = boot100[:, others].max(axis=1)
win_stays_first = float((p_int > p_second_best).mean())
gap_ci = pctile_ci(gap)
# head-to-head vs every competitor
h2h = pd.DataFrame({
    "technique": [LABEL[NAMED[j]] for j in others],
    "diff_pp_interviews_minus_other": pct[win] - pct[others],
    "diff_ci_lo_pp": [pctile_ci(p_int - boot100[:, j])[0] for j in others],
    "diff_ci_hi_pp": [pctile_ci(p_int - boot100[:, j])[1] for j in others],
    "share_replicates_interviews_higher": [float((p_int > boot100[:, j]).mean()) for j in others],
})
gap100k = 100 * boot(M, B_CHECK, SEED)
ci100k = pctile_ci(gap100k[:, win])
rank_tab.round(4).to_csv(f"{OUT}/q9_ranking_with_bootstrap_ci.csv", index=False)
h2h.round(4).to_csv(f"{OUT}/q9_head_to_head_vs_interviews.csv", index=False)

# analytic sanity check of the CI width (Wilson / Wald) for p=0.5, n=194
from math import sqrt
wald_hw = 1.96 * 100 * sqrt(0.5 * 0.5 / n_valid)

# question's cited reference value: is it reproducible here?
k_ref_target = 0.69399 * n_valid
ref_exact = [(k, n, round(100 * k / n, 3)) for n in range(20, 1000)
             for k in (round(0.69399 * n),) if abs(100 * k / n - 69.399) < 5e-4]

summary = dict(
    file=CSV, n_rows=int(len(df)), n_cols=int(df.shape[1]),
    total_missing_cells=int(df.isna().sum().sum()),
    block_skip_identical_across_6_items=block_skip_identical,
    n_valid_194=n_valid, n_users_ge1_technique=n170,
    winner=LABEL[NAMED[win]], winner_pct=round(float(pct[win]), 3),
    winner_k=int(M[:, win].sum()), winner_ci=[round(ci[win, 0], 3), round(ci[win, 1], 3)],
    second_technique=[LABEL[NAMED[j]] for j in others if pct[j] == pct[second]],
    gap_vs_second_best_pp=round(float(gap.mean()), 3),
    share_replicates_gap_le_zero=round(float((gap <= 0).mean()), 4), gap_ci_pp=[round(gap_ci[0], 3), round(gap_ci[1], 3)],
    bootstrap_B=B, seed=SEED, ci_method="percentile 2.5/97.5, row resampling with replacement",
    share_replicates_interviews_strictly_first=round(win_stays_first, 4),
    B_check_100k_winner_ci=[round(ci100k[0], 3), round(ci100k[1], 3)],
    ranking_invariant_across_denominators=bool(ranking_invariant),
    analytic_wald_halfwidth_pp=round(wald_hw, 3),
    cited_reference_pct=69.399,
    cited_reference_k_of_194=round(float(k_ref_target), 2),
    exact_kn_for_69_399_within_n999=ref_exact[:5],
    cited_reference_ci_halfwidth_pp=0.3365,
    others_free_text=others_free,
)
with open(f"{OUT}/q9_summary.json", "w") as f:
    json.dump(summary, f, indent=2)

pd.set_option("display.width", 200)
print("== DESCRIPTIVE (6 techniques) ==")
print(desc.round(2).to_string(index=False))
print("\n-77 block-skip identical across items:", block_skip_identical, "| n_valid:", n_valid, "| users>=1:", n170)
print("\n== RANKING + PERCENTILE BOOTSTRAP CI (n=194, B=%d, seed=%d) ==" % (B, SEED))
print(rank_tab.round(3).to_string(index=False))
print("\n== SENSITIVITY OF DENOMINATOR ==")
print(sens.round(2).to_string(index=False))
print("winner invariant across denominators:", ranking_invariant)
print("\n== HEAD-TO-HEAD vs INTERVIEWS ==")
print(h2h.round(3).to_string(index=False))
print("\nIntervals: winner CI = [%.3f, %.3f] (B=10k) | [%.3f, %.3f] (B=100k check)"
      % (ci[win, 0], ci[win, 1], ci100k[0], ci100k[1]))
print("gap Interviews - next best = %.3f pp (mean of replicates), CI [%.3f, %.3f]" % (gap.mean(), gap_ci[0], gap_ci[1]))
print("share of replicates with gap <= 0 (tie or loss vs next best): %.4f" % float((gap <= 0).mean()))
print("bootstrap share of replicates where Interviews is strictly first: %.4f" % win_stays_first)
print("analytic Wald half-width for p=0.5,n=194: %.2f pp" % wald_hw)
print("cited 69.399%% of n=194 would need k=%.2f (non-integer); exact k/n pairs<=999: %s" % (k_ref_target, ref_exact[:5]))
