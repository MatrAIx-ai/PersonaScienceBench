"""
Q10 ML requirements documentation formats: least-used formats + bootstrap CIs.

Pipeline (as approved):
  1) Load survey CSV, map sentinels (-77 block-not-shown, -99, -66, blank) -> NA.
     'quoted' = format used ; 'not quoted' = valid answer meaning "not used".
  2) Primary denominator: respondents shown the Q10 block (n=194).
     Sensitivity denominators: 276 (all rows), 164 (documenting = not Not_Documented),
     140 (documenting with >=1 named format), 188 (194 minus the 6 Suspended that saw Q10).
  3) Ranking over the 10 NAMED formats; Others and Not_Documented excluded from the
     ranking (reported separately).
  4) Non-stratified respondent-level bootstrap, 10,000 replicates, percentile 95% CI,
     bootstrap SE, plus exact (Clopper-Pearson) binomial CI as a contrast.
  5) Relative-order assignment to the published targets
     10.13% [9.926, 10.333] and 4.366% [4.231, 4.501].
"""
import numpy as np, pandas as pd

RNG = np.random.default_rng(20261022)
NBOOT = 10_000
CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
SENT = {"-77", "-99", "-66"}

df = pd.read_csv(CSV, dtype=str, keep_default_na=False, na_values=[])
q10 = [c for c in df.columns if c.startswith("Q10_ML_Documentation_")]
free = "Q10_ML_Documentation_Others_Free"
notdoc = "Q10_ML_Documentation_Not_Documented"
others = "Q10_ML_Documentation_Others"
coded = [c for c in q10 if c != free]
named = [c for c in coded if c not in (notdoc, others)]          # 10 named formats

# ---------- 1) sentinel handling ----------
rep = {}
for c in coded:
    v = df[c].astype(str).str.strip()
    raw_counts = v.value_counts().to_dict()
    m = v.isin(SENT)
    rep[c] = {"quoted": int((v == "quoted").sum()),
              "not_quoted": int((v == "not quoted").sum()),
              "sentinel": int(m.sum()),
              "raw_levels": raw_counts}
    df[c] = np.where(v == "quoted", 1.0, np.where(v == "not quoted", 0.0, np.nan))
df[free] = df[free].astype(str).str.strip().mask(df[free].astype(str).str.strip().isin(SENT | {"", "nan", "NaN"}))

# ---------- 2) denominators ----------
shown = df[coded].notna().any(axis=1)                  # block presented (not all -77)
d194 = shown
d276 = pd.Series(True, index=df.index)
d164 = shown & (df[notdoc] == 0)
n_fmt = df[named].sum(axis=1, min_count=1)
d140 = d164 & (n_fmt.fillna(0) > 0)
d188 = d194 & (df["Status"] != "Suspended (22)")

bases = {"PRIMARY n=194 (saw Q10 block)": d194,
         "SENS n=276 (all rows)": d276,
         "SENS n=164 (documenting)": d164,
         "SENS n=140 (documenting & >=1 format)": d140,
         "SENS n=188 (194 minus Suspended)": d188}

def boot_ci(x, n_boot=NBOOT, rng=RNG):
    idx = rng.integers(0, len(x), size=(n_boot, len(x)))
    p = (x[idx].mean(axis=1))
    return np.percentile(p, 2.5), np.percentile(p, 97.5), p.std(ddof=1)

def cp_ci(k, n, a=0.05):
    from scipy.stats import beta
    lo = 0.0 if k == 0 else beta.ppf(a / 2, k, n - k + 1)
    hi = 1.0 if k == n else beta.ppf(1 - a / 2, k, n - k + 1)
    return 100 * lo, 100 * hi

tables, rank_check = {}, {}
for bname, mask in bases.items():
    sub = df.loc[mask, named]
    n = int(mask.sum())
    n_missing_cells = int(sub.isna().sum().sum())
    if n_missing_cells:          # only the all-rows base: Q10 block never shown (-77)
        assert bname.startswith("SENS n=276"), bname
        sub = sub.fillna(0.0)    # not-shown can never be a 'used' indication
    rows = []
    for c in named:
        x = sub[c].to_numpy(float)
        assert set(np.unique(x)) <= {0.0, 1.0}, c
        k = int(x.sum()); p = 100 * k / n
        blo, bhi, bse = boot_ci(x)
        lo, hi, se = 100 * blo, 100 * bhi, 100 * bse   # report in percentage points
        clo, chi = cp_ci(k, n)
        rows.append(dict(format=c.replace("Q10_ML_Documentation_", ""), n_used=k, n_base=n,
                         pct=p, boot_ci_lo=lo, boot_ci_hi=hi, boot_se=se,
                         exact_ci_lo=clo, exact_ci_hi=chi))
    t = pd.DataFrame(rows).sort_values("pct").reset_index(drop=True)
    t["rank_ascending"] = np.arange(1, len(t) + 1)
    t["cells_treated_as_not_used_because_block_not_shown"] = n_missing_cells
    tables[bname] = t
    rank_check[bname] = tuple(t["format"].head(3))

prim = tables["PRIMARY n=194 (saw Q10 block)"]

# ---------- Others / Not_Documented reported separately ----------
extra = []
for c in (others, notdoc):
    x = df.loc[d194, c].to_numpy(float)
    k = int(x.sum()); blo, bhi, bse = boot_ci(x)
    lo, hi, se = 100*blo, 100*bhi, 100*bse; clo, chi = cp_ci(k, int(d194.sum()))
    extra.append(dict(item=c.replace("Q10_ML_Documentation_", ""), n_used=k,
                      n_base=int(d194.sum()), pct=100 * k / d194.sum(),
                      boot_ci_lo=lo, boot_ci_hi=hi, boot_se=se, exact_ci_lo=clo, exact_ci_hi=chi))
extra = pd.DataFrame(extra)
free_texts = df.loc[d194 & (df[others] == 1), free].dropna().tolist()

# ---------- robustness / target comparison ----------
targets = {"MLCanvas (target 10.13%)": 10.13, "BDD_Scenarios (target 4.366%)": 4.366}
robust = pd.DataFrame([dict(base=b, least=v[0], second_least=v[1]) for b, v in rank_check.items()])

t_cmp = []
for label, tv in targets.items():
    f = label.split(" ")[0]
    for b, t in tables.items():
        r = t[t["format"] == f].iloc[0]
        col = [c for c in named if c.endswith('_' + f)][0]
        mask_b = bases[b]; xb = df.loc[mask_b, col].fillna(0.0).to_numpy(float)
        bb = RNG.integers(0, len(xb), size=(NBOOT, len(xb))); bootp = xb[bb].mean(axis=1)
        t_cmp.append(dict(target=label, format=f, base=b, pct=round(r["pct"], 4),
                          boot_ci=f"[{r['boot_ci_lo']:.3f}, {r['boot_ci_hi']:.3f}]",
                          abs_gap_pp=round(abs(r["pct"] - tv), 3),
                          target_in_boot_CI=bool(r["boot_ci_lo"] <= tv <= r["boot_ci_hi"]),
                          target_in_exact_CI=bool(r["exact_ci_lo"] <= tv <= r["exact_ci_hi"]),
                          boot_two_sided_p_vs_target=round(float(2*min((bootp <= tv/100).mean(), (bootp >= tv/100).mean())), 4),
                          rank=int(r["rank_ascending"])))
t_cmp = pd.DataFrame(t_cmp)

pd.set_option("display.width", 220)
print("SENTINEL / LEVEL AUDIT (counts in raw file, all 276 rows)")
for c, d in rep.items():
    print(f"  {c.replace('Q10_ML_Documentation_',''):22s} quoted={d['quoted']:4d} not_quoted={d['not_quoted']:4d} sentinel={d['sentinel']:4d} levels={sorted(d['raw_levels'])}")
print("\nDenominator sizes:", {k: int(v.sum()) for k, v in bases.items()})
print("\nRows excluded because whole Q10 block was -77:", int((~d194).sum()),
      "| their Status values:", sorted(df.loc[~d194, "Status"].unique()))
print("Suspended respondents that DID see Q10 (excluded in n=188):", int((d194 & (df['Status']=='Suspended (22)')).sum()))
for b, t in tables.items():
    print(f"\n=== {b} ===")
    print(t[["rank_ascending", "format", "n_used", "n_base", "pct", "boot_ci_lo", "boot_se", "boot_ci_hi", "exact_ci_lo", "exact_ci_hi"]].round(3).to_string(index=False))
    if n_missing_cells: print(f"  [{bname}] {n_missing_cells} cells were -77 (block not shown) -> counted as NOT used, denominator {n}")
print("\n=== EXCLUDED FROM RANKING (base 194) ===")
print(extra.round(3).to_string(index=False))
print("\nOthers_Free texts (n=%d):" % len(free_texts), free_texts)
print("\n=== RANK ROBUSTNESS ACROSS DENOMINATORS ===")
print(robust.to_string(index=False))
print("\n=== TARGET COMPARISON ===")
print(t_cmp.to_string(index=False))
print("\nCount ratio observed (MLCanvas/BDD) = %.3f ; published target ratio = %.3f" %
      (prim.loc[prim['format'] == 'MLCanvas', 'n_used'].iloc[0] / prim.loc[prim['format'] == 'BDD_Scenarios', 'n_used'].iloc[0], 10.13 / 4.366))
for label, tv in [("10.13 [9.926,10.333]", 10.13), ("4.366 [4.231,4.501]", 4.366)]:
    pass
def implied_n(p, lo, hi):
    se = (hi - lo) / (2 * 1.959964); return p * (1 - p) / se ** 2
print("Published CIs imply effective n: 10.13%% -> %.0f ; 4.366%% -> %.0f" %
      (implied_n(.1013, .09926, .10333), implied_n(.04366, .04231, .04501)))

prim.to_csv("out/q10_results_primary_n194.csv", index=False)
extra.to_csv("out/q10_excluded_categories.csv", index=False)
t_cmp.to_csv("out/q10_target_comparison.csv", index=False)
prim_x = df.loc[d194, named].to_numpy(float)
np.save("out/boot_replicates_primary.npy", prim_x[RNG.integers(0, d194.sum(), size=(NBOOT, d194.sum()))].mean(axis=1)*100)
pd.concat([t.assign(base=b) for b, t in tables.items()]).to_csv("out/q10_sensitivity_all_bases.csv", index=False)
print("\nWrote out/q10_results_primary_n194.csv, out/q10_excluded_categories.csv, out/q10_target_comparison.csv, out/q10_sensitivity_all_bases.csv")
