"""
Education expenditure and per-capita income: Sub-Saharan Africa (SSF) vs Lower middle income (LMC).
Data: data/worldbank_education_gdp.csv (WDI-style wide export; 2 aggregate groups x 6 series, 1975-2015).
Steps: A descriptives | B within-LMC models | C group comparison (C1 pooled ref, C2 common window,
C3 enrolment mechanism) | D secondary spec with controls 1991-2015.
Correlational scope. Newey-West HAC (4 lags) primary SEs. No imputation, no external data.
"""
import json
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.stats.stattools import durbin_watson

pd.set_option("display.width", 170)
RAW = "data/worldbank_education_gdp.csv"
OUT = {}
EDU, INC, EXP, PRM, SEC, LFPR = ("NY.ADJ.AEDU.GN.ZS", "NY.GNP.PCAP.KD", "NE.EXP.GNFS.KD.ZG",
                                 "SE.PRM.ENRR", "SE.SEC.ENRR", "SL.TLF.CACT.ZS")
G = {"SSF": "Sub-Saharan Africa", "LMC": "Lower middle income"}

# --------------------------------------------------------------- load, long shape, QC
df = pd.read_csv(RAW)
year_cols = [c for c in df.columns if "[YR" in c]
long = df.melt(id_vars=["Country Group", "Country Code", "Series Name", "Series Code"],
               value_vars=year_cols, var_name="variable", value_name="raw")
long["year"] = long["variable"].str.extract(r"YR(\d{4})").astype(int)
long["value"] = pd.to_numeric(long["raw"], errors="coerce")
OUT["qc"] = {"raw_shape": list(df.shape), "n_year_columns": len(year_cols),
             "year_span": [int(long.year.min()), int(long.year.max())],
             "cells_in_long": int(len(long)),
             "blank_cells_nan": int(long["value"].isna().sum()),
             "non_numeric_cells_coerced": int((long["raw"].notna() & long["value"].isna()).sum())}

wide = long.pivot_table(index="year", columns=["Country Code", "Series Code"], values="value")
def ser(code, g):
    return wide[(g, code)].rename(f"{g}_{code}")

def availability():
    recs = []
    for c in [INC, EDU, EXP, PRM, SEC, LFPR]:
        for g in ["SSF", "LMC"]:
            s = ser(c, g).dropna()
            recs.append({"code": c, "group": g, "n_years": len(s),
                         "years_present": f"{int(s.index.min())}-{int(s.index.max())}",
                         "pct_missing": round((1 - len(s) / 41) * 100, 1),
                         "mean": round(float(s.mean()), 2), "min": round(float(s.min()), 2),
                         "max": round(float(s.max()), 2)})
    return recs

def fit(y, X, name, hac=4):
    d = pd.concat([y.rename("y"), X], axis=1).dropna()
    Xc = sm.add_constant(d.drop(columns=["y"]).astype(float))
    res = sm.OLS(d["y"].astype(float), Xc).fit(cov_type="hac", cov_kwds={"maxlags": hac})
    ols = sm.OLS(d["y"].astype(float), Xc).fit()
    sig = lambda p: "***" if p < .01 else "**" if p < .05 else "*" if p < .1 else ""
    r = {"model": name, "n": int(res.nobs), "r2": round(float(res.rsquared), 3),
         "durbin_watson": round(float(durbin_watson(res.resid)), 2),
         "resid_ar1": round(float(pd.Series(np.asarray(res.resid)).autocorr(1)), 2),
         "hac_lags": hac,
         "coef": {k: round(float(v), 4) for k, v in res.params.items()},
         "se_nw": {k: round(float(v), 4) for k, v in res.bse.items()},
         "p_nw": {k: round(float(v), 4) for k, v in res.pvalues.items()},
         "p_ols": {k: round(float(v), 4) for k, v in ols.pvalues.items()},
         "se_ols": {k: round(float(v), 4) for k, v in ols.bse.items()},
         "sig": {k: sig(p) for k, p in res.pvalues.items()}}
    print(f"\n=== {name} | N={r['n']} R2={r['r2']} DW={r['durbin_watson']} residAR1={r['resid_ar1']} ===")
    for k in res.params.index:
        print(f"   {k:<10} b={res.params[k]: .4f}  seNW={res.bse[k]:.4f}  pNW={res.pvalues[k]:.3f} "
              f"{sig(res.pvalues[k])}   (se_classical={ols.bse[k]:.4f})")
    return r

print("=" * 78, "\nSTEP A - DESCRIPTIVES 1975-2015\n", "=" * 78)
OUT["availability"] = availability()
print(pd.DataFrame(OUT["availability"]).to_string(index=False))

edu = long[long["Series Code"] == EDU].copy()
edu["decade"] = (edu.year // 10) * 10
dec = edu.pivot_table(index="decade", columns="Country Code", values="value").round(3)
print("\nA1. Adjusted savings: education expenditure (% of GNI) - decade means\n", dec.to_string())
OUT["edu_decade_means"] = json.loads(dec.to_json(orient="split"))

A = {}
for g in ["SSF", "LMC"]:
    s = ser(EDU, g).dropna()
    A[g] = {"1975": round(float(s.loc[1975]), 2), "peak": round(float(s.max()), 2),
            "peak_year": int(s.idxmax()), "1995": round(float(s.loc[1995]), 2),
            "2000": round(float(s.loc[2000]), 2), "2015": round(float(s.loc[2015]), 2),
            "mean": round(float(s.mean()), 2)}
    print(f"A2. {G[g]}: edu 1975={A[g]['1975']} peak={A[g]['peak']} ({A[g]['peak_year']}) "
          f"1995={A[g]['1995']} 2000={A[g]['2000']} 2015={A[g]['2015']} mean={A[g]['mean']}")
OUT["edu_key_years"] = A

print("\nA3. GNI per capita (constant 2015 US$) - available observations")
inc_info = {}
for g in ["SSF", "LMC"]:
    s = ser(INC, g).dropna()
    cagr = ((s.iloc[-1] / s.iloc[0]) ** (1 / (s.index[-1] - s.index[0])) - 1) * 100
    inc_info[g] = {"n": len(s), "span": f"{int(s.index.min())}-{int(s.index.max())}",
                   "start": round(float(s.iloc[0]), 1), "end": round(float(s.iloc[-1]), 1),
                   "cagr_pct": round(cagr, 2), "values": {int(k): round(float(v), 1) for k, v in s.items()}}
    print(f"    {G[g]}: n={len(s)} ({inc_info[g]['span']}) {inc_info[g]['start']:.0f} -> "
          f"{inc_info[g]['end']:.0f} (CAGR {cagr:.2f}%/yr)")
OUT["income"] = inc_info

print("\nA4. Gross enrolment ratios")
enr = {}
for g in ["SSF", "LMC"]:
    enr[g] = {}
    for code, lab in [(PRM, "primary_GER"), (SEC, "secondary_GER")]:
        s = ser(code, g).dropna()
        enr[g][lab] = {"1975": round(float(s.loc[1975]), 1), "1995": round(float(s.loc[1995]), 1),
                       "2015": round(float(s.loc[2015]), 1),
                       "change": round(float(s.loc[2015] - s.loc[1975]), 1)}
        print(f"    {G[g]} {lab}: 1975={s.loc[1975]:.1f} 1995={s.loc[1995]:.1f} 2015={s.loc[2015]:.1f} "
              f"(+{s.loc[2015]-s.loc[1975]:.1f}pp)")
OUT["enrolment"] = enr

print("\nA5. Education vs income association: LEVELS vs CHANGES")
cor = {}
for g in ["SSF", "LMC"]:
    y, e = np.log(ser(INC, g)), ser(EDU, g)
    lv = pd.concat([y, e], axis=1).dropna()
    gl = pd.concat([y.diff(), e], axis=1).dropna()
    dd = pd.concat([y.diff(), e.diff()], axis=1).dropna()
    cor[g] = {"n_levels": len(lv), "r_levels": round(float(lv.corr().iloc[0, 1]), 3),
              "n_growth_level": len(gl), "r_growth_level": round(float(gl.corr().iloc[0, 1]), 3),
              "n_deltas": len(dd), "r_deltas": round(float(dd.corr().iloc[0, 1]), 3)}
    print(f"    {G[g]}: levels r={cor[g]['r_levels']} (n={cor[g]['n_levels']}) | "
          f"growth~edu level r={cor[g]['r_growth_level']} (n={cor[g]['n_growth_level']}) | "
          f"growth~D.edu r={cor[g]['r_deltas']} (n={cor[g]['n_deltas']})")
OUT["correlations"] = cor

print("\n" + "=" * 78, "\nSTEP B - WITHIN-LMC TIME-SERIES MODELS, 1975-2015\n", "=" * 78)
lm = pd.DataFrame({"lny": np.log(ser(INC, "LMC")), "edu": ser(EDU, "LMC")})
lm["trend"] = lm.index.astype(float) - 1975
for k in (1, 2, 3):
    lm[f"edu_l{k}"] = lm["edu"].shift(k)
lm["d_lny"] = lm["lny"].diff(); lm["d_edu"] = lm["edu"].diff()
B = [fit(lm["lny"], lm[["edu"]], "B1 LMC levels, contemporaneous, no trend"),
     fit(lm["lny"], lm[["edu", "trend"]], "B2 LMC levels + linear trend"),
     fit(lm["lny"], lm[["edu_l1", "trend"]], "B3a LMC levels + trend, edu lag 1"),
     fit(lm["lny"], lm[["edu_l2", "trend"]], "B3b LMC levels + trend, edu lag 2"),
     fit(lm["lny"], lm[["edu_l3", "trend"]], "B3c LMC levels + trend, edu lag 3"),
     fit(lm["d_lny"], lm[["d_edu"]], "B4 LMC FIRST DIFFERENCES (main robustness)"),
     fit(lm["d_lny"], lm[["d_edu", "trend"]], "B5 LMC first differences + trend"),
     fit(lm["d_lny"], lm[["edu_l1"]], "B6 LMC growth ~ edu level lag 1")]
OUT["stepB"] = B

print("\n" + "=" * 78, "\nSTEP C - GROUP COMPARISON\n", "=" * 78)
rows = []
for g in ["LMC", "SSF"]:
    d = pd.concat([np.log(ser(INC, g)).rename("lny"), ser(EDU, g).rename("edu")], axis=1).dropna()
    d["ssa"] = 1.0 if g == "SSF" else 0.0
    d["grp"] = g
    rows.append(d)
pool = pd.concat(rows)
pool["edu_x_ssa"] = pool["edu"] * pool["ssa"]
print(f"C1 sample: LMC n={(pool.grp=='LMC').sum()} (1975-2015), SSF n={(pool.grp=='SSF').sum()} "
      f"({int(pool.loc[pool.grp=='SSF','lny'].index.min())}-{int(pool.loc[pool.grp=='SSF','lny'].index.max())})"
      f" -> total N={len(pool)}")
c1 = fit(pool["lny"], pool[["edu", "ssa", "edu_x_ssa"]],
         "C1 POOLED group intercept + SSA x edu interaction [REFERENCE, VERY LOW POWER]")
c1["caveat"] = ("SSA slope rests on 5 income observations (2011-2015); the interaction is not "
                "meaningfully identified. SSA countries are largely a SUBSET of the LMC aggregate, "
                "which attenuates any slope difference toward equality.")
OUT["stepC1"] = c1

print("\nC2 - COMMON WINDOW 2011-2015 (only window where both groups have income data)")
c2 = {}
for g in ["SSF", "LMC"]:
    d = pd.concat([np.log(ser(INC, g)).rename("lny"), ser(EDU, g).rename("edu")], axis=1).loc[2011:2015].dropna()
    b = float(np.polyfit(d["edu"], d["lny"], 1)[0])
    c2[g] = {"n": len(d), "edu_mean": round(float(d["edu"].mean()), 2),
             "edu_change_2011_2015": round(float(d["edu"].iloc[-1] - d["edu"].iloc[0]), 2),
             "income_growth_window_pct": round(float(np.exp(d["lny"].iloc[-1] - d["lny"].iloc[0]) - 1) * 100, 1),
             "b_lny_on_edu_levels": round(b, 3)}
    if len(d.dropna()) > 3:
        dd = d.dropna()
        c2[g]["corr_deltas"] = round(float(pd.concat([dd["lny"].diff(), dd["edu"].diff()], axis=1).dropna().corr().iloc[0, 1]), 3)
    print(f"    {G[g]}: n={c2[g]['n']} | edu mean={c2[g]['edu_mean']}% GNI (D={c2[g]['edu_change_2011_2015']:+.2f}pp)"
          f" | income 2011->2015 +{c2[g]['income_growth_window_pct']}% | b(lny~edu)={c2[g]['b_lny_on_edu_levels']:+.3f}"
          f" | r(D.lny,D.edu)={c2[g].get('corr_deltas')}")
OUT["stepC2"] = c2

print("\n" + "=" * 78, "\nSTEP C3 - MECHANISM: edu expenditure -> gross enrolment (41 yrs, BOTH groups)\n", "=" * 78)
C3 = []
for code, lab in [(PRM, "primary GER"), (SEC, "secondary GER")]:
    recs = []
    for g in ["LMC", "SSF"]:
        sub = pd.concat([ser(code, g).rename("y"), ser(EDU, g).rename("edu")], axis=1).dropna()
        sub["ssa"] = 1.0 if g == "SSF" else 0.0
        recs.append(sub)
    pp = pd.concat(recs)
    pp["edu_x_ssa"] = pp["edu"] * pp["ssa"]
    r = fit(pp["y"], pp[["edu", "ssa", "edu_x_ssa"]], f"C3 {lab} ~ edu, pooled + SSA interaction")
    r["outcome"] = lab
    C3.append(r)
    for g in ["LMC", "SSF"]:
        sub = pd.concat([ser(code, g).rename("y"), ser(EDU, g).rename("edu")], axis=1).dropna()
        C3.append(fit(sub["y"], sub[["edu"]], f"C3b {lab} ~ edu, within {g}"))
OUT["stepC3"] = C3

print("\n" + "=" * 78, "\nSTEP D - SECONDARY SPEC WITH CONTROLS (1991-2015 only)\n", "=" * 78)
D = []
d = pd.concat([np.log(ser(INC, "LMC")).rename("lny"), ser(EDU, "LMC").rename("edu"),
               ser(EXP, "LMC").rename("exp"), ser(LFPR, "LMC").rename("lfpr"),
               ser(PRM, "LMC").rename("prm"), ser(SEC, "LMC").rename("sec")], axis=1).loc[1991:2015]
d["trend"] = np.arange(len(d), dtype=float)
d["edu_l2"] = ser(EDU, "LMC").shift(2).loc[1991:2015]
D.append(fit(d["lny"], d[["edu_l2"]], "D0 LMC 1991-15: edu lag2 only (restricted-sample baseline)"))
D.append(fit(d["lny"], d[["edu_l2", "prm", "sec"]], "D1 LMC 1991-15: edu lag2 + enrolment"))
D.append(fit(d["lny"], d[["edu_l2", "prm", "sec", "exp", "lfpr"]], "D2 LMC 1991-15: full controls"))
dd = pd.concat([np.log(ser(INC, "LMC")).diff().rename("d_lny"), ser(EDU, "LMC").diff().rename("d_edu"),
                ser(EXP, "LMC").rename("exp")], axis=1).loc[1991:2015]
D.append(fit(dd["d_lny"], dd[["d_edu"]], "D3 LMC 1991-15: differences, edu only"))
D.append(fit(dd["d_lny"], dd[["d_edu", "exp"]], "D4 LMC 1991-15: differences + export growth"))
OUT["stepD"] = D

with open("analysis/results.json", "w") as f:
    json.dump(OUT, f, indent=2, default=str)
print("\nWrote analysis/results.json")

print("\n" + "=" * 78, "\nSTEP E - INTEGRITY CHECKS\n", "=" * 78)
E = {}
print("E1. Linear-detrended association (residual correlation), LMC 1975-2015")
for g in ["LMC", "SSF"]:
    d = pd.DataFrame({"lny": np.log(ser(INC, g)), "edu": ser(EDU, g)}).dropna()
    if len(d) < 8:
        print(f"    {G[g]}: n={len(d)} too few obs to detrend; skipped (see C2)")
        continue
    tt = np.arange(len(d), dtype=float)
    for v in d.columns:
        d[v + "_dt"] = d[v] - np.polyval(np.polyfit(tt, d[v], 1), tt)
    r = float(d["lny_dt"].corr(d["edu_dt"]))
    E[f"detrended_{g}"] = {"n": len(d), "r": round(r, 3)}
    print(f"    {G[g]}: n={len(d)} r_detrended(lny, edu) = {r:.3f}")

print("\nE2. Mechanism in DIFFERENCES: d(enrolment) ~ d(edu), both groups (40 diffs)")
E3d = []
for code, lab in [(PRM, "primary GER"), (SEC, "secondary GER")]:
    recs = []
    for g in ["LMC", "SSF"]:
        sub = pd.DataFrame({"dy": ser(code, g).diff(), "dedu": ser(EDU, g).diff()}).dropna()
        sub["ssa"] = 1.0 if g == "SSF" else 0.0
        recs.append(sub)
        E3d.append(fit(sub["dy"], sub[["dedu"]], f"E2 {lab} ~ d.edu, within {g}"))
    pp = pd.concat(recs)
    pp["dedu_x_ssa"] = pp["dedu"] * pp["ssa"]
    E3d.append(fit(pp["dy"], pp[["dedu", "ssa", "dedu_x_ssa"]], f"E2 {lab} ~ d.edu, pooled + SSA interaction"))
OUT["stepE_mechanism_differences"] = E3d

print("\nE3. Decade cross-check within LMC: decade-mean edu vs decade income growth")
d = pd.DataFrame({"lny": np.log(ser(INC, "LMC")), "edu": ser(EDU, "LMC")}).dropna()
d["decade"] = (d.index // 10) * 10
tab = d.groupby("decade").agg(edu_mean=("edu", "mean"), growth_pct=("lny", lambda s: (np.exp(s.iloc[-1] - s.iloc[0]) - 1) * 100)).round(2)
print(tab.to_string()); OUT["lmc_decade_growth"] = json.loads(tab.to_json(orient="split"))

print("\nE4. Only common income window 2011-2015, levels side by side")
cmp2 = pd.DataFrame({"SSA_GNIpc": ser(INC, "SSF"), "LMC_GNIpc": ser(INC, "LMC"),
                     "SSA_edu": ser(EDU, "SSF"), "LMC_edu": ser(EDU, "LMC")}).loc[2011:2015].round(2)
print(cmp2.to_string()); OUT["common_window_table"] = json.loads(cmp2.to_json(orient="split"))
print("    SSA 2015 GNI/cap equals LMC's level in year:",
      int(ser(INC, "LMC").sub(ser(INC, "SSF").dropna().iloc[-1]).abs().idxmin()))

rows = []
for key in ["stepB", "stepC1", "stepC3", "stepD", "stepE_mechanism_differences"]:
    v = OUT[key]
    if isinstance(v, dict):
        v = [v]
    rows.extend(v)
coef_rows = []
for m in rows:
    for k, b in m["coef"].items():
        if k == "const":
            continue
        coef_rows.append({"model": m["model"], "term": k, "n": m["n"], "r2": m["r2"],
                          "coef": b, "se_newey_west": m["se_nw"][k], "p_newey_west": m["p_nw"][k],
                          "se_classical": m["se_ols"][k], "sig": m["sig"][k],
                          "durbin_watson": m["durbin_watson"], "resid_ar1": m["resid_ar1"]})
pd.DataFrame(coef_rows).to_csv("analysis/coefficient_table.csv", index=False)
print(f"\nWrote analysis/coefficient_table.csv ({len(coef_rows)} coefficient rows)")
OUT["n_models"] = len(rows)
with open("analysis/results.json", "w") as f:
    json.dump(OUT, f, indent=2, default=str)
print("Wrote analysis/results.json")
