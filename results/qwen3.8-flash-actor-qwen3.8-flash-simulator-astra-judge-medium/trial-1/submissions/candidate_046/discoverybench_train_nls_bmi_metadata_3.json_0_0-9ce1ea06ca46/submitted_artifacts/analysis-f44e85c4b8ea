"""
Age and the probability of dissaving (NLSY79, 1989 cross-section).
Design agreed with researcher:
  - DV: DISSAVED (1 = took more out of savings than put in)
  - Main model M1: centred AGE + AGE^2 + INCOME + GENDER + BLACK + HISPANIC
  - Raw (age only) = crude reference; M2 (+BMI) = robustness
  - Age dummies 24..32 = PRIMARY evidence on functional form
  - Robustness: log-income; logit vs LPM; 32-vs-24 contrast with CI
  - 3-state multinomial (save more / same / dissave) = interpretation line
"""
import os, numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
DATA = os.path.join(ROOT, "data", "nls_bmi_processed.csv")
log_lines = []
def log(msg=""):
    print(msg); log_lines.append(str(msg))

df = pd.read_csv(DATA)
df["FEMALE"] = (df["GENDER"] == "FEMALE").astype(int)
df["AGED"] = df["AGE"] - df["AGE"].mean()
df["AGED2"] = df["AGED"] ** 2
df["LINCOME"] = np.log(df["INCOME"] + 1.0)
ages = np.sort(df["AGE"].unique())

log("=" * 78); log("0. SAMPLE / DESCRIPTIVES")
log(f"rows={len(df)}  missing={int(df.isna().sum().sum())}")
log(f"AGE range {df.AGE.min()}-{df.AGE.max()}; overall P(DISSAVED)={df.DISSAVED.mean():.4f} ({int(df.DISSAVED.sum())}/{len(df)})")
log(f"P(SAMESAVE)={df.SAMESAVE.mean():.4f}; DISSAVED=1 & SAMESAVE=1 count={int(((df.DISSAVED==1)&(df.SAMESAVE==1)).sum())}")
desc = (df.groupby("AGE").agg(n=("DISSAVED", "size"), p_dissaved=("DISSAVED", "mean"),
        p_same=("SAMESAVE", "mean"), income_median=("INCOME", "median"),
        female_share=("FEMALE", "mean")).reset_index())
desc["p_savemore"] = 1 - desc["p_dissaved"] - desc["p_same"]
log("\nObserved by age:\n" + desc.round(4).to_string(index=False))
desc.round(6).to_csv(os.path.join(HERE, "descriptives_by_age.csv"), index=False)

X_ctrl = ["INCOME", "FEMALE", "BLACK", "HISPANIC"]
for a in ages[1:]:
    df[f"A{int(a)}"] = (df["AGE"] == a).astype(int)
specs = {
    "RAW_age_only":   ["AGED", "AGED2"],
    "M1_main":        ["AGED", "AGED2"] + X_ctrl,
    "M2_plus_BMI":    ["AGED", "AGED2"] + X_ctrl + ["BMI"],
    "M1_logincome":   ["AGED", "AGED2", "LINCOME", "FEMALE", "BLACK", "HISPANIC"],
    "M1_age_dummies": [f"A{int(a)}" for a in ages[1:]] + X_ctrl,
    "M1_linear_age":  ["AGED"] + X_ctrl,
}
def linpred(cols):
    X = sm.add_constant(df[cols].astype(float), has_constant="add")
    return X, list(X.columns)

rows, fits_lpm, fits_logit = [], {}, {}
for name, cols in specs.items():
    X, names = linpred(cols); y = df["DISSAVED"].astype(float)
    lpm = sm.OLS(y, X).fit(cov_type="HC1")
    lg = sm.GLM(y, X, family=sm.families.Binomial()).fit(cov_type="HC1")
    fits_lpm[name], fits_logit[name] = (lpm, names), (lg, names)
    for b in names:
        if b == "const": continue
        rows.append(dict(model=name, est="LPM", term=b, coef=lpm.params[b], se=lpm.bse[b],
                         p=lpm.pvalues[b], lo=lpm.conf_int().loc[b, 0], hi=lpm.conf_int().loc[b, 1]))
        rows.append(dict(model=name, est="logit", term=b, coef=lg.params[b], se=lg.bse[b],
                         p=lg.pvalues[b], lo=lg.conf_int().loc[b, 0], hi=lg.conf_int().loc[b, 1]))
coef_tab = pd.DataFrame(rows)
coef_tab.round(6).to_csv(os.path.join(HERE, "results_tables.csv"), index=False)

log("\n" + "=" * 78); log("1. AGE TERMS (LPM, HC1 robust SEs; coef in percentage points)")
key = coef_tab[(coef_tab.est == "LPM") & (coef_tab.term.str.startswith(("AGED", "A")))]
log(key.assign(coef_pp=lambda d: 100*d.coef, se_pp=lambda d: 100*d.se, lo_pp=lambda d: 100*d.lo, hi_pp=lambda d: 100*d.hi)
    [["model", "term", "coef_pp", "se_pp", "p", "lo_pp", "hi_pp"]].round(4).to_string(index=False))

log("\n2. MAIN MODEL M1 - full table")
for est, fits in [("LPM (coef = pp per unit)", fits_lpm), ("logit (coef = log-odds)", fits_logit)]:
    (f, names) = fits["M1_main"]
    t = pd.DataFrame({"term": names, "coef": f.params[names].values, "se": f.bse[names].values,
                      "p": f.pvalues[names].values})
    if est.startswith("LPM"): t["coef"] = 100 * t["coef"]; t["se"] = 100 * t["se"]
    log(f"\n[{est}]  n={int(f.nobs)}"); log(t.round(4).to_string(index=False))

log("\n" + "=" * 78); log("3. FUNCTIONAL FORM - age dummies (ref = 24) with M1 controls")
(f, names) = fits_lpm["M1_age_dummies"]
dum = [c for c in names if c.startswith("A")]
t = pd.DataFrame({"age": [int(c[1:]) for c in dum], "coef_pp": 100 * f.params[dum].values,
                  "se_pp": 100 * f.bse[dum].values, "p": f.pvalues[dum].values})
ci = f.conf_int().loc[dum]
t["ci_lo_pp"] = 100 * ci[0].values; t["ci_hi_pp"] = 100 * ci[1].values
log(t.round(4).to_string(index=False))
R = np.zeros((len(dum), len(names)))
for i, c in enumerate(dum): R[i, names.index(c)] = 1
ft = f.f_test(R)
log(f"\nJoint test all age dummies = 0: F={float(ft.fvalue):.3f}, df={ft.df_num:.0f},{ft.df_denom:.0f}, p={float(ft.pvalue):.3g}")
(fq, nq) = fits_lpm["M1_main"]
ft2 = fq.f_test("AGED2 = 0")
log(f"Test AGE^2 = 0 in M1 (curvature summary): F={float(ft2.fvalue):.3f}, p={float(ft2.pvalue):.3g}")
lin = sm.GLM(df.DISSAVED.astype(float), sm.add_constant(df[["AGED"] + X_ctrl].astype(float)),
             family=sm.families.Binomial()).fit()
dumg = sm.GLM(df.DISSAVED.astype(float), sm.add_constant(df[dum + X_ctrl].astype(float)),
              family=sm.families.Binomial()).fit()
lr = 2 * (dumg.llf - lin.llf); dfree = dumg.df_model - lin.df_model
log(f"LR test: free age dummies vs single linear age term: LR={lr:.3f} on {dfree:.0f} df, "
    f"p={stats.chi2.sf(lr, dfree):.3g}  (tests departure from a straight line)")
(fq2, nq2) = fits_lpm["M1_linear_age"]
ft3 = fq2.f_test("AGED = 0")
log(f"Linear age term alone in M1: F={float(ft3.fvalue):.3f}, p={float(ft3.pvalue):.3g}")
tt = np.array([a - 28 for a in range(25, 33)], float) / 2.58
Rt = np.zeros((1, len(names)))
for i, c in enumerate(dum): Rt[0, names.index(c)] = tt[i]
ftt = f.f_test(Rt)
log(f"Linear-trend contrast of the age dummy coefficients (weights = centred age / 2.58): "
    f"{100*float((Rt @ f.params.values)[0]):.3f} pp, F={float(ftt.fvalue):.3f}, p={float(ftt.pvalue):.3g}"
    "   (the single linear age term in M1 gives the interpretable slope)")
t.round(6).to_csv(os.path.join(HERE, "age_dummies_m1.csv"), index=False)

log("\n" + "=" * 78); log("4. PREDICTED P(DISSAVED) BY AGE (average predictions, LPM)")
me_rows = []
for mn_ in ["RAW_age_only", "M1_main", "M2_plus_BMI", "M1_logincome", "M1_age_dummies"]:
    (f, names) = fits_lpm[mn_]
    core = [c for c in names if c != "const"]
    base = df[core].astype(float).values.copy()
    base = np.column_stack([np.ones(len(base)), base])
    for a in ages:
        Xa = base.copy()
        if "AGED" in names:
            c = a - df.AGE.mean(); Xa[:, names.index("AGED")] = c; Xa[:, names.index("AGED2")] = c ** 2
        for b in ages[1:]:
            if f"A{int(b)}" in names: Xa[:, names.index(f"A{int(b)}")] = float(b == a)
        g = Xa.mean(axis=0)
        p = float(g @ f.params.values); se = float(np.sqrt(g @ f.cov_params().values @ g))
        me_rows.append(dict(model=mn_, age=a, pred_p=p, se=se, lo=p-1.96*se, hi=p+1.96*se))
me = pd.DataFrame(me_rows)
me.round(6).to_csv(os.path.join(HERE, "marginal_effects_by_age.csv"), index=False)
log("Average predicted P(DISSAVED) at each age [pp]:")
log((100 * me.pivot(index="age", columns="model", values="pred_p")).round(2).to_string())

(lg, lnames) = fits_logit["M1_main"]; V = lg.cov_params().values
def logit_pred_probs(a):
    core = [c for c in lnames if c != "const"]
    Xa = df[core].astype(float).copy()
    c = a - df.AGE.mean(); Xa["AGED"] = c; Xa["AGED2"] = c ** 2
    m = sm.add_constant(Xa, has_constant="add")[lnames].values
    p = 1 / (1 + np.exp(-(m @ lg.params.values)))
    return p, (p[:, None] * (1 - p)[:, None] * m).mean(axis=0)
log("\nLogit (M1) predicted P(DISSAVED) by age [pp] vs observed:")
for a in ages:
    p, g = logit_pred_probs(a); s = float(np.sqrt(g @ V @ g)); pm = p.mean()
    log(f"  age {a}: logit {100*pm:6.2f} [{100*(pm-1.96*s):6.2f},{100*(pm+1.96*s):6.2f}]  "
        f"LPM {100*me[(me.model=='M1_main')&(me.age==a)].pred_p.iloc[0]:6.2f}  "
        f"observed {100*desc.loc[desc.AGE==a,'p_dissaved'].iloc[0]:6.2f}")

log("\nMarginal effect of +1 year of age on P(DISSAVED) (LPM M1, delta method):")
(lf, lfn) = fits_lpm["M1_main"]; Vf = lf.cov_params().values
for a in ages:
    c = a - df.AGE.mean(); g = np.zeros(len(lfn))
    g[lfn.index("AGED")] = 1.0; g[lfn.index("AGED2")] = 2 * c
    est = float(g @ lf.params.values); se = float(np.sqrt(g @ Vf @ g))
    log(f"  age {a}: {100*est:7.3f} pp (SE {100*se:6.3f}, p={2*stats.norm.sf(abs(est/se)):.3g})")

log("\n5. CONTRAST 32 vs 24 (percentage points, 95% CI)")
for mn_ in ["RAW_age_only", "M1_main", "M2_plus_BMI", "M1_logincome"]:
    (f, names) = fits_lpm[mn_]; g = np.zeros(len(names))
    if "AGED" in names:
        lo_, hi_ = 24 - df.AGE.mean(), 32 - df.AGE.mean()
        g[names.index("AGED")] = hi_ - lo_; g[names.index("AGED2")] = hi_ ** 2 - lo_ ** 2
    d = float(g @ f.params.values); se = float(np.sqrt(g @ f.cov_params().values @ g))
    log(f"  {mn_:15s} LPM: {100*d:7.3f} pp  CI [{100*(d-1.96*se):7.3f},{100*(d+1.96*se):7.3f}]  p={2*stats.norm.sf(abs(d/se)):.3g}")
p24, g24 = logit_pred_probs(24); p32, g32 = logit_pred_probs(32)
d = p32.mean() - p24.mean(); gc = g32 - g24; se = float(np.sqrt(gc @ V @ gc))
log(f"  M1 logit (predicted prob diff): {100*d:7.3f} pp  CI [{100*(d-1.96*se):7.3f},{100*(d+1.96*se):7.3f}]  p={2*stats.norm.sf(abs(d/se)):.3g}")
(f, names) = fits_lpm["M1_age_dummies"]
d = float(f.params["A32"]); se = float(f.bse["A32"])
log(f"  M1 dummies (A32 coef = 32 vs 24): {100*d:7.3f} pp  CI [{100*(d-1.96*se):7.3f},{100*(d+1.96*se):7.3f}]  p={f.pvalues['A32']:.3g}")
log(f"  Observed raw gap (32 vs 24): {100*(desc.p_dissaved.iloc[-1]-desc.p_dissaved.iloc[0]):7.3f} pp")

pr = sm.Probit(df.DISSAVED.astype(float), sm.add_constant(df[["AGED", "AGED2"] + X_ctrl].astype(float))
               ).fit(disp=0, cov_type="HC1")
log(f"\n6. PROBIT check (M1): AGE={pr.params['AGED']:.4f} (p={pr.pvalues['AGED']:.3g}), "
    f"AGE^2={pr.params['AGED2']:.5f} (p={pr.pvalues['AGED2']:.3g})")
lp_pr = []
for a in ages:
    Xa = df[["AGED", "AGED2"] + X_ctrl].astype(float).copy(); c = a - df.AGE.mean()
    Xa["AGED"] = c; Xa["AGED2"] = c ** 2
    lp_pr.append(float(pr.predict(sm.add_constant(Xa, has_constant="add")).mean()))
log("   probit predicted P by age [pp]: " + ", ".join(f"{int(a)}:{100*p:.2f}" for a, p in zip(ages, lp_pr)))
y_ = df.DISSAVED.astype(float)
ll0 = sm.GLM(y_, np.ones((len(df), 1)), family=sm.families.Binomial()).fit().llf
def pr2(name): return 1 - fits_logit[name][0].llf / ll0
log(f"   goodness of fit: LPM R2: M1={fits_lpm['M1_main'][0].rsquared:.4f}, raw={fits_lpm['RAW_age_only'][0].rsquared:.4f}; "
    f"logit pseudo-R2: M1={pr2('M1_main'):.4f}, raw={pr2('RAW_age_only'):.4f}, dummies={pr2('M1_age_dummies'):.4f}")

log("\n" + "=" * 78); log("7. THREE-STATE VIEW: saved more / same / dissaved")
df["Y3"] = np.where(df.DISSAVED == 1, 2, np.where(df.SAMESAVE == 1, 1, 0))
log("Observed shares by age [pp]:")
obs3 = (df.groupby("AGE")[["DISSAVED", "SAMESAVE"]].mean())
obs3["save_more"] = 1 - obs3.DISSAVED - obs3.SAMESAVE
log((100 * obs3[["save_more", "SAMESAVE", "DISSAVED"]]).round(2).to_string())
Xmn_names = ["AGED", "AGED2"] + X_ctrl
Xmn = sm.add_constant(df[Xmn_names].astype(float), has_constant="add")
mn = sm.MNLogit(df.Y3.astype(float), Xmn).fit(disp=0)
mt = pd.DataFrame(np.asarray(mn.params), index=list(Xmn.columns),
                  columns=["same_vs_savemore", "dissave_vs_savemore"])
mp = pd.DataFrame(np.asarray(mn.pvalues), index=list(Xmn.columns),
                  columns=["same_vs_savemore", "dissave_vs_savemore"])
log("\nMultinomial logit coefficients (ref = saved more):")
log(pd.concat([mt.add_suffix("_b"), mp.add_suffix("_p")], axis=1).loc[Xmn_names].round(4).to_string())
rows3 = []
for a in ages:
    Xa = df[["AGED", "AGED2"] + X_ctrl].astype(float).copy(); c = a - df.AGE.mean()
    Xa["AGED"] = c; Xa["AGED2"] = c ** 2
    ph = np.asarray(mn.predict(sm.add_constant(Xa, has_constant="add")))
    rows3.append(dict(age=int(a), p_save_more=ph[:, 0].mean(), p_same=ph[:, 1].mean(), p_dissave=ph[:, 2].mean()))
mn_tab = pd.DataFrame(rows3)
log("\nMultinomial predicted probabilities by age [pp]:")
log((100 * mn_tab.set_index("age")).round(2).to_string())
mn_tab.round(6).to_csv(os.path.join(HERE, "multinomial_3state_by_age.csv"), index=False)

log("\n" + "=" * 78); log("8. SUMMARY NUMBERS")
(f, names) = fits_lpm["M1_age_dummies"]
g = np.zeros(len(names))
for a in range(30, 33): g[names.index(f"A{a}")] = 1 / 3
for a in range(25, 30): g[names.index(f"A{a}")] = -1 / 5   # A24 is the reference -> -1/5 keeps ref weighting
d = float(g @ f.params.values); se = float(np.sqrt(g @ f.cov_params().values @ g))
log(f"Older block (30-32) vs younger block (24-29), M1 dummies: {100*d:7.3f} pp  "
    f"CI [{100*(d-1.96*se):7.3f},{100*(d+1.96*se):7.3f}]  p={2*stats.norm.sf(abs(d/se)):.3g}")
fm = fits_lpm["M1_main"][0]
pp = me[me.model == "M1_main"].set_index("age")["pred_p"]
p24, p32 = pp.loc[24], pp.loc[32]
log(f"Fitted M1 (average prediction, all controls at sample mix): {100*p24:.2f}% at 24 -> {100*p32:.2f}% at 32; "
    f"absolute {100*(p32-p24):.2f} pp, relative {100*(p32-p24)/p24:.1f}% "
    f"(observed: {100*desc.p_dissaved.iloc[0]:.2f}% -> {100*desc.p_dissaved.iloc[-1]:.2f}%)")
log(f"Turning point of the fitted quadratic: age = {df.AGE.mean() - fm.params['AGED']/(2*fm.params['AGED2']):.2f} "
    "(outside/at the edge of the observed 24-32 window -> no interior hump supported)")
dum_p = np.array([desc.loc[desc.AGE == a, "p_dissaved"].iloc[0] for a in ages])
log("Observed rates by age [pp]: " + ", ".join(f"{int(a)}:{100*p:.2f}" for a, p in zip(ages, dum_p)))
log(f"Spearman rank corr between age and observed dissave rate: {stats.spearmanr(ages, dum_p).statistic:.3f} "
    f"(p={stats.spearmanr(ages, dum_p).pvalue:.3g})")

# ---------------------------------------------------------------- figure (SVG)
W, H, ml, mr, mt_, mb = 780, 470, 75, 30, 55, 60
x0, x1, y0, y1 = 23.5, 32.5, 0.14, 0.29
Xv = lambda a: ml + (a - x0) / (x1 - x0) * (W - ml - mr)
Yv = lambda p: H - mb - (p - y0) / (y1 - y0) * (H - mt_ - mb)
sv = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="sans-serif" font-size="13">',
      f'<rect width="{W}" height="{H}" fill="white"/>',
      f'<text x="{W/2}" y="24" text-anchor="middle" font-size="15" font-weight="bold">Age vs probability of withdrawing more from savings than put in (NLSY79, 1989)</text>']
for a in range(24, 33):
    sv.append(f'<line x1="{Xv(a):.1f}" y1="{Yv(y0):.1f}" x2="{Xv(a):.1f}" y2="{Yv(y1):.1f}" stroke="#eee"/>')
    sv.append(f'<text x="{Xv(a):.1f}" y="{H-mb+18:.1f}" text-anchor="middle">{a}</text>')
for p in np.arange(0.15, 0.29, 0.025):
    sv.append(f'<line x1="{ml}" y1="{Yv(p):.1f}" x2="{W-mr}" y2="{Yv(p):.1f}" stroke="#eee"/>')
    sv.append(f'<text x="{ml-8}" y="{Yv(p)+4:.1f}" text-anchor="end">{100*p:.1f}</text>')
sv.append(f'<line x1="{ml}" y1="{Yv(y0):.1f}" x2="{W-mr}" y2="{Yv(y0):.1f}" stroke="#333"/>')
sv.append(f'<line x1="{ml}" y1="{Yv(y0):.1f}" x2="{ml}" y2="{Yv(y1):.1f}" stroke="#333"/>')
sv.append(f'<text x="{(ml+W-mr)/2:.0f}" y="{H-14}" text-anchor="middle">Age in 1989 (years)</text>')
sv.append(f'<text x="20" y="{H/2:.0f}" text-anchor="middle" transform="rotate(-90 20 {H/2:.0f})">P(DISSAVED = 1), percent</text>')
for a in ages:
    p = desc.loc[desc.AGE == a, "p_dissaved"].iloc[0]; n = desc.loc[desc.AGE == a, "n"].iloc[0]
    se = np.sqrt(p * (1 - p) / n)
    sv.append(f'<line x1="{Xv(a):.1f}" y1="{Yv(p-1.96*se):.1f}" x2="{Xv(a):.1f}" y2="{Yv(p+1.96*se):.1f}" stroke="#555" stroke-width="1.5"/>')
    sv.append(f'<circle cx="{Xv(a):.1f}" cy="{Yv(p):.1f}" r="4.5" fill="#444"/>')
def path(vals, color, dash=""):
    pts = " ".join(f"{Xv(a):.1f},{Yv(v):.1f}" for a, v in zip(ages, vals))
    return f'<polyline points="{pts}" fill="none" stroke="{color}" stroke-width="2.5" {dash}/>'
m1c = me[me.model == "M1_main"].set_index("age")["pred_p"]
rawc = me[me.model == "RAW_age_only"].set_index("age")["pred_p"]
sv.append(path([m1c.loc[a] for a in ages], "#c0392b"))
sv.append(path([rawc.loc[a] for a in ages], "#2980b9", 'stroke-dasharray="6,4"'))
for i, (c, lab) in enumerate([("#444", "Observed rate by age (95% CI)"),
                              ("#c0392b", "Fitted M1: age + age^2 + income + gender + race"),
                              ("#2980b9", "Fitted age only (crude reference)")]):
    yy = mt_ + 8 + i * 18
    sv.append(f'<line x1="{W-370}" y1="{yy}" x2="{W-340}" y2="{yy}" stroke="{c}" stroke-width="2.5"/>')
    sv.append(f'<text x="{W-335}" y="{yy+4}">{lab}</text>')
sv.append("</svg>")
open(os.path.join(HERE, "age_probability_figure.svg"), "w").write("\n".join(sv))
log("\nFigure written: analysis/age_probability_figure.svg")
open(os.path.join(HERE, "results_log.txt"), "w").write("\n".join(log_lines) + "\n")
print("\n[log saved]")
