import json, numpy as np, pandas as pd
from scipy import stats
from scipy.optimize import minimize
from scipy.signal import lombscargle

J=json.load(open('data/input_0.json')); CASES=J['case_order']
d1=pd.read_csv('data/input_1.csv')
d2_raw=[l.strip() for l in open('data/input_2.csv').read().splitlines() if l.strip()][1:]
d2=pd.read_csv('data/input_2.csv')

def bas(t,P,h=1):
    ph=2*np.pi*h*t/P; return np.column_stack([np.sin(ph),np.cos(ph)])
def design(t,PA,PB): return np.column_stack([np.ones_like(t),bas(t,PA),bas(t,PB),bas(t,PB,2)])
def design_B(t,PB): return np.column_stack([np.ones_like(t),bas(t,PB),bas(t,PB,2)])
def design_flex(t,P1,PB): return np.column_stack([np.ones_like(t),bas(t,P1),bas(t,PB),bas(t,PB,2)])

class CaseFit:
    def __init__(s,cid,t,y,e):
        s.t,s.y,s.e=t,y,e; s.w=1/e; s.n=len(t); s.T=t.max()-t.min(); s.Ray=1/s.T
    def solve(s,X):
        Xw=X*s.w[:,None]; yw=s.y*s.w
        c,_,_,_=np.linalg.lstsq(Xw,yw,rcond=None)
        r=yw-Xw@c
        try: cond=np.linalg.cond(Xw)
        except np.linalg.LinAlgError: cond=np.inf
        return c,r@r,Xw,cond
    def rss(s,PA,PB):
        if PA<=2 or PB<=2: return 1e30
        c,rs,_,cd=s.solve(design(s.t,PA,PB))
        return 1e30 if cd>1e6 else rs
    def rssB(s,PB):
        if PB<=2: return 1e30
        c,rs,_,cd=s.solve(design_B(s.t,PB))
        return 1e30 if cd>1e6 else rs
    def rss_flex(s,P1,PB):
        if P1<=2 or PB<=2: return 1e30
        c,rs,_,cd=s.solve(design_flex(s.t,P1,PB))
        return 1e30 if cd>1e6 else rs
    def coarse(s,nA=300,nB=300):
        PAS=np.exp(np.linspace(np.log(3),np.log(0.85*s.T),nA))
        PBS=np.exp(np.linspace(np.log(3),np.log(0.85*s.T),nB))
        M=np.array([[s.rss(a,b) for b in PBS] for a in PAS]); return PAS,PBS,M
    def candidates(s,PAS,PBS,M,K=12):
        fA,fB=1/PAS,1/PBS; cands=[]
        for k in np.argsort(M,axis=None):
            i,j=np.unravel_index(k,M.shape)
            if all(abs(fA[i]-1/a)>1.5*s.Ray and abs(fB[j]-1/b)>1.5*s.Ray for a,b,_ in cands):
                cands.append((PAS[i],PBS[j],M[i,j]))
            if len(cands)>=K: break
        return cands
    def refine(s,PA0,PB0,flex=False):
        f=(s.rss_flex if flex else s.rss)
        for _ in range(3):
            best=(1e30,PA0,PB0)
            for a_ in np.exp(np.linspace(np.log(PA0)-.05,np.log(PA0)+.05,15)):
                for b_ in np.exp(np.linspace(np.log(PB0)-.05,np.log(PB0)+.05,15)):
                    v=f(a_,b_)
                    if v<best[0]: best=(v,a_,b_)
            _,PA0,PB0=best
        r=minimize(lambda v:f(np.exp(v[0]),np.exp(v[1])),[np.log(PA0),np.log(PB0)],
                   method='Nelder-Mead',options=dict(xatol=1e-8,fatol=1e-10,maxiter=6000))
        return np.exp(r.x[0]),np.exp(r.x[1]),r.fun
    def vertex(s,PA,PB,flex=False):
        f=(s.rss_flex if flex else s.rss)
        for axis in range(2):
            dP=(PA if axis==0 else PB)*1e-4
            for it in range(10):
                P0=PA if axis==0 else PB
                g=np.linspace(P0-dP,P0+dP,41)
                rs=np.array([f(p,PB) if axis==0 else f(PA,p) for p in g]); i=int(np.argmin(rs))
                if i in (0,len(g)-1): dP*=2; continue
                y0,y1,y2=rs[i-1],rs[i],rs[i+1]; dd=y0-2*y1+y2
                v=g[i]-.5*(y2-y0)/dd*(g[1]-g[0]) if dd>0 else g[i]
                if axis==0: PA=v
                else: PB=v
                dP=abs(v-P0)*3+1e-6
        return PA,PB
    def dP(s,P1,PB,rss_min,s2,flex=False,idx=0):
        f=(s.rss_flex if flex else s.rss)
        g=np.linspace(P1*0.97,P1*1.03,1201)
        rs=np.array([ (f(p,PB) if idx==0 else f(P1,p)) for p in g])
        i=int(np.argmin(rs)); thr=rs[i]+s2
        lo=rs[:i][::-1]; hi=rs[i+1:]
        dl=next((k for k,v in enumerate(lo) if v>thr),len(lo))
        dh=next((k for k,v in enumerate(hi) if v>thr),len(hi))
        step=g[1]-g[0]
        return max(dl*step,dh*step)  # conservative: half-width to first crossing beyond 1-sigma

rows,prows,diag=[],[],[]
for cid in CASES:
    g=d1[d1.case_id==cid]; t=g.time_day.values; y=g.obs_0.values; e=g.obs_0_err.values
    Fi=CaseFit(cid,t,y,e); n=Fi.n
    PAS,PBS,M=Fi.coarse(); cands=Fi.candidates(PAS,PBS,M,12)
    refined=[]
    for (a,b,_) in cands:
        a2,b2,rr=Fi.refine(a,b); refined.append((rr,a2,b2))
    refined.sort(); r_ab,PA,PB=min(refined)
    PA,PB=Fi.vertex(PA,PB); r_ab=min(Fi.rss(PA,PB),r_ab)
    c_ab,rss_ab,Xw,cond=Fi.solve(design(t,PA,PB)); p_ab=7
    s2=rss_ab/(n-p_ab); cov=s2*np.linalg.inv(Xw.T@Xw); sd=np.sqrt(np.diag(cov))
    a1,a2=c_ab[1],c_ab[2]; A_hat=np.hypot(a1,a2)
    sA_cent=np.sqrt((a1**2*sd[1]**2+a2**2*sd[2]**2))/A_hat if A_hat>0 else np.hypot(*sd[1:3])
    # contract H0: no-A model (offset + B fundamental + exact first harmonic), PB profiled
    Pb_ref=min(PBS,key=Fi.rssB)
    rr=minimize(lambda v:Fi.rssB(np.exp(v[0])),[np.log(Pb_ref)],method='Nelder-Mead',
                options=dict(xatol=1e-8,fatol=1e-10))
    Pb_ref=np.exp(rr.x[0]); rss_fl=Fi.rssB(Pb_ref); del Pb_ref
    Fs=((rss_fl-rss_ab)/2)/(rss_ab/(n-p_ab)); pval=stats.f.sf(Fs,2,n-p_ab)
    dbic=(n*np.log(rss_fl/n)+6*np.log(n))-(n*np.log(rss_ab/n)+p_ab*np.log(n))
    present=int(pval<1e-4 and A_hat/sA_cent>=6 and dbic>10)
    # swap & inversion tests
    rss_swap=Fi.rss(PB,PA); rss_inv=Fi.rss(PA,2*PB) if False else Fi.rss(2*PB,PA)
    # alias check for PA: 1/(fA+-1)
    fA=1/PA
    al=[fA+1.0]+([fA-1.0] if fA>1.0 else [])+[fA-1/365.25,fA+1/365.25]
    rss_alias=min([Fi.rss(1/af,PB) for af in al if af>1/300.0])
    dPA=Fi.dP(PA,PB,rss_ab,s2); dPB=Fi.dP(PB,PA,rss_ab,s2,idx=1)
    tmax=float(d2[d2.case_id==cid].time_day.max()); drift=tmax*dPA/PA**2
    rw=y-design(t,PA,PB)@c_ab
    fr=np.linspace(1/(2.5*Fi.T),2.0,20000)
    Pw=lombscargle(t,rw,2*np.pi*fr,precenter=True,normalize=True); k=int(np.argmax(Pw))
    Ares=np.hypot(*np.linalg.lstsq(bas(t,1/fr[k]),rw,rcond=None)[0])
    snr_res=Ares*np.sqrt(n/2)/rw.std(); rmsr=np.sqrt((rw**2).mean())/np.sqrt((e**2).mean())
    sepR_AB=abs(1/PA-1/PB)*Fi.T; sepR_A2B=abs(1/PA-2/PB)*Fi.T
    B1=np.hypot(c_ab[3],c_ab[4]); B2=np.hypot(c_ab[5],c_ab[6])
    rows.append(dict(case_id=cid,component_a_present=present,
        component_a_period_day=(PA if present else 0.0),
        component_a_basis1_u0=(a1 if present else 0.0),
        component_a_basis2_u0=(a2 if present else 0.0),
        component_b_period_day=PB,component_b_basis1_u0=c_ab[3],component_b_basis2_u0=c_ab[4],
        component_b_basis3_u0=c_ab[5],component_b_basis4_u0=c_ab[6],offset_u0=c_ab[0]))
    for line in d2_raw:
        c_,t_=line.split(',')
        if c_!=cid: continue
        v=a1*np.sin(2*np.pi*float(t_)/PA)+a2*np.cos(2*np.pi*float(t_)/PA) if present else 0.0
        prows.append(dict(case_id=c_,time_day=t_,component_a_value_u0=v))
    diag.append(dict(cid=cid,PA=PA,PB=PB,dPA=dPA,dPB=dPB,drift=drift,A=A_hat,sA=sA_cent,
        snr=A_hat/sA_cent,F=Fs,p=pval,dbic=dbic,pres=present,rmsr=rmsr,rss_ab=rss_ab,
        rss_fl=rss_fl,rss_sw=rss_swap,rss_inv=rss_inv,dchi2_sw=(rss_swap-rss_ab)/s2,
        dchi2_inv=(rss_inv-rss_ab)/s2,dchi2_ali=(rss_alias-rss_ab)/s2,res_snr=snr_res,res_P=1/fr[k],
        B1=B1,B2=B2,sep_AB=sepR_AB,sep_A2B=sepR_A2B,cond=cond,
        top3=[(round(r,1),round(a,3),round(b,3)) for r,a,b in refined[:3]]))

ss=pd.DataFrame(rows)[['case_id','component_a_present','component_a_period_day',
    'component_a_basis1_u0','component_a_basis2_u0','component_b_period_day',
    'component_b_basis1_u0','component_b_basis2_u0','component_b_basis3_u0',
    'component_b_basis4_u0','offset_u0']]
tp=pd.DataFrame(prows)
for df in (ss,tp): assert np.isfinite(df.select_dtypes('number').values).all()
assert list(ss.case_id)==CASES and len(ss)==4 and len(tp)==len(d2_raw)
hdr2=[l.split(',') for l in [d2_raw[0]]]
for r,(line,row) in enumerate(zip(d2_raw,tp.itertuples())):
    c_,t_=line.split(','); assert row.case_id==c_ and row.time_day==t_
ss.to_csv('signal_summary.csv',index=False,float_format='%.10g')
tp.to_csv('target_predictions.csv',index=False,float_format='%.10g')

for d in diag:
    print(f"{d['cid']}: PA={d['PA']:.4f}+-{d['dPA']:.4f}  PB={d['PB']:.4f}+-{d['dPB']:.4f}  drift@tmax={d['drift']:.3f} cyc")
    print(f"   A={d['A']:.3f}+-{d['sA']:.3f}(SNR {d['snr']:.1f})  B1={d['B1']:.2f} B2={d['B2']:.2f}  cond={d['cond']:.1f}")
    print(f"   vs flexible-B: RSSfl={d['rss_fl']:.1f} RSSab={d['rss_ab']:.1f} F={d['F']:.1f} p={d['p']:.1e} dBIC={d['dbic']:.1f} -> present={d['pres']}")
    print(f"   swap RSS={d['rss_sw']:.1f}(dX2={d['dchi2_sw']:.0f})  inversion PA,2PB-> RSS={d['rss_inv']:.1f}(dX2={d['dchi2_inv']:.0f})  1d-alias dX2={d['dchi2_ali']:.0f}")
    print(f"   resid: rms/sig={d['rmsr']:.3f} peakSNR={d['res_snr']:.2f}@{d['res_P']:.2f}d  sepA-B={d['sep_AB']:.2f}R sepA-2B={d['sep_A2B']:.2f}R")
    print(f"   refined top3 (RSS,PA,PB): {d['top3']}")
print(); print(ss.to_string(index=False)); print("pred rows:",len(tp))
