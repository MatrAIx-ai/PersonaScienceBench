def bar_panel(x0, y0, x1, y1, series, colors, title, labels):
    vals = np.concatenate([s for s in series] + [np.zeros(1)])
    lo, m = nice_ticks(min(vals.min(), 0.0), max(vals.max(), 0.0))
    hi = math.ceil(vals.max() / m) * m; hi = max(hi, m)
    def Y(v): return y1 - (v - lo) / (hi - lo) * (y1 - y0)
    t = lo
    while t <= hi + 1e-9:
        rect(x0, Y(t), x1, Y(t), (228, 228, 228)); text(x0 - 62, Y(t) - 6, fmt_tick(t, m), scale=1)
        t += m
    rect(x0, Y(0) - 1, x1, Y(0) + 1, (90, 90, 90))
    n = len(labels); k = len(series)
    slot = (x1 - x0) / n; bw = slot * 0.72 / k
    for i in range(n):
        cx = x0 + slot * (i + 0.5)
        for s_i, ser in enumerate(series):
            bx = cx - slot * 0.36 + bw * s_i
            rect(bx + 1, Y(ser[i]), bx + bw - 1, Y(0), colors[s_i])
        text(cx - 10, y1 + 6, labels[i], scale=1)
    text(x0 + 20, y0 - 28, title, scale=2)

