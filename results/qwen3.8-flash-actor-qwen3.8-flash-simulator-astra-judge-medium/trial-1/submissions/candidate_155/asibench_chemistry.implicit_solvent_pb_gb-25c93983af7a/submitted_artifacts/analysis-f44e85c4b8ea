def cmap(a):
    tv = np.clip(a / vmax, -1, 1)
    base = np.array([235.0, 235.0, 245.0])
    tgt = np.where(tv[..., None] < 0, np.array([40.0, 70.0, 210.0]),
                   np.array([210.0, 45.0, 30.0]))
    c = base + (tgt - base) * np.abs(tv)[..., None]
    return np.clip(c, 0, 255).astype(np.uint8)
