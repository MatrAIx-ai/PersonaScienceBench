def rect(x0, y0, x1, y1, color, fill=True):
    x0, x1 = sorted((int(x0), int(x1))); y0, y1 = sorted((int(y0), int(y1)))
    x0, x1 = max(x0, 0), min(x1, W-1); y0, y1 = max(y0, 0), min(y1, H-1)
    if fill: img[y0:y1+1, x0:x1+1] = color
    else:
        img[y0, x0:x1+1] = color; img[y1, x0:x1+1] = color
        img[y0:y1+1, x0] = color; img[y0:y1+1, x1] = color
def text(x, y, s, color=(20, 20, 20), scale=2):
    x = int(x); y = int(y)
    for ch in str(s).upper():
        g = FONT.get(ch, FONT['?']).split()
        for ri, row in enumerate(g):
            for c_i, bit in enumerate(row):
                if bit == '1':
                    img[y+ri*scale:y+(ri+1)*scale, x+c_i*scale:x+(c_i+1)*scale] = color
        x += 6 * scale
def nice_ticks(vmin, vmax, n=5):
    span = max(vmax - vmin, 1e-9); raw = span / n
    mag = 10 ** math.floor(math.log10(raw))
    m = 10 * mag
    for cand in (mag, 2*mag, 5*mag, 10*mag):
        if span / cand <= n + 0.5:
            m = cand; break
    lo = math.floor(vmin / m) * m
    return lo, m
def fmt(v):
    s = f"{v:.10g}"
    return s

def fmt_tick(v, m):
    dec = max(0, -int(math.floor(math.log10(m))) ) if m < 1 else 0
    return f"{v:.{dec}f}"

