        s = " ".join(str(x) for x in a)
        print(s)
        log.append(s)

    def perr(*a):
        s = " ".join(str(x) for x in a)
        print(s, file=sys.stderr)
        log.append("[stderr] " + s)

    pars_in = json.load(open(f"{DATA_DIR}/leaf_params.json"))
    df = pd.read_csv(f"{DATA_DIR}/forcing.csv")
    cases = json.load(open(f"{DATA_DIR}/test_cases.json"))
    pars = dict(vcmax25=float(pars_in["vcmax25"]), m=float(pars_in["bb_slope"]),
                b0=float(pars_in["bb_intercept"]), alpha_q=float(pars_in["alpha_q"]),
                n_factor=float(pars_in.get("n_factor", 1.0)))
    branch = pars_in.get("pathway", "C4").upper()
    p("=" * 72)
    p("RUN CONFIG: pathway=%s (C3 branch implemented but NOT exercised: no C3"
      % branch)
    p("parameter set exists in leaf_params.json; sun & shade both use C4).")
    p("vcmax25=%.4f  m=%.3f  b0=%.3f  alpha_q=%.3f  n_factor=%.3f"
      % (pars["vcmax25"], pars["m"], pars["b0"], pars["alpha_q"],
         pars["n_factor"]))
    p("=" * 72)

    n = len(df)
    nonconv, fallback = [], []
    diag_sun12, diag_shade12, diag_night = {}, {}, {}

    for i in range(n):
        row = df.iloc[i].to_dict()
        for side, parcol, diag in (("sun", "par_sun_wm2", None),
                                   ("shade", "par_shade_wm2", None)):
            par = float(row[parcol])
            ci0 = 0.5 * row["co2_pa"]
            d = {} if (i in (0, 12)) else None
            out = solve_leaf_row(row, pars, par, ci0, branch=branch,
                                 diagnostics=d)
            STORE[side][i] = out
            if not out["ok"]:
                nonconv.append((i, side))
            if "brentq" in out["method"]:
                fallback.append((i, side, out["method"]))
            if d is not None:
                if i == 12:
                    (diag_sun12 if side == "sun" else diag_shade12).update(
                        dict(out=out, **d))
                elif i == 0:
                    diag_night[side] = dict(out=out, **d)

    # ---- leaf_fluxes.csv ----
    flux = pd.DataFrame({
        "time_hr": df["time_hr"].values,
        "A_sun": [s["A"] for s in STORE["sun"]],
        "A_shade": [s["A"] for s in STORE["shade"]],
        "rs_sun": [s["rs"] for s in STORE["sun"]],
        "rs_shade": [s["rs"] for s in STORE["shade"]],
        "ci_sun": [s["ci"] for s in STORE["sun"]],
        "ci_shade": [s["ci"] for s in STORE["shade"]],
        "gs_sun": [s["gs"] for s in STORE["sun"]],
        "gs_shade": [s["gs"] for s in STORE["shade"]],
    })
    flux.to_csv(f"{RES_DIR}/leaf_fluxes.csv", index=False)

    # ---- case_convergence.csv (same routine, sun PAR, given ci_init) ----
    crows, shade_alt, case_ends = [], [], []
    for c in cases:
        i = int(c["forcing_index"])
        row = df.iloc[i].to_dict()
        d = {}
        out = solve_leaf_row(row, pars, float(row["par_sun_wm2"]),
                             c["ci_init_pa"], branch=branch, diagnostics=d)
        crows.append(dict(case_id=c["case_id"], ci_init_pa=c["ci_init_pa"],
                          ci_final_pa=out["ci"], A_final=out["A"],
                          rs_final=out["rs"], n_iterations=out["n_iter"]))
        case_ends.append(out["ci"])
        if "brentq" in out["method"]:
            p("case %s used fallback: %s" % (c["case_id"], out["method"]))
        alt = solve_leaf_row(row, pars, float(row["par_shade_wm2"]),
                             c["ci_init_pa"], branch=branch)
        shade_alt.append((c["case_id"], out["ci"], out["A"], out["rs"],
                          alt["ci"], alt["A"], alt["rs"]))
    pd.DataFrame(crows).to_csv(f"{RES_DIR}/case_convergence.csv", index=False)

    perr("=" * 72)
    perr("SENSITIVITY of case results to the sun-vs-shade leaf-type")
    perr("assumption (shade column is diagnostic only, NOT a deliverable):")
    perr("%-9s | %-28s | %s" % ("case", "SUN: ci / A / rs", "SHADE: ci / A / rs"))
    for cid, ci, A, rs, aci, aA, ars in shade_alt:
        perr("%-9s | %8.3f %8.2f %8.2f | %8.3f %8.2f %8.2f"
             % (cid, ci, A, rs, aci, aA, ars))
    spread = max(case_ends) - min(case_ends)
    p("Case-endpoint consistency across ci_init = 0.1..1.1 x ca:")
    p("  ci_final values:", np.round(case_ends, 6).tolist())
    p("  max pairwise spread = %.3e Pa (expect ~0 -> unique fixed point)"
      % spread)

    # ---- diurnal.png ----
    cv, have_mpl = make_figure(df["time_hr"].values, STORE["sun"],
                               STORE["shade"], f"{RES_DIR}/diurnal.png")
    p("matplotlib available: %s -> used built-in numpy/zlib PNG renderer"
      % have_mpl)
    rep = verify_png(f"{RES_DIR}/diurnal.png")
    p("PNG verification:", {k: rep[k] for k in
                            ("bytes", "sig", "crc_all_ok", "width", "height",
                             "bit_depth", "color_type", "nonwhite_pixels",
                             "pixels_ok", "filters_ok")})
    p("PNG chunks:", rep["chunks"])

    # ---------------- self-checks / run log ------------------------------
    p("=" * 72)
    p("CONVERGENCE: %d rows x 2 leaf types = %d daytime+night solves"
      % (n, 2 * n))
    day = df["par_sun_wm2"].values > NIGHT_PAR_THRESHOLD
    fp_all = ([s["n_iter"] for s in STORE["sun"]]
              + [s["n_iter"] for s in STORE["shade"]])
    p("  day rows=%d night rows=%d ; fixed-point iters (day): min=%d max=%d"
      % (int(day.sum()), int((~day).sum()),
         min([s['n_iter'] for s, d2 in zip(STORE['sun'], day) if d2]
             + [s['n_iter'] for s, d2 in zip(STORE['shade'], day) if d2]) if day.any() else 0,
         max(fp_all)))
    p("  non-converged solves: %d %s" % (len(nonconv), nonconv))
    p("  brentq fallback used: %d %s" % (len(fallback), fallback))
    for col in ("A_sun", "A_shade", "rs_sun", "rs_shade", "gs_sun",
                "gs_shade", "ci_sun", "ci_shade"):
        v = flux[col].values
        p("  %-9s min=%12.4f @hr %5.1f   max=%12.4f @hr %5.1f"
          % (col, v.min(), df['time_hr'].values[int(np.argmin(v))],
             v.max(), df['time_hr'].values[int(np.argmax(v))]))
    # validity checks
    viol = []
    for side in ("sun", "shade"):
        for i in range(n):
            s = STORE[side][i]
            if not (s["gs"] > 0 and s["rs"] > 0 and abs(s["A"]) < 1e4):
                viol.append((i, side, "positivity/bound", s["gs"], s["rs"], s["A"]))
            if not s["night"]:
                if s["A"] > 0 and not (0 < s["ci"] < s["cs"]):
                    viol.append((i, side, "ci out of (0,cs) day", s["ci"], s["cs"], s["A"]))
            else:
                if not (s["ci"] > s["cs"]):
                    viol.append((i, side, "night ci<=cs", s["ci"], s["cs"], s["A"]))
    p("  validity violations (gs>0, rs>0, |A|<1e4, ci placement): %d %s"
      % (len(viol), viol[:5]))
    # active-limitation census at ca=64 Pa, sun and shade separately,
    # plus quantitative limitation margins and the Wj-vs-convention assertion
    gs_near_b0 = 0
    margin_records = []
    wj_assert_viol = 0
    wj_assert_checked = 0
    for side in ("sun", "shade"):
        cens = {"Wc": 0, "Wj": 0, "We": 0}
        min_wj_wc = (np.inf, None)
        min_we_wc = (np.inf, None)
        for i in range(n):
            s = STORE[side][i]
            if s["night"]:
                continue
            par = float(df["par_sun_wm2" if side == "sun"
                            else "par_shade_wm2"].iloc[i])
            # explicit assertion (researcher requirement): for every par>0
            # row, Wj == alpha_q * 4.6 * par within 1e-9 relative tolerance
            wj_ref = pars["alpha_q"] * APAR_FACTOR * par
            wj_assert_checked += 1
            if abs(s["Wj"] - wj_ref) > 1e-9 * abs(wj_ref):
                wj_assert_viol += 1
                p("  WJ ASSERTION VIOLATION row %d %s: Wj=%.12g ref=%.12g"
                  % (i, side, s["Wj"], wj_ref))
            k = min(("Wc", s["Wc"]), ("Wj", s["Wj"]), ("We", s["We"]),
                    key=lambda t: t[1])
            cens[k[0]] += 1
            rwj, rwe = s["Wj"] / s["Wc"], s["We"] / s["Wc"]
            if rwj < min_wj_wc[0]:
                min_wj_wc = (rwj, i)
            if rwe < min_we_wc[0]:
                min_we_wc = (rwe, i)
            if s["gs"] < 1.2 * pars["b0"]:
                gs_near_b0 += 1
            margin_records.append((side, i, rwj, rwe))
        p("  active-limitation census [%5s]: %s" % (side, cens))
        p("  min(Wj/Wc) [%s] = %.3f at hr=%s ; min(We/Wc) [%s] = %.3f at hr=%s"
          % (side, min_wj_wc[0], df["time_hr"].iloc[min_wj_wc[1]],
             side, min_we_wc[0], df["time_hr"].iloc[min_we_wc[1]]))
        for sd, i, rwj, rwe in margin_records:
            if sd == side and rwj < 1.5:
                p("  WARNING: %s row hr=%s Wj/Wc=%.3f < 1.5 (sensitive to "
                  "Wj factor)" % (side, df["time_hr"].iloc[i], rwj))
    p("  Wj==alpha_q*4.6*par assertion: %d/%d day solves PASS (%d violations)"
      % (wj_assert_checked - wj_assert_viol, wj_assert_checked,
         wj_assert_viol))
    p("  gs<1.2*b0 count:", gs_near_b0)

    def dump(tag, d):
        o, e = d["out"], d
        p("  %s: Vcmax(T)=%.4f APAR=%.2f Rd=%.4f hs=%.4f esat=%.1f cf=%.3f"
          % (tag, e["vcmax_t"], e["apar"], e["rd"], e["hs"], e["esat"], e["cf"]))
        if e.get("W") is not None:
            p("     Wc=%.4f Wj=%.4f We=%.4f -> A=%.4f" % (*e["W"], o["A"]))
        p("     cs=%.4f gs=%.6f rs=%.3f ci=%.4f  (method=%s, iters=%d)"
          % (o["cs"], o["gs"], o["rs"], o["ci"], o["method"], o["n_iter"]))

    p("FULL INTERMEDIATES (for formula-by-formula review):")
    dump("DAY row time_hr=12 SUN  ", diag_sun12)
    dump("DAY row time_hr=12 SHADE", diag_shade12)
    dump("NIGHT row time_hr=0 SUN ", diag_night["sun"])

    with open(f"{RES_DIR}/run_log.txt", "w") as f:
        f.write("\n".join(log) + "\n")
    print("done")


if __name__ == "__main__":
