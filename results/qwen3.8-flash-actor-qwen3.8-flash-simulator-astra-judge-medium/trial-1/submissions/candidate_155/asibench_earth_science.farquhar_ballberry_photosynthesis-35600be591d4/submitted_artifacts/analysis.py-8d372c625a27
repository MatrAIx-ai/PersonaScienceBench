class Canvas:
    def __init__(self, w, h):
        self.px = np.full((h, w, 3), 255, dtype=np.uint8)

    def point(self, x, y, rgb):
        h, w, _ = self.px.shape
        if 0 <= x < w and 0 <= y < h:
            self.px[y, x] = rgb

    def hline(self, x0, x1, y, rgb):
        self.px[y, min(x0, x1):max(x0, x1) + 1] = rgb

    def vline(self, x, y0, y1, rgb):
        self.px[min(y0, y1):max(y0, y1) + 1, x] = rgb

    def line(self, x0, y0, x1, y1, rgb, width=2):
        x0, y0, x1, y1 = float(x0), float(y0), float(x1), float(y1)
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for i in range(n + 1):
            t = i / n
            x = int(round(x0 + (x1 - x0) * t))
            y = int(round(y0 + (y1 - y0) * t))
            for dx in range(width):
                for dy in range(width):
                    self.point(x + dx, y + dy, rgb)

    def text(self, x, y, s, rgb=(0, 0, 0), scale=1):
        cx = x
        for ch in s.upper():
            g = _FONT.get(ch, _FONT[' '])
            for r, row in enumerate(g):
                for c, bit in enumerate(row):
                    if bit == '1':
                        self.px[y + r * scale:y + (r + 1) * scale,
                                cx + c * scale:cx + (c + 1) * scale] = rgb
            cx += 6 * scale
        return cx

    def text_w(self, s, scale=1):
        return len(s) * 6 * scale

    def save_png(self, path):
        h, w, _ = self.px.shape
        raw = bytearray()
        for y in range(h):
            raw.append(0)                       # filter type 0 (None)
            raw.extend(self.px[y].tobytes())
        comp = zlib.compress(bytes(raw), 9)

        def chunk(tag, data):
            return (struct.pack('>I', len(data)) + tag + data
                    + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff))
        ihdr = struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)
        with open(path, 'wb') as f:
            f.write(b'\x89PNG\r\n\x1a\n')
            f.write(chunk(b'IHDR', ihdr))
            f.write(chunk(b'IDAT', comp))
            f.write(chunk(b'IEND', b''))


def nice_ticks(vmin, vmax, n=5):
    if vmax - vmin <= 0:
        vmax = vmin + 1.0
    span = vmax - vmin
    step = 10.0 ** math.floor(math.log10(span / max(n - 1, 1)))
    for mult in (1, 2, 2.5, 5, 10):
        if span / (step * mult) <= n - 1:
            step *= mult
            break
    start = math.ceil(vmin / step) * step
    ticks = []
    t = start
    while t <= vmax + 1e-9:
        ticks.append(t)
        t += step
    return ticks


def fmt(v):
    if abs(v) >= 1000:
        return "%.0f" % v
    if abs(v) >= 10:
        return "%.0f" % v
    if abs(v) >= 1:
        return "%.1f" % v
    return "%.2f" % v


def draw_panel(cv, x0, y0, x1, y1, xs, series, ylabel, title):
    """series: list of (name, ys, rgb). Draws axes, ticks, curves, legend."""
    black = (0, 0, 0)
    cv.hline(x0, x1, y0, black)
    cv.hline(x0, x1, y1, black)
    cv.vline(x0, y0, y1, black)
    cv.vline(x1, y0, y1, black)
    ymin = min(min(s[1]) for s in series)
    ymax = max(max(s[1]) for s in series)
    pad = 0.05 * (ymax - ymin + 1e-9)
    ymin, ymax = ymin - pad, ymax + pad
    xmn, xmx = float(min(xs)), float(max(xs))

    def tx(x):
        return int(round(x0 + (x - xmn) / (xmx - xmn) * (x1 - x0)))

    def ty(v):
        return int(round(y1 - (v - ymin) / (ymax - ymin) * (y1 - y0)))

    for v in nice_ticks(ymin, ymax, 6):
        yy = ty(v)
        cv.hline(x0 - 4, x0, yy, black)
        cv.text(x0 - 6 - cv.text_w(fmt(v), 1), yy - 3, fmt(v), black, 1)
    for xv in nice_ticks(xmn, xmx, 7):
        if xv < xmn or xv > xmx:
            continue
        xx = tx(xv)
        cv.vline(xx, y1, y1 + 4, black)
        s = "%d" % int(round(xv))
        cv.text(xx - cv.text_w(s) // 2, y1 + 7, s, black, 1)
    for name, ys, rgb in series:
        for i in range(len(xs) - 1):
            cv.line(tx(xs[i]), ty(ys[i]), tx(xs[i + 1]), ty(ys[i + 1]), rgb)
    # legend (top-left inside panel)
    lx, ly = x0 + 10, y0 + 8
    for name, ys, rgb in series:
        cv.line(lx, ly + 3, lx + 22, ly + 3, rgb)
        cv.text(lx + 28, ly, name, black)
        ly += 12
    # titles
    cv.text((x0 + x1) // 2 - cv.text_w(title) // 2, y0 - 14, title, black, 1)
    cv.text(4, (y0 + y1) // 2 - 3, ylabel, black, 1)


def make_figure(time_hr, sun, shade, path):
    W, H = 960, 700
    cv = Canvas(W, H)
    ml, mr = 75, 25
    p1 = (ml, 45, W - mr, 300)
    p2 = (ml, 400, W - mr, 655)
    draw_panel(cv, *p1, time_hr,
               [("A_SUN (UMOL M-2 S-1)", [s["A"] for s in sun], (200, 0, 0)),
                ("A_SHADE (UMOL M-2 S-1)", [s["A"] for s in shade], (0, 0, 200))],
               "A (UMOL CO2 M-2 S-1)",
               "DIURNAL CO2 ASSIMILATION: FARQUHAR/BALL-BERRY C4")
    draw_panel(cv, *p2, time_hr,
               [("RS_SUN (S M-1)", [s["rs"] for s in sun], (200, 0, 0)),
                ("RS_SHADE (S M-1)", [s["rs"] for s in shade], (0, 0, 200))],
               "RS (S M-1)",
               "DIURNAL LEAF RESISTANCE: SUN vs SHADE")
    cv.text(ml, 680, "TIME (HR)  - 5-DAY FORCING SERIES (120 HOURLY STEPS)",
            (0, 0, 0))
    try:
        import matplotlib  # noqa: F401  (preferred path if ever available)
        HAVE_MPL = True
    except Exception:
        HAVE_MPL = False
    cv.save_png(path)
    return cv, HAVE_MPL


def verify_png(path):
    """Byte-level readback: chunks, CRCs, IHDR dims, zlib inflate, pixels."""
    data = open(path, 'rb').read()
    rep = {"bytes": len(data), "sig": data[:8] == b'\x89PNG\r\n\x1a\n'}
    assert rep["sig"]
    pos, chunks, idat = 8, [], b''
    while pos < len(data):
        ln = struct.unpack('>I', data[pos:pos + 4])[0]
        tag = data[pos + 4:pos + 8]
        body = data[pos + 8:pos + 8 + ln]
        crc = struct.unpack('>I', data[pos + 8 + ln:pos + 12 + ln])[0]
        ok = (zlib.crc32(tag + body) & 0xffffffff) == crc
        chunks.append((tag.decode(), ln, ok))
        if tag == b'IDAT':
            idat += body
        pos += 12 + ln
    rep["chunks"] = chunks
    rep["crc_all_ok"] = all(c[2] for c in chunks)
    ihdr = None
    pos = 8
    while pos < len(data):
        ln = struct.unpack('>I', data[pos:pos + 4])[0]
        tag = data[pos + 4:pos + 8]
        if tag == b'IHDR':
            ihdr = struct.unpack('>IIBBBBB', data[pos + 8:pos + 8 + ln])
        pos += 12 + ln
    w, h, depth, ctype = ihdr[0], ihdr[1], ihdr[2], ihdr[3]
    rep["width"], rep["height"] = w, h
    rep["bit_depth"], rep["color_type"] = depth, ctype
    raw = zlib.decompress(idat)
    rep["raw_bytes"] = len(raw)
    assert len(raw) == h * (1 + w * 3), "raw scanline length mismatch"
    arr = np.frombuffer(raw, dtype=np.uint8).reshape(h, 1 + w * 3, 1)
    nonwhite = int(np.sum(np.any(arr[:, 1:] != 255, axis=-1)))
    rep["nonwhite_pixels"] = nonwhite
    rep["pixels_ok"] = nonwhite > 1000
    rep["filters_ok"] = all(raw[y * (1 + w * 3)] == 0 for y in range(h))
    return rep


