#!/usr/bin/env python3
"""
Leaf-level coupled Farquhar(C3)/Collatz(C4) photosynthesis + Ball-Berry
stomatal conductance, land-surface (CLM/Noah-MP) convention.

Data pathway = C4 (leaf_params.json), so BOTH sun and shade leaves use the
C4 three-way limitation.  The C3 branch is implemented for completeness but
is NOT used for outputs (no C3 parameter set exists in the inputs).

Units convention (explicit, per task statement):
  - A reported in umol CO2 m-2 s-1;  A_mol = A * UMOL_TO_MOL (mol m-2 s-1)
    is used ONLY inside the diffusion-closure equations and gs equation.
  - cf = p_atm/(R*T)  [mol m-3]
  - rb*A_mol/cf has units (s/m * mol/m2/s) / (mol/m3) = dimensionless
    (a mole-fraction difference); multiplied by p_atm -> Pa.  Same for
    rs*A_mol/cf * p_atm.  This is how the pressure drops are formed.
  - gs in mol m-2 s-1;  rs = cf/gs in s m-1;  Ci, cs, ca in Pa.
"""
import json
import math
import sys
import zlib
import struct

import numpy as np
import pandas as pd
from scipy.optimize import brentq

# ----------------------------- named constants -----------------------------
R_GAS = 8.314              # J mol-1 K-1 (universal gas constant)
UMOL_TO_MOL = 1e-6         # umol m-2 s-1  ->  mol m-2 s-1 conversion factor
KC25 = 30.0                # Pa   Michaelis constant for CO2 at 25 C
KO25 = 30000.0             # Pa   Michaelis constant for O2 at 25 C
Q10_KC, Q10_KO, Q10_RD = 2.1, 1.2, 2.4
# CLM/Noah-MP Q10 with high-temperature inhibition for Vcmax:
VCMAX_Q10 = 2.4
HA_VC = 2.2e5              # J mol-1  deactivation enthalpy
HD_VC = 710.0              # J mol-1 K-1  deactivation entropy
GAMMA_LITERAL = 0.5        # Gamma* = 0.5*(Kc/Ko)*O2*0.21  (literal task
#                        convention: O2 column AND 0.21 both kept as written;
#                        double-dilution is intentional, only affects C3 branch)
GAMMA_O2_FRACTION = 0.21
RD_FRAC = 0.015            # Rd = 0.015 * Vcmax(T)
APAR_FACTOR = 4.6          # APAR = 4.6 * PAR  (no extra absorptance)
RB_BUNDLE = 1.37           # boundary-layer  CO2 pathway multiplier
RB_LEAF = 1.65             # leaf-interior   CO2 pathway multiplier
# Buck saturation vapour pressure constants (Pa, T in deg C)
ESAT_A = 610.78
ESAT_B = 22.058
HS_MIN, HS_MAX = 0.25, 1.0
GS_FLOOR = 1e-6            # mol m-2 s-1, numerical floor to keep rs finite
NIGHT_PAR_THRESHOLD = 1e-6 # W m-2: par<=this (incl. 1e-13 numerical zeros)
# solver
FP_OMEGA = 0.5             # damping / relaxation factor
FP_TOL = 1e-3              # Pa absolute tolerance on |Ci_new - Ci|
FP_TOL_REL = 1e-6
FP_MAXIT = 200
DATA_DIR = "data"
RES_DIR = "results"


# ------------------------------ leaf physiology ----------------------------
def esat_buck(tc):
    """Saturation water vapour pressure [Pa], Buck formula, tc in deg C."""
    return ESAT_A * math.exp(ESAT_B * tc / (tc + 273.15))


def vcmax_at_t(vcmax25, t_k):
    """CLM/Noah-MP Q10 response with high-temperature inhibition (task eq.)."""
    tc = t_k - 273.15
    tk = tc + 273.16
    num = VCMAX_Q10 ** ((tc - 25.0) / 10.0)
    den = 1.0 + math.exp((-HA_VC + HD_VC * tk) / (R_GAS * tk))
    return vcmax25 * num / den


def kc_ko_gamma(t_k, o2_pa):
    tc = t_k - 273.15
    kc = KC25 * Q10_KC ** ((tc - 25.0) / 10.0)
    ko = KO25 * Q10_KO ** ((tc - 25.0) / 10.0)
    gamma = GAMMA_LITERAL * (kc / ko) * o2_pa * GAMMA_O2_FRACTION
    return kc, ko, gamma


def photosynthesis_c3(ci, vcmax_t, kc, ko, gamma, rd, apar):
    """C3 branch (implemented per task, NOT exercised: pathway is C4).
    NOTE: `apar` is ALREADY APAR = 4.6*PAR (converted once at the caller);
    the 4.6 factor must NOT be applied again here."""
    j = alpha_q_global * apar   # J = alpha_q * APAR (single 4.6 factor)
    wc = vcmax_t * (ci - gamma) / (ci + kc * (1.0 + o2_global / ko))
    wj = j * (ci - gamma) / (4.0 * ci + 8.0 * gamma)
    we = 0.5 * vcmax_t
    return min(wc, wj, we) - rd, (wc, wj, we)


def photosynthesis_c4(ci, vcmax_t, p_atm, rd, apar):
    """C4 branch (used).  Wc=Vcmax, Wj=alpha_q*APAR, We=4000*Vcmax*Ci/p_atm.
    `apar` is already APAR=4.6*PAR (converted once at the caller); the 4.6
    factor must NOT be applied again here (previous bug, fixed)."""
    wc = vcmax_t
    wj = alpha_q_global * apar   # Wj = alpha_q * APAR (single 4.6 factor)
    we = 4000.0 * vcmax_t * ci / p_atm
    return min(wc, wj, we) - rd, (wc, wj, we)


# globals set from leaf_params.json / forcing row before each solve
alpha_q_global = 0.0
o2_global = 0.0


def closure(ca, p_atm, t_k, rb, hs, a_umol, b0, m):
    """Gas-diffusion closure given A [umol m-2 s-1] -> cs, gs, rs, ci_rhs."""
    cf = p_atm / (R_GAS * t_k)                 # mol m-3
    a_mol = a_umol * UMOL_TO_MOL               # mol m-2 s-1
    cs = ca - RB_BUNDLE * rb * a_mol / cf * p_atm
    gs = m * a_mol * hs / cs * p_atm + b0
    gs = max(gs, GS_FLOOR)                     # keep rs finite/non-negative
    rs = cf / gs
    ci = cs - RB_LEAF * rs * a_mol / cf * p_atm
    return cs, gs, rs, ci, cf


# ------------------------------ fixed-point solver -------------------------
def solve_leaf_row(row, pars, par_wm2, ci_init, branch="C4", diagnostics=None):
    """Solve the coupled fixed point for one leaf of one forcing row.

    Returns dict(A_umol, gs, rs, ci, cs, n_iter, method, ok, night, extras).
    Night (par <= NIGHT_PAR_THRESHOLD): A=-Rd, gs=b0, rs=cf/gs,
    ci = cs - 1.65*rs*A_mol/cf*p_atm  (A<0 => ci>cs).  No iteration.
    """
    global alpha_q_global, o2_global
    t_k = row["t_air_K"]
    p_atm = row["p_atm_Pa"]
    ca = row["co2_pa"]
    o2 = row["o2_pa"]
    vpd = row["vpd_Pa"]
    rb = row["rb_sm"]
    btran = row["btran"]
    m = pars["m"]
    b0 = pars["b0"]
    alpha_q_global = pars["alpha_q"]
    o2_global = o2

    vcmax25 = pars["vcmax25"] * pars["n_factor"] * btran   # capacity scaling
    vcmax_t = vcmax_at_t(vcmax25, t_k)
    kc, ko, gamma = kc_ko_gamma(t_k, o2)
    rd = RD_FRAC * vcmax_t                                  # Rd=0.015*Vcmax(T)
    esat = esat_buck(t_k - 273.15)
    hs = min(max(1.0 - vpd / esat, HS_MIN), HS_MAX)
    cf = p_atm / (R_GAS * t_k)
    apar = APAR_FACTOR * par_wm2

    def a_of_ci(ci):
        if branch == "C4":
            a, w = photosynthesis_c4(ci, vcmax_t, p_atm, rd, apar)
        else:
            a, w = photosynthesis_c3(ci, vcmax_t, kc, ko, gamma, rd, apar)
        return a, w

    def residual(ci):
        a, _ = a_of_ci(ci)
        _, _, _, ci_rhs, _ = closure(ca, p_atm, t_k, rb, hs, a, b0, m)
        return ci_rhs - ci

    night = par_wm2 <= NIGHT_PAR_THRESHOLD
    if night:
        # Night convention (approved): A = -Rd, gs = b0 EXACTLY (intercept
        # conductance, unmodulated by hs or the A-term), rs = cf/gs > 0,
        # cs from the same boundary-layer drop (A<0 => cs>ca), and
        # ci = cs - 1.65*rs*A_mol/cf*p_atm  (=> ci > cs at night).
        a_umol = -rd
        cf_ = p_atm / (R_GAS * t_k)
        a_mol = a_umol * UMOL_TO_MOL
        cs = ca - RB_BUNDLE * rb * a_mol / cf_ * p_atm
        gs = max(b0, GS_FLOOR)
        rs = cf_ / gs
        ci = cs - RB_LEAF * rs * a_mol / cf_ * p_atm
        out = dict(A=a_umol, gs=gs, rs=rs, ci=ci, cs=cs, n_iter=0,
                   method="night", ok=True, night=True,
                   Wc=None, Wj=None, We=None)
        if diagnostics is not None:
            diagnostics.update(dict(vcmax_t=vcmax_t, apar=apar, rd=rd, hs=hs,
                                    W=None, cf=cf, esat=esat))
        return out

    # ---- daytime: damped fixed point, Brentq fallback on residual ----
    lo = max(gamma, 1e-6) + 1e-6          # Gamma* (literal) lower bracket
    # upper bracket: cs at A=-Rd is the maximum possible cs (A>0 => ci<cs)
    _, _, _, ci_hi0, _ = closure(ca, p_atm, t_k, rb, hs, -rd, b0, m)
    hi = ci_hi0
    while residual(hi) > 0.0 and hi < 1e5:   # pathological: expand (logged)
        hi *= 1.5
    ci = min(max(float(ci_init), lo + 1e-9), hi - 1e-9)

    method, ok, n_iter = "fixed-point", True, 0
    a, w = a_of_ci(ci)
    _, _, _, ci_rhs, _ = closure(ca, p_atm, t_k, rb, hs, a, b0, m)
    while True:
        n_iter += 1
        step = ci_rhs - ci
        ci_new = ci + FP_OMEGA * step
        if abs(ci_new - ci) <= max(FP_TOL, FP_TOL_REL * abs(ci_new)):
            ci = ci_new
            break
        ci = ci_new
        if n_iter >= FP_MAXIT:
            ok = False
            break
        a, w = a_of_ci(ci)
        _, _, _, ci_rhs, _ = closure(ca, p_atm, t_k, rb, hs, a, b0, m)

    if not ok:
        # Brentq fallback on [Gamma*, cs_max]; count its iterations too
        root = brentq(residual, lo, hi, xtol=FP_TOL, rtol=8.9e-12,
                      maxiter=200, full_output=True)
        ci_new, res = root[0], root[1]
        n_iter_fp = n_iter
        n_iter += res.iterations
        ci = min(max(ci_new, lo), hi)
        method = "brentq-fallback(fp_iters=%d)" % n_iter_fp
        ok = res.converged

    a, w = a_of_ci(ci)
    cs, gs, rs, ci_final, _ = closure(ca, p_atm, t_k, rb, hs, a, b0, m)
    out = dict(A=a, gs=gs, rs=rs, ci=ci_final, cs=cs, n_iter=n_iter,
               method=method, ok=ok, night=False, Wc=w[0], Wj=w[1], We=w[2])
    if diagnostics is not None:
        diagnostics.update(dict(vcmax_t=vcmax_t, apar=apar, rd=rd, hs=hs,
                                W=w, cf=cf, esat=esat))
    return out


