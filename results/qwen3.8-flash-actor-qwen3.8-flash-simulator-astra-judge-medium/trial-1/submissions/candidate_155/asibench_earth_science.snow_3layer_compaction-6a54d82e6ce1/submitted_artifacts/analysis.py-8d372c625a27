    P(f"  results/snow_summary.csv  {len(summ)} data rows x {summ.shape[1]} cols")
    P("  results/snow_evolution.png")
    P(f"  timing convention: day k = forcing hours [24k, 24k+23]; both .npy")
    P(f"  row k and .csv row k are the END-OF-DAY snapshot (same instant).")
    P(f"  randomness: none (fully deterministic model).")
    P("  CONCLUSION (CONDITIONAL): under THIS uncalibrated parameter set")
    P(f"  (phi={PHI_FC}, wet-surface refreeze strength, alpha_old=0.50) no")
    P("  runoff breakthrough occurs (runoff=0). This is a model outcome of")
    P("  retention-dominated diurnal cycling, NOT a general scientific")
    P("  claim: alpha_old=0.45 already shows breakthrough (12.3 mm).")
    P(f"  bottom boundary adiabatic: bottom cold content recovers too slowly")
    P(f"  and, had percolation reached the base, bottom runoff would be")
    P(f"  biased EARLY/LARGER relative to a soil heat-flux boundary (bias")
    P(f"  direction for readers; here deep percolation is nil, so the only")
    P(f"  visible effect is layer-3 T ending at {hrL['T'][idx[-1],2]:.2f} K).")
    P(f"  total wall time: {time.time()-t0:.1f}s")

    txt = "\n".join(rep)
    print(txt)
    with open(os.path.join(rdir, "selfcheck_report.txt"), "w") as fh:
        fh.write(txt + "\n")
    return base, state, summ


