#!/usr/bin/env python3
"""
Snowpack dynamics: fixed 3-layer process-based snow model.
================================================================
State per layer i (i=0 TOP ... i=2 BOTTOM; 3 layers fixed by TASK, so
"no dynamic split/combine" is task-given, not a modelling simplification):
  I_i [mm = kg/m2] ice, W_i liquid water, T_i [K], d_i [m] thickness
  (independent volume state).  Density is ALWAYS derived rho=(I+W)/d, so
  thickness and density cannot decouple; compaction shrinks volume only.
Processes (reviewer-approved plan): Anderson-type viscous compaction,
Anderson-type rho_new(T_air) new snow, surface energy balance with
(1-alpha)SW + LW_in - eps*sigma*Ts^4 + neutral-bulk sensible/latent
(u=2 m/s, RH=0.85, Ch=Ce=1.2e-3 -- assumed, forcing has no wind/humidity),
0 C-constrained energy-residual surface temperature, WET-SURFACE ENERGY
PRIORITY (a surface at 273.15 K losing energy freezes liquid water before
cooling below 0), implicit tridiagonal interlayer conduction (adiabatic
soil bottom), explicit latent-heat melt/refreeze with cold content, field
capacity phi=0.04 + 6 mm/h capped drainage, bottom surplus = runoff.
TIMING (REVIEWER RULING A4): day k covers forcing hours [24k..24k+23];
snow_state[k] and snow_summary row k are the END-OF-DAY snapshot at the end
of hour 24k+23 (identical index = identical instant for .npy and .csv);
no initial-state row is written.
SUMMARY (A5): melt/refreeze/runoff = intraday SUMS; swe/depth = END-OF-DAY;
mean_density = end-of-day SWE / end-of-day total depth (volume-weighted).
Deterministic: no random numbers anywhere.
"""
import json, math, os, struct, sys, time, zlib

import numpy as np
import pandas as pd

# ------------------------------------------------------------------ consts
LF, LV    = 3.34e5, 2.501e6      # J/kg
C_ICE, C_W = 2106.0, 4186.0      # J/kg/K
RHO_ICE, RHO_W = 917.0, 1000.0
SIGMA, EPS_S, G_ACC = 5.67e-8, 0.98, 9.81
R_D, CP_AIR, T_FRZ = 287.05, 1005.0, 273.15

# assumed forcing completions (documented assumptions A6)
U_WIND, RH_AIR, CH_EXCH = 2.0, 0.85, 1.2e-3

# model parameters (assumptions A8/A10; alpha_old sensitivity per reviewer)
ALPHA_NEW, ALPHA_OLD = 0.85, 0.50
TAU_DRY, TAU_WET = 8.0 * 86400.0, 0.2 * 86400.0
PHI_FC, K_DRAIN  = 0.04, 6.0     # field capacity; max drainage mm/h
ETA_REF, Q_COMP, R_GAS = 1.0e10, 50.0e3, 8.314

ROOT = os.path.dirname(os.path.abspath(__file__))


def _es_w(T):
    return 611.2 * math.exp(17.67 * (T - T_FRZ) / (T - 29.65))

def _es_i(T):
    return 611.21 * math.exp(22.587 * (T - T_FRZ) / (T - 0.91))

def _qsat(T, over_ice, p=101325.0):
    e = _es_i(T) if over_ice else _es_w(T)
    return 0.622 * e / (p - 0.378 * e)

def rho_new_snow(T_air):
    """Anderson-type new-snow density [kg/m3] from air temperature."""
    return 50.0 + 36.0 * math.tanh(0.15 * (T_air - 262.15))


# ------------------------------------------------------------------- model
def run_model(init_path, forc_path, dt_min=15.0, alpha_old=ALPHA_OLD, verbose=False):
    with open(init_path) as fh:
        ini = json.load(fh)
    assert ini["n_layers"] == 3, "task fixes n_layers=3"
    lay = ini["layers"]
    I = np.array([L["ice_mm"] for L in lay], dtype=np.float64)
    W = np.array([L["liq_mm"] for L in lay], dtype=np.float64)
    T = np.array([L["temp_K"] for L in lay], dtype=np.float64)
    d = np.array([L["thickness_m"] for L in lay], dtype=np.float64)
    for i in range(3):   # initial state must already satisfy rho = m/V
        assert abs((I[i]+W[i])/d[i] - lay[i]["density_kg_m3"]) < 1e-3

    fx = pd.read_csv(forc_path)
    t_hr = fx["time_hr"].to_numpy()
    assert np.all(np.diff(t_hr) == 1.0), "forcing must be strictly hourly"
    nH = len(fx)
    n_days = nH // 24
    nsub = max(1, int(round(3600.0 / (dt_min * 60.0))))
    dt = 3600.0 / nsub

    clip = {"T>273.15": 0, "T<200": 0, "I<0": 0, "W<0": 0, "d<=0": 0,
            "rho>rho_ice": 0, "melt>ice": 0, "frz>water": 0, "drain>free": 0,
            "subl>water": 0}
    alpha = ALPHA_NEW
    tag = np.zeros(3)                # water frozen during this run (for net refreeze)
    runoff = 0.0
    swe_prev = float(I.sum() + W.sum())
    swe_init = swe_prev
    tot = dict(melt=0.0, refreeze=0.0, refz_surf=0.0, refz_int=0.0,
               remelt_of_refrozen=0.0, runoff=0.0, snowfall=0.0, rain=0.0,
               subl=0.0, dep=0.0)
    tri_res_max = 0.0
    dT_max = 0.0
    res_max = 0.0

    # hourly records
    hr = {k: np.zeros(nH) for k in
          ("melt", "refreeze", "refz_surf", "runoff", "subl", "snow", "rain",
           "closure", "depth", "swe", "alpha")}
    hrL = {k: np.zeros((nH, 3)) for k in ("I", "W", "T", "rho", "d")}
    tair = fx["t_air_K"].to_numpy()
    sw_in = fx["sw_in_wm2"].to_numpy()
    lw_in = fx["lw_in_wm2"].to_numpy()
    patm = fx["p_atm_Pa"].to_numpy()
    sf = fx["snowfall_mm_hr"].to_numpy()
    rf = fx["rainfall_mm_hr"].to_numpy()

    def guard(name):
        clip[name] += 1

    for h in range(nH):
        Ta, Sw, Lw, p0 = tair[h], sw_in[h], lw_in[h], patm[h]
        qa = RH_AIR * _qsat(min(Ta, 273.15+30), False, p0)
        rho_a = p0 / (R_D * Ta * (1.0 + 622e-6 * qa))
        h_in_s = h_in_r = h_melt = h_frz = h_frz_s = 0.0
        h_run0, h_subl, h_dep = runoff, 0.0, 0.0

        for s in range(nsub):
            dS, dR = sf[h]/nsub, rf[h]/nsub
            # --- albedo ageing ------------------------------------------------
            wet = (T[0] >= T_FRZ - 1e-3) or (W[0] > 0.05)
            tau = TAU_WET if wet else TAU_DRY
            alpha += (alpha_old - alpha) * min(1.0, dt/tau)
            # --- new snow & rain onto layer 0 ---------------------------------
            if dS > 0:
                rn = rho_new_snow(Ta)
                Tn = min(Ta, T_FRZ)
                c_new = (C_ICE if Tn < T_FRZ else C_W)
                m0 = I[0] + W[0]
                C0 = I[0]*C_ICE + W[0]*C_W
                T[0] = (C0*T[0] + dS*c_new*Tn) / (C0 + dS*c_new) if (C0+dS*c_new) > 0 else Tn
                I[0] += dS
                d[0] += dS / rn
                alpha = (alpha*m0 + ALPHA_NEW*dS) / (m0 + dS)
                h_in_s += dS
            if dR > 0:
                m0 = I[0] + W[0]
                C0 = I[0]*C_ICE + W[0]*C_W
                Tn = min(max(Ta, 200.0), T_FRZ)
                T[0] = (C0*T[0] + dR*C_W*Tn) / (C0 + dR*C_W) if (C0+dR*C_W) > 0 else Tn
                W[0] += dR
                h_in_r += dR

            # --- surface energy balance, Ts constrained to <= 0C --------------
            Ts = min(T[0], T_FRZ)
            Rn = (1.0 - alpha) * Sw + Lw - EPS_S * SIGMA * Ts**4
            Hf = rho_a * CP_AIR * CH_EXCH * U_WIND * (Ta - Ts)
            qs_s = _qsat(Ts, T[0] < T_FRZ - 1e-3, p0)
            LE = rho_a * LV * CH_EXCH * U_WIND * (qa - qs_s)
            F = Rn + Hf + LE + dR * C_W * max(Ta - T_FRZ, 0.0) / dt
            #   ^ rain (if any) enters with its air-temperature heat above 0C
            C0 = max(I[0]*C_ICE + W[0]*C_W, 1e-9)
            if F >= 0.0:
                heat = F * dt
                if T[0] < T_FRZ:                              # warm cold content
                    cw = C0 * (T_FRZ - T[0])
                    if heat <= cw:
                        T[0] += heat / C0
                        heat = 0.0
                    else:
                        T[0] = T_FRZ
                        heat -= cw
                if heat > 0:                                  # melt
                    m = heat / LF
                    if m > I[0]:
                        guard("melt>ice"); m = I[0]
                    if m > 0:
                        frac = m / W[0] if W[0] > 0 else 0.0
                        tot["remelt_of_refrozen"] += tag[0] * min(frac, 1.0)
                        tag[0] *= (1.0 - min(frac, 1.0))
                        I[0] -= m; W[0] += m; h_melt += m
            else:
                deficit = -F * dt
                if Ts >= T_FRZ - 1e-3 and W[0] > 0:           # WET-SURFACE PRIORITY
                    m = min(W[0], deficit / LF)
                    W[0] -= m; I[0] += m; tag[0] += m
                    h_frz += m; h_frz_s += m
                    deficit -= m * LF
                if deficit > 0:
                    C0 = max(I[0]*C_ICE + W[0]*C_W, 1e-9)
                    T[0] -= deficit / C0
            # sublimation / deposition mass (kept in the closure)
            e = rho_a * CH_EXCH * U_WIND * (qs_s - qa) * dt     # mm (+ = loss)
            if e > 0:
                e = min(e, W[0] + I[0])
                take = min(e, W[0]); W[0] -= take; I[0] -= (e-take)
                h_subl += e
            elif e < 0:
                I[0] += -e; h_dep += -e
            # --- implicit conduction (tridiagonal, adiabatic bottom) ----------
            m_tot = I + W
            rho = m_tot / np.maximum(d, 1e-12)
            k = 0.074 + 5.8e-4 * rho
            G12 = 2.0 / (d[0]/k[0] + d[1]/k[1])
            G23 = 2.0 / (d[1]/k[1] + d[2]/k[2])
            C = np.maximum(I*C_ICE + W*C_W, 1e-9)
            A = np.array([[C[0]/dt + G12,          -G12,          0.0],
                          [-G12,        C[1]/dt + G12 + G23,     -G23],
                          [0.0,                  -G23,    C[2]/dt + G23]])
            b = C * T / dt
            T_old = T.copy()
            T = np.linalg.solve(A, b)
            tri_res_max = max(tri_res_max, float(np.max(np.abs(A @ T - b))))
            dT_max = max(dT_max, float(np.max(np.abs(T - T_old))))

            # --- phase adjustment, exact latent accounting --------------------
            for i in range(3):
                Ci = max(I[i]*C_ICE + W[i]*C_W, 1e-9)
                if T[i] > T_FRZ:                               # melt
                    m = Ci * (T[i] - T_FRZ) / LF
                    if m > I[i]:
                        guard("melt>ice"); m = I[i]
                    if m > 0:
                        frac = m / W[i] if W[i] > 0 else 0.0
                        tot["remelt_of_refrozen"] += tag[i] * min(frac, 1.0)
                        tag[i] *= (1.0 - min(frac, 1.0))
                        I[i] -= m; W[i] += m; h_melt += m
                    T[i] = T_FRZ
                elif T[i] < T_FRZ and W[i] > 0:                # refreeze
                    m = min(W[i], Ci * (T_FRZ - T[i]) / LF)
                    if m > W[i] + 1e-12:
                        guard("frz>water"); m = W[i]
                    W[i] -= m; I[i] += m; tag[i] += m
                    T[i] += m * LF / Ci                        # <= T_FRZ exactly
                    h_frz += m

            # --- retention, drainage, compaction ------------------------------
            for i in range(3):
                solid_v = I[i]/RHO_ICE + W[i]/RHO_W
                if solid_v >= d[i]:                            # no pore left
                    guard("rho>rho_ice")
                    d[i] = solid_v * (1.0 + 1e-9)
                pore = max(d[i] - solid_v, 0.0)
                w_free = W[i] - PHI_FC * pore * RHO_W          # above field cap
                if w_free > 0:
                    dr = min(w_free, K_DRAIN * dt / 3600.0)
                    if dr > W[i] + 1e-12:
                        guard("drain>free"); dr = W[i]
                    W[i] -= dr
                    if i < 2:
                        W[i+1] += dr
                    else:
                        runoff += dr
                # viscous compaction: volume-only, mass untouched
                load = (m_tot[:i].sum() + 0.5 * m_tot[i]) * G_ACC      # Pa
                Ti = max(min(T[i], T_FRZ), 200.0)
                eta = ETA_REF * math.exp(Q_COMP/R_GAS * (1.0/Ti - 1.0/T_FRZ))
                fac = max(1.0 - rho[i]/RHO_ICE, 0.01)
                dn = d[i] * math.exp(-dt * load * fac / eta)
                d[i] = max(dn, solid_v * (1.0 + 1e-9))

            # --- physical guards ----------------------------------------------
            nT = int(np.sum(T > T_FRZ + 1e-9))
            if nT:
                clip["T>273.15"] += nT
            T = np.minimum(T, T_FRZ)
            nlo = int(np.sum(T < 200.0))
            if nlo:
                clip["T<200"] += nlo
            nI = int(np.sum(I < 0)); nW = int(np.sum(W < 0))
            if nI: clip["I<0"] += nI
            if nW: clip["W<0"] += nW
            np.maximum(I, 0.0, out=I); np.maximum(W, 0.0, out=W)
            if np.any(d <= 0):
                clip["d<=0"] += int(np.sum(d <= 0))
                np.maximum(d, 1e-6, out=d)

        # ---- hourly closure & storage ------------------------------------
        swe = float(I.sum() + W.sum())
        r_out = runoff - h_run0
        closure = (swe - swe_prev) - (h_in_s + h_in_r + h_dep - h_subl - r_out)
        res_max = max(res_max, abs(closure))
        hr["closure"][h] = closure
        swe_prev = swe
        hr["melt"][h], hr["refreeze"][h], hr["refz_surf"][h] = h_melt, h_frz, h_frz_s
        hr["runoff"][h], hr["subl"][h] = r_out, h_subl - h_dep
        hr["snow"][h], hr["rain"][h] = h_in_s, h_in_r
        hr["swe"][h], hr["depth"][h], hr["alpha"][h] = swe, float(d.sum()), alpha
        hrL["I"][h], hrL["W"][h], hrL["T"][h] = I.copy(), W.copy(), T.copy()
        hrL["rho"][h], hrL["d"][h] = (I + W) / d, d.copy()
        tot["melt"] += h_melt;             tot["refreeze"] += h_frz
        tot["refz_surf"] += h_frz_s;       tot["refz_int"] += h_frz - h_frz_s
        tot["runoff"] += r_out;            tot["snowfall"] += h_in_s
        tot["rain"] += h_in_r;             tot["subl"] += h_subl
        tot["dep"] += h_dep

    out = dict(hr=hr, hrL=hrL, tot=tot, clip=clip, n_days=n_days,
               swe_init=swe_init, tri_res_max=tri_res_max,
               dT_max=dT_max, closure_max=res_max,
               tair=tair, sw_in=sw_in, sf=sf, dt_min=dt_min,
               alpha_old=alpha_old)
    if verbose:
        print(f"  run dt={dt_min}min a_old={alpha_old}: melt={tot['melt']:.2f} "
              f"refz={tot['refreeze']:.2f} runoff={tot['runoff']:.2f} "
              f"SWE_end={hr['swe'][-1]:.2f} closure_max={res_max:.2e}")
    return out


