def _nice(lo, hi, n=5):
    if hi - lo <= 0:
        hi = lo + 1
    step = 10.0 ** math.floor(math.log10((hi - lo) / n))
    for m in (1, 2, 2.5, 5, 10):
        if (hi - lo) / (step * m) <= n:
            step *= m
            break
    t = math.floor(lo / step) * step
    out = []
    while t <= hi + 1e-9:
        if t >= lo - 1e-9:
            out.append(t)
        t += step
    return out


def _fmt(v):
    if v == int(v) and abs(v) < 1e5:
        return str(int(v))
    return f"{v:.3g}"


class _Panel:
    """Fallback-renderer axes with frame, ticks, labels, series."""
    def __init__(self, cv, x0, y0, x1, y1, xlim, ylim, title):
        self.cv, self.x0, self.y0, self.x1, self.y1 = cv, x0, y0, x1, y1
        self.xlim, self.ylim = xlim, ylim
        cv.rect(x0, y0, x1, y1, LGRAY)
        cv.rect(x0 - 2, y0 - 2, x1 + 2, y1 + 2, BLACK)
        cv.rect(x0, y0, x1, y1, (255, 255, 255))
        self.text(x0 + 4, y0 - 20, title, BLACK, 2)

    def X(self, v):
        a, b = self.xlim
        return self.x0 + (v - a) / (b - a) * (self.x1 - self.x0)

    def Y(self, v):
        a, b = self.ylim
        return self.y1 - (v - a) / (b - a) * (self.y1 - self.y0)

    def frame_ticks(self, xl="", yl=""):
        for t in _nice(*self.xlim):
            x = int(round(self.X(t)))
            self.cv.line(x, self.y1, x, self.y1 + 4, BLACK)
            s = _fmt(t)
            self.text(x - 3 * len(s), self.y1 + 7, s, BLACK, 1)
        for t in _nice(*self.ylim):
            y = int(round(self.Y(t)))
            self.cv.line(self.x0 - 4, y, self.x0, y, BLACK)
            s = _fmt(t)
            self.text(self.x0 - 8 - 6 * len(s), y - 3, s, BLACK, 1)
            self.cv.line(self.x0, y, self.x1, y, (240, 240, 240))
        self.text(self.x0 + (self.x1 - self.x0) // 2 - 3 * len(xl),
                  self.y1 + 22, xl, BLACK, 1)

    def text(self, x, y, s, c, sc):
        self.cv.text(x, y, s, c, sc)

    def poly(self, xs, ys, c, wd=2, dash=0):
        px = [self.X(v) for v in xs]
        py = [self.Y(min(max(v, self.ylim[0]), self.ylim[1])) for v in ys]
        for i in range(len(px) - 1):
            self.cv.line(px[i], py[i], px[i+1], py[i+1], c, wd, dash)

    def bars(self, xs, ys, c, wd=3):
        for xv, yv in zip(xs, ys):
            if abs(yv) < 1e-12:
                continue
            x = int(round(self.X(xv)))
            y0, y1 = int(round(self.Y(0))), int(round(self.Y(yv)))
            self.cv.rect(x - wd, min(y0, y1), x + wd, max(y0, y1), c)

    def area(self, xs, ylo, yhi, c):
        for xi in range(self.x0, self.x1 + 1):
            f = (xi - self.x0) / (self.x1 - self.x0)
            idx = min(int(f * (len(xs) - 1)), len(xs) - 2)
            frac = f * (len(xs) - 1) - idx
            lo = ylo[idx] + (ylo[idx+1] - ylo[idx]) * frac
            hi = yhi[idx] + (yhi[idx+1] - yhi[idx]) * frac
            ya, yb = int(round(self.Y(hi))), int(round(self.Y(lo)))
            if abs(ya - yb) < 1:
                self.cv.px(xi, ya, c)
            else:
                self.cv.rect(xi, min(ya, yb), xi, max(ya, yb), c)

    def legend(self, entries, x=None, y=None):
        x = x if x is not None else self.x1 - 200
        y = y if y is not None else self.y0 + 6
        w = 196; h = 12 * len(entries) + 6
        self.cv.rect(x, y, x + w, y + h, (255, 255, 255))
        self.cv.rect(x, y, x + w, y + h, BLACK)
        for i, (c, lab) in enumerate(entries):
            yy = y + 4 + i * 12
            self.cv.rect(x + 4, yy + 2, x + 22, yy + 6, c)
            self.cv.text(x + 27, yy, lab, BLACK, 1)


