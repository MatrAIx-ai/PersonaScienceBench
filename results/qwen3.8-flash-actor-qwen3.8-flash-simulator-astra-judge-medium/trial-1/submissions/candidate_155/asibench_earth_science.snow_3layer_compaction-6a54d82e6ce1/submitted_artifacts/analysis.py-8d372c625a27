    P(f"  final SWE:      {hr['swe'][-1]:.6f} vs {fhr['swe'][-1]:.6f} mm"
      f"  (diff {abs(hr['swe'][-1]-fhr['swe'][-1]):.2e})")
    P(f"  total runoff:   {tot['runoff']:.6f} vs {ftot['runoff']:.6f} mm"
      f"  (diff {abs(tot['runoff']-ftot['runoff']):.2e})")
    P(f"  total melt:     {tot['melt']:.4f} vs {ftot['melt']:.4f} mm")
    P(f"  max hourly |dSWE| diff: {np.max(np.abs(hr['swe']-fhr['swe'])):.2e} mm")

    # ---- water closure ---------------------------------------------------
    daily_c = hr["closure"].reshape(-1, 24)
    net_sub = tot['subl'] - tot['dep']
    P("")
    P("WATER BUDGET & CLOSURE (68-day totals, mm)")
    P(f"  initial SWE {base['swe_init']:.3f} + snowfall {tot['snowfall']:.3f}"
      f" + rain {tot['rain']:.3f}")
    P(f"  - net sublimation {net_sub:.4f} (subl {tot['subl']:.3f}"
      f" - deposition {tot['dep']:.3f})")
    P(f"  - bottom runoff {tot['runoff']:.4f}")
    P(f"  = final SWE {hr['swe'][-1]:.3f}")
    lit = base['swe_init'] + tot['snowfall'] + tot['rain'] - hr['swe'][-1] - tot['runoff']
    ext = lit - net_sub
    P(f"  TASK-LITERAL form  init+snow+rain-dSWE-runoff = {lit:.4f} mm")
    P(f"    -> this residual IS the net sublimation ({net_sub:.4f} mm), an")
    P("       explicit additional OUTPUT term; the literal balance holds only")
    P("       when the sublimation sink is included on the output side.")
    P(f"  EXTENDED form    init+snow+rain-subl+dep-dSWE-runoff = {ext:.3e} mm")
    P(f"  code hourly identity (sublimation as NEGATIVE source):")
    P(f"    dSWE = snow+rain+dep - subl - runoff ; residuals:")
    P(f"    hourly max |res| {np.max(np.abs(hr['closure'])):.3e} mm,"
      f" daily max {np.max(np.abs(daily_c.sum(1))):.3e} mm,")
    P(f"    68-d cumulative {hr['closure'].sum():.3e} mm (machine precision)")
    P("  CHOICE (a): sublimation kept as a physical sink and reported")
    P("  explicitly (daily + cumulative below and in figure panel E).")
