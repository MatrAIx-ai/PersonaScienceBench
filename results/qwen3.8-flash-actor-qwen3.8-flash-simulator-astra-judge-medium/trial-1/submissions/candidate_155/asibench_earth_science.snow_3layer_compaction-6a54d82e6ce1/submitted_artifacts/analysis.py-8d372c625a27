def verify_png(path):
    with open(path, "rb") as fh:
        raw = fh.read()
    assert raw[:8] == b"\x89PNG\r\n\x1a\n", "bad PNG signature"
    pos, idat, ihdr = 8, b"", None
    while pos < len(raw):
        ln = struct.unpack(">I", raw[pos:pos + 4])[0]
        typ = raw[pos + 4:pos + 8]
        data = raw[pos + 8:pos + 8 + ln]
        crc = struct.unpack(">I", raw[pos + 8 + ln:pos + 12 + ln])[0]
        assert crc == zlib.crc32(typ + data) & 0xffffffff, "CRC fail"
        if typ == b"IHDR":
            ihdr = struct.unpack(">IIBBBBB", data)
        elif typ == b"IDAT":
            idat += data
        pos += 12 + ln
    dec = zlib.decompress(idat)
    w, h = ihdr[0], ihdr[1]
    assert len(dec) == h * (1 + 3 * w), "IDAT size mismatch"
    return dict(w=w, h=h, bytes=len(raw), decoded_bytes=len(dec))


def daily_outputs(r):
    """End-of-day snapshots; day k = hours [24k..24k+23] (ruling A4)."""
    hr, hrL, nd = r["hr"], r["hrL"], r["n_days"]
    idx = 24 * np.arange(nd) + 23             # last hour of each day
    state = np.zeros((nd, 3, 5), dtype=np.float64)
    for i in range(3):
        state[:, i, 0] = hrL["d"][idx, i]
        state[:, i, 1] = hrL["rho"][idx, i]
        state[:, i, 2] = hrL["I"][idx, i]
        state[:, i, 3] = hrL["W"][idx, i]
        state[:, i, 4] = hrL["T"][idx, i]
    rows = []
    for k in range(nd):
        sl = slice(24 * k, 24 * k + 24)
        swe, dep = hr["swe"][idx[k]], hr["depth"][idx[k]]
        rows.append(dict(day=k, swe_mm=swe, snow_depth_m=dep,
                         melt_mm=hr["melt"][sl].sum(),
                         refreeze_mm=hr["refreeze"][sl].sum(),
                         runoff_mm=hr["runoff"][sl].sum(),
                         mean_density_kg_m3=swe / dep))
    return state, pd.DataFrame(rows)


