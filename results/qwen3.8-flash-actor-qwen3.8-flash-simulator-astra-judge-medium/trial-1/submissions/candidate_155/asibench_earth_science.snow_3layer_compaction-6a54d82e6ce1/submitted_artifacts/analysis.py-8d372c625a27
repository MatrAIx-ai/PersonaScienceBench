def main():
    t0 = time.time()
    ipath = os.path.join(ROOT, "data", "snowpack_init.json")
    fpath = os.path.join(ROOT, "data", "forcing.csv")
    rdir = os.path.join(ROOT, "results")
    os.makedirs(rdir, exist_ok=True)

    rep = []
    P = rep.append
    P("SNOWPACK MODEL - RUN & SELF-CHECK REPORT")
    P("=" * 60)
    base = run_model(ipath, fpath, dt_min=15.0, verbose=True)
    P(f"base run: dt=15 min, alpha_old={base['alpha_old']} (wall {time.time()-t0:.1f}s)")

    state, summ = daily_outputs(base)
    np.save(os.path.join(rdir, "snow_state.npy"), state)
    summ.to_csv(os.path.join(rdir, "snow_summary.csv"), index=False)

    # ---- numerical convergence: 15 vs 7.5 min substeps -----------------
    fine = run_model(ipath, fpath, dt_min=7.5, verbose=True)
    hr, hrL, tot = base["hr"], base["hrL"], base["tot"]
    fhr, ftot = fine["hr"], fine["tot"]
