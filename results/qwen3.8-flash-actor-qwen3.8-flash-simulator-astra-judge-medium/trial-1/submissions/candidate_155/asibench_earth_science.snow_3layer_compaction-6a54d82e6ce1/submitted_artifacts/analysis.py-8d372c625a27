class _Canvas:
    """Minimal RGB raster canvas: lines, bars, areas, text, PNG output."""
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.a = np.full((h, w, 3), 255, np.uint8)

    def px(self, x, y, c):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.a[y, x] = c

    def line(self, x0, y0, x1, y1, c, wd=1, dash=0):
        x0, y0, x1, y1 = map(float, (x0, y0, x1, y1))
        n = int(max(abs(x1 - x0), abs(y1 - y0), 1))
        for i in range(n + 1):
            if dash and (i // dash) % 2:
                continue
            x = int(round(x0 + (x1 - x0) * i / n))
            y = int(round(y0 + (y1 - y0) * i / n))
            for dx in range(wd):
                for dy in range(wd):
                    self.px(x + dx, y + dy, c)

    def rect(self, x0, y0, x1, y1, c):
        x0, x1 = sorted((int(x0), int(x1))); y0, y1 = sorted((int(y0), int(y1)))
        self.a[max(y0,0):min(y1+1,self.h), max(x0,0):min(x1+1,self.w)] = c

    def text(self, x, y, s, c=(0, 0, 0), sc=1):
        for ch in str(s).upper():
            g = _F.get(ch, _F[' '])
            for r, row in enumerate(g):
                for col, v in enumerate(row):
                    if v == '#':
                        self.rect(x + col*sc, y + r*sc, x + col*sc + sc - 1,
                                  y + r*sc + sc - 1, c)
            x += 6 * sc
        return x

    def png(self, path):
        raw = b"".join(b"\x00" + self.a[y].tobytes() for y in range(self.h))
        def chunk(t, d):
            return (struct.pack(">I", len(d)) + t + d
                    + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff))
        with open(path, "wb") as fh:
            fh.write(b"\x89PNG\r\n\x1a\n")
            fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", self.w, self.h, 8, 2, 0, 0, 0)))
            fh.write(chunk(b"IDAT", zlib.compress(raw, 9)))
            fh.write(chunk(b"IEND", b""))


