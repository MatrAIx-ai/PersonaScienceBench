#!/usr/bin/env python3
"""
Deterministic nonlinear target-tracking analysis (asibench: robotics.particle_filter).

Reads  : data/measurements.npz   (Y: (N,2) range/bearing, t, mask, metadata)
Writes : results/state_estimates.csv, results/filter_diagnostics.csv,
         results/summary.json, results/overview.png, results/conclusion.txt

Design (methodology approved by researcher, see conclusion.txt for details):
  * Channel identification from data (ch0 range-like nonnegative, ch1 bearing in (-pi,pi]).
  * Bootstrap particle filter, state s = [px, py, vx, vy, b_r, b_th] (sensor-bias
    augmentation, tight random-walk priors -> collapsible degrees of freedom).
  * Near-constant-velocity transition with time-window adaptive process noise q(t)
    (maneuver window detected by two-sided CUSUM on sliding-window pseudo-velocity).
  * Heavy-tailed (95/5) measurement mixtures for outlier tolerance; missing channels
    skipped in likelihood via mask; bearing handled with wrapped residuals.
  * N=600 particles (hard limit 1500), log-domain weights, systematic resampling
    when ESS < 0.5N. Filtered (not smoothed) posteriors in all required artifacts.
  * Truth is NOT public: rmse_pos / rmse_vel / nees are documented PROXIES against
    8-sigma-gated Cartesian pseudo-measurements (see conclusion.txt).
  * overview.png via matplotlib if importable, else a self-contained pure-numpy PNG
    renderer (identical 4-panel content). The used path is recorded in conclusion.txt.

Runs with no command-line arguments. Deterministic (fixed seeds).
"""
import json
import math
import os

import numpy as np

# ----------------------------------------------------------------------------- config
CFG = dict(
    N=1200,               # particles (main run; hard limit 1500; raised from 600
                          # because the MC control showed 600-particle sampling
                          # error was not << the measurement-noise floor)
    seed=0,               # main-run RNG seed
    ess_frac=0.5,         # resample when ESS < ess_frac * N
    p_out=0.03,           # outlier component weight in measurement mixtures
    tail_fac=15.0,        # outlier component sigma multiplier
    q_base=0.002,         # baseline per-step velocity process-noise std
    q_maneuver=0.03,      # inflated q inside detected maneuver window
    q_ramp=3,             # linear ramp steps at maneuver-window edges
    pad=3,                # symmetric padding (steps) added to maneuver window
    br_rw=2e-3,           # range-bias random-walk std per step
    bth_rw=2e-4,          # bearing-bias random-walk std per step
    br_prior=0.05,        # range-bias prior std
    bth_prior=0.02,       # bearing-bias prior std
    p0_sig=0.05,          # init position spread (matches pseudo-obs accuracy)
    v0_sig=0.08,          # init velocity spread
    gate=8.0,             # proxy-metric gating threshold (sigma)
    cov_jit=1e-9,         # jitter for covariance finiteness/positivity
)
BASE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(BASE, "data", "measurements.npz")
RESULTS = os.path.join(BASE, "results")


def wrap(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi


# ------------------------------------------------------------------- data reconnaissance
def prescan(data):
    """Data-driven pre-scan: sigmas, outlier gate, maneuver window, wrap metrics."""
    t, Y, m = data["t"], data["Y"], data["mask"]
    r, b = Y[:, 0], Y[:, 1]
    vr = np.where(m[:, 0])[0]
    vb = np.where(m[:, 1])[0]
    out = {}

    # noise sigmas from consecutive second differences (MAD-robust)
    def sig2(idx, y):
        dd = [y[i + 1] - 2 * y[i] + y[i - 1] for i in range(1, len(idx) - 1)
              if idx[i] - idx[i - 1] == 1 and idx[i + 1] - idx[i] == 1]
        dd = np.asarray(dd)
        return 1.4826 * np.median(np.abs(dd - np.median(dd))) / math.sqrt(6.0)

    yr = r[vr]
    yb = np.unwrap(b[vb])
    out["sigma_r"] = float(max(sig2(vr, yr), 0.01))
    out["sigma_b"] = float(max(sig2(vb, yb), 0.003))

    # LOO local-quadratic residual flags (>5 sigma) per channel
    def loo_quad(vals, tt2, half=6):
        res = np.empty(len(vals))
        for i in range(len(vals)):
            sel = np.arange(max(0, i - half), min(len(vals), i + half + 1))
            sel = sel[sel != i]
            c = np.polyfit(tt2[sel], vals[sel], 2)
            res[i] = vals[i] - np.polyval(c, tt2[i])
        return res

    fr = np.abs(loo_quad(yr, t[vr])) > 5.0 * out["sigma_r"]
    fb = np.abs(loo_quad(yb, t[vb])) > 5.0 * out["sigma_b"]
    flag_r = {int(vr[i]) for i in np.where(fr)[0]}
    flag_b = {int(vb[i]) for i in np.where(fb)[0]}
    out["flag_r"] = sorted(flag_r)
    out["flag_b"] = sorted(flag_b)
    gate_set = flag_r & flag_b          # co-occurring (paired) outliers
    out["gate_steps"] = sorted(gate_set)
    # second-pass sigma: exclude flagged triples (robust, one iteration)
    vr2 = np.array([i for i in vr if i not in gate_set])
    vb2 = np.array([i for i in vb if i not in gate_set])
    out["sigma_r"] = float(max(sig2(vr2, r[vr2]), 0.01))
    out["sigma_b"] = float(max(sig2(vb2, np.unwrap(b[vb2])), 0.003))

    # angle-wrapping: criterion A (principal-value jump > pi between consecutive
    # valid samples, gap-aware) and criterion B (multiples of pi crossed by the
    # unwrapped valid-bearing trajectory)
    db = np.diff(b[vb])
    pairs = [(int(vb[i]), int(vb[i + 1])) for i in np.where(np.abs(db) > np.pi)[0]]
    out["wrap_pairs_A"] = pairs
    out["wrap_count_A"] = len(pairs)
    lo, hi = float(yb.min()), float(yb.max())
    out["wrap_count_B"] = int(math.ceil(hi / math.pi) - math.floor(lo / math.pi) - 1)
    out["wrap_count_B"] = max(out["wrap_count_B"], 0)
    out["unwrap_min"], out["unwrap_max"] = lo, hi
    out["unwrap_total_shift_rad"] = float(yb[-1] - yb[0])

    # Cartesian pseudo-measurements (both channels valid)
    both = np.where(m[:, 0] & m[:, 1])[0]
    gated = np.array([i for i in both if i not in gate_set], dtype=int)
    out["gated_steps"] = gated
    px_all = r[both] * np.cos(b[both])
    py_all = r[both] * np.sin(b[both])
    out["pairs_all"] = (both, px_all, py_all)
    out["pairs_gated"] = (gated, r[gated] * np.cos(b[gated]), r[gated] * np.sin(b[gated]))

    # maneuver detection: sliding-window pseudo-velocity speed + CUSUM
    def win_vel(idx, xs, ys, half=4):
        tt = t[idx]
        V = np.empty((len(tt), 2))
        for i in range(len(tt)):
            lo_, hi_ = max(0, i - half), min(len(tt), i + half + 1)
            cx = np.polyfit(tt[lo_:hi_], xs[lo_:hi_], 1)
            cy = np.polyfit(tt[lo_:hi_], ys[lo_:hi_], 1)
            V[i] = (cx[0], cy[0])
        return V, tt

    Vg, tg = win_vel(out["pairs_gated"][0], out["pairs_gated"][1], out["pairs_gated"][2])
    sp = np.hypot(Vg[:, 0], Vg[:, 1])
    base = sp[:20]
    mu0 = float(np.median(base))
    s0 = float(1.4826 * np.median(np.abs(base - mu0)) + 1e-6)
    hi = sp > mu0 + 3.0 * s0                     # sustained-elevation run detector
    best = (None, -1)
    i = 0
    while i < len(tg):
        if hi[i]:
            j = i
            gap = 0
            k = i
            while k + 1 < len(tg):
                k += 1
                if hi[k]:
                    j = k; gap = 0
                else:
                    gap += 1
                    if gap > 2:
                        break
            if tg[j] - tg[i] > best[1]:
                best = ((int(tg[i]), int(tg[j])), tg[j] - tg[i])
            i = j + 1
        else:
            i += 1
    if best[0] is not None and best[1] >= 5.0:
        t1, t2 = best[0]
    else:                                        # fallback: two-sided CUSUM argmins
        S = np.cumsum(sp - mu0)
        i1, i2 = int(np.argmin(S)), int(np.argmax(S))
        t1, t2 = int(tg[min(i1, i2)]), int(tg[max(i1, i2)])
        if t2 <= t1 or mu0 + 3 * s0 > sp.max():  # no clear maneuver evidence
            t1, t2 = -10**6, -10**6
    out["maneuver"] = (max(0, t1 - CFG["pad"]), min(int(t[-1]), t2 + CFG["pad"]))
    out["speed_win"] = (tg, sp)
    out["vel_win_gated"] = (tg, Vg)   # for rmse_vel proxy (gated steps only)

    # time-varying process-noise schedule
    q = np.full(len(t), CFG["q_base"])
    if t2 > t1:
        a, bnd = out["maneuver"]
        inside = (t >= a) & (t <= bnd)
        q[inside] = CFG["q_maneuver"]
        for k in range(1, CFG["q_ramp"] + 1):
            lvl = (CFG["q_base"] + (CFG["q_maneuver"] - CFG["q_base"])
                   * (CFG["q_ramp"] - k + 1) / CFG["q_ramp"])
            for side_lo, side_hi in ((a - k, None), (None, bnd + k)):
                if side_lo is not None and 0 <= side_lo < len(t):
                    q[side_lo] = max(q[side_lo], lvl)
                if side_hi is not None and 0 <= side_hi < len(t):
                    q[side_hi] = max(q[side_hi], lvl)
    out["q"] = q
    return out


# ------------------------------------------------------------------ particle filter
def run_pf(data, pre, N, seed):
    rng = np.random.default_rng(seed)
    pre_gate = set(pre["gate_steps"])
    t, Y, m = data["t"], data["Y"], data["mask"]
    r, b = Y[:, 0], Y[:, 1]
    sr, sb = pre["sigma_r"], pre["sigma_b"]
    p_out, tail = CFG["p_out"], CFG["tail_fac"]
    q = pre["q"]
    dt = float(np.median(np.diff(t)))
    n = len(t)

    # ---- initialisation from first two gated Cartesian pairs (robust 2-point diff)
    g = pre["gated_steps"]
    i0 = int(g[0])
    i1 = int(next(i for i in g if i > i0))
    x0 = r[i0] * np.cos(b[i0]); y0 = r[i0] * np.sin(b[i0])
    x1 = r[i1] * np.cos(b[i1]); y1 = r[i1] * np.sin(b[i1])
    vx0 = (x1 - x0) / (t[i1] - t[i0]); vy0 = (y1 - y0) / (t[i1] - t[i0])
    ps, vs = CFG["p0_sig"], CFG["v0_sig"]
    X = np.empty((N, 6))
    X[:, 0] = x0 + rng.normal(0, ps, N)
    X[:, 1] = y0 + rng.normal(0, ps, N)
    X[:, 2] = vx0 + rng.normal(0, vs, N)
    X[:, 3] = vy0 + rng.normal(0, vs, N)
    X[:, 4] = rng.normal(0, CFG["br_prior"], N)
    X[:, 5] = rng.normal(0, CFG["bth_prior"], N)
    w = np.full(N, 1.0 / N)

    logN = -0.5 * (np.log(2 * np.pi) + 1.0)
    hist = {k: np.zeros((n, N)) for k in
            ("mean", "logw", "bearing_res")}
    out = dict(mean=np.zeros((n, 6)), cov=np.zeros((n, 6)),
               ess=np.zeros(n), resampled=np.zeros(n, int),
               entropy=np.zeros(n), maxlw=np.zeros(n), minlw=np.zeros(n),
               bres_mean=np.zeros(n), bres_std=np.zeros(n))

    pending_jit = (0.0, 0.0)
    for k in range(n):
        if k > 0:
            qk = q[k] * dt
            X[:, 0] += X[:, 2] * dt + rng.normal(0, qk * dt / math.sqrt(12.0), N)
            X[:, 1] += X[:, 3] * dt + rng.normal(0, qk * dt / math.sqrt(12.0), N)
            X[:, 2] += rng.normal(0, qk, N)
            X[:, 3] += rng.normal(0, qk, N)
            X[:, 4] += rng.normal(0, CFG["br_rw"], N)
            X[:, 5] += rng.normal(0, CFG["bth_rw"], N)
            jr, jt = pending_jit
            if jr > 0 or jt > 0:
                phi = np.arctan2(X[:, 1], X[:, 0])
                ur = np.column_stack([np.cos(phi), np.sin(phi)])
                ut = np.column_stack([-np.sin(phi), np.cos(phi)])
                if jr > 0:
                    X[:, :2] += ur * rng.normal(0, jr, (N, 1))
                if jt > 0:
                    X[:, :2] += ut * rng.normal(0, jt, (N, 1))
                vjit = 0.5 * max(jr, jt)
                X[:, 2] += rng.normal(0, vjit, N)
                X[:, 3] += rng.normal(0, vjit, N)

        lw = np.zeros(N)
        # --- range channel
        if m[k, 0]:
            rho = np.hypot(X[:, 0], X[:, 1]) + X[:, 4]
            d = r[k] - rho
            v1, v2 = sr * sr, (tail * sr) ** 2
            c1 = (1 - p_out) * math.exp(logN - math.log(sr))
            c2 = p_out * math.exp(logN - math.log(tail * sr))
            lw += np.log(c1 * np.exp(-0.5 * d * d / v1)
                         + c2 * np.exp(-0.5 * d * d / v2) + 1e-300)
        # --- bearing channel (wrapped residual, heavy-tailed mixture)
        if m[k, 1]:
            d = wrap(b[k] - (np.arctan2(X[:, 1], X[:, 0]) + X[:, 5]))
            v1, v2 = sb * sb, (tail * sb) ** 2
            c1 = (1 - p_out) * math.exp(logN - math.log(sb))
            c2 = p_out * math.exp(logN - math.log(tail * sb))
            lw += np.log(c1 * np.exp(-0.5 * d * d / v1)
                         + c2 * np.exp(-0.5 * d * d / v2) + 1e-300)

        lw_raw = lw.copy()          # uncentred log-densities for diagnostics
        lw -= lw.max()
        wl = np.exp(lw)
        tot = wl.sum()
        wn = wl / tot
        # diagnostics from NORMALISED weights (logw stored pre-normalisation, centred)
        ess = 1.0 / np.sum(wn * wn)
        ent = float(-np.sum(wn * np.log(wn + 1e-300)))
        out["mean"][k] = wn @ X
        var = wn @ (X * X) - out["mean"][k] ** 2
        out["cov"][k] = np.maximum(var, CFG["cov_jit"])
        out["ess"][k] = ess
        out["entropy"][k] = ent
        out["maxlw"][k] = float(lw_raw.max())
        out["minlw"][k] = float(lw_raw[wn > 1e-12].min())
        if not np.any(wn > 1e-12):
            out["minlw"][k] = float(lw_raw.min())
        # bearing residual (weighted circular mean/std over particles)
        if m[k, 1]:
            d = wrap(b[k] - (np.arctan2(X[:, 1], X[:, 0]) + X[:, 5]))
            cm, sm = np.sum(wn * np.cos(d)), np.sum(wn * np.sin(d))
            out["bres_mean"][k] = float(wrap(np.arctan2(sm, cm)))
            out["bres_std"][k] = float(np.sqrt(max(np.sum(wn * wrap(d - out["bres_mean"][k]) ** 2), 0.0)))
        # innovation-steered re-diversification for the next transition:
        # if the posterior mean is badly inconsistent with this frame's measurement,
        # spread particles along the offending measurement axis (regularised PF).
        jit_r = jit_t = 0.0
        cap = 0.4 if int(t[k]) in pre_gate else 1.2
        mu = wn @ X
        if m[k, 0]:
            Rh = math.hypot(mu[0], mu[1])
            e_r = r[k] - (Rh + mu[4])
            if abs(e_r) > 4.0 * sr:
                jit_r = min(0.8 * abs(e_r), cap)
        if m[k, 1]:
            Rh = max(math.hypot(mu[0], mu[1]), 1e-6)
            e_t = float(wrap(b[k] - (math.atan2(mu[1], mu[0]) + mu[5])))
            if abs(e_t) > 4.0 * sb:
                jit_t = min(0.8 * abs(e_t) * Rh, cap)

        # resample
        if ess < CFG["ess_frac"] * N:
            pos = (rng.random() + np.arange(N)) / N
            cum = np.cumsum(wn)
            cum[-1] = 1.0
            idx = np.searchsorted(cum, pos)
            idx = np.clip(idx, 0, N - 1)
            X = X[idx]
            # regularisation (roughening): scale-tied jitter to fight impoverishment
            for d, cap, floor in ((0, 0.05, 0.01), (1, 0.05, 0.01),
                                  (2, 0.025, 0.004), (3, 0.025, 0.004)):
                sd_pop = float(np.std(X[:, d]))
                X[:, d] += rng.normal(0, max(min(0.15 * sd_pop, cap), floor), N)
            X[:, 4] += rng.normal(0, CFG["br_rw"], N)
            X[:, 5] += rng.normal(0, CFG["bth_rw"], N)
            w = np.full(N, 1.0 / N)
            out["resampled"][k] = 1
        else:
            w = wn
        pending_jit = (jit_r, jit_t)
    out["degeneracy"] = bool(out["ess"].min() < 0.05 * N)
    return out


# --------------------------------------------------------------- proxy error metrics
def proxy_metrics(data, pre, est):
    """Truth is unavailable: these are PROXIES (documented in conclusion.txt)."""
    t, Y, m = data["t"], data["Y"], data["mask"]
    r, b = Y[:, 0], Y[:, 1]
    sr, sb = pre["sigma_r"], pre["sigma_b"]
    gate = CFG["gate"]
    n = len(t)
    mean, cov = est["mean"], est["cov"]
    gated = set(int(i) for i in pre["gated_steps"])
    both = set(int(i) for i in pre["pairs_all"][0])

    rmse_pos = np.zeros(n)
    rmse_vel = np.zeros(n)
    floor2 = np.zeros(n)           # noise floor^2 of the rmse_pos proxy per frame
    nees = np.zeros(n)
    nees_iv = np.zeros(n)          # innovation-covariance variant (reported only)
    avail = np.zeros(n, bool)          # any measurement information at frame k
    pos_avail = np.zeros(n, bool)      # pos-proxy available
    nees_avail = np.zeros(n, bool)
    gated_used, gate_excluded = [], []

    tg, Vg = pre["vel_win_gated"]
    vel_at = {int(a): Vg[i] for i, a in enumerate(tg)}

    for k in range(n):
        vx_, vy_ = mean[k, 0], mean[k, 1]
        cxx, cyy, cxy = cov[k, 0], cov[k, 1], None
        P = np.array([[cov[k, 0], 0.0], [0.0, cov[k, 1]]])
        C6 = np.diag(cov[k])
        if k in both:
            xz = r[k] * np.cos(b[k]); yz = r[k] * np.sin(b[k])
            dxy = np.array([xz - vx_, yz - vy_])
            avail[k] = True
            if k in gated:
                gated_used.append(k)
                pos_avail[k] = True
                Pi = np.linalg.inv(P + CFG["cov_jit"] * np.eye(2))
                nees[k] = float(np.clip(dxy @ Pi @ dxy, 0.0, 1e6))
                th = math.atan2(yz, xz)
                Jh = np.array([[math.cos(th), -math.hypot(xz, yz) * math.sin(th)],
                               [math.sin(th), math.hypot(xz, yz) * math.cos(th)]])
                Rz = Jh @ np.diag([sr * sr, sb * sb]) @ Jh.T
                Si = np.linalg.inv(P + Rz + CFG["cov_jit"] * np.eye(2))
                nees_iv[k] = float(np.clip(dxy @ Si @ dxy, 0.0, 1e6))
                nees_avail[k] = True
                rmse_pos[k] = float(np.hypot(*dxy))
                floor2[k] = sr * sr + (math.hypot(xz, yz) * sb) ** 2
            else:
                gate_excluded.append(k)
        elif m[k, 0]:                                  # range only
            R = max(math.hypot(vx_, vy_), 1e-6)
            u = np.array([vx_ / R, vy_ / R])
            d = r[k] - (R + mean[k, 4])
            J = np.array([u[0], u[1], 1.0, 0.0, 0.0, 0.0])
            proj = float(J @ C6 @ J)
            avail[k] = pos_avail[k] = nees_avail[k] = True
            rmse_pos[k] = abs(float(d))                # ||J_pos|| = 1
            nees[k] = float(np.clip(d * d / (proj + CFG["cov_jit"]), 0.0, 1e6))
            nees_iv[k] = float(np.clip(d * d / (proj + sr * sr), 0.0, 1e6))
            floor2[k] = sr * sr
        elif m[k, 1]:                                  # bearing only
            R = max(math.hypot(vx_, vy_), 1e-6)
            d = float(wrap(b[k] - (math.atan2(vy_, vx_) + mean[k, 5])))
            J = np.array([-vy_ / (R * R), vx_ / (R * R), 0.0, 0.0, 0.0, 1.0])
            proj = float(J @ C6 @ J)
            avail[k] = pos_avail[k] = nees_avail[k] = True
            rmse_pos[k] = abs(d) * R                   # |d| / ||J_pos|| (distance units)
            nees[k] = float(np.clip(d * d / (proj + CFG["cov_jit"]), 0.0, 1e6))
            nees_iv[k] = float(np.clip(d * d / (proj + sb * sb), 0.0, 1e6))
            floor2[k] = (R * sb) ** 2
        if k in vel_at:
            v = vel_at[k]
            rmse_vel[k] = float(math.hypot(mean[k, 2] - v[0], mean[k, 3] - v[1]))
        else:
            rmse_vel[k] = 0.0                          # documented finite fallback
    # ungated comparison: also use non-gated valid pairs (residuals only, no NEES)
    ung = []
    for k in sorted(both):
        xz = r[k] * np.cos(b[k]); yz = r[k] * np.sin(b[k])
        ung.append(math.hypot(xz - mean[k, 0], yz - mean[k, 1]))
    floor_rms = float(np.sqrt(np.mean(floor2[pos_avail])))
    pos_rmse = float(np.sqrt(np.mean(rmse_pos[pos_avail] ** 2)))
    vel_rmse = float(np.sqrt(np.mean(rmse_vel[rmse_vel > 0] ** 2)))
    nn = nees[nees_avail]
    nniv = nees_iv[nees_avail]
    ungated_pos_rmse = float(np.sqrt(np.mean(np.square(ung)))) if ung else 0.0
    return dict(rmse_pos=rmse_pos, rmse_vel=rmse_vel, nees=nees, nees_iv=nees_iv,
                floor_rms=floor_rms,
                mean_nees_iv=float(nniv.mean()), median_nees_iv=float(np.median(nniv)),
                nees_clipped=int(np.sum(nn >= 1e6 - 1)),
                nees_top_frames=[int(i) for i in np.argsort(-nees)[:5]],
                pos_avail=pos_avail, nees_avail=nees_avail,
                pos_rmse=pos_rmse, vel_rmse=vel_rmse,
                mean_nees=float(nn.mean()), median_nees=float(np.median(nn)),
                gated_used=len(gated_used), gate_excluded=gate_excluded,
                ungated_pos_rmse=ungated_pos_rmse)


