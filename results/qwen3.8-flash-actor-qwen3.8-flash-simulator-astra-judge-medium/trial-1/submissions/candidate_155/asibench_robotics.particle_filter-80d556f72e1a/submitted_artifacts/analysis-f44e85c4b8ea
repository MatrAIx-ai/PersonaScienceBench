def render_png_matplotlib(path, ctx):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    t = ctx["t"]
    fig, axs = plt.subplots(2, 2, figsize=(12.5, 8.5))
    ax = axs[0, 0]
    ax.plot(ctx["pz"][:, 0], ctx["pz"][:, 1], '.', color="0.7", ms=4, label="pseudo-obs (all)")
    ax.plot(ctx["pg"][:, 0], ctx["pg"][:, 1], '.', color="tab:blue", ms=4, label="pseudo-obs (gated)")
    ax.plot(ctx["xy"][:, 0], ctx["xy"][:, 1], '-', color="tab:red", lw=1.5, label="filtered")
    ax.plot(0.0, 0.0, 'k+', ms=10, label="sensor origin")
    ax.set_title("XY plane (no ground truth available)")
    ax.set_xlabel("x"); ax.set_ylabel("y"); ax.axis("equal"); ax.legend(fontsize=7)
    ax = axs[0, 1]
    ok, okb = ctx["mr"], ctx["mb"]
    ax.plot(t[ok], ctx["r"][ok], '.', color="tab:blue", ms=4, label="range obs")
    ax.plot(t, ctx["rfit"], '-', color="tab:red", lw=1.2, label="range fit")
    ax.plot(t[okb], ctx["b"][okb], '.', color="tab:green", ms=4, label="bearing obs")
    ax.plot(t, ctx["bfit"], '-', color="tab:orange", lw=1.2, label="bearing fit")
    ax.set_title("channels: observations vs filtered predictions")
    ax.set_xlabel("t"); ax.legend(fontsize=7)
    ax = axs[1, 0]
    ax.plot(t, ctx["nees"], '-', color="tab:purple", lw=1.2, label="NEES proxy")
    ax.plot(t, ctx["rmse_pos"], '-', color="tab:red", lw=1.2, label="rmse_pos proxy")
    ax.set_xlabel("t"); ax.set_title("NEES / rmse_pos proxies")
    ax2 = ax.twinx()
    ax2.plot(t, ctx["ess"], '-', color="tab:blue", lw=1.0, label="ESS")
    ax2.set_ylabel("ESS"); ax.legend(fontsize=7, loc="upper left")
    ax = axs[1, 1]
    ax.plot(t, ctx["entropy"], '-', color="tab:blue", lw=1.2, label="weight entropy")
    res_t = t[ctx["resampled"].astype(bool)]
    ax.vlines(res_t, 0, np.log(ctx["N"]), color="tab:orange", lw=0.8, label="resampled")
    ax.set_xlabel("t"); ax.set_title("weight entropy and resampling events")
    ax.legend(fontsize=7)
    fig.tight_layout()
    fig.savefig(path, dpi=110)
    plt.close(fig)


# ------------------------------------------------------------------------- main
def main():
    os.makedirs(RESULTS, exist_ok=True)
    os.makedirs(os.path.join(BASE, "scratch"), exist_ok=True)
    data = dict(np.load(DATA, allow_pickle=False))
    pre = prescan(data)
    t = data["t"]
    n = len(t)

    # ---- main run + Monte-Carlo stability controls (not required artifacts)
    main_run = run_pf(data, pre, CFG["N"], CFG["seed"])
    mc = [dict(tag=f"N={CFG['N']} seed={CFG['seed']} (main)", N=CFG["N"], seed=CFG["seed"])]
    for tag_, N_, sd_ in ((f"N=600 seed={CFG['seed']} (reduced)", 600, CFG["seed"]),
                          (f"N={CFG['N']} seed=1", CFG["N"], 1),
                          (f"N={CFG['N']} seed=2", CFG["N"], 2)):
        e = run_pf(data, pre, N_, sd_)
        px_ = proxy_metrics(data, pre, e)
        mc.append(dict(tag=tag_, N=N_, seed=sd_,
                       pos_rmse=px_["pos_rmse"], mean_nees=px_["mean_nees"],
                       ess_min=float(e["ess"].min())))
    est = main_run
    pxm = proxy_metrics(data, pre, est)
    mc[0].update(pos_rmse=pxm["pos_rmse"], mean_nees=pxm["mean_nees"],
                 ess_min=float(est["ess"].min()))

    # ---- filtered jitter check on maneuver/close-approach segment t in [30,45]
    xy = est["mean"][:, :2]
    j3 = np.diff(xy, 3, axis=0)
    seg = (t[:-3] >= 30) & (t[:-3] <= 45)
    jit_in = float(np.sqrt(np.mean(np.sum(j3[seg] ** 2, axis=1)))) if seg.any() else 0.0
    jit_out = float(np.sqrt(np.mean(np.sum(j3[~seg] ** 2, axis=1)))) if (~seg).any() else 0.0

    # ---- numeric hygiene: all required outputs finite
    mean, cov = est["mean"], est["cov"]
    state_cols = np.column_stack([t, mean[:, 0], mean[:, 1], mean[:, 2], mean[:, 3],
                                  cov[:, 0], cov[:, 1], cov[:, 2], cov[:, 3]])
    diag_cols = np.column_stack([t, pxm["rmse_pos"], pxm["rmse_vel"], pxm["nees"],
                                 est["ess"], est["resampled"], est["entropy"],
                                 est["maxlw"], est["minlw"],
                                 est["bres_mean"], est["bres_std"]])
    assert state_cols.shape == (95, 9) and diag_cols.shape == (95, 11) or \
        (state_cols.shape[0] == n and diag_cols.shape[0] == n)
    assert np.isfinite(state_cols).all() and np.isfinite(diag_cols).all()
    assert (cov >= 0).all()
    assert np.array_equal(state_cols[:, 0], t) and np.array_equal(diag_cols[:, 0], t)

    import csv as _csv
    with open(os.path.join(RESULTS, "state_estimates.csv"), "w", newline="") as f:
        wtr = _csv.writer(f)
        wtr.writerow(["t", "px", "py", "vx", "vy", "cov_px", "cov_py", "cov_vx", "cov_vy"])
        for row in state_cols:
            wtr.writerow(["%.10g" % v for v in row])
    with open(os.path.join(RESULTS, "filter_diagnostics.csv"), "w", newline="") as f:
        wtr = _csv.writer(f)
        wtr.writerow(["t", "rmse_pos", "rmse_vel", "nees", "ess", "resampled",
                      "weight_entropy", "max_log_weight", "min_log_weight",
                      "bearing_residual_mean", "bearing_residual_std"])
        for i, row in enumerate(diag_cols):
            rr = [v for v in row]
            rr[5] = int(est["resampled"][i])
            wtr.writerow(["%.10g" % v if j != 5 else str(rr[j]) for j, v in enumerate(rr)])

    # ---- summary.json
    wrap_count = pre["wrap_count_A"]
    summary = {
        "pos_rmse": pxm["pos_rmse"],
        "vel_rmse": pxm["vel_rmse"],
        "mean_nees": pxm["mean_nees"],
        "median_nees": pxm["median_nees"],
        "ess_min": float(est["ess"].min()),
        "ess_mean": float(est["ess"].mean()),
        "resampling_count": int(est["resampled"].sum()),
        "weight_degeneracy_detected": bool(est["degeneracy"]),
        "used_log_weights": True,
        "angle_wrapping_detected": bool(pre["wrap_count_A"] > 0),
        "angle_wrap_event_count": int(wrap_count),
    }
    for k, v in summary.items():
        if isinstance(v, float):
            assert math.isfinite(v), k
    with open(os.path.join(RESULTS, "summary.json"), "w") as f:
        json.dump(summary, f, indent=2)

    # ---- overview.png (matplotlib if available, else fallback renderer)
    r = data["Y"][:, 0]; b = data["Y"][:, 1]; m = data["mask"]
    Rf = np.hypot(mean[:, 0], mean[:, 1]) + mean[:, 4]
    Bf = wrap(np.arctan2(mean[:, 1], mean[:, 0]) + mean[:, 5])
    both_idx = pre["pairs_all"][0]
    pz = np.column_stack([r[both_idx] * np.cos(b[both_idx]), r[both_idx] * np.sin(b[both_idx])])
    gs = pre["gated_steps"]
    pg = np.column_stack([r[gs] * np.cos(b[gs]), r[gs] * np.sin(b[gs])])
    ctx = dict(t=t, xy=xy, pz=pz, pg=pg, r=r, b=b, mr=m[:, 0], mb=m[:, 1],
               rfit=Rf, bfit=Bf, nees=pxm["nees"], rmse_pos=pxm["rmse_pos"],
               ess=est["ess"], entropy=est["entropy"], resampled=est["resampled"],
               N=CFG["N"])
    png_path = os.path.join(RESULTS, "overview.png")
    try:
        import matplotlib  # noqa: F401
        render_png_matplotlib(png_path, ctx)
        png_path_used = "matplotlib"
    except Exception:
        render_png_fallback(png_path, ctx)
        png_path_used = "fallback-pure-numpy"

    # ---- conclusion.txt
    write_conclusion(data, pre, est, pxm, summary, mc, png_path_used,
                     jit_in, jit_out)
    print("done:", png_path_used, "pos_rmse=%.4f mean_nees=%.2f ess_min=%.1f" %
          (pxm["pos_rmse"], pxm["mean_nees"], est["ess"].min()))


def write_conclusion(data, pre, est, pxm, summary, mc, png_path_used, jit_in, jit_out):
    t = data["t"]; m = data["mask"]
    mean, cov = est["mean"], est["cov"]
    miss_r = np.where(~m[:, 0])[0]; miss_b = np.where(~m[:, 1])[0]
    br_end, br_sd = mean[-1, 4], math.sqrt(cov[-1, 4])
    bt_end, bt_sd = mean[-1, 5], math.sqrt(cov[-1, 5])
    bias_collapsed = (abs(br_end) < 3 * CFG["br_prior"] and abs(bt_end) < 3 * CFG["bth_prior"])
    br_tight = math.sqrt(cov[-1, 4]) < 0.6 * CFG["br_prior"]
    bt_tight = math.sqrt(cov[-1, 5]) < 0.6 * CFG["bth_prior"]
    lines = []
    A = lines.append
    A("CONCLUSION - deterministic particle-filter analysis of data/measurements.npz")
    A("=" * 72)
    A("")
    A("[1] DATA FACTS (directly supported)")
    A("  Arrays: Y (95,2) float64, t (95,) float64, mask (95,2) bool, metadata str.")
    A("  t = 0..94, uniform dt = 1.0, total duration 94.")
