class Raster:
    """Tiny pure-numpy plotting raster with 5x7 bitmap font; writes RGB PNG."""

    def __init__(self, w, h):
        self.w, self.h = w, h
        self.buf = np.full((h, w, 3), 255, np.uint8)

    def px(self, x, y, c):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.buf[y, x] = c

    def line(self, x0, y0, x1, y1, c, wid=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        while True:
            for i in range(wid):
                for j in range(wid):
                    self.px(x0 + i, y0 + j, c)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy; x0 += sx
            if e2 <= dx:
                err += dx; y0 += sy

    def rect(self, x0, y0, x1, y1, c, wid=1):
        self.line(x0, y0, x1, y0, c, wid); self.line(x0, y1, x1, y1, c, wid)
        self.line(x0, y0, x0, y1, c, wid); self.line(x1, y0, x1, y1, c, wid)

    def dot(self, x, y, c, rad=2):
        for dx in range(-rad, rad + 1):
            for dy in range(-rad, rad + 1):
                if dx * dx + dy * dy <= rad * rad:
                    self.px(int(x) + dx, int(y) + dy, c)

    def text(self, x, y, s, c=(0, 0, 0), sc=1):
        cx = int(x)
        for ch in s.upper():
            g = _FONT.get(ch, _FONT[' '])
            for gy, row in enumerate(g):
                for gx, p in enumerate(row):
                    if p == '#':
                        for iy in range(sc):
                            for ix in range(sc):
                                self.px(cx + gx * sc + ix, int(y) + gy * sc + iy, c)
            cx += 6 * sc
        return cx


class Axes:
    def __init__(self, rs, x0, y0, x1, y1):
        self.rs, self.x0, self.y0, self.x1, self.y1 = rs, x0, y0, x1, y1
        self.dlo = self.dhi = None

    def set_range(self, xlo, xhi, ylo, yhi):
        pad = 0.05 * (yhi - ylo + 1e-12)
        self.dlo, self.dhi = (xlo, xhi), (ylo - pad, yhi + pad)

    def T(self, x, y):
        (xlo, xhi), (ylo, yhi) = self.dlo, self.dhi
        px = self.x0 + (np.asarray(x, float) - xlo) / (xhi - xlo + 1e-12) * (self.x1 - self.x0)
        py = self.y1 - (np.asarray(y, float) - ylo) / (yhi - ylo + 1e-12) * (self.y1 - self.y0)
        return px, py

    def frame(self):
        self.rs.rect(self.x0, self.y0, self.x1, self.y1, (0, 0, 0))

    def ticks(self, nx=5, ny=5):
        (xlo, xhi), (ylo, yhi) = self.dlo, self.dhi
        for i in range(nx + 1):
            xv = xlo + (xhi - xlo) * i / nx
            px, _ = self.T(xv, ylo)
            self.rs.line(px, self.y1, px, self.y1 + 4, (0, 0, 0))
            self.rs.text(px - 10, self.y1 + 6, f"{xv:.4g}", (60, 60, 60))
        for i in range(ny + 1):
            yv = ylo + (yhi - ylo) * i / ny
            _, py = self.T(xlo, yv)
            self.rs.line(self.x0 - 4, py, self.x0, py, (0, 0, 0))
            self.rs.text(self.x0 - 46, py - 3, f"{yv:.4g}", (60, 60, 60))

    def series(self, xs, ys, c, wid=1):
        px, py = self.T(xs, ys)
        for i in range(len(xs) - 1):
            self.rs.line(px[i], py[i], px[i + 1], py[i + 1], c, wid)

    def scatter(self, xs, ys, c, rad=2):
        px, py = self.T(xs, ys)
        for a, b in zip(px, py):
            self.rs.dot(a, b, c, rad)


def _nice_range(a, b):
    if not np.isfinite(a) or not np.isfinite(b):
        return 0.0, 1.0
    if a == b:
        return a - 0.5, b + 0.5
    return float(a), float(b)


