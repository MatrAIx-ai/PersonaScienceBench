            robust_cost_cauchy_k1_pre=cost_pre,
            robust_cost_cauchy_k1_post=cost_post,
            odom_rmse_trans_m_pre=0.0, odom_rmse_trans_m_post=odom_rmse_t,
            odom_rmse_rot_rad_pre=0.0, odom_rmse_rot_rad_post=odom_rmse_r,
            accepted_loop_rmse_trans_m_pre=float(np.sqrt(np.mean(
                np.sum(pre_acc[:, :2] ** 2, 1)))),
            accepted_loop_rmse_trans_m_post=loop_rmse_t,
            accepted_loop_rmse_rot_rad_pre=float(np.sqrt(np.mean(pre_acc[:, 2] ** 2))),
            accepted_loop_rmse_rot_rad_post=loop_rmse_r,
            pose_shift_vs_initial_mean_m=float(shift.mean()),
            pose_shift_vs_initial_max_m=float(shift.max()),
            total_runtime_s=round(time.monotonic() - T0, 2)),
        outputs=dict(
            poses_npy=("[544,3] float64 [x_m,y_m,theta_rad]; theta wrapped "
                       "to +-pi; pose0 = world anchor [0, 0, 0.35]"),
            loop_closure_scores_csv=("columns loop_id,false_probability; 55 "
                                     "rows; ids identical to data/loop_candidates.csv"),
            extra_files="loop_closure_scores_chi2_alt.csv (chi2-tail alternative)",
            png_generation=("pure-numpy grayscale rasterizer + zlib PNG "
                            "writer; matplotlib unavailable offline "
                            "(researcher-approved compromise); ASCII-only "
                            "3x5 stroke vector font")))

    assert np.all(np.isfinite(Xfinal)) and Xfinal.shape == (544, 3)
    np.save("poses.npy", Xfinal.astype(np.float64))
    with open("loop_closure_scores.csv", "w") as f:
        f.write("loop_id,false_probability\n")
        for lid, p in zip(loops["id"], p_main):
            f.write(f"{int(lid)},{p:.6f}\n")
    with open("loop_closure_scores_chi2_alt.csv", "w") as f:
        f.write("loop_id,false_prob_chi2_alt\n")
        for lid, p in zip(loops["id"], p_alt):
            f.write(f"{int(lid)},{p:.6f}\n")
    json.dump(metrics, open("metrics.json", "w"), indent=2)
    make_png(P0, Xfinal, loops, d_final, inl_mask, "map_diagnostics.png")

    print("selected:", best_name, " objective %.3f" % vals[bi])
    print("inliers:", int(inl_mask.sum()), " false:", int((~inl_mask).sum()))
    print("inlier d mean %.2f std %.2f rms %.2f max %.2f | false d %.2f..%.1f"
          % (d_in.mean(), d_in.std(), inl_chi2_rms, d_in.max(),
             d_out.min(), d_out.max()))
    print("next d after last inlier: %.2f" % next_d)
    print("odom z std %.2f  |z|>3: %d  inflation: %s" % (s_od, z_stats["n_absz_gt3"], relaxed))
    print("odom rmse post %.4f m / %.4f rad" % (odom_rmse_t, odom_rmse_r))
    print("accepted loop rmse %.2f m -> %.3f m" % (
        np.sqrt(np.mean(np.sum(pre_acc[:, :2] ** 2, 1))), loop_rmse_t))
    print("pose shift mean/max %.2f / %.2f m" % (shift.mean(), shift.max()))
    print("all 61 candidates agree within 0.1 m:", all_agree,
          " worst rms %.3f m" % worst[0]["trans_rms_vs_best_m"])
    print("reverse probe: obj %.2f inl %d rms %.3f m" % (
        cf_diag["reverse_probe_objective"], cf_diag["reverse_probe_inliers"],
        cf_diag["reverse_probe_rms_to_forward_m"]))
    print("mismatch main vs alt:", int(mism.sum()))
    print("runtime s:", round(time.monotonic() - T0, 2))
    return metrics


