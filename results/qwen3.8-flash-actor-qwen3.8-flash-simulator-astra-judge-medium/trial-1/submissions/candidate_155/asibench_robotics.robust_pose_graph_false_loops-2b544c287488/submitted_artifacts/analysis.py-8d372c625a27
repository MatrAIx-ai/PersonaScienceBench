def draw_hist_panel(c, d, inl_mask, x0, y0, x1, y1):
    c.box(x0, y0, x1, y1)
    dmax = max(8.0, math.ceil(float(d.max())))
    nb = 24
    edges = np.linspace(0, dmax, nb + 1)
    bin_in = np.histogram(d[inl_mask], bins=edges)[0]
    bin_out = np.histogram(d[~inl_mask], bins=edges)[0]
    cmax = max(int((bin_in + bin_out).max()), 1)
    pw, ph = x1 - x0, y1 - y0
    for k in range(nb):
        bx0 = x0 + pw * k / nb + 1
        bx1 = x0 + pw * (k + 1) / nb - 1
        h_in = ph * bin_in[k] / cmax
        h_to = ph * (bin_in[k] + bin_out[k]) / cmax
        if bin_out[k]:
            c.rect(bx0, y1 - h_to, bx1, y1 - h_in - 1, v=170)
        if bin_in[k]:
            c.rect(bx0, y1 - h_in, bx1, y1, v=60)
    tx = x0 + pw * 2.5 / dmax
    c.line(tx, y0, tx, y1, v=0, t=1, dash=(4, 3))
    c.text(tx + 3, y0 + 6, "THRESHOLD D = 2.5", sc=1)
    for tv in np.linspace(0, dmax, 5):
        txp = x0 + pw * tv / dmax
        c.line(txp, y1, txp, y1 + 4)
        c.text(txp - 8, y1 + 7, fmt(tv, 1), sc=1)
    c.text(x0, y0 - 14, "LOOP NORMALIZED RESIDUAL HISTOGRAM", sc=2)
    c.text(x1 - 160, y0 + 6, "DARK=INLIER  LIGHT=FALSE", sc=1)
