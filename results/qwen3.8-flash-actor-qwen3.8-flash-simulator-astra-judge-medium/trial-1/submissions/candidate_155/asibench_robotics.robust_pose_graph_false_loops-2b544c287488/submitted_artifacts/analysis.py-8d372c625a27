        gnc_schedule=dict(k0=[32.0, 64.0, 16.0, 128.0], mu=[1.3, 1.3, 1.5, 1.4],
                          kmin=1.0, threshold_d=dthr,
                          selected_schedule=best_name,
                          kappa_ladder=[st["kappa"] for st in strev],
                          odometry="linear backbone (no kernel)"),
        scores=dict(
            irls_hit_freq_per_loop=[round(float(v), 3) for v in irls_hit],
