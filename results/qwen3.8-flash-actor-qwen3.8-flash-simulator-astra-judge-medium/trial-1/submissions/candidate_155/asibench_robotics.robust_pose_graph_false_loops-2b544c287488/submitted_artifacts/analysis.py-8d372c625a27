def wrap(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi


# ------------------------------------------------------------------ data
def load_data():
    info = json.load(open("data/task_info.json"))
    P0 = np.load("data/poses_initial.npy").astype(np.float64)
    assert P0.shape == (info["num_poses"], 3), P0.shape

    def read(path, idcol):
        rows = list(csv.DictReader(open(path)))
        return dict(
            id=np.array([int(r[idcol]) for r in rows]),
            i=np.array([int(r["from"]) for r in rows]),
            j=np.array([int(r["to"]) for r in rows]),
            z=np.array([[float(r["dx"]), float(r["dy"]), float(r["dtheta"])]
                        for r in rows]),
            st=np.array([float(r["sigma_trans"]) for r in rows]),
            sr=np.array([float(r["sigma_rot"]) for r in rows]),
        )

    odom = read("data/odometry_edges.csv", "edge_id")
    loops = read("data/loop_candidates.csv", "loop_id")
    assert np.all(odom["i"] == np.arange(len(odom["i"])))
    assert np.all(odom["j"] == odom["i"] + 1)
    return info, P0, odom, loops


# ------------------------------------------------------------ residuals
def edge_err(X, E):
    """Normalized dimensionless edge errors [m,3]."""
    i, j = E["i"], E["j"]
    dpx, dpy = X[j, 0] - X[i, 0], X[j, 1] - X[i, 1]
    c, s = np.cos(X[i, 2]), np.sin(X[i, 2])
    ex = (c * dpx + s * dpy - E["z"][:, 0]) / E["st"]
    ey = (-s * dpx + c * dpy - E["z"][:, 1]) / E["st"]
    et = wrap(X[j, 2] - X[i, 2] - E["z"][:, 2]) / E["sr"]
    return np.stack([ex, ey, et], axis=1)


def edge_jac(X, E):
    """Per-edge flat [m,9] jacobian blocks wrt pose i / pose j."""
    i, j = E["i"], E["j"]
    dpx, dpy = X[j, 0] - X[i, 0], X[j, 1] - X[i, 1]
    c, s = np.cos(X[i, 2]), np.sin(X[i, 2])
    z = np.zeros_like(c)
    one = 1.0 / E["sr"]
    # d(e_t)/d(theta_i) = -s*dx + c*dy ; d(e_n)/d(theta_i) = -c*dx - s*dy
    ret_t = -s * dpx + c * dpy
    ret_n = -c * dpx - s * dpy
    Bi = np.stack([-c, -s, ret_t, s, -c, ret_n, z, z, -one], axis=1)
    Bj = np.stack([c, s, z, -s, c, z, z, z, one], axis=1)
    # flat (m,9) layout rows [0,1,2]x[dx,dy,dth]: translational columns 0,1,3,4
    for col in (0, 1, 2, 3, 4, 5):   # rows 0-1 are translational (/st)
        Bi[:, col] /= E["st"]
        Bj[:, col] /= E["st"]
    return Bi, Bj


def edge_d(X, E):
    return np.linalg.norm(edge_err(X, E), axis=1)


def raw_edge_err(X, E):
    """Un-normalized edge errors [m,3] (m, m, rad)."""
    i, j = E["i"], E["j"]
    dpx, dpy = X[j, 0] - X[i, 0], X[j, 1] - X[i, 1]
    c, s = np.cos(X[i, 2]), np.sin(X[i, 2])
    ex = c * dpx + s * dpy - E["z"][:, 0]
    ey = -s * dpx + c * dpy - E["z"][:, 1]
    et = wrap(X[j, 2] - X[i, 2] - E["z"][:, 2])
    return np.stack([ex, ey, et], axis=1)


def wcauchy(d2, k, sel):
    return np.where(sel, k * k / (k * k + d2), 0.0)


def cost_weighted(X, odom, loops, wo, wl):
    eo, el = edge_err(X, odom), edge_err(X, loops)
    return float(np.sum(wo * np.sum(eo ** 2, 1)) + np.sum(wl * np.sum(el ** 2, 1)))


def cost_cauchy(X, odom, loops, k, sel_od, sel_lp):
    eo, el = edge_err(X, odom), edge_err(X, loops)
    do2, dl2 = np.sum(eo ** 2, 1), np.sum(el ** 2, 1)
    return float(np.sum(np.where(sel_od, k ** 2 * np.log1p(do2 / k ** 2), 0.0)) +
                 np.sum(np.where(sel_lp, k ** 2 * np.log1p(dl2 / k ** 2), 0.0)))


# --------------------------------------------------------- GN machinery
ROW_B = np.repeat(np.arange(3)[None, :], 3, axis=1).ravel()   # residual row per entry
COL_Q = np.tile(np.arange(3), 3)                              # dof per entry


def linear_step(X, odom, loops, wo, wl):
    """One linearized solve with fixed weights; pose-0 dofs removed."""
    eo, el = edge_err(X, odom), edge_err(X, loops)
    BiO, BjO = edge_jac(X, odom)
    BiL, BjL = edge_jac(X, loops)
    so, sl = np.sqrt(wo), np.sqrt(wl)
    er = np.concatenate([(eo * so[:, None]).ravel(), (el * sl[:, None]).ravel()])
    rows, cols, vals = [], [], []

    def add(E, Bi, Bj, r0, sw):
        m = len(E["i"])
        row_idx = (r0 + 3 * np.arange(m)[:, None] + ROW_B[None, :]).ravel()
        for B, P in ((Bi, E["i"]), (Bj, E["j"])):
            col_idx = (3 * P[:, None] + COL_Q[None, :]).ravel()
            v = (B * sw[:, None]).ravel()
            bad = col_idx < 3            # pose-0 dofs: dropped (hard gauge)
            rows.append(row_idx)
            cols.append(np.where(bad, 0, col_idx - 3))
            vals.append(np.where(bad, 0.0, v))

    add(odom, BiO, BjO, 0, so)
    add(loops, BiL, BjL, 3 * eo.shape[0], sl)
    J = sp.csr_matrix((np.concatenate(vals),
                       (np.concatenate(rows), np.concatenate(cols))),
                      shape=(er.size, X.size - 3))
    g = J.T @ er
    H = (J.T @ J).tocsc()
    try:
        step = spl.spsolve(H, -g)
    except Exception:
        return None
    if not np.all(np.isfinite(step)):
        return None
    return step


def gn_run(X, odom, loops, wfun, X0, iters=40, tol=1e-10):
    """Gauss-Newton with backtracking; weights from wfun(X) each round.
    The step covers poses 1..N-1 (pose 0 pinned to X0)."""
    X = X.copy()
    X[0] = X0
    nit = 0
    for _ in range(iters):
        wo, wl = wfun(X)
        step = linear_step(X, odom, loops, wo, wl)
        if step is None:
            break
        s = step.reshape(-1, 3)
        c0 = cost_weighted(X, odom, loops, wo, wl)
        alpha, Xt = 1.0, X
        for _ in range(6):
            Xt = X.copy()
            Xt[1:, :2] += alpha * s[:, :2]
            Xt[1:, 2] = wrap(Xt[1:, 2] + alpha * s[:, 2])
            if cost_weighted(Xt, odom, loops, wo, wl) <= c0 + 1e-12:
                break
            alpha *= 0.5
        X = Xt
        nit += 1
        if alpha * np.linalg.norm(step) < tol:
            break
    return X, nit


def gnc(Xs, odom, loops, X0, k0, mu, kmin=1.0, dthr=2.5, iters=15, sel_lp=None):
    """Graduated non-convexity, Cauchy weights; sel_lp restricts active loops."""
    X = Xs.copy()
    X[0] = X0
    nL, nO = len(loops["i"]), len(odom["i"])
    if sel_lp is None:
        sel_lp = np.ones(nL, bool)
    sel_od = np.ones(nO, bool)
    k, stages, flags = k0, [], []
    while True:
        kk = max(k, kmin)

        def wfun(Xc, kk=kk):
            do2 = np.sum(edge_err(Xc, odom) ** 2, 1)
            dl2 = np.sum(edge_err(Xc, loops) ** 2, 1)
            return wcauchy(do2, kk, sel_od), wcauchy(dl2, kk, sel_lp)

        X, nit = gn_run(X, odom, loops, wfun, X0, iters=iters)
        dl = edge_d(X, loops)
        stages.append(dict(kappa=float(kk), iters=int(nit),
                           loop_inlier_frac=float(np.mean(dl[sel_lp] < dthr))))
        flags.append((dl >= dthr).astype(np.uint8))
        if k <= kmin:
            break
        k = max(k / mu, kmin)
    return X, stages, np.array(flags)


def trimmed_solve(Xs, odom, loops, X0, lp_sel, d_od=1.0, rounds=8, dthr=2.5):
    """Linear odometry (sigma scaled by d_od) + Cauchy(k=1) loops restricted
    to lp_sel; hard re-trim (d < dthr) between rounds until set is stable."""
    X = Xs.copy()
    X[0] = X0
    sel = np.zeros(len(loops["i"]), bool)
    sel[lp_sel] = True
    trim_hist = []
    for r in range(rounds):
        def wfun(Xc, sel=sel):
            do2 = np.sum(edge_err(Xc, odom) ** 2, 1)
            dl2 = np.sum(edge_err(Xc, loops) ** 2, 1)
            return np.full_like(do2, 1.0 / d_od ** 2), wcauchy(dl2, 1.0, sel)
        prev = X.copy()
        X, _ = gn_run(X, odom, loops, wfun, X0, iters=30)
        new_sel = sel & (edge_d(X, loops) < dthr)
        trim_hist.append(int(new_sel.sum()))
        stable = bool(np.array_equal(new_sel, sel))
        sel = new_sel
        moved = np.max(np.linalg.norm(X[:, :2] - prev[:, :2], axis=1))
        if stable and moved < 1e-5:
            break
        if stable:
            # weights changed last round; converge with the trimmed weights
            def wfun2(Xc, sel=sel):
                do2 = np.sum(edge_err(Xc, odom) ** 2, 1)
                dl2 = np.sum(edge_err(Xc, loops) ** 2, 1)
                return np.full_like(do2, 1.0 / d_od ** 2), wcauchy(dl2, 1.0, sel)
            X, _ = gn_run(X, odom, loops, wfun2, X0, iters=30)
            break
    return X, np.where(sel)[0], trim_hist

