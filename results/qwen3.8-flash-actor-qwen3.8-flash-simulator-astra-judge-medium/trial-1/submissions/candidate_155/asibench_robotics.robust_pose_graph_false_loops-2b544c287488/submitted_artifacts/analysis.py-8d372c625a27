class Canvas:
    def __init__(self, w, h, fill=255):
        self.a = np.full((h, w), fill, np.uint8)
        self.w, self.h = w, h

    def px(self, x, y, v=0, t=1):
        x, y = int(round(x)), int(round(y))
        r = (t - 1) // 2
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                xx, yy = x + dx, y + dy
                if 0 <= xx < self.w and 0 <= yy < self.h:
                    self.a[yy, xx] = min(int(self.a[yy, xx]), v)

    def line(self, x0, y0, x1, y1, v=0, t=1, dash=None):
        n = max(int(abs(x1 - x0)), int(abs(y1 - y0)), 1)
        period = None if dash is None else sum(dash)
        xs = x0 + (x1 - x0) * np.arange(n + 1) / n
        ys = y0 + (y1 - y0) * np.arange(n + 1) / n
        for k in range(n + 1):
            if period is not None and (k % period) >= dash[0]:
                continue
            self.px(xs[k], ys[k], v, t)

    def rect(self, x0, y0, x1, y1, v=0):
        xa, xb = sorted((int(min(x0, self.w - 1)), int(min(x1, self.w - 1))))
        ya, yb = sorted((int(min(y0, self.h - 1)), int(min(y1, self.h - 1))))
        self.a[max(ya, 0):yb + 1, max(xa, 0):xb + 1] = v

    def box(self, x0, y0, x1, y1, v=0, t=1):
        self.line(x0, y0, x1, y0, v=v, t=t)
        self.line(x0, y1, x1, y1, v=v, t=t)
        self.line(x0, y0, x0, y1, v=v, t=t)
        self.line(x1, y0, x1, y1, v=v, t=t)

    def text(self, x, y, s, v=0, sc=2):
        cx = x
        for ch in str(s).upper():
            if ch == " ":
                cx += 4 * sc
                continue
            for path in FONT.get(ch, []):
                for (px0, py0), (px1, py1) in zip(path, path[1:]):
                    self.line(cx + px0 * sc, y + py0 * sc,
                              cx + px1 * sc, y + py1 * sc,
                              v=v, t=max(1, sc // 2))
            cx += 4 * sc

    def save_png(self, path):
        h, w = self.a.shape
        raw = b"".join(b"\x00" + self.a[y].tobytes() for y in range(h))

        def chunk(t, d):
            return (struct.pack(">I", len(d)) + t + d +
                    struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF))
        with open(path, "wb") as f:
            f.write(b"\x89PNG\r\n\x1a\n")
            f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 0, 0, 0, 0)))
            f.write(chunk(b"IDAT", zlib.compress(raw, 9)))
            f.write(chunk(b"IEND", b""))


def fmt(v, nd=1):
    s = f"{float(v):.{nd}f}".rstrip("0").rstrip(".")
    return "0" if s in ("", "-0") else s


def draw_map_panel(c, P0, Xf, loops, inl_mask, x0, y0, x1, y1):
    lo = np.minimum(P0[:, :2].min(0), Xf[:, :2].min(0)) - 2.0
    hi = np.maximum(P0[:, :2].max(0), Xf[:, :2].max(0)) + 2.0
    span = hi - lo
    sc = min((x1 - x0) / span[0], (y1 - y0) / span[1])
    ox = x0 + ((x1 - x0) - span[0] * sc) / 2
    oy = y0 + ((y1 - y0) - span[1] * sc) / 2

    def m2p(px, py):
        return ox + (px - lo[0]) * sc, y1 - (py - lo[1]) * sc

    step = 10.0
    gx = math.ceil(lo[0] / step) * step
    while gx <= hi[0]:
        px, _py = m2p(gx, 0.0)
        c.line(px, y0, px, y1, v=235, t=1)
        c.line(px, y1, px, y1 + 4, t=1)
        c.text(px - 2 * len(fmt(gx, 0)), y1 + 7, fmt(gx, 0), sc=1)
        gx += step
    gy = math.ceil(lo[1] / step) * step
    while gy <= hi[1]:
        _px, py = m2p(0.0, gy)
        c.line(x0, py, x1, py, v=235, t=1)
        c.line(x0 - 4, py, x0, py, t=1)
        c.text(x0 - 7 - 4 * len(fmt(gy, 0)), py - 3, fmt(gy, 0), sc=1)
        gy += step
    c.box(x0, y0, x1, y1, v=0, t=1)
    for k in range(len(loops["i"])):
        pa = m2p(Xf[loops["i"][k], 0], Xf[loops["i"][k], 1])
        pb = m2p(Xf[loops["j"][k], 0], Xf[loops["j"][k], 1])
        if inl_mask[k]:
            c.line(pa[0], pa[1], pb[0], pb[1], v=70, t=1)
        else:
            c.line(pa[0], pa[1], pb[0], pb[1], v=155, t=1, dash=(3, 3))
    for k in range(len(P0) - 1):
        pa = m2p(P0[k, 0], P0[k, 1])
        pb = m2p(P0[k + 1, 0], P0[k + 1, 1])
        c.line(pa[0], pa[1], pb[0], pb[1], v=185, t=1, dash=(4, 4))
    for k in range(len(Xf) - 1):
        pa = m2p(Xf[k, 0], Xf[k, 1])
        pb = m2p(Xf[k + 1, 0], Xf[k + 1, 1])
        c.line(pa[0], pa[1], pb[0], pb[1], v=10, t=2)
