"""
BCG-CORONA (TASK008): COVID-19 severity, BCG vs placebo, stratified by patients_seen.
Main analysis : subject (USUBJID) level, full stratified denominator (1000 randomised),
                severe = any COVID-related AE with AESER == "Yes".
Sensitivity   : AESEV>=3, AESEV>=2 (pre-specified), AEOUT in {Worse,Fatal} (supplementary);
                two AESEV-missingness versions; AE-record level (violates independence -> descriptive only).
Tests         : 2x2 chi-square (scipy.chi2_contingency, no correction) + Yates + Fisher;
                Fisher taken as authoritative when min expected count < 5.
                Uncorrected p and Bonferroni x3 (3 patients_seen strata per test family).
Inputs        : data/TASK008_BCG-CORONA_DM.csv , data/TASK008_BCG-CORONA_AE.csv (authoritative CSV sources, latin-1).
                data/TASK008_BCG-CORONA_EX.csv used only for completeness checks.
"""
import re
import numpy as np
import pandas as pd
from scipy import stats

BASE = "data/TASK008_BCG-CORONA_"
STRATA = ["1-50", "51-100", "GROUPS"]  # placeholder, replaced below
STRATA = ["1-50", "51-100", ">100"]

def read_csv(f):
    try:
        return pd.read_csv(BASE + f, dtype=str)
    except UnicodeDecodeError:
        return pd.read_csv(BASE + f, dtype=str, encoding="latin-1")

dm = read_csv("DM.csv")
ae = read_csv("AE.csv")
ex = read_csv("EX.csv")

# ---------------- completeness checks (EX only) ----------------
checks = {
    "DM rows": len(dm),
    "DM unique USUBJID": dm.USUBJID.nunique(),
    "AE rows": len(ae),
    "AE unique USUBJID": ae.USUBJID.nunique(),
    "EX unique USUBJID": ex.USUBJID.nunique(),
    "DM subjects with EX record": int(dm.USUBJID.isin(ex.USUBJID).sum()),
    "DM TRTGRP x counts": dm.TRTGRP.value_counts().to_dict(),
}
mm = dm.merge(ex[["USUBJID", "TRTGRP"]].drop_duplicates(), on="USUBJID", suffixes=("_dm", "_ex"))
checks["DM vs EX TRTGRP mismatches"] = int((mm.TRTGRP_dm != mm.TRTGRP_ex).sum())
checks["EXDRUG x TRTGRP"] = pd.crosstab(ex.EXDRUG, ex.TRTGRP).to_dict()

# ---------------- cleaning ----------------
# 143 "shell" rows: only STUDYID/TRTGRP/USUBJID populated -> no outcome information
clin_cols = [c for c in ae.columns if c not in ("STUDYID", "TRTGRP", "USUBJID")]
shell = ae[clin_cols].isna().all(axis=1)
ae_valid = ae[~shell].copy()
checks["AE shell rows dropped"] = int(shell.sum())

ae_valid["sev_num"] = pd.to_numeric(ae_valid.AESEV, errors="coerce")
COV = re.compile(r"covid|corona|sars", re.I)
ae_valid["covid"] = (ae_valid.AEPT.fillna("").str.contains(COV)
                     | ae_valid.AELLT.fillna("").str.contains(COV))
cov_rec = ae_valid[ae_valid.covid].merge(dm[["USUBJID", "patients_seen"]], on="USUBJID", how="left")
cov_rec["AESER_yes"] = cov_rec.AESER.eq("Yes")
cov_rec["sev3"] = cov_rec.sev_num >= 3
cov_rec["sev2"] = cov_rec.sev_num >= 2
cov_rec["worse"] = cov_rec.AEOUT.isin(["Worse", "Fatal"])

base = dm[["USUBJID", "TRTGRP", "patients_seen"]].copy()
checks["COVID-related AE records"] = int(len(cov_rec))
checks["Subjects with COVID-related AE"] = int(cov_rec.USUBJID.nunique())
print("=== completeness / cleaning checks ===")
for k, v in checks.items():
    print(f"  {k}: {v}")
print("\n=== strata sizes (denominators) ===")
print(pd.crosstab(base.patients_seen, base.TRTGRP).reindex(STRATA))
print("\n=== COVID AE records: AESEV x AESER (records) ===")
print(pd.crosstab(cov_rec.sev_num.astype('Int64').astype(str), cov_rec.AESER.fillna("<NA>")))
print("missing AESEV among COVID records:", int(cov_rec.sev_num.isna().sum()))

# ---------------- subject-level outcome constructions ----------------
def subj_flags(df, col):
    """severe = any COVID record flagged; returned indexed by USUBJID."""
    return df.groupby("USUBJID")[col].any()

subj = {}
subj[("subject", "AESER=Yes (MAIN)", "missing-as-non-severe")] = subj_flags(cov_rec, "AESER_yes")
subj[("subject", "AESEV>=3", "missing-as-non-severe")] = subj_flags(cov_rec, "sev3")
subj[("subject", "AESEV>=2", "missing-as-non-severe")] = subj_flags(cov_rec, "sev2")
subj[("subject", "AEOUT in {Worse,Fatal}", "missing-as-non-severe")] = subj_flags(cov_rec, "worse")

# AESEV complete-case version: drop COVID records with missing AESEV, keep only subjects
# retaining >=1 COVID record with a non-missing AESEV
cc = cov_rec[cov_rec.sev_num.notna()]
for col, lab in [("sev3", "AESEV>=3"), ("sev2", "AESEV>=2")]:
    subj[("subject", lab, "drop-records-missing-AESEV")] = subj_flags(cc, col)

# ---------------- test machinery ----------------
def rd_ci(x1, n1, x0, n0):
    p1, p0 = x1 / n1, x0 / n0
    se = np.sqrt(p1 * (1 - p1) / n1 + p0 * (1 - p0) / n0)
    d = p1 - p0
    return d, d - 1.96 * se, d + 1.96 * se

def run_table(df, ycol):
    """df: subject-level frame with TRTGRP, patients_seen, ycol(bool)."""
    rows = []
    for st in STRATA:
        g = df[df.patients_seen == st]
        t = (g.groupby("TRTGRP")[ycol].agg(["sum", "size"]).reindex(["BCG", "Placebo"]))
        x1, n1 = int(t.loc["BCG", "sum"]), int(t.loc["BCG", "size"])
        x0, n0 = int(t.loc["Placebo", "sum"]), int(t.loc["Placebo", "size"])
        tab = np.array([[x1, n1 - x1], [x0, n0 - x0]])
        if tab.sum(0)[1] == 0:                      # no events at all
            p = py = pf = np.nan; minexp = tab.min()
        else:
            minexp = stats.chi2_contingency(tab, correction=False)[3].min()
            p = stats.chi2_contingency(tab, correction=False)[1]
            py = stats.chi2_contingency(tab, correction=True)[1]
            pf = stats.fisher_exact(tab)[1]
        d, lo, hi = rd_ci(x1, n1, x0, n0)
        rows.append(dict(stratum=st, n_BCG=n1, n_PBO=n0, ev_BCG=x1, ev_PBO=x0,
                         pct_BCG=100 * x1 / n1, pct_PBO=100 * x0 / n0,
                         risk_diff_pct=100 * d, rd_ci_lo_pct=100 * lo, rd_ci_hi_pct=100 * hi,
                         min_expected=minexp, chi2_p=p, yates_p=py, fisher_p=pf,
                         test="Fisher (minExp<5)" if minexp < 5 else "chi2"))
    r = pd.DataFrame(rows)
    # Bonferroni over the 3 strata within this (definition x unit x missingness) family
    for c in ["chi2_p", "yates_p", "fisher_p"]:
        r["bonf_" + c] = np.minimum(r[c] * 3, 1.0)
    return r

# subject-level runs
res = []
for (unit, defn, miss), s in subj.items():
    d = base.merge(s.rename("y").reset_index(), on="USUBJID", how="inner" if "complete" in miss or "drop" in miss else "left")
    d["y"] = d.y.fillna(False).astype(bool)
    t = run_table(d, "y")
    t.insert(0, "severity_definition", defn); t.insert(0, "missingness_version", miss); t.insert(0, "unit", unit)
    t["denominator"] = "all randomised in stratum" if miss != "drop-records-missing-AESEV" else "subjects with >=1 non-missing AESEV COVID record"
    res.append(t)

# AE-record level (COVID records only) -- independence violated, descriptive only
for col, lab in [("AESER_yes", "AESER=Yes"), ("sev3", "AESEV>=3"), ("sev3eq", "AESEV==3"),
                 ("sev2", "AESEV>=2"), ("worse", "AEOUT in {Worse,Fatal}")]:
    r = cov_rec.assign(**{"sev3eq": cov_rec.sev_num == 3}).rename(columns={col: "y"})
    rows = []
    for st in STRATA:
        g = r[r.patients_seen == st]
        t = g.groupby("TRTGRP")["y"].agg(["sum", "size"]).reindex(["BCG", "Placebo"]).fillna(0)
        x1, n1 = int(t.loc["BCG", "sum"]), int(t.loc["BCG", "size"])
        x0, n0 = int(t.loc["Placebo", "sum"]), int(t.loc["Placebo", "size"])
        tab = np.array([[x1, n1 - x1], [x0, n0 - x0]])
        minexp = stats.chi2_contingency(tab, correction=False)[3].min() if tab.sum(0)[1] else np.nan
        p = stats.chi2_contingency(tab, correction=False)[1] if tab.sum(0)[1] else np.nan
        py = stats.chi2_contingency(tab, correction=True)[1] if tab.sum(0)[1] else np.nan
        pf = stats.fisher_exact(tab)[1] if tab.sum(0)[1] else np.nan
        d, lo, hi = rd_ci(x1, n1, x0, n0)
        rows.append(dict(stratum=st, n_BCG=n1, n_PBO=n0, ev_BCG=x1, ev_PBO=x0,
                         pct_BCG=100 * x1 / n1, pct_PBO=100 * x0 / n0,
                         risk_diff_pct=100 * d, rd_ci_lo_pct=100 * lo, rd_ci_hi_pct=100 * hi,
                         min_expected=minexp, chi2_p=p, yates_p=py, fisher_p=pf,
                         test="Fisher (minExp<5)" if minexp and minexp < 5 else "chi2",
                         bonf_chi2_p=min(p * 3, 1.0), bonf_yates_p=min(py * 3, 1.0), bonf_fisher_p=min(pf * 3, 1.0)))
    t = pd.DataFrame(rows)
    t.insert(0, "severity_definition", lab); t.insert(0, "missingness_version", "records w/o AESEV count as non-severe")
    t.insert(0, "unit", "AE-record")
    t["denominator"] = "COVID-related AE records in stratum"
    res.append(t)

R = pd.concat(res, ignore_index=True)
cols = ["unit", "severity_definition", "missingness_version", "denominator", "stratum",
        "n_BCG", "n_PBO", "ev_BCG", "ev_PBO", "pct_BCG", "pct_PBO",
        "risk_diff_pct", "rd_ci_lo_pct", "rd_ci_hi_pct", "min_expected", "test",
        "chi2_p", "yates_p", "fisher_p", "bonf_chi2_p", "bonf_yates_p", "bonf_fisher_p"]
R = R[cols]
for c in ["pct_BCG", "pct_PBO", "risk_diff_pct", "rd_ci_lo_pct", "rd_ci_hi_pct", "min_expected"]:
    R[c] = R[c].round(3)
for c in ["chi2_p", "yates_p", "fisher_p", "bonf_chi2_p", "bonf_yates_p", "bonf_fisher_p"]:
    R[c] = R[c].round(5)
R.to_csv("out/results_all.csv", index=False)

pd.set_option("display.width", 260); pd.set_option("display.max_columns", 50)
print("\n=== MAIN ANALYSIS (subject level, AESER=Yes, full stratified denominator) ===")
main = R[(R.unit == "subject") & (R.severity_definition == "AESER=Yes (MAIN)")]
print(main.to_string(index=False))

print("\n=== subject-level AESEV>=3 (pre-specified sensitivity, both missingness versions) ===")
print(R[(R.unit == "subject") & (R.severity_definition == "AESEV>=3")].to_string(index=False))

print("\n=== other subject-level sensitivity ===")
print(R[(R.unit == "subject") & (~R.severity_definition.isin(["AESER=Yes (MAIN)", "AESEV>=3"]))]
      [["severity_definition", "missingness_version", "stratum", "n_BCG", "n_PBO", "ev_BCG", "ev_PBO",
        "min_expected", "chi2_p", "fisher_p", "bonf_chi2_p"]].to_string(index=False))

print("\n=== AE-record level (independence violated; NOT a valid primary test) ===")
print(R[R.unit == "AE-record"][["severity_definition", "stratum", "n_BCG", "n_PBO", "ev_BCG", "ev_PBO",
                                "min_expected", "chi2_p", "yates_p", "fisher_p", "bonf_chi2_p", "bonf_fisher_p"]]
      .to_string(index=False))

print("\n=== stratum x group key counts, severe=AESEV>=3 (subject level) ===")
s3 = subj[("subject", "AESEV>=3", "missing-as-non-severe")]
d3 = base.merge(s3.rename("y").reset_index(), on="USUBJID", how="left").fillna({"y": False})
print(pd.crosstab([d3.patients_seen, d3.TRTGRP], d3.y).reindex(pd.MultiIndex.from_product([STRATA, ["BCG", "Placebo"]], names=["patients_seen", "TRTGRP"])))

print("\n=== summary of nominally p<0.05 cells (chi2, uncorrected) ===")
sig = R[R.chi2_p < 0.05][["unit", "severity_definition", "missingness_version", "stratum", "chi2_p", "fisher_p", "bonf_chi2_p", "bonf_fisher_p"]]
print(sig.to_string(index=False) if len(sig) else "none")

print("\n=== CONCLUSION (Chinese) ===")
main_sig = main[main.fisher_p < 0.05]
# ---------------- final answer + Chinese conclusion ----------------
main_rows = main.set_index("stratum")
any_main = (main.fisher_p < 0.05).any() if main.fisher_p.notna().any() else False
sig_rec = R[(R.unit == "AE-record") & (R.severity_definition == "AESEV>=3") & (R.chi2_p < 0.05)]
concl = f"""BCG-CORONA (TASK008) 结论（中文）

主分析（受试者 USUBJID 层面 + 全分层分母，重度 = 任一新冠相关 AE 的 AESER="Yes"）：
  1-50 组   BCG 8/423 (1.89%) vs 安慰剂 4/412 (0.97%)，风险差 +0.92% (95%CI -0.69~+2.53)，minExp=5.92，卡方 p=0.264（Fisher p=0.385）
  51-100 组 BCG 1/59  vs 安慰剂 0/70，minExp=0.46(<5，以 Fisher 为准)，卡方 p=0.274，Fisher p=0.457
  >100 组   BCG 1/18  vs 安慰剂 1/18，minExp=1.00(<5，以 Fisher 为准)，卡方 p=1.000，Fisher p=1.000
  => 按主分析口径，1-50、51-100、>100 三层均无 p<0.05 的显著差异（Bonferroni 校正后更不显著）。

预设/补充敏感性（受试者层面）：AESEV>=3（1-50 层 p=0.076；剔除 AESEV 缺失记录版本 p=0.124）、
  AESEV>=2（各层 p>=0.29）、AEOUT∈{{Worse,Fatal}}（各层 p>=0.27）均不达 p<0.05；
  AESEV 缺失的 48 条新冠记录取"计非重度"或"整条剔除"两种版本，结论不变（不显著）。

唯一出现 p<0.05 的口径 = AE 记录层面（同一受试者多条 AE 未去重，违反独立性假设）：
  AESEV>=3 在 1-50 组：BCG 17/94 条 vs 安慰剂 5/77 条，卡方 p=0.0243（Yates p=0.0431，Fisher p=0.0370），
  Bonferroni×3 后 p=0.073（Fisher 0.111），不再显著；AESEV==3 时 p=0.0168（Bonferroni 0.050）。
  51-100 与 >100 层在任何口径下均不显著。

对问题"在哪个患者接诊量分组中 BCG 与安慰剂的新冠严重程度差异 p<0.05"的回答：
  1-50 组 —— 仅在 AE 记录层面 + AESEV>=3（或 AESEV==3）口径下达到 p<0.05（未校正 p=0.024/0.017，
  Bonferroni 校正后 p=0.073/0.050 即不再显著）；在统计上作为主分析的受试者层面口径下，
  三个 patients_seen 分组均无显著差异。题目预设的"存在显著组"只能在该记录层面口径下勉强成立，
  不应作为无条件结论。
"""
open("out/conclusion_zh.txt", "w").write(concl)
print(concl)
