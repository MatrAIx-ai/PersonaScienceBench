"""STEP 2 - official count (fixed rules as ruled by the researcher).

FIXED RULES
  A CHIP membership: any comma-token of `Gene Names` is in the 56-gene Schenz
    et al. 2022 CHIP list.  `In_CHIP` (True on all rows) NOT used -> sensitivity only.
  B multi-gene rows kept once (never multiplied by gene count).
  C non-reference: Zygosity in {Heterozygous, Homozygous Variant}.
  D blank Zygosity (no usable call) excluded.
  E splice_region_variant KEPT on the exonic side (main figure); excluding it = sensitivity.
  F excluded regions: intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant,
    5_prime_UTR_premature_start_codon_gain_variant, upstream_gene_variant
    + defensive intergenic_region / downstream_gene_variant (absent in this data).
    kept exonic set: synonymous_variant, missense_variant, frameshift_variant,
    inframe_insertion, inframe_deletion, splice_region_variant.
  G main count = occurrences (sample x variant) after de-duplicating
    (sample, Chr:Pos, Ref/Alt); secondary = unique Chr:Pos:Ref/Alt.
  H all 86 workbooks, no Trio-Status filtering (sample 533 has no workbook).

Run: python3 notebooks/step02_count_nonref_exonic.py
Outputs: work/final_nonref_exonic_variants.csv, work/per_sample_counts.csv,
         work/summary_counts.json, work/step02_log.txt
"""
import json
import os
import re
import sys

import pandas as pd

HERE = os.path.dirname(os.path.abspath(__file__))
WORK = os.path.join(HERE, '..', 'work')
sys.path.insert(0, WORK)
from load_chip import chip_genes, load_combined  # noqa: E402

LOG = []


def p(*a):
    line = ' '.join(str(x) for x in a)
    print(line)
    LOG.append(line)


CHIP = set(chip_genes())
NONREF = ['Heterozygous', 'Homozygous Variant']
EXONIC = ['synonymous_variant', 'missense_variant', 'frameshift_variant',
          'inframe_insertion', 'inframe_deletion', 'splice_region_variant']
EXCLUDED = ['intron_variant', '3_prime_UTR_variant', '5_prime_UTR_variant',
            '5_prime_UTR_premature_start_codon_gain_variant', 'upstream_gene_variant',
            'intergenic_region', 'downstream_gene_variant']

raw = load_combined()
raw['SO'] = raw['Sequence Ontology (Combined)'].astype(str).str.strip()
p('=' * 78)
p('STEP 02 - non-reference exonic CHIP variants in the 86 samples (fixed rules)')
p('=' * 78)
p('Q1 loaded: %d workbooks / %d samples / %d raw rows' %
  (raw['source_file'].nunique(), raw['sample'].nunique(), len(raw)))

dupmask = raw.duplicated(subset=['sample', 'Chr:Pos', 'Ref/Alt'], keep='first')
dupgrp = raw[raw.duplicated(subset=['sample', 'Chr:Pos', 'Ref/Alt'], keep=False)]
p('Q2 de-dup on key (sample, Chr:Pos, Ref/Alt): %d redundant rows removed' % int(dupmask.sum()))
p('   QC verification: the %d rows of those duplicate groups are %s -> 100%% intronic,'
  ' so de-duplication changes the exonic count by exactly 0.'
  % (len(dupgrp), dict(dupgrp['SO'].value_counts())))
d = raw[~dupmask].copy()
p('   rows after de-duplication: %d' % len(d))


def toks(s):
    return [t.strip().upper() for t in str(s).split(',') if t.strip()]


d['chip_hits'] = d['Gene Names'].map(lambda s: [g for g in toks(s) if g in CHIP])
d['is_chip'] = d['chip_hits'].map(bool)
n_multi_chip = int((d['chip_hits'].map(len) > 1).sum())
p('Q3 QC rule B: multi-gene rows (Gene Names contains ","): %d ; rows hitting >1 CHIP gene: %d'
  ' -> "count row once" cannot alter the total.'
  % (int(d['Gene Names'].astype(str).str.contains(',').sum()), n_multi_chip))
neigh = [g for L in d.loc[~d['is_chip'], 'Gene Names'] for g in toks(L) if g not in CHIP]
p('   rows with no CHIP token: %d (neighbour genes only: %s)' % (int((~d['is_chip']).sum()),
                                                                 dict(pd.Series(neigh).value_counts())))
d['Zyg'] = d['Zygosity'].fillna('<blank: no call>')
d['key'] = d['Chr:Pos'].astype(str) + ':' + d['Ref/Alt'].astype(str)

# ------------------------------------------------------------------- funnel
f1 = d[d['is_chip']]
f2 = f1[f1['Zygosity'].isin(NONREF)]
f3 = f2[f2['SO'].isin(EXONIC)]
n_ref = int((f1['Zygosity'] == 'Reference').sum())
n_blank = int(f1['Zygosity'].isna().sum())
p('\n' + '-' * 78)
p('FUNNEL (occurrence basis = sample x variant)')
p('-' * 78)
p('%-60s %8s %10s' % ('step', 'rows', 'dropped'))
p('%-60s %8d %10s' % ('0. all rows, 86 workbooks (after key de-dup)', len(d), '-'))
p('%-60s %8d %10d' % ('1. in CHIP panel genes (rule A: Gene Names token)', len(f1), len(d) - len(f1)))
p('%-60s %8d %10d' % ('2. non-reference calls (rules C + D)', len(f2), len(f1) - len(f2)))
p('%-60s %8d %10d' % ('3. exonic: drop intron/UTR/upstream (rules E + F)', len(f3), len(f2) - len(f3)))
p('   step-2 drop reasons: Reference calls %d + blank-Zygosity no-calls %d = %d'
  % (n_ref, n_blank, len(f1) - len(f2)))
p('   step-3 drop reasons: %s' % dict(f2.loc[~f2['SO'].isin(EXONIC), 'SO'].value_counts()))
p('   defensive rules that matched nothing: intergenic_region=%d, downstream_gene_variant=%d'
  % (int((f2['SO'] == 'intergenic_region').sum()), int((f2['SO'] == 'downstream_gene_variant').sum())))
MAIN = len(f3)
UNIQ = int(f3['key'].nunique())
p('\n>>> MAIN ANSWER (occurrence basis): %d non-reference exonic variants in CHIP'
  ' genes across the 86 samples.' % MAIN)
p('>>> secondary (unique Chr:Pos:Ref/Alt, cross-sample de-duplicated): %d' % UNIQ)

# ------------------------------------------------------- retained breakdown
p('\n' + '-' * 78)
p('RETAINED CATEGORIES')
p('-' * 78)
p('%-50s %7s %7s %7s' % ('Sequence Ontology term', 'kept', 'Het', 'Hom'))
for t in EXONIC:
    s = f3[f3['SO'] == t]
    p('%-50s %7d %7d %7d' % (t, len(s), int((s['Zygosity'] == 'Heterozygous').sum()),
                             int((s['Zygosity'] == 'Homozygous Variant').sum())))
p('%-50s %7d %7d %7d' % ('TOTAL', len(f3),
                         int((f3['Zygosity'] == 'Heterozygous').sum()),
                         int((f3['Zygosity'] == 'Homozygous Variant').sum())))
ct = pd.crosstab(f3['SO'], f3['Zygosity']).reindex(EXONIC).fillna(0).astype(int)
ct['TOTAL'] = ct.sum(axis=1)
p('\nSO x Zygosity cross-tab (retained rows):')
p(ct.to_string())
p('\nTop 10 CHIP genes among retained variants:')
for g, v in f3['chip_hits'].map(lambda L: ','.join(L)).value_counts().head(10).items():
    p('   %-20s %5d' % (g, v))

# ------------------------------------------------------------- sensitivity
p('\n' + '-' * 78)
p('SENSITIVITY (main = %d ; occurrence basis unless noted)' % MAIN)
p('-' * 78)
EX_SP = [t for t in EXONIC if t != 'splice_region_variant']
f2b = f2[f2['SO'].isin(EX_SP)]
blank_exonic_chip = d[d['is_chip'] & d['Zygosity'].isna() & d['SO'].isin(EXONIC)]
inchip_alt = d[d['In_CHIP'].astype(str).eq('True') & d['Zygosity'].isin(NONREF) & d['SO'].isin(EXONIC)]
sens = {
    'main_occurrences': MAIN,
    'exclude_splice_region': len(f2b),
    'include_blank_zygosity': MAIN + len(blank_exonic_chip),
    'using_In_CHIP_flag_instead_of_gene_list': len(inchip_alt),
    'unique_sites_secondary': UNIQ,
    'unique_sites_excluding_splice_region': int(f2b['key'].nunique()),
}
for k, v in sens.items():
    p('   %-38s %8d   (delta vs main: %+d)' % (k, v, v - MAIN))
p('   using_In_CHIP_flag delta is entirely MMAB / MMACHC / SF3B2 probe-overlap neighbour'
  ' genes (rule A excludes them).')
p('   include_blank_zygosity delta = %d rows that carry no DP/GQ/VAF in their sample.'
  % len(blank_exonic_chip))

bl = d[d['Zyg'] == '<blank: no call>']
p('\nRule D audit - all %d blank-Zygosity rows by SO term:' % len(bl))
p(pd.Series(bl['SO'].values).value_counts().to_string())
p('Rule D audit - blank-Zygosity rows by file (largest contributors):')
for s, v in bl['sample'].value_counts().head(4).items():
    add = int((bl['sample'].eq(s) & bl['is_chip'] & bl['SO'].isin(EXONIC)).sum())
    p('   %-14s %5d blank rows (of which exonic-CHIP, i.e. what inclusion would add: %d)'
      % (s, v, add))
p('   remaining %d files: %d blank rows in total'
  % (86 - int((bl['sample'].value_counts().head(4) > 0).sum()),
     int(len(bl) - bl['sample'].value_counts().head(4).sum())))

# ----------------------------------------------------------- per-sample table
per = pd.DataFrame({'rows': d.groupby('sample').size(),
                    'CHIP_rows': d[d['is_chip']].groupby('sample').size(),
                    'nonref_CHIP_rows': f2.groupby('sample').size(),
                    'retained_nonref_exonic': f3.groupby('sample').size(),
                    'of_which_splice_region': f3[f3['SO'] == 'splice_region_variant'].groupby('sample').size(),
                    'unique_sites': f3.groupby('sample')['key'].nunique(),
                    'blank_no_call_rows': bl.groupby('sample').size()}).fillna(0).astype(int)
per = per.reset_index().sort_values('retained_nonref_exonic', ascending=False)
p('\n' + '-' * 78)
p('PER-SAMPLE COUNTS (all 86 samples, sorted by retained variants)')
p('-' * 78)
p(per.to_string(index=False))
p('TOTAL retained %d  |  per-sample sum %d  |  samples covered %d'
  % (MAIN, int(per['retained_nonref_exonic'].sum()), per.shape[0]))
lo = per.set_index('sample')
p('Note: 380-P / 381-PM list 704 / 705 panel sites but %d / %d of them have blank Zygosity'
  % (int(lo.at['380-P', 'blank_no_call_rows']), int(lo.at['381-PM', 'blank_no_call_rows'])))
p('(no usable call -> excluded by rule D), so their retained counts (%d / %d) are at the low end.'
  % (int(lo.at['380-P', 'retained_nonref_exonic']), int(lo.at['381-PM', 'retained_nonref_exonic'])))

# ------------------------------------------------------------ HGVS QC (ref.)
def hgvs_class(h):
    h = str(h)
    if ':' not in h:
        return 'no_HGVS'
    c = h.split(':', 1)[1]
    c = c[2:] if c.startswith('c.') else c
    if '*' in c:
        return "3'UTR (c.*)"
    if re.match(r'^-', c):
        return "5' flank (c.-N)"
    if re.search(r'\d[+-]\d', c):
        return 'intron boundary (c.N+/-M, indels parsed)'
    return 'coding / exonic (c.N)'


qc = pd.crosstab(d.loc[d['is_chip'], 'SO'], d.loc[d['is_chip'], 'HGVS c. (Clinically Relevant)'].map(hgvs_class))
p('\nQC (reference only - never overrides the SO classification): HGVS c. pattern vs SO, CHIP rows')
p(qc.to_string())

trio = pd.read_excel(os.path.join(HERE, '..', 'data', '230215_Trio_Status.xlsx'))
tn = {str(x).strip() for x in trio['Sample ID'] if str(x).strip().isdigit()}
fs = {re.match(r'^(\d+)', s).group(1) for s in d['sample'] if re.match(r'^\d', s)}
p('Q4 QC scope: Trio_Status %d IDs (30 numeric + 57 SRR); 86 workbooks used; numeric ID(s)'
  ' without workbook: %s -> no filtering applied on trio status.' % (len(trio), sorted(tn - fs)))

# ----------------------------------------------------------------- outputs
out = f3[['sample', 'source_file', 'Chr:Pos', 'Ref/Alt', 'Zygosity', 'Gene Names',
          'Sequence Ontology (Combined)', 'Effect (Combined)',
          'Transcript Name (Clinically Relevant)', 'Exon Number (Clinically Relevant)',
          'HGVS c. (Clinically Relevant)', 'HGVS p. (Clinically Relevant)',
          'Read Depths (DP)', 'Genotype Qualities (GQ)', 'Variant Allele Freq',
          'Filter', 'In_CHIP']].copy()
out['CHIP_gene'] = f3['chip_hits'].map(lambda L: ';'.join(L)).values
out = out.sort_values(['Chr:Pos', 'Ref/Alt', 'sample'])
out.to_csv(os.path.join(WORK, 'final_nonref_exonic_variants.csv'), index=False)
per.to_csv(os.path.join(WORK, 'per_sample_counts.csv'), index=False)

summary = {
    'MAIN_ANSWER_nonref_exonic_CHIP_occurrences': MAIN,
    'secondary_unique_variants': UNIQ,
    'funnel_occurrences': {
        'rows_after_key_dedup': int(len(d)),
        'step1_in_CHIP_genes': int(len(f1)),
        'step2_non_reference_calls': int(len(f2)),
        'step3_retained_exonic': int(len(f3)),
        'dropped_reference_calls': n_ref,
        'dropped_blank_zygosity_no_call': n_blank,
        'dropped_region': {k: int(v) for k, v in f2.loc[~f2['SO'].isin(EXONIC), 'SO'].value_counts().items()},
    },
    'retained_by_SO': {t: int((f3['SO'] == t).sum()) for t in EXONIC},
    'retained_by_zygosity': {k: int(v) for k, v in f3['Zygosity'].value_counts().items()},
    'top10_CHIP_genes': {k: int(v) for k, v in
                         f3['chip_hits'].map(lambda L: ','.join(L)).value_counts().head(10).items()},
    'sensitivity_occurrences': sens,
    'sensitivity_notes': {
        'exclude_splice_region': 'alternative figure if splice_region_variant is treated as non-exonic',
        'include_blank_zygosity': 'not adopted (rule D): rows without DP/GQ/VAF are not variant calls',
        'using_In_CHIP_flag': 'not adopted (rule A): MMAB/MMACHC/SF3B2 probe-overlap neighbours',
    },
    'qc': {'rows_raw': int(len(raw)), 'duplicate_rows_removed': int(dupmask.sum()),
           'duplicate_group_rows_all_intronic': bool((dupgrp['SO'] == 'intron_variant').all()),
           'rows_hitting_two_CHIP_genes': n_multi_chip,
           'multi_gene_rows': int(raw['Gene Names'].astype(str).str.contains(',').sum()),
           'samples': int(d['sample'].nunique()),
           'trio_ids_without_workbook': sorted(tn - fs),
           'blank_zygosity_rows_total': int(len(bl)),
           'blank_zygosity_380P_381PM': [int((bl['sample'] == '380-P').sum()),
                                         int((bl['sample'] == '381-PM').sum())]},
    'fixed_rules': {'CHIP_membership': 'Gene Names token in the 56-gene list; In_CHIP unused',
                    'non_reference': NONREF, 'blank_zygosity': 'excluded',
                    'exonic_kept': EXONIC, 'excluded_regions': EXCLUDED,
                    'count_unit_primary': 'sample x variant occurrences',
                    'count_unit_secondary': 'unique Chr:Pos:Ref/Alt',
                    'limitation': 'region class comes from a single Clinically Relevant transcript'},
}
with open(os.path.join(WORK, 'summary_counts.json'), 'w') as fh:
    json.dump(summary, fh, indent=2)
open(os.path.join(WORK, 'step02_log.txt'), 'w').write('\n'.join(LOG) + '\n')
p('\nwrote work/final_nonref_exonic_variants.csv (%d rows), work/per_sample_counts.csv,'
  ' work/summary_counts.json, work/step02_log.txt' % len(out))
