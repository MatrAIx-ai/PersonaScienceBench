"""STEP 1 (input inventory only -- deliberately no final count): schema + key-field report.

Capsule: 86 per-sample exome exports (GRCh38, DP>=10/GQ>=20 PASS calls) in
data/CHIP_DP10_GQ20_PASS/, one CHIP panel gene list, one trio-status sheet.

Run:  python3 notebooks/step01_inventory.py   -> prints and writes work/inventory_report.txt
"""
import collections
import os
import re
import sys

import pandas as pd

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, '..', 'work'))
from load_chip import DATA, chip_genes, load_combined, sample_files  # noqa: E402

OUT = []


def p(*a):
    line = ' '.join(str(x) for x in a)
    print(line)
    OUT.append(line)


# ---------------------------------------------------------------- 1. structure
files = sample_files()
p('1. SAMPLE WORKBOOKS:', len(files), 'files in', os.path.relpath(os.path.dirname(files[0]), DATA))

hdr1, hdr2, shapes = set(), set(), collections.Counter()
labels = {}
for f in files:
    raw = pd.read_excel(f, sheet_name=0, header=None, nrows=2)
    hdr1.add(tuple('' if pd.isna(x) else str(x) for x in raw.iloc[0]))
    hdr2.add(tuple('' if pd.isna(x) else str(x) for x in raw.iloc[1]))
    shapes[raw.shape[1]] += 1
    m = re.match(r'^(.*?) \((.*)\)$', str(raw.iloc[0, 4]))
    labels[os.path.basename(f)[len('230209_Exome_GRCh38_CHIP_'):-5]] = (m.group(1), m.group(2))
p('   distinct row-1 group-header layouts:', len(hdr1))
p('   distinct row-2 real-column layouts:', len(hdr2), '| column counts:', dict(shapes))
p('   internal sample label == filename stem for all files:',
  all(v[1] == k for k, v in labels.items()))
p('   relation prefixes used:', sorted({v[0] for v in labels.values()}))
cols = list(hdr2)[0]
p('   real column names (1-based index):')
for i, c in enumerate(cols, 1):
    p('     %2d  %s' % (i, c))

genes = chip_genes()
p('\n   CHIP gene list: %d entries, %d unique, single column, first cell = %r (no header row)'
  % (len(genes), len(set(genes)), genes[0]))

trio = pd.read_excel(os.path.join(DATA, '230215_Trio_Status.xlsx'))
p('   Trio_Status: %d rows x %d cols; Status values: %s'
  % (trio.shape[0], trio.shape[1], dict(trio['Status'].astype(str).str.strip().value_counts())))
tn = {str(x).strip() for x in trio['Sample ID'] if str(x).strip().isdigit()}
fs = {os.path.basename(f)[len('230209_Exome_GRCh38_CHIP_'):-5] for f in files}
fn = {re.match(r'^(\d+)', s).group(1) for s in fs if re.match(r'^\d', s)}
p('   trio numeric IDs: %d (workbooks carry suffixes like -P1/-PF/-PM); trio SRR IDs: %d;'
  % (len(tn), sum(1 for x in trio['Sample ID'] if str(x).strip().startswith('SRR'))))
p('   trio numeric IDs without a workbook:', sorted(tn - fn), '=> scope check only, not used for filtering')

# ------------------------------------------------------------- 2. key fields
d = load_combined()
p('\n2. COMBINED TABLE: %d rows (%d data rows/file, Excel data start row = 3)'
  % (d.shape[0], d.shape[0] / len(files)))
p('   Zygosity:', dict(d['Zygosity'].fillna('<blank / no call>').value_counts()))
p('   Filter:', dict(d['Filter'].astype(str).value_counts()),
  '| In_CHIP:', dict(d['In_CHIP'].astype(str).value_counts()),
  '| Primary/Incidental Findings:', dict(d['Primary Findings'].astype(str).value_counts()))
p('   DP range: %s-%s ; GQ range: %s-%s'
  % (pd.to_numeric(d['Read Depths (DP)'], errors='coerce').min(),
     pd.to_numeric(d['Read Depths (DP)'], errors='coerce').max(),
     pd.to_numeric(d['Genotype Qualities (GQ)'], errors='coerce').min(),
     pd.to_numeric(d['Genotype Qualities (GQ)'], errors='coerce').max()))
p('   Ref/Alt distinct %d, e.g. %s ; indel rows (%s in field): %d'
  % (d['Ref/Alt'].nunique(), list(sorted(set(d['Ref/Alt'].astype(str))))[:8], "'-'",
     d['Ref/Alt'].astype(str).str.contains('-').sum()))

d['SO'] = d['Sequence Ontology (Combined)']
p('\n   Sequence Ontology (Combined) -- %d distinct values, no multi-term strings (rows containing ",": %d):'
  % (d['SO'].nunique(), d['SO'].astype(str).str.contains(',').sum()))
ct = pd.crosstab(d['SO'], d['Zygosity'].fillna('NO_CALL'), margins=True)
ct.columns.name = None
p(ct.to_string())

chip = set(genes)
tok = lambda s: [t.strip() for t in str(s).split(',') if t.strip()]
d['chip_tok'] = d['Gene Names'].map(lambda s: any(g in chip for g in tok(s)))
p('\n   Gene Names: multi-gene rows: %d ; rows with no CHIP-list token: %d ; >1 CHIP token: %d'
  % (d['Gene Names'].astype(str).str.contains(',').sum(), (d['chip_tok'] == False).sum(),
     d['Gene Names'].map(lambda s: sum(g in chip for g in tok(s)) > 1).sum()))
p('   non-CHIP tokens on those rows:',
  dict(collections.Counter(t for s in d.loc[~d['chip_tok'], 'Gene Names'] for t in tok(s))))
present = {g for s in d['Gene Names'] for g in tok(s) if g in chip}
p('   CHIP genes observed: %d/%d ; never observed: %s' % (len(present), len(chip), sorted(chip - present)))
p('   Exon Number column populated for 100%% of rows (%d non-null) -> not usable as exonic test'
  % d['Exon Number (Clinically Relevant)'].notna().sum())

d['key'] = d['Chr:Pos'] + ':' + d['Ref/Alt']
dup = d[d.duplicated(subset=['sample', 'Chr:Pos', 'Ref/Alt'], keep=False)]
p('   within-sample duplicate keys (sample,Chr:Pos,Ref/Alt): %d extra rows; SO terms involved: %s'
  % (d.duplicated(subset=['sample', 'Chr:Pos', 'Ref/Alt']).sum(), dict(dup['SO'].value_counts())))
p('   unique variant keys across all files: %d (fixed panel site list, %d-%d rows per file)'
  % (d['key'].nunique(), d.groupby('sample').size().min(), d.groupby('sample').size().max()))

# ------------------------------------------- 3. sensitivity of the (future) count
NR = ['Heterozygous', 'Homozygous Variant']
CORE = {'synonymous_variant', 'missense_variant', 'frameshift_variant',
        'inframe_insertion', 'inframe_deletion'}
nr = d['Zygosity'].isin(NR)
p('\n3. SENSITIVITY OF THE FUTURE COUNT (occurrence basis; deltas only):')
p('   rows matching non-reference + CHIP-token + core-exonic:', int((nr & d.chip_tok & d.SO.isin(CORE)).sum()))
for lbl, m in [
    ('  + splice_region_variant', nr & d.chip_tok & d.SO.eq('splice_region_variant')),
    ("  + 5'UTR premature-start-codon-gain", nr & d.chip_tok & d.SO.eq('5_prime_UTR_premature_start_codon_gain_variant')),
    ('  + upstream_gene_variant', nr & d.chip_tok & d.SO.eq('upstream_gene_variant')),
    ('  CHIP via In_CHIP flag instead of gene-name token', nr & ~d.chip_tok & d.SO.isin(CORE)),
    ('  blank Zygosity counted as variant', d['Zygosity'].isna() & d.chip_tok & d.SO.isin(CORE)),
]:
    p('     delta %-46s %+d rows' % (lbl, int(m.sum())))
p('     unique-site (Chr:Pos:Alt) basis for the same row set:',
  int(d.loc[nr & d.chip_tok & d.SO.isin(CORE), 'key'].nunique()))

open(os.path.join(HERE, '..', 'work', 'inventory_report.txt'), 'w').write('\n'.join(OUT) + '\n')
