"""Shared loader for the CHIP exome workbook capsule (used by all analysis steps).

Each sample workbook in data/CHIP_DP10_GQ20_PASS/ has:
  row 1 = column-group titles (Variant Info / Flags / <Relation> (sample) / ...)
  row 2 = real column names
  row 3.. = variant rows
We read with header=1 (0-based -> second row) and add sample/source columns.
"""
import glob, os
import pandas as pd

DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'data')
DATA = os.path.abspath(DATA)
SAMPLE_DIR = os.path.join(DATA, 'CHIP_DP10_GQ20_PASS')
PREFIX = '230209_Exome_GRCh38_CHIP_'
CACHE = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'combined.pkl')


def chip_genes(path=None):
    path = path or os.path.join(DATA, '230214_Schenz_et_al_2022_CHIP_Genes.xlsx')
    s = pd.read_excel(path, sheet_name=0, header=None)[0].astype(str).str.strip()
    return sorted(dict.fromkeys(s))          # order-preserving de-dup


def sample_files():
    return sorted(glob.glob(os.path.join(SAMPLE_DIR, PREFIX + '*.xlsx')))


def load_combined(use_cache=True):
    if use_cache and os.path.exists(CACHE):
        return pd.read_pickle(CACHE)
    frames = []
    for f in sample_files():
        df = pd.read_excel(f, sheet_name=0, header=1, engine='openpyxl')
        df.columns = [str(c).strip() for c in df.columns]
        # de-duplicate the three repeated 'Match' headers -> Match, Match.1, Match.2
        df['source_file'] = os.path.basename(f)
        df['sample'] = os.path.basename(f)[len(PREFIX):-5]
        frames.append(df)
    all_df = pd.concat(frames, ignore_index=True)
    all_df.to_pickle(CACHE)
    return all_df


if __name__ == '__main__':
    d = load_combined()
    print(d.shape, d['sample'].nunique())
