#!/usr/bin/env python3
"""BixBench bix-16-q2: skewness of the gene-expression (batch-corrected log2(TPM+1))
distribution across all cell lines.
Rows = cell lines (ModelID), cols = protein-coding genes. Primary metric (pre-registered):
pooled Fisher-Pearson skewness g1 (scipy.stats.skew, bias=True) of ALL 1673x19138 values,
no clipping, no filtering. Evidence: expression_skewness_figure.svg, skewness_results.txt,
per_cellline_skewness.csv
"""
import time
import numpy as np
import pandas as pd
from scipy import stats
from scipy.ndimage import uniform_filter1d

EXPR = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
MODEL = "data/Model.csv"
FIG, LOG, PERLINE = "expression_skewness_figure.svg", "skewness_results.txt", "per_cellline_skewness.csv"

_lines = []
def log(msg=""):
    print(msg, flush=True)
    _lines.append(str(msg))

def qskew(q1, q2, q3):
    return (q3 + q1 - 2.0 * q2) / (q3 - q1)

def describe(name, x):
    x = np.asarray(x, dtype=np.float64)
    q1, q2, q3 = np.quantile(x, [0.25, 0.5, 0.75])
    d = dict(n=x.size, mean=x.mean(), sd=x.std(ddof=1), median=q2, min=x.min(), max=x.max(),
             p05=np.quantile(x, .05), p95=np.quantile(x, .95),
             g1=stats.skew(x, bias=True), G1=stats.skew(x, bias=False),
             kurt=stats.kurtosis(x, fisher=True), bowley=qskew(q1, q2, q3))
    log(f"[{name}] n={d['n']:,} mean={d['mean']:.4f} sd={d['sd']:.4f} median={d['median']:.4f} "
        f"min={d['min']:.4f} max={d['max']:.4f}")
    log(f"[{name}] 1/5/25/50/75/95/99% = " +
        " / ".join(f"{np.quantile(x, p):.4f}" for p in (.01, .05, .25, .5, .75, .95, .99)))
    log(f"[{name}] g1(bias=True)={d['g1']:.4f}  G1(bias-corrected)={d['G1']:.4f}  "
        f"excess kurtosis={d['kurt']:.4f}  quartile(Bowley) skew={d['bowley']:.4f}")
    return d

def streaming_skew(path, chunksize=300):
    n = s1 = s2 = s3 = 0.0
    for ch in pd.read_csv(path, index_col=0, chunksize=chunksize):
        f = ch.to_numpy(copy=False).reshape(-1)
        f = f[~np.isnan(f)].astype(np.float64)
        n += f.size; s1 += f.sum(); s2 += (f * f).sum(); s3 += (f ** 3).sum()
    m = s1 / n; m2 = s2 / n - m * m
    m3 = s3 / n - 3 * m * s2 / n + 2 * m ** 3
    return m3 / m2 ** 1.5

def find_peaks(counts, edges, rel_prom=0.02):
    c = uniform_filter1d(counts.astype(np.float64), size=9)
    thr = rel_prom * c.max(); peaks = []
    for i in range(2, len(c) - 2):
        if c[i] >= c[i-1] and c[i] >= c[i+1] and c[i] > c[i-2] and c[i] > c[i+2] and c[i] > thr:
            peaks.append((0.5 * (edges[i] + edges[i+1]), c[i]))
    merged = []
    for p, h in peaks:
        if merged and p - merged[-1][0] < 0.75:
            if h > merged[-1][1]:
                merged[-1] = (p, h)
        else:
            merged.append((p, h))
    return merged

def ascii_hist(x, bins, lo, hi, label=""):
    h, ed = np.histogram(x, bins=bins, range=(lo, hi))
    mx = max(h.max(), 1)
    log(f"--- ASCII histogram {label} (bin={(hi-lo)/bins:.2f}, bar length log-scaled) ---")
    for i, c in enumerate(h):
        ln = 0 if c == 0 else int(round(56 * np.log10(c) / np.log10(mx)))
        log(f"{ed[i]:7.2f} |{'#'*ln} {c}")

def svg_histogram(panels, path, width=1180, height=430):
    pw = (width - 30 * len(panels) - 20) // len(panels); ph = 300; top = 44
    o = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
         f'viewBox="0 0 {width} {height}" font-family="Helvetica,Arial,sans-serif">',
         f'<rect width="{width}" height="{height}" fill="white"/>']
    for k, p in enumerate(panels):
        x0 = 26 + k * (pw + 30); y0 = top + ph; ymax = max(p["counts"]); n = len(p["counts"])
        sx = lambda i: x0 + i * pw / n
        sy = lambda v: y0 - (np.log10(max(v, 1)) / np.log10(ymax)) * ph
        o.append(f'<text x="{x0}" y="{top-22}" font-size="14" font-weight="bold">{p["title"]}</text>')
        o.append(f'<text x="{x0}" y="{top-6}" font-size="11" fill="#555">{p.get("sub","")}</text>')
        pts = " ".join(f"{sx(i)+pw/n/2:.1f},{sy(v):.1f}" for i, v in enumerate(p["counts"]))
        o.append(f'<polyline points="{pts}" fill="none" stroke="{p.get("color","#1f4e79")}" stroke-width="1.6"/>')
        for v, lab, col in p.get("vlines", []):
            fr = (v - p["lo"]) / (p["hi"] - p["lo"])
            if 0 <= fr <= 1:
                xv = x0 + fr * pw
                o.append(f'<line x1="{xv:.1f}" y1="{top}" x2="{xv:.1f}" y2="{y0}" stroke="{col}" '
                         f'stroke-width="1" stroke-dasharray="4,3"/>')
                o.append(f'<text x="{xv+3:.1f}" y="{top+12}" font-size="10" fill="{col}">{lab}</text>')
        for f in (0, .25, .5, .75, 1.0):
            xv = x0 + f * pw; val = p["lo"] + f * (p["hi"] - p["lo"])
            o.append(f'<line x1="{xv:.1f}" y1="{y0}" x2="{xv:.1f}" y2="{y0+4}" stroke="#333"/>')
            o.append(f'<text x="{xv:.1f}" y="{y0+16}" font-size="10" text-anchor="middle">{val:.2f}</text>')
        o.append(f'<line x1="{x0}" y1="{y0}" x2="{x0+pw}" y2="{y0}" stroke="#333"/>')
        o.append(f'<line x1="{x0}" y1="{top}" x2="{x0}" y2="{y0}" stroke="#333"/>')
        o.append(f'<text x="{x0+pw/2}" y="{y0+34}" font-size="11" text-anchor="middle">{p.get("xlab","")}</text>')
        o.append(f'<text x="{x0-8}" y="{top+ph/2}" font-size="11" text-anchor="middle" '
                 f'transform="rotate(-90 {x0-8} {top+ph/2})">{p.get("ylab","count (log10)")}</text>')
    o.append('<text x="26" y="418" font-size="10" fill="#555">DepMap batch-corrected log2(TPM+1); '
             '1673 cell lines x 19138 protein-coding genes = 32,017,874 values; no filtering, no clipping.</text>')
    o.append("</svg>")
    open(path, "w").write("\n".join(o))

t0 = time.time()
log("=" * 98); log("STEP 1  load expression matrix")
df = pd.read_csv(EXPR, index_col=0)
V = df.to_numpy(copy=False)
log(f"shape={V.shape} (rows=cell lines/ModelID, cols=genes) dtype={V.dtype} "
    f"NaN={int(np.isnan(V).sum())} unique ModelID={pd.Index(df.index).nunique()} "
    f"dup={pd.Index(df.index).duplicated().sum()}")
flat = V.reshape(-1)
log(f"cells={flat.size:,} min={flat.min():.6f} max={flat.max():.6f} "
    f"frac<0={np.mean(flat<0):.4%} frac==0={np.mean(flat==0):.4%}  elapsed {time.time()-t0:.1f}s")

log(); log("=" * 98); log("STEP 2  PRIMARY: pooled skewness over ALL values (no filter, no clip)")
pool = describe("pooled(all values)", flat)
g1 = pool["g1"]
strength = ("very weak" if abs(g1) < .1 else "weak" if abs(g1) < .3 else
            "moderate" if abs(g1) < 1 else "strong")
direction = "positive / right-skewed (long tail at the HIGH-expression end)" if g1 > 0 else \
            "negative / left-skewed (long tail at the LOW-expression end)"
log(f">>> PRIMARY ANSWER: pooled g1 (scipy.stats.skew, bias=True) = {g1:.4f} -> {strength} {direction}")
log(f"    G1(bias=False)={pool['G1']:.4f}  Bowley={pool['bowley']:.4f}  "
    f"mean-median gap={pool['mean']-pool['median']:+.4f}")
log(); log("STEP 2b  memory-safe streaming-moment equivalence check")
g1_stream = streaming_skew(EXPR, 300)
rng = np.random.default_rng(0); sub = rng.choice(flat, size=200_000, replace=False)
m = sub.mean(); one_pass = ((sub-m)**3).mean() / (((sub-m)**2).mean() ** 1.5)
log(f"streaming full-data g1={g1_stream:.10f} vs full-array g1={g1:.10f} |diff|={abs(g1_stream-g1):.3e}")
log(f"200k subsample: one-pass m3/m2^1.5={one_pass:.10f} vs scipy skew={stats.skew(sub, bias=True):.10f} "
    f"|diff|={abs(one_pass-stats.skew(sub, bias=True)):.3e} (algorithms agree)")

log(); log("=" * 98); log("STEP 3  shape diagnostics: near-zero/negative pile-up + high-expression tail")
for th in (0.0, 0.5, 1.0, 2.0):
    log(f"  frac of all values < {th:>4.1f} = {np.mean(flat < th):7.4%}")
log(f"  frac > 8 = {np.mean(flat > 8):.4%}   frac > 10 = {np.mean(flat > 10):.4%}")
lo, hi = -3.0, 14.0
cnts, edg = np.histogram(flat, bins=340, range=(lo, hi))
pk = find_peaks(cnts, edg)
log("  smoothed-histogram local maxima in [-3,14]: " +
    ", ".join(f"mode~{p:.2f} (count {h:.3g})" for p, h in pk))
mode_glob = pk[int(np.argmax([h for _, h in pk]))][0] if pk else float("nan")
for a, b in ((.99, .01), (.975, .025), (.95, .05)):
    hq, lq = np.quantile(flat, a), np.quantile(flat, b); med = pool["median"]
    log(f"  tail asymmetry P{int(a*100)}/P{int(b*100)}: upper-median={hq-med:.3f} vs "
        f"median-lower={med-lq:.3f} ratio={(hq-med)/max(med-lq,1e-9):.2f}")
ascii_hist(flat, 44, -3, 18, "pooled expression values")

log(); log("STEP 3b  nature of the near-zero spike (zero-inflation-like pile-up)")
spike = flat[(flat > -0.2) & (flat < 0.4)]
log(f"  {spike.size:,} pooled values ({spike.size/flat.size:.2%}) fall in [-0.2, 0.4): a dense pile-up of"
    f" essentially unexpressed genes (raw log2(TPM+1) ~ 0), spread over many distinct values"
    f" ({np.unique(np.round(spike, 4)).size:,} distinct at 4 dp), i.e. not a single point mass")
cnt = np.array([np.sum((V[i] > -0.2) & (V[i] < 0.4)) for i in range(V.shape[0])])
negfrac = (V < 0).mean(axis=1)
log(f"  genes in the pile-up per cell line [-0.2,0.4): median {np.median(cnt):.0f} of 19138 "
    f"(range {cnt.min()}-{cnt.max()})")
log(f"  the negative values are just the left skirt of this pile-up crossing zero after batch "
    f"correction: frac of all values in [-0.2,0) = {np.mean((V >= -0.2) & (V < 0)):.4%}, while "
    f"frac < -0.2 is only {np.mean(V < -0.2):.4%}; per-line frac < 0 ranges "
    f"{negfrac.min():.2%} - {negfrac.max():.2%} (median {np.median(negfrac):.2%})")

log(); log("=" * 98); log("STEP 4  VIEW A: per-cell-line skewness (each line over 19138 genes)")
line_sk = stats.skew(V, axis=1, bias=True)
q1l, q2l, q3l = np.quantile(V, [.25, .5, .75], axis=1)
line_bow = qskew(q1l, q2l, q3l)
d = describe("per-cell-line skewness", line_sk)
log(f"  lines with skew>0: {(line_sk>0).sum()}/{line_sk.size} ({(line_sk>0).mean():.2%})   "
    f"|skew|>0.5: {(np.abs(line_sk)>.5).sum()}   |skew|>1: {(np.abs(line_sk)>1).sum()}")
log(f"  per-line Bowley skew: median={np.median(line_bow):.4f} "
    f"[Q1={np.quantile(line_bow,.25):.4f}, Q3={np.quantile(line_bow,.75):.4f}], "
    f"positive in {(line_bow>0).sum()}/{line_bow.size} lines")
meta = pd.read_csv(MODEL, usecols=["ModelID", "CellLineName", "StrippedCellLineName",
                                  "OncotreeLineage", "DepmapModelType"], low_memory=False
                   ).set_index("ModelID")
per = pd.DataFrame({"skewness_g1": line_sk, "quartile_skew": line_bow,
                    "median_expr": np.median(V, axis=1), "mean_expr": V.mean(axis=1)},
                   index=pd.Index(df.index, name="ModelID")).join(meta)
log(f"  metadata join: {per['CellLineName'].isna().sum()} lines without CellLineName of {len(per)}")
per.to_csv(PERLINE)
cols = ["CellLineName", "OncotreeLineage", "DepmapModelType", "skewness_g1", "quartile_skew", "median_expr"]
log("  most right-skewed lines:\n" + per.sort_values("skewness_g1", ascending=False).head(3)[cols].to_string())
log("  least right-skewed lines:\n" + per.sort_values("skewness_g1").head(3)[cols].to_string())

log(); log("=" * 98); log("STEP 4b  VIEW B: per-gene skewness across 1673 cell lines")
gene_sk = stats.skew(V, axis=0, bias=True)
gd = describe("per-gene skewness", gene_sk)
log(f"  genes with skew>0: {(gene_sk>0).sum()}/{gene_sk.size} ({(gene_sk>0).mean():.2%})  "
    f"|skew|>1: {(np.abs(gene_sk)>1).sum()}")
rowmeans = V.mean(axis=1)
log(f"  why pooled differs from per-line: skew of the between-cell-line mean-expression "
    f"distribution = {stats.skew(rowmeans, bias=True):+.4f} (mean {rowmeans.mean():.3f}, "
    f"sd {rowmeans.std():.3f}); mean within-gene sd across lines = {V.std(axis=0).mean():.3f}")

log(); log("=" * 98); log("STEP 5  SENSITIVITY analyses (side-by-side, NOT the primary answer)")
def pooled(x, label):
    q1, q2, q3 = np.quantile(x, [.25, .5, .75])
    s = stats.skew(x, bias=True)
    log(f"  {label:<46s} n={x.size:>11,} g1={s:+.4f} G1={stats.skew(x, bias=False):+.4f} "
        f"Bowley={qskew(q1,q2,q3):+.4f} mean={x.mean():+.4f} median={q2:+.4f}")
    return s
thr999 = np.quantile(flat, .999); thr99 = np.quantile(flat, .99)
sens = {}
sens["clip<0 -> 0"] = pooled(np.clip(flat, 0, None), "S1 clip negatives to 0 (raw-like log2(TPM+1))")
sens["trim top 0.1%"] = pooled(flat[flat <= thr999], f"S2 drop top 0.1% (> {thr999:.3f})")
sens["trim top 1%"] = pooled(flat[flat <= thr99], f"S3 drop top 1% (> {thr99:.3f})")
sens["drop <0.5"] = pooled(flat[flat >= .5], "S4 drop values < 0.5 (near-zero pile-up removed)")
sens["drop <0"] = pooled(flat[flat >= 0.], "S5 drop negative values")
log("  per-cell-line median skewness under the same perturbations:")
log(f"    S1 clip-to-0: median per-line skew = {np.median(stats.skew(np.clip(V,0,None), axis=1, bias=True)):+.4f}")
Vw = V.copy(); Vw[Vw > thr999] = thr999
log(f"    S2 winsorise top 0.1%: median per-line skew = "
    f"{np.median(stats.skew(Vw, axis=1, bias=True)):+.4f}")

log(); log("=" * 98); log("STEP 6  figure (dependency-free SVG; matplotlib unavailable offline)")
svg_histogram([
    dict(counts=cnts, lo=lo, hi=hi, color="#1f4e79",
         title="A. Pooled expression distribution (32,017,874 values, log10 y)",
         sub=f"g1={g1:.3f}  G1={pool['G1']:.3f}  Bowley={pool['bowley']:.3f}  "
             f"median={pool['median']:.2f}  mean={pool['mean']:.2f}  dominant mode~{mode_glob:.2f}",
         xlab="batch-corrected log2(TPM+1)",
         vlines=[(0.0, "0", "#888888"), (mode_glob, "mode", "#7030a0"),
                 (pool["median"], "median", "#c00000"), (pool["mean"], "mean", "#007a00")]),
    dict(counts=np.histogram(line_sk, bins=80, range=(float(line_sk.min()), float(line_sk.max())))[0],
         lo=float(line_sk.min()), hi=float(line_sk.max()), color="#7030a0",
         title="B. Per-cell-line skewness (1673 lines, log10 y)",
         sub=f"median={np.median(line_sk):.3f} [Q1 {np.quantile(line_sk,.25):.2f}, "
             f"Q3 {np.quantile(line_sk,.75):.2f}]  {(line_sk>0).mean():.1%} of lines positive",
         xlab="skewness g1 per cell line",
         vlines=[(0.0, "0", "#888888"), (float(np.median(line_sk)), "median", "#c00000")]),
], FIG)
log(f"  wrote {FIG}")

log(); log("=" * 98); log("STEP 7  FINAL SUMMARY")
log(f"  PRIMARY pooled g1 (bias=True)   : {g1:.4f}  ({strength}; {direction})")
log(f"  pooled G1 / Bowley / ex-kurtosis: {pool['G1']:.4f} / {pool['bowley']:.4f} / {pool['kurt']:.4f}")
log(f"  per-cell-line skew median [IQR] : {d['median']:.4f} [{np.quantile(line_sk,.25):.4f}, "
    f"{np.quantile(line_sk,.75):.4f}]  5-95% [{d['p05']:.4f}, {d['p95']:.4f}]  "
    f"{(line_sk>0).mean():.2%} positive")
log(f"  per-gene skew median [IQR]      : {gd['median']:.4f} "
    f"[{np.quantile(gene_sk,.25):.4f}, {np.quantile(gene_sk,.75):.4f}]  {(gene_sk>0).mean():.2%} positive")
log(f"  sensitivity g1: " + ", ".join(f"{k}={v:+.3f}" for k, v in sens.items()))
log(f"  total elapsed {time.time()-t0:.1f}s")
open(LOG, "w").write("\n".join(_lines) + "\n")
