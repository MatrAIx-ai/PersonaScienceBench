#!/usr/bin/env python3
"""
Pearson correlation between gene length and mean expression (across CD14 samples)
for protein-coding genes.

Fixed analysis protocol (researcher-approved):
  - Samples: all columns where Sample_annotated celltype == 'CD14' (must equal
    columns whose name contains 'CD14'); no samtype/batch filtering, no donor dedup.
  - Genes: gene_biotype == 'protein_coding' (all 19,942 incl. 1,849 always-zero).
  - Expression: raw BatchCorrectedReadCounts, arithmetic row mean over sample cols,
    no CPM/TPM normalization (A1), no log transform (A5), zero genes kept (A4).
  - Main r via scipy.stats.pearsonr, cross-checked with numpy corrcoef.
Sensitivity (reference only): S1 drop zero-mean genes; S2 log2(1+mean); S3 refsamp / nonrefsamp subsets.
"""
import pandas as pd
import numpy as np
from scipy import stats

DATA = "data"

# ---------- load ----------
meta = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv")
ann = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")
X = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0, low_memory=False)

print(f"Expression matrix: {X.shape[0]} genes x {X.shape[1]} samples")
print(f"GeneMetaInfo rows: {meta.shape[0]} | Sample annotations: {ann.shape[0]}")

# ---------- consistency assertions ----------
assert X.index.duplicated().sum() == 0, "duplicate genes in expression matrix"
assert pd.Index(X.columns).duplicated().sum() == 0, "duplicate sample columns"
assert X.isna().values.sum() == 0, "NaNs present in expression matrix"
assert meta["Geneid"].duplicated().sum() == 0
assert set(X.columns) == set(ann["sample"]), "sample columns != annotations"
assert set(X.index) == set(meta["Geneid"]), "expression genes != GeneMetaInfo Geneid"

# CD14 dual-criterion
cd14_by_celltype = set(ann.loc[ann["celltype"] == "CD14", "sample"])
cd14_by_name = {c for c in X.columns if "CD14" in c}
assert cd14_by_celltype == cd14_by_name, "CD14 celltype set != CD14 name-pattern set"
cd14_cols = sorted(cd14_by_celltype)
assert len(cd14_cols) == 132, f"expected 132 CD14 columns, got {len(cd14_cols)}"

# protein-coding genes
pc_genes = meta.loc[meta["gene_biotype"] == "protein_coding", "Geneid"]
assert len(pc_genes) == 19942
assert set(pc_genes) <= set(X.index)

# ---------- main analysis ----------
length = meta.set_index("Geneid").loc[X.index, "Length"]
sub = X.loc[pc_genes, cd14_cols]
mean_expr = sub.mean(axis=1)
L = length.loc[pc_genes].values.astype(float)
M = mean_expr.values.astype(float)
assert np.isfinite(L).all() and np.isfinite(M).all()

r_main, p_main = stats.pearsonr(L, M)
r_np = np.corrcoef(L, M)[0, 1]
assert abs(r_main - r_np) < 1e-10, "scipy vs numpy mismatch"

n_zero = int((mean_expr == 0).sum())
print("\n===== MAIN RESULT =====")
print(f"CD14 samples: {len(cd14_cols)}")
print(f"Protein-coding genes: {len(pc_genes)} (always-zero genes kept: {n_zero})")
print(f"Pearson r = {r_main:.6f}  (numpy cross-check: {r_np:.6f})")
print(f"p-value   = {p_main:.6e}")
print(f"Direction: {'positive' if r_main > 0 else 'negative'} association between gene length and mean expression")

# ---------- sensitivity analyses (reference only) ----------
print("\n===== SENSITIVITY (reference only, NOT the main result) =====")

# S1: drop always-zero genes
keep = mean_expr.values > 0
r_s1, p_s1 = stats.pearsonr(L[keep], M[keep])
print(f"S1 drop zero-mean genes: n_genes={int(keep.sum())}, r={r_s1:.6f}, p={p_s1:.6e}")

# S2: log2(1+mean)
r_s2, p_s2 = stats.pearsonr(L, np.log2(1.0 + M))
print(f"S2 log2(1+mean) scale:   n_genes={len(pc_genes)}, r={r_s2:.6f}, p={p_s2:.6e}")

# S3: refsamp / nonrefsamp subsets
for st in ["refsamp", "nonrefsamp"]:
    cols = ann.loc[(ann["celltype"] == "CD14") & (ann["samtype"] == st), "sample"]
    cols = sorted(set(cols))
    m = X.loc[pc_genes, cols].mean(axis=1).values.astype(float)
    r_st, p_st = stats.pearsonr(L, m)
    print(f"S3 {st:>10s}: n_samples={len(cols)}, r={r_st:.6f}, p={p_st:.6e}")

# assumptions echo
print("\nAssumptions: A1 raw BatchCorrectedReadCounts, no CPM/TPM; "
      "A4 always-zero genes kept in main; A5 Pearson on raw (untransformed) scale.")
