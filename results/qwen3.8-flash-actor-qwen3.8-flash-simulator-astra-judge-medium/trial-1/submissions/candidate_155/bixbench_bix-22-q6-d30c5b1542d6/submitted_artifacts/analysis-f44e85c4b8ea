#!/usr/bin/env python3
"""
BixBench bix-22-q6
Question: "When examining protein-coding genes only, what is the pearson correlation
           coefficient between gene length and gene expression?"

Fixed (approved) specification for the ANSWER:
  * sample      : gene_biotype == 'protein_coding' (strict equality), N = 19 942 genes
  * join        : inner join on gene id (GeneMetaInfo index/Geneid  x  counts index)
  * length      : meta['Length'] as-is, base pairs, NO log
  * expression  : counts.mean(axis=1) over all 723 samples, raw batch-corrected counts,
                  NO CPM/TPM normalisation, NO log transform
  * filtering   : none (genes with mean == 0 kept)
  * statistic   : Pearson r on the single vector pair, rounded to 3 decimals in the answer;
                  full precision kept in the artefact
Everything else is reported only as a sensitivity table.

Non-interactive, fully reproducible:  python analysis/gene_length_vs_expression.py
"""
import os
import numpy as np
import pandas as pd
from scipy import stats

DATA = os.environ.get("DATA_DIR", "data")
OUT = os.environ.get("OUT_DIR", "analysis")
os.makedirs(OUT, exist_ok=True)

META_F = os.path.join(DATA, "GeneMetaInfo_Zenodo.csv")
COUNTS_F = os.path.join(DATA, "BatchCorrectedReadCounts_Zenodo.csv")
SAMP_F = os.path.join(DATA, "Sample_annotated_Zenodo.csv")

# ---------------------------------------------------------------- load inputs
meta = pd.read_csv(META_F, index_col=0)
counts = pd.read_csv(COUNTS_F, index_col=0)
samp = pd.read_csv(SAMP_F)

log = []
def p(*a):
    line = " ".join(str(x) for x in a)
    log.append(line)
    print(line)

p("== INPUT QC ==")
p(f"meta shape {meta.shape} cols {list(meta.columns)}")
p(f"counts shape {counts.shape} (genes x samples), dtypes {sorted(set(map(str, counts.dtypes)))}")
p(f"sample annotation shape {samp.shape} cols {list(samp.columns)}")
assert meta.index.name is None and counts.index.name is None

# ------------------------------------------------- strict protein_coding subset
bt = meta["gene_biotype"].astype(str)
pc_mask = bt == "protein_coding"
pc_ids_all = meta.index[pc_mask]
p(f"protein_coding (strict) genes in meta: {len(pc_ids_all)}")
contains = bt.str.split(";").apply(lambda L: "protein_coding" in L)
p(f"'contains protein_coding' variant (NOT used for the answer): {int(contains.sum())}")

# gene-level table with inner join onto the expression matrix
genes = pd.DataFrame({"Length": meta.loc[pc_mask, "Length"].astype("int64")})
genes = genes.join(counts, how="inner")
N = len(genes)
p(f"N rows after inner join (expected 19942): {N}")
assert N == 19942 == len(pc_ids_all), f"unexpected join size {N}"

X = genes["Length"].to_numpy(dtype="float64")           # gene length, bp, raw
C = genes.drop(columns=["Length"])                       # 19942 x 723 raw counts
assert C.shape == (19942, 723)

libsize = counts.sum(axis=0).to_numpy(dtype="float64")   # per-sample depth (all genes)
cpm = C.to_numpy(dtype="float64") / libsize[None, :] * 1e6

# ------------------------------------------------------------ PRIMARY metric
mean_raw = C.mean(axis=1)                                # expression per gene
r_primary, p_primary = stats.pearsonr(X, mean_raw)
zero_frac = float((mean_raw == 0).mean())
p("")
p("== PRIMARY (reported answer) ==")
p(f"Pearson r = {r_primary!r}")
p(f"p-value   = {p_primary!r}")
p(f"N genes   = {N}")
p(f"rounded (3 dp) = {round(r_primary, 3)}")
p(f"genes with mean expression == 0: {int((mean_raw == 0).sum())} ({zero_frac:.4%})")
p(f"genes with mean expression < 1 : {int((mean_raw < 1).sum())} ({(mean_raw < 1).mean():.4%})")
p(f"mean expression: mean={mean_raw.mean():.3f} median={np.median(mean_raw):.3f} max={mean_raw.max():.1f}")
p(f"Length (bp): min={X.min():.0f} median={np.median(X):.0f} max={X.max():.0f}")

# ------------------------------------------------------------ sensitivity grid
rows = []
def add(name, x, y, method="pearson", n=None, note=""):
    if method == "pearson":
        r, pv = stats.pearsonr(x, y)
    else:
        res = stats.spearmanr(x, y)
        r, pv = res.statistic, res.pvalue
    rows.append(dict(variant=name, method=method, N=n if n is not None else len(x),
                     r=r, p=pv, note=note))

add("PRIMARY: Length x mean(raw counts)", X, mean_raw)
add("median(raw counts) instead of mean", X, np.median(C.to_numpy(dtype="float64"), axis=1))
add("mean of log2(CPM+1) [depth-normalised]", X, np.log2(cpm + 1.0).mean(axis=1))
add("mean CPM", X, cpm.mean(axis=1))
add("log10(Length+1) x log(mean+1)", np.log10(X + 1.0), np.log(mean_raw + 1.0))

keep = mean_raw > 0
add("drop mean == 0", X[keep], mean_raw[keep], n=int(keep.sum()),
    note=f"dropped {int((~keep).sum())}")
keep1 = mean_raw >= 1
add("drop mean < 1", X[keep1], mean_raw[keep1], n=int(keep1.sum()),
    note=f"dropped {int((~keep1).sum())}")

# cell-type-first averaging: mean within cell type, then unweighted mean of the 5 types
ct = samp.set_index("sample")["celltype"]
col_ct = pd.Series(ct.reindex(C.columns).to_numpy(), dtype="object")
assert col_ct.isna().sum() == 0, "unannotated sample columns"
type_means = []
for t in sorted(pd.unique(col_ct.dropna())):
    type_means.append(C.to_numpy(dtype="float64")[:, col_ct == t].mean(axis=1))
type_means = np.vstack(type_means)
p(f"cell types used for type-first averaging: {sorted(pd.unique(col_ct.dropna()))} "
  f"(n per type: {[int((col_ct == t).sum()) for t in sorted(pd.unique(col_ct.dropna()))]})")
add("cell-type-first averaging (mean of 5 type means)", X, type_means.mean(axis=0))
add("Spearman on primary pair (reference robustness)", X, mean_raw, method="spearman")

# 'contains' biotype variant (documented, not the answer)
contains_ids = meta.index[contains]
g2 = pd.DataFrame({"Length": meta.loc[contains, "Length"].astype("int64")}).join(counts, how="inner")
add("biotype 'contains protein_coding' (+12 genes)", g2["Length"].to_numpy("float64"),
    g2.drop(columns=["Length"]).to_numpy(dtype="float64").mean(axis=1),
    n=len(g2), note="variant only, NOT the answer")

sens = pd.DataFrame(rows)
p("")
p("== SENSITIVITY TABLE ==")
for _, rr in sens.iterrows():
    p(f"{rr['variant']:<48} | {rr['method']:<8} | N={int(rr['N']):>6} | r={rr['r']:+.5f} | p={rr['p']:.3g} | {rr['note']}")
prim = sens.loc[sens["variant"].str.startswith("PRIMARY"), "r"].iloc[0]
allr = sens["r"]
p(f"range of r over ALL variant specifications: min={allr.min():+.5f}  max={allr.max():+.5f}  "
  f"spread={allr.max() - allr.min():.5f}")
p(f"range excluding log-transformed variants: "
  f"min={sens.loc[~sens['variant'].str.contains('log'), 'r'].min():+.5f}  "
  f"max={sens.loc[~sens['variant'].str.contains('log'), 'r'].max():+.5f}")

# ------------------------- depth x batch confounding (quantification)
ls = pd.Series(libsize, index=counts.columns)
batch = samp.set_index("sample")["batch"].astype(str).reindex(counts.columns)
ls_log = np.log10(ls.to_numpy())
groups = [np.log10(ls[batch == b].to_numpy(dtype="float64")) for b in sorted(batch.dropna().unique())]
ss_tot = ((ls_log - ls_log.mean()) ** 2).sum()
ss_bet = sum(len(g) * (g.mean() - ls_log.mean()) ** 2 for g in groups)
eta2 = ss_bet / ss_tot
kw = stats.kruskal(*groups)
p("")
p("== DEPTH x BATCH CONFOUND (raw means are depth-weighted) ==")
for b in sorted(batch.dropna().unique()):
    p(f"  batch {b}: n={int((batch == b).sum()):>3} median library size={np.median(ls[batch == b]):,.0f}")
p(f"  eta^2 of batch on log10(library size) = {eta2:.4f}; Kruskal-Wallis H={kw.statistic:.1f}, p={kw.pvalue:.3g}")
p(f"  min/max library size = {ls.min():,.0f} / {ls.max():,.0f} (ratio {ls.max()/ls.min():.1f}x)")
r_cpm = sens.loc[sens["variant"] == "mean CPM", "r"].iloc[0]
r_lcpm = sens.loc[sens["variant"] == "mean of log2(CPM+1) [depth-normalised]", "r"].iloc[0]
p(f"  depth-normalisation shift in r: raw-mean {prim:+.5f} -> mean CPM {r_cpm:+.5f} "
  f"(delta {r_cpm - prim:+.5f}); mean log2(CPM+1) {r_lcpm:+.5f} (delta {r_lcpm - prim:+.5f})")

# ---------------------------------------------------------------- artefacts
p("")
p(f"ANSWER: Pearson r (Length vs mean expression, {N} protein-coding genes) = {r_primary:.6f} "
  f"-> {round(r_primary, 3)} (p = {p_primary:.3g})")

sens.to_csv(os.path.join(OUT, "sensitivity_table.csv"), index=False, float_format="%.10g")
pd.DataFrame({"gene": genes.index, "Length_bp": X, "mean_expression_raw": mean_raw}).to_csv(
    os.path.join(OUT, "protein_coding_length_vs_mean_expression.csv.gz"), index=False)
with open(os.path.join(OUT, "summary.txt"), "w") as fh:
    fh.write("\n".join(log) + "\n")
p(f"\nartefacts written to {OUT}/: summary.txt, sensitivity_table.csv, "
  f"protein_coding_length_vs_mean_expression.csv.gz")
