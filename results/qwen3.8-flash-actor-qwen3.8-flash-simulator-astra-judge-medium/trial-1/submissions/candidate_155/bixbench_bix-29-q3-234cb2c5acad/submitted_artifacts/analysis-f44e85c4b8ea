"""
BCG x prior medical history interaction on COVID-19 severity (ordinal regression).
BixBench bix-29-q3. Reproducible pipeline.

Model (primary): ordered logit (proportional odds)
    severity ~ BCG * MH_any + patients_seen(0/1/2)
Outcome: subject-level max AEHS over non-ISR adverse events (n=752).
Sensitivity: (a) all AEs incl. ISR (n=857); (b) only AEPT~'COVID' AEs (n=194).
PO assumption: LR test of proportional odds vs general (non-proportional) ordered logit.

Empirical assumptions (NOT documented in capsule):
 - BCG vaccination status proxied by randomization group TRTGRP;
 - MHORRES 1=No / 2=Yes in MEDICAL HISTORY checklist; null = No;
 - AEHS 0-7 ordinal severity scale, higher = worse;
 - prior history = >=1 'Yes' in fixed MH checklist (or free-text 'Other:').
"""
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from scipy.optimize import minimize
from scipy import stats

pd.set_option('display.width', 200)

# ---------------- 1. Load ----------------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', low_memory=False)
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', low_memory=False)
print(f"[load] DM {dm.shape} subj={dm.USUBJID.nunique()} | AE {ae.shape} subj={ae.USUBJID.nunique()} | MH {mh.shape} subj={mh.USUBJID.nunique()}")

# ---------------- 2. Aggregate to USUBJID ----------------
dm['BCG'] = (dm.TRTGRP == 'BCG').astype(int)

mh_chk = mh[mh.MHSCAT == 'MEDICAL HISTORY'].copy()
mh_chk['yes'] = mh_chk.MHORRES.eq(2) | mh_chk.MHDECOD.notna()
mh_any = mh_chk.groupby('USUBJID')['yes'].any().astype(int).rename('MH_any')

ae['AEHS_n'] = pd.to_numeric(ae.AEHS, errors='coerce')
sev_nonISR = ae[ae.AECAT != 'ISR'].groupby('USUBJID')['AEHS_n'].max().rename('sev')
sev_all    = ae.groupby('USUBJID')['AEHS_n'].max().rename('sev')
sev_covid  = ae[ae.AEPT.str.contains('COVID', case=False, na=False)].groupby('USUBJID')['AEHS_n'].max().rename('sev')

ps_map = {'1-50': 0, '51-100': 1, '>100': 2}
dm['patients_seen_ord'] = dm.patients_seen.map(ps_map)
assert dm.patients_seen_ord.notna().all()

def build(sev):
    d = dm.set_index('USUBJID').join(mh_any).join(sev)
    d = d[d.sev.notna() & d.MH_any.notna()].copy()
    d['MH_any'] = d.MH_any.astype(int)
    d['sev'] = d.sev.astype(int)
    return d

COVS = ['BCG', 'MH_any', 'patients_seen_ord']

def design(d):
    X = d[COVS].astype(float).copy()
    X['BCGxMH'] = d.BCG * d.MH_any
    return X  # OrderedModel supplies intercepts via thresholds

def fit_ordered(d, extra=None):
    X = design(d)
    if extra:
        X = pd.concat([X, d[extra].astype(float)], axis=1)
    m = OrderedModel(d.sev, X, distr='logit')
    r = m.fit(method='bfgs', maxiter=500, disp=0)
    return m, r

def report(r, name):
    print(f"\n===== {name} =====  n={int(r.nobs)}  converged={r.mle_retvals['converged']}")
    ci = r.conf_int()
    tab = pd.DataFrame({
        'beta': r.params, 'se': r.bse, 'p': r.pvalues,
        'OR': np.exp(r.params), 'OR_lo': np.exp(ci[0]), 'OR_hi': np.exp(ci[1])})
    print(tab.loc[[i for i in tab.index if not i.startswith('threshold')]].round(4).to_string())
    th = r.params[[i for i in r.params.index if i.startswith('threshold')]]
    print("thresholds:", th.round(3).to_dict())
    print("loglik=%.3f  llf_null=%.3f" % (r.llf, r.llnull))
    return tab

d_main = build(sev_nonISR)
print("\n[crosstab] BCG x MH_any (analysis pop):")
print(pd.crosstab(d_main.BCG, d_main.MH_any))
print("\n[dist] severity by BCG x MH_any cell:")
print(d_main.groupby(['BCG','MH_any'])['sev'].agg(['count','mean','median']).round(3).to_string())
print("\n[dist] severity distribution overall:", d_main.sev.value_counts().sort_index().to_dict())

m, r = fit_ordered(d_main)
tab_main = report(r, 'PRIMARY: max AEHS non-ISR, proportional odds')
b = r.params['BCGxMH']; lo, hi = r.conf_int().loc['BCGxMH']
print(f"\n>>> INTERACTION OR = {np.exp(b):.4f}  95% CI [{np.exp(lo):.4f}, {np.exp(hi):.4f}]  p={r.pvalues['BCGxMH']:.4f}")

# ---------------- 4. PO assumption: LR vs general (non-proportional) ordered logit ----------------
def general_ol_nll(theta, yi, X, J):
    K = X.shape[1]
    betas = theta[:K*J].reshape(K, J)     # slope per cumulative cut
    cuts = theta[K*J:]
    lin = cuts[None, :] + X @ betas       # linear predictors for P(Y<=j), j=1..J
    p = 1/(1+np.exp(-np.clip(lin, -35, 35)))
    n = len(yi)
    pcum = np.hstack([np.zeros((n,1)), p, np.ones((n,1))])
    pmf = pcum[np.arange(n), yi+1] - pcum[np.arange(n), yi]
    return -np.log(np.clip(pmf, 1e-300, None)).sum()

def fit_general(d):
    X = design(d).values
    y = d.sev.values
    cats = np.sort(np.unique(y)); ymap = {c:i for i,c in enumerate(cats)}
    yi = np.array([ymap[v] for v in y]); J = len(cats)-1
    K = X.shape[1]
    starts = [np.zeros(K*J + J)]
    coefs, cuts = [], []
    for j in range(1, J+1):
        yb = (yi <= j).astype(float)
        try:
            bf = sm.Logit(yb, sm.add_constant(X)).fit_regularized(alpha=1.0, disp=0, maxiter=200)
            coefs.append(np.asarray(bf.params[1:])); cuts.append(float(bf.params[0]))
        except Exception:
            coefs.append(np.zeros(K)); cuts.append(0.0)
    starts.append(np.concatenate([np.array(coefs).T.ravel(), np.array(cuts)]))
    starts.append(np.concatenate([np.tile(r.params.values[:K][:,None],(1,J)).ravel(), np.sort(r.params.values[K:K+J])]))
    best = None
    for s in starts:
        for meth in ('L-BFGS-B','BFGS'):
            try:
                res = minimize(general_ol_nll, s, args=(yi, X, J), method=meth,
                               options={'maxiter':20000, 'maxfun':60000,
                                        **({'gtol':1e-6} if meth=='BFGS' else {'ftol':1e-10,'gtol':1e-7})})
                if best is None or res.fun < best.fun:
                    best = res
            except Exception:
                pass
    return best, J, K

res_gen, J, K = fit_general(d_main)
k_gen = K*J + J
k_prop = K + J
df_lr = k_gen - k_prop
lr = 2*(-res_gen.fun - r.llf)  # 2*(llf_general - llf_proportional)
p_po = stats.chi2.sf(lr, df_lr) if lr > 0 else 1.0
print(f"\n[PO test] LR = {lr:.3f}, df = {df_lr}, p = {p_po:.4g}  (H0: proportional odds)")
print(f"  logLik proportional={r.llf:.3f} (k={k_prop}), general={-res_gen.fun:.3f} (k={k_gen}), general converged={res_gen.success}")
_b = res_gen.x[:K*J].reshape(K, J)
_names = list(design(d_main).columns)
print("[general model] BCGxMH coefficient per cumulative cut P(Y<=j):")
for j in range(J):
    print(f"   cut {cats if False else np.sort(d_main.sev.unique())[j]}|{np.sort(d_main.sev.unique())[j+1]}: beta={_b[_names.index('BCGxMH'), j]:.3f}  OR={np.exp(_b[_names.index('BCGxMH'), j]):.3f}")

# ---------------- 5. Tail-collapse fallback ----------------
d2 = d_main.copy()
d2['sev3'] = pd.cut(d2.sev, bins=[-1,1,2,99], labels=[0,1,2]).astype(int)
print("\n[collapse 0-1/2/3+] distribution:", d2.sev3.value_counts().sort_index().to_dict())
X2 = design(d2)
r2 = OrderedModel(d2.sev3, X2, distr='logit').fit(method='bfgs', maxiter=500, disp=0)
b2 = r2.params['BCGxMH']; lo2, hi2 = r2.conf_int().loc['BCGxMH']
print(f"[fallback 0-1/2/3+] INTERACTION OR = {np.exp(b2):.4f}  95% CI [{np.exp(lo2):.4f}, {np.exp(hi2):.4f}]  p={r2.pvalues['BCGxMH']:.4f}  converged={r2.mle_retvals['converged']}")

# PO LR test on collapsed 3-category outcome (stable, low counts in tails)
Xc = design(d2).values
yc = d2.sev3.values
ymap3 = {c:i for i,c in enumerate(np.sort(np.unique(yc)))}
yi3 = np.array([ymap3[v] for v in yc]); J3 = 2; K3 = Xc.shape[1]
best3 = None
for s in [np.zeros(K3*J3+J3)]:
    res3 = minimize(general_ol_nll, s, args=(yi3, Xc, J3), method='L-BFGS-B',
                    options={'maxiter':50000, 'maxfun':100000, 'ftol':1e-12, 'gtol':1e-9})
    if best3 is None or res3.fun < best3.fun: best3 = res3
# proportional fit on collapsed outcome
rc = OrderedModel(d2.sev3, design(d2), distr='logit').fit(method='bfgs', maxiter=500, disp=0)
lr3 = 2*(-best3.fun - rc.llf); df3 = (K3*J3+J3) - (K3+J3)
print(f"[PO test on collapsed 0-1/2/3+] LR = {lr3:.3f}, df = {df3}, p = {stats.chi2.sf(max(lr3,0), df3):.4g}")

# ---------------- 6. Sensitivity: other outcome definitions ----------------
for nm, s in [('SENS-1: max AEHS all AEs incl ISR', sev_all),
              ('SENS-2: max AEHS, AEPT~COVID only', sev_covid)]:
    dd = build(s)
    mm, rr = fit_ordered(dd)
    report(rr, nm)
    bb = rr.params['BCGxMH']; l, h = rr.conf_int().loc['BCGxMH']
    print(f">>> {nm}: INTERACTION OR = {np.exp(bb):.4f}  95% CI [{np.exp(l):.4f}, {np.exp(h):.4f}]  p={rr.pvalues['BCGxMH']:.4f}  n={int(rr.nobs)}")

# ---------------- 7. Reference check with demographics (NOT primary) ----------------
dm2 = dm.copy()
dm2['age_mid'] = dm2.Age.map({'10-19':15,'20-29':25,'30-39':35,'40-49':45,'50-59':55,'60-69':65,'70-79':75})
dref = build(sev_nonISR)[['MH_any','sev','BCG','patients_seen_ord']].join(dm2.set_index('USUBJID')[['SEX','age_mid','RACE']])
print('[check] dref NaNs:', dref.isna().sum().to_dict())
mr, rr = fit_ordered(dref, extra=['SEX','age_mid','RACE'])
report(rr, 'REFERENCE (not primary): + SEX, age midpoint, RACE')
bb = rr.params['BCGxMH']; l, h = rr.conf_int().loc['BCGxMH']
print(f">>> REF+demographics: INTERACTION OR = {np.exp(bb):.4f}  95% CI [{np.exp(l):.4f}, {np.exp(h):.4f}]  p={rr.pvalues['BCGxMH']:.4f}")
