    "Under the literal pooled test (p0 = 0.5 on integer normalised counts, n ~ 4e8 per gene) "
    "NO comparison reaches the analyst-set 'near-random-expectation' bands, because the "
    "normalised-count totals of the groups differ by up to 1.4x; the negligible call is "
    "therefore a RELATIVE statement supported consistently by every metric and variant.")


# ---- V3 (analyst-added robustness check): paired exact SIGN test, n = 30 patients
# The pooled-count test has binomial n ~ 4e8, so its p-values cannot be compared
# with the 5 % false-positive expectation at all.  A second, honestly scaled
# binomial exact test per gene: for the 30 patients that donate both tissues,
# k = number of patients with (count in A > count in B), n = number of informative
# (non-tied) patients, two-sided binomtest vs p0 = 0.5.
pat = np.array([c and r[1].split("_")[5] for c, r in zip(codes, meta)])
patients = sorted(set(pat))
report["robustness_variants_V3_sign_test"] = {}
for lbl, a, b in COMPS:
    ia = [i for i in range(90) if tissue[i] == a]
    ib_by_pat = {}
    for i in range(90):
        if tissue[i] == b:
            ib_by_pat[pat[i]] = i
    # one sample per tissue per patient -> paired difference matrix
    idxA = {pat[i]: i for i in range(90) if tissue[i] == a}
    Aidx = np.array([idxA[pt] for pt in patients if pt in idxA and pt in ib_by_pat])
    Bidx = np.array([ib_by_pat[pt] for pt in patients if pt in idxA and pt in ib_by_pat])
    d = Xr[:, Aidx] - Xr[:, Bidx]
    k = (d > 0).sum(axis=1); ties = (d == 0).sum(axis=1)
    nn = d.shape[1] - ties
    p_sign = np.ones(X.shape[0])
    valid = nn >= 1
    for i in np.where(valid & keep)[0]:
        o = binomtest(int(k[i]), int(nn[i]), P0)
        p_sign[i] = o.pvalue() if callable(o.pvalue) else float(o.pvalue)
    entry = summarise(dict(p=p_sign, log2fc=comp_run_primary[lbl]["log2fc"]), keep,
                      "V3 paired sign test (n = 30 patients)")
    entry["n_patients_paired"] = int(len(Aidx))
    entry["median_informative_patients_per_gene"] = int(np.median(nn[keep]))
    entry["median_ties_per_gene"] = int(np.median(ties[keep]))
    report["robustness_variants_V3_sign_test"][lbl] = entry
    print(lbl, "V3 sign-test sig:", entry["n_significant"], entry["frac_significant"],
          "up/down", entry["n_up"], entry["n_down"])
