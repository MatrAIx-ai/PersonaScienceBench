# =============== additional robustness variants (per researcher point 8) =====
# The literal pooled test against p0 = 0.5 is dominated by the fact that the two
# groups do not contain the same total number of (normalised) reads, e.g. final
# blood 586 M vs baseline blood 417 M; with binomial n ~ 4e8 even a 1 % global
# depth imbalance makes almost every gene 'significant'.  Two robustness variants
# are therefore reported (they do NOT replace the approved primary analysis):
#   V1 'expected_share': same integer counts, but p0 = totalA/(totalA+totalB)
#      (the share expected when nothing is differential) instead of 0.5.
#   V2 'depth_equalised': every sample is linearly rescaled to the median library
#      size (13,673,895) and rounded, so both groups hold equal total counts and
#      p0 = 0.5 becomes meaningful again.  (Diagnostic only: it is a rescaling.)
totA = {l: int(comp_run_primary[l]["k"][keep].sum()) for l, _, _ in COMPS}
totB = {l: int(comp_run_primary[l]["m"][keep].sum()) for l, _, _ in COMPS}
p0_share = {l: totA[l] / (totA[l] + totB[l]) for l, _, _ in COMPS}
med_lib = int(np.median([X[:, i].sum() for i in range(90)]))
X_eq = np.floor(X * (med_lib / np.array([X[:, i].sum() for i in range(90)])) + 0.5).astype(np.int64)

def pval_central_masked(k, N, mask, p0=P0):
    out = np.ones(len(k))
    for i in np.where(mask)[0]:
        if int(N[i]) < 1:      # gene expressed only in the third (unused) tissue
            continue
        o = binomtest(int(k[i]), int(N[i]), p0)
        out[i] = o.pvalue() if callable(o.pvalue) else float(o.pvalue)
    return out


Xr_eq = X_eq
report["robustness_variants"] = {}
for lbl, a, b in COMPS:
    ia, ib = tissue_idx(a, keep_all), tissue_idx(b, keep_all)
    k1 = Xr[:, ia].sum(axis=1); m1 = Xr[:, ib].sum(axis=1)
    p_share = pval_central_masked(k1, k1 + m1, keep, p0=p0_share[lbl])
    k2 = Xr_eq[:, ia].sum(axis=1); m2 = Xr_eq[:, ib].sum(axis=1)
    p_eq = pval_central_masked(k2, k2 + m2, keep, p0=P0)
    l2 = comp_run_primary[lbl]["log2fc"]
    entry = {}
    for nm, pp in (("V1_expected_share_p0", p_share), ("V2_depth_equalised_p0_0.5", p_eq)):
        s = summarise(dict(p=pp, log2fc=l2), keep, nm)
        entry[nm] = s
    entry["p0_expected_share_used"] = round(p0_share[lbl], 5)
    entry["median_library_size_used_for_equalisation"] = med_lib
    report["robustness_variants"][lbl] = entry
    print(lbl, "V1", entry["V1_expected_share_p0"]["n_significant"],
          entry["V1_expected_share_p0"]["frac_significant"], "| V2",
          entry["V2_depth_equalised_p0_0.5"]["n_significant"],
          entry["V2_depth_equalised_p0_0.5"]["frac_significant"])

v1 = {l: report["robustness_variants"][l]["V1_expected_share_p0"] for l, _, _ in COMPS}
order_v1 = sorted(v1, key=lambda l: v1[l]["frac_significant"])
