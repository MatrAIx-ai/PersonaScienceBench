def pval_central(k, N):
    """scipy.stats.binomtest two-sided ('Central' region), per gene.
    Genes with N == 0 (zero counts in BOTH groups) have an undefined test and are
    assigned p = 1 (never significant); they are removed anyway by the filter."""
    out = np.ones(len(k))
    for i in range(len(k)):
        Ni = int(N[i])
        if Ni < 1:
            continue
        o = binomtest(int(k[i]), Ni, P0)
        out[i] = o.pvalue() if callable(o.pvalue) else float(o.pvalue)
    return out


def pval_doubled_tail(k, N):
    """Independent implementation of R binom.test's doubled one-tail p-value,
    P(X<=k) = I_{1-p0}(N-k, k+1)   (regularised incomplete beta)."""
    out = np.ones(len(k))
    ok = N >= 1
    lo = betainc((N - k)[ok], (k + 1)[ok], P0)      # P(X <= k)
    hi = betainc(k[ok], (N - k + 1)[ok], P0)        # P(X >= k)
    out[ok] = np.minimum(1.0, 2.0 * np.minimum(lo, hi))
    return out


def bh(p):
    o = np.argsort(p); n = len(p); q = np.empty(n)
    prev = 1.0
    for r in range(n - 1, -1, -1):
        prev = min(prev, p[o[r]] * n / (r + 1)); q[o[r]] = prev
    return q


def run_comparison(A, B, mask_samples):
    ia = tissue_idx(A, mask_samples); ib = tissue_idx(B, mask_samples)
    k = Xr[:, ia].sum(axis=1); m = Xr[:, ib].sum(axis=1)
    N = k + m
    p_c = pval_central(k, N)
    p_r = pval_doubled_tail(k, N)
    mA = X[:, ia].mean(axis=1); mB = X[:, ib].mean(axis=1)
    l2 = np.log2((mA + 0.5) / (mB + 0.5))
    return dict(idx_a=ia, idx_b=ib, k=k, m=m, N=N, p=p_c, p_alt=p_r, log2fc=l2)

# ------------------------------------------------------------ cross-validation
def exact_central_p_small(k, N, p0=0.5):
    """Third, fully independent implementation: brute-force summation of all
    point probabilities <= P(X=k) using log-gamma terms (no scipy routines)."""
    k = int(k); N = int(N)
    def lp(i):
        return (math.lgamma(N + 1) - math.lgamma(i + 1) - math.lgamma(N - i + 1)
                - N * math.log(2.0))
    pk = lp(k); tot = 0.0
    for i in range(N + 1):
        v = lp(i)
        if v <= pk + 1e-12:
            tot += math.exp(v)
    return min(1.0, tot)


def exact_doubled_p_small(k, N, p0=0.5):
    k = int(k); N = int(N)
    def lp(i):
        return (math.lgamma(N + 1) - math.lgamma(i + 1) - math.lgamma(N - i + 1)
                - N * math.log(2.0))
    lo = sum(math.exp(lp(i)) for i in range(0, k + 1))
    hi = sum(math.exp(lp(i)) for i in range(k, N + 1))
    return min(1.0, 2.0 * min(lo, hi))


cv_rows = []
# (a) small-count genes -> exact enumeration vs both vectorised implementations
