cv = pd_rows = cv_rows
a = np.array([r["p_central_scipy"] for r in cv_rows])
b = np.array([r["p_doubled_betainc"] for r in cv_rows])
sub = np.array([r["scope"] == "lowcount_60_bruteforce" for r in cv_rows])
bf = np.array([r.get("p_exact_bruteforce") if r.get("p_exact_bruteforce") is not None else np.nan
               for r in cv_rows], dtype=float)
with np.errstate(divide="ignore", invalid="ignore"):
    def agree(x, y):
        d = np.abs(x - y)
        return dict(n=int(len(x)), max_abs_diff=float(np.nanmax(d)),
                    mean_abs_diff=float(np.nanmean(d)),
