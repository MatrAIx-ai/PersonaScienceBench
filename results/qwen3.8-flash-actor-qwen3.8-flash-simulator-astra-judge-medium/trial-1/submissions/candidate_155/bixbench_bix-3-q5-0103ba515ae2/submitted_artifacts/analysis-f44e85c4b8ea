# ----------------------------------------------------------------- summaries
def summarise(res, mask_genes, label):
    p = res["p"][mask_genes]; l2 = res["log2fc"][mask_genes]
    q = bh(p)
    sig = p < ALPHA
    n = int(mask_genes.sum()); nsig = int(sig.sum())
    up = int(np.sum(sig & (l2 > 0))); dn = int(np.sum(sig & (l2 < 0)))
    zero_dir = int(np.sum(sig & (l2 == 0)))
    fl2 = np.abs(l2)
    return dict(scope=label, n_genes_tested=n, n_significant=nsig,
                frac_significant=round(nsig / max(n, 1), 4),
                expected_at_5pct=round(ALPHA * n, 1),
                obs_over_exp=round(nsig / max(ALPHA * n, 1e-9), 3),
                n_up=up, n_down=dn, n_up_share=round(up / max(nsig, 1), 4),
                n_down_share=round(dn / max(nsig, 1), 4),
                median_log2FC=round(float(np.median(l2)), 4),
                median_abs_log2FC=round(float(np.median(fl2)), 4),
                p95_abs_log2FC=round(float(np.percentile(fl2, 95)), 4),
                p05_abs_log2FC=round(float(np.percentile(fl2, 5)), 4),
                q25_abs_log2FC=round(float(np.percentile(fl2, 25)), 4),
                q75_abs_log2FC=round(float(np.percentile(fl2, 75)), 4),
                max_abs_log2FC=round(float(fl2.max()), 4),
                median_abs_log2FC_sig=round(float(np.median(fl2[sig])), 4) if nsig else None,
                n_fdr_sig=int((q < ALPHA).sum()),
                frac_fdr_sig=round(float((q < ALPHA).mean()), 4),
                median_p=round(float(np.median(p)), 6),
                n_p_lt_1e_minus10=int((p < 1e-10).sum()))

comp_run_noout = {lbl: run_comparison(a, b, keep_no_out) for lbl, a, b in COMPS}

