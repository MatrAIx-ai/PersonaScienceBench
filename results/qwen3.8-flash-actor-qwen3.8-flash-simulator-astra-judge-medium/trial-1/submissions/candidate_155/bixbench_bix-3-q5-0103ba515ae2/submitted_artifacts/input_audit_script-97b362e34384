#!/usr/bin/env python3
"""input_inspection.py -- Structural audit (NO differential expression) of
data/Data_deposition_RNAseq_Paroxetine_2017.xlsx.
Writes analysis/input_inspection_report.md and .json.
"""
import json, math
from collections import Counter, defaultdict
from itertools import islice
import openpyxl

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
OUT_MD = "analysis/input_inspection_report.md"
OUT_JSON = "analysis/input_inspection_report.json"
report = {}
wb = openpyxl.load_workbook(XLSX, read_only=True, data_only=True)
report["sheet_names"] = wb.sheetnames
report["sheet_dimensions"] = {}

# ---------------- 1. Mapping_statistics ----------------
ws = wb["Mapping_statistics"]
rows = list(ws.iter_rows(values_only=True))
hdr = list(rows[0])
meta = [r for r in rows[1:] if r and r[1]]
report["sheet_dimensions"]["Mapping_statistics"] = {
    "n_header_rows": 1, "n_data_rows": len(meta), "n_columns": len(hdr)}
report["mapping_header_row"] = [str(h) for h in hdr]
col_nonnull = {}
for j in range(len(hdr)):
    key = f"{openpyxl.utils.get_column_letter(j+1)}:{hdr[j]}"
    col_nonnull[key] = sum(1 for r in meta if j < len(r) and r[j] not in (None, ""))
report["mapping_column_nonnull_counts"] = col_nonnull
report["mapping_artifact_columns"] = {
    "L": 'literal double-quote char only - CSV import artifact',
    "M": 'literal quote+comma only - CSV import artifact',
    "N": 'quoted Code strings (duplicate of column I)',
    "O": 'quoted Response strings (duplicate of column G)',
    "P": 'quoted Tissue strings (duplicate of column H)',
    "Q-V": "header names present but zero non-empty cells ('NH:i:1','HI:I:0',"
           "'mapping rate','Over represented sequences (fastqc)','Sample ID','mapping rate')",
}
report["mapping_tissue_counts"] = dict(Counter(r[7] for r in meta))
report["mapping_response_counts"] = dict(Counter(r[6] for r in meta))
report["mapping_tissue_x_response"] = {f"{t}/{g}": c for (t, g), c in
                                       sorted(Counter((r[7], r[6]) for r in meta).items())}
report["mapping_duplicate_sample_ids"] = [k for k, v in Counter(r[1] for r in meta).items() if v > 1]
report["mapping_duplicate_codes"] = [k for k, v in Counter(r[8] for r in meta).items() if v > 1]
report["mapping_missing_key_fields"] = {str(hdr[i]): sum(1 for r in meta if r[i] in (None, ""))
                                        for i in range(0, 11)}
mr, tr = defaultdict(list), defaultdict(list)
for r in meta:
    mr[r[7]].append(float(r[5])); tr[r[7]].append(float(r[2]))
report["mapping_rate_summary_per_tissue"] = {
    t: {"n": len(v), "min": round(min(v), 2), "median": round(sorted(v)[len(v) // 2], 2),
        "max": round(max(v), 2), "n_below_75pct": sum(1 for x in v if x < 75)}
    for t, v in mr.items()}
report["total_reads_summary_per_tissue"] = {
    t: {"min": int(min(v)), "median": int(sorted(v)[len(v) // 2]), "max": int(max(v))}
    for t, v in tr.items()}
pat_map = defaultdict(dict); suffix_by_tissue = Counter(); anomalies = []
for r in meta:
    toks = r[1].split("_"); patient, suffix = toks[5], toks[-1]
    suffix_by_tissue[(r[7], suffix)] += 1
    pat_map[patient][r[7]] = r[8]
    if r[7] == "dentate_gyrus" and suffix == "bl":
        anomalies.append({"sample_id": r[1], "tissue_label": r[7],
                          "note": "Sample ID suffix '_bl' but Tissue column = dentate_gyrus"})
report["sample_id_suffix_by_tissue"] = {f"{t}|{s}": c for (t, s), c in sorted(suffix_by_tissue.items())}
report["n_patients"] = len(pat_map)
report["patients_with_all_three_tissues"] = sum(1 for d in pat_map.values() if len(d) == 3)
report["metadata_anomalies"] = anomalies

# ---------------- 2. NormCount ----------------
ws2 = wb["NormCount"]
it = ws2.iter_rows(values_only=True)
hdrs = [list(x) for x in islice(it, 0, 4)]
data_rows = list(it)
names = hdrs[3]
report["sheet_dimensions"]["NormCount"] = {
    "n_total_rows": 4 + len(data_rows), "n_header_rows": 4,
    "n_data_rows": len(data_rows), "n_columns": len(names)}
report["normcount_header_layout"] = {
    "row1": "merged-style group titles placed in single cells: C='baseline blood', "
            "AG='dentate gyrus', BK='final blood'; CO='Max',CR='Median'; "
            "CU/DD/DM/DV/EE/EN/EW/FF/FO='DESeq, Comparison k, exclude outliers'; "
            "FX..GF='Comparison1'..'Comparison9'; A,B empty",
    "row2": "completely empty (all 188 cells)",
    "row3": "only 'Max'/'Median' sub-labels above the summary + DEG columns",
    "row4": "true field names: Index, GeneID, 90 sample codes (C..CN), tissue summaries "
            "(CO..CT), 9 DESeq blocks of 9 cols (baseMean, baseMeanA, baseMeanB, foldChange, "
            "log2FoldChange, pval, padj, DEG, DEG), 9 final DEG flag cols (FX..GF)",
    "physically_merged_cells": "none (openpyxl reports no merged ranges; group titles are "
                               "single-cell labels, so pandas would read them as unnamed columns)",
}
sample_idx = list(range(2, 92))
sample_names = [names[j] for j in sample_idx]
report["normcount_sample_columns"] = {
    "count": len(sample_names), "unique": len(set(sample_names)),
    "excel_range": "C..CN (cols 3-92)",
    "order_identical_to_metadata_Code_column": sample_names == [r[8] for r in meta],
    "first": sample_names[0], "last": sample_names[-1]}
report["normcount_non_sample_columns"] = {
    "A": "Index", "B": "GeneID", "CO:CT": "Max/Median per tissue (author-derived)",
    "CU:FW": "9 author DESeq result blocks x 9 columns; labelled only 'Comparison 1..9' - "
            "the contrast definition of each block is NOT stated anywhere in the file",
    "FX:GF": "9 author DEG flag columns (values '-', 'U', 'D')"}
deg_tail = {}
for j in range(179, 188):
    c = Counter((r[j] if j < len(r) else None) for r in data_rows)
    deg_tail[f"{str(hdrs[0][j])}|col{openpyxl.utils.get_column_letter(j+1)}"] = {str(k): v for k, v in c.items()}
report["author_DEG_flag_counts_tail_columns"] = deg_tail

nrows = 0; id_counter = Counter()
none_cells = 0; nonnum = Counter(); neg = 0; int_cells = 0; num_cells = 0
colsum = [0.0] * 90; colmin = [math.inf] * 90
allzero_genes = mean_lt1 = mean_lt5 = zeros_ge_half = 0
zero_cells_per_tissue = Counter(); two_decimals_only = True
tissue_of = ["baseline_blood"] * 30 + ["dentate_gyrus"] * 30 + ["final_blood"] * 30
for r in data_rows:
    nrows += 1
    id_counter[r[1]] += 1
    vals = [r[j] for j in sample_idx]
    s = 0.0
    for k, v in enumerate(vals):
        if v is None:
            none_cells += 1; continue
        if not isinstance(v, (int, float)):
            nonnum[str(v)] += 1; two_decimals_only = False; continue
        num_cells += 1; s += v; colsum[k] += v; colmin[k] = min(colmin[k], v)
        if v < 0: neg += 1
        if float(v) == int(v): int_cells += 1
        fr = str(v).split(".")[1] if "." in str(v) else ""
        if len(fr) > 2: two_decimals_only = False
        if v == 0: zero_cells_per_tissue[tissue_of[k]] += 1
    if s == 0: allzero_genes += 1
    if s / 90 < 1: mean_lt1 += 1
    if s / 90 < 5: mean_lt5 += 1
    if sum(1 for v in vals if v == 0) >= 45: zeros_ge_half += 1
report["normcount_matrix"] = {
    "genes": nrows, "unique_gene_ids": len(id_counter),
    "duplicate_gene_ids": [k for k, v in id_counter.most_common(5) if v > 1],
    "cells": nrows * 90, "missing_cells": none_cells,
    "non_numeric_cells": sum(nonnum.values()), "negative_cells": neg,
    "integer_valued_cells": int_cells,
    "pct_integer_valued_cells": round(100 * int_cells / max(num_cells, 1), 2),
    "at_most_two_decimals_everywhere": two_decimals_only,
    "min_cell_value": min(colmin),
    "library_size_min": round(min(colsum)), "library_size_median": round(sorted(colsum)[45]),
    "library_size_max": round(max(colsum)),
    "all_zero_genes": allzero_genes, "genes_mean_lt_1": mean_lt1, "genes_mean_lt_5": mean_lt5,
    "genes_zero_in_at_least_half_of_samples": zeros_ge_half,
    "zero_cells_per_tissue": dict(zero_cells_per_tissue)}
report["library_sizes_per_sample"] = {n: round(c, 1) for n, c in zip(sample_names, colsum)}
report["top_library_size_outliers"] = sorted([(n, round(c)) for n, c in zip(sample_names, colsum)],
                                             key=lambda x: -x[1])[:3]

# ---------------- 3. comparison groups ----------------
comparisons = [("Final_blood_vs_Baseline_blood", "final_blood", "baseline_blood"),
               ("Dentate_gyrus_vs_Baseline_blood", "dentate_gyrus", "baseline_blood"),
               ("Dentate_gyrus_vs_Final_blood", "dentate_gyrus", "final_blood")]
comp_table = {}
for label, a, b in comparisons:
    ca = [r[8] for r in meta if r[7] == a]; cb = [r[8] for r in meta if r[7] == b]
    pa = {r[1].split("_")[5] for r in meta if r[7] == a}
    pb = {r[1].split("_")[5] for r in meta if r[7] == b}
    comp_table[label] = {
        "group_A_tissue": a, "group_B_tissue": b, "n_A": len(ca), "n_B": len(cb),
        "A_columns_C_to_CN": ca, "B_columns_C_to_CN": cb,
        "A_per_response": dict(Counter(r[6] for r in meta if r[7] == a)),
        "B_per_response": dict(Counter(r[6] for r in meta if r[7] == b)),
        "patients_shared_between_A_and_B": len(pa & pb)}
report["comparison_groups"] = comp_table

report["planned_analysis_not_executed"] = {
    "test": "per-gene exact binomial test (scipy.stats.binomtest / R binom.test), "
            "p0 = 0.5, two-sided",
    "successes": "sum of group-A (rounded) normalized counts of the gene over its 30 samples",
    "trials": "successes + sum of group-B (rounded) normalized counts",
    "count_input": "NormCount is non-integer (31.25% integer-valued, <=2 decimals) -> round to "
                   "nearest integer; do NOT rescale x100 (would inflate n and make almost every "
                   "gene significant)",
    "filter": "drop genes with all-zero counts across all 90 samples (2210) and genes with mean "
              "normalized count < 1 (6247 total) -> union filter applied before testing",
    "significance": "raw p < 0.05 as required; BH-FDR also reported as a control, not used for "
                    "the headline call",
    "negligible_criteria": [
        "significant fraction close to the 5% false-positive expectation "
        "(observed/expected ratio within 0.6-1.5; absolute band 3-7%)",
        "up/down split balanced, both directions between 40% and 60% of significant genes",
        "|median log2 fold-change| < 0.5 and 95th percentile |log2FC| < 2",
        "significant count is the smallest of the three comparisons"],
}

with open(OUT_JSON, "w") as fh:
    json.dump(report, fh, indent=1, default=str)
L = ["# Input structural audit - Data_deposition_RNAseq_Paroxetine_2017.xlsx", "",
     "_Structure / sample-mapping only. No differential expression was executed._", "",
     "## Sheets and dimensions", "```", json.dumps(report["sheet_dimensions"], indent=1), "```",
     "## Mapping_statistics", "```",
     json.dumps({k: report[k] for k in [
         "mapping_header_row", "mapping_column_nonnull_counts", "mapping_artifact_columns",
         "mapping_tissue_counts", "mapping_response_counts", "mapping_tissue_x_response",
         "mapping_duplicate_sample_ids", "mapping_duplicate_codes", "mapping_missing_key_fields",
         "mapping_rate_summary_per_tissue", "total_reads_summary_per_tissue",
         "sample_id_suffix_by_tissue", "n_patients", "patients_with_all_three_tissues",
         "metadata_anomalies"]}, indent=1), "```",
     "## NormCount", "```",
     json.dumps({k: report[k] for k in [
         "normcount_header_layout", "normcount_sample_columns", "normcount_non_sample_columns",
         "normcount_matrix", "top_library_size_outliers",
         "author_DEG_flag_counts_tail_columns"]}, indent=1), "```",
     "## Comparison groups (from Tissue column)", "```", json.dumps(comp_table, indent=1), "```",
     "## Planned analysis (declared, NOT executed here)", "```",
     json.dumps(report["planned_analysis_not_executed"], indent=1), "```", ""]
with open(OUT_MD, "w") as fh:
    fh.write("\n".join(L))
print("wrote", OUT_MD, "and", OUT_JSON)
for k in ["sheet_dimensions", "mapping_tissue_x_response", "metadata_anomalies",
          "normcount_sample_columns", "normcount_matrix", "top_library_size_outliers"]:
    print("\n==", k, "==\n", json.dumps(report[k], indent=1, default=str))
for k, v in comp_table.items():
    print(k, "nA=", v["n_A"], "nB=", v["n_B"], "shared patients=", v["patients_shared_between_A_and_B"],
          "| A_per_response", v["A_per_response"])
