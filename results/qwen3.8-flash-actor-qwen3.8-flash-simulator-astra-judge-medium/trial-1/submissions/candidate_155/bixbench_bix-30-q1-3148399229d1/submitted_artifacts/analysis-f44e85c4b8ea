"""Differential expression of 175 serum miRNAs (DM1 patients P_1..P_10 vs
controls C_11..C_20) from data/pone.0150501.s002.xls (BIFF8, parsed with the
bundled pure-stdlib reader xls_reader.py).

Main analysis (single answer): two-sided Welch t-test per miRNA on raw Ct
values, 'NAN' cells excluded pairwise, uncorrected p<0.05, denominator = 175.
Sensitivity variants reported separately. No randomness anywhere -> no seed.

Outputs:
  results/per_mirna_pvalues.csv   per-miRNA stats (means, diff, p-values)
  stdout tables + final percentages
"""
import os, sys, struct, csv
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import xls_reader
import numpy as np
from scipy import stats

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
IN = os.path.join(ROOT, 'data', 'pone.0150501.s002.xls')
OUTDIR = os.path.join(ROOT, 'results')
os.makedirs(OUTDIR, exist_ok=True)

# ---------- load ----------
sheets = xls_reader.load(IN)
assert len(sheets) == 1 and sheets[0][0] == 'RAW DATA'
_, grid = sheets[0]
nrows = max(k[0] for k in grid) + 1
ncols = max(k[1] for k in grid) + 1
rows = [[grid.get((r, c)) for c in range(ncols)] for r in range(nrows)]
header = rows[1][1:]
samples = [str(h) for h in header]
pat_cols = [i for i, s in enumerate(samples) if s.startswith('P_')]
ctl_cols = [i for i, s in enumerate(samples) if s.startswith('C_')]
assert len(pat_cols) == 10 and len(ctl_cols) == 10, samples
mir = [r[0] for r in rows[2:]]
assert len(mir) == 175 and len(set(mir)) == 175

def numeric(v):
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else np.nan

X = np.array([[numeric(v) for v in r[1:]] for r in rows[2:]])  # 175 x 20, nan for 'NAN'/None
n_nan = int(np.isnan(X).sum())
assert n_nan == 22, n_nan

# ---------- per-miRNA tests ----------
recs = []
min_df = np.inf
min_group_n = np.inf
for i, name in enumerate(mir):
    p = X[i, pat_cols]; c = X[i, ctl_cols]
    pn, cn = int(np.isfinite(p).sum()), int(np.isfinite(c).sum())
    min_group_n = min(min_group_n, pn, cn)
    t, pw = stats.ttest_ind(p, c, equal_var=False, nan_policy='omit')
    dfw = stats.ttest_ind(p, c, equal_var=False, nan_policy='omit').df
    min_df = min(min_df, dfw)
    ts, ps = stats.ttest_ind(p, c, equal_var=True, nan_policy='omit')
    try:
        _, pmw = stats.mannwhitneyu(p, c, alternative='two-sided', nan_policy='omit')
    except ValueError:
        pmw = np.nan
    recs.append(dict(mirna=name, n_patient=pn, n_control=cn,
                     mean_patient=np.nanmean(p), mean_control=np.nanmean(c),
                     mean_diff=np.nanmean(p) - np.nanmean(c),
                     welch_p=pw, welch_df=dfw, student_p=ps, mwu_p=pmw))

import pandas as pd
df = pd.DataFrame(recs)
df.to_csv(os.path.join(OUTDIR, 'per_mirna_pvalues.csv'), index=False)

# ---------- main result ----------
sig = df.welch_p < 0.05
n_sig = int(sig.sum())
pct = 100 * n_sig / 175

# ---------- sensitivity variants ----------
n_mw = int((df.mwu_p < 0.05).sum()); pct_mw = 100 * n_mw / 175
row_has_nan = np.isnan(X).any(axis=1)
clean_idx = np.where(~row_has_nan)[0]          # 161 rows with no 'NAN' at all
n_clean_sig = int(sig.iloc[clean_idx].sum())
pct_clean_161 = 100 * n_clean_sig / len(clean_idx)
pct_clean_175 = 100 * n_clean_sig / 175
n_st = int((df.student_p < 0.05).sum()); pct_st = 100 * n_st / 175

# ---------- boundary / quality checks ----------
band = df[(df.welch_p >= 0.03) & (df.welch_p <= 0.07)]
n_band = len(band)
n_sig_in_band_below_05 = int(((df.welch_p >= 0.03) & (df.welch_p < 0.05)).sum())
pct_if_band_excluded = 100 * (n_sig - n_sig_in_band_below_05) / 175
pct_upper_band = 100 * int((df.welch_p <= 0.07).sum()) / 175
pct_strict_003 = 100 * int((df.welch_p < 0.03).sum()) / 175

# ---------- parser spot-check (independent raw-record scan) ----------
with open(IN, 'rb') as f:
    raw = f.read()
streams = xls_reader.ole_streams(raw)
wb = streams['Workbook']
# SST for LABELSST resolution (raw-record scan is otherwise independent of table parser)
import struct as _st
_recs=[]; _i=0
while _i+4 <= len(wb):
    _op,_ln=_st.unpack('<HH', wb[_i:_i+4]); _recs.append((_op, wb[_i+4:_i+4+_ln])); _i+=4+_ln
_ch=[]
for _k,(_op,_d) in enumerate(_recs):
    if _op==0x00FC:
        _j=_k+1; _ch=[_d]
        while _j<len(_recs) and _recs[_j][0]==0x003C: _ch.append(_recs[_j][1]); _j+=1
        break
spot_sst = xls_reader.parse_sst(_ch)
# independent linear scan of BIFF records; hand-decode the 5 chosen cells
targets = {'hsa-let-7a': ('P_1', 10), 'hsa-miR-95': ('P_5', None), 'hsa-miR-99b': ('C_20', None),
           'hsa-miR-20a*': ('C_11', None), 'hsa-miR-127-3p': ('C_16', None)}
row_of = {m: i for i, m in enumerate(mir)}
want = {}
for m, (s, _) in targets.items():
    col = samples.index(s)
    want[(row_of[m] + 2, col)] = (m, s)
checks = []
i = 0
while i + 4 <= len(wb):
    op, ln = struct.unpack('<HH', wb[i:i+4]); body = wb[i+4:i+4+ln]; i += 4 + ln
    if op in (0x0203, 0x027E, 0x00FD):
        r, c = struct.unpack('<HH', body[:4])
        if (r, c) in want:
            m, s = want[(r, c)]
            if op == 0x0203:
                val = struct.unpack('<d', body[6:14])[0]; kind = 'NUMBER'
            elif op == 0x027E:
                val = xls_reader._rk(struct.unpack('<I', body[6:10])[0]); kind = 'RK'
            else:
                isst = struct.unpack('<I', body[6:10])[0]
                val = spot_sst[isst]; kind = 'LABELSST'
            checks.append((m, s, kind, val))
spot = []
for m, s, kind, val in checks:
    r, c = row_of[m] + 2, samples.index(s)
    tab = rows[r][c]
    ok = (abs(val - tab) < 1e-9) if isinstance(val, float) else (str(val) == str(tab))
    spot.append((m, s, kind, val, tab, ok))

# ---------- report ----------
pd.set_option('display.width', 200)
print('== SPOT CHECKS (raw BIFF record vs parsed table) ==')
for row_ in spot:
    print(row_)
print('\nMain Welch-significant list (p<0.05):')
print(df.loc[sig, ['mirna', 'mean_diff', 'welch_p']].sort_values('welch_p').to_string(index=False))
print('\n== HEADLINE ==')
print(f'groups: patient n=10 ({", ".join(samples[i] for i in pat_cols)}); '
      f'control n=10 ({", ".join(samples[i] for i in ctl_cols)})')
print(f'miRNAs tested: 175; NaN cells excluded pairwise: {n_nan}')
print(f'MAIN (Welch, two-sided, uncorrected p<0.05, denom 175): {n_sig}/175 = {pct:.1f}%')
print('\n== SENSITIVITY ==')
print(f'1) Mann-Whitney U:            {n_mw}/175 = {pct_mw:.1f}%')
print(f'2) drop 14 rows with NAN:     sig in 161 clean rows = {n_clean_sig}; '
      f'{pct_clean_161:.1f}% of 161; {pct_clean_175:.1f}% of 175')
print(f'3) Student equal-var t:       {n_st}/175 = {pct_st:.1f}%')
print('\n== BOUNDARY / QUALITY ==')
print(f'p in [0.03,0.07]: {n_band} miRNAs; of those, significant (p<0.05): '
      f'{n_sig_in_band_below_05} -> removing them moves main pct from {pct:.1f}% to {pct_if_band_excluded:.1f}% '
      f'(shift {pct-pct_if_band_excluded:.1f} pp)')
print(f'pct if threshold p<0.03: {pct_strict_003:.1f}%; if p<=0.07: {pct_upper_band:.1f}%')
print(f'min within-group n in any test: {int(min_group_n)}; min Welch df: {min_df:.1f}')
print(f'CSV written: {os.path.join(OUTDIR, "per_mirna_pvalues.csv")} ({len(df)} rows)')
