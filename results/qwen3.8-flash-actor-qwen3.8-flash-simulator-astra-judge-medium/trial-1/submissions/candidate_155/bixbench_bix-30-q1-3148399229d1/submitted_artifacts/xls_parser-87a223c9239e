"""Minimal OLE2 + BIFF8 (.xls) reader: extracts cell grids per sheet.
Handles SST/CONTINUE, NUMBER, RK, MULRK, LABELSST, FORMULA(+STRING), BLANK,
MULBLANK, BOOLERR. Pure stdlib."""
import struct

def ole_streams(data):
    assert data[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1', "not an OLE2 file"
    v_major = struct.unpack('<H', data[0x1a:0x1c])[0]
    ssz = 1 << struct.unpack('<H', data[0x1e:0x20])[0]
    mssz = 1 << struct.unpack('<H', data[0x20:0x22])[0]
    nfat = struct.unpack('<I', data[0x2c:0x30])[0]
    dir_start = struct.unpack('<I', data[0x30:0x34])[0]
    mini_cut = struct.unpack('<I', data[0x38:0x3c])[0]
    minifat_start = struct.unpack('<I', data[0x3c:0x40])[0]
    difat_start = struct.unpack('<I', data[0x44:0x48])[0]
    ndifat = struct.unpack('<I', data[0x48:0x4c])[0]

    def sect_off(s): return (s + 1) * ssz
    def read_sect(s): return data[sect_off(s):sect_off(s) + ssz]

    difat = list(struct.unpack('<109I', data[0x4c:0x4c + 436]))
    s = difat_start
    for _ in range(ndifat):
        blk = read_sect(s)
        ents = struct.unpack('<%dI' % (ssz // 4), blk)
        difat.extend(ents[:-1]); s = ents[-1]
    fat = []
    for fs in difat[:nfat]:
        if fs >= 0xfffffffe: continue
        fat.extend(struct.unpack('<%dI' % (ssz // 4), read_sect(fs)))

    def chain(start, table):
        out, s, seen = [], start, set()
        while s < 0xfffffffe and s not in seen:
            seen.add(s); out.append(s); s = table[s]
        return out

    dsect = chain(dir_start, fat)
    dirdata = b''.join(read_sect(s) for s in dsect)
    entries = []
    for i in range(len(dirdata) // 128):
        e = dirdata[i*128:(i+1)*128]
        nlen = struct.unpack('<H', e[64:66])[0]
        name = e[:max(0, nlen-2)].decode('utf-16-le', 'replace') if nlen else ''
        etype = e[66]
        start = struct.unpack('<I', e[116:120])[0]
        size = struct.unpack('<Q' if v_major == 4 else '<I', e[120:128 if v_major == 4 else 124])[0]
        entries.append((name, etype, start, size))
    root = next(e for e in entries if e[1] == 5)
    ministream = b''.join(read_sect(s) for s in chain(root[2], fat))
    fat_sectdata = b''.join(read_sect(s) for s in chain(minifat_start, fat)) if minifat_start < 0xfffffffe else b''
    minifat = list(struct.unpack('<%dI' % len(fat_sectdata.split and b''.join(read_sect(s) for s in chain(minifat_start, fat)) // 4 if minifat_start < 0xfffffffe else 0, b'')) ) if False else None
    if minifat_start < 0xfffffffe:
        md = b''.join(read_sect(s) for s in chain(minifat_start, fat))
        minifat = list(struct.unpack('<%dI' % (len(md)//4), md))
    else:
        minifat = []

    def read_chain(start, size, mini):
        if mini:
            out, s, seen = [], start, set()
            while s < 0xfffffffe and s not in seen:
                seen.add(s); out.append(ministream[s*mssz:(s+1)*mssz]); s = minifat[s]
            return b''.join(out)[:size]
        return b''.join(read_sect(s) for s in chain(start, fat))[:size]

    streams = {}
    for name, etype, start, size in entries:
        if etype == 2:
            streams[name] = read_chain(start, size, size < mini_cut)
    return streams


def parse_sst(records):
    """records: list of payloads (first SST, then CONTINUEs). Returns strings."""
    strings = []
    buf = bytearray()
    pos = 0
    # concatenate with markers is wrong; parse with continuation-aware scanner
    chunks = records
    ci = 0
    p = 0
    cch_total, cuniq = struct.unpack('<II', chunks[0][:8])
    p = 8
    def need(n):
        nonlocal ci, p
        while p >= len(chunks[ci]):
            if ci + 1 >= len(chunks): return False
            ci += 1; p = 0
            return True
        return True
    for _ in range(cuniq):
        # read header cch, grbit
        while p >= len(chunks[ci]):
            ci += 1; p = 0
        if p + 3 > len(chunks[ci]):
            # header split across boundary (rare): gather
            hdr = bytearray()
            while len(hdr) < 3:
                hdr += chunks[ci][p:p+min(3-len(hdr), len(chunks[ci])-p)]
                p += len(hdr[-0:]) # recompute below
                p = p if False else p
                # simpler: move
                if len(hdr) < 3:
                    ci += 1; p = 0
            hdr = bytes(hdr[:3])
            cch = struct.unpack('<H', hdr[:2])[0]
            grbit = hdr[2]
        else:
            cch = struct.unpack('<H', chunks[ci][p:p+2])[0]
            grbit = chunks[ci][p+2]
            p += 3
        rich = bool(grbit & 0x04)
        fareast = bool(grbit & 0x08)
        cruns = 0; cbrt = 0
        if rich or fareast:
            while p + 2 > len(chunks[ci]):
                ci += 1; p = 0
            if rich:
                cruns = struct.unpack('<H', chunks[ci][p:p+2])[0]; p += 2
            if fareast:
                while p + 4 > len(chunks[ci]):
                    ci += 1; p = 0
                cbrt = struct.unpack('<I', chunks[ci][p:p+4])[0]; p += 4
        # skip rich text runs and far-east bytes (may cross chunks)
        skip = cruns * 4 + cbrt
        while skip > 0:
            avail = len(chunks[ci]) - p
            take = min(skip, avail)
            p += take; skip -= take
            if skip > 0:
                ci += 1; p = 0
        # read cch chars; high-byte flag per chunk
        hb = bool(grbit & 0x01)
        out = []
        remaining = cch
        while remaining > 0:
            if p >= len(chunks[ci]):
                ci += 1; p = 0
                hb = bool(chunks[ci][p] & 0x01); p += 1
            avail_bytes = len(chunks[ci]) - p
            if hb:
                nchars = min(remaining, avail_bytes // 2)
                seg = chunks[ci][p:p+nchars*2]; p += nchars*2
                out.append(seg.decode('utf-16-le', 'replace'))
            else:
                nchars = min(remaining, avail_bytes)
                seg = chunks[ci][p:p+nchars]; p += nchars
                out.append(seg.decode('latin-1'))
            remaining -= nchars
        strings.append(''.join(out))
    return strings


def _rk(v):
    rk = struct.unpack('<i', struct.pack('<I', v))[0]
    if rk & 0x02:
        val = rk >> 2
    else:
        val = struct.unpack('<d', b'\x00\x00\x00\x00' + struct.pack('<I', v & 0xfffffffc))[0]
    if rk & 0x01:
        val = val / 100.0
    return val


def parse_biff(stream):
    recs = []
    i = 0
    n = len(stream)
    while i + 4 <= n:
        op, ln = struct.unpack('<HH', stream[i:i+4])
        recs.append((op, stream[i+4:i+4+ln]))
        i += 4 + ln
    # sheets via BOUNDSHEET
    bounds = []
    for op, d in recs:
        if op == 0x0085:
            off = struct.unpack('<I', d[:4])[0]
            vis = d[4]
            cch = d[6]
            grbit = d[7]
            if grbit & 1:
                name = d[8:8+cch*2].decode('utf-16-le', 'replace')
            else:
                name = d[8:8+cch].decode('latin-1')
            bounds.append((off, name))
    # sst
    sst = []
    j = 0
    while j < len(recs):
        op, d = recs[j]
        if op == 0x00FC:
            cont = []
            k = j + 1
            while k < len(recs) and recs[k][0] == 0x003C:
                cont.append(recs[k][1]); k += 1
            sst = parse_sst([d] + cont)
            j = k; continue
        j += 1
    # split substreams by BOF positions in file order
    sheets = []
    idx = 0
    for off, name in bounds:
        # find record whose start == off: recompute offsets
        pass
    # recompute offsets
    recs2 = []
    i = 0
    while i + 4 <= n:
        op, ln = struct.unpack('<HH', stream[i:i+4])
        recs2.append((i, op, stream[i+4:i+4+ln]))
        i += 4 + ln
    off2idx = {r[0]: k for k, r in enumerate(recs2)}
    starts = sorted({off2idx[o] for o, _ in bounds} | {0})
    ends = starts[1:] + [len(recs2)]
    # map bound->substream
    bound_starts = sorted(off2idx[o] for o, _ in bounds)
    for k, (o, name) in enumerate(bounds):
        s = off2idx[o]
        e = bound_starts[k+1] if k + 1 < len(bound_starts) else len(recs2)
        grid = {}
        cells_recs = recs2[s:e]
        pend_formula = None
        for _, op, d in cells_recs:
            if op == 0x00FD:  # LABELSST
                r, c, xf, isst = struct.unpack('<HHHI', d[:10])
                grid[(r, c)] = sst[isst] if isst < len(sst) else None
            elif op == 0x0203:  # NUMBER
                r, c, xf = struct.unpack('<HHH', d[:6])
                grid[(r, c)] = struct.unpack('<d', d[6:14])[0]
            elif op == 0x027E:  # RK
                r, c, xf, rk = struct.unpack('<HHHI', d[:10])
                grid[(r, c)] = _rk(rk)
            elif op == 0x00BD:  # MULRK
                r = struct.unpack('<H', d[:2])[0]
                cf = struct.unpack('<H', d[2:4])[0]
                cl = struct.unpack('<H', d[-2:])[0]
                q = 4
                for col in range(cf, cl + 1):
                    xf, rk = struct.unpack('<HI', d[q:q+6]); q += 6
                    grid[(r, col)] = _rk(rk)
            elif op == 0x0006:  # FORMULA
                r, c, xf = struct.unpack('<HHH', d[:6])
                res = d[6:14]
                if res[6] == 0xFF:  # non-number
                    pend_formula = (r, c, res[0])
                    if res[0] == 0: grid[(r, c)] = None  # will get STRING
                    elif res[0] == 1: grid[(r, c)] = (res[2] != 0)
                    else: grid[(r, c)] = '#ERR'
                else:
                    grid[(r, c)] = struct.unpack('<d', res)[0]
                    pend_formula = None
            elif op == 0x0207:  # STRING
                if pend_formula:
                    r, c, _ = pend_formula
                    cch = struct.unpack('<H', d[:2])[0]
                    grbit = d[2]
                    if grbit & 1:
                        grid[(r, c)] = d[3:3+cch*2].decode('utf-16-le', 'replace')
                    else:
                        grid[(r, c)] = d[3:3+cch].decode('latin-1')
                    pend_formula = None
        sheets.append((name, grid))
    return sheets


def load(path):
    with open(path, 'rb') as f:
        data = f.read()
    streams = ole_streams(data)
    key = 'Workbook' if 'Workbook' in streams else 'Book'
    return parse_biff(streams[key])
