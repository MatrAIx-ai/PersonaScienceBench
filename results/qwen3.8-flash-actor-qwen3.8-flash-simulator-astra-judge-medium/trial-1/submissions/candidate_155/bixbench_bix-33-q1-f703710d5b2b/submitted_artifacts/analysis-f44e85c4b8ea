"""bix-33-q1: which immune cell type has the highest number of significantly
differentially expressed genes after AAV9 mini-dystrophin treatment (post vs pre)?

Ratifications implemented exactly as signed off:
 (a) criterion = p_val_adj  (b) alpha = 0.05 strict '<'  (c) no extra |lfc| cut
 (d) primary = all 25 populations, immune-22 as robustness  (e) raw count primary
 (f) drop + list the 12 Excel date-mangled labels  (g) strict inequality
 (h) no DE re-run from h5ad; byte-level statements only  (i) answer format
Outputs: scratch/de_count_by_celltype.csv, scratch/sensitivity_grid_full.csv,
         scratch/dropped_rows.csv, scratch/final_report.md
"""
import json, re, zipfile
import xml.etree.ElementTree as ET
import numpy as np
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
ALPHA, EXPECTED = 0.05, ["p_val", "avg_log2FC", "pct.1", "pct.2", "p_val_adj"]
NONIMMUNE = ["Eryth", "Platelet", "HSPC"]
ANSWER_EXPANSION = "CD14+ classical monocytes"
M = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
RID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"

xl = pd.ExcelFile(XLSX)
assert len(xl.sheet_names) == 25, xl.sheet_names
tables, dropped = {}, []
for s in xl.sheet_names:
    d = xl.parse(s)
    assert [str(c) for c in d.columns[1:]] == EXPECTED, (s, list(d.columns))
    d = d.rename(columns={d.columns[0]: "gene"})
    for c in EXPECTED:
        d[c] = pd.to_numeric(d[c], errors="coerce")
    assert d[EXPECTED].notna().all().all(), "non-numeric stat values in " + s
    bad = d["gene"].map(lambda v: not isinstance(v, str))
    for _, r in d[bad].iterrows():
        dropped.append({"sheet": s, "gene_label_as_read": str(r.gene),
                        "python_type": type(r.gene).__name__, "p_val": r.p_val,
                        "avg_log2FC": r.avg_log2FC, "p_val_adj": r.p_val_adj,
                        "passes_rule": bool(r.p_val_adj < ALPHA)})
    tables[s] = d[~bad].reset_index(drop=True)
DROPPED = pd.DataFrame(dropped)
DROPPED.to_csv("scratch/dropped_rows.csv", index=False)
assert len(DROPPED) == 12 and not DROPPED["passes_rule"].any()

rows = []
for s, d in tables.items():
    sig = d.p_val_adj < ALPHA
    rows.append({"cell_type": s, "rows_listed": len(d), "n_sig": int(sig.sum()),
                 "n_up": int((sig & (d.avg_log2FC > 0)).sum()),
                 "n_down": int((sig & (d.avg_log2FC < 0)).sum()),
                 "prop_of_listed": round(float(sig.mean()), 4),
                 "median_abs_lfc_sig": round(float(d.loc[sig, "avg_log2FC"].abs().median()), 4)
                 if sig.any() else np.nan,
                 "immune": s not in NONIMMUNE,
                 "n_padj_near_alpha": int(((d.p_val_adj > 0.045) & (d.p_val_adj < 0.055)).sum())})
T = (pd.DataFrame(rows).sort_values(["n_sig", "cell_type"],
                                    ascending=[False, True]).reset_index(drop=True))
T.insert(0, "rank", range(1, len(T) + 1))
T.to_csv("scratch/de_count_by_celltype.csv", index=False)

top_n = int(T.n_sig.iloc[0])
leaders = T[T.n_sig == top_n].cell_type.tolist()
assert len(leaders) == 1, "TIE at first place: %s" % leaders
WINNER, runner = leaders[0], T.iloc[1]
Ti = T[T.immune].reset_index(drop=True)
win_immune = Ti.iloc[0]

ratios = pd.concat([(d.p_val_adj / d.p_val).where((d.p_val_adj < 1) & (d.p_val > 0))
                    for d in tables.values()]).dropna()
bh_n = float(ratios.median())
max_dev = float(np.max(np.abs(ratios / bh_n - 1)))
assert np.allclose(ratios, bh_n, rtol=1e-9), "adjusted p is not a uniform rescaling"
print("loaded sheets:", len(tables), "| BH n_tests:", bh_n, "| max dev %.1e" % max_dev)
print("primary winner:", WINNER, top_n, "| runner-up:", runner.cell_type, int(runner.n_sig))

# ------------------------------------------------------------- sensitivity grid
ALPHAS = [0.01, 0.05, 0.10]
LFCS = [("none", 0.0), ("0.25(curator)", 0.25), ("0.5", 0.5), ("1.0", 1.0)]
grid = []
for alpha in ALPHAS:
    for ptype in ("p_val_adj", "p_val"):
        for lname, lthr in LFCS:
            cnt = pd.Series({s: int(((d[ptype] < alpha) & (d.avg_log2FC.abs() >= lthr)).sum())
                             for s, d in tables.items()})
            for uni, c in (("all_25", cnt),
                           ("immune_22", cnt[~cnt.index.isin(NONIMMUNE)])):
                o = c.sort_values(ascending=False)
                grid.append({"alpha": alpha, "p_column": ptype, "abs_lfc_min": lname,
                             "universe": uni, "winner": o.index[0], "count": int(o.iloc[0]),
                             "runner_up": o.index[1], "runner_up_count": int(o.iloc[1]),
                             "ties_at_first": int((o == o.iloc[0]).sum()),
                             "winner_is_agreed_primary": o.index[0] == WINNER})
G = pd.DataFrame(grid)
G["primary_rule_flag"] = ((G.alpha == ALPHA) & (G.p_column == "p_val_adj") &
                          (G.abs_lfc_min == "none"))
G.to_csv("scratch/sensitivity_grid_full.csv", index=False)
n_same = int(G.winner_is_agreed_primary.sum())
n_raw_win = int(G.loc[G.p_column == "p_val", "count"].max())

# --------------------------- independent recount from the raw worksheet XML (3)
def xml_recount(sheet_name):
    z = zipfile.ZipFile(XLSX)
    wb = ET.fromstring(z.read("xl/workbook.xml"))
    rels = ET.fromstring(z.read("xl/_rels/workbook.xml.rels"))
    rmap = {e.get("Id"): e.get("Target") for e in rels}
    target = None
    for sh in wb.find(M + "sheets"):
        if sh.get("name") == sheet_name:
            target = rmap[sh.get(RID)]
    path = target if target.startswith("xl/") else "xl/" + target.lstrip("/")
    root = ET.fromstring(z.read(path))
    ss = re.findall(rb"<t[^>]*>(.*?)</t>", z.read("xl/sharedStrings.xml"), flags=re.S)
    n_rows = n_sig = 0
    genes = []
    for row in root.iter(M + "row"):
        if row.get("r") == "1":
            continue
        cells = {c.get("r")[0]: c for c in row}
        if "F" not in cells:
            continue
        n_rows += 1
        if float(cells["F"].findtext(M + "v")) < ALPHA:
            n_sig += 1
            a = cells.get("A")
            if a is not None and a.get("t") == "s":
                genes.append(re.sub(rb"<[^>]+>", b"",
                                    ss[int(a.findtext(M + "v"))]).decode())
    return path, n_rows, n_sig, sorted(genes)

xml_path, xml_rows, xml_sig, xml_genes = xml_recount(WINNER)
pd_sig = int(T.loc[T.cell_type == WINNER, "n_sig"].iloc[0])
pd_rows = int(T.loc[T.cell_type == WINNER, "rows_listed"].iloc[0])
pd_genes = sorted(tables[WINNER].loc[tables[WINNER].p_val_adj < ALPHA, "gene"])
genes_identical = (xml_genes == pd_genes)
match = (xml_sig == pd_sig) and (xml_rows == pd_rows) and genes_identical
print("XML recount:", xml_path, "rows", xml_rows, "sig", xml_sig,
      "| pandas", pd_rows, pd_sig, "| gene sets identical", genes_identical)
assert match

# --------------------------- h5ad: byte-level metadata (ruling h; read-only) --
def h5ad_facts(path):
    data = open(path, "rb").read()
    keys = ["Status", "sample_id", "clusters_gex_for_degs", "clusters_gex", "louvain_gex",
            "donor", "origin", "cell_type", "annotation", "leiden", "Mono", "Naive",
            "Platelet", "Memory", "Dendritic"]
    return {"bytes": len(data),
            "n_cells_unique_barcodes": len(set(re.findall(rb"[ACGT]{16}-\d{1,2}", data))),
            "n_vars_unique_ENSG": len(set(re.findall(rb"ENSG\d{11}", data))),
            "status_levels": sorted({b.decode() for b in re.findall(rb"(?:Pre|Post)-AAV", data)}),
            "sample_id_levels": sorted({b.decode() for b in re.findall(rb"\d-Pre|\d-Post", data)}),
            "donor_batch_levels": sorted({b.decode() for b in
                                          re.findall(rb"D\d_PBMC_t\d", data)}),
            "ascii_key_counts": {k: data.count(k.encode()) for k in keys}}

H5 = h5ad_facts("data/MS_DMD_all_conga_final.h5ad")
print("h5ad byte-level facts:", json.dumps(H5["ascii_key_counts"]))

gap = top_n - int(runner.n_sig)
raw_top = G.loc[(G.p_column == "p_val") & (G.alpha == ALPHA) & (G.abs_lfc_min == "none")]
alt = G[(~G.winner_is_agreed_primary)]
alt_txt = "; ".join("alpha={0}/{1}/|lfc|{2}/{3} -> {4}={5}".format(
    r["alpha"], r["p_column"], r["abs_lfc_min"], r["universe"], r["winner"], r["count"])
    for _, r in alt.iterrows())

rep = []
w = rep.append
w("# bix-33-q1 - final analysis (executed)\n")
w("**ANSWER: `{0}` ({1}) - {2} genes with `p_val_adj < 0.05`** (post- vs pre-AAV9 mini-dystrophin)."
  " Runner-up: `{3}` with {4} significant genes ({5} fewer).\n".format(
      WINNER, ANSWER_EXPANSION, top_n, runner.cell_type, int(runner.n_sig), gap))
w("\n## Primary rule as signed off\n")
w("criterion `p_val_adj`, alpha = 0.05 with strict `<`, **no** additional |avg_log2FC| cut, "
  "metric = raw count, all 25 annotated populations eligible. Cross-sheet comparability verified: "
  "`p_val_adj / p_val` = {0:.0f} for every non-saturated row of every sheet "
  "(max relative deviation {1:.1e}), i.e. one common BH denominator of {0:.0f} tests, "
  "equivalent to a uniform raw-p cut-off of {2:.3e}.\n".format(bh_n, max_dev, ALPHA / bh_n))
w("\n## Ranked table - all 25 populations (primary rule)\n```\n")
w(T.to_string(index=False) + "\n```\n")
w("\nNo tie for first place (the leader is unique; margin over the runner-up = {0} genes; "
  "next gap, {1} -> NK = {2} genes). Immune-only-22 robustness line (drop Eryth/Platelet/"
  "HSPC): `{3}` with {4} genes - unchanged, so the admissibility question does not bite "
  "under the agreed rule. **Caveat on `prop_of_listed`:** the per-sheet row counts are "
  "curator-pre-filtered candidate lists (every listed row has |log2FC| >= 0.25), NOT the "
  "number of genes tested ({5:.0f} in every population), so proportions are not comparable "
  "across populations and are shown only as a caveat.\n"
  .format(gap, runner.cell_type,
          int(runner.n_sig) - int(T.loc[T.cell_type == "NK", "n_sig"].iloc[0]),
          win_immune.cell_type, int(win_immune.n_sig), bh_n))
w("\n## Rows excluded under ruling (f)\n```\n" + DROPPED.to_string(index=False) +
  "\n```\nAll 12 are Excel date-coercions of gene symbols and all carry `p_val_adj = 1.0`, so none "
  "can satisfy `p_val_adj < 0.05`; their removal cannot alter any ranking (recomputed rankings with "
  "them retained are identical).\n")
w("\n## Sensitivity grid (3 alpha x 2 p-columns x 4 |lfc| x 2 universes = 48 cells)\n```\n")
w(G.to_string(index=False) + "\n```\n")
w("\nThe signed-off primary cell (alpha=0.05, `p_val_adj`, |lfc| none) gives `{0}` = {1} in both "
  "universes, and `{0}` is the leader in {2}/{3} cells. Where the leader changes it is always to "
  "`CD16 Mono` or to a non-immune fraction, and only when (i) raw `p_val` replaces `p_val_adj` - "
  "without multiplicity control the count simply tracks how many genes are expressed/tested in a "
  "population (raw-p winner reaches {4} genes) - or (ii) a post-hoc |log2FC| >= 0.5 cut is layered "
  "on top of significance, which is an effect-size rule, not a significance rule, and penalises "
  "CD14 Mono (median |log2FC| of its significant genes = {5}) relative to CD16 Mono ({6}). That "
  "CD14-vs-CD16 monocyte sensitivity is a genuine property of this dataset and is reported rather "
  "than suppressed; under the agreed rule it does not change the answer. Alternative-winner cells: "
  "{7}\n".format(WINNER, top_n, n_same, len(G), n_raw_win,
                 T.loc[T.cell_type == "CD14 Mono", "median_abs_lfc_sig"].iloc[0],
                 T.loc[T.cell_type == "CD16 Mono", "median_abs_lfc_sig"].iloc[0], alt_txt))
w("\n## Independent consistency check (ruling 3: raw worksheet XML, not pandas)\n")
w("Worksheet `{0}` read via `xl/_rels` -> `{1}` directly from sheet XML: data rows = {2}, "
  "rows with p_val_adj < 0.05 = **{3}**. From the pandas frame: rows = {4}, count = **{5}**; "
  "the two significant gene-name sets are identical = {6}. **Both independent counts agree "
  "({3} == {5}) -> PASS.**\n".format(WINNER, xml_path, xml_rows, xml_sig, pd_rows, pd_sig,
                                     genes_identical))
w("\n## h5ad design statement (byte-level inference; ruling h)\n")
w("`data/MS_DMD_all_conga_final.h5ad` could NOT be opened with an AnnData reader (anndata/h5py are "
  "not installed and the runner has no network), so the following are inferences from uncompressed "
  "ASCII inside the HDF5 file, not an AnnData read: {b} bytes; ~{c:,} unique cell barcodes; ~{v:,} "
  "unique ENSG feature ids; `obs` keys recovered include `Status` (levels {st}), `sample_id` "
  "(levels {sa}), `donor`, `origin`, `origin_batch`/`donor_batch`-style keys (levels {db}), and "
  "cluster assignments `clusters_gex_for_degs` / `clusters_gex` / `louvain_gex`; i.e. **{nd} donors, "
  "PBMC, pre- vs post-AAV9 mini-dystrophin**, with populations for DE keyed by cluster id. "
  "**Limitations:** the object contains no cell-type names (ASCII occurrence counts: Mono={m}, "
  "Naive={na}, Platelet={pl}, Memory={me}, Dendritic={de}, cell_type={ct}, annotation={an}, "
  "leiden={le}), so the 25 sheet names cannot be matched to object labels; the inferred feature "
  "count ({v:,}) does not equal the implied number of tests ({bh:.0f}); no DE re-analysis was run and "
  "unlisted genes were not reconstructed (rulings h and j).\n".format(
      b=H5["bytes"], c=H5["n_cells_unique_barcodes"], v=H5["n_vars_unique_ENSG"],
      st=H5["status_levels"], sa=H5["sample_id_levels"], db=H5["donor_batch_levels"],
      nd=len([x for x in H5["donor_batch_levels"] if x.endswith("t0")]),
      m=H5["ascii_key_counts"]["Mono"], na=H5["ascii_key_counts"]["Naive"],
      pl=H5["ascii_key_counts"]["Platelet"], me=H5["ascii_key_counts"]["Memory"],
      de=H5["ascii_key_counts"]["Dendritic"], ct=H5["ascii_key_counts"]["cell_type"],
      an=H5["ascii_key_counts"]["annotation"], le=H5["ascii_key_counts"]["leiden"], bh=bh_n))
report = "".join(rep)
open("scratch/final_report.md", "w").write(report)
print(report)
print(json.dumps({"answer": "{0} ({1})".format(WINNER, ANSWER_EXPANSION), "winner": WINNER,
                  "n_sig": top_n, "runner_up": runner.cell_type,
                  "runner_up_n": int(runner.n_sig), "xml_recount": xml_sig,
                  "pandas_recount": pd_sig, "xml_check_passed": bool(match),
                  "bh_n_tests": bh_n, "sensitivity_cells_same_winner": n_same,
                  "sensitivity_cells": len(G)}, indent=1))

# ------------------------------- verification of claims asserted in the report
# (1) "excluded rows cannot change any ranking": recount keeping them, primary rule
full = {s: xl.parse(s) for s in xl.sheet_names}
keep_cnt = {}
for s, d0 in full.items():
    d0 = d0.rename(columns={d0.columns[0]: "gene"})
    keep_cnt[s] = int((pd.to_numeric(d0.p_val_adj, errors="coerce") < ALPHA).sum())
K = pd.Series(keep_cnt)
K = K.loc[sorted(K.index, key=lambda s: (-int(K[s]), s))]
order_same = list(K.index) == list(T.cell_type)
deltas = {s: (keep_cnt[s] - int(T.loc[T.cell_type == s, "n_sig"].iloc[0])) for s in xl.sheet_names}
deltas_nz = {k: v for k, v in deltas.items() if v}
# raw-p effect of the excluded rows (for transparency only)
raw_keep = {s: int((pd.to_numeric(full[s].p_val, errors="coerce") < ALPHA).sum())
            for s in xl.sheet_names}
raw_drop = {s: int((tables[s].p_val < ALPHA).sum()) for s in xl.sheet_names}
raw_delta = {k: raw_keep[k] - raw_drop[k] for k in xl.sheet_names if raw_keep[k] != raw_drop[k]}
# (2) no ties anywhere in the grid
ties_max = int(G.ties_at_first.max())
lines = ["\n## Verification of the claims asserted above (same script, same data)\n",
         "- Excluded rows cannot affect the primary ranking: recount of all 25 sheets **with** the "
         "12 date-mangled rows retained gives per-sheet counts identical in all 25 sheets "
         f"(sheets whose count changes: {deltas_nz}) and therefore the same ranking "
         f"(`order_identical_under_same_tiebreak = {order_same}`); expected, since "
         "all 12 rows have `p_val_adj = 1.0`.\n",
         "- Those 12 rows do move raw-p counts, which is one further reason raw `p_val` is the wrong "
         f"rule (raw-p count changes from dropping them: {raw_delta}).\n",
         f"- No ties anywhere: maximum number of populations tied at first place across all 48 "
         f"sensitivity cells = {ties_max}.\n",
         "- Leader under the primary rule is unique; margin over runner-up = "
         f"{top_n - int(runner.n_sig)} genes (CD14 Mono {top_n} vs CD16 Mono {int(runner.n_sig)}).\n"]
open("scratch/final_report.md", "a").write("".join(lines))
assert order_same and not deltas_nz and ties_max == 1
print("".join(lines))
print("VERIFICATION PASSED")
