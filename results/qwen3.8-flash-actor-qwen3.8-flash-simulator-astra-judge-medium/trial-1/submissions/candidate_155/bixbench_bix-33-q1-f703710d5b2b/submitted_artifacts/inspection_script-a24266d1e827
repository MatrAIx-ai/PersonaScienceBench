"""Inspection-only script for bix-33-q1 (AAV9 mini-dystrophin Post-vs-Pre DEGs).

Produces:
  scratch/workbook_sheet_summary.csv   per-sheet structural summary
  scratch/workbook_report.json         full per-sheet statistics
  scratch/criteria_sensitivity.csv     counts under candidate significance rules (NOT a choice yet)
  scratch/inspection_report.md         human-readable inspection report

NO DE computation, NO threshold decision, NO answer is produced here.
"""
import json, re
import numpy as np
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
H5AD = "data/MS_DMD_all_conga_final.h5ad"
EXPECTED_HEADER = ["p_val", "avg_log2FC", "pct.1", "pct.2", "p_val_adj"]
NONIMMUNE = {"Eryth", "Platelet", "HSPC"}
QUANTS = [0, 0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 1.0]

xl = pd.ExcelFile(XLSX)
report = {"n_sheets": len(xl.sheet_names), "sheet_names": xl.sheet_names}
per_sheet, summary_rows = {}, []

for s in xl.sheet_names:
    d = xl.parse(s)
    gene = d.columns[0]
    rec = {"sheet": s, "n_rows": len(d), "columns": [str(c) for c in d.columns],
           "header_ok": [str(c) for c in d.columns[1:]] == EXPECTED_HEADER,
           "gene_col_name": str(gene),
           "n_unique_genes": int(d[gene].nunique()),
           "n_duplicate_gene_rows": int(len(d) - d[gene].nunique()),
           "n_blank_gene": int(d[gene].isna().sum()),
           "n_datetime_corrupted_gene": int(sum(isinstance(v, (pd.Timestamp,)) or
                                               "datetime" in type(v).__name__.lower() for v in d[gene]))}
    for col in EXPECTED_HEADER:
        num = pd.to_numeric(d[col], errors="coerce")
        rec[f"{col}.dtype"] = str(d[col].dtype)
        rec[f"{col}.n_nonnumeric"] = int((d[col].notna() & num.isna()).sum())
        rec[f"{col}.n_nan"] = int(num.isna().sum())
        v = num.dropna().to_numpy(float)
        rec[f"{col}.min"], rec[f"{col}.max"] = float(v.min()), float(v.max())
        rec[f"{col}.n_exact_zero"] = int((v == 0).sum())
        rec[f"{col}.n_exact_one"] = int((v == 1).sum())
        rec[f"{col}.q"] = {f"{q:g}": float(np.quantile(v, q)) for q in QUANTS}
    lfc = pd.to_numeric(d["avg_log2FC"], errors="coerce").abs()
    pa = pd.to_numeric(d["p_val_adj"], errors="coerce")
    pv = pd.to_numeric(d["p_val"], errors="coerce")
    rec["min_abs_lfc"] = float(lfc.min())
    rec["pre_filtered_abs_lfc_ge_0.25"] = bool((lfc >= 0.25).all())
    m = (pa < 1) & (pv > 0)
    rec["BH_implied_n_tests_median"] = float((pa[m] / pv[m]).median()) if m.any() else np.nan
    per_sheet[s] = rec
    summary_rows.append({k: rec[k] for k in
                        ["sheet", "n_rows", "header_ok", "n_unique_genes", "n_duplicate_gene_rows",
                         "n_datetime_corrupted_gene", "p_val_adj.n_nan", "p_val_adj.max",
                         "p_val_adj.n_exact_one", "p_val_adj.n_exact_zero", "min_abs_lfc",
                         "pre_filtered_abs_lfc_ge_0.25", "BH_implied_n_tests_median"]})

pd.DataFrame(summary_rows).to_csv("scratch/workbook_sheet_summary.csv", index=False)

# criteria sensitivity grid (report only; decision pending researcher sign-off)
grid = {}
for s in xl.sheet_names:
    d = xl.parse(s)
    pv, pa, l = d["p_val"], d["p_val_adj"], d["avg_log2FC"].abs()
    grid[s] = {"rows_in_sheet": len(d),
               "rawp<0.05": int((pv < 0.05).sum()), "rawp<0.01": int((pv < 0.01).sum()),
               "rawp<0.001": int((pv < 0.001).sum()),
               "rawp<0.05&|lfc|>=0.5": int(((pv < 0.05) & (l >= 0.5)).sum()),
               "padj<0.05": int((pa < 0.05).sum()), "padj<0.01": int((pa < 0.01).sum()),
               "padj<0.10": int((pa < 0.10).sum()),
               "padj<0.05&|lfc|>=0.5": int(((pa < 0.05) & (l >= 0.5)).sum()),
               "padj<0.05&|lfc|>=1.0": int(((pa < 0.05) & (l >= 1.0)).sum())}
G = pd.DataFrame(grid).T
G.to_csv("scratch/criteria_sensitivity.csv")

# ---- h5ad metadata reconnaissance (h5py/anndata unavailable, no network) ----
data = open(H5AD, "rb").read()
h5 = {"bytes": len(data),
      "unique_barcodes_obs_index": len(set(re.findall(rb"[ACGT]{16}-\d{1,2}", data))),
      "unique_ENSG_var_gene_ids": len(set(re.findall(rb"ENSG\d{11}", data))),
      "obs_keys_recovered": ["Status", "n_genes", "percent_mito", "n_counts", "clone_sizes",
                             "gex_variation", "louvain_gex", "clusters_gex", "louvain_tcr",
                             "clusters_tcr", "nndists_gex", "nndists_tcr", "tcr_clumping_pvalues",
                             "is_invariant", "conga_scores", "conga_fdr_values",
                             "clusters_gex_for_degs", "sample_id_batch", "sample_id",
                             "sample_outs_batch", "sample_outs", "donor_batch", "donor",
                             "origin_batch", "origin", "Status_batch"],
      "recovered_categorical_levels": {
          "Status": ["Pre-AAV", "Post-AAV"],
          "sample_id": ["1-Pre", "1-Post", "2-Pre", "2-Post", "3-Pre", "3-Post",
                        "4-Pre", "4-Post", "5-Pre", "5-Post"],
          "donor/origin/timepoint batch key": ["D1_PBMC_t0", "D1_PBMC_t1", "D2_PBMC_t0", "D2_PBMC_t1",
                                               "D3_PBMC_t0", "D3_PBMC_t1", "D4_PBMC_t0", "D4_PBMC_t1",
                                               "D5_PBMC_t0", "D5_PBMC_t1"]},
      "cell_type_name_search": {k: data.count(k.encode()) for k in
                                ["Mono", "Naive", "Platelet", "Memory", "Intermediate",
                                 "Dendritic", "cell_type", "annotation", "leiden", "timepoint",
                                 "treatment"]},
      "uns_rank_groups_params_recovered": ["wilcoxon", "benjamini-hochberg", "rest",
                                           "clusters_gex_for_degs", "seurat"]}
json.dump({"workbook": report, "sheets": per_sheet, "h5ad_reconnaissance": h5},
          open("scratch/workbook_report.json", "w"), indent=1, default=str)

pd.set_option("display.width", 250)
with open("scratch/inspection_report.md", "w") as fh:
    fh.write("# Inspection report (no DE computed)\n\n## Workbook per-sheet summary\n```\n")
    fh.write(pd.DataFrame(summary_rows).to_string(index=False))
    fh.write("\n```\n\n## Candidate-criterion sensitivity (counts, not a decision)\n```\n")
    fh.write(G.to_string())
    fh.write("\n```\n\n## Winner per candidate criterion\n```\n")
    for c in G.columns[1:]:
        o = G[c].astype(int); oi = o.drop(index=[i for i in o.index if i in NONIMMUNE])
        fh.write(f"{c:22s} all-25: {o.idxmax():14s}={o.max():5d}   immune-22: {oi.idxmax():14s}={oi.max():5d}\n")
    fh.write("```\n\n## h5ad reconnaissance\n```\n" + json.dumps(h5, indent=1) + "\n```\n")
print(open("scratch/inspection_report.md").read())
