"""
bix-42-q2 : Skewness of the distribution of RNA expression data (TCGA COAD).

MAIN (pre-declared, primary) analysis: pooled distribution of ALL raw
(un-normalised) expression values in data/COAD__geneExp.xls
(20,502 genes x 328 samples, tab-separated text despite .xls extension).
Everything else (log2(x+1), per-sample, per-gene, subsets, trimmed) is a
SENSITIVITY / DIAGNOSTIC result and never replaces the primary conclusion.

Pre-declared interpretation thresholds on skewness g1:
   |g1| < 0.5  -> approximately symmetric/normal
   0.5-1.0     -> moderately skewed
   |g1| > 1.0  -> highly skewed
Sign: >0 right (positive) skew, <0 left (negative) skew.

Outputs: printed report + analysis/results.txt + 4 SVG figures.
"""
import sys, os
import numpy as np
import pandas as pd
from scipy import stats

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import svgplots as sp

DATA = "data/COAD__geneExp.xls"
FIGDIR = "analysis/figures"
os.makedirs(FIGDIR, exist_ok=True)
QS = [0, 1, 5, 25, 50, 75, 95, 99, 100]
RNG = np.random.default_rng(42)
LOG = []


def say(*a):
    line = " ".join(str(x) for x in a)
    print(line)
    LOG.append(line)


def bowley(q1, q2, q3):
    return (q3 + q1 - 2 * q2) / (q3 - q1) if q3 != q1 else np.nan


def describe(values, name, tag=""):
    v = np.asarray(values, dtype="float64").ravel()
    n = v.size
    mean, sd, med = v.mean(), v.std(ddof=1), np.median(v)
    g1 = stats.skew(v, bias=True)
    G1 = stats.skew(v, bias=False)
    q = np.quantile(v, np.array(QS) / 100.0)
    pearson2 = 3 * (mean - med) / sd
    bow = bowley(q[3], q[4], q[5])
    verdict = ("approximately normal/symmetric" if abs(g1) < 0.5 else
               ("moderately %s skewed" % ("right" if g1 > 0 else "left") if abs(g1) < 1
                else "highly %s skewed" % ("right" if g1 > 0 else "left")))
    say(f"[{tag}] {name}: n={n:,} mean={mean:.6g} sd={sd:.6g} median={med:.6g} "
        f"mean/median={mean/med if med else float('nan'):.4g}")
    say(f"      skew(bias=True)={g1:.4f}  skew(bias=False)={G1:.4f}  "
        f"Pearson2={pearson2:.4f}  Bowley={bow:.4f}")
    say("      quantiles(0/1/5/25/50/75/95/99/100%)=" +
        ", ".join(f"{p}%:{x:.4g}" for p, x in zip(QS, q)))
    say(f"      P99-max span={q[-1]-q[6]:.6g}  (P99={q[6]:.6g}, max={q[-1]:.6g}); verdict -> {verdict}")
    return dict(name=name, n=n, mean=mean, sd=sd, median=med, g1=g1, G1=G1,
                pearson2=pearson2, bowley=bow, q=q, verdict=verdict)


say("=" * 100)
say("LOADING", DATA)
g = pd.read_csv(DATA, sep="\t", index_col=0)
say(f"matrix shape = {g.shape[0]} genes x {g.shape[1]} samples | NaN = {int(g.isna().values.sum())} "
    f"| negatives = {int((g.to_numpy() < 0).sum())}")

# ---------- library-size check (is the lack of depth normalisation a threat?) ----------
colsum = g.sum(axis=0).to_numpy(dtype="float64")
say("\n--- Library-size (column total) check [diagnostic] ---")
say(f"column totals: median={np.median(colsum):,.0f}  Q1={np.quantile(colsum,.25):,.0f} "
    f"Q3={np.quantile(colsum,.75):,.0f}  IQR={np.quantile(colsum,.75)-np.quantile(colsum,.25):,.0f} "
    f"min={colsum.min():,.0f}  max={colsum.max():,.0f}  max/min={colsum.max()/colsum.min():.2f}")

# ---------- MAIN ANALYSIS ----------
say("\n--- MAIN ANALYSIS: pooled RAW (un-normalised) expression values ---")
raw = g.to_numpy(dtype="float64")
main = describe(raw.ravel(), "pooled raw expression (MAIN)", tag="MAIN")
describe(np.log2(raw + 1).ravel(), "pooled log2(x+1) expression", tag="SENS")

# ---------- robustness: no outlier removal in main; report trim > P99.9 ----------
say("\n--- Robustness checks (no removal applied to MAIN) ---")
thr = np.quantile(raw.ravel(), 0.999)
describe(raw[raw <= thr].ravel(), "raw values trimmed at P99.9", tag="SENS")
describe(raw[raw > 0].ravel(), "raw values excluding exact zeros", tag="SENS")

# ---------- required sensitivity slices (one line each) ----------
say("\n--- Sensitivity slices (one summary line each) ---")
sample_type = pd.Series(g.columns, index=g.columns).str.split("-").str[3].str[:2]
slices = {
    "all samples (n=%d)" % g.shape[1]: g,
    "primary tumour only, code 01 (n=%d)" % int((sample_type == "01").sum()): g.loc[:, sample_type == "01"],
    "drop all-zero genes (%d->%d rows)" % (g.shape[0], int((g.sum(axis=1) > 0).sum())): g[g.sum(axis=1) > 0],
    "duplicate GeneSymbols before dedup (%d rows)" % g.shape[0]: g,
    "duplicate GeneSymbols after dedup keep-first (%d rows)" % int((~g.index.duplicated()).sum()): g[~g.index.duplicated()],
}
sens_rows = []
for k, sub in slices.items():
    v = sub.to_numpy(dtype="float64").ravel()
    q = np.quantile(v, [0.25, 0.5, 0.75])
    sens_rows.append((k, v.size, stats.skew(v, bias=True), 3 * (v.mean() - np.median(v)) / v.std(ddof=1),
                      bowley(*q), np.mean(v) / np.median(v)))
    say(f"{k:<62s} n={v.size:>10,}  skew={sens_rows[-1][2]:9.3f}  Pearson2={sens_rows[-1][3]:9.3f}  "
        f"Bowley={sens_rows[-1][4]:6.3f}  mean/median={sens_rows[-1][5]:8.2f}")

# ---------- per-sample and per-gene diagnostics ----------
say("\n--- Per-sample / per-gene diagnostics [diagnostic] ---")
per_samp = pd.Series(stats.skew(raw, axis=0, bias=True), index=g.columns)
per_samp_l = pd.Series(stats.skew(np.log2(raw + 1), axis=0, bias=True), index=g.columns)
per_gene = pd.Series(stats.skew(raw, axis=1, bias=True), index=g.index)
per_gene_l = pd.Series(stats.skew(np.log2(raw + 1), axis=1, bias=True), index=g.index)
for nm, s in (("per-SAMPLE skew, raw", per_samp), ("per-SAMPLE skew, log2", per_samp_l),
              ("per-GENE skew across 328 samples, raw", per_gene),
              ("per-GENE skew across 328 samples, log2", per_gene_l)):
    s = s.replace([np.inf, -np.inf], np.nan).dropna()
    say(f"{nm:<42s} median={s.median():7.3f}  IQR={s.quantile(.25):.3f}..{s.quantile(.75):.3f}  "
        f"range={s.min():.2f}..{s.max():.2f}  frac>1={np.mean(s>1):.3f}  frac<-1={np.mean(s<-1):.3f}")
say("top-5 most right-skewed samples: " + ", ".join(f"{i.split('-')[0]}-{i.split('-')[1]}:{v:.2f}"
    for i, v in per_samp.sort_values(ascending=False).head(5).items()))

# ---------- FIGURES ----------
flat = raw.ravel()
h1 = RNG.choice(flat, size=400_000, replace=False)
cnt, edges = np.histogram(h1, bins=np.histogram_bin_edges(h1, bins=80))
sp.histogram(cnt, edges, "Pooled raw RNA expression (COAD, n=6,724,656 values)",
             "expression value (RSEM-style, linear scale)", "count",
             os.path.join(FIGDIR, "fig1_pooled_raw_hist.svg"))
cnt, edges = np.histogram(np.log2(h1 + 1), bins=80)
sp.histogram(cnt, edges, "Pooled log2(x+1) RNA expression (same values)",
             "log2(expression + 1)", "count", os.path.join(FIGDIR, "fig2_pooled_log2_hist.svg"))

sub = RNG.choice(flat, size=20_000, replace=False)
order = np.argsort(sub)
samp_q = sub[order]
theo = stats.norm.ppf((np.arange(1, sub.size + 1) - 0.5) / sub.size)
sp.scatter(theo, samp_q, "Normal Q-Q plot, pooled RAW expression (20k sample)",
           "theoretical normal quantile", "observed value",
           os.path.join(FIGDIR, "fig3_qq_raw.svg"),
           ref=(theo, np.full_like(theo, np.median(samp_q))))
lsub = np.log2(sub + 1)
lj = np.argsort(lsub)
sp.scatter(theo, lsub[lj], "Normal Q-Q plot, pooled log2(x+1) expression (20k sample)",
           "theoretical normal quantile", "observed log2(x+1)",
           os.path.join(FIGDIR, "fig4_qq_log2.svg"),
           ref=(theo, theo.mean() + theo * theo.std()))


def gp(s):
    s = s.replace([np.inf, -np.inf], np.nan).dropna()
    return (s.quantile(.25), s.median(), s.quantile(.75), s.min(), s.max())


sp.boxplots([("raw\nper-sample", *gp(per_samp)), ("log2\nper-sample", *gp(per_samp_l)),
             ("raw\nper-gene", *gp(per_gene)), ("log2\nper-gene", *gp(per_gene_l))],
            "Skewness across samples and across genes (diagnostic)", "skewness (Fisher-Pearson)",
            os.path.join(FIGDIR, "fig5_skew_boxplots.svg"))

# ---------- final verdict ----------
say("\n" + "=" * 100)
say("VERDICT (primary analysis, pre-declared thresholds |g1|<0.5 symmetric, 0.5-1 moderate, >1 high)")
say(f"Pooled raw RNA expression skewness = {main['g1']:.2f} (bias-corrected {main['G1']:.2f}), "
    f"Pearson2 = {main['pearson2']:.2f}, Bowley = {main['bowley']:.2f}, "
    f"mean/median = {main['mean']/main['median']:.1f} -> {main['verdict'].upper()}")
say(f"log2(x+1) transformation moves skewness to {stats.skew(np.log2(flat+1), bias=True):.2f} "
    f"(i.e. the raw-scale asymmetry is a genuine right-skew, not an artefact).")
open("analysis/results.txt", "w").write("\n".join(LOG) + "\n")
