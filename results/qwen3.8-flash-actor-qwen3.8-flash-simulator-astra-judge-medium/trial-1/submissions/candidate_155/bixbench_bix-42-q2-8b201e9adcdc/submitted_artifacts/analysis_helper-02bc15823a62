"""Minimal pure-Python SVG plotting helpers (matplotlib unavailable in this runner)."""
import math

W, H, ML, MR, MT, MB = 760, 460, 80, 25, 55, 60


def _scale(vmin, vmax, lo, hi):
    if vmax == vmin:
        vmax = vmin + 1.0
    return lambda x: lo + (x - vmin) * (hi - lo) / (vmax - vmin)


def _ticks(vmin, vmax, n=6):
    span = vmax - vmin
    if span <= 0:
        return [vmin]
    step = 10 ** math.floor(math.log10(span / max(n - 1, 1)))
    for m in (1, 2, 5, 10):
        if span / (step * m) <= n - 1:
            step *= m
            break
    t, x = [], math.ceil(vmin / step) * step
    while x <= vmax + 1e-12:
        t.append(x)
        x += step
    return t


def _fmt(x):
    if x == 0:
        return "0"
    a = abs(x)
    if a >= 1e5 or a < 1e-3:
        return "%.1e" % x
    return ("%.4g" % x)


def _frame(title, xlabel, ylabel):
    px0, py0, px1, py1 = ML, MT, W - MR, H - MB
    s = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" '
         f'viewBox="0 0 {W} {H}"><rect width="{W}" height="{H}" fill="white"/>',
         f'<text x="{W/2}" y="26" font-family="sans-serif" font-size="16" '
         f'text-anchor="middle" font-weight="bold">{title}</text>',
         f'<text x="{W/2}" y="{H-12}" font-family="sans-serif" font-size="12" '
         f'text-anchor="middle">{xlabel}</text>',
         f'<text x="16" y="{(MT+py1)/2}" font-family="sans-serif" font-size="12" '
         f'text-anchor="middle" transform="rotate(-90 16 {(MT+py1)/2})">{ylabel}</text>',
         f'<rect x="{px0}" y="{py0}" width="{px1-px0}" height="{py1-py0}" fill="none" '
         f'stroke="#333"/>']
    return s, (px0, py0, px1, py1)


def _axes(s, box, xmin, xmax, ymin, ymax):
    px0, py0, px1, py1 = box
    fx, fy = _scale(xmin, xmax, px0, px1), _scale(ymin, ymax, py1, py0)
    for t in _ticks(xmin, xmax):
        X = fx(t)
        s.append(f'<line x1="{X:.1f}" y1="{py1}" x2="{X:.1f}" y2="{py1+5}" stroke="#333"/>')
        s.append(f'<text x="{X:.1f}" y="{py1+18}" font-family="sans-serif" font-size="10" '
                 f'text-anchor="middle">{_fmt(t)}</text>')
        s.append(f'<line x1="{X:.1f}" y1="{py0}" x2="{X:.1f}" y2="{py1}" stroke="#eee"/>')
    for t in _ticks(ymin, ymax):
        Y = fy(t)
        s.append(f'<line x1="{px0-5}" y1="{Y:.1f}" x2="{px0}" y2="{Y:.1f}" stroke="#333"/>')
        s.append(f'<text x="{px0-8}" y="{Y+4:.1f}" font-family="sans-serif" font-size="10" '
                 f'text-anchor="end">{_fmt(t)}</text>')
        s.append(f'<line x1="{px0}" y1="{Y:.1f}" x2="{px1}" y2="{Y:.1f}" stroke="#eee"/>')
    return fx, fy


def histogram(counts, edges, title, xlabel, ylabel="count", path="hist.svg", color="#3b6fb6"):
    s, box = _frame(title, xlabel, ylabel)
    xmin, xmax = edges[0], edges[-1]
    ymin, ymax = 0.0, max(counts) * 1.05 or 1.0
    fx, fy = _axes(s, box, xmin, xmax, ymin, ymax)
    for c, e0, e1 in zip(counts, edges[:-1], edges[1:]):
        if c <= 0:
            continue
        X0, X1 = fx(e0), fx(e1)
        Y0, Y1 = fy(c), fy(0)
        s.append(f'<rect x="{X0:.1f}" y="{Y0:.1f}" width="{max(X1-X0,0.6):.1f}" '
                 f'height="{max(Y1-Y0,0):.1f}" fill="{color}" stroke="white" stroke-width="0.2"/>')
    s.append("</svg>")
    open(path, "w").write("\n".join(s))
    return path


def scatter(xs, ys, title, xlabel, ylabel, path="qq.svg", color="#b5453b", ref=None):
    s, box = _frame(title, xlabel, ylabel)
    xmin, xmax = min(xs), max(xs)
    ref_ys = ref[1] if ref else []
    ymin = min(list(ys) + list(ref_ys))
    ymax = max(list(ys) + list(ref_ys))
    fx, fy = _axes(s, box, xmin, xmax, ymin, ymax)
    if ref:
        rx, ry = ref
        s.append('<polyline fill="none" stroke="#555" stroke-dasharray="5,4" stroke-width="1.2" points="'
                 + " ".join(f"{fx(a):.1f},{fy(b):.1f}" for a, b in zip(rx, ry)) + '"/>')
    step = max(1, len(xs) // 2000)
    for x, y in zip(xs[::step], ys[::step]):
        s.append(f'<circle cx="{fx(x):.1f}" cy="{fy(y):.1f}" r="1.8" fill="{color}" opacity="0.65"/>')
    s.append("</svg>")
    open(path, "w").write("\n".join(s))
    return path


def boxplots(groups, title, ylabel, path="box.svg"):
    """groups: list of (label, q1, med, q3, lo, hi)."""
    s, box = _frame(title, "", ylabel)
    allv = [v for g in groups for v in (g[4], g[5])]
    ymin, ymax = min(allv), max(allv)
    pad = (ymax - ymin) * 0.06 or 1
    fx, fy = _axes(s, box, -0.5, len(groups) - 0.5, ymin - pad, ymax + pad)
    for i, (lab, q1, med, q3, lo, hi) in enumerate(groups):
        X = fx(i)
        bw = min(60.0, (px1_ := (W - MR - ML) / max(len(groups), 1)) * 0.45)
        s.append(f'<line x1="{X:.1f}" y1="{fy(lo):.1f}" x2="{X:.1f}" y2="{fy(hi):.1f}" stroke="#333"/>')
        for v in (lo, hi):
            s.append(f'<line x1="{X-bw/3:.1f}" y1="{fy(v):.1f}" x2="{X+bw/3:.1f}" y2="{fy(v):.1f}" stroke="#333"/>')
        s.append(f'<rect x="{X-bw/2:.1f}" y="{fy(q3):.1f}" width="{bw:.1f}" height="{max(fy(q1)-fy(q3),1):.1f}" '
                 f'fill="#cfe0f3" stroke="#333"/>')
        s.append(f'<line x1="{X-bw/2:.1f}" y1="{fy(med):.1f}" x2="{X+bw/2:.1f}" y2="{fy(med):.1f}" '
                 f'stroke="#b5453b" stroke-width="2"/>')
        s.append(f'<text x="{X:.1f}" y="{H-MB+32}" font-family="sans-serif" font-size="10" '
                 f'text-anchor="middle">{lab}</text>')
    s.append("</svg>")
    open(path, "w").write("\n".join(s))
    return path
