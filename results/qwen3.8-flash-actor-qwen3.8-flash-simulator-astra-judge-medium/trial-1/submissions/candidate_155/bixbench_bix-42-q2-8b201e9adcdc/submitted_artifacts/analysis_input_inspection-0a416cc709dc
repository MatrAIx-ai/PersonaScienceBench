"""Stage-1 input inspection for bix-42-q2 (COAD RNA expression skewness).
Reproduces all structural facts reported in the plan handoff."""
import pandas as pd, numpy as np

FILES = {
    "geneExp": "data/COAD__geneExp.xls",
    "methylation": "data/COAD__methylation_450__TSS200-TSS1500.xls",
    "clinical": "data/clinical_patient_coad.xls",
}
for k, p in FILES.items():
    idx = None if k == "clinical" else 0
    df = pd.read_csv(p, sep="\t", index_col=idx)
    v = df.select_dtypes(include=[np.number])
    print(f"=== {k}: {p}")
    print("  shape:", df.shape, "| numeric cols:", v.shape[1])
    print("  missing cells:", int(v.isna().values.sum()), f"({v.isna().values.mean():.4%})")
    if v.size:
        arr = v.to_numpy("float64")
        print("  min/median/max: %.4g / %.4g / %.4g" % (np.nanmin(arr), np.nanmedian(arr), np.nanmax(arr)))
        print("  zeros:", int((arr == 0).sum()))
    print("  index[:3]:", list(df.index[:3]))
    print("  columns[:3]:", list(df.columns[:3]))

g = pd.read_csv(FILES["geneExp"], sep="\t", index_col=0)
print("geneExp duplicated gene symbols:", int(pd.Series(g.index).duplicated().sum()))
print("sample-type counts:", pd.Series(g.columns).str.split('-').str[3].str[:2].value_counts().to_dict())
