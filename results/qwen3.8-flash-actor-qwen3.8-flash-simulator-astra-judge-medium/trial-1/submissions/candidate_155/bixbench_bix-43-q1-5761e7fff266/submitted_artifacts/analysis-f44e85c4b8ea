#!/usr/bin/env python
"""BixBench bix-43-q1  —  CBD/cisplatin combination (Cisplatin_IC50_CBD_IC50, group 9)
vs DMSO control (group 3): DE analysis + gseapy GO_Biological_Process_2021 enrichment.

Protocol fixed with researcher (2026-10-22):
 * Contrast: Group=='Cisplatin_IC50_CBD_IC50' (9-1..3) vs Group=='DMSO' (3-1..3); n=3 each.
   Group 10 (combo+serum starvation) = extra/sensitivity only, never in main answer.
 * Low-expression filter: count>=10 in >=3 of the 6 samples.
 * ENSG->symbol (ensg_to_gene_name.tsv); unmapped dropped; multi-ENSG symbols summed.
 * DE main path: DESeq2-like NB GLM (de_core.de_nb_glm, disp_mode='shrunk', pdist='normal').
   Robustness: same NB w/ trend-disp & t4; extra liberal alt: t-test on log2(CPM+1).
 * Main DEG table: padj<0.05 & |log2FC|>1 (up+down combined).
 * Enrichment main: gseapy.enrichr(gene_sets='GO_Biological_Process_2021') -> lowest
   'Adjusted P-value'. Parallel: gseapy.prerank(score=sign(lfc)*-log10(p)).
 * No fabrication: if gseapy/Enrichr unavailable, script records a BLOCKER and stops
   the enrichment step; DE tables are still written.
"""
import sys, json
import numpy as np, pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests
sys.path.insert(0, "/workspace/analysis")
from de_core import de_nb_glm

OUT = "/workspace/results"
import os; os.makedirs(OUT, exist_ok=True)
logf = open(f"{OUT}/run_log.txt", "w")
def log(*a):
    s = " ".join(str(x) for x in a); print(s); logf.write(s + "\n"); logf.flush()

# ---------- 1. inputs & sample mapping (asserted 30/30) ----------
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
counts = counts.loc[~counts.index.duplicated(keep="first")]
layout = pd.read_csv("data/sample_layout.csv")
col2sid = {c: c.replace("_", "-") for c in counts.columns}
assert set(col2sid.values()) == set(layout["SampleID"]) and len(counts.columns) == 30 == len(layout)
log("[QC] 30/30 count columns <-> layout SampleIDs (rule '_'->'-') asserted")
sid2grp = dict(zip(layout["SampleID"], layout["Group"]))
gcols = lambda g: sorted([c for c, s in col2sid.items() if sid2grp[s] == g],
                         key=lambda c: int(c.split("_")[1]))
CTRL, TREAT = gcols("DMSO"), gcols("Cisplatin_IC50_CBD_IC50")
TREAT10 = gcols("Cisplatin_IC50_CBD_IC50_Serum_starvation_16h")
log(f"[QC] control DMSO={CTRL} | treated grp9={TREAT} | extra grp10={TREAT10}")

# ---------- 2. symbol mapping ----------
mp = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")
assert mp["ENSG"].is_unique and mp["gene_name"].notna().all()
smap = dict(zip(mp["ENSG"], mp["gene_name"]))
has = pd.Series(counts.index, index=counts.index).map(smap)
mapped = counts.loc[has.notna()].copy(); mapped["symbol"] = has.dropna().values
n_multi = int(mapped["symbol"].duplicated(keep=False).sum())
mapped = mapped.groupby("symbol", sort=True).sum(numeric_only=True)
log(f"[map] ENSG={len(counts)} mapped={len(counts)-int(has.isna().sum())} "
    f"unmapped_dropped={int(has.isna().sum())} multi-ENSG-symbol rows summed={n_multi} "
    f"symbols_after={len(mapped)}")

# ---------- 3. DE ----------
de = de_nb_glm(mapped[CTRL + TREAT], disp_mode="shrunk", pdist="normal")   # MAIN (DESeq2-like)
de.to_csv(f"{OUT}/de_full_combination9_vs_DMSO3.csv", index=False)
def nsum(r, tag):
    log(f"[DE:{tag}] tested={len(r)} padj<0.05={int((r.padj<0.05).sum())} "
        f"padj<0.05&|lfc|>0.58={int(((r.padj<0.05)&(r.log2FoldChange.abs()>0.58)).sum())} "
        f"padj<0.05&|lfc|>1={int(((r.padj<0.05)&(r.log2FoldChange.abs()>1)).sum())}")
nsum(de, "main shrunk/z (DESeq2-like)")
rob = de_nb_glm(mapped[CTRL + TREAT], disp_mode="trend", pdist="t4")        # conservative
nsum(rob, "robust trend/t4 (perm-calibrated)")
rob.to_csv(f"{OUT}/de_robust_trend_t4.csv", index=False)

# liberal alternative: t-test on log2(CPM+1)  (documented, NOT the agreed NB path)
Y = mapped[CTRL + TREAT].to_numpy(float); keep = (Y >= 10).sum(1) >= 3
L = np.log2(Y[keep] / Y.sum(0) * 1e6 + 1)
tt, pp = stats.ttest_ind(L[:, 3:], L[:, :3], axis=1)
alt = pd.DataFrame({"symbol": mapped.index[keep],
                    "log2FoldChange": L[:, 3:].mean(1) - L[:, :3].mean(1),
                    "pvalue": pp, "padj": multipletests(np.nan_to_num(pp, nan=1.0), method="fdr_bh")[1]})
alt.sort_values("pvalue").to_csv(f"{OUT}/de_alt_ttest_log2cpm.csv", index=False)
log(f"[DE:alt log2CPM t-test] padj<0.05={int((alt.padj<0.05).sum())} "
    f"padj<0.05&|lfc|>1={int(((alt.padj<0.05)&(alt.log2FoldChange.abs()>1)).sum())}")

# DEG tables per protocol (from MAIN path)
main_deg = de[(de.padj < 0.05) & (de.log2FoldChange.abs() > 1)]
main_deg.to_csv(f"{OUT}/deg_main_padj05_lfc1.csv", index=False)
de[de.padj < 0.05].to_csv(f"{OUT}/deg_alt_padj05_all.csv", index=False)
de[(de.padj < 0.05) & (de.log2FoldChange.abs() > 0.58)].to_csv(f"{OUT}/deg_alt_padj05_lfc058.csv", index=False)
log(f"[DEG] main table rows={len(main_deg)}; alt padj<0.05 rows={int((de.padj<0.05).sum())}")

# extra (NOT main answer): group 10 vs DMSO
de10 = de_nb_glm(mapped[CTRL + TREAT10], disp_mode="shrunk", pdist="normal")
de10.to_csv(f"{OUT}/de_extra_grp10_combo_SS_vs_DMSO3.csv", index=False)
nsum(de10, "extra grp10 vs DMSO (NOT in main answer)")

# ranked list for prerank (uses MAIN-path stats)
rank = de.assign(score=np.sign(de.log2FoldChange) * -np.log10(de.pvalue.clip(lower=1e-300))) \
         [["symbol", "score", "log2FoldChange", "pvalue", "padj"]].sort_values("score", ascending=False)
rank.to_csv(f"{OUT}/rnk_all_genes_combination9_vs_DMSO3.csv", index=False)

# ---------- 4. enrichment: gseapy + GO_Biological_Process_2021 ----------
status = {"gseapy_installed": False, "enrichr_reachable": False,
          "enrichr_top_term": None, "prerank_top_term": None, "blocker": None}
try:
    import gseapy
    status["gseapy_installed"] = True
except ImportError:
    status["blocker"] = "gseapy not importable; pip install impossible (no PyPI/DNS in runner)"
if status["gseapy_installed"]:
    import urllib.request
    try:
        urllib.request.urlopen("https://maayanlab.cloud/Enrichr/datasetStatistics", timeout=15)
        status["enrichr_reachable"] = True
    except Exception as e:
        status["blocker"] = f"Enrichr unreachable: {type(e).__name__}: {e}"
if status["gseapy_installed"] and status["enrichr_reachable"]:
    if len(main_deg):
        enr = gseapy.enrichr(gene_list=main_deg["symbol"].tolist(),
                             gene_sets="GO_Biological_Process_2021",
                             organism="human", outdir=None, no_plot=True).results
        e = enr.sort_values("Adjusted P-value")
        e.to_csv(f"{OUT}/enrichr_main_full.csv", index=False)
        e.head(20).to_csv(f"{OUT}/enrichr_main_top20.csv", index=False)
        status["enrichr_top_term"] = e.iloc[0].to_dict()
    else:
        status["enrichr_top_term"] = "NOT RUN: main DEG table empty under fixed protocol"
        log("[ENRICH] main DEG table empty -> ORA enrichment not defined")
    pr = gseapy.prerank(rnk=rank[["symbol", "score"]].rename(columns={"symbol": "Name", "score": "Score"}),
                        gene_sets="GO_Biological_Process_2021", permutation_num=1000,
                        seed=123, threads=2, min_size=15, max_size=500, outdir=None)
    prs = pr.res2d.copy(); prs["FDRnum"] = prs["FDR q-val"].astype(float)
    prs = prs.sort_values("FDRnum")
    prs.head(20).to_csv(f"{OUT}/prerank_top20.csv", index=False)
    status["prerank_top_term"] = prs.iloc[0].to_dict()
else:
    log(f"[BLOCKED] {status['blocker']}")
with open(f"{OUT}/enrichment_status.json", "w") as fh:
    json.dump(status, fh, indent=2, default=str)
log("[DONE]")
logf.close()
