#!/usr/bin/env python
"""OFFLINE FALLBACK enrichment (DEViates from the gseapy+Enrichr protocol of the question!):
use ONLY if a GO Biological Process GMT is supplied (--gmt) and gseapy/Enrichr remain unavailable.
Implements: (1) hypergeometric ORA with BH (background = tested symbols mappable to library),
(2) GSEA-style prerank: KS-like weighted enrichment score + per-gene-set label permutation FDR.
Usage: python local_enrich_fallback.py --gmt go_bp.gmt \
        --rnk results/rnk_all_genes_combination9_vs_DMSO3.csv \
        --genes results/de_alt_ttest_log2cpm.csv --out results/enrichment_local
"""
import argparse, os, sys, json
import numpy as np, pandas as pd
from scipy.stats import hypergeom
from statsmodels.stats.multitest import multipletests

def load_gmt(path):
    gs = {}
    for line in open(path):
        parts = line.rstrip("\n").split("\t")
        name, members = parts[0], [m for m in parts[2:] if m]
        if members: gs[name] = set(members)
    return gs

def ora(gene_list, gs, universe):
    N = len(universe); ul = set(universe); gl = gene_list & ul
    rows = []
    for name, S in gs.items():
        S = S & ul; K = len(S); n = len(gl)
        if K == 0 or n == 0: continue
        ov = len(gl & S)
        if ov == 0: continue
        p = hypergeom.sf(ov - 1, N, K, n)
        rows.append((name, K, n, ov, p, ";".join(sorted(gl & S)[:20])))
    df = pd.DataFrame(rows, columns=["Term", "set_size", "query_size", "Overlap", "pval", "genes"])
    df["Adjusted P-value"] = multipletests(df.pval, method="fdr_bh")[1] if len(df) else []
    return df.sort_values("Adjusted P-value")

def gsea_score(rnk_v, gset_idx, p=1.0):
    n = len(rnk_v); hits = np.zeros(n, bool); hits[gset_idx] = True
    r = np.abs(rnk_v) ** p * hits
    norm_R = r.sum()
    if norm_R == 0: return 0.0
    r = r / norm_R
    miss = (~hits) / (n - hits.sum())
    cand = np.cumsum(r) - np.cumsum(miss)
    i_max, i_min = np.argmax(cand), np.argmin(cand)
    es = cand[i_max] if abs(cand[i_max]) >= abs(cand[i_min]) else cand[i_min]
    return float(es)

def prerank(rnk_df, gs, min_size=15, max_size=500, perm=1000, seed=7):
    rng = np.random.default_rng(seed)
    v = rnk_df["score"].to_numpy(float)
    n = len(v)
    order = np.argsort(-v); vs = v[order]
    sym = rnk_df["symbol"].to_numpy()[order]
    pos = {s: i for i, s in enumerate(sym)}
    rows = []
    for name, S in gs.items():
        idx = np.array(sorted(pos[g] for g in S if g in pos))
        if not (min_size <= len(idx) <= max_size): continue
        es = gsea_score(vs, idx)
        null = np.array([gsea_score(vs, rng.choice(n, len(idx), replace=False)) for _ in range(perm)])
        sd = null.std()
        nes = (es - null.mean()) / (sd + 1e-12)          # NES-like standardization vs same-size nulls
        p_one = (np.sum(null >= es) + 1) / (perm + 1) if es >= 0 else (np.sum(null <= es) + 1) / (perm + 1)
        rows.append((name, len(idx), es, float(nes), float(p_one)))
    df = pd.DataFrame(rows, columns=["Term", "Size", "ES", "NES", "p_one_sided"])
    df["FDR q-val"] = multipletests(df.p_one_sided, method="fdr_bh")[1]
    return df.sort_values("FDR q-val")

if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("--gmt", required=True)
    ap.add_argument("--rnk", required=True); ap.add_argument("--genes", required=True)
    ap.add_argument("--universe", default=None, help="csv with symbol col; default = rnk symbols")
    ap.add_argument("--out", default="/workspace/results/enrichment_local")
    a = ap.parse_args(); os.makedirs(a.out, exist_ok=True)
    gs = load_gmt(a.gmt)
    rnk = pd.read_csv(a.rnk)[["symbol", "score"]].dropna()
    uni = pd.read_csv(a.universe).symbol if a.universe else rnk.symbol
    genes = set(pd.read_csv(a.genes).symbol) & set(uni)
    o = ora(genes, gs, set(uni)); o.head(20).to_csv(f"{a.out}/local_ora_top20.csv", index=False)
    p = prerank(rnk, gs); p.head(20).to_csv(f"{a.out}/local_prerank_top20.csv", index=False)
    print("LOCAL-LIB FALLBACK (not gseapy/Enrichr).")
    print("ORA top   :", o.iloc[0]["Term"], "adjP=", o.iloc[0]["Adjusted P-value"]) if len(o) else print("ORA: empty")
    print("GSEA top  :", p.iloc[0].Term, "FDR=", p.iloc[0]["FDR q-val"])
