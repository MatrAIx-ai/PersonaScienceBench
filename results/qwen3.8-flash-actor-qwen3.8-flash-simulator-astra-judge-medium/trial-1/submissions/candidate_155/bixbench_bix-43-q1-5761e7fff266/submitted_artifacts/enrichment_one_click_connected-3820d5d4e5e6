#!/usr/bin/env python
"""ONE-CLICK enrichment completion for bix-43-q1. Run on a runner WITH network + gseapy,
from the capsule root that contains data/ and results/ (results/ must contain the DE
outputs already produced: de_full_combination9_vs_DMSO3.csv, de_alt_ttest_log2cpm.csv,
rnk_all_genes_combination9_vs_DMSO3.csv).

Branches (researcher directive, 2nd round):
 MAIN  : gseapy.prerank on rnk_all_genes_combination9_vs_DMSO3.csv
         (score = sign(log2FC) * -log10(pvalue) from DESeq2-style NB-GLM path;
          ties broken by larger |log2FC| first, larger lfc first among +scores),
         gene_sets='GO_Biological_Process_2021', permutation_num=2000 -> report min 'FDR q-val' + NES.
 ORA   : gseapy.enrichr on, in priority order:
         a) de_alt_ttest_log2cpm.csv rows with padj<0.05 (~15 genes)
         b) top-N by raw pvalue from de_full (N=150/300; up/down separate & combined)
         Each branch reports its lowest 'Adjusted P-value' term.
Writes results/enrichment_branches/ tables + summary.json with every branch's top term.
"""
import os, sys, json
import pandas as pd

OUT = "/workspace/results"; BR = f"{OUT}/enrichment_branches"
os.makedirs(BR, exist_ok=True)
try:
    import gseapy
except ImportError:
    sys.exit("FATAL: gseapy not importable. Run on a runner with `pip install gseapy` (network required for Enrichr anyway).")

de = pd.read_csv(f"{OUT}/de_full_combination9_vs_DMSO3.csv")
tt = pd.read_csv(f"{OUT}/de_alt_ttest_log2cpm.csv")
rnk = pd.read_csv(f"{OUT}/rnk_all_genes_combination9_vs_DMSO3.csv")
GS = "GO_Biological_Process_2021"
summary = {}

def ora(name, genes):
    genes = [g for g in genes if isinstance(g, str) and not g.startswith("ENSG")]
    if len(genes) < 3:
        summary[name] = {"skipped": f"only {len(genes)} symbols"}; return
    res = gseapy.enrichr(gene_list=genes, gene_sets=GS, organism="human",
                         outdir=None, no_plot=True).results.sort_values("Adjusted P-value")
    res.head(20).to_csv(f"{BR}/ora_{name}_top20.csv", index=False)
    r0 = res.iloc[0]
    summary[name] = {"n_genes": len(genes), "term": r0["Term"],
                     "Adjusted P-value": float(r0["Adjusted P-value"]),
                     "Overlap": r0["Overlap"], "Genes": str(r0["Genes"])[:300]}
    print(f"[ORA:{name}] n={len(genes)} top='{r0['Term']}' adjP={r0['Adjusted P-value']:.3g}")

def topn(N, direction):
    d = de.sort_values("pvalue")
    if direction == "up":    d = d[d.log2FoldChange > 0]
    if direction == "down":  d = d[d.log2FoldChange < 0]
    return d.head(N)

# MAIN prerank
pr = gseapy.prerank(rnk=rnk.rename(columns={"symbol": "Name", "score": "Score"}),
                    gene_sets=GS, permutation_num=2000, seed=123, threads=2,
                    min_size=15, max_size=500, outdir=None)
prs = pr.res2d.copy(); prs["FDRnum"] = prs["FDR q-val"].astype(float)
prs = prs.sort_values("FDRnum")
prs.head(20).to_csv(f"{BR}/prerank_main_top20.csv", index=False)
r0 = prs.iloc[0]
summary["prerank_main"] = {"term": r0["Term"], "FDR q-val": float(r0["FDRnum"]),
                           "NES": float(r0["NES"]), "p-value": float(r0["p-val"]),
                           "size": int(r0["Size"])}
print(f"[PRERANK main] top='{r0['Term']}' FDR={r0['FDRnum']:.3g} NES={r0['NES']:.2f}")

# ORA branches
ora("a_ttest_padj05", tt[tt.padj < 0.05].symbol)
for N in (150, 300):
    ora(f"b_top{N}_combined", topn(N, "all").symbol)
    ora(f"b_top{N}_up", topn(N, "up").symbol)
    ora(f"b_top{N}_down", topn(N, "down").symbol)

with open(f"{BR}/summary.json", "w") as fh:
    json.dump(summary, fh, indent=2, default=str)
print("branch summary ->", f"{BR}/summary.json")
