#!/usr/bin/env python
"""Sensitivity DE per researcher item 7: (a) drop outlier replicate 9_3; (b) winsorize
normalized values per gene at median +/- 3*1.4826*MAD. Same fixed protocol otherwise.
Produces DE tables + prerank-ready ranked (rnk) files for each variant."""
import sys
import numpy as np, pandas as pd
sys.path.insert(0, "/workspace/analysis")
from de_core import de_nb_glm

OUT = "/workspace/results"
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
counts = counts.loc[~counts.index.duplicated(keep="first")]
layout = pd.read_csv("data/sample_layout.csv")
col2sid = {c: c.replace("_", "-") for c in counts.columns}
sid2grp = dict(zip(layout["SampleID"], layout["Group"]))
gcols = lambda g: sorted([c for c, s in col2sid.items() if sid2grp[s] == g],
                         key=lambda c: int(c.split("_")[1]))
CTRL, TREAT = gcols("DMSO"), gcols("Cisplatin_IC50_CBD_IC50")
mp = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")
smap = dict(zip(mp["ENSG"], mp["gene_name"]))
has = pd.Series(counts.index, index=counts.index).map(smap)
mapped = counts.loc[has.notna()].copy(); mapped["symbol"] = has.dropna().values
mapped = mapped.groupby("symbol", sort=True).sum(numeric_only=True)

def make_rnk(de, path):
    r = de.assign(score=np.sign(de.log2FoldChange) * -np.log10(de.pvalue.clip(lower=1e-300))) \
          [["symbol", "score", "log2FoldChange", "pvalue", "padj"]] \
          .sort_values(["score", "log2FoldChange"], ascending=[False, False])  # tie-break: larger lfc first
    r.to_csv(path, index=False)
    return r

# (a) drop 9_3
t2 = [c for c in TREAT if c != "9_3"]
mat = mapped[CTRL + t2]
de_a = de_nb_glm(mat, "shrunk", "normal", n_ctrl=3)
de_a.to_csv(f"{OUT}/de_sens_drop93_combination_vs_DMSO.csv", index=False)
rna = make_rnk(de_a, f"{OUT}/rnk_sens_drop93.csv")
print(f"[drop9_3] tested={len(de_a)} padj<0.05={int((de_a.padj<0.05).sum())} "
      f"|lfc|>1&padj<0.05={int(((de_a.padj<0.05)&(de_a.log2FoldChange.abs()>1)).sum())}")

# (b) winsorize: clip each gene's 6 normalized values at median +/- 3*1.4826*MAD (MAD floor),
#     write back as rounded counts * typical scale -> run NB pipeline on clipped pseudo-counts
mat6 = mapped[CTRL + TREAT]
Y = mat6.to_numpy(float)
sf = Y.sum(0) / Y.sum(0).mean()
N = Y / sf                                  # normalized to mean depth
med = np.median(N, axis=1, keepdims=True)
mad = 1.4826 * np.median(np.abs(N - med), axis=1, keepdims=True)
mad = np.maximum(mad, 0.1 * med + 1.0)      # floor
W = np.clip(N, med - 3 * mad, med + 3 * mad)
n_changed = int((np.abs(W - N) > 0.5).sum())
Wc = pd.DataFrame(np.rint(W * sf), index=mat6.index, columns=mat6.columns).clip(lower=0).astype(int)
keep_gene = ((Y >= 10).sum(1) >= 3)
de_b = de_nb_glm(Wc[keep_gene], "shrunk", "normal")
de_b.to_csv(f"{OUT}/de_sens_winsorized_combination_vs_DMSO.csv", index=False)
rnb = make_rnk(de_b, f"{OUT}/rnk_sens_winsorized.csv")
print(f"[winsorize] cells clipped={n_changed}; tested={len(de_b)} padj<0.05={int((de_b.padj<0.05).sum())} "
      f"|lfc|>1&padj<0.05={int(((de_b.padj<0.05)&(de_b.log2FoldChange.abs()>1)).sum())}")
for tag, r in [("drop93", rna), ("winsor", rnb)]:
    print(f"[rnk:{tag}] top5 up:", r.head(5).symbol.tolist(), "| top5 down:", r.tail(5).symbol.tolist())
