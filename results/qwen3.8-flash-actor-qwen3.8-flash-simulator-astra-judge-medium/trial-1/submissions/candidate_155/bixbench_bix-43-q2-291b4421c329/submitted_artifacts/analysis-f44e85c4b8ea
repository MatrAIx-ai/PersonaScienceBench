#!/usr/bin/env python3
"""
bix-43-q2 : Odds ratio for 'p53-mediated cell cycle gene regulation'
(Gseapy/Reactome_2022 semantics) between CBD/cisplatin combination
(Group Cisplatin_IC50_CBD_IC50 = samples 9_1..9_3) and DMSO (3_1..3_3).

Provenance (researcher ruling item (c)):
  P1 attempt: gseapy install + Enrichr online  -> logged below; used if reachable.
  P3 fallback: local DESeq2-equivalent NB port + Fisher exact test on a
      HAND-CURATED proxy gene set, labelled 'OFFLINE APPROXIMATION'.

DE: DESeq2-equivalent algorithm in numpy: median-of-ratios size factors,
gene-wise NB2 dispersion MLE, parametric trend alpha=a0+a1/mu on decile bins,
empirical-Bayes-style shrinkage (prior df=1), NB2 IRLS + Wald test.
baseMean (DESeq2 semantics) is produced by the model; the baseMean>10
threshold is applied AFTER DE. Primary significance filter: pvalue<0.05.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings("ignore")
from scipy.stats import norm, fisher_exact
OUT = "results"; log_lines = []
def log(m):
    print(m); log_lines.append(str(m))

# ---------------- 0. connectivity / tooling provenance ----------------
log("== Step 0: connectivity / tooling provenance ==")
has_gseapy = False
try:
    import gseapy  # noqa
    has_gseapy = True; log("gseapy import: OK")
except Exception as e:
    log(f"gseapy import: FAILED ({type(e).__name__})")
online = False
try:
    import urllib.request
    urllib.request.urlopen("https://maayanlab.cloud/Enrichr/datasetStatistics", timeout=8)
    online = True; log("Enrichr (maayanlab.cloud): REACHABLE")
except Exception as e:
    log(f"Enrichr (maayanlab.cloud): UNREACHABLE ({type(e).__name__})")
log(f"MODE = {'ONLINE gseapy.enrichr (canonical)' if (online and has_gseapy) else 'OFFLINE APPROXIMATION (local Fisher; NOT Enrichr output)'}")

# ---------------- 1. load & subset ----------------
log("\n== Step 1: load & subset ==")
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("data/sample_layout.csv")
ctrl, trt = [], []
for _, r in layout.iterrows():
    c = str(r.SampleID).replace("-", "_")
    if r.Group == "DMSO": ctrl.append(c)
    elif r.Group == "Cisplatin_IC50_CBD_IC50": trt.append(c)
log(f"CTRL(DMSO)={ctrl}  TRT(Cisplatin_IC50_CBD_IC50)={trt}  [inferred from Group labels]")
sub = pd.concat([counts[ctrl], counts[trt]], axis=1)
sub = sub[sub.sum(axis=1) > 0]
gene_ids = list(sub.index)
Y = sub.to_numpy(float)                # (G, n)
G, n = Y.shape
group = np.array([0.0]*len(ctrl) + [1.0]*len(trt))
log(f"tested genes (non-all-zero): {G} of 63677 (27954 all-zero dropped)")

# ---------------- 2. DESeq2-equivalent NB model ----------------
log("\n== Step 2: DESeq2-equivalent NB model ==")
# size factors: median of ratios on genes positive in all samples
Yt = Y.T                                    # (n, G)
pos = np.all(Yt > 0, axis=0)                # (G,)
L = np.log(np.maximum(Yt[:, pos], 1e-12))
gref = L.mean(axis=0)
sf = np.exp(np.median(L - gref[None, :], axis=1))
sf = sf / np.exp(np.mean(np.log(sf)))
log(f"size factors (3 DMSO, 3 COMBO): {np.round(sf,3).tolist()}")
off = np.log(sf)[:, None]                   # (n,1)
X = np.column_stack([np.ones(n), group])    # (n,2)
norm_counts = Yt / sf[:, None]                       # (n,G)
baseMean = norm_counts.mean(axis=0)         # (G,)

def nb_irls(alpha, iters=60):
    """NB2 IRLS per gene with fixed dispersion vector alpha (G,)."""
    a = np.clip(alpha, 1e-8, 1e4)[None, :]
    beta = np.zeros((2, G))
    beta[0] = np.log(np.maximum(Yt.mean(axis=0), 1e-8)) - off.mean()
    for _ in range(iters):
        eta = X @ beta + off
        mu = np.exp(np.clip(eta, -50, 20)) + 1e-12
        w = mu / (1 + a * mu)
        z = (eta - off) + (Yt - mu) / (mu * (1 + a * mu))
        H = np.einsum("si,sg,sj->gij", X, w, X)
        H[:, 0, 0] += 1e-4; H[:, 1, 1] += 1e-4     # ridge -> finite betas
        r = np.einsum("si,sg,sg->gi", X, w, z)
        step = np.linalg.solve(H, r[:, :, None])[:, :, 0].T - beta
        np.clip(step, -2, 2, out=step)
        beta += step
        if np.max(np.abs(step)) < 1e-9: break
    return beta, H

from scipy.special import gammaln
def nll(alpha, beta):
    """Full NB2 negative log-likelihood (alpha-dependent lgamma terms included)."""
    eta = X @ beta + off
    mu = np.exp(np.clip(eta, -50, 20)) + 1e-12
    a = np.clip(alpha, 1e-8, 1e4)[None, :]
    ll = (gammaln(Yt + 1/a) - gammaln(1/a) - gammaln(Yt + 1)
          + Yt*np.log(a*mu/(1+a*mu)) + (1/a)*np.log(1/(1+a*mu)))
    return -ll.sum(axis=0)

grid = np.concatenate([np.linspace(1e-6, 1e-2, 20), np.geomspace(1.2e-2, 20, 40)])
best_ll = np.full(G, -np.inf); best_a = np.full(G, 1e-6)
for a0 in grid:
    al = np.full(G, a0)
    b, _ = nb_irls(al, iters=30)
    ll = -nll(al, b)
    upd = ll > best_ll; best_ll[upd] = ll[upd]; best_a[upd] = a0
log(f"gene-wise dispersion median={np.median(best_a):.4g}")

# trend on deciles of size-factor-normalized geometric mean
gm = np.exp(np.clip(np.log(np.maximum(norm_counts, 1e-6)).mean(axis=0), -20, 20))
order = np.argsort(gm); bx, by, bw = [], [], []
for bi in np.array_split(order, 10):
    q = best_a[bi]; keep = q < np.quantile(q, 0.99)
    if keep.sum() < 2: continue
    bx.append(np.median(gm[bi][keep]))
    by.append(np.exp(np.log(np.maximum(q[keep], 1e-8)).mean()))
bx, by = np.array(bx), np.array(by)
A = np.column_stack([np.ones_like(bx), 1/np.maximum(bx, 1e-6)])
coef = np.linalg.lstsq(A, np.log(np.maximum(by, 1e-8)), rcond=None)[0]
alpha_trend = np.clip(np.exp(coef[0] + coef[1]/np.maximum(gm, 1e-6)), 1e-8, 1e4)
log(f"trend fit: log-a0={coef[0]:.3f} a1={coef[1]:.4g}")

dfG = n - 2
alpha_s = np.clip((dfG*best_a + 1.0*alpha_trend)/(dfG + 1.0), 1e-8, 1e4)
beta, H = nb_irls(alpha_s, iters=100)
cov = np.linalg.inv(H)
b1 = beta[1]; se = np.sqrt(np.maximum(cov[:, 1, 1], 1e-12))
lfc = b1/np.log(2); z = b1/se
pval = 2*norm.sf(np.abs(z))
o = np.argsort(pval); pr = pval[o]; mG = len(pr)
padj_sorted = np.empty(mG)
padj_sorted[o] = np.clip(np.minimum.accumulate(((pr*mG)/np.arange(1, mG+1))[::-1])[::-1], 0, 1)

sym = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t").set_index("ENSG").gene_name
res = pd.DataFrame({"baseMean": baseMean, "log2FoldChange": lfc,
                    "lfcSE": se/np.log(2), "stat": z, "pvalue": pval,
                    "padj": padj_sorted}, index=gene_ids)
res["gene_symbol"] = sym.reindex(res.index)
res.to_csv(f"{OUT}/de_results_group9_vs_DMSO.csv")
log(f"DE table {res.shape} -> {OUT}/de_results_group9_vs_DMSO.csv")
log(f"sanity: padj<0.05 count = {int((res.padj<0.05).sum())}, pvalue<0.05 count = {int((res.pvalue<0.05).sum())}")

# ---------------- 3. thresholds ----------------
log("\n== Step 3: threshold ladder (primary = literal pvalue) ==")
i1 = res.pvalue < 0.05
i2 = i1 & (res.log2FoldChange.abs() > 0.5)
i3 = i2 & (res.baseMean > 10)
for name, mk in [("(i)   pvalue<0.05", i1), ("(ii)  +|log2FC|>0.5", i2),
                 ("(iii) +baseMean>10  (FINAL)", i3)]:
    log(f"{name:30s}: {int(mk.sum()):5d}")
final = res[i3]
up = final[final.log2FoldChange > 0]; dn = final[final.log2FoldChange < 0]
log(f"FINAL: {len(final)} genes  (up={len(up)}, down={len(dn)})")
sens = res[(res.padj < 0.05) & (res.log2FoldChange.abs() > 0.5) & (res.baseMean > 10)]
log(f"SENSITIVITY padj<0.05: {len(sens)} genes (up={int((sens.log2FoldChange>0).sum())}, down={int((sens.log2FoldChange<0).sum())})")
final.to_csv(f"{OUT}/de_significant_genes.csv"); up.to_csv(f"{OUT}/de_up_genes.csv"); dn.to_csv(f"{OUT}/de_down_genes.csv")
sig_genes = sorted(final.gene_symbol.dropna().unique())
log(f"unique mapped symbols submitted to enrichment: {len(sig_genes)} "
    f"(of {len(final)} ENSEMBL rows; {int(final.gene_symbol.isna().sum())} unmapped dropped)")
open(f"{OUT}/significant_symbols.txt", "w").write("\n".join(sig_genes))

# ---------------- 4. enrichment ----------------
log("\n== Step 4: enrichment ==")
bg_syms = sorted(set(res.gene_symbol.dropna()))
N = len(bg_syms); sigset = set(sig_genes)
if online and has_gseapy:
    import gseapy
    enr = gseapy.enrichr(gene_list=sig_genes, gene_sets="Reactome_2022", outdir=None)
    t = enr.results
    t = t[t["Term"].str.contains("p53", case=False) & t["Term"].str.contains("cell cycle", case=False)]
    t.to_csv(f"{OUT}/enrichr_online_target_term.csv", index=False)
    log("ONLINE RESULT:\n" + t.to_string(index=False))
else:
    log("OFFLINE APPROXIMATION: local Fisher exact (NOT Enrichr/gseapy output).")
    log("Gene set = HAND-CURATED proxy of Reactome event R-HSA-6804756")
    log("'TP53RegulatesTranscriptionOfCellCycleGenes' -- nearest available match for the")
    log("requested term 'p53-mediated cell cycle gene regulation'. NOT the official")
    log("Enrichr Reactome_2022 GMT. Members (20, direct p53 targets of the cell-cycle")
    log("arrest program): CDKN1A GADD45A GADD45B MDM2 ZMAT3 CCNG2 SESN1 SESN2 TP53I3")
    log("RRM2B TP53INP1 BTG2 PHLDA3 AEN TRIAP1 TP53AIP1 EDA2R GLS2 TIGAR XPC")
    log("Adjusted p = raw p (only ONE gene set testable offline; Enrichr's library-wide")
    log("Bonferroni cannot be reproduced without the full Reactome_2022 library).")
    p53 = ["CDKN1A","GADD45A","GADD45B","MDM2","ZMAT3","CCNG2","SESN1","SESN2","TP53I3",
           "RRM2B","TP53INP1","BTG2","PHLDA3","AEN","TRIAP1","TP53AIP1","EDA2R","GLS2",
           "TIGAR","XPC"]
    set_bg = [g for g in p53 if g in set(bg_syms)]
    B = len(set_bg)
    hits = [g for g in set_bg if g in sigset]
    a = len(hits); n1 = len(sig_genes)
    table = [[a, n1-a], [B-a, N-n1-(B-a)]]
    orr, p1s = fisher_exact(table, alternative="greater")
    _, p2s = fisher_exact(table, alternative="two-sided")
    out = pd.DataFrame([{
        "Term": "p53-mediated cell cycle gene regulation [OFFLINE APPROXIMATION - hand-curated proxy of Reactome R-HSA-6804756]",
        "Odds Ratio": round(float(orr), 6),
        "p-value (1-sided Fisher)": float(f"{p1s:.6g}"),
        "p-value (2-sided Fisher)": float(f"{p2s:.6g}"),
        "Adjusted p-value (= p; single set)": float(f"{p1s:.6g}"),
        "Overlap (hits/set-in-background)": f"{a}/{B}",
        "Set size (in background)": B,
        "Background N (unique mapped symbols of tested genes)": N,
        "Gene list size": n1,
        "Overlap genes": ";".join(sorted(hits))}])
    out.to_csv(f"{OUT}/enrichment_offline_fisher.csv", index=False)
    log(out.to_string(index=False))
    log(f"\nFINAL ODDS RATIO (OFFLINE FISHER APPROXIMATION) = {orr:.6f}")
    log(f"2x2 table [[a, n1-a],[B-a, N-n1-(B-a)]] = {table}")
open(f"{OUT}/run_log.txt", "w").write("\n".join(log_lines))

# ================= addendum (researcher follow-up) =================
log("\n== Step 5: technical verifications ==")
nan_mask = res["stat"].isna()
log(f"NaN-stat genes: {int(nan_mask.sum())}; with baseMean>10: {int((nan_mask & (res.baseMean>10)).sum())}")
bad = res[nan_mask & (res.baseMean > 10)]
if len(bad): log(bad.to_string())
else: log("=> all NaN-stat genes fall below baseMean>10; no intersection with the specified filter.")
log("background N=27,229 is the dedup symbol set of ALL tested (non-all-zero) genes, NOT baseMean-filtered;")
expr = res[(res.baseMean > 10) & res.gene_symbol.notna()]
N_expr = expr.gene_symbol.nunique()
log(f"alternative 'expressed universe' N (baseMean>10 & mappable, dedup symbols) = {N_expr}")

bg_full = set(res.gene_symbol.dropna()); n1 = len(sig_genes); sigset = set(sig_genes)
def fisher_row(term, members, N):
    set_bg = [g for g in members if g in bg_full] if N == len(bg_full) else [g for g in members if g in set(expr.gene_symbol)]
    B = len(set_bg); hits = [g for g in set_bg if g in sigset]; a = len(hits)
    tbl = [[a, n1-a],[B-a, N-n1-(B-a)]]
    if min(r for r in [tbl[0][1], tbl[1][0], tbl[1][1]]) < 0:
        return dict(Term=term, N=N, B=B, hits=a, OR=float('nan'), p=float('nan'), tbl=str(tbl))
    orr, p1 = fisher_exact(tbl, alternative="greater")
    return dict(Term=term, gene_list=n1, N=N, set_members=len(members), B_in_bg=B, hits=a,
                OR=round(float(orr),4), p_one_sided=float(f"{p1:.4g}"), tbl=str(tbl))

log("\n== Step 6: sensitivity of OR to gene-set and background definition ==")
core12 = ["CDKN1A","MDM2","ZMAT3","GADD45A","GADD45B","CCNG2","RRM2B","TP53INP1","BTG2","PHLDA3","AEN","TIGAR"]
proxy20 = ["CDKN1A","GADD45A","GADD45B","MDM2","ZMAT3","CCNG2","SESN1","SESN2","TP53I3","RRM2B",
           "TP53INP1","BTG2","PHLDA3","AEN","TRIAP1","TP53AIP1","EDA2R","GLS2","TIGAR","XPC"]
broad = sorted(set(proxy20 + core12 + ["SESN3","FAS","TNFRSF10B","BAX","GDF15","PLK3","RPS27L",
                                       "FDXR","TP53INP2","DDB2","TP53","SESN2","GLS2","EDA2R"]))
rows = []
for term, mem in [("(i)  proxy-20 (R-HSA-6804756 hand-curated)", proxy20),
                  ("(ii) core direct-target subset (12)", core12),
                  ("(iii) broad p53 transcriptional program", broad)]:
    rows.append(fisher_row(term, mem, len(bg_full)))          # N = 27,229 tested-mappable
    rows.append(fisher_row(term + "  [expressed universe]", mem, N_expr))  # N = baseMean>10 universe
sens_tbl = pd.DataFrame(rows)
log(sens_tbl.to_string(index=False))
sens_tbl.to_csv(f"{OUT}/sensitivity_table.csv", index=False)
log("NOTE on literal 'N=1,358 list-as-background': mathematically degenerate (the gene list would equal")
log("the background; every hit is in the background by construction and the 2x2 has an empty contrast")
log("cell -> OR undefined). The expressed universe (N=%d) is the meaningful smaller-background analogue." % N_expr)

# padj primary list comparison (set i, N=27,229)
padj_syms = sorted(sens.gene_symbol.dropna().unique())
pset = set(padj_syms); pn = len(padj_syms)
set_bg = [g for g in proxy20 if g in bg_full]; B = len(set_bg)
hits = [g for g in set_bg if g in pset]; a = len(hits)
tbl = [[a, pn-a],[B-a, len(bg_full)-pn-(B-a)]]
orr_p, p_p = fisher_exact(tbl, alternative="greater")
log(f"\n== padj-caliber comparison: list={pn} symbols, hits {a}/{B}, OR={orr_p:.4f}, p={p_p:.4g}, table={tbl}")
open(f"{OUT}/run_log.txt","w").write("\n".join(log_lines))
