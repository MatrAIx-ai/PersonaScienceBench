"""
BixBench bix-51-q2 -- MAIN ANALYSIS (researcher-approved specification).

Question: AIC of the logistic regression using BMI as the SOLE predictor of
treatment response (efficacy == PR).

Approved spec:
  * drop fully-empty trailing rows -> n = 80 analysis set
  * y = 1 if Efficacy == 'PR' (41), y = 0 if Efficacy in {SD, PD} (39)
  * single predictor: raw continuous BMI (kg/m^2); no binning/scaling/splines/covariates
  * statsmodels Logit, with intercept, full-information MLE, no penalty
  * AIC = -2*loglik + 2k, k = 2  (equivalent to R glm(family=binomial)); no AICc
"""
import numpy as np, pandas as pd, statsmodels.api as sm

PATH = "data/data.xlsx"

# ---------------- 1. Load & clean ----------------
raw = pd.read_excel(PATH, sheet_name="Sheet1", header=None)
non_empty = raw.apply(lambda c: c.map(lambda v: (not pd.isna(v)) and str(v).strip() != ""))
has_data = non_empty.any(axis=1)
block = raw.loc[has_data]
df = block.iloc[1:].reset_index(drop=True)
df.columns = block.iloc[0].tolist()
df["BMI"] = pd.to_numeric(df["BMI"], errors="coerce")
n_rows_sheet = raw.shape[0] - 1
n_blank = int((~has_data).sum())

d = df.loc[df["Efficacy"].notna() & df["BMI"].notna()].copy()
d["y"] = (d["Efficacy"].astype(str).str.strip().str.upper() == "PR").astype(int)
d["BMI"] = d["BMI"].astype(float)

print("rows in Sheet1 (excl. header): %d | fully-empty rows dropped: %d | analysis set n = %d"
      % (n_rows_sheet, n_blank, len(d)))
print("complete cases (Efficacy & BMI): %d" % len(d))
print("Efficacy frequencies:", d["Efficacy"].value_counts().to_dict())
print("outcome y=1 (PR): %d | y=0 (SD+PD): %d" % (d["y"].sum(), (1 - d["y"]).sum()))
print("BMI entered model: n=%d mean=%.4f sd=%.4f min=%.1f max=%.1f"
      % (d["BMI"].notna().sum(), d["BMI"].mean(), d["BMI"].std(), d["BMI"].min(), d["BMI"].max()))
print("BMI overlap: responders [%.1f, %.1f], non-responders [%.1f, %.1f] -> separation: %s"
      % (d.loc[d.y == 1, "BMI"].min(), d.loc[d.y == 1, "BMI"].max(),
         d.loc[d.y == 0, "BMI"].min(), d.loc[d.y == 0, "BMI"].max(),
         bool(d.loc[d.y == 1, "BMI"].min() > d.loc[d.y == 0, "BMI"].max()
              or d.loc[d.y == 1, "BMI"].max() < d.loc[d.y == 0, "BMI"].min())))

# ---------------- 2. Primary model ----------------
X = sm.add_constant(d["BMI"], has_constant="add")
res = sm.Logit(d["y"], X).fit(disp=0)
k = int(res.df_model + 1)          # intercept + BMI
aic = float(res.aic)
aic_check = -2.0 * float(res.llf) + 2.0 * k

print("\n=== PRIMARY MODEL: Logit(PR) ~ 1 + BMI ===")
print(res.summary().as_text())
print("\nbeta0 (Intercept) = %.6f" % res.params["const"])
print("beta1 (BMI)       = %.6f" % res.params["BMI"])
print("log-likelihood    = %.6f" % res.llf)
print("converged         = %s (iters=%d)" % (bool(res.mle_retvals["converged"]), res.mle_retvals["iterations"]))
print("null loglik       = %.6f  | LR stat = %.4f (p=%.4f) | pseudo R2 = %.4f"
      % (res.llnull, res.llr, res.llr_pvalue, res.prsquared))
print("OR per 1 kg/m^2   = %.6f  [95%% CI %.4f, %.4f]"
      % (np.exp(res.params["BMI"]), *np.exp(res.conf_int().loc["BMI"].values)))
print("k (params)        = %d" % k)
print("AIC (res.aic)     = %.6f" % aic)
print("AIC (-2llf + 2k)  = %.6f  | match: %s" % (aic_check, np.isclose(aic, aic_check, atol=1e-8)))

# convergence robustness: alternative optimizers
for meth in ["newton", "bfgs"]:
    r2 = sm.Logit(d["y"], X).fit(method=meth, disp=0)
    print("optimizer %-7s -> converged=%s loglik=%.6f AIC=%.6f"
          % (meth, bool(r2.mle_retvals.get("converged", True)), r2.llf, r2.aic))

# ---------------- 3. Engine consistency: GLM Binomial ----------------
glm = sm.GLM(d["y"], X, family=sm.families.Binomial()).fit()
aic_glm = 2.0 * (-glm.llf) + 2.0 * (len(glm.params))
print("\n=== ENGINE CONSISTENCY ===")
print("GLM(Binomial): loglik=%.6f AIC=%.6f | Logit AIC=%.6f | |diff|=%.3e -> consistent: %s"
      % (glm.llf, glm.aic, aic, abs(glm.aic - aic), np.isclose(glm.aic, aic, atol=1e-6)))
print("manual formula -2*llf+2k with k=2: %.6f" % (-2*glm.llf + 4))

# ---------------- 4. Diagnostics only (NOT the answer) ----------------
print("\n=== SENSITIVITY DIAGNOSTICS (do NOT affect the final answer) ===")
alt = (d["Efficacy"].astype(str).str.upper() != "PD").astype(int)
r_alt = sm.Logit(alt, X).fit(disp=0)
print("alt coding (PR+SD) vs PD : events=%d/%d loglik=%.6f AIC=%.6f  [diagnostic only]"
      % (alt.sum(), len(alt), r_alt.llf, r_alt.aic))
null = sm.Logit(d["y"], np.ones((len(d), 1))).fit(disp=0)
print("null model (intercept only): loglik=%.6f AIC=%.6f  [reference, k=1]" % (null.llf, null.aic))
print("AICc for reference only (NOT reported as answer): %.6f"
      % (aic + (2*k*(k+1))/(len(d)-k-1)))
print("\nFINAL ANSWER AIC = %.4f  (rounded to 2 dp: %.2f)" % (aic, aic))
