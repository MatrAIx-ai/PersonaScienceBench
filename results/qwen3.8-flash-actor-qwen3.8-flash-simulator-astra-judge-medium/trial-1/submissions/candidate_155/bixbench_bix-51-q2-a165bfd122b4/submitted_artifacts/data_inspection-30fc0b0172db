"""
BixBench bix-51-q2 -- STAGE 1: DATA INSPECTION ONLY (no model fitted, no AIC computed).
Question (later stage): AIC of logistic regression with BMI as sole predictor of
treatment response (efficacy == PR).
"""
import pandas as pd, numpy as np, openpyxl

PATH = "data/data.xlsx"

# ---------- 1. Structure ----------
xl = pd.ExcelFile(PATH)
print("sheets:", xl.sheet_names)
raw = xl.parse("Sheet1", header=None)
print("raw grid shape (incl. header):", raw.shape)

df_all = xl.parse("Sheet1")
print("\n[as-read] shape:", df_all.shape)
print("[as-read] non-null per column:\n", df_all.count().to_string())

# Identify fully empty trailing rows (formatting artifacts of the export)
non_empty = raw.apply(lambda c: c.map(lambda v: (not pd.isna(v)) and str(v).strip() != ""))
row_has_data = non_empty.any(axis=1)
data_rows = raw.loc[row_has_data]
header = data_rows.iloc[0].tolist()
df = data_rows.iloc[1:].reset_index(drop=True)
df.columns = header
df["BMI"] = pd.to_numeric(df["BMI"], errors="coerce")
print("\ntrailing rows that are entirely empty:", int((~row_has_data).sum()))
print("analysis block shape:", df.shape, "| duplicate rows:", int(df.duplicated().sum()),
      "| duplicate Sequence number:", int(df["Sequence number"].duplicated().sum()),
      "| seq range:", df["Sequence number"].min(), "-", df["Sequence number"].max())
print("\nvariable types (analysis block):")
print(df.dtypes.to_string())
print("\nnon-null per column:", df.notna().sum().to_dict())

# ---------- 2. Efficacy & BMI ----------
print("\nEfficacy value_counts (analysis block, dropna=False):\n",
      df["Efficacy"].value_counts(dropna=False).to_string())
print("Efficacy raw distinct repr:", sorted(map(repr, df["Efficacy"].unique())))
s = df["Efficacy"].astype(str)
print("whitespace/case-normalised counts:", s.str.strip().str.upper().value_counts().to_dict())
print("Efficacy missing:", int(df["Efficacy"].isna().sum()))

b = df["BMI"]
print("\nBMI: n=%d missing=%d (%.1f%%) min=%.1f max=%.1f" % (
    b.notna().sum(), b.isna().sum(), 100 * b.isna().mean(), b.min(), b.max()))
print("BMI describe:\n", b.describe().to_string())
print("BMI quantiles:", b.quantile([.05, .25, .5, .75, .95]).round(2).to_dict())
print("BMI skew=%.3f kurtosis=%.3f" % (b.skew(), b.kurt()))
print("BMI implausible (<=0 or >60):", int((b <= 0).sum() + (b > 60).sum()))
print("BMI mean/sd by Efficacy:\n",
      df.groupby("Efficacy")["BMI"].agg(["count", "mean", "std", "min", "max"]).round(2).to_string())

# ---------- 3. Outcome-coding feasibility ----------
print("\ncrosstab Groups x Efficacy:\n", pd.crosstab(df["Groups"], df["Efficacy"]).to_string())
for lbl, alt in [("PR vs (SD+PD)", df["Efficacy"].eq("PR")),
                 ("(PR+SD) vs PD", df["Efficacy"].ne("PD"))]:
    y = alt.astype(int)
    print("%-14s events=%d non-events=%d  BMI mean(events)=%.2f vs %.2f" %
          (lbl, y.sum(), (1 - y).sum(), b[y == 1].mean(), b[y == 0].mean()))
print("\ncomplete cases for (Efficacy, BMI):", int((df["Efficacy"].notna() & df["BMI"].notna()).sum()))

# ---------- 4. Hidden metadata check ----------
wb = openpyxl.load_workbook(PATH)
ws = wb["Sheet1"]
print("\nsheet state/hidden rows/comments/defined names:",
      ws.sheet_state, [r for r, d in ws.row_dimensions.items() if d.hidden],
      sum(1 for r in ws.iter_rows() for c in r if c.comment), list(wb.defined_names))
print("unit-like text anywhere in sheet:",
      [c.value for r in ws.iter_rows() for c in r
       if isinstance(c.value, str) and any(k in c.value.lower() for k in ["kg", "m2", "unit"])])
