"""
BixBench bix-51-q3
Question: In a combined (pooled) logistic regression model with BMI, age and gender,
what is the p-value for age as a predictor of treatment response (partial response, PR)?

Fixed analysis protocol (approved by researcher):
  - outcome: PR = 1 ; SD and PD = 0 (SD kept in the non-response group)
  - sample: Sequence number 1..80, complete cases on BMI / Age / Gender
  - model: pooled binary logistic regression  response ~ BMI + Age + Gender
           Age and BMI as raw continuous values (no centering / binning / scaling)
           Gender with Female as reference level
  - inference: statsmodels MLE (Newton) with Wald z tests
"""
import json
import sys
import numpy as np
import pandas as pd
import scipy
import statsmodels
import statsmodels.formula.api as smf
from statsmodels.stats.outliers_influence import variance_inflation_factor

print("python / pandas %s / numpy %s / scipy %s / statsmodels %s"
      % (pd.__version__, np.__version__, scipy.__version__, statsmodels.__version__))

# ------------------------------------------------------------------ 1. load
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print("\nraw sheet shape:", df.shape)

# analysis rows = records carrying a Sequence number (1..80)
d = df[df["Sequence number"].notna()].copy()
d["Sequence number"] = d["Sequence number"].astype(int)
d = d[(d["Sequence number"] >= 1) & (d["Sequence number"] <= 80)].copy()
print("rows with Sequence number 1-80:", len(d))

# ------------------------------------------------------------------ 2. tidy vars
# Age stored as text in the sheet; blank cells are the string " " -> coerce to NaN
d["Age_num"] = pd.to_numeric(d["Age"].astype(str).str.strip(), errors="coerce")
age_nonnumeric = d.loc[d["Age_num"].isna() & d["Age"].notna(), ["Sequence number", "Age"]]
print("Age values that could not be parsed as numeric:", len(age_nonnumeric))
if len(age_nonnumeric):
    print(age_nonnumeric.to_string())

d["BMI_num"] = pd.to_numeric(d["BMI"], errors="coerce")
d["Gender"] = d["Gender"].astype(str).str.strip()
d["Efficacy"] = d["Efficacy"].astype(str).str.strip()

print("\nEfficacy counts (analysis rows):\n", d["Efficacy"].value_counts().to_string())
print("Gender counts:\n", d["Gender"].value_counts().to_string())

# missing-data audit on the modelling variables
audit = d[["Efficacy", "Age_num", "BMI_num", "Gender"]].isna().sum()
print("\nmissing in modelling variables (before case filtering):\n", audit.to_string())

d = d.dropna(subset=["Efficacy", "Age_num", "BMI_num", "Gender"]).copy()
print("complete cases used for modelling:", len(d))

# ------------------------------------------------------------------ 3. outcome
d["response"] = (d["Efficacy"] == "PR").astype(int)
n = len(d)
n_pr = int(d["response"].sum())
print("n = %d | PR = %d | non-PR (SD+PD) = %d  (SD=%d, PD=%d)"
      % (n, n_pr, n - n_pr, (d["Efficacy"] == "SD").sum(), (d["Efficacy"] == "PD").sum()))

# ------------------------------------------------------------------ 4. main model
model = smf.logit(
    "response ~ BMI_num + Age_num + C(Gender, Treatment(reference='Female'))",
    data=d)
res = model.fit(disp=True, maxiter=100)
print("\n================ MAIN MODEL: response(PR) ~ BMI + Age + Gender (pooled) ================")
print(res.summary())

coef_tbl = pd.DataFrame({
    "coef": res.params, "SE": res.bse, "z": res.tvalues, "p": res.pvalues,
    "CI_low": res.conf_int()[0], "CI_high": res.conf_int()[1]})
coef_tbl["OR"] = np.exp(coef_tbl["coef"])
print("\ncoefficient table:\n", coef_tbl.to_string(float_format=lambda x: "%.6f" % x))

age_p = float(res.pvalues["Age_num"])
print("\n>>> Age Wald p-value = %.10g   (z = %.6f, coef = %.8f, OR = %.6f)"
      % (age_p, res.tvalues["Age_num"], res.params["Age_num"], np.exp(res.params["Age_num"])))

# convergence / fit diagnostics
print("\nconverged:", res.mle_retvals["converged"],
      "| iterations:", res.mle_retvals["iterations"],
      "| method:", res.mle_retvals.get("method", "newton"))
dev, dev0 = -2.0 * res.llf, -2.0 * res.llnull
print("loglikelihood: %.6f | deviance (-2LL): %.6f | null deviance: %.6f | df_model: %d | nobs: %d"
      % (res.llf, dev, dev0, res.df_model, res.nobs))
print("McFadden pseudo-R2: %.6f | LLR p-value: %.6g" % (res.prsquared, res.llr_pvalue))
pred = res.predict()
pred_cls = (np.asarray(pred) >= 0.5).astype(int)
yv = d["response"].to_numpy().astype(int)
print("separation diagnostics: linear predictor range [%.3f, %.3f]; predicted prob range [%.4f, %.4f];"
      % (res.fittedvalues.min(), res.fittedvalues.max(), pred.min(), pred.max()))
print("  no predicted probability reaches 0 or 1 -> no complete separation by the 3 predictors;"
      " in-sample classification accuracy = %.3f (%d/%d correct)"
      % (np.mean(pred_cls == yv), int(np.sum(pred_cls == yv)), n))
print("  (note: the excluded variable Groups perfectly separates PR vs non-PR, which is why it is not"
      " included in the pooled model)")

# ------------------------------------------------------------------ 5. collinearity
num = d[["BMI_num", "Age_num"]].copy()
num["Gender_Male"] = (d["Gender"] == "Male").astype(int)
print("\nPearson correlations:")
print(num.corr().to_string(float_format=lambda x: "%.4f" % x))
print("\nSpearman correlations:")
print(num.corr(method="spearman").to_string(float_format=lambda x: "%.4f" % x))

X = np.column_stack([np.ones(n), d["BMI_num"].values, d["Age_num"].values,
                     (d["Gender"] == "Male").astype(int).values])
names = ["Intercept", "BMI", "Age", "Gender_Male"]
print("\nVIF (on design matrix with intercept):")
for i, nm in enumerate(names):
    if i == 0:
        continue
    print("  %-12s VIF = %.4f" % (nm, variance_inflation_factor(X, i)))
print("  condition number of design matrix: %.3f" % np.linalg.cond(X))

# ------------------------------------------------------------------ 6. sensitivity
print("\n================ SENSITIVITY (additional, non-primary) ================")
# (a) PR vs PD, SD dropped
s = d[d["Efficacy"].isin(["PR", "PD"])].copy()
s["y"] = (s["Efficacy"] == "PR").astype(int)
res_a = smf.logit("y ~ BMI_num + Age_num + C(Gender, Treatment(reference='Female'))",
                  data=s).fit(disp=0, maxiter=100)
print("(a) PR vs PD (SD excluded): n=%d (PR=%d, PD=%d); Age p = %.10g (z=%.4f, coef=%.6f)"
      % (len(s), s["y"].sum(), (1 - s["y"]).sum(), res_a.pvalues["Age_num"],
         res_a.tvalues["Age_num"], res_a.params["Age_num"]))

# (b) likelihood-ratio test for Age in the primary model
red = smf.logit("response ~ BMI_num + C(Gender, Treatment(reference='Female'))",
                data=d).fit(disp=0, maxiter=100)
lr_stat = 2 * (res.llf - red.llf)
lr_p = scipy.stats.chi2.sf(lr_stat, df=1)
print("(b) LRT for Age in primary model: chi2(1) = %.6f, p = %.10g" % (lr_stat, lr_p))
print("    Wald chi2 for Age = %.6f" % (res.tvalues["Age_num"] ** 2))

# ------------------------------------------------------------------ 7. save
out = {
    "software": {"python": sys.version.split()[0],
                 "pandas": pd.__version__, "numpy": np.__version__,
                 "scipy": scipy.__version__, "statsmodels": statsmodels.__version__},
    "n": n, "n_PR": n_pr, "n_nonPR": n - n_pr,
    "n_SD": int((d["Efficacy"] == "SD").sum()), "n_PD": int((d["Efficacy"] == "PD").sum()),
    "primary_age_p_wald": age_p,
    "coefficient_table": coef_tbl.reset_index().rename(columns={"index": "term"}).to_dict("records"),
    "converged": bool(res.mle_retvals["converged"]),
    "iterations": int(res.mle_retvals["iterations"]),
    "deviance": float(dev), "null_deviance": float(dev0),
    "mcfadden_pseudo_r2": float(res.prsquared), "llr_pvalue": float(res.llr_pvalue),
    "vif": {names[i]: float(variance_inflation_factor(X, i)) for i in range(1, len(names))},
    "sensitivity_PRvsPD_age_p": float(res_a.pvalues["Age_num"]),
    "sensitivity_LRT_age_p": float(lr_p), "sensitivity_LRT_chi2": float(lr_stat),
    "answer_age_p_value": float(age_p),
}
with open("out/results.json", "w") as f:
    json.dump(out, f, indent=2)
coef_tbl.to_csv("out/coefficient_table.csv")
print("\nsaved: out/results.json, out/coefficient_table.csv")
print("\nFINAL ANSWER - p-value for age in pooled logistic regression (PR vs non-PR) = %.10g" % age_p)
