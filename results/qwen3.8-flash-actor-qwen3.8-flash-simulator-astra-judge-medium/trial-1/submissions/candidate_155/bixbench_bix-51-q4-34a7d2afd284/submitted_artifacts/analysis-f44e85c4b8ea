"""Primary logistic regression: change in log-odds of remission per 1-year age increase.
Model: rem ~ Age + BMI + GenderMale  (statsmodels GLM, Binomial, Logit link, MLE/IRLS,
standard non-robust SEs from observed Fisher information).
Canary GUID bixbench:5c36:1edd0914-8e2a-45ef-90f4-f410b1f590b4"""
import pandas as pd, numpy as np, openpyxl, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats

# ---------- 1. CLEANING (verified before fit) ----------
raw = pd.read_excel('data/data.xlsx', sheet_name='Sheet1', dtype=object)
print(f"RAW read_excel shape: {raw.shape}  (includes trailing junk)")
ws = openpyxl.load_workbook('data/data.xlsx', data_only=True)['Sheet1']
def blank(v): return v in (None, '') or (isinstance(v, str) and v.strip() == '')
data_rows = [r for r in range(2, ws.max_row+1) if not all(blank(ws.cell(row=r,column=c).value) for c in range(1,13))]
blank_rows = [r for r in range(2, ws.max_row+1) if all(blank(ws.cell(row=r,column=c).value) for c in range(1,13))]
print(f"Dropped rows BEFORE fit: fully-blank = {len(blank_rows)}; whitespace artifact row(s) = "
      f"{[r for r in blank_rows if any(isinstance(ws.cell(row=r,column=c).value,str) and ws.cell(row=r,column=c).value.strip()=='' for c in range(1,13))]}")
print(f"Retained genuine data Excel rows: {len(data_rows)} (rows {data_rows[0]}-{data_rows[-1]})")

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1').iloc[:len(data_rows)].copy()
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
df['BMI'] = pd.to_numeric(df['BMI'], errors='coerce')
print(f"After cleaning: n = {len(df)}; Age dtype = {df.Age.dtype}; Age min/max = {df.Age.min()}-{df.Age.max()}; "
      f"non-integer Age cells = {int(df.Age.isna().sum())}; BMI min/max = {df.BMI.min()}-{df.BMI.max()}")
print("Cleaning did NOT alter values: Age/BMI unchanged vs raw object cells ->",
      bool((df.Age.values == pd.to_numeric(raw['Age'].iloc[:len(data_rows)], errors='coerce').values).all()))

# ---------- 2. VARIABLES (approved definitions) ----------
df['rem'] = (df['Efficacy'] == 'PR').astype(int)          # remission: PR=1, SD/PD=0
df['GenderMale'] = (df['Gender'] == 'Male').astype(int)   # REFERENCE CATEGORY = Female
df['Groups'] = df['Groups'].astype('Int64')
print(f"\nOutcome 'rem': 1=PR (remission), 0=SD/PD.  Events = {int(df.rem.sum())}, "
      f"non-events = {int((1-df.rem).sum())}, n = {len(df)}")
print(f"Predictors complete (Age,BMI,Gender,rem): {int(df[['Age','BMI','GenderMale','rem']].notna().all(axis=1).sum())}/{len(df)} -> 0 dropped")

# ---------- 3. PRIMARY MODEL ----------
m = smf.glm(formula='rem ~ Age + BMI + GenderMale', data=df,
            family=sm.families.Binomial()).fit()          # Logit link, IRLS, non-robust SE
print("\n" + "="*78); print("PRIMARY MODEL  (statsmodels GLM, family=Binomial, link=Logit, MLE/IRLS)"); print("="*78)
print(m.summary())
print(f"\nn = {int(m.nobs)}; events = {int(df.rem.sum())}; non-events = {int((1-df.rem).sum())}")
print(f"Converged: {m.converged}; iterations = {m.fit_history['iteration']}; link = {m.model.family.link}")
print(f"Log-likelihood (null, intercept-only) = {m.null_deviance/ -2 * -1:.4f}" if False else f"LL_null = {-m.null_deviance/2:.4f}; LL_full = {m.llf:.4f}; McFadden pseudo-R2 = {1 - m.llf/(-m.null_deviance/2):.4f}")

b, se = m.params['Age'], m.bse['Age']
ci = m.conf_int().loc['Age']
p = m.pvalues['Age']
print("\n" + "#"*78)
print(f"PRIMARY ANSWER  beta_Age = {b:.6f} log-odds per 1-year increase in age")
print(f"   (holding BMI and Gender fixed; reference gender = Female)")
print(f"   SE = {se:.6f}   95% CI = [{ci[0]:.4f}, {ci[1]:.4f}]   z = {m.tvalues['Age']:.4f}   p = {p:.3e}")
print(f"   OR = exp(beta) = {np.exp(b):.6f}  (95% CI {np.exp(ci[0]):.4f}-{np.exp(ci[1]):.4f})  [supplementary]")
print(f"   Wald test beta_Age=0: chi2 = {m.tvalues['Age']**2:.4f} (df=1), p = {p:.3e}")
print("#"*78)
np.save('analysis/_primary.npy', np.array([b, se, ci[0], ci[1], p]))
m.save('analysis/_primary_model.pkl')
df.to_csv('analysis/_cleaned_data.csv', index=False)


# ---------- 4. DIAGNOSTICS: separation, leverage, goodness of fit ----------
print("\n" + "="*78); print("DIAGNOSTICS"); print("="*78)
# (a) separation: complete/quasi -> infinite coefficients, exploding SEs, non-convergence
print(f"[a] Convergence: converged={m.converged}, iterations={m.fit_history['iteration']}")
print(f"    Max |coef| = {m.params.abs().max():.3f}; max SE = {m.bse.max():.3f}  "
      f"(separation would show |coef|>10 and SE>10s)")
print(f"    All finite: {bool(np.isfinite(m.params).all() and np.isfinite(m.bse).all())}")
import statsmodels.api as _sm
Xp = np.asarray(m.model.exog, float)
lin = Xp @ np.asarray(m.params, float)   # linear predictor (logit)
mu = np.asarray(m.fittedvalues, float)                # fitted probabilities
print(f"    Linear predictor (logit) range: [{lin.min():.3f}, {lin.max():.3f}]")
print(f"    Fitted prob range: [{mu.min():.4f}, {mu.max():.4f}]  "
      f"(strictly inside (0,1), no 0/1 hit -> no perfect separation)")
# Firth-style penalty check via logistic ridge: refit with tiny L2 to confirm stability
m_pen = smf.glm(formula='rem ~ Age + BMI + GenderMale', data=df, family=sm.families.Binomial()).fit_regularized(alpha=1e-6, L1_wt=0.0)
print(f"    Ridge(1e-6) beta_Age = {m_pen.params['Age']:.6f} vs MLE {b:.6f} -> difference {abs(m_pen.params['Age']-b):.2e} (stable, no separation)")
# empty-cell check in Age x Gender x outcome
print(f"    Min cell in Gender x rem table: {int(pd.crosstab(df.Gender, df.rem).values.min())}")
# (b) leverage / influence
from statsmodels.stats.outliers_influence import GLMInfluence
inf = m.get_influence()
lev = inf.hat_matrix_diag
cook = inf.cooks_distance[0]
dff = np.asarray(inf.dfbetas)
print(f"\n[b] Leverage (hat values): mean={lev.mean():.4f} (p/n=4/80=0.050), max={lev.max():.4f}, "
      f"n>2*p/n={int((lev>0.10).sum())}, n>3*p/n={int((lev>0.15).sum())}")
print(f"    Cook's distance: max={cook.max():.4f} (threshold 4/n={4/80:.4f}); n>4/n = {int((cook>4/80).sum())}")
print(f"    Max |DFBETA_Age| = {np.abs(dff[:,1]).max():.4f} (threshold 2/sqrt(n)={2/np.sqrt(80):.4f})")
top = np.argsort(-cook)[:3]
print(f"    Top-3 influential rows (Sequence number): {[int(df['Sequence number'].values[i]) for i in top]}")
# leave-one-out stability of beta_Age
loo = []
for i in range(len(df)):
    d2 = df.drop(df.index[i])
    try: loo.append(smf.glm('rem ~ Age + BMI + GenderMale', data=d2, family=sm.families.Binomial()).fit().params['Age'])
    except Exception: loo.append(np.nan)
loo = np.array(loo, dtype=float)
print(f"    Leave-one-out beta_Age: range [{np.nanmin(loo):.4f}, {np.nanmax(loo):.4f}], mean {np.nanmean(loo):.4f} "
      f"(primary {b:.4f}) -> no single-observation dominance")
# (c) Hosmer-Lemeshow
g = pd.qcut(mu, 10, duplicates='drop')
tab = pd.DataFrame({'y': df.rem.values, 'p': mu, 'g': g}).groupby('g', observed=True)
obs1 = tab.y.sum(); exp1 = tab.p.sum(); n_g = tab.size()
C = len(n_g)
hl = float((((obs1 - exp1)**2) / (exp1*(1-exp1/n_g))).sum())
print(f"\n[c] Hosmer-Lemeshow: chi2({C-2}) = {hl:.4f}, p = {stats.chi2.sf(hl, C-2):.4f}  "
      f"({'no evidence of misfit' if stats.chi2.sf(hl,C-2)>0.05 else 'possible misfit'})")
print(f"    Groups used: {C}; min expected events/cell ok = {bool((exp1.min()>1) and ((n_g-exp1).min()>1))}")
# linearity of age in logit (diagnostic only - NOT altering primary spec)
df['Age2'] = (df.Age - df.Age.mean())**2
m_lin = smf.glm('rem ~ Age + Age2 + BMI + GenderMale', data=df, family=sm.families.Binomial()).fit()
lr = 2*(m_lin.llf - m.llf); p_l = stats.chi2.sf(lr, 1)
print(f"\n[d] Linearity check (diagnostic only, primary spec unchanged): add Age^2 -> "
      f"LRT chi2 = {lr:.4f}, p = {p_l:.4f} ({'no significant nonlinearity' if p_l>0.05 else 'some nonlinearity'})")
# VIF
from statsmodels.stats.outliers_influence import variance_inflation_factor
X = sm.add_constant(df[['Age','BMI','GenderMale']].astype(float))
print(f"\n[e] VIF: " + ", ".join(f"{c}={variance_inflation_factor(X.values, i+1):.3f}" for i,c in enumerate(['Age','BMI','GenderMale'])))
