"""Preparatory inspection of data/data.xlsx (Sheet1). NO regression model is fitted here.
Canary GUID bixbench:5c36:1edd0914-8e2a-45ef-90f4-f410b1f590b4"""
import pandas as pd, numpy as np, openpyxl

SHEET = 'Sheet1'
raw = pd.read_excel('data/data.xlsx', sheet_name=SHEET, dtype=object)
print("raw shape (incl. trailing junk rows):", raw.shape)

# 1) Locate genuine data rows via openpyxl: a row counts if any of 12 cols has non-blank value
wb = openpyxl.load_workbook('data/data.xlsx', data_only=True); ws = wb[SHEET]
data_rows = [r for r in range(2, ws.max_row + 1)
             if any(not (ws.cell(row=r, column=c).value in (None, '') or
                         (isinstance(ws.cell(row=r, column=c).value, str) and
                          ws.cell(row=r, column=c).value.strip() == '')) for c in range(1, 13))]
print("genuine data Excel rows:", len(data_rows), "range", data_rows[0], "-", data_rows[-1])

df = pd.read_excel('data/data.xlsx', sheet_name=SHEET).iloc[:len(data_rows)].copy()
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
df['BMI'] = pd.to_numeric(df['BMI'], errors='coerce')

print("\ncolumns/dtypes:"); print(df.dtypes.to_string())
print("\nmissing per column:"); print(df.isna().sum().to_string())
for c in ['Efficacy', 'Gender']:
    print(f"\n{c} distribution:"); print(df[c].value_counts(dropna=False).to_string())
print("\nAge: n_unique=%d min=%s max=%s mean=%.2f sd=%.2f" % (df.Age.nunique(), df.Age.min(), df.Age.max(), df.Age.mean(), df.Age.std()))
print("BMI: n_unique=%d min=%s max=%s mean=%.2f sd=%.2f" % (df.BMI.nunique(), df.BMI.min(), df.BMI.max(), df.BMI.mean(), df.BMI.std()))
print("\nage banded vs Efficacy:"); print(pd.crosstab(pd.cut(df.Age, [39,50,60,80]), df.Efficacy).to_string())
df['rem_PR'] = (df.Efficacy == 'PR').astype(int)
print("\nremission rate by age tertile:")
print(df.groupby(pd.qcut(df.Age,3), observed=True)['rem_PR'].agg(['mean','size']).round(3).to_string())
print("\ncomplete cases on Age,BMI,Gender,Efficacy:", int(df[['Age','BMI','Gender','Efficacy']].notna().all(axis=1).sum()))
print("MODEL NOT FITTED - preparatory stage only.")
