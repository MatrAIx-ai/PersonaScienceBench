import pandas as pd, numpy as np, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats as st

df = pd.read_csv('analysis/_cleaned_data.csv')
BINFAM = sm.families.Binomial()
PRIMARY = smf.glm('rem ~ Age + BMI + GenderMale', data=df, family=BINFAM).fit()
print("#" * 86)
print("#!!!  DIAGNOSTIC / SENSITIVITY ONLY - THESE ARE NOT THE PRIMARY ANSWER  !!!")
print("#!!!  Primary answer: beta_Age = %+.6f log-odds/year (rem = PR vs SD/PD)" % PRIMARY.params['Age'])
print("#" * 86)


def row(tag, res, term='Age'):
    b, se = res.params[term], res.bse[term]
    ci = res.conf_int().loc[term]
    print(f"{tag:<46s} beta_Age={b:+.6f} SE={se:.6f} "
          f"95%CI[{ci[0]:+.4f},{ci[1]:+.4f}] p={res.pvalues[term]:.2e} n={int(res.nobs)}")


def mc(res, d=df):
    ll0 = smf.glm('rem ~ 1', data=d, family=BINFAM).fit().llf
    return 1 - res.llf / ll0


print("\nS1. Alternative outcome 'disease control' (PR+SD vs PD) -- NOT remission:")
df['dc'] = df['Efficacy'].isin(['PR', 'SD']).astype(int)
row("  dc ~ Age + BMI + GenderMale", smf.glm('dc ~ Age + BMI + GenderMale', data=df, family=BINFAM).fit())

print("\nS2. Gender reference flipped to Male (only intercept/gender term reinterpreted):")
df['GenderFemale'] = (df.Gender == 'Female').astype(int)
alt = smf.glm('rem ~ Age + BMI + GenderFemale', data=df, family=BINFAM).fit()
row("  rem ~ Age + BMI + GenderFemale", alt)
