"""
BixBench bix-51-q8: Simple logistic regression of camrelizumab response on Age.
Reads data/data.xlsx (Sheet1), cleans trailing blank rows and the stray
whitespace cell D122, encodes resp = 1 if Efficacy == 'PR' else 0 (SD/PD),
fits GLM(Binomial, logit): logit P(resp) = b0 + b1 * Age (Age in years, raw).
Outputs coefficients, SE, z, p, OR with Wald and profile-likelihood 95% CIs,
convergence info, and descriptive checks.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.genmod.families import Binomial

# ---------- 1. Load & clean (read-only on source file) ----------
raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print(f"Raw shape read from Sheet1: {raw.shape}")

df = raw.dropna(how="all").copy()          # drop 40 fully-blank trailing rows
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")  # handles stray ' ' (cell D122, already outside data)
print(f"After dropping all-blank rows: n = {len(df)}")
print("Missing per column (analysis variables):")
print(df[["Efficacy", "Age"]].isna().sum().to_string())
df = df[df["Efficacy"].notna() & df["Age"].notna()].copy()   # complete cases; expected no drops
print(f"Complete cases for model: n = {len(df)}")

# ---------- 2. Encode outcome ----------
print("\nEfficacy counts:", df["Efficacy"].value_counts().to_dict())
df["resp"] = df["Efficacy"].eq("PR").astype(int)   # PR -> 1 (response), SD/PD -> 0
print("resp counts (1=PR, 0=SD/PD):", df["resp"].value_counts().to_dict())

# ---------- 3. Descriptives by outcome ----------
desc = df.groupby("resp")["Age"].agg(n="count", mean="mean", median="median",
                                     q1=lambda s: s.quantile(.25),
                                     q3=lambda s: s.quantile(.75),
                                     min="min", max="max").round(3)
print("\nAge descriptives by resp (1=response/PR, 0=SD+PD):")
print(desc.to_string())

# Groups vs outcome collinearity documentation
ct = pd.crosstab(df["Groups"], df["resp"])
print("\nGroups x resp crosstab (why Groups is not adjusted for):")
print(ct.to_string())

# ---------- 4. Fit GLM ----------
X = sm.add_constant(df["Age"].to_numpy(float), has_constant="add")  # [const, Age]
y = df["resp"].to_numpy(int)
model = sm.GLM(y, X, family=Binomial())
res = model.fit()

print("\n================ GLM Binomial(logit): resp ~ Age ================")
print(res.summary())
print("Converged:", res.converged, "| iterations:", res.fit_history["iteration"])

b0, b1 = res.params[0], res.params[1]
se0, se1 = res.bse[0], res.bse[1]
or1 = np.exp(b1)

# Wald 95% CI
wald = res.conf_int(alpha=0.05)
ci_lo_w, ci_hi_w = wald[1]
or_ci_w = (np.exp(ci_lo_w), np.exp(ci_hi_w))

# Profile-likelihood 95% CI for beta1 (likelihood-ratio based), numerically stable
from scipy.optimize import brentq
from scipy.special import expit
from scipy.stats import chi2

AGE_V = df["Age"].to_numpy(float)

def profile_llf(b1_fix):
    """Max log-lik over intercept with slope fixed at b1_fix (stable log1pexp)."""
    def score_int(a):  # d/da of llf; monotone decreasing in a
        return np.sum(y - expit(a + b1_fix * AGE_V))
    a0 = brentq(score_int, -50, 50, xtol=1e-12)
    eta = a0 + b1_fix * AGE_V
    llf = np.sum(y * eta - np.logaddexp(0.0, eta))
    return llf, a0

dev_full = -2 * res.llf
crit = dev_full + chi2.ppf(0.95, 1)   # -2logL threshold for 95% profile CI
f = lambda b: -2 * profile_llf(b)[0] - crit

lo, hi = b1, b1
step = 0.01
while f(lo) <= 0: lo -= step
while f(hi) <= 0: hi += step
ci_lo_pl = brentq(f, lo, b1, xtol=1e-8)
ci_hi_pl = brentq(f, b1, hi, xtol=1e-8)

print("\n---- Key results ----")
print(f"beta0 (intercept) = {b0:.6f}  SE = {se0:.6f}  z = {res.tvalues[0]:.4f}  p = {res.pvalues[0]:.6f}")
print(f"  -> baseline log-odds/odds at Age=0: exp(b0) = {np.exp(b0):.3e} (extrapolated; "
      f"at mean Age=58.5: log-odds = {b0 + b1*58.5:.4f}, odds = {np.exp(b0+b1*58.5):.4f})")
print(f"beta1 (Age, per year) = {b1:.6f}  SE = {se1:.6f}  z = {res.tvalues[1]:.4f}  p = {res.pvalues[1]:.6f}")
print(f"OR = exp(beta1) = {or1:.6f}  (95% CI Wald : {np.exp(ci_lo_w):.4f} - {np.exp(ci_hi_w):.4f})")
print(f"beta1 95% CI Wald: [{ci_lo_w:.6f}, {ci_hi_w:.6f}]")
print(f"beta1 95% CI profile-likelihood: [{ci_lo_pl:.6f}, {ci_hi_pl:.6f}]  -> OR [{np.exp(ci_lo_pl):.4f}, {np.exp(ci_hi_pl):.4f}]")

# ---------- 5. Model-level diagnostics ----------
null = sm.GLM(y, np.ones((len(y), 1)), family=Binomial()).fit()
print("\n---- Fit diagnostics ----")
print(f"Converged: {res.converged}, iterations: {res.fit_history['iteration']}")
print(f"Deviance (full) = {res.deviance:.4f} | Null deviance = {null.deviance:.4f} | "
      f"McFadden pseudo-R2 = {1 - res.deviance/null.deviance:.4f}")
print(f"AIC full = {res.aic:.4f} | AIC null = {null.aic:.4f} | LR chi2 = {null.deviance-res.deviance:.4f} "
      f"(df=1, p = {res.pvalues[1]:.6f})")
print(f"Max |SE| finite & reasonable? SE(beta1)={se1:.6f} (no divergence -> no (quasi)separation)")
print(f"Max fitted prob = {res.fittedvalues.max():.4f}, Min = {res.fittedvalues.min():.4f}")

# Sanity: compare to Logit MLE
lg = sm.Logit(y, X).fit(disp=0)
print(f"Cross-check Logit MLE beta1 = {lg.params[1]:.6f} (GLM: {b1:.6f}); diff = {abs(lg.params[1]-b1):.2e}")
