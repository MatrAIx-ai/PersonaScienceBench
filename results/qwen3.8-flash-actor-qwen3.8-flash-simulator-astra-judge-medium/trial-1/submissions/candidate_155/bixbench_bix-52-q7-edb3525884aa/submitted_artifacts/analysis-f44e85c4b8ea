#!/usr/bin/env python3
"""
BixBench bix-52-q7: How many sites are removed when filtering sites that do not
show >90% or <10% methylation in Zebra Finch?

Confirmed protocol (researcher-approved):
  * Input: data/ZF_AgeRelated_CpG_noMT_Final.csv only (Zebra Finch, "ZF").
    The two Chromosome_Length tables (byte-identical to each other, and
    assembly-inconsistent with the data: '1A'/'4A' missing, 5603 rows with
    StartPosition > Length) and the JD_* file are AUXILIARY and are
    EXPLICITLY NOT USED here.
  * Counting unit = deduplicated CpG site, key = `Pos`
    (verified equivalent to Chromosome + "_" + StartPosition; Start == End).
  * Decision uses MethylationPercentage directly, in its native 0-100 percent
    scale (no /100 conversion). Verified equal to 100*CountMethylated/Coverage
    (max abs diff 4.98e-09).
  * STRICT inequalities: a site OBSERVATION shows extreme methylation iff
    MP > 90 OR MP < 10.  Rows with MP exactly == 10 or exactly == 90 are
    therefore classified as "NOT extreme" and count toward removal.
    (13 rows have MP == 90.0 and 8 rows have MP == 10.0 -> 21 boundary rows;
     the impact of this choice is reported as a sensitivity line.)
  * NO minimum-Coverage filter is applied (only the extreme-methylation filter
    is part of the question). Coverage<10 record count is reported as a
    limitation only.
  * Chromosome arms are kept as-is: '1A'/'4A' are NOT merged into '1'/'4'.
  * PRIMARY AGGREGATION RULE = B (per researcher ruling):
      keep a site if AT LEAST ONE of its observations is extreme;
      remove it only if ALL of its observations lie in [10, 90].
    Rules A (all observations extreme) and C (site mean then judge) are
    reported ONLY as sensitivity contrasts, NOT as the answer.
"""
from pathlib import Path
import pandas as pd

DATA = Path(__file__).resolve().parents[1] / "data" / "ZF_AgeRelated_CpG_noMT_Final.csv"
HI, LO = 90.0, 10.0  # native percent scale, strict inequalities


def main() -> int:
    df = pd.read_csv(DATA, dtype={"Chromosome": str})

    n_rows = len(df)
    n_sites = df["Pos"].nunique()

    # ---- row-level extreme call (strict inequalities) -------------------
    mp = df["MethylationPercentage"]
    df["hi"] = mp > HI          # strictly greater than 90
    df["lo"] = mp < LO          # strictly less than 10
    df["extreme"] = df["hi"] | df["lo"]

    rows_hi = int(df["hi"].sum())
    rows_lo = int(df["lo"].sum())
    rows_ext = int(df["extreme"].sum())
    rows_bound = int(((mp == HI) | (mp == LO)).sum())

    print("== Sanity checks (expected 1140 sites / 19698 rows) ==")
    print(f"  records (rows)                 : {n_rows}")
    print(f"  unique sites (Pos)             : {n_sites}")
    print(f"  unique Chromosome+Start        : "
          f"{(df['Chromosome'].astype(str) + '_' + df['StartPosition'].astype(str)).nunique()}")
    print(f"  Start == End everywhere        : {bool((df.StartPosition == df.EndPosition).all())}")
    print(f"  missing values (all columns)   : {int(df.isna().sum().sum())}")
    print(f"  MP range                       : {mp.min()} .. {mp.max()}")
    print(f"  records with Coverage < 10     : {int((df.Coverage < 10).sum())}  (limitation only; no filter applied)")
    print()
    print("== Row-level (observation-level) counts -- contrast only ==")
    print(f"  rows MP > 90                   : {rows_hi}")
    print(f"  rows MP < 10                   : {rows_lo}")
    print(f"  rows extreme (>90 or <10)      : {rows_ext}")
    print(f"  rows MP == 90 or == 10 (boundary): {rows_bound}")
    print()

    # ---- site-level aggregation ----------------------------------------
    g = df.groupby("Pos", sort=False)
    site = pd.DataFrame({
        "n_obs": g.size(),
        "n_hi": g["hi"].sum(),
        "n_lo": g["lo"].sum(),
        "n_extreme": g["extreme"].sum(),
        "mean_mp": g["MethylationPercentage"].mean(),
    })
    site["any_ext"] = site["n_extreme"] > 0                     # rule B keep
    site["all_ext"] = site["n_extreme"] == site["n_obs"]        # rule A keep
    site["mean_ext"] = (site["mean_mp"] > HI) | (site["mean_mp"] < LO)  # rule C keep

    # ---- PRIMARY: rule B ----------------------------------------------
    keep_B = int(site["any_ext"].sum())
    removed_B = int((~site["any_ext"]).sum())
    removed_sites = site.index[~site["any_ext"]]

    # decomposition of kept sites
    only_hi = int(((site["n_hi"] > 0) & (site["n_lo"] == 0)).sum())
    only_lo = int(((site["n_lo"] > 0) & (site["n_hi"] == 0)).sum())
    both = int(((site["n_hi"] > 0) & (site["n_lo"] > 0)).sum())

    print("== PRIMARY ANSWER -- rule B (keep if ANY observation is extreme) ==")
    print(f"  original sites                 : {n_sites}")
    print(f"  sites kept                     : {keep_B}")
    print(f"  sites REMOVED                  : {removed_B}")
    print(f"  kept-site decomposition: only>90 = {only_hi} | only<10 = {only_lo} "
          f"| both = {both} | sum = {only_hi + only_lo + both} (== kept: {only_hi + only_lo + both == keep_B})")
    print()

    # ---- self-checks ----------------------------------------------------
    removed_df = df[df["Pos"].isin(removed_sites)]
    all_in_range = bool((removed_df["MethylationPercentage"] >= LO).all()
                        and (removed_df["MethylationPercentage"] <= HI).all())
    print("== Self-checks ==")
    print(f"  every observation of every removed site has 10 <= MP <= 90 : {all_in_range} "
          f"(removed-site MP min={removed_df.MethylationPercentage.min()}, "
          f"max={removed_df.MethylationPercentage.max()})")
    print(f"  kept + removed == {keep_B} + {removed_B} = {keep_B + removed_B} "
          f"(== {n_sites} unique sites: {keep_B + removed_B == n_sites})")
    print(f"  every kept site has >=1 extreme row : "
          f"{bool((site.loc[site['any_ext'], 'n_extreme'] >= 1).all())}")
    print()

    # ---- boundary sensitivity (inclusive inequalities) -----------------
    inc_hi = mp >= HI
    inc_lo = mp <= LO
    tmp = df.assign(any_inc=(inc_hi | inc_lo).values)
    keep_inc = int(tmp.groupby("Pos", sort=False)["any_inc"].any().sum())
    removed_inc = int(n_sites - keep_inc)
    print("== Boundary sensitivity (if MP == 10 / == 90 were counted as extreme) ==")
    print(f"  removed would be {removed_inc} (vs {removed_B}); "
          f"difference = {removed_B - removed_inc} site(s), driven by the {rows_bound} boundary rows")
    print()

    # ---- rules A and C : sensitivity contrasts, NOT the answer ---------
    keep_A = int(site["all_ext"].sum());  rem_A = int(n_sites - keep_A)
    keep_C = int(site["mean_ext"].sum()); rem_C = int(n_sites - keep_C)
    print("== Sensitivity contrasts (NOT the answer) ==")
    print(f"  rule A (ALL obs extreme):  kept {keep_A:5d}  removed {rem_A:5d}")
    print(f"  rule C (site mean judged): kept {keep_C:5d}  removed {rem_C:5d}")
    print(f"  rule B (PRIMARY)         : kept {keep_B:5d}  removed {removed_B:5d}")
    print(f"  removed-site obs records : {len(removed_df)} rows "
          f"({100.0 * len(removed_df) / n_rows:.2f}% of all records)")

    print()
    print(f"FINAL ANSWER (rule B): {removed_B} sites removed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
