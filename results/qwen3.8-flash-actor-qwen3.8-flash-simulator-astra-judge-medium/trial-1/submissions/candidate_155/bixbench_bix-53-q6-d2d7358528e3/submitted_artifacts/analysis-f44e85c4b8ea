"""FINAL DE run (equivalent NB GLM, bootstrap-calibrated dispersion, inflate=2.2).
K = baseline, contrast = W vs K. Produces the DE tables, the filter funnel, the
shrunk-log2FC candidate list (raw-LFC list for comparison) and leave-one-out tables.
"""
import json, sys
import numpy as np, pandas as pd
sys.path.insert(0, "analysis")
from deseq_lite import run_de, funnel_lines, em_prior_sd

OUT = "analysis/tables"; K = ["KL1", "KL2", "KL3"]; W = ["WL1", "WL2", "WL3"]
INFL = 2.2
log = []
def say(*a):
    s = " ".join(str(x) for x in a); log.append(s); print(s, flush=True)

df = pd.read_csv("data/count.csv", dtype={"geneID": str})
samples = list(df.columns[1:]); gene = df.geneID.values
Y = df[samples].astype(float).values

tab, meta = run_de(Y, K, W, samples, disp_inflate=INFL)
tab.insert(0, "geneID", gene)
say("== FINAL MODEL: equivalent NB GLM, disp_inflate=%.1f, contrast W vs K ==" % INFL)
for k, v in meta.items(): say("   ", k, "=", v)

b10 = tab.baseMean > 10; ps = tab.pvalue < 0.05
sl = tab.log2FC_shrunk.abs() > 1; rl = tab.log2FC_raw.abs() > 1
cand = tab[b10 & ps & sl].sort_values("pvalue")
rawl = tab[b10 & ps & rl].sort_values("pvalue")
tab.to_csv(f"{OUT}/de_results_WvsK_final.tsv", sep="\t", index=False)
cand.to_csv(f"{OUT}/candidate_DE_genes_calibrated.tsv", sep="\t", index=False)
rawl.to_csv(f"{OUT}/candidate_DE_genes_rawLFC.tsv", sep="\t", index=False)
tab.loc[b10, ["geneID", "baseMean"]].to_csv(f"{OUT}/background_baseMean_gt10.tsv", sep="\t", index=False)
tab[["geneID"]].to_csv(f"{OUT}/background_genome_all.tsv", sep="\t", index=False)

funnel = {"total_genes": int(len(tab)),
          "step1_baseMean_gt_10": int(b10.sum()),
          "step2_plus_pvalue_lt_0.05": int((b10 & ps).sum()),
          "step3_plus_abs_shrunk_LFC_gt_1": int((b10 & ps & sl).sum()),
          "alt_step3_with_raw_LFC": int((b10 & ps & rl).sum()),
          "raw_candidates_lost_by_shrinkage": int((b10 & ps & rl & ~sl).sum()),
          "candidates_gained_by_shrinkage": int((b10 & ps & sl & ~rl).sum()),
          "note_padj_lt_0.05_variant": int((b10 & (tab.padj_BH < 0.05) & sl).sum())}
say("\n== FILTER FUNNEL =="); [say("  ", k, "=", v) for k, v in funnel.items()]
say("\nTop 12 candidates:")
say(cand.head(12)[["geneID","baseMean","norm_mean_K","norm_mean_W","log2FC_raw","log2FC_shrunk","lfcSE_shrunk","pvalue","padj_BH"]].to_string(index=False))
say("candidate n =", len(cand), "| higher in W =", int((cand.log2FC_shrunk > 0).sum()),
    "| lower in W =", int((cand.log2FC_shrunk < 0).sum()))
say("median |shrinkage| applied to raw LFC among baseMean>10:",
    round(float(np.median(1 - (tab.log2FC_shrunk[b10].abs() / tab.log2FC_raw[b10].abs().replace(0, np.nan)))), 4))

res = {"meta": meta, "funnel": funnel, "n_candidates": int(len(cand)),
       "n_candidates_rawLFC": int(len(rawl))}
say("\n== LEAVE-ONE-OUT (3 vs 2) ==")
loo = {}
for drop in ["KL3", "WL3"]:
    keep = [s for s in samples if s != drop]
    Yi = Y[:, [samples.index(s) for s in keep]]
    t2, m2 = run_de(Yi, [c for c in K if c != drop], [c for c in W if c != drop], keep, disp_inflate=INFL)
    t2.insert(0, "geneID", gene)
    t2.to_csv(f"{OUT}/de_results_WvsK_LOO_drop_{drop}.tsv", sep="\t", index=False)
    cm = (t2.baseMean > 10) & (t2.pvalue < 0.05) & (t2.log2FC_shrunk.abs() > 1)
    A, B = set(cand.geneID), set(t2[cm].geneID)
    jac = len(A & B) / max(len(A | B), 1)
    loo[drop] = dict(n_candidates=int(cm.sum()), jaccard_vs_full=round(jac, 3),
                     prior_sd_normal=round(m2["prior_sd_normal"], 4))
    say(f"  drop {drop}: candidates={int(cm.sum())} (full {len(cand)}) jaccard={jac:.3f}")
res["loo"] = loo
with open(f"{OUT}/final_de_summary.json", "w") as fh: json.dump(res, fh, indent=2, default=str)
open("analysis/12_final_de_log.txt", "w").write("\n".join(log) + "\n")
say("\nDONE")
