"""READY-TO-RUN enrichment step (NOT executed here: no network, no gseapy).

Run this on a machine with network access + `pip install gseapy mygene`.
It uses ONLY the KEGG_2019_Mouse library, as required, and performs an enrichment
(gseapy.enrich), not a ranked GSEA.

Required prerequisite that this environment could not satisfy:
  ENSMUSG (Ensembl gene ID) -> gene symbol, because KEGG_2019_Mouse gene sets are
  lists of symbols while count.csv only carries Ensembl IDs.
  Either let the script query mygene, or pass a pre-built two-column TSV:
      python3 analysis/15_enrichment_gseapy_ready.py my_map.tsv
Nothing about the ranking or the DE input is changed by this script.
"""
import sys, os
import pandas as pd

CAND = "analysis/tables/candidate_DE_genes_calibrated.tsv"
BG_EXPR = "analysis/tables/background_baseMean_gt10.tsv"
BG_ALL = "analysis/tables/background_genome_all.tsv"
ORDER = ["Adjusted P-value", "P-value", "Odds Ratio", "Gene Size"]   # ties -> alphabetical Term


def to_symbols(ids, map_tsv=None):
    if map_tsv and os.path.exists(map_tsv):
        m = pd.read_csv(map_tsv, sep="\t", header=None, names=["ensembl", "symbol"])
        return dict(zip(m.ensembl, m.symbol))
    import mygene                                            # requires network
    mg = mygene.MyGeneInfo()
    res = mg.querymany(list(ids), scopes="ensembl.gene", fields="symbol",
                       species="mouse", as_dataframe=True)
    return {i: r.get("symbol") for i, r in res.to_dict("index").items()}


def run(term_gene_sets, query, background, label):
    import gseapy
    enr = gseapy.enrich(gene_list=query, gene_sets=term_gene_sets,
                        background=background, outdir=None, min_size=5, max_size=500)
    r = enr.results.copy()
    r["Overlap"] = r["Overlapped"].astype(str) + "/" + r["Background"].astype(str)
    r = r.sort_values(ORDER + ["Term"], ascending=[True, True, False, False, True])
    print(f"\n### {label} (query n={len(query)}, background n={len(background)})")
    print(r[["Term", "P-value", "Adjusted P-value", "Odds Ratio", "Combined Score",
             "Overlapped", "Gene Size", "Overlap"]].head(10).to_string(index=False))
    return r


def main():
    import gseapy
    lib = "KEGG_2019_Mouse"
    ids = pd.read_csv(CAND, sep="\t").geneID.tolist()
    sym = to_symbols(ids + pd.read_csv(BG_EXPR, sep="\t").geneID.tolist()
                     + pd.read_csv(BG_ALL, sep="\t").geneID.tolist())
    q = sorted({sym[i] for i in ids if sym.get(i)})
    bg_e = sorted({sym[i] for i in pd.read_csv(BG_EXPR, sep="\t").geneID if sym.get(i)})
    bg_a = sorted({sym[i] for i in pd.read_csv(BG_ALL, sep="\t").geneID if sym.get(i)})
    print(f"symbols resolved: query {len(q)}/{len(ids)}, expressed-bg {len(bg_e)}, all-bg {len(bg_a)}")
    run(lib, q, bg_e, "PRIMARY: KEGG_2019_Mouse, expressed background (baseMean>10)")
    run(lib, q, bg_a, "SENSITIVITY: KEGG_2019_Mouse, whole-genome background")


if __name__ == "__main__":
    main()
