"""
CHIP variants per sample after excluding intronic / intergenic / UTR variants.
Fixed rulings (researcher-approved):
  * Zygosity: keep only {Heterozygous, Homozygous Variant}; drop Reference and blank (no-call).
  * Exclusion SO set: intron_variant, intergenic_variant, 3_prime_UTR_variant,
    5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant
  * Retain splice_region_variant and upstream_gene_variant (reported as sensitivity).
  * Unit = row (duplicates / multi-allelic rows count separately); denominator = 86 workbooks.
  * No ClinVar-based filtering, no gene-membership filtering, trio file unused for the denominator.
"""
import glob, os, json, collections
import numpy as np
import pandas as pd

DATA_DIR = 'data/CHIP_DP10_GQ20_PASS'
EXCL_MAIN = {'intron_variant', 'intergenic_variant', '3_prime_UTR_variant',
             '5_prime_UTR_variant', '5_prime_UTR_premature_start_codon_gain_variant'}
ALT_ZYG = {'Heterozygous', 'Homozygous Variant'}

def parse(path):
    """Two-row header; row 2 gives column names, row 1 gives block labels (sample name)."""
    import openpyxl
    wb = openpyxl.load_workbook(path, data_only=True)
    ws = wb.worksheets[0]
    rows = list(ws.iter_rows(values_only=True))
    block, cols = rows[0], rows[1]
    sample_block = str(block[4])                      # e.g. 'Proband (179-P1)'
    role = sample_block.split(' (')[0].strip()
    header_name = sample_block.split('(')[1].rstrip(')').strip() if '(' in sample_block else None
    names, seen = [], {}
    for c in cols:
        c = str(c).strip() if c is not None else 'unnamed'
        seen[c] = seen.get(c, 0) + 1
        names.append(c if seen[c] == 1 else f'{c}__{seen[c]}')
    df = pd.DataFrame([r for r in rows[2:] if any(v is not None for v in r)], columns=names)
    return df, role, header_name, ws.title

def so_tokens(val):
    """Defensive multi-term handling; corpus contains none, branch tracked by caller."""
    return [t.strip() for t in str(val).replace('&', ',').replace('|', ',').split(',') if t.strip()]

files = sorted(glob.glob(os.path.join(DATA_DIR, '*.xlsx')))
assert len(files) == 86, len(files)

records, per_sample, audit = [], [], collections.Counter()
failed = []
for path in files:
    sid = os.path.basename(path).split('_')[-1].replace('.xlsx', '')
    try:
        df, role, header_name, sheet = parse(path)
    except Exception as exc:                                   # never merged silently
        failed.append((sid, repr(exc)))
        continue
    assert header_name == sid, (sid, header_name)
    so = df['Sequence Ontology (Combined)']
    assert so.notna().all() and (so.astype(str).str.strip() != '').all()
    # multi-term branch
    multi = [v for v in so if len(so_tokens(v)) > 1]
    audit['multi_term_cells'] += len(multi)
    excl_flag = so.map(lambda v: bool(set(so_tokens(v)) & EXCL_MAIN))      # exclude if ANY term excluded
    zyg = df['Zygosity'].astype('object').where(df['Zygosity'].notna(), None)
    alt = df['Zygosity'].isin(ALT_ZYG)
    keep = alt & ~excl_flag
    audit['rows_total'] += len(df)
    audit['rows_blank_zygosity'] += int(df['Zygosity'].isna().sum())
    audit['rows_reference'] += int((df['Zygosity'] == 'Reference').sum())
    audit['rows_alt'] += int(alt.sum())
    audit['rows_excluded_SO_main'] += int(excl_flag.sum())
    audit['rows_excluded_SO_main_among_alt'] += int((excl_flag & alt).sum())
    for term in so:
        audit['SO_all::' + str(term)] += 1
    for t, k in zip(so, keep):
        audit['SO_kept::' + str(t)] += int(k)
    for t, k in zip(so, excl_flag):
        audit['SO_excluded::' + str(t)] += int(k)
    audit['splice_region_kept'] += int((so == 'splice_region_variant').sum())
    audit['upstream_kept'] += int((so == 'upstream_gene_variant').sum())
    audit['utr_psc_rows_all'] += int((so == '5_prime_UTR_premature_start_codon_gain_variant').sum())
    audit['utr_psc_rows_alt'] += int(((so == '5_prime_UTR_premature_start_codon_gain_variant') & alt).sum())
    audit['offlist_gene_rows'] += int(df['Gene Names'].isin(['MMAB', 'MMACHC', 'SF3B2']).sum())
    audit['in_chip_true'] += int((df['In_CHIP'] == 'True').sum())
    audit['classification_blank'] += int(df['Classification'].isna().sum())
    audit['classification_kept::' + ''] += 0
    for c in df.loc[keep, 'Classification'].fillna('<blank>'):
        audit['CL_kept::' + str(c)] += 1
    audit['dup_pos_alt_rows'] += int(df.duplicated(['Chr:Pos', 'Ref/Alt']).sum())

    per_sample.append(dict(
        sample=sid, role=role, group=('SRR' if sid.startswith('SRR') else 'family'),
        total_rows=len(df), alt_rows=int(alt.sum()),
        main_count=int(keep.sum()),
        allrows_exclSO=int((~excl_flag).sum()),
        main_excl_splice=int((keep & (so != 'splice_region_variant')).sum()),
        main_excl_splice_upstream=int((keep & (so != 'splice_region_variant') & (so != 'upstream_gene_variant')).sum()),
        unique_pos_alt=int(df.loc[keep, ['Chr:Pos', 'Ref/Alt']].drop_duplicates().shape[0]),
        unique_pos_only=int(df.loc[keep, 'Chr:Pos'].drop_duplicates().shape[0]),
        classification_blank_kept=int(df.loc[keep, 'Classification'].isna().sum()),
    ))
    records.append(df.loc[keep, 'Sequence Ontology (Combined)'])

if failed:
    print('FILES THAT FAILED TO PARSE:'); [print('  ', *f) for f in failed]
else:
    print('All 86 files parsed successfully; 0 skipped, 0 failures.')

ps = pd.DataFrame(per_sample)
N = len(ps)
assert N == 86

def stats(col):
    v = ps[col].astype(float)
    return dict(n=int(len(v)), total=float(v.sum()), mean=float(v.mean()), median=float(v.median()),
                min=int(v.min()), max=int(v.max()), zeros=int((v == 0).sum()))

main = stats('main_count')
print('\n=== MAIN ANSWER ===')
print(f"sum over samples = {main['total']:.0f}; N = {main['n']}; mean = {main['mean']:.1f}; "
      f"median = {main['median']:.1f}; min = {main['min']}; max = {main['max']}; zero-count samples = {main['zeros']}")

print('\n=== PER-SAMPLE TABLE ===')
print(ps[['sample','role','group','total_rows','alt_rows','main_count']].to_string(index=False))
print('\nGroup means (main count):')
print(ps.groupby('group')['main_count'].agg(['count','sum','mean','median','min','max']).round(2).to_string())
print('\nRole means (main count):')
print(ps.groupby('role')['main_count'].agg(['count','mean','median','min','max']).round(2).to_string())
print('\nGroup x Role means:')
print(ps.pivot_table(index='role', columns='group', values='main_count', aggfunc=['count','mean']).round(2).to_string())

SENS = [('MAIN: alt-carrying rows, excl intron/intergenic/UTR(+5UTR-PSG)', 'main_count'),
        ('A: ALL rows (incl. Reference/no-call), same SO exclusion [NOT the answer]', 'allrows_exclSO'),
        ('B: MAIN + also exclude splice_region_variant', 'main_excl_splice'),
        ('C: MAIN + also exclude splice_region_variant and upstream_gene_variant', 'main_excl_splice_upstream'),
        ('D: MAIN but counted as unique Chr:Pos + Ref/Alt', 'unique_pos_alt'),
        ('E: MAIN but counted as unique Chr:Pos (multi-allelic sites collapsed)', 'unique_pos_only')]
print('\n=== SENSITIVITY ===')
rows = []
for lab, col in SENS:
    s = stats(col)
    rows.append(dict(variant=lab, total=s['total'], mean=round(s['mean'], 1),
                     pct_diff_vs_main=round(100*(s['mean']-main['mean'])/main['mean'], 1),
                     median=s['median'], min=s['min'], max=s['max']))
sens = pd.DataFrame(rows)
print(sens.to_string(index=False))

print('\n=== AUDIT ===')
print('multi-term SO cells triggering the exclusion branch:', audit['multi_term_cells'])
print('rows total: %d | alt-carrying: %d | Reference: %d | blank Zygosity (no-call) excluded: %d'
      % (audit['rows_total'], audit['rows_alt'], audit['rows_reference'], audit['rows_blank_zygosity']))
print('rows excluded by SO set (all rows): %d ; of those, alt-carrying: %d'
      % (audit['rows_excluded_SO_main'], audit['rows_excluded_SO_main_among_alt']))
print('5_prime_UTR_premature_start_codon_gain_variant rows: all=%d, alt-carrying=%d'
      % (audit['utr_psc_rows_all'], audit['utr_psc_rows_alt']))
print('retained by ruling: splice_region_variant=%d, upstream_gene_variant=%d'
      % (audit['splice_region_kept'], audit['upstream_kept']))
print('In_CHIP==True rows: %d ; blank ClinVar Classification rows: %d ; exact (Chr:Pos,Ref/Alt) dup rows: %d ; MMAB/MMACHC/SF3B2 rows: %d'
      % (audit['in_chip_true'], audit['classification_blank'], audit['dup_pos_alt_rows'], audit['offlist_gene_rows']))
print('\nSO distribution of MAIN retained rows (n=%d):' % main['total'])
kept = pd.concat(records)
for t, c in kept.value_counts().items():
    print(f'  {c:6d} ({100*c/main["total"]:5.2f}%)  {t}')
print('\nSO distribution of ALL rows (context, n=%d):' % audit['rows_total'])
for t, c in sorted(audit['SO_all::'].items() if False else [(k.split('::',1)[1], v) for k,v in audit.items() if k.startswith('SO_all::')], key=lambda x: -x[1]):
    print(f'  {c:6d}  {t}')
print('\nClinVar Classification background (kept rows only, NO filtering applied):')
for k, v in sorted([(k.split('::',1)[1], v) for k, v in audit.items() if k.startswith('CL_kept::')], key=lambda x: -x[1]):
    print(f'  {v:6d}  {k}')
print('blank Classification among kept rows: %d (kept regardless)' % ps['classification_blank_kept'].sum())

ps.to_csv('analysis/per_sample_counts.csv', index=False)
sens.to_csv('analysis/sensitivity.csv', index=False)
json.dump(dict(main=main, groups=ps.groupby('group')['main_count'].mean().round(3).to_dict(),
               roles=ps.groupby('role')['main_count'].mean().round(3).to_dict(),
               audit={k: v for k, v in audit.items() if not k.startswith('SO_all::')},
               kept_SO=kept.value_counts().to_dict(), failed=failed),
          open('analysis/results.json', 'w'), indent=2)
print('\nwrote analysis/per_sample_counts.csv, analysis/sensitivity.csv, analysis/results.json')
