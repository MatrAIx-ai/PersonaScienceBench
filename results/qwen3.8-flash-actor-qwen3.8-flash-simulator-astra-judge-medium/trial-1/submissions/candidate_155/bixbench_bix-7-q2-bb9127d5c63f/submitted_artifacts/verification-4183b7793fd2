"""Independent re-implementation (pandas reader instead of openpyxl) as a cross-check."""
import glob, pandas as pd
EX = {'intron_variant','intergenic_variant','3_prime_UTR_variant','5_prime_UTR_variant',
      '5_prime_UTR_premature_start_codon_gain_variant'}
tot=0; n=0; per={}
for f in sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx')):
    raw = pd.read_excel(f, header=None, skiprows=2, dtype=str)   # positional: col4 Zyg, col13 SO
    m = (raw[4].isin(['Heterozygous','Homozygous Variant'])) & (~raw[13].isin(EX))
    sid=f.split('_')[-1].replace('.xlsx',''); per[sid]=int(m.sum()); tot+=int(m.sum()); n+=1
print('files',n,'sum',tot,'mean %.4f'%(tot/n),'min',min(per.values()),'max',max(per.values()))
ref=pd.read_csv('analysis/per_sample_counts.csv').set_index('sample')['main_count']
diff={k:(v,int(ref[k])) for k,v in per.items() if int(ref[k])!=v}
print('disagreements vs primary script:',diff)
