"""Final count of CHIP variants remaining after removing reference calls (bix-7-q3).

Researcher-fixed decisions:
  * unit of count  = one row of a CHIP table = one variant call of one sample (file)
  * reference call = Zygosity == "Reference" (only); empty Zygosity = no call -> KEPT
  * CHIP set       = all rows of the ready CHIP tables (In_CHIP == True);
                     Schenz et al. 2022 gene list (56 genes) = cross-check only
  * duplicates     : intra-file full duplicates are kept (each row = one call)
  * parsing        : full loader mandatory (broken sheet dimension in 84/86 files makes
                     openpyxl read_only return a 1x1 sheet)
Outputs: printed checksums + analysis/chip_summary.csv
"""
import glob, os, re, collections
import pandas as pd
import openpyxl

CHIP_DIR = "data/CHIP_DP10_GQ20_PASS"
TRIO_XLSX = "data/230215_Trio_Status.xlsx"
GENES_XLSX = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
OUT_CSV = "analysis/chip_summary.csv"

EXPECTED = dict(files=86, total_rows=57258, reference=44211, heterozygous=7303,
                homozygous=4593, empty=1151)

files = sorted(glob.glob(os.path.join(CHIP_DIR, "*.xlsx")))
print(f"[CK1] CHIP variant files found: {len(files)} (expected {EXPECTED['files']}) "
      f"-> {'OK' if len(files) == EXPECTED['files'] else 'MISMATCH'}")

# ---- Trio_Status: role attribution / cross-check only (no filtering) ----------
trio = pd.read_excel(TRIO_XLSX)
role_of = dict(zip(trio["Sample ID"].astype(str).str.strip(),
                   trio["Status"].astype(str).str.strip()))
print(f"[info] Trio_Status rows={len(trio)}, statuses={dict(collections.Counter(role_of.values()))}; "
      f"no Cancer/BLM filtering applied")

records, role_mismatch, empty_files = [], [], []
zy_all, in_chip, gene_tokens = collections.Counter(), collections.Counter(), collections.Counter()
total_rows = dup_intra_kept = dedup_rows = 0
keys_all, nonref_keys = [], set()

for path in files:
    fname = os.path.basename(path)
    sid = re.match(r".*CHIP_(.+)\.xlsx$", fname).group(1)

    # row 1 = group header (carries sample role + id); row 2 = field names
    grp = [str(v) for v in pd.read_excel(path, header=0, nrows=0).columns]
    hits = [x for x in grp if re.match(r"^(Proband|Father|Mother|Child)\s*\(", x)]
    assert len(hits) == 1, (fname, hits)
    role, sid_hdr = hits[0][:-1].split(" (")
    assert sid_hdr == sid, (sid_hdr, sid)

    df = pd.read_excel(path, header=1)          # FULL loader, not read_only
    if len(df) == 0:
        empty_files.append(fname)
    assert len(df.columns) == 33 and list(df.columns).count("Zygosity") == 1, fname

    zy = df["Zygosity"]
    zy_str = zy.astype("object").where(zy.notna(), "")      # NA -> "" = no call
    vc = collections.Counter(zy_str)
    zy_all.update(vc)
    total_rows += len(df)
    in_chip.update(df["In_CHIP"].astype(str).value_counts().to_dict())
    dedup_rows += len(df.drop_duplicates())

    keys = (df["Chr:Pos"].astype(str) + "_" + df["Ref/Alt"].astype(str)).tolist()
    dup_intra_kept += len(keys) - len(set(keys))
    keys_all += keys
    nonref_keys.update(k for k, z in zip(keys, zy_str.tolist()) if z != "Reference")

    for tok in df["Gene Names"].dropna().astype(str):
        for t in tok.split(","):
            if t.strip():
                gene_tokens[t.strip()] += 1

    trio_role = role_of.get(sid if sid.startswith("SRR") else re.sub(r"-(P1|P2|P|PF|PM)$", "", sid))
    ok = ((role in ("Proband",) and trio_role in ("Patient", "Child"))
          or (role == "Child" and trio_role == "Child")
          or (role == "Father" and trio_role == "Father")
          or (role == "Mother" and trio_role == "Mother"))
    if not ok:
        role_mismatch.append((fname, role, trio_role))

    records.append(dict(file=fname, sample_id=sid, role=role, trio_status=trio_role,
                        rows=len(df), reference=vc.get("Reference", 0),
                        heterozygous=vc.get("Heterozygous", 0),
                        homozygous_variant=vc.get("Homozygous Variant", 0),
                        empty_call=vc.get("", 0),
                        remaining=len(df) - vc.get("Reference", 0)))

summary = pd.DataFrame(records).sort_values("sample_id").reset_index(drop=True)
summary.to_csv(OUT_CSV, index=False)

# ---- checksums ---------------------------------------------------------------
ref = zy_all.get("Reference", 0)
het, hom = zy_all.get("Heterozygous", 0), zy_all.get("Homozygous Variant", 0)
empty = zy_all.get("", 0)
removed, remaining = ref, total_rows - ref
alt_remaining = het + hom

print(f"[CK2] total rows (variant calls) = {total_rows} (expected {EXPECTED['total_rows']}) "
      f"-> {'OK' if total_rows == EXPECTED['total_rows'] else 'MISMATCH'}")
print(f"[CK3] files contributing 0 rows: {len(empty_files)} {empty_files}")
ok4 = (ref, het, hom, empty) == (EXPECTED["reference"], EXPECTED["heterozygous"],
                                 EXPECTED["homozygous"], EXPECTED["empty"])
print(f"[CK4] Zygosity breakdown Reference={ref} Het={het} Hom={hom} empty/no-call={empty} "
      f"(pre-scan {EXPECTED['reference']}/{EXPECTED['heterozygous']}/{EXPECTED['homozygous']}/{EXPECTED['empty']}) "
      f"-> {'OK' if ok4 else 'MISMATCH'}")
print(f"[CK5] removed(reference) + remaining = {removed} + {remaining} = {removed + remaining} "
      f"== total {total_rows} -> {'OK' if removed + remaining == total_rows else 'MISMATCH'}")

ref2 = tot2 = 0                                   # independent re-count, no pandas
for path in files:
    wb = openpyxl.load_workbook(path, data_only=True)
    ws = wb[wb.sheetnames[0]]
    rows = list(ws.iter_rows(values_only=True))
    wb.close()
    zi = [str(h) for h in rows[1]].index("Zygosity")
    tot2 += len(rows) - 2
    ref2 += sum(1 for r in rows[2:] if str(r[zi]) == "Reference")
print(f"[CK6] independent openpyxl re-count: rows={tot2}, Reference={ref2} "
      f"-> {'OK' if (tot2, ref2) == (total_rows, removed) else 'MISMATCH'}")

rs = summary["rows"].tolist()
print(f"[CK7] per-file rows: n={len(rs)}, min={min(rs)}, max={max(rs)}, mean={sum(rs)/len(rs):.1f}")
print(f"[CK8] sum(remaining over files)={summary['remaining'].sum()} == {remaining} "
      f"-> {'OK' if summary['remaining'].sum() == remaining else 'MISMATCH'}")
for c, exp in (("rows", total_rows), ("reference", removed), ("heterozygous", het),
               ("homozygous_variant", hom), ("empty_call", empty)):
    v = int(summary[c].sum())
    print(f"       [CK8b] column-sum {c} = {v} -> {'OK' if v == exp else 'MISMATCH'}")
print(f"[CK9] header role vs Trio_Status mismatches: {len(role_mismatch)} {role_mismatch[:5]}")
print(f"[info] In_CHIP values: {dict(in_chip)}")

genes = set(pd.read_excel(GENES_XLSX)["ABL1"].dropna().astype(str)) | {"ABL1"}
out_tokens = {t: n for t, n in gene_tokens.items() if t not in genes}
print(f"[info] Schenz gene list = {len(genes)} genes; gene tokens outside it (kept in set): "
      f"{sorted(out_tokens.items(), key=lambda x: -x[1])}")
print(f"[info] unique variant positions (union of files) = {len(set(keys_all))}; "
      f"non-Reference positions seen in >=1 sample = {len(nonref_keys)}")
print(f"[info] intra-file full-duplicate rows kept = {dup_intra_kept}; "
      f"rows after drop_duplicates (reference only, NOT the answer) = {dedup_rows}")

print("\nper-file summary -> " + OUT_CSV)
print(summary.head(6).to_string(index=False))
print(f"\nANSWER (primary definition): {remaining} CHIP variant calls remain after removing "
      f"{removed} reference calls from {total_rows} calls across {len(files)} sample files.")
print(f"NOTE (alternative reading, Reference + empty removed): {alt_remaining}")
print(f"RESULT_JSON\tremaining={remaining}\tremoved={removed}\ttotal={total_rows}"
      f"\talt_remaining={alt_remaining}\tfiles={len(files)}")
