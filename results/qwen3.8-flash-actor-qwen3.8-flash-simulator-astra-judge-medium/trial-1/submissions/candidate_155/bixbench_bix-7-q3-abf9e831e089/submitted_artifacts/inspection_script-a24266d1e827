"""Plan-stage input inspection for BixBench bix-7-q3 (CHIP variants / reference calls).
Executed: enumerates the 86 CHIP tables, reports header schema, Zygosity value counts,
CHIP gene list, Trio_Status, duplicate/unique variant keys and the read_only parser trap.
"""
import glob, os, re, json, collections
import pandas as pd, openpyxl

CHIP_DIR = "data/CHIP_DP10_GQ20_PASS"
files = sorted(glob.glob(os.path.join(CHIP_DIR, "*.xlsx")))
print("CHIP variant files on disk:", len(files))

genes = set(pd.read_excel("data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx")["ABL1"].dropna().astype(str)) | {"ABL1"}
print("Schenz CHIP gene list size:", len(genes))

trio = pd.read_excel("data/230215_Trio_Status.xlsx")
print("Trio_Status:", trio.shape, dict(trio["Status"].astype(str).str.strip().value_counts()))

zy_all = collections.Counter()
total_rows = 0
unique_keys = set()
dups_intra = 0
roles = collections.Counter()
cols = collections.Counter()
for f in files:
    # NOTE: openpyxl read_only=True is unsafe here (broken sheet dimension -> 1x1).
    df = pd.read_excel(f, header=1)                      # row 2 = field names, data from row 3
    grp = [str(v) for v in pd.read_excel(f, header=0, nrows=0).columns]   # row 1 = groups
    sample_cols = [g for g in grp if re.match(r"^(Proband|Father|Mother|Child)", g)]
    roles[sample_cols[0].split(" ")[0]] += 1
    cols[len(df.columns)] += 1
    total_rows += len(df)
    zy_all.update(df["Zygosity"].astype(str).value_counts().to_dict())
    k = (df["Chr:Pos"].astype(str) + "_" + df["Ref/Alt"].astype(str))
    dups_intra += int(k.duplicated().sum())
    unique_keys.update(k)

print("columns per file:", dict(cols), "| sample-role headers:", dict(roles))
print("total variant-call rows:", total_rows)
print("Zygosity value counts:", dict(zy_all))
print("unique variant keys (union):", len(unique_keys), "| intra-file duplicate rows:", dups_intra)
print("remaining if only Reference removed:", total_rows - zy_all.get("Reference", 0))
print("remaining if Reference + no-call removed:", zy_all.get("Heterozygous", 0) + zy_all.get("Homozygous Variant", 0))

for f in ["data/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_380-P.xlsx",
          "data/CHIP_DP10_GQ20_PASS/230209_Exome_GRCh38_CHIP_502-P1.xlsx"]:
    ws_ro = openpyxl.load_workbook(f, read_only=True)[openpyxl.load_workbook(f, read_only=True).sheetnames[0]]
    print(os.path.basename(f), "sheet:", ws_ro.title, "read_only dims (unreliable):", ws_ro.max_row, ws_ro.max_column)
