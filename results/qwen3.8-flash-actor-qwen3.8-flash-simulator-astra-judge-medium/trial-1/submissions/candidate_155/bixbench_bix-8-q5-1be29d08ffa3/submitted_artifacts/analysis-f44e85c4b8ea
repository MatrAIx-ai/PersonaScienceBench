"""
bixbench bix-8-q5 -- Independence of m6A methylation status and differential
expression status in the bladder cancer MeRIP-seq capsule.

Fixed analysis contract (researcher ruling, 2026-10-25):
  * Analysis unit : the as-delivered 12,754 rows of data/MeRIP_RNA_result.xlsx
                    ('Date Formatting' sheet). No proteomic merge, no Class filter,
                    no gene-level rollup, duplicated (ENST, ENSG) pairs retained.
  * Primary test  : Pearson chi-square test of independence on the native 3x3
                    table m6A (m6A no sig / Hyper / Hypo) x DEG (no-DEGs / Up / Down),
                    correction=False, dof=(3-1)*(3-1)=4.
  * Secondary     : collapsed 2x2 (m6A+ = Hyper u Hypo ; DEG+ = Up u Down)
                    Pearson chi2 (uncorrected primary, Yates also listed),
                    Fisher exact p + odds ratio, unique-transcript and
                    protein_coding-only sensitivity p-values, Cramer's V and
                    standardized residuals of the 3x3 table.
  * Multiplicity  : one omnibus test -> no correction (Bonferroni only annotated
                    on the sensitivity panel, primary p untouched).

KNOWN LIMITATION (stated in the conclusion): rows are not strictly independent
observations -- peak-level m6A values are broadcast to several transcripts of the
same gene (2,143 ENSTs repeat; 3,280 duplicated (ENST, ENSG) pairs), which is an
inherent limitation of applying the chi-square independence test here.
"""
import numpy as np
import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact
from scipy.stats import chi2 as chi2_dist

DATA = "data/MeRIP_RNA_result.xlsx"
SHEET = "Date Formatting"
N_BONF = 4  # number of sensitivity tests, for annotation only

M6A_ORDER = ["m6A no sig", "m6A Hyper", "m6A Hypo"]
DEG_ORDER = ["no-DEGs", "Up", "Down"]


def sci(p, sig=2):
    """p-value as a fixed-precision scientific-notation string."""
    if p == 0:
        return "0"
    exp = int(np.floor(np.log10(p)))
    mant = p / 10 ** exp
    dec = max(sig - 1, 0)
    return f"{mant:.{dec}f}e{exp:+d}"


def line(ch="-", n=78):
    print(ch * n)


def pearson(tab, correction=False):
    """chi2, p, dof, expected, standardized residuals."""
    tab = np.asarray(tab, dtype=float)
    chi2, p, dof, exp = chi2_contingency(tab, correction=correction)[:4]
    resid = (tab - exp) / np.sqrt(exp)          # (unstandardized->) Pearson residuals
    return chi2, p, dof, exp, resid


def cramers_v(chi2, n, tab_shape):
    k = min(tab_shape) - 1
    return float(np.sqrt(chi2 / (n * k)))


def main():
    df = pd.read_excel(DATA, sheet_name=SHEET)

    line("=")
    print("0. INPUT / INTEGRITY CHECKS")
    line("=")
    print(f"file={DATA} sheet={SHEET!r} shape={df.shape}")
    assert df.shape[0] == 12754, f"unexpected row count {df.shape[0]}"
    assert list(df.columns)[:8] == ["GeneID", "m_log2FC", "m_pvalue", "g_log2FC",
                                    "g_pvalue", "m6A", "DEG", "m6A_DEG"]
    nan_status = df[["m6A", "DEG", "m6A_DEG"]].isna().sum().sum()
    print(f"missing values in m6A / DEG / m6A_DEG      : {nan_status}")
    assert nan_status == 0, "unexpected missing status labels"
    integrity = (df["m6A"] + " and " + df["DEG"] == df["m6A_DEG"]).all()
    print(f"assert m6A_DEG == m6A + ' and ' + DEG      : {integrity}")
    assert integrity, "m6A_DEG is not the exact product of m6A x DEG"
    print(f"m6A levels (n)   : {df['m6A'].value_counts().to_dict()}")
    print(f"DEG levels (n)   : {df['DEG'].value_counts().to_dict()}")
    print(f"unique ENST / ENS: {df['GeneID'].nunique()} / {df['gene_id'].nunique()}"
          f"   (duplicated (ENST,ENSG) pairs kept: "
          f"{int(df.duplicated(['GeneID','gene_id']).sum())})")
    print("unit = as-delivered rows; no proteomic merge, no Class filter, "
          "no gene-level rollup")

    # ---------------- PRIMARY -------------------------------------------------
    obs = pd.crosstab(df["m6A"], df["DEG"]).reindex(index=M6A_ORDER, columns=DEG_ORDER)
    line("=")
    print("1. PRIMARY 3x3 OBSERVED FREQUENCIES  (rows = m6A, cols = DEG)")
    line("=")
    print(obs.to_string())
    print(f"row totals : {obs.sum(axis=1).to_dict()}")
    print(f"col totals : {obs.sum(axis=0).to_dict()}")
    print(f"grand N    : {obs.values.sum()}")

    chi2, p_primary, dof, exp, resid = pearson(obs.values, correction=False)
    exp_df = pd.DataFrame(exp, index=M6A_ORDER, columns=DEG_ORDER)
    line("=")
    print("2. EXPECTED FREQUENCIES UNDER INDEPENDENCE")
    line("=")
    print(exp_df.round(3).to_string())
    print(f"minimum expected count : {exp.min():.3f}")
    print(f"cells with expected <5 : {int((exp < 5).sum())} of {exp.size}"
          f"  -> Pearson chi-square validity criterion satisfied")
    print(f"cells with expected <1 : {int((exp < 1).sum())}")

    line("=")
    print("3. PRIMARY TEST -- Pearson chi-square test of independence (3x3)")
    line("=")
    print("H0 : m6A methylation status and differential expression status are independent")
    print("H1 : the two statuses are dependent")
    print(f"correction (Yates)     : False")
    print(f"chi-square statistic   : {chi2:.6f}")
    print(f"degrees of freedom     : {dof}  [= (3-1) x (3-1)]")
    print(f"p-value (Python repr)  : {p_primary!r}")
    print(f"p-value (sci, 2 s.f.)  : {sci(p_primary)}")
    print(f"-log10(p)              : {-np.log10(p_primary):.3f}")
    V = cramers_v(chi2, obs.values.sum(), obs.values.shape)
    print(f"Cramer's V             : {V:.4f}  (df* = min(r-1,c-1) = 2)")
    print(f"alpha = 0.05 -> reject H0: {bool(p_primary < 0.05)}")

    line("=")
    print("4. 3x3 PEARSON STANDARDIZED RESIDUALS (obs-exp)/sqrt(exp)")
    line("=")
    print(pd.DataFrame(resid, index=M6A_ORDER, columns=DEG_ORDER).round(2).to_string())
    flat = [(M6A_ORDER[i], DEG_ORDER[j], resid[i, j], obs.values[i, j], exp[i, j])
            for i in range(3) for j in range(3)]
    flat.sort(key=lambda t: -abs(t[2]))
    print("largest |residual| cells:")
    for m6a, deg, r, o, e in flat[:4]:
        print(f"   {m6a:11s} x {deg:8s} resid={r:+7.2f} obs={int(o):6d} exp={e:8.2f}")
    contrib = resid ** 2
    print("cell contributions to chi2 (r^2), sorted:")
    cc = [(M6A_ORDER[i], DEG_ORDER[j], contrib[i, j]) for i in range(3) for j in range(3)]
    for m6a, deg, c in sorted(cc, key=lambda t: -t[2])[:4]:
        print(f"   {m6a:11s} x {deg:8s} r^2={c:8.2f}  ({100*c/chi2:5.1f}% of chi2)")

    line("=")
    print("3b. CROSS-CHECKS OF THE PRIMARY 3x3 TEST (asymptotic p is not an artifact)")
    line("=")
    o = obs.values.astype(float)
    r, c = o.sum(1, keepdims=True), o.sum(0, keepdims=True)
    e_lr = r @ c / o.sum()
    nz = o > 0
    G2 = float(2 * np.sum(o[nz] * np.log(o[nz] / e_lr[nz])))
    p_G2 = float(chi2_dist.sf(G2, dof))
    print(f"log-likelihood-ratio G2 = {G2:.3f} dof={dof} p={p_G2!r} ({sci(p_G2)})")
    rng = np.random.default_rng(20261025)
    m6a_v, deg_v = df["m6A"].to_numpy(), df["DEG"].to_numpy()
    n_perm, n_lt, worst = 20000, 0, 0.0
    obs_flat = o.ravel()
    for _ in range(n_perm):
        perm = rng.permutation(deg_v)
        t = pd.crosstab(pd.Series(m6a_v), pd.Series(perm)).reindex(
            index=M6A_ORDER, columns=DEG_ORDER).fillna(0).values.astype(float)
        rr, cc = t.sum(1, keepdims=True), t.sum(0, keepdims=True)
        ee = rr @ cc / t.sum()
        tnz = t > 0
        stat = float(np.sum((t[tnz] - ee[tnz]) ** 2 / ee[tnz]))
        worst = max(worst, stat)
        n_lt += stat >= chi2
    print(f"Monte-Carlo permutation ({n_perm:,} shuffles of the DEG labels, seed 20261025):")
    print(f"   permutations with chi2 >= observed ({chi2:.2f}) : {n_lt}"
          f"   -> p_MC <= {1/(n_perm+1):.2e} (resolution floor)")
    print(f"   largest permuted chi2 = {worst:.2f}  (observed {chi2:.2f} is far outside)")
    print(f"   asymptotic p is below the Monte-Carlo resolution floor; asymptotic p kept "
          f"as primary per protocol.")

    # ---------------- SECONDARY ----------------------------------------------
    m6a_pos = ~df["m6A"].eq("m6A no sig")          # Hyper u Hypo  (m_pvalue<0.05)
    deg_pos = ~df["DEG"].eq("no-DEGs")             # Up u Down     (g_pvalue<0.05)
    obs2 = pd.crosstab(np.where(m6a_pos, "m6A+", "m6A-"),
                       np.where(deg_pos, "DEG+", "DEG-")).reindex(
                           index=["m6A-", "m6A+"], columns=["DEG-", "DEG+"])
    line("=")
    print("5. SECONDARY -- collapsed 2x2 (m6A+ = Hyper|Hypo ; DEG+ = Up|Down)")
    line("=")
    print(obs2.to_string())
    c_nc, p_nc, d_nc, e_nc, _ = pearson(obs2.values, correction=False)
    c_y, p_y, d_y, _, _ = pearson(obs2.values, correction=True)
    orv, p_fish = fisher_exact(obs2.values)
    print(f"min expected count     : {e_nc.min():.3f}  (cells <5: {int((e_nc<5).sum())})")
    print(f"[2x2 chi2 main] Pearson correction=False : chi2={c_nc:.4f} dof={d_nc} "
          f"p={p_nc!r}  ({sci(p_nc)})")
    print(f"[2x2 chi2 alt ] Pearson Yates=True       : chi2={c_y:.4f} dof={d_y} "
          f"p={p_y!r}  ({sci(p_y)})")
    a, b, c_, d_ = obs2.values.ravel()
    se = np.sqrt(1/a + 1/b + 1/c_ + 1/d_)
    lo, hi = np.exp(np.log(orv) - 1.96*se), np.exp(np.log(orv) + 1.96*se)
    print(f"[2x2 Fisher   ] exact two-sided          : p={p_fish!r}  ({sci(p_fish)})"
          f"  odds ratio={orv:.4f}  95% CI (Woolf log-OR) [{lo:.3f}, {hi:.3f}]")
    print(f"Cramer's V (2x2)       : {cramers_v(c_nc, obs2.values.sum(), (2,2)):.4f}")

    line("=")
    print("6. SENSITIVITY ANALYSES (NOT the primary value)")
    line("=")
    sens = []

    u = df.drop_duplicates("GeneID")
    o_u = pd.crosstab(u["m6A"], u["DEG"]).reindex(index=M6A_ORDER, columns=DEG_ORDER)
    c, p, d, e, _ = pearson(o_u.values, correction=False)
    sens.append(("unique-transcript 3x3 (ENST dedup)", int(o_u.values.sum()), c, d, p, e.min()))

    o_u2 = pd.crosstab(np.where(u["m6A"].eq("m6A no sig"), "m6A-", "m6A+"),
                       np.where(u["DEG"].eq("no-DEGs"), "DEG-", "DEG+"))
    c2, p2, d2, e2, _ = pearson(o_u2.values, correction=False)
    or2, pf2 = fisher_exact(o_u2.values)
    sens.append(("unique-transcript 2x2", int(o_u2.values.sum()), c2, d2, p2, e2.min()))

    pc = df[df["Class"] == "protein_coding"]
    o_pc = pd.crosstab(np.where(pc["m6A"].eq("m6A no sig"), "m6A-", "m6A+"),
                       np.where(pc["DEG"].eq("no-DEGs"), "DEG-", "DEG+"))
    c3, p3, d3, e3, _ = pearson(o_pc.values, correction=False)
    or3, pf3 = fisher_exact(o_pc.values)
    sens.append(("protein_coding-only 2x2", int(o_pc.values.sum()), c3, d3, p3, e3.min()))

    g = df.groupby("gene_id").agg(mp=("m6A", lambda s: (~s.eq("m6A no sig")).any()),
                                  dp=("DEG", lambda s: (~s.eq("no-DEGs")).any()))
    o_g = pd.crosstab(np.where(g.mp, "m6A+", "m6A-"), np.where(g.dp, "DEG+", "DEG-"))
    c4, p4, d4, e4, _ = pearson(o_g.values, correction=False)
    or4, pf4 = fisher_exact(o_g.values)
    sens.append(("gene-level any-positive 2x2 (extra, non-conforming)",
                 int(o_g.values.sum()), c4, d4, p4, e4.min()))

    sdf = pd.DataFrame(sens, columns=["variant", "N", "chi2", "dof", "p_uncorrected",
                                      "min_expected"])
    sdf["p_sci"] = [sci(x) for x in sdf.p_uncorrected]
    sdf["p_bonferroni"] = np.minimum(sdf.p_uncorrected * N_BONF, 1.0)
    sdf["V"] = [cramers_v(c, n, (3, 3) if dd == 4 else (2, 2))
                for c, n, dd in zip(sdf.chi2, sdf.N, sdf.dof)]
    print(sdf.to_string(index=False))
    print(f"\nFisher cross-checks: unique-tx 2x2 p={pf2!r} ({sci(pf2)}) OR={or2:.4f} | "
          f"protein_coding 2x2 p={pf3!r} ({sci(pf3)}) OR={or3:.4f} | "
          f"gene-level 2x2 p={pf4!r} ({sci(pf4)}) OR={or4:.4f}")
    print(f"Bonferroni multiplier = {N_BONF} (annotation only; primary p unchanged)")

    line("=")
    print("7. CONCLUSION")
    line("=")
    print(f"PRIMARY p-value (Pearson chi-square independence test, native 3x3, "
          f"as-delivered N={obs.values.sum()}, dof={dof}, correction=False):")
    print(f"   repr  : {p_primary!r}")
    print(f"   sci   : {sci(p_primary)}     (chi2={chi2:.2f}, Cramer's V={V:.3f})")
    print("m6A methylation status and differential expression status are NOT independent.")
    idx = {lab: i for i, lab in enumerate(M6A_ORDER)}
    jdx = {lab: j for j, lab in enumerate(DEG_ORDER)}
    print("Directionality (from Pearson residuals):")
    print(f"   m6A Hyper x Up      resid={resid[idx['m6A Hyper'], jdx['Up']]:+7.2f} "
          f"obs={obs.values[idx['m6A Hyper'], jdx['Up']]:5d} exp={exp[idx['m6A Hyper'], jdx['Up']]:9.2f} -> enriched")
    print(f"   m6A Hypo  x Down    resid={resid[idx['m6A Hypo'], jdx['Down']]:+7.2f} "
          f"obs={obs.values[idx['m6A Hypo'], jdx['Down']]:5d} exp={exp[idx['m6A Hypo'], jdx['Down']]:9.2f} -> enriched")
    print(f"   m6A Hyper x Down    resid={resid[idx['m6A Hyper'], jdx['Down']]:+7.2f} "
          f"obs={obs.values[idx['m6A Hyper'], jdx['Down']]:5d} exp={exp[idx['m6A Hyper'], jdx['Down']]:9.2f} -> depleted")
    print(f"   m6A Hypo  x Up      resid={resid[idx['m6A Hypo'], jdx['Up']]:+7.2f} "
          f"obs={obs.values[idx['m6A Hypo'], jdx['Up']]:5d} exp={exp[idx['m6A Hypo'], jdx['Up']]:9.2f} -> depleted")
    print(f"   m6A no sig x no-DEGs resid={resid[idx['m6A no sig'], jdx['no-DEGs']]:+7.2f} "
          f"obs={obs.values[idx['m6A no sig'], jdx['no-DEGs']]:5d} exp={exp[idx['m6A no sig'], jdx['no-DEGs']]:9.2f} -> enriched")
    print("   => m6A hypermethylation co-occurs with transcript up-regulation and "
          "hypomethylation with down-regulation (direction-concordant association).")
    print("LIMITATION: rows are not strictly independent observations -- peak-level m6A "
          "values are broadcast to multiple transcripts of the same gene (2,143 repeated "
          "ENSTs, 3,280 duplicated (ENST, ENSG) pairs, 3,117 genes behind 12,754 rows), "
          "so the chi-square null distribution is optimistic about the effective sample "
          "size; unit-of-analysis sensitivity values are reported in section 6.")


if __name__ == "__main__":
    main()
