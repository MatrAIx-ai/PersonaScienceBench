"""Input inspection for bix-8-q5: m6A methylation status vs differential expression status.

Scope: INPUT INSPECTION + candidate contingency tables / expected-frequency diagnostics
used only to justify the choice of independence test. Not the final analysis.
"""
import numpy as np, pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

MERIP = "data/MeRIP_RNA_result.xlsx"
PROT = "data/Proteomic_data .xlsx"

print("=" * 70, "\nMeRIP sheet inventory")
import openpyxl
for f in (MERIP, PROT):
    wb = openpyxl.load_workbook(f, read_only=True)
    for ws in wb.worksheets:
        print(f, "|", ws.title, "|", ws.max_row, "x", ws.max_column)
    wb.close()

m = pd.read_excel(MERIP, sheet_name="Date Formatting")
p = pd.read_excel(PROT, sheet_name="Tumor vs Normal")
print("\nMeRIP shape", m.shape, "\ncols:", list(m.columns))
print("missing:\n", m.isna().sum().to_string())
print("dup header check: GeneID vs GeneID.1 mismatch rows =", (m.GeneID != m["GeneID.1"]).sum())
print("unique ENST:", m.GeneID.nunique(), "ENST with >1 row:", (m.GeneID.value_counts() > 1).sum())
print("unique ENSG:", m.gene_id.nunique(), "gene_name:", m.gene_name.nunique())

for c in ["m6A", "DEG", "m6A_DEG", "Class"]:
    print(f"\nvalue_counts {c}:\n{m[c].value_counts().to_string()}")

# label rules reverse-engineered
up = (m.g_pvalue < 0.05) & (m.g_log2FC > 0); dn = (m.g_pvalue < 0.05) & (m.g_log2FC < 0)
deg_rule = np.where(up, "Up", np.where(dn, "Down", "no-DEGs"))
hy = (m.m_pvalue < 0.05) & (m.m_log2FC > 0); lo = (m.m_pvalue < 0.05) & (m.m_log2FC < 0)
m6a_rule = np.where(hy, "m6A Hyper", np.where(lo, "m6A Hypo", "m6A no sig"))
print("\nDEG rule agreement:", (deg_rule == m.DEG.values).mean())
print("m6A rule agreement:", (m6a_rule == m.m6A.values).mean())
print("m6A_DEG == product(m6A,DEG):", (m.m6A + " and " + m.DEG == m.m6A_DEG).all())

# multi-label / duplicate diagnostics
lab = m.groupby("gene_id").agg(n_m6A=("m6A", "nunique"), n_DEG=("DEG", "nunique"))
print("genes with >1 m6A label:", (lab.n_m6A > 1).sum(), "| >1 DEG label:", (lab.n_DEG > 1).sum())
tl = m.groupby("GeneID").agg(n_m6A=("m6A", "nunique"), n_DEG=("DEG", "nunique"))
print("transcripts with >1 m6A label:", (tl.n_m6A > 1).sum(), "| >1 DEG label:", (tl.n_DEG > 1).sum())
print("fully duplicated rows:", int(m.duplicated().sum()), "| duplicated (ENST,ENSG):",
      int(m.duplicated(['GeneID', 'gene_id']).sum()))

print("\n" + "=" * 70, "\nProteomic sheet")
print("shape", p.shape, "\ncols:", list(p.columns))
print("missing:\n", p.isna().sum().to_string())
print("is_sig:", p.is_sig.value_counts().to_dict(), "| compare:", p["compare"].value_counts().to_dict())
print("is_sig rule (p<0.05 & |log2FC|>1) agreement:",
      (((p["p.value"] < 0.05) & (p.log2FC.abs() > 1)) == p.is_sig).mean())
print("unique protein:", p.protein.nunique(), "unique gene:", p["gene"].nunique(),
      "| unmapped gene '-':", int((p["gene"] == "-").sum()))

print("\n" + "=" * 70, "\nCandidate contingency tables (diagnostics for test choice)")
def show(name, tab):
    tab = np.asarray(tab)
    exp = np.outer(tab.sum(1), tab.sum(0)) / tab.sum()
    print(f"\n--- {name}: N={tab.sum()} shape={tab.shape} min_expected={exp.min():.2f} "
          f"cells_exp_lt5={(exp < 5).sum()}")
    print(pd.DataFrame(tab).to_string())
    if tab.shape == (2, 2):
        c, pv, d, _ = chi2_contingency(tab, correction=False)
        cy, pvy, _, _ = chi2_contingency(tab, correction=True)
        orv, pf = fisher_exact(tab)
        print(f"chi2={c:.2f} p={pv:.3e} | Yates p={pvy:.3e} | Fisher p={pf:.3e} OR={orv:.3f}")
    else:
        c, pv, d, _ = chi2_contingency(tab)
        print(f"chi2={c:.2f} dof={d} p={pv:.3e} V={np.sqrt(c/(tab.sum()*(min(tab.shape)-1))):.3f}")

show("A as-delivered rows, native 3x3 m6A x DEG", pd.crosstab(m.m6A, m.DEG))
show("B as-delivered rows, binary 2x2",
     pd.crosstab(np.where(m.m6A == "m6A no sig", "m6A-", "m6A+"),
                 np.where(m.DEG == "no-DEGs", "DEG-", "DEG+")))
gany = m.groupby("gene_id").agg(mp=("m6A", lambda s: (s != "m6A no sig").any()),
                                dp=("DEG", lambda s: (s != "no-DEGs").any()))
show("C gene-level (any transcript positive) 2x2",
     pd.crosstab(np.where(gany.mp, "m6A+", "m6A-"), np.where(gany.dp, "DEG+", "DEG-")))
u = m.drop_duplicates("GeneID")
show("D unique-transcript 3x3", pd.crosstab(u.m6A, u.DEG))
pc = m[m.Class == "protein_coding"]
show("E protein_coding only 2x2",
     pd.crosstab(np.where(pc.m6A == "m6A no sig", "m6A-", "m6A+"),
                 np.where(pc.DEG == "no-DEGs", "DEG-", "DEG+")))

print("\n" + "=" * 70, "\nCross-file option (proteomics DE status), NOT the primary test")
pg = p.assign(g=p["gene"].str.upper().str.strip()).groupby("g").agg(sig=("is_sig", "max"))
mg = m.assign(g=m.gene_name.str.upper().str.strip()).groupby("g").agg(
    mp=("m6A", lambda s: (s != "m6A no sig").any()))
j = mg.join(pg, how="inner")
print("merged genes:", len(j))
show("F m6A x proteomic is_sig (merged)",
     pd.crosstab(np.where(j.mp, "m6A+", "m6A-"), np.where(j.sig, "pDEG+", "pDEG-")))
