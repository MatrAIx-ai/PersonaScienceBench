"""
FINAL ANALYSIS  —  DiscoveryBench / archaeology metadata_13
Question: "In what centuries did we see the highest growth phase of the period between 2000 BCE and 1100 BCE?"

Design approved by researcher (2026-10-25):
  A primary   growth of landscape openness (pollen PC1, human-induced woodland clearance proxy).
              Century growth = change of the 100-yr smoothed openness score over the preceding 100 years.
                A1 = literal pointwise percentage change (as briefed)  -> unstable, the PC1 score crosses 0
                A2 = bin-level percentage change, denominator = mean|previous 100-yr values|
                A3 = absolute change in score units per century (scale-stable tie-breaker)
  B secondary g_all_mean (mean of all-capital KDE growth rates) + g_all_std
  C aux       per-century delta-Z of the *_inter capital series aggregated into the 4 approved classes
              (symbolic / social / cultural / economic)
  Cross-check kde_all_mean level + slope, kde_all_detrend slope, raw-column contrast, smoothing-window and
  site sensitivity, capital 100-yr grid anchoring.  No formal significance tests (agreed).
Reproducible: python3 work/final_analysis.py   ->  prints tables, writes work/final_report.md
"""
import numpy as np, pandas as pd

W_LO, W_HI = -2000, -1100                       # CE == 2000 BCE .. 1100 BCE
BINS = [(y, y+99) for y in range(W_LO, W_HI, 100)]; BINS[-1] = (-1200, W_HI)   # endpoint -1100 -> last bin
def lbl(a, b): return f"{-b}\u2013{-a} BCE"      # bin (-1400,-1301) -> "1301–1400 BCE"

ts  = pd.read_csv('data/time_series_data.csv', index_col=0).sort_values('CE').reset_index(drop=True)
po_ = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',').sort_values('CE')
po  = po_.set_index('CE'); tsi = ts.set_index('CE')
cap = pd.read_csv('data/capital.csv', decimal=','); cap['CE'] = -cap['BCE']
assert ((ts.calBP + ts.CE) == 1950).all() and ((po_.calBP + po_.CE) == 1950).all()   # verified alignment
chk = {t: float((cap.set_index('CE')[c] - tsi[t]).dropna().abs().max())
       for c, t in [('ZAxtSchwert','HatchetSword'),('ZDolch','Dagger'),('Zhausgr','HouseSize'),
                    ('ZCU_AU','CopperGold'),('Zamber','Amber'),('ZMonument','MonumentCount'),
                    ('ZHort','Depot'),('ZSichel','Sickle'),('ZBeil','AxesCelts'),('ZMW','MonumentSize'),
                    ('ZKeform','PotteryForm'),('Zkeverz','PotteryDecoration')]}
assert max(chk.values()) == 0.0                  # capital BCE  <->  ts CE alignment exact

SER = {'Belau 100-yr smoothed openness (pollen_inter_100) [PRIMARY]': tsi.pollen_inter_100,
       'Belau_PC1_inter (annual)':              tsi.pollen_inter,
       'SMOOTH_MEAN_50y (Belau+Woserin)':       po.SMOOTH_MEAN_50y,
       'SMOOTH_MEAN_100y (Belau+Woserin)':      po.SMOOTH_MEAN_100y,
       'SMOOTH_MEAN_150y (Belau+Woserin)':      po.SMOOTH_MEAN_150y,
       'MEAN (Belau+Woserin, unsmoothed)':      po.MEAN,
       'Woserin_PC1_inter (site sensitivity)':  po.Woserin_PC1_inter}
PRI = list(SER)[0]
A1, A2, A3, LVL, MINP = ({k: {} for k in SER} for _ in range(5))
for n, s in SER.items():
    for a, b in BINS:
        cur, prev = s.loc[a:b].values, s.loc[a-100:b-100].values
        A1[n][lbl(a,b)] = float(np.nanmean((cur-prev)/np.abs(prev)))
        A2[n][lbl(a,b)] = float((cur.mean()-prev.mean())/np.abs(prev).mean())
        A3[n][lbl(a,b)] = float(cur.mean()-prev.mean())
        LVL[n][lbl(a,b)] = float(cur.mean()); MINP[n][lbl(a,b)] = float(np.abs(prev).min())
A1, A2, A3, LVL, MINP = (pd.DataFrame(x).T for x in (A1, A2, A3, LVL, MINP))

B = pd.DataFrame({'g_all_mean': {lbl(a,b): tsi.loc[a:b].g_all_mean.mean() for a,b in BINS},
                  'g_all_std' : {lbl(a,b): tsi.loc[a:b].g_all_std.mean()  for a,b in BINS}})
CL = {'symbolic':['HatchetSword_inter','Dagger_inter','HouseSize_inter'],
      'social':['CopperGold_inter','Amber_inter','MonumentCount_inter'],
      'cultural':['PotteryForm_inter','PotteryDecoration_inter'],
      'economic':['Depot_inter','Sickle_inter','AxesCelts_inter','MonumentSize_inter']}
cols = [c for v in CL.values() for c in v]
BM = pd.DataFrame({lbl(a,b): tsi.loc[a:b, cols].mean() for a,b in [(-2100,-2001)]+BINS}).T
dZ = BM.diff().iloc[1:]
Cm = pd.DataFrame({k: dZ[v].mean(axis=1) for k,v in CL.items()})[list(CL)]
Ct = pd.DataFrame({k: dZ[v].sum(axis=1)  for k,v in CL.items()})[list(CL)]
flat = pd.DataFrame({lbl(a,b): {c: bool(np.ptp(tsi.loc[a:b,c].values)==0) for c in cols} for a,b in BINS}).T
KDE = pd.DataFrame({'kde_all_mean_level':      {lbl(a,b): tsi.loc[a:b].kde_all_mean.mean() for a,b in BINS},
                    'kde_slope_per_century':   {lbl(a,b): 100*np.polyfit(np.arange(len(tsi.loc[a:b])), tsi.loc[a:b].kde_all_mean.values,1)[0] for a,b in BINS},
                    'detrend_slope_per_century':{lbl(a,b): 100*np.polyfit(np.arange(len(tsi.loc[a:b])), tsi.loc[a:b].kde_all_detrend.values,1)[0] for a,b in BINS},
                    'raw_pollen_obs':          {lbl(a,b): int(tsi.loc[a:b].pollen.notna().sum()) for a,b in BINS}}).T
shipped = pd.Series({lbl(a,b): float(tsi.loc[a:b].pollen_grate_100.mean()) for a,b in BINS})

OPEN5 = ['Belau 100-yr smoothed openness (pollen_inter_100) [PRIMARY]','SMOOTH_MEAN_50y (Belau+Woserin)',
         'SMOOTH_MEAN_100y (Belau+Woserin)','SMOOTH_MEAN_150y (Belau+Woserin)','Woserin_PC1_inter (site sensitivity)']
rankA = pd.DataFrame({n: A2.loc[n].rank(ascending=False) for n in OPEN5})
rankA['A3_absdiff'] = A3.loc[PRI].rank(ascending=False)
OPEN_RANK = rankA.mean(axis=1).round(2)
SUM = pd.DataFrame({'A_openness_pct_binlevel': A2.loc[PRI], 'A_openness_absdiff': A3.loc[PRI],
                    'A_openness_rank_avg6variants': OPEN_RANK, 'B_g_all_mean': B['g_all_mean'],
                    'B_g_all_std': B['g_all_std'], 'kde_level': KDE.loc['kde_all_mean_level'].astype(float),
                    'kde_slope_per_century': KDE.loc['kde_slope_per_century'].astype(float),
                    'pollen_grate_100_AS_SHIPPED': shipped,
                    'dZ_social_total': Ct['social'], 'dZ_symbolic_total': Ct['symbolic'], 'dZ_economic_total': Ct['economic']})
SUM['B_rank'] = B['g_all_mean'].rank(ascending=False).astype(int)

L=[]
def P(*x):
    line = " ".join(str(y) for y in x); L.append(line); print(line)
P("# Growth 2000-1100 BCE — century table (window CE -2000..-1100 = 901 annual rows)\n")
P("## T1  century bins x all metrics\n")
P(SUM.round(5).to_string())
P("\n## T1a  primary metric A, 3 definitions, openness rank (1 = fastest growth; A2/A3 = robust)")
P(rankA.astype(int).assign(avg=OPEN_RANK).to_string())
P("\n## T1b  A sensitivity: bin-level pct change (A2) for all 7 openness series")
P(A2.round(3).to_string())
P("\n absolute 100-yr change in score units (A3) for all 7 openness series")
P(A3.round(3).to_string())
P("\n## T1c  openness level / min|prior 100-yr value| (near zero => percentage change explodes)")
P(LVL.round(3).to_string()); P(""); P(MINP.round(3).to_string())
P("\n## T1d  A1 pointwise percentage change (literal brief; ARTEFACT-PRONE, kept for transparency)")
P(A1.round(3).to_string())
P("\n## T2  secondary B: all-capital KDE growth per century")
P(B.round(5).to_string())
P("\n## T3  aux C: per-century delta-Z by approved capital class (class mean / class total)")
P("mean:\n"+Cm.round(3).to_string()+"\n\ntotal:\n"+Ct.round(3).to_string())
P("\n## T3b  flat (no-observation) Z series per bin -> dZ=0 there means NO DATA, not no growth")
P(flat.to_string())
P("\n## T4  cross-validation: KDE level & slope (slope>0 = rising segment), raw pollen observations per bin")
P(KDE.apply(lambda c: c.astype(float).map(lambda x: f"{x:.3e}" if abs(x)<1e-3 else f"{x:.3f}")).to_string())
gp=list(range(-2000,-1099,100)); s=SER[PRI]
grid=pd.DataFrame({'A1_point_pct':{-c: float((s.loc[c]-s.loc[c-100])/abs(s.loc[c-100])) for c in gp},
                   'A2_pct_100yrmean':{-c: float((s.loc[c-99:c].mean()-s.loc[c-199:c-100].mean())/abs(s.loc[c-199:c-100]).mean()) for c in gp},
                   'A3_absdiff_100yr':{-c: float(s.loc[c-99:c].mean()-s.loc[c-199:c-100].mean()) for c in gp},
                   'B_g_100yrmean':{-c: float(tsi.loc[c-99:c].g_all_mean.mean()) for c in gp}}).sort_index()
P("\n## T5  sensitivity anchored on the capital 100-yr grid (label = grid year, change ENDING at that year)")
P(grid.round(4).to_string())
P("\n## T6  rankings / consensus")
P(" openness top3 (avg rank over 6 variants): "+str(list(OPEN_RANK.sort_values().head(3).items())))
P(" openness top3 (A3 absdiff, primary series): "+str(list(A3.loc[PRI].sort_values(ascending=False).head(3).items())))
P(" capital   top3 (B g_all_mean):             "+str(list(B['g_all_mean'].sort_values(ascending=False).head(3).items())))
P(" as-shipped pollen_grate_100 top3:          "+str(list(shipped.sort_values(ascending=False).head(3).items())))
P(" KDE steepest rising bin: "+str(KDE.loc['kde_slope_per_century'].idxmax())+f" ({KDE.loc['kde_slope_per_century'].max():.3e}/century)"
  +"; KDE level peak bin: "+str(KDE.loc['kde_all_mean_level'].idxmax())+f" ({KDE.loc['kde_all_mean_level'].max():.3e})")
P("\n## T7  shipped pollen_grate_100 vs recomputed openness growth (must be reported as inconsistent)")
P(f" shipped column range {ts.pollen_grate_100.min():.5f}..{ts.pollen_grate_100.max():.5f} (n={ts.pollen_grate_100.notna().sum()}, ~clipped at +/-1%);"
  f" recomputed A1 window range {A1.loc[PRI].min():.3f}..{A1.loc[PRI].max():.3f} -> magnitudes differ by ~2-3 orders")
P(f" century-bin Pearson r = {np.corrcoef(shipped.values, A1.loc[PRI].values)[0,1]:.3f}, Spearman = {shipped.corr(A1.loc[PRI], method='spearman'):.3f};"
  f" whole-file r of shipped column vs any pollen 100-yr pct-change variant |r| <= 0.18")
open('work/final_report.md','w').write("\n".join(L))
