"""Input verification only (no final analysis). Prints coverage, step, missingness,
cross-file alignment and column-semantics diagnostics."""
import pandas as pd, numpy as np

ts  = pd.read_csv('data/time_series_data.csv', index_col=0).sort_values('CE').reset_index(drop=True)
cap = pd.read_csv('data/capital.csv', decimal=',')
po  = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  decimal=',').sort_values('CE').reset_index(drop=True)

print("== 1. shapes / coverage / step ==")
for n, df, col in [('time_series_data', ts, 'CE'), ('capital', cap, 'BCE'), ('pollen_openness', po, 'CE')]:
    s = df[col]
    print(f"{n}: rows={len(df)} cols={df.shape[1]} {col} {s.min()}..{s.max()} "
          f"unique_step={sorted(set(np.diff(np.sort(s.values))))[:3]}")
print("calBP == 1950 - CE everywhere:", bool(((ts.calBP + ts.CE) == 1950).all()),
      "| pollen file:", bool(((po.calBP + po.CE) == 1950).all()))

print("\n== 2. missingness ==")
key = ['kde_all_mean','kde_all_std','kde_all_detrend','g_all_mean','g_all_std',
       'pollen','pollen_inter','pollen_detrend','pollen_inter_100','pollen_grate_100']
print(ts[key].isna().sum().to_string())
inter = [c for c in ts.columns if c.endswith('_inter')]
print("raw Z cols NaN:", int(ts[[c[:-6] for c in inter]].isna().sum().max()),
      "| interpolated Z cols NaN:", int(ts[inter].isna().sum().max()))
print("capital Z cols NaN total:", int(cap.iloc[:,3:].isna().sum().sum()),
      "| pollen raw PC1 NaN:", int(po.Belau_PC1.isna().sum()), int(po.Woserin_PC1.isna().sum()))

print("\n== 3. capital BCE <-> ts CE alignment ==")
cap['CE'] = -cap['BCE']
pairs = [('ZAxtSchwert','HatchetSword'),('ZDolch','Dagger'),('Zhausgr','HouseSize'),('ZCU_AU','CopperGold'),
         ('Zamber','Amber'),('ZMonument','MonumentCount'),('ZHort','Depot'),('ZSichel','Sickle'),
         ('ZBeil','AxesCelts'),('ZMW','MonumentSize'),('ZKeform','PotteryForm'),('Zkeverz','PotteryDecoration')]
m = ts.set_index('CE')
for c, t in pairs:
    s = cap.set_index('CE')[c]; common = s.index.intersection(m.index)
    print(f"  {t:<17} n={len(common):2d} max|diff|={float((m.loc[common,t]-s.loc[common]).abs().max()):.6f}")
print("  capital points outside ts range:", sorted(set(cap.CE)-set(ts.CE)), "| groups:", cap.group.tolist()[:0] or
      sorted(cap.group.unique()))

print("\n== 4. window 2000-1100 BCE = CE -2000..-1100 ==")
w  = ts[(ts.CE>=-2000)&(ts.CE<=-1100)]
pw = po[(po.CE>=-2000)&(po.CE<=-1100)]
cw = cap[(cap.BCE>=1100)&(cap.BCE<=2000)]
print(f"ts rows={len(w)} (NaN in growth cols: g_all_mean={w.g_all_mean.isna().sum()}, "
      f"pollen_grate_100={w.pollen_grate_100.isna().sum()}, raw pollen obs={int(w.pollen.notna().sum())})")
print(f"pollen-file rows={len(pw)} (interpolated NaN={int(pw.MEAN.isna().sum())}); capital grid points={len(cw)} {sorted(cw.BCE)}")
print("complete 100y bins fully inside window:", [(y, y+99) for y in range(-2000, -1100, 100)])

print("\n== 5. column semantics probes ==")
k = ts.kde_all_mean
v = k.pct_change(1)
mm = ts.g_all_mean.notna() & v.notna()
print("corr(g_all_mean, annual pct-change of kde_all_mean) = %.4f  (max|diff|=%.5f, n=%d)"
      % (np.corrcoef(ts.g_all_mean[mm], v[mm])[0,1], float((ts.g_all_mean-v).abs()[mm].max()), int(mm.sum())))
print("range g_all_mean: %.5f..%.5f ; range pollen_grate_100: %.5f..%.5f"
      % (ts.g_all_mean.min(), ts.g_all_mean.max(), ts.pollen_grate_100.min(), ts.pollen_grate_100.max()))
p = ts.pollen_inter
for name, cand in {'pct_change(100)': p.pct_change(100),
                   'diff100/|prev100|/100': (p-p.shift(100))/p.shift(100).abs()/100,
                   'annual pct-change of pollen_inter_100': ts.pollen_inter_100.pct_change()}.items():
    mm = ts.pollen_grate_100.notna() & cand.notna()
    print("pollen_grate_100 vs %-34s corr=%+.3f" % (name, np.corrcoef(ts.pollen_grate_100[mm], cand[mm])[0,1]))
