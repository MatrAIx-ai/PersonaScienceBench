def cat_stats(load):
    rows=[]
    for c,cols in CATS.items():
        cols=[x for x in cols if x in load.index]
        if not cols: continue
        l=load[cols]; pos,neg=int((l>0).sum()),int((l<0).sum())
        rows.append(dict(category=c,n=len(cols),mean_loading=l.mean(),mean_abs=l.abs().mean(),
                         n_pos=pos,n_neg=neg,consistency=max(pos,neg)/len(cols)))
    return pd.DataFrame(rows)

def pca_run(df,cols,standardize=True,npc=4):
    X=df[cols].astype(float).copy()
    if standardize: X=(X-X.mean())/X.std(ddof=1)
    Xc=X-X.mean()
    U,S,Vt=np.linalg.svd(Xc.values,full_matrices=False)
    npc=min(npc,S.size); evr=S**2/(S**2).sum()
    loads=pd.DataFrame(Vt[:npc].T,index=cols,columns=[f'PC{i+1}' for i in range(npc)])
    scores=pd.DataFrame(U[:,:npc]*S[:npc],index=df.BCE.values,columns=loads.columns)
    return loads,scores,evr,X

def orient(loads):
    cs=cat_stats(loads.PC1)
    elig=cs[cs.consistency==1.0]
    if len(elig)==0: elig=cs.sort_values(['consistency','mean_abs'],ascending=False).head(1)
    a=elig.loc[elig.mean_loading.abs().idxmax()]
    return (1.0 if a.mean_loading>0 else -1.0), a.category

def phase_tbl(scores,phases=PHASES):
    rows=[]
    for ph,yrs in phases.items():
        v=scores.loc[[y for y in yrs if y in scores.index],'PC1']
        f,l=v.iloc[:3].mean(),v.iloc[-3:].mean()
        rows.append(dict(phase=ph,n=len(v),mean=v.mean(),sd=v.std(ddof=1),min=v.min(),max=v.max(),
                         rng=v.max()-v.min(),first3=f,last3=l,trend='down' if l<f else 'up'))
    return pd.DataFrame(rows).set_index('phase')

def analyse(tag,df,cols,standardize=True,verbose=True):
    loads,scores,evr,X=pca_run(df,cols,standardize)
    s,anchor=orient(loads); loads['PC1']*=s; scores['PC1']*=s
    pt=phase_tbl(scores)
    gt=pd.DataFrame({'PC1_mean':scores['PC1'].groupby(df.group.values,sort=False).mean(),
                     'PC1_sd':scores['PC1'].groupby(df.group.values,sort=False).std(ddof=1),
                     'n':scores['PC1'].groupby(df.group.values,sort=False).size()}).reindex(GRP_ORDER)
    res=dict(tag=tag,n=len(df),p=len(cols),standardized=standardize,var_PC1=evr[0],var_PC2=evr[1],
             var_PC3=evr[2],var_PC12=evr[0]+evr[1],anchor=anchor,sign=s,
             MN=pt.loc['MN_3400-3000','mean'],YN=pt.loc['YN_2900-2300','mean'],
             diff=pt.loc['MN_3400-3000','mean']-pt.loc['YN_2900-2300','mean'],
             sd_all=scores['PC1'].std(ddof=1))
    if verbose:
        print('='*104); print(tag)
        print('EVR PC1 %.4f | PC2 %.4f | PC3 %.4f | PC1+2 %.4f | anchor=%s sign=%+d'
              %(evr[0],evr[1],evr[2],evr[0]+evr[1],anchor,s))
        L=loads.copy(); L['category']=[COL2CAT[i] for i in L.index]
        print(L.sort_values('PC1',key=abs,ascending=False).round(3).to_string())
        for pc in ['PC1','PC2','PC3']:
            print('-- %s category consistency --'%pc); print(cat_stats(loads[pc]).round(3).to_string(index=False))
        for ph,yrs in PHASES.items():
            v=scores.loc[[y for y in yrs if y in scores.index],'PC1']
            print('  %-14s '%ph+', '.join(f'{y}:{x:+.2f}' for y,x in v.items()))
        print(pt.round(3).to_string()); print('-- all periods (group column) --'); print(gt.round(3).to_string())
        print('PC1 sd(all %d) = %.3f | MN=%.3f YN=%.3f MN-YN=%+.3f (=%.2f PC1 sd)'
              %(len(df),res['sd_all'],res['MN'],res['YN'],res['diff'],res['diff']/res['sd_all']))
    return dict(loads=loads,scores=scores,evr=evr,phase=pt,groups=gt,res=res,X=X,df=df)

