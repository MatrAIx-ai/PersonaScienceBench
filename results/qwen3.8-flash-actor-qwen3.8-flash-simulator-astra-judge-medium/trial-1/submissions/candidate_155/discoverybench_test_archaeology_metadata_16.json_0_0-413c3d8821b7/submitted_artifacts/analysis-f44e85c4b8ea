print('\n#### statistical tests on the two phase scores (MAIN PC1) ####')
sc=MAIN['scores']['PC1']; a=sc.loc[PHASES['MN_3400-3000']].values; b=sc.loc[PHASES['YN_2900-2300']].values
def t_one(x,mu=0.0):
    t=(x.mean()-mu)/(x.std(ddof=1)/np.sqrt(len(x))); return t
def welch(x,y):
    vx,vy=x.var(ddof=1)/len(x),y.var(ddof=1)/len(y); t=(x.mean()-y.mean())/np.sqrt(vx+vy)
    dfree=(vx+vy)**2/(vx**2/(len(x)-1)+vy**2/(len(y)-1)); return t,dfree
print('MN mean %+.3f  t vs 0 = %.2f (n=5) | YN mean %+.3f  t vs 0 = %.2f (n=7)'%(a.mean(),t_one(a),b.mean(),t_one(b)))
t,dfree=welch(a,b); print('Welch MN vs YN: t=%.2f df=%.1f  diff=%+.3f'%(t,dfree,a.mean()-b.mean()))
rng=np.random.default_rng(11); pool=np.concatenate([a,b]); n=len(a); obs=a.mean()-b.mean()
perm=np.array([rng.permutation(pool)[:n].mean()-rng.permutation(pool)[n:].mean() for _ in range(20000)])
print('permutation test (20k): two-sided p = %.3f | effect size (pooled sd) d = %.2f'
      %((np.abs(perm)>=abs(obs)).mean(), obs/np.sqrt(((len(a)-1)*a.var(ddof=1)+(len(b)-1)*b.var(ddof=1))/(len(a)+len(b)-2))))
print('difference in units of a single indicator SD (all indicators standardised to SD=1): %+.2f'%obs)
print('difference in units of PC1 SD over all 37 slices: %+.2f'%(obs/sc.std(ddof=1)))
