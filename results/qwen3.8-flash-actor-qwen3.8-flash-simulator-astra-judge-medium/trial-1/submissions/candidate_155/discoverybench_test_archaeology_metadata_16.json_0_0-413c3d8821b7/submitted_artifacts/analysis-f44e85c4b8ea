print('\n#### robustness with orientation locked to MAIN (sign aligned by correlation) ####')
mains=MAIN['scores']['PC1']
rows=[]
def aligned(ddf,cols,label,drop):
    loads,scores,evr,_=pca_run(ddf,cols,True)
    v=scores['PC1']
    # keep only rows present in ddf, align sign to MAIN PC1 on the common slices
    common=[y for y in mains.index if y in v.index]
    s=1.0 if np.corrcoef(mains.loc[common].values,v.loc[common].values)[0,1]>0 else -1.0
    v=v*s; scores['PC1']=v
    pt=phase_tbl(scores)
    return dict(label=label,drop=drop,var_PC1=evr[0],flip=int(s<0),
                MN=pt.loc['MN_3400-3000','mean'],YN=pt.loc['YN_2900-2300','mean'],
                diff=pt.loc['MN_3400-3000','mean']-pt.loc['YN_2900-2300','mean'],
                MN_neg=int(pt.loc['MN_3400-3000','mean']<0),YN_neg=int(pt.loc['YN_2900-2300','mean']<0))
for d in F37.BCE:
    rows.append(aligned(F37[F37.BCE!=d].reset_index(drop=True),Z,'leave_out_slice',d))
for d in Z:
    rows.append(aligned(F37,[c for c in Z if c!=d],'leave_out_indicator',d))
rows.append(aligned(F39,Z,'39_row_frame',0))
rows.append(aligned(F37[F37.BCE.isin(PHASES['MN_3400-3000']+PHASES['YN_2900-2300'])].reset_index(drop=True),Z,'12-row_subset_PCA',0))
rob=pd.DataFrame(rows); rob.to_csv('out/robustness_aligned.csv',index=False)
for lab in ['leave_out_slice','leave_out_indicator','39_row_frame','12-row_subset_PCA']:
    r=rob[rob.label==lab]
    print('%-20s n=%2d | diff %+.3f .. %+.3f | MN<YN in %d/%d | both phases negative in %d/%d | axis flipped in %d'
          %(lab,len(r),r['diff'].min(),r['diff'].max(),(r['diff']<0).sum(),len(r),
            ((r.MN_neg==1)&(r.YN_neg==1)).sum(),len(r),r.flip.sum()))
print(rob.sort_values('diff').round(3).to_string(index=False))
