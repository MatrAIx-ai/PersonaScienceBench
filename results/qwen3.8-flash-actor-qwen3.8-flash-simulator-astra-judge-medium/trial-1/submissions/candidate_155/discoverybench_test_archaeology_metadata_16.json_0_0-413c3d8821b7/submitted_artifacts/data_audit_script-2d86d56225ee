"""READ-ONLY data audit for the Neolithic capital-PCA question.
No modelling is performed here: only shape, time conventions, missingness,
standardisation checks and cross-file consistency.
"""
import pandas as pd, numpy as np

CAP = 'data/capital.csv'
TS  = 'data/time_series_data.csv'
POL = 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'
Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort',
     'ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
MAP = dict(zip(Z, ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount',
                   'Depot','Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']))

c = pd.read_csv(CAP, decimal=',')
t = pd.read_csv(TS)
p = pd.read_csv(POL, decimal=',').sort_values('CE')

print('== 1 shapes ==', c.shape, t.shape, p.shape)
print('== BCE range / step ==', c.BCE.min(), c.BCE.max(), np.unique(-np.diff(c.BCE.values)))
print('== CE(calBP) TS ==', t.CE.min(), t.CE.max(), t.calBP.min(), t.calBP.max(),
      'calBP+CE==1950:', bool(((t.calBP+t.CE)==1950).all()))
print('== CE(calBP) POL ==', p.CE.min(), p.CE.max(), 'calBP+CE==1950:', bool(((p.calBP+p.CE)==1950).all()))

print('== Z summary (capital.csv, n=%d) ==' % len(c))
print(c[Z].agg(['count','mean','std','min','max']).T.round(4).to_string())
print('missing:', c[Z].isna().sum().sum(), '| exact zeros per col:',
      {k:int(v) for k,v in (c[Z]==0).sum().items() if v})

print('== group / color ==')
print(c.groupby('group', sort=False).BCE.agg(['min','max','count']).to_string())
print(pd.crosstab(c.group, c.color).to_string())

print('== phase windows ==')
for nm, lo, hi in [('MN 3400-3000', 3000, 3400), ('Younger Neolithic 2900-2300', 2300, 2900)]:
    s = c[(c.BCE>=lo)&(c.BCE<=hi)]
    print(nm, 'n=', len(s), 'BCE', sorted(s.BCE, reverse=True), 'groups', list(s.group.unique()))

print('== cross-file consistency (capital vs time_series raw) ==')
ts = t[t.HatchetSword.notna()].copy(); ts['BCE'] = -ts.CE
for a, b in MAP.items():
    m = c[['BCE', a]].merge(ts[['BCE', b]], on='BCE')
    print(f'{a:12s} {b:18s} n={len(m)} maxabsdiff={(m[a]-m[b]).abs().max():.2e}')
print('century points in capital but absent from time_series raw:',
      sorted(set(c.BCE) - set(ts.BCE)))
print('duplicate Z rows in capital.csv:', int(c[Z].duplicated(keep="first").sum()))

print('== pollen cross-file ==')
mm = t[['CE','pollen','pollen_inter','pollen_inter_100']].merge(
        p[['CE','Belau_PC1','Belau_PC1_inter','SMOOTH_MEAN_100y']], on='CE')
print('raw pollen vs Belau_PC1: maxdiff %.2e (n_overlap=%d)'
      % ((mm.pollen-mm.Belau_PC1).abs().max(), (mm.pollen.notna()&mm.Belau_PC1.notna()).sum()))
print('pollen_inter vs Belau_PC1_inter: differing rows=%d maxdiff %.3f'
      % (((mm.pollen_inter-mm.Belau_PC1_inter).abs()>1e-6).sum(),
         (mm.pollen_inter-mm.Belau_PC1_inter).abs().max()))
print('pollen_inter_100 vs SMOOTH_MEAN_100y: maxdiff %.3f  (SMOOTH_MEAN_100y is Belau+Woserin mean-smoothed)'
      % (mm.pollen_inter_100-mm.SMOOTH_MEAN_100y).abs().max())
for nm, lo, hi in [('MN 3400-3000', -3400, -3000), ('YN 2900-2300', -2900, -2300)]:
    s = p[(p.CE>=lo)&(p.CE<=hi)]
    print(nm, 'pollen SMOOTH_MEAN_100y mean %.3f  (Belau_PC1_inter mean %.3f)'
          % (s.SMOOTH_MEAN_100y.mean(), s.Belau_PC1_inter.mean()))
