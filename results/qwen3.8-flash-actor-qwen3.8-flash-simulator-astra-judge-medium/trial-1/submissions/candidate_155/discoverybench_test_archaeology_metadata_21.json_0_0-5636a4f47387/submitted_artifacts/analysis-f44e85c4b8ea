#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""PCA on forms of capital in 100-year time slices (BCE 4100-500).

Main design (approved): observations = 37 slices (BCE 4100..500, all 12
indicators present), variables = 12 capital Z indicators, correlation-matrix
PCA, unrotated primary, raw capital columns only (no *_inter).
Sensitivity: 39 slices, covariance PCA, ZMW-outlier slice removed, varimax,
oblimin, interpolation-window binning, bootstrap over slices.
"""
import json
import numpy as np
import pandas as pd

DATA, OUT = "data", "analysis"

CAT = {"ZAxtSchwert": "symbolic", "ZDolch": "symbolic", "Zhausgr": "symbolic",
       "ZCU_AU": "social", "Zamber": "social", "ZMonument": "social",
       "ZKeform": "cultural", "Zkeverz": "cultural",
       "ZHort": "economic", "ZSichel": "economic", "ZBeil": "economic",
       "ZMW": "economic"}
VARS = list(CAT)
SYM = ["ZAxtSchwert", "ZDolch", "Zhausgr"]
CATS = ["symbolic", "social", "cultural", "economic"]
RAW2CAP = {"HatchetSword": "ZAxtSchwert", "Dagger": "ZDolch",
           "HouseSize": "Zhausgr", "CopperGold": "ZCU_AU", "Amber": "Zamber",
           "MonumentCount": "ZMonument", "Depot": "ZHort", "Sickle": "ZSichel",
           "AxesCelts": "ZBeil", "MonumentSize": "ZMW",
           "PotteryForm": "ZKeform", "PotteryDecoration": "Zkeverz"}


def pca(X, matrix="corr"):
    if matrix == "corr":
        Z = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)
    else:
        Z = X - X.mean(axis=0)
    S = np.cov(Z, rowvar=False, ddof=1)
    w, V = np.linalg.eigh(S)
    o = np.argsort(w)[::-1]
    w, V = np.clip(w[o], 0, None), V[:, o]
    return dict(eig=w, vec=V, load=V * np.sqrt(w), scores=Z @ V * np.sqrt(w),
                varexp=w / w.sum() * 100.0, cum=np.cumsum(w / w.sum() * 100.0),
                n=X.shape[0], p=X.shape[1], matrix=matrix)


def orient(L, cols, mode, return_sign=False):
    L = L.copy(); sgn = np.ones(L.shape[1])
    for j in range(L.shape[1]):
        if mode == "maxabs":
            s = np.sign(L[np.argmax(np.abs(L[:, j])), j]) or 1.0
        elif mode == "sumpos":
            s = np.sign(L[:, j].sum()) or 1.0
        elif mode == "sympos":
            s = np.sign(L[[cols.index(v) for v in SYM], j].mean()) or 1.0
        else:
            raise ValueError(mode)
        if s < 0:
            L[:, j] *= -1; sgn[j] = -1.0
    return (L, sgn) if return_sign else L


def load_main():
    cap = pd.read_csv(f"{DATA}/capital.csv", decimal=",")
    cap["CE"] = -cap["BCE"]
    cap = cap[cap.BCE <= 4100].sort_values("CE").reset_index(drop=True)
    assert cap.shape[0] == 37, cap.shape
    return cap


def bin_summary():
    ts = pd.read_csv(f"{DATA}/time_series_data.csv", index_col=0)
    ts["bin"] = np.floor(ts.CE / 100) * 100
    g = ts.groupby("bin").size()
    rows = {}
    for anchor, _sub in ts.groupby("bin"):
        w = ts[(ts.CE > anchor - 50) & (ts.CE <= anchor + 50)]
        rows[anchor] = {RAW2CAP[c]: w[c + "_inter"].mean() for c in RAW2CAP}
    return ts, g, pd.DataFrame.from_dict(rows, orient="index").sort_index()


def loadings_frame(L, orientation, cols):
    d = pd.DataFrame(L[:, :4], index=cols, columns=["PC1", "PC2", "PC3", "PC4"])
    d.insert(0, "capital_category", [CAT[c] for c in cols])
    d["h2_PC1-4"] = (L[:, :4] ** 2).sum(axis=1)
    d["h2_all"] = (L ** 2).sum(axis=1)
    d["abs_rank_PC1"] = d["PC1"].abs().rank(ascending=False).astype(int)
    d["abs_rank_PC2"] = d["PC2"].abs().rank(ascending=False).astype(int)
    d.attrs["orientation"] = orientation
    return d


def cat_means(d):
    m = d.groupby("capital_category")[["PC1", "PC2", "PC3"]].mean().reindex(CATS)
    m.insert(0, "n_vars", d.groupby("capital_category").size().reindex(CATS))
    m["mean_abs_PC1"] = d.assign(a=d.PC1.abs()).groupby("capital_category").a.mean().reindex(CATS)
    m["mean_abs_PC2"] = d.assign(a=d.PC2.abs()).groupby("capital_category").a.mean().reindex(CATS)
    return m


def describe_scores(s, label):
    q = np.percentile(s, [0, 25, 50, 75, 100])
    iqr, rng = q[3] - q[1], q[4] - q[0]
    x = np.sort(s); gaps = np.diff(x); k = int(np.argmax(gaps))
    print(f"  {label}\n     n={len(s)} min={q[0]:+.3f} Q1={q[1]:+.3f} med={q[2]:+.3f} "
          f"Q3={q[3]:+.3f} max={q[4]:+.3f} range={rng:.3f} IQR={iqr:.3f} "
          f"pos/neg={int((s>0).sum())}/{int((s<0).sum())} | largest gap={gaps.max():.3f} "
          f"({gaps.max()/rng:.1%} of range) at [{x[k]:+.3f},{x[k+1]:+.3f}]")
    return dict(cohort=label, n=len(s), min=q[0], Q1=q[1], median=q[2], Q3=q[3],
                max=q[4], range=rng, IQR=iqr, n_pos=int((s > 0).sum()),
                n_neg=int((s < 0).sum()), IQR_over_range=iqr / rng,
                largest_gap=gaps.max(), largest_gap_share=gaps.max() / rng)


def _ac1(x):
    x = np.asarray(x, float) - np.mean(x)
    return float((x[:-1] * x[1:]).sum() / (x * x).sum()) if (x * x).sum() > 0 else np.nan


def svg_scatter(d, path, title):
    colors = {"symbolic": "#c0392b", "social": "#1f6fb5",
              "cultural": "#1e8449", "economic": "#b7950b"}
    W, H, M = 820, 600, 80
    xs, ys = d["PC1"].values, d["PC2"].values
    lo_x, hi_x = min(xs.min(), -0.2) - .18, max(xs.max(), .2) + .22
    lo_y, hi_y = min(ys.min(), -0.2) - .18, max(ys.max(), .2) + .22
    sx = lambda v: M + (v - lo_x) / (hi_x - lo_x) * (W - 2 * M)
    sy = lambda v: H - M - (v - lo_y) / (hi_y - lo_y) * (H - 2 * M)
    p = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">',
         f'<rect width="{W}" height="{H}" fill="white"/>',
         f'<line x1="{sx(lo_x):.1f}" y1="{sy(0):.1f}" x2="{sx(hi_x):.1f}" y2="{sy(0):.1f}" stroke="#999"/>',
         f'<line x1="{sx(0):.1f}" y1="{sy(lo_y):.1f}" x2="{sx(0):.1f}" y2="{sy(hi_y):.1f}" stroke="#999"/>',
         f'<text x="{W/2}" y="{H-22}" text-anchor="middle" font-size="14">PC1 loading (corr-PCA, unrotated)</text>',
         f'<text x="20" y="{H/2}" font-size="14" transform="rotate(-90 20 {H/2})">PC2 loading</text>',
         f'<text x="{W/2}" y="26" text-anchor="middle" font-size="15">{title}</text>']
    for name, r in d.iterrows():
        c = colors[r["capital_category"]]
        p.append(f'<circle cx="{sx(r.PC1):.1f}" cy="{sy(r.PC2):.1f}" r="5.5" fill="{c}"/>')
        p.append(f'<text x="{sx(r.PC1)+8:.1f}" y="{sy(r.PC2)+4:.1f}" font-size="11" fill="#222">'
                 f'{name} ({r.capital_category[0].upper()})</text>')
    lx, ly = W - 170, 50
    for i, c in enumerate(CATS):
        p.append(f'<circle cx="{lx}" cy="{ly+i*18}" r="5.5" fill="{colors[c]}"/>'
                 f'<text x="{lx+10}" y="{ly+i*18+4}" font-size="11">{c}</text>')
    p.append("</svg>")
    open(path, "w").write("\n".join(p))


def main():
    cap = load_main()
    ts, binsizes, inter_bins = bin_summary()
    cols, X = VARS, cap[VARS].astype(float).values

    res = pca(X, "corr")
    Lraw = res["load"][:, :4]
    Lmain, sgnA = orient(Lraw, cols, "maxabs", return_sign=True)   # sign convention A
    Lflip = -Lmain                                   # sign convention B (companion)
    Lpres = orient(Lraw, cols, "sympos")             # display orientation: symbolic mean > 0

    d_main = loadings_frame(Lmain, "A: largest |loading| positive per PC", cols)
    d_flip = loadings_frame(Lflip, "B: companion solution (= A x -1)", cols)
    d_pres = loadings_frame(Lpres, "C: display, mean symbolic loading positive", cols)
    var_tab = pd.DataFrame({"component": [f"PC{i+1}" for i in range(res["p"])],
                            "eigenvalue": res["eig"], "pct_var": res["varexp"],
                            "cum_pct_var": res["cum"]})
    # scores must carry the SAME sign convention as the reported loadings
    scores = pd.DataFrame(res["scores"][:, :4] * sgnA, columns=["PC1", "PC2", "PC3", "PC4"])
    scores.insert(0, "CE", cap.CE.values); scores.insert(1, "BCE", cap.BCE.values)
    scores.insert(2, "group", cap["group"].values)
    for v in VARS:
        scores[v] = cap[v].values

    print("=" * 100)
    print("MAIN PCA | 37 slices (BCE 4100-500) x 12 capital indicators | correlation matrix | unrotated")
    print(f"n={res['n']} p={res['p']} eigenvalues={np.round(res['eig'],3).tolist()}")
    print(var_tab.head(6).round(2).to_string(index=False))
    print("\n-- loadings, sign convention A --")
    print(d_main.round(3).to_string())
    print("\n-- loadings, sign convention B (companion flip) --")
    print(d_flip[["capital_category", "PC1", "PC2", "abs_rank_PC1", "abs_rank_PC2"]].round(3).to_string())
    print("\n-- category mean loadings (convention A) --")
    cm = cat_means(d_main); print(cm.round(3).to_string())

    print("\n" + "=" * 100)
    print("SYMBOLIC CAPITAL (ZAxtSchwert/HatchetSword, ZDolch/Dagger, Zhausgr/HouseSize)")
    others = [v for v in cols if v not in SYM]
    symd = d_main.loc[SYM]
    print(symd[["PC1", "PC2", "PC3", "h2_PC1-4", "abs_rank_PC1", "abs_rank_PC2"]].round(3).to_string())
    sg = np.sign(symd["PC1"].values)
    print(f"[PC1] values={np.round(symd['PC1'].values,3).tolist()} all-same-sign={bool((sg==sg[0]).all())}")
    print(f"      mean|PC1| symbolic={symd['PC1'].abs().mean():.3f} vs non-symbolic="
          f"{d_main.loc[others,'PC1'].abs().mean():.3f} vs all={d_main['PC1'].abs().mean():.3f}")
    print(f"      ranks PC1={symd['abs_rank_PC1'].tolist()}  ranks PC2={symd['abs_rank_PC2'].tolist()} "
          f"(1 = largest |loading| of 12)")
    print(f"      PC1 range across the 3 = {symd['PC1'].max()-symd['PC1'].min():.3f}; "
          f"non-symbolic PC1 range = {d_main.loc[others,'PC1'].max()-d_main.loc[others,'PC1'].min():.3f}")
    print(f"[PC2-a: loadings] values={np.round(symd['PC2'].values,3).tolist()} "
          f"min={symd['PC2'].min():+.3f} max={symd['PC2'].max():+.3f} "
          f"range={symd['PC2'].max()-symd['PC2'].min():.3f} sd={symd['PC2'].std(ddof=1):.3f} "
          f"crosses-zero={bool((symd['PC2']>0).any() and (symd['PC2']<0).any())}")
    for c in CATS:
        vs = [v for v in cols if CAT[v] == c]
        print(f"  {c:9s} meanPC1={d_main.loc[vs,'PC1'].mean():+.3f} meanPC2={d_main.loc[vs,'PC2'].mean():+.3f} "
              f"mean|PC1|={d_main.loc[vs,'PC1'].abs().mean():.3f} mean|PC2|={d_main.loc[vs,'PC2'].abs().mean():.3f} "
              f"|PC1| ranks={sorted(d_main.loc[vs,'abs_rank_PC1'].tolist())}")

    print("\n[PC2-b: slice scores] distribution of slice PC2 scores")
    diag = [describe_scores(scores["PC2"].values, "ALL 37 slices")]
    for v in SYM:
        top = cap[v].sort_values(ascending=False).head(8).index
        bot = cap[v].sort_values().head(8).index
        diag.append(describe_scores(scores.loc[top, "PC2"].values,
                    f"top-8 slices by {v} (BCE {sorted(cap.loc[top,'BCE'], reverse=True)})"))
        diag.append(describe_scores(scores.loc[bot, "PC2"].values,
                    f"bottom-8 slices by {v} (BCE {sorted(cap.loc[bot,'BCE'], reverse=True)})"))
        r2 = np.corrcoef(cap[v].values, scores["PC2"].values)[0, 1]
        print(f"      r({v}, PC2 score) = {r2:+.3f}  (should equal PC2 loading {d_main.loc[v,'PC2']:+.3f})")
    print("\n-- slice scores (37 slices) --")
    print(scores[["CE", "BCE", "group", "PC1", "PC2", "PC3"]].round(3).to_string(index=False))

    print("\n" + "=" * 100)
    print("SENSITIVITY / ROBUSTNESS")
    sens = []

    def rec(name, res2, note=""):
        k = 3
        L2 = orient(res2["load"][:, :k], cols, "maxabs")
        s = pd.DataFrame(L2, index=cols)  # rows = variables, cols = PCs
        rk = pd.Series(np.abs(L2[:, 0])).rank(ascending=False).astype(int)
        r2k = pd.Series(np.abs(L2[:, 1])).rank(ascending=False).astype(int)
        row = dict(model=name, note=note, n_slices=res2["n"], matrix=res2["matrix"],
                   PC1_pct=res2["varexp"][0], PC12_pct=res2["cum"][1], PC123_pct=res2["cum"][2])
        for v in SYM:
            row[f"PC1_{v}"] = s.loc[v, 0]; row[f"PC2_{v}"] = s.loc[v, 1]
            row[f"rank1_{v}"] = int(rk[cols.index(v)]); row[f"rank2_{v}"] = int(r2k[cols.index(v)])
        row["sym_PC1_same_sign"] = bool(np.all(np.sign(s.loc[SYM, 0].values) == np.sign(s.loc[SYM, 0].values[0])))
        row["sym_PC2_cross_zero"] = bool((s.loc[SYM, 1] > 0).any() and (s.loc[SYM, 1] < 0).any())
        row["sym_mean_abs_PC1"] = float(s.loc[SYM, 0].abs().mean())
        row["nonsym_mean_abs_PC1"] = float(s.iloc[[cols.index(v) for v in cols if v not in SYM], 0].abs().mean())
        sens.append(row)
        print(f"  {name} [n={res2['n']}, {res2['matrix']}]: varPC1={row['PC1_pct']:.1f}% "
              f"PC1+2={row['PC12_pct']:.1f}% | sym PC1={[round(float(s.loc[v,0]),3) for v in SYM]} "
              f"rank1={[row[f'rank1_{v}'] for v in SYM]} same-sign={row['sym_PC1_same_sign']} | "
              f"sym PC2={[round(float(s.loc[v,1]),3) for v in SYM]} cross0={row['sym_PC2_cross_zero']} | "
              f"mean|PC1| sym={row['sym_mean_abs_PC1']:.3f} nonsym={row['nonsym_mean_abs_PC1']:.3f}")

    rec("M0 main: 37 slices, corr, unrotated", res, "basis of conclusions")
    cap39 = pd.read_csv(f"{DATA}/capital.csv", decimal=",").sort_values("BCE")
    rec("S1 39 slices incl. BCE 4300/4200 padding", pca(cap39[VARS].values.astype(float), "corr"),
        "padding rows identical to BCE 4100")
    rec("S2 covariance matrix (no rescaling)", pca(X, "cov"),
        "tests ZSichel sd=0.538 / 74% zeros metric effect")
    keep = cap.ZMW.values > -3.13   # drops only the -3.134 slice
    rec("S3 drop slice with ZMW=-3.134 (BCE 4100)", pca(X[keep], "corr"), "outlier-observation check")
    rec("S4 drop BCE 4100 & 500 (edge slices)", pca(X[(cap.BCE.values > 500) & (cap.BCE.values < 4100)], "corr"),
        "edge-effect check")
    try:                                    # rotation appendix (sensitivity only)
        from statsmodels.multivariate.factor_rotation import rotate_factors, promax
        L3 = res["load"][:, :3]
        rot = {"varimax_orthogonal_g1": (("orthomax", 1.0),),
               "oblimin_quartimin_oblique_g0": (("oblimin", 0.0, "oblique"),),
               "oblimin_oblique_g0.5": (("oblimin", 0.5, "oblique"),)}
        for nm, (args,) in rot.items():
            Lr = pd.DataFrame(np.asarray(rotate_factors(L3, *args)[0]), index=cols)
            print(f"\n  {nm} (3 PCs; sign set so each PC's largest |loading| is positive):")
            print(orient(Lr.values, cols, "maxabs")[0].round(3).to_string(index=False)
                  if False else Lr.round(3).to_string())
            print("    symbolic rows: " + ", ".join(
                f"{v}: {['%+.3f' % Lr.loc[v, j] for j in range(3)]}" for v in SYM))
            Lr.round(4).to_csv(f"{OUT}/rotated_{nm}.csv", index_label="variable")
        Lp = rotate_factors(rotate_factors(L3, "orthomax", 1.0)[0], "promax", 2)[0] \
            if False else promax(L3, k=2)
        pd.DataFrame(np.asarray(Lp[0] if isinstance(Lp, tuple) else Lp), index=cols
                     ).round(4).to_csv(f"{OUT}/rotated_promax_k2.csv", index_label="variable")
        print("\n  promax (k=2) written to rotated_promax_k2.csv")
    except Exception as e:
        print("  rotation failed:", type(e).__name__, e)
    rec("S5 +-50y window mean of *_inter", pca(inter_bins[VARS].values.astype(float), "corr"),
        "interpolation-driven contrast, not evidence")

    rng = np.random.default_rng(7)
    B = []
    for b in range(2000):
        idx = rng.integers(0, X.shape[0], X.shape[0])
        if np.std(X[idx], axis=0, ddof=1).min() == 0:
            continue
        Lb = pca(X[idx], "corr")["load"][:, :2]
        for j in range(2):
            if np.sign(Lb[cols.index("ZCU_AU"), j]) != np.sign(Lmain[cols.index("ZCU_AU"), j]):
                Lb[:, j] *= -1
        B.append(Lb[[cols.index(v) for v in SYM], :].T.ravel())   # PC1 block, then PC2 block
    B = np.array(B)
    ci = np.percentile(B, [2.5, 50, 97.5], axis=0)
    boot = pd.DataFrame({"parameter": [f"{v}_PC{i+1}" for i in (0, 1) for v in SYM],
                         "point_estimate": [d_main.loc[v, f"PC{i+1}"] for i in (0, 1) for v in SYM],
                         "boot_p2.5": ci[0], "boot_median": ci[1], "boot_p97.5": ci[2],
                         "sign_stability_pct": [100 * float(np.mean(B[:, k] * np.sign(ci[1][k]) > 0)) for k in range(B.shape[1])]})
    print(f"\n-- bootstrap resampling slices (B={len(B)}), sign anchored on ZCU_AU --")
    print(boot.round(3).to_string(index=False))
    boot.round(4).to_csv(f"{OUT}/bootstrap_loadings_CI.csv", index=False)

    # ---- extra diagnostics that the written answer relies on -----------------
    from scipy.stats import spearmanr
    tt = []
    for pc in ["PC1", "PC2", "PC3"]:
        tt.append(dict(component=pc, r_with_BCE=np.corrcoef(cap.BCE.values, scores[pc])[0, 1],
                       spearman_with_BCE=spearmanr(cap.BCE.values, scores[pc]).statistic,
                       lag1_autocorr=_ac1(scores[pc].values),
                       pct_slices_positive=100 * float((scores[pc].values > 0).mean())))
    tt = pd.DataFrame(tt)
    print("\n-- PC axes vs chronological time (BCE decreasing = time increasing) --")
    print(tt.round(3).to_string(index=False))
    tt.round(4).to_csv(f"{OUT}/pc_time_trend.csv", index=False)

    sq = pd.DataFrame(res["load"] ** 2, index=cols, columns=[f"PC{i+1}" for i in range(res["p"])])
    share = (sq.div(sq.sum(axis=1), axis=0) * 100).iloc[:, :5]
    share.insert(0, "capital_category", [CAT[c] for c in cols])
    share["lag1_autocorr_of_indicator"] = [_ac1(cap[c].values) for c in cols]
    print("\n-- % of each indicator's variance carried by PC1-PC5 (squared loadings) --")
    print(share.round(1).to_string())
    share.round(3).to_csv(f"{OUT}/variance_share_by_axis.csv")

    rng2 = np.random.default_rng(11)
    pc2v = scores["PC2"].values
    null_IQR = []
    for _ in range(20000):
        k = rng2.choice(len(pc2v), 8, replace=False)
        null_IQR.append(np.percentile(pc2v[k], 75) - np.percentile(pc2v[k], 25))
    null_IQR = np.array(null_IQR)
    rows = []
    for v in cols:
        top = cap[v].sort_values(ascending=False).head(8).index.values
        o = float(np.percentile(pc2v[top], 75) - np.percentile(pc2v[top], 25))
        rows.append(dict(indicator=v, capital_category=CAT[v],
                         top8_PC2_IQR=o, null_mean_IQR=float(null_IQR.mean()),
                         p_IQR_ge_null=(float((null_IQR >= o).sum()) + 1) / (len(null_IQR) + 1),
                         top8_PC2_range=float(pc2v[top].max() - pc2v[top].min()),
                         top8_n_pos=float((pc2v[top] > 0).sum()), top8_n_neg=float((pc2v[top] < 0).sum())))
    perm = pd.DataFrame(rows)
    print("\n-- permutation test: PC2 spread of the 8 highest slices per indicator --")
    print(perm.round(3).to_string(index=False))
    perm.round(4).to_csv(f"{OUT}/pc2_spread_permutation.csv", index=False)

    d_main.to_csv(f"{OUT}/loadings.csv", index_label="variable")
    d_flip.to_csv(f"{OUT}/loadings_flipped_sign_solution.csv", index_label="variable")
    d_pres.to_csv(f"{OUT}/loadings_display_orientation.csv", index_label="variable")
    var_tab.round(6).to_csv(f"{OUT}/variance_explained.csv", index=False)
    scores.round(6).to_csv(f"{OUT}/slice_scores.csv", index=False)
    cm.round(4).to_csv(f"{OUT}/category_mean_loadings.csv")
    pd.DataFrame(diag).round(4).to_csv(f"{OUT}/pc2_distribution_diagnostics.csv", index=False)
    pd.DataFrame(sens).round(4).to_csv(f"{OUT}/sensitivity_models.csv", index=False)
    svg_scatter(d_main, f"{OUT}/loading_biplot_pc1_pc2.svg",
                "Loading scatter of 12 capital indicators, PC1 vs PC2 (37 slices, corr-PCA, unrotated)")
    pd.DataFrame({"bin_start_CE": binsizes.index, "n_years_in_bin": binsizes.values}).to_csv(
        f"{OUT}/slice_bin_sizes.csv", index=False)
    summary = dict(main_slices=int(res["n"]), variables=cols,
                   eigenvalues=[round(float(x), 4) for x in res["eig"]],
                   pct_PC1=round(float(res["varexp"][0]), 2),
                   cum_pct_PC1_PC2=round(float(res["cum"][1]), 2),
                   cum_PC1_2_3=round(float(res["cum"][2]), 2),
                   sym_PC1={v: round(float(d_main.loc[v, 'PC1']), 3) for v in SYM},
                   sym_PC2={v: round(float(d_main.loc[v, 'PC2']), 3) for v in SYM},
                   sym_PC1_ranks=[int(d_main.loc[v, 'abs_rank_PC1']) for v in SYM],
                   bins=dict(n=int(len(binsizes)), min_years=int(binsizes.min()),
                             max_years=int(binsizes.max())))
    json.dump(summary, open(f"{OUT}/run_summary.json", "w"), indent=2)
