"""Main analysis for the DiscoveryBench question:
'Between 3400 BCE to 3000 BCE, how does the number of monuments and axes change
with elements of symbolic capital?'

Fixed classification (confirmed by the researcher):
  symbolic : HatchetSword (ZAxtSchwert), Dagger (ZDolch), HouseSize (Zhausgr)
  social   : CopperGold (ZCU_AU), Amber (Zamber), MonumentCount (ZMonument)
  cultural : PotteryForm (ZKeform), PotteryDecoration (Zkeverz)
  economic : Depot (ZHort), Sickle (ZSichel), AxesCelts (ZBeil), MonumentSize (ZMW)
Outcomes of the question: MonumentCount (social capital), AxesCelts (economic capital).
Primary window: 3400-3000 BCE (5 anchors, group MN). Robustness windows only for
stability checks: 3500-3000, 3600-2800, 4000-2500 BCE.
Capital series are never imputed: only the 37 raw Z anchors of
time_series_data.csv (== capital.csv, verified in inspect_inputs.py) are used.
"""
import itertools, numpy as np, pandas as pd
from scipy import stats

rng = np.random.default_rng(20261022)
R2 = lambda x: np.round(x, 4)

ts = pd.read_csv('data/time_series_data.csv', index_col=0).set_index('CE')
cap = pd.read_csv('data/capital.csv', decimal=',').set_index('BCE')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')

SYMBOLIC = ['HatchetSword', 'Dagger', 'HouseSize']
SOCIAL = ['CopperGold', 'Amber']
CULTURAL = ['PotteryForm', 'PotteryDecoration']
ECONOMIC = ['Depot', 'Sickle', 'MonumentSize']
OUTCOMES = ['MonumentCount', 'AxesCelts']

anchor = ts[ts['MonumentCount'].notna()].copy().sort_index()
anchor['BCE'] = -anchor.index
anchor['SymIdx'] = anchor[SYMBOLIC].mean(axis=1)      # unweighted mean of the three Z

def var_shares(df, elems, idx):
    v = df[idx].var(ddof=1)
    return {c: ((1 / len(elems)) * df[c].cov(df[idx]) / v if v > 0 else np.nan) for c in elems}

def bin_mean(col, centres):
    out = {}
    for c in centres:
        sl = ts.loc[max(c - 49, ts.index.min()):min(c + 50, ts.index.max()), col].dropna()
        out[c] = sl.mean() if len(sl) else np.nan
    return pd.Series(out)

for col in ['pollen_inter', 'pollen_grate_100', 'kde_all_mean', 'g_all_mean', 'kde_all_detrend']:
    anchor['b_' + col] = bin_mean(col, anchor.index.values)
anchor['Belau_PC1_inter'] = pol['Belau_PC1_inter'].reindex(anchor.index)
anchor['Woserin_PC1_inter'] = pol['Woserin_PC1_inter'].reindex(anchor.index)
anchor['Pollen_MEAN'] = pol['MEAN'].reindex(anchor.index)
anchor['group'] = cap['group'].reindex(anchor['BCE']).values

WINDOWS = {'3400-3000 BCE (PRIMARY)': (3400, 3000), '3500-3000 BCE': (3500, 3000),
           '3600-2800 BCE': (3600, 2800), '4000-2500 BCE': (4000, 2500)}
get = lambda lo, hi: anchor.loc[-lo:-hi].sort_index()

def r_crit(n, alpha=0.05):
    if n <= 3: return np.nan
    t = stats.t.ppf(1 - alpha / 2, n - 2)
    return float(np.sqrt(t ** 2 / (t ** 2 + n - 2)))


def fast_perm_p(x, y, r_obs, nperm=20000, chunk=4000):
    """Vectorised two-sided permutation p for Pearson r (permutation of x).
    r_perm = (x_perm - mean x) . (y - mean y) / (||x - mean x|| ||y - mean y||);
    denominators are permutation invariant, so only numerators are recomputed."""
    yc = y - y.mean(); den = np.linalg.norm(x - x.mean()) * np.linalg.norm(yc)
    if den == 0: return np.nan
    obs = abs(r_obs); cnt = 0; done = 0
    while done < nperm:
        k = min(chunk, nperm - done)
        P = rng.permuted(np.tile(x, (k, 1)), axis=1)
        rr = np.abs((P - x.mean()) @ yc) / den
        cnt += int(np.sum(rr >= obs - 1e-12)); done += k
    return cnt / done

def corr_pair(x, y, nperm=20000):
    res = {'n': int(len(x))}
    sx, sy = np.nanstd(x, ddof=1), np.nanstd(y, ddof=1)
    res['sd_x'], res['sd_y'] = R2(sx), R2(sy)
    res['r_crit_0.05'] = R2(r_crit(len(x)))
    nb = len(x) - 1
    sx_d, sy_d = np.diff(x), np.diff(y)
    nz = int(np.sum(np.sign(sx_d) != 0) and np.sum(np.sign(sy_d) != 0))
    res['sign_match_bins'] = int(np.sum(np.sign(sx_d) == np.sign(sy_d)))
    res['sign_total_bins'] = len(x) - 1
    if sx > 1e-12 and sy > 1e-12:
        r = float(np.corrcoef(x, y)[0, 1]); res['pearson_r'] = R2(r)
        res['pearson_p_analytic'] = R2(stats.pearsonr(x, y).pvalue)
        if len(x) <= 6:                                   # exhaustive permutation test
            obs = abs(r); cnt = 0; tot = 0
            for p in itertools.permutations(range(len(x))):
                tot += 1
                if abs(np.corrcoef(x[list(p)], y)[0, 1]) >= obs - 1e-12: cnt += 1
            res['pearson_p_perm'] = R2(cnt / tot); res['p_kind'] = f'exact ({tot})'
        else:
            res['pearson_p_perm'] = R2(fast_perm_p(x, y, r, nperm)); res['p_kind'] = f'MC ({nperm})'
        if len(x) >= 5:
            jj = [np.corrcoef(np.delete(x, i), np.delete(y, i))[0, 1] for i in range(len(x))]
            res['loo_r_min'], res['loo_r_max'] = R2(min(jj)), R2(max(jj))
    else:
        for k in ['pearson_r', 'pearson_p_perm', 'pearson_p_analytic', 'loo_r_min', 'loo_r_max']:
            res[k] = None
        res['p_kind'] = 'undefined (SD=0)'
    rho, prho = stats.spearmanr(x, y)
    res['spearman_rho'], res['spearman_p'] = R2(rho), R2(prho)
    return res

def detrend(v):
    t = np.arange(len(v))
    if np.nanstd(v) < 1e-12: return v - np.nanmean(v)
    b, a = np.polyfit(t, v, 1)
    return v - (b * t + a)

def detrend_full(col, idx):
    y = anchor[col].values; t = np.arange(len(y))
    b, a = np.polyfit(t, y, 1)
    return pd.Series(y - (b * t + a), index=anchor.index).reindex(idx)

PREDICTORS = {**{c: 'symbolic' for c in SYMBOLIC}, 'SymIdx': 'symbolic(composite)',
              **{c: 'social' for c in SOCIAL}, **{c: 'cultural' for c in CULTURAL},
              **{c: 'economic' for c in ECONOMIC},
              'pollen_inter': 'control', 'pollen_grate_100': 'control', 'pollen_detrend': 'control',
              'kde_all_mean': 'control', 'kde_all_detrend': 'control', 'g_all_mean': 'control',
              'b_pollen_inter': 'control(bin-mean)', 'b_pollen_grate_100': 'control(bin-mean)',
              'b_kde_all_mean': 'control(bin-mean)', 'b_kde_all_detrend': 'control(bin-mean)',
              'b_g_all_mean': 'control(bin-mean)',
              'Belau_PC1_inter': 'control(pollen file)', 'Pollen_MEAN': 'control(pollen file)'}

# ---------- deliverable: per-bin numeric table for 3400-3000 BCE ----------
W = get(3400, 3000)
cols_tbl = (['BCE', 'group'] + OUTCOMES + SYMBOLIC + ['SymIdx'] + SOCIAL + CULTURAL + ECONOMIC +
            ['pollen_inter', 'pollen_inter_100', 'pollen_grate_100', 'b_pollen_inter',
             'b_pollen_grate_100', 'Belau_PC1_inter', 'Woserin_PC1_inter', 'Pollen_MEAN',
             'kde_all_mean', 'b_kde_all_mean', 'b_kde_all_detrend', 'g_all_mean', 'b_g_all_mean'])
tbl = W[cols_tbl].round(4).copy()
tbl.insert(0, 'CE', tbl.index)
for c in OUTCOMES + SYMBOLIC + ['SymIdx']:
    tbl['dZ_' + c] = W[c].diff().round(4)                       # ΔZ per 100-yr bin
tbl['d_pollen_inter'] = W['b_pollen_inter'].diff().round(4)
tbl['d_kde_mean'] = W['b_kde_all_mean'].diff().round(6)
tbl.to_csv('analysis/window_bins_3400_3000BCE.csv', index=False)
shares = var_shares(W, SYMBOLIC, 'SymIdx')

# ---------- correlation families over all windows / transforms ----------
rows = []
for wname, (lo, hi) in WINDOWS.items():
    W = get(lo, hi)
    for out in OUTCOMES:
        for pred, klass in PREDICTORS.items():
            x = W[pred].values.astype(float); y = W[out].values.astype(float)
            m = ~(np.isnan(x) | np.isnan(y)); x, y = x[m], y[m]
            base = {'window': wname, 'outcome': out, 'predictor': pred, 'capital_class': klass}
            rows.append({**base, 'form': 'level', **corr_pair(x, y)})
            rows.append({**base, 'form': 'detrended_in_window', **corr_pair(detrend(x), detrend(y))})
            rows.append({**base, 'form': 'first_difference', **corr_pair(np.diff(x), np.diff(y))})
            rows.append({**base, 'form': 'detrended_37_anchors',
                         **corr_pair(x, detrend_full(out, W.index).values)})
corr = pd.DataFrame(rows)
corr['p_perm_BH'] = np.nan
for (w, f), g in corr.groupby(['window', 'form']):        # Benjamini-Hochberg within family
    idx = g.index[corr.loc[g.index, 'pearson_p_perm'].notna()]
    if len(idx):
        p = corr.loc[idx, 'pearson_p_perm'].values.astype(float)
        o = np.argsort(p); m = len(p)
        q = np.empty(m)
        q[o] = np.minimum.accumulate((p[o] * m / (np.arange(m) + 1))[::-1])[::-1]
        corr.loc[idx, 'p_perm_BH'] = np.round(np.minimum(q, 1), 4)
corr.to_csv('analysis/correlations_all_windows.csv', index=False)

# ---------- lagged analysis (robustness windows only) ----------
lag_rows = []
for wname, (lo, hi) in WINDOWS.items():
    if wname.startswith('3400'): continue
    W = get(lo, hi)
    for out in OUTCOMES:
        for pred in SYMBOLIC + ['SymIdx', 'b_pollen_inter', 'b_g_all_mean', 'b_kde_all_mean']:
            for lag in (0, 1, 2):
                y = W[out].values.astype(float); x = W[pred].values.astype(float)
                if lag: x, y = x[:-lag], y[lag:]
                m = ~(np.isnan(x) | np.isnan(y)); x, y = x[m], y[m]
                d = {'window': wname, 'outcome': out, 'predictor': pred, 'lag_bins': lag, 'n': len(x)}
                if len(x) < 4 or np.nanstd(x) < 1e-12 or np.nanstd(y) < 1e-12:
                    d.update({'pearson_r': None, 'note': 'SD=0 or n<4'})
                else:
                    r = float(np.corrcoef(x, y)[0, 1])
                    try:
                        ci = stats.pearsonr(x, y).confidence_interval()
                        lo_, hi_ = float(ci.low), float(ci.high)
                    except Exception:
                        lo_ = hi_ = np.nan
                    d.update({'pearson_r': R2(r), 'r_crit_0.05': R2(r_crit(len(x))),
                              'pearson_p_analytic': R2(stats.pearsonr(x, y).pvalue),
                              'fisher_ci': f'[{R2(lo_)}, {R2(hi_)}]',
                              'spearman_rho': R2(stats.spearmanr(x, y)[0]), 'note': ''})
                lag_rows.append(d)
lag = pd.DataFrame(lag_rows)
lag.to_csv('analysis/lagged_robustness.csv', index=False)

# ---------- report ----------
print("=" * 110)
print("PER-BIN TABLE, 3400-3000 BCE (also analysis/window_bins_3400_3000BCE.csv)")
print(tbl.to_string(index=False))
print("\nSymIdx variance shares in window:", {k: R2(v) for k, v in shares.items()})
print("SD within window:", {c: R2(get(3400,3000)[c].std(ddof=1)) for c in SYMBOLIC + ['SymIdx']},
      "| corr(HouseSize, SymIdx) in window:", R2(np.corrcoef(W['HouseSize'], W['SymIdx'])[0,1]))
print("SymIdx values:", get(3400,3000)['SymIdx'].round(4).tolist())

def show(mask, forms, title, extra=()):
    s = corr[mask & corr.form.isin(forms)]
    cols = ['outcome','predictor','capital_class','form','n','sd_x','pearson_r','r_crit_0.05',
            'pearson_p_perm','p_kind','p_perm_BH','spearman_rho','loo_r_min','loo_r_max',
            'sign_match_bins','sign_total_bins']
    print("\n" + "=" * 110 + f"\n{title}\n" + s[cols + list(extra)].to_string(index=False))

P = corr.window.str.startswith('3400')
show(P, ['level'], "IN-WINDOW 3400-3000 BCE (n=5), LEVELS: outcomes vs all capital elements + controls")
show(P & corr.capital_class.str.contains('symbolic'),
     ['level','detrended_in_window','first_difference','detrended_37_anchors'],
     "IN-WINDOW: SYMBOLIC elements (incl. composite) - levels vs detrended vs velocities")
show(P & corr.predictor.isin(['b_pollen_inter','b_pollen_grate_100','b_g_all_mean','b_kde_all_mean',
                              'b_kde_all_detrend','Belau_PC1_inter','Pollen_MEAN','pollen_inter',
                              'g_all_mean','kde_all_mean']),
     ['level','first_difference'],
     "IN-WINDOW: demographic / land-use controls vs outcomes")

W5 = get(3400, 3000)
for pred in ['b_pollen_inter','b_pollen_grate_100','b_g_all_mean','b_kde_all_mean']:
    x = W5[pred].values.astype(float); y = W5['SymIdx'].values.astype(float)
    dd = np.corrcoef(np.diff(x), np.diff(y))[0,1] if np.std(np.diff(x))>1e-12 else np.nan
    print(f"\nSymIdx vs {pred}: level r={R2(np.corrcoef(x,y)[0,1])} (n=5, p_perm exact), "
          f"delta r={R2(dd)} (n=4), sign match {int(np.sum(np.sign(np.diff(x))==np.sign(np.diff(y))))}/4")
    print("   levels:", list(zip(W5.index, np.round(x,4), np.round(y,4))))

print("\n" + "=" * 110 + "\nBIN-TO-BIN INCREMENTS (ΔZ per 100 yr), -3400 -> -3000")
d = W5[OUTCOMES + SYMBOLIC + ['SymIdx','b_pollen_inter','b_g_all_mean','b_kde_all_mean']].diff().dropna()
print(d.round(4).to_string())
print("\nsigns:\n" + np.sign(d).astype(int).to_string())

print("\n" + "=" * 110 + "\nROBUSTNESS WINDOWS - LEVELS, symbolic predictors")
for wname in ['3500-3000 BCE','3600-2800 BCE','4000-2500 BCE']:
    s = corr[(corr.window == wname) & (corr.form == 'level') & corr.capital_class.str.contains('symbolic')]
    print(f"\n-- {wname}")
    print(s[['outcome','predictor','n','pearson_r','r_crit_0.05','pearson_p_perm','p_kind',
             'pearson_p_analytic','p_perm_BH','spearman_rho','loo_r_min','loo_r_max',
             'sign_match_bins','sign_total_bins']].to_string(index=False))

print("\n" + "=" * 110 + "\nROBUSTNESS WINDOWS - DETRENDED IN WINDOW, symbolic predictors")
for wname in ['3600-2800 BCE','4000-2500 BCE']:
    s = corr[(corr.window == wname) & (corr.form == 'detrended_in_window') &
             corr.capital_class.str.contains('symbolic')]
    print(f"\n-- {wname}")
    print(s[['outcome','predictor','n','pearson_r','r_crit_0.05','pearson_p_perm','spearman_rho',
             'loo_r_min','loo_r_max']].to_string(index=False))

print("\n" + "=" * 110 + "\nLEVELS vs DETRENDED, 4000-2500 BCE (n=16) - does the relation survive detrending?")
for out in OUTCOMES:
    s = corr[(corr.window == '4000-2500 BCE') & (corr.outcome == out) &
             corr.predictor.isin(SYMBOLIC + ['SymIdx','b_pollen_inter','b_g_all_mean']) &
             corr.form.isin(['level','detrended_in_window','first_difference'])]
    print(f"\n-- {out}")
    print(s.pivot_table(index='predictor', columns='form', values='pearson_r').round(3).to_string())
    print(s.pivot_table(index='predictor', columns='form', values='pearson_p_perm').round(4).to_string())

print("\n" + "=" * 110 + "\nLAGS 0-2 BINS (robustness windows; no causal reading intended)")
print(lag[lag.pearson_r.notna()].to_string(index=False))
print("\nArtifacts: analysis/window_bins_3400_3000BCE.csv, analysis/correlations_all_windows.csv, "
      "analysis/lagged_robustness.csv")

# ---------- multiplicity control across the whole lag family + key findings summary ----------
pl = lag['pearson_p_analytic'].astype(float)
ok = pl.notna()
pv = pl[ok].values; o = np.argsort(pv); m = len(pv); q = np.empty(m)
q[o] = np.minimum.accumulate((pv[o] * m / (np.arange(m) + 1))[::-1])[::-1]
lag.loc[lag.index[ok], 'p_BH_all_lag_tests'] = np.round(np.minimum(q, 1), 4)
lag.to_csv('analysis/lagged_robustness.csv', index=False)
print("\n" + "=" * 110)
print(f"BH across all {m} lag tests: surviving p_BH<0.05:")
print(lag[lag.p_BH_all_lag_tests < 0.05].to_string(index=False) or 'none')

key = corr[(corr.window.str.startswith('3400')) & (corr.form == 'level') &
           corr.predictor.isin(SYMBOLIC + ['SymIdx'] + SOCIAL + CULTURAL + ECONOMIC +
                               ['b_pollen_inter', 'b_g_all_mean'])][
      ['outcome','predictor','capital_class','n','sd_x','pearson_r','pearson_p_perm','p_perm_BH',
       'spearman_rho','loo_r_min','loo_r_max','sign_match_bins','sign_total_bins']]
key.to_csv('analysis/key_findings_in_window.csv', index=False)
print("\nKEY IN-WINDOW FINDINGS saved to analysis/key_findings_in_window.csv (n pairs:", len(key), ")")
