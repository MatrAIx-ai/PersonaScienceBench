"""Stage 1 - inspection of inputs for the DiscoveryBench question:
'Between 3400 BCE to 3000 BCE, how does the number of monuments and axes
change with elements of symbolic capital?'

Checks: columns, time coding, grid step, missingness, cross-file identity of the
Z series, feasibility of the exact 3400-3000 BCE window, in-window variance.
No inferential statistics are produced at this stage.
"""
import numpy as np, pandas as pd

ts = pd.read_csv('data/time_series_data.csv', index_col=0)          # index = unnamed row id
ts = ts.set_index('CE')  # first CSV column is an unnamed row id used as index
cap = pd.read_csv('data/capital.csv', decimal=',')                  # decimal comma
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')                         # index == CE

print("== shapes ==")
print("time_series:", ts.shape, "| capital:", cap.shape, "| pollen_openness:", pol.shape)
print("\n== time_series_data.csv columns ==")
print(list(ts.columns))
print("CE:", ts.index.min(), "to", ts.index.max(), "| calBP:", ts.calBP.min(), "to", ts.calBP.max())
print("CE+calBP unique:", np.unique((ts.index + ts.calBP).values), "| grid step:", np.unique(np.diff(ts.index.values)))
print("missing fraction (non-zero only):")
mf = ts.isna().mean().round(4); print(mf[mf > 0].to_string())

print("\n== capital.csv ==")
print("BCE:", cap.BCE.min(), "to", cap.BCE.max(), "| step:", np.unique(np.diff(sorted(cap.BCE))),
      "| total missing:", int(cap.isna().sum().sum()))
print(cap.groupby('group').BCE.agg(['min', 'max', 'count']).to_string())

PAIRS = {'ZAxtSchwert': 'HatchetSword', 'ZDolch': 'Dagger', 'Zhausgr': 'HouseSize', 'ZCU_AU': 'CopperGold',
         'Zamber': 'Amber', 'ZMonument': 'MonumentCount', 'ZHort': 'Depot', 'ZSichel': 'Sickle',
         'ZBeil': 'AxesCelts', 'ZMW': 'MonumentSize', 'ZKeform': 'PotteryForm', 'Zkeverz': 'PotteryDecoration'}
obs = ts[[c for c in PAIRS.values()]].dropna()          # rows carrying raw Z values
capi = cap.set_index('BCE')
rows = [(k, v, len(set(-obs.index) & set(capi.index)),
         float(np.abs(obs[v].values - capi[k].reindex(-obs.index).values).max())) for k, v in PAIRS.items()]
print("\n== capital.csv vs raw Z columns of time_series_data.csv ==")
print(pd.DataFrame(rows, columns=['capital_col', 'ts_raw_col', 'n_matched', 'max_abs_diff']).to_string(index=False))
print("raw Z anchors n =", len(obs), "| BCE:", -obs.index.max(), "to", -obs.index.min())
print("capital BCE outside ts grid:", sorted(set(capi.index) - set(-obs.index)))

print("\n== exact 3400-3000 BCE window ==")
grid = list(range(-3400, -2999, 100))
w = ts.loc[grid]
print("anchors exactly on the 100-yr grid:", grid)
print("raw obs per series in window:", {c: int(w[c].notna().sum()) for c in PAIRS.values()})
print("in-window SD:", w[list(PAIRS.values())].std().round(4).to_dict())
print("n distinct values:", w[list(PAIRS.values())].nunique().to_dict())
print(w[list(PAIRS.values())].to_string())
print("annual-resolution rows in window:", len(ts.loc[-3400:-3000]),
      "| raw pollen obs:", int(ts.loc[-3400:-3000, 'pollen'].notna().sum()))
print("anchors in wider comparison windows:",
      {(lo, hi): int(ts.loc[-lo:-hi, 'MonumentCount'].notna().sum())
       for lo, hi in [(4000, 2500), (3600, 2800), (3500, 3000), (3400, 3000)]})
print("\nwindow rows of the control/demography columns:")
print(w[['kde_all_mean', 'kde_all_detrend', 'g_all_mean', 'pollen', 'pollen_inter',
         'pollen_inter_100', 'pollen_grate_100']].round(4).to_string())

print("\n== pollen_openness csv ==")
print("CE:", pol.CE.min(), "to", pol.CE.max(), "| CE+calBP:", np.unique((pol.CE + pol.calBP).values)[:3],
      "| step:", np.unique(np.diff(pol.CE.values)))
print(pd.DataFrame({'n_miss': pol.isna().sum(), 'frac': pol.isna().mean().round(3)}).to_string())
p = ts['pollen'].dropna(); common = p.index.intersection(pol.index)
print("ts.pollen n =", len(p), "| overlap =", len(common),
      "| max|ts.pollen - Belau_PC1| =", float((p.loc[common] - pol['Belau_PC1'].reindex(common)).abs().max()))
print("window slice of pollen openness (Belau/Woserin PC1):")
print(pol.loc[grid, ['Belau_PC1', 'Woserin_PC1', 'Belau_PC1_inter', 'Woserin_PC1_inter',
                     'MEAN', 'SMOOTH_MEAN_100y']].round(3).to_string())

print("\n== interpolation character of *_inter ==")
si = ts['MonumentCount_inter']
lin = np.interp(ts.index.values, obs.index.values, obs['MonumentCount'].values)
print("_inter == raw at anchor points:", bool(np.allclose(si.loc[obs.index], obs['MonumentCount'])))
print("max|_inter - linear interp between anchors| =", float(np.abs(si.values - lin).max()))
print("distinct values of HouseSize_inter in window (annual):", ts.loc[-3400:-3000, 'HouseSize_inter'].nunique())
