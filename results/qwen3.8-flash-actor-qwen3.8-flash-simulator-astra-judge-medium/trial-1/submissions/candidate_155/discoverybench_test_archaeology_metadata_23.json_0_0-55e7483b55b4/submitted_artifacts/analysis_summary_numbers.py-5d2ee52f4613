"""Targeted summary numbers for the final hypothesis (3400-3000 BCE window).
Only the 37 raw Z anchors of time_series_data.csv are used (no interpolation)."""
import itertools, math, numpy as np, pandas as pd
from scipy import stats
R = lambda v: round(float(v), 3)
ts = pd.read_csv('data/time_series_data.csv', index_col=0).set_index('CE')
A = ts[ts['MonumentCount'].notna()].sort_index()          # 37 anchors
W = A.loc[-3400:-3000].copy()
for col in ['pollen_inter', 'g_all_mean', 'kde_all_mean', 'pollen_grate_100']:
    W['b_' + col] = [ts.loc[c-49:c+50, col].dropna().mean() for c in W.index]
W['SymIdx'] = W[['HatchetSword', 'Dagger', 'HouseSize']].mean(axis=1)
sym = W['SymIdx'].values
def perm_p(x, y):
    r = np.corrcoef(x, y)[0, 1]; obs = abs(r)
    cnt = sum(abs(np.corrcoef(x[list(p)], y)[0, 1]) >= obs - 1e-12 for p in itertools.permutations(range(len(x))))
    return R(r), round(cnt / float(math.factorial(len(x))), 3)
def line(name, x, y):
    r, p = perm_p(x, y)
    print(f"{name:52s} n={len(x)} r={r:+.3f} p_perm(exact)={p:.3f} rho={R(stats.spearmanr(x,y)[0]):+.3f} "
          f"sign-match(Δ)={int(np.sum(np.sign(np.diff(x))==np.sign(np.diff(y))))}/{len(x)-1} "
          f"LOO r in [{R(min(np.corrcoef(np.delete(x,i),np.delete(y,i))[0,1] for i in range(len(x)))):+.2f}, "
          f"{R(max(np.corrcoef(np.delete(x,i),np.delete(y,i))[0,1] for i in range(len(x)))):+.2f}]")
mc, ax = W['MonumentCount'].values, W['AxesCelts'].values
print("== PRIMARY WINDOW 3400-3000 BCE (5 anchors) ==")
print("bin  BCE   MC     Axes   HouseSize HatchetSword Dagger  SymIdx  Depot  pollen(bin)  KDEgrowth(bin)")
bt = pd.read_csv('analysis/window_bins_3400_3000BCE.csv')
for _, r in bt.iterrows():
    print(f"{int(r.CE):6d} {int(r.BCE):4d} {r.MonumentCount:+.3f} {r.AxesCelts:+6.3f} {r.HouseSize:+7.2f} "
          f"{r.HatchetSword:+10.2f} {r.Dagger:+7.2f} {r.SymIdx:+7.3f} {r.Depot:+6.2f} "
          f"{r.b_pollen_inter:+8.3f} {r.b_g_all_mean:+9.5f}")
print("\nincrements ΔZ per bin (3400->3000):")
print(bt[['CE','dZ_MonumentCount','dZ_AxesCelts','dZ_HouseSize','dZ_SymIdx','d_pollen_inter']].to_string(index=False))
print()
line('MonumentCount vs AxesCelts (co-movement of outcomes)', mc, ax)
line('MonumentCount vs SymIdx (symbolic composite)', W['SymIdx'].values, mc)
line('MonumentCount vs HouseSize', W['HouseSize'].values, mc)
line('MonumentCount vs HatchetSword', W['HatchetSword'].values, mc)
line('AxesCelts vs SymIdx', sym, ax)
line('AxesCelts vs HouseSize', W['HouseSize'].values, ax)
line('AxesCelts vs HatchetSword', W['HatchetSword'].values, ax)
line('SymIdx vs pollen openness (bin mean)', W['b_pollen_inter'].values, sym)
line('MonumentCount vs pollen openness (bin mean)', W['b_pollen_inter'].values, mc)
line('AxesCelts vs pollen openness (bin mean)', W['b_pollen_inter'].values, ax)
line('MonumentCount vs KDE growth (bin mean)', W['b_g_all_mean'].values, mc)
line('AxesCelts vs KDE growth (bin mean)', W['b_g_all_mean'].values, ax)
print("\ntotal change across window (3400 -> 3000 BCE):")
for c in ['MonumentCount','AxesCelts','HouseSize','SymIdx','Depot','Amber','b_pollen_inter','b_kde_all_mean']:
    print(f"  {c:16s} {R(W[c].values[-1]-W[c].values[0]):+.3f}   (from {R(W[c].values[0]):+.3f} to {R(W[c].values[-1]):+.3f})")
print(f"  peak bins: MonumentCount max {R(mc.max())} at {-W.index[np.argmax(mc)]} BCE; "
      f"AxesCelts max {R(ax.max())} at {-W.index[np.argmax(ax)]} BCE; "
      f"HouseSize max {R(W.HouseSize.max())} at {-W.index[np.argmax(W.HouseSize.values)]} BCE")
print(f"  SymIdx variance share in window: HouseSize {(np.cov(W.HouseSize, sym)[0,1]/3/np.var(sym,ddof=1)):.3f}, "
      f"HatchetSword {(np.cov(W.HatchetSword, sym)[0,1]/3/np.var(sym,ddof=1)):.4f}, "
      f"Dagger {(np.cov(W.Dagger, sym)[0,1]/3/np.var(sym,ddof=1)):.3f}; corr(HouseSize,SymIdx)={R(np.corrcoef(W.HouseSize,sym)[0,1])}")
print(f"  r needed for p<0.05 at n=5: {R(np.sqrt(stats.t.ppf(.975,3)**2/(stats.t.ppf(.975,3)**2+3)))}")
