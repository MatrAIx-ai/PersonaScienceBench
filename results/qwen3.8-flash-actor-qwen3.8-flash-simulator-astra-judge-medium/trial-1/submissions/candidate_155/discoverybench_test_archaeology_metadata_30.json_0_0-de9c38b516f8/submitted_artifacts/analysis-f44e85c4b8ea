import pandas as pd
import numpy as np

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')

# --- Build century table from time_series raw columns (37 points, CE = -4100..-500 step 100)
raw = ts.dropna(subset=['PotteryForm', 'PotteryDecoration']).copy()
raw = raw.sort_values('CE')
raw['century_bce'] = -raw['CE']  # dataset mapping CE = -BCE

# --- capital table, converting comma decimals
capc = cap.copy()
for c in ['ZKeform', 'Zkeverz']:
    capc[c] = capc[c].astype(str).str.replace(',', '.').astype(float)
capc = capc.sort_values('BCE', ascending=False)  # time-forward: 4300 BCE -> 500 BCE
capc['century_bce'] = capc['BCE']

# ---- MAIN TABLE (37 common points, from time_series) with differences
tbl = raw[['century_bce', 'PotteryForm', 'PotteryDecoration']].copy()
tbl['dZ_form']  = tbl['PotteryForm'].diff()
tbl['dZ_decor'] = tbl['PotteryDecoration'].diff()
print("=== MAIN TABLE: raw century Z values and adjacent-century differences (time forward) ===")
print("transition label: from (century-100) BCE -> century BCE ; target century = 'century_bce' row")
show = tbl.copy()
for c in ['PotteryForm','PotteryDecoration','dZ_form','dZ_decor']:
    show[c] = show[c].map(lambda x: '' if pd.isna(x) else f"{x:.2f}")
print(show.to_string(index=False))

# ---- Cross-check with capital.csv
print("\n=== CROSS-CHECK time_series raw vs capital.csv ===")
m = tbl.merge(capc[['century_bce','ZKeform','Zkeverz']], on='century_bce', how='outer', indicator=True)
print("merge indicator counts:\n", m['_merge'].value_counts().to_string())
both = m[m['_merge']=='both']
d1 = (both['PotteryForm'] - both['ZKeform']).abs().max()
d2 = (both['PotteryDecoration'] - both['Zkeverz']).abs().max()
print(f"common points: {len(both)}; max |PotteryForm-ZKeform| = {d1:.6f}; max |PotteryDecoration-Zkeverz| = {d2:.6f}")
extra = m[m['_merge']=='right_only']
print("capital-only rows (BCE beyond time_series coverage):")
print(extra[['century_bce','ZKeform','Zkeverz']].to_string(index=False))

# capital-based differences (39 points incl. 4300, 4200 BCE)
capd = capc[['century_bce','ZKeform','Zkeverz']].sort_values('century_bce', ascending=False).reset_index(drop=True)
capd['dZ_form']  = capd['ZKeform'].diff()
capd['dZ_decor'] = capd['Zkeverz'].diff()

# ---- Threshold scan function
def scan(df, zform, zdecor, dform, ddecor, thresholds):
    out = {}
    for th in thresholds:
        hits = df[(df[ddecor] >= th) & (df[dform] <= -th)]
        out[th] = hits
    return out

print("\n=== THRESHOLD SCAN (main table, 37 points) ===")
res = scan(tbl, 'PotteryForm','PotteryDecoration','dZ_form','dZ_decor', [0.25,0.5,0.75])
for th, hits in res.items():
    if len(hits):
        print(f"threshold {th}: ALL matching target centuries (BCE): {sorted(hits['century_bce'].tolist(), reverse=True)}")
        for _, r in hits.iterrows():
            print(f"   target {int(r.century_bce)} BCE: dZ_decor={r.dZ_decor:+.2f}, dZ_form={r.dZ_form:+.2f}")
    else:
        print(f"threshold {th}: no matches")

print("\n=== THRESHOLD SCAN (capital table, 39 points incl 4300/4200 BCE) ===")
res2 = scan(capd, 'ZKeform','Zkeverz','dZ_form','dZ_decor', [0.25,0.5,0.75])
for th, hits in res2.items():
    if len(hits):
        print(f"threshold {th}: ALL matching target centuries (BCE): {sorted(hits['century_bce'].tolist(), reverse=True)}")
    else:
        print(f"threshold {th}: no matches")

# ---- Interpolated robustness: 100-year bin means of *_inter
inter = ts.dropna(subset=['PotteryForm_inter','PotteryDecoration_inter']).copy()
inter['bin_bce'] = -((inter['CE'] + 99)//100)*100  # map CE year to its century bin labeled by start BCE
grp = inter.groupby('bin_bce').agg(form=('PotteryForm_inter','mean'), decor=('PotteryDecoration_inter','mean')).reset_index()
grp = grp.sort_values('bin_bce', ascending=False).reset_index(drop=True)
grp['dZ_form'] = grp['form'].diff(); grp['dZ_decor'] = grp['decor'].diff()
print("\n=== ROBUSTNESS: interpolated series, 100-yr bin means ===")
res3 = scan(grp, 'form','decor','dZ_form','dZ_decor', [0.25,0.5,0.75])
for th, hits in res3.items():
    if len(hits):
        print(f"threshold {th}: matching centuries (BCE): {sorted(hits['bin_bce'].tolist(), reverse=True)}")
        for _, r in hits.iterrows():
            print(f"   target {int(r.bin_bce)} BCE: dZ_decor={r.dZ_decor:+.3f}, dZ_form={r.dZ_form:+.3f}")
    else:
        print(f"threshold {th}: no matches")

# ---- Endpoint-style robustness on raw: diff over 2-century windows (slope sign & magnitude)
tbl2 = tbl.copy()
tbl2['dZ2_form'] = tbl2['PotteryForm'].diff(2)
tbl2['dZ2_decor'] = tbl2['PotteryDecoration'].diff(2)
print("\n=== ROBUSTNESS: 2-century window change (raw), first hit per threshold ===")
for th in [0.25,0.5,0.75]:
    hits = tbl2[(tbl2['dZ2_decor'] >= th) & (tbl2['dZ2_form'] <= -th)]
    if len(hits):
        first = hits.iloc[0]  # earliest in time order (tbl is ascending time? check)
        print(f"th {th}: centuries {sorted(hits['century_bce'].tolist(), reverse=True)}")
    else:
        print(f"th {th}: none")

# ---- Detail around first hit: values
print("\n=== Values around candidate transitions ===")
for th in [0.25,0.5,0.75]:
    hits = res[th]
    if len(hits):
        t = int(hits.iloc[0]['century_bce'])
        prev = tbl[tbl['century_bce']==t+100].iloc[0]
        cur  = tbl[tbl['century_bce']==t].iloc[0]
        print(f"th={th}: first transition {t+100} BCE -> {t} BCE : "
              f"decor {prev.PotteryDecoration:.2f}->{cur.PotteryDecoration:.2f} ({cur.PotteryDecoration-prev.PotteryDecoration:+.2f}); "
              f"form {prev.PotteryForm:.2f}->{cur.PotteryForm:.2f} ({cur.PotteryForm-prev.PotteryForm:+.2f})")
