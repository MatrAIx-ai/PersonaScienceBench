"""
Main analysis (DiscoveryBench archaeology episode):
  "In which millennium did amber have the highest value and in what time interval did it peak?"

Pre-registered rules (approved by the researcher before execution):
  R1 "highest millennium" = INTERVAL MEAN of Amber_inter (max used only for the peak interval)
  R2 report millennium and peak interval separately; flag any disagreement
  R3 near-ties (<0.05 Z) resolved by coverage then by number of top bins, else report both
  R4 anchors override the interpolated series on disagreement (interpolation adds no info)
  R5 capital-only 4300/4200 BCE bins used for sensitivity only
  R6 every statement carries +/-100 y (one century bin) uncertainty and the "frequency != value" caveat
Proxy: the data contain no price/value field; Zamber/Amber are standardised find-abundance Z values.
Verified alignment: CE = -BCE ; calBP = 1950 - CE (exact in both yearly files).
"""
import numpy as np, pandas as pd
D, R = 'data/', 'results/'
pd.set_option('display.width', 260); pd.set_option('display.max_rows', 400)

ts  = pd.read_csv(D+'time_series_data.csv')
cap = pd.read_csv(D+'capital.csv', decimal=',')          # comma decimal separator
def sep(t): print('\n'+'='*92+'\n'+t+'\n'+'='*92)
def calbp(ce): return 1950-ce

# ---------- century-bin frame ----------
binc = cap[['BCE','group','Zamber']].rename(columns={'Zamber':'Zamber_cap'}).copy()
binc['CE'] = -binc['BCE']
binc = binc.merge(ts.dropna(subset=['Amber'])[['CE','Amber']], on='CE', how='left').rename(columns={'Amber':'Amber_ts'})
binc['bin_end_BCE'] = binc['BCE']-99                       # bin label = bin START (BCE), covers BCE .. BCE-99
ai = ts.set_index('CE')['Amber_inter'].sort_index()
CMIN, CMAX = int(ai.index.min()), int(ai.index.max())
roll = {w: ai.rolling(w, center=True, min_periods=1).mean() for w in (50,100,250,500)}
def getat(s, ce):  return float(s.loc[ce]) if CMIN <= ce <= CMAX else np.nan
def mmean(lo, hi):
    if -lo < CMIN: return np.nan
    return float(ai.loc[max(lo,CMIN):min(hi,CMAX)].mean())
binc['inter_mean_in_bin'] = [mmean(-r.BCE, -(r.BCE-99)) for r in binc.itertuples()]
for w in (100,250,500):
    binc[f'roll{w}y_at_binstart'] = [getat(roll[w], -r.BCE) for r in binc.itertuples()]
binc['calBP_binstart'] = 1950-binc['CE']
b37 = binc[binc.CE >= -4100].copy()                        # primary data source (time_series)

def span_from_BCE(starts):                                 # BCE bin-START labels -> interval strings
    s = sorted(np.array(starts,dtype=int), reverse=True)   # descending (oldest first)
    top, bot = s[0], s[-1]-99                              # oldest bin start, youngest bin end
    return f'{top}..{bot} BCE', f'{calbp(-top)}-{calbp(-bot)} calBP', len(s)*100
def span_from_CE(ces):  return span_from_BCE(-np.array(ces,dtype=int))

sep('(a) CENTURY-BIN TABLE: amber Z per 100-y bin + period label + interpolated/smoothed summaries')
print(binc[['BCE','bin_end_BCE','group','Amber_ts','Zamber_cap','inter_mean_in_bin',
            'roll100y_at_binstart','roll250y_at_binstart','roll500y_at_binstart','calBP_binstart']].round(3).to_string(index=False))
print('\nts.Amber vs capital.Zamber on 37 shared bins: max abs diff = %.3g  |  distinct Z values = %d'
      % ((binc.Amber_ts-binc.Zamber_cap).abs().max(), binc.Zamber_cap.nunique()))

# ---------- (b) millennia ----------
sep('(b) MILLENNIA - interval MEAN of Amber_inter (primary criterion, R1)')
def milli(spans, name):
    rows=[]
    for lo,hi,l in spans:
        s = ai.loc[lo:hi]; bb = binc[(binc.CE>=lo)&(binc.CE<=hi)]
        rows.append(dict(millennium=l, CE_interval=f'{lo}..{hi}', BCE_interval=f'{-hi}..{-lo} BCE',
                         calBP_interval=f'{calbp(hi)}-{calbp(lo)} calBP', years_covered=len(s),
                         coverage_pct=round(100*len(s)/(hi-lo+1),1),
                         mean_Amber_inter=round(s.mean(),4) if len(s) else np.nan,
                         max_Amber_inter=round(s.max(),4) if len(s) else np.nan,
                         n_century_bins=len(bb), mean_binZ=round(bb.Zamber_cap.mean(),4) if len(bb) else np.nan,
                         n_top_bins=int((bb.Zamber_cap==binc.Zamber_cap.max()).sum()),
                         usable='yes' if len(s)>=0.8*(hi-lo+1) else 'NO - <80% coverage (excluded from ranking, R2/S2)'))
    t=pd.DataFrame(rows); print(f'\n-- {name}'); print(t.to_string(index=False)); return t
T_as = milli([(-5000,-4001,'5000-4001 BCE'),(-4000,-3001,'4000-3001 BCE'),(-3000,-2001,'3000-2001 BCE'),
              (-2000,-1001,'2000-1001 BCE'),(-1000,-1,'1000-1 BCE')],
             'B1 astronomical millennia (boundaries at .../2001-1001/1000-1 BCE); full-coverage ones only')
T_an = milli([(-4300,-3301,'4300-3301 BCE'),(-3300,-2301,'3300-2301 BCE'),(-2300,-1301,'2300-1301 BCE'),
              (-1300,-500,'1300-501 BCE')], 'B2 millennia anchored on the data start (4300 BCE)')
rk = T_as[T_as.usable=='yes'].sort_values('mean_Amber_inter',ascending=False)
sep('(b2) R5 sensitivity: do the capital-only 4300 & 4200 BCE bins (both Z=-1.07) change anything?')
m1 = float(np.mean(list(ai.loc[-4100:-4001].values)+list(binc[binc.BCE.isin([4300,4200])].Zamber_cap.values)))
print(f'5000-4001 BCE block: mean WITHOUT extra bins = {T_as.loc[0,"mean_Amber_inter"]:.4f} '
      f'(100 y coverage, EXCLUDED), WITH extra bins = {m1:.4f}')
print(f'ranking of usable astronomical millennia: ' + '; '.join(f'{r.millennium}={r.mean_Amber_inter:.3f}' for r in rk.itertuples()))
print(f'gap 1st-2nd = {rk.iloc[0].mean_Amber_inter-rk.iloc[1].mean_Amber_inter:.4f} Z  -> no R3 tie (threshold 0.05)')
print('=> the two extra bins sit in the already-excluded 5000-4001 BCE block; they cannot change the winner.')
sep('(b3) SLIDING 1000-Y windows (step 100 y) - boundary-phase robustness, top 6')
sw=[]
for lo in range(CMIN, CMAX-999, 100):
    s = ai.loc[lo:lo+999]
    if len(s)==1000: sw.append((f'{-lo-999}..{-lo} BCE', f'{lo}..{lo+999}', round(s.mean(),4), round(s.max(),3)))
sw = pd.DataFrame(sw, columns=['window_BCE','CE','mean','max']).sort_values('mean',ascending=False)
print(sw.head(6).to_string(index=False))
for f,d in [('a_century_bins',binc),('b_millennia_astronomical',T_as),('b_millennia_dataanchored',T_an),('b_sliding1000y',sw)]:
    d.to_csv(R+f+'.csv', index=False)

# ---------- (c) peak interval: three determinations ----------
sep('(c) PEAK INTERVAL - three determinations (all on century-bin anchors; +/-100 y)')
z = b37.Zamber_cap
thr_sd, thr_p90, thr_hm = z.mean()+z.std(ddof=1), z.quantile(0.90), (z.max()+z.mean())/2
thr_p90i = ai.quantile(0.90)
print(f'thresholds: mean+1SD of anchor Z = {thr_sd:+.4f} | top-decile anchor Z = {thr_p90:+.4f} | '
      f'top-decile Amber_inter = {thr_p90i:+.4f} | half-max = {thr_hm:+.4f}')
def runs(mask, idx):
    out, cur = [], []
    for v,i in zip(mask, idx):
        if v: cur.append(i)
        elif cur: out.append(cur); cur=[]
    if cur: out.append(cur)
    return out
print('\n  M1 BASE (researcher-specified): longest contiguous SET OF CENTURY BINS >= threshold')
M1={}
for nm,thr in [('mean+1SD',thr_sd),('top-decile',thr_p90),('half-max',thr_hm)]:
    r = max(runs((z>=thr).values, b37.BCE.values), key=len); M1[nm]=(r,thr)
    sp,cb,ny = span_from_BCE(r)
    print(f'    {nm:11s} thr={thr:+.3f} -> bins start-labelled {max(r)}..{min(r)} BCE = {sp} = {cb} ({ny} y, {len(r)} bins)')
print('\n  M2 PLATFORM (highest anchor value)')
mx = z.max(); pr = max(runs((z>=mx).values, b37.CE.values), key=len)
sp,cb,ny = span_from_CE(pr); M2=(pr,mx)
print(f'    max anchor Z = {mx} -> {sp} = {cb} ({ny} y). Bins: {sorted(-np.array(pr,dtype=int),reverse=True)}')
sec = z[z<mx].max(); sr = max(runs((z>=sec).values, b37.CE.values), key=len)
sp2,cb2,_ = span_from_CE(sr)
print(f'    2nd-highest level Z = {sec} (4000-3401 BCE); because {sec} also exceeds mean+1SD the two levels merge:')
print(f'    run >= {sec} -> {sp2} = {cb2}')
print(f'    NOTE: the two levels differ by {mx-sec:.2f} Z; the data CANNOT order sub-century or rank the two')
print(f'    plateaux more finely (only 13 distinct values) -> peak stated at century-bin resolution only.')
print('\n  M3 SMOOTHED peak neighbourhood (centred rolling mean; band = within 1 SD of smoothed max)')
M3={}
for w in (50,100,250,500):
    s = roll[w].loc[CMIN:CMAX]; pkv = s.max(); pkce = int(s.idxmax()); cut = pkv - ai.std(ddof=1)
    full = roll[w].dropna()
    r = [q for q in runs((full>=cut).values, full.index.values) if pkce in q][0]
    M3[w]=(pkce,pkv,r[0],r[-1])
    print(f'    {w:4d} y: smoothed max {pkv:+.3f} at {-pkce} BCE (CE {pkce}); band >= {cut:+.3f}: '
          f'{-r[-1]+1}..{-r[0]} BCE = {calbp(r[-1])}-{calbp(r[0])} calBP ({len(r)} y)')
print('\n  continuous crossings of Amber_inter (reference only, NOT sub-century precision):')
for nm,thr in [('mean+1SD',thr_sd),('top-decile',thr_p90i)]:
    r = max([q for q in runs((ai>=thr).values, ai.index.values) if len(q)>200], key=len)
    print(f'    {nm:11s} thr={thr:+.3f} -> CE {r[0]}..{r[-1]} = {-r[-1]+1}..{-r[0]} BCE '
          f'= {calbp(r[-1])}-{calbp(r[0])} calBP ({len(r)} y)')
print('\n  CONSISTENCY: M1(mean+1SD)=M1(half-max)=M2(run>=1.46) -> 4000..2901 BCE; M2(platform, Z=1.54) and')
print('  M1(top-decile) -> 3300..2901 BCE; M3 peak position 3275-3175 BCE, band ~2900-4100 BCE.')
print('  => nested, mutually consistent: core = 3300-3000 BCE, broad high plateau = 4000-3000 BCE.')

sep('(c2) AMBER Z BY ARCHAEOLOGICAL PERIOD (capital.csv group labels)')
pk_lo, pk_hi = 4000, 2901
pm = binc.groupby('group',sort=False).agg(n=('Zamber_cap','size'), mean_Z=('Zamber_cap','mean'),
        min_Z=('Zamber_cap','min'), max_Z=('Zamber_cap','max'), BCE_from=('BCE','max'), BCE_to=('BCE','min'))
pm['span_BCE'] = [f'{int(r.BCE_from)}..{int(r.BCE_to)-99} BCE' for r in pm.itertuples()]
def overlap(r):
    lo,hi = int(r.BCE_to)-99, int(r.BCE_from)
    n = sum(1 for b in binc[(binc.group==r.Index)].BCE if pk_lo>=b>=pk_hi-0)
    return f'{n}/{int(r.n)} bins'
pm['bins_in_peak_4000-2901'] = [overlap(r) for r in pm.itertuples()]
pm['peak_share_of_period_mean'] = (pm.mean_Z/ pm.mean_Z.max()).round(3)
print(pm.round(3).to_string())
pm.round(4).to_csv(R+'c_period_means.csv')

# ---------- (d) sensitivity ----------
sep('(d) SENSITIVITY: bin width | peak threshold | smoothing window | 37 vs 39 bins | raw vs interpolated')
rows=[]
bb = cap[['BCE','Zamber']].reset_index(drop=True)   # capital rows are already time-ascending (BCE 4300 -> 500)
for bw in (100,200,300,500,1000,1200):
    w = bw//100
    m = bb.Zamber.rolling(w).mean()          # trailing window: at index i it averages bins i-w+1..i
    i = int(m.idxmax()); start, end = int(bb.BCE.iloc[i-w+1]), int(bb.BCE.iloc[i])
    rows.append(dict(axis='bin width (sliding)', setting=f'{bw} y ({w} bins)', winner=f'{start}..{end-99} BCE',
        value=round(float(m[i]),3), note='best sliding window of that width, mean-Z on anchor bins'))
    if bw == 1000:
        g = bb.assign(blk=np.arange(len(bb))//w).groupby('blk').agg(s0=('BCE','max'), s1=('BCE','min'), m=('Zamber','mean'))
        j = g.m.idxmax()
        rows.append(dict(axis='bin width (fixed phase)', setting='1000 y blocks from 4300 BCE', winner=f'{int(g.loc[j,"s0"])}..{int(g.loc[j,"s1"])-99} BCE',
            value=round(float(g.loc[j,"m"]),3), note='block phase fixed at the data start (see B2 table)'))
for nm in M1:
    r,thr = M1[nm]; sp,cb,ny = span_from_BCE(r)
    rows.append(dict(axis='peak threshold', setting=f'{nm} ({thr:+.3f})', winner=sp, value=ny, note=f'{cb}'))
for w in M3:
    pkce,pkv,lo,hi = M3[w]
    rows.append(dict(axis='smoothing', setting=f'{w} y centred', winner=f'peak at {-pkce} BCE', value=round(pkv,3),
                     note=f'band {-hi+1}..{-lo} BCE'))
rows += [dict(axis='bin set', setting='37 bins (time_series only)', winner='4000-3001 BCE', value=round(ai.loc[-4000:-3001].mean(),3), note='millennium mean of Amber_inter'),
         dict(axis='bin set', setting='39 bins (capital incl. 4300/4200 BCE)', winner='4000-3001 BCE (unchanged)', value=round(ai.loc[-4000:-3001].mean(),3),
              note=f'extra bins are Z=-1.07 and fall in the excluded 5000-4001 BCE block (mean would be {m1:.3f})'),
         dict(axis='raw vs interp', setting='anchor-only millennium means (R4)', winner='4000-3001 BCE',
              value=round(b37[(b37.CE>=-4000)&(b37.CE<=-3001)].Zamber_cap.mean(),3), note='vs 1.488 interpolated -> same winner'),
         dict(axis='boundaries', setting='astronomical vs data-anchored millennia', winner='both peak in 4300-3001 BCE', value=round(sw.iloc[0]['mean'],3),
              note='B1 winner 4000-3001 BCE (1.488); B2 winner 4300-3301 BCE (1.305); same underlying plateau'),
         dict(axis='sliding window', setting='all 1000-y windows, step 100 y', winner=str(sw.iloc[0].window_BCE), value=round(sw.iloc[0]['mean'],3),
              note='top window identical to the astronomical millennium')]
sens = pd.DataFrame(rows); print(sens.to_string(index=False)); sens.to_csv(R+'d_sensitivity.csv', index=False)

# ---------- (e) pollen comparison (interpretive only) ----------
sep('(e) POLLEN (Belau single-site) vs AMBER - interpretive background, NOT a criterion')
raw_win = ts[(ts.CE>=-4100)&(ts.CE<=-704)]
for nm,col in [('pollen_inter_100','pollen_inter_100'), ('pollen_inter','pollen_inter')]:
    s = raw_win.set_index('CE')[col]
    print(f'  {nm}: 250y-smoothed max {s.rolling(250,center=True,min_periods=1).mean().max():.3f} at '
          f'{-int(s.rolling(250,center=True,min_periods=1).mean().idxmax())} BCE; raw max {s.max():.3f} at '
          f'{-int(s.idxmax())} BCE (= youngest sample of the Belau record)')
print(f'  amber smoothed peak (250 y): {-M3[250][0]} BCE; amber top-decile core: 3300..2901 BCE')
print('  WARNING: beyond CE -704 ts.pollen_inter is FORWARD-FILLED at a constant 8.714')
print(f'         (std over CE -703..-500 = {ts[ts.CE>-704].pollen_inter.std():.2e}) -> the apparent "pollen maximum"')
print('         near 704-500 BCE is an artefact of the fill; all pollen maxima therefore sit at the record edge.')
ov = ts[ts.CE.between(-4100,-704)][['CE','pollen_inter_100','Amber_inter']].dropna()
x, y = ov.pollen_inter_100.values, ov.Amber_inter.values
cc=[]
for lag in range(-1000,1001,100):
    c = np.corrcoef(x[:len(x)-lag or None], y[lag:])[0,1] if lag>=0 else np.corrcoef(x[-lag:], y[:lag or None])[0,1]
    cc.append((lag, round(float(c),3)))
cc = pd.DataFrame(cc, columns=['lag_y_positive_amber_lags_pollen','r'])
print('  cross-correlation (Amber_inter vs pollen_inter_100), r(0)=%.3f, best lag=%+d y (r=%.3f):'
      % (cc.loc[cc.lag_y_positive_amber_lags_pollen==0,'r'].iloc[0], cc.loc[cc.r.idxmax(),'lag_y_positive_amber_lags_pollen'], cc.r.max()))
print(cc.to_string(index=False))
print('  reading: correlation is negative for all lags - amber abundance is HIGH while the Belau openness')
print('  signal is still low (4th millennium BCE) and LOW once openness rises late in the record.')
print('  pollen_grate_100 NOT used (definition not reproducible; |r|<=0.34 vs pollen_inter changes).')
cc.to_csv(R+'e_crosscorr_pollen_amber.csv', index=False)
ai.rename('Amber_inter').to_csv(R+'amber_inter_yearly.csv')

sep('SUMMARY (data-grounded)')
print(f'HIGHEST MILLENNIUM (R1 mean criterion): 4000-3001 BCE (= CE -4000..-3001 = 4951-5950 calBP), '
      f'mean Amber_inter = {ai.loc[-4000:-3001].mean():.3f}, next best usable block -0.277, gap 1.77 Z.')
print(f'PEAK INTERVAL: core (top-decile bins & Z=1.54 platform) 3300..2901 BCE (5251-4851 calBP);')
print(f'             broad high plateau (mean+1SD / half-max, all levels >= 1.46) 4000..2901 BCE (5951-4851 calBP).')
print(f'SMOOTHED PEAK POSITION: 3275-3175 BCE depending on window (50-250 y), band ~2900-4100 BCE.')
print(f'UNCERTAINTY: +/-100 y (one century bin); sub-century ordering of the 1.46 and 1.54 plateaux is NOT resolvable.')
print('PROXY CAVEAT: no price/value field exists; Z = standardised find abundance/density -> relative')
print('  importance/circulation only; frequency != value. High-positive = more amber is a CONVENTION.')
