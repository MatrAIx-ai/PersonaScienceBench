"""
Data audit (facts only) for DiscoveryBench archaeology task:
"In which millennium did amber have the highest value and in what time interval did it peak?"
Files: time_series_data.csv, capital.csv, pollen_openness_score_..._2019.csv
"""
import pandas as pd, numpy as np

pd.set_option('display.width', 200)
D = 'data/'

ts  = pd.read_csv(D+'time_series_data.csv')
cap = pd.read_csv(D+'capital.csv', decimal=',')
pol = pd.read_csv(D+'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

def sep(t): print('\n' + '='*78 + '\n' + t + '\n' + '='*78)

sep('1. SHAPES / COLUMNS / TIME COVERAGE')
for name, df, tcols in [('time_series_data.csv', ts, ['CE','calBP']),
                        ('capital.csv', cap, ['BCE']),
                        ('pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', pol, ['calBP','CE'])]:
    print(f'\n--- {name}: rows={len(df)}, cols={df.shape[1]}')
    print('columns:', list(df.columns))
    for c in tcols:
        s = pd.to_numeric(df[c], errors='coerce')
        print(f'  {c}: n_nonmissing={s.notna().sum()}, min={s.min()}, max={s.max()}')
    # time step info
    for c in tcols:
        s = pd.to_numeric(df[c], errors='coerce').dropna()
        d = np.diff(np.sort(s.values))
        vals, cnt = np.unique(d, return_counts=True)
        print(f'  {c}: sorted-diff value counts = {dict(zip(vals.tolist(), cnt.tolist()))}')
        print(f'  {c}: duplicated time points = {int(s.duplicated().sum())}')

sep('2. TIME AXIS CONTINUITY / GAPS (yearly axes)')
for name, df, c in [('time_series CE', ts, 'CE'), ('pollen CE', pol, 'CE'), ('pollen calBP', pol, 'calBP')]:
    s = np.sort(pd.to_numeric(df[c], errors='coerce').dropna().values)
    expected = np.arange(s.min(), s.max()+1)
    missing = sorted(set(expected) - set(s))
    print(f'{name}: range {s.min()}..{s.max()}, n={len(s)}, unique={len(set(s))}, '
          f'years_missing_within_range={len(missing)}'
          + (f' -> {missing[:20]}' if missing else ''))

sep('3. calBP <-> CE RELATIONSHIP (per file)')
for name, df in [('time_series_data', ts), ('pollen', pol)]:
    sub = df[['CE','calBP']].apply(pd.to_numeric, errors='coerce').dropna()
    diff = (sub['calBP'] + sub['CE']).unique()
    print(f'{name}: unique(calBP + CE) = {diff}  (i.e. calBP = -CE + {diff[0] if len(diff)==1 else "?"}; BP base year 1950)')
    print(f'  check: does CE==1950-calBP hold for all rows? '
          f'{bool(np.allclose(sub["CE"], 1950 - sub["calBP"]))}')

sep('4. capital.csv BCE vs time_series CE')
cap['BCE_num'] = pd.to_numeric(cap['BCE'], errors='coerce')
cap['CE_implied'] = -cap['BCE_num']
print('capital BCE values:', cap['BCE_num'].tolist())
print('capital BCE -> CE (x -1):', cap['CE_implied'].tolist())
print('capital group labels:', cap['group'].tolist())
ts_ce = set(pd.to_numeric(ts['CE'], errors='coerce').dropna().astype(int))
print('all implied CE present in time_series CE?', set(cap['CE_implied'].astype(int)) <= ts_ce)
missing_in_ts = sorted(set(cap['CE_implied'].astype(int)) - ts_ce)
print('capital implied CE missing from time_series:', missing_in_ts)

sep('5. AMBER VARIABLES')
print('time_series Amber      : non-missing=%d  min=%.4f max=%.4f mean=%.4f sd=%.4f' %
      (ts['Amber'].notna().sum(), ts['Amber'].min(), ts['Amber'].max(), ts['Amber'].mean(), ts['Amber'].std()))
print('time_series Amber_inter: non-missing=%d  min=%.4f max=%.4f mean=%.4f sd=%.4f' %
      (ts['Amber_inter'].notna().sum(), ts['Amber_inter'].min(), ts['Amber_inter'].max(), ts['Amber_inter'].mean(), ts['Amber_inter'].std()))
print('capital Zamber         : non-missing=%d  min=%.4f max=%.4f mean=%.4f sd=%.4f' %
      (cap['Zamber'].notna().sum(), cap['Zamber'].min(), cap['Zamber'].max(), cap['Zamber'].mean(), cap['Zamber'].std()))
print('Amber non-missing CE range: %d .. %d CE' % (
      ts.loc[ts['Amber'].notna(),'CE'].min(), ts.loc[ts['Amber'].notna(),'CE'].max()))
print('Amber_inter non-missing CE range: %d .. %d CE' % (
      ts.loc[ts['Amber_inter'].notna(),'CE'].min(), ts.loc[ts['Amber_inter'].notna(),'CE'].max()))
print('Amber missing years (CE) inside its own observed span: %d' %
      ts[(ts['CE']>ts.loc[ts['Amber'].notna(),'CE'].min()) & (ts['CE']<ts.loc[ts['Amber'].notna(),'CE'].max()) & ts['Amber'].isna()].shape[0])

sep('5b. Amber vs Amber_inter: how does interpolation work?')
sub = ts[ts['Amber'].notna()][['CE','Amber','Amber_inter']]
print('raw Amber unique-value count =', ts['Amber'].nunique(), '; Amber_inter unique count =', ts['Amber_inter'].nunique())
print('rows where both present and equal:', int((ts['Amber']==ts['Amber_inter']).sum()))
both = ts.dropna(subset=['Amber','Amber_inter'])
print('max |Amber - Amber_inter| where both present: %.6f' % (both['Amber']-both['Amber_inter']).abs().max())
print('sample (10 rows around first raw value changes):')
print(ts[(ts['Amber'].notna()) & (ts['Amber'].shift(1).notna())][['CE','Amber','Amber_inter']].head(8).to_string(index=False))
# check Amber_inter is linear interpolation between anchors on yearly grid
ai = ts.set_index('CE')['Amber_inter']
anchors = ts.dropna(subset=['Amber'])[['CE','Amber']]
print('\nAmber anchors (CE, Z) count =', len(anchors))
print(anchors.to_string(index=False))

sep('6. capital Zamber vs time_series Amber (consistency at shared bin starts)')
m = cap[['BCE_num','Zamber','group']].copy()
m['CE'] = -m['BCE_num']
j = m.merge(ts[['CE','Amber','Amber_inter']], on='CE', how='left')
print(j.to_string(index=False))
d = (j['Zamber'] - j['Amber']).abs()
print('max |Zamber - Amber| at matched CE = %.6g ; n matched = %d' % (d.max(), j['Amber'].notna().sum()))

sep('7. Z-VALUE SCALE CHECK (are they standardized?)')
for c in ['Amber','Amber_inter','pollen_inter','pollen_inter_100','Depot','Sickle','CopperGold']:
    s = ts[c].dropna()
    print(f'  ts.{c:22s} n={len(s):5d} mean={s.mean():+.3f} sd={s.std():.3f} min={s.min():+.3f} max={s.max():+.3f}')
for c in ['ZAxtSchwert','Zamber','ZCu_AU' if 'ZCu_AU' in cap else 'ZCU_AU','ZMonument','ZKeform']:
    s = pd.to_numeric(cap[c], errors='coerce').dropna()
    print(f'  cap.{c:22s} n={len(s):5d} mean={s.mean():+.3f} sd={s.std():.3f} min={s.min():+.3f} max={s.max():+.3f}')

sep('8. TIME SERIES RESOLUTION OF AMBER (is it 100-yr binned data held on a yearly grid?)')
a = ts.dropna(subset=['Amber'])['CE'].astype(int).values
print('Amber obs CE spacing value counts:', dict(zip(*[x.tolist() for x in np.unique(np.diff(np.sort(a)), return_counts=True)])))
ai2 = ts.dropna(subset=['Amber_inter'])['CE'].astype(int).values
print('Amber_inter obs CE spacing value counts:', dict(zip(*[x.tolist() for x in np.unique(np.diff(np.sort(ai2)), return_counts=True)])))
# how many distinct yearly Amber_inter values inside a century?
ts['cent'] = (ts['CE']//100)*100
g = ts.dropna(subset=['Amber_inter']).groupby('cent')['Amber_inter'].agg(['count','nunique','mean','max','min'])
print(g.head(12).to_string())
