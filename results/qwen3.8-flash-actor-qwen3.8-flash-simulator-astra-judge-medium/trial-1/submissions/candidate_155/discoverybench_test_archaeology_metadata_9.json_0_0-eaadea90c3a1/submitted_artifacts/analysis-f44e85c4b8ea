"""FINAL: Summed social capital peak & components (Bronze Age, Central Europe).
Master: time_series_data.csv (annual, CE negative = BCE; = capital.csv Z values, max|diff|=0 on 37 knots).
soc = CopperGold_inter + Amber_inter + MonumentCount_inter (Z, no re-standardization; Z cols are mean0/std1).
Century rule: century BCE = floor((-CE-1)/100)+1.
"""
import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')
COMP = ['CopperGold','Amber','MonumentCount']
ts['soc'] = ts[[c+'_inter' for c in COMP]].sum(axis=1)
ts['century'] = np.floor((-ts['CE']-1)/100).astype(int)+1

cen = ts.groupby('century').agg(
    soc=('soc','mean'), calBP_lo=('calBP','min'), calBP_hi=('calBP','max'),
    CopperGold=('CopperGold_inter','mean'), Amber=('Amber_inter','mean'),
    MonumentCount=('MonumentCount_inter','mean'), MonumentSize=('MonumentSize_inter','mean'),
    pollen100=('pollen_inter_100','mean'), pollograte=('pollen_grate_100','mean')).sort_index()

peak_c = int(cen['soc'].idxmax())
print(f"PEAK (century mean, interp): {peak_c} cBCE | soc={cen.soc[peak_c]:.3f} | "
      f"CE -{peak_c*100}..-{peak_c*100-99} | calBP {cen.calBP_hi[peak_c]}..{cen.calBP_lo[peak_c]}")
top = cen.soc.sort_values(ascending=False).head(5)
print("top5:", {int(k):round(v,3) for k,v in top.items()}, "| gaps:", {int(k):round(top.iloc[0]-v,3) for k,v in top.iloc[1:].items()})

knots = ts.dropna(subset=['CopperGold']).copy(); knots['soc_raw']=knots[COMP].sum(axis=1)
rk = knots.groupby('century')['soc_raw'].mean()
print("RAW-knot sensitivity: peak", int(rk.idxmax()), "cBCE; tie 13th/14th =", round(rk.max(),4))

t = ts.sort_values('CE').reset_index(drop=True)
for w in [50,100,150]:
    s = t['soc'].rolling(w, center=True, min_periods=w//2+1).mean(); i=s.idxmax()
    print(f"  {w}y smoothing peak: CE {t['CE'][i]} = {int(np.floor((-t['CE'][i]-1)/100)+1)} cBCE (val {s[i]:.3f})")

for c in COMP:
    cc = ts[[x+'_inter' for x in COMP if x!=c]].sum(axis=1).groupby(ts['century']).mean().dropna()
    print(f"  LOO drop {c}: peak {int(cc.idxmax())} cBCE ({cc.max():.3f}); value at {peak_c} cBCE = {cc[peak_c]:.3f}")
tot=ts['soc'].var()
print("variance shares:", {c: round(ts[c+'_inter'].cov(ts['soc'])/tot,3) for c in COMP},
      "| corr(soc,comp):", {c: round(ts['soc'].corr(ts[c+'_inter']),3) for c in COMP})
print("pairwise corr:\n", ts[[c+'_inter' for c in COMP]].corr().round(3))

base_idx=[37,38,39,40,41]
for c in COMP+['MonumentSize']:
    cc = cen[c].dropna(); base = cc.loc[base_idx].mean(); pc=int(cc.idxmax()); atpk=cc.get(peak_c,np.nan)
    cand = sorted([k for k in cc.index if k>=peak_c], reverse=True)
    start = next((s_c for s_c in cand if all(cc[k]>base+0.5 for k in cand if k<=s_c)), None)
    print(f"{c}: peak {pc} cBCE (max {cc.max():.3f}) | baseline(37-41 cBCE)={base:.3f} | "
          f"value at {peak_c} cBCE={atpk:.3f} (rise {atpk-base:+.3f} Z) | sustained-rise start: {start} cBCE")

print("pollen near peak:\n", cen.loc[peak_c-2:peak_c+2,['pollen100','pollograte']].round(3).to_string(),
      "\npollen_inter_100 max", round(ts['pollen_inter_100'].max(),3), "at CE", int(ts['CE'][ts['pollen_inter_100'].idxmax()]),
      "| baseline(37-41)=", round(cen.pollen100.loc[base_idx].mean(),3),
      "| gap: pollen file ends -702; -701..-500 uses filled tails")

extra = cap[cap['BCE'].isin([4300,4200])][['BCE','ZCU_AU','Zamber','ZMonument']].copy()
extra['soc_raw']=extra[['ZCU_AU','Zamber','ZMonument']].sum(axis=1)
extra['century']=np.ceil(extra['BCE']/100).astype(int)
print("capital-only rows 4300/4200 BCE soc_raw:", extra.soc_raw.round(3).tolist())
ak = pd.concat([knots[['century','soc_raw']], extra[['century','soc_raw']]]).groupby('century')['soc_raw'].mean()
print("peak incl. extra rows:", int(ak.idxmax()), "cBCE, max", round(ak.max(),3), "(tie 13/14; extras are -2.594, no early peak)")
cen.round(4).to_csv('analysis/century_table.csv')
print("saved analysis/century_table.csv")
