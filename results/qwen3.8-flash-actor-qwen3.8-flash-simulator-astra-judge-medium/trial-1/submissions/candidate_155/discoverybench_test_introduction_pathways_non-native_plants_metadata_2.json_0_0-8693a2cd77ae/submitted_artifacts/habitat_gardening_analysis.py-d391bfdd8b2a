"""
Main analysis: How does the prevalence of non-native plants introduced via gardening
vary based on habitat type? (Catalonia / Barcelona province datasets)

Approved design decisions implemented:
  1. Primary metrics = OCCUPANCY (fraction of plots of a habitat with n.gard > 0) and
     INTENSITY (mean n.gard per plot). Secondary = SHARE sum(n.gard)/sum(n.total),
     always reported with the record count sum(n.total).
  2. n.total == 0 treated as true absence of alien species; sensitivity analysis on the
     191 plots with n.total > 0 is reported.
  3. Habitats with < 10 species-occurrence records pooled as "Data-poor (<10 rec.)".
  4. Chi-square replaced by a permutation (Monte-Carlo) test; Kruskal-Wallis and
     quasi-binomial GLM n.gard ~ habitat (weights = n.total) kept; urban.2009.1000m and
     elevation only as a robustness check.
  5. Species level (77 unique species, 4 pathway-ambiguous) is secondary evidence.
  6. Phylogenetic tree excluded; temporal table used only as context (no habitat column).
  7. Delimiters set explicitly (TSV vs CSV), no auto-detection.
"""
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

DATA = "data"
SEED = 20261022
DATA_POOR_THRESHOLD = 10
rng = np.random.default_rng(SEED)
pd.set_option("display.width", 220); pd.set_option("display.max_columns", 60)

niche = pd.read_csv(f"{DATA}/invaded_niche_pathways.csv", sep="\t")
succ  = pd.read_csv(f"{DATA}/invasion_success_pathways.csv", sep=",")
temp  = pd.read_csv(f"{DATA}/temporal_trends_contingency_table.csv", sep="\t")

print("## 0. Data integrity checks")
assert (niche[["n.gard", "n.unint", "n.agfo"]].sum(axis=1) == niche["n.total"]).all()
assert (niche["n.gard"] <= niche["n.total"]).all()
assert niche[["longitude", "latitude"]].duplicated().sum() == 0
assert niche["habitat"].notna().all()
print(f"plots: {len(niche)} unique | n.total==0 in {(niche['n.total']==0).sum()} plots | "
      f"n.total>0 in {(niche['n.total']>0).sum()} plots")
print(f"species records: n.gard={niche['n.gard'].sum()}, n.unint={niche['n.unint'].sum()}, "
      f"n.agfo={niche['n.agfo'].sum()}, n.total={niche['n.total'].sum()}")
print("habitat levels (10):", sorted(niche['habitat'].unique()))
print("pathway spellings -> species table:", sorted(succ['intro.pathway'].dropna().unique()),
      "| temporal table:", sorted(temp['pathway'].unique()))

def habitat_table(df, label):
    g = df.groupby("habitat").agg(
        n_plots=("n.total", "size"), sum_n_total=("n.total", "sum"),
        sum_n_gard=("n.gard", "sum"), sum_n_unint=("n.unint", "sum"),
        sum_n_agfo=("n.agfo", "sum"), mean_n_gard=("n.gard", "mean"),
        plots_with_gard=("n.gard", lambda s: int((s > 0).sum())),
        mean_elevation_m=("elevation", "mean"), mean_urban1km=("urban.2009.1000m", "mean"))
    g["share_gard_of_n_total"] = g["sum_n_gard"] / g["sum_n_total"].replace(0, np.nan)
    g["occupancy_gard"] = g["plots_with_gard"] / g["n_plots"]
    g["share_of_all_gard_records"] = g["sum_n_gard"] / df["n.gard"].sum()
    g["data_poor_lt10"] = g["sum_n_total"] < DATA_POOR_THRESHOLD
    return g.sort_values(["occupancy_gard", "mean_n_gard"], ascending=False)

def show(g):
    out = g.copy()
    for c in ["share_gard_of_n_total", "occupancy_gard", "share_of_all_gard_records"]:
        out[c] = out[c].astype(float).round(3)
    out["mean_n_gard"] = out["mean_n_gard"].astype(float).round(3)
    out["mean_elevation_m"] = out["mean_elevation_m"].round(0)
    out["mean_urban1km"] = out["mean_urban1km"].round(3)
    return out[["n_plots", "sum_n_total", "sum_n_gard", "share_gard_of_n_total",
                "plots_with_gard", "occupancy_gard", "mean_n_gard",
                "share_of_all_gard_records", "mean_elevation_m", "mean_urban1km",
                "data_poor_lt10"]]

tab_all = habitat_table(niche, "all 632 plots")
tab_inv = habitat_table(niche[niche["n.total"] > 0], "191 invaded plots")
print("\n## 1. HABITAT TABLE - all 632 plots (primary)")
print(show(tab_all).to_string())
print("\n## 1b. SENSITIVITY - only plots with n.total>0 (n=%d)" % (niche['n.total'] > 0).sum())
print(show(tab_inv).to_string())
rk_all = tab_all["occupancy_gard"].rank(ascending=False)
rk_inv = tab_inv["occupancy_gard"].reindex(tab_all.index).rank(ascending=False)
sp = stats.spearmanr(rk_all.values, rk_inv.values, nan_policy="omit")
print(f"\nSpearman rho of habitat ranking (occupancy: all plots vs invaded-only) = "
      f"{sp.statistic:.3f}, p={sp.pvalue:.2e} -> ranking {'STABLE' if sp.statistic > 0.9 else 'NOT stable'}")
rk_i = tab_all["mean_n_gard"].rank(ascending=False)
rk_j = tab_inv["mean_n_gard"].reindex(tab_all.index).rank(ascending=False)
print("Spearman rho for mean_n_gard = %.3f" % stats.spearmanr(rk_i.values, rk_j.values, nan_policy='omit').statistic)
rich = tab_all.index[~tab_all["data_poor_lt10"]]
def lab(r):
    return "STABLE" if r >= 0.8 else ("partially stable" if r >= 0.5 else "ranking changes")
cmp_tbl = {}
for met in ["occupancy_gard", "mean_n_gard", "share_gard_of_n_total"]:
    a = tab_all.loc[rich, met].rank(ascending=False)
    b = tab_inv.loc[rich, met].rank(ascending=False)
    r = stats.spearmanr(a.values, b.values)
    cmp_tbl[met + "_all"] = a.astype(int); cmp_tbl[met + "_invadedOnly"] = b.astype(int)
    tag = "identical by construction (records exist only in invaded plots)" if met == "share_gard_of_n_total" else lab(r.statistic)
    print(f"  restricted to the {len(rich)} data-rich habitats (>=10 records): {met}: "
          f"rho={r.statistic:.3f} (p={r.pvalue:.3f}) -> {tag}")
print("\n  rank comparison, 6 data-rich habitats (all plots vs invaded-only):")
print(pd.DataFrame(cmp_tbl).sort_values("occupancy_gard_all").to_string())
top3_all = set(tab_all.loc[rich, "occupancy_gard"].sort_values(ascending=False).head(3).index)
top3_inv = set(tab_inv.loc[rich, "occupancy_gard"].sort_values(ascending=False).head(3).index)
print(f"  top-3 data-rich habitats by occupancy coincide: all-plots={sorted(top3_all)}, "
      f"invaded-only={sorted(top3_inv)}, intersection={sorted(top3_all & top3_inv)}")
bot_all = tab_all.loc[rich, "occupancy_gard"].sort_values().index[0]
bot_inv = tab_inv.loc[rich, "occupancy_gard"].sort_values().index[0]
print(f"  lowest data-rich habitat by occupancy: all-plots={bot_all}, invaded-only={bot_inv}")
print("  note: rho over all 10 habitats is low because data-poor habitats have 1-5 invaded "
      "plots and jump to occupancy 1.0 in the invaded-only view (artefact of tiny denominators).")

data_poor = list(tab_all.index[tab_all["data_poor_lt10"]])
print(f"\n## 2. Data-poor habitats pooled (threshold sum(n.total) < {DATA_POOR_THRESHOLD}): {data_poor}")
niche["habitat_grp"] = niche["habitat"].where(~niche["habitat"].isin(data_poor), "Data-poor (<10 rec.)")
dp = niche[niche["habitat_grp"] == "Data-poor (<10 rec.)"]
print(f"pooled data-poor: plots={len(dp)}, sum n.total={dp['n.total'].sum()}, "
      f"sum n.gard={dp['n.gard'].sum()}, plots with n.gard>0={int((dp['n.gard']>0).sum())}")

# 2a. permutation test on species-occurrence records (replaces asymptotic chi-square)
rows = []
for hab, sub in niche.groupby("habitat_grp"):
    rows.append(pd.DataFrame({"habitat": hab,
                              "is_gard": np.repeat([1, 0], [int(sub["n.gard"].sum()),
                                                            int((sub["n.total"] - sub["n.gard"]).sum())])}))
rec = pd.concat(rows, ignore_index=True)
ct = pd.crosstab(rec["habitat"], rec["is_gard"])
chi2, p_chi, dof, exp = stats.chi2_contingency(ct.values, correction=False)
obs_stat = chi2
print(f"\n## 2a. habitat_grp x pathway contingency over {len(rec)} species-occurrence records")
print(ct.assign(pct_gard=(100 * ct[1] / (ct[0] + ct[1])).round(1)).to_string())
print(f"chi2={chi2:.2f}, asymptotic p={p_chi:.3e}, dof={dof}, min expected count={exp.min():.2f} "
      f"-> asymptotic chi2 NOT trustworthy; permutation test used instead")
nperm, labels = 20000, rec["is_gard"].to_numpy()
habs = rec["habitat"].to_numpy()
habs_u = np.unique(habs)
codes = pd.Categorical(habs, categories=habs_u).codes
perm = np.empty(nperm)
sh = labels.copy()
for i in range(nperm):
    sh = rng.permutation(labels)
    t = np.vstack([np.bincount(sh[codes == k], minlength=2) for k in range(len(habs_u))])
    e = np.outer(t.sum(1), t.sum(0)) / t.sum()
    perm[i] = ((t - e) ** 2 / e).sum()
p_perm = (1 + np.sum(perm >= obs_stat)) / (1 + nperm)
print(f"permutation (Monte-Carlo) test of habitat x pathway association: chi2_obs={obs_stat:.2f}, "
      f"p_perm={(p_perm):.5f} ({nperm} permutations, seed={SEED}); permutation p distribution "
      f"max={perm.max():.1f}, 95th pct={np.percentile(perm,95):.2f}")
contrib = pd.Series(((ct[1] - exp[:, 1]) ** 2 / exp[:, 1]).round(2), name="chi2_contribution_gard_col")
print("per-group contributions to chi2 (gardening column):")
print(contrib.sort_values(ascending=False).to_string())

# 2b. per-habitat 2x2 Fisher exact vs all other groups, Holm adjusted
print("\n## 2b. per-group 2x2 Fisher exact (gard records vs rest, group vs all other groups)")
overall = rec["is_gard"].mean()
pv = {h: stats.fisher_exact(np.vstack([ct.loc[h].to_numpy()[::-1],
                                       ct.drop(index=h).to_numpy().sum(0)[::-1]]))[1] for h in ct.index}
s = pd.Series(pv).sort_values()
holm = np.clip(np.minimum.accumulate((s.values * np.arange(len(s), 0, -1))[::-1])[::-1], 0, 1)
res = pd.DataFrame({"fisher_p": s.round(6).values, "holm_p": np.round(holm, 5)}, index=s.index)
res["group_pct_gard"] = (100 * ct[1] / (ct[0] + ct[1])).reindex(res.index).round(1).values
res["vs_overall_pct"] = round(100 * overall, 1)
res["direction"] = np.where(res["group_pct_gard"] > 100 * overall, "ENRICHED", "depleted")
print(f"overall gardening share of records = {100*overall:.1f}%")
print(res.to_string())

# 2c. Kruskal-Wallis on plot-level n.gard
kw = stats.kruskal(*[g.values for _, g in niche.groupby("habitat_grp")["n.gard"]])
kw_inv = stats.kruskal(*[g.values for _, g in niche[niche["n.total"] > 0].groupby("habitat_grp")["n.gard"]])
niche["has_gard"] = (niche["n.gard"] > 0).astype(int)
kw_occ = stats.kruskal(*[g.to_numpy() for _, g in niche.groupby("habitat_grp")["has_gard"]])
print(f"\n## 2c. Kruskal-Wallis on plot-level n.gard across the 7 habitat_grp levels: "
      f"H={kw.statistic:.2f}, p={kw.pvalue:.3e}; restricted to n.total>0: H={kw_inv.statistic:.2f}, "
      f"p={kw_inv.pvalue:.3e}; on binary occupancy indicator: H={kw_occ.statistic:.2f}, p={kw_occ.pvalue:.3e}")

# 2d. quasi-binomial GLM: n.gard / n.total ~ habitat_grp, freq_weights = n.total
glm_df = niche[niche["n.total"] > 0].copy()
glm_df["prop_gard"] = glm_df["n.gard"] / glm_df["n.total"]
glm_df = glm_df.rename(columns={"urban.2009.1000m": "urban1km", "elevation": "elev"})  # dots break patsy
m = smf.glm("prop_gard ~ C(habitat_grp)", data=glm_df, family=sm.families.Binomial(),
            freq_weights=glm_df["n.total"]).fit(scale="X2")
print(f"\n## 2d. quasi-binomial GLM  n.gard/n.total ~ C(habitat_grp), freq_weights=n.total "
      f"(n={len(glm_df)} invaded plots; reference level = Coastal, first alphabetically)")
print(f"residual deviance/df = {m.deviance/m.df_resid:.2f} (scale='X2' -> quasi-binomial)")
print(m.summary().tables[1])
hab_idx = [i for i, nm in enumerate(m.params.index) if "habitat_grp" in nm]
F = m.f_test(np.eye(len(m.params))[hab_idx])
print(f"joint F-test of all habitat levels: F={float(np.squeeze(F.fvalue)):.2f}, p={float(np.squeeze(F.pvalue)):.3e}")

# 2e. robustness with covariates + plot-level logistic on occupancy
m_rob = smf.glm("prop_gard ~ C(habitat_grp) + urban1km + elev", data=glm_df,
                family=sm.families.Binomial(), freq_weights=glm_df["n.total"]).fit(scale="X2")
m_nohab = smf.glm("prop_gard ~ urban1km + elev", data=glm_df,
                  family=sm.families.Binomial(), freq_weights=glm_df["n.total"]).fit()
Fh = m_rob.f_test(np.eye(len(m_rob.params))[hab_idx])
dev_drop = m_nohab.deviance - m_rob.deviance
print("\n## 2e. ROBUSTNESS: habitat effect after adding urban.2009.1000m + elevation")
print(f"   habitat block Wald F={float(np.squeeze(Fh.fvalue)):.2f}, p={float(np.squeeze(Fh.pvalue)):.3e} "
      f"-> habitat effect {'PERSISTS' if float(np.squeeze(Fh.pvalue))<0.05 else 'not retained'}")
print(f"   deviance drop when habitat added = {dev_drop:.2f} on {len(hab_idx)} df "
      f"(naive chi2 p={stats.chi2.sf(dev_drop, len(hab_idx)):.2e}; overdispersed -> indicative only)")
print(f"   urban1km beta={m_rob.params['urban1km']:.3f} (p={m_rob.pvalues['urban1km']:.3g}; "
      f"elevation beta={m_rob.params['elev']:.5f} (p={m_rob.pvalues['elev']:.3g})")
occ = niche.assign(has_gard=(niche["n.gard"] > 0).astype(int), urban1km=niche["urban.2009.1000m"], elev=niche["elevation"])
mo = smf.glm("has_gard ~ C(habitat_grp)", data=occ, family=sm.families.Binomial()).fit()
mor = smf.glm("has_gard ~ C(habitat_grp) + urban1km + elev", data=occ,
              family=sm.families.Binomial()).fit()
idx_o = [i for i, nm in enumerate(mo.params.index) if "habitat_grp" in nm]
idx_r = [i for i, nm in enumerate(mor.params.index) if "habitat_grp" in nm]
print(f"   plot-level logistic on (n.gard>0), all {len(occ)} plots: habitat Wald p="
      f"{float(np.squeeze(mo.f_test(np.eye(len(mo.params))[idx_o]).pvalue)):.3e}; with covariates p="
      f"{float(np.squeeze(mor.f_test(np.eye(len(mor.params))[idx_r]).pvalue)):.3e}")

# 3. species level (secondary)
succ["is_gard"] = succ["intro.pathway"].eq("Gardening")
amb = ["Eucalyptus camaldulensis Dehnh.", "Opuntia ficus-indica (L.) Mill.",
       "Oxalis debilis Kunth", "Populus deltoides Marshall"]
core = succ[succ["duplicated"] == False].copy()
print("\n## 3. SPECIES LEVEL (secondary evidence)")
print(f"rows={len(succ)}, unique species={succ['Scientific_name'].nunique()}, "
      f"duplicated-flagged rows={int(succ['duplicated'].sum())}, habitat.range NA={int(succ['habitat.range'].isna().sum())}")
print(f"Gardening rows incl. pathway-conflicting duplicates={int(succ['is_gard'].sum())}; "
      f"unique-species Gardening={int(core['is_gard'].sum())} "
      f"({core['intro.pathway'].value_counts().to_dict()})")
print("ambiguous species (two rows, different pathways):", amb)
for frame, name in [(succ, "all 81 rows"), (core, "77 unique species")]:
    a, b = frame.loc[frame.is_gard, "habitat.range"], frame.loc[~frame.is_gard, "habitat.range"]
    a2, b2 = frame.loc[frame.is_gard, "number.of.invaded.plots"], frame.loc[~frame.is_gard, "number.of.invaded.plots"]
    u1, u2 = stats.mannwhitneyu(a, b), stats.mannwhitneyu(a2, b2)
    print(f"  [{name}] habitat.range gardening mean={a.mean():.2f}/median={a.median():.1f} vs others "
          f"{b.mean():.2f}/{b.median():.1f} (MWU p={u1.pvalue:.3f}) | number.of.invaded.plots gardening "
          f"{a2.mean():.2f}/{a2.median():.1f} vs {b2.mean():.2f}/{b2.median():.1f} (MWU p={u2.pvalue:.3f})")

# 4. temporal context
print("\n## 4. TEMPORAL CONTEXT (this table has NO habitat column)")
tt = temp.pivot_table(index="introduction.period", columns="pathway", values="n", aggfunc="sum")
tt["total"] = tt.sum(axis=1); tt["gardening_share"] = (tt["Gardening"] / tt["total"]).round(3)
print(tt.loc[["Before 1500", "1501-1900", "1901-1984", "1985-2019"]].to_string())

# 5. persist
cols = ["n_plots", "sum_n_total", "sum_n_gard", "sum_n_unint", "sum_n_agfo",
        "share_gard_of_n_total", "plots_with_gard", "occupancy_gard", "mean_n_gard",
        "share_of_all_gard_records", "mean_elevation_m", "mean_urban1km", "data_poor_lt10"]
out = tab_all[cols].round(4).copy()
out.insert(0, "rank_occupancy", tab_all["occupancy_gard"].rank(ascending=False).astype(int).values)
out.insert(1, "rank_mean_n_gard", tab_all["mean_n_gard"].rank(ascending=False).astype(int).values)
out.insert(2, "rank_share", tab_all["share_gard_of_n_total"].rank(ascending=False, method="min").astype(int).values)
out.to_csv("analysis/habitat_gardening_table.csv")
tab_inv[cols].round(4).to_csv("analysis/habitat_gardening_table_sensitivity_invaded_plots.csv")
print("\nwrote analysis/habitat_gardening_table.csv + analysis/habitat_gardening_table_sensitivity_invaded_plots.csv")
print(out.to_string())

# ---------------------------------------------------------------- 6. conclusion block
human = ["Wetlands", "Urban", "Coastal", "Riparian"]
rec_h = int(tab_all.loc[human, "sum_n_gard"].sum()); tot_rec = int(tab_all["sum_n_gard"].sum())
plots_h = int(tab_all.loc[human, "n_plots"].sum()); tot_plot = int(tab_all["n_plots"].sum())

def cell(h):
    r = tab_all.loc[h]
    return (f"{h} ({r['occupancy_gard']*100:.1f}% of {int(r['n_plots'])} plots with n.gard>0, "
            f"mean n.gard = {r['mean_n_gard']:.2f}, share = {int(r['sum_n_gard'])}/"
            f"{int(r['sum_n_total'])} = {r['share_gard_of_n_total']:.2f})")

HYP = (
 "Prevalence of gardening-introduced (ornamental) non-native plants varies strongly with habitat "
 "type: it is highest in human-used lowland habitats (mean elevation of the four top habitats "
 "176-386 m a.s.l.) and lowest in croplands and in the "
 "species-poor natural/semi-natural habitats. In the plot dataset (invaded_niche_pathways.csv; "
 f"{tot_plot} plots, {int(tab_all['sum_n_total'].sum())} species-occurrence records in n.total, "
 f"{tot_rec} of them n.gard) gardening records concentrate in "
 + ", ".join(cell(h) for h in human)
 + f". These four habitat types hold {100*rec_h/tot_rec:.0f}% of all n.gard records while covering "
   f"only {100*plots_h/tot_plot:.0f}% of the plots. Croplands are gardening-poor and "
   "unintentional-dominated (n.gard = 20 of n.total = 108, share 0.19, occupancy 20.7%, while "
   "n.unint = 83), and gardening is rare in Meadows (n.gard = 4 of 13, occupancy 7.7%). The four "
   "habitats with fewer than 10 records (Coniferous forests 8, Broad-leaved forests 4, Scrublands "
   "5, Rock outcrops 1; 308 plots in total) are gardening-rare per plot (occupancy 0-6.5%): their "
   "formal shares of 0.875 and 1.000 rest on 8 and 4 records and must not be read as 'forests are "
   "mainly garden plants'. Urban carries the largest absolute number of gardening records (45 of "
   f"{tot_rec}, {45/tot_rec*100:.0f}%) but only a mid-range share (0.30), because unintentional "
   "introductions dominate there (104 of 151 records)."
)
SENS = ("Sensitivity: restricting to the 191 plots with n.total > 0 (treating the 441 zero plots as "
        "true absences vs as non-observations) leaves the substantive gradient unchanged - Wetlands "
        "stays rank 1 and Croplands last among the six data-rich habitats, the share ranking is "
        "identical (Spearman rho = 1.000) and intensity ranking is stable (mean n.gard rho = 0.886, "
        "p = 0.019); only the occupancy ranks of Urban (2 -> 5) and Meadows (6 -> 4) shift, which "
        "reflects the changed denominator, not a reversal of the habitat pattern.")
SUP = ("Statistical support: permutation test of habitat x pathway over the 481 records "
       f"(20000 permutations, seed {SEED}) chi2 = {obs_stat:.2f}, p_perm = {p_perm:.5f} "
       f"(asymptotic chi2 p = {p_chi:.2e}, min expected count {exp.min():.2f}); Kruskal-Wallis on "
       f"n.gard per plot H = {kw.statistic:.2f}, p = {kw.pvalue:.2e}; quasi-binomial GLM "
       f"n.gard/n.total ~ habitat with weights n.total, joint habitat F = "
       f"{float(np.squeeze(F.fvalue)):.2f}, p = {float(np.squeeze(F.pvalue)):.2e}. The habitat "
       f"effect survives addition of urban.2009.1000m and elevation (Wald F = "
       f"{float(np.squeeze(Fh.fvalue)):.2f}, p = {float(np.squeeze(Fh.pvalue)):.2e}), so the "
       "association is not merely a proxy for local urbanisation or climate, but the hypothesis is "
       "descriptive, not causal. " + SENS)
HYP2 = (
 "Secondary nuance: within the species-poor seminatural habitats (data-poor group: Coniferous and "
 "Broad-leaved forests, Scrublands, Rock outcrops) gardening accounts for 13 of only 18 records "
 "(72.2%, Fisher exact vs all other habitats, Holm p = 0.009), i.e. when an alien species does "
 "occur there it is usually a garden escape - but this rests on 18 records over 308 plots and "
 "coexists with a plot-level occupancy of only 3.3%. Croplands show the opposite (18.5% gardening, "
 "Holm p = 0.00023; 83 of 108 records are unintentional). At the species level (77 unique species, "
 "39 gardening; 42 'Gardening' rows once the 4 pathway-conflicting duplicates are counted twice) "
 "gardening species are not broader in habitat.range (mean 2.00 vs 2.45, MWU p = 0.437) nor more "
 "widely distributed in number.of.invaded.plots (3.97 vs 7.82, p = 0.271), so the habitat contrast "
 "is a property of the habitats and of human land use rather than of inherently generalist garden "
 "species."
)
print("\n## 6. HYPOTHESIS (data-grounded, descriptive)\n" + HYP + "\n\n" + HYP2 + "\n\n" + SUP)
with open("analysis/hypothesis.md", "w") as fh:
    fh.write("# Hypothesis: prevalence of gardening-introduced non-native plants by habitat\n\n"
             + HYP + "\n\n" + HYP2 + "\n\n## Statistical support\n" + SUP +
             "\n\n## Per-habitat table\n```\n" + out.to_string() + "\n```\n"
             "\n## Per-group Fisher exact (gard vs rest, vs all other groups, Holm)\n```\n"
             + res.to_string() + "\n```\n\n## Species-level secondary evidence\n"
             "- 81 rows, 77 unique species, 4 rows flagged duplicated = same species with a "
