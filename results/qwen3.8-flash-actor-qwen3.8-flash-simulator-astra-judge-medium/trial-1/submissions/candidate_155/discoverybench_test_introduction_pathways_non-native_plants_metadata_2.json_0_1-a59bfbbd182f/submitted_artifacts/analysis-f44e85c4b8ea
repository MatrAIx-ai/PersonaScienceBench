def design(series, ref):
    levs = [l for l in sorted(series.unique()) if l != ref]
    return pd.DataFrame({l: (series == l).astype(float) for l in levs}, index=series.index)

def qb(y, n, X, label, refnote=""):
    """Quasi-binomial GLM (grouped binomial endog), X = predictor matrix (no intercept added if all 0/1 dummies vs ref)."""
    endog = np.column_stack([np.asarray(y, float), np.asarray(n, float)-np.asarray(y, float)])
    Xc = sm.add_constant(pd.DataFrame(X).astype(float))
    m  = sm.GLM(endog, Xc.values, family=sm.families.Binomial()).fit(scale="X2", use_t=True)
    m0 = sm.GLM(endog, np.ones((len(y),1)), family=sm.families.Binomial()).fit(scale="X2")
    disp = m.pearson_chi2/m.df_resid
    lrt  = m0.deviance - m.deviance   # deviance-based LRT
    q = m.df_model-m0.df_model
    F = (lrt/q)/disp if q>0 else np.nan
    pF = 1-f_dist.cdf(F, q, m.df_resid) if q>0 else np.nan
    print(f"\n[QUASI-BINOMIAL {label}] n={len(y)} occurrences={int(np.sum(n))} dispersion(phi)={disp:.2f} "
          f"deviance={m.deviance:.1f}/{m.df_resid:.0f} null-deviance={m0.deviance:.1f} "
          f"deviance-explained={(1-m.deviance/m0.deviance)*100:.2f}% LRT={lrt:.1f} df={q:.0f} "
          f"quasi-F={F:.2f} p={pF:.3g} {refnote}")
    tab = pd.DataFrame({"coef":m.params[1:],"se":m.bse[1:],"t":m.tvalues[1:],
                        "ci_lo":m.conf_int()[1:,0],"ci_hi":m.conf_int()[1:,1],"p":m.pvalues[1:]},
                       index=list(X.columns)).round(3)
    print("  intercept(logit)=%.3f  se=%.3f"%(m.params[0], m.bse[0])); print(tab.to_string())
    m.params = pd.Series(np.asarray(m.params), index=["const"]+list(X.columns))
    m.bse    = pd.Series(np.asarray(m.bse),   index=["const"]+list(X.columns))
    return m, disp

def bb_nll(par, y, n, X, k, disp):
    mu = expit(X @ par[:k])
    if disp: rho = expit(par[k]); a, b = mu/rho, (1-mu)/rho
    else:    a, b = mu*1e6, (1-mu)*1e6
    ll = gammaln(n+1)-gammaln(y+1)-gammaln(n-y+1) + betaln(y+a, n-y+b) - betaln(a, b)
    return -np.sum(ll)

def fit_bb(y, n, X, disp=True):
    X = np.asarray(X, float); y = np.asarray(y, float); n = np.asarray(n, float)
    k = X.shape[1]; p0 = np.zeros(k + (1 if disp else 0))
    p0[0] = logit(max(y.sum()/n.sum(), 1e-3)); 
    if disp: p0[k] = -2.0
    res = minimize(bb_nll, p0, args=(y,n,X,k,disp), method="BFGS", options={"maxiter":5000,"gtol":1e-6})
    fp = lambda p: bb_nll(p,y,n,X,k,disp); h = 1e-4; p = res.x; kx = len(p); H = np.zeros((kx,kx))
    for i in range(kx):
        for j in range(kx):
            ei = np.zeros(kx); ej = np.zeros(kx); ei[i]=h; ej[j]=h
            H[i,j] = (fp(p+ei+ej)-fp(p+ei-ej)-fp(p-ei+ej)+fp(p-ei-ej))/(4*h*h)
    try: se = np.sqrt(np.clip(np.diag(np.linalg.inv(H)),0,None))
    except np.linalg.LinAlgError: se = np.full(kx, np.nan)
    return res, se

def bb_groups(y, n, groups, label):
    g = np.asarray(groups); levs = list(dict.fromkeys(g))
    X = np.column_stack([(g==l).astype(float) for l in levs])
    res, se = fit_bb(y, n, X); rho = expit(res.x[len(levs)])
    resn, _ = fit_bb(y, n, np.ones((len(y),1))); lrt = 2*(resn.fun-res.fun); k = len(levs)
    rows=[dict(habitat=l, plots=int((g==l).sum()), gard=int(np.asarray(y)[g==l].sum()),
               trials=int(np.asarray(n)[g==l].sum()),
               obs_share=round(np.asarray(y)[g==l].sum()/np.asarray(n)[g==l].sum(),3),
               bb_mean=round(expit(res.x[i]),3), ci_lo=round(expit(res.x[i]-1.96*se[i]),3),
               ci_hi=round(expit(res.x[i]+1.96*se[i]),3), se=round(se[i],3)) for i,l in enumerate(levs)]
    print(f"\n[BETA-BINOMIAL {label}] overdispersion rho={rho:.4f} -logLik(group)={res.fun:.2f} "
          f"-logLik(single mean)={resn.fun:.2f} LRT={lrt:.2f} df={k-1} p={chi2.sf(lrt,k-1):.3g}")
    print(pd.DataFrame(rows).sort_values("obs_share", ascending=False).to_string(index=False))
    return pd.DataFrame(rows)

