def gtest(tab, label, B=20000):
    tab=np.asarray(tab,float)
    def G(T):
        E=np.outer(T.sum(1),T.sum(0))/T.sum()
        with np.errstate(divide="ignore",invalid="ignore"):
            t=np.where(T>0,T*np.log(T/E),0.0)
        return 2*t.sum()
    gobs=G(tab); pc=tab.sum(0)/tab.sum(); rt=tab.sum(1)
    null=np.empty(B); sims=np.empty((B,)+tab.shape)
    for b in range(B):
        T=np.array([RNG.multinomial(int(r),pc) for r in rt]).astype(float)
        null[b]=G(T); sims[b]=T
    p=(1+(null>=gobs).mean())/(1+B)
    E=np.outer(tab.sum(1),tab.sum(0))/tab.sum()
    resid=(tab-E)/np.sqrt(E); sr=(sims-E)/np.sqrt(E)
    pcell=np.array([(1+np.sum(np.abs(sr[:,i,j])>=abs(resid[i,j])))/(1+B)
                    for i in range(tab.shape[0]) for j in range(tab.shape[1])]).reshape(tab.shape)
    dof=(tab.shape[0]-1)*(tab.shape[1]-1)
    print(f"\n-- {label}: G={gobs:.2f} df={dof} MonteCarlo p={p:.4g} (asymptotic chi2 p={chi2.sf(gobs,dof):.3g}; "
          f"null G mean={null.mean():.1f} sd={null.std():.1f}; expected cells<5: {int((E<5).sum())}/{E.size})")
    return resid, E, pcell

def plot_perm(key,B=20000):
    """Permutation null that keeps the plot as the unit: pathway counts are shuffled
    across plots, so habitat totals of occurrences are NOT held fixed (unlike the
    multinomial G-test above). This is the conservative check on the plot-level GLM."""
    grp=inv[key].to_numpy(dtype=object)
    cnt=inv[["n.gard","non_gard"]].to_numpy(float)
    levs=np.unique(grp); L=len(levs); li={l:i for i,l in enumerate(levs)}
    gi=np.array([li[g] for g in grp])
    def G_from(idx):
        tab=np.zeros((L,2))
        np.add.at(tab,gi[idx],cnt)
        tot=tab.sum(0)
        E=np.outer(tab.sum(1),tot)/tot.sum()
        with np.errstate(divide="ignore",invalid="ignore"):
            t=np.where(tab>0,tab*np.log(tab/E),0.0)
        return 2*np.nansum(t)
    base=np.arange(len(grp)); gobs=G_from(base); null=np.empty(B)
    for b in range(B): null[b]=G_from(RNG.permutation(len(grp)))
    print(f"-- permutation of pathway counts ACROSS PLOTS, grouping={key}: G={gobs:.2f} "
          f"MC p={(1+(null>=gobs).mean())/(1+B):.4g}")

