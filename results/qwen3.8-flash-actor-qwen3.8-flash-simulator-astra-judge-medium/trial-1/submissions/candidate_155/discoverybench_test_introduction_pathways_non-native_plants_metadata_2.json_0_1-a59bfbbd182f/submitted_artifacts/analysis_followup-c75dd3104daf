"""Follow-up: shape of the context relationships (monotone vs hump) and the two-axis style summary."""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy.special import expit
inv=pd.read_csv("/workspace/data/invaded_niche_pathways.csv",sep="\t")
inv["non_gard"]=inv["n.total"]-inv["n.gard"]
occ=inv[inv["n.total"]>0].copy()
z=lambda s:(s-s.mean())/s.std()
occ["urb500"]=occ["urban.2009.500m"]; occ["crop500"]=occ["cropland.2009.500m"]
occ["urb_z"]=z(occ.urb500); occ["urb_z2"]=occ.urb_z**2
occ["crop_z"]=z(occ.crop500); occ["crop_z2"]=occ.crop_z**2

def qb(X,label):
    y=np.column_stack([occ["n.gard"], occ["n.total"]-occ["n.gard"]])
    Xc=sm.add_constant(X.astype(float))
    m=sm.GLM(y,Xc.values,family=sm.families.Binomial()).fit(scale="X2",use_t=True)
    disp=m.pearson_chi2/m.df_resid
    print(f"\n[{label}] n={len(occ)} phi={disp:.2f} deviance={m.deviance:.1f}/{m.df_resid:.0f}")
    print(pd.DataFrame({"term":["const"]+list(X.columns),"coef":np.round(np.asarray(m.params),3),
          "se":np.round(np.asarray(m.bse),3),"p":np.round(np.asarray(m.pvalues),4)}).to_string(index=False))
    return m
qb(pd.DataFrame({"urb_z":occ.urb_z}),"urban 500m linear")
qb(pd.DataFrame({"urb_z":occ.urb_z,"urb_z2":occ.urb_z2}),"urban 500m quadratic (hump test)")
qb(pd.DataFrame({"crop_z":occ.crop_z}),"cropland 500m linear")
qb(pd.DataFrame({"crop_z":occ.crop_z,"crop_z2":occ.crop_z2}),"cropland 500m quadratic")

print("\nGARDENING SHARE BY URBAN-COVER CLASS (500m buffer, invaded plots):")
bins=[-.001,.001,.05,.2,.4,1.01]; labs=["0 (no urban)","~0-0.05","0.05-0.2","0.2-0.4",">0.4"]
occ["ub"]=pd.cut(occ.urb500,bins,labels=labs)
t=occ.groupby("ub",observed=True).agg(plots=("n.total","size"),gard=("n.gard","sum"),tot=("n.total","sum"))
t["share"]=(t.gard/t.tot).round(3); print(t.to_string())
print("\nGARDENING SHARE BY CROPLAND-COVER CLASS (500m buffer):")
occ["cb"]=pd.cut(occ.crop500,[-.001,.001,.1,.3,.6,1.01],labels=["0 (no cropland)","~0-0.1","0.1-0.3","0.3-0.6",">0.6"])
t2=occ.groupby("cb",observed=True).agg(plots=("n.total","size"),gard=("n.gard","sum"),tot=("n.total","sum"))
t2["share"]=(t2.gard/t2.tot).round(3); print(t2.to_string())
print("\nCOMBINED urban x cropland mosaic (share; cells with >=5 invaded plots):")
occ["uz"]=np.where(occ.urb500>0.15,"urban>0.15","urban<=0.15")
occ["cz"]=np.where(occ.crop500>0.15,"crop>0.15","crop<=0.15")
piv=occ.pivot_table(index="uz",columns="cz",values=["n.gard","n.total"],aggfunc="sum")
sh=(piv["n.gard"]/piv["n.total"]).round(3); n=occ.pivot_table(index="uz",columns="cz",values="n.total",aggfunc="size")
print("share:\n",sh.to_string()); print("invaded plots:\n",n.to_string())
print("\nTWO-AXIS STYLE TABLE (final):")
st=inv.groupby("habitat").agg(plots=("n.total","size"),inv=("n.total",lambda s:(s>0).sum()),
   gard=("n.gard","sum"),unint=("n.unint","sum"),agfo=("n.agfo","sum"),tot=("n.total","sum"),
   elev=("elevation","mean"),temp=("annual.temperature","mean"),urb=("urban.2009.500m","mean"),
   crop=("cropland.2009.500m","mean"),road=("distance.road","mean"))
st["share"]=(st.gard/st.tot).round(3); st["gard_per_100plots"]=(100*st.gard/st.plots).round(1)
st["unint_share"]=(st.unint/st.tot).round(3)
print(st.sort_values("share",ascending=False).round(2).to_string())
st.round(4).to_csv("/workspace/analysis/results_final_style_table.csv")
