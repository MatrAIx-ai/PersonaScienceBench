"""Inspection-only pass over the four staged files (no model fitting).
Outputs: shape, dtypes, categorical levels, missingness, duplicates,
habitat usability as stratifier, unit-of-analysis diagnostics, sparsity diagnostics.
"""
import re
import pandas as pd, numpy as np
from scipy.stats import chi2_contingency

D = "/workspace/data"
inv = pd.read_csv(f"{D}/invaded_niche_pathways.csv", sep="\t")
sp = pd.read_csv(f"{D}/invasion_success_pathways.csv")
tt = pd.read_csv(f"{D}/temporal_trends_contingency_table.csv", sep="\t")
tree = open(f"{D}/phylogenetic_tree.txt").read()

print("### SHAPES / DELIMITERS")
print("invaded_niche_pathways", inv.shape, "| invasion_success", sp.shape, "| temporal", tt.shape)
print("invasion_success has NA-only cols:", [c for c in sp if sp[c].isna().mean() > 0.9])

print("\n### MISSINGNESS / DUPLICATES")
print("invaded_niche NA total:", int(inv.isna().sum().sum()), "| duplicated rows:", int(inv.duplicated().sum()))
print("unique (lon,lat) rows:", inv[["longitude","latitude"]].drop_duplicates().shape[0], "of", len(inv))
print("invasion_success NA counts:", sp.isna().sum()[sp.isna().sum()>0].to_dict())
print("invasion_success duplicated Scientific_name:", int(sp['Scientific_name'].duplicated().sum()),
      "| 'duplicated' flag TRUE:", int(sp['duplicated'].sum()))

print("\n### UNIT OF ANALYSIS (invaded_niche_pathways)")
print("identity n.total == n.gard+n.unint+n.agfo:", bool(((inv['n.total']-(inv['n.gard']+inv['n.unint']+inv['n.agfo']))==0).all()))
print("per-plot count distribution n.total:", inv['n.total'].value_counts().sort_index().to_dict())
print("empty plots:", int((inv['n.total']==0).sum()), "| species-plot occurrences:", int(inv['n.total'].sum()))
print("sum(number.of.invaded.plots) species table:", int(sp['number.of.invaded.plots'].sum()),
      "| excl. dup-flagged:", int(sp.loc[~sp['duplicated'],'number.of.invaded.plots'].sum()))
print("sum(habitat.range) = species x habitat pairs implied:", int(sp['habitat.range'].sum()),
      "-> far below 481, so n.* are per-PLOT occurrences, not distinct species per habitat")

print("\n### HABITAT AS STRATIFIER")
g = inv.groupby('habitat').agg(plots=('n.total','size'), occ=('n.total','sum'),
                               gard=('n.gard','sum'), unint=('n.unint','sum'), agfo=('n.agfo','sum'),
                               elev=('elevation','mean'), temp=('annual.temperature','mean'),
                               rain=('annual.rainfall','mean'),
                               urb500=('urban.2009.500m','mean'), crop500=('cropland.2009.500m','mean'),
                               prog=('progressive.1993.2009.50m','mean'))
g['gard_share'] = (g.gard/g.occ).round(3)
print(g.sort_values('occ', ascending=False).round(2).to_string())
tab = g[['gard','unint','agfo']].values
chi2,p,dof,exp = chi2_contingency(tab)
print(f"3x10 chi2={chi2:.1f} p={p:.2g} dof={dof} min expected={exp.min():.2f} "
      f"cells<5={int((exp<5).sum())}/{exp.size} cells<1={int((exp<1).sum())}")

print("\n### COVARIATE SUITABILITY")
lc = ['urban.2009.500m','urban.2009.1000m','cropland.2009.500m','cropland.2009.1000m','elevation','annual.temperature']
print(inv[lc].corr().round(2).to_string())
print("annual.radiation range/SD:", round(inv['annual.radiation'].max()-inv['annual.radiation'].min(),1),
      round(inv['annual.radiation'].std(),1), "| corr with elev:", round(inv['annual.radiation'].corr(inv['elevation']),2))
print("landscape-change trios are proportions summing ~1:",
      inv[['progressive.1993.2009.50m','regressive.1993.2009.50m','no.changes.1993.2009.50m']].sum(axis=1).mean().round(3))

print("\n### TEMPORAL TABLE (context only)")
piv = tt.pivot(index='introduction.period', columns='pathway', values='n')
print(piv.to_string())
print("gardening share:", (piv['Gardening']/piv.sum(axis=1)).round(3).to_dict())
print("chi2:", round(chi2_contingency(piv.values)[0],1), "p=%.1e"%chi2_contingency(piv.values)[1])

print("\n### PHYLOGENETIC TREE")
tips = re.findall(r"[(,]([A-Za-z0-9_.\-\']+):", tree.strip().rstrip(";"))
print("tips:", len(tips), "unique:", len(set(tips)), "| matched to phylo.tip.label:",
      len(set(tips) & set(sp['phylo.tip.label'].dropna())), "of", sp['phylo.tip.label'].nunique())
print("species-level pathway counts:", sp['intro.pathway'].value_counts().to_dict())
print(sp.groupby('intro.pathway')[['invaded.niche.breadth','habitat.range','number.of.invaded.plots','mrt']].median().round(3).to_string())
