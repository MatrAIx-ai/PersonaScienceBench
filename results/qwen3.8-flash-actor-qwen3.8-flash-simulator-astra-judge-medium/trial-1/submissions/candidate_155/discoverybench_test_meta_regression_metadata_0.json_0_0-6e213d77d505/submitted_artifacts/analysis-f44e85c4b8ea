"""Main analysis: original vs replication effect sizes by research domain.

Approved design:
  - domain = discipline (Cognitive 34, Social 34, Economics 18); project.x as parallel grouping
  - primary: |ro| > |rr| ; numeric metric d_fisher = fisr - fiso ; auxiliary relative_es = rr/ro
  - analyzable set = 86 pairs, no exclusions; single sign correction of relative_es logged
  - nr used instead of n.r (se_fisr == 1/sqrt(nr-3) exactly for all 86 rows)
"""
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm

RNG = np.random.default_rng(20261023)
B = 2000
pd.set_option("display.width", 250)
pd.set_option("display.max_columns", 40)

df = pd.read_csv("data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv")
assert df.shape[0] == 86

log_rows = []
df["relative_es_raw"] = df["relative_es"]
df["ratio_rr_ro"] = df.rr / df.ro
bad = (df.relative_es_raw * df.ratio_rr_ro) < 0
fixed = df.loc[bad, ["study", "project.x", "discipline", "ro", "rr",
                     "relative_es_raw", "ratio_rr_ro"]].copy()
fixed["action"] = "relative_es sign corrected to rr/ro"
df["relative_es_c"] = df.ratio_rr_ro
df["relative_es_clip"] = df.relative_es_c.clip(-1, 2)
df["d_fisher"] = df.fisr - df.fiso
df["d_corr"] = df.rr - df.ro
df["shrink"] = (df.ro.abs() > df.rr.abs()).astype(int)
df["sign_flip"] = (df.rr <= 0).astype(int)
df["se_diff"] = np.sqrt(df.se_fiso**2 + df.se_fisr**2)
df["z_diff"] = df.d_fisher / df.se_diff
df["strong_shrink"] = ((df.d_fisher < 0) & (df.z_diff < -1.96)).astype(int)
df["pow80"] = (df["power_planned.r"] >= 0.8).astype(int)
print("### STEP 1 - correction log ###")
print(fixed.to_string(index=False))

def bci(g, fun):
    est = fun(g); n = len(g); vals = np.empty(B)
    for b in range(B):
        vals[b] = fun(g.iloc[RNG.integers(0, n, n)])
    return est, np.percentile(vals, 2.5), np.percentile(vals, 97.5)

def summarise(g, label):
    r = {}
    e, lo, hi = bci(g, lambda x: x.ro.abs().mean()); r["mean_abs_ro"] = round(e, 3); r["mean_abs_ro_CI"] = f"[{lo:.3f}; {hi:.3f}]"
    e, lo, hi = bci(g, lambda x: x.rr.abs().mean()); r["mean_abs_rr"] = round(e, 3); r["mean_abs_rr_CI"] = f"[{lo:.3f}; {hi:.3f}]"
    e, lo, hi = bci(g, lambda x: (x.fisr - x.fiso).median()); r["med_d_fisher"] = round(e, 3); r["med_d_fisher_CI"] = f"[{lo:.3f}; {hi:.3f}]"
    e, lo, hi = bci(g, lambda x: (x.ro.abs() > x.rr.abs()).mean()); r["share_shrink"] = round(e, 3); r["share_shrink_CI"] = f"[{lo:.3f}; {hi:.3f}]"
    e, lo, hi = bci(g, lambda x: (x.rr / x.ro).median()); r["med_relative_es"] = round(e, 3); r["med_relative_es_CI"] = f"[{lo:.3f}; {hi:.3f}]"
    r.update(domain=label, n=len(g),
             med_abs_ro=round(g.ro.abs().median(), 3), med_abs_rr=round(g.rr.abs().median(), 3),
             mean_d_fisher=round(g.d_fisher.mean(), 3), mean_d_corr=round(g.d_corr.mean(), 3),
             med_d_corr=round(g.d_corr.median(), 3), mean_relative_es=round(g.relative_es_c.mean(), 3),
             share_sign_flip=round(g.sign_flip.mean(), 3), share_replicated=round(g.replicated.mean(), 3),
             share_strong_shrink=round(g.strong_shrink.mean(), 3),
             mean_se_fiso=round(g.se_fiso.mean(), 3), mean_se_fisr=round(g.se_fisr.mean(), 3),
             med_no=g["no"].median(), med_nr=g.nr.median(),
             mean_power_planned_r=round(g["power_planned.r"].mean(), 3),
             med_pub_year=g.pub_year.median())
    return r

rows = [summarise(df[df.discipline == l], f"discipline={l}") for l in ["Social", "Cognitive", "Economics"]]
rows.append(summarise(df, "ALL pooled"))
rows += [summarise(df[df["project.x"] == l], f"project.x={l}")
         for l in ["Psychology", "Experimental Economics"]]
main_tbl = pd.DataFrame(rows)
core = ["domain", "n", "mean_abs_ro", "mean_abs_ro_CI", "mean_abs_rr", "mean_abs_rr_CI",
        "med_abs_ro", "med_abs_rr", "mean_d_fisher", "med_d_fisher", "med_d_fisher_CI",
        "share_shrink", "share_shrink_CI", "med_relative_es", "med_relative_es_CI",
        "share_sign_flip", "share_replicated", "share_strong_shrink", "med_pub_year"]
print("\n### STEP 2 - main comparative table (bootstrap B=%d) ###" % B)
print(main_tbl[core].T.to_string())
main_tbl.to_csv("analysis/main_table_by_domain.csv", index=False)

print("\n### STEP 2b - pairwise domain contrasts (bootstrap) ###")
def pair_contrast(a, b, fun, name):
    ga, gb = df[df.discipline == a], df[df.discipline == b]
    obs = fun(ga) - fun(gb); na, nb = len(ga), len(gb)
    d = np.array([fun(ga.iloc[RNG.integers(0, na, na)]) - fun(gb.iloc[RNG.integers(0, nb, nb)])
                  for _ in range(B)])
    p = 2 * min((d <= 0).mean(), (d >= 0).mean())
    return {"contrast": f"{a} - {b}", "metric": name, "diff": round(obs, 3),
            "CI95": f"[{np.percentile(d,2.5):.3f}; {np.percentile(d,97.5):.3f}]",
            "p_boot": round(max(p, 1 / B), 4)}

contrasts = []
for a, b in [("Social", "Cognitive"), ("Social", "Economics"), ("Cognitive", "Economics")]:
    contrasts.append(pair_contrast(a, b, lambda x: (x.fisr - x.fiso).median(), "median d_fisher"))
    contrasts.append(pair_contrast(a, b, lambda x: (x.rr / x.ro).median(), "median relative_es"))
    contrasts.append(pair_contrast(a, b, lambda x: (x.ro.abs() > x.rr.abs()).mean(), "share |ro|>|rr|"))
    contrasts.append(pair_contrast(a, b, lambda x: (x.ro.abs() - x.rr.abs()).mean(), "mean(|ro|-|rr|)"))
ct = pd.DataFrame(contrasts)
print(ct.pivot(index="contrast", columns="metric", values=["diff", "CI95", "p_boot"]).to_string())
ct.to_csv("analysis/pairwise_contrasts.csv", index=False)

print("\n### STEP 2c - statistical tests ###")
for lvl, g in df.groupby("discipline"):
    w1 = stats.wilcoxon(g.d_fisher, alternative="less")
    w2 = stats.wilcoxon(g.relative_es_c - 1, alternative="less")
    print(f"{lvl:10s} Wilcoxon signed-rank d_fisher<0: p={w1.pvalue:.2e} | relative_es<1: p={w2.pvalue:.2e}")
kw = stats.kruskal(*[g.d_fisher.values for _, g in df.groupby("discipline")])
kw2 = stats.kruskal(*[g.relative_es_c.values for _, g in df.groupby("discipline")])
print(f"Kruskal-Wallis across disciplines: d_fisher H={kw.statistic:.2f} p={kw.pvalue:.3f}; "
      f"relative_es H={kw2.statistic:.2f} p={kw2.pvalue:.3f}")
for m in ["relative_es_c", "d_fisher"]:
    for a, b in [("Social", "Cognitive"), ("Social", "Economics"), ("Cognitive", "Economics")]:
        u = stats.mannwhitneyu(df.loc[df.discipline == a, m], df.loc[df.discipline == b, m])
        print(f"  Mann-Whitney {m}: {a} vs {b} U={u.statistic:.1f} p={u.pvalue:.3f}")

print("\n### STEP 2d - project.x level contrast (Psychology vs Experimental Economics) ###")
psy, ee = df[df["project.x"] == "Psychology"], df[df["project.x"] == "Experimental Economics"]
for m_ in ["relative_es_c", "d_fisher"]:
    u = stats.mannwhitneyu(psy[m_], ee[m_])
    print(f"  Mann-Whitney {m_}: Psychology median={psy[m_].median():.3f} vs ExpEcon median={ee[m_].median():.3f} "
          f"U={u.statistic:.1f} p={u.pvalue:.3f}")
obs = (psy.rr / psy.ro).median() - (ee.rr / ee.ro).median()
d = np.array([(psy.iloc[RNG.integers(0, len(psy), len(psy))].rr / psy.iloc[RNG.integers(0, len(psy), len(psy))].ro).median()
              - (ee.iloc[RNG.integers(0, len(ee), len(ee))].rr / ee.iloc[RNG.integers(0, len(ee), len(ee))].ro).median()
              for _ in range(B)])
print(f"  bootstrap diff of median relative_es (Psych - ExpEcon) = {obs:.3f} "
      f"95% CI [{np.percentile(d,2.5):.3f}; {np.percentile(d,97.5):.3f}] p_boot={2*min((d<=0).mean(),(d>=0).mean()):.3f}")
print(f"  share |ro|>|rr|: Psychology {(psy.ro.abs()>psy.rr.abs()).mean():.3f} vs ExpEcon {(ee.ro.abs()>ee.rr.abs()).mean():.3f}; "
      f"share replicated {psy.replicated.mean():.3f} vs {ee.replicated.mean():.3f}")

print("\n### STEP 3 - robustness across scales/definitions ###")
rob = [{"domain": lvl, "n": len(g),
        "share |ro|>|rr|": round((g.ro.abs() > g.rr.abs()).mean(), 3),
        "share rr<ro": round((g.rr < g.ro).mean(), 3),
        "share d_fisher<0": round((g.d_fisher < 0).mean(), 3),
        "share strong shrink (z<-1.96)": round(g.strong_shrink.mean(), 3),
        "share relative_es<1": round((g.relative_es_c < 1).mean(), 3)}
       for lvl, g in df.groupby("discipline")]
print(pd.DataFrame(rob).to_string(index=False))
rank_tbl = pd.DataFrame({
    "mean|ro|-|rr|": df.groupby("discipline").apply(lambda g: (g.ro.abs() - g.rr.abs()).mean(), include_groups=False),
    "median d_fisher": df.groupby("discipline").d_fisher.median(),
    "median relative_es": df.groupby("discipline").relative_es_c.median(),
    "share |ro|>|rr|": df.groupby("discipline").shrink.mean(),
    "share replicated": df.groupby("discipline").replicated.mean()})
print(rank_tbl.round(3).to_string())
kt = stats.kendalltau(rank_tbl["median d_fisher"], rank_tbl["median relative_es"])
print(f"Kendall tau (median d_fisher vs median relative_es across 3 domains): tau={kt.statistic:.2f} p={kt.pvalue:.2f}")

print("\n### STEP 4 - weighted meta-regression (compact) ###")
m = df.copy()
m["Social"] = (m.discipline == "Social").astype(int)
m["Economics"] = (m.discipline == "Economics").astype(int)   # Cognitive = reference
w = 1.0 / m.se_diff**2
specs = {"M1: d_fisher ~ Social + Economics": ["Social", "Economics"],
         "M2: + se_fiso + se_fisr": ["Social", "Economics", "se_fiso", "se_fisr"],
         "M3: + log(no) + log(nr) + power.o": ["Social", "Economics", "se_fiso", "se_fisr", "no", "nr", "power.o"]}
for title, xs in specs.items():
    X = sm.add_constant(m[xs].astype(float))
    if "no" in xs:
        X[["no", "nr"]] = np.log(X[["no", "nr"]])
    res = sm.WLS(m.d_fisher, X, weights=w).fit(cov_type="HC3")
    print(f"\n{title}  (WLS weights=1/SE_diff^2, HC3, n={int(res.nobs)}, R2w={res.rsquared:.3f})")
    print(pd.DataFrame({"coef": res.params.round(4), "se": res.bse.round(4), "p": res.pvalues.round(4),
                        "CI_lo": res.conf_int()[0].round(3), "CI_hi": res.conf_int()[1].round(3)}).to_string())
res_r = sm.WLS(m.relative_es_c, sm.add_constant(m[["Social", "Economics"]].astype(float)),
               weights=w).fit(cov_type="HC3")
print("\nM4: relative_es_c ~ Social + Economics (WLS):")
print(pd.DataFrame({"coef": res_r.params.round(3), "se": res_r.bse.round(3), "p": res_r.pvalues.round(4)}).to_string())

print("\n### STEP 5 - domain vs project / journal / year ###")
print(pd.crosstab(df.journal, df.discipline).to_string())
print(df.groupby("discipline").pub_year.agg(["min", "median", "max", "count"]).to_string())
psych = df[df["project.x"] == "Psychology"]
print("\nWithin-Psychology contrast (removes project & era confound; Social all 2008):")
print(psych.groupby("discipline").agg(n=("study", "size"), mean_abs_ro=("ro", lambda x: x.abs().mean()),
      mean_abs_rr=("rr", lambda x: x.abs().mean()), med_d_fisher=("d_fisher", "median"),
      share_shrink=("shrink", "mean"), med_relative_es=("relative_es_c", "median"),
      med_pub_year=("pub_year", "median")).round(3).to_string())
mw = stats.mannwhitneyu(psych.loc[psych.discipline == "Social", "relative_es_c"],
                        psych.loc[psych.discipline == "Cognitive", "relative_es_c"])
print(f"  Mann-Whitney Social vs Cognitive relative_es within Psychology: U={mw.statistic:.1f} p={mw.pvalue:.3f}")

print("\n### STEP 6 - RTM & power diagnostics ###")
rt = sm.WLS(m.fisr, sm.add_constant(m[["fiso"]]), weights=w).fit(cov_type="HC3")
t_slope = (rt.params["fiso"] - 1) / rt.bse["fiso"]
print("WLS fisr ~ fiso: intercept=%.3f (p=%.3g) slope=%.3f (p=%.3g) R2=%.3f ; slope vs 1: t=%.2f p=%.3g"
      % (rt.params["const"], rt.pvalues["const"], rt.params["fiso"], rt.pvalues["fiso"],
         rt.rsquared, t_slope, 2 * (1 - stats.norm.cdf(abs(t_slope)))))
for lvl, g in df.groupby("discipline"):
    r = sm.WLS(g.fisr, sm.add_constant(g[["fiso"]].astype(float)),
               weights=1 / g.se_diff**2).fit(cov_type="HC3")
    print(f"  {lvl:10s} intercept={r.params['const']:+.3f} slope={r.params['fiso']:.3f} "
          f"(p={r.pvalues['fiso']:.3f}) ; mean|ro|={g.ro.abs().mean():.3f} mean|rr|={g.rr.abs().mean():.3f} "
          f"ratio={g.rr.abs().mean()/g.ro.abs().mean():.3f}")
for c in ["se_fiso", "fiso", "power.o", "po", "no", "nr"]:
    s = stats.spearmanr(df[c], df.d_fisher)
    print(f"  Spearman(d_fisher, {c:8s}) = {s.statistic:+.3f} (p={s.pvalue:.3f})")
print("  originals with po<=.05: %d/%d ; mean d_fisher sig=%.3f vs non-sig=%.3f"
      % (int((df.po <= .05).sum()), len(df), df.loc[df.po <= .05, "d_fisher"].mean(),
         df.loc[df.po > .05, "d_fisher"].mean()))
print("  es_80power mean=%.3f vs mean |rr|=%.3f ; underpowered replications (power_planned.r<0.8): %d"
      % (df.es_80power.mean(), df.rr.abs().mean(), int((df["power_planned.r"] < 0.8).sum())))
adeq = df[df.pow80 == 1]
print("\nSTEP 6b - adequately powered replications only (power_planned.r >= 0.8):")
print(adeq.groupby("discipline").agg(n=("study", "size"), mean_abs_ro=("ro", lambda x: x.abs().mean()),
      mean_abs_rr=("rr", lambda x: x.abs().mean()), med_d_fisher=("d_fisher", "median"),
      share_shrink=("shrink", "mean"), med_relative_es=("relative_es_c", "median")).round(3).to_string())
print("  ranking by med relative_es (lower = stronger inflation):",
      list(adeq.groupby("discipline").relative_es_c.median().sort_values().index))
print("  full-sample ranking by med relative_es:", list(df.groupby("discipline").relative_es_c.median().sort_values().index))
print("  ranking by med d_fisher (more negative = larger drop): full",
      list(df.groupby("discipline").d_fisher.median().sort_values().index),
      "| adequate-power", list(adeq.groupby("discipline").d_fisher.median().sort_values().index))

print("\nSTEP 6c - is the domain difference mechanical (RTM with small original effects)?")
X5 = sm.add_constant(m[["Social", "Economics", "fiso"]].astype(float))
r5 = sm.WLS(m.relative_es_c, X5, weights=w).fit(cov_type="HC3")
print("M5: relative_es_c ~ Social + Economics + fiso (WLS, HC3)")
print(pd.DataFrame({"coef": r5.params.round(3), "se": r5.bse.round(3), "p": r5.pvalues.round(4),
                    "CI_lo": r5.conf_int()[0].round(3), "CI_hi": r5.conf_int()[1].round(3)}).to_string())
X6 = sm.add_constant(m[["Social", "Economics"]].astype(float))
r6 = sm.WLS(m.loc[m.pow80 == 1, "relative_es_c"], X6.loc[m.pow80 == 1],
            weights=w.loc[m.pow80 == 1]).fit(cov_type="HC3")
print("M6: same model on adequately powered replications only (power_planned.r >= 0.8, n=%d)" % int(m.pow80.sum()))
print(pd.DataFrame({"coef": r6.params.round(3), "se": r6.bse.round(3), "p": r6.pvalues.round(4)}).to_string())
def pair_sub(a, b, sub, fun, name):
    ga, gb = sub[sub.discipline == a], sub[sub.discipline == b]
    obs = fun(ga) - fun(gb); na, nb = len(ga), len(gb)
    d = np.array([fun(ga.iloc[RNG.integers(0, na, na)]) - fun(gb.iloc[RNG.integers(0, nb, nb)]) for _ in range(B)])
    return {"subset": name, "contrast": f"{a}-{b}", "diff": round(obs, 3),
            "CI95": f"[{np.percentile(d,2.5):.3f}; {np.percentile(d,97.5):.3f}]",
            "p_boot": round(2 * min((d <= 0).mean(), (d >= 0).mean()), 4)}
subs = [pair_sub("Social", "Cognitive", adeq, lambda x: (x.rr / x.ro).median(), "med relative_es | power>=0.8"),
        pair_sub("Social", "Cognitive", adeq, lambda x: (x.fisr - x.fiso).median(), "med d_fisher | power>=0.8"),
        pair_sub("Cognitive", "Economics", adeq, lambda x: (x.rr / x.ro).median(), "med relative_es | power>=0.8")]
print(pd.DataFrame(subs).to_string(index=False))
tab = df.assign(abs_ro=df.ro.abs(), abs_rr=df.rr.abs(), samesign=df.rr > 0,
                logratio=np.log(df.rr.abs() / df.ro.abs()))
agg = tab.groupby("discipline").agg(n=("study", "size"), mean_abs_ro=("abs_ro", "mean"),
        mean_abs_rr=("abs_rr", "mean"), ratio_of_means=("abs_rr", "mean"),
        n_same_sign=("samesign", "sum"))
agg["ratio_of_means"] = (agg.mean_abs_rr / agg.mean_abs_ro).round(3)
agg["geomean_ratio_same_sign"] = tab[tab.samesign].groupby("discipline").logratio.mean().map(np.exp).round(3)
print("Baseline level vs retention (is the domain difference just 'small original ES'?):")
print(agg.round(3).to_string())
print("\nSame-sign-only subsample (rr > 0): relative retention of the original effect")
print(tab[tab.samesign].groupby("discipline").apply(
    lambda g: pd.Series({"n": len(g), "median rr/ro": (g.rr / g.ro).median(),
                         "mean|rr|/mean|ro|": g.abs_rr.mean() / g.abs_ro.mean(),
                         "median |ro|": g.abs_ro.median()}), include_groups=False).round(3).to_string())
print("\n### STEP 7 - sensitivity to the corrected/removed Eitam row ###")
print(df.loc[bad, ["study", "ro", "rr", "relative_es_raw", "relative_es_c"]].to_string(index=False))
noeitam = df[~bad]
t1 = df.groupby("discipline").agg(med_rel=("relative_es_c", "median"), med_dfish=("d_fisher", "median"),
                                  share=("shrink", "mean")).round(3)
t2 = noeitam.groupby("discipline").agg(med_rel_noEitam=("relative_es_c", "median"),
                                       med_dfish_noEitam=("d_fisher", "median"),
                                       share_noEitam=("shrink", "mean")).round(3)
t3 = df.groupby("discipline").agg(med_rel_file=("relative_es_raw", "median"),
                                  med_rel_clip=("relative_es_clip", "median")).round(3)
print(pd.concat([t1, t2, t3], axis=1).to_string())
df.to_csv("analysis/analysis_dataset.csv", index=False)
print("\nSaved: main_table_by_domain.csv, pairwise_contrasts.csv, analysis_dataset.csv")
