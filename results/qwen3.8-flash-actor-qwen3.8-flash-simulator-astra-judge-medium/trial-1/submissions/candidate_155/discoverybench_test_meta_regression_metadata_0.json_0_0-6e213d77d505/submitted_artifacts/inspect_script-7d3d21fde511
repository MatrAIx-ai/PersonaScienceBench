"""Read-only inspection of the joined meta-regression data (plan-stage evidence).

No modeling, no final inference. Only counts, missingness, duplicates,
domain level tables, and preliminary original-vs-replication descriptives.
"""
import numpy as np
import pandas as pd

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)

PATH = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(PATH)

print("=== 1. SHAPE / DUPLICATES ===")
print("rows, cols:", df.shape)
print("fully duplicated rows:", df.duplicated().sum())
print("duplicated 'study' values:", df["study"].duplicated().sum())
print("unique study values:", df["study"].nunique())
key_pair = df.duplicated(subset=["study", "project.x", "project.y"], keep=False)
print("rows in duplicated (study,project.x,project.y) groups:", int(key_pair.sum()))
if key_pair.any():
    print(df.loc[key_pair, ["study", "project.x", "project.y", "ro", "rr"]].sort_values("study"))
print("\n'aggregated' value counts (incl NaN):")
print(df["aggregated"].value_counts(dropna=False))
print("rows with non-null aggregated:", int(df["aggregated"].notna().sum()))
counts = df["study"].value_counts()
print("\nstudies appearing >1 time:")
print(counts[counts > 1])

print("\n=== 2. MISSINGNESS KEY FIELDS ===")
keys = ["ro", "rr", "fiso", "fisr", "se_fiso", "se_fisr", "relative_es",
        "replicated", "project.x", "project.y", "discipline", "pub_year",
        "no", "nr", "power.o", "power.r", "journal", "authors.o"]
miss = pd.DataFrame({"n_missing": df[keys].isna().sum(),
                     "pct_missing": (df[keys].isna().mean() * 100).round(1)})
print(miss)

print("\n=== 3. DOMAIN CANDIDATES ===")
for c in ["project.x", "project.y", "discipline"]:
    print("---", c, "---")
    print(df[c].value_counts(dropna=False))
print("--- crosstab project.x x discipline ---")
print(pd.crosstab(df["project.x"], df["discipline"], dropna=False))
print("--- crosstab project.y x discipline ---")
print(pd.crosstab(df["project.y"], df["discipline"], dropna=False))
print("--- project.x vs project.y ---")
print(pd.crosstab(df["project.x"], df["project.y"], dropna=False))
print("--- journal x project.x ---")
print(pd.crosstab(df["journal"], df["project.x"], dropna=False))
print("--- pub_year by project.x ---")
print(df.groupby("project.x")["pub_year"].describe())
print("--- pub_year by discipline ---")
print(df.groupby("discipline")["pub_year"].describe())

print("\n=== 4. PRELIMINARY ORIGINAL vs REPLICATION ===")
sub = df.dropna(subset=["ro", "rr"]).copy()
print("complete ro&rr pairs:", len(sub), "of", len(df))
sub["d_fisher"] = sub["fisr"] - sub["fiso"]
sub["d_corr"] = sub["rr"] - sub["ro"]
sub["shrink"] = sub["ro"].abs() - sub["rr"].abs()
for name, g in sub.groupby("project.x"):
    print(f"\n[project.x = {name}] n={len(g)}")
    print("  mean|ro|=", round(g["ro"].abs().mean(), 3), " mean|rr|=", round(g["rr"].abs().mean(), 3))
    print("  med|ro|=", round(g["ro"].abs().median(), 3), " med|rr|=", round(g["rr"].abs().median(), 3))
    print("  mean(rr-ro)=", round(g["d_corr"].mean(), 3), " med(rr-ro)=", round(g["d_corr"].median(), 3))
    print("  med(fisr-fiso)=", round(g["d_fisher"].median(), 3))
    print("  share |ro|>|rr| =", round((g["shrink"] > 0).mean(), 3))
    print("  median relative_es =", round(g["relative_es"].median(), 3))
for name, g in sub.groupby("discipline"):
    print(f"\n[discipline = {name}] n={len(g)}")
    print("  mean|ro|=", round(g["ro"].abs().mean(), 3), " mean|rr|=", round(g["rr"].abs().mean(), 3))
    print("  share |ro|>|rr| =", round((g["shrink"] > 0).mean(), 3))
    print("  med(rr-ro)=", round(g["d_corr"].median(), 3),
          " median relative_es =", round(g["relative_es"].median(), 3))

print("\nrelative_es describe:")
print(df["relative_es"].describe())
print("\n|ro| < 0.05 rows:", int((df["ro"].abs() < 0.05).sum()))
print("sign disagreement ro vs rr:",
      int(((np.sign(df["ro"]) != np.sign(df["rr"])) & df["ro"].notna() & df["rr"].notna()).sum()))
print("\nreplicated rate by project.x:")
print(df.groupby("project.x")["replicated"].mean())
print("\nmeans of power/n by project.x:")
print(df.groupby("project.x")[["power.o", "power_planned.r", "no", "nr"]].mean())
print("\nreplicated rate by discipline:")
print(df.groupby("discipline")["replicated"].mean())
