"""Stage 1 (INSPECTION ONLY): structural audit of the two supplied CSVs.

Reports: shapes, columns, key structure, join feasibility, and the observed
distribution/missingness of the seniority, drop, aggregated and replicated fields.
No final proportion is produced here (that is the stage-2 analysis, pending approval).
"""
import re
import pandas as pd

P1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
P2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(P1)
rs = pd.read_csv(P2)

print("FILE 1 shape:", df.shape)
print("FILE 2 shape:", rs.shape)
print("FILE 1 cols:", list(df.columns))
print("FILE 2 cols:", list(rs.columns))

print("\n-- project label counts --")
print("file1:", df["project"].value_counts().to_dict())
print("file2:", rs["project"].value_counts().to_dict())
print("file1 discipline:", df["discipline"].value_counts().to_dict())

print("\n-- row granularity (rows vs unique ids) --")
print(df.groupby("project")["id"].agg(["size", "nunique"]))
print("duplicate (id,lab_id) pairs:", int(df.duplicated(["id", "lab_id"]).sum()))
print("lab_id missing by project:\n", df.groupby("project")["lab_id"].apply(lambda s: int(s.isna().sum())))

print("\n-- key/markers --")
for c in ["seniority.o", "seniority.r", "drop", "aggregated", "replicated"]:
    print(f"\n{c}: missing={int(df[c].isna().sum())}")
    print(df[c].value_counts(dropna=False).to_dict())
print("drop x aggregated x project:\n",
      pd.crosstab([df["project"], df["drop"]], df["aggregated"].fillna("NA")))
print("replicated missing by project:\n",
      df.groupby("project")["replicated"].apply(lambda s: int(s.isna().sum())))

print("\n-- seniority by project --")
print(pd.crosstab(df["project"], df["seniority.o"], margins=True))
print(pd.crosstab(df["project"], df["seniority.r"], margins=True))

print("\n-- author volume / citation context (rpp) --")
rpp = df[df.project == "rpp"]
print(rpp[["n_authors.o", "n_authors.r", "author_citations_avg.o",
           "author_citations_avg.r"]].describe().round(1))

print("\n-- join feasibility: file2 study string -> file1 authors.o (first-author surname) --")
norm = lambda s: re.sub(r"[^a-z]", "", str(s).lower())
df["sur1"] = df["authors.o"].map(lambda a: norm(a.split(" and ")[0].split()[-1]))
# study strings use two different styles: "AB Surname, CD Surname" (RPP) and
# "Surname et al. (Journal YEAR)" (economics), so try both first- and last-token surnames.
def cand(s):
    chunk = s.split(",")[0].strip()
    toks = chunk.split()
    return {norm(toks[0]), norm(toks[-1])}
rs["sur_a"] = rs["study"].map(lambda s: sorted(cand(s))[0])
rs["sur_b"] = rs["study"].map(lambda s: sorted(cand(s))[-1])
df2 = df[["id", "project", "sur1"]]
for p in rs["project"].unique():
    sub = rs[rs.project == p]
    m = pd.concat([sub.merge(df2, left_on="sur_a", right_on="sur1", how="inner", suffixes=("_f2", "_f1")),
                   sub.merge(df2, left_on="sur_b", right_on="sur1", how="inner", suffixes=("_f2", "_f1"))]).drop_duplicates(["study", "id"])
    print(f"{p:24s} file2_rows={len(sub):3d} matched_pairs={len(m):3d} "
          f"uniq_file2={m.study.nunique():3d} uniq_file1_ids={m.id.nunique():3d} "
          f"matched_file1_projects={sorted(m['project_f1'].unique())}")
