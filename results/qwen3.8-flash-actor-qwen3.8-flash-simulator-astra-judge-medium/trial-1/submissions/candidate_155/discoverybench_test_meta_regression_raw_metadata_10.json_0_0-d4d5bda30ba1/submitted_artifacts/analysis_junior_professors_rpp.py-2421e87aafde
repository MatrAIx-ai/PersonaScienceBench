def cp(k, n, a=0.05):
    """Clopper-Pearson (exact) interval, for comparison with the Wilson interval."""
    from scipy import stats
    if n == 0:
        return (float("nan"), float("nan"))
    lo = 0.0 if k == 0 else float(stats.beta.ppf(a / 2, k, n - k + 1))
    hi = 1.0 if k == n else float(stats.beta.ppf(1 - a / 2, k + 1, n - k))
    return (lo, hi)

print("\n" + "=" * 96)
print("STEP 9  SAMPLING UNCERTAINTY (two interval methods) + exported tables")
print("=" * 96)
for lab, kk, nn in [("headline junior-led share", k, n),
