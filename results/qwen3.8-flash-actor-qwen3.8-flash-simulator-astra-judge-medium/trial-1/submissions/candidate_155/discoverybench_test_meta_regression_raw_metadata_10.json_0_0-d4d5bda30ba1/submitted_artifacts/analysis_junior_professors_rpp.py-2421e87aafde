                    ("sensitivity: + Associate Professor", int(USE['seniority.r'].isin(JUNIOR['Assistant + AsstProf + AssocProf']).sum()), n)]:
    wl, wh = wilson(kk, nn)
    cl, ch = cp(kk, nn)
    print(f"  {lab:34s} {kk:3d}/{nn:<3d} = {pct(kk,nn):5.1f}%   Wilson [{100*wl:4.1f},{100*wh:4.1f}]   "
          f"Clopper-Pearson [{100*cl:4.1f},{100*ch:4.1f}]")
