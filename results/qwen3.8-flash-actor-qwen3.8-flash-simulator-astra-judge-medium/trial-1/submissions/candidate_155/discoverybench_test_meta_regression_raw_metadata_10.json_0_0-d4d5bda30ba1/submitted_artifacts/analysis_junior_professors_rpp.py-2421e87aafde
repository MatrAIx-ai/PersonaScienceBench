def cands(s):
    t = s.split(",")[0].strip().split()
    return {x for x in (norm(t[0]), norm(t[-1])) if x}


hit = {}
for _, r in Bp.iterrows():
    c = Aa[Aa["sur1"].isin(cands(r["study"]))]
    if len(c) == 1:
        hit.setdefault(r["study"], set()).add(c.iloc[0]["id"])
clean = {s: list(v)[0] for s, v in hit.items() if len(v) == 1}
amb = sorted({s for s, v in hit.items() if len(v) > 1})
print(f"  File B 'Psychology' rows: {len(Bp)} (unique study strings {Bp.study.nunique()})")
print(f"  unambiguous 1:1 matches: {len(clean)} rpp ids | ambiguous study strings dropped: "
      f"{len(amb)} {amb}")
