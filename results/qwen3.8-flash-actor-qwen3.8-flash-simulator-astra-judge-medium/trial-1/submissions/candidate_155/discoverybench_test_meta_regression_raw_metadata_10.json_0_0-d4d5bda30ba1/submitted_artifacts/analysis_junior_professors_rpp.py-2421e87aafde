"""Main analysis (authorised plan).

Question: What is the proportion of junior professors in replicated studies in Psychology?

Authorised decisions
  (i)   junior professor = {Assistant Professor, Assistant}; sensitivities: Assistant only,
        and Assistant + Assistant Professor + Associate Professor
  (ii)  primary column = seniority.r (most senior author of the REPLICATION team);
        seniority.o reported for contrast
  (iii) headline denominator = usable rpp replication attempts (drop != True);
        parallel = replicated == 1 subset; robustness = all 97 rpp rows
File A alone carries the estimate; File B is only a light cross-check, dropped rather than
forced if the heuristic join is ambiguous.
"""
import re, math
import numpy as np
import pandas as pd

PA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
PB = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"
