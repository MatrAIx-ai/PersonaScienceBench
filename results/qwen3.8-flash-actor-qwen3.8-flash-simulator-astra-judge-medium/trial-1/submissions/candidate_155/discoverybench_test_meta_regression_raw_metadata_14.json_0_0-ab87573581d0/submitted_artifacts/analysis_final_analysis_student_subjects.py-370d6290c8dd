"""FINAL analysis (approved protocol).

Question: In which domain did both original and replication studies primarily use
student subjects (original: 82.4%, replication: 80.9%)?

Approved unit-of-analysis protocol (fixed, not to be widened):
  * grouping variable = `discipline` (target group = `Social`); `project` kept ONLY as
    a contrast table showing it cannot reproduce both numbers.
  * analysis unit = unique ORIGINAL STUDY, deduplicated by `title`
    (subjects.o never conflicts within a title -> unique value is safe).
  * subjects.r uses the ANY rule: a study counts as "student replication" if ANY lab
    row under the same title is coded 'students' (13 titles have conflicting .r values).
    This convention was chosen because it reproduces the checked figures
    (82.4% / 80.9%); first-row, all-rows and per-data-row variants are reported as
    sensitivity contrasts.
  * NO rows are dropped: drop==True and aggregated==True rows are retained; the single
    row with missing subjects (rpp.154) stays in the denominator and counts as NOT students.
Outputs:
  analysis/final_report.md, analysis/main_discipline_table.csv,
  analysis/sensitivity_grid.csv, analysis/social_nonstudent_studies.csv,
  analysis/project_contrast_table.csv
"""
import pandas as pd

MAIN = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
TARGET_O, TARGET_R = 82.4, 80.9
STUDENT = 'students'

# NOTE: the file encodes missing subject types as the literal string 'n/a'
df = pd.read_csv(MAIN, keep_default_na=False, na_values=['', 'n/a', 'NA'])
df['drop_str'] = df['drop'].astype(str)
lines, w = [], None
lines = []
w = lines.append

w('# Student-subject concentration across domains — final report\n')
w('## 0. Data provenance and unit of analysis')
w(f'- File: `{MAIN}` — {df.shape[0]} rows x {df.shape[1]} columns, '
  f'{df.id.nunique()} unique O/R ids, {df.title.nunique()} unique original-study titles.')
w('- Many Labs entries repeat one original study across labs (`lab_id`); therefore the '
  'analysis unit is the **unique original study (title)**, not the data row.')
w('- Approved rules: discipline grouping; title dedup; `subjects.o` = unique value within title '
  '(verified 0 conflicts); `subjects.r` = ANY rule (13 titles have conflicting `subjects.r`); '
  'no exclusion of `drop`/`aggregated`; missing subjects (rpp.154) kept in denominator as non-students.')

# ---- integrity checks -------------------------------------------------------
chk_o = df.groupby('title')['subjects.o'].nunique(dropna=True)
chk_r = df.groupby('title')['subjects.r'].nunique(dropna=True)
w(f'- Integrity check: titles with >1 distinct `subjects.o` = {(chk_o > 1).sum()}; '
  f'titles with >1 distinct `subjects.r` = {(chk_r > 1).sum()} (these need the ANY rule).')
miss = df[df['subjects.o'].isna() | df['subjects.r'].isna()]
w(f'- Rows with missing subjects type (literal `n/a` in the file): {len(miss)} -> '
  + '; '.join(f"{r.id} ({r.project}, discipline={r.discipline}, drop={r.drop_str})" for r in miss.itertuples())
  + ' -> kept in the denominator and counted as NOT students.')

# ---- study-level builder ----------------------------------------------------
def study_level(frame):
    rows = []
    for k, g in frame.groupby('title'):
        o = g['subjects.o'].dropna().unique()
        rows.append(dict(
            title=k,
            project='/'.join(sorted(g['project'].unique())),
            discipline=g['discipline'].iloc[0],
            n_lab_rows=len(g),
            subjects_o=o[0] if len(o) else 'MISSING',
            r_any_students=int((g['subjects.r'] == STUDENT).any()),
            r_first_students=int(g['subjects.r'].iloc[0] == STUDENT),
            r_all_students=int(len(g['subjects.r'].dropna()) > 0 and
                               (g['subjects.r'].dropna() == STUDENT).all()),
            drop_any=bool((g['drop'] == True).any()),
        ))
    return pd.DataFrame(rows)

st = study_level(df)
assert st.groupby('title')['subjects_o'].nunique().max() == 1

def pct(sel, col):
    return 100 * sel[col].mean() if len(sel) else float('nan')

# ---- MAIN table: discipline grouping, ANY rule ------------------------------
main_rows = []
for k, s in st.groupby('discipline'):
    o_c = int((s['subjects_o'] == STUDENT).sum()); r_c = int(s['r_any_students'].sum())
    main_rows.append(dict(discipline=k, n_studies=len(s),
                          orig_students_n=o_c, orig_students_pct=round(100*o_c/len(s), 1),
                          repl_students_n=r_c, repl_students_pct=round(100*r_c/len(s), 1),
                          abs_dist_to_targets=round(abs(100*o_c/len(s)-TARGET_O)+abs(100*r_c/len(s)-TARGET_R), 2)))
main = pd.DataFrame(main_rows).sort_values('abs_dist_to_targets')
main.to_csv('analysis/main_discipline_table.csv', index=False)
w('\n## 1. MAIN table — unique original studies, `subjects.r` ANY rule (approved protocol)')
w(main.to_string(index=False))
for r_ in main.itertuples():
    w(f'  * {r_.discipline}: original {r_.orig_students_n}/{r_.n_studies} = '
      f'{100*r_.orig_students_n/r_.n_studies:.2f}% ; replication {r_.repl_students_n}/{r_.n_studies} = '
      f'{100*r_.repl_students_n/r_.n_studies:.2f}%')

# ---- project contrast -------------------------------------------------------
prows = []
for k, s in st.groupby('project'):
    o_c = int((s['subjects_o'] == STUDENT).sum()); r_c = int(s['r_any_students'].sum())
    prows.append(dict(project=k, n_studies=len(s),
                      orig_students_n=o_c, orig_students_pct=round(100*o_c/len(s), 1),
                      repl_students_n=r_c, repl_students_pct=round(100*r_c/len(s), 1),
                      abs_dist_to_targets=round(abs(100*o_c/len(s)-TARGET_O)+abs(100*r_c/len(s)-TARGET_R), 2)))
proj = pd.DataFrame(prows).sort_values('abs_dist_to_targets')
proj.to_csv('analysis/project_contrast_table.csv', index=False)
w('\n## 2. CONTRAST — `project` grouping (kept only to show it cannot match both numbers)')
w(proj.to_string(index=False))

# ---- sensitivity grid -------------------------------------------------------
srows = []
for gvar, gcol in [('discipline', 'discipline'), ('project', 'project')]:
    for k, s in st.groupby(gcol):
        rows = df[df[gcol] == k]
        variants = {
            'study_any_rule (APPROVED)': (100*(s['subjects_o'] == STUDENT).mean(), 100*s['r_any_students'].mean()),
            'study_first_row': (100*(s['subjects_o'] == STUDENT).mean(), 100*s['r_first_students'].mean()),
            'study_all_rows_must_be_students': (100*(s['subjects_o'] == STUDENT).mean(), 100*s['r_all_students'].mean()),
            'per_data_row (no dedup)': (100*(rows['subjects.o'] == STUDENT).mean(), 100*(rows['subjects.r'] == STUDENT).mean()),
        }
        for v, (o, r) in variants.items():
            srows.append(dict(group_var=gvar, group=k, unit=v, n=len(rows) if 'row' in v and 'study' not in v else len(s),
                              orig_pct=round(o, 1), repl_pct=round(r, 1),
                              abs_dist_to_targets=round(abs(o-TARGET_O)+abs(r-TARGET_R), 2)))
sens = pd.DataFrame(srows).sort_values('abs_dist_to_targets')
sens.to_csv('analysis/sensitivity_grid.csv', index=False)
w('\n## 3. SENSITIVITY — four unit-of-analysis conventions x both grouping variables')
w(sens.to_string(index=False))
b = sens.iloc[0]
w(f'\n- Best cell: {b.group_var}={b.group} under `{b.unit}` -> {b.orig_pct}% / {b.repl_pct}% '
  f'(distance {b.abs_dist_to_targets} pts, i.e. only rounding of 82.35%/80.88%). '
  'The second-best cell is 1.4 pts away and no `project` group comes within 6 pts.')

# ---- Social non-student studies --------------------------------------------
soc = st[st['discipline'] == 'Social']
n_o = int((soc['subjects_o'] == STUDENT).sum()); n_r = int(soc['r_any_students'].sum())
non = soc[soc['subjects_o'] != STUDENT].sort_values(['project', 'title'])
non_out = non[['title', 'project', 'n_lab_rows', 'subjects_o', 'r_any_students', 'r_first_students', 'drop_any']]
non_out.to_csv('analysis/social_nonstudent_studies.csv', index=False)
w('\n## 4. Social discipline counts')
w('- Integrity: 68 (Social) + 49 (Cognitive) + 18 (Economics) = 135 = total unique titles, '
  'so no title is counted in two disciplines (clean partition).')
w('- Social studies by underlying project: '
  + str(st[st.discipline == 'Social'].groupby('project').size().to_dict()))
w(f'- Unique original studies in `discipline=="Social"`: **{len(soc)}** '
  f'(data rows: {len(df[df.discipline=="Social"])})')
w(f'- Original used students: **{n_o}/{len(soc)} = {100*n_o/len(soc):.2f}%**  (target 82.4%)')
w(f'- Replication used students (ANY rule): **{n_r}/{len(soc)} = {100*n_r/len(soc):.2f}%**  (target 80.9%)')
w(f'\n### The {len(non)} non-student ORIGINAL studies in Social (what they actually are)')
w('```' + '\n' + non_out.to_string(index=False) + '\n```')
w('- Composition of those ' + str(len(non)) + ' by `subjects.o`: '
  + str(non['subjects_o'].value_counts().to_dict()))
w('- Composition by `project`: ' + str(non['project'].value_counts().to_dict()))
w('- Their own replication coding (ANY rule): '
  + str(non['r_any_students'].map({1: 'students', 0: 'not students'}).value_counts().to_dict()))
nonr = soc[soc['r_any_students'] == 0]
w(f'- Social studies whose replication did NOT use students (ANY rule): {len(nonr)}/{len(soc)} = '
  f'{100*len(nonr)/len(soc):.2f}% non-student; original coding of those: '
  + str(nonr['subjects_o'].value_counts().to_dict()))
# studies where ANY vs FIRST differ
diff = soc[soc['r_any_students'] != soc['r_first_students']]
w('- Titles where the ANY rule and the first-row rule disagree (multi-lab heterogeneity): '
  + str(list(diff.title)))

# ---- other disciplines narrative -------------------------------------------
w('\n## 5. Why the other two disciplines cannot be the answer (study-level, ANY rule)')
for k in ['Cognitive', 'Economics']:
    s = st[st['discipline'] == k]
    o, r = 100*(s['subjects_o'] == STUDENT).mean(), 100*s['r_any_students'].mean()
    oc, rc = int((s['subjects_o'] == STUDENT).sum()), int(s['r_any_students'].sum())
    w(f'- {k}: original {oc}/{len(s)} = {o:.1f}% (vs 82.4, off {abs(o-TARGET_O):.1f}), '
      f'replication {rc}/{len(s)} = {r:.1f}% (vs 80.9, off {abs(r-TARGET_R):.1f}) '
      f'-> total distance {abs(o-TARGET_O)+abs(r-TARGET_R):.1f} pts')

# ---- auxiliary file ---------------------------------------------------------
d2 = pd.read_csv('data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv',
                 keep_default_na=False, na_values=['', 'NA'])
w('\n## 6. Second file — order-of-magnitude corroboration only (no subject columns)')
w(f'- shape {d2.shape}; subject-type columns present: '
  f'{[c for c in d2.columns if "subj" in c.lower()]} -> cannot be used for this question.')
w(f'- projects: {d2.project.value_counts().to_dict()}; studies = {len(d2)} '
  f'(vs {df.title.nunique()} unique titles / {df.id.nunique()} ids in the main file) — comparable scale.')
w(f'- missing: { {k: int(v) for k, v in d2.isna().sum().items() if v} }; '
  f'duplicated study labels: {int(d2.study.duplicated().sum())}.')

answer = ('Answer: the SOCIAL domain — social psychology (social/personality-psychology '
          'samples, including the Many Labs social/personality studies), i.e. the set of '
          f'projects whose data field `discipline` == "Social" (ml1/ml3/rpp rows coded Social; '
          f'{len(soc)} unique original studies, {len(df[df.discipline=="Social"])} data rows). '
          f'{n_o}/{len(soc)} = {100*n_o/len(soc):.1f}% of its original studies and '
          f'{n_r}/{len(soc)} = {100*n_r/len(soc):.1f}% of its replications used student subjects.')
w('\n## 7. Final natural-language answer\n' + answer)

report = '\n'.join(lines) + '\n'
open('analysis/final_report.md', 'w').write(report)
print(report)
