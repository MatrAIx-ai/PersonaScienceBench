"""Stage-1 inspection: structure, key-column distributions, and grouping grid
for the two meta-regression replication datasets.
Outputs: analysis/inspection_report.md, analysis/group_grid.csv
"""
import pandas as pd

MAIN = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
ALT = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'
KEYS = ['discipline', 'project', 'subjects.o', 'subjects.r', 'same_subjects', 'aggregated', 'drop']

df = pd.read_csv(MAIN)
d2 = pd.read_csv(ALT)
lines = []
w = lines.append

w('# Data inspection report\n')
w(f'## File 1 (study-level O/R data): shape = {df.shape}')
w(f'- unique O/R ids: {df.id.nunique()}  |  unique titles: {df.title.nunique()}  '
  f'(many-labs rows share an id/title via lab_id)')
w(f'## File 2 (effect-size data): shape = {d2.shape}, duplicated study names = {int(d2.study.duplicated().sum())}')
w(f'- File 2 projects: {d2.project.value_counts().to_dict()}')
w(f'- File 2 has NO subject-type columns; missing counts: '
  f'{ {k:int(v) for k,v in d2.isna().sum().items() if v} }')

w('\n## Key column distributions (file 1, n rows)')
for c in KEYS:
    vc = df[c].value_counts(dropna=False)
    w(f'### {c}  (missing={int(df[c].isna().sum())})')
    w('```' + '\n' + vc.to_string() + '\n```')

w('\n## Cross-cut: project x discipline\n```' + '\n' +
  pd.crosstab(df.project, df.discipline).to_string() + '\n```')

# students share under several unit-of-analysis conventions
rows = []
for gvar in ['discipline', 'project']:
    for k, grp in df.groupby(gvar):
        st = grp.groupby('title').agg(
            o_any=('subjects.o', lambda x: int((x == 'students').any())),
            o_first=('subjects.o', lambda x: int(x.iloc[0] == 'students')),
            r_any=('subjects.r', lambda x: int((x == 'students').any())),
            r_first=('subjects.r', lambda x: int(x.iloc[0] == 'students')))
        keep = grp[grp['drop'] == False]
        rows.append(dict(group_var=gvar, group=k, n_rows=len(grp), n_studies=len(st),
                         row_o=round(100*(grp['subjects.o'] == 'students').mean(), 1),
                         row_r=round(100*(grp['subjects.r'] == 'students').mean(), 1),
                         study_o_any=round(100*st.o_any.mean(), 1), study_r_any=round(100*st.r_any.mean(), 1),
                         study_o_first=round(100*st.o_first.mean(), 1), study_r_first=round(100*st.r_first.mean(), 1),
                         keepdrop_o=round(100*(keep['subjects.o'] == 'students').mean(), 1),
                         keepdrop_r=round(100*(keep['subjects.r'] == 'students').mean(), 1)))
grid = pd.DataFrame(rows)
grid.to_csv('analysis/group_grid.csv', index=False)
w('\n## Students % by candidate grouping (targets: original 82.4, replication 80.9)')
w('unit: `row_*` = every O/R-lab row; `study_*_any` = unique original study (title), students if any lab row; '
  '`study_*_first` = first row per title; `keepdrop_*` = rows with drop==False\n')
w(grid.to_string(index=False))
w('\n### Distance to targets (study-level, any-lab rule)')
grid['dist'] = (grid.study_o_any - 82.4).abs() + (grid.study_r_any - 80.9).abs()
w(grid.sort_values('dist').head(7).to_string(index=False))

rep = '\n'.join(lines) + '\n'
open('analysis/inspection_report.md', 'w').write(rep)
print(rep)
