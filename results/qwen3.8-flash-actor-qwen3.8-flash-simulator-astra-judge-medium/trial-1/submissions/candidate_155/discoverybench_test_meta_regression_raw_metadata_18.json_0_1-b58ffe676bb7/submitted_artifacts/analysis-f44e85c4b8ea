#!/usr/bin/env python3
"""
analysis_lab_proportion.py
Question: What proportion of studies in Experimental Economics were conducted in a lab setting?

Fixed method (approved by researcher):
  * Counting unit = unique `id` (O/R pair == replicated original study); ee denominator = 18.
    "original-study dedup" (title+authors.o) and "replication rows" counts reported alongside.
  * Headline  H  : lab := (online.o == 0)   [original side; PROXY, not a data-dictionary field]
  * Sensitivity S1 : (online.o == 0) & (online.r == 0)
  * Sensitivity S2 : (online.o == 0) & subjects.o in {students,community} & compensation.o in {cash,credit}
  * Descriptive replication side: share with online.r == 0
  * us_lab.* and lab_id NOT used as lab evidence (us_lab.* verified = "United States" location flag;
    lab_id 100% missing in ee).
  * Cross-project comparison: file-1 project labels only (ml1/ml3/rpp/ee), with and without drop==True ids.
  * File 2 used only to cross-validate ee coverage (18/18 heuristic match), never for lab classification.
Offline: python3 analysis_lab_proportion.py   (pandas / numpy / scipy)
Outputs: summary_ee_lab.csv, summary_by_project.csv, coverage_fields.csv, ee_study_detail.csv,
         join_validation_file2.csv, missing_or_contradictory.csv
"""
import math, re
import numpy as np
import pandas as pd
from scipy.stats import beta, binomtest

F1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
F2 = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'
Z = 1.959963984540054

def wilson(x, n):
    if n == 0: return (np.nan, np.nan)
    p = x / n; d = 1 + Z**2 / n
    c = (p + Z**2 / (2*n)) / d
    h = Z * math.sqrt(p*(1-p)/n + Z**2/(4*n**2)) / d
    return (max(0.0, c-h), min(1.0, c+h))

def clopper_pearson(x, n, a=0.05):
    lo = 0.0 if x == 0 else float(beta.ppf(a/2, x, n-x+1))
    hi = 1.0 if x == n else float(beta.ppf(1-a/2, x+1, n-x))
    return (lo, hi)

def exact_p_ge(x, n, p0=0.5):
    return float(binomtest(x, n, p0, alternative='greater').pvalue) if n else np.nan

def share_table(sub, label, unit):
    ids = sub.drop_duplicates('id').copy()
    titles = sub.drop_duplicates(['title', 'authors.o'])
    n_ids, n_titles, n_rows = len(ids), len(titles), len(sub)
    defs = {}
    # validity masks: NaN must NOT be silently counted as "not lab"; it is excluded from the denominator
    vo, vr = ids['online.o'].notna(), ids['online.r'].notna()
    vs, vc = ids['subjects.o'].notna(), ids['compensation.o'].notna()
    sets = [
        ('H_original_online_o_eq_0', ids['online.o'].eq(0), vo),
        ('S1_both_online_o_eq_0_and_online_r_eq_0', ids['online.o'].eq(0) & ids['online.r'].eq(0), vo & vr),
        ('S2_triple_evidence', ids['online.o'].eq(0) & ids['subjects.o'].isin(['students','community'])
                               & ids['compensation.o'].isin(['cash','credit']), vo & vs & vc),
        ('DESC_replication_side_online_r_eq_0', ids['online.r'].eq(0), vr),
    ]
    for name, m, valid in sets:
        x = int((m & valid).sum()); d = int(valid.sum())
        w = wilson(x, d); cp = clopper_pearson(x, d)
        defs[name] = dict(definition=name, numerator=x, denominator=d,
                          proportion=(x/d if d else np.nan), wilson_lo=w[0], wilson_hi=w[1],
                          cp_lo=cp[0], cp_hi=cp[1], exact_p_one_sided_vs_p05=exact_p_ge(x, d))
    defs['UNIT_COUNTS'] = dict(definition='UNIT_COUNTS', numerator=np.nan, denominator=n_ids,
                               proportion=np.nan, wilson_lo=np.nan, wilson_hi=np.nan, cp_lo=np.nan,
                               cp_hi=np.nan, exact_p_one_sided_vs_p05=np.nan,
                               n_unique_id_or_pair=n_ids, n_unique_original_study=n_titles,
                               n_replication_rows=n_rows)
    out = pd.DataFrame(defs.values())
    out.insert(0, 'unit', unit); out.insert(0, 'project', label)
    return out

S = pd.read_csv(F1); R = pd.read_csv(F2)
S['drop_b'] = S['drop'].astype(bool)

print('='*100); print('STEP 1 data shapes'); print('='*100)
print(f'file1 study_data         : {S.shape[0]} rows x {S.shape[1]} cols')
print(f'file2 replication_success: {R.shape[0]} rows x {R.shape[1]} cols')
print('file1 project rows:', S['project'].value_counts().to_dict())
print('file2 project rows:', R['project'].value_counts().to_dict())

print('\n' + '='*100)
print('STEP 2 methodological check: us_lab.* is a US-location flag, NOT lab evidence')
print('='*100)
for side in ['o', 'r']:
    us = S[f'experiment_country.{side}'].eq('United States')
    agree = float(S[f'us_lab.{side}'].astype(int).eq(us.astype(int)).mean())
    n_on = int((us & S[f'online.{side}'].eq(1)).sum())
    print(f'us_lab.{side} == (experiment_country.{side}=="United States") over all {len(S)} rows: '
          f'agreement={agree:.4f}; rows with online.{side}==1 AND us_lab.{side}==1: {n_on}'
          '  -> us_lab cannot encode "in a lab"')
print(f'lab_id non-null: all={int(S["lab_id"].notna().sum())}/{len(S)}; '
      f'ee={int(S.loc[S.project=="ee","lab_id"].notna().sum())}/{int((S.project=="ee").sum())} -> unusable in ee')

print('\n' + '='*100)
print('STEP 3 ee: which SINGLE value online.o / online.r actually take')
print('='*100)
ee = S[S.project == 'ee'].copy()
for c in ['online.o', 'online.r', 'same_online']:
    print(f'ee {c:12s}: distinct_values={sorted(map(str, ee[c].dropna().unique()))} '
          f'value_counts={ee[c].value_counts(dropna=False).to_dict()} missing={int(ee[c].isna().sum())}/18')

print('\n' + '='*100)
print('STEP 4 ee headline + sensitivities (unit = unique id = O/R pair = original study)')
print('='*100)
ee_summary = share_table(ee, 'ee', 'unique id (O/R pair) = original study')
print(ee_summary.to_string(index=False))

print('\n' + '='*100)
print('STEP 5 missing main criterion / corroborating evidence contradicting it (ee)')
print('='*100)
miss = ee[ee['online.o'].isna()]
contra = ee[ee['online.o'].eq(0) & (~ee['subjects.o'].isin(['students','community']) | ~ee['compensation.o'].isin(['cash','credit']))]
contra2 = ee[ee['online.o'].eq(0) & ee['subjects.o'].eq('online')]
print(f'ee rows with missing online.o: {len(miss)}' + ('   -> NONE' if len(miss) == 0 else ''))
print(f'ee rows with online.o==0 but subjects/compensation not lab-typical: {len(contra)}' + ('   -> NONE' if len(contra) == 0 else ''))
print(f'ee rows with online.o==0 and subjects.o=="online": {len(contra2)}' + ('   -> NONE' if len(contra2) == 0 else ''))
watch = ee[ee['subjects.o'].ne('students')]
print('transparency list - ee rows deviating from modal subjects.o=="students":')
cw = ['id','title','online.o','subjects.o','subjects.r','compensation.o','experiment_country.o']
print((watch[cw] if len(watch) else pd.DataFrame(columns=cw)).to_string(index=False))
exc = pd.concat([miss.assign(issue='main criterion online.o missing'),
                 contra.assign(issue='online.o==0 but subjects/compensation not lab-typical'),
                 contra2.assign(issue='online.o==0 but subjects.o == online')])
if len(exc) == 0:
    exc = pd.DataFrame([dict(id='NONE', issue='NO excluded records: all 18 ee rows have a non-missing '
                               'online.o, and no row has corroborating evidence contradicting online.o==0')])
    print('EXCLUSION LOG: empty -> writing explicit NONE row')
else:
    exc = exc.assign(excluded_from_denominator=exc['issue'].eq('main criterion online.o missing'))
exc.to_csv('missing_or_contradictory.csv', index=False)

print('\n' + '='*100)
print('STEP 6 ee per-study detail (auditable numerator/denominator)')
print('='*100)
det = ee[['id','title','journal','pub_year','online.o','online.r','subjects.o','subjects.r',
          'compensation.o','experiment_country.o','us_lab.o']].copy()
det.insert(1, 'first_author_year',
           ee['authors.o'].str.split(' and ').str[0].str.split().str[-1] + ' (' + ee['pub_year'].astype(str) + ')')
det['classified_lab_by_H'] = det['online.o'].eq(0).astype(int)
det = det.sort_values('id', key=lambda s: s.str.extract(r'\.(\d+)$')[0].astype(int))
print(det.to_string(index=False))
det.to_csv('ee_study_detail.csv', index=False)
print(f'--> numerator check: classified_lab_by_H sums to {int(det["classified_lab_by_H"].sum())} of {len(det)}')

print('\n' + '='*100)
print('STEP 7 cross-project comparison (file-1 project labels only; unique-id dedup; +/- drop==True ids)')
print('='*100)
rows = []
for keep_drop in [False, True]:
    sub = S if keep_drop else S[~S['drop_b']]
    tag = 'drop_ids_included' if keep_drop else 'drop_ids_excluded'
    for p in ['ee', 'rpp', 'ml1', 'ml3']:
        t = share_table(sub[sub.project == p], p, tag)
        t['drop_version'] = tag
        rows.append(t)
by_proj = pd.concat(rows, ignore_index=True)
cs = ['drop_version','project','definition','numerator','denominator','proportion','wilson_lo','wilson_hi']
print(by_proj[cs].to_string(index=False))
by_proj.to_csv('summary_by_project.csv', index=False)

print('\nU3 structural caveat - ids whose replication labs differ in online.r (mixed online/offline labs):')
for p in ['ee', 'rpp', 'ml1', 'ml3']:
    g = S[S.project == p].groupby('id')['online.r'].nunique()
    print(f'  {p}: mixed-online.r ids = {int((g>1).sum())}/{len(g)}  '
          f'(rows per id: median={int(S[S.project==p].groupby("id").size().median())})')

print('\nU3 quantification - replication-side online.r at the LAB-ROW level (aggregated rows excluded),')
print('because dedup-by-id keeps the aggregated row, whose online.r is 0 even when some labs ran online:')
labr = S[S['lab_id'].notna()]
for p_, g in labr.groupby('project'):
    print(f'  {p_}: lab rows={len(g)}, online.r==0 rows={int(g["online.r"].eq(0).sum())}, '
          f'share lab-based replications={g["online.r"].eq(0).mean():.4f}')
print('  ee / rpp: no lab rows exist (single row per id) -> aggregated-row issue does not apply.')
agg = S[S['aggregated'] == True]
if len(agg):
    mixed = agg[agg['id'].isin(S[S['lab_id'].notna()].groupby('id')['online.r'].max().index)]
    bad = int((mixed['online.r'].eq(0) & mixed['id'].isin(
        S[S['lab_id'].notna()].groupby('id').apply(lambda d: d['online.r'].max() == 1, include_groups=False).pipe(lambda x: x[x].index))).sum())
    print(f'  aggregated rows coded online.r==0 although at least one lab of the same id ran online: {bad}/{len(mixed)}'
          '  -> aggregated online.r is NOT usable for the replication side in ml1/ml3.')
print('\n' + '='*100)
print('STEP 8 field coverage (all rows vs ee subset)')
print('='*100)
fields = ['online.o','online.r','same_online','subjects.o','subjects.r','compensation.o','compensation.r',
          'experiment_country.o','experiment_country.r','experiment_language.o','experiment_language.r',
          'us_lab.o','us_lab.r','lab_id','aggregated','drop','same_subjects','same_country']
cov = []
for f in fields:
    cov.append(dict(field=f, all_nonnull=int(S[f].notna().sum()), all_rows=len(S),
                    all_pct=round(100*float(S[f].notna().mean()),1),
                    ee_nonnull=int(ee[f].notna().sum()), ee_rows=len(ee),
                    ee_pct=round(100*float(ee[f].notna().mean()),1),
                    all_values=str(sorted(map(str, S[f].dropna().unique()))[:6]),
                    ee_values=str(sorted(map(str, ee[f].dropna().unique()))[:6]),
                    used_as_lab_evidence=('MAIN criterion' if f == 'online.o' else
                        'sensitivity only' if f in ('online.r','subjects.o','compensation.o') else
                        'NO - verified US-location flag' if f.startswith('us_lab') else
                        'NO - 100% missing in ee' if f == 'lab_id' else 'no')))
coverage = pd.DataFrame(cov)
print(coverage[['field','all_pct','ee_pct','ee_values','used_as_lab_evidence']].to_string(index=False))
coverage.to_csv('coverage_fields.csv', index=False)
ee_summary.to_csv('summary_ee_lab.csv', index=False)

print('\n' + '='*100)
print('STEP 9 file-2 cross-validation of ee coverage (never used for lab classification)')
print('='*100)
def key_l(a):
    return a.split(' and ')[0].split(',')[0].strip().split()[-1].lower() if isinstance(a, str) else None
ee_k = ee.assign(k=ee['authors.o'].map(key_l) + '|' + ee['pub_year'].astype(str))
rEE = R[R.project == 'Experimental Economics'].copy()
def key_r(s):
    nm = re.findall(r"[A-Z][A-Za-z'’-]+", s); yr = re.findall(r'(\d{4})', s)
    return (nm[0].lower() + '|' + yr[-1]) if nm and yr else None
rEE['k'] = rEE['study'].map(key_r)
mj = ee_k[['id','k','n.o','n.r','online.o']].merge(rEE[['study','k','no','nr']], on='k', how='outer', indicator=True)
print('match status:', mj['_merge'].value_counts().to_dict())
print('pairs where file1 n.o/n.r differ from file2 no/nr (different sample-size conventions):',
      int(((mj['n.o'] != mj['no']) | (mj['n.r'] != mj['nr'])).sum()))
mj.to_csv('join_validation_file2.csv', index=False)

print('\n' + '='*100)
print('STEP 10 HEADLINE')
print('='*100)
g = lambda d: ee_summary[ee_summary.definition == d].iloc[0]
u = g('UNIT_COUNTS')
print(f'ee unit counts: unique id (O/R pairs)={int(u.n_unique_id_or_pair)}, deduped original studies={int(u.n_unique_original_study)}, replication rows={int(u.n_replication_rows)}')
for nm, d in [('H  online.o==0        ', 'H_original_online_o_eq_0'),
              ('S1 both sides ==0     ', 'S1_both_online_o_eq_0_and_online_r_eq_0'),
              ('S2 triple evidence    ', 'S2_triple_evidence'),
              ('repl side online.r==0 ', 'DESC_replication_side_online_r_eq_0')]:
    r = g(d)
    print(f'{nm} {int(r.numerator)}/{int(r.denominator)} = {r.proportion:.4f} | Wilson95 [{r.wilson_lo:.4f}, {r.wilson_hi:.4f}]'
          f' | Clopper-Pearson95 [{r.cp_lo:.4f}, {r.cp_hi:.4f}] | exact 1-sided p vs .5 = {r.exact_p_one_sided_vs_p05:.3e}')
print('\nartifacts: summary_ee_lab.csv, summary_by_project.csv, coverage_fields.csv, ee_study_detail.csv,')
print('           join_validation_file2.csv, missing_or_contradictory.csv')
