"""
Main analysis: average length (pages) of ORIGINAL papers,
Experimental Economics (project=='ee') vs Psychology (project=='rpp').

Fixed spec approved by researcher:
 - table 1 (study_data) only; outcome field = `length` (pages of original paper)
 - category key = `project`: ee -> Experimental Economics, rpp -> Psychology
 - discipline / journal NOT used for filtering
 - main spec keeps drop==True rows, keeps same-title multiple target effects,
   keeps very short records (length 1-3)
 - sensitivity: drop-excluded, title-dedup, Psychology = rpp+ml1+ml3 (row-level & paper-level)
"""
import numpy as np, pandas as pd
from scipy import stats

RNG = np.random.default_rng(20261023)
STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
RSUC  = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

s = pd.read_csv(STUDY)
r = pd.read_csv(RSUC)
OUT = []
def P(*a):
    msg = " ".join(str(x) for x in a)
    print(msg); OUT.append(msg)

# ---------------------------------------------------------------- 1. data quality
P("="*78); P("1. DATA QUALITY / STRUCTURE REPORT"); P("="*78)
P(f"table1 study_data shape = {s.shape[0]} rows x {s.shape[1]} cols ; unique id = {s['id'].nunique()}")
P(f"table2 replication_success shape = {r.shape} ; length-like cols =",
      [c for c in r.columns if "len" in c.lower()] or "NONE -> cannot answer length question")
P("\nrows vs unique ids per project:")
P(s.groupby("project").agg(rows=("id","size"), unique_ids=("id","nunique"),
                           missing_length=("length", lambda c: int(c.isna().sum())),
                           length_min=("length","min"), length_max=("length","max")).to_string())
P("\nproject x discipline (discipline/journal are NOT filter keys):")
P(pd.crosstab(s["project"], s["discipline"]).to_string())
ee_disc = set(s.loc[s.project=="ee","discipline"])
P(f"assertion: ee disciplines = {ee_disc}  == {{'Economics'}} -> {ee_disc=={'Economics'}} "
  f"(redundant with project=='ee'; Economics n = {(s.discipline=='Economics').sum()})")
P("\nlength field: dtype=%s  missing in whole table = %d  (no imputation needed)"
  % (s["length"].dtype, int(s["length"].isna().sum())))
P("\naggregated==True rows by project:", s.loc[s.aggregated==True,"project"].value_counts().to_dict(),
  "| drop==True rows by project:", s.loc[s['drop']==True,"project"].value_counts().to_dict())

sub = s[s.project.isin(["ee","rpp"])].copy()
dup_id   = int(sub.duplicated("id").sum())
miss_len = int(sub["length"].isna().sum())
dup_tit  = int(sub.duplicated("title").sum())
P(f"\nassert ee+rpp subset: rows={len(sub)}, duplicate id rows={dup_id} (expect 0), missing length={miss_len} (expect 0)")
assert dup_id == 0 and miss_len == 0
g = s.groupby("id")["length"].nunique()
P(f"length constant within every id: {int((g==1).sum())}/{len(g)} ids -> paper-level dedup is safe")
P("\nsame original title, multiple ids (multiple target effects per paper):")
P(sub[sub.duplicated("title", keep=False)][["id","project","title","length"]].to_string(index=False))

# rpp id gap / subset nature
rpp_num = s.loc[s.project=="rpp","id"].str.split(".").str[1].astype(int)
P(f"\nrpp id numbering: min={rpp_num.min()}, max={rpp_num.max()}, present={rpp_num.nunique()} "
  f"of {rpp_num.max()} possible -> rpp rows are a {rpp_num.nunique()}/{rpp_num.max()} subset "
  f"of numbered targets (limits generalisation, does not change the mean on this data)")

ee_j = s.loc[s.project=="ee","journal"].value_counts().to_dict()
rpp_j = s.loc[s.project=="rpp","journal"].value_counts().to_dict()
P(f"\nee journals = {ee_j}  (all AER/QJE -> long econ format)")
P(f"rpp journals = {rpp_j}  (PS short reports included)")

short = sub[sub.length <= 3][["id","project","journal","discipline","length"]]
P("\nvery short original records kept in main spec (length<=3):")
P(short.to_string(index=False))
rpp_all, rpp_no3 = sub[sub.project=="rpp"], sub[(sub.project=="rpp") & (sub.length > 3)]
pull = rpp_all.length.mean() - rpp_no3.length.mean()
rpp_no1 = sub[(sub.project=="rpp") & (sub.length > 1)]
P(f"their effect on rpp mean: all={rpp_all.length.mean():.3f} (n={len(rpp_all)}); "
  f"excluding the single length==1 record={rpp_no1.length.mean():.3f} (n={len(rpp_no1)}, pull {rpp_all.length.mean()-rpp_no1.length.mean():+.3f}); "
  f"excluding all {len(short)} records with length<=3={rpp_no3.length.mean():.3f} (n={len(rpp_no3)}) -> pull = {pull:+.3f} pages "
  f"(NOTE: corrects my planning-stage estimate of ~0.05 pages, which was too small)")

# ---------------------------------------------------------------- 2. main estimates
P("\n"+"="*78); P("2. MAIN SPEC: project=='ee' vs project=='rpp', field=length"); P("="*78)
def desc(v, name):
    v = np.asarray(v, float)
    return dict(group=name, n=len(v), mean=v.mean(), median=np.median(v), sd=v.std(ddof=1),
                q1=np.percentile(v,25), q3=np.percentile(v,75), iqr=np.percentile(v,75)-np.percentile(v,25),
                minv=v.min(), maxv=v.max(), skew=stats.skew(v, bias=False))
ee = sub.loc[sub.project=="ee","length"].to_numpy(float)
rp = sub.loc[sub.project=="rpp","length"].to_numpy(float)
D = pd.DataFrame([desc(ee,"ee (Experimental Economics)"), desc(rp,"rpp (Psychology)")])
D["iqr"] = D.q3 - D.q1
P(D.round(3).to_string(index=False))
P(f"\nmean difference (ee - rpp) = {ee.mean()-rp.mean():.3f} pages")
P(f"ratio ee/rpp = {ee.mean()/rp.mean():.3f}")
P(f"median ee vs rpp = {np.median(ee):.1f} vs {np.median(rp):.1f}")

def boot_ci(a, b, B=20000):
    a, b = np.asarray(a,float), np.asarray(b,float)
    da = RNG.choice(a, (B,len(a)), replace=True).mean(1)
    db = RNG.choice(b, (B,len(b)), replace=True).mean(1)
    d = da-db; ratio = da/db
    return (np.percentile(da,[2.5,97.5]), np.percentile(db,[2.5,97.5]),
            np.percentile(d,[2.5,97.5]), np.percentile(ratio,[2.5,97.5]))
ci_e, ci_r, ci_d, ci_rat = boot_ci(ee, rp)
P(f"bootstrap 95% CI  mean ee = [{ci_e[0]:.2f}, {ci_e[1]:.2f}] ; mean rpp = [{ci_r[0]:.2f}, {ci_r[1]:.2f}]")
P(f"bootstrap 95% CI  difference = [{ci_d[0]:.2f}, {ci_d[1]:.2f}] ; ratio = [{ci_rat[0]:.2f}, {ci_rat[1]:.2f}]")
t = stats.ttest_ind(ee, rp, equal_var=False)
u = stats.mannwhitneyu(ee, rp, alternative="two-sided")
P(f"Welch t-test: t = {t.statistic:.3f}, df = {t.df:.1f}, p = {t.pvalue:.3e}")
P(f"Mann-Whitney U: U = {u.statistic:.1f}, p = {u.pvalue:.3e}")
n1, n2 = len(ee), len(rp)
sdp = np.sqrt(((n1-1)*ee.var(ddof=1)+(n2-1)*rp.var(ddof=1))/(n1+n2-2))
d_cohen = (ee.mean()-rp.mean())/sdp
rb = 2*u.statistic/(n1*n2) - 1
P(f"effect size Cohen's d (pooled SD) = {d_cohen:.2f}; rank-biserial r = {rb:+.3f} (positive => ee papers longer)")

# ---------------------------------------------------------------- 3. sensitivity
P("\n"+"="*78); P("3. SENSITIVITY TABLE (main answer uses spec #1)"); P("="*78)
rows=[]
def add(label, ee_v, rp_v, note=""):
    rows.append(dict(spec=label, ee_mean=np.mean(ee_v), ee_n=len(ee_v),
                     rpp_mean=np.mean(rp_v), rpp_n=len(rp_v),
                     diff=np.mean(ee_v)-np.mean(rp_v), ratio=np.mean(ee_v)/np.mean(rp_v), note=note))
add("1 MAIN: project ee vs rpp, all rows kept", ee, rp, "headline spec")
add("2 exclude drop==True", sub[(sub.project=="ee")&(sub['drop']!=True)].length,
                          sub[(sub.project=="rpp")&(sub['drop']!=True)].length, "7 rpp rows dropped")
add("3 dedup by original title (per paper)",
    sub[sub.project=="ee"].drop_duplicates("title").length,
    sub[sub.project=="rpp"].drop_duplicates("title").length, "rpp 97->95 papers")
add("4 exclude length<=3 short records", ee, sub[(sub.project=="rpp")&(sub.length>3)].length,
    "tests very short PS reports")
add("4b exclude only length==1", ee, sub[(sub.project=="rpp")&(sub.length>1)].length, "single 1-page JPSP record")
add("5 ee restricted to AER only", sub[(sub.project=="ee")&(sub.journal.str.contains("American Economic"))].length,
    rp, "2 QJE papers removed")
# Psychology widened to all psychology projects (row level and paper level)
psy = s[s.project.isin(["rpp","ml1","ml3"])]
add("6 Psychology = rpp+ml1+ml3 (row level)", ee, psy.length,
    "multi-lab rows inflate n; NOT the headline spec")
add("7 Psychology = rpp+ml1+ml3 (paper level, dedup id)", ee, psy.drop_duplicates("id").length,
    "one row per original paper")
S = pd.DataFrame(rows)
P(S.round(3).to_string(index=False))
P("\nper-project means for reference (paper level, dedup id):")
P(s.drop_duplicates("id").groupby("project")["length"].agg(["count","mean","median"]).round(3).to_string())
P("\nrpp split by discipline (descriptive only, not a filter):")
P(sub[sub.project=="rpp"].groupby("discipline")["length"].agg(["count","mean","median"]).round(3).to_string())

# ---------------------------------------------------------------- 4. answer
ee_m, rp_m = ee.mean(), rp.mean()
P("\n"+"="*78); P("4. ANSWER (natural-language hypothesis)"); P("="*78)
ans = (f"In this replication-project sample (table1 study_data, n=927 rows / 141 unique O/R pairs), "
       f"original-paper length is measured by the field `length` (pages of the ORIGINAL paper) and the two "
       f"categories are defined solely by the `project` key: project=='ee' = Experimental Economics "
       f"(n=18, identical to discipline=='Economics') and project=='rpp' = Psychology (n=97). "
       f"Experimental Economics original papers average {ee_m:.1f} pages (median 27.5, SD {ee.std(ddof=1):.1f}, "
       f"IQR 23.5-30.0, range 16-45), whereas Psychology (rpp) original papers average {rp_m:.2f} pages "
       f"(median 9, SD {rp.std(ddof=1):.1f}, IQR 7-16, range 1-31, right-skewed). "
       f"The gap is {ee_m-rp_m:.2f} pages, i.e. econ originals are {ee_m/rp_m:.2f}x as long "
       f"(bootstrap 95% CI for the difference {ci_d[0]:.1f}-{ci_d[1]:.1f} pages, for the ratio {ci_rat[0]:.1f}-{ci_rat[1]:.1f}; "
       f"Welch t={t.statistic:.2f}, p={t.pvalue:.1e}; Mann-Whitney U={u.statistic:.0f}, p={u.pvalue:.1e}). "
       f"Interpretation is bounded by cross-disciplinary comparability: all 18 ee papers are AER/QJE articles whose "
       f"conventions (figures, tables, appendices) and the psychology journals used by rpp (including 3-page "
       f"Psychological Science reports) differ, so this gap partly reflects journal/discipline length norms rather "
       f"than research scale or quality on a common scale, and it must not be read as a general claim about the two fields.")
P(ans)
with open("results_summary.txt","w") as f: f.write("\n".join(OUT)+"\n\nFINAL ANSWER:\n"+ans+"\n")
