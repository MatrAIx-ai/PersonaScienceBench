"""Step 0 (profiling only, no final estimates): structural checks for the
'average length of original papers: Experimental Economics vs Psychology' question."""
import pandas as pd

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
RSUC  = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

s = pd.read_csv(STUDY)
r = pd.read_csv(RSUC)

print("study rows/cols:", s.shape, "| unique id:", s["id"].nunique())
print("\nrows & unique ids per project:")
print(s.groupby("project").agg(rows=("id", "size"), uniq_id=("id", "nunique"),
                               miss_len=("length", lambda c: c.isna().sum())))
print("\nproject x discipline:\n", pd.crosstab(s["project"], s["discipline"]))
print("\naggregated flags by project:\n", s[s.aggregated == True]["project"].value_counts())
print("drop flags by project:\n", s[s["drop"] == True]["project"].value_counts())
sub = s[s.project.isin(["ee", "rpp"])]
print("\nee+rpp: dup id rows =", sub.duplicated("id").sum(),
      "| dup title rows =", sub.duplicated("title").sum(),
      "| missing length =", sub["length"].isna().sum())
print("\nlength describe ee / rpp:")
print(sub.groupby("project")["length"].describe().round(2))
print("\nreplication_success rows:", r.shape, "| project labels:", r["project"].value_counts().to_dict(),
      "| has length column:", any("len" in c for c in r.columns))
