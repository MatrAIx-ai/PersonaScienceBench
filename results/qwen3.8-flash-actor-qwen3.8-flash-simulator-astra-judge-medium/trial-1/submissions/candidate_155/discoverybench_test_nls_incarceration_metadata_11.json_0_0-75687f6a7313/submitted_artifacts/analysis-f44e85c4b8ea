"""
NLSY79: demographic disparities in median wealth in 1985 among ever-incarcerated
individuals.

Design decisions (approved by researcher):
  * negative & zero composite_wealth values KEPT in the main analysis (they are
    genuine net debt, part of the 5-component sum). ">=0 only" shown as appendix.
  * 1,899 fully duplicated rows KEPT in main analysis (no ID available);
    de-duplicated main table reported as robustness check with % differences.
  * 1990 / 1996 are trend references only; nominal dollars, unknown components,
    so no real-wealth interpretation across years.
  * ever_jailed == 1 means jailed at some point 1985-1994, hence 1985 wealth is
    largely ANTECEDENT to incarceration -> forward-looking group difference,
    NOT a causal effect of incarceration.

Reproducible: fixed RNG seed = 20261022, 2000 bootstrap replicates.
"""
import numpy as np
import pandas as pd

SEED = 20261022
N_BOOT = 2000
DATA = "data/nls_incarceration_processed.csv"
W = "composite_wealth_1985"
RNG = np.random.default_rng(SEED)

df = pd.read_csv(DATA)
df["race"] = df["race"].str.strip().str.lower()
df["sex"] = df["sex"].str.strip().str.lower()
RACES = ["white", "black", "hipanic"]          # 'hipanic' = source spelling
SEXES = ["male", "female"]

def boot_ci_median(x, n_boot=N_BOOT, rng=RNG):
    x = np.asarray(x, dtype=float)
    k = len(x)
    if k < 2:
        return (np.nan, np.nan)
    idx = rng.integers(0, k, size=(n_boot, k))
    meds = np.median(x[idx], axis=1)
    return tuple(np.percentile(meds, [2.5, 97.5]))

def fmt(v, dec=0):
    return "NA" if v is None or (isinstance(v, float) and np.nan_to_num(v, nan=-1) != v and np.isnan(v)) else f"{v:,.{dec}f}"

def cell_table(d):
    rows = []
    for race in RACES:
        for sex in SEXES:
            for ej in (1, 0):
                sub = d[(d.race == race) & (d.sex == sex) & (d.ever_jailed == ej)][W]
                lo, hi = boot_ci_median(sub)
                rows.append(dict(
                    race=race, sex=sex, ever_jailed=ej, n=len(sub),
                    median=sub.median(), q1=sub.quantile(.25), q3=sub.quantile(.75),
                    IQR=sub.quantile(.75) - sub.quantile(.25),
                    boot_lo=lo, boot_hi=hi, small_n="*** n<30" if len(sub) < 30 else "",
                ))
    return pd.DataFrame(rows)

def gap_table(cells):
    out = []
    for race in RACES:
        for sex in SEXES:
            j = cells[(cells.race == race) & (cells.sex == sex) & (cells.ever_jailed == 1)].iloc[0]
            n = cells[(cells.race == race) & (cells.sex == sex) & (cells.ever_jailed == 0)].iloc[0]
            diff = j["median"] - n["median"]
            if n["median"] > 0 and j["median"] > 0:
                ratio = j["median"] / n["median"]
                note = f"jailed = {ratio:.2f}x non-jailed ({100*(1-ratio):.0f}% lower)" if ratio < 1 \
                       else f"jailed = {ratio:.2f}x non-jailed"
            else:
                ratio = np.nan
                note = "ratio NOT computable (a group median <= 0); difference reported instead"
            out.append(dict(race=race, sex=sex, n_jailed=int(j["n"]), n_not=int(n["n"]),
                            med_jailed=j["median"], med_not=n["median"], diff=diff,
                            ratio=ratio, note=note))
    return pd.DataFrame(out)

def binary_table(d, label, subset):
    rows = []
    for ej in (1, 0):
        sub = subset[subset.ever_jailed == ej][W]
        lo, hi = boot_ci_median(sub)
        rows.append(dict(stratum=label, ever_jailed=ej, n=len(sub), median=sub.median(),
                         q1=sub.quantile(.25), q3=sub.quantile(.75),
                         IQR=sub.quantile(.75) - sub.quantile(.25), boot_lo=lo, boot_hi=hi))
    t = pd.DataFrame(rows)
    mj = t.loc[t.ever_jailed == 1, "median"].iloc[0]
    mn = t.loc[t.ever_jailed == 0, "median"].iloc[0]
    t["diff_jailed_minus_not"] = mj - mn
    t["ratio"] = (mj / mn) if (mn > 0 and mj > 0) else np.nan
    return t

def md(t):
    return t.to_string(index=False)

# ---------------- MAIN TABLE (dupes kept, all values) -------------------
cells = cell_table(df)
gaps = gap_table(cells)
summ_all = binary_table(df, "ALL (both sexes)", df)
summ_male = binary_table(df, "MALES only", df[df.sex == "male"])
summ_jailed = binary_table(df, "JAILED only (descriptive)", df)

print("=" * 100)
print("MAIN TABLE - composite_wealth_1985 by race x sex x ever_jailed (n=12,013, dupes kept)")
print("=" * 100)
print(md(cells.assign(**{c: cells[c].round(0) for c in
      ["median","q1","q3","IQR","boot_lo","boot_hi"] if c in cells})))
print("\n" + "=" * 100)
print("GAPS within same race & sex: jailed(1) - not jailed(0), median 1985 wealth")
print("=" * 100)
print(md(gaps))

print("\n" + "=" * 100)
print("BINARY (ever_jailed) SUMMARIES")
print("=" * 100)
print(md(pd.concat([summ_all, summ_male])))

# jailed-only demographic contrasts among ever-incarcerated (the actual question)
print("\n" + "=" * 100)
print("AMONG EVER-INCARCERATED ONLY: 1985 median wealth by race x sex")
print("=" * 100)
j = df[df.ever_jailed == 1]
jl = cells[cells.ever_jailed == 1]
print(md(jl))
male_j = j[j.sex == "male"]
ref = male_j[male_j.race == "white"][W].median()
print("\nMales-jailed-only racial contrasts vs white males (median = %.0f):" % ref)
for r in RACES:
    m = male_j[male_j.race == r][W].median()
    print(f"  {r:8s} n={int((male_j.race==r).sum()):4d} median={m:,.0f}  diff vs white = {m-ref:,.0f}")
print("  black/white male-jailed median ratio = %.2f" %
      (male_j[male_j.race=='black'][W].median() / ref if ref > 0 else np.nan))
print("  hipanic/white male-jailed median ratio = %.2f" %
      (male_j[male_j.race=='hipanic'][W].median() / ref if ref > 0 else np.nan))
print("Male-jailed overall median = %.0f ; female-jailed (n=%d, DESCRIPTIVE ONLY) = %.0f"
      % (male_j[W].median(), len(j[j.sex=='female']), j[j.sex=='female'][W].median()))

# ---------------- ROBUSTNESS: de-duplicated ---------------------------------
dd = df.drop_duplicates()
cells_dd = cell_table(dd)
mg = gap_table(cells_dd)
comp = gaps[["race","sex","med_jailed","med_not","diff"]].merge(
    mg[["race","sex","med_jailed","med_not","diff"]], on=["race","sex"],
    suffixes=("_keep", "_dedup"))
comp["pct_diff_med_jailed"] = 100 * (comp.med_jailed_dedup - comp.med_jailed_keep) / comp.med_jailed_keep.abs()
comp["pct_diff_med_not"] = 100 * (comp.med_not_dedup - comp.med_not_keep) / comp.med_not_keep.abs()
print("\n" + "=" * 100)
print(f"ROBUSTNESS - dedup (n={len(dd)}) vs keep (n={len(df)}): median differences")
print("=" * 100)
print(md(comp.round(2)))
print("max |%% diff| jailed = %.2f ; max |%% diff| not-jailed = %.2f"
      % (comp.pct_diff_med_jailed.abs().max(), comp.pct_diff_med_not.abs().max()))
sa, sm = binary_table(dd, "ALL dedup", dd), binary_table(dd, "MALE dedup", dd[dd.sex == "male"])
print(md(pd.concat([sa, sm])))

# ---------------- APPENDIX A: >=0 only --------------------------------------
pos = df[df[W] >= 0]
print("\n" + "=" * 100)
print("APPENDIX A - sensitivity: composite_wealth_1985 >= 0 only (n=%d)" % len(pos))
print("=" * 100)
print(md(pd.concat([binary_table(pos, "ALL >=0", pos),
                    binary_table(pos, "MALE >=0", pos[pos.sex == "male"])])))
print(md(gap_table(cell_table(pos))))

# ---------------- APPENDIX B: trend reference only -------------------------
print("\n" + "=" * 100)
print("APPENDIX B - trend reference (nominal $, NOT real change): medians by ever_jailed")
print("=" * 100)
tr = df.groupby("ever_jailed")[["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]].median().T
tr.index.name = "year"
tr.columns = ["not_jailed", "jailed"]
tr["diff"] = tr.jailed - tr.not_jailed
tr["ratio"] = (tr.jailed / tr.not_jailed).round(3)
print(tr)
trm = df[df.sex == "male"].groupby("ever_jailed")[
    ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]].median().T
trm.columns = ["not_jailed", "jailed"]; trm["diff"] = trm.jailed - trm.not_jailed
print("\nMALES only:")
print(trm)

# persist outputs
with open("analysis/results_tables.txt", "w") as f:
    f.write("seed=%d n_boot=%d\n\n" % (SEED, N_BOOT))
    for title, obj in [("MAIN CELLS", cells), ("GAPS", gaps), ("BINARY", pd.concat([summ_all, summ_male])),
                       ("JAILED CELLS", jl), ("DEDUP COMP", comp),
                       ("TREND", tr.reset_index()), ("TREND MALE", trm.reset_index())]:
        f.write("\n\n### " + title + "\n" + md(obj) + "\n")
print("\n[written] analysis/results_tables.txt")
