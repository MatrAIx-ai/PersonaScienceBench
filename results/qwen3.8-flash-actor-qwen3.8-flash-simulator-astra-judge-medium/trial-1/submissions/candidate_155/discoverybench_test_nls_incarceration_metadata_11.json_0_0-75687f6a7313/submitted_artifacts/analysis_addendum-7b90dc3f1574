"""Addendum: uncertainty of the GAP itself (not just each group median), plus
nonparametric distribution tests, plus duplicate-structure diagnostics.
Seed fixed: 20261022, 2000 bootstrap replicates."""
import numpy as np, pandas as pd
from scipy.stats import mannwhitneyu
SEED, N_BOOT = 20261022, 2000
rng = np.random.default_rng(SEED)
df = pd.read_csv("data/nls_incarceration_processed.csv")
W = "composite_wealth_1985"

def boot_diff(a, b, n_boot=N_BOOT, rng=rng):
    a, b = np.asarray(a, float), np.asarray(b, float)
    ia = rng.integers(0, len(a), (n_boot, len(a))); ib = rng.integers(0, len(b), (n_boot, len(b)))
    da = np.median(a[ia], 1) - np.median(b[ib], 1)
    return np.percentile(da, [2.5, 97.5])

def boot_ratio(a, b, n_boot=N_BOOT, rng=rng):
    a, b = np.asarray(a, float), np.asarray(b, float)
    ia = rng.integers(0, len(a), (n_boot, len(a))); ib = rng.integers(0, len(b), (n_boot, len(b)))
    ma, mb = np.median(a[ia], 1), np.median(b[ib], 1)
    ok = mb > 0
    r = ma[ok] / mb[ok]
    return (np.nan, np.nan) if ok.mean() < 0.5 else np.percentile(r, [2.5, 97.5])

rows = []
groups = [("ALL", df), ("MALES only", df[df.sex == "male"])]
for race in ["white", "black", "hipanic"]:
    groups.append((f"MALES {race}", df[(df.sex == "male") & (df.race == race)]))
for name, g in groups:
    j, n = g[g.ever_jailed == 1][W], g[g.ever_jailed == 0][W]
    dl, dh = boot_diff(j, n); rl, rh = boot_ratio(j, n)
    p = mannwhitneyu(j, n, alternative="two-sided").pvalue
    rows.append(dict(stratum=name, n_jailed=len(j), n_not=len(n),
                     med_jailed=j.median(), med_not=n.median(), diff=j.median()-n.median(),
                     diff_ci=f"[{dl:,.0f}, {dh:,.0f}]",
                     ratio=j.median()/n.median(), ratio_ci=f"[{rl:.2f}, {rh:.2f}]",
                     mw_p=f"{p:.2g}"))
tab = pd.DataFrame(rows)
print("GAP uncertainty (2000 bootstrap, seed=%d) + Mann-Whitney U on full 1985 wealth distributions" % SEED)
print(tab.to_string(index=False))

dd = df.drop_duplicates()
rows = []
for name, g in [("ALL dedup", dd), ("MALES dedup", dd[dd.sex == "male"])]:
    j, n = g[g.ever_jailed == 1][W], g[g.ever_jailed == 0][W]
    dl, dh = boot_diff(j, n)
    rows.append(dict(stratum=name, n_jailed=len(j), n_not=len(n), med_jailed=j.median(),
                     med_not=n.median(), diff=j.median()-n.median(), diff_ci=f"[{dl:,.0f}, {dh:,.0f}]",
                     ratio=j.median()/n.median(), mw_p=f"{mannwhitneyu(j,n).pvalue:.2g}"))
print("\nSame, de-duplicated sample (n=%d):" % len(dd))
print(pd.DataFrame(rows).to_string(index=False))
tab.to_string(index=False, buf=open("analysis/gap_inference.txt","w"))
print("\n[written] analysis/gap_inference.txt")
