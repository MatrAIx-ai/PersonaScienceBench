"""
NLSY-79: Incarceration and wealth among black respondents, stratified by
baseline (1985) economic status.

Design (approved):
- Economic-status ("income") strata = rank-based quartiles of
  composite_wealth_1985 among black respondents (asset-based proxy; no income
  variable exists in the file -- assumption, not documented fact).
- Lead statistic = median; means and mean changes reported alongside.
- DiD-style: (jailed delta - non-jailed delta) within each 1985-wealth
  quartile, for delta90 = composite_wealth_1990 - composite_wealth_1985 and
  delta96 = composite_wealth_1996 - composite_wealth_1985.
- Reference groups: white (primary), all non-black (secondary) for a
  triple-difference robustness view.
- Variables named exactly as in the file: race, sex, ever_jailed,
  composite_wealth_1985, composite_wealth_1990, composite_wealth_1996.
"""
import pandas as pd
import numpy as np

pd.set_option("display.width", 250)
pd.set_option("display.max_columns", 50)

df = pd.read_csv("data/nls_incarceration_processed.csv")
W85, W90, W96 = "composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"
df["d90"] = df[W90] - df[W85]
df["d96"] = df[W96] - df[W85]

print("=" * 100)
print("0. INTEGRITY / INVENTORY")
print("=" * 100)
print("shape:", df.shape, "| missing:", int(df.isna().sum().sum()),
      "| duplicate rows (treated one-per-respondent):", int(df.duplicated().sum()))
print("columns:", list(df.columns))
print("race x ever_jailed:\n", pd.crosstab(df["race"], df["ever_jailed"], margins=True))

# ---- rank-based 1985-wealth quartiles among black respondents (ties broken
# randomly with fixed seed for reproducibility) ----
b = df[df["race"] == "black"].copy()
rng = np.random.default_rng(0)
jitter = rng.random(len(b))  # deterministic random tie-breaking for ties at equal wealth
order = np.lexsort((jitter, b[W85].values))
ranks = np.empty(len(b), dtype=int)
ranks[order] = np.arange(1, len(b) + 1)
b["stratum"] = pd.qcut(pd.Series(ranks, index=b.index), 4,
                       labels=["Q1_lowest", "Q2", "Q3", "Q4_highest"])
print("\nBlack baseline-1985-wealth quartile cuts (realized value ranges):")
print(b.groupby("stratum", observed=True)[W85].agg(["min", "max", "count"]).round(0))
print("\nCell sizes (black, stratum x ever_jailed):\n",
      pd.crosstab(b["stratum"], b["ever_jailed"]))
print("\nCell sizes (black, sex x ever_jailed):\n",
      pd.crosstab(b["sex"], b["ever_jailed"]))

def cell_stats(g, cols):
    return pd.DataFrame({"n": g.size(),
                         **{f"{c}_med": g[c].median() for c in cols},
                         **{f"{c}_mean": g[c].mean() for c in cols}}).round(0)

LEV = [W85, W90, W96]
CHG = ["d90", "d96"]

print("\n" + "=" * 100)
print("1. LEVELS: black respondents by stratum x ever_jailed (median | mean)")
print("=" * 100)
tab = b.groupby(["stratum", "ever_jailed"], observed=True)[LEV].agg(["median", "mean", "count"]).round(0)
print(tab)
print("\nLevel gap (jailed - non-jailed) within stratum, median then mean:")
for q, g in b.groupby("stratum", observed=True):
    j, n = g[g.ever_jailed == 1], g[g.ever_jailed == 0]
    row = {c: (round(j[c].median() - n[c].median()), round(j[c].mean() - n[c].mean())) for c in LEV}
    print(f"  {q}: " + " | ".join(f"{c}: med{row[c][0]:+,.0f} mean{row[c][1]:+,.0f}" for c in LEV))

print("\n" + "=" * 100)
print("2. DiD-STYLE TABLE: jailed delta minus non-jailed delta within stratum (black)")
print("=" * 100)
rows = []
for q, g in b.groupby("stratum", observed=True):
    j, n = g[g.ever_jailed == 1], g[g.ever_jailed == 0]
    rows.append({
        "stratum": q, "n_jailed": len(j), "n_not": len(n),
        "d90_med_jailed": j.d90.median(), "d90_med_not": n.d90.median(),
        "d90_med_DiD": j.d90.median() - n.d90.median(),
        "d90_mean_jailed": round(j.d90.mean()), "d90_mean_not": round(n.d90.mean()),
        "d90_mean_DiD": round(j.d90.mean() - n.d90.mean()),
        "d96_med_jailed": j.d96.median(), "d96_med_not": n.d96.median(),
        "d96_med_DiD": j.d96.median() - n.d96.median(),
        "d96_mean_jailed": round(j.d96.mean()), "d96_mean_not": round(n.d96.mean()),
        "d96_mean_DiD": round(j.d96.mean() - n.d96.mean()),
    })
did = pd.DataFrame(rows).round(0)
print(did.to_string(index=False))

print("\nPooled (black, both sexes):")
j, n = b[b.ever_jailed == 1], b[b.ever_jailed == 0]
print(f"  d96 median jailed={j.d96.median():,.0f} vs not={n.d96.median():,.0f} -> DiD={j.d96.median()-n.d96.median():+,.0f}")
print(f"  d96 mean   jailed={j.d96.mean():,.0f} vs not={n.d96.mean():,.0f} -> DiD={j.d96.mean()-n.d96.mean():+,.0f}")
print(f"  d90 mean   jailed={j.d90.mean():,.0f} vs not={n.d90.mean():,.0f} -> DiD={j.d90.mean()-n.d90.mean():+,.0f}")

print("\nMale-only stratified view (interpretable; female jailed n=16 flagged too small):")
bm = b[b.sex == "male"]
for q, g in bm.groupby("stratum", observed=True):
    jg, ng = g[g.ever_jailed == 1], g[g.ever_jailed == 0]
    print(f"  {q}: n_j={len(jg):3d} n_n={len(ng):4d} | d96 med {jg.d96.median():+,.0f} vs {ng.d96.median():+,.0f} (DiD {jg.d96.median()-ng.d96.median():+,.0f}) | d96 mean {jg.d96.mean():+,.0f} vs {ng.d96.mean():+,.0f} (DiD {jg.d96.mean()-ng.d96.mean():+,.0f})")
bfj = b[(b.sex == 'female') & (b.ever_jailed == 1)]
print(f"  [FLAG] black female jailed n={len(bfj)} -- reported, not used for inference:")
print(bfj[LEV].agg(["median", "mean"]).round(0).to_string())

print("\n" + "=" * 100)
print("3. TRIPLE-DIFFERENCE ROBUSTNESS: (black DiD) - (reference DiD), mean deltas")
print("=" * 100)
def mean_deltas(g):
    j, n = g[g.ever_jailed == 1], g[g.ever_jailed == 0]
    if len(j) == 0:
        return None
    return {"n_j": len(j), "d96_mean_DiD": j.d96.mean() - n.d96.mean(),
            "d96_med_DiD": j.d96.median() - n.d96.median(),
            "d90_mean_DiD": j.d90.mean() - n.d90.mean()}

b_did = mean_deltas(b)
w_did = mean_deltas(df[df.race == "white"])
nb_did = mean_deltas(df[df.race != "black"])
print(f"black DiD d96 mean = {b_did['d96_mean_DiD']:+,.0f} (n_j={b_did['n_j']})")
print(f"white DiD d96 mean = {w_did['d96_mean_DiD']:+,.0f} (n_j={w_did['n_j']}) -> triple diff = {b_did['d96_mean_DiD']-w_did['d96_mean_DiD']:+,.0f}")
print(f"non-black DiD d96 mean = {nb_did['d96_mean_DiD']:+,.0f} (n_j={nb_did['n_j']}) -> triple diff = {b_did['d96_mean_DiD']-nb_did['d96_mean_DiD']:+,.0f}")
print(f"black DiD d96 median = {b_did['d96_med_DiD']:+,.0f}; white = {w_did['d96_med_DiD']:+,.0f}; non-black = {nb_did['d96_med_DiD']:+,.0f}")

# relative gap ratio of changes (means), black
print("\nRatio view (black): jailed 1996 mean / non-jailed 1996 mean by stratum:")
for q, g in b.groupby("stratum", observed=True):
    jg, ng = g[g.ever_jailed == 1], g[g.ever_jailed == 0]
    print(f"  {q}: level ratio 1985 = {jg[W85].mean()/ng[W85].mean():.2f}  1996 = {jg[W96].mean()/ng[W96].mean():.2f}")

print("\nTies-at-zero caveat: share with composite_wealth_1996 == 0 among black jailed:",
      f"{(j[W96]==0).mean():.2f}", "vs non-jailed:", f"{(n[W96]==0).mean():.2f}")
