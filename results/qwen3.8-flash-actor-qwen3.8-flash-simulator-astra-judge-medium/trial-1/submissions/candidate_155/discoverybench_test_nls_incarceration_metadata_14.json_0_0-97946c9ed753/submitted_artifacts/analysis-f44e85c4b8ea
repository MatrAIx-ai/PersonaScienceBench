"""
Median composite wealth among Black females (NLSY79 processed data).

Question: Between which years did the largest increases in median wealth occur
among black females?

Primary metric: absolute difference in median composite wealth (USD) between
consecutive observation years (1985->1990, 1990->1996); 1985->1996 reported for
reference. Secondary transparency metrics: relative % growth and average growth
per year (difference / interval length: 5 yr vs 6 yr).

Sensitivity analyses:
  (a) all observations (primary)
  (b) exclude rows with wealth == 0 *for that year* (zeros may be missing-data codes)
  (b2) exclude rows with zero in ANY of the three years (fixed sample across years)
  (c) ever_jailed == 0 only
  (d) ever_jailed == 1 only (small-sample caveat)
"""
import pandas as pd

pd.set_option("display.width", 160)
pd.set_option("display.max_columns", 50)

YEARS = [1985, 1990, 1996]
COLS = {y: f"composite_wealth_{y}" for y in YEARS}
LENGTH = {(1985, 1990): 5, (1990, 1996): 6, (1985, 1996): 11}

df = pd.read_csv("data/nls_incarceration_processed.csv")
print("File shape:", df.shape)
print("race values:", df["race"].value_counts(dropna=False).to_dict())
print("sex values: ", df["sex"].value_counts(dropna=False).to_dict())

sub = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
print("\nBlack-female subsample n =", len(sub))
for c in COLS.values():
    s = sub[c]
    print(f"  {c}: missing={s.isna().sum():4d} zeros={(s == 0).sum():4d} "
          f"neg={(s < 0).sum():4d} min={s.min()} max={s.max()}")


def metrics(frame, label, note=""):
    med = {y: frame[COLS[y]].median() for y in YEARS}
    n = {y: frame[COLS[y]].notna().sum() for y in YEARS}
    rows = []
    for (a, b) in [(1985, 1990), (1990, 1996), (1985, 1996)]:
        diff = med[b] - med[a]
        rel = (diff / abs(med[a]) * 100.0) if med[a] != 0 else float("nan")
        rows.append({
            "scenario": label,
            "interval": f"{a}->{b}",
            "median_1985": med[1985], "median_1990": med[1990], "median_1996": med[1996],
            "abs_change_usd": diff,
            "rel_change_pct": round(rel, 1),
            "years": LENGTH[(a, b)],
            "usd_per_year": round(diff / LENGTH[(a, b)], 1),
            "n_used": (n[a], n[b]),
            "note": note,
        })
    return rows, med, n


results = []
r, med, n = metrics(sub, "(a) all obs [PRIMARY]")
results += r
print("\nMedians (a):", {y: med[y] for y in YEARS}, "n per year:", n)

# (b) drop zeros for that year
sub_nz = sub.copy()
for y in YEARS:
    sub_nz.loc[sub_nz[COLS[y]] == 0, COLS[y]] = pd.NA
r, med_b, n_b = metrics(sub_nz, "(b) drop year-wise zeros")
results += r
print("Medians (b):", {y: med_b[y] for y in YEARS}, "n per year:", n_b)

# (b2) drop respondents with zero in any year (identical sample all years)
mask_anyzero = (sub[COLS[1985]] == 0) | (sub[COLS[1990]] == 0) | (sub[COLS[1996]] == 0)
r, med_b2, n_b2 = metrics(sub[~mask_anyzero], "(b2) drop any-year zeros")
results += r
print("Medians (b2):", {y: med_b2[y] for y in YEARS}, "n:", n_b2, "dropped:", int(mask_anyzero.sum()))

# (c) / (d) by ever_jailed
for v, lab in [(0, "(c) ever_jailed==0"), (1, "(d) ever_jailed==1 (small n)")]:
    g = sub[sub["ever_jailed"] == v]
    r, mg, ng = metrics(g, lab)
    results += r
    print(f"Medians {lab}:", {y: mg[y] for y in YEARS}, "n =", len(g))

out = pd.DataFrame(results)
print("\n================ RESULTS TABLE ================")
print(out.to_string(index=False))

def winner(c, col):
    v = c[col]
    return c.loc[v.idxmax(), "interval"] if v.notna().any() else "n/a (all NA)"

consec = out[(out.interval != "1985->1996")]
prim = consec[consec.scenario.str.startswith("(a)")]
print("\nPrimary answer (max absolute change, scenario a):", winner(prim, "abs_change_usd"))
print("\nRanking of consecutive intervals by metric, per scenario:")
for sc in out.scenario.unique():
    c = consec[consec.scenario == sc]
    print(f"  {sc}: abs={winner(c,'abs_change_usd')} | pct={winner(c,'rel_change_pct')}"
          f" | usd_per_year={winner(c,'usd_per_year')}")

out.to_csv("analysis/results_table.csv", index=False)
print("\nSaved: analysis/results_table.csv")
