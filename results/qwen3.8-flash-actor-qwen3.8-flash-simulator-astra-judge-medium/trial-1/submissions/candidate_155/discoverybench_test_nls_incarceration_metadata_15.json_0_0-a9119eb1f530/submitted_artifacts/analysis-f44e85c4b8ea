"""
Wealth inequality for white males and white females, 1990 vs 1996.
NLSY79 processed file: data/nls_incarceration_processed.csv

Conventions (fixed in advance, identical for both years):
- Nominal dollars; composite wealth taken as documented; no deflation.
- Years treated as cross-sections of the same nominal sample (no respondent ID).
- Full-row duplicates retained as legitimate ties (sensitivity checked).
- Gini: computed on the full group with negatives truncated to zero
  (zeros retained); identical convention both years; positive-subsample
  Gini reported as sensitivity.
- Top shares: share of aggregate POSITIVE wealth held by top 10% / top 1%
  of the group (ranked by wealth).
- Ratio statistics (P90/P50 etc.) reported only when denominator > 0;
  otherwise "undefined".
- Proportional change = (v96 - v90)/v90; "undefined" if v90 <= 0.
"""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')
YEARS = [1990, 1996]
W = [1, 5, 10, 25, 50, 75, 90, 99]

def pcts(s, w=W):
    return {p: float(np.percentile(s, p)) for p in w}

def gini_trunc(s):
    """Gini on full group with negatives truncated to zero (zeros kept)."""
    x = np.sort(np.clip(np.asarray(s, float), 0, None))
    n = len(x); tot = x.sum()
    if tot <= 0: return np.nan
    i = np.arange(1, n + 1)
    return float((2 * (i * x).sum()) / (n * tot) - (n + 1) / n)

def gini_pos(s):
    """Gini on strictly positive subsample (sensitivity)."""
    x = np.sort(np.asarray(s, float))
    x = x[x > 0]
    n = len(x); tot = x.sum()
    if tot <= 0: return np.nan
    i = np.arange(1, n + 1)
    return float((2 * (i * x).sum()) / (n * tot) - (n + 1) / n)

def top_shares(s, fracs=(0.10, 0.01)):
    """Share of aggregate positive wealth held by top f fraction of the group."""
    x = np.sort(np.asarray(s, float))
    pos = x[x > 0]
    tot = pos.sum()
    out = {}
    n = len(x)
    for f in fracs:
        k = max(1, int(round(f * n)))
        out[f] = float(x[-k:].sum() / tot) if tot > 0 else np.nan  # top-k overall; their negatives add to numerator consistently
    return out

def stats(s):
    q = pcts(s)
    d = {
        'n': int(len(s)),
        'mean': float(np.mean(s)),
        'sd': float(np.std(s, ddof=1)),
        'P10': q[10], 'P25': q[25], 'P50': q[50], 'P75': q[75],
        'P90': q[90], 'P99': q[99],
        'IQR': q[75] - q[25],
        'P90-P10': q[90] - q[10],
        'P90-P50': q[90] - q[50],
        'P50-P10': q[50] - q[10],
        'share_le0': float(np.mean(np.asarray(s) <= 0)),
        'gini_trunc': gini_trunc(s),
        'gini_pos': gini_pos(s),
    }
    ts = top_shares(s)
    d['top10_share'] = ts[0.10]; d['top1p_share'] = ts[0.01]
    # ratios only where denominator > 0
    d['P90/P50'] = (q[90] / q[50]) if q[50] > 0 else None
    d['P75/P25'] = (q[75] / q[25]) if q[25] > 0 else None
    d['P90/P10'] = (q[90] / q[10]) if q[10] > 0 else None
    return d

def fmt(v):
    if v is None: return 'undefined'
    if isinstance(v, float) and np.isnan(v): return 'nan'
    return f"{v:,.4f}" if isinstance(v, float) and abs(v) < 10 else (f"{v:,.0f}" if isinstance(v, float) else str(v))

def report(sub, label):
    print(f"\n{'='*80}\n{label}\n{'='*80}")
    S = {y: stats(sub[f'composite_wealth_{y}'].values) for y in YEARS}
    keys = ['n','mean','sd','P10','P25','P50','P75','P90','P99',
            'IQR','P90-P10','P90-P50','P50-P10','share_le0',
            'top10_share','top1p_share','gini_trunc','gini_pos',
            'P90/P50','P75/P25','P90/P10']
    print(f"{'statistic':<14}{'1990':>16}{'1996':>16}{'dollar change':>18}{'prop. change':>14}")
    for k in keys:
        v90, v96 = S[1990][k], S[1996][k]
        if k == 'n':
            print(f"{k:<14}{v90:>16,}{v96:>16,}{'-':>18}{'-':>14}"); continue
        share_like = k in ('share_le0','top10_share','top1p_share','gini_trunc','gini_pos')
        ratio_like = k in ('P90/P50','P75/P25','P90/P10')
        if share_like:
            ch = 'undefined' if (v90 is None or v96 is None) else f"{(v96-v90)*100:+.2f} pp"
            print(f"{k:<14}{v90:>15.4f} {v96:>15.4f}{ch:>18}{'-':>14}")
        elif ratio_like:
            ch = 'undefined' if (v90 is None or v96 is None) else f"{v96-v90:+.4f}"
            p90s = 'undefined' if v90 is None else f"{v90:.4f}"
            p96s = 'undefined' if v96 is None else f"{v96:.4f}"
            print(f"{k:<14}{p90s:>16}{p96s:>16}{ch:>18}{'-':>14}")
        else:
            dc = v96 - v90
            pc = 'undefined' if (not isinstance(v90,(int,float)) or v90 <= 0) else f"{(v96-v90)/v90*100:+.1f}%"
            print(f"{k:<14}{v90:>16,.0f}{v96:>16,.0f}{dc:>+18,.0f}{pc:>14}")

wm = df[(df.race=='white') & (df.sex=='male')]
wf = df[(df.race=='white') & (df.sex=='female')]
report(wm, "WHITE MALES (all, ever_jailed 0 and 1 combined)  N=%d" % len(wm))
report(wf, "WHITE FEMALES (all, ever_jailed 0 and 1 combined)  N=%d" % len(wf))

# Secondary, descriptive only: jail strata
for grp, name in [(wm,'WHITE MALES'), (wf,'WHITE FEMALES')]:
    for ej in (0, 1):
        sub = grp[grp.ever_jailed==ej]
        report(sub, f"{name} | ever_jailed={ej} (DESCRIPTIVE ONLY, cell N={len(sub)})")

# Sensitivity to full-row duplicates (drop exact duplicate rows within each group)
print(f"\n{'='*80}\nSENSITIVITY: full-row duplicates dropped within white groups\n{'='*80}")
for grp, name in [(wm,'WHITE MALES'), (wf,'WHITE FEMALES')]:
    g = grp.drop_duplicates()
    print(f"{name}: rows kept {len(g)} of {len(grp)} (dropped {len(grp)-len(g)})")
    for y in YEARS:
        s0 = grp[f'composite_wealth_{y}']; s1 = g[f'composite_wealth_{y}']
        print(f"  {y}: sd {np.std(s0,ddof=1):,.0f} -> {np.std(s1,ddof=1):,.0f} | "
              f"IQR {np.percentile(s0,75)-np.percentile(s0,25):,.0f} -> {np.percentile(s1,75)-np.percentile(s1,25):,.0f} | "
              f"P50 {np.percentile(s0,50):,.0f} -> {np.percentile(s1,50):,.0f} | "
              f"gini_trunc {gini_trunc(s0.values):.4f} -> {gini_trunc(s1.values):.4f} | "
              f"top10 {top_shares(s0.values)[0.10]:.4f} -> {top_shares(s1.values)[0.10]:.4f}")
