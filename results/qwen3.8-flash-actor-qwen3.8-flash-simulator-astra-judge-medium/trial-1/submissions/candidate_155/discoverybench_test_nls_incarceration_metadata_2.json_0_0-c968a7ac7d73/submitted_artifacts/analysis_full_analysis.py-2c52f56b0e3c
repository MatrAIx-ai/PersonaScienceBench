"""Full analysis: wealth by incarceration status (NLSY79 processed extract).

Question: in which years do individuals with a criminal record (ever_jailed,
jailed 1985-1994) show significantly lower wealth than those without?

Pre-registered decisions (approved by researcher):
  - exposure = ever_jailed only; no derived exposure features.
  - zeros kept as observed zeros in the main run; missing-out / wealth>0 only /
    dedup as sensitivity.
  - PRIMARY: raw scale -> one-sided Welch t-test + one-sided Mann-Whitney U,
    Holm across the 3 years, alpha=0.05. Two-sided p and 95% CIs reported too.
  - CONFIRMATORY: OLS on asinh(wealth) with sex+race (HC3), median regression.
  - A year is ROBUST if direction agrees in all analyses and Holm-adjusted p<0.05.
  - Overall cohort for the answer; sex x race only as exploratory appendix.
  - Descriptive/associational wording; unweighted data; 1899 exact duplicates kept.
"""
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.formula.api as smf
import statsmodels.api as sm

RNG = np.random.default_rng(20261022)
N_BOOT = 10_000
N_PERM = 10_000
YEARS = [1985, 1990, 1996]
WC = {y: f"composite_wealth_{y}" for y in YEARS}
SCALED = 1000.0  # asinh scale unit: thousands of dollars

df = pd.read_csv("data/nls_incarceration_processed.csv")
df["race"] = df["race"].replace({"hipanic": "hispanic"})
for y in YEARS:
    df[f"asinh_{y}"] = np.arcsinh(df[WC[y]] / SCALED)

def holm(pvals):
    """Holm step-down adjusted p-values (one-sided family)."""
    keys = list(pvals); p = np.array([pvals[k] for k in keys]); m = len(p)
    order = np.argsort(p); adj = np.empty(m); running = 0.0
    for rank, idx in enumerate(order):
        running = max(running, (m - rank) * p[idx]); adj[idx] = min(1.0, running)
    return dict(zip(keys, adj))

def cliffs_delta(a, b):
    u = stats.mannwhitneyu(a, b, alternative="two-sided").statistic
    return 2.0 * u / (len(a) * len(b)) - 1.0

def hedges_g(a, b):
    na, nb = len(a), len(b)
    sp = np.sqrt(((na - 1) * a.var(ddof=1) + (nb - 1) * b.var(ddof=1)) / (na + nb - 2))
    j = 1.0 - 3.0 / (4.0 * (na + nb) - 9.0)
    return j * (a.mean() - b.mean()) / sp

def boot_ci(a, b, stat, n_boot=N_BOOT):
    """Percentile bootstrap CI for stat(a)-stat(b); returns (diff, lo, hi, p_le_0)."""
    a = np.asarray(a); b = np.asarray(b)
    idx_a = RNG.integers(0, len(a), size=(n_boot, len(a)))
    idx_b = RNG.integers(0, len(b), size=(n_boot, len(b)))
    d = np.empty(n_boot)
    for i in range(n_boot):
        d[i] = stat(a[idx_a[i]]) - stat(b[idx_b[i]])
    return d.mean() if False else (stat(a) - stat(b),
                                   np.percentile(d, 2.5), np.percentile(d, 97.5),
                                   (d <= 0).mean())

def perm_p(a, b, n_perm=N_PERM):
    """One-sided permutation p for mean(a)-mean(b) < 0 (labels exchangeable)."""
    vals = np.concatenate([a, b]); obs = a.mean() - b.mean(); n1 = len(a)
    cnt = 0
    for _ in range(n_perm):
        RNG.shuffle(vals); cnt += (vals[:n1].mean() - vals[n1:].mean()) <= obs
    return (cnt + 1) / (n_perm + 1), obs

rows, extra = [], {}
for y in YEARS:
    c = WC[y]
    a = df.loc[df.ever_jailed == 1, c].to_numpy(float)
    b = df.loc[df.ever_jailed == 0, c].to_numpy(float)
    diff_mean = a.mean() - b.mean(); diff_med = np.median(a) - np.median(b)

    t2 = stats.ttest_ind(a, b, equal_var=False)
    t1 = t2.pvalue / 2 if diff_mean < 0 else 1 - t2.pvalue / 2
    u2 = stats.mannwhitneyu(a, b, alternative="two-sided")
    u1 = stats.mannwhitneyu(a, b, alternative="less").pvalue
    ci_mean = stats.ttest_ind(a, b, equal_var=False).confidence_interval(0.95)
    boot_dm = boot_ci(a, b, np.mean); boot_dmed = boot_ci(a, b, np.median)
    pm, obs = perm_p(a, b)

    # confirmatory regressions (adjusted for sex + race)
    ols = smf.ols(f"asinh_{y} ~ ever_jailed + C(sex) + C(race)", data=df).fit(cov_type="HC3")
    ols_raw = smf.ols(f"asinh_{y} ~ ever_jailed", data=df).fit(cov_type="HC3")
    qreg = smf.quantreg(f"{c} ~ ever_jailed + C(sex) + C(race)", data=df).fit(q=0.5)

    # decomposition: share <=0 vs conditional mean given >0
    share_a = (a <= 0).mean(); share_b = (b <= 0).mean()
    pa = a[a > 0]; pb = b[b > 0]
    cond = boot_ci(pa, pb, np.mean)
    chi2 = stats.chi2_contingency(pd.crosstab(df.ever_jailed, df[c] <= 0))
    df[f"le0_{y}"] = (df[c] <= 0).astype(int)
    logit = smf.logit(f"le0_{y} ~ ever_jailed + C(sex) + C(race)", data=df).fit(disp=0)

    rows.append(dict(year=y, n_jailed=len(a), n_never=len(b),
        mean_jailed=a.mean(), mean_never=b.mean(), diff_mean=diff_mean,
        ci95_lo_diffmean=ci_mean.low, ci95_hi_diffmean=ci_mean.high,
        boot_ci_diffmean_lo=boot_dm[1], boot_ci_diffmean_hi=boot_dm[2], boot_p_ge0=boot_dm[3],
        med_jailed=np.median(a), med_never=np.median(b), diff_median=diff_med,
        boot_ci_diffmed_lo=boot_dmed[1], boot_ci_diffmed_hi=boot_dmed[2], boot_p_ge0_med=boot_dmed[3],
        welch_t=t2.statistic, welch_p_onesided=t1, welch_p_twosided=t2.pvalue,
        mwu_p_onesided=u1, mwu_p_twosided=u2.pvalue, perm_p_onesided=pm,
        cliffs_delta=cliffs_delta(a, b), hedges_g_asinh=hedges_g(
            df.loc[df.ever_jailed == 1, f"asinh_{y}"].to_numpy(),
            df.loc[df.ever_jailed == 0, f"asinh_{y}"].to_numpy()),
        ols_asinh_beta_adj=ols.params["ever_jailed"], ols_asinh_t_adj=ols.tvalues["ever_jailed"],
        ols_asinh_p_adj=ols.pvalues["ever_jailed"],
        ols_asinh_beta_unadj=ols_raw.params["ever_jailed"], ols_asinh_p_unadj=ols_raw.pvalues["ever_jailed"],
        median_reg_beta_adj=qreg.params["ever_jailed"], median_reg_p_adj=qreg.pvalues["ever_jailed"],
        pct_le0_jailed=100 * share_a, pct_le0_never=100 * share_b, chi2_p=chi2[1],
        logit_beta_adj=logit.params["ever_jailed"], logit_p_adj=logit.pvalues["ever_jailed"],
        mean_pos_jailed=pa.mean(), mean_pos_never=pb.mean(), diff_mean_pos=cond[0],
        boot_ci_diff_meanpos_lo=cond[1], boot_ci_diff_meanpos_hi=cond[2]))
    extra[y] = dict(a=a, b=b)

primary = pd.DataFrame(rows)
# Holm across the 3 years, separately within each primary test family
for fam, col in [("welch", "welch_p_onesided"), ("mwu", "mwu_p_onesided")]:
    adj = holm({int(r.year): r[col] for _, r in primary.iterrows()})
    primary[f"{fam}_p_holm"] = [adj[int(y)] for y in primary.year]

primary["direction_all_agree"] = [
    bool((r["diff_mean"] < 0) & (r["diff_median"] < 0) & (r["ols_asinh_beta_adj"] < 0)
         & (r["median_reg_beta_adj"] < 0) & (r["cliffs_delta"] < 0))
    for _, r in primary.iterrows()]
primary["robust_significant"] = [
    bool(r["direction_all_agree"] and r["welch_p_holm"] < 0.05 and r["mwu_p_holm"] < 0.05)
    for _, r in primary.iterrows()]

pd.set_option("display.width", 260); pd.set_option("display.max_columns", 100)
print("=== PRIMARY (raw scale, unadjusted contrast) ===")
print(primary[["year", "n_jailed", "n_never", "mean_jailed", "mean_never", "diff_mean",
               "ci95_lo_diffmean", "ci95_hi_diffmean", "boot_ci_diffmean_lo", "boot_ci_diffmean_hi",
               "med_jailed", "med_never", "diff_median", "boot_ci_diffmed_lo", "boot_ci_diffmed_hi"]].round(1).to_string(index=False))
print("\n=== TESTS / EFFECTS ===")
print(primary[["year", "welch_t", "welch_p_onesided", "welch_p_holm", "welch_p_twosided",
               "mwu_p_onesided", "mwu_p_holm", "mwu_p_twosided", "perm_p_onesided",
               "cliffs_delta", "hedges_g_asinh", "direction_all_agree", "robust_significant"]].to_string(index=False))
print("\n=== CONFIRMATORY (adjusted for sex+race) ===")
print(primary[["year", "ols_asinh_beta_unadj", "ols_asinh_p_unadj", "ols_asinh_beta_adj",
               "ols_asinh_t_adj", "ols_asinh_p_adj", "median_reg_beta_adj", "median_reg_p_adj"]].round(4).to_string(index=False))
print("\n=== DECOMPOSITION (share<=0 vs E[wealth|>0]) ===")
print(primary[["year", "pct_le0_jailed", "pct_le0_never", "chi2_p", "logit_beta_adj", "logit_p_adj",
               "mean_pos_jailed", "mean_pos_never", "diff_mean_pos",
               "boot_ci_diff_meanpos_lo", "boot_ci_diff_meanpos_hi"]].round(3).to_string(index=False))
primary.to_csv("results_table_primary.csv", index=False)
