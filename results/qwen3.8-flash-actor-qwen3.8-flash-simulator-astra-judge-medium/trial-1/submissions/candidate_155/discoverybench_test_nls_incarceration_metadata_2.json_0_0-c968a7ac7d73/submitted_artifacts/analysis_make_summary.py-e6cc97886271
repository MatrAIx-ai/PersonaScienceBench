import pandas as pd, numpy as np

def md(d):
    cols=list(d.columns)
    out=['| '+' | '.join(cols)+' |', '|'+'|'.join(['---']*len(cols))+'|']
    for row in d[cols].itertuples(index=False, name=None):
        out.append('| '+' | '.join('' if (isinstance(v,float) and np.isnan(v)) else str(v) for v in row)+' |')
    return "\n".join(out)

p=pd.read_csv('results_table_primary.csv').assign(year=lambda d: d.year.astype(int)); p['year']=p['year'].astype(int)
def sci(v): return "0" if pd.isna(v) else f"{v:.2e}"
lines=[]
lines.append("# Wealth by incarceration status (NLSY79 extract, N=12,013)\n")
lines.append("Exposure: ever_jailed (jailed 1985-1994), n=289 vs never, n=11,724. Unweighted, zeros kept, 1,899 exact duplicate rows retained.\n")
lines.append("## Table 1. Primary contrasts (raw dollars, unadjusted)\n")
t1=p[['year','n_jailed','n_never','mean_jailed','mean_never','diff_mean','ci95_lo_diffmean','ci95_hi_diffmean',
      'boot_ci_diffmean_lo','boot_ci_diffmean_hi','med_jailed','med_never','diff_median','boot_ci_diffmed_lo','boot_ci_diffmed_hi',
      'cliffs_delta','hedges_g_asinh']].copy()
for c in t1.columns:
    if c not in ('year','n_jailed','n_never','med_jailed','med_never','diff_median'):
        t1[c]=t1[c].astype(float).round(3)
lines.append(t1.pipe(md)+"\n")
lines.append("## Table 2. Primary tests (one-sided H1: jailed < never), Holm over the 3 years per family\n")
t2=p[['year','welch_t','welch_p_onesided','welch_p_twosided','welch_p_holm','mwu_p_onesided','mwu_p_twosided','mwu_p_holm',
      'perm_p_onesided','direction_all_agree','robust_significant']].copy()
t2['welch_t']=t2['welch_t'].round(2)
for c in ['welch_p_onesided','welch_p_twosided','welch_p_holm','mwu_p_onesided','mwu_p_twosided','mwu_p_holm','perm_p_onesided']:
    t2[c]=t2[c].map(sci)
lines.append(t2.pipe(md)+"\n")
lines.append("## Table 3. Confirmatory regressions (adjusted for sex + race)\n")
t3=p[['year','ols_asinh_beta_unadj','ols_asinh_p_unadj','ols_asinh_beta_adj','ols_asinh_t_adj','ols_asinh_p_adj',
      'median_reg_beta_adj','median_reg_p_adj']].copy()
for c in ['ols_asinh_beta_unadj','ols_asinh_beta_adj','ols_asinh_t_adj','median_reg_beta_adj']:
    t3[c]=t3[c].round(3)
for c in ['ols_asinh_p_unadj','ols_asinh_p_adj','median_reg_p_adj']:
    t3[c]=t3[c].map(sci)
lines.append(t3.pipe(md)+"\n")
lines.append("OLS outcome = asinh(composite_wealth/1000), HC3 SE. Median regression outcome = raw wealth ($).\n")
lines.append("## Table 4. Decomposition: extensive margin (share wealth<=0) vs E[wealth | wealth>0]\n")
t4=p[['year','pct_le0_jailed','pct_le0_never','chi2_p','logit_beta_adj','logit_p_adj',
      'mean_pos_jailed','mean_pos_never','diff_mean_pos','boot_ci_diff_meanpos_lo','boot_ci_diff_meanpos_hi']].copy()
for c in t4.columns:
    if c not in ('year','chi2_p','logit_p_adj'): t4[c]=t4[c].astype(float).round(1)
for c in ['chi2_p','logit_p_adj']: t4[c]=t4[c].map(sci)
lines.append(t4.pipe(md)+"\n")
s=pd.read_csv('results_table_sensitivity.csv').assign(year=lambda d: d.year.astype(int)); s['year']=s['year'].astype(int)
s2=s.copy()
for c in ['mean1','mean0','diff','med1','med0','welch_t']: s2[c]=s2[c].round(1)
for c in ['welch_p1','welch_p_holm','welch_p2']: s2[c]=s2[c].map(sci)
lines.append("## Table 5. Sensitivity (one-sided Welch; Holm within variant)\n")
lines.append(s2[['variant','year','n1','n0','mean1','mean0','diff','med1','med0','welch_t','welch_p1','welch_p_holm','welch_p2']].pipe(md)+"\n")
a=pd.read_csv('results_table_appendix_sexrace.csv').assign(year=lambda d: d.year.astype(int)); a['year']=a['year'].astype(int)
a['mwu_p1']=a['mwu_p1'].map(sci)
for c in ['med_jailed','med_never','mean_jailed','mean_never']: a[c]=a[c].astype(float).round(1)
lines.append("## Table 6. Exploratory appendix: sex x race cells (LOW POWER, n_jailed as low as 9-16)\n")
lines.append(a.pipe(md)+"\n")
ratio=p.assign(ratio_mean=p.mean_jailed/p.mean_never, ratio_med_na=np.nan)[['year','mean_jailed','mean_never','ratio_mean']]
ratio['ratio_mean']=ratio['ratio_mean'].round(3)
lines.append("## Table 7. Wealth ratio (jailed / never), mean scale\n")
lines.append(ratio.pipe(md)+"\n")
open('results_summary.md','w').write("\n".join(lines))
print("\n".join(lines))
