import pandas as pd, numpy as np
df = pd.read_csv('data/nls_incarceration_processed.csv')
print("shape:", df.shape)
print("\ndtypes:\n", df.dtypes)
print("\nmissing pct:\n", (df.isna().mean()*100).round(3))
print("\nmissing counts:\n", df.isna().sum())
for c in ['race','sex','ever_jailed']:
    print(f"\n{c} value_counts (dropna=False):")
    print(df[c].value_counts(dropna=False))
print("\never_jailed unique repr:", df.ever_jailed.unique()[:10], df.ever_jailed.dtype)
w = [c for c in df.columns if c.startswith('composite_wealth')]
print("\nwealth describe:")
print(df[w].describe(percentiles=[.01,.25,.5,.75,.95,.99]).T)
print("\nwealth sign shares:")
for c in w:
    s = df[c]
    print(c, "neg=%.3f"%( (s<0).mean()), "zero=%.3f"%((s==0).mean()), "pos=%.3f"%((s>0).mean()), "nuniq=", s.nunique())
print("\nskew/kurt:")
print(df[w].skew(), df[w].kurt())
# groups by year, dropping missing wealth per year
print("\ncrosstab sex x race x ever_jailed:")
print(pd.crosstab([df.sex, df.race], df.ever_jailed))
for c in w:
    sub = df.dropna(subset=[c])
    print(f"\n{c}: N={len(sub)}")
    print(sub.groupby('ever_jailed')[c].agg(['count','mean','median','std']))
