import pandas as pd, numpy as np
pd.set_option('display.width', 200)
df = pd.read_csv('data/nls_incarceration_processed.csv')
w = [c for c in df.columns if c.startswith('composite_wealth')]
for c in w:
    s = df[c]
    print(f"\n== {c} == min={s.min()} q25={s.quantile(.25)} med={s.median()} q75={s.quantile(.75)} q99={s.quantile(.99)} max={s.max()}")
    print("  rounding: pct divisible by 100 = %.3f" % (100*(s%100==0).mean()), " by 50 =", round(100*(s%50==0).mean(),1))
    print("  top10:", sorted(s.unique())[-5:], " bottom5:", sorted(s.unique())[:5])
    for v in [-999999,-9999,999999,99999,888888]:
        print(f"   count == {v}:", int((s==v).sum()))
print("\nduplicate full rows:", int(df.duplicated().sum()))
# zeros / nonpos by group
print("\nshare <=0 by group/year:")
for c in w:
    print(c)
    print(df.groupby('ever_jailed')[c].apply(lambda s: pd.Series({'pct<=0':(s<=0).mean()*100,'pct==0':(s==0).mean()*100,'pct<0':(s<0).mean()*100})).unstack().round(2))
# preliminary quick tests (diagnostic only)
from scipy import stats
print("\npreliminary Welch t-test and Mann-Whitney (unweighted, log1p on shifted wealth):")
for c in w:
    a = df.loc[df.ever_jailed==1, c]; b = df.loc[df.ever_jailed==0, c]
    t = stats.ttest_ind(a,b,equal_var=False)
    u = stats.mannwhitneyu(a,b,alternative='less')
    print(f"{c}: t={t.statistic:.2f} p={t.pvalue:.2e} | MWU(one-sided jailed<never) p={u.pvalue:.3e} | diff_mean={a.mean()-b.mean():.0f} diff_med={a.median()-b.median():.0f}")
# trimmed means as robustness (1-99 winsorized)
print("\nwinsorized(1,99) means:")
for c in w:
    lo,hi = df[c].quantile([.01,.99])
    s = df[c].clip(lo,hi)
    tmp = df.assign(ws=s)
    g = tmp.groupby('ever_jailed').ws.mean()
    print(c, "jailed=%.0f never=%.0f diff=%.0f"%(g[1],g[0],g[1]-g[0]))
