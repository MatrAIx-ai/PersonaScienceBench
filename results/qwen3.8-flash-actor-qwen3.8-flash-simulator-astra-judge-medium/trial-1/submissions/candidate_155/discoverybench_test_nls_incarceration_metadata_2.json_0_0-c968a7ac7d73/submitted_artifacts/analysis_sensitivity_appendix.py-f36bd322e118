"""Sensitivity analyses + exploratory sex x race appendix (support to full_analysis.py).

Variants:
  A. main (zeros kept, duplicates kept)  -- reference
  B. zeros -> missing (NaN)
  C. subset wealth > 0 only
  D. exact duplicate rows dropped
  E. winsorized at 1st/99th percentile of pooled distribution
  F. 10% trimmed means + Yuen-Welch test
Each variant: one-sided Welch p and Holm across years, plus mean diff.
"""
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.stats.weightstats as sw

RNG = np.random.default_rng(7)
YEARS=[1985,1990,1996]; WC={y:f"composite_wealth_{y}" for y in YEARS}
df = pd.read_csv("data/nls_incarceration_processed.csv")

def holm(d):
    ks=list(d); p=np.array([d[k] for k in ks]); m=len(p); o=np.argsort(p); adj=np.empty(m); run=0.
    for r,i in enumerate(o): run=max(run,(m-r)*p[i]); adj[i]=min(1.,run)
    return dict(zip(ks, adj))

def one_sided_p(t, diff, dfree):
    p2 = 2*stats.t.sf(abs(t), dfree)
    return p2/2 if diff < 0 else 1-p2/2

def welch(x, y):
    res = stats.ttest_ind(x, y, equal_var=False)
    return res.statistic, one_sided_p(res.statistic, x.mean()-y.mean(), res.df), res.pvalue

def yuen_welch(x, y, prop=0.1):
    """Yuen-Welch (trimmed-mean) test, H1: mean_trim(x) < mean_trim(y)."""
    def stats_g(v):
        n=len(v); h=int(np.floor(prop*n)); sv=np.sort(v)
        tm=sv[h:n-h].mean()
        w=np.clip(sv, sv[h], sv[n-1-h])          # winsorized
        m=n-2*h-1
        sw2=((w-tm)**2).sum()/m
        return tm, sw2, n-2*h
    t1,w1,m1=stats_g(x); t2,w2,m2=stats_g(y)
    o1,o2=w1/m1, w2/m2
    t=(t1-t2)/np.sqrt(o1+o2)
    dfree=(o1+o2)**2/(o1**2/(m1-1)+o2**2/(m2-1))
    p1=stats.t.cdf(t, dfree)          # one-sided: x < y
    return t, dfree, p1, t1, t2

out=[]
for y in YEARS:
    c=WC[y]; base=df[[c,'ever_jailed']].copy()
    variants={}
    variants['A_main'] = base
    v=base.copy(); v.loc[v[c]==0,c]=np.nan; variants['B_zero_as_missing']=v
    variants['C_positive_only']=base[base[c]>0]
    variants['D_dedup_rows']=df.drop_duplicates()[[c,'ever_jailed']]
    lo,hi=base[c].quantile([.01,.99]); v=base.copy(); v[c]=v[c].clip(lo,hi); variants['E_winsorized_1_99']=v
    for name,d in variants.items():
        a=d.loc[d.ever_jailed==1,c].dropna().to_numpy(float); b=d.loc[d.ever_jailed==0,c].dropna().to_numpy(float)
        t,p1,p2 = welch(a,b)
        out.append(dict(variant=name, year=y, n1=len(a), n0=len(b), mean1=a.mean(), mean0=b.mean(),
                        diff=a.mean()-b.mean(), med1=np.median(a), med0=np.median(b),
                        welch_t=t, welch_p1=p1, welch_p2=p2))
sens=pd.DataFrame(out)
# Holm per variant properly
sens['welch_p_holm']=np.nan
for v in sens.variant.unique():
    m=sens.variant==v
    adj=holm(dict(zip(sens.index[m], sens.loc[m,'welch_p1'])))
    sens.loc[m,'welch_p_holm']=[adj[i] for i in sens.index[m]]
pd.set_option('display.width',240)
print("=== SENSITIVITY: one-sided Welch (H1: jailed < never) ===")
disp=sens.copy()
for col in ['welch_p1','welch_p_holm','welch_p2']:
    disp[col]=disp[col].map(lambda v: f"{v:.2e}")
for col in ['mean1','mean0','diff','med1','med0','welch_t']:
    disp[col]=disp[col].round(1)
print(disp[['variant','year','n1','n0','mean1','mean0','diff','med1','med0','welch_t','welch_p1','welch_p_holm','welch_p2']].to_string(index=False))
print("\nsign of difference negative in every variant/year:", bool((sens['diff']<0).all()),
      "| all Holm-adjusted p<0.05:", bool((sens['welch_p_holm']<0.05).all()))

# 10% trimmed means / Yuen-Welch
print("\n=== 10% TRIMMED MEANS (Yuen-Welch, one-sided) ===")
for y in YEARS:
    c=WC[y]; a=df.loc[df.ever_jailed==1,c].to_numpy(float); b=df.loc[df.ever_jailed==0,c].to_numpy(float)
    t,dfree,p1,tm1,tm2=yuen_welch(a,b,0.1)
    print(f" {y}: 10%-trimmed mean jailed={tm1:9.0f} never={tm2:9.0f} diff={tm1-tm2:9.0f} "
          f"t={t:.2f} df={dfree:.0f} one-sided p={p1:.3e}")
    print(f"      20%-trimmed: jailed={stats.trim_mean(a,0.2):9.0f} never={stats.trim_mean(b,0.2):9.0f} diff={stats.trim_mean(a,0.2)-stats.trim_mean(b,0.2):9.0f}")
sens.to_csv('results_table_sensitivity.csv', index=False)

# exploratory appendix: sex x race
print("\n=== EXPLORATORY: sex x race cells (LOW POWER; one-sided MWU, no cell-level conclusion) ===")
rows=[]
for y in YEARS:
    c=WC[y]
    for sex in ['male','female']:
        for race in ['white','black','hipanic']:
            s=df[(df.sex==sex)&(df.race==race)]
            a=s.loc[s.ever_jailed==1,c]; b=s.loc[s.ever_jailed==0,c]
            rows.append(dict(year=y,sex=sex,race=race,n_jailed=len(a),n_never=len(b),
                med_jailed=a.median() if len(a) else np.nan, med_never=b.median(),
                mean_jailed=a.mean() if len(a) else np.nan, mean_never=b.mean(),
                mwu_p1=stats.mannwhitneyu(a,b,alternative='less').pvalue if len(a)>=5 else np.nan))
app=pd.DataFrame(rows)
print(app.round(4).to_string(index=False))
app.to_csv('results_table_appendix_sexrace.csv', index=False)
