import pandas as pd, numpy as np
from scipy import stats
df = pd.read_csv('data/nls_incarceration_processed.csv')
w = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
z = (df[w]==0)
print("zero co-occurrence counts (n zeros per respondent):")
print(z.sum(axis=1).value_counts().sort_index())
print("\nphi corr between zero indicators:\n", z.astype(int).corr().round(3))
print("\nzeros by group across years:")
print(df.assign(nz=z.sum(axis=1)).groupby('ever_jailed').nz.mean().round(3))
print("\nstratified cell sizes (n_jailed, n_never) and one-sided MWU p (jailed<never):")
for c in w:
    for sex in ['male','female']:
        for race in ['white','black','hipanic']:
            sub = df[(df.sex==sex)&(df.race==race)]
            a = sub.loc[sub.ever_jailed==1,c]; b = sub.loc[sub.ever_jailed==0,c]
            if len(a)>=5:
                p = stats.mannwhitneyu(a,b,alternative='less').pvalue
            else:
                p = np.nan
            print(f"  {c[-4:]} {sex:6s} {race:8s} n1={len(a):4d} n0={len(b):5d} p={'NA' if np.isnan(p) else format(p,'.2e')}")
print("\nadjusted OLS on IHS(wealth) ~ jailed + sex + race (t, p):")
import statsmodels.formula.api as smf
df['ih_1985']=np.arcsinh(df.composite_wealth_1985/1000)
df['ih_1990']=np.arcsinh(df.composite_wealth_1990/1000)
df['ih_1996']=np.arcsinh(df.composite_wealth_1996/1000)
for c in ['ih_1985','ih_1990','ih_1996']:
    m = smf.ols(f"{c} ~ ever_jailed + C(sex) + C(race)", data=df).fit(cov_type='HC3')
    print(f"  {c}: beta_jailed={m.params['ever_jailed']:.3f} t={m.tvalues['ever_jailed']:.2f} p={m.pvalues['ever_jailed']:.2e}")
