"""
Step 1 (PLAN stage): data inspection + pilot diagnostics for the NLS SES / BA-completion question.
Question being investigated (NOT yet answered): which variable's effect on BA DEGREE COMPLETED
drops from 0.3636 to -0.2293 (and loses significance) when race AND academic characteristics
are entered jointly?
Writes:  output/step1_inspection.txt
"""
import itertools
import numpy as np
import pandas as pd
import statsmodels.formula.api as smf

RAW = "data/nls_ses_processed.csv"
out = []
def w(*a):
    s = " ".join(str(x) for x in a)
    print(s); out.append(s)

df = pd.read_csv(RAW)
w("=== 1. STRUCTURE ===")
w("shape:", df.shape, " (rows x cols, incl. unnamed row-index column)")
w("columns:", list(df.columns))
w(df.dtypes.to_string())
w("missing share:\n" + (df.isna().mean() * 100).round(3).to_string())
w("duplicated CASE ID:", int(df["CASE ID"].duplicated().sum()))

w("\n=== 2. DISTRIBUTIONS ===")
for c in ["SAMPLE_RACE", "SAMPLE_SEX", "BA DEGREE COMPLETED"]:
    vc = df[c].value_counts(dropna=False)
    pc = (df[c].value_counts(normalize=True, dropna=False) * 100).round(2)
    w(c, "->", {f"{k}={v} ({pc[k]}%)": None for k, v in vc.items()})
w(df[["FAMILY SIZE OF SAMPLE", "ABILITY: COMPOSITE OF ASVAB SCORE",
      "PERCENTILE IN CLASS", "SES"]].describe().round(3).to_string())
w("BA completion rate by race:\n" + df.groupby("SAMPLE_RACE")["BA DEGREE COMPLETED"].mean().round(4).to_string())
w("BA completion rate by sex:\n" + df.groupby("SAMPLE_SEX")["BA DEGREE COMPLETED"].mean().round(4).to_string())
w("correlations:\n" + df.drop(columns=["Unnamed: 0"]).corr(numeric_only=True).round(3).to_string())

# tidy view
d = df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE": "asvab",
                       "PERCENTILE IN CLASS": "pct",
                       "FAMILY SIZE OF SAMPLE": "fam",
                       "BA DEGREE COMPLETED": "y",
                       "SAMPLE_RACE": "race",
                       "SAMPLE_SEX": "sex"})
d["y"] = d["y"].astype(int)
d["male"] = (d["sex"] == "Male").astype(int)
cands = ["SES", "asvab", "pct", "fam", "male"]
for c in cands:
    d[c + "_z"] = (d[c] - d[c].mean()) / d[c].std()

w("\n=== 3. PILOT: scale check (is 0.3636 a linear-model coefficient?) ===")
for c in cands:
    m0 = smf.ols(f"y ~ {c}", data=d).fit()
    m0z = smf.ols(f"y ~ {c}_z", data=d).fit()
    w(f"OLS/LPM  {c:5s}: raw b={m0.params[c]:+.5f}  per-SD b={m0z.params[c+'_z']:+.5f}  (p={m0.pvalues[c]:.2g})")
for c in cands:
    m0 = smf.logit(f"y ~ {c}", data=d).fit(disp=0)
    m0z = smf.logit(f"y ~ {c}_z", data=d).fit(disp=0)
    w(f"LOGIT    {c:5s}: raw b={m0.params[c]:+.4f}  per-SD b={m0z.params[c+'_z']:+.4f}  (p={m0.pvalues[c]:.2g})")

w("\n=== 4. PILOT: coefficient ladder for each candidate (logit, raw units) ===")
w("M0 y~x | M1 +race | M2 +acad(asvab,pct) | M3 +race+acad | M4 M3+sex | M5 M3+famsize")
for c in cands:
    others = [t for t in cands if t != c]
    specs = {
        "M0": f"{c}",
        "M1": f"{c} + C(race)",
        "M2": f"{c} + asvab + pct",
        "M3": f"{c} + C(race) + asvab + pct",
        "M4": f"{c} + C(race) + asvab + pct + male",
        "M5": f"{c} + C(race) + asvab + pct + " + " + ".join(others),
    }
    cells = []
    for k, f in specs.items():
        m = smf.logit("y ~ " + f, data=d).fit(disp=0)
        cells.append(f"{k}:{m.params[c]:+.4f}(p={m.pvalues[c]:.3g})")
    w(f"{c:5s} " + " ".join(cells))

w("\n=== 5. PILOT: invariance to race reference category (logit, SES) ===")
for r in ["Black", "Hispanic", "White"]:
    d["r_" + r] = (d["race"] == r).astype(int)
    for expr in ["r_" + r, "C(race)"]:
        m = smf.logit("y ~ " + expr + " + SES + asvab + pct", data=d).fit(disp=0)
        b0 = smf.logit("y ~ " + expr + " + SES", data=d).fit(disp=0)
        w(f"coding {expr:10s}: SES baseline={b0.params['SES']:+.4f}  full={m.params['SES']:+.4f} (p={m.pvalues['SES']:.4f})")

w("\n=== 6. PILOT: same ladder in LPM (OLS) ===")
for c in cands:
    m0 = smf.ols(f"y ~ {c}", data=d).fit()
    m3 = smf.ols("y ~ C(race) + " + " + ".join([c] + [t for t in cands if t != c]), data=d).fit()
    w(f"{c:5s} OLS: single b={m0.params[c]:+.5f}(p={m0.pvalues[c]:.2g}) -> full b={m3.params[c]:+.5f}(p={m3.pvalues[c]:.3g})")

w("\n=== 7. TARGET-MATCH SEARCH: which spec reproduces 0.3636 / -0.2293 (logit, SES raw)? ===")
pool = {"race": "C(race)", "male": "male", "fam": "fam", "asvab": "asvab", "pct": "pct"}
rows = []
for r in range(0, 6):
    for combo in itertools.combinations(pool, r):
        f = "y ~ SES + " + " + ".join([pool[c] for c in combo]) if combo else "y ~ SES"
        m = smf.logit(f, data=d).fit(disp=0)
        rows.append((",".join(combo) or "none", m.params["SES"], m.pvalues["SES"]))
for name, b, p in sorted(rows, key=lambda t: -t[1]):
    tag = ""
    if abs(b - 0.3636) < 0.02: tag = "  <== ~ +0.3636"
    if abs(b + 0.2293) < 0.015: tag = "  <== ~ -0.2293"
    w(f"{name:28s} SES={b:+.4f} p={p:.4g}{tag}")

with open("output/step1_inspection.txt", "w") as fh:
    fh.write("\n".join(out) + "\n")
