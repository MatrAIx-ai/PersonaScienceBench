def tab(model, label):
    t = model.summary2().tables[1].reset_index().rename(
        columns={"index": "term", "Coef.": "b", "Std.Err.": "SE", "P>|z|": "p",
                 "P>|t|": "p", "[0.025": "ci_lo", "0.975]": "ci_hi"})
    t = t.rename(columns={c: "z_or_t" for c in t.columns if c in ("z", "t")})
    t.insert(0, "model", label)
    t["OR"] = np.exp(t["b"])
    cols = [c for c in ["model", "term", "b", "SE", "z_or_t", "p", "ci_lo", "ci_hi", "OR"] if c in t]
    return t[cols]

def ladder(family):
    long, focus = [], []
    specs = {"M0_single": "BA ~ {x}",
             "M1_+race": "BA ~ {x} + " + RACE,
             "M2_+academics": "BA ~ {x} + " + ACAD,
             "M3_+race+acad": "BA ~ {x} + " + RACE + " + " + ACAD,
             "M4_+sex": "BA ~ {x} + " + RACE + " + " + ACAD + " + FEMALE"}
    for x in X:
        for mk, f in specs.items():
            # build formula with unique terms only (avoid x appearing twice in the academics block)
            head, _, tail = f.format(x=x).partition("~")
            terms, seen = [], set()
            for t in [q.strip() for q in tail.split("+")]:
                key = t.replace(" ", "")
                if key not in seen:
                    seen.add(key); terms.append(t)
            formula = head.strip() + " ~ " + " + ".join(terms)
            est = smf.ols(formula, data=d).fit() if family == "ols" else smf.logit(formula, data=d).fit(disp=0)
            t = tab(est, f"{family}|{x}|{mk}")
            long.append(t)
            row = t[t.term == x].iloc[0]
            focus.append({"predictor": x, "model": mk, "b": row.b, "SE": row.SE, "p": row.p,
                          "OR": np.exp(row.b), "sig_5pct": row.p < 0.05, "sign": np.sign(row.b)})
    return pd.concat(long, ignore_index=True), pd.DataFrame(focus)

def cumulative(family):
    """Canonical nested ladder on a fixed design: every model reported with ALL its terms."""
    specs = {"C1_SES_only": "BA ~ SES",
             "C2_+race": "BA ~ SES + " + RACE,
             "C3_+academics": "BA ~ SES + " + RACE + " + " + ACAD,
             "C4_+sex": "BA ~ SES + " + RACE + " + " + ACAD + " + FEMALE",
             "C5_+famsize": "BA ~ SES + " + RACE + " + " + ACAD + " + FEMALE + FAMSIZE"}
    out = []
    for mk, f in specs.items():
        est = smf.ols(f, data=d).fit() if family == "ols" else smf.logit(f, data=d).fit(disp=0)
        out.append(tab(est, f"{family}|{mk}"))
    return pd.concat(out, ignore_index=True)

