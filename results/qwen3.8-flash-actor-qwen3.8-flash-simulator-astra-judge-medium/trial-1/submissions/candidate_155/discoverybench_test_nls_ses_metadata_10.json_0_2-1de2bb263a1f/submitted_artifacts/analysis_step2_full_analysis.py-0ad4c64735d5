# ---- 6. Firth penalized logistic ---------------------------------------
def firth_logit(Xm, y, names=None, maxiter=500, check_grad=True):
    """Firth (1993) penalized-likelihood logistic regression.
    Penalized log-lik = l(b) + 0.5*log|I(b)|,  I(b)=X'W X, W=diag(p(1-p)).
    Gradient of the penalty term: 0.5 * X'[(1-2p)*h],  h_i = w_i * x_i' I^-1 x_i."""
    names = list(names) if names is not None else [f"x{i}" for i in range(np.asarray(Xm).shape[1])]
    Xm = np.asarray(Xm, float); y = np.asarray(y, float); k = Xm.shape[1]

    def parts(b):
        eta = Xm @ b; p = 1.0 / (1.0 + np.exp(-eta)); w_ = p * (1.0 - p)
        I = Xm.T @ (Xm * w_[:, None])
        Ill = np.linalg.pinv(I)
        h = w_ * np.einsum("ij,jk,ik->i", Xm, Ill, Xm)
        ll = float(np.sum(y * eta - np.logaddexp(0.0, eta)))
        sign, logdet = np.linalg.slogdet(I + 1e-12 * np.eye(k))
        obj = -(ll + 0.5 * logdet)
        g = -(Xm.T @ (y - p) + 0.5 * (Xm.T @ ((1.0 - 2.0 * p) * h)))
        return obj, g

    if check_grad:
        b0 = np.zeros(k)
        _, ga = parts(b0)
        gn = np.zeros(k); f0 = parts(b0)[0]
        for j in range(k):
            e = np.zeros(k); e[j] = 1e-6
            gn[j] = (parts(b0 + e)[0] - parts(b0 - e)[0]) / 2e-6
        assert np.max(np.abs(ga - gn)) < 1e-3, f"analytic gradient wrong: {np.max(np.abs(ga-gn)):.2e}"

    res = minimize(lambda b: parts(b)[0], np.zeros(k), jac=lambda b: parts(b)[1],
                   method="L-BFGS-B", options={"maxiter": maxiter, "ftol": 1e-15, "gtol": 1e-12})
    eta = Xm @ res.x; p = 1.0 / (1.0 + np.exp(-eta)); w_ = p * (1.0 - p)
    I = Xm.T @ (Xm * w_[:, None])
    se = np.sqrt(np.diag(np.linalg.pinv(I)))
    z = res.x / se
    return pd.DataFrame({"b": res.x, "SE": se, "z": z, "p": 2 * norm.sf(np.abs(z))}, index=names)


