"""Step 3: readable summary tables + final hypothesis document (reads step2 outputs)."""
import numpy as np, pandas as pd

cum = pd.read_csv("output/step2_cumulative_models_logit.csv")
cumo = pd.read_csv("output/step2_cumulative_models_ols.csv")
laf = pd.read_csv("output/step2_focus_logit.csv")
oaf = pd.read_csv("output/step2_focus_ols.csv")
anch = pd.read_csv("output/step2_anchor_matching.csv")
sig = pd.read_csv("output/step2_significance_of_SES.csv")
fis = pd.read_csv("output/step2_firth_vs_mle.csv")
vif = pd.read_csv("output/step2_vif.csv")
ref = pd.read_csv("output/step2_reference_invariance.csv")
sh  = pd.read_csv("output/step2_ses_spec_search.csv")

PRETTY = {"C(RACE, Treatment('White'))[T.Black]": "race: Black (ref=White)",
          "C(RACE, Treatment('White'))[T.Hispanic]": "race: Hispanic (ref=White)",
          "Intercept": "(intercept)"}

def wide(t, family, bformat):
    t = t.copy()
    t["cell"] = [f"{b:{bformat}} ({se:{bformat}}); p={p:.3g}" for b, se, p in zip(t.b, t.SE, t.p)]
    w = t.pivot_table(index="term", columns="model", values="cell", aggfunc="first")
    order = [m for m in w.columns if m.startswith(family)]
    return w[order].rename(index=PRETTY)

wl = wide(cum, "logit", "+.4f"); wo = wide(cumo, "ols", "+.5f")
wl.to_csv("output/step3_table_A_nested_logit.csv"); wo.to_csv("output/step3_table_B_nested_ols.csv")
out = []
def w(*a):
    s = " ".join(str(x) for x in a); print(s); out.append(s)

w("=== TABLE A. Nested models, LOGIT (primary), b (SE); p ; White reference, raw units ===")
w(wl.to_string())
w("\n=== TABLE B. Nested models, OLS/LPM (robustness, probability units) ===")
w(wo.to_string())

piv = laf.pivot(index="predictor", columns="model", values="b")[
    ["M0_single", "M1_+race", "M2_+academics", "M3_+race+acad", "M4_+sex"]]
pivp = laf.pivot(index="predictor", columns="model", values="p")[piv.columns]
cells = pd.DataFrame({c: [f"{piv.loc[i,c]:+.4f} (p={pivp.loc[i,c]:.3g})" for i in piv.index] for c in piv.columns},
                     index=piv.index)
cells["sign_reversal_M0_vs_M3"] = (np.sign(piv["M0_single"]) != np.sign(piv["M3_+race+acad"]))
cells.to_csv("output/step3_table_C_focal_ladder_logit.csv")
w("\n=== TABLE C. Focal-predictor ladder (each predictor entered alone, then controls added) ===")
w(cells.to_string())

w("\n=== TABLE D. Anchor matching (0.3636 baseline / -0.2293 race+academics) ===")
w(anch.round(4).to_string(index=False))
w("\n=== TABLE E. Significance of SES across specifications ===")
w(sig.round(4).to_string(index=False))
w("\n=== TABLE F. Firth vs MLE, M3 design ===")
w(fis.round(4).to_string(index=False))
w("\n=== TABLE G. VIF (full design) ===")
w(vif.round(2).to_string(index=False))
w("\n=== TABLE H. Race-coding invariance of b_SES ===")
w(ref.round(4).to_string(index=False))
w(f"b_full range over {len(ref)} codings: [{ref.b_full.min():+.4f}, {ref.b_full.max():+.4f}]")
w("\n=== TABLE I. Spec search: specs whose b_SES hits the anchors ===")
hits = sh[(sh["dev_vs_+0.3636"].abs() < .02) | (sh["dev_vs_-0.2293"].abs() < .015)]
w(hits.round(4).to_string(index=False))

open("output/step3_summary.txt", "w").write("\n".join(out) + "\n")
w("\nwritten: output/step3_table_A_nested_logit.csv, _B_nested_ols.csv, _C_focal_ladder_logit.csv, step3_summary.txt")
