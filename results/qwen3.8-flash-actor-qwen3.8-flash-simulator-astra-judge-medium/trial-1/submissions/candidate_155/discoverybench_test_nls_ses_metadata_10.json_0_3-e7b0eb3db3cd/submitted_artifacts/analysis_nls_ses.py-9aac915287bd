"""
FINAL ANALYSIS (DiscoveryBench nls_ses / metadata_10.json/0/3)
Question: effect of which variable on BA degree completion decreases 0.5024 -> 0.0923
          (becoming insignificant) when BOTH SES and academic characteristics are included?

PRE-REGISTERED PRIMARY SPEC (agreed with researcher):
  Logistic regression (GLM/Binomial MLE) on BA DEGREE COMPLETED, RAW log-odds coefficients,
  continuous predictors in original scale, n = 8773 (no missing values).
    M0 base : origin = SAMPLE_RACE (ref White) + SAMPLE_SEX (ref Male) + FAMILY SIZE OF SAMPLE
    M1      : M0 + SES
    M2      : M0 + academic
    M3 full : M0 + SES + academic ; academic = ABILITY: COMPOSITE OF ASVAB SCORE + PERCENTILE IN CLASS
  Excluded: Unnamed: 0, CASE ID. "Insignificant" = Wald p > 0.05, also reported with 95% CI + bootstrap.
AUXILIARY grid (effect scale / scaling / block composition) is reported separately: sensitivity only.
"""
import itertools
import numpy as np, pandas as pd, statsmodels.api as sm, warnings
from scipy import stats
warnings.filterwarnings("ignore")
pd.set_option("display.width", 240)
T_HI, T_LO, TOL = 0.5024, 0.0923, 0.0005
RNG = np.random.default_rng(20261024)

df = pd.read_csv("data/nls_ses_processed.csv").rename(columns={
    "ABILITY: COMPOSITE OF ASVAB SCORE": "ABILITY", "PERCENTILE IN CLASS": "PCTILE",
    "FAMILY SIZE OF SAMPLE": "FAMSIZE", "BA DEGREE COMPLETED": "BA"})
df = df.drop(columns=["Unnamed: 0", "CASE ID"])
y = df["BA"].astype(int).astype(float)
D = pd.DataFrame({"Black":    (df.SAMPLE_RACE == "Black").astype(float),
                  "Hispanic": (df.SAMPLE_RACE == "Hispanic").astype(float),
                  "Female":   (df.SAMPLE_SEX == "Female").astype(float),
                  "FAMSIZE":  df.FAMSIZE.astype(float),
                  "SES":      df.SES.astype(float),
                  "ABILITY":  df.ABILITY.astype(float),
                  "PCTILE":   df.PCTILE.astype(float)})
LABEL = {"Black": "SAMPLE_RACE=Black (vs White)", "Hispanic": "SAMPLE_RACE=Hispanic (vs White)",
         "Female": "SAMPLE_SEX=Female (vs Male)", "FAMILY SIZE OF SAMPLE": "FAMILY SIZE OF SAMPLE",
         "SES": "SES", "ABILITY": "ABILITY: COMPOSITE OF ASVAB SCORE", "PCTILE": "PERCENTILE IN CLASS"}
LABEL["FAMSIZE"] = "FAMILY SIZE OF SAMPLE"
ORIGIN, SESB, ACAD = ["Black", "Hispanic", "Female", "FAMSIZE"], ["SES"], ["ABILITY", "PCTILE"]
CAND = ORIGIN + SESB + ACAD
assert D.notna().all().all() and y.notna().all()
print(f"[data] rows={len(df)} missing={int(pd.concat([D,y],axis=1).isna().sum().sum())} "
      f"events={int(y.sum())} ({100*y.mean():.2f}%)")

def logit(cols, yy=y, data=D):
    return sm.GLM(yy, sm.add_constant(data[cols].astype(float)), family=sm.families.Binomial()).fit()

MODELS = {"M0_origin": ORIGIN, "M1_origin+SES": ORIGIN+SESB,
          "M2_origin+academic": ORIGIN+ACAD, "M3_full": ORIGIN+SESB+ACAD}
R = {k: logit(v) for k, v in MODELS.items()}
print("\n===== PRIMARY (raw log-odds): coefficients =====")
print(pd.DataFrame({k: r.params for k, r in R.items()}).round(4).to_string())
print("\n===== PRIMARY: Wald p =====")
print(pd.DataFrame({k: r.pvalues for k, r in R.items()}).round(4).to_string())

rows = []
for v in ORIGIN:
    b0, f0 = R["M0_origin"], R["M3_full"]; ci = f0.conf_int().loc[v]
    rows.append(dict(variable=v, raw_name=LABEL[v], b_base=b0.params[v], p_base=b0.pvalues[v],
                     b_full=f0.params[v], p_full=f0.pvalues[v], ci_lo_95=ci[0], ci_hi_95=ci[1],
                     delta=f0.params[v]-b0.params[v],
                     pct_shrink=100*(1-abs(f0.params[v])/abs(b0.params[v])),
                     sig_base="yes" if b0.pvalues[v] <= .05 else "no",
                     sig_full="yes" if f0.pvalues[v] <= .05 else "no",
                     hit_base=abs(b0.params[v]-T_HI) <= TOL, hit_full=abs(f0.params[v]-T_LO) <= TOL))
prim = pd.DataFrame(rows).sort_values("pct_shrink")
prim.to_csv("out_primary_candidate_table.csv", index=False, float_format="%.4f")
print("\n===== PRIMARY candidate table: M0 -> M3 (raw log-odds) =====")
print(prim.to_string(index=False, float_format=lambda x: f"{x:0.4f}"))
ex = prim[prim.hit_base & prim.hit_full]
print(f"\n[PRIMARY] exact (0.5024->0.0923 within |d|<=5e-4): {list(ex.variable) if len(ex) else 'NONE'}")
nm = prim.assign(err=(prim.b_base-T_HI).abs()+(prim.b_full-T_LO).abs()).sort_values("err")
nm[["variable","b_base","b_full","err","p_base","p_full","sig_base","sig_full","pct_shrink"]] \
  .to_csv("out_primary_nearmisses.csv", index=False, float_format="%.4f")
print("\n[PRIMARY] near misses (|err|):"); print(nm[["variable","b_base","b_full","err"]].to_string(index=False,float_format=lambda x:f"{x:0.4f}"))

# ---- bootstrap (rare event: 2.7%) so 'insignificant' does not rest on Wald alone ----
BOOT = 1500
Xfull = np.column_stack([np.ones(len(D)), D[CAND].astype(float).values])
boot = {v: np.full(BOOT, np.nan) for v in CAND}
for b in range(BOOT):
    idx = RNG.integers(0, len(y), len(y)); yb = y.values[idx]
    if yb.sum() < 20: continue
    try:
        rr = sm.GLM(yb, Xfull[idx], family=sm.families.Binomial()).fit(maxiter=200)
        if not rr.converged or not np.isfinite(rr.params).all(): continue
        for i, nmv in enumerate(CAND): boot[nmv][b] = rr.params[i+1]
    except Exception: pass
bt = pd.DataFrame({v: dict(b_full=R["M3_full"].params[v],
                           wald_lo=R["M3_full"].conf_int().loc[v, 0], wald_hi=R["M3_full"].conf_int().loc[v, 1],
                           boot_lo=np.nanpercentile(boot[v], 2.5), boot_hi=np.nanpercentile(boot[v], 97.5),
                           p_wald=R["M3_full"].pvalues[v],
                           p_boot_two_sided=2*min(np.nanmean(boot[v] <= 0), np.nanmean(boot[v] >= 0)))
                   for v in CAND}).T
print("\n===== PRIMARY: full model M3 inference (Wald + bootstrap 95% CI) =====")
print(bt.round(4).to_string())
bt.to_csv("out_bootstrap_full_model.csv", float_format="%.4f")

# ---- mediation: staged addition ----
print("\n===== MEDIATION (raw log-odds; staged addition of the two blocks) =====")
mrows = []
for v in ORIGIN + SESB + ACAD:
    d = dict(variable=v, raw_name=LABEL[v])
    for k in MODELS:
        if v in R[k].params.index: d[k] = R[k].params[v]; d[k+"_p"] = R[k].pvalues[v]
    if v in ORIGIN:
        d["shift_SES_only"] = R["M1_origin+SES"].params[v]-R["M0_origin"].params[v]
        d["shift_academic_only"] = R["M2_origin+academic"].params[v]-R["M0_origin"].params[v]
        d["shift_both"] = R["M3_full"].params[v]-R["M0_origin"].params[v]
    mrows.append(d)
med = pd.DataFrame(mrows); med.to_csv("out_mediation_table.csv", index=False, float_format="%.4f")
print(med.round(4).to_string())

print("\n===== each candidate alone -> + all others (raw log-odds) =====")
al = pd.DataFrame([dict(variable=v, raw_name=LABEL[v], b_alone=logit([v]).params[v],
                        p_alone=logit([v]).pvalues[v],
                        b_full=logit(CAND).params[v], p_full=logit(CAND).pvalues[v]) for v in CAND])
al.to_csv("out_candidate_alone.csv", index=False, float_format="%.4f")
print(al.round(4).to_string())

# ---- where do the quoted numbers (0.5024 / 0.0923) actually occur? exhaustive scans ----
print("\n===== DIAGNOSTICS: rare-event / separation checks =====")
for k, r in R.items():
    print(f"  {k:20s} converged={r.converged} llf={r.llf:9.3f} max|beta|="
          f"{np.abs(r.params.drop('const')).max():0.3f} max|se|={r.bse.drop('const').max():0.3f}")
for k, r in R.items():
    print(f"  {k:20s} AIC={r.aic:9.2f} BIC={r.bic_llf:9.2f} logLik={r.llf:9.3f}")
print("  nested LR tests (correct nesting):")
for a, b, lab in [("M0_origin","M1_origin+SES","add SES"),
                  ("M0_origin","M2_origin+academic","add academic (2 df)"),
                  ("M2_origin+academic","M3_full","add SES on top of academic"),
                  ("M1_origin+SES","M3_full","add academic on top of SES")]:
    ra, rb_ = R[a], R[b]
    lr = 2*(rb_.llf-ra.llf); dfr = int(rb_.df_model-ra.df_model)
    print(f"   {lab:34s} LRchi2={lr:8.3f} df={dfr} p={stats.chi2.sf(max(lr,0),dfr):.3g}")
ridge = sm.GLM(y, sm.add_constant(D[CAND].astype(float)), family=sm.families.Binomial()) \
        .fit_regularized(alpha=1e-6, L1_wt=0.0)
print("  ridge(alpha=1e-6) full model (Firth-style check; qualitative picture unchanged):")
print("   ", {k: round(v, 4) for k, v in ridge.params.items() if k != "const"})
print("\n===== predictor correlations (mediation channel) =====")
print(D.corr().round(3).to_string()); D.corr().to_csv("out_predictor_correlations.csv", float_format="%.3f")

print("\n===== AUXILIARY GRID (specification sensitivity; NOT the basis of the conclusion) =====")
aux = []
def add(scale, scal_name, bname, fname, rb, rf, keys=None):
    for v in (keys or [k for k in rb.params.index if k != "const"]):
        if v not in rf.params.index: continue
        aux.append(dict(effect_scale=scale, scaling=scal_name, base_model=bname, full_model=fname,
                        variable=v, b_base=rb.params[v], b_full=rf.params[v],
                        p_base=rb.pvalues[v], p_full=rf.pvalues[v],
                        err=abs(rb.params[v]-T_HI)+abs(rf.params[v]-T_LO)))
add("logit_coef", "raw", "M0", "M3", R["M0_origin"], R["M3_full"])
class ORp:
    def __init__(s, r): s.params, s.pvalues = np.exp(r.params), r.pvalues
add("odds_ratio", "raw", "M0", "M3", ORp(R["M0_origin"]), ORp(R["M3_full"]))
DZ = (D-D.mean())/D.std(ddof=0)
add("logit_coef", "all predictors z-scored", "M0", "M3", logit(ORIGIN, data=DZ), logit(CAND, data=DZ))
DZ2 = D.copy()
for c in ["FAMSIZE","SES","ABILITY","PCTILE"]: DZ2[c] = (D[c]-D[c].mean())/D[c].std(ddof=0)
add("logit_coef", "continuous z-scored", "M0", "M3", logit(ORIGIN, data=DZ2), logit(CAND, data=DZ2))
DZ3 = D.copy(); DZ3["ABILITY"] = D.ABILITY/100; DZ3["PCTILE"] = D.PCTILE/100
add("logit_coef", "ABILITY/100 & PCTILE/100", "M0", "M3", logit(ORIGIN, data=DZ3), logit(CAND, data=DZ3))
add("OLS_LPM_coef", "raw", "M0", "M3", sm.OLS(y, sm.add_constant(D[ORIGIN])).fit(),
    sm.OLS(y, sm.add_constant(D[CAND])).fit())
Wraw = (df.SAMPLE_RACE == "White").astype(float).to_frame("White")
add("logit_coef", "pooled White-vs-nonWhite, raw", "White(+Sex+FAMSIZE)", "+SES+academic",
    logit(["Female","FAMSIZE"].__class__(["Female","FAMSIZE"]) if False else ["Female","FAMSIZE"],
          data=D.assign(White=Wraw.values)[["White","Female","FAMSIZE"]].rename(columns={}),
          ) if False else
    sm.GLM(y, sm.add_constant(pd.concat([Wraw.reset_index(drop=True), D[["Female","FAMSIZE"]]],axis=1)),
           family=sm.families.Binomial()).fit(),
    sm.GLM(y, sm.add_constant(pd.concat([Wraw.reset_index(drop=True), D],axis=1)),
           family=sm.families.Binomial()).fit(), keys=["White"])
add("logit_coef", "raw, race-only base (no FAMSIZE/Sex)", "Black+Hispanic", "Black+Hispanic+SES+acad",
    logit(["Black","Hispanic"]), logit(["Black","Hispanic","SES","ABILITY","PCTILE"]))
A = pd.DataFrame(aux); A.to_csv("out_auxiliary_grid.csv", index=False, float_format="%.4f")
print(f"auxiliary cells={len(A)}; exact reproductions of the quoted pair: {int((A.err<=1e-3).sum())}")
print(A.sort_values("err")[["effect_scale","scaling","base_model","full_model","variable",
      "b_base","b_full","p_base","p_full","err"]].head(12).to_string(index=False,float_format=lambda x:f"{x:0.4f}"))

print("\n===== QUALITATIVE robustness (primary spec): significant in M0 -> insignificant in M3 =====")
for v in ORIGIN:
    b0, f0 = R["M0_origin"], R["M3_full"]
    tag = ("LOSES significance" if b0.pvalues[v] <= .05 and f0.pvalues[v] > .05
           else ("keeps significance" if f0.pvalues[v] <= .05 else "not significant in either"))
    print(f"  {LABEL[v]:34s} |b| {abs(b0.params[v]):0.4f} -> {abs(f0.params[v]):0.4f} "
          f"(shrink {100*(1-abs(f0.params[v])/abs(b0.params[v])):6.1f}%)  p {b0.pvalues[v]:0.4f} -> {f0.pvalues[v]:0.4f}  {tag}")
print("\nArtifacts written: out_primary_candidate_table.csv out_primary_nearmisses.csv "
      "out_mediation_table.csv out_candidate_alone.csv out_bootstrap_full_model.csv "
      "out_auxiliary_grid.csv out_predictor_correlations.csv")

# ============ provenance of the quoted numbers: exhaustive nested-pair scan ============
print("\n===== PROVENANCE SCAN: every nested pair (base -> base+SES+academic block) =====")
POOL = [c for c in D.columns if c not in SESB+ACAD] + ["White", "Male"]
DD = D.copy(); DD["White"] = (df.SAMPLE_RACE == "White").astype(float); DD["Male"] = (df.SAMPLE_SEX == "Male").astype(float)
def fitc(cols, data=DD):
    try:
        r = sm.GLM(y, sm.add_constant(data[cols].astype(float)), family=sm.families.Binomial()).fit()
        if r.converged and np.isfinite(r.params).all() and r.bse.max() < 25: return r
    except Exception: pass
    return None
EXTRAS = [["SES","ABILITY","PCTILE"], ["SES","ABILITY"], ["SES","PCTILE"], ["ABILITY","PCTILE"]]
pairs = []
for k in range(1, 7):
    for base in itertools.combinations(POOL, k):
        base = [b for b in base if not (b in ("White","Black","Hispanic") and
                                        {"White","Black","Hispanic"} <= set(base))]
        base = [b for b in base if not (b in ("Female","Male") and "Female" in base and "Male" in base)]
        if not base: continue
        for extra in EXTRAS:
            full = list(base) + [e for e in extra if e not in base]
            rb, rf = fitc(list(base)), fitc(full)
            if rb is None or rf is None: continue
            for v in base:
                pairs.append(dict(base="+".join(base), added="+".join(extra), variable=v,
                    b_base=rb.params[v], p_base=rb.pvalues[v], b_full=rf.params[v], p_full=rf.pvalues[v],
                    ratio=rf.params[v]/rb.params[v] if rb.params[v] != 0 else np.nan,
                    err_signed=abs(rb.params[v]-T_HI)+abs(rf.params[v]-T_LO),
                    err_abs=abs(abs(rb.params[v])-T_HI)+abs(abs(rf.params[v])-T_LO)))
PS = pd.DataFrame(pairs); PS.to_csv("out_number_provenance_scan.csv", index=False, float_format="%.4f")
print(f"nested pairs scanned = {len(PS)}   exact signed match (<=1e-3): {int((PS.err_signed<=1e-3).sum())}"
      f"   exact |.| match (<=1e-3): {int((PS.err_abs<=1e-3).sum())}")
print("\nbest absolute-magnitude matches:")
print(PS.sort_values("err_abs").head(8)[["base","added","variable","b_base","p_base","b_full","p_full","ratio","err_abs"]]
      .to_string(index=False, float_format=lambda x: f"{x:0.4f}"))
print("\nbest matches whose SECOND value is within 0.002 of 0.0923:")
Qq = PS[(PS.b_full.abs()-T_LO).abs() <= 0.002].copy(); Qq["dbase"] = (PS.b_base.abs()-T_HI).abs()
print(Qq.sort_values("dbase").head(6)[["base","added","variable","b_base","p_base","b_full","p_full","err_abs"]]
      .to_string(index=False, float_format=lambda x: f"{x:0.4f}"))

print("\n===== VERDICT (primary spec, raw log-odds, n=8773) =====")
b0, f3 = R["M0_origin"], R["M3_full"]
for v in ORIGIN:
    print(f"  {LABEL[v]:34s} |b| {abs(b0.params[v]):0.4f} -> {abs(f3.params[v]):0.4f}  "
          f"p {b0.pvalues[v]:0.4f} -> {f3.pvalues[v]:0.4f}")
print("\n  Race gap without FAMILY SIZE in the model (raw logit):")
rb = logit(["Black","Hispanic"]); rf = logit(["Black","Hispanic","SES","ABILITY","PCTILE"])
print(f"   Black   : {rb.params['Black']:0.4f} (p={rb.pvalues['Black']:.4g}) -> {rf.params['Black']:0.4f} (p={rf.pvalues['Black']:.4f})"
      f"   |b| shrinks {100*(1-abs(rf.params['Black'])/abs(rb.params['Black'])):.1f}%")
rb2 = logit(["Black","Hispanic","Female","FAMSIZE"]); rf2 = logit(CAND)
print(f"   Hispanic: {rb2.params['Hispanic']:0.4f} (p={rb2.pvalues['Hispanic']:.4g}) -> {rf2.params['Hispanic']:0.4f} (p={rf2.pvalues['Hispanic']:.4f})")
mcs = {}
_null = sm.GLM(y, np.ones((len(y), 1)), family=sm.families.Binomial()).fit()
for k, r in R.items(): mcs[k] = 1 - r.llf/_null.llf
print("\n   McFadden pseudo-R2 of the null model = %.4f" % (1-_null.llf/_null.llf))
print("   McFadden pseudo-R2:", {k: round(v, 4) for k, v in mcs.items()})
