"""Stage 1 inspection of data/nls_ses_processed.csv (no modelling, no inference)."""
import re
import pandas as pd, numpy as np

PATH = 'data/nls_ses_processed.csv'
df = pd.read_csv(PATH, index_col=0)
num = ['FAMILY SIZE OF SAMPLE', 'ABILITY: COMPOSITE OF ASVAB SCORE',
       'PERCENTILE IN CLASS', 'SES']

print("shape (records x variables, excl. unnamed row-index col):", df.shape)
print("columns:", list(df.columns))
print("\ndtypes:\n", df.dtypes)
print("\nmissing per column:\n", df.isna().sum())
print("\nCASE ID unique:", df['CASE ID'].is_unique, "| n unique:", df['CASE ID'].nunique(),
      "| range:", df['CASE ID'].min(), "-", df['CASE ID'].max())
print("duplicate rows (ignoring IDs):", df.drop(columns=['CASE ID']).duplicated().sum())

for c in ['SAMPLE_RACE', 'SAMPLE_SEX', 'BA DEGREE COMPLETED']:
    print(f"\n--- {c}\n", df[c].value_counts(dropna=False))

print("\nnumeric summary:\n", df[num].agg(['count','mean','std','min','median','max']).T.round(4))
print("\nquantiles SES:\n", df['SES'].quantile([0,.05,.25,.5,.75,.95,1]).round(4))
print("\nquantiles ABILITY:\n", df['ABILITY: COMPOSITE OF ASVAB SCORE'].quantile([0,.05,.25,.5,.75,.95,1]))
print("\nskew/kurtosis:\n", df[num].skew().round(3), df[num].kurtosis().round(3))

# sentinel / blank scan on the raw text
toks = re.findall(r'[^,\r\n]+', open(PATH).read())
sent = [t for t in toks if t.strip().upper() in
        {'','NA','N/A','NAN','NULL','NONE','-1','-9','-99','-999','999','9999','99999','?','??','*','.'}]
from collections import Counter
print("\nraw-text sentinel/blank token counts:", Counter(sent))
print("trailing empty fields:", open(PATH).read().count(',\r\n'))
for lo, hi in [(-np.inf,0),(0,1),(99,101),(101,np.inf)]:
    print(f"PERCENTILE in ({lo},{hi}):", int(((df['PERCENTILE IN CLASS']>lo)&(df['PERCENTILE IN CLASS']<hi)).sum()))
print("ABILITY outside [0,100] (i.e. raw sum scale, not a percentile):",
      int((df['ABILITY: COMPOSITE OF ASVAB SCORE']>100).sum()))

# descriptive (non-inferential) diagnostics
df['deg'] = df['BA DEGREE COMPLETED'].astype(int)
print("\ncompletion by race:\n", df.groupby('SAMPLE_RACE')['deg'].agg(['size','sum','mean']).round(4))
print("\ncompletion by sex:\n", df.groupby('SAMPLE_SEX')['deg'].agg(['size','sum','mean']).round(4))
print("\nmeans by race:\n", df.groupby('SAMPLE_RACE')[num+['deg']].mean().round(3))
print("\nPearson corr:\n", df[['deg']+num].corr().round(3))
q = pd.qcut(df['PERCENTILE IN CLASS'], 5, labels=[1,2,3,4,5])
print("\ndirection diagnostic - mean ABILITY/SES/degree by PERCENTILE quintile:\n",
      df.groupby(q, observed=True)[['ABILITY: COMPOSITE OF ASVAB SCORE','SES','deg']].mean().round(3))
q2 = pd.qcut(df['SES'], 5, labels=[1,2,3,4,5])
print("\nmean PERCENTILE by SES quintile:\n", df.groupby(q2, observed=True)['PERCENTILE IN CLASS'].mean().round(2))
sq = pd.qcut(df['SES'], 4, labels=['Q1','Q2','Q3','Q4'])
print("\nevents and cell sizes, race x SES quartile:\n",
      pd.crosstab(df.SAMPLE_RACE, sq, values=df.deg, aggfunc='sum').fillna(0), "\n",
      pd.crosstab(df.SAMPLE_RACE, sq))
print("\npromised academic-resource variables present? test scores:",
      'ABILITY: COMPOSITE OF ASVAB SCORE' in df.columns, "| class rank:", 'PERCENTILE IN CLASS' in df.columns,
      "| curriculum:", any('CURRIC' in c.upper() or 'CREDIT' in c.upper() or 'COURSE' in c.upper() for c in df.columns))
