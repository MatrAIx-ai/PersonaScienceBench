"""
Stage 2: fitted models for
"Is the relation between SES and chances of degree completion affected by racial lines?"

Pre-specified design (approved by researcher):
  outcome : BA DEGREE COMPLETED (binary) -> logistic regression
  exposure: SES standardised to SD = 1 (primary, linear); quartile dummies as sensitivity
  race    : 3-level factor, WHITE = reference (largest group, 189/236 events)
  nesting : main-effects model vs + SES:RACE, 2 df -- LRT is the PRIMARY criterion
  two estimands kept SEPARATE (researcher condition 1):
      TOTAL effect      : adjusted for ability, sex, family size          <-- headline
      PARTIALLY DIRECT  : additionally adjusted for PERCENTILE IN CLASS   <-- companion
  robust HC1 SEs for all Wald tests and CIs
  robustness: Firth penalised likelihood, categorical SES, curvature check,
              alternative reference, pooled-minority contrast, stratified fits,
              one-cell influence check
PERCENTILE IN CLASS is NOT re-signed after seeing results (condition 4).
"""
import numpy as np, pandas as pd
import statsmodels.api as sm
from scipy import stats, optimize

pd.set_option('display.width', 220); pd.set_option('display.max_columns', 40)
OUT = []
def say(*a):
    s = " ".join(str(x) for x in a); print(s); OUT.append(s)

# ------------------------------------------------------------------ data
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['deg'] = df['BA DEGREE COMPLETED'].astype(int)
a_col = 'ABILITY: COMPOSITE OF ASVAB SCORE'
df['ses_z'] = (df.SES - df.SES.mean())/df.SES.std()
df['abl_z'] = (df[a_col] - df[a_col].mean())/df[a_col].std()
df['pct_z'] = (df['PERCENTILE IN CLASS'] - df['PERCENTILE IN CLASS'].mean())/df['PERCENTILE IN CLASS'].std()
df['female'] = (df.SAMPLE_SEX == 'Female').astype(float)
df['fam'] = df['FAMILY SIZE OF SAMPLE'].astype(float)
df['black'] = (df.SAMPLE_RACE == 'Black').astype(float)
df['hisp']  = (df.SAMPLE_RACE == 'Hispanic').astype(float)      # White = reference
df['s_blk'] = df.ses_z*df.black
df['s_hsp'] = df.ses_z*df.hisp
df['sesq']  = pd.qcut(df.SES, 4, labels=['Q1','Q2','Q3','Q4'])
say(f"N = {len(df)}, events = {df.deg.sum()} ({df.deg.mean()*100:.2f}%); "
    f"complete cases on model variables = {int(df[['deg','ses_z','abl_z','pct_z','female','fam']].notna().all(1).sum())}")
say("SD of raw SES = %.4f  (1 unit of ses_z = %.4f raw SES units)" % (df.SES.std(), df.SES.std()))

def fit(cols, data=None):
    d = df if data is None else data
    X = sm.add_constant(d[cols].astype(float), has_constant='add')
    return sm.Logit(d.deg.astype(float), X).fit(disp=0, maxiter=300), X

def table(res, label):
    ci = res.conf_int()
    t = pd.DataFrame({'beta': res.params, 'se_HC1': res.bse, 'OR': np.exp(res.params),
                      'OR_lo95': np.exp(ci[0]), 'OR_hi95': np.exp(ci[1]),
                      'z': res.tvalues, 'p': res.pvalues}).round(4)
    say(f"\n### {label}   [logit, robust HC1 SEs; n={int(res.nobs)}, llf={res.llf:.3f}, AIC={res.aic:.3f}]")
    say(t.to_string())
    return t

def lrtest(rs, rb, dfdiff=None, label=""):
    dd = int(rb.df_model - rs.df_model) if dfdiff is None else dfdiff
    chi2 = 2*(rb.llf - rs.llf); p = stats.chi2.sf(chi2, dd)
    say(f"\n>> LRT {label}: chi2({dd}) = {chi2:.3f}, p = {p:.5g} | dAIC (main - interaction) = "
        f"{rs.aic - rb.aic:+.3f}  [interaction favoured if >= +2]")
    return chi2, dd, p

def wald(res, terms, label=""):
    R = np.zeros((len(terms), len(res.params)))
    for i, t in enumerate(terms): R[i, list(res.params.index).index(t)] = 1.0
    b = R.dot(res.params); V = R.dot(np.asarray(res.cov_params())).dot(R.T)
    chi2 = float(b.dot(np.linalg.solve(V, b))); p = stats.chi2.sf(chi2, len(terms))
    say(f">> Wald joint test {label}: chi2({len(terms)}) = {chi2:.3f}, p = {p:.5g}")
    return chi2, len(terms), p

def slopes(res, label):
    rows = []
    for nm, con in [('White','ses_z'), ('Black','ses_z + s_blk'), ('Hispanic','ses_z + s_hsp')]:
        tt = res.t_test(con)
        est = float(np.ravel(tt.effect)[0]); se = float(np.ravel(tt.sd)[0])
        rows.append([nm, est, se, est-1.96*se, est+1.96*se, 2*stats.norm.sf(abs(est/se)),
                     np.exp(est), np.exp(est-1.96*se), np.exp(est+1.96*se)])
    t = pd.DataFrame(rows, columns=['race','slope_logodds_perSD','se','lo95','hi95','p',
                                    'OR_perSD','OR_lo95','OR_hi95']).round(4)
    say(f"\n### Race-specific SES slopes (odds ratio of degree completion per +1 SD SES) -- {label}")
    say(t.to_string(index=False))
    return t

def gcomp(res, cols, label, ses_vals=(-1.0, 0.0, 1.0)):
    rows = []
    for race in ['White','Black','Hispanic']:
        sub = df[df.SAMPLE_RACE == race].copy()
        for v in ses_vals:
            s = sub.copy(); s['ses_z'] = v
            s['s_blk'] = v*s.black; s['s_hsp'] = v*s.hisp
            for c in cols:
                if c.startswith('q') and c[1:3] in ('Q2','Q3','Q4'):
                    s[c] = 1.0 if (c[1:3] == 'Q1') else 0.0
            X = sm.add_constant(s[cols].astype(float), has_constant='add')
            pr = np.asarray(res.predict(X))
            rows.append([race, v, len(s), pr.mean(), pr.mean()*(1-pr.mean())/len(s)])
    t = pd.DataFrame(rows, columns=['race','ses_z','n','pred_prob','var'])
    t['pct'] = (t.pred_prob*100).round(2); t['se_pct'] = (np.sqrt(t['var'])*100).round(2)
    say(f"\n### Marginal predicted probability of BA degree at SES = -1/0/+1 SD, "
        f"other covariates standardised within each race -- {label}")
    say(t[['race','ses_z','n','pct','se_pct']].round(2).to_string(index=False))
    piv = t.pivot(index='ses_z', columns='race', values='pred_prob')[['White','Black','Hispanic']]
    say("  risk differences vs White (percentage points):")
    say((piv.sub(piv['White'], axis=0)*100).round(2).to_string())
    return t

C_TOT = ['ses_z','black','hisp','abl_z','female','fam']
C_TOI = C_TOT + ['s_blk','s_hsp']
C_PDT = C_TOT + ['pct_z']; C_PDI = C_PDT + ['s_blk','s_hsp']

say("\n"+"="*100); say("SECTION 1 -- CRUDE (unadjusted for anything)")
m0,_ = fit(['ses_z']);                        table(m0, 'M0  deg ~ SES')
m1,_ = fit(['ses_z','black','hisp']);         table(m1, 'M1  deg ~ SES + RACE')
m2,_ = fit(['ses_z','black','hisp','s_blk','s_hsp']);      table(m2, 'M2  deg ~ SES * RACE')
lr1 = lrtest(m1, m2, label='M2 vs M1, crude (2 df)')
w1 = wald(m2, ['s_blk','s_hsp'], 'SES:RACE, crude')
sl_crude = slopes(m2, 'CRUDE')

say("\n"+"="*100); say("SECTION 2 -- TOTAL EFFECT: adjusted for ability, sex, family size ONLY   <<< HEADLINE ESTIMAND")
a1,_ = fit(C_TOT);  table(a1, 'A1  TOTAL, main effects: deg ~ SES + RACE + ability + sex + family size')
a2,_ = fit(C_TOI);  table(a2, 'A2  TOTAL, interaction: A1 + SES:RACE')
lrA = lrtest(a1, a2, label='A2 vs A1, TOTAL effect (2 df)   *** PRIMARY PRE-SPECIFIED CRITERION ***')
wA = wald(a2, ['s_blk','s_hsp'], 'SES:RACE, total-effect model')
sl_tot = slopes(a2, 'TOTAL effect')
gA  = gcomp(a2, C_TOI, 'TOTAL effect, interaction model')
gA0 = gcomp(a1, C_TOT, 'TOTAL effect, main-effects model')

say("\n"+"="*100); say("SECTION 3 -- PARTIALLY DIRECT EFFECT (companion): adds PERCENTILE IN CLASS, a plausible mediator")
b1,_ = fit(C_PDT);  table(b1, 'B1  DIRECT, main effects: A1 + class percentile')
b2,_ = fit(C_PDI);  table(b2, 'B2  DIRECT, interaction: B1 + SES:RACE')
lrB = lrtest(b1, b2, label='B2 vs B1, partially direct (2 df)')
wB = wald(b2, ['s_blk','s_hsp'], 'SES:RACE, percentile-adjusted model')
sl_dir = slopes(b2, 'PARTIALLY DIRECT effect')
gB = gcomp(b2, C_PDI, 'PARTIALLY DIRECT effect, interaction model')
say(f"\n  SIGN CHECK on PERCENTILE IN CLASS: beta = {b2.params['pct_z']:+.4f} "
    f"(OR {np.exp(b2.params['pct_z']):.3f} per +1 SD, p = {b2.pvalues['pct_z']:.3g}). Positive, i.e. a higher "
    f"percentile raises the chance of a degree -> behaves as 'higher percentile = better class standing'. "
    f"Variable was NOT re-signed (condition 4).")

say("\n"+"="*100); say("SECTION 4 -- THE TWO ESTIMANDS SIDE BY SIDE (never merged)")
comp = pd.DataFrame(
    {'model_pair': ['M1 -> M2', 'A1 -> A2', 'B1 -> B2'],
     'estimand': ['crude', 'TOTAL (headline)', 'PARTIALLY DIRECT (companion)'],
     'LRT_chi2_2df': [lr1[0], lrA[0], lrB[0]], 'LRT_p': [lr1[2], lrA[2], lrB[2]],
     'dAIC_main_minus_int': [m1.aic-m2.aic, a1.aic-a2.aic, b1.aic-b2.aic],
     'Wald_chi2_2df': [w1[0], wA[0], wB[0]], 'Wald_p': [w1[2], wA[2], wB[2]]}).round(5)
say(comp.to_string(index=False))
say("\nSES slope per +1 SD by race, both estimands:")
say(pd.concat([sl_tot.assign(estimand='TOTAL'), sl_dir.assign(estimand='DIRECT')])[
    ['estimand','race','slope_logodds_perSD','se','lo95','hi95','p','OR_perSD','OR_lo95','OR_hi95']
    ].to_string(index=False))

say("\n"+"="*100); say("SECTION 5 -- FIRTH PENALISED LIKELIHOOD (robustness for sparse events)")
def firth_fit(cols, label):
    X = np.asarray(sm.add_constant(df[cols].astype(float), has_constant='add'), float)
    y = df.deg.values.astype(float); k = X.shape[1]
    def nll(b):
        eta = np.clip(X.dot(b), -35, 35); p = 1/(1+np.exp(-eta)); w = p*(1-p) + 1e-10
        ll = float(np.sum(y*np.log(np.clip(p,1e-300,1)) + (1-y)*np.log(np.clip(1-p,1e-300,1))))
        I = (X*w[:,None]).T.dot(X) + 1e-10*np.eye(k)
        sgn, ld = np.linalg.slogdet(I)
        return -(ll + 0.5*ld) if sgn > 0 else 1e12
    r = optimize.minimize(nll, np.zeros(k), method='BFGS', options={'gtol':1e-6,'maxiter':1000})
    b = r.x; eta = np.clip(X.dot(b), -35, 35); p = 1/(1+np.exp(-eta)); w = p*(1-p)
    I = (X*w[:,None]).T.dot(X) + 1e-10*np.eye(k)
    V = np.linalg.inv(I); se = np.sqrt(np.diag(V))
    ll = float(np.sum(y*np.log(p) + (1-y)*np.log(1-p))) + 0.5*np.linalg.slogdet(I)[1]
    t = pd.DataFrame({'beta': b, 'se': se, 'OR': np.exp(b), 'OR_lo95': np.exp(b-1.96*se),
                      'OR_hi95': np.exp(b+1.96*se), 'z': b/se, 'p': 2*stats.norm.sf(np.abs(b/se))},
                     index=list(sm.add_constant(df[cols].astype(float), has_constant='add').columns)).round(4)
    say(f"\n### FIRTH, {label}: penalised loglik = {ll:.4f}, converged = {r.success}")
    say(t.to_string())
    return b, V, ll, t
fb, Vb, ll1, t1f = firth_fit(C_TOT,  'total-effect MAIN EFFECTS (A1)')
fi, Vi, ll2, t2f = firth_fit(C_TOI, 'total-effect INTERACTION (A2)')
chi2f = 2*(ll2-ll1); pff = stats.chi2.sf(chi2f, 2)
say(f"\n>> FIRTH penalised LRT, SES:RACE (total effect, 2 df): chi2 = {chi2f:.3f}, p = {pff:.5g}")
say("   Firth race-specific SES slopes (OR per +1 SD):")
names = list(t2f.index)
for nm, extra in [('White', None), ('Black','s_blk'), ('Hispanic','s_hsp')]:
    c = np.zeros(len(names)); c[names.index('ses_z')] = 1
    if extra: c[names.index(extra)] = 1
    est = float(c.dot(fi)); se = float(np.sqrt(c.dot(Vi).dot(c)))
    say(f"     {nm:9s}: log-odds {est:+.4f} (se {se:.4f}), OR {np.exp(est):.3f} "
        f"[{np.exp(est-1.96*se):.3f}, {np.exp(est+1.96*se):.3f}], p = {2*stats.norm.sf(abs(est/se)):.4f}")

say("\n"+"="*100); say("SECTION 6 -- PRE-SPECIFIED SENSITIVITY ANALYSES")
for d in ['Q2','Q3','Q4']: df['q'+d] = (df.sesq == d).astype(float)
qcols = ['qQ2','qQ3','qQ4','black','hisp','abl_z','female','fam']
aq1,_ = fit(qcols); table(aq1, 'A1cat TOTAL: deg ~ SES quartiles (ref Q1) + RACE + covariates')
for d, tag in [('Q2','q2'), ('Q3','q3'), ('Q4','q4')]:
    df[f'{tag}_bk'] = df['q'+d]*df.black; df[f'{tag}_hp'] = df['q'+d]*df.hisp
qint = qcols + ['q2_bk','q3_bk','q4_bk','q2_hp','q3_hp','q4_hp']
aq2,_ = fit(qint); table(aq2, 'A2cat TOTAL: deg ~ SES quartiles x RACE + covariates')
lrC = lrtest(aq1, aq2, dfdiff=6, label='CATEGORICAL SES x RACE (6 df)')
df['ses2'] = df.ses_z**2
df['s2_blk'] = df.ses2*df.black; df['s2_hsp'] = df.ses2*df.hisp
anl,_ = fit(C_TOI+['ses2'])
say(f"\n  curvature within White reference: beta(SES^2) = {anl.params['ses2']:+.4f}, p = {anl.pvalues['ses2']:.4f}")
a3,_ = fit(C_TOI+['ses2','s2_blk','s2_hsp'])
lrD = lrtest(anl, a3, dfdiff=2, label='SES^2 x RACE, differences in curvature (2 df)')
df['white'] = 1 - df.black - df.hisp; df['s_w'] = df.ses_z*df.white; df['h_w'] = df.hisp
ar1,_ = fit(['ses_z','white','h_w','abl_z','female','fam'])
ar2,_ = fit(['ses_z','white','h_w','s_w','s_hsp','abl_z','female','fam'])
lrE = lrtest(ar1, ar2, label='replication with BLACK as reference (should reproduce the same LRT)')
df['minority'] = 1 - df.white; df['s_min'] = df.ses_z*df.minority
p1,_ = fit(['ses_z','minority','abl_z','female','fam'])
p2,_ = fit(['ses_z','minority','s_min','abl_z','female','fam'])
table(p2, 'POOLED minority vs White with SES x minority (labelled sensitivity only)')
lrF = lrtest(p1, p2, label='pooled-minority SES interaction (1 df)')
say("\n### Stratified logistic fits within each race (total-effect covariates) -- descriptive cross-check")
for race in ['White','Black','Hispanic']:
    sub = df[df.SAMPLE_RACE == race]
    rr = sm.Logit(sub.deg.astype(float), sm.add_constant(sub[['ses_z','abl_z','female','fam']].astype(float),
                  has_constant='add')).fit(disp=0, maxiter=300)
    ci = rr.conf_int()
    say(f"  {race:9s} n={int(rr.nobs):5d} events={int(sub.deg.sum()):4d} | SES per SD: beta={rr.params['ses_z']:+.4f} "
        f"se={rr.bse['ses_z']:.4f} p={rr.pvalues['ses_z']:.4f} | OR={np.exp(rr.params['ses_z']):.3f} "
        f"[{np.exp(ci.loc['ses_z',0]):.3f}, {np.exp(ci.loc['ses_z',1]):.3f}]")
drop = (df.SAMPLE_RACE=='Hispanic') & (df.sesq=='Q4') & (df.deg==1)
d2 = df[~drop]; inf_i = fit(C_TOI, data=d2)[0]; inf_m = fit(C_TOT, data=d2)[0]
chi2i = 2*(inf_i.llf-inf_m.llf)
say(f"\n### INFLUENCE check: total-effect model excluding the {int(drop.sum())} Hispanic / top-SES-quartile / degree holders")
say(f"  LRT(2 df) = {chi2i:.3f}, p = {stats.chi2.sf(chi2i,2):.4g} | White slope {inf_i.params['ses_z']:+.4f} "
    f"(full data {a2.params['ses_z']:+.4f}); Hispanic slope {inf_i.params['ses_z']+inf_i.params['s_hsp']:+.4f} "
    f"(full data {a2.params['ses_z']+a2.params['s_hsp']:+.4f})")
df['ses_fem'] = df.ses_z*df.female
sx,_ = fit(C_TOI+['ses_fem'])
say(f"\n### EXPLORATORY (not part of the primary test): SES x sex interaction beta = {sx.params['ses_fem']:+.4f}, "
    f"p = {sx.pvalues['ses_fem']:.4f}")
say(f"\n### Absolute-scale summary, TOTAL-effect interaction model (from marginal probabilities above):")
pv = gA.pivot(index='ses_z', columns='race', values='pct')[['White','Black','Hispanic']]
say((pv.assign(White_gradient=pv.White.iloc[-1]-pv.White.iloc[0],
               Black_gradient=pv.Black.iloc[-1]-pv.Black.iloc[0],
               Hispanic_gradient=pv.Hispanic.iloc[-1]-pv.Hispanic.iloc[0])).round(2).iloc[-1:].to_string())

comp.to_csv('analysis/results_interaction_tests.csv', index=False)
for nm, t in [('coef_crude_interaction',m2),('coef_total_main',a1),('coef_total_interaction',a2),
              ('coef_direct_main',b1),('coef_direct_interaction',b2)]:
    ci = t.conf_int()
    pd.DataFrame({'beta':t.params,'se_HC1':t.bse,'OR':np.exp(t.params),'OR_lo95':np.exp(ci[0]),
                  'OR_hi95':np.exp(ci[1]),'z':t.tvalues,'p':t.pvalues}).round(5).to_csv(f'analysis/results_{nm}.csv')
for nm, t in [('slopes_crude',sl_crude),('slopes_total',sl_tot),('slopes_direct',sl_dir)]:
    t.to_csv(f'analysis/results_{nm}.csv', index=False)
gA.to_csv('analysis/results_marginal_probs_total_interaction.csv', index=False)
gA0.to_csv('analysis/results_marginal_probs_total_maineffects.csv', index=False)
gB.to_csv('analysis/results_marginal_probs_direct_interaction.csv', index=False)
t2f.to_csv('analysis/results_firth_total_interaction.csv')
open('analysis/02_model_output.txt','w').write("\n".join(OUT))
say("\nSaved tables: analysis/results_*.csv ; full log: analysis/02_model_output.txt")
