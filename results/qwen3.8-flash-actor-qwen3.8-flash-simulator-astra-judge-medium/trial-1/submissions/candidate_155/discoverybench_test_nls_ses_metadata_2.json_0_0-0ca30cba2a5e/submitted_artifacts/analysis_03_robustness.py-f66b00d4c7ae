"""
Stage 3: corrections and robustness for the SES x RACE interaction test.

(a) Firth penalised fit re-done with a reliable optimiser (BFGS on the penalised
    log-likelihood, convergence verified on the gradient). SEs from the penalised
    information (X'WX)^-1 at the penalised estimate, as in logistf. A WALD test on the
    two interaction terms is used. The penalised LIKELIHOOD-RATIO statistic is reported
    but NOT compared with chi2: the penalty 0.5*log|I(beta)| does not cancel between
    nested models of different dimension, so it is not chi2-calibrated here.
(b) Parametric (model-based) bootstrap of the LRT for SES:RACE under the main-effects
    null -- the appropriate finite-sample reference when events are few (236/8,773).
(c) Minimum detectable slope difference (an explicit power statement).
(d) Why the crude interaction (p=.008) vanishes after adjustment.
(e) Race as a LEVEL difference: how the race terms move under adjustment.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats, optimize
np.random.seed(20261022)
OUT=[]
def say(*a):
    s=" ".join(str(x) for x in a); print(s); OUT.append(s)

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['deg'] = df['BA DEGREE COMPLETED'].astype(int)
ac='ABILITY: COMPOSITE OF ASVAB SCORE'
df['ses_z']=(df.SES-df.SES.mean())/df.SES.std()
df['abl_z']=(df[ac]-df[ac].mean())/df[ac].std()
df['female']=(df.SAMPLE_SEX=='Female').astype(float); df['fam']=df['FAMILY SIZE OF SAMPLE'].astype(float)
df['black']=(df.SAMPLE_RACE=='Black').astype(float); df['hisp']=(df.SAMPLE_RACE=='Hispanic').astype(float)
df['s_blk']=df.ses_z*df.black; df['s_hsp']=df.ses_z*df.hisp
C_TOT=['ses_z','black','hisp','abl_z','female','fam']; C_TOI=C_TOT+['s_blk','s_hsp']
CR=['ses_z','black','hisp']; CRI=CR+['s_blk','s_hsp']
Xm=sm.add_constant(df[C_TOT],has_constant='add').values.astype(float)
Xi=sm.add_constant(df[C_TOI],has_constant='add').values.astype(float)
nm=list(sm.add_constant(df[C_TOI],has_constant='add').columns)
y=df.deg.values.astype(float)

say("="*100); say("(a) FIRTH penalised likelihood, optimiser checked")
def firth(X,y):
    def nll(b):
        e=np.clip(X@b,-35,35); p=1/(1+np.exp(-e)); w=np.maximum(p*(1-p),1e-12)
        ll=float(np.sum(y*np.log(np.clip(p,1e-300,1))+(1-y)*np.log(np.clip(1-p,1e-300,1))))
        I=(X*w[:,None]).T@X + 1e-9*np.eye(X.shape[1]); sg,ld=np.linalg.slogdet(I)
        return -(ll+0.5*ld) if sg>0 else 1e12
    r=optimize.minimize(nll,np.zeros(X.shape[1]),method='BFGS',
                        options={'gtol':1e-7,'maxiter':2000})
    b=r.x; e=np.clip(X@b,-35,35); p=1/(1+np.exp(-e)); w=np.maximum(p*(1-p),1e-12)
    I=(X*w[:,None]).T@X+1e-9*np.eye(X.shape[1]); V=np.linalg.inv(I)
    ll=float(np.sum(y*np.log(p)+(1-y)*np.log(1-p)))+0.5*np.linalg.slogdet(I)[1]
    # analytic penalised score to verify the optimum
    g=X.T@(y-p); inv=V
    for j in range(X.shape[1]):
        d=(X*(X[:,j]*w*(1-p))[:,None]).T@X
        g[j]+=0.5*np.trace(inv@(d+d.T))
    return b,V,ll,np.max(np.abs(g)),r.success
bm,Vm,llm,gm,okm=firth(Xm,y); bi,Vi,lli,gi,oki=firth(Xi,y)
say(f"  main-effects : max|analytic penalised score| = {gm:.3e}   BFGS success = {okm}")
say(f"  interaction  : max|analytic penalised score| = {gi:.3e}   BFGS success = {oki}")
for lbl,b,V in [('main effects',bm,Vm),('interaction',bi,Vi)]:
    se=np.sqrt(np.diag(V))
    t=pd.DataFrame({'beta':b,'se':se,'OR':np.exp(b),'OR_lo95':np.exp(b-1.96*se),'OR_hi95':np.exp(b+1.96*se),
                    'z':b/se,'p':2*stats.norm.sf(np.abs(b/se))}, index=nm[:len(b)]).round(4)
    say(f"  FIRTH {lbl}:\n"+t.to_string())
R=np.zeros((2,len(bi))); R[0,nm.index('s_blk')]=1; R[1,nm.index('s_hsp')]=1
bb=R@bi; c2=float(bb@np.linalg.solve(R@Vi@R.T,bb)); p2=stats.chi2.sf(c2,2)
say(f"  FIRTH WALD test on the two interaction terms (penalised information): chi2(2) = {c2:.3f}, p = {p2:.4f}")
say(f"  Penalised LR statistic 2(l*_int - l*_main) = {2*(lli-llm):.3f}. REPORTED, NOT INFERENTIAL: the "
    f"penalty 0.5*log|I| does not cancel between models of different dimension.")
for lbl,extra in [('White',None),('Black','s_blk'),('Hispanic','s_hsp')]:
    c=np.zeros(len(bi)); c[nm.index('ses_z')]=1
    if extra: c[nm.index(extra)]=1
    e=float(c@bi); s=float(np.sqrt(c@Vi@c))
    say(f"    Firth SES slope {lbl:9s}: {e:+.4f} (se {s:.4f})  OR {np.exp(e):.3f} "
        f"[{np.exp(e-1.96*s):.3f}, {np.exp(e+1.96*s):.3f}]  p = {2*stats.norm.sf(abs(e/s)):.4f}")

say("\n"+"="*100); say("(b) PARAMETRIC BOOTSTRAP of the LRT for SES:RACE under the MAIN-EFFECTS null")
def ll_of(X,yy):
    return sm.Logit(yy, X).fit(disp=0, maxiter=300)
m1=ll_of(Xm,y); m2=ll_of(Xi,y); obs=2*(m2.llf-m1.llf)
pnull=np.asarray(m1.predict(Xm))
B=800; sims=np.full(B,np.nan)
for b in range(B):
    yb=(np.random.rand(len(pnull))<pnull).astype(float)
    if yb.sum()<10: continue
    try:
        a=ll_of(Xm,yb); c=ll_of(Xi,yb); sims[b]=2*(c.llf-a.llf)
    except Exception: pass
ok=sims[~np.isnan(sims)]
pv=(np.sum(ok>=obs)+1)/(len(ok)+1)
say(f"  TOTAL effect model: observed LRT(2 df) = {obs:.3f}")
say(f"  parametric-bootstrap p-value (B={len(ok)}) = {pv:.4f}")
say(f"  simulated null distribution of LRT: mean {ok.mean():.3f}, median {np.median(ok):.3f}, "
    f"90th pct {np.percentile(ok,90):.3f}, 95th pct {np.percentile(ok,95):.3f}  "
    f"[theoretical chi2(2): mean 2.000, 95th pct 5.991]")
say("  => the asymptotic chi2(2) reference is a good approximation here; the pre-specified test stands.")

say("\n"+"="*100); say("(c) MINIMUM DETECTABLE SLOPE DIFFERENCE (explicit power statement)")
rn = sm.Logit(y, sm.add_constant(df[C_TOI].astype(float), has_constant='add')).fit(disp=0)
Vn = rn.cov_params()
def sd_slope(extra):
    if extra is None: return float(np.sqrt(Vn.loc['ses_z','ses_z']))
    return float(np.sqrt(Vn.loc['ses_z','ses_z'] + Vn.loc[extra,extra] + 2*Vn.loc['ses_z',extra]))
sW = sd_slope(None); sB = sd_slope('s_blk'); sH = sd_slope('s_hsp')
for lbl, sd in [('Black - White  ', np.sqrt(max(sB**2-sW**2,0))), ('Hispanic - White', np.sqrt(max(sH**2-sW**2,0)))]:
    mde = (1.959964+0.841621)*sd
    say(f"  {lbl}: se(difference of slopes) = {sd:.4f} -> smallest difference detectable with 80% power "
        f"(alpha=.05, two-sided) = {mde:.3f} log-odds per SD, i.e. an odds-ratio RATIO of at least {np.exp(mde):.2f}")
say(f"  observed interaction terms: Black x SES = {rn.params['s_blk']:+.4f} (p = {rn.pvalues['s_blk']:.3f}), "
    f"Hispanic x SES = {rn.params['s_hsp']:+.4f} (p = {rn.pvalues['s_hsp']:.3f})")
say(f"  race-specific slopes: White {rn.params['ses_z']:+.4f} (se {rn.bse['ses_z']:.4f}), "
    f"Black {rn.params['ses_z']+rn.params['s_blk']:+.4f}, Hispanic {rn.params['ses_z']+rn.params['s_hsp']:+.4f}")

say("\n"+"="*100); say("(d) WHY THE CRUDE INTERACTION (p = .008) DOES NOT SURVIVE ADJUSTMENT")
rows=[]
for g,sub in df.groupby('SAMPLE_RACE'):
    crude=sm.Logit(sub.deg.values.astype(float),sm.add_constant(sub[['ses_z']],has_constant='add')).fit(disp=0)
    adj=sm.Logit(sub.deg.values.astype(float),sm.add_constant(sub[['ses_z','abl_z','female','fam']],has_constant='add')).fit(disp=0)
    rows.append([g,len(sub),int(sub.deg.sum()),round(sub.deg.mean()*100,2),
                 round(np.corrcoef(sub.ses_z,sub.abl_z)[0,1],3), round(np.corrcoef(sub.ses_z,sub.fam)[0,1],3),
                 round(sub.ses_z.std(),3), round(sub.abl_z.mean(),3), round(sub.fam.mean(),2),
                 round(crude.params['ses_z'],3), round(adj.params['ses_z'],3), round(adj.params['abl_z'],3)])
tabd=pd.DataFrame(rows,columns=['race','n','events','rate_%','corr(SES,abl)','corr(SES,fam)','sd(SES)',
      'mean_abl_z','mean_fam','SES_slope_crude','SES_slope_adj','abl_slope_adj'])
say(tabd.to_string(index=False))
say("  => within Black and Hispanic respondents SES tracks ability/family size differently than within White")
say("     respondents; part of the crude slope gap is compositional, not a different return to SES.")

say("\n"+"="*100); say("(e) RACE AS A LEVEL DIFFERENCE, BEFORE AND AFTER ADJUSTMENT")
mods={'unadjusted (M1)':CR,'adjusted total (A1)':C_TOT,'adjusted direct (B1)':C_TOT+['pct_z']}
df['pct_z']=(df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/df['PERCENTILE IN CLASS'].std()
for lbl,cols in mods.items():
    rr=sm.Logit(y,sm.add_constant(df[cols],has_constant='add')).fit(disp=0); ci=rr.conf_int()
    say(f"  {lbl:22s}: Black OR {np.exp(rr.params['black']):.3f} [{np.exp(ci.loc['black',0]):.3f},"
        f"{np.exp(ci.loc['black',1]):.3f}] p={rr.pvalues['black']:.4f} | Hispanic OR "
        f"{np.exp(rr.params['hisp']):.3f} [{np.exp(ci.loc['hisp',0]):.3f},{np.exp(ci.loc['hisp',1]):.3f}] "
        f"p={rr.pvalues['hisp']:.4f} | SES OR {np.exp(rr.params['ses_z']):.3f} p={rr.pvalues['ses_z']:.4f}")
base=sm.Logit(y,sm.add_constant(df[['ses_z','abl_z','female','fam']],has_constant='add')).fit(disp=0)
nos = sm.Logit(y, sm.add_constant(df[['abl_z','female','fam']].astype(float), has_constant='add')).fit(disp=0)
say(f"  joint significance of RACE in the adjusted total-effect model (LRT 2 df): chi2 = "
    f"{2*(m1.llf-nos.llf):.3f}, p = {stats.chi2.sf(2*(m1.llf-nos.llf),2):.5g}   "
    f"[note: this mixes the race level differences with the SES/race composition]")
nor = sm.Logit(y, sm.add_constant(df[['black','hisp','abl_z','female','fam']].astype(float), has_constant='add')).fit(disp=0)
say(f"  joint significance of SES (no race in model, LRT 1 df): chi2 = {2*(m1.llf-nor.llf):.3f}, "
    f"p = {stats.chi2.sf(2*(m1.llf-nor.llf),1):.5g}")
say(f"  FINAL MODEL CHOICE: main-effects total-effect model A1 preferred "
    f"(AIC {m1.aic:.2f} vs {m2.aic:.2f} for the interaction model; LRT p = 0.51).")
pd.DataFrame({'observed_LRT_total':[obs],'boot_p_total':[pv],'B':[len(ok)],
              'null_mean':[ok.mean()],'null_p95':[np.percentile(ok,95)]}).to_csv('analysis/results_bootstrap_lrt.csv',index=False)
tabd.to_csv('analysis/results_by_race_diagnostics.csv',index=False)
open('analysis/03_robustness_output.txt','w').write("\n".join(OUT))
say("\nSaved: analysis/results_bootstrap_lrt.csv, analysis/results_by_race_diagnostics.csv")
