"""Stage 4: consolidated results for the pre-specified question + final model choice.
(1) correct joint tests (race = 2 df with SES and covariates retained)
(2) fully race-specific model vs the pre-specified partial-interaction model
(3) final chosen model, probabilities and relative risks on the absolute scale
(4) one figure: race-specific predicted probability against SES
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
OUT=[]
def say(*a):
    s=" ".join(str(x) for x in a); print(s); OUT.append(s)
df=pd.read_csv('data/nls_ses_processed.csv',index_col=0); df['deg']=df['BA DEGREE COMPLETED'].astype(int)
ac='ABILITY: COMPOSITE OF ASVAB SCORE'
df['ses_z']=(df.SES-df.SES.mean())/df.SES.std(); df['abl_z']=(df[ac]-df[ac].mean())/df[ac].std()
df['pct_z']=(df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/df['PERCENTILE IN CLASS'].std()
df['female']=(df.SAMPLE_SEX=='Female').astype(float); df['fam']=df['FAMILY SIZE OF SAMPLE'].astype(float)
df['black']=(df.SAMPLE_RACE=='Black').astype(float); df['hisp']=(df.SAMPLE_RACE=='Hispanic').astype(float)
df['s_blk']=df.ses_z*df.black; df['s_hsp']=df.ses_z*df.hisp
y=df.deg.values.astype(float)
C_TOT=['ses_z','black','hisp','abl_z','female','fam']; C_TOI=C_TOT+['s_blk','s_hsp']
F=lambda cols: sm.Logit(y, sm.add_constant(df[cols].astype(float),has_constant='add')).fit(disp=0,maxiter=300)
say("="*96); say("(1) JOINT CONTRIBUTIONS IN THE TOTAL-EFFECT SETTING (each vs the model without that block)")
m_norace=F(['ses_z','abl_z','female','fam']); m_noses=F(['black','hisp','abl_z','female','fam'])
m_none=F(['abl_z','female','fam']); A1=F(C_TOT); A2=F(C_TOI)
for lbl,a,b,d in [('SES alone (1 df)',A1,m_norace,1),('RACE alone (2 df)',A1,m_noses,2),
                  ('SES:RACE interaction (2 df)',A2,A1,2),('SES + RACE jointly (3 df)',A2,m_none,3)]:
    c=2*(a.llf-b.llf); say(f"  LRT {lbl:30s}: chi2 = {c:7.3f}, p = {stats.chi2.sf(c,d):.5g}")
say("\n"+"="*96); say("(2) FULLY RACE-SPECIFIC MODEL (every slope interacts with race) vs THE PRE-SPECIFIED MODEL")
inter=[]
for c in ['ses_z','abl_z','female','fam']:
    df['x_b_'+c]=df[c]*df.black; df['x_h_'+c]=df[c]*df.hisp; inter += ['x_b_'+c,'x_h_'+c]
FULL=F(['ses_z','black','hisp','abl_z','female','fam']+inter); say(f"  fully race-specific model : llf = {FULL.llf:.3f}, AIC = {FULL.aic:.2f}, params = {int(FULL.df_model)+1}")
say(f"  pre-specified A2 (only SES x race): llf = {A2.llf:.3f}, AIC = {A2.aic:.2f}, params = {int(A2.df_model)+1}")
c=2*(FULL.llf-A2.llf); say(f"  LRT that ability/sex/family-size slopes ALSO differ by race: chi2(6) = {c:.3f}, "
   f"p = {stats.chi2.sf(c,6):.4g}  -> {'no evidence' if stats.chi2.sf(c,6)>0.05 else 'evidence'}")
FULLn=list(sm.add_constant(df[['ses_z','black','hisp','abl_z','female','fam']+inter],has_constant='add').columns)
say("  race-specific SES slopes in the fully race-specific model (equivalent to stratified fits, but with "
    "common residual scale):")
for lbl,extra in [('White',None),('Black','x_b_ses_z'),('Hispanic','x_h_ses_z')]:
    con='ses_z' if extra is None else f'ses_z + {extra}'
    t=A2 if False else FULL.t_test(con)
    e=float(np.ravel(t.effect)[0]); s=float(np.ravel(t.sd)[0])
    say(f"    {lbl:9s}: {e:+.4f} (se {s:.4f})  OR {np.exp(e):.3f} [{np.exp(e-1.96*s):.3f}, {np.exp(e+1.96*s):.3f}]")

say("\n"+"="*96); say("(3) FINAL CHOSEN MODEL: TOTAL-EFFECT MAIN EFFECTS (A1); interaction not supported")
say(f"  AIC: A1 = {A1.aic:.2f}  A2 = {A2.aic:.2f}  (lower is better; interaction adds 2 params for +{A1.aic-A2.aic:.2f} worse AIC)")
Xa1=sm.add_constant(df[C_TOT].astype(float),has_constant='add')
pred=np.asarray(A1.predict(Xa1)); df['pred']=pred
rows=[]
for g,sub in df.groupby('SAMPLE_RACE'):
    for v in [-1.0,0.0,1.0]:
        s2=sub.copy(); s2['ses_z']=v
        p=np.asarray(A1.predict(sm.add_constant(s2[C_TOT].astype(float),has_constant='add')))
        rows.append([g,v,len(s2),p.mean(),p.mean()/df.pred.mean()])
mp=pd.DataFrame(rows,columns=['race','ses_z','n','pred_prob','RR_vs_cohort_mean'])
mp['pct']=(mp.pred_prob*100).round(2); mp['RR']=mp.RR_vs_cohort_mean.round(3)
say("  main-effects model, marginal probabilities by race at SES = -1/0/+1 SD (covariates standardised within race):")
say(mp[['race','ses_z','n','pct','RR']].to_string(index=False))
piv=mp.pivot(index='ses_z',columns='race',values='pct')[['White','Black','Hispanic']]
say("  within-race gradient, -1 SD to +1 SD (percentage points): "+
    ", ".join(f"{c} {piv[c].iloc[-1]-piv[c].iloc[0]:+.2f}" for c in piv.columns))
say("  within-race gradient, ratio of probabilities (+1 SD / -1 SD): "+
    ", ".join(f"{c} {piv[c].iloc[-1]/piv[c].iloc[0]:.2f}x" for c in piv.columns))
mp.to_csv('analysis/results_final_marginal_probs_main_effects.csv',index=False)
say("\n  coefficient table of the final model (A1), robust HC1:")
ci=A1.conf_int()
tt=pd.DataFrame({'beta':A1.params,'se_HC1':A1.bse,'OR':np.exp(A1.params),
                 'OR_lo95':np.exp(ci[0]),'OR_hi95':np.exp(ci[1]),'p':A1.pvalues}).round(4)
say(tt.to_string()); tt.to_csv('analysis/results_FINAL_model_A1_coefficients.csv')
open('analysis/04_final_summary_output.txt','w').write("\n".join(OUT))
