"""NLS SES analysis: Black-White BA completion gaps within SES quartiles.
Main: descriptive stratification (quartiles, common cutpoints).
Sensitivity: 3-band SES; logistic regression BA ~ Black*SES_bin + sex + ABILITY + percentile.
"""
import numpy as np, pandas as pd
from scipy import stats

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
RACE = df['SAMPLE_RACE']

def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k/n
    d = 1 + z*z/n
    c = (p + z*z/(2*n))/d
    h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n))/d
    return (c-h, c+h)

def diff_ci(k1, n1, k0, n0, z=1.96):
    """Newcombe hybrid-score CI for p1 - p0 (percentage points when *100)."""
    l1,u1 = wilson(k1,n1,z); l0,u0 = wilson(k0,n0,z)
    p1,p0 = k1/n1, k0/n0
    d = p1-p0
    lo = d - np.sqrt((p1-l1)**2 + (u0-p0)**2)
    hi = d + np.sqrt((u1-p1)**2 + (p0-l0)**2)
    return d*100, lo*100, hi*100

def fisher_p(k1,n1,k0,n0):
    if min(n1,n0)==0: return np.nan
    return stats.fisher_exact([[k1,n1-k1],[k0,n0-k0]])[1]

def gap_table(bins, labels, ses):
    rows=[]
    for lab in labels:
        vals = ses[bins==lab]
        row={'SES bin':lab,
             'SES range': f"{vals.min():.2f} to {vals.max():.2f}"}
        for race in ['Black','White','Hispanic']:
            sub = df[(row['SES bin']==lab if False else (bins==lab)) & (RACE==race)]
            n,k = len(sub), sub['BA'].sum(); p = 100*k/n if n else np.nan
            lo,hi = wilson(k,n)
            row[f'{race} n']=n; row[f'{race} events']=k
            row[f'{race} %']=round(p,2)
            row[f'{race} 95%CI']=f"[{100*lo:.1f}, {100*hi:.1f}]"
        # gaps vs White
        for race in ['Black','Hispanic']:
            s1 = df[(bins==lab) & (RACE==race)]; s0 = df[(bins==lab) & (RACE=='White')]
            d,dl,dh = diff_ci(s1['BA'].sum(), len(s1), s0['BA'].sum(), len(s0))
            row[f'{race}-White gap, pp']=round(d,2)
            row[f'{race}-White 95%CI pp']=f"[{dl:.1f}, {dh:.1f}]"
            row[f'{race} Fisher p']=round(fisher_p(s1['BA'].sum(),len(s1),s0['BA'].sum(),len(s0)),4)
        # unstable flags (<5 events)
        flags=[r for r in ['Black','White','Hispanic'] if row[f'{r} events']<5]
        row['unstable(<5 events)']=','.join(flags)
        rows.append(row)
    return pd.DataFrame(rows)

# Main: quartiles over full sample
df['q'] = pd.qcut(df['SES'], 4, labels=['Q1 (lowest)','Q2','Q3','Q4 (highest)'])
qt = gap_table(df['q'], ['Q1 (lowest)','Q2','Q3','Q4 (highest)'], df['SES'])
print("SES quartile cutpoints:", df['SES'].quantile([.25,.5,.75]).round(3).to_dict())
print("\n=== MAIN: quartiles ===")
print(qt.to_string(index=False))

# Sensitivity: 3 bands
df['b3'] = pd.qcut(df['SES'], 3, labels=['Low','Mid','High'])
t3 = gap_table(df['b3'], ['Low','Mid','High'], df['SES'])
print("\n=== SENSITIVITY: 3 bands ===")
print(t3.to_string(index=False))

# Logistic sensitivity: Black vs White only, interaction with SES half (above/below median)
sub = df[df['SAMPLE_RACE'].isin(['Black','White'])].copy()
sub['black'] = (sub['SAMPLE_RACE']=='Black').astype(int)
sub['ses_hi'] = (sub['SES'] > df['SES'].median()).astype(int)
sub['female'] = (sub['SAMPLE_SEX']=='Female').astype(int)
X = pd.DataFrame({'black':sub['black'],'ses_hi':sub['ses_hi'],
                  'black_x_seshi':sub['black']*sub['ses_hi'],
                  'female':sub['female'],
                  'ability':sub['ABILITY: COMPOSITE OF ASVAB SCORE'],
                  'pct':sub['PERCENTILE IN CLASS'],'const':1.0})
y = sub['BA']
import statsmodels.api as sm
m = sm.Logit(y, X).fit(disp=0)
print("\n=== Logistic: BA ~ Black*SES_hi + female + ability + pct (Black & White only) ===")
print(m.summary2().tables[1].round(4).to_string())
# adjusted predicted gaps by SES half (holding covariates at sample means)
for hi in [0,1]:
    Xi = X.copy(); Xi['black']=hi; Xi['ses_hi']= (1-hi)*0 + hi  # keep ses_hi fixed per scenario
    # scenario: Black in group hi vs White in group hi
    Xb = X.copy(); Xb['black']=1; Xb['ses_hi']=hi; Xb['black_x_seshi']=hi
    Xw = X.copy(); Xw['black']=0; Xw['ses_hi']=hi; Xw['black_x_seshi']=0
    gb = m.predict(Xb).mean()*100; gw = m.predict(Xw).mean()*100
    print(f"Adjusted predicted gap (Black-White) in SES {'upper' if hi else 'lower'} half: {gb-gw:.2f} pp")

# Stratified logistic: Black effect within each SES half (covariates controlled)
strat_lines=[]
for hi in [0,1]:
    sh = sub[sub['ses_hi']==hi].copy()
    Xs = pd.DataFrame({'black':sh['black'],'female':(sh['SAMPLE_SEX']=='Female').astype(int),
                       'ability':sh['ABILITY: COMPOSITE OF ASVAB SCORE'],
                       'pct':sh['PERCENTILE IN CLASS'],'ses':sh['SES'],'const':1.0})
    ms = sm.Logit(sh['BA'], Xs).fit(disp=0)
    b = ms.params['black']; se = ms.bse['black']
    line = f"Adjusted Black logit coef in SES {'upper' if hi else 'lower'} half: {b:.3f} (SE {se:.3f}, p={ms.pvalues['black']:.3f})"
    print(line); strat_lines.append(line)

qt.to_csv('analysis/table_quartiles.csv', index=False)
t3.to_csv('analysis/table_3bands.csv', index=False)
with open('analysis/summary.txt','w') as f:
    f.write("Quartile cutpoints (SES): "+str(df['SES'].quantile([.25,.5,.75]).round(4).to_dict())+"\n\n")
    f.write(qt.to_string(index=False)); f.write("\n\n"+t3.to_string(index=False))
    f.write("\n\n"+str(m.summary2().tables[1])+"\n\n"+"\n".join(strat_lines))
print("\nSaved: analysis/table_quartiles.csv, analysis/table_3bands.csv, analysis/summary.txt")
