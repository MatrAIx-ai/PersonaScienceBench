"""Stage 1 (plan support): data inspection of nls_ses_processed.csv + feasibility probe
for locating the statistic -0.9568 (BA degree completion contrast between races).
Run:  python3 analysis/01_inspection_and_feasibility.py
"""
import itertools, warnings
import numpy as np, pandas as pd, statsmodels.api as sm
import statsmodels.formula.api as smf
warnings.filterwarnings('ignore')

TARGET = -0.9568
RACES = ['White', 'Black', 'Hispanic']

df = pd.read_csv('data/nls_ses_processed.csv')
print("== 1. STRUCTURE ==")
print("shape:", df.shape, " rows:", len(df))
print("columns (exact spelling):")
for c in df.columns:
    print("   ", repr(c), "| dtype:", df[c].dtype)

print("\n== 2. MISSING VALUES ==")
print(pd.DataFrame({'n_missing': df.isna().sum(), 'pct_missing': (df.isna().mean()*100).round(3)}))

print("\n== 3. SAMPLE_RACE ==")
print(df['SAMPLE_RACE'].value_counts(dropna=False))
print("unique:", sorted(df['SAMPLE_RACE'].dropna().unique().tolist()))

print("\n== 4. BA DEGREE COMPLETED ==")
print("raw value_counts:", df['BA DEGREE COMPLETED'].value_counts(dropna=False).to_dict())
df['ba'] = df['BA DEGREE COMPLETED'].astype(int)          # True/False -> 1/0
ct = pd.crosstab(df['SAMPLE_RACE'], df['ba'], margins=True)
ct.columns = ['no_BA(0)', 'BA(1)', 'total']
ct['pct_BA'] = (ct['BA(1)'] / ct['total'] * 100).round(3)
ct['odds'] = (ct['BA(1)'] / ct['no_BA(0)']).round(5)
print(ct)

print("\n== 5. UNADJUSTED PAIRWISE LOG-ODDS RATIOS (log 'factor') ==")
g = df.groupby('SAMPLE_RACE').ba.agg(['sum', 'count'])
g['logodds'] = np.log(g['sum'] / (g['count'] - g['sum']))
for a, b in itertools.combinations(RACES, 2):
    lo = g.logodds[a] - g.logodds[b]
    print(f"   {a:9s} vs {b:9s}: logOR={lo:+.4f}  OR={np.exp(lo):.4f}  |logOR-TARGET|={abs(lo-TARGET):.4f}")

print("\n== 6. RACE-ONLY LOGIT, EACH BASE CATEGORY ==")
for base in RACES:
    X = pd.get_dummies(df['SAMPLE_RACE']).astype(float).drop(columns=[base])
    m = sm.Logit(df['ba'], sm.add_constant(X)).fit(disp=0, method='newton', tol=1e-12)
    print(f"   base={base:9s} -> " + ", ".join(f"{c}={m.params[c]:+.4f}" for c in m.params.index if c != 'const'))

print("\n== 7. FEASIBILITY GRID: covariate subsets x bases x interactions ==")
d = df.rename(columns={'FAMILY SIZE OF SAMPLE': 'fam', 'ABILITY: COMPOSITE OF ASVAB SCORE': 'abi',
                       'PERCENTILE IN CLASS': 'pct', 'Unnamed: 0': 'idx'}).copy()
d['CASE_ID'] = df['CASE ID']
d['male'] = (d['SAMPLE_SEX'] == 'Male').astype(int)
covs = ['SES', 'abi', 'pct', 'fam', 'male']
hits, nfits = [], 0
for base in RACES:
    d['R'] = pd.Categorical(d['SAMPLE_RACE'], categories=[base] + [c for c in RACES if c != base])
    formulas = []
    for k in range(len(covs) + 1):
        for cs in itertools.combinations(covs, k):
            formulas.append("ba ~ R" + "".join(" + " + c for c in cs))
    for itc in covs:
        rest = [c for c in covs if c != itc]
        for k in range(len(rest) + 1):
            for cs in itertools.combinations(rest, k):
                formulas.append(f"ba ~ R*{itc}" + "".join(" + " + c for c in cs))
    for p1, p2 in itertools.combinations(covs, 2):
        formulas.append(f"ba ~ R + R:{p1} + R:{p2} + {p1} + {p2}")
    for f in formulas:
        try:
            m = smf.logit(f, data=d).fit(disp=0, maxiter=500)
        except Exception:
            continue
        nfits += 1
        for kk, v in m.params.items():
            if kk.startswith('R['):
                hits.append((abs(v - TARGET), v, f, kk, base))
hits.sort()
print(f"   fits evaluated: {nfits}; terms: {len(hits)}; exact matches (round to 4dp): "
      f"{sum(1 for h in hits if h[0] < 5e-5)}")
print("   top matches:")
seen = set()
for diff, v, f, kk, base in hits[:10]:
    key = (f, kk)
    if key in seen:
        continue
    seen.add(key)
    print(f"     {v:+.6f}  |d|={diff:.5f}  {kk:20s}  {f}  [base={base}]")

print("\n== 8. CANDIDATE MODEL IN DETAIL (ba ~ SAMPLE_RACE * SES, base = White) ==")
d['R'] = pd.Categorical(d['SAMPLE_RACE'], categories=['White', 'Black', 'Hispanic'])
m = smf.logit("ba ~ R*SES", data=d).fit(disp=0, maxiter=300)
print(m.summary())
print("SES mean=%.4f sd=%.4f (raw scale; contrast at SES=0)" % (df.SES.mean(), df.SES.std()))
for lab, tr in [('raw', lambda s: s), ('centered', lambda s: s - s.mean()), ('z-scored', lambda s: (s - s.mean())/s.std())]:
    d2 = d.copy(); d2['SES'] = tr(d2.SES)
    mm = smf.logit("ba ~ R*SES", data=d2).fit(disp=0, maxiter=300)
    print(f"   SES {lab:9s} -> Black main effect = {mm.params['R[T.Black]']:+.4f}, Hispanic = {mm.params['R[T.Hispanic]']:+.4f}")
