"""
Main analysis: "Between which two races is the factor of BA degree completion -0.9568?"
Run:  python3 analysis/02_main_analysis.py
Sections (approved plan items a-e):
  A. descriptives: BA shares by race, pairwise ORs
  B. PRIMARY spec: logit(BA ~ SAMPLE_RACE), dummy coding, base = White
  C. SES scale + target-reproducing spec logit(BA ~ SAMPLE_RACE*SES)
  D. robustness: contrasts at SES quantiles, ATC, AIC/BIC model comparison
  E. rare-event diagnostics: EPV, convergence, Firth / ridge refits
  F. pair decision + uniqueness check of the target value
"""
import itertools, sys, warnings
import numpy as np, pandas as pd
import statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats
warnings.filterwarnings('ignore')

print("ENVIRONMENT: python", sys.version.split()[0], "| pandas", pd.__version__,
      "| numpy", np.__version__, "| statsmodels", sm.__version__)
TARGET = -0.9568
RACES = ['White', 'Black', 'Hispanic']
rng = np.random.default_rng(20261025)

df = pd.read_csv('data/nls_ses_processed.csv')
df = df.rename(columns={'FAMILY SIZE OF SAMPLE': 'fam', 'ABILITY: COMPOSITE OF ASVAB SCORE': 'abi',
                        'PERCENTILE IN CLASS': 'pct', 'Unnamed: 0': 'idx'})
df['ba'] = df['BA DEGREE COMPLETED'].astype(int)          # explicit True/False -> 1/0
df['R'] = pd.Categorical(df['SAMPLE_RACE'], categories=RACES)   # base = White
print(f"\nrows = {len(df)} | total missing = {int(df.isna().sum().sum())} | BA events = {df.ba.sum()}")

print("\n" + "="*78 + "\nA. NAIVE SHARES AND PAIRWISE ODDS RATIOS\n" + "="*78)
g = df.groupby('SAMPLE_RACE', observed=True).ba.agg(events='sum', n='count')
g['share_pct'] = (100*g.events/g.n).round(3)
g['odds'] = (g.events/(g.n-g.events)).round(5)
print(g)
print("\npairwise crude log-OR / OR (Woolf 95% CI):")
for a, b in itertools.combinations(RACES, 2):
    ea, na = g.events[a], g.n[a]; eb, nb = g.events[b], g.n[b]
    lo = np.log((ea/(na-ea))/(eb/(nb-eb)))
    se = np.sqrt(1/ea + 1/(na-ea) + 1/eb + 1/(nb-eb))
    chi2, pchi = stats.chi2_contingency(np.array([[eb, nb-eb], [ea, na-ea]]), correction=False)[:2]
    print(f"  {a:9s} vs {b:9s}: logOR={lo:+.4f} OR={np.exp(lo):.4f} "
          f"[{np.exp(lo-1.96*se):.4f},{np.exp(lo+1.96*se):.4f}] Wald p={2*stats.norm.sf(abs(lo/se)):.4g}"
          f" chi2 p={pchi:.4g} | best-orientation |logOR-target| = {min(abs(lo-TARGET), abs(-lo-TARGET)):.4f}"
          f" ({a if abs(lo-TARGET) < abs(-lo-TARGET) else b}-first)")

print("\n" + "="*78 + "\nB. PRIMARY SPECIFICATION: logit(BA ~ SAMPLE_RACE), reference = White\n" + "="*78)
m_race = smf.logit('ba ~ R', data=df).fit(disp=0, method='newton', tol=1e-12, maxiter=200)
print(m_race.summary())
ci = m_race.conf_int()
tab = pd.DataFrame({'coef': m_race.params, 'SE': m_race.bse, 'z': m_race.tvalues, 'p': m_race.pvalues,
                    'ci_lo': ci[0], 'ci_hi': ci[1], 'OR': np.exp(m_race.params),
                    'OR_lo': np.exp(ci[0]), 'OR_hi': np.exp(ci[1])})
print("\nlog-OR vs White (primary answer table):")
print(tab.round(4).to_string())
print(f"converged={m_race.mle_retvals['converged']} iters={m_race.mle_retvals['iterations']} "
      f"n={int(m_race.nobs)} events={int(df.ba.sum())} params={len(m_race.params)} "
      f"EPV={df.ba.sum()/len(m_race.params):.1f} AIC={m_race.aic:.3f} BIC={m_race.bic:.3f}")

print("\n" + "="*78 + "\nC. SES SCALE AND THE TARGET-REPRODUCING SPECIFICATION\n" + "="*78)
print("SES: mean=%.6f sd=%.6f skew=%.3f min=%.4f max=%.4f" %
      (df.SES.mean(), df.SES.std(), df.SES.skew(), df.SES.min(), df.SES.max()))
print("SES quantiles:\n" + df.SES.quantile([0,.05,.25,.5,.75,.95,1]).round(4).to_string())
print("-> SES is an approximately standardized composite (mean ~ 0, sd ~ 0.74): SES = 0 is "
      "essentially the sample mean SES, i.e. the contrast is taken near the middle of the SES range.")
m_int = smf.logit('ba ~ R*SES', data=df).fit(disp=0, method='newton', tol=1e-12, maxiter=300)
print("\nlogit(ba ~ SAMPLE_RACE * SES), reference = White:")
print(m_int.summary())
bl = m_int.params['R[T.Black]']
print(f"\n*** Black main effect = {bl:.6f} -> rounds to {round(bl,4):+.4f}; target = {TARGET:+.4f}; "
      f"|diff| = {abs(bl-TARGET):.2e}; exact at 4 dp = {abs(bl-TARGET) < 5e-5}")
print(f"*** interpretation: log-OR Black vs White AT SES = 0 (NOT the sample-average effect); "
      f"OR = exp(beta) = {np.exp(bl):.4f}")
print("    mean SES: Black group = %.4f, White group = %.4f" %
      (df.loc[df.R=='Black','SES'].mean(), df.loc[df.R=='White','SES'].mean()))

print("\n" + "="*78 + "\nD. ROBUSTNESS: CONTRASTS OVER SES, AVERAGE CONTRAST, MODEL COMPARISON\n" + "="*78)
V = m_int.cov_params(); names = list(m_int.params.index)
def contrast_at(term, s):
    c = np.zeros(len(names))
    c[names.index(f'R[T.{term}]')] = 1.0
    c[names.index(f'R[T.{term}]:SES')] = s
    est = float(c @ m_int.params.values); se = float(np.sqrt(c @ V.values @ c))
    return est, se, np.exp(est), np.exp(est-1.96*se), np.exp(est+1.96*se), 2*stats.norm.sf(abs(est/se))
print("interaction-model contrasts at SES quantiles:")
for q in [.25, .50, .75]:
    s = df.SES.quantile(q)
    for term in ['Black', 'Hispanic']:
        e, se, orr, lo, hi, pv = contrast_at(term, s)
        print(f"  q{q:.2f} (SES={s:+.4f}) {term:9s} vs White: logOR={e:+.4f} (SE {se:.4f}) OR={orr:.4f} "
              f"[{lo:.4f},{hi:.4f}] p={pv:.4f} | target-matching={abs(e-TARGET)<5e-5}")
s_mb = df.loc[df.R=='Black','SES'].mean()
e, se, orr, lo, hi, pv = contrast_at('Black', s_mb)
print(f"  ATC-style contrast for Black respondents (their mean SES={s_mb:+.4f}): logOR={e:+.4f} "
      f"(SE {se:.4f}) OR={orr:.4f} [{lo:.4f},{hi:.4f}] p={pv:.4f}")

d = m_int.nobs
Xb_full = np.column_stack([np.ones(d), (df.R=='Black').values.astype(float), (df.R=='Hispanic').values.astype(float),
                           df.SES.values, (df.R=='Black').values*df.SES.values, (df.R=='Hispanic').values*df.SES.values])
bhat = m_int.params.values; draw = rng.multivariate_normal(bhat, V.values, size=2000)
Xb = Xb_full[df.R.values == 'Black']
def zero(vec, idx): v = vec.copy(); v[idx] = 0.0; return v
atc = (1/(1+np.exp(-(Xb @ bhat)))).mean() - (1/(1+np.exp(-(Xb @ zero(bhat,1))))).mean()
bs = [ (1/(1+np.exp(-(Xb @ bd)))).mean() - (1/(1+np.exp(-(Xb @ zero(bd,1))))).mean() for bd in draw ]
bs = np.array(bs)
print(f"  ATC on probability scale (Black respondents, 2000 parametric-bootstrap draws): "
      f"{atc*100:+.3f} pp 95% CI [{np.percentile(bs,2.5)*100:+.3f},{np.percentile(bs,97.5)*100:+.3f}] pp")
print(f"  crude difference in BA shares (Black - White) = "
      f"{100*(g.events['Black']/g.n['Black'] - g.events['White']/g.n['White']):+.3f} pp")

print("\nmodel comparison (identical n = %d):" % d)
models = {'race only': m_race,
          'race + SES': smf.logit('ba ~ R + SES', data=df).fit(disp=0, tol=1e-12, maxiter=300),
          'race * SES': m_int}
rows = [[k, int(mm.nobs), len(mm.params), mm.llf, mm.aic, mm.bic, mm.llr_pvalue, mm.mle_retvals['converged']]
        for k, mm in models.items()]
print(pd.DataFrame(rows, columns=['model','n','k','loglik','AIC','BIC','LR p','converged']).round(4).to_string(index=False))
lr = 2*(m_int.llf - models['race + SES'].llf)
print(f"LR test (race*SES vs race+SES): chi2(2)={lr:.4f}, p={stats.chi2.sf(lr,2):.4f}")
print(f"  race-only coefficients (unadjusted)  : Black={m_race.params['R[T.Black]']:+.4f}, Hispanic={m_race.params['R[T.Hispanic]']:+.4f}")
print(f"  race+SES coefficients (additive/ATE) : Black={models['race + SES'].params['R[T.Black]']:+.4f}, "
      f"Hispanic={models['race + SES'].params['R[T.Hispanic]']:+.4f}")
print(f"  race*SES main effect at SES=0        : Black={m_int.params['R[T.Black]']:+.4f}, "
      f"Hispanic={m_int.params['R[T.Hispanic]']:+.4f}")

print("\n" + "="*78 + "\nE. RARE-EVENT DIAGNOSTICS: EPV, CONVERGENCE, FIRTH / RIDGE\n" + "="*78)
for k, mm in models.items():
    print(f"  {k:12s}: k={len(mm.params)} events={int(df.ba.sum())} EPV={df.ba.sum()/len(mm.params):.1f} "
          f"converged={mm.mle_retvals['converged']} iters={mm.mle_retvals.get('iterations')} "
          f"max fitted p={mm.predict().max():.4f}")
print("  group event counts:", df.groupby('SAMPLE_RACE', observed=True).ba.sum().to_dict(),
      "(Hispanic 19 and Black 28 events are the binding constraint)")

def firth_logit(X, y, tol=1e-11, maxiter=300):
    X = np.asarray(X, float); y = np.asarray(y, float); b = np.zeros(X.shape[1])
    for _ in range(maxiter):
        mu = 1/(1+np.exp(-X @ b)); W = mu*(1-mu)
        I = X.T @ (X*W[:, None]); Ii = np.linalg.inv(I)
        h = np.einsum('ij,jk,ik->i', X, Ii, X)
        U = X.T @ (y-mu) + 0.5*(X.T @ (W*(1-2*mu)*h))
        step = Ii @ U; b = b + step
        if np.max(np.abs(step)) < tol: break
    return b

def ridge_logit(X, y, lam):
    X = np.asarray(X, float); y = np.asarray(y, float); b = np.zeros(X.shape[1])
    P = np.eye(X.shape[1])*lam; P[0, 0] = 0.0
    for _ in range(300):
        mu = 1/(1+np.exp(-X @ b)); W = mu*(1-mu)
        step = np.linalg.solve(X.T @ (X*W[:, None]) + P, X.T @ (y-mu) - P @ b); b = b + step
        if np.max(np.abs(step)) < 1e-11: break
    return b

X1 = np.column_stack([np.ones(len(df)), (df.R=='Black').astype(float), (df.R=='Hispanic').astype(float)])
X2 = np.column_stack([X1, df.SES.values, (df.R=='Black').values*df.SES.values, (df.R=='Hispanic').values*df.SES.values])
f1, f2 = firth_logit(X1, df.ba.values), firth_logit(X2, df.ba.values)
print(f"  Firth race-only : Black={f1[1]:+.4f} Hispanic={f1[2]:+.4f}")
print(f"  Firth race*SES  : Black(main)={f2[1]:+.4f} Hispanic(main)={f2[2]:+.4f} "
      f"Black:SES={f2[4]:+.4f} Hispanic:SES={f2[5]:+.4f}  | Black(main)-target| = {abs(f2[1]-TARGET):.4f}")
for lam in [1.0, 5.0]:
    r1, r2 = ridge_logit(X1, df.ba.values, lam), ridge_logit(X2, df.ba.values, lam)
    print(f"  ridge(lam={lam:g}) race-only: Black={r1[1]:+.4f} Hispanic={r1[2]:+.4f} | race*SES: "
          f"Black(main)={r2[1]:+.4f} Hispanic(main)={r2[2]:+.4f}")

print("\n" + "="*78 + "\nF. WHICH PAIR? UNIQUENESS CHECK OF THE TARGET VALUE\n" + "="*78)
df['male'] = (df.SAMPLE_SEX == 'Male').astype(int)
covs = ['SES', 'abi', 'pct', 'fam']
hits = []
for base in RACES:
    dd = df.copy()
    dd['Rb'] = pd.Categorical(dd.SAMPLE_RACE, categories=[base]+[c for c in RACES if c != base])
    fs = []
    for k in range(5):
        for cs in itertools.combinations(covs, k):
            fs.append("ba ~ Rb" + "".join(" + "+c for c in cs))
            fs.append("ba ~ Rb" + "".join(" + "+c for c in cs) + " + male")
    for itc in covs+['male']:
        rest = [c for c in covs if c != itc]
        fs.append(f"ba ~ Rb*{itc} + " + " + ".join(rest)); fs.append(f"ba ~ Rb*{itc}")
    for f in fs:
        try: mm = smf.logit(f, data=dd).fit(disp=0, maxiter=500)
        except Exception: continue
        for kk, v in mm.params.items():
            if kk.startswith('Rb[') and ':' not in kk:
                hits.append((v, f, kk, base))
exact = [h for h in hits if abs(h[0]-TARGET) < 5e-5]
print(f"  race terms scanned: {len(hits)} across {len(set(h[1] for h in hits))} formulas (all 3 bases)")
print(f"  exact matches (|diff| < 5e-5, i.e. coefficient rounds to -0.9568): {len(exact)}")
for v, f, kk, base in exact:
    pair = {'Rb[T.Black]': 'Black vs White', 'Rb[T.Hispanic]': 'Hispanic vs White',
            'Rb[T.White]': 'White vs reference'}[kk]
    print(f"     {v:+.6f}  {kk}  [{f}]  base={base}  -> pair = {pair}")
nh = min([h for h in hits if 'Hispanic' in h[2]], key=lambda h: abs(h[0]-TARGET))
print(f"  closest Hispanic-vs-White term anywhere in the grid: {nh[0]:+.4f} ({nh[2]}, [{nh[1]}], base={nh[3]}), "
      f"|diff| = {abs(nh[0]-TARGET):.4f} -> Hispanic-White reading REJECTED by the uniqueness criterion")
print(f"  crude model log-ORs: Black={m_race.params['R[T.Black]']:+.4f}, Hispanic={m_race.params['R[T.Hispanic]']:+.4f}; "
      f"the target -0.9568 lies between them, so the unadjusted model alone cannot identify the pair; "
      f"the interaction specification fixes it (unique match above).")

print("\nsign/robustness of the Black-vs-White contrast over the observed SES range:")
for s in [df.SES.min(), -1.0, -0.5, 0.0, 0.5, 1.0, df.SES.max()]:
    e, se, orr, lo, hi, pv = contrast_at('Black', s)
    print(f"  SES={s:+.4f}: logOR={e:+.4f} (SE {se:.4f}) OR={orr:.3f} [{lo:.3f},{hi:.3f}] p={pv:.4f}")
cross = -m_int.params['R[T.Black]']/m_int.params['R[T.Black]:SES']
print(f"  contrast crosses zero at SES = {cross:.3f} "
      f"({'inside' if df.SES.min() <= cross <= df.SES.max() else 'outside'} the observed SES range)")
print("\nANSWER SENTENCE: the factor -0.9568 is the Black-vs-White contrast "
      "(logit(BA ~ SAMPLE_RACE*SES), reference White): Black respondents have exp(-0.9568) = "
      f"{np.exp(m_int.params['R[T.Black]']):.3f} times the odds of BA completion of White respondents at SES = 0; "
      f"unadjusted Black-vs-White log-OR = {m_race.params['R[T.Black]']:+.4f} (OR "
      f"{np.exp(m_race.params['R[T.Black]']):.3f}).")
print("End of analysis.")
