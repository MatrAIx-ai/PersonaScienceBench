"""Step 1 (intro only): structural / coding inspection of the survey CSV.
No inferential analysis, no final answer.
"""
import re, collections
import pandas as pd

PATH = "data/requirements_engineering_for_ML-enabled_systems.csv"
df = pd.read_csv(PATH, dtype=str, keep_default_na=False)
out = []
p = out.append

p(f"shape (rows, cols) = {df.shape};  unique IDs = {df.ID.nunique()};  dup IDs = {df.ID.duplicated().sum()}")
blank = df.apply(lambda s: (s.str.strip() == "").sum())
p(f"truly empty cells = {int(blank.sum())} in {int((blank > 0).sum())} columns (all *_Free / optional text)")
for code in ["-99", "-77", "-66", "-1", "0"]:
    n = df.apply(lambda s: (s.str.strip() == code).sum())
    p(f"code {code:>4}: cells={int(n.sum()):5d}  columns={int((n > 0).sum())}")

bincols = [c for c in df.columns if set(df[c].unique()) <= {"quoted", "not quoted", "-77", "-99"}]
p(f"multiple-response indicator columns = {len(bincols)} "
  f"(no missing code: {sum(1 for c in bincols if '-77' not in set(df[c]))}; with -77: {sum(1 for c in bincols if '-77' in set(df[c]))})")
p("  per block: " + str(dict(collections.Counter(c.split('_')[0] for c in bincols))))

p("\n--- D4_Role ---")
p(df.D4_Role.value_counts().to_string())
ans = df.Q8_ML_Addressing_Project_Lead.ne("-77")
p(f"\nrespondents answering the Q8 block = {int(ans.sum())}; with known D4_Role = {int((ans & df.D4_Role.ne('0')).sum())}")
p("Q8 answered x D4_Role:\n" + pd.crosstab(df.D4_Role, ans).to_string())

q8 = [c for c in df.columns if c.startswith("Q8_") and not c.endswith("Free")]
p("\n--- Q8_ML_Addressing_* : 'quoted' counts and shares (denominator = 194 block respondents) ---")
for c in q8:
    q = int((df[c] == "quoted").sum())
    p(f"  {c:42s} quoted={q:3d}  share/194={q / ans.sum() * 100:7.3f}%   share/276={q / len(df) * 100:7.3f}%")
p("value sets in Q8 cols: " + str({c: sorted(set(df[c])) for c in q8[:1]}))
p("Q8_Others_Free: -99 = %d, -66 = %d, free text = %d"
  % ((df.Q8_ML_Addressing_Others_Free == "-99").sum(), (df.Q8_ML_Addressing_Others_Free == "-66").sum(),
     int((~df.Q8_ML_Addressing_Others_Free.isin(["-99", "-66"])).sum())))
p("free-text D4_Role_Others non-empty = %d (all from 'Other, which one?'); distinct = %d"
  % ((df.D4_Role_Others != "-99").sum(), df.loc[df.D4_Role == "Other, which one?", "D4_Role_Others"].nunique()))
idk = df.apply(lambda s: (s.str.strip().str.lower() == "i don't know").sum())
p("'I don't know' cells = %d in %d columns: %s" % (int(idk.sum()), int((idk > 0).sum()), dict(idk[idk > 0])))
p("\n--- CI-width diagnostic of the reference numbers ---")
for pt, lo, hi in [(49.6, 49.219, 49.981), (61.389, 60.955, 61.822)]:
    hw = (hi - lo) / 2
    se = hw / 1.96 / 100
    p(f"  point={pt}% halfwidth={hw:.3f}pp implied SE={se*100:.4f}pp -> implied n (Wald) = "
      f"{(pt/100)*(1-pt/100)/se**2:,.0f}; respondent-level SE at n=194 = {((pt/100)*(1-pt/100)/194)**0.5*100:.3f}pp")

text = "\n".join(out)
print(text)
open("analysis/01_inspect_output.txt", "w").write(text + "\n")
