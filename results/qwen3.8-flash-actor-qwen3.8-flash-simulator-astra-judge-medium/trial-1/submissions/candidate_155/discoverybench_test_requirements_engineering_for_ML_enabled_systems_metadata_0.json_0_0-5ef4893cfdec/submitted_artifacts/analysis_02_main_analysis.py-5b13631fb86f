"""
DiscoveryBench / requirements_engineering_for_ML_enabled_systems
Main analysis (pre-registered specification, frozen BEFORE the numbers were computed).

PRIMARY SPEC
  unit       : one respondent = one row (276 rows, unique IDs); Q8 is answered at
               respondent/organization level -> no per-project expansion.
  outcome    : share of respondents with Q8_ML_Addressing_<role> == "quoted"
               (any non-zero selection; the data hold no Likert scale for Q8).
  denominator: complete case inside the Q8 block (all -99/-77/-66/-1 -> missing), n=194.
  roles      : 7 canonical roles + Q8_ML_Addressing_Others kept separate.
  bootstrap  : B=10,000, nonparametric respondent resampling with replacement, ONE shared
               index vector applied to all 8 columns jointly (keeps multiselect
               correlation), seed=20261025; CI percentile 2.5/97.5 primary + BCa reported.
SENSITIVITY ONLY: S1 n=180, S2 n=276 (-77 -> not quoted), S3 Others free-text folded,
  S4 stratified by D4_Role, S5 project-count weighted (D7),
  B1..B3 bridges to requirements (Q1 importance / Q10 documentation / Q12 difficulty),
  C1 conditional P(quoted | own role).
"""
import json, re, math
from math import erf, sqrt
from statistics import NormalDist
ND = NormalDist()
from collections import Counter
import numpy as np
import pandas as pd

SEED, B = 20261025, 10_000
PATH = "data/requirements_engineering_for_ML-enabled_systems.csv"
NEG = {"-99", "-77", "-66", "-1"}
ROLES = {
    "Project Lead / Project Manager": "Q8_ML_Addressing_Project_Lead",
    "Business Analyst":               "Q8_ML_Addressing_Business_Analyst",
    "Requirements Engineer":          "Q8_ML_Addressing_Requirement_Engineer",
    "Solution Architect":             "Q8_ML_Addressing_Solution_Architect",
    "Data Scientist":                 "Q8_ML_Addressing_Data_Scientist",
    "Developer":                      "Q8_ML_Addressing_Developer",
    "Test Manager / Tester":          "Q8_ML_Addressing_Tester",
    "Others (free text)":             "Q8_ML_Addressing_Others"}
Q8COLS, names = list(ROLES.values()), list(ROLES)
NARR = np.array(names)
log = []
def P(*a):
    s = " ".join(str(x) for x in a); log.append(s); print(s)

raw = pd.read_csv(PATH, dtype=str, keep_default_na=False)
df = raw.copy()
for c in df.columns:
    if c != "ID":
        df[c] = df[c].str.strip().replace(sorted(NEG), pd.NA)
CAT_ZERO = ["D4_Role", "D2_Country", "D3_Company_Size", "D9_ML_Project_Team_Size",
            "D11_Agile_Development"] + [c for c in df.columns if c.startswith(("Q1_", "Q2_", "Q6_", "Q17_"))]
for c in CAT_ZERO:
    df[c] = df[c].replace({"0": pd.NA})
P(f"[cleaning] rows={len(df)} cols={df.shape[1]}; negative-code cells turned into NA: "
  f"{int(raw.isin(sorted(NEG)).sum().sum())}")
assert all(df[c].isna().equals(df[Q8COLS[0]].isna()) for c in Q8COLS)
answered, role_known = df[Q8COLS[0]].notna(), df["D4_Role"].notna()
P(f"[cleaning] Q8 block answered={int(answered.sum())}; missing={int((~answered).sum())} "
  f"(Status of those rows: {raw.loc[~answered,'Status'].value_counts().to_dict()}); "
  f"answered & role known={int((answered & role_known).sum())}")
M = df[Q8COLS].apply(lambda s: s.eq("quoted")).astype(float).to_numpy()
M_masked = np.where(answered.to_numpy()[:, None], M, np.nan)
Mblock = M[answered.to_numpy()]          # 194 x 8 complete-case block

def bca_ci(x, theta, boots):
    n = len(x)
    z0 = ND.inv_cdf(max(min((boots < theta).mean(), 1 - 1e-12), 1e-12))
    jack = np.array([(x.sum() - x[i]) / (n - 1) for i in range(n)])
    jm = jack.mean(); num = ((jm - jack) ** 3).sum(); den = 6 * (((jm - jack) ** 2).sum() ** 1.5)
    a = num / den if den else 0.0
    z2p = lambda z: 0.5 * (1 + erf(z / sqrt(2)))
    lo = z2p(2*z0 + (z0 - 1.959963985) / (1 - a*(z0 - 1.959963985)))
    hi = z2p(2*z0 + (z0 + 1.959963985) / (1 - a*(z0 + 1.959963985)))
    # BCa adjusted levels can leave [0,1] when the statistic is near-degenerate
    # (very small counts, e.g. Tester / Requirements Engineer) -> clamp, and flag it.
    import math as _m
    if not (_m.isfinite(lo) and _m.isfinite(hi)):
        lo, hi = (0.0, 1.0) if _m.isnan(lo) and _m.isnan(hi) else (0.0, 1.0)
    clamped = not (0 <= lo <= 1 and 0 <= hi <= 1)
    lo, hi = min(max(lo, 1e-9), 1-1e-9), min(max(hi, 1e-9), 1-1e-9)
    return np.array([np.quantile(boots, lo), np.quantile(boots, hi)]), clamped

def share_boot(mask_2d, weights=None, strat=None, B=B, seed=SEED):
    n, k = mask_2d.shape
    r = np.random.default_rng(seed)
    w = np.ones(n) if weights is None else np.asarray(weights, float)
    ww = w / w.sum()
    est = np.empty((B, k))
    for b in range(B):
        if strat is None:
            idx = r.integers(0, n, n)
        else:
            idx = np.concatenate([r.integers(0, len(p), len(p))
                                  for p in [np.flatnonzero(strat == lv) for lv in np.unique(strat)]])
        wb = w[idx] / w[idx].sum() if weights is not None else np.full(n, 1/n)
        est[b] = wb @ mask_2d[idx]
    theta = ww @ mask_2d
    pc = np.quantile(est, [0.025, 0.975], axis=0)
    out = {"theta": theta, "boot_se": est.std(0, ddof=1), "pct_lo": pc[0], "pct_hi": pc[1],
           "n": n, "reps": est}
    if weights is None and strat is None:
        bc = [bca_ci(mask_2d[:, j], theta[j], est[:, j]) for j in range(k)]
        out["bca"] = np.column_stack([b[0] for b in bc]).T
        out["bca_clamped"] = [bool(b[1]) for b in bc]
    return out

P("\n=========== PRIMARY SPEC: 'quoted' share among the 194 respondents who answered Q8 ===========")
prim = share_boot(Mblock)
for j, r in enumerate(names):
    P(f"  {r:30s} n_quoted={int(np.nansum(M_masked[:,j])):3d}  share={prim['theta'][j]*100:7.3f}%  "
      f"bootSE={prim['boot_se'][j]*100:5.3f}pp  CI95(pct)=[{prim['pct_lo'][j]*100:7.3f},{prim['pct_hi'][j]*100:7.3f}]  "
      f"CI95(BCa)=[{prim['bca'][j,0]*100:7.3f},{prim['bca'][j,1]*100:7.3f}]"
      + ("  [BCa level clamped: near-degenerate count]" if prim["bca_clamped"][j] else ""))
order = np.argsort(-prim["theta"])
P("  ranking: " + " > ".join(f"{names[j]} {prim['theta'][j]*100:.3f}%" for j in order))
pairs = Counter(tuple(sorted(NARR[np.argsort(-row)[:2]])) for row in prim["reps"])
tgt_pair = tuple(sorted(["Project Lead / Project Manager", "Data Scientist"]))
P(f"  bootstrap share of replicates whose top-2 == (Project Lead, Data Scientist): {pairs[tgt_pair]/B:.4f}")
P(f"  bootstrap share where Project Lead is top-1: "
  f"{np.mean([np.argmax(row)==names.index('Project Lead / Project Manager') for row in prim['reps']]):.4f}")
P("  next most frequent top-2 pairs: " + str({k: round(v/B,4) for k,v in pairs.most_common(4)}))

# ---- S3: fold the 19 Q8_Others free-text mentions into canonical roles they name
KEYS = [("Business Analyst", r"business"),
        ("Solution Architect", r"architect"),
        ("Data Scientist", r"data (scientist|lead|manager)"),
        ("Project Lead / Project Manager", r"(product owner|tech lead|lead|manager|director|ceo|cto|head|competency)"),
        ("Developer", r"(software engineer|developer|sre)"),
        ("Requirements Engineer", r"requirement")]
free = df["Q8_ML_Addressing_Others_Free"].fillna("").to_numpy()
others_q = (df["Q8_ML_Addressing_Others"] == "quoted").to_numpy()
fold = np.zeros((len(df), len(names))); assigned = []
for i, txt in enumerate(free):
    if others_q[i] and txt.strip() not in ("", "nan"):
        hit = next((r for r, k in KEYS if re.search(k, txt.lower())), None)
        if hit:
            fold[i, names.index(hit)] = 1.0; assigned.append((txt.strip(), hit))
ans_np, role_np = answered.to_numpy(), role_known.to_numpy()
s1 = share_boot(M[ans_np & role_np])
s2 = share_boot(np.nan_to_num(M_masked, nan=0.0))
s3 = share_boot(np.clip(M[ans_np] + fold[ans_np], 0, 1))
s4 = share_boot(M[ans_np], strat=df.loc[answered, "D4_Role"].fillna("(role missing)").to_numpy())
proj = pd.to_numeric(df["D7_Total_ML_Projects"], errors="coerce").to_numpy(dtype=float)
w = np.where(np.isnan(proj) | (proj <= 0), 1.0, np.minimum(proj, 10.0))
s5 = share_boot(M[ans_np], weights=w[ans_np])
sens = {"S1 n=180 (Q8 answered & role known)": s1, "S2 n=276 (-77 -> not quoted)": s2,
        "S3 Others free-text folded (n=194)": s3, "S4 stratified by D4_Role (n=194)": s4,
        "S5 project-count weighted (D7 cap 10)": s5}
P(f"\n[S3] Q8 'Others' free texts folded: {len(assigned)} of "
  f"{int(others_q.sum())} mentions -> {Counter(h for _,h in assigned).most_common()}")

pu = df["Q1_ML_Life_Cycle_Importance_Problem_Understanding"]
b1 = pu.isin(["High Relevance", "Extremely Relevant"]).to_numpy()
q10c = [c for c in df.columns if c.startswith("Q10_ML_Documentation") and not c.endswith("Free")]
b2 = df[q10c].apply(lambda s: s.eq("quoted")).any(axis=1).to_numpy() & df[q10c[0]].notna().to_numpy()
q12c = ["Q12_ML_Most_Difficult_Activity_Eliciting_Analyzing",
        "Q12_ML_Most_Difficult_Activity_Aligning_Requirements_Data"]
b3 = df[q12c].apply(lambda s: s.eq("quoted")).any(axis=1).to_numpy() & df[q12c[0]].notna().to_numpy()
bridges = {"B1 requirements High/Extremely relevant (Q1)": (b1, int(b1.sum())),
           "B2 >=1 ML requirements doc practice (Q10)": (b2, int(b2.sum())),
           "B3 requirements difficulty item (Q12)": (b3, int(b3.sum()))}

P("\n=========== SENSITIVITY + BRIDGE SPECS: top-2 roles (and PL / DS shares) ===========")
sets = {"PRIMARY n=194 (Q8 quoted)": set(np.array(names)[order[:2]])}
P(f"{'spec':46s} {'n':>4s}  top1                                     top2                       "
  f"{'PL%':>7s} {'DS%':>7s}")
def short(x): return x.replace(" /", "/").replace(" (free text)", "")
def line(lbl, r):
    o = np.argsort(-r["theta"])
    P(f"{lbl:46s} {r['n']:4d}  {short(names[o[0]]):38s} {short(names[o[1]]):26s} "
      f"{r['theta'][0]*100:7.3f} {r['theta'][names.index('Data Scientist')]*100:7.3f}")
    return set(NARR[o[:2]])
P(f"{'PRIMARY n=194 (Q8 quoted)':46s} {prim['n']:4d}  {short(names[order[0]]):38s} "
  f"{short(names[order[1]]):26s} {prim['theta'][0]*100:7.3f} "
  f"{prim['theta'][names.index('Data Scientist')]*100:7.3f}")
for lbl, r in sens.items():
    sets[lbl] = line(lbl, r)
for lbl, (m, nn) in bridges.items():
    r = share_boot(M[m]); sens[lbl] = r; sets[lbl] = line(lbl, r)

target = {"Project Lead / Project Manager", "Data Scientist"}
n_ok = sum(1 for v in sets.values() if v == target)
P(f"\n[acceptance] specs with top-2 == (Project Lead, Data Scientist): {n_ok} / {len(sets)}")
for lbl, v in sets.items():
    if v != target:
        P(f"    exception: {lbl:46s} -> {sorted(short(x) for x in v)}")

P("\n=========== CONDITIONAL P(Q8_role=quoted | own D4_Role=role) - fragility illustration ===========")
OWN = {r: r for r in names[:-1]}
role_txt = df["D4_Role"].fillna("").to_numpy()
cond_rows = []
for rname in names[:-1]:
    sel = (ans_np & (role_txt == OWN[rname]))[ans_np]
    x = Mblock[sel, names.index(rname)].reshape(-1, 1)
    if sel.sum() == 0:
        continue
    r = share_boot(x)
    cond_rows.append((rname, int(sel.sum()), x.mean()*100, r["pct_lo"][0]*100, r["pct_hi"][0]*100))
    P(f"  {rname:30s} n={int(sel.sum()):3d}  P={x.mean()*100:7.3f}%  CI95(pct)=[{r['pct_lo'][0]*100:6.2f},{r['pct_hi'][0]*100:6.2f}]"
      f"  width={(r['pct_hi'][0]-r['pct_lo'][0])*100:6.2f}pp")

P("\n=========== CI-SCALE DIAGNOSIS of the two quoted reference intervals ===========")
for pt, lo, hi in [(49.6, 49.219, 49.981), (61.389, 60.955, 61.822)]:
    hw = (hi-lo)/2; se = hw/1.96/100; p_ = pt/100
    se194 = np.sqrt(p_*(1-p_)/194)
    P(f"  reference {pt}% CI[{lo},{hi}]  symmetric={abs((hi-pt)-(pt-lo))<0.002}  halfwidth={hw:.3f}pp  "
      f"implied SE={se*100:.4f}pp  implied Wald n={p_*(1-p_)/se**2:,.0f}  ||  respondent-level SE at n=194="
      f"{se194*100:.3f}pp (CI +/-{1.96*se194*100:.3f}pp) -> reference interval is {se194/se:.1f}x too narrow")
P(f"  a bootstrap over the flattened 276x202={276*202:,}-cell table would give SE={np.sqrt(.496*.504/55752)*100:.3f}pp "
  f"(reference halfwidths 0.381 / 0.434 pp) -> same order of magnitude")
P(f"  observed bootstrap SE here: PL={prim['boot_se'][0]*100:.3f}pp, DS={prim['boot_se'][names.index('Data Scientist')]*100:.3f}pp "
  f"-> reproducible 95% CI halfwidth ~{1.96*prim['boot_se'][0]*100:.2f}pp, i.e. ~9x the quoted one")

P("\n=========== distance of reproduced estimates to the quoted targets ===========")
for lbl, r in [("PRIMARY n=194", prim)] + list(sens.items()):
    pl, ds = r["theta"][0]*100, r["theta"][names.index("Data Scientist")]*100
    P(f"  {lbl:42s} PL={pl:7.3f} (|d to 61.389|={abs(pl-61.389):6.3f})   DS={ds:7.3f} (|d to 49.6|={abs(ds-49.6):5.3f})")
P("  coincidence check (NOT used for selection): among the 112 multiple-response columns, the")
P("  closest unconditional shares to the quoted targets are Q11_ML_NFRs_Data_Quality=61.340% and")
P("  Q9_ML_Elicitation_Interviews=50.000% - i.e. with 112 candidates, 1-pp 'hits' are expected by chance.")


d = prim["reps"][:, 0] - prim["reps"][:, names.index("Data Scientist")]
P(f"  PL - Data Scientist difference: {(prim['theta'][0]-prim['theta'][names.index('Data Scientist')])*100:.3f}pp, "
  f"95%CI(pct)=[{np.quantile(d,0.025)*100:.3f},{np.quantile(d,0.975)*100:.3f}]pp  "
  f"P(PL>DS) over replicates={np.mean(d>0):.4f} -> the two leaders are statistically indistinguishable")

P("\n=========== POST-HOC EXPLORATION (disclosed explicitly; does NOT change the primary spec) ===========")
P("Legitimate sample restrictions enumerated up front and all combinations scored against the two")
P("quoted targets. Reported for transparency only: with this many candidate subsets a <1 pp 'hit' is")
P("expected by chance, so no combination is used to select the answer.")
other_role = (df["D4_Role"] == "Other, which one?").to_numpy()
own_any = np.zeros(len(df), bool)
for rname in names[:-1]:
    sel_role = role_txt == OWN[rname]
    own_any |= sel_role & (df[ROLES[rname]] == "quoted").to_numpy()
opts = {"answered": np.ones(len(df), bool), "role_known": role_known.to_numpy(),
        "role!=Other": ~other_role, "drop_own_role_selfratings": ~own_any}
wgrid = {"unweighted": None, "project-count(D7,cap10)": np.minimum(np.nan_to_num(proj, nan=1.0), 10.0)}
import itertools
rows = []
for k in range(1, len(opts) + 1):
    for combo in itertools.combinations(opts, k):
        m = np.ones(len(df), bool)
        for c in combo:
            m &= opts[c]
        if m.sum() < 50:
            continue
        mb = m[ans_np]
        for wn, wv in wgrid.items():
            r = share_boot(Mblock[mb], weights=None if wv is None else wv[ans_np][mb])
            pl, ds = r["theta"][0]*100, r["theta"][names.index("Data Scientist")]*100
            rows.append(("+".join(combo), wn, int(mb.sum()), pl, ds, abs(pl-61.389), abs(ds-49.6),
                         abs(pl-61.389)+abs(ds-49.6),
                         set(NARR[np.argsort(-r["theta"])[:2]])))
rows.sort(key=lambda t: t[7])
P(f"  {'subset':62s} {'weight':22s} {'n':>4s} {'PL%':>7s} {'DS%':>7s} {'|dPL|':>6s} {'|dDS|':>6s}  top-2")
for t in rows[:8]:
    P(f"  {t[0]:62s} {t[1]:22s} {t[2]:4d} {t[3]:7.3f} {t[4]:7.3f} {t[5]:6.3f} {t[6]:6.3f}  "
      f"{sorted(short(x) for x in t[8])}")
P(f"  (n_combinations_scored={len(rows)}; primary spec |dPL|+|dDS| = "
  f"{abs(prim['theta'][0]*100-61.389)+abs(prim['theta'][names.index('Data Scientist')]*100-49.6):.3f}pp)")
posthoc_top2 = rows[0][8] == target
P(f"  best-matching post-hoc subset still yields top-2 == (Project Lead, Data Scientist): {posthoc_top2}")

tbl = pd.DataFrame({"role": names,
    "n_quoted_primary": [int(np.nansum(M_masked[:, j])) for j in range(len(names))],
    "share_pct_primary": prim["theta"]*100, "boot_se_pp": prim["boot_se"]*100,
    "ci95_pct_lo": prim["pct_lo"]*100, "ci95_pct_hi": prim["pct_hi"]*100,
    "ci95_bca_lo": prim["bca"][:, 0]*100, "ci95_bca_hi": prim["bca"][:, 1]*100,
    "S1_n180": s1["theta"]*100, "S2_n276": s2["theta"]*100, "S3_others_folded": s3["theta"]*100,
    "S4_strat": s4["theta"]*100, "S5_proj_weighted": s5["theta"]*100})
for lbl, r in [(k, v) for k, v in sens.items() if k.startswith("B")]:
    tbl["share_" + lbl.split(" ")[0]] = r["theta"]*100
tbl["conditional_n"] = [dict((c[0], c[1]) for c in cond_rows).get(r, np.nan) for r in names]
tbl["conditional_share_pct"] = [dict((c[0], c[2]) for c in cond_rows).get(r, np.nan) for r in names]
tbl.round(4).to_csv("analysis/02_results_table.csv", index=False)
json.dump({"seed": SEED, "B": B, "n_primary": int(prim["n"]),
  "primary": {names[j]: dict(n_quoted=int(np.nansum(M_masked[:, j])), share_pct=round(prim["theta"][j]*100, 4),
      boot_se_pp=round(prim["boot_se"][j]*100, 4),
      ci95_percentile=[round(prim["pct_lo"][j]*100, 4), round(prim["pct_hi"][j]*100, 4)],
      ci95_bca=[round(prim["bca"][j, 0]*100, 4), round(prim["bca"][j, 1]*100, 4)]) for j in range(len(names))},
  "top2_pair_invariant_specs": f"{n_ok}/{len(sets)}",
  "specs": {k: sorted(short(x) for x in v) for k, v in sets.items()},
  "conditional": [dict(zip(["role", "n", "share_pct", "ci_lo", "ci_hi"], c)) for c in cond_rows],
  "others_free_folded": assigned,
  "post_hoc_best_subsets": [dict(zip(["subset","weight","n","PL","DS","dPL","dDS"], t[:7])) for t in rows[:5]]}, open("analysis/02_results.json", "w"), indent=1)
P("\n[artifacts] analysis/02_results_table.csv, analysis/02_results.json written (seed=20261025, B=10000)")
open("analysis/02_main_analysis_output.txt", "w").write("\n".join(log) + "\n")
