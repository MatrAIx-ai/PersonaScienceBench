#!/usr/bin/env python3
"""
Q9 Requirements-Elicitation techniques for ML-enabled systems.

Question: which elicitation technique is the most commonly used?

Approved design decisions
-------------------------
* "Use of technique" := raw value == 'quoted'  (the six Q9 columns are binary
  multi-select / "mentioned" encodings, NOT Likert scales).
* Negative codes ('-77' in the six technique columns, '-66'/'-99' in
  Q9_ML_Elicitation_Others_Free) := structurally not-displayed / not-answered
  -> MISSING, removed from BOTH numerator and denominator.
  Primary denominator = respondents with a valid Q9 response (n = 194).
* Primary evidence = stability of the ranking across denominator/numerator
  rules + row-level PAIRED bootstrap of the top-1 vs runner-up gap.
* 'Others' is descriptive evidence only (5.670%, noisy free text) and is NOT
  eligible for the "most used technique" verdict.

Data-integrity items are LOGGED, not silently dropped:
  Q9_ML_Elicitation_Others_Free has 1 NaN row and rows flagged 'quoted' without
  usable free text. They stay in the Others count (logged in
  output/data_integrity_log.csv) and cannot affect the verdict.
"""
import numpy as np
import pandas as pd
from scipy.stats import binomtest, norm

CSV, OUT = "data/requirements_engineering_for_ML-enabled_systems.csv", "output"
TECH = ["Q9_ML_Elicitation_Interviews", "Q9_ML_Elicitation_Scenarios",
        "Q9_ML_Elicitation_Prototyping", "Q9_ML_Elicitation_Workshops_Meetings",
        "Q9_ML_Elicitation_Observation", "Q9_ML_Elicitation_Others"]
NAMED = TECH[:-1]
FREE, STATUS = "Q9_ML_Elicitation_Others_Free", "Status"
B, SEEDS = 10_000, [42, 0, 12345]
TARGET_PCT, TARGET_CI = 69.399, (69.062, 69.735)
SHORT = lambda c: c.replace("Q9_ML_Elicitation_", "")

df = pd.read_csv(CSV)
assert df.shape == (276, 202), df.shape
log = []

print("=" * 78, "\nSTEP 1  input\n", "=" * 78, sep="")
print(f"file {CSV} | shape {df.shape} | unique IDs {df['ID'].nunique()} "
      f"(dups {int(df['ID'].duplicated().sum())})")
print(df[STATUS].value_counts().to_string())
for c in TECH + [FREE, STATUS]:
    assert c in df.columns, c
print("columns used: " + ", ".join(TECH + [FREE, STATUS]))

print("\n" + "=" * 78 + "\nSTEP 2  raw value distributions and negative-code audit\n" + "=" * 78)
tabs = []
for c in TECH + [FREE]:
    vc = df[c].value_counts(dropna=False)
    tabs.append(vc.rename(c))
    print(f"\n{c} (dtype={df[c].dtype})\n{vc.to_string()}")
pd.concat(tabs, axis=1).fillna(0).astype(int).to_csv(f"{OUT}/raw_value_counts.csv")

miss_code = df[TECH].apply(lambda s: s.astype(str).str.startswith("-"))
same = miss_code.eq(miss_code[TECH[0]], axis=0).all().all()
miss = df[TECH[0]] == "-77"
print(f"\n'-77' rows identical across all six columns: {bool(same)} | n = {int(miss.sum())}")
print(f"(Q9 '-77') == (Others_Free == '-66'): {bool((miss == (df[FREE] == '-66')).all())}")
ct = pd.crosstab(df[STATUS], miss)
print(ct.to_string())
susp_neg = int(ct.loc["Suspended (22)", True]); susp_tot = int((df[STATUS] == "Suspended (22)").sum())
print(f"-> {susp_neg}/{susp_tot} Suspended respondents have Q9 == '-77' (structural non-display)")
log.append(dict(item="Q9 '-77' rows", detail=f"n={int(miss.sum())}, identical across all 6 columns; "
               f"{susp_neg}/{susp_tot} are Status='Suspended (22)'",
               action="treated as MISSING -> removed from numerator AND denominator (primary spec)"))
log.append(dict(item="Others_Free negative codes", detail="-66 on the same 82 rows; -99 on the 183 valid "
               "rows that did not select Others", action="treated as MISSING / not applicable"))

print("\n" + "=" * 78 + "\nSTEP 3  recode quoted->1, 'not quoted'->0, negative codes->NaN\n" + "=" * 78)
bin_df = df[TECH].apply(lambda s: s.map({"quoted": 1.0, "not quoted": 0.0}))
assert int(bin_df.isna().sum().sum()) == 6 * int(miss.sum())
valid = bin_df.notna().all(axis=1)
print(f"valid Q9 respondents (primary denominator): n = {int(valid.sum())} | excluded '-77': n = {int((~valid).sum())}")
oq = df["Q9_ML_Elicitation_Others"] == "quoted"
ftxt = ~df[FREE].astype(str).str.startswith("-") & df[FREE].notna()
n_q_no_txt, n_txt_no_q = int((oq & ~ftxt).sum()), int((~oq & ftxt).sum())
print("\nOthers vs Others_Free consistency")
print(f"  'quoted' rows: {int(oq.sum())} | 'quoted' without usable free text: {n_q_no_txt} | "
      f"free text without 'quoted': {n_txt_no_q} | Others_Free NaN rows: {int(df[FREE].isna().sum())}")
log.append(dict(item="Others 'quoted' without free text", detail=f"n={n_q_no_txt} (includes the single NaN in Others_Free)",
               action="RETAINED in Others count; Others is descriptive only -> no effect on verdict"))
log.append(dict(item="free text without 'quoted' flag", detail=f"n={n_txt_no_q}",
               action="RETAINED as-is (no re-coding); does not enter the verdict"))
pd.DataFrame(log).to_csv(f"{OUT}/data_integrity_log.csv", index=False)

print("\n" + "=" * 78 + "\nSTEP 4  proportions: primary spec + sensitivity grid\n" + "=" * 78)

def props(mask, negatives_in_denominator):
    """% using each technique for row mask `mask` under a numerator/denominator rule."""
    sub = bin_df.loc[mask]
    num = sub.sum(axis=0)
    den = pd.Series(int(mask.sum()), index=sub.columns) if negatives_in_denominator \
        else sub.notna().sum(axis=0)
    return num, den, num / den * 100

any_quote = (bin_df.sum(axis=1) >= 1)
masks = {
    "D=276 all respondents": pd.Series(True, index=df.index),
    "D=194 valid Q9 (PRIMARY)": valid,
    "D=174 valid & quoted >=1 technique": valid & any_quote,
    "D=164 Status=='Completed (31)'": (df[STATUS] == "Completed (31)") & valid,
    "D=188 Completed + Completed-after-break": df[STATUS].isin(
        ["Completed (31)", "Completed after break (32)"]) & valid,
}
rules = {"A: use := quoted; negative codes = missing (out of numerator AND denominator)": False,
         "B: use := quoted; negative codes kept in the denominator (counted as non-use)": True}
rows = []
for mname, mask in masks.items():
    for rname, neg_in_den in rules.items():
        num, den, p = props(mask, neg_in_den)
        ns = p[NAMED].sort_values(ascending=False)
        rec = {"spec": mname, "numerator_denominator_rule": rname, "n_denominator": int(den.iloc[0])}
        for c in TECH:
            rec[SHORT(c)] = round(float(p[c]), 3)
        rec["top_named_technique"] = SHORT(ns.index[0])
        rec["runner_up"] = SHORT(ns.index[1])
        rec["gap_pp_vs_runner_up"] = round(float(ns.iloc[0] - ns.iloc[1]), 3)
        rec["interviews_minus_69.399_pp"] = round(float(p["Q9_ML_Elicitation_Interviews"] - TARGET_PCT), 3)
        rows.append(rec)
sens = pd.DataFrame(rows)
sens.insert(0, "id", [f"S{i+1}" for i in range(len(sens))])
print(sens.to_string(index=False))
sens.to_csv(f"{OUT}/sensitivity_grid.csv", index=False)

num_p, den_p, p_p = props(valid, False)
print("\nPRIMARY SPEC (n=194; use := 'quoted'; negatives removed from both):")
prim = pd.DataFrame({"quoted_n": num_p.astype(int), "n_valid": den_p.astype(int),
                     "pct": p_p.round(3)}).sort_values("pct", ascending=False)
prim["eligible_for_verdict"] = [c != "Q9_ML_Elicitation_Others" for c in prim.index]
print(prim.to_string())
prim.to_csv(f"{OUT}/primary_proportions.csv")

print("\n" + "=" * 78 + f"\nSTEP 5  row-level paired bootstrap  B={B}, seeds={SEEDS}\n" + "=" * 78)
X = bin_df.loc[valid, TECH].to_numpy(float)
n = X.shape[0]
iv = TECH.index("Q9_ML_Elicitation_Interviews")
others_idx = [TECH.index(c) for c in NAMED if c != "Q9_ML_Elicitation_Interviews"]
tot = X.sum(axis=0)
jack = (np.tile(tot, (n, 1)) - X) / (n - 1) * 100        # leave-one-out, closed form

def bca_ci(p, boot, jackcol, alpha=0.05):
    z0 = norm.ppf((np.sum(boot < p) + 0.5) / (len(boot) + 1))
    jm = jackcol.mean()
    a = np.sum((jm - jackcol) ** 3) / (6.0 * (np.sum((jm - jackcol) ** 2) ** 1.5) + 1e-300)
    q = lambda z: norm.cdf(2 * z0 + (z0 + z) / (1 - a * (z0 + z)))
    return float(np.quantile(boot, q(norm.ppf(alpha / 2)))), float(np.quantile(boot, q(norm.ppf(1 - alpha / 2))))

boot_rows, diff_rows, boot_iv_seed42 = [], [], None
for seed in SEEDS:
    rng = np.random.default_rng(seed)
    P = X[rng.integers(0, n, size=(B, n))].mean(axis=1) * 100        # (B, 6)
    if seed == 42:
        boot_iv_seed42 = P
    for j, c in enumerate(TECH):
        boot, p_hat = P[:, j], X[:, j].mean()
        lo, hi = np.percentile(boot, [2.5, 97.5])
        blo, bhi = bca_ci(p_hat * 100, boot, jack[:, j])
        se = np.sqrt(p_hat * (1 - p_hat) / n) * 100
        others = [k for k in range(len(TECH)) if k != j]
        boot_rows.append(dict(seed=seed, technique=SHORT(c),
                              point_pct=round(p_hat * 100, 3), boot_mean_pct=round(float(boot.mean()), 3),
                              boot_se_pp=round(float(boot.std(ddof=1)), 3),
                              ci95_perc_lo=round(float(lo), 3), ci95_perc_hi=round(float(hi), 3),
                              ci95_bca_lo=round(float(blo), 3), ci95_bca_hi=round(float(bhi), 3),
                              ci95_normal_lo=round(p_hat * 100 - 1.959963985 * se, 3),
                              ci95_normal_hi=round(p_hat * 100 + 1.959963985 * se, 3),
                              boot_frac_gt_all_others=round(float(np.mean(boot > P[:, others].max(axis=1))), 4)))
    for k in others_idx:
        d = P[:, iv] - P[:, k]
        diff_rows.append(dict(seed=seed, contrast=f"Interviews - {SHORT(TECH[k])}",
                              point_diff_pp=round(float((X[:, iv] - X[:, k]).mean() * 100), 3),
                              boot_mean_pp=round(float(d.mean()), 3), boot_se_pp=round(float(d.std(ddof=1)), 3),
                              ci95_lo=round(float(np.percentile(d, 2.5)), 3),
                              ci95_hi=round(float(np.percentile(d, 97.5)), 3),
                              boot_p_one_sided=round(float(np.mean(d <= 0)), 5),
                              boot_p_one_sided_midp=round(float(np.mean(d < 0) + 0.5 * np.mean(d == 0)), 5),
                              frac_replicates_tied=round(float(np.mean(d == 0)), 4),
                              frac_replicates_iv_gt=round(float(np.mean(d > 0)), 4)))
    dmax = P[:, iv] - P[:, others_idx].max(axis=1)
    diff_rows.append(dict(seed=seed, contrast="Interviews - best_other_named_technique",
                          point_diff_pp=round(float((X[:, iv].mean() - X[:, others_idx].mean(axis=0).max()) * 100), 3),
                          boot_mean_pp=round(float(dmax.mean()), 3), boot_se_pp=round(float(dmax.std(ddof=1)), 3),
                          ci95_lo=round(float(np.percentile(dmax, 2.5)), 3), ci95_hi=round(float(np.percentile(dmax, 97.5)), 3),
                          boot_p_one_sided=round(float(np.mean(dmax <= 0)), 5),
                          boot_p_one_sided_midp=round(float(np.mean(dmax < 0) + 0.5 * np.mean(dmax == 0)), 5),
                          frac_replicates_tied=round(float(np.mean(dmax == 0)), 4),
                          frac_replicates_iv_gt=round(float(np.mean(dmax > 0)), 4)))

bt, dt = pd.DataFrame(boot_rows), pd.DataFrame(diff_rows)
bt.to_csv(f"{OUT}/bootstrap_technique_cis.csv", index=False)
dt.to_csv(f"{OUT}/bootstrap_paired_contrasts.csv", index=False)
print("\nper-technique bootstrap (seed=42):")
print(bt[bt.seed == 42].to_string(index=False))
print("\nseed sensitivity (Interviews percentile CI by seed):")
print(bt[bt.technique == "Interviews"][["seed", "point_pct", "boot_mean_pct", "ci95_perc_lo", "ci95_perc_hi"]].to_string(index=False))
print("\npaired contrasts (Interviews vs each runner-up):")
print(dt.to_string(index=False))
print("\nexact McNemar complement (paired discordant counts, one-sided):")
for c in NAMED[1:]:
    b_ = int(((bin_df["Q9_ML_Elicitation_Interviews"] == 1) & (bin_df[c] == 0)).sum())
    cc = int(((bin_df["Q9_ML_Elicitation_Interviews"] == 0) & (bin_df[c] == 1)).sum())
    print(f"  Interviews vs {SHORT(c):20s} b={b_:3d} c={cc:3d} n_disc={b_+cc:3d} "
          f"p={binomtest(b_, b_ + cc, 0.5, alternative='greater').pvalue:.3g}")

print("\n" + "=" * 78 + "\nSTEP 6  deviation vs the reported 69.399% / [69.062, 69.735]\n" + "=" * 78)
half = (TARGET_CI[1] - TARGET_CI[0]) / 2.0
pt = TARGET_PCT / 100
n_implied = pt * (1 - pt) / ((half / 100) / 1.959963985) ** 2
dev = sens[["id", "spec", "numerator_denominator_rule", "n_denominator", "Interviews",
            "top_named_technique", "interviews_minus_69.399_pp"]].copy()
dev = dev.rename(columns={"interviews_minus_69.399_pp": "abs_dev_pp_vs_69.399"})
dev["dev_vs_ci_lo_pp"] = (dev["Interviews"] - TARGET_CI[0]).round(3)
dev["dev_vs_ci_hi_pp"] = (dev["Interviews"] - TARGET_CI[1]).round(3)
dev["within_reported_ci"] = dev["Interviews"].between(*TARGET_CI)
print(dev.to_string(index=False))
dev.to_csv(f"{OUT}/deviation_vs_reported_value.csv", index=False)
own = bt[(bt.seed == 42) & (bt.technique == "Interviews")].iloc[0]
own_hw = (own.ci95_perc_hi - own.ci95_perc_lo) / 2
print(f"\nreported CI half-width               : {half:.4f} pp -> implied n ~ {n_implied:,.0f}")
print(f"own percentile CI half-width (n=194) : {own_hw:.3f} pp "
      f"(CI [{own.ci95_perc_lo:.3f}, {own.ci95_perc_hi:.3f}]); normal-approx half-width "
      f"{1.959963985*np.sqrt(pt*(1-pt)/194)*100:.2f} pp")
print("=> no row-level bootstrap over <=276 rows can produce a +/-0.34 pp interval:")
print("   the reported point estimate/CI must originate from the reference implementation's")
print("   own cleaned or weighted dataset. This file reproduces the RANKING, not the level.")

print("\n" + "=" * 78 + "\nSTEP 7  verdict\n" + "=" * 78)
ns = p_p[NAMED].sort_values(ascending=False)
for c, v in ns.items():
    print(f"  {SHORT(c):22s} {v:6.3f}%  ({int(num_p[c])}/{int(den_p[c])})")
print(f"  {'Others (descriptive)':22s} {p_p['Q9_ML_Elicitation_Others']:6.3f}%  "
      f"({int(num_p['Q9_ML_Elicitation_Others'])}/{int(den_p['Q9_ML_Elicitation_Others'])})  [excluded from verdict]")
top = SHORT(ns.index[0])
print(f"\ntop named technique under every sensitivity spec: {top} "
      f"(unique winners = {sorted(sens.top_named_technique.unique())})")
print("\nvariables and relation relied upon")
print("  columns : " + ", ".join(TECH + [FREE, STATUS]))
print("  relation: negative codes ('-77' / '-66' / '-99') -> structural missingness")
print("            -> changes the valid denominator (276 -> 194) -> changes the ABSOLUTE")
print("            percentage of every technique -> does NOT change the ordering among techniques.")
print("\nartifacts in output/: raw_value_counts.csv, data_integrity_log.csv, primary_proportions.csv,")
print("  sensitivity_grid.csv, bootstrap_technique_cis.csv, bootstrap_paired_contrasts.csv,")
print("  deviation_vs_reported_value.csv")
