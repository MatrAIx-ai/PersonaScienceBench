#!/usr/bin/env python3
"""Build output/results_summary.md from the CSVs produced by q9_elicitation_bootstrap.py."""
import pandas as pd

def md(df, cols=None):
    d = df if cols is None else df[cols]
    head = "| " + " | ".join(map(str, d.columns)) + " |"
    sep = "|" + "|".join(["---"] * len(d.columns)) + "|"
    rows = ["| " + " | ".join("" if pd.isna(v) else (f"{v:.4g}" if isinstance(v, float) else str(v))
                              for v in r) + " |" for r in d.itertuples(index=False)]
    return "\n".join([head, sep] + rows)

prim = pd.read_csv('output/primary_proportions.csv', index_col=0)
bt = pd.read_csv('output/bootstrap_technique_cis.csv')
dt = pd.read_csv('output/bootstrap_paired_contrasts.csv')
sens = pd.read_csv('output/sensitivity_grid.csv')
dev = pd.read_csv('output/deviation_vs_reported_value.csv')
b42 = bt[bt.seed == 42].set_index('technique')

lines = ["# Q9 requirements-elicitation techniques - results",
         "",
         "Primary spec: use := raw value == 'quoted'; negative codes ('-77' in the six technique columns, "
         "'-66'/'-99' in Q9_ML_Elicitation_Others_Free) = structural non-display -> removed from numerator AND "
         "denominator. n_valid = 194 of 276 respondents (the 82 '-77' rows are 82/88 of the "
         "Status = 'Suspended (22)' drop-outs).",
         "", "## 1. Primary proportions (n = 194) and bootstrap intervals (B = 10,000, seed 42)",
         "| technique | quoted n | pct % | 95% CI percentile | 95% CI BCa | 95% CI normal | % replicates above all others |",
         "|---|---|---|---|---|---|---|"]
for c, r in prim.iterrows():
    t = c.replace('Q9_ML_Elicitation_', '')
    b = b42.loc[t]
    label = t + (" *(descriptive only, excluded from verdict)*" if t == 'Others' else "")
    lines.append(f"| {label} | {int(r.quoted_n)} | {r.pct:.3f} | [{b.ci95_perc_lo:.2f}, {b.ci95_perc_hi:.2f}] | "
                 f"[{b.ci95_bca_lo:.2f}, {b.ci95_bca_hi:.2f}] | [{b.ci95_normal_lo:.2f}, {b.ci95_normal_hi:.2f}] | "
                 f"{b.boot_frac_gt_all_others:.4f} |")
mcn = {'Interviews - Scenarios': '0.0167', 'Interviews - Prototyping': '0.0140',
       'Interviews - Workshops_Meetings': '0.00477', 'Interviews - Observation': '0.00092',
       'Interviews - best_other_named_technique': 'n/a (max over others)'}
lines += ["", "## 2. Paired bootstrap contrasts (row-level, paired, B = 10,000)",
          "| contrast (seed 42) | point diff pp | boot SE | 95% CI | one-sided p-hat | mid-p | McNemar exact one-sided |",
          "|---|---|---|---|---|---|---|"]
for _, r in dt[dt.seed == 42].iterrows():
    lines.append(f"| {r.contrast} | {r.point_diff_pp:.3f} | {r.boot_se_pp:.3f} | [{r.ci95_lo:.2f}, {r.ci95_hi:.2f}] | "
                 f"{r.boot_p_one_sided:.4f} | {r.boot_p_one_sided_midp:.4f} | {mcn[r.contrast]} |")
lines += ["",
          "Seed sensitivity (42 / 0 / 12345): percentile CIs identical to 3 d.p.; one-sided p-hat for "
          "Interviews - Scenarios = 0.0142 / 0.0134 / 0.0142; Interviews - best other = 0.0268 / 0.0251 / 0.0277 "
          "=> conclusions are seed-insensitive (Monte-Carlo error < 0.15 pp).",
          "", "## 3. Sensitivity grid (denominator x numerator rule)",
          md(sens, ['id', 'spec', 'numerator_denominator_rule', 'n_denominator', 'Interviews', 'Scenarios',
                    'Prototyping', 'Workshops_Meetings', 'Observation', 'Others', 'top_named_technique',
                    'runner_up', 'gap_pp_vs_runner_up']),
          "", "Rule A vs rule B differ only for the D=276 spec (rows S1/S2); everywhere else the '-77' rows are "
          "already absent, which is exactly why the negative-code decision moves the level (35.1% -> 50.0%) but "
          "never the ranking.",
          "", "## 4. Deviation vs the figure quoted in the question (69.399%, 95% CI [69.062, 69.735])",
          md(dev),
          "",
          "The quoted CI half-width is 0.3365 pp, implying an effective n ~ 72,000; the own CI half-width at "
          "n = 194 is 7.22 pp (normal approximation 6.48 pp). No row-level bootstrap over <= 276 rows can yield "
          "a +/-0.34 pp interval, and 69.399% is not an attainable integer fraction (97/0.69399 = 139.77; "
          "no k/n with n <= 300 equals it). The quoted level therefore belongs to the reference implementation's "
          "own cleaned/weighted dataset; this file reproduces its RANKING, not its absolute value.",
          "", "## 5. Verdict",
          "**Interviews** is the most commonly used elicitation technique: 50.000% (97/194, 95% CI [42.78, 57.22]), "
          "ahead of Scenarios and Prototyping (38.660% each), Workshops/Meetings (38.144%) and Observation "
          "(32.990%). Interviews is the top-ranked named technique under all 10 sensitivity specs; the paired "
          "bootstrap gap to the runners-up is 11.34 pp (one-sided p-hat ~ 0.011-0.014; McNemar exact p ~ 0.014-0.017), "
          "i.e. significant at the 5% level but with limited margin (the paired 95% CI lower bound is only ~1.0-2.1 pp).",
          "", "## 6. Variables and the relation relied upon",
          "Columns: Q9_ML_Elicitation_Interviews, _Scenarios, _Prototyping, _Workshops_Meetings, _Observation, "
          "_Others, _Others_Free, plus Status (quality audit).",
          "Relation: negative codes -> structural missingness -> valid denominator (276 -> 194) -> absolute "
          "percentages of all techniques change -> ordering between techniques is unchanged.",
          ""]
open('output/results_summary.md', 'w').write("\n".join(lines))
print("\n".join(lines))
