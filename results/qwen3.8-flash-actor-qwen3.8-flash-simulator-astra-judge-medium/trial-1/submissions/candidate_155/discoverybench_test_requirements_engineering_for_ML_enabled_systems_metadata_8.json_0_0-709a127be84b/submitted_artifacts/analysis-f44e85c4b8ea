#!/usr/bin/env python3
"""
Q10 documentation-format usage analysis (ML-enabled systems requirements survey).
Question: which two documentation formats are least used, targets
10.13% (95% CI [9.926,10.333]) and 4.366% (95% CI [4.231,4.501])?

Method (researcher-approved):
- Sentinels (-77/-66/-99, Duration=-1) are invalid and excluded (A1).
- Q10 is multiselect 'quoted'/'not quoted'; 'uses format' == 'quoted' (A2).
- Not_Documented and Others/Others_Free excluded from format ranking, reported separately (A4).
- Denominator treated as a hypothesis, not assumed: three+ bases compared.
- Bootstrap: B=10000, resample RESPONDENTS with replacement, percentile 95% CI, seed=42.
"""
import json
import numpy as np
import pandas as pd

SEED = 42
B = 10_000
DATA = 'data/requirements_engineering_for_ML-enabled_systems.csv'

FMT = ['Vision_Document', 'Requirements_Lists', 'Goal_Models', 'Use_Case_Models',
       'Prototypes', 'User_Stories', 'BDD_Scenarios', 'MLCanvas', 'Notebooks', 'Data_Models']
COLS = ['Q10_ML_Documentation_' + f for f in FMT]
ND = 'Q10_ML_Documentation_Not_Documented'
OT = 'Q10_ML_Documentation_Others'
ALLQ10 = [c for c in pd.read_csv(DATA, nrows=1).columns
          if c.startswith('Q10_ML_Documentation_') and not c.endswith('Others_Free')]

df = pd.read_csv(DATA)
dur = pd.to_numeric(df['Duration'], errors='coerce')
valid = ~(df[ALLQ10] == '-77').any(axis=1)          # 194 rows answered Q10 (no sentinel)
completed = df['Status'].str.startswith('Completed')  # Completed + Completed after break
Q = (df[COLS] == 'quoted')
k = Q.sum(axis=1)

N_VARIANTS = {
    'all_rows': int(len(df)),
    'valid_Q10_no_sentinel': int(valid.sum()),
    'status_completed_or_after_break': int(completed.sum()),
    'completed_and_duration_ne_minus1': int((completed & (dur != -1)).sum()),
    'valid_and_duration_ne_minus1': int((valid & (dur != -1)).sum()),
    'documenting_respondents_k_ge_1': int(((k >= 1) & valid).sum()),
}
COUNTS = {f: int(Q.loc[valid, c].sum()) for c, f in zip(COLS, FMT)}
CONTEXT = {'Not_Documented_quoted_valid194': int((df.loc[valid, ND] == 'quoted').sum()),
           'Others_quoted_valid194': int((df.loc[valid, OT] == 'quoted').sum()),
           'total_marks_valid194': int(Q.loc[valid].sum().sum())}

rng = np.random.default_rng(SEED)

def boot_stat(mask_rows, fn):
    """Resample rows (respondents) with replacement from mask_rows; apply fn(bool matrix)."""
    idx_all = np.flatnonzero(mask_rows.to_numpy() if hasattr(mask_rows, 'to_numpy') else mask_rows)
    out = np.empty((B, len(COLS)))
    for b in range(B):
        pick = rng.choice(idx_all, size=len(idx_all), replace=True)
        out[b] = fn(Q.iloc[pick])
    return out

def stat_resp(qm):
    return qm.mean(axis=0).values * 100.0

def stat_all(qm):  # denominator fixed at len(subsample) == counts/N (same as resp on full frame)
    return (qm.sum(axis=0).values / len(qm)) * 100.0

def stat_marks(qm):
    s = qm.values.astype(float)
    T = s.sum()
    return (s.sum(axis=0) / T * 100.0) if T > 0 else np.zeros(len(COLS))

def stat_wnorm(qm):
    s = qm.values.astype(float)
    kk = s.sum(axis=1)
    w = np.divide(s, kk[:, None], out=np.zeros_like(s), where=kk[:, None] > 0)
    tot = w.sum()
    return (w.sum(axis=0) / tot * 100.0) if tot > 0 else np.zeros(len(COLS))

bases = {}
# (a) share of valid Q10 respondents (N=194)
rep = boot_stat(valid, stat_resp)
bases['a_respondent_share_valid194'] = {
    'point_exact': stat_resp(Q[valid]).tolist(), 'boot_mean': rep.mean(0).tolist(),
    'ci_lo': np.percentile(rep, 2.5, axis=0).tolist(), 'ci_hi': np.percentile(rep, 97.5, axis=0).tolist()}
# (a2) share among documenting respondents (>=1 format selected), N=146
mask_doc = valid & (k >= 1)
rep_doc = boot_stat(mask_doc, stat_resp)
bases['a2_respondent_share_documenting146'] = {
    'point_exact': stat_resp(Q[mask_doc]).tolist(), 'boot_mean': rep_doc.mean(0).tolist(),
    'ci_lo': np.percentile(rep_doc, 2.5, axis=0).tolist(), 'ci_hi': np.percentile(rep_doc, 97.5, axis=0).tolist()}
# (b) share of all 276 records (sentinel rows count as not using)
rep_all = boot_stat(pd.Series(True, index=df.index), stat_all)
bases['b_share_of_all276'] = {
    'point_exact': stat_all(Q).tolist(), 'boot_mean': rep_all.mean(0).tolist(),
    'ci_lo': np.percentile(rep_all, 2.5, axis=0).tolist(), 'ci_hi': np.percentile(rep_all, 97.5, axis=0).tolist()}
# (c) share of all quoted marks (per-mark normalization), valid rows
rep_m = boot_stat(valid, stat_marks)
bases['c_share_of_marks'] = {
    'point_exact': stat_marks(Q[valid]).tolist(), 'boot_mean': rep_m.mean(0).tolist(),
    'ci_lo': np.percentile(rep_m, 2.5, axis=0).tolist(), 'ci_hi': np.percentile(rep_m, 97.5, axis=0).tolist()}
# (d) per-respondent normalized multiselect weights (bonus sensitivity)
rep_w = boot_stat(valid, stat_wnorm)
bases['d_wnorm_valid194'] = {
    'point_exact': stat_wnorm(Q[valid]).tolist(), 'boot_mean': rep_w.mean(0).tolist(),
    'ci_lo': np.percentile(rep_w, 2.5, axis=0).tolist(), 'ci_hi': np.percentile(rep_w, 97.5, axis=0).tolist()}

# Pairwise difference bootstrap (base a): is BDD / MLCanvas significantly below others?
diff_diag = {}
qvalid = Q[valid]
for target in ['BDD_Scenarios', 'MLCanvas']:
    ti = FMT.index(target)
    rows = {}
    for j, f2 in enumerate(FMT):
        if j == ti:
            continue
        d = rep[:, ti] - rep[:, j]
        lo, hi = np.percentile(d, [2.5, 97.5])
        rows[f2] = {'diff_pp': round(float(d.mean()), 3), 'ci': [round(float(lo), 3), round(float(hi), 3)],
                    'significant_lower_at_95': bool(hi < 0)}
    diff_diag[target] = rows

# Target matching + CI-width diagnostics
T1 = {'pct': 10.13, 'ci': [9.926, 10.333]}
T2 = {'pct': 4.366, 'ci': [4.231, 4.501]}
def width_diag(t):
    p, (lo, hi) = t['pct'] / 100, t['ci']
    hw = (hi - lo) / 2 / 100
    se = hw / 1.96
    n_percentile = p * (1 - p) / se ** 2         # n implied if CI were a Wald/percentile CI
    return {'implied_n_if_percentile_Wald_CI': round(n_percentile),
            'implied_n_if_CI_is_MC_SE_of_boot_mean': [round(n_percentile / b) for b in (1000, 10000)]}
matching = {'targets': {'T_high': T1, 'T_low': T2},
            'width_diagnostics': {'T_high': width_diag(T1), 'T_low': width_diag(T2)},
            'closest_points': {}}
for bn, bb in bases.items():
    pts = {f: bb['point_exact'][i] for i, f in enumerate(FMT)}
    c1 = min(pts, key=lambda f: abs(pts[f] - 10.13)); c2 = min(pts, key=lambda f: abs(pts[f] - 4.366))
    srt = sorted(pts, key=lambda f: pts[f])[:3]
    matching['closest_points'][bn] = {
        'closest_to_10.13': [c1, round(pts[c1], 3), round(pts[c1] - 10.13, 3)],
        'closest_to_4.366': [c2, round(pts[c2], 3), round(pts[c2] - 4.366, 3)],
        'smallest_three': [[f, round(pts[f], 3)] for f in srt]}

out = {'seed': SEED, 'B': B, 'N_variants': N_VARIANTS, 'counts_quoted_valid194': COUNTS,
       'context': CONTEXT,
       'bases': {bn: {f: {'point_exact': round(bb['point_exact'][i], 3),
                          'boot_mean': round(bb['boot_mean'][i], 3),
                          'ci95': [round(bb['ci_lo'][i], 3), round(bb['ci_hi'][i], 3)]}
                      for i, f in enumerate(FMT)} for bn, bb in bases.items()},
       'pairwise_diagnostics_base_a': diff_diag,
       'target_matching': matching}
with open('outputs/q10_results.json', 'w') as fh:
    json.dump(out, fh, indent=2)

print(json.dumps({'seed': SEED, 'B': B, 'N_variants': N_VARIANTS,
                  'counts_quoted_valid194': COUNTS, 'context': CONTEXT}, indent=2))
for bn, bb in out['bases'].items():
    print('\n==', bn)
    for f, v in sorted(bb.items(), key=lambda kv: kv[1]['point_exact']):
        print(f"  {f:22s} {v['point_exact']:7.3f}  boot {v['boot_mean']:7.3f}  CI [{v['ci95'][0]:6.3f},{v['ci95'][1]:6.3f}]")
print('\n== pairwise (base a) significant-lower flags')
for t, rows in diff_diag.items():
    sig = [f for f, r in rows.items() if r['significant_lower_at_95']]
    print(f"  {t}: significantly below {len(sig)}/{len(FMT)-1} other formats -> {sig}")
print('\n== target width diagnostics:', json.dumps(matching['width_diagnostics']))
for bn, m in matching['closest_points'].items():
    print(bn, '| ~10.13:', m['closest_to_10.13'], '| ~4.366:', m['closest_to_4.366'], '| smallest3:', m['smallest_three'])
