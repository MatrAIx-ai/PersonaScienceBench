"""
planet_activity_v005: recover component A + background summary at epoch 0 and
predict future component-A-only values from obs_0.

Model (weights = obs_0_err, t in days, reference_epoch_day = 0):
  obs_0(t) = offset
           + b1*sin(2*pi t/P_B) + b2*cos(2*pi t/P_B)
           + b3*sin(4*pi t/P_B) + b4*cos(4*pi t/P_B)
           [+ a1*sin(2*pi t/P_A) + a2*cos(2*pi t/P_A)]
Periods via dense grid (variable projection) -> multistart joint least_squares
over (P_A, P_B) with linear coefficients profiled out analytically.
"""
import json
import numpy as np
import pandas as pd
from scipy.optimize import least_squares

REF = 0.0  # reference_epoch_day from input_0.json
DCHI2_PRESENT = 25.0  # look-elsewhere-corrected significance threshold

meta = json.load(open("data/input_0.json"))
REF = float(meta["reference_epoch_day"])
cases = list(meta["case_order"])
d1 = pd.read_csv("data/input_1.csv")
d2 = pd.read_csv("data/input_2.csv")


def design_bg(t, PB):
    w = 2 * np.pi / PB
    x = t - REF
    return np.column_stack([np.ones_like(t), np.sin(w * x), np.cos(w * x),
                            np.sin(2 * w * x), np.cos(2 * w * x)])


def design_a(t, PA):
    v = 2 * np.pi / PA
    x = t - REF
    return np.column_stack([np.sin(v * x), np.cos(v * x)])


def wls(y, e, X):
    Xw = X / e[:, None]
    if np.linalg.cond(Xw) > 1e10:
        return None, np.inf
    beta, *_ = np.linalg.lstsq(Xw, y / e, rcond=None)
    chi2 = float(np.sum(((y - X @ beta) / e) ** 2))
    return beta, chi2


def grid_min(func, lo, hi, n):
    grid = np.exp(np.linspace(np.log(lo), np.log(hi), n))
    vals = np.array([func(p) for p in grid])
    return grid, vals


def local_minima(grid, vals, win, thresh):
    idx = [i for i in range(len(grid))
           if vals[i] == vals[max(0, i - win):i + win + 1].min() and vals[i] < thresh]
    idx.sort(key=lambda i: vals[i])          # rank by quality, not period order
    out, used = [], []
    for i in idx:                            # de-duplicate nearby minima
        if all(abs(np.log(grid[i] / grid[j])) > 0.02 for j in used):
            used.append(i); out.append(grid[i])
    return out


rows, prows, diag = [], [], {}
for c in cases:
    g = d1[d1.case_id == c]
    t = g.time_day.values.astype(float)
    y = g.obs_0.values.astype(float)
    e = g.obs_0_err.values.astype(float)
    n = len(t)
    T = t.max() - t.min()

    # --- stage 1: BG period candidates (grid) ---
    bg_chi2 = lambda P: wls(y, e, design_bg(t, P))[1]
    gridB, vB = grid_min(bg_chi2, 2.0, 300.0, 20000)
    PB_cands = local_minima(gridB, vB, 50, vB.min() + 0.5 * (np.median(vB) - vB.min()))[:8]

    def bg_resid(p):
        b, _ = wls(y, e, design_bg(t, p[0]))
        return (y - design_bg(t, p[0]) @ b) / e

    bg_best = None
    for P0 in PB_cands:
        s = least_squares(bg_resid, [P0], bounds=([1.2], [600.0]))
        if bg_best is None or s.cost < bg_best.cost:
            bg_best = s
    chi2_bg = 2 * bg_best.cost
    PB_bg = bg_best.x[0]

    # --- stage 2: A candidates on top of BG (grid over PA) ---
    def full_fixedPB_PA(PA, PB):
        X = np.hstack([design_bg(t, PB), design_a(t, PA)])
        return wls(y, e, X)[1]

    gridA = np.exp(np.linspace(np.log(1.2), np.log(400.0), 12000))
    vA = np.array([full_fixedPB_PA(PA, PB_bg) for PA in gridA])
    PA_cands = local_minima(gridA, vA, 40, chi2_bg - 5.0)[:10]
    # plus PA candidates derived from BG-grid alternatives (cross combos)
    starts = [(PB_bg, PA) for PA in PA_cands] + [(P, PA_cands[0] if PA_cands else 10.0)
                                                 for P in PB_cands[1:4]]

    # --- stage 3: multistart joint refinement (P_B, P_A) ---
    def full_resid(p):
        X = np.hstack([design_bg(t, p[0]), design_a(t, p[1])])
        b, _ = wls(y, e, X)
        return (y - X @ b) / e

    sols = []
    for (Pb0, Pa0) in starts:
        try:
            s = least_squares(full_resid, [Pb0, Pa0], x_scale=[1.0, 1.0])
            sols.append((2 * s.cost, s.x[0], s.x[1]))
        except Exception:
            pass
    sols.sort()
    uniq = []
    for chi2, Pb, Pa in sols:
        if all(abs(Pa - q[2]) > 0.25 or abs(Pb - q[1]) > 0.25 for q in uniq):
            uniq.append((chi2, Pb, Pa))
    chi2_full, PB, PA = uniq[0]
    rejected = next((u for u in uniq[1:]), None)

    # --- presence decision ---
    dchi2 = chi2_bg - chi2_full
    present = int(dchi2 >= DCHI2_PRESENT)

    if present:
        X = np.hstack([design_bg(t, PB), design_a(t, PA)])
        beta, _ = wls(y, e, X)
        off, b1, b2, b3, b4, a1, a2 = beta
        J = full_resid([PB, PA])
        # parameter errors from J^T J (with chi2/dof scaling) of joint fit
        def resid_joint(p):
            Xj = np.hstack([design_bg(t, p[0]), design_a(t, p[1])])
            bj, _ = wls(y, e, Xj)
            return (y - Xj @ bj) / e
        r0 = resid_joint([PB, PA])
        eps_p, eps_a = 1e-4, 1e-4
        Jm = np.column_stack([(resid_joint([PB + eps_p, PA]) - r0) / eps_p,
                              (resid_joint([PB, PA + eps_a]) - r0) / eps_a])
        cov = np.linalg.inv(Jm.T @ Jm) * max(chi2_full / (n - 7), 1.0)
        ePB, ePA = np.sqrt(np.diag(cov))
    else:
        X = design_bg(t, PB_bg)
        beta, _ = wls(y, e, X)
        off, b1, b2, b3, b4 = beta
        PB, PA = PB_bg, 0.0
        ePB = np.nan
        ePA = np.nan
        a1 = a2 = 0.0
        PB = PB_bg if not present else PB

    if present:
        PB_out, PA_out = PB, PA
    else:
        PB_out, PA_out = PB_bg, 0.0

    # diagnostics
    Xfin = design_bg(t, PB_out) + 0.0
    Xfin = design_bg(t, PB_out)
    if present:
        Xfin = np.hstack([Xfin, design_a(t, PA_out)])
        betaf = [off, b1, b2, b3, b4, a1, a2]
    else:
        betaf = [off, b1, b2, b3, b4]
    resid = y - Xfin @ np.array(betaf)
    cond = np.linalg.cond(np.column_stack([Xfin, np.ones(n)]) if False else Xfin)
    diag[c] = dict(n=n, chi2_bg=chi2_bg, chi2_full=chi2_full, dchi2=dchi2,
                   PB=PB_out, PB_err=ePB, PA=PA_out, PA_err=ePA,
                   chi2_dof=chi2_full / (n - (7 if present else 5)),
                   resid_rms=float(np.sqrt(np.mean(resid ** 2))),
                   err_mean=float(e.mean()), cond=float(cond),
                   rejected=rejected, n_starts=len(starts))

    rows.append(dict(case_id=c, component_a_present=int(present),
                     component_a_period_day=PA_out if present else 0.0,
                     component_a_basis1_u0=a1 if present else 0.0,
                     component_a_basis2_u0=a2 if present else 0.0,
                     component_b_period_day=PB_out,
                     component_b_basis1_u0=b1, component_b_basis2_u0=b2,
                     component_b_basis3_u0=b3, component_b_basis4_u0=b4,
                     offset_u0=off))

summary = pd.DataFrame(rows, columns=[
    "case_id", "component_a_present", "component_a_period_day",
    "component_a_basis1_u0", "component_a_basis2_u0", "component_b_period_day",
    "component_b_basis1_u0", "component_b_basis2_u0", "component_b_basis3_u0",
    "component_b_basis4_u0", "offset_u0"])
summary.to_csv("signal_summary.csv", index=False)

pred = []
for _, r in d2.iterrows():
    s = summary[summary.case_id == r.case_id].iloc[0]
    if int(s.component_a_present) == 1:
        v = 2 * np.pi * (r.time_day - REF) / s.component_a_period_day
        val = s.component_a_basis1_u0 * np.sin(v) + s.component_a_basis2_u0 * np.cos(v)
    else:
        val = 0.0
    pred.append(dict(case_id=r.case_id, time_day=r.time_day, component_a_value_u0=float(val)))
pred = pd.DataFrame(pred, columns=["case_id", "time_day", "component_a_value_u0"])
pred.to_csv("target_predictions.csv", index=False)

# --- contract assertions ---
assert len(summary) == 4 and list(summary.case_id) == cases
assert len(pred) == len(d2)
assert list(pred.case_id) == list(d2.case_id) and np.allclose(pred.time_day, d2.time_day)
num = summary.drop(columns=["case_id"]).values.astype(float)
assert np.isfinite(num).all() and np.isfinite(pred.drop(columns=["case_id"]).values.astype(float)).all()
assert set(summary.component_a_present.astype(int)) <= {0, 1}

for c in cases:
    d = diag[c]
    print(c, {k: (round(v, 4) if isinstance(v, float) else v) for k, v in d.items()})
print(summary.to_string())
