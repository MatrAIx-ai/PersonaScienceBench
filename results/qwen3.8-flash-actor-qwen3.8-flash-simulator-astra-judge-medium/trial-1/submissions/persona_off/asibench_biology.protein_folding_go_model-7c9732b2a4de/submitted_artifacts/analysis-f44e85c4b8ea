def cmap(u):
    u = float(np.clip(u, 0.0, 1.0)) * (len(PALETTE) - 1)
    i = min(int(u), len(PALETTE) - 2); f = u - i
    return tuple(int(round(PALETTE[i][c] * (1 - f) + PALETTE[i + 1][c] * f)) for c in range(3))


