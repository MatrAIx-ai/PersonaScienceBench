def write_png(path, img):
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + np.ascontiguousarray(img[y], dtype=np.uint8).tobytes() for y in range(h))
    def chunk(typ, data):
        return (struct.pack(">I", len(data)) + typ + data
                + struct.pack(">I", zlib.crc32(typ + data) & 0xFFFFFFFF))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 6))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as fh:
        fh.write(png)


class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.img = np.zeros((h, w, 3), np.uint8)
        self.img[:, :] = np.array(bg, np.uint8)

    def _set(self, x, y, c):
        x = int(round(float(x))); y = int(round(float(y)))
        if 0 <= x < self.img.shape[1] and 0 <= y < self.img.shape[0]:
            self.img[y, x] = c

    def line(self, p0, p1, c=(0, 0, 0), width=1):
        (x0, y0), (x1, y1) = p0, p1
        n = int(max(abs(x1 - x0), abs(y1 - y0), 1) * 2) + 1
        for t in np.linspace(0.0, 1.0, n):
            x = int(round(x0 + (x1 - x0) * t)); y = int(round(y0 + (y1 - y0) * t))
            for dy in range(width):
                for dx in range(width):
                    self._set(x + dx, y + dy, c)

    def circle(self, cx, cy, r, c=(0, 0, 0), fill=True):
        cx, cy = int(round(cx)), int(round(cy))
        for y in range(cy - r, cy + r + 1):
            for x in range(cx - r, cx + r + 1):
                d2 = (x - cx) ** 2 + (y - cy) ** 2
                if fill and d2 <= r * r:
                    self._set(x, y, c)
                elif (not fill) and (r - 1.5) ** 2 <= d2 <= (r + 0.5) ** 2:
                    self._set(x, y, c)

    def text(self, x, y, s, c=(0, 0, 0), scale=2):
        gx = x
        for ch in s.upper():
            g = _GLY.get(ch, _GLY[' '])
            for r in range(7):
                for col in range(5):
                    if g[r, col]:
                        for a in range(scale):
                            for b in range(scale):
                                self._set(gx + col * scale + a, y + r * scale + b, c)
            gx += 6 * scale
        return gx

    def rect(self, x0, y0, x1, y1, c):
        a0, a1 = sorted((int(round(x0)), int(round(x1)))); b0, b1 = sorted((int(round(y0)), int(round(y1))))
        self.img[max(b0, 0):b1 + 1, max(a0, 0):a1 + 1] = np.array(c, np.uint8)


def fmt(v, nd=3):
    return ("%." + str(nd) + "f") % v


class Axes:
    """Minimal axes with linear scales, ticks, labels and clipping-free drawing."""
    def __init__(self, cv, x0, y0, x1, y1, xlim, ylim):
        self.cv, self.x0, self.y0, self.x1, self.y1 = cv, x0, y0, x1, y1
        self.xlim, self.ylim = xlim, ylim
        for c in [(70, 70, 70)]:
            cv.line((x0, y0), (x1, y0), c, 1); cv.line((x0, y1), (x1, y1), c, 1)
            cv.line((x0, y0), (x0, y1), c, 1); cv.line((x1, y0), (x1, y1), c, 1)

    def px(self, x, y):
        fx = (x - self.xlim[0]) / (self.xlim[1] - self.xlim[0])
        fy = (y - self.ylim[0]) / (self.ylim[1] - self.ylim[0])
        return self.x0 + fx * (self.x1 - self.x0), self.y1 - fy * (self.y1 - self.y0)

    def ticks(self, xt, yt, nd=2, scale=2):
        for t in xt:
            px, _ = self.px(t, self.ylim[0])
            self.cv.line((px, self.y1), (px, self.y1 + 5), (70, 70, 70), 1)
            s = fmt(t, nd)
            self.cv.text(px - 6 * scale * len(s) / 2.0, self.y1 + 8, s, (40, 40, 40), scale)
        for t in yt:
            _, py = self.px(self.xlim[0], t)
            self.cv.line((self.x0 - 5, py), (self.x0, py), (70, 70, 70), 1)
            s = fmt(t, nd)
            self.cv.text(self.x0 - 8 - 6 * scale * len(s), py - 3 * scale, s, (40, 40, 40), scale)

    def plot(self, xs, ys, c, width=2):
        pts = [self.px(x, y) for x, y in zip(xs, ys)]
        for a, b in zip(pts[:-1], pts[1:]):
            self.cv.line(a, b, c, width)

    def vlines(self, xs, c, width=1, dash=True):
        for x in xs:
            p_top = self.px(x, self.ylim[1]); p_bot = self.px(x, self.ylim[0])
            if dash:
                n = int(abs(p_top[1] - p_bot[1]))
                for k in range(0, n, 8):
                    self.cv.line((p_bot[0], p_bot[1] - k),
                                 (p_bot[0], p_bot[1] - min(k + 4, n)), c, width)
            else:
                self.cv.line((p_bot[0], self.y0), (p_bot[0], self.y1), c, width)


def step_hist(ax, edges, p, c, width=2):
    pts = []
    for i in range(len(p)):
        a = ax.px(edges[i], p[i]); b = ax.px(edges[i + 1], p[i])
        pts.append(a); pts.append(b)
    last = ax.px(edges[-1], p[-1]); pts.append(last)
    for a, b in zip(pts[:-1], pts[1:]):
        ax.cv.line(a, b, c, width)


def bar_hist(ax, edges, p, c, alpha_c=None):
    for i in range(len(p)):
        e0, e1 = edges[i], edges[i + 1]
        x0, _ = ax.px(e0, 0); x1, _ = ax.px(e1, p[i]); _, ytop = ax.px(e0, p[i]); _, ybot = ax.px(e0, 0)
        ax.cv.rect(x0 + 1, ytop, x1 - 1, ybot, c)


