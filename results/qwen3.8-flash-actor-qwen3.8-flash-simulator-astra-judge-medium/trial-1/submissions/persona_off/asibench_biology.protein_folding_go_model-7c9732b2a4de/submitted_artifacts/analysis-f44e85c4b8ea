def q_to_Tstar(temps, q):
    """Deterministic inversion of <Q>(T) = 0.5. Returns (T_star, method, notes)."""
    temps = np.asarray(temps, float); q = np.asarray(q, float)
    notes = []
    cross = [k for k in range(len(q) - 1) if (q[k] - 0.5) * (q[k + 1] - 0.5) < 0.0]
    if cross:
        if len(cross) > 1:
            notes.append("multiple <Q>=0.5 crossings on the ladder; used the first (lowest-T) one")
        k = cross[0]
        lin = temps[k] + (0.5 - q[k]) * (temps[k + 1] - temps[k]) / (q[k+1] - q[k])
        if np.all(np.diff(q) < 0):
            Ts = float(PchipInterpolator(q[::-1], temps[::-1])(0.5))
            if not (temps.min() <= Ts <= temps.max()):
                Ts = lin
            return Ts, "PCHIP interpolation of T(<Q>) over the full monotone ladder (crossing at segment k=%d)" % k, notes
        notes.append("<Q>(T) is not strictly monotone; used linear interpolation on the bracketing segment")
        return float(lin), "piecewise-linear interpolation on bracketing segment k=%d (T=%.6f..%.6f)" % (k, temps[k], temps[k+1]), notes
    notes.append("NO SIGN CHANGE of <Q>-0.5 on the ladder: T_star is a linear EXTRAPOLATION from the two ladder end points")
    a, b = 0, len(q) - 1
    Ts = temps[a] + (0.5 - q[a]) * (temps[b] - temps[a]) / (q[b] - q[a])
    return float(Ts), "linear EXTRAPOLATION from ladder end points", notes


def main():
    import time, os, sys
    t0 = time.time()
    warnings = ["matplotlib is not installed in this sandbox and the sandbox is offline: visualization.png was rasterised with numpy and encoded with the stdlib zlib/struct PNG writer (no third-party plotting package used).",
                "data/parameters.json specifies no interaction strengths; deterministic reference-derived values were fixed BEFORE the ladder run: harmonic bonds k_b=%.1f with r0_ij = reference bond length; Gaussian native wells of depth eps = mean(temperature_list) = %.6f and width 0.35*r0_ij centred on the reference contact distances; purely repulsive WCA with sigma = min reference non-bonded distance (|i-j|>=%d)/2^(1/6) = %.6f. eps was not retuned afterwards." % (K_BOND, EPS, MINSEP, SIGMA),
                "n_steps_per_T = %d were ALL used as production steps; %d additional thermalisation steps (20%%) per temperature were run before the production loop and are not written to any artifact; n_ckpt = %d per temperature." % (N_STEPS, N_THERM, N_CKPT),
                "Q uses a per-pair tolerance of 1.10*r0_ij, identical at every temperature; the same criterion defines native_contact_probability.npy and the Jaccard adjacency."]

    runs = []
    for k, T in enumerate(TEMPS):
        r = run_langevin(float(T), SEED_BASE + 100 * k, keep_coords=(k == 0))
        h, _ = np.histogram(r["Q"], bins=N_Q_BINS, range=(0.0, 1.0))
        r["hist"] = h / h.sum()
        runs.append(r)
        print("  ladder T=%.6f  <Q>=%.4f  varQ=%.5f  <E>=%9.3f  varE=%8.3f  Cv=%.4f  [%.1fs]"
              % (T, r["Q"].mean(), r["Q"].var(), r["E"].mean(), r["E"].var(),
                 r["E"].var() / T ** 2, time.time() - t0))
        sys.stdout.flush()

    temps = TEMPS.copy()
    meanQ = np.array([r["Q"].mean() for r in runs]); varQ = np.array([r["Q"].var() for r in runs])
    meanE = np.array([r["E"].mean() for r in runs]); varE = np.array([r["E"].var() for r in runs])
    cvd = varE / temps ** 2
    corr = np.array([float(np.corrcoef(r["Q"], r["E"])[0, 1]) for r in runs])
    ac1 = np.array([float(np.corrcoef(r["Q"][:-1], r["Q"][1:])[0, 1]) for r in runs])

    Tstar, ts_method, ts_notes = q_to_Tstar(temps, meanQ)
    warnings.extend("T_star: " + n for n in ts_notes)
    if Tstar > temps.max() - 0.5 * (temps[1] - temps[0]):
        warnings.append("T_star lies in the upper half of the sampled ladder (within half a ladder spacing of T_max=%.6f); the <Q>=0.5 midpoint is only marginally bracketed." % temps.max())
    if Tstar < temps.min() + 0.5 * (temps[1] - temps[0]):
        warnings.append("T_star lies in the lower half of the sampled ladder (within half a ladder spacing of T_min=%.6f)." % temps.min())

    sens = {}
    for li, lam in enumerate(LAM_SENS):
        q_s = np.array([r["Qall"][:, li].mean() for r in runs])
        sens[lam] = (q_s, q_to_Tstar(temps, q_s)[0])

    warnings.append("lambda sensitivity of the order parameter (diagnostic only, nothing in the artifacts uses it): with tolerance 1.00*r0_ij the whole ladder lies below <Q>=0.5 (%s -> T*=%.3f by end-point extrapolation), with the adopted 1.10*r0_ij it brackets 0.5 (%.3f), and with 1.20*r0_ij it lies above 0.5 (%s -> T*=%.3f). T_star is therefore strongly tolerance-dependent for this reference; the pre-registered 1.10*r0_ij definition is used everywhere."
                    % (" ".join("%.3f" % v for v in sens[1.00][0]), sens[1.00][1], sens[1.10][1],
                       " ".join("%.3f" % v for v in sens[1.20][0]), sens[1.20][1]))

    rstar = run_langevin(float(Tstar), SEED_BASE + 999)
    a1s = float(np.corrcoef(rstar["Q"][:-1], rstar["Q"][1:])[0, 1])
    neff_star = N_CKPT * (1.0 - a1s) / (1.0 + a1s)
    hstar, pstar, centers, mi, ps = mode_analysis(rstar["Q"], N_Q_BINS, float(Tstar), n_eff=neff_star)
    fst = -float(Tstar) * (np.log(ps) - np.log(ps.max())); fst = fst - fst.min()
    assert np.all(np.isfinite(fst)) and fst.min() == 0.0
    if mi["n_modes_used"] >= 2:
        two = sorted(mi["peaks"], key=lambda i: -pstar[i])[:2]; two = sorted(two)
        si = mi["saddle_index"]
        barrier = max(float((fst[si] - min(fst[two[0]], fst[two[1]])) / Tstar), 0.0)
        sep = abs(float(centers[two[1]] - centers[two[0]]))
    else:
        barrier, sep = 0.0, 0.0
        warnings.append("the free-energy profile at T_star has %d statistically resolvable mode(s) (prominence threshold %.4f = max(15%% of the smoothed maximum, 2 shot-noise sigma); basin-mass cut 10%%): mode_separation set to 0 and free_energy_barrier_kT set to 0. No barrier is inferred from a shoulder; candidate prominences were %s." % (mi["n_modes"], mi["prom_threshold"], mi["max_candidate_prominences"]))
    mi["barrier_kT"] = barrier; mi["mode_separation"] = sep; mi["n_eff_star"] = round(float(neff_star), 1)
    mi["lag1_Q_star"] = round(a1s, 4)
    mi["mean_Q_star"] = float(rstar["Q"].mean())
    warnings.append("the dedicated T_star run gives <Q>=%.4f, not exactly 0.5: this is the finite-sampling scatter of <Q>(T) (lag-1 autocorrelation of Q is %.3f, so the %d checkpoints correspond to ~%.0f statistically independent samples; SE(<Q>) ~ %.3f)." % (rstar["Q"].mean(), a1s, N_CKPT, neff_star, math.sqrt(rstar["Q"].var() / max(neff_star, 2.0))))
    warnings.append("transition_free_energy_profile.npy uses a Jeffreys pseudocount (0.5 counts per bin) plus Gaussian smoothing of sigma=%.1f bins before F=-kBT*ln P, so empty bins give a finite free energy (max %.2f kBT*) instead of a divergence; the pseudocount does not affect the profile where the histogram has counts." % (mi["sigma_bins"], float(fst.max())))
    top10 = float(pstar[-10:].sum()); bot10 = float(pstar[:10].sum())

    Tf, cvf, meanEf, varEf, neff_cv = reweight_cv([r["E"] for r in runs], temps)
    assert np.all(np.isfinite(cvf)), "C_v fine curve must be finite"
    peak_cv = float(np.nanmax(cvf)); T_peak = float(Tf[int(np.argmax(cvf))])
    warnings.append("heat_capacity_curve.npy: row 0 = n_fine=%d temperatures spanning [T_min,T_max] only (no extrapolation outside the sampled interval); row 1 = var(E)/T^2 obtained by single-histogram (Ferenc-Neville) reweighting of the raw energy trajectory of the nearest ladder temperature (minimum reweighting effective sample size %.1f of %d). C_v is a fluctuation estimate and is statistically noisy; it is a diagnostic only and is NOT used to define transition_temperature." % (N_FINE, float(neff_cv.min()), N_CKPT))
    if int(np.argmax(cvf)) in (0, N_FINE - 1):
        warnings.append("the fluctuation heat capacity has NO interior maximum on the sampled interval: its largest value (%.3f) sits at the %s end of the ladder (T=%.6f), while the directly measured ladder-point values range %.2f-%.2f. var(E) grows monotonically with T here and is divided by T^2, so the raw C_v maximum is NOT a usable transition marker for this system." % (peak_cv, "low-temperature" if int(np.argmax(cvf)) == 0 else "high-temperature", T_peak, float(cvd.min()), float(cvd.max())))

    final_coords = np.ascontiguousarray(runs[0]["coords"][-1], dtype=np.float64)
    df = np.linalg.norm(final_coords[:, None, :] - final_coords[None, :, :], axis=-1)
    adj_ref = (SEQ >= MINSEP) & (DREF < CUTOFF); adj_fin = (SEQ >= MINSEP) & (df < CUTOFF)
    inter = int((adj_ref & adj_fin).sum() // 2); union = int((adj_ref | adj_fin).sum() // 2)
    jaccard = inter / union

    traj = np.ascontiguousarray(np.vstack([r["Q"] for r in runs]), dtype=np.float64)
    hists = np.ascontiguousarray(np.vstack([r["hist"] for r in runs]), dtype=np.float64)
    ncp = np.ascontiguousarray(np.vstack([r["contacts"].mean(axis=0) for r in runs]), dtype=np.float64)
    qec = np.empty((K, 20, 20), dtype=np.float64)
    for k, r in enumerate(runs):
        z = np.clip((r["E"] - r["E"].mean()) / r["E"].std(), -3.0 + 1e-9, 3.0 - 1e-9)
        H, _, _ = np.histogram2d(r["Q"], z, bins=[20, 20], range=[[0.0, 1.0], [-3.0, 3.0]])
        qec[k] = H / H.sum()
    np.save("final_coords.npy", final_coords)
    np.save("order_parameter_trajectory.npy", traj)
    np.save("order_parameter_histograms.npy", hists)
    np.save("heat_capacity_curve.npy", np.vstack([Tf, cvf]).astype(np.float64))
    np.save("transition_free_energy_profile.npy", np.vstack([centers, fst]).astype(np.float64))
    np.save("q_energy_joint_histograms.npy", qec)
    np.save("native_contact_probability.npy", ncp)
    obs = {"temperatures": [float(v) for v in temps],
           "mean_order_parameter_by_T": [float(v) for v in meanQ],
           "var_order_parameter_by_T": [float(v) for v in varQ],
           "mean_energy_by_T": [float(v) for v in meanE],
           "var_energy_by_T": [float(v) for v in varE],
           "heat_capacity_direct_by_T": [float(v) for v in cvd],
           "q_energy_correlation_by_T": [float(v) for v in corr]}
    json.dump(obs, open("temperature_observables.json", "w"), indent=2)
    ta = {"transition_temperature": float(Tstar),
          "peak_heat_capacity": peak_cv,
          "order_parameter_at_transition_mean": float(rstar["Q"].mean()),
          "order_parameter_at_transition_modes": [float(v) for v in mi["mode_Q"][:mi["n_modes_used"]]],
          "mode_separation": float(sep), "free_energy_barrier_kT": float(barrier),
          "reference_contact_jaccard": float(jaccard), "warnings": warnings}
    json.dump(ta, open("transition_analysis.json", "w"), indent=2)
    make_figure("visualization.png", final_coords, float(temps[0]), runs, Tf, cvf,
                {"meanQ": meanQ, "cv_direct": cvd, "meanQ_star": float(rstar["Q"].mean())},
                Tstar, hstar, pstar, fst, centers, mi, N_Q_BINS)
    return dict(temps=temps, meanQ=meanQ, varQ=varQ, meanE=meanE, varE=varE, cvd=cvd, corr=corr,
                ac1=ac1, Tstar=Tstar, ts_method=ts_method, sens=sens, rstar=rstar, mi=mi,
                bot10=bot10, top10=top10, last_coords=final_coords, Tf=Tf, cvf=cvf, peak_cv=peak_cv, jaccard=jaccard,
                inter=inter, union=union, warnings=warnings, hists=hists, ncp=ncp, traj=traj, neff_cv=neff_cv)


