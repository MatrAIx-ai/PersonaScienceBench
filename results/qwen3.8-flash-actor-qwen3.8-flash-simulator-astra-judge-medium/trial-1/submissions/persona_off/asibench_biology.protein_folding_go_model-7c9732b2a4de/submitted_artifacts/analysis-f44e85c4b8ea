def reweight_cv(E_list, temps, n_fine=N_FINE):
    """Fluctuation C_v on a fine grid inside [T_min, T_max] by single-histogram
    (Ferenc-Neville) reweighting of the raw energy trajectory of the NEAREST sampled
    temperature.  No extrapolation outside the sampled interval; the nearest-ladder
    restriction keeps |beta_near - beta| small so the reweighting stays well conditioned
    (the effective sample size is reported)."""
    temps = np.asarray(temps, float)
    Tf = np.linspace(temps.min(), temps.max(), n_fine)
    cv = np.empty(n_fine); meanE = np.empty(n_fine); varE = np.empty(n_fine); neff = np.empty(n_fine)
    for k, T in enumerate(Tf):
        kn = int(np.argmin(np.abs(temps - T)))
        E = np.asarray(E_list[kn], float)
        w = np.exp((1.0 / temps[kn] - 1.0 / T) * (E - E.mean()))
        w = w / w.sum()
        m = float((w * E).sum()); v = float((w * (E - m) ** 2).sum())
        meanE[k], varE[k], cv[k] = m, v, v / T ** 2
        neff[k] = 1.0 / float((w ** 2).sum())
    return Tf, cv, meanE, varE, neff


def mode_analysis(Q, n_bins, T, n_eff=None, sigma=1.0, prom_frac=0.15, mass_frac=0.10):
    """Histogram, free energy and mode detection at fixed T.

    A bin is only accepted as a mode if (i) its smoothed density is a local maximum,
    (ii) its prominence is at least prom_frac of the global smoothed maximum AND at
    least two standard errors of the smoothed density (binomial noise of n_eff
    effective samples), and (iii) the mass of its basin is >= mass_frac.  This keeps
    shot noise in a ~200-frame correlated trajectory from being read as a second phase.
    """
    h, edges = np.histogram(Q, bins=n_bins, range=(0.0, 1.0))
    Ntot = float(h.sum())
    p = h / Ntot
    centers = 0.5 * (edges[:-1] + edges[1:])
    p_pc = (h + 0.5) / (Ntot + 0.5 * n_bins)          # Jeffreys pseudocount: finite F
    ps = gaussian_filter1d(p_pc, sigma=sigma, mode="constant", cval=0.0)
    ps = ps / ps.sum()
    if n_eff is None:
        n_eff = len(Q)
    se = math.sqrt(max(p_pc.max(), 1.0 / n_bins) * (1.0 - p_pc.max()) / max(n_eff, 2.0))
    thr = max(prom_frac * ps.max(), 2.0 * se)
    pk = [i for i in range(1, len(ps) - 1) if ps[i] >= ps[i - 1] and ps[i] > ps[i + 1]]
    if ps[0] > ps[1]:
        pk.insert(0, 0)
    if ps[-1] >= ps[-2]:
        pk.append(len(ps) - 1)
    keep = []
    for i in pk:
        lft = ps[:i + 1].min() if i > 0 else ps[i]
        rgt = ps[i:].min() if i < len(ps) - 1 else ps[i]
        if ps[i] - max(lft, rgt) >= thr:
            keep.append(i)
    masses = {}
    if keep:
        bounds = ([0] + [int(a + np.argmin(ps[a:b + 1])) for a, b in zip(keep[:-1], keep[1:])] + [len(ps) - 1])
        for n, i in enumerate(keep):
            masses[i] = float(p[bounds[n]:bounds[n + 1] + 1].sum())
        keep = [i for i in keep if masses[i] >= mass_frac]
    out = {"n_modes": len(keep), "peaks": [int(i) for i in keep],
           "mode_Q": [round(float(centers[i]), 6) for i in keep],
           "mode_mass": [round(masses.get(i, float(p[i])), 4) for i in keep],
           "sigma_bins": float(sigma), "prom_threshold": round(float(thr), 6),
           "smoothed_max": round(float(ps.max()), 6), "n_eff_used": round(float(n_eff), 1),
           "max_candidate_prominences": [round(float(ps[i] - max(ps[:i + 1].min(), ps[i:].min())), 6) for i in pk]}
    if len(keep) >= 2:
        two = sorted(sorted(keep, key=lambda i: -masses.get(i, 0.0))[:2])
        a, b = two
        si = int(a + np.argmin(ps[a:b + 1]))
        out.update({"n_modes_used": 2, "mode_pair_Q": [float(centers[a]), float(centers[b])],
                    "saddle_index": si, "saddle_Q": float(centers[si]),
                    "mode_separation": float(abs(centers[b] - centers[a]))})
    else:
        out.update({"n_modes_used": max(1, len(keep)), "mode_pair_Q": [], "saddle_index": -1,
                    "saddle_Q": float("nan"), "mode_separation": 0.0})
    return h, p, centers, out, ps


