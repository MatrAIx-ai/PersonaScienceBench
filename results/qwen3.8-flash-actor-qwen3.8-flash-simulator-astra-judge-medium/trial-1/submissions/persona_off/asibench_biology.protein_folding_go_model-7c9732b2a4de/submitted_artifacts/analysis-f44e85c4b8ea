PARAM_PATH = "data/parameters.json"
COORD_PATH = "data/target_coords.npy"

# ----------------------------------------------------------------------------- parameters
PARAMS = json.load(open(PARAM_PATH))
N = int(PARAMS["n_beads"])
GAMMA = float(PARAMS["friction"])
DT = float(PARAMS["dt_reduced"])
TEMPS = np.asarray(PARAMS["temperature_list"], dtype=float)
K = len(TEMPS)
N_STEPS = int(PARAMS["n_steps_per_T"])
CUTOFF = float(PARAMS["contact_cutoff"])
MINSEP = int(PARAMS["min_seq_separation"])
SAVE = int(PARAMS["save_interval"])

N_THERM = int(round(0.20 * N_STEPS))      # extra steps, NOT recorded (see docstring)
N_CKPT = N_STEPS // SAVE + 1              # = 231
N_Q_BINS = 50
N_FINE = 121                              # documented choice for the C_v grid
LAM = 1.10                                # primary order-parameter tolerance
LAM_SENS = (1.00, 1.10, 1.20)             # off-report diagnostic only
K_BOND = 20.0
EPS = float(np.mean(TEMPS))               # native well depth (deterministic rule)
WELL_W = 0.35
SEED_BASE = 20261022

TARGET = np.load(COORD_PATH).astype(np.float64)
assert TARGET.shape == (N, 3) and TARGET.dtype == np.float64

# ------------------------------------------------------------------- reference-derived sets
DREF = np.linalg.norm(TARGET[:, None, :] - TARGET[None, :, :], axis=-1)
SEQ = np.abs(np.subtract.outer(np.arange(N), np.arange(N)))
IU, JU = np.triu_indices(N, 1)
SSEQ = SEQ[IU, JU]
D0 = DREF[IU, JU]
BOND_M = SSEQ == 1
NAT_M = (SSEQ >= MINSEP) & (D0 < CUTOFF)
WCA_M = SSEQ >= MINSEP
NAT_A, NAT_B = IU[NAT_M], JU[NAT_M]                 # lexicographic (i,j) order
M = int(NAT_A.size)
NAT_R0 = DREF[NAT_A, NAT_B]
assert np.all(np.diff(NAT_A * (N + 1) + NAT_B) > 0), "contact columns must be lexicographic"
SIGMA = float(DREF[SEQ >= MINSEP].min()) / 2.0 ** (1.0 / 6.0)
WCA_RC = 2.0 ** (1.0 / 6.0) * SIGMA

_AA = np.concatenate([IU[BOND_M], IU[NAT_M], IU[WCA_M]])
_BB = np.concatenate([JU[BOND_M], JU[NAT_M], JU[WCA_M]])
_TYP = np.concatenate([np.zeros(BOND_M.sum(), int),
                       np.ones(NAT_M.sum(), int),
                       2 * np.ones(WCA_M.sum(), int)])
_R0 = np.concatenate([D0[BOND_M], D0[NAT_M], D0[WCA_M]])
_W = WELL_W * _R0
_IS_B = _TYP == 0
_IS_N = _TYP == 1
_IS_W = _TYP == 2


def potential(x):
    dv = x[_BB] - x[_AA]
    r = np.linalg.norm(dv, axis=1)
    u = np.zeros(r.size)
    u[_IS_B] = 0.5 * K_BOND * (r[_IS_B] - _R0[_IS_B]) ** 2
    u[_IS_N] = -EPS * np.exp(-(((r[_IS_N] - _R0[_IS_N]) / _W[_IS_N]) ** 2))
    mm = _IS_W & (r < WCA_RC)
    s6 = (SIGMA / r[mm]) ** 6
    u[mm] = 4.0 * EPS * (s6 * s6 - s6) + EPS
    return float(u.sum())


def force(x):
    dv = x[_BB] - x[_AA]
    r = np.linalg.norm(dv, axis=1)
    fm = np.zeros(r.size)
    fm[_IS_B] = K_BOND * (r[_IS_B] - _R0[_IS_B])
    z = (r[_IS_N] - _R0[_IS_N]) / _W[_IS_N]
    fm[_IS_N] = (2.0 * EPS / _W[_IS_N]) * z * np.exp(-z * z)
    mm = _IS_W & (r < WCA_RC)
    s6 = (SIGMA / r[mm]) ** 6
    fm[mm] = (4.0 * EPS / r[mm]) * (-12.0 * s6 * s6 + 6.0 * s6)
    fp = (fm / r)[:, None] * dv
    f = np.empty_like(x)
    for k in range(3):
        f[:, k] = (np.bincount(_AA, weights=fp[:, k], minlength=N)
                   - np.bincount(_BB, weights=fp[:, k], minlength=N))
    return f


def contact_flags(x):
    r = np.linalg.norm(x[NAT_B] - x[NAT_A], axis=1)
    return (r < LAM * NAT_R0), r


def run_langevin(T, seed, keep_coords=False):
    """BAOAB Langevin: n_therm extra steps, then N_STEPS production steps."""
    rng = np.random.default_rng(seed)
    x = TARGET.copy()
    v = np.zeros_like(x)
    cb = math.exp(-GAMMA * DT)
    cv = math.sqrt(T * (1.0 - math.exp(-2.0 * GAMMA * DT)))
    half = 0.5 * DT
    for _ in range(N_THERM):
        v += half * force(x)
        x += half * v
        v = cb * v + cv * rng.standard_normal((N, 3))
        x += half * v
        v += half * force(x)
    qs = np.empty((N_CKPT, len(LAM_SENS)))
    es = np.empty(N_CKPT)
    cflag = np.zeros((N_CKPT, M), dtype=bool)
    coords = np.empty((N_CKPT, N, 3)) if keep_coords else None
    j = 0
    for s in range(N_STEPS):
        if s % SAVE == 0:
            fl, _ = contact_flags(x)
            cflag[j] = fl
            for li, lam in enumerate(LAM_SENS):
                rr = np.linalg.norm(x[NAT_B] - x[NAT_A], axis=1)
                qs[j, li] = np.clip(float(np.mean(rr < lam * NAT_R0)), 0.0, 1.0)
            es[j] = potential(x)
            if keep_coords:
                coords[j] = x
            j += 1
        v += half * force(x)
        x += half * v
        v = cb * v + cv * rng.standard_normal((N, 3))
        x += half * v
        v += half * force(x)
    assert j == N_CKPT
    out = {"Q": qs[:, LAM_SENS.index(LAM)].copy(),
           "Qall": qs, "E": es, "contacts": cflag, "T": float(T)}
    if keep_coords:
        out["coords"] = coords
    return out


