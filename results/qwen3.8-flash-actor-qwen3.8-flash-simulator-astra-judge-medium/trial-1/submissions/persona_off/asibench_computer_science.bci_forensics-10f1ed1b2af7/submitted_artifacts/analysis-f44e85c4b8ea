def make_figure():
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        fig, ax = plt.subplots(2, 1, figsize=(10, 8))
        names = ["coverage_gap", "tail_imbalance", "|log width ratio|", "case_dispersion"] + \
                ["probe_%02d" % k for k in range(5)]
        mats = [minmax(cov_gap.mean(1)), minmax(tail_imb.mean(1)),
                norm_comps["abs_log_width_ratio"], norm_comps["case_dispersion"]] + \
               [minmax(probe_metric[k]) for k in range(5)]
        xs = np.arange(NE)
        for j, nm in enumerate(names):
            ax[0].bar(xs + j * 0.09 - 0.4, mats[j], width=0.09, label=nm)
        ax[0].set_xticks(xs); ax[0].set_xticklabels(ENGINE_IDS, rotation=45)
        ax[0].legend(fontsize=7, ncol=3); ax[0].set_title("Normalized audit metrics")
        order = np.argsort(engine_score, kind="stable")
        ax[1].barh(range(NE)[::-1], engine_score[order],
                   color=["green" if e == selected_e else "steelblue" for e in order])
        ax[1].set_yticks(range(NE)[::-1])
        ax[1].set_yticklabels([ENGINE_IDS[e] for e in order])
        ax[1].set_title("Combined engine score (lower=better; green=selected)")
        fig.tight_layout(); fig.savefig(PNG_PATH); plt.close(fig)
        log("figure written via matplotlib")
    except ImportError:
        make_png_stdlib()
