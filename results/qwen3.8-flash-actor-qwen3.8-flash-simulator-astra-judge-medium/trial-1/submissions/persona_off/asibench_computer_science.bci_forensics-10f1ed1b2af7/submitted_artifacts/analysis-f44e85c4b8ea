#!/usr/bin/env python3
"""Deterministic confidence-interval engine forensics.

Writes analysis artifacts under results/. No randomness, no row-order
dependence, no exact population targets used.

Method conventions (stated explicitly):
- Endpoint-tie convention: an interval covers theta_hat iff lo <= theta_hat <= hi
  (INCLUSIVE endpoints). A degenerate zero-width interval (width < ZERO_EPS) is a
  miss unless |theta_hat - lo| <= ZERO_EPS. No zero-width intervals occur in the
  supplied panels; the guard is defensive only.
- Population target per case: theta_hat = MEAN over the 108 calibration
  replications of the public statistic recomputed on each replication sample of
  calibration_samples[case]. Never the row-ordered observed value, never a
  supplied exact target.
- Width unit convention: all widths reported in tables and used in ratios are
  calibration-replication interval widths (mean over replications per
  case x engine, reported raw as coverage_audit.mean_width). engine_audit.width_ratio
  is the geometric mean over cases of (engine mean calibration width / cross-engine
  median mean calibration width for that case). The supplied baseline_low/high
  panel (observed cases only) is used strictly for
  interval_summary.baseline_low/baseline_high/baseline_width_ratio and for the
  probe_04 alias-distance diagnostic; it is never used as the width_ratio
  reference.
- ASSUMPTION (stated, not a fact): probe_panel_03's six unlabeled trailing
  settings are read as a perturbation/response sweep; engines are scored on
  NON-INVARIANCE of log(width) and log(center) across settings relative to the
  observed panel. Log ratios make the score direction-robust to whether a
  setting scales data up or down.
- probe_panel_02 diagnostic note (preserved, not averaged away): the panel rows
  of engine_03 and engine_06 are BITWISE IDENTICAL to their observed panels,
  i.e. exactly zero perturbation response; all other engines respond.
"""
import csv, json, math, os, zlib, struct
import numpy as np

EPS = 1e-12
ZERO_EPS = 1e-15
ROOT = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(ROOT, "data")
OUT = os.path.join(ROOT, "results")
os.makedirs(OUT, exist_ok=True)

def log(msg):
    print(msg, flush=True)

man = json.load(open(os.path.join(DATA, "study_manifest.json")))
probe_man = json.load(open(os.path.join(DATA, "probe_manifest.json")))
NOMINAL = float(man["confidence_level"])
CASES = man["cases"]
CASE_IDS = [c["case_id"] for c in CASES]
REGIME = {c["case_id"]: c["regime"] for c in CASES}
ENGINE_IDS = list(man["engine_ids"])
LABELS = list(man["failure_label_vocabulary"])
FAMILIES = list(probe_man["probe_families"])
NE, NC, NR = len(ENGINE_IDS), len(CASE_IDS), None

def statistic(name, params, v):
    if name == "mean":
        return float(np.mean(v))
    if name == "median":
        return float(np.median(v))
    if name == "coefficient_of_variation":
        return float(np.std(v, ddof=int(params.get("std_ddof", 1))) / np.mean(v))
    if name == "upper_tail_rate":
        thr = float(params["threshold"])
        cmp_ = params.get("comparison", ">=")
        return float(np.mean(v >= thr)) if cmp_ == ">=" else float(np.mean(v > thr))
    raise ValueError(name)

# ---------------- inputs ----------------
z = np.load(os.path.join(DATA, "engine_interval_panels.npz"))
assert list(z["engine_ids"]) == ENGINE_IDS and list(z["case_ids"]) == CASE_IDS
OL, OH = z["observed_low"], z["observed_high"]            # (E, C)
CL, CH = z["calibration_low"], z["calibration_high"]      # (E, C, R)
P2L, P2H = z["probe_panel_02_low"], z["probe_panel_02_high"]
P3L, P3H = z["probe_panel_03_low"], z["probe_panel_03_high"]  # (E,C,6)
BL, BH = z["baseline_low"], z["baseline_high"]            # (C,) observed cases
OBS_STAT = z["observed_stat"]                              # (C,)
cal = np.load(os.path.join(DATA, "calibration_samples.npz"))
obs_rows = list(csv.DictReader(open(os.path.join(DATA, "observed_samples.csv"))))
OBS = {cid: np.array([float(r["value"]) for r in obs_rows if r["case_id"] == cid])
       for cid in CASE_IDS}
for cid in CASE_IDS:
    assert OBS[cid].size == 74

# reproduce observed_stat from public definitions (sanity, not a target)
for i, c in enumerate(CASES):
    s = statistic(c["statistic_name"], c["statistic_parameters"], OBS[c["case_id"]])
    assert abs(s - OBS_STAT[i]) < 1e-9, c["case_id"]

# theta_hat per case: mean of per-replication statistics (order-free)
THETA = np.zeros(NC)
for i, c in enumerate(CASES):
    A = cal[c["case_id"]]
    NR = NR or A.shape[0]
    assert A.shape[0] == 108
    THETA[i] = np.mean([statistic(c["statistic_name"], c["statistic_parameters"], A[r])
                        for r in range(A.shape[0])])
log("theta_hat per case: " + ", ".join("%s=%.4f" % (CASE_IDS[i], THETA[i]) for i in range(NC)))

# ---------------- coverage diagnostics ----------------
cov = np.zeros((NE, NC)); mL = np.zeros((NE, NC)); mH = np.zeros((NE, NC))
mw = np.zeros((NE, NC))          # mean calibration width (calibration-replication unit)
for e in range(NE):
    for i in range(NC):
        lo, hi = CL[e, i], CH[e, i]
        th = THETA[i]
        width = hi - lo
        assert np.all(width >= 0) and np.all(np.isfinite(lo)) and np.all(np.isfinite(hi))
        deg = width < ZERO_EPS
        inside = (lo <= th) & (th <= hi)               # inclusive endpoint-tie convention
        inside[deg] = np.abs(th - lo[deg]) <= ZERO_EPS  # zero-width: miss unless at endpoint
        cov[e, i] = inside.mean()
        mL[e, i] = np.mean((th < lo) & ~deg)
        mH[e, i] = np.mean((th > hi) & ~deg)
        mw[e, i] = width.mean()
ref_mw = np.median(mw, axis=0)                          # cross-engine median per case
logw_ratio = np.log((mw + EPS) / (ref_mw + EPS))
width_ratio = np.exp(logw_ratio.mean(axis=1))           # geometric mean ratio per engine
cov_gap = np.abs(cov - NOMINAL)
tail_imb = np.abs(mL - mH)
width_pen = np.abs(logw_ratio) * 0.25
coverage_score = cov_gap + (mL + mH) + width_pen        # finite severity, lower=better
case_disp = np.std(cov_gap, axis=1)                     # dispersion of |cov-nom| across cases

# ---------------- probe families (severity, higher = worse) ----------------
D = np.zeros((5, NE, NC))
# probe_00: coverage severity at theta_hat (calibration panels)
D[0] = cov_gap
# probe_01: centering/alignment: mean_r |center_r - theta| / width_r
for e in range(NE):
    for i in range(NC):
        ctr = 0.5 * (CL[e, i] + CH[e, i]); w = CH[e, i] - CL[e, i]
        D[1, e, i] = np.mean(np.abs(ctr - THETA[i]) / np.maximum(w, EPS))
# probe_02: perturbation response vs observed panel, normalized by observed width
ow = np.maximum(OH - OL, EPS)
D[2] = (np.abs(P2L - OL) + np.abs(P2H - OH)) / ow
p02_ident = [ENGINE_IDS[e] for e in range(NE)
             if np.array_equal(P2L[e], OL[e]) and np.array_equal(P2H[e], OH[e])]
log("DIAGNOSTIC NOTE probe_02: bitwise-identical (zero-response) engines: %s" % p02_ident)
# probe_03: non-invariance across the 6 settings (ASSUMED response sweep; log-scale
# ratios so the score is robust to the direction of the sweep), normalized
oc = np.maximum((OL + OH) / 2.0, EPS)
lr = np.abs(np.log(np.maximum(P3H - P3L, EPS) / ow[..., None]))
lc = np.abs(np.log(np.maximum(P3L + P3H, EPS) / (2.0 * oc)[..., None]))
D[3] = (lr + lc).mean(axis=2)
# probe_04: distance to the naive-percentile baseline panel (alias family)
D[4] = np.maximum(np.abs(OL - BL[None, :]), np.abs(OH - BH[None, :])) / np.maximum(BH - BL, EPS)[None, :]
assert np.all(np.isfinite(D))

def minmax(a):
    a = np.asarray(a, dtype=float); lo_, hi_ = np.nanmin(a), np.nanmax(a)
    return np.zeros_like(a) if hi_ - lo_ < EPS else (a - lo_) / (hi_ - lo_)

# diagnostic_score: same monotone map (per-family min-max over all case x engine values)
DS = np.stack([minmax(D[k]).reshape(NE * NC) for k in range(5)])
diag_score = np.zeros_like(D)
for k in range(5):
    diag_score[k] = DS[k].reshape(NE, NC)
probe_metric = D.mean(axis=2)                                   # (5,E) engine audit metrics
profile_score = diag_score.mean(axis=0)                         # (E,C) equal family weights

# ---------------- combined audit score (lower = better) ----------------
base_comps = {
    "coverage_gap": cov_gap.mean(axis=1),
    "tail_imbalance": tail_imb.mean(axis=1),
    "abs_log_width_ratio": np.abs(np.log(width_ratio + EPS)),
    "case_dispersion": case_disp,
}
for k in range(5):
    base_comps["probe_%02d" % k] = probe_metric[k]
norm_comps = {k: minmax(v) for k, v in base_comps.items()}
def combined(exclude=None):
    keys = [k for k in norm_comps if not (exclude and k == "probe_" + exclude[-2:])]
    return np.mean([norm_comps[k] for k in keys], axis=0), keys
engine_score, comp_keys = combined()
selected_e = int(np.argmin(engine_score))            # argmin of lower-is-better score
selected_id = ENGINE_IDS[selected_e]
ranking = [ENGINE_IDS[e] for e in np.argsort(engine_score, kind="stable")]
log("engine_score: " + ", ".join("%s=%.4f" % (ENGINE_IDS[e], engine_score[e]) for e in range(NE)))
log("selected_engine=%s ranking=%s" % (selected_id, ranking))

# verification that the winner sits at the good end of every evidence block
log("winner check: rank cov_gap=%.3f tail=%.3f |logWR|=%.3f disp=%.3f probes=%.3f "
    "(mean normalized across engines winner=%.3f vs overall=%.3f)" % (
    minmax(cov_gap.mean(1))[selected_e], minmax(tail_imb.mean(1))[selected_e],
    norm_comps["abs_log_width_ratio"][selected_e], norm_comps["case_dispersion"][selected_e],
    np.mean([norm_comps["probe_%02d" % k][selected_e] for k in range(5)]),
    engine_score[selected_e], engine_score.mean()))

# ---------------- failure-mode evidence (signature-driven, no hard-coding) ------
# Signature statistics per engine (severity direction = higher evidence of that label):
f_base = D[4].mean(axis=1)                                    # ~0 -> baseline quantile alias
# reflection_alias: observed interval is anti-symmetric image of baseline about stat:
# lo ~ 2*s - bh and hi ~ 2*s - bl  (small distance -> alias of a reflected panel)
f_refl = np.zeros(NE)
for e in range(NE):
    rl, rh = 2.0 * OBS_STAT - BH, 2.0 * OBS_STAT - BL
    f_refl[e] = np.mean(np.maximum(np.abs(OL[e] - rl), np.abs(OH[e] - rh)) /
                        np.maximum(BH - BL, EPS))
# discrete_boundary_mismatch: coverage/tail anomaly localized to the discrete_tie case
anom = cov_gap + tail_imb
disc_i = CASE_IDS.index("case_03")
f_disc = np.array([anom[e, disc_i] - np.mean(np.delete(anom[e], disc_i)) for e in range(NE)])
# shape_correction_mismatch: |centering asymmetry| localized to skewed_positive cases
asym = np.zeros((NE, NC))
for e in range(NE):
    for i in range(NC):
        ctr = 0.5 * (CL[e, i] + CH[e, i]); w = CH[e, i] - CL[e, i]
        asym[e, i] = np.mean(np.abs(ctr - THETA[i])) / max(mw[e, i], EPS)
skew_i = [i for i, c in enumerate(CASES) if REGIME[c["case_id"]] == "skewed_positive"]
f_shape = np.array([np.mean([asym[e, i] for i in skew_i]) -
                    np.mean([asym[e, i] for i in range(NC) if i not in skew_i])
                    for e in range(NE)])
# scale_response_mismatch: systematic width inflation/deflation + panel-03 non-invariance
f_scale = np.abs(np.log(width_ratio + EPS)) + D[3].mean(axis=1)
# noise_amplifying_engine: cross-case instability (dispersion of coverage and width share)
f_noise = case_disp + np.std(logw_ratio, axis=1)
# reliable_engine: overall goodness = complement of combined audit score
f_rel = -engine_score

EV = {
    "baseline_quantile_alias": minmax(-f_base),
    "reflection_alias": minmax(-f_refl),
    "discrete_boundary_mismatch": minmax(f_disc),
    "shape_correction_mismatch": minmax(f_shape),
    "scale_response_mismatch": minmax(f_scale),
    "noise_amplifying_engine": minmax(f_noise),
    "reliable_engine": minmax(f_rel),
}
ev_mat = np.stack([EV[l] for l in LABELS])                    # (L,E)
pred_e, pred_l = [], []
for e in range(NE):
    best = max(range(len(LABELS)), key=lambda l: (ev_mat[l, e], -l))  # tie -> vocabulary order
    pred_e.append(best); pred_l.append(LABELS[best])
failure_modes = {ENGINE_IDS[e]: pred_l[e] for e in range(NE)}
assert abs(engine_score[selected_e] - engine_score.min()) < EPS
log("failure_modes: " + json.dumps(failure_modes))

# ---------------- write tables ----------------
def wcsv(name, cols, rows):
    path = os.path.join(OUT, name)
    with open(path, "w", newline="") as f:
        w = csv.writer(f); w.writerow(cols); w.writerows(rows)
    log("wrote %s (%d rows)" % (name, len(rows)))

wcsv("engine_audit.csv", man["audit_columns"]["engine_audit"],
     [[ENGINE_IDS[e], cov_gap[e].mean(), tail_imb[e].mean(), width_ratio[e], case_disp[e],
       *[probe_metric[k, e] for k in range(5)], engine_score[e]] for e in range(NE)])

wcsv("coverage_audit.csv", man["audit_columns"]["coverage_audit"],
     [[CASE_IDS[i], REGIME[CASE_IDS[i]], ENGINE_IDS[e], NOMINAL, cov[e, i], mw[e, i],
       mL[e, i], mH[e, i], CL.shape[2], coverage_score[e, i]]
      for i in range(NC) for e in range(NE)])

wcsv("probe_audit.csv", man["audit_columns"]["probe_audit"],
     [[CASE_IDS[i], FAMILIES[k], ENGINE_IDS[e], D[k, e, i], diag_score[k, e, i]]
      for i in range(NC) for k in range(5) for e in range(NE)])

wcsv("case_probe_profile.csv", man["audit_columns"]["case_probe_profile"],
     [[CASE_IDS[i], ENGINE_IDS[e], *[D[k, e, i] for k in range(5)], profile_score[e, i]]
      for i in range(NC) for e in range(NE)])

wcsv("failure_evidence.csv", man["audit_columns"]["failure_evidence"],
     [[ENGINE_IDS[e], LABELS[l], ev_mat[l, e],
       1 + sum(1 for q in range(len(LABELS))
               if (ev_mat[q, e] > ev_mat[l, e] or
                   (abs(ev_mat[q, e] - ev_mat[l, e]) < EPS and q < l))),
       1 if LABELS[l] == pred_l[e] else 0]
      for e in range(NE) for l in range(len(LABELS))])

abl_rows = []
def abl_rank(score):
    return list(np.argsort(score, kind="stable"))
score_none, _ = combined()
for excl in ["none"] + FAMILIES:
    sc, _ = combined(None if excl == "none" else excl)
    order = abl_rank(sc)
    margin = sc[order[1]] - sc[order[0]]
    abl_rows.append([excl, ENGINE_IDS[order[0]], int(order.index(selected_e)) + 1,
                     ENGINE_IDS[order[1]], max(0.0, margin)])
wcsv("family_ablation.csv", man["audit_columns"]["family_ablation"], abl_rows)

wcsv("interval_summary.csv",
     ["case_id", "statistic_name", "observed_stat", "selected_engine_id",
      "selected_low", "selected_high", "baseline_low", "baseline_high",
      "selected_width", "baseline_width_ratio"],
     [[CASE_IDS[i], CASES[i]["statistic_name"], OBS_STAT[i], selected_id,
       OL[selected_e, i], OH[selected_e, i], BL[i], BH[i],
       OH[selected_e, i] - OL[selected_e, i],
       (OH[selected_e, i] - OL[selected_e, i]) / max(BH[i] - BL[i], EPS)]
      for i in range(NC)])

case_warnings = {}
for i, cid in enumerate(CASE_IDS):
    flags = []
    if cov[selected_e, i] < NOMINAL - 0.02: flags.append("selected_engine_undercovered")
    if cov[selected_e, i] > NOMINAL + 0.02: flags.append("selected_engine_overcovered")
    if tail_imb[selected_e, i] > 0.05: flags.append("tail_imbalance")
    if profile_score[selected_e, i] >= profile_score[:, i].max() - EPS:
        flags.append("probe_outlier")
    if cov_gap[:, i].min() > 0.15: flags.append("case_all_engines_miscalibrated")
    case_warnings[cid] = {
        "regime": REGIME[cid], "theta_hat": float(THETA[i]),
        "selected_empirical_coverage": float(cov[selected_e, i]),
        "miss_low_rate": float(mL[selected_e, i]), "miss_high_rate": float(mH[selected_e, i]),
        "coverage_gap": float(cov_gap[selected_e, i]),
        "max_engine_probe_score": float(profile_score[:, i].max()),
        "warnings": flags,
    }
    if flags: log("case_warning %s: %s" % (cid, flags))

report = {
    "selected_engine_id": selected_id,
    "aggregate_coverage_gap": float(cov_gap[selected_e].mean()),
    "aggregate_tail_imbalance": float(tail_imb[selected_e].mean()),
    "aggregate_probe_score": float(profile_score[selected_e].mean()),
    "engine_ranking": ranking,
    "case_warnings": case_warnings,
    "notes": {
        "nominal_coverage": NOMINAL, "n_replications": int(CL.shape[2]),
        "endpoint_tie_convention": "inclusive [lo,hi]; zero-width = miss unless theta at endpoint",
        "width_unit": "mean calibration-replication interval width",
        "probe_02_note": "engines with bitwise-identical probe_panel_02 rows (zero response): "
                         + ", ".join(p02_ident),
        "probe_03_assumption": "six unlabeled settings read as response sweep; log-scale non-invariance",
    },
}
json.dump(report, open(os.path.join(OUT, "reliability_report.json"), "w"), indent=2)
json.dump({"selected_engine_id": selected_id, "failure_modes": failure_modes},
          open(os.path.join(OUT, "failure_modes.json"), "w"), indent=2)
json.dump({"selected_engine_id": selected_id,
           "selected_failure_mode": failure_modes[selected_id],
           "selected_engine_score": float(engine_score[selected_e])},
          open(os.path.join(OUT, "selected_engine.json"), "w"), indent=2)
log("wrote reliability_report.json / failure_modes.json / selected_engine.json")

# ---------------- figure: matplotlib if available, else pure-stdlib PNG --------
PNG_PATH = os.path.join(OUT, "engine_overview.png")

def _png_write(path, W, H, px):
    raw = b"".join(b"\x00" + px[y * W * 3:(y + 1) * W * 3] for y in range(H))
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + \
               struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 9)))
        f.write(chunk(b"IEND", b""))

