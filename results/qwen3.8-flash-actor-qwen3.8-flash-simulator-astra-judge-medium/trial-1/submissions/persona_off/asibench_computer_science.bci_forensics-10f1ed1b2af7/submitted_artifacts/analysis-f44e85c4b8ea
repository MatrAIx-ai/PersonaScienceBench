def _text(px, W, H, x, y, s, sc, col):
    cx = x
    for ch_ in s.upper():
        g = _FONT.get(ch_, _FONT[" "])
        for r in range(7):
            for c in range(5):
                if g[r][c] == "1":
                    for dy in range(sc):
                        for dx in range(sc):
                            xx, yy = cx + c * sc + dx, y + r * sc + dy
                            if 0 <= xx < W and 0 <= yy < H:
                                o = (yy * W + xx) * 3
                                px[o:o + 3] = bytes(col)
        cx += 6 * sc

def _bar(px, W, H, x0, y0, x1, y1, col):
    for yy in range(max(0, int(y0)), min(H, int(y1))):
        for xx in range(max(0, int(x0)), min(W, int(x1))):
            o = (yy * W + xx) * 3
            px[o:o + 3] = bytes(col)

def make_png_stdlib():
    W, H = 1000, 700
    px = bytearray(b"\xff" * (W * H * 3))
    BLACK, BLUE, GREEN, GRAY = (20, 20, 20), (60, 110, 200), (40, 150, 80), (150, 150, 150)
    _text(px, W, H, 20, 10, "ANONYMOUS BOOTSTRAP-CI ENGINE AUDIT", 3, BLACK)
    _text(px, W, H, 20, 40, "SELECTED: %s  (ARGMIN COMBINED SCORE, LOWER = BETTER)" % selected_id, 2, GREEN)
    names = ["COV GAP", "TAIL IMB", "WIDTH PEN", "CASE DISP",
