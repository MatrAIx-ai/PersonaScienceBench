def ax(d, box, x0, x1, y0, y1, title, xlab, ylab, yfmt="{:.3f}"):
    l,t_,r,b = box
    d.rectangle([l,t_,r,b], outline=(60,60,60))
    for i in range(6):
        xv = x0+(x1-x0)*i/5; yv = y0+(y1-y0)*i/5
        px = l+(r-l)*i/5; py = b-(b-t_)*i/5
        d.line([px,b,px,b+5], fill=(60,60,60)); d.line([l,py,l-5,py], fill=(60,60,60))
        d.text((px-16,b+8), ("%g" % xv), font=F11, fill=(30,30,30))
        d.text((l-60,py-7), yfmt.format(yv), font=F11, fill=(30,30,30))
    d.text((l+(r-l)//2-70, b+30), xlab, font=F12, fill=(0,0,0))
    d.text((6, t_+(b-t_)//2-70), ylab, font=F12, fill=(0,0,0))
    d.text((l, 20), title, font=F16, fill=(0,0,0))
    def T(x,y):
        return (l+(r-l)*(x-x0)/(x1-x0), b-(b-t_)*(y-y0)/(y1-y0))
    return T
