def fallback_plot(outdir):
    """Pure-numpy PNG fallback if the PIL route is unavailable."""
    import zlib, struct
    def png(path, px):
        h, w, _ = px.shape
        raw = b''.join(b'\x00' + px[r].tobytes() for r in range(h))
        def ch(t, dd): return struct.pack('>I', len(dd)) + t + dd + struct.pack('>I', zlib.crc32(t + dd) & 0xffffffff)
        open(path, 'wb').write(b'\x89PNG\r\n\x1a\n' + ch(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)) + ch(b'IDAT', zlib.compress(raw, 6)) + ch(b'IEND', b''))
    W, H = 900, 600
    def blank(): return np.full((H, W, 3), 250, np.uint8)
    def line(px, x0, y0, x1, y1, c, wd=2):
        N = int(max(abs(x1 - x0), abs(y1 - y0)) * 3) + 2
        for t in np.linspace(0, 1, N):
            x, y = int(x0 + (x1 - x0) * t), int(y0 + (y1 - y0) * t)
            px[max(y - wd, 0):y + wd, max(x - wd, 0):x + wd] = c
    def frame(px):
        for seg in [(80, 40, 80, H - 60), (80, H - 60, W - 20, H - 60), (W - 20, 40, W - 20, H - 60), (80, 40, W - 20, 40)]:
            line(px, *seg, (0, 0, 0), 1)
    mx = max([c[2] for c in plot_data['curveA']] + [TARGET * 1.6])
    def q(t, v): return (80 + (W - 100) * t / 9.0, (H - 60) - (H - 100) * v / mx)
    px = blank(); frame(px)
    ty, _ = q(0, TARGET); px[int(ty) - 1:int(ty) + 2, 80:W - 20] = (214, 39, 40)
    for curve, col in [(plot_data['curveA'], (31, 119, 180)), (plot_data['curveB'], (214, 39, 40))]:
        pts = [q(c[3], c[1]) for c in curve][::-1]
        for a, b in zip(pts[:-1], pts[1:]): line(px, *a, *b, col, 2)
    png(f'{outdir}/set_size_tradeoff.png', px)
    px = blank(); frame(px)
    vals = plot_data['groups']['emp'] + [plot_data['overall']['emp']]
    for i, v in enumerate(vals):
        x0 = 140 + i * 180; y1 = int((H - 60) - (H - 100) * v / mx); px[y1:H - 60, x0:x0 + 60] = (31, 119, 180)
    ty = int((H - 60) - (H - 100) * TARGET / mx); px[ty - 1:ty + 2, 80:W - 20] = (214, 39, 40)
    png(f'{outdir}/partition_audit.png', px)
    px = blank(); frame(px)
    hc = np.array(plot_data['hist_cal'], float); hd = np.array(plot_data['hist_dep'], float)
    for i in range(20):
        x0 = 80 + i * (W - 100) / 20
        for arr, col, off in [(hc, (31, 119, 180), 0), (hd, (214, 39, 40), 14)]:
            hgt = int(arr[i] / max(hc.max(), hd.max()) * (H - 110)); px[H - 60 - hgt:H - 60, int(x0) + off:int(x0) + off + 13] = col
    png(f'{outdir}/score_diagnostics.png', px)

