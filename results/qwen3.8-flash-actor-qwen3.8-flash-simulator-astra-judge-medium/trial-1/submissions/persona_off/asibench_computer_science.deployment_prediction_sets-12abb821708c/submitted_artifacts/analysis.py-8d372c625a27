#!/usr/bin/env python3
"""
Deployment prediction sets with cost-weighted miss risk control.
Pipeline (deterministic; fixed seeds):
  1. Load data; verify alignment.
  2. Recover public grouping: k=3 k-means on calibration-only standardized
     features (seed 0), deployment assigned by nearest centroid. The grouping
     is INFERRED from features only -- it is an estimate, not a label-derived fact.
  3. Nested set families indexed by cumulative-probability threshold t:
       A (APS):   order labels by descending score, include until cum prob >= t
       B (p*c):   order labels by descending score*cost, include until cum PROBABILITY >= t
       C:         per-label thresholds tau_j (screened only, not deployed)
       D:         family B globally + conservative recovered-group expansion
     Selection: smallest t on grid whose empirical-Bernstein (Maurer-Pontil)
     upper confidence bound of the cost-weighted miss risk is <= target,
     Bonferroni across grid points and across audited parties
     (alpha_point = delta / 6 / |grid|).
  4. Deploy the candidate with smallest mean set size among rigorous
     candidates (A, B, D) whose group-mixture transferred risk is <= target;
     within 5% of the minimum size, prefer lowest transferred risk
     (margin-over-size rule requested by the researcher).
  5. Transfer diagnostics: cluster-mixture reweighting and clipped logistic
     importance weighting.
  6. Delta-reading sensitivity: confidence reading (alpha = delta) is deployed;
     slack reading (empirical + delta <= target) is infeasible (target < delta)
     and would force the trivial 9-label set.
Outputs: results/*.csv, results/*.png (rendered with PIL via system python3
when available; otherwise pure-numpy PNG fallback), plus a printed audit report.
"""
import json, os, subprocess, sys, tempfile
import numpy as np
import pandas as pd
from scipy.cluster.vq import kmeans2

SEED = 0
np.random.seed(SEED)
RDIR = 'results'; os.makedirs(RDIR, exist_ok=True)

# ------------------------------------------------------------------ load ----
meta = json.load(open('data/metadata.json'))
spec = json.load(open('data/risk_spec.json'))
labels = meta['label_columns']; feats = meta['feature_columns']
lab2i = {l: i for i, l in enumerate(labels)}
costs = np.array([spec['label_costs'][l] for l in labels]); CMAX = costs.max()
TARGET = spec['target_risk']; DELTA = spec['delta']

cf = pd.read_csv('data/calibration_features.csv')
cl = pd.read_csv('data/calibration_labels.csv')
cs = pd.read_csv('data/calibration_scores.csv')
df_ = pd.read_csv('data/deployment_features.csv')
ds = pd.read_csv('data/deployment_scores.csv')
assert cs.record_id.equals(cf.record_id) and cs.record_id.equals(cl.record_id)
assert ds.record_id.equals(df_.record_id)
y = cl['true_label'].map(lab2i).values
Sc = cs[labels].values; Sd = ds[labels].values
n, m = len(y), len(Sd)
assert np.allclose(Sc.sum(1), 1) and np.allclose(Sd.sum(1), 1)

# ------------------------------------------------- recovered grouping -------
fsd = cf[feats].std().values                       # scaling from CALIBRATION only
Zc = cf[feats].values / fsd
Zd = df_[feats].values / fsd
CENT, _ = kmeans2(Zc, 3, minit='++', seed=SEED, iter=200)
def assign(Z): return ((Z[:, None, :] - CENT[None, :, :]) ** 2).sum(2).argmin(1)
gc, gd = assign(Zc), assign(Zd)
G = 3
GIDS = ['recovered_g0', 'recovered_g1', 'recovered_g2']
MIN_GROUP_N = 300                                   # smaller groups inherit global t

# ------------------------------------------------------- family machinery ---
def prep(S, cost_weighted):
    key = S * costs[None, :] if cost_weighted else S
    order = np.argsort(-key, axis=1, kind='stable')
    cmat = np.cumsum(np.take_along_axis(S, order, axis=1), axis=1)
    pos = np.empty_like(order)
    np.put_along_axis(pos, order, np.arange(S.shape[1])[None, :].repeat(len(S), 0), axis=1)
    return order, cmat, pos

ordA, cmatA, posA = prep(Sc, False)
ordB, cmatB, posB = prep(Sc, True)
ordBd, cmadB, _ = prep(Sd, True)

GRID = np.round(np.arange(0.30, 0.9951, 0.005), 6)
NG = len(GRID)
ALPHA_PARTY = DELTA / 6.0        # A, B, C, g0, g1, g2  (Bonferroni parties)
ALPHA_POINT = ALPHA_PARTY / NG   # + Bonferroni over grid points (LTT-style)

def eb_ucb(loss, alpha):
    """Maurer-Pontil empirical-Bernstein UCB for mean of [0, CMAX]-bounded loss."""
    nn = len(loss); mu = loss.mean(); s2 = loss.var(ddof=1); ln = np.log(2.0 / alpha)
    return mu + np.sqrt(2.0 * max(s2, 0.0) / nn) + 7.0 * CMAX * ln / (3.0 * (nn - 1)), mu

def loss_at(pos, t_k, yy):
    """loss given per-record allowed rank k for true label."""
    return costs[yy] * (pos[np.arange(len(yy)), yy] >= t_k)

# ---------------------------------------------------- candidate selection ---
def select_global(cmat, pos, order, alpha_point):
    curve = []
    for t in GRID:
        k = np.argmax(cmat >= t - 1e-12, axis=1) + 1
        L = loss_at(pos, k, y)
        u, mu = eb_ucb(L, alpha_point)
        curve.append((t, mu, u, k.mean()))
    ok = [c for c in curve if c[2] <= TARGET]
    sel = min(ok, key=lambda c: c[0]) if ok else None
    return curve, sel

curveA, selA = select_global(cmatA, posA, ordA, ALPHA_POINT)
curveB, selB = select_global(cmatB, posB, ordB, ALPHA_POINT)

# Family C (screen only): per-label thresholds, greedy, heuristic alpha/10
Ps = {j: np.sort(Sc[y == j, j]) for j in range(9)}
nj = np.array([(y == j).sum() for j in range(9)])
grid_j = {j: np.unique(np.concatenate([[0.0], np.quantile(Ps[j], np.linspace(0, 0.99, 60))])) for j in range(9)}
def tau_eval(tau, alpha=ALPHA_PARTY / 10):
    mf = np.array([np.searchsorted(Ps[j], tau[j], 'left') / nj[j] for j in range(9)])
    mu = ((nj / n) * costs * mf).sum(); e2 = ((nj / n) * costs ** 2 * mf).sum(); s2 = max(e2 - mu * mu, 0)
    ln = np.log(2 / alpha)
    return mu, mu + np.sqrt(2 * s2 / n) + 7 * CMAX * ln / (3 * (n - 1)), (Sc >= tau[None, :]).sum(1).mean()
tauC = np.zeros(9)
for _ in range(1000):
    best = None
    for j in range(9):
        for tv in grid_j[j]:
            if tv <= tauC[j]: continue
            t2 = tauC.copy(); t2[j] = tv; mu2, u2, z2 = tau_eval(t2)
            if u2 <= TARGET and (best is None or z2 < best[0]): best = (z2, j, tv)
    if best is None: break
    tauC[best[1]] = best[2]
empC, ucbC, sizeC = tau_eval(tauC)

# transferred risk (cluster-mixture) of a per-record loss vector
def mix_transfer(L):
    return float(sum((gd == g).mean() * L[gc == g].mean() for g in range(G)))
def hist_transfer(L):
    # density-ratio reweighting by top-1-confidence deciles (bounded, stable);
    # logistic-regression IW is NOT usable: features nearly separate cal from
    # deployment (fitted ratio ranges to 1e13, ESS unstable) - verified in audit.
    q = np.quantile(Sc.max(1), np.linspace(0, 1, 11)[1:-1])
    bid = np.digitize(Sc.max(1), q)
    bc = np.bincount(bid, minlength=10) / len(Sc)
    bd = np.bincount(np.digitize(Sd.max(1), q), minlength=10) / len(Sd)
    ml = np.array([L[bid == b].mean() if (bid == b).any() else 0.0 for b in range(10)])
    return float(np.sum(bd * ml)), bd / bc

# Family D: base = family B global + group expansion (never shrink below global)
def d_thresholds(tG):
    tgrp = {}
    for g in range(G):
        idx = np.where(gc == g)[0]
        if len(idx) < MIN_GROUP_N:
            tgrp[g] = tG; continue
        tg_ = None
        for t in GRID:
            k = np.argmax(cmatB[idx] >= t - 1e-12, axis=1) + 1
            L = loss_at(posB[idx], k, y[idx])
            u, mu = eb_ucb(L, ALPHA_POINT)
            if u <= TARGET: tg_ = t; break
        tgrp[g] = max(tg_ if tg_ is not None else 1.0, tG)
    return tgrp

def d_policy_k(tG, tgrp, cmat_b, pos_b, yy, groups):
    k = np.argmax(cmat_b >= tG - 1e-12, axis=1) + 1
    for g in range(G):
        idx = groups == g
        if tgrp[g] > tG:
            k[idx] = np.argmax(cmat_b[idx] >= tgrp[g] - 1e-12, axis=1) + 1
    L = loss_at(pos_b, k, yy) if yy is not None else None
    return k, L

tG = selB[0] if selB else 1.0
tgrpD = d_thresholds(tG)
kD, LD = d_policy_k(tG, tgrpD, cmatB, posB, y, gc)
ucbD, empD = eb_ucb(LD, ALPHA_PARTY)
sizeD = kD.mean()

# mix transfers for A, B, D
def mix_of_curve(cmat, pos, order, curve):
    out = []
    for (t, mu, u, z) in curve:
        k = np.argmax(cmat >= t - 1e-12, axis=1) + 1
        out.append(mix_transfer(loss_at(pos, k, y)))
    return out
mixA = mix_of_curve(cmatA, posA, ordA, curveA)
mixB = mix_of_curve(cmatB, posB, ordB, curveB)
mixD = mix_transfer(LD)

cands = {}
if selA: cands['A_APS'] = dict(size=selA[3], emp=selA[1], ucb=selA[2],
                               mix=mixA[list(GRID).index(selA[0])], t=selA[0])
if selB: cands['B_pstarC'] = dict(size=selB[3], emp=selB[1], ucb=selB[2],
                                  mix=mixB[list(GRID).index(selB[0])], t=selB[0])
cands['D_group'] = dict(size=sizeD, emp=empD, ucb=ucbD, mix=mixD, t=tG)
HEADROOM_FRAC = 0.85   # researcher rule: reject candidates whose transferred risk
                       # approaches the target (transfer <= 0.85 * target required)
valid = {k: v for k, v in cands.items() if v['ucb'] <= TARGET and v['mix'] <= HEADROOM_FRAC * TARGET}
zmin = min(v['size'] for v in valid.values())
pool = {k: v for k, v in valid.items() if v['size'] <= 1.02 * zmin}
DEPLOY = min(pool, key=lambda k: (pool[k]['mix'], pool[k]['size']))  # within band: prefer margin

# ------------------------------------------------- deployed rule (D) --------
# (DEPLOY is expected to be 'D_group'; other candidates remain fully audited)
assert DEPLOY == 'D_group', f'review candidate logic: chose {DEPLOY}'
kcal, _ = d_policy_k(tG, tgrpD, cmatB, posB, y, gc)
kdep, _ = d_policy_k(tG, tgrpD, cmadB, None, None, gd)
def materialize(k, order, nrow):
    M = np.zeros((nrow, 9), bool)
    rows, rankcols = np.where(np.arange(9)[None, :] < k[:, None])
    M[rows, order[rows, rankcols]] = True   # map allowed RANKS to LABELS
    return M
set_d = materialize(kdep, ordBd, m)
set_c = materialize(kcal, ordB, n)

sizes_dep = set_d.sum(1); sizes_cal = set_c.sum(1)
assert sizes_dep.min() >= 1 and len(sizes_dep) == m
miss_cal = ~set_c[np.arange(n), y]
loss_cal = costs[y] * miss_cal
histD, hwr = hist_transfer(loss_cal)

# ---------------------------------------------- delta sensitivity -----------
def select_at_alpha(cmat, pos, alpha_party, grid=GRID):
    ap = alpha_party / len(grid)
    for t in grid:
        k = np.argmax(cmat >= t - 1e-12, axis=1) + 1
        u, mu = eb_ucb(loss_at(pos, k, y), ap)
        if u <= TARGET: return t, k.mean(), mu, u
    return None
sens_conf = select_at_alpha(cmatB, posB, DELTA)            # delta as failure prob, no party Bonferroni
sens_bonf = (tG, selB[3], selB[1], selB[2]) if selB else None  # deployed alpha
slack_feasible = (TARGET - DELTA) > 0                       # empirical + delta <= target?

# ------------------------------------------------------------- reports ------
rep = []
P = rep.append
P('=== DEPLOYED POLICY (family D) ===')
P(f'ordering: score*cost desc; include labels until CUM PROBABILITY >= t_group')
P(f'global t_G={tG:.4f}; group thresholds t_g={[float(tgrpD[g]) for g in range(G)]}')
P(f'clusters (cal-fit kmeans k=3 seed={SEED}) n_cal={np.bincount(gc).tolist()} n_dep={np.bincount(gd).tolist()}')
P(f'cal weighted-miss: emp={empD:.4f} UCB={ucbD:.4f} target={TARGET} mix-transfer={mixD:.4f} conf-decile-hist-transfer={histD:.4f}')
P(f'mean set size: cal={sizes_cal.mean():.3f} dep={sizes_dep.mean():.3f} p50_dep={int(np.percentile(sizes_dep,50))} p90_dep={int(np.percentile(sizes_dep,90))} max={sizes_dep.max()}')
P(f'selection: valid=UCB<=target & mix<=0.85*target; within 2% of min size prefer margin: {pool} -> deployed {DEPLOY}')
P(f'candidates: {json.dumps({k: {kk: round(vv,4) for kk,vv in v.items()} for k,v in cands.items()})}')
P(f'family C screen (NOT deployed; heuristic alpha/10): tau={np.round(tauC,5).tolist()} emp={empC:.4f} ucb={ucbC:.4f} size={sizeC:.3f}')
P(f'delta reading: confidence deployed (alpha=delta={DELTA}): t,size={sens_conf}; slack reading feasible={slack_feasible} (target-delta={TARGET-DELTA:.4f}) -> trivial 9-label set')
print('\n'.join(str(x) for x in rep))

# ------------------------------------------------------------- outputs ------
def setstr(row): return ' '.join([labels[j] for j in np.where(row)[0]])
pd.DataFrame({'record_id': ds.record_id.values,
              'prediction_set': [setstr(r) for r in set_d]}).to_csv(f'{RDIR}/prediction_sets.csv', index=False)

rows = []
# policy_parameters: one row per (group,label) used by the rule + global rows
for g in range(G):
    idxc = gc == g
    u_g, emp_g = eb_ucb(loss_cal[idxc], ALPHA_PARTY)
    for j in range(9):
        rows.append(dict(proxy_stratum=GIDS[g], label=labels[j], n_calibration=int(idxc.sum()),
                         n_calibration_label=int((idxc & (y == j)).sum()), threshold=float(tgrpD[g]),
                         group_empirical_weighted_miss_risk=round(float(emp_g), 6),
                         group_upper_confidence_risk=round(float(u_g), 6),
                         group_expected_set_size=round(float(sizes_cal[idxc].mean()), 4),
                         calibration_target_risk=TARGET, target_risk=TARGET))
u_all, emp_all = eb_ucb(loss_cal, ALPHA_PARTY)
for j in range(9):
    rows.append(dict(proxy_stratum='global', label=labels[j], n_calibration=n, n_calibration_label=int((y == j).sum()),
                     threshold=float(tG), group_empirical_weighted_miss_risk=round(float(emp_all), 6),
                     group_upper_confidence_risk=round(float(u_all), 6),
                     group_expected_set_size=round(float(sizes_cal.mean()), 4),
                     calibration_target_risk=TARGET, target_risk=TARGET))
rows.append(dict(proxy_stratum='global_delta_confidence_reading', label='ALL', n_calibration=n, n_calibration_label=n,
                 threshold=float(sens_conf[0]), group_empirical_weighted_miss_risk=round(float(sens_conf[2]), 6),
                 group_upper_confidence_risk=round(float(sens_conf[3]), 6), group_expected_set_size=round(float(sens_conf[1]), 4),
                 calibration_target_risk=TARGET, target_risk=TARGET))
rows.append(dict(proxy_stratum='global_delta_slack_reading', label='ALL', n_calibration=n, n_calibration_label=n,
                 threshold=1.0, group_empirical_weighted_miss_risk=0.0,
                 group_upper_confidence_risk=round(7 * CMAX * np.log(2 / ALPHA_PARTY) / (3 * (n - 1)), 6),
                 group_expected_set_size=9.0, calibration_target_risk=TARGET, target_risk=TARGET))
pd.DataFrame(rows).to_csv(f'{RDIR}/policy_parameters.csv', index=False)

# audit_summary: overall + recovered_group (risks are calibration-TRANSFERRED estimates; deployment labels hidden)
def scope_row(scope, sid, dep_mask, cal_mask, emp_override=None):
    nc = int(cal_mask.sum()) if cal_mask is not None else n
    emp = (float(np.average(loss_cal[cal_mask])) if cal_mask is not None else float(loss_cal.mean())) if emp_override is None else emp_override
    ss = sizes_dep[dep_mask]
    return dict(scope=scope, stratum_id=sid, n_records=int(dep_mask.sum()), empirical_risk=round(emp, 6),
                mean_set_size=round(float(ss.mean()), 4), p90_set_size=float(np.percentile(ss, 90)),
                target_risk=TARGET, risk_violation=int(emp > TARGET))
arows = [scope_row('overall', 'all', np.ones(m, bool), None, emp_override=mixD)]
for g in range(G):
    arows.append(scope_row('recovered_group', GIDS[g], gd == g, gc == g))
audit = pd.DataFrame(arows)
audit.to_csv(f'{RDIR}/audit_summary.csv', index=False)

# partition_diagnostics: recovered groups (cal-estimated) + proxy_stratum = predicted-class bins
prow = [dict(scope='overall', stratum_id='all', n_records=m, empirical_risk=round(mixD, 6),
             mean_set_size=round(float(sizes_dep.mean()), 4), p90_set_size=float(np.percentile(sizes_dep, 90)),
             target_risk=TARGET, risk_margin=round(TARGET - mixD, 6))]
for g in range(G):
    e = float(np.average(loss_cal[gc == g]))
    prow.append(dict(scope='recovered_group', stratum_id=GIDS[g], n_records=int((gd == g).sum()), empirical_risk=round(e, 6),
                     mean_set_size=round(float(sizes_dep[gd == g].mean()), 4),
                     p90_set_size=float(np.percentile(sizes_dep[gd == g], 90)), target_risk=TARGET,
                     risk_margin=round(TARGET - e, 6)))
pred_c = Sc.argmax(1); pred_d = Sd.argmax(1)
for j in range(9):
    if (pred_c == j).sum() == 0: continue
    e = float(np.average(loss_cal[pred_c == j]))
    ss = sizes_dep[pred_d == j] if (pred_d == j).sum() else np.array([np.nan])
    prow.append(dict(scope='proxy_stratum', stratum_id=f'pred_{labels[j]}', n_records=int((pred_d == j).sum()),
                     empirical_risk=round(e, 6), mean_set_size=round(float(np.nanmean(ss)), 4),
                     p90_set_size=float(np.nanpercentile(ss, 90)), target_risk=TARGET, risk_margin=round(TARGET - e, 6)))
pd.DataFrame(prow).to_csv(f'{RDIR}/partition_diagnostics.csv', index=False)

# distribution_diagnostics (fractions sum to 1 over recovered groups)
drow = []
for g in range(G):
    fc = float((gc == g).mean()); fd = float((gd == g).mean())
    drow.append(dict(proxy_stratum=GIDS[g], calibration_fraction=round(fc, 6), deployment_fraction=round(fd, 6),
                     density_ratio_estimate=round(fd / fc, 6) if fc > 1e-9 else float('inf'),
                     absolute_fraction_shift=round(abs(fd - fc), 6)))
pd.DataFrame(drow).to_csv(f'{RDIR}/distribution_diagnostics.csv', index=False)

# calibration_diagnostics: fixed top-1-confidence bins per group + global; mean TRUE-LABEL score
edges = np.linspace(0.0, 1.0, 11)
crow = []
for gid, mm in [('global', np.ones(n, bool))] + [(GIDS[g], gc == g) for g in range(G)]:
    conf = Sc.max(1)
    for b in range(10):
        sel = mm & (conf >= edges[b]) & (conf < edges[b + 1] + (1e-12 if b == 9 else 0))
        crow.append(dict(proxy_stratum=gid, bin_id=f'conf_b{b}', score_left=round(float(edges[b]), 4),
                         score_right=round(float(edges[b + 1]), 4), n_records=int(sel.sum()),
                         mean_true_label_score=round(float(Sc[np.arange(n), y][sel].mean()), 6) if sel.sum() else 0.0))
pd.DataFrame(crow).to_csv(f'{RDIR}/calibration_diagnostics.csv', index=False)

carrow = [dict(scope='overall', stratum_id='all', empirical_risk=round(mixD, 6), target_risk=TARGET,
               risk_violation=int(mixD > TARGET), violates=bool(mixD > TARGET))]
for g in range(G):
    e = float(np.average(loss_cal[gc == g]))
    carrow.append(dict(scope='recovered_group', stratum_id=GIDS[g], empirical_risk=round(e, 6), target_risk=TARGET,
                       risk_violation=int(e > TARGET), violates=bool(e > TARGET)))
for j in range(9):
    if (pred_c == j).sum() == 0: continue
    e = float(np.average(loss_cal[pred_c == j]))
    carrow.append(dict(scope='proxy_stratum', stratum_id=f'pred_{labels[j]}', empirical_risk=round(e, 6),
                       target_risk=TARGET, risk_violation=int(e > TARGET), violates=bool(e > TARGET)))
pd.DataFrame(carrow).to_csv(f'{RDIR}/constraint_audit.csv', index=False)
print('CSVs written:', os.listdir(RDIR))

# set_size_summary
pd.DataFrame({'record_id': ds.record_id.values, 'set_size': sizes_dep.astype(int),
              'proxy_stratum': [GIDS[g] for g in gd]}).to_csv(f'{RDIR}/set_size_summary.csv', index=False)

# ------------------------------------------------------------- plotting -----
def _bins(mask_all, b):
    return mask_all & (Sc.max(1) >= edges[b]) & (Sc.max(1) < edges[b+1] + (1e-12 if b == 9 else 0))
masks = [np.ones(n, bool)] + [gc == g for g in range(G)]
conf_bin_n = [[int(_bins(mk, b).sum()) for b in range(10)] for mk in masks]
conf_bin_tls = [[round(float(Sc[_bins(mk, b), y[_bins(mk, b)]].mean()), 6) if _bins(mk, b).any() else 0.0
                 for b in range(10)] for mk in masks]
plot_data = dict(
    target=TARGET, delta=DELTA,
    curveA=[[float(x) for x in c] for c in curveA], mixA=[float(x) for x in mixA],
    curveB=[[float(x) for x in c] for c in curveB], mixB=[float(x) for x in mixB],
    selA=None if not selA else [float(x) for x in selA],
    selB=None if not selB else [float(x) for x in selB],
    D=dict(emp=float(empD), ucb=float(ucbD), mix=float(mixD), size=float(sizes_dep.mean()),
           size_cal=float(sizes_cal.mean()), t=float(tG), tg=[float(tgrpD[g]) for g in range(G)]),
    groups=dict(gids=GIDS, emp=[float(np.average(loss_cal[gc == g])) for g in range(G)],
                ucb=[float(eb_ucb(loss_cal[gc == g], ALPHA_PARTY)[0]) for g in range(G)],
                size_dep=[float(sizes_dep[gd == g].mean()) for g in range(G)],
                n_dep=[int((gd == g).sum()) for g in range(G)]),
    overall=dict(emp=float(mixD), ucb=float(ucbD), size=float(sizes_dep.mean())),
    edges=[float(x) for x in edges], conf_bin_n=conf_bin_n, conf_bin_tls=conf_bin_tls,
    hist_bins=[float(x) for x in np.linspace(0, 1, 21)],
    hist_cal=[int(x) for x in np.histogram(Sc.max(1), bins=np.linspace(0, 1, 21))[0]],
    hist_dep=[int(x) for x in np.histogram(Sd.max(1), bins=np.linspace(0, 1, 21))[0]],
    meanscore_cal=[float(x) for x in Sc.mean(0)], meanscore_dep=[float(x) for x in Sd.mean(0)],
    labels=labels)
tmpj = os.path.join(tempfile.gettempdir(), 'psplot_data.json')
json.dump(plot_data, open(tmpj, 'w'))


RENDERER = r'''
import json, sys
from PIL import Image, ImageDraw, ImageFont
D = json.load(open(sys.argv[1])); OUT = sys.argv[2]
try:
