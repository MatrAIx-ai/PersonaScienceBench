class Canvas:
    def __init__(self, w, h):
        self.img = np.full((h, w, 3), 255, np.uint8); self.w = w; self.h = h
    def px(self, x, y, c):
        if 0 <= x < self.w and 0 <= y < self.h: self.img[y, x] = c
    def hline(self, x0, x1, y, c):
        for x in range(min(x0, x1), max(x0, x1) + 1): self.px(x, y, c)
    def vline(self, x, y0, y1, c):
        for y in range(min(y0, y1), max(y0, y1) + 1): self.px(x, y, c)
    def rect(self, x0, y0, x1, y1, c):
        for y in range(min(y0, y1), max(y0, y1) + 1): self.hline(x0, x1, y, c)
    def line(self, x0, y0, x1, y1, c):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        while True:
            self.px(x0, y0, c)
            if x0 == x1 and y0 == y1: break
            e2 = 2 * err
            if e2 >= dy: err += dy; x0 += sx
            if e2 <= dx: err += dx; y0 += sy
    def text(self, x, y, s, c=BLACK, sc=1):
        cx = x
        for ch in s:
            g = _FONTC.get(ch.upper() if ch not in _FONTC else ch)
            if g is None: g = _FONTC["?"] if ch.upper() not in _FONTC else _FONTC[ch.upper()]
            for r, row in enumerate(g):
                for b in range(5):
                    if row >> (4 - b) & 1:
                        if sc == 1: self.px(cx + b, y + r, c)
                        else: self.rect(cx + b * sc, y + r * sc, cx + b * sc + sc - 1, y + r * sc + sc - 1, c)
            cx += 6 * sc
    def text_c(self, cx, y, s, c=BLACK, sc=1):
        self.text(int(cx - (len(s) * 6 - 1) * sc / 2), y, s, c, sc)
    def text_r(self, xr, y, s, c=BLACK, sc=1):
        self.text(int(xr - (len(s) * 6 - 1) * sc), y, s, c, sc)

def fmt(v):
    a = abs(v)
    if a == 0: return "0"
    if a >= 1e4 or a < 1e-3: return f"{v:.1e}".replace("e-0", "e-").replace("e+0", "e+")
    if a >= 100: return f"{v:.0f}"
    if a >= 1: return f"{v:.4g}"
    return f"{v:.4g}"

class Panel:
    def __init__(self, cv, x0, y0, x1, y1, xmin, xmax, ymin, ymax, title, xlab, ylab, logy=False):
        self.cv = cv; self.x0, self.y0, self.x1, self.y1 = x0, y0, x1, y1
        self.xmin, self.xmax, self.ymin, self.ymax = xmin, xmax, ymin, ymax
        self.logy = logy
        cv.rect(x0, y0 - 1, x0, y1, BLACK)          # left axis
        cv.rect(x0, y1, x1, y1, BLACK)              # bottom axis
        cv.text_c((x0 + x1) / 2, y0 - 14, title)    # title above
        cv.text_c((x0 + x1) / 2, y1 + 26, xlab)     # x label below ticks
        cv.text(x0 + 4, y0 - 26, ylab, GRAY)        # y label above axis
    def X(self, x):  return int(self.x0 + (x - self.xmin) / (self.xmax - self.xmin) * (self.x1 - self.x0))
    def Y(self, y):
        if self.logy: y = np.log10(max(y, 1e-12))
        return int(self.y1 - (y - self.ymin) / (self.ymax - self.ymin) * (self.y1 - self.y0))
    def xticks(self, vals):
        for v in vals:
            X = self.X(v)
            self.cv.vline(X, self.y1 + 1, self.y1 + 4, BLACK)
            self.cv.text_c(X, self.y1 + 7, fmt(v), BLACK, 1)
    def yticks(self, vals):
        for v in vals:
            Y = self.Y(v)
            self.cv.hline(self.x0 - 4, self.x0 - 1, Y, BLACK)
            self.cv.hline(self.x0 + 1, self.x1, Y, LGRAY)
            self.cv.text_r(self.x0 - 6, Y - 3, fmt(np.log10(v) if self.logy else v), BLACK, 1)
    def series(self, xs, ys, c, dw=1):
        for i in range(len(xs) - dw):
            self.cv.line(self.X(xs[i]), self.Y(ys[i]), self.X(xs[i + dw]), self.Y(ys[i + dw]), c)
    def dots(self, xs, ys, c):
        for x, y in zip(xs, ys): self.cv.px(self.X(x), self.Y(y), c)
    def bars(self, edges, heights, c):
        for (e0, e1), hgt in zip(edges, heights):
            if hgt <= 0 and not self.logy: continue
            self.cv.rect(self.X(e0), self.Y(max(hgt, 1) if self.logy else hgt),
                         max(self.X(e0) + 1, self.X(e1) - 1), self.Y(1 if self.logy else 0), c)
    def legend(self, entries, x=None, y=None):
        x = x if x is not None else self.x1 - 130; y = y if y is not None else self.y0 + 6
        for i, (label, c) in enumerate(entries):
            yy = y + i * 10
            self.cv.rect(x, yy + 1, x + 7, yy + 5, c)
            self.cv.text(x + 11, yy, label, BLACK, 1)

def save_png(path, img):
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[i].tobytes() for i in range(h))
    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))
    open(path, "wb").write(png)

