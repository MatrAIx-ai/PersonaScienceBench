chart = man["sampler_chart"]
M     = np.array(chart["matrix"], float)
SHIFT = np.array(chart["shift"], float)
WARP  = float(chart["warp_strength"])
PHASE = np.array(chart["warp_phase"], float)
SIGMA = float(man["sigma_v"])
DIM   = int(man["dimension"])
G     = np.array(man["kinetic_metric"]["inverse_mass_matrix"], float)
MASS  = np.array(man["kinetic_metric"]["mass_matrix"], float)
