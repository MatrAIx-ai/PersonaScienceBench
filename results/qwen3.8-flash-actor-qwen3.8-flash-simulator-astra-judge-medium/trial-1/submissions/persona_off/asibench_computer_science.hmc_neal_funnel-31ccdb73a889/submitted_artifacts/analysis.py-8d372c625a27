NT = sch["total_transitions"]

def replay(q0, mom, uni, eps, L):
    n, T = mom.shape[0], mom.shape[1]
    post = np.empty((n, T, DIM)); prop = np.empty((n, T, DIM))
    dH = np.empty((n, T)); ap = np.empty((n, T)); acc = np.zeros((n, T), bool)
    for c in range(n):
        q = q0[c].copy()
        for t in range(T):
            p = mom[c, t]
            qp, pp = leapfrog(q, p, eps, L)
            d = H(qp, pp) - H(q, p)
            a = 1.0 if d <= 0.0 else float(np.exp(min(-d, 0.0)))
            take = uni[c, t] < a
            post[c, t] = qp if take else q
            prop[c, t] = qp; dH[c, t] = d; ap[c, t] = a; acc[c, t] = take
            q = post[c, t]
    return post, prop, dH, ap, acc

