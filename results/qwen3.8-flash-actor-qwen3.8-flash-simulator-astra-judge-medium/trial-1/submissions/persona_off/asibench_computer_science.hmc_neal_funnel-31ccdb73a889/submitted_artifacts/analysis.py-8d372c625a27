    for li in range(len(ladder)):
        H1 = np.array([H(ps[ci, li, k], pm[ci, li, k]) for k in range(len(probe_q))])
        rmse_by_rung.append(float(np.sqrt(np.mean((H1 - H0) ** 2))))
    energy_rmse = rmse_by_rung[LADDER_BASE]
    energy_slope = float(np.polyfit(np.log(ladder), np.log(rmse_by_rung), 1)[0])
    rev = np.array([np.linalg.norm(rs[ci, LADDER_BASE, k] - probe_q[k])
                    + np.linalg.norm(rm[ci, LADDER_BASE, k] + probe_p[k])
                    for k in range(len(probe_q))])
    reverse_p95 = float(np.percentile(rev, 95))
    A, *_ = np.linalg.lstsq(vi, vo[ci], rcond=None)          # prescribed local-affine estimator
    signed_logdet = float(np.linalg.slogdet(A)[1])
    volume_logdet_abs = abs(signed_logdet)                   # RAW per spec (no baseline correction)
    acc_rate = float(pacc[ci].mean())
    v_panel = pcs[ci, :, :, 0]
    panel_mean_v = float(v_panel.mean())
    panel_var_v = float(v_panel.reshape(-1).var(ddof=VAR_DDOF))
    panel_rhat_v = split_rhat([v_panel[j] for j in range(v_panel.shape[0])])
    panel_ess_v = ess_initial_positive([v_panel[j] for j in range(v_panel.shape[0])])
    validity = (0.24 * linear_score(energy_rmse, 0.01, 0.18)
                + 0.24 * linear_score(reverse_p95, 1e-8, 5e-3)
                + 0.20 * linear_score(volume_logdet_abs, 1e-5, 0.08)
                + 0.16 * linear_score(abs(panel_var_v - SIGMA ** 2) / SIGMA ** 2, 0.08, 0.55)
                + 0.16 * linear_score(abs(0.82 - acc_rate), 0.25, 0.80))
    audit_rows.append(dict(candidate_id=c, energy_rmse=energy_rmse, energy_slope=energy_slope,
                           reverse_p95=reverse_p95, volume_logdet_abs=volume_logdet_abs,
