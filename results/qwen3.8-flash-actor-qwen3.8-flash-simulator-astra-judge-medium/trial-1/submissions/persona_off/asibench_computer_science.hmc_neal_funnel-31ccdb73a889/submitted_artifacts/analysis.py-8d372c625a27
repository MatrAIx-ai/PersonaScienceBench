# ---- public chart convention (matrix applied exactly as written) ----------
def q_to_centered(q):
    u = (q - SHIFT) @ M.T
    c = u.copy()
    c[..., 1:] = u[..., 1:] + WARP * np.sin(u[..., 0:1] + PHASE)
    return c

def centered_to_q(c):
    u = c.copy()
    u[..., 1:] = c[..., 1:] - WARP * np.sin(c[..., 0:1] + PHASE)
    return u @ np.linalg.inv(M.T) + SHIFT

def U_and_grad_q(q):
    """Public potential U and gradient dU/dq in sampler coordinates."""
    u = (q - SHIFT) @ M.T
    c = u.copy()
    c[1:] = u[1:] + WARP * np.sin(u[0] + PHASE)   # centered coords
    v = c[0]; x = c[1:]
    U = 0.5 * (v / SIGMA) ** 2 + 0.5 * (DIM - 1) * v + 0.5 * np.exp(-v) * np.sum(x * x)
    gc = np.empty(DIM)
    gc[0]  = v / SIGMA ** 2 + 0.5 * (DIM - 1) - 0.5 * np.exp(-v) * np.sum(x * x)
    gc[1:] = np.exp(-v) * x
    gu = gc.copy()
    gu[0] = gc[0] + WARP * np.sum(gc[1:] * np.cos(u[0] + PHASE))
    return U, gu @ M

def K(p): return 0.5 * p @ G @ p
def H(q, p):
    U, _ = U_and_grad_q(q); return U + K(p)

def leapfrog(q, p, eps, L):
    """Exact reversible, volume-preserving leapfrog template.
    Returns (proposal_q, terminal_momentum_pre_flip)."""
    q = q.copy(); p = p.copy()
    _, g = U_and_grad_q(q); p = p - 0.5 * eps * g
    for i in range(L):
        q = q + eps * (G @ p)
        _, g = U_and_grad_q(q)
        if i < L - 1:
            p = p - eps * g
    p = p - 0.5 * eps * g
    return q, p

def leapfrog_batch(q0s, p0s, eps, L):
    Q = np.empty_like(q0s); P = np.empty_like(p0s)
    for k in range(len(q0s)):
        Q[k], P[k] = leapfrog(q0s[k], p0s[k], eps, L)
    return Q, P

# ---- diagnostics primitives ----------------------------------------------
def split_halves(chains):
    out = []
    for ch in chains:
        n = len(ch) // 2
        out.append(np.asarray(ch[:n], float)); out.append(np.asarray(ch[n:2 * n], float))
    return out

def split_rhat(chains):
    halves = split_halves(chains)
    n = len(halves[0])
    means = np.array([h.mean() for h in halves])
    W = np.mean([h.var(ddof=1) for h in halves])
    B = n * means.var(ddof=1)
    var_plus = (n - 1) / n * W + B / n
    return float(np.sqrt(var_plus / W))

def ess_initial_positive(chains):
    """Geyer initial-positive-sequence ESS over split half-chains
    (FFT autocovariance, pairwise sums, truncate at first non-positive pair)."""
    halves = [h - h.mean() for h in split_halves(chains)]
    N = len(halves[0]); Mh = len(halves)
    acov = []
    for h in halves:
        nfft = 1 << (2 * N - 1).bit_length()
        f = np.fft.rfft(h, n=nfft)
        acov.append(np.fft.irfft(f * np.conjugate(f), n=nfft)[:N].real / N)
    acov = np.mean(np.stack(acov), axis=0)
    rho = acov / acov[0]
    tau = -1.0
    for t in range(0, N - 1, 2):
        pair = rho[t] + rho[t + 1]
        if pair <= 0:
            break
        tau += 2.0 * pair
    return float(min(Mh * N / max(tau, 1.0), Mh * N))

def linear_score(error, full, zero):
    if error <= full: return 1.0
    if error >= zero: return 0.0
    return (zero - error) / (zero - full)

