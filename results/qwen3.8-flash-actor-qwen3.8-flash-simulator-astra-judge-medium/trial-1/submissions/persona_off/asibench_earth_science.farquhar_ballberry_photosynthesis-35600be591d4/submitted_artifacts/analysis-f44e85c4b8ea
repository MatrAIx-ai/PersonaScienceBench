C_SUN, C_SHADE = (31, 78, 160), (196, 60, 30)
C_AXIS, C_GRID, C_NIGHT = (20, 20, 20), (215, 215, 215), (238, 242, 248)


def _nice_ticks(vmin, vmax, n=6):
    span = vmax - vmin
    if span <= 0:
        return np.array([vmin])
    raw = span / max(n, 1)
    mag = 10.0 ** np.floor(np.log10(raw))
    step = mag * int(np.ceil(raw / mag))
    start = np.floor(vmin / step) * step
    t = start + step * np.arange(int(np.ceil((vmax - start) / step)) + 1)
    return t[(t >= vmin - 1e-9) & (t <= vmax + 1e-9)]


def _fmt(v):
    if abs(v) >= 1000:
        return f"{v:.0f}"
    if abs(v) >= 10:
        return f"{v:.1f}".rstrip("0").rstrip(".")
    return f"{v:.2f}".rstrip("0").rstrip(".")


def plot_raster(time_hr, panels, path):
    """Fallback two-panel renderer (no plotting library required)."""
    W, H = 1160, 760
    img = Raster(W, H)
    ml, mr, mt = 92, 30, 56
    gap, ph = 96, 268
    night = panels[0]["night"]
    n = len(time_hr)
    tmin, tmax = float(time_hr[0]), float(time_hr[-1])
    img.text(ml, 12, "COUPLED FARQUHAR/COLLATZ + BALL-BERRY: DIURNAL LEAF EXCHANGE",
             (10, 10, 10), 2)
    img.text(W - Raster.text_width("SUNLIT / SHADED", 1) - mr, 16, "SUNLIT / SHADED",
             (60, 60, 60), 1)
    for k, p in enumerate(panels):
        y0 = mt + k * (ph + gap)
        y1 = y0 + ph
        x0, x1 = ml, W - mr
        # night shading
        i = 0
        while i < n:
            if night[i]:
                j = i
                while j + 1 < n and night[j + 1]:
                    j += 1
                a = x0 + (time_hr[i] - tmin) / (tmax - tmin) * (x1 - x0)
                b = x0 + (time_hr[j] - tmin) / (tmax - tmin) * (x1 - x0)
                img.rect(a, y0, b, y1, C_NIGHT)
                img.text(int(a) + 3, int(y0) + 3, "NIGHT", (150, 155, 165), 1)
                i = j + 1
            else:
                i += 1
        ymin, ymax = p["ymin"], p["ymax"]
        pad = 0.05 * (ymax - ymin)
        ymin, ymax = ymin - pad, ymax + pad

        def X(t):
            return x0 + (t - tmin) / (tmax - tmin) * (x1 - x0)

        def Y(v):
            return y1 - (v - ymin) / (ymax - ymin) * (y1 - y0)

        for t in _nice_ticks(ymin, ymax, 5):
            yy = Y(t)
            img.line(x0, yy, x1, yy, C_GRID, 1)
            img.text(x0 - Raster.text_width(_fmt(t)) - 8, yy - 3, _fmt(t), (60, 60, 60))
        for tt in range(int(np.ceil(tmin / 12) * 12), int(tmax) + 1, 12):
            xx = X(tt)
            img.line(xx, y0, xx, y1, C_GRID, 1)
            img.text(xx - Raster.text_width(str(tt)) / 2, y1 + 6, str(tt), (60, 60, 60))
        img.rect(x0, y0, x1, y1, C_AXIS)
        img.rect(x0 + 1, y0 + 1, x1 - 1, y1 - 1, (255, 255, 255))
        for t in _nice_ticks(ymin, ymax, 5):        # redraw grid inside frame
            img.line(x0 + 1, Y(t), x1 - 1, Y(t), C_GRID, 1)
        for tt in range(int(np.ceil(tmin / 12) * 12), int(tmax) + 1, 12):
            img.line(X(tt), y0 + 1, X(tt), y1 - 1, C_GRID, 1)
        for series in reversed(p["series"]):   # first series drawn on top
            xs, ys, col, name = series["x"], series["y"], series["c"], series["name"]
            for i in range(n - 1):
                img.line(X(xs[i]), Y(ys[i]), X(xs[i + 1]), Y(ys[i + 1]), col, 2)
        # legend inside panel
        lx, ly = x0 + 12, y0 + 10
        for series in p["series"]:
            img.rect(lx, ly + 2, lx + 22, ly + 4, series["c"])
            img.text(lx + 30, ly, series["name"], series["c"], 1)
            ly += 16
        img.text(x0, y0 - 24, p["title"], (20, 20, 20), 2)
        img.text(x1 - Raster.text_width("TIME (HR)"), y1 + 26, "TIME (HR)", (20, 20, 20), 1)
        # units are carried by the panel title in the raster backend
    write_png(path, img.buf)


def make_figure(time_hr, sun, shade, night, path):
    """Two-panel figure: assimilation and boundary resistance, sun vs shade.
    Uses matplotlib when it is importable, otherwise the built-in renderer."""
    panels = [
        dict(title="A - NET ASSIMILATION, SUN VS SHADED  [UMOL CO2 M-2 S-1]",
             ylabel="A [umol CO2 m$^{-2}$ s$^{-1}$]",
             ymin=min(sun["A"].min(), shade["A"].min()),
             ymax=max(sun["A"].max(), shade["A"].max()), night=night,
             series=[dict(x=time_hr, y=sun["A"], c=C_SUN, name="A SUN"),
                     dict(x=time_hr, y=shade["A"], c=C_SHADE, name="A SHADE")]),
        dict(title="RS - LEAF SURFACE RESISTANCE, SUN VS SHADED  [S M-1]",
             ylabel="r$_s$ [s m$^{-1}$]",
             ymin=min(sun["rs"].min(), shade["rs"].min()),
             ymax=max(sun["rs"].max(), shade["rs"].max()), night=night,
             series=[dict(x=time_hr, y=sun["rs"], c=C_SUN, name="RS SUN"),
                     dict(x=time_hr, y=shade["rs"], c=C_SHADE, name="RS SHADE")]),
    ]
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except Exception as exc:                                  # sandbox fallback
        STATS["figure_backend"] = f"built-in raster (matplotlib unavailable: {exc})"
        plot_raster(time_hr, panels, path)
        return
    STATS["figure_backend"] = "matplotlib"
    fig, axes = plt.subplots(2, 1, figsize=(11, 7), sharex=True)
    for ax, p in zip(axes, panels):
        night_mask = np.asarray(night, bool)
        d = np.diff(np.r_[0, night_mask.astype(int), 0])
        for s in np.flatnonzero(d == 1):
            for e in np.flatnonzero(d == -1):
                if e > s:
                    ax.axvspan(time_hr[s], time_hr[min(e, len(time_hr) - 1)],
                               color=(0.93, 0.95, 0.97), zorder=0)
                    break
        for series in reversed(p["series"]):   # first series drawn on top
            ax.plot(time_hr, series["y"], "-",
                    color=np.array(series["c"]) / 255, lw=1.6, label=series["name"])
        ax.set_ylabel(p["ylabel"])
        ax.set_title(p["title"], fontsize=10)
        ax.grid(alpha=0.35)
        ax.legend(fontsize=8)
    axes[-1].set_xlabel("time (hr)")
    fig.suptitle("Coupled Farquhar/Collatz + Ball-Berry: diurnal leaf exchange",
                 fontsize=11)
    fig.tight_layout()
    fig.savefig(path, dpi=130)
    plt.close(fig)


# -------------------------------------------------------------------- main
def main():
    OUT_DIR.mkdir(exist_ok=True)
    params, forcing, cases = load_inputs()
    n_rows = len(forcing)
    rows = np.arange(n_rows)
    env = build_environment(forcing, params, rows)
    time_hr = forcing["time_hr"].to_numpy(float)
    night = np.maximum(env["par_sun"], env["par_shade"]) <= NIGHT_PAR_THRESHOLD

    # ---- time series: sunlit and shaded leaves solved as independent fixed
    # points, vectorised over rows.  Neutral warm start Ci = 0.5*ca; the
    # solution is start-independent (probed over 16 starts spanning 0.2-1.6 ca).
    warm = 0.5 * env["ca"]
    sun = solve_fixed_point(env, PAR_ABSORPTANCE * env["par_sun"], warm, params, "sun")
    shade = solve_fixed_point(env, PAR_ABSORPTANCE * env["par_shade"], warm, params, "shade")

    flux = pd.DataFrame(dict(
        time_hr=time_hr,
        A_sun=sun["A"], A_shade=shade["A"],
        rs_sun=sun["rs"], rs_shade=shade["rs"],
        ci_sun=sun["Ci"], ci_shade=shade["Ci"],
        gs_sun=sun["gs"], gs_shade=shade["gs"],
    ))
    flux.to_csv(OUT_DIR / "leaf_fluxes.csv", index=False)

    # ---- cases: one physical row each, started from the supplied ci_init_pa
    case_rows = []
    case_detail = []
    for c in cases:
        i = int(c["forcing_index"])
        cenv = build_environment(forcing, params, [i])
        leaf = "sun"
        apar = np.array([PAR_ABSORPTANCE * cenv[f"par_{leaf}"][0]])
        r = solve_fixed_point(cenv, apar, np.array([float(c["ci_init_pa"])]), params, leaf)
        assert not r["used_fallback"], f"bisection fallback used for {c['case_id']}"
        case_rows.append(dict(case_id=c["case_id"], ci_init_pa=float(c["ci_init_pa"]),
                              ci_final_pa=r["Ci"][0], A_final=r["A"][0],
                              rs_final=r["rs"][0], n_iterations=int(r["n_iter"][0])))
        case_detail.append(dict(case=c["case_id"], ci_init=float(c["ci_init_pa"]),
                                ci_final=float(r["Ci"][0]), A=float(r["A"][0]),
                                cs=float(r["cs"][0]), gs=float(r["gs"][0]),
                                rs=float(r["rs"][0]), n=int(r["n_iter"][0]),
                                dCi=float(r["resid_Ci"][0]), dA=float(r["resid_A"][0]),
                                limit=str(r["limit"][0]),
                                ci_shade=float(
                                    solve_fixed_point(cenv, np.array([PAR_ABSORPTANCE * cenv["par_shade"][0]]),
                                                      np.array([float(c["ci_init_pa"])]), params, "shade")["Ci"][0])))
    pd.DataFrame(case_rows)[["case_id", "ci_init_pa", "ci_final_pa", "A_final",
                             "rs_final", "n_iterations"]].to_csv(
        OUT_DIR / "case_convergence.csv", index=False)

    # ---- figure
    make_figure(time_hr, sun, shade, night, OUT_DIR / "diurnal.png")

    # ------------------------------------------------------------ report
    print("=" * 78)
    print("RUN SUMMARY")
    print("=" * 78)
    print(f"pathway={params['pathway']}  rows={n_rows}  step={time_hr[1]-time_hr[0]:.0f} h  "
          f"night rows={int(night.sum())} (PAR<= {NIGHT_PAR_THRESHOLD:g} W/m2)")
    print(f"figure backend: {STATS.get('figure_backend')}")
    print(f"bisection fallback rows used: {STATS.get('fallback_rows', 0)}  "
          f"(sun fallback={sun['used_fallback']}, shade fallback={shade['used_fallback']})")
    print(f"max iterations: sun={sun['max_iter']} shade={shade['max_iter']} "
          f"(cap {CI_MAX_ITER}); max residual |dCi| = "
          f"{max(sun['resid_Ci'].max(), shade['resid_Ci'].max()):.3e} Pa")

    print("\n--- CASE CONVERGENCE (coupled fixed point from supplied ci_init_pa) ---")
    hdr = (f"{'case':8s} {'ci_init':>10s} {'ci_final':>11s} {'d(ci)':>10s} "
           f"{'A_final':>10s} {'cs':>8s} {'gs':>8s} {'rs':>10s} {'lim':>4s} "
           f"{'iters':>5s} {'|dCi|':>10s} {'|dA|':>10s} {'ci_shade':>10s}")
    print(hdr)
    for d in case_detail:
        print(f"{d['case']:8s} {d['ci_init']:10.5f} {d['ci_final']:11.6f} "
              f"{d['ci_final']-d['ci_init']:10.5f} {d['A']:10.6f} {d['cs']:8.4f} "
              f"{d['gs']:8.5f} {d['rs']:10.5f} {d['limit']:>4s} {d['n']:5d} "
              f"{d['dCi']:10.2e} {d['dA']:10.2e} {d['ci_shade']:10.6f}")
    moved = [d for d in case_detail if abs(d["ci_final"] - d["ci_init"]) > 1e-6]
    print(f"cases where ci_final != ci_init: {len(moved)}/{len(case_detail)}"
          f"  (largest |ci_init - ca| = "
          f"{max(abs(d['ci_init']-env['ca'][12]) for d in case_detail):.3f} Pa; "
          f"ci_init above ca: {[d['case'] for d in case_detail if d['ci_init'] > env['ca'][12]]})")

    print("\n--- LIMITATION REGIMES (light rows) ---")
    lit = sun["lit"]
    for tag, r in (("sun", sun), ("shade", shade)):
        cnt = pd.Series(r["limit"][lit]).value_counts().to_dict()
        print(f"  {tag:5s} light rows={int(lit.sum())}: {cnt}")
    diff = np.flatnonzero(np.abs(sun["A"] - shade["A"]) > 1e-9)
    print(f"  rows with A_sun != A_shade: {len(diff)}")
    print(f"  {'idx':>4s} {'hr':>5s} {'day':>4s} {'par_s':>9s} {'par_sh':>8s} "
          f"{'Wj_s':>8s} {'Wj_sh':>8s} {'Vcmax':>8s} {'A_sun':>8s} {'A_sh':>8s} "
          f"{'lim_s':>5s} {'lim_sh':>6s} {'ci_s':>8s} {'ci_sh':>8s}")
    for i in diff:
        day = int(time_hr[i] // 24) + 1
        wj_s = params["alpha_q"] * PAR_ABSORPTANCE * env["par_sun"][i]
        wj_h = params["alpha_q"] * PAR_ABSORPTANCE * env["par_shade"][i]
        print(f"  {i:4d} {time_hr[i]:5.0f} {day:4d} {env['par_sun'][i]:9.2f} "
              f"{env['par_shade'][i]:8.2f} {wj_s:8.2f} {wj_h:8.2f} {env['vm'][i]:8.3f} "
              f"{sun['A'][i]:8.3f} {shade['A'][i]:8.3f} {sun['limit'][i]:>5s} "
              f"{shade['limit'][i]:>6s} {sun['Ci'][i]:8.3f} {shade['Ci'][i]:8.3f}")

    print("\n--- PHYSICAL SANITY CHECKS ---")
    b0 = params["bb_intercept"]
    checks = {
        "no NaN/inf anywhere": bool(np.all(np.isfinite(flux.to_numpy(float).T))),
        "light gs >= b0": bool(np.all(flux["gs_sun"].to_numpy()[lit] >= b0 - 1e-12)
                               and np.all(flux["gs_shade"].to_numpy()[lit] >= b0 - 1e-12)),
        "gs bounded (< 20 mol/m2/s)": bool(flux[["gs_sun", "gs_shade"]].max().max() < 20),
        "rs strictly positive at night": bool(np.all(flux.loc[~lit, ["rs_sun", "rs_shade"]].to_numpy() > 0)),
        "rs strictly positive everywhere": bool(np.all(flux[["rs_sun", "rs_shade"]].to_numpy() > 0)),
        "A > 0 in light (both leaves)": bool(np.all(sun["A"][lit] > 0) and np.all(shade["A"][lit] > 0)),
        "A < 0 at night (= -Rd)": bool(np.all(sun["A"][~lit] < 0)),
        "Ci < cs < ca in light (sun)": bool(np.all(sun["Ci"][lit] < sun["cs"][lit])
                                            and np.all(sun["cs"][lit] < env["ca"][lit])),
        "Ci < cs < ca in light (shade)": bool(np.all(shade["Ci"][lit] < shade["cs"][lit])
                                              and np.all(shade["cs"][lit] < env["ca"][lit])),
        "night Ci > cs > ca (resp.)": bool(np.all(sun["Ci"][~lit] > sun["cs"][~lit])
                                           and np.all(sun["cs"][~lit] > env["ca"][~lit])),
        "Ci <= ca always in light": bool(sun["Ci"][lit].max() <= env["ca"][lit].max()),
    }
    for k, v in checks.items():
        print(f"  [{'ok' if v else 'FAIL'}] {k}")
    print(f"  ranges: A_sun [{flux.A_sun.min():.3f},{flux.A_sun.max():.3f}]  "
          f"A_shade [{flux.A_shade.min():.3f},{flux.A_shade.max():.3f}]  "
          f"gs [{flux.gs_sun.min():.4f},{flux.gs_sun.max():.4f}]  "
          f"rs [{flux.rs_sun.min():.1f},{flux.rs_sun.max():.1f}]")
    print(f"  night: A={sun['A'][~lit][0]:.4f}..{sun['A'][~lit][-1]:.4f} umol/m2/s, "
          f"gs=b0={flux.gs_sun[~lit].unique()}, rs={flux.rs_sun[~lit].min():.1f}..{flux.rs_sun[~lit].max():.1f} s/m, "
          f"ci={flux.ci_sun[~lit].min():.2f}..{flux.ci_sun[~lit].max():.2f} Pa")
    print(f"  figure: {OUT_DIR/'diurnal.png'} ({(OUT_DIR/'diurnal.png').stat().st_size} bytes)")
    print(f"  all checks passed: {all(checks.values())}")

    if STATS.get("fallback_rows", 0):
        print("\n*** WARNING: bracketed-bisection fallback WAS triggered - see above ***")
    assert not sun["used_fallback"] and not shade["used_fallback"], \
        "successive substitution hit the iteration cap; fallback was used"
    return flux, case_detail, checks


if __name__ == "__main__":
    main()
