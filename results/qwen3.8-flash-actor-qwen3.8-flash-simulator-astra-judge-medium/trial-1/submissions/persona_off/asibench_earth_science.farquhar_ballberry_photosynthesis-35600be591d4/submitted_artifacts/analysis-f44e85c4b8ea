class Raster:
    """Tiny raster canvas with lines, rects and 5x7 bitmap text."""

    def __init__(self, w, h, bg=(255, 255, 255)):
        self.buf = np.zeros((h, w, 3), np.uint8)
        self.buf[:, :] = bg
        self.h, self.w = h, w

    def px(self, x, y, c):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.w and 0 <= y < self.h:
            self.buf[y, x] = c

    def line(self, x0, y0, x1, y1, c, width=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        while True:
            for oy in range(width):
                for ox in range(width):
                    self.px(x0 + ox, y0 + oy, c)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x0 += sx
            if e2 <= dx:
                err += dx
                y0 += sy

    def rect(self, x0, y0, x1, y1, c):
        x0, x1 = sorted((int(x0), int(x1)))
        y0, y1 = sorted((int(y0), int(y1)))
        self.buf[y0:y1 + 1, x0:x1 + 1] = c

    def text(self, x, y, s, c=(0, 0, 0), scale=1):
        gx = 0
        for ch in str(s).upper():
            g = _GLYPHS.get(ch)
            if g is not None:
                for r, row in enumerate(g):
                    for i, bit in enumerate(row):
                        if bit == "#":
                            for sy in range(scale):
                                for sx in range(scale):
                                    self.px(x + (gx + i) * scale, y + (r * scale) + sy, c)
            gx += 6 * scale

    @staticmethod
    def text_width(s, scale=1):
        return len(str(s)) * 6 * scale


# ------------------------------------------------------------- physiology
def esat_clm(T_K):
    """CLM saturation vapour pressure over water [Pa] (convention C1)."""
    Tc = T_K - 273.15
    return 611.21 * np.exp(17.502 * Tc / (Tc + 240.97))


def surface_rh(T_K, vpd_Pa):
    """h_s = max(1 - vpd/esat(T), 0.25), bounded above by 1 (brief)."""
    return np.clip(1.0 - np.asarray(vpd_Pa) / esat_clm(T_K), 0.25, 1.0)


def vcmax(T_K, vcmax25, n_factor, btran):
    """CLM/Noah-MP Q10 with high-temperature inhibition, scaled by n_factor
    and btran (capacity only -- the Ball-Berry intercept stays unscaled)."""
    Tc = np.asarray(T_K) - 273.15
    q10 = Q10_VCMAX ** ((Tc - 25.0) / 10.0)
    inhib = 1.0 + np.exp((-2.2e5 + 710.0 * (Tc + 273.16)) / (R_GAS * (Tc + 273.16)))
    return np.asarray(vcmax25) * q10 / inhib * n_factor * btran


def arrhenius(x25, q10, T_K):
    return x25 * q10 ** ((np.asarray(T_K) - 273.15 - 25.0) / 10.0)


def limitations(Ci, env, APAR, params):
    """Return (Wc, Wj, We) in umol m-2 s-1 for the declared pathway."""
    Ci = np.maximum(Ci, 0.0)
    vm, p_atm = env["vm"], env["p_atm"]
    if str(params["pathway"]).upper() == "C4":
        return vm, params["alpha_q"] * APAR, 4000.0 * vm * Ci / p_atm
    J = params["alpha_q"] * APAR                      # linear J (brief)
    Gs, Kc, Ko = env["Gstar"], env["Kc"], env["Ko"]
    Wc = vm * (Ci - Gs) / (Ci + Kc * (1.0 + env["o2"] / Ko))
    Wj = J * (Ci - Gs) / (4.0 * Ci + 8.0 * Gs)
    return Wc, Wj, 0.5 * vm


def assimilate(Ci, env, APAR, params):
    """Hard-minimum colimitation minus day respiration [umol m-2 s-1]."""
    Wc, Wj, We = limitations(Ci, env, APAR, params)
    A = np.minimum(np.minimum(Wc, Wj), We) - env["rd"]
    which = np.where((Wc <= Wj) & (Wc <= We), "Wc", np.where(Wj <= We, "Wj", "We"))
    return A, which


# ------------------------------------------------- gas-exchange environment
def build_environment(forcing, params, rows):
    f = forcing.iloc[np.asarray(rows)]
    T = f["t_air_K"].to_numpy(float)            # T_leaf = T_air (brief)
    p_atm = f["p_atm_Pa"].to_numpy(float)
    btran = f["btran"].to_numpy(float)
    o2 = f["o2_pa"].to_numpy(float)
    vm = vcmax(T, params["vcmax25"], params.get("n_factor", 1.0), btran)
    Kc = arrhenius(KC25, Q10_KC, T)
    Ko = arrhenius(KO25, Q10_KO, T)
    return dict(
        T=T, p_atm=p_atm, ca=f["co2_pa"].to_numpy(float), o2=o2,
        vpd=f["vpd_Pa"].to_numpy(float), rb=f["rb_sm"].to_numpy(float),
        btran=btran, vm=vm, rd=0.015 * vm, cf=p_atm / (R_GAS * T),
        h_s=surface_rh(T, f["vpd_Pa"].to_numpy(float)),
        Kc=Kc, Ko=Ko, Gstar=0.5 * (Kc / Ko) * o2 * 0.21,
        par_sun=f["par_sun_wm2"].to_numpy(float),
        par_shade=f["par_shade_wm2"].to_numpy(float),
    )


def diffusion_map(Ci, env, APAR, lit, params):
    """One application of the coupled map g(Ci):
    biochemistry -> A -> cs -> gs -> rs -> Ci_new.

    Night rows (lit == False) use A = -Rd and gs = b0; Ci is still evaluated
    from the same diffusion chain (convention C4), which keeps it finite and
    consistent at PAR = 0 without any iteration.
    """
    m, b0 = params["bb_slope"], params["bb_intercept"]
    A_phot, which = assimilate(Ci, env, APAR, params)
    A = np.where(lit, A_phot, -env["rd"])
    which = np.where(lit, which, "Rd")

    A_mol = A * 1e-6                                   # C8: umol -> mol
    cs = env["ca"] - 1.37 * env["rb"] * A_mol / env["cf"] * env["p_atm"]
    gs_bb = m * A_mol * env["h_s"] / np.maximum(cs, 1e-9) * env["p_atm"] + b0
    gs = np.where(lit, np.maximum(gs_bb, GS_FLOOR), b0)
    rs = env["cf"] / gs
    Ci_new = np.maximum(cs - 1.65 * rs * A_mol / env["cf"] * env["p_atm"], CI_FLOOR)
    return Ci_new, A, cs, gs, rs, which


# ------------------------------------------------------------------ solver
def _bisect_fallback(Ci_start, env, APAR, lit, params):
    """Bracketed bisection on F(Ci) = Ci - g(Ci); only for rows where the
    iteration cap was reached (never expected on this dataset)."""
    STATS["fallback_rows"] = int(STATS.get("fallback_rows", 0)) + int(np.count_nonzero(lit))
    lo = np.full_like(Ci_start, CI_FLOOR)
    hi = BRACKET_HI * env["ca"]

    def F(x):
        return x - diffusion_map(x, env, APAR, lit, params)[0]

    flo, fhi = F(lo), F(hi)
    bad = (flo * fhi) > 0
    if np.any(bad):
        hi = np.where(bad, 10.0 * env["ca"], hi)
        flo, fhi = F(lo), F(hi)
    mid = 0.5 * (lo + hi)
    for _ in range(BISECT_ITER):
        fm = F(mid)
        keep_lo = (flo * fm) <= 0
        hi = np.where(keep_lo, mid, hi)
        lo = np.where(keep_lo, lo, mid)
        flo = np.where(keep_lo, flo, fm)
        fhi = np.where(keep_lo, fhi, fm)
        mid = 0.5 * (lo + hi)
    return np.where(lit, mid, Ci_start)


def solve_fixed_point(env, APAR, ci_init, params, leaf=""):
    """Undamped successive substitution on Ci, vectorised over forcing rows.

    Returns converged Ci/A/cs/gs/rs plus the truthful iteration counts and
    the final residuals.
    """
    n = env["vm"].size
    lit = (APAR / PAR_ABSORPTANCE) > NIGHT_PAR_THRESHOLD
    Ci = np.array(np.broadcast_to(np.asarray(ci_init, float), (n,)), dtype=float)
    Ci = np.where(lit, np.maximum(Ci, CI_FLOOR), Ci)

    n_iter = np.zeros(n, int)
    pending = lit.copy()
    dCi = np.full(n, np.inf)
    dA = np.full(n, np.inf)
    A_prev = None
    used_fallback = False

    for it in range(1, CI_MAX_ITER + 1):
        Ci_new, A, _, _, _, _ = diffusion_map(Ci, env, APAR, lit, params)
        step = np.abs(Ci_new - Ci)
        dA = np.full(n, np.inf) if A_prev is None else np.abs(A - A_prev)
        conv = pending & (step < CI_TOL) & (dA < CI_TOL)
        n_iter = np.where(conv & (n_iter == 0), it, n_iter)
        pending &= ~conv
        dCi, Ci, A_prev = step, Ci_new, A
        if not pending.any():
            break
    else:
        if pending.any():
            used_fallback = True
            Ci = _bisect_fallback(Ci, env, APAR, lit, params)
            n_iter = np.where(pending, it, n_iter)

    Ci_new, A, cs, gs, rs, which = diffusion_map(Ci, env, APAR, lit, params)
    return dict(
        leaf=leaf, Ci=np.where(lit, Ci, Ci_new), A=A, cs=cs, gs=gs, rs=rs,
        limit=which, lit=lit, n_iter=n_iter,
        resid_Ci=np.abs(Ci_new - Ci), resid_A=np.abs(dA),
        used_fallback=used_fallback, max_iter=n_iter.max() if n else 0,
    )


