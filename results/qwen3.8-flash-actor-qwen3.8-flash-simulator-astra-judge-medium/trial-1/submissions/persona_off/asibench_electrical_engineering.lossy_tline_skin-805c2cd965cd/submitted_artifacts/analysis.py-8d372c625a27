#!/usr/bin/env python3
"""
Transmission-Line Target Prediction  (lossy_tline_skin)
=======================================================

Route (validated by leave-one-line-out before shipping; see printed LOO table):

1. CALIBRATION EXTRACTION.  For each calibration line the transfer is modeled by
   ONE self-consistent, causal response function of the line:

       alpha_i(f) = A_i*sqrt(f) + Q_i*f                       [Np/m]
       phi_i(f)   = -2*pi*f*( tau_i*L_i + D_i )
                    - ckk * L_i * ( A_i*sqrt(f) + Q_i*f )     [rad, exp(+j*w*t)]
       mag_db_i(f) = -8.6858896 * alpha_i(f) * L_i
       H_i(f)     = 10**(mag_db/20) * exp(j*phi)

   * A_i*sqrt(f)   skin-effect conductor loss (R_ac ~ sqrt f, alpha_c = R_ac/2Z0)
   * Q_i*f         dielectric/roughness excess loss, quasi-linear in f
   * tau_i = sqrt(L'C') from the per-unit-length table (Z0 = sqrt(L'/C') = 50.82
     Ohm for every line -> the shared conductor family).
   * The phase term ckk*L_i*alpha_i(f) is the Kramers-Kronig (diffusion-like)
     partner of the sqrt(f) loss (for alpha ~ sqrt(f) the causal beta partner
     equals alpha).  ckk is a single global constant (fitted ~1.07); the same
     fitted structural parameters (A_i,Q_i) drive BOTH magnitude and phase ->
     one self-consistent H(f), never a free per-line phase spline.
   * D_i is a LENGTH-INVARIANT excess delay term (all-pass).

2. KEY ASSUMPTION (explicit, as agreed): the ~415 ps length-invariant delay D
   present in EVERY calibration line is KEPT in the reported target transfer,
   because (a) it belongs to the pipeline that produced the data, (b) it is
   all-pass (no magnitude signature), and (c) no de-embedding reference exists
   in data/.  ALTERNATIVE: a pure exp(-gamma*L) line response would OMIT the
   term -2*pi*f*D_i; consequence: every phase value shifts by +2*pi*f*D_i
   (e.g. +2.6 rad at 10 GHz, +15.7 rad at 62.5 GHz for D=410 ps), every group
   delay decreases by D_i (~0.39-0.41 ns), and every output peak time /
   peak_delay_s decreases by D_i.  Magnitude, FWHM values, energy ratio and
   tail asymmetry are unaffected.

3. GEOMETRY LAWS (per-line structural parameters -> published columns;
   structure selected by LOO cross-validation):
       A = a0 + a1*sqrt(Rdc) + a2*Rdc + a3*w_um
       Q = q0 + q1/L + q2*sqrt(Rdc)*rgh + q3*w_um
       D = d0 + d1/sqrt(L) + d2*ln(L) + d3*L
   Target parameters are predicted from these laws.  The residual phase NOT
   explained by the causal partner + all-pass delay is printed per line.

4. WAVEFORMS.  output_v = irfft( rfft(input_v) * H(f) ) on the native grids:
   frequency_grid.csv is exactly the rfft-bin grid of the 4096-sample input
   pulse (df = fs/N = 125 GHz / 4096), so no interpolation of H is needed and
   the waveform is synthesized from the *reported* H only.  H at bin 0 is real
   positive (= 1: alpha(0)=0, phi(0)=0), matching the calibration lines' ~0 dB
   DC behavior.  Input pulse is fully band-limited inside 0-62.5 GHz.

5. METRIC DEFINITIONS (verbatim):
   * FWHM: full width at half maximum of v (the signed trace; the pulse is
     positive-definite and the baseline is numerical zero) measured relative to
     the pulse's own maximum, with linear-interpolated half-maximum crossings.
   * peak_delay_s       = t_peak(output_v) - t_peak(input_v)
   * output_peak_time_s = t_peak(output_v)
   * energy_ratio       = sum(output_v^2)*dt / sum(input_v^2)*dt
   * tail_asymmetry     = [E(t>t_pk) - E(t<t_pk)] / E_total, with E = v^2*dt
     evaluated on output_v and split at the global peak sample.  In [-1,1].
   * group_delay_s = -d phase_rad / d omega computed ANALYTICALLY from the
     closed form (bin 0 uses the one-sided secant, matching the np.gradient
     convention of the calibration files); verified against -np.gradient on the
     delivered grid (max rel deviation reported, ~4e-5 << 1%).

Units SI.  Phasor convention exp(+j*omega*t): forward-traveling line has
H = exp(-gamma*L) with NEGATIVE phase and group_delay_s = -dphase/domega > 0.
"""
import numpy as np
import pandas as pd
import os

DB_NP = 20.0 / np.log(10.0)          # dB per neper
SIG_DB, SIG_PH = 0.012, 0.0015       # measured per-bin noise floors of the data

def load(data_dir="data"):
    cal = pd.read_csv(f"{data_dir}/calibration_lines.csv").set_index("line_id")
    tgt = pd.read_csv(f"{data_dir}/target_lines.csv").set_index("line_id")
    tr = pd.read_csv(f"{data_dir}/calibration_transfer.csv")
    fg = pd.read_csv(f"{data_dir}/frequency_grid.csv").frequency_hz.values
    pu = pd.read_csv(f"{data_dir}/input_pulse.csv")
    lines = {}
    for lid, g in tr.groupby("line_id"):
        r = cal.loc[lid]
        lines[lid] = dict(
            f=g.frequency_hz.values, db=g.magnitude_db.values, ph=g.phase_rad.values,
            gd=g.group_delay_s.values, Rdc=r.dc_resistance_ohm_per_m, rgh=r.roughness_index,
            C=r.capacitance_f_per_m, Lp=r.inductance_h_per_m, len=r.length_m,
            w=r.trace_width_um, G=r.conductance_s_per_m,
            tau=np.sqrt(r.inductance_h_per_m * r.capacitance_f_per_m))
    tgmeta = {}
    for lid, r in tgt.iterrows():
        tgmeta[lid] = dict(Rdc=r.dc_resistance_ohm_per_m, rgh=r.roughness_index,
                           C=r.capacitance_f_per_m, Lp=r.inductance_h_per_m,
                           len=r.length_m, w=r.trace_width_um, G=r.conductance_s_per_m,
                           tau=np.sqrt(r.inductance_h_per_m * r.capacitance_f_per_m))
    return lines, tgmeta, fg, pu

def fit_lines(lines, keys):
    """per-line (A,Q,D) + global causal-partner coefficient ckk, weighted LSQ"""
    from scipy.optimize import least_squares
    K = len(keys)
    def resid(x):
        ckk = x[0]; out = []
        for i, k in enumerate(keys):
            ln = lines[k]; A, Q = x[1 + 2 * i], x[2 + 2 * i]; D = x[1 + 2 * K + i]
            sq = np.sqrt(ln["f"][1:])
            al = A * sq + Q * ln["f"][1:]
            db_m = -al * ln["len"] * DB_NP
            ph_m = -(2 * np.pi * ln["f"][1:] * (ln["tau"] * ln["len"] + D)
                     + ckk * ln["len"] * al)
            out.append((db_m - ln["db"][1:]) / SIG_DB)
            out.append((ph_m - ln["ph"][1:]) / SIG_PH)
        return np.concatenate(out)
    x0 = [1.0] + [2.2e-6, 6e-12] * K + [4.1e-10] * K
    xs = [0.1] + [1e-7, 1e-12] * K + [3e-11] * K
    s = least_squares(resid, x0, x_scale=xs)
    P = {k: dict(A=s.x[1 + 2 * i], Q=s.x[2 + 2 * i], D=s.x[1 + 2 * K + i])
         for i, k in enumerate(keys)}
    return s.x[0], P, s

def feats(meta):
    R, h, Lm, w = meta["Rdc"], meta["rgh"], meta["len"], meta["w"]
    return dict(one=1.0, invL=1 / Lm, invsqrtL=1 / np.sqrt(Lm), sqR=np.sqrt(R),
                R=R, sqR_h=np.sqrt(R) * h, w=w, lnL=np.log(Lm), L=Lm)

LA = ["one", "sqR", "R", "w"]
LQ = ["one", "invL", "sqR_h", "w"]
LD = ["one", "invsqrtL", "lnL", "L"]

def fit_law(vals, lines, keys, names):
    X = np.array([[feats(lines[k])[n] for n in names] for k in keys])
    y = np.array([vals[k] for k in keys])
    return np.linalg.lstsq(X, y, rcond=None)[0]

def eval_law(c, meta, names):
    f = feats(meta)
    return sum(ci * f[n] for ci, n in zip(c, names))

def lawset(lines, keys):
    ckk, P, _ = fit_lines(lines, keys)
    cA = fit_law({k: P[k]["A"] for k in keys}, lines, keys, LA)
    cQ = fit_law({k: P[k]["Q"] for k in keys}, lines, keys, LQ)
    cD = fit_law({k: P[k]["D"] for k in keys}, lines, keys, LD)
    return ckk, cA, cQ, cD, P

def predict_par(laws, meta):
    ckk, cA, cQ, cD, _ = laws
    return dict(A=eval_law(cA, meta, LA), Q=eval_law(cQ, meta, LQ),
                D=eval_law(cD, meta, LD), ckk=ckk)

def make_H(par, meta, fg):
    A, Q, D, ckk = par["A"], par["Q"], par["D"], par["ckk"]
    sq = np.sqrt(fg)
    alpha = A * sq + Q * fg                                # Np/m, intrinsic per length
    db = -alpha * meta["len"] * DB_NP
    phi = -(2 * np.pi * fg * (meta["tau"] * meta["len"] + D) + ckk * meta["len"] * alpha)
    return db, phi, alpha

def group_delay(par, meta, fg):
    """analytic -dphi/domega; bin 0 uses the one-sided secant (np.gradient convention)"""
    A, Q, D, ckk = par["A"], par["Q"], par["D"], par["ckk"]
    gd = meta["tau"] * meta["len"] + D + ckk * meta["len"] * (
        A / (2 * np.sqrt(np.maximum(fg, 1e-9))) + Q) / (2 * np.pi)
    phi = make_H(par, meta, fg)[1]
    gd[0] = -(phi[1] - phi[0]) / (2 * np.pi * (fg[1] - fg[0]))
    return gd

def waveform(H, pu):
    N = len(pu)
    V = np.fft.rfft(pu["input_v"].values)
    assert len(H) == N // 2 + 1, "H must live on the exact rfft grid of the pulse"
    return np.fft.irfft(V * H, n=N)

def pulse_metrics(t, vin, vout):
    def fwhm(v):
        pk = v.max(); i = int(v.argmax()); h = pk / 2
        l = np.where(v[:i] < h)[0]
        ll = int(l[-1]) if len(l) else 0
        r = np.where(v[i:] < h)[0]
        rr = i + int(r[0]) if len(r) else len(v) - 1
        tl = t[ll] + (h - v[ll]) / (v[ll + 1] - v[ll]) * (t[ll + 1] - t[ll])
        tr_ = t[rr - 1] + (v[rr - 1] - h) / (v[rr - 1] - v[rr]) * (t[rr] - t[rr - 1])
        return tr_ - tl, t[i], i
    fi, tpk_in, _ = fwhm(vin)
    fo, tpk_out, ipk = fwhm(vout)
    Eo = np.sum(vout ** 2); Ei = np.sum(vin ** 2)
    Eafter = np.sum(vout[ipk:] ** 2); Ebefore = np.sum(vout[:ipk] ** 2)
    return dict(in_fwhm=fi, out_fwhm=fo, ratio=fo / fi,
                peak_delay=tpk_out - tpk_in, peak_time=tpk_out,
                energy=Eo / Ei, tail=(Eafter - Ebefore) / (Eafter + Ebefore))

def main():
    lines, tgmeta, fg, pu = load("data")
    keys = list(lines)
    t = pu.time_s.values

    ckk, P, s = fit_lines(lines, keys)
    r = s.fun.reshape(len(keys), 2, -1)
    print("=" * 104)
    print("Calibration structure fit  |  ckk (causal alpha->beta partner coeff) = %.4f" % ckk)
    print("per-line residual of the self-consistent model (phase/magnitude NOT explained by")
    print("fitted loss shape + causal partner + all-pass delay D):")
    for i, k in enumerate(keys):
        dbr, phr = r[i, 0] * SIG_DB, r[i, 1] * SIG_PH
        print("  %s  A=%.4e  Q=%.3e  D=%.1f ps | resid: db rms %.4f max %.4f dB | "
              "phase rms %.5f max %.5f rad" %
              (k, P[k]["A"], P[k]["Q"], P[k]["D"] * 1e12, dbr.std(), np.abs(dbr).max(),
               phr.std(), np.abs(phr).max()))

    laws = lawset(lines, keys)
    cA, cQ, cD = laws[1], laws[2], laws[3]
    print("\nGeometry laws (LOO-selected):")
    print("  A = %+.4e %+.4e*sqrt(Rdc) %+.4e*Rdc %+.4e*w_um          [Np/(m sqrt Hz)]" % tuple(cA))
    print("  Q = %+.4e %+.4e/L %+.4e*sqrt(Rdc)*rgh %+.4e*w_um        [Np/(m Hz)]" % tuple(cQ))
    print("  D = %+.4e %+.4e/sqrt(L) %+.4e*ln(L) %+.4e*L             [s]" % tuple(cD))

    print("\n" + "=" * 104)
    print("Leave-one-line-out validation (structure + laws refit on 7 lines, 8th predicted)")
    print("fold  | dbRMS(in 0-40G) dbRMS(full) dbMAX | phRMS(in) phRMS(full) phMAX |"
          " gdRMS gdBIAS ps | pkErr fwhmErr")
    loo_rows = []
    for loo in keys:
        laws_ = lawset(lines, [k for k in keys if k != loo])
        ln = lines[loo]
        pp = predict_par(laws_, ln)
        db, phi, _ = make_H(pp, ln, fg)
        gd = group_delay(pp, ln, fg)
        m_in = fg <= 40e9
        edb, eph, egd = db - ln["db"], phi - ln["ph"], gd - ln["gd"]
        mo = pulse_metrics(t, pu.input_v.values, waveform(10 ** (db / 20) * np.exp(1j * phi), pu))
        mt = pulse_metrics(t, pu.input_v.values,
                           waveform(10 ** (ln["db"] / 20) * np.exp(1j * ln["ph"]), pu))
        row = dict(fold=loo, db_rms_in=np.sqrt(np.mean(edb[m_in] ** 2)),
                   db_rms_full=np.sqrt(np.mean(edb ** 2)), db_max=np.abs(edb).max(),
                   ph_rms_in=np.sqrt(np.mean(eph[m_in] ** 2)),
                   ph_rms_full=np.sqrt(np.mean(eph ** 2)), ph_max=np.abs(eph).max(),
                   gd_rms=np.sqrt(np.mean(egd[m_in] ** 2)) * 1e12,
                   gd_bias=np.mean(egd[m_in]) * 1e12,
                   pk_err=(mo["peak_delay"] - mt["peak_delay"]) * 1e12,
                   fwhm_err=100 * (mo["ratio"] - mt["ratio"]) / mt["ratio"])
        loo_rows.append(row)
        print(" %-5s |      %.3f        %.3f     %.3f |   %.3f      %.3f    %.3f | "
              "%5.1f %+5.1f   | %+6.1f  %+5.2f%%" %
              (loo, row["db_rms_in"], row["db_rms_full"], row["db_max"], row["ph_rms_in"],
               row["ph_rms_full"], row["ph_max"], row["gd_rms"], row["gd_bias"],
               row["pk_err"], row["fwhm_err"]))
    print("median dbRMS(in)=%.3f  phRMS(in)=%.3f | worst dbRMS(in)=%.3f  phRMS(in)=%.3f" %
          (np.median([x["db_rms_in"] for x in loo_rows]),
           np.median([x["ph_rms_in"] for x in loo_rows]),
           max(x["db_rms_in"] for x in loo_rows),
           max(x["ph_rms_in"] for x in loo_rows)))

    tr_rows, wf_rows, pm_rows = [], [], []
    print("\n" + "=" * 104)
    print("Target predictions.  LOO uncertainty: interior-geometry folds give |H| rms <=0.13 dB,")
    print("phase rms <=0.35 rad, delay bias <=2.3 ps; edge-case folds (cal_0 shortest,")
    print("cal_6 widest+longest) reach 0.26 dB / 1.46 rad -> quoted as tail-risk uncertainty.")
    for k, meta in tgmeta.items():
        pp = predict_par(laws, meta)
        db, phi, alpha = make_H(pp, meta, fg)
        gd = group_delay(pp, meta, fg)
        assert phi[0] == 0.0 and db[0] == 0.0, "phi(0)=0 and |H(0)|=1 required"
        H = 10 ** (db / 20) * np.exp(1j * phi)          # waveform from REPORTED H only
        assert H[0].imag == 0.0 and H[0].real > 0.0
        out = waveform(H, pu)
        mets = pulse_metrics(t, pu.input_v.values, out)
        assert mets["peak_time"] <= t[-1] - 2e-9, "output peak too close to window edge"
        edge_frac = np.sum(out[t > t[-1] - 2e-9] ** 2) / np.sum(out ** 2)
        assert edge_frac < 1e-4, "significant pulse energy at window edge (wraparound risk)"
        gd_grad = -np.gradient(phi, 2 * np.pi * fg)
        m = fg >= 1e8
        gd_dev = np.max(np.abs(gd[1:][m[1:]] - gd_grad[1:][m[1:]]) / np.abs(gd_grad[1:][m[1:]]))
        print(" %s: A=%.4e Q=%.3e D=%.1f ps | FWHM %.4f->%.4f ns (x%.4f) | peak @ %.4f ns "
              "(delay %.4f) | energy %.5f | tail %+.4f | gd-vs-grad dev %.1e | edgeE %.1e" %
              (k, pp["A"], pp["Q"], pp["D"] * 1e12, mets["in_fwhm"] * 1e9,
               mets["out_fwhm"] * 1e9, mets["ratio"], mets["peak_time"] * 1e9,
               mets["peak_delay"] * 1e9, mets["energy"], mets["tail"], gd_dev, edge_frac))
        for j, f in enumerate(fg):
            tr_rows.append((k, f, db[j], phi[j], gd[j], alpha[j]))
        for j in range(len(t)):
            wf_rows.append((k, t[j], pu.input_v.values[j], out[j]))
        pm_rows.append((k, mets["in_fwhm"], mets["out_fwhm"], mets["ratio"],
                        mets["peak_delay"], mets["peak_time"], mets["energy"], mets["tail"]))

    os.makedirs("results", exist_ok=True)
    pd.DataFrame(tr_rows, columns=["target_id", "frequency_hz", "magnitude_db", "phase_rad",
                                   "group_delay_s", "attenuation_np_per_m"]
                 ).to_csv("results/target_transfer.csv", index=False)
    pd.DataFrame(wf_rows, columns=["target_id", "time_s", "input_v", "output_v"]
                 ).to_csv("results/target_waveforms.csv", index=False)
    pd.DataFrame(pm_rows, columns=["target_id", "input_fwhm_s", "output_fwhm_s",
                                   "fwhm_broadening_ratio", "peak_delay_s",
                                   "output_peak_time_s", "energy_ratio", "tail_asymmetry"]
                 ).to_csv("results/pulse_metrics.csv", index=False)

    chk_t = pd.read_csv("results/target_transfer.csv")
    chk_w = pd.read_csv("results/target_waveforms.csv")
    chk_p = pd.read_csv("results/pulse_metrics.csv")
    assert list(chk_t.columns) == ["target_id", "frequency_hz", "magnitude_db", "phase_rad",
                                   "group_delay_s", "attenuation_np_per_m"]
    assert list(chk_w.columns) == ["target_id", "time_s", "input_v", "output_v"]
    assert list(chk_p.columns) == ["target_id", "input_fwhm_s", "output_fwhm_s",
                                   "fwhm_broadening_ratio", "peak_delay_s",
                                   "output_peak_time_s", "energy_ratio", "tail_asymmetry"]
    ids = sorted(tgmeta)
    assert sorted(chk_t.target_id.unique()) == ids
    assert sorted(chk_w.target_id.unique()) == ids
    assert sorted(chk_p.target_id.unique()) == ids
    for k in ids:
        assert (chk_t.target_id == k).sum() == len(fg)
        assert (chk_w.target_id == k).sum() == len(t)
        assert np.allclose(chk_t[chk_t.target_id == k].frequency_hz.values, fg)
        assert np.allclose(chk_w[chk_w.target_id == k].time_s.values, t)
        ph = chk_t[chk_t.target_id == k].phase_rad.values
        assert np.all(np.diff(ph) <= 1e-12), "phase must be monotone (unwrapped) non-increasing"
        assert np.isfinite(chk_t[chk_t.target_id == k].group_delay_s).all()
        assert np.isfinite(chk_w[chk_w.target_id == k].output_v).all()
        assert chk_p.loc[chk_p.target_id == k, "fwhm_broadening_ratio"].iloc[0] >= 1.0
    print("\nWrote results/{target_transfer,target_waveforms,pulse_metrics}.csv;"
          " all re-read assertions passed.")

if __name__ == "__main__":
    main()
