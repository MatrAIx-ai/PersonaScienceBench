"""Scaling probe: what degrades first as U grows well past the visible 2e6?

Two cost drivers are measured separately:
  * ordinary instances  -> prime table to sqrt(U) + DFS nodes        ~ O(sqrt U)
  * degenerate all-primes instances (a == b, c == a) -> sieve to U and
    Theta(U / log U) emitted solutions, i.e. output-bound.
"""
import math, os, resource, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)
from analysis import solve

def rss_mb():
    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0

print(f"python {sys.version.split()[0]}  RSS start {rss_mb():.0f} MB\n")
print("ordinary instances (a*S != b*m regime; prime table only to sqrt(U)):")
print(f"{'U':>12s} {'sqrt(U)':>8s} | {'(2,5,-28)':>22s} | {'(3,8,192)':>22s} | {'(6,7,77)':>22s} | RSS")
for U in (2_000_000, 10_000_000, 50_000_000, 200_000_000, 1_000_000_000):
    row = []
    for (a, b, c) in [(2, 5, -28), (3, 8, 192), (6, 7, 77)]:
        t0 = time.perf_counter(); s = solve(a, b, c, U); dt = time.perf_counter() - t0
        row.append(f"{len(s):5d} sols {dt*1000:8.1f} ms")
    print(f"{U:12d} {math.isqrt(U):8d} | " + " | ".join(f"{r:>22s}" for r in row)
          + f" | {rss_mb():.0f} MB")

print("\ndegenerate all-primes instances (a == b, c == a): sieve to U, output size ~U/log U")
print(f"{'U':>12s} {'sols':>10s} {'expected pi(U)~U/lnU':>22s} {'solve ms':>12s} {'RSS MB':>8s}")
for U in (2_000_000, 10_000_000, 40_000_000):
    t0 = time.perf_counter(); s = solve(4, 4, 4, U); dt = time.perf_counter() - t0
    print(f"{U:12d} {len(s):10d} {U/math.log(U):22.0f} {dt*1000:12.1f} {rss_mb():8.0f}")

print("\nlarge-prime-factor instances at growing U (solution n = 2*701*1423 pattern):")
for U in (2_000_000, 20_000_000, 100_000_000):
    t0 = time.perf_counter(); s = solve(2, 3, 12750, U); dt = time.perf_counter() - t0
    print(f"  U={U:11d}: {len(s):5d} sols {dt*1000:8.1f} ms  (contains 1995046: {1995046 in s})")
