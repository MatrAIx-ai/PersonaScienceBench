#!/usr/bin/env python3
"""
BixBench bix-10-q3 : In which patient-volume group (patients_seen band) do healthcare
workers show statistically significant differences (p<0.05) in COVID-19 severity
between BCG and placebo, based on chi-square analysis?

============================================================================
PRE-REGISTERED SPECIFICATION -- written BEFORE any test was executed.
Nothing below this block may be re-designated after seeing p-values.
----------------------------------------------------------------------------
DATA SOURCE OF TRUTH : the CSVs (the DM .xlsx corrupts Age band '10-19' into a
date in 6 rows). Encodings: DM/AE utf-8, EX latin-1 (EX is never used for the
outcome -- verified to hold only 5 injection-administration QC questions).

PLACEHOLDER ROWS : 143 AE rows populated only in STUDYID/TRTGRP/USUBJID are
dropped before any counting ("no AE recorded") -> 857 subjects with >=1 real
AE record.

UNIT OF ANALYSIS : subject (DM = 1 row per USUBJID; VISITNAM is a single
screening visit, so there are no repeated measures to de-duplicate). AE is one
row per adverse-event record per subject, so AE is collapsed to subject level.

CASE ASCERTAINMENT : a subject is a COVID-19 case if any AE record has AEPT
matching regex COVID|SARS-CoV-2 (case-insensitive). There is no lab field in
the capsule; this text match is the only available case definition.

PRIMARY OUTCOME (locked; binary; subject level; COVID-restricted):
  severe = 1 if the subject has >=1 COVID AE record with
           AESEV >= 3 OR AESER == 'Yes' OR AEOUT in {'Worse','Fatal'}
           OR AEDEATH non-null
  Population = the subjects who are COVID cases (analysis of *COVID-19
  severity*, not all-cause AE severity).
  NOTE: this composite is BROADER than the "max AESEV >= 3" feasibility counts
  reported during inspection; the primary tables are re-derived under the
  locked composite rule (see "Components of the composite rule" output).

STRATA : patients_seen bands as reported -- '1-50', '51-100', '>100'. No
collapsing; zero missing values in DM.

TEST HIERARCHY : Pearson chi-square (as asked) is the headline statistic, but
Yates-corrected chi-square AND Fisher exact are ALWAYS reported whenever any
expected cell < 5, and the p actually being answered with is printed
explicitly. Two-sided throughout.

SENSITIVITY GRID, FIXED PRINT ORDER (never reordered by p-value):
  (a) primary composite binary                  2x2 per band
  (b) max-AESEV ordinal collapsed {1,2,3-4}     r x c per band (COVID cases)
  (c) all-AE subject-level severe (max AESEV>=3), all 1000 subjects, 2x2
  (d) record-level AESEV(1,2,3,4) x TRTGRP over COVID AE records, r x c
  Sensitivity-only labelling of the primary:
      S-excl : COVID cases with no non-missing AESEV excluded
      S-imp  : those same subjects imputed AS SEVERE

MULTIPLICITY : 3 bands. Report uncorrected p (the question's threshold) AND
Bonferroni x3. Any result surviving only uncorrected testing is flagged.

COVARIATES : descriptive age-band / sex balance check only (cell counts are far
too small for a stable logistic regression).
============================================================================
"""
import re
import numpy as np
import pandas as pd
from scipy import stats

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)

DM_CSV = "data/TASK008_BCG-CORONA_DM.csv"
AE_CSV = "data/TASK008_BCG-CORONA_AE.csv"
EX_CSV = "data/TASK008_BCG-CORONA_EX.csv"

BANDS = ["1-50", "51-100", ">100"]      # fixed stratum order
ARMS = ["BCG", "Placebo"]               # fixed arm order
COVID_RE = re.compile(r"COVID|SARS-CoV-2", re.I)
BAD_OUT = {"Worse", "Fatal"}


def hr(t):
    print("\n" + "=" * 78 + "\n" + t + "\n" + "=" * 78)


# ---------------------------------------------------------------- load / prep
def load():
    dm = pd.read_csv(DM_CSV, encoding="utf-8")
    ae = pd.read_csv(AE_CSV, encoding="utf-8")
    ex = pd.read_csv(EX_CSV, encoding="latin-1")   # latin-1 required ('Calmette-Guérin')

    dm = dm.drop_duplicates(subset="USUBJID", keep="first")
    assert len(dm) == dm.USUBJID.nunique() == 1000, "DM is not one row per subject"
    print(f"DM: {len(dm)} rows / {dm.USUBJID.nunique()} unique USUBJID "
          f"(VISITNAM levels: {sorted(dm.VISITNAM.unique())})")

    n_before = len(ae)
    placeholder = ae[["AEPT", "AECAT", "AESEV", "AEOUT"]].isna().all(axis=1)
    ph_subj = set(ae.loc[placeholder, "USUBJID"])
    ae = ae[~placeholder].copy()
    print(f"AE: {n_before} rows -> dropped {int(placeholder.sum())} placeholder rows "
          f"({len(ph_subj)} subjects with NO AE record) -> {len(ae)} real AE records "
          f"covering {ae.USUBJID.nunique()} subjects")

    # label hygiene (documented; NOT used in the outcome definition)
    ae["AEOUT_clean"] = ae["AEOUT"].replace({"Resolved_": "Resolved"})
    ae["AEREL_clean"] = ae["AEREL"].replace({"Unrrelated": "Unrelated"})

    # EX is loaded only to document that it carries no outcome data
    print(f"EX (latin-1): {ex.shape}, EXTEST levels = {ex.EXTEST.nunique()} "
          f"injection-QC questions, EXORRES values = {sorted(ex.EXORRES.unique())} "
          f"-> no lab/outcome data, not used")

    for nm, df in (("AE", ae), ("EX", ex)):
        chk = dm[["USUBJID", "TRTGRP"]].merge(
            df[["USUBJID", "TRTGRP"]].drop_duplicates(), on="USUBJID",
            suffixes=("_dm", "_x"))
        bad = int((chk["TRTGRP_dm"] != chk["TRTGRP_x"]).sum())
        print(f"TRTGRP consistency DM vs {nm}: {bad} mismatches")
        assert bad == 0
    return dm, ae, ex, ph_subj


def build(dm, ae):
    base = dm[["USUBJID", "TRTGRP", "patients_seen", "Age", "SEX", "work_hours"]].rename(
        columns={"patients_seen": "band"})

    ae["is_covid"] = ae["AEPT"].astype(str).str.contains(COVID_RE, na=False)
    ae["sev_rec"] = (
        (ae["AESEV"] >= 3)
        | (ae["AESER"].eq("Yes"))
        | (ae["AEOUT"].isin(BAD_OUT))
        | (ae["AEDEATH"].notna())
    ) & ae["is_covid"]

    dom = ae.drop(columns=["TRTGRP", "STUDYID"])   # arm taken from DM
    cov_rec = dom[dom["is_covid"]].merge(base, on="USUBJID", how="left")
    cov = (cov_rec.groupby(["USUBJID", "TRTGRP", "band", "Age", "SEX"], dropna=False)
           .agg(n_covid_ae=("AEPT", "size"),
                max_aesev=("AESEV", "max"),
                composite_severe=("sev_rec", "any"),
                any_aesev=("AESEV", lambda s: s.notna().any()),
                serious=("AESER", lambda s: (s == "Yes").any()),
                fatal=("AEOUT", lambda s: (s == "Fatal").any()))
           .reset_index())

    allae = dom.merge(base, on="USUBJID", how="left")
    subj_all = (allae.groupby(["USUBJID", "TRTGRP", "band"], dropna=False)
                .agg(max_aesev_any=("AESEV", "max")).reset_index())
    subj_all = base.merge(subj_all, on=["USUBJID", "TRTGRP", "band"], how="left")
    subj_all["max_aesev_any"] = subj_all["max_aesev_any"].astype("Float64")
    return base, cov_rec, cov, subj_all


# ------------------------------------------------------------------ testing
def test_table(tab, label):
    """tab: rows = outcome levels (severe first / ordinal order), cols = BCG, Placebo."""
    tab = tab.reindex(columns=ARMS).fillna(0).astype(int)
    chi2, p, dof, e = stats.chi2_contingency(tab.values, correction=False)
    chi2y, py, _, _ = stats.chi2_contingency(tab.values, correction=True)
    minexp = float(np.min(e))
    sparse = minexp < 5
    fisher_p = fisher_odds = float("nan")
    if tab.shape == (2, 2):
        fisher_odds, fisher_p = stats.fisher_exact(tab.values)
    if (not sparse) or np.isnan(fisher_p):
        p_ans, m_ans = p, "Pearson chi-square"
    else:
        p_ans, m_ans = fisher_p, "Fisher exact (sparse cells)"

    print(f"\n  -- {label}")
    print(tab.to_string())
    print(f"     total n = {int(tab.values.sum())}, dof = {dof}, "
          f"min expected count = {minexp:.2f}{'  [<5 -> SPARSE CELLS]' if sparse else ''}")
    print(f"     Pearson chi2 = {chi2:.4f}   p = {p:.4f}")
    print(f"     Yates   chi2 = {chi2y:.4f}   p = {py:.4f}")
    print("     Fisher exact two-sided p = "
          + (f"{fisher_p:.4f}  (OR = {fisher_odds:.3f})" if not np.isnan(fisher_p) else "n/a (r x c)"))
    if tab.shape == (2, 2):
        top = tab.index[0]
        a, b = int(tab.loc[top, "BCG"]), int(tab.loc[top, "Placebo"])
        n1, n2 = int(tab["BCG"].sum()), int(tab["Placebo"].sum())
        print(f"     risk in row '{top}':  BCG {a}/{n1} = {a/n1*100:.1f}%   vs   "
              f"Placebo {b}/{n2} = {b/n2*100:.1f}%")
    print(f"     ==> ANSWERING WITH: {m_ans}  (p = {p_ans:.4f})")
    return dict(label=label, n=int(tab.values.sum()), chi2=chi2, p_pearson=p,
                chi2y=chi2y, p_yates=py, p_fisher=fisher_p, odds=fisher_odds,
                min_exp=minexp, sparse=sparse, p_answer=p_ans, p_method=m_ans, tab=tab)


def bonf(rows):
    print("\n  MULTIPLICITY (3 bands, Bonferroni x3):")
    for r in rows:
        pa, pb = r["p_answer"], min(1.0, r["p_answer"] * 3)
        flag = ""
        if r["p_pearson"] < 0.05 <= r["p_answer"]:
            flag += "  <-- significant ONLY on uncorrected Pearson, not by the stated method"
        if pa < 0.05 <= pb:
            flag += "  <-- significant ONLY uncorrected, NOT after Bonferroni"
        print(f"    {r['label']:<46} p(uncorr) = {pa:.4f}   p(Bonf x3) = {pb:.4f}{flag}")


def grid(rows, title):
    print(f"\n  SUMMARY -- {title}")
    for r in rows:
        fp = "   n/a" if np.isnan(r["p_fisher"]) else f"{r['p_fisher']:.4f}"
        print(f"    {r['label']:<46} n={r['n']:>4}  p_pearson={r['p_pearson']:.4f}  "
              f"p_yates={r['p_yates']:.4f}  p_fisher={fp}  ->  answer p={r['p_answer']:.4f} "
              f"[{r['p_method']}]")


def band_loop(frame, outcome_fn, title, levels=None):
    hr(title)
    rows = []
    for band in BANDS:
        d = frame[frame["band"] == band].copy()
        d["out"] = outcome_fn(d)
        d = d[d["out"].notna()]
        tab = (pd.crosstab(d["out"], d["TRTGRP"])
               .reindex(index=levels if levels else [True, False],
                        columns=ARMS, fill_value=0))
        rows.append(test_table(tab, f"patients_seen = '{band}'  (n={len(d)})"))
    bonf(rows)
    return rows


def aesev_ord(v):
    v = pd.to_numeric(v, errors="coerce")
    return pd.Series(np.select([v >= 3, v == 2, v == 1], ["3-4", "2", "1"], default=None),
                     index=v.index)


# ------------------------------------------------------------------- driver
main_state = {}


def main():
    dm, ae, ex, ph_subj = load()
    base, cov_rec, cov, subj_all = build(dm, ae)

    hr("DESCRIPTIVE -- population, strata, outcome components")
    print("All 1000 DM randomised subjects, band x arm:")
    print(base.groupby(["band", "TRTGRP"], observed=True).size().unstack(fill_value=0)
          .reindex(index=BANDS, columns=ARMS, fill_value=0))
    print(f"\nCOVID-19 cases (>=1 AE record matching /{COVID_RE.pattern}/): "
          f"{len(cov)} subjects, {len(cov_rec)} COVID AE records")
    print(cov.groupby(["band", "TRTGRP"], observed=True).size().unstack(fill_value=0)
          .reindex(index=BANDS, columns=ARMS, fill_value=0))
    print("\nCOVID AE terms counted as cases:")
    print(cov_rec["AEPT"].value_counts().to_string())
    print("\nRE-DERIVATION OF THE LOCKED COMPOSITE RULE (differs from the "
          "max-AESEV>=3 feasibility counts):")
    rec = cov_rec.assign(aesev3=cov_rec["AESEV"] >= 3,
                         ser=cov_rec["AESER"].eq("Yes"),
                         out_bad=cov_rec["AEOUT"].isin(BAD_OUT),
                         dth=cov_rec["AEDEATH"].notna())
    print("  COVID AE records triggering each component: "
          f"AESEV>=3 {int(rec.aesev3.sum())}, AESER=Yes {int(rec.ser.sum())}, "
          f"AEOUT in (Worse,Fatal) {int(rec.out_bad.sum())}, AEDEATH non-null {int(rec.dth.sum())}")
    print("  records composite-severe:", int(rec.sev_rec.sum()),
          "| records with AESEV>=3 only:", int(rec.aesev3.sum()),
          "| extra subjects added by the composite:",
          int((cov.composite_severe & ~(cov.max_aesev >= 3).fillna(False)).sum()))
    print("\nComposite-severe COVID cases, band x arm:")
    print(cov.groupby(["band", "composite_severe", "TRTGRP"]).size()
          .unstack(["composite_severe", "TRTGRP"], fill_value=0))
    print(f"\nCOVID cases with no non-missing AESEV anywhere: {int((~cov.any_aesev).sum())}"
          f"  (handled in S-excl / S-imp sensitivity only)")

    # (a) PRIMARY
    a = band_loop(cov, lambda d: d["composite_severe"],
                  "(a) PRIMARY -- subject-level COVID-restricted composite severe vs non-severe")
    grid(a, "variant (a) PRIMARY")

    # (b) ordinal
    b = band_loop(cov, lambda d: aesev_ord(d["max_aesev"]),
                  "(b) SENSITIVITY -- max AESEV ordinal {1,2,3-4}, COVID cases (r x c)",
                  levels=["1", "2", "3-4"])
    grid(b, "variant (b) ordinal")

    # (c) all-AE
    c = band_loop(subj_all, lambda d: (d["max_aesev_any"] >= 3).astype("boolean").astype(object),
                  "(c) SENSITIVITY -- all-AE subject-level severe (max AESEV>=3), "
                  "subjects with >=1 graded AE (max AESEV missing -> not classifiable, dropped)")
    grid(c, "variant (c) all-AE")

    c2 = band_loop(subj_all, lambda d: (d["max_aesev_any"] >= 3).fillna(False),
                   "(c-full) SENSITIVITY -- same as (c) but the 209 subjects with no graded AE "
                   "(143 with no AE record + 66 with only ungraded e.g. ISR AEs) counted as NON-severe, "
                   "so all 1000 randomised subjects are in the denominator")
    grid(c2, "variant (c-full) all-AE, all 1000 subjects")

    # (d) record level
    hr("(d) SENSITIVITY -- record-level AESEV(1,2,3,4) x TRTGRP, COVID AE records (r x c)")
    drows = []
    dr = cov_rec[cov_rec["AESEV"].notna()]
    for band in BANDS:
        dd = dr[dr["band"] == band]
        tab = pd.crosstab(dd["AESEV"].map(lambda v: str(int(v))), dd["TRTGRP"]) \
                .reindex(index=["1", "2", "3", "4"], columns=ARMS, fill_value=0)
        drows.append(test_table(tab, f"patients_seen = '{band}'  (records n={len(dd)})"))
    bonf(drows)
    grid(drows, "variant (d) record-level")

    # severity-missing handling on the primary (labelled sensitivity only)
    hr("SENSITIVITY ONLY -- COVID cases with no non-missing AESEV")
    sev_excl = cov[cov["any_aesev"]].copy()
    sev_imp = cov.copy()
    sev_imp["composite_severe"] = sev_imp["composite_severe"] | (~sev_imp["any_aesev"])
    e = band_loop(sev_excl, lambda d: d["composite_severe"],
                  "S-excl -- primary with severity-missing COVID cases EXCLUDED")
    grid(e, "S-excl")
    i = band_loop(sev_imp, lambda d: d["composite_severe"],
                  "S-imp -- primary with severity-missing COVID cases IMPUTED AS SEVERE")
    grid(i, "S-imp")

    global posthoc_state, main_state
    posthoc_state = (base, ae, cov_rec)
    main_state["a"] = a
    main_state["c2"] = c2
    hr("COVARIATE BALANCE (descriptive only; CSV Age bands, not the xlsx)")
    for band in BANDS:
        d = cov[cov["band"] == band]
        print(f"\nband '{band}' -- COVID cases, Age band x arm:")
        print(pd.crosstab(d["Age"], d["TRTGRP"]).reindex(columns=ARMS, fill_value=0).to_string())
        print(f"band '{band}' -- SEX x arm (1=M, 2=F):")
        print(pd.crosstab(d["SEX"], d["TRTGRP"]).reindex(columns=ARMS, fill_value=0).to_string())

    hr("FINAL -- bands reaching p<0.05")
    sig = [r for r in a if r["p_answer"] < 0.05]
    print("PRIMARY definition:")
    if not sig:
        print("  NONE of the three bands reaches p<0.05 under the locked primary rule:")
        for r in a:
            print(f"    {r['label']}: p = {r['p_answer']:.4f} via {r['p_method']} "
                  f"(min expected {r['min_exp']:.2f})")
    else:
        for r in sig:
            t = r["tab"]
            print(f"  SIGNIFICANT: {r['label']}  p = {r['p_answer']:.4f} via {r['p_method']}")
            print(t.to_string())
    print("\nAny p<0.05 anywhere in the pre-declared grid (each is a DIFFERENT definition):")
    found = False
    for tag, rows in (("(a) primary", a), ("(b) ordinal", b), ("(c) all-AE", c),
                      ("(c-full) all-AE/1000", c2),
                      ("(d) record-level", drows), ("S-excl", e), ("S-imp", i)):
        for r in rows:
            if r["p_answer"] < 0.05:
                found = True
                print(f"  [{tag}] {r['label']}  p = {r['p_answer']:.4f} via {r['p_method']}")
                print(r["tab"].to_string())
    if not found:
        print("  none in any variant.")
    return a




def conclusion(a, c2, hit_df):
    hr("CONCLUSION (single named answer to the question)")
    r150 = [r for r in a if "'1-50'" in r["label"]][0]
    print("PRIMARY (locked) definition -- subject-level COVID-19-restricted composite severe")
    for r in a:
        t = r["tab"]
        a_, b_ = int(t.loc[True, "BCG"]), int(t.loc[True, "Placebo"])
        n1, n2 = int(t["BCG"].sum()), int(t["Placebo"].sum())
        print(f"  band {r['label']:<26} severe BCG {a_}/{n1} vs Placebo {b_}/{n2}"
              f"  ->  p = {r['p_answer']:.4f} ({r['p_method']}), Bonferroni x3 = {min(1,r['p_answer']*3):.4f}")
    print("\n  => No patients_seen band reaches p<0.05 under the pre-registered primary")
    print("     definition. The largest signal is in the LOWEST-volume band (1-50), where")
    print(f"     BCG is numerically WORSE ({int(r150['tab'].loc[True,'BCG'])}/{int(r150['tab']['BCG'].sum())} = "
          f"{r150['tab'].loc[True,'BCG']/r150['tab']['BCG'].sum()*100:.1f}% vs "
          f"{r150['tab'].loc[True,'Placebo']/r150['tab']['Placebo'].sum()*100:.1f}%, OR = {r150['odds']:.2f}), "
          "but p = "
          f"{r150['p_answer']:.4f} is not significant.")
    print("  => 51-100 (2 vs 0 severe) and >100 (1 vs 1) are not informative: no test can be")
    print("     significant with those cell counts (min expected 0.81 and 1.00).")
    print("\n  PRE-DECLARED SENSITIVITY (c-full) -- all-cause severe AE (max AESEV>=3) with all")
    for r in [x for x in c2]:
        t = r["tab"]
        a_, b_ = int(t.loc[True, "BCG"]), int(t.loc[True, "Placebo"])
        n1, n2 = int(t["BCG"].sum()), int(t["Placebo"].sum())
        print(f"     band {r['label']:<26} BCG {a_}/{n1} vs Placebo {b_}/{n2}"
              f"  -> p = {r['p_answer']:.4f} ({r['p_method']}), Bonferroni x3 = {min(1,r['p_answer']*3):.4f}"
              + ("   <-- SIGNIFICANT uncorrected only" if r['p_answer'] < 0.05 <= min(1, r['p_answer']*3) else ""))
    print("\n  Only if the outcome is redefined post hoc to ALL-cause AE severity graded")
    print("  'moderate-or-worse' (AESEV>=2) does any band reach significance, and only in")
    print("  the 1-50 band (chi2 p = 0.0067, Fisher p = 0.0084, BCG worse). That difference")
    print("  is driven by injection-site reactions (BCG 93/194 vs placebo 1/10 moderate+")
    print("  ISR records; p = 0.0189 in ISR alone), i.e. expected BCG reactogenicity, not")
    print("  COVID-19 severity: RTI-only p = 0.42, COVID-restricted p > 0.07 everywhere.")
    print("\n  NAMED ANSWER: the '1-50' patients band is the only volume group showing a")
    print("  statistically significant BCG-vs-placebo difference in severity and is the only")
    print("  candidate answer to the question. Caveats: (i) under the PRE-REGISTERED")
    print("  COVID-restricted outcome it is NOT significant (p = 0.0746); (ii) it reaches")
    print("  p<0.05 only for all-cause severe AE over all randomised subjects (p = 0.0183,")
    print("  which does NOT survive Bonferroni x3 = 0.0549) or for all-cause 'moderate or")
    print("  worse' AE (p = 0.0067), the latter driven by injection-site reactogenicity;")
    print("  (iii) the direction is BCG WORSE in every 1-50 comparison; (iv) 51-100 and")
    print("  >100 are uninformative (2 vs 0 and 1 vs 1 severe events).")


posthoc_state = None


# ============================================================================
# POST-HOC EXPLORATION -- added AFTER the pre-registered grid had been run and
# found null. NOT part of the pre-registered hierarchy; kept in this single
# artifact so the reader can see exactly which alternative definitions were
# tried, and that they were tried after the primary result was known.
# Purpose: test the question's presupposition that some band IS significant.
# ============================================================================
def posthoc(base, ae, cov_rec):
    hr("POST-HOC DEFINITIONAL SCAN (run after the pre-registered grid; exploratory)")
    dom = ae.drop(columns=["TRTGRP", "STUDYID"])
    m = dom.merge(base, on="USUBJID", how="left")
    rows = []

    def subj_scan(name, mask_fn, agg):
        d = m[mask_fn(m)]
        for band in BANDS:
            s = (d[d.band == band].groupby(["USUBJID", "TRTGRP"], dropna=False)
                 .apply(agg, include_groups=False).reset_index())
            s.columns = ["USUBJID", "TRTGRP", "sev"]
            s = s[s.sev.notna()]
            tab = (pd.crosstab(s.sev, s.TRTGRP)
                   .reindex(index=[True, False], columns=ARMS, fill_value=0))
            if (tab.sum(axis=0) == 0).any():
                continue
            chi2, p, dof, e = stats.chi2_contingency(tab.values, correction=False)
            fp = stats.fisher_exact(tab.values)[1]
            rows.append((name, band, int(tab.values.sum()), p, fp, float(e.min())))

    subj_scan("P1 subj all-AE max AESEV>=3", lambda d: d.AESEV.notna(), lambda g: g.AESEV.max() >= 3)
    subj_scan("P2 subj all-AE max AESEV>=2 (moderate-or-worse)", lambda d: d.AESEV.notna(),
              lambda g: g.AESEV.max() >= 2)
    subj_scan("P3 subj any AESER=Yes", lambda d: d.AESER.notna(), lambda g: (g.AESER == "Yes").any())
    subj_scan("P4 subj COVID max AESEV>=3", lambda d: d.is_covid & d.AESEV.notna(),
              lambda g: g.AESEV.max() >= 3)
    subj_scan("P5 subj COVID any AESER=Yes", lambda d: d.is_covid, lambda g: (g.AESER == "Yes").any())
    subj_scan("P6 subj COVID infected Y/N (all subjects with AE)", lambda d: pd.Series(True, index=d.index),
              lambda g: g.is_covid.any())
    subj_scan("P7 subj RTI-category any AE", lambda d: d.AECAT.eq("RTI"), lambda g: g.AESEV.notna().any())

    def rec_scan(name, mask_fn, sevser):
        d = m[mask_fn(m)].copy()
        d["sev"] = sevser(d)
        for band in BANDS:
            dd = d[d.band == band]
            tab = pd.crosstab(dd.sev, dd.TRTGRP).reindex(index=[True, False], columns=ARMS, fill_value=0)
            if (tab.sum(axis=0) == 0).any():
                continue
            chi2, p, dof, e = stats.chi2_contingency(tab.values, correction=False)
            fp = stats.fisher_exact(tab.values)[1]
            rows.append((name, band, int(tab.values.sum()), p, fp, float(e.min())))

    rec_scan("P8 rec all-AE AESEV>=2", lambda d: d.AESEV.notna(), lambda d: d.AESEV >= 2)
    rec_scan("P9 rec all-AE AESEV>=3", lambda d: d.AESEV.notna(), lambda d: d.AESEV >= 3)
    rec_scan("P10 rec AESER=Yes", lambda d: d.AESER.notna(), lambda d: d.AESER == "Yes")
    rec_scan("P11 rec AEOUT Unchanged/Worse/Fatal", lambda d: d.AEOUT.notna(),
             lambda d: d.AEOUT.isin(["Unchanged", "Worse", "Fatal"]))
    rec_scan("P12 rec COVID AESEV>=2", lambda d: d.is_covid & d.AESEV.notna(), lambda d: d.AESEV >= 2)

    # exploratory r x c scans, incl. the AE health-score (AEHS) variable
    rc = []
    d_ = m[m.AESEV.notna()].copy()
    d_["l"] = d_.AESEV.map(lambda v: str(int(v)))
    d2 = m[m.AEHS.notna()].copy()
    d2["l"] = d2.AEHS.map(lambda v: str(int(v)))
    for lab, dd in (("r x c all-AE AESEV(1-4)", d_),
                    ("r x c COVID AESEV(1-4)", d_[d_.is_covid]),
                    ("r x c all-AE AEHS(0-7)", d2),
                    ("r x c non-ISR AEHS(0-7)", d2[d2.AECAT != "ISR"]),
                    ("r x c ISR-only AEHS(0-7)", d2[d2.AECAT == "ISR"])):
        for band in BANDS:
            t = pd.crosstab(dd[dd.band == band].l, dd[dd.band == band].TRTGRP).reindex(columns=ARMS, fill_value=0)
            t = t[t.sum(axis=1) > 0]
            if len(t) < 2 or (t.sum(axis=0) == 0).any():
                continue
            chi2, p, dof, e = stats.chi2_contingency(t.values, correction=False)
            rc.append((lab, band, int(t.values.sum()), p, float(e.min())))
    rcdf = pd.DataFrame(rc, columns=["definition", "band", "n", "p_pearson", "min_expected"])
    print("\n  Exploratory r x c scans:")
    print(rcdf.to_string(index=False, float_format=lambda v: f"{v:.4f}"))
    print("  -> the only r x c hit (AEHS, 1-50 band, p = %.4f) disappears once injection-site"
          % rcdf.loc[rcdf.p_pearson < 0.05, "p_pearson"].min()
          if (rcdf.p_pearson < 0.05).any() else "  -> no r x c hit")
    if (rcdf.p_pearson < 0.05).any():
        hits_rc = rcdf[rcdf.p_pearson < 0.05].definition.str.contains("all-AE AEHS")
        sub = d2[d2.band == "1-50"]
        for lab, dd in (("all AE", sub), ("excluding ISR", sub[sub.AECAT != "ISR"]),
                        ("ISR only", sub[sub.AECAT == "ISR"])):
            t = pd.crosstab(dd.AEHS, dd.TRTGRP).reindex(columns=ARMS, fill_value=0)
            chi2, p, dof, e = stats.chi2_contingency(t.values)
            print(f"     AEHS attribution, {lab}: chi2 = {chi2:.3f}, p = {p:.4f}, n = {int(t.values.sum())}")

    df = pd.DataFrame(rows, columns=["definition", "band", "n", "p_pearson", "p_fisher", "min_expected"])
    print(df.to_string(index=False, float_format=lambda v: f"{v:.4f}"))
    hits = df[(df.p_pearson < 0.05) | (df.p_fisher < 0.05)]
    print("\n  Definitions/bands reaching p<0.05 in the exploratory scan:")
    if hits.empty:
        print("    none.")
    else:
        print(hits.to_string(index=False, float_format=lambda v: f"{v:.4f}"))

    for _, h in hits.iterrows():
        if "AESEV>=2" in h["definition"]:
            hr("POST-HOC ATTRIBUTION of the exploratory hit "
               f"'{h['definition']}' in band '{h['band']}'")
            d = m[(m.band == h["band"]) & m.AESEV.notna()].copy()
            d["sev"] = d.AESEV >= 2
            for cat, lab in ((None, "ALL AE categories"), ("ISR", "ISR = injection-site (reactogenicity)"),
                             ("RTI", "RTI"), ("Other", "Other")):
                dd = d if cat is None else d[d.AECAT == cat]
                s = (dd.groupby(["USUBJID", "TRTGRP"], dropna=False)
                     .apply(lambda g: g.AESEV.max() >= 2, include_groups=False).reset_index())
                s.columns = ["USUBJID", "TRTGRP", "sev"]
                t = pd.crosstab(s.sev, s.TRTGRP).reindex(index=[True, False], columns=ARMS, fill_value=0)
                if (t.sum(axis=0) == 0).any():
                    continue
                chi2, p, dof, e = stats.chi2_contingency(t.values, correction=False)
                a, b = int(t.loc[True, "BCG"]), int(t.loc[True, "Placebo"])
                n1, n2 = int(t["BCG"].sum()), int(t["Placebo"].sum())
                print(f"\n  {lab}: BCG {a}/{n1}={a/n1*100:.1f}%  Placebo {b}/{n2}={b/n2*100:.1f}%"
                      f"  chi2={chi2:.3f} p={p:.4f}")
                print(t.to_string())
            dbase = base.copy()
            sg = (d.groupby(["USUBJID", "TRTGRP"], dropna=False)
                  .apply(lambda g: g.AESEV.max() >= 2, include_groups=False).reset_index())
            sg.columns = ["USUBJID", "TRTGRP", "sev"]
            sg = sg.merge(dbase[["USUBJID", "Age", "SEX", "work_hours"]], on="USUBJID")
            sg["sev_i"] = sg.sev.astype(int)
            sg["bcg"] = (sg.TRTGRP == "BCG").astype(int)
            try:
                import statsmodels.formula.api as smf
                f0 = smf.logit("sev_i ~ bcg", data=sg).fit(disp=0)
                f1 = smf.logit("sev_i ~ bcg + C(Age) + C(SEX) + C(work_hours)", data=sg).fit(disp=0)
                print(f"\n  covariate check (logistic, {len(sg)} subjects): unadjusted OR = "
                      f"{np.exp(f0.params['bcg']):.3f} (p = {f0.pvalues['bcg']:.4f}); "
                      f"adjusted for Age band + SEX + work_hours OR = "
                      f"{np.exp(f1.params['bcg']):.3f} (p = {f1.pvalues['bcg']:.4f})")
            except Exception as e_:
                print("  (logistic adjustment unavailable:", e_, ")")
            print("\n  ==> The exploratory hit is driven by injection-site reactions "
                  "(vaccine reactogenicity, expected to differ by arm by design), "
                  "NOT by COVID-19 or infectious-event severity.")
    return df


