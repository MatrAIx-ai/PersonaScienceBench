#!/usr/bin/env python3
"""bix-13-q5 : DESeq2-style differential expression of PA14 QS mutants vs JBX1.

Question: how many genes are significantly DE (BH padj < 0.05) in at least one
of the lasI / rhlI single mutants but NOT in the lasI rhlI double mutant?
Pre-registered set operation:  N = |(Sig_97 UNION Sig_98) \\ Sig_99|.

Engine: analysis/deseq2_port.py (pure-Python DESeq2 equivalent: median-of-ratios
size factors, Cox-Snell/ML gene-wise NB dispersions with EB MAP shrinkage to the
parametric dispersion-mean trend, NB Wald tests, BH).  The runner has no R, no
pydeseq2 and no network, so the DESeq2 algorithm is re-implemented here.

Outputs (in results/):  counts_report.txt, size_factors.csv, dispersion_check.csv,
deseq2_results_<model>.csv, sensitivity_summary.csv, representative_genes.csv
"""
import sys, os, io, numpy as np, pandas as pd
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)
import deseq2_port as dp

RES = os.path.join(ROOT, "results")
os.makedirs(RES, exist_ok=True)
REF = "1"
MUT = ("97", "98", "99")
GENO = {"1": "JBX1 wild type (assumed)", "97": "dLasI single mutant (assumed)",
        "98": "dRhlI single mutant (assumed)", "99": "dLasIdRhlI double mutant (assumed)"}
ALPHA = 0.05
log = io.StringIO()


def say(*a):
    txt = " ".join(str(x) for x in a)
    print(txt)
    log.write(txt + "\n")


# --------------------------------------------------------------- load/audit
meta = pd.read_csv(os.path.join(ROOT, "data/experiment_metadata.csv"))
counts = pd.read_csv(os.path.join(ROOT, "data/raw_counts.csv")).set_index("Unnamed: 0")
counts.columns.name = None
say("=== INPUT AUDIT ===")
say(f"metadata: {meta.shape} cols={list(meta.columns)}")
say(f"raw_counts: {counts.shape} (col 0 = PA14 locus tag, unnamed on read)")
say("Media:", dict(meta["Media"].value_counts()), "| Strain:", dict(meta["Strain"].value_counts()),
    "| Replicate:", dict(meta["Replicate"].value_counts()))
say("Strain x Media crosstab:\n" + pd.crosstab(meta["Strain"], meta["Media"]).to_string())
say("counts are raw integers:", bool(np.equal(counts.values % 1, 0).all()),
    f"| min={counts.values.min()} max={counts.values.max()} NA={int(counts.isna().sum().sum())}"
    f" | all-zero gene rows={int((counts.sum(axis=1) == 0).sum())}")
unmatched_meta = sorted(set(meta["AzentaName"]) - set(counts.columns))
unmatched_cnt = sorted(set(counts.columns) - set(meta["AzentaName"]))
say(f"join key AzentaName<->column name: matched={len(set(meta['AzentaName']) & set(counts.columns))}"
    f" meta_without_counts={unmatched_meta} counts_without_meta={unmatched_cnt}")
libsz = counts[list(meta['AzentaName'])].sum()
say(f"library sizes: min={int(libsz.min())} max={int(libsz.max())} ratio={libsz.max()/libsz.min():.2f}")
say("per-strain sample counts:", dict(meta.groupby("Strain").size()))

# ------------------------------------------------------------- size factors
Yfull = counts[list(meta["AzentaName"])].astype(float).values
sf, n_pos = dp.median_of_ratios(Yfull)
libratio = libsz.values / libsz.values.mean()
say("\n=== SIZE FACTORS (median-of-ratios, DESeq2 default) ===")
say(f"genes with all counts>0 used: {n_pos}/{Yfull.shape[0]}  size-factor range "
    f"({sf.min():.3f}, {sf.max():.3f})")
say(f"size factors vs library-size ratios: Pearson r={np.corrcoef(sf, libratio)[0,1]:.4f} "
    f"Spearman r={pd.Series(sf).corr(pd.Series(libratio), method='spearman'):.4f} "
    f"max|log ratio|={np.abs(np.log(sf/libratio)).max():.3f}")
pd.DataFrame({"sample": meta["AzentaName"], "strain": meta["Strain"], "media": meta["Media"],
              "replicate": meta["Replicate"], "size_factor": sf,
              "libsize_ratio": libratio}).to_csv(os.path.join(RES, "size_factors.csv"), index=False)

# --------------------------------------------------------------- model runs
MODELS = {
    "i_primary_media+strain":      dict(terms=["Media", "Strain"]),
    "ii_replicate+media+strain":   dict(terms=["Replicate", "Media", "Strain"]),
    "iii_strain_only":             dict(terms=["Strain"]),
    "iv_primary_prefilter_mean10": dict(terms=["Media", "Strain"], filter_mean_ge=10.0),
    "v_primary_indfilt":           dict(terms=["Media", "Strain"], independent_filter=True),
}
runs, summary = {}, []
say("\n=== MODELS ===")
for name, spec in MODELS.items():
    out = dp.deseq2_run(counts, meta, ref_strain=REF, strains=MUT, **spec)
    tab = pd.DataFrame(out["table"])
    tab.to_csv(os.path.join(RES, f"deseq2_results_{name}.csv"), index=False)
    pd.DataFrame({"result_prefix": [f"strain{s}_vs_{REF}" for s in MUT],
                  "verbatim_Strain_label": list(MUT),
                  "assumed_genotype": [GENO[s] for s in MUT],
                  "reference": [f"{REF} = {GENO[REF]}"] * 3}
                 ).to_csv(os.path.join(RES, "contrast_legend.csv"), index=False)
    h = dp.headline(tab, MUT, REF, ALPHA)
    runs[name] = (out, tab, h)
    say(f"\n[{name}] terms={spec['terms']} genes_tested={out['n_genes']} "
        f"(dropped all-zero rows / prefiltered={out['prefiltered']}) design rank={out['rank']}/{out['ncol']} "
        f"cond={out['cond']:.3f} tau2={out['tau2']:.3f} CSfactor={out['cs_factor']:.3f}")
    if out["filt"]:
        say("  independent filtering thresholds:",
            {k: round(v["threshold"], 3) for k, v in out["filt"].items()})
    summary.append(dict(model=name, genes_tested=out["n_genes"],
                        sig_dLasI=h["sig_single1"], sig_dRhlI=h["sig_single2"],
                        sig_double=h["sig_double"], N_union_minus_double=h["N_union_minus_double"],
                        lasI_only=h["lasI_only"], rhlI_only=h["rhlI_only"],
                        shared_singles=h["shared_singles"],
                        exactly_one_single=h["exactly_one_single"]))
    say(pd.DataFrame([summary[-1]]).drop(columns=["model"]).to_string(index=False))
# dispersion-handling sensitivity (identical design/genes, different dispersions)
outP = runs["i_primary_media+strain"][0]
for lab, disp in [("vi_no_shrinkage_raw_disp", outP["disp_raw"]),
                  ("vii_fully_shrunk_to_trend", outP["trend"])]:
    tabx = dp.refit_with_dispersions(outP, disp)
    hx = dp.headline(tabx, MUT, REF, ALPHA)
    summary.append(dict(model=lab, genes_tested=len(tabx), sig_dLasI=hx["sig_single1"],
                        sig_dRhlI=hx["sig_single2"], sig_double=hx["sig_double"],
                        N_union_minus_double=hx["N_union_minus_double"],
                        lasI_only=hx["lasI_only"], rhlI_only=hx["rhlI_only"],
                        shared_singles=hx["shared_singles"],
                        exactly_one_single=hx["exactly_one_single"]))
    tabx.to_csv(os.path.join(RES, f"deseq2_results_{lab}.csv"), index=False)
    say(f"[{lab}] N={hx['N_union_minus_double']} (sig {hx['sig_single1']}/{hx['sig_single2']}/{hx['sig_double']})")
summ = pd.DataFrame(summary)
summ.to_csv(os.path.join(RES, "sensitivity_summary.csv"), index=False)

# ------------------------------------------- engine verification: dispersions
out, tab, h = runs["i_primary_media+strain"]
say("\n=== IMPLEMENTATION VERIFICATION (primary model) ===")
tp = out["trend_par"]
say(f"dispersion trend disp(mu) = a1 + a2/mu + a3/mu^2 with a1={tp['a1']:.6g}, "
    f"a2={tp['a2']:.6g}, a3={tp['a3']:.6g}; prior variance tau2={out['tau2']:.4f} "
    f"(robust MAD variance of log(gene-wise/trend)); Cox-Snell factor={out['cs_factor']:.4f}")
mm = out["mu"].mean(axis=1)
rows = []
for lo, hi in [(0, 20), (20, 100), (100, 1000), (1000, 5000), (5000, 1e12)]:
    s = (mm >= lo) & (mm < hi)
    if s.sum():
        rows.append(dict(mean_norm_bin=f"[{lo:g},{hi:g})", n_genes=int(s.sum()),
                         disp_raw_median=float(np.median(out["disp_raw"][s])),
                         trend_median=float(np.median(out["trend"][s])),
                         disp_shrunk_median=float(np.median(out["disp_map"][s])),
                         median_shrink_ratio=float(np.median(out["disp_map"][s] / out["disp_raw"][s]))))
dc = pd.DataFrame(rows)
say(dc.to_string(index=False))
say("Shrinkage behaves as expected: low-count genes move toward the trend, "
    "deep-count genes (sharp NB likelihood) stay close to their gene-wise value.")
# example genes: highest and lowest expression, plus marker loci
ex = np.argsort(-mm)[:3].tolist() + np.argsort(mm)[:3].tolist()
exi = [int(np.where(tab["gene"] == g)[0][0]) for g in ["PA14_53070", "PA14_71590", "PA14_71580"]
       if (tab["gene"] == g).any()]
idx = sorted(set(ex + exi))
ver = pd.DataFrame({"gene": tab["gene"].values[idx], "mean_norm": mm[idx],
                    "disp_gene_wise": out["disp_raw"][idx], "trend": out["trend"][idx],
                    "disp_shrunk": out["disp_map"][idx],
                    "shrink_ratio": (out["disp_map"] / out["disp_raw"])[idx]})
say("\nexample genes (3 highest / 3 lowest expressed + las/rhl candidate loci):")
say(ver.round(5).to_string(index=False))
ver.to_csv(os.path.join(RES, "dispersion_check.csv"), index=False)

# independent (model-free) dispersion cross-check from within strain x media cells
lab = pd.Series(list(zip(meta["Strain"].astype(str), meta["Media"])))
N = (Yfull / Yfull.sum(0)) * Yfull.sum(0).mean()
mus, vs = [], []
for k, ii in lab.groupby(lab).groups.items():
    sub = N[:, np.array(ii, dtype=int)]
    mus.append(sub.mean(1)); vs.append(sub.var(1, ddof=1))
muc, vcc = np.mean(mus, axis=0), np.mean(vs, axis=0)
alpha_cell = (vcc - muc) / np.maximum(muc ** 2, 1e-12)
say(f"\nmodel-free cross-check (within strain x media cell variance, 12 cells n=3): "
    f"median dispersion by abundance decile = "
    f"{np.round(np.percentile(alpha_cell[muc>1], [25,50,75]),4).tolist()} "
    f"(same order as gene-wise estimates median={np.median(out['disp_raw']):.4f})")

# ------------------------------------------------------------- null check
rng = np.random.default_rng(7)
nulls = []
for rep in range(2):
    mmeta = meta.copy()
    for med, ii in meta.groupby("Media").groups.items():
        mmeta.loc[ii, "Strain"] = rng.permutation(mmeta.loc[ii, "Strain"].values)
    po = dp.deseq2_run(counts, mmeta, ["Media", "Strain"], REF, MUT)
    pt = pd.DataFrame(po["table"])
    ph = dp.headline(pt, MUT, REF, ALPHA)
    pv = np.concatenate([pt[f"strain{s}_vs_{REF}_p"].values for s in MUT])
    pa = np.concatenate([pt[f"strain{s}_vs_{REF}_padj"].values for s in MUT])
    nulls.append((np.median(pv), np.mean(pv < 0.05), np.mean(pa < 0.05), ph["N_union_minus_double"]))
    say(f"permutation control {rep}: median p={np.median(pv):.3f}, frac p<0.05={np.mean(pv<0.05):.3f}, "
        f"frac padj<0.05={np.mean(pa<0.05):.4f}, headline N under null={ph['N_union_minus_double']}")

# ------------------------------------------------------- primary answer set
say("\n=== PRIMARY ANSWER (model i: ~Media + Strain, ref strain 1, padj < 0.05) ===")
say("verbatim labels / assumed genotypes: " + "; ".join(f"{k}={GENO[k]}" for k in ["1", *MUT]))
for k in ("sig_single1", "sig_single2", "sig_double"):
    say(f"  {k}: {h[k]}")
say(f"  N = |(Sig_97 U Sig_98) \\\\ Sig_99| = {h['N_union_minus_double']}")
say(f"  components: lasI-only={h['lasI_only']} + rhlI-only={h['rhlI_only']} + "
    f"shared-by-both-singles={h['shared_singles']} = "
    f"{h['lasI_only'] + h['rhlI_only'] + h['shared_singles']}")
say(f"  stricter reading (significant in exactly ONE single mutant, not double) = {h['exactly_one_single']}")

mask = h["union_mask"]
cols = {"gene": tab["gene"].values, "mean_norm": mm}
for s in MUT:
    pre = f"strain{s}_vs_{REF}"
    cols[f"{s}_log2FC"] = tab[f"{pre}_log2FC"].values
    cols[f"{s}_padj"] = tab[f"{pre}_padj"].values
full = pd.DataFrame(cols)
full["class"] = np.where(mask, np.where(full["97_padj"] < ALPHA,
                               np.where(full["98_padj"] < ALPHA, "shared_singles", "lasI_only"),
                               "rhlI_only"), "other")
full.to_csv(os.path.join(RES, "primary_gene_table.csv"), index=False)
repres = (full[mask].assign(score=lambda d: np.minimum(d["97_padj"], d["98_padj"]))
          .sort_values("score").head(25).drop(columns="score"))
repres.to_csv(os.path.join(RES, "representative_genes.csv"), index=False)
say("\nrepresentative genes driving N (top 25 by strongest single-mutant padj):")
say(repres.head(25).round(6).to_string(index=False))
say("\nlas/rhl candidate loci (identified by strain-specific expression loss, NOT annotation):")
say(full[full["gene"].isin(["PA14_53070", "PA14_71590", "PA14_71580", "PA14_71600"])]
    .round(6).to_string(index=False))
# genotype-mapping marker evidence (mean normalised counts per strain)
say("\nmarker evidence used for the genotype mapping (mean normalised counts):")
yn = Yfull / sf[None, :]
mk = ["PA14_53070", "PA14_71590", "PA14_71580", "PA14_71600", "PA14_09440", "PA14_72360",
      "PA14_72370", "PA14_62690", "PA14_10380", "PA14_39945"]
gidx = {g: i for i, g in enumerate(counts.index)}
mtab = pd.DataFrame({"gene": mk,
                     **{f"{k}={GENO[k].split(' (')[0]}": [yn[gidx[g]][meta["Strain"].astype(str).values == k].mean() for g in mk]
                        for k in ["1", *MUT]}})
mtab["in_N_set"] = [g in set(full.loc[mask, "gene"]) for g in mk]
mtab.round(1).to_csv(os.path.join(RES, "genotype_marker_evidence.csv"), index=False)
say(mtab.round(1).to_string(index=False))

say(f"\ncomponent-by-abundance breakdown of the N set:\n" +
    full[mask].assign(bin=pd.cut(full.loc[mask, "mean_norm"], [0, 10, 100, 1000, 1e9]))
    .groupby(["bin", "class"], observed=True).size().unstack(fill_value=0).to_string())

with open(os.path.join(RES, "counts_report.txt"), "w") as fh:
    fh.write(log.getvalue())
print("\nwrote results to", RES)

# ------------------------------------------------------------------- report
prim = summ.loc[summ.model == "i_primary_media+strain"].iloc[0]
sens = summ[summ.model != "iii_strain_only"]["N_union_minus_double"]
md = ["# bix-13-q5 — DE analysis of PA14 QS mutants vs JBX1 (executed)\n",
      "**Question:** how many genes are significantly DE (BH padj < 0.05) in at least one of the "
      "ΔlasI / ΔrhlI single mutants but not in the ΔlasIΔrhlI double mutant?\n",
      f"**ANSWER (pre-registered set operation |(Sig_97 ∪ Sig_98) \\ Sig_99|, primary model "
      f"~ Media + Strain, reference Strain = 1): N = {int(prim['N_union_minus_double'])}**\n",
      f"* components: lasI-only {int(prim['lasI_only'])} + rhlI-only {int(prim['rhlI_only'])} + "
      f"shared-by-both-singles {int(prim['shared_singles'])} = {int(prim['N_union_minus_double'])}",
      f"* per-contrast padj<0.05 counts: ΔlasI {int(prim['sig_dLasI'])}, ΔrhlI "
      f"{int(prim['sig_dRhlI'])}, double {int(prim['sig_double'])} (of {int(prim['genes_tested'])} tested genes)",
      f"* alternative strict reading (significant in exactly ONE single mutant, not the double): "
      f"{int(prim['exactly_one_single'])} — reported, not used as the answer",
      f"* headline N across sensitivity models: {int(sens.min())}–{int(sens.max())}; the only "
      f"materially different variant is the ~Strain-only model "
      f"({int(summ.loc[summ.model=='iii_strain_only','N_union_minus_double'].iloc[0])}), which "
      f"discards the dominant Media variance term (flagged caveat)\n",
      "**Assumed genotype key (inferred from expression, verbatim labels kept in every table):** "
      "1 = JBX1 wild type, 97 = ΔlasI, 98 = ΔrhlI, 99 = ΔlasIΔrhlI.\n",
      "**Engine:** pure-Python DESeq2 equivalent (`analysis/deseq2_port.py`) — median-of-ratios size "
      "factors, Cox-Snell/ML gene-wise NB dispersions with EB MAP shrinkage to the parametric "
      "dispersion-mean trend, NB Wald tests, BH. No R/pydeseq2/network in this runner.\n",
      "## Full run log\n```\n" + log.getvalue() + "\n```\n",
      "## Files\n- `results/sensitivity_summary.csv` — headline counts for models (i)-(vii)\n"
      "- `results/primary_gene_table.csv` — per-gene log2FC/padj for all 3 contrasts + set class\n"
      "- `results/representative_genes.csv`, `results/dispersion_check.csv`, "
      "`results/size_factors.csv`, `results/genotype_marker_evidence.csv`, "
      "`results/contrast_legend.csv`, `results/deseq2_results_*.csv`, `results/counts_report.txt`\n"]
open(os.path.join(RES, "report.md"), "w").write("\n".join(md))
print("wrote", os.path.join(RES, "report.md"))
