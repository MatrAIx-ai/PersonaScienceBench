"""bix-14-q3 FINAL analysis.

Pipeline (approved):
  load 86 workbooks (header=1) -> restrict to Schenz 56 CHIP symbols (any comma-split
  symbol in 'Gene Names') -> drop reference/no-call Zygosity -> keep exonic SO terms -> count.
Primary unit: per-sample variant calls summed across the 86 samples.
"""
import glob, os
import pandas as pd, openpyxl

SRC = "data/CHIP_DP10_GQ20_PASS"
OUT = open("inspection/final_report.txt", "w")
def p(*a):
    s = " ".join(str(x) for x in a); print(s); OUT.write(s + "\n")

CHIP = [r[0] for r in openpyxl.load_workbook(
    "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx")["Sheet1"].iter_rows(values_only=True)]
CHIP = {str(g).strip().upper() for g in CHIP}
EXONIC = {"synonymous_variant", "missense_variant", "inframe_insertion",
          "inframe_deletion", "frameshift_variant"}
NONREF = {"heterozygous", "homozygous variant"}

files = sorted(glob.glob(f"{SRC}/*.xlsx"))
assert len(files) == 86
rows = []
for f in files:
    s = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    d = pd.read_excel(f, header=1)
    d.insert(0, "sample", s)
    rows.append(d)
a = pd.concat(rows, ignore_index=True)

# ---- Zygosity normalization audit -------------------------------------------------
raw = a["Zygosity"]
norm = raw.apply(lambda v: v.strip().lower() if isinstance(v, str) else v)
p("[A] ZYGOSITY NORMALIZATION AUDIT")
p("  raw distinct values        :", raw.value_counts(dropna=False).to_dict())
p("  trimmed/lowered distinct   :", norm.value_counts(dropna=False).to_dict())
p("  any value with stray ws/case-diff:",
  sorted({r for r in raw.dropna().unique() if isinstance(r, str) and r != r.strip()} |
         {r for r in raw.dropna().unique() if isinstance(r, str) and r != r.lower()}))
p("  distinct values OUTSIDE {Reference, Heterozygous, Homozygous Variant, blank}:",
  sorted(set(x for x in norm.dropna().unique() if x not in
             {"reference", "heterozygous", "homozygous variant"})))
p("  normalization changes classification for",
  int((raw.map(lambda v: isinstance(v,str) and v.strip().lower() in NONREF) != raw.isin(
      ['Heterozygous', 'Homozygous Variant'])).sum()), "rows")

a["z_norm"] = norm
a["syms"] = a["Gene Names"].astype(str).apply(lambda g: {x.strip().upper() for x in g.split(",")})
a["in_chip"] = a["syms"].apply(lambda S: bool(S & CHIP))
a["so"] = a["Sequence Ontology (Combined)"].astype(str).str.strip()

# ---- ordered, auditable attrition ------------------------------------------------
m_chip = a["in_chip"]
m_nonref = m_chip & a["z_norm"].isin(NONREF)
m_fin = m_nonref & a["so"].isin(EXONIC)
p("\n[B] ORDERED FILTER ATTRITION (primary pipeline)")
p(f"  step 0  loaded variant calls, 86 workbooks           : {len(a):>6,}")
p(f"  step 1  restricted to 56 Schenz CHIP gene symbols    : {int(m_chip.sum()):>6,}"
  f"   (dropped {int((~m_chip).sum()):,})")
p(f"  step 2  drop Reference + drop blank/no-call Zygosity : {int(m_nonref.sum()):>6,}"
  f"   (dropped {int((m_chip & (a.z_norm=='reference')).sum()):,} Reference"
  f" + {int((m_chip & a['Zygosity'].isna()).sum()):,} blank no-calls)")
p(f"  step 3  keep exonic SO terms only                    : {int(m_fin.sum()):>6,}"
  f"   (dropped {int((m_nonref & ~a.so.isin(EXONIC)).sum()):,})")
p(f"  FINAL  non-reference exonic CHIP variant calls       : {int(m_fin.sum()):>6,}")

fin = a[m_fin]
p("\n  SO terms dropped at step 3 (non-reference CHIP rows):",
  a[m_nonref & ~a.so.isin(EXONIC)]["so"].value_counts().to_dict())
p("  blank no-calls dropped at step 2, by SO:",
  a[m_chip & a['Zygosity'].isna()]['so'].value_counts().to_dict())

# ---- per-sample distribution -----------------------------------------------------
ps = fin.groupby("sample").size().sort_values()
p("\n[C] PER-SAMPLE RETAINED CALLS")
p("  samples with >=1 call:", len(ps), "of 86   sum =", int(ps.sum()))
p("  min %d | q1 %d | median %d | q3 %d | max %d | mean %.2f" % (
    ps.min(), ps.quantile(.25), ps.median(), ps.quantile(.75), ps.max(), ps.mean()))
p("  10 lowest :", ps.head(10).to_dict())
p("  10 highest:", ps.tail(10).to_dict())
oth = ps.drop(index=[i for i in ("380-P", "381-PM") if i in ps.index])
p("  84-sample comparator (excl 380-P/381-PM): mean %.2f  median %.1f  min %d  max %d  sd %.2f"
  % (oth.mean(), oth.median(), oth.min(), oth.max(), oth.std()))
for s in ("380-P", "381-PM"):
    z = (ps[s] - oth.mean()) / oth.std()
    p(f"  {s}: retained={ps[s]}  z vs the other 84 = {z:+.2f}")
p("  raw rows loaded per sample (380-P/381-PM carry the extra quasi-repeat rows):",
  {s: int((a['sample'] == s).sum()) for s in ("380-P", "381-PM")},
  "vs typical median", int(a.groupby('sample').size().median()))

# ---- per-gene breakdown ----------------------------------------------------------
gcount = {}
for _, r in fin.iterrows():
    for s in (r["syms"] & CHIP):
        gcount[s] = gcount.get(s, 0) + 1
gs = pd.Series(gcount).sort_values(ascending=False)
p("\n[D] PER-GENE BREAKDOWN OF FINAL CALLS (comma-split, Schenz symbols only)")
p("  distinct Schenz genes hit:", len(gs), "| sum of per-gene counts:", int(gs.sum()),
  "(= final calls; equal => every retained row matched exactly one Schenz symbol)")
p("  every retained row matched exactly one Schenz symbol:",
  bool((fin["syms"].apply(lambda S: len(S & CHIP)) == 1).all()))
p("  top 15:", gs.head(15).to_dict())
p("  bottom 5:", gs.tail(5).to_dict())
p("  Schenz symbols with zero retained calls:", sorted(CHIP - set(gs.index)))
p("  NON-Schenz symbols appearing in retained rows (must be empty):",
  sorted(set().union(*fin["syms"].tolist()) - CHIP))

# ---- integrity checks ------------------------------------------------------------
p("\n[E] INTEGRITY CHECKS")
p("  duplicate (sample,Chr:Pos,Ref/Alt) inside final subset:",
  int(fin.duplicated(["sample", "Chr:Pos", "Ref/Alt"]).sum()))
p("  duplicate (sample,Chr:Pos) inside final subset:",
  int(fin.duplicated(["sample", "Chr:Pos"]).sum()))
p("  unique genomic positions in final subset:", int(fin["Chr:Pos"].nunique()))
p("  Filter column inside final subset:", fin["Filter"].value_counts().to_dict())
p("  Zygosity inside final subset:", fin["Zygosity"].value_counts().to_dict())
p("  SO inside final subset:", fin["so"].value_counts().to_dict())
p("  genes contributing the panel rows dropped at step 1:",
  a.loc[~a['in_chip'], 'Gene Names'].value_counts().to_dict())

# ---- sensitivity grid ------------------------------------------------------------
p("\n[F] SENSITIVITY GRID")
core = EXONIC; incl = EXONIC | {"splice_region_variant"}
zc = a["z_norm"].isin(NONREF)
zk = zc | a["Zygosity"].isna()
kw = ~a["so"].str.contains("intron|UTR|intergenic|upstream", case=False)
cands = [
 ("PRIMARY  exonic excl splice_region | blanks excluded | Schenz filter", m_chip & zc & a.so.isin(core)),
 ("S1       blanks INCLUDED as non-reference (exonic excl splice, Schenz)", m_chip & zk & a.so.isin(core)),
 ("S2       splice_region INCLUDED as exonic (blanks excluded, Schenz)", m_chip & zc & a.so.isin(incl)),
 ("S3       both levers open (blanks in, splice_region in, Schenz)", m_chip & zk & a.so.isin(incl)),
 ("S4       gene filter = In_CHIP column (all rows) instead of Schenz", pd.Series(True, index=a.index) & zc & a.so.isin(core)),
 ("S5       keyword-exclusion rule (drop intron/UTR/intergenic/upstream, keep splice, blanks in, no gene filter)", kw & zk),
]
for nm, m in cands:
    p(f"  {nm:80s} calls={int(m.sum()):>5,}  uniq_pos={a.loc[m,'Chr:Pos'].nunique():>4}")
p("\n  ANSWER =", int(m_fin.sum()))
OUT.close()
