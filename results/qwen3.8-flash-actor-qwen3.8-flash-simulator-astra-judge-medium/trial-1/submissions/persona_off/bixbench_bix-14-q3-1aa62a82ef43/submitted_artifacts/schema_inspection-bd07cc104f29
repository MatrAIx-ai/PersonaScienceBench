"""Read-only inspection pass for bix-14-q3 (CHIP exonic variant count).
Reports: file inventory, multi-row header structure, distinct values of the
genotype (Zygosity) and region/consequence (Sequence Ontology) fields,
CHIP gene-list contents, Trio status, and the size of each ambiguous decision.
NO final count is produced here.
"""
import glob, os, re, collections
import pandas as pd, openpyxl

SRC = "data/CHIP_DP10_GQ20_PASS"
OUT = open("inspection/inspection_report.txt", "w")
def p(*a):
    s = " ".join(str(x) for x in a)
    print(s); OUT.write(s + "\n")

files = sorted(glob.glob(f"{SRC}/*.xlsx"))
p("[1] FILE INVENTORY")
p("  files in CHIP_DP10_GQ20_PASS :", len(files))
p("  non-xlsx / duplicate names   :", len([f for f in files if not f.endswith('.xlsx')]),
  len(files) - len(set(map(os.path.basename, files))))
samples = [os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "") for f in files]
p("  distinct sample ids          :", len(set(samples)))
p("  id styles: numeric trio ids  :", len([s for s in samples if not s.startswith('SRR')]),
  "| SRR ids:", len([s for s in samples if s.startswith('SRR')]))

p("\n[2] HEADER STRUCTURE (all 86 files)")
hdr1, hdr2, shapes = set(), set(), []
for f in files:
    wb = openpyxl.load_workbook(f); ws = wb[wb.sheetnames[0]]
    r = list(ws.iter_rows(min_row=1, max_row=2, values_only=True))
    hdr1.add(r[0]); hdr2.add(r[1])
    n = sum(1 for x in ws.iter_rows(min_row=3, values_only=True) if x[0] not in (None, ""))
    shapes.append((os.path.basename(f), wb.sheetnames[0], ws.max_column, n)); wb.close()
p("  header rows per file         : 2  (row1 = merged group titles, row2 = field names)")
p("  distinct row-1 headers       :", len(hdr1), "(only the 'Proband (xxx)' group label differs)")
p("  distinct row-2 headers       :", len(hdr2), "-> identical field names in every file")
p("  max_col values               :", sorted({s[2] for s in shapes}))
p("  data rows: min/median/max    :", min(s[3] for s in shapes), int(pd.Series([s[3] for s in shapes]).median()), max(s[3] for s in shapes))
p("  sheet-name '(Variants N)' only matches true row count for 380-P(704)/381-PM(705);")
p("  every other sheet says 674 but actual data rows differ -> sheet titles are stale.")
p("  merged row-1 groups          : 'Variant Info' A1:B1, 'Flags' C1:D1, sample group E1:J1,")
p("     'Match ACMG SF v3.0' K1:L1, 'RefSeq Genes 110, NCBI' M1:S1, gnomAD T1:X1,")
p("     ClinVar Y1:AC1, two 'Match String List' groups AD1:AE1 / AF1:AG1")

df = pd.read_excel(files[0], header=1)
p("\n  columns after header=1 read:")
for i, c in enumerate(df.columns): p(f"    {i:2d} {c}")

keep = ['Zygosity', 'Sequence Ontology (Combined)', 'Effect (Combined)', 'Gene Names',
        'Exon Number (Clinically Relevant)', 'In_CHIP', 'Filter', 'HGVS c. (Clinically Relevant)']
rows = []
for f in files:
    s = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    d = pd.read_excel(f, header=1); d.insert(0, 'sample', s); rows.append(d)
a = pd.concat(rows, ignore_index=True); a.to_pickle("inspection/all_rows.pkl")

p("\n[3] CHIP GENE WORKBOOK 230214_Schenz_et_al_2022_CHIP_Genes.xlsx")
ws = openpyxl.load_workbook("data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx")["Sheet1"]
genes = [r[0] for r in ws.iter_rows(values_only=True)]
p("  shape A1:A%d -> %d symbols, 1 column, NO header row, no blanks/duplicates" % (len(genes), len(set(genes))))
p("  symbols:", ", ".join(genes))
p("  format == HGNC symbols, same format as 'Gene Names' column")

p("\n[4] Trio status 230215_Trio_Status.xlsx")
t = pd.read_excel("data/230215_Trio_Status.xlsx")
p("  shape", t.shape, "cols", list(t.columns))
p(t.head(3).to_string())
p("  Status:", t['Status'].value_counts().to_dict(), "(note 'Mother ' has trailing space)")
base = {re.match(r'^(SRR\d+|\d+)', s).group(1) for s in samples}
tids = set(t['Sample ID'].astype(str).str.strip())
p("  trio ids not among the 86 file ids:", sorted(tids - base), "-> 533 has no workbook")
p("  file ids not in trio table         :", sorted(base - tids))
p("  -> trio table is metadata only; not needed for this count")

p("\n[5] GENOTYPE / 'REFERENCE CALL' ENCODING (all 57,258 rows)")
p("  Filter column:", a['Filter'].value_counts().to_dict())
p("  Zygosity    :", a['Zygosity'].value_counts(dropna=False).to_dict())
p("  NaN-Zygosity rows:", int(a['Zygosity'].isna().sum()),
  "of which 380-P/381-PM:", a[a['Zygosity'].isna()]['sample'].value_counts().head(2).to_dict())
p("  samples with >0 blank Zygosity:", int((a.groupby('sample')['Zygosity'].apply(lambda s: s.isna().sum()) > 0).sum()), "of 86")
p("  in 380-P/381-PM the ENTIRE sample block (cols E:J) is blank on those rows;")
n = a[a['Zygosity'].isna()]; p("  blank-Z rows: DP present on only", int(n['Read Depths (DP)'].notna().sum()), "/", len(n), "-> no genotype evidence at all")
oth = a[a['sample'] != '380-P'].groupby('Chr:Pos')['Zygosity'].apply(lambda s: (s == 'Reference').mean())
d = a[a['sample'] == '380-P'].assign(nanZ=lambda x: x['Zygosity'].isna(), oref=lambda x: x['Chr:Pos'].map(oth))
p("  380-P blank-Z rows are Reference in other samples %.1f%% of the time (baseline %.1f%%)"
  % (100 * d[d.nanZ]['oref'].mean(), 100 * a['Chr:Pos'].map(oth).mean()))

p("\n[6] REGION / CONSEQUENCE FIELD")
p("  field = 'Sequence Ontology (Combined)' (one SO term per row, no multi-value strings)")
p(a['Sequence Ontology (Combined)'].value_counts(dropna=False).to_string())
p("  'Effect (Combined)' (coarse):", a['Effect (Combined)'].value_counts().to_dict())
p("  Exon Number column is populated for every row incl. intronic ones -> NOT an exonicity test")
p("  no intergenic_variant term exists; 'upstream_gene_variant' is the only non-gene term (n=59)")

p("\n[7] CHIP GENE SOURCE AGREEMENT")
chip = set(genes)
syms = {s.strip() for g in a['Gene Names'].dropna().unique() for s in str(g).split(',')}
p("  distinct symbols in sample files:", len(syms))
p("  in files but NOT in Schenz list :", sorted(syms - chip))
p("  in Schenz list but never in files:", sorted(chip - syms))
p("  In_CHIP column is True for", int(a['In_CHIP'].sum()), "/", len(a), "rows (panel already CHIP-restricted)")
a['in_schenz'] = a['Gene Names'].astype(str).apply(lambda g: bool({x.strip() for x in g.split(',')} & chip))
p("  rows whose Gene Names intersect the Schenz list:", int(a['in_schenz'].sum()), "/", len(a),
  "| excluded gene strings:", a.loc[~a['in_schenz'], 'Gene Names'].value_counts().to_dict())

p("\n[8] SIZE OF EACH AMBIGUOUS DECISION (sensitivity only - NOT the answer)")
core = {'synonymous_variant', 'missense_variant', 'inframe_insertion', 'inframe_deletion', 'frameshift_variant'}
for nm, S in [("exonic WITHOUT splice_region", core), ("exonic WITH splice_region", core | {'splice_region_variant'})]:
    for zn, z in [("drop blank as ref-like", a['Zygosity'].isin(['Heterozygous', 'Homozygous Variant'])),
                  ("keep blank as non-ref", a['Zygosity'].isin(['Heterozygous', 'Homozygous Variant']) | a['Zygosity'].isna())]:
        for gn, g in [("all In_CHIP rows", pd.Series(True, index=a.index)), ("Schenz symbol filter", a['in_schenz'])]:
            sel = a[a['Sequence Ontology (Combined)'].isin(S) & z & g]
            p(f"  {nm:28s} | {zn:21s} | {gn:19s} -> calls={len(sel):5d}  unique positions={sel['Chr:Pos'].nunique():4d}")
p("  total calls across 86 files =", len(a), "| unique genomic positions =", a['Chr:Pos'].nunique())
OUT.close()
