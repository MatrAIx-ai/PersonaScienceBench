#!/usr/bin/env python3
"""BIX bix-24-q2: Does up- or down-regulation primarily drive the metabolic effects of
CBD in CRC cells?  DE (padj<0.05 & |log2FC|>0.5, log2FC = CBD/Control) + GO:BP ORA.
Tooling tiers attempted in order: R/DESeq2+clusterProfiler -> pydeseq2+gseapy ->
pure-Python DESeq2-style NB-GLM (de_core.py) + curated ENSG GO:BP proxy sets (go_final.py).
"""
import importlib.util, shutil, subprocess, sys, os
sys.path.insert(0, os.path.dirname(__file__))

def tier():
    if shutil.which('Rscript'):
        return 'R'
    if importlib.util.find_spec('pydeseq2') and importlib.util.find_spec('gseapy'):
        return 'pydeseq2+gseapy'
    return 'python-fallback'

def main():
    t = tier()
    print("TOOLING TIER EXECUTED:", t)
    if t == 'R':
        subprocess.run(['Rscript', 'analysis/deseq2_clusterprofiler.R'], check=True)
        return
    if t == 'pydeseq2+gseapy':
        import pydeseq2, gseapy  # noqa
        # (not reached in offline env; same contrast logic as fallback)
        raise SystemExit("pydeseq2 path not implemented here")
    # ---------------- fallback tier (executed) ----------------
    import pandas as pd, numpy as np
    from de_core import deseq_style
    import go_final
    cnt = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
    cnt.columns = [c.replace('_', '-') for c in cnt.columns]
    lay = pd.read_csv('data/sample_layout.csv')
    groups = lay.set_index('SampleID')['Group'][cnt.columns]
    c = cnt.loc[(cnt >= 5).sum(axis=1) >= 3]
    print(f"genes tested: {len(c)} of {len(cnt)}")
    out = []
    contrasts = [('CBD_IC50', 'DMSO', 'CBD_vs_DMSO'),
                 ('CBD_IC50', 'Untreated', 'CBD_vs_Untreated')]
    for tr, ct_, name in contrasts:
        r = deseq_style(c, groups, tr, ct_); r.to_csv(f'results/de_{name}.csv')
    c2 = c[[s for s in c.columns if groups[s] in ('DMSO', 'Untreated', 'CBD_IC50')]]
    g2 = groups[c2.columns].replace({'DMSO': 'Ctrl', 'Untreated': 'Ctrl'})
    deseq_style(c2, g2, 'CBD_IC50', 'Ctrl').to_csv('results/de_CBD_vs_PooledCtrl.csv')
    # calibration controls
    deseq_style(c, groups, 'DMSO', 'Untreated').to_csv('results/de_CTRL_Check_DMSO_vs_Untreated.csv')
    tested = set(c.index)
    for tag in ['CBD_vs_DMSO', 'CBD_vs_Untreated', 'CBD_vs_PooledCtrl']:
        de = pd.read_csv(f'results/de_{tag}.csv', index_col=0)
        sig = de[(de.padj < 0.05) & (de.log2FC.abs() > 0.5)]
        out.append(f"{tag}: DEG={len(sig)} UP={(sig.log2FC>0).sum()} DOWN={(sig.log2FC<0).sum()}")
    nul = pd.read_csv('results/de_CTRL_Check_DMSO_vs_Untreated.csv', index_col=0)
    nsig = nul[(nul.padj < 0.05) & (nul.log2FC.abs() > 0.5)]
    out.append(f"calibration NULL (DMSO vs Untreated): DEG={len(nsig)}")
    print(*out, sep='\n')
    go_final.main  # used via its __main__; replicate here:
    for tag in ['CBD_vs_DMSO', 'CBD_vs_Untreated', 'CBD_vs_PooledCtrl']:
        de = pd.read_csv(f'results/de_{tag}.csv', index_col=0)
        go_final.main(tag, de, tested, c)
    open('results/summary_run.txt', 'w').write('\n'.join(out) + f"\ntier={t}\n")

if __name__ == '__main__':
    main()
