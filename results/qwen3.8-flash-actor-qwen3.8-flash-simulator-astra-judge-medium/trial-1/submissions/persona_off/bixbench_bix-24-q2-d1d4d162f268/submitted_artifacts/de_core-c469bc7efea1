"""DESeq2-style NB DE core implemented in pure Python (numpy/scipy).
Tier-3 fallback: median-of-ratios size factors, MoM gene-wise dispersion,
fitted dispersion trend, approximate MAP shrinkage, NB2 Wald test."""
import numpy as np, pandas as pd
from scipy.stats import norm

def bh(p):
    p = np.asarray(p, float); n = len(p); o = np.argsort(p); q = np.empty(n)
    q[o] = np.minimum.accumulate((p[o]*n/np.arange(1, n+1))[::-1])[::-1]
    return np.minimum(q, 1.0)

def size_factors(K):
    """median-of-ratios; K genes x samples raw counts"""
    with np.errstate(divide='ignore'):
        lg = np.log(np.where(K > 0, K, np.nan))
    ok = np.all(np.isfinite(lg), axis=1)
    gm = np.nanmean(lg[ok], axis=1)                       # per-gene geometric mean
    ratios = lg[ok] - gm[:, None]
    return np.exp(np.median(ratios, axis=0))

def mom_dispersion(Q, group_labels):
    """gene-wise MoM dispersion on normalized counts Q=K/s (genes x samples)"""
    ng = Q.shape[0]; al = np.full(ng, np.nan); num = np.zeros(ng); den = np.zeros(ng)
    for g in np.unique(group_labels):
        cols = np.where(group_labels == g)[0]
        q = Q[:, cols]; m = q.mean(1); v = q.var(1, ddof=1)
        a = np.where(m > 0, (v - m)/np.maximum(m, 1e-12)**2, np.nan)
        w = len(cols) - 1
        good = np.isfinite(a) & (a > 1e-8)
        num[good] += w*a[good]; den[good] += w
    est = np.where(den > 0, num/np.maximum(den, 1e-12), np.nan)
    return est

def fit_trend(Qm, est):
    """alpha ~ a0 + a1/mean-parametric on binned medians (DESeq2-style)"""
    m = Qm.mean(1); good = np.isfinite(est) & (m > 0.5)
    if good.sum() < 100:
        return lambda x: 0.05 + 0.01/np.maximum(x, 1e-6)
    mg, eg = np.log10(m[good]), est[good]
    bins = np.linspace(mg.min(), mg.max(), 25)
    xs, ys = [], []
    for i in range(24):
        sel = (mg >= bins[i]) & (mg < bins[i+1])
        if sel.sum() >= 20:
            xs.append(10**((bins[i]+bins[i+1])/2)); ys.append(np.median(eg[sel]))
    xs, ys = np.array(xs), np.array(ys)
    A = np.column_stack([np.ones_like(xs), 1/xs])          # alpha = a0 + a1/mean
    coef, *_ = np.linalg.lstsq(A, ys, rcond=None)
    a0, a1 = max(coef[0], 1e-6), max(coef[1], 1e-6)
    return lambda x: a0 + a1/np.maximum(x, 1e-6)

def nb_wald(K, s, x, alpha):
    """NB2 GLM y~NB(mu_j=s_j*exp(b0+b1*x)); Newton-Raphson Wald test on b1.
    Returns log2FC(b1/ln2), z, p."""
    y = K.astype(float); X = np.column_stack([np.ones(len(x)), x])
    b = np.array([np.log(max(y.sum(), 1)/s.sum()), 0.0])
    ybar = y.mean(); b[0] = np.log(max(ybar,0.1)/s.mean())
    for _ in range(80):
        eta = np.clip(X @ b, -30, 30); mu = s*np.exp(eta)
        mu = np.clip(mu, 1e-8, None)
        w = mu/(1 + alpha*mu)                               # NB2 IRLS weight
        WX = X*w[:, None]
        H = X.T @ WX
        grad = X.T @ ((y - mu)/(1 + alpha*mu))
        try: step = np.linalg.solve(H + 1e-8*np.eye(2), grad)
        except np.linalg.LinAlgError: break
        if not np.all(np.isfinite(step)): break
        step = np.clip(step, -2, 2)
        b = b + step
        if np.max(np.abs(step)) < 1e-9: break
    eta = np.clip(X @ b, -30, 30); mu = np.clip(s*np.exp(eta), 1e-8, None)
    H = X.T @ (X*(mu/(1+alpha*mu))[:, None])
    try: se = np.sqrt(np.linalg.inv(H)[1, 1])
    except np.linalg.LinAlgError: se = np.nan
    zstat = b[1]/se if se and np.isfinite(se) else np.nan
    p = 2*norm.sf(abs(zstat)) if np.isfinite(zstat) else 1.0
    return b[1]/np.log(2), zstat, p

def deseq_style(counts, groups, treat, ctrl):
    """counts: genes x samples DataFrame; groups: Series aligned. Returns results df."""
    K = counts.values.astype(float)
    gl = groups.values
    keep2 = np.isin(gl, [treat, ctrl])
    K = K[:, keep2]; gl = gl[keep2]
    s = size_factors(K)
    Q = K/s
    est = mom_dispersion(Q, gl)
    trend = fit_trend(Q, est)
    qm = Q.mean(1)
    at = trend(qm)
    # approximate DESeq2 MAP shrinkage (prior var 0.2, gene df=4 -> w~4/9)
    w = 4/9
    la_g = np.where(np.isfinite(est) & (est > 1e-8), np.log(np.clip(est, 1e-8, 10)), np.nan)
    la_s = np.where(np.isfinite(la_g), w*la_g + (1-w)*np.log(at), np.log(at))
    alpha = np.clip(np.exp(la_s), 1e-6, 10)
    x = (gl == treat).astype(float)
    n = K.shape[0]
    lfc = np.zeros(n); zs = np.zeros(n); ps = np.ones(n)
    for i in range(n):
        lfc[i], zs[i], ps[i] = nb_wald(K[i], s, x, alpha[i])
    res = pd.DataFrame({'baseMean': qm,
                        'log2FC': lfc, 'pvalue': ps})
    res['padj'] = bh(res['pvalue'].values)
    res.index = counts.index
    return res.sort_values('padj')
