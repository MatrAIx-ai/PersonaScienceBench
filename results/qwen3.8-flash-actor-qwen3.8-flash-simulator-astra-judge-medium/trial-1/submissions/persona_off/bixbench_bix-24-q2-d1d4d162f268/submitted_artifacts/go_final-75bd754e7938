"""Final directional-metabolic verdict per contrast, 3+1 metrics.
Metrics: A Fisher ORA per direction (BH across term x direction);
 B binomial UP-vs-DOWN split within each set (null = global DEG up:down ratio);
 C Wilcoxon rank-sum of member log2FC vs all tested genes (signed)."""
import pandas as pd, numpy as np
from scipy.stats import fisher_exact, binomtest, mannwhitneyu
from de_core import bh

TERMS = {
 "glycolysis": ("GO:0006096","narrow",{"ENSG00000156515":"HK1","ENSG00000164081":"HK2","ENSG00000106617":"GPI","ENSG00000065629":"PFKP","ENSG00000135861":"PFKL","ENSG00000149925":"ALDOA","ENSG00000111667":"TPI1","ENSG00000111640":"GAPDH","ENSG00000102144":"PGK1","ENSG00000074800":"ENO1","ENSG00000149155":"PKM","ENSG00000134333":"LDHA","ENSG00000117394":"SLC2A1","ENSG00000157884":"SLC16A1","ENSG00000171314":"PGAM1"}),
 "TCA_cycle": ("GO:0006099","narrow",{"ENSG00000060762":"CS","ENSG00000148672":"ACO2","ENSG00000144852":"IDH2","ENSG00000138413":"IDH1","ENSG00000105953":"OGDH","ENSG00000117118":"SDHA","ENSG00000117121":"SDHB","ENSG00000091483":"FH","ENSG00000146701":"MDH2","ENSG00000131788":"MDH1"}),
 "oxidative_phosphorylation": ("GO:0006119","narrow",{"ENSG00000189043":"NDUFA4","ENSG00000166847":"UQCRC1","ENSG00000102755":"COX4I1","ENSG00000102758":"COX5A","ENSG00000152234":"ATP5F1A","ENSG00000135046":"CYCS"}),
 "fatty_acid_degradation": ("GO:0019395","narrow",{"ENSG00000072786":"CPT1A","ENSG00000072398":"CPT2","ENSG00000198703":"ACADVL","ENSG00000068001":"ACOX1","ENSG00000143524":"ECHS1","ENSG00000111563":"ACADS"}),
 "cholesterol_biosynthesis": ("GO:0006695","broad",{"ENSG00000112972":"HMGCS1","ENSG00000113161":"HMGCR","ENSG00000110921":"MVK","ENSG00000084233":"MVD","ENSG00000163344":"FDFT1","ENSG00000104549":"SQLE","ENSG00000167884":"LSS","ENSG00000116133":"DHCR24","ENSG00000186480":"INSIG1","ENSG00000130164":"LDLR","ENSG00000198431":"SREBF2","ENSG00000141644":"MSMO1","ENSG00000147256":"IDI1","ENSG00000112332":"FDPS"}),
 "fatty_acid_biosynthesis": ("GO:0006633","broad",{"ENSG00000169764":"FASN","ENSG00000099194":"SCD","ENSG00000067052":"ACLY","ENSG00000178795":"ELOVL6","ENSG00000099115":"SREBF1"}),
 "amino_acid_onecarbon": ("GO:0006520","broad",{"ENSG00000128272":"ATF4","ENSG00000104435":"ASNS","ENSG00000141810":"PHGDH","ENSG00000104064":"PSAT1","ENSG00000006747":"SHMT2","ENSG00000065911":"MTHFD2","ENSG00000163933":"CTH","ENSG00000136504":"CBS","ENSG00000151012":"SLC7A11","ENSG00000132434":"SLC7A5","ENSG00000101255":"TRIB3","ENSG00000162772":"ATF3","ENSG00000177000":"MTHFR","ENSG00000185010":"DHFR"}),
 "cell_cycle": ("GO:0007049","control",{"ENSG00000170312":"CDK1","ENSG00000134057":"CCNB1","ENSG00000145386":"CCNA2","ENSG00000166851":"PLK1","ENSG00000087586":"AURKA","ENSG00000131747":"TOP2A","ENSG00000148773":"MKI67","ENSG00000166843":"BUB1","ENSG00000131300":"CCNB2","ENSG00000117399":"CDC20","ENSG00000117724":"CENPF","ENSG00000109046":"UBE2C","ENSG00000129514":"FOXM1"}),
 "apoptosis": ("GO:0006915","control",{"ENSG00000087088":"BAX","ENSG00000171791":"BCL2","ENSG00000171552":"BCL2L1","ENSG00000015171":"BAK1","ENSG00000141510":"TP53","ENSG00000124762":"CDKN1A","ENSG00000164305":"CASP3","ENSG00000139187":"CASP7","ENSG00000075076":"CASP9","ENSG00000026103":"FAS","ENSG00000175197":"DDIT3","ENSG00000187098":"BBC3"}),
 "innate_immune_IFN": ("GO:0006954","control",{"ENSG00000115415":"STAT1","ENSG00000187608":"ISG15","ENSG00000185745":"IFIT1","ENSG00000157601":"MX1","ENSG00000179156":"IFI6","ENSG00000166710":"B2M","ENSG00000107159":"DDX58","ENSG00000173039":"RELA","ENSG00000137203":"DDX60"}),
}

def main(tag, de, tested, counts_tested):
    lg = np.log2(counts_tested+1)
    deg = de[(de.padj<0.05)&(de.log2FC.abs()>0.5)]
    up, dn = set(deg[deg.log2FC>0].index), set(deg[deg.log2FC<0].index)
    N=len(tested); rows=[]
    for name,(go,tier,members) in TERMS.items():
        # co-expression QC of added IDs: keep members with |corr| >= 0.5 to set median profile
        ids=[g for g in members if g in tested]
        keep_ids=ids
        if len(ids)>=4:
            prof=lg.loc[ids].median(axis=0)
            keep_ids=[g for g in ids if abs(np.corrcoef(lg.loc[g],prof)[0,1])>=0.5]
        gset=set(keep_ids)
        if len(gset)<4: continue
        # metric C: signed mean log2FC shift
        mfc=de.loc[list(gset),'log2FC']
        u,pC=mannwhitneyu(mfc, de['log2FC'], alternative='two-sided')
        for direction,dset in (("UP",up),("DOWN",dn)):
            k=len(gset&dset); n=len(dset)
            _,p=fisher_exact([[k,len(gset)-k],[n-k,N-len(gset)-n+k]],alternative="greater")
            rows.append(dict(term=name,go=go,tier=tier,direction=direction,set_size=len(gset),
                             k=k,fold=(k/max(len(gset),1))/(n/N),p=p,
                             mean_lfc=mfc.mean(),wilcoxon_p=pC))
    r=pd.DataFrame(rows); r['padj_ORA']=bh(r['p'].values)
    # metric B: up-vs-down split within set
    brow=[]
    tot_up,tot_dn=len(up),len(dn)
    for name,(go,tier,members) in TERMS.items():
        gset=set(g for g in members if g in tested)
        ku,kd=len(gset&up),len(gset&dn)
        if ku+kd==0: continue
        pb=binomtest(ku,ku+kd,tot_up/(tot_up+tot_dn)).pvalue
        brow.append(dict(term=name,tier=tier,up=ku,down=kd,p_binom=pb))
    b=pd.DataFrame(brow); b['padj_binom']=bh(b['p_binom'].values)
    r.to_csv(f'results/go_final_{tag}.csv',index=False); b.to_csv(f'results/go_binom_{tag}.csv',index=False)
    print(f"\n===== {tag}: DEG UP {tot_up} DOWN {tot_dn} =====")
    piv=r.pivot_table(index='term',columns='direction',values=['k','padj_ORA']).round(3)
    print(piv)
    print("mean log2FC per set (signed) + Wilcoxon p:")
    print(r[r.direction=='UP'].set_index('term')[['mean_lfc','wilcoxon_p','tier']].round(3).sort_values('mean_lfc').to_string())
    print("binomial UP-vs-DOWN within set:")
    print(b[['term','tier','up','down','p_binom','padj_binom']].round(4).to_string(index=False))

if __name__=="__main__":
    cnt=pd.read_csv('data/counts_raw_unfiltered.csv',index_col=0)
    keep=(cnt>=5).sum(axis=1)>=3; ct=cnt.loc[keep]
    tested=set(ct.index)
    for tag in ["CBD_vs_DMSO","CBD_vs_Untreated","CBD_vs_PooledCtrl"]:
        de=pd.read_csv(f'results/de_{tag}.csv',index_col=0)
        main(tag,de,tested,ct)
