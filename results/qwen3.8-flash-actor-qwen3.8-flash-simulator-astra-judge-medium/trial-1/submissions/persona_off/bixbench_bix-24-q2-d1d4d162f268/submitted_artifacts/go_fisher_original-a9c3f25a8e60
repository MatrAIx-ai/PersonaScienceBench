def run(de_table, tested, tag):
    deg = de_table[(de_table.padj < 0.05) & (de_table.log2FC.abs() > 0.5)]
    up, dn = set(deg[deg.log2FC > 0].index), set(deg[deg.log2FC < 0].index)
    N = len(tested); rows = []
    for name,(go,tier,members) in TERMS.items():
        gset = set(members) & tested
        if len(gset) < 4: continue
        for direction, dset in (("UP",up),("DOWN",dn)):
            k = len(gset & dset); n = len(dset)
            odds, p = fisher_exact([[k, len(gset)-k],[n-k, N-len(gset)-n+k]], alternative="greater")
            rows.append(dict(term=name, go=go, tier=tier, direction=direction,
                             set_size=len(gset), n_deg=n, k=k,
                             fold=(k/len(gset))/(n/N), p=p))
    r = pd.DataFrame(rows)
    r["padj"] = bh(r["p"].values)
    r.to_csv(f"results/go_fisher_{tag}.csv", index=False)
    return r

def coherence(counts_tested):
    """validate curated IDs: members of a term should co-express across 30 samples"""
    lg = np.log2(counts_tested+1)
    out=[]
    rng = np.random.default_rng(0)
    base = np.mean([np.corrcoef(lg.loc[rng.choice(counts_tested.index,6,replace=False)])[np.triu_indices(6,1)].mean() for _ in range(60)])
    for name,(go,tier,members) in TERMS.items():
        ids=[g for g in members if g in lg.index]
        c=np.corrcoef(lg.loc[ids])[np.triu_indices(len(ids),1)].mean()
        out.append((name,len(ids),round(c,3)))
    return base, out

