import os, sys, json
import pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from rds_extract import read_de_rds

pd.set_option('display.width', 200)
FILES = {'GluFevsGluFePlus': 'data/res_GluFevsGluFePlus.rds',
         'SuccvsGluFePlus':  'data/res_SuccvsGluFePlus.rds'}
os.makedirs('out', exist_ok=True)
tables = {}
for name, p in FILES.items():
    df, meta = read_de_rds(p)
    tables[name] = df
    df.to_csv(f'out/{name}.csv')
    n = len(df)
    down = (df.log2FoldChange <= -1.5) & (df.padj < 0.05)
    up   = (df.log2FoldChange >=  1.5) & (df.padj < 0.05)
    print(f"\n### {name}  ({p})")
    print(" class attr:", meta['class_'], "| slots/attrs:", sorted(set(t for _, t in meta['tags'])))
    print(" RDS:", meta['rds_version'], meta['writer'], meta['charset'])
    print(" columns:", list(df.columns))
    print(" rows:", n, "| unique gene IDs:", df.index.nunique(), "| duplicated IDs:", n-df.index.nunique())
    print(" padj NA:", int(df.padj.isna().sum()), "| pvalue NA:", int(df.pvalue.isna().sum()),
          "| baseMean NA:", int(df.baseMean.isna().sum()))
    print(" baseMean == 0:", int((df.baseMean == 0).sum()),
          "| genes with padj<0.05:", int((df.padj < 0.05).sum()))
    print(" DOWN (lfc<=-1.5 & padj<0.05):", int(down.sum()),
          "| UP (lfc>=1.5 & padj<0.05):", int(up.sum()))
    print("   lfc<=-1.5 regardless of padj:", int((df.log2FoldChange <= -1.5).sum()))
    print("   padj<0.05 & lfc<=-1.5 (padj NA excluded from count; NAs in that lfc set:",
          int((df.log2FoldChange.le(-1.5) & df.padj.isna()).sum()), ")")
    print(" lfc range: %.2f .. %.2f ; padj range: %.3g .. %.3g" % (
        df.log2FoldChange.min(), df.log2FoldChange.max(),
        df.padj[~df.padj.isna()].min(), df.padj[~df.padj.isna()].max()))
    print(" ID examples:", list(df.index[:5]))
    print(" ID pattern: PA14_ prefix for all rows:", bool(df.index.str.match(r'^PA14_\d{5}$').all()))
    print(" down examples:", list(df.index[down])[:5])

a, b = tables['GluFevsGluFePlus'], tables['SuccvsGluFePlus']
sa, sb = set(a.index), set(b.index)
print("\n### gene universes")
print(" identical index order:", bool((a.index == b.index).all()))
print(" identical sets:", sa == sb, "| intersection:", len(sa & sb), "| only in GluFe:", len(sa-sb), "| only in Succ:", len(sb-sa))
da = set(a.index[(a.log2FoldChange <= -1.5) & (a.padj < 0.05)])
db = set(b.index[(b.log2FoldChange <= -1.5) & (b.padj < 0.05)])
print(" down sets:", len(da), len(db), "| shared down genes:", len(da & db),
      "| Jaccard: %.3f" % (len(da & db)/len(da | db)))
print(" ID style is PA14 (UCBPP-PA14) locus tags -> KEGG 'paer' is PAO1 (PA#### numbers)")
json.dump({k: {'n': len(v), 'down': int(((v.log2FoldChange <= -1.5) & (v.padj < 0.05)).sum()),
               'padj_na': int(v.padj.isna().sum())} for k, v in tables.items()},
          open('out/inspection.json', 'w'), indent=1)
print("\nwrote out/*.csv, out/inspection.json")
