"""Extract DESeq2 DESeqResults (S4) tables saved by saveRDS (RDS v3, XDR) without R.

Pure-Python reader specialised to the layout produced by DESeq2::results() +
saveRDS(): an RS4 object whose slot attribute list carries
  rowNames/rownames -> STRSXP of gene IDs
  elementMetadata   -> DataFrame whose data is a VECSXP of REALSXP columns,
                       with a trailing `names` attribute giving column order.
Verification is structural: every parsed token is checked, column vectors must be
contiguous REALSXP of length nrow, and the trailing names attribute must have
exactly as many entries as columns found.
"""
import gzip, struct, math, sys, os, re
import pandas as pd

NA_REAL_BITS = 0x7ff00000000007a2
NILVALUE = 254

def decomp(path):
    d = open(path, 'rb').read()
    if d[:2] == b'\x1f\x8b':
        return gzip.decompress(d)
    return d

class Stream:
    def __init__(self, b):
        self.b = b; self.i = 0; self.reflist = []
    def int(self):
        v = struct.unpack_from('>i', self.b, self.i)[0]; self.i += 4; return v
    def peek_int(self):
        return struct.unpack_from('>i', self.b, self.i)[0]
    def string(self):
        """CHARSXP payload: flags int (type 9) + length + bytes"""
        flags = self.int()
        assert (flags & 0xff) == 9, (hex(flags), self.i-4)
        n = self.int()
        s = self.b[self.i:self.i+n].decode('utf-8', 'replace'); self.i += n
        self.reflist.append(('str', s))
        return s
    def real_vec(self):
        flags = self.int(); assert (flags & 0xff) == 14, hex(flags)
        n = self.int()
        vals = list(struct.unpack_from('>%dd' % n, self.b, self.i)); self.i += 8*n
        out = []
        for v in vals:
            out.append(float('nan') if math.isnan(v) else v)   # R NA_real_ -> NaN
        return out
    def str_vec(self):
        flags = self.int(); assert (flags & 0xff) == 16, hex(flags)
        n = self.int()
        return [self.string() for _ in range(n)]

def read_de_rds(path, verbose=True):
    st = Stream(decomp(path))
    magic = st.b[:2]; assert magic == b'X\n', magic
    st.i = 2
    ver = st.int(); writer = st.int(); nat = st.int(); nch = st.int()
    charset = st.b[st.i:st.i+nch].decode(); st.i += nch
    if verbose:
        print(f"  RDS v{ver} writer=0x{writer:x} nat=0x{nat:x} charset={charset}")

    # --- attribute / slot tag names present in the stream (SYMSXP tags), for reporting
    tagpat = re.compile(re.escape(struct.pack('>II', 1, 0x00040009)))
    tags = []
    for m in tagpat.finditer(st.b):
        q = m.end(); n = struct.unpack_from('>i', st.b, q)[0]
        if 0 < n < 40:
            nm = st.b[q+4:q+4+n].decode('utf-8', 'replace')
            if nm.isprintable() and (nm[0].isalpha() or nm == 'row.names'):
                tags.append((m.start(), nm))
    if verbose:
        print("  attribute/slot tags in stream:", [t for _, t in tags])

    # --- row names: value object follows the SYMSXP tag 'rownames'/'rowNames'
    key = None
    for cand in (b'\x00\x00\x00\x08rownames', b'\x00\x00\x00\x08rowNames'):
        k = st.b.find(cand)
        if k >= 0:
            key = k + len(cand); break
    assert key is not None, 'rownames attribute not found'
    st.i = key
    row_names = st.str_vec()
    nrows = len(row_names)
    if verbose:
        print(f"  rowNames: n={nrows} first={row_names[:3]} last={row_names[-1]}")
    # skip intermediate bookkeeping objects until the contiguous column block:
    # scan forward for the first REALSXP header whose length == nrows, then require
    # that subsequent columns follow contiguously with header len == nrows.
    pat = struct.pack('>I', 0x0000000e) + struct.pack('>i', nrows)
    pos = st.b.find(pat, st.i)
    assert pos >= 0, 'column block not found'
    cols = []
    while True:
        assert st.b[pos:pos+8] == pat, (pos, st.b[pos:pos+8].hex(' '))
        vals = list(struct.unpack_from('>%dd' % nrows, st.b, pos+8))
        vals = [float('nan') if math.isnan(v) else v for v in vals]
        cols.append(vals)
        pos += 8 + 8*nrows
        if st.b[pos:pos+8] == pat:
            continue
        break
    if verbose: print(f"  numeric columns found: {len(cols)} (contiguous, each n={nrows})")

    # trailing attribute block: find the `names` STRSXP giving column names
    tail = st.b[pos:]
    names = None
    tp = tail.find(struct.pack('>I', 0x00000010) + struct.pack('>i', len(cols)))
    if tp >= 0:
        s = Stream(tail); s.i = tp
        names = s.str_vec()
    if names is None:
        raise RuntimeError('column names attribute not found')
    # class / package of the S4 object
    cls = None
    cp = tail.find(struct.pack('>I', 0x00000210) + struct.pack('>i', 1))
    if cp >= 0:
        s = Stream(tail); s.i = cp
        cls = s.str_vec()
    if verbose:
        print(f"  names attr: {names}")
        print(f"  class attr: {cls}")
        print(f"  bytes consumed {pos} of {len(st.b)}")
    assert len(names) == len(cols)
    df = pd.DataFrame({n: c for n, c in zip(names, cols)}, index=row_names)
    df.index.name = 'gene'
    return df, dict(class_=cls, tags=tags, rds_version=ver,
                    writer=hex(writer), charset=charset, ncols=len(cols))

if __name__ == '__main__':
    for p in sys.argv[1:]:
        print('==', p)
        df, meta = read_de_rds(p)
        print(df.head(3))
        print(df.shape)
