#!/usr/bin/env python3
"""Run this IN A CONNECTED SHELL to produce the KEGG mapping artifact for
scripts/enrich_kegg_ora.py, then copy the files into data/ of the analysis workspace.

Writes (under --outdir, default data/):
  kegg_link_<org>_pathway.txt   raw output of  GET /link/<org>/pathway
  kegg_<org>_genes.tsv          raw output of  GET /list/<org>   (locus tags / synonyms;
                                this is what makes PA14_xxxxx -> KEGG gene ids verifiable)
  kegg_pathway_titles.tsv       paXXXXXX <TAB> pathway title (GET /list/pathway/<org>)
  kegg_mapping_provenance.json  URL + retrieval UTC + sha256 + byte count for each file

Default organisms: paer (P. aeruginosa PAO1, the code named in the question) and
pau (UCBPP-PA14, the strain the DE tables actually use). Pathway IDs paXXXXXX are a
shared ID space, so the two link tables can be pooled or used separately.
"""
import argparse, datetime, hashlib, json, os, sys, urllib.request

BASE = 'https://rest.kegg.jp'


def get(path, outdir, fname):
    url = BASE + path
    with urllib.request.urlopen(url, timeout=120) as r:
        body = r.read()
    fp = os.path.join(outdir, fname)
    open(fp, 'wb').write(body)
    return {'url': url, 'retrieved_utc': datetime.datetime.now(datetime.timezone.utc)
            .strftime('%Y-%m-%dT%H:%M:%SZ'), 'bytes': len(body),
            'sha256': hashlib.sha256(body).hexdigest(), 'file': fp,
            'lines': body.count(b'\n')}


if __name__ == '__main__':
    ap = argparse.ArgumentParser()
    ap.add_argument('--org', nargs='+', default=['paer', 'pau'])
    ap.add_argument('--outdir', default='data')
    a = ap.parse_args()
    os.makedirs(a.outdir, exist_ok=True)
    rec = []
    for org in a.org:
        rec.append(get(f'/link/{org}/pathway', a.outdir, f'kegg_link_{org}_pathway.txt'))
        rec.append(get(f'/list/{org}', a.outdir, f'kegg_{org}_genes.tsv'))
        rec.append(get(f'/list/pathway/{org}', a.outdir, f'kegg_pathway_titles_{org}.tsv'))
    json.dump({'kegg_rest_base': BASE, 'files': rec}, open(
        os.path.join(a.outdir, 'kegg_mapping_provenance.json'), 'w'), indent=1)
    print(json.dumps(rec, indent=1))
    print('\nNow run:  python3 scripts/enrich_kegg_ora.py --org paer')
