"""Audit which KEGG mapping sources are reachable. Writes out/mapping_provision.json.

Records: DNS attempts, HTTPS/HTTP GET of the KEGG REST link endpoint, route table,
and a filesystem sweep for any offline KEGG-derived artifact (*.gmt, KEGGREST/gseapy
caches, R/Bioconductor libraries, files containing paXXXXXX pathway IDs).
Nothing here is optional to the final answer: the enrichment must abort if no
verifiable mapping source is found.
"""
import json, os, re, socket, struct, subprocess, sys, time, urllib.request

OUT = 'out/mapping_provision.json'
URLS = ['https://rest.kegg.jp/link/paer/pathway',
        'http://rest.kegg.jp/link/paer/pathway',
        'https://rest.kegg.jp/link/pau/pathway',
        'https://rest.kegg.jp/list/paer']
HOSTS = ['rest.kegg.jp', 'www.kegg.jp', 'rest.genome.jp', 'pypi.org']
SEARCH_ROOTS = ['/workspace', '/usr', '/opt', '/srv', '/etc', '/var/lib', '/home', '/tmp']
NAME_PAT = re.compile(r'\.(gmt|GMT)$|kegg|pauer|paer|pau_|gss\.gtf', re.I)
CONTENT_PAT = re.compile(rb'path:pa\d{5}|pa0\d{4}\b')
MAX_SCAN_BYTES = 200 * 1024 * 1024      # per-file cap for content sniffing
TIME_BUDGET_S = 300


def net_audit():
    res = {'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'dns': {}, 'http': {}, 'route': {}}
    for h in HOSTS:
        try:
            res['dns'][h] = socket.gethostbyname(h)
        except Exception as e:
            res['dns'][h] = f'FAIL {type(e).__name__}: {e}'
    for u in URLS:
        try:
            with urllib.request.urlopen(u, timeout=10) as r:
                body = r.read()
            res['http'][u] = f'OK {r.status} {len(body)} bytes'
        except Exception as e:
            res['http'][u] = f'FAIL {type(e).__name__}: {e}'
    try:
        with open('/proc/net/route') as fh:
            lines = [l.split('\t') for l in fh.read().splitlines()[1:]]
        res['route']['n_routes'] = len(lines)
        res['route']['destinations'] = [l[0] for l in lines][:10]
    except Exception as e:
        res['route']['error'] = str(e)
    try:
        with open('/proc/net/dev') as fh:
            res['route']['interfaces'] = [l.split(':')[0].strip() for l in fh.read().splitlines()[2:]]
    except Exception as e:
        res['route']['interfaces_error'] = str(e)
    res['proxy_env'] = {k: v for k, v in os.environ.items() if 'proxy' in k.lower()}
    return res


def fs_audit():
    found, scanned_files, bytes_scanned = [], 0, 0
    t0 = time.time()
    for root in SEARCH_ROOTS:
        for dirpath, dirnames, filenames in os.walk(root, onerror=lambda e: None):
            if time.time() - t0 > TIME_BUDGET_S:
                return {'truncated': True, 'elapsed_s': round(time.time()-t0, 1),
                        'scanned_files': scanned_files, 'hits': found}
            for fn in filenames:
                p = os.path.join(dirpath, fn)
                scanned_files += 1
                if NAME_PAT.search(fn):
                    found.append({'path': p, 'why': 'filename'})
                    continue
                try:
                    sz = os.path.getsize(p)
                except OSError:
                    continue
                if sz < 8 or sz > MAX_SCAN_BYTES or fn.endswith(('.so', '.a', '.pyc', '.jar', '.png', '.jpg', '.gz', '.bz2', '.xz', '.ttf', '.woff')):
                    continue
                if bytes_scanned + sz > 3 * 1024 ** 3:
                    continue
                try:
                    with open(p, 'rb') as fh:
                        chunk = fh.read(min(sz, 4 * 1024 * 1024))
                    bytes_scanned += len(chunk)
                    if CONTENT_PAT.search(chunk):
                        found.append({'path': p, 'why': 'content:paXXXXXX'})
                except OSError:
                    pass
    return {'truncated': False, 'elapsed_s': round(time.time()-t0, 1),
            'scanned_files': scanned_files, 'hits': found}


if __name__ == '__main__':
    report = {'network': net_audit()}
    print('network:', json.dumps(report['network'], indent=1))
    if '--fs' in sys.argv:
        report['filesystem'] = fs_audit()
        print('filesystem: scanned %d files in %.1fs, truncated=%s, hits=%d'
              % (report['filesystem']['scanned_files'], report['filesystem']['elapsed_s'],
                 report['filesystem']['truncated'], len(report['filesystem']['hits'])))
        for h in report['filesystem']['hits'][:20]:
            print('  hit', h)
    os.makedirs('out', exist_ok=True)
    with open(OUT, 'w') as fh:
        json.dump(report, fh, indent=1)
    print('wrote', OUT)
