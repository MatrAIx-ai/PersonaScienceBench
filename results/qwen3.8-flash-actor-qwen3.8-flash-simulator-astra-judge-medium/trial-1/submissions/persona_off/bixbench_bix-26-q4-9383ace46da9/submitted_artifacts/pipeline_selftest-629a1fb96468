"""Prove the ORA pipeline is correct WITHOUT any biological claim.

The pathway->gene mapping here is SYNTHETIC (genes assigned to fake paXXXXXX ids by a
seeded RNG). It exists only to verify: (a) the RDS reader, (b) the hypergeometric p-value
(recomputed independently with exact math.comb enumeration), (c) BH correction
(reimplemented by hand), (d) the 'common pathway' intersection logic, (e) the output
schema. It must never be used to answer the biology question.
Writes only to out/selftest/ so it cannot contaminate the real deliverables.
"""
import json, math, os, subprocess, sys
import pandas as pd

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
sys.path.insert(0, 'scripts')
import numpy as np
from rds_extract import read_de_rds

# ---------- build a deterministic synthetic mapping over the REAL gene IDs ----------
de = {n: read_de_rds(f, verbose=False)[0] for n, f in
      {'GluFevsGluFePlus': 'data/res_GluFevsGluFePlus.rds',
       'SuccvsGluFePlus': 'data/res_SuccvsGluFePlus.rds'}.items()}
universe = sorted(set.intersection(*[set(d.index) for d in de.values()]))
rng = np.random.default_rng(7)
ann = sorted(rng.choice(universe, size=1200, replace=False))          # "annotated" genes
down = {n: sorted(d.index[(d.log2FoldChange <= -1.5) & (d.padj < 0.05)]) for n, d in de.items()}
d1, d2 = [g for g in down['GluFevsGluFePlus'] if g in ann], [g for g in down['SuccvsGluFePlus'] if g in ann]

sets = {}
sets['pa00020'] = sorted(set(ann[:120]) | set(d1[:25]) | set(d2[:40]))   # shared strong
sets['pa00071'] = sorted(set(ann[120:260]) | set(d2[:30]))               # contrast-2 only
sets['pa00860'] = sorted(set(ann[260:380]) | set(d1[:20]))               # contrast-1 only
sets['pa00100'] = sorted(set(ann[380:430]) | set(d1[20:24]) | set(d2[40:44]))  # marginal
sets['pa01100'] = sorted(set(ann[430:1150]))                             # huge generic set
os.makedirs('tests', exist_ok=True)
with open('tests/synthetic_control.gmt', 'w') as fh:
    for k, v in sets.items():
        fh.write(f'{k}\tSYNTHETIC_CONTROL\t' + '\t'.join(v) + '\n')
with open('tests/synthetic_control.titles.tsv', 'w') as fh:
    for k in sets:
        fh.write(f'{k}\tSYNTHETIC set {k}\n')
# the pipeline only auto-loads titles next to --mapping <base>.txt|gmt

r = subprocess.run([sys.executable, 'scripts/enrich_kegg_ora.py',
                    '--mapping', 'tests/synthetic_control.gmt',
                    '--outdir', 'out/selftest'], capture_output=True, text=True)
print(r.stdout[-2500:]); print(r.stderr[-1500:])
assert r.returncode == 0, 'pipeline failed on the synthetic control'

# ---------- independent verification of the numbers ----------
def exact_p(k, N, K, n):
    """P[X >= k] for X ~ Hypergeometric(N, K, n), exact integer arithmetic."""
    return sum(math.comb(K, i) * math.comb(N - K, n - i) for i in range(k, min(K, n) + 1)) / \
           math.comb(N, n)

def bh(p):
    order = sorted(range(len(p)), key=lambda i: p[i])
    m = len(p); out = [0.0] * m; prev = 1.0
    for rank, i in enumerate(reversed(order), start=1):
        k = m - rank + 1
        prev = min(prev, p[i] * m / k)
        out[i] = prev
    return out

bg_genes = sorted(set(ann) & set().union(*[set(v) for v in sets.values()]))
bg = len(bg_genes)
exp = {}
for pw, gs in sets.items():
    K = len(set(gs) & set(bg_genes))
    for cname, dl in (('GluFevsGluFePlus', d1), ('SuccvsGluFePlus', d2)):
        q = [g for g in dl if g in bg_genes]; k = len(set(q) & set(gs))
        exp[(cname, pw)] = (K, len(q), k, exact_p(k, bg, K, len(q)) if k else 1.0)

fail = 0
for cname in de:
    got = pd.read_csv(f'out/selftest/enrichment_{cname}.csv')
    assert got.bg_universe.iloc[0] == bg, 'background size mismatch'
    for _, row in got.iterrows():
        K, n, k, p = exp[(cname, row.pathway)]
        ok = (row.bg_size == K and row.query_size == n and row.overlap == k
              and abs(row.pvalue - p) <= 1e-12 * max(1.0, p))
        if not ok:
            fail += 1
            print('MISMATCH', cname, row.pathway, (row.bg_size, row.query_size, row.overlap, row.pvalue),
                  (K, n, k, p))
    man = bh(list(got.sort_values('pvalue').pvalue))
    recomputed = pd.DataFrame({'pathway': got.sort_values('pvalue').pathway, 'padj_manual': man})
    merged = got.sort_values('pvalue').merge(recomputed, on='pathway')
    dmax = (merged.padj - merged.padj_manual).abs().max()
    print(f'{cname}: rows={len(got)} max|padj_pipeline - padj_manual| = {dmax:.3g}')
    assert dmax < 1e-12, 'BH mismatch'

prov = json.load(open('out/selftest/mapping_provenance.json'))
sig = {c: set(pd.read_csv(f'out/selftest/enrichment_{c}.csv').query('padj < 0.05').pathway) for c in de}
manual_common = sorted(sig['GluFevsGluFePlus'] & sig['SuccvsGluFePlus'])
print('pipeline n_common      =', prov['n_common'], prov['common_pathways'])
print('manual   n_common      =', len(manual_common), manual_common)
assert prov['n_common'] == len(manual_common) and prov['common_pathways'] == manual_common
assert int(open('out/selftest/ANSWER.txt').read().split()[0]) == len(manual_common)
assert len(pd.read_csv('out/selftest/common_pathways.csv')) == len(manual_common)
sens = pd.read_csv('out/selftest/sensitivity.csv')
assert len(sens) == 6 and set(sens.variant) == {'primary_annotated_background',
                                                'all_kegg_genes_background',
                                                'primary_minGSSize10_max500'}
print(sens.to_string(index=False))
print('\nSELFTEST: %d p-value mismatches (expected 0); all assertions passed' % fail)
assert fail == 0
