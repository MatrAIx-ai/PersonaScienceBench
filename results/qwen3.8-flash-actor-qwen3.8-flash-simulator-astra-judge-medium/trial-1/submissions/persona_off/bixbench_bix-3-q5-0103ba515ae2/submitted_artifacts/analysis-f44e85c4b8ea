#!/usr/bin/env python
"""
bix-3-q5 :: Differential expression of three tissue comparisons with a BINOMIAL EXACT TEST (5% threshold)
Capsule  :: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
Question :: which tissue comparison shows negligible effects?

Layout (verified in the inspection pass)
  NormCount : header row 4; data rows 5-25406 (25,402 genes x 90 samples)
              C1 Index, C2 GeneID, C3:C32 baseline blood, C33:C62 dentate gyrus, C63:C92 final blood
              values are DESeq2-style (size-factor) NORMALIZED counts (68.8% non-integer)
  Mapping_statistics : 90 rows in Index_DESeq order == NormCount column order;
              Code == NormCount header; subject id parsed from Sample ID -> 30 subjects,
              each contributing baseline blood + dentate gyrus + final blood (paired design)

PRIMARY TEST (fixed by the researcher)
  per gene, two-sided exact binomial (scipy.stats.binomtest) on rounded normalized counts
      k  = round(sum counts arm A) ; n = k + round(sum counts arm B)
      p0 = N_A/(N_A+N_B)           (library-size-proportional null)
  HEADLINE threshold = nominal p < 0.05 ; BH-FDR < 0.05 reported alongside.
  Primary run = all 90 libraries, all 25,402 genes, responder status pooled, no filtering.
Variants (diagnostics only, do not change the headline)
  V1 p0 = 0.5                      V2 paired per-subject sign test (30 subjects)
  V3 outlier library dropped       V4 expressed-only (mean normalized count >= 1 in both arms)
  V5 per-contrast median-of-ratios re-normalisation + primary test  (is the hit rate a normalisation artefact?)
  V6 replicate-aware Welch t-test on log2 counts + BH               (how much of the hit rate is the missing dispersion term?)
"""
import os, pickle, time
import numpy as np, pandas as pd
from scipy.stats import binomtest, ttest_ind, ttest_rel
from statsmodels.stats.multitest import multipletests

XLSX = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
CACHE, OUT = 'work', 'work/results'
os.makedirs(OUT, exist_ok=True)
LOG = open(os.path.join(OUT, 'run_log.txt'), 'w')
def P(*a):
    s = '\n'.join(str(x) for x in a)
    print(s); LOG.write(s + '\n\n'); LOG.flush()

# ------------------------------------------------------------------ 1. load
if not (os.path.exists(f'{CACHE}/X.npy') and os.path.exists(f'{CACHE}/meta.pkl')):
    import openpyxl
    ws = openpyxl.load_workbook(XLSX, read_only=True, data_only=True)['NormCount']
    rows = list(ws.iter_rows(values_only=True))
    np.save(f'{CACHE}/X.npy', np.array([[float(v) for v in r[2:92]] for r in rows[4:]], dtype=np.float64))
    pickle.dump({'genes': np.array([str(r[1]) for r in rows[4:]], dtype=object),
                 'samples': np.array([str(h) for h in rows[3][2:92]])}, open(f'{CACHE}/meta.pkl', 'wb'))
X = np.load(f'{CACHE}/X.npy'); meta = pickle.load(open(f'{CACHE}/meta.pkl', 'rb'))
genes, samples = meta['genes'], meta['samples']
assert X.shape == (25402, 90) and len(genes) == 25402 and len(samples) == 90
assert not np.isnan(X).any() and (X >= 0).all() and len(set(genes)) == len(genes)

ms = pd.read_excel(XLSX, sheet_name='Mapping_statistics')
ms['subject'] = ms['Sample ID'].str.extract(r'_02_\d+_(\d+)_\w+$')[0]
ms['ridx'] = ms['Code'].str.extract(r'(\d+)$')[0].astype(int)
ms = ms.set_index('Code').loc[samples]
assert list(ms['Index_DESeq']) == list(range(1, 91))
md = ms.reset_index(drop=True)
md['pair'] = md['Response'] + '_' + md['ridx'].astype(str)
TISSUES = ['baseline_blood', 'dentate_gyrus', 'final_blood']
grp = {t: np.where(md['Tissue'].values == t)[0] for t in TISSUES}
assert all(len(v) == 30 for v in grp.values())
assert (md.groupby(['Response', 'ridx'])['subject'].nunique() == 1).all()   # pairing consistent
pairs = sorted(md['pair'].unique()); assert len(pairs) == 30
PAIR_IDX = {t: np.array([grp[t][md['pair'].values[grp[t]] == s][0] for s in pairs]) for t in TISSUES}
OUTLIER = 'Control_dentate_gyrus5'

# ------------------------------------------------------------------ 2. tests
def binom_primary(A, B, p0_mode='library'):
    sA, sB = np.rint(A.sum(1)), np.rint(B.sum(1))
    k = sA.astype(np.int64); n = (sA + sB).astype(np.int64)
    NA, NB = A.sum(), B.sum()
    p0 = NA / (NA + NB) if p0_mode == 'library' else 0.5
    p = np.full(len(k), np.nan)
    nz = np.where(n > 0)[0]
    for i in nz:
        p[i] = binomtest(int(k[i]), int(n[i]), p0, alternative='two-sided').pvalue
    return dict(p=p, k=k, n=n, p0=p0, libA=NA, libB=NB)

def paired_sign(A, B):
    gt, disc = (A > B).sum(1), (A != B).sum(1)
    p = np.full(A.shape[0], np.nan)
    for i in np.where(disc > 0)[0]:
        p[i] = binomtest(int(gt[i]), int(disc[i]), 0.5, alternative='two-sided').pvalue
    return dict(p=p, n=disc, p0=0.5)

def welch(A, B):                        # replicate-aware reference (not the headline test)
    la, lb = np.log2(A + 0.5), np.log2(B + 0.5)
    t, p = ttest_ind(la, lb, axis=1, equal_var=False)
    return dict(p=np.asarray(p, float), p0=np.nan)

def bh(p):
    q = np.full(len(p), np.nan); m = ~np.isnan(p)
    if m.sum(): q[m] = multipletests(p[m], alpha=1, method='fdr_bh')[1]
    return q

def row(contrast, variant, A_lbl, B_lbl, res, A, B):
    p = res['p']; tested = ~np.isnan(p); nt = int(tested.sum())
    q = bh(p); fc = np.log2((A.mean(1) + 0.5) / (B.mean(1) + 0.5)); afc = np.abs(fc)
    nsig = int(np.nansum(p < 0.05))
    return dict(contrast=contrast, variant=variant, A=A_lbl, B=B_lbl,
                n_genes=len(p), n_tested=nt, n_untestable=int((~tested).sum()),
                p0=res['p0'], n_p_lt_005=nsig, pct_p_lt_005=round(100 * nsig / nt, 2),
                pct_over_chance=round((nsig / nt) / 0.05, 1), excess_over_chance=int(nsig - 0.05 * nt),
                n_FDR_lt_005=int(np.nansum(q < 0.05)), pct_FDR_lt_005=round(100 * np.nansum(q < 0.05) / nt, 2),
                med_signed_l2fc=round(float(np.median(fc)), 4), med_abs_l2fc=round(float(np.median(afc)), 4),
                p95_abs_l2fc=round(float(np.percentile(afc, 95)), 4), frac_l2fc_gt1=round(float(np.mean(afc > 1)), 5),
                med_n_per_gene=float(np.median(res['n'][res['n'] > 0])) if 'n' in res else np.nan)

CONTRASTS = [('Final_vs_Baseline_blood', 'final_blood', 'baseline_blood'),
             ('Dentate_vs_Baseline_blood', 'dentate_gyrus', 'baseline_blood'),
             ('Dentate_vs_Final_blood', 'dentate_gyrus', 'final_blood')]
ROWS, QQ, SIG, FC = [], [], {}, {}
t0 = time.time()
for cname, aT, bT in CONTRASTS:
    ca, cb = grp[aT], grp[bT]
    A, B = X[:, ca], X[:, cb]
    prim = binom_primary(A, B)                                   # PRIMARY
    r = row(cname, 'primary', aT, bT, prim, A, A), 
    r = row(cname, 'primary', aT, bT, prim, A, B); r['libA'], r['libB'] = prim['libA'], prim['libB']
    ROWS.append(r); SIG[cname] = prim['p'] < 0.05; FC[cname] = np.log2((A.mean(1) + .5) / (B.mean(1) + .5))
    np.save(f'{OUT}/p_primary_{cname}.npy', prim['p'])
    p = prim['p']
    qq = {'contrast': cname}
    qq.update({'min': float(np.nanmin(p))}, **{f'q{int(q*100):03d}': float(np.nanquantile(p, q))
              for q in (.001, .01, .05, .25, .5, .75, .95, .99)})
    qq['frac_p_gt_005'] = float(np.nanmean(p > 0.05)); QQ.append(qq)
    for lab, res in [('V1_p0=0.5', binom_primary(A, B, 'half')),
                     ('V2_paired_sign', paired_sign(X[:, PAIR_IDX[aT]], X[:, PAIR_IDX[bT]]))]:
        ROWS.append(row(cname, lab, aT, bT, res, A, B))
        np.save(f"{OUT}/p_{lab.replace('=','')}_ {cname}.npy".replace(' ', ''), res['p'])
    ca3 = np.array([c for c in ca if samples[c] != OUTLIER]); cb3 = np.array([c for c in cb if samples[c] != OUTLIER])
    A3, B3 = X[:, ca3], X[:, cb3]
    ROWS.append(row(cname, 'V3_outlier_excluded', f'{aT}(n={len(ca3)})', f'{bT}(n={len(cb3)})', binom_primary(A3, B3), A3, B3))
    keep = (A.mean(1) >= 1) & (B.mean(1) >= 1)                    # V4 expressed only
    re4 = dict(binom_primary(A[keep], B[keep])); re4['p'] = prim['p'][keep]
    ROWS.append(row(cname, 'V4_expressed_only', aT, bT, re4, A[keep], B[keep]))
    cols = np.concatenate([ca, cb]); sub = X[:, cols]             # V5 median-of-ratios renormalisation
    refmask = (sub > 0).all(1) & (sub.mean(1) >= 1)
    lg = np.log(sub[refmask]); sf = np.exp(np.median(lg - lg.mean(1)[:, None], axis=0))
    An, Bn = X[:, ca] / sf[[list(cols).index(c) for c in ca]], X[:, cb] / sf[[list(cols).index(c) for c in cb]]
    r5 = row(cname, 'V5_renormalised_MoR', aT, bT, binom_primary(An, Bn), An, Bn); r5['sf_range'] = f'{sf.min():.3f}-{sf.max():.3f}'
    ROWS.append(r5)
    ROWS.append(row(cname, 'V6_welch_t_replicate_aware', aT, bT, welch(A, B), A, B))  # dispersion-aware reference
    r6 = ROWS[-1]; r6['n_p_lt_005'] = r6['n_FDR_lt_005'] = r6['n_FDR_lt_005']  # keep both cols filled below
    ROWS[-1]['pct_p_lt_005'] = ROWS[-1]['pct_FDR_lt_005']
    print(f'{cname} done {time.time()-t0:.0f}s', flush=True)

S = pd.DataFrame(ROWS); S['excess_over_chance'] = S['excess_over_chance'].astype(int)
S.to_csv(f'{OUT}/contrast_summary.csv', index=False)
Q = pd.DataFrame(QQ); Q.to_csv(f'{OUT}/pvalue_quantiles.csv', index=False)

names = [c for c, _, _ in CONTRASTS]
ov = []
for i in range(3):
    for j in range(i + 1, 3):
        a, b = SIG[names[i]], SIG[names[j]]
        it, un = int(np.nansum(a & b)), int(np.nansum(a | b))
        ov.append(dict(pair=f'{names[i]} | {names[j]}', nA=int(np.nansum(a)), nB=int(np.nansum(b)),
                       intersection=it, union=un, jaccard=round(it / un, 4)))
t3 = np.nanmean(np.all(np.vstack([SIG[n] for n in names]), axis=0))
ov.append(dict(pair='all three', nA=int(np.nansum(SIG[names[0]])), nB=int(np.nansum(SIG[names[1]])),
               intersection=int(t3 * len(genes)), union=int(np.nansum(np.any(np.vstack([SIG[n] for n in names]), axis=0))),
               jaccard=round(float(t3 * len(genes) / np.nansum(np.any(np.vstack([SIG[n] for n in names]), axis=0))), 4)))
OV = pd.DataFrame(ov); OV.to_csv(f'{OUT}/deg_overlap.csv', index=False)

P('== 1. PRIMARY test + all variants, per contrast ==',
  S[['contrast','variant','n_tested','n_untestable','n_p_lt_005','pct_p_lt_005','pct_over_chance','n_FDR_lt_005','pct_FDR_lt_005']].pivot_table(index='contrast', columns='variant', values='n_p_lt_005', aggfunc='first').to_string(),
  '\n(% of tested genes)\n',
  S.pivot_table(index='contrast', columns='variant', values='pct_p_lt_005', aggfunc='first').to_string())
P('== 2. PRIMARY table ==',
  S[S.variant == 'primary'][['contrast','A','B','n_genes','n_tested','n_untestable','p0','n_p_lt_005','pct_p_lt_005','n_FDR_lt_005','pct_FDR_lt_005','med_abs_l2fc','p95_abs_l2fc','frac_l2fc_gt1','med_n_per_gene','libA','libB']].to_string(index=False))
P('== 3. p-value quantiles (primary) ==', Q.to_string(index=False))
P('== 4. effect sizes ==',
  S[S.variant.isin(['primary','V5_renormalised_MoR'])][['contrast','variant','med_signed_l2fc','med_abs_l2fc','p95_abs_l2fc','frac_l2fc_gt1']].to_string(index=False))
P('== 5. calibration diagnostics ==',
  S[S.variant.isin(['V2_paired_sign','V6_welch_t_replicate_aware','V3_outlier_excluded','V4_expressed_only','V5_renormalised_MoR','V1_p0=0.5'])][['contrast','variant','n_tested','n_p_lt_005','pct_p_lt_005','n_FDR_lt_005','pct_FDR_lt_005','sf_range']].to_string(index=False))
P('== 6. DEG overlap (primary, p<0.05) ==', OV.to_string(index=False))
bb = 'Final_vs_Baseline_blood'
tab = pd.DataFrame({'GeneID': genes, 'log2FC_final_over_baseline': FC[bb], 'p': np.load(f'{OUT}/p_primary_{bb}.npy')}).sort_values('p')
tab.head(20).to_csv(f'{OUT}/final_vs_blood_top20.csv', index=False)
P('== 7. Final vs Baseline blood, top 20 by p (note |log2FC| is small) ==', tab.head(20).to_string(index=False))

# ------------------------------------------------------------------ 8. extras
# (a) significance at a biologically meaningful effect size, (b) contrast-exclusive DEGs,
# (c) paired (subject-level) t-test FDR, (d) label-permutation calibration of the paired sign test.
prim = {c: np.load(f'{OUT}/p_primary_{c}.npy') for c in names}
exc, extra_rows = {}, []
for cname, aT, bT in CONTRASTS:
    others = [o for o in names if o != cname]
    in_other = np.nan_to_num(SIG[others[0]], nan=False) | np.nan_to_num(SIG[others[1]], nan=False)
    s = np.nan_to_num(SIG[cname], nan=False)
    exc[cname] = int((s & ~in_other).sum())
    fc = np.abs(FC[cname])
    extra_rows.append(dict(contrast=cname, n_sig_p005=int(s.sum()),
                           n_sig_and_abs_l2fc_gt0_585=int((s & (fc > np.log2(1.5))).sum()),
                           n_sig_and_abs_l2fc_gt1=int((s & (fc > 1)).sum()),
                           n_sig_and_abs_l2fc_gt2=int((s & (fc > 2)).sum()),
                           n_sig_exclusive_to_this_contrast=exc[cname]))
rng = np.random.default_rng(20170223)
for cname, aT, bT in CONTRASTS:
    ia, ib = PAIR_IDX[aT], PAIR_IDX[bT]
    perm = rng.permutation(30)                       # break the subject pairing (label permutation)
    gt, disc = (X[:, ia] > X[:, ib[perm]]).sum(1), (X[:, ia] != X[:, ib[perm]]).sum(1)
    p = np.full(len(genes), np.nan)
    for i in np.where(disc > 0)[0]:
        p[i] = binomtest(int(gt[i]), int(disc[i]), 0.5, alternative='two-sided').pvalue
    tt, tp = ttest_rel(np.log2(X[:, ia] + .5), np.log2(X[:, ib] + .5), axis=1)
    qt = bh(np.asarray(tp, float))
    extra_rows[CONTRASTS.index((cname, aT, bT))].update(
        paired_sign_labelpermuted_p005=int(np.nansum(p < 0.05)),
        paired_t_FDR005=int(np.nansum(qt < 0.05)), paired_t_p005=int(np.nansum(np.asarray(tp, float) < 0.05)))
E = pd.DataFrame(extra_rows); E.to_csv(f'{OUT}/extras.csv', index=False)
P('== 8. effect-size-thresholded significance / exclusivity / calibration ==', E.to_string(index=False))

# ------------------------------------------------------------------ 9. why the pooled exact test is over-powered
# For each gene compare the variance the binomial null ASSUMES with the variance the
# REPLICATES actually show: per-subject log2 ratio d_s = log2((A_s+.5)/(B_s+.5)), s=1..30.
#   SE_binom  : sd of log2 ratio implied by binomial sampling at the observed pooled depth
#   SE_repl   : sd_s(d_s)/sqrt(30)          (biological + technical between-sample spread)
# ratio >> 1  => the pooled binomial null is far too narrow => inflated p<0.05 hit rates.
disp = []
for cname, aT, bT in CONTRASTS:
    ia, ib = PAIR_IDX[aT], PAIR_IDX[bT]
    d = np.log2((X[:, ia] + .5) / (X[:, ib] + .5))
    se_repl = d.std(1, ddof=1) / np.sqrt(len(ia))
    k = np.rint(X[:, ia].sum(1)); n = k + np.rint(X[:, ib].sum(1)); n = np.maximum(n, 1)
    NA, NB = X[:, ia].sum(), X[:, ib].sum(); pl = NA / (NA + NB)
    sd_log2 = np.sqrt(np.maximum(pl * (1 - pl) / n, 1e-12)) / (pl * np.log(2))   # delta-method on log2 ratio
    m = n > 0
    disp.append(dict(contrast=cname,
                     median_SE_binom=round(float(np.median(sd_log2[m])), 5),
                     median_SE_replicate=round(float(np.median(se_repl[m])), 5),
                     median_variance_inflation_x=round(float(np.median((se_repl / sd_log2)[m])), 2),
                     median_between_subject_SD_log2=round(float(np.median(d.std(1, ddof=1)[m])), 4),
                     observed_frac_sig_primary=round(float(np.nanmean(np.load(f'{OUT}/p_primary_{cname}.npy')[m] < 0.05)), 4)))
D = pd.DataFrame(disp); D.to_csv(f'{OUT}/dispersion_diagnostic.csv', index=False)
P('== 9. variance-underestimation diagnostic (why nominal p<0.05 is not interpretable on its own) ==', D.to_string(index=False))

LOG.close()
