"""Differential expression of miRNAs (DM1 patients vs controls), Table S1 Ct data.
Primary: per-miRNA two-sided Welch t-test on raw Ct, available-case. Denominator 175."""
import sys, struct
sys.path.insert(0, 'scripts')
import numpy as np, pandas as pd
from scipy import stats
import biff8_parse as bp

pd.set_option('display.width', 220); pd.set_option('display.max_columns', 40)
pd.set_option('display.float_format', lambda v: f'{v:.4g}')

wb = bp.parse_biff8(bp.ole_read_stream('data/pone.0150501.s002.xls'))
raw = wb['RAW DATA']
ids = raw.iloc[2:, 0].astype(str).values
mat = raw.iloc[2:, 1:].copy()
mat.columns = raw.iloc[1, 1:].values.astype(str)
X = mat.apply(pd.to_numeric, errors='coerce')          # "NAN" -> NaN
assert X.shape == (175, 20)
pat = [c for c in X.columns if c.startswith('P_')]
ctl = [c for c in X.columns if c.startswith('C_')]
assert len(pat) == 10 and len(ctl) == 10
print(f"rows={X.shape[0]} cols={X.shape[1]} patients={len(pat)} controls={len(ctl)}")
print(f"NaN cells after coercion: {int(X.isna().sum().sum())}")

# ---- computability check: need >=2 valid values per group for a t-test ----
npat = X[pat].notna().sum(axis=1).values
nctl = X[ctl].notna().sum(axis=1).values
computable = (npat >= 2) & (nctl >= 2)
print(f"miRNAs computable for Welch t-test: {computable.sum()}/175 "
      f"(min valid patient n={npat.min()}, control n={nctl.min()})")
assert computable.all(), "some miRNA not computable"

res = pd.DataFrame(index=X.index)
A = X[pat].values; B = X[ctl].values
t, p = np.full(175, np.nan), np.full(175, np.nan)
u, pu = np.full(175, np.nan), np.full(175, np.nan)
for i in range(175):
    a, b = A[i][~np.isnan(A[i])], B[i][~np.isnan(B[i])]
    t[i], p[i] = stats.ttest_ind(a, b, equal_var=False)
    u[i], pu[i] = stats.mannwhitneyu(a, b, alternative='two-sided')
res['n_pat'], res['n_ctl'] = npat, nctl
res['mean_pat'], res['mean_ctl'] = np.nanmean(A, 1), np.nanmean(B, 1)
res['med_pat'], res['med_ctl'] = np.nanmedian(A, 1), np.nanmedian(B, 1)
res['sd_pat'], res['sd_ctl'] = np.nanstd(A, 1, ddof=1), np.nanstd(B, 1, ddof=1)
res['dCt_pat_minus_ctl'] = res['mean_pat'] - res['mean_ctl']
res['t'], res['p_welch'] = t, p
res['U'], res['p_mwu'] = u, pu

sig_w = res['p_welch'] < 0.05
sig_m = res['p_mwu'] < 0.05
N = 175
print("\n=== PRIMARY: Welch t-test, available-case, denominator 175 ===")
print(f"significant (p<0.05): {sig_w.sum()} / 175 = {sig_w.sum()/N*100:.2f}%")
print("\n=== SIGNIFICANT LIST (Welch) ===")
cols = ['n_pat','n_ctl','mean_pat','mean_ctl','med_pat','med_ctl','dCt_pat_minus_ctl',
        't','p_welch','p_mwu']
print(res.loc[sig_w, cols].sort_values('p_welch').to_string())

print("\n=== SENSITIVITY (a): Mann-Whitney U, same available-case basis, denom 175 ===")
print(f"significant: {sig_m.sum()} / 175 = {sig_m.sum()/N*100:.2f}%")

print("\n=== SENSITIVITY (b): complete-case denominator (rows with no NaN) ===")
complete = ~X.isna().any(axis=1)
print(f"complete rows: {complete.sum()}; significant among complete: "
      f"{(sig_w & complete).sum()} -> {(sig_w & complete).sum()/complete.sum()*100:.2f}% "
      f"of 161 (Welch). MWU: {(sig_m & complete).sum()} -> "
      f"{(sig_m & complete).sum()/complete.sum()*100:.2f}%")

print("\n=== FLIPS Welch vs MWU ===")
only_w = res.index[sig_w & ~sig_m]; only_m = res.index[sig_m & ~sig_w]
print("sig by Welch only:", list(only_w))
print("sig by MWU only:  ", list(only_m))
flip = sig_w ^ sig_m
print(res.loc[flip, ['n_pat','n_ctl','mean_pat','mean_ctl','t','p_welch','U','p_mwu']].to_string())
print("flips on rows with missing Ct:", int((flip & ~complete).sum()))

print("\n=== SANITY: normality/variance for Welch-significant miRNAs ===")
sw_p, skew_s = [], []
for i in np.where(sig_w)[0]:
    a, b = A[i][~np.isnan(A[i])], B[i][~np.isnan(B[i])]
    sw_p.append(stats.shapiro(a).pvalue); sw_p.append(stats.shapiro(b).pvalue)
    skew_s += [stats.skew(a), stats.skew(b)]
sw_p = np.array(sw_p); skew_s = np.array(skew_s)
print(f"Shapiro-Wilk per group (2x{sig_w.sum()} tests): p<0.05: {(sw_p<0.05).sum()}, "
      f"p<0.01: {(sw_p<0.01).sum()}, min p: {sw_p.min():.4g}")
print(f"|skew|>1: {(np.abs(skew_s)>1).sum()}/{len(skew_s)}; max |skew|: {np.abs(skew_s).max():.2f}")
mind = res.loc[sig_w, ['sd_pat','sd_ctl']].min(axis=1)
print(f"min within-group SD among significant: {mind.min():.3f} Ct "
      f"(near-zero <0.2 Ct: {(mind<0.2).sum()})")
lev = [stats.levene(A[i][~np.isnan(A[i])], B[i][~np.isnan(B[i])]).pvalue for i in np.where(sig_w)[0]]
print(f"Levene p<0.05 among significant rows: {sum(p<0.05 for p in lev)}/{len(lev)} "
      f"(unequal variance handled by Welch regardless)")

print("\n=== FINAL ===")
print(f"{sig_w.sum()}/175 miRNAs = {sig_w.sum()/N*100:.2f}% (Welch, unadjusted p<0.05)")
res.to_csv('results_per_miRNA.csv')
print("saved results_per_miRNA.csv")
