"""Minimal BIFF8 (.xls) reader -> pandas DataFrames. Pure stdlib. Handles CONTINUE for SST."""
import struct
import pandas as pd

def ole_read_stream(path, stream_name='Workbook'):
    data = open(path, 'rb').read()
    ssz = 1 << struct.unpack_from('<H', data, 30)[0]
    num_fat = struct.unpack_from('<I', data, 44)[0]
    dir_start = struct.unpack_from('<I', data, 48)[0]
    mini_cutoff = struct.unpack_from('<I', data, 56)[0]
    mini_fat_start = struct.unpack_from('<I', data, 60)[0]
    num_mini = struct.unpack_from('<I', data, 64)[0]
    def sect(n): return (n + 1) * ssz
    difat = [struct.unpack_from('<I', data, 76 + 4*i)[0] for i in range(109)]
    fat = []
    for s in [x for x in difat if x < 0xFFFFFFFE][:num_fat]:
        fat += list(struct.unpack_from('<%dI' % (ssz//4), data, sect(s)))
    def chain(start, table):
        out, s, seen = [], start, set()
        while s < 0xFFFFFFFE and s not in seen:
            seen.add(s); out.append(s); s = table[s]
        return out
    dbytes = b''.join(data[sect(s):sect(s)+ssz] for s in chain(dir_start, fat))
    dirs = [dbytes[i*128:(i+1)*128] for i in range(len(dbytes)//128)]
    root = dirs[0]
    root_sid = struct.unpack_from('<I', root, 116)[0]
    mfb = b''.join(data[sect(s):sect(s)+ssz] for s in chain(mini_fat_start, fat))
    mini_fat = []
    for s in [struct.unpack_from('<%dI' % (ssz//4), mfb, i*ssz)[0] for i in range(num_mini)]:
        mini_fat += list(struct.unpack_from('<%dI' % (ssz//4), data, sect(s)))
    rbytes = b''.join(data[sect(s):sect(s)+ssz] for s in chain(root_sid, fat))
    def read_stream(sid, size):
        if size >= mini_cutoff and sid != 0xFFFFFFFE:
            return b''.join(data[sect(s):sect(s)+ssz] for s in chain(sid, fat))[:size]
        out = bytearray()
        for s in chain(sid, mini_fat):
            out += rbytes[s*64:(s+1)*64]
        return bytes(out[:size])
    for d in dirs:
        nl = struct.unpack_from('<H', d, 64)[0]
        name = d[:nl].decode('utf-16-le').rstrip('\x00')
        if name == stream_name and d[66] == 2:
            return read_stream(struct.unpack_from('<I', d, 116)[0],
                               struct.unpack_from('<I', d, 120)[0])
    raise KeyError(stream_name)

def records(wb, pos, stop_at_eof=False):
    """Yield (rec, body). If stop_at_eof, stop at EOF record."""
    while pos + 4 <= len(wb):
        rec, ln = struct.unpack_from('<HH', wb, pos)
        yield rec, wb[pos+4:pos+4+ln]
        pos += 4 + ln
        if stop_at_eof and rec == 0x000A:
            return

def rk_number(rk):
    fx = rk & 0x02; intl = rk & 0x01
    if intl:
        v = rk >> 2
        if rk & 0x20000000:
            v -= 0x40000000
        v = float(v)
    else:
        v = struct.unpack('<d', struct.pack('<Q', (rk & 0xFFFFFFFF) << 32))[0]
    return v / 100 if fx else v

def _read_unicode(buf, p, cch, high, boundaries):
    """Read cch chars starting at p; byte position may cross record-buffer boundaries
    (given as absolute positions in the concatenated buffer) where a 1-byte flag applies."""
    out = []
    while cch > 0:
        if p in boundaries:
            high = bool(buf[p] & 1)
            p += 1
        if high:
            take = min(cch, (len(buf) - p) // 2)
            out.append(buf[p:p+take*2].decode('utf-16-le', 'replace'))
            p += take*2
        else:
            take = min(cch, len(buf) - p)
            out.append(buf[p:p+take].decode('latin-1'))
            p += take
        cch -= take
    return ''.join(out), p, high

def parse_biff8(wb):
    recs = list(records(wb, 0))
    # globals pass: SST (with CONTINUE), BOUNDSHEET
    strings = []
    sheets = []
    i = 0
    while i < len(recs):
        rec, body = recs[i]
        if rec == 0x00FC:  # SST
            buf = bytearray(body); boundaries = set()
            i += 1
            while i < len(recs) and recs[i][0] == 0x003C:
                boundaries.add(len(buf))  # flag byte follows at buffer start
                buf += recs[i][1]
                i += 1
            buf = bytes(buf)
            total, unique = struct.unpack_from('<II', buf, 0)
            p = 8
            for _ in range(unique):
                cch, = struct.unpack_from('<H', buf, p); p += 2
                flags = buf[p]; p += 1
                high = bool(flags & 1)
                crun = 0; cbext = 0
                if flags & 0x08:
                    crun, = struct.unpack_from('<H', buf, p); p += 2
                if flags & 0x04:
                    cbext, = struct.unpack_from('<I', buf, p); p += 4
                s, p, high = _read_unicode(buf, p, cch, high, boundaries)
                p += crun * 4 + cbext
                strings.append(s)
            continue
        elif rec == 0x0085:  # BOUNDSHEET
            lv, = struct.unpack_from('<I', body, 0)
            cch = body[6]
            if body[7] & 1:
                name = body[8:8+cch*2].decode('utf-16-le')
            else:
                name = body[8:8+cch].decode('latin-1')
            sheets.append((name, lv))
        i += 1
    return {name: parse_sheet(wb, lv, strings) for name, lv in sheets}

def parse_sheet(wb, pos, strings):
    cells = {}
    last_formula_str = None
    for rec, body in records(wb, pos, stop_at_eof=True):
        if rec == 0x0809:
            continue
        if rec == 0x00FD:  # LABELSST
            r, c, xf, idx = struct.unpack_from('<HHHI', body, 0)
            cells[(r, c)] = strings[idx]
        elif rec == 0x0203:  # NUMBER
            r, c = struct.unpack_from('<HH', body, 0)
            cells[(r, c)] = struct.unpack_from('<d', body, 6)[0]
        elif rec == 0x027E:  # RK
            r, c, xf, rk = struct.unpack_from('<HHHI', body, 0)
            cells[(r, c)] = rk_number(rk)
        elif rec == 0x00BD:  # MULRK
            r, c1 = struct.unpack_from('<HH', body, 0)
            n = (len(body) - 6) // 6
            for k in range(n):
                xf, rk = struct.unpack_from('<HI', body, 4 + k*6)
                cells[(r, c1+k)] = rk_number(rk)
        elif rec == 0x006E:  # FORMULA
            r, c = struct.unpack_from('<HH', body, 0)
            res = body[12:20]
            t = res[6]
            if t == 0xFF and res[7] == 0:
                cells[(r, c)] = None; last_formula_str = (r, c)
            elif t == 0x00 and res[7] == 0xFF:
                cells[(r, c)] = 'ERR#%d' % res[5]
            elif t == 0x02:
                cells[(r, c)] = bool(res[7]) if res[5:6] != b'\x00' or res[7] else None
            elif t == 0x03:
                cells[(r, c)] = ''
            else:
                cells[(r, c)] = struct.unpack('<d', res)[0]
        elif rec == 0x0207:  # STRING result
            cch, = struct.unpack_from('<H', body, 0)
            flags = body[2]
            s, _, _ = _read_unicode(body, 3, cch, bool(flags & 1), set())
            if last_formula_str:
                cells[last_formula_str] = s
    if not cells:
        return pd.DataFrame()
    maxr = max(r for r, _ in cells); maxc = max(c for _, c in cells)
    grid = [[None]*(maxc+1) for _ in range(maxr+1)]
    for (r, c), v in cells.items():
        grid[r][c] = v
    return pd.DataFrame(grid)

if __name__ == '__main__':
    import sys
    wb = parse_biff8(ole_read_stream(sys.argv[1]))
    for k, df in wb.items():
        print(repr(k), df.shape)
