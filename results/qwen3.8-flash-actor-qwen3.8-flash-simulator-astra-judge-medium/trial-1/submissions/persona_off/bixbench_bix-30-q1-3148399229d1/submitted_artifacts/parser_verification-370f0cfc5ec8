"""Independent verification of biff8_parse output vs raw BIFF8 records."""
import sys; sys.path.insert(0, 'scripts')
import numpy as np, pandas as pd, struct
import biff8_parse as bp

wb = bp.ole_read_stream('data/pone.0150501.s002.xls')

# --- 1. Independent raw record scan (separate pass, no DataFrame involved) ---
# locate the sheet BOF following BOUNDSHEET lv=0x4D9B, then tally cell records
recs = list(bp.records(wb, 0x4D9B, stop_at_eof=True))
raw_cells = {}
counts = {}
strings_rebuilt = []
# rebuild SST independently for LABELSST check
grecs = [r for r in bp.records(wb, 0) if r[0] in (0x00FC, 0x003C)][:1]  # globals SST start
# (SST already verified via names; here tally numeric cells)
for rec, body in recs:
    counts[hex(rec)] = counts.get(hex(rec), 0) + 1
    if rec == 0x0203:
        r, c = struct.unpack_from('<HH', body, 0)
        raw_cells[(r, c)] = struct.unpack_from('<d', body, 6)[0]
    elif rec == 0x027E:
        r, c, xf, rk = struct.unpack_from('<HHHI', body, 0)
        raw_cells[(r, c)] = bp.rk_number(rk)
    elif rec == 0x00BD:
        r, c1 = struct.unpack_from('<HH', body, 0)
        n = (len(body) - 6) // 6
        for k in range(n):
            xf, rk = struct.unpack_from('<HI', body, 4 + k*6)
            raw_cells[(r, c1 + k)] = bp.rk_number(rk)
    elif rec == 0x00FD:
        r, c = struct.unpack_from('<HH', body, 0)
        raw_cells[(r, c)] = 'STR'
numeric_raw = {k: v for k, v in raw_cells.items() if isinstance(v, float)}
print("raw records tally:", {k: v for k, v in sorted(counts.items())})
print(f"raw numeric cells: {len(numeric_raw)}; raw string cells: {len(raw_cells)-len(numeric_raw)}")
# expected numerics: rows 2..176 x cols 1..20 = 3500 minus NAN-string cells
nan_raw = sum(1 for k, v in raw_cells.items() if v == 'STR' and k[0] >= 2 and k[1] >= 1)
print(f"'NAN' string cells in data area (LABELSST): {nan_raw}")
assert len(numeric_raw) == 3500 - 22

# --- 2. Compare raw-scan values with the DataFrame used for the tests ---
df = bp.parse_biff8(wb)['RAW DATA']
X = df.iloc[2:, 1:].apply(pd.to_numeric, errors='coerce')
mismatch = 0; checked = 0
for (r, c), v in numeric_raw.items():
    got = X.iloc[r - 2, c - 1]
    checked += 1
    if not (isinstance(got, float) and np.isfinite(got) and abs(got - v) <= 1e-12 * max(1, abs(v))):
        mismatch += 1; print("MISMATCH", r, c, v, got)
print(f"raw-vs-DataFrame numeric cells compared: {checked}, mismatches: {mismatch}")
assert mismatch == 0 and checked == len(numeric_raw)

# NaN positions match 'NAN' string cells
nan_df = {(r + 2, c + 1) for (r, c) in np.argwhere(X.isna().values)}
nan_str = {k for k, v in raw_cells.items() if v == 'STR' and k[0] >= 2 and k[1] >= 1}
print("NaN positions identical:", nan_df == nan_str, f"(|set|={len(nan_df)})")
assert nan_df == nan_str

# --- 3. Everything fed to the tests is float or NaN ---
vals = X.values.ravel()
print("all test inputs float/NaN:", all(isinstance(v, float) for v in vals),
      f"(finite: {np.isfinite(vals).sum()}, NaN: {np.isnan(vals).sum()})")

# --- 4. Spot-check named miRNAs against raw records ---
ids = df.iloc[2:, 0].astype(str).values
name2row = {n: i + 2 for i, n in enumerate(ids)}
for name in ['hsa-let-7a', 'hsa-miR-95', 'hsa-miR-99b', 'hsa-miR-190*']:
    r = name2row.get(name)
    if r is None:
        print(f"{name}: NOT IN SHEET"); continue
    rawvals = [raw_cells.get((r, c)) for c in range(1, 21)]
    rawvals = [('NAN' if v == 'STR' else round(v, 6)) for v in rawvals if v is not None]
    dfvals = [('NaN' if pd.isna(v) else round(v, 6)) for v in X.iloc[r - 2].values]
    ok = all((a == 'NAN' and b == 'NaN') or (isinstance(a, float) and abs(a - b) < 1e-9)
             for a, b in zip(rawvals, dfvals))
    print(f"{name}: row {r}, name cell={raw_cells.get((r, 0))!r}(LABELSST), spot-check match={ok}")
    print("   raw:", rawvals[:6], "...")
    print("   df :", dfvals[:6], "...")

# --- 5. name cell row for significant list / flip name for missing-Ct flip ---
print("\nname at df row idx 80 :", ids[78])
print("name at df row idx 21 :", ids[19])
