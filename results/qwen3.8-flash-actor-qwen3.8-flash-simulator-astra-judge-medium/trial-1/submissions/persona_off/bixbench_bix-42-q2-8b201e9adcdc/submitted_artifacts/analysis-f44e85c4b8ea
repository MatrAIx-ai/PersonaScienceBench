#!/usr/bin/env python3
"""
bix-42-q2 : Skewness of the RNA expression distribution (TCGA COAD capsule).

Pre-registered design (approved by researcher):
  Primary population : ALL 328 samples x ALL 20,502 genes, as delivered.
  Primary scale      : as-supplied LINEAR scale. log2(x+1) = secondary diagnostic only.
  Units of observation (3 views, reported side by side, NOT averaged):
      (A) pooled gene x sample values
      (B) per-sample distributions across genes   (n = 328)
      (C) per-gene  distributions across samples  (n = 20,502)
  Estimators: Fisher-Pearson adjusted moment skewness G1 (magnitude, primary view);
              Pearson median skewness, Bowley quartile skewness, percentile skewness
              (10/50/90 and 5/50/95) and 5% trimmed G1 (direction / robustness).
  Consensus rule: direction from robust measures, magnitude class from the primary
              linear-scale pooled G1. Class divergence is flagged, not averaged.
  Classification (pre-registered): |s|<0.5 approx normal; 0.5<=|s|<1.0 mild/minimal;
              |s|>=1.0 highly skewed (sign gives direction).
NOTE: the medcouple originally proposed is EXCLUDED - it could not be validated
      against published theoretical values offline (no reference implementation,
      no network); see scratch/mc*.py validation attempts in the transcript.
"""
import os, json
import numpy as np
import pandas as pd

DATA = 'data/COAD__geneExp.xls'
OUT = 'results'
os.makedirs(OUT, exist_ok=True)
CLASSES = ['highly left-skewed', 'minimally left-skewed', 'approximately normal',
           'minimally right-skewed', 'highly right-skewed']


def classify(s):
    if not np.isfinite(s): return 'undefined'
    if s >= 1.0:  return CLASSES[4]
    if s >= 0.5:  return CLASSES[3]
    if s > -0.5:  return CLASSES[2]
    if s > -1.0:  return CLASSES[1]
    return CLASSES[0]


def rclass(q):
    if not np.isfinite(q): return 'undefined'
    a = abs(q)
    lab = 'approximately symmetric' if a < 0.1 else ('mildly skewed' if a < 0.3 else 'strongly skewed')
    return lab + (' (right)' if q > 0 else ' (left)' if q < 0 else '')


# ---- estimators; validated for antisymmetry/known values in scratch/validate_robust.py
def g1(x):
    x = np.asarray(x, dtype=np.float64); x = x[np.isfinite(x)]; n = x.size
    if n < 3: return np.nan
    mu = x.mean(); s = x.std(ddof=0)
    if s <= 0: return np.nan
    m3 = ((x - mu) ** 3).mean() / s ** 3
    return float(m3 * np.sqrt(n * (n - 1)) / (n - 2))


def pearson_median(x):
    x = np.asarray(x, float); s = x.std(ddof=0)
    return float(3 * (x.mean() - np.median(x)) / s) if s > 0 else np.nan


def qskew(x, qs=(25, 50, 75)):
    q1, q2, q3 = np.percentile(x, qs)
    return float((q3 + q1 - 2 * q2) / (q3 - q1)) if q3 > q1 else np.nan


def trimmed_g1(x, t=5.0):
    lo, hi = np.percentile(x, [t, 100 - t]); y = x[(x >= lo) & (x <= hi)]
    return g1(y)


def full_stats(x, scale):
    x = np.asarray(x, dtype=np.float64); x = x[np.isfinite(x)]
    if x.size < 3: return {}
    G1 = g1(x); bw = qskew(x)
    return {'scale': scale, 'n': int(x.size),
            'min': float(x.min()), 'p25': float(np.percentile(x, 25)),
            'median': float(np.median(x)), 'p75': float(np.percentile(x, 75)),
            'p99': float(np.percentile(x, 99)), 'max': float(x.max()),
            'mean': float(x.mean()), 'sd': float(x.std(ddof=0)),
            'frac_zero': float((x == 0).mean()),
            'G1_moment': G1, 'pearson_median': pearson_median(x),
            'bowley_q25_75': bw, 'perc_q10_90': qskew(x, (10, 50, 90)),
            'perc_q05_95': qskew(x, (5, 50, 95)), 'trimmed_g1_p5': trimmed_g1(x, 5.0),
            'class_G1': classify(G1), 'class_robust_bowley': rclass(bw)}


def rowwise_stats(M):
    """One distribution per row. Returns per-distribution skewness estimates."""
    M = np.asarray(M, dtype=np.float64)
    n = M.shape[1]
    mu = M.mean(1); sd = M.std(1, ddof=0)
    with np.errstate(divide='ignore', invalid='ignore'):
        m3 = ((M - mu[:, None]) ** 3).mean(1) / sd ** 3
        G1 = m3 * np.sqrt(n * (n - 1)) / (n - 2)
        pm = 3 * (mu - np.median(M, 1)) / sd
    G1[~np.isfinite(G1)] = np.nan; pm[~np.isfinite(pm)] = np.nan
    q1, q2, q3 = np.percentile(M, [25, 50, 75], axis=1)
    p05, p95 = np.percentile(M, [5, 95], axis=1)
    p10, p50, p90 = np.percentile(M, [10, 50, 90], axis=1)
    with np.errstate(divide='ignore', invalid='ignore'):
        bow = np.where(q3 > q1, (q3 + q1 - 2 * q2) / (q3 - q1), np.nan)
        pq90 = np.where(p90 > p50, (p90 + p10 - 2 * p50) / (p90 - p10), np.nan)
        pq95 = np.where(p95 > p50, (p95 + p05 - 2 * p50) / (p95 - p05), np.nan)
    trim = np.full(M.shape[0], np.nan)
    for i in range(M.shape[0]):
        y = M[i, (M[i] >= p05[i]) & (M[i] <= p95[i])]
        trim[i] = g1(y)
    return pd.DataFrame({'G1_moment': G1, 'pearson_median': pm, 'bowley_q25_75': bow,
                         'perc_q10_90': pq90, 'perc_q05_95': pq95, 'trimmed_g1_p5': trim})


def summarise(df):
    out = {}
    for c in df.columns:
        v = df[c].to_numpy(float); v = v[np.isfinite(v)]
        if v.size == 0: continue
        moment_like = c in ('G1_moment', 'trimmed_g1_p5', 'pearson_median')
        out[c] = dict(n_defined=int(v.size), median=float(np.median(v)),
                      q1=float(np.percentile(v, 25)), q3=float(np.percentile(v, 75)),
                      p10=float(np.percentile(v, 10)), p90=float(np.percentile(v, 90)),
                      min=float(v.min()), max=float(v.max()),
                      class_median=(classify(float(np.median(v))) if moment_like
                                    else rclass(float(np.median(v)))),
                      frac_gt_0=float((v > 0).mean()))
    return out


def q_hist(x, nbins=20, label='', edges=None):
    """Equal-FREQUENCY histogram: makes shape visible on a scale spanning 7 orders of magnitude."""
    x = np.asarray(x, float); x = x[np.isfinite(x)]
    e = np.unique(np.percentile(x, np.linspace(0, 100, nbins + 1))) if edges is None else np.asarray(edges)
    e[0] = -np.inf; e[-1] = np.inf
    h, _ = np.histogram(x, bins=e); mx = h.max() or 1
    lines = [f"  {label}: equal-frequency bins ({len(e)-1} bins, each holding ~{100/(len(e)-1):.1f}% of values; widths vary)"]
    for i in range(len(h)):
        lo = '   -inf' if not np.isfinite(e[i]) else f"{e[i]:.4g}"
        hi = '   +inf' if not np.isfinite(e[i+1]) else f"{e[i+1]:.4g}"
        lines.append(f"  [{lo:>10s},{hi:>10s}) | {'#'*int(round(46*h[i]/mx)):46s} {h[i]:>8d} ({100*h[i]/len(x):.1f}%)")
    return "\n".join(lines)


def ascii_hist(x, bins=24, label='', clip_q=None):
    x = np.asarray(x, float); x = x[np.isfinite(x)]
    lo, hi = (np.percentile(x, clip_q), np.percentile(x, 100 - clip_q)) if clip_q else (x.min(), x.max())
    y = x[(x >= lo) & (x <= hi)]
    h, e = np.histogram(y, bins=bins); mx = h.max() or 1
    lines = [f"  {label}  [{lo:.4g} .. {hi:.4g}]  n={y.size} (outside clip: {int(((x < lo) | (x > hi)).sum())})"]
    for i in range(bins):
        lines.append(f"  {e[i]:12.4g} | {'#' * int(round(50 * h[i] / mx)):50s} {h[i]}")
    return "\n".join(lines)


