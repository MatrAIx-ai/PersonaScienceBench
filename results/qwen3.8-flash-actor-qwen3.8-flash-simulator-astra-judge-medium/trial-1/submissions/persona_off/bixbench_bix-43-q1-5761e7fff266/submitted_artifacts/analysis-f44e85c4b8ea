        % (float(np.median(diag["bcv"])), diag["qq_slope"], gl["size_factor"].min(), gl["size_factor"].max()))
    validate_engine(mat=mat, primary=primary['log2FC'], layout=layout, ok_idx=list(tbl.index[tbl['expr_all_groups']]))
