#!/usr/bin/env python3
"""
bix-43-q1 : CBD/cisplatin combination vs DMSO control -> GO Biological Process enrichment.

Approved pipeline:
  1. symbol mapping + count collapse + low-count filter
  2. DESeq2-equivalent NB2 GLM (~ 0 + Group, all 30 samples), Wald contrast combo - DMSO
  3. ranked list (primary metric = log2FoldChange) for a gseapy prerank with GO_Biological_Process_2021
  4. enrichment: min_size 15, max_size 500, 1000 permutations, fixed seed, answer = lowest FDR q-val

The sandbox is air-gapped and ships no gseapy and no GO gene-set library (see ENV PROBE), so step 4
runs only as (a) the guarded literal gseapy call, which records its failure, and (b) a synthetic
validation of the gseapy-equivalent prerank engine. Everything else is executed for real.
"""
import json, os, subprocess, sys, time, platform, socket
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from nblib import (median_of_ratios, nb_glm, wald_contrast, mom_dispersion, mom_dispersion_design,
                   disp_trend, map_dispersion, shrunk_dispersion, Prerank, parse_gmt, gene_wise_dispersion_mle)

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.path.join(ROOT, "data")
OUT = os.path.join(ROOT, "analysis", "out")
os.makedirs(OUT, exist_ok=True)
LOG = []


def log(*a):
    s = " ".join(str(x) for x in a)
    print(s, flush=True); LOG.append(s)


def save(df, name, gz=True):
    p = os.path.join(OUT, name)
    df.to_csv(p + (".gz" if gz else ""), compression=("gzip" if gz else None))
    log(f"[write] {p}{'gz' if gz else ''} shape={df.shape}")
    return p


TREAT = {
    "Untreated": ("Untreated", 0), "Serum_starvation": ("Untreated", 1),
    "DMSO": ("DMSO", 0), "DMSO_Serum_starvation": ("DMSO", 1),
    "Cisplatin_IC50": ("Cisplatin", 0), "Cisplatin_IC50_Serum_starvation_16h": ("Cisplatin", 1),
    "CBD_IC50": ("CBD", 0), "CBD_IC50_Serum_starvation_16h": ("CBD", 1),
    "Cisplatin_IC50_CBD_IC50": ("Cisplatin+CBD", 0),
    "Cisplatin_IC50_CBD_IC50_Serum_starvation_16h": ("Cisplatin+CBD", 1),
}
REF, TRT = "DMSO", "Cisplatin_IC50_CBD_IC50"
PRIOR_DF = 2.0
REF2, TRT2 = "DMSO_Serum_starvation", "Cisplatin_IC50_CBD_IC50_Serum_starvation_16h"


