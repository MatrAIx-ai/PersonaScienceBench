def main():
    t0 = time.time()
    env_probe()
    mat, layout = preprocess()
    primary, diag = de_run(mat, layout, kind="group", tag="primary")
    calibrate_engine(mat, layout, diag)
    sens_design, _ = de_run(mat, layout, kind="treat_x_starv", tag="sens_two_factor")
    sens_loo, _ = de_run(mat, layout, kind="group", keep_cols=[c for c in layout["col"] if c != "3_1"],
                         tag="sens_leave_out_3_1")
    sens_alt, _ = de_run(mat, layout, kind="contrast2", tag="sens_starved_combo_vs_DMSO")
    tbl, rnk, ok_idx = ranking_metrics(mat, primary, layout)
    V = pd.DataFrame({"one_factor": primary["log2FC"],
                      "two_factor": sens_design["log2FC"].reindex(primary.index),
                      "leave_out_3_1": sens_loo["log2FC"].reindex(primary.index),
                      "starved_combo_vs_DMSO": sens_alt["log2FC"].reindex(primary.index)})
    log("\n  Spearman of log2FC rankings across designs:\n" + V.corr(method="spearman").round(3).to_string())
    jac = {}
    cols = list(V.columns)
    for i, a in enumerate(cols):
        for b in cols[i + 1:]:
            for lab, asc in (("top500", False), ("bottom500", True)):
                A = set(V[a].sort_values(ascending=asc).index[:500]); B = set(V[b].sort_values(ascending=asc).index[:500])
                jac[f"{a}|{b}|{lab}"] = round(len(A & B) / len(A | B), 3)
    log("  cross-design leading-edge Jaccard: " + json.dumps(jac, indent=2))
    save(V, "log2FC_across_design_variants.csv")
    gl = pd.DataFrame({"sample": list(diag["sf"].keys()),
                       "size_factor": list(diag["sf"].values()),
                       "library_size": [diag["libsize"][k] for k in diag["sf"]]})
    gl.to_csv(os.path.join(OUT, "de_global_diagnostics.csv"), index=False)
