#!/usr/bin/env python3
"""One-shot runner for the literal, specified enrichment analysis (bix-43-q1).

Run this once EITHER (a) gseapy can be installed and maayanlab.cloud is reachable, OR
(b) a GO_Biological_Process_2021 GMT file is placed in the capsule (e.g.
    data/GO_Biological_Process_2021.gmt, downloaded from
    https://maayanlab.cloud/Enrichr/geneSetLibrary?mode=text&libraryName=GO_Biological_Process_2021 ).

Usage:
    python analysis/gseapy_one_shot.py [path/to/GO_Biological_Process_2021.gmt]

If gseapy is importable it is used directly. If only the GMT is available, the validated
gseapy-equivalent engine in analysis/nblib.py is used instead and labelled as such.
Ranked inputs produced by analysis/analysis.py:
    analysis/out/ranked_primary_log2FC.rnk            (pre-specified primary metric)
    analysis/out/ranked_B_expressed_log2FC.rnk        (universe B variant)
    analysis/out/ranked_alt_neglog10padj_x_sign.rnk   (robustness metric)
    analysis/out/ranked_alt_signal_to_noise.rnk       (robustness metric)
"""
import os, sys
import pandas as pd

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "analysis", "out")
RANKS = {"primary_log2FC": "ranked_primary_log2FC.rnk",
         "universeB_log2FC": "ranked_B_expressed_log2FC.rnk",
         "alt_neglog10padj_x_sign": "ranked_alt_neglog10padj_x_sign.rnk",
         "alt_signal_to_noise": "ranked_alt_signal_to_noise.rnk"}
LIB = "GO_Biological_Process_2021"
PARAMS = dict(min_size=15, max_size=500, permutation_num=1000, seed=42)


def report(tag, df, label):
    df = df.copy()
    pcol = "NOM p-val" if "NOM p-val" in df.columns else "p-value"
    fcol = "FDR q-val" if "FDR q-val" in df.columns else "Adjusted p-value"
    df["_fdr"] = pd.to_numeric(df[fcol], errors="coerce")
    df["_nes"] = pd.to_numeric(df.get("NES"), errors="coerce")
    df = df.sort_values("_fdr")
    df.to_csv(os.path.join(OUT, f"enrichment_{label}.csv"), index=False)
    print(f"\n### {tag} [{label}]")
    print(df.head(10)[[c for c in ("Term", "Term Size", "ES", "NES", pcol, fcol) if c in df.columns]].to_string(index=False))
    print(f"  ANSWER (lowest {fcol}): {df.iloc[0]['Term']}  "
          f"[NES={df.iloc[0]['_nes']:.3f}, {fcol}={df.iloc[0]['_fdr']:.4g}, size={df.iloc[0].get('Term Size')}]")
    for sign, lab in ((1, "up-regulated"), (-1, "down-regulated")):
        s = df[df["_nes"] * sign > 0].dropna(subset=["_nes"])
        if len(s):
            print(f"  lowest {fcol} among {lab} terms: {s.iloc[0]['Term']} "
                  f"(NES={s.iloc[0]['_nes']:.3f}, {fcol}={s.iloc[0]['_fdr']:.4g})")


def main():
    gmt = sys.argv[1] if len(sys.argv) > 1 else None
    if gmt is None:
        for cand in (os.path.join(ROOT, "data", LIB + ".gmt"), os.path.join(ROOT, LIB + ".gmt")):
            if os.path.exists(cand):
                gmt = cand; break
    try:
        import gseapy as gp
        engine = f"gseapy {gp.__version__}"
        for tag, fn in RANKS.items():
            rnk = os.path.join(OUT, fn)
            if not os.path.exists(rnk):
                continue
            gene_sets = gmt if gmt else LIB
            for max_size in (500, 1000):
                r = gp.prerank(rnk=rnk, gene_sets=gene_sets, min_size=PARAMS["min_size"],
                               max_size=max_size, permutation_num=PARAMS["permutation_num"],
                               threads=4, seed=PARAMS["seed"], outdir=None)
                report(f"{engine} | {tag} | max_size={max_size}", r.res2d,
                       f"gseapy_{tag}_max{max_size}")
        return
    except Exception as e:
        print(f"[gseapy unavailable: {type(e).__name__}: {e}]")
    if not gmt:
        print("BLOCKED: no gseapy and no gene-set library.")
        print("To unblock, provide ONE of:")
        print("  1) network egress to maayanlab.cloud + `pip install gseapy` (then re-run this script), or")
        print("  2) the file data/GO_Biological_Process_2021.gmt (Enrichr library export, gene symbols).")
        sys.exit(2)
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    from nblib import Prerank, parse_gmt
    sets = parse_gmt(gmt)
    print(f"[using the validated gseapy-equivalent engine on {len(sets)} gene sets from {gmt}]")
    for tag, fn in RANKS.items():
        rnk = os.path.join(OUT, fn)
        if not os.path.exists(rnk):
            continue
        s = pd.read_csv(rnk, sep="\t", header=None, names=["Name", "Score"]).set_index("Name")["Score"]
        for max_size in (500, 1000):
            res = Prerank(s, sets, min_size=PARAMS["min_size"], max_size=max_size,
                          permutation_num=PARAMS["permutation_num"], seed=PARAMS["seed"]).run()
            report(f"gseapy-equivalent engine | {tag} | max_size={max_size}", res,
                   f"equivalent_{tag}_max{max_size}")


if __name__ == "__main__":
    main()
