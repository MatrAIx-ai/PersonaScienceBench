#!/usr/bin/env python3
"""CBD/cisplatin combination vs DMSO: differential expression + Enrichr-ready DE gene list.

Approved contrast: Group "Cisplatin_IC50_CBD_IC50" (9_1,9_2,9_3) vs "DMSO" (3_1,3_2,3_3);
DMSO = reference level; group is the only factor; sample 3_1 kept.
DE core: analysis/deseq_equiv.py = DESeq2-equivalent (median-of-ratios -> NB dispersion trend ->
NB GLM Wald -> BH + independent filtering); validated in analysis/core_calibration.csv because
neither R/DESeq2 nor pydeseq2 is provisioned here and the sandbox is offline.
Enrichment step: analysis/run_enrichment.py (gseapy Enrichr, Reactome_2022).
"""
import sys, json, warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")
sys.path.insert(0, "/workspace/analysis")
import deseq_equiv as de

OUT = "/workspace/analysis"
TREAT, REF = "Cisplatin_IC50_CBD_IC50", "DMSO"
LOG = []


def say(*a):
    txt = " ".join(str(x) for x in a)
    print(txt)
    LOG.append(txt)


# ---------------------------------------------------------------- 1. inputs
counts = pd.read_csv("/workspace/data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("/workspace/data/sample_layout.csv")
mapping = pd.read_csv("/workspace/data/ensg_to_gene_name.tsv", sep="\t")

say("== INPUTS ==")
say(f"counts: {counts.shape} dtypes={sorted(set(map(str, counts.dtypes)))} "
    f"dup_ENSG={int(counts.index.duplicated().sum())} NA={int(counts.isna().sum().sum())}")
say(f"mapping: {mapping.shape} dup_ENSG={int(mapping['ENSG'].duplicated().sum())} "
    f"dup_symbols={int(mapping['gene_name'].duplicated().sum())}")

layout["col"] = layout["SampleID"].str.replace("-", "_", regex=False)
assert list(layout["col"]) == list(counts.columns), "column/SampleID correspondence broken"
keep_groups = [TREAT, REF]
ann = layout[layout["Group"].isin(keep_groups)].copy()
say("\n== CONTRAST ==")
say(f"groups kept: {keep_groups}; samples: {list(ann['SampleID'])}")
say(ann[["SampleID", "col", "Group", "fileNames"]].to_string(index=False))

sub = counts[ann["col"].tolist()]
g_mask = (ann["Group"] == TREAT).values
say(f"treatment arm (combination) columns: {[c for c, m in zip(ann['col'], g_mask) if m]}")
say(f"reference arm (DMSO) columns:        {[c for c, m in zip(ann['col'], g_mask) if not m]}")

Y = sub.to_numpy(float)
lib = sub.sum(axis=0)
say("\n== LIBRARY SIZES ==")
say(json.dumps({c: int(v) for c, v in zip(sub.columns, lib)}))

# ---------------------------------------------------------------- 2. DE
res, meta = de.run_deseq(Y, g_mask)
res.index = counts.index
say("\n== SIZE FACTORS (median-of-ratios) ==")
sf_tbl = pd.DataFrame({"sample": ann["col"], "Group": ann["Group"],
                       "sizeFactor": np.round(meta["size_factors"], 6),
                       "librarySize": lib.values,
                       "depth_vs_mean_SF": np.round(meta["size_factors"] / np.mean(meta["size_factors"]), 4)})
say(sf_tbl.to_string(index=False))
say(f"all-zero genes: {meta['n_all_zero']} | genes with NaN p (all-zero/quasi-complete separation "
    f"{meta['n_separation']}): {meta['n_nan_p']}")
say(f"median final dispersion: {meta['median_dispersion']:.5f}")
say(f"DESeq2-style independent-filter baseMean cut: {meta['indep_filter_cut']:.4g} "
    f"-> genes with p but NaN padj after filtering: {meta['n_padj_NaN_by_filter']}")

# ---------------------------------------------------------------- 3. QC: PCA + clustering on 6 samples
K = Y / meta["size_factors"][None, :]
expr = K[(K.mean(axis=1) > 1)]
lv = np.log2(expr + 1)
keep_hi = lv[np.argsort(-lv.var(axis=1))[:2000]]
centred = keep_hi - keep_hi.mean(axis=1, keepdims=True)
U, S, Vt = np.linalg.svd(centred - centred.mean(axis=0, keepdims=True), full_matrices=False)
pcs = (Vt * S[:, None])[:5, :]               # (5 PCs, 6 samples) sample scores = v_i * s_i
var_expl = (S ** 2 / (S ** 2).sum())[:5]
say("\n== PCA of the 6 samples (log2 normalized counts, top 2000 variable genes) ==")
pcadf = pd.DataFrame(pcs.T, columns=[f"PC{i+1}" for i in range(5)], index=ann["col"])
pcadf["Group"] = ann["Group"].values
pcadf["var_expl"] = [round(float(v), 4) for v in var_expl[:1]] * 6
pcadf["arm"] = ["DMSO"] * 3 + ["combo"] * 3
say(pcadf.to_string())
say("PC1 separates the arms (sign of DMSO mean vs combo mean): " + str(bool(np.mean(pcs[0][:3]) * np.mean(pcs[0][3:]) < 0)))
from scipy.cluster.hierarchy import linkage, fcluster, dendrogram
from scipy.spatial.distance import pdist
d = pdist(keep_hi.T, metric="euclidean")
Zl = linkage(d, "average")
say("linkage distances (average, 6 samples): " + np.round(Zl[:, 2], 2).tolist().__str__())
say("2-cluster split: " + json.dumps(dict(zip(ann["col"], fcluster(Zl, 2, "maxclust").tolist()))))
pd.DataFrame(keep_hi, index=[f"g{i}" for i in range(keep_hi.shape[0])], columns=ann["col"]).to_csv(f"{OUT}/qc_log2_top2000.csv")

say("\n== DISPERSION TREND ON THE REAL DATA ==")
for mb in [1, 5, 10, 50, 100, 500, 1000, 5000]:
    sel = np.abs(np.log10(np.maximum(res["baseMean"].values, 1e-9)) - np.log10(mb)) < 0.05
    if sel.sum() > 20:
        say(f"baseMean~{mb:>6}: n={int(sel.sum()):>5} median gene-wise disp={np.median(res['dispersion_geneWise'].values[sel]):.4f} "
            f"median final disp={np.median(res['dispersion'].values[sel]):.4f}")

# ---------------------------------------------------------------- 4. thresholds
say("\n== THRESHOLD CASCADE (headline = raw p<0.05) ==")
p, lfc, bm = res["pvalue"].values, res["log2FoldChange"].values, res["baseMean"].values
padj, p_t, p_emp = res["padj"].values, res["pvalue_t_df"].values, res["pvalue_empirical_null"].values
steps = []
n_tested = int(np.isfinite(p).sum())
m1 = p < 0.05
m2 = m1 & (np.abs(lfc) > 0.5)
m3 = m2 & (bm > 10)
for lab, m in [("genes with a testable p-value (not all-zero / not separated)", np.isfinite(p)),
               ("+ p < 0.05", m1), ("+ |log2FC| > 0.5", m2), ("+ baseMean > 10  [HEADLINE DE SET]", m3)]:
    steps.append(dict(step=lab, n_genes=int(np.nansum(m)), pct_of_tested=round(100 * np.nansum(m) / n_tested, 2)))
say(pd.DataFrame(steps).to_string(index=False))
hh, edges = np.histogram(p[np.isfinite(p)], bins=np.array([0, .001, .01, .05, .1, .2, .3, .5, .7, 1.0]))
say("p-value histogram (tested genes): " + json.dumps({f"[{edges[i]},{edges[i+1]})": int(hh[i]) for i in range(len(hh))}))
up, down = int(np.nansum(m3 & (lfc > 0))), int(np.nansum(m3 & (lfc < 0)))
say(f"HEADLINE DE SET: n={int(np.nansum(m3))}  up={up}  down={down}")

sens = []
for lab, pv in [("raw p (headline)", p), ("padj<0.05 (sensitivity)", padj),
                ("padj no indep.filter (sensitivity)", res['padj_no_indep_filter'].values),
                ("t_df4 p (small-n calibrated)", p_t), ("empirical-null p (calibrated)", p_emp)]:
    mm = (pv < 0.05) & (np.abs(lfc) > 0.5) & (bm > 10)
    sens.append(dict(p_criterion=lab, n_DE=int(np.nansum(mm)),
                     up=int(np.nansum(mm & (lfc > 0))), down=int(np.nansum(mm & (lfc < 0)))))
say("\n== SENSITIVITY OF THE DE SET TO THE p-VALUE CRITERION ==")
say(pd.DataFrame(sens).to_string(index=False))

res_out = res.copy()
res_out.insert(0, "gene_symbol", mapping.set_index("ENSG")["gene_name"].reindex(res_out.index).values)
res_out.to_csv(f"{OUT}/deseq_results_all_genes.csv.gz", compression="gzip")
res_out.loc[m3].sort_values("pvalue").to_csv(f"{OUT}/de_genes_headline_rawP.csv")

# ---------------------------------------------------------------- 5. symbol mapping
say("\n== ENSG -> SYMBOL MAPPING OF THE HEADLINE DE SET ==")
de_res = res_out.loc[m3].copy()
n_de = len(de_res)
unmapped = de_res["gene_symbol"].isna() | (de_res["gene_symbol"].astype(str).str.strip() == "")
mapped = de_res.loc[~unmapped].copy()
say(f"DE genes: {n_de} | unmapped (no symbol, dropped): {int(unmapped.sum())} | mapped: {len(mapped)}")
mapped = mapped.sort_values("baseMean", ascending=False)
collapsed_symbols = int(mapped["gene_symbol"].duplicated().sum())
dedup = mapped.drop_duplicates("gene_symbol", keep="first")   # highest baseMean wins
say(f"duplicate symbols collapsed (kept highest baseMean ENSG): {collapsed_symbols} "
    f"-> final query size {len(dedup)}")
say("collapsed symbols (kept vs dropped ENSG/baseMean):")
tmp = mapped[mapped.duplicated("gene_symbol", keep=False)].sort_values(["gene_symbol", "baseMean"], ascending=[True, False])
if len(tmp):
    say(tmp.groupby("gene_symbol").apply(
        lambda d: "; ".join(f"{i}(bm={r.baseMean:.1f},lfc={r.log2FoldChange:+.2f})" for i, r in d.iterrows())
    ).head(25).to_string())

with open(f"{OUT}/de_gene_symbols.txt", "w") as fh:
    fh.write("\n".join(sorted(dedup["gene_symbol"].astype(str))) + "\n")
for lab, mask in [("rawP", m3), ("padj", padj), ("t_df4", p_t), ("empirical_null", p_emp)]:
    mm = (mask < 0.05) & (np.abs(lfc) > 0.5) & (bm > 10)
    d2 = res_out.loc[mm].dropna(subset=["gene_symbol"]).sort_values("baseMean", ascending=False).drop_duplicates("gene_symbol")
    with open(f"{OUT}/de_symbols_{lab}.txt", "w") as fh:
        fh.write("\n".join(sorted(d2["gene_symbol"].astype(str))) + "\n")
say(f"QUERY/BACKGROUND FRACTION: query = {len(dedup)} symbols = {100*len(dedup)/n_tested:.1f}% of the {n_tested} "
    f"testable genes in this contrast ({100*len(dedup)/len(res):.1f}% of the {len(res)} matrix rows). gseapy is called with "
    f"background=None, i.e. Enrichr's default whole-library universe, so the background already contains much of every "
    f"pathway's membership and odds ratios for a broad transcriptional response are expected to be modest (~1-2, not 5-20); "
    f"interpret them jointly with the P / adjusted-P / Overlap columns.")
say(f"query lists written: de_gene_symbols.txt (=de_symbols_rawP.txt, {len(dedup)} symbols) "
    f"plus de_symbols_padj.txt / de_symbols_t_df4.txt / de_symbols_empirical_null.txt")
say("\nhead of query list: " + ", ".join(sorted(dedup["gene_symbol"].astype(str))[:25]))
P53_GENES = {"TP53","CDKN1A","MDM2","MDM4","GADD45A","BBC3","SESN1","SESN2","SESN3","RRM2B","TP53I3","FAS","TNFRSF10B","ZMAT3","TP53INP1","RPS27L","GDF15","PHLDA3","TRIAP1","AEN","CCNG1","PLK3","TP53AIP1","BAX","CDKN2A","E2F1","E2F2","E2F3","CCNE1","CCNE2","CDC25A","CDC25B","CDC25C","MYC","USP7","TP53BP1","CHEK1","CHEK2","ATM","ATR","WEE1","RAD51","XPC","DDB2","POLH","RRM2","TYMS","MKI67","TOP2A","CCNB1","CCNB2","CDK1","PLK1","AURKA","AURKB","BUB1","CCNA2","MCM2","MCM3","MCM4","PCNA","RB1","TK1","FOXM1","CENPA","CENPF","KIF11","PRC1","UBE2C","BIRC5","CDC20","CDK1"}
p53 = [s for s in dedup["gene_symbol"].astype(str) if s.upper() in P53_GENES]
say(f"p53/cell-cycle genes present in the query list ({len(p53)}): {', '.join(sorted(p53))}")

summary = dict(contrast={"treatment": TREAT, "reference": REF, "treatment_cols": [c for c, m in zip(ann['col'], g_mask) if m],
                         "reference_cols": [c for c, m in zip(ann['col'], g_mask) if not m]},
               n_genes_tested=n_tested, size_factors=dict(zip(ann["col"], np.round(meta["size_factors"], 6).tolist())),
               nan_p_genes=meta["n_nan_p"], separation_genes=meta["n_separation"],
               padj_nan_by_indep_filter=meta["n_padj_NaN_by_filter"],
               de_counts=dict(p05=int(np.nansum(m1)), p05_lfc=int(np.nansum(m2)), headline=int(np.nansum(m3)),
                              up=up, down=down),
               sensitivity={r["p_criterion"]: r["n_DE"] for r in sens},
               unmapped_de_genes=int(unmapped.sum()), collapsed_symbols=collapsed_symbols,
               query_size=len(dedup),
               query_background_fraction=dict(query_symbols=len(dedup), testable_genes=n_tested,
                                              pct_of_testable=round(100*len(dedup)/n_tested, 2),
                                              matrix_rows=len(res), enrichment_background="Enrichr default (background=None)"),
               method="DESeq2-equivalent NumPy core (see core_calibration.csv)")
with open(f"{OUT}/summary.json", "w") as fh:
    json.dump(summary, fh, indent=2)
with open(f"{OUT}/run_analysis.log", "w") as fh:
    fh.write("\n".join(LOG) + "\n")
say("\nDONE")
