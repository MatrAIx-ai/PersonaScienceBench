#!/usr/bin/env python3
"""Calibration of the DESeq2-equivalent core (analysis/deseq_equiv.py) on NB simulations.

For each scenario it reports, under exactly the question's threshold combination
(p<0.05 & |log2FC|>0.5 & baseMean>10): the false-positive rate among true null genes and the
power to recover 5% spiked DE genes, for three reference distributions for the Wald statistic.
Writes analysis/core_calibration.csv.
"""
import sys, warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")
sys.path.insert(0, "/workspace/analysis")
import deseq_equiv as de

rng = np.random.default_rng(2024)
g = np.array([False] * 3 + [True] * 3)
sf_true = np.array([0.8, 1.1, 1.0, 0.9, 1.2, 1.0])
rows = []
for name in ["homog_0.05", "hetero_mean_dep", "low_counts", "high_disp", "realistic_depth"]:
    n = 20000
    mu0 = 10 ** rng.uniform(-1, 4, n)
    if name == "low_counts":
        mu0 = 10 ** rng.uniform(-1.5, 2.5, n)
    if name == "realistic_depth":
        mu0 = 10 ** rng.uniform(-1, 5, n) * rng.uniform(0.2, 1, n)
    at = {"homog_0.05": np.full(n, 0.05),
          "hetero_mean_dep": np.clip(0.02 + 0.3 / np.sqrt(mu0) * rng.uniform(.5, 1.5, n), 1e-3, 1),
          "low_counts": np.full(n, 0.1),
          "high_disp": np.clip(rng.uniform(.01, .3, n), 1e-3, 1),
          "realistic_depth": np.clip(0.05 / (0.2 + mu0) ** 0.15 * rng.uniform(.6, 1.6, n), 1e-3, 1)}[name]
    tlfc = np.zeros(n)
    didx = rng.choice(n, 300, replace=False)
    tlfc[didx] = rng.choice([-1.5, -1, 1, 1.5], 300)
    mu = mu0[:, None] * sf_true[None, :] * np.where(g[None, :], np.exp2(tlfc)[:, None], 1.0)
    k = (1.0 / at)[:, None]
    Y = rng.negative_binomial(k, k / (k + mu)).astype(float)
    null = np.ones(n, bool); null[didx] = False
    res, _ = de.run_deseq(Y, g)
    bm, lfc = res["baseMean"].values, res["log2FoldChange"].values
    for lab, col in [("normal (DESeq2 Wald)", "pvalue"), ("t_df4", "pvalue_t_df"),
                     ("empirical_null", "pvalue_empirical_null")]:
        pv = res[col].values
        sel = (pv < 0.05) & (np.abs(lfc) > 0.5) & (bm > 10)
        fp, tp = int(sel[null].sum()), int(sel[didx].sum())
        rows.append(dict(scenario=name, reference=lab,
                         typeI_unthresholded=round(float(np.nanmean(pv[null] < 0.05)), 4),
                         FP_rate_at_thresholds=round(fp / max(1, int((bm[null] > 10).sum())), 4),
                         power_at_thresholds=round(tp / 300, 3),
                         n_called_DE=int(sel.sum())))
tab = pd.DataFrame(rows)
print(tab.to_string(index=False))
print("\nmean over scenarios:")
print(tab.groupby("reference")[["typeI_unthresholded", "FP_rate_at_thresholds", "power_at_thresholds"]].mean().round(4).to_string())
tab.to_csv("/workspace/analysis/core_calibration.csv", index=False)
