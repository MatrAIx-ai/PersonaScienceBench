#!/usr/bin/env python3
"""REQUIRED enrichment step: gseapy Enrichr against Reactome_2022 on the pooled DE gene list.

Run as soon as Enrichr is reachable (network + `pip install gseapy`):
    python3 analysis/run_enrichment.py
Nothing is computed locally: gseapy/Enrichr's own Fisher `Odds Ratio` is the required statistic,
so there is deliberately no offline stand-in (per the agreed protocol).

Query = pooled up+down DE symbols (p<0.05, |log2FC|>0.5, baseMean>10) -> analysis/de_gene_symbols.txt
Sensitivity lists: de_symbols_padj.txt / de_symbols_t_df4.txt / de_symbols_empirical_null.txt
"""
import json, os, sys, time, traceback, urllib.parse, urllib.request

OUT = "/workspace/analysis"
QUERY = f"{OUT}/de_gene_symbols.txt"
ENRICHR = "https://maayanlab.cloud/Enrichr"
LIBRARY = "Reactome_2022"
P53_PATTERNS = ["p53", "tp53", "g1/s", "cell cycle", "cell-cycle", "dna damage"]


def load_genes(path):
    with open(path) as fh:
        return [l.strip() for l in fh if l.strip()]


def via_gseapy(genes):
    import gseapy
    enr = gseapy.enrich(gene_list=genes, gene_sets=LIBRARY, organism="human",
                        background=None, outdir=None, no_plot=True, threads=2)
    res = enr.res2d.copy()
    res.to_csv(f"{OUT}/enrichr_reactome2022_full_results.csv", index=False)
    return res


def via_rest(genes):  # same Enrichr service gseapy wraps, used if the package is missing
    qs = "\n".join(genes)
    url = ENRICHR + "/addList?" + urllib.parse.urlencode({"list": qs, "description": "CBD+cisplatin vs DMSO DE genes"})
    with urllib.request.urlopen(url, timeout=60) as r:
        uid = json.load(r)["userListId"]
    with urllib.request.urlopen(ENRICHR + "/enrich", data=json.dumps({"userListId": uid, "backgroundType": LIBRARY}).encode(),
                                headers={"Content-Type": "application/json"}, timeout=180) as r:
        data = json.load(r)[LIBRARY]
    cols = ["Term", "Overlap", "P-value", "Adjusted P-value", "Old P-value", "Adjusted Old P-value",
            "Odds Ratio", "Combined Score", "Genes"]
    res = __import__("pandas").DataFrame([dict(zip(cols, row[1:])) for row in data])
    res["Term"] = [t.split("_x")[0] for t in res["Term"]]
    res.to_csv(f"{OUT}/enrichr_reactome2022_full_results.csv", index=False)
    return res


def select_p53_terms(res):
    p = "|".join(P53_PATTERNS)
    m = res[res["Term"].str.contains(p, case=False, regex=True, na=False)]
    p53ish = m[m["Term"].str.contains("p53|tp53", case=False, na=False)]
    strict = p53ish[p53ish["Term"].str.contains("cell cycle|cell-cycle|g1/s|gene regulation|dna damage", case=False, na=False)]
    return m, strict


def via_local_gmt(genes, gmt_path):
    """OFFLINE APPROXIMATION - only reachable if gseapy itself imports AND the caller supplies a
    Reactome_2022 .gmt. Enrichr's own odds ratio is a Fisher OR against the library universe, so this
    is close but NOT identical (Enrichr's gene universe/background may differ). Any output of this
    path must be labelled 'APPROXIMATION - local gmt, not the Enrichr service'."""
    import gseapy
    enr = gseapy.enrich(gene_list=genes, gene_sets=gmt_path, organism="human", background=None,
                        outdir=None, no_plot=True)
    res = enr.res2d.copy()
    res["note"] = "APPROXIMATION - local gmt, not the Enrichr service"
    res.to_csv(f"{OUT}/reactome2022_local_gmt_APPROXIMATION.csv", index=False)
    return res


if __name__ == "__main__":
    query = QUERY
    for i, a in enumerate(sys.argv):
        if a == "--gene-list" and i + 1 < len(sys.argv):
            query = sys.argv[i + 1]
    genes = load_genes(query)
    print(f"query genes: {len(genes)}")
    attempts, res = [], None
    paths = [("gseapy.enrich(gene_sets='Reactome_2022')", lambda gl: via_gseapy(gl)),
             ("Enrichr REST API (same service gseapy calls)", lambda gl: via_rest(gl))]
    gmt = next((sys.argv[i + 1] for i, a in enumerate(sys.argv) if a == "--local-gmt"), None)
    if gmt:
        paths.append((f"local gmt via gseapy (APPROXIMATION): {gmt}", lambda gl, g=gmt: via_local_gmt(gl, g)))
    for name, fn in paths:
        try:
            res = fn(genes)
            print("SUCCESS via", name)
            break
        except BaseException as e:
            attempts.append({"path": name, "error": f"{type(e).__name__}: {e}"})
            print(f"FAILED via {name}: {type(e).__name__}: {e}")
    if res is None:
        # never clobber the curated ENRICHR_BLOCKER.txt; per-attempt details go to its own file
        with open(f"{OUT}/ENRICHR_ATTEMPT_LATEST.txt", "w") as fh:
            fh.write("Enrichr / gseapy could not be reached from the analysis sandbox.\n")
            fh.write(f"query file : {QUERY} ({len(genes)} symbols)\n")
            fh.write(f"library    : {LIBRARY}\n")
            fh.write(f"UTC time   : {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\n\n")
            for a in attempts:
                fh.write(f"[{a['path']}]\n  {a['error']}\n")
            fh.write("\nRaw probes run earlier in this session:\n"
                     "  pip install gseapy            -> ERROR: Could not find a version that satisfies the "
                     "requirement gseapy (Temporary failure in name resolution / no versions available)\n"
                     "  GET https://maayanlab.cloud/Enrichr/datasetStatistics -> URLError: [Errno -3] "
                     "Temporary failure in name resolution\n"
                     "  GET https://pypi.org/simple/gseapy/                  -> URLError: [Errno -3] "
                     "Temporary failure in name resolution\n"
                     "  TCP connect 1.1.1.1:443, 8.8.8.8:53, 104.16.132.229:443, 151.101.0.223:443 "
                     "-> OSError: [Errno 101] Network is unreachable\n"
                     "  installed packages: numpy, pandas, scipy, statsmodels only (no gseapy, no pydeseq2, no R)\n\n"
                     "No odds ratio is reported: a locally recomputed Fisher OR is NOT an acceptable substitute "
                     "for the Enrichr statistic, per protocol.\n")
        print("Blocker detail written to analysis/ENRICHR_ATTEMPT_LATEST.txt")
        sys.exit(2)
    m, strict = select_p53_terms(res)
    print("\n=== candidate p53 / cell-cycle rows ===")
    print(m.to_string(index=False))
    pick = (strict if len(strict) else m)
    pick = pick.sort_values("P-value").head(1)
    print("\nPRIMARY ANSWER ROW:")
    print(pick.to_string(index=False))
