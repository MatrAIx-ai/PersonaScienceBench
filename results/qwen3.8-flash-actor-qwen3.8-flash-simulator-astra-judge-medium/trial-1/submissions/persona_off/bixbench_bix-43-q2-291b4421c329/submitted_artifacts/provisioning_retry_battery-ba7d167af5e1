#!/usr/bin/env python3
"""Bounded, documented retry battery for obtaining gseapy / Reactome_2022 / Enrichr.

Every attempt is recorded with the exact command and full stderr/stdout. Run:
    python3 analysis/probe_provisioning.py
Writes analysis/RETRY_LOG.txt (and returns non-zero if nothing succeeded).
"""
import glob, io, json, os, shutil, socket, subprocess, sys, time, traceback
import urllib.parse, urllib.request

OUT = "/workspace/analysis"
LOG = []
QUERY = f"{OUT}/de_gene_symbols.txt"
NET_ONLY = "--net-only" in sys.argv
MIRRORS = ["https://pypi.tuna.tsinghua.edu.cn/simple", "https://mirrors.aliyun.com/pypi/simple",
           "https://mirrors.cloud.tencent.com/pypi/simple", "https://repo.huaweicloud.com/repository/pypi/simple"]
MODS = ["gseapy", "pydeseq2", "requests", "biopython", "Bio", "statsmodels"]


def run(label, cmd, timeout=90, shell=True):
    t0 = time.time()
    try:
        p = subprocess.run(cmd, shell=shell, capture_output=True, text=True, timeout=timeout)
        out, err, rc = p.stdout.strip(), p.stderr.strip(), p.returncode
    except Exception as e:
        out, err, rc = "", f"{type(e).__name__}: {e}", -1
    LOG.append({"attempt": label, "command": cmd, "exit_code": rc,
                "seconds": round(time.time() - t0, 1), "stdout": out[:1500], "stderr": err[:2000]})
    print(f"[{rc:>3}] {label}\n     $ {cmd}\n     {err.strip().splitlines()[-1][:160] if err.strip() else out.strip().splitlines()[-1][:160] if out.strip() else ''}")
    return rc, out, err


if not NET_ONLY:
  print("=== 1. environment / resolver state ===")
  run("env: proxy / pip / index / http variables", "env | grep -i -E 'proxy|pip|index|http|no_proxy' || echo '(none defined)'")
  run("pip config list", "python3 -m pip config list -v 2>&1 | head -20")
  run("pip config files", "ls -l /etc/pip.conf ~/.pip/pip.conf ~/.config/pip/pip.conf /etc/xdg/pip/pip.conf 2>&1 | tail -6; cat /etc/pip.conf ~/.config/pip/pip.conf 2>&1 | head -20")
  run("~/.netrc credentials file", "ls -l ~/.netrc /root/.netrc 2>&1; cat ~/.netrc 2>&1 | sed 's/password.*/password <redacted>/' | head -10")
  run("/etc/resolv.conf", "cat /etc/resolv.conf 2>&1")
  run("/etc/hosts", "cat /etc/hosts 2>&1")
  run("resolvectl / systemd-resolved", "resolvectl status 2>&1 | head -12")
  run("network interfaces + routes", "ip -o addr 2>&1 | head; ip route 2>&1 | head; cat /proc/net/route 2>&1 | head -5")
  run("DNS resolution attempt (getent)", "getent hosts maayanlab.cloud 2>&1; getent hosts pypi.org 2>&1; python3 -c \"import socket;print(socket.gethostbyname('pypi.org'))\" 2>&1 | tail -1")

if not NET_ONLY:
  print("\n=== 2. provisioning routes for gseapy ===")
  run("pip install gseapy (default index)", "python3 -m pip install gseapy 2>&1", timeout=180)
  run("pip install gseapy --retries 3 --timeout 30", "python3 -m pip install --retries 3 --timeout 30 gseapy 2>&1", timeout=240)
  run("pip download gseapy --no-deps", "python3 -m pip download --no-deps gseapy -d /workspace/analysis/_wheels 2>&1", timeout=180)
  for mirror in MIRRORS:
    run(f"pip install gseapy --index-url {mirror}",
        f"python3 -m pip install --no-deps --index-url {mirror} gseapy 2>&1", timeout=120)
  run("pip cache contents", "python3 -m pip cache dir 2>&1; python3 -m pip cache list 2>&1 | head -10; ls -l $(python3 -m pip cache dir 2>/dev/null) 2>&1 | head -5")
  run("wheel/sdist already on disk (same fs)", "find / -xdev \\( -iname 'gseapy*' -o -iname 'pydeseq*' -o -iname '*.whl' -o -iname 'enrichr*' -o -iname '*reactome*' \\) -not -path '/proc/*' 2>/dev/null | head -30")
  run("wheel/sdist anywhere incl. other mounts", "find / \\( -iname 'gseapy*' -o -iname '*.whl' -o -iname 'Reactome*' -o -iname '*.gmt*' -o -iname '*gene_set*' \\) -not -path '/proc/*' 2>/dev/null | head -40")
  run("conda / R environments anywhere", "find / -maxdepth 4 -name 'conda' -o -maxdepth 4 -name 'R' -type f 2>/dev/null | head; ls /usr/lib/R /usr/local/lib/R 2>&1 | head -4")
  run("site-packages mirrors / other envs", "ls -d /usr/lib/python3/dist-packages /usr/local/lib/python3*/*-packages /opt/*/lib/python*/site-packages ~/.local/lib/python*/site-packages /opt/conda /opt/venv /venv 2>&1 | head -20")
  run("alt interpreters / package managers / R", "command -v R Rscript conda mamba micromamba uv poetry pipx 2>&1; ls /usr/bin/python* 2>&1")
  for mod in MODS:
      rc, out, err = run(f"import {mod}", f"python3 -c 'import {mod}; print(\"{mod} OK\", getattr({mod},\"__version__\",\"?\"))' 2>&1 | tail -1")
  run("offline Enrichr library shipped with gseapy", "python3 -c \"import gseapy, os; print(os.path.join(os.path.dirname(gseapy.__file__),'db'))\" 2>&1 | tail -1")

print("\n=== 3. Enrichr / gene-set hosts, direct and via any proxy ===")
proxies = {k: v for k, v in os.environ.items() if "proxy" in k.lower()}
LOG.append({"attempt": "proxy environment map", "command": "(env)", "exit_code": 0, "seconds": 0,
            "stdout": json.dumps(proxies) or "{}", "stderr": ""})
print("proxy env vars defined:", proxies or "NONE")

genes = [l.strip() for l in open(QUERY) if l.strip()]


def http(label, url, data=None, headers=None, timeout=15, proxy=None):
    cmd = f"GET/POST {url}" if data is None else f"POST {url} ({len(data)} bytes)"
    try:
        req = urllib.request.Request(url, data=data, headers=headers or {})
        if proxy:
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({k.lower(): v for k, v in proxy.items()}))
            ctx = opener.open
        else:
            ctx = urllib.request.urlopen
        with ctx(req, timeout=timeout) as r:
            body = r.read(400)
        ok(label, cmd, f"HTTP {r.status}, {len(body)} bytes head={body[:80]!r}")
        return True
    except Exception as e:
        LOG.append({"attempt": label, "command": cmd, "exit_code": 1, "seconds": 0, "stdout": "",
                    "stderr": f"{type(e).__name__}: {e}"})
        print(f"[  1] {label}\n     $ {cmd}\n     {type(e).__name__}: {str(e)[:140]}")
        return False


def ok(label, cmd, msg):
    LOG.append({"attempt": label, "command": cmd, "exit_code": 0, "seconds": 0, "stdout": msg, "stderr": ""})
    print(f"[  0] {label}\n     $ {cmd}\n     {msg}")


E = "https://maayanlab.cloud/Enrichr"
success = None
success = http("Enrichr datasetStatistics (GET)", E + "/datasetStatistics")
if not success and proxies:
    success = http("Enrichr datasetStatistics via proxy", E + "/datasetStatistics", proxy=proxies)
if not success:
    # explicit localhost / standard proxy ports, in case a proxy exists but is unset in env
    for port in (3128, 8888, 8080, 1080, 8118):
        s = socket.socket(); s.settimeout(2)
        try:
            s.connect(("127.0.0.1", port))
            ok(f"local proxy port {port} open", f"connect 127.0.0.1:{port}", "open - will retry Enrichr through it")
            if http(f"Enrichr via local proxy :{port}", E + "/datasetStatistics", proxy={"http": f"http://127.0.0.1:{port}", "https": f"http://127.0.0.1:{port}"}):
                success = True
                break
        except Exception as e:
            LOG.append({"attempt": f"local proxy port {port}", "command": f"connect 127.0.0.1:{port}", "exit_code": 1,
                        "seconds": 0, "stdout": "", "stderr": f"{type(e).__name__}: {e}"})
        finally:
            s.close()
    success = success or None

if success:
    try:
        payload = urllib.parse.urlencode({"list": "\n".join(genes), "description": "CBD+cisplatin vs DMSO DE"}).encode()
        with urllib.request.urlopen(E + "/addList", data=payload, timeout=60) as r:
            uid = json.load(r)["userListId"]
        body = json.dumps({"userListId": uid, "backgroundType": "Reactome_2022"}).encode()
        req = urllib.request.Request(E + "/enrich", data=body, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=300) as r:
            data = json.load(r)
        with open(f"{OUT}/enrichr_raw_response.json", "w") as fh:
            json.dump(data, fh)
        ok("Enrichr REST enrich with the 1680-symbol list", "POST /addList + POST /enrich", f"userListId={uid}, Reactome_2022 rows={len(data['Reactome_2022'])}")
        ENRICHR_OK = True
    except Exception as e:
        LOG.append({"attempt": "Enrichr REST addList/enrich", "command": "POST /addList + /enrich", "exit_code": 1,
                    "seconds": 0, "stdout": "", "stderr": f"{type(e).__name__}: {e}"})
        ENRICHR_OK = False
else:
    ENRICHR_OK = False

for label, url in [
    ("Enrichr REST /descriptor", E + "/descriptor"),
    ("Enrichr static gene-set archive (Reactome_2022 .gmt)", "https://maayanlab.cloud/static/gene_sets/Reactome_2022.txt"),
    ("Enrichr geneSetLibrary export", E + "/geneSetLibrary?mode=text&libraryName=Reactome_2022"),
    ("pypi simple index", "https://pypi.org/simple/gseapy/"),
    ("gseapy GitHub release archive", "https://codeload.github.com/zqfang/GSEApy/tar.gz/refs/heads/master"),
    ("Reactome official pathway export", "https://reactome.org/download/current/ReactomePathways.gmt.zip"),
    ("mirror: tuna pypi json", "https://pypi.tuna.tsinghua.edu.cn/pypi/gseapy/json"),
    ("conda-forge repodata", "https://conda.anaconda.org/conda-forge/noarch/repodata.json"),
]:
    http(label, url, timeout=15)

# raw IP connectivity + IPv6, to distinguish 'no DNS' from 'no network at all'
for host, port in [("1.1.1.1", 443), ("8.8.8.8", 53), ("151.101.64.223", 443), ("2606:4700:4700::1111", 53)]:
    s = socket.socket(socket.AF_INET6 if ":" in host else socket.AF_INET); s.settimeout(6)
    try:
        s.connect((host, port)); ok(f"raw TCP {host}:{port}", f"connect {host}:{port}", "reachable")
    except Exception as e:
        LOG.append({"attempt": f"raw TCP {host}:{port}", "command": f"connect {host}:{port}", "exit_code": 1,
                    "seconds": 0, "stdout": "", "stderr": f"{type(e).__name__}: {e}"})
        print(f"[  1] raw TCP {host}:{port} -> {type(e).__name__}: {str(e)[:100]}")
    finally:
        s.close()

with open(f"{OUT}/RETRY_LOG.txt", "w") as fh:
    fh.write("Provisioning / connectivity retry log\n")
    fh.write(f"UTC: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}   python: {sys.version.split()[0]}   cwd: {os.getcwd()}\n")
    fh.write(f"query file: {QUERY} ({len(genes)} symbols)\n")
    fh.write("=" * 100 + "\n\n")
    for a in LOG:
        fh.write(f"### {a['attempt']}\n$ {a['command']}\nexit={a['exit_code']}  ({a['seconds']}s)\n")
        if a["stdout"]:
            fh.write("--- stdout ---\n" + a["stdout"] + "\n")
        if a["stderr"]:
            fh.write("--- stderr ---\n" + a["stderr"] + "\n")
        fh.write("\n")
n_fail = sum(1 for a in LOG if a["exit_code"] not in (0, None))
print(f"\nattempts logged: {len(LOG)}; failures: {n_fail}; Enrichr usable: {bool(ENRICHR_OK)}")
print("wrote analysis/RETRY_LOG.txt")
sys.exit(0 if ENRICHR_OK else 3)
