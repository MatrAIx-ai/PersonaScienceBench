#!/usr/bin/env python3
"""bixbench bix-43-q5  --  CBD/cisplatin combination: DE + enrichment (offline).

Executed end-to-end by this script; stdout duplicated to out/run_log.txt.
  1  inputs + schema checks
  2  DESeq2-equivalent NB2 GLM (deseq_engine.py) on filtered raw counts, all 30 samples
  3  validation: simulation with known truth + permutation calibration on real counts
  4  PRIMARY 9 Cisplatin_IC50_CBD_IC50 vs 1 Untreated; SENSITIVITY 9v3, 10v4, 10v2
     PRIMARY threshold raw p<0.05, SENSITIVITY padj(BH)<0.05; both |log2FC|>0.5,
     baseMean>10
  5  ENSG -> symbol, duplicates collapsed by max baseMean, full accounting
  6  enrichment: gseapy.enrichr(gene_sets='Reactome_2022') attempted; gseapy/network/
     gene-set library are absent here, so a HAND-CURATED marker panel (marker_panel.py,
     membership printed in out/marker_panel_membership.txt) is scored with the same
     Enrichr-style hypergeometric + BH and LABELLED as a substitute, not Reactome.
  7  knowledge-free co-expression modules of the DE genes (supporting evidence)
"""
import json, os, sys
import numpy as np, pandas as pd
from scipy.stats import hypergeom, mannwhitneyu
from statsmodels.stats.multitest import multipletests
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from deseq_engine import run_deseq
from marker_panel import PANELS

ROOT, OUT = "/workspace", "/workspace/analysis/out"
os.makedirs(OUT, exist_ok=True)
logf = open(f"{OUT}/run_log.txt", "w", buffering=1)
T = {}
def log(*a):
    m = " ".join(str(x) for x in a); print(m); logf.write(m + "\n")
with open(f"{OUT}/marker_panel_membership.txt", "w") as fh:
    for k, v in PANELS.items():
        fh.write(f"{k}\t{len(v)}\t{' '.join(v)}\n")

# ------------------------------------------------------------------ 1. inputs
cnt = pd.read_csv(f"{ROOT}/data/counts_raw_unfiltered.csv", index_col=0)
lay = pd.read_csv(f"{ROOT}/data/sample_layout.csv")
mp = pd.read_csv(f"{ROOT}/data/ensg_to_gene_name.tsv", sep="\t")
log(f"[1] counts {cnt.shape}  layout {lay.shape}  map {mp.shape}")
assert np.all(cnt.values == np.floor(cnt.values)) and cnt.isna().sum().sum() == 0
lay["col"] = lay.SampleID.str.replace("-", "_", regex=False)
assert set(lay.col) == set(cnt.columns)
lay = lay.set_index("col").loc[cnt.columns]
fn = {g: int(lay.index[lay.Group == g][0].split("_")[0]) for g in set(lay.Group)}
groups = sorted(fn, key=lambda g: fn[g])
gidx = np.array([groups.index(g) for g in lay.Group])
log("    groups: " + "; ".join(f"{i}={g}(n={int((gidx==i).sum())})" for i, g in enumerate(groups)))
X = cnt.values.T.astype(np.int64)
sym_of = mp.drop_duplicates("ENSG").set_index("ENSG")["gene_name"]

# ------------------------------------------------------------------ 2. DE fit
keep = (X >= 5).sum(axis=0) >= 3
log(f"[2] pre-filter (>=5 counts in >=3 samples): {keep.sum()}/{X.shape[1]} genes")
F = run_deseq(X[:, keep], gidx, len(groups), disp_mode="shrunk")
obj = F["obj"]
bm_all = (X / F["sf"][:, None]).mean(axis=0)
log(f"    size factors {F['sf'].min():.3f}-{F['sf'].max():.3f}; baseMean>10 (all genes)={(bm_all>10).sum()}")
log(f"    trend a0={F['trend_par'][0]:.4g} a1={F['trend_par'][1]:.4g}; disp pctl(10,50,90) "
    f"gene-wise {np.percentile(F['gene_wise'],[10,50,90]).round(4)} shrunk {np.percentile(F['shrunk'],[10,50,90]).round(4)}")

# --------------------------------------------------------- 3. cheap validation
def simulate(seed=7, G=2000, K=10, N=3):
    rng = np.random.default_rng(seed); S = K * N; gi = np.repeat(np.arange(K), N)
    sf = rng.uniform(0.4, 1.8, S); base = np.exp(rng.normal(5.5, 1.8, G))
    disp = np.clip(rng.gamma(2, 0.05, G), 1e-3, 1); D = np.zeros((K, G))
    de = rng.choice(G, 100, replace=False); D[8, de] = rng.choice([-1.5, -.8, .8, 1.5], 100)
    mu = base[None, :] * np.exp(D)[gi] * sf[:, None]
    C = np.clip(rng.poisson(rng.gamma(1 / disp[None, :], disp[None, :] * mu)), 0, None).astype(np.int64)
    return C, gi, K, sf, disp, de, D
C, gi, K, sf_t, disp_t, de_t, D = simulate()
v = run_deseq(C, gi, K); cv = np.zeros(K); cv[8] = 1; cv[0] = -1
lfc_v, _, _, p_v = v["obj"].wald(cv)
nulls = []
for a, b in [(2, 3), (4, 5), (6, 7)]:
    cn = np.zeros(K); cn[a] = 1; cn[b] = -1
    nulls.append(round(float((v["obj"].wald(cn)[3] < 0.05).mean()), 4))
truth = np.zeros(len(p_v), bool); truth[de_t] = True; sv = v["baseMean"] > 10
pw = multipletests(p_v, method="fdr_bh")[1]
alt = run_deseq(C, gi, K, disp_mode="gene_wise"); p_alt = alt["obj"].wald(cv)[3]
A, B = set(np.where((p_v < .05) & sv)[0]), set(np.where((p_alt < .05) & sv)[0])
T["validation_simulation"] = dict(
    size_factor_log_corr=round(float(np.corrcoef(np.log(v["sf"]), np.log(sf_t))[0, 1]), 4),
    null_frac_p_lt_05=nulls,
    power_rawp=round(float(((p_v < .05) & sv & truth).sum() / (truth & sv).sum()), 3),
    empirical_fdr_rawp=round(float(((p_v < .05) & sv & ~truth).sum() / max(((p_v < .05) & sv).sum(), 1)), 3),
    power_padj=round(float(((pw < .05) & sv & truth).sum() / (truth & sv).sum()), 3),
    empirical_fdr_padj=round(float(((pw < .05) & sv & ~truth).sum() / max(((pw < .05) & sv).sum(), 1)), 3),
    median_abs_log2FC_error=round(float(np.median(np.abs(lfc_v[truth] - D[8][truth] / np.log(2)))), 3),
    jaccard_vs_unshrunken_NB_GLM=round(len(A & B) / len(A | B), 3))
log("[3] validation (simulation, known truth): " + json.dumps(T["validation_simulation"]))
rng = np.random.default_rng(0); perm = []
for _ in range(3):
    g2 = gidx.copy(); rng.shuffle(g2)
    fp = run_deseq(X[:, keep], g2, len(groups))
    c2 = np.zeros(len(groups)); c2[8] = 1; c2[0] = -1
    pp = fp["obj"].wald(c2)[3]; s2 = fp["baseMean"] > 10
    perm.append(round(float(np.mean(pp[s2] < 0.05)), 4))
T["permutation_calibration_real_data"] = perm
log(f"    permutation calibration on the real counts (labels shuffled 3x): frac p<0.05 = {perm} (target 0.05)")

# ------------------------------------------------- 4. contrasts, 5. selection
LABEL = {"9_vs_1": (8, 0), "9_vs_3": (8, 2), "10_vs_4": (9, 3), "10_vs_2": (9, 1)}
res_all = {}
for nm, (a, b) in LABEL.items():
    c = np.zeros(len(groups)); c[a] = 1; c[b] = -1
    lfc, se, st, p = obj.wald(c)
    r = pd.DataFrame({"ENSG": cnt.index[keep], "baseMean": F["baseMean"], "log2FC": lfc,
                      "lfcSE": se, "stat": st, "pvalue": p})
    r["padj"] = multipletests(np.nan_to_num(p, nan=1.0), method="fdr_bh")[1]
    r["symbol"] = r.ENSG.map(sym_of)
    res_all[nm] = r
    r.sort_values("pvalue").to_csv(f"{OUT}/results_full_{nm}.csv", index=False)

def select(r, pcol, thr=0.05, lfct=0.5, bmt=10.0):
    d = r[(r[pcol] < thr) & (r.log2FC.abs() > lfct) & (r.baseMean > bmt)].copy()
    n_all = len(d); up = int((d.log2FC > 0).sum())
    d = d[d.symbol.notna()]; n_map = len(d)
    d = d.sort_values("baseMean", ascending=False).drop_duplicates("symbol", keep="first")
    return d.sort_values("pvalue"), dict(
        n_DE=n_all, n_up=up, n_down=n_all - up, n_unmapped_dropped=n_all - n_map,
        n_dup_symbols_collapsed=n_map - len(d), n_symbols=len(d),
        pct_of_baseMean_gt10=round(100 * n_all / float((r.baseMean > bmt).sum()), 2))
PRIMARY = "9_vs_1"; sel = {}
for nm, r in res_all.items():
    for pcol in ("pvalue", "padj"):
        d, info = select(r, pcol); sel[(nm, pcol)] = (d, info)
        T.setdefault("lists", {})[f"{nm}|{pcol}"] = info
d_raw, i_raw = sel[(PRIMARY, "pvalue")]; d_pad, i_pad = sel[(PRIMARY, "padj")]
d_raw.to_csv(f"{OUT}/DE_primary_rawp.csv", index=False)
d_pad.to_csv(f"{OUT}/DE_primary_padj.csv", index=False)
d_raw[["ENSG", "symbol", "log2FC", "baseMean", "pvalue"]].to_csv(
    f"{OUT}/enrichment_input_symbols.txt", sep="\t", index=False)
for tag, d in (("rawp", d_raw), ("padj", d_pad)):
    open(f"{OUT}/symbols_primary_{tag}.txt", "w").write("\n".join(map(str, d.symbol)) + "\n")
    open(f"{OUT}/symbols_primary_{tag}_up.txt", "w").write("\n".join(map(str, d.loc[d.log2FC > 0, "symbol"])) + "\n")
    open(f"{OUT}/symbols_primary_{tag}_down.txt", "w").write("\n".join(map(str, d.loc[d.log2FC < 0, "symbol"])) + "\n")
log(f"[5] denominator baseMean>10 = {int((F['baseMean'] > 10).sum())} testable genes")
for k, v2 in T["lists"].items():
    log(f"    {k:16s} {v2}")

# ---------------------------------------------------------------- 6. enrichment
BG = sorted(set(res_all[PRIMARY].loc[res_all[PRIMARY].symbol.notna(), "symbol"]))
BGset = set(BG); Nbg = len(BG)
log(f"[6] enrichment stage; background = symbol-mapped pre-filtered genes = {Nbg}")
def hyper(genes, sets, K=None):
    q = {str(g).upper() for g in genes if isinstance(g, str)}; K = len(q); rows = []
    for t, mem in sets.items():
        s = {g for g in mem if g in BGset}
        if not s: continue
        k = len(q & s)
        p = float(hypergeom.sf(k - 1, Nbg, len(s), K))
        a, b_, c_ = k, len(s) - k, K - k
        d_ = Nbg - len(s) - c_
        orr = (a * d_) / (b_ * c_) if (b_ > 0 and c_ > 0 and d_ > 0) else np.inf
        rows.append(dict(Term=t, TermSize=len(s), Overlap=k, Overlap_ratio=round(k/len(s), 4),
                         Expected=round(len(s) * K / Nbg, 2), OddsRatio=round(orr, 2), P_Value=p, N_query=K))
    d = pd.DataFrame(rows)
    d["Adjusted_P_Value"] = multipletests(d.P_Value, method="fdr_bh")[1]
    return d.sort_values(["Adjusted_P_Value", "P_Value"])
ENGINE, engine_used = None, None
try:
    import gseapy
    def ENGINE(genes):
        e = gseapy.enrichr(gene_list=list(genes), gene_sets="Reactome_2022", organism="human",
                           outdir=f"{OUT}/gseapy_Reactome2022")
        return e.results.sort_values("Adjusted P-value")
    engine_used = "gseapy.enrichr(gene_sets='Reactome_2022', organism='human')"
    log("    gseapy available -> running Enrichr")
except Exception as e:
    log(f"    gseapy unavailable: {e!r}")
    gmt = next((p for p in [f"{ROOT}/data/Reactome_2022.gmt", f"{ROOT}/analysis/Reactome_2022.gmt",
                            f"{ROOT}/Reactome_2022.gmt"] if os.path.exists(p)), None)
    if gmt:
        sets = {l.split("\t")[0]: set(l.rstrip("\n").split("\t")[2:]) for l in open(gmt)}
        ENGINE = lambda g: hyper(g, sets); engine_used = f"local hypergeometric on {gmt} (Reactome library substitute)"
    else:
        ENGINE = lambda g: hyper(g, PANELS)
        engine_used = ("LOCAL HYPERGEOMETRIC ON HAND-CURATED MARKER PANEL "
                       "(substitute for gseapy/Reactome_2022; NOT Reactome output)")
    log(f"    gene-set library on disk: {gmt}")
log(f"    ENGINE = {engine_used}")
rows = []
for (nm, pcol), (d, info) in sel.items():
    r = ENGINE(d.symbol)
    r = r.rename(columns={"P-value": "P_Value", "Adjusted P-value": "Adjusted_P_Value"}) if "P-value" in r else r
    sub = res_all[nm]
    if engine_used.startswith("LOCAL HYPERGEOMETRIC ON HAND"):
        med, nup, ndn, rankp = [], [], [], []
        for t in r.Term:
            s = sub[sub.symbol.isin(PANELS[t]) & (sub.baseMean > 10)]
            med.append(round(float(s.log2FC.median()), 3) if len(s) else np.nan)
            nup.append(int((s.log2FC > 0).sum())); ndn.append(int((s.log2FC < 0).sum()))
            rankp.append(float(mannwhitneyu(sub.loc[sub.symbol.isin(PANELS[t]), "pvalue"],
                                           sub.loc[~sub.symbol.isin(PANELS[t]), "pvalue"],
                                           alternative="less")[1]) if len(s) > 3 else np.nan)
        r["median_log2FC_all_baseMean10_members"] = med
        r["n_up_members_baseMean10"] = nup; r["n_dn_members_baseMean10"] = ndn
        r["rank_p_vs_rest_of_genome"] = rankp
    r.insert(0, "threshold", pcol); r.insert(0, "contrast", nm)
    r["contrast_pairs"] = f"{groups[LABEL[nm][0]]} vs {groups[LABEL[nm][1]]}"
    rows.append(r)
enr = pd.concat(rows, ignore_index=True)
enr.to_csv(f"{OUT}/enrichment_results_all_contrasts.csv", index=False)
T["enrichment_engine"] = engine_used
T["enrichment_background_size"] = Nbg
T["enrichment_terms_tested"] = int((enr.contrast == PRIMARY).sum())
top = enr[(enr.contrast == PRIMARY) & (enr.threshold == "pvalue")].head(6)
log("\n    PRIMARY 9 vs 1, PRIMARY threshold raw p<0.05 -- top terms:")
log(top.to_string(index=False))
log("\n    control-invariance (top-2 terms per contrast x threshold):")
for (nm, pcol), _ in sel.items():
    t = enr[(enr.contrast == nm) & (enr.threshold == pcol)].head(2)
    log(f"      {nm:8s} [{pcol:6s}] " + " | ".join(
        f"{row.Term} (q={row.Adjusted_P_Value:.1e}, ov {row.Overlap}/{row.TermSize})" for row in t.itertuples()))
up = enr[(enr.contrast == PRIMARY) & (enr.threshold == "pvalue")].head(6)

# ------------------------------------------- 7. knowledge-free DE co-expression
lfc_map = dict(zip(d_raw.ENSG, d_raw.log2FC))
idx = pd.Index(cnt.index).get_indexer(d_raw.ENSG)
nrm = np.log2(X / F["sf"][:, None] + 1)[:, idx]
gm = np.vstack([nrm[gidx == k].mean(0) for k in range(len(groups))]).T
gm = gm - gm.mean(1, keepdims=True); m = gm.std(1) > 1e-9
from scipy.cluster.hierarchy import linkage, fcluster
from scipy.spatial.distance import squareform
Cm = np.nan_to_num(np.corrcoef(gm[m])); Dm = 1 - Cm; np.fill_diagonal(Dm, 0); Dm = (Dm + Dm.T) / 2
cl = fcluster(linkage(squareform(Dm, checks=False), method="average"), t=0.25, criterion="distance")
ids = np.array([e for e, kk in zip(d_raw.ENSG, m) if kk])
smap = d_raw.set_index("ENSG").symbol
mods = []
for cnum, g in pd.DataFrame({"ENSG": ids, "cl": cl}).groupby("cl"):
    if len(g) < 25: continue
    mods.append(dict(n=len(g), median_log2FC=round(float(np.median([lfc_map[e] for e in g.ENSG])), 2),
                     members=",".join(map(str, smap.loc[g.ENSG].head(18)))))
mods.sort(key=lambda x: -x["n"])
T["coex_modules_top"] = mods[:6]
pd.DataFrame(mods).to_csv(f"{OUT}/coex_modules.csv", index=False)
log(f"\n[7] knowledge-free co-expression modules among DE genes: {len(mods)} modules >=25 genes")
for mm in mods[:5]:
    log(f"      n={mm['n']:4d} medianLFC={mm['median_log2FC']:+.2f}: {mm['members'][:150]}")
T["counts"] = dict(tested_genes=int(keep.sum()), baseMean_gt10=int((F["baseMean"] > 10).sum()),
                   background_symbols=Nbg, groups=groups,
                   contrasts={k: [groups[a], groups[b]] for k, (a, b) in LABEL.items()})
T["primary_answer_note"] = ("Reactome_2022 enrichment could NOT be computed in this sandbox "
                            "(no network, no gseapy, no gene-set library on disk); see "
                            "enrichment_results_all_contrasts.csv for the labelled substitute.")
json.dump(T, open(f"{OUT}/summary.json", "w"), indent=2, default=str)
log("\n[done] outputs in analysis/out/")
logf.close()
