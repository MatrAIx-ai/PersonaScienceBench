import numpy as np, sys
sys.path.insert(0, '/workspace/analysis')
from deseq_engine import run_deseq
from statsmodels.stats.multitest import multipletests

rng = np.random.default_rng(7)
K, N = 10, 3
S, G = K * N, 2000
gidx = np.repeat(np.arange(K), N)
sf_true = rng.uniform(0.4, 1.8, S)
base = np.exp(rng.normal(5.5, 1.8, G))
disp_true = np.clip(rng.gamma(2, 0.05, G), 1e-3, 1)
design_lfc = np.zeros((K, G))
true_de = rng.choice(G, 100, replace=False)
design_lfc[8, true_de] = rng.choice([-1.5, -0.8, 0.8, 1.5], 100)
mu = base[None, :] * np.exp(design_lfc)[gidx] * sf_true[:, None]
counts = np.clip(rng.poisson(rng.gamma(1/disp_true[None, :], disp_true[None, :]*mu)), 0, None).astype(np.int64)

fit = run_deseq(counts, gidx, K, disp_mode="shrunk")
sf_rel_err = np.abs(np.log(fit["sf"]/sf_true) - np.mean(np.log(fit["sf"]/sf_true)))
print("size factor: max relative log error %.4f ; corr %.4f" % (sf_rel_err.max(), np.corrcoef(np.log(fit["sf"]), np.log(sf_true))[0,1]))
print("disp corr log: gene-wise %.3f | shrunk %.3f" % (np.corrcoef(np.log(fit["gene_wise"]), np.log(disp_true))[0,1], np.corrcoef(np.log(fit["shrunk"]), np.log(disp_true))[0,1]))
c = np.zeros(K); c[8]=1; c[0]=-1
lfc, se, z, p = fit["obj"].wald(c)
for a,b in [(2,3),(4,5),(6,7)]:
    cn = np.zeros(K); cn[a]=1; cn[b]=-1
    _,_,_,pn = fit["obj"].wald(cn)
    print("NULL %d vs %d: frac p<0.05 = %.4f" % (a+1,b+1,(pn<0.05).mean()))
truth = np.zeros(G, bool); truth[true_de]=True
sel = fit["baseMean"]>10
dec = (p<0.05)&sel; tp=(dec&truth).sum(); fp=(dec&~truth).sum()
print("raw p<0.05: tested=%d called=%d TP=%d FP=%d FDR=%.3f power=%.3f" % (sel.sum(),dec.sum(),tp,fp,fp/max(dec.sum(),1),tp/(truth&sel).sum()))
padj = multipletests(p, method='fdr_bh')[1]
dec2=(padj<0.05)&sel; tp2=(dec2&truth).sum(); fp2=(dec2&~truth).sum()
print("padj<0.05: called=%d TP=%d FP=%d FDR=%.3f power=%.3f" % (dec2.sum(),tp2,fp2,fp2/max(dec2.sum(),1),tp2/(truth&sel).sum()))
print("median |log2FC err| on planted DE: %.3f" % np.median(np.abs(lfc[truth]-design_lfc[8][truth]/np.log(2))))

# ---- DESeq2-equivalent (shrunk) vs unshrunken (gene-wise) NB GLM ------------
from deseq_engine import run_deseq as rd
alt = rd(counts, gidx, K, disp_mode="gene_wise")
_,_,_,p_alt = alt["obj"].wald(c)
A = set(np.where((p < 0.05) & sel)[0]); B = set(np.where((p_alt < 0.05) & sel)[0])
print("shrunken vs unshrunken NB GLM: |A|=%d |B|=%d Jaccard=%.3f" % (len(A), len(B), len(A&B)/len(A|B)))
print("TP rate unshrunken: %.3f" % (len(B & set(np.where(truth)[0]))/len(B)))
