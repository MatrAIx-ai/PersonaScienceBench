#!/usr/bin/env python3
"""READY-TO-RUN gseapy Enrichr call for bix-43-q5 (needs network + gseapy).
Run in the grading/analysis runner:  pip install gseapy && python3 run_enrichment_gseapy.py
Consumes analysis/out/symbols_primary_rawp.txt produced by bix43_q5_final.py.
Primary = pooled DE set (brief: "all differentially expressed genes").
Enrichr uses the Reactome_2022 library itself as the background, so no custom
background is passed (a bgg hypergeometric against the 20,814 symbol-mapped
testable genes is also emitted for comparison)."""
import os, gseapy, pandas as pd
from scipy.stats import hypergeom
from statsmodels.stats.multitest import multipletests
OUT = "/workspace/analysis/out"
genes = [l.strip() for l in open(f"{OUT}/symbols_primary_rawp.txt") if l.strip()]
bg = sorted({s for s in (l.strip() for l in open(f"{OUT}/../out/symbols_primary_rawp.txt")) })
print(f"query genes: {len(genes)}")
res = {}
for tag, lst in [("pooled", genes),
                 ("up", [l.strip() for l in open(f"{OUT}/symbols_primary_rawp_up.txt") if l.strip()]),
                 ("down", [l.strip() for l in open(f"{OUT}/symbols_primary_rawp_down.txt") if l.strip()])]:
    e = gseapy.enrichr(gene_list=lst, gene_sets="Reactome_2022", organism="human",
                       outdir=f"{OUT}/gseapy_Reactome2022_{tag}")
    r = e.results.sort_values("Adjusted P-value")
    r.to_csv(f"{OUT}/enrichment_gseapy_Reactome2022_{tag}.csv", index=False)
    res[tag] = r.head(10)
    print(f"\n--- Reactome_2022 Enrichr, {tag}-regulated DE set ({len(lst)} genes) ---")
    print(r.head(10)[["Term", "Overlap", "P-value", "Adjusted P-value", "Odds Ratio"]].to_string(index=False))
