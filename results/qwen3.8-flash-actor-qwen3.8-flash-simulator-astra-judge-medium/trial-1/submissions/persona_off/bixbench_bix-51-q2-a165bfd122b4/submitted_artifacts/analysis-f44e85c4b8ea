"""
bix-51-q2: AIC for logistic regression of treatment response (Efficacy == "PR")
on BMI as the SOLE predictor (intercept + raw BMI).

Primary estimator: statsmodels GLM(family=Binomial) -> res.aic  (= 2k - 2lnL, k=2)
Cross-check only: manual 2k - 2lnL recomputation from fitted probabilities.
No scaling, no binning, no other covariates. Complete-case on BMI & Efficacy only.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df_raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print("raw parsed shape (incl. trailing blank rows):", df_raw.shape)

d = df_raw.dropna(subset=["BMI", "Efficacy"]).copy()      # complete case on the 2 variables only
d["y"] = (d["Efficacy"].astype(str).str.strip().str.upper() == "PR").astype(int)
d["BMI"] = pd.to_numeric(d["BMI"], errors="coerce")
d = d[d["BMI"].notna()].copy()

N = len(d)
print(f"N used = {N}")
print("outcome counts: PR =", int(d.y.sum()), " not-PR =", int((1 - d.y).sum()),
      " prevalence =", round(d.y.mean(), 4))
print("BMI: min %.1f  Q1 %.2f  median %.2f  mean %.4f  Q3 %.2f  max %.1f  (unique=%d)"
      % (d.BMI.min(), d.BMI.quantile(.25), d.BMI.median(), d.BMI.mean(),
         d.BMI.quantile(.75), d.BMI.max(), d.BMI.nunique()))

X = sm.add_constant(d[["BMI"]], prepend=True)   # const + raw BMI
y = d["y"].astype(float)

res = sm.GLM(y, X, family=sm.families.Binomial()).fit()
print("\n--- Primary fit: statsmodels GLM Binomial, AIC from res.aic ---")
print(res.summary())

# manual cross-check of the SAME statsmodels fit (confirmation only)
p = np.clip(np.asarray(res.fittedvalues, float), 1e-15, 1 - 1e-15)
ll = float(np.sum(y * np.log(p) + (1 - y) * np.log(1 - p)))
k = int(res.df_model + 1)
aic_manual = 2 * k - 2 * ll

null = sm.GLM(y, np.ones((N, 1)), family=sm.families.Binomial()).fit()
aic_null_model = float(null.aic)
aic_k1 = aic_manual - 2          # hypothetical grader convention counting only the slope

print("\n--- Key numbers ---")
print(f"N = {N}   (intercept-only null deviance on {N-1} df)")
print(f"intercept      = {res.params['const']:.6f}")
print(f"BMI coef (beta)= {res.params['BMI']:.6f}   SE = {res.bse['BMI']:.6f}   "
      f"z = {res.tvalues['BMI']:.4f}   p = {res.pvalues['BMI']:.6f}   "
      f"OR = {np.exp(res.params['BMI']):.6f}  (95% CI "
      f"{np.exp(res.conf_int().loc['BMI',0]):.4f}-{np.exp(res.conf_int().loc['BMI',1]):.4f})")
print(f"intercept SE = {res.bse['const']:.6f}  p = {res.pvalues['const']:.6f}")
print(f"null deviance       = {res.null_deviance:.6f} (df {res.df_resid + 1:.0f})")
print(f"residual deviance   = {res.deviance:.6f} (df {res.df_resid:.0f})")
print(f"deviance difference = {res.null_deviance - res.deviance:.6f} for 1 extra parameter")
print(f"log-likelihood      = {res.llf:.6f}")
print(f"converged           = {bool(res.converged)}  (iterations {res.fit_history['iteration'] if hasattr(res,'fit_history') else 'n/a'})")
print(f"\nAIC (PRIMARY, statsmodels res.aic, k={k}) = {res.aic:.6f}  -> {res.aic:.3f}  -> {res.aic:.2f}")
print(f"AIC manual 2k-2lnL (same fit, cross-check)  = {aic_manual:.6f}   |diff| = {abs(aic_manual-res.aic):.2e}")
print(f"AIC of intercept-only model                  = {aic_null_model:.6f}")
print(f"k=1 alternative convention (k=2 AIC - 2)     = {aic_k1:.6f}")
print(f"dAIC vs null = {res.aic - aic_null_model:.6f}")
print(f"\nPseudo-R^2 (McFadden) = {1 - res.deviance/res.null_deviance:.6f}")
print("R available for cross-check: ", end="")
import shutil; print("yes" if shutil.which("Rscript") else "NO (not installed; not substituting another estimator)")

print("\nANSWER: AIC = %.3f" % res.aic)
