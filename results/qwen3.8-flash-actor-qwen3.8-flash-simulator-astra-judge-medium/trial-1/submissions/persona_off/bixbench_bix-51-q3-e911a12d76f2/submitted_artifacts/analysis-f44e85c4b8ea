"""
BixBench bix-51-q3: Combined logistic regression (BMI + Age + Gender) predicting
treatment response (PR vs not-PR). Headline: Wald p-value for Age.
Reproducible from data/data.xlsx. No imputation; blank spacer rows dropped.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats
from scipy.optimize import linprog

pd.set_option("display.width", 160)
RNG_SEED = 0  # deterministic anyway; no stochastic steps

# ---------------- 1. Load & clean ----------------
raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
print(f"Raw sheet shape: {raw.shape}")
df = raw.dropna(how="all").copy()
print(f"After dropping fully-blank spacer rows: {df.shape[0]} rows")
n_blank_dropped = raw.shape[0] - df.shape[0]

# Within the remaining rows, ensure all model variables are present
model_vars = ["Efficacy", "BMI", "Age", "Gender"]
df = df.dropna(subset=model_vars).reset_index(drop=True)
n_used = len(df)
n_extra_dropped = 81 - n_used  # rows not fully blank but missing model vars
print(f"Rows used in model (complete on Efficacy/BMI/Age/Gender): {n_used}")
print(f"Blank spacer rows dropped: {n_blank_dropped}; extra rows dropped: {n_extra_dropped}")
if n_extra_dropped:
    junk = raw.dropna(how="all")
    junk = junk[junk["Efficacy"].isna()]
    for i, r in junk.iterrows():
        nz = {c: repr(v) for c, v in r.items()
              if not (isinstance(v, float) and np.isnan(v)) and v == v and str(v) != "nan"}
        print(f"  extra dropped row idx {i}: only non-empty cells -> {nz}")
assert n_used == 80, f"Expected 80 usable rows, got {n_used}"

# ---------------- 2. Encode ----------------
df["Efficacy"] = df["Efficacy"].str.strip()
assert set(df["Efficacy"].unique()) == {"PR", "PD", "SD"}, df["Efficacy"].unique()
df["y"] = (df["Efficacy"] == "PR").astype(int)
df["Male"] = (df["Gender"].str.strip() == "Male").astype(int)  # ref = Female
assert df["BMI"].apply(lambda v: isinstance(v, (int, float, np.floating))).all()
assert df["Age"].apply(lambda v: isinstance(v, (int, float, np.integer, np.floating))).all()

X = sm.add_constant(df[["BMI", "Age", "Male"]].astype(float))
y = df["y"]
print("\nOutcome: PR=1:", int(y.sum()), " | PD+SD=0:", int((1 - y).sum()))
print("Cell counts Gender x outcome:\n", pd.crosstab(df["Gender"], df["y"]))

# ---------------- 3. Fit combined model (statsmodels Logit MLE) ----------------
res = sm.Logit(y, X).fit(disp=0, method="newton", maxiter=100)
print("\n=== Combined model: logit P(PR) ~ BMI + Age + Male (ref Female) ===")
print(f"n = {int(res.nobs)}; converged = {res.mle_retvals['converged']}; "
      f"iterations = {res.mle_retvals['iterations']}")
tab = pd.DataFrame({
    "coef": res.params, "SE": res.bse, "z": res.tvalues, "p_Wald": res.pvalues,
})
ci = res.conf_int(alpha=0.05)
tab["CI_low"], tab["CI_high"] = ci[0], ci[1]
tab["OR"] = np.exp(res.params)
tab["OR_CI_low"], tab["OR_CI_high"] = np.exp(ci[0]), np.exp(ci[1])
print(tab.to_string(float_format=lambda v: f"{v:.6g}"))
print(f"\nLog-likelihood: {res.llf:.6f}  |  LLR p (vs intercept-only): {res.llr_pvalue:.6g}")

p_age = res.pvalues["Age"]
b_age, se_age = res.params["Age"], res.bse["Age"]
print(f"\n>>> HEADLINE: Wald p-value for Age = {p_age:.6f} = {p_age:.3e}")
print(f">>> Age OR per year = {np.exp(b_age):.4f} "
      f"(95% CI {np.exp(ci.loc['Age',0]):.4f} – {np.exp(ci.loc['Age',1]):.4f})")

# ---------------- 4. LRT sensitivity: drop Age ----------------
Xr = sm.add_constant(df[["BMI", "Male"]].astype(float))
res_r = sm.Logit(y, Xr).fit(disp=0)
lr_stat = 2 * (res.llf - res_r.llf)
p_lrt = stats.chi2.sf(lr_stat, df=1)
print(f"\nLRT (with vs without Age, same n=80): chi2 = {lr_stat:.4f}, "
      f"p = {p_lrt:.6f} = {p_lrt:.3e}")
print(f"Wald vs LRT agreement at 0.05: "
      f"{'AGREE' if (p_age < .05) == (p_lrt < .05) else 'DISAGREE'}")

# ---------------- 5. Identifiability / separation diagnostics ----------------
print("\n=== Diagnostics ===")
print(f"max |beta| = {np.max(np.abs(res.params)):.4f}  "
      f"(flag if >15); max SE = {np.max(res.bse):.4f}  "
      f"(flag if >5: Hauck-Donner-type inflation)")
fitted = res.predict(X)
print(f"fitted probs: min = {fitted.min():.4f}, max = {fitted.max():.4f}  "
      f"(flag if min<1e-6 or max>1-1e-6)")

# Exact complete-separation LP test (Bhardwaj/HS check):
# feasible w with Xs @ w >= 1 (Xs rows signed by outcome) <=> perfect separation
Xs = X.to_numpy().copy()
Xs[y.to_numpy() == 0] *= -1
c = np.zeros(Xs.shape[1])
res_lp = linprog(c, A_ub=-Xs, b_ub=-np.ones(len(Xs)),
                 bounds=[(-1, 1)] * Xs.shape[1], method="highs")
print("Complete separation detected (LP feasible):", res_lp.status == 0)

# ---------------- 6. Context checks (NOT the requested statistic) ----------------
uni = sm.Logit(y, sm.add_constant(df[["Age"]].astype(float))).fit(disp=0)
print("\n=== Context only (does NOT replace combined-model answer) ===")
print(f"(a) Univariable logit PR~Age: Wald p = {uni.pvalues['Age']:.6f} "
      f"= {uni.pvalues['Age']:.3e} (OR/yr = {np.exp(uni.params['Age']):.4f})")
print("(b) Age by outcome group:")
print(df.groupby("y")["Age"].agg(["mean", "std", "count"]).rename(index={0: "PD+SD (y=0)", 1: "PR (y=1)"}))
