#!/usr/bin/env python3
"""BixBench bix-53-q3 : DGEs contributing to KEGG glutathione metabolism
enrichment in the KD (KL) condition vs control (WL).

Pipeline
  A. environment probe   : gseapy / R-DESeq2 / Enrichr / PyPI / local GMT
  B. differential expression (KL vs WL)
  C. threshold filter (p<0.05, |shrunken log2FC|>1, baseMean>10)
  D. gseapy enrich() vs KEGG_2019_Mouse -> overlap with glutathione metabolism

The DE engine actually used in this run is recorded in results/summary.json;
the hand-rolled DESeq2-equivalent engine (analysis/deseq2_like.py) is used only
because R/DESeq2, pydeseq2 and gseapy are not installable in this runner (no
network egress).
"""
import gzip, importlib, json, os, platform, shutil, socket, subprocess, sys, time, traceback
import numpy as np
import pandas as pd
from scipy import stats

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
RES = 'results'
os.makedirs(RES, exist_ok=True)
os.makedirs(os.path.join(RES, 'libraries'), exist_ok=True)
LOG = []


def log(*a):
    msg = ' '.join(str(x) for x in a)
    print(msg, flush=True)
    LOG.append(msg)


T0 = time.time()
log('=' * 78)
log('bix-53-q3  analysis run  UTC', time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()))
log('python', platform.python_version(), '|', platform.platform())
log('=' * 78)

# ------------------------------------------------------------------ A. probe
def probe():
    out = {}
    for mod in ('gseapy', 'requests', 'mygene', 'pydeseq2'):
        try:
            m = importlib.import_module(mod)
            out[mod] = 'installed ' + str(getattr(m, '__version__', '?'))
        except Exception as e:
            out[mod] = f'UNAVAILABLE ({type(e).__name__}: {str(e)[:80]})'
    out['Rscript'] = shutil.which('Rscript') or 'NOT FOUND'
    try:
        socket.getaddrinfo('maayanlab.cloud', 443)
        out['network_DNS'] = 'OK'
    except Exception as e:
        out['network_DNS'] = f'FAIL {type(e).__name__}: {str(e)[:90]}'
    try:
        s = socket.create_connection(('1.1.1.1', 443), timeout=5); s.close()
        out['network_tcp_443'] = 'OK'
    except Exception as e:
        out['network_tcp_443'] = f'FAIL {type(e).__name__}: {str(e)[:90]}'
    for url in ('https://maayanlab.cloud/Enrichr/datasetStatistics',):
        try:
            import urllib.request
            r = urllib.request.urlopen(url, timeout=8)
            out['enrichr_http'] = f'HTTP {r.status}'
        except Exception as e:
            out['enrichr_http'] = f'FAIL {type(e).__name__}: {str(e)[:90]}'
    try:
        r = subprocess.run([sys.executable, '-m', 'pip', 'install',
                            '--disable-pip-version-check', '--quiet', 'gseapy'],
                           capture_output=True, text=True, timeout=240)
        out['pip_install_gseapy'] = f'returncode {r.returncode}: ' + (r.stderr or r.stdout).strip()[-140:]
    except Exception as e:
        out['pip_install_gseapy'] = f'FAIL {type(e).__name__}: {str(e)[:110]}'
    gmts = []
    for root, dirs, files in os.walk('.'):
        for f in files:
            if f.lower().endswith(('.gmt', '.gmt.gz')):
                gmts.append(os.path.join(root, f))
    out['local_GMT_files'] = gmts or 'NONE'
    return out


ENV = probe()
log('--- A. environment probe ' + '-' * 52)
for k, v in ENV.items():
    log(f'  {k}: {v}')
with open(f'{RES}/env_probe.json', 'w') as fh:
    json.dump(ENV, fh, indent=2)

# --------------------------------------------------------------- B. read data
log('--- B. differential expression ' + '-' * 50)
cnt = pd.read_csv('data/count.csv').set_index('geneID')
samples = list(cnt.columns)
KL = [c for c in samples if c.startswith('KL')]
WL = [c for c in samples if c.startswith('WL')]
log(f'counts {cnt.shape[0]} genes x {cnt.shape[1]} samples | KD={KL}  control={WL}')
log('library sizes:', {k: int(v) for k, v in cnt.sum().items()})
y = cnt.to_numpy(float)
GENES = cnt.index.to_numpy()
X = np.column_stack([np.ones(len(samples)),
                     np.array([1.0 if s in KL else 0.0 for s in samples])])
log('design: ~ condition ; coefficient 1 = KL indicator => log2FC = log2(KD / control)')

import deseq2_like as de
engine = dict(DE_engine='hand-rolled DESeq2-equivalent NB2 (analysis/deseq2_like.py)',
              LFC_shrinkage='ash-style EB normal mixture (apeglm stand-in)',
              WARNING=('NOT DESeq2/pydeseq2: R and pydeseq2 unavailable in this runner; '
                       'engine cross-validated in analysis/validate_engine.py.'))
sf, used_sf = de.size_factors(y)
log('size factors (median-of-ratios):', dict(zip(samples, np.round(sf, 4))))
log('genes used for size factors (all samples > 0):', int(used_sf.sum()))
baseMean = (y / sf[None, :]).mean(axis=1)
normed = y / sf[None, :]
nonzero = y.sum(axis=1) > 0
log(f'genes with >=1 count: {int(nonzero.sum())} (dispersions on these); all-zero: {int((~nonzero).sum())}')

CACHE = f'{RES}/cache_disp.npz'
if os.path.exists(CACHE):
    z = np.load(CACHE)
    a_gw, se_a, trend, prior_sd = z['a_gw'], z['se_a'], z['trend'], float(z['prior_sd'])
    n_tr = int(z['n_tr']) if 'n_tr' in z else -1
    a1 = a2 = float('nan')
    assert np.isfinite(prior_sd) and np.all(np.isfinite(trend[nonzero])), 'cached trend invalid'
    log(f'gene-wise dispersions loaded from cache {CACHE} (prior_sd={prior_sd:.3f})')
else:
    t = time.time()
    a_gw, se_a = de.dispersion_genewise(y, X, sf, nonzero)
    log(f'gene-wise NB2 dispersions (Cox-Reid APDL) {time.time()-t:.1f}s; median={np.nanmedian(a_gw):.4f}')
    trend, a1, a2, prior_sd, n_tr = de.disp_trend(baseMean, a_gw, se_a, nonzero, verbose=log)
    np.savez_compressed(CACHE, a_gw=a_gw, se_a=se_a, trend=trend, prior_sd=prior_sd, n_tr=n_tr)
    assert np.isfinite(prior_sd) and np.all(np.isfinite(trend[nonzero])), 'dispersion trend failed to fit'
log(f'dispersion trend alpha(mu) = {a1:.4f} + {a2:.3f}/mu ; genes in fit={n_tr}')
alpha = de.disp_shrink(a_gw, se_a, trend, prior_sd)
alpha = np.where(np.isfinite(alpha), alpha, np.maximum(trend, 1e-6))
log(f'shrunk dispersions median={np.nanmedian(alpha):.4f} range=[{np.nanmin(alpha):.5f},{np.nanmax(alpha):.3f}]')

w = de.wald(y, X, sf, np.maximum(alpha, 1e-7))
lfc, se_lfc, pval = w['lfc'], w['se_lfc'], w['pvalue']
# genes with zero counts in every sample are not testable (DESeq2 leaves them NA)
untested = ~nonzero
lfc = np.where(untested, 0.0, lfc); se_lfc = np.where(untested, np.nan, se_lfc)
pval = np.where(untested, np.nan, pval)
padj = de.bh(np.where(untested, np.nan, pval))
padj = np.where(untested, np.nan, padj)
t = time.time()
lfc_sh, lfsr, pi, sgrid = de.ash_shrink(lfc, se_lfc)
lfc_sh_norm, sd_norm = de.normal_prior_shrink(lfc, se_lfc)
log(f'LFC shrinkage {time.time()-t:.1f}s: ash prior mass at 0={pi[0]:.3f}; '
    f'secondary single-normal prior sd={sd_norm:.3f}')
log(f'tested genes: {int((~untested).sum())} ; p<0.05: {int((pval < 0.05).sum())} ; '
    f'padj<0.05: {int(np.nansum(padj < 0.05))}')

res = pd.DataFrame(dict(geneID=GENES, baseMean=baseMean, log2FoldChange=lfc,
                        lfcSE=se_lfc, pvalue=pval, padj=padj, alpha=alpha,
                        log2FC_shrunken_ash=lfc_sh, lfsr=lfsr,
                        log2FC_shrunken_normal=lfc_sh_norm, tested=(~untested)))
res['meanNorm_KL'] = normed[:, [samples.index(s) for s in KL]].mean(1)
res['meanNorm_WL'] = normed[:, [samples.index(s) for s in WL]].mean(1)
res['significant_primary'] = (res.pvalue.fillna(1) < 0.05) & (res.log2FC_shrunken_ash.abs() > 1) & (res.baseMean > 10)
res['significant_padj_variant'] = (res.padj.fillna(1) < 0.05) & (res.log2FC_shrunken_ash.abs() > 1) & (res.baseMean > 10)
res['significant_unshrunken'] = (res.pvalue.fillna(1) < 0.05) & (res.log2FoldChange.abs() > 1) & (res.baseMean > 10)
res['significant_normal_prior'] = (res.pvalue.fillna(1) < 0.05) & (res.log2FC_shrunken_normal.abs() > 1) & (res.baseMean > 10)
res = res.sort_values('pvalue')
res.to_csv(f'{RES}/de_full_table.tsv', sep='\t', index=False, float_format='%.6g')

log('--- C. threshold filter ' + '-' * 55)
for col, lab in [('significant_primary', 'PRIMARY  p<0.05 & |lfc_ash|>1 & baseMean>10'),
                 ('significant_padj_variant', 'sens.  padj<0.05 & |lfc_ash|>1 & baseMean>10'),
                 ('significant_unshrunken', 'sens.  p<0.05 & |lfc UNSHRUNKEN|>1 & baseMean>10'),
                 ('significant_normal_prior', 'sens.  p<0.05 & |lfc_normalEB|>1 & baseMean>10')]:
    m = res[col].to_numpy()
    log(f'  {lab}: n={int(m.sum())} up_in_KD={int(((res.log2FoldChange > 0).to_numpy() & m).sum())} '
        f'down={int(((res.log2FoldChange < 0).to_numpy() & m).sum())}')
sig = res[res.significant_primary]
sig.to_csv(f'{RES}/deg_significant_primary.tsv', sep='\t', index=False, float_format='%.6g')
log(f'  baseMean>10 universe n={int((res.baseMean > 10).sum())}; DEG table -> {RES}/deg_significant_primary.tsv')

# ------------------------------------------------------------- D. enrichment
log('--- D. gseapy enrich() vs KEGG_2019_Mouse ' + '-' * 34)


def load_gmt(path):
    sets = {}
    opener = gzip.open if path.endswith('.gz') else open
    with opener(path, 'rt') as fh:
        for line in fh:
            parts = line.rstrip('\n').split('\t')
            if len(parts) >= 2:
                sets[parts[0]] = [g for g in parts[2:]] if len(parts) > 2 else []
    return sets


GMT_CANDIDATES = []
for d in [f'{RES}/libraries', os.environ.get('BIXBENCH_GMT_DIR', ''), 'data', '.']:
    if d and os.path.isdir(d):
        for f in sorted(os.listdir(d)):
            if f.lower().replace('.gz', '').endswith('.gmt'):
                GMT_CANDIDATES.append(os.path.join(d, f))
log('local GMT files searched: ' + (', '.join(GMT_CANDIDATES) or 'NONE'))

MAP_CAND = [f'{RES}/libraries/ensg2symbol.tsv',
            os.environ.get('BIXBENCH_ENSG2SYMBOL', ''), 'data/ensg2symbol.tsv']
MAP_CAND = [m for m in MAP_CAND if m and os.path.exists(m)]
ensg2sym = None
if MAP_CAND:
    mm = pd.read_csv(MAP_CAND[0], sep='\t', header=None, names=['ensg', 'symbol'])
    ensg2sym = dict(zip(mm.ensg, mm.symbol))
    log(f'local ENSMUSG->symbol map loaded from {MAP_CAND[0]} ({len(ensg2sym)} entries)')
else:
    log('no ENSMUSG->symbol map available locally and mygene/network unavailable '
        '-> KEGG_2019_Mouse (symbol-keyed) queries cannot be built')

query_ensg = sig.geneID.tolist()
universe_ensg = res.loc[res.baseMean > 10, 'geneID'].tolist()
pd.DataFrame({'geneID': query_ensg}).to_csv(f'{RES}/significant_degs_ensembl.tsv',
                                            sep='\t', index=False, header=False)

enrich_done, enrich_err, chosen_term, overlap, padj_path = False, None, None, None, None
try:
    import gseapy
    log(f'gseapy {gseapy.__version__} importable -> running gseapy.enrich(enrichr)')
    enr = gseapy.enrich(genes=query_ensg, gene_sets='KEGG_2019_Mouse',
                        background=universe_ensg, enrichment_tool='enrichr',
                        outdir=f'{RES}/gseapy_raw', no_plot=True)
    tab = enr.res2d.copy()
    tab.to_csv(f'{RES}/enrichment_gseapy_KEGG_2019_Mouse.tsv', sep='\t', index=False)
    hit = tab[tab.Term.str.contains('glutathione', case=False, na=False)]
    chosen_term = hit.Term.iloc[0]
    overlap = int(str(hit['Overlap'].iloc[0]).split('/')[0])
    padj_path = float(hit['Adjusted P-value'].iloc[0])
    enrich_done = True
except Exception as e:
    enrich_err = f'{type(e).__name__}: {str(e)[:200]}'
    log('gseapy / Enrichr path FAILED -> ' + enrich_err)

if not enrich_done:
    # Deterministic offline equivalent of Enrichr's over-representation test
    # (one-sided hypergeometric + BH) using a LOCALLY SUPPLIED KEGG_2019_Mouse
    # GMT. Only runs if such a file exists; nothing is invented.
    gmt = next((g for g in GMT_CANDIDATES if 'kegg_2019_mouse' in os.path.basename(g).lower()), None)
    if gmt is not None:
        sets = load_gmt(gmt)
        names = [n for n in sets if 'glutathione' in n.lower()]
        N = len(universe_ensg)
        nq = len(set(query_ensg))
        rows = []
        for nm in names:
            gs = set(sets[nm]) & set(universe_ensg)
            ov = set(query_ensg) & gs
            pv = float(stats.hypergeom.sf(len(ov) - 1, N, len(gs), nq)) if len(ov) else 1.0
            rows.append(dict(Term=nm, Overlap=f'{len(ov)}/{len(gs)}', PValue=pv,
                             Genes=';'.join(sorted(ov))))
        tab = pd.DataFrame(rows).sort_values('PValue') if rows else pd.DataFrame()
        tab.to_csv(f'{RES}/enrichment_local_gmt.tsv', sep='\t', index=False)
        log('local-GMT enrichment written: ' + f'{RES}/enrichment_local_gmt.tsv')
        if len(tab):
            chosen_term = tab.Term.iloc[0]
            overlap = int(str(tab['Overlap'].iloc[0]).split('/')[0])
            padj_path = float(tab.PValue.iloc[0])
            enrich_done = True
    else:
        log('BLOCKER: no network for Enrichr AND no local KEGG_2019_Mouse GMT -> the')
        log('  KEGG glutathione metabolism gene set cannot be obtained. Per the brief no')
        log('  substitute library and no hand-written gene set is used.')
        log('  To finish: drop KEGG_2019_Mouse.gmt (+ ensg2symbol.tsv) into ' + f'{RES}/libraries/')
        log('  and rerun this script; the overlap is then computed by set intersection.')

# enumerate ID-mapping loss explicitly (bounds the +/-1-2 on the overlap)
if ensg2sym is not None:
    unmapped = [g for g in query_ensg if g not in ensg2sym]
    syms = [ensg2sym[g] for g in query_ensg if g in ensg2sym]
    from collections import Counter
    collisions = {k: v for k, v in Counter(syms).items() if v > 1}
else:
    unmapped, collisions = query_ensg, {}
log(f'ENSG->symbol: {len(query_ensg)} significant genes, {len(unmapped)} unmapped, '
    f'{len(collisions)} symbol collisions')
with open(f'{RES}/id_mapping_report.json', 'w') as fh:
    json.dump(dict(n_significant=len(query_ensg), n_unmapped=len(unmapped),
                   unmapped_ids=unmapped, n_symbol_collisions=len(collisions),
                   collisions=collisions, mapping_available=ensg2sym is not None), fh, indent=2)

STATUS = dict(gseapy_available='installed' in ENV.get('gseapy', ''),
              enrichr_dns=ENV.get('network_DNS'), enrichr_http=ENV.get('enrichr_http'),
              pip_install=ENV.get('pip_install_gseapy'), gmt_local=GMT_CANDIDATES,
              symbol_map_available=ensg2sym is not None,
              enrichment_executed=bool(enrich_done), error=enrich_err,
              pathway_term=chosen_term, overlap_DGEs_in_pathway=overlap,
              pathway_padj=padj_path, deg_query_n=len(query_ensg),
              background_n=len(universe_ensg),
              note=('KEGG_2019_Mouse could not be obtained in this runner; no substitute '
                    'library or hand-written gene set was used, by design.'))
with open(f'{RES}/enrichment_status.json', 'w') as fh:
    json.dump(STATUS, fh, indent=2)

log('--- E. answer ' + '-' * 61)
log(f'  significant DGEs (primary: p<0.05, |shrunken lfc|>1, baseMean>10): {len(sig)}')
log(f'  enrichment executed: {enrich_done} | pathway term: {chosen_term} | '
    f'overlap (answer): {overlap}')
summary = dict(question='number of DGEs contributing to KEGG glutathione metabolism '
                        'enrichment in KD (KL) vs control (WL)',
               engine=engine, contrast='KL vs WL (positive log2FC = up in KD)',
               thresholds='pvalue<0.05 & |shrunken log2FC|>1 & baseMean>10',
               n_genes_total=int(len(res)), n_baseMean_gt_10=int((res.baseMean > 10).sum()),
               DEG_primary=int(res.significant_primary.sum()),
               DEG_padj_variant=int(res.significant_padj_variant.sum()),
               DEG_unshrunken_variant=int(res.significant_unshrunken.sum()),
               DEG_normal_prior_variant=int(res.significant_normal_prior.sum()),
               up_in_KD_primary=int(((res.log2FoldChange > 0) & res.significant_primary).sum()),
               down_in_KD_primary=int(((res.log2FoldChange < 0) & res.significant_primary).sum()),
               answer_overlap_DGEs_in_glutathione_metabolism=overlap,
               pathway_term=chosen_term, pathway_padj=padj_path,
               enrichment=STATUS, runtime_s=round(time.time() - T0, 1))
with open(f'{RES}/summary.json', 'w') as fh:
    json.dump(summary, fh, indent=2)
log('  top 15 DEGs by p-value:')
log(res[res.tested].head(15)[['geneID', 'baseMean', 'log2FoldChange', 'log2FC_shrunken_ash',
                  'pvalue', 'padj']].to_string(index=False))
log('DONE in %.1fs' % (time.time() - T0))
with open(f'{RES}/analysis_log.txt', 'w') as fh:
    fh.write('\n'.join(LOG) + '\n')
