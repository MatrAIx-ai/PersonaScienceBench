"""Diagnostics / robustness checks for the hand-rolled DESeq2-equivalent run.
IMPORTANT: the saved DE table is sorted by p-value; everything here is realigned
to count.csv row order through geneID before any comparison.

  1. p-value calibration by expression stratum
  2. label-permutation null calibration of the full thresholded DEG rule
  3. DEG count under three dispersion models
  4. independent DE methods (Welch on log2 normalised counts, limma-style not avail.)
  5. LFC-shrinkage effect at the |lfc| = 1 boundary
"""
import sys, numpy as np, pandas as pd
from scipy import stats
sys.path.insert(0, 'analysis')
import deseq2_like as de

out = []
def p(*a):
    s = ' '.join(str(x) for x in a); print(s, flush=True); out.append(s)

cnt = pd.read_csv('data/count.csv').set_index('geneID')
y = cnt.to_numpy(float)
X = np.column_stack([np.ones(6), np.array([1, 1, 1, 0, 0, 0], float)])
sf, _ = de.size_factors(y)
normed = y / sf[None, :]
baseMean = normed.mean(1)
raw = pd.read_csv('results/de_full_table.tsv', sep='\t')
res = raw.set_index('geneID').reindex(cnt.index)          # align to count.csv order
assert (res.baseMean.to_numpy() == baseMean).all() or np.allclose(res.baseMean, baseMean)
p(f'DE table aligned to count.csv order: {len(res)} genes; NaN rows {int(res.pvalue.isna().sum())}')

z = np.load('results/cache_disp.npz')
a_gw, se_a, trend, prior_sd = z['a_gw'], z['se_a'], z['trend'], float(z['prior_sd'])
alpha_map = de.disp_shrink(a_gw, se_a, trend, prior_sd)
alpha_map = np.where(np.isfinite(alpha_map), alpha_map, np.clip(trend, 1e-6, 100))
alpha_trend = np.clip(trend, 1e-6, 100)
alpha_gw = np.where(np.isfinite(a_gw), np.clip(a_gw, 1e-6, 100), alpha_trend)
alpha_used = res.alpha.to_numpy()
p(f'saved alpha vs recomputed MAP alpha: max abs diff {np.nanmax(np.abs(alpha_used - alpha_map)):.3g}')

p('\n=== 1. p-value calibration by expression stratum (null strata -> expect ~0.05) ===')
pv = res.pvalue.to_numpy()
for lo, hi in [(0, 0.1), (0.1, 1), (1, 3), (3, 10), (10, 30), (30, 100), (100, 1e9)]:
    m = (baseMean >= lo) & (baseMean < hi)
    if m.sum() > 50:
        p(f'  baseMean [{lo:>6},{hi:>9}): n={m.sum():6d}  frac p<0.05 = {np.mean(pv[m]):.3f}')
p('  (all-zero / near-zero genes are not tested by DESeq2 either: they are removed by')
p('   the baseMean>10 filter, so strata below 10 do not enter the answer.)')

p('\n=== 2. label-permutation null calibration of the full DEG rule ===')
rng = np.random.default_rng(7)
for rep in range(3):
    perm = rng.permutation(6)          # permute libraries: counts AND their size factors
    yp, sp_ = y[:, perm], sf[perm]
    Xp = np.column_stack([np.ones(6), np.array([1, 1, 1, 0, 0, 0], float)])
    ap, sp = de.dispersion_genewise(yp, Xp, sp_, yp.sum(1) > 0)
    tr, *_ = de.disp_trend((yp / sp_[None, :]).mean(1), ap, sp, yp.sum(1) > 0)
    alp = de.disp_shrink(ap, sp, tr, prior_sd)
    alp = np.where(np.isfinite(alp), alp, np.clip(tr, 1e-6, 100))
    wp = de.wald(yp, Xp, sp_, alp)
    sh, _, _, _ = de.ash_shrink(wp['lfc'], wp['se_lfc'])
    bmp = (yp / sp_[None, :]).mean(1)
    keep = (wp['pvalue'] < 0.05) & (np.abs(sh) > 1) & (bmp > 10)
    p(f'    (null p<0.05 rate = {(wp["pvalue"] < 0.05).mean():.3f}, nominal 0.05)')
    p(f'  perm {rep+1} (shuffled KL/WL labels): false-positive DEGs = {int(keep.sum())} '
      f'of {int((baseMean>10).sum())} testable genes  [observed real contrast = '
      f'{int(res.significant_primary.to_numpy(bool).sum())}]')

p('\n=== 3. DEG count under three dispersion models (primary thresholds) ===')
for name, al in [('gene-wise Cox-Reid (no shrink)', alpha_gw),
                 ('fitted trend only', alpha_trend),
                 ('MAP shrink toward trend (used)', alpha_map)]:
    w = de.wald(y, X, sf, al)
    sh, _, _, _ = de.ash_shrink(w['lfc'], w['se_lfc'])
    keep = (w['pvalue'] < 0.05) & (np.abs(sh) > 1) & (baseMean > 10)
    uns = (w['pvalue'] < 0.05) & (np.abs(w['lfc'] / np.log(2)) > 1) & (baseMean > 10)
    p(f'  {name:32s} DEG(shrunk lfc)={int(keep.sum()):5d}  DEG(unshrunken)={int(uns.sum()):5d}')

p('\n=== 4. independent DE method vs primary list (same gene order) ===')
lg = np.log2(normed + 1)
t, pv_t = stats.ttest_ind(lg[:, :3], lg[:, 3:], axis=1, equal_var=False)
prim = res.significant_primary.to_numpy(bool)
bm10 = baseMean > 10
sel = (pv_t < 0.05) & bm10
inter = int((sel & prim).sum()); jac = inter / max(int((sel | prim).sum()), 1)
p(f'  Welch t-test on log2(norm+1): n_sig={int(sel.sum())}, overlap with primary={inter}, '
  f'Jaccard={jac:.3f}')
sc = stats.spearmanr(res.log2FoldChange[bm10], np.log2((normed[:, :3].mean(1) + .1) /
                  (normed[:, 3:].mean(1) + .1))[bm10])
p(f'  Spearman(DESeq2-like log2FC, naive log ratio) over baseMean>10: rho={sc.statistic:.3f} '
  f'(p={sc.pvalue:.2g})')

p('\n=== 5. LFC shrinkage at the |lfc| = 1 boundary ===')
a_s = res.log2FC_shrunken_ash.to_numpy(); u = res.log2FoldChange.to_numpy()
m = (pv < 0.05) & bm10
p(f'  genes p<0.05 & baseMean>10: n={int(m.sum())}')
p(f'    |raw lfc|>1: {int((np.abs(u) > 1)[m].sum())}   |ash-shrunk|>1: {int((np.abs(a_s) > 1)[m].sum())}'
  f'   flipped out by shrinkage: {int(((np.abs(u) > 1) & (np.abs(a_s) <= 1))[m].sum())}')
p(f'  corr(shrunk, raw) baseMean>10 = {np.corrcoef(a_s[bm10], u[bm10])[0,1]:.4f}; '
  f'sign flips = {int((np.sign(u) != np.sign(a_s)).sum())} (must be 0)')
with open('results/diagnostics.txt', 'w') as fh:
    fh.write('\n'.join(out) + '\n')
