"""Validation of the hand-rolled NB2 engine (independent references)."""
import sys, numpy as np, pandas as pd
sys.path.insert(0, 'analysis')
import deseq2_like as d
from scipy import stats, optimize
from scipy.special import gammaln
from statsmodels.stats.multitest import multipletests

cnt = pd.read_csv('data/count.csv').set_index('geneID')
y = cnt.to_numpy(float); names = cnt.columns.tolist()
sf, used = d.size_factors(y)
logs = np.log(y[used]); ref = np.exp(np.median(logs - logs.mean(1, keepdims=True), axis=0))
print('[SF] size factors:', dict(zip(names, np.round(sf, 4))))
print('[SF] max rel diff vs independent median-of-ratios impl: %.2e' % np.max(np.abs(ref - sf) / sf))
X = np.column_stack([np.ones(6), np.array([1, 1, 1, 0, 0, 0], float)])

rng = np.random.default_rng(0); p = rng.random(500) ** 3
print('[BH] max abs diff vs statsmodels fdr_bh: %.2e' % np.max(np.abs(d.bh(p) - multipletests(p, method='fdr_bh')[1])))

# --- beta MLE: score equations + independent optimiser, fixed alpha
sub = np.where(used)[0][:: max(1, used.sum() // 8)][:8]
print('\n[gene-wise GLM, alpha fixed=0.02] score residual X\'(y-mu) and lfc agreement')
mx_score = 0.0; mx_lfc = 0.0
for g in sub:
    yg = y[g]; al = 0.02
    beta, mu = d.nb2_glm(yg[None, :], X, sf, np.array([al]))
    score = np.abs(X.T @ (yg - mu[0])).max()
    def nll(b):
        m = np.exp(np.clip(X @ b, -30, 30)) * sf; r = 1 / al
        return -(gammaln(yg + r) - gammaln(r) - gammaln(yg + 1)
                 + r * np.log(r / (r + m)) + yg * np.log(m / (r + m))).sum()
    r2 = optimize.minimize(nll, np.array([np.log(max(yg.mean(), 1.0)), 0.0]), method='Nelder-Mead',
                           options=dict(maxiter=20000, xatol=1e-10, fatol=1e-12))
    mx_score = max(mx_score, score); mx_lfc = max(mx_lfc, abs(beta[0, 1] - r2.x[1]) / np.log(2))
    print(f'  {cnt.index[g]}  lfc_irls={beta[0,1]/np.log(2):+.4f}  lfc_nm={r2.x[1]/np.log(2):+.4f}  |score|max={score:.2e}')
print(f'[gene-wise GLM] worst |score| = {mx_score:.2e}; worst |dlfc| = {mx_lfc:.2e}')

# --- model-based SE vs numeric observed-information SE
g = sub[2]; al = 0.05
beta, mu = d.nb2_glm(y[g][None, :], X, sf, np.array([al]))
m = mu[0]; W = m ** 2 / (m + al * m ** 2)
se_model = np.sqrt(np.linalg.inv(X.T @ (X * W[:, None]))[1, 1]) / np.log(2)
def nllb(b):
    mm = np.exp(np.clip(X @ b, -30, 30)) * sf; r = 1 / al
    return -(gammaln(y[g] + r) - gammaln(r) - gammaln(y[g] + 1)
             + r * np.log(r / (r + mm)) + y[g] * np.log(mm / (r + mm))).sum()
h = 1e-3; b0 = beta[0]; Hn = np.zeros((2, 2))
for i in range(2):
    for j in range(2):
        ei = np.zeros(2); ei[i] = h; ej = np.zeros(2); ej[j] = h
        Hn[i, j] = (nllb(b0+ei+ej) - nllb(b0+ei-ej) - nllb(b0-ei+ej) + nllb(b0-ei-ej)) / (4*h*h)
print(f'[SE] gene {cnt.index[g]}: model-based se_lfc={se_model:.5f}  numeric-observed se_lfc={np.sqrt(np.linalg.inv(Hn)[1,1])/np.log(2):.5f}')

# --- dispersion: Cox-Reid vs plain profile-likelihood MLE (CR expected slightly larger)
idx = np.where(used)[0][:: max(1, used.sum() // 6)][:6]
print('\n[dispersion] Cox-Reid APDL vs plain profile MLE')
for g in idx:
    yg = y[g][None, :]
    def nll_a(la):
        a = np.exp(la[0])
        b, mm = d.nb2_glm(yg, X, sf, np.array([a]))
        return -d.nb2_loglik(yg, mm, np.array([a])).sum()
    r3 = optimize.minimize(nll_a, [np.log(0.05)], method='Nelder-Mead',
                           options=dict(xatol=1e-8, fatol=1e-10))
    a_plain = float(np.exp(r3.x[0]))
    a_cr, se = d.dispersion_genewise(yg, X, sf, np.array([True]))
    print(f'  {cnt.index[g]}: alpha_plainMLE={a_plain:.4f}  alpha_CoxReid={a_cr[0]:.4f}  se_loga={se[0]:.2f}')

# --- shrinkage sanity: simulated data with known truth
n = 2000
lfc_t = np.where(rng.random(n) < 0.3, 0.0, rng.normal(0, 2, n))
se_t = rng.uniform(0.1, 1.5, n)
obs = lfc_t + rng.normal(0, se_t)
pm, lfsr, pi, sg = d.ash_shrink(obs, se_t)
rmse_ash = np.sqrt(np.mean((pm - lfc_t) ** 2)); rmse_raw = np.sqrt(np.mean((obs - lfc_t) ** 2))
nm, sd = d.normal_prior_shrink(obs, se_t)
print(f'\n[shrinkage sim] RMSE raw={rmse_raw:.3f}  ash={rmse_ash:.3f}  normalEB={np.sqrt(np.mean((nm-lfc_t)**2)):.3f}  (ash should beat raw)')
