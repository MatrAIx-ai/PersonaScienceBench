"""Scaffold for the (currently blocked) enrichment step.

The answer is  |significant DEGs  KEGG glutathione metabolism gene set|.
The gene set cannot be obtained in this runner (no gseapy, no Enrichr, no local
GMT), so instead of inventing one we characterise how the answer depends on the
only two unknowns: the size of the KEGG mouse glutathione-metabolism set (K,
measured on the baseMean>10 universe) and the observed overlap.
Hyper-geometric = exactly Enrichr/gseapy enrich()'s over-representation test.
"""
import numpy as np, pandas as pd
from scipy import stats
res = pd.read_csv('results/de_full_table.tsv', sep='\t')
N = int((res.baseMean > 10).sum())                     # background universe
n = int(res.significant_primary.sum())                 # significant DEGs
rows = []
for K in (20, 30, 40, 50, 60, 80, 100):
    exp_val = n * K / N
    k_exp = max(int(round(exp_val)), 0)
    # smallest overlap with hyper-geometric p < 0.05
    kmin = next((k for k in range(0, K + 1)
                 if stats.hypergeom.sf(k - 1, N, K, n) < 0.05), None)
    rows.append(dict(gene_set_size_K=K, expected_overlap_by_chance=round(exp_val, 2),
                     min_overlap_for_p_lt_0p05=kmin,
                     p_value_at_rounded_expected_overlap=round(
                         float(stats.hypergeom.sf(k_exp - 1, N, K, n)), 4)))
tab = pd.DataFrame(rows)
tab.to_csv('results/overlap_sensitivity.tsv', sep='\t', index=False)
print(f'background universe N = {N} (baseMean>10),  significant DGEs n = {n}')
print(tab.to_string(index=False))
print('\nRead as: if the KEGG mouse glutathione-metabolism set contains K of the '
      f'{N}\ntestable genes, then an overlap of >= min_overlap_for_p_lt_0p05 is what makes '
      'that pathway\n"significantly enriched", and the number of DGEs asked for by the '
      'question is exactly\nthe observed overlap (Enrichr "Overlap x/y" numerator).')
with open('results/overlap_sensitivity.txt', 'w') as fh:
    fh.write(f'N={N} n={n}\n' + tab.to_string(index=False) + '\n')
