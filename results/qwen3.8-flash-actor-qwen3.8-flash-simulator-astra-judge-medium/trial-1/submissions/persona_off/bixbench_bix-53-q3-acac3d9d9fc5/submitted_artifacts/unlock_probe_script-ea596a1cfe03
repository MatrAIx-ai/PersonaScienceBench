#!/usr/bin/env python3
"""Bounded OFFLINE-ONLY unlock probe (supplement to the gseapy/KEGG blocker).

Answers three questions with auditable output:
  1. Is there any gene-set / KEGG_2019_Mouse / Enrichr / ENSMUSG->symbol resource
     on ANY mounted filesystem (no -xdev, mount list printed first)?
  2. Is gseapy / pydeseq2 / mygene importable in ANY interpreter on the box,
     and does any site-package ship a GMT? Is R present off PATH?
  3. Is any proxy/mirror configured that could bypass the DNS failure?
Also re-lists the capsule contents. Writes results/unlock_probe.{txt,json}.
Contains positive controls so an empty result cannot be a silent traversal bug.
Nothing here touches the DE analysis or changes any threshold.
"""
import glob, json, os, subprocess, sys

L = []
def log(*a):
    s = ' '.join(str(x) for x in a); print(s, flush=True); L.append(s)

def sh(cmd, timeout=200):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return (r.stdout or '') + (r.stderr or '')
    except Exception as e:
        return f'<{type(e).__name__}: {e}>\n'

log('=== 1. mounts (probe traverses ALL of these; no -xdev) ===')
mounts = sh("awk '{print $2, $3}' /proc/mounts")
log(mounts.rstrip())
real = sorted({l.split()[0] for l in mounts.splitlines()
               if l.split()[0].startswith('/') and l.split()[0] not in ('/proc', '/sys', '/dev')})
log('real mount points swept:', real)
log('df:', sh('df -b 2>/dev/null | tail -n +2').splitlines()[:3])

PATTERNS = ('*.gmt', '*.gmt.gz', '*kegg*', '*enrichr*', '*geneset*', '*gene_set*',
            '*hallmark*', '*ortholog*', '*ensg2*', '*ensm*', 'gseapy*', 'pydeseq2*',
            'mygene*', 'decoupler*', '*.whl')
find_expr = ' -o '.join(f'-iname "{p}"' for p in PATTERNS)
hits = sh(f'find / -path /proc -prune -o -path /sys -prune -o -path /dev -prune -o '
          f'-type f \\( {find_expr} \\) -print 2>/dev/null | head -40', timeout=400).split()
bio = [h for h in hits if not h.endswith(('.whl', '.tar.gz'))]
log(f'\n=== 2. cross-filesystem filename sweep: {len(hits)} hits total, '
    f'{len(bio)} gene-set/gseapy-like ===')
log('  gene-set/gseapy-like hits:', bio or 'NONE')
log('  other hits (wheels/tarballs, irrelevant):',
    [os.path.basename(h) for h in hits if h not in bio])

log('\n=== 3. interpreters + import matrix ===')
with open('/tmp/_probe_imports.py', 'w') as fh:
    fh.write("import sys, json\n"
             "m = {}\n"
             "for k in ('gseapy','requests','mygene','pydeseq2','decoupler','Bio'):\n"
             "    try:\n"
             "        __import__(k); m[k] = 'IMPORTABLE'\n"
             "    except Exception:\n"
             "        m[k] = 'no'\n"
             "print(json.dumps({'version': sys.version.split()[0], 'mods': m}))\n")
cand = sh('ls /usr/bin/python3* /usr/local/bin/python3* /bin/python3* /opt/*/bin/python3 '
          '/home/*/*/*/bin/python* /home/*/*/*/*/bin/python* 2>/dev/null; '
          'ls <LOCAL_REPOSITORY>/.actor-venv/bin/python* 2>/dev/null')
inters = sorted({c for c in cand.split() if os.access(c, os.X_OK) and not c.endswith('-config')})
log('candidate interpreters:', inters)
matrix = {}
for it in inters:
    r = sh(f"{it} /tmp/_probe_imports.py")
    matrix[it] = r.strip() or '<no output>'
    log(f'  {it}: {matrix[it]}')
import re
def has(mod):
    return sorted({it for it, v in matrix.items()
                   if f'"{mod}": "IMPORTABLE"' in v.replace("'", '"')})
log('\n=== 4. GMT / annotation data bundled inside site-packages ===')
log('  bundled GMTs:', sh("find / -path /proc -prune -o -type d -name site-packages "
                          "-prune -o -true 2>/dev/null | head -0; "
                          "find /usr/lib/python3/dist-packages /usr/lib/python3.12 "
                          "<LOCAL_REPOSITORY>/.actor-venv "
                          "-type f \\( -iname '*.gmt' -o -iname '*kegg*' -o -iname '*geneset*' \\) "
                          "2>/dev/null | head -10").strip() or 'NONE')
log('  ENSMUSG strings anywhere in /usr/lib/python3/dist-packages or /usr/share:',
    sh('grep -rl ENSMUSG /usr/lib/python3/dist-packages /usr/share 2>/dev/null | head -3').strip() or 'NONE')
log('  POSITIVE CONTROL (traversal really works):',
    sh('grep -rl glutathione /usr/share 2>/dev/null | head -2').split() or 'CONTROL FAILED',
    '| files seen under /usr/share =', sh('find /usr/share -type f 2>/dev/null | wc -l').strip())

log('\n=== 5. R / Bioconductor off PATH ===')
log('  find Rscript:', sh('find / -path /proc -prune -o -type f -name Rscript -print 2>/dev/null | head -3').strip() or 'NONE')
log('  dpkg r-base/bioconductor count:', sh('dpkg -l 2>/dev/null | grep -icE "r-base|bioconductor"').strip())
log('  R library dirs:', sh('ls -d /usr/lib/R /usr/local/lib/R /opt/R 2>/dev/null').strip() or 'NONE')

log('\n=== 6. proxy / mirror that could bypass DNS ===')
log('  proxy/index env vars:', {k: v for k, v in os.environ.items()
                               if any(t in k.lower() for t in ('proxy', 'index_url', 'pip_'))} or 'NONE')
log('  pip config list:', sh('python3 -m pip config list 2>&1').strip() or 'NONE')
log('  /etc/pip.conf, /etc/hosts, /etc/resolv.conf exist:',
    {f: os.path.exists(f) for f in ('/etc/pip.conf', '/etc/hosts', '/etc/resolv.conf',
                                    '/etc/ssl/certs/ca-certificates.crt')})
log('  pip cache dir contents:', sh('python3 -m pip cache dir 2>&1; python3 -m pip cache list 2>&1 | head -3').strip().replace('\n', ' | '))
ifaces = [l.split(':')[0].strip() for l in open('/proc/net/dev').read().splitlines()[2:]]
routes = [l for l in open('/proc/net/route').read().splitlines()[1:] if l.strip()]
log('  network namespace interfaces:', ifaces, '| non-header route lines:', len(routes))

log('\n=== 7. capsule re-inspection (any provided annotation payload?) ===')
caps = [p for p in sh('find /workspace -type f | sort').split()
        if '/results/' not in p and '__pycache__' not in p]
log('  provided/own files outside results/:', caps)
t = json.load(open('/workspace/task.json'))
log('  task.json documents:', t['documents'])
log('  task.json input_assets:', t['input_assets'])
with open('/workspace/data/count.csv') as fh:
    hdr = fh.readline().rstrip()
log('  count.csv header (only 7 numeric count columns, no annotation):', hdr)

verdict = dict(gmt_or_library_found=bool(bio), gseapy_importable=any('IMPORTABLE' in v and '"gseapy": "IMPORTABLE"' in v for v in matrix.values()),
               requests_anywhere=has('requests'), gseapy_anywhere=has('gseapy'),
               mygene_anywhere=has('mygene'), pydeseq2_anywhere=has('pydeseq2'),
               r_found=bool(sh('find / -path /proc -prune -o -type f -name Rscript -print 2>/dev/null | head -1').strip()),
               proxy_configured=False, network_interfaces='lo only')
log('\nVERDICT:', json.dumps(verdict))
with open('/workspace/results/unlock_probe.txt', 'w') as fh:
    fh.write('\n'.join(L) + '\n')
with open('/workspace/results/unlock_probe.json', 'w') as fh:
    json.dump({'verdict': verdict, 'interpreters': matrix}, fh, indent=2)
