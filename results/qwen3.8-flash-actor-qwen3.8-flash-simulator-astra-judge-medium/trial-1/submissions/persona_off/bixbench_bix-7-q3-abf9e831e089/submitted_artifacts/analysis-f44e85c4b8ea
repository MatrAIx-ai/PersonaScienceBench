"""
FINAL ANALYSIS -- "How many CHIP variants remain after removing reference calls?"

Approved rules:
  (i)   Unit = sample-level variant rows pooled across the 86 CHIP exports.
  (ii)  Removal rule = drop rows whose stripped Zygosity == "Reference".
        Blank Zygosity (no-calls) are RETAINED under the primary rule (caveat reported).
  (iii) No secondary 56-symbol panel filter in the headline; In_CHIP==True / BED export is trusted.
        The 56-gene file is used descriptively only.
Guards: fixed header offset (names on row 2, data from row 3) asserted per file via
        raw_rows - 2 == parsed_rows; every file must be CHIP-scoped (In_CHIP all True).
"""
import os
import re
import json
import pandas as pd

DATA = "data"
DIR = os.path.join(DATA, "CHIP_DP10_GQ20_PASS")
PREFIX = "230209_Exome_GRCh38_CHIP_"
PANEL_FILE = os.path.join(DATA, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx")
TRIO_FILE = os.path.join(DATA, "230215_Trio_Status.xlsx")
OUT_CSV = "per_file_counts.csv"

REFERENCE_LABEL = "Reference"
PANEL_ROLE_MAP = {"Proband": "Patient/Proband", "Patient": "Patient/Proband",
                  "Father": "Father", "Mother": "Mother", "Child": "Child"}


def load_panel():
    s = pd.read_excel(PANEL_FILE, header=None)[0].astype(str).str.strip()
    return set(s)


def load_trio():
    t = pd.read_excel(TRIO_FILE)
    t.columns = [str(c).strip() for c in t.columns]
    for c in t.columns:
        if t[c].dtype == object:
            t[c] = t[c].astype(str).str.strip()
    return t


def load_workbook(path):
    """Read one CHIP export: row 1 = merged category band, row 2 = column names, data from row 3."""
    sheet = pd.ExcelFile(path).sheet_names[0]
    raw = pd.read_excel(path, sheet_name=sheet, header=None)
    df = pd.read_excel(path, sheet_name=sheet, header=1)
    df.columns = [str(c).strip() for c in df.columns]
    df = df.dropna(how="all").reset_index(drop=True)
    raw_rows, parsed_rows = len(raw) - 2, len(df)
    assert raw_rows == parsed_rows, f"header-offset guard failed for {path}: {raw_rows} != {parsed_rows}"
    role_band = str(raw.iloc[0, 4])                       # e.g. 'Proband (502-P1)'
    role = role_band.split(" (")[0].strip()
    m = re.search(r"Variants\s+(\d+)", sheet)
    return sheet, int(m.group(1)) if m else None, df, role, role_band


def gene_token_in_panel(value, panel):
    return any(p.strip() in panel for p in str(value).split(",") if p.strip())


def main():
    panel = load_panel()
    trio = load_trio()

    frames, audit = [], []
    for fname in sorted(os.listdir(DIR)):
        if not fname.endswith(".xlsx"):
            continue
        sample = fname.replace(PREFIX, "").replace(".xlsx", "")
        sheet, sheet_n, df, role, role_band = load_workbook(os.path.join(DIR, fname))
        df["sample"] = sample
        df["role"] = PANEL_ROLE_MAP.get(role, role)
        df["zyg"] = df["Zygosity"].fillna("<BLANK>").astype(str).str.strip()
        assert df["In_CHIP"].astype(str).eq("True").all(), f"{sample}: not CHIP-scoped"
        frames.append(df)

        vc = df["zyg"].value_counts().to_dict()
        n_ref = vc.get(REFERENCE_LABEL, 0)
        audit.append(dict(
            sample=sample, role=df["role"].iloc[0], sheet=sheet, sheet_title_variant_count=sheet_n,
            rows_before=n_ref + len(df) - n_ref, rows_Reference=n_ref,
            rows_Heterozygous=vc.get("Heterozygous", 0),
            rows_Homozygous_Variant=vc.get("Homozygous Variant", 0),
            rows_blank_no_call=vc.get("<BLANK>", 0),
            rows_after_removing_reference=len(df) - n_ref,
        ))

    allr = pd.concat(frames, ignore_index=True)
    audit_df = pd.DataFrame(audit).sort_values("sample")
    audit_df.to_csv(OUT_CSV, index=False)

    n_files = audit_df.shape[0]
    total_before = int(len(allr))
    n_ref = int(allr["zyg"].eq(REFERENCE_LABEL).sum())
    kept = allr[~allr["zyg"].eq(REFERENCE_LABEL)]
    headline = int(len(kept))

    print("=" * 78)
    print("CHIP variant count after removing reference calls")
    print("=" * 78)
    print(f"files loaded (header=1, guard raw_rows-2==parsed_rows) : {n_files}")
    print(f"panel file (descriptive only)                          : {len(panel)} unique symbols")
    print(f"trio file rows                                         : {len(trio)} "
          f"(IDs with no workbook: "
          f"{sorted(set(trio['Sample ID']) - {s for s in allr['sample']} - {s.split('-')[0] for s in allr['sample']})})")
    print(f"files by role                                          : "
          + ", ".join(f"{k}={v}" for k, v in audit_df.groupby('role').size().items()))
    print(f"sample-level rows BEFORE removal                       : {total_before}")
    print(f"rows removed (Zygosity == '{REFERENCE_LABEL}')             : {n_ref}")
    print(f"HEADLINE  sample-level rows REMAINING                  : {headline}")

    print("\n--- kept rows by Zygosity (arithmetic check) ---")
    by_z = kept["zyg"].value_counts()
    for k, v in by_z.items():
        print(f"  {k:<20} {v:>7,}")
    het, hom, blk = (int(by_z.get(k, 0)) for k in ("Heterozygous", "Homozygous Variant", "<BLANK>"))
    print(f"  {'TOTAL kept':<20} {het + hom + blk:>7,}   "
          f"(= Het {het:,} + Hom {hom:,} + no-call {blk:,}; matches headline: {het + hom + blk == headline})")

    print("\n--- kept rows by trio role ---")
    by_role = kept["role"].value_counts()
    for k, v in by_role.items():
        print(f"  {k:<20} {v:>7,}")
    print(f"  {'TOTAL kept':<20} {int(by_role.sum()):>7,}")

    print("\n--- role reconciliation: workbook roles vs trio Status ---")
    trio_counts = trio["Status"].value_counts().to_dict()
    file_counts = audit_df["role"].value_counts().to_dict()
    missing = sorted(set(trio["Sample ID"]) - {s.split("-")[0] for s in allr["sample"]})
    for sid in missing:
        st = trio.loc[trio["Sample ID"] == sid, "Status"].iloc[0]
        mapped = PANEL_ROLE_MAP.get(st, st)
        print(f"  trio row '{sid}' has Status={st} but NO workbook -> {mapped} files "
              f"{file_counts.get(mapped, 0)} (vs {trio_counts.get(st, 0)} in trio file): contributes 0 rows")
    print("  all other roles match trio counts exactly: "
          + ", ".join(f"{r}={file_counts.get(r, 0)}" for r in ["Patient/Proband", "Father", "Mother", "Child"]))

    print("\n--- panel-symbol gene name among kept rows (descriptive, not a filter) ---")
    in_panel = kept["Gene Names"].map(lambda g: gene_token_in_panel(g, panel))
    print(f"  kept rows with a 56-panel symbol in Gene Names : {int(in_panel.sum()):,}")
    print(f"  kept rows with only neighbour/read-through genes: {int((~in_panel).sum()):,}")
    print(f"  panel symbols represented among kept rows      : "
          f"{len({t.strip() for v in kept['Gene Names'] for t in str(v).split(',') if t.strip() in panel})}/{len(panel)}")

    print("\n--- CAVEATS ---")
    blanks = allr[allr["zyg"].eq("<BLANK>")]
    outl = blanks["sample"].isin(["380-P", "381-PM"])
    print(f"  1. {int(outl.sum()):,} of the {len(blanks):,} retained blank genotypes come from 380-P / 381-PM "
          f"({int(blanks['sample'].eq('380-P').sum())} / {int(blanks['sample'].eq('381-PM').sum())}); "
          f"these are ungenotyped superset sites (no DP/GQ/VAF). Excluding all blanks -> {headline - len(blanks):,}.")
    print("  2. Remaining 74 blanks sit at 3 sites (11:119275949, 12:109556171, 17:7676483) with DP/GQ present.")
    print("  3. Trio ID 533 has no workbook and therefore contributes 0 rows.")
    print(f"  4. Exact-duplicate rows (chr:pos + ref/alt + zygosity within a sample) are KEPT, not deduplicated: "
          f"{int(allr.duplicated(['sample', 'Chr:Pos', 'Ref/Alt', 'zyg']).sum())} across the pooled table "
          f"({int(kept.duplicated(['sample', 'Chr:Pos', 'Ref/Alt', 'zyg']).sum())} among kept rows).")
    print(f"  5. Sheet titles ('(Variants 674)') match parsed row counts in only "
          f"{int((audit_df['sheet_title_variant_count'] == audit_df['rows_before']).sum())}/{n_files} files; titles ignored.")

    print("\n--- SECONDARY reading: unique sites across the cohort ---")
    print(f"  unique Chr:Pos                 : {kept['Chr:Pos'].nunique():,}")
    print(f"  unique Chr:Pos + Ref/Alt       : {kept.groupby(['Chr:Pos', 'Ref/Alt']).ngroups:,}")

    print("\n--- SENSITIVITY TABLE (all conventions pre-computed) ---")
    b_noblank = ~allr["zyg"].isin([REFERENCE_LABEL, "<BLANK>"])
    a_ref = ~allr["zyg"].eq(REFERENCE_LABEL)
    pin = allr["Gene Names"].map(lambda g: gene_token_in_panel(g, panel))
    grid = [
        ("HEADLINE: sample rows, drop 'Reference' only (blanks kept, no panel re-filter)", int(a_ref.sum())),
        ("sample rows, drop 'Reference' AND blank no-calls", int(b_noblank.sum())),
        ("sample rows, drop 'Reference' + require 56-panel symbol", int((a_ref & pin).sum())),
        ("sample rows, drop 'Reference' + blanks + require 56-panel symbol", int((b_noblank & pin).sum())),
        ("unique cohort sites, drop 'Reference' only (Chr:Pos)", int(allr.loc[a_ref, 'Chr:Pos'].nunique())),
        ("unique cohort sites, drop 'Reference' only (Chr:Pos+Ref/Alt)",
         int(allr.loc[a_ref].groupby(['Chr:Pos', 'Ref/Alt']).ngroups)),
    ]
    for lbl, v in grid:
        print(f"  {v:>7,}  {lbl}")

    print("\n--- OUTLIER FILES IN AUDIT TABLE ---")
    cols = ["sample", "role", "rows_before", "rows_Reference", "rows_Heterozygous",
            "rows_Homozygous_Variant", "rows_blank_no_call", "rows_after_removing_reference"]
    print(audit_df[audit_df["sample"].isin(["380-P", "381-PM"])][cols].to_string(index=False))
    print("\naudit table written to:", OUT_CSV, f"({n_files} rows)")

    print("\n--- ANSWER ---")
    print(f"ANSWER: {headline:,} CHIP variants remain — that is {headline:,} sample-level variant rows retained "
          f"across all 86 CHIP_DP10_GQ20_PASS workbooks ({total_before:,} rows in, {n_ref:,} rows removed) "
          f"after excluding only rows whose Zygosity call is 'Reference'; the 7,303 Heterozygous and 4,593 "
          f"Homozygous Variant calls sum to 11,896 genotyped variants plus 1,151 retained no-calls.")

    return dict(files=n_files, rows_before=total_before, removed_reference=n_ref,
                headline=headline, het=het, hom=hom, blank=blk,
                unique_chrpos=int(kept["Chr:Pos"].nunique()),
                unique_chrpos_refalt=int(kept.groupby(["Chr:Pos", "Ref/Alt"]).ngroups),
                sensitivity={lbl: v for lbl, v in grid})


if __name__ == "__main__":
    res = main()
    json.dump({k: v for k, v in res.items()}, open("final_summary.json", "w"), indent=2)
