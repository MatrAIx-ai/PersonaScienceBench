"""
Phase 1 (schema audit) for: "How many CHIP variants remain after removing reference calls?"
Reads every input, reports layout, genotype-code value counts, and the sensitivity of the
remaining-count to each ambiguous choice. No final number is declared here.
"""
import os, re, json
import pandas as pd

DATA = "data"
DIR = os.path.join(DATA, "CHIP_DP10_GQ20_PASS")
PREFIX = "230209_Exome_GRCh38_CHIP_"
N_HEADER_ROWS = 2          # row0 = merged group header, row1 = real column names, data starts at row 3


def load_gene_panel():
    s = pd.read_excel(os.path.join(DATA, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx"), header=None)[0]
    return set(s.astype(str).str.strip())


def load_trio():
    t = pd.read_excel(os.path.join(DATA, "230215_Trio_Status.xlsx"))
    t.columns = [str(c).strip() for c in t.columns]
    for c in t.columns:
        if t[c].dtype == object:
            t[c] = t[c].astype(str).str.strip()
    return t


def sheet_variant_count(sheet_name):
    m = re.search(r"Variants\s+(\d+)", sheet_name)
    return int(m.group(1)) if m else None


def load_sample_file(path):
    sheet = pd.ExcelFile(path).sheet_names[0]
    df = pd.read_excel(path, sheet_name=sheet, header=N_HEADER_ROWS - 1)
    df.columns = [str(c).strip() for c in df.columns]
    df = df.dropna(how="all").reset_index(drop=True)
    role_label = str(pd.read_excel(path, sheet_name=sheet, header=None).iloc[0, 4])
    return sheet, df, role_label


def gene_in_panel(value, panel):
    return any(p.strip() in panel for p in str(value).split(",") if p.strip())


def main():
    panel = load_gene_panel()
    trio = load_trio()
    print(f"[panel] {len(panel)} symbols, {len(panel)} unique (headerless single column)")
    print("[trio] rows:", len(trio), "| Status counts:")
    print(trio["Status"].value_counts().to_string())

    frames, audit = [], []
    for fname in sorted(os.listdir(DIR)):
        sample = fname.replace(PREFIX, "").replace(".xlsx", "")
        sheet, df, role_label = load_sample_file(os.path.join(DIR, fname))
        df.insert(0, "sample", sample)
        frames.append(df)
        z = df["Zygosity"].fillna("<BLANK>").astype(str).str.strip()
        vc = z.value_counts().to_dict()
        audit.append(dict(
            sample=sample, sheet=sheet, sheet_variant_count=sheet_variant_count(sheet),
            rows=len(df), Reference=vc.get("Reference", 0),
            Heterozygous=vc.get("Heterozygous", 0),
            Homozygous_Variant=vc.get("Homozygous Variant", 0),
            blank=vc.get("<BLANK>", 0),
            kept_drop_reference_only=len(df) - vc.get("Reference", 0),
            kept_drop_reference_and_blank=vc.get("Heterozygous", 0) + vc.get("Homozygous Variant", 0),
            role_from_header=role_label,
        ))

    allr = pd.concat(frames, ignore_index=True)
    allr["zyg"] = allr["Zygosity"].fillna("<BLANK>").astype(str).str.strip()
    allr["is_ref"] = allr["zyg"].eq("Reference")
    allr["is_blank"] = allr["zyg"].eq("<BLANK>")
    allr["in_panel"] = allr["Gene Names"].map(lambda g: gene_in_panel(g, panel))

    a = ~allr.is_ref
    b = ~allr.is_ref & ~allr.is_blank
    summary = {
        "n_files": len(audit),
        "total_rows": int(len(allr)),
        "zygosity_value_counts": allr["zyg"].value_counts().to_dict(),
        "In_CHIP_all_true": bool(allr["In_CHIP"].astype(str).eq("True").all()),
        "Filter_all_PASS": bool(allr["Filter"].astype(str).eq("PASS").all()),
        "rows_gene_token_in_56_panel": int(allr.in_panel.sum()),
        "rows_gene_token_NOT_in_panel": int((~allr.in_panel).sum()),
        "kept_A_sample_rows_drop_Reference_only": int(a.sum()),
        "kept_B_sample_rows_drop_Reference_and_blank": int(b.sum()),
        "kept_A_plus_panel_filter": int((a & allr.in_panel).sum()),
        "kept_B_plus_panel_filter": int((b & allr.in_panel).sum()),
        "unique_sites_A_chr_pos": int(allr.loc[a, "Chr:Pos"].nunique()),
        "unique_sites_A_chr_pos_ref_alt": int(allr.loc[a].groupby(["Chr:Pos", "Ref/Alt"]).ngroups),
        "unique_sites_B_chr_pos": int(allr.loc[b, "Chr:Pos"].nunique()),
        "unique_sites_all_rows": int(allr["Chr:Pos"].nunique()),
        "blank_rows_in_380P_381PM": int(allr[allr.is_blank]["sample"].isin(["380-P", "381-PM"]).sum()),
        "exact_duplicate_chrpos_refalt_zyg_rows": int(allr.duplicated(["sample", "Chr:Pos", "Ref/Alt", "Zygosity"]).sum()),
    }
    adf = pd.DataFrame(audit)
    adf.to_csv("per_file_counts.csv", index=False)
    allr.to_pickle("all_rows.pkl")
    print("\n" + json.dumps(summary, indent=2))
    print("\n[per-file table written to per_file_counts.csv] head:")
    print(adf[["sample", "rows", "Reference", "Heterozygous", "Homozygous_Variant",
               "blank", "kept_drop_reference_only", "kept_drop_reference_and_blank"]].head(13).to_string(index=False))
    print("\nTOTALS:", {c: int(adf[c].sum()) for c in
                       ["rows", "Reference", "Heterozygous", "Homozygous_Variant", "blank",
                        "kept_drop_reference_only", "kept_drop_reference_and_blank"]})
    # trio <-> file crosswalk check
    ids = set(trio["Sample ID"])
    def match(s):
        for i in ids:
            if s == i or s.startswith(i + "-"):
                return i
        return None
    cw = {s: match(s) for s in adf["sample"]}
    print("\n[crosswalk] files matched to a trio ID:", sum(v is not None for v in cw.values()), "/", len(cw))
    print("[crosswalk] trio IDs with no workbook:", sorted(ids - {v for v in cw.values() if v}))
    st = trio.set_index("Sample ID")["Status"].to_dict()
    pref = {"P": "Patient", "P1": "Patient", "P2": "Patient", "PF": "Father", "PM": "Mother"}
    agree = disagree = 0
    for s_, tid in cw.items():
        if tid is None: continue
        role = adf.loc[adf["sample"] == s_, "role_from_header"].iloc[0].split(" (")[0]
        expected = pref[s_.split("-")[-1]] if s_ in pref or ("-" in s_ and not s_.startswith("SRR")) else st[tid]
        exp = pref.get(s_.split("-")[-1], st.get(tid)) if not s_.startswith("SRR") else st.get(tid)
        agree += exp == st.get(tid)
        disagree += exp != st.get(tid)
    print("[crosswalk] workbook role label consistent with trio Status:", agree, "agreements /", disagree, "disagreements")


if __name__ == "__main__":
    main()
