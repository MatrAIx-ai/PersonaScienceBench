#!/usr/bin/env python3
"""
bixbench bix-8-q5 -- Test of independence between m6A methylation status and
differential-expression status in the bladder-cancer MeRIP-seq capsule.

HEADLINE (locked with researcher):
  3x3 omnibus Pearson chi-square test of independence (correction=False)
  on pd.crosstab(m6A, DEG) over ALL 12,754 records, df = 4.
Sensitivity checks (NOT the answer): collapsed 2x2, unique-gene (ENSG) 2x2.
No |log2FC| / p-value filtering; the precomputed status calls are the variables.
m6A_DEG is a derived Cartesian intersection -> never used as an axis.
Proteomic_data .xlsx is contextual only (no m6A variable) -> excluded.
"""
import numpy as np
import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact
from scipy.special import gammaincc
from math import log

XLSX = "data/MeRIP_RNA_result.xlsx"
SHEET = "Date Formatting"
HYPER, HYPO, NOSIG = "m6A Hyper", "m6A Hypo", "m6A no sig"
UP, DOWN, NODEG = "Up", "Down", "no-DEGs"
ROW = "-" * 78


def sect(t):
    print("\n" + ROW + "\n" + t + "\n" + ROW)


# --------------------------------------------------------------- load / audit
sect("1. LOAD + DATA AUDIT")
df = pd.read_excel(XLSX, sheet_name=SHEET)
print("rows x cols = %d x %d" % (df.shape[0], df.shape[1]))
print("columns:", df.columns.tolist())
print("missing values per column (all must be 0):")
print(df.isna().sum().to_string())
weird = {c: int(df[c].astype(str).str.strip()
                .isin(["", "-", "NA", "na", "N/A", "nan", "None", "?", "--"]).sum())
         for c in df.columns}
print("non-standard token counts:", weird)
print("fully duplicated rows:", int(df.duplicated().sum()))
print("unique ENST = %d ; unique ENSG = %d -> rows are transcript/peak records"
      % (df["GeneID"].nunique(), df["gene_id"].nunique()))
print("\ncategory levels:")
for c in ["m6A", "DEG", "m6A_DEG"]:
    print("  %s: %s" % (c, ", ".join("%s=%d" % (k, v)
                                     for k, v in df[c].value_counts().items())))
derived = df["m6A"] + " and " + df["DEG"]
print("\nm6A_DEG == concatenation of (m6A, DEG) for every row: %s "
      "=> derived, excluded as an axis" % bool((derived == df["m6A_DEG"]).all()))

# --------------------------------------------------------------------- headline
sect("2. HEADLINE: 3x3 PEARSON CHI-SQUARE TEST OF INDEPENDENCE (df=4)")
ct = pd.crosstab(df["m6A"], df["DEG"]).reindex(
    index=[HYPER, HYPO, NOSIG], columns=[DOWN, UP, NODEG])
print("OBSERVED contingency table (rows = m6A status, cols = DEG status):")
print(ct.to_string())
N = int(ct.values.sum())
print("N = %d (all records; both status variables fully annotated -> no drops)" % N)

chi2, p, dof, expct = chi2_contingency(ct.values, correction=False)
print("\nEXPECTED counts under independence:")
print(pd.DataFrame(np.round(expct, 2), index=ct.index,
                   columns=ct.columns).to_string())
print("\nminimum expected count      = %.4f  (cells<5: %d/%d ; cells<1: %d/%d)"
      % (expct.min(), int((expct < 5).sum()), expct.size,
         int((expct < 1).sum()), expct.size))
print("largest expected count      = %.2f" % expct.max())
print("chi2 statistic              = %r" % chi2)
print("dof                         = %d" % dof)
print("p (scipy float64 repr)      = %r" % p)
print("p (17 sig digits)           = %.17g" % p)
print("log10(p)                    = %.6f" % np.log10(p))
print("p finite and > 0            = %s -> genuine float64 value, NOT underflowed "
      "to 0.0 and not a machine-precision floor" % bool(np.isfinite(p) and p > 0.0))
print("p > np.finfo(float).tiny    = %s  (tiny = %.3e ; smallest subnormal = %.3e)"
      % (bool(p > np.finfo(float).tiny), np.finfo(float).tiny,
         np.nextafter(0, 1)))

p_tail = gammaincc(dof / 2.0, chi2 / 2.0)
print("\ncross-check gammaincc(dof/2, chi2/2) = %r  (abs diff %.3e)"
      % (p_tail, abs(p_tail - p)))
x, k2 = chi2 / 2.0, dof / 2.0
log_tail_asym = (-x + (k2 - 1.0) * log(x)) / np.log(10.0)
print("asymptotic chi2-tail bound: log10 P(X>=chi2) <~ %.1f "
      "(leading term only; confirms extreme tail)" % log_tail_asym)

# Monte-Carlo p with fixed margins (conditional hypergeometric sampling)
rng = np.random.default_rng(0)
r_m = ct.values.sum(axis=1).astype(int)
r_d = ct.values.sum(axis=0).astype(int)
E = np.outer(r_m, r_d) / N
n_sim, ge = 20000, 0
for _ in range(n_sim):
    row0 = rng.multivariate_hypergeometric(r_d, int(r_m[0]))
    row1 = rng.multivariate_hypergeometric(r_d - row0, int(r_m[1]))
    tbl = np.vstack([row0, row1, r_d - row0 - row1])
    if ((tbl - E) ** 2 / E).sum() >= chi2 - 1e-9:
        ge += 1
print("Monte-Carlo (fixed margins, %d sims): tables with chi2 >= observed = %d/%d "
      "-> p_MC <= %.1e. Zero exceedances is consistent with an astronomically small "
      "analytic p; the REPORTED value remains the analytic chi-square p "
      "(no fabricated exponent)." % (n_sim, ge, n_sim, max(1, ge) / n_sim))

sect("3. ROUNDED ANSWER (3 significant figures, scientific notation)")
print("ANSWER (3 s.f.)               = %.2e" % p)
print("for reference: 2 s.f. %.1e | 4 s.f. %.3e | repr %r" % (p, p, p))

# ------------------------------------------------------------ sensitivity #1
sect("4. SENSITIVITY CHECK 1 (NOT the answer): collapsed 2x2 any-m6A x any-DEG")
ct2 = pd.crosstab(df["m6A"].isin([HYPER, HYPO]), df["DEG"].isin([UP, DOWN]))
print(ct2.to_string())
c2, p2, d2, e2 = chi2_contingency(ct2.values, correction=False)
print("min expected = %.2f | chi2 = %.4f | dof = %d | p = %r -> %.2e"
      % (e2.min(), c2, d2, p2, p2))
of, pf = fisher_exact(ct2.values)
print("Fisher exact 2x2: p = %r -> %.2e" % (pf, pf))

# ------------------------------------------------------------ sensitivity #2
sect("5. SENSITIVITY CHECK 2 (NOT the answer): unique genes (ENSG)")
g = df.groupby("gene_id").agg(
    m6A_any=("m6A", lambda s: s.isin([HYPER, HYPO]).any()),
    deg_any=("DEG", lambda s: (s != NODEG).any()))
ctg = pd.crosstab(g["m6A_any"], g["deg_any"])
print("N genes = %d" % len(g))
print(ctg.to_string())
cg, pg, dg, eg = chi2_contingency(ctg.values, correction=False)
print("min expected = %.2f | chi2 = %.4f | dof = %d | p = %r -> %.2e"
      % (eg.min(), cg, dg, pg, pg))
ofg, pfg = fisher_exact(ctg.values)
print("Fisher exact: p = %r -> %.2e" % (pfg, pfg))

sect("6. DIRECTIONAL STRUCTURE (descriptive only)")
stdres = (ct.values - expct) / np.sqrt(expct)
print("standardized residuals:")
print(pd.DataFrame(np.round(stdres, 2), index=ct.index,
                   columns=ct.columns).to_string())
print("observed/expected ratios:")
print(pd.DataFrame(np.round(ct.values / expct, 2), index=ct.index,
                   columns=ct.columns).to_string())
print("\nm6A Hypo x Down: O/E %.2fx (std.res %.1f); m6A Hyper x Up: O/E %.2fx "
      "(std.res %.1f); m6A Hypo x Up depleted."
      % (ct.loc[HYPO, DOWN] / expct[1, 0], stdres[1, 0],
         ct.loc[HYPER, UP] / expct[0, 1], stdres[0, 1]))

sect("7. EXCLUSIONS")
print("Proteomic_data .xlsx ('Tumor vs Normal'): proteomics-only, no m6A variable, "
      "different gene universe -> contextual, EXCLUDED.")
print("Row-index-12 GeneID/GeneID.1 mis-alignment: unused annotation block only.")

print("\n" + ROW)
print("FINAL ANSWER (headline 3x3 chi-square of independence, df=4, N=%d): "
      "p = %.2e" % (N, p))
print(ROW)
