#!/usr/bin/env python
"""Driver: bix-9-q5  -- per-tissue bad_responder vs Control DE, literal rule
(BH padj<0.05 & log2FC>0.5 & baseMean>10), computed from BOTH sources side by side:
  (A) NB2 GLM on the supplied normalized counts (size factors = 1, counts rounded)
  (B) the workbook's own precomputed DESeq blocks (Comparison 2/5/8 = Control vs bad_responder)
Writes: results/*.csv, results/report.md
"""
import json, sys, time
import numpy as np, pandas as pd
sys.path.insert(0, "analysis")
import de_analysis_paroxetine as M
import nb2_variants as V

OUT = "results"
LOG2_15 = float(np.log2(1.5))
RULE_LIT = "LITERAL padj<0.05 & lfc>0.5 & baseMean>10"
RULES = [RULE_LIT, "padj<0.05 & abs(lfc)>0.5 & baseMean>10", "raw p<0.05 & lfc>0.5 & baseMean>10",
         "raw p<0.05 & abs(lfc)>0.5 & baseMean>10", "padj<0.05 & lfc>0.5 (no baseMean filter)",
         f"padj<0.05 & lfc>log2(1.5)={LOG2_15:.3f} & baseMean>10"]

t0 = time.time()
meta, genes, counts, tmx, tmd, wb, mp = M.load()
ng = len(genes)
rows, agree, sens, tops, passW, passG = [], [], [], [], [], []
glm_store = {}
for t in M.TISSUES:
    cols = [c for c in meta.index if meta.loc[c, "Tissue"] == t]
    ii = [list(meta.index).index(c) for c in cols]
    isbad = np.array([meta.loc[c, "Response"] == "bad_responder" for c in cols])
    order = np.concatenate([np.where(~isbad)[0], np.where(isbad)[0]])
    Y = counts[:, ii][:, order]
    x = np.concatenate([np.zeros((~isbad).sum()), np.ones(isbad.sum())])
    baseMean = Y.mean(1)
    keep = Y.sum(1) > 0
    r = M.nb2_glm(Y[keep], x)                        # (A) DESeq2-equivalent NB2 GLM, supplied scale
    p = np.full(ng, np.nan); p[keep] = r["pval"]
    lfc = np.full(ng, np.nan); lfc[keep] = r["log2FC"]
    disp = np.full(ng, np.nan); disp[keep] = r["alpha"]
    padj = np.full(ng, np.nan); padj[keep] = M.bh(p[keep])
    tested = np.isfinite(p) & np.isfinite(lfc)
    rt = V.fit_nb2(Y, x, replace_outliers=True, disp="trend")   # sensitivity: dispersion trend
    pt_ = rt["pval"]; tt = np.isfinite(pt_)
    padj_t = np.full(ng, np.nan); padj_t[tt] = M.bh(pt_[tt])
    K = M.WB_BAD_VS_CTRL[t]; W = wb[K]
    # literal reading: padj present and lfc present; +Inf lfc (all-zero control group) satisfies lfc>0.5
    wt = ~np.isnan(W["padj"]) & ~np.isnan(W["lfc"])
    def sets():
        return {RULES[0]: (tested & (padj < .05) & (lfc > .5) & (baseMean > 10),
                           wt & (W["padj"] < .05) & (W["lfc"] > .5) & (W["baseMean"] > 10)),
                RULES[1]: (tested & (padj < .05) & (np.abs(lfc) > .5) & (baseMean > 10),
                           wt & (W["padj"] < .05) & (np.abs(W["lfc"]) > .5) & (W["baseMean"] > 10)),
                RULES[2]: (tested & (p < .05) & (lfc > .5) & (baseMean > 10),
                           wt & (W["pval"] < .05) & (W["lfc"] > .5) & (W["baseMean"] > 10)),
                RULES[3]: (tested & (p < .05) & (np.abs(lfc) > .5) & (baseMean > 10),
                           wt & (W["pval"] < .05) & (np.abs(W["lfc"]) > .5) & (W["baseMean"] > 10)),
                RULES[4]: (tested & (padj < .05) & (lfc > .5), wt & (W["padj"] < .05) & (W["lfc"] > .5)),
                RULES[5]: (tested & (padj < .05) & (lfc > LOG2_15) & (baseMean > 10),
                           wt & (W["padj"] < .05) & (W["lfc"] > LOG2_15) & (W["baseMean"] > 10))}
    S = sets(); lit, wl = S[RULE_LIT]
    lit_t = tt & (padj_t < .05) & (rt["log2FC"] > .5) & (rt["baseMean"] > 10)
    bm_ok = tested & (baseMean > 10); padj_f = np.full(ng, np.nan); padj_f[bm_ok] = M.bh(p[bm_ok])
    lit_f = bm_ok & (padj_f < .05) & (lfc > .5)
    okc = tested & wt & np.isfinite(W["lfc"]) & np.isfinite(lfc) & (baseMean > 10)   # like-for-like lfc comparison
    msc = wt & (baseMean > 20) & np.isfinite(W["baseMean"])
    scale_wb = float(np.median(W["baseMean"][msc] / baseMean[msc]))
    rows.append(dict(tissue=t, contrast=f"{int((~isbad).sum())} Control vs {int(isbad.sum())} bad_responder",
                     genes_total=ng, genes_tested_GLM=int(tested.sum()),
                     genes_baseMean_gt10_GLM=int((baseMean > 10).sum()),
                     genes_baseMean_gt10_workbook=int((W["baseMean"] > 10).sum()),
                     ANSWER_GLM=int(lit.sum()), ANSWER_workbook_PRIMARY=int(wl.sum()),
                     GLM_sens_trend_disp=int(lit_t.sum()), GLM_sens_BH_within_bm10=int(lit_f.sum()),
                     abs_lfc_GLM=int(S[RULES[1]][0].sum()), abs_lfc_workbook=int(S[RULES[1]][1].sum()),
                     rawp_GLM=int(S[RULES[2]][0].sum()), rawp_workbook=int(S[RULES[2]][1].sum()),
                     workbook_DEG_Max_U=int((W["deg_max"] == "U").sum()),
                     workbook_DEG_Median_U=int((W["deg_med"] == "U").sum()),
                     hits_with_infinite_lfc=int(np.isinf(W["lfc"][wl]).sum()),
                     baseMean_scale_workbook_over_supplied=round(scale_wb, 3),
                     median_dispersion_GLM=round(float(np.nanmedian(disp[tested])), 4),
                     median_abs_lfc_diff=round(float(np.nanmedian(np.abs(lfc - W["lfc"])[okc])), 4),
                     lfc_pearson_r=round(float(np.corrcoef(lfc[okc], W["lfc"][okc])[0, 1]), 4),
                     lfc_corr_n=int(okc.sum()),
                     smallest_p_GLM="%.1e" % np.nanmin(p[tested]), smallest_p_workbook="%.1e" % np.nanmin(W["pval"][wt])))
    for rule, (gs, ws) in S.items():
        sens.append(dict(rule=rule, tissue=t, count_GLM=int(gs.sum()),
                         count_workbook=(int(ws.sum()) if ws is not None else np.nan)))
    jac = (lit & wl).sum() / max(1, (lit | wl).sum())
    agree.append(dict(tissue=t, both=int((lit & wl).sum()), GLM_only=int((lit & ~wl).sum()),
                      workbook_only=int((~lit & wl).sum()), neither=int((~lit & ~wl).sum()),
                      jaccard=round(jac, 4),
                      workbook_hits_with_GLM_p_lt_0p05=int((p[wl] < .05).sum()),
                      workbook_hits_with_GLM_p_lt_0p001=int((p[wl] < .001).sum()),
                      median_GLM_p_of_workbook_hits="%.2e" % np.nanmedian(p[wl]),
                      median_workbook_p_of_workbook_hits="%.2e" % np.nanmedian(W["pval"][wl])))
    for i in np.where(~lit & wl)[0]:
        passW.append(dict(tissue=t, gene=genes[i], glm_log2FC=lfc[i], glm_p=p[i], glm_padj=padj[i],
                          glm_baseMean=baseMean[i], glm_dispersion=disp[i], wb_log2FC=W["lfc"][i],
                          wb_p=W["pval"][i], wb_padj=W["padj"][i], wb_baseMean=W["baseMean"][i]))
    for i in np.where(lit & ~wl)[0]:
        passG.append(dict(tissue=t, gene=genes[i], glm_log2FC=lfc[i], glm_p=p[i], glm_padj=padj[i],
                          glm_baseMean=baseMean[i], glm_dispersion=disp[i], wb_log2FC=W["lfc"][i],
                          wb_p=W["pval"][i], wb_padj=W["padj"][i], wb_baseMean=W["baseMean"][i]))
    h = np.where(lit)[0]
    tops.append(pd.DataFrame(dict(tissue=t, gene=genes[h], log2FC_GLM=lfc[h], padj_GLM=padj[h], p_GLM=p[h],
                                  baseMean_GLM=baseMean[h], dispersion_GLM=disp[h], log2FC_workbook=W["lfc"][h],
                                  p_workbook=W["pval"][h], padj_workbook=W["padj"][h],
                                  baseMean_workbook=W["baseMean"][h],
                                  workbook_DEG_Max=W["deg_max"][h], also_passes_literal_workbook=wl[h])
                          ).sort_values(["p_GLM", "log2FC_GLM"], ascending=[True, False]))
    # workbook top genes in the winning comparison (for the biological sanity check)
    hw = np.where(wl)[0]
    pd.DataFrame(dict(tissue=t, gene=genes[hw], log2FC_workbook=W["lfc"][hw], padj_workbook=W["padj"][hw],
                      baseMean_workbook=W["baseMean"][hw], glm_log2FC=lfc[hw], glm_p=p[hw],
                      glm_padj=padj[hw], workbook_DEG_Max=W["deg_max"][hw])
                 ).sort_values("padj_workbook").to_csv(f"{OUT}/workbook_literal_hits_{t}.csv", index=False)
    for nm, arr in [("lfc", lfc), ("padj", padj), ("p", p), ("baseMean", baseMean), ("disp", disp)]:
        np.save(f"{OUT}/glm_{t}_{nm}.npy", arr)
    glm_store[t] = dict(lit=int(lit.sum()), wl=int(wl.sum()))
    print(f"[{t}] tested={int(tested.sum())} bm>10={int((baseMean>10).sum())} ANSWER GLM={int(lit.sum())} "
          f"workbook={int(wl.sum())} jaccard={jac:.3f}", flush=True)

pt = pd.DataFrame(rows); pt.to_csv(f"{OUT}/per_tissue_counts.csv", index=False)
pd.DataFrame(agree).to_csv(f"{OUT}/agreement_literal_GLM_vs_workbook.csv", index=False)
pd.DataFrame(sens).to_csv(f"{OUT}/sensitivity_variants_long.csv", index=False)
pd.concat([pd.DataFrame(passW)], ignore_index=True).to_csv(f"{OUT}/passing_workbook_only.csv", index=False)
pd.concat([pd.DataFrame(passG)], ignore_index=True).to_csv(f"{OUT}/passing_GLM_only.csv", index=False)
tops = pd.concat(tops, ignore_index=True); tops.to_csv(f"{OUT}/all_literal_GLM_hits.csv", index=False)
pt[["tissue", "baseMean_scale_workbook_over_supplied"]].to_csv(f"{OUT}/discrepancy_scale_factor.csv", index=False)
sv = pd.DataFrame(sens).pivot(index="rule", columns="tissue", values=["count_GLM", "count_workbook"])
sv.to_csv(f"{OUT}/sensitivity_variants.csv")
val = M.validate_vs_statsmodels(counts, meta, n_test=150)
val.to_csv(f"{OUT}/statsmodels_validation_subset.csv", index=False)
summary = dict(runtime_s=round(time.time() - t0, 1), n_genes=ng,
               validation=dict(n=int(len(val)),
                               corr_log2FC=round(float(np.corrcoef(val.glm_log2FC, val.statsmodels_log2FC)[0, 1]), 8),
                               median_abs_log2FC_diff=float(np.median(abs(val.glm_log2FC - val.statsmodels_log2FC))),
                               spearman_p=round(float(pd.Series(val.glm_p).corr(pd.Series(val.statsmodels_p), method="spearman")), 4)),
               answer_counts_GLM={r.tissue: int(r.ANSWER_GLM) for r in pt.itertuples()},
               answer_counts_workbook={r.tissue: int(r.ANSWER_workbook_PRIMARY) for r in pt.itertuples()})
json.dump(summary, open(f"{OUT}/summary.json", "w"), indent=1)
print(json.dumps(summary["validation"], indent=1))
print(pt.to_string(index=False)); print(pt[["tissue", "ANSWER_GLM", "ANSWER_workbook_PRIMARY"]])
