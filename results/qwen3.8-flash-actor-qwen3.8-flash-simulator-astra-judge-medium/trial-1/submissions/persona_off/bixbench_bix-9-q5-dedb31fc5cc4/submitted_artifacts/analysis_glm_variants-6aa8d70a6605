"""NB2 GLM variants (DESeq2-equivalent steps) used as the independent re-implementation
cross-check of the workbook's DESeq columns.  Importable and used by de_analysis_paroxetine.py."""
import numpy as np
from scipy.stats import norm
from scipy.special import gammaln
from de_analysis_paroxetine import _nb2_loglik
import pandas as pd  # noqa: F401


def _score(Y, X, x, alpha, beta, iters=40, tol=1e-10):
    for _ in range(iters):
        eta = beta[:, 0:1] + beta[:, 1:2] * x[None, :]
        mu = np.exp(np.clip(eta, -30, 30))
        w = mu / (1.0 + alpha[:, None] * mu)
        z = eta + (Y - mu) / mu
        I00 = w.sum(1); I01 = (w * x).sum(1); I11 = (w * x * x).sum(1)
        s0 = (w * z).sum(1); s1 = (w * z * x).sum(1)
        det = I00 * I11 - I01 ** 2
        det = np.where(np.abs(det) < 1e-12, np.nan, det)
        nb0 = (I11 * s0 - I01 * s1) / det; nb1 = (I00 * s1 - I01 * s0) / det
        step = np.clip(np.column_stack([nb0 - beta[:, 0], nb1 - beta[:, 1]]), -1.5, 1.5)
        beta = beta + step
        if np.nanmax(np.abs(step)) < tol:
            break
    eta = beta[:, 0:1] + beta[:, 1:2] * x[None, :]
    mu = np.exp(np.clip(eta, -30, 30))
    return beta, mu


def _info(beta, x, alpha):
    w = np.exp(np.clip(beta[:, 0:1] + beta[:, 1:2] * x[None, :], -30, 30))
    w = w / (1.0 + alpha[:, None] * w)
    I00 = w.sum(1); I01 = (w * x).sum(1); I11 = (w * x * x).sum(1)
    det = I00 * I11 - I01 ** 2
    return np.where(np.abs(det) < 1e-12, np.nan, I00 / det)      # var(beta1)


def _alphahat(Y, mu, alpha):
    """profile-likelihood NB2 dispersion (grid + local refinement), vectorised."""
    lo, hi = 1e-6, 5.0
    for _ in range(3):
        grid = np.exp(np.linspace(np.log(lo), np.log(hi), 21))
        ll = np.vstack([_nb2_loglik(Y, mu, a) for a in grid])
        k = np.argmax(np.where(np.isfinite(ll), ll, -np.inf), 0)
        g_lo = grid[np.maximum(k - 1, 0)]; g_hi = grid[np.minimum(k + 1, len(grid) - 1)]
        frac = np.linspace(0, 1, 9)[None, :]
        loc = g_lo[:, None] * (np.maximum(g_hi[:, None], g_lo[:, None] * 1.000001) / g_lo[:, None]) ** frac
        ll2 = _nb2_loglik_grid(Y, mu, loc)
        a = np.take_along_axis(loc, np.argmax(np.where(np.isfinite(ll2), ll2, -np.inf), 1)[:, None], 1)[:, 0]
        break
    return np.clip(a, 1e-6, 5.0)


def _nb2_loglik_grid(Y, mu, alpha2d):
    r = 1.0 / alpha2d[:, :, None]
    Yb = Y[:, None, :]; mb = mu[:, None, :]
    ll = gammaln(Yb + r) - gammaln(r) - gammaln(Yb + 1.0)
    ll += r * (np.log(r) - np.log(r + mb))
    ll += Yb * (np.log(np.clip(mb, 1e-300, None)) - np.log(r + mb))
    return ll.sum(-1)


def cooks_flags(Y, x, beta, mu, alpha, cutoff=6.6349, npar=2):
    """DESeq2-style count-outlier flags: Cook's distance from the NB GLM fit vs qf(.99,1,Inf)."""
    w = mu / (1.0 + alpha[:, None] * mu)
    I00 = w.sum(1); I01 = (w * x).sum(1); I11 = (w * x * x).sum(1)
    det = I00 * I11 - I01 ** 2
    levs = np.empty_like(Y)
    for j in range(Y.shape[1]):
        # x_j'(X'WX)^{-1}x_j  for x_j = (1, x_j)
        a = I11 - 2 * x[j] * I01 + x[j] ** 2 * I00
        levs[:, j] = w[:, j] * a / np.where(np.abs(det) < 1e-12, np.nan, det)
    levs = np.clip(levs, 0, 0.999)
    V = mu + alpha[:, None] * mu ** 2
    rp = (Y - mu) / np.sqrt(np.where(V <= 0, np.nan, V))
    D = (rp ** 2) / npar * levs / (1.0 - levs) ** 2
    return D > cutoff


def fit_nb2(Y, x, replace_outliers=True, disp="mle", trend_df=25):
    """Returns dict(log2FC, dispersion, pval, baseMean, n_outlier_replaced, drop)."""
    Y = np.rint(Y).astype(float)
    x = np.asarray(x, float)
    G = Y.shape[0]
    beta = np.column_stack([np.log(np.maximum(Y.mean(1), 1e-6) * (1 - x.mean())), np.zeros(G)])
    alpha = np.full(G, 0.05)
    flag = np.zeros(Y.shape, bool)
    Ywork = Y.copy()
    nrep = np.zeros(G, int)
    rounds = 3 if replace_outliers else 1
    for rd in range(rounds):
        for outer in range(4):
            beta, mu = _score(Ywork, None, x, alpha, beta)
            resid = (Ywork - mu) ** 2 - mu
            den = (mu ** 2).sum(1)
            alpha = np.clip(np.where(den > 0, resid.sum(1) / np.maximum(den, 1e-12), 0.05), 1e-6, 5.0)
            beta, mu = _score(Ywork, None, x, alpha, beta)
            alpha = _alphahat(Ywork, mu, alpha)
        if rd < rounds - 1:
            newflag = cooks_flags(Ywork, x, beta, mu, alpha)
            newflag &= ~flag
            if not newflag.any():
                break
            flag |= newflag
            nrep += newflag.sum(1)
            ok = ~flag
            cnt = ok.sum(1)
            with np.errstate(invalid="ignore"):
                rep = np.where(ok, Ywork, 0).sum(1) / np.maximum(cnt, 1)
            Ywork = np.where(flag, rep[:, None], Ywork)
    beta, mu = _score(Ywork, None, x, alpha, beta)
    disp_mle = alpha.copy()
    baseMean = Y.mean(1)
    drop = np.zeros(G, bool)
    if replace_outliers:
        drop |= ((~np.isfinite(mu)).any(1)) | ((baseMean <= 0)) | (nrep > (Y.shape[1] - 7))
    if disp == "trend":
        keep = (baseMean > 0.5) & np.isfinite(disp_mle) & ~drop
        lx = np.log2(baseMean + 1.0)
        edges = np.quantile(lx[keep], np.linspace(0, 1, trend_df + 1))
        edges[0] -= 1e-9; edges[-1] += 1e-9
        b = np.clip(np.digitize(lx, edges) - 1, 0, trend_df - 1)
        fitv = np.full(trend_df, np.nan)
        for k in range(trend_df):
            m = keep & (b == k)
            if m.sum() >= 15:
                fitv[k] = np.median(np.log2(disp_mle[m]))
        fitv = pd_series_smooth(fitv)
        centres = np.array([lx[keep & (b == k)].mean() if (keep & (b == k)).sum() >= 15 else np.nan
                            for k in range(trend_df)])
        good = np.isfinite(fitv) & np.isfinite(centres)
        trend = np.interp(lx, centres[good], fitv[good])
        alpha = np.clip(2.0 ** trend, 1e-6, 5.0)
        beta, mu = _score(Ywork, None, x, alpha, beta)
    var1 = _info(beta, x, alpha)
    with np.errstate(divide="ignore", invalid="ignore"):
        z = beta[:, 1] / np.sqrt(var1)
    pv = 2 * norm.sf(np.abs(z))
    pv[~np.isfinite(z) | drop] = np.nan
    return dict(log2FC=beta[:, 1], dispersion=disp_mle, dispersion_used=alpha, pval=pv,
                baseMean=baseMean, n_outlier_replaced=nrep, dropped=drop)


def pd_series_smooth(v, win=5):
    v = np.asarray(v, float); n = len(v); out = v.copy()
    for i in range(n):
        lo, hi = max(0, i - win // 2), min(n, i + win // 2 + 1)
        seg = v[lo:hi]; seg = seg[np.isfinite(seg)]
        out[i] = np.median(seg) if seg.size else np.nan
    # fill leading/trailing NaNs
    idx = np.arange(n); g = np.isfinite(out)
    if g.any():
        out = np.interp(idx, idx[g], out[g])
    return out
