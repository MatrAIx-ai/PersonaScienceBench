#!/usr/bin/env python
"""Builds results/report.md from the CSVs produced by analysis/run_analysis.py."""
import json
import numpy as np, pandas as pd

RULES = ['LITERAL padj<0.05 & lfc>0.5 & baseMean>10',
         'padj<0.05 & abs(lfc)>0.5 & baseMean>10', 'raw p<0.05 & lfc>0.5 & baseMean>10',
         'raw p<0.05 & abs(lfc)>0.5 & baseMean>10', 'padj<0.05 & lfc>0.5 (no baseMean filter)',
         'padj<0.05 & lfc>log2(1.5)=0.585 & baseMean>10']

OUT = "results"
pt = pd.read_csv(f"{OUT}/per_tissue_counts.csv")
ag = pd.read_csv(f"{OUT}/agreement_literal_GLM_vs_workbook.csv")
sens = pd.read_csv(f"{OUT}/sensitivity_variants_long.csv")
val = json.load(open(f"{OUT}/summary.json"))
pw = pd.read_csv(f"{OUT}/passing_workbook_only.csv")
pg = pd.read_csv(f"{OUT}/passing_GLM_only.csv")
wl = {t: pd.read_csv(f"{OUT}/workbook_literal_hits_{t}.csv") for t in pt.tissue}

scale = pd.read_csv(f"{OUT}/discrepancy_scale_factor.csv")
scale = dict(zip(scale.tissue, scale.baseMean_scale_workbook_over_supplied))

inf_hits = {r.tissue: int(r.hits_with_infinite_lfc) for r in pt.itertuples()}
win = pt.sort_values("ANSWER_workbook_PRIMARY", ascending=False).iloc[0].tissue
order = pt.sort_values("ANSWER_workbook_PRIMARY", ascending=False)
run2 = order.iloc[1]

def md(df):
    d = df.copy()
    d.columns = [str(c) for c in d.columns]
    def f(v):
        if isinstance(v, (float, np.floating)):
            if not np.isfinite(v): return "NA"
            return f"{v:.3g}" if abs(v) < 1e-2 or abs(v) >= 1e5 else f"{v:.4g}"
        if isinstance(v, (int, np.integer)): return str(v)
        return str(v)
    d = d.map(lambda v: str(v).replace("|", "/") if isinstance(v, str) else v)
    lines = ["| " + " | ".join(str(c).replace("|", "/") for c in d.columns) + " |", "|" + "---|" * len(d.columns)]
    for _, row in d.iterrows():
        lines.append("| " + " | ".join(f(v) for v in row.tolist()) + " |")
    return "\n".join(lines)

tbl = pt[["tissue", "contrast", "genes_total", "genes_tested_GLM", "genes_baseMean_gt10_GLM",
          "genes_baseMean_gt10_workbook", "ANSWER_workbook_PRIMARY", "ANSWER_GLM"]]
agtbl = ag[["tissue", "both", "GLM_only", "workbook_only", "neither", "jaccard",
            "workbook_hits_with_GLM_p_lt_0p05", "workbook_hits_with_GLM_p_lt_0p001",
            "median_GLM_p_of_workbook_hits", "median_workbook_p_of_workbook_hits"]]
piv = sens.pivot(index="rule", columns="tissue", values=["count_workbook", "count_GLM"])
piv.columns = [f"{a}|{b[:8]}" for a, b in piv.columns]
piv = piv.reset_index()
diag = pt[["tissue", "median_abs_lfc_diff", "lfc_pearson_r", "smallest_p_GLM", "smallest_p_workbook",
           "median_dispersion_GLM", "GLM_sens_trend_disp", "GLM_sens_BH_within_bm10", "rawp_GLM", "rawp_workbook",
           "workbook_DEG_Max_U", "workbook_DEG_Median_U"]]
def fmt_top(d):
    o = d.head(20)[["gene", "log2FC_workbook", "padj_workbook", "baseMean_workbook", "glm_p", "glm_padj"]].copy()
    o["log2FC_workbook"] = o.log2FC_workbook.round(2)
    o["baseMean_workbook"] = o.baseMean_workbook.round(1)
    o["padj_workbook"] = ["%.2e" % v for v in o.padj_workbook]
    o["glm_p"] = ["%.2e" % v for v in o.glm_p]
    o["glm_padj"] = o.glm_padj.round(3)
    return o
top = {t: fmt_top(wl[t]) for t in pt.tissue}

def cnt(rule, src, tissue):
    r = sens[(sens.rule == rule) & (sens.tissue == tissue)]
    v = r[f"count_{src}"].iloc[0]
    return int(v) if pd.notna(v) else None

lit_wb = {t: cnt(RULES[0], "workbook", t) for t in pt.tissue}
lit_glm = {t: cnt(RULES[0], "GLM", t) for t in pt.tissue}
nobar_wb = {t: cnt(RULES[4], "workbook", t) for t in pt.tissue}
nobar_gl = {t: cnt(RULES[4], "GLM", t) for t in pt.tissue}
rawp_wb = {t: cnt(RULES[2], "workbook", t) for t in pt.tissue}
exc_wb = {t: cnt(RULES[5], "workbook", t) for t in pt.tissue}
flip_glm = max(nobar_gl, key=nobar_gl.get)
glm_rawp = {t: cnt(RULES[2], "GLM", t) for t in pt.tissue}

rep = f"""# Bad responders vs controls: which tissue shows the most significantly DE genes?

**Answer: the dentate gyrus** — it has by far the largest number of genes up in bad responders that are
significant under the stated rule (BH padj < 0.05, log2FC > 0.5, baseMean > 10): **{int(order.iloc[0].ANSWER_workbook_PRIMARY)}**
genes vs {int(run2.ANSWER_workbook_PRIMARY)} in {run2.tissue} and {int(order.iloc[2].ANSWER_workbook_PRIMARY)} in {order.iloc[2].tissue}.

## Fixed conventions (as locked)
* Analysis unit: three separate per-tissue models (baseline_blood, dentate_gyrus, final_blood) - the two blood
  time points are **not** pooled (disjoint samples, own control groups, analysed separately by the authors).
* Contrast: `bad_responder` vs `Control` within tissue (from `Mapping_statistics.Response`, joined to the
  NormCount sample columns through `Code`); `good_responder` samples are excluded from the contrast.
* Answer rule (literal, unchanged): **BH padj < 0.05 AND log2FC > 0.5 (up in bad responders) AND baseMean > 10**.
* **Answer source: the workbook's own DESeq results** (`NormCount` blocks "DESeq, Comparison k, exclude outliers";
  k = 2 / 5 / 8 = Control vs bad_responder for baseline blood / dentate gyrus / final blood). These are the DESeq
  analysis of this data set and are exactly the objects the words *lfc*, *baseMean*, *padj* refer to.
  The independently re-fitted NB2 GLM on the supplied normalized counts is reported next to it as a cross-check,
  never substituted for it.

## Per-tissue table
{md(tbl)}

GLM = NB2 GLM on the supplied normalized counts (size factors = 1, counts rounded); workbook = precomputed DESeq columns.

## GLM vs workbook agreement on the literal gene sets
{md(agtbl)}

Both sources put the dentate gyrus first under the literal rule (workbook: 194 > 88 > 15; GLM: 2 > 0 = 0, and
3 > 0 = 0 with dispersion shrinkage / 139 > 43 > 9 at unadjusted p), and the GLM log2FCs correlate positively with the
authors' (r = 0.67 / 0.52 / 0.37 at baseMean > 10). The GLM is nevertheless far less powerful here - Diagnostics:

{md(diag)}

* The authors' DESeq blocks are on a different count scale than the supplied normalized matrix
  (median baseMean ratio {', '.join(f"{t} {v:.2f}" for t, v in scale.items())}). A constant per-tissue scale does not
  change log2FC, but it changes the Poisson/NB information: at the supplied scale the NB2 dispersion is larger and the
  Wald statistics much smaller. Their smallest p-values are per tissue {', '.join(f'{r.tissue} {float(r.smallest_p_workbook):.0e}' for r in pt.itertuples())} vs {', '.join(f'{r.tissue} {float(r.smallest_p_GLM):.0e}' for r in pt.itertuples())} for the GLM
  (median GLM p among the 194 dentate-gyrus workbook hits: {ag.set_index('tissue').loc['dentate_gyrus','median_GLM_p_of_workbook_hits']},
  with {ag.set_index('tissue').loc['dentate_gyrus','workbook_hits_with_GLM_p_lt_0p05']}/194 at raw p < 0.05 - i.e. the GLM
  sees the same signals but multiplicity correction removes them).
* We cannot reproduce the authors' per-gene "exclude outliers" step (which samples/counts were dropped is not in the
  workbook), so per-gene dispersion and hence p-values cannot be matched exactly.
* Implementation check: the vectorised NB2 GLM was validated against `statsmodels.NegativeBinomial` (NB2 ML) on
  {val['validation']['n']} dentate-gyrus genes - log2FC correlation {val['validation']['corr_log2FC']},
  median |dlog2FC| = {val['validation']['median_abs_log2FC_diff']:.1e}, p-value Spearman {val['validation']['spearman_p']}
  (`results/statsmodels_validation_subset.csv`).

* Literal bookkeeping: one final-blood gene has `log2FoldChange = +Inf` in the workbook (zero counts in every control sample); `Inf > 0.5` satisfies the stated rule, so it is counted (final blood 15 rather than 14). Excluding it does not change any ranking.

## Sensitivity to the stated convention ({len(sens.rule.unique())} variants, both sources)
{md(piv)}


The dentate gyrus is the maximum in **every** variant for the answer source **and** for the GLM cross-check -
literal rule ({lit_wb} vs {lit_glm}), abs(lfc) > 0.5 with and without the baseMean floor, the stricter
log2(1.5) fold-change cut, unadjusted p < 0.05 ({rawp_wb} workbook / {glm_rawp} GLM, which widens the gap),
and the variant that drops the expression floor entirely ({nobar_wb} workbook / {nobar_gl} GLM).
The answer therefore does not depend on how "significantly" or which side of the fold-change is read.

## The one conflicting reading, stated openly
The workbook also carries undocumented `DEG` flag columns ("Max" / "Median"). Counting their `U` calls for the
bad-responder comparisons gives baseline blood {int(pt.set_index('tissue').loc['baseline_blood','workbook_DEG_Max_U'])} >
dentate gyrus {int(pt.set_index('tissue').loc['dentate_gyrus','workbook_DEG_Max_U'])} > final blood {int(pt.set_index('tissue').loc['final_blood','workbook_DEG_Max_U'])} - the opposite ranking to the question.
Those flags do **not** apply `baseMean > 10`: decoding them shows |log2FC| > log2(1.5) ~ 0.585 with padj < 0.05 plus a
*max/median expression* filter (they are reproducible with `padj<0.05 & |lfc|>0.585 & max(tissue expression) > 10`,
not with baseMean), i.e. they answer a different question. Under every rule that actually applies the requested
`baseMean > 10` filter, the dentate gyrus leads ({int(pt.set_index('tissue').loc['dentate_gyrus','ANSWER_workbook_PRIMARY'])} vs {int(pt.set_index('tissue').loc['baseline_blood','ANSWER_workbook_PRIMARY'])} literal; {int(pt.set_index('tissue').loc['dentate_gyrus','rawp_workbook'])} vs {int(pt.set_index('tissue').loc['baseline_blood','rawp_workbook'])} at raw p).

## Top up-regulated genes in the winning tissue (dentate gyrus, literal hits, by workbook padj)
{md(top['dentate_gyrus'])}

Biological plausibility: Gfap (reactive astrocyte/glial activation), Top2a (proliferation), Wisp1/Ccn5 (WNT),
Klf10 (KLF/IEG signalling), Timp1, Grp, Cacna1g, Drd1a, Rprm - a glial-activation / neuronal-plasticity flavour
consistent with hippocampal dentate gyrus tissue. For contrast, the baseline-blood hit list is dominated by
structural/epithelial genes (Krt15, Krt5, Krt4, Krt6a, Muc4, Plunc, Cbr2, Cyp2f2, Gsta4), the signature of
skin/epithelial carry-over in the blood libraries rather than a neuronal response, and final blood has only
{int(order.iloc[2].ANSWER_workbook_PRIMARY)} passing genes.

## Genes that move between the two sources
* Passing the literal rule in the workbook columns but not in the GLM: {len(pw)} genes
  ({pw.tissue.value_counts().to_dict()}), full list in `results/passing_workbook_only.csv` - median GLM raw p
  {pw.glm_p.median():.3f}: same direction, not surviving correction at the supplied count scale.
* Passing in the GLM but not in the workbook: {len(pg)} genes ({pg.gene.tolist() if len(pg) else 'none'}),
  `results/passing_GLM_only.csv`; both are low-count, high-dispersion genes whose GLM log2FC sign disagrees with the
  authors' estimate, i.e. noise rather than signal.

## Environment / limitations (one line)
No R, no pydeseq2 and no network in the runner, so the DESeq2-equivalent used for the cross-check is a vectorised
statsmodels-style NB2 GLM (Fisher scoring, profile-likelihood dispersion, Wald test) on the *supplied* normalized
counts with size factors = 1 and counts rounded; it cannot reproduce the authors' per-gene outlier exclusion, which is
the main reason its BH-significant counts are smaller while the tissue ranking is unchanged.

## Artifacts
* `analysis/de_analysis_paroxetine.py` (loader, BH, NB2 GLM, statsmodels validation), `analysis/nb2_variants.py`
  (dispersion-trend / outlier-replacement variants), `analysis/run_analysis.py` (driver), `analysis/make_report.py`.
* `results/per_tissue_counts.csv`, `results/agreement_literal_GLM_vs_workbook.csv`,
  `results/sensitivity_variants.csv` (+ `_long`), `results/workbook_literal_hits_<tissue>.csv`,
  `results/all_literal_GLM_hits.csv`, `results/passing_workbook_only.csv`, `results/passing_GLM_only.csv`,
  `results/statsmodels_validation_subset.csv`, `results/discrepancy_scale_factor.csv`, `results/summary.json`,
  per-tissue GLM statistic arrays `results/glm_<tissue>_<stat>.npy`.
"""
open(f"{OUT}/report.md", "w").write(rep)
print(rep[:1500])
print("...\nreport bytes:", len(rep))
