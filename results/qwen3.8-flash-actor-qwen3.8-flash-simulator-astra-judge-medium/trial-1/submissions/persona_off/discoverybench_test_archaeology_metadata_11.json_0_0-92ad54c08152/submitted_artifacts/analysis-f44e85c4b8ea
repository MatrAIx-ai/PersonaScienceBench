"""Main analysis: simultaneous PotteryForm COLLAPSE and PotteryDecoration INCREASE.

Primary unit = the 37 exact 100-yr Z anchors (CE -4100..-500) of time_series_data.csv, cross-checked
against capital.csv (ZKeform / Zkeverz after CE = -BCE). Every timing claim is anchored to a printed
anchor table; `_inter` is used ONLY in the smoothing sensitivity check, never for crossing years.
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 250)

def century_bce(y):
    """Strict convention: the nth century BCE = years 100n .. 100(n-1)+1 BCE (1700 BCE -> 17th c. BCE)."""
    return (y - 1)//100 + 1

ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=','); cap['CE'] = -cap.BCE
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0, decimal=',')

A = ts[ts.PotteryForm.notna()][['CE','calBP','PotteryForm','PotteryDecoration']].copy()
A['BCE'] = -A.CE
chk = A.merge(cap.rename(columns={'ZKeform':'cap_Form','Zkeverz':'cap_Dec'})[['CE','cap_Form','cap_Dec']], on='CE', how='left')
print("== capital cross-check: every anchor identical to ZKeform/Zkeverz =",
      bool((np.isclose(chk.cap_Form, chk.PotteryForm) & np.isclose(chk.cap_Dec, chk.PotteryDecoration)).all()),
      "| capital BCE rows with no ts anchor:", cap.loc[~cap.CE.isin(ts.CE), 'BCE'].tolist(), "==")
A['dForm'] = A.PotteryForm.diff().round(2); A['dDec'] = A.PotteryDecoration.diff().round(2)

F, D = A.PotteryForm, A.PotteryDecoration
mu_F, sd_F, mu_D, sd_D = F.mean(), F.std(), D.mean(), D.std()
thr_F, p20_F, p80_D = mu_F - sd_F, F.quantile(.20), D.quantile(.80)
print(f"\nForm: mean {mu_F:.3f}  sd {sd_F:.3f}  mean-1SD {thr_F:.3f}  p20 {p20_F:.3f}  min {F.min():.2f}")
print(f"Deco: mean {mu_D:.3f}  sd {sd_D:.3f}  median {D.median():.3f}  p80 {p80_D:.3f}  mean+1SD {mu_D+sd_D:.3f}")

def runs(mask, years, min_len=3):
    """contiguous runs of >= min_len True values, returned as (older BCE, younger BCE, n_bins)"""
    out=[]; i=0
    while i < len(mask):
        if mask.iloc[i]:
            j=i
            while j+1 < len(mask) and mask.iloc[j+1]: j+=1
            if (j-i+1) >= min_len: out.append((int(years[i]), int(years[j]), j-i+1))
            i=j+1
        else: i+=1
    return out

# ---------------- FORM: level and rate criteria ----------------
level_F = F <= thr_F
F_runs  = runs(level_F, A.BCE.values)
print("\n== FORM LEVEL criterion (PotteryForm <= mean-1SD = %.2f; identical set to <= p20, the series floor -1.13) ==" % thr_F)
print("   sustained runs (>=3 bins):", F_runs)
print("   ALL sub-threshold runs incl. those too short:", runs(level_F, A.BCE.values, min_len=1))
rate_F = A.dForm <= -sd_F
print("== FORM RATE criterion (one-bin dForm <= -1SD = -%.2f) ==" % sd_F, A.loc[rate_F,'BCE'].tolist())

# ---------------- DECO: four variants ----------------
pre3  = D.rolling(3).mean().shift(1)    # mean of the 3 bins strictly before t
post3 = D.rolling(3).mean().shift(-2)   # mean of bins t, t+1, t+2
V = {'V1 Deco > mean'      : D > mu_D,
     'V2 Deco >= p80'      : D >= p80_D,
     'V3 Deco >= mean+1SD' : D >= mu_D + sd_D}
cand = [(i, int(A.BCE.iloc[i]), pre3.iloc[i], post3.iloc[i]) for i in range(len(A))
        if pd.notna(pre3.iloc[i]) and pd.notna(post3.iloc[i]) and pre3.iloc[i] <= 0.05
        and post3.iloc[i] >= 0.30 and A.dDec.iloc[i] > 0]
print("\n== V4 DIRECTIONAL candidates (pre3 mean <= 0.05, post3 mean >= 0.30, positive step at t) ==")
V4 = pd.Series(False, index=A.index)
for it,b,p,q in cand:
    seg = D.iloc[it:it+3]     # positional: bins t, t+1, t+2
    keep = len(seg) == 3 and (seg > 0).all()
    print(f"   into {b} BCE: pre3 {p:+.2f} -> post3 {q:+.2f} (delta {q-p:+.2f})  "
          f"{'KEPT' if keep else 'REJECTED (post-window not wholly positive: %s)'%seg.tolist()}")
    if keep: V4.iloc[it:it+3] = True
V['V4 directional'] = V4
D_runs = {k: runs(v, A.BCE.values) for k,v in V.items()}
print("\n== DECORATION variant runs side by side (>=3 consecutive bins) ==")
for k in D_runs: print(f"   {k:20s}: {D_runs[k] if D_runs[k] else 'NONE'}")

# ---------------- printed anchor table ----------------
A['flag_Form'] = np.where(level_F,'COLLAPSE','-') + '|' + np.where(rate_F,'RATE-DROP','-')
A['flag_Dec']  = ['/'.join(k.split()[0] for k,v in V.items() if bool(v.iloc[i])) or '-' for i in range(len(A))]
print("\n== ANCHOR TABLE (all 37 bins; BCE = -CE; deltas = 100-yr change in Z) ==")
print(A[['BCE','calBP','PotteryForm','dForm','PotteryDecoration','dDec','flag_Form','flag_Dec']].to_string(index=False))
print("\n== NEIGHBOURHOOD 1900-1400 BCE (simultaneity visible, not inferred) ==")
print(A.loc[(A.BCE>=1400)&(A.BCE<=1900), ['BCE','PotteryForm','dForm','PotteryDecoration','dDec','flag_Form','flag_Dec']].to_string(index=False))
ex = A[A.BCE.isin([4100,4000,3900])].reset_index(drop=True)
print("\n== 4000 BCE deco rise (%+.2f) EXCLUDED ON THE RECORD: Form RISES (%+.2f) in the same bin, so no collapse =="
      % (ex.iloc[1].dDec, ex.iloc[1].dForm))
print(ex[['BCE','PotteryForm','dForm','PotteryDecoration','dDec']].to_string(index=False))

# ---------------- overlaps ----------------
def overlap(fr, dr):
    """BCE intervals (older=larger, younger=smaller); intersection = [min(older), max(younger)]"""
    out=[]
    for fs,fe,_ in fr:
        for ds,de,_ in dr:
            old, you = min(fs,ds), max(fe,de)
            if old >= you: out.append((old, you, old-you))
    return out
print("\n== OVERLAP: FORM level-collapse x each DECORATION variant (>=1 shared bin) ==")
for k in D_runs:
    ov = overlap(F_runs, D_runs[k])
    txt = 'NONE' if not ov else ', '.join(f"{o}-{y} BCE ({s} yr) -> onset {o} BCE = strict {century_bce(o)}th c. BCE"
                                          f" (CE {-o}); common usage 'the {(o//100)*100}s BCE'" for o,y,s in ov)
    print(f"   {k:20s}: {txt}")
print("   V3 note: under >= mean+1SD the overlap starts one century later in LEVEL terms (1000 BCE onset bin),"
      " but the qualifying CHANGE bin is still 1700 BCE (dDec +1.45); 1000 BCE is a secondary step (+0.56).")
rate_both = rate_F & (A.dDec >= sd_D)
print("== RATE x RATE (same-bin dForm <= -1SD AND dDec >= +1SD = %.2f) ==" % sd_D,
      A.loc[rate_both,'BCE'].tolist(), "-> strict", "%sth c. BCE"%century_bce(1700))

print("\n== CENTURY CONVERSION / TRUNCATION ==")
for y in [1800,1701,1700,1699,1601,1600,1000,500]:
    print(f"   {y} BCE -> strict {century_bce(y)}th c. BCE ({century_bce(y)*100}-{(century_bce(y)-1)*100+1} BCE), CE {-y}")
print("   1700 BCE is the FIRST year of the strict 17th c. BCE (the 18th c. BCE ends 1701 BCE);")
print("   common usage calls 1700-1600 BCE 'the 1700s BCE' / '17th century BCE' -> both labelings point to the same bin.")
print("   The overlap 1700-500 BCE is RIGHT-TRUNCATED by the dataset's last anchor (500 BCE), not by the data.")

# ---------------- sensitivity ----------------
smF, smD = F.rolling(3, center=True).mean(), D.rolling(3, center=True).mean()
print("\n== SENSITIVITY ==")
print("   3-bin (300 yr) centred MA, Form collapse runs:", runs(smF <= smF.mean()-smF.std(), A.BCE.values))
print("   3-bin (300 yr) centred MA, Deco runs (> smoothed mean):", runs(smD > smD.mean(), A.BCE.values))
r = ts.PotteryForm_inter.rolling(101, center=True).mean()
sm_ov = overlap(runs(smF <= smF.mean()-smF.std(), A.BCE.values), runs(smD > smD.mean(), A.BCE.values))
print("   smoothed (300 yr MA) overlap:", [(f"{o}-{y} BCE", f"onset strict {century_bce(o)}th c. BCE") for o,y,_ in sm_ov],
      "<- centred MA smears the step by ~1 bin (1600 BCE); reported as sensitivity, not as the answer")
print("   101-yr rolling mean of _inter (annual-grid artefact, NOT used for claims):",
      runs((r <= r.mean()-r.std()) & ts.PotteryForm_inter.notna(), (-ts.CE).values))
print("   min-duration sensitivity, Form runs:",
      {f">={n} bins": runs(level_F, A.BCE.values, min_len=n) for n in (1,2,3,5)})

# ---------------- pollen context ----------------
pre_p, post_p = pol[(pol.CE>=-2100)&(pol.CE<-1700)], pol[(pol.CE>=-1700)&(pol.CE<=-500)]
g = ts.loc[(ts.CE>=-1700)&(ts.CE<=-500),'pollen_grate_100'].mean()
print("\n== POLLEN / OPENNESS CONTEXT (descriptive only; not used in detection) ==")
print(f"   openness MEAN {pre_p.MEAN.mean():.2f} (2100-1701 BCE) -> {post_p.MEAN.mean():.2f} (1700-500 BCE); "
      f"Belau_PC1_inter {pre_p.Belau_PC1_inter.mean():.2f} -> {post_p.Belau_PC1_inter.mean():.2f}")
print(f"   pollen_grate_100 mean over 1700-500 BCE = {g:+.5f} -> {g>0 and 'positive' or 'negative'} 100-yr growth rate")
print("\n== HEADLINE ==")
print("   Qualifying simultaneous event bin: 1700 BCE (CE -1700, calBP 3650):")
print("     PotteryForm 0.74 -> -1.13 (dZ -1.87 = -1.9 SD; series floor, sustained 13 bins to 500 BCE)")
print("     PotteryDecoration -0.48 -> +0.97 (dZ +1.45 = +1.6 SD; above mean & p80, sustained 13 bins)")
print("   Level criterion overlap 1700-500 BCE and rate criterion bin 1700 BCE select the SAME century:")
print("     strict convention  -> 17th century BCE (1700-1601 BCE), CE -1700..-1601")
print("     common usage       -> 'the 1700s BCE' / 17th century BCE (18th c. BCE strictly ends 1701 BCE)")
print("   Only V3 (Deco >= mean+1SD = 1.02) shifts the LEVEL overlap to 1000-500 BCE (10th c. BCE);")
print("   the 1700 BCE bin is still the bin where both series change, so it is reported as a caveat, not the answer.")
print("\n== CONTEXT from capital.csv 'group' column (metadata, dropped in the original pipeline) ==")
g = cap.loc[cap.BCE.isin([1900,1800,1700,1600,1000,900]), ['BCE','group']]
print(g.to_string(index=False))
A.to_csv('anchor_table.csv', index=False); print("\nwrote anchor_table.csv")
