"""Stage-0 data inspection for the pottery 'collapse vs increase' question.
Reads only the three staged CSVs; prints structural / coverage diagnostics. No event testing."""
import pandas as pd, numpy as np
from itertools import groupby

TS='data/time_series_data.csv'; CAP='data/capital.csv'; POL='data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'
ts=pd.read_csv(TS,index_col=0)
cap=pd.read_csv(CAP,decimal=',')
pol=pd.read_csv(POL,index_col=0,decimal=',')

print("== shapes ==")
print("time_series",ts.shape,"capital",cap.shape,"pollen",pol.shape)
print("\n== time_series time axis ==")
print("CE",ts.CE.min(),"..",ts.CE.max(),"annual step:",set(np.diff(ts.CE.values)),
      "| calBP == 1950-CE:",bool(((ts.calBP+ts.CE)==1950).all()))
print("\n== raw Z anchors (all *_inter pairs) ==")
rows=[]
for i in [c for c in ts.columns if c.endswith('_inter') and c[:-6] in ts.columns]:
    r=i[:-6]; ce=ts.CE[ts[r].notna()].values
    rows.append((r,len(ce),ce.min(),ce.max(),sorted(set(np.diff(ce))),ts[i].notna().sum(),ts[i].nunique()))
print(pd.DataFrame(rows,columns=['raw','n_anchors','firstCE','lastCE','anchor_gaps(yr)','n_inter','unique_inter']).to_string())
print("\n== pottery Z summary (raw anchors) ==")
print(ts[['PotteryForm','PotteryDecoration']].describe().T.to_string())
print("\n== interpolation is exactly linear between anchors ==")
for col in ['PotteryForm','PotteryDecoration']:
    i=col+'_inter'; a=ts[ts[col].notna()]; dev=0.0
    for k in range(len(a)-1):
        c0,v0,c1,v1=a.CE.iloc[k],a[i].iloc[k],a.CE.iloc[k+1],a[i].iloc[k+1]
        m=(ts.CE>c0)&(ts.CE<c1)
        dev=max(dev,np.abs(ts.loc[m,i].values-np.linspace(v0,v1,c1-c0+1)[1:-1]).max())
    d=np.diff(ts[i].values)
    print(col,"max linear-interp dev",round(dev,15),"| flat years",int((d==0).sum()),"/",len(d),
          "| longest flat run",max(len(list(g)) for _,g in groupby((d==0).tolist())),"yr")
print("\n== capital.csv <-> time_series alignment (CE = -BCE) ==")
cap['CE']=-cap.BCE
m=cap.merge(ts[['CE','PotteryForm','PotteryDecoration']],on='CE',how='left')
print("matched",int(m.PotteryForm.notna().sum()),"of",len(m),"| capital-only BCE",m.loc[m.PotteryForm.isna(),'BCE'].tolist(),
      "| max|ZKeform-PotteryForm|",np.nanmax(np.abs(m.ZKeform-m.PotteryForm)),
      "| max|Zkeverz-PotteryDecoration|",np.nanmax(np.abs(m.Zkeverz-m.PotteryDecoration)))
print("\n== raw pottery anchor trajectory (37 x 100-yr bins) ==")
a=ts[ts.PotteryForm.notna()][['CE','calBP','PotteryForm','PotteryDecoration']].copy(); a['BCE']=-a.CE
print(a.to_string())
print("\n== pollen / openness frame (contextual only) ==")
print("CE",pol.CE.min(),"..",pol.CE.max(),"| non-null:",dict(pol.notna().sum()))
for c in ['Belau_PC1','Woserin_PC1']:
    ce=pol.index[pol[c].notna()].sort_values(); g=-np.diff(ce.values)
    print(c,"n",len(ce),"median gap",np.median(g),"yr max gap",g.max(),"yr")
ce=ts.CE[ts.pollen.notna()].values
print("ts.pollen anchors n",len(ce),"max gap",np.diff(ce).max(),"yr; pollen_inter coverage",ts.pollen_inter.notna().sum(),"/",len(ts))
