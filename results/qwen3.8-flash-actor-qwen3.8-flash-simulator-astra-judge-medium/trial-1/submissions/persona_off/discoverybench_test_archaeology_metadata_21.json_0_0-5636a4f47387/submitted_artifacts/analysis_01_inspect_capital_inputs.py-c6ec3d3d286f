"""Stage 1: inspection only (NO PCA).
Facts needed before any PCA on 'forms of capital' in 100-year slices.
Run:  python3 analysis/01_inspect_capital_inputs.py
"""
import pandas as pd, numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 60)

TS, CAP, POL = ('data/time_series_data.csv', 'data/capital.csv',
                'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')

# capital.csv and the pollen file use COMMA decimal separators -> decimal=','
cap = pd.read_csv(CAP, decimal=',')
ts  = pd.read_csv(TS)
pol = pd.read_csv(POL, decimal=',')

print("== 1. SHAPES / DTYPES ==")
print("capital.csv", cap.shape);      print(cap.dtypes.to_string())
print("time_series_data.csv", ts.shape, "| dtypes:", dict(ts.dtypes.astype(str).value_counts()))
print("pollen file", pol.shape, "| dtypes:", dict(pol.dtypes.astype(str).value_counts()))
print("capital columns:", list(cap.columns))
print("time_series columns:", list(ts.columns))

print("\n== 2. TIME COVERAGE / SPACING ==")
print("capital BCE:", cap['BCE'].min(), "->", cap['BCE'].max(), "| n =", len(cap),
      "| spacing =", sorted(np.unique(np.abs(np.diff(np.sort(cap['BCE']))))))
print("capital calBP (1950-CE) :", 1950+cap['BCE'].max(), "->", 1950+cap['BCE'].min())
print("time_series CE:", ts['CE'].min(), "->", ts['CE'].max(), "| calBP:", ts['calBP'].min(),
      "->", ts['calBP'].max(), "| CE step =", np.unique(np.diff(ts['CE'])))
print("pollen CE:", pol['CE'].min(), "->", pol['CE'].max(), "| calBP:", pol['calBP'].min(),
      "->", pol['calBP'].max(), "| CE step =", np.unique(np.diff(pol['CE'])))
print("group->period map:\n", cap.groupby('group')['BCE'].agg(['min','max','count']).to_string())

ZC = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort','ZSichel',
      'ZBeil','ZMW','ZKeform','Zkeverz']
BASE = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount','Depot',
        'Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
PAIR = list(zip(ZC, BASE))

print("\n== 3. MISSING VALUES ==")
print("capital.csv:\n", cap.isna().sum().to_string())
print("time_series raw Z cols (missing of", len(ts), "annual rows):")
print(ts[BASE].isna().sum().to_string())
print("anchors (non-null raw Z) are at CE multiples of 100:",
      set(ts.loc[ts['HatchetSword'].notna(),'CE'] % 100) == {0},
      "| n anchors =", int(ts['HatchetSword'].notna().sum()))
print("pollen raw Belau_PC1 missing:", int(pol['Belau_PC1'].isna().sum()), "of", len(pol),
      "| Woserin:", int(pol['Woserin_PC1'].isna().sum()))

print("\n== 4. ARE group / color really droppable? ==")
print("group nunique/color nunique:", cap['group'].nunique(), cap['color'].nunique(),
      "| any missing:", int(cap[['group','color']].isna().sum().sum()))
print("color is a 1:1 label of group:",
      cap.groupby('group')['color'].nunique().eq(1).all())

print("\n== 5. RECONCILIATION capital.csv  vs  *_inter ==")
cap['CE'] = -cap['BCE']
m = ts.merge(cap, on='CE')
print("shared time points:", len(m), "of", len(cap),
      "| capital slices absent from annual grid:", sorted(set(cap['CE']) - set(ts['CE'])))
rec = []
for a, b in PAIR:
    rec.append([a, b, np.nanmax(np.abs(m[a]-m[b])), np.nanmax(np.abs(m[a]-m[b+'_inter'])),
                int(np.isclose(m[a], m[b+'_inter'], atol=1e-12).sum())])
print(pd.DataFrame(rec, columns=['capital_col','ts_base','max|cap-raw|','max|cap-inter|','n_exact/37']).to_string(index=False))
grid = np.arange(-4100, -499)
lin_err = {}
for a, b in PAIR:
    g = ts.dropna(subset=[b])[['CE', b]].reset_index(drop=True)
    lin_err[b] = float(np.nanmax(np.abs(np.interp(grid, g['CE'], g[b]) -
                                        ts.set_index('CE')[b+'_inter'].reindex(grid).values)))
print("_inter == pure linear interpolation of the 37 anchors? max err per var:",
      {k: round(v, 12) for k, v in lin_err.items()})

print("\n== 6. ARE THE CAPITAL VARIABLES ALREADY STANDARDISED Z? (n=39 slices) ==")
d = pd.DataFrame({'mean': cap[ZC].mean(), 'sd_n39': cap[ZC].std(ddof=1),
                  'min': cap[ZC].min(), 'max': cap[ZC].max(),
                  'n_unique': cap[ZC].nunique(),
                  'n_values_not_2dp': [(~np.isclose(cap[c].round(2), cap[c])).sum() for c in ZC]})
print(d.round(4).to_string())
print("SD over annual interpolated grid (3601 rows) for comparison:")
print(pd.DataFrame({'sd_inter': ts[[b+'_inter' for b in BASE]].std(ddof=1).values,
                    'mean_inter': ts[[b+'_inter' for b in BASE]].mean().values},
                   index=BASE).round(4).to_string())

print("\n== 7. POLLEN OVERLAP / GAPS vs CAPITAL SLICES ==")
b_ce = pol.loc[pol['Belau_PC1'].notna(), 'CE'].values
w_ce = pol.loc[pol['Woserin_PC1'].notna(), 'CE'].values
print("Belau raw records n =", len(b_ce), "| CE", b_ce.min(), "->", b_ce.max(),
      "| max interior gap (yr) =", int(np.diff(b_ce).max()), "| median gap =", float(np.median(np.diff(b_ce))))
print("Woserin raw records n =", len(w_ce), "| CE", w_ce.min(), "->", w_ce.max(),
      "| max gap =", int(np.diff(w_ce).max()))
s = ts.set_index('CE')['pollen_inter']
print("ts.pollen_inter_100 == CENTERED 100-yr rolling mean of pollen_inter:",
      float(np.nanmax(np.abs(s.rolling(100, center=True, min_periods=1).mean().values -
                             ts['pollen_inter_100'].values))) < 1e-12)
sp = pol.set_index('CE')['MEAN'].sort_index()
chk = pol.set_index('CE')['SMOOTH_MEAN_100y'].sort_index()
print("pollen-file SMOOTH_MEAN_100y vs centered roll of MEAN max|diff| =",
      round(float(np.nanmax(np.abs(sp.rolling(100, center=True, min_periods=1).mean()-chk))), 6))
zero_belau = [ce for ce in sorted(cap['CE']) if ((b_ce > ce-100) & (b_ce <= ce)).sum() == 0]
zero_wos   = [ce for ce in sorted(cap['CE']) if ((w_ce > ce-100) & (w_ce <= ce)).sum() == 0]
inside = cap[(cap['CE'] >= pol['CE'].min()) & (cap['CE'] <= pol['CE'].max())]
print("capital slices inside pollen span:", len(inside), "of", len(cap),
      "| outside:", sorted(set(cap['CE']) - set(range(int(pol['CE'].min()), int(pol['CE'].max())+1))))
print("capital slices with 0 raw Belau obs in their 100-yr window:", zero_belau)
print("capital slices with 0 raw Woserin obs in their 100-yr window:", zero_wos)
mg = ts.merge(pol[['CE','Belau_PC1','Belau_PC1_inter']], on='CE')
dd = (mg['pollen']-mg['Belau_PC1']).abs()
print("ts.pollen == Belau_PC1 on shared raw points:",
      len(mg[dd.notna()]), "points, max|diff| =", float(dd.max()))
d2 = (mg['pollen_inter']-mg['Belau_PC1_inter']).abs()
print("ts.pollen_inter vs Belau_PC1_inter: max|diff| =", round(float(d2.max()), 6),
      "| n differing =", int((d2 > 1e-9).sum()), "| CE range of differences =",
      int(mg.loc[d2 > 1e-9,'CE'].min()), "->", int(mg.loc[d2 > 1e-9,'CE'].max()))
print("\nDONE - no PCA computed at this stage.")
