"""Sign-invariant cross-run comparison, block-bootstrap stability, PC2 spread metrics."""
import numpy as np, pandas as pd
pd.set_option('display.width', 260); pd.set_option('display.max_columns', 60)
rng = np.random.default_rng(20261022)

ZC = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZKeform','Zkeverz',
      'ZHort','ZSichel','ZBeil','ZMW']
GROUP = {**{v:'symbolic' for v in ZC[:3]}, **{v:'social' for v in ZC[3:6]},
         **{v:'cultural' for v in ZC[6:8]}, **{v:'economic' for v in ZC[8:]}}
SYM, ECO = ZC[:3], ZC[8:]
_c = pd.read_csv('data/capital.csv', decimal=','); _c['CE'] = -_c['BCE']
cap = _c.set_index('CE').loc[:, ZC].sort_index()

def pca_run(df, matrix='corr'):
    X = df.copy()
    if matrix == 'corr':
        X = (X - X.mean()) / X.std(ddof=1)
    C = np.cov(X.values, rowvar=False, ddof=1)
    ev, V = np.linalg.eigh(C); o = np.argsort(ev)[::-1]
    return ev[o], V[:, o]

def oriented(df, matrix='corr'):
    ev, V = pca_run(df, matrix)
    Vo = V.copy(); who = []
    for j in range(V.shape[1]):
        amax = np.abs(Vo[:, j]).max()
        i = next(k for k in range(len(ZC)) if np.isclose(abs(Vo[k, j]), amax, atol=1e-12))
        if Vo[i, j] < 0: Vo[:, j] = -Vo[:, j]
        who.append(ZC[i])
    return ev, Vo, who

ev39, L39, w39 = oriented(cap, 'corr')
ev37, L37, w37 = oriented(cap.loc[cap.index >= -4100], 'corr')
evc,  Lc,  wc  = oriented(cap, 'cov')

print("== RAW (unoriented) PC1/PC2 are stable; ORIENTED ones are not comparable across runs ==")
for a, b, na, nb in [(L39[:,0], L37[:,0], 'corr39', 'corr37'),
                     (L39[:,0], Lc[:,0], 'corr39', 'cov39'),
                     (L39[:,1], L37[:,1], 'corr39/PC2', 'corr37/PC2'),
                     (L39[:,1], Lc[:,1], 'corr39/PC2', 'cov39/PC2')]:
    r = np.corrcoef(a, b)[0, 1]
    print(f"  {na} vs {nb}: r(loading vector) = {r:+.4f}  ->  same axis"
          f"{' (ORIENTATION FLIPPED by the convention)' if r < 0 else ' (orientation agrees)'},"
          f" |cos| = {abs(r):.4f}")

print("\n== PC2 EXPLAINED-SPREAD BY GROUP (share of the PC2 eigenvector's variance) ==")
for tag, L in [('corr39', L39), ('corr37', L37), ('cov39', Lc)]:
    for g in ['symbolic','social','cultural','economic']:
        idx = [ZC.index(v) for v in ZC if GROUP[v] == g]
        for pc, nm in [(0,'PC1'), (1,'PC2')]:
            pass
    row = {}
    for g in ['symbolic','social','cultural','economic']:
        idx = [ZC.index(v) for v in ZC if GROUP[v] == g]
        row[f'{g}_n'] = len(idx)
        row[f'{g}_PC2_sumsq%'] = 100 * (L[idx, 1]**2).sum() / (L[:, 1]**2).sum()
        row[f'{g}_PC1_sumsq%'] = 100 * (L[idx, 0]**2).sum() / (L[:, 0]**2).sum()
        row[f'{g}_PC2_sdsign'] = L[idx, 1].std(ddof=1) / len(idx)**0.5
    print(f"\n{tag} (n slices per group: SYM 3, SOC 3, CUL 2, ECO 4)")
    print(pd.Series(row).round(4).to_string())

print("\n== CIRCULAR BLOCK BOOTSTRAP over slices (block = 5 centuries, B = 2000) ==")
X = ((cap - cap.mean()) / cap.std(ddof=1)).values
n, p = X.shape; B, blk = 2000, 5
boot = np.zeros((B, p, 2))
for b in range(B):
    starts = rng.integers(0, n, size=int(np.ceil(n / blk)))
    ii = np.concatenate([(np.arange(s, s + blk) % n) for s in starts])[:n]
    Z = X[ii]
    C = np.cov(Z, rowvar=False, ddof=1)
    ev, V = np.linalg.eigh(C); o = np.argsort(ev)[::-1]; V = V[:, o][:, :2]
    for j in range(2):
        if abs(V[:, j]).argmax() >= 0 and V[int(np.abs(V[:, j]).argmax()), j] < 0: V[:, j] = -V[:, j]
        # align to the observed oriented vector to avoid sign noise dominating
        if np.dot(V[:, j], L39[:, j]) < 0: V[:, j] = -V[:, j]
    boot[b] = V
res = []
for k, v in enumerate(ZC):
    a, b2 = boot[:, k, 0], boot[:, k, 1]
    res.append([v, GROUP[v], L39[k, 0], np.percentile(a, 2.5), np.percentile(a, 97.5),
                (a > 0).mean(), L39[k, 1], np.percentile(b2, 2.5), np.percentile(b2, 97.5),
                (b2 > 0).mean()])
bt = pd.DataFrame(res, columns=['var','group','PC1','PC1_lo95','PC1_hi95','P(PC1>0)',
                                'PC2','PC2_lo95','PC2_hi95','P(PC2>0)'])
print(bt.round(3).to_string(index=False))
print("\nSymbolic PC2 range in bootstrap: median %.3f  [%.3f, %.3f] | economic: median %.3f [%.3f, %.3f]" % (
    np.median([np.ptp(boot[:, [0,1,2], 1], axis=1)]), *np.percentile([np.ptp(boot[:, [0,1,2], 1], axis=1)],[2.5,97.5]),
    np.median([np.ptp(boot[:, [8,9,10,11], 1], axis=1)]), *np.percentile([np.ptp(boot[:, [8,9,10,11], 1], axis=1)],[2.5,97.5])))
print("P(all three symbolic share PC2 sign) = %.3f | P(all three share PC1 sign) = %.3f" % (
    ((boot[:, [0,1,2], 1] > 0).all(axis=1) | (boot[:, [0,1,2], 1] < 0).all(axis=1)).mean(),
    ((boot[:, [0,1,2], 0] > 0).all(axis=1) | (boot[:, [0,1,2], 0] < 0).all(axis=1)).mean()))
ranks_pc1 = np.array([ (np.abs(boot[:, :, 0]) > np.abs(boot[:, [k], 0])).sum(axis=1) + 1 for k in range(3) ])
ranks_pc2 = np.array([ (np.abs(boot[:, :, 1]) > np.abs(boot[:, [k], 1])).sum(axis=1) + 1 for k in range(3) ])
for i, v in enumerate(SYM):
    print(f"  {v}: median |PC1| rank {np.median(ranks_pc1[i]):.1f} [{np.percentile(ranks_pc1[i],2.5):.0f}-{np.percentile(ranks_pc1[i],97.5):.0f}]"
          f" | median |PC2| rank {np.median(ranks_pc2[i]):.1f} [{np.percentile(ranks_pc2[i],2.5):.0f}-{np.percentile(ranks_pc2[i],97.5):.0f}]")
bt.round(4).to_csv('analysis/bootstrap_loadings.csv', index=False)

