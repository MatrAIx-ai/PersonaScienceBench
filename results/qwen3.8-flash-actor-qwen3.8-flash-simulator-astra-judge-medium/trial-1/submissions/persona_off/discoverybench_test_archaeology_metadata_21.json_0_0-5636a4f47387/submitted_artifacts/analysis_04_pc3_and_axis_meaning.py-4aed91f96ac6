"""What do the axes actually contrast? PC3 check for the symbolic trio."""
import numpy as np, pandas as pd
pd.set_option('display.width', 260)
ZC = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZKeform','Zkeverz',
      'ZHort','ZSichel','ZBeil','ZMW']
GROUP = {**{v:'symbolic' for v in ZC[:3]}, **{v:'social' for v in ZC[3:6]},
         **{v:'cultural' for v in ZC[6:8]}, **{v:'economic' for v in ZC[8:]}}
_c = pd.read_csv('data/capital.csv', decimal=','); _c['CE'] = -_c['BCE']
raw = _c.set_index('CE').sort_index()
cap = raw.loc[:, ZC]
Z = (cap - cap.mean()) / cap.std(ddof=1)
ev, V = np.linalg.eigh(np.cov(Z.values, rowvar=False, ddof=1)); o = np.argsort(ev)[::-1]
ev, V = ev[o], V[:, o]
def orient(V):
    V = V.copy()
    for j in range(V.shape[1]):
        i = int(np.abs(V[:, j]).argmax())
        if V[i, j] < 0: V[:, j] = -V[:, j]
    return V
V = orient(V)
S = Z.values @ V                                    # PC scores
print("PC3 oriented loadings (|.| sorted):")
print(pd.DataFrame({'PC3': V[:, 2], 'group': [GROUP[c] for c in ZC]}, index=ZC)
        .sort_values('PC3', key=np.abs, ascending=False).round(4).to_string())
print("\nSymbolic trio, all four components:")
print(pd.DataFrame(V[:3, :4], index=ZC[:3], columns=['PC1','PC2','PC3','PC4']).round(4).to_string())
print("\nh2 over PC1-4 for symbolic:", (V[:3, :4]**2).sum(1).round(3))

print("\n== Is PC1 a 'general capital intensity' factor? ==")
gen = Z.values.mean(axis=1)                          # row mean of standardised Z
for j in range(4):
    print(f"  PC{j+1} score vs mean-of-all-standardised-Z: r = {np.corrcoef(S[:, j], gen)[0,1]:+.3f}"
          f" | vs CE (time): r = {np.corrcoef(S[:, j], cap.index.values)[0,1]:+.3f}")
print("\nPC1 / PC2 / PC3 mean scores by archaeological period:")
per = raw['group'].reindex(cap.index)
out = pd.DataFrame({'PC1': S[:, 0], 'PC2': S[:, 1], 'PC3': S[:, 2], 'CE': cap.index.values}).groupby(per.values).agg(
    ['mean', 'count']).round(3)
print(out.to_string())
_ev0, _V0 = np.linalg.eigh(np.cov(Z.values, rowvar=False, ddof=1))
_o = np.argsort(_ev0)[::-1]
print("\nRaw (pre-orientation) PC1 loadings of the trio:", np.round(_V0[:, _o][:3, 0], 4),
      "-> the oriented table is this vector multiplied by -1")
