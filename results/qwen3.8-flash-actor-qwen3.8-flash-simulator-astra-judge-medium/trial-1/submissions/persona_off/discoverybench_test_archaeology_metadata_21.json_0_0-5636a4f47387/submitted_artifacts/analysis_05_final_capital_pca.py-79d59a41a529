"""FINAL DELIVERABLE -- PCA on forms of capital, 100-year slices.

Input  : data/capital.csv (comma decimal separator!), CE = -BCE index,
         12 capital variables, 39 complete 100-yr slices. group/color dropped.
Method : PCA = eigendecomposition of the 12x12 CORRELATION matrix on the 39
         slices (columns re-standardised on those slices). All 12 PCs kept.
Sign convention (fixed BEFORE computing): orient each component so that the
         largest-|loading| variable has a POSITIVE loading (ties -> VARS order).
Sens.  : (A) 37 slices shared with time_series_data.csv; (B) covariance matrix.
Outputs: analysis/capital_pca_summary.txt + CSV tables.
"""
import numpy as np, pandas as pd
pd.set_option('display.width', 260); pd.set_option('display.max_columns', 60)
OUT = []
def say(*a):
    s = " ".join(str(x) for x in a); OUT.append(s); print(s)

VARS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZKeform',
        'Zkeverz','ZHort','ZSichel','ZBeil','ZMW']
GROUP = {**{v:'symbolic' for v in VARS[:3]}, **{v:'social' for v in VARS[3:6]},
         **{v:'cultural' for v in VARS[6:8]}, **{v:'economic' for v in VARS[8:]}}
SYM, ECO, SOC, CUL = VARS[:3], VARS[8:], VARS[3:6], VARS[6:8]

_c = pd.read_csv('data/capital.csv', decimal=',')
_c['CE'] = -_c['BCE']
cap = _c.set_index('CE').sort_index().loc[:, VARS]
say("Matrix:", cap.shape, "| missing:", int(cap.isna().sum().sum()),
    "| CE", cap.index.min(), "->", cap.index.max(), "| step 100 yr")

def effective_n(df):
    rows = []
    for c in df.columns:
        x = df[c].values.astype(float); r1 = np.corrcoef(x[:-1], x[1:])[0, 1]
        rows.append([c, GROUP[c], round(r1, 3), round(len(x)*(1-r1)/(1+r1), 1),
                     1+int((np.diff(x) != 0).sum()), len(np.unique(x))])
    return pd.DataFrame(rows, columns=['var','group','lag1_autocorr','n_eff_AR1','n_runs','n_unique'])

def pca(df, matrix='corr'):
    X = df if matrix == 'cov' else (df - df.mean()) / df.std(ddof=1)
    ev, V = np.linalg.eigh(np.cov(X.values, rowvar=False, ddof=1))
    o = np.argsort(ev)[::-1]; ev, V = ev[o], V[:, o]
    Vo, who = V.copy(), []
    for j in range(V.shape[1]):                      # FIXED SIGN CONVENTION
        i = next(k for k in range(len(VARS)) if np.isclose(abs(Vo[k, j]), np.abs(Vo[:, j]).max(), atol=1e-12))
        if Vo[i, j] < 0: Vo[:, j] = -Vo[:, j]
        who.append((VARS[i], GROUP[VARS[i]], Vo[i, j]))
    return dict(ev=ev, raw=V, L=Vo, R=Vo*np.sqrt(np.clip(ev, 0, None)),
                pve=ev/ev.sum(), who=who, n=len(df))

def table(res):
    t = pd.DataFrame({'group': [GROUP[v] for v in VARS]}, index=VARS)
    t['PC1'] = res['L'][:, 0]; t['PC2'] = res['L'][:, 1]
    t['absPC1'] = np.abs(res['L'][:, 0]); t['absPC2'] = np.abs(res['L'][:, 1])
    t['rankPC1'] = t['absPC1'].rank(ascending=False, method='min').astype(int)
    t['rankPC2'] = t['absPC2'].rank(ascending=False, method='min').astype(int)
    t['PC1_r'] = res['R'][:, 0]; t['PC2_r'] = res['R'][:, 1]
    t['h2_PC1+PC2'] = res['R'][:, 0]**2 + res['R'][:, 1]**2
    t['h2_PC1+PC2+PC3'] = (res['R'][:, :3]**2).sum(1)
    return t

def full(tag, res, t):
    say("\n" + "="*104 + f"\n### {tag} (n={res['n']} slices, p=12)")
    e = res['ev']
    say(pd.DataFrame({'eigenvalue': e, 'PVE%': 100*res['pve'],
                      'cumPVE%': 100*np.cumsum(res['pve'])},
                     index=[f'PC{i+1}' for i in range(12)]).head(5).round(3).to_string())
    say(f"PC1 = {100*res['pve'][0]:.1f}% | PC2 = {100*res['pve'][1]:.1f}% | "
        f"PC1+PC2 = {100*res['pve'][:2].sum():.1f}% of total variance")
    say("Orientation (largest |loading| forced positive): " + "; ".join(
        f"PC{j+1}: {v} ({g}, {l:+.4f})" for j, (v, g, l) in enumerate(res['who'][:3])))
    say("\n" + pd.concat([pd.DataFrame(res['raw'][:, :2], columns=['PC1_raw','PC2_raw'], index=VARS),
                          pd.DataFrame(res['L'][:, :2], columns=['PC1_oriented','PC2_oriented'], index=VARS)],
                         axis=1).round(4).to_string())
    say("\n" + t.round(4).to_string())
    for pc in ['PC1', 'PC2']:
        sp = t.groupby('group')[pc].agg(min='min', max='max', range=lambda s: s.max()-s.min(),
                                        same_side=lambda s: bool((s > 0).all() or (s < 0).all()))
        say(f"\n{pc} spread by group:\n" + sp.round(4).to_string())
    say(f"\nSymbolic trio: PC1 range {t.loc[SYM,'PC1'].max()-t.loc[SYM,'PC1'].min():.4f} "
        f"vs economic {t.loc[ECO,'PC1'].max()-t.loc[ECO,'PC1'].min():.4f}; "
        f"PC2 range symbolic {t.loc[SYM,'PC2'].max()-t.loc[SYM,'PC2'].min():.4f} "
        f"vs economic {t.loc[ECO,'PC2'].max()-t.loc[ECO,'PC2'].min():.4f}, "
        f"social {t.loc[SOC,'PC2'].max()-t.loc[SOC,'PC2'].min():.4f}, "
        f"cultural {t.loc[CUL,'PC2'].max()-t.loc[CUL,'PC2'].min():.4f}")
    share = {g: 100*(res['L'][[VARS.index(v) for v in vs], 1]**2).sum()/(res['L'][:, 1]**2).sum()
             for g, vs in [('symbolic', SYM), ('social', SOC), ('cultural', CUL), ('economic', ECO)]}
    say("Share of PC2 eigenvector sum-of-squares: " + ", ".join(
        f"{g} {share[g]:.1f}% (uniform expectation {100*len(vs)/12:.1f}%)"
        for (g, vs) in [('symbolic', SYM), ('social', SOC), ('cultural', CUL), ('economic', ECO)]))
    return t

say("\n### EFFECTIVE-n DIAGNOSTICS (stepped / forward-filled series) -- caveat next to eigenvalues")
en = effective_n(cap); say(en.to_string(index=False))
say(f"median AR(1) n_eff = {en.n_eff_AR1.median():.1f} vs nominal n = 39")

main = pca(cap, 'corr'); tm = full("MAIN: 39 slices, CORRELATION matrix", main, table(main))
sA  = pca(cap.loc[cap.index >= -4100], 'corr'); tA = full("SENS A: 37 slices shared with time_series_data.csv, CORRELATION", sA, table(sA))
sB  = pca(cap, 'cov'); tB = full("SENS B: 39 slices, COVARIANCE matrix (no re-standardisation)", sB, table(sB))

say("\n" + "="*104 + "\n### SIGN-INVARIANT CROSS-RUN COMPARISON (r on the 12 loading values)")
for lbl, a, b in [('PC1 corr39 vs corr37', tm['PC1'], tA['PC1']),
                  ('PC1 corr39 vs cov39',  tm['PC1'], tB['PC1']),
                  ('PC2 corr39 vs corr37', tm['PC2'], tA['PC2']),
                  ('PC2 corr39 vs cov39',  tm['PC2'], tB['PC2'])]:
    r = np.corrcoef(a, b)[0, 1]
    say(f"  {lbl}: r = {r:+.4f}  ->  {'SAME axis' if abs(r) > .95 else 'axis re-ordered'}"
        f"{', orientation convention FLIPPED the sign' if r < 0 else ''}")

say("\n### SYMBOLIC TRIO ACROSS ALL THREE RUNS")
rows = []
for tag, t in [('corr_39 (main)', tm), ('corr_37 (sens A)', tA), ('cov_39 (sens B)', tB)]:
    for v in SYM:
        rows.append([tag, v, t.loc[v,'PC1'], t.loc[v,'rankPC1'], t.loc[v,'PC2'],
                     t.loc[v,'rankPC2'], t.loc[v,'h2_PC1+PC2']])
say(pd.DataFrame(rows, columns=['run','var','PC1','rankPC1','PC2','rankPC2','h2_PC1+PC2']).round(4).to_string(index=False))
say("\nSign-agreement of the trio on PC1: main " + str(bool((tm.loc[SYM,'PC1']>0).all() or (tm.loc[SYM,'PC1']<0).all()))
    + " | sensA " + str(bool((tA.loc[SYM,'PC1']>0).all() or (tA.loc[SYM,'PC1']<0).all()))
    + " | sensB " + str(bool((tB.loc[SYM,'PC1']>0).all() or (tB.loc[SYM,'PC1']<0).all())))
say("Sign-agreement of the trio on PC2: main " + str(bool((tm.loc[SYM,'PC2']>0).all() or (tm.loc[SYM,'PC2']<0).all()))
    + " | sensA " + str(bool((tA.loc[SYM,'PC2']>0).all() or (tA.loc[SYM,'PC2']<0).all()))
    + " | sensB " + str(bool((tB.loc[SYM,'PC2']>0).all() or (tB.loc[SYM,'PC2']<0).all())))
say("Pairwise |PC1| rank of the trio (sorted by |PC1|, all runs):")
for tag, t in [('corr_39', tm), ('corr_37', tA), ('cov_39', tB)]:
    say(f"  {tag}: " + ", ".join(f"{v}(#{t.loc[v,'rankPC1']})" for v in SYM)
        + "  ||  |PC2|: " + ", ".join(f"{v}(#{t.loc[v,'rankPC2']})" for v in SYM))

# what the axes contrast
Z = ((cap-cap.mean())/cap.std(ddof=1)).values
S = Z @ main['L']
say("\n### AXIS MEANING DIAGNOSTICS (main run)")
for j in range(3):
    say(f"  PC{j+1} score vs mean of all 12 standardised Z: r = {np.corrcoef(S[:,j], Z.mean(1))[0,1]:+.3f}"
        f" | vs CE (time): r = {np.corrcoef(S[:,j], cap.index.values)[0,1]:+.3f}")
say("PC3 oriented loadings (top 4): " + ", ".join(
    f"{v} {main['L'][VARS.index(v),2]:+.3f}" for v in
    sorted(VARS, key=lambda v: -abs(main['L'][VARS.index(v), 2]))[:4]))
per = _c.set_index('CE').sort_index()['group'].reindex(cap.index).values
for j in range(3):
    say(f"  mean PC{j+1} score by period: " + ", ".join(
        f"{g} {S[per == g, j].mean():+.2f}(n={int((per == g).sum())})" for g in ['EN','MN','SG','LN','OBA','YBA']))

tm.round(6).to_csv('analysis/pca_loadings_main.csv')
pd.DataFrame({'eigenvalue': main['ev'], 'PVE%': 100*main['pve'],
              'cumPVE%': 100*np.cumsum(main['pve'])},
             index=[f'PC{i+1}' for i in range(12)]).round(6).to_csv('analysis/pca_eigenvalues_main.csv')
tB.round(6).to_csv('analysis/pca_loadings_cov_sensitivity.csv')
tA.round(6).to_csv('analysis/pca_loadings_37slice_sensitivity.csv')
open('analysis/capital_pca_summary.txt','w').write("\n".join(OUT) + "\n")
print("\n[saved] analysis/capital_pca_summary.txt + 4 CSV tables")
