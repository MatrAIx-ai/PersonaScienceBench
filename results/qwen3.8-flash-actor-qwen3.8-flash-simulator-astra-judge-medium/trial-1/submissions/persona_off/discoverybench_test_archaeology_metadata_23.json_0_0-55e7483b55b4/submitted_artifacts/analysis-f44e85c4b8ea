"""
3400-3000 BCE: how do Monument Count and Axes/Celts relate to elements of symbolic capital?

Fixed requirements (approved):
  * "axes" = AxesCelts (ZBeil). Symbolic capital = HatchetSword, Dagger, HouseSize.
    Social = CopperGold, Amber, MonumentCount; Cultural = PotteryForm, PotteryDecoration;
    Economic = Depot, Sickle, AxesCelts, MonumentSize.  Targets = MonumentCount, AxesCelts.
  * Window inclusive of both endpoints -> 5 anchors (3400,3300,3200,3100,3000 BCE);
    BCE = start of a 100-yr bin, CE = -BCE, calBP = 1950 - BCE; time_series_data.csv = authoritative time axis.
  * Answer in LEVELS; changes reported alongside, never conflated.
  * Extended 3800-2800 BCE (11 anchors) used ONLY for lag/lead + sign-stability context (labelled out-of-window).
  * Exact label-permutation p-values only (no asymptotic p); no inference on the yearly *_inter grids.
  * Pollen (Belau openness) = demographic covariate only; growth recomputed from pollen_inter (100-yr diffs);
    pollen_grate_100 ignored. Woserin PC1: one-line robustness note. Observation effort: kde_all_mean / g_all_mean.
"""
import itertools
import numpy as np, pandas as pd
from scipy.stats import spearmanr

TS, CAP = 'data/time_series_data.csv', 'data/capital.csv'
SYM = ['HatchetSword', 'Dagger', 'HouseSize']
CONTRAST = ['PotteryForm', 'PotteryDecoration',            # cultural capital
            'CopperGold', 'Amber',                         # social capital (MonumentCount = target, also social)
            'Depot', 'Sickle', 'MonumentSize']             # economic capital / monument size
TARGETS = ['MonumentCount', 'AxesCelts']
ALLV = TARGETS + SYM + CONTRAST
NEAR_FLAT_SD = 0.05      # Z-units; below this a series carries no usable within-window signal
rep, rows = [], []
w = rep.append

# ------------------------------------------------------------------ 1. anchor grid (100-yr bins)
ts = pd.read_csv(TS, index_col=0)
cap = pd.read_csv(CAP, decimal=',')
anch = (ts.dropna(subset=['MonumentCount']).assign(BCE=lambda d: -d.CE)
          .set_index('BCE')[ALLV + ['kde_all_mean', 'g_all_mean']].sort_index(ascending=False))
anch['group'] = cap.set_index('BCE')['group']
poll = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                   decimal=',', index_col=0)
for src, dst in [('Belau_PC1_inter', 'pollen_inter'), ('SMOOTH_MEAN_100y', 'pollen_smooth100'),
                 ('Woserin_PC1_inter', 'woserin_inter')]:
    anch[dst] = pd.Series(poll[src].values, index=(-poll.CE.values)).reindex(anch.index).values
anch['pollen_ts'] = ts.set_index('CE')['pollen_inter'].reindex(-anch.index).values
chk = pd.concat([anch.pollen_inter, anch.pollen_ts], axis=1).dropna()
w('cross-check pollen: Belau_PC1_inter vs time_series pollen_inter, n=%d, max|diff|=%.3g '
  '(window max|diff| = %.3g)' % (len(chk), (chk.iloc[:, 0] - chk.iloc[:, 1]).abs().max(),
   (chk.loc[[b for b in chk.index if 3000 <= b <= 3400]].pipe(lambda d: (d.iloc[:, 0] - d.iloc[:, 1]).abs().max()))))
w('NOTE pollen file starts at 4785 BCE / ends 702 BCE; anch rows outside that range are NaN.\n')

WIN = [3400, 3300, 3200, 3100, 3000]                      # chronological (3400 BCE first)
EXT = [3800, 3700, 3600, 3500, 3400, 3300, 3200, 3100, 3000, 2900, 2800]

def zs(s, thr=NEAR_FLAT_SD):
    s = pd.Series(s, dtype=float)
    sd = s.std(ddof=0)
    if sd < thr:
        return pd.Series(0.0, index=s.index), True, sd
    return (s - s.mean()) / sd, False, sd

def add_composites(D):
    parts, flags, sds = {}, {}, {}
    for c in SYM:
        parts[c], flags[c], sds[c] = zs(D[c])
    D['SymbolicComposite'] = pd.concat(parts, axis=1).mean(axis=1)      # flat elements contribute 0
    D['SymbolicCompositeFullScale'] = ((D[SYM] - anch[SYM].mean()) / anch[SYM].std(ddof=0)).mean(axis=1)
    return D, flags, sds

W, flatW, sdW = add_composites(anch.loc[WIN].copy())
E, flatE, sdE = add_composites(anch.loc[EXT].copy())
for D in (W, E):
    D['pollen_growth100'] = D['pollen_inter'].diff(1)      # 100-yr change of openness on the anchor grid

# ------------------------------------------------------------------ 2. statistics helpers
def pear(x, y):
    x, y = np.asarray(x, float), np.asarray(y, float)
    if x.std(ddof=0) < 1e-15 or y.std(ddof=0) < 1e-15:
        return np.nan
    return float(np.corrcoef(x, y)[0, 1])

def spear(x, y):
    r = spearmanr(x, y).statistic                          # tie-corrected
    return float(r) if np.isfinite(r) else np.nan

def perm_p(x, y, stat):
    """exact two-sided permutation p over ALL distinct label permutations of x (no asymptotics)."""
    x, y = np.asarray(x, float), np.asarray(y, float)
    obs = stat(x, y)
    perms = sorted(set(itertools.permutations(range(len(x)))))
    null = np.array([stat(x[list(p)], y) for p in perms])
    pval = (np.sum(np.abs(null) >= abs(obs) - 1e-12) + 1) / (len(perms) + 1)
    return obs, pval, len(perms)

def prep(target, pred, D, kind):
    """return (x_pred, y_target, n, note). 'levels' = 5 anchors; 'changes' = 100-yr first differences."""
    d = D[[target, pred]].dropna()
    x, y = d[pred].values, d[target].values
    if kind == 'changes':
        x, y = np.diff(x), np.diff(y)
    if np.std(x, ddof=0) < 1e-15 or np.std(y, ddof=0) < 1e-15:
        return None, None, len(x), 'undefined: zero variance (%s series flat)' % ('predictor' if np.std(x, ddof=0) < 1e-15 else 'target')
    if np.std(x, ddof=0) < NEAR_FLAT_SD:
        return None, None, len(x), 'undefined: predictor near-flat within window (SD %.3f Z)' % np.std(x, ddof=0)
    return x, y, len(x), ''

def sign_agree(x, y):
    a, b = np.sign(x), np.sign(y)
    ok = (a != 0) & (b != 0)
    return '%d/%d' % (int((a[ok] == b[ok]).sum()), int(ok.sum()))

def result_row(target, pred, D, kind):
    x, y, n, note = prep(target, pred, D, kind)
    base = dict(grid=kind, target=target, predictor=pred, n=n)
    if note:
        return {**base, 'pearson': np.nan, 'spearman': np.nan, 'perm_p_pearson': np.nan,
                'perm_p_spearman': np.nan, 'loao_r_min': np.nan, 'loao_r_max': np.nan,
                'sign_agree_intervals': 'n/a', 'note': note}
    r, p_r, nperm = perm_p(x, y, pear)
    rho, p_s, _ = perm_p(x, y, spear)
    lo = [v for v in (pear(np.delete(x, i), np.delete(y, i)) for i in range(n)) if np.isfinite(v)]
    return {**base, 'pearson': round(r, 3), 'spearman': round(rho, 3), 'perm_p_pearson': round(p_r, 3),
            'perm_p_spearman': round(p_s, 3), 'loao_r_min': round(min(lo), 3), 'loao_r_max': round(max(lo), 3),
            'sign_agree_intervals': sign_agree(np.diff(D[[target, pred]].dropna()[pred].values),
                                               np.diff(D[[target, pred]].dropna()[target].values))
              if kind == 'levels' else sign_agree(x, y),
            'n_permutations': nperm, 'note': note}

ORDER = SYM + ['SymbolicComposite', 'SymbolicCompositeFullScale'] + CONTRAST
recs = [result_row(t, p, W, k) for k in ('levels', 'changes') for t in TARGETS for p in ORDER if p != t]
recs += [result_row('AxesCelts', 'MonumentCount', W, k) for k in ('levels', 'changes')]
res = pd.DataFrame(recs)

# ------------------------------------------------------------------ 3. covariates
def partial(a, b, ctrl, D):
    d = D[[a, b, ctrl]].dropna()
    x, y, z = d[a].values, d[b].values, d[ctrl].values
    if np.std(x) < NEAR_FLAT_SD or np.std(y) < 1e-15 or np.std(z) < 1e-15:
        return np.nan, np.nan, len(d)
    Z = np.vstack([np.ones_like(z), z]).T
    rx = x - Z @ np.linalg.lstsq(Z, x, rcond=None)[0]
    ry = y - Z @ np.linalg.lstsq(Z, y, rcond=None)[0]
    r, p, _ = perm_p(rx, ry, pear)
    return r, p, len(d)

# ------------------------------------------------------------------ 4. report
pd.set_option('display.width', 250)
w('=== IN-WINDOW ANCHOR GRID (100-yr bins, chronological; Z values, full-series standardisation) ===')
g = anch.loc[WIN, ALLV + ['pollen_inter', 'pollen_smooth100', 'group']].copy()
g['kde_all_mean'] = (anch.loc[WIN, 'kde_all_mean'] * 1e4).round(2)          # x1e4 for readability
g['g_all_mean'] = (anch.loc[WIN, 'g_all_mean'] * 1e3).round(2)              # x1e3
w(g.round(3).rename(columns={'kde_all_mean': 'kde_all_mean_e4', 'g_all_mean': 'g_all_mean_e3'}).to_string())
w('\nwithin-window SD (Z units) of symbolic elements: %s   [flat threshold = %.2f]' %
  ({k: round(v, 4) for k, v in sdW.items()}, NEAR_FLAT_SD))
w('composite dominance: r(SymbolicComposite, HouseSize) = %.3f ; r(composite, HatchetSword) = %s ; '
  'r(composite, Dagger) = %s (flat elements contribute a constant 0)' %
  (pear(W.SymbolicComposite, W.HouseSize),
   'undefined (HatchetSword SD %.3f)' % sdW['HatchetSword'], 'undefined (Dagger constant)'))
w('r(SymbolicCompositeFullScale, HouseSize) = %.3f -> composite is effectively the House Size series'
  % pear(W.SymbolicCompositeFullScale, W.HouseSize))

for kind in ('levels', 'changes'):
    w('\n=== %s, 5-anchor in-window grid (exact permutation p; no asymptotic p) ===' % kind.upper())
    for t in TARGETS:
        sub = res[(res.grid == kind) & (res.target == t)].drop(columns=['grid', 'target'])
        w('\n-- target: %s --' % t)
        w(sub.to_string(index=False))

w('\n=== 100-yr CHANGES (levels differences) - raw interval narrative, in-window ===')
ch = W[ALLV + ['pollen_inter', 'kde_all_mean']].diff()
ch = ch.iloc[1:]
ch.index = ['%d->%d BCE' % (a, b) for a, b in zip(WIN[:-1], WIN[1:])]   # chronological 100-yr steps
ch_disp = ch.copy()
ch_disp['kde_all_mean'] = ch_disp['kde_all_mean'] * 1e4
w(ch_disp.round(3).rename(columns={'kde_all_mean': 'kde_all_mean_x1e4'}).to_string())

w('\n=== COVARIATES: correlation with openness / observation effort (in-window, 5 anchors) ===')
for c in ['pollen_inter', 'pollen_smooth100', 'pollen_growth100', 'woserin_inter', 'kde_all_mean', 'g_all_mean']:
    parts = ['%-20s' % c]
    for v in TARGETS + SYM + ['SymbolicComposite']:
        d = W[[c, v]].dropna()
        ok = len(d) >= 4 and d[c].std() > 1e-15 and d[v].std() >= NEAR_FLAT_SD
        parts.append('%s=%s' % (v, ('%+.2f (n=%d)' % (pear(d[c], d[v]), len(d))) if ok else 'n/a'))
    w(' | '.join(parts))
w('  (pollen_growth100 / any 100-yr difference series have n=4 by construction; n reported per cell)')
w('\npartial r (target ~ symbolic element | covariate), exact perm p on residuals:')
for cov in ['pollen_inter', 'pollen_smooth100', 'kde_all_mean', 'g_all_mean']:
    for t in TARGETS:
        for p in ['HouseSize', 'SymbolicComposite']:
            r, pv, n = partial(t, p, cov, W)
            w('  %s ~ %-20s | %-17s : r=%+.3f  p_perm=%s  n=%d' %
              (t, p, cov, r, ('%.3f' % pv) if np.isfinite(pv) else 'n/a', n))

w('\n=== EXTENDED WINDOW 3800-2800 BCE (11 anchors) - CONTEXT ONLY, OUTSIDE the requested window ===')
w('lag in 100-yr bins; +k means the predictor is taken k bins EARLIER than the target (predictor LEADS)')
def xcorr(a, b, lags=(-2, -1, 0, 1, 2)):
    out = {}
    for L in lags:
        x, y = (a[:len(a) - L], b[L:]) if L >= 0 else (a[-L:], b[:len(b) + L])
        out[L] = pear(x, y)
    return out
for t in TARGETS:
    for p in ['HouseSize', 'SymbolicComposite', 'HatchetSword', 'Dagger', 'Amber', 'CopperGold',
              'MonumentSize', 'Depot', 'pollen_inter', 'kde_all_mean']:
        s = E[[t, p]].dropna()
        if len(s) < 6:
            continue
        r = xcorr(s[p].values, s[t].values)
        w('  %-14s x %-18s r(lag -2,-1,0,+1,+2) = %s' %
          (t, p, ' '.join(('%+.2f' % r[L]) if np.isfinite(r[L]) else '  n/a ' for L in sorted(r))))
w('\nextended-window levels (context):')
w(E[ALLV + ['pollen_inter', 'kde_all_mean', 'group']].round(3).to_string())
w('\nextended-window flat flags: %s (HatchetSword SD=%.4f Z)' % ({k: bool(v) for k, v in flatE.items()}, sdE['HatchetSword']))
w('\nWoserin robustness (one line, out of scope): Woserin_PC1_inter correlates r=%.2f with Belau_PC1_inter in-window and trends the same way, so the openness covariate is not site-idiosyncratic; no Woserin-based inference is made.'
  % pear(W.woserin_inter, W.pollen_inter))

w('\n=== TRANSPARENCY: raw r computed IGNOREING the near-flat threshold (NOT evidence) ===')
w('  These series vary by <= the 0.01 quantisation of the published table, so any r is rounding noise.')
for t in TARGETS:
    for p in ['HatchetSword', 'Dagger', 'Amber', 'Sickle']:
        d = W[[t, p]]
        raw = pear(d[p].values, d[t].values)
        rng = d[p].max() - d[p].min()
        w('  %-14s x %-13s within-window range=%.2f Z   raw r=%s' %
          (t, p, rng, ('%+.3f' % raw) if np.isfinite(raw) else 'undefined (zero variance)'))

w('\n=== EN/MN BOUNDARY SENSITIVITY: drop the 3400 BCE bin (MN-only core, 3300-3000 BCE, 4 anchors) ===')
Wm = W.drop(index=3400)
w('House Size step: 3600 BCE = %.2f -> 3500 BCE = %.2f -> 3400 BCE = %.2f (its maximum sits exactly on the EN/MN transition)'
  % (anch.loc[3600, 'HouseSize'], anch.loc[3500, 'HouseSize'], anch.loc[3400, 'HouseSize']))
for t in TARGETS:
    for p in ['HouseSize', 'SymbolicComposite', 'Depot', 'MonumentSize', 'CopperGold', 'PotteryForm', 'MonumentCount', 'AxesCelts']:
        if p == t:
            continue
        d = Wm[[t, p]]
        r5 = pear(W[p].values, W[t].values) if p in W and (p != 'SymbolicComposite') else pear(W['SymbolicComposite'].values, W[t].values)
        rm = pear(d[p].values, d[t].values)
        both = [v for v in (rm, r5) if np.isfinite(v)]
        w('  %-14s x %-18s r(5 bins 3400-3000)=%s   r(4 bins 3300-3000)=%s   sign flips: %s' %
          (t, p, ('%+.3f' % r5) if np.isfinite(r5) else 'undefined',
           ('%+.3f' % rm) if np.isfinite(rm) else 'undefined',
           'YES' if len(both) == 2 and np.sign(rm) != np.sign(r5) else 'no'))

w('\n=== SUMMARY / DATA-GROUNDED HYPOTHESIS (in-window evidence unless labelled context) ===')
def g_(kind, t, p, col='pearson'):
    r = res[(res.grid == kind) & (res.target == t) & (res.predictor == p)]
    return r[col].iloc[0] if len(r) and np.isfinite(r[col].iloc[0]) else 'undefined'
w('  targets co-move: r(MonumentCount, AxesCelts) = %.3f (exact perm p = %.3f), both peak in the 3200-3100 BCE bins'
  % (g_('levels', 'AxesCelts', 'MonumentCount'), res[(res.grid=='levels')&(res.target=='AxesCelts')&(res.predictor=='MonumentCount')].perm_p_pearson.iloc[0]))
w('  symbolic capital is mostly static in-window: Dagger SD=0.000 Z, HatchetSword SD=%.3f Z -> composite = House Size (r=1.000)' % sdW['HatchetSword'])
for t in TARGETS:
    w('  levels   %-14s ~ SymbolicComposite: r=%s rho=%s p_perm=%s LOAO=[%s, %s] signs=%s'
      % (t, g_('levels', t, 'SymbolicComposite'), g_('levels', t, 'SymbolicComposite', 'spearman'),
         res[(res.grid=='levels')&(res.target==t)&(res.predictor=='SymbolicComposite')].perm_p_pearson.iloc[0],
         res[(res.grid=='levels')&(res.target==t)&(res.predictor=='SymbolicComposite')].loao_r_min.iloc[0],
         res[(res.grid=='levels')&(res.target==t)&(res.predictor=='SymbolicComposite')].loao_r_max.iloc[0],
         res[(res.grid=='levels')&(res.target==t)&(res.predictor=='SymbolicComposite')].sign_agree_intervals.iloc[0]))
    w('  changes  %-14s ~ SymbolicComposite: r=%s rho=%s p_perm=%s'
      % (t, g_('changes', t, 'SymbolicComposite'), g_('changes', t, 'SymbolicComposite', 'spearman'),
         res[(res.grid=='changes')&(res.target==t)&(res.predictor=='SymbolicComposite')].perm_p_pearson.iloc[0]))
w('  strongest in-window covariate for BOTH targets is Depot (hoards, economic capital): r=%.3f/%.3f'
  % (g_('levels', 'MonumentCount', 'Depot'), g_('levels', 'AxesCelts', 'Depot')))
w('  context (3800-2800 BCE, OUTSIDE window): House Size LEADS MonumentCount, r(+2 bins)=+0.68 and AxesCelts r(+2 bins)=+0.56')

res.to_csv('results_association_table.csv', index=False)
W.round(6).to_csv('results_inwindow_grid.csv')
open('results_report.md', 'w').write('\n'.join(rep))
