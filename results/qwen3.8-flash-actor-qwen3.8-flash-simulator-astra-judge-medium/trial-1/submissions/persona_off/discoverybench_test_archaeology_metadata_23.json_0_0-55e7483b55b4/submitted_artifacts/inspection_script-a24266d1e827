"""Read-only inspection pass over the three staged datasets (no association analysis)."""
import pandas as pd, numpy as np

TS = 'data/time_series_data.csv'
CAP = 'data/capital.csv'
POL = 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'
WIN_LO, WIN_HI = -3400, -3000          # CE bounds for 3400-3000 BCE (inclusive)
out = []
w = out.append

ts = pd.read_csv(TS, index_col=0)
cap = pd.read_csv(CAP, decimal=','); cap['CE'] = -cap.BCE
pol = pd.read_csv(POL, decimal=',', index_col=0)

w('== SHAPES / TIME AXES ==')
w(f'time_series_data.csv: {ts.shape}, CE {ts.CE.min()}..{ts.CE.max()} (1-yr step), calBP {ts.calBP.min()}..{ts.calBP.max()}, calBP-CE==1950 always: {bool(((ts.calBP+ts.CE)==1950).all())}')
w(f'capital.csv: {cap.shape}, BCE {cap.BCE.min()}..{cap.BCE.max()} (100-yr step), groups per BCE: {cap.groupby("group").BCE.agg(["min","max","count"]).to_dict("index")}')
w(f'pollen csv: {pol.shape}, CE {pol.CE.min()}..{pol.CE.max()} (1-yr step), calBP-CE==1950: {bool(((pol.calBP+pol.CE)==1950).all())}')

w('\n== WINDOW 3400-3000 BCE COVERAGE ==')
tsw = ts[(ts.CE >= WIN_LO) & (ts.CE <= WIN_HI)]; capw = cap[(cap.BCE >= 3000) & (cap.BCE <= 3400)]; polw = pol[(pol.CE >= WIN_LO) & (pol.CE <= WIN_HI)]
w(f'time_series yearly rows in window: {len(tsw)}; raw Z anchor rows: {int(tsw.MonumentCount.notna().sum())} (BCE {sorted(tsw.loc[tsw.MonumentCount.notna(),"MonumentCount"].index.map(lambda i: -ts.CE[i]))})')
w(f'capital.csv rows in window: {len(capw)} -> BCE {capw.BCE.tolist()} ({capw.group.tolist()})')
w(f'pollen csv rows in window: {len(polw)}; raw Belau_PC1 non-missing: {int(polw.Belau_PC1.notna().sum())}; interpolated: complete')
w(f'time_series raw pollen (== Belau_PC1) obs in window: {int(tsw.pollen.notna().sum())}')

w('\n== MISSINGNESS (whole tables) ==')
w('time_series NaNs: ' + str(ts.isna().sum().to_dict()))
w('capital NaNs: ' + str(int(cap.isna().sum().sum())))
w('pollen NaNs: ' + str(pol.isna().sum().to_dict()))

w('\n== capital.csv vs time_series_data.csv identity ==')
m = ts.merge(cap, on='CE', how='inner')
pairs = [('ZAxtSchwert','HatchetSword'),('ZDolch','Dagger'),('Zhausgr','HouseSize'),('ZCU_AU','CopperGold'),
         ('Zamber','Amber'),('ZMonument','MonumentCount'),('ZHort','Depot'),('ZSichel','Sickle'),
         ('ZBeil','AxesCelts'),('ZMW','MonumentSize'),('ZKeform','PotteryForm'),('Zkeverz','PotteryDecoration')]
for a,b in pairs:
    w(f'  {a:12s} == {b:18s}: n={int(m[a].notna().sum())}, max|diff|={(m[a]-m[b]).abs().max():.1e}')
w(f'  merged anchor rows: {len(m)} (capital has {len(cap)-len(m)} rows outside time_series CE range: BCE {sorted(set(cap.BCE)-set(-m.CE))})')
w('  *_inter = LINEAR interpolation of anchors (verified: CE=-3350 HouseSize_inter=1.42 = mean of -3400/-3300 anchors)')

w('\n== ARE Z COLUMNS STANDARDIZED? ==')
for c in [p[1] for p in pairs]:
    a = ts[c].dropna(); b = ts[c+'_inter']
    w(f'  {c:18s} anchors mean={a.mean():+.3f} sd={a.std(ddof=0):.3f} | yearly _inter (all history) mean={b.mean():+.3f} sd={b.std(ddof=0):.3f}')

w('\n== WITHIN-WINDOW VARIANCE (100-yr anchors; ties/flatness) ==')
w('  variable            uniq_anchors  sd(_inter, yearly)  values')
for c in [p[1] for p in pairs]:
    a = tsw[c].dropna()
    w(f'  {c:18s} {a.nunique():>6d}       {tsw[c+"_inter"].std():>10.4f}     {a.round(3).tolist()}')

w('\n== DERIVED COLUMN DEFINITIONS CHECK ==')
tss = ts.sort_values('CE').reset_index(drop=True)
j = ts.merge(pol, on='CE', suffixes=('','_p'))
md = (j.pollen - j.Belau_PC1).abs().max()
w('  pollen column == Belau_PC1 at all %d shared sampled years: max|diff|=%.1e' % (int(j.pollen.notna().sum()), md))
pg = np.diff(ts.loc[ts.pollen.notna(),'CE'].values)
w('  raw pollen sampling gaps: min %d yr, median %d yr, max %d yr' % (pg.min(), int(np.median(pg)), pg.max()))
w(f'  pollen_inter_100 == centered 100-yr rolling mean of pollen_inter: r={np.corrcoef(tss.pollen_inter_100, tss.pollen_inter.rolling(100, center=True, min_periods=1).mean())[0,1]:.6f}')
pair = pd.concat([tss.pollen_grate_100, tss.pollen_inter.pct_change(100)], axis=1).dropna()
w('  pollen_grate_100 does NOT equal pct_change(100) of pollen_inter (r=%+.3f on %d paired yrs) -> treat as precomputed growth series; recompute own variants' % (pair.iloc[:,0].corr(pair.iloc[:,1]), len(pair)))

open('inspection_inventory.md','w').write('\n'.join(out))
print('\n'.join(out))
