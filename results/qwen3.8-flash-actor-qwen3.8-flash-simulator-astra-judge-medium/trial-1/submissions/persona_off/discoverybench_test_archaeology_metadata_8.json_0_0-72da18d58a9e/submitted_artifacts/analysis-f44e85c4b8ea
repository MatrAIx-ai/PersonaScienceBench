"""
Amber z-value analysis: which millennium is highest, and over what interval does it peak?

Primary   : capital.csv `Zamber` (39 bins, 4300-500 BCE, 100-yr resolution; no NaNs)
Cross-check: time_series_data.csv `Amber` (37 non-null on the same 100-yr grid) and
             `Amber_inter` (annual LINEAR interpolation) -> rolling-window sensitivity only
Context   : pollen openness file (no amber variable; NOT an input to the answer)

All values are standardised z-scores of relative amber signal within 4300-500 BCE.
"""
import numpy as np, pandas as pd
DATA = "data"
pd.set_option("display.width", 200)

cap = pd.read_csv(f"{DATA}/capital.csv", decimal=",")        # comma decimal separators
ts  = pd.read_csv(f"{DATA}/time_series_data.csv", index_col=0)
cap["CE"] = -cap.BCE
cap["calBP"] = 1950 + cap.BCE
cap = cap.sort_values("BCE", ascending=False).reset_index(drop=True)
obs = cap[["BCE", "CE", "calBP", "group", "Zamber"]].copy()

print("="*78, "\n1. PRIMARY SERIES (capital.csv Zamber)\n", "="*78, sep="")
print(f"bins={len(obs)}  span BCE {obs.BCE.max()}-{obs.BCE.min()}  step={np.unique(np.diff(obs.BCE.values))}"
      f"  missing={int(obs.Zamber.isna().sum())}")
print(f"z min={obs.Zamber.min():.2f} max={obs.Zamber.max():.2f} mean={obs.Zamber.mean():.4f} "
      f"sd={obs.Zamber.std():.4f} -> standardised within the 4300-500 BCE frame")

am  = ts.loc[ts.Amber.notna(), ["CE", "Amber"]]
both = obs.merge(am, on="CE")
print("\n", "="*78, "\n2. CROSS-CHECK vs time_series_data.csv\n", "="*78, sep="")
print(f"overlapping century bins={len(both)}  max |Zamber-Amber| = {(both.Zamber-both.Amber).abs().max():.2e}")
print(f"extra bins only in capital.csv: BCE {sorted(set(obs.BCE)-set(-am.CE))}")
print(f"time_series Amber non-null {len(am)}/{len(ts)} rows ({100*len(am)/len(ts):.1f}%), all on 100-yr grid: "
      f"{bool((am.CE%100==0).all())}")
ann = ts.set_index("CE").Amber_inter
lin = obs.set_index("CE").Zamber.reindex(ann.index).interpolate("linear", limit_area="inside")
print(f"Amber_inter == LINEAR interpolation of the 100-yr amber values: "
      f"max abs diff = {(ann-lin).abs().max():.2e} -> no extra information")
print("series is step-like:", len(set(obs.Zamber)), "distinct values /", len(obs), "bins; breakpoints (BCE):",
      [int(obs.BCE[i]) for i in range(1, len(obs)) if obs.Zamber.iloc[i] != obs.Zamber.iloc[i-1]])

# ---- three millennium labelling conventions (deliberately NOT identical functions)
CONV = {
 "S1 ordinal (standard, no year 0): 4th = 4000-3001 BCE": (lambda b: int(np.ceil(b/1000)),
        lambda m: (m*1000, m*1000-999)),
 "S2 rounded: 4th = 3999-3000 BCE": (lambda b: int(b//1000)+1, lambda m: (m*1000-1, (m-1)*1000)),
 "S3 researcher example: 3000-2000 BCE = 4th": (lambda b: int((b-1)//1000)+2, lambda m: ((m-1)*1000, (m-2)*1000)),
}
ORD = {1:"1st",2:"2nd",3:"3rd",4:"4th",5:"5th",6:"6th"}
print("\n", "="*78, "\n3. AMBER BY MILLENNIUM - ALL THREE LABELLING CONVENTIONS\n", "="*78, sep="")
tops = {}
for title,(fn,span) in CONV.items():
    obs["mill"] = obs.BCE.map(fn)
    g = (obs.groupby("mill").Zamber.agg(mean_z="mean", max_z="max", n_bins="count").round(3)
            .sort_values("mean_z", ascending=False))
    g["numeric_span"] = [f"{span(m)[0]}-{span(m)[1]} BCE" for m in g.index]
    print(f"\n--- {title}")
    print(g.rename_axis("millennium").to_string())
    t, s2 = g.index[0], g.index[1]
    tops[title] = (t, g.mean_z[t], g.mean_z[s2], ORD[s2])
    print(f"    >> winner: {ORD[t]} millennium BCE = {span(t)[0]}-{span(t)[1]} BCE "
          f"(mean z={g.mean_z[t]:+.3f}, max z={g.max_z[t]:+.2f}, n={int(g.n_bins[t])}); "
          f"runner-up {ORD[s2]} mean z={g.mean_z[s2]:+.3f}; margin {g.mean_z[t]-g.mean_z[s2]:.3f} sd")
    g.to_csv(f"out/amber_by_millennium_{title.split(':')[0]}.csv")

# invariant bin set that wins under every convention
s1 = CONV["S1 ordinal (standard, no year 0): 4th = 4000-3001 BCE"][0]
winners = obs[obs.BCE.map(s1) == 4].sort_values("BCE", ascending=False)
s2f = CONV["S2 rounded: 4th = 3999-3000 BCE"][0]
w2 = obs[obs.BCE.map(s2f) == 4].sort_values("BCE", ascending=False)
print(f"\nWINNING BIN SET under S1: BCE {int(winners.BCE.max())}-{int(winners.BCE.min())}, "
      f"n={len(winners)}, mean z={winners.Zamber.mean():+.3f}, z in [{winners.Zamber.min():.2f},{winners.Zamber.max():.2f}]")
print(f"WINNING BIN SET under S2: BCE {int(w2.BCE.max())}-{int(w2.BCE.min())}, n={len(w2)}, "
      f"mean z={w2.Zamber.mean():+.3f}")
print("=> the LABEL and the exact 10-bin window are convention-dependent (they shift by one bin), "
      "but\n   every convention selects the same 4000-3000 BCE high-amplitude plateau, and no\n"
      "   convention ever selects any other plateau.")

# --- robustness: leave-one-bin-out (no error bars available, so test sensitivity instead)
print("\n", "="*78, "\n3b. ROBUSTNESS: LEAVE-ONE-BIN-OUT (S1 convention)\n", "="*78, sep="")
flips = []
for drop in obs.BCE:
    sub = obs[obs.BCE != drop]
    gg = sub.groupby(sub.BCE.map(s1)).Zamber.mean().sort_values(ascending=False)
    if gg.index[0] != 4: flips.append((int(drop), int(gg.index[0])))
print(f"drop each of {len(obs)} bins in turn: winning millennium changes in {len(flips)} of {len(obs)} cases"
      + (f" -> {flips}" if flips else " (winner is the 4000-3001 BCE millennium every time)"))
g4 = obs[obs.BCE.map(s1)==4].Zamber; g3 = obs[obs.BCE.map(s1)==3].Zamber
print(f"gap between winner and runner-up: winner min z={g4.min():.2f} > runner-up max z={g3[g3<1.4].max():.2f}"
      f" -> the two millennia do NOT overlap in value (excluding the 3000 BCE boundary bin)")

# ---------------------------------------------------------------- peak interval
print("\n", "="*78, "\n4. PEAK INTERVAL\n", "="*78, sep="")
mx = obs.Zamber.max()
tie = obs[obs.Zamber >= mx-1e-9].sort_values("BCE", ascending=False)
print(f"(a) TIED MAXIMUM: z={mx:.2f} at bins BCE {list(tie.BCE)} -> interval "
      f"{int(tie.BCE.max())}-{int(tie.BCE.min())} BCE ({len(tie)} consecutive 100-yr bins)")
print(f"    cultural periods of peak bins: {sorted(set(tie.group))}")
print(f"    ordinal-millennium membership of peak bins: "
      f"{[ORD[s1(b)]+' mill' for b in tie.BCE]}")
print("    The maximum is TIED across bins: a single 'peak year' would be an artefact of")
print("    interpolation, not a feature of the data.")
hi = obs[obs.Zamber >= 1.46].sort_values("BCE", ascending=False)
print(f"\n(b) HIGHSTAND z>=1.46: BCE {int(hi.BCE.max())}-{int(hi.BCE.min())} "
      f"({len(hi)} consecutive bins, z in [{hi.Zamber.min():.2f},{hi.Zamber.max():.2f}]); periods {sorted(set(hi.group))}")
print(f"    next-highest value anywhere else in the series: z={obs[obs.Zamber<1.46].Zamber.max():.2f} "
      f"(BCE 2900) -> the highstand is a clean, isolated plateau")
print("\n(c) SMOOTHED MODE (Amber_inter sensitivity; annual values are interpolated):")
for w in (300, 500, 1000):
    r = ann.rolling(w, center=True).mean(); ce = int(r.idxmax())
    print(f"    {w:>4}-yr centred rolling mean: mode at {abs(ce)} BCE (z={r.max():.3f})")
print("    -> smoothed mode lies inside 3300-3000 BCE for windows <=500 yr; the 1000-yr window")
print("       (too wide for a 39-point series) drags the mode early. Annual data cannot refine")
print("       the peak below the 100-yr bin.")

# ---------------------------------------------------------------- period overlay
print("\n", "="*78, "\n5. CULTURAL-PERIOD OVERLAY (capital.csv 'group')\n", "="*78, sep="")
per = obs.groupby("group").Zamber.agg(["mean","max","count"]).round(3)
rng = obs.groupby("group").BCE.agg(["max","min"])
per.insert(0,"span_BCE",[f"{int(r['max'])}-{int(r['min'])} BCE" for _,r in rng.iterrows()])
print(per.rename(columns={"mean":"mean_z","max":"max_z","count":"n_bins"})
        .sort_values("mean_z", ascending=False).to_string())
after = obs[obs.BCE <= 2900].Zamber.max()
print(f"\npeak interval (3300-3000 BCE) falls entirely in MN (Middle Neolithic, mean z=+1.52, "
      f"the highest of all 6 periods)")
print(f"highstand spans EN (4300-3500) into MN (3400-3000); collapse at the MN->SG transition:")
print(f"    z={obs.set_index('BCE').Zamber.loc[3000]:.2f} (3000 BCE, MN) -> "
      f"{obs.set_index('BCE').Zamber.loc[2900]:.2f} (2900 BCE, SG), a drop of "
      f"{obs.set_index('BCE').Zamber.loc[3000]-obs.set_index('BCE').Zamber.loc[2900]:.2f} z units")
print(f"    amber never again exceeds z={after:.2f} in the remaining 2400 years (SG/LN/OBA/YBA)")

# ---------------------------------------------------------------- pollen context
print("\n", "="*78, "\n6. POLLEN/OPENNESS - CONTEXT ONLY (not an input to the answer)\n", "="*78, sep="")
pl = pd.read_csv(f"{DATA}/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")
print(f"shape {pl.shape}; span BCE {-pl.CE.min()}-{-pl.CE.max()}; amber columns present: "
      f"{[c for c in pl.columns if 'amber' in c.lower()]} -> cannot inform the question directly")
pl["BCE"] = -pl.CE
am_bce = ann.rename("Amber_inter"); am_bce.index = -am_bce.index; am_bce.index.name = "BCE"
j = pl[(pl.BCE<=4100)&(pl.BCE>=500)].set_index("BCE")[["SMOOTH_MEAN_100y","SMOOTH_MEAN_250y"]].join(
        am_bce.sort_index(), how="inner").dropna()
j = j[~j.index.duplicated()]
jb = j.groupby((j.index // 100) * 100).mean().dropna()
for c in ("SMOOTH_MEAN_100y","SMOOTH_MEAN_250y"):
    r_ann = np.corrcoef(j[c], j.Amber_inter)[0,1]
    r_bin = np.corrcoef(jb[c], jb.Amber_inter)[0,1]
    print(f"    context only: r(amber, {c}): annual-interpolated r={r_ann:+.2f} (n={len(j)}, "
          f"PSEUDOREPLICATED)  vs 100-yr-bin r={r_bin:+.2f} (n={len(jb)}, honest df)")
print("    The annual r is inflated by interpolation; the ~37-bin r is the defensible one.")
print("    NOTE: openness PC1 sign convention is undocumented, raw sampling is sparse (~200 pts),")
print("    and there are no error bars -> descriptive context only, not evidence.")

# ---------------------------------------------------------------- summary
print("\n", "="*78, "\nSUMMARY\n", "="*78, sep="")
print("""HIGHEST MILLENNIUM : the millennium spanning 4000-3001 BCE  <-- numeric span is invariant
    standard ordinal name       -> 4th millennium BCE  (4th = 4000-3001)
    rounded name                -> 4th millennium BCE  (4th = 3999-3000)
    '3000-2000 BCE = 4th' name  -> 5th millennium BCE  <-- LABEL IS *NOT* INVARIANT
    mean z = +1.48, every bin z in [1.46,1.54], runner-up millennium mean z = -0.15
    NOTE: the 11-bin plateau 4000-3000 BCE wins under every convention, but the exact
          10-bin window shifts by one century at each edge (S1: 4000-3100, S2: 3900-3000).
PEAK INTERVAL (primary)    : 3300-3000 BCE, 4 tied bins at z = 1.54
HIGHSTAND                  : 4000-3000 BCE, z >= 1.46 (11 consecutive bins)
SMOOTHED MODE              : 3150 BCE (300-yr), 3243 BCE (500-yr) -> inside peak interval
PERIODS                    : peak entirely in MN; highstand EN->MN; collapse at MN->SG (2900 BCE)""")

obs.to_csv("out/amber_primary_bins.csv", index=False)
tie.to_csv("out/amber_peak_bins.csv", index=False)
per.to_csv("out/amber_by_period.csv")
print("\nwrote out/: amber_primary_bins.csv, amber_peak_bins.csv, amber_by_period.csv, amber_by_millennium_S{1,2,3}.csv")
