import pandas as pd, numpy as np
pd.set_option('display.width',220); pd.set_option('display.max_columns',60)
df=pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv', na_values=['NA',''])
df['ratio']=df['rr']/df['ro']
df['abs_ratio']=df['rr'].abs()/df['ro'].abs()
df['z_ratio']=df['fisr']/df['fiso']
df['d']=df['relative_es']-df['ratio']
bad=df[df['d'].abs()>1e-8].copy()
print("rows where relative_es != rr/ro:", len(bad))
print(bad[['study','project.y','discipline','ro','rr','fiso','fisr','relative_es','ratio','abs_ratio','z_ratio','aggregated']].to_string())
print("\nFor those rows, closest match: |rel - abs_ratio| max:", bad['relative_es'].sub(bad['abs_ratio']).abs().max(),
      " |rel - z_ratio| max:", bad['relative_es'].sub(bad['z_ratio']).abs().max())
print("\nOverall: max|rel-rr/ro| = %.3g ; max|rel - |rr|/|ro|| = %.3g ; max|rel - fisr/fiso| = %.3g" % (
  (df.relative_es-df.ratio).abs().max(), (df.relative_es-df.abs_ratio).abs().max(), (df.relative_es-df.z_ratio).abs().max()))
# rows with rr == ro exactly
print("\nrows with rr==ro:", int((df.rr==df.ro).sum()))
# duplicated ro values (possible multiple effect rows per study collapsed)
v=df['ro'].value_counts(); print("dup ro values:\n", v[v>1])
v2=df['rr'].value_counts(); print("dup rr values:\n", v2[v2>1])
print("\nno vs n.r equality:", (df['no']==df['n.r']).value_counts().to_dict())
print("nr vs n.r equality:", (df['nr']==df['n.r']).value_counts().to_dict())
print("nr vs n.r nonmissing:", df['nr'].notna().sum(), df['n.r'].notna().sum())
print("\nreplicated counts by project.y:\n", df.groupby('project.y')['replicated'].agg(['mean','count']))
print("\nse_fiso*sqrt(no-3) ~ 1? check:", (df['se_fiso']*np.sqrt(df['no']-3)).describe())
print("se_fisr*sqrt(nr-3):", (df['se_fisr']*np.sqrt(df['nr']-3)).describe())
print("\nro sign table:", np.sign(df.ro).value_counts().to_dict(), " rr sign:", np.sign(df.rr).value_counts().to_dict())
print("fiso==atanh(ro) check max err:", (df.fiso-np.arctanh(df.ro.clip(-0.999999,0.999999))).abs().max())
print("fisr==atanh(rr) check max err:", (df.fisr-np.arctanh(df.rr.clip(-0.999999,0.999999))).abs().max())
