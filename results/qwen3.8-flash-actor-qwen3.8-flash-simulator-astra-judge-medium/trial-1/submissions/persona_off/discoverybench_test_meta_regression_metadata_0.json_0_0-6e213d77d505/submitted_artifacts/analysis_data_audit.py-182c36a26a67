import pandas as pd, numpy as np
pd.set_option('display.width', 200); pd.set_option('display.max_columns', 100)
p='data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv'
df=pd.read_csv(p, na_values=['NA',''])
print("shape:", df.shape)
print("\n--- distinct project.x ---"); print(df['project.x'].value_counts(dropna=False))
print("\n--- distinct project.y ---"); print(df['project.y'].value_counts(dropna=False))
print("\n--- distinct discipline ---"); print(df['discipline'].value_counts(dropna=False))
print("\n--- crosstab project.x x discipline ---")
print(pd.crosstab(df['project.x'], df['discipline'], dropna=False))
print("\n--- crosstab project.y x discipline ---")
print(pd.crosstab(df['project.y'], df['discipline'], dropna=False))
print("\n--- crosstab project.x x project.y ---")
print(pd.crosstab(df['project.x'], df['project.y'], dropna=False))
key=['ro','rr','fiso','fisr','se_fiso','se_fisr','relative_es','po','pr','replicated','no','nr','aggregated','lab_id','study']
print("\n--- non-missing counts for key cols ---")
print(df[key].notna().sum())
print("\n--- dtypes ---"); print(df[key].dtypes)
print("\n--- duplicate study ids ---")
d=df['study'].value_counts(); print(d[d>1])
print("n distinct studies:", df['study'].nunique(), "of", len(df))
print("\n--- aggregated col values ---"); print(df['aggregated'].value_counts(dropna=False))
print("\n--- lab_id values (top) ---"); print(df['lab_id'].value_counts(dropna=False).head(15))
# rows where both effects absent / partially missing
both_missing = df['ro'].isna() & df['rr'].isna()
one_missing = df['ro'].isna() ^ df['rr'].isna()
print("\nboth ro & rr missing:", int(both_missing.sum()), " exactly one missing:", int(one_missing.sum()))
print(df.loc[both_missing | one_missing, ['study','project.y','discipline','ro','rr','fiso','fisr','se_fiso','se_fisr','relative_es','aggregated']])
# complete pairs on fisher scale
pair = df['fiso'].notna() & df['fisr'].notna()
print("\ncomplete fiso&fisr pairs:", int(pair.sum()))
print("complete ro&rr pairs:", int((df['ro'].notna()&df['rr'].notna()).sum()))
print("se_fiso non-missing among pairs:", int(df.loc[pair,'se_fiso'].notna().sum()),
      " se_fisr:", int(df.loc[pair,'se_fisr'].notna().sum()))
print("relative_es non-missing among pairs:", int(df.loc[pair,'relative_es'].notna().sum()))
# fully duplicated rows
print("\nfully duplicated rows:", int(df.duplicated().sum()))
print("duplicated on study+project.y:", int(df.duplicated(subset=['study','project.y']).sum()))
# relative_es sanity: check equals rr/ro
sub=df[df['relative_es'].notna()&df['ro'].notna()&df['rr'].notna()]
ratio=sub['rr']/sub['ro']
print("\nrelative_es vs rr/ro: max abs diff =", float((sub['relative_es']-ratio).abs().max()))
print("relative_es: min %.3f max %.3f, n=%d, negative count=%d" % (sub['relative_es'].min(), sub['relative_es'].max(), len(sub), int((sub['relative_es']<0).sum())))
print("\nro==0 rows:", int((df['ro']==0).sum()), " |ro|<0.05:", int((df['ro'].abs()<0.05).sum()))
print("\nsign reversal count (sign(ro)!=sign(rr), both nonzero):",
      int(((np.sign(df['ro'])!=np.sign(df['rr'])) & df['ro'].notna() & df['rr'].notna() & (df['ro']!=0) & (df['rr']!=0)).sum()))
print("\n--- describe ro rr fiso fisr ---")
print(df[['ro','rr','fiso','fisr','se_fiso','se_fisr','relative_es','no','nr','pub_year']].describe())
