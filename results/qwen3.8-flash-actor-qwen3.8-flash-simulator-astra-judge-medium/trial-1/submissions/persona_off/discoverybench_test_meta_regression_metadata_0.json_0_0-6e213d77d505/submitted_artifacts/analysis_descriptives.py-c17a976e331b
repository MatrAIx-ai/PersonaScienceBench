import pandas as pd, numpy as np
from scipy import stats
pd.set_option('display.width',250); pd.set_option('display.max_columns',80)
df=pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv', na_values=['NA',''])
df['abs_ratio']=df.rr.abs()/df.ro
df['D_raw']=df.ro-df.rr
df['D_z']=df.fiso-df.fisr
df['var_D']=df.se_fiso**2+df.se_fisr**2
df['smaller']= (df.rr.abs() < df.ro.abs()).astype(int)
df['neg_rr']= (df.rr<0).astype(int)
df['ratio']=df.rr/df.ro
def tab(g, by):
    rows=[]
    for k,s in g.groupby(by):
        rows.append(dict(group=k, n=len(s),
            mean_ro=s.ro.mean(), med_ro=s.ro.median(),
            mean_rr=s.rr.mean(), med_rr=s.rr.median(),
            mean_fiso=s.fiso.mean(), med_fiso=s.fiso.median(),
            mean_fisr=s.fisr.mean(), med_fisr=s.fisr.median(),
            mean_D_raw=s.D_raw.mean(), mean_D_z=s.D_z.mean(), med_D_z=s.D_z.median(),
            mean_rel=s.relative_es.mean(), med_rel=s.relative_es.median(),
            mean_absratio=s.abs_ratio.mean(), med_absratio=s.abs_ratio.median(),
            frac_smaller=s.smaller.mean(), frac_neg_rr=s.neg_rr.mean(),
            replicated=s.replicated.mean()))
    return pd.DataFrame(rows).round(3)
print("=== by project.y (rpp vs ee) ==="); print(tab(df,'project.y').to_string(index=False))
print("\n=== by discipline (Social/Cognitive/Economics) ==="); print(tab(df,'discipline').to_string(index=False))
print("\n=== overall ==="); print(tab(df.assign(all='ALL'),'all').to_string(index=False))

print("\n=== paired tests on Fisher-z (fiso vs fisr) ===")
for k,s in list(df.groupby('project.y'))+[('ALL',df)]:
    w=stats.wilcoxon(s.fiso, s.fisr, alternative='greater')
    t=stats.ttest_rel(s.fiso, s.fisr)
    print(f"{k:12s} n={len(s):3d} mean(fiso-fisr)={s.D_z.mean():.3f} paired t p={t.pvalue:.2e} wilcoxon p={w.pvalue:.2e}")
for k,s in list(df.groupby('discipline'))+[('ALL',df)]:
    w=stats.wilcoxon(s.fiso, s.fisr, alternative='greater')
    t=stats.ttest_rel(s.fiso, s.fisr)
    print(f"{k:12s} n={len(s):3d} mean(fiso-fisr)={s.D_z.mean():.3f} paired t p={t.pvalue:.2e} wilcoxon p={w.pvalue:.2e}")

print("\n=== binomial test on frac |rr|<|ro| (H0 p=0.5) ===")
for k,s in list(df.groupby('discipline'))+list(df.groupby('project.y'))+[('ALL',df)]:
    x=int(s.smaller.sum()); n=len(s)
    p=stats.binomtest(x,n,0.5,alternative='greater').pvalue
    print(f"{k:12s} {x}/{n} = {x/n:.3f}  binom p={p:.4f}")

print("\n=== fixed/random-effects pooled D_z (fiso-fisr) per group, w=1/(se_fiso^2+se_fisr^2) ===")
for k,s in list(df.groupby('discipline'))+list(df.groupby('project.y'))+[('ALL',df)]:
    w=1/s.var_D; mu_f=(w*s.D_z).sum()/w.sum(); Q=(w*(s.D_z-mu_f)**2).sum(); dfree=len(s)-1
    tau2=max(0,(Q-dfree)/(w.sum()-(w**2).sum()/w.sum())); wr=1/(s.var_D+tau2); mu_r=(wr*s.D_z).sum()/wr.sum()
    se=(1/wr.sum())**.5
    print(f"{k:12s} n={len(s):3d} FE={mu_f:.3f} (se {(1/w.sum())**.5:.3f}) RE={mu_r:.3f} (se {se:.3f}) Q={Q:.1f} df={dfree} tau2={tau2:.4f}")
print("\n=== relative_es by discipline: means excluding sign-reversed (rr<0) ===")
print(df[df.rr>0].groupby('discipline').relative_es.agg(['count','mean','median']).round(3))
print("\nmedian ratio |rr|/|ro| by discipline (rr>0 only):")
print(df[df.rr>0].groupby('discipline').abs_ratio.agg(['count','mean','median']).round(3))
print("\npub_year / n summary by discipline:\n", df.groupby('discipline')[['pub_year','no','nr']].median().round(1))
print("\npo<=0.05 fraction by discipline:", df.assign(sig=(df.po<=0.05)).groupby('discipline').sig.mean().round(3).to_dict())
df.to_csv('analysis/prepared_with_derived.csv', index=False)
