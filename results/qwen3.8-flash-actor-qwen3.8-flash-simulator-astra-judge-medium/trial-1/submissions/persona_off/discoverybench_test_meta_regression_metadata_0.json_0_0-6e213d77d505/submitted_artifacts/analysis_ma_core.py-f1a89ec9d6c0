"""Core machinery: loading, derived quantities, pooling, meta-regression, contrasts, jackknife."""
import numpy as np, pandas as pd
from scipy import stats, optimize
CSV = 'data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv'

def load(fix_artifact=False):
    df = pd.read_csv(CSV, na_values=['NA', ''])
    df['ratio'] = df.rr / df.ro
    df['abs_ratio'] = df.rr.abs() / df.ro.abs()
    df['relative_es_used'] = df.relative_es.copy()
    bad = (df.relative_es - df.ratio).abs() > 1e-6
    if fix_artifact:
        df.loc[bad, 'relative_es_used'] = df.loc[bad, 'ratio']
    df['artifact_flag'] = bad
    df['D_raw'] = df.ro - df.rr
    df['D_z'] = df.fiso - df.fisr
    df['v_D'] = df.se_fiso**2 + df.se_fisr**2
    df['se_D'] = np.sqrt(df.v_D)
    df['smaller'] = (df.rr.abs() < df.ro.abs()).astype(int)
    df['rev'] = (df.rr < 0).astype(int)
    return df

def dl_tau2(D, v):
    w = 1/v; mu = (w*D).sum()/w.sum(); Q = float((w*(D-mu)**2).sum()); k = len(D)
    c = w.sum() - (w**2).sum()/w.sum()
    return max(0.0, (Q-(k-1))/c), Q, k-1

def reml_tau2(D, v, X=None):
    D, v = np.asarray(D, float), np.asarray(v, float)
    X = np.ones((len(D), 1)) if X is None else np.asarray(X, float)
    def nll(lt):
        t2 = np.exp(lt); W = np.diag(1/(v+t2))
        XtWX = X.T @ W @ X
        try: XtWXi = np.linalg.inv(XtWX)
        except np.linalg.LinAlgError: return 1e10
        r = D - X @ (XtWXi @ X.T @ (W @ D))
        sign, ld = np.linalg.slogdet(XtWX)
        return 0.5*(np.sum(np.log(v+t2)) + ld + r @ (W @ r))
    res = optimize.minimize_scalar(nll, bounds=(-14, 2), method='bounded')
    return max(0.0, float(np.exp(res.x)))

def wls(D, v, X, tau2=0.0):
    v = np.asarray(v, float); D = np.asarray(D, float); X = np.asarray(X, float)
    W = np.diag(1/(v+tau2)); XtWXi = np.linalg.inv(X.T @ W @ X)
    b = XtWXi @ X.T @ (W @ D); se = np.sqrt(np.diag(XtWXi))
    resid = D - X @ b
    Qw = float(resid @ (resid/(v+tau2)))
    return b, se, Qw, X.shape[1]

def reml_pooled(D, v):
    t2 = reml_tau2(D, v); w = 1/(v+t2); return float((w*D).sum()/w.sum())

def group_stats(df, by, levels):
    rows = []
    for lvl in levels:
        s = df[df[by] == lvl]; D, v = s.D_z.values, s.v_D.values; k = len(s)
        mu, sd = D.mean(), D.std(ddof=1); tci = stats.t.ppf(.975, k-1)*sd/np.sqrt(k)
        t2dl, Q, dfree = dl_tau2(D, v); t2reml = reml_tau2(D, v)
        b_fe, se_fe, _, _ = wls(D, v, np.ones((k, 1)), 0.0)
        b_dl, se_dl, _, _ = wls(D, v, np.ones((k, 1)), t2dl)
        b_rm, se_rm, _, _ = wls(D, v, np.ones((k, 1)), t2reml)
        rel = s.relative_es_used.values
        rows.append(dict(group=lvl, n=k,
            mean_ro=s.ro.mean(), med_ro=s.ro.median(), mean_rr=s.rr.mean(), med_rr=s.rr.median(),
            mean_fiso=s.fiso.mean(), mean_fisr=s.fisr.mean(),
            mean_rel_es=rel.mean(), med_rel_es=float(np.median(rel)),
            mean_absratio=s.abs_ratio.mean(), med_absratio=s.abs_ratio.median(),
            frac_smaller=s.smaller.mean(), frac_rev=s.rev.mean(), replicated=s.replicated.mean(),
            Dz_unw=mu, Dz_unw_lo=mu-tci, Dz_unw_hi=mu+tci,
            Dz_fe=b_fe[0], Dz_fe_lo=b_fe[0]-1.96*se_fe[0], Dz_fe_hi=b_fe[0]+1.96*se_fe[0],
            Dz_dl=b_dl[0], Dz_dl_lo=b_dl[0]-1.96*se_dl[0], Dz_dl_hi=b_dl[0]+1.96*se_dl[0],
            Dz_reml=b_rm[0], Dz_reml_lo=b_rm[0]-1.96*se_rm[0], Dz_reml_hi=b_rm[0]+1.96*se_rm[0],
            tau2_dl=t2dl, tau2_reml=t2reml, Q=Q, df=dfree,
            I2=max(0.0, (Q-dfree)/Q) if Q > 0 else np.nan,
            med_no=s.no.median(), med_nr=s.nr.median(), med_year=s.pub_year.median(),
            n_po05=int((s.po <= .05).sum())))
    return pd.DataFrame(rows)

def metareg(df, by, ref):
    lv = [ref] + sorted([l for l in df[by].unique() if l != ref])
    X = np.column_stack([(df[by] == l).astype(float) for l in lv])
    D, v = df.D_z.values, df.v_D.values; k = len(D)
    b, se, Qw, p = wls(D, v, X, 0.0)
    Qred = wls(D, v, np.ones((k, 1)), 0.0)[2]
    Qbet = Qred - Qw; dfbet = X.shape[1]-1
    t2 = reml_tau2(D, v, X)
    br, ser, Qwr, _ = wls(D, v, X, t2)
    Qred_re = wls(D, v, np.ones((k, 1)), t2)[2]
    Qbet_re = Qred_re - Qwr
    out = dict(levels=lv, tau2_reml=t2, fe={a: float(b_) for a, b_ in zip(lv, b)},
               fe_se={a: float(s_) for a, s_ in zip(lv, se)}, Q_within_fe=Qw, df_fe=k-X.shape[1],
               Q_between_fe=float(Qbet), df_between=dfbet, p_between_fe=float(stats.chi2.sf(Qbet, dfbet)),
               re={a: float(x) for a, x in zip(lv, br)}, re_se={a: float(x) for a, x in zip(lv, ser)},
               Q_within_re=Qwr, Q_between_re=float(Qbet_re),
               p_between_re=float(stats.chi2.sf(Qbet_re, dfbet)),
               I2_within_re=float(max(0.0, (Qwr-(k-X.shape[1]))/Qwr)),
    I2_residual_re=float(max(0.0, (Qwr-(k-X.shape[1]))/Qwr)),
    I2_total_fe=float(max(0.0, (Qred-(k-1))/Qred)), k=k)
    tab = pd.DataFrame({'group': lv, 'est_fe': b, 'se_fe': se, 'lo_fe': b-1.96*se, 'hi_fe': b+1.96*se,
                        'est_re': br, 'se_re': ser, 'lo_re': br-1.96*ser, 'hi_re': br+1.96*ser})
    return out, tab

def contrast(df, by, a, b_, use_re=True):
    D, v = df.D_z.values, df.v_D.values
    t2 = reml_tau2(D, v) if use_re else 0.0
    w = 1/(v+t2); A = (df[by].values == a); B = (df[by].values == b_)
    ma = (w[A]*D[A]).sum()/w[A].sum(); mb = (w[B]*D[B]).sum()/w[B].sum()
    se = float(np.sqrt(1/w[A].sum() + 1/w[B].sum())); est = float(ma-mb)
    uw = float(D[A].mean()-D[B].mean())
    tt = stats.ttest_ind(D[A], D[B], equal_var=False)
    mw = stats.mannwhitneyu(D[A], D[B], alternative='two-sided')
    relA = df.loc[A, 'relative_es_used'].values; relB = df.loc[B, 'relative_es_used'].values
    relmw = stats.mannwhitneyu(relA, relB, alternative='two-sided')
    return dict(diff_re=est, se_re=se, lo_re=est-1.96*se, hi_re=est+1.96*se, z=est/se,
                p_re=float(2*stats.norm.sf(abs(est/se))), diff_unw=uw, welch_p=float(tt.pvalue),
                mw_Dz_p=float(mw.pvalue), rel_diff=float(relA.mean()-relB.mean()),
                rel_mw_p=float(relmw.pvalue), nA=int(A.sum()), nB=int(B.sum()))

def jackknife_pooled(df, by, lvl):
    s = df[df[by] == lvl]; est = reml_pooled(s.D_z.values, s.v_D.values)
    pos = list(np.where(df[by].values == lvl)[0]); vals = []
    for i in pos:
        ss = df.drop(index=df.index[i]); ss = ss[ss[by] == lvl]
        vals.append(reml_pooled(ss.D_z.values, ss.v_D.values))
    vals = np.array(vals)
    return dict(level=lvl, est=est, loo_min=float(vals.min()), loo_max=float(vals.max()),
                loo_range=float(vals.max()-vals.min()),
                jack_se=float(np.sqrt((len(vals)-1)/len(vals)*((vals-vals.mean())**2).sum())),
                most_influential=df.iloc[pos[int(np.argmax(np.abs(vals-est)))]].study)

def jack_contrast(df, by, a, b_):
    full = contrast(df, by, a, b_)['diff_re']; vals = []
    pos = list(np.where((df[by].values == a) | (df[by].values == b_))[0])
    for i in pos:
        vals.append(contrast(df.drop(index=df.index[i]), by, a, b_)['diff_re'])
    vals = np.array(vals)
    return dict(contrast=f"{a} - {b_}", est=full, loo_min=float(vals.min()), loo_max=float(vals.max()),
                loo_range=float(vals.max()-vals.min()),
                most_influential=df.iloc[pos[int(np.argmax(np.abs(vals-full)))]]['study'])

def within_tests(s, rng, nperm=20000):
    D = s.D_z.values
    t = stats.ttest_rel(s.fiso, s.fisr, alternative='greater')
    w = stats.wilcoxon(s.fiso, s.fisr, alternative='greater')
    null = (D[:, None] * rng.choice([1, -1], size=(len(D), nperm))).sum(0)/len(D)
    bino = stats.binomtest(int(s.smaller.sum()), len(s), 0.5, alternative='greater')
    return dict(n=len(s), mean_Dz=float(D.mean()), t_p=float(t.pvalue), wilcoxon_p=float(w.pvalue),
                perm_p=float(((null >= D.mean()).sum()+1)/(nperm+1)),
                frac_smaller=float(s.smaller.mean()), binom_p=float(bino.pvalue))
