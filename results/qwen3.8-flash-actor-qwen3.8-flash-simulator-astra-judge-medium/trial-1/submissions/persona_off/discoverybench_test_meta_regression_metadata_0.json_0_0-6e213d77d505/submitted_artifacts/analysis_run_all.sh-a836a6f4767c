#!/usr/bin/env bash
# Full pipeline: audit -> stage1 (tables/meta-reg/contrasts/jackknife) -> stage2 (robustness/moderators/strata) -> stage3 (deliverables)
set -e
python3 analysis/data_audit.py        > analysis/log_audit.txt
python3 analysis/run_main.py          > analysis/log_stage1.txt
python3 analysis/run_stage2.py        > analysis/log_stage2.txt
python3 analysis/run_stage3.py        > analysis/log_stage3.txt
python3 analysis/run_bootstrap.py     > analysis/log_bootstrap.txt
python3 analysis/run_ee_diagnostic.py > analysis/log_ee_diag.txt
python3 analysis/run_finalize.py      > analysis/log_finalize.txt
echo "pipeline complete"
