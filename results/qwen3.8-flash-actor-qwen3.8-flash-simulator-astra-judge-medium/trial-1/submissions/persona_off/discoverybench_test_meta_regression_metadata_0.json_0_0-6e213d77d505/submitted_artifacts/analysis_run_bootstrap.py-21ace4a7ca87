"""Bootstrap CIs (20k resamples) for relative_es / D_z per domain and for domain gap contrasts."""
import sys; sys.path.insert(0, 'analysis')
import numpy as np, json, ma_core as M
rng = np.random.default_rng(7); df = M.load(); out = {}
print("Bootstrap CIs, per domain")
for by, lv in [('discipline', ['Social', 'Cognitive', 'Economics']), ('project.y', ['rpp', 'ee'])]:
    for g in lv:
        s = df[df[by] == g]; rel = s.relative_es_used.values; Dz = s.D_z.values
        bm = np.array([rel[i].mean() for i in rng.integers(0, len(rel), (20000, len(rel)))])
        bme = np.array([np.median(rel[i]) for i in rng.integers(0, len(rel), (20000, len(rel)))])
        bd = np.array([Dz[i].mean() for i in rng.integers(0, len(Dz), (20000, len(Dz)))])
        out[f'{by}={g}'] = dict(n=len(s),
            mean_rel=[float(rel.mean()), float(np.percentile(bm, 2.5)), float(np.percentile(bm, 97.5))],
            med_rel=[float(np.median(rel)), float(np.percentile(bme, 2.5)), float(np.percentile(bme, 97.5))],
            mean_Dz=[float(Dz.mean()), float(np.percentile(bd, 2.5)), float(np.percentile(bd, 97.5))])
        o = out[f'{by}={g}']
        print(f"  {by}={g:10s} n={o['n']:2d} mean rel={o['mean_rel'][0]:.3f} [{o['mean_rel'][1]:.3f},{o['mean_rel'][2]:.3f}]"
              f"  med rel={o['med_rel'][0]:.3f} [{o['med_rel'][1]:.3f},{o['med_rel'][2]:.3f}]"
              f"  mean Dz={o['mean_Dz'][0]:.3f} [{o['mean_Dz'][1]:.3f},{o['mean_Dz'][2]:.3f}]")
boot = {}
for by, a, b_ in [('discipline','Social','Cognitive'), ('discipline','Social','Economics'),
                  ('discipline','Cognitive','Economics'), ('project.y','rpp','ee')]:
    A = df.loc[df[by] == a, 'relative_es_used'].values; B = df.loc[df[by] == b_, 'relative_es_used'].values
    d = np.array([A[i].mean()-B[j].mean() for i, j in zip(rng.integers(0, len(A), (20000, len(A))),
                                                           rng.integers(0, len(B), (20000, len(B))))])
    boot[f'{a}-{b_}'] = dict(diff=float(A.mean()-B.mean()), lo=float(np.percentile(d, 2.5)),
                             hi=float(np.percentile(d, 97.5)),
                             p=float(2*min((d > 0).mean(), (d < 0).mean())))
    o = boot[f'{a}-{b_}']
    print(f"  relative_es diff {a}-{b_}: {o['diff']:+.3f} [{o['lo']:+.3f},{o['hi']:+.3f}] boot p={o['p']:.4f}")
json.dump(dict(boot=out, contrast_boot=boot), open('analysis/results_bootstrap.json', 'w'), indent=1)
print("wrote analysis/results_bootstrap.json")
