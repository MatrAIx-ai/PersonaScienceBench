"""Headline diagnostic: why the ee fixed-effect pooled D_z collapses to ~0.013 (n=18)."""
import sys; sys.path.insert(0, 'analysis')
import numpy as np, pandas as pd, ma_core as M
pd.set_option('display.width', 250)
df = M.load(); ee = df[df['project.y'] == 'ee'].copy()
ee['w_fe'] = 1/ee.v_D; ee['w_fe_pct'] = 100*ee.w_fe/ee.w_fe.sum()
t2 = M.dl_tau2(ee.D_z.values, ee.v_D.values)[0]; ee['w_dl'] = 1/(ee.v_D+t2)
ee['w_dl_pct'] = 100*ee.w_dl/ee.w_dl.sum()
print(ee[['study', 'ro', 'rr', 'no', 'nr', 'D_z', 'v_D', 'w_fe_pct', 'w_dl_pct', 'relative_es']]
      .sort_values('w_fe_pct', ascending=False).head(8).round(3).to_string(index=False))
print("\nee: FE-pooled=%.3f RE(DL)-pooled=%.3f unweighted mean=%.3f median=%.3f" % (
    np.average(ee.D_z, weights=ee.w_fe), np.average(ee.D_z, weights=ee.w_dl), ee.D_z.mean(), ee.D_z.median()))
top = ee.nlargest(3, 'w_fe_pct')
print("top-3 FE weight share=%.1f%% (their mean D_z=%.3f); de Clippel alone=%.1f%%" % (
    top.w_fe_pct.sum(), top.D_z.mean(), ee.w_fe_pct.max()))
print("ee studies with D_z<0.05: %d/%d holding %.1f%% of FE weight" % ((ee.D_z < .05).sum(), len(ee), ee[ee.D_z < .05].w_fe_pct.sum()))
rpp = df[df['project.y'] == 'rpp']; wr = 1/rpp.v_D
print("comparison rpp top-3 weight share=%.1f%%" % (100*wr.nlargest(3).sum()/wr.sum()))
for lvl in ['Social', 'Cognitive']:
    s = df[df.discipline == lvl]; w = 1/s.v_D
    print(f"{lvl}: FE={np.average(s.D_z, weights=w):.3f} unw={s.D_z.mean():.3f} top3 share={100*w.nlargest(3).sum()/w.sum():.1f}%")
