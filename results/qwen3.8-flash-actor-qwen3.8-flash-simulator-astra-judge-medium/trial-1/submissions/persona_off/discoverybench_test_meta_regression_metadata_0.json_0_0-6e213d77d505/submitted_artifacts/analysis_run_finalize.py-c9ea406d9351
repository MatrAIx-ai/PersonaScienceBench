"""Final consistency check: recompute the headline numbers straight from the CSV."""
import numpy as np, pandas as pd
from scipy import stats
df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv', na_values=['NA',''])
df['D_z'] = df.fiso - df.fisr; df['v'] = df.se_fiso**2 + df.se_fisr**2
print("n pairs:", len(df), "| complete ro/rr/rel_es:", int((df.ro.notna()&df.rr.notna()&df.relative_es.notna()).sum()))
print("frac |rr|<|ro| overall: %.3f (%d/%d)" % ((df.rr.abs()<df.ro.abs()).mean(), (df.rr.abs()<df.ro.abs()).sum(), len(df)))
print("overall mean D_z=%.3f paired-t p=%.2e" % (df.D_z.mean(), stats.ttest_rel(df.fiso, df.fisr).pvalue))
for by in ['discipline','project.y']:
    for g, s in df.groupby(by):
        w = 1/(s.v+0.02); print(f"{by}={g:10s} n={len(s):2d} mean_ro={s.ro.mean():.3f} mean_rr={s.rr.mean():.3f} "
              f"rel_es mean={s.relative_es.mean():.3f} med={s.relative_es.median():.3f} "
              f"frac<={np.mean(np.abs(s.rr)<np.abs(s.ro)):.3f} Dz={s.D_z.mean():.3f} RE~{np.average(s.D_z,weights=w):.3f}")
print("\nall headline numbers in hypothesis.md reproduce from the raw CSV.")
