"""Main analysis driver: domains where original ES > replication ES."""
import sys, json; sys.path.insert(0, 'analysis')
import numpy as np, pandas as pd
from scipy import stats
import ma_core as M
pd.set_option('display.width', 260); pd.set_option('display.max_columns', 90)
RNG = np.random.default_rng(20261023); OUT = {}
GROUPS = [('discipline', ['Social', 'Cognitive', 'Economics']), ('project.y', ['rpp', 'ee'])]
print("="*110); print("MAIN ANALYSIS: original vs replication effect sizes by domain (n=86 pairs)"); print("="*110)

df = M.load(); df_fix = M.load(fix_artifact=True)
art = df[df.artifact_flag]
print(f"\n[A] stored relative_es != rr/ro in {len(art)} row(s) -> recomputed in variant H2")
print(art[['study','project.y','discipline','ro','rr','relative_es','ratio']].round(4).to_string(index=False))
OUT['artifact'] = dict(n=int(len(art)), studies=list(art.study),
    values={r.study: dict(stored=float(r.relative_es), recomputed=float(r.ratio)) for r in art.itertuples()})

print("\n[B] PER-DOMAIN TABLE")
tables = {}
for by, lv in GROUPS:
    t = M.group_stats(df, by, lv); tables[by] = t
    print(f"\n--- by {by} ---")
    print(t[['group','n','mean_ro','med_ro','mean_rr','med_rr','mean_rel_es','med_rel_es','mean_absratio',
             'med_absratio','frac_smaller','frac_rev','replicated','n_po05','med_no','med_nr','med_year']].round(3).to_string(index=False))
    print(t[['group','n','Dz_unw','Dz_unw_lo','Dz_unw_hi','Dz_fe','Dz_fe_lo','Dz_fe_hi','Dz_dl','Dz_dl_lo',
             'Dz_dl_hi','Dz_reml','Dz_reml_lo','Dz_reml_hi','tau2_dl','tau2_reml','Q','df','I2']].round(3).to_string(index=False))

print("\n[C] DOMAIN RANKING UNDER EACH FRAMING (1 = largest original>replication gap/shrinkage)")
for by, lv in GROUPS:
    t = M.group_stats(df, by, lv).set_index('group')
    R = pd.DataFrame({
      'Dz_unweighted_mean': t.Dz_unw, 'D_z RE(DL)': t.Dz_dl, 'D_z RE(REML)': t.Dz_reml,
      'D_z FE (inv-var)': t.Dz_fe, 'ro-rr on r scale': t.mean_ro-t.mean_rr, 'frac |rr|<|ro|': t.frac_smaller,
      '1-mean relative_es': 1-t.mean_rel_es, '1-median relative_es': 1-t.med_rel_es,
      '1-mean |rr|/|ro|': 1-t.mean_absratio, '1-median |rr|/|ro|': 1-t.med_absratio,
      'frac rr<0 reversal': t.frac_rev, '1-replication rate': 1-t.replicated})
    R = R.T   # rows = framing, cols = domain
    F = R.rank(axis=1, ascending=False).astype(int)   # rank DOMAINS within each framing (1 = biggest gap)
    F.index.name = 'framing'; print("\n"+F.to_string())
    print("  (values are group-level quantities)")
    print(R.round(3).to_string())
    OUT.setdefault('framing_ranks', {})[by] = dict(ranks={str(i): F.loc[i].to_dict() for i in F.index},
                                                   values={str(i): {str(c): float(R.loc[i, c]) for c in R.columns} for i in R.index})

print("\n[D] META-REGRESSION of D_z = fiso-fisr on domain, v_i = se_fiso^2+se_fisr^2")
regs = {}
for by, ref in [('discipline', 'Cognitive'), ('project.y', 'rpp')]:
    out, tab = M.metareg(df, by, ref); regs[by] = tab
    print(f"\n--- {by} (ref={ref}) ---"); print(tab.round(4).to_string(index=False))
    print(f"tau2_REML={out['tau2_reml']:.4f}  I2_within={out['I2_within_re']:.3f}  Q_within(RE)={out['Q_within_re']:.1f} df={out['df_fe']}")
    print(f"between-domain homogeneity: FE Q={out['Q_between_fe']:.2f} df={out['df_between']} p={out['p_between_fe']:.4f} "
          f"| RE Q={out['Q_between_re']:.2f} df={out['df_between']} p={out['p_between_re']:.4f}")
    OUT.setdefault('metareg', {})[by] = out

print("\n[E] PAIRWISE CONTRASTS (RE-weighted D_z diff; rel_es diff via Mann-Whitney)")
cons = {}
for lbl, by, a, b_ in [('Social-Cognitive','discipline','Social','Cognitive'),
                       ('Social-Economics','discipline','Social','Economics'),
                       ('Cognitive-Economics','discipline','Cognitive','Economics'),
                       ('rpp-ee','project.y','rpp','ee')]:
    c = M.contrast(df, by, a, b_); cons[lbl] = c
    print(f"{lbl:19s} D_z RE {c['diff_re']:+.3f} (se {c['se_re']:.3f}) 95%CI[{c['lo_re']:+.3f},{c['hi_re']:+.3f}] p={c['p_re']:.4f} "
          f"| unw {c['diff_unw']:+.3f} welchP={c['welch_p']:.4f} MW_P={c['mw_Dz_p']:.4f} "
          f"| rel_es {c['rel_diff']:+.3f} MWp={c['rel_mw_p']:.4f} (n {c['nA']}/{c['nB']})")
OUT['contrasts'] = cons

print("\n[F] WITHIN-DOMAIN: is original > replication at all?")
wt = {}
for by, lv in GROUPS + [('ALL', ['ALL'])]:
    for lvl in lv:
        s = df if by == 'ALL' else df[df[by] == lvl]
        r = M.within_tests(s, RNG); wt[f"{by}={lvl}"] = r
        print(f"{by+'='+lvl:>18s} n={r['n']:3d} meanD_z={r['mean_Dz']:.3f} pairedT p={r['t_p']:.2e} "
              f"wilcoxon p={r['wilcoxon_p']:.2e} signflip-perm p={r['perm_p']:.4f} "
              f"frac|rr|<|ro|={r['frac_smaller']:.3f} binomP={r['binom_p']:.5f}")
OUT['within_tests'] = wt

print("\n[G] JACKKNIFE / LEAVE-ONE-OUT (RE pooled D_z)")
jk = {}
for by, lv in GROUPS:
    for lvl in lv:
        j = M.jackknife_pooled(df, by, lvl); jk[f"pooled:{by}={lvl}"] = j
        print(f"pooled {by+'='+lvl:>17s} est={j['est']:+.3f} LOO[{j['loo_min']:+.3f},{j['loo_max']:+.3f}] "
              f"width={j['loo_range']:.3f} jackSE={j['jack_se']:.3f} most-influential={j['most_influential'][:46]}")
for lbl, by, a, b_ in [('Social-Cognitive','discipline','Social','Cognitive'),
                       ('Social-Economics','discipline','Social','Economics'),
                       ('Cognitive-Economics','discipline','Cognitive','Economics'),
                       ('rpp-ee','project.y','rpp','ee')]:
    j = M.jack_contrast(df, by, a, b_); jk[f'contrast:{lbl}'] = j
    print(f"contrast {lbl:17s} est={j['est']:+.3f} LOO[{j['loo_min']:+.3f},{j['loo_max']:+.3f}] "
          f"width={j['loo_range']:.3f} most-influential={j['most_influential'][:46]}")
OUT['jackknife'] = jk
with open('analysis/_stage1.json','w') as f: json.dump(OUT, f, indent=1, default=str)
print("\n[stage 1 done -> analysis/_stage1.json]")
