"""Stage 2: robustness variants, exploratory moderators, confound stratification, outputs."""
import sys, json; sys.path.insert(0, 'analysis')
import numpy as np, pandas as pd
from scipy import stats
import ma_core as M
pd.set_option('display.width', 300); pd.set_option('display.max_columns', 90)
OUT = json.load(open('analysis/_stage1.json'))
df = M.load(); df_fix = M.load(fix_artifact=True)
GROUPS = [('discipline', ['Social', 'Cognitive', 'Economics']), ('project.y', ['rpp', 'ee'])]

def summarize(d, by, lvl):
    s = d[d[by] == lvl]; rel = s.relative_es_used.values
    D, v = s.D_z.values, s.v_D.values
    return dict(group=lvl, n=len(s), mean_ro=s.ro.mean(), mean_rr=s.rr.mean(),
                mean_rel_es=rel.mean(), med_rel_es=float(np.median(rel)),
                mean_absratio=s.abs_ratio.mean(), Dz_unw=s.D_z.mean(),
                Dz_re=M.reml_pooled(D, v), frac_smaller=s.smaller.mean(), frac_rev=s.rev.mean(),
                replicated=s.replicated.mean())

print("="*110); print("[H] ROBUSTNESS VARIANTS"); print("="*110)
# H5: floor replication r at 0 (censor sign reversals) -> recompute on that scale
d5 = df.copy(); d5['rr'] = d5.rr.clip(lower=0); d5['fisr'] = np.arctanh(d5.rr.clip(-0.999999, 0.999999))
d5['D_z'] = d5.fiso - d5.fisr; d5['v_D'] = d5.se_fiso**2 + d5.se_fisr**2
d5['abs_ratio'] = d5.rr.abs()/d5.ro.abs(); d5['ratio'] = d5.rr/d5.ro
d5['relative_es_used'] = d5.ratio; d5['smaller'] = (d5.rr.abs() < d5.ro.abs()).astype(int)
d5['rev'] = (d5.rr < 0).astype(int)
variants = {'H1 full sample (relative_es as stored)': df,
            'H2 artifact row recomputed (Eitam -> +0.472)': df_fix,
            'H3 originally significant only (po<=0.05)': df[df.po <= .05],
            'H4 excluding sign-reversed pairs (rr>0)': df[df.rr > 0],
            'H5 replication r floored at 0 (censored)': d5}
rows = []
for name, d in variants.items():
    for by, lv in GROUPS:
        for lvl in lv:
            rows.append(dict(variant=name, by=by, **summarize(d, by, lvl)))
V = pd.DataFrame(rows)
for by, lv in GROUPS:
    print(f"\n--- {by} ---")
    sub = V[V.by == by]
    print(sub.pivot_table(index='variant', columns='group',
          values=['mean_rel_es', 'med_rel_es', 'mean_absratio', 'Dz_unw', 'Dz_re'], aggfunc='first').round(3).to_string())
    print("  ranking (1=largest gap) per variant:")
    for m in ['mean_rel_es', 'med_rel_es', 'Dz_unw', 'Dz_re']:
        rk = {}
        for vn, g in sub.groupby('variant'):
            ser = g.set_index('group')[m]
            sgn = -1 if m.startswith('mean_rel') or m.startswith('med_rel') or m == 'mean_absratio' else 1
            rk[vn[:42]] = (sgn*ser).rank(ascending=False).astype(int).to_dict()
        print(f"   metric={m}"); print(pd.DataFrame(rk).T.to_string())
V.to_csv('analysis/results_robustness_variants.csv', index=False)
OUT['variants'] = V.round(4).to_dict(orient='records')
print("\nH1 vs H2 detail (only the artifact row can differ; Social only):")
c = V[V.variant.str.startswith(('H1', 'H2'))]
print(c[c.group == 'Social'][['variant', 'mean_rel_es', 'med_rel_es']].round(4).to_string(index=False))
print("stored Social mean_rel_es=%.4f ; recomputed=%.4f ; rank unchanged: %s" % (
    c[c.variant.str.startswith('H1')].mean_rel_es.iloc[0], c[c.variant.str.startswith('H2')].mean_rel_es.iloc[0],
    abs(c[c.variant.str.startswith('H1')].mean_rel_es.iloc[0] - c[c.variant.str.startswith('H2')].mean_rel_es.iloc[0]) < 0.05))

print("\n" + "="*110); print("[I] EXPLORATORY MODERATORS (pre-specified, clearly labelled exploratory)"); print("="*110)
X1 = np.column_stack([(df.discipline == 'Social').astype(float), (df.discipline == 'Economics').astype(float),
                      df.se_fiso, (df.pub_year - 2008), np.log(df.nr) - np.log(60)])
n1 = ['domain Social (vs Cog)', 'domain Economics (vs Cog)', 'se_fiso (orig imprecision)', 'pub_year-2008', 'log(replication n)-log60']
t21 = M.reml_tau2(df.D_z.values, df.v_D.values, X1)
b1, s1, _, _ = M.wls(df.D_z.values, df.v_D.values, X1, t21)
print(f"\nModel 1 (domain + precision + era + replication N), tau2={t21:.4f}")
for n_, b_, s_ in zip(n1, b1, s1):
    print(f"  {n_:32s} b={b_:+.4f} se={s_:.4f} z={b_/s_:+.2f} p={2*stats.norm.sf(abs(b_/s_)):.4f}")
X2 = np.column_stack([(df.discipline == 'Social').astype(float), (df.discipline == 'Economics').astype(float),
                      df.fiso, df.fiso*(df.discipline == 'Social'), df.fiso*(df.discipline == 'Economics')])
n2 = ['Social', 'Economics', 'fiso (original ES)', 'fiso x Social', 'fiso x Economics']
t22 = M.reml_tau2(df.D_z.values, df.v_D.values, X2)
b2, s2, _, _ = M.wls(df.D_z.values, df.v_D.values, X2, t22)
print(f"\nModel 2 (domain x original effect size), tau2={t22:.4f}")
for n_, b_, s_ in zip(n2, b2, s2):
    print(f"  {n_:32s} b={b_:+.4f} se={s_:.4f} z={b_/s_:+.2f} p={2*stats.norm.sf(abs(b_/s_)):.4f}")
# Model 3: does original ES explain the ee gap? (ee has larger replication N -> less noise, real shrinkage smaller)
X3 = np.column_stack([np.ones(len(df)), (df.discipline == 'Social').astype(float),
                      (df.discipline == 'Economics').astype(float), df.fiso])
t23 = M.reml_tau2(df.D_z.values, df.v_D.values, X3)
b3, s3, _, _ = M.wls(df.D_z.values, df.v_D.values, X3, t23)
print(f"\nModel 3 (domain + original ES, random slopes disabled), tau2={t23:.4f}")
for n_, b_, s_ in zip(['intercept', 'Social', 'Economics', 'fiso'], b3, s3):
    print(f"  {n_:32s} b={b_:+.4f} se={s_:.4f} p={2*stats.norm.sf(abs(b_/s_)):.4f}")
OUT['exploratory_moderators'] = dict(
    model1=dict(tau2=float(t21), terms={n_: dict(b=float(b_), se=float(s_), p=float(2*stats.norm.sf(abs(b_/s_)))) for n_, b_, s_ in zip(n1, b1, s1)}),
    model2=dict(tau2=float(t22), terms={n_: dict(b=float(b_), se=float(s_), p=float(2*stats.norm.sf(abs(b_/s_)))) for n_, b_, s_ in zip(n2, b2, s2)}),
    model3=dict(tau2=float(t23), terms={n_: dict(b=float(b_), se=float(s_), p=float(2*stats.norm.sf(abs(b_/s_)))) for n_, b_, s_ in zip(['intercept','Social','Economics','fiso'], b3, s3)}))

print("\n" + "="*110); print("[J] ERA / SIZE STRATIFICATION (does Social-vs-Cognitive hold within strata?)"); print("="*110)
d2 = df.copy(); d2['era'] = np.where(d2.pub_year >= 2011, '2011+', '2008-2010')
for c_, src in [('ro_t', 'ro'), ('no_t', 'no'), ('nr_t', 'nr')]:
    d2[c_] = pd.qcut(d2[src], 3, labels=['small', 'mid', 'large'])
sub = d2[d2.discipline.isin(['Social', 'Cognitive'])]
for strat in ['era', 'ro_t', 'no_t', 'nr_t']:
    g = sub.groupby([strat, 'discipline']).agg(n=('D_z', 'size'), mean_Dz=('D_z', 'mean'), mean_rel=('relative_es', 'mean')).round(3)
    piv = g['mean_rel'].unstack()
    piv['Social_minus_Cognitive'] = (piv['Social'] - piv['Cognitive']).round(3)
    print(f"\n-- stratified by {strat}: mean relative_es (and mean D_z) by discipline")
    print(g.to_string()); print(piv.round(3).to_string())
    OUT.setdefault('stratified', {})[strat] = dict(table=g.reset_index().round(4).to_dict(orient='records'),
                                                   rel_diff=piv['Social_minus_Cognitive'].round(4).to_dict())
json.dump(OUT, open('analysis/_stage2.json', 'w'), indent=1, default=str)
print("\n[stage 2 done -> analysis/_stage2.json, results_robustness_variants.csv]")
