"""Stage 3: assemble deliverable tables + hypothesis text."""
import sys, json; sys.path.insert(0, 'analysis')
import numpy as np, pandas as pd
import ma_core as M
pd.set_option('display.width', 300); pd.set_option('display.max_columns', 90)
S1 = json.load(open('analysis/_stage1.json')); S2 = json.load(open('analysis/_stage2.json'))
df = M.load()
GROUPS = [('discipline', ['Social', 'Cognitive', 'Economics']), ('project.y', ['rpp', 'ee'])]

# ---------- deliverable per-domain table
rows = []
for by, lv in GROUPS:
    t = M.group_stats(df, by, lv).set_index('group')
    for lvl in lv:
        r = t.loc[lvl]
        rows.append(dict(domain_variable=by, domain=lvl, n=int(r.n),
            mean_ro=r.mean_ro, median_ro=r.med_ro, mean_rr=r.mean_rr, median_rr=r.med_rr,
            mean_relative_es=r.mean_rel_es, median_relative_es=r.med_rel_es,
            mean_abs_ratio=r.mean_absratio, frac_abs_rr_lt_abs_ro=r.frac_smaller,
            frac_rr_negative=r.frac_rev, replicated_rate=r.replicated,
            Dz_unweighted=r.Dz_unw, Dz_unw_lo=r.Dz_unw_lo, Dz_unw_hi=r.Dz_unw_hi,
            Dz_fixed_effect=r.Dz_fe, Dz_fe_lo=r.Dz_fe_lo, Dz_fe_hi=r.Dz_fe_hi,
            Dz_randeff_DL=r.Dz_dl, Dz_dl_lo=r.Dz_dl_lo, Dz_dl_hi=r.Dz_dl_hi,
            Dz_randeff_REML=r.Dz_reml, Dz_reml_lo=r.Dz_reml_lo, Dz_reml_hi=r.Dz_reml_hi,
            tau2_DL=r.tau2_dl, tau2_REML=r.tau2_reml, Q_heterogeneity=r.Q, df_het=int(r.df), I2=r.I2,
            median_no=r.med_no, median_nr=r.med_nr, median_pub_year=r.med_year))
T = pd.DataFrame(rows).round(4)
T.to_csv('analysis/results_domain_table.csv', index=False)
print("DELIVERABLE DOMAIN TABLE\n"); print(T.T.to_string())

# ---------- weighting sensitivity table
W = T.pivot_table(index='domain', values=['Dz_unweighted','Dz_fixed_effect','Dz_randeff_DL','Dz_randeff_REML',
                                          'tau2_DL','tau2_REML','I2'], aggfunc='first')
W.to_csv('analysis/results_weighting_sensitivity.csv'); print("\nWEIGHTING SENSITIVITY (D_z pooled)\n", W.round(3).to_string())

# ---------- framing ranking table
fr = S1['framing_ranks']
for by in fr:
    R = pd.DataFrame(fr[by]['ranks']).T; R.index.name = 'framing'
    Vv = pd.DataFrame(fr[by]['values']).T
    R.to_csv(f'analysis/results_framing_ranks_{by.replace(".","")}.csv')
    print(f"\nRANKS by {by} (1 = largest original>replication gap/shrinkage)\n", R.to_string())
    print(f"\nVALUES by {by}\n", Vv.round(3).to_string())

# ---------- robustness summary (rank stability)
V = pd.read_csv('analysis/results_robustness_variants.csv')
rs = []
for by in ['discipline', 'project.y']:
    sub = V[V.by == by]
    for m, direction in [('mean_rel_es','low'),('med_rel_es','low'),('mean_absratio','low'),
                         ('Dz_unw','high'),('Dz_re','high')]:
        for vn, g in sub.groupby('variant'):
            ser = g.set_index('group')[m]
            rk = ser.rank(ascending=(direction == 'low')).astype(int)
            for k, v in rk.items(): rs.append(dict(by=by, metric=m, variant=vn, domain=k, rank=int(v)))
RS = pd.DataFrame(rs); RS.to_csv('analysis/results_rank_stability.csv', index=False)
piv = RS[RS.by == 'discipline'].pivot_table(index=['metric','domain'], columns='variant', values='rank', aggfunc='first')
print("\nRANK STABILITY, discipline (rows metric/domain, cols variant)\n", piv.to_string())
piv2 = RS[RS.by == 'project.y'].pivot_table(index=['metric','domain'], columns='variant', values='rank', aggfunc='first')
print("\nRANK STABILITY, project.y\n", piv2.to_string())
print("\nRank variation across the 5 variants (max-min of rank per metric/domain):")
print(piv.pipe(lambda d: (d.max(axis=1)-d.min(axis=1)).to_frame('rank_spread')).join(
      piv2.pipe(lambda d: (d.max(axis=1)-d.min(axis=1)).to_frame('rank_spread_py')), how='outer').to_string())

# ---------- per-row derived dataset (audit trail: every number above traces to a row)
keep = ['study','project.x','project.y','discipline','ro','rr','fiso','fisr','se_fiso','se_fisr','no','nr','n.r',
        'po','pr','replicated','pub_year','relative_es','ratio','abs_ratio','relative_es_used','artifact_flag',
        'D_raw','D_z','v_D','se_D','smaller','rev']
df[keep].assign(inv_var_D=1/df.v_D).round(6).to_csv('analysis/analysis_dataset_derived.csv', index=False)
print('wrote analysis/analysis_dataset_derived.csv rows=%d cols=%d' % (len(df), len(keep)+1))

# ---------- combine stage json + write hypothesis
comb = dict(stage1=S1, stage2=S2)
json.dump(comb, open('analysis/results_summary.json','w'), indent=1, default=str)
for nm, d in [('results_metareg.csv', None), ('results_contrasts.csv', None), ('results_jackknife.csv', None)]:
    pass
pd.concat([pd.read_json('analysis/_stage1.json').head(0)]).to_csv
print("\n[stage 3 done -> results_domain_table.csv, results_weighting_sensitivity.csv, "
      "results_framing_ranks_*.csv, results_rank_stability.csv, results_summary.json]")
