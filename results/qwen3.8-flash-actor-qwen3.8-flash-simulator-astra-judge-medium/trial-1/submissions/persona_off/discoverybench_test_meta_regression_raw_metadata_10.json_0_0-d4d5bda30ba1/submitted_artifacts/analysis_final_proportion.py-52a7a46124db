"""
FINAL calculation for: "What is the proportion of junior professors in replicated
studies in Psychology?"

Headline (researcher directives):
  scope   = project == "rpp"  (documented dictionary: rpp = Psychology)
  field   = seniority.r       (most senior author of the REPLICATION team)
  junior  = {"Assistant", "Assistant Professor"}
  unit    = effect-type-level rpp rows (n = 97); drop==True rows retained
Everything else is reported as a labelled sensitivity.
"""
import pandas as pd, numpy as np

pd.set_option("display.width", 200); pd.set_option("display.max_columns", 30)
PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
JUNIOR      = ["Assistant", "Assistant Professor"]          # primary
JUNIOR_ASSOC= JUNIOR + ["Associate Professor"]              # sensitivity
JUNIOR_ALL  = JUNIOR_ASSOC + ["Researcher"]                 # "not a full professor"

d = pd.read_csv(PATH)
rpp = d[d.project == "rpp"].copy()
out = []
def P(*a):
    m = " ".join(str(x) for x in a); print(m); out.append(m)

def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k / n; den = 1 + z*z/n
    c = (p + z*z/(2*n)) / den
    h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n)) / den
    return (c - h, c + h)

def row(scope, sub, junior, col="seniority.r"):
    vals = sub if isinstance(sub, pd.Series) else sub[col]
    n = len(vals); k = int(vals.isin(junior).sum())
    lo, hi = wilson(k, n)
    return dict(scope=scope, n=n, n_junior=k, proportion=round(k/n, 4),
                pct=f"{100*k/n:.1f}%", wilson95=f"[{100*lo:.1f}%, {100*hi:.1f}%]")

P("=== HEADLINE ===")
head = row("HEADLINE: rpp all replication studies, seniority.r in {Assistant, Assistant Professor}",
           rpp, JUNIOR)
P(head)
k, n = head["n_junior"], head["n"]
P(f"-> {k}/{n} = {k/n:.4f} = {100*k/n:.1f}%")

P("\n=== FULL seniority.r DISTRIBUTION IN rpp ===")
dist = rpp["seniority.r"].value_counts().rename_axis("seniority.r").reset_index(name="n")
dist["pct_of_rpp"] = (100*dist.n/len(rpp)).round(1)
dist["in_primary_numerator"] = dist["seniority.r"].isin(JUNIOR)
P(dist.to_string(index=False))

P("\n=== SENSITIVITIES ===")
sens = [
 row("denominator: unique original studies (title-level)",
     rpp.groupby("title")["seniority.r"].apply(lambda x: "Assistant" if x.isin(JUNIOR).any() else "other"), JUNIOR),
 row("denominator: drop==False only", rpp[~rpp["drop"]], JUNIOR),
 row("conditioned on success: replicated==1", rpp[rpp["replicated"] == 1], JUNIOR),
 row("conditioned on success & drop==False",
     rpp[(~rpp["drop"]) & (rpp["replicated"] == 1)], JUNIOR),
 row("conditioned on failure: replicated==0", rpp[rpp["replicated"] == 0], JUNIOR),
 row("junior threshold: + Associate Professor", rpp, JUNIOR_ASSOC),
 row("junior threshold: + Associate Professor + Researcher (any non-full-professor)", rpp, JUNIOR_ALL),
 row("full professors only (complement check)", rpp, ["Professor"]),
 row("field swap: seniority.o (original authors)", rpp, JUNIOR, "seniority.o"),
 row("scope: all psychology projects rpp+ml1+ml3 (coding artifact)",
     d[d.project.isin(["rpp", "ml1", "ml3"])], JUNIOR),
]
P(pd.DataFrame(sens).to_string(index=False))

P("\n=== SUPPORTING DIAGNOSTICS ===")
P("seniority.r NA in rpp:", int(rpp["seniority.r"].isna().sum()),
  "| rows:", len(rpp), "| unique ids:", rpp["id"].nunique(), "| unique titles:", rpp["title"].nunique())
P("seniority.o == seniority.r agreement in rpp:",
  round(float((rpp["seniority.o"] == rpp["seniority.r"]).mean()), 3))
xt = pd.crosstab(rpp["seniority.r"].isin(JUNIOR).map({True: "junior", False: "senior/other"}),
                 rpp["replicated"], margins=True)
P("junior vs replication success (does junior-ness track success?):\n", xt)
P("junior share among successful:",
  f"{int((rpp[rpp['replicated']==1]['seniority.r'].isin(JUNIOR)).sum())}/35",
  "| among failed:", f"{int((rpp[rpp['replicated']==0]['seniority.r'].isin(JUNIOR)).sum())}/62")
P("mean n_authors.r junior vs other:",
  round(rpp[rpp['seniority.r'].isin(JUNIOR)]['n_authors.r'].mean(), 2),
  "vs", round(rpp[~rpp['seniority.r'].isin(JUNIOR)]['n_authors.r'].mean(), 2))
P("ml1/ml3/ee seniority.r distinct values:",
  {p: sorted(d[d.project == p]["seniority.r"].unique()) for p in ["ml1", "ml3", "ee"]})
tab = pd.crosstab(rpp["seniority.r"].isin(JUNIOR), rpp["replicated"])
try:
    from scipy.stats import chi2_contingency, fisher_exact
    chi2, pv, dof, _ = chi2_contingency(tab)
    _, pf = fisher_exact(tab.values)
    P(f"junior x replicated: chi2={chi2:.3f} p={pv:.3f}; Fisher exact p={pf:.3f}")
except Exception as e:
    P("scipy unavailable:", e)

with open("analysis/final_report.txt", "w") as f:
    f.write("\n".join(out) + "\n")
