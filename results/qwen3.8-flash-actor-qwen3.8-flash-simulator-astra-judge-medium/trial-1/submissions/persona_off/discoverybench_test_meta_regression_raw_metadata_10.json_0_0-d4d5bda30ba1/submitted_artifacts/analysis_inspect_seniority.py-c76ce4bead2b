"""
Inspection pass for: "What is the proportion of junior professors in replicated
studies in Psychology?"
Reads the two staged CAMARI-style CSVs, documents row counts / distinct values /
missingness / duplicate structure, and tabulates every defensible operationalization
of (Psychology) x (replicated studies) x (junior professor) WITHOUT committing to one.
"""
import pandas as pd, numpy as np
pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 30)
pd.set_option("display.max_colwidth", 60)

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
SUCC  = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"
JUNIOR = ["Assistant", "Assistant Professor"]                    # non-tenured / junior faculty
JUNIOR_WIDE = JUNIOR + ["Associate Professor"]                   # "not a full professor"

d = pd.read_csv(STUDY)
s = pd.read_csv(SUCC)
out = []
def P(*a):
    msg = " ".join(str(x) for x in a); print(msg); out.append(msg)

P("=== FILES ===")
P(f"study_data rows={len(d)} cols={d.shape[1]}   replication_success rows={len(s)} cols={s.shape[1]}")
P("replication_success has NO seniority column ->", "seniority" not in "".join(s.columns))
P("replication_success project labels:", dict(s.project.value_counts()))

P("\n=== study_data structure ===")
d["base_id"] = d.id.str.replace(r"\..*", "", regex=True)
P(d.groupby("project").agg(rows=("id", "size"), unique_ids=("id", "nunique"),
                           replicated_NA=("replicated", lambda x: x.isna().sum()),
                           success_rate=("replicated", "mean")))
P("project x discipline:\n", pd.crosstab(d.project, d.discipline))
P("drop flag:", dict(d["drop"].value_counts(dropna=False)))
P("aggregated flag:", dict(d.aggregated.value_counts(dropna=False)))
P("lab_id missing:", int(d.lab_id.isna().sum()), "| unique lab_id:", d.lab_id.nunique())
P("fully duplicated rows:", int(d.duplicated().sum()))

P("\n=== seniority values (no missingness anywhere) ===")
for c in ["seniority.o", "seniority.r"]:
    P(f"{c}: {dict(d[c].value_counts(dropna=False))} | NA={int(d[c].isna().sum())}")
P("seniority.r by project:\n", pd.crosstab(d.project, d["seniority.r"]))
P("seniority.o by project:\n", pd.crosstab(d.project, d["seniority.o"]))
rpp = d[d.project == "rpp"].copy()
P("rpp: agreement seniority.o == seniority.r:",
  round(float((rpp["seniority.o"] == rpp["seniority.r"]).mean()), 3),
  "-> fields describe different people (orig vs replication team)")

P("\n=== RPP (=project label 'Psychology') detail ===")
P("rows:", len(rpp), "| unique id:", rpp["id"].nunique(), "| unique titles:", rpp["title"].nunique(),
  "(2 originals replicated on 2 effect types)")
P("replicated:", dict(rpp["replicated"].value_counts(dropna=False)))
P("seniority.r x replicated:\n", pd.crosstab(rpp["seniority.r"], rpp.replicated, margins=True))
P("seniority.o x replicated:\n", pd.crosstab(rpp["seniority.o"], rpp.replicated, margins=True))
P("drop==True inside rpp:", int((rpp["drop"]).sum()))
P("NA in rpp: p_value.r=%d effect_size.r=%d endprice=%d" % (
    rpp["p_value.r"].isna().sum(), rpp["effect_size.r"].isna().sum(), rpp["endprice"].isna().sum()))
sig = (rpp["p_value.r"] <= 0.05) & (np.sign(rpp["effect_size.r"]) == np.sign(rpp["effect_size.o"]))
P("rows matching documented replicated rule vs flag:", int(sig.sum()), "vs",
  int(rpp["replicated"].sum()), "| mismatches are the 2 rows lacking effect sizes (both drop=True)")

P("\n=== OPERATIONALIZATION SENSITIVITY TABLE (seniority.r = replication-team seniority) ===")
rows = []
def add(name, sub, junior, col="seniority.r"):
    sub = sub if isinstance(sub, pd.Series) else sub[col]
    n = len(sub); k = int(sub.isin(junior).sum())
    rows.append(dict(scope=name, n_rows=n, n_junior=k, proportion=round(k / n, 4) if n else np.nan))
add("rpp, all rows", rpp, JUNIOR)
add("rpp, all rows | junior incl. Associate", rpp, JUNIOR_WIDE)
add("rpp, replicated==1", rpp[rpp["replicated"] == 1], JUNIOR)
add("rpp, replicated==1 | junior incl. Associate", rpp[rpp["replicated"] == 1], JUNIOR_WIDE)
add("rpp, drop==False", rpp[~rpp["drop"]], JUNIOR)
add("rpp, drop==False & replicated==1", rpp[(~rpp["drop"]) & (rpp["replicated"] == 1)], JUNIOR)
add("rpp, unique original study (title)",
    rpp.groupby("title")["seniority.r"].apply(lambda x: "Assistant" if x.isin(JUNIOR).any() else "Professor"), JUNIOR)
add("rpp, seniority.o (original authors)", rpp, JUNIOR, "seniority.o")
psy = d[d.project.isin(["rpp", "ml1", "ml3"])]
add("all psych projects (rpp+ml1+ml3)", psy, JUNIOR)
add("all psych projects, replicated==1", psy[psy["replicated"] == 1], JUNIOR)
add("discipline != Economics", d[d.discipline != "Economics"], JUNIOR)
tab = pd.DataFrame(rows)
P(tab.to_string(index=False))

with open("analysis/inspection_summary.txt", "w") as f:
    f.write("\n".join(out) + "\n")
