"""Student-subject prevalence by domain, original vs replication studies.
File A only (meta-regression_study_data_heterogeneity_in_replication_projects.csv).
Headline unit: one row per O/R pair (`id`, n=141), using the aggregated==True roll-up
row for ml1/ml3; denominator = studies with non-missing subject coding.
Targets from the question: original 82.4% students, replication 80.9% students.
"""
import pandas as pd, re, json
pd.set_option('display.width', 250)

A = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
TO_O, TO_R = 82.4, 80.9
raw = pd.read_csv(A)

# ---------- 1. study-level frame (one row per id) ----------
agg = raw[raw['aggregated'] == True]
rest = raw[raw['aggregated'].isna()]
study = pd.concat([agg, rest], ignore_index=True)
assert study['id'].nunique() == len(study) == 141, study.shape

# ---------- 2. coarse field derived from journal / title ----------
JFIELD = {
 'The American Economic Review':'Economics','The Quarterly Journal of Economics':'Economics',
 'Public Opinion Quarterly':'Political science / public opinion',
 'In J. C. Payne (Ed.), The teaching of contemporary affairs: 21st yearbook of the National Council of Social Studies':'Political science / public opinion',
 'Cognition':'Cognitive psychology','Cognitive Psychology':'Cognitive psychology',
 'JEPLMC':'Cognitive psychology','Journal of Experimental Psychology: General':'Cognitive psychology',
 'Science':'General-science (Science/Nature)',
 'Psychological Science':'Multidisciplinary experimental psychology (Psychological Science)',
 'Judgment and Decision Making':'Judgment & decision making',
 'JPSP':'Social/personality psychology','Journal of Personality and Social Psychology':'Social/personality psychology',
 'Personality and Social Psychology Bulletin':'Social/personality psychology',
 'Journal of Experimental Social Psychology':'Social/personality psychology',
 'Social Psychology':'Social/personality psychology','The Journal of Social Psychology':'Social/personality psychology',
 'Personality and Individual Differences':'Social/personality psychology','PS':'Social/personality psychology',
}
study['field'] = study['journal'].map(JFIELD)
assert study['field'].notna().all()

# ---------- 3. generic percentage helper ----------
def shares(d, missing_as_nonstudent=False):
    vo, vr = d['subjects.o'], d['subjects.r']
    on, rn = vo.eq('students').sum(), vr.eq('students').sum()
    od = len(d) if missing_as_nonstudent else vo.notna().sum()
    rd = len(d) if missing_as_nonstudent else vr.notna().sum()
    po, pr = 100*on/od, 100*rn/rd
    return dict(n_studies=len(d), n_o=int(on), den_o=int(od), pct_o=round(po,2),
                n_r=int(rn), den_r=int(rd), pct_r=round(pr,2),
                dev_o=round(abs(po-TO_O),2), dev_r=round(abs(pr-TO_R),2),
                dev_total=round(abs(po-TO_O)+abs(pr-TO_R),2))

def table(df, by):
    return pd.DataFrame({k: shares(g) for k, g in df.groupby(by)}).T.sort_values('dev_total')

# ---------- 4. headline tables ----------
head_dis = table(study, 'discipline')
head_prj = table(study, 'project')
head_fld = table(study, 'field')
def label(t, defn, pre):
    t = t.copy(); t.insert(0, 'definition', defn); t.insert(1, 'category', [pre+str(i) for i in t.index]); return t
headline = pd.concat([label(head_dis,'discipline',''), label(head_prj,'project',''), label(head_fld,'journal-derived field','')]) \
           .sort_values('dev_total').reset_index(drop=True)

print("### HEADLINE (n=141 O/R pairs, aggregated roll-up for ml1/ml3, denominator = non-missing)")
print(headline.to_string())

# ---------- 5. sensitivities ----------
sens = {}
sens['headline (141 studies, missing excluded)']            = (study, 'discipline'), (study, 'project')
lab = raw
sens['lab-row level (927 rows)']                            = (lab, 'discipline'), (lab, 'project')
nonagg = raw[raw['aggregated'] != True]
sens['lab rows excl. aggregated rows (%d)' % len(nonagg)]   = (nonagg, 'discipline'), (nonagg, 'project')
nd = study[study['drop'] != True]
sens['drop==True studies excluded (%d)' % len(nd)]          = (nd, 'discipline'), (nd, 'project')

rows = []
for name, (a, b) in sens.items():
    for df, by in (a, b):
        t = table(df, by)
        for k, v in t.iterrows():
            rows.append(dict(convention=name, definition=('discipline' if by=='discipline' else 'project'),
                             category=k, **v.to_dict()))
# missing counted as non-student variant
for by in ['discipline','project']:
    t = pd.DataFrame({k: shares(g, missing_as_nonstudent=True) for k, g in study.groupby(by)}).T
    for k, v in t.iterrows():
        rows.append(dict(convention='missing coded as non-student (141 studies)',
                         definition=by, category=k, **v.to_dict()))
sens_tab = pd.DataFrame(rows)
print("\n### SENSITIVITY (pct_o / pct_r per convention)")
piv = sens_tab.pivot_table(index=['definition','category'], columns='convention',
                           values=['pct_o','pct_r'], dropna=False)
print(piv.round(2).to_string())

# ---------- 6. within-category detail for the best match ----------
soc = study[study['discipline'] == 'Social']
det_o = soc['subjects.o'].value_counts(dropna=False)
det_r = soc['subjects.r'].value_counts(dropna=False)
ct = pd.crosstab(soc['subjects.o'].fillna('(missing)'), soc['subjects.r'].fillna('(missing)'))
print("\n### DETAIL: Social discipline at study level (n=%d)" % len(soc))
print("subjects.o:", det_o.to_dict())
print("subjects.r:", det_r.to_dict())
print(ct.to_string())
print("\nSocial by project:")
print(table(soc, 'project').to_string())
print("\nOnline replications inside Social (subjects.r != students):")
print(soc[soc['subjects.r'].ne('students')][['id','project','journal','subjects.o','subjects.r','drop']].to_string(index=False))
print("\nOriginal non-student studies inside Social:")
print(soc[soc['subjects.o'].ne('students')][['id','project','journal','subjects.o','subjects.r','drop']].to_string(index=False))

# other categories' detail for the runner-up
rpp = study[study['project'] == 'rpp']
print("\n### DETAIL: rpp (n=%d) subjects.o %s ; subjects.r %s" % (len(rpp), rpp['subjects.o'].value_counts(dropna=False).to_dict(), rpp['subjects.r'].value_counts(dropna=False).to_dict()))

# ---------- 7. persist artifacts ----------
headline.to_csv('out/headline_categories.csv')
sens_tab.to_csv('out/sensitivity_table.csv', index=False)
soc.to_csv('out/social_discipline_studies.csv', index=False)
json.dump({'headline_top': headline.head(6).to_dict('index')}, open('out/summary.json','w'), indent=1)
print("\nwrote out/headline_categories.csv, out/sensitivity_table.csv, out/social_discipline_studies.csv")

# ---------- 8. deviation summary for the two leading categories across conventions ----------
print("\n### DEVIATION SUMMARY (|pct-target| summed) for leading categories")
summ = sens_tab[sens_tab['category'].isin(['Social','rpp','Cognitive'])][
    ['category','convention','definition','pct_o','pct_r','dev_total']].sort_values(['category','dev_total'])
print(summ.to_string(index=False))
print("\nBest convention per category:")
print(summ.loc[summ.groupby('category')['dev_total'].idxmin()].to_string(index=False))

pooled = shares(study)
print("\nPooled across all 141 studies: o %.2f%% r %.2f%% (for reference)" % (pooled['pct_o'], pooled['pct_r']))

# ---------- 9. exhaustive grouping check: can ANY category reproduce 82.4 / 80.9? ----------
import itertools
cats = ['project','discipline','journal','effect_type','drop','aggregated','online.o','online.r',
        'same_subjects','compensation.o','compensation.r','seniority.o','experiment_language.o',
        'us_lab.o','same_country','same_language','field']
bases = {'study_level': study, 'lab_rows': raw, 'lab_rows_nonagg': raw[raw['aggregated'] != True],
         'study_level_nodrop': study[study['drop'] != True]}
best = []
for bn, d0 in bases.items():
    for k in (1, 2):
        for ks in itertools.combinations([c for c in cats if c in d0.columns], k):
            for key, g in d0.groupby(list(ks), dropna=False):
                if len(g) < 8:
                    continue
                st = shares(g)
                best.append((st['dev_total'], bn, '+'.join(ks), str(key)[:40], st['n_studies'], st['pct_o'], st['pct_r']))
best.sort()
print("\n### Exhaustive 1-2 column grouping search (min group size 8): closest 8 categories")
for b in best[:8]:
    print("  dev=%6.2f  base=%-18s groups=%-32s value=%-38s n=%-4d o=%.2f%% r=%.2f%%" % b)
print("Exact-reproduction check: categories with dev_total < 0.5 ->",
      sum(1 for b in best if b[0] < 0.5), "; categories with dev_total < 1.0 ->",
      sum(1 for b in best if b[0] < 1.0))
pd.DataFrame(best, columns=['dev_total','base','grouping','value','n','pct_o','pct_r']).to_csv('out/exhaustive_grouping_search.csv', index=False)
print("wrote out/exhaustive_grouping_search.csv")

# ---------- 10. two extra conventions for the leading categories ----------
rows2 = []
ut = study.drop_duplicates('title')
for by in ['discipline','project']:
    t = pd.DataFrame({k: shares(g) for k, g in ut.groupby(by)}).T
    for k, v in t.iterrows():
        rows2.append(dict(convention='unique title (dedup 4 repeated titles, %d)' % len(ut), definition=by, category=k, **v.to_dict()))
# modal lab-level subject code instead of the aggregated roll-up
lab = raw[raw['aggregated'] != True]
modal = lab.groupby('id').agg(**{'subjects.o': ('subjects.o', lambda x: x.mode().iloc[0] if len(x.mode()) else None),
                                 'subjects.r': ('subjects.r', lambda x: x.mode().iloc[0] if len(x.mode()) else None)})
mm = study.drop(columns=['subjects.o','subjects.r']).merge(modal, on='id')
for by in ['discipline','project']:
    t = pd.DataFrame({k: shares(g) for k, g in mm.groupby(by)}).T
    for k, v in t.iterrows():
        rows2.append(dict(convention='modal lab-row subject code (not aggregated roll-up)', definition=by, category=k, **v.to_dict()))
extra = pd.DataFrame(rows2)
sens_all = pd.concat([sens_tab, extra], ignore_index=True)
sens_all.to_csv('out/sensitivity_table.csv', index=False)
print("\n### EXTRA CONVENTIONS")
print(extra.sort_values('dev_total').to_string(index=False))
lead = sens_all[sens_all['category'].isin(['Social','rpp','Cognitive','Social/personality psychology'])]
print("\n### RANGE of student shares for leading categories across ALL %d conventions" % sens_all['convention'].nunique())
print(lead.groupby('category').agg(conventions=('convention','nunique'),
      pct_o_min=('pct_o','min'), pct_o_max=('pct_o','max'),
      pct_r_min=('pct_r','min'), pct_r_max=('pct_r','max'),
      best_dev=('dev_total','min')).round(2).to_string())
print("\nBest-scoring convention for each leading category:")
print(lead.loc[lead.groupby('category')['dev_total'].idxmin()][['category','convention','pct_o','pct_r','dev_total']].to_string(index=False))
