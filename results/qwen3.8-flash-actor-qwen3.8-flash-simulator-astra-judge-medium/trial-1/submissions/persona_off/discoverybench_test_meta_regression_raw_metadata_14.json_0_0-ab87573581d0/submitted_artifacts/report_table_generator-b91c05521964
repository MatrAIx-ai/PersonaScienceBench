import pandas as pd
h = pd.read_csv('out/headline_categories.csv', index_col=0)
s = pd.read_csv('out/sensitivity_table.csv')
ex = pd.read_csv('out/exhaustive_grouping_search.csv')

def md(df, cols, fmt=None):
    d = df[cols].copy()
    for c in d.columns:
        if d[c].dtype.kind == 'f': d[c] = d[c].map(lambda v: f"{v:.2f}")
    hdr = '| ' + ' | '.join(d.columns) + ' |'; sep = '|' + '|'.join(['---']*len(d.columns)) + '|'
    rows = ['| ' + ' | '.join(str(v) for v in r) + ' |' for r in d.values]
    return '\n'.join([hdr, sep] + rows)

piv = s.pivot_table(index=['definition','category'], columns='convention', values=['pct_o','pct_r'], dropna=False)
conv = ['headline (141 studies, missing excluded)','missing coded as non-student (141 studies)',
        'lab-row level (927 rows)','lab rows excl. aggregated rows (901)','drop==True studies excluded (131)']
lines = []
lines.append('# Sensitivity of student-subject shares to analytic convention\n')
for c in conv:
    sub = s[s['convention'] == c][['definition','category','n_studies','n_o','den_o','pct_o','n_r','den_r','pct_r','dev_total']].sort_values('dev_total')
    lines.append(f'## {c}\n' + md(sub, ['definition','category','n_studies','n_o','den_o','pct_o','n_r','den_r','pct_r','dev_total']) + '\n')

best = ex[ex['dev_total'] < 1.5].head(8)
lines.append('## Exhaustive 1-2 column grouping search, closest hits (all non-domain artefacts)\n' +
             md(best, ['base','grouping','value','n','pct_o','pct_r','dev_total']) + '\n')

hl = h[['definition','category','n_studies','n_o','den_o','pct_o','n_r','den_r','pct_r','dev_o','dev_r','dev_total']]
lines.insert(1, '## Headline category table (n=141 O/R pairs)\n' + md(hl, list(hl.columns)) + '\n')
open('out/report_tables.md','w').write('\n'.join(lines))
print('\n'.join(lines[:14]))
print('\n--- wrote out/report_tables.md ---')
