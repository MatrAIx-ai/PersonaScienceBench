#!/usr/bin/env python3
"""
EE lab-setting proportion: primary estimate + definitional sensitivity + scoped file-2 cross-check.

Question: "What proportion of studies in Experimental Economics were conducted in a lab setting?"

Design (per approved plan):
  * Population      : project == 'ee' in the study-data file (18 O/R pairs).
  * Primary rule R1 : lab <=> online.o == 0  (original data collected NOT online).
  * Sensitivity R2  : online.o == 0 AND subjects.o == 'students'.
  * Sensitivity R3  : online.o == 0 AND online.r == 0.
  * R4 (us_lab.o==1) is a REJECTED / INVALID proxy diagnostic, reported in a
    separate section only; never combined with the headline.
  * File 2 is a count-and-scope confirmation only, never validation of setting;
    its n / p columns are excluded from inference.
Read-only: no external data, no network.
"""
import re
import pandas as pd

pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 40)
pd.set_option("display.max_colwidth", 52)

F1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
F2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

def hdr(t):
    print("\n" + "=" * 78)
    print(t)
    print("=" * 78)

df = pd.read_csv(F1)
print(f"file 1 loaded: {df.shape[0]} rows x {df.shape[1]} cols")
print("project labels:", df["project"].value_counts().to_dict())

ee = df[df["project"] == "ee"].copy()
N = len(ee)

hdr("1. POPULATION DEFINITION AND INTEGRITY CHECKS (project == 'ee')")
print(f"O/R pairs (rows)                      : {N}")
print(f"distinct ids                          : {ee['id'].nunique()}")
print(f"distinct original titles              : {ee['title'].nunique()}")
print(f"distinct original author strings      : {ee['authors.o'].nunique()}")
print("-> original : replication : pair ratio is 1 : 1 : 1")
print("\nrows excluded by bookkeeping columns:")
print(f"  aggregated == True : {(ee['aggregated'] == True).sum()}   (all NaN in ee: {ee['aggregated'].isna().all()})")
print(f"  drop       == True : {(ee['drop'] == True).sum()}")
print(f"  duplicate titles   : {ee['title'].duplicated().sum()}")
print(f"  duplicate (title, authors.o, pub_year): {ee.duplicated(['title','authors.o','pub_year']).sum()}")

disc_eq = (df["discipline"] == "Economics")
print("\nobservation (deliberately NOT used as a selector):")
print(f"  discipline=='Economics' rows overall      : {disc_eq.sum()}")
print(f"  ... of which outside project=='ee'        : {(disc_eq & (df['project'] != 'ee')).sum()}")
print(f"  all ee rows are discipline=='Economics'   : {(ee['discipline'] == 'Economics').all()}")
print("  -> coextensive here; population is fixed by project alone.")
print("\nids in scope:", sorted(ee["id"], key=lambda s: int(s.split('.')[1])))

hdr("2. SETTING PROXY INVENTORY WITHIN ee  (coverage AND variance)")
CANDS = ["online.o", "online.r", "same_online", "subjects.o", "subjects.r",
         "same_subjects", "compensation.o", "compensation.r",
         "experiment_country.o", "experiment_country.r",
         "us_lab.o", "us_lab.r", "lab_id", "discipline"]
rows = []
for c in CANDS:
    nonmiss = int(ee[c].notna().sum())
    nuniq = int(ee[c].nunique(dropna=True))
    dist = ee[c].value_counts(dropna=False).to_dict()
    dist = {("<NA>" if k is None or (isinstance(k, float) and pd.isna(k)) else str(k)): int(v)
            for k, v in dist.items()}
    rows.append({"column": c, "non_missing": f"{nonmiss}/{N}",
                 "cov%": round(100 * nonmiss / N, 1), "n_unique": nuniq,
                 "varies?": "NO  <-- degenerate" if nuniq <= 1 else "yes",
                 "distribution": dist})
cov = pd.DataFrame(rows)
print(cov.to_string(index=False))
print("\nreading of the table:")
print("  * coverage is NOT the binding constraint: every rule column is 100% populated except lab_id;")
print("  * the binding constraint is VARIANCE: online.o, online.r, same_online, subjects.r,")
print("    compensation.o/.r and discipline are constant across all 18 ee studies;")
print("  * lab_id is 0/18 populated -> unusable;")
print("  * only subjects.o (students/community) and geography (US vs non-US) actually vary.")

print("\nschema-vs-data contradictions verified BEFORE any rule was written:")
sub = df[df["online.o"].notna() & df["online.r"].notna()]
both_off = sub[(sub["online.o"] == 0) & (sub["online.r"] == 0)]
n_bo = len(both_off)
n_bo1 = int((both_off["same_online"] == 1).sum())
print(f"  (a) 'same_online' is documented as 'both conducted online', but {n_bo} rows with")
print(f"      online.o==0 AND online.r==0 all carry same_online==1 ({n_bo1}/{n_bo})")
print(f"      -> it actually encodes 'same online STATUS'. In ee it is 1 for all 18 only because")
print(f"         both sides are offline; a naive rule keying on it would invert the answer.")
mask = df["experiment_country.o"].notna() & df["us_lab.o"].notna()
agr = ((df["experiment_country.o"] == "United States").astype(int) == df["us_lab.o"])
n_ag = int(agr[mask].sum()); n_m = int(mask.sum())
us_online = int(((df["online.o"] == 1) & (df["us_lab.o"] == 1)).sum())
print(f"  (b) 'us_lab.o' is documented as a lab field, but agrees with")
print(f"      experiment_country.o=='United States' on {n_ag}/{n_m} rows (0 disagreements), and")
print(f"      {us_online} rows have online.o==1 yet us_lab.o==1 -> it is a US-location dummy,")
print(f"      not a lab indicator. Excluded from all three live rules.")

hdr("3. RULES APPLIED TO THE 18 ORIGINAL ee STUDIES")
ee["R1"] = (ee["online.o"] == 0)
ee["R2"] = (ee["online.o"] == 0) & (ee["subjects.o"] == "students")
ee["R3"] = (ee["online.o"] == 0) & (ee["online.r"] == 0)
ee["R4_rejected"] = (ee["us_lab.o"] == 1)

META = {
    "R1": "PRIMARY       online.o == 0",
    "R2": "SENSITIVITY   online.o == 0 AND subjects.o == 'students'",
    "R3": "SENSITIVITY   online.o == 0 AND online.r == 0",
}
out = []
key = lambda s: int(s.split(".")[1])
for r, defn in META.items():
    num = int(ee[r].sum())
    diff = sorted(set(ee.loc[ee["R1"], "id"]) ^ set(ee.loc[ee[r], "id"]), key=key)
    out.append({"rule": r, "definition": defn, "numerator": num, "denominator": N,
                "proportion": round(num / N, 4), "pct": f"{100 * num / N:.1f}%",
                "ids_differing_vs_R1": ", ".join(diff) if diff else "(none)"})
print(pd.DataFrame(out).to_string(index=False))

print("\nhinge of the 18/18 vs 17/18 difference, made explicit:")
for _, x in ee[ee["id"] == "ee.4"].iterrows():
    print(f"  ee.4  '{x['title']}'")
    print(f"        online.o={x['online.o']:.0f}  subjects.o='{x['subjects.o']}'  subjects.r='{x['subjects.r']}'  "
          f"compensation.o='{x['compensation.o']}'  country.o='{x['experiment_country.o']}'")
    print("        -> in person (passes R1) but a community pool, not a student pool (fails R2).")
    print("        -> R1 vs R2 disagreement = 1 study of 18 = 5.6 percentage points.")
print("  R3 == R1 exactly (online.r is 0 for all 18), so it adds no further separation.")

print("\nper-study rule assignment (auditable):")
show = ee.sort_values("id", key=lambda s: s.map(key))[
    ["id", "online.o", "online.r", "subjects.o", "compensation.o", "experiment_country.o",
     "us_lab.o", "R1", "R2", "R3"]]
print(show.to_string(index=False))

hdr("4. REJECTED PROXY / INVALID DIAGNOSTIC   (NOT AN ESTIMATE - DO NOT QUOTE)")
n4 = int(ee["R4_rejected"].sum())
print("The column name 'us_lab' invites the reading 'conducted in a lab'. That reading is wrong.")
print("Evidence that us_lab.* is a US-location dummy, not a setting indicator:")
print(f"  1. us_lab.o == (experiment_country.o == 'United States') on {n_ag}/{n_m} rows of the full")
print(f"     file, with ZERO disagreements. Within ee the {n4} us_lab.o==1 studies are exactly the")
print(f"     {n4} with experiment_country.o=='United States'; the {N - n4} us_lab.o==0 studies are")
non_us = ee.loc[~ee['R4_rejected'], 'experiment_country.o'].value_counts().to_dict()
print(f"     Australia, Austria, Germany x2, Switzerland x2, United Kingdom: {non_us}")
print(f"  2. {us_online} rows in the full file have online.o==1 AND us_lab.o==1, i.e. internet")
print(f"     experiments are coded us_lab==1 - impossible under a lab reading.")
print(f"  3. lab_id, the only genuine lab-identity field, is 0/18 populated in ee.")
print(f"\nMechanically us_lab.o==1 selects {n4}/{N} = {100 * n4 / N:.1f}%, but that quantity estimates the")
print("share of ee originals run in the United States, not the share run in labs.")
print("It is reported here only to demonstrate why the naive column-name reading must be")
print("rejected, and is excluded from the headline, from the rules table in section 3, and")
print("from the submitted hypothesis text.")

hdr("5. FILE 2 CROSS-CHECK   (COUNT AND SCOPE ONLY - NOT VALIDATION)")
s = pd.read_csv(F2)
print(f"file 2 loaded: {s.shape[0]} rows x {s.shape[1]} cols")
print("project labels:", s["project"].value_counts().to_dict())
print("\nlabel mapping used:  file2 'Experimental Economics'  <->  file1 'ee'")
print("the two files use different project vocabularies; codes are NOT interchangeable.")

KW = ["lab", "online", "subject", "compens", "country", "language", "setting", "student", "credit", "cash"]
setting_cols = [c for c in s.columns if any(k in c.lower() for k in KW)]
print(f"\nsetting-information scan of file 2 columns -> matches: {setting_cols if setting_cols else 'NONE'}")
print("  -> file 2 carries NO setting information; it can only confirm count and scope.")

ee2 = s[s["project"] == "Experimental Economics"].copy()
print(f"\nfile2 Experimental Economics rows : {len(ee2)}")
print(f"file1 project=='ee' pairs         : {N}")
print(f"count agreement                   : {'MATCH' if len(ee2) == N else 'MISMATCH'} ({len(ee2)} = {N})")
dups = s.loc[s["study"].duplicated(keep=False), "study"].unique().tolist()
print(f"file2 duplicate study labels      : {s['study'].duplicated().sum()} {dups} (project Psychology) -> outside ee")
print(f"file2 ee-subset missing values    : {int(ee2.isna().sum().sum())}")

def lead_surname(study):
    head = re.split(r"\set al\.?|\sand\b|,", str(study).strip())[0].strip()
    return head.split()[-1].lower()

def surname_tokens(authors):
    return [p.strip().split()[-1].lower() for p in str(authors).split(" and ") if p.strip()]

def venue_of(journal):
    j = str(journal).lower()
    if "quarterly journal of economics" in j:
        return "qje"
    return "aer" if "economic review" in j else "other"

ee1 = ee.copy()
ee1["lead"] = ee1["authors.o"].apply(lambda a: surname_tokens(a)[0])
ee1["venue"] = ee1["journal"].apply(venue_of)

recs = []
for _, r in ee2.iterrows():
    st = str(r["study"])
    yr = (re.search(r"(\d{4})\)", st) or [None, None])[1]
    vm = re.search(r"\(([A-Za-z ]+) \d{4}\)", st)
    ven = vm.group(1).strip().lower() if vm else "other"
    m = ee1[ee1["lead"] == lead_surname(st)]
    how = "lead surname"
    if len(m) > 1:
        m = m[m["pub_year"].astype(str) == yr]
        how = "lead surname + pub_year"
    ok = len(m) == 1
    recs.append({"file2_study": st, "lead": lead_surname(st), "year": yr, "venue": ven,
                 "n_matches": len(m), "matched_by": how if ok else "AMBIGUOUS/NONE",
                 "ee_id": m["id"].iloc[0] if ok else "",
                 "file1_title": m["title"].iloc[0] if ok else "",
                 "file1_pub_year": m["pub_year"].iloc[0] if ok else "",
                 "file1_venue": m["venue"].iloc[0] if ok else ""})
pairs = pd.DataFrame(recs)
pairs["year_ok"] = pairs["year"].astype(str) == pairs["file1_pub_year"].astype(str)
pairs["venue_ok"] = pairs["venue"] == pairs["file1_venue"]
print("\nauditable matched-pair table (lead surname + year + venue):")
print(pairs[["file2_study", "lead", "year", "venue", "ee_id", "file1_title",
             "file1_pub_year", "file1_venue", "year_ok", "venue_ok", "matched_by"]].to_string(index=False))
print(f"\nunique matches: {(pairs['n_matches'] == 1).sum()}/{len(ee2)}   "
      f"ambiguous: {(pairs['n_matches'] > 1).sum()}   unmatched: {(pairs['n_matches'] == 0).sum()}")
print(f"year agrees : {int(pairs['year_ok'].sum())}/{len(pairs)}    venue agrees: {int(pairs['venue_ok'].sum())}/{len(pairs)}")

print("\nreproduced failure modes of the name heuristic (all actually observed, variant-labelled):")
print("  1. lowercase surname PARTICLE -- variant B (naive FIRST token of the study label):")
print("     'de Clippel et al. (AER 2014)' -> key 'de' -> 0 matches (17/18 matched). The surname is")
print("     'De Clippel' (ee.6); taking the LAST token of the author head fixes it. Known limitation:")
print("     nobiliary particles are stripped by first-token extraction.")
print("  2. SHARED-AUTHOR COLLISION -- variant A (key matched against ANY author surname, not just the")
print("     lead): 'Fehr et al. (AER 2013)' hits both ee.10 (Fehr/Herz/Wilkening 2013) and ee.3")
print("     (Bartling/Fehr/Schmidt 2012) = 2 candidates; pub_year resolves it to ee.10.")
print("  3. MULTI-TOKEN SURNAME: 'Ericson and Fuster (QJE 2011)' vs file1 'Keith M. Marzilli Ericson ...'")
print("     (ee.9); only last-token surname extraction matches it.")
print("  Variant comparison actually run (see table below): the SELECTED heuristic is lead-surname-only")
print("  with last-token extraction; pub_year disambiguation is coded as a safeguard but did NOT need")
print("  to fire for any of the 18 rows, because restricting the key to the LEAD surname already")
print("  removes the Fehr collision that variant A suffers. Stating this precisely rather than")
print("  implying year-matching rescued the run.")

def variants():
    res = []
    for label, use_any, tokpos in [("A  key vs ANY author surname (last token)", True, "last"),
                                   ("B  key vs lead surname, FIRST token of label", False, "first"),
                                   ("C  SELECTED: key vs lead surname (last token)", False, "last")]:
        u = a = no = yr = 0
        for _, r in ee2.iterrows():
            st = str(r["study"])
            head = re.split(r"\set al\.?|\sand\b|,", st.strip())[0].strip()
            k = head.split()[-1].lower() if tokpos == "last" else st.strip().split()[0].lower()
            m = ee1[ee1["allsurn"].apply(lambda L: k in L)] if use_any else ee1[ee1["lead"] == k]
            if len(m) > 1:
                yr += 1
                m = m[m["pub_year"].astype(str) == (re.search(r"(\d{4})\)", st) or [None, None])[1]]
            u += len(m) == 1; a += len(m) > 1; no += len(m) == 0
        res.append({"heuristic_variant": label, "unique": u, "unresolved_ambig": a,
                    "unmatched": no, "rows_needing_pub_year": yr})
    return pd.DataFrame(res)

ee1["allsurn"] = ee1["authors.o"].apply(surname_tokens)
print()
print(variants().to_string(index=False))
print("  Known residual limitation: fragile to particles, pseudonyms and reordered author strings;")
print("  adequate for a 1:1 count check, not a general record-linkage claim.")

m_ok = pairs[pairs["n_matches"] == 1]
idx = ee1.set_index("id")
n_ag2 = p_ag = 0
ex = []
for _, x in m_ok.iterrows():
    r2 = ee2[ee2["study"] == x["file2_study"]].iloc[0]
    a = idx.loc[x["ee_id"]]
    n_ag2 += float(a["n.o"]) == float(r2["no"])
    if float(a["n.o"]) != float(r2["no"]) and len(ex) < 3:
        ex.append(f"{x['ee_id']} {a['n.o']:.0f} vs {r2['no']:.0f}")
    p1, p2 = float(a["p_value.o"]), float(r2["po"])
    p_ag += abs(p1 - p2) <= max(1e-3, 0.02 * p2)
print("\nfile1 vs file2 numeric columns are NOT interchangeable (stated, and NOT used in the estimate):")
print(f"  n.o vs no agree on {n_ag2}/{len(m_ok)} matched pairs; p_value.o vs po agree on {p_ag}/{len(m_ok)}.")
print(f"  example n disagreements: {', '.join(ex)}")
print("  -> the files count different quantities (participants vs independent observations).")
print("     This is a reason the files are not interchangeable; it is NOT evidence about setting")
print("     and does not feed the estimate in either direction.")

hdr("6. RESULT AND HYPOTHESIS")
n1, n2, n3 = int(ee["R1"].sum()), int(ee["R2"].sum()), int(ee["R3"].sum())
print(f"PRIMARY (R1, online.o == 0) : {n1}/{N} = {n1 / N:.4f} = {100 * n1 / N:.1f}%")
print(f"SENSITIVITY (R2)            : {n2}/{N} = {n2 / N:.4f} = {100 * n2 / N:.1f}%   (drops ee.4)")
print(f"SENSITIVITY (R3)            : {n3}/{N} = {n3 / N:.4f} = {100 * n3 / N:.1f}%")
print("\nDefinition stated as an assumption: no column in either file records 'lab setting'; online.o is")
print("the only field encoding mode of collection; R1 treats 'not online' as 'in person / lab'.")
print("online.o has ZERO variance inside ee (all 18 == 0), so R1 restates a degenerate distribution")
print("rather than estimating a sample proportion. There is therefore no meaningful sampling")
print("uncertainty to attach and no confidence interval is reported deliberately: the uncertainty")
print("is definitional and coverage-related, not sampling-related.")

# internal-data contrast (computed here, not asserted from memory)
ml1 = df[df["project"] == "ml1"]
ee_on = int((ee["online.o"] == 1).sum())
ml1_on = int((ml1["online.o"] == 1).sum())
print("\ninternal contrast computed from file 1 (supports 'in-person corpus' framing, same dataset):")
print(f"  ee  : {ee_on}/{len(ee)} originals coded online  ({100*ee_on/len(ee):.1f}%)")
print(f"  ml1 : {ml1_on}/{len(ml1)} originals coded online ({100*ml1_on/len(ml1):.1f}%)")

print("\n" + "-" * 78)
print("CAVEATS")
print("-" * 78)
print("C1 DEFINITIONAL: 'lab setting' is not a recorded variable. R1 = not-online. A stricter reading")
print("   that requires a captive student pool gives 17/18 (ee.4 'Participation' uses a community")
print("   pool). The choice of rule, not the data, drives the 100% vs 94.4% difference.")
print("C2 ZERO-VARIANCE / NO SAMPLING UNCERTAINTY: online.o is constant within ee, so no interval is")
print("   meaningful; reporting a CI over n=18 would dress a degenerate distribution as an estimate.")
print("C3 COVERAGE: lab_id, the only field that could identify an actual lab, is 0/18 populated;")
print("   us_lab.* is a US-location dummy (926/926 agreement with country=='United States'; 40")
print("   online studies carry us_lab==1) and was therefore excluded, not merely avoided.")
print("C4 DENOMINATOR PROVENANCE (EXTERNAL, NOT DATA FROM THIS ENVIRONMENT): these files contain 18")
print("   ee rows and that is the denominator used. Published accounts of the EERP describe a")
print("   candidate set larger than the set actually replicated; if 'studies in Experimental")
print("   Economics' were defined over such a candidate list rather than over replicated pairs, the")
print("   denominator and hence the proportion could change. This is flagged as an external caveat;")
print("   no external count is imported into the estimate, and no per-study external verification of")
print("   lab location was performed - nothing outside these two CSVs was consulted.")
print("C5 SCOPE: the answer is a hypothesis about these files, not a measured fact about the studies.")

HYPOTH = (
    "Hypothesis: essentially all Experimental Economics studies in this dataset were conducted in a "
    "lab (in-person) setting. Of the 18 original studies in the ee (Experimental Economics) "
    "replication project, 18 of 18 (100%) are coded online.o == 0, i.e. their original data were not "
    "collected online; all 18 are also in-person on the replication side (online.r == 0) and all 18 "
    "paid subjects in cash. Under a stricter definition that additionally requires a student subject "
    "pool the figure is 17 of 18 (94.4%), the sole exception being ee.4 ('Participation'), which "
    "recruited a community rather than a student pool; so the proportion is 1.00 under the primary "
    "definition and no lower than about 0.94 under the stricter one. Two things qualify that number. "
    "First, it rests on a modelling assumption rather than on documentation: neither file records a "
    "'lab setting' variable, so 'lab' is operationalised as the negation of online data collection, "
    "and the only field that could identify a specific lab (lab_id) is empty for all 18 rows. "
    "Second, because online.o has zero variance within ee, this restates a degenerate distribution "
    "rather than estimating a sample proportion - there is no meaningful sampling uncertainty to "
    "attach, and the residual uncertainty is definitional and coverage-related. Within these files "
    "the ee corpus is distinctly in-person (0 of 18 originals online, against 37 of 592 in Many "
    "Labs 1), so the substantive claim is that Experimental Economics in this replication corpus is "
    "an in-person, laboratory-based enterprise - while noting that 'not online' cannot by itself "
    "separate a physical lab from some other in-person venue, and that the estimate covers the 18 "
    "replicated pairs present in these files rather than any wider candidate list."
)
print("\n" + "-" * 78)
print("SUBMITTED HYPOTHESIS")
print("-" * 78)
print(HYPOTH)
