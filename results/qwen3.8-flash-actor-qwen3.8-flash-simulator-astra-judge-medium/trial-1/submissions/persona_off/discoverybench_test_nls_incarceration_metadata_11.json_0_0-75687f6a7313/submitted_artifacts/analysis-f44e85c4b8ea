"""
Demographic disparities in median 1985 wealth among the ever-incarcerated (NLSY79 processed file).

DESIGN (approved brief)
 - Primary group: ever_jailed==1 (jailed 1985-1994). Outcome: RAW composite_wealth_1985
   (zeros kept; negatives kept as real net debt). FOCUS: disparities WITHIN this group.
 - Comparator: ever_jailed==0 (supporting context). Crude and race x sex composition-
   standardised overall gaps side by side (standardisation = distributional reweighting of
   cell medians, NOT covariate adjustment).
 - Uncertainty: unweighted, fixed-seed percentile bootstrap (2,000 resamples) describing
   sampling variability in THIS sample only. Not design-based; not a survey standard error.
 - Pre-specified small-cell rule: n<30 -> flagged "exploratory", never suppressed.
 - Tie-block rule: if a cell median == 0, or the value at the median spans the cell's
   25th-75th percentile range, flag numeric_reportable=False and describe qualitatively.
 - Co-equal sensitivity measures: positive-only; winsorised at full-sample 1st/99th pct.
   No flooring of debt. Any flip between raw and winsorised is reported as a finding.
 - Secondary/exploratory: 1990 and 1996 repeats (same window-overlap problem; used to test
   whether the within-group ordering of groups is stable over time).
 - UNAVAILABLE ROUTES (recorded, not omitted):
   (a) inferring incarceration from residence in a detention facility -- this file exposes no
       residence/living-arrangement field;
   (b) adjustment for jail timing/duration/release and all demographic/human-capital
       covariates -- none exposed.
"""
import os
import numpy as np
import pandas as pd

SEED, B, SMALL_N = 20261023, 2000, 30
OUT = "outputs"; os.makedirs(OUT, exist_ok=True)

df = pd.read_csv("data/nls_incarceration_processed.csv")
W = {"1985": "composite_wealth_1985", "1990": "composite_wealth_1990",
     "1996": "composite_wealth_1996"}
for y, c in W.items():                       # winsorised variants (per year, full-sample limits)
    lo, hi = np.percentile(df[c], [1, 99])
    df[c + "_wins"] = df[c].clip(lo, hi)
WINS_LIMITS_1985 = tuple(np.percentile(df[W["1985"]], [1, 99]))

# ------------------------------------------------------------- bootstrap machinery
def boot_median_ci(v, B=B, seed=SEED):
    v = np.asarray(v, float)
    if v.size == 0: return (np.nan, np.nan)
    rng = np.random.default_rng(seed)
    draws = np.median(v[rng.integers(0, v.size, size=(B, v.size))], axis=1)
    return tuple(np.percentile(draws, [2.5, 97.5]))

def boot_median_diff_ci(a, b, B=B, seed=SEED):
    """CI for median(a) - median(b); a, b disjoint subsamples."""
    a, b = np.asarray(a, float), np.asarray(b, float)
    if a.size == 0 or b.size == 0: return (np.nan, np.nan)
    rng = np.random.default_rng(seed)
    da = np.median(a[rng.integers(0, a.size, (B, a.size))], axis=1)
    db = np.median(b[rng.integers(0, b.size, (B, b.size))], axis=1)
    return tuple(np.percentile(da - db, [2.5, 97.5]))

# ------------------------------------------------------------- cell statistics
def cell(v):
    v = np.asarray(v, float); n = v.size
    if n == 0:
        return dict(n=0, median=np.nan, q1=np.nan, q3=np.nan, iqr=np.nan, mean=np.nan,
                    ci_low=np.nan, ci_high=np.nan, pct_zero=np.nan, pct_negative=np.nan,
                    min=np.nan, max=np.nan, median_is_zero=False, tie_block_spans_iqr=False,
                    small_n_exploratory=False, numeric_reportable=False)
    q1, med, q3 = np.percentile(v, [25, 50, 75])
    lo, hi = boot_median_ci(v)
    below, at_below = float((v < med).mean()), float((v <= med).mean())
    m_zero = bool(med == 0); spans = bool(below < 0.25 and at_below > 0.75)
    return dict(n=n, median=float(med), q1=float(q1), q3=float(q3), iqr=float(q3 - q1),
                mean=float(v.mean()), ci_low=float(lo), ci_high=float(hi),
                pct_zero=round(100 * (v == 0).mean(), 1),
                pct_negative=round(100 * (v < 0).mean(), 1),
                min=float(v.min()), max=float(v.max()), median_is_zero=m_zero,
                tie_block_spans_iqr=spans, small_n_exploratory=bool(n < SMALL_N),
                numeric_reportable=bool(not m_zero and not spans))

def stat_table(d, wcol, keys):
    """ALL row, one row per level of each key, one row per key[0] x key[1] cell."""
    rows = [dict(cut="ALL", level="all", **cell(d[wcol]))]
    for k in keys:
        for lvl, g in d.groupby(k, sort=True):
            rows.append(dict(cut=k, level=str(lvl), **cell(g[wcol])))
    if len(keys) == 2:
        for (a, b), g in d.groupby(keys, sort=True):
            rows.append(dict(cut="race x sex", level=f"{a} / {b}", **cell(g[wcol])))
    return pd.DataFrame(rows)

def with_group(t, tag):
    t = t.copy(); t.insert(0, "group", tag); return t

jail = df[df.ever_jailed == 1]; nojail = df[df.ever_jailed == 0]

# ============================================================== TABLE B  (the centre: within ever-incarcerated)
T_B = with_group(stat_table(jail, W["1985"], ["race", "sex"]), "ever_jailed=1 (primary)")

# ============================================================== TABLE A  (jailed vs not, context)
T_A = pd.concat([with_group(stat_table(nojail, W["1985"], ["race", "sex"]), "ever_jailed=0 (context)"),
                 with_group(stat_table(jail, W["1985"], ["race", "sex"]), "ever_jailed=1 (primary)")],
                ignore_index=True)

# ============================================================== TABLE C  (gaps + standardisation)
def med_of(d, wcol, **f):
    s = d
    for k, v in f.items(): s = s[s[k] == v]
    return (float(np.median(s[wcol])) if len(s) else np.nan), len(s)

def sub_of(d, **f):
    s = d
    for k, v in f.items(): s = s[s[k] == v]
    return s

def contrast(d1, d0, wcol, label, **f):
    m1, n1 = med_of(d1, wcol, **f); m0, n0 = med_of(d0, wcol, **f)
    lo, hi = boot_median_diff_ci(sub_of(d1, **f)[wcol], sub_of(d0, **f)[wcol])
    ratio = (m1 / m0) if (m0 == m0 and m0 != 0) else np.nan
    return dict(comparison=label, n_jailed=n1, n_not_jailed=n0, median_jailed=m1,
                median_not_jailed=m0, gap_median=m1 - m0, gap_ci_low=lo, gap_ci_high=hi,
                ratio_jailed_over_not=ratio)

crows = [contrast(jail, nojail, W["1985"], "OVERALL crude (pooled)")]
for k in ["race", "sex"]:
    for lvl in sorted(df[k].unique()):
        crows.append(contrast(jail, nojail, W["1985"], f"{k}={lvl}", **{k: lvl}))
for r_ in sorted(df.race.unique()):
    for s_ in sorted(df.sex.unique()):
        crows.append(contrast(jail, nojail, W["1985"], f"race={r_} x sex={s_}", race=r_, sex=s_))
T_C = pd.DataFrame(crows)

# race x sex composition-STANDARDISED gap (distributional reweighting of cell medians,
# weights = ever-jailed race x sex shares). NOT covariate adjustment.
wts = jail.groupby(["race", "sex"]).size().rename("n_jailed").reset_index()
wts["weight"] = wts.n_jailed / wts.n_jailed.sum()
std_j = std_n = 0.0
for _, row in wts.iterrows():
    m0, _ = med_of(nojail, W["1985"], race=row.race, sex=row.sex)
    m1, _ = med_of(jail, W["1985"], race=row.race, sex=row.sex)
    if m0 == m0: std_n += row.weight * m0
    if m1 == m1: std_j += row.weight * m1

# bootstrap for the standardised gap: resample BOTH groups; the cell weights always come from
# the ever-jailed draw and are applied to both groups' cell medians (that is the definition).
rng = np.random.default_rng(SEED + 1)
jc = jail[["race", "sex", W["1985"]]].to_numpy()
nc = nojail[["race", "sex", W["1985"]]].to_numpy()
CELLS = sorted({(a, b) for a in df.race.unique() for b in df.sex.unique()})

def std_pair(draw_j, draw_n):
    dj = pd.DataFrame(draw_j, columns=["race", "sex", "w"]); dj["w"] = dj["w"].astype(float)
    dn = pd.DataFrame(draw_n, columns=["race", "sex", "w"]); dn["w"] = dn["w"].astype(float)
    wt = dj.groupby(["race", "sex"]).size().reindex(CELLS).fillna(0.0)
    wt = wt / wt.sum()
    m1 = dj.groupby(["race", "sex"])["w"].median().reindex(CELLS)
    m0 = dn.groupby(["race", "sex"])["w"].median().reindex(CELLS)
    ok1, ok0 = m1.notna(), m0.notna()
    return float((wt[ok1] * m1[ok1]).sum()), float((wt[ok0] * m0[ok0]).sum())

std_draws = []
for _ in range(B):
    a, b = std_pair(jc[rng.integers(0, len(jc), len(jc))], nc[rng.integers(0, len(nc), len(nc))])
    std_draws.append(a - b)
std_lo, std_hi = np.percentile(std_draws, [2.5, 97.5])
crude_lo, crude_hi = boot_median_diff_ci(jail[W["1985"]], nojail[W["1985"]])

crude_row = T_C.iloc[0].copy(); crude_row.gap_ci_low, crude_row.gap_ci_high = crude_lo, crude_hi
std_row = dict(comparison="OVERALL race x sex composition-STANDARDISED gap (distributional "
               "reweighting of cell medians; NOT covariate adjustment)",
               n_jailed=len(jail), n_not_jailed=len(nojail),
               median_jailed=std_j, median_not_jailed=std_n, gap_median=std_j - std_n,
               gap_ci_low=std_lo, gap_ci_high=std_hi, ratio_jailed_over_not=std_j / std_n)
T_C = pd.concat([pd.DataFrame([crude_row]), pd.DataFrame([std_row]), T_C.iloc[1:]], ignore_index=True)

# ============================================================== TABLE D (robustness + secondary)
drows = []
for measure in ["raw", "positive_only", "winsorised_1_99"]:
    for year in ["1985", "1990", "1996"]:
        col = W[year] + ("_wins" if measure == "winsorised_1_99" else "")
        sj, sn = jail, nojail
        if measure == "positive_only":
            sj, sn = jail[jail[W[year]] > 0], nojail[nojail[W[year]] > 0]
        for tag, d in [("ever_jailed=1 (primary)", sj), ("ever_jailed=0 (context)", sn)]:
            t = with_group(stat_table(d, col, ["race", "sex"]), tag)
            t.insert(0, "wealth_year", year); t.insert(0, "measure", measure)
            drows.append(t)
T_D = pd.concat(drows, ignore_index=True)

# ---- within-group pairwise contrasts among the ever-jailed (RAW 1985) : the centre of the answer
levels = {"race": sorted(df.race.unique()), "sex": sorted(df.sex.unique())}
subs = {}
for l in levels["race"]: subs[("race", l)] = jail[jail.race == l][W["1985"]]
for l in levels["sex"]:  subs[("sex", l)]  = jail[jail.sex == l][W["1985"]]
for a in levels["race"]:
    for b in levels["sex"]:
        subs[("race x sex", f"{a} / {b}")] = jail[(jail.race == a) & (jail.sex == b)][W["1985"]]
rrows = []
for cut in ["race", "sex", "race x sex"]:
    names = [k for k in subs if k[0] == cut]
    for i in range(len(names)):
        for j_ in range(i + 1, len(names)):
            A, Bv = subs[names[i]], subs[names[j_]]
            lo, hi = boot_median_diff_ci(A, Bv)
            mA, mB = float(np.median(A)), float(np.median(Bv))
            rrows.append(dict(cut=cut, group_a=names[i][1], group_b=names[j_][1],
                              n_a=len(A), n_b=len(Bv), median_a=mA, median_b=mB,
                              diff_a_minus_b=mA - mB, diff_pct_of_higher=(100 * (mA - mB) / max(abs(mA), abs(mB))) if max(abs(mA), abs(mB)) > 0 else float('nan'),
                              diff_ci_low=lo, diff_ci_high=hi, ci_excludes_zero=bool(lo > 0 or hi < 0),
                              small_n_flag=bool(min(len(A), len(Bv)) < SMALL_N)))
T_RANK = pd.DataFrame(rrows).sort_values("diff_a_minus_b", key=abs, ascending=False)

# ---- duplicate-row sensitivity (headline medians on de-duplicated data)
ded = df.drop_duplicates(); ded_j = ded[ded.ever_jailed == 1]
T_DEDUP = pd.DataFrame([
    dict(view="full data (as delivered)", n_rows=len(df), n_jailed=len(jail),
         median_jailed=float(np.median(jail[W["1985"]])),
         median_not_jailed=float(np.median(nojail[W["1985"]]))),
    dict(view="exact duplicate rows dropped", n_rows=len(ded), n_jailed=len(ded_j),
         median_jailed=float(np.median(ded_j[W["1985"]])) if len(ded_j) else np.nan,
         median_not_jailed=float(np.median(ded[ded.ever_jailed == 0][W["1985"]]))),
])

# ---- ordering stability of within-group medians across wealth years (raw)
ord_rows = []
for year in ["1985", "1990", "1996"]:
    for cut in ["race", "sex"]:
        s = jail.groupby(cut)[W[year]].median().sort_values(ascending=False)
        ord_rows.append(dict(wealth_year=year, cut=cut,
                             ordering=" > ".join(f"{k} ({v:,.0f})" for k, v in s.items())))
T_ORDER = pd.DataFrame(ord_rows)

# ---------------------------------------------------------------- write + print
for nm, t in [("tableA_jailed_vs_not", T_A), ("tableB_within_incarcerated", T_B),
              ("tableC_gaps_and_standardised", T_C), ("tableD_robustness_and_secondary", T_D),
              ("within_group_contrasts", T_RANK), ("sensitivity_dedup", T_DEDUP),
              ("ordering_stability_by_year", T_ORDER)]:
    t.to_csv(f"{OUT}/{nm}.csv", index=False)
pd.DataFrame([dict(key="winsorise_1985_low", value=WINS_LIMITS_1985[0]),
              dict(key="winsorise_1985_high", value=WINS_LIMITS_1985[1]),
              dict(key="n_rows", value=len(df)), dict(key="n_ever_jailed", value=len(jail)),
              dict(key="bootstrap_B", value=B), dict(key="seed", value=SEED),
              dict(key="small_n_threshold", value=SMALL_N),
              dict(key="route_residence_detention_facility", value="UNAVAILABLE: no residence field"),
              dict(key="route_jail_timing_duration_covariates", value="UNAVAILABLE: none exposed"),
              ]).to_csv(f"{OUT}/run_metadata.csv", index=False)

pd.set_option("display.width", 260, "display.max_columns", 60)
F = ["group","cut","level","n","median","q1","q3","iqr","ci_low","ci_high","pct_zero",
     "pct_negative","median_is_zero","tie_block_spans_iqr","small_n_exploratory","numeric_reportable"]
print("WINSOR 1985 limits:", WINS_LIMITS_1985, "| n_jailed:", len(jail), "n_not:", len(nojail))
print("\n### TABLE B (WITHIN EVER-INCARCERATED, raw 1985) ###"); print(T_B[F].to_string(index=False))
print("\n### TABLE A (jailed vs not, raw 1985) ###"); print(T_A[F].to_string(index=False))
print("\n### TABLE C (gaps) ###"); print(T_C.round(1).to_string(index=False))
print("\n### WITHIN-GROUP CONTRASTS (raw 1985) ###"); print(T_RANK.round(1).to_string(index=False))
print("\n### DEDUP ###"); print(T_DEDUP.to_string(index=False))
print("\n### ORDERING ###"); print(T_ORDER.to_string(index=False))

# since medians sit on the zero tie block, complement them with zero-asset / positive-asset
# PREVALENCES within the ever-jailed group, with bootstrap CIs on the differences.
def boot_share_diff_ci(a, b, B=B, seed=SEED):
    a, b = np.asarray(a, bool), np.asarray(b, bool)
    rng = np.random.default_rng(seed)
    da = a[rng.integers(0, a.size, (B, a.size))].mean(1)
    db = b[rng.integers(0, b.size, (B, b.size))].mean(1)
    return tuple(100 * np.percentile(da - db, [2.5, 97.5]))

zrows = []
for cut in ["race", "sex"]:
    g = jail.groupby(cut)[W["1985"]]
    for lvl, v in g:
        zrows.append(dict(cut=cut, level=str(lvl), n=len(v),
                          pct_zero_assets=round(100*float((v == 0).mean()), 1),
                          pct_any_positive_asset=round(100*float((v > 0).mean()), 1),
                          pct_net_debt=round(100*float((v < 0).mean()), 1)))
ZT = pd.DataFrame(zrows)
pdiffs = []
for cut, pairs in [("race", [("white","black"), ("white","hipanic"), ("black","hipanic")]),
                   ("sex", [("female","male")])]:
    for a_, b_ in pairs:
        va = jail[jail[cut] == a_][W["1985"]]; vb = jail[jail[cut] == b_][W["1985"]]
        lo, hi = boot_share_diff_ci(va == 0, vb == 0)
        pa, pb = 100*float((va == 0).mean()), 100*float((vb == 0).mean())
        pdiffs.append(dict(cut=cut, comparison=f"pct zero assets: {a_} minus {b_}",
                           pct_a=round(pa,1), pct_b=round(pb,1), diff_pp=round(pa-pb,1),
                           diff_ci_low=round(lo,1), diff_ci_high=round(hi,1),
                           ci_excludes_zero=bool(lo > 0 or hi < 0)))
ZP = pd.DataFrame(pdiffs)
ZT.to_csv(f"{OUT}/within_group_zero_asset_prevalence.csv", index=False)
ZP.to_csv(f"{OUT}/within_group_zero_asset_diffs.csv", index=False)
print("\n### ZERO-ASSET / POSITIVE-ASSET PREVALENCE (ever-jailed, raw 1985) ###")
print(ZT.to_string(index=False)); print(ZP.to_string(index=False))

# de-duplicated sensitivity for the within-jailed cuts (exact duplicate rows dropped)
ded_rows = []
for tag, d in [("full data", df), ("exact duplicates dropped", df.drop_duplicates())]:
    dj = d[d.ever_jailed == 1]
    t = stat_table(dj, W["1985"], ["race", "sex"]); t.insert(0, "view", tag)
    ded_rows.append(t)
T_DED2 = pd.concat(ded_rows, ignore_index=True)
T_DED2.to_csv(f"{OUT}/sensitivity_dedup_within_group.csv", index=False)
print("\n### DEDUP SENSITIVITY (within ever-jailed, raw 1985) ###")
print(T_DED2[["view","cut","level","n","median","q1","q3","ci_low","ci_high","pct_zero"]].to_string(index=False))
print("\njailed prevalence by race x sex (context):")
print((df.groupby(["race","sex"]).ever_jailed.agg(["size","sum","mean"])
        .assign(mean=lambda x: (100*x["mean"]).round(2))).to_string())

F2 = ["measure","wealth_year","group","cut","level","n","median","q1","q3","iqr","ci_low","ci_high",
      "pct_zero","pct_negative","median_is_zero","tie_block_spans_iqr","small_n_exploratory","numeric_reportable"]
print("\n### TABLE D: 1985 measure comparison (ALL/race/sex cuts) ###")
print(T_D[(T_D.wealth_year=="1985")&(T_D.cut.isin(["ALL","race","sex"]))][F2].to_string(index=False))
print("\n### TABLE D: 1985 measure comparison (race x sex) ###")
print(T_D[(T_D.wealth_year=="1985")&(T_D.cut=="race x sex")][F2].to_string(index=False))
print("\n### TABLE D: secondary years raw (ALL/race/sex) ###")
print(T_D[(T_D.measure=="raw")&(T_D.wealth_year!="1985")&(T_D.cut.isin(["ALL","race","sex"]))][F2].to_string(index=False))
print("\n### TABLE D: secondary years raw (race x sex) ###")
print(T_D[(T_D.measure=="raw")&(T_D.wealth_year!="1985")&(T_D.cut=="race x sex")][F2].to_string(index=False))

# explicit flip check: does the sign of a within-jailed contrast change across measures?
flip = []
for measure in ["raw", "positive_only", "winsorised_1_99"]:
    jd = T_D[(T_D.measure == measure) & (T_D.wealth_year == "1985") &
             (T_D.group.str.startswith("ever_jailed=1"))]
    for cut in ["ALL", "race", "sex", "race x sex"]:
        meds = {r["level"]: r["median"] for _, r in jd[jd.cut == cut].iterrows()}
        ks = list(meds)
        for a in range(len(ks)):
            for b in range(a + 1, len(ks)):
                d = meds[ks[a]] - meds[ks[b]]
                flip.append(dict(measure=measure, cut=cut, pair=f"{ks[a]} vs {ks[b]}",
                                 diff=d, sign=float(np.sign(d))))
FL = pd.DataFrame(flip)
FLP = FL.pivot_table(index=["cut", "pair"], columns="measure", values="sign")
FLP["sign_flips"] = FLP.nunique(axis=1) > 1
FLP.to_csv(f"{OUT}/flip_check_sign_stability.csv")
print("\n### FLIP CHECK: sign of within-jailed contrasts by measure ###")
print(FLP.to_string())
print("\nFLIPPED PAIRS:")
print(FLP[FLP.sign_flips].to_string())
raw_m = T_D[(T_D.measure=="raw")]["median"].values
win_m = T_D[(T_D.measure=="winsorised_1_99")]["median"].values
print("\nwinsorised vs raw medians identical?", bool(np.allclose(raw_m, win_m, equal_nan=True)))
