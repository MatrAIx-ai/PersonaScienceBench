"""Inspection pass for data/nls_incarceration_processed.csv (no subgroup conclusions)."""
import pandas as pd, numpy as np

df = pd.read_csv("data/nls_incarceration_processed.csv")
print("shape:", df.shape)
print(df.dtypes)
print("missing per column:\n", df.isna().sum())
for c in ["race", "sex", "ever_jailed"]:
    print(c, "distinct:", sorted(df[c].unique().tolist(), key=str),
          "counts:", df[c].value_counts(dropna=False).to_dict())

w = df["composite_wealth_1985"]
print(w.describe(percentiles=[.01,.05,.1,.25,.5,.75,.9,.95,.99]))
print("skew", round(w.skew(),3), "excess kurt", round(w.kurtosis(),1))
print("exactly zero:", int((w==0).sum()), "negative:", int((w<0).sum()),
      "positive:", int((w>0).sum()), "unique:", w.nunique())
print(">500k:", int((w>500000).sum()), ">1M:", int((w>1000000).sum()), "<-100k:", int((w<-100000).sum()))
print("share div by 100/50/10:", [round(float((w%m==0).mean()),3) for m in (100,50,10)])
print("median raw:", w.median(), "| median positive-only:", w[w>0].median())
print("negative subset:\n", w[w<0].describe())
print("full-row duplicates:", int(df.duplicated().sum()))
print("ever_jailed==1 cell sizes (race x sex):\n",
      df[df.ever_jailed==1].groupby(["race","sex"]).size())
print("columns (no residence/id/weight field):", list(df.columns))
