import numpy as np, pandas as pd, statsmodels.formula.api as smf
from scipy.stats import mannwhitneyu
pd.set_option('display.width',250)
rng=np.random.default_rng(7)
W85,W90,W96='composite_wealth_1985','composite_wealth_1990','composite_wealth_1996'
df=pd.read_csv('data/nls_incarceration_processed.csv')
bm=df[(df.race=='black')&(df.sex=='male')].copy()
cuts=np.percentile(bm[W85],[100/3,200/3])
bm['tier']=np.where(bm[W85]<=cuts[0],'T1_low',np.where(bm[W85]<=cuts[1],'T2_mid','T3_high'))
for w,t in zip([W85,W90,W96],['85','90','96']):
    a,b=np.percentile(bm[w],[1,99]); bm['wz'+t]=bm[w].clip(a,b)
bm['chg']=bm[W96]-bm[W85]; cl,ch=np.percentile(bm.chg,[1,99]); bm['chg_wz']=bm.chg.clip(cl,ch)
bm['j']=bm.ever_jailed; bm['t2']=(bm.tier=='T2_mid').astype(int); bm['t3']=(bm.tier=='T3_high').astype(int)
bm['ihs85']=np.arcsinh(bm[W85]/1000); bm['ihs96']=np.arcsinh(bm[W96]/1000)
bm['ratio96']=bm[W96]-bm[W85]  # placeholder removed below

print("=== A1 TIER ORDERING of the 1996 jail-vs-nonjail gap under 4 metrics ===")
rows=[]
for t in ['T1_low','T2_mid','T3_high']:
    s=bm[bm.tier==t]; j=s[s.j==1]; n=s[s.j==0]
    rows.append(dict(tier=t,n_j=len(j),raw_dollar_gap=j[W96].mean()-n[W96].mean(),
        wz_dollar_gap=j.wz96.mean()-n.wz96.mean(), median_gap=j[W96].median()-n[W96].median(),
        ratio=j[W96].mean()/n[W96].mean(), ihs_gap=j.ihs96.mean()-n.ihs96.mean()))
A1=pd.DataFrame(rows).round(3); print(A1.to_string(index=False))
print("\nordering (largest penalty first): raw$ ->", list(A1.sort_values('raw_dollar_gap').tier),
      "\n  wz$ ->", list(A1.sort_values('wz_dollar_gap').tier), "\n  median$ ->", list(A1.sort_values('median_gap').tier),
      "\n  ratio (smallest ratio first) ->", list(A1.sort_values('ratio').tier),
      "\n  ihs ->", list(A1.sort_values('ihs_gap').tier))

print("\n=== A2 dollar-scale interaction on WINSORIZED 1985->1996 CHANGE (M4) ===")
m4=smf.ols('chg_wz ~ j + t2 + t3 + j:t2 + j:t3 + wz85',data=bm).fit(cov_type='HC1')
wt=m4.f_test('j:t2 = 0, j:t3 = 0')
print(pd.DataFrame({'coef':m4.params,'se':m4.bse,'p':m4.pvalues}).round(4).to_string())
print(f"joint tier x jail: F={float(wt.statistic):.3f} p={float(wt.pvalue):.4g}")

print("\n=== A3 RATIO-scale moderation: OLS on ln-style relative growth (ihs96-ihs85) -> already M2 (ns).")
print("    Alternative: regression of 1996 wealth RANK percentile on jail x tier (nonparametric scale check)")
bm['rk96']=bm[W96].rank(pct=True); bm['rk85']=bm[W85].rank(pct=True)
m5=smf.ols('rk96 ~ j + t2 + t3 + j:t2 + j:t3 + rk85',data=bm).fit(cov_type='HC1')
wt5=m5.f_test('j:t2 = 0, j:t3 = 0')
print(pd.DataFrame({'coef':m5.params,'se':m5.bse,'p':m5.pvalues}).round(4).to_string())
print(f"joint: F={float(wt5.statistic):.3f} p={float(wt5.pvalue):.4g}  | jail main (at T1) = {m5.params['j']:.4f} ({m5.bse['j']:.4f})")

print("\n=== A4 <0/=0/>0 split (item 1 robustness to 0-tie mass), 1996 ===")
alt=np.where(bm[W85]<0,'A_neg',np.where(bm[W85]==0,'B_zero','C_pos')); bm['alt']=alt
for a,g in bm.groupby('alt'):
    j,n=g[g.j==1],g[g.j==0]
    p=mannwhitneyu(j[W96],n[W96]).pvalue if len(j)>1 else np.nan
    print(f"  {a}: n_j={len(j):3d} n_n={len(n):4d} | mean {j[W96].mean():10,.0f} vs {n[W96].mean():10,.0f} gap {j[W96].mean()-n[W96].mean():+10,.0f} ratio {j[W96].mean()/n[W96].mean() if n[W96].mean() else float('nan'):.3f} | med {j[W96].median():,.0f} vs {n[W96].median():,.0f} | MWU p={p:.2g} {'(DESCRIPTIVE ONLY)' if len(j)<10 else ''}")

print("\n=== A5 1990->1996 reversal: does it survive winsorizing, and within tier? ===")
for t in ['POOLED','T1_low','T2_mid','T3_high']:
    s=bm if t=='POOLED' else bm[bm.tier==t]; j=s[s.j==1]; n=s[s.j==0]
    print(f"  {t:8s} jailed chg90-96 raw {j[W96].mean()-j[W90].mean():+9,.0f} wz {j.wz96.mean()-j.wz90.mean():+9,.0f} | "
          f"nonjailed raw {n[W96].mean()-n[W90].mean():+9,.0f} wz {n.wz96.mean()-n.wz90.mean():+9,.0f} | "
          f"% of jailed declining: {(j[W96]<j[W90]).mean()*100:.0f}% vs nonjailed {(n[W96]<n[W90]).mean()*100:.0f}%")
print("\n  Wilcoxon signed-rank jailed 1990 vs 1996:")
from scipy.stats import wilcoxon
j=bm[bm.j==1]
print("   all jailed:", wilcoxon(j[W96],j[W90]))
print("   T3 jailed :", wilcoxon(bm[(bm.j==1)&(bm.tier=='T3_high')][W96],bm[(bm.j==1)&(bm.tier=='T3_high')][W90]))

print("\n=== A6 ratio trajectory, black males POOLED and by tier (item 6 headline) ===")
for t in ['POOLED','T1_low','T2_mid','T3_high']:
    s=bm if t=='POOLED' else bm[bm.tier==t]; j=s[s.j==1]; n=s[s.j==0]
    rs=[(j[w].mean()/n[w].mean() if n[w].mean() else np.nan) for w in [W85,W90,W96]]
    print(f"  {t:8s} ratio 85/90/96 = {rs[0]:.3f} -> {rs[1]:.3f} -> {rs[2]:.3f}")

print("\n=== A7 sensitivity: drop 5 largest wealth obs (top-5 leverage check), pooled 1996 gap ===")
big=bm.nlargest(5,W96).index; s=bm.drop(big)
j,n=s[s.j==1],s[s.j==0]
print(f"  without top-5: jailed {j[W96].mean():,.0f} vs non {n[W96].mean():,.0f} gap {j[W96].mean()-n[W96].mean():+,.0f} ratio {j[W96].mean()/n[W96].mean():.3f}")
A1.to_csv('analysis/out/A1_tier_ordering.csv',index=False)
