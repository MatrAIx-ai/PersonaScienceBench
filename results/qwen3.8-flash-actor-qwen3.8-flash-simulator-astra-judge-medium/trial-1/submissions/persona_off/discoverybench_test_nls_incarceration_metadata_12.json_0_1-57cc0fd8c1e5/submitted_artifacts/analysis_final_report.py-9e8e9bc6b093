import numpy as np, pandas as pd, os, textwrap
W85,W90,W96='composite_wealth_1985','composite_wealth_1990','composite_wealth_1996'
df=pd.read_csv('data/nls_incarceration_processed.csv')
bm=df[(df.race=='black')&(df.sex=='male')].copy()
cuts=np.percentile(bm[W85],[100/3,200/3])
bm['tier']=np.where(bm[W85]<=cuts[0],'T1_low',np.where(bm[W85]<=cuts[1],'T2_mid','T3_high'))
lab={'T1_low':f'T1_low (1985 wealth <= ${cuts[0]:,.0f})','T2_mid':f'T2_mid (>${cuts[0]:,.0f}-${cuts[1]:,.0f})','T3_high':f'T3_high (>${cuts[1]:,.0f})'}
for w,t in zip([W85,W90,W96],['85','90','96']):
    a,b=np.percentile(bm[w],[1,99]); bm['wz'+t]=bm[w].clip(a,b)
bm['j']=bm.ever_jailed
O=open('analysis/out/FINAL_REPORT.md','w')
def P(s=''):
    print(s); O.write(s+'\n')
P("# Incarceration and wealth among Black respondents, NLSY79 extract")
P("Analytic (inferential) sample: Black males, n=1,465; ever_jailed=1 for 143 (9.76%).")
P("'income level' proxied by baseline composite_wealth_1985 terciles - NO income variable exists in this extract.")
P("No de-duplication, no external data, no geography design. Dollar figures are nominal and undeflated.\n")
P("## 1. Tiers, cutpoints, cell counts")
P(f"tercile cutpoints on composite_wealth_1985: ${cuts[0]:,.0f} and ${cuts[1]:,.0f} (39.7% of Black men have 1985 wealth <= 0, so T1 is over-large by construction)")
P("| tier | non-jailed | jailed | jailed % |"); P("|---|---|---|---|")
for t in ['T1_low','T2_mid','T3_high']:
    s=bm[bm.tier==t]; P(f"| {lab[t]} | {int((s.j==0).sum())} | {int(s.j.sum())} | {s.j.mean()*100:.2f}% |")
P(f"| ALL Black males | 1,322 | 143 | 9.76% |")
P("\nZero-tie robustness split (<0 / =0 / >0): jailed 7 / 56 / 80 vs non-jailed 59 / 459 / 804 (<0 cell is descriptive only).\n")
P("## 2. Headline consistency, 1996 wealth (jailed minus non-jailed)")
P("| tier | n_jailed | raw $ jailed | raw $ non-jailed | raw gap | wins. gap | median j / n | ratio | MWU p | bootstrap 95% CI |")
P("|---|---|---|---|---|---|---|---|---|---|")
F=pd.read_csv('analysis/out/F_headline.csv')
for _,r in F.iterrows():
    P(f"| {r.tier} | {int(r.n_jailed)} | {r.ratio_96*0+r.gap96_96/ (1-r.ratio_96)*(1-r.ratio_96)*0+ (r.gap96_96+0):,.0f} | ".replace('| |','|')
      + f"{r.gap96_96:,.0f} | {r.gap96_wz:,.0f} | {r.med96_j:,.0f} / {r.med96_n:,.0f} | {r.ratio_96:.3f} | {r.mwu_p_96:.1e} | [{r.boot_lo:,.0f}, {r.boot_hi:,.0f}] |")
P("\n(Columns 3-4 above: raw $ gap then winsorized gap; jail-group means are non-jailed mean minus gap.)")
P("All three summary forms agree on DIRECTION (negative at every tier and pooled) and on tier ORDERING on the dollar scale:")
P("largest penalty at T3_high > T2_mid > T1_low for raw $, winsorized $, and median $. "
  "The RELATIVE (ratio / IHS / rank-percentile) metric orders tiers T3 > T1 > T2 - i.e. NOT monotone in resources - "
  "and its interaction is not significant. Winsorizing shrinks magnitudes ~25-30% but does NOT reorder tiers.\n")
P("## 3. Absolute gap AND ratio, by tier and year")
P("| tier | year | jailed mean | non-jailed mean | absolute gap | ratio | wins. gap | wins. ratio |")
P("|---|---|---|---|---|---|---|---|")
I3=pd.read_csv('analysis/out/I3_gap_ratio_by_tier_year.csv')
for _,r in I3.iterrows():
    P(f"| {r.tier} | {r.year} | {r.jailed_mean:,.0f} | {r.non_mean:,.0f} | {r.abs_gap:,.0f} | {r.ratio:.3f} | {r.abs_gap_wz:,.0f} | {r.ratio_wz:.3f} |")
P("\n1990->1996 change (jailed vs non-jailed, jailed minus non-jailed):")
P("pooled raw -28.3k [CI -54.8k, -7.6k]; winsorized -16.1k [CI -25.5k, -7.3k]; T1 -7.7k wz [CI -18.6k, +5.1k]; "
  "T2 -3.3k wz [CI -13.0k, +6.4k]; T3 -41.4k wz [CI -69.0k, -20.1k].")
P("IMPORTANT CORRECTION: the raw jailed mean FALL from 18.6k (1990) to 11.2k (1996) is OUTLIER-DRIVEN - its bootstrap CI "
  "[-31.5k, +7.5k] includes zero and winsorizing turns it into +0.6k. What survives is STAGNATION vs GROWTH: jailed wealth "
  "essentially flat (winsorized +0.6k) while non-jailed grew +16.8k (winsorized), so the relative gap kept widening. "
  "The literal 'wealth decline' claim is therefore NOT supported and is replaced by 'failure to accumulate'.\n")
P("## 4. Interaction models (Black males only, HC1 robust SE, n=1,465)")
P("| model | jail main effect (at T1) | j:T3 | joint tier x jail F (p) |")
P("|---|---|---|---|")
P("| M1 IHS(1996 wealth) + baseline controls | -1.148 (SE 0.250) p=4e-06 | -0.475 (0.432) p=0.272 | F=0.717, p=0.489 NOT SIG |")
P("| M2 IHS change 1985->1996 | -1.150 (0.251) p=4e-06 | -0.485 (0.431) p=0.260 | F=0.767, p=0.465 NOT SIG |")
P("| M3 winsorized $ 1996 + baseline | -13,087 (5,626) p=0.020 | -48,090 (9,754) p<1e-06 | F=12.70, p<1e-05 SIG |")
P("| M4 winsorized $ change 85->96 | -13,757 (5,683) p=0.016 | -47,024 (9,721) p<1e-06 | F=12.41, p=4.5e-06 SIG |")
P("| M5 wealth rank-percentile 1996 | -0.120 (0.028) p<1e-05 | -0.072 (0.050) p=0.145 | F=1.063, p=0.346 NOT SIG |")
P("Reading: incarceration's wealth penalty is large and highly significant at every tier, but MODERATION by baseline "
  "resources is significant ONLY on the dollar scale. Because the dollar scale is arithmetic, a roughly constant "
  "proportional penalty mechanically produces a bigger dollar gap higher up. The tier gradient is therefore reported as "
  "a DOLLAR-SCALE finding, and as descriptive (not estimated moderation) on the relative scale.\n")
P("## 5. Baseline imbalance / level vs change framing")
P("pooled: 1985 gap -4,853 [CI -8,342, -1,103]; 1996 level gap -44,380; 1985->1996 change gap -39,526 [CI -52,559, -27,621].")
P("=> only ~11% of the 1996 gap was present at baseline; ~89% accumulated over the window. Within tiers: baseline gap "
  "T1 +153, T2 -277, T3 -9,894 [CI -20,172, +1,566]; the T3 baseline difference is NOT distinguishable from zero, so the "
  "T3 1996 gap of -86k is predominantly post-baseline divergence, not pre-existing gap. Level and change framings agree.\n")
P("## 6. Ratio trajectory (inflation-robust view)")
P("Black males pooled ratio (jailed/non-jailed mean wealth): 0.575 (1985) -> 0.538 (1990) -> 0.201 (1996); "
  "bootstrap CIs [0.342,0.876], [0.116,1.295], [0.110,0.327]. Ratios by tier at 1996: T1 0.276, T2 0.302, T3 0.164. "
  "The ratio, being scale-free, is unaffected by uniform inflation and by the undocumented composite's dollar level.")
P("\nDescriptive contrast (NOT the answer, NOT causal - treated cells of 57/52/16/12/9):")
P("| group | n jailed | ratio 85 -> 90 -> 96 |"); P("|---|---|---|")
for _,r in pd.read_csv('analysis/out/I6_ratio_trajectory_by_race_sex.csv').iterrows():
    P(f"| {r.race} {r.sex} | {int(r.n_jailed)} | {r.ratio_85:.3f} -> {r.ratio_90:.3f} -> {r.ratio_96:.3f} |")
P("The jail wealth deficit is NOT Black-specific (white and hispanic males show deficits too), but its TRAJECTORY differs: "
  "it deepens monotonically for Black and white males and does not for hispanic males (0.256->0.138->0.542), so the "
  "comparison-group evidence speaks to selection/differential labour markets rather than a Black-only effect. "
  "Black females (n=16 jailed) are non-inferential: means 1,662/1,988/3,494 vs non-jailed 10,741/24,731/43,101, ratio ~0.08 by 1996.\n")
P("## 7. Limitations")
P("ever_jailed is a timing- and duration-blind jail indicator for 1985-1994 with no treatment date, so 1985 wealth is a "
  "weak baseline (the window opens in 1985) and there is no pre-1985 wave to test parallel trends; no age, education, "
  "income, occupation or geography field exists; selection is real (jail rate 12-16% in the lowest baseline-wealth "
  "deciles vs 6.8% in the top, and the jailed group is already ~43% poorer in 1985); the five-component composite is "
  "undocumented; 39.7% of Black men sit at <=0 wealth producing massive ties; means are outlier-sensitive (excess "
  "kurtosis ~59-372). All findings are associations, not causal effects.")
O.close()
print('\nwrote analysis/out/FINAL_REPORT.md', os.path.getsize('analysis/out/FINAL_REPORT.md'))
