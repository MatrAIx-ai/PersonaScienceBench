import numpy as np, pandas as pd
from scipy.stats import mannwhitneyu
rng=np.random.default_rng(99)
W85,W90,W96='composite_wealth_1985','composite_wealth_1990','composite_wealth_1996'
df=pd.read_csv('data/nls_incarceration_processed.csv')
bm=df[(df.race=='black')&(df.sex=='male')].copy()
cuts=np.percentile(bm[W85],[100/3,200/3])
bm['tier']=np.where(bm[W85]<=cuts[0],'T1_low',np.where(bm[W85]<=cuts[1],'T2_mid','T3_high'))
for w,t in zip([W85,W90,W96],['85','90','96']):
    a,b=np.percentile(bm[w],[1,99]); bm['wz'+t]=bm[w].clip(a,b)
bm['j']=bm.ever_jailed
def bci(a,b,nb=5000):
    a=np.asarray(a,float);b=np.asarray(b,float)
    d=[rng.choice(a,len(a)).mean()-rng.choice(b,len(b)).mean() for _ in range(nb)]
    return np.mean(d),np.percentile(d,[2.5,97.5])
def bmean(a,nb=5000):
    a=np.asarray(a,float); d=[rng.choice(a,len(a)).mean() for _ in range(nb)]
    return np.mean(a),np.percentile(d,[2.5,97.5])

print("=== F1 IS THE 1990->1996 JAILED DECLINE REAL? (bootstrap of jailed mean change) ===")
for t in ['POOLED','T3_high']:
    s=bm if t=='POOLED' else bm[bm.tier==t]; j=s[s.j==1]
    m,ci=bmean(j[W96]-j[W90]); mw,wc=bmean(j.wz96-j.wz90)
    print(f"  {t:8s} raw chg mean {m:+9,.0f} CI [{ci[0]:+,.0f},{ci[1]:+,.0f}] | winsorized {mw:+9,.0f} CI [{wc[0]:+,.0f},{wc[1]:+,.0f}]")
    mn,mc=bmean(j[W96]); m9,c9=bmean(j[W90])
    print(f"           jailed mean90 {mn:,.0f} CI[{c9[0]:,.0f},{c9[1]:,.0f}] vs mean96 {m9:,.0f} CI[{mc[0]:,.0f},{mc[1]:,.0f}]")

print("\n=== F2 GAP IN 1990->1996 CHANGE (jailed - nonjailed), raw & winsorized, per tier, bootstrap CI ===")
for t in ['POOLED','T1_low','T2_mid','T3_high']:
    s=bm if t=='POOLED' else bm[bm.tier==t]; j=s[s.j==1]; n=s[s.j==0]
    m,ci=bci(j[W96]-j[W90],n[W96]-n[W90]); mw,cw=bci(j.wz96-j.wz90,n.wz96-n.wz90)
    print(f"  {t:8s} raw {m:+9,.0f} CI[{ci[0]:+,.0f},{ci[1]:+,.0f}] | wz {mw:+9,.0f} CI[{cw[0]:+,.0f},{cw[1]:+,.0f}]")

print("\n=== F3 HEADLINE TABLE (Black males; jailed vs non-jailed) ===")
rows=[]
for t in ['POOLED','T1_low','T2_mid','T3_high']:
    s=bm if t=='POOLED' else bm[bm.tier==t]; j=s[s.j==1]; n=s[s.j==0]
    d={'tier':t,'n_jailed':len(j),'n_non':len(n)}
    for w,tag in zip([W85,W90,W96],['85','90','96']):
        d[f'ratio_{tag}']=j[w].mean()/n[w].mean() if n[w].mean() else np.nan
        d[f'gap96_{tag}']=(j[w].mean()-n[w].mean()) if tag=='96' else np.nan
    d['ratio96_wz']=j.wz96.mean()/n.wz96.mean()
    d['gap96_wz']=j.wz96.mean()-n.wz96.mean()
    d['med96_j'],d['med96_n']=j[W96].median(),n[W96].median()
    d['mwu_p_96']=mannwhitneyu(j[W96],n[W96]).pvalue
    m,ci=bci(j[W96],n[W96]); d['boot_gap96'],d['boot_lo'],d['boot_hi']=m,ci[0],ci[1]
    rows.append(d)
F=pd.DataFrame(rows).round(4); print(F.to_string(index=False))
F.to_csv('analysis/out/F_headline.csv',index=False)

print("\n=== F4 ratio-based widening claim, pooled black males: 0.575 -> 0.538 -> 0.201 ===")
j,n=bm[bm.j==1],bm[bm.j==0]
for w,tag in zip([W85,W90,W96],['85','90','96']):
    r=j[w].mean()/n[w].mean()
    d=[np.mean(rng.choice(j[w],len(j)))/np.mean(rng.choice(n[w],len(n))) for _ in range(3000)]
    print(f"  {tag}: ratio {r:.3f} bootstrap CI [{np.percentile(d,2.5):.3f},{np.percentile(d,97.5):.3f}]")
print("\n=== F5 top-tier share of total dollar gap ===")
tot=abs(F.loc[F.tier=='POOLED','gap96_96'].iloc[0]); 
for t in ['T1_low','T2_mid','T3_high']:
    g=abs(F.loc[F.tier==t,'gap96_96'].iloc[0]); print(f"  {t}: |gap| {g:,.0f} ({g/tot*100:.0f}% of pooled |gap|) with {int(F.loc[F.tier==t,'n_jailed'])} jailed men")
