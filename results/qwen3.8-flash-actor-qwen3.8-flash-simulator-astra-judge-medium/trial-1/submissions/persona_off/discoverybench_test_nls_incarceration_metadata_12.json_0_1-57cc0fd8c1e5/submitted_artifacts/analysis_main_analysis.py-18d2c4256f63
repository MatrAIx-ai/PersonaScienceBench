"""
Main analysis (approved plan). NLSY79 extract: race, sex, ever_jailed, composite_wealth_1985/1990/1996.
Inferential sample: Black males (n=1465; 143 ever_jailed). 'income level' proxied by baseline
composite_wealth_1985 terciles (no income variable exists in this extract).
No row de-duplication, no new datasets, no geography design.
"""
import numpy as np, pandas as pd, os
import statsmodels.formula.api as smf
from scipy.stats import mannwhitneyu
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 80)
rng = np.random.default_rng(20261022)
OUT = 'analysis/out'; os.makedirs(OUT, exist_ok=True)
W85, W90, W96 = 'composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996'
YRS = [W85, W90, W96]; NB = 5000
df = pd.read_csv('data/nls_incarceration_processed.csv')
R = {}
def rep(name, obj):
    R[name] = obj
    print('\n' + '='*100 + f'\n{name}\n' + '='*100)
    print(obj if isinstance(obj, str) else obj.to_string())

bm = df[(df.race == 'black') & (df.sex == 'male')].copy()
bf = df[(df.race == 'black') & (df.sex == 'female')].copy()
rep('S0 sample sizes', f"full={len(df)}  black={int((df.race=='black').sum())}  "
    f"black_male={len(bm)} (jailed={int(bm.ever_jailed.sum())})  black_female={len(bf)} (jailed={int(bf.ever_jailed.sum())})")

def ihs(s, scale=1000.0): return np.arcsinh(s / scale)
for d in (bm, bf):
    for w, tag in zip(YRS, ['85', '90', '96']):
        d['ihs' + tag] = ihs(d[w]); d['w' + tag] = w
    d['chg_96_85'] = d[W96] - d[W85]; d['dichg'] = d['ihs96'] - d['ihs85']

def winsor(s, lo=1, hi=99):
    a, b = np.percentile(s, [lo, hi]); return s.clip(a, b), (round(a), round(b))
bounds = {}
for tag, w in zip(['85', '90', '96'], YRS):
    bm['wz' + tag], bounds['w' + tag] = winsor(bm[w])
for v in ['chg_96_85', 'dichg']:
    bm[v + '_wz'], bounds[v] = winsor(bm[v])
rep('S1 winsorization bounds (pooled Black-male 1st/99th pct, applied to ALL Black males incl. controls)',
    "\n".join(f"{k}: [{v[0]}, {v[1]}]" for k, v in bounds.items()))

# ITEM 1: tiers, cutpoints, cell counts
cuts = np.percentile(bm[W85], [100/3, 200/3])
bm['tier'] = np.where(bm[W85] <= cuts[0], 'T1_low', np.where(bm[W85] <= cuts[1], 'T2_mid', 'T3_high'))
tier_lab = {'T1_low': f'T1_low (<=${cuts[0]:,.0f})', 'T2_mid': f'T2_mid (>${cuts[0]:,.0f} to ${cuts[1]:,.0f}]',
            'T3_high': f'T3_high (>${cuts[1]:,.0f})'}
ct = pd.crosstab(bm.tier, bm.ever_jailed).rename(index=tier_lab)
ct.columns = ['non_jailed', 'jailed']; ct['total'] = ct.sum(1); ct['jailed_%'] = (ct.jailed/ct.total*100).round(2)
ct.loc['ALL'] = ct.sum(); ct.loc['ALL', 'jailed_%'] = (ct.loc['ALL', 'jailed']/ct.loc['ALL', 'total']*100).round(2)
rep('I1a tercile cutpoints on composite_wealth_1985 (Black males) = %.0f and %.0f ; share with 1985 wealth<=0 = %.1f%%'
    % (cuts[0], cuts[1], (bm[W85] <= 0).mean()*100), ct)
alt = np.where(bm[W85] < 0, 'A_neg', np.where(bm[W85] == 0, 'B_zero', 'C_pos'))
altdf = bm.assign(alt=alt)
ct2 = pd.crosstab(altdf.alt.rename(index={'A_neg': '<0 (descriptive only)', 'B_zero': '=0', 'C_pos': '>0'}),
                  altdf.ever_jailed).rename(columns={0: 'non_jailed', 1: 'jailed'})
ct2['total'] = ct2.sum(1)
rep('I1b alternative <0 / =0 / >0 split of composite_wealth_1985 (Black males)', ct2)

def boot_ci(a, b, nb=NB):
    a = np.asarray(a, float); b = np.asarray(b, float)
    d = [rng.choice(a, len(a)).mean() - rng.choice(b, len(b)).mean() for _ in range(nb)]
    return np.percentile(d, [2.5, 97.5]), a.mean() - b.mean()

# ITEMS 2 & 3
def full_contrast(sub, tag):
    nj = int(sub.ever_jailed.sum())
    if nj < 2:
        return {'cell': tag, 'note': f'treated n={nj} -> DESCRIPTIVE ONLY',
                'jailed_mean_96': sub[sub.ever_jailed == 1][W96].mean() if nj else np.nan}
    j, n = sub[sub.ever_jailed == 1], sub[sub.ever_jailed == 0]
    o = {'cell': tag, 'n_jailed': nj, 'n_non': len(n)}
    for lbl, a, b in [('lvl_raw', j[W96], n[W96]), ('lvl_wz', j.wz96, n.wz96),
                      ('chg_raw', j.chg_96_85, n.chg_96_85), ('chg_wz', j.chg_96_85_wz, n.chg_96_85_wz),
                      ('ihs96', j.ihs96, n.ihs96)]:
        a = np.asarray(a, float); b = np.asarray(b, float)
        ci, d = boot_ci(a, b)
        o[lbl + '_jailed'], o[lbl + '_non'], o[lbl + '_gap'] = a.mean(), b.mean(), d
        o[lbl + '_lo'], o[lbl + '_hi'] = ci
        if lbl == 'lvl_raw':
            o['med_jailed'], o['med_non'], o['gap_med'] = np.median(a), np.median(b), np.median(a) - np.median(b)
            o['ratio_raw'] = a.mean()/b.mean() if b.mean() else np.nan
            o['mw_p'] = mannwhitneyu(a, b, alternative='two-sided').pvalue
    o['ratio_wz'] = j.wz96.mean()/n.wz96.mean() if n.wz96.mean() else np.nan
    return o

rows = [full_contrast(bm, 'POOLED Black males')]
for t in ['T1_low', 'T2_mid', 'T3_high']:
    rows.append(full_contrast(bm[bm.tier == t], tier_lab[t]))
I2 = pd.DataFrame(rows); num = I2.select_dtypes(include=[np.number]).columns
I2[num] = I2[num].round(4)
rep('I2 headline consistency (1996 level + 1985->1996 change): raw means / winsorized means / medians / IHS, with MWU p and 5000-draw bootstrap CI (jailed minus non-jailed)', I2)

g3 = []
for t in ['POOLED', 'T1_low', 'T2_mid', 'T3_high']:
    sub = bm if t == 'POOLED' else bm[bm.tier == t]
    for y, tag in zip(YRS, ['85', '90', '96']):
        j, n = sub[sub.ever_jailed == 1][y], sub[sub.ever_jailed == 0][y]
        jw, nw = sub[sub.ever_jailed == 1]['wz' + tag], sub[sub.ever_jailed == 0]['wz' + tag]
        g3.append(dict(tier=t, year=tag, n_jailed=len(j), n_non=len(n),
                       jailed_mean=j.mean(), non_mean=n.mean(), abs_gap=j.mean()-n.mean(),
                       ratio=j.mean()/n.mean() if n.mean() else np.nan,
                       jailed_mean_wz=jw.mean(), non_mean_wz=nw.mean(), abs_gap_wz=jw.mean()-nw.mean(),
                       ratio_wz=jw.mean()/nw.mean() if nw.mean() else np.nan,
                       jailed_med=j.median(), non_med=n.median()))
I3 = pd.DataFrame(g3).round(3)
rep('I3 absolute gap AND jailed/non-jailed ratio by tier x year (raw + winsorized means, medians)', I3)
print('\n-- I3 tier ORDERING of the 1996 gap, three metrics --')
p = I3[(I3.year == '96') & (I3.tier != 'POOLED')].set_index('tier')
print(p[['abs_gap', 'abs_gap_wz', 'ratio', 'ratio_wz']].join(
      I2.set_index('cell').loc[[tier_lab[t] for t in ['T1_low','T2_mid','T3_high']], ['gap_med']]).round(3).to_string())

rev = []
for t in ['POOLED', 'T1_low', 'T2_mid', 'T3_high']:
    sub = bm if t == 'POOLED' else bm[bm.tier == t]
    for grp, lab in [(1, 'jailed'), (0, 'non_jailed')]:
        s = sub[sub.ever_jailed == grp]
        rev.append(dict(tier=t, group=lab, n=len(s), mean90=s[W90].mean(), mean96=s[W96].mean(),
                        chg_raw=s[W96].mean()-s[W90].mean(), chg_wz=s.wz96.mean()-s.wz90.mean(),
                        med90=s[W90].median(), med96=s[W96].median(), pct_declining=(s[W96] < s[W90]).mean()*100))
I3b = pd.DataFrame(rev).round(2)
rep('I3b 1990 -> 1996 change, jailed vs non-jailed, pooled and within tier (raw, winsorized, medians, %declining)', I3b)
print('\n-- I3b jailed-minus-non-jailed 1990->1996 gap in change, per tier --')
for t in ['POOLED', 'T1_low', 'T2_mid', 'T3_high']:
    r = I3b[I3b.tier == t].set_index('group')
    print(f"  {t:8s} raw {r.loc['jailed','chg_raw']-r.loc['non_jailed','chg_raw']:+10,.0f} | winsorized {r.loc['jailed','chg_wz']-r.loc['non_jailed','chg_wz']:+10,.0f}")

# ITEM 5
base = []
for t in ['POOLED', 'T1_low', 'T2_mid', 'T3_high']:
    sub = bm if t == 'POOLED' else bm[bm.tier == t]
    j, n = sub[sub.ever_jailed == 1], sub[sub.ever_jailed == 0]
    ci_b, d_b = boot_ci(j[W85], n[W85]); ci_c, d_c = boot_ci(j.chg_96_85, n.chg_96_85)
    gap96 = j[W96].mean() - n[W96].mean()
    base.append(dict(tier=t, n_jailed=len(j), n_non=len(n), base85_j=j[W85].mean(), base85_n=n[W85].mean(),
                     base85_gap=d_b, base85_lo=ci_b[0], base85_hi=ci_b[1],
                     base85_med_j=j[W85].median(), base85_med_n=n[W85].median(),
                     lvl96_j=j[W96].mean(), lvl96_n=n[W96].mean(), lvl96_gap=gap96,
                     chg_j=j.chg_96_85.mean(), chg_n=n.chg_96_85.mean(), chg_gap=d_c, chg_lo=ci_c[0], chg_hi=ci_c[1],
                     pct_gap96_already_at_base=abs(d_b)/abs(gap96)*100 if gap96 else np.nan))
I5 = pd.DataFrame(base).round(2)
rep('I5 baseline-1985 imbalance vs 1996 level gap vs 1985->1996 change gap (level AND change framing)', I5)
r = I5[I5.tier == 'POOLED'].iloc[0]
print(f"\nLevel-vs-change decomposition (pooled Black males): 1996 level gap {r.lvl96_gap:+,.0f} = "
      f"baseline 1985 gap {r.base85_gap:+,.0f} + change gap {r.chg_gap:+,.0f}  "
      f"({r.pct_gap96_already_at_base:.0f}% of the 1996 gap was already present in 1985)")

# ITEM 4: pooled interaction models, Black males only
bm['t2'] = (bm.tier == 'T2_mid').astype(int); bm['t3'] = (bm.tier == 'T3_high').astype(int); bm['j'] = bm.ever_jailed
M = {}
specs = [('M1_ihs96_levels_ANCOVA', 'ihs96 ~ j + t2 + t3 + j:t2 + j:t3 + ihs85 + wz85'),
         ('M2_ihs_change',         'dichg ~ j + t2 + t3 + j:t2 + j:t3 + ihs85'),
         ('M3_wz96_levels',        'wz96 ~ j + t2 + t3 + j:t2 + j:t3 + wz85')]
for nm, f in specs:
    m = smf.ols(f, data=bm).fit(cov_type='HC1')
    wt = m.f_test('j:t2 = 0, j:t3 = 0')
    M[nm] = (m, pd.DataFrame({'coef': m.params, 'se_HC1': m.bse, 't': m.tvalues, 'p': m.pvalues}).round(4), wt)
    rep(f'I4 {nm} | formula: {f} | n={int(m.nobs)} R2={m.rsquared:.3f} | HC1 robust SEs | joint tier x jail test: F={float(wt.statistic):.3f} p={float(wt.pvalue):.4f}',
        M[nm][1])
m1 = M['M1_ihs96_levels_ANCOVA'][0]
print("\nM1 jail main effect (= effect at T1_low baseline tier): coef %.4f  SE %.4f  p=%.3g" %
      (m1.params['j'], m1.bse['j'], m1.pvalues['j']))
print("M1 jail main effect on POOLED model without interaction:")
m0 = smf.ols('ihs96 ~ j + ihs85 + wz85 + t2 + t3', data=bm).fit(cov_type='HC1')
print("  j coef %.4f SE %.4f p=%.3g  | 95%% CI [%.3f, %.3f]" % (m0.params['j'], m0.bse['j'], m0.pvalues['j'],
      m0.conf_int().loc['j', 0], m0.conf_int().loc['j', 1]))

# ITEM 6: ratio trajectory by race x sex (descriptive) + black-male tiers
traj = []
for race in ['black', 'hipanic', 'white']:
    for sex in ['male', 'female']:
        s = df[(df.race == race) & (df.sex == sex)]
        d = dict(race=race, sex=sex, n_jailed=int(s.ever_jailed.sum()), n_non=int((s.ever_jailed == 0).sum()))
        for y, tag in zip(YRS, ['85', '90', '96']):
            jm, nm_ = s[s.ever_jailed == 1][y].mean(), s[s.ever_jailed == 0][y].mean()
            d['mean_j_' + tag], d['mean_n_' + tag], d['ratio_' + tag] = round(jm), round(nm_), (jm/nm_ if nm_ else np.nan)
        d['flag'] = 'INFERENTIAL' if (race == 'black' and sex == 'male') else ('descriptive only (treated n=%d)' % d['n_jailed'])
        traj.append(d)
I6 = pd.DataFrame(traj).round(3)
rep('I6 jailed/non-jailed wealth RATIO trajectory by race x sex (ratio is invariant to uniform inflation -> inflation-robust view)', I6)
rep('I6b Black males: ratio + abs gap by baseline tier and year',
    I3[I3.tier != 'POOLED'].pivot(index='tier', columns='year', values=['ratio', 'ratio_wz', 'abs_gap']).round(3).to_string())

j, n = bf[bf.ever_jailed == 1], bf[bf.ever_jailed == 0]
rep('I7 Black females (NON-INFERENTIAL)',
    f"Black females, DESCRIPTIVE ONLY, non-inferential (n={len(bf)}; ever_jailed=1 for just {len(j)}; jail rate 1.03% vs 9.76% for Black males): "
    f"mean composite_wealth " + " ; ".join(f"{y[-2:]}: jailed {j[y].mean():,.0f} vs non-jailed {n[y].mean():,.0f}" for y in YRS) +
    f". Medians for the jailed group are 0 in all three years. Same direction as Black males, but n too small for inference.")

with open(OUT + '/tables.md', 'w') as f:
    for k, v in R.items():
        f.write('\n\n## ' + k + '\n\n```\n' + (v if isinstance(v, str) else v.to_string()) + '\n```\n')
for nm, ob in [('I2_headline_consistency', I2), ('I3_gap_ratio_by_tier_year', I3), ('I3b_1990_1996_reversal', I3b),
               ('I5_baseline_vs_change', I5), ('I6_ratio_trajectory_by_race_sex', I6)]:
    ob.to_csv(f'{OUT}/{nm}.csv', index=False)
for nm in M: M[nm][1].to_csv(f'{OUT}/I4_{nm}.csv')
ct.to_csv(OUT + '/I1a_tercile_cells.csv'); ct2.to_csv(OUT + '/I1b_alt_cells.csv')
print('\nSAVED ->', OUT, sorted(os.listdir(OUT)))
