import sys, time, pickle
sys.path.insert(0, "analysis")
import numpy as np, pandas as pd
from nls_wealth_lib import analyse_year, holm, verdict, YEARS, COL, ALPHA

pd.set_option("display.width", 300); pd.set_option("display.max_columns", 80)
df = pd.read_csv("data/nls_incarceration_processed.csv")

assert df.shape == (12013, 6), df.shape
assert df.isna().sum().sum() == 0
assert set(df.ever_jailed.unique()) == {0, 1}

rows, boots = [], {}
for y in YEARS:
    t0 = time.time()
    a = df.loc[df.ever_jailed == 1, COL[y]].to_numpy(float)
    b = df.loc[df.ever_jailed == 0, COL[y]].to_numpy(float)
    rec = analyse_year(a, b, nboot=2000, nperm=20000, seed=20261023 + y)
    rec["year"] = y; rec["dataset"] = "primary_all_rows"
    boots[y] = rec.pop("_boot")
    rows.append(rec)
    print(f"  [{y}] done in {time.time()-t0:.1f}s", flush=True)

r = pd.DataFrame(rows)
for fam, col in [("mwu", "p1_corrected"), ("welch", "welch_p1"), ("fisher", "fisher_p1")]:
    r[f"{fam}_holm_p1"] = holm(r[col].to_numpy())
r[["verdict", "c1_holm", "c2_concordant", "c3_parametric"]] = r.apply(lambda x: pd.Series(verdict(x)), axis=1)

for i, y in enumerate(YEARS):
    a = df.loc[df.ever_jailed == 1, COL[y]].to_numpy(float); b = df.loc[df.ever_jailed == 0, COL[y]].to_numpy(float)
    se_mean = np.sqrt(a.var(ddof=1) / a.size + b.var(ddof=1) / b.size)
    se_hl = np.std(np.concatenate([a, b]), ddof=1) * np.sqrt(1 / a.size + 1 / b.size)
    r.loc[i, "mean_diff_asym_lo"] = r.loc[i, "mean_diff"] - 1.96 * se_mean
    r.loc[i, "mean_diff_asym_hi"] = r.loc[i, "mean_diff"] + 1.96 * se_mean
    r.loc[i, "hl_asym_lo"] = r.loc[i, "hl_shift"] - 1.96 * se_hl
    r.loc[i, "hl_asym_hi"] = r.loc[i, "hl_shift"] + 1.96 * se_hl
r["p_ratio_corr_over_uncorr"] = r["p1_corrected"] / r["p1_uncorrected"]
r.to_csv("analysis/outputs/primary_confirmatory_table.csv", index=False)
with open("analysis/outputs/primary_boot.pkl", "wb") as f:
    pickle.dump({str(k): v for k, v in boots.items()}, f)

print("\n" + "=" * 118 + "\nA. DESCRIPTIVES (primary: all 12,013 rows retained)")
print(r[["year", "n_jailed", "n_nonjailed", "mean_jailed", "mean_nonjailed", "mean_diff",
         "median_jailed", "median_nonjailed", "median_diff", "p25_jailed", "p75_jailed",
         "p25_nonjailed", "p75_nonjailed", "hl_shift", "cliffs_delta",
         "ppos_jailed", "ppos_nonjailed", "rr_pos"]].round(3).to_string(index=False))

print("\nB. INFERENCE (one-sided H1: jailed < non-jailed)")
print(r[["year", "p1_corrected", "p2_corrected", "p1_scipy", "p2_scipy", "p_perm", "p1_uncorrected",
         "tie_term", "tied_pair_frac", "p_ratio_corr_over_uncorr", "mwu_holm_p1", "welch_p1", "welch_p2", "fisher_p1", "fisher_holm_p1"]].to_string(
    index=False, formatters={c: "{:.3e}".format for c in
        ["p1_corrected", "p2_corrected", "p1_scipy", "p2_scipy", "p1_uncorrected", "mwu_holm_p1",
         "welch_p1", "welch_p2", "fisher_p1", "fisher_holm_p1"]}))

print("\nC. DECISION RULE  (Holm-MWU p<0.05  AND  median/HL/delta all<0  AND  Welch one-sided p<0.05)")
print(r[["year", "c1_holm", "c2_concordant", "c3_parametric", "verdict"]].to_string(index=False))

print("\nD. CIs  -- stratified percentile bootstrap (2000) vs asymptotic")
for i, y in enumerate(YEARS):
    x = r.iloc[i]
    print(f"{y}  HL      boot[{x.hl_boot_lo:>10,.0f},{x.hl_boot_hi:>10,.0f}]  asym[{x.hl_asym_lo:>10,.0f},{x.hl_asym_hi:>10,.0f}]")
    print(f"     medianD boot[{x.median_diff_boot_lo:>10,.0f},{x.median_diff_boot_hi:>10,.0f}]  point {x.median_diff:>10,.0f}")
    print(f"     meanD   boot[{x.mean_diff_boot_lo:>10,.0f},{x.mean_diff_boot_hi:>10,.0f}]  asym[{x.mean_diff_asym_lo:>10,.0f},{x.mean_diff_asym_hi:>10,.0f}]")
    print(f"     delta   boot[{x.delta_boot_lo:>10.3f},{x.delta_boot_hi:>10.3f}]  asym[{x.delta_asym_lo:>10.3f},{x.delta_asym_hi:>10.3f}]")
    print(f"     RR>0    [{x.rr_lo:.3f},{x.rr_hi:.3f}]  (jailed {x.ppos_jailed:.3f} vs non-jailed {x.ppos_nonjailed:.3f})")
print("\nwrote analysis/outputs/primary_confirmatory_table.csv")
