"""Replace the crude SD-based HL interval with a legitimate Hollander-Wolfe rank-based CI
for the Hodges-Lehmann shift, and re-save the primary table.
HW: CI = [D_(C), D_(n1*n2+1-C)],  C = n1*n2/2 - z_{.975}*sqrt(n1*n2*(n1+n2+1)/12)  (tie-uncorrected
=> conservative). Uses the exact order statistics of the n1*n2 pairwise differences."""
import numpy as np, pandas as pd
from scipy import stats
from nls_wealth_lib import YEARS, COL
import sys; sys.path.insert(0, "analysis")

df = pd.read_csv("data/nls_incarceration_processed.csv")
t = pd.read_csv("analysis/outputs/primary_confirmatory_table.csv")
for i, y in enumerate(YEARS):
    a = df.loc[df.ever_jailed == 1, COL[y]].to_numpy(float)
    b = df.loc[df.ever_jailed == 0, COL[y]].to_numpy(float)
    D = np.sort((a[:, None] - b[None, :]).ravel())          # 289 x 11724 = 3.39M diffs
    N = D.size
    C = N / 2 - stats.norm.ppf(0.975) * np.sqrt(a.size * b.size * (a.size + b.size + 1) / 12.0)
    C = max(1, int(np.ceil(C)))
    t.loc[i, "hl_hw_ci_lo"] = D[C - 1]
    t.loc[i, "hl_hw_ci_hi"] = D[N - C]
    print(f"{y}: HL={t.loc[i,'hl_shift']:>9,.0f}  Hollander-Wolfe[{D[C-1]:>9,.0f}, {D[N-C]:>9,.0f}]  "
          f"bootstrap[{t.loc[i,'hl_boot_lo']:>9,.0f}, {t.loc[i,'hl_boot_hi']:>9,.0f}]  "
          f"crude-SD-asym[{t.loc[i,'hl_asym_lo']:>9,.0f}, {t.loc[i,'hl_asym_hi']:>9,.0f}]  (pairwise diffs={N:,})")
t.to_csv("analysis/outputs/primary_confirmatory_table.csv", index=False)
print("saved")
