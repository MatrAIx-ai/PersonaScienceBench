"""
Shared machinery for the NLSY-79 incarceration/wealth contrast.

Question: in which years (1985, 1990, 1996) is wealth of individuals with a criminal record
(ever_jailed == 1) significantly LOWER than that of individuals without (ever_jailed == 0)?

Wealth here is heavy-tailed (skew 6-17), zero-inflated (24-54% exact zeros) and contains real
negatives (min -866,400), so a shifted-log transform is unusable (it would need a shift > $866k).
The primary test is therefore the tie-corrected one-sided Mann-Whitney U, backed by a
distribution-free permutation null, with Welch's t on raw dollars as an anti-conservative
robustness check only.
"""
import numpy as np
from scipy import stats

ALPHA = 0.05
YEARS = [1985, 1990, 1996]
COL = {y: f"composite_wealth_{y}" for y in YEARS}


def holm(pvals):
    """Holm-Bonferroni step-down adjusted p-values (returned in input order)."""
    p = np.asarray(pvals, float)
    m = len(p)
    order = np.argsort(p)
    adj = np.empty(m)
    running = 0.0
    for rank, idx in enumerate(order):
        running = max(running, (m - rank) * p[idx])
        adj[idx] = min(1.0, running)
    return adj


def mwu(a, b):
    """Mann-Whitney U (a = jailed) with tie-corrected and UNCORRECTED normal approximations."""
    n, m = len(a), len(b)
    both = np.concatenate([a, b])
    U = stats.rankdata(both)[:n].sum() - n * (n + 1) / 2.0
    mu = n * m / 2.0
    _, cnt = np.unique(both, return_counts=True)
    # Hollander-Wolfson tie term, subtracted from (n+m+1) inside the variance.
    tie_term = float((cnt ** 3 - cnt).sum() / ((n + m) * (n + m - 1)))
    var_c = (n * m / 12.0) * ((n + m + 1) - tie_term)
    var_u = n * m * (n + m + 1) / 12.0
    z_c = (U - mu) / np.sqrt(var_c)
    z_u = (U - mu) / np.sqrt(var_u)
    return dict(
        U=float(U),
        z_corrected=z_c, p1_corrected=float(stats.norm.cdf(z_c)), p2_corrected=float(2 * stats.norm.cdf(-abs(z_c))),
        z_uncorrected=z_u, p1_uncorrected=float(stats.norm.cdf(z_u)),
        tie_term=tie_term, se_delta=2 * np.sqrt(var_c) / (n * m),
        tied_pair_frac=float((cnt * (cnt - 1)).sum() / ((n + m) * (n + m - 1))),
    )


def hl_shift(a, b):
    """Exact Hodges-Lehmann shift = median of all n*m pairwise differences a_i - b_j."""
    a = np.sort(np.asarray(a, float)); b = np.sort(np.asarray(b, float))
    n, m = a.size, b.size
    k = (n * m + 1) // 2

    def count_le(v):  # number of pairs with a_i - b_j <= v
        return int((m - np.searchsorted(b, a - v, side="left")).sum())

    lo, hi = int(np.floor(a[0] - b[-1])), int(np.ceil(a[-1] - b[0]))
    while lo < hi:
        mid = (lo + hi) // 2
        if count_le(mid) >= k:
            hi = mid
        else:
            lo = mid + 1
    return float(lo)


def permutation_p(a, b, nperm, seed):
    """Distribution-free one-sided permutation p for U (jailed < non-jailed)."""
    rng = np.random.default_rng(seed)
    a = np.asarray(a, float); b = np.asarray(b, float)
    n1 = a.size
    pool = np.concatenate([a, b])
    obs = stats.rankdata(pool)[:n1].sum() - n1 * (n1 + 1) / 2.0
    cnt = 0
    for _ in range(nperm):
        rp = stats.rankdata(rng.permutation(pool))[:n1].sum() - n1 * (n1 + 1) / 2.0
        cnt += int(rp <= obs)
    return (cnt + 1) / (nperm + 1)


def rr_ci(p1, n1, p0, n0):
    """Risk ratio P(wealth>0 | jailed)/P(wealth>0 | non-jailed) with log-scale 95% CI."""
    if p1 <= 0 or p0 <= 0:
        return np.nan, np.nan, np.nan
    rr = p1 / p0
    se = np.sqrt((1 - p1) / (p1 * n1) + (1 - p0) / (p0 * n0))
    return rr, rr * np.exp(-1.96 * se), rr * np.exp(1.96 * se)


def analyse_year(a, b, nboot=2000, nperm=0, seed=0, boot_seed=None):
    """Full battery for ONE year. a = jailed wealth, b = non-jailed wealth."""
    a = np.asarray(a, float); b = np.asarray(b, float)
    n1, n0 = a.size, b.size
    m = mwu(a, b)
    sp1 = stats.mannwhitneyu(a, b, alternative="less")
    sp2 = stats.mannwhitneyu(a, b, alternative="two-sided")
    t1 = stats.ttest_ind(a, b, equal_var=False, alternative="less")
    t2 = stats.ttest_ind(a, b, equal_var=False)
    fis = stats.fisher_exact([[int((a > 0).sum()), int((a <= 0).sum())],
                              [int((b > 0).sum()), int((b <= 0).sum())]], alternative="less")
    delta = 2 * m["U"] / (n1 * n0) - 1
    hl = hl_shift(a, b)
    rr, rlo, rhi = rr_ci((a > 0).mean(), n1, (b > 0).mean(), n0)
    out = dict(
        n_jailed=n1, n_nonjailed=n0,
        mean_jailed=a.mean(), mean_nonjailed=b.mean(), mean_diff=a.mean() - b.mean(),
        sd_jailed=a.std(ddof=1), sd_nonjailed=b.std(ddof=1),
        median_jailed=float(np.median(a)), median_nonjailed=float(np.median(b)),
        median_diff=float(np.median(a) - np.median(b)),
        p25_jailed=float(np.percentile(a, 25)), p75_jailed=float(np.percentile(a, 75)),
        p25_nonjailed=float(np.percentile(b, 25)), p75_nonjailed=float(np.percentile(b, 75)),
        hl_shift=hl, cliffs_delta=delta,
        delta_asym_lo=delta - 1.96 * m["se_delta"], delta_asym_hi=delta + 1.96 * m["se_delta"],
        p1_corrected=m["p1_corrected"], p2_corrected=m["p2_corrected"],
        p1_scipy=float(sp1.pvalue), p2_scipy=float(sp2.pvalue),
        p1_uncorrected=m["p1_uncorrected"], tie_term=m["tie_term"], tied_pair_frac=m["tied_pair_frac"],
        z_corrected=m["z_corrected"],
        welch_p1=float(t1.pvalue), welch_p2=float(t2.pvalue),
        fisher_p1=float(fis.pvalue),
        ppos_jailed=float((a > 0).mean()), ppos_nonjailed=float((b > 0).mean()),
        rr_pos=rr, rr_lo=rlo, rr_hi=rhi,
    )
    if nperm:
        out["p_perm"] = permutation_p(a, b, nperm, seed)
    if nboot:
        rng = np.random.default_rng(boot_seed if boot_seed is not None else seed + 777)
        keys = ["mean_diff", "median_diff", "hl", "delta"]
        st = {k: np.empty(nboot) for k in keys}
        for i in range(nboot):
            ab = a[rng.integers(0, n1, n1)]
            bb = b[rng.integers(0, n0, n0)]
            st["mean_diff"][i] = ab.mean() - bb.mean()
            st["median_diff"][i] = np.median(ab) - np.median(bb)
            st["hl"][i] = hl_shift(ab, bb)
            st["delta"][i] = 2 * mwu(ab, bb)["U"] / (n1 * n0) - 1
        for k in keys:
            out[f"{k}_boot_lo"] = float(np.percentile(st[k], 2.5))
            out[f"{k}_boot_hi"] = float(np.percentile(st[k], 97.5))
        out["_boot"] = st
    return out


def verdict(rec):
    """Approved rule: Holm-adjusted one-sided MWU p < 0.05 AND concordant negative direction
    (median diff, HL shift, Cliff's delta all < 0) AND parametric (Welch one-sided) p < 0.05."""
    c1 = rec["mwu_holm_p1"] < ALPHA
    c2 = (rec["median_diff"] < 0) and (rec["hl_shift"] < 0) and (rec["cliffs_delta"] < 0)
    c3 = rec["welch_p1"] < ALPHA
    return ("PASS" if (c1 and c2 and c3) else "FAIL"), c1, c2, c3


def run_dataset(df, label, nboot=2000, nperm=0):
    """Run all three years for one data variant, adding within-family Holm adjustment + verdicts."""
    rows, boots = [], {}
    for y in YEARS:
        d = df[[COL[y], "ever_jailed"]].dropna()          # defensive: file has zero missing values
        a = d.loc[d.ever_jailed == 1, COL[y]].to_numpy()
        b = d.loc[d.ever_jailed == 0, COL[y]].to_numpy()
        rec = analyse_year(a, b, nboot=nboot, nperm=nperm, seed=20261023 + y)
        rec["year"] = y
        rec["dataset"] = label
        boots[y] = rec.pop("_boot", None)
        rows.append(rec)
    r = pd.DataFrame(rows)
    for fam, col in [("mwu", "p1_corrected"), ("welch", "welch_p1"), ("fisher", "fisher_p1")]:
        r[f"{fam}_holm_p1"] = holm(r[col].to_numpy())
    r[["verdict", "c1_holm", "c2_concordant", "c3_parametric"]] = r.apply(
        lambda x: pd.Series(verdict(x)), axis=1)
    return r, boots


import pandas as pd  # noqa: E402  (imported late so helpers above stay pandas-free)
