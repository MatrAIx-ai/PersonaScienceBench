import sys, numpy as np, pandas as pd
sys.path.insert(0, "analysis")
from nls_wealth_lib import analyse_year, holm, verdict, YEARS, COL
pd.set_option("display.width", 320); pd.set_option("display.max_columns", 80)
df = pd.read_csv("data/nls_incarceration_processed.csv")
NB, NP = 500, 2000

def run(d, label, nboot=NB, nperm=NP, extra=None):
    rows = []
    for y in YEARS:
        g = d.dropna(subset=[COL[y]])
        a = g.loc[g.ever_jailed == 1, COL[y]].to_numpy(float)
        b = g.loc[g.ever_jailed == 0, COL[y]].to_numpy(float)
        if len(a) < 5 or len(b) < 5:
            rows.append(dict(dataset=label, year=y, n_jailed=len(a), n_nonjailed=len(b), note="insufficient n")); continue
        rec = analyse_year(a, b, nboot=nboot, nperm=nperm, seed=20261023 + y)
        rec.pop("_boot", None); rec.update(year=y, dataset=label)
        if extra: rec["stratum"] = extra
        rows.append(rec)
    r = pd.DataFrame(rows)
    if "p1_corrected" in r:
        r["mwu_holm_p1"] = holm(r["p1_corrected"].to_numpy())
        r["welch_holm_p1"] = holm(r["welch_p1"].fillna(1).to_numpy())
        r["fisher_holm_p1"] = holm(r["fisher_p1"].fillna(1).to_numpy())
        r[["verdict", "c1_holm", "c2_concordant", "c3_parametric"]] = r.apply(lambda x: pd.Series(verdict(x)), axis=1)
    return r

all_cols = ["dataset", "stratum", "year", "n_jailed", "n_nonjailed", "median_jailed", "median_nonjailed",
            "median_diff", "hl_shift", "cliffs_delta", "p1_corrected", "p1_uncorrected", "tied_pair_frac",
            "mwu_holm_p1", "p_perm", "welch_p1", "fisher_p1", "ppos_jailed", "ppos_nonjailed", "rr_pos", "verdict"]

# --- S1: deduplicated ---
dd = df.drop_duplicates()
print(f"S1 dedup: {len(df)} -> {len(dd)} rows; jailed {int(df.ever_jailed.sum())} -> {int(dd.ever_jailed.sum())}")
s1 = run(dd, "s1_dedup")

# --- S2: winsorized at pooled p99 per year (upper tail only) ---
w = df.copy()
for y in YEARS:
    p99 = w[COL[y]].quantile(0.99)
    w[COL[y]] = w[COL[y]].clip(upper=p99)
    print(f"S2 winsor {y}: cap = {p99:,.0f}")
s2 = run(w, "s2_winsor_p99")

# --- S3: race x sex stratified (Holm across the 18 tests) ---
strata = []
for (rc, sx), g in df.groupby(["race", "sex"]):
    strata.append((f"{rc}|{sx}", g))
s3 = pd.concat([run(g, "s3_stratified", nboot=200, nperm=2000, extra=s) for s, g in strata], ignore_index=True)
ok = s3["p1_corrected"].notna()
s3.loc[ok, "mwu_holm_p1_across18"] = holm(s3.loc[ok, "p1_corrected"].to_numpy())
s3.to_csv("analysis/outputs/sensitivity_stratified.csv", index=False)

out = pd.concat([s1, s2], ignore_index=True)
out.to_csv("analysis/outputs/sensitivity_dedup_winsor.csv", index=False)

for r_ in [s1, s2]:
    print("\n" + "=" * 120)
    print(f"{r_.dataset.iloc[0].upper()}")
    print(r_[[c for c in all_cols if c in r_.columns]].round(4).to_string(index=False))

print("\n" + "=" * 120)
print("S3 RACE x SEX STRATIFIED (one-sided MWU; Holm across all 18 tests in last column)")
cols = [c for c in ["stratum", "year", "n_jailed", "n_nonjailed", "median_jailed", "median_nonjailed",
                    "hl_shift", "cliffs_delta", "p1_corrected", "mwu_holm_p1", "mwu_holm_p1_across18",
                    "welch_p1", "fisher_p1", "ppos_jailed", "ppos_nonjailed", "verdict"] if c in s3.columns]
print(s3[cols].round(4).to_string(index=False))
print("\nPer-year count of strata with Holm(within-year) p<0.05 and negative HL:")
print(s3.groupby("year").apply(lambda g: pd.Series({
    "n_strata": len(g), "n_holm_sig": int((g.mwu_holm_p1 < 0.05).sum()),
    "n_sig_neg_HL": int(((g.p1_corrected < 0.05) & (g.hl_shift < 0)).sum())}), include_groups=False))
