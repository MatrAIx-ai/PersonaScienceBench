#!/usr/bin/env bash
# End-to-end reproduction of the NLSY-79 incarceration/wealth analysis.
# Each step was executed in this session (logs/CSVs in analysis/outputs/).
set -euo pipefail
cd "$(dirname "$0")/.."
python3 analysis/run_primary.py      # primary confirmatory battery, all 12,013 rows
python3 analysis/add_hw_ci.py        # Hollander-Wolfe rank CI for the HL shift
python3 analysis/run_sensitivity.py  # dedup, winsor-p99, race x sex stratified
