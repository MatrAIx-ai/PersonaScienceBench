#!/usr/bin/env python3
"""
NLSY79: How does accounting for academic characteristics alter the estimated
associations of socioeconomic status and race with POST-SECONDARY ATTENDANCE /
BA-TRACK PROGRESS (a proxy; no degree credential exists in this file).

Design (pre-registered with researcher):
  Outcomes : O1 grade>=13 (1979) | O2 dorm/frat/sorority 1981-88 | O3 = O1 or O2 (PRIMARY)
             PROSP = strictly prospective (baseline grade<=12 -> dorm 1982-88) [sensitivity]
  Ladder   : M0 race | M1 +sex+age | A +SES | B +academic characteristics
  Family   : logit (HC1) primary; LPM (OLS, HC1) robustness; KHB-style scale-corrected attenuation
  Guardrail: A->B shift = descriptive composition/decomposition, NOT causal adjustment
             (ASVAB/class rank are 1981 measures, partly AFTER the 1979 grade-based outcome).
"""
import numpy as np, pandas as pd, statsmodels.api as sm

pd.set_option("display.width", 240); pd.set_option("display.max_columns", 40)
RAW = "data/nls_raw.csv"
PI3 = np.pi / np.sqrt(3.0)          # SD of standard logistic
ZC = 1.959963985

df = pd.read_csv(RAW)
COL = {
 "id": "ID# (range 1-12686) 1979",
 "age": "Age of respondent, 1979",
 "mom_ed": "Highest grade completed by respondent's mother, 1979",
 "dad_ed": "Highest grade completed by respondent's father, 1979",
 "grade": "Highest grade completed, 1979",
 "race": "Racial/ethnic cohort, 1979",
 "sex": "Sex of respondent, 1979",
 "famsize": "Family size, 1979",
 "inc79": "Total net family income, previous calendar year, 1979",
 "wealth85": "Family net wealth, 1985",
 "rank": "Rank in class last year attended at this school, 1981",
 "classn": "Number of students in class last year attended at this school, 1981",
 "ar": "ASVAB - Arithmetic Reasoning Z Score (rounded), 1981",
 "wk": "ASVAB - Word Knowledge Z Score (rounded), 1981",
 "pc": "ASVAB - Paragraph Comprehension Z Score (rounded), 1981",
 "mk": "ASVAB - Mathematics Knowledge Z Score (rounded), 1981",
}
d = pd.DataFrame({k: df[v] for k, v in COL.items()})
resc = {int(c.split(",")[-1].strip()[:4]): c for c in df.columns
        if c.startswith("Type of residence")}
d["grade_v"] = d.grade.where(d.grade < 20)          # 95 is a sentinel code

# ---- outcomes
d["y_O1"] = (d.grade_v >= 13).astype(float).where(d.grade_v.notna())
d["dorm_81_88"] = (df[[resc[y] for y in resc if 1981 <= y <= 1988]] == 3).any(axis=1)
obs81_88 = df[[resc[y] for y in resc if 1981 <= y <= 1988]].notna().any(axis=1)
d["y_O2"] = d.dorm_81_88.astype(float).where(obs81_88)
d["y_O3"] = ((d.grade_v >= 13) | d.dorm_81_88).astype(float).where(d.grade_v.notna())
obs82_88 = df[[resc[y] for y in resc if 1982 <= y <= 1988]].notna().any(axis=1)
d["y_PROSP"] = ((df[[resc[y] for y in resc if 1982 <= y <= 1988]] == 3).any(axis=1).astype(float)
                .where((d.grade_v <= 12) & obs82_88))

# ---- exposures / controls
d["pe"] = d[["mom_ed", "dad_ed"]].max(axis=1)
d["pe_cat"] = pd.cut(d.pe, [-1, 11, 12, 15, 25], labels=["le11", "hs12", "some13_15", "ba16p"])
d["parent_ba"] = (d.pe >= 16).astype(float).where(d.pe.notna())
d["loginc79"] = np.log1p(d.inc79.where(d.inc79 >= 0))
d["logw85"] = np.sign(d.wealth85) * np.log1p(d.wealth85.abs())
d["black"] = (d.race == 1).astype(float)
d["hispanic"] = (d.race == 2).astype(float)         # reference = NON-BLACK NON-HISPANIC
d["female"] = (d.sex == 2).astype(float)

# ---- academic characteristics (1981); columns are mislabeled "Z" -> re-standardise
ASV = ["ar", "wk", "pc", "mk"]
for a in ASV:
    d["z_" + a] = (d[a] - d[a].mean()) / d[a].std(ddof=0)
d["asv_comp"] = d[["z_" + a for a in ASV]].mean(axis=1, skipna=False)
d["asv_missing"] = d[["z_" + a for a in ASV]].isna().all(axis=1).astype(float)
pct = 1 - (d["rank"] - 0.5) / d.classn              # 1 = top of class
d["rank_pct"] = pct.where(d["rank"].notna() & d.classn.notna() & (d.classn > 0)).clip(0, 1)

RACE = ["black", "hispanic"]; BASE = RACE + ["female", "age"]; ACAD4 = ["z_" + a for a in ASV]

def design(dd, terms):
    num = [t for t in terms if t != "pe_cat"]
    X = dd[num].astype(float).copy()
    if "pe_cat" in terms:
        dm = pd.get_dummies(dd.pe_cat.astype(str), prefix="pec", drop_first=False)
        dm = dm.astype(float).drop(columns=["pec_le11"])
        X = pd.concat([X, dm], axis=1)
    return sm.add_constant(X, has_constant="add")

def fit(dd, terms, y):
    yv, X = dd[y].astype(float), design(dd, terms)
    m = sm.Logit(yv, X).fit(disp=0, maxiter=300, cov_type="HC1")
    ols = sm.OLS(yv, X).fit(cov_type="HC1")
    p = m.predict(X)
    ame = pd.Series({c: float(m.params[c] * np.mean(p * (1 - p))) for c in m.params.index})
    return m, ols, ame

def khb(dd, t_small, t_big, y):
    """KHB-style rescaling on an identical sample.
    Assume Var(y*) fixed: Var(y*) = Var(Xb_big) + pi^2/3.
    sigma_small^2 = Var(y*) - Var(Xb_small); total effect on the big-model scale:
    b_total* = b_small * (pi/sqrt3)/sigma_small."""
    m1, _, a1 = fit(dd, t_small, y); m2, _, a2 = fit(dd, t_big, y)
    X1, X2 = design(dd, t_small), design(dd, t_big)
    v1 = np.var(X1.values @ m1.params.values, ddof=1)
    v2 = np.var(X2.values @ m2.params.values, ddof=1)
    sig = np.sqrt(max(v2 + PI3 ** 2 - v1, 1e-12))
    return m1, m2, PI3 / sig, v1, v2, a1, a2

# ------------------------------------------------------------------ coefficient table
LADDER = [
 ("M0", "race only",                       RACE),
 ("M1", "+ sex + age",                     BASE),
 ("A",  "+ SES (max parent ed, linear)",   BASE + ["pe"]),
 ("B",  "+ ASVAB 4 scores (standardised)", BASE + ["pe"] + ACAD4),
 ("A_cat", "A but categorical SES",        BASE + ["pe_cat"]),
 ("A_ba",  "A but any-parent-BA SES",      BASE + ["parent_ba"]),
 ("B_comp", "B but ASVAB composite",       BASE + ["pe", "asv_comp"]),
 ("B_cat", "B with categorical SES",       BASE + ["pe_cat", "asv_comp"]),
 ("B_ba",  "B with any-parent-BA SES",     BASE + ["parent_ba", "asv_comp"]),
 ("A_inc", "A + 1978 log income",          BASE + ["pe", "loginc79"]),
 ("B_inc", "B + 1978 log income",          BASE + ["pe", "loginc79"] + ACAD4),
 ("A_w85", "A + 1985 wealth (post-decision, exploratory)", BASE + ["pe", "logw85"]),
 ("B_w85", "B + 1985 wealth (post-decision, exploratory)", BASE + ["pe", "logw85"] + ACAD4),
 ("B_rank", "B with class-rank percentile instead of ASVAB (reduced coverage)",
                                           BASE + ["pe", "rank_pct"]),
 ("B_rank_full", "B = ASVAB + class-rank percentile (reduced coverage)",
                                           BASE + ["pe"] + ACAD4 + ["rank_pct"]),
]
OUTCOMES = [("y_O3",   "PRIMARY composite: grade>=13 (1979) OR dorm 1981-88"),
            ("y_O1",   "grade >= 13 by 1979 (any post-secondary credit)"),
            ("y_O2",   "dorm/frat/sorority 1981-88 (college residence)"),
            ("y_PROSP","SENSITIVITY prospective: baseline grade<=12 -> dorm 1982-88")]

rows = []
for y, ylab in OUTCOMES:
    for tag, desc, terms in LADDER:
        dd = d.dropna(subset=[y] + [t for t in terms if t != "pe_cat"])
        if dd[y].sum() < 30 or len(dd) < 100:
            print(f"skip {y}/{tag}"); continue
        m, ols, ame = fit(dd, terms, y)
        for t in m.params.index:
            if t == "const":
                continue
            se = m.bse[t]
            rows.append(dict(outcome=y, outcome_desc=ylab, model=tag, model_desc=desc, term=t,
                N=int(len(dd)), events=int(dd[y].sum()), rate=round(dd[y].mean(), 4),
                log_odds=round(m.params[t], 4), se_log_odds=round(se, 4),
                AOR=round(np.exp(m.params[t]), 4),
                AOR_lo95=round(np.exp(m.params[t] - ZC * se), 4),
                AOR_hi95=round(np.exp(m.params[t] + ZC * se), 4),
                p_logit=round(m.pvalues[t], 5),
                lpm_coef=round(ols.params[t], 5), lpm_se=round(ols.bse[t], 5),
                lpm_p=round(ols.pvalues[t], 5), ame=round(ame[t], 5),
                pseudo_r2=round(m.prsquared, 4), llf=round(m.llf, 2)))
coef = pd.DataFrame(rows)
coef.to_csv("results/coefficient_table.csv", index=False)
print(f"[written] results/coefficient_table.csv ({len(coef)} rows)")

# ------------------------------------------------------------------ attenuation
KEY = ["pe", "black", "hispanic", "pec_hs12", "pec_some13_15", "pec_ba16p", "parent_ba",
       "loginc79", "logw85"]
PAIRS = [("A", "B", "ASVAB 4 scores"), ("A", "B_comp", "ASVAB composite"),
         ("A_cat", "B_cat", "ASVAB composite, categorical SES (matched parameterisation)"),
         ("A_ba", "B_ba", "ASVAB composite, any-parent-BA SES (matched parameterisation)"),
         ("A", "B_rank", "class-rank percentile"),
         ("A_inc", "B_inc", "ASVAB 4 scores, SES = ed + 1978 income"),
         ("A_w85", "B_w85", "ASVAB 4 scores, SES = ed + 1985 wealth (exploratory)")]
att = []
for y, ylab in OUTCOMES:
    for small, big, blab in PAIRS:
        tb = [t for t in LADDER if t[0] == big][0][2]
        ts = [t for t in LADDER if t[0] == small][0][2]
        dd = d.dropna(subset=[y] + [t for t in tb if t != "pe_cat"])
        if len(dd) < 200:
            continue
        m1, m2, k, v1, v2, a1, a2 = khb(dd, ts, tb, y)
        for t in [x for x in KEY if x in m1.params.index and x in m2.params.index]:
            b1, b2 = m1.params[t], m2.params[t]
            tot = b1 * k
            naive = (b2 - b1) / b1 * 100 if abs(b1) > 1e-8 else np.nan
            cor = (b2 - tot) / tot * 100 if abs(tot) > 1e-8 else np.nan
            att.append(dict(outcome=y, model_pair=f"{small}->{big}", academic_block=blab, term=t,
                N=int(len(dd)), events=int(dd[y].sum()),
                beta_A=round(b1, 4), AOR_A=round(np.exp(b1), 4),
                beta_total_scaled=round(tot, 4), beta_B=round(b2, 4),
                AOR_B=round(np.exp(b2), 4),
                delta_beta=round(b2 - b1, 4), delta_beta_scale_corrected=round(b2 - tot, 4),
                pct_change_naive=round(naive, 2), pct_change_scale_corrected=round(cor, 2),
                pct_reliable=("ok" if abs(b1) > 0.15 else
                              "UNSTABLE: Model-A coefficient ~0, use delta_beta instead"),
                ame_A=round(float(a1[t]), 5), ame_B=round(float(a2[t]), 5),
                pct_change_AME=(round((a2[t] - a1[t]) / a1[t] * 100, 2) if abs(a1[t]) > 1e-6
                                else np.nan),
                p_A=round(m1.pvalues[t], 5), p_B=round(m2.pvalues[t], 5),
                sig_A=("*" if m1.pvalues[t] < .05 else "ns"),
                sig_B=("*" if m2.pvalues[t] < .05 else "ns"),
                disagreement=("SIGN FLIP" if np.sign(b1) != np.sign(b2) else
                              ("MAGNITUDE>20pp" if abs(naive - cor) > 20 else "agree")),
                scale_factor_k=round(k, 4), var_xb_A=round(v1, 4), var_xb_B=round(v2, 4)))
att = pd.DataFrame(att); att.to_csv("results/attenuation.csv", index=False)
print(f"[written] results/attenuation.csv ({len(att)} rows)")

# ------------------------------------------------------------------ descriptives
d["rn"] = d.race.map({1: "BLACK", 2: "HISPANIC", 3: "NB NON-HISP"})
dc = d.dropna(subset=["y_O3", "pe", "asv_comp"])
dc = dc.assign(asvq=pd.qcut(dc.asv_comp, 4, labels=["Q1(low)", "Q2", "Q3", "Q4(high)"]),
               ped=pd.cut(dc.pe, [-1, 8, 11, 12, 15, 25],
                          labels=["<=8", "9-11", "12", "13-15", "16+"]))
t1 = dc.pivot_table(index="asvq", columns="rn", values="y_O3", aggfunc=["mean", "size"],
                    observed=True).round(4)
t2 = dc.pivot_table(index="ped", columns="rn", values="y_O3", aggfunc=["mean", "size"],
                    observed=True).round(4)
t1.to_csv("results/desc_race_by_asvab_quartile.csv"); t2.to_csv("results/desc_race_by_parentedu.csv")
print("\n== post-secondary attendance rate by ASVAB quartile x race (n=%d) ==" % len(dc)); print(t1)
print("\n== by parental education x race =="); print(t2)
g1 = dc.groupby(["asvq", "rn"], observed=True).y_O3.mean().unstack()
g1["BLK_minus_NBH_pp"] = ((g1["BLACK"] - g1["NB NON-HISP"]) * 100).round(2)
g1["HIS_minus_NBH_pp"] = ((g1["HISPANIC"] - g1["NB NON-HISP"]) * 100).round(2)
g1["strata"] = "ASVAB quartile"; g1.index.name = "stratum"
g2 = dc.groupby(["ped", "rn"], observed=True).y_O3.mean().unstack()
g2["BLK_minus_NBH_pp"] = ((g2["BLACK"] - g2["NB NON-HISP"]) * 100).round(2)
g2["HIS_minus_NBH_pp"] = ((g2["HISPANIC"] - g2["NB NON-HISP"]) * 100).round(2)
g2["strata"] = "parental education"; g2.index.name = "stratum"
gaps = pd.concat([g1, g2]); gaps.to_csv("results/desc_within_stratum_gaps.csv")
print("\n== within-stratum race gaps (percentage points) =="); print(gaps.round(4))

# ASVAB / rank means by race and SES (why adjustment moves things)
print("\n== mean standardised ASVAB composite by race x parental education ==")
print(dc.pivot_table(index="ped", columns="rn", values="asv_comp", aggfunc="mean",
                     observed=True).round(3))
print("\n== mean class-rank percentile by race (coverage 45%) ==")
print(d.dropna(subset=["rank_pct"]).groupby("rn").rank_pct.agg(["mean", "count"]).round(3))

# ------------------------------------------------------------------ missingness diagnostics
cands = {"y_O3": "outcome composite", "grade_v": "highest grade 1979", "pe": "max parental ed",
         "mom_ed": "mother ed", "dad_ed": "father ed", "loginc79": "1978 family income",
         "logw85": "1985 family net wealth", "asv_comp": "ASVAB composite",
         "rank_pct": "class-rank percentile", "ar": "ASVAB AR", "wk": "ASVAB WK",
         "pc": "ASVAB PC", "mk": "ASVAB MK"}
mrows = []
for c, lab in cands.items():
    r = dict(variable=c, label=lab, N_nonmissing=int(d[c].notna().sum()),
             missing_pct_full=round(d[c].isna().mean() * 100, 2))
    for g in ["BLACK", "HISPANIC", "NB NON-HISP"]:
        r[f"miss_pct_{g}"] = round(d[c].isna()[d.rn == g].mean() * 100, 2)
    r["miss_pct_no_postsec"] = round(d[c].isna()[d.y_O3 == 0].mean() * 100, 2)
    r["miss_pct_postsec"] = round(d[c].isna()[d.y_O3 == 1].mean() * 100, 2)
    mrows.append(r)
miss = pd.DataFrame(mrows); miss.to_csv("results/missingness_diagnostics.csv", index=False)
print("\n== missingness diagnostics (% missing) =="); print(miss.to_string(index=False))

# missingness model: who is missing ASVAB (logit on race/SES/age/sex)
dm_ = d.dropna(subset=["pe", "female", "age", "black", "hispanic"])
mm = sm.Logit(dm_.asv_missing, design(dm_, BASE + ["pe"])).fit(disp=0, cov_type="HC1")
print("\n== missingness mechanism: logit P(ASVAB missing) ~ race+sex+age+parental ed ==")
print(pd.DataFrame({"log_odds": mm.params.round(4), "OR": np.exp(mm.params).round(4),
                    "p": mm.pvalues.round(4)}).to_string())

# ------------------------------------------------------------------ imputation sensitivity
d["asv_comp_imp"] = d.asv_comp.fillna(d.asv_comp.mean())
d["pe_imp"] = d.pe.fillna(d.pe.median())
d["pe_missing"] = d.pe.isna().astype(float)
sens = []
for tag, terms in [("complete_case", BASE + ["pe", "asv_comp"]),
                   ("ASVAB mean-imputed + missing indicator",
                    BASE + ["pe", "asv_comp_imp", "asv_missing"]),
                   ("ASVAB + parental-ed mean-imputed + indicators",
                    BASE + ["pe_imp", "pe_missing", "asv_comp_imp", "asv_missing"])]:
    dd = d.dropna(subset=["y_O3"] + terms)
    m, ols, ame = fit(dd, terms, "y_O3")
    for t in ["pe", "pe_imp", "black", "hispanic", "asv_comp", "asv_comp_imp", "asv_missing",
              "pe_missing"]:
        if t in m.params.index:
            sens.append(dict(spec=tag, term=t, N=len(dd), events=int(dd.y_O3.sum()),
                             log_odds=round(m.params[t], 4), AOR=round(np.exp(m.params[t]), 4),
                             p=round(m.pvalues[t], 5)))
sens = pd.DataFrame(sens); sens.to_csv("results/missingness_sensitivity.csv", index=False)
print("\n== missingness / imputation sensitivity =="); print(sens.to_string(index=False))

# three-way descriptive: race x ASVAB tertile x parental education
dc3 = d.dropna(subset=["y_O3", "pe", "asv_comp"]).assign(
    q=pd.qcut(d.dropna(subset=["asv_comp"]).asv_comp, 3, labels=["ASVAB low", "ASVAB mid", "ASVAB high"]),
    ped=pd.cut(d.pe, [-1, 11, 12, 25], labels=["pe<=11", "pe12", "pe13+"]))
loc = dc3.pivot_table(index=["q", "ped"], columns="rn", values="y_O3", aggfunc="mean",
                      observed=True).round(4)
cnt = dc3.pivot_table(index=["q", "ped"], columns="rn", values="y_O3", aggfunc="size",
                      observed=True)
out3 = loc.join(cnt, rsuffix="_n")
out3.to_csv("results/desc_race_by_asvab_and_parentedu.csv")
print("\n== ATTENDED (rate) race x ASVAB tertile x parental education ==")
print(out3.to_string())

# ------------------------------------------------------------------ SES functional form / interaction
# The Model-A "no race gap" result is fragile: parent education has a strongly NON-LINEAR
# gradient (flat below grade 12, steep above) and is very differently distributed by race
# (mean 9.1 yrs BLACK vs 11.9 NBH), so a linear pe term can flip the race sign.
ff = []
for y, ylab in OUTCOMES[:1] + OUTCOMES[1:]:
    dd0 = d.dropna(subset=[y, "pe", "asv_comp"])
    dd0 = dd0.assign(pec_hs=(dd0.pe == 12).astype(float),
                     pec_1315=((dd0.pe >= 13) & (dd0.pe <= 15)).astype(float),
                     pec_16=(dd0.pe >= 16).astype(float),
                     pe_c=dd0.pe - 12, pe_c2=(dd0.pe - 12) ** 2,
                     blk_x_pe=dd0.black * (dd0.pe - 12), his_x_pe=dd0.hispanic * (dd0.pe - 12))
    for lab, terms in [("A: pe linear", BASE + ["pe"]),
                       ("A: pe categorical", RACE + ["female", "age", "pec_hs", "pec_1315", "pec_16"]),
                       ("A: pe centred + quadratic", BASE + ["pe_c", "pe_c2"]),
                       ("A: pe linear + race x pe interaction", BASE + ["pe", "blk_x_pe", "his_x_pe"]),
                       ("B: pe linear + ASVAB", BASE + ["pe", "asv_comp"]),
                       ("B: pe categorical + ASVAB", RACE + ["female", "age", "pec_hs", "pec_1315", "pec_16", "asv_comp"])]:
        m, ols, _ = fit(dd0, terms, y)
        row = dict(outcome=y, spec=lab, N=len(dd0))
        for t, k in [("black", "BLK"), ("hispanic", "HIS"), ("pe", "pe"), ("asv_comp", "asv"),
                     ("blk_x_pe", "blkXpe"), ("his_x_pe", "hisXpe")]:
            if t in m.params.index:
                row[k + "_AOR"] = round(float(np.exp(m.params[t])), 4)
                row[k + "_p"] = round(float(m.pvalues[t]), 5)
                row[k + "_lpm"] = round(float(ols.params[t]), 5)
                row[k + "_lpm_p"] = round(float(ols.pvalues[t]), 5)
        ff.append(row)
ff = pd.DataFrame(ff); ff.to_csv("results/ses_functional_form_interaction.csv", index=False)
print("\n== SES functional form and race x SES interaction ==")
print(ff[["outcome", "spec", "N", "BLK_AOR", "BLK_p", "BLK_lpm", "BLK_lpm_p", "HIS_AOR", "HIS_p",
          "blkXpe_AOR", "blkXpe_p", "hisXpe_AOR", "hisXpe_p"]].to_string(index=False))
print("\nnon-linear SES gradient (y_O3 rate by parent-education band):")
print(d.dropna(subset=["y_O3", "pe"]).groupby(pd.cut(d.pe, [-1, 8, 11, 12, 15, 16, 25]),
                                              observed=True).y_O3.agg(["mean", "size"]).round(4))
print("mean parent education by race:", d.groupby("rn").pe.mean().round(2).to_dict())

# ------------------------------------------------------------------ model-family agreement
fam = []
for y, ylab in OUTCOMES:
    for tag in ["M1", "A", "A_cat", "B", "B_comp"]:
        terms = [t for t in LADDER if t[0] == tag][0][2]
        dd = d.dropna(subset=[y] + [t for t in terms if t != "pe_cat"])
        m, ols, ame = fit(dd, terms, y)
        for t in [x for x in ["black", "hispanic", "pe", "pec_ba16p", "parent_ba"] if x in m.params.index]:
            sl, so = np.sign(m.params[t]), np.sign(ols.params[t])
            slg, slog = m.pvalues[t] < .05, ols.pvalues[t] < .05
            fam.append(dict(outcome=y, model=tag, term=t, N=len(dd),
                            logit_AOR=round(np.exp(m.params[t]), 4), p_logit=round(m.pvalues[t], 5),
                            lpm=round(ols.params[t], 5), p_lpm=round(ols.pvalues[t], 5),
                            ame=round(float(ame[t]), 5),
                            sign_agreement=("same" if sl == so else "**OPPOSITE**"),
                            sig_agreement=("both sig" if slg and slog else
                                           ("both ns" if not slg and not slog else "**DISAGREE**")),
                            verdict=("consistent" if (sl == so and (slg == slog or (not slg and not slog)))
                                     else "MODEL-FAMILY DISAGREEMENT")))
fam = pd.DataFrame(fam); fam.to_csv("results/model_family_agreement.csv", index=False)
print("\n== logit vs LPM sign / significance agreement ==")
print(fam.to_string(index=False))
print("\nDisagreements:")
print(fam[fam.verdict != "consistent"].to_string(index=False))

# ------------------------------------------------------------------ robustness checks
rob = []
d["asv_any_mean"] = d[["z_ar", "z_wk", "z_pc", "z_mk"]].mean(axis=1)   # available-item mean
aged = pd.get_dummies(d.age.astype(int), prefix="age", drop_first=True).astype(float)
d2 = pd.concat([d, aged], axis=1); agel = [c for c in d2.columns if c.startswith("age_")]
dd_p = d.dropna(subset=["y_O3", "pe", "asv_comp"])
dd_p2 = d2.loc[dd_p.index]
for tag, frame, terms in [
    ("B: ASVAB composite (reference)", d, BASE + ["pe", "asv_comp"]),
    ("B: each ASVAB score separately", None, None),
    ("B: age as categorical dummies", d2, RACE + ["female", "pe", "asv_comp"] + agel),
    ("B: + family size", d, BASE + ["pe", "asv_comp", "famsize"]),
    ("B: restricted to age>=18 in 1979", None, BASE + ["pe", "asv_comp"]),
    ("B: available-item ASVAB mean", d, BASE + ["pe", "asv_any_mean"])]:
    if tag.startswith("B: each"):
        for sc in ACAD4:
            dd_ = d.dropna(subset=["y_O3", "pe", sc])
            m, _, _ = fit(dd_, BASE + ["pe", sc], "y_O3")
            rob.append(dict(check=tag, variant=sc, N=len(dd_), academic_AOR=round(np.exp(m.params[sc]), 3),
                            black_AOR=round(np.exp(m.params["black"]), 3),
                            hispanic_AOR=round(np.exp(m.params["hispanic"]), 3),
                            pe_AOR=round(np.exp(m.params["pe"]), 3), pseudo_r2=round(m.prsquared, 4)))
        continue
    if tag.startswith("B: restricted"):
        dd_ = d[d.age >= 18].dropna(subset=["y_O3", "pe", "asv_comp"])
    elif frame is d2:
        dd_ = dd_p2
    else:
        dd_ = d.dropna(subset=["y_O3"] + [t for t in terms if t in d.columns])
    m, ols, _ = fit(dd_, terms, "y_O3")
    rob.append(dict(check=tag, variant="-", N=len(dd_),
                    academic_AOR=round(np.exp(m.params[[t for t in terms if 'asv' in t][0]]), 3),
                    black_AOR=round(np.exp(m.params["black"]), 3),
                    hispanic_AOR=round(np.exp(m.params["hispanic"]), 3),
                    pe_AOR=round(np.exp(m.params["pe"]), 3), pseudo_r2=round(m.prsquared, 4)))
# Model-A counterparts for the two most informative checks
for tag, frame, terms in [("A: age as categorical dummies", dd_p2, RACE + ["female", "pe"] + agel),
                          ("A: restricted to age>=18 in 1979", d[d.age >= 18].dropna(subset=["y_O3", "pe", "asv_comp"]),
                           BASE + ["pe"])]:
    m, _, _ = fit(frame, terms, "y_O3")
    rob.append(dict(check=tag, variant="-", N=len(frame), academic_AOR=np.nan,
                    black_AOR=round(np.exp(m.params["black"]), 3),
                    hispanic_AOR=round(np.exp(m.params["hispanic"]), 3),
                    pe_AOR=round(np.exp(m.params["pe"]), 3), pseudo_r2=round(m.prsquared, 4)))
# multicollinearity diagnostics for the academic block
Xs = dd_p[ACAD4].astype(float); vif = {}
for c in Xs.columns:
    r2 = sm.OLS(Xs[c], sm.add_constant(Xs.drop(columns=c))).fit().rsquared
    vif[c] = round(1 / (1 - r2), 2)
for c, v in vif.items():
    rob.append(dict(check="VIF of ASVAB scores in Model-B sample", variant=c, N=len(dd_p),
                    academic_AOR=np.nan, black_AOR=np.nan, hispanic_AOR=np.nan, pe_AOR=v,
                    pseudo_r2=np.nan))
rob = pd.DataFrame(rob); rob.to_csv("results/robustness_checks.csv", index=False)
print("\n== robustness of the A->B reversal / SES attenuation (outcome y_O3) ==")
print(rob.to_string(index=False))

# ------------------------------------------------------------------ g-computed contrasts
"""Scale-stable contrasts: risk differences from the fitted logits (g-computation on the
same sample), so attenuation can be read on the probability scale where % change in
log-odds is uninformatic (Model-A race coefficients are ~0)."""
def gcomputed(dd, terms, y, m):
    X = design(dd, terms)
    out = {}
    for lab, mods in [("BLACK", {"black": 1.0, "hispanic": 0.0}),
                      ("HISPANIC", {"black": 0.0, "hispanic": 1.0}),
                      ("NB NON-HISP", {"black": 0.0, "hispanic": 0.0})]:
        Xi = X.copy()
        for k, v in mods.items():
            if k in Xi.columns: Xi[k] = v
        out[lab] = float(m.predict(Xi).mean())
    ses = {}
    if "pe" in X.columns:
        for lvl in [8, 12, 16]:
            Xi = X.copy(); Xi["pe"] = float(lvl)
            ses[f"pe{lvl}"] = float(m.predict(Xi).mean())
    if "pe_cat" in terms:
        Xc = design(dd, [t for t in terms if t != "pe_cat"] + ["pe_cat"])
        for lab, cols in [("pe12", {"pec_hs12": 1, "pec_some13_15": 0, "pec_ba16p": 0}),
                          ("pe16", {"pec_hs12": 0, "pec_some13_15": 0, "pec_ba16p": 1})]:
            Xi = Xc.copy()
            for k, v in cols.items(): Xi[k] = float(v)
            ses[lab] = float(m.predict(Xi).mean())
    if "parent_ba" in X.columns:
        for lab, v in [("nobapa", 0.0), ("bapa", 1.0)]:
            Xi = X.copy(); Xi["parent_ba"] = v
            ses[lab] = float(m.predict(Xi).mean())
    return out, ses

crow = []
for y, ylab in OUTCOMES:
    for tag in ["M1", "A", "A_cat", "A_ba", "B", "B_comp", "B_cat", "B_ba"]:
        terms = [t for t in LADDER if t[0] == tag][0][2]
        dd = d.dropna(subset=[y] + [t for t in terms if t != "pe_cat"])
        if len(dd) < 200: continue
        m, ols, ame = fit(dd, terms, y)
        rc, ses = gcomputed(dd, terms, y, m)
        row = dict(outcome=y, model=tag, N=len(dd), events=int(dd[y].sum()),
                   obs_rate=round(dd[y].mean(), 4),
                   p_BLACK=round(rc["BLACK"], 4), p_HISPANIC=round(rc["HISPANIC"], 4),
                   p_NBNONHISP=round(rc["NB NON-HISP"], 4),
                   RD_BLACK_minus_NBH=round(rc["BLACK"] - rc["NB NON-HISP"], 4),
                   RD_HISP_minus_NBH=round(rc["HISPANIC"] - rc["NB NON-HISP"], 4))
        for k, v in ses.items():
            row["p_" + k] = round(v, 4)
        if "pe8" in ses:
            row["RD_pe16_minus_pe8"] = round(ses["pe16"] - ses["pe8"], 4)
            row["RD_pe16_minus_pe12"] = round(ses["pe16"] - ses["pe12"], 4)
        if "pe12" in ses:
            row["RD_pe16_minus_pe12_cat"] = round(ses["pe16"] - ses["pe12"], 4)
        if "bapa" in ses:
            row["RD_parentBA_minus_noBA"] = round(ses["bapa"] - ses["nobapa"], 4)
        crow.append(row)
gc = pd.DataFrame(crow); gc.to_csv("results/adjusted_contrasts.csv", index=False)
print("\n== g-computed adjusted probabilities / risk differences (scale-stable attenuation) ==")
print(gc[["outcome", "model", "N", "p_BLACK", "p_HISPANIC", "p_NBNONHISP",
