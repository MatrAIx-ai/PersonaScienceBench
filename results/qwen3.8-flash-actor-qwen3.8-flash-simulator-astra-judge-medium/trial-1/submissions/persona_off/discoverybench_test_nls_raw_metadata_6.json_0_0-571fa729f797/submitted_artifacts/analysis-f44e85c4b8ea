def granularity(s, mask, target):
    """Levels cut on the POOLED sample (all respondents with an index); granularity rule
    evaluated on race x level cells among rows with the primary outcome observed."""
    all_m = s.notna()
    t3 = pd.qcut(s[all_m].rank(method="first"), 3, labels=["low", "mid", "high"])
    t3 = pd.Series(t3, index=s[all_m].index)
    tab = pd.crosstab(target, t3[mask])
    if int(tab.min().min()) >= 100:
        return t3, "tertile", tab
    t2 = pd.cut(s[all_m].rank(pct=True), [0, .5, 1.], labels=["below_median", "at_or_above_median"])
    t2 = pd.Series(t2, index=s[all_m].index)
    return t2, "median_split", pd.crosstab(target, t2[mask])

