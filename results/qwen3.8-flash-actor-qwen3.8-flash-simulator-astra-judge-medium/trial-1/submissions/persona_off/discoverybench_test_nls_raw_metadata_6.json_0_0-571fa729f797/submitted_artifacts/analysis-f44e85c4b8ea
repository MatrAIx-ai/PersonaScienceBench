_lr_r = 2 * (m_main.llf - _m_norace.llf); _df_r = int(m_main.df_model - _m_norace.df_model)
P("[LR TEST  main effect of race, no interaction] chi2=%.3f df=%d p=%.4g" % (_lr_r, _df_r, stats.chi2.sf(_lr_r, _df_r)))
P("[ODDS RATIOS, interaction model]"); P(pd.DataFrame({
   "OR": np.exp(m_int.params), "lo": np.exp(m_int.conf_int()[0]),
   "hi": np.exp(m_int.conf_int()[1]), "p": m_int.pvalues}).round(4).to_string())
def gpred(m, dd, lv, cov=None):
    a = dd.copy(); b = dd.copy()
    a["race"] = "BLACK"; b["race"] = "NONBLACK_NONHISP"; a["ses_level"] = lv; b["ses_level"] = lv
    if cov: a[cov] = dd[cov].mean(); b[cov] = dd[cov].mean()
    pa, pb = m.predict(a).mean(), m.predict(b).mean()
    return 100*pa, 100*pb, 100*(pa-pb), pa/pb if pb else np.nan
P("[ADJUSTED (model-predicted) BLACK-vs-reference gap by SES level]")
for lv in ORDER:
