# ------------------------------------------------------------------ helpers
def wilson(k, n, a=0.05):
    if n == 0: return (np.nan, np.nan)
    zc = stats.norm.ppf(1 - a / 2); p = k / n; den = 1 + zc**2 / n
    ctr = (p + zc**2 / (2 * n)) / den
    hw = zc * np.sqrt(p * (1 - p) / n + zc**2 / (4 * n**2)) / den
    return ctr - hw, ctr + hw

def exact_ci(k, n, a=0.05):
    if n == 0: return (np.nan, np.nan)
    lo = 0.0 if k == 0 else stats.beta.ppf(a / 2, k, n - k + 1)
    hi = 1.0 if k == n else stats.beta.ppf(1 - a / 2, k + 1, n - k)
    return lo, hi

def gap_table(dat, y, order=("low", "mid", "high"), ref="NONBLACK_NONHISP", groups=("BLACK", "HISPANIC")):
    rows = []
    for lv in order:
        sub = dat[dat.ses_level == lv]
        for foc in [g for g in groups if (sub.race == g).any()]:
            a = sub[sub.race == foc][y]; b = sub[sub.race == ref][y]
            n1, k1, n0, k0 = int(a.notna().sum()), int(a.sum()), int(b.notna().sum()), int(b.sum())
            if n1 == 0 or n0 == 0: continue
            p1, p0 = k1 / n1, k0 / n0
            lo1, hi1 = wilson(k1, n1); lo0, hi0 = wilson(k0, n0)
            se_d = np.sqrt(p1 * (1 - p1) / n1 + p0 * (1 - p0) / n0)
            if k1 > 0 and k0 > 0:
                lrr = np.log(p1 / p0); se_r = np.sqrt((1 - p1) / k1 + (1 - p0) / k0)
                rr, rlo, rhi = p1 / p0, np.exp(lrr - 1.96 * se_r), np.exp(lrr + 1.96 * se_r)
            else: rr = rlo = rhi = np.nan
            flags = []
            if n1 < 50: flags.append("UNRELIABLE n_focal<50")
            if k1 < 5: flags.append("events<5")
            rows.append(dict(SES=lv, group=foc, n_focal=n1, events_focal=k1, rate_focal=100*p1,
                rate_focal_lo=100*lo1, rate_focal_hi=100*hi1, n_ref=n0, events_ref=k0, rate_ref=100*p0,
                rate_ref_lo=100*lo0, rate_ref_hi=100*hi0, gap_pp=100*(p1-p0),
                gap_lo=100*(p1-p0-1.96*se_d), gap_hi=100*(p1-p0+1.96*se_d),
                RR=rr, RR_lo=rlo, RR_hi=rhi, flag=";".join(flags)))
    return pd.DataFrame(rows)

def pooled_table(dat, y):
    rows = []
    for foc in ["BLACK", "HISPANIC"]:
        a = dat[dat.race == foc][y]; b = dat[dat.race == "NONBLACK_NONHISP"][y]
        n1, k1, n0, k0 = int(a.notna().sum()), int(a.sum()), int(b.notna().sum()), int(b.sum())
        p1, p0 = k1/n1, k0/n0
        lo1, hi1 = wilson(k1, n1); lo0, hi0 = wilson(k0, n0)
        se_d = np.sqrt(p1*(1-p1)/n1 + p0*(1-p0)/n0)
        lrr = np.log(p1/p0) if (k1 and k0) else np.nan
        se_r = np.sqrt((1-p1)/k1 + (1-p0)/k0) if (k1 and k0) else np.nan
        rows.append(dict(group=foc, n_focal=n1, rate_focal=100*p1, lo=100*lo1, hi=100*hi1,
            n_ref=n0, rate_ref=100*p0, ref_lo=100*lo0, ref_hi=100*hi0, gap_pp=100*(p1-p0),
            gap_lo=100*(p1-p0-1.96*se_d), gap_hi=100*(p1-p0+1.96*se_d),
            RR=(p1/p0 if (k1 and k0) else np.nan),
            RR_lo=(np.exp(lrr-1.96*se_r) if not np.isnan(se_r) else np.nan),
            RR_hi=(np.exp(lrr+1.96*se_r) if not np.isnan(se_r) else np.nan)))
    return pd.DataFrame(rows)

GC = ["SES","group","n_focal","events_focal","rate_focal","rate_focal_lo","rate_focal_hi",
      "n_ref","events_ref","rate_ref","gap_pp","gap_lo","gap_hi","RR","RR_lo","RR_hi","flag"]
def fmt(t, cols=GC):
    t = t[[c for c in cols if c in t.columns]].copy()
    for c in t.columns:
        if t[c].dtype.kind == "f": t[c] = t[c].astype(float).round(2)
    return t

def fit(dat, y, formula=None, extra=""):
    dd = dat[dat[y].notna() & dat.ses_level.notna()].dropna(subset=["age", "sex"]).copy()
    base = ("y ~ C(race, Treatment('NONBLACK_NONHISP')) * " + LV + " + age + I(age**2) + C(sex)")
    f = (formula or base).replace("y", y, 1)
    if extra: f += " + " + extra; dd = dd.dropna(subset=[extra])
    return smf.logit(f, data=dd).fit(disp=0), dd, f

