"""Median family net wealth by racial/ethnic cohort, NLSY79 waves 1985 / 1990 / 1996.

Design (researcher-approved 2026-10-23):
  * PRIMARY units: nominal dollars exactly as recorded in each wave.
    Constant 1996$ is SECONDARY (CPI-U annual avgs, 1982-84=100: 1985=107.6,
    1990=130.7, 1996=156.9 -> x1.458 / x1.200 / x1.000); real terms used ONLY
    for the cross-wave widened/narrowed claim. Within-wave ratios are
    deflator-invariant.
  * Zeros and negatives RETAINED; every cohort-wave median <= 0 is flagged and
    reported with the level gap + share-at-or-below-zero instead of a leading ratio.
  * Per wave x cohort: n, mean, Q1, median, Q3, IQR, share<=0, bootstrap 95% CI.
  * Kruskal-Wallis reported only with the explicit caveat that it reflects
    within-file sampling noise (no weights, no strata, not nationally representative).
  * PRIMARY estimand: all available cases per wave. SENSITIVITY: balanced panel
    (wealth observed in all three waves).
  * Cohort 3 -> "white (NON-BLACK NON-HISPANIC)" is a LABEL; cohorts 1 -> black,
    2 -> Hispanic. Race is fixed at 1979.
"""
import numpy as np, pandas as pd
from scipy import stats

PATH = 'data/nls_raw.csv'
RACE = 'Racial/ethnic cohort, 1979'
WEALTH = {1985: 'Family net wealth, 1985',
          1990: 'Family net wealth, 1990',
          1996: 'Family net wealth, 1996 (key data point)'}
LAB = {1: 'black', 2: 'hispanic', 3: 'white (NBNH)'}
DEFLATOR = {1985: 156.9 / 107.6, 1990: 156.9 / 130.7, 1996: 1.0}   # to 1996 dollars
RNG = np.random.default_rng(20261023)
B = 2000

df = pd.read_csv(PATH)
df['cohort'] = df[RACE].map(LAB)


def boot_ci_median(x, B=B):
    x = np.asarray(x, dtype=float)
    if len(x) == 0:
        return np.nan, np.nan
    idx = RNG.integers(0, len(x), size=(B, len(x)))
    meds = np.median(x[idx], axis=1)
    return float(np.percentile(meds, 2.5)), float(np.percentile(meds, 97.5))


def summarise(frame, wave, tag):
    col = WEALTH[wave]
    rows = []
    for k in (3, 1, 2):                      # white first: it is the reference group
        s = frame.loc[frame[RACE] == k, col].dropna().values
        if len(s) == 0:
            continue
        lo, hi = boot_ci_median(s)
        q1, q3 = np.percentile(s, [25, 75])
        rows.append({
            'estimand': tag, 'wave': wave, 'cohort': LAB[k], 'n': len(s),
            'median_nom': round(float(np.median(s)), 0),
            'ci_lo_nom': round(lo, 0), 'ci_hi_nom': round(hi, 0),
            'mean_nom': round(float(s.mean()), 0),
            'q1_nom': round(float(q1), 0), 'q3_nom': round(float(q3), 0),
            'iqr_nom': round(float(q3 - q1), 0),
            'pct_le0': round(100 * float((s <= 0).mean()), 1),
            'median_1996dollars': round(float(np.median(s)) * DEFLATOR[wave], 0),
        })
    return rows


def add_gaps(t):
    """White-minus-X level gaps and white/X ratios within each wave+estimand."""
    out = []
    for (tag, wave), g in t.groupby(['estimand', 'wave'], sort=False):
        w = g[g.cohort.str.startswith('white')]
        for other in ('black', 'hispanic'):
            o = g[g.cohort == other]
            if w.empty or o.empty:
                continue
            mw, mo = float(w.median_nom.iloc[0]), float(o.median_nom.iloc[0])
            ratio = (mw / mo) if mo > 0 else np.nan
            out.append({'estimand': tag, 'wave': wave,
                        'contrast': f'white vs {other}',
                        'gap_nom_dollars': round(mw - mo, 0),
                        'ratio_white_over_X': round(ratio, 2) if ratio == ratio else np.nan,
                        'ratio_valid': mo > 0,
                        'X_median_le0': mo <= 0,
                        'gap_1996dollars': round((mw - mo) * DEFLATOR[wave], 0)})
    return pd.DataFrame(out)


# ---------- PRIMARY: all available cases per wave ----------
prim = [r for w in (1985, 1990, 1996) for r in summarise(df, w, 'available-case (primary)')]
T = pd.DataFrame(prim)

# ---------- SENSITIVITY: balanced panel ----------
bal_mask = df[list(WEALTH.values())].notna().all(axis=1)
bal = df[bal_mask]
sens = [r for w in (1985, 1990, 1996) for r in summarise(bal, w, 'balanced panel (sensitivity)')]
T = pd.concat([T, pd.DataFrame(sens)], ignore_index=True)

G = add_gaps(T)
FULL = T.merge(G, on=['estimand', 'wave'], how='left')

pd.set_option('display.width', 250, 'display.max_columns', 50)
print('NLSY79 family net wealth by cohort | rows=%d | balanced panel n=%d (%.1f%%)'
      % (len(df), len(bal), 100 * bal_mask.mean()))
print('Cohort-wave medians that are <= 0 (ratio unstable for these cells):')
flag = T[T.median_nom <= 0]
print('   none' if flag.empty else flag[['estimand','wave','cohort','n','median_nom','pct_le0']].to_string(index=False))

print('\n================= PRIMARY: available cases per wave =================')
cols = ['wave','cohort','n','median_nom','ci_lo_nom','ci_hi_nom','mean_nom','q1_nom','q3_nom','iqr_nom','pct_le0','median_1996dollars']
for w in (1985, 1990, 1996):
    print('\n--- wave', w, '---')
    print(T[T.estimand.str.startswith('available') & (T.wave == w)][cols].to_string(index=False))

print('\n================= GAPS & RATIOS (nominal $) =================')
print(G.to_string(index=False))

print('\n================= SENSITIVITY: balanced panel (n=%d) =================' % len(bal))
for w in (1985, 1990, 1996):
    print('\n--- wave', w, '---')
    print(T[T.estimand.str.startswith('balanced') & (T.wave == w)][cols].to_string(index=False))

print('\n---- IQR overlap check (does the white IQR sit above the other groups\'?) ----')
for w in (1985, 1990, 1996):
    g = T[T.estimand.str.startswith('available') & (T.wave == w)].set_index('cohort')
    print(w, {c: (int(g.loc[c, 'q1_nom']), int(g.loc[c, 'q3_nom'])) for c in g.index})

print('\n---- real (1996$) medians: cross-wave trend (deflators x%.3f / x%.3f / x1.000) ----'
      % (DEFLATOR[1985], DEFLATOR[1990]))
p = T[T.estimand.str.startswith('available')].pivot(index='cohort', columns='wave', values='median_1996dollars')
print(p.to_string())
print('growth 1985->1996 (real, x factor):')
print((p[1996] / p[1985]).round(2).to_string())

print('\n---- distribution-free omnibus test (CAVEAT: unweighted, no strata, not '
      'nationally representative; reflects within-file sampling noise only) ----')
try:
    for w in (1985, 1990, 1996):
        gs = [df.loc[df[RACE] == k, WEALTH[w]].dropna().values for k in (1, 2, 3)]
        h, pv = stats.kruskal(*gs)
        print(f'  {w}: Kruskal-Wallis H={h:.1f}, p={pv:.3g}')
except Exception as e:
    print('  scipy unavailable:', e)

FULL.to_csv('analysis/wealth_medians_by_race.csv', index=False)
print('\nwrote analysis/wealth_medians_by_race.csv')
