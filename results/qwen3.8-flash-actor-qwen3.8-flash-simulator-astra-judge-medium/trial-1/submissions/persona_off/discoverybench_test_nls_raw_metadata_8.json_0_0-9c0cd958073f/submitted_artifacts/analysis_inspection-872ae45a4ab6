"""Stage 1: INPUT INSPECTION ONLY (no race x wave median comparison performed).
Inspects data/nls_raw.csv for the question:
  'How does the median wealth of white individuals compare to that of black and
   Hispanic individuals from 1985 onwards?'
"""
import pandas as pd, numpy as np

PATH = 'data/nls_raw.csv'
RACE = 'Racial/ethnic cohort, 1979'
WEALTH = {'1985': 'Family net wealth, 1985',
          '1990': 'Family net wealth, 1990',
          '1996': 'Family net wealth, 1996 (key data point)'}
LAB = {1: 'BLACK', 2: 'HISPANIC', 3: 'NON-BLACK NON-HISPANIC'}

df = pd.read_csv(PATH)
print('1) ROWS x COLS:', df.shape)
print('   unique respondent IDs:', df['ID# (range 1-12686) 1979'].nunique())
print('   wealth cols:', list(WEALTH.values()))
print('\n   race coding:', dict(df[RACE].value_counts().sort_index()), '->', LAB,
      '| nulls:', int(df[RACE].isna().sum()))

print('\n2a) MISSINGNESS (overall and by cohort)')
rows = []
for y, c in WEALTH.items():
    r = {'wave': y, 'n_obs': int(df[c].notna().sum()),
         'pct_missing': round(100 * df[c].isna().mean(), 2)}
    for k in (1, 2, 3):
        s = df.loc[df[RACE] == k, c]
        r[f'miss%_{LAB[k]}'] = round(100 * s.isna().mean(), 2)
    rows.append(r)
print(pd.DataFrame(rows).set_index('wave').to_string())

print('\n2b) SHAPE (median-friendly vs mean-friendly)')
rows = []
for y, c in WEALTH.items():
    s = df[c].dropna()
    rows.append({'wave': y, 'n': len(s), 'median': s.median(), 'mean': round(s.mean()),
                 'mean/median': round(s.mean() / s.median(), 2),
                 'pct<0': round(100 * (s < 0).mean(), 1), 'pct==0': round(100 * (s == 0).mean(), 1),
                 'pct<=0': round(100 * (s <= 0).mean(), 1), 'pct>=100k': round(100 * (s >= 1e5).mean(), 2),
                 'max': s.max(), 'n_at_max': int((s == s.max()).sum()),
                 'pct_at_max': round(100 * (s == s.max()).mean(), 2)})
print(pd.DataFrame(rows).set_index('wave').to_string())

print('\n2c) share at/near zero, by cohort')
rows = [{'wave': y, 'cohort': LAB[k],
         'pct<=0': round(100 * (df.loc[df[RACE] == k, c].dropna() <= 0).mean(), 1),
         'pct>=100k': round(100 * (df.loc[df[RACE] == k, c].dropna() >= 1e5).mean(), 2)}
        for y, c in WEALTH.items() for k in (1, 2, 3)]
print(pd.DataFrame(rows).pivot(index='cohort', columns='wave', values=['pct<=0', 'pct>=100k']).to_string())

print('\n2d) zeros real vs missing: components among wealth==0 (1985)')
comp = ['Market value of residential property respondent/spouse own, 1985',
        'Total market value of farm, business, and other property, 1985',
        'Market Value of vehicles respondent/spouse own, 1985',
        'Total market value of items over $500, 1985']
z = df[df[WEALTH['1985']] == 0]
print('   n wealth==0:', len(z), '| share with ALL components 0/null:',
      round(100 * (z[comp].fillna(0).abs().sum(axis=1) == 0).mean(), 1), '%')

print('\n4) ATTRITION / PANEL')
bal = df[list(WEALTH.values())].notna().all(axis=1)
print('   complete 3-wave panel n =', int(bal.sum()), f'({100*bal.mean():.1f}%)')
print('   cohort mix, all-observed 1985 (%):')
print((df.loc[df[WEALTH["1985"]].notna(), RACE].map(LAB).value_counts(normalize=True)*100).round(1).to_string())
print('   cohort mix, balanced panel (%):')
print((df.loc[bal, RACE].map(LAB).value_counts(normalize=True)*100).round(1).to_string())
o, n = df[df[WEALTH['1996']].notna()][WEALTH['1990']].dropna(), df[df[WEALTH['1996']].isna()][WEALTH['1990']].dropna()
print(f'   selectivity: 1990 median wealth if 1996 observed={o.median():.0f} vs 1996 missing={n.median():.0f}')

print('\n5) CPI-U deflators to 1996 dollars (1982-84=100):',
      {y: round(156.9 / v, 3) for y, v in {1985: 107.6, 1990: 130.7, 1996: 156.9}.items()})
