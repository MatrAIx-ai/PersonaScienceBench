"""Refinement #2 follow-up: bootstrap CIs for white/X median RATIOS and gaps.
Shows explicitly how unstable a ratio becomes when the denominator median sits
near zero (e.g. Hispanic 1985 median = $500, with 41.9% at or below zero).
Unweighted, within-file sampling noise only."""
import numpy as np, pandas as pd

PATH = 'data/nls_raw.csv'; RACE = 'Racial/ethnic cohort, 1979'
WEALTH = {1985: 'Family net wealth, 1985', 1990: 'Family net wealth, 1990',
          1996: 'Family net wealth, 1996 (key data point)'}
df = pd.read_csv(PATH)
rng = np.random.default_rng(7)
B = 2000
rows = []
for w, c in WEALTH.items():
    d = df[[RACE, c]].dropna().copy(); d.columns = ['r', 'x']
    pools = {k: d.loc[d.r == k, 'x'].to_numpy(float) for k in (1, 2, 3)}
    for k, nm in ((1, 'black'), (2, 'hispanic')):
        W_, X_ = pools[3], pools[k]
        mw = np.array([np.median(W_[rng.integers(0, len(W_), len(W_))]) for _ in range(B)])
        mx = np.array([np.median(X_[rng.integers(0, len(X_), len(X_))]) for _ in range(B)])
        ratio = mw / mx
        gap = mw - mx
        rows.append(dict(
            wave=w, contrast=f'white vs {nm}',
            ratio=round(float(np.median(W_) / np.median(X_)), 2),
            ratio_ci=f'[{np.percentile(ratio,2.5):.2f}, {np.percentile(ratio,97.5):.2f}]',
            gap_nom=round(float(np.median(W_) - np.median(X_)), 0),
            gap_ci=f'[{np.percentile(gap,2.5):,.0f}, {np.percentile(gap,97.5):,.0f}]',
            denom_median=float(np.median(X_)),
            denom_pct_le0=round(100 * float((X_ <= 0).mean()), 1),
            ratio_flag='UNSTABLE (denominator median < $1,000)' if np.median(X_) < 1000 else 'ok'))
out = pd.DataFrame(rows)
print(out.to_string(index=False))
out.to_csv('analysis/ratio_and_gap_uncertainty.csv', index=False)
