"""
FINAL ANALYSIS -- NLS SES / BA DEGREE COMPLETION
Which variable's effect on BA completion falls from ~0.3636 to ~-0.2293 and loses
significance once BOTH race and academic characteristics (ASVAB ability + class
percentile) are included?

Fixed with the researcher:
  * "effect" = raw (unstandardised) logistic coefficient (primary metric)
  * academic characteristics = ABILITY (ASVAB composite) + PERCENTILE IN CLASS
  * race treatment-coded, White = reference (all encodings give identical focal coef)
  * significance reported honestly at alpha = .05 and alpha = .01
"""
import warnings, math
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings('ignore')
pd.set_option('display.width', 230); pd.set_option('display.max_rows', 300)

OUT = open('analysis/final_report.txt', 'w')
def P(*a):
    s = ' '.join(str(x) for x in a); print(s); OUT.write(s + '\n')

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(float)
z = lambda s: (s - s.mean()) / s.std(ddof=1)

B = pd.DataFrame({
    'SES'     : df['SES'].astype(float),
    'ABILITY' : df['ABILITY: COMPOSITE OF ASVAB SCORE'].astype(float),
    'PCT'     : df['PERCENTILE IN CLASS'].astype(float),
    'FAMSIZE' : df['FAMILY SIZE OF SAMPLE'].astype(float),
    'FEMALE'  : (df.SAMPLE_SEX == 'Female').astype(float),
    'BLACK'   : (df.SAMPLE_RACE == 'Black').astype(float),
    'HISPANIC': (df.SAMPLE_RACE == 'Hispanic').astype(float),
    'WHITE'   : (df.SAMPLE_RACE == 'White').astype(float),
}, index=df.index)
B['SES_z'] = z(B.SES); B['ABILITY_z'] = z(B.ABILITY); B['PCT_z'] = z(B.PCT)
RACE, ACAD = ['BLACK', 'HISPANIC'], ['ABILITY', 'PCT']
MAIN = RACE + ACAD

def fit(est, cols, sub=None, **kw):
    D = B if sub is None else B.loc[sub.index]
    yv = df.BA if sub is None else sub.BA
    X = sm.add_constant(D[cols].astype(float), has_constant='add')
    if est == 'logit':  return sm.Logit(yv, X).fit(disp=0, maxiter=500, **kw)
    if est == 'probit': return sm.Probit(yv, X).fit(disp=0, maxiter=500, **kw)
    return sm.OLS(yv, X).fit(**kw)

def fs(est, focal, ctrl, sub=None, **kw):
    m = fit(est, [focal] + [c for c in ctrl if c != focal], sub=sub, **kw)
    b, se, p = m.params[focal], m.bse[focal], m.pvalues[focal]
    lo, hi = m.conf_int(alpha=0.05).loc[focal]
    return dict(b=b, se=se, z=b/se, p=p, lo=lo, hi=hi, m=m)

