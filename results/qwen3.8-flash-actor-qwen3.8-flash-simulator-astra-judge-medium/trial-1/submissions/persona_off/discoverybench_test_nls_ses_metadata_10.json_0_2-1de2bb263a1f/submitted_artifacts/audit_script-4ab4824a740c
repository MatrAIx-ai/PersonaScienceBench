"""
NLS SES / BA-degree-completion -- data audit + coefficient-decomposition analysis
Question: which variable's effect on BA DEGREE COMPLETED decreases from 0.3636 to
-0.2293 (and loses significance) once BOTH race and academic characteristics enter?
"""
import itertools, warnings, math
import numpy as np, pandas as pd, statsmodels.api as sm
warnings.filterwarnings('ignore')
pd.set_option('display.width', 220); pd.set_option('display.max_rows', 300)

OUT = open('analysis/report.txt', 'w')
def P(*a):
    s = ' '.join(str(x) for x in a); print(s); OUT.write(s + '\n')

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y  = df['BA DEGREE COMPLETED'].astype(float)
z  = lambda s: (s - s.mean()) / s.std(ddof=1)

# ---------------------------------------------------------------- 1. AUDIT
P("="*78); P("1. DATA AUDIT"); P("="*78)
P("shape:", df.shape, "| duplicate CASE ID:", int(df['CASE ID'].duplicated().sum()))
P(pd.DataFrame({'dtype': df.dtypes.astype(str), 'non_missing': df.notna().sum(),
                'missing': df.isna().sum(), 'pct_missing': (100*df.isna().mean()).round(2),
                'n_unique': df.nunique()}).to_string())
P("\ncategorical levels:")
for c in ['SAMPLE_RACE', 'SAMPLE_SEX', 'BA DEGREE COMPLETED']:
    P(f"  {c}: " + ", ".join(f"{k}={v}" for k, v in df[c].value_counts().items()))
P("\nnumeric distributions:")
P(df[['FAMILY SIZE OF SAMPLE', 'ABILITY: COMPOSITE OF ASVAB SCORE',
      'PERCENTILE IN CLASS', 'SES']].describe(percentiles=[.05,.25,.5,.75,.95]).T.round(3).to_string())
P("\nBA rate by race:\n ", df.groupby('SAMPLE_RACE')['BA DEGREE COMPLETED'].mean().round(4).to_dict())
P("BA rate by sex:\n ", df.groupby('SAMPLE_SEX')['BA DEGREE COMPLETED'].mean().round(4).to_dict())
P("overall BA rate:", round(y.mean(), 4), f"({int(y.sum())}/{len(y)})")

T = pd.DataFrame({'BA': y, 'SES': df.SES, 'ABILITY_z': z(df['ABILITY: COMPOSITE OF ASVAB SCORE']),
                  'PCT_z': z(df['PERCENTILE IN CLASS']), 'FAMSIZE': df['FAMILY SIZE OF SAMPLE'],
                  'FEMALE': (df.SAMPLE_SEX=='Female').astype(float),
                  'BLACK': (df.SAMPLE_RACE=='Black').astype(float),
                  'HISPANIC': (df.SAMPLE_RACE=='Hispanic').astype(float)})
P("\nPearson correlations with BA:\n", T.corr()['BA'].drop('BA').round(3).to_string())

# --------------------------------------------------- 2. BIVARIATE 'EFFECT' OF EACH VARIABLE
P("\n"+"="*78); P("2. BIVARIATE (UNADJUSTED) EFFECT OF EVERY CANDIDATE VARIABLE ON BA"); P("="*78)
VARS = {'SES (raw)': df.SES, 'SES (z)': z(df.SES),
        'ABILITY (z)': z(df['ABILITY: COMPOSITE OF ASVAB SCORE']),
        'PCT_IN_CLASS (z)': z(df['PERCENTILE IN CLASS']),
        'FAMILY SIZE (raw)': df['FAMILY SIZE OF SAMPLE'], 'FAMILY SIZE (z)': z(df['FAMILY SIZE OF SAMPLE']),
        'FEMALE': (df.SAMPLE_SEX=='Female').astype(float),
        'WHITE': (df.SAMPLE_RACE=='White').astype(float),
        'BLACK': (df.SAMPLE_RACE=='Black').astype(float),
        'HISPANIC': (df.SAMPLE_RACE=='Hispanic').astype(float)}
rows=[]
for k, v in VARS.items():
    X = sm.add_constant(v.astype(float), has_constant='add'); nm = X.columns[-1]
    lg = sm.Logit(y, X).fit(disp=0, maxiter=300); ol = sm.OLS(y, X).fit()
    rows.append({'var': k, 'logit_b': round(lg.params[nm],4), 'OR': round(np.exp(lg.params[nm]),3),
                 'logit_p': round(lg.pvalues[nm],4), 'LPM_b': round(ol.params[nm],5),
                 'LPM_p': round(ol.pvalues[nm],5), 'r_with_BA': round(np.corrcoef(v,y)[0,1],3)})
P(pd.DataFrame(rows).to_string(index=False))

# --------------------------------------- 3. DOES THE EFFECT SURVIVE RACE + ACADEMIC CONTROLS?
B = pd.DataFrame({'SES_raw': df.SES, 'SES_z': z(df.SES),
                  'ABIL_raw': df['ABILITY: COMPOSITE OF ASVAB SCORE'],
                  'PCT_raw': df['PERCENTILE IN CLASS'],
                  'FAM_raw': df['FAMILY SIZE OF SAMPLE'],
                  'FEMALE': (df.SAMPLE_SEX=='Female').astype(float),
                  'BLACK': (df.SAMPLE_RACE=='Black').astype(float),
                  'HISPANIC': (df.SAMPLE_RACE=='Hispanic').astype(float)}, index=df.index)
RACE, ACAD = ['BLACK','HISPANIC'], ['ABIL_raw','PCT_raw']
P("\n"+"="*78)
P("3. UNADJUSTED -> ADJUSTED (race + academic characteristics), per focal variable")
P("   adjusted spec: BA ~ focal + BLACK + HISPANIC + ABILITY(raw) + PERCENTILE(raw)")
P("="*78)
def logit_coef(focal, ctrl):
    X = sm.add_constant(B[[focal]+[c for c in ctrl if c != focal]].astype(float), has_constant='add')
    m = sm.Logit(y, X).fit(disp=0, maxiter=500)
    return m.params[focal], m.bse[focal], m.pvalues[focal]
rows=[]
for f in ['SES_raw','SES_z','ABIL_raw','PCT_raw','FAM_raw','FEMALE','BLACK','HISPANIC']:
    b0,s0,p0 = logit_coef(f, []); b1,s1,p1 = logit_coef(f, RACE+ACAD)
    rows.append({'focal':f,'b_unadj':round(b0,4),'p_unadj':round(p0,4),
                 'b_adj_race_acad':round(b1,4),'p_adj':round(p1,4),
                 'sign_flip':bool(b0>0>b1 or b0<0<b1),
                 'lost_sig(.05)':bool(p0<.05<=p1),
                 'pct_change':round(100*(b1-b0)/abs(b0),1)})
P(pd.DataFrame(rows).to_string(index=False))

# ---------------------------------------------- 4. STEPWISE LADDER FOR SES
P("\n"+"="*78); P("4. STEPWISE LADDER: HOW DOES THE SES EFFECT MOVE? (logit, raw SES)"); P("="*78)
LADDER = [('BA ~ SES  (bivariate)', ()),
          ('BA ~ SES + sex', ('FEMALE',)),
          ('BA ~ SES + race', ('BLACK','HISPANIC')),
          ('BA ~ SES + academic (ASVAB + class pct)', ('ABIL_raw','PCT_raw')),
          ('BA ~ SES + race + academic   <== target spec', RACE+ACAD),
          ('BA ~ SES + race + academic + sex', RACE+ACAD+['FEMALE']),
          ('BA ~ SES + race + academic + sex + family size', RACE+ACAD+['FEMALE','FAM_raw'])]
for tag, ctrl in LADDER:
    b,s,p = logit_coef('SES_raw', ctrl)
    P(f"  {tag:52s} b={b:+.4f} se={s:.4f} z={b/s:+.2f} p={p:.4f}  sig@.05={'Y' if p<.05 else 'N'} sig@.01={'Y' if p<.01 else 'N'}")

# ------------------------------------- 5. TARGET-VALUE SEARCH OVER NESTED RACE/ACADEMIC SPANS
P("\n"+"="*78); P("5. WHICH NESTED SPEC REPRODUCES 0.3636 -> -0.2293 ? (all 16 race/academic spans)"); P("="*78)
POOL=['BLACK','HISPANIC','ABIL_raw','PCT_raw']; rec=[]
for k in range(5):
    for c in itertools.combinations(POOL,k):
        b,s,p = logit_coef('SES_raw', list(c))
        rec.append({'controls':'+'.join(c) or 'none','b':round(b,4),'se':round(s,4),'p':round(p,4)})
L=pd.DataFrame(rec); P(L.to_string(index=False))
pairs=[]
for A in L.controls:
    for Bs in L.controls:
        sA=set([] if A=='none' else A.split('+')); sB=set([] if Bs=='none' else Bs.split('+'))
        if not sA < sB: continue
        bA=L.loc[L.controls==A,'b'].iloc[0]; bB=L.loc[L.controls==Bs,'b'].iloc[0]
        pB=L.loc[L.controls==Bs,'p'].iloc[0]
        pairs.append({'modelA':A,'modelB':Bs,'newly_added':'+'.join(sorted(sB-sA)),'bA':bA,'bB':bB,'pB':pB,
                      'abs_err':round(abs(bA-0.3636)+abs(bB+0.2293),4)})
P("\n  closest nested pairs to the published 0.3636 -> -0.2293:")
P(pd.DataFrame(pairs).sort_values('abs_err').head(6).to_string(index=False))

# ------------------------------------------------------ 6. FINAL TARGET MODEL
P("\n"+"="*78); P("6. TARGET MODEL OUTPUT: BA ~ SES + race + academic characteristics"); P("="*78)
X = sm.add_constant(B[['SES_raw','BLACK','HISPANIC','ABIL_raw','PCT_raw']].astype(float), has_constant='add')
m = sm.Logit(y, X).fit(disp=0, maxiter=500)
P(m.summary2().tables[1].round(4).to_string())
P("  pseudo-R2:", round(m.prsquared,4), " LLR p:", f"{m.llr_pvalue:.2e}", " n:", int(m.nobs))
mr = sm.Logit(y, X).fit(disp=0, maxiter=500, cov_type='HC1')
P("  robust(HC1) SES: b=%.4f se=%.4f p=%.4f" % (mr.params['SES_raw'], mr.bse['SES_raw'], mr.pvalues['SES_raw']))
P("  OR for SES: unadjusted %.3f -> adjusted %.3f" %
  (np.exp(sm.Logit(y, sm.add_constant(B[['SES_raw']].astype(float), has_constant='add')).fit(disp=0).params['SES_raw']),
   np.exp(m.params['SES_raw'])))
OUT.close()
