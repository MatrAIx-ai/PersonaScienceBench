"""
(1) ATTAINABILITY TEST - which group's coefficient can even BE -0.9568?
    Across the whole additive-adjustment family the race coefficient is bounded;
    if the target lies outside one group's attainable range, that group is
    excluded on arithmetic grounds rather than by proximity.
(2) RARE-EVENT ESTIMATOR CONVENTIONS (236 events): Firth penalised likelihood and
    Bayesian N(0,sigma^2) MAP, plus an L2-penalty sweep. These are the conventions
    that move a coefficient a few hundredths off its MLE value.
All results printed; no rounding toward the target.
"""
import warnings, itertools
import numpy as np, pandas as pd, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy.optimize import minimize
warnings.filterwarnings("ignore")
pd.set_option("display.width", 250)
T = -0.9568

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
df["female"] = (df.SAMPLE_SEX == "Female").astype(int)
df = df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE": "asvab",
                        "PERCENTILE IN CLASS": "pct", "FAMILY SIZE OF SAMPLE": "fams"})
COVS = ["SES", "asvab", "pct", "fams", "female"]
R = "C(SAMPLE_RACE, Treatment(reference='White'))"

print("=" * 104)
print("(1) ATTAINABLE RANGE OF THE RACE COEFFICIENT OVER ALL ADDITIVE ADJUSTMENTS")
print("=" * 104)
vals = {"Black": [], "Hispanic": []}
for r in range(len(COVS) + 1):
    for c in itertools.combinations(COVS, r):
        m = smf.logit("ba ~ " + R + ("" if not c else " + " + " + ".join(c)), data=df).fit(disp=0)
        for g in vals:
            p = [q for q in m.params.index if q.endswith("[T.%s]" % g)][0]
            vals[g].append(m.params[p])
for g, v in vals.items():
    v = np.array(v)
    print(f"  {g:9s} most negative attainable = {v.min():.6f} | least negative = {v.max():.6f} "
          f"| target {T} attainable? {bool(v.min() <= T <= v.max())} "
          f"| shortfall to target = {abs(v.min()-T):.6f}")
print("  -> unadjusted anchors: Black -1.005703, Hispanic -0.924136 (target sits between them)")

X = pd.DataFrame({"const": 1.0,
                  "Black": (df.SAMPLE_RACE == "Black").astype(float),
                  "Hispanic": (df.SAMPLE_RACE == "Hispanic").astype(float)})
A, y = X.values, df.ba.values.astype(float)

def llf(b):
    z = A @ b
    return float(np.sum(y * z - np.logaddexp(0, z)))

def info(b):
    p = 1 / (1 + np.exp(-(A @ b)))
    w = p * (1 - p)
    return (A * w[:, None]).T @ A

def third(b, k):
    p = 1 / (1 + np.exp(-(A @ b)))
    w = p * (1 - p) * (1 - 2 * p) * A[:, k]
    return (A * w[:, None]).T @ A

print("\n" + "=" * 104)
print("(2a) FIRTH PENALISED LOGISTIC (rare-event convention): max llf(b) + 0.5*log det I(b)")
print("=" * 104)

def firth_obj(b, sign=-1.0):
    s, ld = np.linalg.slogdet(info(b))
    return sign * (llf(b) + 0.5 * ld)

def firth_grad(b, sign=-1.0):
    I = info(b)
    Inv = np.linalg.inv(I)
    p = 1 / (1 + np.exp(-(A @ b)))
    g = A.T @ (y - p)
    for k in range(len(b)):
        g[k] -= 0.5 * np.trace(Inv @ third(b, k))
    return sign * g

b0 = np.array([np.log(y.mean() / (1 - y.mean())), 0.0, 0.0])
res = minimize(firth_obj, b0, jac=lambda b: firth_grad(b), method="BFGS",
               options=dict(maxiter=500, gtol=1e-10))
print(f"  converged={res.success}")
print(f"  Firth  Black   = {res.x[1]:.6f}   (MLE -1.005703, target {T}) diff={res.x[1]-T:+.6f}")
print(f"  Firth  Hispanic= {res.x[2]:.6f}   (MLE -0.924136, target {T}) diff={res.x[2]-T:+.6f}")

print("\n" + "=" * 104)
print("(2b) BAYESIAN MAP, N(0, sigma^2) priors on the race coefficients (intercept flat)")
print("=" * 104)
for sg in [0.5, 1.0, 1.5, 2.0, 2.5, 5.0, 10.0]:
    def obj(b, sg=sg):
        return -(llf(b) - 0.5 * (b[1] ** 2 + b[2] ** 2) / sg ** 2)
    def gr(b, sg=sg):
        p = 1 / (1 + np.exp(-(A @ b)))
        g = -(A.T @ (y - p))
        g[1:] += b[1:] / sg ** 2
        return g
    r = minimize(obj, b0, jac=gr, method="BFGS", options=dict(maxiter=500))
    print(f"  sigma={sg:5.1f}  Black={r.x[1]: .6f} (diff {r.x[1]-T:+.6f})   "
          f"Hispanic={r.x[2]: .6f} (diff {r.x[2]-T:+.6f})")

print("\n" + "=" * 104)
print("(2c) L2 PENALTY SWEEP (sklearn-style, race dummies on 0/1 scale): which penalty")
print("     strength would be REQUIRED to move each coefficient onto the target?")
print("=" * 104)
for lam in [0.0, 0.1, 0.5, 1.0, 2.0, 5.0, 10.0, 20.0, 50.0]:
    def obj(b, lam=lam):
        return -(llf(b) - 0.5 * lam * (b[1] ** 2 + b[2] ** 2))
    def gr(b, lam=lam):
        p = 1 / (1 + np.exp(-(A @ b)))
        g = -(A.T @ (y - p))
        g[1:] += lam * b[1:]
        return g
    r = minimize(obj, b0, jac=gr, method="BFGS", options=dict(maxiter=500))
    print(f"  lambda={lam:5.1f}  Black={r.x[1]: .6f} (diff {r.x[1]-T:+.6f})   "
          f"Hispanic={r.x[2]: .6f} (diff {r.x[2]-T:+.6f})")

print("\n" + "=" * 104)
print("(2d) PENALTY / PRIOR STRENGTH THAT WOULD BE NEEDED for each group to equal -0.9568")
print("=" * 104)
for g, idx in [("Black", 1), ("Hispanic", 2)]:
    lo, hi = 0.0, 200.0
    for _ in range(70):
        mid = 0.5 * (lo + hi)
        def obj(b, lam=mid):
            return -(llf(b) - 0.5 * lam * (b[1] ** 2 + b[2] ** 2))
        def gr(b, lam=mid):
            p = 1 / (1 + np.exp(-(A @ b)))
            gg = -(A.T @ (y - p)); gg[1:] += lam * b[1:]; return gg
        r = minimize(obj, b0, jac=gr, method="BFGS", options=dict(maxiter=500))
        if r.x[idx] > T:      # coefficient too high (less negative) -> need less shrinkage? track
            lo = mid
        else:
            hi = mid
    print(f"  {g:9s}: lambda making coef = {T} is ~{0.5*(lo+hi):.4f} "
          f"(0 = unpenalised MLE; note MLE itself is already {'beyond' if (vals[g].__class__ and True) else ''} "
          f"{'more negative' if idx==1 else 'less negative'} than the target)")

print("\n" + "=" * 104)
print("(3) BOOTSTRAP: can the data arbitrate Black(-1.0057) vs Hispanic(-0.9241)?")
print("=" * 104)
rng = np.random.default_rng(20261022)
idx_by = {g: np.where(df.SAMPLE_RACE.values == g)[0] for g in ["Black", "Hispanic", "White"]}
bs = {"Black": [], "Hispanic": []}
for _ in range(2000):
    take = np.concatenate([rng.choice(idx_by[g], len(idx_by[g]), replace=True) for g in idx_by])
    dd = df.iloc[take]
    race = pd.get_dummies(dd.SAMPLE_RACE, drop_first=False)
    Z = np.column_stack([np.ones(len(dd)), (dd.SAMPLE_RACE == "Black").values.astype(float),
                         (dd.SAMPLE_RACE == "Hispanic").values.astype(float)])
    yy = dd.ba.values.astype(float)
    if yy.sum() < 20 or (dd.SAMPLE_RACE == "Hispanic").sum() == 0:
        continue
    r = minimize(lambda b: -float(np.sum(yy * (Z @ b) - np.logaddexp(0, Z @ b))), b0,
                 method="BFGS", options=dict(maxiter=300))
    bs["Black"].append(r.x[1]); bs["Hispanic"].append(r.x[2])
for g in bs:
    a = np.array(bs[g])
    print(f"  {g:9s} bootstrap n={len(a)} mean={a.mean(): .4f} sd={a.std():.4f} "
          f"95% CI=[{np.percentile(a,2.5): .4f},{np.percentile(a,97.5): .4f}] "
          f"| P(boot coef within 0.0005 of target) = {np.mean(np.abs(a-T)<=0.0005):.4f}")
    print(f"            P(boot coef <= target) = {np.mean(a<=T):.4f}")
d = np.array(bs["Black"]) - np.array(bs["Hispanic"])
print(f"  Black-Hispanic difference: mean={d.mean(): .4f} sd={d.std():.4f} "
      f"95% CI=[{np.percentile(d,2.5): .4f},{np.percentile(d,97.5): .4f}]")
print(f"  target -0.9568 is {(T - (-1.005703)):+.6f} from Black MLE and {(T-(-0.924136)):+.6f} from Hispanic MLE;")
print(f"  Black bootstrap sd = {np.std(bs['Black']):.4f} -> gap is {abs(T-(-1.005703))/np.std(bs['Black']):.3f} SDs")
print(f"                                            gap (Hispanic) is {abs(T-(-0.924136))/np.std(bs['Hispanic']):.3f} SDs")
