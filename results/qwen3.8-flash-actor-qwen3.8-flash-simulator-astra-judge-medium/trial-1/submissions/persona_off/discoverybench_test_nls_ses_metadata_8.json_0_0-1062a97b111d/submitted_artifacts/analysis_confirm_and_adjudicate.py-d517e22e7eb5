"""
CONFIRMATION + ADJUDICATION of the -0.9568 attribution (corrected).
1. L2-penalised (sklearn C=1) race-only logit solved THREE independent ways:
   analytic Newton, L-BFGS with analytic gradient, and a derivative-free
   Nelder-Mead / fine-grid check. Agreement across methods = the coefficient value
   is a property of the objective, not of one optimiser.
2. Scale-invariance: does standardising/centring the continuous covariates move the
   race coefficient in an UNPENALISED logit? If not, scaling conventions cannot
   explain the ~0.05 offset and only a penalty (or a different sample) can.
3. Monotonicity proof: as the penalty grows both coefficients shrink toward 0, so
   the attainable range for each group is bounded by its unpenalised MLE.
4. Final candidate table with SEs, CIs, odds ratios, and z/p against the target.
"""
import warnings
import numpy as np, pandas as pd, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy.optimize import minimize
from scipy.stats import norm
warnings.filterwarnings("ignore")
pd.set_option("display.width", 250)
T = -0.9568

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
df["female"] = (df.SAMPLE_SEX == "Female").astype(int)
df = df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE": "asvab",
                        "PERCENTILE IN CLASS": "pct", "FAMILY SIZE OF SAMPLE": "fams"})
df["Black"] = (df.SAMPLE_RACE == "Black").astype(float)
df["Hispanic"] = (df.SAMPLE_RACE == "Hispanic").astype(float)
yv = df.ba.values.astype(float)


def neg_pen_loglik(b, Xv, yv, lam):
    z = Xv @ b
    return -(np.sum(yv * z - np.logaddexp(0, z)) - 0.5 * lam * np.sum(b[1:] ** 2))


def grad_pen(b, Xv, yv, lam):
    p = 1.0 / (1.0 + np.exp(-(Xv @ b)))
    g = -(Xv.T @ (yv - p))
    reg = np.zeros(len(b)); reg[1:] = lam * b[1:]
    return g + reg


def hess_pen(b, Xv, yv, lam):
    p = 1.0 / (1.0 + np.exp(-(Xv @ b)))
    H = (Xv * (p * (1 - p))[:, None]).T @ Xv
    reg = np.eye(len(b)) * lam; reg[0, 0] = 0.0
    return H + reg


def newton(Xv, yv, lam, iters=200):
    b = np.zeros(Xv.shape[1])
    b[0] = np.log(yv.mean() / (1 - yv.mean()))
    for _ in range(iters):
        step = np.linalg.solve(hess_pen(b, Xv, yv, lam), grad_pen(b, Xv, yv, lam))
        b = b - step
        if np.max(np.abs(step)) < 1e-13:
            break
    return b


print("=" * 104)
print("1) L2-penalised race-only logit (White reference) solved three independent ways")
print("=" * 104)
X2 = sm.add_constant(df[["Black", "Hispanic"]].astype(float), prepend=True).values
print(f"{'lambda':>8} | {'Newton Black':>13} {'LBFGS Black':>12} {'NelderMead Black':>17} "
      f"| {'Newton Hispan':>13} {'LBFGS Hispan':>12} | |NewtonB-T|  | |NewtonH-T|")
for lam in [0.0, 0.5, 1.0, 1.1106, 1.5, 3.0, 10.0]:
    bn = newton(X2, yv, lam)
    bl = minimize(neg_pen_loglik, bn, args=(X2, yv, lam), jac=grad_pen,
                  method="L-BFGS-B", options=dict(maxiter=50000, ftol=1e-16, gtol=1e-14)).x
    bnm = minimize(neg_pen_loglik, bn, args=(X2, yv, lam), method="Nelder-Mead",
                   options=dict(maxiter=300000, xatol=1e-11, fatol=1e-13)).x
    print(f"{lam:8.4f} | {bn[1]:13.6f} {bl[1]:12.6f} {bnm[1]:17.6f} | {bn[2]:13.6f} "
          f"{bl[2]:12.6f} | {abs(bn[1]-T):9.6f} | {abs(bn[2]-T):9.6f}")

print("\n  Fine derivative-free grid check at the sklearn default C=1 (lambda=1):")
grid = np.linspace(-1.05, -0.85, 401)
grid2 = np.linspace(-1.00, -0.80, 401)
best = min(((neg_pen_loglik(np.array([-3.3, g1, g2]), X2, yv, 1.0), g1, g2)
            for g1 in grid for g2 in grid2), key=lambda t: t[0])
print(f"    argmin on grid: Black={best[1]:.6f}  Hispanic={best[2]:.6f}  (Newton Black="
      f"{newton(X2, yv, 1.0)[1]:.6f})")

print("\n" + "=" * 104)
print("2) SCALE-INVARIANCE of the race coefficient under covariate standardisation (unpenalised)")
print("=" * 104)
f = "ba ~ C(SAMPLE_RACE, Treatment(reference='White')) + SES + asvab + pct + fams + female"
base = smf.logit(f, data=df).fit(disp=0)
d2 = df.copy()
for c in ["SES", "asvab", "pct", "fams"]:
    d2[c] = (d2[c] - d2[c].mean()) / d2[c].std(ddof=0)
alt = smf.logit(f, data=d2).fit(disp=0)
for g in ["Black", "Hispanic"]:
    p = [q for q in base.params.index if q.endswith("[T.%s]" % g)][0]
    print(f"  {g:9s} raw-X={base.params[p]:.8f}  standardised-X={alt.params[p]:.8f}  "
          f"diff={alt.params[p]-base.params[p]:+.2e}")
print("  -> scaling/centring covariates leaves the race coefficient UNCHANGED; only a")
print("     penalty (or a different sample) moves it off its MLE value.")

print("\n" + "=" * 104)
print("3) MONOTONICITY / ATTAINABLE RANGE as a function of penalty strength")
print("=" * 104)
rows = []
for lam in [0, .25, .5, .75, 1, 1.1106, 1.5, 2, 3, 5, 10, 50, 200]:
    b = newton(X2, yv, float(lam))
    rows.append((float(lam), b[1], b[2], abs(b[1] - T), abs(b[2] - T)))
tab = pd.DataFrame(rows, columns=["lambda", "Black", "Hispanic", "Black_dist", "Hispanic_dist"])
print(tab.to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print(f"  Both coefficients shrink monotonically toward 0 as lambda increases.")
print(f"  Black attainable range (lambda>=0): [{tab.Black.min():.6f}, 0)  -> contains {T}: "
      f"{bool(tab.Black.min() <= T < 0)}")
print(f"  Hispanic attainable range (lambda>=0): [{tab.Hispanic.min():.6f}, 0) -> contains {T}: "
      f"{bool(tab.Hispanic.min() <= T < 0)}   (MLE {tab.Hispanic.iloc[0]:.6f} is already less negative than the target)")

print("\n" + "=" * 104)
print("4) FINAL CANDIDATE TABLE (logit, White = reference) with inference against the target")
print("=" * 104)
out = []
specs = {"(a) race only, unadjusted MLE": "",
         "(a') race + sex, MLE": " + female",
         "(b) race + SES, MLE": " + SES",
         "(e) fully adjusted, MLE": " + SES + asvab + pct + fams + female"}
for lab, extra in specs.items():
    m = smf.logit("ba ~ C(SAMPLE_RACE, Treatment(reference='White'))" + extra, data=df).fit(disp=0)
    for g in ["Black", "Hispanic"]:
        p = [q for q in m.params.index if q.endswith("[T.%s]" % g)][0]
        lo, hi = m.conf_int().loc[p]; b, s = m.params[p], m.bse[p]
        out.append(dict(spec=lab, group=g, coef=b, se=s, ci95_lo=lo, ci95_hi=hi,
                        odds_ratio=np.exp(b), coef_minus_target=b - T,
                        z_vs_target=(b - T) / s, p_vs_target=2 * (1 - norm.cdf(abs((b - T) / s))),
                        target_in_CI=bool(lo <= T <= hi)))
for lab, cols in [("L2 C=1 (sklearn convention) race only [DIAGNOSTIC]", ["Black", "Hispanic"]),
                  ("L2 C=1 (sklearn convention) race + sex [DIAGNOSTIC]", ["Black", "Hispanic", "female"])]:
    Xc = sm.add_constant(df[cols].astype(float), prepend=True).values
    b = newton(Xc, yv, 1.0)
    for i, g in enumerate(cols, start=1):
        if g in ("Black", "Hispanic"):
            out.append(dict(spec=lab, group=g, coef=b[i], se=np.nan, ci95_lo=np.nan, ci95_hi=np.nan,
                            odds_ratio=np.exp(b[i]), coef_minus_target=b[i] - T,
                            z_vs_target=np.nan, p_vs_target=np.nan, target_in_CI=np.nan))
fin = pd.DataFrame(out).assign(adist=lambda d: d.coef_minus_target.abs()).sort_values("adist")
fin.to_csv("analysis/final_candidate_table.csv", index=False)
print(fin.drop(columns=["adist"]).to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print(f"\nTarget in log-odds = {T}; odds ratio exp(-0.9568) = {np.exp(T):.4f} "
      f"= {100*(1-np.exp(T)):.1f}% lower odds of completing a BA.")
print(f"Target implied probability if White baseline p=0.035413: "
      f"{1/(1+np.exp(-(-3.304617 + T))):.6f}  (White 0.035413)")
