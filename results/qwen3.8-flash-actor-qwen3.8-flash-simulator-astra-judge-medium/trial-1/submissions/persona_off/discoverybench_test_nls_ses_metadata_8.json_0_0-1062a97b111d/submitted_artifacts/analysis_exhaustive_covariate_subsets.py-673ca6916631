"""
EXHAUSTIVE, FULLY-REPORTED SECONDARY SWEEP (not a cherry-picked search).
The approved ladder + penalised diagnostic produced NO coefficient within 0.02 of
-0.9568, so instead of quietly testing ad-hoc specifications, every one of the
2^5 = 31 subsets of the five available covariates is fitted and ALL results are
printed. This makes the selection rule auditable and shows whether any spec
reproduces the target, rather than shopping for one.
Model family: unweighted MLE logit, White = omitted reference (approved primary).
Match rule unchanged: |coef + 0.9568| <= 0.0005 exact; <= 0.02 near.
NOTE: race x sex interactions and subsamples remain DEFERRED per the researcher.
"""
import itertools, warnings
import numpy as np, pandas as pd, statsmodels.formula.api as smf
warnings.filterwarnings("ignore")
pd.set_option("display.width", 250); pd.set_option("display.max_rows", 500)

TARGET = -0.9568
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
df["female"] = (df.SAMPLE_SEX == "Female").astype(int)
df = df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE": "asvab",
                        "PERCENTILE IN CLASS": "pct", "FAMILY SIZE OF SAMPLE": "fams"})
COVS = ["SES", "asvab", "pct", "fams", "female"]
R = "C(SAMPLE_RACE, Treatment(reference='White'))"

rows = []
for r in range(0, len(COVS) + 1):
    for combo in itertools.combinations(COVS, r):
        f = "ba ~ " + R + ("" if not combo else " + " + " + ".join(combo))
        m = smf.logit(f, data=df).fit(disp=0)
        for g in ["Black", "Hispanic"]:
            p = [q for q in m.params.index if q.endswith("[T.%s]" % g)][0]
            lo, hi = m.conf_int().loc[p]
            rows.append(dict(n_covs=len(combo), covariates="+".join(combo) or "(none)",
                             group=g, coef=m.params[p], se=m.bse[p], ci_lo=lo, ci_hi=hi,
                             pval=m.pvalues[p], llf=m.llf, aic=m.aic,
                             abs_diff=abs(m.params[p] - TARGET),
                             target_in_CI=bool(lo <= TARGET <= hi)))
res = pd.DataFrame(rows)
res["exact_0.0005"] = res.abs_diff <= 0.0005
res["near_0.02"] = res.abs_diff <= 0.02
res.to_csv("analysis/exhaustive_subset_coefficients.csv", index=False)

print("=" * 110)
print(f"ALL 62 race coefficients ({2**len(COVS)} covariate subsets x 2 minority groups), logit, White ref")
print("=" * 110)
print(res.sort_values("abs_diff").to_string(index=False, float_format=lambda v: f"{v:.6f}"))

print("\n" + "=" * 110)
print("EXACT MATCHES (|coef + 0.9568| <= 0.0005):")
print("=" * 110)
e = res[res['exact_0.0005']]
print("NONE" if e.empty else e.to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print("\nNEAR MATCHES (<= 0.02):")
n = res[res['near_0.02']]
print("NONE" if n.empty else n.to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print("\nNearest 5 overall:")
print(res.nsmallest(5, "abs_diff").to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print("\nNearest per group:")
print(res.loc[res.groupby("group").abs_diff.idxmin()].to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print("\nNumber of distinct coefficients spanning the target:",
      f"{res.coef.min():.4f} to {res.coef.max():.4f}; "
      f"count with |coef| in [0.94,0.98] = {int(((res.coef<=-0.94)&(res.coef>=-0.98)).sum())}")
