"""
CORRECTED Firth implementation + systematic L2-penalty scan.
Firth (1993): maximise  llf(b) + 0.5*log|I(b)| ; gradient = X'(y-p) + 0.5*tr(I^-1 dI/db_k).
(The earlier script subtracted the trace term - a sign error - so its Firth numbers
are retracted and recomputed here.)
Also: sklearn-style L2 (C=1 => lambda=1 on the 0/1 dummy scale, unpenalised intercept)
fitted over ALL 31 covariate subsets, unstandardised, to see whether a software
convention reproduces -0.9568 for Black or for Hispanic.
Finally: bisection for the penalty strength that would put each group exactly on -0.9568.
"""
import warnings, itertools
import numpy as np, pandas as pd, statsmodels.formula.api as smf
from scipy.optimize import minimize, brentq
warnings.filterwarnings("ignore")
pd.set_option("display.width", 250)
T = -0.9568

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
df["female"] = (df.SAMPLE_SEX == "Female").astype(int)
df = df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE": "asvab",
                        "PERCENTILE IN CLASS": "pct", "FAMILY SIZE OF SAMPLE": "fams"})
COVS = ["SES", "asvab", "pct", "fams", "female"]
R = "C(SAMPLE_RACE, Treatment(reference='White'))"
A = np.column_stack([np.ones(len(df)), (df.SAMPLE_RACE == "Black").astype(float),
                     (df.SAMPLE_RACE == "Hispanic").astype(float)])
y = df.ba.values.astype(float)

def llf(b):
    return float(np.sum(y * (A @ b) - np.logaddexp(0, A @ b)))
def grad_llf(b):
    return A.T @ (y - 1 / (1 + np.exp(-(A @ b))))
def info(b):
    p = 1 / (1 + np.exp(-(A @ b))); return (A * (p*(1-p))[:, None]).T @ A
def dinfo(b, k):
    p = 1 / (1 + np.exp(-(A @ b)))
    w = p*(1-p)*(1-2*p)*A[:, k]; return (A * w[:, None]).T @ A

print("=" * 100); print("CORRECTED FIRTH (race-only logit, White reference)"); print("=" * 100)
def f_neg(b):
    _, ld = np.linalg.slogdet(info(b)); return -(llf(b) + 0.5*ld)
def f_grad(b):
    Inv = np.linalg.inv(info(b)); g = grad_llf(b).copy()
    for k in range(len(b)): g[k] += 0.5*np.trace(Inv @ dinfo(b, k))
    return -g
b0 = np.array([np.log(y.mean()/(1-y.mean())), 0.0, 0.0])
r = minimize(f_neg, b0, jac=f_grad, method="BFGS", options=dict(maxiter=2000, gtol=1e-12))
print(f"converged={r.success} |grad|={np.linalg.norm(f_grad(r.x)):.3e}")
print(f"  MLE   : Black -1.005703  Hispanic -0.924136")
print(f"  Firth : Black {r.x[1]:.6f} (|diff to target|={abs(r.x[1]-T):.6f})   "
      f"Hispanic {r.x[2]:.6f} (|diff|={abs(r.x[2]-T):.6f})")

print("\n" + "=" * 100)
print("sklearn-STYLE L2 (C=1 -> lambda=1) OVER ALL 31 COVARIATE SUBSETS, unstandardised")
print("=" * 100)
rows = []
for nsub in range(len(COVS)+1):
    for c in itertools.combinations(COVS, nsub):
        cols = list(c)
        Xf = np.column_stack([np.ones(len(df)),
                              (df.SAMPLE_RACE=="Black").astype(float),
                              (df.SAMPLE_RACE=="Hispanic").astype(float)] +
                             [df[k].astype(float).values for k in cols])
        def obj(b, lam=1.0, ncol=len(cols)):
            z = Xf @ b
            pen = 0.5*lam*(b[1]**2 + b[2]**2 + (b[3:]**2).sum()) if ncol else 0.5*lam*(b[1]**2+b[2]**2)
            return -(np.sum(y*z - np.logaddexp(0, z)) - pen)
        def jac(b, lam=1.0):
            p = 1/(1+np.exp(-(Xf@b))); g = -(Xf.T @ (y-p))
            g[1:] += lam*b[1:]; return g
        rr = minimize(obj, np.zeros(Xf.shape[1]), jac=jac, method="L-BFGS-B",
                      options=dict(maxiter=8000, ftol=1e-15))
        for i, gname in [(1, "Black"), (2, "Hispanic")]:
            rows.append(dict(n_covs=len(cols), covs="+".join(cols) or "(none)", group=gname,
                             coef_L2_C1=rr.x[i], abs_diff=abs(rr.x[i]-T)))
s = pd.DataFrame(rows).sort_values("abs_diff")
s.to_csv("analysis/L2_C1_all_subsets.csv", index=False)
print(s.head(12).to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print("\nBest Black candidate under L2(C=1):")
print(s[s.group=="Black"].nsmallest(3, "abs_diff").to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print("\nBest Hispanic candidate under L2(C=1):")
print(s[s.group=="Hispanic"].nsmallest(3, "abs_diff").to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print(f"\nAny exact match (<=0.0005)? {'YES' if (s.abs_diff<=0.0005).any() else 'NO'}"
      f" | any within 0.02? {'YES' if (s.abs_diff<=0.02).any() else 'NO'}")
print(f"L2(C=1) attainable range  Black: [{s[s.group=='Black'].coef_L2_C1.min():.6f}, "
      f"{s[s.group=='Black'].coef_L2_C1.max():.6f}]  Hispanic: "
      f"[{s[s.group=='Hispanic'].coef_L2_C1.min():.6f}, {s[s.group=='Hispanic'].coef_L2_C1.max():.6f}]")

print("\n" + "=" * 100)
print("BISECTION: penalty lambda needed to place each coefficient exactly on -0.9568")
print("=" * 100)
def coef_at(lam, idx):
    def obj(b):
        z = A @ b
        return -(np.sum(y*z - np.logaddexp(0, z)) - 0.5*lam*(b[1]**2 + b[2]**2))
    def jac(b):
        p = 1/(1+np.exp(-(A@b))); g = -(A.T @ (y-p)); g[1:] += lam*b[1:]; return g
    return minimize(obj, b0, jac=jac, method="BFGS", options=dict(maxiter=2000)).x[idx]
for gname, idx in [("Black", 1), ("Hispanic", 2)]:
    f = lambda lam: coef_at(lam, idx) - T
    try:
        lam_star = brentq(f, 1e-6, 30.0, xtol=1e-8)
        print(f"  {gname:9s}: lambda* = {lam_star:.6f}  (coef at lambda*: {coef_at(lam_star, idx):.6f}); "
              f"MLE(lam=0)={coef_at(0.0, idx):.6f}")
    except ValueError as e:
        print(f"  {gname:9s}: NO penalty strength reproduces {T} "
              f"(f(0)={f(1e-6):+.6f}, f(30)={f(30.0):+.6f}) -> target unattainable for this group")
