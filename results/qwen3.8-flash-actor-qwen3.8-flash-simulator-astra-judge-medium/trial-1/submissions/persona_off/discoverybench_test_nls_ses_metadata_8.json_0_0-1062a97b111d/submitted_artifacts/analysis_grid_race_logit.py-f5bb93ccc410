"""
MAIN WORK: locate the quantity -0.9568 in a pre-declared specification grid.

Design (approved by researcher):
  * Outcome: BA DEGREE COMPLETED, 1 = completed, 0 = not completed (never inverted).
  * Primary: unweighted MLE logistic regression (log-odds scale), default MLE SEs,
    no regularization, no design weights. White = omitted reference.
  * Falsification: the same ladder re-run with Black and with Hispanic references.
  * Ladder: (a) race only; (b) race+SES; (c) race+SES+ASVAB;
            (d) race+ASVAB+class percentile; (e) fully adjusted
            (SES + ASVAB + percentile + family size + sex).
  * All three race contrasts retained; Black-vs-Hispanic checked for magnitude.
  * Scale/link robustness rows (LPM, probit, cloglog): documented, NOT literal
    candidates (different scales).
  * One labelled SOFTWARE-CONVENTION diagnostic: L2-penalised logit on standardised
    covariates reproducing the sklearn LogisticRegression(C=1) objective
    min_w sum_i loss_i + 0.5||w||^2 with unpenalised intercept (sklearn is not
    installable offline, so the exact objective is reimplemented in scipy).
  * Matching rule fixed BEFORE fitting: |coef-(-0.9568)| <= 0.0005 = MATCH; every
    coefficient within 0.02 listed with its full specification. No rounding/nudging.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.genmod.families import Binomial
from scipy.optimize import minimize

warnings.filterwarnings("ignore")
pd.set_option("display.width", 250)
pd.set_option("display.max_columns", 60)
pd.set_option("display.max_rows", 500)

TARGET = -0.9568
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["ba"] = df["BA DEGREE COMPLETED"].astype(int)
df["female"] = (df["SAMPLE_SEX"] == "Female").astype(int)
df = df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE": "asvab",
                        "PERCENTILE IN CLASS": "pct",
                        "FAMILY SIZE OF SAMPLE": "fams"})
df["raceB"] = (df.SAMPLE_RACE == "Black").astype(float)
df["raceH"] = (df.SAMPLE_RACE == "Hispanic").astype(float)
R = "C(SAMPLE_RACE, Treatment(reference='%s'))"

LADDER = {
    "(a) race only":                              [],
    "(b) race + SES":                             ["SES"],
    "(c) race + SES + ASVAB":                     ["SES", "asvab"],
    "(d) race + ASVAB + class percentile":        ["asvab", "pct"],
    "(e) fully adjusted (SES+ASVAB+pct+fam+sex)": ["SES", "asvab", "pct", "fams", "female"],
}
rows = []


def grab(m, model_lab, note, link, ref, scale, se_scale=1.0):
    for p in m["params"].index:
        if "SAMPLE_RACE" not in p:
            continue
        g = p.split("T.")[-1].rstrip("]")
        lo, hi = m["ci"].loc[p]
        rows.append(dict(model=model_lab, note=note, link=link, reference=ref, group=g,
                         coef=m["params"][p], se=m["bse"][p] * se_scale,
                         ci_lo=lo, ci_hi=hi, pval=m["pvalues"][p], llf=m["llf"],
                         conv=m["conv"], nobs=len(df), scale=scale))


def logit_fit(formula, ref, lab, note):
    m = smf.logit(formula, data=df).fit(disp=0)
    grab(dict(params=m.params, bse=m.bse, ci=m.conf_int(), pvalues=m.pvalues, llf=m.llf,
              conv=bool(m.mle_retvals["converged"])), lab, note, "logit", ref, "log-odds")
    return m


print("#" * 100)
print("PRIMARY GRID: unweighted MLE logit, WHITE = omitted reference, ladder (a)-(e)")
print("#" * 100)
for lab, covs in LADDER.items():
    rhs = R % "White" + ("" if not covs else " + " + " + ".join(covs))
    m = logit_fit("ba ~ " + rhs, "White", lab, "primary ladder")
    print(f"\n--- {lab} | llf={m.llf:.4f} pseudo_R2={m.prsquared:.6f} "
          f"converged={m.mle_retvals['converged']} n={int(m.nobs)} ---")
    print(m.summary2().tables[1].to_string(float_format=lambda v: f"{v:.4f}"))

print("\n" + "#" * 100)
print("FALSIFICATION CHECK: same ladder with Black-referenced and Hispanic-referenced coding")
print("#" * 100)
for ref in ["Black", "Hispanic"]:
    for lab, covs in LADDER.items():
        rhs = R % ref + ("" if not covs else " + " + " + ".join(covs))
        m = logit_fit("ba ~ " + rhs, ref, lab, f"falsification ref={ref}")
        print(f"\n--- ref={ref} | {lab} ---")
        print(m.summary2().tables[1].to_string(float_format=lambda v: f"{v:.4f}"))

print("\n" + "#" * 100)
print("LINK / SCALE ROBUSTNESS (documented; NOT literal candidates for -0.9568)")
print("#" * 100)
for lab, covs in LADDER.items():
    rhs = R % "White" + ("" if not covs else " + " + " + ".join(covs))
    mp = smf.probit("ba ~ " + rhs, data=df).fit(disp=0)
    grab(dict(params=mp.params, bse=mp.bse, ci=mp.conf_int(), pvalues=mp.pvalues,
              llf=mp.llf, conv=bool(mp.mle_retvals["converged"])), lab,
         "probit link - different scale, NOT a literal candidate", "probit", "White", "probit z-units")
    mc = smf.glm("ba ~ " + rhs, data=df,
                 family=Binomial(link=sm.families.links.CLogLog())).fit()
    grab(dict(params=mc.params, bse=mc.bse, ci=mc.conf_int(), pvalues=mc.pvalues,
              llf=mc.llf, conv=True), lab,
         "cloglog link - different scale, NOT a literal candidate", "cloglog", "White", "cloglog-units")
    ml_ = smf.ols("ba ~ " + rhs, data=df).fit()
    grab(dict(params=ml_.params, bse=ml_.bse, ci=ml_.conf_int(), pvalues=ml_.pvalues,
              llf=ml_.llf, conv=True), lab, "LPM scale-mismatch robustness row", "OLS/LPM",
         "White", "probability")
print("\nprobit / cloglog / LPM coefficient tables (fully adjusted rung (e)):")
for kind, m in [("probit", smf.probit(f"ba ~ {R % 'White'} + SES + asvab + pct + fams + female", data=df).fit(disp=0)),
                ("cloglog", smf.glm(f"ba ~ {R % 'White'} + SES + asvab + pct + fams + female", data=df,
                                    family=Binomial(link=sm.families.links.CLogLog())).fit()),
                ("LPM", smf.ols(f"ba ~ {R % 'White'} + SES + asvab + pct + fams + female", data=df).fit())]:
    print(f"\n[{kind}] rung (e)")
    print(m.summary2().tables[1].to_string(float_format=lambda v: f"{v:.6f}"))

print("\n" + "#" * 100)
print("SOFTWARE-CONVENTION DIAGNOSTIC (NOT primary): sklearn LogisticRegression(C=1) style")
print("  objective min_w sum_i loss_i + 0.5||w||^2 ; intercept unpenalised ; X standardised")
print("#" * 100)


def sklearn_l2(cols):
    X = df[cols].astype(float)
    mu, sd = X.mean(), X.std(ddof=0)
    Xs = (X - mu) / sd
    Xs.insert(0, "const", 1.0)
    A, y = Xs.values, df["ba"].values.astype(float)

    def obj(b):
        z = A @ b
        return -(np.sum(y * z - np.logaddexp(0, z)) - 0.5 * np.sum(b[1:] ** 2))

    def jac(b):
        p = 1 / (1 + np.exp(-(A @ b)))
        g = -(A.T @ (y - p))
        g[1:] = g[1:] + b[1:]
        return g

    b0 = np.zeros(A.shape[1])
    b0[0] = np.log(y.mean() / (1 - y.mean()))
    res = minimize(obj, b0, jac=jac, method="L-BFGS-B",
                   options=dict(maxiter=8000, ftol=1e-15, gtol=1e-12))
    coef = {c: v for c, v in zip(Xs.columns, res.x) if c != "const"}
    rescaled = {k: (v / sd[k] if k in ("raceB", "raceH") else v) for k, v in coef.items()}
    return coef, rescaled, res


for lab, covs in LADDER.items():
    cols = ["raceB", "raceH"] + covs
    coef, rescaled, res = sklearn_l2(cols)
    print(f"\n--- L2-std variant: {lab} (converged={res.success}) ---")
    print("  standardized-X coefs:", {k: round(v, 6) for k, v in coef.items()})
    print("  race coefs rescaled to 0/1 dummy:", {k: round(rescaled[k], 6) for k in ("raceB", "raceH")})
    for k, g in [("raceB", "Black"), ("raceH", "Hispanic")]:
        rows.append(dict(model=lab, note="L2-std DIAGNOSTIC (standardized-X scale)", link="logit-L2-std",
                         reference="White", group=g, coef=coef[k], se=np.nan, ci_lo=np.nan, ci_hi=np.nan,
                         pval=np.nan, llf=np.nan, conv=bool(res.success), nobs=len(df),
                         scale="log-odds per SD of dummy"))
        rows.append(dict(model=lab, note="L2-std DIAGNOSTIC rescaled to 0/1 dummy scale",
                         link="logit-L2-std-rescaled", reference="White", group=g, coef=rescaled[k],
                         se=np.nan, ci_lo=np.nan, ci_hi=np.nan, pval=np.nan, llf=np.nan,
                         conv=bool(res.success), nobs=len(df), scale="log-odds (0/1 dummy)"))

grid = pd.DataFrame(rows)
grid["abs_diff_from_target"] = (grid.coef - TARGET).abs()
grid["exact_match_le_0.0005"] = grid.abs_diff_from_target <= 0.0005
grid["within_0.02"] = grid.abs_diff_from_target <= 0.02
grid.to_csv("analysis/grid_coefficients.csv", index=False)

print("\n" + "#" * 100)
print(f"AUDIT: FULL coefficient table for EVERY logit spec run (all terms, all refs)")
print("#" * 100)
audit = []
for ref in ["White", "Black", "Hispanic"]:
    for lab, covs in LADDER.items():
        rhs = R % ref + ("" if not covs else " + " + " + ".join(covs))
        m = smf.logit("ba ~ " + rhs, data=df).fit(disp=0)
        t = m.summary2().tables[1].reset_index().rename(columns={"index": "term"})
        t.insert(0, "reference", ref); t.insert(0, "model", lab)
        t["llf"] = m.llf
        audit.append(t)
audit = pd.concat(audit, ignore_index=True)
audit = audit.rename(columns={"Coef.": "coef", "Std.Err.": "se", "z": "z", "P>|z|": "p",
                              "[0.025": "ci_lo", "0.975]": "ci_hi"})
audit.to_csv("analysis/full_coefficient_tables_all_specs.csv", index=False)
for (ref, lab), g in audit.groupby(["reference", "model"], sort=False):
    print(f"\n>>> reference={ref} | {lab} | llf={g.llf.iloc[0]:.4f}")
    print(g[["term", "coef", "se", "z", "p", "ci_lo", "ci_hi"]].to_string(
        index=False, float_format=lambda v: f"{v:.4f}"))

print("\n" + "#" * 100)
print(f"FULL GRID OF RACE COEFFICIENTS ({len(grid)} rows); TARGET = {TARGET}")
print("#" * 100)
print(grid[grid.link.isin(["logit", "OLS/LPM"])][
    ["link", "reference", "model", "group", "coef", "se", "ci_lo", "ci_hi",
     "abs_diff_from_target", "note"]].sort_values(["link", "reference", "model", "group"]
    ).to_string(index=False, float_format=lambda v: f"{v:.6f}"))

print("\n" + "#" * 100)
print("A) EXACT MATCHES |coef - (-0.9568)| <= 0.0005")
print("#" * 100)
em = grid[grid["exact_match_le_0.0005"]]
print("NONE" if em.empty else em[["link", "reference", "model", "group", "coef", "se",
                                 "abs_diff_from_target", "note"]].to_string(index=False))

print("\n" + "#" * 100)
print("B) EVERY COEFFICIENT WITHIN 0.02 OF TARGET (printed at 6 dp)")
print("#" * 100)
w = grid[grid["within_0.02"]].sort_values("abs_diff_from_target")
print("NONE" if w.empty else w[["link", "reference", "model", "group", "coef", "se", "ci_lo",
                               "ci_hi", "abs_diff_from_target", "note"]].to_string(
    index=False, float_format=lambda v: f"{v:.6f}"))

print("\n" + "#" * 100)
print("C) NEAREST CANDIDATES OVERALL (top 15)")
print("#" * 100)
print(grid.sort_values("abs_diff_from_target").head(15)[
    ["link", "reference", "model", "group", "coef", "se", "ci_lo", "ci_hi",
     "abs_diff_from_target", "note"]].to_string(index=False, float_format=lambda v: f"{v:.6f}"))

print("\n" + "#" * 100)
print("D) ATTENUATION PATH (logit MLE, White reference): race coefficients by rung")
print("#" * 100)
pw = grid[(grid.link == "logit") & (grid.reference == "White")].pivot_table(
    index="model", columns="group", values=["coef", "se", "ci_lo", "ci_hi"])
print(pw.to_string(float_format=lambda v: f"{v:.6f}"))

print("\n" + "#" * 100)
print("E) BLACK-vs-HISPANIC CONTRAST: magnitude exclusion check (logit, any reference)")
print("#" * 100)
sub = grid[(grid.link == "logit") & (grid.reference.isin(["Black", "Hispanic"]))]
print(sub[["reference", "model", "group", "coef", "se", "ci_lo", "ci_hi",
           "abs_diff_from_target"]].to_string(index=False, float_format=lambda v: f"{v:.6f}"))
print("\nmax |coef| over all Black/Hispanic-referenced fits:")
print(f"  max coef = {sub.coef.max():.6f} ; min coef = {sub.coef.min():.6f} ; "
      f"closest to target = {sub.abs_diff_from_target.min():.6f}")

print("\n" + "#" * 100)
print("F) NEAREST CANDIDATE + SE-COVERAGE DIAGNOSTIC (is the gap statistically meaningful?)")
print("#" * 100)
for lab, covs in LADDER.items():
    rhs = R % "White" + ("" if not covs else " + " + " + ".join(covs))
    for g in ["Black", "Hispanic"]:
        m = smf.logit("ba ~ " + rhs, data=df).fit(disp=0)
        p = [q for q in m.params.index if q.endswith("[T.%s]" % g)][0]
        b, s = m.params[p], m.bse[p]
        z = (b - TARGET) / s
        from scipy.stats import norm
        print(f"{lab:45s} {g:9s} coef={b: .6f} se={s:.6f} "
              f"CI=[{m.conf_int().loc[p,0]: .4f},{m.conf_int().loc[p,1]: .4f}] "
              f"| coef-target |={abs(b-TARGET):.6f} z_vs_target={z: .3f} p={2*(1-norm.cdf(abs(z))):.3f} "
              f"target_in_CI={bool(m.conf_int().loc[p,0] <= TARGET <= m.conf_int().loc[p,1])}")
