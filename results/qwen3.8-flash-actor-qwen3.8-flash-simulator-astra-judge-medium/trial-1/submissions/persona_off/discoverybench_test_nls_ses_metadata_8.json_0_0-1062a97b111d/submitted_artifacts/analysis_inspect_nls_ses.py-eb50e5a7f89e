"""
Turn-1 INPUT INSPECTION ONLY (no modeling, no final answer).

Target: data/nls_ses_processed.csv
Reports:
  1) columns, dtypes, shape, preview
  2) realized categories + counts for SAMPLE_RACE, SAMPLE_SEX, BA DEGREE COMPLETED
  3) crosstab BA DEGREE COMPLETED x SAMPLE_RACE (counts + completion rates)
  4) missingness for race-model-relevant columns
"""
import numpy as np
import pandas as pd

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)

CSV = "data/nls_ses_processed.csv"

# index_col=0 keeps the unnamed pandas index column out of the data frame
df = pd.read_csv(CSV, index_col=0)

print("=" * 78)
print("1) SHAPE / COLUMNS / DTYPES")
print("=" * 78)
print("shape:", df.shape)
print("\ndtypes:\n", df.dtypes)
print("\nfirst 5 rows:\n", df.head())
print("\nlast 3 rows:\n", df.tail(3))

RACE = "SAMPLE_RACE"
SEX = "SAMPLE_SEX"
BA = "BA DEGREE COMPLETED"
COVS = ["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS",
        "FAMILY SIZE OF SAMPLE", SEX]

print("\n" + "=" * 78)
print("2) REALIZED CATEGORIES / VALUE COUNTS (raw, as parsed)")
print("=" * 78)
for c in [RACE, SEX, BA]:
    print(f"\n--- {c} (dtype={df[c].dtype}) ---")
    vc = df[c].value_counts(dropna=False)
    print(vc.to_string())
    print("n_unique =", df[c].nunique(dropna=True),
          "| n_null =", int(df[c].isna().sum()))

# string hygiene check on race / sex
for c in [RACE, SEX]:
    raw = df[c].dropna().astype(str)
    print(f"\n{c}: any leading/trailing whitespace? "
          f"{bool((raw != raw.str.strip()).any())}; "
          f"sorted uniques = {sorted(raw.unique())}")

print("\n" + "=" * 78)
print("3) CROSSTAB: BA DEGREE COMPLETED x SAMPLE_RACE")
print("=" * 78)
ct = pd.crosstab(df[RACE], df[BA], dropna=False)
print("\ncounts:\n", ct.to_string())
ct_rate = ct.div(ct.sum(axis=1), axis=0)
print("\ncompletion rate (row-wise, treating truthy BA as completed):\n",
      ct_rate.to_string(float_format=lambda v: f"{v:.4f}"))
tot_rate = df[BA].fillna(False).astype(bool).mean()
print(f"\noverall completion rate = {tot_rate:.4f}  (n={len(df)})")
print("\nn-by-race and rates as a flat table:")
flat = pd.DataFrame({
    "n": ct.sum(axis=1),
    "n_completed": ct.sum(axis=1) * ct_rate.values[:, 0] if ct.shape[1] == 2 else ct.get(True, 0),
})
try:
    flat["n_completed"] = ct[True] if True in ct.columns else ct.get(1, 0)
except Exception:
    pass
flat["completion_rate"] = flat["n_completed"] / flat["n"]
print(flat.to_string(float_format=lambda v: f"{v:.4f}"))

print("\n" + "=" * 78)
print("4) MISSINGNESS (columns relevant to a race model)")
print("=" * 78)
cols = [RACE, BA] + COVS
miss = pd.DataFrame({
    "n_missing": [int(df[c].isna().sum()) for c in cols],
    "pct_missing": [100.0 * df[c].isna().mean() for c in cols],
    "dtype": [str(df[c].dtype) for c in cols],
    "n_nonmissing": [int(df[c].notna().sum()) for c in cols],
}, index=cols)
print(miss.to_string(float_format=lambda v: f"{v:.3f}"))

complete_mask = df[[RACE, BA] + COVS].notna().all(axis=1)
print(f"\nrows complete on race + BA + all 5 covariates: {int(complete_mask.sum())} "
      f"of {len(df)} ({100*complete_mask.mean():.2f}%)")
print("\nrace distribution among complete rows:")
print(df.loc[complete_mask, RACE].value_counts().to_string())
print("\ncompletion rate among complete rows, by race:")
print(df.loc[complete_mask].groupby(RACE)[BA]
        .agg(n="size", n_completed="sum",
             rate=lambda s: s.sum() / len(s)).to_string(float_format=lambda v: f"{v:.4f}")
      if False else
      df.loc[complete_mask].groupby(RACE)[BA]
        .agg(n="size", n_completed="sum").assign(
            rate=lambda d: d.n_completed / d.n).to_string(float_format=lambda v: f"{v:.4f}"))

print("\n" + "=" * 78)
print("5) NUMERIC COVARIATE SUMMARIES (for sanity of later adjustment)")
print("=" * 78)
print(df[["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS",
          "FAMILY SIZE OF SAMPLE"]].describe().to_string(float_format=lambda v: f"{v:.3f}"))

print("\n" + "=" * 78)
print("6) BA FLAG CODING CHECK (raw stored values / truthiness)")
print("=" * 78)
print("raw unique repr:", [repr(v) for v in df[BA].unique()])
print("as int8:", pd.Series(df[BA]).astype("int8").value_counts().to_string())
