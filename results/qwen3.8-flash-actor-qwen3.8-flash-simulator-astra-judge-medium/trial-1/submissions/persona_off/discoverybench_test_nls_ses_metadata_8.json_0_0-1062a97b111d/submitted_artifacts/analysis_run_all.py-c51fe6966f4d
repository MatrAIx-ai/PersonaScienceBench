"""
Reproducible entry point for the -0.9568 investigation.
Run from /workspace:  python analysis/run_all.py
Executes, in order:
  1 inspect_nls_ses.py              input inspection (columns, dtypes, categories, crosstab, missingness)
  2 grid_race_logit.py              pre-declared ladder (a)-(e), 3 reference codings, link/LPM robustness,
                                    sklearn-C=1 standardised diagnostic, exact/near match tables
  3 exhaustive_covariate_subsets.py complete 2^5 covariate-subset enumeration (no cherry-picking)
  4 attainability_and_rare_event.py attainable ranges, Firth, Bayesian MAP, penalty sweep, bootstrap
  5 firth_corrected_and_L2scan.py   corrected Firth + L2 scan over all subsets + bisection for lambda*
  6 confirm_and_adjudicate.py       3-optimiser confirmation, scale invariance, monotonicity, final table
"""
import subprocess, sys, pathlib
HERE = pathlib.Path(__file__).parent
SCRIPTS = ["inspect_nls_ses.py", "grid_race_logit.py", "exhaustive_covariate_subsets.py",
           "attainability_and_rare_event.py", "firth_corrected_and_L2scan.py",
           "confirm_and_adjudicate.py"]
for s in SCRIPTS:
    print("\n" + "#" * 100 + f"\n# RUNNING {s}\n" + "#" * 100, flush=True)
    r = subprocess.run([sys.executable, str(HERE / s)], capture_output=True, text=True)
    sys.stdout.write(r.stdout[-4000:])
    if r.returncode != 0:
        sys.stdout.write("\nSTDERR:\n" + r.stderr[-3000:])
        print(f"!! {s} exited {r.returncode}")
print("\nDONE")
