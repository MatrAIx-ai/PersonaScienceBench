"""
Requirements Engineering for ML-enabled systems (survey, 276 rows).
Target: per-role proportion of respondents associating each role with requirements /
ML aspects in their organization  (Q8_ML_Addressing_* multi-select block).

Established data fact (re-verified below): Q8_* (and D10, D12-D15, Q9-Q17) are Qualtrics
MULTI-SELECT columns coded 'quoted' (selected) / 'not quoted' (not selected) / '-77'
(block not shown). No Likert positivity threshold is involved.

Sentinel handling: -77 not exposed -> missing (out of denominator); -99 free-text absent;
-66 non-response; '0' unanswered categorical; '' empty; -1 Duration placeholder.
"""
import json
from math import erf, sqrt
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
SEED = 20261024
B = 10_000
Z = 1.959963985

ROLES = {
    "Q8_ML_Addressing_Project_Lead": "Project Lead / Project Manager",
    "Q8_ML_Addressing_Data_Scientist": "Data Scientist",
    "Q8_ML_Addressing_Business_Analyst": "Business Analyst",
    "Q8_ML_Addressing_Developer": "Developer",
    "Q8_ML_Addressing_Solution_Architect": "Solution Architect",
    "Q8_ML_Addressing_Requirement_Engineer": "Requirements Engineer",
    "Q8_ML_Addressing_Others": "Other (free text)",
    "Q8_ML_Addressing_Tester": "Test Manager / Tester",
}
Q8 = list(ROLES)
NAMED = [c for c in Q8 if c != "Q8_ML_Addressing_Others"]

raw = pd.read_csv(CSV, dtype=str, keep_default_na=False)
log = [{"item": "file rows", "value": len(raw)},
       {"item": "columns", "value": raw.shape[1]},
       {"item": "unique respondent IDs", "value": raw["ID"].nunique()},
       {"item": "duplicate IDs", "value": int(raw["ID"].duplicated().sum())}]
for s, v in raw["Status"].value_counts().items():
    log.append({"item": "Status = " + s, "value": int(v)})
for code, lab in [("-99", "free-text not given"), ("-77", "block not shown / not exposed"),
                  ("-66", "non-response"), ("", "empty string")]:
    log.append({"item": "sentinel '%s' (%s) cells" % (code, lab), "value": int((raw == code).sum().sum())})
    log.append({"item": "sentinel '%s' (%s) columns" % (code, lab), "value": int(((raw == code).sum() > 0).sum())})
log.append({"item": "sentinel '0' (string) cells, all columns", "value": int((raw == "0").sum().sum())})
log.append({"item": "Duration == -1 cells", "value": int((raw["Duration"] == "-1").sum())})
for c in Q8:
    log.append({"item": c + " value domain", "value": "|".join(sorted(raw[c].unique()))})

df = raw.replace({"-77": np.nan, "-99": np.nan, "-66": np.nan, "": np.nan})

# '0' is the unanswered-code in CATEGORICAL columns only (it is a legitimate value for
# years / project counts such as D5, D7, D8), so clean it column-selectively.
CAT_ZERO = (["D2_Country", "D3_Company_Size", "D4_Role", "D9_ML_Project_Team_Size",
             "D11_Agile_Development", "Q17_Automated_Machine_Learning_Tools_Yes_No"]
            + [c for c in raw.columns if c.startswith(("Q1_ML_Life_Cycle_Importance",
                                                       "Q2_ML_Life_Cycle_Difficulty"))])
df[CAT_ZERO] = df[CAT_ZERO].replace({"0": np.nan})
log.append({"item": "categorical columns where '0' recoded to missing", "value": len(CAT_ZERO)})
log.append({"item": "'0' cells recoded to missing in those columns",
            "value": int((raw[CAT_ZERO] == "0").sum().sum())})
valid_q8 = df[Q8].notna().all(axis=1)
log.append({"item": "rows with valid Q8 but sentinel D4_Role", "value": int((valid_q8 & df["D4_Role"].isna()).sum())})
log.append({"item": "rows with valid (non -77) Q8 block [PRIMARY n]", "value": int(valid_q8.sum())})
log.append({"item": "rows with -77 in Q8 (excluded as non-exposed)", "value": int((raw[Q8[0]] == "-77").sum())})
log.append({"item": "excluded rows that are Status=Suspended",
            "value": int(((raw[Q8[0]] == "-77") & (raw["Status"] == "Suspended (22)")).sum())})
log.append({"item": "kept Suspended rows with valid Q8",
            "value": int(((raw["Status"] == "Suspended (22)") & valid_q8).sum())})

def wilson(k, n, z=Z):
    if n == 0:
        return (float("nan"), float("nan"))
    p = k / n
    d = 1 + z ** 2 / n
    c = (p + z ** 2 / (2 * n)) / d
    h = z * np.sqrt(p * (1 - p) / n + z ** 2 / (4 * n ** 2)) / d
    return (100 * (c - h), 100 * (c + h))

def _ppf(p):
    """Acklam inverse standard normal CDF (scipy not required)."""
    a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02,
         1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00]
    b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02,
         6.680131188771972e+01, -1.328068155288572e+01]
    c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00,
         -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00]
    d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00, 3.754408661907416e+00]
    if p < 0.02425:
        q = np.sqrt(-2 * np.log(p))
        return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    if p > 1 - 0.02425:
        q = np.sqrt(-2 * np.log(1 - p))
        return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    q = p - 0.5
    r = q * q
    return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q / (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)

def _cdf(x):
    return 0.5 * (1 + erf(x / sqrt(2)))

def bca_boot(binary, B=B, seed=SEED):
    """Respondent-level nonparametric bootstrap of one binary indicator.
    Returns (bootstrap distribution in %, percentile 95% CI, BCa 95% CI)."""
    rng = np.random.default_rng(seed)
    n = binary.size
    k = int(binary.sum())
    idx = rng.integers(0, n, size=(B, n))
    boot = binary[idx].mean(axis=1) * 100
    ci_pct = (float(np.percentile(boot, 2.5)), float(np.percentile(boot, 97.5)))
    p_hat = 100 * k / n
    if 0 < k < n:
        z0 = float(_ppf((np.sum(boot < p_hat) + 0.5) / (B + 1)))
        jk = np.array([(k - binary[i]) / (n - 1) * 100 for i in range(n)])
        jm = jk.mean()
        num = np.sum((jm - jk) ** 3)
        den = 6.0 * (np.sum((jm - jk) ** 2) ** 1.5)
        acc = float(num / den) if den != 0 else 0.0
        ends = []
        for q in (0.025, 0.975):
            zz = _ppf(q)
            arg = z0 + (z0 + zz) / (1 - acc * (z0 + zz))
            ends.append(float(np.percentile(boot, 100 * _cdf(arg))))
        ci_bca = (ends[0], ends[1])
    else:
        ci_bca = (p_hat, p_hat)
    return boot, ci_pct, ci_bca

# ------------------------------------------------------------------ primary
prim = df[valid_q8].reset_index(drop=True)
M = np.column_stack([(prim[c].values == "quoted").astype(np.int64) for c in Q8])
boot_dists, rows = {}, []
for col, role in ROLES.items():
    j = Q8.index(col)
    b = M[:, j]
    k, n = int(b.sum()), int(b.size)
    boot, (lo_p, hi_p), (lo_b, hi_b) = bca_boot(b)
    boot_dists[col] = boot
    wlo, whi = wilson(k, n)
    rows.append({"role": role, "column": col, "n_respondents": n, "n_indicating": k,
                 "proportion_pct": round(100 * k / n, 3),
                 "boot_mean_pct": round(float(boot.mean()), 3),
                 "boot_se_pp": round(float(boot.std(ddof=1)), 3),
                 "ci95_percentile": "[%.3f, %.3f]" % (lo_p, hi_p),
                 "ci95_bca": "[%.3f, %.3f]" % (lo_b, hi_b),
                 "ci95_wilson": "[%.3f, %.3f]" % (wlo, whi)})
tab = pd.DataFrame(rows).sort_values("proportion_pct", ascending=False).reset_index(drop=True)

# bootstrap rank probabilities over the 7 named roles (free-text 'Others' excluded from ranking)
BD = np.column_stack([boot_dists[c] for c in NAMED])
order = (-BD).argsort(axis=1).argsort(axis=1)          # 0 == rank 1
r1, r2, top2, r1_gap = [], [], [], []
for col in Q8:
    if col == "Q8_ML_Addressing_Others":
        r1.append("n/a (free-text role, not in named-role ranking)")
        r2.append("n/a"); top2.append("n/a"); r1_gap.append("n/a")
        continue
    j = NAMED.index(col)
    r1.append(round(float((order[:, j] == 0).mean()), 4))
    r2.append(round(float((order[:, j] == 1).mean()), 4))
    top2.append(round(float((order[:, j] <= 1).mean()), 4))
    others = np.delete(BD, j, axis=1).max(axis=1)
    r1_gap.append(round(float((BD[:, j] > others).mean()), 4))
tab["p_rank1"] = r1
tab["p_rank2"] = r2
tab["p_top2"] = top2
tab["p_ahead_of_all_others"] = r1_gap
tab["rank"] = range(1, len(tab) + 1)
tab = tab[["rank", "role", "column", "n_respondents", "n_indicating", "proportion_pct",
           "boot_mean_pct", "boot_se_pp", "ci95_percentile", "ci95_bca", "ci95_wilson",
           "p_rank1", "p_rank2", "p_top2", "p_ahead_of_all_others"]]

# paired bootstrap: Data Scientist minus Project Lead, and top-2 vs 3rd gap
pl = boot_dists["Q8_ML_Addressing_Project_Lead"]
ds = boot_dists["Q8_ML_Addressing_Data_Scientist"]
ba = boot_dists["Q8_ML_Addressing_Business_Analyst"]
paired = pd.DataFrame([
    {"contrast": "Project Lead - Data Scientist", "point_pp": round(float(pl.mean() - ds.mean()), 3),
     "ci95_percentile_pp": "[%.3f, %.3f]" % tuple(np.percentile(pl - ds, [2.5, 97.5]))},
    {"contrast": "top-2 minimum (Data Scientist) - 3rd (Business Analyst)",
     "point_pp": round(float(ds.mean() - ba.mean()), 3),
     "ci95_percentile_pp": "[%.3f, %.3f]" % tuple(np.percentile(ds - ba, [2.5, 97.5]))},
])

# ------------------------------------------------------------------ sensitivity
def prop_table(frame, label):
    n = len(frame)
    out = {"analysis_set": label, "n": n}
    for col, role in ROLES.items():
        k = int((frame[col] == "quoted").sum())
        out[role] = "%.3f" % (100 * k / n) if n else "nan"
        out[role + "_k"] = k
    return out

any_role = (df[NAMED] == "quoted").any(axis=1)
sens = [prop_table(df[valid_q8], "PRIMARY: valid Q8 block (non -77)"),
        prop_table(df[valid_q8 & df["Status"].isin(["Completed (31)", "Completed after break (32)"])],
                   "Sens: Completed + Completed after break"),
        prop_table(df[valid_q8 & any_role], "Sens: respondents naming >=1 role"),
        prop_table(df[valid_q8 & df["D4_Role"].notna()], "Sens: non-sentinel D4_Role"),
        prop_table(df[valid_q8 & df["D4_Role"].notna() & (df["D4_Role"] != "Other, which one?")],
                   "Sens: named D4_Role categories only")]
filled = raw.assign(**{c: raw[c].replace({"-77": "not quoted"}) for c in Q8})
sens.append(prop_table(filled, "INAPPROPRIATE: -77 counted as 'no' (all 276 rows)"))
sens_df = pd.DataFrame(sens)

# ------------------------------------------------------------------ corroboration
d4_df = (raw["D4_Role"].replace({"0": np.nan}).value_counts(dropna=False)
         .rename_axis("D4_Role").rename("respondents").reset_index())
d4_df["pct_of_276"] = (100 * d4_df["respondents"] / len(raw)).round(2)
d4_df["note"] = np.where(d4_df["D4_Role"].isna(), "unanswered ('0' sentinel)", "")

q9 = [c for c in df.columns if c.startswith("Q9_ML_Elicitation_") and not c.endswith("_Free")]
q10 = [c for c in df.columns if c.startswith("Q10_ML_Documentation_") and not c.endswith("_Free")]
corr_rows = []
for block, cols in [("Q9 requirements-elicitation techniques", q9),
                    ("Q10 requirements-documentation artifacts", q10)]:
    for c in cols:
        s = df[c]
        v = int(s.notna().sum())
        k = int((s == "quoted").sum())
        corr_rows.append({"block": block, "item": c, "n_valid": v, "n_used": k,
                          "pct_used": round(100 * k / v, 3)})
corr_df = pd.DataFrame(corr_rows).sort_values(["block", "pct_used"], ascending=[True, False])

# ------------------------------------------------------------------ diagnostics
diag = []
for pt, lo, hi in [(49.6, 49.219, 49.981), (61.389, 60.955, 61.822)]:
    hw = (hi - lo) / 2
    se = hw / Z / 100
    diag.append({"quantity": "published CI around %.3f%%" % pt, "half_width_pp": round(hw, 3),
                 "implied_effective_n": int(round((pt / 100) * (1 - pt / 100) / se ** 2))})
for lab, p in [("Project Lead 99/194", 99 / 194), ("Data Scientist 95/194", 95 / 194)]:
    diag.append({"quantity": lab + ": our respondent-level half-width (n=194)",
                 "half_width_pp": round(1.96 * np.sqrt(p * (1 - p) / 194) * 100, 3),
                 "implied_effective_n": 194})
    diag.append({"quantity": lab + ": cell-level half-width (194x7=1358)",
                 "half_width_pp": round(1.96 * np.sqrt(p * (1 - p) / 1358) * 100, 3),
                 "implied_effective_n": 1358})
diag_df = pd.DataFrame(diag)

multisel = [c for c in raw.columns if set(raw[c].unique()) <= {"quoted", "not quoted", "-77"}]
near = []
for fname, f in {"valid Q8 (n=194)": valid_q8,
                 "completed+break (n=188)": valid_q8 & df["Status"].isin(["Completed (31)", "Completed after break (32)"]),
                 "all rows (n=276)": pd.Series(True, index=df.index)}.items():
    d = raw[f]
    for c in multisel:
        s = d[c]
        v = int((s != "-77").sum())
        if v < 20:
            continue
        p = 100 * int((s == "quoted").sum()) / v
        if 60.0 < p < 62.5:
            near.append({"analysis_set": fname, "column": c, "n_valid": v,
                         "n_quoted": int((s == "quoted").sum()), "pct": round(p, 3),
                         "is_Q8_role_item": c.startswith("Q8_")})
near_df = pd.DataFrame(near).sort_values("pct", ascending=False)

# ------------------------------------------------------------------ outputs
tab.to_csv("output/per_role_table.csv", index=False)
paired.to_csv("output/paired_bootstrap_contrasts.csv", index=False)
sens_df.to_csv("output/sensitivity_table.csv", index=False)
pd.DataFrame(log).to_csv("output/sentinel_log.csv", index=False)
d4_df.to_csv("output/corroboration_D4_role.csv", index=False)
corr_df.to_csv("output/corroboration_Q9_Q10.csv", index=False)
diag_df.to_csv("output/ci_reproducibility_diagnostics.csv", index=False)
near_df.to_csv("output/target_61pct_search.csv", index=False)
np.savez("output/bootstrap_distributions.npz", **boot_dists)
json.dump({"seed": SEED, "B": B, "n_primary": int(valid_q8.sum()),
           "resampling_unit": "respondent (row), with replacement",
           "cis": "percentile + BCa (jackknife acceleration) + Wilson analytic",
           "roles": sorted(set(ROLES.values()))},
          open("output/run_metadata.json", "w"), indent=2)

pd.set_option("display.width", 260, "display.max_columns", 60)
print("=== PRIMARY: per-role proportion, n=%d respondents with valid Q8 block ===" % int(valid_q8.sum()))
print(tab.to_string(index=False))
print("\n=== paired bootstrap contrasts (pp) ===")
print(paired.to_string(index=False))
print("\n=== SENSITIVITY grid (proportion %; *_k = count) ===")
print(sens_df.to_string(index=False))
print("\n=== CI reproducibility diagnostics ===")
print(diag_df.to_string(index=False))
print("\n=== search for ~61.4% across every multi-select item ===")
print(near_df.to_string(index=False))
print("\n=== corroboration (context only): D4_Role distribution ===")
print(d4_df.to_string(index=False))
print("\n=== corroboration (context only): Q9 / Q10 requirements-facing practices ===")
print(corr_df.to_string(index=False))
print("\nsentinel log rows: %d ; written outputs: 8 csv + 1 npz + 1 json" % len(log))
