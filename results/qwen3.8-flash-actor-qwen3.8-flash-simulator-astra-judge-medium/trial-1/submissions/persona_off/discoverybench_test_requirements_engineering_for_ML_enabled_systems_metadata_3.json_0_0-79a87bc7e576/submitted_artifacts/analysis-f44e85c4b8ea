#!/usr/bin/env python3
"""Runner: builds the long result table, sensitivity grid, McNemar tests, discrepancy note."""
import numpy as np, pandas as pd
from scipy.stats import binomtest
from q9_elicitation_analysis import (df, used, sentn, legit, P, labels, cols, TECH, NAMED,
                                     frames, indicator, SEED, B, Z, ROOT,
                                     boot_proportions, bca_proportion)

# ---------------- long result table (all frames) ----------------
rows = []
for fname, mask in frames.items():
    M = used[mask].astype(np.uint8).copy()
    if fname.endswith("_276"):                       # -77 -> 0 explicitly (documented variant)
        M[~(df[cols].eq("not quoted").to_numpy() | df[cols].eq("quoted").to_numpy())[mask]] = 0
    n = M.shape[0]
    rng = np.random.default_rng(SEED)
    boots = boot_proportions(M, rng, B)
    theta = M.mean(axis=0)
    ci_bca = bca_proportion(M, boots, theta)
    cnt = M.sum(axis=0)
    order = np.lexsort((np.array(labels), -cnt))
    rank = {labels[j]: r + 1 for r, j in enumerate(order)}
    for j, lab in enumerate(labels):
        lo, hi = np.quantile(boots[:, j], [0.025, 0.975])
        rows.append(dict(frame=fname, technique_label=lab, source_column=TECH[lab],
            indicator_definition=indicator[fname], denominator_definition=fname,
            n_denominator=n, n_used=int(cnt[j]), share_pct=round(100*theta[j], 3),
            boot_ci_lo_pct=round(100*lo, 3), boot_ci_hi_pct=round(100*hi, 3),
            bca_ci_lo_pct=round(100*ci_bca[j, 0], 3), bca_ci_hi_pct=round(100*ci_bca[j, 1], 3),
            boot_se_pct=round(100*boots[:, j].std(ddof=1), 3), boot_width_pp=round(100*(hi-lo), 3),
            rank=rank[lab], is_max=(rank[lab] == 1), B=B, seed=SEED))
res = pd.DataFrame(rows)

# ranking over the 5 named techniques only (Others dropped)
nm = res[res.technique_label.isin(NAMED)].copy()
nm["rank_named5"] = nm.groupby("frame").share_pct.rank(ascending=False, method="min").astype(int)
nm["is_max_named5"] = nm.rank_named5 == 1
res = res.merge(nm[["frame", "technique_label", "rank_named5", "is_max_named5"]],
                on=["frame", "technique_label"], how="left")
res["rank_named5"] = res["rank_named5"].map(lambda x: "n/a (Others)" if pd.isna(x) else str(int(x)))
res["is_max_named5"] = res["is_max_named5"].fillna(False)

# ---------------- McNemar exact tests on the primary base ----------------
mc = []
a = P[:, labels.index("Interviews")]
for opp in [t for t in labels if t != "Interviews"]:
    b = P[:, labels.index(opp)]
    b_only, c_only = int((a & ~b).sum()), int((~a & b).sum())
    disc = b_only + c_only
    p = binomtest(b_only, disc, 0.5, alternative="two-sided").pvalue if disc else float("nan")
    mc.append(dict(test="McNemar_exact_two_sided", base_n=194, technique_a="Interviews",
                   technique_b=opp, interviews_only=b_only, other_only=c_only,
                   n_discordant=disc, p_value=p, p_scientific=f"{p:.3e}"))
mc = pd.DataFrame(mc)
# Holm step-down adjustment across the m paired comparisons
p = mc.p_value.to_numpy(dtype=float); m = len(p)
srt = np.argsort(p, kind="stable")
adj_sorted = np.minimum(1.0, np.maximum.accumulate(p[srt] * (m - np.arange(m))))
holm = np.empty(m); holm[srt] = adj_sorted
mc["holm_adjusted_p"] = holm
mc["holm_significant_0p05"] = mc.holm_adjusted_p < 0.05
mcp = dict(zip(mc.technique_b, mc.p_value))
holm_map = dict(zip(mc.technique_b, mc.holm_adjusted_p))
res["mcnemar_p_interviews_vs_this_technique"] = res.technique_label.map(mcp).where(
    res.frame == "primary_valid_Q9_194")
res["mcnemar_p_holm_adjusted"] = res.technique_label.map(holm_map).where(
    res.frame == "primary_valid_Q9_194")

# ---------------- discrepancy note (never used to select anything) ----------------
tgt, lo_b, hi_b = 0.69399, 0.69062, 0.69735
half = (hi_b - lo_b) / 2
implied_N = tgt * (1 - tgt) / ((half / Z) ** 2)
obs = {276: int(used[:, 0].sum()), 194: int(P[:, 0].sum()), 188: int(used[legit][:, 0].sum()),
       174: int(used[used.any(1)][:, 0].sum())}
d1 = pd.DataFrame([dict(denominator_N=N,
        k_needed_for_69_399pct=int(round(tgt*N)),
        realised_pct_of_that_k=round(100*round(tgt*N)/N, 4),
        exact_match=bool(abs(100*round(tgt*N)/N - 100*tgt) < 5e-4),
        observed_interviews_quoted=obs.get(N, None),
        observed_pct=round(100*obs[N]/N, 3) if N in obs else None)
        for N in (276, 194, 190, 188, 183, 174, 164, 140)])
d2 = pd.DataFrame([
  dict(diagnostic="benchmark point estimate (%)", value=100*tgt),
  dict(diagnostic="benchmark CI half-width (pp)", value=round(100*half, 4)),
  dict(diagnostic="implied effective N for Bernoulli proportion (Wald inversion)", value=round(implied_N, 1)),
  dict(diagnostic="largest possible n in this file", value=len(df)),
  dict(diagnostic="implied_N / 194 (primary base)", value=round(implied_N/194, 1)),
  dict(diagnostic="bootstrap CI width (pp) we actually obtain, Interviews n=194", value=None),
  dict(diagnostic="Wald half-width (pp) at n=194 for p=0.69399", value=round(100*Z*np.sqrt(tgt*(1-tgt)/194), 3)),
  dict(diagnostic="nearest interpretable coincidence: 97/140 (%)", value=round(100*97/140, 4)),
  dict(diagnostic="MC SE (pp) of a B=1000 bootstrap mean at n=140, p=97/140",
       value=round(100*np.sqrt((97/140)*(1-97/140)/140/1000), 4))])
# principled-subset search: single-column filters with n>=50 on the 194 base
hits = []
for c in df.columns:
    u = df[c].unique()
    if len(u) > 15:
        continue
    for v in u:
        m = (~sentn) & (df[c] == v).to_numpy()
        n = int(m.sum())
        if n < 50:
            continue
        s = 100*used[m][:, 0].mean()
        if abs(s - 100*tgt) < 0.5:
            hits.append(dict(filter=f"{c}=={v}", n=n, interviews_pct=round(s, 3),
                             abs_gap_pp=round(abs(s-100*tgt), 4), judgement="post-hoc, n too small, excluded"))
hits = pd.DataFrame(hits).sort_values("abs_gap_pp") if hits else pd.DataFrame(
    columns=["filter", "n", "interviews_pct", "abs_gap_pp", "judgement"])
d2.loc[d2.diagnostic.str.startswith("bootstrap CI width"), "value"] = float(
    res[(res.frame == "primary_valid_Q9_194") & (res.technique_label == "Interviews")].boot_width_pp.iloc[0])

# ---------------- write + report ----------------
out = str(ROOT / "analysis") + "/"
res.to_csv(out+"q9_results_long.csv", index=False)
res[res.frame == "primary_valid_Q9_194"].drop(columns=["frame", "denominator_definition"]).to_csv(
    out+"q9_primary_results.csv", index=False)
mc.to_csv(out+"q9_mcnemar.csv", index=False)
d1.to_csv(out+"q9_discrepancy_required_counts.csv", index=False)
d2.to_csv(out+"q9_discrepancy_ci_diagnostics.csv", index=False)
hits.to_csv(out+"q9_discrepancy_subset_search.csv", index=False)

pd.set_option("display.width", 260)
print("rows=%d legit=%d Q9_sentinel(-77)=%d primary_base=%d" %
      (len(df), legit.sum(), sentn.sum(), (~sentn).sum()))
print("\n=== PRIMARY (n=194) ===")
print(res[res.frame == "primary_valid_Q9_194"][["technique_label","n_denominator","n_used","share_pct",
  "boot_ci_lo_pct","boot_ci_hi_pct","bca_ci_lo_pct","bca_ci_hi_pct","boot_width_pp","rank","is_max",
  "rank_named5"]].to_string(index=False))
print("\n=== SENSITIVITY GRID ===")
print(res[["frame","technique_label","n_denominator","n_used","share_pct","boot_ci_lo_pct",
           "boot_ci_hi_pct","rank","is_max"]].to_string(index=False))
print("\n=== McNEMAR (primary base, n=194) ===")
print(mc.to_string(index=False))
print("\n=== D1 counts required for 69.399% ===");   print(d1.to_string(index=False))
print("\n=== D2 CI diagnostics ===");               print(d2.to_string(index=False))
print("\n=== D3 single-column subsets within 0.5pp of 69.399% ==="); print(hits.to_string(index=False))
print("\n=== descriptives (n=194) ===")
print("mean techniques/respondent=%.3f ; >=1: %d ; >=2: %d ; 0: %d" %
      (P.sum(1).mean(), P.any(1).sum(), (P.sum(1) >= 2).sum(), (~P.any(1)).sum()))
print("Interviews %d/%d = %.3f%%" % (P[:,0].sum(), 194, 100*P[:,0].mean()))

# ---------------- verification against the read-only inspection tallies ----------------
insp = {  # expected from the pre-analysis inspection stage
    "n_rows": 276, "n_legit": 188, "n_q9_sentinel": 82, "n_primary_base": 194,
    "interviews_quoted": 97, "scenarios_quoted": 75, "prototyping_quoted": 75,
    "workshops_quoted": 74, "observation_quoted": 64, "others_quoted": 11,
    "primary_share_interviews": 50.000, "any_technique_users": 174, "named5_users": 170,
}
STEM = ["interviews", "scenarios", "prototyping", "workshops", "observation", "others"]
got = {"n_rows": len(df), "n_legit": int(legit.sum()), "n_q9_sentinel": int(sentn.sum()),
       "n_primary_base": int(P.shape[0]),
       "primary_share_interviews": float(round(100*P[:, 0].mean(), 3)),
       "any_technique_users": int(used.any(1).sum()), "named5_users": int(used[:, :5].any(1).sum())}
for stem, j in zip(STEM, range(6)):
    got[f"{stem}_quoted"] = int(P[:, j].sum())
pd.DataFrame([got]).to_csv(str(ROOT / "analysis") + "/q9_verification_vs_inspection.csv", index=False)
print("\n=== VERIFICATION vs inspection ===")
ok = True
for k, v in insp.items():
    g = got.get(k); flag = (g == v); ok &= flag
    print(f"  {k:28s} expected={v!s:8s} got={g!s:8s} {'OK' if flag else 'MISMATCH'}")
print("ALL MATCH" if ok else "*** MISMATCH vs inspection -> flag to researcher ***")
assert ok, "inspection/analysis disagreement"

# ---------------- FINDINGS.md (generated by this run) ----------------
prim = res[res.frame == "primary_valid_Q9_194"].sort_values("rank")
def md(d, cols):
    d = d[cols]
    head = "| " + " | ".join(cols) + " |\n|" + "|".join(["---"]*len(cols)) + "|"
    body = "\n".join("| " + " | ".join(str(x) for x in row) + " |" for row in d.astype(str).to_numpy())
    return head + "\n" + body
grid_pp = 100 / 194
iv = prim[prim.technique_label == "Interviews"].iloc[0]
winners = res[res.is_max].sort_values("frame")
HYP = ("Interviews are the most commonly used technique for eliciting requirements in ML-enabled "
       "system projects: %d of the %d respondents who answered the Q9 elicitation block (%.1f%%, "
       "95%% bootstrap CI %.1f-%.1f%%) reported using interviews, more than scenarios or "
       "prototyping (75 each, 38.7%%), workshops/meetings (74, 38.1%%), observation (64, 33.0%%) or "
       "any other technique (11, 5.7%%). Interviews rank first on every defensible denominator "
       "(188, 194, 276, 174, 170 rows) and in 2000/2000 random subsamples, and they significantly "
       "outwork workshops/meetings, observation and 'others' in paired McNemar tests "
       "(Holm-adjusted p<0.05); the lead over scenarios/prototyping is directionally consistent "
       "but only marginal after multiplicity correction (Holm p~0.056). The 69.399%% "
       "(95%% CI [69.062, 69.735]) figure quoted in the question is NOT reproducible from this "
       "export and is reported only as a labelled discrepancy reference."
       % (int(iv.n_used), int(iv.n_denominator), iv.share_pct, iv.boot_ci_lo_pct, iv.boot_ci_hi_pct))
with open(str(ROOT/"analysis"/"FINDINGS.md"), "w") as fh:
    fh.write("# Most commonly used requirements-elicitation technique (Q9_ML_Elicitation_*)\n\n"
      "## Answer / hypothesis\n\n" + HYP + "\n\n"
      "## Coding decisions (fixed before the run; no filter tuned to any target figure)\n\n"
      "* Export is pre-coded: each Q9 item holds `quoted` / `not quoted` / `-77`. **No Likert or "
      "intensity scale exists in this file**, so no top-2-box or mean-intensity ranking is possible.\n"
      "* indicator `uses = (value=='quoted')`; `-77` (item block never reached, 82/276 rows, all "
      "`Status = Suspended`) is missing and excluded listwise at respondent level.\n"
      "* primary denominator = 194 respondents exposed to the Q9 block (incl. 6 Suspended rows that "
      "contain a complete block); sensitivity frames 188 / 276 / 174 / 170.\n"
      f"* bootstrap: B={B} respondent-row resamples (whole rows, preserving the multi-select "
      f"correlation), seed={SEED}, percentile 2.5/97.5 primary, BCa secondary.\n"
      "* `rank` breaks ties by count then label; `rank_named5` uses min-rank so the "
      "Scenarios=Prototyping tie shares rank 2 there.\n\n"
      "## Primary result (n=194)\n\n" + md(prim, ["technique_label","source_column","n_denominator",
      "n_used","share_pct","boot_ci_lo_pct","boot_ci_hi_pct","bca_ci_lo_pct","bca_ci_hi_pct",
      "rank","rank_named5"]) + "\n\n"
      "## Winner per frame (sensitivity grid)\n\n" + md(winners, ["frame","n_denominator","n_used",
      "share_pct","boot_ci_lo_pct","boot_ci_hi_pct"]) + "\n\n"
      "(full 5x6 grid in `q9_results_long.csv`)\n\n"
      "## Paired significance: McNemar exact, Interviews vs each technique (n=194)\n\n"
      + md(mc, ["technique_b","interviews_only","other_only","n_discordant","p_value","holm_adjusted_p",
               "holm_significant_0p05"]) + "\n\n"
      f"## Discrepancy note on the benchmark figure 69.399% (95% CI [69.062, 69.735])\n\n"
      f"1. **Counts required vs observed.** At n=194 the share is quantised in steps of "
      f"{grid_pp:.4f} pp (1/194); 69.399% would need k=135 endorsements (135/194=69.588%) or k=134 "
      f"(69.072%) - observed interviews count is 97. No frame in this file (276, 194, 190, 188, 174, "
      f"164) admits a count giving 69.399%; the only exact match, 127/183, has no counterpart among "
      f"the Q9 counts.\n\n"
      + md(d1, ["denominator_N","k_needed_for_69_399pct","realised_pct_of_that_k","exact_match",
               "observed_interviews_quoted","observed_pct"]) + "\n\n"
      f"2. **The quoted CI width cannot come from a respondent-level proportion here.** Half-width "
      f"0.3365 pp implies an effective Bernoulli N ~ {implied_N:,.0f} (Wald inversion), "
      f"{implied_N/194:.0f}x the primary base; "
      f"our bootstrap CI width is {iv.boot_width_pp:.2f} pp and the smallest theoretically possible "
      f"Wald width at n=276 is 5.44 pp. Also, a proportion on n=194 can only take values on a "
      f"{grid_pp:.4f} pp grid, so bounds quoted to 0.001 pp are impossible.\n\n"
      + md(d2, ["diagnostic","value"]) + "\n\n"
      "3. **Nearest interpretable reconstruction (hypothesis, not a result):** 97/140 = 69.2857%, "
      "i.e. the same 97 interview endorsements on a ~140-respondent valid base; a B=1000 bootstrap "
      "mean carries MC SE 0.123 pp, enough to display 69.399%. This suggests the benchmark figure "
      "was computed on a different (smaller/earlier) export. It is not used as our estimate.\n\n"
      "4. **Post-hoc subsets rejected:** every single-column filter with n>=50 was scanned; only "
      "n=59 (69.492%) and n=55 (69.091%) come within 0.5 pp and were rejected as data-driven "
      "subgroups.\n\n" + md(hits, ["filter","n","interviews_pct","abs_gap_pp","judgement"]) +
      "\n\n## Robustness / cross-checks\n\n"
      "* All 13 counts and frame sizes reproduce the read-only inspection stage exactly "
      "(`q9_verification_vs_inspection.csv`).\n"
      "* Bootstrap percentile CIs agree with analytic Wilson intervals to <1 pp (cross_checks.py).\n"
      "* Percentile bounds are identical across 8 alternative seeds (discrete n=194 grid).\n"
      "* argmax = Interviews in 2000/2000 random 85% row subsamples.\n"
      "* McNemar p-values reproduced by hand-computed binomial sums (independent of scipy).\n\n"
      "## Limitations\n\n"
      "* 'Others' endorsements include junk free-text (blank, \"I don't know\", \"Beer please\"); "
      "it is the last-ranked item either way and the 5-named-technique ranking is also reported.\n"
      "* `quoted`/`not quoted` cannot distinguish frequency or intensity of use; 'most commonly "
      "used' here means 'most often endorsed'.\n"
      "* 82 of 276 rows never saw the block; they are excluded rather than counted as non-users.\n")
print("\nFINDINGS.md + hypothesis written")
print("\nHYPOTHESIS:\n" + HYP)
