#!/usr/bin/env python3
"""
Most commonly used requirements-elicitation technique for ML-enabled systems.

Data : data/requirements_engineering_for_ML-enabled_systems.csv (276 respondents x 202 cols)
Block: Q9_ML_Elicitation_* -> 6 scored items, PRE-CODED in this export as
       {'quoted','not quoted','-77'}; there is NO Likert/intensity scale in this file.

Decisions fixed with the researcher (no filter/denominator was tuned to hit any target figure):
  * indicator: uses = (value == 'quoted'); 'not quoted' -> 0; '-77' (block never reached)
    -> missing, excluded listwise at respondent level (NOT recoded to 0).
  * primary denominator: 194 respondents exposed to / answering the Q9 block.
  * sensitivity frames: 188 (Status screened), 276 (-77 recoded to "not used"),
    174 (respondents quoting >=1 technique).
  * "most commonly used" = maximum count/share of respondents quoting the technique.
  * bootstrap: B=10,000 respondent-row resamples (whole rows, preserving the within-
    respondent multi-select correlation), seed=12345, percentile CI primary, BCa secondary.
  * McNemar exact test: Interviews vs every other technique (paired multi-select design).
"""
import numpy as np
import pandas as pd
from statistics import NormalDist
from scipy.stats import binomtest

ROOT = __import__("pathlib").Path(__file__).resolve().parent.parent   # repo root
PD = str(ROOT / "data/requirements_engineering_for_ML-enabled_systems.csv")
SEED, B = 12345, 10_000
TECH = {
    "Interviews":          "Q9_ML_Elicitation_Interviews",
    "Scenarios":           "Q9_ML_Elicitation_Scenarios",
    "Prototyping":         "Q9_ML_Elicitation_Prototyping",
    "Workshops/Meetings":  "Q9_ML_Elicitation_Workshops_Meetings",
    "Observation":         "Q9_ML_Elicitation_Observation",
    "Others (free-text)":  "Q9_ML_Elicitation_Others",
}
NAMED = [t for t in TECH if t != "Others (free-text)"]
QUOTED, NOTQ, SENT = "quoted", "not quoted", "-77"
Z = 1.9599639845400536
nd = NormalDist()

# ---------------------------------------------------------------- load + code
df = pd.read_csv(PD, dtype=str, keep_default_na=False)
labels, cols = list(TECH), list(TECH.values())
raw = df[cols]
assert set(raw.stack().unique()) <= {QUOTED, NOTQ, SENT}, "unexpected Q9 value domain"
sentinel = raw[cols[0]] == SENT
assert all(raw[c].eq(SENT).equals(sentinel) for c in cols), "Q9 missingness not block-consistent"

used  = (raw == QUOTED).to_numpy()
sentn = sentinel.to_numpy()
legit = (df["Status"] != "Suspended (22)").to_numpy()

frames = {
    "primary_valid_Q9_194": ~sentn,
    "sens_status_screened_188": legit & ~sentn,
    "sens_all_rows_sentinel_as_not_used_276": np.ones(len(df), bool),
    "sens_users_of_>=1_technique_174": used.any(axis=1),
    "sens_users_of_>=1_named5_170": used[:, :5].any(axis=1),
}
indicator = {
    "primary_valid_Q9_194": "value=='quoted'; 194 rows exposed to Q9; '-77' excluded listwise",
    "sens_status_screened_188": "value=='quoted'; Status in Completed/Completed-after-break; '-77' excluded",
    "sens_all_rows_sentinel_as_not_used_276": "value=='quoted'; all 276 rows, '-77' recoded to 0 (NOT used)",
    "sens_users_of_>=1_technique_174": "value=='quoted'; frame = respondents quoting >=1 of the SIX Q9 items",
    "sens_users_of_>=1_named5_170": "value=='quoted'; frame = respondents quoting >=1 of the FIVE named techniques",
}
P = used[~sentn]
assert P.shape == (194, 6), P.shape

# ---------------------------------------------------------------- bootstrap
def boot_proportions(M, rng, B):
    n, k = M.shape
    idx = rng.integers(0, n, size=(B, n))
    return M[idx].sum(axis=1) / n

def bca_proportion(M, boots, theta):
    """BCa for per-column proportions; bias-correction from bootstrap dist, jackknife a."""
    n = M.shape[0]
    z0 = [nd.inv_cdf(max(1e-12, min(1 - 1e-12, (boots[:, j] < theta[j]).mean())))
          for j in range(M.shape[1])]
    tot = M.sum(axis=0)
    jk = (tot - M) / (n - 1)
    m = jk.mean(axis=0)
    dev = m - jk
    a = (dev ** 3).sum(axis=0) / (6.0 * np.power((dev ** 2).sum(axis=0), 1.5))
    out = np.empty((M.shape[1], 2))
    for j in range(M.shape[1]):
        for c, q in enumerate((0.025, 0.975)):
            zq = nd.inv_cdf(q)
            adj = nd.cdf(z0[j] + (z0[j] + zq) / (1 - a[j] * (z0[j] + zq)))
            out[j, c] = np.quantile(boots[:, j], adj)
    return out
