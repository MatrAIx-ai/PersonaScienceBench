#!/usr/bin/env python3
"""Independent cross-checks of the main run (different implementations, not re-uses)."""
import numpy as np, pandas as pd, math, pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from q9_elicitation_analysis import P, used, labels, legit, sentn, ROOT

# 1) McNemar exact p by hand (no scipy) -------------------------------------------------
def mcnemar_exact(b, c):
    n = b + c
    if n == 0: return float("nan")
    pm = [math.comb(n, k) * 0.5**n for k in range(n + 1)]
    lo = sum(pm[:b + 1]); up = sum(pm[b:]); return min(1.0, 2 * min(lo, up))
a = P[:, 0]
print("--- McNemar recomputed by hand (binomial sums) ---")
for lab, j in [(l, k) for k, l in enumerate(labels) if k]:
    b, c = int((a & ~P[:, j]).sum()), int((~a & P[:, j]).sum())
    print(f"  Interviews vs {lab:19s} b={b:3d} c={c:3d} p={mcnemar_exact(b, c):.3e}")

# 2) analytic intervals vs bootstrap percentile ------------------------------------------
def wilson(k, n, z=1.9599639845400536):
    p = k / n; d = 1 + z*z/n
    ctr = (p + z*z/(2*n))/d; hw = z*math.sqrt(p*(1-p)/n + z*z/(4*n*n))/d
    return 100*(ctr-hw), 100*(ctr+hw)
print("\n--- n=194 counts: raw % | Wilson 95% | bootstrap percentile (from main run) ---")
main = pd.read_csv(str(ROOT/"analysis"/"q9_results_long.csv"))
main = main[main.frame == "primary_valid_Q9_194"].set_index("technique_label")
for j, lab in enumerate(labels):
    k, n = int(P[:, j].sum()), P.shape[0]
    wl, wh = wilson(k, n)
    print(f"  {lab:19s} {100*k/n:6.3f}  [{wl:6.3f},{wh:6.3f}]  boot [{main.boot_ci_lo_pct[lab]:6.3f},{main.boot_ci_hi_pct[lab]:6.3f}]")

# 3) seed sensitivity of the bootstrap CI (MC error) -------------------------------------
print("\n--- bootstrap CI for Interviews across 8 alternative seeds (B=10,000) ---")
rows=[]
for s in [12345, 1, 7, 42, 2024, 99991, 555, 31337]:
    rng = np.random.default_rng(s)
    idx = rng.integers(0, P.shape[0], size=(10_000, P.shape[0]))
    col = P[:, 0]
    bs = col[idx].mean(1)
    lo, hi = np.quantile(bs, [.025, .975]); rows.append((100*lo, 100*hi))
rows = np.array(rows)
print("  lo: min %.3f max %.3f | hi: min %.3f max %.3f | MC spread of bounds ~%.2f pp"
      % (rows[:,0].min(), rows[:,0].max(), rows[:,1].min(), rows[:,1].max(), (rows.max(0)-rows.min(0)).max()))

# 4) winner stability under 2,000 random exclusion rules (no tuning, robustness only) -----
rng = np.random.default_rng(2024); win = {}
for rep in range(2000):
    keep = rng.random(len(used)) < 0.85
    m = keep & ~sentn
    if m.sum() < 40: continue
    s = used[m].mean(0); win[labels[int(np.argmax(s))]] = win.get(labels[int(np.argmax(s))], 0) + 1
print("\n--- argmax over 2,000 random 85% row subsamples (valid Q9 rows only) ---")
print("  ", win)
