"""Inspection of Q10 documentation block: requirements_engineering_for_ML-enabled_systems.csv
Plan-stage inspection only (no interpretation / no final conclusion).
Run: python3 analysis/inspection.py
"""
import sys
import numpy as np, pandas as pd
import scipy

PATH = "data/requirements_engineering_for_ML-enabled_systems.csv"
SEED = 20261025
B = 10_000

df = pd.read_csv(PATH)
print(f"pandas {pd.__version__} | numpy {np.__version__} | scipy {scipy.__version__} | python {sys.version.split()[0]}")

# ---------- 1. shape / screening columns ----------
print("\n=== 1. SHAPE & SCREENING ===")
print("shape (rows, cols):", df.shape)
print("unique IDs:", df.ID.nunique(), "| duplicate IDs:", int(df.ID.duplicated().sum()), "| null IDs:", int(df.ID.isna().sum()))
print("\nStatus:\n", df.Status.value_counts(dropna=False).to_string())
print("\nDuration: dtype", df.Duration.dtype, "| min", df.Duration.min(), "| median", df.Duration.median(),
      "| ==0:", int((df.Duration == 0).sum()), "| <0:", int((df.Duration < 0).sum()))
print("\nDuration==0 / <0 by Status:\n",
      pd.crosstab(df.Status, np.where(df.Duration == 0, "dur==0", np.where(df.Duration < 0, "dur<0", "dur>0"))).to_string())

# ---------- 2. Q10 encoding ----------
Q10 = [c for c in df.columns if c.startswith("Q10_ML_Documentation")]
Q10_ITEM = [c for c in Q10 if not c.endswith("_Free")]
Q10_FREE = "Q10_ML_Documentation_Others_Free"
print("\n=== 2. Q10 DOCUMENTATION BLOCK ENCODING ===")
print("columns in block:", len(Q10), "(11 formats + Not_Documented + Others + Others_Free)")
for c in Q10:
    vc = df[c].value_counts(dropna=False)
    print(f"\n{c}\n{vc.to_string()}")
missing_mask = df[Q10_ITEM[0]].eq("-77")
print("\nRows with -77 in every Q10 item column:", int(missing_mask.sum()))
print("Check: is -77 constant across all 12 item columns per row? ->",
      bool(df[Q10_ITEM].apply(lambda r: len(set(r)) == 1, axis=1).all()))
print("-77 rows by Status:\n", df.loc[missing_mask, "Status"].value_counts().to_string())
print("Any -99/-66 inside item (non-free) columns? ->",
      {c: int(df[c].isin(['-99', '-66']).sum()) for c in Q10_ITEM})

# ---------- 3. counts / percentages ----------
ans = df.loc[~missing_mask].copy()
DEN_ALL, DEN_ANS = len(df), len(ans)
print("\n=== 3. PER-FORMAT COUNTS (unit = respondent) ===")
rows = []
for c in Q10_ITEM:
    f = c.replace("Q10_ML_Documentation_", "")
    q_all = int(df[c].eq("quoted").sum())
    q_ans = int(ans[c].eq("quoted").sum())
    rows.append([f, q_all, 100 * q_all / DEN_ALL, q_ans, 100 * q_ans / DEN_ANS])
tab = pd.DataFrame(rows, columns=["format", "n_all", "pct_all", "n_ans", "pct_ans"]).sort_values("n_ans")
print(f"denominators: all respondents = {DEN_ALL}; answered Q10 = {DEN_ANS}")
print(tab.round(3).to_string(index=False))
tot = int(ans[Q10_ITEM].eq("quoted").sum().sum())
tot_excl = int(ans[[c for c in Q10_ITEM if "Not_Documented" not in c]].eq("quoted").sum().sum())
print(f"\ntotal 'quoted' selections among answerers = {tot} (excl. Not_Documented = {tot_excl})")
print("share-of-selections view (excl Not_Documented):")
sel = tab[tab.format != "Not_Documented"].copy()
sel["pct_of_selections"] = 100 * sel.n_ans / tot_excl
print(sel[["format", "n_ans", "pct_of_selections"]].round(3).to_string(index=False))
named = [c for c in Q10_ITEM if not c.endswith("_Others") and "Not_Documented" not in c]
any_fmt = ans[named].eq("quoted").any(axis=1)
print(f"\nanswerers selecting >=1 named format: {int(any_fmt.sum())}; 'Not_Documented' selected by "
      f"{int(ans['Q10_ML_Documentation_Not_Documented'].eq('quoted').sum())}; both = "
      f"{int((any_fmt & ans['Q10_ML_Documentation_Not_Documented'].eq('quoted')).sum())}")

# Others_Free tally
s = df[Q10_FREE]
n_code = int(s.isin(["-99", "-66"]).sum())
n_nan = int(s.isna().sum())
print(f"Others_Free: code -99 = {int((s=='-99').sum())}, -66 = {int((s=='-66').sum())}, NaN = {n_nan}, free text = {len(s)-n_code-n_nan}")
print("Others 'quoted' & free text given:",
      int((df['Q10_ML_Documentation_Others'].eq('quoted') & ~s.isin(['-99','-66']) & s.notna()).sum()))

# ---------- 4/5. bootstrap preview (respondent-level, percentile CI) ----------
print("\n=== 4/5. BOOTSTRAP PREVIEW (respondent rows resampled, B=%d, seed=%d, percentile 95%% CI) ===" % (B, SEED))
rng = np.random.default_rng(SEED)
X = ans[Q10_ITEM].eq("quoted").to_numpy()
idx = rng.integers(0, X.shape[0], size=(B, X.shape[0]))
boot = X[idx].mean(axis=1) * 100
bt = pd.DataFrame({"format": [c.replace("Q10_ML_Documentation_", "") for c in Q10_ITEM],
                   "pct": boot.mean(axis=0),
                   "ci_lo_pct": np.percentile(boot, 2.5, axis=0),
                   "ci_hi_pct": np.percentile(boot, 97.5, axis=0)})
print(bt.round(3).to_string(index=False))

print("\n=== DIAGNOSTIC: effective n implied by the CIs quoted in the question ===")
for p, lo, hi in [(10.13, 9.926, 10.333), (4.366, 4.231, 4.501)]:
    se = ((hi - lo) / 2 / 100) / 1.959964
    print(f"  p={p}% CI[{lo},{hi}] -> implied n = {p/100*(1-p/100)/se**2:,.0f}  (data n={DEN_ANS}, N={DEN_ALL})")
