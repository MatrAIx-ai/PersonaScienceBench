"""
Q10 documentation formats -- least-used analysis with bootstrap CIs and rank probabilities.
requirements_engineering_for_ML-enabled_systems.csv (DiscoveryBench episode metadata_8)

Operational definitions (agreed with researcher):
  * "used"  == Q10 item value == 'quoted'  (multi-select battery: quoted | not quoted | -77)
  * '-77'   == item non-response  -> respondent excluded from the analytic base (NOT a zero)
  * primary denominator  = 194 respondents who answered the Q10 block
  * sensitivity denominators = 276 (all stored respondents, -77 counted as not-used),
    188 (Completed-family who answered), 146 (answered AND named >=1 format),
    168 (answered & Duration>0), 182 (Completed-family & Duration>0)
  * Not_Documented and Others are kept in the table but excluded from the FORMAT ranking
  * unit of resampling = respondent row (whole Q10 response vector), bootstrap percentile CIs
Run: python3 analysis/q10_bootstrap.py
"""
import sys, json
import numpy as np, pandas as pd, scipy
from scipy.stats import beta

PATH, SEED, B = "data/requirements_engineering_for_ML-enabled_systems.csv", 20261025, 10_000
pd.set_option("display.width", 250); pd.set_option("display.max_columns", 60)

df = pd.read_csv(PATH)
Q10 = [c for c in df.columns if c.startswith("Q10_ML_Documentation")]
ITEM = [c for c in Q10 if not c.endswith("_Free")]
FREE = "Q10_ML_Documentation_Others_Free"
ND, OTH = "Q10_ML_Documentation_Not_Documented", "Q10_ML_Documentation_Others"
NAMED = [c for c in ITEM if c not in (ND, OTH)]                    # 10 named formats
LABEL = {c: c.replace("Q10_ML_Documentation_", "").replace("_", " ") for c in ITEM}
lab = lambda c: LABEL[c]

print(f"python {sys.version.split()[0]} | pandas {pd.__version__} | numpy {np.__version__} "
      f"| scipy {scipy.__version__} | seed {SEED} | B {B}")
print(f"file shape {df.shape} | unique IDs {df.ID.nunique()} | duplicate IDs {int(df.ID.duplicated().sum())}")

# ---------------- encoding audit ----------------
print("\n[1] ENCODING AUDIT -----------------------------------------------------------")
for c in ITEM:
    print(f"  {lab(c):22s} {sorted(df[c].dropna().unique())}  -77={int(df[c].eq('-77').sum())}")
na = df[ITEM].eq("-77")
print(f"  rows with -77 in ALL {len(ITEM)} item cols: {int(na.all(axis=1).sum())} "
      f"| partially missing rows: {int((na.sum(axis=1).between(1, len(ITEM)-1)).sum())}")
answered = ~na.all(axis=1)
print("  -77 (non-respondent) rows by Status:",
      df.loc[~answered, "Status"].value_counts().to_dict())
print("  Suspended respondents that DID answer Q10:",
      int((df.Status.eq("Suspended (22)") & answered).sum()))

# ---------------- analytic bases ----------------
named_any = df[NAMED].eq("quoted").any(axis=1)
completed = df.Status.isin(["Completed (31)", "Completed after break (32)"])
bases = {
    "PRIMARY answered-Q10 (n=194)":            answered,
    "S1 all stored respondents (n=276)":       pd.Series(True, index=df.index),
    "S2 answered & Completed-family":          answered & completed,
    "S3 answered & named >=1 format":          answered & named_any,
    "S4 answered & Duration>0":                answered & df.Duration.gt(0),
    "S5 Completed-family & named >=1 format":  completed & named_any,
}
print("\n[2] ANALYTIC BASES -----------------------------------------------------------")
for k, m in bases.items():
    print(f"  {k:42s} n={int(m.sum()):4d}")

# ---------------- estimand + bootstrap ----------------
def wilson(k, n, z=1.959963984540054):
    if n == 0: return (np.nan, np.nan)
    p = k / n; d = 1 + z*z/n
    c = (p + z*z/(2*n))/d; h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n))/d
    return (100*(c-h), 100*(c+h))

def run(mask, cols):
    """Respondent-level bootstrap of per-format usage share; percentile + basic CIs.
    Non-responders (-77) are counted as 'not used' whenever they are inside the base
    (relevant only for the all-276 sensitivity view, where they are NOT excluded)."""
    sub = df.loc[mask]
    X = sub[cols].eq("quoted").to_numpy()
    n = len(sub)
    rng = np.random.default_rng(SEED)
    idx = rng.integers(0, n, size=(B, n))
    boot = X[idx].mean(axis=1) * 100
    k = X.sum(axis=0); pct = X.mean(axis=0) * 100
    lo, hi = np.percentile(boot, [2.5, 97.5], axis=0)
    rows = []
    for j, c in enumerate(cols):
        w = wilson(int(k[j]), n)
        rows.append([lab(c), int(k[j]), round(pct[j], 3),
                     round(w[0], 3), round(w[1], 3),
                     round(lo[j], 3), round(hi[j], 3),
                     round(max(0.0, 2*pct[j]-hi[j]), 3), round(2*pct[j]-lo[j], 3)])
    return pd.DataFrame(rows, columns=["format", "k", "pct", "wil_lo", "wil_hi",
                                       "perc_lo", "perc_hi", "basic_lo", "basic_hi"]
                        ).sort_values("pct").reset_index(drop=True), boot, cols

print("\n[3] PER-FORMAT TABLES --------------------------------------------------------")
tables = {}
for name, mask in bases.items():
    t, _, _ = run(mask, ITEM)
    tables[name] = t
    print(f"\n--- {name} (n={int(mask.sum())}) ---")
    print(t.to_string(index=False))

# ---------------- rank probabilities ----------------
print("\n[4] BOOTSTRAP RANK PROBABILITIES ---------------------------------------------")
BR = 20_000
def rank_probs(mask, cols, tag):
    X = df.loc[mask, cols].eq("quoted").to_numpy(); n = len(X)
    rng = np.random.default_rng(SEED)
    boot = X[rng.integers(0, n, size=(BR, n))].mean(axis=1) * 100
    order = np.argsort(boot, axis=1)
    out = {}
    for r, nm in [(0, "least used"), (1, "second least used")]:
        cnt = np.bincount(order[:, r], minlength=len(cols))
        out[nm] = {lab(cols[i]): round(cnt[i]/BR, 4) for i in np.argsort(-cnt) if cnt[i] > 0}
        print(f"  [{tag}] P({nm}): {out[nm]}")
    return out

rank = {}
rank["with_Others"] = rank_probs(answered, NAMED + [OTH], "n=194, 10 named + Others residual")
rank["no_Others"]   = rank_probs(answered, NAMED,          "n=194, 10 named formats only")
rank["S3_with_O"]   = rank_probs(answered & named_any, NAMED + [OTH], "n=146, named + Others")
rank["S3_no_O"]     = rank_probs(answered & named_any, NAMED,          "n=146, named only")

# ---------------- free-text audit of Others ----------------
print("\n[5] FREE-TEXT AUDIT OF 'Others' ---------------------------------------------")
KEYS = {"vision": "Vision Document", "requirement": "Requirements Lists", "goal": "Goal Models",
        "use case": "Use Case Models", "prototype": "Prototypes", "user stor": "User Stories",
        "bdd": "BDD Scenarios", "behaviour-driven": "BDD Scenarios", "behavior-driven": "BDD Scenarios",
        "canvas": "ML Canvas", "notebook": "Notebooks", "jupyter": "Notebooks",
        "data model": "Data Models", "er diagram": "Data Models", "schema": "Data Models"}
s = df[FREE]
ft = s[~s.isin(["-99", "-66"]) & s.notna()]
print(f"  Others selected (quoted): {int(df[OTH].eq('quoted').sum())} | free texts: {len(ft)} "
      f"| codes -99={int(s.eq('-99').sum())}, -66={int(s.eq('-66').sum())}, blank={int(s.isna().sum())}")
alias = []
for i, v in ft.items():
    hits = sorted({tgt for k, tgt in KEYS.items() if k in str(v).lower()})
    alias.append(hits)
    print(f"    {str(v)[:78]:80s} -> alias_of_named_format: {hits if hits else 'NONE (tool/vehicle/other practice)'}")
print(f"  entries that are an alias of one of the 10 named formats: {sum(bool(a) for a in alias)}")
print(f"  Others 'quoted' rows that supplied text: "
      f"{int((df[OTH].eq('quoted') & ~s.isin(['-99','-66']) & s.notna()).sum())}")

# ---------------- bounded provenance check vs. the question's numbers ----------------
print("\n[6] BOUNDED CHECK: does any coherent base give ~10.1% (ML Canvas) AND ~4.4% (BDD)? -")
tgt = {"MLCanvas": 10.13, "BDD Scenarios": 4.366}
for name, mask in bases.items():
    sub = df.loc[mask]; n = len(sub)
    k = {lab(c): int(sub[c].eq("quoted").sum()) for c in ITEM}
    p = {f: 100*v/n for f, v in k.items()}
    d1, d2 = abs(p["MLCanvas"]-tgt["MLCanvas"]), abs(p["BDD Scenarios"]-tgt["BDD Scenarios"])
    print(f"  {name:42s} MLCanvas {p['MLCanvas']:5.2f}% (|d|={d1:4.2f})   "
          f"BDD {p['BDD Scenarios']:4.2f}% (|d|={d2:4.2f})   "
          f"ratio MLCanvas/BDD={p['MLCanvas']/p['BDD Scenarios']:.2f} (question ratio=2.32)")
print("  -> reported ratio in the question 2.32 cannot be obtained from k=15/k=4 (=3.75); "
      "no base in this file satisfies both targets.")

print("\n[7] HEADLINE (primary n=194, 10 named formats) -------------------------------")
print(tables["PRIMARY answered-Q10 (n=194)"].head(4).to_string(index=False))

print("\n[8] PROJECT-WEIGHTED SENSITIVITY (D7_Total_ML_Projects, negative codes masked to NaN) -")
w = pd.to_numeric(df["D7_Total_ML_Projects"], errors="coerce")
w = w.where(w >= 0)
sub = df.loc[answered]; ww = w.loc[answered].fillna(0)
tw = ww.sum()
for c in ITEM:
    sel = sub[c].eq("quoted")
    print(f"  {lab(c):22s} weighted share = {100*ww[sel].sum()/tw/len(ITEM):5.2f}%  "
          f"(share of all weighted selections = {100*ww[sel].sum()/sum(ww[sub[cc].eq('quoted')].sum() for cc in ITEM if cc != ND):5.2f}%)")
print("\n[9] SAVE SUMMARY -------------------------------------------------------------")
summary = {"primary_base_n": int(answered.sum()),
           "headline": tables["PRIMARY answered-Q10 (n=194)"].to_dict("records"),
           "rank_probs": {k: v for k, v in rank.items()}}
with open("analysis/q10_summary.json", "w") as fh: json.dump(summary, fh, indent=1, default=str)
print("  wrote analysis/q10_summary.json")
