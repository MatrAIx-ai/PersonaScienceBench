import numpy as np, pandas as pd
pan=pd.read_csv('analysis/panel_tidy.csv')
rng=np.random.default_rng(7)
def fitb(dat,y,xs):
    dat=dat.dropna(subset=[y]+xs); Y=dat[y].values; X=np.column_stack([np.ones(len(dat))]+[dat[k].values for k in xs])
    b=np.linalg.lstsq(X,Y,rcond=None)[0]
    r=Y-X@b; dof=len(Y)-X.shape[1]
    S=np.zeros((X.shape[1],X.shape[1]))
    if X.ndim==2: X=np.asarray(X,float)
    S=np.diag(np.linalg.pinv(X.T@X))*(r@r/dof)
    return b, np.sqrt(np.diag(S)), dat[['year']+xs+[y]].reset_index(drop=True)
def stat_b(dat,y,xs,k):
    d=dat.reset_index(drop=True); Y=d[y].values
    X=np.column_stack([np.ones(len(d))]+[d[c].values for c in xs])
    return np.linalg.lstsq(X,Y,rcond=None)[0][k]
def blocks(n,L,rng):
    idx=[]
    while len(idx)<n:
        st=rng.integers(0,n); ln=max(1,int(rng.geometric(1/L))); idx+=[(i%n) for i in range(st,st+ln)]
    return np.array(idx[:n])
SPECS=[('A1  dy ~ d_edu',['dedu'],1,5),('A1  dy ~ d_edu',['dedu'],1,1),
       ('A2  dy ~ d_edu + exp_growth',['dedu','exp_g'],1,5),
       ('A2  dy ~ d_edu + exp_growth',['dedu','exp_g'],1,1),
       ('A3  dy ~ d_edu + exp_g + GERs',['dedu','exp_g','prim','sec'],1,5)]
print('LMC block-bootstrap (stationary bootstrap, preserves persistence)')
for lab,xs,k,L in SPECS:
    dat=pan[pan['Country Code']=='LMC'].dropna(subset=['dy']+xs).reset_index(drop=True)
    obs=stat_b(dat,'dy',xs,k); n=len(dat); bs=[]
    for _ in range(20000):
        i=blocks(n,L,rng); d2=dat.iloc[i].reset_index(drop=True)
        if d2[xs].std().min()==0: continue
        bs.append(stat_b(d2,'dy',xs,k))
    bs=np.array(bs); lo,hi=np.percentile(bs,[2.5,97.5])
    p=2*min((bs<=0).mean(),(bs>=0).mean())
    print('  %-32s L=%-2d b=%+.4f  95%%CI [%+.4f,%+.4f]  boot p=%.3f  P(b>0)=%.3f  n=%d'%(lab,L,obs,lo,hi,p,(bs>0).mean(),n))
print('\nSSA (n=4):')
dat=pan[pan['Country Code']=='SSF'].dropna(subset=['dy','dedu']).reset_index(drop=True)
obs=stat_b(dat,'dy',['dedu'],1); bs=[stat_b(dat.iloc[rng.integers(0,4,4)].reset_index(drop=True),'dy',['dedu'],1) for _ in range(20000)]
bs=np.array(bs); lo,hi=np.percentile(bs,[2.5,97.5])
print('  A1 dy ~ d_edu  b=%+.4f  naive boot 95%%CI [%+.4f,%+.4f]  P(b>0)=%.3f'%(obs,lo,hi,(bs>0).mean()))
print('\n1976 dependence test (LMC):')
for lab,xs in [('A1',['dedu']),('A2',['dedu','exp_g']),('A3',['dedu','exp_g','prim','sec'])]:
    full=pan[pan['Country Code']=='LMC'].dropna(subset=['dy']+xs)
    a=stat_b(full,'dy',xs,1); b=stat_b(full[full.year!=1976],'dy',xs,1)
    print('  %-4s full b=%+.4f | drop 1976 b=%+.4f | change %+.4f (%.0f%% of full)'%(lab,a,b,b-a,100*(b-a)/a if a else 0))
