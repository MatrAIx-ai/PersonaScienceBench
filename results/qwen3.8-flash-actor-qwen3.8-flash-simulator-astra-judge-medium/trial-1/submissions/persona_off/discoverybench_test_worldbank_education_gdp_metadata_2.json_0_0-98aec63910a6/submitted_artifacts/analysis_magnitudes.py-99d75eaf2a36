import numpy as np, pandas as pd
pan=pd.read_csv('analysis/panel_tidy.csv')
print('--- scale of the exposure (pp of GNI devoted to education investment) ---')
for g in ['LMC','SSF']:
    s=pan[pan['Country Code']==g]
    print('  %s: edu share min=%.2f max=%.2f sd=%.3f | sd of annual change=%.3f | largest single-year change=%.2f'%(
      g,s.edu.min(),s.edu.max(),s.edu.std(),s.dedu.std(),s.dedu.abs().max()))
print('\n--- interpretation of primary LMC slope (A2 b=0.0151 per 1pp of GNI) ---')
for b,nm in [(0.0151,'A2'),(0.0219,'A1'),(0.0326,'A3')]:
    print('  %s: +1.00pp edu share -> %+.3f pp on annual per-capita growth; typical 1-yr move (0.216pp) -> %+.4f pp'%(nm,100*b,100*b*0.216))
print('\n--- implied cumulative effect over the 1975-2015 exposure drift ---')
for g in ['LMC','SSF']:
    s=pan[pan['Country Code']==g]
    dr=s.edu.iloc[-1]-s.edu.iloc[0]
    print('  %s: edu share changed %+.2f pp over 1975->2015 (%.2f -> %.2f)'%(g,dr,s.edu.iloc[0],s.edu.iloc[-1]))
print('  LMC at A2 slope: %+.2f pp/yr growth effect if 0.63pp decline were reversed'%(100*0.0151*0.635))
print('\n--- SSA vs LMC levels contrast (support for the comparative claim) ---')
for g in ['LMC','SSF']:
    s=pan[pan['Country Code']==g]
    print('  %s: edu 1975-2015 mean %.3f pp | secGER %.1f (1975) -> %.1f (2015) | GNIpc %s -> %s | mean growth %s'%(
      g,s.edu.mean(),s.sec.iloc[0],s.sec.iloc[-1],
      ('%.0f'%s.gdpcap.dropna().iloc[0]) if s.gdpcap.notna().any() else 'na',
      ('%.0f'%s.gdpcap.dropna().iloc[-1]) if s.gdpcap.notna().any() else 'na',
      ('%.4f'%s.dy.mean()) if s.dy.notna().any() else 'na'))
print('\n--- SSA output support: exactly which years permit estimation ---')
s=pan[pan['Country Code']=='SSF']
print('  SSA GNIpc present in:',list(s[s.gdpcap.notna()].year.astype(int)))
print('  SSA growth (dy) defined only for:',list(s[s.dy.notna()].year.astype(int)))
print('  => SSA slope rests on %d annual changes; a single observation is 25%% of the SSA signal.'%int(s.dy.notna().sum()))
