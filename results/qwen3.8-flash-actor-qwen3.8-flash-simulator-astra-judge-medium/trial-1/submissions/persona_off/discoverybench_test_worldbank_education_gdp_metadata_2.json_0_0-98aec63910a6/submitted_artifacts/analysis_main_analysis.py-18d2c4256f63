"""
FINAL ANALYSIS - association between education investment (adjusted savings, % of GNI)
and per-capita output (GNI pc, const. 2015 US$): Lower-middle-income (LMC) vs
Sub-Saharan Africa (SSF). 2 aggregate units x 41 years => ASSOCIATIONAL inference only.
Primary spec: first-differenced growth model, Newey-West(maxlags=4) SEs. No causal claims.
"""
import json
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats

SH = {'NY.GNP.PCAP.KD':'gdpcap','NY.ADJ.AEDU.GN.ZS':'edu','NE.EXP.GNFS.KD.ZG':'exp_g',
      'SE.PRM.ENRR':'prim','SE.SEC.ENRR':'sec','SL.TLF.CACT.ZS':'lfpr'}
LAB = {'edu':'edu_level','dedu':'d_edu','edu_l1':'edu_lag1','dedu_l1':'d_edu_lag1',
       'exp_g':'exp_growth','prim':'primGER','sec':'secGER','lfpr':'LFPR','t':'trend',
       'ssaf':'SSA_dummy','inter':'d_edu x SSA','edu_d':'edu_level(cgrp)','inter2':'edu_d x SSA'}

# ---------------- 1. wide -> tidy panel ----------------
raw = pd.read_csv('data/worldbank_education_gdp.csv', dtype=str, keep_default_na=False)
yc  = list(raw.columns[4:]); cells = raw[yc].values.ravel()
d   = raw.replace({'': np.nan}); d[yc] = d[yc].apply(pd.to_numeric, errors='coerce')
d['S'] = d['Series Code'].map(SH)
lng = d.melt(id_vars=['Country Code','S'], value_vars=yc, var_name='yc', value_name='v')
lng['year'] = [int(c.split(' ')[0]) for c in lng['yc']]
pan = (lng.pivot_table(index=['Country Code','year'], columns='S', values='v')
         .reset_index().sort_values(['Country Code','year']).reset_index(drop=True))
pan['ly']   = np.log(pan.gdpcap)
pan['dy']   = pan.groupby('Country Code').ly.diff()
pan['dedu'] = pan.groupby('Country Code').edu.diff()
pan['edu_l1']  = pan.groupby('Country Code').edu.shift(1)
pan['dedu_l1'] = pan.groupby('Country Code').dedu.shift(1)
pan['ssaf'] = (pan['Country Code']=='SSF').astype(int)
pan['t']    = pan.year - 1975
for g in ['LMC','SSF']:
    m = pan['Country Code']==g
    pan.loc[m,'edu_d'] = pan.loc[m,'edu'] - pan.loc[m,'edu'].mean()
pan['inter']  = pan.dedu*pan.ssaf
pan['inter2'] = pan.edu_d*pan.ssaf
pan.to_csv('analysis/panel_tidy.csv', index=False)

# ---------------- 2. estimation helper ----------------
def fit(dat, y, xs, label, maxlags=4):
    dat = dat.dropna(subset=[y]+xs); n = len(dat)
    if n < len(xs)+2:
        return {'label':label,'n':n,'note':'INSUFFICIENT SUPPORT','rows':{}}
    Y = dat[y].values.astype(float); X = sm.add_constant(dat[xs].astype(float).values)
    use = min(maxlags, max(0, n-X.shape[1]-1))
    if use >= 1: m = sm.OLS(Y,X).fit(cov_type='HAC', cov_kwds={'maxlags':use}); cov='NW(%d)'%use
    else:        m = sm.OLS(Y,X).fit(); cov='classical (n too small for HAC)'
    r = Y-X@m.params
    res = {'label':label,'n':n,'cov':cov,'R2':round(float(m.rsquared),3),
           'DW':round(float(np.sum(np.diff(r)**2)/np.sum(r**2)),2),'rows':{}}
    for i,k in enumerate(['const']+xs):
        res['rows'][k] = (round(float(m.params[i]),4), round(float(m.bse[i]),4),
                          round(float(m.tvalues[i]),2), round(float(m.pvalues[i]),3))
    return res

def show(res):
    if res.get('note'):
        print('  %-44s n=%-3d %s'%(res['label'],res['n'],res['note'])); return
    print('  %-44s n=%-3d R2=%-6s DW=%-5s SE=%s'%(res['label'],res['n'],res['R2'],res['DW'],res['cov']))
    for k,(b,se,t,p) in res['rows'].items():
        s = '***' if p<0.01 else '**' if p<0.05 else '*' if p<0.10 else ' '
        print('      %-13s b=%+9.4f  SE=%7.4f  t=%+6.2f  p=%-5.3f %s'%(LAB.get(k,k),b,se,t,p,s))

out = {}
print('='*92); print('A. PRIMARY: first-differenced growth models, Newey-West maxlags=4'); print('='*92)
SPECS = [('A1 dy ~ d_edu',                    ['dedu']),
         ('A2 dy ~ d_edu + exp_growth',       ['dedu','exp_g']),
         ('A3 dy ~ d_edu + exp_g + GERs',     ['dedu','exp_g','prim','sec']),
         ('A4 dy ~ d_edu (window >=1991)',    ['dedu']),
         ('A5 dy ~ d_edu + d_edu_lag1 + exp_g',['dedu','dedu_l1','exp_g']),
         ('A6 dy ~ edu_lag1 (level->growth)', ['edu_l1'])]
for g,NM in [('LMC','Lower middle income'),('SSF','Sub-Saharan Africa')]:
    print('\n--- %s (%s) ---'%(NM,g)); out[g]={}
    for lab,xs in SPECS:
        sub = pan[pan['Country Code']==g]
        if 'window >=1991' in lab: sub = sub[sub.year>=1991]
        r = fit(sub,'dy',xs,lab); out[g][lab]=r; show(r)

print('\n--- distributed lag: cumulative effect of d_edu (LMC, spec A5) ---')
dd = pan[pan['Country Code']=='LMC'].dropna(subset=['dy','dedu','dedu_l1','exp_g'])
m = sm.OLS(dd.dy.values, sm.add_constant(dd[['dedu','dedu_l1','exp_g']].astype(float).values)
          ).fit(cov_type='HAC', cov_kwds={'maxlags':4})
R = np.zeros((1,m.params.size)); R[0,1]=1.0; R[0,2]=1.0
tt = m.t_test(R)
ce,cs,ct = float(np.ravel(tt.effect)[0]), float(np.ravel(tt.sd)[0]), float(np.ravel(tt.tvalue)[0])
cp = float(np.ravel(tt.pvalue)[0])
print('  b(d_edu)+b(d_edu_lag1) = %+.4f  SE=%.4f  t=%+.2f  p=%.3f  (n=%d)'%(ce,cs,ct,cp,len(dd)))
out['LMC_cum_dlag'] = dict(effect=round(ce,4), se=round(cs,4), t=round(ct,2), p=round(cp,3),
                           n=len(dd), spec='dy ~ d_edu + d_edu_lag1 + exp_growth, NW(4)')

print('\n'+'='*92); print('B. LEVELS CONTRAST (spurious-trend prone; NOT effect estimates)'); print('='*92)
out['levels']={}
for g in ['LMC','SSF']:
    print('\n--- %s ---'%g); sub=pan[pan['Country Code']==g]
    out['levels'][g]={}
    for lab,xs in [('B1 log GNIpc ~ edu + trend',['edu','t']), ('B2 log GNIpc ~ edu',['edu'])]:
        r=fit(sub,'ly',xs,lab); out['levels'][g][lab]=r; show(r)
print('\n  LMC levels DW=0.52 with R2=0.92 => classic spurious regression; trend contrast only.')

print('\n'+'='*92); print('C. FORMAL GROUP COMPARISON: interaction + Chow test'); print('='*92)
c = pan.dropna(subset=['dy','dedu']).copy()
print('  pooled n=%d, SSA rows=%d (%.1f%%)'%(len(c), int(c.ssaf.sum()), 100*c.ssaf.mean()))
out['pooled']={}
for lab,xs in [('C1 dy ~ d_edu + SSA + d_edu:SSA',['dedu','ssaf','inter']),
               ('C2 dy ~ edu_d + SSA + edu_d:SSA',['edu_d','ssaf','inter2']),
               ('C3 dy ~ d_edu + SSA (no inter)', ['dedu','ssaf'])]:
    r=fit(c,'dy',xs,lab); out['pooled'][lab]=r; show(r)
    if 'C1' in lab:
        cf = sm.OLS(c.dy.values, sm.add_constant(c[['dedu','ssaf','inter']].astype(float).values)).fit()
        print('      [C1 with classical SEs: d_edu SE=%.4f t=%+.2f | interaction SE=%.4f t=%+.2f]'%(
              cf.bse[1], cf.tvalues[1], cf.bse[3], cf.tvalues[3]))
        out['pooled']['C1_classical']=dict(d_edu_SE=round(float(cf.bse[1]),4),
            d_edu_t=round(float(cf.tvalues[1]),2), inter_SE=round(float(cf.bse[3]),4),
            inter_t=round(float(cf.tvalues[3]),2))
def ssr_of(dat,xs):
    Y=dat.dy.values.astype(float); X=sm.add_constant(dat[xs].astype(float).values)
    b,*_=np.linalg.lstsq(X,Y,rcond=None); r=Y-X@b; return float(r@r)
rr = ssr_of(c,['dedu','ssaf']); ur=0.0; k=0
for g in ['LMC','SSF']:
    ur += ssr_of(c[c['Country Code']==g],['dedu']); k+=2
n_obs=len(c); q=2
F = ((rr-ur)/q)/(ur/(n_obs-k)); pF = float(1-stats.f.cdf(F,q,n_obs-k))
print('  Chow F(%d,%d)=%.3f p=%.3f  (SSR_restricted=%.6f SSR_unrestricted=%.6f, n=%d)'%(q,n_obs-k,F,pF,rr,ur,n_obs))
print('  -> power-limited: only %d of %d rows are SSA. A null here is NOT evidence of equal slopes.'%(int(c.ssaf.sum()),n_obs))
out['chow']=dict(F=round(F,3),df1=q,df2=int(n_obs-k),p=round(pF,3),n=int(n_obs),ssf_rows=int(c.ssaf.sum()),
                 SSR_r=round(rr,6),SSR_ur=round(ur,6))

print('\n'+'='*92); print('D. ROBUSTNESS: exposure slope, dep = growth of log GNI pc'); print('='*92)
rob=[]
def add(dat,g,variant,xs,key='dedu',maxlags=4):
    r=fit(dat,'dy',xs,variant,maxlags=maxlags)
    if r.get('note'): rob.append([variant,g,key,None,None,None,r['n'],'insufficient']); return
    b,se,t,p=r['rows'][key]; rob.append([variant,g,key,b,se,t,r['n'],r['cov']])
for g in ['LMC','SSF']:
    b0 = pan[pan['Country Code']==g].copy()
    add(b0,g,'R1 raw, dy~d_edu',['dedu'])
    add(b0,g,'R2 raw, dy~d_edu+exp_growth',['dedu','exp_g'])
    w=b0.copy(); w['exp_g']=w.exp_g.clip(-20,20)
    add(w,g,'R3 exp_growth winsorized +-20pp',['dedu','exp_g'])
    # SSA growth obs that DEPENDS on the 2011 GNI level is year 2012 (level 2011->2012).
    b11 = b0[~((b0['Country Code']=='SSF')&(b0.year==2012))].copy()
    add(b11,g,'R4 drop SSA growth year 2012 (uses 2011 level)',['dedu','exp_g'])
    add(b0[b0.year>=2011],g,'R5 symmetric window 2011-2015',['dedu'])
    add(b0[b0.year>=2011],g,'R6 symmetric 2011-2015 + exp_growth',['dedu','exp_g'])
    add(b0,g,'R7 exposure lagged (edu_t-1, level)',['edu_l1'],'edu_l1')
    add(b0[b0.year<=1990],g,'R8 subperiod 1976-1990',['dedu'])
    add(b0[b0.year>=1991],g,'R9 subperiod 1991-2015',['dedu'])
    add(b0,g,'R10 HAC maxlags=1',['dedu'],'dedu',1)
    add(b0,g,'R11 HAC maxlags=8',['dedu'],'dedu',8)
    add(b0[b0.year>=1991],g,'R12 window 1991-2015, dy~d_edu+exp_growth',['dedu','exp_g'])
    add(b0[b0.year>=1996],g,'R13 window 1996-2015, dy~d_edu+exp_growth',['dedu','exp_g'])
rdf=pd.DataFrame(rob,columns=['variant','group','exposure','b','SE','t','n','SE_type'])
print(rdf.to_string(index=False)); rdf.to_csv('analysis/robustness_table.csv',index=False)

print('\n--- leave-one-year-out stability, LMC spec A1 ---')
base=pan[pan['Country Code']=='LMC'].dropna(subset=['dy','dedu'])
loo=[]
for y in sorted(base.year.unique()):
    r=fit(base[base.year!=y],'dy',['dedu'],'y%d'%y)
    if not r.get('note'): loo.append((int(y), r['rows']['dedu'][0]))
loo=pd.DataFrame(loo,columns=['dropped_year','b_d_edu'])
print('  b range across %d LOO fits: [%.4f, %.4f]; full-sample b=%.4f'%(
      len(loo), loo.b_d_edu.min(), loo.b_d_edu.max(), out['LMC']['A1 dy ~ d_edu']['rows']['dedu'][0]))
loo.to_csv('analysis/loo_stability.csv',index=False)

print('\n'+'='*92); print('E. MECHANISM / DESCRIPTIVE (enrollment as channel, not just control)'); print('='*92)
rows=[]
for g in ['LMC','SSF']:
    s0=pan[pan['Country Code']==g]
    for (a,b),lab in [((1975,2015),'1975-2015'),((1991,2015),'1991-2015'),((2011,2015),'2011-2015')]:
        ss=s0[(s0.year>=a)&(s0.year<=b)]; gg=ss.gdpcap.dropna()
        rows.append(dict(group=g,window=lab,edu_mean_pp=round(ss.edu.mean(),3),
            gdpcap_first=round(gg.iloc[0],1) if len(gg) else None,
            gdpcap_last=round(gg.iloc[-1],1) if len(gg) else None,
            yrs_with_growth=int(ss.dy.notna().sum()),
            mean_growth=round(ss.dy.mean(),4) if ss.dy.notna().any() else None,
            primGER_first=round(ss.prim.iloc[0],1), primGER_last=round(ss.prim.iloc[-1],1),
            secGER_first=round(ss.sec.iloc[0],1), secGER_last=round(ss.sec.iloc[-1],1)))
ddf=pd.DataFrame(rows); print(ddf.to_string(index=False)); ddf.to_csv('analysis/descriptives.csv',index=False)
print('\n  education-investment gap, SSA minus LMC (pp of GNI):')
for lab in ['1975-2015','1991-2015','2011-2015']:
    a=ddf[ddf.window==lab].set_index('group')
    print('    %s: %+.3f pp  (SSA %.3f vs LMC %.3f)'%(lab,a.loc['SSF','edu_mean_pp']-a.loc['LMC','edu_mean_pp'],
          a.loc['SSF','edu_mean_pp'],a.loc['LMC','edu_mean_pp']))
print('\n  reduced form: does a rising education share raise enrollment? (d GER ~ d_edu, NW4)')
out['mech']={}
for g in ['LMC','SSF']:
    s0=pan[pan['Country Code']==g].copy()
    s0['d_prim']=s0.prim.diff(); s0['d_sec']=s0.sec.diff()
    for dep,nm in [('d_prim','primary GER'),('d_sec','secondary GER')]:
        r=fit(s0,dep,['dedu'],'%s d(%s) ~ d_edu'%(g,nm)); out['mech'][g+'_'+dep]=r; show(r)

print('\n'+'='*92); print('F. KEY NUMBERS FOR DELIVERABLE'); print('='*92)
r9=rdf[(rdf.group=='LMC')&(rdf.variant.str.startswith('R9 '))].iloc[0].to_dict()
r8=rdf[(rdf.group=='LMC')&(rdf.variant.str.startswith('R8 '))].iloc[0].to_dict()
key={'LMC_A1':out['LMC']['A1 dy ~ d_edu']['rows']['dedu'],
     'LMC_A2':out['LMC']['A2 dy ~ d_edu + exp_growth']['rows']['dedu'],
     'LMC_A3':out['LMC']['A3 dy ~ d_edu + exp_g + GERs']['rows']['dedu'],
     'LMC_A5_current':out['LMC']['A5 dy ~ d_edu + d_edu_lag1 + exp_g']['rows']['dedu'],
     'LMC_A5_lag':out['LMC']['A5 dy ~ d_edu + d_edu_lag1 + exp_g']['rows']['dedu_l1'],
     'LMC_cum_dlag':out['LMC_cum_dlag'],
     'LMC_sub_1976_1990':r8,'LMC_sub_1991_2015':r9,
     'LMC_levels_edu':out['levels']['LMC']['B1 log GNIpc ~ edu + trend']['rows']['edu'],
     'SSF_A1':out['SSF']['A1 dy ~ d_edu']['rows']['dedu'],
     'SSF_A2':out['SSF']['A2 dy ~ d_edu + exp_growth']['rows']['dedu'],
     'SSF_levels_edu':out['levels']['SSF']['B1 log GNIpc ~ edu + trend']['rows']['edu'],
     'C1_interaction':out['pooled']['C1 dy ~ d_edu + SSA + d_edu:SSA']['rows']['inter'],
     'C1_classical':out['pooled']['C1_classical'],'Chow':out['chow']}
for k,v in key.items(): print('  %-20s %s'%(k,v))
json.dump({'models':out,'robustness':rdf.to_dict('records'),'descriptives':ddf.to_dict('records'),
           'loo_range':[float(loo.b_d_edu.min()),float(loo.b_d_edu.max())],
           'key':{k:str(v) for k,v in key.items()}},
          open('analysis/results.json','w'), indent=1, default=str)
print('\nsaved: panel_tidy.csv, robustness_table.csv, descriptives.csv, loo_stability.csv, results.json')

print('\n'+'='*92); print('G. INFERENCE QUALITY: LOO detail + stationary block bootstrap (LMC A1)'); print('='*92)
print(loo.to_string(index=False))
b0=pan[pan['Country Code']=='LMC'].dropna(subset=['dy','dedu'])
y0=b0.dy.values; x0=b0.dedu.values
def slope(y,x):
    X=np.column_stack([np.ones(len(x)),x]); return np.linalg.lstsq(X,y,rcond=None)[0][1]
bobs=slope(y0,x0)
rng=np.random.default_rng(20261022); n=len(y0); L=5.0; boots=[]
for _ in range(20000):
    idx=[]; 
    while len(idx)<n:
        st=rng.integers(0,n); ln=rng.geometric(1/L)
        idx+= [ (i % n) for i in range(st,st+int(ln)) ]
    idx=np.array(idx[:n]); boots.append(slope(y0[idx],x0[idx]))
boots=np.array(boots); lo,hi=np.percentile(boots,[2.5,97.5])
p2=2*min((boots<=0).mean(),(boots>=0).mean())
print('  observed b=%.4f | block-bootstrap 95%% CI [%.4f, %.4f] | two-sided bootstrap p=%.3f (avg run len 5)'%(
      bobs,lo,hi,p2))
out['bootstrap_LMC_A1']=dict(b=round(float(bobs),4),ci_lo=round(float(lo),4),ci_hi=round(float(hi),4),
                             p_two_sided=round(float(p2),4),reps=20000,avg_block=5)

print('\n--- same bootstrap for SSA (n=4; illustrates why SSA support is weak) ---')
s0=pan[pan['Country Code']=='SSF'].dropna(subset=['dy','dedu'])
y1=s0.dy.values; x1=s0.dedu.values; b1obs=slope(y1,x1); bs=[]
for _ in range(20000):
    bs.append(slope(y1[rng.integers(0,len(y1),len(y1))], x1[rng.integers(0,len(y1),len(y1))]))
bs=np.array(bs); l2,h2=np.percentile(bs,[2.5,97.5])
print('  observed b=%.4f | naive bootstrap 95%% CI [%.4f, %.4f] (n=%d, CI is meaningless but shows fragility)'%(
      b1obs,l2,h2,len(y1)))
out['bootstrap_SSF_A1']=dict(b=round(float(b1obs),4),ci_lo=round(float(l2),4),ci_hi=round(float(h2),4),n=int(len(y1)))

print('\n--- difference in slopes: how large is the SSA-LMC gap, honestly? ---')
bl,bw=out['LMC']['A1 dy ~ d_edu']['rows']['dedu'][0],out['LMC']['A1 dy ~ d_edu']['rows']['dedu'][1]
bsv,bsw=out['SSF']['A1 dy ~ d_edu']['rows']['dedu'][0],out['SSF']['A1 dy ~ d_edu']['rows']['dedu'][1]
diff=bsv-bl; sed=float(np.sqrt(bw**2+bsw**2))
print('  SSA - LMC = %.4f - (%.4f) = %.4f, SE=%.4f, t=%.2f  (SEs are not comparable across n=4 vs n=40)'%(bsv,bl,diff,sed,diff/sed))
out['slope_gap']=dict(ssa_minus_lmc=round(diff,4),se=round(sed,4),t=round(diff/sed,2))

json.dump({'models':out,'robustness':rdf.to_dict('records'),'descriptives':ddf.to_dict('records'),
           'loo':loo.to_dict('records'),'loo_range':[float(loo.b_d_edu.min()),float(loo.b_d_edu.max())],
           'key':{k:str(v) for k,v in key.items()}},
          open('analysis/results.json','w'), indent=1, default=str)
print('\nFINAL SAVE complete -> analysis/results.json')
