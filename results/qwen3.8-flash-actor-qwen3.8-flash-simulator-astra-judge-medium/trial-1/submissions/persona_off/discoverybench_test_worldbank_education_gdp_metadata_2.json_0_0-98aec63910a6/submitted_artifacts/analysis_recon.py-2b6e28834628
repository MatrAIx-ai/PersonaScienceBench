"""Bounded reconnaissance of data/worldbank_education_gdp.csv (no final estimates)."""
import pandas as pd, numpy as np

SH = {'NY.GNP.PCAP.KD':'gdpcap','NY.ADJ.AEDU.GN.ZS':'edu','NE.EXP.GNFS.KD.ZG':'exp_g',
      'SE.PRM.ENRR':'prim','SE.SEC.ENRR':'sec','SL.TLF.CACT.ZS':'lfpr'}

raw = pd.read_csv('data/worldbank_education_gdp.csv', dtype=str, keep_default_na=False)
yc  = list(raw.columns[4:])
cells = raw[yc].values.ravel()
print('rows,cols =', raw.shape, '| year cols =', len(yc),
      '| span', yc[0], '->', yc[-1], '| empty cells =', int((cells=='').sum()), '/', cells.size)
print('groups =', raw['Country Group'].unique().tolist(), raw['Country Code'].unique().tolist())

d = raw.replace({'': np.nan}); d[yc] = d[yc].apply(pd.to_numeric, errors='coerce')
d['S'] = d['Series Code'].map(SH)
long = d.melt(id_vars=['Country Code','S'], value_vars=yc, var_name='yc', value_name='v')
long['year'] = [int(c.split(' ')[0]) for c in long['yc']]
pan = long.pivot_table(index=['Country Code','year'], columns='S', values='v').reset_index()
pan.to_csv('analysis/panel_tidy.csv', index=False)

print('\n--- coverage per (group, series): n_obs, first, last year present ---')
for _, r in pan.groupby('Country Code'):
    for s in SH.values():
        x = r.set_index('year')[s].dropna()
        print(f'{r["Country Code"].iloc[0]:>4} {s:<7} n={len(x):>3}/41 span={x.index.min()}-{x.index.max()}')

pan['ly'] = np.log(pan.gdpcap)
pan = pan.sort_values(['Country Code','year'])
pan['dy']   = pan.groupby('Country Code').ly.diff()
pan['dedu'] = pan.groupby('Country Code').edu.diff()
pan['ssaf'] = (pan['Country Code']=='SSF').astype(int)

def ols(dat, y, names, label):
    dat = dat.dropna(subset=[y]+names)
    if len(dat) < len(names)+2: return f'{label:<34} INSUFFICIENT (n={len(dat)})'
    yy = dat[y].values.astype(float)
    M  = np.column_stack([np.ones(len(dat))]+[dat[k].values.astype(float) for k in names])
    b,*_ = np.linalg.lstsq(M, yy, rcond=None); r = yy - M@b; dof = len(yy)-M.shape[1]
    se = np.sqrt(np.diag(np.linalg.pinv(M.T@M))*(r@r/dof))
    dw = np.sum(np.diff(r)**2)/np.sum(r**2)
    return (f'{label:<34} ' + ' '.join(f'{k}={v:+.4f}(t={v/s:.2f})' for k,v,s in zip(names,b[1:],se[1:]))
            + f' | R2={1-(r@r)/((yy-yy.mean())@(yy-yy.mean())):.3f} DW={dw:.2f} n={len(dat)}')

for g in ['LMC','SSF']:
    r = pan[pan['Country Code']==g].copy(); r['t'] = r.year-1975
    print(f'\n--- {g} (diagnostic, not final) ---')
    print(ols(r,'ly',['edu','t'],'log y ~ edu + trend'))
    print(ols(r,'dy',['edu'],'    dy ~ edu'))
    print(ols(r,'dy',['dedu'],'    dy ~ d_edu'))
    print(ols(r,'dy',['dedu','exp_g'],'    dy ~ d_edu + exp_g'))
    print(ols(r,'dy',['dedu','prim','sec','lfpr'],'    dy ~ d_edu + controls'))

pan['inter'] = pan.dedu*pan.ssaf
print('\n--- pooled formal comparison (interaction / Chow) ---')
print(ols(pan,'dy',['dedu','ssaf','inter'],'dy ~ d_edu*SSAF'))
print('\nSSF rows contributing to interaction:', int((pan.dropna(subset=["dy"]).ssaf==1).sum()),
      'of', int(pan.dy.notna().sum()))
