#!/usr/bin/env python3
"""
NLSY79 (1989): how does age influence the likelihood of dissaving (DISSAVED = 1)?
Reproducible pipeline:  python analysis.py
Writes results/model_report.txt and results/relations.csv
No missing values in the file -> all models are complete-case (n = 12,686 / 8,723).
"""
import os, numpy as np, pandas as pd, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats
from scipy.special import expit
pd.set_option('display.width', 240); pd.set_option('display.max_columns', 40)
os.makedirs('results', exist_ok=True)
OUT = open('results/model_report.txt', 'w')
def P(*a):
    s = " ".join(str(x) for x in a); print(s); OUT.write(s + "\n")

# ---------------- 1. load + derive ----------------
df = pd.read_csv('data/nls_bmi_processed.csv')
df['GEND_M']     = (df.GENDER == 'MALE').astype(int)
df['IMP']        = np.isclose(df.INCOME, 47.279064).astype(int)   # INCOME_MEANIMPUTED (inference, undocumented)
df['INCOME_LOG'] = np.log1p(df.INCOME)   # q99 == max -> winsorising vacuous; skew 8.24 -> -0.45
AGE_M            = df.AGE.mean()
df['AGE_C']      = df.AGE - AGE_M        # centred age breaks the AGE/AGE_2 collinearity (r = 0.999)
df['AGE_C2']     = df.AGE_C ** 2
df['INC_T']      = pd.qcut(df.INCOME.rank(method='first'), 3, labels=[0, 1, 2]).astype(int)
df['status']     = np.where(df.DISSAVED == 1, 'dissave', np.where(df.SAMESAVE == 1, 'same/none', 'net_save'))
df['agebin']     = pd.cut(df.AGE, [24, 26, 28, 30, 33], labels=['24-25','26-27','28-29','30-32'], right=False)

P("=== 1. INPUT INSPECTION ===")
P("shape:", df.shape, "| total missing cells:", int(df.isna().sum().sum()))
P("binary fields:", {c: sorted(df[c].unique()) for c in ['DISSAVED','SAMESAVE','BLACK','HISPANIC']},
  "| GENDER:", sorted(df.GENDER.unique()))
P("marginal DISSAVED rate: %.4f (%d/%d)" % (df.DISSAVED.mean(), df.DISSAVED.sum(), len(df)))
P("AGE %d-%d mean %.3f sd %.3f | AGE_2 == AGE**2 exactly: %s (corr %.3f)"
  % (df.AGE.min(), df.AGE.max(), df.AGE.mean(), df.AGE.std(), np.allclose(df.AGE_2, df.AGE**2), df.AGE.corr(df.AGE_2)))
P("INCOME min %.2f med %.2f mean %.2f max %.2f skew %.2f | zeros %d | rows at 47.279064 %d (%.2f%%) | rows at max %d"
  % (df.INCOME.min(), df.INCOME.median(), df.INCOME.mean(), df.INCOME.max(), df.INCOME.skew(),
     (df.INCOME == 0).sum(), int(np.isclose(df.INCOME, 47.279064).sum()), 100*np.isclose(df.INCOME, 47.279064).mean(),
     (df.INCOME == df.INCOME.max()).sum()))
P("mean(INCOME)=%.6f equals mean(INCOME | not at 47.279064)=%.6f  -> mean-imputation signature"
  % (df.INCOME.mean(), df.loc[~np.isclose(df.INCOME, 47.279064), 'INCOME'].mean()))
P("BMI mean %.2f min %.2f max %.2f (excluded from primary models: implausible tails, out of scope)"
  % (df.BMI.mean(), df.BMI.min(), df.BMI.max()))
P("DISSAVED==1 & SAMESAVE==1: %d rows (mutually exclusive); both 0 (net savers): %d"
  % (((df.DISSAVED == 1) & (df.SAMESAVE == 1)).sum(), ((df.DISSAVED == 0) & (df.SAMESAVE == 0)).sum()))

# ---------------- 2. descriptives ----------------
P("\n=== 2. DESCRIPTIVES ===")
g = df.groupby('AGE').DISSAVED.agg(['size','mean']); g['pct'] = (100*g['mean']).round(2)
g['se'] = [round(100*np.sqrt(p*(1-p)/n), 2) for p, n in zip(g['mean'], g['size'])]
P("dissaving rate by single year of age:\n" + g[['size','pct','se']].to_string())
b = df.groupby('agebin', observed=True).DISSAVED.agg(['size','mean']); b['pct'] = (100*b['mean']).round(2)
b['se'] = [round(100*np.sqrt(p*(1-p)/n), 2) for p, n in zip(b['mean'], b['size'])]
P("\ncoarse bins:\n" + b[['size','pct','se']].to_string())
P("\n3-state composition by age bin (%):\n" + pd.crosstab(df.agebin, df.status, normalize='index').mul(100).round(2).to_string())
t = df.groupby(['agebin','IMP'], observed=True).DISSAVED.agg(['size','mean']); t['pct'] = (100*t['mean']).round(2)
t['se'] = [round(100*np.sqrt(p*(1-p)/n), 2) for p, n in zip(t['mean'], t['size'])]
P("\ndissaving rate by age bin x INCOME group (% [se]):\n" + t[['size','pct','se']].to_string())

# ---------------- 3. estimation helpers ----------------
def build(d):
    imp = " + IMP" if d.IMP.std() > 0 else ""
    cov = f"C(GEND_M) + INCOME_LOG + BLACK + HISPANIC{imp}"
    return {'M1_linear_age'      : "DISSAVED ~ AGE_C",
            'M2_quad_age'        : "DISSAVED ~ AGE_C + AGE_C2",
            'M3L_linear_age_cov' : f"DISSAVED ~ AGE_C + {cov}",
            'M3_primary'         : f"DISSAVED ~ AGE_C + AGE_C2 + {cov}",
            'M4_age_factor'      : "DISSAVED ~ C(AGE)",
            'M4f_age_factor_cov' : f"DISSAVED ~ C(AGE) + {cov}",
            'M5_income_terciles' : f"DISSAVED ~ AGE_C + AGE_C2 + C(GEND_M) + C(INC_T) + BLACK + HISPANIC{imp}",
            'M6_ageXgender'      : f"DISSAVED ~ (AGE_C + AGE_C2)*C(GEND_M) + {cov}"}, cov

def fit(f, d):
    r = smf.logit(f, data=d).fit(disp=0, method='newton', maxiter=200)
    if not r.mle_retvals['converged']:
        r = smf.logit(f, data=d).fit(disp=0, maxiter=500)
    assert r.mle_retvals['converged'], f
    return r
def lr(a, b_):
    st = 2*(b_.llf - a.llf); d = int(b_.df_model - a.df_model)
    return st, d, (stats.chi2.sf(st, d) if d > 0 else np.nan)
def coefs(r):
    ci = r.conf_int()
    return pd.DataFrame({'coef': r.params, 'se': r.bse, 'z': r.tvalues, 'p': r.pvalues,
                         'OR': np.exp(r.params), 'OR_lo': np.exp(ci[0]), 'OR_hi': np.exp(ci[1])}).round(4)
def vif(r):
    X = np.asarray(r.model.exog, float); out = {}
    for i, nm in enumerate(r.model.exog_names):
        if nm == 'Intercept': continue
        o = [j for j in range(X.shape[1]) if j != i]
        res = X[:, i] - X[:, o] @ np.linalg.lstsq(X[:, o], X[:, i], rcond=None)[0]
        out[nm] = round(float(X[:, i].var()/res.var()), 2)
    return out
def design_for(r, age, d, gender=None):
    """design row: age term set to `age`, every covariate held at its sample mean."""
    gm = d.GEND_M.mean() if gender is None else gender
    means = {'INCOME_LOG': d.INCOME_LOG.mean(), 'BLACK': d.BLACK.mean(), 'HISPANIC': d.HISPANIC.mean(),
             'IMP': d.IMP.mean(), 'C(GEND_M)[T.1]': gm, 'GEND_M': gm}
    def base_val(nm):
        if nm == 'Intercept': return 1.0
        if nm == 'AGE_C':     return age - AGE_M
        if nm == 'AGE_C2':    return (age - AGE_M)**2
        if nm == 'AGE':       return float(age)
        if nm.startswith('C(AGE)[T.'): return 1.0 if float(nm[9:-1]) == age else 0.0
        return means.get(nm, 0.0)
    return np.array([np.prod([base_val(p) for p in nm.split(':')]) for nm in r.model.exog_names])
def prob_ci(r, x, z=1.959964):
    """delta method; CI built on the linear-predictor scale then mapped through expit."""
    b = np.asarray(r.params); V = np.asarray(r.cov_params()); eta = float(x @ b)
    se = float(np.sqrt(x @ V @ x)); return 100*expit(eta), 100*expit(eta-z*se), 100*expit(eta+z*se)
def curve(r, ages, d):
    return pd.DataFrame([(a,)+prob_ci(r, design_for(r, a, d)) for a in ages],
                        columns=['AGE','pred_pct','ci_lo','ci_hi']).round(2)
def turning(r):
    b1 = r.params['AGE_C']; b2 = r.params['AGE_C2']; V = np.asarray(r.cov_params()); idx = list(r.params.index)
    tp = AGE_M - b1/(2*b2); gg = np.zeros(len(idx))
    gg[idx.index('AGE_C')] = -1/(2*b2); gg[idx.index('AGE_C2')] = b1/(2*b2**2)
    se = float(np.sqrt(gg @ V @ gg)); return tp, tp-1.96*se, tp+1.96*se, b2
def endpoint_change(r, d, a0=24, a1=32):
    b = np.asarray(r.params); V = np.asarray(r.cov_params())
    x0, x1 = design_for(r, a0, d), design_for(r, a1, d); p0, p1 = expit(x0@b), expit(x1@b)
    gr = p1*(1-p1)*x1 - p0*(1-p0)*x0; se = 100*float(np.sqrt(gr @ V @ gr))
    return 100*p0, 100*p1, 100*(p1-p0), se

# ---------------- 4. models ----------------
def run(d, tag):
    M, cov = build(d); R = {k: fit(f, d) for k, f in M.items()}
    P("\n" + "#"*96); P(f"### {tag}   n = {int(R['M3_primary'].nobs)}"); P("#"*96)
    for k, r in R.items():
        P(f"\n--- {k}: n={int(r.nobs)} llf={r.llf:.3f} k={int(r.df_model)} pseudoR2={r.prsquared:.4f} AIC={r.aic:.1f}")
        P(coefs(r).to_string())
    P("\n--- LR tests:")
    for a, bb, lab in [('M1_linear_age','M2_quad_age','quadratic age, unadjusted'),
                       ('M2_quad_age','M4_age_factor','factor age vs quadratic, unadjusted'),
                       ('M3L_linear_age_cov','M3_primary','QUADRATIC AGE | COVARIATES  <-- key concavity test'),
                       ('M3_primary','M4f_age_factor_cov','factor age vs quadratic | covariates <-- adequacy'),
                       ('M1_linear_age','M4_age_factor','factor vs linear age, unadjusted')]:
        st, dd, p = lr(R[a], R[bb]); P(f"  {lab}: LR={st:.3f} df={dd} p={p:.5g}")
    st, dd, p = lr(fit(f"DISSAVED ~ {cov}", d), R['M3_primary'])
    P(f"  joint AGE_C+AGE_C2 = 0 in primary: LR={st:.3f} df={dd} p={p:.5g}")
    P("--- VIFs (primary): " + str(vif(R['M3_primary'])))
    ages = [24, 26, 28, 30, 32]
    for key in ['M3_primary','M3L_linear_age_cov','M2_quad_age','M4f_age_factor_cov']:
        P(f"\n--- Predicted P(DISSAVED) at ages {ages}, {key} (covariates at sample means):")
        P(curve(R[key], ages, d).to_string(index=False))
    for key in ['M3_primary','M2_quad_age']:
        t = turning(R[key])
        P(f"--- Turning point {key}: AGE*={t[0]:.2f} (95% CI {t[1]:.2f}, {t[2]:.2f}), b2={t[3]:+.5f}, support [24,32]")
    for key in ['M3_primary','M3L_linear_age_cov']:
        p0, p1, dp, se = endpoint_change(R[key], d)
        P(f"--- 24 -> 32 change, {key}: {p0:.2f}% -> {p1:.2f}% = {dp:+.2f} pp (SE {se:.2f}; 95% CI {dp-1.96*se:+.2f} to {dp+1.96*se:+.2f})")
    P("\n--- Average marginal effects, M3_primary:\n" + R['M3_primary'].get_margeff(at='overall').summary_frame().round(4).to_string())
    P("\n--- Per-year discrete change, M3_primary:")
    for a in range(24, 32):
        q1 = expit(design_for(R['M3_primary'], a, d) @ np.asarray(R['M3_primary'].params))
        q2 = expit(design_for(R['M3_primary'], a+1, d) @ np.asarray(R['M3_primary'].params))
        P(f"   {a}->{a+1}: {100*q1:.2f}% -> {100*q2:.2f}%  ({100*(q2-q1):+.2f} pp)")
    P("\n--- Age x gender (M6) predicted curve:")
    for gv, lab in [(0,'FEMALE'),(1,'MALE')]:
        rows = [(a,)+prob_ci(R['M6_ageXgender'], design_for(R['M6_ageXgender'], a, d, gv)) for a in ages]
        P(f"   {lab}:\n" + pd.DataFrame(rows, columns=['AGE','pred_pct','lo','hi']).round(2).to_string(index=False))
    P("--- M6 interaction p-values: " + str({k: round(float(R['M6_ageXgender'].pvalues[k]), 4)
        for k in R['M6_ageXgender'].pvalues.index if ':' in k}))
    lpm = smf.ols(f"DISSAVED ~ AGE_C + AGE_C2 + {cov}", data=d).fit(cov_type='HC1')
    P("--- LPM (HC1) sensitivity:\n" + lpm.params.to_frame('coef').assign(se=lpm.bse, p=lpm.pvalues).round(4).to_string())
    return R

P("\n=== 3/4. LOGIT MODELS (M1-M6) ===")
Rf = run(df, "PRIMARY: full sample, INCOME_MEANIMPUTED indicator as covariate")
Rd = run(df[df.IMP == 0], "DECISIVE ROBUSTNESS: mean-imputed INCOME rows dropped")

# ---------------- 5. is the age gradient an artefact of the income-imputed subgroup? ----------------
P("\n=== 5. COMPOSITION DECOMPOSITION AND AGE x INCOME-GROUP INTERACTION ===")
share = df.groupby('agebin', observed=True).IMP.mean()
r_imp = df[df.IMP == 1].groupby('agebin', observed=True).DISSAVED.mean()
r_re  = df[df.IMP == 0].groupby('agebin', observed=True).DISSAVED.mean()
obs   = df.groupby('agebin', observed=True).DISSAVED.mean(); w = df.IMP.mean()
tab = pd.DataFrame({'obs_pct': 100*obs, 'share_IMP_pct': 100*share, 'rate_IMP_pct': 100*r_imp,
                    'rate_real_income_pct': 100*r_re, 'cf_pct': 100*(w*r_imp + (1-w)*r_re)})
tab['obs_change_pp']  = (tab.obs_pct - tab.obs_pct.iloc[0]).round(2)
tab['cf_change_pp']   = (tab.cf_pct - tab.cf_pct.iloc[0]).round(2)
tab['composition_pp'] = (tab.obs_change_pp - tab.cf_change_pp).round(2)
P(tab.round(2).to_string())
P("raw 24-25 -> 30-32 change %.2f pp; holding the imputed-income share at %.2f%%: %.2f pp  =>  %.0f%% of the raw gradient is composition"
  % (tab.obs_change_pp.iloc[-1], 100*w, tab.cf_change_pp.iloc[-1], 100*tab.composition_pp.iloc[-1]/tab.obs_change_pp.iloc[-1]))
base = "C(GEND_M) + INCOME_LOG + BLACK + HISPANIC + IMP"
m0 = fit(f"DISSAVED ~ {base} + AGE_C", df); m1 = fit(f"DISSAVED ~ {base} + AGE_C + AGE_C:IMP", df)
st, dd, pval = lr(m0, m1)
P(f"\nAGE x INCOME-group interaction: LR={st:.2f} df={dd} p={pval:.3g}")
P(coefs(m1).to_string())
V = np.asarray(m1.cov_params()); idx = list(m1.params.index); gg = np.zeros(len(idx))
gg[idx.index('AGE_C')] = 1; gg[idx.index('AGE_C:IMP')] = 1
bb = m1.params['AGE_C'] + m1.params['AGE_C:IMP']; se = float(np.sqrt(gg @ V @ gg))
P(f"per-year logit slope: genuine-income group {m1.params['AGE_C']:+.4f} (p={m1.pvalues['AGE_C']:.3f}) ; "
  f"imputed-income group {bb:+.4f} (SE {se:.4f}, OR/yr {np.exp(bb):.3f})")
sub = {}
for gv, lab in [(0,'genuine INCOME'), (1,'INCOME == 47.279 (inferred imputed)')]:
    s = df[df.IMP == gv].copy()
    f_ = "DISSAVED ~ AGE_C + AGE_C2 + C(GEND_M) + BLACK + HISPANIC" + (" + INCOME_LOG" if gv == 0 else "")
    r = fit(f_, s); p0, p1, dp, sse = endpoint_change(r, s); sub[gv] = (r, p0, p1, dp, sse)
    P(f"within {lab} only (n={int(r.nobs)}): p(24)={p0:.2f}% p(32)={p1:.2f}%, change {dp:+.2f} pp (SE {sse:.2f}); "
      f"AGE_C p={r.pvalues['AGE_C']:.4g}, AGE_C2 p={r.pvalues['AGE_C2']:.4g}")

# ---------------- 6. relation summary ----------------
mp, mlp = Rf['M3_primary'], Rf['M3L_linear_age_cov']
p0L, p1L, dpL, seL = endpoint_change(mlp, df)
p0Q, p1Q, dpQ, seQ = endpoint_change(mp, df)
p0D, p1D, dpD, seD = endpoint_change(Rd['M3_primary'], df[df.IMP == 0])
tp = turning(mp); tq = turning(Rf['M2_quad_age'])
stJ, ddJ, pJ = lr(fit(f"DISSAVED ~ {'C(GEND_M) + INCOME_LOG + BLACK + HISPANIC + IMP'}", df), mp)
stq, ddq, pq = lr(Rf['M3L_linear_age_cov'], mp)
stq0, ddq0, pq0 = lr(Rf['M1_linear_age'], Rf['M2_quad_age'])
stf, ddf, pf = lr(mp, Rf['M4f_age_factor_cov'])
rows = [
 ('AGE -> DISSAVED (primary, full sample)', 'negative and close to linear',
  f"OR/yr {np.exp(mlp.params['AGE_C']):.4f}; AME {100*mlp.get_margeff(at='overall').summary_frame()['dy/dx']['AGE_C']:+.2f} pp/yr",
  f"predicted {p0L:.2f}% at 24 -> {p1L:.2f}% at 32 = {dpL:+.2f} pp (95% CI {dpL-1.96*seL:+.2f},{dpL+1.96*seL:+.2f})"),
 ('AGE -> DISSAVED (shape / AGE_2)', 'concavity not supported once covariates enter',
  f"AGE_C2 p={mp.pvalues['AGE_C2']:.3f}; LR(age^2|cov)={stq:.2f} p={pq:.3f}; unadjusted LR={stq0:.2f} p={pq0:.3f}",
  f"adjusted turning point {tp[0]:.1f} (CI {tp[1]:.1f},{tp[2]:.1f}) sits at the left edge of support; unadjusted {tq[0]:.1f} (CI {tq[1]:.1f},{tq[2]:.1f}); factor-age vs quadratic LR p={pf:.2f}"),
 ('AGE -> DISSAVED (drop inferred-imputed rows)', 'no detectable age effect',
  f"AGE_C {Rd['M3_primary'].params['AGE_C']:+.4f} (p={Rd['M3_primary'].pvalues['AGE_C']:.3f})",
  f"predicted {p0D:.2f}% at 24 -> {p1D:.2f}% at 32 = {dpD:+.2f} pp (95% CI {dpD-1.96*seD:+.2f},{dpD+1.96*seD:+.2f})"),
 ('AGE x INCOME-group interaction', 'decisive: gradient lives in the imputed-income group',
  f"LR={st:.1f} df={dd} p={pval:.2g}; slope {m1.params['AGE_C']:+.4f} vs {bb:+.4f} (OR/yr {np.exp(bb):.3f})",
  f"within imputed group p(24)={sub[1][1]:.1f}% -> p(32)={sub[1][3]+sub[1][1]:.1f}% ({sub[1][3]:+.1f} pp); genuine group {sub[0][3]:+.2f} pp (ns)"),
 ('INCOME -> DISSAVED', 'positive controlling the imputed-income indicator; non-monotone unadjusted',
  f"coef {mp.params['INCOME_LOG']:+.4f} per log unit (p={mp.pvalues['INCOME_LOG']:.2g})",
  "unadjusted terciles 23.5 / 28.7 / 18.5%"),
 ('INCOME_MEANIMPUTED -> DISSAVED', 'strongly negative (the composition driver)',
  f"coef {mp.params['IMP']:+.4f}, OR {np.exp(mp.params['IMP']):.3f}",
  f"AME {100*mp.get_margeff(at='overall').summary_frame()['dy/dx']['IMP']:+.1f} pp; 11.2% vs 29.2% observed"),
 ('GENDER -> DISSAVED', 'males less likely to dissave', f"coef {mp.params['C(GEND_M)[T.1]']:+.4f} (p={mp.pvalues['C(GEND_M)[T.1]']:.4f})",
  f"AME {100*mp.get_margeff(at='overall').summary_frame()['dy/dx']['C(GEND_M)[T.1]']:+.1f} pp; 25.2% F vs 21.9% M; age x gender interactions ns"),
 ('BLACK -> DISSAVED', 'more likely', f"coef {mp.params['BLACK']:+.4f} (p={mp.pvalues['BLACK']:.2g})",
  f"AME {100*mp.get_margeff(at='overall').summary_frame()['dy/dx']['BLACK']:+.1f} pp"),
 ('HISPANIC -> DISSAVED', 'more likely', f"coef {mp.params['HISPANIC']:+.4f} (p={mp.pvalues['HISPANIC']:.3f})",
  f"AME {100*mp.get_margeff(at='overall').summary_frame()['dy/dx']['HISPANIC']:+.1f} pp"),
 ('AGE -> SAMESAVE / net saving', 'flat-or-no-savings share falls, net-saving share rises with age',
  "descriptive only", "net save 30.9 / 32.0 / 39.0 / 49.5% and same-or-none 44.4 / 42.0 / 37.4 / 29.8% across age bins"),
 ('AGE <-> AGE_2', 'exact functional dependency, not two independent variables',
  "AGE_2 = AGE^2 exactly; r = 0.999; modelled as centred AGE_C, AGE_C2", f"VIFs {vif(mp)['AGE_C']} / {vif(mp)['AGE_C2']}"),
 ('DISSAVED <-> SAMESAVE', 'mutually exclusive indicators of one 3-state outcome',
  "0 rows with both = 1", "dissave 23.6% / same-or-no savings 37.7% / net save 38.7%"),
]
rel = pd.DataFrame(rows, columns=['relation','finding','estimate','detail'])
rel.to_csv('results/relations.csv', index=False)
P("\n=== 6. RELATION SUMMARY (results/relations.csv) ===\n" + rel.to_string(index=False))
OUT.close()
print("wrote results/model_report.txt and results/relations.csv")

# ---------------- 8. bootstrap validation of the headline delta-method intervals ----------------
# (appended after the main report; opens the report in append mode)
lines = []
rng = np.random.default_rng(20261025)
specs = [('primary full sample', "DISSAVED ~ AGE_C + C(GEND_M) + INCOME_LOG + BLACK + HISPANIC + IMP", df, Rf['M3L_linear_age_cov']),
         ('drop inferred-imputed rows', "DISSAVED ~ AGE_C + C(GEND_M) + INCOME_LOG + BLACK + HISPANIC", df[df.IMP == 0], Rd['M3L_linear_age_cov'])]
lines.append("\n=== 7. BOOTSTRAP CHECK (nonparametric, 150 reps) of the 24 -> 32 predicted change ===")
for lab, f_, d_, Rref in specs:
    diffs = []
    for i in range(150):
        bs = d_.sample(len(d_), replace=True, random_state=int(rng.integers(10**9)))
        try:
            rb = smf.logit(f_, data=bs).fit(disp=0, maxiter=300)
        except Exception:
            continue
        if not rb.mle_retvals['converged']:
            continue
        diffs.append(endpoint_change(rb, d_)[2])
    arr = np.array(diffs); ref = endpoint_change(Rref, d_)
    lines.append(f"  {lab}: delta-method {ref[2]:+.2f} pp (SE {ref[3]:.2f}) | bootstrap mean {arr.mean():+.2f}, "
                 f"SD {arr.std():.2f}, percentile 95% CI [{np.percentile(arr,2.5):+.2f}, {np.percentile(arr,97.5):+.2f}] ({len(arr)} reps)")
with open('results/model_report.txt', 'a') as fh:
    fh.write("\n".join(lines) + "\n")
print("\n".join(lines))
