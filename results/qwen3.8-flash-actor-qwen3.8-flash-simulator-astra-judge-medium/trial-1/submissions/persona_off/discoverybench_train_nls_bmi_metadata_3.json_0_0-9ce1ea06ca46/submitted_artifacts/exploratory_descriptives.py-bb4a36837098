import pandas as pd, numpy as np
from math import sqrt
pd.set_option('display.width', 220)
df = pd.read_csv('../data/nls_bmi_processed.csv')
bins=[24,26,28,30,33]; lab=['24-25','26-27','28-29','30-32']
df['agebin']=pd.cut(df.AGE,bins=bins,labels=lab,right=False)

print("=== DISSAVED rate (pct) by age x gender ===")
p = df.pivot_table(index='AGE',columns='GENDER',values='DISSAVED',aggfunc='mean')*100
n = df.pivot_table(index='AGE',columns='GENDER',values='DISSAVED',aggfunc='size')
print(p.round(2)); print("counts:"); print(n)

print("\n=== Saving-status composition by age bin (%) ===")
df['status']=np.where(df.DISSAVED==1,'dissave',np.where(df.SAMESAVE==1,'same/none','save'))
print(pd.crosstab(df.agebin, df.status, normalize='index').mul(100).round(2))
print(pd.crosstab(df.agebin, df.status))

print("\n=== youngest (24-25) vs oldest (31-32) ===")
a=df[df.AGE<=25].DISSAVED; c=df[df.AGE>=31].DISSAVED
p1,p2=a.mean(),c.mean(); se=sqrt(p1*(1-p1)/len(a)+p2*(1-p2)/len(c))
print('young n=%d %.2f%% | old n=%d %.2f%% | diff=%.2f pp  z=%.2f'%(len(a),100*p1,len(c),100*p2,100*(p1-p2),(p1-p2)/se))

print("\n=== Nonlinearity check (descriptive, unadjusted): bin rates with 95% CI ===")
for name,s in df.groupby('agebin',observed=True).DISSAVED:
    p=s.mean(); se=sqrt(p*(1-p)/len(s))
    print(f"{name}: n={len(s)} rate={100*p:.2f}% CI[{100*(p-1.96*se):.2f},{100*(p+1.96*se):.2f}]")
# simple quadratic contrast on 4 bin rates (equal-ish weights), descriptive only
r=[df[df.agebin==l].DISSAVED.mean() for l in lab]
print("bin rates:", [round(100*x,2) for x in r], " quadratic contrast (+,-,-,+)=", round(100*(r[0]-r[1]-r[2]+r[3]),2), "pp")

print("\n=== Age gradient within gender and income strata (dissave %) ===")
df['inc_grp']=pd.qcut(df.INCOME.rank(method='first'),3,labels=['low inc','mid inc','high inc'])
print((df.pivot_table(index='inc_grp',columns='agebin',values='DISSAVED',aggfunc='mean',observed=True)*100).round(2))
print((df.pivot_table(index='GENDER',columns='agebin',values='DISSAVED',aggfunc='mean')*100).round(2))

print("\n=== Overall dissave rate by gender / race ===")
print(df.groupby('GENDER').DISSAVED.agg(['size','mean']).round(4))
print(df.groupby(['BLACK']).DISSAVED.agg(['size','mean']).round(4))
print(df.groupby(['HISPANIC']).DISSAVED.agg(['size','mean']).round(4))

print("\n=== INCOME vs DISSAVED (terciles) & INCOME vs AGE (spearman) ===")
print(df.groupby('inc_grp',observed=True).DISSAVED.agg(['size','mean']).round(4))
print("spearman AGE~INCOME:", df[['AGE','INCOME']].corr(method='spearman').iloc[0,1].round(4))
print("spearman INCOME~DISSAVED:", df[['INCOME','DISSAVED']].corr(method='spearman').iloc[0,1].round(4))
print("dissave rate among INCOME==0:", df[df.INCOME==0].DISSAVED.agg(['size','mean']).round(4).to_dict())
print("dissave rate at modal INCOME 47.279:", df[np.isclose(df.INCOME,47.279064)].DISSAVED.agg(['size','mean']).round(4).to_dict())
print("\nAGE x INCOME-capped crosstab (modal value):")
print(pd.crosstab(df.agebin, np.isclose(df.INCOME,47.279064), normalize='index').mul(100).round(2))
