import pandas as pd, numpy as np
pd.set_option('display.width', 200)
df = pd.read_csv('data/nls_bmi_processed.csv')
print("SHAPE:", df.shape)
print("\nDTYPES:\n", df.dtypes)
print("\nMISSING (count, pct):")
m = pd.DataFrame({'n_missing': df.isna().sum(), 'pct': (df.isna().mean()*100).round(2)})
print(m)
print("\nHEAD:\n", df.head())
print("\nDESCRIBE ALL:\n", df.describe(include='all').T)
print("\nUnique GENDER:", df.GENDER.unique().tolist(), "counts:\n", df.GENDER.value_counts(dropna=False))
for c in ['DISSAVED','SAMESAVE','BLACK','HISPANIC']:
    print(f"\n{c} value counts:\n", df[c].value_counts(dropna=False))
    print(f"{c} unique:", sorted(df[c].dropna().unique().tolist()))
print("\nMARGINAL DISSAVED rate:", df.DISSAVED.mean(), " n=", int(df.DISSAVED.notna().sum()))
print("\nAGE_2 == AGE**2 check:", np.allclose(df.AGE_2, df.AGE**2, equal_nan=True),
      " max abs diff:", np.nanmax(np.abs(df.AGE_2 - df.AGE**2)))
print("\nCorrelations (numeric):\n", df[['AGE','AGE_2','INCOME','BMI','DISSAVED','SAMESAVE','BLACK','HISPANIC']].corr(numeric_only=True).round(3))
# INCOME specifics
inc = df.INCOME
print("\nINCOME: min", inc.min(), "n<=0:", (inc<=0).sum(), "n==0:", (inc==0).sum(), "n<0:", (inc<0).sum())
print("INCOME quantiles:\n", inc.quantile([0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1]))
print("INCOME skew:", inc.skew(), " log(1+inc) skew (inc>=0 only):", np.log1p(inc[inc>=0]).skew())
print("\nAGE quantiles:\n", df.AGE.quantile([0,.01,.05,.1,.25,.5,.75,.9,.95,.99,1]))
print("AGE n<20 or >60:", ((df.AGE<20)|(df.AGE>60)).sum(), " min,max:", df.AGE.min(), df.AGE.max())
print("AGE integer?", (df.AGE == df.AGE.round()).all())
print("\nBMI: min/max, n<12, n>60:", df.BMI.min(), df.BMI.max(), (df.BMI<12).sum(), (df.BMI>60).sum())
