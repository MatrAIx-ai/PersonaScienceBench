"""
NLSY79: savings-based present-orientation proxy vs BMI.
STEP 1 - unit decodes, sentinel/QC handling with counts at every cut, variable construction.
Outputs analysis/analytic.csv ; prints QC trim table + completeness/attrition tables.
"""
import pandas as pd, numpy as np

RAW='data/nls_raw.csv'; df=pd.read_csv(RAW); N0=len(df)
print(f"RAW rows = {N0}, cols = {df.shape[1]}  (one row per respondent; ID nunique = {df.iloc[:,0].nunique()})")

C={'h81':'Height of respondent, 1981','h85':'Height of respondent, 1985',
 'w81':'Weight of respondent, 1981','w89':'Weight of respondent, 1989','w92':'Weight of respondent, 1992',
 'sv':'Was more money put into or taken out of R/spouse savings since last interview, 1989',
 'pi':'Net amount respondent/spouse put into savings since last interview, 1989',
 'to':'Net amount respondent/spouse took out of savings since last interview, 1989',
 'inc79':'Total net family income, previous calendar year, 1979','inc85':'Total net family income, previous calendar year, 1985',
 'inc89':'Total net family income, previous calendar year, 1989','wth85':'Family net wealth, 1985','wth90':'Family net wealth, 1990','wth96':'Family net wealth, 1996 (key data point)',
 'age79':'Age of respondent, 1979','age81':'Age of respondent at interview date, 1981','age89':'Age of respondent at interview date, 1989',
 'mom':"Highest grade completed by respondent's mother, 1979",'dad':"Highest grade completed by respondent's father, 1979",
 'occ':'Occupation of adult male in household at age 14, 1979','sex':'Sex of respondent, 1979','race':'Racial/ethnic cohort, 1979','fam':'Family size, 1979',
 'rk':'Rank in class last year attended at this school, 1981','cs':'Number of students in class last year attended at this school, 1981',
 'asv_ar':'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981','asv_wk':'ASVAB - Word Knowledge Z Score (rounded), 1981',
 'asv_pc':'ASVAB - Paragraph Comprehension Z Score (rounded), 1981','asv_mk':'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'}
d=pd.DataFrame({'ID':df['ID# (range 1-12686) 1979']})
for k,v in C.items(): d[k]=df[v]

log=[]
def note(rule,n): log.append((rule,int(n))); print(f"  [sentinel/QC] {rule}: {int(n)} values affected")

# ---------------- UNIT DECODES (pre-registered) ----------------
# height 1981 = feet*100 + inches ; height 1985 = plain inches. weights = POUNDS.
d['h81_in']=np.where(d.h81.notna(),(d.h81//100)*12+(d.h81%100),np.nan)
d['h85_in']=d.h85
note('height-1981 coding violation, (v mod 100) > 11 (cannot be feet+inches)',((d.h81%100)>11).sum())
d['height_in']=d[['h81_in','h85_in']].mean(axis=1)                    # person-mean (primary)
d['height_in_latest']=d.h85_in.fillna(d.h81_in)                       # latest-available (robustness)
for y in ['81','89','92']: d[f'w{y}_kg']=d[f'w{y}']*0.45359237

# ---- value-level implausible-value invalidation (missing, NOT row deletion) ----
def invalidate(col,mask,label):
    n=int(mask.sum()); note(f'{label} -> {col} set missing',n)
    d.loc[mask,col]=np.nan; return n
invalidate('h81_in',(d.h81_in<52)|(d.h81_in>80),'decoded height 1981 outside 52-80 in')
invalidate('h85_in',(d.h85_in<52)|(d.h85_in>80),'height 1985 outside 52-80 in')
invalidate('w81',d.w81.notna()&~d.w81.between(70,500),'weight 1981 outside 70-500 lb')
invalidate('w89',d.w89.notna()&~d.w89.between(70,500),'weight 1989 outside 70-500 lb')
invalidate('w92',d.w92.notna()&~d.w92.between(50,500),'weight 1992 outside 50-500 lb')
d['height_in']=d[['h81_in','h85_in']].mean(axis=1)
d['height_in_latest']=d.h85_in.fillna(d.h81_in)
hgt_m=d.height_in*0.0254
for y in ['81','89','92']: d[f'bmi{y}']=d[f'w{y}_kg']/hgt_m**2
for y in ['81','89','92']:
    invalidate(f'bmi{y}',d[f'bmi{y}'].notna()&~d[f'bmi{y}'].between(12,70),f'BMI {y} outside 12-70 kg/m2')
d['obese89']=(d.bmi89>=30).astype(float).where(d.bmi89.notna())
d['obese92']=(d.bmi92>=30).astype(float).where(d.bmi92.notna())

# ---------------- SAVINGS PROXY ----------------
note('net-amount PUT-IN == 8,192,797 top-code -> missing',(d.pi==8192797).sum())
note('net-amount TAKEN-OUT == 9,999,996 sentinel -> missing',(d.to==9999996).sum())
d.loc[d.pi==8192797,'pi']=np.nan; d.loc[d.to==9999996,'to']=np.nan
d['pi_pos']=d.pi.where(d.sv==1); d['to_pos']=d.to.where(d.sv==2)   # keep item-nonresponse MISSING (not 0)
# STRUCTURAL ZEROS: code 3 (no change) and code 4 (no savings) => net flow $0 by construction.
d['net_save']=np.where(d.sv.isin([3,4]),0.0,np.where(d.sv==1,d.pi_pos,np.where(d.sv==2,-d.to_pos,np.nan)))
# income 1989 top-code 1,057,448 (n=167) treated as censored, then winsorised (not deleted)
tc=(d.inc89==1057448).sum(); note('family income 1989 == 1,057,448 top-code (winsorised, not deleted)',tc)
d['inc89_w']=d.inc89.clip(upper=d.inc89[d.inc89<1057448].quantile(.99))
ratio=d.net_save/d.inc89_w
lo,hi=ratio.quantile([.01,.99]); d['save_ratio']=ratio.clip(lo,hi)
d['save_ratio_raw']=ratio
print(f"  net-saving intensity (net_save / 1989 family income): non-missing = {d.save_ratio.notna().sum()},"
      f" winsor bounds ({lo:.4f}, {hi:.4f})")
print("  savings direction shares among non-missing (%):",
      (100*d.sv.value_counts(normalize=True)).round(2).to_dict(),
      "| n net_save==0 structural:",int(((d.sv.isin([3,4]))).sum()),
      "| n net_save missing though sv present (item non-response, kept missing):",int((d.sv.isin([1,2])&d.net_save.isna()).sum()))

# exposures
d['tp_ord']=d.sv.map({1:0,3:1,2:2,4:3})          # 0 saver < 1 no change < 2 dissaver < 3 NO SAVINGS
d['tp_high']=d.sv.isin([2,4]).astype(float).where(d.sv.notna())
d['tp_cat3']=d.sv.map({1:0,3:1,2:2})             # sensitivity A: drop 'no savings'
d['D_dissav']=(d.sv==2).astype(float).where(d.sv.notna())
d['D_nochg']=(d.sv==3).astype(float).where(d.sv.notna())
d['D_nosav']=(d.sv==4).astype(float).where(d.sv.notna())
d['sv_lbl']=d.sv.map({1:'1 put more in (saver)',2:'2 took more out (dis-saver)',3:'3 no change',4:'4 no savings'})

# ---------------- COVARIATES ----------------
d['asvab']=d[['asv_ar','asv_wk','asv_pc','asv_mk']].mean(axis=1)
d['asvab_z']=(d.asvab-d.asvab.mean())/d.asvab.std()
d['log_inc89']=np.log1p(d.inc89_w.clip(lower=0))
d['asinh_wth85']=np.arcsinh(d.wth85/1000.0)
d['occ_major']=(d.occ//100)
d['pct_rank']=1-d.rk/d.cs
d['race_lbl']=d.race.map({1:'Black',2:'Hispanic',3:'Non-black Non-hisp'})
d['sex_lbl']=d.sex.map({1:'Male',2:'Female'})
d['dw81_89']=d.w89-d.w81; d['dw89_92']=d.w92-d.w89; d['dbmi89_92']=d.bmi92-d.bmi89
d['qc_ok']=d[['w81','w89','w92','bmi81','bmi89','bmi92','h81_in','h85_in']].notna().all(axis=1)  # only a flag
d.to_csv('analysis/analytic.csv',index=False)

# ---------------- DESCRIPTIVES ----------------
print("\n=== TABLE 1: BMI by savings category (raw, all rows with data) ===")
t=(d.groupby('sv_lbl').agg(n_bmi89=('bmi89','size'),mean_bmi89=('bmi89','mean'),median_bmi89=('bmi89','median'),
   sd_bmi89=('bmi89','std'),mean_w89_lb=('w89','mean'),obese_pct=('obese89','mean'),n_bmi92=('bmi92','size'),
   mean_bmi92=('bmi92','mean'),median_bmi92=('bmi92','median'),obese92_pct=('obese92','mean'),
   median_wth85=('wth85','median'),median_inc89=('inc89','median'),mean_age89=('age89','mean'))
   .round(2)); print(t.to_string())
print("\n--- mean BMI1989 by savings category x sex ---")
print(d.pivot_table(index='sv_lbl',columns='sex_lbl',values='bmi89',aggfunc='mean').round(2).to_string())
print("--- n by savings category x sex ---")
print(d.pivot_table(index='sv_lbl',columns='sex_lbl',values='bmi89',aggfunc='size').to_string())
print("\n=== TABLE 2: monotonicity check, Spearman/Pearson of BMI vs exposure (unadjusted) ===")
from scipy import stats
for outc in ['bmi89','bmi92']:
    for expc,lbl in [('tp_ord','TP ordinal (0-3)'),('tp_high','TP_high binary'),('save_ratio','net-saving/income (low=high TP)')]:
        s=d[[outc,expc]].dropna()
        pr=stats.pearsonr(s[outc],s[expc]); sr=stats.spearmanr(s[outc],s[expc])
        print(f"  {outc} x {lbl:32s} n={len(s):6d}  r={pr[0]:+.4f} (p={pr[1]:.2g})  rho={sr.statistic:+.4f} (p={sr.pvalue:.2g})")
    for sx,lbl in [('Male','Male'),('Female','Female')]:
        s=d[(d.sex_lbl==sx)][[outc,'tp_ord']].dropna()
        print(f"    {outc} x TP ordinal [{lbl:6s}] n={len(s):6d} r={stats.pearsonr(s[outc],s.tp_ord)[0]:+.4f} rho={stats.spearmanr(s[outc],s.tp_ord).statistic:+.4f}")
print("\n=== TABLE 3: completeness / attrition ===")
for k,v in {'height_1981':'h81','weight_1981':'w81','height_1985':'h85','weight_1989':'w89','savings_1989':'sv',
            'net_amount_put_in':'pi','net_amount_took_out':'to','income_1989':'inc89','wealth_1985':'wth85',
            'wealth_1990':'wth90','weight_1992':'w92','asvab_composite':'asvab','mom_edu':'mom','dad_edu':'dad','father_occ':'occ','pct_class_rank':'pct_rank'}.items():
    print(f"  {k:20s} n={int(d[v].notna().sum()):6d}  {100*d[v].notna().mean():5.1f}%")
b=d[d.sv.notna()&d.bmi89.notna()]
print("\n  1992 follow-up among the 1989 analytic pool (n=%d), by cohort:"%len(b))
print(b.assign(f=b.w92.notna()).groupby('race_lbl')['f'].agg(n='size',pct_present=lambda s:round(100*s.mean(),1)).to_string())
print("\n  cohort composition, savings-1989 wave vs weight-1992 wave (%):")
print(pd.DataFrame({'1989_savings_wave':(100*d.loc[d.sv.notna(),'race_lbl'].value_counts(normalize=True)).round(1),
                    '1992_weight_wave':(100*d.loc[d.w92.notna(),'race_lbl'].value_counts(normalize=True)).round(1)}).to_string())
print("\n  savings-wave availability by sex:",(100*d.groupby('sex_lbl')['sv'].apply(lambda s:s.notna().mean())).round(1).to_dict())
print("  savings-wave availability by cohort:",(100*d.groupby('race_lbl')['sv'].apply(lambda s:s.notna().mean())).round(1).to_dict())
print("\nSENTINEL/QC LOG:")
for r,n in log: print(f"   {r}: {n}")
