"""
STEP 2 - estimation. Pre-registered expectation: POSITIVE sign (higher present-orientation -> higher BMI).
Every model reports n, unadjusted and fully-adjusted coefficient with SE/CI/p, and whether the sign matches.
Exposure = SAVINGS-BASED PRESENT-ORIENTATION PROXY (1989 savings-direction item), not a measured discount rate.
"""
import pandas as pd, numpy as np, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats
d=pd.read_csv('analysis/analytic.csv')
pd.set_option('display.width',250)

CORE=['age89','sex','race','mom','asvab_z']                      # core controls (listwise)
FIN =['log_inc89','asinh_wth85']                                  # financial controls (attrition-heavy)
EXT =['dad','occ_major','fam']                                    # family-background add-ons
def ctrl(names): return [c for c in names]

# ---------------- RETENTION LADDER ----------------
def ladder(outcome,exp='tp_ord',extra=()):
    rows=[]; base=d[d[exp].notna()&d[outcome].notna()]; rows.append((f'{outcome} & {exp} available',len(base)))
    cur=base
    for lab,names in [('+ core controls (age89, sex, race, mom-edu, ASVAB-Z)',CORE),
                      ('+ financial controls (log income89, asinh wealth85)',FIN),
                      ('+ family add-ons (dad-edu, father-occ, family size)',EXT)]:
        cur=cur.dropna(subset=names); rows.append((lab,len(cur)))
    for e in extra:
        cur=cur.dropna(subset=[e]); rows.append((f'+ optional [{e}]',len(cur)))
    for lab,n in rows: print(f"   {lab:62s} n={n:6d}  ({100*n/len(d):5.1f}% of 12,686)")
    return rows

print("="*118); print("RETENTION LADDER (listwise core)"); print("="*118)
lad89=ladder('bmi89'); print(); lad92=ladder('bmi92',extra=['bmi81']); print(); ladD=ladder('dw81_89',extra=['w81']); print()

# ---------------- helper to fit & report ----------------
def fit(df,y,x,ctrls,fam=None,label='',sexsplit=False):
    fml=f"{y} ~ {x}"+("".join(f" + {c}" for c in ctrls))
    sub=df.dropna(subset=[y,x]+ctrls)
    if sexsplit: out={}
    res=smf.ols(fml,data=sub).fit(cov_type='HC1')
    print(f"   {label:52s} n={int(res.nobs):6d} b({x})={res.params[x]:+.4f} SE={res.bse[x]:.4f} "
          f"CI[{res.conf_int().loc[x,0]:+.3f},{res.conf_int().loc[x,1]:+.3f}] p={res.pvalues[x]:.3g} "
          f"sign={'MATCH(+)' if res.params[x]>0 else 'OPPOSITE(-)'}  R2={res.rsquared:.3f}")
    if sexsplit:
        for sx in ['Male','Female']:
            s=sub[sub.sex_lbl==sx]; r=smf.ols(fml,data=s).fit(cov_type='HC1')
            print(f"      {sx:6s}{'':44s} n={int(r.nobs):6d} b={r.params[x]:+.4f} SE={r.bse[x]:.4f} p={r.pvalues[x]:.3g}")
    return res,sub

def block(y,xs,title,ctrl_sets,sexsplit=True):
    print("-"*118); print(f"  {title}")
    for x in xs:
        fit(d,y,x,[],label=f"  M0 UNADJUSTED  [{x}]",sexsplit=False)
        for lab,cs in ctrl_sets: fit(d,y,x,cs,label=f"  ADJ [{x}] {lab}",sexsplit=sexsplit)

