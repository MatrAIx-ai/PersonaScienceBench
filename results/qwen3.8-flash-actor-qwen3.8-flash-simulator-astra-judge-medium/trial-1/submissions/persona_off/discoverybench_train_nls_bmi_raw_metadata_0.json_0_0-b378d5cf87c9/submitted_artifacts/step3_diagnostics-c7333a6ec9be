print("="*116)
tgt=[c for c in CORE+FIN+EXT if d[c].isna().any()]
pred=[c for c in ['bmi89','tp_ord','age79','age81','bmi81','w81','sex','race','fam'] if c not in tgt]
print("  controls imputed:",tgt," | imputation predictors (exposure+outcome allowed as predictors, never imputed):",pred)
base_cols=d[tgt+pred].copy()
def chained_impute(df,seed,iters=6):
    rr=np.random.default_rng(seed); X=df.copy().astype(float)
    misscols=[c for c in tgt if X[c].isna().any()]
    for c in X.columns:
        if X[c].isna().any(): X[c]=X[c].fillna(X[c].mean())
    sds={}
    for it in range(iters):
        for c in misscols:
            obs=df[c].notna().values
            others=[k for k in df.columns if k!=c]
            Yo=df[c][obs].values.astype(float); Xo=np.c_[np.ones(int(obs.sum())),X[others][obs].values]
            beta,*_=np.linalg.lstsq(Xo,Yo,rcond=None)
            resid=Yo-Xo@beta
            sd=float(np.std(resid)) if resid.std()>0 else float(df[c].std())
            sds[c]=sd
            Xn=np.c_[np.ones(int((~obs).sum())),X[others][~obs].values]
            X.loc[~obs,c]=Xn@beta+rr.normal(0,sd,int((~obs).sum()))
    return X,sds
ests=[];sds_all=[]
for m in range(10):
    Xi,sds=chained_impute(base_cols,seed=100+m)
    Z=pd.concat([d[['bmi89','tp_ord','tp_high']].reset_index(drop=True),Xi[tgt].reset_index(drop=True)],axis=1)
    r=smf.ols("bmi89 ~ tp_ord + "+" + ".join(tgt),data=Z).fit(cov_type='HC1')
    r2=smf.ols("bmi89 ~ tp_high + "+" + ".join(tgt),data=Z).fit(cov_type='HC1')
    ests.append((r.params['tp_ord'],r2.params['tp_high'])); sds_all.append(sds)
e0=np.array([a for a,b in ests]); e1=np.array([b for a,b in ests])
