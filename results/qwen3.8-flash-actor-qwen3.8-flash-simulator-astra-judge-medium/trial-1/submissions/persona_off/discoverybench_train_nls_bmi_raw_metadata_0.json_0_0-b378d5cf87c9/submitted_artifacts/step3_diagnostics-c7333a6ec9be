def mmg(outcome,ctrls,extra_label,subset=None,cond=None):
    df=d if subset is None else subset
    fml=f"{outcome} ~ C(sv,Treatment(reference=1.0))"+"".join(f" + {c}" for c in ctrls)+("" if cond is None else f" + {cond}")
    sub=df.dropna(subset=[outcome,'sv','tp_ord']+ctrls+([] if cond is None else [cond]))
    r=smf.ols(fml,data=sub).fit(cov_type='HC1')
    # predicted mean per category at sample means of controls
    means={c:sub[c].mean() for c in ctrls+([] if cond is None else [cond])}
    rows=[]
    for g in [1,2,3,4]:
        X=pd.DataFrame({'sv':float(g),**means},index=[0])
        pr=r.get_prediction(X); ci=pr.conf_int(alpha=0.05)[0]
        rows.append((g,int((sub.sv==g).sum()),pr.predicted[0],ci[0],ci[1]))
    print(f"  {extra_label}  (n={int(r.nobs)})")
    LB={1:'saver',2:'dis-saver',3:'no-change',4:'no-savings'}
    for g,n,m,l,h in rows: print(f"     sv={g} {LB[g]:10s} n={n:5d}  adj.BMI={m:6.3f}  95%CI[{l:.3f},{h:.3f}]")
    lin=sub.tp_ord; r2=smf.ols(f"{outcome} ~ tp_ord"+"".join(f" + {c}" for c in ctrls)+("" if cond is None else f" + {cond}"),data=sub).fit(cov_type='HC1')
    print(f"     linear TP-ordinal trend: b={r2.params['tp_ord']:+.4f} SE={r2.bse['tp_ord']:.4f} p={r2.pvalues['tp_ord']:.3g}")
    return rows
