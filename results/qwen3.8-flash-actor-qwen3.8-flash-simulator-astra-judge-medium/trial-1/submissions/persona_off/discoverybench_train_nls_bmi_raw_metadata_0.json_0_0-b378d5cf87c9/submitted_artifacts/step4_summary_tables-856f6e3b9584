"""STEP 4 - tidy deliverable tables: descriptive BMI-by-exposure table + headline coefficient table."""
import pandas as pd, numpy as np, statsmodels.formula.api as smf
d=pd.read_csv('analysis/analytic.csv')
CORE=['age89','sex','race','mom','asvab_z']; FIN=['log_inc89','asinh_wth85']; EXT=['dad','occ_major','fam']
ALL=CORE+FIN+EXT

# ---- Table A: mean/median BMI by savings category (and by sex) ----
rows=[]
def blk(sub,label):
    for g,lab in [(1,'1 put more in (saver)'),(2,'2 took more out (dis-saver)'),(3,'3 no change'),(4,'4 no savings')]:
        s=sub[sub.sv==g]
        rows.append(dict(sample=label,group=lab,n=len(s),
            mean_bmi89=round(s.bmi89.mean(),2),median_bmi89=round(s.bmi89.median(),2),sd_bmi89=round(s.bmi89.std(),2),
            obese89_pct=round(100*s.obese89.mean(),1),
            mean_bmi92=round(s.bmi92.mean(),2),median_bmi92=round(s.bmi92.median(),2),obese92_pct=round(100*s.obese92.mean(),1),
            median_wealth85=s.wth85.median(),median_income89=s.inc89.median(),mean_age89=round(s.age89.mean(),1)))
blk(d,'ALL (raw, no controls)')
blk(d[d.sex==1],'MALE (raw)'); blk(d[d.sex==2],'FEMALE (raw)')
A=pd.DataFrame(rows); A.to_csv('analysis/table_A_bmi_by_savings_group.csv',index=False)
print("TABLE A - BMI by savings-based present-orientation group (raw)")
print(A.to_string(index=False))

# ---- Table B: headline coefficients across every specification ----
out=[]
def add(model,outcome,exp,ctrls,label,extra=None,weights=None):
    df=d.dropna(subset=[outcome,exp]+ctrls+( [extra] if extra else []))
    fml=f"{outcome} ~ {exp}"+"".join(f" + {c}" for c in ctrls)+("" if extra is None else f" + {extra}")
    r=(smf.wls(fml,data=df,weights=df[weights]) if weights else smf.ols(fml,data=df)).fit(cov_type='HC1') if weights else smf.ols(fml,data=df).fit(cov_type='HC1')
    out.append(dict(model=label,outcome=outcome,exposure=exp,design=('CROSS-SECTIONAL (same wave)' if outcome=='bmi89'
                    else 'PROSPECTIVE (attrition-fragile)' if outcome=='bmi92' else 'CHANGE model'),
                    n=int(r.nobs),beta=round(r.params[exp],4),se=round(r.bse[exp],4),
                    ci_lo=round(r.conf_int().loc[exp,0],4),ci_hi=round(r.conf_int().loc[exp,1],4),
                    p=round(r.pvalues[exp],5),expected_sign=('NEGATIVE' if exp=='save_ratio' else 'POSITIVE'),
                        sign_matches_prereg='YES' if ((r.params[exp]<0)==(exp=='save_ratio')) else 'no'))
for exp in ['tp_ord','tp_high','tp_cat3','save_ratio','D_dissav','D_nochg','D_nosav']:
    add('M',  'bmi89',exp,[],            'B1 unadjusted (full wave)')
    add('M',  'bmi89',exp,CORE,          'B2 + core controls')
    add('M',  'bmi89',exp,CORE+FIN,      'B3 + core + financial controls')
    add('M',  'bmi89',exp,CORE+FIN+EXT,  'B4 + core + financial + family (FULLY ADJ)')
    add('M',  'bmi89',exp,CORE+FIN+EXT,  'B5 FULLY ADJ + lagged BMI1981',extra='bmi81')
for exp in ['tp_ord','tp_high','tp_cat3','D_dissav','D_nosav']:
    add('M',  'bmi92',exp,CORE+FIN+EXT,              'B6 PROSPECTIVE fully adj [cond BMI1989]',extra='bmi89')
    add('M',  'bmi92',exp,[],                        'B7 PROSPECTIVE unadjusted')
add('M','dw81_89','tp_ord',CORE+FIN+EXT,'B8 change weight1981->1989 (exposure POSTERIOR)',extra='bmi81')
add('M','dw81_89','tp_high',CORE+FIN+EXT,'B8b change weight1981->1989 (exposure POSTERIOR)',extra='bmi81')
add('M','dbmi89_92','tp_ord',CORE+FIN+EXT,'B9 change BMI1989->1992 (exposure ANTECEDENT)')
add('M','dbmi89_92','tp_high',CORE+FIN+EXT,'B9b change BMI1989->1992 (exposure ANTECEDENT)')
pool=d[d.sv.notna()&d.bmi89.notna()]; m=d.dropna(subset=['bmi92','bmi89','tp_ord']+ALL)
w=(pool.race_lbl.value_counts(normalize=True)/m.race_lbl.value_counts(normalize=True))
d['pw']=d.race_lbl.map(w)
for exp in ['tp_ord','tp_high']:
    add('M','bmi92',exp,CORE+FIN+EXT,'B10 PROSPECTIVE + cohort post-strat weights',extra='bmi89',weights='pw')
for sx,lab in [(1,'MALES'),(2,'FEMALES')]:
    d['_sx']=d.sex_lbl
    for exp in ['tp_ord','tp_high']:
        sub=d[d.sex==sx]
        r=sub.dropna(subset=['bmi89',exp]+ALL)
        fml=f"bmi89 ~ {exp}"+"".join(f" + {c}" for c in ALL if c!='sex')
        rr=smf.ols(fml,data=r).fit(cov_type='HC1')
        out.append(dict(model=f'B11 sex-stratified {lab}',outcome='bmi89',exposure=exp,design='CROSS-SECTIONAL (same wave)',
                        n=int(rr.nobs),beta=round(rr.params[exp],4),se=round(rr.bse[exp],4),
                        ci_lo=round(rr.conf_int().loc[exp,0],4),ci_hi=round(rr.conf_int().loc[exp,1],4),
                        p=round(rr.pvalues[exp],5),expected_sign='POSITIVE',sign_matches_prereg='YES' if rr.params[exp]>0 else 'no'))
        r2=sub.dropna(subset=['bmi92','bmi89',exp]+ALL)
        fml92=fml.replace('bmi89 ~','bmi92 ~',1)+" + bmi89"
        rr=smf.ols(fml92,data=r2).fit(cov_type='HC1')
        out.append(dict(model=f'B12 sex-stratified {lab} PROSPECTIVE',outcome='bmi92',exposure=exp,design='PROSPECTIVE (attrition-fragile)',
                        n=int(rr.nobs),beta=round(rr.params[exp],4),se=round(rr.bse[exp],4),
                        ci_lo=round(rr.conf_int().loc[exp,0],4),ci_hi=round(rr.conf_int().loc[exp,1],4),
                        p=round(rr.pvalues[exp],5),expected_sign='POSITIVE',sign_matches_prereg='YES' if rr.params[exp]>0 else 'no'))
B=pd.DataFrame(out); B.to_csv('analysis/table_B_headline_coefficients.csv',index=False)
print("\nTABLE B - headline coefficients (pre-registered expected sign: POSITIVE; save_ratio expected NEGATIVE)")
print(B.to_string(index=False))
